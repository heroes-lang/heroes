# Rust — the bootstrap compiler is archived (M-bootstrap-archive), and so is
# everything cargo writes. The old `/target` stays listed for one reason: a
# checkout made before the archive still has one.
/target
archive/bootstrap-rs/target

# heroes build cache (generated C, runtime.o, binaries — all derived)
/build

# The compiler itself. Both names are in CLAUDE.md § Commands: `heroes` is what
# the one clang line over `seed/heroes.c` produces, and `heroes-next` is what
# that binary builds from `selfhost/main.hero`. Every checkout that follows the
# README makes one, and a parallel session staging with `git add -A` would
# commit a multi-megabyte binary that nothing in this repository reads.
/heroes
/heroes-next

# bootstrap stages (derived)
stage[0-9]
*.o

# macOS
.DS_Store

# Scratch git worktrees created by panel judges (never project content).
.claude/worktrees/
