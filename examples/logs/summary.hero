# Counting, and the ordering a count wants.
#
# Almost everything here is a `{str: i64}` filled in one pass and then read in an
# order the map does not have. That is the shape a `{K: V}` forces and it is
# worth seeing once: insertion order is not remembered, `==` ignores it, and
# `sort(keys(m))` gives the one order every run agrees on.
#
# **Sorted by count, ties by name.** `sort` orders text, which is the wrong order
# for a tally — `WARN` before `ERROR` says nothing — so the ranking is a small
# selection over the keys. Ties fall back to the name so two runs of the same
# file print the same page, which is what makes the output a golden at all.

use entry

## Error codes
#
# One `constant` per code, so a typo is `error[unknown_name]` here rather
# than a comparison that is quietly false forever (panel 034 R4).

constant ERR_NONE_AT_LEVEL: str
    "none_at_level"

function tally(names: [str]) -> {str: i64}
    counts: {str: i64} @ {}

    for name in names
        counts[name] @ counts[name].default(0) + 1

    return counts

function levels_of(entries: [entry.Entry]) -> [str]
    out: [str] @ []

    for one in entries
        out @ out.push(one.level)

    return out

function sources_of(entries: [entry.Entry]) -> [str]
    out: [str] @ []

    for one in entries
        out @ out.push(one.source)

    return out

function hours_of(entries: [entry.Entry]) -> [str]
    out: [str] @ []

    for one in entries
        out @ out.push(entry.hour_of(one))

    return out

# The keys, most first. A selection over `sort(keys(m))`, so the starting order
# is already the tie-break and the loop only has to find the largest count.
function ranked(counts: {str: i64}) -> [str]
    left: [str] @ sort(keys(counts))
    out: [str] @ []

    while left.len() > 0
        best: i64 @ 0

        for i in range(from: 1, to: left.len())
            if counts[left[i]].default(0) > counts[left[best]].default(0)
                best @ i

        out @ out.push(left[best])
        left @ without(left, best)

    return out

function without(names: [str], at: i64) -> [str]
    out: [str] @ []

    for i in range(from: 0, to: names.len())
        if i != at
            out @ out.push(names[i])

    return out

# `name n` per line, in ranked order — the shape every section of the report has.
function rows(counts: {str: i64}) -> [str]
    out: [str] @ []

    for name in ranked(counts)
        out @ out.push("  " + name + " " + counts[name].default(0).to_str())

    return out

# The first entry at this level, which is the one a reader opens the log to find.
function first_at(entries: [entry.Entry], level: str) -> entry.Entry?
    for one in entries
        if one.level == level
            return ok(one)

    return fail(ERR_NONE_AT_LEVEL, "no line is " + level)

function how_many_at(entries: [entry.Entry], level: str) -> i64
    return tally(levels_of(entries))[level].default(0)

test "a tally counts, and an absent key is zero rather than an error"
    counts = tally(["a", "b", "a"])
    assert counts["a"].must() == 2
    assert counts["b"].must() == 1
    assert counts["c"].default(0) == 0

test "the ranking is by count, and ties fall back to the name"
    assert ranked(tally(["b", "a", "a"])) == ["a", "b"]
    assert ranked(tally(["z", "a"])) == ["a", "z"]
    assert ranked(tally([])) == []

test "the ranking is the one sort would get wrong"
    counts = tally(["WARN", "ERROR", "ERROR", "ERROR"])
    assert ranked(counts) == ["ERROR", "WARN"]
    assert sort(keys(counts)) == ["ERROR", "WARN"]
    assert rows(counts) == ["  ERROR 3", "  WARN 1"]

test "the first line at a level is the first one, not any one"
    r = entry.read(
        "2026-08-13T09:00:00 WARN a: one\n2026-08-13T10:00:00 ERROR b: two\n2026-08-13T11:00:00 ERROR c: three\n"
    )
    assert first_at(r.entries, "ERROR").must().source == "b"
    assert first_at(r.entries, "TRACE").is_err()
    assert how_many_at(r.entries, "ERROR") == 2
    assert how_many_at(r.entries, "TRACE") == 0

test "the busiest hour is a rank over the hours"
    r = entry.read(
        "2026-08-13T09:00:00 INFO a: one\n2026-08-13T22:00:00 INFO a: two\n2026-08-13T22:30:00 INFO a: three\n"
    )
    assert ranked(tally(hours_of(r.entries)))[0] == "22"
