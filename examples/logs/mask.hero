# The levels, as a set of bits.
#
# One bit per level, `|` to add, `&` to test, `~` to take away, `^` to toggle,
# `>>` to count. It is the shape a flag set has had since C, and it is the shape
# the six bitwise operators were argued from — a **flag union**, written `|`
# rather than `+`, where `+` is a silent wrong answer the moment one flag is
# added twice.
#
# Why a mask at all, rather than a `[str]` of level names: the question the
# program asks is *is this line in the set*, once per line, and a mask answers it
# with one `&` where a list answers it with a loop. A five-element list would be
# perfectly fast; the reason to write it this way is that a set of named flags is
# what a mask **is**, and the alternative spells the same idea in a shape that has
# to be read to be understood.
#
# `PROBLEMS` is the constant this buys: `WARN | ERROR` written once, named, and
# impossible to get wrong at a call site.

constant BIT_TRACE: i64
    1

constant BIT_DEBUG: i64
    1 << 1

constant BIT_INFO: i64
    1 << 2

constant BIT_WARN: i64
    1 << 3

constant BIT_ERROR: i64
    1 << 4

# Every level there is. Written as a union rather than as `31`, because `31` is a
# number a reader has to decode and this is a list they can read.
constant EVERY: i64
    BIT_TRACE | BIT_DEBUG | BIT_INFO | BIT_WARN | BIT_ERROR

# The two levels somebody woken at night is looking for.
constant PROBLEMS: i64
    BIT_WARN | BIT_ERROR

constant ERR_NO_SUCH_LEVEL: str
    "no_such_level"

# The bit a level's name stands for, or 0 for a name that is not a level. Zero is
# the right answer for "no bits at all" and it makes `holds` false for every
# mask, which is what a caller wants from a name that means nothing.
function bit_of(level: str) -> i64
    if level == "TRACE"
        return BIT_TRACE

    if level == "DEBUG"
        return BIT_DEBUG

    if level == "INFO"
        return BIT_INFO

    if level == "WARN"
        return BIT_WARN

    if level == "ERROR"
        return BIT_ERROR
    return 0

# `mask & bit != 0` needs no parentheses, and that is worth one line of comment
# because it is the opposite of C. There `&` binds *looser* than `!=`, so
# `mask & bit != 0` means `mask & (bit != 0)` — the most famous precedence wart
# there is, and the reason C programmers write the parentheses by reflex. The
# spec's chain puts `&` above the comparisons, so what is written is what is
# meant.
function holds(mask: i64, level: str) -> bool
    return mask & bit_of(level) != 0

function added(mask: i64, level: str) -> i64
    return mask | bit_of(level)

function removed(mask: i64, level: str) -> i64
    return mask & ~bit_of(level)

function toggled(mask: i64, level: str) -> i64
    return mask ^ bit_of(level)

# How many levels are in the set, counted by walking the bits down. `>>` on a
# mask that is never negative, so the sign bit is not a question here.
#
# `n + (left & 1)` **does** need its parentheses, and the first version of this
# line did not have them: `+` binds tighter than `&` — in Heroes as in C — so
# `n + left & 1` is `(n + left) & 1`, which counts every mask as 1 or 0. Two
# tests caught it in the first run. The two lines above and below are the pair
# worth reading together: one place where C's parentheses are unnecessary here,
# one where they are just as necessary as there.
function how_many(mask: i64) -> i64
    left: i64 @ mask
    n: i64 @ 0

    while left != 0
        n @ n + (left & 1)
        left @ left >> 1

    return n

# The names in the set, in the order the levels are declared — which is the order
# of severity, and the one a reader expects a level list in.
function names_of(mask: i64) -> [str]
    out: [str] @ []

    for level in ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
        if holds(mask, level)
            out @ out.push(level)

    return out

# `ERROR,WARN` — a comma-separated list of level names, as one mask.
function read(text: str) -> i64?
    mask: i64 @ 0

    for name in split_on(text, ',')
        if bit_of(name) == 0
            return fail(ERR_NO_SUCH_LEVEL, "`" + name + "` is not a level — try " + join(names_of(EVERY), ", "))
        mask @ added(mask, name)

    return ok(mask)

function split_on(text: str, c: u8) -> [str]
    out: [str] @ []
    start: i64 @ 0
    i: i64 @ 0

    while i <= text.len()
        if i == text.len() || text[i] == c
            piece = text.slice(from: start, to: i)

            if piece != ""
                out @ out.push(piece)
            start @ i + 1
        i @ i + 1

    return out

test "a bit is a level, and a name that is not a level is no bits at all"
    assert bit_of("ERROR") == BIT_ERROR
    assert bit_of("TRACE") == 1
    assert bit_of("SHOUT") == 0
    assert holds(EVERY, "SHOUT") == false

test "the union is what the constants say it is"
    assert PROBLEMS == BIT_WARN | BIT_ERROR
    assert EVERY == 31
    assert how_many(EVERY) == 5
    assert how_many(PROBLEMS) == 2
    assert how_many(0) == 0

test "adding twice is adding once, which is the whole reason it is not `+`"
    once = added(0, "ERROR")
    twice = added(once, "ERROR")
    assert once == twice
    assert once == BIT_ERROR
    assert BIT_ERROR + BIT_ERROR != BIT_ERROR

test "taking away leaves the rest, and toggling puts it back"
    without_error = removed(EVERY, "ERROR")
    assert holds(without_error, "ERROR") == false
    assert holds(without_error, "WARN") == true
    assert how_many(without_error) == 4
    assert toggled(without_error, "ERROR") == EVERY

test "the names come back in severity order, whatever order they went in"
    assert names_of(PROBLEMS) == ["WARN", "ERROR"]
    assert names_of(read("ERROR,TRACE").must()) == ["TRACE", "ERROR"]
    assert names_of(0) == []

test "a list of names is a mask, and a name that is not a level says so"
    assert read("ERROR").must() == BIT_ERROR
    assert read("WARN,ERROR").must() == PROBLEMS
    assert read("ERROR,,WARN").must() == PROBLEMS

    match read("ERROR,SHOUT")
        .ok _ => assert false
        .err e =>
            assert e.code == ERR_NO_SUCH_LEVEL
            assert e.msg == "`SHOUT` is not a level — try TRACE, DEBUG, INFO, WARN, ERROR"
