# One log line, taken apart — and the lines that are not one.
#
#     2026-08-13T22:04:11 ERROR emit: the thing broke
#     └─ stamp ────────┘ └level┘ └src┘ └─ message ──┘
#
# **A line that does not fit is skipped and counted, never fatal.** A summariser
# that refuses a whole file because one line was truncated is a summariser nobody
# can use on a real log, where the last line is half-written as often as not. The
# count is reported, so "skipped" is a number the reader sees rather than a
# silence.

use core/strings

## Error codes
#
# One `constant` per code, so a typo is `error[unknown_name]` here rather
# than a comparison that is quietly false forever (panel 034 R4).

constant ERR_NO_SOURCE: str
    "no_source"

constant ERR_NO_STAMP: str
    "no_stamp"

constant ERR_SHORT_LINE: str
    "short_line"

record Entry
    stamp: str
    level: str
    source: str
    message: str

record Reading
    entries: [Entry]
    skipped: [i64]

# The first `n` space-separated words, and everything left over as one piece.
# Splitting on every space would lose the message, which contains them.
function first_words(text: str, n: i64) -> [str]
    out: [str] @= []
    rest: str @= strings.trim_space(text)

    for _ in range(from: 0, to: n)
        match strings.split_once(s: rest, sep: " ")
            .ok words =>
                out @ out.push(words.before)
                rest @ strings.trim_space(words.after)
            .err _ =>
                out @ out.push(rest)
                rest @ ""

    out @ out.push(rest)
    return out

## One line

# `stamp LEVEL source: message`, or an error saying which part was missing.
function read_line(text: str) -> Entry?
    parts = first_words(text, 3)

    if parts[0] == "" || parts[1] == "" || parts[2] == ""
        return fail(code: ERR_SHORT_LINE, msg: "a line is `stamp LEVEL source: message`")

    if parts[2][parts[2].len() - 1] != ':'
        return fail(code: ERR_NO_SOURCE, msg: "the third word must end in `:`")

    if !strings.contains(s: parts[0], substr: "T")
        return fail(code: ERR_NO_STAMP, msg: "the first word must be a timestamp, `DATEThh:mm:ss`")
    source = parts[2].slice(from: 0, to: parts[2].len() - 1)
    return ok(Entry(stamp: parts[0], level: parts[1], source: source, message: parts[3]))

# The whole file: what could be read, and the line numbers of what could not.
function read(text: str) -> Reading
    entries: [Entry] @= []
    skipped: [i64] @= []
    number: i64 @= 0

    for line in strings.split_lines(text)
        number @ number + 1

        if strings.trim_space(line) == ""
            continue

        match read_line(line)
            .ok entry => entries @ entries.push(entry)
            .err _    => skipped @ skipped.push(number)

    return Reading(entries: entries, skipped: skipped)

# The hour a stamp names — `2026-08-13T22:04:11` is `22`. The two characters
# after the `T`, which is why `read_line` insists there is one.
function hour_of(entry: Entry) -> str
    match strings.split_once(s: entry.stamp, sep: "T")
        .ok halves =>
            if halves.after.len() < 2
                return "??"
            return halves.after.slice(from: 0, to: 2)
        .err _ => return "??"

test "a line comes apart into four pieces, message included"
    one = read_line("2026-08-13T22:04:11 ERROR emit: the thing broke, twice").must()
    assert one.stamp == "2026-08-13T22:04:11"
    assert one.level == "ERROR"
    assert one.source == "emit"
    assert one.message == "the thing broke, twice"

test "each way of not being a log line has its own code"
    assert code_of("") == ERR_SHORT_LINE
    assert code_of("2026-08-13T22:04:11 ERROR") == ERR_SHORT_LINE
    assert code_of("2026-08-13T22:04:11 ERROR emit the thing") == ERR_NO_SOURCE
    assert code_of("yesterday ERROR emit: the thing") == ERR_NO_STAMP

test "a file keeps what it could read and counts what it could not"
    r = read("2026-08-13T09:00:00 INFO a: one\nnonsense\n\n2026-08-13T10:00:00 WARN b: two\n")
    assert r.entries.len() == 2
    assert r.skipped == [2]

test "the hour is the two characters after the T"
    assert hour_of(read_line("2026-08-13T22:04:11 INFO a: x").must()) == "22"
    assert hour_of(read_line("2026-08-13T07:04:11 INFO a: x").must()) == "07"

function code_of(text: str) -> str
    return match read_line(text)
        .ok _  => "no_error"
        .err e => e.code
