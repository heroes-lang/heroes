# The process's surroundings read as values: the folder it works in, its
# environment, and what stands at a path, each a failure the caller answers
# where the system cannot say, and never an abort. Go's `os`, over the
# language's own `hero_os.h` through the floor `os/hero_os` (the admission
# notes at the end of this file).
#
# Reading and writing a whole file, the arguments and the exit are the
# built-ins' (spec § 11), so they are not here.

use os/hero_os

# What a path holds: Go's file modes, the kinds the runtime can tell apart.
variant Kind
    regular
    directory
    link
    other

# What `stat` and `lstat` answer about a path: its kind, and its permission
# bits, Go's `Mode().Perm()`, 0 for a link, whose own bits the runtime does
# not read, and on Windows 0444 for a read-only file and 0666 for any other.
record FileInfo
    kind: Kind
    mode: i64

# The absolute path of the folder the process works in, every link on the way
# followed: Go's `os.Getwd`. It fails `file_not_found` where the folder is
# gone, and `not_text` where its path is not UTF-8.
function getwd() -> str?
    status: i64 @= 0
    marks: i64 @= 0
    here = hero_os.fs_resolved_shown(".", status: @status, marks: @marks)

    if status == hero_os.HERO_OS_NOT_TEXT
        return fail(
            code: "not_text",
            msg: "the working folder's path is not UTF-8: " + here.slice(from: marks, to: here.len())
        )

    if status != hero_os.HERO_OS_OK
        return fail(
            code: "file_not_found",
            msg: "the working folder cannot be read (the system's reason " + hero_os.fs_why().to_str() + ")"
        )
    return ok(here)

# The value of the environment variable `key`. Go's `os.LookupEnv` answers a
# flag beside the value, so the name differs. It fails `not_found` where the
# variable is unset, a variable set empty answering "", and `not_text` where
# its value is not UTF-8. It aborts where `key` holds a zero byte.
function env(key: str) -> str?
    status: i64 @= 0
    marks: i64 @= 0
    value = hero_os.env_shown(key, status: @status, marks: @marks)

    if status == hero_os.HERO_OS_NOT_FOUND
        return fail(code: "not_found", msg: "no environment variable " + key + " is set")

    if status != hero_os.HERO_OS_OK
        return fail(code: "not_text", msg: "the environment variable " + key + " is not UTF-8")
    return ok(value)

# What `name` names, a link followed to what it names: Go's `os.Stat`. It
# fails `file_not_found` where nothing stands there, a link to nothing
# included, and `read_failed` where the system could not be asked. It aborts
# where `name` holds a zero byte.
function stat(name: str) -> FileInfo?
    status: i64 @= 0
    marks: i64 @= 0
    place = hero_os.fs_resolved_shown(name, status: @status, marks: @marks)

    if status != hero_os.HERO_OS_OK
        return fail(code: "file_not_found", msg: "nothing stands at " + name)
    info = lstat(place)?

    # Resolving follows every live link, so a link left standing is one to
    # nothing.
    if info.kind == .link
        return fail(code: "file_not_found", msg: name + " is a link to nothing")
    return ok(info)

# What stands at `name`, the link itself where it is one: Go's `os.Lstat`. It
# fails `file_not_found` where nothing stands there, and `read_failed` where
# the system could not be asked. It aborts where `name` holds a zero byte.
function lstat(name: str) -> FileInfo?
    kind = hero_os.fs_kind(name)

    if kind == hero_os.HERO_FS_ABSENT
        return fail(code: "file_not_found", msg: "nothing stands at " + name)

    if kind == hero_os.HERO_FS_UNKNOWN
        return fail(
            code: "read_failed",
            msg: name + " cannot be read (the system's reason " + hero_os.fs_why().to_str() + ")"
        )

    if kind == hero_os.HERO_FS_LINK
        return ok(FileInfo(kind: .link, mode: 0))
    mode = hero_os.fs_mode(name)

    found: Kind = if kind == hero_os.HERO_FS_FILE
        .regular
    else if kind == hero_os.HERO_FS_DIRECTORY
        .directory
    else
        .other

    if mode < 0
        return fail(
            code: "read_failed",
            msg: name + " cannot be read (the system's reason " + hero_os.fs_why().to_str() + ")"
        )
    return ok(FileInfo(kind: found, mode: mode))

## Tests

test "getwd: an absolute path, the folder that stands there"
    here = getwd().must()
    assert here.len() > 1
    assert stat(here).must().kind == .directory

test "env: a variable every process here has, an unset one, and its message"
    assert env("PATH").must().len() > 0

    match env("HEROES_CORE_TEST_NEVER_SET_ANYWHERE")
        .ok _  => assert false
        .err e => assert e.code == "not_found" && e.msg == "no environment variable HEROES_CORE_TEST_NEVER_SET_ANYWHERE is set"

test "stat and lstat: a folder, nothing, and a path through a missing folder"
    here = getwd().must()
    assert lstat(here).must().kind == .directory
    assert stat(here).must().mode > 0

    match stat(here + "/heroes-core-test-never-there")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

    match lstat(here + "/heroes-core-test-never-there/below")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

## Admission
#
# `getwd`, `env`, `stat` and `lstat` are here because a named acceptance
# program calls them (`examples/packages/README.md` § 7.1): the repository's
# own hooks rewritten in Heroes (feature 2082, the author's answer `2a` of
# 2026-11-14), whose Python reads the working folder (`os.getcwd`), the
# environment (`os.environ`, a home folder and a variable's value), and asks
# what stands at a path (`os.path.isfile`, `isdir`, `exists`, `lexists`) on
# every hook run: 26 lines of the thirteen modules of `.claude/hooks/` at
# `adea08993` (`cat` of every `.py` but the tests, through `grep -c -E
# 'os\.(getcwd|environ)|os\.path\.(isfile|isdir|exists|lexists)'`).
# Each loop it replaces asks the runtime twice and reads three answers, past
# three lines.
#
# Not adopted: the time a file was last written, which the hooks also ask
# (`os.path.getmtime`), since the runtime holds no door that answers it as a
# number (`hero_fs_newer_than` compares two files), and a door is the
# language's to add.
