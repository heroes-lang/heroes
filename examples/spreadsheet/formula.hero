# The formula language, and the thing a spreadsheet is actually for: a cell that
# reads other cells.
#
#     expression := term (('+' | '-') term)*
#     term       := factor (('*' | '/') factor)*
#     factor     := number | cell | 'SUM' '(' range ')' | '(' expression ')' | '-' factor
#
# **The cycle is the interesting part.** `A1 = B1` and `B1 = A1` is a program
# that would recur until the stack ends, and no type in this language can prevent
# it — so the chain of cells currently being evaluated travels with the
# evaluation, as a plain `[str]`. Value semantics is what makes that cheap to
# say: `visiting.push(name)` hands the callee a **copy**, so there is nothing to
# pop on the way back and no way to forget to.

use sheet

record Parse
    text: str
    pos: i64

function at_end(p: Parse) -> bool
    return p.pos >= p.text.len()

function here(p: Parse) -> u8
    return p.text[p.pos]

function advance(@p: Parse)
    p.pos @ p.pos + 1

function skip_space(@p: Parse)
    while !at_end(p) && (here(p) == ' ' || here(p) == '\t')
        advance(@p)

function contains(known: [str], name: str) -> bool
    for one in known
        if one == name
            return true
    return false

## Cells

# What a cell is worth. A cell nothing was written into is 0, which is what makes
# `SUM(A1:A9)` over a short column mean what a reader expects.
function value_of(s: sheet.Sheet, name: str, visiting: [str]) -> f64?
    if contains(visiting, name)
        return fail("circular_reference", "cell " + name + " is defined in terms of itself")
    source = s.cells[name].default("")
    if source == ""
        return ok(0.0)
    p: Parse @ Parse(text: source, pos: 0)
    v = expression(@p, s, visiting.push(name))?
    skip_space(@p)
    if !at_end(p)
        return fail("trailing_input", name + ": the formula does not end at " + p.pos.to_str())
    return ok(v)

## The grammar

function expression(@p: Parse, s: sheet.Sheet, visiting: [str]) -> f64?
    total: f64 @ term(@p, s, visiting)?
    more: bool @ true
    while more
        skip_space(@p)
        if !at_end(p) && here(p) == '+'
            advance(@p)
            total @ total + term(@p, s, visiting)?
        else if !at_end(p) && here(p) == '-'
            advance(@p)
            total @ total - term(@p, s, visiting)?
        else
            more @ false
    return ok(total)

function term(@p: Parse, s: sheet.Sheet, visiting: [str]) -> f64?
    total: f64 @ factor(@p, s, visiting)?
    more: bool @ true
    while more
        skip_space(@p)
        if !at_end(p) && here(p) == '*'
            advance(@p)
            total @ total * factor(@p, s, visiting)?
        else if !at_end(p) && here(p) == '/'
            advance(@p)
            divisor = factor(@p, s, visiting)?
            if divisor == 0.0
                return fail("division_by_zero", "a formula divides by zero")
            total @ total / divisor
        else
            more @ false
    return ok(total)

function factor(@p: Parse, s: sheet.Sheet, visiting: [str]) -> f64?
    skip_space(@p)
    if at_end(p)
        return fail("unexpected_end", "the formula ends where a value was expected")
    c = here(p)
    if c == '('
        advance(@p)
        inner = expression(@p, s, visiting)?
        skip_space(@p)
        if at_end(p) || here(p) != ')'
            return fail("unclosed_paren", "expected `)` at " + p.pos.to_str())
        advance(@p)
        return ok(inner)
    if c == '-'
        advance(@p)
        return ok(-factor(@p, s, visiting)?)
    if sheet.is_digit(c)
        return ok(number(@p))
    if sheet.is_letter(c)
        return named(@p, s, visiting)
    return fail("unexpected_character", "no value starts at " + p.pos.to_str())

# A literal, built digit by digit: the language offers no conversion from `str`
# to a number, on purpose, because parsing can fail and a conversion may not.
function number(@p: Parse) -> f64
    whole: f64 @ 0.0
    while !at_end(p) && sheet.is_digit(here(p))
        whole @ whole * 10.0 + to_f64(to_i64(here(p) - '0').must())
        advance(@p)
    if !at_end(p) && here(p) == '.'
        advance(@p)
        scale: f64 @ 1.0
        while !at_end(p) && sheet.is_digit(here(p))
            scale @ scale / 10.0
            whole @ whole + to_f64(to_i64(here(p) - '0').must()) * scale
            advance(@p)
    return whole

# A name: either `SUM(` and a range, or a cell.
function named(@p: Parse, s: sheet.Sheet, visiting: [str]) -> f64?
    word = word_at(@p)
    if word == "SUM"
        return sum_of(@p, s, visiting)
    if !sheet.is_name(word)
        return fail("unknown_name", "`" + word + "` is neither a cell nor `SUM`")
    return value_of(s, word, visiting)

function word_at(@p: Parse) -> str
    start = p.pos
    while !at_end(p) && (sheet.is_letter(here(p)) || sheet.is_digit(here(p)))
        advance(@p)
    return p.text.slice(from: start, to: p.pos)

# `SUM(A1:C2)` — the one function this language has, and enough to make ranges
# worth having at all.
function sum_of(@p: Parse, s: sheet.Sheet, visiting: [str]) -> f64?
    skip_space(@p)
    if at_end(p) || here(p) != '('
        return fail("expected_paren", "`SUM` needs a range in parentheses")
    advance(@p)
    start = p.pos
    while !at_end(p) && here(p) != ')'
        advance(@p)
    if at_end(p)
        return fail("unclosed_paren", "`SUM(` is never closed")
    inside = p.text.slice(from: start, to: p.pos)
    advance(@p)
    total: f64 @ 0.0
    for name in sheet.expand(inside)?
        total @ total + value_of(s, name, visiting)?
    return ok(total)

test "arithmetic, with the usual precedence"
    s = sheet.read("A1 = 2 + 3 * 4\nA2 = (2 + 3) * 4\nA3 = 10 / 4\nA4 = -3 + 1\n").must()
    assert value_of(s, "A1", []).must() == 14.0
    assert value_of(s, "A2", []).must() == 20.0
    assert value_of(s, "A3", []).must() == 2.5
    assert value_of(s, "A4", []).must() == 0.0 - 2.0

test "a cell reads another cell, as deep as it likes"
    s = sheet.read("A1 = 2\nB1 = A1 * 3\nC1 = B1 + A1\n").must()
    assert value_of(s, "C1", []).must() == 8.0

test "an empty cell is zero, so a range may be longer than the column"
    s = sheet.read("A1 = 1\nA2 = 2\nB1 = SUM(A1:A9)\n").must()
    assert value_of(s, "B1", []).must() == 3.0
    assert value_of(s, "Z9", []).must() == 0.0

test "a rectangle sums row by row"
    s = sheet.read("A1 = 1\nB1 = 2\nA2 = 3\nB2 = 4\nC1 = SUM(A1:B2)\n").must()
    assert value_of(s, "C1", []).must() == 10.0

test "a cycle is a diagnosis, not a stack overflow"
    direct = sheet.read("A1 = A1\n").must()
    two = sheet.read("A1 = B1 + 1\nB1 = A1 + 1\n").must()
    long = sheet.read("A1 = B1\nB1 = C1\nC1 = A1\n").must()
    through_sum = sheet.read("A1 = SUM(B1:B2)\nB1 = A1\n").must()
    assert code_of(direct, "A1") == "circular_reference"
    assert code_of(two, "A1") == "circular_reference"
    assert code_of(long, "A1") == "circular_reference"
    assert code_of(through_sum, "A1") == "circular_reference"

test "a cell that is read twice without a cycle is not one"
    s = sheet.read("A1 = 1\nB1 = A1 + A1\nC1 = B1 + A1\n").must()
    assert value_of(s, "C1", []).must() == 3.0

test "every other failure says what and where"
    assert code_of(sheet.read("A1 = 1 / 0\n").must(), "A1") == "division_by_zero"
    assert code_of(sheet.read("A1 = 1 +\n").must(), "A1") == "unexpected_end"
    assert code_of(sheet.read("A1 = (1\n").must(), "A1") == "unclosed_paren"
    assert code_of(sheet.read("A1 = 1 2\n").must(), "A1") == "trailing_input"
    assert code_of(sheet.read("A1 = TOTAL\n").must(), "A1") == "unknown_name"
    assert code_of(sheet.read("A1 = SUM A1\n").must(), "A1") == "expected_paren"
    assert code_of(sheet.read("A1 = SUM(A1\n").must(), "A1") == "unclosed_paren"
    assert code_of(sheet.read("A1 = SUM(B1)\n").must(), "A1") == "bad_range"
    assert code_of(sheet.read("A1 = $\n").must(), "A1") == "unexpected_character"

# The code a cell fails with — or `no_error`, which no arm above can produce, so
# a test asserting a failure cannot pass by the cell turning out to be fine.
function code_of(s: sheet.Sheet, name: str) -> str
    return match value_of(s, name, [])
        .ok _  => "no_error"
        .err e => e.code
