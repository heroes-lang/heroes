# Arrays put in an order the caller writes, where the built-in `sort` puts
# numbers, text and booleans in the order of their values alone. The sort is
# the one `examples/query` and the net's `compat` suite wrote by hand (the
# admission notes at the end of this file).

use slices/internal/merge
use slices/internal/sample

# The elements of `xs` in the order `less` writes, stably: `less(a: x, b: y)`
# answers whether `x` goes before `y`, and two elements neither goes before
# keep the order they had in `xs`.
#
# `less` answers false for two elements equal in its order: one answering true
# for them, `<=` written where `<` was meant, still sorts but no longer keeps
# their order. A `less` that is no order at all still gets every element back
# exactly once, in an order nobody promises, and nothing here aborts. `less` is
# called about n log2 n times at most, and n - 1 times where `xs` is already in
# its order or strictly in the reverse of it.
function sort_by<A>(xs: [A], less: (function(a: A, b: A) -> bool)) -> [A]
    out: [A] @= []

    for at in merge.order(xs, less)
        taken = xs[at]
        out @ out.push(taken)

    return out

## Tests

test "sort_by: none, one, two, and two equal kept as they stood"
    none: [i64] = []
    assert sort_by(none, sample.up).len() == 0
    assert sort_by([5], sample.up) == [5]
    assert sort_by([2, 1], sample.up) == [1, 2]
    assert sort_by([1, 2], sample.up) == [1, 2]
    two = sample.entries([7, 7])
    assert sort_by(two, sample.by_key) == two

test "sort_by: in order, in the reverse order, and every key equal"
    rising = range(from: 0, to: 1000)
    assert sort_by(rising, sample.up) == rising
    falling: [i64] @= []

    for at in range(from: 0, to: 1000)
        falling @ falling.push(1000 - at)

    assert sort_by(falling, sample.up) == falling.sort()
    same = sample.entries(sample.fixed_keys(count: 300, values: 1))
    assert sort_by(same, sample.by_key) == same

test "sort_by: a record by one field, ties kept in the order they stood, both ways"
    given = sample.entries([3, 1, 2, 1, 3, 0, 2, 1])
    got = sort_by(given, sample.by_key)
    assert sample.sorted_stably(got: got, given: given)
    assert sample.names_of(got) == ["at 5", "at 1", "at 3", "at 7", "at 2", "at 6", "at 0", "at 4"]
    down = sort_by(given, sample.key_down)
    assert sample.names_of(down) == ["at 0", "at 4", "at 2", "at 6", "at 1", "at 3", "at 7", "at 5"]

# Every list of up to six keys from three values, against the built-in `sort`
# for the order and against the place each entry stood for its ties.
test "sort_by: every list of up to six keys from three values"
    for length in range(from: 0, to: 7)
        for list in sample.every_list(values: 3, length: length)
            assert sort_by(list, sample.up) == list.sort()
            given = sample.entries(list)
            assert sample.sorted_stably(got: sort_by(given, sample.by_key), given: given)

test "sort_by: five thousand keys, many repeated, against the built-in sort and stably"
    numbers = sample.fixed_keys(count: 5000, values: 997)
    assert sort_by(numbers, sample.up) == numbers.sort()
    given = sample.entries(numbers)
    assert sample.sorted_stably(got: sort_by(given, sample.by_key), given: given)

test "sort_by: an order that is no order still gives every element back once"
    given = [4, 1, 3, 1, 2]
    assert sort_by(given, sample.never) == given
    got = sort_by(given, sample.always)
    assert got.len() == given.len() && got.sort() == given.sort()

## Admission
#
# `sort_by` is here because programs wrote it by hand. Counted on 2026-11-14 by
# the comparator called in a loop's condition:
#
#     git grep -n -E "(while|if) .*(before|after|later)\((o, )?a: " -- examples tests/harness selfhost ':!**/heroes.packages/**'
#
# which names `examples/query`'s merge sort of five thousand rows (31 lines)
# and the net's `compat` suite's insertion sort of releases (25 lines), both
# moved onto `sort_by` in core 0.5.0, the first of them run on 2026-11-14 at
# 2,436 million instructions for 100,000 rows at `-O0` against `sort_by`'s 853
# million; and three in the compiler, `selfhost/mutate/`'s insertion sorts of
# hunks (`hunks.sorted`, `mutant.ordered`) and its index order of them
# (`mutant.order_of`), which stay, since the compiler takes a package only
# where its own tree, the placed files counted, is smaller after it (panel
# 242's R2). The command's other lines sort nothing by a caller's order: two
# comparisons of releases and one of dates, and the compiler's insertion sort
# of `[str]` by bytes, which the built-in `sort` already writes.
#
# Not adopted: Go's name, `SortStableFunc`, which sorts in place by a three-way
# `cmp`; every sort counted above asks a `bool`, whether one element goes
# before another, which is Go's `less` (`sort.SliceStable`) and cannot
# overflow where a `cmp` written as a subtraction can.
