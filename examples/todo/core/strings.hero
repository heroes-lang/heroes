# Text searched, trimmed and split, never cutting a character in two: every
# position a function here cuts at is a character's first byte, so none aborts
# on a text a program reads from outside. A function keeps Go's name where its
# contract is Go's and takes another where it is not, and each is here because
# the programs of `examples/` wrote it by hand (the admission notes at the end
# of this file).

use core/strings/internal/scan

# What `split_once` answers: the text before the separator, and the text after
# it.
record Halves
    before: str
    after: str

# Whether `s` begins with `prefix`; every text begins with "".
function has_prefix(s: str, prefix: str) -> bool
    if prefix.len() > s.len()
        return false
    at: i64 @= 0

    while at < prefix.len()
        if s[at] != prefix[at]
            return false
        at @ at + 1

    return true

# Whether `s` ends with `suffix`; every text ends with "".
function has_suffix(s: str, suffix: str) -> bool
    if suffix.len() > s.len()
        return false
    offset = s.len() - suffix.len()
    at: i64 @= 0

    while at < suffix.len()
        if s[offset + at] != suffix[at]
            return false
        at @ at + 1

    return true

# Whether `substr` occurs in `s`; the empty text occurs in every text.
function contains(s: str, substr: str) -> bool
    return !scan.first_at(s: s, sep: substr).is_err()

# `s` without the white space at either end, white space being Unicode's, as
# Go's `strings.TrimSpace` reads it: space, tab, line feed and carriage return
# among others, and the non-breaking space U+00A0.
function trim_space(s: str) -> str
    from: i64 @= 0

    while from < s.len()
        width = scan.space_width_at(s, from)

        if width == 0
            break
        from @ from + width

    to: i64 @= s.len()

    while to > from
        width = scan.space_width_before(s, to)

        if width == 0
            break
        to @ to - width

    return s.slice(from: from, to: to)

# The words of `s`: the pieces between runs of white space, none of them empty,
# so "  a b  " answers ["a", "b"] and a text of white space alone answers [].
# White space is `trim_space`'s.
function fields(s: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    inside: bool @= false
    at: i64 @= 0

    while at < s.len()
        width = scan.space_width_at(s, at)

        if width > 0
            if inside
                out @ out.push(s.slice(from: start, to: at))
                inside @ false
            at @ at + width
        else
            if !inside
                start @ at
                inside @ true
            at @ at + 1

    if inside
        out @ out.push(s.slice(from: start, to: s.len()))
    return out

# The lines of `s`, each without its end, "\n" or "\r\n", the last line's end
# being optional, so "a\nb" and "a\nb\n" both answer ["a", "b"]; "" has no
# lines, and a "\r" with no "\n" after it ends nothing.
function split_lines(s: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] == '\n'
            end: i64 @= at

            if end > start && s[end - 1] == '\r'
                end @ end - 1
            out @ out.push(s.slice(from: start, to: end))
            start @ at + 1
        at @ at + 1

    if start < s.len()
        out @ out.push(s.slice(from: start, to: s.len()))
    return out

# The text of `s` before the first `sep` and the text after it, failing
# `not_found` where `s` holds no `sep`: `split_once(s: "k=v", sep: "=")`
# answers `Halves(before: "k", after: "v")`. An empty `sep` is found at the
# start.
function split_once(s: str, sep: str) -> Halves?
    at = scan.first_at(s: s, sep: sep)?
    before = s.slice(from: 0, to: at)
    after = s.slice(from: at + sep.len(), to: s.len())
    return ok(Halves(before: before, after: after))

## Tests

test "has_prefix: the empty prefix, a longer one, a match and a miss"
    assert has_prefix(s: "abc", prefix: "")
    assert has_prefix(s: "", prefix: "")
    assert !has_prefix(s: "ab", prefix: "abc")
    assert has_prefix(s: "abc", prefix: "ab")
    assert !has_prefix(s: "abc", prefix: "b")

test "has_suffix: the empty suffix, a longer one, a match and a miss"
    assert has_suffix(s: "abc", suffix: "")
    assert !has_suffix(s: "bc", suffix: "abc")
    assert has_suffix(s: "abc", suffix: "bc")
    assert !has_suffix(s: "abc", suffix: "b")

# `examples/ini`'s copies sliced the text, and `ends_with(text: "caffè",
# suffix: "e")` aborted there: the slice split the `è`.
test "has_prefix and has_suffix never cut a character in two"
    assert !has_suffix(s: "caffè", suffix: "e")
    assert has_suffix(s: "caffè", suffix: "è")
    assert !has_prefix(s: "épée", prefix: "a")
    assert has_prefix(s: "épée", prefix: "é")

test "contains: the empty text, a longer one, at either end, and nowhere"
    assert contains(s: "abc", substr: "")
    assert contains(s: "", substr: "")
    assert !contains(s: "ab", substr: "abc")
    assert contains(s: "abc", substr: "a")
    assert contains(s: "abc", substr: "bc")
    assert !contains(s: "abc", substr: "d")

# The copies named `holds` in `examples/query` and `examples/ledger` sliced the
# text at every byte, and `holds(text: "caffè latte", needle: "latte")` aborted.
test "contains reads a text holding characters of more than one byte"
    assert contains(s: "caffè latte", substr: "latte")
    assert contains(s: "caffè", substr: "è")
    assert !contains(s: "caffè", substr: "e")

test "trim_space: nothing to trim, white space alone, both ends"
    assert trim_space("") == ""
    assert trim_space(" \t\r\n ") == ""
    assert trim_space("a") == "a"
    assert trim_space(" \t a b \r\n") == "a b"

# U+3000 and U+00A0 built from their bytes, since a source may not hold an
# invisible character as itself.
test "trim_space trims Unicode's white space, and only at the ends"
    ideographic: [u8] = [0xe3, 0x80, 0x80]
    no_break: [u8] = [0xc2, 0xa0]
    wide = ideographic.validated_bytes().must()
    hard = no_break.validated_bytes().must()
    assert trim_space(hard + "x" + wide) == "x"
    assert trim_space("\u{85}x y\u{2029}") == "x y"
    assert trim_space("x" + hard + "y") == "x" + hard + "y"
    assert trim_space("é ") == "é"

test "fields: empty, white space alone, runs at both ends and inside"
    nothing: [str] = []
    assert fields("") == nothing
    assert fields(" \t\n ") == nothing
    assert fields("a") == ["a"]
    assert fields("  a  b  ") == ["a", "b"]
    assert fields("a\tb\nc\u{2028}d") == ["a", "b", "c", "d"]
    assert fields("caffè latte") == ["caffè", "latte"]

test "split_lines: no lines, one, and a last line with and without its end"
    nothing: [str] = []
    assert split_lines("") == nothing
    assert split_lines("a") == ["a"]
    assert split_lines("a\n") == ["a"]
    assert split_lines("a\nb") == ["a", "b"]
    assert split_lines("a\nb\n") == ["a", "b"]

test "split_lines keeps an empty line, ends one at CR LF, and a lone CR ends nothing"
    assert split_lines("\n") == [""]
    assert split_lines("a\n\nb") == ["a", "", "b"]
    assert split_lines("a\r\nb\r\n") == ["a", "b"]
    assert split_lines("\r\n") == [""]
    assert split_lines("a\rb") == ["a\rb"]

test "split_once: the first separator, a missing one, an empty one"
    halves = split_once(s: "key=value=more", sep: "=").must()
    assert halves.before == "key"
    assert halves.after == "value=more"
    empty = split_once(s: "abc", sep: "").must()
    assert empty.before == ""
    assert empty.after == "abc"
    whole = split_once(s: "a;", sep: ";").must()
    assert whole.before == "a"
    assert whole.after == ""

    match split_once(s: "abc", sep: ";")
        .ok _  => assert false
        .err e => assert e.code == "not_found"

## Admission
#
# Each function is here because the programs of `examples/` wrote it by hand,
# counted on 2026-11-06, in more than three lines or wrongly (the conventions,
# `examples/packages/README.md` § 7). The copies were found by what they do and
# not by their names, so several were named otherwise:
#
# - `has_prefix`, `has_suffix`: `starts_with` and `ends_with` in `ini`, and
#   `starts` in `markdown`, each slicing the text, so that `ends_with(text:
#   "caffè", suffix: "e")` aborted, run on 2026-11-06.
# - `contains`: `holds(text: str, needle: str) -> bool`, 3 copies, two in
#   `query` and one in `ledger`, slicing the text at every byte, so that
#   `holds(text: "caffè latte", needle: "latte")` aborted, run on 2026-11-06;
#   and `logs`'s `index_of(...) < 0`, asking the same.
# - `trim_space`: `trimmed`, 7 copies (`grep -rl '^function trimmed('
#   examples`) trimming space, tab and carriage return, and `ini`'s
#   `without_spaces`, trimming spaces alone.
# - `fields`: 4 copies splitting a text on runs of spaces, `split_words` in
#   `rpn` and `wordbands`, `words_of` in `wrap` and `gallery`.
# - `split_lines`: 9 copies (`grep -rl '^function split_lines(' examples`) that
#   disagreed: eight gave "a\n" one line and `query`'s gave it two, the second
#   empty, and `ini`'s built each line a character at a time, a quadratic loop.
# - `split_once`: `index_of(text: str, c: u8) -> i64`, 3 copies answering `0 -
#   1` where nothing was found (`grep -rl '^function index_of(text' examples`),
#   with 6 calls that cut a line at what it found, and `ini`'s
#   `index_of_equals`, which cut a line at its `=`.
#
# Not adopted, and what a program writes instead:
#
# - `is_space` on a byte, 9 copies of two lines in two contracts, seven without
#   a line feed and two with one: a program reading words asks `fields`, and
#   one that needs a byte's class writes the comparison, which names its own
#   set. The `gallery`'s `words_of` stays too: the gallery teaches the language
#   by writing that loop.
