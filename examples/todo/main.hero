# A todo list kept in a file.
#
#     heroes run examples/todo/main.hero -- examples/todo/sample.todo
#     heroes run examples/todo/main.hero -- /tmp/mine.todo add buy milk
#     heroes run examples/todo/main.hero -- /tmp/mine.todo done 2
#
#     main.hero    the program: arguments, the file, the one write
#     list.hero    the list, the format, and every change to it
#
# **The corpus's first program that writes.** `read_file` has been exercised
# since M-ffi-ladder and `write_file` had never been asked to do anything a
# reader could check; here the round trip is the program — add a task, write it,
# read it back, and the file on disk is the only place the state lives.
#
# The one write is in `save`, and everything that decides *what* to write is pure
# next door. That is what lets `list.hero`'s twenty assertions run without
# touching the disk, and it is what value semantics makes free: `complete`
# returns a new list, because there is nothing else it could return.

use list

function main()
    given = args()
    if len(given) == 0
        print("usage: todo <file> [add TEXT… | done N]")
        exit(2)
    match read_file(given[0])
        .err _   => stop("cannot read " + given[0])
        .ok text => run(text, given)

function stop(message: str)
    print(message)
    exit(1)

function run(text: str, given: [str])
    match list.read(text)
        .err e     => stop(e.code + ": " + e.msg)
        .ok tasks  => act(tasks, given)

function act(tasks: [list.Task], given: [str])
    if len(given) == 1
        show(tasks)
        return
    command = given[1]
    if command == "add"
        match list.add(tasks, rest_of(given, 2))
            .err e     => stop(e.code + ": " + e.msg)
            .ok grown  => save(grown, given[0])
    else if command == "done"
        match number_of(rest_of(given, 2))
            .err e => stop(e.code + ": " + e.msg)
            .ok n  => finish(tasks, n, given[0])
    else
        stop("no command `" + command + "` — say `add TEXT…` or `done N`")

function finish(tasks: [list.Task], n: i64, path: str)
    match list.complete(tasks, n)
        .err e     => stop(e.code + ": " + e.msg)
        .ok after  => save(after, path)

# The only line in this program that writes anything.
function save(tasks: [list.Task], path: str)
    match write_file(path: path, text: list.render(tasks))
        .err _ => stop("cannot write " + path)
        .ok _  => show(tasks)

function show(tasks: [list.Task])
    for line in list.numbered(tasks)
        print(line)
    print(list.left_to_do(tasks), " of ", tasks.len(), " left")

# Everything from `at` on, joined by a space — so `add buy milk` is one task and
# not two arguments the shell happened to split.
function rest_of(given: [str], at: i64) -> str
    words: [str] @ []
    for i in range(from: at, to: len(given))
        words @ words.push(given[i])
    return join(words, " ")

function number_of(word: str) -> i64?
    if word.len() == 0
        return fail("no_number", "`done` needs the number of a task")
    v: i64 @ 0
    for i in range(from: 0, to: word.len())
        if word[i] < '0' || word[i] > '9'
            return fail("no_number", "`" + word + "` is not a number")
        v @ v * 10 + to_i64(word[i] - '0').must()
    return ok(v)

test "the sample lists the way the file reads"
    tasks = list.read(read_file("examples/todo/sample.todo").must()).must()
    assert tasks.len() == 4
    assert list.left_to_do(tasks) == 2
    assert list.numbered(tasks)[0] == "1. [x] write the corpus harness"

test "a task added is a task on disk, read back by a second program"
    path = "/tmp/heroes-corpus-todo.txt"
    write_file(path: path, text: "[ ] one\n").must()
    first = list.read(read_file(path).must()).must()
    grown = list.add(first, "two").must()
    write_file(path: path, text: list.render(grown)).must()
    again = list.read(read_file(path).must()).must()
    assert again.len() == 2
    assert again[1].text == "two"
    assert again[1].done == false

test "completing a task survives the round trip through the file"
    path = "/tmp/heroes-corpus-todo-done.txt"
    write_file(path: path, text: "[ ] one\n[ ] two\n").must()
    tasks = list.read(read_file(path).must()).must()
    write_file(path: path, text: list.render(list.complete(tasks, 1).must())).must()
    after = list.read(read_file(path).must()).must()
    assert after[0].done == true
    assert after[1].done == false
    assert list.left_to_do(after) == 1

test "arguments after the command become one task"
    assert rest_of(["f", "add", "buy", "milk"], 2) == "buy milk"
    assert rest_of(["f", "add"], 2) == ""
    assert number_of("12").must() == 12
    assert number_of("x").is_err()
    assert number_of("").is_err()
