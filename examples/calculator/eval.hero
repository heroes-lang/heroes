# The evaluator, the tree simplifier, and the one function that puts the whole
# pipeline together. It names both modules below it, and this is the file where
# the rule earns its keep: `parse.expression(@p)` says where the recursion lives
# without opening another file, and so does `lex.tokenize`.

use lex
use parse

## Error codes
#
# One `constant` per code, so a typo is `error[unknown_name]` here rather
# than a comparison that is quietly false forever (panel 034 R4).

constant ERR_TRAILING_TOKENS: str
    "trailing_tokens"

constant ERR_UNKNOWN_NAME: str
    "unknown_name"

# The lowest `i64`, the other end of the type whose top is `lex.LARGEST`. No
# literal writes it, the grammar having no minus, but a variable of the
# environment may hold it, so a sum or a product is asked against both ends.
constant SMALLEST: i64
    -9223372036854775807 - 1

## Evaluator

# The value bound to a name, with a decent message if absent.
function lookup(env: {str: i64}, name: str) -> i64?
    if env[name].is_err()
        return fail(code: ERR_UNKNOWN_NAME, msg: "undefined variable: " + name)
    return ok(env[name].must())

# The sum of the children, left to right, or `does_not_fit` naming the step
# whose total would pass an end of `i64`. Each step asks before it adds, so
# none can overflow: the loop that added first aborted the program, `integer
# overflow`, on `9223372036854775807 + 1` (defect 2567), where a result too
# large is the input's mistake and can be told, as `lex.read_number` tells a
# literal too large. Left to right as the language adds `a + b + c`, so a
# total that passes an end on the way is refused though a later term would
# have brought it back.
function sum_of(children: [parse.Expr], env: {str: i64}) -> i64?
    tot: i64 @= 0

    for c in children
        addend = evaluate(c, env)?

        if sum_passes(total: tot, addend: addend)
            return fail(
                code: lex.ERR_DOES_NOT_FIT,
                msg: tot.to_str() + " + " + addend.to_str() + " does not fit an i64"
            )
        tot @ tot + addend

    return ok(tot)

# The product of the children, asked at each step as `sum_of` asks.
function product_of(children: [parse.Expr], env: {str: i64}) -> i64?
    tot: i64 @= 1

    for c in children
        multiplier = evaluate(c, env)?

        if product_passes(total: tot, multiplier: multiplier)
            return fail(
                code: lex.ERR_DOES_NOT_FIT,
                msg: tot.to_str() + " * " + multiplier.to_str() + " does not fit an i64"
            )
        tot @ tot * multiplier

    return ok(tot)

# Whether `total + addend` passes an end of `i64`. Each subtraction is asked
# only where its sign keeps it inside the type: `LARGEST - addend` for a
# positive `addend`, `SMALLEST - addend` for a negative one.
function sum_passes(total: i64, addend: i64) -> bool
    return addend > 0 && total > lex.LARGEST - addend || addend < 0 && total < SMALLEST - addend

# Whether `total * multiplier` passes an end of `i64`, asked by a division that
# cannot itself overflow, one for each pair of signs. `/` truncates toward
# zero (spec § Operators), so `LARGEST / multiplier` is the largest `total` a
# positive `multiplier` may meet, and the negative quotients bound the same way
# from below; the one division that could overflow, `SMALLEST / -1`, is never
# asked, its numerator being `LARGEST` wherever the divisor may be negative.
function product_passes(total: i64, multiplier: i64) -> bool
    if total == 0 || multiplier == 0
        return false

    if total > 0 && multiplier > 0
        return total > lex.LARGEST / multiplier

    if total > 0
        return multiplier < SMALLEST / total

    if multiplier > 0
        return total < SMALLEST / multiplier
    return multiplier < lex.LARGEST / total

# The value of the tree. Fails on the first unknown name.
function evaluate(e: parse.Expr, env: {str: i64}) -> i64?
    return match e
        .num n      => ok(n.v)
        .variable x => env.lookup(x.name)
        .sum s      => s.children.sum_of(env)
        .product q  => q.children.product_of(env)

# Every name appearing in the tree, with repetitions.
function names_used(e: parse.Expr) -> [str]
    return match e
        .num _      => []
        .variable x => [x.name]
        .sum s      => names_of(s.children)
        .product q  => names_of(q.children)

function names_of(children: [parse.Expr]) -> [str]
    out: [str] @= []

    for c in children
        for n in c.names_used()
            out @ out.push(n)

    return out

## Interface

# From text to result, in one call.
function calculate(text: str, env: {str: i64}) -> i64?
    ts = lex.tokenize(text)?
    p: parse.Parse @= parse.Parse(ts: ts, pos: 0)
    tree = parse.expression(@p)?

    if !parse.parse_at_end(p)
        return fail(code: ERR_TRAILING_TOKENS, msg: "leftover input at the end")
    return evaluate(tree, env)

test "precedence and parens"
    empty: {str: i64} = {}
    assert calculate("2 + 3 * 4", empty).must() == 14
    assert calculate("(2 + 3) * 4", empty).must() == 20
    assert calculate("2 * 3 * 4", empty).must() == 24

test "variables from the environment"
    env = {"x": 10, "y": 4}
    assert calculate("x * y + 2", env).must() == 42

test "errors reach the top"
    empty: {str: i64} = {}

    match calculate("2 +", empty)
        .ok _  => assert false
        .err e => assert e.code == parse.ERR_UNEXPECTED_END

    match calculate("z + 1", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_UNKNOWN_NAME

    match calculate("(2 + 3", empty)
        .ok _  => assert false
        .err e => assert e.code == parse.ERR_UNCLOSED_PAREN

# Each refusal below aborted the program, `integer overflow`, before.
test "defect 2567: a sum or a product past either end of an i64 is told, and one that fits is kept"
    empty: {str: i64} = {}

    match calculate("9223372036854775807 + 1", empty)
        .ok _  => assert false
        .err e => assert e.code == lex.ERR_DOES_NOT_FIT && e.msg == "9223372036854775807 + 1 does not fit an i64"

    match calculate("3037000500 * 3037000500", empty)
        .ok _  => assert false
        .err e => assert e.code == lex.ERR_DOES_NOT_FIT && e.msg == "3037000500 * 3037000500 does not fit an i64"

    assert calculate("9223372036854775806 + 1", empty).must() == 9223372036854775807
    assert calculate("3037000499 * 3037000499", empty).must() == 9223372030926249001
    assert calculate("0 * 9223372036854775807 * 9223372036854775807", empty).must() == 0

    # The grammar writes no minus, so the environment carries the lower end.
    low = {"m": SMALLEST, "n": -1, "h": -4611686018427387904}

    match calculate("m + n", low)
        .ok _  => assert false
        .err e => assert e.code == lex.ERR_DOES_NOT_FIT && e.msg == "-9223372036854775808 + -1 does not fit an i64"

    assert calculate("m * n", low).is_err()
    assert calculate("n * m", low).is_err()
    assert calculate("h * 2 + n", low).is_err()
    assert calculate("h * 3", low).is_err()
    assert calculate("n * h * 2", low).is_err()
    assert calculate("h * 2", low).must() == SMALLEST
    assert calculate("m + 9223372036854775807", low).must() == -1

test "values are always copies"
    a = [1, 2, 3]
    b: [i64] @= a
    b @ b.push(4)
    assert a.len() == 3
    assert b.len() == 4

## Simplifier

# Simplify the tree: `x * 1` becomes `x`, `x + 0` becomes `x`.
#
# Bottom-up: every child is simplified before the node itself, so
# `(x + 0) * 1` collapses in one pass. A node whose children all vanish
# collapses to the identity it was built around — an empty `sum` is 0 and an
# empty `product` is 1, which is the same rule `sum_of` and `product_of` use for
# an empty list.
function simplify(e: parse.Expr) -> parse.Expr
    return match e
        .num _      => e
        .variable _ => e
        .sum s      => rebuild(kept: keep_sum(s.children), zero: true)
        .product q  => rebuild(kept: keep_product(q.children), zero: false)

# The children of a sum that survive: each simplified, and the literal zeroes
# dropped because adding one changes nothing.
function keep_sum(children: [parse.Expr]) -> [parse.Expr]
    out: [parse.Expr] @= []

    for child in children
        one = simplify(child)

        if !is_literal(e: one, v: 0)
            out @ out.push(one)

    return out

# The same for a product, dropping the ones.
function keep_product(children: [parse.Expr]) -> [parse.Expr]
    out: [parse.Expr] @= []

    for child in children
        one = simplify(child)

        if !is_literal(e: one, v: 1)
            out @ out.push(one)

    return out

# Is this node exactly the literal `v`?
function is_literal(e: parse.Expr, v: i64) -> bool
    return match e
        .num n      => n.v == v
        .variable _ => false
        .sum _      => false
        .product _  => false

# One child left is that child; none left is the operation's identity.
function rebuild(kept: [parse.Expr], zero: bool) -> parse.Expr
    if kept.len() == 1
        return kept[0]

    if kept.len() == 0
        if zero
            return .num(v: 0)
        return .num(v: 1)

    if zero
        return .sum(children: kept)
    return .product(children: kept)
