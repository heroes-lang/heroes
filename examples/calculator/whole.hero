# The calculator — design.md's appendix program, and M-generics-library's acceptance criterion:
# it compiles, it runs, its tests pass.
#
# Three differences from the appendix. There the `simplify` function is a `???`
# under a "## To do" heading, because §4.16's hole is a form the document has to
# demonstrate somewhere; here it is written, because a program with a hole
# produces no binary by design and this one has to run. And a literal, a sum or a
# product past an `i64` is told by name, `does_not_fit`, where the appendix's copy
# aborts, `integer overflow`: `read_number` (defect 2548), `sum_of` and
# `product_of` (defect 2567). Everything else is the appendix verbatim. The
# net's `special` suite asks that this file and `main.hero`'s four modules print
# the same; design.md's copy was resolved and typed by the Rust bootstrap's
# `acceptance.rs` tests until the tag `m-bootstrap-archive`, and by none since.
#
# What it exercises: a recursive variant through `[Expr]`, a hand-written
# tokeniser and recursive-descent parser, `T?` with `?` propagation, a map as an
# environment, a user-declared generic, and nine `test` blocks.

## Calculator
#
# **Lexer**, **parser** and **evaluator** for arithmetic expressions
# with variables. A compiler in miniature.
#
# Grammar, increasing precedence:
#
#     expression := term ('+' term)*
#     term       := factor ('*' factor)*
#     factor     := number | name | '(' expression ')'

## Error codes
#
# One `constant` per code, so a typo is `error[unknown_name]` here rather
# than a comparison that is quietly false forever (panel 034 R4).

constant ERR_EXPECTED_FACTOR: str
    "expected_factor"

constant ERR_TRAILING_TOKENS: str
    "trailing_tokens"

constant ERR_UNCLOSED_PAREN: str
    "unclosed_paren"

constant ERR_UNEXPECTED_END: str
    "unexpected_end"

constant ERR_UNKNOWN_CHAR: str
    "unknown_char"

constant ERR_UNKNOWN_NAME: str
    "unknown_name"

# A number written past what an `i64` holds: the built-ins' own code.
constant ERR_DOES_NOT_FIT: str
    "does_not_fit"

# The largest number a literal may write.
constant LARGEST: i64
    9223372036854775807

# The lowest `i64`, the other end of the type whose top is `LARGEST`. No
# literal writes it, the grammar having no minus, but a variable of the
# environment may hold it, so a sum or a product is asked against both ends.
constant SMALLEST: i64
    -9223372036854775807 - 1

## Generic library

# Applies `f` to every element, in order. Named `apply` rather than `map`
# because `map` is a built-in name and no file may redeclare one (panel 015);
# the point here is generics, and any name demonstrates them.
function apply<A, B>(xs: [A], f: (function(A) -> B)) -> [B]
    out: [B] @= []

    for x in xs
        out @ out.push(f(x))

    return out

# Reduces the sequence to one value, from the left. `fold` is a built-in name
# too, so this one is `reduce`.
function reduce<A, B>(xs: [A], initial: B, f: (function(B, A) -> B)) -> B
    acc: B @= initial

    for x in xs
        acc @ f(acc, x)

    return acc

function plus(a: i64, b: i64) -> i64
    return a + b

test "generics work across types"
    assert [1, 2, 3].apply(double) == [2, 4, 6]
    assert [1, 2, 3, 4].reduce(0, plus) == 10

function double(n: i64) -> i64
    return n * 2

## Tokens

variant Token
    num
        v: i64
    name
        s: str
    plus
    times
    lparen
    rparen

# Text and position. Travels through the lexer as `@`.
record Lex
    text: str
    pos: i64

function at_end(l: Lex) -> bool
    return l.pos >= l.text.len()

function here(l: Lex) -> u8
    return l.text[l.pos]

function advance(@l: Lex)
    l.pos @ l.pos + 1

function is_digit(c: u8) -> bool
    return c >= '0' && c <= '9'

function is_letter(c: u8) -> bool
    return c >= 'a' && c <= 'z'

# Reads an integer, consuming it, or fails naming a number past an `i64`.
#
# Each digit asks first whether it would carry the number past `LARGEST`, so
# no step can overflow: the loop that multiplied before it asked aborted the
# program, `integer overflow`, on `99999999999999999999` (defect 2548), where
# a number too large is the text's mistake and can be told. The rest of the
# digits are still consumed, so the failure names the whole number.
function read_number(@l: Lex) -> i64?
    start = l.pos
    v: i64 @= 0
    past: bool @= false

    while !l.at_end() && l.here().is_digit()
        digit = to_i64(l.here() - '0').must()
        past @ past || v > (LARGEST - digit) / 10

        if !past
            v @ v * 10 + digit
        advance(@l)

    if past
        return fail(
            code: ERR_DOES_NOT_FIT,
            msg: "`" + l.text.slice(from: start, to: l.pos) + "` at position " + start.to_str() + " does not fit an i64"
        )
    return ok(v)

# Reads an identifier, consuming it.
function read_name(@l: Lex) -> str
    start = l.pos

    while !l.at_end() && l.here().is_letter()
        advance(@l)

    return l.text.slice(from: start, to: l.pos)

# Splits the text into tokens. Fails on the first unknown character.
function tokenize(text: str) -> [Token]?
    l: Lex @= Lex(text: text, pos: 0)
    out: [Token] @= []

    while !l.at_end()
        c = l.here()

        if c == ' '
            advance(@l)
        else if c.is_digit()
            out @ out.push(.num(v: read_number(@l)?))
        else if c.is_letter()
            out @ out.push(.name(s: read_name(@l)))
        else if c == '+'
            out @ out.push(.plus)
            advance(@l)
        else if c == '*'
            out @ out.push(.times)
            advance(@l)
        else if c == '('
            out @ out.push(.lparen)
            advance(@l)
        else if c == ')'
            out @ out.push(.rparen)
            advance(@l)
        else
            return fail(code: ERR_UNKNOWN_CHAR, msg: "at position " + l.pos.to_str())

    return ok(out)

test "tokenizes numbers, names and symbols"
    ts = tokenize("12 + xy * (3)").must()
    assert ts.len() == 7
    assert ts[0] == .num(v: 12)
    assert ts[1] == .plus
    assert ts[2] == .name(s: "xy")

test "tokenize rejects the unknown"
    match tokenize("2 $ 3")
        .ok _  => assert false
        .err e => assert e.code == ERR_UNKNOWN_CHAR

# DEFECT 2548, held as a test (2026-11-15): a literal past an `i64` aborted the
# program, `integer overflow`; it is refused by name now, and the largest `i64`
# is read.
test "tokenize refuses a number past an i64 by name, and reads the largest"
    assert tokenize("9223372036854775807").must()[0] == .num(v: 9223372036854775807)

    match tokenize("1 + 99999999999999999999")
        .ok _  => assert false
        .err e => assert e.code == ERR_DOES_NOT_FIT && e.msg == "`99999999999999999999` at position 4 does not fit an i64"

    match tokenize("9223372036854775808")
        .ok _  => assert false
        .err e => assert e.code == ERR_DOES_NOT_FIT

## Syntax tree

# A tree node. Children live in an array, which is the language's
# only indirection: that is what makes the recursive type finite.
variant Expr
    num
        v: i64
    variable
        name: str
    sum
        children: [Expr]
    product
        children: [Expr]

# Tokens and position. Travels through the parser as `@`.
record Parse
    ts: [Token]
    pos: i64

function parse_at_end(p: Parse) -> bool
    return p.pos >= p.ts.len()

function parse_here(p: Parse) -> Token
    return p.ts[p.pos]

function parse_advance(@p: Parse)
    p.pos @ p.pos + 1

## Parser
#
# Recursive descent. The four functions call each other; declaration
# order does not matter, so mutual recursion needs no forward
# declarations.

# A number, a name, or a parenthesised expression.
function factor(@p: Parse) -> Expr?
    if p.parse_at_end()
        return fail(code: ERR_UNEXPECTED_END, msg: "the expression ends too soon")

    t = p.parse_here()
    parse_advance(@p)

    return match t
        .num n                   => ok(.num(v: n.v))
        .name x                  => ok(.variable(name: x.s))
        .lparen                  => group(@p)
        .plus | .times | .rparen => fail(code: ERR_EXPECTED_FACTOR, msg: "found an operator")

# An expression followed by its closing paren.
function group(@p: Parse) -> Expr?
    inner = expression(@p)?

    if p.parse_at_end()
        return fail(code: ERR_UNCLOSED_PAREN, msg: "missing closing paren")

    if p.parse_here() != .rparen
        return fail(code: ERR_UNCLOSED_PAREN, msg: "missing closing paren")
    parse_advance(@p)
    return ok(inner)

# A product of one or more factors.
function term(@p: Parse) -> Expr?
    first = factor(@p)?
    children: [Expr] @= [first]

    while !p.parse_at_end() && p.parse_here() == .times
        parse_advance(@p)
        children @ children.push(factor(@p)?)

    if children.len() == 1
        return ok(first)
    return ok(.product(children: children))

# A sum of one or more terms.
function expression(@p: Parse) -> Expr?
    first = term(@p)?
    children: [Expr] @= [first]

    while !p.parse_at_end() && p.parse_here() == .plus
        parse_advance(@p)
        children @ children.push(term(@p)?)

    if children.len() == 1
        return ok(first)
    return ok(.sum(children: children))

## Evaluator

# The value bound to a name, with a decent message if absent.
function lookup(env: {str: i64}, name: str) -> i64?
    if env[name].is_err()
        return fail(code: ERR_UNKNOWN_NAME, msg: "undefined variable: " + name)
    return ok(env[name].must())

# The sum of the children, left to right, or `does_not_fit` naming the step
# whose total would pass an end of `i64`. Each step asks before it adds, so
# none can overflow: the loop that added first aborted the program, `integer
# overflow`, on `9223372036854775807 + 1` (defect 2567), where a result too
# large is the input's mistake and can be told, as `read_number` tells a
# literal too large. Left to right as the language adds `a + b + c`, so a
# total that passes an end on the way is refused though a later term would
# have brought it back.
function sum_of(children: [Expr], env: {str: i64}) -> i64?
    tot: i64 @= 0

    for c in children
        addend = evaluate(c, env)?

        if sum_passes(total: tot, addend: addend)
            return fail(code: ERR_DOES_NOT_FIT, msg: tot.to_str() + " + " + addend.to_str() + " does not fit an i64")
        tot @ tot + addend

    return ok(tot)

# The product of the children, asked at each step as `sum_of` asks.
function product_of(children: [Expr], env: {str: i64}) -> i64?
    tot: i64 @= 1

    for c in children
        multiplier = evaluate(c, env)?

        if product_passes(total: tot, multiplier: multiplier)
            return fail(
                code: ERR_DOES_NOT_FIT,
                msg: tot.to_str() + " * " + multiplier.to_str() + " does not fit an i64"
            )
        tot @ tot * multiplier

    return ok(tot)

# Whether `total + addend` passes an end of `i64`. Each subtraction is asked
# only where its sign keeps it inside the type: `LARGEST - addend` for a
# positive `addend`, `SMALLEST - addend` for a negative one.
function sum_passes(total: i64, addend: i64) -> bool
    return addend > 0 && total > LARGEST - addend || addend < 0 && total < SMALLEST - addend

# Whether `total * multiplier` passes an end of `i64`, asked by a division that
# cannot itself overflow, one for each pair of signs. `/` truncates toward
# zero (spec § Operators), so `LARGEST / multiplier` is the largest `total` a
# positive `multiplier` may meet, and the negative quotients bound the same way
# from below; the one division that could overflow, `SMALLEST / -1`, is never
# asked, its numerator being `LARGEST` wherever the divisor may be negative.
function product_passes(total: i64, multiplier: i64) -> bool
    if total == 0 || multiplier == 0
        return false

    if total > 0 && multiplier > 0
        return total > LARGEST / multiplier

    if total > 0
        return multiplier < SMALLEST / total

    if multiplier > 0
        return total < SMALLEST / multiplier
    return multiplier < LARGEST / total

# The value of the tree. Fails on the first unknown name.
function evaluate(e: Expr, env: {str: i64}) -> i64?
    return match e
        .num n      => ok(n.v)
        .variable x => env.lookup(x.name)
        .sum s      => s.children.sum_of(env)
        .product q  => q.children.product_of(env)

# Every name appearing in the tree, with repetitions.
function names_used(e: Expr) -> [str]
    return match e
        .num _      => []
        .variable x => [x.name]
        .sum s      => names_of(s.children)
        .product q  => names_of(q.children)

function names_of(children: [Expr]) -> [str]
    out: [str] @= []

    for c in children
        for n in c.names_used()
            out @ out.push(n)

    return out

## Interface

# From text to result, in one call.
function calculate(text: str, env: {str: i64}) -> i64?
    ts = tokenize(text)?
    p: Parse @= Parse(ts: ts, pos: 0)
    tree = expression(@p)?

    if !p.parse_at_end()
        return fail(code: ERR_TRAILING_TOKENS, msg: "leftover input at the end")
    return evaluate(tree, env)

test "precedence and parens"
    empty: {str: i64} = {}
    assert calculate("2 + 3 * 4", empty).must() == 14
    assert calculate("(2 + 3) * 4", empty).must() == 20
    assert calculate("2 * 3 * 4", empty).must() == 24

test "variables from the environment"
    env = {"x": 10, "y": 4}
    assert calculate("x * y + 2", env).must() == 42

test "errors reach the top"
    empty: {str: i64} = {}

    match calculate("2 +", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_UNEXPECTED_END

    match calculate("z + 1", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_UNKNOWN_NAME

    match calculate("(2 + 3", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_UNCLOSED_PAREN

# Each refusal below aborted the program, `integer overflow`, before.
test "defect 2567: a sum or a product past either end of an i64 is told, and one that fits is kept"
    empty: {str: i64} = {}

    match calculate("9223372036854775807 + 1", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_DOES_NOT_FIT && e.msg == "9223372036854775807 + 1 does not fit an i64"

    match calculate("3037000500 * 3037000500", empty)
        .ok _  => assert false
        .err e => assert e.code == ERR_DOES_NOT_FIT && e.msg == "3037000500 * 3037000500 does not fit an i64"

    assert calculate("9223372036854775806 + 1", empty).must() == 9223372036854775807
    assert calculate("3037000499 * 3037000499", empty).must() == 9223372030926249001
    assert calculate("0 * 9223372036854775807 * 9223372036854775807", empty).must() == 0

    # The grammar writes no minus, so the environment carries the lower end.
    low = {"m": SMALLEST, "n": -1, "h": -4611686018427387904}

    match calculate("m + n", low)
        .ok _  => assert false
        .err e => assert e.code == ERR_DOES_NOT_FIT && e.msg == "-9223372036854775808 + -1 does not fit an i64"

    assert calculate("m * n", low).is_err()
    assert calculate("n * m", low).is_err()
    assert calculate("h * 2 + n", low).is_err()
    assert calculate("h * 3", low).is_err()
    assert calculate("n * h * 2", low).is_err()
    assert calculate("h * 2", low).must() == SMALLEST
    assert calculate("m + 9223372036854775807", low).must() == -1

test "values are always copies"
    a = [1, 2, 3]
    b: [i64] @= a
    b @ b.push(4)
    assert a.len() == 3
    assert b.len() == 4

# Simplify the tree: `x * 1` becomes `x`, `x + 0` becomes `x`.
#
# Bottom-up: every child is simplified before the node itself, so
# `(x + 0) * 1` collapses in one pass. A node whose children all vanish
# collapses to the identity it was built around — an empty `sum` is 0 and an
# empty `product` is 1, which is the same rule `sum_of` and `product_of` use for
# an empty list.
function simplify(e: Expr) -> Expr
    return match e
        .num _      => e
        .variable _ => e
        .sum s      => rebuild(kept: keep_sum(s.children), zero: true)
        .product q  => rebuild(kept: keep_product(q.children), zero: false)

# The children of a sum that survive: each simplified, and the literal zeroes
# dropped because adding one changes nothing.
function keep_sum(children: [Expr]) -> [Expr]
    out: [Expr] @= []

    for child in children
        one = simplify(child)

        if !is_literal(e: one, v: 0)
            out @ out.push(one)

    return out

# The same for a product, dropping the ones.
function keep_product(children: [Expr]) -> [Expr]
    out: [Expr] @= []

    for child in children
        one = simplify(child)

        if !is_literal(e: one, v: 1)
            out @ out.push(one)

    return out

# Is this node exactly the literal `v`?
function is_literal(e: Expr, v: i64) -> bool
    return match e
        .num n      => n.v == v
        .variable _ => false
        .sum _      => false
        .product _  => false

# One child left is that child; none left is the operation's identity.
function rebuild(kept: [Expr], zero: bool) -> Expr
    if kept.len() == 1
        return kept[0]

    if kept.len() == 0
        if zero
            return .num(v: 0)
        return .num(v: 1)

    if zero
        return .sum(children: kept)
    return .product(children: kept)

## Program

function main()
    env = {"x": 10, "y": 4}

    cases = [
        "2 + 3 * 4"
        "(2 + 3) * 4"
        "x * y + 2"
        "z + 1"
        "2 +"
    ]

    for c in cases
        match calculate(c, env)
            .ok v  => print(c, " = ", v)
            .err e => print(c, " -> ", e.code, ": ", e.msg)
