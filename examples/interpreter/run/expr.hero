# What an expression means — and the four ways arithmetic can stop a program
# that this module refuses instead of suffering.
#
# Part of `examples/interpreter/` — the root `main.hero` carries the program's
# argument. **This module's name collides with `syn/expr.hero`** and the header
# there explains why the collision is the honest one: that file reads an
# expression, this one gives it a meaning.
#
# HOW THIS MODULE CALLS A FUNCTION WITHOUT KNOWING HOW TO RUN A BODY. A script
# function's body is statements, and statements are `run/eval.hero`'s job — but
# an expression can hold a call, so the two need each other. Heroes refuses a
# module cycle (`error[module_cycle]`, on the `use` edge whatever it carries),
# so the loop is broken with a **function value**: `evaluated` takes
# `(function(value.Request) -> value.Frame?)` and `run/eval.hero` hands it its
# own `called`. The recursion is real and it crosses a `use` in one direction
# only, which is the shape a language without module cycles forces and the
# reason the corpus wanted a program this size.
#
# THE FOUR REFUSALS, and every one of them is Heroes aborting if it is not
# caught here (design.md §1.12, CLAUDE.md §12 — robustness beats every other
# criterion):
#
#   - division by zero, which the spec says aborts;
#   - `%` by zero, guarded like `/` for the same reason;
#   - `+`, `-` and `*` overflowing, which aborts at every width;
#   - `INT64_MIN / -1`, which is the one division that overflows.
#
# A script is INPUT. A program that a line of its input can kill is a program
# with a hole in it, so each of these is a named refusal with a message, and
# the tests at the bottom feed the extremes to prove it.

use run/value
use syn/tree

constant ERR_NAME: str
    "unknown_name"

constant ERR_MATH: str
    "arithmetic"

constant ERR_TYPE: str
    "type"

constant MAX: i64
    9223372036854775807

constant MIN: i64
    0 - 9223372036854775807 - 1

# A value, and the frame the evaluation left behind — a call can define nothing
# but it can print, so the frame comes back even from an expression.
record Answer
    frame: value.Frame
    got: value.Value

# One expression. `call` is `run/eval.hero`'s door: see the module header.
function evaluated(nodes: tree.Tree, id: i64, f: value.Frame, call: (function(value.Request) -> value.Frame?)) -> Answer?
    return match nodes.exprs[id]
        .number n => ok(Answer(frame: f, got: .number(v: n.value)))
        .text x   => ok(Answer(frame: f, got: .text(s: x.value)))
        .truth b  => ok(Answer(frame: f, got: .truth(b: b.value)))
        .name n   => looked_up(f: f, word: n.value)
        .negate u => negated(nodes: nodes, id: u.on, f: f, call: call)
        .invert u => inverted(nodes: nodes, id: u.on, f: f, call: call)
        .binary b => joined(nodes: nodes, op: b.op, left: b.left, right: b.right, f: f, call: call)
        .call c   => applied(nodes: nodes, name: c.name, ids: c.args, f: f, call: call)

function looked_up(f: value.Frame, word: str) -> Answer?
    held = f.vars[word]

    if held.is_err()
        return fail(ERR_NAME, "`" + word + "` has no value — nothing has been let to that name")

    return ok(Answer(frame: f, got: held.must()))

function negated(nodes: tree.Tree, id: i64, f: value.Frame, call: (function(value.Request) -> value.Frame?)) -> Answer?
    inner = evaluated(nodes, id, f, call)?
    n = value.number_of(inner.got)?

    if n == MIN
        return fail(ERR_MATH, "negating the smallest number has no answer that fits")

    return ok(Answer(frame: inner.frame, got: .number(v: 0 - n)))

function inverted(nodes: tree.Tree, id: i64, f: value.Frame, call: (function(value.Request) -> value.Frame?)) -> Answer?
    inner = evaluated(nodes, id, f, call)?
    return ok(Answer(frame: inner.frame, got: .truth(b: !value.condition_of(inner.got)?)))

# Two sides, or one where the operator short-circuits. `&&` and `||` do not
# evaluate their right side when the left decides the answer, which is the
# rule Heroes keeps for its own (spec § Operators) and the reason they cannot
# go through the same path as `+`.
function joined(nodes: tree.Tree, op: tree.Op, left: i64, right: i64, f: value.Frame, call: (function(value.Request) -> value.Frame?)) -> Answer?
    first = evaluated(nodes, left, f, call)?

    if op == .both
        if !value.condition_of(first.got)?
            return ok(Answer(frame: first.frame, got: .truth(b: false)))
        second = evaluated(nodes, right, first.frame, call)?
        return ok(Answer(frame: second.frame, got: .truth(b: value.condition_of(second.got)?)))

    if op == .either
        if value.condition_of(first.got)?
            return ok(Answer(frame: first.frame, got: .truth(b: true)))
        second = evaluated(nodes, right, first.frame, call)?
        return ok(Answer(frame: second.frame, got: .truth(b: value.condition_of(second.got)?)))
    second = evaluated(nodes, right, first.frame, call)?
    got = combined(op: op, a: first.got, b: second.got)?
    return ok(Answer(frame: second.frame, got: got))

# The operators that want both sides. Kept apart from `joined` so that the
# arithmetic can be tested without a frame, which is what the extremes at the
# bottom of this file do.
function combined(op: tree.Op, a: value.Value, b: value.Value) -> value.Value?
    if op == .add
        if is_text(a) || is_text(b)
            return ok(.text(s: value.text_of(a)? + value.text_of(b)?))

        return ok(.number(v: plus(a: value.number_of(a)?, b: value.number_of(b)?)?))

    if op == .subtract
        return ok(.number(v: minus(a: value.number_of(a)?, b: value.number_of(b)?)?))

    if op == .multiply
        return ok(.number(v: times(a: value.number_of(a)?, b: value.number_of(b)?)?))

    if op == .divide
        return ok(.number(v: over(a: value.number_of(a)?, b: value.number_of(b)?)?))

    if op == .remainder
        return ok(.number(v: rest(a: value.number_of(a)?, b: value.number_of(b)?)?))

    if op == .equal
        return ok(.truth(b: a == b))

    if op == .unequal
        return ok(.truth(b: a != b))

    return ordered(op: op, a: value.number_of(a)?, b: value.number_of(b)?)

function ordered(op: tree.Op, a: i64, b: i64) -> value.Value?
    if op == .less
        return ok(.truth(b: a < b))

    if op == .less_equal
        return ok(.truth(b: a <= b))

    if op == .greater
        return ok(.truth(b: a > b))

    if op == .greater_equal
        return ok(.truth(b: a >= b))

    return fail(ERR_TYPE, "`" + tree.shown_op(op) + "` does not take two values here")

function is_text(v: value.Value) -> bool
    return match v
        .text _   => true
        .number _ => false
        .truth _  => false
        .nothing  => false

# `a + b`, refusing rather than aborting. The test is written as a subtraction
# against the limit because computing the sum is the overflow.
function plus(a: i64, b: i64) -> i64?
    if b > 0 && a > MAX - b
        return too_big(a: a, b: b, op: "+")

    if b < 0 && a < MIN - b
        return too_big(a: a, b: b, op: "+")

    return ok(a + b)

function minus(a: i64, b: i64) -> i64?
    if b < 0 && a > MAX + b
        return too_big(a: a, b: b, op: "-")

    if b > 0 && a < MIN + b
        return too_big(a: a, b: b, op: "-")

    return ok(a - b)

# `a * b`, refusing rather than aborting.
#
# The smallest number is handled first and on its own, because the usual trick
# — compare the magnitudes against `MAX / |b|` — needs to negate, and negating
# the smallest number is itself the overflow. What is left after that gate has
# a safe magnitude, so one division answers the question.
#
# ONE DELIBERATE CONSERVATISM, stated rather than hidden: the bound is `MAX`,
# and the true range of a product reaches `MIN`, whose magnitude is one larger.
# So a script that multiplies its way to exactly the smallest number gets a
# refusal instead of an answer. Refusing a value that fits is a smaller wrong
# than aborting, and the alternative is a second bound for the mixed-sign case
# that nothing in this program needs.
function times(a: i64, b: i64) -> i64?
    if a == 0 || b == 0
        return ok(0)

    if a == 1
        return ok(b)

    if b == 1
        return ok(a)

    if a == MIN || b == MIN
        return too_big(a: a, b: b, op: "*")
    am = size_of(a)
    bm = size_of(b)

    if am > MAX / bm
        return too_big(a: a, b: b, op: "*")

    return ok(a * b)

# `|n|`, for an `n` that is not the smallest number — the caller has already
# refused that one, and this function says so rather than guessing.
function size_of(n: i64) -> i64
    if n < 0
        return 0 - n

    return n

function over(a: i64, b: i64) -> i64?
    if b == 0
        return fail(ERR_MATH, "dividing " + a.to_str() + " by zero has no answer")

    # The one division that overflows: the smallest number by -1. Heroes aborts
    # on it and the spec says so, so it is a refusal here.
    if a == MIN && b == 0 - 1
        return too_big(a: a, b: b, op: "/")

    return ok(a / b)

function rest(a: i64, b: i64) -> i64?
    if b == 0
        return fail(ERR_MATH, "the remainder of " + a.to_str() + " by zero has no answer")

    if a == MIN && b == 0 - 1
        return too_big(a: a, b: b, op: "%")

    return ok(a % b)

function too_big(a: i64, b: i64, op: str) -> i64?
    return fail(
        ERR_MATH,
        a.to_str() + " " + op + " " + b.to_str() + " does not fit in a 64-bit number"
    )

# A call: the arguments first, left to right, then the door into
# `run/eval.hero`.
function applied(nodes: tree.Tree, name: str, ids: [i64], f: value.Frame, call: (function(value.Request) -> value.Frame?)) -> Answer?
    walking: value.Frame @ f
    given: [value.Value] @ []

    for id in ids
        step = evaluated(nodes, id, walking, call)?
        walking @ step.frame
        given @ given.push(step.got)

    after = call(value.Request(nodes: nodes, name: name, given: given, frame: walking))?
    result = after.result
    home: value.Frame @ after
    home.returned @ false
    home.result @ .nothing
    return ok(Answer(frame: home, got: result))
