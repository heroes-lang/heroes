# A whole little language, scanned, parsed and run — the corpus's first
# program between a program and a compiler.
#
# Corpus material (CLAUDE.md §9), M-corpus-depth's rung. What this program is
# for was measured on 2026-09-03 over the 78 files then in `examples/`: the
# largest program here was `json/` at 671 lines and the compiler was 50,452,
# and between them there was nothing. So the corpus had never run the compiler
# over the shape the compiler's own source has — many modules, several
# directories, generics crossing a `use`, recursion that has to leave a module
# and come back, and a tree deep enough to matter. Nim keeps `tests/manyloc/`
# and Zig `test/standalone/` for exactly this rung.
#
# Every other program here is checked against its own functions or against a
# published answer. This one is checked against **itself**, twice over: the
# scripts under `scripts/` are run and their output compared, and the tests in
# each module assert the piece they own.

use lex/scan
use lex/token
use syn/cursor
use syn/expr as parse_expr
use run/eval
use run/expr
use run/value
use syn/parse
use syn/tree
use util/each

function main()
    given = args()

    if given.len() != 1
        print("usage: interpreter <script>")
        exit(2)
    source = read_file(given[0])

    if source.is_err()
        print("cannot read ", given[0])
        exit(2)
    nodes = parse.program(source.must())

    if nodes.is_err()
        print(complaint(nodes))
        exit(1)
    said = eval.run(nodes.must())

    if said.is_err()
        print(complaint_of_run(said))
        exit(1)
    f = said.must()

    for line in f.lines
        print(line)

    # THE SCRIPT'S OWN `exit` BECOMES THIS PROGRAM'S. A script that says
    # `exit 0` has asked to end, and the honest way to obey it is the
    # language's own `exit` — which is also why this program's
    # `main.expected` ends in `!exit: 0` rather than falling off the end of
    # `main`. Note what that costs: `exit` bypasses
    # `hero_runtime_check_leaks()` by design (`examples/README.md`), so this
    # program is not one of the corpus's leak witnesses, and `adventure/` is.
    if f.stopping
        exit(f.code)

# A parse refusal, as the one line a script author reads.
function complaint(said: tree.Tree?) -> str
    return match said
        .ok _  => "nothing was refused"
        .err e => "error[" + e.code + "]: " + e.msg

function complaint_of_run(said: value.Frame?) -> str
    return match said
        .ok _  => "nothing was refused"
        .err e => "error[" + e.code + "]: " + e.msg

test "the pieces are wired together"
    got = scan.scanned("print 1 + 2").must()
    assert got.len() == 6
    assert got[0] == .kw_print
    assert got[1] == .number(value: 1)
    assert token.shown(got[2]) == "+"
    assert each.counted(got, token.opens_a_value) == 2
    built: tree.Tree @ tree.empty()
    one = tree.added_expr(@built, .number(value: 1))
    two = tree.added_expr(@built, .number(value: 2))
    sum = tree.added_expr(@built, .binary(op: .add, left: one, right: two))
    assert tree.shown_expr(built, sum) == "(1 + 2)"
    walking: cursor.Cursor @ cursor.over(got)
    assert cursor.bump(@walking) == .kw_print
    assert cursor.here(walking) == .number(value: 1)

test "an expression is read into the tree the renderer describes"
    assert rendering("1 + 2 * 3") == "(1 + (2 * 3))"
    assert rendering("(1 + 2) * 3") == "((1 + 2) * 3)"
    assert rendering("-x + !ok") == "((-x) + (!ok))"
    assert rendering("f(1, g(2))") == "f(1, g(2))"

test "a program is a list of statements, in the order they were written"
    t = parse.program("let x = 1\nprint x\n").must()
    assert t.top.len() == 2
    assert t.stmts.len() == 2
    assert value.shown(.number(v: 3)) == "3"

test "a script runs and its output is what it printed"
    assert ran("print 1 + 2") == "3"
    assert ran("let x = 4\nprint x * x") == "16"

test "both modules named expr are in this file, and one had to be renamed"
    # `use syn/expr as parse_expr` above is the whole demonstration: a file may
    # not bind one name twice (spec § Files and layout), and this program has
    # two modules whose last path component is `expr` — the one that READS an
    # expression and the one that gives it a MEANING. `examples/pipeline/` is
    # the corpus's other program that cannot be written without `as`.
    #
    # The two are used side by side here: the parser builds `2 * 3`, the
    # evaluator's own arithmetic is asked for the same product, and they agree.
    assert rendering("2 * 3") == "(2 * 3)"
    assert value.shown(expr.combined(op: .multiply, a: .number(v: 2), b: .number(v: 3)).must()) == "6"
    assert ran("print 2 * 3") == "6"

test "deep nesting works, and the depth it works to is measured rather than hoped"
    # THE MILESTONE ASKED FOR 500 AND 500 DOES NOT WORK, so the number here is
    # 60 and the reason is written down instead of the wish.
    #
    # Measured 2026-09-03 on this Mac, one nesting depth per configuration,
    # this program:
    #
    #   --sanitize   120 works · 160 overflows (ASan says so, exit 134)
    #   -O0          190 works · 200 overflows — **exit 139, SILENTLY**
    #   -O2          340 works · 360 overflows (the runtime's guard names the
    #                function: `panic: stack exhausted in synexpr.grouped`)
    #
    # WHY SO SHALLOW, and this is measured too: `heroes build --emit-c` shows
    # **247 hoisted locals** in the prologue of `syn/expr.hero`'s `compared`
    # and 151 in `primary`. CLAUDE.md §7 puts every local in the prologue, so a
    # recursive function's frame is proportional to its whole BODY rather than
    # to what is live at any point — and one nesting level of this grammar goes
    # through seven of those functions plus `grouped`. The two `@` parameters
    # are copied in by value at every level as well (§4.8's copy-in/copy-out).
    #
    # 60 is half of the tightest measured limit, which is margin enough that
    # this case cannot become flaky on a machine with a smaller stack. It is
    # still a POSITIVE witness for the runtime's stack guard (panel 104): the
    # guard must not fire on legitimate depth, and here it does not.
    deep = "print " + repeat("(", 60) + "1" + repeat(")", 60)
    assert ran(deep) == "1"

    # And the tree really is that deep, so a parser that quietly flattened the
    # parentheses could not pass this.
    nodes = parse.program(deep).must()
    assert nodes.exprs.len() == 1

    # A hundred still works in every configuration, which says 60 is not
    # sitting on a cliff.
    hundred = "print " + repeat("(", 100) + "2" + repeat(")", 100)
    assert ran(hundred) == "2"

test "a script that recurses without an end is refused, and does not crash"
    # The other side of the same coin. `run/eval.hero`'s DEPTH stops this at
    # 200 nested calls with a message naming the function, rather than letting
    # it run the interpreter's own stack out.
    forever = "fn down(n)\n    return down(n + 1)\nend\nprint down(0)"
    assert refusal_code(forever) == "too_deep"

    # And a script that recurses deeply but finitely still works, up to the
    # guard: 20 nested calls, which is under `run/eval.hero`'s measured 24.
    counted = "fn down(n)\n    if n <= 0\n        return 0\n    end\n    return 1 + down(n - 1)\nend\nprint down(20)"
    assert ran(counted) == "20"

    # And 30, which is over it, is the guard's refusal rather than a crash.
    assert refusal_code("fn down(n)\n    if n <= 0\n        return 0\n    end\n    return 1 + down(n - 1)\nend\nprint down(30)") == "too_deep"

test "every way arithmetic can stop this language is a refusal, not an abort"
    # Each of these is Heroes itself aborting if `run/expr.hero` did not guard
    # it first (design.md §1.12). A script is input; input must not be able to
    # kill the program reading it.
    assert refusal_code("print 1 / 0") == "arithmetic"
    assert refusal_code("print 1 % 0") == "arithmetic"
    assert refusal_code("print 9223372036854775807 + 1") == "arithmetic"
    assert refusal_code("print -9223372036854775807 - 2") == "arithmetic"
    assert refusal_code("print 4611686018427387904 * 2") == "arithmetic"
    assert refusal_code("print 9223372036854775808") == "number_too_large"

    # The extremes that DO fit still work, which is what says the guards are
    # not simply refusing everything large.
    assert ran("print 9223372036854775807") == "9223372036854775807"
    assert ran("print 9223372036854775806 + 1") == "9223372036854775807"
    assert ran("print 4611686018427387903 * 2") == "9223372036854775806"
    assert ran("print -9223372036854775807 - 1") == "-9223372036854775808"

test "a script that says exit stops the run and carries its code"
    nodes = parse.program("print 1\nexit 3\nprint 2").must()
    f = eval.run(nodes).must()
    assert f.stopping
    assert f.code == 3

    # The statement after the `exit` did not run.
    assert f.lines.len() == 1
    assert f.lines[0] == "1"

# `main` above turns this into the language's own `exit(3)`.

test "the runtime refuses what it cannot mean, each with its own code"
    assert refusal_code("print missing") == "unknown_name"
    assert refusal_code("print nope(1)") == "unknown_name"
    assert refusal_code("print 1 + true") == "type"
    assert refusal_code("if 1\n    print 2\nend") == "type"
    assert refusal_code("fn f(a)\n    return a\nend\nprint f(1, 2)") == "arity"
    assert refusal_code("let x = 1\nprint x(2)") == "unknown_name"

test "the parser refuses what it cannot read, each with a message"
    assert refusal_code("let = 1") == "parse"
    assert refusal_code("print 1 +") == "parse"
    assert refusal_code("if true\n    print 1") == "parse"
    assert refusal_code("end") == "parse"
    assert refusal_code("print 1 2") == "parse"
    assert refusal_code("print 1 < 2 < 3") == "parse"
    assert refusal_code("fn f(a, a)\n    return a\nend") == "parse"

test "the strings a script can hold, including the ones with escapes"
    assert ran("print \"a\\tb\"") == "a\tb"
    assert ran("print \"one\" + \"two\"") == "onetwo"
    assert ran("print \"\"") == ""
    assert ran("print \"quote: \\\"\"") == "quote: \""

test "a comment may hold any text at all, which is where the first script died"
    # A non-ASCII byte in a comment aborted the scanner until it stopped
    # slicing one byte at a time (`lex/scan.hero`'s header). The em dash below
    # is the exact byte that found it.
    assert ran("print 1 # a note — with an em dash") == "1"
    assert ran("# accented: cafe\nprint 2") == "2"

test "short-circuit means the right side is never evaluated"
    # `1 / 0` on the right of a decided `&&` or `||` must not be reached — if
    # it were, these two would be refusals rather than answers.
    assert ran("print false && 1 / 0 == 0") == "false"
    assert ran("print true || 1 / 0 == 0") == "true"

    # And when the right side IS reached, it decides.
    assert ran("print true && false") == "false"
    assert refusal_code("print true && 1 / 0 == 0") == "arithmetic"

test "a function sees its parameters and nothing else"
    # The scope rule `run/eval.hero` states in one line, asserted: a script
    # function cannot see the caller's variables.
    assert refusal_code("let outer = 1\nfn peek()\n    return outer\nend\nprint peek()") == "unknown_name"

    # And the caller's variables survive the call unchanged.
    assert ran("let x = 1\nfn f(x)\n    return x + 1\nend\nprint f(10)\nprint x") == "11\n1"

# The code a run or a parse refused with — the shape every refusal test above
# uses.
function refusal_code(source: str) -> str
    nodes = parse.program(source)

    if nodes.is_err()
        return code_of_tree(nodes)

    return code_of_frame(eval.run(nodes.must()))

function code_of_tree(said: tree.Tree?) -> str
    return match said
        .ok _  => "nothing was refused"
        .err e => e.code

function code_of_frame(said: value.Frame?) -> str
    return match said
        .ok _  => "nothing was refused"
        .err e => e.code

# One script, run, with its output lines joined — the shape every runtime test
# in this file uses.
function ran(source: str) -> str
    nodes = parse.program(source).must()
    f = eval.run(nodes).must()
    return join(f.lines, "\n")

# One expression, parsed and written back out — the shape every parser test in
# this file uses, because it checks the TREE without naming an index.
function rendering(source: str) -> str
    tokens = scan.scanned(source).must()
    c: cursor.Cursor @ cursor.over(tokens)
    t: tree.Tree @ tree.empty()
    id = parse_expr.parsed(@c, @t).must()
    return tree.shown_expr(t, id)
