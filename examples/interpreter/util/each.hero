# Four generic walks over an array, declared here and instantiated from two
# other directories.
#
# Part of `examples/interpreter/` — the root `main.hero` carries the program's
# argument. **This module exists to be used from elsewhere**, and that is its
# point rather than a side effect: measured on 2026-09-03, generics were
# declared in three programs in `examples/` (`calculator` 4, `deck` 5,
# `gallery` 3) and **instantiated across a `use` by none of them**. A generic
# that only its own file calls has never been asked the question
# monomorphisation exists to answer — one template, two type arguments, two
# emitted functions, from two different modules.
#
# Here `syn/parse.hero` instantiates them at `token.Token` and `run/eval.hero`
# at `value.Value`, so every function below is emitted twice with different
# layouts, from callers that share nothing.
#
# WHAT IS NOT HERE, and why the list is four rather than seven: `map`, `filter`
# and `fold` are the spec's own (§ Built-ins, *written in Heroes*), so
# redeclaring them would measure the corpus's ability to shadow a built-in
# rather than its ability to carry a generic. These four are the ones the
# interpreter actually needs and the spec does not have.

# How many of `xs` satisfy `fits`.
function counted<A>(xs: [A], fits: (function(A) -> bool)) -> i64
    total: i64 @ 0

    for one in xs
        if fits(one)
            total @ total + 1

    return total

# The first of `xs` that satisfies `fits`, or `fallback` if none does.
#
# `fallback` and not a `A?`: a generic cannot say `ok(x)` for a type parameter
# without the caller knowing what failure means here, and every caller in this
# program has a natural nothing — the `.finish` token, the unit value. Handing
# it in keeps this function total.
function first_of<A>(xs: [A], fits: (function(A) -> bool), fallback: A) -> A
    for one in xs
        if fits(one)
            return one

    return fallback

# `xs`, each rendered by `shown`, joined by `sep`. The one place this program
# turns a list of anything into a line of text.
function joined<A>(xs: [A], shown: (function(A) -> str), sep: str) -> str
    pieces: [str] @ []

    for one in xs
        pieces @ pieces.push(shown(one))

    return join(pieces, sep)

# Whether every one of `xs` satisfies `fits` — `all` in the spec's list is the
# same idea, and this one is here because it takes the SAME shape as the three
# above, which is what makes the four readable as a family.
function every<A>(xs: [A], fits: (function(A) -> bool)) -> bool
    for one in xs
        if !fits(one)
            return false

    return true

# Two predicates over `i64`, used only by this module's own tests — the
# instantiations that matter are in `syn/` and `run/`.
function is_even(n: i64) -> bool
    return n % 2 == 0

function is_negative(n: i64) -> bool
    return n < 0

function as_text(n: i64) -> str
    return n.to_str()

test "counted counts, and counts nothing in nothing"
    assert counted([1, 2, 3, 4, 5], is_even) == 2
    assert counted([2, 4], is_even) == 2
    assert counted([1, 3], is_even) == 0
    empty: [i64] = []
    assert counted(empty, is_even) == 0

test "first_of finds the first and not merely one"
    assert first_of([1, 3, 4, 6], is_even, 0 - 1) == 4
    assert first_of([2, 4, 6], is_even, 0 - 1) == 2
    assert first_of([1, 3, 5], is_even, 0 - 1) == 0 - 1
    empty: [i64] = []
    assert first_of(empty, is_even, 99) == 99

test "joined renders and joins, and an empty list is an empty line"
    assert joined([1, 2, 3], as_text, ", ") == "1, 2, 3"
    assert joined([7], as_text, ", ") == "7"
    empty: [i64] = []
    assert joined(empty, as_text, ", ") == ""
    assert joined([1, 2], as_text, "") == "12"

test "every is true of nothing, which is the answer that surprises people"
    empty: [i64] = []
    assert every(empty, is_even)
    assert every([2, 4, 6], is_even)
    assert !every([2, 3, 6], is_even)
    assert !every([1], is_negative)

test "the same template at str, which is the second instantiation in this file"
    # The two that matter cross a `use` and live in `syn/` and `run/`. This one
    # is here so that the module's own tests also cover more than one type
    # argument — a template tested at one type is a template whose
    # substitution nobody has checked.
    words = ["alpha", "be", "gamma"]
    assert counted(words, is_short) == 1
    assert first_of(words, is_short, "none") == "be"
    assert joined(words, itself, "-") == "alpha-be-gamma"
    assert !every(words, is_short)

function is_short(word: str) -> bool
    return word.len() < 3

function itself(word: str) -> str
    return word
