# How big is a file, asked of the operating system — and the only program in
# this repository that writes `tag` or `partial`.
#
# Corpus and regression material (CLAUDE.md §9), and the gap it closes was
# measured rather than guessed. On 2026-09-02, over every `.hero` in
# `examples/`: `tag` appeared **zero** times and `partial` appeared **once, in
# a comment saying there was no `partial` anywhere**. Both are `spec:228-231`
# features with 52 uses in `selfhost/`'s own test fixtures and no program
# behind them.
#
# **The spec names this exact declaration as its illustration** — *"the same
# name unless the header writes it after the word struct, which `tag` gives:
# `record FileStat tag stat partial`"* — so the program that had to exist is
# the one the document already wrote down.
#
# WHY BOTH WORDS ARE NEEDED HERE, and neither is decoration:
#
# `tag`, because C's declaration is `struct stat`, and Heroes' record is
# `FileStat`. Without `tag stat` the emitter would look for a type named
# `FileStat` in `sys/stat.h` and clang would refuse the group.
#
# `partial`, because `struct stat`'s field list is NOT portable and this
# program must run on Darwin, Linux and Windows alike. Panel 097 measured the
# sharp end of that: `st_mode`'s declared width is refused on exactly one of
# {Darwin, glibc}. `partial` is the escape the spec provides — name the fields
# you need, keep C's size — and what it costs is stated in `spec:231`: a
# `partial` record may not be compared and may not be a map key, for it and
# for any value holding it. This program needs neither, which is why the trade
# is free here and would not be everywhere.
#
# The size stays C's rather than the field list's, which is the whole reason a
# one-field `partial` record can be passed to `stat()` at all.

extern "sys/stat.h"
    # `struct stat` under a Heroes name, naming one field of the many.
    #
    # `st_size` is the one field whose type is the same on every platform this
    # project builds for: `off_t` is 64-bit on Darwin and on 64-bit Linux, so
    # `i64` is the header's own width and not a widening.
    record FileStat tag stat partial
        st_size: i64

    # `stat` the function and `stat` the struct share a name in C, which is
    # legal there and is why the record above needed `tag` in the first place.
    function stat(path: cstr, @out: FileStat) -> i32

function size_of(path: str) -> i64?
    blank: FileStat @ FileStat(st_size: 0)
    code = stat(path.cstr(), @blank)

    if code != 0
        return fail("no_such_file", "the system could not stat `" + path + "`")
    return ok(blank.st_size)

function main()
    # The file this program is written in, whose size the program can check
    # against a second answer: `read_file` gives its bytes.
    mine = "examples/filestat/main.hero"
    told = size_of(mine)

    if told.is_err()
        print("could not read my own size")
        exit(1)
    text = read_file(mine)

    if text.is_err()
        print("could not read my own bytes")
        exit(1)

    # Two roads to one number, and the point of the program: the operating
    # system's answer and the runtime's answer are the same byte count.
    print(told.must() == len(text.must()))
    print(told.must() > 1000)

    # A miss, so the failure path is a program and not a promise.
    print(size_of("examples/filestat/no-such-file").is_err())

test "the system's size and the runtime's byte count agree"
    mine = "examples/filestat/main.hero"
    told = size_of(mine)
    assert !told.is_err()
    text = read_file(mine)
    assert !text.is_err()
    assert told.must() == len(text.must())

test "a path that is not there fails rather than aborting"
    missing = size_of("examples/filestat/no-such-file")
    assert missing.is_err()
    assert missing.default(0 - 1) == 0 - 1

test "a partial record keeps C's size, so the call writes past the field list"
    # The field list is one `i64`; `struct stat` is far larger. If the record
    # carried the field list's size instead of C's, `stat()` would write over
    # whatever followed it — this case passing at all is the size rule holding.
    blank: FileStat @ FileStat(st_size: 0)
    code = stat("examples/filestat/main.hero".cstr(), @blank)
    assert code == 0
    assert blank.st_size > 1000
