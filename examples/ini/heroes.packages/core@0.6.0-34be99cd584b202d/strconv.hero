# Numbers read from text, where a number too large for its type is a failure
# the caller answers and never an abort. The loops over the digits are the ones
# the programs of `examples/` wrote by hand (the admission notes at the end of
# this file).

use strconv/internal/float
use strconv/internal/shown

# What `atoi` fails with where a text is not a number at all. A number that is
# one but lies beyond an `i64` fails `does_not_fit`, the built-ins' own code.
constant NOT_A_NUMBER: str
    "not_a_number"

# The integer `s` writes in decimal, with an optional `+` or `-` before its
# digits: Go's `strconv.Atoi`. It fails `not_a_number` where `s` holds anything
# else, an empty text or a space included, and `does_not_fit` where the number
# lies beyond an `i64`.
function atoi(s: str) -> i64?
    at: i64 @= 0
    negative: bool @= false

    if s.len() > 0 && (s[0] == '-' || s[0] == '+')
        negative @ s[0] == '-'
        at @ 1

    if at == s.len()
        return fail(code: NOT_A_NUMBER, msg: shown.quoted(s) + " is not a number")

    # The digits are added below zero, so the lowest `i64`, which has no
    # positive twin, is read like any other number; and each step is asked
    # first whether it would leave the type, so no step can abort.
    lowest = -9223372036854775807 - 1
    total: i64 @= 0

    while at < s.len()
        c = s[at]

        if c < '0' || c > '9'
            return fail(code: NOT_A_NUMBER, msg: shown.quoted(s) + " is not a number")
        digit = to_i64(c - '0').must()

        if total < (lowest + digit) / 10
            return fail(code: "does_not_fit", msg: shown.quoted(s) + " does not fit an i64")
        total @ total * 10 - digit
        at @ at + 1

    if negative
        return ok(total)

    if total == lowest
        return fail(code: "does_not_fit", msg: shown.quoted(s) + " does not fit an i64")
    return ok(-total)

# The `f64` the whole of `s` writes, rounded once to the nearest, ties to even:
# Go's `strconv.ParseFloat(s, 64)`. It reads a decimal number, `-12.5e3`, a
# point with digits on either side or both, an exponent after `e`; a
# hexadecimal one, `0x1.8p3`, whose exponent after `p` is a power of two and
# must be written; underscores between digits, `1_000.5`; and `inf`,
# `infinity` and `nan` in any case, the first two after an optional sign. It
# fails `not_a_number` where `s` holds anything else, an empty text or a space
# included, and `does_not_fit` where the number lies past the largest `f64`;
# one nearer zero than the smallest is zero.
function parse_float(s: str) -> f64?
    return float.parsed(s)

## Tests

test "atoi: the empty text, a sign alone, and zero written three ways"
    assert atoi("").is_err()
    assert atoi("+").is_err()
    assert atoi("-").is_err()
    assert atoi("0").must() == 0
    assert atoi("-0").must() == 0
    assert atoi("007").must() == 7

test "atoi: a sign, and what is not a digit"
    assert atoi("42").must() == 42
    assert atoi("-42").must() == -42
    assert atoi("+42").must() == 42
    assert atoi(" 1").is_err()
    assert atoi("1 ").is_err()
    assert atoi("1_000").is_err()
    assert atoi("0x10").is_err()
    assert atoi("4é").is_err()

    match atoi("12x")
        .ok _  => assert false
        .err e => assert e.code == NOT_A_NUMBER && e.msg == "\"12x\" is not a number"

# The copies this package replaced multiplied before asking, and
# `number_of("99999999999999999999")` aborted, `integer overflow`.
test "atoi: the largest and the lowest i64, and one past each"
    assert atoi("9223372036854775807").must() == 9223372036854775807
    assert atoi("-9223372036854775808").must() == -9223372036854775807 - 1

    match atoi("9223372036854775808")
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

    match atoi("-9223372036854775809")
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

    match atoi("99999999999999999999")
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

test "parse_float: the empty text, a point alone, and zero written three ways"
    assert parse_float("").is_err()
    assert parse_float(".").is_err()
    assert parse_float("0").must() == 0.0
    assert parse_float("-0").must().to_str() == "-0.0"
    assert parse_float("0x0p0").must() == 0.0

# The copy this function replaced in `examples/spreadsheet` added each digit
# times a tenth it kept dividing, so `0.3` read as `0.30000000000000004`
# (defect 2546).
test "parse_float: a decimal number is rounded once, to the nearest f64"
    assert parse_float("0.3").must() == 0.3
    assert parse_float("1.15").must() == 1.15
    assert parse_float("0.7").must() == 0.7
    assert parse_float("-12.5e3").must() == -12500.0
    assert parse_float("1_000.5").must() == 1000.5
    assert parse_float("0x1.8p3").must() == 12.0
    assert parse_float("Infinity").must() == 1.0 / 0.0
    nan = parse_float("nan").must()
    assert nan != nan

test "parse_float: the largest f64, one past it, and what is no number"
    assert parse_float("1.7976931348623157e308").must().to_str() == "1.7976931348623157e+308"
    assert parse_float("1e-400").must() == 0.0

    match parse_float("1e309")
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

    match parse_float("1.2.3")
        .ok _  => assert false
        .err e => assert e.code == NOT_A_NUMBER && e.msg == "\"1.2.3\" is not a number"

## Admission
#
# `atoi` is here because the programs of `examples/` wrote it by hand, counted
# on 2026-11-06 by what the functions do: `number_of` in `assembler`, `rpn` and
# `todo`, and `int_of` in `query`, each a `str -> i64?` loop over the digits,
# each multiplying before asking whether the number still fits, so that
# `todo`'s `number_of("99999999999999999999")` aborted, `integer overflow`, run
# on 2026-11-06. Each program keeps a wrapper that gives the failure its own
# code and line.
#
# Not adopted: the `gallery`'s `number_of`, which teaches a fallible function
# by writing one; `markdown`'s, which reads a list marker's digits whose width
# it already knows; and `interpreter`'s, which reads a `Value`.
#
# `parse_float` is here because two programs read a decimal number by hand,
# counted on 2026-11-15 by what the functions do: `number` in
# `examples/spreadsheet/formula.hero`, whose running tenth read `0.3` as
# `0.30000000000000004`, `1.15` as `1.1500000000000001` and `0.7` as
# `0.7000000000000001` at exit 0 (defect 2546, run that day), and `float_of` in
# `examples/query/data/table.hero`, an `i64` of the digits divided by a power
# of ten, which refuses more than 18 digits and an exponent. The rounding is
# `encoding/json`'s since core 0.2.1, moved under this package with core 0.6.0
# so that both read a number one way. `query` keeps its own: its failures name
# the line of its table, and its numbers are a table's, never an exponent's.
