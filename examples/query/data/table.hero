# The table read back from its file: text in, typed rows out, and a named
# refusal for every way the text can be wrong (spec § Failure).
#
# Corpus material (CLAUDE.md §9), M-corpus-depth. **This module is the other
# half of `row.hero`, and the pair is the point**: the program writes five
# thousand rows and reads them back, so every conversion in the language is
# exercised in both directions on data the program made rather than on a
# fixture somebody typed. `examples/csv/` reads the hard shape — quotes,
# commas inside them, the doubled quote — and this one reads a shape it
# generated, so it can afford to be **strict**: a field that is not a number
# is a refusal naming the line and the column, not a zero.
#
# THE STRICTNESS IS THE FEATURE. A reader that answers `0` for a field it
# could not parse turns a broken file into a wrong answer, which is the one
# failure this whole corpus exists to catch. Every conversion here is a `T?`
# and every one of them is propagated with `?` (spec § Failure), so the
# first bad byte in a five-thousand-line file stops the read and says where.

use <core>/strconv
use <core>/strings

use data/row

constant ERR_HEADER: str
    "bad_header"

constant ERR_FIELDS: str
    "bad_field_count"

constant ERR_NUMBER: str
    "bad_number"

constant ERR_BOOL: str
    "bad_bool"

constant ERR_EMPTY: str
    "empty_table"

# How many fields a row has. Read off `row.HEADER` rather than written
# again, so the two cannot drift.
function columns() -> i64
    return split(text: row.HEADER, at: ',').len()

# Text split on one byte. Written here rather than imported because the
# language has no `split` built in (spec § Built-ins), and the shape a
# generated file needs is the simple one: no quoting, no escapes.
function split(text: str, at: u8) -> [str]
    out: [str] @= []
    start: i64 @= 0
    index: i64 @= 0

    while index < text.len()
        if text[index] == at
            out @ out.push(text.slice(from: start, to: index))
            start @ index + 1
        index @ index + 1

    out @ out.push(text.slice(from: start, to: text.len()))
    return out

# The lines of a text, with a trailing newline producing no empty last line.
function lines_of(text: str) -> [str]
    all_lines = split(text: text, at: '\n')

    if all_lines.len() > 0 && all_lines[all_lines.len() - 1] == ""
        return all_lines.slice(from: 0, to: all_lines.len() - 1)
    return all_lines

# `true` or `false`, and nothing else. A third spelling is a refusal rather
# than a guess, because guessing here is how a column silently becomes all
# false.
function bool_of(text: str, line: i64) -> bool?
    if text == "true"
        return ok(true)

    if text == "false"
        return ok(false)
    return fail(code: ERR_BOOL, msg: "line " + line.to_str() + ": `" + text + "` is neither `true` nor `false`")

# An `i64`, refusing what `to_i64` refuses and saying which line it was on.
# `to_i64` on a `str` does not exist in this language — a `str` has no
# conversion to a number (spec § Types) — so this walks the bytes, which is
# also where a leading `+`, a stray space or an empty field is caught.
function int_of(text: str, line: i64) -> i64?
    if text.len() == 0
        return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": a number field is empty")

    match strconv.atoi(text)
        .ok n  => return ok(n)
        .err e => return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": " + e.msg)

# An `f64`, read back from the text `to_str` wrote for it and rounded ONCE,
# to the nearest `f64`, by `strconv.parse_float` (Go's `ParseFloat`). Which
# is not a style but a repair, and the round trip is what forced it, twice.
#
# `to_str` writes the digits that make a float read back as the same value
# (spec § Built-ins): up to seventeen significant ones, `1835852425.7146974`,
# or an exponent, `1e-05`. One rounding from those digits lands on the value
# written, for every `f64`; two roundings may not, because two roundings do
# not compose into one.
#
# The first draft read the two halves separately and added them: `1` plus
# `64 / 100`, three roundings where the writer performed one. The generator
# makes this rate as `to_f64(164) / 100.0`, which is `1.64` exactly, and
# `1.0 + 0.64` is `1.6400000000000001`. Row 127 of the table found it —
# `back == made` failed on a value written and read by the same program.
#
# The second read every digit into one `i64` and divided once by the power
# of ten the point implies: exact while the digits fit the 53 bits an `f64`
# holds, which every rate the generator makes does, and two roundings past
# them, so `1835852425.7146973` read as `1835852425.7146971` where the
# nearest `f64` is `1835852425.7146974` (defect 2570). It also refused what
# `to_str` writes past eighteen digits, `0.012345678901234567`, and every
# exponent and `inf`, which the writer's own comment says this reader takes
# back.
function float_of(text: str, line: i64) -> f64?
    float_shape(text, line)?

    # `parse_float`'s message quotes the text, `"1e+309" lies past the
    # largest f64`, so the line is all this adds, as in `int_of`.
    match strconv.parse_float(text)
        .ok value => return ok(value)
        .err e    => return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": " + e.msg)

# Nothing, where `text` is written as `to_str` writes an `f64`, and else a
# refusal naming the line and what was found. **The shape is still the
# table's**, so `parse_float`'s wider reading does not leak into it: an
# optional `-`, digits, then optionally a point and digits, then optionally
# `e`, a sign and digits; or `inf`, `-inf` or `nan`. `1_000`, `0x1p3`, `.5`,
# `5.`, `+2` and `Infinity` are numbers to `parse_float` and refusals here,
# because the writer never makes them and a reader that guesses is how a
# broken file becomes a wrong answer. The exponent's count of digits is not
# held to the two C's `%g` writes on this Mac, since a C library may write
# three.
function float_shape(text: str, line: i64) -> ()?
    if text == "inf" || text == "-inf" || text == "nan"
        return ok()

    if text.len() == 0
        return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": a number field is empty")
    said = "line " + line.to_str() + ": `" + text + "` "
    at: i64 @= 0

    if text[0] == '-'
        at @ 1
    whole_end = digits_end(text, from: at)

    if whole_end == at
        return fail(code: ERR_NUMBER, msg: said + "is not a number: no digit opens it")
    at @ whole_end

    if at < text.len() && text[at] == '.'
        fraction_end = digits_end(text, from: at + 1)

        if fraction_end == at + 1
            return fail(code: ERR_NUMBER, msg: said + "ends its point with no digit after it")
        at @ fraction_end

    if at < text.len() && text[at] == 'e'
        if at + 1 == text.len() || text[at + 1] != '+' && text[at + 1] != '-'
            return fail(code: ERR_NUMBER, msg: said + "has no sign after its `e`")
        exponent_end = digits_end(text, from: at + 2)

        if exponent_end == at + 2
            return fail(code: ERR_NUMBER, msg: said + "has no digit in its exponent")
        at @ exponent_end

    # Every byte before `at` is ASCII, a sign, a digit, the point or the
    # exponent's, so both slices below cut between two characters.
    if at < text.len()
        return fail(
            code: ERR_NUMBER,
            msg: said + "is not a number: `" + text.slice(from: at, to: text.len()) + "` follows `" + text.slice(from: 0, to: at) + "`"
        )
    return ok()

# The first index at or after `from` that holds no decimal digit, or the
# text's length where digits run to its end.
function digits_end(text: str, from: i64) -> i64
    at: i64 @= from

    while at < text.len() && text[at] >= '0' && text[at] <= '9'
        at @ at + 1

    return at

# The whole table. The header is checked against the one this program
# writes, because a file whose columns moved is a file this reader would
# otherwise read in the wrong order and answer confidently about.
function read(text: str) -> [row.Row]?
    all_lines = lines_of(text)

    if all_lines.len() == 0
        return fail(code: ERR_EMPTY, msg: "the table is empty: not even a header")

    if all_lines[0] != row.HEADER
        return fail(
            code: ERR_HEADER,
            msg: "the header reads `" + all_lines[0] + "` and this program writes `" + row.HEADER + "`"
        )
    out: [row.Row] @= []
    number: i64 @= 1
    wanted = columns()

    for one in all_lines.slice(from: 1, to: all_lines.len())
        number @ number + 1
        fields = split(text: one, at: ',')

        if fields.len() != wanted
            return fail(
                code: ERR_FIELDS,
                msg: "line " + number.to_str() + ": " + fields.len().to_str() + " fields where the header has " + wanted.to_str()
            )
        out @ out.push(
            row.Row(id: int_of(fields[0], number)?, team: fields[1], name: fields[2], active: bool_of(fields[3], number)?, score: int_of(fields[4], number)?, rate: float_of(fields[5], number)?)
        )

    return ok(out)

test "the round trip is exact for every field, including the float"
    made = row.generated(50)
    back = read(row.written(made)).must()
    assert back.len() == made.len()
    assert back == made

test "a number that is not one stops the read and names its line"
    text = row.HEADER + "\n1,argo,p1,true,x,1.5\n"
    got = read(text)
    assert got.is_err()
    assert why(got).code == ERR_NUMBER
    assert strings.contains(s: why(got).msg, substr: "line 2")

test "a third spelling of a boolean is refused rather than guessed"
    text = row.HEADER + "\n1,argo,p1,yes,10,1.5\n"
    assert why(read(text)).code == ERR_BOOL

test "a header that moved is refused before a single row is read"
    text = "id,name,team,active,score,rate\n1,argo,p1,true,10,1.5\n"
    assert why(read(text)).code == ERR_HEADER

test "a short row is refused with both counts in the message"
    text = row.HEADER + "\n1,argo,p1,true,10\n"
    assert why(read(text)).code == ERR_FIELDS
    assert strings.contains(s: why(read(text)).msg, substr: "5 fields where the header has 6")

test "the pieces answer what they are asked, and refuse what they are not"
    assert int_of("0", 1).must() == 0
    assert int_of("-42", 1).must() == -42
    assert int_of("", 1).is_err()
    assert int_of("-", 1).is_err()
    assert int_of("1 ", 1).is_err()
    assert float_of("2", 1).must() == 2.0
    assert float_of("2.5", 1).must() == 2.5
    assert float_of("-0.25", 1).must() == -0.25
    assert float_of("2.", 1).is_err()
    assert float_of("2.5.5", 1).is_err()
    assert split(text: "a,b,,c", at: ',') == ["a", "b", "", "c"]
    assert lines_of("a\nb\n") == ["a", "b"]
    assert lines_of("a\nb") == ["a", "b"]

# The reader that divided one `i64` by a power of ten rounded twice once the
# digits passed 53 bits, and answered the `...971` below.
test "defect 2570: a decimal past 53 bits of digits is rounded once, to the nearest f64"
    assert float_of("1835852425.7146973", 1).must().to_str() == "1835852425.7146974"
    assert float_of("-1835852425.7146973", 1).must().to_str() == "-1835852425.7146974"
    assert float_of("123456789012345678", 1).must() == 123456789012345678.0
    text = row.HEADER + "\n1,argo,p1,true,10,1835852425.7146973\n"
    assert read(text).must()[0].rate.to_str() == "1835852425.7146974"

# Each text below is one `to_str` writes, and reading it gives the value whose
# text it is. Compared as text, because `to_str` reads back exact, so one text
# is one value, and the text tells `-0.0` from `0.0` and finds `nan`, which
# `==` cannot. More than eighteen digits, an exponent and `inf` were refused.
test "defect 2570: every text `to_str` writes reads back as the value it was written from"
    written = [
        "1835852425.7146974"
        "0.30000000000000004"
        "1.64"
        "0.012345678901234567"
        "0.00012345678901234567"
        "1e-05"
        "1e+21"
        "1.2345678901234568e+17"
        "5e-324"
        "2.2250738585072014e-308"
        "1.7976931348623157e+308"
        "-0.0"
        "inf"
        "-inf"
        "nan"
    ]

    for text in written
        assert float_of(text, 1).must().to_str() == text

    # And the values the other way, written by `to_str` and read through the
    # table, which is the route `main` takes. `nan` stays out of the table:
    # it equals nothing, so a table holding one never equals itself.
    values = [1835852425.7146974, 0.1 + 0.2, to_f64(164) / 100.0, 1.0 / 0.0, 0.0, -0.0]
    rows: [row.Row] @= []

    for v in values
        assert float_of(v.to_str(), 1).must().to_str() == v.to_str()
        rows @ rows.push(row.Row(id: rows.len() + 1, team: "argo", name: "p1", active: true, score: 0, rate: v))

    assert read(row.written(rows)).must() == rows
    assert float_of((0.0 / 0.0).to_str(), 1).must().to_str() == "nan"

# `parse_float` reads more than the table's writer writes; the reader keeps
# the table's shape, and each refusal names its line and what it found.
test "defect 2570: a text `to_str` never writes is refused, naming its line, though `parse_float` reads most of them"
    never = [
        "1_000"
        "0x1p3"
        ".5"
        "5."
        "+2"
        "Infinity"
        "INF"
        "1e5"
        "1E+05"
        "1e+"
        "1e+05x"
        " 1"
        "1 "
        "2.5.5"
        "-"
        "--1"
        ""
    ]

    for text in never
        match float_of(text, 7)
            .ok _  => assert false
            .err e => assert e.code == ERR_NUMBER && strings.contains(s: e.msg, substr: "line 7: ")

    match float_of("2.5.5", 7)
        .ok _  => assert false
        .err e => assert e.msg == "line 7: `2.5.5` is not a number: `.5` follows `2.5`"

    match float_of("5.", 7)
        .ok _  => assert false
        .err e => assert e.msg == "line 7: `5.` ends its point with no digit after it"

    match float_of("1e5", 7)
        .ok _  => assert false
        .err e => assert e.msg == "line 7: `1e5` has no sign after its `e`"

# A number past the largest `f64` has the table's shape and no value; it is
# refused by `parse_float`, never read as `inf`.
test "defect 2570: a number past the largest f64 is refused, naming its line"
    match float_of("1e+309", 3)
        .ok _  => assert false
        .err e => assert e.code == ERR_NUMBER && e.msg == "line 3: \"1e+309\" lies past the largest f64, about 1.8 times ten to the 308"

# The error of a failed read, for the tests above. `.must()` on the error
# side is not a thing, so this is the shape a test uses to look at one.
function why(got: [row.Row]?) -> Trouble
    return match got
        .ok _  => Trouble(code: "", msg: "")
        .err e => Trouble(code: e.code, msg: e.msg)

record Trouble
    code: str
    msg: str
