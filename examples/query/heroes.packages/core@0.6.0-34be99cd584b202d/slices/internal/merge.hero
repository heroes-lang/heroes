# The order a stable sort takes its elements in: a natural merge over their
# indices, so that no element moves until the order is known, and then each is
# copied once, by `slices.sort_by`.
#
# Three steps. `runs` cuts the indices into the runs the input already holds in
# order, a run the caller's order writes strictly backwards turned round;
# `paired` merges each two neighbouring runs into one, the left one winning a
# tie; `order` pairs them until one run is left. So an input already in order,
# or strictly in the reverse of it, costs one pass and no merge, and any other
# costs at most one pass per doubling of the runs' length.
#
# Measured on this Mac on 2026-11-14 before it was chosen: 100,000 records of
# an `i64` and a `str`, ordered by the `i64`, at `-O2`, in instructions retired
# beyond building and checking them. The top-down merge of the elements that
# `examples/query` wrote by hand, 1,033 million; a bottom-up merge of the
# elements, 513 million; a bottom-up merge of their indices, 269 million; this
# one, 278 million on random keys and 42 million on keys already in order or
# strictly reversed. The elements' merges pay a reference count on every move
# of a record holding text, which an index never does.
#
# Every loop below reads only an index it has bounded itself, and each pass
# takes every index exactly once, so a `less` that is no order at all, one
# answering true for everything or at random, still yields every element once,
# in whatever order the merges made, and nothing here aborts.

use slices/internal/sample

# The indices of an array, cut into runs: `sequence` holds every index once,
# and run `k` is `sequence` from `bounds[k]` up to `bounds[k + 1]`, so `bounds`
# opens with 0 and ends with the array's length, each run holding at least one.
record Runs
    sequence: [i64]
    bounds: [i64]

# The indices of `xs` in the order `less` writes, two that neither goes before
# kept in the order of their indices.
function order<A>(xs: [A], less: (function(a: A, b: A) -> bool)) -> [i64]
    held: Runs @= runs(xs, less)

    while held.bounds.len() > 2
        held @ paired(xs, less, held)

    return held.sequence

# The indices of `xs` cut into the runs it already holds in the order `less`
# writes. A run goes on while no element goes before the one ahead of it; where
# its second goes before its first, it goes on instead while each goes before
# the one ahead of it, and is turned round, which keeps the order of ties since
# such a run holds none. Each element but the first is asked once.
function runs<A>(xs: [A], less: (function(a: A, b: A) -> bool)) -> Runs
    count = xs.len()
    sequence: [i64] @= range(from: 0, to: count)
    bounds: [i64] @= [0]
    start: i64 @= 0

    while start < count
        stop: i64 @= start + 1

        if stop < count
            if less(a: xs[stop], b: xs[start])
                stop @ stop + 1

                while stop < count && less(a: xs[stop], b: xs[stop - 1])
                    stop @ stop + 1

                turned(@sequence, from: start, to: stop)
            else
                stop @ stop + 1

                while stop < count && !less(a: xs[stop], b: xs[stop - 1])
                    stop @ stop + 1

        bounds @ bounds.push(stop)
        start @ stop

    return Runs(sequence: sequence, bounds: bounds)

# Turns round the part of `xs` from `from` up to `to`.
function turned(@xs: [i64], from: i64, to: i64)
    low: i64 @= from
    high: i64 @= to - 1

    while low < high
        held = xs[low]
        xs[low] @ xs[high]
        xs[high] @ held
        low @ low + 1
        high @ high - 1

# The runs of `given` merged two by two, a run left alone at the end kept as it
# is. The left run's element is taken wherever the right run's does not go
# before it, which keeps a tie in the order of the indices; and two runs
# already in order, the right one's first not going before the left one's
# last, are copied with no other call of `less`.
function paired<A>(xs: [A], less: (function(a: A, b: A) -> bool), given: Runs) -> Runs
    sequence = given.sequence
    bounds = given.bounds
    merged: [i64] @= []
    joined: [i64] @= [0]
    pair: i64 @= 0

    while pair + 1 < bounds.len()
        left: i64 @= bounds[pair]
        middle = bounds[pair + 1]
        stop: i64 @= middle

        if pair + 2 < bounds.len()
            stop @ bounds[pair + 2]
        right: i64 @= middle

        if right < stop && less(a: xs[sequence[right]], b: xs[sequence[right - 1]])
            while left < middle && right < stop
                if less(a: xs[sequence[right]], b: xs[sequence[left]])
                    taken = sequence[right]
                    merged @ merged.push(taken)
                    right @ right + 1
                else
                    taken = sequence[left]
                    merged @ merged.push(taken)
                    left @ left + 1

        while left < middle
            taken = sequence[left]
            merged @ merged.push(taken)
            left @ left + 1

        while right < stop
            taken = sequence[right]
            merged @ merged.push(taken)
            right @ right + 1

        joined @ joined.push(stop)
        pair @ pair + 2

    return Runs(sequence: merged, bounds: joined)

## Tests

test "runs: none, one, and the input's own runs, a strictly falling one turned round"
    none: [i64] = []
    assert runs(none, sample.up) == Runs(sequence: [], bounds: [0])
    assert runs([7], sample.up) == Runs(sequence: [0], bounds: [0, 1])
    assert runs([1, 2, 2, 3], sample.up) == Runs(sequence: [0, 1, 2, 3], bounds: [0, 4])
    assert runs([3, 2, 1], sample.up) == Runs(sequence: [2, 1, 0], bounds: [0, 3])

    # A tie ends a falling run, so the two 2s are never turned past each other.
    assert runs([3, 2, 2, 1], sample.up) == Runs(sequence: [1, 0, 3, 2], bounds: [0, 2, 4])
    assert runs([1, 3, 2, 5, 4], sample.up) == Runs(sequence: [0, 1, 2, 3, 4], bounds: [0, 2, 4, 5])

test "turned: an empty part, one element, and a part inside the array"
    xs: [i64] @= [0, 1, 2, 3, 4]
    turned(@xs, from: 2, to: 2)
    assert xs == [0, 1, 2, 3, 4]
    turned(@xs, from: 4, to: 5)
    assert xs == [0, 1, 2, 3, 4]
    turned(@xs, from: 1, to: 4)
    assert xs == [0, 3, 2, 1, 4]
    turned(@xs, from: 0, to: 5)
    assert xs == [4, 1, 2, 3, 0]

test "paired: two runs merged with the left one first in a tie, and one left alone kept"
    xs = [1, 3, 1, 2, 0]
    given = Runs(sequence: [0, 1, 2, 3, 4], bounds: [0, 2, 4, 5])
    assert paired(xs, sample.up, given) == Runs(sequence: [0, 2, 3, 1, 4], bounds: [0, 4, 5])

    # Runs already in order are copied as they stand.
    assert paired([1, 2, 3], sample.up, Runs(sequence: [0, 1, 2], bounds: [0, 1, 3])) == Runs(sequence: [0, 1, 2], bounds: [0, 3])

test "order: every index once, ties in the order of the indices, for any order"
    none: [i64] = []
    assert order(none, sample.up).len() == 0
    assert order([5], sample.up) == [0]
    assert order([2, 1], sample.up) == [1, 0]
    assert order([1, 1], sample.up) == [0, 1]
    assert order([5, 1, 5, 1, 5], sample.up) == [1, 3, 0, 2, 4]
    assert order([4, 3, 2, 1, 0, -1, 9], sample.up) == [5, 4, 3, 2, 1, 0, 6]

    # An order that puts nothing before anything keeps the indices as they came.
    assert order([3, 1, 2], sample.never) == [0, 1, 2]
