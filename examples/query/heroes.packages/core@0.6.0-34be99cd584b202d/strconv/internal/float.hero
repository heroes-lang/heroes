# A float's text read as Go's `strconv.ParseFloat(s, 64)` reads it
# (`special`, `readFloat`, `underscoreOK` and `atofHex` in
# `src/strconv/atof.go` and `atoi.go`): an infinity or a NaN by name, or a
# decimal or hexadecimal number as Go's grammar for a floating-point literal
# writes one, underscores between digits included. A decimal number's digits
# are rounded once by `nearest.hero`; a hexadecimal one's bits by
# `hexadecimal` below, since its digits are already powers of two.
#
# One difference from Go, kept on purpose: Go stops counting an exponent's
# digits once it passes 10,000, so a text of more than ten thousand digits with
# an exponent past 100,000 is read by Go as an infinity it is not; here an
# exponent stops growing at 10 to the 15, more than the digits of any text that
# could bring a number written with it back near one (`nearest.hero`'s rule
# when it stood in `encoding/json`).
#
# The codes are written as literals, `not_a_number` and `does_not_fit`: the
# face uses this module, and a module the face uses cannot use the face.

use strconv/internal/nearest
use strconv/internal/scaling
use strconv/internal/shown

# The largest exponent counted; past it the number lies beyond any `f64` or
# rounds to zero whatever the digits before it.
constant EXPONENT_CAP: i64
    1_000_000_000_000_000

# A word read at the start of a text: its value and how many bytes it took,
# 0 where it is no infinity and no NaN.
record Special
    length: i64
    value: f64

# What the grammar read of a number: its sign; for a decimal one its digits
# before and after the point and its exponent; for a hexadecimal one its first
# 16 digits as a word, whether a digit past them was dropped that was not
# zero, and the power of two the word is scaled by; and how many bytes the
# number took, 0 where the text holds none.
record Grammar
    length: i64
    negative: bool
    hex: bool
    whole: str
    fraction: str
    exponent: i64
    mantissa: u64
    dropped: bool
    power: i64

# The `f64` the whole of `s` writes. It fails `not_a_number` where `s` is no
# number, a text with anything after the number included, and `does_not_fit`
# where the number lies past the largest `f64`; one nearer zero than the
# smallest is zero.
function parsed(s: str) -> f64?
    word = special(s)

    if word.length > 0
        if word.length == s.len()
            return ok(word.value)
        return fail(code: "not_a_number", msg: shown.quoted(s) + " is not a number")
    g = grammar(s)

    if g.length == 0 || g.length != s.len()
        return fail(code: "not_a_number", msg: shown.quoted(s) + " is not a number")

    magnitude = match magnitude_of(g)
        .ok x => x
        .err _ => return fail(
            code: "does_not_fit",
            msg: shown.quoted(s) + " lies past the largest f64, about 1.8 times ten to the 308"
        )

    if g.negative
        return ok(-magnitude)
    return ok(magnitude)

# The number `g` holds, without its sign.
function magnitude_of(g: Grammar) -> f64?
    if g.hex
        return hexadecimal(mantissa: g.mantissa, power: g.power, dropped: g.dropped)
    return nearest.value_of(whole: g.whole, fraction: g.fraction, exponent: g.exponent)

# An infinity or a NaN at the start of `s`, Go's `special`: `inf` or
# `infinity` in any case, after an optional sign, or `nan` in any case with no
# sign. A word that starts `infinity` and stops short of it takes its first
# three letters, so the text after them makes `parsed` refuse it.
function special(s: str) -> Special
    none = Special(length: 0, value: 0.0)

    if s.len() == 0
        return none
    first = s[0]
    signed = first == '+' || first == '-'

    if signed || lower(first) == 'i'
        at: i64 @= 0

        if signed
            at @ 1
        n: i64 @= same_letters(s: s, from: at, word: "infinity")

        if n > 3 && n < 8
            n @ 3

        if n != 3 && n != 8
            return none
        infinity = 1.0 / 0.0

        if first == '-'
            return Special(length: at + n, value: -infinity)
        return Special(length: at + n, value: infinity)

    if lower(first) == 'n' && same_letters(s: s, from: 0, word: "nan") == 3
        return Special(length: 3, value: 0.0 / 0.0)
    return none

# How many letters of `word` the text `s` holds from `from` on, case ignored.
function same_letters(s: str, from: i64, word: str) -> i64
    n: i64 @= 0

    while from + n < s.len() && n < word.len() && lower(s[from + n]) == word[n]
        n @ n + 1

    return n

# `b` in lower case where it is an ASCII capital letter.
function lower(b: u8) -> u8
    if b >= 'A' && b <= 'Z'
        return b + 32
    return b

# Whether `b` is a decimal digit.
function digit(b: u8) -> bool
    return b >= '0' && b <= '9'

# The value of the hexadecimal digit `b`, or 16 where it is none.
function hex_value(b: u8) -> u64
    if digit(b)
        return to_u64(b - '0').must()
    low = lower(b)

    if low >= 'a' && low <= 'f'
        return to_u64(low - 'a').must() + 10
    return 16

# The number at the start of `s` by Go's grammar, `readFloat`: an optional
# sign; `0x` and hexadecimal digits, or decimal digits; one optional point
# among them, at least one digit; then an exponent, `e` and decimal digits for
# a decimal number, `p` and decimal digits for a hexadecimal one, which must
# have it; an underscore anywhere among the digits, held to Go's places by
# `underscores_placed`. Its length is 0 where no number stands there.
function grammar(s: str) -> Grammar
    g: Grammar @= Grammar(
        length: 0,
        negative: false,
        hex: false,
        whole: "",
        fraction: "",
        exponent: 0,
        mantissa: 0,
        dropped: false,
        power: 0
    )
    at: i64 @= 0

    if s.len() > 0 && (s[0] == '+' || s[0] == '-')
        g.negative @ s[0] == '-'
        at @ 1

    if at + 2 < s.len() && s[at] == '0' && lower(s[at + 1]) == 'x'
        g.hex @ true
        at @ at + 2
    underscores: bool @= false
    point: bool @= false
    digits: bool @= false
    whole: str @= ""
    fraction: str @= ""

    # For a hexadecimal number, Go's `nd`, `ndMant` and `dp`: the digits read
    # after the leading zeros, those kept in the word, and where the point
    # stands among them, a leading zero after the point moving it left.
    count: i64 @= 0
    kept: i64 @= 0
    place: i64 @= 0
    reading: bool @= true

    while reading && at < s.len()
        c = s[at]

        if c == '_'
            underscores @ true
            at @ at + 1
        else if c == '.'
            if point
                reading @ false
            else
                point @ true
                place @ count
                at @ at + 1
        else if digit(c) || g.hex && hex_value(c) < 16
            digits @ true

            if g.hex
                if c == '0' && count == 0
                    place @ place - 1
                else
                    count @ count + 1

                    if kept < 16
                        g.mantissa @ g.mantissa * 16 + hex_value(c)
                        kept @ kept + 1
                    else if c != '0'
                        g.dropped @ true
            else if point
                fraction @ fraction + s.slice(from: at, to: at + 1)
            else
                whole @ whole + s.slice(from: at, to: at + 1)
            at @ at + 1
        else
            reading @ false

    if !digits
        return g

    if g.hex && !point
        place @ count

    letter: u8 = if g.hex
        'p'
    else
        'e'
    exponent: i64 @= 0

    if at < s.len() && lower(s[at]) == letter
        at @ at + 1

        if at < s.len() && (s[at] == '+' || s[at] == '-')
            at @ at + 1
        below = s[at - 1] == '-'

        if at >= s.len() || !digit(s[at])
            return g

        while at < s.len() && (digit(s[at]) || s[at] == '_')
            if s[at] == '_'
                underscores @ true
            else if exponent < EXPONENT_CAP
                exponent @ exponent * 10 + to_i64(s[at] - '0').must()
            at @ at + 1

        if below
            exponent @ 0 - exponent
    else if g.hex
        return g

    if underscores && !underscores_placed(s.slice(from: 0, to: at))
        return g
    g.whole @ whole
    g.fraction @ fraction
    g.exponent @ exponent

    if g.hex && g.mantissa != 0
        g.power @ place * 4 - kept * 4 + exponent
    g.length @ at
    return g

# Whether each underscore of the number `s` stands where Go allows one,
# `underscoreOK`: after a digit or the `0x`, and before a digit.
function underscores_placed(s: str) -> bool
    at: i64 @= 0

    if s.len() > 0 && (s[0] == '-' || s[0] == '+')
        at @ 1
    hex = at + 1 < s.len() && s[at] == '0' && lower(s[at + 1]) == 'x'

    # The last thing seen: `^` the start, `0` a digit or the prefix, `_` an
    # underscore, `!` anything else.
    saw: u8 @= '^'

    if hex
        at @ at + 2
        saw @ '0'

    while at < s.len()
        c = s[at]

        if digit(c) || hex && hex_value(c) < 16
            saw @ '0'
        else if c == '_'
            if saw != '0'
                return false
            saw @ '_'
        else if saw == '_'
            return false
        else
            saw @ '!'
        at @ at + 1

    return saw != '_'

# The `f64` nearest `mantissa × 2^power`, ties to even, `dropped` saying that
# a digit past the word was not zero, so the number is a little more: Go's
# `atofHex`. The word is moved until it holds the significand's 53 bits and
# two more, the last of them sticky; moved further right where the number
# would fall below the smallest normal `f64`; then rounded on those two bits.
# It fails `does_not_fit` where the number lies past the largest `f64`.
function hexadecimal(mantissa: u64, power: i64, dropped: bool) -> f64?
    two_to_52: u64 = 4_503_599_627_370_496
    m: u64 @= mantissa
    e: i64 @= power + 52

    while m != 0 && m < two_to_52 * 4
        m @ m * 2
        e @ e - 1

    if dropped && m % 2 == 0
        m @ m + 1

    while m >= two_to_52 * 8
        m @ sticky_half(m)
        e @ e + 1

    while m > 1 && e < -1024
        m @ sticky_half(m)
        e @ e + 1

    round: u64 @= m % 4
    m @ m / 4

    if m % 2 == 1 && round % 2 == 0
        round @ round + 1
    e @ e + 2

    if round == 3
        m @ m + 1

        if m == two_to_52 * 2
            m @ m / 2
            e @ e + 1

    if m < two_to_52
        # A subnormal or zero: its bits stand below the smallest normal's.
        return ok(to_f64(to_i64(m).must()) * scaling.two_to(-1074))

    if e > 1023
        return fail(code: "does_not_fit", msg: "the number lies past the largest f64, about 1.8 times ten to the 308")
    return ok(to_f64(to_i64(m).must()) * scaling.two_to(e - 52))

# `m` halved, its dropped bit kept in its last: Go's `m>>1 | m&1`.
function sticky_half(m: u64) -> u64
    half = m / 2

    if m % 2 == 1 && half % 2 == 0
        return half + 1
    return half

## Tests

test "float: an infinity and a NaN by name, as Go reads them"
    assert special("inf").length == 3 && special("Infinity").length == 8
    assert special("-INF").value < 0.0 && special("+inf").length == 4
    assert special("infin").length == 3
    assert special("nan").length == 3
    assert special("+nan").length == 0 && special("na").length == 0 && special("").length == 0
    assert special("12").length == 0
    assert same_letters(s: "INFx", from: 0, word: "infinity") == 3
    assert lower('Q') == 'q' && lower('q') == 'q' && lower('_') == '_'
    nan = parsed("NaN").must()
    assert nan != nan
    assert parsed("-Infinity").must() == -1.0 / 0.0
    assert parsed("infx").is_err() && parsed("infinit").is_err()

test "float: decimal numbers, their points, exponents and underscores"
    assert parsed("0.3").must() == 0.3
    assert parsed("1.15").must() == 1.15
    assert parsed("0.7").must() == 0.7
    assert parsed(".5").must() == 0.5 && parsed("5.").must() == 5.0
    assert parsed("+1e2").must() == 100.0 && parsed("1E-2").must() == 0.01
    assert parsed("1_000.5").must() == 1000.5
    assert parsed("1_23.50_0_0e+1_2").must() == 123500000000000.0
    assert parsed("-0").must().to_str() == "-0.0"
    assert digit('7') && !digit('a')

    for text in ["", ".", "e5", "1e", "1e+", "1.2.3", "_1", "1_", "1__0", "1_.5", "1._5", " 1", "1 ", "0x", "1f"]
        assert parsed(text).is_err()

    match parsed("12x")
        .ok _  => assert false
        .err e => assert e.code == "not_a_number" && e.msg == "\"12x\" is not a number"

test "float: the edges of an f64"
    assert parsed("1.7976931348623157e308").must().to_str() == "1.7976931348623157e+308"
    assert parsed("1e-400").must() == 0.0
    assert parsed("5e-324").must() > 0.0
    assert parsed("1e99999999999999999999").is_err()
    assert parsed("0e99999999999999999999").must() == 0.0

    match parsed("-1e400")
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit" && e.msg == "\"-1e400\" lies past the largest f64, about 1.8 times ten to the 308"

test "float: hexadecimal numbers, as Go reads them"
    assert parsed("0x1p0").must() == 1.0
    assert parsed("0x1.8p1").must() == 3.0
    assert parsed("0x0.8p1").must() == 1.0
    assert parsed("0x.08p0").must() == 0.03125
    assert parsed("-0x1p-2").must() == -0.25
    assert parsed("0X1P+3").must() == 8.0
    assert parsed("0x_1p0").must() == 1.0
    assert parsed("0x1fffffffffffffp0").must() == 9007199254740991.0
    assert parsed("0x1p-1074").must().to_str() == "5e-324"
    assert parsed("0x1p-1075").must() == 0.0
    assert parsed("0x1.fffffffffffffp1023").must().to_str() == "1.7976931348623157e+308"
    assert parsed("0x1p1024").is_err()
    assert parsed("0x1").is_err() && parsed("0x1.8").is_err() && parsed("0xp1").is_err()
    assert hex_value('a') == 10 && hex_value('F') == 15 && hex_value('g') == 16

test "float: the pieces, grammar, magnitude_of, underscores_placed, hexadecimal and sticky_half"
    g = grammar("-12.5e1x")
    assert g.length == 7 && g.negative && g.whole == "12" && g.fraction == "5" && g.exponent == 1
    assert magnitude_of(g).must() == 125.0
    assert grammar("x").length == 0
    assert underscores_placed("1_0") && !underscores_placed("1__0") && !underscores_placed("_1")
    assert underscores_placed("0x_f") && !underscores_placed("1_")
    assert hexadecimal(mantissa: 3, power: -1, dropped: false).must() == 1.5
    assert hexadecimal(mantissa: 0, power: 0, dropped: false).must() == 0.0
    assert sticky_half(5) == 3 && sticky_half(4) == 2 && sticky_half(6) == 3
