# §4.19's ladder, rung 5, both halves: the library is *asked for* rather than
# described, and a **struct crosses the boundary by value**.
#
#     heroes run examples/raylib/main.hero
#
# **This program is the acceptance test for two milestones.** `package "raylib"`
# is M-ffi-ladder's: raylib is the ladder's first third-party library, and the
# rung was unclimbable for a milestone because the language had no way to say
# where a header lives. `package` says it the same way everywhere — `-I`, `-L`
# and `-lraylib` here, `-lGL -lX11 -lm -ldl` on Linux, frameworks where
# frameworks are the answer — from one line with no platform name in it.
#
# The `record`s are M-struct-passing's, and until 2026-08-15 this file carried a
# paragraph explaining what it could NOT do: *"383 of raylib's 600 entry points
# pass or return a struct by value. `ClearBackground(Color)` does not compile,
# because Heroes has seven boundary types and none of them is a struct."* That
# paragraph is why the milestone existed, and it is deleted rather than softened.
#
# **The number, measured rather than claimed** (2026-08-15, re-taken three times
# in one day because the first two were wrong). raylib declares **600** entry
# points — `grep -c "^RLAPI"` and clang's own `FunctionDecl` count agree — and
# **349** of them pass or return a struct by value. **328 bind with every field
# named; 346 with `partial`.** The residue is **3**, and it is one struct:
# `VrStereoConfig`, whose eight members are all arrays, so it has no nameable
# field at all and `partial` gives `error[empty_record]` rather than a binding.
# `BeginVrStereoMode`, `LoadVrStereoConfig` and `UnloadVrStereoConfig` are the
# three, and naming them is the point — a refusal is held to the same standard as
# a feature (CLAUDE.md §12), so it says which programs it costs.
#
# **The layout is the header's, and that is the whole mechanism.** The emitter
# writes no `typedef` for `Color`, `Vector2` or `Rectangle`: it uses raylib's own
# types, so their size, their padding and — on arm64 — the register file each
# field travels in are C's answers and never this compiler's. What the compiler
# checks is each *field*, with a `_Generic` on the field's address: write
# `r: i32` where raylib says `unsigned char` and it is `error[ffi_field_type]`
# on that line, not a program that prints a plausible number. It did print one,
# measured, before the assertion existed.
#
# **`f32` is here because a struct made it unavoidable.** Two panels struck it,
# both correctly on their own evidence: a C `float` *parameter* bound `f64` is
# bit-exact, because clang converts against the real prototype. Inside a struct
# there is no prototype — a `Vector2` is two `float`s and nothing widens them —
# so the width that was a convenience at the signature is the layout at the
# field.
#
# **It opens no window**, for the reason this file learned the hard way: a corpus
# program runs unattended on a headless runner in three configurations, so the
# binding it exercises must need no screen. `ColorToInt`, `ColorAlpha`,
# `GetSplinePointLinear` and `CheckCollisionPointRec` are all pure computation
# over structs. The window *was* opened by hand from this same `package` line on
# 2026-08-14, and that is recorded in `docs/panel/050` rather than asserted by a
# test no runner can run.

extern "raylib.h" package "raylib"
    # raylib's own structs, at raylib's own widths. Four `unsigned char` for a
    # colour, two `float` for a point — a Heroes `i64` anywhere here would be a
    # different struct, and the field assertions are what say so.
    record Color
        r: u8
        g: u8
        b: u8
        a: u8
    record Vector2
        x: f32
        y: f32
    record Rectangle
        x: f32
        y: f32
        width: f32
        height: f32
    function SetRandomSeed(seed: u32)
    function GetRandomValue(min: i32, max: i32) -> i32
    # A struct in, an integer out.
    function ColorToInt(color: Color) -> i32
    # A struct in and a struct out, with an `f32` beside it.
    function ColorAlpha(color: Color, alpha: f32) -> Color
    # Two structs in, a struct **returned by value** — the direction that needs
    # the ABI to agree in both directions rather than one.
    function GetSplinePointLinear(startPos: Vector2, endPos: Vector2, t: f32) -> Vector2
    function CheckCollisionPointRec(point: Vector2, rec: Rectangle) -> bool
    # **`partial`, and this is what it is for.** raylib's `Model` holds a
    # `ModelSkeleton` and, after it, members this language cannot spell — a C array
    # member has no Heroes type. Naming what we touch and saying so is what makes
    # `Model` bindable at all; the price is `==`, `hash` and being a map key, none
    # of which a model wants. Without the word this is `ffi_incomplete_record`, and
    # with it the layout is still the header's, so `IsModelValid` reads the fields
    # C put where C put them.
    record Model partial
        transform: Matrix
        meshCount: i32
        materialCount: i32
        meshes: ptr
        materials: ptr
        meshMaterial: ptr
    record Matrix
        m0: f32
        m4: f32
        m8: f32
        m12: f32
        m1: f32
        m5: f32
        m9: f32
        m13: f32
        m2: f32
        m6: f32
        m10: f32
        m14: f32
        m3: f32
        m7: f32
        m11: f32
        m15: f32
    function IsModelValid(model: Model) -> bool

function main()
    SetRandomSeed(7)
    print("raylib answered ", GetRandomValue(min: 1, max: 6))

    red = Color(r: 255, g: 0, b: 0, a: 255)
    print(ColorToInt(red))
    print(ColorToInt(ColorAlpha(color: red, alpha: 0.5)))

    mid = GetSplinePointLinear(
        startPos: Vector2(x: 0.0, y: 0.0),
        endPos: Vector2(x: 10.0, y: 20.0),
        t: 0.5
    )
    print(mid.x, " ", mid.y)

    # A `partial` record, built and passed by value. An empty model is not valid,
    # and raylib says so from the fields this program named.
    identity = Matrix(
        m0: 1.0, m4: 0.0, m8: 0.0, m12: 0.0,
        m1: 0.0, m5: 1.0, m9: 0.0, m13: 0.0,
        m2: 0.0, m6: 0.0, m10: 1.0, m14: 0.0,
        m3: 0.0, m7: 0.0, m11: 0.0, m15: 1.0
    )
    empty = Model(
        transform: identity,
        meshCount: 0,
        materialCount: 0,
        meshes: nullptr,
        materials: nullptr,
        meshMaterial: nullptr
    )
    print(IsModelValid(model: empty))

    box = Rectangle(x: 0.0, y: 0.0, width: 10.0, height: 10.0)
    print(CheckCollisionPointRec(point: Vector2(x: 5.0, y: 5.0), rec: box))
    print(CheckCollisionPointRec(point: Vector2(x: 50.0, y: 5.0), rec: box))

test "the binding reaches raylib and comes back with a value in range"
    SetRandomSeed(1)
    roll = GetRandomValue(min: 1, max: 6)
    assert roll >= 1
    assert roll <= 6

test "a struct crosses by value, in both directions"
    # 0xFF0000FF as a signed 32-bit integer: opaque red, packed by raylib.
    assert ColorToInt(Color(r: 255, g: 0, b: 0, a: 255)) == -16776961
    # Halfway along a segment is the midpoint, and the fields come back exact
    # because 5.0 and 10.0 are representable in binary32.
    mid = GetSplinePointLinear(
        startPos: Vector2(x: 0.0, y: 0.0),
        endPos: Vector2(x: 10.0, y: 20.0),
        t: 0.5
    )
    assert mid.x == 5.0
    assert mid.y == 10.0
