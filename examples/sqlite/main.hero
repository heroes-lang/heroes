## The architecture test: SQLite, from Heroes, with no shim
#
# design.md §4.19 puts it plainly — *if this works without you having written a
# standard library, the architecture holds*. Nothing here is a wrapper this
# project wrote: `sqlite3.h` is the SDK's, clang reads it, and every signature
# below is checked against it.
#
# Four things had to exist before this file could:
#
#   - the group, so a signature has a header behind it;
#   - `<sqlite3.h>` in the generated C, so clang sees the real declarations;
#   - `nullptr` and `@`, so a C out-parameter has something to write into;
#   - `.cstr()`, so a Heroes string can be lent to C for the length of a call.
#
# What is NOT here is as much of the point: no marshalling, no glue layer, no
# generated binding file, and no `sqlite3.c` of our own.
#
# **This program builds with zero warnings, since panel 103 (2026-09-03).** It
# built with four, and they were true: `ptr` is C's `void *`, an out-parameter
# was `void **` where the header wants `sqlite3 **`, and C converts `void *` to
# any object pointer but never `void **`. Clang 22 made that an ERROR by
# default, so the same program was refused on Linux and accepted here. Now the
# emitter passes `(void *)&db` — the pointee of a `ptr` is the one thing the
# spec leaves to the header (spec § FFI) — while a NUMERIC `@` is checked by the
# compiler itself against the header's width and sign (`cli/pointee.hero`).

extern "sqlite3.h" link "sqlite3"
    # SQLite's own result codes, from SQLite's own header. A typo is
    # `error[unknown_name]` here, locally (panel 034 R4) — and since
    # M-header-constants a *wrong number* is impossible rather than unnoticed,
    # because there is no number: this file used to say `0` and `100`.
    constant SQLITE_OK: i64
    constant SQLITE_ROW: i64
    function sqlite3_open(filename: cstr, @out: ptr) -> i64
    function sqlite3_close(db: ptr) -> i64
    # The fifth argument is `char **errmsg`, and a non-NULL one makes SQLite
    # allocate a copy of the message that the CALLER must release with
    # `sqlite3_free`. This program does not want one, so it is a plain `ptr`
    # the caller passes `nullptr` for — SQLite's documented *do not allocate*
    # — rather than an `@` parameter whose value nothing reads. It was an `@`
    # until 2026-09-04, and `examples/ledger/` shipped the identical binding
    # and leaked 40 bytes per refused statement; this program never leaked
    # because no statement here is ever refused, which is a fact about its SQL
    # and not a defence. Repaired as the class rather than the case
    # (CLAUDE.md §1).
    function sqlite3_exec(db: ptr, sql: cstr, callback: ptr, context: ptr, error: ptr) -> i64
    function sqlite3_prepare_v2(db: ptr, sql: cstr, length: i32, @statement: ptr, @tail: ptr) -> i64
    function sqlite3_step(statement: ptr) -> i64
    function sqlite3_column_int(statement: ptr, column: i32) -> i64
    function sqlite3_finalize(statement: ptr) -> i64

# One statement, run for its effect. The three pointers SQLite's callback
# protocol takes are `nullptr`: §4.19 fixes a callback at `ptr` until the
# boundary has a C-width type vocabulary, and this program needs none.
function run(db: ptr, sql: str) -> i64
    return sqlite3_exec(db: db, sql: sql.cstr(), callback: nullptr, context: nullptr, error: nullptr)

# The first column of the first row, which is the whole of "read a result".
function first_int(db: ptr, sql: str) -> i64
    statement: ptr @ nullptr
    tail: ptr @ nullptr
    rc = sqlite3_prepare_v2(
        db: db,
        sql: sql.cstr(),
        length: -1,
        statement: @statement,
        tail: @tail
    )

    if rc != SQLITE_OK
        return 0 - 1
    value: i64 @ 0 - 1

    if sqlite3_step(statement) == SQLITE_ROW
        value @ sqlite3_column_int(statement, 0)
    _ = sqlite3_finalize(statement)
    return value

function main()
    db: ptr @ nullptr

    if sqlite3_open(":memory:".cstr(), @db) != SQLITE_OK
        print("cannot open the database")
        return
    _ = run(db, "create table note(body text)")
    _ = run(db, "insert into note(body) values ('hello'), ('from'), ('sqlite')")
    print("rows: ", first_int(db, "select count(*) from note"))
    print("longest: ", first_int(db, "select max(length(body)) from note"))
    _ = sqlite3_close(db)
