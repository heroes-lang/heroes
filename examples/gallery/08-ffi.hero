## Everything else comes from C
#
# There is no standard library, permanently. Maths beyond arithmetic,
# files, sockets, databases: they arrive through `extern`, and clang checks
# every declaration against the real header — a wrong type here is a
# compile error, not a crash at runtime.

extern sqrt = function: (x: f64) -> f64

extern pow = function: (base: f64, exponent: f64) -> f64

extern floor = function: (x: f64) -> f64

# `cstr` is a C string and `ptr` an opaque pointer. Neither is a `str`:
# the boundary is visible in the type.
extern puts = function: (s: cstr) -> int

# The hypotenuse, in the language's own arithmetic plus one C call.
hypotenuse = function: (a: f64, b: f64) -> f64
    return sqrt(a * a + b * b)

# No implicit conversions: an `int` becomes an `f64` because you said so.
diagonal_of = function: (width: int, height: int) -> f64
    return hypotenuse(to_f64(width), to_f64(height))

# `pow` is C's, `floor` is C's, and the rounding is yours.
rounded_power = function: (base: f64, exponent: f64) -> int
    return to_int(floor(pow(base, exponent)))

test "the C library does the maths"
    assert hypotenuse(3.0, 4.0) == 5.0
    assert rounded_power(2.0, 10.0) == 1024

main = function: ()
    print("the 16:9 diagonal of a 1920-wide screen: ", diagonal_of(1920, 1080))
