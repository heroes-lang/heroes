# A JSON reader: a document in, its shape and its canonical form out.
#
#     heroes run examples/json/main.hero -- examples/json/sample.json title
#
# The program's three edges are all here (design.md §1.11): it takes `args()`,
# it reads a file, and it ends with a status a shell can branch on, 0 for a
# document it read, 1 for one it could not, 2 for being asked wrong. That last
# distinction is the compiler's own contract (CLAUDE.md §10) applied to a
# program: *the input is bad* and *you called me wrong* are different answers.
#
# Reading and writing JSON is the package `encoding/json`'s, which `use
# <core>/encoding/json` reaches through the catalogue `heroes.toml` beside this
# file, written by `heroes add core`, and the tree that verb placed under
# `heroes.packages/`. What stays here is the program's own question of a
# document, how many values it holds and how deep they nest: a walk over
# `json.Value`, a variant recursive through both `[T]` and `{K: V}`, with an
# arm for each of its six kinds.

use <core>/encoding/json

function main()
    given = args()

    if given.len() == 0
        print("usage: json <file> [key]")
        exit(code: 2)

    match read_file(given[0])
        .err e   => stop("cannot read " + given[0] + ": " + e.code)
        .ok text => report(text, given)

# Every unhappy ending in one place, so the exit code is decided once.
function stop(message: str)
    print(message)
    exit(code: 1)

function report(text: str, given: [str])
    match json.parse(text)
        .err e  => stop(e.code + ": " + e.msg)
        .ok doc => describe(doc, given)

function describe(doc: json.Value, given: [str])
    print("values: ", size(doc))
    print("depth: ", depth(doc))
    print(shown(doc))

    if given.len() > 1
        match json.field(doc, given[1])
            .err e  => print("field ", given[1], ": ", e.code)
            .ok got => print("field ", given[1], ": ", shown(got))

# A value as JSON text. `parse` reads only what `render` writes back, so a
# value the document held always has a text, and the failure arm is the
# other answer `render` can give, for a value a program built.
function shown(v: json.Value) -> str
    return match json.render(v)
        .ok text => text
        .err e   => "(" + e.code + ")"

# How many values the tree holds, counting itself.
function size(v: json.Value) -> i64
    return match v
        .nothing | .boolean _ | .number _ | .string _ => 1
        .array a                                      => 1 + size_of_all(a.items)
        .object o                                     => 1 + size_of_all(values_of(o.fields))

function size_of_all(items: [json.Value]) -> i64
    total: i64 @= 0

    for item in items
        total @ total + size(item)

    return total

# How deep the tree goes: a value holding no other is 1.
function depth(v: json.Value) -> i64
    return match v
        .nothing | .boolean _ | .number _ | .string _ => 1
        .array a                                      => 1 + deepest(a.items)
        .object o                                     => 1 + deepest(values_of(o.fields))

function deepest(items: [json.Value]) -> i64
    best: i64 @= 0

    for item in items
        d = depth(item)

        if d > best
            best @ d

    return best

# An object's values, in the order its text wrote their names, which is the
# order `keys` gives.
function values_of(fields: {str: json.Value}) -> [json.Value]
    out: [json.Value] @= []

    for k in keys(fields)
        out @ out.push(fields[k].must())

    return out

test "the report reads its own sample"
    doc = json.parse(read_file("examples/json/sample.json").must()).must()
    assert shown(json.field(doc, "title").must()) == "\"Heroes\""
    assert size(doc) == 12
    assert depth(doc) == 3
    assert json.field(doc, "nothing_here").is_err()
    assert json.field(.number(value: 1.0), "title").is_err()

test "size and depth count the tree, a value that holds no other counting one"
    leaf: json.Value = .number(value: 1.0)
    nested: json.Value = .array(items: [leaf, .array(items: [leaf])])
    assert size(nested) == 4
    assert depth(nested) == 3
    assert depth(leaf) == 1
    assert size(.object(fields: {"a": leaf, "b": .nothing})) == 3
    assert shown(.number(value: 1.0 / 0.0)) == "(not_json)"

test "a document survives a round trip through its own canonical form"
    first = shown(json.parse(read_file("examples/json/sample.json").must()).must())
    assert shown(json.parse(first).must()) == first
