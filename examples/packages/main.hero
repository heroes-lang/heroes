# The core packages' own program. It reaches every package that no other
# package uses, so `heroes test main.hero` runs the tests of every module under
# `core/`, and it prints what a few calls answer, as `main.expected` says.
# A program that uses a package carries a copy of it under its own `core/`,
# byte for byte this tree's (`README.md` beside this file).

use core/strconv
use core/strings

function main()
    words = strings.fields("  the core packages  ")
    print(join(words, "-"))

    match strings.split_once(s: "key=value", sep: "=")
        .ok halves => print(halves.after)
        .err e     => print(e.msg)

    for line in strings.split_lines("one\r\ntwo\n")
        print(line)

    match strconv.atoi("-17")
        .ok n  => print(n)
        .err e => print(e.msg)

test "the driver reaches every package"
    assert strings.has_prefix(s: "core/strings", prefix: "core/")
    assert strconv.atoi("7").must() == 7
