# The core packages' own program. It reaches every package that no other
# package uses, so `heroes test main.hero` runs the tests of every module of
# `core`, and it prints what a few calls answer, as `main.expected` says. Like
# every program that uses them it names them `use <core>/strings`, through its
# catalogue `heroes.toml`, which `heroes add core` wrote from the index beside
# this folder, and builds from the tree that verb placed under
# `heroes.packages/` (`README.md` beside this file).

use <core>/encoding/json
use <core>/net/http
use <core>/strconv
use <core>/strings

function main()
    words = strings.fields("  the core packages  ")
    print(join(words, "-"))

    match strings.split_once(s: "key=value", sep: "=")
        .ok halves => print(halves.after)
        .err e     => print(e.msg)

    for line in strings.split_lines("one\r\ntwo\n")
        print(line)

    match strconv.atoi("-17")
        .ok n  => print(n)
        .err e => print(e.msg)

    match json.parse("{\"core\": [\"strings\", \"strconv\", \"encoding/json\"], \"since\": 0.1}")
        .ok doc => print(json.render(doc).default("no text"))
        .err e  => print(e.msg)

    # `net/http` reaches `net` and its floor `net/hero_net`, so this one
    # call is what makes `heroes test main.hero` run the tests of all three;
    # no socket is opened, the 404 being written for a request in hand.
    no_header: {str: str} = {}
    missing = http.Request(method: "GET", target: "/missing", header: no_header, body: "")
    print(http.not_found(missing).status)

test "the driver reaches every package"
    assert strings.has_prefix(s: "core/strings", prefix: "core/")
    assert strconv.atoi("7").must() == 7
    assert json.parse("[1]").must() == .array(items: [.number(value: 1.0)])
    assert http.MALFORMED == "malformed"
