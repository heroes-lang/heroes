# Paths read and written as text the way the system the program runs on
# writes them: Go's `path/filepath`. On Windows both `\` and `/` separate, a
# path may open with a volume, `C:` or `\\host\share`, and a cleaned path is
# written with `\`; on every other system `/` alone separates. The system is
# asked of the runtime, as the compiler asks it, and the text work stands in
# `path/filepath/internal/lexical`, which takes it as a value so both arms are
# tested on every machine. Nothing here touches the file system but `abs`,
# which reads the working folder (the admission notes at the end of this
# file).

use os
use path/filepath/internal/lexical

# What `rel` fails with where no path leads from one path to the other.
constant NOT_RELATIVE: str
    "not_relative"

# The shortest path naming what `path` names, by text alone: Go's
# `filepath.Clean`. Each run of separators becomes one, each `.` part goes,
# each `..` takes the part before it and a `..` at the root goes; an empty
# result is `.`.
function clean(path: str) -> str
    return lexical.clean(path: path, windows: lexical.on_windows())

# The parts written one after another with the system's separator and
# cleaned, an empty part passed over, "" where every part is empty: Go's
# `filepath.Join`, named otherwise since `join` is a built-in's name.
function joined(parts: [str]) -> str
    return lexical.joined(parts: parts, windows: lexical.on_windows())

# All of `path` but its last part, cleaned, a Windows volume kept: Go's
# `filepath.Dir`. A path with no separator answers `.`.
function dir(path: str) -> str
    return lexical.dir(path: path, windows: lexical.on_windows())

# Whether `path` is absolute: Go's `filepath.IsAbs`. On Windows a path must
# open with a volume and a separator after it, or with a share, so `\a` and
# `C:a` are not.
function is_abs(path: str) -> bool
    return lexical.is_abs(path: path, windows: lexical.on_windows())

# The path that names `target` read from `base`, by text alone, each cleaned
# first: Go's `filepath.Rel`. It fails `not_relative` where none does: one is
# absolute and the other not, their volumes differ, or the way would climb out
# of `base` through one of its `..`.
function rel(base: str, target: str) -> str?
    return lexical.rel(base: base, target: target, windows: lexical.on_windows())

# `path` made absolute, joined to the working folder where it is not and
# cleaned: Go's `filepath.Abs`. It fails as `os.getwd` fails, where the
# working folder cannot be read. On Windows a path opening with a separator
# alone takes the working folder's volume, as the system reads it.
function abs(path: str) -> str?
    if is_abs(path)
        return ok(clean(path))
    here = os.getwd()?

    if lexical.on_windows() && path.len() > 0 && lexical.separates(path[0], true)
        return ok(clean(here.slice(from: 0, to: lexical.volume_length(path: here, windows: true)) + path))
    return ok(joined([here, path]))

## Tests
#
# A face declares only what a program calls (`examples/packages/README.md`
# § 1.2), so its tests write each call out; both arms of every rule are
# `lexical`'s tests, these the arm of the machine that runs them.

test "clean, joined and dir: the system's own arm"
    if lexical.on_windows()
        assert clean("a/./b/..") == "a" && joined(["a", "b"]) == "a\\b" && dir("a\\b") == "a"
    else
        assert clean("a/./b/..") == "a" && clean("") == "." && clean("//a//b/") == "/a/b"
        assert joined(["a", "b"]) == "a/b" && joined(["", ""]) == "" && joined(["/x", "../y"]) == "/y"
        assert dir("/a/b") == "/a" && dir("a") == "." && dir("/") == "/"

test "is_abs and rel: the system's own arm"
    if lexical.on_windows()
        assert is_abs("C:\\a") && !is_abs("\\a")
        assert rel(base: "C:\\a", target: "C:\\a\\b").must() == "b"
    else
        assert is_abs("/a") && !is_abs("a") && !is_abs("")
        assert rel(base: "/a", target: "/a/b/c").must() == "b/c"
        assert rel(base: "/a/b", target: "/a/c").must() == "../c"

        match rel(base: "/a", target: "b")
            .ok _  => assert false
            .err e => assert e.code == NOT_RELATIVE && e.msg == "cannot make b relative to /a"

test "abs: an absolute path cleaned, a relative one under the working folder"
    here = os.getwd().must()
    assert abs(here).must() == here
    assert abs(".").must() == here
    assert abs("x").must() == joined([here, "x"])
    assert lexical.on_windows() || abs("/a/../b").must() == "/b"

## Admission
#
# These six are here because a named acceptance program calls them
# (`examples/packages/README.md` § 7.1): the repository's own hooks
# rewritten in Heroes (feature 2082, the author's answer `2a` of 2026-11-14,
# which names this package), whose Python joins, cleans and relates the paths
# of a written file, a command's `cd` and a tree's compiler on every run,
# counted at `adea08993` over the thirteen modules of `.claude/hooks/` but
# their tests: `os.path.join` 43 times, `basename` 15, `abspath` 8, `isabs` 7,
# `dirname` 6, `normpath` 6 and `relpath` 2 (`grep -o -E` of each name, then
# `sort | uniq -c`). Each lexical loop is past three lines, and the compiler's
# and the harness's hand copies of Go's `path` disagree with Go and with each
# other on `a/`, a name with no `/` and `""` (defect 2406).
#
# Not adopted: `base`, whose fifteen calls in the hooks read a command's first
# word, where Python answers "" for `git/` and Go answers `git`; the hooks
# keep Python's answer, the one their differential test holds (feature 2082,
# the author's answer `4a` of 2026-11-12). Go's `path` package, which is the
# same text work with `/` alone, waits for a program that needs it (decision
# 2404).
