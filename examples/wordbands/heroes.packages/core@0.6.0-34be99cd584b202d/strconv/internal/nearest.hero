# Decimal digits rounded once to the nearest `f64`, ties to even: what
# `parse_float` answers for a decimal number, and through it what
# `encoding/json` reads, so `0.3` is the `f64` that `0.3` is in a program and
# not `0.30000000000000004`. Three routes, the order Go's `strconv` takes them
# in (`atof64` in `src/internal/strconv/atof.go`, read 2026-11-10): one exact
# operation on two exact doubles where the number allows it; `scaling.hero`'s
# one product by a 128-bit power of ten for any number of at most 19 digits,
# and for a longer one where its first 19 digits and the same plus one round
# alike; and `decimal.hero`'s exact digits for what is left, a number of more
# than 19 digits within a hair of halfway between two `f64`s, whose cost
# grows with the distance from one (defect 2405).
#
# These functions stood in `encoding/json/internal/numeral.hero` until core
# 0.6.0, when `parse_float` needed the same rounding (defect 2546): a private
# module is named only by its own package, so the rounding moved here, under
# the package whose contract it is, and `encoding/json` reads its numbers
# through `strconv.parse_float`.
#
# Its one code is written as a literal, `does_not_fit`, the built-ins' own
# (spec § 11).

use strconv/internal/decimal
use strconv/internal/powers
use strconv/internal/scaling

# The powers of ten from 10^0 to 10^22, every one of which an `f64` holds
# exactly: 5 to the 22nd still fits the 53 bits of its significand.
constant EXACT: [f64]
    [
        1.0
        10.0
        100.0
        1000.0
        10000.0
        100000.0
        1000000.0
        10000000.0
        100000000.0
        1000000000.0
        10000000000.0
        100000000000.0
        1000000000000.0
        10000000000000.0
        100000000000000.0
        1000000000000000.0
        10000000000000000.0
        100000000000000000.0
        1000000000000000000.0
        10000000000000000000.0
        100000000000000000000.0
        1000000000000000000000.0
        10000000000000000000000.0
    ]

# The most digits an `i64` holding them converts to an `f64` exactly: 10 to
# the 15 is below 2 to the 53.
constant EXACT_DIGITS: i64
    15

# The `f64` nearest `<whole>.<fraction> × 10^exponent`, both texts of digits,
# ties to even. It fails `does_not_fit` where it lies past the largest `f64`.
function value_of(whole: str, fraction: str, exponent: i64) -> f64?
    digits = whole + fraction
    lead: i64 @= 0

    while lead < digits.len() && digits[lead] == '0'
        lead @ lead + 1

    end: i64 @= digits.len()

    while end > lead && digits[end - 1] == '0'
        end @ end - 1

    if end == lead
        return ok(0.0)
    return nearest(digits: digits.slice(from: lead, to: end), point: whole.len() - lead + exponent)

# The `f64` nearest `0.<digits> × 10^point`, the first digit not a zero and
# the last not a zero either, ties to even: by one multiplication or division
# of two exact `f64`s where the digits are at most `EXACT_DIGITS` and the power
# of ten one of `EXACT`, which then rounds once and correctly; by `scaling`'s
# product where the digits are at most `powers.DIGITS`; by `truncated` where
# they are more. It fails `does_not_fit` where the number lies past the
# largest `f64`.
function nearest(digits: str, point: i64) -> f64?
    if digits.len() > powers.DIGITS
        return truncated(digits: digits, point: point)
    whole = word_of(digits)
    power = point - digits.len()

    if digits.len() > EXACT_DIGITS || power < -22 || power > 22
        return scaling.nearest(d: whole, p: power)

    # Below 10 to the 15, so an `i64` holds it whole on its way to `to_f64`
    # (`scaling.packed` says why it takes that way).
    exact = to_f64(to_i64(whole).must())

    if power >= 0
        return ok(exact * EXACT[power])
    return ok(exact / EXACT[0 - power])

# The `f64` nearest `0.<digits> × 10^point`, `digits` more than `powers.DIGITS`
# of them, the last not a zero. The number lies above its first 19 digits,
# written `d`, and below `d` plus one, both at the same place, so where those
# two round to the same `f64` the number does too, rounding never going down
# as a number goes up; `scaling` asks both (Go's `atof64`). Otherwise the
# number lies within a hair of halfway between two `f64`s, and `decimal`'s
# exact digits round it.
function truncated(digits: str, point: i64) -> f64?
    head = word_of(digits.slice(from: 0, to: powers.DIGITS))
    p = point - powers.DIGITS
    below = scaling.nearest(d: head, p: p)

    if agree(below: below, above: one_more(head: head, p: p))
        return below
    return decimal.nearest(digits: digits, point: point)

# The `f64` nearest `(head + 1) × 10^p`, `head` of `powers.DIGITS` digits:
# written `1 × 10^(p + 19)` where `head` is all nines, so the scaling is asked
# only of a number of at most 19 digits, the ones `scaling.nearest` takes.
function one_more(head: u64, p: i64) -> f64?
    if head == powers.NINES
        return scaling.nearest(d: 1, p: p + powers.DIGITS)
    return scaling.nearest(d: head + 1, p: p)

# Whether two roundings are the same `f64`, or both past the largest.
function agree(below: f64?, above: f64?) -> bool
    return match below
        .ok x  => !above.is_err() && above.must() == x
        .err _ => above.is_err()

# The number the decimal digits `digits` write, at most `powers.DIGITS` of
# them, which a `u64` holds.
function word_of(digits: str) -> u64
    n: u64 @= 0
    i: i64 @= 0

    while i < digits.len()
        n @ n * 10 + to_u64(digits[i] - '0').must()
        i @ i + 1

    return n

## Tests

test "nearest: a number is rounded once, to the nearest f64"
    assert value_of(whole: "0", fraction: "3", exponent: 0).must() == 0.3
    assert value_of(whole: "00", fraction: "500", exponent: 1).must() == 5.0
    assert value_of(whole: "0", fraction: "000", exponent: 7).must() == 0.0
    assert value_of(whole: "9007199254740993", fraction: "", exponent: 0).must() == 9007199254740992.0
    assert value_of(whole: "9007199254740995", fraction: "", exponent: 0).must() == 9007199254740996.0
    assert value_of(whole: "1", fraction: "", exponent: 309).is_err()
    assert value_of(whole: "1", fraction: "", exponent: -400).must() == 0.0
    assert nearest(digits: "25", point: 1).must() == 2.5
    assert nearest(digits: "1", point: 23).must() == 10000000000000000000000.0
    assert nearest(digits: "1", point: 24).must().to_str() == "1e+23"

test "nearest: the pieces of the longer route, word_of, truncated, one_more and agree"
    assert word_of("9999999999999999999") == powers.NINES
    assert word_of("1") == 1 && word_of("1844674407370955161") == 1844674407370955161
    assert truncated(digits: "12345678901234567891", point: 20).must() == 12345678901234567000.0
    assert truncated(digits: "90071992547409930000000000001", point: 16).must() == 9007199254740994.0
    assert truncated(digits: "12345678901234567891", point: 400).is_err()
    assert one_more(head: powers.NINES, p: 0).must() == 10000000000000000000.0
    assert one_more(head: 1, p: 0).must() == 2.0
    assert agree(below: ok(1.0), above: ok(1.0)) && !agree(below: ok(1.0), above: ok(2.0))
    assert agree(below: fail(code: "does_not_fit", msg: "past"), above: fail(code: "does_not_fit", msg: "past"))
    assert !agree(below: ok(1.0), above: fail(code: "does_not_fit", msg: "past"))
    assert !agree(below: fail(code: "does_not_fit", msg: "past"), above: ok(1.0))

test "nearest: the exact powers are exact"
    power: f64 @= 1.0

    for p in EXACT
        assert p == power
        power @ power * 10.0

    assert EXACT.len() == 23
