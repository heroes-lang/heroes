# A maze solver: the shortest way from `S` to `E`, drawn.
#
#     heroes run examples/maze/main.hero -- examples/maze/sample.maze
#
#     main.hero    the program: arguments, the file, the drawing
#     solve.hero   breadth-first search, and the path it found
#     grid.hero    the rectangle, and a position as one number
#
# What it exercises: a `{i64: i64}` doing two jobs at once (the visited set and
# the way back), a queue that only grows because removing from the front copies
# the array, and `constant`s read **across a module** — `grid.WALL` — which is
# the shape that turned out not to compile when this program was written.

use grid
use solve

function main()
    given = args()
    if len(given) == 0
        print("usage: maze <file.maze>")
        exit(2)
    match read_file(given[0])
        .err e   => stop("cannot read " + given[0] + ": " + e.code)
        .ok text => lay_out(text)

function stop(message: str)
    print(message)
    exit(1)

function lay_out(text: str)
    match grid.read(text)
        .err e => stop(e.code + ": " + e.msg)
        .ok g  => walk(g)

function walk(g: grid.Grid)
    match solve.solve(g)
        .err e   => stop(e.code + ": " + e.msg)
        .ok path => show(g, path)

function show(g: grid.Grid, path: [i64])
    for line in drawn(g, path)
        print(line)
    print("steps: ", solve.steps(path))

# The maze with the path marked. `S` and `E` keep their own letters — a drawing
# that overwrote them would be a drawing you cannot check against the file.
function drawn(g: grid.Grid, path: [i64]) -> [str]
    on: {i64: bool} @ {}
    for index in path
        on[index] @ true
    out: [str] @ []
    for row in range(from: 0, to: g.height)
        pieces: [str] @ []
        for column in range(from: 0, to: g.width)
            index = grid.index_of(g, row: row, column: column)
            here = grid.at(g, index)
            if here == grid.WALL || here == grid.START || here == grid.GOAL
                pieces @ pieces.push(grid.one_char(here))
            else if !on[index].is_err()
                pieces @ pieces.push("*")
            else
                pieces @ pieces.push(".")
        out @ out.push(join(pieces, ""))
    return out

test "the sample has one shortest way, and the drawing is on it"
    g = grid.read(read_file("examples/maze/sample.maze").must()).must()
    path = solve.solve(g).must()
    assert solve.steps(path) == 25
    assert solve.is_walkable(g, path)
    picture = drawn(g, path)
    assert picture.len() == g.height
    assert picture[0] == "S.#*******"

test "the drawing marks exactly the path, and never the two letters"
    g = grid.read("S..\n.#.\n..E\n").must()
    path = solve.solve(g).must()
    assert drawn(g, path) == ["S..", "*#.", "**E"]
