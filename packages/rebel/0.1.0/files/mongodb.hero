            _ = insert_one(
                @c,
                database: "rebel_examples",
                collection: "indexed_listed",
                doc: bson.Document(fields: [])
            ).must()
            assert list_indexes(@c, database: "rebel_examples", collection: "indexed_listed").must().len() >= 1
            close(@c).must()

# An index removed.
test "drop_index: an index removed by its name"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            _ = create_index(
                @c,
                database: "rebel_examples",
                collection: "indexed_dropped",
                model: IndexModel(keys: bson.parse_json("{\"c\": 1}").must(), options: bson.Document(fields: []))
            ).must()
            drop_index(@c, database: "rebel_examples", collection: "indexed_dropped", name: "c_1").must()
            close(@c).must()

# Every index of a collection removed.
test "drop_indexes: every index but _id_ removed"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            _ = insert_one(
                @c,
                database: "rebel_examples",
                collection: "indexed_all_dropped",
                doc: bson.Document(fields: [])
            ).must()
            drop_indexes(@c, database: "rebel_examples", collection: "indexed_all_dropped").must()
            close(@c).must()

# The options of a stream that carries updated documents whole.
test "watch_options: the full document of each update"
    opts @= watch_options()
    opts.full_document @ "updateLookup"
    assert opts.max_await_ms == 0

# A change stream opened, a change made, and the change read.
test "watch: the next change of a collection"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()

            if server_of(c).replica_set != ""
                stream @= watch(
                    @c,
                    database: "rebel_examples",
                    collection: "events",
                    pipeline: [],
                    opts: watch_options()
                ).must()
                _ = insert_one(
                    @c,
                    database: "rebel_examples",
                    collection: "events",
                    doc: bson.parse_json("{\"kind\": \"signup\"}").must()
                ).must()
                change = next_document(@c, @stream).must()
                assert bson.member(change, name: "operationType").must() == .text(v: "insert")
                close_cursor(@c, @stream).must()
            close(@c).must()

# The token to resume a stream after its last change.
test "resume_token_of: where a stream stood"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()

            if server_of(c).replica_set != ""
                stream @= watch(
                    @c,
                    database: "rebel_examples",
                    collection: "events",
                    pipeline: [],
                    opts: watch_options()
                ).must()
                _ = insert_one(
                    @c,
                    database: "rebel_examples",
                    collection: "events",
                    doc: bson.Document(fields: [])
                ).must()
                _ = next_document(@c, @stream).must()
                assert resume_token_of(stream).must().fields.len() > 0
                close_cursor(@c, @stream).must()
            close(@c).must()

# The options of a transaction.
test "transaction_options: a snapshot read and a majority commit"
    opts @= transaction_options()
    opts.read_concern @ "snapshot"
    opts.write_concern.w @ "majority"
    assert opts.write_concern.w == "majority"

# A transaction begun, written in, and committed.
test "start_transaction: two writes made visible together"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()

            if server_of(c).replica_set != ""
                _ = insert_one(
                    @c,
                    database: "rebel_examples_txn",
                    collection: "accounts",
                    doc: bson.parse_json("{\"_id\": \"x\", \"balance\": 0}").must()
                ).is_err()
                start_transaction(@c, opts: transaction_options()).must()
                _ = update_one(
                    @c,
                    database: "rebel_examples_txn",
                    collection: "accounts",
                    query: bson.parse_json("{\"_id\": \"x\"}").must(),
                    update: .document(doc: bson.parse_json("{\"$inc\": {\"balance\": 5}}").must()),
                    opts: write_options()
                ).must()
                commit_transaction(@c).must()
            close(@c).must()

# A transaction committed.
test "commit_transaction: an insert made visible"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()

            if server_of(c).replica_set != ""
                start_transaction(@c, opts: transaction_options()).must()
                _ = insert_one(
                    @c,
                    database: "rebel_examples_txn",
                    collection: "ledger",
                    doc: bson.parse_json("{\"amount\": 1}").must()
                ).must()
                commit_transaction(@c).must()
                assert !is_in_transaction(c)
            close(@c).must()

# A transaction aborted: none of its writes stands.
test "abort_transaction: an insert undone"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()

            if server_of(c).replica_set != ""
                start_transaction(@c, opts: transaction_options()).must()
                _ = insert_one(
                    @c,
                    database: "rebel_examples_txn",
                    collection: "ledger",
                    doc: bson.parse_json("{\"amount\": -1}").must()
                ).must()
                abort_transaction(@c).must()
            close(@c).must()

# Whether a transaction is in progress.
test "is_in_transaction: before and inside a transaction"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            assert !is_in_transaction(c)
            close(@c).must()

# The id of the client's logical session.
test "session_id_of: the session's UUID"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            assert bson.has_member(session_id_of(c), name: "id")
            close(@c).must()

# The server's own code of a failure.
test "server_code_of: a duplicate key's code"
    assert server_code_of("[11000 DuplicateKey] E11000 duplicate key error").must() == 11000

# The labels of a failure.
test "labels_of: a transient error's labels"
    assert labels_of("[251 NoSuchTransaction; TransientTransactionError] none") == ["TransientTransactionError"]

# Whether a failure says the whole transaction may be run again.
test "has_label: whether a transaction may be run again"
    assert has_label(
        message: "[112 WriteConflict; TransientTransactionError] conflict",
        label: LABEL_TRANSIENT_TRANSACTION_ERROR
    )
