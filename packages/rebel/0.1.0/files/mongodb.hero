# A cursor read to its end, one document at a time.
test "next_document: the documents of a cursor until its end"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            cursor @= find_many(
                @c,
                database: "rebel_examples",
                collection: "numbers",
                query: bson.Document(fields: []),
                opts: find_options()
            ).must()
            seen: i64 @= 0

            while true
                match next_document(@c, @cursor)
                    .ok _ => seen @ seen + 1
                    .err e =>
                        assert e.code == NOT_FOUND
                        break

            assert seen >= 0
            close(@c).must()

