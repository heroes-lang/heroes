# Several writes of several kinds sent together.
test "bulk_write: an insert, an update and a delete in order"
    match os.env("REBEL_MONGODB_URL")
        .err _ => skip_test(reason: "REBEL_MONGODB_URL names no server")
        .ok url =>
            c @= connect(parse_url(url).must()).must()
            models: [WriteModel] = [
                .insert_one(doc: bson.parse_json("{\"sku\": \"a\", \"stock\": 1}").must())
                .update_one(query: bson.parse_json("{\"sku\": \"a\"}").must(), update: .document(doc: bson.parse_json("{\"$inc\": {\"stock\": 4}}").must()), upsert: false)
                .delete_one(query: bson.parse_json("{\"sku\": \"a\"}").must())
            ]
            r = bulk_write(@c, database: "rebel_examples", collection: "items", models: models, ordered: true).must()
            assert r.inserted == 1 && r.matched == 1 && r.deleted == 1
            close(@c).must()

