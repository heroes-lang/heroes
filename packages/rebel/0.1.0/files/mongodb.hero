            ).is_err()
            r = update_one(
                @c,
                database: "rebel_examples",
                collection: "counters",
                query: bson.parse_json("{\"_id\": \"visits\"}").must(),
                update: .document(doc: bson.parse_json("{\"$inc\": {\"n\": 1}}").must()),
                opts: write_options()
            ).must()
            assert r.matched == 1
            close(@c).must()

