# A small encoding's parts, for the face's examples and tests: the 256
# bytes, then twelve merged tokens, a pattern of tiktoken's shape and one
# special token. tiktoken 0.14.0, given the same parts as
# `tiktoken.Encoding`, answers what the tests that use it assert.

# The pattern: a word, up to three digits, or a run of other characters, each
# with the space before it; white space before something else, its last
# character given back; and white space.
constant PATTERN: str
    " ?\\p{L}+| ?\\p{N}{1,3}|\\s+(?!\\S)|\\s+| ?[^\\s\\p{L}\\p{N}]+"

# The ordinary tokens: the 256 bytes, ranks 0 to 255, then "he", "ll", "lo",
# "hel", "hello", " w", "or", " wor", " world", "ld", the first two bytes of
# "€" and "€", ranks 256 to 267.
function ranks() -> [[u8]]
    out: [[u8]] @= []
    b: i64 @= 0

    while b < 256
        out @ out.push([to_u8(b).must()])
        b @ b + 1

    for word in ["he", "ll", "lo", "hel", "hello", " w", "or", " wor", " world", "ld"]
        one: [u8] @= []

        for c in word.chars()
            one @ one.push(c[0])

        out @ out.push(one)

    out @ out.push([0xe2, 0x82])
    out @ out.push([0xe2, 0x82, 0xac])
    return out

# The special tokens: `<|endoftext|>`, numbered 300.
function specials() -> {str: i64}
    return {"<|endoftext|>": 300}
