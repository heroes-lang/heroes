# The proxy a request goes through: chosen for a target as the variables
# `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` say where the program asks them,
# read from the URL that names it (`http://` and the SOCKS schemes), and the
# hosts it is never used for. `dialing` makes the connection through it.

use bytes
use http/internal/socks
use http/internal/syntax
use http/internal/wire
use net
use os
use strings
use url

# Where a proxy is reached and who the program is to it.
record Place
    # Its scheme, in lower case: `http`, `socks4`, `socks4a`, `socks5` or
    # `socks5h`.
    scheme: str
    # Its host: a name, or an address without brackets.
    host: str
    # Its port, 1 to 65535; 80 where its URL writes none.
    port: i64
    # The user and the password it asks for, unescaped; both "" for none.
    user: str
    # The password.
    password: str

# The code of a proxy scheme not spoken here.
constant UNSUPPORTED: str
    "unsupported"

# The variables of the environment a proxy is read from, the lower case one
# first, as curl and Python read them; `HTTP_PROXY` in capitals is not read
# where `REQUEST_METHOD` is set, since a CGI program's variables then hold
# the request's `Proxy` field (httpoxy).
function env_of(name: str) -> str
    low = os.env(strings.to_lower_ascii(name)).default("")

    if low != ""
        return low

    if name == "HTTP_PROXY" && os.env("REQUEST_METHOD").default("") != ""
        return ""
    return os.env(name).default("")

# The entries of a `NO_PROXY` value: parted by commas, white space around
# each taken off, the empty ones left out.
function bypass_of(value: str) -> [str]
    out: [str] @= []

    for one in strings.split(s: value, sep: ",")
        entry = strings.trim(one)

        if entry != ""
            out @ out.push(entry)

    return out

# Where the proxy `proxy` is reached: its scheme, `http://` or a SOCKS one
# (`socks4`, `socks4a`, `socks5`, `socks5h`: the `h` and the `a` send the
# target's name and leave its resolving to the proxy), the user and the
# password, the host and the port; a proxy written with no scheme is read as
# `http://`, and its port is 80 for an HTTP proxy and 1080 for a SOCKS one.
# Fails `invalid` where it does not read or names no host, and
# `unsupported` for a proxy of another scheme, which is not spoken here.
function place_of(proxy: str) -> Place?
    written = if strings.contains(s: proxy, substr: "://")
        proxy
    else
        "http://" + proxy
    u = url.parse(written)?
    scheme = strings.to_lower_ascii(u.scheme)
    socks_scheme = !socks.dialect_of(scheme).is_err()

    if scheme != "http" && !socks_scheme
        return fail(
            code: UNSUPPORTED,
            msg: f"the proxy {syntax.shown(url.redacted(u))} is not http:// or socks4://, socks4a://, socks5:// or socks5h://: only those are spoken here"
        )

    if u.host == ""
        return fail(code: syntax.INVALID, msg: f"the proxy {syntax.shown(url.redacted(u))} names no host")
    port: i64 @= 80

    if socks_scheme
        port @ 1080

    if u.port != ""
        port @ syntax.decimal(s: u.port, what: "reading the proxy's port")?

        if port < 1 || port > 65_535
            return fail(code: syntax.INVALID, msg: f"the proxy's port {u.port} is not 1 to 65535")
    return ok(Place(scheme: scheme, host: u.host, port: port, user: u.user, password: u.password))

# Whether a request to `host` at `port` goes directly rather than through a
# proxy, by `bypass`, as Go's `NO_PROXY` reads it: `*` for every host; a name
# matching itself and every name under it, one that begins with `.` the
# names under it alone; an address, or a network such as `10.0.0.0/8`; any
# of them followed by `:port`, then matching that port alone; a pattern with
# a `*` for any run of bytes (`*.corp.example`, `192.168.*`); `<local>` for
# every name written with no dot, as Windows' settings write it. `localhost`
# and the loopback addresses always go directly, as Go sends them.
function is_bypassed(bypass: [str], host: str, port: i64) -> bool
    name = strings.to_lower_ascii(host)

    if name == "localhost" || strings.has_suffix(s: name, suffix: ".localhost")
        return true
    address = net.parse_host(name)

    match address
        .ok a =>
            if net.is_loopback(a)
                return true
        .err _ => _ = 0

    for raw in bypass
        entry @= strings.to_lower_ascii(raw)

        if entry == "*"
            return true

        if entry == "<local>"
            if !strings.contains(s: name, substr: ".") && address.is_err()
                return true
            continue
        wanted_port: i64 @= 0
        named: net.Address? = net.parse_address_port(entry)

        match named
            .ok both => wanted_port @ both.port
            .err _ =>
                match strings.split_once_last(s: entry, sep: ":")
                    .ok halves =>
                        if !strings.contains(s: halves.before, substr: ":") && halves.after != ""
                            match syntax.decimal(s: halves.after, what: "a NO_PROXY port")
                                .ok n =>
                                    entry @ halves.before
                                    wanted_port @ n
                                .err _ => _ = 0
                    .err _ => _ = 0

        if wanted_port == 0 || wanted_port == port
            if strings.contains(s: entry, substr: "*") && glob_matches(pattern: entry, text: name)
                return true

            if is_same_address(entry: host_of(named), host: address) || is_same_address(entry: net.parse_host(entry), host: address)
                return true

            if strings.contains(s: entry, substr: "/")
                match net.parse_network(entry)
                    .ok network =>
                        match address
                            .ok a =>
                                if net.contains(network, a)
                                    return true
                            .err _ => _ = 0
                    .err _ => _ = 0
            else if strings.has_prefix(s: entry, prefix: ".")
                if strings.has_suffix(s: name, suffix: entry)
                    return true
            else if name == entry || strings.has_suffix(s: name, suffix: "." + entry)
                return true

    return false

# Whether `text` matches `pattern`, where a `*` stands for any run of bytes,
# an empty one too, and every other byte for itself; as Windows' and macOS's
# bypass lists write `*.corp.example` and `192.168.*`.
function glob_matches(pattern: str, text: str) -> bool
    p: i64 @= 0
    t: i64 @= 0
    star: i64 @= -1
    mark: i64 @= 0

    while t < text.len()
        if p < pattern.len() && pattern[p] == '*'
            star @ p
            mark @ t
            p @ p + 1
        else if p < pattern.len() && pattern[p] == text[t]
            p @ p + 1
            t @ t + 1
        else if star >= 0
            p @ star + 1
            mark @ mark + 1
            t @ mark
        else
            return false

    while p < pattern.len() && pattern[p] == '*'
        p @ p + 1

    return p == pattern.len()

# Whether `entry` and `host`, each an address read or its failure, are one
# address: the same bytes, whatever the way each was written.
function is_same_address(entry: net.Host?, host: net.Host?) -> bool
    match entry
        .err _ => return false
        .ok a =>
            match host
                .err _ => return false
                .ok b  => return a.bytes == b.bytes

# The host of `a`, an address with a port read, or the failure it holds.
function host_of(a: net.Address?) -> net.Host?
    got = a?
    return ok(got.host)

# The `Proxy-Authorization` field `place` asks for: none where it has no
# user, else Basic's, RFC 7617.
function credentials_of(place: Place) -> [wire.Field]
    if place.user == "" && place.password == ""
        return []
    token = bytes.format_base64(bytes.from_text(place.user + ":" + place.password))
    return [wire.Field(name: "Proxy-Authorization", value: "Basic " + token)]

# The authority a `CONNECT` names: the host, in brackets where it is an IPv6
# address, and the port, always written.
function authority_of(host: str, port: i64) -> str
    if strings.contains(s: host, substr: ":")
        return f"[{host}]:{port}"
    return f"{host}:{port}"

## Tests

test "place_of: a scheme or none, a user and a password, the port's default, and what is refused"
    assert place_of("http://u:p%40ss@proxy.example:3128").must() == Place(scheme: "http", host: "proxy.example", port: 3128, user: "u", password: "p@ss")
    assert place_of("proxy.example:8080").must() == Place(scheme: "http", host: "proxy.example", port: 8080, user: "", password: "")
    assert place_of("http://proxy.example").must().port == 80
    assert place_of("SOCKS5H://u:p@proxy.example").must() == Place(scheme: "socks5h", host: "proxy.example", port: 1080, user: "u", password: "p")
    assert place_of("socks4a://proxy.example:9050").must().port == 9050
    assert place_of("socks4://proxy.example").must().scheme == "socks4"
    assert place_of("socks://proxy.example").is_err()
    assert place_of("https://proxy.example").is_err()
    assert place_of("http://:3128").is_err()

test "is_bypassed: every host, a name and the names under it, a dot, a port, an address, a network, and loopback"
    assert is_bypassed(["*"], host: "example.com", port: 443)
    assert is_bypassed(["example.com"], host: "example.com", port: 80)
    assert is_bypassed(["example.com"], host: "api.EXAMPLE.com", port: 80)
    assert !is_bypassed(["example.com"], host: "notexample.com", port: 80)
    assert is_bypassed([".example.com"], host: "a.example.com", port: 80)
    assert !is_bypassed([".example.com"], host: "example.com", port: 80)
    assert is_bypassed(["example.com:8080"], host: "example.com", port: 8080)
    assert !is_bypassed(["example.com:8080"], host: "example.com", port: 80)
    assert is_bypassed(["10.0.0.0/8"], host: "10.1.2.3", port: 80)
    assert !is_bypassed(["10.0.0.0/8"], host: "11.1.2.3", port: 80)
    assert is_bypassed(["192.0.2.7"], host: "192.0.2.7", port: 80)
    assert is_bypassed(["[2001:db8::1]:443"], host: "2001:db8::1", port: 443)
    assert is_bypassed([], host: "localhost", port: 80)
    assert is_bypassed([], host: "127.0.0.1", port: 80)
    assert is_bypassed([], host: "::1", port: 80)
    assert !is_bypassed([], host: "example.com", port: 80)
    assert is_bypassed(["<local>"], host: "printer", port: 80)
    assert !is_bypassed(["<local>"], host: "printer.example.com", port: 80)
    assert !is_bypassed(["<local>"], host: "8.8.8.8", port: 80)
    assert is_bypassed(["<local>", "x.example"], host: "api.x.example", port: 80)

test "glob_matches: a star for any run, an empty one, at either end, in the middle, and none at all"
    assert glob_matches(pattern: "*.corp.example", text: "a.corp.example")
    assert !glob_matches(pattern: "*.corp.example", text: "corp.example")
    assert glob_matches(pattern: "192.168.*", text: "192.168.1.7")
    assert !glob_matches(pattern: "192.168.*", text: "192.169.1.7")
    assert glob_matches(pattern: "*", text: "")
    assert glob_matches(pattern: "a*b*c", text: "aXXbYYc")
    assert !glob_matches(pattern: "a*b*c", text: "aXXbYY")
    assert glob_matches(pattern: "a**b", text: "ab")
    assert glob_matches(pattern: "abc", text: "abc")
    assert !glob_matches(pattern: "abc", text: "abcd")
    assert !glob_matches(pattern: "", text: "a")
    assert glob_matches(pattern: "", text: "")

test "is_bypassed: a pattern with a star, and `<local>` beside an address that is not a name"
    assert is_bypassed(["*.corp.example"], host: "git.corp.example", port: 443)
    assert !is_bypassed(["*.corp.example"], host: "corp.example", port: 443)
    assert is_bypassed(["192.168.*"], host: "192.168.4.4", port: 80)
    assert is_bypassed(["*.corp.example:8443"], host: "git.corp.example", port: 8443)
    assert !is_bypassed(["*.corp.example:8443"], host: "git.corp.example", port: 443)

test "is_bypassed: macOS's exceptions answer as Python 3.15.2's urllib.request does for the same lists, apart from the case of a name"
    system = ["*.local", "169.254.0.0/16", "<local>"]
    assert is_bypassed(system, host: "printer.local", port: 80)
    assert is_bypassed(system, host: "local", port: 80)
    assert is_bypassed(system, host: "169.254.1.1", port: 80)
    assert !is_bypassed(system, host: "169.253.1.1", port: 80)
    assert !is_bypassed(system, host: "example.com", port: 80)
    assert is_bypassed(system, host: "simple", port: 80)
    assert is_bypassed(system, host: "a.b.local", port: 80)
    assert !is_bypassed(system, host: "192.168.1.1", port: 80)
    assert is_bypassed(system, host: "PRINTER.LOCAL", port: 80)
    other = ["192.168.*", "*.corp.example", "10.0.0.0/8"]
    assert is_bypassed(other, host: "192.168.4.4", port: 80)
    assert !is_bypassed(other, host: "192.169.4.4", port: 80)
    assert is_bypassed(other, host: "git.corp.example", port: 80)
    assert !is_bypassed(other, host: "corp.example", port: 80)
    assert is_bypassed(other, host: "10.9.9.9", port: 80)
    assert !is_bypassed(other, host: "11.0.0.1", port: 80)

test "bypass_of, credentials_of and authority_of: the parts of a value, Basic's field, and a bracketed address"
    assert bypass_of(" a.com, ,b.com ,") == ["a.com", "b.com"]
    assert credentials_of(Place(scheme: "http", host: "p", port: 1, user: "", password: "")) == []
    assert credentials_of(Place(scheme: "http", host: "p", port: 1, user: "Aladdin", password: "open sesame"))[0].value == "Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="
    assert authority_of("example.com", port: 443) == "example.com:443"
    assert authority_of("::1", port: 443) == "[::1]:443"
