# Content coding, RFC 9110 § 8.4: a body's `Content-Encoding` undone through
# `compress`, always under a limit, and an `Accept-Encoding` read for whether
# a coding is acceptable to the client.

use compress
use http/internal/syntax
use strings

# The code of a body that is not what its coding says.
constant INVALID: str
    "invalid"

# The codings a `Content-Encoding`'s values name, in the order they were
# applied, each in lower case.
function codings_of(values: [str]) -> [str]
    out: [str] @= []

    for value in values
        for member in syntax.members(value)
            out @ out.push(strings.to_lower_ascii(member))

    return out

# Whether every one of `codings` is one this package undoes: `gzip`,
# `x-gzip`, `deflate` or `identity`.
function is_decodable(codings: [str]) -> bool
    for c in codings
        if c != "gzip" && c != "x-gzip" && c != "deflate" && c != "identity"
            return false

    return true

# `data` with `codings` undone, the last applied first, each answer at most
# `limit` bytes. `deflate` is read as zlib, as RFC 9110 names it, and as raw
# DEFLATE where zlib refuses it, as some servers send it. Fails `limit` where
# an answer would pass `limit` bytes, `invalid` where `data` is not what its
# coding says, a gzip cut short among them.
function decode(data: [u8], codings: [str], limit: i64) -> [u8]?
    out: [u8] @= data
    at: i64 @= codings.len() - 1

    while at >= 0
        c = codings[at]

        if c == "gzip" || c == "x-gzip"
            out @ compress.decompress(out, format: .gzip, limit: limit)?
        else if c == "deflate"
            match compress.decompress(out, format: .zlib, limit: limit)
                .ok plain => out @ plain
                .err e =>
                    if e.code != compress.INVALID
                        return fail(code: e.code, msg: e.msg)
                    out @ compress.decompress(out, format: .raw, limit: limit)?
        at @ at - 1

    return ok(out)

# Whether `coding` is acceptable to a client whose `Accept-Encoding` values
# are `values`, RFC 9110 § 12.5.3: named with a weight above 0, or not named
# while `*` is, with a weight above 0. `x-gzip` stands for `gzip`.
function accepts(values: [str], coding: str) -> bool
    star: bool @= false

    for value in values
        for member in syntax.members(value)
            parts = strings.split(s: member, sep: ";")
            name = strings.to_lower_ascii(syntax.trim_ows(parts[0]))
            wanted: bool @= true

            for param in parts.slice(from: 1, to: parts.len())
                pair = strings.split_once(s: param, sep: "=").default(strings.Halves(before: param, after: ""))

                if syntax.same_name(a: syntax.trim_ows(pair.before), b: "q") && is_zero(syntax.trim_ows(pair.after))
                    wanted @ false

            if name == coding || coding == "gzip" && name == "x-gzip"
                return wanted

            if name == "*"
                star @ wanted

    return star

# Whether the weight `q` is 0: `0`, or `0.` and up to three zeros.
function is_zero(q: str) -> bool
    if q == "" || q[0] != '0'
        return false
    at: i64 @= 1

    if at < q.len() && q[at] == '.'
        at @ at + 1

    while at < q.len()
        if q[at] != '0'
            return false
        at @ at + 1

    return q.len() <= 5

## Tests

test "codings_of and is_decodable: a list in order, lower case, an unknown coding"
    assert codings_of(["gzip, Deflate", "identity"]) == ["gzip", "deflate", "identity"] && codings_of([]).len() == 0
    assert is_decodable(["x-gzip", "deflate"]) && is_decodable([]) && !is_decodable(["gzip", "br"])

test "decode: gzip, zlib, raw DEFLATE, two codings, none"
    text: [u8] = [104, 101, 108, 108, 111]
    assert decode(compress.compress(text, options: compress.default_options(.gzip)).must(), codings: ["gzip"], limit: 5).must() == text
    assert decode(compress.compress(text, options: compress.default_options(.zlib)).must(), codings: ["deflate"], limit: 5).must() == text
    assert decode(compress.compress(text, options: compress.default_options(.raw)).must(), codings: ["deflate"], limit: 5).must() == text
    twice = compress.compress(
        compress.compress(text, options: compress.default_options(.zlib)).must(),
        options: compress.default_options(.gzip)
    ).must()
    assert decode(twice, codings: ["deflate", "gzip"], limit: 100).must() == text
    assert decode(text, codings: [], limit: 0).must() == text && decode(text, codings: ["identity"], limit: 0).must() == text

test "decode: a bomb past the limit, a gzip cut short, bytes that are no coding"
    zeros: [u8] @= []

    while zeros.len() < 1_048_576
        zeros @ zeros.push(0)

    bomb = compress.compress(zeros, options: compress.default_options(.gzip)).must()
    assert bomb.len() < 4_096

    match decode(bomb, codings: ["gzip"], limit: 65_536)
        .ok _  => assert false
        .err e => assert e.code == compress.LIMIT

    whole = compress.compress([104, 105], options: compress.default_options(.gzip)).must()

    match decode(whole.slice(from: 0, to: whole.len() - 3), codings: ["gzip"], limit: 100)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert decode([1, 2, 3], codings: ["deflate"], limit: 100).is_err()

test "accepts: a weight of 0, a star, x-gzip, nothing named"
    assert accepts(["gzip, deflate"], coding: "gzip") && accepts(["br;q=1.0, x-gzip"], coding: "gzip")
    assert !accepts(["gzip;q=0"], coding: "gzip") && !accepts(["gzip; q=0.000"], coding: "gzip")
    assert accepts(["*"], coding: "deflate") && !accepts(["*, deflate;q=0"], coding: "deflate") && !accepts(["*;q=0"], coding: "gzip")
    assert !accepts([], coding: "gzip") && !accepts(["br"], coding: "gzip") && accepts(["gzip;q=0.5"], coding: "gzip")
    assert is_zero("0") && is_zero("0.") && is_zero("0.000") && !is_zero("0.001") && !is_zero("1") && !is_zero("")
