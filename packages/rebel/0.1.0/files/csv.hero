# Comma-separated values read and written by RFC 4180: a text or a stream of
# rows, each row fields between separators, a field holding a separator, a
# quote or a line end written inside quotes with its quotes doubled.
#
# A field is text and nothing else: a number in a field is read with
# `numbers`, and a row is a `[str]` whatever its fields hold. A line end
# inside a quoted field is kept as it was written, CR LF or LF; a row ends at
# either outside quotes, and a carriage return alone is a field's text. An
# empty line holds no row and is skipped.
#
# Tab-separated values are the same format with another separator: the
# options' `separator` set to "\t", as Python's `excel_tab` sets it. Rows
# keyed by the names of a header row are `parse_records` and
# `format_records`. The options are never guessed from a sample, as Python's
# `Sniffer` guesses them, since a guess can read a text as another format
# without a word: a program states the format it reads.
#
# Fails `invalid` where a text is not CSV as the options read it, the message
# opening `line L, column C:`, both from 1 and the column in characters, or
# `line L:` for a row of the wrong length. Through a stream, fails as well as
# `io` fails its reads and writes.

use csv/internal/scan
use csv/internal/stream
use csv/internal/write
use io

## Codes

# The code of a text that is not CSV as the options read it, of a header that
# names a column twice, and of a record that does not fit its header.
constant INVALID: str
    "invalid"

# The code of a stream's bytes that are not UTF-8, as `io` reads them.
constant NOT_TEXT: str
    "not_text"

## Limits

# The most bytes a field may hold unless the options say otherwise:
# 131,072, Python's own limit. A stream whose quoted field is never closed is
# refused once the field passes it, rather than read whole into memory.
constant DEFAULT_MAX_FIELD_LEN: i64
    131072

## Reading

# How rows are read. `strict_read_options` answers RFC 4180's; a program changes the
# fields it needs.
record ReadOptions
    # The one ASCII character between two fields: `","`, `";"`, `"\t"`; not a
    # line end and not `quote`.
    separator: str
    # The one ASCII character that opens and closes a quoted field and is
    # doubled inside one: `"\""`; not a line end.
    quote: str
    # The one ASCII character that opens a line to skip, `"#"`, where it is
    # the line's first; "" where no line is a comment.
    comment: str
    # Whether spaces and tabs at the start of a field are dropped, so that a
    # quoted field may stand after them.
    trim_leading_space: bool
    # Whether a quote inside a field that does not open with one is read as
    # text, text after a closing quote is added to the field, and a quoted
    # field the input ends inside ends there, rather than each failing
    # `invalid`.
    lazy_quotes: bool
    # Whether rows may hold different numbers of fields; refused, every row
    # must hold as many as the first.
    ragged: bool
    # The most bytes one field may hold; past it the read fails `invalid`.
    max_field_len: i64

# The options of RFC 4180: a comma, a double quote, no comment, nothing
# trimmed, quotes strict, every row as long as the first, and fields of at most
# `DEFAULT_MAX_FIELD_LEN` bytes.
function strict_read_options() -> ReadOptions
    return ReadOptions(
        separator: ",",
        quote: "\"",
        comment: "",
        trim_leading_space: false,
        lazy_quotes: false,
        ragged: false,
        max_field_len: DEFAULT_MAX_FIELD_LEN
    )

# Every row of `text`, read as `strict_read_options` reads.
#
# - `text`: the CSV text; empty for no row.
#
# Fails `invalid` where a quote stands inside a field that does not open with
# one, text follows a closing quote, a quoted field is never closed, a field
# passes `DEFAULT_MAX_FIELD_LEN` bytes, or a row holds another number of fields
# than the first. See also `parse_with`, `parse_records`.
function parse(text: str) -> [[str]]?
    return parse_with(text, strict_read_options())

# Every row of `text`, read as `options` say.
#
# - `text`: the CSV text; empty for no row.
# - `options`: how it is read; `strict_read_options()` for RFC 4180.
#
# Fails `invalid` as `parse` does, where `options` refuse it. Aborts where a
# character of `options` is not one ASCII character, the separator or the
# quote is a line end, two of them are one character, or `max_field_len` is
# below 1.
function parse_with(text: str, options: ReadOptions) -> [[str]]?
    rules = scan.new_rules(
        separator: options.separator,
        quote: options.quote,
        comment: options.comment,
        trim: options.trim_leading_space,
        lazy: options.lazy_quotes,
        ragged: options.ragged,
        max_field: options.max_field_len
    )
    rows = scan.parse_rows(text, rules)?
    found: [[str]] @= []

    for r in rows
        found @ found.push(r.fields)

    return ok(found)

# The rows of `text` after its first, each keyed by the names of the first.
#
# - `text`: the CSV text, its first row the header.
# - `options`: how it is read.
#
# Each map holds its row's fields in the header's order; a row shorter than
# the header lacks the names past its end, which `ragged` allows. Empty where
# the text holds a header alone, or nothing.
#
# Fails `invalid` as `parse_with` does, and where the header names a column
# twice or a row holds more fields than the header, naming its line. Aborts as
# `parse_with` does.
function parse_records(text: str, options: ReadOptions) -> [{str: str}]?
    rules = scan.new_rules(
        separator: options.separator,
        quote: options.quote,
        comment: options.comment,
        trim: options.trim_leading_space,
        lazy: options.lazy_quotes,
        ragged: options.ragged,
        max_field: options.max_field_len
    )
    rows = scan.parse_rows(text, rules)?
    records: [{str: str}] @= []

    if rows.len() == 0
        return ok(records)

    match write.check_header(rows[0].fields)
        .ok _  => _ = 0
        .err h => return fail(code: INVALID, msg: f"line {rows[0].line}: {h.msg}")

    for at in range(from: 1, to: rows.len())
        match write.record_of(header: rows[0].fields, row: rows[at].fields)
            .ok keyed => records @ records.push(keyed)
            .err e    => return fail(code: INVALID, msg: f"line {rows[at].line}: {e.msg}")

    return ok(records)

# `row` keyed by the names of `header`, in the header's order.
#
# - `header`: the names of the columns, as a first row holds them.
# - `row`: a row read under it.
#
# A row shorter than the header lacks the names past its end. Fails `invalid`
# where the header names a column twice or the row is longer than it. See also
# `parse_records`.
function record_of(header: [str], row: [str]) -> {str: str}?
    return write.record_of(header: header, row: row)

## Writing

# How rows are written. `minimal_write_options` answers RFC 4180's; a program changes the
# fields it needs.
record WriteOptions
    # The one ASCII character between two fields; not a line end and not
    # `quote`.
    separator: str
    # The one ASCII character that opens and closes a quoted field.
    quote: str
    # Whether every field is quoted; else only one that holds the separator,
    # the quote, a carriage return or a line feed.
    quote_all: bool
    # What ends each row: `"\r\n"`, RFC 4180's, or `"\n"`.
    line_end: str

# The options of RFC 4180: a comma, a double quote, a field quoted only where
# it must be, and CR LF after each row.
function minimal_write_options() -> WriteOptions
    return WriteOptions(separator: ",", quote: "\"", quote_all: false, line_end: "\r\n")

# `rows` written as `minimal_write_options` writes them.
#
# - `rows`: the rows, each a list of fields; empty for the empty text.
#
# Each row ends with CR LF. A row of one empty field is written `""`, so that
# it is read back; a row of no field is an empty line, which a reader skips.
# See also `format_with`.
function format(rows: [[str]]) -> str
    return format_with(rows, minimal_write_options())

# `rows` written as `options` say.
#
# - `rows`: the rows; empty for the empty text.
# - `options`: how they are written; `minimal_write_options()` for RFC 4180.
#
# Aborts where a character of `options` is not one ASCII character, the
# separator or the quote is a line end, the two are one character, or
# `line_end` is neither `"\r\n"` nor `"\n"`.
function format_with(rows: [[str]], options: WriteOptions) -> str
    return write.rows_text(
        rows,
        write.new_style(separator: options.separator, quote: options.quote, quote_all: options.quote_all, line_end: options.line_end)
    )

# One row written as `options` say, its line end after it.
#
# - `row`: the fields, in order.
# - `options`: how it is written.
#
# Aborts as `format_with` does.
function format_row(row: [str], options: WriteOptions) -> str
    return write.row_text(
        row,
        write.new_style(separator: options.separator, quote: options.quote, quote_all: options.quote_all, line_end: options.line_end)
    )

# A header and the records under it written as `options` say, the header
# first.
#
# - `header`: the names of the columns, in the order they are written.
# - `records`: each a row keyed by column; a name it lacks is written "".
# - `options`: how the rows are written.
#
# Fails `invalid` where the header names a column twice or a record holds a
# key the header does not name. Aborts as `format_with` does.
function format_records(header: [str], records: [{str: str}], options: WriteOptions) -> str?
    rows = write.records_rows(header, records)?
    return ok(format_with(rows, options))

## Through a stream

# A reader of rows from a stream, which reads it a line at a time as rows are
# asked for. Made by `reader`; it holds the stream, which whoever made the
# stream closes.
record Reader
    # The stream, the options and the lines read and not given out yet.
    state: stream.State

# A reader of the rows of `s`, as `options` say. It reads nothing until asked.
#
# - `s`: the stream; whoever made it closes it, once the reader is done.
# - `options`: how the rows are read.
#
# Aborts as `parse_with` does on `options`.
function reader(s: io.Stream, options: ReadOptions) -> Reader
    rules = scan.new_rules(
        separator: options.separator,
        quote: options.quote,
        comment: options.comment,
        trim: options.trim_leading_space,
        lazy: options.lazy_quotes,
        ragged: options.ragged,
        max_field: options.max_field_len
    )
    return Reader(state: stream.start(s, rules))

# The next row of `r`'s stream, [] at its end: no row read is empty, since an
# empty line holds none.
#
# - `r`: the reader; advances past the row and the empty lines and comments
#   before it.
#
# Fails `invalid` as `parse_with` does, the lines counted from the stream's
# first; fails as `io` fails a read, `not_text` where a line is not UTF-8.
# Strict rows are read in time linear in the stream; with `lazy_quotes`, a
# field across many lines is read again after each of them. See also
# `at_end`, `read_rows`.
function read_row(@r: Reader) -> [str]?
    return stream.read_row(@r.state)

# Every row left in `r`'s stream, in order.
#
# - `r`: the reader; reaches the stream's end.
#
# Fails as `read_row` does.
function read_rows(@r: Reader) -> [[str]]?
    return stream.read_rows(@r.state)

# Whether no row is left in `r`'s stream, waiting for a line where none is
# there and the stream has not ended.
#
# - `r`: the reader; reads and drops the empty lines and comments before the
#   next row.
#
# Fails as `read_row` does.
function at_end(@r: Reader) -> bool?
    return stream.at_end(@r.state)

# The line, from 1, of `r`'s stream that the last row read began on: 0 before
# the first.
#
# - `r`: the reader.
function line_of(r: Reader) -> i64
    return r.state.row_line

# Writes `row` to `s`, as `options` say, its line end after it.
#
# - `s`: the stream; whoever made it closes it.
# - `row`: the fields, in order.
# - `options`: how it is written.
#
# Fails as `io.write_text` does. Aborts as `format_with` does.
function write_row(s: io.Stream, row: [str], options: WriteOptions) -> ()?
    return io.write_text(s, format_row(row, options))

# Writes every row of `rows` to `s`, as `options` say, in one write.
#
# - `s`: the stream; whoever made it closes it.
# - `rows`: the rows; empty for nothing written.
# - `options`: how they are written.
#
# Fails as `io.write_text` does. Aborts as `format_with` does.
function write_rows(s: io.Stream, rows: [[str]], options: WriteOptions) -> ()?
    return io.write_text(s, format_with(rows, options))

## Examples

# The options of RFC 4180, a field with a comma inside quotes.
test "strict_read_options: a quoted comma"
    assert parse_with("\"a,b\",c\n", strict_read_options()).must() == [["a,b", "c"]]

# The rows of a text, a quote doubled inside a field.
test "parse: two rows, one with a quote"
    assert parse("name,said\nAna,\"\"\"hi\"\"\"\n").must() == [["name", "said"], ["Ana", "\"hi\""]]

# A semicolon between fields, rows of different lengths allowed.
test "parse_with: semicolons and a short row"
    options @= strict_read_options()
    options.separator @ ";"
    options.ragged @ true
    assert parse_with("a;b\nc\n", options).must() == [["a", "b"], ["c"]]

# Rows keyed by the header's names.
test "parse_records: a table of two columns"
    records = parse_records("name,year\nLow,1977\nLodger,1979\n", strict_read_options()).must()
    assert records[1]["year"].must() == "1979"

# One row keyed by a header read before it.
test "record_of: a row under its header"
    assert record_of(header: ["name", "year"], row: ["Heroes", "1977"]).must()["name"].must() == "Heroes"

# The options of RFC 4180 for writing, every field quoted.
test "minimal_write_options: every field quoted"
    options @= minimal_write_options()
    options.quote_all @ true
    assert format_row(["a", "b"], options) == "\"a\",\"b\"\r\n"

# Rows written, a field with a comma quoted.
test "format: a field with a comma"
    assert format([["a", "b,c"], ["d", "e"]]) == "a,\"b,c\"\r\nd,e\r\n"

# Rows written with tabs and line feeds.
test "format_with: tab-separated, LF"
    options @= minimal_write_options()
    options.separator @ "\t"
    options.line_end @ "\n"
    assert format_with([["a", "b"]], options) == "a\tb\n"

# One row written, a line end inside a field.
test "format_row: a field across two lines"
    assert format_row(["a", "b\nc"], minimal_write_options()) == "a,\"b\nc\"\r\n"

# A header and its records written.
test "format_records: two columns, one left empty"
    assert format_records(["name", "year"], [{"name": "Low"}], minimal_write_options()).must() == "name,year\r\nLow,\r\n"

# A reader made over a stream.
test "reader: rows of a pipe"
    p @= io.pipe().must()
    io.write_text(p.writer, "a,b\n").must()
    io.close(@p.writer).must()
    r @= reader(p.reader, strict_read_options())
    assert read_row(@r).must() == ["a", "b"]
    io.close(@p.reader).must()

# Rows read one at a time until the end.
test "read_row: every row of a stream, then []"
    p @= io.pipe().must()
    io.write_text(p.writer, "x,1\ny,2\n").must()
    io.close(@p.writer).must()
    r @= reader(p.reader, strict_read_options())
    total @= 0

    while true
        row = read_row(@r).must()

        if row.len() == 0
            break
        total @ total + 1

    assert total == 2
    io.close(@p.reader).must()

# Every row of a stream at once.
test "read_rows: a stream of two rows"
    p @= io.pipe().must()
    io.write_text(p.writer, "a\nb\n").must()
    io.close(@p.writer).must()
    r @= reader(p.reader, strict_read_options())
    assert read_rows(@r).must() == [["a"], ["b"]]
    io.close(@p.reader).must()

# The end of a stream asked before reading.
test "at_end: an empty stream"
    p @= io.pipe().must()
    io.write_text(p.writer, "\n").must()
    io.close(@p.writer).must()
    r @= reader(p.reader, strict_read_options())
    assert at_end(@r).must()
    io.close(@p.reader).must()

# The line a row began on, for a message of the program's own.
test "line_of: the second row began on line 3"
    p @= io.pipe().must()
    io.write_text(p.writer, "a\n\"b\nc\"\nd\n").must()
    io.close(@p.writer).must()
    r @= reader(p.reader, strict_read_options())
    _ = read_row(@r).must()
    _ = read_row(@r).must()
    assert line_of(r) == 2
    _ = read_row(@r).must()
    assert line_of(r) == 4
    io.close(@p.reader).must()

# A row written to a stream and read back.
test "write_row: one row through a pipe"
    p @= io.pipe().must()
    write_row(p.writer, ["a", "b c"], minimal_write_options()).must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == "a,b c\r\n"
    io.close(@p.reader).must()

# Rows written to a stream in one write.
test "write_rows: two rows through a pipe"
    p @= io.pipe().must()
    write_rows(p.writer, [["a"], ["b"]], minimal_write_options()).must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == "a\r\nb\r\n"
    io.close(@p.reader).must()
