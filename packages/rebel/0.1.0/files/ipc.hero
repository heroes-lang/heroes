# Communication between the processes of one machine: a local channel by name,
# read and written as an `io.Stream`, and messages whole over one; memory
# shared by name, read and written by copies; a semaphore and a lock between
# processes, named, every wait with a bound. TCP and UDP, between machines or
# not, are `net`'s; a child's own three streams are `process`'s; a pipe within
# the process is `io.pipe`. Every failure is a code of the library's closed
# list (README § A4): `not_found`, `file_not_found`, `exists`, `permission`,
# `invalid`, `is_a_directory`, `closed`, `timeout`, `stopped`, `limit`,
# `unsupported` and `failed`. The face stands on the floor `ipc/hero_ipc`, the
# thin binding of `hero_ipc.h`.
#
# **Three locks between processes stand in Rebel**: this package's, named, of
# the machine; `fs.lock`, on a file, which another program that locks the file
# respects; and `redis.lock`, on a Redis server, held across machines and
# expiring with its time to live.
#
# **A channel's name** is a path of the file system on every platform, a
# socket file made there (Windows 10 1803 and later); Linux has abstract
# names besides, which no file holds, and Windows named pipes, each a door of
# its own that answers `unsupported` elsewhere. **The name of memory, a
# semaphore or a lock** is 1 to 29 ASCII letters, digits, `.`, `_` and `-`,
# the first no `.` (`is_name`), the same name another language's program
# finds the object by: POSIX's `/<name>` for memory and a semaphore, the file
# `/tmp/heroes-lock-<name>` for a lock, and the object `<name>` on Windows,
# where one name names one object of any kind.
#
# **Every wait has a bound**, `within_ms`: the milliseconds a call may wait,
# 0 to try once without waiting, and `FOREVER` for no bound. A channel's
# reads and writes end by the deadline `set_deadline` gives. And every wait
# here, a channel's read and write among them, fails `stopped` within about
# 50 ms once the program is asked to stop (`os.catch_stop`, `os.ask_stop`).
#
# **Who closes what**: a listener, memory, a semaphore and a lock are each
# closed by its own `close_` function, once, through the place that will be
# asked again; a channel is closed with `io.close`. Closing gives back what
# this process holds and nothing more: memory, a semaphore and a lock stay for
# the other processes that have them, and on POSIX for every later `open_`,
# until a `remove_` takes their name away. On Windows the system takes a name
# away with the last process that has it open.

use io
use ipc/hero_ipc
use ipc/internal/across
use ipc/internal/channels
use ipc/internal/messages
use ipc/internal/names
use ipc/internal/shared
use ipc/internal/waits
use os
use process

## Codes

# A name that names nothing: no memory, semaphore or lock of that name, a
# Windows pipe no listener has, or memory its maker has not sized yet.
constant NOT_FOUND: str
    "not_found"

# A path that names nothing: no file at the path a connect is given, or no
# folder where a listener's socket file would be made; the language's own
# code for it.
constant FILE_NOT_FOUND: str
    "file_not_found"

# A name taken already: a file at a listener's path, a listener on a name,
# memory or a semaphore of that name, on Windows an object of any kind.
constant EXISTS: str
    "exists"

# The system refuses this to the program: the name's permission is another's,
# or a lock's file is no regular file of one name.
constant PERMISSION: str
    "permission"

# An argument outside what the function reads: a name outside the rule, a
# path longer than a socket's address holds, a path a connect is given where
# something stands that is no socket and no folder (a file, a FIFO, a
# device), a size or an offset outside the memory, a `within_ms` below 0 that
# is not `FOREVER`, a message past its most, a lock asked again or released
# by a thread that does not hold it.
constant INVALID: str
    "invalid"

# A folder is at the path a connect is given, where a listener's socket file
# would be.
constant IS_A_DIRECTORY: str
    "is_a_directory"

# The listener, memory, semaphore or lock is closed, or the channel's other
# end is gone, or it ended before a whole message, or nothing listens where a
# connect asks: a socket file a process that died left, an abstract name no
# listener has.
constant CLOSED: str
    "closed"

# The bound a wait was given passed first.
constant TIMEOUT: str
    "timeout"

# The program was asked to stop while a call waited.
constant STOPPED: str
    "stopped"

# The process or the machine has no descriptor, handle, memory or room left.
constant LIMIT: str
    "limit"

# This platform has no such thing: an abstract name off Linux, a named pipe
# off Windows.
constant UNSUPPORTED: str
    "unsupported"

# The system refused for a reason none of the other codes names; the message
# carries the system's own number.
constant FAILED: str
    "failed"

## Waiting

# What `within_ms` takes for a wait with no bound.
constant FOREVER: i64
    -1

## Names

# Whether `name` is a name of memory, a semaphore, a lock, an abstract
# channel or a pipe: 1 to 29 ASCII letters, digits, `.`, `_` and `-`, the
# first no `.`.
#
# - `name`: the name to judge; "" is none.
#
# See also `create_memory`, `open_lock`.
function is_name(name: str) -> bool
    return names.is_name(name)

## Channels

# A channel's listener, which `listen`, `listen_abstract` and `listen_pipe`
# make and `close_listener` closes. It holds a handle: every copy reaches the
# same listener.
record Listener
    # The floor's handle, `nullptr` once `close_listener` has emptied this
    # place.
    handle: hero_ipc.Listener
    # The path or the name it listens on, as it was given.
    name: str
    # Where the name lives.
    space: Space

# Where a channel's name lives.
variant Space
    # A path of the file system, a socket file there.
    path
    # Linux's abstract space, which no file holds.
    abstract
    # A Windows named pipe, `\\.\pipe\` and the name.
    pipe

# A listener on the socket file it makes at `path`, which `close_listener`
# removes again.
#
# - `path`: where the socket file is made, relative or absolute; at most 103
#   bytes on macOS and 107 elsewhere. A file already there fails `exists`
#   and is left, a socket file a process that died left among them, as Go's
#   `net.Listen` does: remove it with `fs.remove` once no process listens.
# - `permission`: the nine bits of POSIX on the socket file, 0 to 0o777, set
#   before the first connection can be made; 0o600 lets only this user
#   connect. Windows has no such bits and ignores it.
#
# Fails `exists` as above, `invalid` for an empty or a too long path or a
# permission out of range, `file_not_found` where a folder on the path is
# not there, `permission` where the system refuses the folder.
#
# See also `accept`, `connect`, `close_listener`.
function listen(path: str, permission: i64) -> Listener?
    handle = channels.listen(path, space: hero_ipc.HERO_IPC_SPACE_PATH, permission: permission)?
    return ok(Listener(handle: handle, name: path, space: .path))

# A listener on `name` in Linux's abstract space, which no file holds and
# which ends with the listener.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `unsupported` off Linux, `exists` where something listens on the name
# already, `invalid` for a name outside the rule.
#
# See also `connect_abstract`, `listen`.
function listen_abstract(name: str) -> Listener?
    handle = channels.listen(name, space: hero_ipc.HERO_IPC_SPACE_ABSTRACT, permission: 0)?
    return ok(Listener(handle: handle, name: name, space: .abstract))

# A listener on the Windows named pipe `\\.\pipe\` and `name`, which takes
# clients of this machine alone and one `accept` at a time.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `unsupported` off Windows, `exists` where another listener has the
# name, `invalid` for a name outside the rule.
#
# See also `connect_pipe`, `listen`.
function listen_pipe(name: str) -> Listener?
    handle = channels.listen(name, space: hero_ipc.HERO_IPC_SPACE_PIPE, permission: 0)?
    return ok(Listener(handle: handle, name: name, space: .pipe))

# The next connection on `l`, as a stream the caller closes with `io.close`.
#
# - `l`: the listener, which stays open.
# - `within_ms`: the milliseconds to wait for a connection, 0 to take one
#   waiting already, `FOREVER` for no bound.
#
# Fails `timeout` where none comes in time, `closed` where `l` is closed (or
# is closed by another thread while the call waits), `stopped` where the
# program is asked to stop, `invalid` for a negative bound that is not
# `FOREVER` or a second `accept` on a pipe at once.
#
# See also `listen`, `connect`, `read_message`.
function accept(l: Listener, within_ms: i64) -> io.Stream?
    return channels.accept(
        l.handle,
        within_ms: within_ms,
        where: channels.listener_label(l.name, abstract: l.space == .abstract, pipe: l.space == .pipe)
    )

# A connection to the listener at `path`, as a stream the caller closes with
# `io.close`.
#
# - `path`: the listener's socket file.
# - `within_ms`: the milliseconds to wait while the listener has no room for
#   another connection, 0 not to wait, `FOREVER` for no bound.
#
# Fails `file_not_found` where nothing is at the path, `closed` where a
# socket file is there and nothing listens on it, `is_a_directory` where a
# folder is there,
# `invalid` where something else that is no socket is there (a file, a FIFO,
# a device) and for an empty or too long path, `timeout` past the bound, and
# `permission` where the socket file's permission refuses this user. What is
# at the path decides the code, the same on every platform, whatever number
# the system answered (a link is followed, as the connect follows it).
#
# See also `listen`, `write_message`.
function connect(path: str, within_ms: i64) -> io.Stream?
    return channels.connect(path, space: hero_ipc.HERO_IPC_SPACE_PATH, within_ms: within_ms)

# A connection to the listener on `name` in Linux's abstract space, as
# `connect` answers one.
#
# - `name`: a name by `is_name`'s rule.
# - `within_ms`: as for `connect`.
#
# Fails `unsupported` off Linux, `closed` where nothing listens on the name,
# and as `connect` does.
#
# See also `listen_abstract`.
function connect_abstract(name: str, within_ms: i64) -> io.Stream?
    return channels.connect(name, space: hero_ipc.HERO_IPC_SPACE_ABSTRACT, within_ms: within_ms)

# A connection to the Windows named pipe `\\.\pipe\` and `name`, as
# `connect` answers one. The listener may learn who connects and never act
# as this process.
#
# - `name`: a name by `is_name`'s rule.
# - `within_ms`: the milliseconds to wait while every instance of the pipe
#   serves a client, 0 not to wait, `FOREVER` for no bound.
#
# Fails `unsupported` off Windows, `not_found` where no listener has the
# name, and as `connect` does.
#
# See also `listen_pipe`.
function connect_pipe(name: str, within_ms: i64) -> io.Stream?
    return channels.connect(name, space: hero_ipc.HERO_IPC_SPACE_PIPE, within_ms: within_ms)

# Closes `l` and empties the place, so every later call through it fails
# `closed`; an `accept` another thread waits in ends within about 50 ms,
# failing `closed`. A listener's socket file is removed where it is still the
# one `listen` made, as Go's listener does.
#
# - `l`: the listener, emptied.
#
# Fails `closed` where it is closed already.
#
# See also `listen`.
function close_listener(@l: Listener) -> ()?
    return channels.close(
        @l.handle,
        where: channels.listener_label(l.name, abstract: l.space == .abstract, pipe: l.space == .pipe)
    )

# Makes every later and waiting read and write of the channel `s` end by
# `deadline_ms` milliseconds from now, failing `timeout`: a time, not a span.
#
# - `s`: a stream `accept` or a `connect` answered.
# - `deadline_ms`: milliseconds from now, 0 taking the deadline away.
#
# Fails `invalid` where `deadline_ms` is below 0 or `s` is no channel of this
# package, `closed` where `s` is closed.
#
# See also `accept`, `connect`.
function set_deadline(s: io.Stream, deadline_ms: i64) -> ()?
    return channels.set_deadline(s, ms: deadline_ms)

# Closes the writing side of the channel `s`, so its peer reads its end once
# the bytes written are read, while `s` still reads what the peer writes.
#
# - `s`: a stream `accept` or a `connect` answered.
#
# Fails `unsupported` for a named pipe, which has no half, `closed` where `s`
# or its peer is closed, `invalid` for a stream of another package.
#
# See also `io.close`.
function close_write(s: io.Stream) -> ()?
    return channels.close_write(s)

# Who is at the other end of a channel, as the system told it when the
# connection was made.
record Peer
    # The process's id.
    pid: i64
    # The id of the user the process runs as; -1 on Windows, which numbers
    # no user so.
    uid: i64

# Who is at the other end of the channel `s`.
#
# - `s`: a stream `accept` or a `connect` answered.
#
# Fails `invalid` for a stream of another package, `closed` where `s` is
# closed, `unsupported` on a POSIX system other than Linux and macOS.
#
# See also `accept`.
function peer_of(s: io.Stream) -> Peer?
    ends = channels.peer(s)?
    return ok(Peer(pid: ends.pid, uid: ends.uid))

## Messages

# Writes `data` to `s` as one message, its length before it, so the reader
# reads it whole with `read_message`: the length in 4 bytes, big-endian, or
# for one past 2,147,483,647 bytes the 4 bytes 0xff and the length in 8, as
# Python's `multiprocessing.connection` writes `send_bytes`, so either reads
# the other's.
#
# - `s`: the stream, a channel or any other; two threads writing messages to
#   one stream at once may mix them.
# - `data`: the message, empty or not.
#
# Fails as `io.write` fails, with its code.
#
# See also `read_message`.
function write_message(s: io.Stream, data: [u8]) -> ()?
    return messages.write(s, data: data)

# The next message `write_message` wrote to the other end of `s`, whole.
#
# - `s`: the stream.
# - `most`: the longest message taken, in bytes, 0 or more; a longer one is
#   refused before its bytes are read, and `s` then stands inside it, so it
#   is closed rather than read again.
#
# Fails `invalid` for a message longer than `most` or a length no message
# has, `closed` where `s` ends before a whole message, and as `io.read_exact`
# fails, with its code.
#
# See also `write_message`.
function read_message(s: io.Stream, most: i64) -> [u8]?
    return messages.read(s, most: most)

## Shared memory

# Memory shared by name, mapped into this process, which `create_memory` and
# `open_memory` answer and `close_memory` closes. It holds a handle: every
# copy reaches the same memory. No address of it ever reaches the program,
# which reads and writes copies.
record Memory
    # The floor's handle, `nullptr` once `close_memory` has emptied this
    # place.
    handle: hero_ipc.Memory
    # Its name.
    name: str
    # Its size in bytes, as the system holds it.
    size: i64

# New memory named `name`, every byte zero, mapped into this process.
#
# - `name`: a name by `is_name`'s rule, which no memory has yet.
# - `size`: at least this many bytes, 1 or more. The memory's size is what
#   the system holds: `size` on Linux, `size` rounded up to the page on
#   macOS (16 KB), both measured, and on Windows to its page (unrun). On
#   Linux its pages are reserved at once, so a machine with no room fails
#   here, `limit`, and never at a write.
# - `permission`: the nine bits of POSIX, 0 to 0o777, less the process's
#   mask; 0o600 lets only this user open it. Windows ignores it.
#
# Fails `exists` where the name is taken, `invalid` for a name outside the
# rule, a size below 1 or a permission out of range, `limit` where the
# machine has no room.
#
# See also `open_memory`, `read_at`, `remove_memory`.
function create_memory(name: str, size: i64, permission: i64) -> Memory?
    made = shared.create(name, size: size, permission: permission)?
    return ok(Memory(handle: made.handle, name: name, size: made.size))

# The memory named `name`, made by this or any process, mapped into this one.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `not_found` where no memory has the name or its maker has not sized
# it yet, `permission` where its permission refuses this user.
#
# See also `create_memory`.
function open_memory(name: str) -> Memory?
    made = shared.open(name)?
    return ok(Memory(handle: made.handle, name: name, size: made.size))

# A copy of `count` bytes of `m` from `offset`.
#
# - `m`: the memory.
# - `offset`: the first byte's place, 0 to `m.size`.
# - `count`: how many bytes, 0 to `m.size - offset`.
#
# What another process writes meanwhile may be read half old and half new:
# a lock or a semaphore orders the two.
#
# Fails `invalid` where any byte asked stands outside the memory, before a
# byte is read, `closed` where `m` is closed.
#
# See also `write_at`, `load_at`.
function read_at(m: Memory, offset: i64, count: i64) -> [u8]?
    return shared.read_at(m.handle, name: m.name, size: m.size, offset: offset, count: count)

# Copies `data` into `m` at `offset`.
#
# - `m`: the memory, written for every process that has it.
# - `offset`: the first byte's place, 0 to `m.size`.
# - `data`: the bytes, which must all stand inside the memory.
#
# Fails `invalid` where any byte would stand outside the memory, before a
# byte is written, `closed` where `m` is closed.
#
# See also `read_at`, `store_at`.
function write_at(m: Memory, offset: i64, data: [u8]) -> ()?
    return shared.write_at(m.handle, name: m.name, size: m.size, offset: offset, data: data)

# The `i64` at `offset` of `m`, read whole by one instruction every process
# sees whole, with no lock.
#
# - `m`: the memory.
# - `offset`: a multiple of 8, from 0 to `m.size - 8`.
#
# The word is the machine's own byte order, little-endian on every platform
# Heroes runs on.
#
# Fails `invalid` for an offset that is no multiple of 8 or not inside,
# `closed` where `m` is closed.
#
# See also `store_at`, `add_at`, `swap_at`.
function load_at(m: Memory, offset: i64) -> i64?
    return shared.load_at(m.handle, name: m.name, size: m.size, offset: offset)

# Makes the `i64` at `offset` of `m` `value`, written whole as `load_at`
# reads one.
#
# - `m`: the memory.
# - `offset`: a multiple of 8, from 0 to `m.size - 8`.
# - `value`: the word.
#
# Fails as `load_at` does.
#
# See also `load_at`.
function store_at(m: Memory, offset: i64, value: i64) -> ()?
    return shared.store_at(m.handle, name: m.name, size: m.size, offset: offset, value: value)

# Adds `delta` to the `i64` at `offset` of `m` in one step no other process
# divides, and answers the sum.
#
# - `m`: the memory.
# - `offset`: a multiple of 8, from 0 to `m.size - 8`.
# - `delta`: what is added, negative to take away.
#
# The sum wraps at 64 bits, past the largest `i64` to the smallest, since no
# process can stop another's sum: the one place in Rebel where a number
# wraps.
#
# Fails as `load_at` does.
#
# See also `swap_at`, `load_at`.
function add_at(m: Memory, offset: i64, delta: i64) -> i64?
    return shared.add_at(m.handle, name: m.name, size: m.size, offset: offset, delta: delta)

# Makes the `i64` at `offset` of `m` `desired` where it is `expected`, in one
# step no other process divides, and answers the word it found: the swap was
# made where that is `expected`.
#
# - `m`: the memory.
# - `offset`: a multiple of 8, from 0 to `m.size - 8`.
# - `expected`: the word the swap needs.
# - `desired`: the word written where the swap is made.
#
# Fails as `load_at` does.
#
# See also `add_at`.
function swap_at(m: Memory, offset: i64, expected: i64, desired: i64) -> i64?
    return shared.swap_at(m.handle, name: m.name, size: m.size, offset: offset, expected: expected, desired: desired)

# Unmaps `m` from this process and empties the place, so every later call
# through it fails `closed`. The memory stays for every other process that
# has it, and on POSIX for every later `open_memory`, until `remove_memory`.
#
# - `m`: the memory, emptied.
#
# Fails `closed` where it is closed already.
#
# See also `remove_memory`.
function close_memory(@m: Memory) -> ()?
    return shared.close(@m.handle, name: m.name)

# Takes the name `name` from its memory, so no later `open_memory` finds it
# and `create_memory` may take it again; who has it open keeps it until they
# close it. On Windows the system takes a name away with the last process
# that has it open, so this checks that memory of the name is open and
# changes nothing, and after the last close it fails `not_found`. Called
# while this process still has the memory open, it answers the same on every
# platform, which is the order the examples keep.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `not_found` where no memory has the name, `invalid` for a name
# outside the rule.
#
# See also `close_memory`.
function remove_memory(name: str) -> ()?
    return shared.remove(name)

## Semaphores

# A semaphore shared by name: a count that `release_semaphore` raises and
# `acquire_semaphore` lowers, waiting while it is 0. `create_semaphore` and
# `open_semaphore` answer one and `close_semaphore` closes it; every copy
# reaches the same semaphore.
record Semaphore
    # The floor's handle, `nullptr` once `close_semaphore` has emptied this
    # place.
    handle: hero_ipc.Semaphore
    # Its name.
    name: str

# A new semaphore named `name`, counting `count`.
#
# - `name`: a name by `is_name`'s rule, which no semaphore has yet.
# - `count`: the count it starts at, 0 to 32,767 (macOS's most).
# - `permission`: as for `create_memory`.
#
# Fails `exists` where the name is taken, `invalid` for a name outside the
# rule or a count or permission out of range.
#
# See also `open_semaphore`, `acquire_semaphore`.
function create_semaphore(name: str, count: i64, permission: i64) -> Semaphore?
    handle = waits.create_semaphore(name, count: count, permission: permission)?
    return ok(Semaphore(handle: handle, name: name))

# The semaphore named `name`, made by this or any process.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `not_found` where none has the name, `permission` where its
# permission refuses this user.
#
# See also `create_semaphore`.
function open_semaphore(name: str) -> Semaphore?
    handle = waits.open_semaphore(name)?
    return ok(Semaphore(handle: handle, name: name))

# Takes one from the count of `s`, waiting while it is 0.
#
# - `s`: the semaphore.
# - `within_ms`: the milliseconds to wait, 0 to try once, `FOREVER` for no
#   bound.
#
# On macOS, which has no wait with a bound on a semaphore, the wait tries
# again in steps growing from 0.1 ms to 2 ms: a release is seen within about
# 3 ms, and a wait costs under 1% of a core while it lasts (measured
# 2026-11-17); Linux and Windows wait on the system's own.
#
# Fails `timeout` past the bound, `stopped` where the program is asked to
# stop, `closed` where `s` is closed, `invalid` for a negative bound that is
# not `FOREVER`.
#
# See also `release_semaphore`.
function acquire_semaphore(s: Semaphore, within_ms: i64) -> ()?
    return waits.acquire_semaphore(s.handle, name: s.name, within_ms: within_ms)

# Adds one to the count of `s`, letting one waiter through.
#
# - `s`: the semaphore.
#
# Fails `limit` past the platform's most where it tells one: 2,147,483,647
# on Linux (measured) and Windows (its reference; unrun), while macOS takes
# a release past its 32,767 and says nothing (measured). Fails `closed`
# where `s` is closed.
#
# See also `acquire_semaphore`.
function release_semaphore(s: Semaphore) -> ()?
    return waits.release_semaphore(s.handle, name: s.name)

# Closes `s` in this process and empties the place; the semaphore stays as
# `close_memory` says memory stays.
#
# - `s`: the semaphore, emptied.
#
# Fails `closed` where it is closed already.
#
# See also `remove_semaphore`.
function close_semaphore(@s: Semaphore) -> ()?
    return waits.close_semaphore(@s.handle, name: s.name)

# Takes the name `name` from its semaphore, as `remove_memory` does for
# memory, Windows' rule the same.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `not_found` where none has the name, `invalid` for a name outside the
# rule.
#
# See also `close_semaphore`.
function remove_semaphore(name: str) -> ()?
    return waits.remove_semaphore(name)

## Locks

# A lock shared by name, held by one thread of one process at a time, which
# `open_lock` answers and `close_lock` closes; every copy reaches the same
# lock. When the process holding it ends, however it ends, the system
# releases it and the next holder is told (`Acquired`).
record Lock
    # The floor's handle, `nullptr` once `close_lock` has emptied this place.
    handle: hero_ipc.Lock
    # Its name.
    name: str

# How `acquire_lock` took a lock.
variant Acquired
    # From no holder, or from one that released it.
    clean
    # From a holder that ended without releasing it: its process was killed
    # or ended holding it, or on Windows its thread ended. What the lock
    # guarded may be half done.
    abandoned

# The lock named `name`, made where no process has it yet.
#
# - `name`: a name by `is_name`'s rule.
# - `permission`: as for `create_memory`, given to the lock where this call
#   makes it.
#
# On POSIX a lock is the file `/tmp/heroes-lock-<name>`, locked whole; on
# Windows a mutex.
#
# Fails `invalid` for a name outside the rule or a permission out of range,
# `permission` where the lock's file is another user's, no regular file, or
# a file with another name besides.
#
# See also `acquire_lock`, `remove_lock`.
function open_lock(name: str, permission: i64) -> Lock?
    handle = waits.open_lock(name, permission: permission)?
    return ok(Lock(handle: handle, name: name))

# Takes `l` for the calling thread, waiting while another holds it, and
# answers how.
#
# - `l`: the lock.
# - `within_ms`: the milliseconds to wait, 0 to try once, `FOREVER` for no
#   bound.
#
# On POSIX the wait tries again in steps growing from 0.1 ms to 2 ms, the
# system's lock taking no bound: a release is seen within about 3 ms
# (measured 2026-11-17). On Windows it waits on the mutex.
#
# Fails `timeout` past the bound, `invalid` where the calling thread holds
# it already through this or another `Lock` (it would wait for itself) or
# for a negative bound that is not `FOREVER`, `stopped` where the program is
# asked to stop, `closed` where `l` is closed.
#
# See also `release_lock`.
function acquire_lock(l: Lock, within_ms: i64) -> Acquired?
    if waits.acquire_lock(l.handle, name: l.name, within_ms: within_ms)?
        return ok(.abandoned)
    return ok(.clean)

# Releases `l`, held by the calling thread.
#
# - `l`: the lock.
#
# Fails `invalid` where the calling thread does not hold it, `closed` where
# `l` is closed.
#
# See also `acquire_lock`.
function release_lock(l: Lock) -> ()?
    return waits.release_lock(l.handle, name: l.name)

# Closes `l` in this process and empties the place, releasing it first where
# the calling thread holds it. Closed while another thread of this process
# holds it, it is released on POSIX and the next holder is told
# `abandoned`; on Windows it stays that thread's until it releases it or
# ends.
#
# - `l`: the lock, emptied.
#
# Fails `closed` where it is closed already.
#
# See also `remove_lock`.
function close_lock(@l: Lock) -> ()?
    return waits.close_lock(@l.handle, name: l.name)

# Takes the name `name` from its lock: on POSIX its file is removed, so a
# process that opens the name later has another lock than one that has it
# open; remove a lock once no process uses it. On Windows as
# `remove_memory`.
#
# - `name`: a name by `is_name`'s rule.
#
# Fails `not_found` where there is none, `invalid` for a name outside the
# rule.
#
# See also `close_lock`.
function remove_lock(name: str) -> ()?
    return waits.remove_lock(name)

## Tests

test "two processes: a child connects to a listener, and a message goes there and back"
    if across.is_child()
        code = across.child()
        exit(code: code)
    path = f"build/ipc-two-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    child @= across.start("echo", words: [path]).must()
    s @= accept(l, within_ms: 20000).must()
    assert write_message(s, data: [104, 105]) == ok()
    assert read_message(s, most: 100).must() == [104, 105, 33]
    assert peer_of(s).must().pid != os.pid()
    assert io.read_all(s).must() == []
    assert io.close(@s) == ok()
    assert process.is_success(process.wait(@child).must())
    assert close_listener(@l) == ok()

test "two processes: bytes a child writes are read here, and a thousand sums of each side are all kept"
    if across.is_child()
        code = across.child()
        exit(code: code)
    name = f"ix-two-{os.pid()}"
    m @= create_memory(name, size: 64, permission: 0o600).must()
    child @= across.start("memory", words: [name]).must()

    for _ in range(from: 0, to: 1000)
        _ = add_at(m, offset: 8, delta: 1).must()

    assert process.is_success(process.wait(@child).must())
    assert read_at(m, offset: 0, count: 3).must() == [1, 2, 3]
    assert load_at(m, offset: 8).must() == 2000
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

test "two processes: a lock a child holds is waited on with a bound and timed out, then taken clean once the child releases it"
    if across.is_child()
        code = across.child()
        exit(code: code)
    lock_name = f"ix-hl-{os.pid()}"
    ready_name = f"ix-hr-{os.pid()}"
    go_name = f"ix-hg-{os.pid()}"
    ready @= create_semaphore(ready_name, count: 0, permission: 0o600).must()
    go @= create_semaphore(go_name, count: 0, permission: 0o600).must()
    l @= open_lock(lock_name, permission: 0o600).must()
    child @= across.start("hold", words: [lock_name, ready_name, go_name]).must()
    assert acquire_semaphore(ready, within_ms: 20000) == ok()

    match acquire_lock(l, within_ms: 100)
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

    assert release_semaphore(go) == ok()
    assert acquire_lock(l, within_ms: 20000).must() == .clean
    assert release_lock(l) == ok()
    assert process.is_success(process.wait(@child).must())
    assert remove_lock(lock_name) == ok()
    assert remove_semaphore(go_name) == ok()
    assert remove_semaphore(ready_name) == ok()
    assert close_lock(@l) == ok()
    assert close_semaphore(@go) == ok()
    assert close_semaphore(@ready) == ok()

test "two processes: a child killed while it holds a lock leaves it to the next holder, told abandoned, and the take after is clean"
    if across.is_child()
        code = across.child()
        exit(code: code)
    lock_name = f"ix-kl-{os.pid()}"
    ready_name = f"ix-kr-{os.pid()}"
    go_name = f"ix-kg-{os.pid()}"
    ready @= create_semaphore(ready_name, count: 0, permission: 0o600).must()
    go @= create_semaphore(go_name, count: 0, permission: 0o600).must()
    l @= open_lock(lock_name, permission: 0o600).must()
    child @= across.start("hold", words: [lock_name, ready_name, go_name]).must()
    assert acquire_semaphore(ready, within_ms: 20000) == ok()
    assert process.kill(child) == ok()
    assert !process.is_success(process.wait(@child).must())
    assert acquire_lock(l, within_ms: 5000).must() == .abandoned
    assert release_lock(l) == ok()
    assert acquire_lock(l, within_ms: 0).must() == .clean
    assert remove_lock(lock_name) == ok()
    assert remove_semaphore(go_name) == ok()
    assert remove_semaphore(ready_name) == ok()
    assert close_lock(@l) == ok()
    assert close_semaphore(@go) == ok()
    assert close_semaphore(@ready) == ok()

test "two threads of one process: a lock one holds is refused to the other until it is released"
    name = f"ix-th-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(l, within_ms: 0).must() == .clean
    assert across.try_from_another_thread(name) == "refused"
    assert release_lock(l) == ok()
    assert across.try_from_another_thread(name) == "taken"
    assert remove_lock(name) == ok()
    assert close_lock(@l) == ok()

# The face's two rules for a name whose last handle is closed, held on each
# platform: POSIX keeps it for every later open until its `remove_`, Windows
# takes it away with the last handle (the box's run of 2026-11-18 found every
# other test asserting POSIX's rule alone).
test "remove_memory, remove_semaphore and remove_lock after the last close: kept until removed on POSIX, gone with the handle on Windows"
    memory_name = f"ix-am-{os.pid()}"
    m @= create_memory(memory_name, size: 8, permission: 0o600).must()
    assert write_at(m, offset: 0, data: [7]) == ok()
    assert close_memory(@m) == ok()
    semaphore_name = f"ix-as-{os.pid()}"
    s @= create_semaphore(semaphore_name, count: 1, permission: 0o600).must()
    assert close_semaphore(@s) == ok()
    lock_name = f"ix-al-{os.pid()}"
    l @= open_lock(lock_name, permission: 0o600).must()
    assert close_lock(@l) == ok()

    if os.system() == .windows
        match open_memory(memory_name)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND

        match remove_memory(memory_name)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND

        match open_semaphore(semaphore_name)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND

        match remove_semaphore(semaphore_name)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND

        match remove_lock(lock_name)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND
    else
        again @= open_memory(memory_name).must()
        assert read_at(again, offset: 0, count: 1).must() == [7]
        assert close_memory(@again) == ok()
        assert remove_memory(memory_name) == ok()
        opened @= open_semaphore(semaphore_name).must()
        assert acquire_semaphore(opened, within_ms: 0) == ok()
        assert close_semaphore(@opened) == ok()
        assert remove_semaphore(semaphore_name) == ok()
        assert remove_lock(lock_name) == ok()

# Defect 2609: a connect to a path where no socket stands is told by what
# stands there, on every platform: a folder is `is_a_directory`, its message
# saying so, where Darwin answered `failed` and Linux and Windows `not_found`
# as for a socket file nothing listens on. A file is `invalid`, the words
# `failure`'s own test holds; the floor's test asks each shape of the disk.
test "connect: a folder at the path is is_a_directory, told what is there, on every platform (defect 2609)"
    match connect(".", within_ms: 0)
        .ok _ => assert false
        .err e =>
            assert e.code == IS_A_DIRECTORY
            assert e.msg == "connecting to \".\": a folder is there, where a listener's socket file would be"

## Examples

# A name of shared memory, and one with a slash, which no name holds.
test "is_name: a name, and one with a slash"
    assert is_name("jobs.queue-1")
    assert !is_name("a/b")

# A listener on a socket file only this user may connect to, closed again,
# which removes the file.
test "listen: a socket file, then closed"
    l @= listen(f"build/example-listen-{os.pid()}.sock", permission: 0o600).must()
    assert l.space == .path
    assert close_listener(@l) == ok()

# A listener on Linux's abstract space; every other platform answers
# `unsupported`.
test "listen_abstract: an abstract name on Linux, unsupported elsewhere"
    match listen_abstract(f"example-{os.pid()}")
        .ok made =>
            l @= made
            assert close_listener(@l) == ok()
        .err e => assert e.code == UNSUPPORTED

# A listener on a Windows named pipe; every other platform answers
# `unsupported`.
test "listen_pipe: a named pipe on Windows, unsupported elsewhere"
    match listen_pipe(f"example-{os.pid()}")
        .ok made =>
            l @= made
            assert close_listener(@l) == ok()
        .err e => assert e.code == UNSUPPORTED

# A connection accepted, and an accept with nobody connecting that gives up
# at its bound.
test "accept: a connection, then a bound of 10 ms passed"
    path = f"build/example-accept-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    client @= connect(path, within_ms: 1000).must()
    server @= accept(l, within_ms: 1000).must()

    match accept(l, within_ms: 10)
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

    assert io.close(@client) == ok()
    assert io.close(@server) == ok()
    assert close_listener(@l) == ok()

# A connection read and written with `io`, and one to a path nothing is at.
test "connect: bytes through a channel, and nothing at the path"
    path = f"build/example-connect-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    client @= connect(path, within_ms: 1000).must()
    server @= accept(l, within_ms: 1000).must()
    assert io.write_text(client, text: "ping") == ok()
    assert io.read_exact(server, n: 4).must() == [112, 105, 110, 103]
    assert io.close(@client) == ok()
    assert io.close(@server) == ok()
    assert close_listener(@l) == ok()

    match connect(path, within_ms: 0)
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

# A connection to an abstract name on Linux; every other platform answers
# `unsupported`.
test "connect_abstract: on Linux, unsupported elsewhere"
    match connect_abstract(f"example-none-{os.pid()}", within_ms: 0)
        .ok _  => assert false
        .err e => assert e.code == CLOSED || e.code == UNSUPPORTED

# A connection to a Windows named pipe; every other platform answers
# `unsupported`.
test "connect_pipe: on Windows, unsupported elsewhere"
    match connect_pipe(f"example-none-{os.pid()}", within_ms: 0)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND || e.code == UNSUPPORTED

# A listener closed: its place is emptied, and a second close is told.
test "close_listener: once, then closed already"
    l @= listen(f"build/example-close-{os.pid()}.sock", permission: 0o600).must()
    assert close_listener(@l) == ok()

    match close_listener(@l)
        .ok _  => assert false
        .err e => assert e.code == CLOSED

# A read that waits past the channel's deadline fails `timeout`.
test "set_deadline: a read past 20 ms"
    path = f"build/example-deadline-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    client @= connect(path, within_ms: 1000).must()
    server @= accept(l, within_ms: 1000).must()
    assert set_deadline(server, deadline_ms: 20) == ok()

    match io.read(server, n: 1)
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

    assert io.close(@client) == ok()
    assert io.close(@server) == ok()
    assert close_listener(@l) == ok()

# One side says it has written all it will, and the other reads its end.
test "close_write: the peer reads its end"
    path = f"build/example-half-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    client @= connect(path, within_ms: 1000).must()
    server @= accept(l, within_ms: 1000).must()
    assert io.write_text(client, text: "last") == ok()
    assert close_write(client) == ok()
    assert io.read_all_text(server).must() == "last"
    assert io.close(@client) == ok()
    assert io.close(@server) == ok()
    assert close_listener(@l) == ok()

# Who connected: here this same process.
test "peer_of: the process at the other end"
    path = f"build/example-peer-{os.pid()}.sock"
    l @= listen(path, permission: 0o600).must()
    client @= connect(path, within_ms: 1000).must()
    server @= accept(l, within_ms: 1000).must()
    assert peer_of(server).must().pid == os.pid()
    assert io.close(@client) == ok()
    assert io.close(@server) == ok()
    assert close_listener(@l) == ok()

# A message written whole, and the bytes it is on the wire: its length first.
test "write_message: the length, then the bytes"
    p = io.pipe().must()
    reader @= p.reader
    writer @= p.writer
    assert write_message(writer, data: [97, 98, 99]) == ok()
    assert io.read_exact(reader, n: 7).must() == [0, 0, 0, 3, 97, 98, 99]
    assert io.close(@writer) == ok()
    assert io.close(@reader) == ok()

# Two messages read back whole, and one past the most refused.
test "read_message: whole messages, and one past its most"
    p = io.pipe().must()
    reader @= p.reader
    writer @= p.writer
    assert write_message(writer, data: [1]) == ok()
    assert write_message(writer, data: [1, 2, 3]) == ok()
    assert read_message(reader, most: 8).must() == [1]

    match read_message(reader, most: 2)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert io.close(@writer) == ok()
    assert io.close(@reader) == ok()

# Memory made, its size at least the one asked, and its name taken away.
test "create_memory: made, sized, removed"
    name = f"ix-ec-{os.pid()}"
    m @= create_memory(name, size: 100, permission: 0o600).must()
    assert m.size >= 100
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# Memory opened by its name sees what its maker wrote.
test "open_memory: a second mapping of the same bytes"
    name = f"ix-eo-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert write_at(m, offset: 0, data: [42]) == ok()
    o @= open_memory(name).must()
    assert read_at(o, offset: 0, count: 1).must() == [42]
    assert remove_memory(name) == ok()
    assert close_memory(@o) == ok()
    assert close_memory(@m) == ok()

# Bytes read back, and a read past the end refused.
test "read_at: three bytes, and one past the end"
    name = f"ix-er-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert write_at(m, offset: 4, data: [7, 8, 9]) == ok()
    assert read_at(m, offset: 4, count: 3).must() == [7, 8, 9]

    match read_at(m, offset: m.size, count: 1)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# Bytes written at an offset, and a write that would pass the end refused
# before a byte moves.
test "write_at: at an offset, and past the end"
    name = f"ix-ew-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert write_at(m, offset: 1, data: [5]) == ok()
    assert read_at(m, offset: 0, count: 2).must() == [0, 5]
    assert write_at(m, offset: m.size - 1, data: [1, 2]).is_err()
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# A word read whole, 0 in new memory, and an offset no multiple of 8.
test "load_at: a new word is 0, and an offset of 4 refused"
    name = f"ix-el-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert load_at(m, offset: 8).must() == 0
    assert load_at(m, offset: 4).is_err()
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# A word written whole and read back.
test "store_at: written and read back"
    name = f"ix-es-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert store_at(m, offset: 0, value: -5) == ok()
    assert load_at(m, offset: 0).must() == -5
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# A counter raised and lowered, and the wrap past the largest `i64`.
test "add_at: up, down, and the wrap"
    name = f"ix-ea-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert add_at(m, offset: 0, delta: 5).must() == 5
    assert add_at(m, offset: 0, delta: -2).must() == 3
    assert store_at(m, offset: 8, value: 9223372036854775807) == ok()
    assert add_at(m, offset: 8, delta: 1).must() == -9223372036854775807 - 1
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# A swap made where the word is the one expected, and not made where it is
# not, the word found answered either way.
test "swap_at: made, then not made"
    name = f"ix-ex-{os.pid()}"
    m @= create_memory(name, size: 16, permission: 0o600).must()
    assert swap_at(m, offset: 0, expected: 0, desired: 1).must() == 0
    assert swap_at(m, offset: 0, expected: 0, desired: 2).must() == 1
    assert load_at(m, offset: 0).must() == 1
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

# Memory closed, then closed again, which is told.
test "close_memory: once, then closed already"
    name = f"ix-ek-{os.pid()}"
    m @= create_memory(name, size: 8, permission: 0o600).must()
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()
    assert close_memory(@m).is_err()

# A name taken away: opening it finds nothing, and removing it again is told.
test "remove_memory: then nothing to open"
    name = f"ix-ed-{os.pid()}"
    m @= create_memory(name, size: 8, permission: 0o600).must()
    assert remove_memory(name) == ok()
    assert close_memory(@m) == ok()

    match open_memory(name)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    match remove_memory(name)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

# A semaphore counting 2: two takes pass, the third gives up at once.
test "create_semaphore: a count of 2"
    name = f"ix-sc-{os.pid()}"
    s @= create_semaphore(name, count: 2, permission: 0o600).must()
    assert acquire_semaphore(s, within_ms: 0) == ok()
    assert acquire_semaphore(s, within_ms: 0) == ok()
    assert acquire_semaphore(s, within_ms: 0).is_err()
    assert remove_semaphore(name) == ok()
    assert close_semaphore(@s) == ok()

# A semaphore opened by its name counts with its maker's.
test "open_semaphore: one count seen through two handles"
    name = f"ix-so-{os.pid()}"
    s @= create_semaphore(name, count: 1, permission: 0o600).must()
    o @= open_semaphore(name).must()
    assert acquire_semaphore(o, within_ms: 0) == ok()
    assert acquire_semaphore(s, within_ms: 0).is_err()
    assert remove_semaphore(name) == ok()
    assert close_semaphore(@o) == ok()
    assert close_semaphore(@s) == ok()

# A take that waits 20 ms on a count of 0 gives up with `timeout`.
test "acquire_semaphore: a bound passed"
    name = f"ix-sa-{os.pid()}"
    s @= create_semaphore(name, count: 0, permission: 0o600).must()

    match acquire_semaphore(s, within_ms: 20)
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

    assert remove_semaphore(name) == ok()
    assert close_semaphore(@s) == ok()

# One given back, one taken.
test "release_semaphore: then a take passes"
    name = f"ix-sr-{os.pid()}"
    s @= create_semaphore(name, count: 0, permission: 0o600).must()
    assert release_semaphore(s) == ok()
    assert acquire_semaphore(s, within_ms: 0) == ok()
    assert remove_semaphore(name) == ok()
    assert close_semaphore(@s) == ok()

# A semaphore closed, then closed again, which is told.
test "close_semaphore: once, then closed already"
    name = f"ix-sk-{os.pid()}"
    s @= create_semaphore(name, count: 0, permission: 0o600).must()
    assert remove_semaphore(name) == ok()
    assert close_semaphore(@s) == ok()
    assert close_semaphore(@s).is_err()

# A semaphore's name taken away: opening it finds nothing.
test "remove_semaphore: then nothing to open"
    name = f"ix-sd-{os.pid()}"
    s @= create_semaphore(name, count: 0, permission: 0o600).must()
    assert remove_semaphore(name) == ok()
    assert close_semaphore(@s) == ok()
    assert open_semaphore(name).is_err()

# A lock opened, taken clean and released.
test "open_lock: opened, taken, released"
    name = f"ix-lo-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(l, within_ms: 0).must() == .clean
    assert release_lock(l) == ok()
    assert remove_lock(name) == ok()
    assert close_lock(@l) == ok()

# A thread that holds a lock asking it again is refused at once rather than
# waiting for itself.
test "acquire_lock: taken, then asked again by its holder"
    name = f"ix-la-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(l, within_ms: FOREVER).must() == .clean

    match acquire_lock(l, within_ms: 10)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert release_lock(l) == ok()
    assert remove_lock(name) == ok()
    assert close_lock(@l) == ok()

# A release by a thread that does not hold the lock is refused.
test "release_lock: held, then not held"
    name = f"ix-lr-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(l, within_ms: 0).must() == .clean
    assert release_lock(l) == ok()

    match release_lock(l)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert remove_lock(name) == ok()
    assert close_lock(@l) == ok()

# A lock closed while held is released, so the next take is clean.
test "close_lock: held, closed, taken clean again"
    name = f"ix-lk-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(l, within_ms: 0).must() == .clean
    assert close_lock(@l) == ok()
    again @= open_lock(name, permission: 0o600).must()
    assert acquire_lock(again, within_ms: 0).must() == .clean
    assert remove_lock(name) == ok()
    assert close_lock(@again) == ok()

# A lock's name taken away, and taken away again, which is told.
test "remove_lock: once, then not found"
    name = f"ix-ld-{os.pid()}"
    l @= open_lock(name, permission: 0o600).must()
    assert remove_lock(name) == ok()
    assert close_lock(@l) == ok()

    match remove_lock(name)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND
