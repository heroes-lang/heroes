  rust    Ipv4Addr::new, Ipv6Addr::new, Ipv4Addr::octets, Ipv6Addr::octets, Ipv4Addr::as_octets, Ipv6Addr::as_octets, IpAddr::as_octets, Ipv4Addr::from_octets, Ipv6Addr::from_octets, Ipv6Addr::segments, Ipv6Addr::from_segments
