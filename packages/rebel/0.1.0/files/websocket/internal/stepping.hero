# One frame taken from what a connection holds, as RFC 6455 § 5 and § 7 and
# RFC 7692 § 6 ask: every rule a frame breaks fails the connection with its
# close code before its payload is read, a ping is answered, a pong counted,
# a close answered and the stream ended, and data joined into its message or
# handed out as a part.

use bytes
use io
use net
use websocket/internal/deflating
use websocket/internal/engine
use websocket/internal/frames
use websocket/internal/handmade
use websocket/internal/utf8

# What one step found.
variant Step
    # Data to hand out: a message whole, or a part.
    data
        # Whether it is a text's.
        text: bool
        # The bytes, decompressed.
        data: [u8]
        # Whether it ends its message.
        last: bool
    # A frame taken that hands nothing out: a control frame, or a part of a
    # message still being joined.
    nothing
    # The closing handshake ended, and the stream with it.
    ended
    # The bytes held end before the next frame does.
    more

# Takes the next frame of `s`'s inbox.
#
# - `stream`, `s`: the connection.
# - `b`: its bounds.
# - `parts`: whether data is handed out frame by frame (`read_part`), else
#   joined into whole messages.
# - `waits`: whether a client, the closing handshake ended, waits for the
#   server to end the stream, as RFC 6455 § 7.1.1 asks.
#
# Fails, the connection failed first, `invalid` (1002), `not_text` (1007)
# and `limit` (1009); `invalid` alone, the connection left as it is, where
# `parts` is not what began the message; and as writing a pong or a close
# fails.
function step(@stream: io.Stream, @s: engine.State, b: engine.Bounds, parts: bool, waits: bool) -> Step?
    h = match frames.head_at(s.inbox, at: s.at)
        .more    => return ok(.more)
        .wrong w => return engine.failing(@stream, @s, close: 1002, code: engine.INVALID, msg: w.why)
        .head f  => f.h

    op = h.opcode
    control = op >= 8

    if h.rsv & 3 != 0
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: f"a frame with the reserved bits {h.rsv}, which no extension agreed"
        )
    compressed_bit = h.rsv & 4 != 0

    if compressed_bit && (!s.deflating.agreed.on || op != frames.TEXT && op != frames.BINARY)
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: f"a frame of opcode {op} with RSV1 set, which only the first frame of a compressed message may set"
        )

    if op > 2 && op < 8 || op > 10
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: f"a frame of opcode {op}, which RFC 6455 reserves"
        )

    if control && !h.fin
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: f"a control frame of opcode {op} fragmented"
        )

    if control && h.length > 125
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: f"a control frame of {h.length} bytes, past 125"
        )

    if s.client && h.masked
        return engine.failing(@stream, @s, close: 1002, code: engine.INVALID, msg: "a frame from the server masked")

    if !s.client && !h.masked
        return engine.failing(@stream, @s, close: 1002, code: engine.INVALID, msg: "a frame from the client unmasked")

    if !control && h.length > b.frame_bytes
        return engine.failing(
            @stream,
            @s,
            close: 1009,
            code: engine.LIMIT,
            msg: f"a frame of {h.length} bytes, past the {b.frame_bytes} a frame may hold"
        )

    if op == frames.CONTINUATION && !s.reading
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: "a continuation frame with no message begun"
        )

    if (op == frames.TEXT || op == frames.BINARY) && s.reading
        return engine.failing(
            @stream,
            @s,
            close: 1002,
            code: engine.INVALID,
            msg: "a message begun before the one before it ended"
        )

    if op == frames.CONTINUATION && s.by_parts != parts
        return fail(
            code: engine.INVALID,
            msg: "a message begun by one of `read_part` and `read_message` read on by the other"
        )
    compressed = op == frames.CONTINUATION && s.reading_compressed || compressed_bit

    if !control && !parts && !compressed && s.joined.len() + h.length > b.message_bytes
        return engine.failing(
            @stream,
            @s,
            close: 1009,
            code: engine.LIMIT,
            msg: f"a message past the {b.message_bytes} bytes it may hold"
        )

    if s.inbox.len() - s.at < h.size + h.length
        return ok(.more)
    begin = s.at + h.size
    payload = frames.payload_of(data: s.inbox, from: begin, to: begin + h.length, key: h.key)
    s.at @ begin + h.length

    if op == frames.PING
        if !s.close_sent
            engine.send(@stream, @s, opcode: frames.PONG, fin: true, rsv1: false, payload: payload)?
        return ok(.nothing)

    if op == frames.PONG
        s.pongs @ s.pongs + 1
        s.last_pong @ payload
        return ok(.nothing)

    if op == frames.CLOSE
        return closing(@stream, @s, b: b, payload: payload, waits: waits)
    first = op != frames.CONTINUATION

    if first
        s.reading @ true
        s.reading_text @ op == frames.TEXT
        s.reading_compressed @ compressed_bit
        s.by_parts @ parts
        s.joined @ []
        s.carry @ []
    out: [u8] @= payload

    if compressed
        most: i64 @= b.message_bytes

        if !parts
            most @ b.message_bytes - s.joined.len()

        out @ match deflating.inflated(@s.deflating, data: payload, first: first, last: h.fin, most: most)
            .ok got => got
            .err e =>
                if e.code == deflating.LIMIT
                    return engine.failing(@stream, @s, close: 1009, code: engine.LIMIT, msg: e.msg)
                return engine.failing(@stream, @s, close: 1002, code: engine.INVALID, msg: e.msg)

    if s.reading_text
        s.carry @ match utf8.carried_after(carry: s.carry, more: out)
            .ok rest => rest
            .err e => return engine.failing(
                @stream,
                @s,
                close: 1007,
                code: engine.NOT_TEXT,
                msg: "a text message " + e.msg
            )

        if h.fin && s.carry.len() > 0
            return engine.failing(
                @stream,
                @s,
                close: 1007,
                code: engine.NOT_TEXT,
                msg: "a text message that ends inside a character"
            )

    if h.fin
        s.reading @ false

    if parts
        return ok(.data(text: s.reading_text, data: out, last: h.fin))
    engine.add_onto(out: @s.joined, data: out)

    if !h.fin
        return ok(.nothing)
    whole = s.joined
    s.joined @ []
    return ok(.data(text: s.reading_text, data: whole, last: true))

# The peer's close taken: its code and reason kept, answered with this end's
# own where none was sent, and the stream ended, a client first waiting for
# the server to end it where `waits` says.
function closing(@stream: io.Stream, @s: engine.State, b: engine.Bounds, payload: [u8], waits: bool) -> Step?
    said = match frames.parse_close(payload)
        .ok got => got
        .err e =>
            if e.code == frames.NOT_TEXT
                return engine.failing(@stream, @s, close: 1007, code: engine.NOT_TEXT, msg: e.msg)
            return engine.failing(@stream, @s, close: 1002, code: engine.INVALID, msg: e.msg)

    s.close_got @ true
    s.got_code @ said.code
    s.got_reason @ said.reason

    if !s.close_sent
        s.close_sent @ true
        s.sent_code @ said.code
        answered = engine.send(
            @stream,
            @s,
            opcode: frames.CLOSE,
            fin: true,
            rsv1: false,
            payload: frames.close_payload(code: said.code, reason: "")
        )

        if answered.is_err()
            engine.end_stream(@stream, @s)
            return ok(.ended)

    if s.client && waits
        drain(stream, ms: b.close_wait_ms)
    engine.end_stream(@stream, @s)
    return ok(.ended)

# Reads and drops what `stream` holds until it ends, for at most `ms`
# milliseconds: a client waiting for the server to close first. It waits
# where no deadline can be placed on the stream.
function drain(stream: io.Stream, ms: i64)
    if ms > 0 && engine.deadline(stream, ms: ms).is_err()
        return

    while true
        match io.read(stream, n: engine.READ_MOST)
            .ok got =>
                if got.len() == 0
                    return
            .err _ => return

test "step: more before a whole frame, nothing for a ping, data for a text, and the close ended"
    two @= net.pair(deadline_ms: 5_000).must()
    s @= handmade.server()
    b = handmade.bounds()
    whole = handmade.frame(opcode: 1, fin: true, rsv: 0, payload: [104, 105], masked: true)
    s.inbox @ whole.slice(from: 0, to: 4)

    match step(@two.second.stream, @s, b: b, parts: false, waits: false).must()
        .more                       => assert s.at == 0
        .data _ | .nothing | .ended => assert false

    s.inbox @ bytes.concat(
        [handmade.frame(opcode: 9, fin: true, rsv: 0, payload: [], masked: true), whole, handmade.frame(opcode: 8, fin: true, rsv: 0, payload: [3, 232], masked: true)]
    )

    match step(@two.second.stream, @s, b: b, parts: false, waits: false).must()
        .nothing                 => assert s.at == 6
        .data _ | .more | .ended => assert false

    match step(@two.second.stream, @s, b: b, parts: false, waits: false).must()
        .data d                   => assert d.text && d.data == [104, 105] && d.last
        .nothing | .more | .ended => assert false

    match step(@two.second.stream, @s, b: b, parts: false, waits: false).must()
        .ended                     => assert s.ended && s.got_code == 1000
        .data _ | .nothing | .more => assert false

    assert handmade.read_frame(two.first.stream).must().opcode == 10
    assert handmade.close_code_of(handmade.read_frame(two.first.stream).must()) == 1000
    io.close(@two.first.stream).must()

test "drain: what is left read to the end, or to the deadline"
    two @= net.pair(deadline_ms: 0).must()
    io.write(two.first.stream, data: [1, 2, 3]).must()
    io.close(@two.first.stream).must()
    drain(two.second.stream, ms: 1_000)
    io.close(@two.second.stream).must()
    open @= net.pair(deadline_ms: 0).must()
    drain(open.second.stream, ms: 20)
    io.close(@open.first.stream).must()
    io.close(@open.second.stream).must()
