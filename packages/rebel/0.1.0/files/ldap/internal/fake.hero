# The StartTLS request this client sends first, and the answer to it.
function starttls_steps() -> [tls.Step]
    return [
        .expect(answer: bytes.parse_hex("301d02010177188016312e332e362e312e342e312e313436362e3230303337").must())
        .send(data: bytes.parse_hex("3024020101781f0a0100040004008a16312e332e362e312e342e312e313436362e3230303337").must())
    ]

# A port of the loopback address nothing listens on now.
function free_port() -> i64
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    port = l.address.port
    net.close_listener(@l).must()
    return port

# Waits until something listens on `port` of the loopback address, for
# about ten seconds at most, by trying to listen there itself: `exists` says
# the server is up, and no connection is spent on asking.
function until_listening(port: i64)
    tries @= 0

    while tries < 500
        tries @ tries + 1

        match net.listen(host: "127.0.0.1", port: port)
            .ok taken =>
                l @= taken
                net.close_listener(@l).must()
                time.sleep(time.Duration(nanoseconds: 20000000))
            .err e =>
                if e.code == net.EXISTS
                    return
                time.sleep(time.Duration(nanoseconds: 20000000))

# A plain listener on `port` of the loopback address, tried again for about
# two seconds while `until_listening` holds the port for a moment.
function listening(port: i64) -> net.Listener?
    tries @= 0

    while true
        tries @ tries + 1

        match net.listen(host: "127.0.0.1", port: port)
            .ok l => return ok(l)
            .err e =>
                if tries >= 100
                    return fail(code: e.code, msg: e.msg)
                time.sleep(time.Duration(nanoseconds: 20000000))

# A TLS listener on `port`, with StartTLS's exchange before TLS where
# `starttls`, tried again as `listening` tries.
function listening_tls(port: i64, server: tls.Server, starttls: bool) -> tls.Listener?
    tries @= 0

    while true
        tries @ tries + 1

        made = if starttls
            tls.listen_after(host: "127.0.0.1", port: port, server: server, steps: starttls_steps())
        else
            tls.listen(host: "127.0.0.1", port: port, server: server)

        match made
            .ok l => return ok(l)
            .err e =>
                if tries >= 100
                    return fail(code: e.code, msg: e.msg)
                time.sleep(time.Duration(nanoseconds: 20000000))

# Plays `turns` on `stream`, and answers `ok` or what went wrong.
function play(stream: io.Stream, turns: [Turn]) -> str
    r @= io.reader(stream)

    for k in range(from: 0, to: turns.len())
        t = turns[k]

        heard = match wire.read_raw(@r, most: 1048576)
            .ok got => got
            .err e  => return f"turn {k}: {e.code}: {e.msg}"

        if t.expect != "*" && bytes.format_hex(heard) != t.expect
            return f"turn {k}: heard {bytes.format_hex(heard)}"

        if t.reply == ""
            return "ok"

        if t.reply == "wait"
            time.sleep(time.Duration(nanoseconds: 2000000000))
            return "ok"

        match io.write(stream, data: bytes.parse_hex(t.reply).must())
            .ok _  => _ = 0
            .err e => return f"turn {k}: writing: {e.code}: {e.msg}"

    return "ok"

# The server on a thread of its own: `arg` is `"<mode> <port> <script>"`,
# the mode `plain`, `ldaps` or `starttls`. It accepts until a connection
# plays the script (StartTLS on macOS spends one connection on asking
# first), and answers `ok` or what went wrong.
function serve(arg: str) -> str
    parts = strings.split(s: arg, sep: " ")

    if parts.len() != 3
        return "invalid: not \"<mode> <port> <script>\": " + arg
    port = numbers.parse_int(parts[1]).default(0)
    turns = script(parts[2])

    if turns.len() == 0
        return "no script named " + parts[2]

    if parts[0] == "plain"
        l @= match listening(port)
            .ok made => made
            .err e   => return "listen failed: " + e.code + ": " + e.msg

        net.set_accept_deadline(l, deadline_ms: 15000).must()

        heard = match net.accept(l, deadline_ms: 15000)
            .err e => e.code + ": " + e.msg
            .ok c =>
                s @= c.stream
                played = play(stream: s, turns: turns)
                io.close(@s).must()
                played

        net.close_listener(@l).must()
        return heard

    server = tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: [])

    l @= match listening_tls(port, server: server, starttls: parts[0] == "starttls")
        .ok made => made
        .err e   => return "listen failed: " + e.code + ": " + e.msg

    tls.set_accept_deadline(l, deadline_ms: 15000).must()
    heard: str @= "closed: no client finished its handshake"
    tries @= 0

    while tries < 3
        tries @ tries + 1

        match tls.accept(l, deadline_ms: 10000)
            .err e =>
                heard @ e.code + ": " + e.msg

                if e.code == "timeout"
                    break
            .ok taken =>
                s @= taken.stream
                heard @ play(stream: s, turns: turns)

                if !io.is_closed(s)
                    io.close(@s).must()
                break

    tls.close_listener(@l).must()
    return heard
