# The loopback LDAP server of `ldap`'s tests, written here in Heroes: a
# thread of its own listens on 127.0.0.1, in plain text, by TLS from the
# first byte or with StartTLS through `tls.listen_after` and its test
# certificates, and plays a script: each message the client sends is read
# whole, its bytes checked against the request the script expects, and the
# script's canned BER answered. A thread runs a function of one `str` and
# answers one (spec § 13), so the script crosses by name and the server
# answers `ok`, or what went wrong.

use bytes
use io
use ldap/internal/wire
use net
use numbers
use strings
use time
use tls

# One turn of a script.
record Turn
    # The request expected, in hexadecimal; `*` for any one message.
    expect: str
    # The bytes answered, in hexadecimal; `wait` waits two seconds and
    # closes; "" closes at once.
    reply: str

# The script named `name`: each turn the request expected, in
# hexadecimal (`*` for any one message), and the bytes answered (`wait`
# to wait two seconds and close, "" to close at once). Every byte was
# made by Python's `ldap3` 2.9.1, its own operation builders and protocol
# classes, on 2026-11-18.
function script(name: str) -> [Turn]
    return match name
        "bind" => [
            Turn(expect: "302c0201016027020103041a636e3d61646d696e2c64633d6578616d706c652c64633d6f72678006736563726574", reply: "300c02010161070a010004000400")
            Turn(expect: "*", reply: "")
        ]
        "bind-refused" => [
            Turn(expect: "302c0201016027020103041a636e3d61646d696e2c64633d6578616d706c652c64633d6f72678006736563726574", reply: "301f020101611a0a013104000413696e76616c69642063726564656e7469616c73")
            Turn(expect: "*", reply: "")
        ]
        "anonymous" => [
            Turn(expect: "300c020101600702010304008000", reply: "300c02010161070a010004000400")
            Turn(expect: "*", reply: "")
        ]
        "external" => [
            Turn(expect: "301602010160110201030400a30a040845585445524e414c", reply: "300c02010161070a010004000400")
            Turn(expect: "*", reply: "")
        ]
        "plain" => [
            Turn(expect: "3020020101601b0201030400a3140405504c41494e040b00616e6100736563726574", reply: "300c02010161070a010004000400")
