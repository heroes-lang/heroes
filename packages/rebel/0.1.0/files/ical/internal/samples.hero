# The lines of a calendar of every kind of component, the physical lines of a document with a folded line, escapes, a zone no database names, an exception, an override, an all-day event, a UTC series, a zone of the database, a to-do and a journal entry.
function calendar_lines() -> [str]
    return [
        "BEGIN:VCALENDAR"
        "PRODID:-//Rebel//ical tests//EN"
        "VERSION:2.0"
        "CALSCALE:GREGORIAN"
        "METHOD:PUBLISH"
        "X-WR-CALNAME:Team\\, Ops"
        "BEGIN:VTIMEZONE"
        "TZID:Customized Time Zone"
        "BEGIN:STANDARD"
        "DTSTART:19701025T030000"
        "TZOFFSETFROM:+0200"
        "TZOFFSETTO:+0100"
        "TZNAME:CET"
        "RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU"
        "END:STANDARD"
        "BEGIN:DAYLIGHT"
        "DTSTART:19700329T020000"
        "TZOFFSETFROM:+0100"
        "TZOFFSETTO:+0200"
        "TZNAME:CEST"
        "RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU"
        "END:DAYLIGHT"
        "END:VTIMEZONE"
        "BEGIN:VEVENT"
        "UID:standup@example.org"
        "DTSTAMP:20261101T080000Z"
        "DTSTART;TZID=Customized Time Zone:20261102T093000"
        "DTEND;TZID=Customized Time Zone:20261102T094500"
        "SUMMARY:Daily stand-up\\, with a very long title that has to be folded acro"
        " ss several lines because it is longer than seventy-five octets"
        "DESCRIPTION:Line one\\nLine two\\; with semicolon"
        "LOCATION:Room 4"
        "RRULE:FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR;UNTIL=20261231T000000Z"
        "EXDATE;TZID=Customized Time Zone:20261104T093000,20261105T093000"
        "ORGANIZER;CN=\"Doe, Jane\":mailto:jane@example.org"
        "ATTENDEE;CN=Ann;PARTSTAT=ACCEPTED;RSVP=TRUE:mailto:ann@example.org"
        "ATTENDEE;PARTSTAT=NEEDS-ACTION:mailto:bob@example.org"
        "CATEGORIES:WORK,Team\\, one"
        "STATUS:CONFIRMED"
        "TRANSP:OPAQUE"
        "CLASS:PUBLIC"
        "PRIORITY:5"
        "SEQUENCE:2"
        "X-CUSTOM;X-P=1:keep me"
        "BEGIN:VALARM"
        "ACTION:DISPLAY"
        "TRIGGER:-PT15M"
        "DESCRIPTION:Stand-up in 15 minutes"
        "END:VALARM"
        "END:VEVENT"
        "BEGIN:VEVENT"
        "UID:standup@example.org"
        "DTSTAMP:20261101T080000Z"
        "RECURRENCE-ID;TZID=Customized Time Zone:20261109T093000"
        "DTSTART;TZID=Customized Time Zone:20261109T110000"
        "DTEND;TZID=Customized Time Zone:20261109T113000"
        "SUMMARY:Daily stand-up (moved)"
        "END:VEVENT"
        "BEGIN:VEVENT"
        "UID:holiday@example.org"
        "DTSTAMP:20261101T080000Z"
        "DTSTART;VALUE=DATE:20261125"
        "DTEND;VALUE=DATE:20261127"
        "SUMMARY:Conference"
        "END:VEVENT"
        "BEGIN:VEVENT"
        "UID:utc@example.org"
        "DTSTAMP:20261101T080000Z"
        "DTSTART:20261110T230000Z"
        "DURATION:PT1H30M"
        "SUMMARY:Backup window"
        "RDATE:20261117T230000Z"
        "RRULE:FREQ=WEEKLY;COUNT=3"
        "END:VEVENT"
        "BEGIN:VEVENT"
        "UID:ny@example.org"
        "DTSTAMP:20261101T080000Z"
        "DTSTART;TZID=America/New_York:20261103T140000"
        "DTEND;TZID=America/New_York:20261103T150000"
        "SUMMARY:Call across the Atlantic"
        "RRULE:FREQ=WEEKLY;COUNT=4"
        "END:VEVENT"
        "BEGIN:VTODO"
        "UID:todo1@example.org"
        "DTSTAMP:20261101T080000Z"
        "DUE;VALUE=DATE:20261130"
        "SUMMARY:File the report"
        "PERCENT-COMPLETE:40"
        "STATUS:IN-PROCESS"
        "PRIORITY:1"
        "END:VTODO"
        "BEGIN:VJOURNAL"
        "UID:j1@example.org"
        "DTSTAMP:20261101T080000Z"
        "DTSTART;VALUE=DATE:20261101"
        "SUMMARY:Notes"
        "DESCRIPTION:Met the team."
        "END:VJOURNAL"
        "END:VCALENDAR"
    ]

# The events the reference placed in 2026-11-01 to 2026-12-05 UTC: start, end and `UID`, as python-icalendar 7.3.2 with recurring-ical-events 3.8.2 (run 2026-11-23) answers.
