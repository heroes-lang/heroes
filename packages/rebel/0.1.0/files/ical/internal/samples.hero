# Expected answers the package's tests are held to, written by a second
# implementation: the recurrence rules of RFC 5545 section 3.8.5.3 and others,
# expanded by Python 3.15.2's `dateutil.rrule` (python-dateutil 2.9.0.post0),
# run on 2026-11-23 over the window each case names. The rules' own text is the
# standard's; the starting zones are America/New_York and Europe/Rome of the
# IANA database, and a start with no zone is read as it is.

# One rule, its start, a window of wall-clock readings and the readings the
# reference gave inside it.
record Sample
    # The start as `YYYYMMDDTHHMMSS`.
    start: str
    # The zone the start is in: an IANA name, `Z` for UTC, `date` for a date and the empty text for a floating reading.
    zone: str
    # The text of the `RRULE`.
    rule: str
    # The first wall-clock reading of the window, which an occurrence may equal.
    after: str
    # The reading the window ends at, which none reaches.
    before: str
    # The readings the reference gave, `YYYYMMDDTHHMMSS` separated by spaces.
    expected: str

# The cases.
function rrule_cases() -> [Sample]
    return [
        Sample(start: "19970105T083000", zone: "America/New_York", rule: "FREQ=YEARLY;INTERVAL=2;BYMONTH=1;BYDAY=SU;BYHOUR=8,9;BYMINUTE=30", after: "19970105T083000", before: "20050116T093001", expected: "19970105T083000 19970105T093000 19970112T083000 19970112T093000 19970119T083000 19970119T093000 19970126T083000 19970126T093000 19990103T083000 19990103T093000 19990110T083000 19990110T093000 19990117T083000 19990117T093000 19990124T083000 19990124T093000 19990131T083000 19990131T093000 20010107T083000 20010107T093000 20010114T083000 20010114T093000 20010121T083000 20010121T093000 20010128T083000 20010128T093000 20030105T083000 20030105T093000 20030112T083000 20030112T093000 20030119T083000 20030119T093000 20030126T083000 20030126T093000 20050102T083000 20050102T093000 20050109T083000 20050109T093000 20050116T083000 20050116T093000")
