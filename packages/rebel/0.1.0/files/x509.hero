    "1.3.6.1.5.5.7.1.1"

# The extension `subjectInfoAccess`, `1.3.6.1.5.5.7.1.11`.
constant SUBJECT_INFO_ACCESS: str
    "1.3.6.1.5.5.7.1.11"

# The extension `certificatePolicies`, `2.5.29.32`.
