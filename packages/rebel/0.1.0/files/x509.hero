    "2.5.29.54"

# The extension `nameConstraints`, `2.5.29.30`.
constant NAME_CONSTRAINTS: str
    "2.5.29.30"

# A revocation list's extension `cRLNumber`, `2.5.29.20`.
constant CRL_NUMBER: str
    "2.5.29.20"

# A revocation list's extension `deltaCRLIndicator`, `2.5.29.27`.
constant DELTA_CRL_INDICATOR: str
    "2.5.29.27"

# A revocation list's extension `issuingDistributionPoint`, `2.5.29.28`.
