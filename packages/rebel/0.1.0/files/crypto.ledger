  go      sha3.Sum224, sha3.Sum256, sha3.Sum384, sha3.Sum512, sha3.SHA3, sha3.New224, sha3.New256, sha3.New384, sha3.New512, sha3.SHA3.BlockSize, sha3.SHA3.Reset, sha3.SHA3.Size, sha3.SHA3.Sum, sha3.SHA3.Write
