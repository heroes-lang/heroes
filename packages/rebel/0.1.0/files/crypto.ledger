  heroes  pending
  go      sha3.Sum224, sha3.Sum256, sha3.Sum384, sha3.Sum512, sha3.SumSHAKE128, sha3.SumSHAKE256, sha3.SHA3, sha3.New224, sha3.New256, sha3.New384, sha3.New512, sha3.SHA3.BlockSize, sha3.SHA3.Reset, sha3.SHA3.Size, sha3.SHA3.Sum, sha3.SHA3.Write, sha3.SHAKE, sha3.NewSHAKE128, sha3.NewSHAKE256, sha3.NewCSHAKE128, sha3.NewCSHAKE256, sha3.SHAKE.BlockSize, sha3.SHAKE.Read, sha3.SHAKE.Reset, sha3.SHAKE.Write
