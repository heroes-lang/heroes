# An external account the test server keeps: its identifier and its MAC
# key, never printed.
record Binding
    # The CA's identifier of the account.
    key_id: str
    # The MAC key, decoded.
    hmac_key: [u8]

# The external account `ACME_EAB_KID` and `ACME_EAB_KEY` name, where they and
# `ACME_DIRECTORY` are set; the key in base 64 for URLs.
function eab() -> Binding?
    _ = os.env("ACME_DIRECTORY")?
    key_id = os.env("ACME_EAB_KID")?
    key = bytes.parse_base64_url_unpadded(os.env("ACME_EAB_KEY")?)?
    return ok(Binding(key_id: key_id, hmac_key: key))

# The test server's directory URL, where `ACME_DIRECTORY` names one and
# something answers there; an example given none says it skipped.
function directory_url() -> str?
    url = os.env("ACME_DIRECTORY")?
    request = http.request(method: "GET", target: url)?
    _ = http.send(c: transport(), r: request)?
    return ok(url)

# A client that trusts the test server's authority.
function transport() -> http.Client
    c @= http.default_client()

    match os.env("ACME_ROOTS")
        .ok path => c.roots @ read_file(path).default("")
        .err _   => _ = 0

    return c

# The challenge server's management URL.
function challtest() -> str
    return os.env("ACME_CHALLTEST").default("http://127.0.0.1:8055")

# The TXT record `value` published under `name` at the challenge server.
function publish_txt(name: str, value: str) -> ()?
    body = json.format(.object(members: {"host": .text(v: name + "."), "value": .text(v: value)}))?
    request = http.with_body(
        r: http.request(method: "POST", target: challtest() + "/set-txt")?,
        content_type: "application/json",
        body: bytes.from_text(body)
    )
    _ = http.require_success(http.send(c: http.default_client(), r: request)?)?
    return ok()

