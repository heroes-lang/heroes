# Its ARI identifier, computed from its authority key identifier and its
# serial number as Python's `cryptography` 50.0.2 reads them.
constant LEAF_ID: str
    "SwZJ8on5Z5zC9Q-lk2tWTJMPNkw.R_-LcsBdJP8"

## Tests

test "the recorded request: a DER sequence, and the variables read"
    assert CSR[0] == 0x30 && CSR.len() == 286
    assert challtest().len() > 0
    assert transport().max_redirects == 10
