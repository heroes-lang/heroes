# The codes `acme` fails with, named here for the private modules so that
# every module of the package fails alike; the face writes each one's text.

use acme

# An answer that is not RFC 8555's, or an argument refused.
constant INVALID: str
    acme.INVALID

# No account has the key.
constant NOT_FOUND: str
    acme.NOT_FOUND

# The server's rate limit.
constant LIMIT: str
    acme.LIMIT

# A wait ran out.
constant TIMEOUT: str
    acme.TIMEOUT

# Every other refusal of the server.
constant FAILED: str
    acme.FAILED

# What the directory does not offer.
constant UNSUPPORTED: str
    acme.UNSUPPORTED

## Tests

test "codes: the library's words"
    assert INVALID == "invalid" && NOT_FOUND == "not_found" && LIMIT == "limit"
    assert TIMEOUT == "timeout" && FAILED == "failed" && UNSUPPORTED == "unsupported"
