# A batch read from its JSON.
test "to_batch: a batch's counts"
    b = to_batch(json.parse(canned.batch_json(id: "msgbatch_1", status: "ended")).must()).must()
    assert b.processing_status == BATCH_ENDED && b.request_counts.succeeded == 2 && b.ended_at == ""

# Two requests sent as one batch.
test "create_batch: two requests"
    t @= canned.start(
        [canned.json_answer(status: 200, body: canned.batch_json(id: "msgbatch_1", status: "in_progress"), fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    r = new_request(model: "m", max_tokens: 4, turns: [user("x")])
    b = create_batch(
        c,
        requests: [BatchRequest(custom_id: "a", request: r), BatchRequest(custom_id: "b-2", request: r)]
    ).must()
    seen = canned.requests_of(@t)
    assert b.id == "msgbatch_1" && b.processing_status == BATCH_IN_PROGRESS
    assert strings.has_suffix(
        s: seen[0],
        suffix: "\n\n{\"requests\":[{\"custom_id\":\"a\",\"params\":{\"model\":\"m\",\"max_tokens\":4,\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"x\"}]}]}},{\"custom_id\":\"b-2\",\"params\":{\"model\":\"m\",\"max_tokens\":4,\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"x\"}]}]}}]}"
    )

# A batch polled.
test "batch_of: a batch by its id"
    t @= canned.start(
        [canned.json_answer(status: 200, body: canned.batch_json(id: "msgbatch_1", status: "ended"), fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    b = batch_of(c, id: "msgbatch_1").must()
    seen = canned.requests_of(@t)
    assert b.processing_status == BATCH_ENDED && strings.has_prefix(s: seen[0], prefix: "GET /v1/messages/batches/msgbatch_1\n")

# A page of batches.
test "list_batches: one batch"
    page = "{\"data\":[" + canned.batch_json(id: "msgbatch_1", status: "ended") + "],\"has_more\":false,\"first_id\":\"msgbatch_1\",\"last_id\":\"msgbatch_1\"}"
    t @= canned.start([canned.json_answer(status: 200, body: page, fields: [])])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    p = list_batches(c, cursor: first_page()).must()
    seen = canned.requests_of(@t)
    assert p.batches.len() == 1 && !p.has_more && strings.has_prefix(s: seen[0], prefix: "GET /v1/messages/batches?limit=20\n")

# A batch cancelled.
test "cancel_batch: canceling"
    t @= canned.start(
        [canned.json_answer(status: 200, body: canned.batch_json(id: "msgbatch_1", status: "canceling"), fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    b = cancel_batch(c, id: "msgbatch_1").must()
    seen = canned.requests_of(@t)
    assert b.processing_status == BATCH_CANCELING && strings.has_prefix(s: seen[0], prefix: "POST /v1/messages/batches/msgbatch_1/cancel\n")

# A batch deleted.
test "delete_batch: an ended batch"
    t @= canned.start(
        [canned.json_answer(status: 200, body: "{\"id\":\"msgbatch_1\",\"type\":\"message_batch_deleted\"}", fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    delete_batch(c, id: "msgbatch_1").must()
    seen = canned.requests_of(@t)
    assert strings.has_prefix(s: seen[0], prefix: "DELETE /v1/messages/batches/msgbatch_1\n")

# A line of a batch's results.
test "to_batch_result: a request cancelled"
    r = to_batch_result(json.parse("{\"custom_id\":\"c\",\"result\":{\"type\":\"canceled\"}}").must()).must()
    assert r == BatchResult(custom_id: "c", outcome: .canceled)

# The results of a batch, from their text.
test "parse_batch_results: one of each kind"
    results = parse_batch_results(canned.results_jsonl()).must()
    assert results.len() == 4 && results[0].custom_id == "b"

    match results[1].outcome
        .errored e                          => assert e.error.kind == "invalid_request_error" && e.error.status == 400 && e.error.message == "bad"
        .succeeded _ | .canceled | .expired => assert false

    assert results[2].outcome == .canceled && results[3].outcome == .expired

# The results of an ended batch, read as they come.
test "batch_results: one of each kind, each found by its custom_id"
    t @= canned.start([canned.stream_answer(content_type: "application/x-jsonl", body: canned.results_jsonl())])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    results = batch_results(c, id: "msgbatch_1").must()
    seen = canned.requests_of(@t)
    assert results.len() == 4 && strings.has_prefix(s: seen[0], prefix: "GET /v1/messages/batches/msgbatch_1/results\n")

    match results[0].outcome
        .succeeded s                      => assert text_of(s.message) == "two"
        .errored _ | .canceled | .expired => assert false
