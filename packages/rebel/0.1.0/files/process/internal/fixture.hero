# What the tests of `process` start: the system's own programs, named for each
# platform, and a child's text with its line ends taken off. No program calls
# it. On POSIX `/bin/sh` reads the scripts, `cat` copies its input to its
# output and `sleep` waits; on Windows `cmd.exe` reads them, `sort` copies its
# input (one line passes unchanged) and `ping` of 127.0.0.1 waits a second a
# reply.
#
# The tests of the floor `process/hero_proc` stand here too, under
# `## The floor's tests`: a child started through the floor's own doors, its
# lists packed as C reads them, its pipe drained, and a folder made and
# removed, the last bound to `hero_os.h` itself, so that the floor keeps one
# function per C function and no policy (README § A2).

use io/hero_stream
use os
use process/hero_proc
use unicode

extern "hero_os.h"
    constant HERO_OS_OK: i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_dir_remove_tree(path: cstr lent) -> i64

# Whether the tests run on Windows.
function on_windows() -> bool
    return os.system() == .windows

# A script that ends with the exit code `code`.
function exit_script(code: i64) -> str
    if on_windows()
        return f"exit /b {code}"
    return f"exit {code}"

# A script that prints the variable `name`.
function variable_script(name: str) -> str
    if on_windows()
        return f"echo %{name}%"
    return f"echo \"${name}\""

# A script that writes `word` to its error. `cmd.exe` writes the space
# before a redirection or an `&&` as part of what `echo` prints, so there the
# `echo` stands in parentheses that end its words.
function error_script(word: str) -> str
    if on_windows()
        return f"(echo {word})1>&2"
    return f"echo {word} 1>&2"

# A script that writes `first` to its output, then `second` to its error.
function both_script(first: str, second: str) -> str
    if on_windows()
        return f"(echo {first})&&(echo {second})1>&2"
    return f"echo {first} && echo {second} 1>&2"

# A script that writes bytes that are no text: the byte 255 by `printf` on
# POSIX, and on Windows the shell's own program file, a program and no text,
# by `type`.
function no_text_script() -> str
    if on_windows()
        return "type %ComSpec%"
    return "printf '\\377'"

# The exit code a child `hero_proc_kill` ended reads: none, -1, on POSIX,
# where SIGKILL ended it; on Windows, which has no signals, the code 1
# `TerminateProcess` was given (`hero_proc.h`).
function killed_code() -> i64
    if on_windows()
        return 1
    return -1

# The signal a child `hero_proc_kill` ended reads: SIGKILL, 9, on POSIX, and
# 0 on Windows, which has none.
function killed_signal() -> i64
    if on_windows()
        return 0
    return 9

# The program `shell` starts: `/bin/sh` on POSIX, and on Windows the one
# `ComSpec` names, `cmd.exe` where it names none.
function shell_program() -> str
    if on_windows()
        program = os.env("ComSpec").default("")

        if program == ""
            return "cmd.exe"
        return program
    return "/bin/sh"

# The arguments that make `shell_program` run `script`, as `shell` passes
# them.
function shell_arguments(script: str) -> [str]
    if on_windows()
        return ["/d", "/s", "/c", script]
    return ["-c", script]

# The name a search of PATH finds the system's shell by.
function shell_name() -> str
    if on_windows()
        return "cmd"
    return "sh"

# How the path that search answers ends.
function shell_ending() -> str
    if on_windows()
        return "\\cmd.exe"
    return "/sh"

# Whether the paths `a` and `b` are written alike by the system's rules: byte
# for byte on POSIX, and on Windows with a letter's two cases alike, since a
# Windows folder answers to either and `cd` prints the case on the disk.
function same_path(a: str, b: str) -> bool
    if !on_windows()
        return a == b
    return lowered(a) == lowered(b)

# `text` with every letter in its lower case.
function lowered(text: str) -> str
    kept: [str] @= []

    for c in text.chars()
        kept @ kept.push(unicode.to_lower(c))

    return kept.join("")

# A script that prints its working folder.
function folder_script() -> str
    if on_windows()
        return "cd"
    return "pwd"

# A folder every system has: the system's root on Windows, `/bin` elsewhere.
function a_folder() -> str
    if on_windows()
        return os.env("SystemRoot").default("C:\\Windows")
    return "/bin"

# The system's program that copies its input to its output, and ends when the
# input does.
function copier() -> str
    if on_windows()
        return "sort"
    return "cat"

# The system's program that waits.
function sleeper() -> str
    if on_windows()
        return "ping"
    return "sleep"

# The arguments that make `sleeper` wait about `seconds`.
function sleeper_arguments(seconds: i64) -> [str]
    if on_windows()
        return ["-n", f"{seconds + 1}", "127.0.0.1"]
    return [f"{seconds}"]

# `bytes` as text without the line ends after it, which are two bytes on
# Windows.
function line(bytes: [u8]) -> str
    end: i64 @= bytes.len()

    while end > 0 && (bytes[end - 1] == 10 || bytes[end - 1] == 13)
        end @ end - 1

    return bytes.slice(from: 0, to: end).validated_bytes().must()

# `text` without its carriage returns, so a Windows child's lines read as
# POSIX's.
function unix_lines(text: str) -> str
    kept: [str] @= []

    for c in text.chars()
        if c != "\r"
            kept @ kept.push(c)

    return kept.join("")

## The floor's tests

# The words as the one list C reads: each followed by a zero byte.
function packed(words: [str]) -> [u8]
    out: [u8] @= []

    for word in words
        for i in range(from: 0, to: word.len())
            out @ out.push(word[i])

        out @ out.push(0)

    return out

# Everything `s` holds up to its end.
function drained(s: hero_stream.Stream) -> [u8]
    out: [u8] @= []
    part: [u8] @= []

    while true
        got = hero_stream.read(s, @part, n: 256)

        if got <= 0
            return out

        for i in range(from: 0, to: got)
            out @ out.push(part[i])

# Whether `text` ends with `tail`.
function ends_with(text: str, tail: str) -> bool
    return text.len() >= tail.len() && text.slice(from: text.len() - tail.len(), to: text.len()) == tail

# The three kinds of a child the tests neither feed nor read.
function quiet() -> [i64]
    return [hero_proc.HERO_PROC_STDIO_NOTHING, hero_proc.HERO_PROC_STDIO_NOTHING, hero_proc.HERO_PROC_STDIO_NOTHING]

# A child with its lists already bytes and no stream of the program's.
function begun(program: str, arguments: [u8], environment_kind: i64, environment: [u8], folder: str, kinds: [i64]) -> hero_proc.Proc
    words: [u8] @= arguments
    variables: [u8] @= environment
    return hero_proc.start(
        program: program,
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: environment_kind,
        environment: @variables,
        environment_count: variables.len().to_u64().must(),
        folder: folder,
        in_kind: kinds[0],
        in_stream: nullptr,
        out_kind: kinds[1],
        out_stream: nullptr,
        err_kind: kinds[2],
        err_stream: nullptr,
        group_kind: hero_proc.HERO_PROC_GROUP_PARENT,
        leader: nullptr
    )

# A child of `program` with `words`, this process's environment, and `folder`.
function child(program: str, words: [str], folder: str, kinds: [i64]) -> hero_proc.Proc
    none: [u8] = []
    return begun(
        program: program,
        arguments: packed(words),
        environment_kind: hero_proc.HERO_PROC_ENV_PARENT,
        environment: none,
        folder: folder,
        kinds: kinds
    )

# The shell's arguments for one command of `words`: `-c` and the command as
# one word, and on Windows `/c` and each word, which `cmd.exe` joins itself.
function shell_words(words: [str]) -> [str]
    if on_windows()
        out: [str] @= ["/c"]

        for word in words
            out @ out.push(word)

        return out

    return ["-c", join(words, " ")]

# The shell, `shell_program`, running one command.
function shell(words: [str], folder: str, kinds: [i64]) -> hero_proc.Proc
    return child(program: shell_program(), words: shell_words(words), folder: folder, kinds: kinds)

# The folder a test works in, made new under `build/` of the folder the tests
# run from, and its name, which holds this process's number.
function scratch_name(name: str) -> str
    return f"rebel-hero_proc-{os.pid()}-{name}"

# The folder of that name, made.
function scratch(name: str) -> str
    folder = "build/" + scratch_name(name)
    _ = hero_fs_mkdir_all(folder.cstr())
    return folder

# Whether `folder` is gone, removed with everything a test left in it.
function cleared(folder: str) -> bool
    return hero_dir_remove_tree(folder.cstr()) == HERO_OS_OK
