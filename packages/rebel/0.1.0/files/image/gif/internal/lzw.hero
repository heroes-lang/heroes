# GIF's LZW (GIF89a appendix F): codes of 3 to 12 bits packed lowest bit
# first, a clear code and an end code after the literals, the code width
# growing as the table fills and staying at 12 once it is full until a
# clear. Decoding stops at the end code and refuses a code not yet defined,
# so a stream can neither run past its frame nor loop.

use image

# The decoded bytes of the LZW stream `data` of minimum code size `width`,
# which must make exactly `count` of them. Fails `invalid` on a code not
# yet defined, a code past the literals before any string, more bytes than
# `count`, or fewer.
function decoded(data: [u8] lent, width: i64, count: i64) -> [u8]?
    clear = 1 << width
    stop = clear + 1
    prefix: [i64] @= []
    suffix: [i64] @= []
    first: [i64] @= []

    for i in range(from: 0, to: 4096)
        prefix @ prefix.push(-1)

        if i < clear
            suffix @ suffix.push(i)
            first @ first.push(i)
        else
            suffix @ suffix.push(0)
            first @ first.push(0)

    size @= width + 1
    next @= clear + 2
    previous @= -1
    out: [u8] @= []
    held @= 0
    bits @= 0
    pos @= 0
    ended @= false
    chain: [i64] @= []

    while !ended
        while bits < size && pos < data.len()
            held @ held | to_i64(data[pos]).must() << bits
            bits @ bits + 8
            pos @ pos + 1

        if bits < size
            break
        code = held & (1 << size) - 1
        held @ held >> size
        bits @ bits - size

        if code == clear
            size @ width + 1
            next @ clear + 2
            previous @ -1
        else if code == stop
            ended @ true
        else
            if previous < 0 && code >= clear
                return fail(
                    code: image.INVALID,
                    msg: f"an LZW code of {code} before any string, past the {clear} literals"
                )

            if code > next || code == next && previous < 0
                return fail(
                    code: image.INVALID,
                    msg: f"an LZW code of {code}, where the table holds codes below {next}"
                )
            chain @ []

            walk @= if code == next
                previous
            else
                code

            while walk >= 0
                chain @ chain.push(suffix[walk])
                walk @ prefix[walk]

            head = chain[chain.len() - 1]

            for i in range(from: 0, to: chain.len())
                out @ out.push(to_u8(chain[chain.len() - 1 - i]).must())

            if code == next
                out @ out.push(to_u8(head).must())

            if previous >= 0 && next < 4096
                prefix[next] @ previous
                suffix[next] @ head
                first[next] @ first[previous]
                next @ next + 1

                if next == 1 << size && size < 12
                    size @ size + 1
            previous @ code

            if out.len() > count
                return fail(code: image.INVALID, msg: f"LZW data of more than the {count} pixels of its frame")

    if out.len() < count
        return fail(code: image.INVALID, msg: f"LZW data of {out.len()} pixels, where its frame holds {count}")
    return ok(out)

# Writes `code` of `size` bits to `out`, lowest bit first, through the bits
# `held` not yet written, `bits` of them.
function put(@out: [u8], @held: i64, @bits: i64, code: i64, size: i64)
    held @ held | code << bits
    bits @ bits + size

    while bits >= 8
        out @ out.push(to_u8(held & 255).must())
        held @ held >> 8
        bits @ bits - 8

# `indices` as an LZW stream of minimum code size `width`: a clear code
# first, a clear again each time the table fills, and the end code last.
function encoded(indices: [u8] lent, width: i64) -> [u8]
    clear = 1 << width
    stop = clear + 1
    size @= width + 1
    next @= clear + 2
    table: {i64: i64} @= {}
    out: [u8] @= []
    held @= 0
    bits @= 0
    current @= -1
    put(@out, held: @held, bits: @bits, code: clear, size: size)

    for b in indices
        v = to_i64(b).must()

        if current < 0
            current @ v
        else
            key = current * 256 + v

            match table[key]
                .ok known => current @ known
                .err _ =>
                    put(@out, held: @held, bits: @bits, code: current, size: size)
                    table[key] @ next
                    next @ next + 1

                    if next == (1 << size) + 1 && size < 12
                        size @ size + 1

                    if next == 4096
                        put(@out, held: @held, bits: @bits, code: clear, size: size)
                        size @ width + 1
                        next @ clear + 2
                        table @ {}
                    current @ v

    if current >= 0
        put(@out, held: @held, bits: @bits, code: current, size: size)

        if next == 1 << size && size < 12
            size @ size + 1
    put(@out, held: @held, bits: @bits, code: stop, size: size)

    if bits > 0
        out @ out.push(to_u8(held & 255).must())
    return out

test "encoded and decoded: runs, every value, long inputs that fill the table, nothing"
    for width in [2, 3, 8]
        top = 1 << width
        inputs: [[u8]] @= [[]]
        run: [u8] @= []
        mixed: [u8] @= []

        for i in range(from: 0, to: 9000)
            run @ run.push(0)
            mixed @ mixed.push(to_u8((i * 7 + i / 1000) % top).must())

        inputs @ inputs.push(run)
        inputs @ inputs.push(mixed)

        for input in inputs
            packed = encoded(input, width: width)
            assert decoded(packed, width: width, count: input.len()).must() == input

test "decoded: a code not yet defined, too many pixels and too few"
    packed = encoded([1, 2, 3, 1, 2, 3], width: 2)
    assert decoded(packed, width: 2, count: 5).is_err()
    assert decoded(packed, width: 2, count: 7).is_err()
    assert decoded([0xcc, 0x01], width: 2, count: 4).is_err()
    assert decoded([], width: 2, count: 0).must().len() == 0
