# A baseline JPEG written: the picture turned into YCbCr by JFIF's
# equations, the colour averaged over the pixels each sample covers, every
# block put through the forward DCT of T.81 A.3.3 in floats, quantized by
# Annex K's tables scaled to the quality as libjpeg scales them, and
# Huffman-coded with Annex K's tables. Rows and columns past the image's
# edge repeat its last ones.

use image/jpeg/internal/pixels as transform
use image/jpeg/internal/tables

# The bits waiting to be written, the oldest highest.
record Sink
    # The bits.
    held: i64
    # How many: 0 to 7 between writes.
    count: i64

# Writes the `length` low bits of `code` to `out`, a whole byte at a time,
# a 255 followed by a 0 as T.81 stuffs it.
function put_bits(@out: [u8], @sink: Sink, code: i64, length: i64)
    sink.held @ sink.held << length | code & (1 << length) - 1
    sink.count @ sink.count + length

    while sink.count >= 8
        b = sink.held >> sink.count - 8 & 255
        out @ out.push(to_u8(b).must())

        if b == 255
            out @ out.push(0)
        sink.count @ sink.count - 8
        sink.held @ sink.held & (1 << sink.count) - 1

# The code and length of each symbol of Annex K's four Huffman tables: for
# table t (0 brightness DC, 1 brightness AC, 2 colour DC, 3 colour AC) and
# symbol s at t × 256 + s, the code at even places and its length at odd.
function annex_k_codes() -> [i64]
    dht = tables.annex_k_huffman()
    out: [i64] @= []

    for _ in range(from: 0, to: 4 * 256 * 2)
        out @ out.push(0)

    p @= 0

    while p < dht.len()
        kind = to_i64(dht[p]).must() >> 4
        number = to_i64(dht[p]).must() & 15
        t = number * 2 + kind
        code @= 0
        k @= p + 17

        for l in range(from: 1, to: 17)
            for _ in range(from: 0, to: to_i64(dht[p + l]).must())
                s = to_i64(dht[k]).must()
                out[(t * 256 + s) * 2] @ code
                out[(t * 256 + s) * 2 + 1] @ l
                code @ code + 1
                k @ k + 1

            code @ code << 1

        p @ k

    return out

# Annex K's quantization table `number`, in zigzag order, scaled to
# `quality`, 1 to 100: by 5000 / quality below 50, by 200 - 2 × quality
# from 50, each entry rounded and held to 1 to 255.
function scaled(number: i64, quality: i64) -> [i64]
    scale = if quality < 50
        5000 / quality
    else
        200 - 2 * quality
    out: [i64] @= []

    for b in tables.annex_k_quantization(number)
        v = (b * scale + 50) / 100

        if v < 1
            out @ out.push(1)
        else if v > 255
            out @ out.push(255)
        else
            out @ out.push(v)

    return out

# The bits a number of magnitude `v` needs: its category in T.81.
function category(v: i64) -> i64
    a @= if v < 0
        -v
    else
        v
    n @= 0

    while a > 0
        a @ a >> 1
        n @ n + 1

    return n

# Writes `v` as T.81 writes a value of its category: its low bits, one less
# where it is negative.
function put_value(@out: [u8], @sink: Sink, v: i64, size: i64)
    if v < 0
        put_bits(@out, sink: @sink, code: v - 1, length: size)
    else
        put_bits(@out, sink: @sink, code: v, length: size)

# The quantized coefficients of the block `block`, 64 samples in natural
# order, in zigzag order: forward DCT, then each divided by `quant` (zigzag
# order) and rounded, a half away from 0.
function quantized(block: [f64] lent, quant: [i64] lent, t: [f64] lent, zz: [i64] lent) -> [i64]
    rows: [f64] @= []

    for v in range(from: 0, to: 8)
        for x in range(from: 0, to: 8)
            sum @= 0.0

            for y in range(from: 0, to: 8)
                sum @ sum + t[y * 8 + v] * (block[y * 8 + x] - 128.0)

            rows @ rows.push(sum)

    out: [i64] @= []

    for i in range(from: 0, to: 64)
        k = zz[i]
        v = k / 8
        u = k % 8
        sum @= 0.0

        for x in range(from: 0, to: 8)
            sum @ sum + t[x * 8 + u] * rows[v * 8 + x]

        q = sum / to_f64(quant[i])

        rounded = if q < 0.0
            -to_i64(0.5 - q).must()
        else
            to_i64(q + 0.5).must()
        out @ out.push(rounded)

    return out

# Writes the coefficients `q` of one block, zigzag order, by the tables
# `dc` and `ac` of `codes`, against the DC of the block before, `pred`.
function put_block(@out: [u8], @sink: Sink, q: [i64] lent, @pred: i64, codes: [i64] lent, dc: i64, ac: i64)
    diff = q[0] - pred
    pred @ q[0]
    size = category(diff)
    put_bits(@out, sink: @sink, code: codes[(dc * 256 + size) * 2], length: codes[(dc * 256 + size) * 2 + 1])
    put_value(@out, sink: @sink, v: diff, size: size)
    run @= 0

    for k in range(from: 1, to: 64)
        v @= q[k]

        if v == 0
            run @ run + 1
        else
            while run > 15
                put_bits(
                    @out,
                    sink: @sink,
                    code: codes[(ac * 256 + 0xf0) * 2],
                    length: codes[(ac * 256 + 0xf0) * 2 + 1]
                )
                run @ run - 16

            if v > 1023
                v @ 1023

            if v < -1023
                v @ -1023
            s = category(v)
            symbol = run << 4 | s
            put_bits(
                @out,
                sink: @sink,
                code: codes[(ac * 256 + symbol) * 2],
                length: codes[(ac * 256 + symbol) * 2 + 1]
            )
            put_value(@out, sink: @sink, v: v, size: s)
            run @ 0

    if run > 0
        put_bits(@out, sink: @sink, code: codes[ac * 256 * 2], length: codes[ac * 256 * 2 + 1])

# Adds the bytes of `more` to `out`.
function add(@out: [u8], more: [u8] lent)
    for b in more
        out @ out.push(b)

# `v`, 0 to 65,535, as two bytes, the high one first.
function two(v: i64) -> [u8]
    return [to_u8(v >> 8).must(), to_u8(v & 255).must()]

# The brightness, blue and red planes of `pixels`, `channels` 1 or 3 a
# pixel: for gray, the brightness alone.
function planes(pixels: [u8] lent, channels: i64) -> [[f64]]
    luma: [f64] @= []
    blue: [f64] @= []
    red: [f64] @= []
    count = pixels.len() / channels

    for i in range(from: 0, to: count)
        if channels == 1
            luma @ luma.push(to_f64(to_i64(pixels[i]).must()))
        else
            r = to_f64(to_i64(pixels[3 * i]).must())
            g = to_f64(to_i64(pixels[3 * i + 1]).must())
            b = to_f64(to_i64(pixels[3 * i + 2]).must())
            luma @ luma.push(0.299 * r + 0.587 * g + 0.114 * b)
            blue @ blue.push(-0.168736 * r - 0.331264 * g + 0.5 * b + 128.0)
            red @ red.push(0.5 * r - 0.418688 * g - 0.081312 * b + 128.0)

    return [luma, blue, red]

# The 64 samples of the block of `plane` (`width` by `height`) whose top
# left sample stands at column `x`, row `y` of a grid `step_x` by `step_y`
# times coarser: each the mean of the samples it covers, past the edge the
# last ones repeated.
function block_of(plane: [f64] lent, width: i64, height: i64, x: i64, y: i64, step_x: i64, step_y: i64) -> [f64]
    out: [f64] @= []

    for by in range(from: 0, to: 8)
        for bx in range(from: 0, to: 8)
            sum @= 0.0

            for dy in range(from: 0, to: step_y)
                for dx in range(from: 0, to: step_x)
                    px @= (x + bx) * step_x + dx
                    py @= (y + by) * step_y + dy

                    if px >= width
                        px @ width - 1

                    if py >= height
                        py @ height - 1
                    sum @ sum + plane[py * width + px]

            out @ out.push(sum / to_f64(step_x * step_y))

    return out

# A baseline JPEG of `width` by `height` pixels, `channels` 1 (gray) or 3
# (RGB) a pixel in `data`, at `quality` 1 to 100, the brightness sampled
# `h` by `v` times the colour (1 by 1, 2 by 1 or 2 by 2).
function encoded(width: i64, height: i64, data: [u8] lent, channels: i64, quality: i64, h: i64, v: i64) -> [u8]
    t = transform.cosines()
    zz = tables.zigzag()
    codes = annex_k_codes()
    luma_q = scaled(number: 0, quality: quality)
    chroma_q = scaled(number: 1, quality: quality)
    color = channels == 3

    hy = if color
        h
    else
        1

    vy = if color
        v
    else
        1
    p = planes(data, channels: channels)
    out: [u8] @= [0xff, 0xd8, 0xff, 0xe0, 0, 16, 0x4a, 0x46, 0x49, 0x46, 0, 1, 1, 0, 0, 1, 0, 1, 0, 0]

    tables_count = if color
        2
    else
        1
    add(out: @out, more: [0xff, 0xdb])
    add(out: @out, more: two(2 + 65 * tables_count))
    out @ out.push(0)

    for q in luma_q
        out @ out.push(to_u8(q).must())

    if color
        out @ out.push(1)

        for q in chroma_q
            out @ out.push(to_u8(q).must())
    add(out: @out, more: [0xff, 0xc0])
    add(out: @out, more: two(8 + 3 * channels))
    out @ out.push(8)
    add(out: @out, more: two(height))
    add(out: @out, more: two(width))
    out @ out.push(to_u8(channels).must())
    out @ out.push(1)
    out @ out.push(to_u8(hy << 4 | vy).must())
    out @ out.push(0)

    if color
        add(out: @out, more: [2, 0x11, 1, 3, 0x11, 1])
    dht = tables.annex_k_huffman()
    add(out: @out, more: [0xff, 0xc4])
    add(out: @out, more: two(2 + dht.len()))
    add(out: @out, more: dht)
    add(out: @out, more: [0xff, 0xda])
    add(out: @out, more: two(6 + 2 * channels))
    out @ out.push(to_u8(channels).must())
    add(out: @out, more: [1, 0x00])

    if color
        add(out: @out, more: [2, 0x11, 3, 0x11])
    add(out: @out, more: [0, 63, 0])
    sink @= Sink(held: 0, count: 0)
    preds: [i64] @= [0, 0, 0]
    mcus_x = (width + 8 * hy - 1) / (8 * hy)
    mcus_y = (height + 8 * vy - 1) / (8 * vy)

    for my in range(from: 0, to: mcus_y)
        for mx in range(from: 0, to: mcus_x)
            for by in range(from: 0, to: vy)
                for bx in range(from: 0, to: hy)
                    b = block_of(
                        p[0],
                        width: width,
                        height: height,
                        x: (mx * hy + bx) * 8,
                        y: (my * vy + by) * 8,
                        step_x: 1,
                        step_y: 1
                    )
                    pred @= preds[0]
                    put_block(
                        @out,
                        sink: @sink,
                        q: quantized(block: b, quant: luma_q, t: t, zz: zz),
                        pred: @pred,
                        codes: codes,
                        dc: 0,
                        ac: 1
                    )
                    preds[0] @ pred

            if color
                for c in range(from: 1, to: 3)
                    b = block_of(p[c], width: width, height: height, x: mx * 8, y: my * 8, step_x: hy, step_y: vy)
                    pred @= preds[c]
                    put_block(
                        @out,
                        sink: @sink,
                        q: quantized(block: b, quant: chroma_q, t: t, zz: zz),
                        pred: @pred,
                        codes: codes,
                        dc: 2,
                        ac: 3
                    )
                    preds[c] @ pred

    if sink.count > 0
        put_bits(@out, sink: @sink, code: (1 << 8 - sink.count) - 1, length: 8 - sink.count)
    add(out: @out, more: [0xff, 0xd9])
    return out

test "category: 0, the edges of each size, and negatives"
    assert category(0) == 0
    assert category(1) == 1
    assert category(-1) == 1
    assert category(2) == 2
    assert category(1023) == 10
    assert category(-1024) == 11

test "put_bits: bits gathered into bytes, a 255 stuffed"
    out: [u8] @= []
    sink @= Sink(held: 0, count: 0)
    put_bits(@out, sink: @sink, code: 0b101, length: 3)
    put_bits(@out, sink: @sink, code: 0b11111, length: 5)
    put_bits(@out, sink: @sink, code: 0xff, length: 8)
    assert out == [0b1011_1111, 0xff, 0]
    assert sink.count == 0

test "scaled: quality 50 is Annex K itself, 100 all ones, 1 held to 255"
    assert scaled(number: 0, quality: 50) == tables.annex_k_quantization(0)
    assert scaled(number: 0, quality: 100)[0] == 1
    assert scaled(number: 1, quality: 1)[63] == 255

test "annex_k_codes: the brightness DC codes of K.3"
    codes = annex_k_codes()
    assert codes[0] == 0
    assert codes[1] == 2
    assert codes[2 * 1] == 2
    assert codes[2 * 1 + 1] == 3
