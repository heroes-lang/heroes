# Lossy WebP files to test with, and what libwebp 1.6.0's `dwebp` reads from
# each on 2026-11-24: the CRC-32 of its RGBA pixels (`dwebp -pam`, the fancy
# upsampler, no dithering) and of its Y, U and V planes laid end to end
# (`dwebp -yuv`, its alpha plane left out). The files: pictures a program
# outside the tree drew, written by `cwebp` 1.6.0 at qualities 0 to 100, both
# loop filters, filter strengths, sharpness 0 to 7, one to four segments,
# with alpha raw and lossless, quantized, under the filters `cwebp` chose;
# and the raw alpha of one of them filtered horizontally, vertically and by
# gradient by a program outside the tree. Made by a program outside the tree;
# no program calls it.

# A lossy file and what `dwebp` reads from it.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The CRC-32 of the RGBA pixels.
    rgba_crc: i64
    # The CRC-32 of the Y, U and V planes.
    yuv_crc: i64
    # Whether the file holds alpha.
    alpha: bool

# The files.
function lossy() -> [Sample]
    return [
        Sample(name: "cwebp-17x13-o1", file: "524946463c000000574542505650382030000000f002009d012a11000d003ffdfeff7fbfbab6bbb00803f03f896c00b0ec36d00000fe442f87267944ae0575a299030000", width: 17, height: 13, rgba_crc: 4130618, yuv_crc: 3888074836, alpha: false)
        Sample(name: "cwebp-17x13-o2", file: "524946464e0000005745425056503820420000001003009d012a11000d003f99b4d05db92ea9a4b008032033096c009d3280056c1000fea2003b1206f31bb01565bdff2a38fd7378bcbedf5e099611a8501175640000", width: 17, height: 13, rgba_crc: 366936428, yuv_crc: 1946814528, alpha: false)
        Sample(name: "cwebp-17x13-o3", file: "524946466800000057454250565038205c000000f203009d012a11000d003f1172b05030292623b008060622096c009d3283180020eb43f04255150000d493e62bdd4d59c3a3617c9c99d27c3f28db318df1cd7021e612c4028fca04420aa23767a2d94b99056e7e1247b3a5c0000000", width: 17, height: 13, rgba_crc: 1898477315, yuv_crc: 2131764273, alpha: false)
        Sample(name: "cwebp-17x13-o4", file: "", width: 17, height: 13, rgba_crc: 2244608797, yuv_crc: 3872488382, alpha: false)
        Sample(name: "cwebp-17x13-o5", file: "", width: 17, height: 13, rgba_crc: 1263680449, yuv_crc: 1225622932, alpha: false)
        Sample(name: "cwebp-17x13-o6", file: "", width: 17, height: 13, rgba_crc: 68976394, yuv_crc: 802681733, alpha: false)
        Sample(name: "cwebp-17x13-o7", file: "", width: 17, height: 13, rgba_crc: 2004652244, yuv_crc: 569700359, alpha: false)
        Sample(name: "cwebp-17x13-o8", file: "", width: 17, height: 13, rgba_crc: 1994156292, yuv_crc: 744175463, alpha: false)
        Sample(name: "cwebp-17x13-o9", file: "52494646800000005745425056503820740000007004009d012a11000d003f1d5a8663ad24969800d511c536004e99418c1ec08c55b8ff00d9c25af3e0b9baf000d493c1f2fa208e62bbc559e0a7f4cc99e5a5b7c022927a9bb75185c104a15db9e2942d5802ec0c7addc3d86fecdfca05c40b7f66fee2679a6f676f1dfffe5139a55fcf3b4df800", width: 17, height: 13, rgba_crc: 354726426, yuv_crc: 1978555198, alpha: false)
        Sample(name: "cwebp-17x13-o10", file: "", width: 17, height: 13, rgba_crc: 2364943792, yuv_crc: 1471269333, alpha: false)
        Sample(name: "cwebp-alpha-19x23-a1", file: "", width: 19, height: 23, rgba_crc: 2518420561, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a2", file: "", width: 19, height: 23, rgba_crc: 2518420561, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a3", file: "", width: 19, height: 23, rgba_crc: 2518420561, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a4", file: "", width: 19, height: 23, rgba_crc: 2518420561, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a5", file: "", width: 19, height: 23, rgba_crc: 3305456876, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a6", file: "", width: 19, height: 23, rgba_crc: 2539653880, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a7", file: "", width: 19, height: 23, rgba_crc: 2518420561, yuv_crc: 3154651538, alpha: true)
        Sample(name: "cwebp-alpha-19x23-a8", file: "", width: 19, height: 23, rgba_crc: 3098892070, yuv_crc: 1532901102, alpha: true)
        Sample(name: "cwebp-1x1", file: "524946463a00000057454250565038202e0000009001009d012a0100010002003425a00274ba00039800fee9adff9247ab98e83ffbfd57fdfd57fdfd57f9b2000000", width: 1, height: 1, rgba_crc: 3155712088, yuv_crc: 3231089335, alpha: false)
        Sample(name: "cwebp-40x34", file: "", width: 40, height: 34, rgba_crc: 2361731454, yuv_crc: 2227272605, alpha: false)
        Sample(name: "cwebp-alpha-vertical", file: "", width: 21, height: 18, rgba_crc: 1958725798, yuv_crc: 3455854608, alpha: true)
        Sample(name: "cwebp-alpha-vertical-2", file: "", width: 21, height: 18, rgba_crc: 3124668815, yuv_crc: 1451457722, alpha: true)
        Sample(name: "raw-alpha-horizontal", file: "", width: 21, height: 18, rgba_crc: 1958725798, yuv_crc: 3455854608, alpha: true)
        Sample(name: "raw-alpha-vertical", file: "", width: 21, height: 18, rgba_crc: 1958725798, yuv_crc: 3455854608, alpha: true)
        Sample(name: "raw-alpha-gradient", file: "", width: 21, height: 18, rgba_crc: 1958725798, yuv_crc: 3455854608, alpha: true)
    ]

# An animation `webpmux` 1.6.0 laid out from two of the lossy files, the second
# with alpha, at 2, 4, shown 120 ms, cleared after and not blended; the first
# shown 80 ms and blended; three loops.
function animation() -> str
    return ""

# The CRC-32 of the RGBA `dwebp` reads from each of its frames, taken out
# alone by `webpmux -get frame`.
function animation_crcs() -> [i64]
    return [1994156292, 2518420561]
