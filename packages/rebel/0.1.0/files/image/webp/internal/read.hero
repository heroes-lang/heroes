# A WebP file read: its chunks followed, each lossless frame decoded, and what
# the extended format says about the canvas, the loop and the metadata kept
# beside the frames.

use image
use image/webp/internal/riff
use image/webp/internal/stream

# One frame decoded, as the file lays it out.
record Raw
    # The pixels: RGB where the stream says alpha is unused and it is all 255.
    image: image.Image
    # The column of the left edge on the canvas.
    x: i64
    # The row of the top edge.
    y: i64
    # The time it shows, in milliseconds.
    duration: i64
    # Whether it replaces what is under it.
    replaces: bool
    # Whether its rectangle is cleared after it.
    clears: bool

# A file read.
record Parsed
    # The canvas width.
    width: i64
    # The canvas height.
    height: i64
    # The frames.
    frames: [Raw]
    # Whether the file is an animation.
    animated: bool
    # The loop count of an animation.
    loops: i64
    # The background colour, red, green, blue and alpha.
    background: [i64]
    # The ICC profile.
    icc: [u8]
    # The EXIF data.
    exif: [u8]
    # The XMP data.
    xmp: [u8]

# The frame of the lossless stream `data`. Fails as `stream.decode` fails.
function frame_of(data: [u8] lent, limits: image.Limits) -> Raw?
    d = stream.decode(data, limits)?
    opaque @= !d.alpha_used

    for i in range(from: 0, to: d.width * d.height)
        if d.pixels[i * 4 + 3] != 255
            opaque @ false

    if opaque
        rgb: [u8] @= []

        for i in range(from: 0, to: d.width * d.height)
            for c in range(from: 0, to: 3)
                rgb @ rgb.push(d.pixels[i * 4 + c])

        return ok(
            Raw(image: image.from_pixels(width: d.width, height: d.height, format: .rgb, pixels: rgb)?, x: 0, y: 0, duration: 0, replaces: true, clears: false)
        )
    return ok(
        Raw(image: image.from_pixels(width: d.width, height: d.height, format: .rgba, pixels: d.pixels)?, x: 0, y: 0, duration: 0, replaces: true, clears: false)
    )

# The frame of the ANMF chunk payload `d` on a canvas of `canvas_width` by
# `canvas_height`. Fails `invalid` where the payload is short, its picture is
# not the size it says or lies outside the canvas, and `unsupported` for a
# lossy picture.
function animated_frame(d: [u8] lent, canvas_width: i64, canvas_height: i64, limits: image.Limits) -> Raw?
    if d.len() < 16
        return fail(code: image.INVALID, msg: f"an animation frame of {d.len()} bytes, where its header takes 16")
    x = riff.le24(d, at: 0) * 2
    y = riff.le24(d, at: 3) * 2
    width = riff.le24(d, at: 6) + 1
    height = riff.le24(d, at: 9) + 1
    duration = riff.le24(d, at: 12)
    flags = to_i64(d[15]).must()

    if x + width > canvas_width || y + height > canvas_height
        return fail(
            code: image.INVALID,
            msg: f"a frame of {width} by {height} at {x}, {y} outside a canvas of {canvas_width} by {canvas_height}"
        )
    parts = riff.chunks_in(d, from: 16, end: d.len())?

    for p in parts
        if p.tag == "VP8 " || p.tag == "ALPH"
            return fail(
                code: image.UNSUPPORTED,
                msg: "a lossy WebP frame (VP8, with or without ALPH): this reads the lossless coding"
            )

        if p.tag == "VP8L"
            f = frame_of(p.data, limits: limits)?

            if f.image.width != width || f.image.height != height
                return fail(
                    code: image.INVALID,
                    msg: f"a frame that says {width} by {height} holding a picture of {f.image.width} by {f.image.height}"
                )
            return ok(
                Raw(image: f.image, x: x, y: y, duration: duration, replaces: flags & 2 != 0, clears: flags & 1 != 0)
            )

    return fail(code: image.INVALID, msg: "an animation frame with no picture")

# The file `data`, read. Fails as the face's `decode` says.
function parse(data: [u8] lent, limits: image.Limits) -> Parsed?
    chunks = riff.chunks_of(data)?
    first = chunks[0]
    nothing = Parsed(
        width: 0,
        height: 0,
        frames: [],
        animated: false,
        loops: 0,
        background: [0, 0, 0, 0],
        icc: [],
        exif: [],
        xmp: []
    )

    if first.tag == "VP8L"
        f = frame_of(first.data, limits: limits)?
        return ok(
            Parsed(width: f.image.width, height: f.image.height, frames: [f], animated: false, loops: 0, background: [0, 0, 0, 0], icc: [], exif: [], xmp: [])
        )

    if first.tag == "VP8 "
        return fail(code: image.UNSUPPORTED, msg: "a lossy WebP (VP8): this reads the lossless coding")

    if first.tag != "VP8X" || first.data.len() < 10
        return fail(
            code: image.INVALID,
            msg: f"a WebP file whose first chunk is `{first.tag}`, where VP8, VP8L or VP8X begin one"
        )
    flags = to_i64(first.data[0]).must()
    width = riff.le24(first.data, at: 4) + 1
    height = riff.le24(first.data, at: 7) + 1
    image.check_limits(limits, width: width, height: height)?
    out @= nothing
    out.width @ width
    out.height @ height
    out.animated @ flags & 2 != 0
    budget @= limits.max_pixels - width * height

    for c in chunks.slice(from: 1, to: chunks.len())
        if c.tag == "ICCP"
            out.icc @ c.data
        else if c.tag == "EXIF"
            out.exif @ c.data
        else if c.tag == "XMP "
            out.xmp @ c.data
        else if c.tag == "ANIM" && c.data.len() >= 6
            out.background @ [
                to_i64(c.data[2]).must()
                to_i64(c.data[1]).must()
                to_i64(c.data[0]).must()
                to_i64(c.data[3]).must()
            ]
            out.loops @ riff.le16(c.data, at: 4)
        else if c.tag == "ANMF"
            own = image.Limits(max_width: limits.max_width, max_height: limits.max_height, max_pixels: budget)
            placed = animated_frame(c.data, canvas_width: width, canvas_height: height, limits: own)?
            budget @ budget - placed.image.width * placed.image.height
            out.frames @ out.frames.push(placed)
        else if c.tag == "VP8L" && !out.animated && out.frames.len() == 0
            f = frame_of(c.data, limits: limits)?

            if f.image.width != width || f.image.height != height
                return fail(
                    code: image.INVALID,
                    msg: f"a canvas of {width} by {height} holding a picture of {f.image.width} by {f.image.height}"
                )
            out.frames @ out.frames.push(f)
        else if c.tag == "VP8 " || c.tag == "ALPH"
            return fail(
                code: image.UNSUPPORTED,
                msg: "a lossy WebP frame (VP8, with or without ALPH): this reads the lossless coding"
            )

    if out.frames.len() == 0
        return fail(code: image.INVALID, msg: "an extended WebP file with no frame")
    return ok(out)
