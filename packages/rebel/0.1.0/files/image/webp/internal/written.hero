# Files the lossy encoder wrote on 2026-11-24, and what libwebp 1.6.0's
# `dwebp` reads from each: the CRC-32 of its RGBA pixels (`dwebp -pam`) and
# the squared error of their red, green and blue against the source, and its
# PSNR in decibels rounded down, computed by a program outside the tree. The sources are two
# pictures that program drew, one opaque and one with alpha; the settings run
# through every quality class, filter, sharpness, segment count and token
# partition count. Made by a program outside the tree; no program calls it.

use bytes
use image

# A source picture, RGBA.
record Source
    # Its name.
    name: str
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The pixels, RGBA, as hexadecimal text.
    pixels: str

# A file written and what `dwebp` reads from it.
record Written
    # The source's name.
    source: str
    # The quality.
    quality: i64
    # The loop filter.
    filter: i64
    # The sharpness.
    sharpness: i64
    # The segments.
    segments: i64
    # The token partitions.
    partitions: i64
    # The file, as hexadecimal text.
    file: str
    # The CRC-32 of the RGBA pixels `dwebp` reads.
    crc: i64
    # Their PSNR against the source, rounded down.
    psnr: i64
    # The sum of the squared differences of their red, green and blue from
    # the source's.
    error: i64

# The sources.
function sources() -> [Source]
    return [
        Source(name: "smooth40x30", width: 40, height: 30, pixels: "")
        Source(name: "a19x23", width: 19, height: 23, pixels: "")
        Source(name: "p1x1", width: 1, height: 1, pixels: "00e0c8ff")
    ]

# The files.
function files() -> [Written]
    return [
        Written(source: "smooth40x30", quality: 100, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "", crc: 1292390128, psnr: 27, error: 451287)
        Written(source: "smooth40x30", quality: 75, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "", crc: 2895898591, psnr: 26, error: 550198)
        Written(source: "smooth40x30", quality: 30, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "", crc: 2054444178, psnr: 23, error: 1080926)
        Written(source: "smooth40x30", quality: 0, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "524946466e000000574542505650382061000000f003009d012a28001e003a430b2260cd5e0300d07082201fc0000606d0ea1791d6b02690806348c500feb11c0412bd29c1a37555272eb53ddb4fafc732fb6775675b33d7c7fc0f2e3b19a24574dc0ad1c35dc40ff2070b603c0fba677e3d6e7e0000", crc: 2725162731, psnr: 20, error: 1933151)
        Written(source: "smooth40x30", quality: 60, filter: 1, sharpness: 3, segments: 2, partitions: 2, file: "", crc: 3163871819, psnr: 25, error: 692110)
        Written(source: "smooth40x30", quality: 50, filter: 0, sharpness: 0, segments: 3, partitions: 4, file: "", crc: 2004522740, psnr: 23, error: 988058)
        Written(source: "smooth40x30", quality: 90, filter: 2, sharpness: 7, segments: 4, partitions: 8, file: "", crc: 1305900937, psnr: 26, error: 491952)
        Written(source: "smooth40x30", quality: 75, filter: 2, sharpness: 5, segments: 1, partitions: 1, file: "", crc: 1682830170, psnr: 26, error: 573297)
        Written(source: "smooth40x30", quality: 20, filter: 1, sharpness: 7, segments: 1, partitions: 8, file: "", crc: 2818761559, psnr: 22, error: 1394089)
        Written(source: "a19x23", quality: 75, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "", crc: 1622897898, psnr: 23, error: 402500)
        Written(source: "a19x23", quality: 40, filter: 1, sharpness: 2, segments: 2, partitions: 2, file: "", crc: 2318771099, psnr: 20, error: 755520)
        Written(source: "a19x23", quality: 95, filter: 0, sharpness: 0, segments: 1, partitions: 4, file: "", crc: 3989874718, psnr: 24, error: 305238)
        Written(source: "p1x1", quality: 75, filter: 2, sharpness: 0, segments: 4, partitions: 1, file: "524946464600000057454250565038203a000000d002009d012a010001003a27078344a1484ffffffe3870822008000006077400feea2afffed4fcacf77df77fffe0cefffe0cefffe0ceffc10400", crc: 2333501747, psnr: 45, error: 5)
    ]

# The source picture `name` as an RGBA image, or a blank one of 1 by 1 where
# no source is so named.
function image_of(name: str) -> image.Image
    for s in sources()
        if s.name == name
            return image.from_pixels(
                width: s.width,
                height: s.height,
                format: .rgba,
                pixels: bytes.parse_hex(s.pixels).must()
            ).must()

    return image.blank(width: 1, height: 1, format: .rgba).must()
