# A netpbm file read: its magic number, its header's numbers (whitespace
# and comments between them), or a PAM's lines of fields up to `ENDHDR`,
# then its samples, as decimal text or raw, one byte each or two where the
# maximum value passes 255. Every number is read with a bound on its
# digits, and every read checked against the data's length.

use image

# What a header says, and where its samples begin.
record Header
    # 1 to 7, the digit of the magic number.
    kind: i64
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The largest value of a sample: 1 for PBM.
    maxval: i64
    # The samples a pixel, 1 to 4.
    depth: i64
    # Where the samples begin.
    start: i64

# Whether `c` is whitespace to netpbm: space, tab, newline, carriage
# return, vertical tab or form feed.
function is_space(c: u8) -> bool
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12

# Where the next token of `data` from `at` begins: whitespace and comments,
# from `#` to the end of the line, passed over.
function skip(data: [u8] lent, at: i64) -> i64
    p @= at

    while p < data.len()
        if is_space(data[p])
            p @ p + 1
        else if data[p] == '#'
            while p < data.len() && data[p] != '\n' && data[p] != '\r'
                p @ p + 1
        else
            return p

    return p

# A number read from `data` at `at`, at most 10 digits, and where it ends,
# as two elements. Fails `invalid` where no digit stands there or there are
# more than 10.
function number_at(data: [u8] lent, at: i64) -> [i64]?
    p @= at
    v @= 0

    while p < data.len() && data[p] >= '0' && data[p] <= '9'
        if p - at >= 10
            return fail(code: image.INVALID, msg: f"a number at byte {at} of more than 10 digits")
        v @ v * 10 + to_i64(data[p] - '0').must()
        p @ p + 1

    if p == at
        return fail(code: image.INVALID, msg: f"byte {at} is not a digit, where a number of the header stands")
    return ok([v, p])

# The header of `data`. Fails `invalid` where it is not netpbm's,
# `unsupported` for a PAM of depth past 4.
function header_of(data: [u8] lent) -> Header?
    if data.len() < 3 || data[0] != 'P' || data[1] < '1' || data[1] > '7' || !is_space(data[2])
        return fail(
            code: image.INVALID,
            msg: "the data does not begin with a netpbm magic number, P1 to P7, and a space"
        )
    kind = to_i64(data[1] - '0').must()

    if kind == 7
        return pam_header(data)
    w = number_at(data, at: skip(data, at: 2))?
    h = number_at(data, at: skip(data, at: w[1]))?
    bitmap = kind == 1 || kind == 4

    m = if bitmap
        [1, h[1]]
    else
        number_at(data, at: skip(data, at: h[1]))?

    if m[0] < 1 || m[0] > 65535
        return fail(code: image.INVALID, msg: f"a maximum value of {m[0]}, where 1 to 65,535 are allowed")

    start = if kind >= 4
        if m[1] >= data.len() || !is_space(data[m[1]])
            return fail(code: image.INVALID, msg: f"no whitespace at byte {m[1]} after the header of a raw netpbm file")
        m[1] + 1
    else
        m[1]

    depth = if kind == 3 || kind == 6
        3
    else
        1
    return ok(Header(kind: kind, width: w[0], height: h[0], maxval: m[0], depth: depth, start: start))

# Whether the bytes of `data` from `at` to `end` spell `word`.
function spells(data: [u8] lent, at: i64, end: i64, word: str) -> bool
    if end - at != word.len()
        return false

    for i in range(from: 0, to: word.len())
        if data[at + i] != word[i]
            return false

    return true

# The header of the PAM `data`: its lines of fields up to `ENDHDR`.
function pam_header(data: [u8] lent) -> Header?
    p @= 3
    width @= -1
    height @= -1
    depth @= -1
    maxval @= -1

    while true
        p @ skip(data, at: p)

        if p >= data.len()
            return fail(code: image.INVALID, msg: "a PAM header with no ENDHDR")
        end @= p

        while end < data.len() && !is_space(data[end])
            end @ end + 1

        if spells(data, at: p, end: end, word: "ENDHDR")
            while end < data.len() && data[end] != '\n'
                end @ end + 1

            if end >= data.len() && (width < 0 || height < 0)
                return fail(code: image.INVALID, msg: "a PAM header that ends without its samples")

            if width < 0 || height < 0 || depth < 0 || maxval < 0
                return fail(code: image.INVALID, msg: "a PAM header without WIDTH, HEIGHT, DEPTH or MAXVAL")

            if depth < 1 || depth > 4
                return fail(code: image.UNSUPPORTED, msg: f"a PAM of depth {depth}, where 1 to 4 are read")

            if maxval < 1 || maxval > 65535
                return fail(code: image.INVALID, msg: f"a maximum value of {maxval}, where 1 to 65,535 are allowed")
            return ok(Header(kind: 7, width: width, height: height, maxval: maxval, depth: depth, start: end + 1))
        numeric = spells(data, at: p, end: end, word: "WIDTH") || spells(data, at: p, end: end, word: "HEIGHT") || spells(data, at: p, end: end, word: "DEPTH") || spells(data, at: p, end: end, word: "MAXVAL")

        if numeric
            n = number_at(data, at: skip(data, at: end))?

            if spells(data, at: p, end: end, word: "WIDTH")
                width @ n[0]
            else if spells(data, at: p, end: end, word: "HEIGHT")
                height @ n[0]
            else if spells(data, at: p, end: end, word: "DEPTH")
                depth @ n[0]
            else
                maxval @ n[0]
            p @ n[1]
        else
            while end < data.len() && data[end] != '\n'
                end @ end + 1

            p @ end

# The samples of the file `data` whose header is `h`: width × height ×
# depth of them, each 0 to `h.maxval`; a PBM's bits as 0 and 1. Fails
# `invalid` where there are too few or one passes the maximum value.
function samples_of(data: [u8] lent, h: Header lent) -> [i64]?
    count = h.width * h.height * h.depth
    out: [i64] @= []

    if h.kind == 4
        stride = (h.width + 7) / 8

        if stride * h.height > data.len() - h.start
            return fail(
                code: image.INVALID,
                msg: f"{h.height} rows of {stride} bytes from byte {h.start} run past the end of the file"
            )

        for y in range(from: 0, to: h.height)
            for x in range(from: 0, to: h.width)
                byte = to_i64(data[h.start + y * stride + x / 8]).must()
                out @ out.push(byte >> 7 - x % 8 & 1)

        return ok(out)

    if h.kind == 1
        p @= h.start

        while out.len() < count
            p @ skip(data, at: p)

            if p >= data.len() || data[p] != '0' && data[p] != '1'
                return fail(
                    code: image.INVALID,
                    msg: f"byte {p} is not a bit, where {count - out.len()} more of a PBM stand"
                )
            out @ out.push(to_i64(data[p] - '0').must())
            p @ p + 1

        return ok(out)

    if h.kind <= 3
        p @= h.start

        while out.len() < count
            n = number_at(data, at: skip(data, at: p))?

            if n[0] > h.maxval
                return fail(code: image.INVALID, msg: f"a sample of {n[0]} past the maximum value {h.maxval}")
            out @ out.push(n[0])
            p @ n[1]

        return ok(out)

    size = if h.maxval > 255
        2
    else
        1

    if count > (data.len() - h.start) / size
        return fail(
            code: image.INVALID,
            msg: f"{count} samples of {size} bytes from byte {h.start} run past the end of the file"
        )

    for i in range(from: 0, to: count)
        at = h.start + i * size

        v = if size == 2
            to_i64(data[at]).must() << 8 | to_i64(data[at + 1]).must()
        else
            to_i64(data[at]).must()

        if v > h.maxval
            return fail(code: image.INVALID, msg: f"a sample of {v} past the maximum value {h.maxval}")
        out @ out.push(v)

    return ok(out)

test "skip and number_at: comments, spaces, ten digits and more"
    data: [u8] = [0x20, 0x23, 0x61, 0x0a, 0x34, 0x32, 0x20]
    at = skip(data, at: 0)
    assert at == 4
    assert number_at(data, at: at).must() == [42, 6]
    many: [u8] = [0x31, 0x31, 0x31, 0x31, 0x31, 0x31, 0x31, 0x31, 0x31, 0x31, 0x31]
    assert number_at(many, at: 0).is_err()
    assert number_at(many.slice(from: 0, to: 10), at: 0).must()[0] == 1111111111
    assert number_at([0x78], at: 0).is_err()
