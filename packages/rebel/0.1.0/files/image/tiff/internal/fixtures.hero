# TIFF files to test with, made on 2026-11-23 by this tree's generator
# program outside the tree out of a pixel pattern known by construction,
# written uncompressed by a small TIFF writer (every layout it did not leave
# alone: tiles, planes, compressions, predictors, fill orders, BigTIFF and a
# second byte order were made from those files by libtiff 4.7.2's `tiffcp`),
# with the pixels that construction gives, laid out as `image` holds them, as
# hexadecimal text; a large image holds the CRC-32 of its pixels instead. The
# CMYK and YCbCr pixels are libtiff's `tiff2rgba` answer to the same file,
# which converts by its own fixed-point tables, so those cases hold a slack in
# levels. Made by a program outside the tree; no program calls it.

# A file and what reading it answers.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The format the pixels are laid out in, as `image.Format` names it.
    format: str
    # The pixels, as hexadecimal text; empty where `crc` stands in.
    pixels: str
    # The CRC-32 of the pixels where they are not written out, else 0.
    crc: i64
    # The most levels a sample may differ from the pixels.
    slack: i64

# The files read, with their pixels.
function readable() -> [Sample]
    return [
        Sample(name: "gray8_none", file: "", width: 13, height: 11, format: "gray", pixels: "00254a6f94b9de03284d7297bc5b8bbbeb1b4b7b5e8ebeee1e4eb6f12c675590cbb9f42f6a589311579d96dcd51b145aa099dfd86cbdc11216676b6fc0c415196ac72332419dacbbca263544a0af2289a3bdd7f10b258ca6c0daf47da2c7ec11365b80a5caef1439d808386898c8f8db0b3b6b9bcb336ea9e4d20d483671ace7d5108ed41a1359529891d71d165c55", crc: 0, slack: 0)
