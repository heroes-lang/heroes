# Every file refused; beside each, what Go's `png.Decode` answers.
function refused() -> [Broken]
    return [
        # Go: png: invalid format: invalid checksum
        Broken(name: "a header whose CRC is wrong", file: "89504e470d0a1a0a0000000d4948445200000003000000020800000000b81e39c60000001549444154789c000800f7ff000001020001020303000022000aefb04a3b0000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: unexpected EOF
        Broken(name: "a file cut inside its data", file: "89504e470d0a1a0a0000000d4948445200000003000000020800000000b81f39c60000001549444154789c000800f7ff00000102000102030300", code: "invalid")
        # Go: png: invalid format: not a PNG file
        Broken(name: "no signature", file: "504e470d0a1a0a0000000d4948445200000003000000020800000000b81f39c60000001549444154789c000800f7ff000001020001020303000022000aefb04a3b0000000049454e44ae426082", code: "invalid")
        # Go: png: unsupported feature: bit depth 3, color type 0
        Broken(name: "a depth of 3 bits", file: "89504e470d0a1a0a0000000d4948445200000002000000020300000000200d63e90000001149444154789c000400fbff000000000300000400012efae3d30000000049454e44ae426082", code: "invalid")
        # Go: png: unsupported feature: bit depth 8, color type 5
        Broken(name: "colour type 5", file: "89504e470d0a1a0a0000000d49484452000000020000000208050000006003a2ca0000001349444154789c000600f9ff0000000000000300000600013bd20d4b0000000049454e44ae426082", code: "invalid")
        # Go: png: unsupported feature: compression method
        Broken(name: "compression method 1", file: "89504e470d0a1a0a0000000d4948445200000002000000020800010000561f38cf0000001349444154789c000600f9ff0000000000000300000600013bd20d4b0000000049454e44ae426082", code: "unsupported")
        # Go: png: invalid format: invalid interlace method
        Broken(name: "interlace method 2", file: "89504e470d0a1a0a0000000d4948445200000002000000020800000002b9d333d40000001349444154789c000600f9ff0000000000000300000600013bd20d4b0000000049454e44ae426082", code: "unsupported")
        # Go: png: invalid format: bad filter type
        Broken(name: "a filter type of 5", file: "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000001349444154789c000600f9ff05000000000003000024000606dc7d760000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: not enough pixel data
        Broken(name: "image data one byte short", file: "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000001249444154789c000500faff0000000000030000050001f952a8350000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: too much pixel data
        Broken(name: "image data one byte long", file: "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000001449444154789c000700f8ff00000000000000030000070001f42e958e0000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: chunk out of order
        Broken(name: "a palette file with no PLTE", file: "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd160000001349444154789c000600f9ff0000000000000300000600013bd20d4b0000000049454e44ae426082", code: "invalid")
        # Go: accepts it
        Broken(name: "an index past the palette", file: "89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8fb800000003504c54450102030d8764d50000001049444154789c000300fcff000001030000040002ffe43ebf0000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: bad PLTE length
        Broken(name: "a PLTE of 4 entries for 1 bit", file: "89504e470d0a1a0a0000000d4948445200000002000000010103000000ceecedc90000000c504c544500000000000000000000000035e937960000000f49444154789c000200fdff00000300000200018ade628b0000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: tRNS, color type mismatch
        Broken(name: "a tRNS on gray and alpha", file: "89504e470d0a1a0a0000000d4948445200000001000000010804000000b51c0c020000000274524e5300007693cd380000001049444154789c000300fcff000000030000030001c5d572340000000049454e44ae426082", code: "invalid")
        # Go: accepts it
        Broken(name: "an unknown critical chunk", file: "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b55000000005a5a5a5a2f3596880000000f49444154789c000200fdff00000300000200018ade628b0000000049454e44ae426082", code: "unsupported")
        # Go: png: invalid format: non-positive dimension
        Broken(name: "a width of 0", file: "89504e470d0a1a0a0000000d4948445200000000000000010800000000d5bcf06b0000000e49444154789c000100feff0003000001000191697da50000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: chunk out of order
        Broken(name: "no IDAT", file: "89504e470d0a1a0a0000000d49484452000000010000000108000000003a7e9b550000000049454e44ae426082", code: "invalid")
        # Go: png: invalid format: not enough pixel data
        Broken(name: "a bomb of 100,000 by 100,000", file: "89504e470d0a1a0a0000000d49484452000186a0000186a008000000008d3954140000001149444154789c621805a360140c7b00180003e8000107a50ba10000000049454e44ae426082", code: "limit")
        # Go: png: invalid format: not enough pixel data
        Broken(name: "a bomb of 60,000 by 60,000, each side allowed", file: "89504e470d0a1a0a0000000d494844520000ea600000ea60080600000080d275420000001149444154789c621805a360140c7b00180003e8000107a50ba10000000049454e44ae426082", code: "limit")
    ]

# The format a sample's `format` names.
function format_named(name: str) -> image.Format
    return match name
        "gray"         => .gray
        "gray_alpha"   => .gray_alpha
        "rgb"          => .rgb
        "rgba"         => .rgba
        "gray16"       => .gray16
        "gray_alpha16" => .gray_alpha16
        "rgb16"        => .rgb16
        _              => .rgba16
