# PNG files to test with, made on 2026-11-18 by Go 1.27's `image/png` and
# by a writer of PNG in Go for what Go's encoder never writes (gray of 1,
# 2 and 4 bits, gray and alpha, `tRNS`, interlacing, every filter, chunks
# around the data), each with the pixels Go's `png.Decode` answers, laid
# out as `image` holds them, as hexadecimal text. Made by a program outside
# the tree; no program calls it.

use image

# A file and what reading it answers.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The columns Go read.
    width: i64
    # The rows Go read.
    height: i64
    # The format the pixels are laid out in, as `image.Format` names it.
    format: str
    # The pixels, as hexadecimal text.
    pixels: str

# A file reading refuses, with the code it fails with.
record Broken
    # What is wrong with it.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The code `decode` fails with.
    code: str

# Every file read, with Go's pixels.
function readable() -> [Sample]
    return [
        Sample(name: "go gray 8", file: "89504e470d0a1a0a0000000d4948445200000009000000070800000000fff038bc0000005349444154789c004600b9ff04112525252525252525016c323232323232323201c73f3f3f3f3f3f3f3f00226eba06529eea3682007dd62f88e13a93ec4500d83ea40a70d63ca2080033a6198cff72e558cb030090d417ad75f195570000000049454e44ae426082", width: 9, height: 7, format: "gray", pixels: "11365b80a5caef14396c9ed002346698cafcc7064584c3024180bf226eba06529eea36827dd62f88e13a93ec45d83ea40a70d63ca20833a6198cff72e558cb")
