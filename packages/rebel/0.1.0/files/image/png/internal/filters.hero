# The five filters of PNG (section 9): each byte of a row stored as its
# difference from a guess made of its neighbours, the byte to its left (one
# pixel back), the byte above it, and the byte above the left. Undone in
# place on the inflated data when reading; chosen and applied row by row
# when writing.

use image

# Paeth's predictor of `a` (left), `b` (above) and `c` (upper left): the
# one nearest to a + b - c, `a` first where they tie, then `b`.
function paeth(a: i64, b: i64, c: i64) -> i64
    p = a + b - c
    pa = abs(p - a)
    pb = abs(p - b)
    pc = abs(p - c)

    if pa <= pb && pa <= pc
        return a

    if pb <= pc
        return b
    return c

# `v` without its sign.
function abs(v: i64) -> i64
    if v < 0
        return -v
    return v

# Undoes the filter of the row whose filter byte is at `at` in `raw`,
# `size` bytes after it, in place: the row above begins at `above`, or is
# none where `above` is below 0. `step` is the bytes a pixel, at least 1.
# Fails `invalid` where the filter byte passes 4.
function unfilter(@raw: [u8], at: i64, size: i64, above: i64, step: i64) -> ()?
    kind = raw[at]

    if kind > 4
        return fail(
            code: image.INVALID,
            msg: f"a row of the image data at byte {at} has filter type {kind}, where PNG defines 0 to 4"
        )

    if kind == 0
        return ok()
    first = at + 1

    for i in range(from: 0, to: size)
        left = if i >= step
            to_i64(raw[first + i - step]).must()
        else
            0

        up = if above >= 0
            to_i64(raw[above + 1 + i]).must()
        else
            0

        corner = if above >= 0 && i >= step
            to_i64(raw[above + 1 + i - step]).must()
        else
            0

        guess = if kind == 1
            left
        else if kind == 2
            up
        else if kind == 3
            (left + up) / 2
        else
            paeth(a: left, b: up, c: corner)
        raw[first + i] @ to_u8(to_i64(raw[first + i]).must() + guess & 255).must()

    return ok()

# The row `row` filtered by filter `kind` (0 to 4) against the row above,
# `above`, empty where there is none, its filter byte first. `step` is the
# bytes a pixel, at least 1.
function filtered(row: [u8] lent, above: [u8] lent, kind: i64, step: i64) -> [u8]
    out: [u8] @= [to_u8(kind).must()]

    for i in range(from: 0, to: row.len())
        left = if i >= step
            to_i64(row[i - step]).must()
        else
            0

        up = if above.len() > 0
            to_i64(above[i]).must()
        else
            0

        corner = if above.len() > 0 && i >= step
            to_i64(above[i - step]).must()
        else
            0

        guess = if kind == 1
            left
        else if kind == 2
            up
        else if kind == 3
            (left + up) / 2
        else if kind == 4
            paeth(a: left, b: up, c: corner)
        else
            0
        out @ out.push(to_u8(to_i64(row[i]).must() - guess & 255).must())

    return out

# The cost the adaptive choice gives a filtered row: the sum of its bytes
# read as signed, without their signs, its filter byte left out.
function cost_of(filtered_row: [u8] lent) -> i64
    total @= 0

    for i in range(from: 1, to: filtered_row.len())
        v = to_i64(filtered_row[i]).must()

        if v < 128
            total @ total + v
        else
            total @ total + 256 - v

    return total

# The row `row` filtered by whichever of the five filters costs least,
# the first of those that tie.
function cheapest(row: [u8] lent, above: [u8] lent, step: i64) -> [u8]
    best @= filtered(row: row, above: above, kind: 0, step: step)
    best_cost @= cost_of(best)

    for kind in range(from: 1, to: 5)
        f = filtered(row: row, above: above, kind: kind, step: step)
        c = cost_of(f)

        if c < best_cost
            best @ f
            best_cost @ c

    return best

test "paeth: the nearest of the three, ties to the left then above"
    assert paeth(a: 10, b: 20, c: 10) == 20
    assert paeth(a: 10, b: 20, c: 20) == 10
    assert paeth(a: 5, b: 5, c: 5) == 5
    assert paeth(a: 0, b: 0, c: 255) == 0

test "filtered and unfilter: every filter undone, with and without a row above"
    above: [u8] = [200, 10, 0, 255, 128, 7]
    row: [u8] = [3, 250, 17, 0, 255, 99]

    for kind in range(from: 0, to: 5)
        for has_above in [false, true]
            prior: [u8] = if has_above
                above
            else
                []
            f = filtered(row: row, above: prior, kind: kind, step: 2)
            raw: [u8] @= []

            at_above = if has_above
                0
            else
                -1

            if has_above
                raw @ raw.push(0)

                for b in above
                    raw @ raw.push(b)
            start = raw.len()

            for b in f
                raw @ raw.push(b)

            assert !unfilter(@raw, at: start, size: row.len(), above: at_above, step: 2).is_err()
            assert raw.slice(from: start + 1, to: raw.len()) == row

test "unfilter: a filter type past 4 is refused"
    raw: [u8] @= [5, 1, 2]
    assert unfilter(@raw, at: 0, size: 2, above: -1, step: 1).is_err()

test "cheapest: a flat row is cheapest as sub, a row equal to the one above as up"
    assert cheapest(row: [9, 9, 9, 9], above: [], step: 1)[0] == 1
    assert cheapest(row: [40, 90, 20, 70], above: [40, 90, 20, 70], step: 1)[0] == 2
    assert cost_of([1, 255, 1, 128]) == 1 + 1 + 128
