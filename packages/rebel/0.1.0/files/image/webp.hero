# WebP read and written: still pictures and animations, lossless, with the
# ICC profile, EXIF and XMP chunks of the extended format. A lossless frame
# is read in full (every transform, the colour cache and the groups of
# codes) and written with a colour index or a green-subtracted, predicted
# picture and Huffman codes of its own.
#
# It does not convert or scale: that is `image`'s. It does not decode the
# lossy coding (VP8, with or without an ALPH chunk) and fails `unsupported`
# for it, the message saying which frame.
#
# **A file is not trusted.** `decode` checks every chunk against the file's
# length, the canvas and every frame against the caller's `image.Limits` (the
# pixels of all the frames together against `max_pixels`) before it allocates,
# every prefix code for completeness, and every copy of earlier pixels against
# the pixels written, so a broken or hostile file fails `invalid` or `limit`
# and never reads past its end.
#
# It fails with `invalid`, `limit` and `unsupported`.
#
# Not written yet, each a `pending` block of its ledger: the lossy VP8 coding
# read and written.

use bytes
use hash
use image
use image/webp/internal/build
use image/webp/internal/expect
use image/webp/internal/fixtures
use image/webp/internal/read
use image/webp/internal/riff
use image/webp/internal/stream

## Codes

# The code of a value the file does not hold.
constant NOT_FOUND: str
    "not_found"

## Reading

# One frame of a picture: its pixels and where and how it is drawn.
record Frame
    # The pixels: RGB where the stream says its alpha is unused and it is
    # all 255, RGBA otherwise.
    image: image.Image
    # The column of the frame's left edge on the canvas, even.
    x: i64
    # The row of its top edge, even.
    y: i64
    # How long it shows, in milliseconds; 0 for a still picture.
    duration_ms: i64
    # Whether it replaces what is under it, rather than being laid over it
    # by its alpha.
    replaces: bool
    # Whether its rectangle is cleared to transparent before the next frame.
    clears: bool

# A WebP file read.
record Webp
    # The columns of the canvas.
    width: i64
    # The rows of the canvas.
    height: i64
    # The frames, at least one: a still picture has one, at 0, 0.
    frames: [Frame]
    # Whether the file is an animation.
    animated: bool
    # How many times an animation plays, 0 for for ever.
    loops: i64
    # The colour the file suggests for the canvas, which `composite` does
    # not use; transparent where the file gives none.
    background: image.Color
    # The ICC profile, empty where there is none.
    icc: [u8]
    # The EXIF data, empty where there is none.
    exif: [u8]
    # The XMP data, empty where there is none.
    xmp: [u8]

# The most columns or rows a frame holds: the lossless header's 14 bits.
constant MAX_SIDE: i64
    16384

# The picture `data` holds.
#
# - `data`: a whole WebP file.
# - `limits`: the largest image the caller allows, the canvas and every frame
#   against `max_width` and `max_height` and all of them against
#   `max_pixels`; `image.default_limits` makes the usual ones.
#
# Fails `limit` where a size passes `limits`, before it is allocated. Fails
# `invalid` where `data` is no WebP, the message naming what: a chunk past
# the end, a header that does not fit, a prefix code that is not complete, a
# copy before the first pixel, a frame outside the canvas. Fails
# `unsupported` for a lossy frame. See also `info_of` and `encode`.
function decode(data: [u8], limits: image.Limits) -> Webp?
    p = read.parse(data, limits)?
    frames: [Frame] @= []

    for r in p.frames
        frames @ frames.push(
            Frame(image: r.image, x: r.x, y: r.y, duration_ms: r.duration, replaces: r.replaces, clears: r.clears)
        )

    color = image.Color(
        r: to_u8(p.background[0]).must(),
        g: to_u8(p.background[1]).must(),
        b: to_u8(p.background[2]).must(),
        a: to_u8(p.background[3]).must()
    )
    return ok(
        Webp(width: p.width, height: p.height, frames: frames, animated: p.animated, loops: p.loops, background: color, icc: p.icc, exif: p.exif, xmp: p.xmp)
    )

# The first frame of `data`, its pixels alone.
#
# - `data`: a whole WebP file.
# - `limits`: the largest image the caller allows; `image.default_limits`
#   makes the usual ones.
#
# For an animation that is the first frame's own picture, not the canvas:
# `composite` makes that. Fails as `decode` fails. See also `decode`.
function decode_image(data: [u8], limits: image.Limits) -> image.Image?
    return ok(decode(data, limits: limits)?.frames[0].image)

# What the file says about its picture, read without decoding any pixel.
record Info
    # The columns of the canvas.
    width: i64
    # The rows of the canvas.
    height: i64
    # Whether the first picture is lossless: a lossy file fails `decode`.
    lossless: bool
    # Whether the file says any frame uses alpha.
    alpha: bool
    # Whether it is an animation.
    animated: bool
    # How many frames the file holds.
    frames: i64

# The size and kind of the file `data`, read from its chunks and headers.
#
# - `data`: a WebP file, or at least its chunks up to the first picture's
#   header.
#
# Fails `invalid` where `data` is no WebP. A lossy file is described, not
# refused. See also `decode`.
function info_of(data: [u8]) -> Info?
    chunks = riff.chunks_of(data)?
    first = chunks[0]
    width @= 0
    height @= 0
    alpha @= false
    animated @= false
    lossless @= first.tag != "VP8 "
    frames @= 0

    if first.tag == "VP8X" && first.data.len() >= 10
        flags = to_i64(first.data[0]).must()
        width @ riff.le24(first.data, at: 4) + 1
        height @ riff.le24(first.data, at: 7) + 1
        alpha @ flags & 0x10 != 0
        animated @ flags & 2 != 0

        for c in chunks.slice(from: 1, to: chunks.len())
            if c.tag == "ANMF"
                frames @ frames + 1

            if c.tag == "VP8 " && frames == 0
                lossless @ false

            if c.tag == "VP8L" || c.tag == "VP8 "
                if !animated
                    frames @ 1
    else if first.tag == "VP8L" && first.data.len() >= 5
        header = stream.header_of(first.data)?
        width @ header.width
        height @ header.height
        alpha @ header.alpha_used
        frames @ 1
    else if first.tag == "VP8 " && first.data.len() >= 10
        width @ riff.le16(first.data, at: 6) & 0x3fff
        height @ riff.le16(first.data, at: 8) & 0x3fff
        frames @ 1
    else
        return fail(
            code: image.INVALID,
            msg: f"a WebP file whose first chunk is `{first.tag}`, where VP8, VP8L or VP8X begin one"
        )
    return ok(Info(width: width, height: height, lossless: lossless, alpha: alpha, animated: animated, frames: frames))

# The canvas after each frame of `w` is drawn, as an animation shows them:
# the canvas starts transparent, each frame is laid over what is under it by
# its alpha or replaces it, and a frame marked to be cleared leaves its
# rectangle transparent before the next is drawn.
#
# - `w`: a file read by `decode`.
# - `limits`: what one canvas, `width` by `height`, may be.
#
# Every image is RGBA at the canvas's size. Fails `limit` where the canvas
# passes `limits`. See also `decode`.
function composite(w: Webp, limits: image.Limits) -> [image.Image]?
    image.check_limits(limits, width: w.width, height: w.height)?
    canvas @= image.blank(width: w.width, height: w.height, format: .rgba)?
    shown: [image.Image] @= []
    previous @= -1

    for i in range(from: 0, to: w.frames.len())
        if previous >= 0 && w.frames[previous].clears
            f = w.frames[previous]
            image.fill_rect(
                img: @canvas,
                x: f.x,
                y: f.y,
                width: f.image.width,
                height: f.image.height,
                color: image.Color(r: 0, g: 0, b: 0, a: 0)
            )
        f = w.frames[i]
        rgba = image.convert(f.image, to: .rgba)

        if f.replaces
            image.paste(onto: @canvas, source: rgba, x: f.x, y: f.y)
        else
            image.composite(onto: @canvas, source: rgba, x: f.x, y: f.y)
        shown @ shown.push(canvas)
        previous @ i

    return ok(shown)

## Writing

# The file holding `w`: a single lossless frame as a plain `VP8L` file, anything
# else (an animation, an ICC profile, EXIF or XMP) in the extended format.
#
# - `w`: at least one frame; the canvas and every frame 1 to `MAX_SIDE` a side,
#   each frame within the canvas at an even column and row (the file stores
#   half of each), a still picture one frame. A frame's image is written as
#   RGBA at 8 bits.
#
# The same picture answers the same bytes every time. Fails `invalid` where `w`
# has no frame, a side is outside 1 to `MAX_SIDE`, a frame lies outside the
# canvas or at an odd place, a still picture has more than one frame or an
# animation a duration outside 0 to 16,777,215 or a loop count outside 0 to
# 65,535. Aborts where an image is not valid. See also `decode`.
function encode(w: Webp) -> [u8]?
    if w.frames.len() == 0
        return fail(code: image.INVALID, msg: "a WebP file holds one frame at least")

    if w.width < 1 || w.height < 1 || w.width > MAX_SIDE || w.height > MAX_SIDE
        return fail(
            code: image.INVALID,
            msg: f"a canvas of {w.width} by {w.height}, where 1 to {MAX_SIDE} a side are held"
        )

    if !w.animated && w.frames.len() != 1
        return fail(code: image.INVALID, msg: f"a still picture with {w.frames.len()} frames")

    if w.loops < 0 || w.loops > 65535
        return fail(code: image.INVALID, msg: f"a loop count of {w.loops}")
    placed: [build.Place] @= []

    for f in w.frames
        assert image.is_valid(f.image)
        i = f.image

        if i.width < 1 || i.height < 1 || i.width > MAX_SIDE || i.height > MAX_SIDE || f.x < 0 || f.y < 0 || f.x + i.width > w.width || f.y + i.height > w.height
            return fail(
                code: image.INVALID,
                msg: f"a frame of {i.width} by {i.height} at {f.x}, {f.y} outside a canvas of {w.width} by {w.height}"
            )

        if f.x % 2 != 0 || f.y % 2 != 0
            return fail(
                code: image.INVALID,
                msg: f"a frame at {f.x}, {f.y}: the file stores half of each, so both are even"
            )

        if f.duration_ms < 0 || f.duration_ms > 16777215
            return fail(code: image.INVALID, msg: f"a duration of {f.duration_ms} ms")

        if !w.animated && (f.x != 0 || f.y != 0 || i.width != w.width || i.height != w.height)
            return fail(code: image.INVALID, msg: "a still picture that does not fill its canvas")
        placed @ placed.push(
            build.Place(pixels: image.convert(i, to: .rgba).pixels, width: i.width, height: i.height, x: f.x, y: f.y, duration: f.duration_ms, replaces: f.replaces, clears: f.clears)
        )

    bg = [
        to_i64(w.background.r).must()
        to_i64(w.background.g).must()
        to_i64(w.background.b).must()
        to_i64(w.background.a).must()
    ]
    return ok(
        build.file_of(width: w.width, height: w.height, frames: placed, animated: w.animated, loops: w.loops, background: bg, icc: w.icc, exif: w.exif, xmp: w.xmp)
    )

# `img` as a still lossless WebP file.
#
# - `img`: 1 to `MAX_SIDE` pixels a side, in any format, written as RGBA at 8
#   bits; its alpha is kept.
#
# Fails as `encode` fails. See also `encode`.
function encode_image(img: image.Image) -> [u8]?
    none: Frame = Frame(image: img, x: 0, y: 0, duration_ms: 0, replaces: true, clears: false)
    clear = image.Color(r: 0, g: 0, b: 0, a: 0)
    return encode(
        Webp(width: img.width, height: img.height, frames: [none], animated: false, loops: 0, background: clear, icc: [], exif: [], xmp: [])
    )

## Tests

test "decode: every file cwebp wrote, pixel for pixel as dwebp reads it"
    for s in fixtures.readable()
        w = decode(bytes.parse_hex(s.file).must(), image.default_limits()).must()
        assert w.frames.len() == 1 && !w.animated
        assert w.width == s.width && w.height == s.height
        rgba = image.convert(w.frames[0].image, to: .rgba)
        assert rgba.width == s.width && rgba.height == s.height

        if s.crc != 0
            assert to_i64(hash.crc32(rgba.pixels)).must() == s.crc
        else
            assert rgba.pixels == bytes.parse_hex(s.pixels).must()
        assert decode_image(bytes.parse_hex(s.file).must(), image.default_limits()).must() == w.frames[0].image

test "decode: a picture with no alpha is RGB and one with alpha is RGBA"
    for s in fixtures.readable()
        w = decode(bytes.parse_hex(s.file).must(), image.default_limits()).must()

        if s.name == "alpha"
            assert w.frames[0].image.format == .rgba

        if s.name == "grad_z9"
            assert w.frames[0].image.format == .rgb

test "info_of: the size and kind of every file, lossy ones described"
    for s in fixtures.readable()
        i = info_of(bytes.parse_hex(s.file).must()).must()
        assert i.width == s.width && i.height == s.height && i.lossless && !i.animated && i.frames == 1

    lossy = fixtures.lossy()
    a = info_of(bytes.parse_hex(lossy[0]).must()).must()
    assert a.width == 64 && a.height == 48 && !a.lossless
    b = info_of(bytes.parse_hex(lossy[1]).must()).must()
    assert b.width == 30 && b.height == 21 && !b.lossless
    n = info_of(bytes.parse_hex(fixtures.animation()).must()).must()
    assert n.animated && n.frames == 3 && n.width == 41 && n.height == 27

test "decode: a lossy file is refused as unsupported, with or without alpha"
    for file in fixtures.lossy()
        match decode(bytes.parse_hex(file).must(), image.default_limits())
            .ok _ => assert false
            .err e =>
                assert e.code == image.UNSUPPORTED
                assert e.msg.len() > 10

test "decode: the animation's frames, places, times, loop and background"
    w = decode(bytes.parse_hex(fixtures.animation()).must(), image.default_limits()).must()
    placed = fixtures.placed()
    assert w.animated && w.width == 41 && w.height == 27 && w.loops == 3 && w.frames.len() == 3
    assert w.background.r == 255 && w.background.g == 255 && w.background.b == 255 && w.background.a == 255

    for i in range(from: 0, to: 3)
        f = w.frames[i]
        assert f.x == placed[i].x && f.y == placed[i].y && f.duration_ms == placed[i].duration
        assert f.replaces == placed[i].replaces && f.clears == placed[i].clears
        assert image.convert(f.image, to: .rgba).pixels == bytes.parse_hex(placed[i].pixels).must()

test "composite: the canvas after each frame, within a level of the reference"
    w = decode(bytes.parse_hex(fixtures.animation()).must(), image.default_limits()).must()
    shown = composite(w, image.default_limits()).must()
    want = fixtures.canvases()
    assert shown.len() == 3

    for i in range(from: 0, to: 3)
        bytes_want = bytes.parse_hex(want[i]).must()
        assert shown[i].width == 41 && shown[i].height == 27 && shown[i].pixels.len() == bytes_want.len()

        for k in range(from: 0, to: bytes_want.len())
            a = to_i64(bytes_want[k]).must()
            b = to_i64(shown[i].pixels[k]).must()
            assert a - b <= 1 && b - a <= 1

test "decode: the ICC profile, EXIF and XMP of the extended format"
    w = decode(bytes.parse_hex(fixtures.with_metadata()).must(), image.default_limits()).must()
    assert w.icc.len() == 39 && w.icc[0] == 1 && w.icc[38] == 39
    assert w.exif.len() == 26 && w.exif[0] == 0x45
    assert bytes.to_text(w.xmp).must() == "<x:xmpmeta>hi</x:xmpmeta>"
    assert w.frames.len() == 1 && w.width == 37 && w.height == 29

test "encode and decode: every format, flat, few colours, noise, with alpha, back as written"
    formats: [image.Format] = [.gray, .gray_alpha, .rgb, .rgba, .gray16, .rgba16]
    seed @= 1

    for f in formats
        for kind in range(from: 0, to: 4)
            img = expect.picture(width: 23, height: 19, format: f, kind: kind, seed: seed)
            seed @ seed + 1
            file = encode_image(img).must()
            back = decode_image(file, image.default_limits()).must()
            assert image.convert(back, to: .rgba) == image.convert(img, to: .rgba)

test "encode: one pixel, a wide and a tall picture, and the same picture answers the same bytes"
    for size in [[1, 1], [300, 2], [2, 300], [1, 17]]
        img = expect.picture(width: size[0], height: size[1], format: .rgba, kind: 1, seed: 3)
        file = encode_image(img).must()
        assert file == encode_image(img).must()
        assert image.convert(decode_image(file, image.default_limits()).must(), to: .rgba) == img

test "encode and decode: an animation with metadata, back as written"
    one = expect.picture(width: 10, height: 8, format: .rgba, kind: 2, seed: 7)
    two = expect.picture(width: 6, height: 4, format: .rgb, kind: 3, seed: 8)
    frames: [Frame] = [
        Frame(image: one, x: 0, y: 0, duration_ms: 80, replaces: true, clears: false)
        Frame(image: two, x: 2, y: 4, duration_ms: 120, replaces: false, clears: true)
    ]
    w = Webp(
        width: 10,
        height: 8,
        frames: frames,
        animated: true,
        loops: 5,
        background: image.Color(r: 1, g: 2, b: 3, a: 4),
        icc: [9, 8, 7],
        exif: [1, 2],
        xmp: [65]
    )
    file = encode(w).must()
    assert file == encode(w).must()
    back = decode(file, image.default_limits()).must()
    assert back.animated && back.loops == 5 && back.frames.len() == 2 && back.width == 10
    assert back.background.r == 1 && back.background.g == 2 && back.background.b == 3 && back.background.a == 4
    assert back.icc == [9, 8, 7] && back.exif == [1, 2] && back.xmp == [65]
    assert image.convert(back.frames[0].image, to: .rgba) == one
    assert back.frames[0].duration_ms == 80 && back.frames[0].replaces && !back.frames[0].clears
    assert image.convert(back.frames[1].image, to: .rgba) == image.convert(two, to: .rgba)
    assert back.frames[1].x == 2 && back.frames[1].y == 4 && !back.frames[1].replaces && back.frames[1].clears

test "encode: what no file can hold is refused as invalid"
    img = expect.picture(width: 4, height: 4, format: .rgb, kind: 0, seed: 1)
    clear = image.Color(r: 0, g: 0, b: 0, a: 0)
    frame = Frame(image: img, x: 0, y: 0, duration_ms: 0, replaces: true, clears: false)
    odd = Frame(image: img, x: 1, y: 0, duration_ms: 0, replaces: true, clears: false)
    outside = Frame(image: img, x: 2, y: 2, duration_ms: 0, replaces: true, clears: false)
    slow = Frame(image: img, x: 0, y: 0, duration_ms: 16777216, replaces: true, clears: false)
    bad: [Webp] = [
        Webp(width: 4, height: 4, frames: [], animated: false, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 4, height: 4, frames: [frame, frame], animated: false, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 4, height: 4, frames: [odd], animated: true, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 4, height: 4, frames: [outside], animated: true, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 4, height: 4, frames: [slow], animated: true, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 4, height: 4, frames: [frame], animated: true, loops: 65536, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 0, height: 4, frames: [frame], animated: false, loops: 0, background: clear, icc: [], exif: [], xmp: [])
        Webp(width: 16385, height: 4, frames: [frame], animated: false, loops: 0, background: clear, icc: [], exif: [], xmp: [])
    ]

    for w in bad
        match encode(w)
            .ok _  => assert false
            .err e => assert e.code == image.INVALID

test "decode: every prefix of a file is refused or read, and no changed byte aborts"
    names = ["few", "photo", "alpha"]
    files: [[u8]] @= []

    for s in fixtures.readable()
        for n in names
            if s.name == n
                files @ files.push(bytes.parse_hex(s.file).must())

    files @ files.push(bytes.parse_hex(fixtures.animation()).must())
    files @ files.push(bytes.parse_hex(fixtures.with_metadata()).must())

    for file in files
        for n in range(from: 0, to: file.len())
            _ = match decode(file.slice(from: 0, to: n), image.default_limits())
                .ok _  => 0
                .err _ => 1

        for i in range(from: 0, to: file.len())
            changed @= file
            changed[i] @ to_u8(255 - to_i64(file[i]).must()).must()

            _ = match decode(changed, image.default_limits())
                .ok _  => 0
                .err _ => 1

test "decode: limits, and what is not WebP"
    tight = image.Limits(max_width: 10, max_height: 10, max_pixels: 50)
    file = bytes.parse_hex(fixtures.readable()[0].file).must()

    match decode(file, tight)
        .ok _  => assert false
        .err e => assert e.code == image.LIMIT

    junk: [[u8]] = [
        []
        bytes.from_text("RIFF")
        bytes.concat([bytes.from_text("RIFF"), [0, 0, 0, 0], bytes.from_text("WEBP")])
        bytes.concat([bytes.from_text("RIFF"), [4, 0, 0, 0], bytes.from_text("WEBX")])
        bytes.from_text("GIF89a not webp here")
    ]

    for bad in junk
        match decode(bad, image.default_limits())
            .ok _  => assert false
            .err e => assert e.code == image.INVALID

## Examples

# A picture written and read back.
test "decode: the frames of a file"
    img = image.from_pixels(width: 2, height: 1, format: .rgba, pixels: [255, 0, 0, 255, 0, 0, 255, 128]).must()
    w = decode(encode_image(img).must(), image.default_limits()).must()
    assert w.frames.len() == 1 && w.frames[0].image == img

# The first frame's picture alone.
test "decode_image: the image of a file"
    img = image.from_pixels(width: 2, height: 1, format: .rgb, pixels: [10, 20, 30, 40, 50, 60]).must()
    assert decode_image(encode_image(img).must(), image.default_limits()).must() == img

# A file's size and kind without its pixels.
test "info_of: the canvas and kind of a file"
    i = info_of(encode_image(image.blank(width: 30, height: 20, format: .rgba).must()).must()).must()
    assert i.width == 30 && i.height == 20 && i.lossless && i.frames == 1

# An animation's canvas after its first frame.
test "composite: the canvas after each frame"
    img = image.from_pixels(
        width: 2,
        height: 2,
        format: .rgba,
        pixels: [255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 9, 9, 9, 255]
    ).must()
    frames: [Frame] = [Frame(image: img, x: 0, y: 0, duration_ms: 50, replaces: true, clears: false)]
    w = Webp(
        width: 2,
        height: 2,
        frames: frames,
        animated: true,
        loops: 0,
        background: image.Color(r: 0, g: 0, b: 0, a: 0),
        icc: [],
        exif: [],
        xmp: []
    )
    shown = composite(decode(encode(w).must(), image.default_limits()).must(), image.default_limits()).must()
    assert shown.len() == 1 && shown[0] == img

# A still picture with an ICC profile.
test "encode: a picture with its ICC profile"
    img = image.blank(width: 3, height: 3, format: .rgb).must()
    f = Frame(image: img, x: 0, y: 0, duration_ms: 0, replaces: true, clears: false)
    w = Webp(
        width: 3,
        height: 3,
        frames: [f],
        animated: false,
        loops: 0,
        background: image.Color(r: 0, g: 0, b: 0, a: 0),
        icc: [1, 2, 3],
        exif: [],
        xmp: []
    )
    assert decode(encode(w).must(), image.default_limits()).must().icc == [1, 2, 3]

# An image written as a still lossless file.
test "encode_image: a gray image"
    img = image.blank(width: 8, height: 8, format: .gray).must()
    assert info_of(encode_image(img).must()).must().frames == 1
