# A BMP file read: its file header and DIB header (OS/2's core header of 12
# bytes, or BITMAPINFOHEADER and the larger ones that begin as it), its bit
# fields and palette, then its rows, plain or run-length coded, into RGB or
# RGBA. Every offset is checked against the file's length first.

use image

# What the headers say.
record Header
    # The columns.
    width: i64
    # The rows.
    height: i64
    # Whether the first row stored is the top one.
    top_down: bool
    # The bits a pixel.
    bits: i64
    # 0 plain, 1 RLE8, 2 RLE4, 3 or 6 bit fields.
    compression: i64
    # Where the pixels begin.
    offset: i64
    # The bit fields of red, green, blue and alpha; alpha 0 for none.
    masks: [i64]
    # The palette, three bytes a colour, red first.
    palette: [u8]

# The two bytes of `data` at `at`, the low one first.
function le16(data: [u8] lent, at: i64) -> i64
    return to_i64(data[at]).must() | to_i64(data[at + 1]).must() << 8

# The four bytes of `data` at `at`, the low one first.
function le32(data: [u8] lent, at: i64) -> i64
    return le16(data, at: at) | le16(data, at: at + 2) << 16

# The four bytes of `data` at `at` as a signed number.
function le32_signed(data: [u8] lent, at: i64) -> i64
    v = le32(data, at: at)

    if v >= 0x80000000
        return v - 0x100000000
    return v

# The headers of `data`. Fails `invalid` where they are not BMP's or run
# past the end, `unsupported` for JPEG or PNG inside.
function header_of(data: [u8] lent) -> Header?
    if data.len() < 26 || data[0] != 'B' || data[1] != 'M'
        return fail(code: image.INVALID, msg: "the data does not begin with BMP's BM and its headers")
    offset = le32(data, at: 10)
    size = le32(data, at: 14)
    core = size == 12

    if !core && size != 40 && size != 52 && size != 56 && size != 64 && size != 108 && size != 124
        return fail(code: image.INVALID, msg: f"a DIB header of {size} bytes, which no BMP defines")

    if 14 + size > data.len()
        return fail(code: image.INVALID, msg: f"a DIB header of {size} bytes runs past the end of the file")

    width = if core
        le16(data, at: 18)
    else
        le32_signed(data, at: 18)

    stored_height = if core
        le16(data, at: 20)
    else
        le32_signed(data, at: 22)

    bits = if core
        le16(data, at: 24)
    else
        le16(data, at: 28)

    compression = if core
        0
    else
        le32(data, at: 30)

    if compression == 4 || compression == 5
        return fail(code: image.UNSUPPORTED, msg: "a BMP holding a JPEG or a PNG: image/jpeg and image/png read those")
    fits = compression == 0 && (bits == 1 || bits == 4 || bits == 8 || bits == 16 || bits == 24 || bits == 32) || compression == 1 && bits == 8 || compression == 2 && bits == 4 || (compression == 3 || compression == 6) && (bits == 16 || bits == 32)

    if !fits
        return fail(
            code: image.INVALID,
            msg: f"a BMP of {bits} bits a pixel and compression {compression}, which do not go together"
        )

    if width <= 0 || stored_height == 0 || stored_height < -0x7fffffff
        return fail(code: image.INVALID, msg: f"a BMP of {width} by {stored_height} pixels")
    top_down = stored_height < 0

    if top_down && compression != 0 && compression != 3 && compression != 6
        return fail(code: image.INVALID, msg: "a top-down BMP that is run-length coded")

    height = if top_down
        -stored_height
    else
        stored_height

    masks: [i64] @= if bits == 16
        [0x7c00, 0x3e0, 0x1f, 0]
    else
        [0xff0000, 0xff00, 0xff, 0]
    after @= 14 + size

    if compression == 3 || compression == 6
        count = if compression == 6 || size >= 56
            4
        else
            3

        at = if size >= 52
            54
        else
            14 + size

        if at + 4 * count > data.len()
            return fail(code: image.INVALID, msg: "the bit fields run past the end of the file")

        for i in range(from: 0, to: count)
            masks[i] @ le32(data, at: at + 4 * i)

        if size == 40
            after @ after + 4 * count
    palette: [u8] @= []

    if bits <= 8
        entry = if core
            3
        else
            4

        used = if core
            0
        else
            le32(data, at: 46)

        count @= if used > 0
            used
        else
            1 << bits

        if core && offset > after && (offset - after) / 3 < count
            count @ (offset - after) / 3

        if count > 256 || after + entry * count > data.len()
            return fail(code: image.INVALID, msg: f"a palette of {count} colours, past 256 or past the end of the file")

        for i in range(from: 0, to: count)
            at = after + entry * i
            palette @ palette.push(data[at + 2])
            palette @ palette.push(data[at + 1])
            palette @ palette.push(data[at])

    return ok(
        Header(width: width, height: height, top_down: top_down, bits: bits, compression: compression, offset: offset, masks: masks, palette: palette)
    )

# The value of the field `mask` in `v`, scaled to 0 to 255, rounded; 255
# for an empty mask where `opaque`, else 0.
function field(v: i64, mask: i64, opaque: bool) -> i64
    if mask == 0
        if opaque
            return 255
        return 0
    shift @= 0

    while mask >> shift & 1 == 0
        shift @ shift + 1

    top = mask >> shift
    raw = v >> shift & top

    if top == 255
        return raw
    return (raw * 255 + top / 2) / top

# The pixels of the BMP `data` whose headers are `h`, as RGB or, where an
# alpha mask is given, RGBA.
function pixels_of(data: [u8] lent, h: Header lent) -> [u8]?
    alpha = h.bits >= 16 && h.masks[3] != 0

    size = if alpha
        4
    else
        3
    out: [u8] @= []

    for _ in range(from: 0, to: h.width * h.height * size)
        out @ out.push(0)

    if h.compression == 1 || h.compression == 2
        indices = run_length(data, h: h)?
        palette_count = h.palette.len() / 3

        for i in range(from: 0, to: indices.len())
            k = indices[i]

            if k >= palette_count
                return fail(code: image.INVALID, msg: f"an index of {k} into a palette of {palette_count} colours")
            out[3 * i] @ h.palette[3 * k]
            out[3 * i + 1] @ h.palette[3 * k + 1]
            out[3 * i + 2] @ h.palette[3 * k + 2]

        return ok(out)
    stride = (h.width * h.bits + 31) / 32 * 4

    if h.offset < 0 || h.offset > data.len() || stride * h.height > data.len() - h.offset
        return fail(
            code: image.INVALID,
            msg: f"{h.height} rows of {stride} bytes from byte {h.offset} run past the end of the file, at byte {data.len()}"
        )
    palette_count = h.palette.len() / 3

    for row in range(from: 0, to: h.height)
        y = if h.top_down
            row
        else
            h.height - 1 - row
        start = h.offset + row * stride

        for x in range(from: 0, to: h.width)
            o = (y * h.width + x) * size

            if h.bits <= 8
                bit = x * h.bits
                byte = to_i64(data[start + bit / 8]).must()
                k = byte >> 8 - h.bits - bit % 8 & (1 << h.bits) - 1

                if k >= palette_count
                    return fail(code: image.INVALID, msg: f"an index of {k} into a palette of {palette_count} colours")
                out[o] @ h.palette[3 * k]
                out[o + 1] @ h.palette[3 * k + 1]
                out[o + 2] @ h.palette[3 * k + 2]
            else if h.bits == 24
                at = start + 3 * x
                out[o] @ data[at + 2]
                out[o + 1] @ data[at + 1]
                out[o + 2] @ data[at]
            else
                v = if h.bits == 16
                    le16(data, at: start + 2 * x)
                else
                    le32(data, at: start + 4 * x)

                for c in range(from: 0, to: size)
                    out[o + c] @ to_u8(field(v: v, mask: h.masks[c], opaque: c == 3)).must()

    return ok(out)

# The palette indices of a run-length coded BMP, `h.width` by `h.height`
# from the top, those no run reaches 0. Fails `invalid` where a run passes
# its row or the image, or the data ends before the end of the bitmap.
function run_length(data: [u8] lent, h: Header lent) -> [i64]?
    out: [i64] @= []

    for _ in range(from: 0, to: h.width * h.height)
        out @ out.push(0)

    four = h.compression == 2
    p @= h.offset
    x @= 0
    row @= 0

    while true
        if p < 0 || p + 2 > data.len()
            return fail(code: image.INVALID, msg: "run-length data ends before its end of bitmap")
        n = to_i64(data[p]).must()
        b = to_i64(data[p + 1]).must()
        p @ p + 2

        if n > 0
            if x + n > h.width || row >= h.height
                return fail(
                    code: image.INVALID,
                    msg: f"a run of {n} at column {x} of row {row} past the image's {h.width} by {h.height}"
                )

            for i in range(from: 0, to: n)
                k = if !four
                    b
                else if i % 2 == 0
                    b >> 4
                else
                    b & 15
                out[(h.height - 1 - row) * h.width + x + i] @ k

            x @ x + n
        else if b == 0
            x @ 0
            row @ row + 1
        else if b == 1
            return ok(out)
        else if b == 2
            if p + 2 > data.len()
                return fail(code: image.INVALID, msg: "a run-length delta cut short")
            x @ x + to_i64(data[p]).must()
            row @ row + to_i64(data[p + 1]).must()
            p @ p + 2

            if x > h.width || row > h.height
                return fail(code: image.INVALID, msg: f"a run-length delta to column {x}, row {row}, past the image")
        else
            bytes_used = if four
                (b + 1) / 2
            else
                b

            if x + b > h.width || row >= h.height || p + bytes_used > data.len()
                return fail(
                    code: image.INVALID,
                    msg: f"an absolute run of {b} at column {x} of row {row} past the image or the file"
                )

            for i in range(from: 0, to: b)
                k = if !four
                    to_i64(data[p + i]).must()
                else if i % 2 == 0
                    to_i64(data[p + i / 2]).must() >> 4
                else
                    to_i64(data[p + i / 2]).must() & 15
                out[(h.height - 1 - row) * h.width + x + i] @ k

            x @ x + b
            p @ p + bytes_used + bytes_used % 2

test "field: 5, 6 and 8 bits scaled, and no mask"
    assert field(v: 0x7c00, mask: 0x7c00, opaque: false) == 255
    assert field(v: 0x0400, mask: 0x7c00, opaque: false) == 8
    assert field(v: 0x07e0, mask: 0x07e0, opaque: false) == 255
    assert field(v: 0x12345678, mask: 0xff0000, opaque: false) == 0x34
    assert field(v: 5, mask: 0, opaque: true) == 255
    assert field(v: 5, mask: 0, opaque: false) == 0

test "le32_signed: a top-down height"
    assert le32_signed([0xfa, 0xff, 0xff, 0xff], at: 0) == -6
    assert le32_signed([6, 0, 0, 0], at: 0) == 6
