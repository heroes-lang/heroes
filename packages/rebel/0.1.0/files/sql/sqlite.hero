# SQLite from Heroes: a database in a file or in memory, run inside the program
# through SQLite's own C library, with the API every driver of Rebel keeps over
# `sql`'s types, name for name, as `sql`'s opening comment writes it: `open`,
# `close`, `is_closed`, `ping`, `exec`, `query`, `query_one`, `exec_script`,
# `prepare`, `exec_prepared`, `query_prepared`, `close_statement`, `begin`,
# `commit`, `rollback` and `in_transaction`. Only `open`'s argument is this
# driver's own: a path. A statement may be built as a value by `sql/build`, its
# dialect `.sqlite`, and a schema changed by numbered migrations by
# `sql/migrate`.
#
# **Only a program that uses this package needs SQLite's library**: its floor,
# `sql/sqlite/hero_sqlite3`, binds `sqlite3.h` and links `sqlite3`, which the
# machine that builds the program must have where the compiler looks, as the
# SDK has it on Darwin and `libsqlite3-dev` on Debian. A program using `sql`
# alone, or `sql/postgres`, links nothing of SQLite.
#
# It does not write SQL functions, collations or aggregates in Heroes, read or
# write a blob piece by piece, interrupt a statement from another thread, load
# an extension, or trace statements; the ledger says why of each. A path is
# read as a path, never as a `file:` URI.
#
# ## How a value travels
#
# A value never enters the text of a statement: SQLite's placeholders are
# `?1`, `?2` and on (or `?`, numbered in order, or `:name`, numbered where each
# name first stands), and the list `params` gives their values in that order.
# A parameter goes as its case says: an `integer` and a `float` as themselves,
# a `float` that is `nan` as `NULL`, which is what SQLite stores for one; a
# `boolean` as the integer 1 or 0, SQLite having no type of its own for it; a
# `text` as text, a zero byte in it kept; a `blob` as a blob; and an `instant`
# as the text SQLite's own date functions read, in UTC, as many fraction
# digits as its nanoseconds need: `2006-01-02 15:04:05.123456789`.
#
# A column comes back by the storage class of its value: `INTEGER` as an
# `integer`, `REAL` as a `float`, `TEXT` as a `text`, `BLOB` as a `blob`, and
# `NULL` as `null_value`. Two cases are read from the type the column was
# declared with in its table, its case and any `(...)` after it ignored: in a
# column declared `BOOLEAN` or `BOOL`, an integer 0 or 1 is a `boolean`; in a
# column declared `DATE`, `DATETIME` or `TIMESTAMP`, a text SQLite's date
# functions read as a moment, `2006-01-02`, `2006-01-02 15:04`, with seconds
# and their fraction, `T` for the space, `Z` or an offset after it, is an
# `instant` (a text with no offset is UTC). Anything else in those columns,
# and every column of an expression, comes as its storage class says. A text
# that is not UTF-8 fails the read `invalid`.
#
# ## Failures
#
# Each call fails with `sql`'s codes. A failure SQLite reports keeps its
# extended result code and its words in the message, `[2067] UNIQUE
# constraint failed: users.email`, a statement's text refused also saying at
# which byte, and `sql.database_code_of` reads the code back. The code chooses:
# `exists` for a unique or primary key a row breaks (2067, 1555) and for a
# table, an index or another object made where one of its name is already
# there; `not_found` for a table, a column, a function or another object
# SQLite does not know (its words open `no such`), and for a database file
# whose folder, or whose file opened read-only, is not there; `invalid` for
# every other constraint, a statement SQLite cannot read, a value of a type a
# `STRICT` table refuses, a file that is not a database, and a parameter out
# of range; `does_not_fit` for an integer overflow; `permission` for a
# database read-only or refused by the system; `timeout` for a lock another
# connection held past the busy timeout (`SQLITE_BUSY`); `limit` for memory,
# disk, or a text, a blob or a statement past SQLite's limits; `stopped` for a
# statement interrupted or aborted; `unsupported` for a file past what the
# system's files hold; `closed` for a call on a connection `close` ended or a
# statement `close_statement` ended; and `failed` for every other, a table
# locked by its own connection and a disk's input or output among them.

use sql
use sql/sqlite/hero_sqlite3
use sql/sqlite/internal/codes
use sql/sqlite/internal/connections
use sql/sqlite/internal/running
use sql/sqlite/internal/statements
use sql/sqlite/internal/values
use time

## Opening

# A connection to the database in the file at `path`, made where it is not
# there yet, ready for a statement.
#
# - `path`: the file, relative to the working folder or absolute, in UTF-8;
#   its folder must be there. `""` opens a private database in a temporary
#   file that `close` removes, and `:memory:` one in memory, as SQLite reads
#   those two; `open_memory` says the second by its name.
#
# The program owes the connection a `close`. It waits for another
# connection's lock up to five seconds, as Python's `sqlite3` waits, until
# `set_busy_timeout` says another.
#
# Fails `invalid` where `path` holds a zero byte; `not_found` where its
# folder is not there; `permission` where the system refuses the file;
# `failed` with the system's number where SQLite cannot open it for another
# reason, a folder named as the file among them. A file that is not a
# database opens, and its first statement fails `invalid`. See also
# `open_read_only`, `open_memory`, `close`.
function open(path: str) -> Db?
    flags = hero_sqlite3.SQLITE_OPEN_READWRITE | hero_sqlite3.SQLITE_OPEN_CREATE | hero_sqlite3.SQLITE_OPEN_EXRESCODE
    made = connections.open_connection(path, flags: flags, wait_ms: 5000)?
    return ok(
        Db(connection: made.connection, path: path, transaction_open: false, busy_timeout: time.seconds(5).must(), cached: [], prepared: 0)
    )

# A connection to the database in the file at `path` that reads and never
# writes: a statement that would change it fails `permission`.
#
# - `path`: the file, which must be there, as `open` reads a path.
#
# The program owes the connection a `close`.
#
# Fails `not_found` where the file is not there, and as `open` does. See also
# `open`.
function open_read_only(path: str) -> Db?
    flags = hero_sqlite3.SQLITE_OPEN_READONLY | hero_sqlite3.SQLITE_OPEN_EXRESCODE
    made = connections.open_connection(path, flags: flags, wait_ms: 5000)?
    return ok(
        Db(connection: made.connection, path: path, transaction_open: false, busy_timeout: time.seconds(5).must(), cached: [], prepared: 0)
    )

# A connection to a new database in memory, empty, which no other connection
# reaches and which ends with `close`.
#
# The program owes the connection a `close`.
#
# Fails `limit` where SQLite has no memory for it. See also `open`, `backup`.
function open_memory() -> Db?
    return open(":memory:")

# Ends the connection: SQLite rolls back a transaction still open, gives back
# the statements `exec` and `query` kept, and closes the file; the place is
# emptied, so every later call through it fails `closed`.
#
# - `db`: the connection, emptied.
#
# Fails `closed` where it is closed already, and `invalid` where a statement
# `prepare` made on it is not closed yet: SQLite refuses then, and the
# connection stays open and usable until each is closed. See also `open`,
# `close_statement`, `is_closed`.
function close(@db: Db) -> ()?
    connections.live(db.connection, path: db.path)?

    if db.prepared > 0
        return fail(
            code: sql.INVALID,
            msg: f"{db.prepared} statement(s) `prepare` made on \"{db.path}\" are not closed: `close_statement` each, then `close`"
        )
    statements.give_back(@db.cached)
    rc = hero_sqlite3.close(@db.connection)

    if rc != hero_sqlite3.SQLITE_OK
        r = codes.refusal(db.connection, rc)
        return fail(code: r.code, msg: r.msg)
    db.connection @ nullptr
    db.transaction_open @ false
    return ok()

# Whether `close` has ended `db`.
#
# - `db`: the connection asked about.
#
# See also `close`.
function is_closed(db: Db) -> bool
    return db.connection == nullptr

# Sets how long a statement on `db` waits for a lock another connection
# holds before it fails `timeout`.
#
# - `db`: the connection.
# - `timeout`: from zero, which fails at once, to 2,147,483,647 ms, the
#   most SQLite takes, a part of a millisecond counting as a whole one;
#   `time.max_duration()` is that most.
#
# Fails `invalid` where `timeout` is below zero or past 2,147,483,647 ms,
# and `closed` where the connection is closed. See also `open`.
function set_busy_timeout(@db: Db, timeout: time.Duration) -> ()?
    connections.live(db.connection, path: db.path)?
    whole = timeout.nanoseconds / 1_000_000

    ms = if timeout == time.max_duration()
        2147483647
    else if timeout.nanoseconds % 1_000_000 != 0
        whole + 1
    else
        whole

    if timeout.nanoseconds < 0 || ms > 2147483647
        return fail(
            code: sql.INVALID,
            msg: f"a busy timeout of {time.format_duration(timeout)} is outside zero to 2147483647 ms"
        )
    _ = hero_sqlite3.busy_timeout(db.connection, ms)
    db.busy_timeout @ timeout
    return ok()

## The connection

# A connection to a SQLite database, which `open`, `open_read_only` or
# `open_memory` makes and `close` ends. Every call that runs a statement works
# on the caller's own place, through `@`: the connection keeps the statements
# it compiled, and what SQLite said about the transaction. A program keeps
# one place per connection; a copy made before `close` reaches a connection
# that is ended, and using it aborts.
record Db
    # SQLite's connection, which `close` gives back; `nullptr` once it has.
    connection: hero_sqlite3.Connection
    # The path it was opened with, `:memory:` for one in memory, as messages
    # name it.
    path: str
    # Whether a transaction is open, as SQLite said after the last call that
    # ran a statement.
    transaction_open: bool
    # How long a statement waits for another connection's lock, five
    # seconds until `set_busy_timeout` sets another.
    busy_timeout: time.Duration
    # The statements `exec`, `query` and `query_one` compiled, kept by their
    # text and run again without compiling: the 64 last compiled, at most.
    # `close` and `exec_script` give them back.
    cached: [statements.Cached]
    # How many statements `prepare` made on it that `close_statement` has not
    # ended; `close` refuses while one is.
    prepared: i64

# Answers whether the connection still works: SQLite runs in this process,
# so a connection that is open works, and nothing is asked of the database.
#
# - `db`: the connection.
#
# Fails `closed` where the connection is closed. See also `is_closed`.
function ping(db: Db) -> ()?
    return connections.live(db.connection, path: db.path)

# Whether a transaction is open on `db`: after `begin`, or a `BEGIN` run as a
# statement, until `commit` or `rollback` ends it, or SQLite rolls it back on
# a failure of the disk or of memory.
#
# - `db`: the connection asked about; a closed one has none.
#
# See also `begin`.
function in_transaction(db: Db) -> bool
    return db.connection != nullptr && db.transaction_open

# How many rows every statement on `db` has inserted, changed or deleted since
# it opened, those a trigger changed included.
#
# - `db`: the connection asked about.
#
# Fails `closed` where the connection is closed. See also `exec`.
function total_changes(db: Db) -> i64?
    connections.live(db.connection, path: db.path)?
    return ok(hero_sqlite3.total_changes(db.connection))

## Running a statement

# Runs `statement`, one statement that answers no rows, with `params` bound
# to its placeholders, and answers how many rows it changed.
#
# - `db`: the connection.
# - `statement`: one statement of SQL, its values written as `?1`, `?2` and
#   on; a statement after it, a comment aside, is refused.
# - `params`: the placeholders' values in order, `[]` for none.
#
# A statement that answers rows may run here too: its rows are read and
# dropped, and `rows_affected` counts them where the statement changes
# nothing. `rows_affected` is 0 for a statement that changes no row, a
# `CREATE TABLE` among them. `last_id` is SQLite's rowid of the last row an
# `INSERT` made on the connection, 0 before any: a statement that inserts
# nothing leaves it as it was.
#
# Fails with SQLite's failure (the module's comment), `invalid` where
# `statement` is empty, holds a zero byte or more than one statement, or
# where `params` holds more or fewer values than its placeholders, and
# `closed` where the connection is closed. See also `query`, `exec_prepared`,
# `exec_script`.
function exec(@db: Db, statement: str, params: [sql.Value]) -> sql.Result?
    connections.live(db.connection, path: db.path)?
    kept = statements.take(@db.cached, db.connection, statement)?
    result = running.run(db.connection, kept.compiled, params)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return result

# Runs `statement` with `params` bound to its placeholders, and answers its
# columns and every row it answered.
#
# - `db`: the connection.
# - `statement`: one statement of SQL, its values written as `?1`, `?2` and
#   on.
# - `params`: the placeholders' values in order, `[]` for none.
#
# Every row is read before it answers, so a statement answering a million
# rows holds a million in memory; `LIMIT` and `OFFSET` read a page. Each
# column's `type_name` is the type it was declared with, "" for an
# expression's.
#
# Fails as `exec` does, and `invalid` where a text is not UTF-8. See also
# `query_one`, `query_prepared`.
function query(@db: Db, statement: str, params: [sql.Value]) -> sql.Rows?
    connections.live(db.connection, path: db.path)?
    kept = statements.take(@db.cached, db.connection, statement)?
    answer = running.rows(db.connection, kept.compiled, params)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return answer

# The first row `statement` answers, with `params` bound to its
# placeholders.
#
# - `db`: the connection.
# - `statement`: one statement of SQL, its values written as `?1`, `?2` and
#   on.
# - `params`: the placeholders' values in order, `[]` for none.
#
# SQLite stops at the first row; a statement that changes rows, an `INSERT
# ... RETURNING` among them, has made every change by then.
#
# Fails `not_found` where the statement answers no row, and as `query` does.
# See also `query`.
function query_one(@db: Db, statement: str, params: [sql.Value]) -> sql.Row?
    connections.live(db.connection, path: db.path)?
    kept = statements.take(@db.cached, db.connection, statement)?
    answer = running.first_row(db.connection, kept.compiled, params)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return answer

# Runs every statement of `script`, separated by semicolons, in order and
# with no parameters, as a migration does. Their rows are dropped.
#
# - `db`: the connection.
# - `script`: statements of SQL; "" runs nothing.
#
# SQLite runs each statement on its own: a statement that fails leaves the
# ones before it done, unless the script holds its own `BEGIN` and `COMMIT`,
# as a migration that must be whole does. The statements `exec` and `query`
# kept are given back first, since a script usually changes the tables they
# read.
#
# Fails with the first failure, as `exec` does, and `invalid` where `script`
# holds a zero byte. See also `exec`.
function exec_script(@db: Db, script: str) -> ()?
    connections.live(db.connection, path: db.path)?

    match values.zero_at(script)
        .ok at => return fail(
            code: sql.INVALID,
            msg: f"the script holds a zero byte at byte {at}, where SQLite would end it"
        )
        .err _ => _ = 0

    statements.give_back(@db.cached)
    words @= ""
    rc = hero_sqlite3.exec(db.connection, script: script, words: @words)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0

    if rc != hero_sqlite3.SQLITE_OK
        r = if words == ""
            codes.refusal(db.connection, rc)
        else
            codes.told(rc: rc, words: words, system: 0)

        return fail(code: r.code, msg: r.msg)
    return ok()

## Prepared statements

# A statement SQLite has compiled, which `prepare` makes and
# `close_statement` ends. It belongs to the connection that prepared it.
record Statement
    # SQLite's statement, which `close_statement` gives back; `nullptr` once
    # it has.
    compiled: hero_sqlite3.Compiled
    # The statement's text, as it was prepared.
    text: str
    # How many values it takes: its largest placeholder's number.
    parameter_count: i64
    # The columns it answers, none for a statement that answers no rows.
    columns: [sql.Column]

# `statement` compiled by SQLite once, to be run many times with
# `exec_prepared` and `query_prepared`.
#
# - `db`: the connection, which the statement belongs to.
# - `statement`: one statement of SQL, its values written as `?1`, `?2` and
#   on.
#
# The program owes the statement a `close_statement`, and `close` refuses
# while it is owed.
#
# Fails as `exec` does where the statement is not one SQLite can compile.
# See also `exec_prepared`, `close_statement`.
function prepare(@db: Db, statement: str) -> Statement?
    connections.live(db.connection, path: db.path)?
    made = statements.compile(db.connection, statement)?
    db.prepared @ db.prepared + 1
    return ok(
        Statement(compiled: made.compiled, text: statement, parameter_count: hero_sqlite3.parameter_count(made.compiled), columns: running.columns_of(made.compiled))
    )

# Runs `prepared` with `params` bound to its placeholders, as `exec` runs a
# statement.
#
# - `db`: the connection that prepared it.
# - `prepared`: the statement, from `prepare` on this connection.
# - `params`: the placeholders' values in order, as many as `prepared`'s
#   `parameter_count`.
#
# Fails `invalid` where `params` holds more or fewer values than the
# statement's placeholders or `prepared` belongs to another connection,
# `closed` where `close_statement` ended it, and as `exec` does. See also
# `query_prepared`.
function exec_prepared(@db: Db, prepared: Statement, params: [sql.Value]) -> sql.Result?
    connections.usable(db.connection, path: db.path, compiled: prepared.compiled, text: prepared.text)?
    result = running.run(db.connection, prepared.compiled, params)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return result

# Runs `prepared` with `params` bound to its placeholders, and answers its
# rows, as `query` does.
#
# - `db`: the connection that prepared it.
# - `prepared`: the statement, from `prepare` on this connection.
# - `params`: the placeholders' values in order, as many as `prepared`'s
#   `parameter_count`.
#
# Fails as `exec_prepared` does. See also `exec_prepared`.
function query_prepared(@db: Db, prepared: Statement, params: [sql.Value]) -> sql.Rows?
    connections.usable(db.connection, path: db.path, compiled: prepared.compiled, text: prepared.text)?
    answer = running.rows(db.connection, prepared.compiled, params)
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return answer

# Gives `prepared` back to SQLite and empties it, so every later run of it
# fails `closed`.
#
# - `db`: the connection that prepared it.
# - `prepared`: the statement, emptied.
#
# Fails `closed` where it was ended already or the connection is closed, and
# `invalid` where it belongs to another connection. See also `prepare`.
function close_statement(@db: Db, @prepared: Statement) -> ()?
    connections.usable(db.connection, path: db.path, compiled: prepared.compiled, text: prepared.text)?
    _ = hero_sqlite3.finalize(@prepared.compiled)
    prepared.compiled @ nullptr
    db.prepared @ db.prepared - 1
    return ok()

## Transactions

# Opens a transaction: the statements after it commit together at `commit`,
# or none of them does, at `rollback`. SQLite takes its locks as the
# statements need them (`BEGIN DEFERRED`); `BEGIN IMMEDIATE` run with `exec`
# takes the write lock at once.
#
# - `db`: the connection.
#
# Fails `invalid` where a transaction is open already, and `closed` where the
# connection is closed. See also `commit`, `rollback`, `in_transaction`.
function begin(@db: Db) -> ()?
    connections.live(db.connection, path: db.path)?

    if hero_sqlite3.autocommit(db.connection) == 0
        return fail(code: sql.INVALID, msg: f"a transaction is open already on \"{db.path}\"")
    result = connections.run_word(@db.cached, db.connection, "BEGIN")
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return result

# Commits the open transaction: every statement since `begin` takes effect.
#
# - `db`: the connection.
#
# Fails `invalid` where no transaction is open, and `timeout` where another
# connection reads the database past the busy timeout: the transaction then
# stays open, and a later `commit` may succeed or `rollback` end it. See also
# `begin`, `rollback`.
function commit(@db: Db) -> ()?
    connections.live(db.connection, path: db.path)?

    if hero_sqlite3.autocommit(db.connection) != 0
        return fail(code: sql.INVALID, msg: f"no transaction is open on \"{db.path}\" to commit")
    result = connections.run_word(@db.cached, db.connection, "COMMIT")
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return result

# Rolls the open transaction back: no statement since `begin` takes effect.
#
# - `db`: the connection.
#
# Fails `invalid` where no transaction is open. See also `begin`, `commit`.
function rollback(@db: Db) -> ()?
    connections.live(db.connection, path: db.path)?

    if hero_sqlite3.autocommit(db.connection) != 0
        return fail(code: sql.INVALID, msg: f"no transaction is open on \"{db.path}\" to roll back")
    result = connections.run_word(@db.cached, db.connection, "ROLLBACK")
    db.transaction_open @ hero_sqlite3.autocommit(db.connection) == 0
    return result

## What only SQLite does

# Copies the whole database of `db` into the database of `into`, replacing
# what `into` held: a database in memory saved to a file, or a file read into
# memory.
#
# - `db`: the connection copied from, which may go on being used.
# - `into`: the connection copied into, which may be in memory.
#
# Fails `closed` where either is closed, `invalid` where both are one
# connection, `timeout` where a lock is held past the busy timeout, and as
# `exec` does where SQLite refuses. See also `open_memory`.
function backup(db: Db, into: Db) -> ()?
    connections.live(db.connection, path: db.path)?
    connections.live(into.connection, path: into.path)?

    if db.connection == into.connection
        return fail(code: sql.INVALID, msg: f"a backup of \"{db.path}\" into itself")
    copying @= hero_sqlite3.backup_init(destination: into.connection, source: db.connection)

    if copying == nullptr
        r = codes.refusal(into.connection, hero_sqlite3.extended_code(into.connection))
        _ = hero_sqlite3.backup_finish(@copying)
        return fail(code: r.code, msg: r.msg)
    stepped = hero_sqlite3.backup_step(copying, -1)
    finished = hero_sqlite3.backup_finish(@copying)

    if stepped != hero_sqlite3.SQLITE_DONE
        r = codes.refusal(into.connection, stepped)
        return fail(code: r.code, msg: r.msg)

    if finished != hero_sqlite3.SQLITE_OK
        r = codes.refusal(into.connection, finished)
        return fail(code: r.code, msg: r.msg)
    return ok()

# Whether `text` ends a whole statement: its last statement ends with a
# semicolon outside every quote, comment and trigger body.
#
# - `text`: SQL; "" is no statement, and one holding a zero byte is none.
#
# It parses nothing: a statement it calls whole may still be refused. See
# also `exec_script`.
function is_complete(text: str) -> bool
    if !values.zero_at(text).is_err()
        return false
    return hero_sqlite3.complete(text) != 0

# The version of the SQLite library the program runs with, `3.54.0` and on.
function version() -> str
    return hero_sqlite3.library_version().default("")

## Tests

test "open, close and open_read_only: a file under build/ keeps its rows, and a read-only connection refuses a write"
    path = "build/rebel-sql-sqlite-test.db"
    db @= open(path).must()
    exec_script(@db, "DROP TABLE IF EXISTS kept; CREATE TABLE kept(id INTEGER PRIMARY KEY, name TEXT)").must()
    _ = exec(@db, "INSERT INTO kept(name) VALUES (?1)", [.text(v: "Ziggy")]).must()
    close(@db).must()
    assert is_closed(db)
    again @= open_read_only(path).must()
    assert sql.text_at(query_one(@again, "SELECT name FROM kept", []).must(), 0).must() == "Ziggy"

    match exec(@again, "INSERT INTO kept(name) VALUES ('x')", [])
        .ok _  => assert false
        .err e => assert e.code == sql.PERMISSION && e.msg == "[8] attempt to write a readonly database"

    close(@again).must()

test "open and open_read_only: a folder not there, a file not there, a zero byte, and a file that is not a database"
    match open("build/rebel-no-such-folder/x.db")
        .ok _  => assert false
        .err e => assert e.code == sql.NOT_FOUND && sql.database_code_of(e.msg).must() == "14"

    match open_read_only("build/rebel-sql-sqlite-none.db")
        .ok _  => assert false
        .err e => assert e.code == sql.NOT_FOUND && e.msg == "[14] unable to open database file: \"build/rebel-sql-sqlite-none.db\" (system error 2)"

    zero: [u8] = [0]

    match open("x" + zero.validated_bytes().must())
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID

    match open("build")
        .ok _  => assert false
        .err e => assert e.code == sql.FAILED && sql.database_code_of(e.msg).must() == "14"

test "close: refused while a prepared statement is open, twice fails closed, and every call on a closed connection fails closed"
    db @= open_memory().must()
    p @= prepare(@db, "SELECT 1").must()

    match close(@db)
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "1 statement(s) `prepare` made on \":memory:\" are not closed: `close_statement` each, then `close`"

    assert !is_closed(db)
    close_statement(@db, @p).must()

    match close_statement(@db, @p)
        .ok _  => assert false
        .err e => assert e.code == sql.CLOSED && e.msg == "the statement \"SELECT 1\" is closed"

    close(@db).must()

    match close(@db)
        .ok _  => assert false
        .err e => assert e.code == sql.CLOSED && e.msg == "the connection to \":memory:\" is closed"

    assert exec(@db, "SELECT 1", []).is_err() && query(@db, "SELECT 1", []).is_err() && query_one(@db, "SELECT 1", []).is_err()
    assert exec_script(@db, "SELECT 1").is_err() && prepare(@db, "SELECT 1").is_err() && set_busy_timeout(@db, time.milliseconds(1).must()).is_err()
    assert begin(@db).is_err() && commit(@db).is_err() && rollback(@db).is_err() && total_changes(db).is_err()
    assert !in_transaction(db)

test "exec: what SQLite refuses, told with sql's codes and SQLite's own code"
    db @= open_memory().must()
    exec_script(
        @db,
        "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, n INTEGER CHECK (n >= 0))"
    ).must()
    insert = "INSERT INTO t(name, n) VALUES (?1, ?2)"
    _ = exec(@db, insert, [.text(v: "a"), .integer(v: 1)]).must()

    match exec(@db, insert, [.text(v: "a"), .integer(v: 2)])
        .ok _  => assert false
        .err e => assert e.code == sql.EXISTS && e.msg == "[2067] UNIQUE constraint failed: t.name"

    match exec(@db, "INSERT INTO t(id, name, n) VALUES (1, 'b', 1)", [])
        .ok _  => assert false
        .err e => assert e.code == sql.EXISTS && e.msg == "[1555] UNIQUE constraint failed: t.id"

    match exec(@db, insert, [.null_value, .integer(v: 1)])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "[1299] NOT NULL constraint failed: t.name"

    match exec(@db, insert, [.text(v: "c"), .integer(v: -1)])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "[275] CHECK constraint failed: n >= 0"

    match exec(@db, "SELECT * FROM nope", [])
        .ok _  => assert false
        .err e => assert e.code == sql.NOT_FOUND && e.msg == "[1] no such table: nope"

    match exec(@db, "CREATE TABLE t(x)", [])
        .ok _  => assert false
        .err e => assert e.code == sql.EXISTS && sql.database_code_of(e.msg).must() == "1"

    match exec(@db, "SELECT sum(x) FROM (SELECT 9223372036854775807 AS x UNION ALL SELECT 1)", [])
        .ok _  => assert false
        .err e => assert e.code == sql.DOES_NOT_FIT && e.msg == "[1] integer overflow"

    match exec(@db, "SELEC 1", [])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "[1] near \"SELEC\": syntax error (at byte 0 of the statement)"

    match exec(@db, insert, [.text(v: "d")])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "the statement takes 2 parameters and 1 parameter were given"

    match exec(@db, "SELECT 1; SELECT 2", [])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID

    match exec(@db, "", [])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "no statement in \"\""

    close(@db).must()

test "exec: rows_affected and last_id for an insert of three, an update of two, an update of none, a create and a select"
    db @= open_memory().must()
    made = exec(@db, "CREATE TABLE t(id INTEGER PRIMARY KEY, n INTEGER)", []).must()
    assert made.rows_affected == 0 && made.last_id.must() == 0
    inserted = exec(
        @db,
        "INSERT INTO t(n) VALUES (?1), (?2), (?3)",
        [.integer(v: 1), .integer(v: 2), .integer(v: 3)]
    ).must()
    assert inserted.rows_affected == 3 && inserted.last_id.must() == 3
    assert exec(@db, "UPDATE t SET n = n + 10 WHERE n >= ?1", [.integer(v: 2)]).must().rows_affected == 2
    none = exec(@db, "UPDATE t SET n = 0 WHERE id = ?1", [.integer(v: 99)]).must()
    assert none.rows_affected == 0 && none.last_id.must() == 3
    assert exec(@db, "SELECT * FROM t", []).must().rows_affected == 3
    assert total_changes(db).must() == 5
    close(@db).must()

test "query and query_one: columns and their declared types, rows in order, no row, and every case there and back through a file"
    db @= open("build/rebel-sql-sqlite-values.db").must()
    exec_script(
        @db,
        "DROP TABLE IF EXISTS v; CREATE TABLE v(id INTEGER PRIMARY KEY, b BOOLEAN, n INTEGER, x REAL, s TEXT, data BLOB, at TIMESTAMP)"
    ).must()
    at = time.from_unix(whole_seconds: -1, extra_nanoseconds: 999999999).must()
    insert = "INSERT INTO v(b, n, x, s, data, at) VALUES (?1, ?2, ?3, ?4, ?5, ?6)"
    _ = exec(
        @db,
        insert,
        [.boolean(v: false), .integer(v: -9223372036854775807 - 1), .float(v: -0.0), .text(v: "città"), .blob(v: [0, 1, 255]), .instant(v: at)]
    ).must()
    _ = exec(@db, insert, [.null_value, .null_value, .null_value, .null_value, .null_value, .null_value]).must()
    answer = query(@db, "SELECT b, n, x, s, data, at FROM v ORDER BY id", []).must()
    assert answer.columns == [sql.Column(name: "b", type_name: "BOOLEAN"), sql.Column(name: "n", type_name: "INTEGER"), sql.Column(name: "x", type_name: "REAL"), sql.Column(name: "s", type_name: "TEXT"), sql.Column(name: "data", type_name: "BLOB"), sql.Column(name: "at", type_name: "TIMESTAMP")]
    assert answer.rows.len() == 2
    first = answer.rows[0]
    assert !sql.boolean_named(first, "b").must()
    assert sql.integer_named(first, "n").must() == -9223372036854775807 - 1
    assert sql.float_named(first, "x").must() == 0.0
    assert sql.text_named(first, "s").must() == "città"
    assert sql.blob_named(first, "data").must() == [0, 1, 255]
    assert sql.instant_named(first, "at").must() == at
    assert sql.text_at(query_one(@db, "SELECT at FROM v WHERE id = 1", []).must(), 0).is_err()
    assert sql.text_at(query_one(@db, "SELECT at || '' FROM v WHERE id = 1", []).must(), 0).must() == "1969-12-31 23:59:59.999999999"

    for i in range(from: 0, to: 6)
        assert sql.is_null_at(answer.rows[1], i).must()

    match query_one(@db, "SELECT * FROM v WHERE id = ?1", [.integer(v: 3)])
        .ok _  => assert false
        .err e => assert e.code == sql.NOT_FOUND && e.msg == "the statement answered no row"

    empty = query(@db, "SELECT id FROM v WHERE id > 9", []).must()
    assert empty.rows.len() == 0 && empty.columns.len() == 1
    close(@db).must()

test "the kept statements: one text compiled once, 64 kept at most, and exec_script giving them back"
    db @= open_memory().must()

    for i in range(from: 0, to: 70)
        _ = query_one(@db, f"SELECT {i}", []).must()

    assert db.cached.len() == 64
    _ = query_one(@db, "SELECT 69", []).must()
    assert db.cached.len() == 64
    exec_script(@db, "CREATE TABLE t(x)").must()
    assert db.cached.len() == 0
    close(@db).must()

test "transactions: begin twice, commit and rollback with none open, a rollback undoing, a failure leaving it open, a commit keeping"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x UNIQUE)").must()
    assert !in_transaction(db)
    begin(@db).must()
    assert in_transaction(db)

    match begin(@db)
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "a transaction is open already on \":memory:\""

    _ = exec(@db, "INSERT INTO t VALUES (1)", []).must()
    rollback(@db).must()
    assert !in_transaction(db)
    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 0

    match commit(@db)
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "no transaction is open on \":memory:\" to commit"

    match rollback(@db)
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "no transaction is open on \":memory:\" to roll back"

    begin(@db).must()
    _ = exec(@db, "INSERT INTO t VALUES (2)", []).must()
    assert exec(@db, "INSERT INTO t VALUES (2)", []).is_err()
    assert in_transaction(db)
    commit(@db).must()
    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 1
    _ = exec(@db, "BEGIN IMMEDIATE", []).must()
    assert in_transaction(db)
    _ = exec(@db, "COMMIT", []).must()
    assert !in_transaction(db)
    close(@db).must()

test "exec_script: several statements in order, a failure leaving the ones before done, its own BEGIN and COMMIT, nothing, and a zero byte"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x UNIQUE); INSERT INTO t VALUES (1); INSERT INTO t VALUES (2);").must()
    exec_script(@db, "").must()

    match exec_script(@db, "INSERT INTO t VALUES (3); INSERT INTO t VALUES (1); INSERT INTO t VALUES (4)")
        .ok _  => assert false
        .err e => assert e.code == sql.EXISTS && e.msg == "[2067] UNIQUE constraint failed: t.x"

    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 3
    assert exec_script(@db, "BEGIN; INSERT INTO t VALUES (5); INSERT INTO t VALUES (1); COMMIT").is_err()
    assert in_transaction(db)
    rollback(@db).must()
    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 3
    zero: [u8] = [0]

    match exec_script(@db, "SELECT 1;" + zero.validated_bytes().must())
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "the script holds a zero byte at byte 9, where SQLite would end it"

    close(@db).must()

test "prepare: run many times, its columns and parameters, a failure, and another connection's statement refused"
    db @= open_memory().must()
    other @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT UNIQUE)").must()
    insert @= prepare(@db, "INSERT INTO t(name) VALUES (?1)").must()
    assert insert.parameter_count == 1 && insert.columns.len() == 0
    reading @= prepare(@db, "SELECT id, name FROM t WHERE id >= ?1 ORDER BY id").must()
    assert reading.columns == [sql.Column(name: "id", type_name: "INTEGER"), sql.Column(name: "name", type_name: "TEXT")]

    for name in ["a", "b", "c"]
        _ = exec_prepared(@db, insert, [.text(v: name)]).must()

    assert exec_prepared(@db, insert, [.text(v: "a")]).is_err()
    assert query_prepared(@db, reading, [.integer(v: 2)]).must().rows.len() == 2
    assert query_prepared(@db, reading, [.integer(v: 1)]).must().rows.len() == 3

    match exec_prepared(@db, insert, [])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "the statement takes 1 parameter and no parameter were given"

    match query_prepared(@other, reading, [.integer(v: 1)])
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "the statement \"SELECT id, name FROM t WHERE id >= ?1 ORDER BY id\" belongs to another connection than \":memory:\""

    assert close_statement(@other, @reading).is_err()
    assert prepare(@db, "SELECT * FROM nope").is_err() && db.prepared == 2
    close_statement(@db, @insert).must()
    close_statement(@db, @reading).must()
    assert exec_prepared(@db, insert, [.text(v: "d")]).is_err()
    close(@db).must()
    close(@other).must()

test "set_busy_timeout: a write lock another connection holds, waited for 0 ms, fails timeout; a count out of range"
    path = "build/rebel-sql-sqlite-lock.db"
    a @= open(path).must()
    b @= open(path).must()
    exec_script(@a, "CREATE TABLE IF NOT EXISTS t(x)").must()
    set_busy_timeout(@b, time.nanoseconds(0)).must()
    assert b.busy_timeout == time.nanoseconds(0)
    _ = exec(@a, "BEGIN IMMEDIATE", []).must()

    match exec(@b, "INSERT INTO t VALUES (1)", [])
        .ok _  => assert false
        .err e => assert e.code == sql.TIMEOUT && e.msg == "[5] database is locked"

    rollback(@a).must()

    match set_busy_timeout(@b, time.milliseconds(-1).must())
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "a busy timeout of -1ms is outside zero to 2147483647 ms"

    assert set_busy_timeout(@b, time.milliseconds(2147483648).must()).is_err()
    close(@a).must()
    close(@b).must()

test "backup: a database in memory saved to a file and read back into memory, and into itself refused"
    source @= open_memory().must()
    exec_script(@source, "CREATE TABLE t(x); INSERT INTO t VALUES (42)").must()
    saved @= open("build/rebel-sql-sqlite-backup.db").must()
    backup(db: source, into: saved).must()
    back @= open_memory().must()
    backup(db: saved, into: back).must()
    assert sql.integer_at(query_one(@back, "SELECT x FROM t", []).must(), 0).must() == 42

    match backup(db: back, into: back)
        .ok _  => assert false
        .err e => assert e.code == sql.INVALID && e.msg == "a backup of \":memory:\" into itself"

    close(@source).must()
    close(@saved).must()
    assert backup(db: saved, into: back).is_err()
    close(@back).must()

test "is_complete and version: whole statements, open quotes and trigger bodies, nothing, and the library's version"
    assert is_complete("SELECT 1;")
    assert !is_complete("SELECT 1")
    assert !is_complete("")
    assert !is_complete("SELECT 'a;")
    assert !is_complete("CREATE TRIGGER x AFTER INSERT ON t BEGIN SELECT 1;")
    assert !is_complete("-- c\n")
    assert is_complete(";")
    zero: [u8] = [0]
    assert !is_complete("SELECT 1;" + zero.validated_bytes().must())
    assert version().slice(from: 0, to: 2) == "3."

## Examples

# A table made, a row inserted with its values as parameters, and read back.
test "open_memory: a table, a row, and its name read back"
    db @= open_memory().must()
    _ = exec(@db, "CREATE TABLE singer(id INTEGER PRIMARY KEY, name TEXT)", []).must()
    _ = exec(@db, "INSERT INTO singer(name) VALUES (?1)", [.text(v: "Ziggy")]).must()
    row = query_one(@db, "SELECT name FROM singer WHERE id = ?1", [.integer(v: 1)]).must()
    assert sql.text_named(row, "name").must() == "Ziggy"
    close(@db).must()

# A database in a file, made where it is not there yet.
test "open: a database in a file"
    db @= open("build/rebel-sql-sqlite-example.db").must()
    exec_script(@db, "CREATE TABLE IF NOT EXISTS note(body TEXT)").must()
    close(@db).must()

# A file read without the right to change it.
test "open_read_only: reading a file that is there"
    made @= open("build/rebel-sql-sqlite-example.db").must()
    close(@made).must()
    db @= open_read_only("build/rebel-sql-sqlite-example.db").must()
    assert !query(@db, "SELECT name FROM sqlite_master", []).is_err()
    close(@db).must()

# A connection given back when the program is done with it.
test "close: the end of a connection"
    db @= open_memory().must()
    close(@db).must()
    assert is_closed(db)

# Whether a connection has been closed.
test "is_closed: before and after close"
    db @= open_memory().must()
    assert !is_closed(db)
    close(@db).must()
    assert is_closed(db)

# A connection that works, and one closed.
test "ping: open, then closed"
    db @= open_memory().must()
    ping(db).must()
    close(@db).must()
    assert ping(db).is_err()

# A connection that gives up on a lock after a second.
test "set_busy_timeout: one second"
    db @= open_memory().must()
    set_busy_timeout(@db, time.seconds(1).must()).must()
    close(@db).must()

# Whether a transaction is open.
test "in_transaction: inside begin and commit"
    db @= open_memory().must()
    begin(@db).must()
    assert in_transaction(db)
    commit(@db).must()
    close(@db).must()

# Every row a connection's statements changed.
test "total_changes: two inserts"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x); INSERT INTO t VALUES (1), (2)").must()
    assert total_changes(db).must() == 2
    close(@db).must()

# A row inserted, its id and the rows it changed answered.
test "exec: an insert with a parameter"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE singer(id INTEGER PRIMARY KEY, name TEXT)").must()
    result = exec(@db, "INSERT INTO singer(name) VALUES (?1)", [.text(v: "Ziggy")]).must()
    assert result.rows_affected == 1 && result.last_id.must() == 1
    close(@db).must()

# Every row a query answers, in order.
test "query: rows in order"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE n(v INTEGER); INSERT INTO n VALUES (2), (1)").must()
    rows = query(@db, "SELECT v FROM n ORDER BY v", []).must()
    assert sql.integer_at(rows.rows[0], 0).must() == 1 && sql.integer_at(rows.rows[1], 0).must() == 2
    close(@db).must()

# The one row a query answers.
test "query_one: a count"
    db @= open_memory().must()
    row = query_one(@db, "SELECT ?1 + ?2 AS total", [.integer(v: 2), .integer(v: 3)]).must()
    assert sql.integer_named(row, "total").must() == 5
    close(@db).must()

# A schema made by a script of several statements.
test "exec_script: a migration"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE a(x); CREATE TABLE b(y); CREATE INDEX b_y ON b(y);").must()
    close(@db).must()

# A statement compiled once.
test "prepare: an insert compiled once"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x)").must()
    insert @= prepare(@db, "INSERT INTO t VALUES (?1)").must()
    assert insert.parameter_count == 1
    close_statement(@db, @insert).must()
    close(@db).must()

# A compiled insert run for each value of a list.
test "exec_prepared: one insert, many rows"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x)").must()
    insert @= prepare(@db, "INSERT INTO t VALUES (?1)").must()

    for x in [1, 2, 3]
        _ = exec_prepared(@db, insert, [.integer(v: x)]).must()

    close_statement(@db, @insert).must()
    assert total_changes(db).must() == 3
    close(@db).must()

# A compiled query run with two different values.
test "query_prepared: one query, two lookups"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x); INSERT INTO t VALUES (1), (2), (3)").must()
    above @= prepare(@db, "SELECT x FROM t WHERE x > ?1").must()
    assert query_prepared(@db, above, [.integer(v: 1)]).must().rows.len() == 2
    assert query_prepared(@db, above, [.integer(v: 2)]).must().rows.len() == 1
    close_statement(@db, @above).must()
    close(@db).must()

# A compiled statement given back.
test "close_statement: the end of a prepared statement"
    db @= open_memory().must()
    s @= prepare(@db, "SELECT 1").must()
    close_statement(@db, @s).must()
    close(@db).must()

# Two inserts that take effect together.
test "begin: two inserts in one transaction"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x)").must()
    begin(@db).must()
    _ = exec(@db, "INSERT INTO t VALUES (1)", []).must()
    _ = exec(@db, "INSERT INTO t VALUES (2)", []).must()
    commit(@db).must()
    close(@db).must()

# A transaction's changes made to stay.
test "commit: an insert kept"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x)").must()
    begin(@db).must()
    _ = exec(@db, "INSERT INTO t VALUES (1)", []).must()
    commit(@db).must()
    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 1
    close(@db).must()

# A transaction's changes undone.
test "rollback: an insert undone"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x)").must()
    begin(@db).must()
    _ = exec(@db, "INSERT INTO t VALUES (1)", []).must()
    rollback(@db).must()
    assert sql.integer_at(query_one(@db, "SELECT count(*) FROM t", []).must(), 0).must() == 0
    close(@db).must()

# A database in memory saved to a file.
test "backup: memory saved to a file"
    db @= open_memory().must()
    exec_script(@db, "CREATE TABLE t(x); INSERT INTO t VALUES (1)").must()
    file @= open("build/rebel-sql-sqlite-saved.db").must()
    backup(db: db, into: file).must()
    close(@file).must()
    close(@db).must()

# Whether a line typed so far ends a statement.
test "is_complete: a statement ended by its semicolon"
    assert is_complete("SELECT 1;")
    assert !is_complete("SELECT 1")

# The SQLite the program links.
test "version: SQLite 3"
    assert version().slice(from: 0, to: 2) == "3."
