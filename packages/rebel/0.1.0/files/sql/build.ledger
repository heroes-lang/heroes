  heroes  sql/build.Select (`distinct`)
  go      squirrel.SelectBuilder.Distinct, goqu.SelectDataset.Distinct, goqu.SelectDataset.SelectDistinct, goqu.DISTINCT
  rust    SelectStatement::distinct, SelectDistinct
  python  Select.distinct, sqlalchemy.distinct

