# `sql`'s values on their way into SQLite and back: a parameter bound by its
# case, a column read by its storage class, and the two cases a column's
# declared type adds, a `boolean` and an `instant`. The face's opening
# comment states the rules; this module is their one home.

use sql
use sql/sqlite/hero_sqlite3
use strings
use time

# What a column's declared type makes of the values it holds.
variant Reading
    # Every value as its storage class says.
    as_stored
    # An integer 0 or 1 as a `boolean`: a column declared `BOOLEAN` or `BOOL`.
    as_boolean
    # A text SQLite's date functions read as an `instant`: a column declared
    # `DATE`, `DATETIME` or `TIMESTAMP`.
    as_instant

# What the declared type `declared` makes of a column's values.
#
# - `declared`: the type as the table declared it, `""` for an expression's;
#   its case, spaces around it and a `(...)` after it are ignored.
function reading_of(declared: str) -> Reading
    lower = strings.to_lower_ascii(declared)

    name = match strings.index_of(s: lower, substr: "(")
        .ok at => strings.trim(lower.slice(from: 0, to: at))
        .err _ => strings.trim(lower)

    return match name
        "boolean" | "bool"                => .as_boolean
        "date" | "datetime" | "timestamp" => .as_instant
        _                                 => .as_stored

# Where the first zero byte of `s` stands.
#
# - `s`: the text searched.
#
# Fails `not_found` where `s` holds none.
function zero_at(s: str) -> i64?
    at: i64 @= 0

    while at < s.len()
        if s[at] == 0
            return ok(at)
        at @ at + 1

    return fail(code: sql.NOT_FOUND, msg: "no zero byte in the text")

## Binding

# What SQLite answers for binding `v` to the parameter `index` of `compiled`.
#
# - `compiled`: the statement.
# - `index`: the parameter's number, from 1.
# - `v`: the value, bound as the face's opening comment says.
function bind(compiled: hero_sqlite3.Compiled, index: i64, v: sql.Value) -> i64
    return match v
        .null_value => hero_sqlite3.bind_null(compiled, index)
        .boolean b  => hero_sqlite3.bind_integer(compiled, index: index, value: one_or_zero(b.v))
        .integer n  => hero_sqlite3.bind_integer(compiled, index: index, value: n.v)
        .float x    => hero_sqlite3.bind_float(compiled, index, x.v)
        .text t     => bind_text(compiled, index, t.v)
        .blob b     => bind_blob(compiled, index, b.v)
        .instant t  => hero_sqlite3.bind_text(compiled, index, instant_text(t.v))

# Binds `text` as text, a zero byte in it kept.
#
# - `compiled`: the statement.
# - `index`: the parameter's number, from 1.
# - `text`: UTF-8, which may hold a zero byte.
function bind_text(compiled: hero_sqlite3.Compiled, index: i64, text: str) -> i64
    if zero_at(text).is_err()
        return hero_sqlite3.bind_text(compiled, index, text)
    signed: [i8] @= []
    at: i64 @= 0

    while at < text.len()
        b = to_i64(text[at]).must()

        shifted = if b < 128
            b
        else
            b - 256

        signed @ signed.push(to_i8(shifted).must())
        at @ at + 1

    return hero_sqlite3.bind_text_bytes(compiled, index, signed)

# 1 for `true` and 0 for `false`, as SQLite stores a truth value.
#
# - `b`: the truth value.
function one_or_zero(b: bool) -> i64
    if b
        return 1
    return 0

# Binds `data` as a blob, an empty one as a blob of no bytes and not `NULL`.
#
# - `compiled`: the statement.
# - `index`: the parameter's number, from 1.
# - `data`: the bytes, which may be none.
function bind_blob(compiled: hero_sqlite3.Compiled, index: i64, data: [u8]) -> i64
    if data.len() == 0
        return hero_sqlite3.bind_empty_blob(compiled, index)
    return hero_sqlite3.bind_blob(compiled, index, data)

# `t` as the text SQLite's date functions read, in UTC, with as many fraction
# digits as its nanoseconds need: `2006-01-02 15:04:05.123456789`, and
# `2006-01-02 15:04:05` for a whole second.
#
# - `t`: any instant; every one has a four-digit year.
function instant_text(t: time.Instant) -> str
    written = time.format(t, .rfc3339)
    return written.slice(from: 0, to: 10) + " " + written.slice(from: 11, to: written.len() - 1)

## Reading

# The values of the current row of `compiled`, one per column.
#
# - `compiled`: a statement whose last step answered a row.
# - `readings`: what each column's declared type makes of it, one per column.
#
# Fails `invalid` where a text is not UTF-8, as `value_at` does.
function row_values(compiled: hero_sqlite3.Compiled, readings: [Reading]) -> [sql.Value]?
    values: [sql.Value] @= []
    column: i64 @= 0

    while column < readings.len()
        values @ values.push(value_at(compiled, column: column, reading: readings[column])?)
        column @ column + 1

    return ok(values)

# The value of the column `column` of the current row of `compiled`.
#
# - `compiled`: a statement whose last step answered a row.
# - `column`: the column, from 0.
# - `reading`: what its declared type makes of it.
#
# Fails `invalid` where a text is not UTF-8, the message naming the column.
function value_at(compiled: hero_sqlite3.Compiled, column: i64, reading: Reading) -> sql.Value?
    kind = hero_sqlite3.column_type(compiled, column)

    if kind == hero_sqlite3.SQLITE_NULL
        return ok(.null_value)

    if kind == hero_sqlite3.SQLITE_INTEGER
        n = hero_sqlite3.column_integer(compiled, column)

        if reading == .as_boolean && (n == 0 || n == 1)
            return ok(.boolean(v: n == 1))
        return ok(.integer(v: n))

    if kind == hero_sqlite3.SQLITE_FLOAT
        return ok(.float(v: hero_sqlite3.column_float(compiled, column)))

    if kind == hero_sqlite3.SQLITE_TEXT
        text = text_at(compiled, column)?

        if reading == .as_instant
            match instant_of(text)
                .ok t  => return ok(.instant(v: t))
                .err _ => _ = 0
        return ok(.text(v: text))

    n = hero_sqlite3.column_bytes(compiled, column)
    return ok(.blob(v: hero_sqlite3.copy_bytes(source: hero_sqlite3.column_blob(compiled, column), n: n)))

# The text of the column `column` of the current row, every byte of it, a
# zero byte included.
#
# - `compiled`: a statement whose last step answered a row.
# - `column`: a column whose value is text, from 0.
#
# Fails `invalid` where the bytes are not UTF-8.
function text_at(compiled: hero_sqlite3.Compiled, column: i64) -> str?
    direct = hero_sqlite3.column_text(compiled, column)
    n = hero_sqlite3.column_bytes(compiled, column)

    match direct
        .ok s  => if s.len() == n
            return ok(s)
        .err _ => _ = 0

    bytes = hero_sqlite3.copy_bytes(source: hero_sqlite3.column_blob(compiled, column), n: n)

    match bytes.validated_bytes()
        .ok s  => return ok(s)
        .err _ => return fail(code: sql.INVALID, msg: f"column {column} holds text that is not UTF-8")

# The moment `text` writes in a form SQLite's date functions read: a date
# `2006-01-02`, or the date, a space or `T`, and a time `15:04` or `15:04:05`
# with a fraction of any length, then `Z` or an offset `+02:00`, UTC where
# none is written.
#
# - `text`: the text read; one holding a byte past ASCII is none.
#
# Fails `invalid` where `text` is not such a moment, as `time.parse` says.
function instant_of(text: str) -> time.Instant?
    at: i64 @= 0

    while at < text.len()
        if text[at] >= 128
            return fail(code: sql.INVALID, msg: f"\"{text}\" is not a moment SQLite writes")
        at @ at + 1

    if text.len() == 10
        return time.parse(text, .date_only)

    if text.len() < 16 || text[10] != ' ' && text[10] != 'T'
        return fail(code: sql.INVALID, msg: f"\"{text}\" is not a moment SQLite writes")
    rest = text.slice(from: 11, to: text.len())
    zone: i64 @= 0

    while zone < rest.len() && rest[zone] != 'Z' && rest[zone] != 'z' && rest[zone] != '+' && rest[zone] != '-'
        zone @ zone + 1

    clock = rest.slice(from: 0, to: zone)

    whole = if clock.len() == 5
        clock + ":00"
    else
        clock

    offset = if zone == rest.len()
        "Z"
    else
        rest.slice(from: zone, to: rest.len())

    return time.parse(text.slice(from: 0, to: 10) + "T" + whole + offset, .rfc3339)

## Tests

test "reading_of: the declared types read as a boolean and as an instant, in any case, and every other"
    assert reading_of("BOOLEAN") == .as_boolean
    assert reading_of("bool") == .as_boolean
    assert reading_of("TIMESTAMP") == .as_instant
    assert reading_of(" DateTime ") == .as_instant
    assert reading_of("DATE") == .as_instant
    assert reading_of("TIMESTAMP(6)") == .as_instant
    assert reading_of("") == .as_stored
    assert reading_of("INTEGER") == .as_stored
    assert reading_of("TEXT") == .as_stored
    assert reading_of("città") == .as_stored

test "zero_at: none, at the start, inside, and after a character of two bytes"
    assert zero_at("").is_err()
    assert zero_at("città").is_err()
    zero: [u8] = [0]
    nul = zero.validated_bytes().must()
    assert zero_at(nul + "x").must() == 0
    assert zero_at("a" + nul).must() == 1
    assert zero_at("é" + nul + "x").must() == 2

test "instant_text: a whole second, a fraction, the epoch and the last instant"
    assert instant_text(time.from_unix(whole_seconds: 1136214245, extra_nanoseconds: 0).must()) == "2006-01-02 15:04:05"
    assert instant_text(time.from_unix(whole_seconds: 1136214245, extra_nanoseconds: 123000000).must()) == "2006-01-02 15:04:05.123"
    assert instant_text(time.epoch()) == "1970-01-01 00:00:00"
    assert instant_text(time.max_instant()) == "2262-04-11 23:47:16.854775807"
    assert instant_text(time.min_instant()) == "1677-09-21 00:12:43.145224192"

test "instant_of: every form SQLite writes, an offset taken out, and texts that are none"
    at = time.from_unix(whole_seconds: 1136214245, extra_nanoseconds: 0).must()
    assert instant_of("2006-01-02 15:04:05").must() == at
    assert instant_of("2006-01-02T15:04:05Z").must() == at
    assert instant_of("2006-01-02 17:04:05+02:00").must() == at
    assert instant_of("2006-01-02 15:04").must() == time.from_unix(whole_seconds: 1136214240, extra_nanoseconds: 0).must()
    assert instant_of("2006-01-02 15:04:05.5").must() == time.from_unix(whole_seconds: 1136214245, extra_nanoseconds: 500000000).must()
    assert instant_of("2006-01-02").must() == time.date(year: 2006, month: 1, day: 2).must()
    assert instant_of("").is_err()
    assert instant_of("15:04:05").is_err()
    assert instant_of("2006-01-02 15").is_err()
    assert instant_of("2006-02-30 15:04:05").is_err()
    assert instant_of("2006-01-02 15:04:05 città").is_err()
    assert instant_of("now").is_err()
