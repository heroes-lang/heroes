# A server for the tests of `open` over TLS, on a thread of its own: it
# answers PostgreSQL's request for TLS, presents a test certificate of
# `tls`, and speaks just enough of the protocol after it to show that the
# whole way, the request, the handshake and a message of the protocol read
# through TLS, works. A thread runs a function of one `str` (spec § 13), so
# the server listens on a port the system chooses and tells it back over a
# connection to a listener of the test's thread (`start`).

use io
use net
use numbers
use sql/postgres/internal/script
use strings
use threads
use tls

# A server running on a thread of its own, and the port it listens on.
record Started
    # The port the server listens on, the one the system chose for it, which
    # the server told back.
    port: i64
    # The server's thread, whose answer `threads.wait_text` gives.
    thread: threads.TextThread

# `serve` started on a thread of its own for `mode`, as `serve` reads it.
# The server listens on a port the system chooses and tells it back over a
# connection to a listener of this thread, so no port is named while nothing
# holds it, and none is let go for another program to take between a choice
# and a listen (defect 2633); a server that tells why it listens on none
# stops the test with its words.
function start(mode: str) -> Started
    control @= net.listen(host: "127.0.0.1", port: 0).must()
    t = threads.spawn_text(body: serve, arg: f"{control.address.port} {mode}").must()
    told = net.accept(control, deadline_ms: 10000).must()
    r @= io.reader(told.stream)
    said = io.read_rest_text(@r).must()
    io.close(@r.stream).must()
    net.close_listener(@control).must()
    return Started(port: port_told(said).must(), thread: t)

# Tells `text`, the port the server listens on or why it listens on none, to
# the listener of `start` at `control`, and closes.
function tell(control: i64, text: str)
    c @= net.connect("127.0.0.1", port: control, deadline_ms: 10000).must()
    io.write_text(c.stream, text: text).must()
    io.close(@c.stream).must()

# The port `said` names, or a failure carrying the server's words where it
# told why it listens on none.
function port_told(said: str) -> i64?
    match numbers.parse_int(said)
        .ok port => return ok(port)
        .err _   => return fail(code: "failed", msg: "the server listens on no port: " + said)

# The server: `arg` is `"<control> <mode>"`. `n` answers `N` to the request
# for TLS; `wrong` answers `S` and presents a certificate for
# `wrong.example`; `fatal` answers `S`, presents one for `localhost`, reads
# the startup message through TLS and answers it a FATAL error, 28P01. It
# listens on a port the system chooses, tells it to `control` (`tell`),
# accepts once, the client, and answers what it did, or its failure's code
# and message.
function serve(arg: str) -> str
    parts = strings.split(s: arg, sep: " ")
    control = numbers.parse_int(parts[0]).must()

    if parts.len() != 2
        said = "invalid: not \"<control> <mode>\": " + arg
        tell(control: control, text: said)
        return said
    mode = parts[1]
    reply: [u8] @= [83]
    chain @= tls.TEST_LOCALHOST_CHAIN
    key @= tls.TEST_LOCALHOST_KEY

    if mode == "n"
        reply @ [78]
    else if mode == "wrong"
        chain @ tls.TEST_WRONG_CHAIN
        key @ tls.TEST_WRONG_KEY
    steps: [tls.Step] = [.expect(answer: [0, 0, 0, 8, 4, 210, 22, 47]), .send(data: reply)]
    made = tls.listen_after(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: chain, key: key, protocols: []),
        steps: steps
    )

    match made
        .err e =>
            said = e.code + ": " + e.msg
            tell(control: control, text: said)
            return said
        .ok l =>
            listener @= l
            tell(control: control, text: to_str(listener.port))
            did @= "no client went through TLS"
            bounded = tls.set_accept_deadline(listener, deadline_ms: 15000)

            match bounded
                .ok _  => _ = 0
                .err e => did @ e.code + ": " + e.msg

            taken = tls.accept(listener, deadline_ms: 10000)

            match taken
                .err _ => _ = 0
                .ok s =>
                    stream @= s.stream
                    did @ answered(stream)
                    closing = io.close(@stream)

                    match closing
                        .ok _  => _ = 0
                        .err _ => _ = 0

            closed = tls.close_listener(@listener)

            match closed
                .ok _  => return did
                .err e => return e.code + ": " + e.msg

# Reads the client's startup message through TLS and answers it a FATAL
# error, as a server refusing the password does.
function answered(s: io.Stream) -> str
    startup = io.read(s, n: 1024)

    match startup
        .err e => return e.code + ": " + e.msg
        .ok bytes =>
            refusal = script.msg(
                kind: 'E',
                body: script.report_body([["S", "FATAL"], ["V", "FATAL"], ["C", "28P01"], ["M", "password authentication failed for user \"ana\""]])
            )
            written = io.write(s, data: refusal)

            match written
                .err e => return e.code + ": " + e.msg
                .ok _  => return "read " + to_str(bytes.len()) + " bytes, answered FATAL"
