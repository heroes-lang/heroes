# The client's side of PostgreSQL's older login, the MD5 answer. SCRAM-SHA-256,
# the login PostgreSQL asks by default, is the package `scram`'s, which
# prepares a password by SASLprep as the server stored it.

use bytes
use crypto

# The answer to an MD5 request: `md5`, then the MD5 in hexadecimal of the
# MD5 in hexadecimal of the password and the user, followed by the salt.
#
# - `user`: the user of the startup message.
# - `password`: the password.
# - `salt`: the four bytes the server sent.
function md5_answer(user: str, password: str, salt: [u8]) -> str
    inner = bytes.from_text(bytes.format_hex(crypto.md5_text(password + user)))
    outer: [u8] @= inner

    for b in salt
        outer @ outer.push(b)

    return "md5" + bytes.format_hex(crypto.md5(outer))

test "md5_answer: as Python's hashlib computes it"
    assert md5_answer(user: "ana", password: "pw", salt: [1, 2, 3, 4]) == "md5ee31357dd868b01f6a57c7a9c099cc5f"
