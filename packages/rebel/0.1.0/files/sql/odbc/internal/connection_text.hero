# A connection string read into its `key=value` pairs and written from
# them, by the grammar of `SQLDriverConnect` in Microsoft's ODBC reference:
# pairs separated by `;`, a value inside braces holding any character, a
# `}` in it written `}}`. And the string a message may show, every
# password's value written `***`.

use sql

# One pair of a connection string, as read or to be written.
record Pair
    # The key, its blanks at either end dropped.
    key: str
    # The value, without the braces that quoted it.
    value: str

# Whether `c` is a blank of a connection string: a space or a tab.
#
# - `c`: the byte.
function is_blank(c: u8) -> bool
    return c == ' ' || c == '\t'

# Whether `key` names a password, `PWD` or `PASSWORD` whatever its case.
#
# - `key`: the key.
function is_password(key: str) -> bool
    upper: [u8] @= []
    at: i64 @= 0

    while at < key.len()
        b = key[at]

        if b >= 'a' && b <= 'z'
            upper @ upper.push(b - 32)
        else
            upper @ upper.push(b)
        at @ at + 1

    return upper == [80, 87, 68] || upper == [80, 65, 83, 83, 87, 79, 82, 68]

# `s` from `from` to `to` without the blanks at either end.
#
# - `s`: the text.
# - `from`: the first byte.
# - `to`: the byte after the last.
function trimmed(s: str, from: i64, to: i64) -> str
    first: i64 @= from
    last: i64 @= to

    while first < last && is_blank(s[first])
        first @ first + 1

    while last > first && is_blank(s[last - 1])
        last @ last - 1

    return s.slice(from: first, to: last)

# The pairs of the connection string `text`, in order.
#
# - `text`: the connection string.
#
# Fails `invalid` where a pair has no `=`, a key is empty, a brace is never
# closed, or something other than `;` follows a braced value, the message
# saying at which byte.
function parse(text: str) -> [Pair]?
    pairs: [Pair] @= []
    at: i64 @= 0

    while at < text.len()
        if text[at] == ';' || is_blank(text[at])
            at @ at + 1
            continue
        key_start = at

        while at < text.len() && text[at] != '=' && text[at] != ';'
            at @ at + 1

        if at >= text.len() || text[at] == ';'
            return fail(code: sql.INVALID, msg: f"the pair at byte {key_start} of the connection string has no `=`")
        key = trimmed(text, from: key_start, to: at)

        if key == ""
            return fail(code: sql.INVALID, msg: f"the pair at byte {key_start} of the connection string has no key")
        at @ at + 1

        while at < text.len() && is_blank(text[at])
            at @ at + 1

        if at < text.len() && text[at] == '{'
            opened = at
            parts: [str] @= []
            piece_start: i64 @= at + 1
            at @ at + 1
            closed: bool @= false

            while at < text.len() && !closed
                if text[at] == '}'
                    if at + 1 < text.len() && text[at + 1] == '}'
                        parts @ parts.push(text.slice(from: piece_start, to: at + 1))
                        at @ at + 2
                        piece_start @ at
                    else
                        parts @ parts.push(text.slice(from: piece_start, to: at))
                        at @ at + 1
                        closed @ true
                else
                    at @ at + 1

            if !closed
                return fail(
                    code: sql.INVALID,
                    msg: f"the brace opened at byte {opened} of the connection string is never closed"
                )

            while at < text.len() && is_blank(text[at])
                at @ at + 1

            if at < text.len() && text[at] != ';'
                return fail(
                    code: sql.INVALID,
                    msg: f"the braced value that ends before byte {at} of the connection string is followed by something other than `;`"
                )
            pairs @ pairs.push(Pair(key: key, value: parts.join("")))
        else
            value_start = at

            while at < text.len() && text[at] != ';'
                at @ at + 1

            pairs @ pairs.push(Pair(key: key, value: trimmed(text, from: value_start, to: at)))

    return ok(pairs)

# Whether `value` must stand inside braces: it holds `;`, `{` or `}`, or a
# blank at either end.
#
# - `value`: the value.
function needs_braces(value: str) -> bool
    if value.len() > 0 && (is_blank(value[0]) || is_blank(value[value.len() - 1]))
        return true
    at: i64 @= 0

    while at < value.len()
        c = value[at]

        if c == ';' || c == '{' || c == '}'
            return true
        at @ at + 1

    return false

# Whether `s` holds the byte `c`.
#
# - `s`: the text.
# - `c`: the byte.
function holds(s: str, c: u8) -> bool
    at: i64 @= 0

    while at < s.len()
        if s[at] == c
            return true
        at @ at + 1

    return false

# The connection string of `pairs`, `key=value` joined by `;`, a value
# inside braces where `needs_braces` says, each `}` in it doubled.
#
# - `pairs`: the pairs, in order.
#
# Fails `invalid` where a key is empty, holds `;`, `{`, `}`, `=`, a blank at
# either end or a zero byte, or a value holds a zero byte, the message
# naming the pair from 0.
function written(pairs: [Pair]) -> str?
    out: [str] @= []
    place: i64 @= 0

    for p in pairs
        bad_key = p.key == "" || holds(p.key, ';') || holds(p.key, '{') || holds(p.key, '}') || holds(p.key, '=') || holds(p.key, 0) || is_blank(p.key[0]) || is_blank(p.key[p.key.len() - 1])

        if bad_key
            return fail(
                code: sql.INVALID,
                msg: f"the key of pair {place}, \"{p.key}\", is empty or holds `;`, a brace, `=`, a zero byte or a blank at either end"
            )

        if holds(p.value, 0)
            return fail(code: sql.INVALID, msg: f"the value of pair {place} (\"{p.key}\") holds a zero byte")

        if needs_braces(p.value)
            pieces: [str] @= []

            for c in p.value.chars()
                if c == "}"
                    pieces @ pieces.push("}}")
                else
                    pieces @ pieces.push(c)

            out @ out.push(p.key + "={" + pieces.join("") + "}")
        else
            out @ out.push(p.key + "=" + p.value)
        place @ place + 1

    return ok(out.join(";"))

# The connection string `text` as a message may show it: every password's
# value written `***`; a string that does not parse is shown as none.
#
# - `text`: the connection string.
function hidden(text: str) -> str
    match parse(text)
        .err _ => return "a connection string that does not parse"
        .ok pairs =>
            shown: [Pair] @= []

            for p in pairs
                if is_password(p.key)
                    shown @ shown.push(Pair(key: p.key, value: "***"))
                else
                    shown @ shown.push(p)

            return written(shown).default("a connection string that does not parse")

## Tests

test "parse: the empty string, one pair, several, blanks and semicolons around, and a value that is empty"
    assert parse("").must() == []
    assert parse(" ;; ").must() == []
    assert parse("DSN=shop").must() == [Pair(key: "DSN", value: "shop")]
    assert parse(" Driver = SQLite3 ; Database=/tmp/a.db;").must() == [Pair(key: "Driver", value: "SQLite3"), Pair(key: "Database", value: "/tmp/a.db")]
    assert parse("PWD=;UID=ana").must() == [Pair(key: "PWD", value: ""), Pair(key: "UID", value: "ana")]
    assert parse("a=b=c").must() == [Pair(key: "a", value: "b=c")]

test "parse: braced values with a semicolon, a doubled brace, blanks kept inside and an empty one, and characters past ASCII"
    assert parse("Driver={SQLite3 ODBC Driver};Database={/tmp/a;b.db}").must() == [Pair(key: "Driver", value: "SQLite3 ODBC Driver"), Pair(key: "Database", value: "/tmp/a;b.db")]
    assert parse("PWD={a}}b{c};UID=x").must() == [Pair(key: "PWD", value: "a}b{c"), Pair(key: "UID", value: "x")]
    assert parse("X={ two blanks }").must() == [Pair(key: "X", value: " two blanks ")]
    assert parse("X={}").must() == [Pair(key: "X", value: "")]
    assert parse("Città={perché}").must() == [Pair(key: "Città", value: "perché")]

test "parse: no `=`, an empty key, a brace never closed, and text after a braced value refused with the byte"
    match parse("DSN=shop;nokey")
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "the pair at byte 9 of the connection string has no `=`"

    match parse("=x")
        .ok _  => assert false
        .err e => assert e.msg == "the pair at byte 0 of the connection string has no key"

    match parse("PWD={abc")
        .ok _  => assert false
        .err e => assert e.msg == "the brace opened at byte 4 of the connection string is never closed"

    match parse("PWD={a}b;X=1")
        .ok _  => assert false
        .err e => assert e.msg == "the braced value that ends before byte 7 of the connection string is followed by something other than `;`"

    assert parse("PWD={a}}").is_err()

test "written: plain values, values that need braces, a doubled brace, and there and back through parse"
    assert written([]).must() == ""
    assert written([Pair(key: "DSN", value: "shop"), Pair(key: "UID", value: "ana")]).must() == "DSN=shop;UID=ana"
    assert written([Pair(key: "PWD", value: "a;b}c")]).must() == "PWD={a;b}}c}"
    assert written([Pair(key: "X", value: " pad")]).must() == "X={ pad}"
    assert written([Pair(key: "X", value: "")]).must() == "X="
    tricky = [
        Pair(key: "Database", value: "/tmp/a;b.db")
        Pair(key: "PWD", value: "}{;}}")
        Pair(key: "Città", value: "perché")
    ]
    assert parse(written(tricky).must()).must() == tricky

test "written: an empty key, a key with `=`, `;`, a brace or a blank at an end, and a zero byte refused naming the pair"
    match written([Pair(key: "a", value: "1"), Pair(key: "b=c", value: "2")])
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "the key of pair 1, \"b=c\", is empty or holds `;`, a brace, `=`, a zero byte or a blank at either end"

    assert written([Pair(key: "", value: "1")]).is_err()
    assert written([Pair(key: " a", value: "1")]).is_err()
    assert written([Pair(key: "a;", value: "1")]).is_err()
    assert written([Pair(key: "{a", value: "1")]).is_err()
    zero: [u8] = [0]

    match written([Pair(key: "a", value: "x" + zero.validated_bytes().must())])
        .ok _  => assert false
        .err e => assert e.msg == "the value of pair 0 (\"a\") holds a zero byte"

test "is_password and hidden: PWD and PASSWORD whatever their case, others kept, a string that does not parse shown as none"
    assert is_password("PWD") && is_password("pwd") && is_password("Password") && !is_password("PWDX") && !is_password("UID")
    assert hidden("DSN=shop;UID=ana;PWD=s3cret") == "DSN=shop;UID=ana;PWD=***"
    assert hidden("Driver={PostgreSQL Unicode};password={a;b}") == "Driver=PostgreSQL Unicode;password=***"
    assert hidden("Driver={SQLite3};Database=:memory:") == "Driver=SQLite3;Database=:memory:"
    assert hidden("PWD={never closed") == "a connection string that does not parse"
