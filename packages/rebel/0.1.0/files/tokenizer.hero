# Text made tokens and tokens made text by byte-pair encoding, as OpenAI's
# tiktoken does it, so that a program counts what a model of OpenAI's reads
# before it sends it, keeps a text within a model's window, or reads back the
# tokens a model wrote. An encoding is a table of ordinary tokens, each a
# sequence of bytes with its rank, a pattern that first cuts a text into
# pieces, and its special tokens; a text is cut into pieces, each piece's
# bytes are merged pair by pair, the lowest rank first, and the parts left
# are its tokens. A token is an `i64`, its number in the encoding.
#
# The tables of tiktoken's encodings are modules apart, so that a program
# carries only those it uses: `tokenizer/tables/o200k_base`,
# `tokenizer/tables/cl100k_base` and `tokenizer/tables/o200k_harmony`, and
# `tokenizer/tables` to find one by its name or by a model's. Claude's tokenizer is not
# published: Claude's tokens are counted by Anthropic's API, which
# `llm/anthropic`'s `count_tokens` asks. Text cut into pieces of a number of
# tokens is `chunks`'.
#
# The pattern is read in the dialect tiktoken writes it in, that of the Rust
# crate fancy-regex, and matched by `regex` (`tokenizer/internal/dialect`
# says how). Of fancy-regex's look-arounds the one tiktoken's patterns use,
# `\s+(?!\S)` as a whole alternative, is matched in two steps; any other is
# refused `unsupported`. The classes of characters are those of `unicode`'s
# tables, Unicode 17.0.0, where tiktoken 0.14.0 reads those of the Rust crate
# regex; a character assigned after the older of the two may be cut
# otherwise.
#
# A function fails `invalid` where it is given what it does not read: a
# token that is no token of the encoding, a special token's text where the
# caller did not allow it, a file of ranks that is not one; `not_found` where
# what it looks for is not there; `unsupported` where a pattern holds what
# `regex` cannot match.

use bytes
use tokenizer/internal/assemble
use tokenizer/internal/decoder
use tokenizer/internal/encoder
use tokenizer/internal/merge
use tokenizer/internal/pieces
use tokenizer/internal/ranks_file
use tokenizer/internal/sample
use tokenizer/internal/vocabulary

## Codes

# The code of what a function does not read: a token, a special token's text
# where it is not allowed, a file of ranks, a table.
constant INVALID: str
    "invalid"

# The code of a token, a special token or bytes that the encoding does not
# hold.
constant NOT_FOUND: str
    "not_found"

# The code of a pattern that holds what `regex` cannot match as fancy-regex
# does.
constant UNSUPPORTED: str
    "unsupported"

## An encoding

# An encoding: its ordinary tokens, its pattern and its special tokens. Made
# only by `new`, or by the functions of `tokenizer/tables`; making one reads
# a whole table, so a program makes it once and keeps it.
record Encoding
    # Its name, "o200k_base" for the table of that name.
    name: str
    # Everything else, checked when it was made and read through the
    # functions below.
    core: assemble.Core

# The encoding of the ordinary tokens `ranks`, the pattern `pattern` and the
# special tokens `specials`.
#
# - `name`: what the encoding is called, any text.
# - `pattern`: what cuts a text into pieces before they are merged, in
#   fancy-regex's dialect as tiktoken writes it.
# - `ranks`: the bytes of each ordinary token, its rank being its index;
#   every one of the 256 bytes must be among them, alone, so that any text can
#   be encoded.
# - `specials`: the text of each special token and its number, at least the
#   count of `ranks`; it may be empty. Two texts may share a number, as
#   tiktoken's `o200k_harmony` gives `<|endofprompt|>` and
#   `<|reserved_200018|>` the number 200018: both encode to it, and it
#   decodes to the text given first.
#
# Fails `invalid` where a token is empty or repeats another, a byte is no
# token, a special token's text is empty or its number is a rank; fails
# `unsupported` where the pattern holds a look-around other than the one
# tiktoken uses, or `\w`, `\b` or a class inside a class; and with `regex`'s
# codes, `invalid` or `limit`, where the pattern is no pattern. It costs time
# linear in the tokens' bytes. See also `parse_ranks`.
function new(name: str, pattern: str, ranks: [[u8]], specials: {str: i64}) -> Encoding?
    table = vocabulary.build(ranks)?
    return ok(
        Encoding(name: name, core: assemble.make(name: name, pattern: pattern, table: table, specials: specials)?)
    )

# The ordinary tokens a file of tiktoken's `.tiktoken` format writes, each at
# its rank: one line a token, the standard base 64 of its bytes, a space, and
# its rank as a decimal number, empty lines passed over.
#
# - `text`: the file's text, as `read_file` answers it.
#
# The answer's index is the rank. Fails `invalid` where a line is not of that
# form, a rank repeats, or the ranks leave a gap below the largest, the
# message naming the line. See also `format_ranks` and `new`.
function parse_ranks(text: str) -> [[u8]]?
    return ranks_file.parse(text)

# The ordinary tokens `ranks` written as a `.tiktoken` file: one line a
# token, in rank order, the standard base 64 of its bytes, a space and its
# rank, every line ended by a line feed.
#
# - `ranks`: the bytes of each token, its rank its index; none may be empty.
#
# See also `parse_ranks`.
function format_ranks(ranks: [[u8]]) -> str
    return ranks_file.format(ranks)

# The pattern of `enc`, as it was given to `new`.
#
# - `enc`: the encoding.
function pattern_of(enc: Encoding lent) -> str
    return enc.core.pattern

# How many numbers the tokens of `enc` may take: its largest token plus 1,
# tiktoken's `n_vocab`.
#
# - `enc`: the encoding.
#
# See also `max_token`.
function vocabulary_size(enc: Encoding lent) -> i64
    return enc.core.max_token + 1

# The largest number of a token of `enc`, ordinary or special.
#
# - `enc`: the encoding.
function max_token(enc: Encoding lent) -> i64
    return enc.core.max_token

# The bytes of every ordinary token of `enc`, its rank its index.
#
# - `enc`: the encoding.
#
# It copies every token's bytes. See also `decode_token`.
function ranks_of(enc: Encoding lent) -> [[u8]]
    out: [[u8]] @= []
    rank: i64 @= 0

    while rank < vocabulary.size(enc.core.table)
        out @ out.push(vocabulary.bytes_of(enc.core.table, rank: rank))
        rank @ rank + 1

    return out

# The text of every special token of `enc`, in the order of its number.
#
# - `enc`: the encoding.
#
# Empty where it has none. See also `is_special`.
function special_tokens(enc: Encoding lent) -> [str]
    return enc.core.special_texts

# Whether `token` is a special token of `enc`.
#
# - `enc`: the encoding.
# - `token`: any number; one that is no token of `enc` answers false.
function is_special(enc: Encoding lent, token: i64) -> bool
    return !enc.core.special_by_number[token].is_err()

# The number of the special token `<|endoftext|>` of `enc`, tiktoken's
# `eot_token`.
#
# - `enc`: the encoding.
#
# Fails `not_found` where `enc` has no such special token.
function end_of_text(enc: Encoding lent) -> i64?
    match enc.core.special_by_text["<|endoftext|>"]
        .ok n  => return ok(n)
        .err _ => return fail(code: NOT_FOUND, msg: f"the encoding \"{enc.name}\" has no special token <|endoftext|>")

## Encoding

# The tokens of `text`, every special token's text in it refused, as
# tiktoken's `encode` does by default.
#
# - `enc`: the encoding.
# - `text`: the text; the empty text has no tokens.
#
# Fails `invalid` where `text` holds the text of a special token of `enc`,
# naming it and its byte index: a text from outside that holds
# `<|endoftext|>` must not end a prompt early. See also `encode_ordinary`,
# which reads such text as text, and `encode_with_specials`.
function encode(enc: Encoding lent, text: str) -> [i64]?
    return encoder.refusing_all(enc.core, text: text)

# The tokens of `text`, a special token's text in it encoded as ordinary
# text, as tiktoken's `encode_ordinary` does.
#
# - `enc`: the encoding.
# - `text`: the text; the empty text has no tokens.
#
# See also `encode` and `count`.
function encode_ordinary(enc: Encoding lent, text: str) -> [i64]
    return encoder.ordinary(enc.core, text: text)

# The tokens of `text`, the special tokens `allowed` encoded as special
# tokens wherever their text stands in it, and those `refused` failing.
#
# - `enc`: the encoding.
# - `text`: the text.
# - `allowed`: the texts of the special tokens to encode as such; where two
#   begin at one place, the longer is taken. Empty for none.
# - `refused`: the texts of the special tokens that may not stand in `text`;
#   one named in `allowed` too is allowed. `special_tokens(enc)` refuses
#   every one not allowed, tiktoken's default; empty refuses none, and a
#   special token neither allowed nor refused is encoded as ordinary text.
#
# Fails `invalid` where `text` holds the text of a refused special token,
# naming it and its byte index, and where `allowed` or `refused` names a text
# that is no special token of `enc`. See also `encode`.
function encode_with_specials(enc: Encoding lent, text: str, allowed: [str], refused: [str]) -> [i64]?
    return encoder.with_specials(enc.core, text: text, allowed: allowed, refused: refused)

# How many tokens `encode_ordinary` makes of `text`.
#
# - `enc`: the encoding.
# - `text`: the text; the empty text counts 0.
#
# See also `truncate`.
function count(enc: Encoding lent, text: str) -> i64
    return encoder.ordinary(enc.core, text: text).len()

# The longest beginning of `text` that encodes to at most `most` tokens,
# never cutting inside a character.
#
# - `enc`: the encoding.
# - `text`: the text.
# - `most`: the most tokens; 0 or less answers the empty text.
#
# The answer encodes, by `count`, to at most `most` tokens: cutting a text
# may encode its last piece otherwise, and the cut then moves back a token
# at a time until it does. It costs an encoding of the text, and one more for
# each such move.
function truncate(enc: Encoding lent, text: str, most: i64) -> str
    return encoder.truncated(enc.core, text: text, most: most)

# The token of `enc` that is exactly the bytes `piece`, ordinary or special,
# tiktoken's `encode_single_token`.
#
# - `enc`: the encoding.
# - `piece`: the bytes.
#
# Fails `not_found` where no token is exactly those bytes. See also
# `decode_token`.
function token_of(enc: Encoding lent, piece: [u8]) -> i64?
    if piece.len() > 0
        rank = vocabulary.rank_of(enc.core.table, s: piece, from: 0, to: piece.len())

        if rank != vocabulary.NO_RANK
            return ok(rank)
        at: i64 @= 0

        while at < enc.core.special_texts.len()
            if bytes.from_text(enc.core.special_texts[at]) == piece
                return ok(enc.core.special_numbers[at])
            at @ at + 1

    return fail(
        code: NOT_FOUND,
        msg: f"no token of \"{enc.name}\" is exactly the {piece.len()} bytes {bytes.format_hex(piece)}"
    )

# The tokens of the bytes `piece` merged whole, as one piece, with no pattern
# cutting them first and no special token read: tiktoken's
# `_encode_single_piece`.
#
# - `enc`: the encoding.
# - `piece`: any bytes, UTF-8 or not; none answers no token, where tiktoken
#   0.14.0 panics.
#
# See also `encode_ordinary`, which cuts a text into pieces first.
function encode_piece(enc: Encoding lent, piece: [u8]) -> [i64]
    out: [i64] @= []

    if piece.len() > 0
        merge.add_ranks(@out, t: enc.core.table, s: piece, from: 0, to: piece.len())
    return out

# The pieces the pattern of `enc` cuts `text` into, which are then merged
# into tokens each apart.
#
# - `enc`: the encoding.
# - `text`: the text.
#
# In order; text no match of the pattern reaches is in no piece, as tiktoken
# drops it.
function pieces_of(enc: Encoding lent, text: str) -> [str]
    return pieces.split(enc.core.splitter, s: text)

## Decoding

# The text the tokens `tokens` write, each byte that is no part of UTF-8
# replaced by U+FFFD, as tiktoken's `decode` does.
#
# - `enc`: the encoding.
# - `tokens`: the tokens, ordinary or special; none answers the empty text.
#
# Fails `invalid` where a token is no token of `enc`, naming it and its
# index. The bytes of a character cut between two lists of tokens are
# replaced; `decode_next` keeps them. See also `decode_bytes`.
function decode(enc: Encoding lent, tokens: [i64]) -> str?
    written = decoder.bytes_of(enc.core, tokens: tokens)?
    return ok(bytes.to_text_lossy(written))

# The bytes the tokens `tokens` write, end to end.
#
# - `enc`: the encoding.
# - `tokens`: the tokens, ordinary or special.
#
# Fails `invalid` where a token is no token of `enc`. See also `decode`.
function decode_bytes(enc: Encoding lent, tokens: [i64]) -> [u8]?
    return decoder.bytes_of(enc.core, tokens: tokens)

# The bytes of the token `token`, tiktoken's `decode_single_token_bytes`.
#
# - `enc`: the encoding.
# - `token`: an ordinary or special token.
#
# Fails `invalid` where `token` is no token of `enc`. See also `token_of`.
function decode_token(enc: Encoding lent, token: i64) -> [u8]?
    return decoder.bytes_of(enc.core, tokens: [token])

# The bytes of each token of `tokens`, in order.
#
# - `enc`: the encoding.
# - `tokens`: the tokens.
#
# Fails `invalid` where a token is no token of `enc`.
function decode_tokens(enc: Encoding lent, tokens: [i64]) -> [[u8]]?
    return decoder.each_bytes(enc.core, tokens: tokens)

# Where each token of `tokens` begins in the bytes `decode_bytes` answers,
# as a byte index, which is its place in the text it was encoded from.
#
# - `enc`: the encoding.
# - `tokens`: the tokens.
#
# One index a token, the first 0. A token that begins inside a character, the
# rest of one an earlier token began, gives that index too;
# `unicode.floor_char_boundary` gives the character's first byte, which
# tiktoken's `decode_with_offsets` counts in characters. Fails `invalid`
# where a token is no token of `enc`.
function offsets_of(enc: Encoding lent, tokens: [i64]) -> [i64]?
    return decoder.offsets(enc.core, tokens: tokens)

# The text `token` completes, after the bytes `held` keeps of the tokens
# before it: a model's answer decoded token by token as it streams.
#
# - `enc`: the encoding.
# - `@held`: the bytes of a character not yet whole, which the caller keeps
#   empty at first and between calls; the token's bytes are added to them,
#   and they keep afterwards only those of a character still cut, at most
#   three.
# - `token`: the next token.
#
# The answer holds every whole character, U+FFFD in place of each byte that
# no more bytes can make UTF-8, and may be empty. At the end of the stream
# `bytes.to_text_lossy(held)` is what is left. Fails `invalid` where `token`
# is no token of `enc`, `held` left as it was.
function decode_next(enc: Encoding lent, @held: [u8], token: i64) -> str?
    return decoder.next_text(enc.core, @held, token: token)

## Examples

# An encoding made from its parts: the 256 bytes, twelve merged tokens and a
# special token numbered 300.
test "new: an encoding of the 256 bytes, twelve merges and a special token"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: {"<|endoftext|>": 300}).must()
    assert encode_ordinary(enc, text: "hello world") == [260, 264]

# The lines of a `.tiktoken` file read, each token at its rank.
test "parse_ranks: two tokens"
    assert parse_ranks("IQ== 0\naGk= 1\n").must() == [[33], [104, 105]]

# Tokens written as the lines of a `.tiktoken` file.
test "format_ranks: two tokens"
    assert format_ranks([[33], [104, 105]]) == "IQ== 0\naGk= 1\n"

# The pattern an encoding was made with.
test "pattern_of: the pattern given to new"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert pattern_of(enc) == sample.PATTERN

# How many numbers an encoding's tokens take, its special token's included.
test "vocabulary_size: 268 ordinary tokens and a special token numbered 300"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert vocabulary_size(enc) == 301

# The largest token, here the special one.
test "max_token: the special token numbered 300"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert max_token(enc) == 300

# The bytes of every ordinary token, by rank.
test "ranks_of: the token of rank 260"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    every = ranks_of(enc)
    assert every.len() == 268 && every[260] == bytes.from_text("hello")

# The texts of an encoding's special tokens.
test "special_tokens: the one special token"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert special_tokens(enc) == ["<|endoftext|>"]

# Whether a token is a special one.
test "is_special: a special token and an ordinary one"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert is_special(enc, token: 300) && !is_special(enc, token: 260)

# The number of `<|endoftext|>`, which ends a document.
test "end_of_text: the number of <|endoftext|>"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert end_of_text(enc).must() == 300

# A text encoded, and a text holding a special token's text refused.
test "encode: two words, and a special token's text refused"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert encode(enc, text: "hello world").must() == [260, 264]
    assert encode(enc, text: "hello<|endoftext|>").is_err()

# A special token's text encoded as the text it is.
test "encode_ordinary: a special token's text read as text"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert encode_ordinary(enc, text: "hello<|endoftext|>") == [260, 60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62]

# A special token allowed between two words.
test "encode_with_specials: <|endoftext|> allowed"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert encode_with_specials(enc, text: "hello<|endoftext|> world", allowed: ["<|endoftext|>"], refused: []).must() == [260, 300, 264]

# How many tokens a text takes.
test "count: a short sentence"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert count(enc, text: "hello world, hello") == 7

# A text cut to the first three of its tokens.
test "truncate: at most three tokens"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert truncate(enc, text: "hello world, hello", most: 3) == "hello world,"

# The token that is exactly some bytes.
test "token_of: the bytes of hello"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert token_of(enc, piece: bytes.from_text("hello")).must() == 260

# Bytes merged whole, the space and the word after it in one piece.
test "encode_piece: two words merged as one piece, and bytes that are not UTF-8"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert encode_piece(enc, piece: bytes.from_text("hello world")) == [256, 257, 111, 264]
    assert encode_piece(enc, piece: [0xe2, 0x82, 0xac, 0xff]) == [267, 255]
    assert encode_piece(enc, piece: []) == []

# The pieces a text is cut into before merging, a run of white space giving
# its last space to the word after it.
test "pieces_of: words, white space, digits by three, and a mark"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert pieces_of(enc, text: "hello  world 12345!") == ["hello", " ", " world", " 123", "45", "!"]

# Tokens written back as text.
test "decode: two tokens"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert decode(enc, tokens: [260, 264]).must() == "hello world"

# Tokens written back as bytes, a special token's text among them.
test "decode_bytes: an ordinary token and the special one"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert decode_bytes(enc, tokens: [260, 300]).must() == bytes.from_text("hello<|endoftext|>")

# The bytes of one token.
test "decode_token: the token of the euro sign"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert decode_token(enc, token: 267).must() == [0xe2, 0x82, 0xac]

# The bytes of each token apart.
test "decode_tokens: two tokens"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert decode_tokens(enc, tokens: [260, 264]).must() == [bytes.from_text("hello"), bytes.from_text(" world")]

# Where each token begins in the text.
test "offsets_of: three tokens"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    assert offsets_of(enc, tokens: [260, 264, 267]).must() == [0, 5, 11]

# A stream decoded token by token, a character cut between two tokens held
# until it is whole.
test "decode_next: the euro sign cut in two"
    enc = new(name: "tiny", pattern: sample.PATTERN, ranks: sample.ranks(), specials: sample.specials()).must()
    held: [u8] @= []
    assert decode_next(enc, @held, token: 260).must() == "hello"
    assert decode_next(enc, @held, token: 266).must() == ""
    assert decode_next(enc, @held, token: 172).must() == "€"
