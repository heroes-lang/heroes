# The flat events of one BSON document written as its bytes. A document's
# length is written as four zeros where it begins and set once its closing
# zero is written; the documents still open wait on a stack this module holds.
# A regex's options are written in alphabetical order, as bsonspec.org asks.

use bson/internal/event
use bson/internal/floats
use bytes

# The code of a name, a pattern or options holding a zero byte, which a C
# string cannot.
constant INVALID: str
    "invalid"

# The code of a document or a string past the 2 GiB a length of BSON holds.
constant DOES_NOT_FIT: str
    "does_not_fit"

# The largest length BSON holds.
constant MOST: i64
    2147483647

# A document still being written: the elements it still waits for, where its
# length goes, and for a scope where the whole code with scope's length goes.
record Open
    # The elements still to be written.
    remaining: i64
    # The byte index of its length.
    start: i64
    # The byte index of a code with scope's whole length, -1 otherwise.
    total: i64

# Fails `invalid` where `s`, written as a C string, holds a zero byte.
function check_cstring(s: str, what: str) -> ()?
    for i in range(from: 0, to: s.len())
        if s[i] == 0
            return fail(code: INVALID, msg: f"{what} holds a zero byte at byte {i}, which BSON cannot write")

    return ok()

# Writes `s` and a closing zero to `out`.
function push_cstring(@out: [u8], s: str)
    bytes.push_text(to: @out, s: s)
    out @ out.push(0)

# Writes the string `s`: its length with its closing zero, its bytes, a zero.
function push_string(@out: [u8], s: str) -> ()?
    if s.len() + 1 > MOST
        return fail(code: DOES_NOT_FIT, msg: f"a string of {s.len()} bytes is past the 2 GiB BSON holds")
    bytes.push_all(to: @out, from: bytes.encode_i32_le(to_i32(s.len() + 1).must()))
    push_cstring(out: @out, s: s)
    return ok()

# Sets the four bytes at `at` of `out` to `n`, little-endian.
function patch(@out: [u8], at: i64, n: i64) -> ()?
    if n > MOST
        return fail(code: DOES_NOT_FIT, msg: f"a document of {n} bytes is past the 2 GiB BSON holds")
    b = bytes.encode_i32_le(to_i32(n).must())

    for k in range(from: 0, to: 4)
        out[at + k] @ b[k]

    return ok()

# Writes four zeros where a length will go, and answers where.
function hold(@out: [u8]) -> i64
    at = out.len()

    for _ in range(from: 0, to: 4)
        out @ out.push(0)

    return at

# `options` with its characters in alphabetical order.
function sorted_options(options: str) -> str
    return join(sort(options.chars()), "")

# The bytes of the document whose events are `events`, its own first. Fails
# `invalid` where a name, a regex's pattern or its options hold a zero byte,
# `does_not_fit` where a document or a string passes 2 GiB.
function write(events: [event.Event] lent) -> [u8]?
    out: [u8] @= []
    frames: [Open] @= []
    top: i64 @= 0

    for i in range(from: 0, to: events.len())
        e = events[i]

        if i > 0
            frames[top - 1].remaining @ frames[top - 1].remaining - 1
            check_cstring(s: e.name, what: f"the name \"{e.name}\"")?
            out @ out.push(to_u8(e.kind).must())
            push_cstring(out: @out, s: e.name)
        opened: Open @= Open(remaining: -1, start: 0, total: -1)

        if e.kind == event.DOUBLE
            bytes.push_all(to: @out, from: floats.encode(e.number))
        else if e.kind == event.STRING || e.kind == event.JAVASCRIPT || e.kind == event.SYMBOL
            push_string(out: @out, s: e.text)?
        else if e.kind == event.DOCUMENT || e.kind == event.ARRAY
            opened @ Open(remaining: e.count, start: hold(@out), total: -1)
        else if e.kind == event.JAVASCRIPT_WITH_SCOPE
            total = hold(@out)
            push_string(out: @out, s: e.text)?
            opened @ Open(remaining: e.count, start: hold(@out), total: total)
        else if e.kind == event.BINARY && e.integer == 2
            bytes.push_all(to: @out, from: bytes.encode_i32_le(to_i32(e.data.len() + 4).must()))
            out @ out.push(2)
            bytes.push_all(to: @out, from: bytes.encode_i32_le(to_i32(e.data.len()).must()))
            bytes.push_all(to: @out, from: e.data)
        else if e.kind == event.BINARY
            if e.data.len() > MOST
                return fail(code: DOES_NOT_FIT, msg: f"a binary of {e.data.len()} bytes is past the 2 GiB BSON holds")
            bytes.push_all(to: @out, from: bytes.encode_i32_le(to_i32(e.data.len()).must()))
            out @ out.push(to_u8(e.integer).must())
            bytes.push_all(to: @out, from: e.data)
        else if e.kind == event.OBJECT_ID || e.kind == event.DECIMAL128
            bytes.push_all(to: @out, from: e.data)
        else if e.kind == event.BOOLEAN
            out @ out.push(to_u8(e.integer).must())
        else if e.kind == event.DATETIME || e.kind == event.INT64
            bytes.push_all(to: @out, from: bytes.encode_i64_le(e.integer))
        else if e.kind == event.REGEX
            check_cstring(s: e.text, what: "a regex's pattern")?
            check_cstring(s: e.extra, what: "a regex's options")?
            push_cstring(out: @out, s: e.text)
            push_cstring(out: @out, s: sorted_options(e.extra))
        else if e.kind == event.DB_POINTER
            push_string(out: @out, s: e.text)?
            bytes.push_all(to: @out, from: e.data)
        else if e.kind == event.INT32
            bytes.push_all(to: @out, from: bytes.encode_i32_le(to_i32(e.integer).must()))
        else if e.kind == event.TIMESTAMP
            bytes.push_all(to: @out, from: bytes.encode_u32_le(to_u32(e.second).must()))
            bytes.push_all(to: @out, from: bytes.encode_u32_le(to_u32(e.integer).must()))

        if opened.remaining >= 0
            if top == frames.len()
                frames @ frames.push(opened)
            else
                frames[top] @ opened
            top @ top + 1

        while top > 0 && frames[top - 1].remaining == 0
            out @ out.push(0)
            closing = frames[top - 1]
            patch(out: @out, at: closing.start, n: out.len() - closing.start)?

            if closing.total >= 0
                patch(out: @out, at: closing.total, n: out.len() - closing.total)?
            top @ top - 1

    return ok(out)

test "write: the empty document, and one holding an int32"
    assert write([event.of_container(kind: event.DOCUMENT, name: "", count: 0, code: "")]).must() == [5, 0, 0, 0, 0]
    one = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_integer(kind: event.INT32, name: "a", n: 7)
    ]
    assert write(one).must() == [12, 0, 0, 0, 0x10, 0x61, 0, 7, 0, 0, 0, 0]

test "write: a name and a pattern holding a zero byte are refused"
    named = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_kind(kind: event.NULL_VALUE, name: "a\u{1}")
    ]
    assert write(named).must().len() == 9
    zero_name = "a" + bytes.to_text([0]).must()
    refused = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_kind(kind: event.NULL_VALUE, name: zero_name)
    ]
    assert write(refused).is_err()
    pattern = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_regex(name: "r", pattern: zero_name, options: "")
    ]
    assert write(pattern).is_err()

test "write: a regex's options sorted, and nested documents closed in order"
    regex = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_regex(name: "r", pattern: "a", options: "mi")
    ]
    assert write(regex).must() == [13, 0, 0, 0, 0x0b, 0x72, 0, 0x61, 0, 0x69, 0x6d, 0, 0]
    nested = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 2, code: "")
        event.of_container(kind: event.ARRAY, name: "a", count: 1, code: "")
        event.of_container(kind: event.DOCUMENT, name: "0", count: 0, code: "")
        event.of_kind(kind: event.NULL_VALUE, name: "b")
    ]
    assert write(nested).must() == [24, 0, 0, 0, 4, 0x61, 0, 13, 0, 0, 0, 3, 0x30, 0, 5, 0, 0, 0, 0, 0, 0x0a, 0x62, 0, 0]

test "write: a code with scope's two lengths"
    scope = [
        event.of_container(kind: event.DOCUMENT, name: "", count: 1, code: "")
        event.of_container(kind: event.JAVASCRIPT_WITH_SCOPE, name: "c", count: 0, code: "x")
    ]
    assert write(scope).must() == [23, 0, 0, 0, 0x0f, 0x63, 0, 15, 0, 0, 0, 2, 0, 0, 0, 0x78, 0, 5, 0, 0, 0, 0, 0]
