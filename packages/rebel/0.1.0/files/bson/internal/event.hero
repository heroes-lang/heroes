# One BSON element as a flat event: its type byte, its name, and the payload
# that type carries. A document is its event and then its elements' events,
# so a whole document is a list in the order its bytes hold it, read and
# written by loops that hold their own stacks and never follow the data with
# recursion. A container's event says how many elements follow it at its own
# level.

# The type bytes of BSON's elements, as bsonspec.org numbers them.
constant DOUBLE: i64
    1

constant STRING: i64
    2

constant DOCUMENT: i64
    3

constant ARRAY: i64
    4

constant BINARY: i64
    5

constant UNDEFINED: i64
    6

constant OBJECT_ID: i64
    7

constant BOOLEAN: i64
    8

constant DATETIME: i64
    9

constant NULL_VALUE: i64
    10

constant REGEX: i64
    11

constant DB_POINTER: i64
    12

constant JAVASCRIPT: i64
    13

constant SYMBOL: i64
    14

constant JAVASCRIPT_WITH_SCOPE: i64
    15

constant INT32: i64
    16

constant TIMESTAMP: i64
    17

constant INT64: i64
    18

constant DECIMAL128: i64
    19

constant MAX_KEY: i64
    127

constant MIN_KEY: i64
    255

# One element, or the document at the root, whose name is "".
record Event
    # The type byte, one of the constants above.
    kind: i64
    # The element's name in its document; an array's elements are named by
    # their index.
    name: str
    # The elements that follow at this element's own level: a document's, an
    # array's, a scope's; 0 for every other kind.
    count: i64
    # A string's, a code's or a symbol's text, a regex's pattern, a pointer's
    # namespace.
    text: str
    # A regex's options.
    extra: str
    # A double's value.
    number: f64
    # An int32's, an int64's or a datetime's value, a timestamp's seconds, a
    # binary's subtype, a boolean's 0 or 1.
    integer: i64
    # A timestamp's increment.
    second: i64
    # A binary's bytes, an ObjectId's 12, a Decimal128's 16.
    data: [u8]

# An event of `kind` named `name` with no payload.
function of_kind(kind: i64, name: str) -> Event
    return Event(kind: kind, name: name, count: 0, text: "", extra: "", number: 0.0, integer: 0, second: 0, data: [])

# A container of `kind` named `name` holding `count` elements; a scope's
# `code` is its text.
function of_container(kind: i64, name: str, count: i64, code: str) -> Event
    return Event(
        kind: kind,
        name: name,
        count: count,
        text: code,
        extra: "",
        number: 0.0,
        integer: 0,
        second: 0,
        data: []
    )

# An event of a text kind: a string, a code, a symbol.
function of_text(kind: i64, name: str, text: str) -> Event
    return Event(kind: kind, name: name, count: 0, text: text, extra: "", number: 0.0, integer: 0, second: 0, data: [])

# A double named `name`.
function of_double(name: str, x: f64) -> Event
    return Event(kind: DOUBLE, name: name, count: 0, text: "", extra: "", number: x, integer: 0, second: 0, data: [])

# An event of an integer kind: an int32, an int64, a datetime, a boolean.
function of_integer(kind: i64, name: str, n: i64) -> Event
    return Event(kind: kind, name: name, count: 0, text: "", extra: "", number: 0.0, integer: n, second: 0, data: [])

# A timestamp of `seconds` and `increment`.
function of_timestamp(name: str, seconds: i64, increment: i64) -> Event
    return Event(
        kind: TIMESTAMP,
        name: name,
        count: 0,
        text: "",
        extra: "",
        number: 0.0,
        integer: seconds,
        second: increment,
        data: []
    )

# An event of a kind of bytes: an ObjectId, a Decimal128, or a binary of
# `subtype`.
function of_data(kind: i64, name: str, data: [u8], subtype: i64) -> Event
    return Event(
        kind: kind,
        name: name,
        count: 0,
        text: "",
        extra: "",
        number: 0.0,
        integer: subtype,
        second: 0,
        data: data
    )

# A regex of `pattern` and `options`.
function of_regex(name: str, pattern: str, options: str) -> Event
    return Event(
        kind: REGEX,
        name: name,
        count: 0,
        text: pattern,
        extra: options,
        number: 0.0,
        integer: 0,
        second: 0,
        data: []
    )

# A pointer to the document `id` of the collection `namespace`.
function of_pointer(name: str, namespace: str, id: [u8]) -> Event
    return Event(
        kind: DB_POINTER,
        name: name,
        count: 0,
        text: namespace,
        extra: "",
        number: 0.0,
        integer: 0,
        second: 0,
        data: id
    )

# Whether `kind` is a container's: a document, an array, a scope.
function is_container(kind: i64) -> bool
    return kind == DOCUMENT || kind == ARRAY || kind == JAVASCRIPT_WITH_SCOPE

# The name of the type `kind`, as BSON's `$type` operator spells it.
function type_name(kind: i64) -> str
    names = [
        "double"
        "string"
        "object"
        "array"
        "binData"
        "undefined"
        "objectId"
        "bool"
        "date"
        "null"
        "regex"
        "dbPointer"
        "javascript"
        "symbol"
        "javascriptWithScope"
        "int"
        "timestamp"
        "long"
        "decimal"
    ]

    if kind >= 1 && kind <= 19
        return names[kind - 1]
    else if kind == MAX_KEY
        return "maxKey"
    else if kind == MIN_KEY
        return "minKey"
    return "unknown"

# The name of an array's element at `index`: its index in decimal.
function index_name(index: i64) -> str
    return to_str(index)

# A failure saying a value of type `found` is not the kind `wanted` names.
function wrong_kind<T>(found: str, wanted: str) -> T?
    return fail(code: "invalid", msg: f"a value of type {found}, where {wanted} was expected")

# The index `s` spells in decimal digits alone. Fails `invalid` where `s` is
# empty, holds anything but digits, or has more than 18 of them.
function to_index(s: str) -> i64?
    if s.len() == 0 || s.len() > 18
        return fail(code: "invalid", msg: f"\"{s}\" is no index")
    n: i64 @= 0

    for i in range(from: 0, to: s.len())
        if s[i] < '0' || s[i] > '9'
            return fail(code: "invalid", msg: f"\"{s}\" is no index")
        n @ n * 10 + to_i64(s[i] - '0').must()

    return ok(n)

test "type_name: the first, the last of the numbered ones, the keys, and one no type has"
    assert type_name(DOUBLE) == "double"
    assert type_name(DECIMAL128) == "decimal"
    assert type_name(MIN_KEY) == "minKey" && type_name(MAX_KEY) == "maxKey"
    assert type_name(20) == "unknown" && type_name(0) == "unknown"

test "is_container: the three containers and a string"
    assert is_container(DOCUMENT) && is_container(ARRAY) && is_container(JAVASCRIPT_WITH_SCOPE)
    assert !is_container(STRING)

test "to_index: digits, a word, the empty text, and too many digits"
    assert to_index("12").must() == 12 && to_index("0").must() == 0
    assert to_index("x").is_err() && to_index("").is_err() && to_index("1234567890123456789").is_err()
    assert to_index("-1").is_err()
