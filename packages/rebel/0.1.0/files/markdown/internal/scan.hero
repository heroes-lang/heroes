# The characters CommonMark names, and the texts it rewrites: white space and
# punctuation as the specification defines them, backslash escapes, entity
# and numeric character references, link labels made comparable, link
# destinations percent-encoded, and text escaped for HTML.

use html
use strings
use unicode

# Whether `b` is a space or a tab.
function is_space_or_tab(b: u8) -> bool
    return b == ' ' || b == '\t'

# Whether `b` is an ASCII digit.
function is_digit(b: u8) -> bool
    return b >= '0' && b <= '9'

# Whether `b` is an ASCII letter.
function is_letter(b: u8) -> bool
    return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z'

# Whether `b` is an ASCII letter or digit.
function is_alnum(b: u8) -> bool
    return is_letter(b) || is_digit(b)

# Whether `b` is an ASCII hexadecimal digit.
function is_hex(b: u8) -> bool
    return is_digit(b) || b >= 'a' && b <= 'f' || b >= 'A' && b <= 'F'

# Whether `b` is ASCII punctuation, which a backslash escapes.
function is_ascii_punctuation(b: u8) -> bool
    return b >= '!' && b <= '/' || b >= ':' && b <= '@' || b >= '[' && b <= '`' || b >= '{' && b <= '~'

# Whether `b` is a space, a tab, a line feed, a form feed or a carriage
# return: ASCII white space.
function is_ascii_space(b: u8) -> bool
    return b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 12 || b == 11

# The character of `s` that begins at byte `at`; a line feed past the end.
function char_at(s: str, at: i64) -> str
    if at >= s.len()
        return "\n"
    return s.slice(from: at, to: strings.ceil_boundary(s, at + 1))

# The character of `s` that ends before byte `at`; a line feed at the start.
function char_before(s: str, at: i64) -> str
    if at <= 0
        return "\n"
    return s.slice(from: strings.floor_boundary(s, at - 1), to: at)

# Whether `c` is Unicode white space as CommonMark reads it: Zs, a tab, a
# line feed, a form feed or a carriage return.
function is_whitespace(c: str) -> bool
    if c == "\t" || c == "\n" || c == "\r" || c == "\u{c}"
        return true
    return unicode.category(c) == unicode.SPACE_SEPARATOR

# Whether `c` is Unicode punctuation as CommonMark 0.31 reads it: a
# character of the P or S categories.
function is_punctuation(c: str) -> bool
    return unicode.is_punctuation(c) || unicode.is_symbol(c)

# A reference read: the characters it stands for, and the byte after it.
record Reference
    # The characters.
    text: str
    # The byte after the `;`.
    end: i64

# The entity or numeric character reference beginning at the `&` at byte
# `at` of `s`, as CommonMark reads one; `end` 0 where there is none.
function reference_at(s: str, at: i64) -> Reference
    none = Reference(text: "", end: 0)

    if at + 2 >= s.len() || s[at] != '&'
        return none

    if s[at + 1] == '#'
        hex = s[at + 2] == 'x' || s[at + 2] == 'X'

        from = if hex
            at + 3
        else
            at + 2

        most = if hex
            6
        else
            7
        k @= from
        value @= 0

        while k < s.len() && k - from < most && (hex && is_hex(s[k]) || !hex && is_digit(s[k]))
            digit = if is_digit(s[k])
                to_i64(s[k] - '0').must()
            else if s[k] >= 'a'
                to_i64(s[k] - 'a').must() + 10
            else
                to_i64(s[k] - 'A').must() + 10

            value @ if hex
                value * 16 + digit
            else
                value * 10 + digit
            k @ k + 1

        if k == from || k >= s.len() || s[k] != ';'
            return none

        text = if value == 0
            "�"
        else
            unicode.from_code_point(value).default("�")
        return Reference(text: text, end: k + 1)

    if !is_letter(s[at + 1])
        return none
    k @= at + 1

    while k < s.len() && k - at <= 32 && is_alnum(s[k])
        k @ k + 1

    if k >= s.len() || s[k] != ';' || k - at - 1 < 2 || k - at - 1 > 32
        return none

    match html.named_reference(s.slice(from: at + 1, to: k + 1))
        .ok text => return Reference(text: text, end: k + 1)
        .err _   => return none

# `s` with its backslash escapes and its character references read.
function unescape(s: str) -> str
    if !strings.contains_any(s: s, set: "\\&")
        return s
    out: [str] @= []
    start @= 0
    at @= 0

    while at < s.len()
        b = s[at]

        if b == '\\' && at + 1 < s.len() && is_ascii_punctuation(s[at + 1])
            out @ out.push(s.slice(from: start, to: at))
            start @ at + 1
            at @ at + 2
        else if b == '&'
            found = reference_at(s, at)

            if found.end > 0
                out @ out.push(s.slice(from: start, to: at))
                out @ out.push(found.text)
                start @ found.end
                at @ found.end
            else
                at @ at + 1
        else
            at @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return join(out, "")

# The hexadecimal digits of a byte, upper case.
function hex_of(b: u8) -> str
    digits = "0123456789ABCDEF"
    high = to_i64(b / 16).must()
    low = to_i64(b % 16).must()
    return "%" + digits.slice(from: high, to: high + 1) + digits.slice(from: low, to: low + 1)

# Whether `b` stays as it is in a destination: an ASCII letter or digit, or
# one of `;/?:@&=+$,-_.!~*'()#`.
function keeps(b: u8) -> bool
    return is_alnum(b) || b == ';' || b == '/' || b == '?' || b == ':' || b == '@' || b == '&' || b == '=' || b == '+' || b == '$' || b == ',' || b == '-' || b == '_' || b == '.' || b == '!' || b == '~' || b == '*' || b == '\'' || b == '(' || b == ')' || b == '#'

# `s`, a link destination, with every byte that may not stand in a URL
# percent-encoded, and a `%` already followed by two hexadecimal digits kept.
function normalize_uri(s: str) -> str
    out: [str] @= []
    start @= 0
    at @= 0

    while at < s.len()
        b = s[at]

        if keeps(b) || b == '%' && at + 2 < s.len() && is_hex(s[at + 1]) && is_hex(s[at + 2])
            at @ at + 1
        else
            out @ out.push(s.slice(from: start, to: at))
            end = strings.ceil_boundary(s, at + 1)

            for k in range(from: at, to: end)
                out @ out.push(hex_of(s[k]))

            start @ end
            at @ end

    out @ out.push(s.slice(from: start, to: s.len()))
    return join(out, "")

# A link label, brackets included, made comparable: the brackets and the
# white space at its ends taken off, each run of white space one space, the
# case folded.
function normalize_label(label: str) -> str
    inner = label.slice(from: 1, to: label.len() - 1)
    out: [str] @= []
    run @= false

    for c in inner.chars()
        if c == " " || c == "\t" || c == "\n" || c == "\r"
            run @ true
        else
            if run && out.len() > 0
                out @ out.push(" ")
            run @ false
            out @ out.push(c)

    return strings.to_casefold(join(out, ""))

# `s` with `&`, `<`, `>` and `"` written as references, for HTML text and
# attribute values.
function escape(s: str) -> str
    if !strings.contains_any(s: s, set: "&<>\"")
        return s
    out: [str] @= []
    start @= 0

    for at in range(from: 0, to: s.len())
        b = s[at]

        sub = if b == '&'
            "&amp;"
        else if b == '<'
            "&lt;"
        else if b == '>'
            "&gt;"
        else if b == '"'
            "&quot;"
        else
            ""

        if sub.len() > 0
            out @ out.push(s.slice(from: start, to: at))
            out @ out.push(sub)
            start @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return join(out, "")

test "reference_at: named, decimal, hexadecimal, zero, too long, unknown"
    assert reference_at("&amp;", 0).text == "&"
    assert reference_at("&#35;", 0).text == "#"
    assert reference_at("&#X22;", 0).text == "\""
    assert reference_at("&#0;", 0).text == "�"
    assert reference_at("&#87654321;", 0).end == 0
    assert reference_at("&x;", 0).end == 0
    assert reference_at("&MadeUpEntity;", 0).end == 0
    assert reference_at("&#xD800;", 0).text == "�"

test "unescape: an escape, a reference, a backslash before a letter"
    assert unescape("\\*a&amp;b\\c") == "*a&b\\c"

test "normalize_uri: kept, encoded, a percent before hex kept and one not"
    assert normalize_uri("/url?a=1&b") == "/url?a=1&b"
    assert normalize_uri("foo bar\\ä") == "foo%20bar%5C%C3%A4"
    assert normalize_uri("%20%zz") == "%20%25zz"

test "normalize_label: case folded, white space collapsed"
    assert normalize_label("[ Foo\n  BAR ]") == "foo bar"
    assert normalize_label("[ẞ]") == normalize_label("[SS]")

test "escape: the four characters"
    assert escape("<a href=\"x\">&</a>") == "&lt;a href=&quot;x&quot;&gt;&amp;&lt;/a&gt;"

test "char_before and char_at: a character of two bytes, the ends"
    assert char_before("aé", 3) == "é" && char_at("éa", 0) == "é" && char_before("a", 0) == "\n" && char_at("a", 1) == "\n"
