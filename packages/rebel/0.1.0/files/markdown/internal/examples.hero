test "example 90: Setext headings"
    assert commonmark("Foo\\\n----\n") == "<h2>Foo\\</h2>\n"

test "example 91: Setext headings"
    assert commonmark("`Foo\n----\n`\n\n<a title=\"a lot\n---\nof dashes\"/>\n") == "<h2>`Foo</h2>\n<p>`</p>\n<h2>&lt;a title=&quot;a lot</h2>\n<p>of dashes&quot;/&gt;</p>\n"

test "example 92: Setext headings"
    assert commonmark("> Foo\n---\n") == "<blockquote>\n<p>Foo</p>\n</blockquote>\n<hr />\n"

test "example 93: Setext headings"
