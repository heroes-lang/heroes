    assert commonmark("[Foo]\n\n[foo]: /url \"title\"\n") == "<p><a href=\"/url\" title=\"title\">Foo</a></p>\n"

test "example 562: Links"
    assert commonmark("[foo] bar\n\n[foo]: /url\n") == "<p><a href=\"/url\">foo</a> bar</p>\n"

test "example 563: Links"
    assert commonmark("\\[foo]\n\n[foo]: /url \"title\"\n") == "<p>[foo]</p>\n"

test "example 564: Links"
    assert commonmark("[foo*]: /url\n\n*[foo*]\n") == "<p>*<a href=\"/url\">foo*</a></p>\n"

test "example 565: Links"
    assert commonmark("[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n") == "<p><a href=\"/url2\">foo</a></p>\n"

test "example 566: Links"
    assert commonmark("[foo][]\n\n[foo]: /url1\n") == "<p><a href=\"/url1\">foo</a></p>\n"

test "example 567: Links"
    assert commonmark("[foo]()\n\n[foo]: /url1\n") == "<p><a href=\"\">foo</a></p>\n"

test "example 568: Links"
    assert commonmark("[foo](not a link)\n\n[foo]: /url1\n") == "<p><a href=\"/url1\">foo</a>(not a link)</p>\n"

test "example 569: Links"
    assert commonmark("[foo][bar][baz]\n\n[baz]: /url\n") == "<p>[foo]<a href=\"/url\">bar</a></p>\n"

test "example 570: Links"
    assert commonmark("[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n") == "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>\n"

test "example 571: Links"
    assert commonmark("[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n") == "<p>[foo]<a href=\"/url1\">bar</a></p>\n"

test "example 572: Images"
    assert commonmark("![foo](/url \"title\")\n") == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n"

test "example 573: Images"
    assert commonmark("![foo *bar*]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n") == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n"

test "example 574: Images"
    assert commonmark("![foo ![bar](/url)](/url2)\n") == "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n"

test "example 575: Images"
    assert commonmark("![foo [bar](/url)](/url2)\n") == "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n"

test "example 576: Images"
    assert commonmark("![foo *bar*][]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n") == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n"

test "example 577: Images"
    assert commonmark("![foo *bar*][foobar]\n\n[FOOBAR]: train.jpg \"train & tracks\"\n") == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n"

test "example 578: Images"
    assert commonmark("![foo](train.jpg)\n") == "<p><img src=\"train.jpg\" alt=\"foo\" /></p>\n"

test "example 579: Images"
    assert commonmark("My ![foo bar](/path/to/train.jpg  \"title\"   )\n") == "<p>My <img src=\"/path/to/train.jpg\" alt=\"foo bar\" title=\"title\" /></p>\n"

test "example 580: Images"
    assert commonmark("![foo](<url>)\n") == "<p><img src=\"url\" alt=\"foo\" /></p>\n"

test "example 581: Images"
    assert commonmark("![](/url)\n") == "<p><img src=\"/url\" alt=\"\" /></p>\n"

test "example 582: Images"
    assert commonmark("![foo][bar]\n\n[bar]: /url\n") == "<p><img src=\"/url\" alt=\"foo\" /></p>\n"

test "example 583: Images"
    assert commonmark("![foo][bar]\n\n[BAR]: /url\n") == "<p><img src=\"/url\" alt=\"foo\" /></p>\n"

test "example 584: Images"
    assert commonmark("![foo][]\n\n[foo]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n"

test "example 585: Images"
    assert commonmark("![*foo* bar][]\n\n[*foo* bar]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>\n"

test "example 586: Images"
    assert commonmark("![Foo][]\n\n[foo]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>\n"

test "example 587: Images"
    assert commonmark("![foo] \n[]\n\n[foo]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" />\n[]</p>\n"

test "example 588: Images"
    assert commonmark("![foo]\n\n[foo]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n"

test "example 589: Images"
    assert commonmark("![*foo* bar]\n\n[*foo* bar]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>\n"

test "example 590: Images"
    assert commonmark("![[foo]]\n\n[[foo]]: /url \"title\"\n") == "<p>![[foo]]</p>\n<p>[[foo]]: /url &quot;title&quot;</p>\n"

test "example 591: Images"
    assert commonmark("![Foo]\n\n[foo]: /url \"title\"\n") == "<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>\n"

test "example 592: Images"
    assert commonmark("!\\[foo]\n\n[foo]: /url \"title\"\n") == "<p>![foo]</p>\n"

test "example 593: Images"
    assert commonmark("\\![foo]\n\n[foo]: /url \"title\"\n") == "<p>!<a href=\"/url\" title=\"title\">foo</a></p>\n"

test "example 594: Autolinks"
    assert commonmark("<http://foo.bar.baz>\n") == "<p><a href=\"http://foo.bar.baz\">http://foo.bar.baz</a></p>\n"

test "example 595: Autolinks"
    assert commonmark("<https://foo.bar.baz/test?q=hello&id=22&boolean>\n") == "<p><a href=\"https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\">https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a></p>\n"

test "example 596: Autolinks"
    assert commonmark("<irc://foo.bar:2233/baz>\n") == "<p><a href=\"irc://foo.bar:2233/baz\">irc://foo.bar:2233/baz</a></p>\n"

test "example 597: Autolinks"
    assert commonmark("<MAILTO:FOO@BAR.BAZ>\n") == "<p><a href=\"MAILTO:FOO@BAR.BAZ\">MAILTO:FOO@BAR.BAZ</a></p>\n"

test "example 598: Autolinks"
    assert commonmark("<a+b+c:d>\n") == "<p><a href=\"a+b+c:d\">a+b+c:d</a></p>\n"

test "example 599: Autolinks"
    assert commonmark("<made-up-scheme://foo,bar>\n") == "<p><a href=\"made-up-scheme://foo,bar\">made-up-scheme://foo,bar</a></p>\n"

test "example 600: Autolinks"
    assert commonmark("<https://../>\n") == "<p><a href=\"https://../\">https://../</a></p>\n"

test "example 601: Autolinks"
    assert commonmark("<localhost:5001/foo>\n") == "<p><a href=\"localhost:5001/foo\">localhost:5001/foo</a></p>\n"

test "example 602: Autolinks"
    assert commonmark("<https://foo.bar/baz bim>\n") == "<p>&lt;https://foo.bar/baz bim&gt;</p>\n"

test "example 603: Autolinks"
    assert commonmark("<https://example.com/\\[\\>\n") == "<p><a href=\"https://example.com/%5C%5B%5C\">https://example.com/\\[\\</a></p>\n"

test "example 604: Autolinks"
    assert commonmark("<foo@bar.example.com>\n") == "<p><a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a></p>\n"

test "example 605: Autolinks"
    assert commonmark("<foo+special@Bar.baz-bar0.com>\n") == "<p><a href=\"mailto:foo+special@Bar.baz-bar0.com\">foo+special@Bar.baz-bar0.com</a></p>\n"

test "example 606: Autolinks"
    assert commonmark("<foo\\+@bar.example.com>\n") == "<p>&lt;foo+@bar.example.com&gt;</p>\n"

test "example 607: Autolinks"
    assert commonmark("<>\n") == "<p>&lt;&gt;</p>\n"

test "example 608: Autolinks"
    assert commonmark("< https://foo.bar >\n") == "<p>&lt; https://foo.bar &gt;</p>\n"

test "example 609: Autolinks"
    assert commonmark("<m:abc>\n") == "<p>&lt;m:abc&gt;</p>\n"

test "example 610: Autolinks"
    assert commonmark("<foo.bar.baz>\n") == "<p>&lt;foo.bar.baz&gt;</p>\n"

test "example 611: Autolinks"
    assert commonmark("https://example.com\n") == "<p>https://example.com</p>\n"

test "example 612: Autolinks"
    assert commonmark("foo@bar.example.com\n") == "<p>foo@bar.example.com</p>\n"

test "example 613: Raw HTML"
    assert commonmark("<a><bab><c2c>\n") == "<p><a><bab><c2c></p>\n"

test "example 614: Raw HTML"
    assert commonmark("<a/><b2/>\n") == "<p><a/><b2/></p>\n"

test "example 615: Raw HTML"
    assert commonmark("<a  /><b2\ndata=\"foo\" >\n") == "<p><a  /><b2\ndata=\"foo\" ></p>\n"

test "example 616: Raw HTML"
    assert commonmark("<a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 />\n") == "<p><a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 /></p>\n"

test "example 617: Raw HTML"
    assert commonmark("Foo <responsive-image src=\"foo.jpg\" />\n") == "<p>Foo <responsive-image src=\"foo.jpg\" /></p>\n"

test "example 618: Raw HTML"
    assert commonmark("<33> <__>\n") == "<p>&lt;33&gt; &lt;__&gt;</p>\n"

test "example 619: Raw HTML"
    assert commonmark("<a h*#ref=\"hi\">\n") == "<p>&lt;a h*#ref=&quot;hi&quot;&gt;</p>\n"

test "example 620: Raw HTML"
    assert commonmark("<a href=\"hi'> <a href=hi'>\n") == "<p>&lt;a href=&quot;hi'&gt; &lt;a href=hi'&gt;</p>\n"

test "example 621: Raw HTML"
    assert commonmark("< a><\nfoo><bar/ >\n<foo bar=baz\nbim!bop />\n") == "<p>&lt; a&gt;&lt;\nfoo&gt;&lt;bar/ &gt;\n&lt;foo bar=baz\nbim!bop /&gt;</p>\n"

test "example 622: Raw HTML"
    assert commonmark("<a href='bar'title=title>\n") == "<p>&lt;a href='bar'title=title&gt;</p>\n"

test "example 623: Raw HTML"
    assert commonmark("</a></foo >\n") == "<p></a></foo ></p>\n"

test "example 624: Raw HTML"
    assert commonmark("</a href=\"foo\">\n") == "<p>&lt;/a href=&quot;foo&quot;&gt;</p>\n"

test "example 625: Raw HTML"
    assert commonmark("foo <!-- this is a --\ncomment - with hyphens -->\n") == "<p>foo <!-- this is a --\ncomment - with hyphens --></p>\n"

test "example 626: Raw HTML"
    assert commonmark("foo <!--> foo -->\n\nfoo <!---> foo -->\n") == "<p>foo <!--> foo --&gt;</p>\n<p>foo <!---> foo --&gt;</p>\n"

test "example 627: Raw HTML"
    assert commonmark("foo <?php echo $a; ?>\n") == "<p>foo <?php echo $a; ?></p>\n"

test "example 628: Raw HTML"
    assert commonmark("foo <!ELEMENT br EMPTY>\n") == "<p>foo <!ELEMENT br EMPTY></p>\n"

test "example 629: Raw HTML"
    assert commonmark("foo <![CDATA[>&<]]>\n") == "<p>foo <![CDATA[>&<]]></p>\n"

test "example 630: Raw HTML"
    assert commonmark("foo <a href=\"&ouml;\">\n") == "<p>foo <a href=\"&ouml;\"></p>\n"

test "example 631: Raw HTML"
    assert commonmark("foo <a href=\"\\*\">\n") == "<p>foo <a href=\"\\*\"></p>\n"

test "example 632: Raw HTML"
    assert commonmark("<a href=\"\\\"\">\n") == "<p>&lt;a href=&quot;&quot;&quot;&gt;</p>\n"

test "example 633: Hard line breaks"
    assert commonmark("foo  \nbaz\n") == "<p>foo<br />\nbaz</p>\n"

test "example 634: Hard line breaks"
    assert commonmark("foo\\\nbaz\n") == "<p>foo<br />\nbaz</p>\n"

test "example 635: Hard line breaks"
    assert commonmark("foo       \nbaz\n") == "<p>foo<br />\nbaz</p>\n"

test "example 636: Hard line breaks"
    assert commonmark("foo  \n     bar\n") == "<p>foo<br />\nbar</p>\n"

test "example 637: Hard line breaks"
    assert commonmark("foo\\\n     bar\n") == "<p>foo<br />\nbar</p>\n"

test "example 638: Hard line breaks"
    assert commonmark("*foo  \nbar*\n") == "<p><em>foo<br />\nbar</em></p>\n"

test "example 639: Hard line breaks"
    assert commonmark("*foo\\\nbar*\n") == "<p><em>foo<br />\nbar</em></p>\n"

test "example 640: Hard line breaks"
    assert commonmark("`code  \nspan`\n") == "<p><code>code   span</code></p>\n"

test "example 641: Hard line breaks"
    assert commonmark("`code\\\nspan`\n") == "<p><code>code\\ span</code></p>\n"

test "example 642: Hard line breaks"
    assert commonmark("<a href=\"foo  \nbar\">\n") == "<p><a href=\"foo  \nbar\"></p>\n"

test "example 643: Hard line breaks"
    assert commonmark("<a href=\"foo\\\nbar\">\n") == "<p><a href=\"foo\\\nbar\"></p>\n"

test "example 644: Hard line breaks"
    assert commonmark("foo\\\n") == "<p>foo\\</p>\n"

test "example 645: Hard line breaks"
    assert commonmark("foo  \n") == "<p>foo</p>\n"

test "example 646: Hard line breaks"
    assert commonmark("### foo\\\n") == "<h3>foo\\</h3>\n"

test "example 647: Hard line breaks"
    assert commonmark("### foo  \n") == "<h3>foo</h3>\n"

test "example 648: Soft line breaks"
    assert commonmark("foo\nbaz\n") == "<p>foo\nbaz</p>\n"

test "example 649: Soft line breaks"
    assert commonmark("foo \n baz\n") == "<p>foo\nbaz</p>\n"

test "example 650: Textual content"
    assert commonmark("hello $.;'there\n") == "<p>hello $.;'there</p>\n"

test "example 651: Textual content"
    assert commonmark("Foo χρῆν\n") == "<p>Foo χρῆν</p>\n"

test "example 652: Textual content"
    assert commonmark("Multiple     spaces\n") == "<p>Multiple     spaces</p>\n"

test "GFM example 1: Tables (extension)"
    assert gfm("| foo | bar |\n| --- | --- |\n| baz | bim |\n") == "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"

test "GFM example 2: Tables (extension)"
    assert gfm("| abc | defghi |\n:-: | -----------:\nbar | baz\n") == "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n"

test "GFM example 3: Tables (extension)"
    assert gfm("| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n") == "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n"

test "GFM example 4: Tables (extension)"
    assert gfm("| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"

test "GFM example 5: Tables (extension)"
    assert gfm("| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n"

test "GFM example 6: Tables (extension)"
    assert gfm("| abc | def |\n| --- |\n| bar |\n") == "<p>| abc | def |\n| --- |\n| bar |</p>\n"

test "GFM example 7: Tables (extension)"
    assert gfm("| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"

test "GFM example 8: Tables (extension)"
    assert gfm("| abc | def |\n| --- | --- |\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>\n"

test "GFM example 9: Task list items (extension)"
    assert gfm("- [ ] foo\n- [x] bar\n") == "<ul>\n<li><input disabled=\"\" type=\"checkbox\"> foo</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> bar</li>\n</ul>\n"

test "GFM example 10: Task list items (extension)"
    assert gfm("- [x] foo\n  - [ ] bar\n  - [x] baz\n- [ ] bim\n") == "<ul>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> foo\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> bar</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> baz</li>\n</ul>\n</li>\n<li><input disabled=\"\" type=\"checkbox\"> bim</li>\n</ul>\n"

test "GFM example 11: Strikethrough (extension)"
    assert gfm("~~Hi~~ Hello, world!\n") == "<p><del>Hi</del> Hello, world!</p>\n"

test "GFM example 12: Strikethrough (extension)"
    assert gfm("This ~~has a\n\nnew paragraph~~.\n") == "<p>This ~~has a</p>\n<p>new paragraph~~.</p>\n"

test "GFM example 13: Autolinks (extension)"
    assert gfm("www.commonmark.org\n") == "<p><a href=\"http://www.commonmark.org\">www.commonmark.org</a></p>\n"

test "GFM example 14: Autolinks (extension)"
    assert gfm("Visit www.commonmark.org/help for more information.\n") == "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n"

test "GFM example 15: Autolinks (extension)"
    assert gfm("Visit www.commonmark.org.\n\nVisit www.commonmark.org/a.b.\n") == "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>Visit <a href=\"http://www.commonmark.org/a.b\">www.commonmark.org/a.b</a>.</p>\n"

test "GFM example 16: Autolinks (extension)"
    assert gfm("www.google.com/search?q=Markup+(business)\n\nwww.google.com/search?q=Markup+(business)))\n\n(www.google.com/search?q=Markup+(business))\n\n(www.google.com/search?q=Markup+(business)\n") == "<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>)</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n"

test "GFM example 17: Autolinks (extension)"
    assert gfm("www.google.com/search?q=(business))+ok\n") == "<p><a href=\"http://www.google.com/search?q=(business))+ok\">www.google.com/search?q=(business))+ok</a></p>\n"

test "GFM example 18: Autolinks (extension)"
    assert gfm("www.google.com/search?q=commonmark&hl=en\n\nwww.google.com/search?q=commonmark&hl;\n") == "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en\">www.google.com/search?q=commonmark&amp;hl=en</a></p>\n<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n"

test "GFM example 19: Autolinks (extension)"
    assert gfm("www.commonmark.org/he<lp\n") == "<p><a href=\"http://www.commonmark.org/he\">www.commonmark.org/he</a>&lt;lp</p>\n"

test "GFM example 20: Autolinks (extension)"
    assert gfm("http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n\nAnonymous FTP is available at ftp://foo.bar.baz.\n") == "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n<p>Anonymous FTP is available at <a href=\"ftp://foo.bar.baz\">ftp://foo.bar.baz</a>.</p>\n"

test "GFM example 21: Autolinks (extension)"
    assert gfm("foo@bar.baz\n") == "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n"

test "GFM example 22: Autolinks (extension)"
    assert gfm("hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n") == "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n"

test "GFM example 23: Autolinks (extension)"
    assert gfm("a.b-c_d@a.b\n\na.b-c_d@a.b.\n\na.b-c_d@a.b-\n\na.b-c_d@a.b_\n") == "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a></p>\n<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n<p>a.b-c_d@a.b-</p>\n<p>a.b-c_d@a.b_</p>\n"
