# The examples of the CommonMark specification, version 0.31.2, every one,
# its Markdown and the HTML it must give, as fetched from
# spec.commonmark.org/0.31.2/spec.json on 2026-11-17; and the examples of
# GFM's tables, strikethrough, extended autolinks and task list items from
# the GFM specification (github/cmark-gfm, test/spec.txt) the same day. Each
# is a test; nothing else here is compiled into a program.

use markdown/internal/pipeline
use markdown/internal/render

# The version of the CommonMark specification whose examples these are.
constant VERSION: str
    "0.31.2"

# The HTML of `text` read and written as the specification's reference
# does: CommonMark alone, raw HTML and every destination kept.
function commonmark(text: str) -> str
    rules = pipeline.Rules(max_depth: 1000, tables: false, strikethrough: false, autolinks: false, tasks: false)
    return pipeline.html_of(text, rules: rules, style: render.Style(keep_html: true, keep_unsafe: true))

# The HTML of `text` read with GFM's extensions, raw HTML and every
# destination kept.
function gfm(text: str) -> str
    rules = pipeline.Rules(max_depth: 1000, tables: true, strikethrough: true, autolinks: true, tasks: true)
    return pipeline.html_of(text, rules: rules, style: render.Style(keep_html: true, keep_unsafe: true))

test "example 1: Tabs"
    assert commonmark("\tfoo\tbaz\t\tbim\n") == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"

test "example 2: Tabs"
    assert commonmark("  \tfoo\tbaz\t\tbim\n") == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"

test "example 3: Tabs"
    assert commonmark("    a\ta\n    ὐ\ta\n") == "<pre><code>a\ta\nὐ\ta\n</code></pre>\n"

test "example 4: Tabs"
    assert commonmark("  - foo\n\n\tbar\n") == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n"

test "example 5: Tabs"
    assert commonmark("- foo\n\n\t\tbar\n") == "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n"

test "example 6: Tabs"
    assert commonmark(">\t\tfoo\n") == "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n"

test "example 7: Tabs"
    assert commonmark("-\t\tfoo\n") == "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n"

test "example 8: Tabs"
    assert commonmark("    foo\n\tbar\n") == "<pre><code>foo\nbar\n</code></pre>\n"

test "example 9: Tabs"
    assert commonmark(" - foo\n   - bar\n\t - baz\n") == "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n"

test "example 10: Tabs"
    assert commonmark("#\tFoo\n") == "<h1>Foo</h1>\n"

test "example 11: Tabs"
    assert commonmark("*\t*\t*\t\n") == "<hr />\n"

test "example 12: Backslash escapes"
    assert commonmark("\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n") == "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n"

test "example 13: Backslash escapes"
    assert commonmark("\\\t\\A\\a\\ \\3\\φ\\«\n") == "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>\n"

test "example 14: Backslash escapes"
    assert commonmark("\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity\n") == "<p>*not emphasized*\n&lt;br/&gt; not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url &quot;not a reference&quot;\n&amp;ouml; not a character entity</p>\n"

test "example 15: Backslash escapes"
    assert commonmark("\\\\*emphasis*\n") == "<p>\\<em>emphasis</em></p>\n"

test "example 16: Backslash escapes"
    assert commonmark("foo\\\nbar\n") == "<p>foo<br />\nbar</p>\n"

test "example 17: Backslash escapes"
    assert commonmark("`` \\[\\` ``\n") == "<p><code>\\[\\`</code></p>\n"

test "example 18: Backslash escapes"
    assert commonmark("    \\[\\]\n") == "<pre><code>\\[\\]\n</code></pre>\n"

test "example 19: Backslash escapes"
    assert commonmark("~~~\n\\[\\]\n~~~\n") == "<pre><code>\\[\\]\n</code></pre>\n"

test "example 20: Backslash escapes"
    assert commonmark("<https://example.com?find=\\*>\n") == "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>\n"

test "example 21: Backslash escapes"
    assert commonmark("<a href=\"/bar\\/)\">\n") == "<a href=\"/bar\\/)\">\n"

test "example 22: Backslash escapes"
    assert commonmark("[foo](/bar\\* \"ti\\*tle\")\n") == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n"

test "example 23: Backslash escapes"
    assert commonmark("[foo]\n\n[foo]: /bar\\* \"ti\\*tle\"\n") == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n"

test "example 24: Backslash escapes"
    assert commonmark("``` foo\\+bar\nfoo\n```\n") == "<pre><code class=\"language-foo+bar\">foo\n</code></pre>\n"

test "example 25: Entity and numeric character references"
    assert commonmark("&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n") == "<p>  &amp; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>\n"

test "example 26: Entity and numeric character references"
    assert commonmark("&#35; &#1234; &#992; &#0;\n") == "<p># Ӓ Ϡ �</p>\n"

test "example 27: Entity and numeric character references"
    assert commonmark("&#X22; &#XD06; &#xcab;\n") == "<p>&quot; ആ ಫ</p>\n"

test "example 28: Entity and numeric character references"
    assert commonmark("&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?;\n") == "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#abcdef0;\n&amp;ThisIsNotDefined; &amp;hi?;</p>\n"

test "example 29: Entity and numeric character references"
    assert commonmark("&copy\n") == "<p>&amp;copy</p>\n"

test "example 30: Entity and numeric character references"
    assert commonmark("&MadeUpEntity;\n") == "<p>&amp;MadeUpEntity;</p>\n"

test "example 31: Entity and numeric character references"
    assert commonmark("<a href=\"&ouml;&ouml;.html\">\n") == "<a href=\"&ouml;&ouml;.html\">\n"

test "example 32: Entity and numeric character references"
    assert commonmark("[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\")\n") == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n"

test "example 33: Entity and numeric character references"
    assert commonmark("[foo]\n\n[foo]: /f&ouml;&ouml; \"f&ouml;&ouml;\"\n") == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n"

test "example 34: Entity and numeric character references"
    assert commonmark("``` f&ouml;&ouml;\nfoo\n```\n") == "<pre><code class=\"language-föö\">foo\n</code></pre>\n"

test "example 35: Entity and numeric character references"
    assert commonmark("`f&ouml;&ouml;`\n") == "<p><code>f&amp;ouml;&amp;ouml;</code></p>\n"

test "example 36: Entity and numeric character references"
    assert commonmark("    f&ouml;f&ouml;\n") == "<pre><code>f&amp;ouml;f&amp;ouml;\n</code></pre>\n"

test "example 37: Entity and numeric character references"
    assert commonmark("&#42;foo&#42;\n*foo*\n") == "<p>*foo*\n<em>foo</em></p>\n"

test "example 38: Entity and numeric character references"
    assert commonmark("&#42; foo\n\n* foo\n") == "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>\n"

test "example 39: Entity and numeric character references"
    assert commonmark("foo&#10;&#10;bar\n") == "<p>foo\n\nbar</p>\n"

test "example 40: Entity and numeric character references"
    assert commonmark("&#9;foo\n") == "<p>\tfoo</p>\n"

test "example 41: Entity and numeric character references"
    assert commonmark("[a](url &quot;tit&quot;)\n") == "<p>[a](url &quot;tit&quot;)</p>\n"

test "example 42: Precedence"
    assert commonmark("- `one\n- two`\n") == "<ul>\n<li>`one</li>\n<li>two`</li>\n</ul>\n"

test "example 43: Thematic breaks"
    assert commonmark("***\n---\n___\n") == "<hr />\n<hr />\n<hr />\n"

test "example 44: Thematic breaks"
    assert commonmark("+++\n") == "<p>+++</p>\n"

test "example 45: Thematic breaks"
    assert commonmark("===\n") == "<p>===</p>\n"

test "example 46: Thematic breaks"
    assert commonmark("--\n**\n__\n") == "<p>--\n**\n__</p>\n"

test "example 47: Thematic breaks"
    assert commonmark(" ***\n  ***\n   ***\n") == "<hr />\n<hr />\n<hr />\n"

test "example 48: Thematic breaks"
    assert commonmark("    ***\n") == "<pre><code>***\n</code></pre>\n"

test "example 49: Thematic breaks"
    assert commonmark("Foo\n    ***\n") == "<p>Foo\n***</p>\n"

test "example 50: Thematic breaks"
    assert commonmark("_____________________________________\n") == "<hr />\n"

test "example 51: Thematic breaks"
    assert commonmark(" - - -\n") == "<hr />\n"

test "example 52: Thematic breaks"
    assert commonmark(" **  * ** * ** * **\n") == "<hr />\n"

test "example 53: Thematic breaks"
    assert commonmark("-     -      -      -\n") == "<hr />\n"

test "example 54: Thematic breaks"
    assert commonmark("- - - -    \n") == "<hr />\n"

test "example 55: Thematic breaks"
    assert commonmark("_ _ _ _ a\n\na------\n\n---a---\n") == "<p>_ _ _ _ a</p>\n<p>a------</p>\n<p>---a---</p>\n"

test "example 56: Thematic breaks"
    assert commonmark(" *-*\n") == "<p><em>-</em></p>\n"

test "example 57: Thematic breaks"
    assert commonmark("- foo\n***\n- bar\n") == "<ul>\n<li>foo</li>\n</ul>\n<hr />\n<ul>\n<li>bar</li>\n</ul>\n"

test "example 58: Thematic breaks"
    assert commonmark("Foo\n***\nbar\n") == "<p>Foo</p>\n<hr />\n<p>bar</p>\n"

test "example 59: Thematic breaks"
    assert commonmark("Foo\n---\nbar\n") == "<h2>Foo</h2>\n<p>bar</p>\n"

test "example 60: Thematic breaks"
    assert commonmark("* Foo\n* * *\n* Bar\n") == "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n<ul>\n<li>Bar</li>\n</ul>\n"

test "example 61: Thematic breaks"
    assert commonmark("- Foo\n- * * *\n") == "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n"

test "example 62: ATX headings"
    assert commonmark("# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n") == "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n"

test "example 63: ATX headings"
    assert commonmark("####### foo\n") == "<p>####### foo</p>\n"

test "example 64: ATX headings"
    assert commonmark("#5 bolt\n\n#hashtag\n") == "<p>#5 bolt</p>\n<p>#hashtag</p>\n"

test "example 65: ATX headings"
    assert commonmark("\\## foo\n") == "<p>## foo</p>\n"

test "example 66: ATX headings"
    assert commonmark("# foo *bar* \\*baz\\*\n") == "<h1>foo <em>bar</em> *baz*</h1>\n"

test "example 67: ATX headings"
    assert commonmark("#                  foo                     \n") == "<h1>foo</h1>\n"

test "example 68: ATX headings"
    assert commonmark(" ### foo\n  ## foo\n   # foo\n") == "<h3>foo</h3>\n<h2>foo</h2>\n<h1>foo</h1>\n"

test "example 69: ATX headings"
    assert commonmark("    # foo\n") == "<pre><code># foo\n</code></pre>\n"

test "example 70: ATX headings"
    assert commonmark("foo\n    # bar\n") == "<p>foo\n# bar</p>\n"

test "example 71: ATX headings"
    assert commonmark("## foo ##\n  ###   bar    ###\n") == "<h2>foo</h2>\n<h3>bar</h3>\n"

test "example 72: ATX headings"
    assert commonmark("# foo ##################################\n##### foo ##\n") == "<h1>foo</h1>\n<h5>foo</h5>\n"

test "example 73: ATX headings"
    assert commonmark("### foo ###     \n") == "<h3>foo</h3>\n"

test "example 74: ATX headings"
