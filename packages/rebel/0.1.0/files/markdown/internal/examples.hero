test "example 75: ATX headings"
    assert commonmark("# foo#\n") == "<h1>foo#</h1>\n"

test "example 76: ATX headings"
    assert commonmark("### foo \\###\n## foo #\\##\n# foo \\#\n") == "<h3>foo ###</h3>\n<h2>foo ###</h2>\n<h1>foo #</h1>\n"

test "example 77: ATX headings"
    assert commonmark("****\n## foo\n****\n") == "<hr />\n<h2>foo</h2>\n<hr />\n"

test "example 78: ATX headings"
    assert commonmark("Foo bar\n# baz\nBar foo\n") == "<p>Foo bar</p>\n<h1>baz</h1>\n<p>Bar foo</p>\n"

test "example 79: ATX headings"
    assert commonmark("## \n#\n### ###\n") == "<h2></h2>\n<h1></h1>\n<h3></h3>\n"

test "example 80: Setext headings"
    assert commonmark("Foo *bar*\n=========\n\nFoo *bar*\n---------\n") == "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n"

test "example 81: Setext headings"
    assert commonmark("Foo *bar\nbaz*\n====\n") == "<h1>Foo <em>bar\nbaz</em></h1>\n"

test "example 82: Setext headings"
    assert commonmark("  Foo *bar\nbaz*\t\n====\n") == "<h1>Foo <em>bar\nbaz</em></h1>\n"

test "example 83: Setext headings"
    assert commonmark("Foo\n-------------------------\n\nFoo\n=\n") == "<h2>Foo</h2>\n<h1>Foo</h1>\n"

test "example 84: Setext headings"
    assert commonmark("   Foo\n---\n\n  Foo\n-----\n\n  Foo\n  ===\n") == "<h2>Foo</h2>\n<h2>Foo</h2>\n<h1>Foo</h1>\n"

test "example 85: Setext headings"
    assert commonmark("    Foo\n    ---\n\n    Foo\n---\n") == "<pre><code>Foo\n---\n\nFoo\n</code></pre>\n<hr />\n"

