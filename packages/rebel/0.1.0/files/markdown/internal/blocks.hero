# The first phase of reading: the text cut into lines, and each line matched
# against the open blocks, from the document down, then tried for new block
# starts, then added to the block that takes it, as the specification's
# appendix "A parsing strategy" describes. The open blocks are the tip and
# its parents, so the reader keeps no stack of its own however deep they
# nest.

use markdown/internal/build
use markdown/internal/cursor
use markdown/internal/htmltag
use markdown/internal/links
use markdown/internal/scan
use markdown/internal/starts
use markdown/internal/tree

# What the first phase reads: the blocks, and the link reference
# definitions.
record Blocks
    # The tree of blocks, node 0 the document; leaf blocks hold their raw
    # text.
    nodes: [tree.Node]
    # The definitions by normalised label.
    refs: {str: links.Target}

# How the reader reads.
record Rules
    # The most containers one inside another.
    max_depth: i64
    # Whether GFM tables are read.
    tables: bool
    # Whether GFM task list items are read.
    tasks: bool

# The lines of `text`: cut at a line feed, a carriage return, or both, the
# endings taken off, a zero byte made U+FFFD.
function lines_of(text: str) -> [str]
    out: [str] @= []
    piece: [str] @= []
    start @= 0
    at @= 0

    while at < text.len()
        b = text[at]

        if b == '\n' || b == '\r'
            piece @ piece.push(text.slice(from: start, to: at))
            out @ out.push(join(piece, ""))
            piece @ []

            if b == '\r' && at + 1 < text.len() && text[at + 1] == '\n'
                at @ at + 1
            start @ at + 1
        else if b == 0
            piece @ piece.push(text.slice(from: start, to: at))
            piece @ piece.push("�")
            start @ at + 1
        at @ at + 1

    if start < text.len() || piece.len() > 0
        piece @ piece.push(text.slice(from: start, to: text.len()))
        out @ out.push(join(piece, ""))
    return out

# The blocks of `text`.
function read(text: str, rules: Rules) -> Blocks
    nodes: [tree.Node] @= [tree.make(tree.DOCUMENT)]
    nodes[0].start_line @ 1
    refs: {str: links.Target} @= {}
    lines: [str] @= []
    c @= cursor.Cursor(
        line: "",
        number: 0,
        offset: 0,
        column: 0,
        next_nonspace: 0,
        next_nonspace_column: 0,
        indent: 0,
        indented: false,
        blank: false,
        partial_tab: false,
        tip: 0,
        old_tip: 0,
        last_matched: 0,
        all_closed: true,
        max_depth: rules.max_depth,
        tables: rules.tables,
        tasks: rules.tasks,
        seen_line: 0,
        seen_from: 0
    )
    every = lines_of(text)

    for line in every
        incorporate(@c, @nodes, @lines, @refs, line: line)

    while c.tip != tree.NONE
        build.finalize(@c, @nodes, @lines, @refs, block: c.tip, line: every.len())

    return Blocks(nodes: nodes, refs: refs)

# Whether the open block `block` continues on the line: 0 where it does, 1
# where it does not, 2 where the line is all its own and is done.
function continues(@c: cursor.Cursor, @nodes: [tree.Node], @lines: [str], @refs: {str: links.Target}, block: i64) -> i64
    kind = nodes[block].kind
    s = c.line

    if kind == tree.BLOCK_QUOTE
        if !c.indented && cursor.byte_at(c, at: c.next_nonspace) == '>'
            cursor.advance_next_nonspace(@c)
            cursor.advance(@c, count: 1, columns: false)

            if scan.is_space_or_tab(cursor.byte_at(c, at: c.offset))
                cursor.advance(@c, count: 1, columns: true)
            return 0
        return 1

    if kind == tree.ITEM
        if c.blank
            if nodes[block].first == tree.NONE
                return 1
            cursor.advance_next_nonspace(@c)
            return 0

        if c.indent >= nodes[block].width
            cursor.advance(@c, count: nodes[block].width, columns: true)
            return 0
        return 1

    if kind == tree.CODE_BLOCK
        if nodes[block].flag
            mark = nodes[block].marker[0]
            k @= c.next_nonspace

            while k < s.len() && s[k] == mark
                k @ k + 1

            size = k - c.next_nonspace

            while k < s.len() && scan.is_space_or_tab(s[k])
                k @ k + 1

            if c.indent <= 3 && size >= nodes[block].number && k == s.len()
                build.finalize(@c, @nodes, @lines, @refs, block: block, line: c.number)
                return 2
            skip @= nodes[block].width

            while skip > 0 && scan.is_space_or_tab(cursor.byte_at(c, at: c.offset))
                cursor.advance(@c, count: 1, columns: true)
                skip @ skip - 1

            return 0

        if c.indent >= cursor.CODE_INDENT
            cursor.advance(@c, count: cursor.CODE_INDENT, columns: true)
            return 0

        if c.blank
            cursor.advance_next_nonspace(@c)
            return 0
        return 1

    if kind == tree.HTML_BLOCK
        if c.blank && (nodes[block].state == 6 || nodes[block].state == 7)
            return 1
        return 0

    if kind == tree.PARAGRAPH || kind == tree.TABLE
        if c.blank
            return 1
        return 0

    if kind == tree.HEADING || kind == tree.THEMATIC_BREAK
        return 1
    return 0

# Whether the rest of the line, from its first character that is not a
# space, could start a block.
function maybe_special(c: cursor.Cursor lent) -> bool
    b = cursor.byte_at(c, at: c.next_nonspace)
    return b == '#' || b == '`' || b == '~' || b == '*' || b == '+' || b == '_' || b == '=' || b == '<' || b == '>' || b == '-' || scan.is_digit(b) || c.tables && (b == '|' || b == ':')

# Adds the rest of the line to the tip, a tab partly used written as the
# spaces it has left.
function add_line(@c: cursor.Cursor, @lines: [str])
    if c.partial_tab
        c.offset @ c.offset + 1
        to_tab = 4 - c.column % 4
        lines @ lines.push(repeat(" ", to_u64(to_tab).must()))
    lines @ lines.push(c.line.slice(from: c.offset, to: c.line.len()) + "\n")

# Reads one line into the tree.
function incorporate(@c: cursor.Cursor, @nodes: [tree.Node], @lines: [str], @refs: {str: links.Target}, line: str)
    c.line @ line
    c.number @ c.number + 1
    c.offset @ 0
    c.column @ 0
    c.blank @ false
    c.partial_tab @ false
    c.old_tip @ c.tip
    container @= 0

    while nodes[container].last != tree.NONE && nodes[nodes[container].last].open
        child = nodes[container].last
        cursor.find_next_nonspace(@c)
        answer = continues(@c, @nodes, @lines, @refs, block: child)

        if answer == 2
            return

        if answer == 1
            break
        container @ child

    c.all_closed @ container == c.old_tip
    c.last_matched @ container
    matched_leaf @= nodes[container].kind != tree.PARAGRAPH && nodes[container].kind != tree.TABLE && build.accepts_lines(nodes[container].kind)

    while !matched_leaf
        cursor.find_next_nonspace(@c)

        if !c.indented && !maybe_special(c)
            cursor.advance_next_nonspace(@c)
            break
        started = starts.try_starts(@c, @nodes, @lines, @refs, container: container)

        if started == 0
            cursor.advance_next_nonspace(@c)
            break
        container @ c.tip

        if started == 2
            matched_leaf @ true

    if !c.all_closed && !c.blank && nodes[c.tip].kind == tree.PARAGRAPH
        add_line(@c, @lines)
        return
    build.close_unmatched(@c, @nodes, @lines, @refs)
    kind = nodes[container].kind

    if c.blank && nodes[container].last != tree.NONE
        nodes[nodes[container].last].last_blank @ true
    empty_item = kind == tree.ITEM && nodes[container].first == tree.NONE && nodes[container].start_line == c.number
    blank_here = c.blank && !(kind == tree.BLOCK_QUOTE || kind == tree.CODE_BLOCK && nodes[container].flag || empty_item)
    up @= container

    while up != tree.NONE
        nodes[up].last_blank @ blank_here
        up @ nodes[up].parent

    if build.accepts_lines(kind)
        if kind == tree.TABLE && c.blank
            return
        add_line(@c, @lines)

        if kind == tree.HTML_BLOCK
            state = nodes[container].state

            if state >= 1 && state <= 5 && htmltag.block_ends(c.line.slice(from: c.offset, to: c.line.len()), state)
                build.finalize(@c, @nodes, @lines, @refs, block: container, line: c.number)
    else if c.offset < c.line.len() && !c.blank
        _ = build.add_child(@c, @nodes, @lines, @refs, kind: tree.PARAGRAPH)
        cursor.advance_next_nonspace(@c)
        add_line(@c, @lines)

test "lines_of: three endings, a last line with none, a zero byte"
    assert lines_of("a\nb\r\nc\rd") == ["a", "b", "c", "d"]
    assert lines_of("a\n") == ["a"]
    assert lines_of("") == []
    assert lines_of("\n\n") == ["", ""]
