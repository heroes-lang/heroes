# Integers divided by the rules `/` and `%` do not follow (down, Euclid's, up),
# compared, and taken many at once.
#
# A zero divisor aborts here as it does for `/` and `%`, a precondition the
# caller can check; `MIN_I64` by -1, whose quotient is one past `MAX_I64`,
# fails `does_not_fit`, and every remainder by -1 is 0, which `%` itself
# aborts on for `MIN_I64`.

use math/internal/checked
use math/internal/limits
use math/internal/wrapping

# The quotient of `x` by `by` rounded down.
#
# - `x`: the dividend.
# - `by`: the divisor.
function div_floor_i64(x: i64, by: i64) -> i64?
    if x == limits.MIN_I64 && by == -1
        return fail(code: limits.DOES_NOT_FIT, msg: f"{x} divided by -1 is outside i64")
    quotient = x / by

    if by != -1 && x % by != 0 && x % by < 0 != (by < 0)
        return ok(quotient - 1)
    return ok(quotient)

# The remainder of `x` by `by` with the sign of `by`.
#
# - `x`: the dividend.
# - `by`: the divisor.
function rem_floor_i64(x: i64, by: i64) -> i64
    if by == -1
        return 0
    remainder = x % by

    if remainder != 0 && remainder < 0 != (by < 0)
        return remainder + by
    return remainder

# The quotient of `x` by `by` whose remainder is never negative.
#
# - `x`: the dividend.
# - `by`: the divisor.
function div_euclid_i64(x: i64, by: i64) -> i64?
    if x == limits.MIN_I64 && by == -1
        return fail(code: limits.DOES_NOT_FIT, msg: f"{x} divided by -1 is outside i64")
    quotient = x / by

    if by == -1 || x % by >= 0
        return ok(quotient)

    if by > 0
        return ok(quotient - 1)
    return ok(quotient + 1)

# The remainder of `x` by `by` that is never negative. Where `by` is negative
# the remainder less `by` adds its size, which no `MIN_I64` can overflow.
#
# - `x`: the dividend.
# - `by`: the divisor.
function rem_euclid_i64(x: i64, by: i64) -> i64
    if by == -1
        return 0
    remainder = x % by

    if remainder >= 0
        return remainder

    if by > 0
        return remainder + by
    return remainder - by

# The quotient of `x` by `by` rounded up.
#
# - `x`: the dividend.
# - `by`: the divisor.
function div_ceil(x: i64, by: i64) -> i64?
    if x == limits.MIN_I64 && by == -1
        return fail(code: limits.DOES_NOT_FIT, msg: f"{x} divided by -1 is outside i64")
    quotient = x / by

    if by != -1 && x % by != 0 && x % by > 0 == (by > 0)
        return ok(quotient + 1)
    return ok(quotient)

# The smaller of `a` and `b`.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function min_i64(a: i64, b: i64) -> i64
    if a < b
        return a
    return b

# The larger of `a` and `b`.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function max_i64(a: i64, b: i64) -> i64
    if a > b
        return a
    return b

# `x` held between `low` and `high`.
#
# - `x`: any `i64`.
# - `low`: the smallest answer.
# - `high`: the largest answer.
function clamp_i64(x: i64, low: i64, high: i64) -> i64
    assert low <= high
    return min_i64(a: max_i64(a: x, b: low), b: high)

# -1, 0 or 1, as `x` is negative, zero or positive.
#
# - `x`: any `i64`.
function sign_i64(x: i64) -> i64
    if x > 0
        return 1

    if x < 0
        return -1
    return 0

# The integer halfway between `a` and `b`, toward zero. Of opposite signs the
# sum cannot overflow; of one sign the halves add, and the two remainders of
# halving add the one that is left where both were odd.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function midpoint_i64(a: i64, b: i64) -> i64
    if a < 0 != (b < 0)
        return (a + b) / 2
    return a / 2 + b / 2 + (a % 2 + b % 2) / 2

# The sum of `xs`. It adds modulo 2 to the 64 and counts each time the total
# passes a limit, up past `MAX_I64` or down past `MIN_I64`: the true sum is
# the total plus that count of 2 to the 64, so it fits only where the count
# comes back to zero.
#
# - `xs`: the integers.
function sum_i64(xs: [i64]) -> i64?
    total: i64 @= 0
    laps: i64 @= 0

    for x in xs
        next = wrapping.add_wrapping(a: total, b: x)

        if x > 0 && next < total
            laps @ laps + 1
        else if x < 0 && next > total
            laps @ laps - 1
        total @ next

    if laps != 0
        return fail(code: limits.DOES_NOT_FIT, msg: f"the sum of {xs.len()} integers is outside i64")
    return ok(total)

# The product of `xs`. A zero answers 0; otherwise every factor is 1 or more
# in size, so the size of the running product never falls, and it is kept as
# a `u64` beside its sign: a size past `MAX_U64` is past every answer, and the
# one size above `MAX_I64` that fits is 2 to the 63 with a minus sign.
#
# - `xs`: the integers.
function product_i64(xs: [i64]) -> i64?
    for x in xs
        if x == 0
            return ok(0)

    size: u64 @= 1
    negative: bool @= false

    for x in xs
        match checked.mul_u64(a: size, b: checked.abs_diff(a: x, b: 0))
            .ok next => size @ next
            .err _ => return fail(code: limits.DOES_NOT_FIT, msg: f"the product of {xs.len()} integers is outside i64")

        negative @ negative != (x < 0)

    if negative && size == 9223372036854775808
        return ok(limits.MIN_I64)

    if size > 9223372036854775807
        return fail(code: limits.DOES_NOT_FIT, msg: f"the product of {xs.len()} integers is outside i64")
    magnitude = to_i64(size).must()

    if negative
        return ok(-magnitude)
    return ok(magnitude)

# The smallest of `xs`.
#
# - `xs`: the integers.
function min_of_i64(xs: [i64]) -> i64?
    if xs.len() == 0
        return fail(code: limits.NOT_FOUND, msg: "an empty list has no smallest integer")
    smallest: i64 @= xs[0]

    for x in xs
        smallest @ min_i64(a: smallest, b: x)

    return ok(smallest)

# The largest of `xs`.
#
# - `xs`: the integers.
function max_of_i64(xs: [i64]) -> i64?
    if xs.len() == 0
        return fail(code: limits.NOT_FOUND, msg: "an empty list has no largest integer")
    largest: i64 @= xs[0]

    for x in xs
        largest @ max_i64(a: largest, b: x)

    return ok(largest)

## Tests

# Python's `//` and `%` on integers, and Rust's `div_euclid` and `rem_euclid`,
# run on 2026-11-16. Rust's `rem_euclid` panics on `MIN_I64` by -1, whose
# remainder, 0, fits; Python answers 0, and so does this.
test "div_floor_i64 and rem_floor_i64: each pair of signs, exact, the smallest by 1 and by -1"
    assert div_floor_i64(x: -7, by: 2).must() == -4 && rem_floor_i64(x: -7, by: 2) == 1
    assert div_floor_i64(x: 7, by: -2).must() == -4 && rem_floor_i64(x: 7, by: -2) == -1
    assert div_floor_i64(x: 7, by: 2).must() == 3 && rem_floor_i64(x: 7, by: 2) == 1
    assert div_floor_i64(x: -6, by: 2).must() == -3 && rem_floor_i64(x: -6, by: 2) == 0
    assert div_floor_i64(x: limits.MIN_I64, by: 1).must() == limits.MIN_I64
    assert div_floor_i64(x: limits.MIN_I64, by: -1).is_err()
    assert rem_floor_i64(x: limits.MIN_I64, by: -1) == 0
    assert div_floor_i64(x: 5, by: -1).must() == -5

test "div_euclid_i64 and rem_euclid_i64: each pair of signs, the smallest by -1 and by itself"
    assert div_euclid_i64(x: -7, by: 2).must() == -4 && rem_euclid_i64(x: -7, by: 3) == 2
    assert div_euclid_i64(x: 7, by: -2).must() == -3 && rem_euclid_i64(x: 7, by: -3) == 1
    assert rem_euclid_i64(x: -7, by: -2) == 1
    assert div_euclid_i64(x: limits.MIN_I64, by: -1).is_err()
    assert rem_euclid_i64(x: limits.MIN_I64, by: -1) == 0
    assert rem_euclid_i64(x: limits.MIN_I64, by: limits.MIN_I64) == 0
    assert rem_euclid_i64(x: limits.MIN_I64 + 1, by: limits.MIN_I64) == 1
    assert rem_euclid_i64(x: -1, by: limits.MIN_I64) == limits.MAX_I64

    match div_euclid_i64(x: limits.MIN_I64, by: -1)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

# Python's `-(-x // y)`, run on 2026-11-16.
test "div_ceil: each pair of signs, exact, the largest by 2, the smallest by -1"
    assert div_ceil(x: -7, by: 2).must() == -3
    assert div_ceil(x: 7, by: 2).must() == 4
    assert div_ceil(x: -7, by: -2).must() == 4
    assert div_ceil(x: 7, by: -2).must() == -3
    assert div_ceil(x: 6, by: 2).must() == 3
    assert div_ceil(x: limits.MAX_I64, by: 2).must() == 4611686018427387904
    assert div_ceil(x: limits.MIN_I64, by: -1).is_err()

test "min_i64, max_i64, clamp_i64 and sign_i64: the limits, equal values, inside and outside"
    assert min_i64(a: limits.MIN_I64, b: limits.MAX_I64) == limits.MIN_I64
    assert max_i64(a: limits.MIN_I64, b: limits.MAX_I64) == limits.MAX_I64
    assert min_i64(a: 3, b: 3) == 3
    assert clamp_i64(x: 10, low: -1, high: 1) == 1
    assert clamp_i64(x: limits.MIN_I64, low: -1, high: 1) == -1
    assert clamp_i64(x: 0, low: -1, high: 1) == 0
    assert clamp_i64(x: 5, low: 2, high: 2) == 2
    assert sign_i64(limits.MIN_I64) == -1 && sign_i64(0) == 0 && sign_i64(limits.MAX_I64) == 1

# Rust's `midpoint` on `i64`, run on 2026-11-16.
test "midpoint_i64: both odd, one odd, both negative, the limits, opposite signs"
    assert midpoint_i64(a: 3, b: 5) == 4
    assert midpoint_i64(a: 3, b: 4) == 3
    assert midpoint_i64(a: -3, b: -5) == -4
    assert midpoint_i64(a: -3, b: -4) == -3
    assert midpoint_i64(a: limits.MAX_I64, b: limits.MAX_I64) == limits.MAX_I64
    assert midpoint_i64(a: limits.MIN_I64, b: limits.MIN_I64) == limits.MIN_I64
    assert midpoint_i64(a: limits.MIN_I64, b: limits.MAX_I64) == 0
    assert midpoint_i64(a: limits.MIN_I64, b: -1) == -4611686018427387904
    assert midpoint_i64(a: -1, b: 2) == 0
    assert midpoint_i64(a: -3, b: 0) == -1

# Python's `sum` and `math.prod` on integers, run on 2026-11-16.
test "sum_i64: empty, past a limit and back, the largest twice, the smallest less one plus one"
    nothing: [i64] = []
    assert sum_i64(nothing).must() == 0
    assert sum_i64([limits.MAX_I64, 1, -2]).must() == 9223372036854775806
    assert sum_i64([limits.MIN_I64, -1, 1]).must() == limits.MIN_I64
    assert sum_i64([limits.MAX_I64, limits.MAX_I64]).is_err()
    assert sum_i64([limits.MIN_I64, -1]).is_err()

test "product_i64: empty, a zero beside overflowing factors, the smallest reached past the largest, past the limit"
    nothing: [i64] = []
    assert product_i64(nothing).must() == 1
    assert product_i64([3, 0, limits.MAX_I64, limits.MAX_I64]).must() == 0
    assert product_i64([4611686018427387904, 2, -1]).must() == limits.MIN_I64
    assert product_i64([limits.MIN_I64, -1]).is_err()
    assert product_i64([limits.MIN_I64, -1, -1]).must() == limits.MIN_I64
    assert product_i64([-2, -3, 7]).must() == 42
    assert product_i64([4294967296, 4294967296]).is_err()

test "min_of_i64 and max_of_i64: empty, one, the limits"
    nothing: [i64] = []

    match min_of_i64(nothing)
        .ok _  => assert false
        .err e => assert e.code == "not_found"

    assert max_of_i64(nothing).is_err()
    assert min_of_i64([3, -2, 7]).must() == -2
    assert max_of_i64([3, -2, 7]).must() == 7
    assert min_of_i64([limits.MAX_I64]).must() == limits.MAX_I64
    assert max_of_i64([limits.MIN_I64, limits.MIN_I64]).must() == limits.MIN_I64
