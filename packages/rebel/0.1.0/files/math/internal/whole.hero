# Whole numbers: divisors, whole roots and logarithms, the counts of choices,
# multiples and powers of two; powers modulo a number are `modular`'s.
#
# Each answers only where the answer itself fits in an `i64`: a step that
# would overflow on the way to an answer that fits is written another way.

use math/internal/bits
use math/internal/checked
use math/internal/integers
use math/internal/limits
use math/libm

# The largest whole number whose square fits in an `i64`.
constant ROOT_OF_MAX: i64
    3037000499

# The greatest common divisor of `a` and `b`, by Euclid's remainders on their
# sizes as `u64`, where the size of `MIN_I64` fits.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function gcd(a: i64, b: i64) -> i64?
    divisor = gcd_u64(a: checked.abs_diff(a: a, b: 0), b: checked.abs_diff(a: b, b: 0))

    if divisor > 9223372036854775807
        return fail(
            code: limits.DOES_NOT_FIT,
            msg: f"the greatest common divisor of {a} and {b} is 2 to the 63, outside i64"
        )
    return ok(to_i64(divisor).must())

# The greatest common divisor of two sizes.
#
# - `a`: any `u64`.
# - `b`: any `u64`.
function gcd_u64(a: u64, b: u64) -> u64
    high: u64 @= a
    low: u64 @= b

    while low != 0
        next = high % low
        high @ low
        low @ next

    return high

# The least common multiple of `a` and `b`: one size divided by the divisor,
# times the other, the product checked.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function lcm(a: i64, b: i64) -> i64?
    if a == 0 || b == 0
        return ok(0)
    a_size = checked.abs_diff(a: a, b: 0)
    b_size = checked.abs_diff(a: b, b: 0)
    multiple = checked.mul_u64(a: a_size / gcd_u64(a: a_size, b: b_size), b: b_size)

    match multiple
        .ok m =>
            if m <= 9223372036854775807
                return ok(to_i64(m).must())
        .err _ => _ = 0

    return fail(code: limits.DOES_NOT_FIT, msg: f"the least common multiple of {a} and {b} is above the largest i64")

# The whole square root of `x`: C's float root of `x` as a first guess, which
# rounding leaves within one of the answer, then corrected by comparing
# squares that fit.
#
# - `x`: 0 or more.
function isqrt(x: i64) -> i64?
    if x < 0
        return fail(code: limits.INVALID, msg: f"{x} is negative and has no whole square root")
    root: i64 @= integers.min_i64(a: to_i64(libm.c_sqrt(to_f64(x))).must(), b: ROOT_OF_MAX)

    while root * root > x
        root @ root - 1

    while root < ROOT_OF_MAX && (root + 1) * (root + 1) <= x
        root @ root + 1

    return ok(root)

# The whole logarithm of `x` in base 2: its highest one bit's place.
#
# - `x`: 1 or more.
function log2_i64(x: i64) -> i64?
    if x < 1
        return fail(code: limits.INVALID, msg: f"{x} has no logarithm: it is not positive")
    return ok(63 - bits.leading_zeros(x))

# The whole logarithm of `x` in base 10.
#
# - `x`: 1 or more.
function log10_i64(x: i64) -> i64?
    return log_i64(x: x, base: 10)

# The whole logarithm of `x` in base `base`: the powers of the base counted
# while they are at most `x`, stopping before one that would not fit.
#
# - `x`: 1 or more.
# - `base`: 2 or more.
function log_i64(x: i64, base: i64) -> i64?
    if x < 1
        return fail(code: limits.INVALID, msg: f"{x} has no logarithm: it is not positive")

    if base < 2
        return fail(code: limits.INVALID, msg: f"{base} is no base of a logarithm: a base is 2 or more")
    exponent: i64 @= 0
    power: i64 @= base

    while power <= x
        exponent @ exponent + 1

        if power > limits.MAX_I64 / base
            break
        power @ power * base

    return ok(exponent)

# The factorial of `n`.
#
# - `n`: from 0 to 20.
function factorial(n: i64) -> i64?
    if n < 0
        return fail(code: limits.INVALID, msg: f"{n} is negative and has no factorial")

    if n > 20
        return fail(code: limits.DOES_NOT_FIT, msg: f"the factorial of {n} is above the largest i64")
    product: i64 @= 1

    for k in range(from: 2, to: n + 1)
        product @ product * k

    return ok(product)

# The count of ways to choose `k` of `n`. It walks to the smaller of `k` and
# `n - k`, where each step's count is no larger than the answer; each step
# multiplies by `n - i` and divides by `i + 1`, the divisor shared first with
# the count so the product stays the answer's size.
#
# - `n`: how many there are.
# - `k`: how many are chosen.
function comb(n: i64, k: i64) -> i64?
    if n < 0 || k < 0
        return fail(code: limits.INVALID, msg: f"no count of choices of {k} from {n}: both are 0 or more")

    if k > n
        return ok(0)
    steps = integers.min_i64(a: k, b: n - k)
    count: i64 @= 1

    for i in range(from: 0, to: steps)
        shared = gcd(a: count, b: i + 1).must()

        match checked.mul(a: count / shared, b: (n - i) / ((i + 1) / shared))
            .ok next => count @ next
            .err _ => return fail(
                code: limits.DOES_NOT_FIT,
                msg: f"the count of choices of {k} from {n} is above the largest i64"
            )

    return ok(count)

# The count of ways to arrange `k` of `n`: the product of the `k` whole
# numbers down from `n`, each step no larger than the answer.
#
# - `n`: how many there are.
# - `k`: how many are arranged.
function perm(n: i64, k: i64) -> i64?
    if n < 0 || k < 0
        return fail(code: limits.INVALID, msg: f"no count of arrangements of {k} from {n}: both are 0 or more")

    if k > n
        return ok(0)
    count: i64 @= 1

    for i in range(from: 0, to: k)
        match checked.mul(a: count, b: n - i)
            .ok next => count @ next
            .err _ => return fail(
                code: limits.DOES_NOT_FIT,
                msg: f"the count of arrangements of {k} from {n} is above the largest i64"
            )

    return ok(count)

# The multiple of `of` nearest `x` in the direction of the sign of `of`.
#
# - `x`: any `i64`.
# - `of`: the step, not zero.
function next_multiple(x: i64, of: i64) -> i64?
    remainder = integers.rem_floor_i64(x: x, by: of)

    if remainder == 0
        return ok(x)

    match checked.add(a: x, b: of - remainder)
        .ok m  => return ok(m)
        .err _ => return fail(code: limits.DOES_NOT_FIT, msg: f"the next multiple of {of} from {x} is outside i64")

# Whether `x` is a power of two.
#
# - `x`: any `i64`.
function is_power_of_two(x: i64) -> bool
    return x > 0 && x & x - 1 == 0

# The smallest power of two at or above `x`.
#
# - `x`: any `i64`.
function next_power_of_two(x: i64) -> i64?
    if x > 4611686018427387904
        return fail(code: limits.DOES_NOT_FIT, msg: f"the next power of two from {x} is 2 to the 63, outside i64")
    power: i64 @= 1

    while power < x
        power @ power * 2

    return ok(power)

## Tests

# Python's `math.gcd` and `math.lcm`, run on 2026-11-16.
test "gcd: two zeros, mixed signs, the smallest with zero, with itself and with 6, the two limits"
    assert gcd(a: 0, b: 0).must() == 0
    assert gcd(a: -12, b: 18).must() == 6
    assert gcd(a: 0, b: -5).must() == 5
    assert gcd(a: limits.MIN_I64, b: 0).is_err()
    assert gcd(a: limits.MIN_I64, b: limits.MIN_I64).is_err()
    assert gcd(a: limits.MIN_I64, b: 6).must() == 2
    assert gcd(a: limits.MAX_I64, b: limits.MIN_I64).must() == 1

    match gcd(a: limits.MIN_I64, b: 0)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

test "lcm: a zero, mixed signs, the smallest with one, two neighbours past the limit, two coprime halves"
    assert lcm(a: 0, b: 5).must() == 0
    assert lcm(a: -4, b: 6).must() == 12
    assert lcm(a: limits.MIN_I64, b: 1).is_err()
    assert lcm(a: limits.MAX_I64, b: limits.MAX_I64 - 1).is_err()
    assert lcm(a: 2147483648, b: 2147483649).must() == 4611686020574871552

# Python's `math.isqrt` and Rust's `isqrt`, run on 2026-11-16.
test "isqrt: zero, one below a square, a square, the largest, the largest square that fits, a hair below it, negative"
    assert isqrt(0).must() == 0
    assert isqrt(15).must() == 3
    assert isqrt(16).must() == 4
    assert isqrt(limits.MAX_I64).must() == 3037000499
    assert isqrt(9223372030926249001).must() == 3037000499
    assert isqrt(9223372030926249000).must() == 3037000498

    match isqrt(-1)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

# Rust's `ilog2`, `ilog10` and `checked_ilog`, run on 2026-11-16.
test "log2_i64, log10_i64 and log_i64: one, the largest, a power and one below it, zero, a base below 2"
    assert log2_i64(1).must() == 0
    assert log2_i64(limits.MAX_I64).must() == 62
    assert log10_i64(limits.MAX_I64).must() == 18
    assert log10_i64(999).must() == 2 && log10_i64(1000).must() == 3
    assert log_i64(x: 80, base: 3).must() == 3
    assert log_i64(x: 81, base: 3).must() == 4
    assert log_i64(x: limits.MAX_I64, base: limits.MAX_I64).must() == 1
    assert log2_i64(0).is_err() && log10_i64(-5).is_err()
    assert log_i64(x: 10, base: 1).is_err()

test "factorial: zero, twenty, twenty-one, negative"
    assert factorial(0).must() == 1
    assert factorial(1).must() == 1
    assert factorial(20).must() == 2432902008176640000
    assert factorial(21).is_err()

    match factorial(-1)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

# Python's `math.comb` and `math.perm`, run on 2026-11-16.
test "comb: none of none, more than there are, the largest middle that fits and one past it, one and two of the largest"
    assert comb(n: 0, k: 0).must() == 1
    assert comb(n: 5, k: 7).must() == 0
    assert comb(n: 66, k: 33).must() == 7219428434016265740
    assert comb(n: 67, k: 33).is_err()
    assert comb(n: 62, k: 31).must() == 465428353255261088
    assert comb(n: limits.MAX_I64, k: 1).must() == limits.MAX_I64
    assert comb(n: limits.MAX_I64, k: limits.MAX_I64 - 1).must() == limits.MAX_I64
    assert comb(n: limits.MAX_I64, k: 2).is_err()
    assert comb(n: 1000, k: 3).must() == 166167000
    assert comb(n: -1, k: 0).is_err()

test "perm: two of five, none, more than there are, all of twenty, one past it, one of the largest"
    assert perm(n: 5, k: 2).must() == 20
    assert perm(n: 5, k: 0).must() == 1
    assert perm(n: 3, k: 5).must() == 0
    assert perm(n: 20, k: 20).must() == 2432902008176640000
    assert perm(n: 21, k: 20).is_err()
    assert perm(n: limits.MAX_I64, k: 1).must() == limits.MAX_I64
    assert perm(n: 5, k: -1).is_err()

# Rust's `next_multiple_of` on `i64`, run on 2026-11-16 (unstable there).
test "next_multiple: each pair of signs, a multiple already, past the largest"
    assert next_multiple(x: 7, of: 3).must() == 9
    assert next_multiple(x: 7, of: -3).must() == 6
    assert next_multiple(x: -7, of: 3).must() == -6
    assert next_multiple(x: -7, of: -3).must() == -9
    assert next_multiple(x: 9, of: 3).must() == 9
    assert next_multiple(x: limits.MAX_I64, of: 2).is_err()
    assert next_multiple(x: limits.MIN_I64, of: -2).must() == limits.MIN_I64

# Rust's `is_power_of_two` and `next_power_of_two` on `u64`, run on 2026-11-16.
test "is_power_of_two and next_power_of_two: zero, one, a negative number, the largest power that fits and one past it"
    assert !is_power_of_two(0) && is_power_of_two(1) && !is_power_of_two(-8)
    assert is_power_of_two(4611686018427387904) && !is_power_of_two(limits.MAX_I64)
    assert next_power_of_two(0).must() == 1 && next_power_of_two(-5).must() == 1
    assert next_power_of_two(5).must() == 8 && next_power_of_two(8).must() == 8
    assert next_power_of_two(4611686018427387904).must() == 4611686018427387904
    assert next_power_of_two(4611686018427387905).is_err()
