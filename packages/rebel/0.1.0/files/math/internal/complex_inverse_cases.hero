        [-inf, nan, nan, inf]
        [-1.5, -inf, 1.5707963267948966, inf]
        [-1.5, -1.5, 2.3011975447481223, 1.44973434958536]
        [-1.5, -0.0, 3.141592653589793, 0.9624236501192069]
        [-1.5, 0.0, 3.141592653589793, -0.9624236501192069]
        [-1.5, 1.5, 2.3011975447481223, -1.44973434958536]
        [-1.5, inf, 1.5707963267948966, -inf]
        [-1.5, nan, nan, nan]
        [-0.0, -inf, 1.5707963267948966, inf]
        [-0.0, -1.5, 1.5707963267948966, 1.1947632172871094]
        [-0.0, -0.0, 1.5707963267948966, 0.0]
        [-0.0, 0.0, 1.5707963267948966, -0.0]
        [-0.0, 1.5, 1.5707963267948966, -1.1947632172871094]
        [-0.0, inf, 1.5707963267948966, -inf]
        [-0.0, nan, 1.5707963267948966, nan]
        [0.0, -inf, 1.5707963267948966, inf]
        [0.0, -1.5, 1.5707963267948966, 1.1947632172871094]
        [0.0, -0.0, 1.5707963267948966, 0.0]
        [0.0, 0.0, 1.5707963267948966, -0.0]
        [0.0, 1.5, 1.5707963267948966, -1.1947632172871094]
        [0.0, inf, 1.5707963267948966, -inf]
        [0.0, nan, 1.5707963267948966, nan]
        [1.5, -inf, 1.5707963267948966, inf]
