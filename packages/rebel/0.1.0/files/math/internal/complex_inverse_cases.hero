        [inf, -inf, 0.7853981633974483, inf]
        [inf, -1.5, 0.0, inf]
        [inf, -0.0, 0.0, inf]
        [inf, 0.0, 0.0, -inf]
        [inf, 1.5, 0.0, -inf]
        [inf, inf, 0.7853981633974483, -inf]
        [inf, nan, nan, inf]
        [nan, -inf, nan, inf]
        [nan, -1.5, nan, nan]
        [nan, -0.0, nan, nan]
        [nan, 0.0, nan, nan]
        [nan, 1.5, nan, nan]
        [nan, inf, nan, -inf]
        [nan, nan, nan, nan]
    ]
    assert complex_arithmetic.misses(f: complex_inverse.acos, cases: cases, ulps: 4.0) == []

