        [-0.1313739300457438, -4.753631083952321, -0.005416601398022986, -0.1312622181930464]
        [-63.141988669716774, 0.6348045650166187, -50.84114686777933, -37.444472467048236]
        [0.13391559258089875, 0.4180876305163685, 0.12238104872334962, 0.05437154448483496]
        [-4.45014270707699, -0.43532535537681255, -4.035090740624941, 1.8766493621008136]
