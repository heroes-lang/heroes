    failed: [i64] @= []
    at @= 0

    for c in cases
        if !complex_arithmetic.agrees(got: complex_arithmetic.from_polar(modulus: c[0], phase: c[1]), want_re: c[2], want_im: c[3], ulps: 4.0)
            failed @ failed.push(at)
        at @ at + 1

    assert failed == []
