        [76.44748834828835, 3.4578833241646576, -72.65536543200311, -23.778484995974196]
        [-0.12423510281967437, -0.17302232012743068, -0.12238014143056461, 0.02138835561818781]
        [-3.7717424760211653, -2.006298090064445, 1.591167581872543, 3.419682299837246]
