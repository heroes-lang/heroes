# Python 3.15.2's `cmath.sinh` on this machine, 2026-11-17, at the 49 pairings of seven parts; where Python raises, this machine's C `<complex.h>` as C11's Annex G reads it.
test "sinh (generated): every pairing of minus the infinity, -1.5, the two zeros, 1.5, the infinity and a nan"
    inf = limits.INF
    nan = limits.NAN
    cases: [[f64]] = [
        [-inf, -inf, -inf, nan]
        [-inf, -1.5, -inf, -inf]
        [-inf, -0.0, -inf, -0.0]
        [-inf, 0.0, -inf, 0.0]
        [-inf, 1.5, -inf, inf]
