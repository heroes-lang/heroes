# The platform's C library of mathematics, `math.h`, bound thin: one Heroes
# function per C function, each answering what C answers. The floor of `math`
# (`examples-rebel/README.md` § A2): the face turns these into its functions
# and says what each answers for a nan and an infinity; a program calls the
# face.
#
# A binding takes C's own name, so each function here is named for its C
# function with `c_` before it. Every one is C11's, in the header every
# platform has; `link "m"` is the word the programs of `examples/` that bind
# `math.h` write (`nbody`, `spectral`, the gallery's `08-ffi`). An `int` of C
# is an `i32` here (spec § 13), and a C out-parameter an `@` parameter.
#
# `lgamma` writes C's global `signgam` beside its answer; nothing here reads
# it.

extern "math.h" link "m"
    function sqrt(x: f64) -> f64
    function cbrt(x: f64) -> f64
    function hypot(x: f64, y: f64) -> f64
    function pow(x: f64, y: f64) -> f64
    function exp(x: f64) -> f64
    function exp2(x: f64) -> f64
    function expm1(x: f64) -> f64
    function log(x: f64) -> f64
    function log2(x: f64) -> f64
    function log10(x: f64) -> f64
    function log1p(x: f64) -> f64
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
    function tan(x: f64) -> f64
    function asin(x: f64) -> f64
    function acos(x: f64) -> f64
    function atan(x: f64) -> f64
    function atan2(y: f64, x: f64) -> f64
    function sinh(x: f64) -> f64
    function cosh(x: f64) -> f64
    function tanh(x: f64) -> f64
    function asinh(x: f64) -> f64
    function acosh(x: f64) -> f64
    function atanh(x: f64) -> f64
    function erf(x: f64) -> f64
    function erfc(x: f64) -> f64
    function tgamma(x: f64) -> f64
    function lgamma(x: f64) -> f64
    function floor(x: f64) -> f64
    function ceil(x: f64) -> f64
    function trunc(x: f64) -> f64
    function round(x: f64) -> f64
    function remainder(x: f64, y: f64) -> f64
    function copysign(x: f64, y: f64) -> f64
    function fabs(x: f64) -> f64
    function fma(x: f64, y: f64, z: f64) -> f64
    function frexp(x: f64, @power: i32) -> f64
    function ldexp(x: f64, power: i32) -> f64
    function modf(x: f64, @iptr: f64) -> f64
    function nextafter(x: f64, y: f64) -> f64
    function nextafterf(x: f32, y: f32) -> f32

# C's `sqrt`: the square root of `x`.
#
# - `x`: any float.
function c_sqrt(x: f64) -> f64
    return sqrt(x)

# C's `cbrt`: the cube root of `x`.
#
# - `x`: any float.
function c_cbrt(x: f64) -> f64
    return cbrt(x)

# C's `hypot`: the square root of `x` squared plus `y` squared.
#
# - `x`: any float.
# - `y`: any float.
function c_hypot(x: f64, y: f64) -> f64
    return hypot(x: x, y: y)

# C's `pow`: `x` raised to the power `y`.
#
# - `x`: the base.
# - `y`: the exponent.
function c_pow(x: f64, y: f64) -> f64
    return pow(x: x, y: y)

# C's `exp`: e raised to `x`.
#
# - `x`: any float.
function c_exp(x: f64) -> f64
    return exp(x)

# C's `exp2`: 2 raised to `x`.
#
# - `x`: any float.
function c_exp2(x: f64) -> f64
    return exp2(x)

# C's `expm1`: e raised to `x`, less one.
#
# - `x`: any float.
function c_expm1(x: f64) -> f64
    return expm1(x)

# C's `log`: the natural logarithm of `x`.
#
# - `x`: any float.
function c_log(x: f64) -> f64
    return log(x)

# C's `log2`: the logarithm of `x` in base 2.
#
# - `x`: any float.
function c_log2(x: f64) -> f64
    return log2(x)

# C's `log10`: the logarithm of `x` in base 10.
#
# - `x`: any float.
function c_log10(x: f64) -> f64
    return log10(x)

# C's `log1p`: the natural logarithm of one plus `x`.
#
# - `x`: any float.
function c_log1p(x: f64) -> f64
    return log1p(x)

# C's `sin`: the sine of `x`.
#
# - `x`: an angle in radians.
function c_sin(x: f64) -> f64
    return sin(x)

# C's `cos`: the cosine of `x`.
#
# - `x`: an angle in radians.
function c_cos(x: f64) -> f64
    return cos(x)

# C's `tan`: the tangent of `x`.
#
# - `x`: an angle in radians.
function c_tan(x: f64) -> f64
    return tan(x)

# C's `asin`: the angle whose sine is `x`.
#
# - `x`: any float.
function c_asin(x: f64) -> f64
    return asin(x)

# C's `acos`: the angle whose cosine is `x`.
#
# - `x`: any float.
function c_acos(x: f64) -> f64
    return acos(x)

# C's `atan`: the angle whose tangent is `x`.
#
# - `x`: any float.
function c_atan(x: f64) -> f64
    return atan(x)

# C's `atan2`: the angle of the point (`x`, `y`).
#
# - `y`: the point's height.
# - `x`: the point's distance along the axis.
function c_atan2(y: f64, x: f64) -> f64
    return atan2(y: y, x: x)

# C's `sinh`: the hyperbolic sine of `x`.
#
# - `x`: any float.
function c_sinh(x: f64) -> f64
    return sinh(x)

# C's `cosh`: the hyperbolic cosine of `x`.
#
# - `x`: any float.
function c_cosh(x: f64) -> f64
    return cosh(x)

# C's `tanh`: the hyperbolic tangent of `x`.
#
# - `x`: any float.
function c_tanh(x: f64) -> f64
    return tanh(x)

# C's `asinh`: the inverse hyperbolic sine of `x`.
#
# - `x`: any float.
function c_asinh(x: f64) -> f64
    return asinh(x)

# C's `acosh`: the inverse hyperbolic cosine of `x`.
#
# - `x`: any float.
function c_acosh(x: f64) -> f64
    return acosh(x)

# C's `atanh`: the inverse hyperbolic tangent of `x`.
#
# - `x`: any float.
function c_atanh(x: f64) -> f64
    return atanh(x)

# C's `erf`: the error function of `x`.
#
# - `x`: any float.
function c_erf(x: f64) -> f64
    return erf(x)

# C's `erfc`: the complementary error function of `x`.
#
# - `x`: any float.
function c_erfc(x: f64) -> f64
    return erfc(x)

# C's `tgamma`: the gamma function of `x`.
#
# - `x`: any float.
function c_tgamma(x: f64) -> f64
    return tgamma(x)

# C's `lgamma`: the natural logarithm of the size of the gamma function of `x`.
#
# - `x`: any float.
function c_lgamma(x: f64) -> f64
    return lgamma(x)

# C's `floor`: the largest whole number at or below `x`.
#
# - `x`: any float.
function c_floor(x: f64) -> f64
    return floor(x)

# C's `ceil`: the smallest whole number at or above `x`.
#
# - `x`: any float.
function c_ceil(x: f64) -> f64
    return ceil(x)

# C's `trunc`: `x` rounded toward zero.
#
# - `x`: any float.
function c_trunc(x: f64) -> f64
    return trunc(x)

# C's `round`: the whole number nearest to `x`, a half away from zero.
#
# - `x`: any float.
function c_round(x: f64) -> f64
    return round(x)

# C's `remainder`: `x` less `y` times the whole number nearest to `x / y`.
#
# - `x`: the dividend.
# - `y`: the divisor.
function c_remainder(x: f64, y: f64) -> f64
    return remainder(x: x, y: y)

# C's `copysign`: the size of `x` with the sign of `y`.
#
# - `x`: any float.
# - `y`: any float.
function c_copysign(x: f64, y: f64) -> f64
    return copysign(x: x, y: y)

# C's `fabs`: `x` without its sign.
#
# - `x`: any float.
function c_fabs(x: f64) -> f64
    return fabs(x)

# C's `fma`: `x` times `y` plus `z`, rounded once.
#
# - `x`: one factor.
# - `y`: the other factor.
# - `z`: what is added.
function c_fma(x: f64, y: f64, z: f64) -> f64
    return fma(x: x, y: y, z: z)

# C's `frexp`: the fraction of `x`, its power of two written into `power`.
#
# - `x`: any float.
# - `power`: where C writes the power of two.
function c_frexp(x: f64, @power: i32) -> f64
    return frexp(x, @power)

# C's `ldexp`: `x` times 2 raised to `power`.
#
# - `x`: any float.
# - `power`: the power of two.
function c_ldexp(x: f64, power: i32) -> f64
    return ldexp(x, power)

# C's `modf`: the fraction of `x`, its whole part written into `iptr`.
#
# - `x`: any float.
# - `iptr`: where C writes the whole part.
function c_modf(x: f64, @iptr: f64) -> f64
    return modf(x: x, iptr: @iptr)

# C's `nextafter`: the float next to `x` toward `y`.
#
# - `x`: any float.
# - `y`: the direction.
function c_nextafter(x: f64, y: f64) -> f64
    return nextafter(x: x, y: y)

# C's `nextafterf`: the `f32` next to `x` toward `y`.
#
# - `x`: any `f32`.
# - `y`: the direction.
function c_nextafterf(x: f32, y: f32) -> f32
    return nextafterf(x: x, y: y)
