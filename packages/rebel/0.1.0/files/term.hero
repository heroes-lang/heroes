# The terminal: colours and styles that fall back to plain text, the cursor
# and the screen, one key read as it is pressed, a secret read with nothing
# echoed, a line read with editing and a history, a progress bar and a
# spinner drawn on a stream, and tables and columns of text aligned by the
# cells their characters take.
#
# What it does NOT do: read or write a stream (`io`); tell the terminal's size
# (`os.terminal_size`); tell whether a stream is a terminal (`io.is_terminal`);
# answer how many cells a text takes, which `unicode/segment.width_of` does and
# by which the line editor, the menus and the tables here measure; draw
# windows, a screen of the program's own, or read the mouse, a paste and a
# resize as events (`tui`, over this package).
#
# **Prompts, menus, links and the clipboard**: a question answered yes or
# no, a menu of one choice or of several, filtered as the person types, and a
# password typed twice are asked at the program's terminal and fail
# `unsupported` where it has none; a link (OSC 8) is written to a terminal
# and its target said after its text elsewhere; a text is put on the
# clipboard (OSC 52) only through a terminal.
#
# **Colour falls back to plain text**: `write_styled` writes the colour only to
# a terminal that takes it, where `NO_COLOR` is unset or empty and `TERM` is
# not `dumb`, and the text alone everywhere else, so the same program writes
# colour to a person and clean text to a file or a pipe. The control
# sequences of the cursor and the screen are written by `write_control`,
# only to a terminal.
#
# **Keys and the terminal put back**: a key or a secret is read from the
# program's terminal even where its input is a pipe, as a reader of
# passwords does, in a mode where each key comes as it is pressed and nothing
# is echoed. The terminal is put back as it was when the read ends, and, where
# `enter_raw` left the mode standing, at `leave_raw`, when `main` returns, at
# `exit`, and on POSIX at SIGINT, SIGTERM, SIGHUP and SIGQUIT. What no library
# can undo: a panic, a memory fault, or SIGKILL end the program with the mode
# standing, and `stty sane` puts a POSIX terminal back by hand.
#
# It fails with `invalid`, `unsupported`, `timeout`, `closed`, `stopped`,
# `not_text` and `failed` (README § A4).

use io
use os
use term/hero_term
use term/internal/acts
use term/internal/completing
use term/internal/cursor as moves
use term/internal/draw
use term/internal/editing
use term/internal/failure
use term/internal/keycodes
use term/internal/menus
use term/internal/osc
use term/internal/reading
use term/internal/sgr
use term/internal/stream
use term/internal/tables
use term/internal/words

## Codes

# An argument out of its range: a count below zero, a row or a column below 1.
# The cursor's functions, `advance` and `progress` fail with it.
constant INVALID: str
    "invalid"

# The program has no terminal: no controlling one, and its input is none. The
# key and secret readers and `enter_raw` fail with it.
constant UNSUPPORTED: str
    "unsupported"

# No key came in the time allowed. `read_key_within` fails with it.
constant TIMEOUT: str
    "timeout"

# The terminal is gone, or Ctrl-D ended an empty secret. The key and secret
# readers fail with it.
constant CLOSED: str
    "closed"

# Ctrl-C was pressed while a secret was read. `read_secret` fails with it.
constant STOPPED: str
    "stopped"

# The system refused for a reason none of the above names; the message
# carries its number. Every function that reaches the terminal fails with it.
constant FAILED: str
    "failed"

# A line of the input is not UTF-8. `read_line` and `read_line_completing`
# fail with it.
constant NOT_TEXT: str
    "not_text"

## Colours and styles

# A colour of the terminal's text or of its background.
variant Color
    # The terminal's own colour, as it was before any style.
    default
    # Black, colour 0 of the eight every colour terminal has, as its
    # theme draws it.
    black
    # Red, colour 1 of the eight every colour terminal has, as its
    # theme draws it.
    red
    # Green, colour 2 of the eight every colour terminal has, as its
    # theme draws it.
    green
    # Yellow, colour 3 of the eight every colour terminal has, as its
    # theme draws it.
    yellow
    # Blue, colour 4 of the eight every colour terminal has, as its
    # theme draws it.
    blue
    # Magenta, colour 5 of the eight every colour terminal has, as its
    # theme draws it.
    magenta
    # Cyan, colour 6 of the eight every colour terminal has, as its
    # theme draws it.
    cyan
    # White, colour 7 of the eight every colour terminal has, as its
    # theme draws it.
    white
    # Bright black, colour 8, the bright form of `black`.
    bright_black
    # Bright red, colour 9, the bright form of `red`.
    bright_red
    # Bright green, colour 10, the bright form of `green`.
    bright_green
    # Bright yellow, colour 11, the bright form of `yellow`.
    bright_yellow
    # Bright blue, colour 12, the bright form of `blue`.
    bright_blue
    # Bright magenta, colour 13, the bright form of `magenta`.
    bright_magenta
    # Bright cyan, colour 14, the bright form of `cyan`.
    bright_cyan
    # Bright white, colour 15, the bright form of `white`.
    bright_white
    # One of the 256 colours of the terminal's palette: 0 to 15 the sixteen
    # above, 16 to 231 a cube of 6 by 6 by 6, 232 to 255 greys.
    indexed
        # The colour's place in the palette.
        n: u8
    # A colour of 24 bits, which a terminal that has fewer shows as its
    # nearest.
    rgb
        # Red, 0 to 255.
        red: u8
        # Green, 0 to 255.
        green: u8
        # Blue, 0 to 255.
        blue: u8

# A way text is drawn besides its colours.
variant Attribute
    # Heavier, or brighter on some terminals.
    bold
    # Fainter.
    dim
    # Slanted, where the terminal has such a font.
    italic
    # A line under the text.
    underline
    # Blinking, where the terminal allows it.
    blink
    # The text's colour and its background's swapped.
    reverse
    # Not drawn, the cells kept.
    hidden
    # A line through the text.
    strike

# How text is drawn: its colour, its background, and its attributes. Made by
# `plain` and changed by `with_foreground`, `with_background` and
# `with_attribute`, or built directly.
record Style
    # The text's colour.
    foreground: Color
    # The background's colour.
    background: Color
    # The attributes, each once, in the order they were added.
    attributes: [Attribute]

# The style that changes nothing: the terminal's own colours and no attribute.
#
# See also `with_foreground`, `styled`.
function plain() -> Style
    return Style(foreground: .default, background: .default, attributes: [])

# A copy of `style` drawing text in `color`.
#
# - `style`: the style to copy.
# - `color`: the text's colour; `.default` the terminal's own.
#
# See also `with_background`, `with_attribute`.
function with_foreground(style: Style, color: Color) -> Style
    return Style(foreground: color, background: style.background, attributes: style.attributes)

# A copy of `style` drawing text on `color`.
#
# - `style`: the style to copy.
# - `color`: the background's colour; `.default` the terminal's own.
#
# See also `with_foreground`.
function with_background(style: Style, color: Color) -> Style
    return Style(foreground: style.foreground, background: color, attributes: style.attributes)

# A copy of `style` with the attribute `a`, added once: a style that has it
# already is answered as it is.
#
# - `style`: the style to copy.
# - `a`: the attribute to add.
#
# See also `with_foreground`.
function with_attribute(style: Style, a: Attribute) -> Style
    for had in style.attributes
        if had == a
            return style

    added: [Attribute] @= style.attributes
    added @ added.push(a)
    return Style(foreground: style.foreground, background: style.background, attributes: added)

# `text` with the sequences that draw it in `style` before it and the one
# that puts the terminal's own rendition back after it, whatever the stream it
# goes to: `write_styled` is what decides.
#
# - `text`: the text to draw; the empty text is wrapped too.
# - `style`: how to draw it; `plain()` answers `text` as it is.
#
# See also `write_styled`.
function styled(text: str, style: Style) -> str
    codes: [str] @= []

    for a in style.attributes
        code = match a
            .bold      => "1"
            .dim       => "2"
            .italic    => "3"
            .underline => "4"
            .blink     => "5"
            .reverse   => "7"
            .hidden    => "8"
            .strike    => "9"

        codes @ codes.push(code)

    for side in [false, true]
        color = if side
            style.background
        else
            style.foreground

        code = match color
            .default        => ""
            .black          => sgr.basic(0, background: side)
            .red            => sgr.basic(1, background: side)
            .green          => sgr.basic(2, background: side)
            .yellow         => sgr.basic(3, background: side)
            .blue           => sgr.basic(4, background: side)
            .magenta        => sgr.basic(5, background: side)
            .cyan           => sgr.basic(6, background: side)
            .white          => sgr.basic(7, background: side)
            .bright_black   => sgr.basic(8, background: side)
            .bright_red     => sgr.basic(9, background: side)
            .bright_green   => sgr.basic(10, background: side)
            .bright_yellow  => sgr.basic(11, background: side)
            .bright_blue    => sgr.basic(12, background: side)
            .bright_magenta => sgr.basic(13, background: side)
            .bright_cyan    => sgr.basic(14, background: side)
            .bright_white   => sgr.basic(15, background: side)
            .indexed i      => sgr.indexed(i.n, background: side)
            .rgb c          => sgr.rgb(red: c.red, green: c.green, blue: c.blue, background: side)

        if code != ""
            codes @ codes.push(code)

    return sgr.wrap(text, codes: codes)

# Whether colour written to `s` would show: `s` is a terminal that takes the
# terminal's sequences, `NO_COLOR` is unset or empty, and `TERM` is not
# `dumb`. On Windows the console's processing of sequences is turned on, and
# put back when the program ends.
#
# - `s`: the stream colour would be written to.
#
# False for a closed stream, a file, a pipe and a connection. See also
# `write_styled`.
function has_colors(s: io.Stream) -> bool
    if os.env("NO_COLOR").default("") != ""
        return false
    return stream.controls_on(s)

# Writes `text` to `s` drawn in `style` where colour shows there
# (`has_colors`), and as plain text everywhere else.
#
# - `s`: the stream; it stays the caller's, who closes it.
# - `text`: the text.
# - `style`: how to draw it where colour shows.
#
# Fails as `io.write` fails. See also `styled`, `has_colors`.
function write_styled(s: io.Stream, text: str, style: Style) -> ()?
    if has_colors(s)
        return io.write_text(s, text: styled(text, style: style))
    return io.write_text(s, text: text)

## The cursor and the screen

# The sequence that puts the cursor at `row` and `column`, the first cell
# being row 1, column 1.
#
# - `row`: from 1, the top.
# - `column`: from 1, the left.
#
# Fails `invalid` where either is below 1. See also `write_control`.
function cursor_to(row: i64, column: i64) -> str?
    if row < 1 || column < 1
        return failure.of(
            code: INVALID,
            asked: f"moving the cursor to row {row}, column {column}",
            why: "rows and columns count from 1"
        )
    return ok(sgr.placed(row: row, column: column))

# The sequence that moves the cursor `n` rows up, stopping at the top.
#
# - `n`: rows; 0 is no text.
#
# Fails `invalid` where `n` is below 0. See also `cursor_down`.
function cursor_up(n: i64) -> str?
    return moves.moved(n, final: "A", way: "up")

# The sequence that moves the cursor `n` rows down, stopping at the bottom.
#
# - `n`: rows; 0 is no text.
#
# Fails `invalid` where `n` is below 0. See also `cursor_up`.
function cursor_down(n: i64) -> str?
    return moves.moved(n, final: "B", way: "down")

# The sequence that moves the cursor `n` columns right, stopping at the edge.
#
# - `n`: columns; 0 is no text.
#
# Fails `invalid` where `n` is below 0. See also `cursor_back`.
function cursor_forward(n: i64) -> str?
    return moves.moved(n, final: "C", way: "forward")

# The sequence that moves the cursor `n` columns left, stopping at the edge.
#
# - `n`: columns; 0 is no text.
#
# Fails `invalid` where `n` is below 0. See also `cursor_forward`.
function cursor_back(n: i64) -> str?
    return moves.moved(n, final: "D", way: "back")

# The sequence that hides the cursor.
#
# See also `cursor_show`.
function cursor_hide() -> str
    return sgr.CSI + "?25l"

# The sequence that shows the cursor again.
#
# See also `cursor_hide`.
function cursor_show() -> str
    return sgr.CSI + "?25h"

# The sequence that saves the cursor's place and rendition, which
# `cursor_restore` brings back.
#
# See also `cursor_restore`.
function cursor_save() -> str
    return "\u{1b}7"

# The sequence that brings back the place and rendition `cursor_save` saved.
#
# See also `cursor_save`.
function cursor_restore() -> str
    return "\u{1b}8"

# The sequence that rings the terminal's bell: a sound, or a flash where the
# terminal is set so.
#
# See also `write_control`.
function bell() -> str
    return "\u{7}"

# The sequence that clears the cursor's whole line, the cursor staying in its
# column.
#
# See also `clear_to_line_end`.
function clear_line() -> str
    return sgr.CSI + "2K"

# The sequence that clears the line from the cursor to its end.
#
# See also `clear_line`.
function clear_to_line_end() -> str
    return sgr.CSI + "K"

# The sequence that clears the whole screen and puts the cursor at row 1,
# column 1.
#
# See also `clear_line`.
function clear_screen() -> str
    return sgr.CSI + "2J" + sgr.CSI + "H"

# Writes the control sequence `sequence` to `s` where `s` is a terminal that
# takes it and `TERM` is not `dumb`, and nothing elsewhere, so a program that
# moves the cursor writes nothing stray into a file.
#
# - `s`: the stream; it stays the caller's.
# - `sequence`: what one of this package's cursor or screen functions
#   answered.
#
# Fails as `io.write` fails. See also `cursor_to`, `clear_screen`.
function write_control(s: io.Stream, sequence: str) -> ()?
    if stream.controls_on(s)
        return io.write_text(s, text: sequence)
    return ok()

## Keys and secrets

# A key as `read_key` reads it.
variant Key
    # A character typed: a letter, a digit, a space, a sign, any character of
    # any script.
    character
        # The character, one, as UTF-8.
        text: str
    # Enter.
    enter
    # Tab.
    tab
    # Backspace.
    backspace
    # Escape, alone.
    escape
    # The arrow up.
    up
    # The arrow down.
    down
    # The arrow left.
    left
    # The arrow right.
    right
    # Home.
    home
    # End.
    end
    # Page Up.
    page_up
    # Page Down.
    page_down
    # Insert.
    insert
    # Delete, the key that removes the character after the cursor.
    delete
    # A function key.
    function_key
        # Its number, 1 to 12.
        n: i64
    # Control held with a letter: Ctrl-C is `control` with "c". Ctrl-I, Ctrl-M
    # and Ctrl-H are `tab`, `enter` and `backspace`, as terminals send them.
    control
        # The letter, lower case, "a" to "z".
        letter: str
    # A key this package names nothing for (a key with a modifier, a sequence
    # of a terminal of its own), or bytes that are no UTF-8.
    other
        # The bytes, as the terminal sent them.
        bytes: [u8]

# Puts the program's terminal where each key comes as it is pressed, nothing
# is echoed and no key ends the program (Ctrl-C is a key), until `leave_raw`;
# a program that reads many keys enters once, so no key typed between two
# reads is echoed.
#
# Fails `unsupported` where the program has no terminal, `failed` where the
# system refuses. See also `leave_raw`, `read_key`.
function enter_raw() -> ()?
    if hero_term.enter_keys() < 0
        return failure.last(asked: "entering the raw mode")
    return ok()

# Puts the program's terminal back as it was before `enter_raw`; nothing where
# no mode stands.
#
# Fails `failed` where the system refuses. See also `enter_raw`.
function leave_raw() -> ()?
    if hero_term.leave() < 0
        return failure.last(asked: "leaving the raw mode")
    return ok()

# The next key pressed at the program's terminal, waiting as long as it takes;
# a key typed before the call is the one answered. Where `enter_raw` did not
# leave the raw mode standing, it is entered for this one key and left after.
#
# Fails `unsupported` where the program has no terminal, `closed` where the
# terminal is gone, `failed` where the system refuses. See also
# `read_key_within`.
function read_key() -> Key?
    # The largest limit, about 292 million years: as long as it takes.
    return read_key_within(9223372036854775807)

# The next key pressed at the program's terminal, waiting at most `limit_ms`
# milliseconds, as `read_key` reads one.
#
# - `limit_ms`: the longest to wait, in milliseconds; 0 answers a key
#   already pressed and waits not at all.
#
# Fails `timeout` where no key came in time, `invalid` where `limit_ms` is
# below 0, and as `read_key` does. See also `read_key`.
function read_key_within(limit_ms: i64) -> Key?
    if limit_ms < 0
        return failure.of(
            code: INVALID,
            asked: "reading a key",
            why: f"a time is 0 or more, and {limit_ms} ms was asked"
        )
    asked = "reading a key"
    stood = hero_term.enter_keys()

    if stood < 0
        return failure.last(asked: asked)
    buffer: [u8] @= stream.zeros(hero_term.HERO_TERM_KEY_MOST)
    n = hero_term.read_key(@buffer, n: to_u64(hero_term.HERO_TERM_KEY_MOST).must(), ms: limit_ms)

    # The failure is read before the mode is left, which names its own.
    read: [u8]? = if n < 0
        failure.last(asked: asked)
    else if n == 0
        failure.of(code: CLOSED, asked: asked, why: "the terminal is gone")
    else
        ok(buffer.slice(from: 0, to: n))

    if stood == 0
        _ = hero_term.leave()
    bytes = read?
    named = keycodes.name_of(bytes)

    return match named.name
        "character"    => ok(.character(text: named.text))
        "enter"        => ok(.enter)
        "tab"          => ok(.tab)
        "backspace"    => ok(.backspace)
        "escape"       => ok(.escape)
        "up"           => ok(.up)
        "down"         => ok(.down)
        "left"         => ok(.left)
        "right"        => ok(.right)
        "home"         => ok(.home)
        "end"          => ok(.end)
        "page_up"      => ok(.page_up)
        "page_down"    => ok(.page_down)
        "insert"       => ok(.insert)
        "delete"       => ok(.delete)
        "function_key" => ok(.function_key(n: named.n))
        "control"      => ok(.control(letter: named.text))
        _              => ok(.other(bytes: bytes))

# A line typed at the program's terminal with nothing echoed, as a password
# is read: `prompt` written to the terminal first, the line ended by Enter,
# Backspace taking back the last character, and a new line written after.
#
# - `prompt`: what the terminal shows first; "" for nothing.
#
# The line without its Enter; "" where Enter alone was pressed.
#
# Fails `stopped` where Ctrl-C was pressed, `closed` where Ctrl-D was pressed
# on an empty line or the terminal is gone, `unsupported` where the program
# has no terminal, `failed` where the system refuses. See also `read_key`.
function read_secret(prompt: str) -> str?
    asked = "reading a secret"

    if prompt != ""
        stream.to_terminal(text: prompt, asked: asked)?
    stood = hero_term.enter_keys()

    if stood < 0
        return failure.last(asked: asked)
    typed: [str] @= []
    ended: str @= ""

    while ended == ""
        match read_key()
            .err e =>
                ended @ e.code
            .ok key =>
                match key
                    .enter => ended @ "enter"
                    .backspace =>
                        if typed.len() > 0
                            typed @ typed.slice(from: 0, to: typed.len() - 1)
                    .character c => typed @ typed.push(c.text)
                    .control c =>
                        if c.letter == "c"
                            ended @ STOPPED
                        else if c.letter == "d" && typed.len() == 0
                            ended @ CLOSED
                    .tab | .escape | .up | .down | .left | .right | .home | .end | .page_up | .page_down | .insert | .delete => _ = 0
                    .function_key _ => _ = 0
                    .other _ => _ = 0

    if stood == 0
        _ = hero_term.leave()
    _ = stream.to_terminal(text: "\n", asked: asked).is_err()

    if ended == "enter"
        return ok(typed.join(""))

    if ended == STOPPED
        return failure.of(code: STOPPED, asked: asked, why: "Ctrl-C was pressed")

    if ended == CLOSED
        return failure.of(
            code: CLOSED,
            asked: asked,
            why: "Ctrl-D was pressed on an empty line, or the terminal is gone"
        )
    return failure.of(code: ended, asked: asked, why: "the terminal could not be read")

## Line editing

# A line being read with editing, and the lines entered before it: a
# program keeps one and reads every line through it, with `read_line`, or
# with `press` one key at a time. Made by `line_editor`; its `prompt`, `history`
# and `history_most` may be changed directly.
record Editor
    # What is drawn before the line; it may hold styles (`styled`), which
    # take no cell.
    prompt: str
    # The lines entered, the oldest first; Up shows the newest first. Each
    # line entered is added, but an empty one or one equal to the newest.
    history: [str]
    # How many lines `history` keeps at most, the oldest dropped past it; 0
    # keeps none.
    history_most: i64
    # The line being edited and what the keys keep between them: the
    # cursor, the line being typed while the history is shown, the text the
    # last kills took, the terminal's width in `edit.columns`. Only this
    # package reads it.
    edit: editing.Edit

# How a key left the line being edited.
variant Ending
    # The line goes on.
    editing
    # Enter was pressed: the line is done.
    entered
    # Ctrl-C was pressed: the line is given up.
    interrupted
    # Ctrl-D was pressed on an empty line: no more input.
    closed

# What one key did to a line being edited: the bytes that show it, and
# whether the line is done.
record Pressed
    # The bytes that show the change on the terminal, its control sequences
    # included, to be written to it as they are; "" where nothing changed.
    draw: str
    # Whether the line goes on, or how it ended.
    ending: Ending
    # The line entered, where `ending` is `.entered`; "" otherwise.
    line: str

# What a program's completion function answers for the line being edited:
# the text before the cursor it would replace, and what may replace it.
record Completions
    # Where the replaced text begins, a byte index from 0 to the cursor: the
    # text from it to the cursor is replaced. One outside that range, or
    # inside a character, completes nothing.
    from: i64
    # The texts that may stand there, each whole, in the order to list
    # them; none completes nothing.
    candidates: [str]

# An editor of lines drawn after `prompt`, with an empty history that keeps
# the last 1,000 lines entered.
#
# - `prompt`: what is drawn before each line; "" for nothing.
#
# See also `read_line`, `press`.
function line_editor(prompt: str) -> Editor
    return Editor(prompt: prompt, history: [], history_most: 1000, edit: editing.fresh())

# Does `key` to the line `editor` holds, as `read_line` does for each key it
# reads, and answers what to draw and whether the line is done: the machine
# under `read_line`, for a program that reads its own keys, or a test.
#
# - `editor`: the editor; its line, its cursor and, at Enter, its history
#   change.
# - `key`: the key pressed. A character is put in at the cursor, a control
#   character never; Left, Right, Home, End, Ctrl-B, Ctrl-F, Ctrl-A and
#   Ctrl-E move by a character or to an end, a letter and its accents as
#   one; Alt-B, Alt-F, and Ctrl or Alt with Left and Right move by a word of
#   letters and digits; Backspace and Delete take a character out; Ctrl-K
#   kills to the end, Ctrl-U to the start, Ctrl-W back to a space,
#   Alt-Backspace and Alt-D a word, kills in a row adding up; Ctrl-Y puts
#   back what was killed; Up, Down, Ctrl-P and Ctrl-N show the history;
#   Ctrl-L clears the screen; Enter, Ctrl-C, and Ctrl-D on an empty line end
#   the line, Ctrl-D elsewhere being Delete. Tab rings the bell, which
#   `press_completing` completes instead; every other key does nothing.
#
# The draw starts at the left edge of the row the cursor is on and writes the
# prompt and the line again; where they are wider than the row
# (`edit.columns`, 0 for no limit) it shows the part of the line around the
# cursor. See also `read_line`.
function press(@editor: Editor, key: Key) -> Pressed
    act: acts.Act = match key
        .character c    => .insert(text: c.text)
        .enter          => .enter
        .tab            => .complete
        .backspace      => .delete_back
        .escape         => .meta
        .up             => .older
        .down           => .newer
        .left           => .back_char
        .right          => .forward_char
        .home           => .line_start
        .end            => .line_end
        .page_up        => .nothing
        .page_down      => .nothing
        .insert         => .nothing
        .delete         => .delete_here
        .function_key _ => .nothing
        .control c      => acts.control_act(c.letter)
        .other o        => acts.escaped_act(o.bytes)

    out = editing.apply(@editor.edit, history: editor.history, prompt: editor.prompt, act: act)

    ending: Ending = match out.end
        .going       => .editing
        .entered     => .entered
        .interrupted => .interrupted
        .closed      => .closed

    if ending == .entered
        editing.remember(@editor.history, line: out.line, most: editor.history_most)
    return Pressed(draw: out.draw, ending: ending, line: out.line)

# Does `key` to the line `editor` holds as `press` does, and a Tab by asking
# `complete` what may stand before the cursor: one candidate takes the place
# of the text it replaces, several put their common start there where it
# adds to it, and where nothing can be added a first Tab rings the bell and a
# second lists them below the line, as GNU Readline does.
#
# - `editor`: the editor, as `press` changes it.
# - `key`: the key pressed.
# - `complete`: the program's completion, called at each Tab with `state`,
#   the line and the cursor's byte index in it, never for another key; what
#   it answers is used as `Completions` says.
# - `state`: what `complete` needs besides the line, the program's own (the
#   names of its commands, for instance), handed to it as it is.
#
# See also `read_line_completing`.
function press_completing<S>(@editor: Editor, key: Key, complete: (function(state: S, line: str, cursor: i64) -> Completions), state: S) -> Pressed
    if key != .tab
        return press(@editor, key: key)
    edit = editor.edit
    answered = complete(state: state, line: edit.line, cursor: edit.cursor)
    out = completing.complete(@editor.edit, prompt: editor.prompt, from: answered.from, candidates: answered.candidates)
    return Pressed(draw: out.draw, ending: .editing, line: "")

# The next line read from `input`: where it is a terminal, the line the
# person types, edited as `press` edits it, the prompt drawn first and the
# keys read from the program's terminal; where it is none, its next line as
# it is, with no prompt drawn, as Python's own prompt and Rust's `rustyline`
# read a pipe. The line is added to the history either way.
#
# - `editor`: the editor; its history grows by the line.
# - `input`: where the lines come from, the program's `io.stdin()` most
#   often; it stays the caller's. Where it is no terminal it is read a byte
#   at a time, so that nothing after the line is taken from it.
#
# The line, without its Enter or its line feed. Fails `stopped` where Ctrl-C
# was pressed, `closed` where Ctrl-D was pressed on an empty line or `input`
# ended, `not_text` where a line of `input` is not UTF-8, `failed` where the
# system refuses, and where `io.read` fails, with its code. The line is drawn
# on one row, as `press` says. See also `read_line_completing`.
function read_line(@editor: Editor, input: io.Stream) -> str?
    if !io.is_terminal(input).default(false)
        return reading.piped_line(@editor.history, input: input, most: editor.history_most)
    stood = reading.begin(@editor.edit, prompt: editor.prompt)?
    pressed @= Pressed(draw: "", ending: .editing, line: "")

    while pressed.ending == .editing
        reading.measure(@editor.edit)

        match read_key()
            .err e =>
                reading.finish(stood)
                return fail(code: e.code, msg: e.msg)
            .ok key =>
                pressed @ press(@editor, key: key)
                reading.show(pressed.draw, stood: stood)?

    reading.finish(stood)
    return reading.ended(
        entered: pressed.ending == .entered,
        interrupted: pressed.ending == .interrupted,
        line: pressed.line
    )

# The next line read from `input`, as `read_line` reads it, a Tab asking
# `complete` as `press_completing` does.
#
# - `editor`: the editor; its history grows by the line.
# - `input`: where the lines come from; it stays the caller's.
# - `complete`: the program's completion, called at each Tab with `state`,
#   the line and the cursor's byte index; never where `input` is no
#   terminal.
# - `state`: what `complete` needs besides the line, handed to it as it is.
#
# Fails as `read_line` fails. See also `read_line`.
function read_line_completing<S>(@editor: Editor, input: io.Stream, complete: (function(state: S, line: str, cursor: i64) -> Completions), state: S) -> str?
    if !io.is_terminal(input).default(false)
        return reading.piped_line(@editor.history, input: input, most: editor.history_most)
    stood = reading.begin(@editor.edit, prompt: editor.prompt)?
    pressed @= Pressed(draw: "", ending: .editing, line: "")

    while pressed.ending == .editing
        reading.measure(@editor.edit)

        match read_key()
            .err e =>
                reading.finish(stood)
                return fail(code: e.code, msg: e.msg)
            .ok key =>
                pressed @ press_completing(@editor, key: key, complete: complete, state: state)
                reading.show(pressed.draw, stood: stood)?

    reading.finish(stood)
    return reading.ended(
        entered: pressed.ending == .entered,
        interrupted: pressed.ending == .interrupted,
        line: pressed.line
    )

# Writes `editor`'s history to the file at `path`, a line each, the oldest
# first, replacing what the file held, as Python's `write_history_file` does.
#
# - `editor`: the editor whose history is written.
# - `path`: the file; made where it is not there.
#
# Fails `invalid` where a line of the history holds a line break, which a
# file of lines could not keep, naming it; and where `write_file` fails, with
# its code. See also `read_history`.
function write_history(editor: Editor, path: str) -> ()?
    return reading.save(editor.history, path: path)

# Adds the lines of the file at `path` to `editor`'s history, the file's
# first as the oldest, empty lines left out, as Python's `read_history_file`
# does; the oldest are dropped past `history_most`.
#
# - `editor`: the editor whose history grows.
# - `path`: the file, as `write_history` writes it; a carriage return before a
#   line feed is left out.
#
# Fails where `read_file` fails, with its code: `file_not_found` where no file
# is there, which a program reading its history the first time expects. See
# also `write_history`.
function read_history(@editor: Editor, path: str) -> ()?
    return reading.load(@editor.history, path: path, most: editor.history_most)

# The words of `state` that begin with the word before the cursor, the text
# from the last space before it: a completion for `press_completing` and
# `read_line_completing` in a program whose commands are a list, as Python's
# `cmd.Cmd.completenames` completes a command's name.
#
# - `state`: the words, in the order to offer them.
# - `line`: the line being edited.
# - `cursor`: the cursor's byte index in `line`; one past the line's end is
#   its end, one inside a character the start of that character.
#
# The words that begin with that text, compared byte by byte, the text itself
# included where it is one; all of them where it is empty. See also
# `press_completing`.
function complete_words(state: [str], line: str, cursor: i64) -> Completions
    found = words.words_from(words: state, line: line, cursor: cursor)
    return Completions(from: found.from, candidates: found.candidates)

## Prompts and menus

# A menu a person answers with keys at the program's terminal: one choice or
# several, the choices listed under a prompt, a window of them following the
# cursor, and, where the menu filters, the characters typed keeping the
# choices that hold them. Made by `menu`; its `prompt`, `choices` and `page`
# may be changed directly before it is drawn.
record Menu
    # What the menu's first line shows, before the filter typed.
    prompt: str
    # The choices, in the order they are listed. A control character in one
    # is drawn as a space, so that each stands on its own line.
    choices: [str]
    # Whether several may be chosen, each marked `[x]` and turned on and off
    # by Space, or by Tab where the menu filters; else one is answered.
    many: bool
    # Whether the characters typed filter the choices: a choice is kept
    # where it holds the filter, letter case set aside. Where the menu does
    # not filter, `k` and `j` move the cursor too.
    filtering: bool
    # How many choices show at once, 1 or more; the window follows the
    # cursor.
    page: i64
    # The cursor, the choices chosen, the filter and the lines last drawn.
    # Only this package reads it.
    state: menus.State

# What one key did to a menu: the bytes that show it, how it left the menu,
# and what was answered.
record MenuPressed
    # The bytes that draw the menu again on the terminal, to be written to it
    # as they are; "" where nothing changed. Where the menu ends they leave
    # one line, the prompt and what was answered.
    draw: str
    # Whether the menu goes on, or how it ended: `.entered` by Enter,
    # `.interrupted` by Escape or Ctrl-C, `.closed` by Ctrl-D.
    ending: Ending
    # The indices of the choices answered, in the order of `choices`, where
    # `ending` is `.entered`: one for a menu of one, any number for a menu of
    # many.
    chosen: [i64]

# A menu of `choices` under `prompt`, showing ten choices at once, none
# chosen, the cursor on the first.
#
# - `prompt`: what the first line shows; "" for nothing.
# - `choices`: the choices, in the order they are listed; none at all is a
#   menu `run_menu` refuses.
# - `many`: whether several may be chosen.
# - `filtering`: whether the characters typed filter the choices.
#
# See also `run_menu`, `press_menu`.
function menu(prompt: str, choices: [str], many: bool, filtering: bool) -> Menu
    return Menu(
        prompt: prompt,
        choices: choices,
        many: many,
        filtering: filtering,
        page: 10,
        state: menus.fresh(choices.len())
    )

# The bytes that draw `m` where the cursor stands, before any key: the
# prompt, then the window of choices, the cursor's marked `>`. A program that
# reads its own keys writes them first, then what `press_menu` answers.
#
# - `m`: the menu; it remembers how many lines it drew, which the next draw
#   goes back over.
#
# See also `press_menu`.
function draw_menu(@m: Menu) -> str
    return menus.render(
        @m.state,
        prompt: m.prompt,
        choices: m.choices,
        many: m.many,
        filtering: m.filtering,
        page: m.page
    )

# Does `key` to the menu `m`, as `run_menu` does for each key it reads, and
# answers what to draw and whether the menu was answered: the machine under
# `run_menu`, for a program that reads its own keys, or a test.
#
# - `m`: the menu; its cursor, filter and choices chosen change.
# - `key`: the key pressed. Up, Down, Ctrl-P and Ctrl-N move by a choice,
#   Home and End to the first and the last, Page Up and Page Down by a
#   window; Space (Tab where the menu filters) chooses the choice under the
#   cursor or no longer, in a menu of many; a character is added to the
#   filter, Backspace takes its last back and Ctrl-U empties it, where the
#   menu filters; Enter answers, Escape and Ctrl-C give up, Ctrl-D ends the
#   input. Every other key does nothing.
#
# Enter on a menu of one whose filter keeps no choice rings the bell and
# answers nothing; a menu of many answers the choices chosen, none included.
#
# See also `draw_menu`, `run_menu`.
function press_menu(@m: Menu, key: Key) -> MenuPressed
    action @= menus.NOTHING
    text @= ""

    match key
        .character c =>
            action @ menus.TYPE
            text @ c.text
        .enter     => action @ menus.ENTER
        .tab       => action @ menus.TOGGLE
        .backspace => action @ menus.ERASE
        .escape    => action @ menus.CANCEL
        .up        => action @ menus.UP
        .down      => action @ menus.DOWN
        .home      => action @ menus.FIRST
        .end       => action @ menus.LAST
        .page_up   => action @ menus.PAGE_UP
        .page_down => action @ menus.PAGE_DOWN
        .control c =>
            if c.letter == "p"
                action @ menus.UP
            else if c.letter == "n"
                action @ menus.DOWN
            else if c.letter == "u"
                action @ menus.CLEAR
            else if c.letter == "c"
                action @ menus.CANCEL
            else if c.letter == "d"
                action @ menus.END_INPUT
        .left | .right | .insert | .delete | .function_key _ | .other _ => _ = 0

    if action == menus.TOGGLE && !m.many
        action @ menus.NOTHING
    done = menus.step(
        @m.state,
        prompt: m.prompt,
        choices: m.choices,
        many: m.many,
        filtering: m.filtering,
        page: m.page,
        action: action,
        text: text
    )

    ending: Ending = if done.ending == menus.ANSWERED
        .entered
    else if done.ending == menus.GIVEN_UP
        .interrupted
    else if done.ending == menus.ENDED
        .closed
    else
        .editing
    return MenuPressed(draw: done.draw, ending: ending, chosen: done.chosen)

# The choices a person answers `m` with at the program's terminal: the menu
# drawn under the cursor, each key read and done as `press_menu` does it, and
# one line left at the end, the prompt and what was answered.
#
# - `m`: the menu; it is drawn as wide as the terminal allows, a longer line
#   cut, and its state changes as the keys do.
#
# The indices of the choices answered, in the order of `m.choices`: one for
# a menu of one, any number for a menu of many.
#
# Fails `invalid` where `m` has no choice, `stopped` where Escape or Ctrl-C
# gave it up, `closed` where Ctrl-D ended the input or the terminal is gone,
# `unsupported` where the program has no terminal, `failed` where the system
# refuses. The terminal is put back as it was, whatever the end.
#
# See also `select_one`, `select_many`.
function run_menu(@m: Menu) -> [i64]?
    asked = "answering a menu"

    if m.choices.len() == 0
        return failure.of(code: INVALID, asked: asked, why: "the menu has no choice")
    stood = hero_term.enter_keys()

    if stood < 0
        return failure.last(asked: asked)

    m.state.columns @ match os.terminal_size()
        .ok size => size.columns
        .err _   => 0

    reading.show(draw_menu(@m), stood: stood)?
    pressed @= MenuPressed(draw: "", ending: .editing, chosen: [])

    while pressed.ending == .editing
        match read_key()
            .err e =>
                reading.finish(stood)
                return fail(code: e.code, msg: e.msg)
            .ok key =>
                pressed @ press_menu(@m, key: key)
                reading.show(pressed.draw, stood: stood)?

    reading.finish(stood)

    return match pressed.ending
        .entered     => ok(pressed.chosen)
        .interrupted => failure.of(code: STOPPED, asked: asked, why: "Escape or Ctrl-C was pressed")
        .closed      => failure.of(code: CLOSED, asked: asked, why: "Ctrl-D was pressed")
        .editing     => failure.of(code: FAILED, asked: asked, why: "the menu ended unanswered")

# The index of the one choice of `choices` a person picks at the program's
# terminal, from a menu `run_menu` draws.
#
# - `prompt`: what the menu's first line shows.
# - `choices`: the choices, one or more.
# - `filtering`: whether the characters typed filter the choices.
#
# Fails as `run_menu` does. See also `select_many`, `menu`.
function select_one(prompt: str, choices: [str], filtering: bool) -> i64?
    m @= menu(prompt, choices: choices, many: false, filtering: filtering)
    chosen = run_menu(@m)?
    return ok(chosen[0])

# The indices of the choices of `choices` a person marks at the program's
# terminal, in their order, from a menu `run_menu` draws; none where none was
# marked.
#
# - `prompt`: what the menu's first line shows.
# - `choices`: the choices, one or more.
# - `filtering`: whether the characters typed filter the choices; Tab then
#   marks, since Space is typed into the filter.
#
# Fails as `run_menu` does. See also `select_one`, `menu`.
function select_many(prompt: str, choices: [str], filtering: bool) -> [i64]?
    m @= menu(prompt, choices: choices, many: true, filtering: filtering)
    return run_menu(@m)

# Whether a person answers yes to `prompt` at the program's terminal: `y` or
# `n` in either case, or Enter for the default, the answer then written out
# as `yes` or `no`.
#
# - `prompt`: the question; ` [Y/n] ` or ` [y/N] ` is written after it, the
#   capital the default.
# - `default_yes`: what Enter answers.
#
# Fails `stopped` where Escape or Ctrl-C was pressed, `closed` where Ctrl-D
# was or the terminal is gone, `unsupported` where the program has no
# terminal, `failed` where the system refuses. Every other key does nothing.
#
# See also `select_one`.
function confirm(prompt: str, default_yes: bool) -> bool?
    asked = "asking for a confirmation"

    hint = if default_yes
        " [Y/n] "
    else
        " [y/N] "
    stood = hero_term.enter_keys()

    if stood < 0
        return failure.last(asked: asked)
    reading.show(prompt + hint, stood: stood)?
    answer @= 0

    while answer == 0
        match read_key()
            .err e =>
                reading.finish(stood)
                return fail(code: e.code, msg: e.msg)
            .ok key =>
                answer @ match key
                    .character c =>
                        if c.text == "y" || c.text == "Y"
                            1
                        else if c.text == "n" || c.text == "N"
                            2
                        else
                            0
                    .enter =>
                        if default_yes
                            1
                        else
                            2
                    .escape => 3
                    .control c =>
                        if c.letter == "c"
                            3
                        else if c.letter == "d"
                            4
                        else
                            0
                    .tab | .backspace | .up | .down | .left | .right | .home | .end | .page_up | .page_down | .insert | .delete => 0
                    .function_key _ | .other _ => 0

    said = if answer == 1
        "yes"
    else if answer == 2
        "no"
    else
        ""
    reading.show(said + "\r\n", stood: stood)?
    reading.finish(stood)

    if answer == 3
        return failure.of(code: STOPPED, asked: asked, why: "Escape or Ctrl-C was pressed")

    if answer == 4
        return failure.of(code: CLOSED, asked: asked, why: "Ctrl-D was pressed")
    return ok(answer == 1)

# A password typed at the program's terminal with nothing echoed, as
# `read_secret` reads it, and typed again to confirm it where `again` asks.
#
# - `prompt`: what the terminal shows first: `Password: `.
# - `again`: what it shows before the second typing: `Again: `; "" asks
#   once.
#
# Fails `invalid` where the two typings differ, which the program asks again,
# and as `read_secret` fails. See also `read_secret`.
function read_password(prompt: str, again: str) -> str?
    first = read_secret(prompt)?

    if again == ""
        return ok(first)
    second = read_secret(again)?

    if first != second
        return failure.of(code: INVALID, asked: "reading a password", why: "the two typings differ")
    return ok(first)

## Links and the clipboard

# `text` made a link to `target` by OSC 8, which a terminal that reads it
# shows as `text` and opens `target` from, and others show as `text` alone.
#
# - `text`: what shows; it may hold styles.
# - `target`: where it leads, a URL: `https://example.com`,
#   `file:///etc/hosts`. A byte outside ASCII's printable range is
#   percent-encoded, so no byte of it ends the command.
#
# See also `write_hyperlink`.
function hyperlink(text: str, target: str) -> str
    return osc.link(text: text, target: target)

# Writes `text` to `s` as a link to `target` where `s` is a terminal that
# takes control sequences (as `write_control` asks), and elsewhere the text
# with its target said after it, `text (target)`, so that a file or a pipe
# loses nothing; the target alone where `text` is it or is empty.
#
# - `s`: the stream; it stays the caller's.
# - `text`: what shows.
# - `target`: where it leads, as `hyperlink` takes it.
#
# Fails as `io.write` fails. A terminal that reads no OSC 8 shows the text
# alone and the target nowhere, which no program can ask a terminal about.
#
# See also `hyperlink`.
function write_hyperlink(s: io.Stream, text: str, target: str) -> ()?
    if stream.controls_on(s)
        return io.write_text(s, text: hyperlink(text: text, target: target))

    if text == "" || text == target
        return io.write_text(s, text: target)
    return io.write_text(s, text: f"{text} ({target})")

# The OSC 52 command that puts `text` on the clipboard of the terminal that
# reads it, as xterm defines it: the clipboard `c` and the text in base 64.
#
# - `text`: what the clipboard holds after; "" empties it on some
#   terminals.
#
# See also `write_clipboard`.
function clipboard_command(text: str) -> str
    return osc.clipboard(text)

# Puts `text` on the clipboard of the program's terminal by OSC 52, which
# reaches the person's own clipboard through ssh as well.
#
# - `text`: what the clipboard holds after.
#
# Fails `unsupported` where the program has no terminal, or `TERM` is
# `dumb`, and `failed` where the system refuses. A terminal may read no OSC
# 52, or read it only once allowed (tmux's `set-clipboard`, a setting of
# iTerm2's), or hold only so many bytes, and none tells a program whether it
# did: the call succeeds where the command was written. See also
# `clipboard_command`.
function write_clipboard(text: str) -> ()?
    asked = "writing to the clipboard"

    if os.env("TERM").default("") == "dumb"
        return failure.of(code: UNSUPPORTED, asked: asked, why: "TERM is dumb, a terminal that reads no command")
    return stream.to_terminal(text: clipboard_command(text), asked: asked)

## Progress

# A progress bar drawn on a stream: a label, thirty cells and the share done,
# drawn again on its own line at each `advance`. It draws only on a terminal
# that takes control sequences and nothing anywhere else, so a program's
# output to a file stays clean. Made by `progress`.
record Progress
    # Where it draws; the caller's, who closes it.
    stream: io.Stream
    # What it shows first on its line.
    label: str
    # The count at which it is full, 0 or more.
    total: i64
    # The count done so far, 0 to `total`.
    done: i64
    # Whether it draws: `stream` is a terminal.
    shown: bool

# A progress bar on `s` for `total` steps, none done, drawn at once where `s`
# is a terminal.
#
# - `s`: the stream it draws on; it stays the caller's.
# - `total`: the count at which it is full; 0 is full from the start.
# - `label`: what it shows first on its line.
#
# Fails `invalid` where `total` is below 0, and as `io.write` fails. See also
# `advance`, `finish`.
function progress(s: io.Stream, total: i64, label: str) -> Progress?
    if total < 0
        return failure.of(code: INVALID, asked: f"making a progress bar of {total} steps", why: "a total is 0 or more")
    p = Progress(stream: s, label: label, total: total, done: 0, shown: stream.controls_on(s))

    if p.shown
        io.write_text(s, text: draw.bar_line(label, done: 0, total: total))?
    return ok(p)

# Counts `n` more steps done on `p`, never past its total, and draws it again.
#
# - `p`: the bar; its `done` grows.
# - `n`: the steps done since; 0 draws it again as it is.
#
# Fails `invalid` where `n` is below 0, and as `io.write` fails. See also
# `finish`.
function advance(@p: Progress, n: i64) -> ()?
    if n < 0
        return failure.of(code: INVALID, asked: f"advancing a progress bar by {n}", why: "a count is 0 or more")

    if n >= p.total - p.done
        p.done @ p.total
    else
        p.done @ p.done + n

    if p.shown
        return io.write_text(p.stream, text: draw.bar_line(p.label, done: p.done, total: p.total))
    return ok()

# Draws `p` full and ends its line, so what is written next starts below it.
#
# - `p`: the bar; its `done` becomes its total.
#
# Fails as `io.write` fails. See also `advance`.
function finish(@p: Progress) -> ()?
    p.done @ p.total

    if p.shown
        return io.write_text(p.stream, text: draw.bar_line(p.label, done: p.done, total: p.total) + "\n")
    return ok()

# A spinner drawn on a stream: a turning mark and a label, one frame further
# at each `spin`, for work whose length is not known. As a bar, it draws only
# on a terminal. Made by `spinner`.
record Spinner
    # Where it draws; the caller's, who closes it.
    stream: io.Stream
    # What it shows after its mark.
    label: str
    # The frame drawn last, from 0.
    frame: i64
    # Whether it draws: `stream` is a terminal.
    shown: bool

# A spinner on `s`, drawn at once where `s` is a terminal.
#
# - `s`: the stream it draws on; it stays the caller's.
# - `label`: what it shows after its mark.
#
# Fails as `io.write` fails. See also `spin`, `finish_spinner`.
function spinner(s: io.Stream, label: str) -> Spinner?
    sp = Spinner(stream: s, label: label, frame: 0, shown: stream.controls_on(s))

    if sp.shown
        io.write_text(s, text: draw.spinner_line(label, frame: 0))?
    return ok(sp)

# Draws `sp` one frame further. A program calls it between its steps: no
# thread turns it.
#
# - `sp`: the spinner; its `frame` grows by one.
#
# Fails as `io.write` fails. See also `finish_spinner`.
function spin(@sp: Spinner) -> ()?
    sp.frame @ (sp.frame + 1) % 4

    if sp.shown
        return io.write_text(sp.stream, text: draw.spinner_line(sp.label, frame: sp.frame))
    return ok()

# Clears `sp`'s line and writes `message` there with a new line: the message
# is written on every stream, a terminal or not, being the result the
# spinner waited for.
#
# - `sp`: the spinner; it draws no more.
# - `message`: the line written in its place; "" for an empty line.
#
# Fails as `io.write` fails. See also `spinner`.
function finish_spinner(@sp: Spinner, message: str) -> ()?
    clear = if sp.shown
        "\r" + clear_to_line_end()
    else
        ""
    sp.shown @ false
    return io.write_text(sp.stream, text: clear + message + "\n")

## Tables

# Where the cells of a table's column stand in its width.
variant Align
    # Against the left, the rest spaces.
    left
    # Against the right.
    right
    # In the middle, an odd space to the right.
    center
    # Against the right where every cell of the column under the header that
    # is not empty reads as a number (`-1,234.5`, `6.02e23`, `45%`), against
    # the left otherwise.
    auto

# The lines a table is drawn with.
variant Border
    # None: the columns two spaces apart, no space at a line's end.
    none
    # None, and a line of `-` under the header.
    simple
    # ASCII's `+`, `-` and `|` around and between the cells.
    ascii
    # The box-drawing characters: `┌`, `─`, `│` and their kin.
    box
    # A table of GitHub's Markdown: `|` around every cell, the alignment in
    # colons under the header, and a `|` in a cell escaped.
    markdown

# A table of text: rows of cells under a header, built directly and written
# by `format_table`.
record Table
    # The columns' titles, drawn first and set apart; empty for a table with
    # none.
    header: [str]
    # The rows, each a list of cells, drawn in this order; a row shorter than
    # the widest has empty cells at its end.
    rows: [[str]]
    # Where each column's cells stand, the first column's first; a column
    # past the list's end is `.auto`.
    align: [Align]
    # The lines it is drawn with.
    border: Border

# `t` as text: each column as wide as its widest cell on a terminal, a wide
# character of East Asian scripts taking two cells, a mark none and a style's
# sequences none, every cell padded with spaces on the side its column
# stands against, and the header in its column's alignment.
#
# - `t`: the table. A control character in a cell, a tab or a line break, is
#   drawn as one space, so every row stays one line.
#
# Each line ended by a line feed; "" for a table of no column. Markdown gives
# every column at least three cells and writes a header of empty cells where
# `t` has none, GitHub's tables needing one. See also `format_columns`.
function format_table(t: Table) -> str
    sides: [tables.Side] @= []

    for a in t.align
        side: tables.Side = match a
            .left   => .left
            .right  => .right
            .center => .center
            .auto   => .auto

        sides @ sides.push(side)

    lines: tables.Lines = match t.border
        .none     => .none
        .simple   => .simple
        .ascii    => .ascii
        .box      => .box
        .markdown => .markdown

    return tables.format(header: t.header, rows: t.rows, sides: sides, lines: lines)

# `items` laid in columns two spaces apart, down each column first, in as
# few rows as `width` cells hold, as Python's `cmd.Cmd.columnize` lays them;
# the line editor lists its candidates so.
#
# - `items`: the texts, in the order to read them down the columns.
# - `width`: the cells a line may take, the terminal's columns most often
#   (`os.terminal_size`); an item wider than it stands alone on its line.
#
# Each line ended by a line feed, with no space at its end; "" for no items,
# where Python writes `<empty>`. See also `format_table`.
function format_columns(items: [str], width: i64) -> str
    return tables.columns(items: items, room: width)

## Examples

# The plain style, which changes nothing.
test "plain: no colour and no attribute"
    assert styled("hi", style: plain()) == "hi"

# Red text, as the terminal writes it.
test "with_foreground: red text"
    assert styled("hi", style: with_foreground(plain(), color: .red)) == "\u{1b}[31mhi\u{1b}[0m"

# White text on a blue background.
test "with_background: white on blue"
    s = with_background(with_foreground(plain(), color: .white), color: .blue)
    assert styled("ok", style: s) == "\u{1b}[37;44mok\u{1b}[0m"

# Bold and underlined, each attribute added once.
test "with_attribute: bold and underline, bold added twice"
    s = with_attribute(with_attribute(with_attribute(plain(), a: .bold), a: .underline), a: .bold)
    assert s.attributes == [.bold, .underline]
    assert styled("go", style: s) == "\u{1b}[1;4mgo\u{1b}[0m"

# A colour of the 256 and one of 24 bits.
test "styled: an indexed colour and a colour of 24 bits"
    assert styled("x", style: with_foreground(plain(), color: .indexed(n: 208))) == "\u{1b}[38;5;208mx\u{1b}[0m"
    assert styled("x", style: with_background(plain(), color: .rgb(red: 10, green: 20, blue: 30))) == "\u{1b}[48;2;10;20;30mx\u{1b}[0m"

# A pipe takes no colour.
test "has_colors: a pipe takes none"
    p @= io.pipe().must()
    assert !has_colors(p.writer)
    io.close(@p.reader).must()
    io.close(@p.writer).must()

# Styled text written to a pipe arrives plain.
test "write_styled: to a pipe, the text alone"
    p @= io.pipe().must()
    write_styled(p.writer, text: "done", style: with_foreground(plain(), color: .green)).must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == "done"
    io.close(@p.reader).must()

# The cursor at the top left, and a row below 1 refused.
test "cursor_to: the first cell, and a row of 0"
    assert cursor_to(row: 1, column: 1).must() == "\u{1b}[1;1H"
    assert cursor_to(row: 0, column: 1).is_err()

# Up three rows; none is no text.
test "cursor_up: three rows, and none"
    assert cursor_up(3).must() == "\u{1b}[3A"
    assert cursor_up(0).must() == ""
    assert cursor_up(-1).is_err()

# Down two rows.
test "cursor_down: two rows"
    assert cursor_down(2).must() == "\u{1b}[2B"

# Right five columns.
test "cursor_forward: five columns"
    assert cursor_forward(5).must() == "\u{1b}[5C"

# Left one column.
test "cursor_back: one column"
    assert cursor_back(1).must() == "\u{1b}[1D"

# The cursor hidden.
test "cursor_hide: its sequence"
    assert cursor_hide() == "\u{1b}[?25l"

# The cursor shown again.
test "cursor_show: its sequence"
    assert cursor_show() == "\u{1b}[?25h"

# The cursor's place saved, then brought back.
test "cursor_save: its sequence"
    assert cursor_save() == "\u{1b}7"

# The saved place brought back.
test "cursor_restore: its sequence"
    assert cursor_restore() == "\u{1b}8"

# The bell, written only to a terminal by `write_control`.
test "bell: its byte"
    assert bell() == "\u{7}"
    assert bell().len() == 1

# The whole line cleared.
test "clear_line: its sequence"
    assert clear_line() == "\u{1b}[2K"

# The line cleared from the cursor.
test "clear_to_line_end: its sequence"
    assert clear_to_line_end() == "\u{1b}[K"

# The screen cleared and the cursor at the top left.
test "clear_screen: its sequence"
    assert clear_screen() == "\u{1b}[2J\u{1b}[H"

# A control sequence written to a pipe writes nothing.
test "write_control: nothing reaches a pipe"
    p @= io.pipe().must()
    write_control(p.writer, sequence: clear_screen()).must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == ""
    io.close(@p.reader).must()

# The raw mode entered and left on a terminal; a program with none is told.
test "enter_raw: entered and left, or unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err e => assert e.code == UNSUPPORTED

# Leaving where no mode stands changes nothing.
test "leave_raw: with no mode standing"
    leave_raw().must()

# A key read; a program with no terminal is told.
test "read_key: a key, or unsupported with no terminal"
    match read_key_within(0)
        .ok _  => _ = 0
        .err e => assert e.code == TIMEOUT || e.code == UNSUPPORTED

# A key waited for a tenth of a second.
test "read_key_within: a tenth of a second, then timeout or unsupported"
    match read_key_within(100)
        .ok _  => _ = 0
        .err e => assert e.code == TIMEOUT || e.code == UNSUPPORTED

# A secret asked for where the program has no terminal, which is told; on a
# terminal the example asks nothing, a person being needed to answer.
test "read_secret: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err _ => assert read_secret("Password: ").is_err()

# A bar of four steps advanced on a pipe: it counts, and draws nothing there.
test "progress: four steps on a pipe"
    pipe @= io.pipe().must()
    p @= progress(pipe.writer, total: 4, label: "copy").must()
    advance(@p, n: 1).must()
    assert p.done == 1
    io.close(@pipe.writer).must()
    assert io.read_all_text(pipe.reader).must() == ""
    io.close(@pipe.reader).must()

# Advancing past the total stops at the total.
test "advance: past the total"
    pipe @= io.pipe().must()
    p @= progress(pipe.writer, total: 3, label: "").must()
    advance(@p, n: 10).must()
    assert p.done == 3
    assert advance(@p, n: -1).is_err()
    io.close(@pipe.writer).must()
    io.close(@pipe.reader).must()

# A bar finished is full.
test "finish: full at the end"
    pipe @= io.pipe().must()
    p @= progress(pipe.writer, total: 9, label: "load").must()
    finish(@p).must()
    assert p.done == 9
    io.close(@pipe.writer).must()
    io.close(@pipe.reader).must()

# A spinner on a pipe draws nothing.
test "spinner: on a pipe, nothing drawn"
    pipe @= io.pipe().must()
    sp @= spinner(pipe.writer, label: "waiting").must()
    assert !sp.shown
    finish_spinner(@sp, message: "").must()
    io.close(@pipe.writer).must()
    io.close(@pipe.reader).must()

# Five turns of a spinner come back to its second frame.
test "spin: five turns"
    pipe @= io.pipe().must()
    sp @= spinner(pipe.writer, label: "x").must()

    for _ in range(from: 0, to: 5)
        spin(@sp).must()

    assert sp.frame == 1
    finish_spinner(@sp, message: "").must()
    io.close(@pipe.writer).must()
    io.close(@pipe.reader).must()

# A spinner stopped writes its message, on a pipe too.
test "finish_spinner: the message written on a pipe"
    pipe @= io.pipe().must()
    sp @= spinner(pipe.writer, label: "fetching").must()
    finish_spinner(@sp, message: "fetched").must()
    io.close(@pipe.writer).must()
    assert io.read_all_text(pipe.reader).must() == "fetched\n"
    io.close(@pipe.reader).must()

# An editor with its prompt and an empty history.
test "line_editor: a prompt and an empty history"
    ed = line_editor("> ")
    assert ed.prompt == "> " && ed.history.len() == 0 && ed.history_most == 1000

# A word typed key by key, its last character taken back, and Enter: the line
# answered and kept in the history.
test "press: a word typed, a character taken back, and Enter"
    ed @= line_editor("> ")

    for c in ["l", "s", "x"]
        _ = press(@ed, key: .character(text: c))

    _ = press(@ed, key: .backspace)
    p = press(@ed, key: .enter)
    assert p.ending == .entered && p.line == "ls"
    assert ed.history == ["ls"]

# A command's name completed at Tab from the program's list of commands.
test "press_completing: a command completed at Tab"
    commands = ["history", "help", "quit"]
    ed @= line_editor("> ")
    _ = press(@ed, key: .character(text: "q"))
    _ = press_completing(@ed, key: .tab, complete: complete_words, state: commands)
    p = press_completing(@ed, key: .enter, complete: complete_words, state: commands)
    assert p.line == "quit"

# The commands that begin with what was typed before the cursor.
test "complete_words: two commands begin with he"
    found = complete_words(["history", "help", "quit"], line: "he", cursor: 2)
    assert found.from == 0 && found.candidates == ["help"]

# Lines read from an input that is no terminal, a pipe here: each as it
# stands, then `closed` at its end.
test "read_line: two lines from a pipe, then its end"
    p @= io.pipe().must()
    io.write_text(p.writer, text: "ls\nquit\n").must()
    io.close(@p.writer).must()
    ed @= line_editor("> ")
    assert read_line(@ed, input: p.reader).must() == "ls"
    assert read_line(@ed, input: p.reader).must() == "quit"

    match read_line(@ed, input: p.reader)
        .ok _  => assert false
        .err e => assert e.code == CLOSED

    io.close(@p.reader).must()
    assert ed.history == ["ls", "quit"]

# A line read with completion from a pipe, where no Tab is pressed.
test "read_line_completing: a line from a pipe"
    p @= io.pipe().must()
    io.write_text(p.writer, text: "help\n").must()
    io.close(@p.writer).must()
    ed @= line_editor("> ")
    assert read_line_completing(@ed, input: p.reader, complete: complete_words, state: ["help", "quit"]).must() == "help"
    io.close(@p.reader).must()

# A history saved to a file, then read into a new editor; the file is in
# `build/`, the folder `heroes test` builds in.
test "write_history: two lines written and read back"
    path = "build/rebel-term-save-example.txt"
    ed @= line_editor("> ")
    ed.history @ ["ls", "cd /"]
    write_history(ed, path: path).must()
    again @= line_editor("> ")
    read_history(@again, path: path).must()
    assert again.history == ["ls", "cd /"]

# A history read from a file written before; no file is told
# `file_not_found`.
test "read_history: a file of three lines, and none"
    path = "build/rebel-term-load-example.txt"
    write_file(path: path, text: "a\nb\nc\n").must()
    ed @= line_editor("> ")
    read_history(@ed, path: path).must()
    assert ed.history == ["a", "b", "c"]

    match read_history(@ed, path: path + ".none")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

# A table of names and sizes in ASCII lines, the sizes to the right.
test "format_table: names and sizes in an ASCII box"
    t = Table(header: ["name", "size"], rows: [["a.txt", "120"], ["b.txt", "4"]], align: [], border: .ascii)
    assert format_table(t) == "+-------+------+\n| name  | size |\n+-------+------+\n| a.txt |  120 |\n| b.txt |    4 |\n+-------+------+\n"

# Five names laid in columns of ten cells.
test "format_columns: five names in ten cells"
    assert format_columns(["a", "bb", "ccc", "dddd", "e"], width: 10) == "a    dddd\nbb   e\nccc\n"

# A menu of three colours, one to be chosen, none chosen yet.
test "menu: three colours, one to choose"
    m = menu("Colour:", choices: ["red", "green", "blue"], many: false, filtering: false)
    assert m.page == 10 && m.choices.len() == 3 && !m.many

# The first draw of a menu: its prompt, then the choices, the cursor's
# marked.
test "draw_menu: a prompt and two choices"
    m @= menu("Colour:", choices: ["red", "green"], many: false, filtering: false)
    assert draw_menu(@m) == "\r\u{1b}[JColour:\r\n> red\r\n  green"

# Keys handed to a menu without a terminal: down, then Enter answers the
# second choice and leaves one line.
test "press_menu: down and Enter"
    m @= menu("Colour:", choices: ["red", "green"], many: false, filtering: false)
    _ = draw_menu(@m)
    _ = press_menu(@m, key: .down)
    done = press_menu(@m, key: .enter)
    assert done.ending == .entered && done.chosen == [1]
    assert done.draw == "\r\u{1b}[2A\u{1b}[JColour: green\r\n"

# A menu run at the terminal; a program with none is told, and on a terminal
# the example asks nothing, a person being needed to answer.
test "run_menu: unsupported with no terminal"
    match enter_raw()
        .ok _ => leave_raw().must()
        .err _ =>
            m @= menu("Colour:", choices: ["red", "green"], many: false, filtering: true)
            assert run_menu(@m).is_err()

# One choice asked for; a program with no terminal is told.
test "select_one: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err _ => assert select_one("Colour:", choices: ["red", "green"], filtering: false).is_err()

# Several choices asked for; a program with no terminal is told.
test "select_many: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err _ => assert select_many("Toppings:", choices: ["cheese", "basil"], filtering: false).is_err()

# A question asked; a program with no terminal is told.
test "confirm: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err _ => assert confirm("Delete the file?", default_yes: false).is_err()

# A password asked twice; a program with no terminal is told.
test "read_password: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err _ => assert read_password(prompt: "Password: ", again: "Again: ").is_err()

# A word made a link, as a terminal that reads OSC 8 opens it.
test "hyperlink: a word linked to a page"
    assert hyperlink(text: "site", target: "https://example.com") == "\u{1b}]8;;https://example.com\u{1b}\\site\u{1b}]8;;\u{1b}\\"

# A link written to a pipe, where it is no terminal: the target said after
# the text.
test "write_hyperlink: a link said on a pipe"
    p @= io.pipe().must()
    write_hyperlink(p.writer, text: "site", target: "https://example.com").must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == "site (https://example.com)"
    io.close(@p.reader).must()

# The command that puts a word on the clipboard.
test "clipboard_command: a word"
    assert clipboard_command("hi") == "\u{1b}]52;c;aGk=\u{1b}\\"

# A text put on the clipboard; a program with no terminal is told.
test "write_clipboard: unsupported with no terminal"
    match enter_raw()
        .ok _  => leave_raw().must()
        .err e => assert write_clipboard("hi").is_err() && e.code == UNSUPPORTED

test "press_menu: many marked with Space, filtered with Tab marking, given up and ended"
    m @= menu("Pick:", choices: ["alpha", "beta", "gamma"], many: true, filtering: false)
    _ = draw_menu(@m)
    _ = press_menu(@m, key: .character(text: " "))
    _ = press_menu(@m, key: .end)
    _ = press_menu(@m, key: .character(text: " "))
    assert press_menu(@m, key: .enter).chosen == [0, 2]
    f @= menu("Pick:", choices: ["alpha", "beta", "gamma"], many: true, filtering: true)
    _ = draw_menu(@f)
    _ = press_menu(@f, key: .character(text: "a"))
    _ = press_menu(@f, key: .character(text: "m"))
    _ = press_menu(@f, key: .tab)
    assert press_menu(@f, key: .enter).chosen == [2]
    g @= menu("Pick:", choices: ["a"], many: false, filtering: false)
    _ = draw_menu(@g)
    _ = press_menu(@g, key: .tab)
    assert press_menu(@g, key: .escape).ending == .interrupted
    h @= menu("Pick:", choices: ["a"], many: false, filtering: false)
    assert press_menu(@h, key: .control(letter: "d")).ending == .closed

test "run_menu: a menu with no choice is invalid, terminal or none"
    none: [str] = []
    m @= menu("Pick:", choices: none, many: false, filtering: false)

    match run_menu(@m)
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "write_hyperlink: on a pipe, the target alone where the text is it or empty"
    p @= io.pipe().must()
    write_hyperlink(p.writer, text: "", target: "https://a.example").must()
    write_hyperlink(p.writer, text: " ", target: "x").must()
    write_hyperlink(p.writer, text: "https://b.example", target: "https://b.example").must()
    io.close(@p.writer).must()
    assert io.read_all_text(p.reader).must() == "https://a.example  (x)https://b.example"
    io.close(@p.reader).must()
