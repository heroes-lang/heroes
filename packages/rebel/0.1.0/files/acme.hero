# A DNS-01 challenge answered, its record published at the challenge server.
test "accept_challenge: a published TXT record"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            assert accept_challenge(@client, challenge: challenge).must().url == challenge.url

# An authorization waited for until DNS-01 validated it.
test "wait_authorization: valid"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            assert fetch_authorization(@client, url: authorization.url).must().status == "valid"

# An order finalized with a certificate request.
test "finalize: a request for the one name"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            ready = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            finalized = finalize(@client, order: ready, csr: sample.CSR).must()
            assert finalized.status == "processing" || finalized.status == "valid"

# An order waited for until its certificate is issued.
test "wait_order: valid, with a certificate"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            ready = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            assert ready.status == "ready"
            _ = finalize(@client, order: ready, csr: sample.CSR).must()
            done = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            assert done.status == "valid" && done.certificate.len() > 0

# A certificate chain downloaded.
test "download: the PEM of a chain"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            ready = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            _ = finalize(@client, order: ready, csr: sample.CSR).must()
            done = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            chain = download(@client, url: done.certificate).must()
            leaf = pem.parse(chain.pem).must().data
            assert pem.parse_all(chain.pem).must().len() >= 2 && leaf.len() > 0

# A certificate revoked as superseded.
test "revoke: reason 4"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            ready = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            _ = finalize(@client, order: ready, csr: sample.CSR).must()
            done = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            chain = download(@client, url: done.certificate).must()
            leaf = pem.parse(chain.pem).must().data
            revoke(@client, certificate: leaf, reason: 4).must()

# The ARI identifier of a certificate the test server issued, held to what OpenSSL reads of it.
test "renewal_id: a certificate of Pebble"
    assert renewal_id(sample.LEAF).must() == sample.LEAF_ID
    assert renewal_id([0x30, 0x00]).is_err()

# When the CA suggests renewing a certificate it issued.
test "renewal_info: a window"
    match sample.directory_url()
        .err _ => skip_test(reason: "ACME_DIRECTORY is not set or nothing answers there")
        .ok url =>
            client @= connect(
                directory_url: url,
                key: jose.generate_key(.p256).must(),
                transport: sample.transport()
            ).must()
            _ = new_account(@client, contacts: [], agree_terms: true).must()
            order = new_order(@client, request: order_for([sample.CSR_NAME])).must()
            authorization = fetch_authorization(@client, url: order.authorizations[0]).must()
            challenge = challenge_of(authorization: authorization, kind: "dns-01").must()
            sample.publish_txt(
                name: dns01_name(authorization.identifier.value),
                value: dns01_value(client: client, token: challenge.token).must()
            ).must()
            _ = accept_challenge(@client, challenge: challenge).must()
            _ = wait_authorization(@client, url: authorization.url, timeout_ms: 30000).must()
            ready = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            _ = finalize(@client, order: ready, csr: sample.CSR).must()
            done = wait_order(@client, url: order.url, timeout_ms: 30000).must()
            chain = download(@client, url: done.certificate).must()
            leaf = pem.parse(chain.pem).must().data
            window = renewal_info(client: client, certificate: leaf).must()
            assert window.start.len() > 0 && window.end.len() > 0
