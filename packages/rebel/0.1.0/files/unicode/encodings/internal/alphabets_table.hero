# The letters each language's text uses, in lower case: the table
# `guess.hero` reads to judge a reading of bytes in a single-byte encoding,
# whose letters one language should account for, and in about the
# proportions that language writes them.
#
# The table is data, measured and not typed: a one-off Heroes program,
# `gen_alphabets.hero`, kept outside the tree in the round's scratch folder
# (`.claude/worktrees/rebel-scratch/unicode_encodings/gen/`), read on 2026-11-17
# the values of the localized `.strings` files of macOS 27's applications, one
# corpus a language, 0.3 to 3.6 million letters each, counted each letter
# with `unicode.is_letter` made lower case by `unicode.simple_lower`, kept
# each that makes at least 1 in 10,000 of the language's letters, ASCII's
# among them, and wrote this module whole. Nothing here is edited by hand.
# What it kept:
#
# - ar: 63 letters of 2494666
# - ca: 36 letters of 1348874
# - cs: 41 letters of 3021796
# - da: 30 letters of 3017877
# - de: 30 letters of 3459624
# - el: 58 letters of 3607971
# - en: 26 letters of 2798770
# - es: 32 letters of 3313841
# - fi: 28 letters of 3127254
# - fr: 34 letters of 3496863
# - he: 53 letters of 2327088
# - hr: 30 letters of 1312628
# - hu: 35 letters of 3274988
# - id: 26 letters of 3043276
# - it: 31 letters of 3357826
# - nl: 29 letters of 3313083
# - no: 30 letters of 2982392
# - pl: 35 letters of 3240169
# - pt_PT: 37 letters of 3284182
# - ro: 30 letters of 1383285
# - ru: 59 letters of 3225529
# - sk: 42 letters of 3099407
# - sl: 28 letters of 262808
# - sv: 29 letters of 2991347
# - th: 72 letters of 2435304
# - tr: 33 letters of 3084537
# - uk: 57 letters of 1284780
# - vi: 89 letters of 1147071

# The languages, by the names of their folders of localized text.
constant LANGUAGES: [str]
    [
        "ar"
        "ca"
        "cs"
        "da"
        "de"
        "el"
        "en"
        "es"
        "fi"
        "fr"
        "he"
        "hr"
        "hu"
        "id"
        "it"
        "nl"
        "no"
        "pl"
        "pt_PT"
        "ro"
        "ru"
        "sk"
        "sl"
        "sv"
        "th"
        "tr"
        "uk"
        "vi"
    ]

# Each letter a language uses, `code point << 32 | share << 8 | the
# language's index`, its share how many in 100,000 of the language's letters
# it makes; ascending, so that the languages of one letter stand together.
constant LETTERS: [i64]
    [
        416611944474
        416612056325
        416612063764
