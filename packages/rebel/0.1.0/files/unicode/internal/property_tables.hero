# The code points passed over in casing, Unicode's Case_Ignorable property,
# whose general category is none of `Mn`, `Me`, `Cf`, `Lm` and `Sk`, which are
# all passed over.
constant OTHER_CASE_IGNORABLE: [i64]
    [
        81788967
        96469038
        121634874
        383778999
        1893729159
        2883585375
        3196061172
        17230209049
