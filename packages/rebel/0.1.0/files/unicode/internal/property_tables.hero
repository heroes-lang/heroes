        17481867420
        17951629695
        19763569897
        23882378365
        89447769757
        89892366192
        90162898932
        90177579001
        91997907807
        92025170793
        141465552768
        141471844229
        141480232880
        141570410426
        257798824045
    ]

# The code points that are upper case, Unicode's Uppercase property, and whose
# general category is not `Lu`.
constant OTHER_UPPERCASE: [i64]
    [
        17918075247
        19709043919
        266925633865
        266992742761
        267059851657
    ]

