        136956673818
    ]

## Tests

test "WHITE_SPACE ascends"
    at: i64 @= 1

    while at < WHITE_SPACE.len()
        assert WHITE_SPACE[at - 1] < WHITE_SPACE[at]
        at @ at + 1

test "OTHER_LOWERCASE ascends"
    at: i64 @= 1

    while at < OTHER_LOWERCASE.len()
        assert OTHER_LOWERCASE[at - 1] < OTHER_LOWERCASE[at]
        at @ at + 1

test "OTHER_UPPERCASE ascends"
    at: i64 @= 1

    while at < OTHER_UPPERCASE.len()
        assert OTHER_UPPERCASE[at - 1] < OTHER_UPPERCASE[at]
        at @ at + 1

test "OTHER_ALPHABETIC ascends"
    at: i64 @= 1

    while at < OTHER_ALPHABETIC.len()
        assert OTHER_ALPHABETIC[at - 1] < OTHER_ALPHABETIC[at]
        at @ at + 1

test "OTHER_CASE_IGNORABLE ascends"
    at: i64 @= 1

    while at < OTHER_CASE_IGNORABLE.len()
        assert OTHER_CASE_IGNORABLE[at - 1] < OTHER_CASE_IGNORABLE[at]
        at @ at + 1
