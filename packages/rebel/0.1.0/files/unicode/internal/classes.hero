test "classes of a surrogate, U+D800 and U+DFFF: category Cs, and in no class"
    assert name_of(0xd800) == "Cs" && name_of(0xdfff) == "Cs"
    assert !is_graphic(0xd800) && !is_printable(0xdfff) && !is_letter(0xd800) && !is_control(0xdfff)

test "digit_value: the digits of two scripts, and a letter refused with its category"
    assert digit_value(0x30).must() == 0 && digit_value(0x39).must() == 9
    assert digit_value(0x667).must() == 7
    assert digit_value(0x1d7ff).must() == 9

    match digit_value(0x41)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "U+0041 is no decimal digit: its category is Lu"
