test "classes of U+0000, the smallest code point, against Python and Go"
    assert !is_letter(0x0)
    assert !is_alphabetic(0x0)
    assert !is_digit(0x0)
    assert !is_number(0x0)
    assert !is_alphanumeric(0x0)
    assert !is_space(0x0)
    assert !is_upper(0x0)
    assert !is_lower(0x0)
    assert !is_title(0x0)
    assert !is_cased(0x0)
    assert !is_case_ignorable(0x0)
    assert !is_punctuation(0x0)
    assert !is_symbol(0x0)
    assert !is_mark(0x0)
    assert is_control(0x0)
    assert !is_graphic(0x0)
    assert !is_printable(0x0)
    assert name_of(0x0) == "Cc"
    assert digit_value(0x0).is_err()

test "classes of U+007F, the last of ASCII, against Python and Go"
    assert !is_letter(0x7f)
    assert !is_alphabetic(0x7f)
    assert !is_digit(0x7f)
    assert !is_number(0x7f)
    assert !is_alphanumeric(0x7f)
    assert !is_space(0x7f)
    assert !is_upper(0x7f)
    assert !is_lower(0x7f)
    assert !is_title(0x7f)
    assert !is_cased(0x7f)
    assert !is_case_ignorable(0x7f)
    assert !is_punctuation(0x7f)
    assert !is_symbol(0x7f)
    assert !is_mark(0x7f)
    assert is_control(0x7f)
    assert !is_graphic(0x7f)
    assert !is_printable(0x7f)
    assert name_of(0x7f) == "Cc"
    assert digit_value(0x7f).is_err()

