# The classes of a code point: its general category, read from the runs of
# `category_table`, and the properties a category does not tell, read from
# the sets of `property_tables`. Every function takes a code point from 0 to
# U+10FFFF, a surrogate included, and reads about thirteen entries of a table.

use unicode
use unicode/internal/category_table
use unicode/internal/property_tables
use unicode/internal/search
use unicode/internal/sweep
use unicode/internal/utf8
use unicode/internal/written

# The index of the category `Lu`, an upper case letter, in `NAMES`; the
# indices of the other categories follow it in `NAMES`' order.
constant LU: i64
    0

# The index of `Ll`, a lower case letter.
constant LL: i64
    1

# The index of `Lt`, a title case letter.
constant LT: i64
    2

# The index of `Lm`, a modifier letter.
constant LM: i64
    3

# The index of `Lo`, the last of the letters.
constant LO: i64
    4

# The index of `Mn`, the first of the marks.
constant MN: i64
    5

# The index of `Me`, the last of the marks.
constant ME: i64
    7

# The index of `Nd`, a decimal digit, the first of the numbers.
constant ND: i64
    8

# The index of `Nl`, a number written as a letter.
constant NL: i64
    9

# The index of `No`, the last of the numbers.
constant NO: i64
    10

# The index of `Pc`, the first of the punctuation.
constant PC: i64
    11

# The index of `Po`, the last of the punctuation.
constant PO: i64
    17

# The index of `Sm`, the first of the symbols.
constant SM: i64
    18

# The index of `Sk`, a modifier symbol.
constant SK: i64
    20

# The index of `So`, the last of the symbols.
constant SO: i64
    21

# The index of `Zs`, a space.
constant ZS: i64
    22

# The index of `Cc`, a control code.
constant CC: i64
    25

# The index of `Cf`, a format character.
constant CF: i64
    26

# Every general category, at its index in `category_table.NAMES`.
constant CATEGORIES: [unicode.Category]
    [
        .uppercase_letter
        .lowercase_letter
        .titlecase_letter
        .modifier_letter
        .other_letter
        .nonspacing_mark
        .spacing_mark
        .enclosing_mark
        .decimal_number
        .letter_number
        .other_number
        .connector_punctuation
        .dash_punctuation
        .open_punctuation
        .close_punctuation
        .initial_punctuation
        .final_punctuation
        .other_punctuation
        .math_symbol
        .currency_symbol
        .modifier_symbol
        .other_symbol
        .space_separator
        .line_separator
        .paragraph_separator
        .control
        .format
        .surrogate
        .private_use
        .unassigned
    ]

# The run of `category_table.RUNS` that holds `n`: its first code point
# shifted left by 5, and its category's index.
function run_of(n: i64) -> i64
    return category_table.RUNS[search.count_at_or_below(category_table.RUNS, n << 5 | 31) - 1]

# The index in `category_table.NAMES` of the general category of `n`.
function category_of(n: i64) -> i64
    return run_of(n) & 31

# The two letters of the general category of `n`.
function name_of(n: i64) -> str
    return category_table.NAMES[category_of(n)]

# Whether `n` is a letter, a category that begins with `L`.
function is_letter(n: i64) -> bool
    return category_of(n) <= LO

# Whether `n` is alphabetic: a letter, `Nl`, or in `OTHER_ALPHABETIC`.
function is_alphabetic(n: i64) -> bool
    k = category_of(n)
    return k <= LO || k == NL || search.in_set(property_tables.OTHER_ALPHABETIC, n)

# Whether `n` is a decimal digit, `Nd`.
function is_digit(n: i64) -> bool
    return category_of(n) == ND

# Whether `n` is a number, a category that begins with `N`.
function is_number(n: i64) -> bool
    k = category_of(n)
    return k >= ND && k <= NO

# Whether `n` is alphabetic or a number.
function is_alphanumeric(n: i64) -> bool
    return is_alphabetic(n) || is_number(n)

# Whether `n` is white space.
function is_space(n: i64) -> bool
    return search.in_set(property_tables.WHITE_SPACE, n)

# Whether `n` is upper case: `Lu`, or in `OTHER_UPPERCASE`.
function is_upper(n: i64) -> bool
    return category_of(n) == LU || search.in_set(property_tables.OTHER_UPPERCASE, n)

# Whether `n` is lower case: `Ll`, or in `OTHER_LOWERCASE`.
function is_lower(n: i64) -> bool
    return category_of(n) == LL || search.in_set(property_tables.OTHER_LOWERCASE, n)

# Whether `n` is a title case letter, `Lt`.
function is_title(n: i64) -> bool
    return category_of(n) == LT

# Whether `n` has a case: upper, lower or title.
function is_cased(n: i64) -> bool
    return is_upper(n) || is_lower(n) || is_title(n)

# Whether `n` is passed over in casing: `Mn`, `Me`, `Cf`, `Lm` or `Sk`, or in
# `OTHER_CASE_IGNORABLE`.
function is_case_ignorable(n: i64) -> bool
    k = category_of(n)
    return k == MN || k == ME || k == CF || k == LM || k == SK || search.in_set(property_tables.OTHER_CASE_IGNORABLE, n)

# Whether `n` is punctuation, a category that begins with `P`.
function is_punctuation(n: i64) -> bool
    k = category_of(n)
    return k >= PC && k <= PO

# Whether `n` is a symbol, a category that begins with `S`.
function is_symbol(n: i64) -> bool
    k = category_of(n)
    return k >= SM && k <= SO

# Whether `n` is a mark, a category that begins with `M`.
function is_mark(n: i64) -> bool
    k = category_of(n)
    return k >= MN && k <= ME

# Whether `n` is a control code, `Cc`.
function is_control(n: i64) -> bool
    return category_of(n) == CC

# Whether `n` is graphic: a letter, a mark, a number, punctuation, a symbol or
# `Zs`, which are the categories up to `Zs` in `NAMES`' order.
function is_graphic(n: i64) -> bool
    return category_of(n) <= ZS

# Whether `n` is printable: graphic, with U+0020 the only space.
function is_printable(n: i64) -> bool
    return category_of(n) <= SO || n == 0x20

# The value of `n`, a decimal digit, 0 to 9: Unicode writes every script's ten
# digits in a run of their own from zero, so the value is how far `n` stands
# from the start of its run, by tens. Fails `invalid` where `n` is no decimal
# digit.
function digit_value(n: i64) -> i64?
    run = run_of(n)

    if run & 31 != ND
        return fail(
            code: utf8.INVALID,
            msg: f"{written.code_point(n)} is no decimal digit: its category is {category_table.NAMES[run & 31]}"
        )
    return ok((n - (run >> 5)) % 10)

## Tests

# The expected numbers are the fold of `sweep` over what Python 3.15.2's
# `unicodedata` and `str` methods and Go 1.27.3's `unicode` answer for the
# same code points, observed 2026-11-15, both reading Unicode 17.0.0; the
# seven blocks are Latin to Latin Extended-B (U+0000 to U+024F), Greek and
# Cyrillic (U+0370 to U+052F), General Punctuation to Number Forms (U+2000
# to U+218F), CJK Symbols and Punctuation, Hiragana and Katakana (U+3000 to
# U+30FF), the Halfwidth and Fullwidth Forms (U+FF00 to U+FFEF), Deseret to
# Osage (U+10400 to U+104FF) and the Mathematical Alphanumeric Symbols
# (U+1D400 to U+1D7FF): 3,216 code points for each question.

# The digit value of `n` plus one, 0 where it has none: what the fold reads.
function digit_or_none(n: i64) -> i64
    return digit_value(n).default(-1) + 1

test "is_letter: every code point of seven blocks, against Python and Go"
    assert sweep.folded_bools(question: is_letter, first: 0x0, past: 0x250) == 58580588
    assert sweep.folded_bools(question: is_letter, first: 0x370, past: 0x530) == 623373750
    assert sweep.folded_bools(question: is_letter, first: 0x2000, past: 0x2190) == 960675244
    assert sweep.folded_bools(question: is_letter, first: 0x3000, past: 0x3100) == 70186979
    assert sweep.folded_bools(question: is_letter, first: 0xff00, past: 0xfff0) == 504997193
    assert sweep.folded_bools(question: is_letter, first: 0x10400, past: 0x10500) == 616087772
    assert sweep.folded_bools(question: is_letter, first: 0x1d400, past: 0x1d800) == 252712748

