# The prime the hash of a loose name is taken modulo, below 2 to the 40th.
constant HASH_PRIME: i64
    1099511627689

# What the hash is multiplied by before each byte is added.
constant HASH_FACTOR: i64
    131

# What the hash is multiplied by at the end, modulo `HASH_PRIME`, so that
# short names spread over the buckets; below 2 to the 22nd, so the product
# stays below 2 to the 62nd.
constant HASH_SPREAD: i64
    4194301

# How far a hash is shifted right to give its bucket, of 4,096.
constant BUCKET_SHIFT: i64
    28

# Where each bucket's entries end in `ENTRY_TARGETS`, three buckets to an
# entry, each 16 bits, the first in the highest bits; a bucket begins where
# the one before it ends.
constant BUCKET_ENDS: [i64]
