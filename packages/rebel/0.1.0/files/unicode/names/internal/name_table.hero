## Tests

test "name_table: the tables ascend, and each pair is as long as the other"
    for table in [NAME_RUNS, RULES, TOKEN_STARTS]
        at: i64 @= 1

        while at < table.len()
            assert table[at - 1] < table[at]
            at @ at + 1

    assert ALIASES.len() == ALIAS_NAMES.len()
    assert SEQUENCES.len() == SEQUENCE_NAMES.len()
    assert JAMO_LEADING.len() == 19 && JAMO_VOWELS.len() == 21 && JAMO_TRAILING.len() == 28
