# - `UnicodeData.txt`, SHA-256 2e1efc1dcb59c575
# - `NameAliases.txt`, SHA-256 793f6f1e4d15fd90
# - `NamedSequences.txt`, SHA-256 0cd1c928edac72ea
# - `Jamo.txt`, SHA-256 17bb07f5e37f9953

