# The runtime's own doors on the process that `os` reads, `hero_os.h`, bound
# thin: one function per C function, in the header's order, each answering
# what C answers. The floor of `os`: one variable of the environment, the
# place a path names (the working folder is the place `.` names), the
# process's id, the executable's path and the suffix that tells Windows.
#
# The header is the runtime's, spec § 13's *threads, processes and files from
# the language's `hero_os.h`*, so this group names it and no `link`. A door
# that answers text is the header's shown read: `status` says whether the
# bytes were UTF-8, and where they were not the answer opens with `marks`
# bytes, two for each U+FFFD of the text after them, the byte it replaced in
# upper-case hexadecimal or `--` for one the bytes held.

extern "hero_os.h"
    # What a shown read answers in its status: the same small numbers on every
    # platform, never the system's own.
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64
    constant HERO_OS_FAILED: i64
    constant HERO_OS_NOT_TEXT: i64
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_resolved_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_why() -> i64
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_run_exe_suffix() -> str
    function hero_os_pid() -> i64
    # Round 3 (2026-11-16): the four doors the compiler's cases build their
    # files with, done or failed with no kind, `fs_why` then the system's own
    # number. Their Windows arms hand a path to the ANSI calls, which read
    # its bytes in the machine's code page: a path of ASCII alone means the
    # same there. `fs` sets bits and makes links through `hero_disk.h`'s own
    # doors, which carry a kind and any UTF-8 path.
    constant HERO_OS_UNSUPPORTED: i64
    function hero_fs_mode(path: cstr lent) -> i64
    function hero_fs_set_mode(path: cstr lent, mode: i64) -> i64
    function hero_fs_link(existing: cstr lent, name: cstr lent) -> i64
    function hero_fs_symlink(target: cstr lent, name: cstr lent) -> i64
    # For the test of the four alone: what it made, removed.
    #
    # - `path`: the file, the link or the empty folder removed; nothing there
    #   is `HERO_OS_OK` too.
    function hero_fs_remove(path: cstr lent) -> i64

# The value of the environment variable `name`, `status` set to
# `HERO_OS_NOT_FOUND` and "" answered where it is unset, and to
# `HERO_OS_NOT_TEXT` where the value is not UTF-8, the answer then opening
# with `marks` bytes.
#
# - `name`: the variable's name; it aborts where it holds a zero byte.
# - `status`: set to `HERO_OS_OK`, `HERO_OS_NOT_FOUND` or `HERO_OS_NOT_TEXT`.
# - `marks`: set to how many bytes the answer opens with that are marks, two
#   for each U+FFFD of the value after them; 0 for every status but
#   `HERO_OS_NOT_TEXT`.
function env_shown(name: str, @status: i64, @marks: i64) -> str
    return hero_env_shown(name: name.cstr(), status: @status, marks: @marks)

# The absolute place `path` names, every link on the way followed and the
# parts not there yet as written, `status` set to `HERO_OS_FAILED` and ""
# answered where it cannot be resolved, `fs_why` then saying why.
#
# - `path`: the path to resolve, relative to the working folder or absolute;
#   the empty path fails. It aborts where it holds a zero byte.
# - `status`: set to `HERO_OS_OK`, `HERO_OS_FAILED` or `HERO_OS_NOT_TEXT`.
# - `marks`: set to how many bytes the answer opens with that are marks; 0
#   for every status but `HERO_OS_NOT_TEXT`.
function resolved_shown(path: str, @status: i64, @marks: i64) -> str
    return hero_fs_resolved_shown(path: path.cstr(), status: @status, marks: @marks)

# The system's own number for why the last `resolved_shown` on this thread
# failed, below zero where the runtime refused before asking it, 0 after one
# that did not fail.
function fs_why() -> i64
    return hero_fs_why()

# The path of the running executable, links followed, `status` set to
# `HERO_OS_NOT_FOUND` and "" answered where the machine gives none.
#
# - `status`: set to `HERO_OS_OK`, `HERO_OS_NOT_FOUND` or `HERO_OS_NOT_TEXT`.
# - `marks`: set to how many bytes the answer opens with that are marks; 0
#   for every status but `HERO_OS_NOT_TEXT`.
function exe_path_shown(@status: i64, @marks: i64) -> str
    return hero_exe_path_shown(status: @status, marks: @marks)

# `.exe` on Windows, where a program's file needs it to be started, and "" on
# every other system.
function run_exe_suffix() -> str
    return hero_run_exe_suffix()

# The process's own id, as the system numbers it.
function os_pid() -> i64
    return hero_os_pid()

# The permission bits of what `path` names, links followed, 0 to 0o7777, or
# -1 where nothing is there, `fs_why` then saying why. Windows keeps
# read-only alone: 0o444 or 0o666 there.
#
# - `path`: what to ask about, ASCII alone on Windows, whose arm reads its
#   bytes in the machine's code page; it aborts where it holds a zero byte.
function fs_mode(path: str) -> i64
    return hero_fs_mode(path.cstr())

# `HERO_OS_OK` once what `path` names, links followed, has the bits `mode`,
# of which the low twelve are read, or `HERO_OS_FAILED`, `fs_why` then
# saying why. Windows sets read-only where `mode` grants nobody writing and
# clears it where it grants somebody.
#
# - `path`: what to change, ASCII alone on Windows; it aborts where it holds
#   a zero byte.
# - `mode`: the permission bits, of which the low twelve (0o7777) are read;
#   on Windows only whether any of 0o222 is set.
function fs_set_mode(path: str, mode: i64) -> i64
    return hero_fs_set_mode(path.cstr(), mode: mode)

# `HERO_OS_OK` once `name` is a second name of the file `existing` names, a
# hard link, or `HERO_OS_FAILED`, `fs_why` then saying why.
#
# - `existing`: the file the new name is given to; it must exist. It aborts
#   where it holds a zero byte.
# - `name`: the new name, which must not exist; it aborts where it holds a
#   zero byte.
function fs_link(existing: str, name: str) -> i64
    return hero_fs_link(existing: existing.cstr(), name: name.cstr())

# `HERO_OS_OK` once `name` is a symbolic link holding `target`, or
# `HERO_OS_FAILED`, `fs_why` then saying why: on Windows for a user who may
# make no link.
#
# - `target`: the text the link holds, a path that need not exist, relative
#   to the link's own folder or absolute. It aborts where it holds a zero
#   byte.
# - `name`: where the link is made, which must not exist; it aborts where it
#   holds a zero byte.
function fs_symlink(target: str, name: str) -> i64
    return hero_fs_symlink(target: target.cstr(), name: name.cstr())

## Tests

test "env_shown: a variable every process here has, and one never set"
    status: i64 @= -1
    marks: i64 @= -1
    path = env_shown("PATH", status: @status, marks: @marks)
    assert status == HERO_OS_OK && marks == 0 && path.len() > 0
    absent = env_shown("REBEL_OS_FLOOR_NEVER_SET", status: @status, marks: @marks)
    assert status == HERO_OS_NOT_FOUND && marks == 0 && absent == ""

test "resolved_shown: the working folder is absolute, a missing part is kept as written, and the empty path fails"
    status: i64 @= -1
    marks: i64 @= -1
    here = resolved_shown(".", status: @status, marks: @marks)
    assert status == HERO_OS_OK && marks == 0 && here.len() > 1
    assert fs_why() == 0
    beyond = resolved_shown("rebel-os-floor-never-there", status: @status, marks: @marks)
    assert status == HERO_OS_OK && beyond.len() > here.len()
    none = resolved_shown("", status: @status, marks: @marks)
    assert status == HERO_OS_FAILED && none == "" && fs_why() != 0

test "exe_path_shown, run_exe_suffix and os_pid: a path, one of two suffixes, an id above 0"
    status: i64 @= -1
    marks: i64 @= -1
    exe = exe_path_shown(status: @status, marks: @marks)
    assert status == HERO_OS_OK && marks == 0 && exe.len() > 1
    assert run_exe_suffix() == "" || run_exe_suffix() == ".exe"
    assert os_pid() > 0
    assert os_pid() == os_pid()
    assert HERO_OS_OK != HERO_OS_NOT_FOUND && HERO_OS_FAILED != HERO_OS_NOT_TEXT

test "fs_mode, fs_set_mode, fs_link and fs_symlink: bits set and read back, a second name, a link, and a name not there"
    dir = f"build/rebel-os-floor-{os_pid()}"
    assert !write_file(path: dir + "-f", text: "hello").is_err()
    windows = run_exe_suffix() == ".exe"
    assert fs_set_mode(dir + "-f", mode: 0o640) == HERO_OS_OK

    if windows
        assert fs_mode(dir + "-f") == 0o666
    else
        assert fs_mode(dir + "-f") == 0o640
    assert fs_set_mode(dir + "-f", mode: 0o644) == HERO_OS_OK
    assert fs_mode(dir + "-none") == -1 && fs_why() != 0
    assert fs_set_mode(dir + "-none", mode: 0o644) == HERO_OS_FAILED && fs_why() != 0
    assert fs_link(existing: dir + "-f", name: dir + "-g") == HERO_OS_OK
    assert fs_link(existing: dir + "-f", name: dir + "-g") == HERO_OS_FAILED && fs_why() != 0

    # The link names the file beside it, so it resolves on every platform:
    # Windows resolves no link to nothing, where POSIX keeps the part.
    linked = fs_symlink(target: f"rebel-os-floor-{os_pid()}-f", name: dir + "-l")
    assert linked == HERO_OS_OK || windows && linked == HERO_OS_FAILED
    status: i64 @= -1
    marks: i64 @= -1

    if linked == HERO_OS_OK
        assert fs_symlink(target: "x", name: dir + "-l") == HERO_OS_FAILED && fs_why() != 0
        _ = resolved_shown(dir + "-l", status: @status, marks: @marks)
        assert status == HERO_OS_OK
    assert HERO_OS_UNSUPPORTED != HERO_OS_OK && HERO_OS_UNSUPPORTED != HERO_OS_FAILED
    assert hero_fs_remove(path: (dir + "-f").cstr()) == HERO_OS_OK
    assert hero_fs_remove(path: (dir + "-g").cstr()) == HERO_OS_OK

    if linked == HERO_OS_OK
        assert hero_fs_remove(path: (dir + "-l").cstr()) == HERO_OS_OK
