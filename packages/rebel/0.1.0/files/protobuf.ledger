  heroes  protobuf.pack_any, protobuf.unpack_any, protobuf.any_type_name, protobuf.TYPE_URL_PREFIX
  go      anypb.New, anypb.MarshalFrom, anypb.UnmarshalTo, anypb.UnmarshalNew, anypb.Any.MarshalFrom, anypb.Any.UnmarshalTo, anypb.Any.UnmarshalNew, anypb.Any.MessageIs, anypb.Any.MessageName
