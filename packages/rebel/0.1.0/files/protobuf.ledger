capability wkt/struct  Struct, Value and ListValue to and from a `json.Value`
  heroes  protobuf.to_json_value, protobuf.from_json_value, protobuf.struct_from_json
  go      structpb.NewStruct, structpb.NewValue, structpb.NewList, structpb.NewBoolValue, NewListValue, NewNullValue, NewNumberValue, NewStringValue, NewStructValue, structpb.Struct.AsMap, structpb.Value.AsInterface, structpb.ListValue.AsSlice, structpb.NullValue, structpb.Value_BoolValue, Value_ListValue, Value_NullValue, Value_NumberValue, Value_StringValue, Value_StructValue
