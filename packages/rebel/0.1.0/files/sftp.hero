# An open file's times set.
test "set_file_times: an open file's times"
    match lab.signed_in("ex-set-file-times")
        .err _ => skip_test(reason: lab.SKIP)
        .ok found =>
            l @= found
            s @= start(@l.client).must()
            f = create(@l.client, @s, path: l.dir + "/a").must()
            t = time.from_unix(whole_seconds: 1000000000, extra_nanoseconds: 0).must()
            set_file_times(@l.client, @s, file: f, written: t, accessed: t).must()
            close_file(@l.client, @s, file: f).must()
            assert time.unix_seconds(fs.info(l.dir + "/a").must().written) == 1000000000
            close(@l.client, @s).must()
            lab.done(@l).must()

