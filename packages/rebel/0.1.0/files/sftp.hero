            write_bytes(@l.client, @s, path: l.dir + "/new", data: [2]).must()
            write_bytes(@l.client, @s, path: l.dir + "/old", data: [1]).must()
            posix_rename(@l.client, @s, from: l.dir + "/new", to: l.dir + "/old").must()
            assert fs.read_bytes(l.dir + "/old").must() == [2]
            close(@l.client, @s).must()
            lab.done(@l).must()

