# Bytes copied from one file to another by the server itself.
test "copy_range: bytes copied by the server"
    match lab.signed_in("ex-copy-range")
        .err _ => skip_test(reason: lab.SKIP)
        .ok found =>
            l @= found
            s @= start(@l.client).must()
            write_bytes(@l.client, @s, path: l.dir + "/a", data: [1, 2, 3]).must()
            from = open(@l.client, @s, path: l.dir + "/a").must()
            to = create(@l.client, @s, path: l.dir + "/b").must()
            copy_range(@l.client, @s, from: from, from_offset: 1, n: 2, to: to, to_offset: 0).must()
            close_file(@l.client, @s, file: to).must()
            close_file(@l.client, @s, file: from).must()
            assert fs.read_bytes(l.dir + "/b").must() == [2, 3]
            close(@l.client, @s).must()
            lab.done(@l).must()

