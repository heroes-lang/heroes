            write_bytes(@l.client, @s, path: l.dir + "/a", data: [1]).must()
            entries = read_dir(@l.client, @s, path: l.dir).must()
            assert entries[0].name == "a" && entries[1].name == "b"
            close(@l.client, @s).must()
            lab.done(@l).must()

