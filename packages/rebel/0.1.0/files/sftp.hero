            assert read(@l.client, @s, file: f, offset: 1, n: 2).must() == [2, 3]
            close_file(@l.client, @s, file: f).must()
            close(@l.client, @s).must()
            lab.done(@l).must()

# Bytes written at an offset of a file.
test "write: bytes at an offset"
