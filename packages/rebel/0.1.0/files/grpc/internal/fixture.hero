# FOR TESTS: a gRPC server and client of this process, each on a thread of
# its own over h2c, written on `http2` and this package's private moves: the
# server echoes, fails, streams or stays silent by the method's name; the
# client calls one method once and says what came back. A server listens on
# a port the system chooses and tells it back to the test's thread
# (`start`).

use bytes
use grpc/internal/calls
use grpc/internal/clock
use http2
use io
use net
use numbers
use strings
use threads
use time
use tls

# A server running on a thread of its own, and the port it listens on.
record Started
    # The port the server listens on, the one the system chose for it, which
    # the server told back.
    port: i64
    # The server's thread, whose answer `threads.wait_text` gives.
    thread: threads.TextThread

# `body`, `serve` or `serve_tls`, started on a thread of its own. The server
# listens on a port the system chooses and tells it back over a connection
# to a listener of this thread, so no port is named while nothing holds it,
# and none is let go for another program to take between a choice and a
# listen (defect 2633).
function start(body: (function(str) -> str)) -> Started
    control @= net.listen(host: "127.0.0.1", port: 0).must()
    t = threads.spawn_text(body: body, arg: to_str(control.address.port)).must()
    said = told(control)
    net.close_listener(@control).must()
    return Started(port: port_told(said).must(), thread: t)

# Tells `port`, the one a server listens on, to the listener of `start` at
# `control` after the word `told` that marks it as the server's (`told`),
# and closes.
function tell(control: i64, port: i64)
    c @= net.connect("127.0.0.1", port: control, deadline_ms: 10000).must()
    io.write_text(c.stream, text: "told " + to_str(port)).must()
    io.close(@c.stream).must()

# What a server tells `control`, the listener its starter holds: the text
# after `told ` of the first connection that says it within five seconds of
# its accept, ten connections at most and thirty seconds in all, or why none
# did. Any other connection is closed and passed over, as one another
# program makes to a port it did not choose: beside a test of `tls` that
# steers its connect to the port the system gives next, such a connection
# reached this listener and held its read to its deadline in 62 rounds of
# 3,000 (defect 2633).
function told(control: net.Listener) -> str
    net.set_accept_deadline(control, deadline_ms: 30000).must()
    tries @= 0

    while tries < 10
        tries @ tries + 1

        match net.accept(control, deadline_ms: 5000)
            .err e =>
                if e.code == net.TIMEOUT
                    return e.code + ": " + e.msg
            .ok c =>
                r @= io.reader(c.stream)
                said = io.read_rest_text(@r)

                match io.close(@r.stream)
                    .ok _  => _ = 0
                    .err _ => _ = 0

                match said
                    .ok text =>
                        if strings.has_prefix(s: text, prefix: "told ")
                            return text.slice(from: 5, to: text.len())
                    .err _ => _ = 0

    return "none of ten connections told a port"

# The port `said` names, or a failure carrying the server's words where it
# told why it listens on none.
function port_told(said: str) -> i64?
    match numbers.parse_int(said)
        .ok port => return ok(port)
        .err _   => return fail(code: "failed", msg: "the server listens on no port: " + said)

# Every request message of `stream`, read until the client's last.
function requests_of(@c: http2.Conn, stream: i64) -> [[u8]]
    held: [u8] @= []
    pending: [[u8]] @= []

    while true
        match http2.read_event_of(@c, stream: stream)
            .ok e =>
                match e
                    .data d =>
                        _ = calls.take(held: @held, @pending, data: d.data, gzip: true, most: 1048576)

                        if d.end_stream
                            return pending
                    .trailers _ => return pending
                    .reset _ => return pending
                    .request _ | .response _ | .informational _ | .window _ | .settings _ | .settings_acked | .ping _ | .pong _ | .goaway _ => _ = 0
            .err _ => return pending

# Answers one call by its method: `Echo` sends each request back, `Many`
# sends three, `Fail` ends `NOT_FOUND`, `Silent` answers nothing for two
# seconds.
function answer(@c: http2.Conn, stream: i64, path: str) -> ()?
    asked = requests_of(@c, stream: stream)

    if path == "/test.Echo/Fail"
        head @= calls.response_head(false)

        for f in calls.status_fields(code: 5, message: "no such thing", details: [1, 2])
            head @ head.push(f)

        return http2.write_headers(@c, stream: stream, headers: head, end_stream: true)

    if path == "/test.Echo/Silent"
        time.sleep(time.milliseconds(2000).must())
    http2.write_headers(@c, stream: stream, headers: calls.response_head(false), end_stream: false)?
    sent @= asked

    if path == "/test.Echo/Many"
        sent @ [bytes.from_text("one"), bytes.from_text("two"), bytes.from_text("three")]

    for m in sent
        http2.write_data(@c, stream: stream, data: calls.framed(m, gzip: false)?, end_stream: false)?

    return http2.write_headers(
        @c,
        stream: stream,
        headers: calls.status_fields(code: 0, message: "", details: []),
        end_stream: true
    )

# Answers every call of `c` until the client ends the connection, and
# answers how many.
function serve_on(@c: http2.Conn) -> i64
    answered: i64 @= 0

    while true
        match http2.accept_stream(@c)
            .ok e =>
                match e
                    .request r =>
                        if answer(@c, stream: r.stream, path: r.path).is_err()
                            _ = 0
                        answered @ answered + 1
                    .response _ | .informational _ | .trailers _ | .data _ | .reset _ | .window _ | .settings _ | .settings_acked | .ping _ | .pong _ | .goaway _ => _ = 0
            .err _ => return answered

# A thread's body: a gRPC server over h2c on a port the system chooses,
# told to the listener `start` holds at the port `arg` names, answering
# every call of the first connection that makes one, and answering how many.
function serve(arg: str) -> str
    control = numbers.parse_int(arg).must()
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    tell(control: control, port: l.address.port)
    net.set_accept_deadline(l, deadline_ms: 10000).must()
    answered: i64 @= 0

    for _ in range(from: 0, to: 10)
        if answered == 0
            match net.accept(l, deadline_ms: 15000)
                .ok accepted =>
                    stream @= accepted.stream

                    match http2.server(@stream, options: http2.default_options())
                        .ok made =>
                            c @= made
                            answered @ serve_on(@c)

                            match http2.close(@c)
                                .ok _  => _ = 0
                                .err _ => _ = 0
                        .err _ => io.close(@stream).must()
                .err _ => _ = 0

    net.close_listener(@l).must()
    return to_str(answered)

# A thread's body: a gRPC server over TLS offering `h2`, with the test
# certificate of `localhost`, telling its port and answering as `serve`
# does.
function serve_tls(arg: str) -> str
    control = numbers.parse_int(arg).must()
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: ["h2"])
    ).must()
    tell(control: control, port: l.port)
    tls.set_accept_deadline(l, deadline: time.seconds(10).must()).must()
    answered: i64 @= 0

    for _ in range(from: 0, to: 10)
        if answered == 0
            match tls.accept(l, deadline: time.seconds(10).must())
                .ok accepted =>
                    stream @= accepted.stream
                    tls.set_deadline(stream, deadline: time.seconds(15).must()).must()

                    match http2.server(@stream, options: http2.default_options())
                        .ok made =>
                            c @= made
                            answered @ serve_on(@c)

                            match http2.close(@c)
                                .ok _  => _ = 0
                                .err _ => _ = 0
                        .err _ => io.close(@stream).must()
                .err _ => _ = 0

    tls.close_listener(@l).must()
    return to_str(answered)

# A thread's body: one call over h2c, `arg` holding the port, the path and
# the request's text apart by spaces; answered as "status messages first",
# the first response as text.
function call(arg: str) -> str
    words = split_words(arg)
    port = numbers.parse_int(words[0]).must()
    c @= http2.connect_plain(
        host: "127.0.0.1",
        port: port,
        deadline: time.seconds(10).must(),
        options: http2.default_options()
    ).must()
    head = calls.call_head(
        scheme: "http",
        authority: "localhost",
        path: words[1],
        user_agent: "fixture",
        gzip: false,
        timeout: "",
        names: [],
        values: []
    ).must()
    id = http2.start_stream(@c, headers: head, end_stream: false).must()
    http2.write_data(
        @c,
        stream: id,
        data: calls.framed(bytes.from_text(words[2]), gzip: false).must(),
        end_stream: true
    ).must()
    held: [u8] @= []
    pending: [[u8]] @= []
    code: i64 @= -1

    while code < 0
        match http2.read_event_of(@c, stream: id)
            .ok e =>
                match e
                    .response r =>
                        if r.end_stream
                            code @ calls.said(r.headers, http_status: r.status).code
                    .data d => _ = calls.take(held: @held, @pending, data: d.data, gzip: true, most: 1048576)
                    .trailers t => code @ calls.said(t.headers, http_status: 200).code
                    .reset r => code @ 1000 + r.error
                    .request _ | .informational _ | .window _ | .settings _ | .settings_acked | .ping _ | .pong _ | .goaway _ => _ = 0
            .err _ => code @ 999

    http2.close(@c).must()

    first = if pending.len() > 0
        bytes.to_text_lossy(pending[0])
    else
        ""
    return f"{code} {pending.len()} {first}"

# The words of `s` apart by spaces.
function split_words(s: str) -> [str]
    out: [str] @= []
    at: i64 @= 0

    for i in range(from: 0, to: s.len())
        if s[i] == ' '
            out @ out.push(s.slice(from: at, to: i))
            at @ i + 1

    out @ out.push(s.slice(from: at, to: s.len()))
    return out

# The milliseconds of `clock`, so a test can measure a wait.
function now_ms() -> i64
    return clock.now_ms()
