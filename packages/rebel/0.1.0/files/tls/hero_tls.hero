# The platform layer's TLS, `hero_tls.h`, bound thin: one function per C
# function, each answering what C answers, in C's order. Where a call fails
# its stream or listener is `nullptr` or its count -1, and `last_error` then
# names the kind, `last_message` the system's own words. Rebel's floor of
# `tls` (`examples-rebel/README.md` § A2): no policy stands here, and the
# face above it turns every kind into a code.
#
# The layer is C of the language's own beside the runtime, so this group
# names its header and no `link`: on Windows the member links SChannel's
# libraries itself, on macOS Network.framework's, and on Linux it opens
# OpenSSL at the first call that needs it, so the same lines bind it
# everywhere. A TLS stream is `io/hero_stream`'s handle, read, written and
# closed by that floor.
#
# THE INNER STREAM'S LIFE PASSES INTO THE TLS STREAM, AND THE MARK IS
# `transfers`, as `net/hero_stream_net` hands a socket into a stream: the TLS
# stream's close then closes the inner one, once; and where no TLS stream is
# made the transfer is not made, so the inner stream stays the caller's.

use bytes
use io/hero_stream
use net/hero_net
use threads/hero_os as threads_floor
use time/hero_time
use tls/internal/fixture

extern "hero_tls.h"
    # A socket listening for TLS connections. It is a handle the layer issues
    # and checks: one closed already, `nullptr`, or one it never issued is
    # `HERO_TLS_NOT_OPEN`, never a read of freed memory.
    record Listener tag hero_tls_listener
    # The kinds of failure `last_error` answers, the same numbers on every
    # platform; those a stream also has keep `hero_stream.h`'s numbers.
    constant HERO_TLS_OK: i64
    constant HERO_TLS_INVALID: i64
    constant HERO_TLS_NOT_OPEN: i64
    constant HERO_TLS_NOT_FOUND: i64
    constant HERO_TLS_DENIED: i64
    constant HERO_TLS_LIMIT: i64
    constant HERO_TLS_CLOSED_PEER: i64
    constant HERO_TLS_UNSUPPORTED: i64
    constant HERO_TLS_OTHER: i64
    constant HERO_TLS_TIMED_OUT: i64
    constant HERO_TLS_STOPPED: i64
    constant HERO_TLS_REFUSED: i64
    constant HERO_TLS_UNREACHABLE: i64
    constant HERO_TLS_IN_USE: i64
    constant HERO_TLS_CERT_EXPIRED: i64
    constant HERO_TLS_CERT_HOST: i64
    constant HERO_TLS_CERT_UNTRUSTED: i64
    constant HERO_TLS_CERT_REVOKED: i64
    constant HERO_TLS_CERT_INVALID: i64
    constant HERO_TLS_HANDSHAKE: i64
    constant HERO_TLS_PREAMBLE: i64
    # The kinds of a step of the exchange before TLS, and its bounds: the
    # steps, a step's bytes, a line's bytes with its end, a line's beginning.
    constant HERO_TLS_STEP_SEND: i64
    constant HERO_TLS_STEP_EXPECT: i64
    constant HERO_TLS_STEP_EXPECT_LINE: i64
    constant HERO_TLS_STEPS_MOST: u64
    constant HERO_TLS_STEP_BYTES_MOST: u64
    constant HERO_TLS_LINE_MOST: u64
    constant HERO_TLS_PREFIX_MOST: u64
    # What `checks` takes: every check, or, for tests alone, none.
    constant HERO_TLS_CHECK_ALL: i64
    constant HERO_TLS_CHECK_NOTHING_FOR_TESTS: i64
    # The bytes a buffer must have for `protocol` to write a protocol's name.
    constant HERO_TLS_PROTOCOL_MOST: u64
    # What a call taking a time takes for no limit, -1; 0 is then a time
    # already passed (2026-11-20).
    constant HERO_TLS_FOREVER: i64
    # The two calls the marks below name: the one that ends a stream's life,
    # which the header declares through `hero_stream.h`, and the listener's.
    function hero_stream_close(s: hero_stream.Stream consumes) -> i64
    function hero_tls_available() -> i64
    function hero_tls_connect(host: cstr lent, port: i64, ms: i64, @roots: [u8] counted_by roots_count lent, roots_count: u64, protocols: cstr lent, checks: i64) -> hero_stream.Stream acquires hero_stream_close
    function hero_tls_listen(address: cstr lent, port: i64, @chain: [u8] counted_by chain_count lent, chain_count: u64, @key: [u8] counted_by key_count lent, key_count: u64, protocols: cstr lent) -> Listener acquires hero_tls_close_listener
    function hero_tls_connect_after(host: cstr lent, port: i64, ms: i64, @roots: [u8] counted_by roots_count lent, roots_count: u64, protocols: cstr lent, checks: i64, @steps: [u8] counted_by steps_count lent, steps_count: u64) -> hero_stream.Stream acquires hero_stream_close
    function hero_tls_listen_after(address: cstr lent, port: i64, @chain: [u8] counted_by chain_count lent, chain_count: u64, @key: [u8] counted_by key_count lent, key_count: u64, protocols: cstr lent, @steps: [u8] counted_by steps_count lent, steps_count: u64) -> Listener acquires hero_tls_close_listener
    function hero_tls_port(l: Listener) -> i64
    function hero_tls_accept(l: Listener, ms: i64) -> hero_stream.Stream acquires hero_stream_close
    function hero_tls_close_listener(l: Listener consumes) -> i64
    function hero_tls_client(inner: hero_stream.Stream transfers hero_stream_close, host: cstr lent, @roots: [u8] counted_by roots_count lent, roots_count: u64, protocols: cstr lent, checks: i64) -> hero_stream.Stream acquires hero_stream_close
    function hero_tls_server(inner: hero_stream.Stream transfers hero_stream_close, @chain: [u8] counted_by chain_count lent, chain_count: u64, @key: [u8] counted_by key_count lent, key_count: u64, protocols: cstr lent) -> hero_stream.Stream acquires hero_stream_close
    function hero_tls_version(s: hero_stream.Stream) -> i64
    function hero_tls_protocol(s: hero_stream.Stream, @buffer: [u8] counted_by count lent, count: u64) -> i64
    function hero_tls_set_deadline(s: hero_stream.Stream, ms: i64) -> i64
    function hero_tls_set_accept_deadline(l: Listener, ms: i64) -> i64
    function hero_tls_last_error() -> i64
    function hero_tls_last_os_error() -> i64
    function hero_tls_last_message(@buffer: [u8] counted_by count lent, count: u64) -> i64

# 1 where this machine has the platform's TLS library, 0 where it has not (a
# Linux machine with no `libssl.so.3`).
function available() -> i64
    return hero_tls_available()

# A TLS stream to `host` at `port`, its connection and handshake made within
# `ms` milliseconds, or `nullptr`. It aborts where `host` or `protocols`
# holds a zero byte, which C cannot read.
#
# - `host`: a name or an address, sent to the peer and checked against its
#   certificate; "" fails `HERO_TLS_INVALID`.
# - `port`: 1 to 65535, else `HERO_TLS_INVALID`.
# - `ms`: milliseconds for the connection and the handshake together;
#   `HERO_TLS_FOREVER` is no limit; 0 waits not at all, and since a
#   handshake always waits for the peer it fails `HERO_TLS_TIMED_OUT` at
#   once; below -1 fails `HERO_TLS_INVALID`.
# - `roots`: PEM, its first `roots_count` bytes the only authorities trusted;
#   left as it was handed.
# - `roots_count`: the bytes of `roots` read; 0 trusts the system's store.
# - `protocols`: the ALPN list offered, the names joined by `,`; "" offers
#   none.
# - `checks`: one of `HERO_TLS_CHECK_*`.
function connect(host: str, port: i64, ms: i64, @roots: [u8], roots_count: u64, protocols: str, checks: i64) -> hero_stream.Stream
    return hero_tls_connect(
        host: host.cstr(),
        port: port,
        ms: ms,
        @roots,
        roots_count: roots_count,
        protocols: protocols.cstr(),
        checks: checks
    )

# A socket listening for TLS on `address` at `port` (0 for a free one), or
# `nullptr`; every connection it accepts presents the PEM chain of the first
# `chain_count` bytes of `chain` and proves it holds the PEM key of the first
# `key_count` bytes of `key`. `protocols` is the ALPN list it takes.
function listen(address: str, port: i64, @chain: [u8], chain_count: u64, @key: [u8], key_count: u64, protocols: str) -> Listener
    return hero_tls_listen(
        address: address.cstr(),
        port: port,
        chain: @chain,
        chain_count: chain_count,
        key: @key,
        key_count: key_count,
        protocols: protocols.cstr()
    )

# `connect`, with the exchange of the first `steps_count` bytes of `steps`
# run on the connection before TLS begins, or `nullptr`.
#
# - `host`, `port`, `roots`, `roots_count`, `protocols`, `checks`: as
#   `connect` takes them.
# - `ms`: milliseconds for the connection, the exchange and the handshake
#   together, as `connect`'s: `HERO_TLS_FOREVER` no limit, 0 not waiting at
#   all, below -1 `HERO_TLS_INVALID`.
# - `steps`: the exchange in the header's form, each step a kind byte, four
#   bytes of length, most significant first, and its bytes; left as it was
#   handed.
# - `steps_count`: the bytes of `steps` read.
function connect_after(host: str, port: i64, ms: i64, @roots: [u8], roots_count: u64, protocols: str, checks: i64, @steps: [u8], steps_count: u64) -> hero_stream.Stream
    return hero_tls_connect_after(
        host: host.cstr(),
        port: port,
        ms: ms,
        roots: @roots,
        roots_count: roots_count,
        protocols: protocols.cstr(),
        checks: checks,
        steps: @steps,
        steps_count: steps_count
    )

# `listen`, every connection it accepts running the exchange of `steps`
# from the server's side before TLS begins, within `accept`'s time.
function listen_after(address: str, port: i64, @chain: [u8], chain_count: u64, @key: [u8], key_count: u64, protocols: str, @steps: [u8], steps_count: u64) -> Listener
    return hero_tls_listen_after(
        address: address.cstr(),
        port: port,
        chain: @chain,
        chain_count: chain_count,
        key: @key,
        key_count: key_count,
        protocols: protocols.cstr(),
        steps: @steps,
        steps_count: steps_count
    )

# The port `l` listens on, or -1.
function port_of(l: Listener) -> i64
    return hero_tls_port(l)

# The next connection `l` holds as a TLS stream once its handshake has ended,
# or `nullptr`. A close of `l` on another thread ends the wait,
# `HERO_TLS_NOT_OPEN`.
#
# - `l`: the listener; it stays open, and its wait for a connection is as
#   long as `set_accept_deadline` says.
# - `ms`: milliseconds from the connection for its handshake;
#   `HERO_TLS_FOREVER` is no limit; with 0 the connection taken fails its
#   handshake `HERO_TLS_TIMED_OUT` at once; below -1 fails
#   `HERO_TLS_INVALID`.
function accept(l: Listener, ms: i64) -> hero_stream.Stream
    return hero_tls_accept(l, ms: ms)

# 0, or -1 where `l` was not open; `l` is given back either way, and the
# streams accepted from it stay open.
function close_listener(@l: Listener) -> i64
    return hero_tls_close_listener(l)

# TLS as the client over `inner`, a stream connected to `host`, or `nullptr`.
# From this call `inner` is closed by the TLS stream's close; where no TLS
# stream is made it stays the caller's, to close. On macOS it answers
# `nullptr` with `HERO_TLS_UNSUPPORTED` and leaves `inner` untouched.
function client(@inner: hero_stream.Stream, host: str, @roots: [u8], roots_count: u64, protocols: str, checks: i64) -> hero_stream.Stream
    return hero_tls_client(
        inner,
        host: host.cstr(),
        @roots,
        roots_count: roots_count,
        protocols: protocols.cstr(),
        checks: checks
    )

# TLS as the server over `inner`, a stream connected to a client, presenting
# `chain` and `key` as `listen`'s connections do, or `nullptr`; `inner`'s
# life passes as `client`'s does, and macOS answers as it does there.
function server(@inner: hero_stream.Stream, @chain: [u8], chain_count: u64, @key: [u8], key_count: u64, protocols: str) -> hero_stream.Stream
    return hero_tls_server(
        inner,
        chain: @chain,
        chain_count: chain_count,
        key: @key,
        key_count: key_count,
        protocols: protocols.cstr()
    )

# The version of TLS `s` speaks, 12 or 13, or -1 where `s` is no open TLS
# stream.
function version(s: hero_stream.Stream) -> i64
    return hero_tls_version(s)

# The length of the application protocol `s` chose, its name written into
# `buffer`'s first bytes with a zero after it: 0 where none was chosen, -1
# where `s` is no open TLS stream or `count` is below
# `HERO_TLS_PROTOCOL_MOST`.
function protocol(s: hero_stream.Stream, @buffer: [u8], count: u64) -> i64
    return hero_tls_protocol(s, @buffer, count: count)

# 0, or -1: every read or write of `s`, a TLS stream, that waits ends by
# `ms` milliseconds from now, failing `HERO_STREAM_TIMED_OUT`, a read already
# waiting included.
#
# - `s`: a TLS stream; it stays open.
# - `ms`: milliseconds from now; 0 a deadline already passed, so every read
#   or write that would wait ends at once; `HERO_TLS_FOREVER` takes the
#   deadline away; below -1 fails `HERO_TLS_INVALID`.
function set_deadline(s: hero_stream.Stream, ms: i64) -> i64
    return hero_tls_set_deadline(s, ms: ms)

# 0, or -1: every `accept` waiting on `l` for a connection, and every later
# one, ends by `ms` milliseconds from now, failing `HERO_TLS_TIMED_OUT`.
#
# - `l`: the listener; it stays open.
# - `ms`: milliseconds from now; 0 a deadline already passed, so an accept
#   with no connection waiting ends at once; `HERO_TLS_FOREVER` takes the
#   deadline away; below -1 fails `HERO_TLS_INVALID`.
function set_accept_deadline(l: Listener, ms: i64) -> i64
    return hero_tls_set_accept_deadline(l, ms: ms)

# The kind of the last call's failure on this thread, `HERO_TLS_OK` after a
# call that did not fail.
function last_error() -> i64
    return hero_tls_last_error()

# The platform's own number for the last call's failure, 0 where the layer
# itself refused.
function last_os_error() -> i64
    return hero_tls_last_os_error()

# The length of the last failure's words, written into `buffer`'s first
# bytes with a zero after them and cut where a character ends, or -1 where
# `count` is 0.
function last_message(@buffer: [u8], count: u64) -> i64
    return hero_tls_last_message(@buffer, count: count)

## Tests

test "available answers 1 or 0, and 1 on a machine with the platform's TLS"
    assert available() == 1 || available() == 0

test "connect refuses what it cannot read before any connection: no host, a port of 0 or past 65535, a time below -1, checks of neither kind, an empty protocol name"
    roots: [u8] @= []
    a = connect(host: "", port: 443, ms: 0, @roots, roots_count: 0, protocols: "", checks: HERO_TLS_CHECK_ALL)
    assert a == nullptr
    assert last_error() == HERO_TLS_INVALID
    b = connect(host: "localhost", port: 0, ms: 0, @roots, roots_count: 0, protocols: "", checks: HERO_TLS_CHECK_ALL)
    assert b == nullptr
    assert last_error() == HERO_TLS_INVALID
    c = connect(
        host: "localhost",
        port: 65536,
        ms: 0,
        @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL
    )
    assert c == nullptr
    assert last_error() == HERO_TLS_INVALID
    d = connect(
        host: "localhost",
        port: 443,
        ms: -2,
        @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL
    )
    assert d == nullptr
    assert last_error() == HERO_TLS_INVALID
    e = connect(host: "localhost", port: 443, ms: 0, @roots, roots_count: 0, protocols: "", checks: 0)
    assert e == nullptr
    assert last_error() == HERO_TLS_INVALID
    f = connect(
        host: "localhost",
        port: 443,
        ms: 0,
        @roots,
        roots_count: 0,
        protocols: "h2,,http/1.1",
        checks: HERO_TLS_CHECK_ALL
    )
    assert f == nullptr
    assert last_error() == HERO_TLS_INVALID

test "connect to a port nothing listens on fails refused, and roots that hold no certificate fail invalid"
    probe @= hero_net.listen(address: "127.0.0.1", port: 0)
    port = hero_net.port_of(probe)
    assert hero_net.close(@probe) == 0
    roots: [u8] @= []
    gone = connect(
        host: "127.0.0.1",
        port: port,
        ms: 15000,
        @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL
    )
    assert gone == nullptr

    if available() == 1
        assert last_error() == HERO_TLS_REFUSED
    junk: [u8] @= [110, 111]
    bad = connect(
        host: "127.0.0.1",
        port: port,
        ms: 15000,
        @junk,
        roots_count: 2,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL
    )
    assert bad == nullptr
    assert last_error() == HERO_TLS_INVALID || last_error() == HERO_TLS_UNSUPPORTED

test "listen refuses PEM with no certificate, PEM with no key, and a port past 65535, saying why"
    junk: [u8] @= [110, 111, 116, 32, 80, 69, 77]
    other: [u8] @= [110, 111, 116, 32, 80, 69, 77]
    a = listen(address: "127.0.0.1", port: 0, chain: @junk, chain_count: 7, key: @other, key_count: 7, protocols: "")
    assert a == nullptr
    assert last_error() == HERO_TLS_INVALID || last_error() == HERO_TLS_UNSUPPORTED
    words: [u8] @= []
    length = last_message(@words, count: 256)
    assert length > 0
    b = listen(
        address: "127.0.0.1",
        port: 70000,
        chain: @junk,
        chain_count: 7,
        key: @other,
        key_count: 7,
        protocols: ""
    )
    assert b == nullptr
    assert last_error() == HERO_TLS_INVALID

test "close_listener and port_of of a listener that is none fail not open"
    l: Listener @= nullptr
    assert port_of(l) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    assert close_listener(@l) == -1
    assert last_error() == HERO_TLS_NOT_OPEN

test "version and protocol of a stream that is no TLS stream fail not open, and protocol refuses a short buffer"
    out_end: hero_stream.Stream @= nullptr
    in_end: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @out_end, writer: @in_end) == 0
    assert version(out_end) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    name: [u8] @= []
    assert protocol(out_end, @name, count: HERO_TLS_PROTOCOL_MOST) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    assert protocol(out_end, @name, count: 8) == -1
    assert last_error() == HERO_TLS_INVALID
    assert hero_stream.close(@out_end) == 0
    assert hero_stream.close(@in_end) == 0

test "last_message refuses a buffer of no bytes"
    words: [u8] @= []
    assert last_message(@words, count: 0) == -1
    assert last_error() == HERO_TLS_INVALID

test "client over a pipe's reading end makes no stream and leaves the pipe the caller's: unsupported on macOS, its first write refused elsewhere"
    out_end: hero_stream.Stream @= nullptr
    in_end: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @out_end, writer: @in_end) == 0
    roots: [u8] @= []
    made = client(@out_end, host: "localhost", @roots, roots_count: 0, protocols: "", checks: HERO_TLS_CHECK_ALL)
    assert made == nullptr
    assert last_error() != HERO_TLS_OK
    assert hero_stream.close(@out_end) == 0
    assert hero_stream.close(@in_end) == 0

test "connect_after refuses steps not in the header's form before any connection: a kind it does not know, a step of no bytes, a head cut short, a step running past the end, a line's beginning past 64 bytes"
    roots: [u8] @= []
    unknown: [u8] @= [9, 0, 0, 0, 1, 65]
    a = connect_after(
        host: "localhost",
        port: 443,
        ms: 0,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @unknown,
        steps_count: 6
    )
    assert a == nullptr
    assert last_error() == HERO_TLS_INVALID
    empty: [u8] @= [1, 0, 0, 0, 0]
    b = connect_after(
        host: "localhost",
        port: 443,
        ms: 0,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @empty,
        steps_count: 5
    )
    assert b == nullptr
    assert last_error() == HERO_TLS_INVALID
    short: [u8] @= [1, 0, 0]
    c = connect_after(
        host: "localhost",
        port: 443,
        ms: 0,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @short,
        steps_count: 3
    )
    assert c == nullptr
    assert last_error() == HERO_TLS_INVALID
    past: [u8] @= [2, 0, 0, 0, 9, 83]
    d = connect_after(
        host: "localhost",
        port: 443,
        ms: 0,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @past,
        steps_count: 6
    )
    assert d == nullptr
    assert last_error() == HERO_TLS_INVALID
    long_prefix: [u8] @= [3, 0, 0, 0, 65]

    for _ in range(from: 0, to: 65)
        long_prefix @ long_prefix.push(65)

    e = connect_after(
        host: "localhost",
        port: 443,
        ms: 0,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @long_prefix,
        steps_count: 70
    )
    assert e == nullptr
    assert last_error() == HERO_TLS_INVALID
    words: [u8] @= []
    assert last_message(@words, count: 640) > 0

test "connect_after with steps in their form to a port nothing listens on fails refused, as connect does"
    probe @= hero_net.listen(address: "127.0.0.1", port: 0)
    port = hero_net.port_of(probe)
    assert hero_net.close(@probe) == 0
    roots: [u8] @= []
    steps: [u8] @= [1, 0, 0, 0, 1, 65, 2, 0, 0, 0, 1, 83]
    gone = connect_after(
        host: "127.0.0.1",
        port: port,
        ms: 15000,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_ALL,
        steps: @steps,
        steps_count: 12
    )
    assert gone == nullptr

    if available() == 1
        assert last_error() == HERO_TLS_REFUSED

test "listen_after refuses steps not in their form before it listens"
    chain: [u8] @= [110]
    key: [u8] @= [110]
    steps: [u8] @= [7, 0, 0, 0, 1, 65]
    l = listen_after(
        address: "127.0.0.1",
        port: 0,
        chain: @chain,
        chain_count: 1,
        key: @key,
        key_count: 1,
        protocols: "",
        steps: @steps,
        steps_count: 6
    )
    assert l == nullptr
    assert last_error() == HERO_TLS_INVALID

test "set_deadline and set_accept_deadline: a stream that is no TLS stream and a listener that is none fail not open, a time below -1 invalid"
    out_end: hero_stream.Stream @= nullptr
    in_end: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @out_end, writer: @in_end) == 0
    assert set_deadline(out_end, ms: 100) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    assert set_deadline(out_end, ms: HERO_TLS_FOREVER) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    assert set_deadline(out_end, ms: -2) == -1
    assert last_error() == HERO_TLS_INVALID
    none: Listener = nullptr
    assert set_accept_deadline(none, ms: 100) == -1
    assert last_error() == HERO_TLS_NOT_OPEN
    assert hero_stream.close(@out_end) == 0
    assert hero_stream.close(@in_end) == 0

## Tests of the times 0 and HERO_TLS_FOREVER (2026-11-20, M-rebel-library step 83a)

# Milliseconds since `began`, a reading of `hero_time.monotonic_ns`.
#
# - `began`: the clock's reading the span starts at.
function test_ms_since(began: i64) -> i64
    return (hero_time.monotonic_ns() - began) / 1000000

# The bytes of `b` as the floor's counts take them.
#
# - `b`: the bytes.
function test_count(b: [u8]) -> u64
    return b.len().to_u64().must()

# A listener on 127.0.0.1 presenting the test authority's certificate for
# `localhost` and `127.0.0.1`, or `nullptr`.
function test_listener() -> Listener
    chain: [u8] @= bytes.from_text(fixture.LOCALHOST_CHAIN)
    key: [u8] @= bytes.from_text(fixture.LOCALHOST_KEY)
    return listen(
        address: "127.0.0.1",
        port: 0,
        chain: @chain,
        chain_count: test_count(chain),
        key: @key,
        key_count: test_count(key),
        protocols: ""
    )

# A connection to the test listener at `port` checking nothing, within 15
# seconds, or `nullptr`.
#
# - `port`: the listener's port.
function test_unchecked(port: i64) -> hero_stream.Stream
    roots: [u8] @= []
    return connect(
        host: "127.0.0.1",
        port: port,
        ms: 15000,
        @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_NOTHING_FOR_TESTS
    )

# What a patient client's call answered, on its thread: 0 where it failed
# for another reason than its time, no sooner than 250 ms after `began`; 1
# where it made a stream, which is closed, 2 where it timed out, 3 where it
# ended sooner.
#
# - `made`: what the call answered, closed here where it is a stream.
# - `began`: the clock's reading before the call.
function test_patience(@made: hero_stream.Stream, began: i64) -> i64
    if made != nullptr
        _ = hero_stream.close(@made)
        return 1

    if last_error() == HERO_TLS_TIMED_OUT
        return 2

    if test_ms_since(began) < 250
        return 3
    return 0

# The client of a server that never speaks TLS, on a thread of its own: a
# connection to 127.0.0.1 at `port` with no limit of time, its handshake
# waiting for the server's answer until the server closes, 300 ms after it
# took the connection. What it answers is `test_patience`'s.
#
# - `port`: the port the server listens on.
function test_patient_client(port: i64) -> i64
    roots: [u8] @= []
    began = hero_time.monotonic_ns()
    made @= connect(
        host: "127.0.0.1",
        port: port,
        ms: HERO_TLS_FOREVER,
        @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_NOTHING_FOR_TESTS
    )
    return test_patience(@made, began: began)

# `test_patient_client` with an exchange before TLS, `hi` sent and `ok`
# expected, which the server never answers.
#
# - `port`: the port the server listens on.
function test_patient_steps(port: i64) -> i64
    roots: [u8] @= []
    steps: [u8] @= [1, 0, 0, 0, 2, 104, 105, 2, 0, 0, 0, 2, 111, 107]
    began = hero_time.monotonic_ns()
    made @= connect_after(
        host: "127.0.0.1",
        port: port,
        ms: HERO_TLS_FOREVER,
        roots: @roots,
        roots_count: 0,
        protocols: "",
        checks: HERO_TLS_CHECK_NOTHING_FOR_TESTS,
        steps: @steps,
        steps_count: 14
    )
    return test_patience(@made, began: began)

# A plain TCP server for a patient client, on the test's own thread: it
# takes the client's connection on `plain`, holds it 300 ms answering
# nothing, and closes it.
#
# - `plain`: a listener of `hero_net`; it stays open.
function test_hold_and_close(plain: hero_net.Socket)
    taken @= hero_net.accept(plain)
    assert taken != nullptr
    assert hero_time.sleep_ns(300000000) == 0
    assert hero_net.close(@taken) == 0

# A plain TCP client on a thread of its own: it takes back the connection
# `n` names, holds it 300 ms sending nothing, and closes it. 0 where every
# step held, else the step that did not.
#
# - `n`: the number the connection was given up for.
function test_close_late(n: i64) -> i64
    s @= hero_net.of(n)

    if s == nullptr
        return 1
    slept = hero_time.sleep_ns(300000000)

    if hero_net.close(@s) != 0
        return 2

    if slept != 0
        return 3
    return 0

# A client of the test listener at `port`, on a thread of its own: once
# connected it waits 400 ms, writes one byte, 42, and reads until the server
# closes, then closes. 0 where every step held, else the step that did not.
#
# - `port`: the listener's port.
function test_late_byte(port: i64) -> i64
    s @= test_unchecked(port)

    if s == nullptr
        return 1
    answer: i64 @= 0
    late: [u8] @= [42]

    if hero_time.sleep_ns(400000000) != 0
        answer @ 2
    else if hero_stream.write(s, @late, n: 1) != 1
        answer @ 3
    else
        rest: [u8] @= []
        _ = hero_stream.read(s, @rest, n: 8)

    if hero_stream.close(@s) != 0 && answer == 0
        answer @ 4
    return answer

# A client of the test listener at `port`, on a thread of its own, coming
# 300 ms late: it connects, reads until the server closes, and closes. 0
# where every step held, else the step that did not.
#
# - `port`: the listener's port.
function test_late_client(port: i64) -> i64
    if hero_time.sleep_ns(300000000) != 0
        return 1
    s @= test_unchecked(port)

    if s == nullptr
        return 2
    rest: [u8] @= []
    _ = hero_stream.read(s, @rest, n: 8)

    if hero_stream.close(@s) != 0
        return 3
    return 0

# THE TIME 0 AND `HERO_TLS_FOREVER` of a connection (step 83a): with no
# limit the handshake waits for a server that never answers until it closes,
# and fails for that, not its time; with 0 the call fails timed out at once.
test "connect: HERO_TLS_FOREVER waits for the server's handshake until it closes, and 0 waits not at all, timed out at once"
    if available() == 1
        plain @= hero_net.listen(address: "127.0.0.1", port: 0)
        port = hero_net.port_of(plain)
        why: i64 @= 0
        far = threads_floor.start(test_patient_client, arg: port, bytes: 0, why: @why)
        assert far >= 0
        test_hold_and_close(plain)
        assert threads_floor.finish(far) == 0
        roots: [u8] @= []
        began = hero_time.monotonic_ns()
        quick = connect(
            host: "127.0.0.1",
            port: port,
            ms: 0,
            @roots,
            roots_count: 0,
            protocols: "",
            checks: HERO_TLS_CHECK_NOTHING_FOR_TESTS
        )
        assert quick == nullptr
        assert last_error() == HERO_TLS_TIMED_OUT
        assert test_ms_since(began) < 2000
        assert hero_net.close(@plain) == 0

# The same of the exchange before TLS (step 83a): with no limit the step
# that expects `ok` waits until the server closes, and with 0 the call fails
# timed out at once.
test "connect_after: HERO_TLS_FOREVER waits for a step's answer until the server closes, and 0 waits not at all, timed out at once"
    if available() == 1
        plain @= hero_net.listen(address: "127.0.0.1", port: 0)
        port = hero_net.port_of(plain)
        why: i64 @= 0
        far = threads_floor.start(test_patient_steps, arg: port, bytes: 0, why: @why)
        assert far >= 0
        test_hold_and_close(plain)
        assert threads_floor.finish(far) == 0
        roots: [u8] @= []
        steps: [u8] @= [1, 0, 0, 0, 2, 104, 105, 2, 0, 0, 0, 2, 111, 107]
        began = hero_time.monotonic_ns()
        quick = connect_after(
            host: "127.0.0.1",
            port: port,
            ms: 0,
            roots: @roots,
            roots_count: 0,
            protocols: "",
            checks: HERO_TLS_CHECK_NOTHING_FOR_TESTS,
            steps: @steps,
            steps_count: 14
        )
        assert quick == nullptr
        assert last_error() == HERO_TLS_TIMED_OUT
        assert test_ms_since(began) < 2000
        assert hero_net.close(@plain) == 0

# THE TIME 0 AND `HERO_TLS_FOREVER` of an accept's handshake (step 83a): with
# 0 a client that connected fails its handshake timed out at once; with no
# limit the handshake waits for a client that sends nothing until it closes,
# 300 ms later, and fails for that, not its time.
test "accept: 0 fails a client's handshake at once, timed out, and HERO_TLS_FOREVER waits for it until the client closes"
    if available() == 1
        l @= test_listener()
        assert l != nullptr
        port = port_of(l)
        quiet @= hero_net.connect(address: "127.0.0.1", port: port)
        assert quiet != nullptr
        began = hero_time.monotonic_ns()
        hurried = accept(l, ms: 0)
        assert hurried == nullptr
        assert last_error() == HERO_TLS_TIMED_OUT
        assert test_ms_since(began) < 2000
        assert hero_net.close(@quiet) == 0
        silent @= hero_net.connect(address: "127.0.0.1", port: port)
        assert silent != nullptr
        n = hero_net.number(@silent)
        why: i64 @= 0
        closer = threads_floor.start(test_close_late, arg: n, bytes: 0, why: @why)
        assert closer >= 0
        patient = accept(l, ms: HERO_TLS_FOREVER)
        assert patient == nullptr
        assert last_error() != HERO_TLS_TIMED_OUT && last_error() != HERO_TLS_OK
        assert threads_floor.finish(closer) == 0
        assert close_listener(@l) == 0

# THE TIME 0 AND `HERO_TLS_FOREVER` of a TLS stream's deadline (step 83a): 0
# ends a read with nothing come at once, well before the byte the client
# writes 400 ms after it connected; `HERO_TLS_FOREVER` takes the deadline
# away, and the next read waits for that byte.
test "set_deadline: 0 ends a read of a TLS stream at once, before a byte written 400 ms later, and HERO_TLS_FOREVER waits for that byte"
    if available() == 1
        l @= test_listener()
        assert l != nullptr
        why: i64 @= 0
        far = threads_floor.start(test_late_byte, arg: port_of(l), bytes: 0, why: @why)
        assert far >= 0
        s @= accept(l, ms: 15000)
        assert s != nullptr
        assert set_deadline(s, ms: 0) == 0
        into: [u8] @= []
        assert hero_stream.read(s, @into, n: 8) == -1
        assert hero_stream.last_error() == hero_stream.HERO_STREAM_TIMED_OUT
        assert set_deadline(s, ms: HERO_TLS_FOREVER) == 0
        assert hero_stream.read(s, @into, n: 8) == 1
        assert into[0] == 42
        assert hero_stream.close(@s) == 0
        assert threads_floor.finish(far) == 0
        assert close_listener(@l) == 0

# THE TIME 0 AND `HERO_TLS_FOREVER` of the wait for a client (step 83a): 0
# ends an accept with no client at once; `HERO_TLS_FOREVER` takes the
# deadline away, and the next accept waits for a client that comes 300 ms
# later.
test "set_accept_deadline: 0 ends an accept with no client at once, timed out, and HERO_TLS_FOREVER waits for a client that comes 300 ms later"
    if available() == 1
        l @= test_listener()
        assert l != nullptr
        assert set_accept_deadline(l, ms: 0) == 0
        began = hero_time.monotonic_ns()
        none = accept(l, ms: 15000)
        assert none == nullptr
        assert last_error() == HERO_TLS_TIMED_OUT
        assert test_ms_since(began) < 2000
        assert set_accept_deadline(l, ms: HERO_TLS_FOREVER) == 0
        why: i64 @= 0
        far = threads_floor.start(test_late_client, arg: port_of(l), bytes: 0, why: @why)
        assert far >= 0
        s @= accept(l, ms: 15000)
        assert s != nullptr
        assert hero_stream.close(@s) == 0
        assert threads_floor.finish(far) == 0
        assert close_listener(@l) == 0
