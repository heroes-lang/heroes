# TrueType fonts embedded in a document: a font read once (`Face`), the glyphs
# a document has drawn with it (`Slot`), and what the text and page layers ask
# of it: the glyph a character has, its width in thousandths of the font's
# size as the file's `/W` array writes it, and the measures of the font as a
# whole. The font's own glyph numbers are the codes the page shows, two bytes
# each (`/Encoding /Identity-H`), so a text is final when it is drawn.

use bytes
use font as sfnt
use pdf/internal/codes
use pdf/internal/font_samples
use pdf/internal/metrics

# A font read, ready to be embedded. Immutable: the face's `Font` holds it.
record Face
    # The font, read.
    file: sfnt.Font
    # The bytes it was read from and the number of the font in them: what
    # tells two faces apart.
    data: [u8]
    index: i64
    # The name the font has in a file: its PostScript name where it has one,
    # reduced to letters, digits and `-`, `_` and `.`.
    name: str
    # The font units to the em.
    units: i64
    # The glyph of the space, -1 where the font has none.
    space: i64

# A face in a document, and the glyphs drawn with it so far.
record Slot
    # The face.
    face: Face
    # The glyphs drawn, by their number in the font.
    used: {i64: bool}

# The licence bits of `OS/2`'s `fsType` that bar embedding: 0x0002 restricted
# licence, 0x0100 no subsetting.
function barred(flags: i64) -> bool
    return flags & 0x0002 != 0 || flags & 0x0100 != 0

# The `fsType` of the font, 0 where it has no `OS/2` table.
function embedding_flags(file: sfnt.Font lent) -> i64
    match sfnt.table_of(file, tag: "OS/2")
        .err _ => return 0
        .ok t =>
            if t.len() < 10
                return 0
            return to_i64(t[8]).must() * 256 + to_i64(t[9]).must()

# `name` with every byte that is not a letter, a digit or one of `-`, `_` and
# `.` dropped, at most 100 bytes of it.
function clean(name: str) -> str
    out: [str] @= []

    for b in bytes.from_text(name)
        letter = b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '-' || b == '_' || b == '.'

        if out.len() < 100 && letter
            out @ out.push(bytes.to_text_lossy([b]))

    return out.join("")

# The font `index` of the file `data`, read to be embedded.
#
# Fails with `font`'s codes where the file is not a font; `unsupported` where
# its outlines are CFF's (only TrueType's are cut down), where it has no
# `cmap` that is read, or where its `OS/2` table bars embedding or subsetting.
function load(data: [u8], index: i64) -> Face?
    file = sfnt.parse(data, index: index)?

    if sfnt.outlines_of(file) == .postscript
        return codes.unsupported(
            why: "a font with CFF outlines: only fonts with TrueType outlines (glyf) are embedded, a CFF font cannot be cut down yet"
        )
    flags = embedding_flags(file)

    if barred(flags)
        return codes.unsupported(
            why: f"the font's licence bars embedding it or cutting it down (OS/2 fsType {flags}); it is not embedded"
        )

    space = match sfnt.glyph_of(file, code_point: 32)
        .ok g => g
        .err e =>
            if e.code == sfnt.UNSUPPORTED
                return codes.unsupported(why: e.msg)
            -1

    named @= clean(sfnt.name_of(file, id: .postscript_name).default(""))

    if named == ""
        named @ clean(sfnt.name_of(file, id: .full_name).default(""))

    if named == ""
        named @ "EmbeddedFont"
    return ok(
        Face(file: file, data: data, index: index, name: named, units: sfnt.metrics_of(file).units_per_em, space: space)
    )

# Whether `a` and `b` are the same font of the same file.
function same(a: Face lent, b: Face lent) -> bool
    return a.index == b.index && a.data == b.data

# The glyph the character `point` has in the face, -1 where it has none.
function glyph_of(face: Face lent, point: i64) -> i64
    return sfnt.glyph_of(face.file, code_point: point).default(-1)

# `v` font units in thousandths of the em, rounded to the nearest.
function scaled(v: i64, units: i64) -> i64
    if v < 0
        return -((-v * 1000 + units / 2) / units)
    return (v * 1000 + units / 2) / units

# The width of glyph `glyph` in thousandths of the em, 0 for a number the font
# does not have.
function width_of(face: Face lent, glyph: i64) -> i64
    return scaled(v: sfnt.advance_of(face.file, glyph: glyph).default(0), units: face.units)

# The height of the capitals in font units: `OS/2`'s where it says, else the
# top of the glyph of `H`, else 0.
function cap_height_of(face: Face lent) -> i64
    declared = sfnt.metrics_of(face.file).cap_height.default(0)

    if declared > 0
        return declared
    h = glyph_of(face, point: 72)

    if h < 0
        return 0

    match sfnt.bounds_of(face.file, glyph: h)
        .ok b  => return to_i64(b.top).default(0)
        .err _ => return 0

# The measures of the face in thousandths of the em, as the font descriptor
# of a file writes them. The stem is an estimate from the weight class, which
# no table of a TrueType font gives.
function global_of(face: Face lent) -> metrics.Global
    m = sfnt.metrics_of(face.file)
    u = face.units
    return metrics.Global(
        ascent: scaled(v: m.ascent, units: u),
        descent: scaled(v: m.descent, units: u),
        cap_height: scaled(v: cap_height_of(face), units: u),
        x_height: scaled(v: m.x_height.default(0), units: u),
        italic_angle: m.italic_angle,
        underline_position: scaled(v: m.underline_position, units: u),
        underline_thickness: scaled(v: m.underline_thickness, units: u),
        box: [scaled(v: m.box_left, units: u), scaled(v: m.box_bottom, units: u), scaled(v: m.box_right, units: u), scaled(v: m.box_top, units: u)],
        stem: 50 + m.weight * m.weight / 4225
    )

# What fontTools 4.68.0 reads from the sample: the name, the scale, the glyph of
# the space, a letter's glyph and advance.
test "load: the sample's name, scale, space, glyphs and widths"
    face = load(font_samples.noto_sans(), index: 0).must()
    assert face.name == "NotoSans-Regular" && face.units == 1000 && face.space == 1
    assert glyph_of(face, point: 65) == 34 && glyph_of(face, point: 0x142) == 115 && glyph_of(face, point: 0x3b1) == 171
    assert glyph_of(face, point: 0x4e2d) == -1 && glyph_of(face, point: 0x5) == -1
    assert width_of(face, glyph: 34) == 639 && width_of(face, glyph: 115) == 258 && width_of(face, glyph: 1) == 260
    assert width_of(face, glyph: 5000) == 0 && width_of(face, glyph: -1) == 0

# The font's measures in thousandths: here the em is 1000 units, so they stand.
test "global_of: ascent, descent, heights, box, slant, underline and the stem estimate"
    g = global_of(load(font_samples.noto_sans(), index: 0).must())
    assert g.ascent == 1069 && g.descent == -293 && g.cap_height == 714 && g.x_height == 536
    assert g.box == [-621, -389, 2800, 1067] && g.italic_angle == 0.0
    assert g.underline_position == -100 && g.underline_thickness == 50 && g.stem == 87

# A scale that is not 1000 rounds to the nearest thousandth, away from zero at a half.
test "scaled: 2048 units to the em, a half, a negative"
    assert scaled(v: 639, units: 2048) == 312 && scaled(v: 0, units: 2048) == 0
    assert scaled(v: 1, units: 2048) == 0 && scaled(v: 2, units: 2048) == 1 && scaled(v: -2, units: 2048) == -1
    assert scaled(v: -1229, units: 2048) == -600 && scaled(v: 2048, units: 2048) == 1000

# Bytes that are no font, a font with CFF outlines and a font whose licence bars it.
test "load: no font, CFF outlines, a restricted licence, no subsetting; a font that may be embedded"
    assert load([1, 2, 3], index: 0).is_err()
    assert load(font_samples.noto_sans(), index: 1).is_err()

    match load(font_samples.cff(), index: 0)
        .ok _  => assert false
        .err e => assert e.code == "unsupported" && e.msg == "a font with CFF outlines: only fonts with TrueType outlines (glyf) are embedded, a CFF font cannot be cut down yet"

    match load(font_samples.with_licence(2), index: 0)
        .ok _  => assert false
        .err e => assert e.code == "unsupported" && e.msg == "the font's licence bars embedding it or cutting it down (OS/2 fsType 2); it is not embedded"

    assert load(font_samples.with_licence(0x100), index: 0).is_err()
    assert !load(font_samples.with_licence(4), index: 0).is_err()
    assert !load(font_samples.with_licence(8), index: 0).is_err()

test "barred and clean: the two bits, a name reduced"
    assert !barred(0) && barred(2) && !barred(4) && !barred(8) && barred(0x100) && barred(0x102)
    assert clean("Noto Sans (Regular)-1_a.b") == "NotoSansRegular-1_a.b"
    assert clean("é/ü") == ""
    assert clean(repeat("a", 300)).len() == 100

test "same: one font twice, another file"
    a = load(font_samples.noto_sans(), index: 0).must()
    assert same(a: a, b: load(font_samples.noto_sans(), index: 0).must())
    assert !same(a: a, b: load(font_samples.with_licence(4), index: 0).must())
