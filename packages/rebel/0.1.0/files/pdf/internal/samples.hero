# PDF files to test with, made on 2026-11-18 by ReportLab 5.1 and pypdf 7.1.1
# (from their wheels, run outside the tree) and by Ghostscript 10.08,
# written as hexadecimal text. What Poppler's pdftotext 26.11 and pypdf read
# from each is what the tests expect. No program calls the script that made
# them.

use bytes

# ReportLab 5.1, one page in Helvetica and Times, its information set.
constant SMALL: str
    ""

# ReportLab 5.1, encrypted with RC4 of 40 bits, user password "user", owner password "owner".
constant RC4_40: str
    ""

# ReportLab 5.1, encrypted with RC4 of 128 bits, no user password.
constant RC4_128: str
    ""

# pypdf 7.1.1 encrypting SMALL with AES of 128 bits.
constant AES_128: str
    ""

# pypdf 7.1.1 appending to SMALL an update that sets the title and turns the page.
constant INCREMENTAL: str
    ""

# pypdf 7.1.1 adding to SMALL a second page, an outline of three bookmarks, a link and a named destination.
constant OUTLINE: str
    ""

# Ghostscript 10.08 rewriting SMALL with object streams and a cross-reference stream.
constant OBJECT_STREAMS: str
    ""

# Ghostscript 10.08 rendering a corner of a page as a baseline JPEG of 8 by 6 pixels in colour, its APP segments past the first dropped.
constant JPEG: str
    ""

# Ghostscript 10.08 rendering a corner of a page as a PNG of 3 by 2 pixels, RGB with alpha.
constant PNG: str
    ""

# The bytes `hex` writes. Aborts on text that is not hexadecimal, which
# none of the constants above is.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()
