# A stream's filters undone (ISO 32000-1:2008 section 7.4): FlateDecode and
# LZWDecode with their predictors, ASCIIHexDecode, ASCII85Decode and
# RunLengthDecode, in the order the stream names them. A FlateDecode stream
# cut short or with a wrong checksum gives what it holds before the fault,
# as readers of PDF do; every output is bounded by a limit.

use compress
use pdf/internal/codes
use pdf/internal/model

# The filters a stream's dictionary names, in order, and the parameters of
# each, the null object where none.
record Chain
    # The filters' names.
    names: [str]
    # Their parameters, one each.
    params: [model.Obj]

# The chain `entries` names under `Filter` and `DecodeParms`, or under the
# short keys of an inline image, `F` and `DP`.
function chain_of(entries: {str: model.Obj}) -> Chain
    named = entries["Filter"].default(entries["F"].default(.null_value))
    params = entries["DecodeParms"].default(entries["DP"].default(.null_value))
    names: [str] @= []
    each: [model.Obj] @= []

    match named
        .name n =>
            names @ names.push(n.value)
            each @ each.push(params)
        .array a =>
            i @= 0

            for item in a.items
                names @ names.push(model.name_or_empty(item))

                p: model.Obj = match params
                    .array pa =>
                        if i < pa.items.len()
                            pa.items[i]
                        else
                            .null_value
                    .null_value | .boolean _ | .integer _ | .real _ | .text _ | .name _ | .dict _ | .stream _ | .reference _ => params

                each @ each.push(p)
                i @ i + 1
        .null_value | .boolean _ | .integer _ | .real _ | .text _ | .dict _ | .stream _ | .reference _ => _ = 0

    return Chain(names: names, params: each)

# Whether `name` is a filter of images, whose bytes this package passes on
# and never decodes.
function is_image_filter(name: str) -> bool
    return name == "DCTDecode" || name == "DCT" || name == "JPXDecode" || name == "JBIG2Decode" || name == "CCITTFaxDecode" || name == "CCF"

# `data` with every filter of `entries` undone, at most `limit` bytes.
#
# Fails `invalid` where the bytes are not what a filter reads, `limit`
# where they decode past `limit`, `unsupported` on a filter of images or
# one PDF does not name.
function decode(entries: {str: model.Obj}, data: [u8], limit: i64) -> [u8]?
    chain = chain_of(entries)
    out @= data
    i @= 0

    while i < chain.names.len()
        name = chain.names[i]
        params = chain.params[i]

        if name == "FlateDecode" || name == "Fl"
            out @ predict(flate(out, limit: limit)?, params: params, limit: limit)?
        else if name == "LZWDecode" || name == "LZW"
            early = model.integer_or(model.entry(params, key: "EarlyChange"), fallback: 1)
            out @ predict(lzw(out, early: early != 0, limit: limit)?, params: params, limit: limit)?
        else if name == "ASCIIHexDecode" || name == "AHx"
            out @ ascii_hex(out)?
        else if name == "ASCII85Decode" || name == "A85"
            out @ ascii85(out)?
        else if name == "RunLengthDecode" || name == "RL"
            out @ run_length(out, limit: limit)?
        else if name == "Crypt"
            if model.name_or_empty(model.entry(params, key: "Name")) != "Identity" && model.entry(params, key: "Name") != .null_value
                return codes.unsupported(why: "a stream names a crypt filter other than Identity")
        else if is_image_filter(name)
            return codes.unsupported(
                why: f"a stream is coded by {name}, a filter of images: its bytes are passed on as they are, never decoded"
            )
        else
            return codes.unsupported(why: f"a stream names the filter \"{name}\", which PDF does not define")

        if out.len() > limit
            return codes.over(what: "the bytes of a stream", most: limit)
        i @ i + 1

    return ok(out)

# `data` inflated as zlib, or as raw DEFLATE after a broken header; where
# the stream is cut short or its checksum is wrong, the bytes before the
# fault.
function flate(data: [u8], limit: i64) -> [u8]?
    match compress.decompress_leading(data, format: .zlib, limit: limit)
        .ok whole => return ok(whole.data)
        .err e =>
            if e.code == compress.LIMIT
                return codes.over(what: "the bytes of a stream", most: limit)

    body = if data.len() >= 2 && (to_i64(data[0]).must() * 256 + to_i64(data[1]).must()) % 31 == 0 && data[0] % 16 == 8
        data.slice(from: 2, to: data.len())
    else
        data
    d @= compress.decompressor(.raw, limit: limit)
    got: [u8] @= []
    input @= body

    while true
        match compress.decompress_part(@d, data: input, most: 65536)
            .ok part =>
                if part.len() == 0
                    break

                for b in part
                    got @ got.push(b)
            .err e =>
                if e.code == compress.LIMIT
                    return codes.over(what: "the bytes of a stream", most: limit)
                break

        input @ []

        if compress.is_decompressor_ended(d)
            break

    if got.len() == 0 && data.len() > 0
        return codes.invalid(why: "a FlateDecode stream holds no DEFLATE data")
    return ok(got)

# The bytes of a predictor's rows undone, as `params` says: PNG's (10 to
# 15) or TIFF's (2), its colours, bits and columns; `data` as it is for 1
# or none.
function predict(data: [u8], params: model.Obj, limit: i64) -> [u8]?
    predictor = model.integer_or(model.entry(params, key: "Predictor"), fallback: 1)

    if predictor <= 1
        return ok(data)
    colors = model.integer_or(model.entry(params, key: "Colors"), fallback: 1)
    bits = model.integer_or(model.entry(params, key: "BitsPerComponent"), fallback: 8)
    columns = model.integer_or(model.entry(params, key: "Columns"), fallback: 1)

    if colors < 1 || colors > 32 || bits != 1 && bits != 2 && bits != 4 && bits != 8 && bits != 16 || columns < 1 || columns > 1000000
        return codes.invalid(
            why: f"a predictor's parameters are out of range: {colors} colours of {bits} bits, {columns} columns"
        )

    pixel = if colors * bits / 8 > 1
        colors * bits / 8
    else
        1
    row = (colors * bits * columns + 7) / 8

    if predictor == 2
        if bits != 8
            return codes.unsupported(why: f"TIFF's predictor over samples of {bits} bits")
        out: [u8] @= []
        i @= 0

        while i < data.len()
            end = if i + row < data.len()
                i + row
            else
                data.len()
            start = i

            while i < end
                v @= to_i64(data[i]).must()

                if i - start >= colors
                    v @ (v + to_i64(out[out.len() - colors]).must()) % 256
                out @ out.push(to_u8(v).must())
                i @ i + 1

        return ok(out)

    if predictor < 10 || predictor > 15
        return codes.invalid(why: f"the predictor {predictor} is none PDF names")
    out: [u8] @= []
    previous: [u8] @= []
    k @= 0

    while k < row
        previous @ previous.push(0)
        k @ k + 1

    i @= 0

    while i < data.len()
        kind = data[i]
        i @ i + 1
        current: [u8] @= []
        k @ 0

        while k < row && i < data.len()
            raw = to_i64(data[i]).must()

            left = if k >= pixel
                to_i64(current[k - pixel]).must()
            else
                0
            up = to_i64(previous[k]).must()

            corner = if k >= pixel
                to_i64(previous[k - pixel]).must()
            else
                0

            v = if kind == 0
                raw
            else if kind == 1
                raw + left
            else if kind == 2
                raw + up
            else if kind == 3
                raw + (left + up) / 2
            else if kind == 4
                raw + paeth(a: left, b: up, c: corner)
            else
                raw
            current @ current.push(to_u8(v % 256).must())
            i @ i + 1
            k @ k + 1

        if kind > 4
            return codes.invalid(why: f"a row of a PNG predictor names the filter {kind}")

        for b in current
            out @ out.push(b)

        if out.len() > limit
            return codes.over(what: "the bytes of a stream", most: limit)

        while current.len() < row
            current @ current.push(0)

        previous @ current

    return ok(out)

# PNG's Paeth predictor: of the left, upper and upper left bytes, the one
# nearest their sum less the corner.
function paeth(a: i64, b: i64, c: i64) -> i64
    p = a + b - c

    pa = if p > a
        p - a
    else
        a - p

    pb = if p > b
        p - b
    else
        b - p

    pc = if p > c
        p - c
    else
        c - p

    if pa <= pb && pa <= pc
        return a

    if pb <= pc
        return b
    return c

# `data` decoded as LZW, codes of 9 to 12 bits, the code width growing one
# code early where `early`.
function lzw(data: [u8], early: bool, limit: i64) -> [u8]?
    table: [[u8]] @= []
    out: [u8] @= []
    k @= 0

    while k < 256
        table @ table.push([to_u8(k).must()])
        k @ k + 1

    table @ table.push([])
    table @ table.push([])
    width @= 9
    bits @= 0
    held @= 0
    previous: [u8] @= []
    i @= 0

    shift = if early
        1
    else
        0

    while i < data.len()
        held @ held * 256 + to_i64(data[i]).must()
        bits @ bits + 8
        i @ i + 1

        while bits >= width
            code = held >> bits - width
            held @ held & (1 << bits - width) - 1
            bits @ bits - width

            if code == 256
                table @ table.slice(from: 0, to: 258)
                width @ 9
                previous @ []
                continue

            if code == 257
                return ok(out)
            entry: [u8] @= []

            if code < table.len()
                entry @ table[code]
            else if code == table.len() && previous.len() > 0
                entry @ previous
                entry @ entry.push(previous[0])
            else
                return codes.invalid(why: f"an LZW stream holds the code {code}, which its table does not")

            for b in entry
                out @ out.push(b)

            if out.len() > limit
                return codes.over(what: "the bytes of a stream", most: limit)

            if previous.len() > 0 && table.len() < 4096
                grown @= previous
                grown @ grown.push(entry[0])
                table @ table.push(grown)
            previous @ entry

            if table.len() + shift >= 1 << width && width < 12
                width @ width + 1

    return ok(out)

# `data` decoded as ASCIIHexDecode: pairs of digits up to `>`, whitespace
# skipped, an odd last digit followed by 0.
function ascii_hex(data: [u8]) -> [u8]?
    out: [u8] @= []
    high @= -1

    for b in data
        if b == '>'
            break

        if b == 0x00 || b == 0x09 || b == 0x0a || b == 0x0c || b == 0x0d || b == 0x20
            continue

        v = if b >= '0' && b <= '9'
            to_i64(b - '0').must()
        else if b >= 'a' && b <= 'f'
            to_i64(b - 'a').must() + 10
        else if b >= 'A' && b <= 'F'
            to_i64(b - 'A').must() + 10
        else
            -1

        if v < 0
            return codes.invalid(why: "an ASCIIHexDecode stream holds a byte that is no digit")

        if high < 0
            high @ v
        else
            out @ out.push(to_u8(high * 16 + v).must())
            high @ -1

    if high >= 0
        out @ out.push(to_u8(high * 16).must())
    return ok(out)

# `data` decoded as ASCII85Decode: groups of five digits from `!` to `u`,
# `z` for four zeros, up to `~>`, whitespace skipped.
function ascii85(data: [u8]) -> [u8]?
    out: [u8] @= []
    group: [i64] @= []

    for b in data
        if b == '~'
            break

        if b == 0x00 || b == 0x09 || b == 0x0a || b == 0x0c || b == 0x0d || b == 0x20
            continue

        if b == 'z' && group.len() == 0
            out @ out.push(0)
            out @ out.push(0)
            out @ out.push(0)
            out @ out.push(0)
            continue

        if b < '!' || b > 'u'
            return codes.invalid(why: "an ASCII85Decode stream holds a byte outside ! to u")
        group @ group.push(to_i64(b - '!').must())

        if group.len() == 5
            n = (((group[0] * 85 + group[1]) * 85 + group[2]) * 85 + group[3]) * 85 + group[4]

            if n > 4294967295
                return codes.invalid(why: "an ASCII85Decode group stands for more than four bytes")
            out @ out.push(to_u8(n / 16777216).must())
            out @ out.push(to_u8(n / 65536 % 256).must())
            out @ out.push(to_u8(n / 256 % 256).must())
            out @ out.push(to_u8(n % 256).must())
            group @ []

    if group.len() == 1
        return codes.invalid(why: "an ASCII85Decode stream ends with a single digit")

    if group.len() > 1
        kept = group.len() - 1

        while group.len() < 5
            group @ group.push(84)

        n = (((group[0] * 85 + group[1]) * 85 + group[2]) * 85 + group[3]) * 85 + group[4]

        if n > 4294967295
            return codes.invalid(why: "an ASCII85Decode group stands for more than four bytes")
        last = [
            to_u8(n / 16777216).must()
            to_u8(n / 65536 % 256).must()
            to_u8(n / 256 % 256).must()
            to_u8(n % 256).must()
        ]
        k @= 0

        while k < kept
            out @ out.push(last[k])
            k @ k + 1

    return ok(out)

# `data` decoded as RunLengthDecode: a length byte, then that many bytes
# plus one, or one byte repeated 257 less it times; 128 ends.
function run_length(data: [u8], limit: i64) -> [u8]?
    out: [u8] @= []
    i @= 0

    while i < data.len()
        n = to_i64(data[i]).must()
        i @ i + 1

        if n == 128
            break

        if n < 128
            if i + n + 1 > data.len()
                return codes.invalid(why: "a RunLengthDecode stream ends inside a run")
            k @= 0

            while k <= n
                out @ out.push(data[i + k])
                k @ k + 1

            i @ i + n + 1
        else
            if i >= data.len()
                return codes.invalid(why: "a RunLengthDecode stream ends inside a run")
            k @= 0

            while k < 257 - n
                out @ out.push(data[i])
                k @ k + 1

            i @ i + 1

        if out.len() > limit
            return codes.over(what: "the bytes of a stream", most: limit)

    return ok(out)

test "ascii_hex: digits in both cases, whitespace, an odd digit, the end mark, a bad byte"
    assert ascii_hex([0x34, 0x31, 0x20, 0x36, 0x61, 0x3e, 0x30]).must() == [0x41, 0x6a]
    assert ascii_hex([0x34]).must() == [0x40]
    assert ascii_hex([]).must() == []
    assert ascii_hex([0x47]).is_err()

test "ascii85: Python's encoding of a few lengths, z, the end mark, a bad digit"
    assert ascii85([0x38, 0x37, 0x63, 0x55, 0x52, 0x7e, 0x3e]).must() == [0x48, 0x65, 0x6c, 0x6c]
    assert ascii85([0x38, 0x37, 0x63, 0x55, 0x52, 0x44, 0x5a, 0x7e, 0x3e]).must() == [0x48, 0x65, 0x6c, 0x6c, 0x6f]
    assert ascii85([0x7a]).must() == [0, 0, 0, 0]
    assert ascii85([]).must() == []
    assert ascii85([0x76]).is_err()
    assert ascii85([0x38]).is_err()

test "run_length: a literal run, a repeated byte, the end, a run cut short"
    assert run_length([1, 0x41, 0x42, 254, 0x43, 128, 9], limit: 100).must() == [0x41, 0x42, 0x43, 0x43, 0x43]
    assert run_length([], limit: 100).must() == []
    assert run_length([5, 0x41], limit: 100).is_err()
    assert run_length([129, 0x41], limit: 10).is_err()

test "lzw: the example of the PDF reference, with its early change"
    assert lzw([0x80, 0x0b, 0x60, 0x50, 0x22, 0x0c, 0x0c, 0x85, 0x01], early: true, limit: 100).must() == [45, 45, 45, 45, 45, 65, 45, 45, 45, 66]
    assert lzw([], early: true, limit: 100).must() == []

test "predict: PNG's up and sub rows, TIFF's, none, a filter type past 4"
    params: model.Obj = .dict(entries: {"Predictor": .integer(value: 12), "Columns": .integer(value: 2)})
    assert predict([2, 1, 2, 2, 1, 1], params: params, limit: 100).must() == [1, 2, 2, 3]
    sub: model.Obj = .dict(entries: {"Predictor": .integer(value: 11), "Columns": .integer(value: 3)})
    assert predict([1, 5, 1, 255], params: sub, limit: 100).must() == [5, 6, 5]
    tiff: model.Obj = .dict(entries: {"Predictor": .integer(value: 2), "Columns": .integer(value: 3)})
    assert predict([1, 1, 1], params: tiff, limit: 100).must() == [1, 2, 3]
    assert predict([7], params: .null_value, limit: 100).must() == [7]
    assert predict([9, 1, 1], params: params, limit: 100).is_err()

test "flate and decode: zlib, cut short, after ASCIIHex, an image filter refused, the limit"
    packed = compress.compress([0x61, 0x62, 0x63], options: compress.defaults(.zlib)).must()
    assert flate(packed, limit: 100).must() == [0x61, 0x62, 0x63]
    assert flate(packed.slice(from: 0, to: packed.len() - 2), limit: 100).must() == [0x61, 0x62, 0x63]
    assert flate([1, 2, 3], limit: 100).is_err()
    hexed: [u8] @= []

    for b in packed
        hexed @ hexed.push(bytes_hex_high(b))
        hexed @ hexed.push(bytes_hex_low(b))

    chained: {str: model.Obj} = {"Filter": .array(items: [.name(value: "AHx"), .name(value: "FlateDecode")])}
    assert decode(chained, data: hexed, limit: 100).must() == [0x61, 0x62, 0x63]
    assert decode({"Filter": .name(value: "DCTDecode")}, data: [1], limit: 100).is_err()
    assert decode({"Filter": .name(value: "FlateDecode")}, data: packed, limit: 2).is_err()
    assert decode({}, data: [5], limit: 100).must() == [5]

# The hexadecimal digit of the high half of `b`, for the tests.
function bytes_hex_high(b: u8) -> u8
    return "0123456789abcdef"[to_i64(b / 16).must()]

# The hexadecimal digit of the low half of `b`, for the tests.
function bytes_hex_low(b: u8) -> u8
    return "0123456789abcdef"[to_i64(b % 16).must()]
