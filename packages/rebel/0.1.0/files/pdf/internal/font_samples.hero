# A font to test the embedding of fonts with, made on 2026-11-23 from Noto Sans
# Regular 2.015 (Copyright 2022 The Noto Project Authors, SIL Open Font License
# 1.1; the licence is in `font.ledger` and in the font's own `name` table) by
# fontTools 4.68.0's `pyftsubset` with the hinting and the layout tables dropped:
# 205 glyphs, which are the printable ASCII, the Polish, Czech and Greek
# letters, the dashes, the quotation marks and the euro. What the tests expect
# of the font is what fontTools and Poppler's `pdffonts` and `pdftotext` read
# from the files that embed it. No program calls the script that made it.
# `cff` is a font with CFF outlines, 29 glyphs of the same font drawn into a
# CFF font by fontTools' `FontBuilder`, which embedding refuses.

use bytes

# The font file: 15172 bytes.
function noto_sans() -> [u8]
    return bytes.parse_base64(NOTO_SANS.join("")).must()

# The font with its `OS/2` licence bits (`fsType`) set to `flags`: the table
# directory's `OS/2` record is found and the 16-bit number at 8 bytes into the
# table replaced. The table's checksum is left as it was.
function with_licence(flags: i64) -> [u8]
    data: [u8] @= noto_sans()
    tables = to_i64(data[4]).must() * 256 + to_i64(data[5]).must()

    for i in range(from: 0, to: tables)
        at = 12 + 16 * i

        if bytes.to_text_lossy(data.slice(from: at, to: at + 4)) == "OS/2"
            offset = ((to_i64(data[at + 8]).must() * 256 + to_i64(data[at + 9]).must()) * 256 + to_i64(data[at + 10]).must()) * 256 + to_i64(data[at + 11]).must()
            data[offset + 8] @ to_u8(flags / 256).must()
            data[offset + 9] @ to_u8(flags % 256).must()

    return data

# The font with CFF outlines: 3968 bytes.
function cff() -> [u8]
    return bytes.parse_base64(CFF.join("")).must()

