# The figures of a list of times: the best, the worst, the median, the mean,
# the spread, the deviations, the quartiles and the outliers by Tukey's
# fences. The statistics are `stats`'s, which answer what Python's
# `statistics` answers; the quartiles are the inclusive ones, as criterion
# reads its fences from.

use math
use stats

constant INVALID: str
    "invalid"

# The figures `summarize` answers, in its order.
record Figures
    count: i64
    best: f64
    worst: f64
    median: f64
    mean: f64
    spread: f64
    deviation: f64
    median_deviation: f64
    lower_quartile: f64
    upper_quartile: f64
    low_severe: i64
    low_mild: i64
    high_mild: i64
    high_severe: i64

# Nothing where every time is a number, 0 or more and finite; else a failure
# `invalid` naming the first that is not, by its index in `what`.
function readable(times: [f64], what: str) -> ()?
    if times.len() == 0
        return fail(code: INVALID, msg: f"{what} hold no time")
    at: i64 @= 0

    while at < times.len()
        t = times[at]

        if t != t || t < 0.0 || t > math.MAX_F64
            return fail(code: INVALID, msg: f"{what} hold {t} at index {at}, where a time is 0 or more and finite")
        at @ at + 1

    return ok()

# The figures of `times`.
function of(times: [f64]) -> Figures?
    readable(times: times, what: "the times")?
    best: f64 @= times[0]
    worst: f64 @= times[0]

    for t in times
        if t < best
            best @ t

        if t > worst
            worst @ t

    middle = stats.median(times)?
    mean = stats.mean(times)?
    deviation: f64 @= 0.0

    if times.len() > 1
        deviation @ stats.standard_deviation(times)?
    distances: [f64] @= []

    for t in times
        distances @ distances.push(math.abs(t - middle))

    lower: f64 @= times[0]
    upper: f64 @= times[0]

    if times.len() > 1
        quartiles = stats.quantiles_inclusive(times, parts: 4)?
        lower @ quartiles[0]
        upper @ quartiles[2]
    width = upper - lower
    low_severe: i64 @= 0
    low_mild: i64 @= 0
    high_mild: i64 @= 0
    high_severe: i64 @= 0

    for t in times
        if t < lower - 3.0 * width
            low_severe @ low_severe + 1
        else if t < lower - 1.5 * width
            low_mild @ low_mild + 1
        else if t > upper + 3.0 * width
            high_severe @ high_severe + 1
        else if t > upper + 1.5 * width
            high_mild @ high_mild + 1

    return ok(
        Figures(count: times.len(), best: best, worst: worst, median: middle, mean: mean, spread: worst - best, deviation: deviation, median_deviation: stats.median(distances)?, lower_quartile: lower, upper_quartile: upper, low_severe: low_severe, low_mild: low_mild, high_mild: high_mild, high_severe: high_severe)
    )

test "of: ten times with an outlier at each end, as Python's statistics answers"
    f = of([12.0, 10.0, 11.0, 13.0, 10.5, 40.0, 11.5, 12.5, 9.0, 1.0]).must()
    assert f.count == 10
    assert f.best == 1.0 && f.worst == 40.0 && f.spread == 39.0
    assert f.median == 11.25
    assert f.mean == 13.05
    assert f.deviation == 10.06492810594183
    assert f.median_deviation == 1.25
    assert f.lower_quartile == 10.125 && f.upper_quartile == 12.375
    assert f.low_severe == 1 && f.low_mild == 0 && f.high_mild == 0 && f.high_severe == 1

test "of: one time, two, and the times that cannot be read"
    one = of([5.0]).must()
    assert one.median == 5.0 && one.deviation == 0.0 && one.spread == 0.0
    assert one.lower_quartile == 5.0 && one.upper_quartile == 5.0
    two = of([1.0, 3.0]).must()
    assert two.median == 2.0 && two.lower_quartile == 1.5 && two.upper_quartile == 2.5
    empty: [f64] = []

    match of(empty)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert of([1.0, -1.0]).is_err()
    assert of([1.0, math.NAN]).is_err()
    assert of([math.INF]).is_err()
    assert of([0.0]).must().best == 0.0
