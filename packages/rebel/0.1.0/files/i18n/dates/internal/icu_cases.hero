test "skeletons, relative times and patterns: the cases as ICU writes them"
    failures @= 0

    for line in CASES
        f = strings.split(s: line, sep: "\t")
        locale = i18n.parse_locale(f[1]).must()
        written @= ""
        expected @= ""

        if f[0] == "skeleton"
            written @ skeletons.pattern_of(date_data.load(locale), skeleton: f[2]).must()
            expected @ f[3]
        else if f[0] == "relative"
            unit = match f[3]
                "year"    => 0
                "quarter" => 1
                "month"   => 2
                "week"    => 3
                "day"     => 4
                "hour"    => 5
                "minute"  => 6
                _         => 7

            width = match f[4]
                "short"  => 1
                "narrow" => 2
                _        => 0

            written @ relative.format(
                locale,
                amount: numbers.parse_int(f[2]).must(),
                unit: unit,
                width: width,
                named: f[5] == "0"
            )
            expected @ f[6]
        else if f[0] == "dpattern"
            t = time.from_unix_milliseconds(numbers.parse_int(f[3]).must()).must()
            moment = date_format.moment_of(t, zone: time.load_zone(f[4]).must())
            written @ date_format.write(date_data.load(locale), m: moment, pieces: date_format.pieces_of(f[2]).must())
            expected @ f[5]

        if written != expected
            print(line, " wrote ", written)
            failures @ failures + 1

    assert failures == 0
