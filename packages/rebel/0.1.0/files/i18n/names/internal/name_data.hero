# What `name_tables` holds, read: one name, by its key, looked up down the
# fallback chain of the language it is written in, each locale of the chain
# answering the names it holds apart from the locales after it.

use i18n
use i18n/internal/locale_syntax
use i18n/names/internal/name_tables
use strings

# The value of one character of `ALPHABET`.
function digit_of(b: u8) -> i64
    if b >= '0' && b <= '9'
        return to_i64(b - '0').must()

    if b >= 'A' && b <= 'Z'
        return to_i64(b - 'A').must() + 10

    if b >= 'a' && b <= 'z'
        return to_i64(b - 'a').must() + 36

    if b == '+'
        return 62
    return 63

# The number `width` characters of `ALPHABET` from `at` of `codes` write.
function number_at(codes: str, at: i64, width: i64) -> i64
    value @= 0
    i @= at

    while i < at + width
        value @ value * 64 + digit_of(codes[i])
        i @ i + 1

    return value

# Text `id` of `STRINGS`.
function text_of(id: i64) -> str
    chunk = strings.split(s: name_tables.STRINGS[id / 100], sep: "\u{1}")
    return chunk[id % 100]

# The text `row`, a locale's row of `NAMES`, holds for key `key`, a position
# in `KEYS`: its number in `STRINGS`, or -1 where the row holds none. The
# row's entries are five characters each, in the order of their keys.
function entry_of(row: str, key: i64) -> i64
    low @= 0
    high @= row.len() / 5

    while low < high
        middle = (low + high) / 2
        found = number_at(row, at: middle * 5, width: 2)

        if found == key
            return number_at(row, at: middle * 5 + 2, width: 3)

        if found < key
            low @ middle + 1
        else
            high @ middle

    return -1

# The name `key` has in `locale`, the first locale of its fallback chain
# that holds one answering.
#
# Fails `not_found` where none does, or the first that holds the key holds an
# empty text, CLDR's resolved data having no such name there.
function name_of(key: str, locale: i18n.Locale) -> str?
    k = locale_syntax.search(name_tables.KEYS, key: key)

    if k >= 0
        for step in i18n.fallback_chain(locale)
            at = locale_syntax.search(name_tables.LOCALES, key: i18n.format_locale(step))

            if at >= 0
                id = entry_of(name_tables.NAMES[at], key: k)

                if id > 0
                    return ok(text_of(id))

                if id == 0
                    break

    return fail(code: i18n.NOT_FOUND, msg: f"CLDR has no name `{key}` in `{i18n.format_locale(locale)}`")

## Tests

test "number_at: one, two and three characters"
    assert number_at("0", at: 0, width: 1) == 0
    assert number_at("x//", at: 1, width: 2) == 4095
    assert number_at("111", at: 0, width: 3) == 64 * 64 + 65

test "entry_of: an empty row, the first, the last and a key between two"
    assert entry_of("", key: 0) == -1
    row = "00001" + "02/0A" + "0A100"
    assert entry_of(row, key: 0) == 1
    assert entry_of(row, key: 2) == 63 * 64 * 64 + 10
    assert entry_of(row, key: 10) == 4096
    assert entry_of(row, key: 5) == -1
