# Dates and times written as a language writes them: "Tuesday, March 5,
# 2024" and "5 mars 2024", the names of its months and days, its patterns for
# full, long, medium and short dates, and times relative to now, "3 days
# ago", "in 2 hours", "yesterday", from the data of CLDR release
# `i18n.CLDR_VERSION` for every locale it holds, over the instants and zones
# of `time`. Only the Gregorian calendar is written.
#
# What it does NOT do: read the clock, compute a calendar or load a zone
# (`time`); write a time in a fixed form such as RFC 3339 (`time.format`);
# name a zone in words, "Central European Time", which CLDR's zone names
# would need: a zone is written by its offset from GMT in the language's
# own form, "GMT+1".
#
# It fails `invalid` where a pattern or a skeleton is not what the function
# reads, and `not_found` where a text holds no date the pattern reads.

use i18n
use i18n/dates/internal/date_data
use i18n/dates/internal/date_format
use i18n/dates/internal/date_parse
use i18n/dates/internal/icu_cases
use i18n/dates/internal/relative
use i18n/dates/internal/skeletons
use numbers
use strings
use time

## Codes

# The code a function fails with where a pattern, a skeleton or a text to
# read is not what it reads.
constant INVALID: str
    "invalid"

## Options

# How much of a date or a time is written, CLDR's four lengths.
variant DateStyle
    # Everything, the day of the week and, for a time, the zone: "Tuesday,
    # March 5, 2024".
    full
    # The month's name: "March 5, 2024".
    long
    # The month's short name: "Mar 5, 2024".
    medium
    # Numbers alone: "3/5/24".
    short

# How long a name is written.
variant Width
    # In full: "Tuesday", "March".
    wide
    # Shortened: "Tue", "Mar".
    abbreviated
    # As short as the language writes it, often one letter: "T", "M".
    narrow
    # For days alone, between abbreviated and narrow: "Tu".
    short

# Where a name stands, which changes it in some languages: in Russian a
# month inside a date is "марта" and alone "март".
variant NameContext
    # Inside a date.
    format
    # Alone, as in a calendar's heading.
    standalone

# A unit of a relative time.
variant RelativeUnit
    # Years.
    year
    # Quarters of a year.
    quarter
    # Months.
    month
    # Weeks.
    week
    # Days.
    day
    # Hours.
    hour
    # Minutes.
    minute
    # Seconds.
    second

# How long a relative time is written: "in 3 days", "in 3 days" or "in 3d"
# in English.
variant RelativeStyle
    # In full words.
    long
    # Shortened.
    short
    # As short as the language writes it.
    narrow

# `t` in `zone` written as a date in `locale`'s language: "Tuesday, March 5,
# 2024" in full English, "05.03.24" short in German.
#
# - `locale`: the locale.
# - `t`: the instant.
# - `zone`: the zone whose calendar day is written.
# - `style`: how much is written.
#
# A year before 1 is written as the pattern's year field reads it, with its
# era where the pattern has one. See also `format_time`,
# `format_date_time`, `date_pattern`.
function format_date(locale: i18n.Locale, t: time.Instant, zone: time.Zone, style: DateStyle) -> str
    return format_pattern(locale, t: t, zone: zone, pattern: date_pattern(locale, style: style)).must()

# `t` in `zone` written as a time of day in `locale`'s language: "3:04 PM"
# short in English, "15:04" in German.
#
# - `locale`: the locale; its `hc` keyword chooses a 12 or 24 hour clock.
# - `t`: the instant.
# - `zone`: the zone whose clock is written; a full or long time writes its
#   offset, "GMT+1".
# - `style`: how much is written.
#
# See also `format_date`, `time_pattern`.
function format_time(locale: i18n.Locale, t: time.Instant, zone: time.Zone, style: DateStyle) -> str
    return format_pattern(locale, t: t, zone: zone, pattern: time_pattern(locale, style: style)).must()

# `t` in `zone` written as a date and a time in `locale`'s language, joined
# as the language joins them: "March 5, 2024 at 3:04 PM".
#
# - `locale`: the locale.
# - `t`: the instant.
# - `zone`: the zone.
# - `date_style`: how much of the date is written.
# - `time_style`: how much of the time is written.
#
# See also `date_time_pattern`.
function format_date_time(locale: i18n.Locale, t: time.Instant, zone: time.Zone, date_style: DateStyle, time_style: DateStyle) -> str
    return format_pattern(
        locale,
        t: t,
        zone: zone,
        pattern: date_time_pattern(locale, date_style: date_style, time_style: time_style)
    ).must()

# `t` in `zone` written by a CLDR date pattern in `locale`'s language, as
# ICU's `SimpleDateFormat` reads one: `EEEE, d MMMM y`, `HH:mm`, `h:mm a`.
#
# - `locale`: the locale, whose names, digits and offset form the pattern
#   writes.
# - `t`: the instant.
# - `zone`: the zone.
# - `pattern`: the pattern; ASCII letters are fields, text between `'` is
#   written as it is, and `''` writes one `'`.
#
# The fields: `G` era, `y` `Y` `u` years, `Q` `q` quarter, `M` `L` month, `w`
# week of the year, `W` week of the month, `d` `D` `F` `g` days, `E` `e` `c`
# weekday, `a` `b` `B` periods, `h` `H` `k` `K` hours, `m` minute, `s`
# second, `S` fraction, `A` milliseconds of the day, `z` `Z` `O` `v` `V` `X`
# `x` zone. Fails `invalid`
# where the pattern holds another letter or an unclosed quote. See also
# `format_skeleton`.
function format_pattern(locale: i18n.Locale, t: time.Instant, zone: time.Zone, pattern: str) -> str?
    data = date_data.load(locale)
    pieces = date_format.pieces_of(pattern)?
    return ok(date_format.write(data, m: date_format.moment_of(t, zone: zone), pieces: pieces))

# `t` in `zone` written with the fields `skeleton` asks for, in the order
# and the form `locale`'s language writes them: `yMMMd` is "Mar 5, 2024" in
# English and "5. März 2024" in German.
#
# - `locale`: the locale.
# - `t`: the instant.
# - `zone`: the zone.
# - `skeleton`: the fields asked for, CLDR's pattern letters in any order with
#   no text: `yMd`, `MMMMEEEEd`, `jmm` (`j` the language's own hour).
#
# See also `skeleton_pattern`. Fails `invalid` where the skeleton holds a
# letter that is no field.
function format_skeleton(locale: i18n.Locale, t: time.Instant, zone: time.Zone, skeleton: str) -> str?
    return format_pattern(locale, t: t, zone: zone, pattern: skeleton_pattern(locale, skeleton: skeleton)?)

# The pattern `locale`'s language writes a skeleton's fields with, the
# closest of CLDR's available formats with each field widened to the
# skeleton's: `yMMMd` is `MMM d, y` in English.
#
# - `locale`: the locale.
# - `skeleton`: the fields, as `format_skeleton` reads them.
#
# A skeleton with a date and a time is two patterns joined as the language
# joins a date and a time. Fails `invalid` where the skeleton holds a letter
# that is no field. See also `format_skeleton`.
function skeleton_pattern(locale: i18n.Locale, skeleton: str) -> str?
    return skeletons.pattern_of(date_data.load(locale), skeleton: skeleton)

# The pattern `locale`'s language writes a date with: `EEEE, MMMM d, y` full
# in English.
#
# - `locale`: the locale.
# - `style`: how much is written.
#
# See also `format_date`.
function date_pattern(locale: i18n.Locale, style: DateStyle) -> str
    slot = match style
        .full   => 0
        .long   => 1
        .medium => 2
        .short  => 3

    return date_data.slot_text(block: date_data.load(locale).blocks[date_data.PATTERNS], slot: slot)

# The pattern `locale`'s language writes a time with: `h:mm a` short in
# English, `HH:mm` in German.
#
# - `locale`: the locale; its `hc` keyword changes the hours' letter.
# - `style`: how much is written.
#
# See also `format_time`.
function time_pattern(locale: i18n.Locale, style: DateStyle) -> str
    slot = match style
        .full   => 4
        .long   => 5
        .medium => 6
        .short  => 7

    data = date_data.load(locale)
    pattern = date_data.slot_text(block: data.blocks[date_data.PATTERNS], slot: slot)

    match i18n.unicode_keyword(locale, key: "hc")
        .ok cycle =>
            wanted = match cycle
                "h11" => "K"
                "h12" => "h"
                "h23" => "H"
                "h24" => "k"
                _     => ""

            twelve_now = strings.contains(s: pattern, substr: "h") || strings.contains(s: pattern, substr: "K")
            twelve_wanted = wanted == "h" || wanted == "K"

            if wanted != "" && twelve_now == twelve_wanted
                return strings.replace_all(
                    s: strings.replace_all(s: strings.replace_all(s: strings.replace_all(s: pattern, old: "h", new: wanted), old: "H", new: wanted), old: "K", new: wanted),
                    old: "k",
                    new: wanted
                )

            if wanted != ""
                skeleton = match style
                    .full   => "mmsszzzz"
                    .long   => "mmssz"
                    .medium => "mmss"
                    .short  => "mm"

                hour_skeleton @= wanted

                if twelve_wanted
                    hour_skeleton @ "a" + wanted
                return skeletons.pattern_of(data, skeleton: hour_skeleton + skeleton).default(pattern)
        .err _ => _ = 0

    return pattern

# The pattern `locale`'s language writes a date and a time with, the two
# joined.
#
# - `locale`: the locale.
# - `date_style`: how much of the date.
# - `time_style`: how much of the time.
#
# See also `format_date_time`.
function date_time_pattern(locale: i18n.Locale, date_style: DateStyle, time_style: DateStyle) -> str
    data = date_data.load(locale)
    patterns = data.blocks[date_data.PATTERNS]

    style = match date_style
        .full   => 0
        .long   => 1
        .medium => 2
        .short  => 3

    glue @= date_data.slot_text(block: patterns, slot: 12 + style)

    if glue == ""
        glue @ date_data.slot_text(block: patterns, slot: 8 + style)
    return strings.replace_all(
        s: strings.replace_all(s: glue, old: "{1}", new: date_pattern(locale, style: date_style)),
        old: "{0}",
        new: time_pattern(locale, style: time_style)
    )

# A date or time written in `locale`'s language by `pattern`, read back as
# an instant: the reverse of `format_pattern`.
#
# - `locale`: the locale.
# - `text`: the text; its letters compared ignoring case, and runs of spaces
#   matching any space the pattern writes.
# - `pattern`: the pattern it was written by.
# - `zone`: the zone a text with no offset is read in.
#
# A field the pattern leaves out takes 1970-01-01T00:00 for its value: the
# year 1970, January, the first, midnight. A two-letter year is read within
# eighty years before and twenty after 2000. Fails `invalid` where the
# pattern does not parse or the text does not hold what it asks, the
# message naming the field, and where a date does not exist. See also
# `format_pattern`.
function parse_pattern(locale: i18n.Locale, text: str, pattern: str, zone: time.Zone) -> time.Instant?
    return date_parse.parse(date_data.load(locale), text: text, pattern: pattern, zone: zone)

# The names of the months in `locale`'s language, January first.
#
# - `locale`: the locale.
# - `width`: how long; `short` answers the abbreviated names.
# - `context`: inside a date or alone.
#
# Always twelve. See also `weekday_names`.
function month_names(locale: i18n.Locale, width: Width, context: NameContext) -> [str]
    data = date_data.load(locale)

    w = match width
        .abbreviated => 0
        .narrow      => 1
        .wide        => 2
        .short       => 0

    base @= w * 12

    match context
        .format     => _ = 0
        .standalone => base @ base + 36

    return date_data.slot_texts(block: data.blocks[date_data.MONTHS], from: base, to: base + 12)

# The names of the days of the week in `locale`'s language, Monday first as
# `time.Weekday` counts them.
#
# - `locale`: the locale.
# - `width`: how long.
# - `context`: inside a date or alone.
#
# Always seven. See also `first_weekday`.
function weekday_names(locale: i18n.Locale, width: Width, context: NameContext) -> [str]
    data = date_data.load(locale)

    w = match width
        .abbreviated => 0
        .narrow      => 1
        .short       => 2
        .wide        => 3

    base @= w * 7

    match context
        .format     => _ = 0
        .standalone => base @ base + 28

    sunday_first = date_data.slot_texts(block: data.blocks[date_data.DAYS], from: base, to: base + 7)
    monday_first @= sunday_first.slice(from: 1, to: 7)
    monday_first @ monday_first.push(sunday_first[0])
    return monday_first

# The names of the quarters of the year in `locale`'s language, the first
# quarter first.
#
# - `locale`: the locale.
# - `width`: how long; `short` answers the abbreviated names.
# - `context`: inside a date or alone.
#
# Always four.
function quarter_names(locale: i18n.Locale, width: Width, context: NameContext) -> [str]
    data = date_data.load(locale)

    w = match width
        .abbreviated => 0
        .narrow      => 1
        .wide        => 2
        .short       => 0

    base @= w * 4

    match context
        .format     => _ = 0
        .standalone => base @ base + 12

    return date_data.slot_texts(block: data.blocks[date_data.QUARTERS], from: base, to: base + 4)

# The names of the morning and the afternoon in `locale`'s language, "AM"
# and "PM" in English.
#
# - `locale`: the locale.
# - `width`: how long; `short` answers the abbreviated names.
#
# Always two, the morning first.
function day_period_names(locale: i18n.Locale, width: Width) -> [str]
    data = date_data.load(locale)

    w = match width
        .abbreviated => 0
        .narrow      => 1
        .wide        => 2
        .short       => 0

    return date_data.slot_texts(block: data.blocks[date_data.PERIODS], from: w * 12, to: w * 12 + 2)

# The names of the two eras of the Gregorian calendar in `locale`'s
# language, the one before the year 1 first: "BC" and "AD" in English.
#
# - `locale`: the locale.
# - `width`: `wide` for "Before Christ", `abbreviated` or `short` for "BC",
#   `narrow` for "B".
#
# Always two.
function era_names(locale: i18n.Locale, width: Width) -> [str]
    data = date_data.load(locale)

    base = match width
        .wide        => 0
        .abbreviated => 2
        .short       => 2
        .narrow      => 4

    return date_data.slot_texts(block: data.blocks[date_data.ERAS], from: base, to: base + 2)

# The day a week begins on in `locale`'s region: Sunday in the United
# States, Monday in Germany, Saturday in Egypt.
#
# - `locale`: the locale; a locale with no region takes its language's
#   likely one, and its `fw` keyword, where it has one, is the answer.
#
# See also `minimal_days`.
function first_weekday(locale: i18n.Locale) -> time.Weekday
    number @= date_data.first_day(date_data.region_of(locale))

    match i18n.unicode_keyword(locale, key: "fw")
        .ok day =>
            asked = match day
                "mon" => 1
                "tue" => 2
                "wed" => 3
                "thu" => 4
                "fri" => 5
                "sat" => 6
                "sun" => 7
                _     => 0

            if asked > 0
                number @ asked
        .err _ => _ = 0

    return match number
        1 => .monday
        2 => .tuesday
        3 => .wednesday
        4 => .thursday
        5 => .friday
        6 => .saturday
        _ => .sunday

# The fewest days of a new year that the first week of the year must hold
# in `locale`'s region: 1 in the United States, 4 in Germany as ISO 8601
# says.
#
# - `locale`: the locale; a locale with no region takes its language's
#   likely one.
#
# From 1 to 7. See also `first_weekday`.
function minimal_days(locale: i18n.Locale) -> i64
    return date_data.min_days(date_data.region_of(locale))

# Whether `locale`'s region writes the time with a 12-hour clock, as the
# United States does, rather than a 24-hour one.
#
# - `locale`: the locale; its `hc` keyword, where it has one, decides.
#
# See also `time_pattern`.
function uses_12_hour_clock(locale: i18n.Locale) -> bool
    match i18n.unicode_keyword(locale, key: "hc")
        .ok cycle =>
            if cycle == "h11" || cycle == "h12"
                return true

            if cycle == "h23" || cycle == "h24"
                return false
        .err _ => _ = 0

    return date_data.hour_of(language: locale.language, region: date_data.region_of(locale)) == "h"

# `amount` units of time from now written in `locale`'s language, always
# with its number: "in 3 days", "3 days ago", "in 0 days".
#
# - `locale`: the locale.
# - `amount`: how many units, negative in the past; the number is written in
#   the language's digits and chooses the plural.
# - `unit`: the unit.
# - `style`: how long the words are.
#
# Zero is written as the future, as ICU writes it. See also
# `format_relative_named`.
function format_relative(locale: i18n.Locale, amount: i64, unit: RelativeUnit, style: RelativeStyle) -> str
    unit_index = match unit
        .year    => 0
        .quarter => 1
        .month   => 2
        .week    => 3
        .day     => 4
        .hour    => 5
        .minute  => 6
        .second  => 7

    width = match style
        .long   => 0
        .short  => 1
        .narrow => 2

    return relative.format(locale, amount: amount, unit: unit_index, width: width, named: false)

# `amount` units of time from now written as `locale`'s language names it
# where it has a word, "yesterday", "tomorrow", "next year", "now", and with
# a number where it has none, "in 3 days".
#
# - `locale`: the locale.
# - `amount`: how many units, negative in the past.
# - `unit`: the unit.
# - `style`: how long the words are.
#
# See also `format_relative`.
function format_relative_named(locale: i18n.Locale, amount: i64, unit: RelativeUnit, style: RelativeStyle) -> str
    unit_index = match unit
        .year    => 0
        .quarter => 1
        .month   => 2
        .week    => 3
        .day     => 4
        .hour    => 5
        .minute  => 6
        .second  => 7

    width = match style
        .long   => 0
        .short  => 1
        .narrow => 2

    return relative.format(locale, amount: amount, unit: unit_index, width: width, named: true)

## Tests

# Expected values are what ICU 79.1 (CLDR 49) wrote for the same input,
# observed 2026-11-19, the Gregorian calendar asked; `icu_cases` holds six
# hundred of them, and this test runs its dates and times through the face.

test "format_date, format_time and format_date_time: the cases as ICU writes them"
    failures @= 0

    for line in icu_cases.CASES
        f = strings.split(s: line, sep: "\t")

        if f[0] == "date"
            locale = i18n.parse_locale(f[1]).must()
            t = time.from_unix_milliseconds(numbers.parse_int(f[4]).must()).must()
            zone = time.load_zone(f[5]).must()

            date_style: DateStyle = match f[2]
                "full"   => .full
                "long"   => .long
                "medium" => .medium
                _        => .short

            time_style: DateStyle = match f[3]
                "full"   => .full
                "long"   => .long
                "medium" => .medium
                _        => .short

            written @= ""

            if f[2] == "none"
                written @ format_time(locale, t: t, zone: zone, style: time_style)
            else if f[3] == "none"
                written @ format_date(locale, t: t, zone: zone, style: date_style)
            else
                written @ format_date_time(locale, t: t, zone: zone, date_style: date_style, time_style: time_style)

            if written != f[6]
                print(line, " wrote ", written)
                failures @ failures + 1

    assert failures == 0

## Examples

# A date in full, in English and in French.
test "format_date: full English and long French"
    t = time.date(year: 2024, month: 3, day: 5).must()
    utc = time.utc_zone()
    assert format_date(i18n.parse_locale("en").must(), t: t, zone: utc, style: .full) == "Tuesday, March 5, 2024"
    assert format_date(i18n.parse_locale("fr").must(), t: t, zone: utc, style: .long) == "5 mars 2024"

# A time of day in English and in German.
test "format_time: short English and German"
    t = time.from_date_time(
        time.DateTime(year: 2024, month: 3, day: 5, hour: 15, minute: 4, second: 0, nanosecond: 0)
    ).must()
    utc = time.utc_zone()
    assert format_time(i18n.parse_locale("en").must(), t: t, zone: utc, style: .short) == "3:04 PM"
    assert format_time(i18n.parse_locale("de").must(), t: t, zone: utc, style: .short) == "15:04"

# A date and a time together in German.
test "format_date_time: German medium"
    t = time.from_date_time(
        time.DateTime(year: 2024, month: 3, day: 5, hour: 15, minute: 4, second: 5, nanosecond: 0)
    ).must()
    german = i18n.parse_locale("de").must()
    assert format_date_time(german, t: t, zone: time.utc_zone(), date_style: .medium, time_style: .medium) == "05.03.2024, 15:04:05"

# A pattern of the program's own.
test "format_pattern: a weekday and a month in Italian"
    t = time.date(year: 2024, month: 3, day: 5).must()
    italian = i18n.parse_locale("it").must()
    assert format_pattern(italian, t: t, zone: time.utc_zone(), pattern: "EEEE d MMMM").must() == "martedì 5 marzo"

# The fields a program wants, in the order of the language.
test "format_skeleton: a month and a day in German"
    t = time.date(year: 2024, month: 3, day: 5).must()
    german = i18n.parse_locale("de").must()
    assert format_skeleton(german, t: t, zone: time.utc_zone(), skeleton: "MMMd").must() == "5. März"

# The pattern of a skeleton.
test "skeleton_pattern: English month, day and year"
    assert skeleton_pattern(i18n.parse_locale("en").must(), skeleton: "yMMMd").must() == "MMM d, y"

# The full date pattern of English.
test "date_pattern: English full"
    assert date_pattern(i18n.parse_locale("en").must(), style: .full) == "EEEE, MMMM d, y"

# German writes hours on a 24-hour clock.
test "time_pattern: German short"
    assert time_pattern(i18n.parse_locale("de").must(), style: .short) == "HH:mm"

# How Japanese joins a date and a time.
test "date_time_pattern: Japanese medium"
    assert date_time_pattern(i18n.parse_locale("ja").must(), date_style: .medium, time_style: .medium) == "y/MM/dd H:mm:ss"

# A German date read back.
test "parse_pattern: a German date"
    t = parse_pattern(
        i18n.parse_locale("de").must(),
        text: "5. März 2024",
        pattern: "d. MMMM y",
        zone: time.utc_zone()
    ).must()
    assert t == time.date(year: 2024, month: 3, day: 5).must()

# The months of Russian, inside a date and alone.
test "month_names: Russian in a date and alone"
    russian = i18n.parse_locale("ru").must()
    assert month_names(russian, width: .wide, context: .format)[2] == "марта"
    assert month_names(russian, width: .wide, context: .standalone)[2] == "март"

# The days of the week in Spanish, Monday first.
test "weekday_names: Spanish"
    assert weekday_names(i18n.parse_locale("es").must(), width: .wide, context: .format)[0] == "lunes"

# The quarters in English.
test "quarter_names: English abbreviated"
    assert quarter_names(i18n.parse_locale("en").must(), width: .abbreviated, context: .format) == ["Q1", "Q2", "Q3", "Q4"]

# Morning and afternoon in English.
test "day_period_names: English"
    assert day_period_names(i18n.parse_locale("en").must(), width: .abbreviated) == ["AM", "PM"]

# The eras of English.
test "era_names: English abbreviated"
    assert era_names(i18n.parse_locale("en").must(), width: .abbreviated) == ["BC", "AD"]

# Where the week begins.
test "first_weekday: the United States and Germany"
    assert first_weekday(i18n.parse_locale("en-US").must()) == .sunday
    assert first_weekday(i18n.parse_locale("de").must()) == .monday

# The first week of the year in Germany.
test "minimal_days: Germany follows ISO 8601"
    assert minimal_days(i18n.parse_locale("de-DE").must()) == 4

# Clocks of 12 and 24 hours.
test "uses_12_hour_clock: the United States and France"
    assert uses_12_hour_clock(i18n.parse_locale("en-US").must())
    assert !uses_12_hour_clock(i18n.parse_locale("fr-FR").must())

# Days in the past and the future.
test "format_relative: days ago and in days"
    english = i18n.parse_locale("en").must()
    assert format_relative(english, amount: -3, unit: .day, style: .long) == "3 days ago"
    assert format_relative(english, amount: 1, unit: .day, style: .long) == "in 1 day"

# Yesterday and tomorrow named.
test "format_relative_named: yesterday and in three days"
    english = i18n.parse_locale("en").must()
    assert format_relative_named(english, amount: -1, unit: .day, style: .long) == "yesterday"
    assert format_relative_named(english, amount: 3, unit: .day, style: .long) == "in 3 days"
