# The style a case names.
function style_of(name: str) -> i64
    return match name
        "percent"       => formatting.PERCENT
        "scientific"    => formatting.SCIENTIFIC
        "currency"      => formatting.CURRENCY
        "accounting"    => formatting.ACCOUNTING
        "compact_short" => formatting.COMPACT_SHORT
        "compact_long"  => formatting.COMPACT_LONG
        _               => formatting.DECIMAL

test "format: six hundred numbers of every style as ICU writes them"
    failures @= 0

    for line in CASES
        f = strings.split(s: line, sep: "\t")
        settings @= formatting.settings_of(style_of(f[1]))
        settings.currency @ f[3]
        written = formatting.format(i18n.parse_locale(f[0]).must(), number: f[2], settings: settings).must()

        if written != f[4]
            print(line, " wrote ", written)
            failures @ failures + 1

    assert failures == 0
