# The root collation of CLDR release 49 (UCA 18.0.0, its allkeys_CLDR.txt)
# and the tailoring rules CLDR gives every language but Chinese, Japanese and
# Korean, which `i18n/collate` reads.
#
# A collation element is 31 bits, variable << 30 | primary << 14 |
# secondary << 5 | tertiary, written in six characters of `ALPHABET`, its
# number in base 64. A character's entry is 42 bits, its code point << 21 |
# its first element's position << 5 | its count of elements, in seven.
# Code points with no entry take UCA's implicit weights.
#
# The table is data, made and not typed: a one-off Heroes program,
# `gen_collate.hero`, which is not in the tree (defect 2639), read CLDR 49's
# `common/uca/allkeys_CLDR.txt` and `common/collation/*.xml`
# (`cldr-common-49.zip` of https://unicode.org/Public/cldr/49/, SHA-256
# 78403d8d6fb1fed6, fetched 2026-11-18) and wrote this module whole. Nothing
# here is edited by hand.

# The characters a number is written with.
constant ALPHABET: str
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/"

# The last primary weight of the spaces and of the punctuation, the first
# of the currency signs, and the last of the letters before the implicit
# weights: the bounds of the groups a collator may treat as variable.
constant LAST_SPACE: i64
    521

constant LAST_PUNCT: i64
    1252

constant FIRST_CURRENCY: i64
    8766

constant LAST_REGULAR: i64
    29854

# How many characters have an entry.
constant SINGLE_COUNT: i64
    39493

# The characters' entries, in the order of their code points, 512 to a
# chunk.
constant SINGLES: [str]
    [
        ""
