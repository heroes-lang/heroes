# gettext's `.po` files read and written: entries with their comments,
# flags, previous texts and obsolete marks, and strings with C's escapes.
# The face's `Message` is `Entry` field by field.

use bytes
use strings

# The code a broken file fails with.
constant INVALID: str
    "invalid"

# The code an absent header field fails with.
constant NOT_FOUND: str
    "not_found"

# One entry of a `.po` file, the face's `Message`.
record Entry
    has_context: bool
    context: str
    id: str
    has_plural: bool
    plural_id: str
    translations: [str]
    comments: [str]
    extracted_comments: [str]
    references: [str]
    flags: [str]
    previous: [str]
    obsolete: bool

# An entry with nothing in it.
function empty_entry() -> Entry
    return Entry(
        has_context: false,
        context: "",
        id: "",
        has_plural: false,
        plural_id: "",
        translations: [],
        comments: [],
        extracted_comments: [],
        references: [],
        flags: [],
        previous: [],
        obsolete: false
    )

# The key a catalog finds an entry by: its context, the byte 4 and its id,
# or its id alone where it has no context, as a `.mo` file writes it.
function key_of(has_context: bool, context: str, id: str) -> str
    if has_context
        return context + "\u{4}" + id
    return id

# Whether `entry` is the header: no context and the empty id.
function is_header(entry: Entry lent) -> bool
    return !entry.has_context && entry.id == ""

# Whether `entry` has `flag`.
function has_flag(entry: Entry lent, flag: str) -> bool
    for f in entry.flags
        if f == flag
            return true

    return false

# Whether a message with these fields is a translation a lookup takes: not
# obsolete, not fuzzy, and its first form not empty.
function is_usable(obsolete: bool, flags: [str] lent, translations: [str] lent) -> bool
    if obsolete || translations.len() == 0 || translations[0] == ""
        return false

    for f in flags
        if f == "fuzzy"
            return false

    return true

# The value of the field `name` of the header text `header`, its name
# compared ignoring ASCII case and its value trimmed.
function header_value(header: str, name: str) -> str?
    for line in strings.split(s: header, sep: "\n")
        match strings.split_once(s: line, sep: ":")
            .ok halves =>
                if strings.equals_ignoring_case_ascii(a: strings.trim(halves.before), b: name)
                    return ok(strings.trim(halves.after))
            .err _ => _ = 0

    return fail(code: NOT_FOUND, msg: f"the header has no field \"{name}\"")

## Reading

# The string literal opening at `at` of `line`, its escapes read, and where
# it ends.
record Literal
    text: str
    end: i64

# The value of hexadecimal digit `b`, or -1.
function hex_value(b: u8) -> i64
    if b >= '0' && b <= '9'
        return to_i64(b - '0').must()

    if b >= 'a' && b <= 'f'
        return to_i64(b - 'a').must() + 10

    if b >= 'A' && b <= 'F'
        return to_i64(b - 'A').must() + 10
    return -1

# The string literal of `line` opening at byte `at`, a `"`.
function literal_at(line: str, at: i64, number: i64) -> Literal?
    out: [u8] @= []
    i @= at + 1

    while i < line.len() && line[i] != '"'
        b = line[i]

        if b != '\\'
            out @ out.push(b)
            i @ i + 1
        else
            if i + 1 >= line.len()
                return fail(code: INVALID, msg: f"line {number}: a \\ ends the line")
            e = line[i + 1]
            i @ i + 2

            if e == 'n'
                out @ out.push(10)
            else if e == 't'
                out @ out.push(9)
            else if e == 'r'
                out @ out.push(13)
            else if e == 'a'
                out @ out.push(7)
            else if e == 'b'
                out @ out.push(8)
            else if e == 'f'
                out @ out.push(12)
            else if e == 'v'
                out @ out.push(11)
            else if e == '\\' || e == '"' || e == '\'' || e == '?'
                out @ out.push(e)
            else if e >= '0' && e <= '7'
                value @= to_i64(e - '0').must()
                count @= 1

                while count < 3 && i < line.len() && line[i] >= '0' && line[i] <= '7'
                    value @ value * 8 + to_i64(line[i] - '0').must()
                    i @ i + 1
                    count @ count + 1

                if value > 255
                    return fail(code: INVALID, msg: f"line {number}: an octal escape above 255")
                out @ out.push(to_u8(value).must())
            else if e == 'x'
                value @= 0
                count @= 0

                while i < line.len() && hex_value(line[i]) >= 0 && count < 2
                    value @ value * 16 + hex_value(line[i])
                    i @ i + 1
                    count @ count + 1

                if count == 0
                    return fail(code: INVALID, msg: f"line {number}: \\x with no hexadecimal digit")
                out @ out.push(to_u8(value).must())
            else
                return fail(code: INVALID, msg: f"line {number}: an unknown escape \\{line.slice(from: i - 1, to: i)}")

    if i >= line.len()
        return fail(code: INVALID, msg: f"line {number}: a string with no closing \"")

    match bytes.to_text(out)
        .ok text => return ok(Literal(text: text, end: i + 1))
        .err _ => return fail(
            code: INVALID,
            msg: f"line {number}: a string whose escapes write bytes that are not UTF-8"
        )

# The one string literal `rest` holds, spaces around it allowed.
function only_literal(rest: str, number: i64) -> str?
    trimmed = strings.trim(rest)

    if trimmed.len() == 0 || trimmed[0] != '"'
        return fail(code: INVALID, msg: f"line {number}: a keyword with no string after it")
    found = literal_at(trimmed, at: 0, number: number)?

    if strings.trim(trimmed.slice(from: found.end, to: trimmed.len())) != ""
        return fail(code: INVALID, msg: f"line {number}: text after the string")
    return ok(found.text)

# What the reader is filling: which string a continuation line adds to.
record Reader
    entries: [Entry]
    current: Entry
    started: bool
    has_translation: bool
    last: str
    last_index: i64

# Ends the entry being read, if one was begun.
function finish(@reader: Reader, number: i64) -> ()?
    if reader.started
        if !reader.has_translation
            return fail(code: INVALID, msg: f"line {number}: the entry \"{reader.current.id}\" has no msgstr")

        if reader.current.has_plural && reader.current.translations.len() == 0
            return fail(code: INVALID, msg: f"line {number}: the plural entry \"{reader.current.id}\" has no msgstr[0]")
        reader.entries @ reader.entries.push(reader.current)
    reader.current @ empty_entry()
    reader.started @ false
    reader.has_translation @ false
    reader.last @ ""
    return ok()

# Adds `text` to the string the last keyword opened.
function append(@reader: Reader, text: str, number: i64) -> ()?
    if reader.last == "msgctxt"
        reader.current.context @ reader.current.context + text
    else if reader.last == "msgid"
        reader.current.id @ reader.current.id + text
    else if reader.last == "msgid_plural"
        reader.current.plural_id @ reader.current.plural_id + text
    else if reader.last == "msgstr"
        index = reader.last_index
        forms @= reader.current.translations
        forms[index] @ forms[index] + text
        reader.current.translations @ forms
    else
        return fail(code: INVALID, msg: f"line {number}: a string continues no keyword")
    return ok()

# The keyword `line` opens with, and the rest after it.
record Keyword
    name: str
    index: i64
    rest: str

# The keyword of `line`, or a name of `""` where it opens with none.
function keyword_of(line: str, number: i64) -> Keyword?
    names = ["msgctxt", "msgid_plural", "msgid", "msgstr"]

    for name in names
        if strings.has_prefix(s: line, prefix: name)
            rest = line.slice(from: name.len(), to: line.len())

            if name == "msgstr" && rest.len() > 0 && rest[0] == '['
                close = strings.index_of(s: rest, substr: "]")

                if close.is_err()
                    return fail(code: INVALID, msg: f"line {number}: msgstr[ with no ]")
                digits = rest.slice(from: 1, to: close.must())
                index @= 0

                if digits.len() == 0 || digits.len() > 3
                    return fail(code: INVALID, msg: f"line {number}: msgstr[{digits}] is no form")
                at @= 0

                while at < digits.len()
                    if digits[at] < '0' || digits[at] > '9'
                        return fail(code: INVALID, msg: f"line {number}: msgstr[{digits}] is no form")
                    index @ index * 10 + to_i64(digits[at] - '0').must()
                    at @ at + 1

                return ok(
                    Keyword(name: "msgstr", index: index, rest: rest.slice(from: close.must() + 1, to: rest.len()))
                )

            if rest.len() == 0 || rest[0] == ' ' || rest[0] == '\t' || rest[0] == '"'
                return ok(Keyword(name: name, index: -1, rest: rest))

    return ok(Keyword(name: "", index: -1, rest: ""))

# Reads one line, its obsolete mark taken off.
function read_line(@reader: Reader, line: str, obsolete: bool, number: i64) -> ()?
    if line.len() > 0 && line[0] == '#'
        if reader.has_translation
            finish(@reader, number: number)?
        reader.started @ true
        kind = if_second(line)
        body = strings.trim_start(line.slice(from: kind.len(), to: line.len()))

        if kind == "#|"
            reader.current.previous @ reader.current.previous.push(body)
        else if kind == "#."
            reader.current.extracted_comments @ reader.current.extracted_comments.push(body)
        else if kind == "#:"
            for reference in strings.words(body)
                reader.current.references @ reader.current.references.push(reference)
        else if kind == "#,"
            for flag in strings.split(s: body, sep: ",")
                trimmed = strings.trim(flag)

                if trimmed != ""
                    reader.current.flags @ reader.current.flags.push(trimmed)
        else
            text = line.slice(from: 1, to: line.len())

            if text.len() > 0 && text[0] == ' '
                reader.current.comments @ reader.current.comments.push(text.slice(from: 1, to: text.len()))
            else
                reader.current.comments @ reader.current.comments.push(text)
        return ok()

    if line[0] == '"'
        append(@reader, text: only_literal(line, number: number)?, number: number)?
        return ok()
    word = keyword_of(line, number: number)?

    if word.name == ""
        return fail(code: INVALID, msg: f"line {number}: \"{line}\" opens with no keyword")
    text = only_literal(word.rest, number: number)?

    if (word.name == "msgctxt" || word.name == "msgid") && reader.has_translation
        finish(@reader, number: number)?
    reader.started @ true
    reader.current.obsolete @ reader.current.obsolete || obsolete

    if word.name == "msgctxt"
        if reader.last != "" || reader.current.has_context
            return fail(code: INVALID, msg: f"line {number}: msgctxt after another keyword of its entry")
        reader.current.has_context @ true
        reader.current.context @ text
    else if word.name == "msgid"
        if reader.last != "" && reader.last != "msgctxt"
            return fail(code: INVALID, msg: f"line {number}: msgid after another keyword of its entry")
        reader.current.id @ text
    else if word.name == "msgid_plural"
        if reader.last != "msgid"
            return fail(code: INVALID, msg: f"line {number}: msgid_plural not after msgid")
        reader.current.has_plural @ true
        reader.current.plural_id @ text
    else
        if reader.last != "msgid" && reader.last != "msgid_plural" && reader.last != "msgstr"
            return fail(code: INVALID, msg: f"line {number}: msgstr before msgid")
        expected = reader.current.translations.len()

        if reader.current.has_plural && word.index != expected
            return fail(code: INVALID, msg: f"line {number}: msgstr[{word.index}] where msgstr[{expected}] is expected")

        if !reader.current.has_plural && (word.index >= 0 || expected > 0)
            return fail(code: INVALID, msg: f"line {number}: a msgstr[] or a second msgstr in an entry with no plural")
        reader.current.translations @ reader.current.translations.push(text)
        reader.has_translation @ true
        reader.last_index @ expected
    reader.last @ word.name
    return ok()

# The two characters that open a comment line, `#.`, `#:`, `#,`, `#|`, or
# `#` alone for a translator's comment.
function if_second(line: str) -> str
    if line.len() >= 2 && (line[1] == '.' || line[1] == ':' || line[1] == ',' || line[1] == '|')
        return line.slice(from: 0, to: 2)
    return "#"

# The entries of a `.po` text.
function parse(text: str) -> [Entry]?
    reader @= Reader(
        entries: [],
        current: empty_entry(),
        started: false,
        has_translation: false,
        last: "",
        last_index: 0
    )
    number @= 0

    for raw in strings.split(s: text, sep: "\n")
        number @ number + 1
        line = strings.trim(strings.trim_suffix(s: raw, suffix: "\r"))

        if line == ""
            if reader.has_translation
                finish(@reader, number: number)?
        else if strings.has_prefix(s: line, prefix: "#~")
            rest = strings.trim(line.slice(from: 2, to: line.len()))

            if strings.has_prefix(s: rest, prefix: "|")
                if reader.has_translation
                    finish(@reader, number: number)?
                reader.started @ true
                reader.current.previous @ reader.current.previous.push(
                    strings.trim(rest.slice(from: 1, to: rest.len()))
                )
            else if rest != ""
                read_line(@reader, line: rest, obsolete: true, number: number)?
        else
            read_line(@reader, line: line, obsolete: false, number: number)?

    if reader.started && !reader.has_translation && reader.last == "" && reader.current.id == ""
        # Comments at the end of the file with no entry after them.
        return ok(reader.entries)
    finish(@reader, number: number)?
    return ok(reader.entries)

## Writing

# `s` as the body of a `.po` string, with its escapes.
function escape(s: str) -> str
    out: [str] @= []
    start @= 0
    at @= 0

    while at < s.len()
        b = s[at]

        replacement = match b
            '\\' => "\\\\"
            '"'  => "\\\""
            10   => "\\n"
            9    => "\\t"
            13   => "\\r"
            7    => "\\a"
            8    => "\\b"
            12   => "\\f"
            11   => "\\v"
            _    => ""

        if replacement != "" || b < 32 || b == 127
            out @ out.push(s.slice(from: start, to: at))

            if replacement != ""
                out @ out.push(replacement)
            else
                out @ out.push("\\" + octal(to_i64(b).must()))
            start @ at + 1
        at @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out.join("")

# `n`, below 256, as three octal digits.
function octal(n: i64) -> str
    return to_str(n / 64) + to_str(n / 8 % 8) + to_str(n % 8)

# The lines that write `keyword` with the string `s`: one line, or an empty
# first line and a line per line break where `s` holds one before its end.
function string_lines(keyword: str, s: str, prefix: str) -> [str]
    inner = strings.index_of(s: s, substr: "\n")

    if inner.is_err() || inner.must() == s.len() - 1
        return [prefix + keyword + " \"" + escape(s) + "\""]
    out: [str] @= [prefix + keyword + " \"\""]

    for piece in strings.split_after(s: s, sep: "\n")
        if piece != ""
            out @ out.push(prefix + "\"" + escape(piece) + "\"")

    return out

# `entries` written as a `.po` text.
function format(entries: [Entry] lent) -> str
    blocks: [str] @= []

    for e in entries
        lines: [str] @= []

        for c in e.comments
            if c == ""
                lines @ lines.push("#")
            else
                lines @ lines.push("# " + c)

        for c in e.extracted_comments
            lines @ lines.push("#. " + c)

        for r in e.references
            lines @ lines.push("#: " + r)

        if e.flags.len() > 0
            lines @ lines.push("#, " + e.flags.join(", "))
        prefix = if_obsolete(e.obsolete)

        for p in e.previous
            lines @ lines.push(prefix_previous(e.obsolete) + p)

        if e.has_context
            for l in string_lines(keyword: "msgctxt", s: e.context, prefix: prefix)
                lines @ lines.push(l)

        for l in string_lines(keyword: "msgid", s: e.id, prefix: prefix)
            lines @ lines.push(l)

        if e.has_plural
            for l in string_lines(keyword: "msgid_plural", s: e.plural_id, prefix: prefix)
                lines @ lines.push(l)

            index @= 0

            while index < e.translations.len()
                for l in string_lines(keyword: f"msgstr[{index}]", s: e.translations[index], prefix: prefix)
                    lines @ lines.push(l)

                index @ index + 1
        else
            translation @= ""

            if e.translations.len() > 0
                translation @ e.translations[0]

            for l in string_lines(keyword: "msgstr", s: translation, prefix: prefix)
                lines @ lines.push(l)
        blocks @ blocks.push(lines.join("\n") + "\n")

    return blocks.join("\n")

# The opening of an obsolete entry's lines.
function if_obsolete(obsolete: bool) -> str
    if obsolete
        return "#~ "
    return ""

# The opening of a previous text's line.
function prefix_previous(obsolete: bool) -> str
    if obsolete
        return "#~| "
    return "#| "

## Tests

test "is_usable: a translation, obsolete, fuzzy and empty"
    assert is_usable(obsolete: false, flags: ["c-format"], translations: ["x"])
    assert !is_usable(obsolete: true, flags: [], translations: ["x"])
    assert !is_usable(obsolete: false, flags: ["fuzzy"], translations: ["x"])
    assert !is_usable(obsolete: false, flags: [], translations: [""])
    assert !is_usable(obsolete: false, flags: [], translations: [])

test "header_value: a field in any case, a value trimmed, and absent"
    header = "Project-Id-Version: x\nPlural-Forms: nplurals=1; plural=0;\n"
    assert header_value(header: header, name: "plural-forms").must() == "nplurals=1; plural=0;"
    assert header_value(header: header, name: "Language").is_err()
    assert header_value(header: "", name: "Language").is_err()

test "parse: the empty text, comments alone, and a header"
    assert parse("").must().len() == 0
    assert parse("# only a comment\n").must().len() == 0
    entries = parse("msgid \"\"\nmsgstr \"\"\n\"Language: de\\n\"\n").must()
    assert entries.len() == 1 && entries[0].translations == ["Language: de\n"]

test "parse: every kind of comment, a context, a plural and an obsolete entry"
    text = "# translator\n#. extracted\n#: a.c:1 b.c:2\n#, fuzzy, c-format\n#| msgid \"old\"\nmsgctxt \"menu\"\nmsgid \"File\"\nmsgstr \"Datei\"\n\nmsgid \"one\"\nmsgid_plural \"many\"\nmsgstr[0] \"eins\"\nmsgstr[1] \"viele\"\n\n#~ msgid \"gone\"\n#~ msgstr \"weg\"\n"
    entries = parse(text).must()
    assert entries.len() == 3
    first = entries[0]
    assert first.comments == ["translator"] && first.extracted_comments == ["extracted"]
    assert first.references == ["a.c:1", "b.c:2"] && first.flags == ["fuzzy", "c-format"]
    assert first.previous == ["msgid \"old\""] && first.has_context && first.context == "menu"
    assert entries[1].has_plural && entries[1].translations == ["eins", "viele"]
    assert entries[2].obsolete && entries[2].id == "gone"

test "parse: escapes, octal and hexadecimal bytes, continuations and CRLF"
    entries = parse("msgid \"a\\tb\\\"c\\\\\"\r\n\"\\n\"\r\nmsgstr \"\\303\\251\\x41\"\r\n").must()
    assert entries[0].id == "a\tb\"c\\\n" && entries[0].translations == ["éA"]

test "parse: entries with no blank line between them"
    entries = parse("msgid \"a\"\nmsgstr \"b\"\nmsgid \"c\"\nmsgstr \"d\"\n").must()
    assert entries.len() == 2 && entries[1].translations == ["d"]

test "parse: what is broken, each with its line"
    assert parse("msgid \"a\"\n").is_err()
    assert parse("msgid \"a\nmsgstr \"b\"\n").is_err()
    assert parse("msgstr \"b\"\n").is_err()
    assert parse("msgid \"a\"\nmsgid_plural \"b\"\nmsgstr[1] \"x\"\n").is_err()
    assert parse("msgid \"a\"\nmsgstr[0] \"x\"\n").is_err()
    assert parse("msgid \"a\" x\nmsgstr \"b\"\n").is_err()
    assert parse("msgid \"\\q\"\nmsgstr \"\"\n").is_err()
    assert parse("msgid \"\\377\"\nmsgstr \"\"\n").is_err()
    assert parse("hello\n").is_err()
    assert parse("\"orphan\"\n").is_err()

    match parse("msgid \"a\"\nmsgstr \"b\"\n\nmsgid \"c\" d\n")
        .ok _  => assert false
        .err e => assert strings.has_prefix(s: e.msg, prefix: "line 4:")

test "format: a plain entry, comments, a plural, an obsolete entry and a multi-line string"
    plain = Entry(
        has_context: false,
        context: "",
        id: "Yes",
        has_plural: false,
        plural_id: "",
        translations: ["Ja"],
        comments: [],
        extracted_comments: [],
        references: [],
        flags: [],
        previous: [],
        obsolete: false
    )
    assert format([plain]) == "msgid \"Yes\"\nmsgstr \"Ja\"\n"
    commented @= plain
    commented.comments @ ["note", ""]
    commented.flags @ ["fuzzy"]
    commented.references @ ["a.c:3"]
    assert format([commented]) == "# note\n#\n#: a.c:3\n#, fuzzy\nmsgid \"Yes\"\nmsgstr \"Ja\"\n"
    lines @= plain
    lines.id @ "a\nb\n"
    lines.obsolete @ true
    assert format([lines]) == "#~ msgid \"\"\n#~ \"a\\n\"\n#~ \"b\\n\"\n#~ msgstr \"Ja\"\n"
    assert format([plain, plain]) == "msgid \"Yes\"\nmsgstr \"Ja\"\n\nmsgid \"Yes\"\nmsgstr \"Ja\"\n"

test "format: a text read back is the same entries"
    text = "# c\n#, fuzzy\nmsgctxt \"x\"\nmsgid \"a\\tb\"\nmsgid_plural \"p\"\nmsgstr[0] \"q\\u{1}\"\nmsgstr[1] \"r\"\n"
    entries = parse(strings.replace_all(s: text, old: "\\u{1}", new: "\\001")).must()
    assert parse(format(entries)).must() == entries
