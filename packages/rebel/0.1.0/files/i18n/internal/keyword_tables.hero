# The aliases of the Unicode locale keywords of CLDR release 49, which
# `i18n` reads a locale identifier of ICU's with: the long name of a key
# (`calendar`) and of a value (`gregorian`), each with the short one BCP 47
# writes (`ca`, `gregory`).
#
# Generated, never edited by hand: the Heroes program `generators/i18n_core/`
# read CLDR 49's JSON, `cldr-49.0.0-json-full.zip` of
# https://github.com/unicode-org/cldr-json/releases/download/49.0.0/
# (SHA-256
# 3b1f5d684d29c541d3acf91fe834b3fe36ae0f34775e3ee50e93558bf14ca174,
# fetched 2026-11-21), its files `cldr-bcp47/bcp47/calendar.json`,
# `collation.json`, `currency.json`, `measure.json`, `number.json`,
# `segmentation.json`, `timezone.json` and `variant.json`, and wrote this
# module whole; its `check` command says whether this module is still what
# it writes.

# The long names of the keys, in lower case, in the order of their bytes.
constant KEY_ALIASES: [str]
    [
        "calendar"
        "colalternate"
        "colbackwards"
        "colcasefirst"
        "colcaselevel"
        "colhiraganaquaternary"
        "collation"
        "colnormalization"
        "colnumeric"
        "colreorder"
        "colstrength"
        "currency"
        "hours"
        "measure"
        "numbers"
        "timezone"
        "variabletop"
    ]

# The key each names, in the order of `KEY_ALIASES`.
constant KEY_NAMES: [str]
    [
        "ca"
        "ka"
        "kb"
        "kf"
        "kc"
        "kh"
        "co"
        "kk"
        "kn"
        "kr"
        "ks"
        "cu"
        "hc"
        "ms"
        "nu"
        "tz"
        "vt"
    ]

# The long names of the values, each after its key and a space, in lower
# case, in the order of their bytes.
