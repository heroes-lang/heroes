## Writing

# How many bytes `data` takes in the code, its last one padded.
function length_of(data: [u8] lent) -> i64
    bits: i64 @= 0

    for b in data
        bits @ bits + LENGTHS[to_i64(b).must()]

    return (bits + 7) / 8

# `data` in the code, its last byte padded with the first bits of EOS, which
# are ones.
function encode(data: [u8] lent) -> [u8]
    out: [u8] @= []
    held: i64 @= 0
    count: i64 @= 0

    for b in data
        symbol = to_i64(b).must()
        held @ held << LENGTHS[symbol] | CODES[symbol]
        count @ count + LENGTHS[symbol]

        while count >= 8
            count @ count - 8
            out @ out.push(to_u8(held >> count & 0xff).must())

        held @ held & (1 << count) - 1

    if count > 0
        padded = held << 8 - count | (1 << 8 - count) - 1
        out @ out.push(to_u8(padded & 0xff).must())
    return out

## Reading

# What `decode` answers: the bytes, or the reason the code is refused.
record Decoded
    # The bytes the code held.
    data: [u8]
    # Why the code is refused, "" where it is not.
    why: str

# The bytes `data` codes, or why the code is refused: EOS inside it, padding
# longer than 7 bits, or padding that is not ones (RFC 7541 § 5.2).
function decode(data: [u8] lent) -> Decoded
    out: [u8] @= []
    code: i64 @= 0
    length: i64 @= 0

    for b in data
        byte = to_i64(b).must()
        bit: i64 @= 7

        while bit >= 0
            code @ code << 1 | byte >> bit & 1
            length @ length + 1
            bit @ bit - 1

            if length >= 5 && code - FIRST_CODE[length] < COUNT[length] && code >= FIRST_CODE[length]
                symbol = BY_LENGTH[FIRST_INDEX[length] + code - FIRST_CODE[length]]

                if symbol == 256
                    return Decoded(data: [], why: "the code holds EOS")
                out @ out.push(to_u8(symbol).must())
                code @ 0
                length @ 0
            else if length == 30
                return Decoded(data: [], why: "a code of more than 30 bits")

    if length > 7
        return Decoded(data: [], why: f"the padding is {length} bits long, and holds 7 at most")

    if code != (1 << length) - 1
        return Decoded(data: [], why: "the padding is not the first bits of EOS")
    return Decoded(data: out, why: "")

## Tests

test "encode: RFC 7541 C.4.1's www.example.com, and nothing"
    plain: [u8] = [119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109]
    want: [u8] = [0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff]
    assert encode(plain) == want
    assert length_of(plain) == 12
    assert encode([]) == []
    assert length_of([]) == 0

test "encode: no-cache, custom-key and custom-value, as C.4.2 and C.4.3 code them"
    assert encode([110, 111, 45, 99, 97, 99, 104, 101]) == [0xa8, 0xeb, 0x10, 0x64, 0x9c, 0xbf]
    assert encode([99, 117, 115, 116, 111, 109, 45, 107, 101, 121]) == [0x25, 0xa8, 0x49, 0xe9, 0x5b, 0xa9, 0x7d, 0x7f]
    assert encode([99, 117, 115, 116, 111, 109, 45, 118, 97, 108, 117, 101]) == [0x25, 0xa8, 0x49, 0xe9, 0x5b, 0xb8, 0xe8, 0xb4, 0xbf]

test "decode: every byte 0 to 255 read back as written"
    every: [u8] @= []

    for n in range(from: 0, to: 256)
        every @ every.push(to_u8(n).must())

    got = decode(encode(every))
    assert got.why == ""
    assert got.data == every
    assert length_of(every) == encode(every).len()

test "decode: the longest codes, 30 bits each, one after another"
    long: [u8] = [10, 13, 22, 10]
    got = decode(encode(long))
    assert got.why == ""
    assert got.data == long

test "decode: EOS whole, padding of 8 bits, padding of zeros, an empty code"
    assert decode([0xff, 0xff, 0xff, 0xff]).why == "the code holds EOS"
    assert decode([0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff, 0xff]).why != ""
    assert decode([0x07]).why == ""
    assert decode([0x07]).data == [48]
    assert decode([0x00]).why == "the padding is not the first bits of EOS"
    assert decode([]).why == ""
    assert decode([]).data == []
