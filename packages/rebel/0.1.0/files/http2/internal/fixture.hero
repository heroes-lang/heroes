# FOR TESTS: an HTTP/2 server and client of this process, each on a thread
# of its own, over the loopback address, plain (h2c) or TLS with the test
# certificates of `tls`. A thread takes and answers one text (spec § 13), so
# each takes its port and what to ask, and answers what it saw; a server
# listens on a port the system chooses and tells it back to the test's
# thread (`start`).

use bytes
use http2
use http2/internal/engine
use http2/internal/values
use http2/internal/wire
use io
use net
use numbers
use strings
use threads
use time
use tls

# A server running on a thread of its own, and the port it listens on.
record Started
    # The port the server listens on, the one the system chose for it, which
    # the server told back.
    port: i64
    # The server's thread, whose answer `threads.wait_text` gives.
    thread: threads.TextThread

# `body`, `serve_plain` or `serve_tls`, started on a thread of its own. The
# server listens on a port the system chooses and tells it back over a
# connection to a listener of this thread, so no port is named while
# nothing holds it, and none is let go for another program to take between
# a choice and a listen (defect 2633).
function start(body: (function(str) -> str)) -> Started
    return started(body: body, text: "")

# `serve_many` started as `start` starts a server, answering `count`
# requests.
function start_many(count: i64) -> Started
    return started(body: serve_many, text: to_str(count))

# `body` started on a thread with the port of a listener of this thread,
# then a space and `text` where it is not empty, and the port it tells back
# read.
function started(body: (function(str) -> str), text: str) -> Started
    control @= net.listen(host: "127.0.0.1", port: 0).must()

    given = if text == ""
        to_str(control.address.port)
    else
        f"{control.address.port} {text}"

    t = threads.start_text(body: body, arg: given).must()
    said = told(control)
    net.close_listener(@control).must()
    return Started(port: port_told(said).must(), thread: t)

# Tells `port`, the one a server listens on, to the listener of `start` at
# `control` after the word `told` that marks it as the server's (`told`),
# and closes.
function tell(control: i64, port: i64)
    c @= net.connect("127.0.0.1", port: control, deadline_ms: 10000).must()
    io.write_text(c.stream, text: "told " + to_str(port)).must()
    io.close(@c.stream).must()

# What a server tells `control`, the listener its starter holds: the text
# after `told ` of the first connection that says it within five seconds of
# its accept, ten connections at most and thirty seconds in all, or why none
# did. Any other connection is closed and passed over, as one another
# program makes to a port it did not choose: beside a test of `tls` that
# steers its connect to the port the system gives next, such a connection
# reached this listener and held its read to its deadline in 62 rounds of
# 3,000 (defect 2633).
function told(control: net.Listener) -> str
    net.set_accept_deadline(control, deadline_ms: 30000).must()
    tries @= 0

    while tries < 10
        tries @ tries + 1

        match net.accept(control, deadline_ms: 5000)
            .err e =>
                if e.code == net.TIMEOUT
                    return e.code + ": " + e.msg
            .ok c =>
                r @= io.reader(c.stream)
                said = io.read_rest_text(@r)

                match io.close(@r.stream)
                    .ok _  => _ = 0
                    .err _ => _ = 0

                match said
                    .ok text =>
                        if strings.has_prefix(s: text, prefix: "told ")
                            return text.slice(from: 5, to: text.len())
                    .err _ => _ = 0

    return "none of ten connections told a port"

# The port `said` names, or a failure carrying the server's words where it
# told why it listens on none.
function port_told(said: str) -> i64?
    match numbers.parse_int(said)
        .ok port => return ok(port)
        .err _   => return fail(code: "failed", msg: "the server listens on no port: " + said)

# A field.
function field(name: str, value: str) -> http2.Field
    return http2.Field(name: name, value: value, sensitive: false)

# Serves the next request of `stream` with "hello " and its path, and
# answers its method and path; "" where no request came.
function answer_one(stream: io.Stream) -> str
    w @= wire.adopt(stream, session: engine.make(client: false, options: values.default_options())).must()

    match wire.next_request(stream, @w, limit: 1048576)
        .ok r =>
            body = bytes.from_text("hello " + r.path)
            answered = wire.answer(
                stream,
                @w,
                id: r.stream,
                response: http2.Response(status: 200, headers: [field(name: "content-type", value: "text/plain")], body: body, trailers: [field(name: "x-length", value: to_str(r.body.len()))])
            )
            wire.goodbye(stream, @w)

            match answered
                .ok _  => return f"{r.method} {r.path} {r.body.len()}"
                .err e => return "answer: " + e.msg
        .err _ => return ""

# A thread's body: an h2c server on a port the system chooses, told to the
# listener `start` holds at the port `arg` names, which answers the first
# request that comes and its method, path and body's length.
function serve_plain(arg: str) -> str
    control = numbers.parse_int(arg).must()
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    tell(control: control, port: l.address.port)
    net.set_accept_deadline(l, deadline_ms: 10000).must()

    for _ in range(from: 0, to: 20)
        match net.accept(l, deadline_ms: 10000)
            .ok c =>
                stream @= c.stream
                got = answer_one(stream)

                match io.close(@stream)
                    .ok _  => _ = 0
                    .err _ => _ = 0

                if got != ""
                    net.close_listener(@l).must()
                    return got
            .err e =>
                net.close_listener(@l).must()
                return "accept: " + e.msg

    net.close_listener(@l).must()
    return "no request"

# A thread's body: a TLS server offering `h2`, with the certificate of
# `localhost`, telling its port as `serve_plain` does and answering as it
# does.
function serve_tls(arg: str) -> str
    control = numbers.parse_int(arg).must()
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: ["h2"])
    ).must()
    tell(control: control, port: l.port)
    tls.set_accept_deadline(l, deadline: time.seconds(10).must()).must()

    for _ in range(from: 0, to: 20)
        match tls.accept(l, deadline: time.seconds(10).must())
            .ok accepted =>
                stream @= accepted.stream
                tls.set_deadline(stream, deadline: time.seconds(10).must()).must()
                got = answer_one(stream)

                match io.close(@stream)
                    .ok _  => _ = 0
                    .err _ => _ = 0

                if got != ""
                    tls.close_listener(@l).must()
                    return got
            .err _ => _ = 0

    tls.close_listener(@l).must()
    return "no request"

# A GET of `path` on a client's connection over `stream`, as "status body".
function get_on(stream: io.Stream, path: str) -> str
    w @= wire.adopt(stream, session: engine.make(client: true, options: values.default_options())).must()
    request = http2.Request(
        method: "GET",
        scheme: "https",
        authority: "localhost",
        path: path,
        protocol: "",
        headers: [],
        body: [],
        trailers: [],
        stream: 0
    )

    match wire.start(stream, @w, r: request)
        .ok id =>
            match wire.finish(stream, @w, id: id, limit: 1048576)
                .ok r =>
                    wire.goodbye(stream, @w)
                    return f"{r.status} {bytes.to_text_lossy(r.body)}"
                .err e => return "finish: " + e.msg
        .err e => return "start: " + e.msg

# A thread's body: a GET over h2c, `arg` holding the port and the path
# apart by a space, answered as "status body".
function get_plain(arg: str) -> str
    cut = index_of_space_last(arg)
    port = numbers.parse_int(arg.slice(from: 0, to: cut)).must()
    c = net.connect("127.0.0.1", port: port, deadline_ms: 10000).must()
    stream @= c.stream
    got = get_on(stream, path: arg.slice(from: cut + 1, to: arg.len()))
    io.close(@stream).must()
    return got

# A thread's body: a GET over TLS with ALPN `h2`, trusting the test
# authority, `arg` as `get_plain` takes it.
function get_tls(arg: str) -> str
    cut = index_of_space_last(arg)
    port = numbers.parse_int(arg.slice(from: 0, to: cut)).must()
    stream @= tls.connect(host: "localhost", port: port, deadline: time.seconds(10).must(), client: tls.Client(roots: tls.TEST_ROOT, protocols: ["h2"])).must().stream
    tls.set_deadline(stream, deadline: time.seconds(10).must()).must()
    got = get_on(stream, path: arg.slice(from: cut + 1, to: arg.len()))
    io.close(@stream).must()
    return got

# Where the last space of `s` stands.
function index_of_space_last(s: str) -> i64
    at: i64 @= s.len() - 1

    while at >= 0 && s[at] != ' '
        at @ at - 1

    return at

# A thread's body: an h2c server on a port the system chooses, told to the
# listener `start_many` holds at the port `arg`'s first word names,
# answering as many requests on one connection as its second word says, each
# with "hello " and its path, and answering how many it answered.
function serve_many(arg: str) -> str
    cut = index_of_space_last(arg)
    control = numbers.parse_int(arg.slice(from: 0, to: cut)).must()
    count = numbers.parse_int(arg.slice(from: cut + 1, to: arg.len())).must()
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    tell(control: control, port: l.address.port)
    net.set_accept_deadline(l, deadline_ms: 10000).must()
    answered: i64 @= 0

    for _ in range(from: 0, to: 20)
        if answered < count
            match net.accept(l, deadline_ms: 10000)
                .ok c =>
                    stream @= c.stream
                    w @= wire.adopt(
                        stream,
                        session: engine.make(client: false, options: values.default_options())
                    ).must()

                    while answered < count
                        match wire.next_request(stream, @w, limit: 1048576)
                            .ok r =>
                                said = wire.answer(
                                    stream,
                                    @w,
                                    id: r.stream,
                                    response: http2.Response(status: 200, headers: [], body: bytes.from_text("hello " + r.path), trailers: [])
                                )

                                match said
                                    .ok _  => _ = 0
                                    .err _ => _ = 0

                                answered @ answered + 1
                            .err _ => break

                    wire.goodbye(stream, @w)

                    match io.close(@stream)
                        .ok _  => _ = 0
                        .err _ => _ = 0
                .err _ => break

    net.close_listener(@l).must()
    return to_str(answered)

# A handler that sends the request's body back with status 200, its
# `content-type` kept: what a test's server answers, and a server whose
# client checks what it sent.
#
# - `r`: the request.
function echo(r: http2.Request) -> http2.Response
    headers: [http2.Field] @= []

    for f in r.headers
        if f.name == "content-type"
            headers @ headers.push(f)

    return http2.Response(status: 200, headers: headers, body: r.body, trailers: [])

# A handler that answers `text` as `text/plain; charset=utf-8` with status
# 200, whatever was asked: the handler of `serve_with` whose state is the
# text, as a health check answers.
#
# - `text`: the body.
# - `r`: the request, not read.
function respond_text(text: str, r: http2.Request) -> http2.Response
    _ = r.stream
    return http2.Response(
        status: 200,
        headers: [http2.Field(name: "content-type", value: "text/plain; charset=utf-8", sensitive: false)],
        body: bytes.from_text(text),
        trailers: []
    )

test "echo: the body and its content-type sent back"
    r = echo(
        http2.Request(method: "POST", scheme: "https", authority: "h", path: "/", protocol: "", headers: [http2.Field(name: "content-type", value: "application/json", sensitive: false), http2.Field(name: "x-a", value: "b", sensitive: false)], body: [123, 125], trailers: [], stream: 1)
    )
    assert r.status == 200 && r.body == [123, 125] && r.headers == [http2.Field(name: "content-type", value: "application/json", sensitive: false)]

test "respond_text: OK as text"
    r = respond_text(
        text: "OK",
        r: http2.Request(method: "GET", scheme: "https", authority: "h", path: "/healthz", protocol: "", headers: [], body: [], trailers: [], stream: 1)
    )
    assert r.status == 200 && r.body == bytes.from_text("OK")
