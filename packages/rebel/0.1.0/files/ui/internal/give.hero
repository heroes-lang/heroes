# What a person does, given by the program through `ui.inject`: checked
# against its widget when it is queued, and given when `wait` reaches it.
# On the headless side this module is the person: it changes the table as
# the system would change its widget, and makes the event the system would
# queue. An input the person could not give makes no event: on a widget
# greyed out, or hidden, or in a box or window hidden, on a window the
# person may not resize, or a choice that changes nothing.

use time
use ui
use ui/hero_ui
use ui/internal/check
use ui/internal/desk
use ui/internal/drops
use ui/internal/failure
use ui/internal/fixture
use ui/internal/frames
use ui/internal/layout
use ui/internal/menus
use ui/internal/model
use ui/internal/session
use ui/internal/tables
use ui/internal/trees

# Fails where `input` cannot be given to `app` as its widget stands now:
# `closed` where the widget's life has ended, `invalid` where it is of
# another kind than the input acts on, or a value is outside its range.
function checked(app: ui.App, input: ui.Input) -> ()?
    match input
        .click c =>
            _ = check.node_kind(app, widget: c.widget, kinds: [hero_ui.HERO_UI_BUTTON], what: "a button")?
        .type_text t =>
            n = check.node_kind(app, widget: t.widget, kinds: [hero_ui.HERO_UI_TEXT_FIELD, hero_ui.HERO_UI_TEXT_AREA, hero_ui.HERO_UI_EDITABLE_COMBO], what: "a text field, a text area or an editable combo box")?
            check.text_ok(text: t.text, one_line: n.kind != hero_ui.HERO_UI_TEXT_AREA, what: "the text typed")?
        .choose c =>
            n = check.node_kind(app, widget: c.widget, kinds: [hero_ui.HERO_UI_LIST, hero_ui.HERO_UI_LIST_MULTIPLE, hero_ui.HERO_UI_COMBO, hero_ui.HERO_UI_EDITABLE_COMBO, hero_ui.HERO_UI_RADIO_GROUP, hero_ui.HERO_UI_TABS, hero_ui.HERO_UI_TABLE, hero_ui.HERO_UI_TREE], what: "a list, a combo box, a radio group, tabs, a table or a tree")?

            if n.kind == hero_ui.HERO_UI_TABS
                frames.page_ok(n, indices: c.indices)?
            else if n.kind == hero_ui.HERO_UI_TREE
                trees.chosen_ok(n, indices: c.indices)?

                for item in c.indices
                    trees.reached_ok(n, item: item)?
            else
                check.indices_ok(n, indices: c.indices)?

            if (n.kind == hero_ui.HERO_UI_COMBO || n.kind == hero_ui.HERO_UI_EDITABLE_COMBO || n.kind == hero_ui.HERO_UI_RADIO_GROUP) && c.indices.len() != 1
                return fail(
                    code: failure.INVALID,
                    msg: f"a person chooses exactly one item of {model.kind_name(n.kind)} {n.id}, and {c.indices.len()} were given"
                )
        .toggle t =>
            _ = check.node_kind(app, widget: t.widget, kinds: [hero_ui.HERO_UI_CHECKBOX], what: "a checkbox")?
        .slide s =>
            n = check.node_kind(app, widget: s.widget, kinds: [hero_ui.HERO_UI_SLIDER, hero_ui.HERO_UI_SPIN, hero_ui.HERO_UI_SPLIT_ROW, hero_ui.HERO_UI_SPLIT_COLUMN], what: "a slider, a spin or a split")?

            if model.is_split(n.kind)
                frames.divider_ok(s.value)?
            else if s.value < n.least || s.value > n.most
                return fail(code: failure.INVALID, msg: f"the value {s.value} is outside {n.least} to {n.most}")
        .choose_menu m =>
            _ = check.node_kind(app, widget: m.item, kinds: [hero_ui.HERO_UI_MENU_ITEM], what: "a menu item")?
        .ask_close a =>
            _ = check.node_kind(app, widget: a.window, kinds: [hero_ui.HERO_UI_WINDOW], what: "a window")?
        .resize r =>
            _ = check.node_kind(app, widget: r.window, kinds: [hero_ui.HERO_UI_WINDOW], what: "a window")?
            check.size_ok(r.width, what: "the width")?
            check.size_ok(r.height, what: "the height")?
        .answer _ => _ = 0
        .pick_files p =>
            if p.paths.len() == 0
                return fail(code: failure.INVALID, msg: "a choice of files holds one path or more, and none was given")

            for i in range(from: 0, to: p.paths.len())
                check.text_ok(text: p.paths[i], one_line: false, what: f"path {i}")?
        .cancel_files        => _ = 0
        .change_appearance _ => _ = 0
        .ask_quit _          => _ = 0
        .drop_files d        => drops.drop_ok(app, window: d.window, x: d.x, y: d.y, paths: d.paths)?
        .hand h              => session.hand_ok(app, what: h.what, items: h.items)?
        .send s =>
            _ = check.node_kind(app, widget: s.widget, kinds: [hero_ui.HERO_UI_WEBVIEW], what: "a web view")?
            check.text_ok(text: s.text, one_line: false, what: "the text sent")?
        .drag_window d =>
            _ = check.node_kind(app, widget: d.window, kinds: [hero_ui.HERO_UI_WINDOW], what: "a window")?
            desk.position_ok(app, screen: d.screen, x: d.x, y: d.y)?
        .change_state c =>
            _ = check.node_kind(app, widget: c.window, kinds: [hero_ui.HERO_UI_WINDOW], what: "a window")?
        .submit s =>
            _ = check.node_kind(app, widget: s.widget, kinds: [hero_ui.HERO_UI_TEXT_FIELD], what: "a text field")?
        .activate a =>
            n = check.node_kind(app, widget: a.widget, kinds: [hero_ui.HERO_UI_LIST, hero_ui.HERO_UI_LIST_MULTIPLE, hero_ui.HERO_UI_TABLE, hero_ui.HERO_UI_TREE], what: "a list, a table or a tree")?

            if n.kind == hero_ui.HERO_UI_TREE
                trees.reached_ok(n, item: a.index)?
            else if a.index < 0 || a.index >= model.rows_of(n)
                return fail(
                    code: failure.INVALID,
                    msg: f"row {a.index} is past the {model.rows_of(n)} rows of {model.kind_name(n.kind)} {n.id}"
                )
        .sort s =>
            n = check.node_kind(app, widget: s.widget, kinds: [hero_ui.HERO_UI_TABLE], what: "a table")?
            tables.column_ok(n, column: s.column)?
        .unfold u =>
            n = check.node_kind(app, widget: u.widget, kinds: [hero_ui.HERO_UI_TREE], what: "a tree")?
            trees.reached_ok(n, item: u.item)?

            if !trees.opens(n, item: u.item)
                return fail(
                    code: failure.INVALID,
                    msg: f"item {u.item} of tree {n.id} is not foldable and holds no item"
                )

    return ok()

# Whether the widget `input` acts on still lives; an input on no widget
# always does.
function alive(app: ui.App, input: ui.Input) -> bool
    id = match input
        .click c                                  => c.widget.id
        .type_text t                              => t.widget.id
        .choose c                                 => c.widget.id
        .toggle t                                 => t.widget.id
        .slide s                                  => s.widget.id
        .choose_menu m                            => m.item.id
        .ask_close a                              => a.window.id
        .resize r                                 => r.window.id
        .send s                                   => s.widget.id
        .drag_window d                            => d.window.id
        .change_state c                           => c.window.id
        .activate a                               => a.widget.id
        .submit s                                 => s.widget.id
        .sort s                                   => s.widget.id
        .unfold u                                 => u.widget.id
        .answer _ | .pick_files _ | .cancel_files => 0
        .change_appearance _                      => 0
        .ask_quit _                               => 0
        .drop_files d                             => d.window.id
        .hand _                                   => 0

    if id == 0
        return true
    return !model.node_of(app.table, id: id).is_err()

# Gives `input` to the headless side's table as the person would, and
# answers the events it makes: one, or none where the person could not
# have given it or it changed nothing.
function applied(@app: ui.App, input: ui.Input) -> [ui.Event]
    none: [ui.Event] = []

    match input
        .click c =>
            if reachable(app, id: c.widget.id)
                return [.clicked(widget: c.widget)]
        .type_text t =>
            if reachable(app, id: t.widget.id)
                n @= app.table.nodes[t.widget.id].must()

                if n.text != t.text
                    # A text area keeps the person's edit to undo; the
                    # caret stands at the text's end.
                    if n.kind == hero_ui.HERO_UI_TEXT_AREA
                        n.undone @ n.undone.push(n.text)
                        n.redone @ []
                    n.text @ t.text
                    n.selection_start @ -1
                    n.selection_end @ -1

                    if n.kind == hero_ui.HERO_UI_EDITABLE_COMBO
                        n.chosen @ model.chosen_by_text(n)
                    model.put(@app.table, n: n)
                    return [.text_changed(widget: t.widget, text: t.text)]
        .choose c =>
            if reachable(app, id: c.widget.id)
                n @= app.table.nodes[c.widget.id].must()

                # An editable combo's text becomes the item the person chose,
                # told as the choice and then as the text.
                if n.kind == hero_ui.HERO_UI_EDITABLE_COMBO
                    typed = n.items[c.indices[0]]
                    was = n.text
                    n.text @ typed
                    n.chosen @ c.indices
                    model.put(@app.table, n: n)

                    if was != typed
                        return [
                            .selection_changed(widget: c.widget, indices: c.indices)
                            .text_changed(widget: c.widget, text: typed)
                        ]
                    return [.selection_changed(widget: c.widget, indices: c.indices)]

                if n.chosen != c.indices
                    n.chosen @ c.indices
                    model.put(@app.table, n: n)
                    return [.selection_changed(widget: c.widget, indices: c.indices)]
        .toggle t =>
            if reachable(app, id: t.widget.id)
                n @= app.table.nodes[t.widget.id].must()
                n.value @ 1 - n.value
                model.put(@app.table, n: n)
                return [.toggled(widget: t.widget, checked: n.value == 1)]
        .slide s =>
            if reachable(app, id: s.widget.id) && model.is_split(app.table.nodes[s.widget.id].must().kind)
                return frames.dragged(@app, id: s.widget.id, value: s.value)

            if reachable(app, id: s.widget.id)
                n @= app.table.nodes[s.widget.id].must()

                if n.value != s.value
                    n.value @ s.value
                    model.put(@app.table, n: n)
                    return [.value_changed(widget: s.widget, value: s.value)]
        .choose_menu m =>
            n = app.table.nodes[m.item.id].must()

            if menus.open_item(app.table, id: n.id) && desk.open_to_person(app, window: n.window)
                menus.chosen(@app, id: n.id)
                return [.menu_chosen(item: m.item)]
        .ask_close a =>
            if desk.open_to_person(app, window: a.window.id)
                return [.close_asked(window: a.window)]
        .resize r =>
            n @= app.table.nodes[r.window.id].must()

            if desk.open_to_person(app, window: n.id) && n.resizable
                n.width @ r.width
                n.height @ r.height
                model.put(@app.table, n: n)
                nodes @= app.table.nodes
                layout.lay_out(@nodes, window: n.id)
                app.table.nodes @ nodes
                laid = app.table.nodes[n.id].must()
                return [.resized(window: r.window, width: laid.w, height: laid.h)]
        .send s =>
            # A web view showing no page runs no script that could send.
            if app.table.nodes[s.widget.id].must().web.page.len() > 0
                return [.message(widget: s.widget, text: s.text)]
        .drag_window d =>
            if desk.open_to_person(app, window: d.window.id)
                n @= app.table.nodes[d.window.id].must()
                told: [ui.Event] @= []

                if n.standing.screen != d.screen
                    told @ told.push(.screen_changed(window: d.window, screen: d.screen))
                n.standing.placed @ true
                n.standing.screen @ d.screen
                n.standing.x @ d.x
                n.standing.y @ d.y
                model.put(@app.table, n: n)
                return told.push(.moved(window: d.window, screen: d.screen, x: d.x, y: d.y))
        .change_state c =>
            code = desk.state_code(c.state)

            if desk.open_to_person(app, window: c.window.id) && app.table.nodes[c.window.id].must().standing.state != code
                told: [ui.Event] @= [.state_changed(window: c.window, state: c.state)]

                for event in desk.headless_state(@app, id: c.window.id, code: code)
                    told @ told.push(event)

                return told
        .submit s =>
            if reachable(app, id: s.widget.id)
                return [return_pressed(app, widget: s.widget)]
        .sort s =>
            if reachable(app, id: s.widget.id)
                return [tables.sorted(@app, id: s.widget.id, column: s.column, ascending: s.ascending)]
        .unfold u =>
            if reachable(app, id: u.widget.id)
                return trees.told(@app, id: u.widget.id, item: u.item, on: u.open)
        .activate a =>
            if reachable(app, id: a.widget.id)
                n @= app.table.nodes[a.widget.id].must()
                told: [ui.Event] @= []

                # The first click chooses the row alone where it is not
                # chosen, as the person's click does.
                if !chosen(n.chosen, index: a.index)
                    n.chosen @ [a.index]
                    model.put(@app.table, n: n)
                    told @ told.push(.selection_changed(widget: a.widget, indices: n.chosen))
                return told.push(.activated(widget: a.widget, index: a.index))
        .change_appearance c =>
            if c.appearance != app.appearance
                app.appearance @ c.appearance
                return [.appearance_changed(appearance: c.appearance)]
        .ask_quit q =>
            app.quits_held @ app.quits_held + 1
            return [.quit_asked(session_end: q.session_end)]
        .drop_files d =>
            return [.files_dropped(window: d.window, x: d.x, y: d.y, paths: d.paths)]
        .hand h =>
            return session.handed(what: h.what, items: h.items)
        .answer _ | .pick_files _ | .cancel_files =>
            _ = 0

    return none

# What Return pressed in text field `widget` gives: its window's button for
# Return clicked where it has one the person can reach, as the systems'
# dialogs do, else the field submitted.
function return_pressed(app: ui.App, widget: ui.Widget) -> ui.Event
    held = key_button(app, window: app.table.nodes[widget.id].must().window, key: hero_ui.HERO_UI_BUTTON_KEY_ENTER)

    if held != 0
        return .clicked(widget: check.widget_of(app, id: held))
    return .submitted(widget: widget)

# The button of window `window` that `key` presses, where the person can
# reach it; 0, the number no widget takes, where none is.
function key_button(app: ui.App, window: i64, key: i64) -> i64
    for id in keys(app.table.nodes)
        n = app.table.nodes[id].must()

        if n.window == window && n.kind == hero_ui.HERO_UI_BUTTON && n.button_key == key && reachable(app, id: id)
            return id

    return 0

# Whether `indices` holds `index`.
function chosen(indices: [i64], index: i64) -> bool
    for at in indices
        if at == index
            return true

    return false

# Whether the person can reach widget `id`: it is enabled, and it and every
# box up to its window, and the window, are shown, and no other window of
# the app is modal.
function reachable(app: ui.App, id: i64) -> bool
    n = app.table.nodes[id].must()

    if !n.enabled
        return false
    at @= id

    while at != 0
        node = app.table.nodes[at].must()

        if !node.visible || !frames.shown_page(app.table, id: at)
            return false

        if node.kind == hero_ui.HERO_UI_WINDOW
            return desk.open_to_person(app, window: node.id)
        at @ node.parent

    return true

## Tests

# Every event `app` gives within `within`, each come within it of the last,
# until a wait runs out or, on the headless side, finds the inputs spent and
# no timer running (`closed`). A wait that fails otherwise aborts with its
# own words, so a refusal, `unsupported` among them, is never read as no
# event.
function events_of(@app: ui.App, within: time.Duration) -> [ui.Event]
    out: [ui.Event] @= []

    while true
        next = ui.wait(@app, within: within)
        code = fixture.code_of(next)

        if code == ui.TIMEOUT || code == ui.CLOSED
            break

        out @ out.push(next.must())

    return out

test "activate: a row not chosen is chosen first and then opened, a chosen one opened alone, in a list of one choice and of several (feature 2685)"
    app @= fixture.test_app()
    w = fixture.window_of(app)
    files = ui.list(@app, into: w, items: ["a.txt", "b.txt", "c.txt"], multiple: false).must()
    many = ui.list(@app, into: w, items: ["x", "y", "z"], multiple: true).must()
    ui.set_selection(@app, widget: many, indices: [0, 2]).must()
    ui.inject(@app, input: .activate(widget: files, index: 1)).must()
    ui.inject(@app, input: .activate(widget: files, index: 1)).must()
    ui.inject(@app, input: .activate(widget: many, index: 2)).must()
    ui.inject(@app, input: .activate(widget: many, index: 1)).must()
    expected: [ui.Event] = [
        .selection_changed(widget: files, indices: [1])
        .activated(widget: files, index: 1)
        .activated(widget: files, index: 1)
        .activated(widget: many, index: 2)
        .selection_changed(widget: many, indices: [1])
        .activated(widget: many, index: 1)
    ]
    assert events_of(@app, within: time.nanoseconds(0)) == expected
    ui.close(@app).must()

test "activate: the first row and the last, a row past the items and one below 0 invalid, a list greyed out or hidden opens nothing, and a widget no list invalid"
    app @= fixture.test_app()
    w = fixture.window_of(app)
    files = ui.list(@app, into: w, items: ["a", "b"], multiple: false).must()
    button = ui.button(@app, into: w, text: "Open").must()
    ui.inject(@app, input: .activate(widget: files, index: 0)).must()
    ui.inject(@app, input: .activate(widget: files, index: 1)).must()
    assert events_of(@app, within: time.nanoseconds(0)).len() == 4
    assert fixture.code_of(ui.inject(@app, input: .activate(widget: files, index: 2))) == ui.INVALID
    assert fixture.code_of(ui.inject(@app, input: .activate(widget: files, index: -1))) == ui.INVALID
    assert fixture.code_of(ui.inject(@app, input: .activate(widget: button, index: 0))) == ui.INVALID
    ui.set_enabled(@app, widget: files, on: false).must()
    ui.inject(@app, input: .activate(widget: files, index: 0)).must()
    ui.set_enabled(@app, widget: files, on: true).must()
    ui.set_visible(@app, widget: files, on: false).must()
    ui.inject(@app, input: .activate(widget: files, index: 0)).must()
    assert events_of(@app, within: time.nanoseconds(0)).len() == 0
    ui.close(@app).must()

test "activate: on the native side a row opened through the system's own path, after the choice its first click gave (feature 2685)"
    if hero_ui.native_here() == 0
        skip_test(
            reason: "no native user interface for this session: no window server, no window station that shows, or no display named"
        )
    app @= ui.open(.native).must()
    w = ui.window(@app, title: "Files", width: 240, height: 160).must()
    files = ui.list(@app, into: w, items: ["a.txt", "b.txt", "c.txt"], multiple: false).must()
    ui.inject(@app, input: .activate(widget: files, index: 2)).must()
    offered = ui.wait(@app, within: time.milliseconds(300).must())
    refusal = fixture.unsupported_words(offered)

    if refusal != ""
        ui.close(@app).must()
        skip_test(reason: refusal)

    assert offered.must() == .selection_changed(widget: files, indices: [2])
    ui.inject(@app, input: .activate(widget: files, index: 2)).must()
    told = events_of(@app, within: time.milliseconds(300).must())
    assert told == [.activated(widget: files, index: 2), .activated(widget: files, index: 2)]
    assert ui.selection_of(app, widget: files).must() == [2]
    assert fixture.code_of(ui.inject(@app, input: .activate(widget: files, index: 3))) == ui.INVALID
    ui.close(@app).must()

test "submit: Return in a text field submitted, or its window's button for Return clicked where the person reaches it; a widget no text field invalid (catalogue CT15, CT04)"
    app @= fixture.test_app()
    w = fixture.window_of(app)
    field = ui.text_field(@app, into: w, text: "find").must()
    area = ui.text_area(@app, into: w, text: "").must()
    ok_button = ui.button(@app, into: w, text: "OK").must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert ui.wait(@app, within: time.nanoseconds(0)).must() == .submitted(widget: field)
    ui.set_button_key(@app, widget: ok_button, key: .enter).must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert ui.wait(@app, within: time.nanoseconds(0)).must() == .clicked(widget: ok_button)
    ui.set_enabled(@app, widget: ok_button, on: false).must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert ui.wait(@app, within: time.nanoseconds(0)).must() == .submitted(widget: field)
    ui.set_enabled(@app, widget: field, on: false).must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert fixture.code_of(ui.wait(@app, within: time.nanoseconds(0))) == ui.CLOSED
    assert fixture.code_of(ui.inject(@app, input: .submit(widget: area))) == ui.INVALID
    ui.close(@app).must()

test "submit: on the native side Return in a text field submitted, and its window's default button clicked once it has one (catalogue CT15, CT04)"
    if hero_ui.native_here() == 0
        skip_test(
            reason: "no native user interface for this session: no window server, no window station that shows, or no display named"
        )
    app @= ui.open(.native).must()
    w = ui.window(@app, title: "Find", width: 240, height: 100).must()
    field = ui.text_field(@app, into: w, text: "find").must()
    ok_button = ui.button(@app, into: w, text: "OK").must()
    cancel = ui.button(@app, into: w, text: "Cancel").must()
    ui.inject(@app, input: .submit(widget: field)).must()
    offered = ui.wait(@app, within: time.milliseconds(300).must())
    refusal = fixture.unsupported_words(offered)

    if refusal != ""
        ui.close(@app).must()
        skip_test(reason: refusal)

    assert offered.must() == .submitted(widget: field)
    assert events_of(@app, within: time.milliseconds(300).must()) == []
    ui.set_button_key(@app, widget: ok_button, key: .enter).must()
    ui.set_button_key(@app, widget: cancel, key: .escape).must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert events_of(@app, within: time.milliseconds(300).must()) == [.clicked(widget: ok_button)]
    ui.set_button_key(@app, widget: ok_button, key: .none).must()
    ui.inject(@app, input: .submit(widget: field)).must()
    assert events_of(@app, within: time.milliseconds(300).must()) == [.submitted(widget: field)]
    ui.close(@app).must()
