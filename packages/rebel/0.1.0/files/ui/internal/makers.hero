# The beginnings and ends of `ui`'s lives: an app opened and closed, and
# each widget, box, window, menu and timer made, numbered and added to the
# table, its native widget made with it on the native side, and destroyed
# with what it holds. Each maker checks every argument before it takes a
# number, so a refusal changes nothing.

use image
use time
use ui
use ui/hero_ui
use ui/internal/check
use ui/internal/clock
use ui/internal/desk
use ui/internal/dialogs
use ui/internal/failure
use ui/internal/fixture
use ui/internal/model
use ui/internal/native
use ui/internal/sizes

# The shortest period a timer takes, a millisecond, in nanoseconds.
constant LEAST_PERIOD: i64
    1000000

# The longest period a timer takes, a day, in nanoseconds.
constant MOST_PERIOD: i64
    86400000000000

# A new app on `backend` (`ui.open`).
function open(backend: ui.Backend) -> ui.App?
    side = match backend
        .native   => hero_ui.HERO_UI_NATIVE
        .headless => hero_ui.HERO_UI_HEADLESS
        .automatic =>
            if hero_ui.native_here() == 1
                hero_ui.HERO_UI_NATIVE
            else
                hero_ui.HERO_UI_HEADLESS

    on_system = side == hero_ui.HERO_UI_NATIVE

    # The clock is read before the app opens, so no failure can leave a
    # handle open behind it.
    opened = if on_system
        time.mark()?
    else
        time.Mark(nanoseconds: 0)

    handle = hero_ui.open(side)

    if handle == nullptr
        return failure.last("opening an app")
    number = hero_ui.number(handle)
    return ok(
        ui.App(handle: handle, number: number, native: on_system, table: model.empty(), icon: desk.no_icon(), clipboard: .nothing, inputs: [], events: [], answers: [], choices: [], prints: [], shown: [], dialogs_made: 0, docked: true, notices: [], appearance: .light, quits_held: 0, identity: "", windowed: false, claimed: false, clock: 0, opened: opened)
    )

# Closes `app` (`ui.close`).
function close(@app: ui.App) -> ()?
    check.opened(app)?
    answer = hero_ui.close(@app.handle)
    app.handle @ nullptr
    app.table @ model.empty()
    app.inputs @ []
    app.events @ []
    app.answers @ []
    app.choices @ []
    app.prints @ []
    app.shown @ []

    if answer != 0
        return failure.last("closing the app")
    return ok()

# A new window (`ui.window`).
function window(@app: ui.App, title: str, width: i64, height: i64) -> ui.Widget?
    check.opened(app)?
    check.text_ok(text: title, one_line: true, what: "the title")?
    check.size_ok(width, what: "the width")?
    check.size_ok(height, what: "the height")?
    id = model.take_id(@app.table)
    n @= model.blank(id: id, kind: hero_ui.HERO_UI_WINDOW, parent: 0, window: id)
    n.text @ title
    n.width @ width
    n.height @ height
    n.padding @ model.WINDOW_PADDING
    made = added(@app, n: n)?
    app.windowed @ true
    return ok(made)

# A new widget or box of `kind` in `into`, showing `text` or holding
# `items`: the first item chosen for a combo box or a radio group.
function make(@app: ui.App, into: ui.Widget, kind: i64, text: str, items: [str]) -> ui.Widget?
    parent = boxed(app, into: into)?
    one_line = kind != hero_ui.HERO_UI_LABEL && kind != hero_ui.HERO_UI_TEXT_AREA
    check.text_ok(text: text, one_line: one_line, what: "the text")?
    check.items_ok(items)?
    n @= model.blank(id: model.take_id(@app.table), kind: kind, parent: parent.id, window: parent.window)
    n.text @ text
    n.items @ items

    if (kind == hero_ui.HERO_UI_COMBO || kind == hero_ui.HERO_UI_RADIO_GROUP) && items.len() > 0
        n.chosen @ [0]

    if kind == hero_ui.HERO_UI_EDITABLE_COMBO
        n.chosen @ model.chosen_by_text(n)
    return added(@app, n: n)

# A new separator (`ui.separator`), filling its box across.
function separator(@app: ui.App, into: ui.Widget) -> ui.Widget?
    parent = boxed(app, into: into)?
    n @= model.blank(
        id: model.take_id(@app.table),
        kind: hero_ui.HERO_UI_SEPARATOR,
        parent: parent.id,
        window: parent.window
    )
    n.fill @ true
    return added(@app, n: n)

# A new text field whose text is masked (`ui.password_field`).
function password_field(@app: ui.App, into: ui.Widget, text: str) -> ui.Widget?
    parent = boxed(app, into: into)?
    check.text_ok(text: text, one_line: true, what: "the text")?
    n @= model.blank(
        id: model.take_id(@app.table),
        kind: hero_ui.HERO_UI_TEXT_FIELD,
        parent: parent.id,
        window: parent.window
    )
    n.text @ text
    n.masked @ true
    return added(@app, n: n)

# A new grid of `columns` in `into` (`ui.grid`).
function grid(@app: ui.App, into: ui.Widget, columns: i64) -> ui.Widget?
    parent = boxed(app, into: into)?

    if columns < 1 || columns > ui.MOST_STRETCH
        return fail(code: failure.INVALID, msg: f"a grid of {columns} columns; it takes 1 to {ui.MOST_STRETCH}")
    n @= model.blank(
        id: model.take_id(@app.table),
        kind: hero_ui.HERO_UI_GRID,
        parent: parent.id,
        window: parent.window
    )
    n.columns @ columns
    return added(@app, n: n)

# Has a widget of a grid take `columns` of its columns (`ui.set_span`).
function set_span(@app: ui.App, widget: ui.Widget, columns: i64) -> ()?
    n @= check.node_of(app, widget: widget)?
    found = model.node_of(app.table, id: n.parent)

    if found.is_err() || found.must().kind != hero_ui.HERO_UI_GRID
        return fail(code: failure.INVALID, msg: f"widget {n.id} stands in no grid, whose columns alone a widget spans")
    box = found.must()

    if columns < 1 || columns > box.columns
        return fail(
            code: failure.INVALID,
            msg: f"a span of {columns} columns in a grid of {box.columns}; it takes 1 to {box.columns}"
        )
    n.span @ columns
    model.put(@app.table, n: n)
    model.marks_dirty(@app.table, window: n.window)
    return ok()

# A new checkbox (`ui.checkbox`).
function checkbox(@app: ui.App, into: ui.Widget, text: str, checked: bool) -> ui.Widget?
    parent = boxed(app, into: into)?
    check.text_ok(text: text, one_line: true, what: "the text")?
    n @= model.blank(
        id: model.take_id(@app.table),
        kind: hero_ui.HERO_UI_CHECKBOX,
        parent: parent.id,
        window: parent.window
    )
    n.text @ text
    n.value @ check.number_of(checked)
    return added(@app, n: n)

# A new slider or progress bar of `kind`, running from `least` to `most`, at
# `value`.
function ranged(@app: ui.App, into: ui.Widget, kind: i64, least: i64, most: i64, value: i64) -> ui.Widget?
    parent = boxed(app, into: into)?

    if least >= most
        return fail(
            code: failure.INVALID,
            msg: f"a range from {least} to {most}; its lowest value must be below its highest"
        )

    if value < least || value > most
        return fail(code: failure.INVALID, msg: f"the value {value} is outside {least} to {most}")
    n @= model.blank(id: model.take_id(@app.table), kind: kind, parent: parent.id, window: parent.window)
    n.least @ least
    n.most @ most
    n.value @ value
    return added(@app, n: n)

# A new picture of `img` (`ui.picture`).
function picture(@app: ui.App, into: ui.Widget, img: image.Image) -> ui.Widget?
    parent = boxed(app, into: into)?
    n @= model.blank(id: 0, kind: hero_ui.HERO_UI_IMAGE, parent: parent.id, window: parent.window)
    with_pixels(@n, img: img)?
    n.id @ model.take_id(@app.table)
    return added(@app, n: n)

# Gives `n` the pixels of `img` as 8-bit RGBA, its sides as its width and
# height. Fails `invalid` where `img` is not a valid image or a side is past
# `ui.MOST_SIZE`.
function with_pixels(@n: model.Node, img: image.Image) -> ()?
    if !image.is_valid(img)
        return fail(
            code: failure.INVALID,
            msg: f"the image of {img.width} by {img.height} holds {img.pixels.len()} bytes, which its format does not fill"
        )
    check.size_ok(img.width, what: "the image's width")?
    check.size_ok(img.height, what: "the image's height")?
    rgba = image.convert(img, to: .rgba)
    n.width @ rgba.width
    n.height @ rgba.height
    n.pixels @ rgba.pixels
    return ok()

# A new menu, menu item or separator of `kind` in `into`, showing `text`.
function menu_part(@app: ui.App, into: ui.Widget, kind: i64, text: str) -> ui.Widget?
    parent = if kind == hero_ui.HERO_UI_MENU
        check.node_kind(app, widget: into, kinds: [hero_ui.HERO_UI_WINDOW, hero_ui.HERO_UI_MENU, hero_ui.HERO_UI_CONTEXT_MENU], what: "a window, a menu or a context menu")?
    else
        check.node_kind(app, widget: into, kinds: [hero_ui.HERO_UI_MENU, hero_ui.HERO_UI_CONTEXT_MENU], what: "a menu or a context menu")?

    check.text_ok(text: text, one_line: true, what: "the text")?
    n @= model.blank(id: model.take_id(@app.table), kind: kind, parent: parent.id, window: parent.window)
    n.text @ text
    return added(@app, n: n)

# A new context menu of `widget` (`ui.context_menu`): one a widget, on a
# widget the person clicks or a window's content.
function context_menu(@app: ui.App, widget: ui.Widget) -> ui.Widget?
    n = check.node_of(app, widget: widget)?

    if n.kind == hero_ui.HERO_UI_MENU || n.kind == hero_ui.HERO_UI_MENU_ITEM || n.kind == hero_ui.HERO_UI_MENU_SEPARATOR || n.kind == hero_ui.HERO_UI_CONTEXT_MENU || n.kind == hero_ui.HERO_UI_TIMER || n.kind == hero_ui.HERO_UI_PAGE || n.kind == hero_ui.HERO_UI_PANE || !model.is_native(n.kind)
        return fail(
            code: failure.INVALID,
            msg: f"a {model.kind_name(n.kind)} takes no context menu: a widget the person clicks, a window or a tray icon does"
        )

    for each in n.menus
        if app.table.nodes[each].must().kind == hero_ui.HERO_UI_CONTEXT_MENU
            return fail(code: failure.INVALID, msg: f"widget {n.id} has a context menu already, menu {each}")

    made = model.blank(
        id: model.take_id(@app.table),
        kind: hero_ui.HERO_UI_CONTEXT_MENU,
        parent: n.id,
        window: n.window
    )
    return added(@app, n: made)

# A new tray icon showing `text` (`ui.tray`): a node of no window, its
# parent 0.
function tray(@app: ui.App, text: str) -> ui.Widget?
    check.opened(app)?
    check.text_ok(text: text, one_line: true, what: "the text")?
    n @= model.blank(id: model.take_id(@app.table), kind: hero_ui.HERO_UI_TRAY, parent: 0, window: 0)
    n.text @ text
    return added(@app, n: n)

# A new timer of `every` (`ui.timer`).
function timer(@app: ui.App, every: time.Duration) -> ui.Widget?
    check.opened(app)?

    if every.nanoseconds < LEAST_PERIOD || every.nanoseconds > MOST_PERIOD
        return fail(
            code: failure.INVALID,
            msg: f"a timer of {every.nanoseconds} nanoseconds; it takes a millisecond to a day"
        )
    now = clock.now(app)?
    n @= model.blank(id: model.take_id(@app.table), kind: hero_ui.HERO_UI_TIMER, parent: 0, window: 0)
    n.every @ every.nanoseconds
    n.due @ now + every.nanoseconds
    return added(@app, n: n)

# Destroys `widget` and what it holds (`ui.destroy`).
function destroy(@app: ui.App, widget: ui.Widget) -> ()?
    n = check.node_of(app, widget: widget)?
    natives: [i64] @= []

    going = model.subtree(app.table, id: n.id)

    for id in going
        if model.is_native(app.table.nodes[id].must().kind)
            natives @ natives.push(id)

    _ = model.remove(@app.table, id: n.id)
    dialogs.closed_with(@app, ids: going)

    if app.native
        for id in natives
            native.destroyed(app, id: id)?

    return ok()

# The node of `into`, a window or a box that holds widgets.
function boxed(app: ui.App, into: ui.Widget) -> model.Node?
    return check.node_kind(
        app,
        widget: into,
        kinds: [hero_ui.HERO_UI_WINDOW, hero_ui.HERO_UI_ROW, hero_ui.HERO_UI_COLUMN, hero_ui.HERO_UI_GRID, hero_ui.HERO_UI_PAGE, hero_ui.HERO_UI_SCROLL, hero_ui.HERO_UI_PANE, hero_ui.HERO_UI_GROUP],
        what: "a window, a row, a column, a grid, a page, a scrolled box, a pane or a group box"
    )

# Adds `n`, a node of a new number, to `app`: on the native side its widget
# is made first, given its state, measured and shown as its boxes are; on
# the headless side it is measured by `sizes`. Where the native side
# refuses, the widget it made is destroyed again and nothing is added.
function added(@app: ui.App, n: model.Node) -> ui.Widget?
    node @= n

    if app.native && model.is_native(n.kind)
        match native.made(app, n: node)
            .ok _ => _ = 0
            .err e =>
                _ = native.destroyed(app, id: n.id).is_err()
                return fail(code: e.code, msg: e.msg)

        match measure(app, n: node)
            .ok size =>
                node.preferred_width @ size[0]
                node.preferred_height @ size[1]
            .err e =>
                _ = native.destroyed(app, id: n.id).is_err()
                return fail(code: e.code, msg: e.msg)
    else
        size = sizes.of(node)
        node.preferred_width @ size[0]
        node.preferred_height @ size[1]
    model.add(@app.table, n: node)

    if app.native && model.is_native(n.kind) && model.is_placed(n.kind)
        native.shown(app, nodes: app.table.nodes, id: n.id)?
    return ok(check.widget_of(app, id: n.id))

# The size the system draws `n` at, `[0, 0]` for a window or a menu's part,
# which the layout does not place.
function measure(app: ui.App, n: model.Node) -> [i64]?
    if !model.is_placed(n.kind)
        return ok([0, 0])
    return native.measure(app, n: n)

test "set_span: a field across two columns of a form placed under its label and its neighbour, refused outside a grid, at 0 and past the grid's columns (catalogue LY03)"
    app @= fixture.test_app()
    shown = fixture.window_of(app)
    form = ui.grid(@app, into: shown, columns: 2).must()
    name = ui.label(@app, into: form, text: "Name").must()
    first = ui.text_field(@app, into: form, text: "").must()
    notes = ui.text_area(@app, into: form, text: "").must()
    alone = ui.button(@app, into: shown, text: "OK").must()
    assert fixture.code_of(ui.set_span(@app, widget: alone, columns: 1)) == ui.INVALID
    assert fixture.code_of(ui.set_span(@app, widget: notes, columns: 0)) == ui.INVALID
    assert fixture.code_of(ui.set_span(@app, widget: notes, columns: 3)) == ui.INVALID
    ui.set_span(@app, widget: notes, columns: 2).must()
    label_at = ui.rect_of(@app, widget: name).must()
    field_at = ui.rect_of(@app, widget: first).must()
    notes_at = ui.rect_of(@app, widget: notes).must()

    # The area starts the second row under the label, the field beside the
    # label in the first.
    assert notes_at.x == label_at.x && notes_at.y > field_at.y && field_at.x > label_at.x
    ui.close(@app).must()

test "separator: across a column between two widgets, one point high and as wide as the column, down a row one point wide (catalogue LY12)"
    app @= fixture.test_app()
    shown = fixture.window_of(app)
    above = ui.button(@app, into: shown, text: "Above the line").must()
    line = ui.separator(@app, into: shown).must()
    below = ui.button(@app, into: shown, text: "Below").must()
    side = ui.row(@app, into: shown).must()
    _ = ui.label(@app, into: side, text: "Left").must()
    upright = ui.separator(@app, into: side).must()
    _ = ui.label(@app, into: side, text: "Right").must()
    assert ui.kind_of(app, widget: line).must() == .separator
    at = ui.rect_of(@app, widget: line).must()
    top = ui.rect_of(@app, widget: above).must()
    bottom = ui.rect_of(@app, widget: below).must()
    down = ui.rect_of(@app, widget: upright).must()
    assert at.height == 1 && at.y > top.y && at.y < bottom.y && at.width >= top.width
    assert down.width == 1 && down.height >= 1
    ui.close(@app).must()

test "separator: on the native side the system's line made and placed across its column (catalogue LY12)"
    if hero_ui.native_here() == 0
        skip_test(reason: desk.NO_NATIVE)
    app @= ui.open(.native).must()
    shown = ui.window(@app, title: "Line", width: 200, height: 100).must()
    _ = ui.button(@app, into: shown, text: "Above").must()
    made = ui.separator(@app, into: shown)
    refusal = fixture.unsupported_words(made)

    if refusal != ""
        ui.close(@app).must()
        skip_test(reason: refusal)
    line = made.must()
    _ = ui.button(@app, into: shown, text: "Below").must()
    at = ui.rect_of(@app, widget: line).must()
    _ = ui.wait(@app, within: time.milliseconds(50).must()).is_err()
    ui.close(@app).must()
    assert at.height == 1 && at.width > 100
