# The native side of an app: each node the table holds that the system
# draws is made by the floor `ui/hero_ui` under the same number, every
# change of its state pushed to it, its place set from the layout, and what
# the person changed read back from it. The table stays the truth of what
# the program set; the system is the truth of what the person typed, chose
# and dragged, read at each event. Only a native app calls this module.

use bytes
use ui
use ui/hero_ui
use ui/internal/desk
use ui/internal/failure
use ui/internal/model

# The bytes a text is first read into; a longer one is read again with room
# for it.
constant TEXT_ROOM: i64
    4096

# Makes `n`'s native widget and pushes every part of its state to it.
function made(app: ui.App, n: model.Node) -> ()?
    if hero_ui.create(app.handle, id: n.id, kind: n.kind, parent: native_parent(app, n: n)) < 0
        return failure.last(f"making the {model.kind_name(n.kind)} {n.id}")

    # A table's columns stand before its cells, which fill them.
    if n.kind == hero_ui.HERO_UI_TABLE
        push_columns(app, n: n)?

        if n.items.len() > 0
            push_items(app, n: n)?

    if model.has_text(n.kind) && n.text.len() > 0
        push_text(app, n: n)?

    if model.has_items(n.kind)
        push_items(app, n: n)?

    if model.has_range(n.kind)
        push_range(app, n: n)?

    if model.has_range(n.kind) || n.kind == hero_ui.HERO_UI_CHECKBOX
        push_value(app, n: n)?

    if n.kind == hero_ui.HERO_UI_IMAGE || n.kind == hero_ui.HERO_UI_TRAY && n.pixels.len() > 0
        push_image(app, n: n)?

    if n.masked && hero_ui.set_masked(app.handle, id: n.id, on: 1) < 0
        return failure.last(f"masking text field {n.id}")

    if n.kind == hero_ui.HERO_UI_MENU_ITEM && n.check != hero_ui.HERO_UI_CHECK_NONE
        if hero_ui.set_check(app.handle, id: n.id, mode: n.check) < 0
            return failure.last(f"making menu item {n.id} checkable")

        if hero_ui.set_value(app.handle, id: n.id, value: n.value) < 0
            return failure.last(f"checking menu item {n.id}")

    if n.kind == hero_ui.HERO_UI_WINDOW
        if hero_ui.set_size(app.handle, id: n.id, width: n.width, height: n.height) < 0
            return failure.last(f"sizing window {n.id}")
    return ok()

# The native parent of `n`: none for a window and a tray icon; the menu for a menu's item
# and a menu inside a menu; the tabs for a page and the split for a pane;
# the widget for its context menu;
# for every other widget the frame it stands in, the nearest window, page,
# scrolled box or pane over it.
function native_parent(app: ui.App, n: model.Node) -> i64
    if n.kind == hero_ui.HERO_UI_WINDOW || n.kind == hero_ui.HERO_UI_TRAY
        return 0

    if n.kind == hero_ui.HERO_UI_MENU_ITEM || n.kind == hero_ui.HERO_UI_MENU_SEPARATOR || n.kind == hero_ui.HERO_UI_PAGE || n.kind == hero_ui.HERO_UI_PANE || n.kind == hero_ui.HERO_UI_CONTEXT_MENU
        return n.parent

    # A menu inside a menu, or a context menu, stands in that menu.
    if n.kind == hero_ui.HERO_UI_MENU && (app.table.nodes[n.parent].must().kind == hero_ui.HERO_UI_MENU || app.table.nodes[n.parent].must().kind == hero_ui.HERO_UI_CONTEXT_MENU)
        return n.parent
    at @= n.parent

    while !model.is_frame(app.table.nodes[at].must().kind)
        at @ app.table.nodes[at].must().parent

    return at

# Pushes `n`'s text.
function push_text(app: ui.App, n: model.Node) -> ()?
    text @= bytes.from_text(n.text)

    if hero_ui.set_text(app.handle, id: n.id, @text, count: to_u64(text.len()).must()) < 0
        return failure.last(f"setting the text of widget {n.id}")
    return ok()

# Pushes `n`'s items, then what it has chosen.
function push_items(app: ui.App, n: model.Node) -> ()?
    joined: [u8] @= []

    for item in n.items
        bytes.push_text(@joined, s: item)
        joined @ joined.push(0)

    if hero_ui.set_items(app.handle, id: n.id, @joined, count: to_u64(joined.len()).must()) < 0
        return failure.last(f"setting the items of widget {n.id}")
    return push_chosen(app, n: n)

# Pushes table `n`'s columns, and the column it is sorted by.
function push_columns(app: ui.App, n: model.Node) -> ()?
    titles: [u8] @= []

    for title in n.titles
        bytes.push_text(@titles, s: title)
        titles @ titles.push(0)

    if hero_ui.set_columns(app.handle, id: n.id, @titles, count: to_u64(titles.len()).must()) < 0
        return failure.last(f"giving table {n.id} its columns")

    if hero_ui.set_sort(app.handle, id: n.id, column: n.sorted_by, ascending: number_of(n.ascending)) < 0
        return failure.last(f"showing the sort of table {n.id}")
    return ok()

# Pushes what `n`, a list, a combo box, a radio group, tabs, a table or a
# tree, has chosen.
function push_chosen(app: ui.App, n: model.Node) -> ()?
    if n.kind == hero_ui.HERO_UI_LIST || n.kind == hero_ui.HERO_UI_LIST_MULTIPLE || n.kind == hero_ui.HERO_UI_TABS || n.kind == hero_ui.HERO_UI_TABLE || n.kind == hero_ui.HERO_UI_TREE
        chosen @= n.chosen

        if hero_ui.set_selection(app.handle, id: n.id, @chosen, count: to_u64(chosen.len()).must()) < 0
            return failure.last(f"choosing items of widget {n.id}")
        return ok()

    at = if n.chosen.len() > 0
        n.chosen[0]
    else
        -1

    if hero_ui.set_value(app.handle, id: n.id, value: at) < 0
        return failure.last(f"choosing an item of widget {n.id}")
    return ok()

# Pushes `n`'s value: a checkbox's state, a slider's or a progress bar's
# value.
function push_value(app: ui.App, n: model.Node) -> ()?
    if hero_ui.set_value(app.handle, id: n.id, value: n.value) < 0
        return failure.last(f"setting the value of widget {n.id}")
    return ok()

# Pushes the range of `n`, a slider or a progress bar.
function push_range(app: ui.App, n: model.Node) -> ()?
    if hero_ui.set_range(app.handle, id: n.id, least: n.least, most: n.most) < 0
        return failure.last(f"setting the range of widget {n.id}")
    return ok()

# Pushes whether the person may use `n`.
function push_enabled(app: ui.App, n: model.Node) -> ()?
    if hero_ui.set_enabled(app.handle, id: n.id, on: number_of(n.enabled)) < 0
        return failure.last(f"enabling widget {n.id}")
    return ok()

# Pushes `n`'s pixels.
function push_image(app: ui.App, n: model.Node) -> ()?
    pixels @= n.pixels

    if hero_ui.set_image(app.handle, id: n.id, @pixels, count: to_u64(pixels.len()).must(), width: n.width, height: n.height) < 0
        return failure.last(f"setting the pixels of picture {n.id}")
    return ok()

# Pushes the shortcut of menu item `n`.
function push_shortcut(app: ui.App, n: model.Node) -> ()?
    key @= bytes.from_text(n.key)

    if hero_ui.set_shortcut(app.handle, id: n.id, @key, count: to_u64(key.len()).must(), modifiers: n.modifiers) < 0
        return failure.last(f"setting the shortcut of item {n.id}")
    return ok()

# Pushes whether the person may resize window `n`.
function push_resizable(app: ui.App, n: model.Node) -> ()?
    if hero_ui.set_resizable(app.handle, id: n.id, on: number_of(n.resizable)) < 0
        return failure.last(f"setting whether window {n.id} resizes")
    return ok()

# The size the system draws `n` at, as `[width, height]` in points.
function measure(app: ui.App, n: model.Node) -> [i64]?
    width @= 0
    height @= 0

    if hero_ui.preferred(app.handle, id: n.id, width: @width, height: @height) < 0
        return failure.last(f"measuring widget {n.id}")
    return ok([width, height])

# Places every native widget of window `window` at the rectangle the layout
# gave it, the items of a radio group one under another in equal parts of
# its own, and gives the window the size the layout found and the least size
# it needs.
function placed(app: ui.App, nodes: {i64: model.Node}, window: i64) -> ()?
    w = nodes[window].must()

    if hero_ui.set_min_size(app.handle, id: window, width: w.need_width, height: w.need_height) < 0
        return failure.last(f"setting the least size of window {window}")

    if hero_ui.set_size(app.handle, id: window, width: w.w, height: w.h) < 0
        return failure.last(f"sizing window {window}")

    for id in model.subtree(model.Model(nodes: nodes, next_id: 0, windows: [], timers: [], trays: []), id: window)
        n = nodes[id].must()

        # The system sizes a page and a pane itself.
        if !model.is_native(n.kind) || !model.is_placed(n.kind) || n.kind == hero_ui.HERO_UI_PAGE || n.kind == hero_ui.HERO_UI_PANE
            continue

        if hero_ui.place(app.handle, id: id, x: n.x, y: n.y, width: n.w, height: n.h) < 0
            return failure.last(f"placing widget {id}")

        if n.kind == hero_ui.HERO_UI_SCROLL && hero_ui.set_size(app.handle, id: id, width: n.width, height: n.height) < 0
            return failure.last(f"sizing the content of scrolled box {id}")

        # A split's divider is placed after the split, which lays its panes
        # out anew as it is placed; the person drags it from the first
        # pane's need to the room less the second's, a range of one point
        # where the two meet.
        if model.is_split(n.kind) && n.children.len() == 2
            top = if n.most > n.least
                n.most
            else
                n.least + 1

            if hero_ui.set_range(app.handle, id: id, least: n.least, most: top) < 0
                return failure.last(f"bounding the divider of split {id}")

            if hero_ui.set_value(app.handle, id: id, value: n.value) < 0
                return failure.last(f"placing the divider of split {id}")

        if n.kind == hero_ui.HERO_UI_RADIO_GROUP
            count = n.items.len()

            for i in range(from: 0, to: count)
                top = n.y + n.h * i / count
                bottom = n.y + n.h * (i + 1) / count

                if hero_ui.place_item(app.handle, id: id, index: i, x: n.x, y: top, width: n.w, height: bottom - top) < 0
                    return failure.last(f"placing item {i} of radio group {id}")

    return ok()

# Shows or hides every native widget under `id`, and `id` itself, as each
# stands: shown where it and every box up to its window are shown.
function shown(app: ui.App, nodes: {i64: model.Node}, id: i64) -> ()?
    seen = seen_up(nodes, id: nodes[id].must().parent)
    return shown_down(app, nodes: nodes, id: id, above: seen)

# Whether every node from `id` up to its window is shown; true at 0.
function seen_up(nodes: {i64: model.Node}, id: i64) -> bool
    at @= id

    while at != 0
        n = nodes[at].must()

        if !n.visible
            return false

        if n.kind == hero_ui.HERO_UI_WINDOW
            return true
        at @ n.parent

    return true

# Shows or hides `id` and every node under it, `above` saying whether
# everything over `id` is shown. A window is the program's to show, at its
# first layout, and is left out.
function shown_down(app: ui.App, nodes: {i64: model.Node}, id: i64, above: bool) -> ()?
    n = nodes[id].must()
    visible = above && n.visible

    if model.is_native(n.kind) && n.kind != hero_ui.HERO_UI_WINDOW
        if hero_ui.set_visible(app.handle, id: id, on: number_of(visible)) < 0
            return failure.last(f"showing widget {id}")

    for child in n.children
        shown_down(app, nodes: nodes, id: child, above: visible)?

    return ok()

# The text native widget `id` holds now.
function read_text(app: ui.App, id: i64) -> str?
    room: i64 @= TEXT_ROOM

    for _ in range(from: 0, to: 4)
        buffer: [u8] @= []
        got = hero_ui.text_of(app.handle, id: id, @buffer, count: to_u64(room).must())

        if got < 0
            return failure.last(f"reading the text of widget {id}")

        if got <= room
            return bytes.to_text(buffer.slice(from: 0, to: got))
        room @ got

    return fail(code: failure.FAILED, msg: f"the text of widget {id} kept growing while it was read")

# The value native widget `id` holds now.
function read_value(app: ui.App, id: i64) -> i64?
    value @= 0

    if hero_ui.value_of(app.handle, id: id, value: @value) < 0
        return failure.last(f"reading the value of widget {id}")
    return ok(value)

# The indices native widget `id` has chosen now, ascending.
function read_selection(app: ui.App, id: i64) -> [i64]?
    room: i64 @= 64

    for _ in range(from: 0, to: 4)
        indices: [i64] @= []
        got = hero_ui.selection_of(app.handle, id: id, @indices, count: to_u64(room).must())

        if got < 0
            return failure.last(f"reading what widget {id} has chosen")

        if got <= room
            return ok(indices.slice(from: 0, to: got))
        room @ got

    return fail(code: failure.FAILED, msg: f"what widget {id} has chosen kept growing while it was read")

# The queue's oldest event as `[kind, id, value, second]`, or nothing where
# the queue is empty.
function take(app: ui.App) -> [i64]?
    kind @= 0
    id @= 0
    value @= 0
    second @= 0
    got = hero_ui.next(app.handle, kind: @kind, id: @id, value: @value, second: @second)

    if got < 0
        return failure.last("taking an event")

    if got == 0
        none: [i64] = []
        return ok(none)
    return ok([kind, id, value, second])

# The text the last event taken carries.
function event_text(app: ui.App) -> str?
    room: i64 @= TEXT_ROOM

    for _ in range(from: 0, to: 4)
        buffer: [u8] @= []
        got = hero_ui.event_text(app.handle, @buffer, count: to_u64(room).must())

        if got < 0
            return failure.last("reading the text of an event")

        if got <= room
            return bytes.to_text(buffer.slice(from: 0, to: got))
        room @ got

    return fail(code: failure.FAILED, msg: "the text of an event kept growing while it was read")

# Runs the system's loop for at most `ms` milliseconds or until an event is
# queued.
function pump(app: ui.App, ms: i64) -> ()?
    if hero_ui.wait(app.handle, ms: ms) < 0
        return failure.last("running the system's loop")
    return ok()

# Does what `input` says through the system's own path, so its event is
# queued as the person's would be.
function give(app: ui.App, input: ui.Input) -> ()?
    match input
        .click c => return injected(
            app,
            kind: hero_ui.HERO_UI_EVENT_CLICK,
            id: c.widget.id,
            value: 0,
            second: 0,
            text: ""
        )
        .type_text t =>
            return injected(app, kind: hero_ui.HERO_UI_EVENT_TEXT, id: t.widget.id, value: 0, second: 0, text: t.text)
        .choose c =>
            if c.indices.len() == 0
                return injected(
                    app,
                    kind: hero_ui.HERO_UI_EVENT_SELECT,
                    id: c.widget.id,
                    value: -1,
                    second: 0,
                    text: ""
                )

            for i in range(from: 0, to: c.indices.len())
                injected(app, kind: hero_ui.HERO_UI_EVENT_SELECT, id: c.widget.id, value: c.indices[i], second: number_of(i > 0), text: "")?

            return ok()
        .toggle t => return injected(
            app,
            kind: hero_ui.HERO_UI_EVENT_TOGGLE,
            id: t.widget.id,
            value: 0,
            second: 0,
            text: ""
        )
        .slide s => return injected(
            app,
            kind: hero_ui.HERO_UI_EVENT_VALUE,
            id: s.widget.id,
            value: s.value,
            second: 0,
            text: ""
        )
        .choose_menu m => return injected(
            app,
            kind: hero_ui.HERO_UI_EVENT_MENU,
            id: m.item.id,
            value: 0,
            second: 0,
            text: ""
        )
        .ask_close a => return injected(
            app,
            kind: hero_ui.HERO_UI_EVENT_CLOSE,
            id: a.window.id,
            value: 0,
            second: 0,
            text: ""
        )
        .resize r =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_RESIZE,
                id: r.window.id,
                value: r.width,
                second: r.height,
                text: ""
            )
        .send s =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_MESSAGE,
                id: s.widget.id,
                value: 0,
                second: 0,
                text: s.text
            )
        .drag_window d =>
            return window_act(
                app,
                kind: hero_ui.HERO_UI_EVENT_MOVE,
                id: d.window.id,
                value: d.screen,
                second: d.x,
                third: d.y
            )
        .change_state c =>
            return window_act(
                app,
                kind: hero_ui.HERO_UI_EVENT_STATE,
                id: c.window.id,
                value: desk.state_code(c.state),
                second: 0,
                third: 0
            )
        .activate a =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_ACTIVATE,
                id: a.widget.id,
                value: a.index,
                second: 0,
                text: ""
            )
        .submit s =>
            return injected(app, kind: hero_ui.HERO_UI_EVENT_SUBMIT, id: s.widget.id, value: 0, second: 0, text: "")
        .unfold u =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_UNFOLD,
                id: u.widget.id,
                value: u.item,
                second: number_of(u.open),
                text: ""
            )
        .sort s =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_SORT,
                id: s.widget.id,
                value: s.column,
                second: number_of(s.ascending),
                text: ""
            )
        .change_appearance c =>
            return injected(
                app,
                kind: hero_ui.HERO_UI_EVENT_APPEARANCE,
                id: 0,
                value: appearance_code(c.appearance),
                second: 0,
                text: ""
            )
        .answer _ | .pick_files _ | .cancel_files => return ok()

# The layer's number for `appearance`.
function appearance_code(appearance: ui.Appearance) -> i64
    return match appearance
        .light => hero_ui.HERO_UI_APPEARANCE_LIGHT
        .dark  => hero_ui.HERO_UI_APPEARANCE_DARK

# One act on window `id` among the screens, injected through the floor.
function window_act(app: ui.App, kind: i64, id: i64, value: i64, second: i64, third: i64) -> ()?
    if hero_ui.inject_window(app.handle, kind: kind, id: id, value: value, second: second, third: third) < 0
        return failure.last(f"acting on window {id}")
    return ok()

# One act injected through the floor.
function injected(app: ui.App, kind: i64, id: i64, value: i64, second: i64, text: str) -> ()?
    typed @= bytes.from_text(text)

    if hero_ui.inject(app.handle, kind: kind, id: id, value: value, second: second, @typed, count: to_u64(typed.len()).must()) < 0
        return failure.last(f"acting on widget {id}")
    return ok()

# Destroys native widget `id`.
function destroyed(app: ui.App, id: i64) -> ()?
    if hero_ui.destroy(app.handle, id: id) < 0
        return failure.last(f"destroying widget {id}")
    return ok()

# 1 for true, 0 for false.
function number_of(on: bool) -> i64
    if on
        return 1
    return 0

## Tests

# The words a test skips with where this machine offers no native user
# interface to the session (`hero_ui.h`, THE SYSTEMS).
constant NO_NATIVE: str
    "no native user interface here: no window server, no window station that shows, or no display named, for this session"

# `items` as a list of texts, each followed by one zero byte.
function texts_of(items: [str]) -> [u8]
    joined: [u8] @= []

    for item in items
        bytes.push_text(@joined, s: item)
        joined @ joined.push(0)

    return joined

# Sets the text of widget `id` of `handle` through the floor.
function floor_set_text(handle: hero_ui.App, id: i64, text: str) -> i64
    given @= bytes.from_text(text)
    return hero_ui.set_text(handle, id: id, @given, count: to_u64(given.len()).must())

# The text widget `id` of `handle` holds, read through the floor; `"?"` where
# the floor refused.
function floor_text(handle: hero_ui.App, id: i64) -> str
    buffer: [u8] @= []
    got = hero_ui.text_of(handle, id: id, @buffer, count: 256)

    if got < 0 || got > 256
        return "?"
    return bytes.to_text_lossy(buffer.slice(from: 0, to: got))

# The value of widget `id`, or -99 where the floor refused.
function floor_value(handle: hero_ui.App, id: i64) -> i64
    value @= 0

    if hero_ui.value_of(handle, id: id, value: @value) < 0
        return -99
    return value

# What widget `id` has chosen, or `[-99]` where the floor refused.
function floor_selection(handle: hero_ui.App, id: i64) -> [i64]
    indices: [i64] @= []
    got = hero_ui.selection_of(handle, id: id, @indices, count: 16)

    if got < 0 || got > 16
        return [-99]
    return indices.slice(from: 0, to: got)

# Does what a person does to widget `id` through the floor.
function floor_act(handle: hero_ui.App, kind: i64, id: i64, value: i64, second: i64, text: str) -> i64
    typed @= bytes.from_text(text)
    return hero_ui.inject(
        handle,
        kind: kind,
        id: id,
        value: value,
        second: second,
        @typed,
        count: to_u64(typed.len()).must()
    )

# The next event of `handle` as `[kind, id, value, second]`, waiting up to two
# seconds for the system to give it; `[]` where none came.
function floor_event(handle: hero_ui.App) -> [i64]
    kind @= 0
    id @= 0
    value @= 0
    second @= 0

    for _ in range(from: 0, to: 20)
        if hero_ui.next(handle, kind: @kind, id: @id, value: @value, second: @second) == 1
            return [kind, id, value, second]
        _ = hero_ui.wait(handle, ms: 100)

    none: [i64] = []
    return none

test "native: every kind the layer draws made, set and read back, each act a person gives told once, and every refusal a value"
    if hero_ui.native_here() == 0
        skip_test(reason: NO_NATIVE)
    app @= hero_ui.open(hero_ui.HERO_UI_NATIVE)
    assert app != nullptr
    second = hero_ui.open(hero_ui.HERO_UI_NATIVE)
    assert second == nullptr
    assert hero_ui.last_error() == hero_ui.HERO_UI_BUSY

    # The window and one widget of every kind, numbered as `hero_ui.h` numbers
    # the kinds, the menu's item and separator in the menu.
    assert hero_ui.create(app, id: 1, kind: hero_ui.HERO_UI_WINDOW, parent: 0) == 0

    for kind in range(from: hero_ui.HERO_UI_LABEL, to: hero_ui.HERO_UI_MENU + 1)
        assert hero_ui.create(app, id: kind, kind: kind, parent: 1) == 0

    assert hero_ui.create(app, id: 15, kind: hero_ui.HERO_UI_MENU_ITEM, parent: 14) == 0
    assert hero_ui.create(app, id: 16, kind: hero_ui.HERO_UI_MENU_SEPARATOR, parent: 14) == 0

    # The web view is made where the system has one and refused where it
    # has none (a machine without WebView2's loader, or WebKitGTK 6.0),
    # never a fault; one made is given back at once.
    web = hero_ui.create(app, id: 17, kind: hero_ui.HERO_UI_WEBVIEW, parent: 1)
    assert web == 0 || hero_ui.last_error() == hero_ui.HERO_UI_UNSUPPORTED

    if web == 0
        assert hero_ui.destroy(app, id: 17) == 0
    assert hero_ui.create(app, id: 3, kind: hero_ui.HERO_UI_BUTTON, parent: 1) == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_NOT_FOUND
    assert hero_ui.create(app, id: 18, kind: hero_ui.HERO_UI_LABEL, parent: 99) == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_NOT_FOUND

    # Texts, set and read back; a line feed crosses as one.
    assert floor_set_text(app, id: 1, text: "Rebel ui, native") == 0
    assert floor_set_text(app, id: 2, text: "Name\nand more") == 0
    assert floor_set_text(app, id: 3, text: "Count & go") == 0
    assert floor_set_text(app, id: 4, text: "Ada") == 0
    assert floor_set_text(app, id: 5, text: "first\nsecond") == 0
    assert floor_set_text(app, id: 6, text: "Wrap lines") == 0
    assert floor_set_text(app, id: 14, text: "File") == 0
    assert floor_set_text(app, id: 15, text: "Open_it") == 0
    assert floor_text(app, id: 4) == "Ada"
    assert floor_text(app, id: 5) == "first\nsecond"
    assert floor_set_text(app, id: 12, text: "no text") == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_INVALID

    # Items: nothing is chosen after them, then a choice set, and none again.
    radio @= texts_of(["Small", "Large"])
    assert hero_ui.set_items(app, id: 7, @radio, count: to_u64(radio.len()).must()) == 0
    fruits @= texts_of(["apple", "pear", "plum"])
    assert hero_ui.set_items(app, id: 8, @fruits, count: to_u64(fruits.len()).must()) == 0
    assert hero_ui.set_items(app, id: 9, @fruits, count: to_u64(fruits.len()).must()) == 0
    days @= texts_of(["Monday", "Tuesday", "Wednesday"])
    assert hero_ui.set_items(app, id: 10, @days, count: to_u64(days.len()).must()) == 0
    assert floor_value(app, id: 7) == -1
    assert floor_value(app, id: 10) == -1
    assert floor_selection(app, id: 9) == []
    assert hero_ui.set_value(app, id: 10, value: 2) == 0
    assert floor_value(app, id: 10) == 2
    assert floor_selection(app, id: 10) == [2]
    assert hero_ui.set_value(app, id: 10, value: -1) == 0
    assert floor_value(app, id: 10) == -1
    assert hero_ui.set_value(app, id: 10, value: 3) == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_INVALID
    assert hero_ui.set_value(app, id: 7, value: 1) == 0
    assert floor_selection(app, id: 7) == [1]
    chosen: [i64] @= [0, 2]
    assert hero_ui.set_selection(app, id: 9, @chosen, count: 2) == 0
    assert floor_selection(app, id: 9) == [0, 2]
    assert hero_ui.set_selection(app, id: 8, @chosen, count: 2) == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_INVALID

    # Values and ranges, one wider than 32 bits kept exact.
    assert hero_ui.set_value(app, id: 6, value: 1) == 0
    assert floor_value(app, id: 6) == 1
    assert hero_ui.set_value(app, id: 6, value: 2) == -1
    assert hero_ui.set_range(app, id: 12, least: -5000000000000, most: 5000000000000) == 0
    assert hero_ui.set_value(app, id: 12, value: 123456789012) == 0
    assert floor_value(app, id: 12) == 123456789012
    assert hero_ui.set_range(app, id: 12, least: 0, most: 10) == 0
    assert hero_ui.set_value(app, id: 12, value: 7) == 0
    assert floor_value(app, id: 12) == 7
    assert hero_ui.set_value(app, id: 12, value: 11) == -1
    assert hero_ui.set_range(app, id: 11, least: 0, most: 3) == 0
    assert hero_ui.set_value(app, id: 11, value: 2) == 0
    assert floor_value(app, id: 11) == 2

    # Pixels, a shortcut, places and sizes.
    pixels: [u8] @= [255, 0, 0, 255, 0, 0, 255, 128]
    assert hero_ui.set_image(app, id: 13, @pixels, count: 8, width: 2, height: 1) == 0
    key @= bytes.from_text("o")
    assert hero_ui.set_shortcut(app, id: 15, @key, count: 1, modifiers: hero_ui.HERO_UI_PRIMARY) == 0
    capital @= bytes.from_text("O")
    assert hero_ui.set_shortcut(app, id: 15, @capital, count: 1, modifiers: hero_ui.HERO_UI_PRIMARY) == -1
    assert hero_ui.set_shortcut(app, id: 3, @key, count: 1, modifiers: 0) == -1
    assert hero_ui.set_size(app, id: 1, width: 420, height: 320) == 0
    assert hero_ui.set_min_size(app, id: 1, width: 200, height: 160) == 0
    width @= 0
    height @= 0
    assert hero_ui.preferred(app, id: 13, width: @width, height: @height) == 0
    assert width == 2 && height == 1

    for id in [2, 3, 4, 6, 10, 11, 12]
        assert hero_ui.preferred(app, id: id, width: @width, height: @height) == 0
        assert width > 0 && height > 0

    at @= 8

    for id in range(from: 2, to: 14)
        assert hero_ui.place(app, id: id, x: 8, y: at, width: 150, height: 22) == 0
        at @ at + 24

    assert hero_ui.place_item(app, id: 7, index: 0, x: 8, y: 152, width: 150, height: 11) == 0
    assert hero_ui.place_item(app, id: 7, index: 1, x: 8, y: 163, width: 150, height: 11) == 0
    assert hero_ui.place_item(app, id: 7, index: 2, x: 8, y: 174, width: 150, height: 11) == -1
    assert hero_ui.set_visible(app, id: 1, on: 1) == 0
    assert hero_ui.wait(app, ms: 200) >= 0
    drained @= 0
    kind @= 0
    id @= 0
    value @= 0
    other @= 0

    while hero_ui.next(app, kind: @kind, id: @id, value: @value, second: @other) == 1
        drained @ drained + 1

    # Each act a person gives, through the system's own path, told once.
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_CLICK, id: 3, value: 0, second: 0, text: "") == 0
    assert floor_event(app) == [hero_ui.HERO_UI_EVENT_CLICK, 3, 0, 0]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_TEXT, id: 4, value: 0, second: 0, text: "Grace") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_TEXT, 4]
    assert floor_text(app, id: 4) == "Grace"
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_TEXT, id: 5, value: 0, second: 0, text: "a\nb") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_TEXT, 5]
    assert floor_text(app, id: 5) == "a\nb"
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_TOGGLE, id: 6, value: 0, second: 0, text: "") == 0
    assert floor_event(app) == [hero_ui.HERO_UI_EVENT_TOGGLE, 6, 0, 0]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_SELECT, id: 7, value: 0, second: 0, text: "") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_SELECT, 7]
    assert floor_value(app, id: 7) == 0
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_SELECT, id: 9, value: 1, second: 0, text: "") == 0
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_SELECT, id: 9, value: 2, second: 1, text: "") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_SELECT, 9]
    assert floor_selection(app, id: 9) == [1, 2]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_SELECT, id: 10, value: 1, second: 0, text: "") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_SELECT, 10]
    assert floor_value(app, id: 10) == 1
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_VALUE, id: 12, value: 3, second: 0, text: "") == 0
    assert floor_event(app) == [hero_ui.HERO_UI_EVENT_VALUE, 12, 3, 0]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_MENU, id: 15, value: 0, second: 0, text: "") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_MENU, 15]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_RESIZE, id: 1, value: 400, second: 300, text: "") == 0
    assert floor_event(app) == [hero_ui.HERO_UI_EVENT_RESIZE, 1, 400, 300]
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_CLOSE, id: 1, value: 0, second: 0, text: "") == 0
    assert floor_event(app).slice(from: 0, to: 2) == [hero_ui.HERO_UI_EVENT_CLOSE, 1]

    # What a person cannot do makes no event: a button greyed out.
    assert hero_ui.set_enabled(app, id: 3, on: 0) == 0
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_CLICK, id: 3, value: 0, second: 0, text: "") == 0
    assert hero_ui.wait(app, ms: 50) == 0
    assert floor_act(app, kind: hero_ui.HERO_UI_EVENT_CLICK, id: 4, value: 0, second: 0, text: "") == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_INVALID

    # Destroyed, a widget is gone; a window takes what stands in it.
    assert hero_ui.destroy(app, id: 3) == 0
    assert hero_ui.destroy(app, id: 3) == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_NOT_FOUND
    assert hero_ui.destroy(app, id: 1) == 0
    assert floor_set_text(app, id: 4, text: "gone") == -1
    assert hero_ui.last_error() == hero_ui.HERO_UI_NOT_FOUND
    assert hero_ui.close(@app) == 0
