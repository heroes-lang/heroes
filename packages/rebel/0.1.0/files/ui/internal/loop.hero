# The event loop: `wait` and `inject`, and the layout every window gets
# before it is shown, drawn or read.
#
# **What `wait` answers, in order.** First, the windows changed since the
# last layout are laid out, placed on the native side, and a window not yet
# shown is shown. Then each turn of its loop answers the first of: an event
# already made and not answered (a resize's, an injected input's on the
# headless side); the next injected input, given (through the system's own
# path on the native side, whose event the turns after read; applied to the
# table on the headless side, which makes its event); the system's next
# event, on the native side; a timer due. Where none is, it lets time pass
# toward the earlier of its deadline and the next timer: on the native side
# by running the system's loop for that long, on the headless side by moving
# the app's clock, which fails `closed` instead where no input is queued and
# no timer runs, since nothing can ever come.
#
# **Every turn moves**: it answers, takes an input or an event off a queue,
# or lets time pass toward a deadline that is never past, so the loop ends
# within its time on both sides.
#
# An event naming a widget whose life ended before it was answered (the
# program destroyed it after the person acted) is dropped.

use time
use ui
use ui/hero_ui
use ui/internal/check
use ui/internal/clock
use ui/internal/desk
use ui/internal/dialogs
use ui/internal/failure
use ui/internal/give
use ui/internal/keyboard
use ui/internal/layout
use ui/internal/menus
use ui/internal/model
use ui/internal/native
use ui/internal/tables
use ui/internal/trees

# The longest the system's loop runs in one turn, in milliseconds, so a
# very long wait still reads the clock now and then.
constant TURN_MOST: i64
    1000

# The next thing the person did (`ui.wait`).
function wait(@app: ui.App, within: time.Duration) -> ui.Event?
    check.opened(app)?

    if within.nanoseconds < 0
        return fail(code: failure.INVALID, msg: f"a wait of {within.nanoseconds} nanoseconds; it takes 0 or more")
    deadline = clock.later(at: clock.now(app)?, more: within.nanoseconds)
    settle(@app)?

    while true
        if app.events.len() > 0
            first = app.events[0]
            app.events @ app.events.slice(from: 1, to: app.events.len())

            if alive(app, event: first)
                return ok(first)
            continue

        if app.inputs.len() > 0
            input = app.inputs[0]
            app.inputs @ app.inputs.slice(from: 1, to: app.inputs.len())
            given(@app, input: input)?
            continue

        if app.native
            taken = native.take(app)?

            if taken.len() > 0
                read(@app, taken: taken)?
                continue
        now = clock.now(app)?

        timer = next_timer(app)

        if timer != 0 && app.table.nodes[timer].must().due <= now
            return ok(fired(@app, id: timer, now: now))

        # Asked before the deadline: a headless app with nothing left to
        # give and no timer will never answer, however long it is given.
        if timer == 0 && !app.native
            return fail(
                code: failure.CLOSED,
                msg: "the inputs injected into this headless app are spent, and no timer runs"
            )

        if now >= deadline
            return fail(code: failure.TIMEOUT, msg: f"nothing happened in {within.nanoseconds} nanoseconds")
        target @= deadline

        if timer != 0 && app.table.nodes[timer].must().due < target
            target @ app.table.nodes[timer].must().due

        if app.native
            native.pump(app, ms: milliseconds(target - now))?
        else
            app.clock @ target

    return fail(code: failure.FAILED, msg: "the event loop ended")

# Queues `input` (`ui.inject`), checked against its widget now.
function inject(@app: ui.App, input: ui.Input) -> ()?
    check.opened(app)?
    give.checked(app, input: input)?

    match input
        .answer a     => dialogs.answered_by(@app, answer: a.answer)?
        .pick_files p => dialogs.chosen_by(@app, choice: .chosen(paths: p.paths))?
        .cancel_files => dialogs.chosen_by(@app, choice: .cancelled)?
        .click _ | .type_text _ | .choose _ | .toggle _ | .slide _ | .choose_menu _ | .ask_close _ | .resize _ | .send _ | .drag_window _ | .change_state _ | .activate _ | .submit _ | .sort _ | .unfold _ | .change_appearance _ =>
            app.inputs @ app.inputs.push(input)

    return ok()

# Gives `input`, queued earlier, now: on the headless side to the table,
# whose event joins the queue; on the native side through the system. An
# input whose widget has ended since gives nothing.
function given(@app: ui.App, input: ui.Input) -> ()?
    if !give.alive(app, input: input)
        return ok()

    if app.native
        return native.give(app, input: input)

    for event in give.applied(@app, input: input)
        app.events @ app.events.push(event)

    settle(@app)?
    return ok()

# Reads the system's event `taken`, `[kind, id, value, second]`: what it
# changed is put in the table, and its event joins the queue. One naming a
# widget the table no longer holds is dropped.
function read(@app: ui.App, taken: [i64]) -> ()?
    kind = taken[0]
    id = taken[1]

    # A dialog's number is no widget's.
    if kind == hero_ui.HERO_UI_EVENT_DIALOG
        for event in dialogs.read(@app, id: id, value: taken[2])?
            app.events @ app.events.push(event)

        return ok()

    # The appearance is the app's, of no widget.
    if kind == hero_ui.HERO_UI_EVENT_APPEARANCE
        turned: ui.Appearance = if taken[2] == hero_ui.HERO_UI_APPEARANCE_DARK
            .dark
        else
            .light

        app.appearance @ turned
        app.events @ app.events.push(.appearance_changed(appearance: turned))
        return ok()
    found = model.node_of(app.table, id: id)

    if found.is_err()
        return ok()
    n @= found.must()
    w = check.widget_of(app, id: id)

    if kind == hero_ui.HERO_UI_EVENT_CLICK
        app.events @ app.events.push(.clicked(widget: w))
    else if kind == hero_ui.HERO_UI_EVENT_TEXT
        n.text @ native.read_text(app, id: id)?
        model.put(@app.table, n: n)
        app.events @ app.events.push(.text_changed(widget: w, text: n.text))
    else if kind == hero_ui.HERO_UI_EVENT_SELECT
        n.chosen @ native.read_selection(app, id: id)?
        model.put(@app.table, n: n)
        app.events @ app.events.push(.selection_changed(widget: w, indices: n.chosen))
    else if kind == hero_ui.HERO_UI_EVENT_TOGGLE
        n.value @ taken[2]
        model.put(@app.table, n: n)
        app.events @ app.events.push(.toggled(widget: w, checked: taken[2] == 1))
    else if kind == hero_ui.HERO_UI_EVENT_VALUE
        n.value @ taken[2]

        # The person's divider lays its panes out anew.
        if model.is_split(n.kind)
            n.divided @ true
        model.put(@app.table, n: n)

        if model.is_split(n.kind)
            model.marks_dirty(@app.table, window: n.window)
        app.events @ app.events.push(.value_changed(widget: w, value: taken[2]))
    else if kind == hero_ui.HERO_UI_EVENT_MENU
        menus.told(@app, id: id, value: taken[2])
        app.events @ app.events.push(.menu_chosen(item: w))
    else if kind == hero_ui.HERO_UI_EVENT_CLOSE
        app.events @ app.events.push(.close_asked(window: w))
    else if kind == hero_ui.HERO_UI_EVENT_RESIZE
        was_w = n.w
        was_h = n.h
        n.width @ taken[2]
        n.height @ taken[3]
        n.dirty @ true
        model.put(@app.table, n: n)
        settle(@app)?
        laid = model.node_of(app.table, id: id)?

        # A frame the program changed around a content of the same size
        # (`ui.set_framed`) is told by the system as a resize; the content
        # took no new size, so nothing is answered.
        if laid.w != was_w || laid.h != was_h
            app.events @ app.events.push(.resized(window: w, width: laid.w, height: laid.h))
    else if kind == hero_ui.HERO_UI_EVENT_SUBMIT
        app.events @ app.events.push(.submitted(widget: w))
    else if kind == hero_ui.HERO_UI_EVENT_UNFOLD
        for event in trees.told(@app, id: id, item: taken[2], on: taken[3] == 1)
            app.events @ app.events.push(event)
    else if kind == hero_ui.HERO_UI_EVENT_SORT
        app.events @ app.events.push(tables.sorted(@app, id: id, column: taken[2], ascending: taken[3] == 1))
    else if kind == hero_ui.HERO_UI_EVENT_ACTIVATE
        app.events @ app.events.push(.activated(widget: w, index: taken[2]))
    else if kind == hero_ui.HERO_UI_EVENT_MOVE || kind == hero_ui.HERO_UI_EVENT_STATE || kind == hero_ui.HERO_UI_EVENT_SCREEN
        for event in desk.read(@app, taken: taken)
            app.events @ app.events.push(event)
    else if kind == hero_ui.HERO_UI_EVENT_MESSAGE
        app.events @ app.events.push(.message(widget: w, text: native.event_text(app)?))
    return ok()

# Reads at once every event the native side has queued, as `wait` reads
# them, each joining the app's events in order: what a call of the
# program's set off in the system, a new size after a state among them,
# reaches the table before anything is laid out again.
function drained(@app: ui.App) -> ()?
    while true
        taken = native.take(app)?

        if taken.len() == 0
            return ok()
        read(@app, taken: taken)?

# Lays out every window marked for it, places its widgets on the native
# side, and shows each window not shown yet and not hidden by the program.
function settle(@app: ui.App) -> ()?
    for window in app.table.windows
        w = model.node_of(app.table, id: window)?

        if w.dirty
            nodes @= app.table.nodes
            layout.lay_out(@nodes, window: window)
            app.table.nodes @ nodes

            if app.native
                native.placed(app, nodes: app.table.nodes, window: window)?
        laid @= model.node_of(app.table, id: window)?

        if !laid.shown && laid.visible
            if app.native && hero_ui.set_visible(app.handle, id: window, on: 1) < 0
                return failure.last(f"showing window {window}")
            laid.shown @ true

            # A window shown the first time gives its first widget that
            # takes the keys them, as every system does; the native side's
            # system does it itself.
            if !app.native && laid.focus == 0
                laid.focus @ keyboard.first_taking(app, window: window)
            model.put(@app.table, n: laid)

    return ok()

# The timer that fires first: the earliest due, the first made among those
# due together; 0, the number no widget takes, where none runs.
function next_timer(app: ui.App) -> i64
    best @= 0
    best_due @= 0

    for id in app.table.timers
        due = app.table.nodes[id].must().due

        if best == 0 || due < best_due
            best @ id
            best_due @ due

    return best

# Fires timer `id` at `now`: its next time is a period after its due time,
# or after `now` where it fell a period or more behind, so it fires once for
# the periods it missed.
function fired(@app: ui.App, id: i64, now: i64) -> ui.Event
    t @= app.table.nodes[id].must()
    next = clock.later(at: t.due, more: t.every)

    t.due @ if next <= now
        clock.later(at: now, more: t.every)
    else
        next

    model.put(@app.table, n: t)
    return .timer_fired(timer: check.widget_of(app, id: id))

# Whether the widget `event` names still lives; a dialog's answer names
# none, and the dialog it names ended with its window's life.
function alive(app: ui.App, event: ui.Event) -> bool
    id = match event
        .clicked c            => c.widget.id
        .text_changed t       => t.widget.id
        .selection_changed s  => s.widget.id
        .toggled t            => t.widget.id
        .value_changed v      => v.widget.id
        .menu_chosen m        => m.item.id
        .close_asked c        => c.window.id
        .timer_fired t        => t.timer.id
        .resized r            => r.window.id
        .moved m              => m.window.id
        .state_changed s      => s.window.id
        .screen_changed s     => s.window.id
        .activated a          => a.widget.id
        .sort_asked s         => s.widget.id
        .unfolded u           => u.widget.id
        .submitted s          => s.widget.id
        .message m            => m.widget.id
        .dialog_answered _    => 0
        .files_chosen _       => 0
        .appearance_changed _ => 0

    return id == 0 || !model.node_of(app.table, id: id).is_err()

# `nanoseconds` as whole milliseconds, rounded up so a wait never wakes
# before its time, and at most `TURN_MOST`.
function milliseconds(nanoseconds: i64) -> i64
    ms = (nanoseconds + 999999) / 1000000

    if ms > TURN_MOST
        return TURN_MOST
    return ms

## Tests

test "milliseconds: none, a nanosecond, a millisecond and one more, past a turn"
    assert milliseconds(0) == 0
    assert milliseconds(1) == 1
    assert milliseconds(1000000) == 1
    assert milliseconds(1000001) == 2
    assert milliseconds(5000000000) == 1000
