# The size the headless side draws each kind of widget at, where no system
# measures it: a fixed rule of the text's width on a screen and the kind's
# own room, the same on every machine, so a headless app's layout, and the
# transcript a demo prints of it, are one text everywhere. A text's width
# is its columns as a terminal shows them (`unicode/segment`'s `width_of`,
# a wide character two), each `COLUMN` points.

use ui/hero_ui
use ui/internal/model
use unicode/segment

# Points a column of text takes.
constant COLUMN: i64
    8

# Points a line of a label's text takes, high.
constant LINE: i64
    16

# Points a control of one line takes, high: a button, a text field, a combo
# box, a slider.
constant CONTROL: i64
    24

# Points a checkbox or one item of a radio group takes, high.
constant MARK: i64
    20

# The room a button's text has on its two sides together, and a checkbox's
# box and the gap after it.
constant AROUND: i64
    24

# The width a text field, a list, a progress bar and a slider take where
# nothing else decides it.
constant FIELD: i64
    160

# The size of a text area.
constant AREA_WIDTH: i64
    240

# The height of a text area and a list.
constant AREA_HEIGHT: i64
    96

# The room a combo box keeps beside its longest item for its arrow, and the
# least width it takes.
constant ARROW: i64
    40

# The least width of a combo box.
constant COMBO_LEAST: i64
    80

# The size of a web view where nothing else decides it.
constant VIEW_WIDTH: i64
    320

# The height of a web view.
constant VIEW_HEIGHT: i64
    240

# The room the headless side's tabs take beside and below a page, on each
# side, in points.
constant TAB_SIDE: i64
    8

# The room the headless side's group box takes around its content: its
# frame on each side and below, and its title and the frame above.
constant GROUP_SIDE: i64
    5

constant GROUP_TOP: i64
    21

# The room a spin's arrows take beside its digits.
constant SPIN_ARROWS: i64
    32

# The height of the headless side's toolbar: the room the system's takes
# above a window's content where it draws one inside it.
constant TOOLBAR_HEIGHT: i64
    38

# The width of the headless side's colour well.
constant COLOR_WELL_WIDTH: i64
    44

# The height of the headless side's status bar, Finder's own.
constant STATUS_HEIGHT: i64
    22

# The room its tabs and the border above a page take, high.
constant TAB_TOP: i64
    32

# The width of a table's column on the headless side; a table is as wide
# as its columns, a text field's width at least, and a list's height with a
# control's for its headers.
constant TABLE_COLUMN: i64
    100

# The thickness of the headless side's divider between two panes.
constant DIVIDER: i64
    1

# The room the headless side's tabs or scrolled box of `kind` takes around
# its content, `[left, top, right, bottom]`: its scroll bar stands over the
# content, as the system's does by default on macOS, and takes none.
function insets_of(kind: i64) -> [i64]
    if kind == hero_ui.HERO_UI_TABS
        return [TAB_SIDE, TAB_TOP, TAB_SIDE, TAB_SIDE]

    if kind == hero_ui.HERO_UI_GROUP
        return [GROUP_SIDE, GROUP_TOP, GROUP_SIDE, GROUP_SIDE]
    return [0, 0, 0, 0]

# The size `n` is drawn at by the headless side, as `[width, height]` in
# points: what a native side's `preferred` answers for it. A split's is its
# divider's thickness on both axes. A window, a box, a menu and a timer
# have none, `[0, 0]`.
function of(n: model.Node) -> [i64]
    k = n.kind

    if model.is_split(k)
        return [DIVIDER, DIVIDER]

    if k == hero_ui.HERO_UI_TABLE
        wide = TABLE_COLUMN * n.titles.len()

        if wide < FIELD
            return [FIELD, AREA_HEIGHT + CONTROL]
        return [wide, AREA_HEIGHT + CONTROL]

    # A line one point thick, as long as its box gives it.
    if k == hero_ui.HERO_UI_SEPARATOR
        return [1, 1]

    # A toolbar fills its window's width, so none of it is asked for.
    if k == hero_ui.HERO_UI_TOOLBAR
        return [0, TOOLBAR_HEIGHT]

    if k == hero_ui.HERO_UI_STATUS_BAR
        return [0, STATUS_HEIGHT]

    if k == hero_ui.HERO_UI_LABEL
        lines = lines_of(n.text)
        return [widest(lines) * COLUMN, lines.len() * LINE]

    if k == hero_ui.HERO_UI_BUTTON
        return [segment.width_of(n.text) * COLUMN + AROUND, CONTROL]

    if k == hero_ui.HERO_UI_TEXT_FIELD
        return [FIELD, CONTROL]

    if k == hero_ui.HERO_UI_TEXT_AREA
        return [AREA_WIDTH, AREA_HEIGHT]

    if k == hero_ui.HERO_UI_CHECKBOX
        return [segment.width_of(n.text) * COLUMN + AROUND, MARK]

    if k == hero_ui.HERO_UI_RADIO_GROUP
        if n.items.len() == 0
            return [0, 0]
        return [widest(n.items) * COLUMN + AROUND, n.items.len() * MARK]

    if k == hero_ui.HERO_UI_LIST || k == hero_ui.HERO_UI_LIST_MULTIPLE || k == hero_ui.HERO_UI_TREE
        return [FIELD, AREA_HEIGHT]

    if k == hero_ui.HERO_UI_COMBO
        wide = widest(n.items) * COLUMN + ARROW

        if wide < COMBO_LEAST
            return [COMBO_LEAST, CONTROL]
        return [wide, CONTROL]

    if k == hero_ui.HERO_UI_EDITABLE_COMBO
        columns = if segment.width_of(n.text) > widest(n.items)
            segment.width_of(n.text)
        else
            widest(n.items)

        wide = columns * COLUMN + ARROW

        if wide < FIELD
            return [FIELD, CONTROL]
        return [wide, CONTROL]

    if k == hero_ui.HERO_UI_PROGRESS
        return [FIELD, LINE]

    if k == hero_ui.HERO_UI_SLIDER
        return [FIELD, CONTROL]

    # A drawing area is the size the program asked for it.
    if k == hero_ui.HERO_UI_CANVAS
        return [n.width, n.height]

    # The system's font button, a field's width.
    if k == hero_ui.HERO_UI_FONT_BUTTON
        return [FIELD, CONTROL]

    # The system's colour well.
    if k == hero_ui.HERO_UI_COLOR_WELL
        return [COLOR_WELL_WIDTH, CONTROL]

    # A date, a time or both as the system writes them: ten and eight
    # characters, and the arrows.
    if k == hero_ui.HERO_UI_DATE_PICKER
        return [10 * COLUMN + SPIN_ARROWS, CONTROL]

    # A month's calendar: seven columns of a day's two digits and a space,
    # under a line of the month and a line of the days' names, six weeks.
    if k == hero_ui.HERO_UI_CALENDAR
        return [21 * COLUMN, 8 * LINE]

    if k == hero_ui.HERO_UI_TIME_PICKER
        return [8 * COLUMN + SPIN_ARROWS, CONTROL]

    if k == hero_ui.HERO_UI_DATE_TIME_PICKER
        return [19 * COLUMN + SPIN_ARROWS, CONTROL]

    if k == hero_ui.HERO_UI_SPIN
        columns = if segment.width_of(f"{n.most}") > segment.width_of(f"{n.least}")
            segment.width_of(f"{n.most}")
        else
            segment.width_of(f"{n.least}")

        return [columns * COLUMN + SPIN_ARROWS, CONTROL]

    if k == hero_ui.HERO_UI_IMAGE
        return [n.width, n.height]

    if k == hero_ui.HERO_UI_WEBVIEW
        return [VIEW_WIDTH, VIEW_HEIGHT]
    return [0, 0]

# The columns of the widest of `texts`, 0 for none.
function widest(texts: [str]) -> i64
    most @= 0

    for t in texts
        w = segment.width_of(t)

        if w > most
            most @ w

    return most

# The lines of `text`, cut at each line feed; an empty text is one empty
# line, so a label holding nothing still takes a line's height.
function lines_of(text: str) -> [str]
    out: [str] @= []
    start @= 0

    for at in range(from: 0, to: text.len())
        if text[at] == '\n'
            out @ out.push(text.slice(from: start, to: at))
            start @ at + 1

    out @ out.push(text.slice(from: start, to: text.len()))
    return out

## Tests

test "of: a label is its widest line's columns by its lines, an empty one a line high"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_LABEL, parent: 0, window: 0)
    n.text @ "Name"
    assert of(n) == [32, 16]
    n.text @ "a\nlonger"
    assert of(n) == [48, 32]
    n.text @ ""
    assert of(n) == [0, 16]

test "of: a wide character takes two columns, an accented letter one"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_BUTTON, parent: 0, window: 0)
    n.text @ "日本"
    assert of(n) == [56, 24]
    n.text @ "café"
    assert of(n) == [56, 24]

test "of: a radio group with no item takes no room, with items the widest by their count"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_RADIO_GROUP, parent: 0, window: 0)
    assert of(n) == [0, 0]
    n.items @ ["S", "Medium", "L"]
    assert of(n) == [72, 60]

test "of: a combo box keeps room for its arrow and is never narrower than its least"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_COMBO, parent: 0, window: 0)
    assert of(n) == [80, 24]
    n.items @ ["Monday", "Wednesday"]
    assert of(n) == [112, 24]

test "of: an editable combo box is as wide as its widest item or its text, with room for its arrow, and never narrower than a text field"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_EDITABLE_COMBO, parent: 0, window: 0)
    assert of(n) == [FIELD, CONTROL]
    n.items @ ["Monday", "Wednesday"]
    assert of(n) == [FIELD, CONTROL]
    n.items @ ["a much longer item than the field is wide", "b"]
    assert of(n) == [41 * COLUMN + ARROW, CONTROL]
    n.text @ "a text that is even longer than the longest item in its list, so it sets the width"
    assert of(n) == [82 * COLUMN + ARROW, CONTROL]

test "of: a spin has room for the digits of the longer end of its range and its arrows"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_SPIN, parent: 0, window: 0)
    n.least @ 0
    n.most @ 100
    assert of(n) == [3 * COLUMN + SPIN_ARROWS, CONTROL]
    n.least @ -1000
    assert of(n) == [5 * COLUMN + SPIN_ARROWS, CONTROL]

test "of: an image is its pixels, and the kinds no system draws are nothing"
    n @= model.blank(id: 1, kind: hero_ui.HERO_UI_IMAGE, parent: 0, window: 0)
    n.width @ 32
    n.height @ 20
    assert of(n) == [32, 20]
    assert of(model.blank(id: 2, kind: hero_ui.HERO_UI_ROW, parent: 0, window: 0)) == [0, 0]
    assert of(model.blank(id: 3, kind: hero_ui.HERO_UI_WINDOW, parent: 0, window: 0)) == [0, 0]

test "lines_of: no line feed, one at either end, and two together"
    assert lines_of("abc") == ["abc"]
    assert lines_of("\nabc\n") == ["", "abc", ""]
    assert lines_of("a\n\nb") == ["a", "", "b"]
