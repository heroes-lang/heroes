# The platform layer's native user interface, `hero_ui.h`, bound thin: one
# function per C function, each answering what C answers, in C's order.
# Where a call fails it answers -1, or `nullptr` for `open`, and
# `last_error` then names the kind, `last_message` the words. Rebel's floor
# of `ui` (`examples-rebel/README.md` § A2): no policy stands here, and the
# face above it keeps the widgets' tree, lays it out, and turns every kind
# into a code.
#
# The layer is C of the language's own beside the runtime, so this group
# names its header and no `link`: on macOS the member's Swift half links
# AppKit itself, on Windows its Win32 arm links `user32` and the rest by the
# object's own words, and elsewhere its GTK 4 arm opens `libgtk-4.so.1` at
# the first call, so the same lines bind it everywhere. An app is the one handle: `open` begins its life and `close`
# ends it. A widget is a number the program gives, never a handle.
#
# Every text crosses as bytes and a count, so a text holding a zero byte is
# the layer's `HERO_UI_INVALID` and never an abort at `.cstr()`.

use poll/hero_poll

extern "hero_ui.h"
    # An app open on the layer. It is a handle the layer issues and checks:
    # one closed already, `nullptr`, or one it never issued is
    # `HERO_UI_NOT_OPEN`, never a read of freed memory.
    record App tag hero_ui_app
    # The kinds of failure `last_error` answers, the same numbers on every
    # platform.
    constant HERO_UI_OK: i64
    constant HERO_UI_INVALID: i64
    constant HERO_UI_NOT_OPEN: i64
    constant HERO_UI_WRONG_THREAD: i64
    constant HERO_UI_UNSUPPORTED: i64
    constant HERO_UI_BUSY: i64
    constant HERO_UI_NOT_FOUND: i64
    constant HERO_UI_LIMIT: i64
    constant HERO_UI_OTHER: i64
    # The two sides an app opens on.
    constant HERO_UI_HEADLESS: i64
    constant HERO_UI_NATIVE: i64
    # The kinds of widget, the native side's and the program's own.
    constant HERO_UI_WINDOW: i64
    constant HERO_UI_LABEL: i64
    constant HERO_UI_BUTTON: i64
    constant HERO_UI_TEXT_FIELD: i64
    constant HERO_UI_TEXT_AREA: i64
    constant HERO_UI_CHECKBOX: i64
    constant HERO_UI_RADIO_GROUP: i64
    constant HERO_UI_LIST: i64
    constant HERO_UI_LIST_MULTIPLE: i64
    constant HERO_UI_COMBO: i64
    constant HERO_UI_PROGRESS: i64
    constant HERO_UI_SLIDER: i64
    constant HERO_UI_IMAGE: i64
    constant HERO_UI_MENU: i64
    constant HERO_UI_MENU_ITEM: i64
    constant HERO_UI_MENU_SEPARATOR: i64
    constant HERO_UI_WEBVIEW: i64
    constant HERO_UI_ROW: i64
    constant HERO_UI_COLUMN: i64
    constant HERO_UI_GRID: i64
    constant HERO_UI_TIMER: i64
    # The kinds of event the queue holds.
    constant HERO_UI_EVENT_CLICK: i64
    constant HERO_UI_EVENT_TEXT: i64
    constant HERO_UI_EVENT_SELECT: i64
    constant HERO_UI_EVENT_TOGGLE: i64
    constant HERO_UI_EVENT_VALUE: i64
    constant HERO_UI_EVENT_MENU: i64
    constant HERO_UI_EVENT_CLOSE: i64
    constant HERO_UI_EVENT_RESIZE: i64
    constant HERO_UI_EVENT_MESSAGE: i64
    # The keys held with a shortcut, added together.
    constant HERO_UI_PRIMARY: i64
    constant HERO_UI_SHIFT: i64
    constant HERO_UI_ALT: i64
    # A message box's tone, its buttons and the button pressed.
    constant HERO_UI_TONE_INFO: i64
    constant HERO_UI_TONE_WARNING: i64
    constant HERO_UI_TONE_ERROR: i64
    constant HERO_UI_BUTTONS_OK: i64
    constant HERO_UI_BUTTONS_OK_CANCEL: i64
    constant HERO_UI_BUTTONS_YES_NO: i64
    constant HERO_UI_BUTTONS_YES_NO_CANCEL: i64
    constant HERO_UI_ANSWER_OK: i64
    constant HERO_UI_ANSWER_CANCEL: i64
    constant HERO_UI_ANSWER_YES: i64
    constant HERO_UI_ANSWER_NO: i64
    # The most bytes one text holds, and the most events the queue holds.
    constant HERO_UI_TEXT_MOST: i64
    constant HERO_UI_QUEUE_MOST: i64
    function hero_ui_on_ui_thread() -> i64
    function hero_ui_native_here() -> i64
    function hero_ui_open(backend: i64) -> App acquires hero_ui_close
    function hero_ui_close(app: App consumes) -> i64
    function hero_ui_number(app: App) -> i64
    function hero_ui_create(app: App, id: i64, kind: i64, parent: i64) -> i64
    function hero_ui_destroy(app: App, id: i64) -> i64
    function hero_ui_set_text(app: App, id: i64, @text: [u8] counted_by count lent, count: u64) -> i64
    function hero_ui_set_items(app: App, id: i64, @items: [u8] counted_by count lent, count: u64) -> i64
    function hero_ui_set_value(app: App, id: i64, value: i64) -> i64
    function hero_ui_set_range(app: App, id: i64, least: i64, most: i64) -> i64
    function hero_ui_set_selection(app: App, id: i64, @indices: [i64] counted_by count lent, count: u64) -> i64
    function hero_ui_set_enabled(app: App, id: i64, on: i64) -> i64
    function hero_ui_set_visible(app: App, id: i64, on: i64) -> i64
    function hero_ui_set_shortcut(app: App, id: i64, @key: [u8] counted_by count lent, count: u64, modifiers: i64) -> i64
    function hero_ui_set_image(app: App, id: i64, @rgba: [u8] counted_by count lent, count: u64, width: i64, height: i64) -> i64
    function hero_ui_set_resizable(app: App, id: i64, on: i64) -> i64
    function hero_ui_set_size(app: App, id: i64, width: i64, height: i64) -> i64
    function hero_ui_set_min_size(app: App, id: i64, width: i64, height: i64) -> i64
    function hero_ui_place(app: App, id: i64, x: i64, y: i64, width: i64, height: i64) -> i64
    function hero_ui_place_item(app: App, id: i64, index: i64, x: i64, y: i64, width: i64, height: i64) -> i64
    function hero_ui_preferred(app: App, id: i64, @width: i64, @height: i64) -> i64
    function hero_ui_text(app: App, id: i64, @buffer: [u8] counted_by count lent, count: u64) -> i64
    function hero_ui_value(app: App, id: i64, @value: i64) -> i64
    function hero_ui_selection(app: App, id: i64, @indices: [i64] counted_by count lent, count: u64) -> i64
    function hero_ui_wait(app: App, ms: i64) -> i64
    function hero_ui_next(app: App, @kind: i64, @id: i64, @value: i64, @second: i64) -> i64
    function hero_ui_event_text(app: App, @buffer: [u8] counted_by count lent, count: u64) -> i64
    function hero_ui_lost(app: App) -> i64
    function hero_ui_inject(app: App, kind: i64, id: i64, value: i64, second: i64, @text: [u8] counted_by count lent, count: u64) -> i64
    function hero_ui_message(app: App, dialog: i64, window: i64, tone: i64, buttons: i64, @title: [u8] counted_by title_count lent, title_count: u64, @text: [u8] counted_by text_count lent, text_count: u64) -> i64
    function hero_ui_file_dialog(app: App, dialog: i64, window: i64, save: i64, multiple: i64, @title: [u8] counted_by title_count lent, title_count: u64, @name: [u8] counted_by name_count lent, name_count: u64, @filters: [u8] counted_by filters_count lent, filters_count: u64) -> i64
    function hero_ui_press_key(app: App, id: i64, @key: [u8] counted_by count lent, count: u64, modifiers: i64) -> i64
    # Windows on the screen: the numbers a screen takes, a window's states
    # and backdrops, the events of the person's acts on a window, and the
    # farthest a position goes.
    constant HERO_UI_SCREEN_FIELDS: i64
    constant HERO_UI_STATE_NORMAL: i64
    constant HERO_UI_STATE_MINIMIZED: i64
    constant HERO_UI_STATE_MAXIMIZED: i64
    constant HERO_UI_STATE_FULL_SCREEN: i64
    constant HERO_UI_BACKDROP_NONE: i64
    constant HERO_UI_BACKDROP_TRANSLUCENT: i64
    constant HERO_UI_EVENT_MOVE: i64
    constant HERO_UI_EVENT_STATE: i64
    constant HERO_UI_EVENT_SCREEN: i64
    constant HERO_UI_POSITION_MOST: i64
    # A list's row opened by the person.
    constant HERO_UI_EVENT_ACTIVATE: i64
    # A menu item's roles.
    constant HERO_UI_ROLE_NONE: i64
    constant HERO_UI_ROLE_ABOUT: i64
    constant HERO_UI_ROLE_SETTINGS: i64
    constant HERO_UI_ROLE_QUIT: i64
