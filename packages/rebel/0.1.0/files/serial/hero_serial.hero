# The platform layer's serial ports, `hero_serial.h`, bound thin: one function
# per C function, in C's order, each answering what C answers. Rebel's floor
# of `serial` (`examples/packages/README.md` § 4.1): where a call fails its
# stream is `nullptr` or its count -1, and `last_error` then the kind; no
# policy stands here, and the face above it turns every kind into a code.
#
# The layer is C of the language's own beside the runtime, so this group names
# its header and no `link`: no platform type reaches it, and the same lines
# bind it on every platform. A port, and the controlling side of a
# pseudo-terminal, is a stream of `hero_stream.h`, begun by `open` or
# `pseudo` and ended by `hero_stream_close`, which the floor `io/hero_stream`
# binds; every other call takes that stream.

use io/hero_stream

extern "hero_serial.h"
    # The kinds of failure `last_error` answers, the same numbers on every
    # platform and the stream's numbers where `hero_stream.h` has the kind.
    constant HERO_SERIAL_OK: i64
    constant HERO_SERIAL_INVALID: i64
    constant HERO_SERIAL_NOT_OPEN: i64
    constant HERO_SERIAL_NOT_FOUND: i64
    constant HERO_SERIAL_DENIED: i64
    constant HERO_SERIAL_LIMIT: i64
    constant HERO_SERIAL_GONE: i64
    constant HERO_SERIAL_UNSUPPORTED: i64
    constant HERO_SERIAL_OTHER: i64
    constant HERO_SERIAL_BUSY: i64
    constant HERO_SERIAL_NOT_A_PORT: i64
    constant HERO_SERIAL_TIMED_OUT: i64
    constant HERO_SERIAL_STOPPED: i64
    # A parity, as `configure` takes it and `setting` answers it.
    constant HERO_SERIAL_PARITY_NONE: i64
    constant HERO_SERIAL_PARITY_ODD: i64
    constant HERO_SERIAL_PARITY_EVEN: i64
    constant HERO_SERIAL_PARITY_MARK: i64
    constant HERO_SERIAL_PARITY_SPACE: i64
    # How many stop bits end a character.
    constant HERO_SERIAL_STOP_ONE: i64
    constant HERO_SERIAL_STOP_TWO: i64
    constant HERO_SERIAL_STOP_ONE_AND_HALF: i64
    # The flow control's bits, which combine; 0 is none.
    constant HERO_SERIAL_FLOW_RTS_CTS: i64
    constant HERO_SERIAL_FLOW_XON_XOFF: i64
    constant HERO_SERIAL_FLOW_DSR_DTR: i64
    # Which setting `setting` answers.
    constant HERO_SERIAL_SETTING_BAUD: i64
    constant HERO_SERIAL_SETTING_DATA_BITS: i64
    constant HERO_SERIAL_SETTING_PARITY: i64
    constant HERO_SERIAL_SETTING_STOP_BITS: i64
    constant HERO_SERIAL_SETTING_FLOW: i64
    # The modem lines' bits, which combine.
    constant HERO_SERIAL_LINE_DTR: i64
    constant HERO_SERIAL_LINE_RTS: i64
    constant HERO_SERIAL_LINE_CTS: i64
    constant HERO_SERIAL_LINE_DSR: i64
    constant HERO_SERIAL_LINE_CD: i64
    constant HERO_SERIAL_LINE_RI: i64
    # A read or a write timeout that never ends a wait.
    constant HERO_SERIAL_FOREVER: i64
    # The two buffers, what was received and what was written.
    constant HERO_SERIAL_INPUT: i64
    constant HERO_SERIAL_OUTPUT: i64
    # The fastest speed the header takes.
    constant HERO_SERIAL_BAUD_MOST: i64
    # The call the marks below name: a stream's end, which the header declares
    # through `hero_stream.h`.
    function hero_stream_close(s: hero_stream.Stream consumes) -> i64
    function hero_serial_ports(@buffer: [u8] counted_by count lent, count: u64) -> i64
    function hero_serial_open(path: cstr lent) -> hero_stream.Stream acquires hero_stream_close
    function hero_serial_configure(s: hero_stream.Stream, baud: i64, data_bits: i64, parity: i64, stop_bits: i64, flow: i64) -> i64
    function hero_serial_setting(s: hero_stream.Stream, which: i64) -> i64
    function hero_serial_set_timeouts(s: hero_stream.Stream, read_ms: i64, write_ms: i64, gap_ms: i64) -> i64
    function hero_serial_timeouts(s: hero_stream.Stream, @read_ms: i64, @write_ms: i64, @gap_ms: i64) -> i64
    function hero_serial_lines(s: hero_stream.Stream) -> i64
    function hero_serial_set_line(s: hero_stream.Stream, line: i64, on: i64) -> i64
    function hero_serial_send_break(s: hero_stream.Stream, ms: i64) -> i64
    function hero_serial_set_break(s: hero_stream.Stream, on: i64) -> i64
    function hero_serial_discard(s: hero_stream.Stream, which: i64) -> i64
    function hero_serial_drain(s: hero_stream.Stream) -> i64
    function hero_serial_waiting(s: hero_stream.Stream, which: i64) -> i64
    function hero_serial_pseudo() -> hero_stream.Stream acquires hero_stream_close
    function hero_serial_pseudo_path(s: hero_stream.Stream, @buffer: [u8] counted_by count lent, count: u64) -> i64
    function hero_serial_last_error() -> i64
    function hero_serial_last_os_error() -> i64

## Ports

# How many bytes the list of this machine's ports takes, each name followed by
# a zero byte, or -1. `buffer` is filled as far as `count` reaches and left
# `count` long; an answer above `count` asks again with a buffer that large.
function ports(@buffer: [u8], count: u64) -> i64
    return hero_serial_ports(@buffer, count: count)

# The port at `path` opened as a stream, passing bytes as they are, or
# `nullptr`. It aborts where `path` holds a zero byte.
function open(path: str) -> hero_stream.Stream
    return hero_serial_open(path.cstr())

## Settings

# 0 once the port `s` holds the speed, size, parity, stops and flow given,
# all at once, or -1; a value the port did not keep is
# `HERO_SERIAL_UNSUPPORTED` and the port is put back as it was.
function configure(s: hero_stream.Stream, baud: i64, data_bits: i64, parity: i64, stop_bits: i64, flow: i64) -> i64
    return hero_serial_configure(s, baud: baud, data_bits: data_bits, parity: parity, stop_bits: stop_bits, flow: flow)

# The setting `which`, one of `HERO_SERIAL_SETTING_*`, as the system holds it
# now, in `configure`'s numbers; or -1.
function setting(s: hero_stream.Stream, which: i64) -> i64
    return hero_serial_setting(s, which: which)

# 0 once the stream's read, write and gap timeouts are the milliseconds
# given, or -1; a read or a write timeout of `HERO_SERIAL_FOREVER` never ends
# a wait, and a gap of 0 is none.
function set_timeouts(s: hero_stream.Stream, read_ms: i64, write_ms: i64, gap_ms: i64) -> i64
    return hero_serial_set_timeouts(s, read_ms: read_ms, write_ms: write_ms, gap_ms: gap_ms)

# 0 with the stream's three timeouts in `read_ms`, `write_ms` and `gap_ms`, or
# -1 with nothing written.
function timeouts(s: hero_stream.Stream, @read_ms: i64, @write_ms: i64, @gap_ms: i64) -> i64
    return hero_serial_timeouts(s, read_ms: @read_ms, write_ms: @write_ms, gap_ms: @gap_ms)

## Lines

# The modem lines that are on, as `HERO_SERIAL_LINE_*` bits, or -1.
function lines(s: hero_stream.Stream) -> i64
    return hero_serial_lines(s)

# 0 once the line `line`, DTR or RTS, is raised (`on` 1) or dropped (`on`
# 0), or -1.
function set_line(s: hero_stream.Stream, line: i64, on: i64) -> i64
    return hero_serial_set_line(s, line: line, on: on)

# 0 once the line was held in break for `ms` milliseconds and let go, or -1.
function send_break(s: hero_stream.Stream, ms: i64) -> i64
    return hero_serial_send_break(s, ms: ms)

# 0 once the line is held in break (`on` 1) or let go (`on` 0), or -1.
function set_break(s: hero_stream.Stream, on: i64) -> i64
    return hero_serial_set_break(s, on: on)

## Buffers

# 0 once what the port holds of `which`, `HERO_SERIAL_INPUT`,
# `HERO_SERIAL_OUTPUT` or both added, is thrown away, or -1.
function discard(s: hero_stream.Stream, which: i64) -> i64
    return hero_serial_discard(s, which: which)

# 0 once every byte written has been sent, waiting at most the write timeout,
# or -1.
function drain(s: hero_stream.Stream) -> i64
    return hero_serial_drain(s)

# How many bytes the port holds of `which`, `HERO_SERIAL_INPUT` or
# `HERO_SERIAL_OUTPUT`, or -1.
function waiting(s: hero_stream.Stream, which: i64) -> i64
    return hero_serial_waiting(s, which: which)

## Pseudo-terminals

# The controlling side of a new pseudo-terminal as a stream, or `nullptr`
# (`HERO_SERIAL_UNSUPPORTED` on Windows).
function pseudo() -> hero_stream.Stream
    return hero_serial_pseudo()

# How many bytes the path of the port side of the pseudo-terminal whose
# controlling side is `s` takes, or -1. `buffer` is filled as far as `count`
# reaches, no zero after, and left `count` long.
function pseudo_path(s: hero_stream.Stream, @buffer: [u8], count: u64) -> i64
    return hero_serial_pseudo_path(s, @buffer, count: count)

## Failure

# The kind of the last call's failure on this thread, `HERO_SERIAL_OK` after
# one that did not fail.
function last_error() -> i64
    return hero_serial_last_error()

# The platform's own number for the last call's failure on this thread, 0
# where the layer itself refused.
function last_os_error() -> i64
    return hero_serial_last_os_error()

## Tests

# The port side's path of the controlling side `c`, as text.
function test_path_of(c: hero_stream.Stream) -> str
    room: [u8] @= []
    n = pseudo_path(c, @room, count: 256)
    assert n > 0 && n <= 256
    return room.slice(from: 0, to: n).validated_bytes().must()

test "nullptr is no stream: every call on a port answers -1 with HERO_SERIAL_NOT_OPEN"
    none: hero_stream.Stream = nullptr
    assert configure(none, baud: 9600, data_bits: 8, parity: HERO_SERIAL_PARITY_NONE, stop_bits: HERO_SERIAL_STOP_ONE, flow: 0) == -1
    assert last_error() == HERO_SERIAL_NOT_OPEN
    assert setting(none, which: HERO_SERIAL_SETTING_BAUD) == -1
    assert set_timeouts(none, read_ms: 0, write_ms: 0, gap_ms: 0) == -1
    r: i64 @= 7
    w: i64 @= 7
    g: i64 @= 7
    assert timeouts(none, read_ms: @r, write_ms: @w, gap_ms: @g) == -1
    assert r == 7 && w == 7 && g == 7
    assert lines(none) == -1
    assert set_line(none, line: HERO_SERIAL_LINE_DTR, on: 1) == -1
    assert send_break(none, ms: 1) == -1
    assert set_break(none, on: 0) == -1
    assert discard(none, which: HERO_SERIAL_INPUT) == -1
    assert drain(none) == -1
    assert waiting(none, which: HERO_SERIAL_INPUT) == -1
    room: [u8] @= []
    assert pseudo_path(none, @room, count: 8) == -1
    assert last_error() == HERO_SERIAL_NOT_OPEN
    assert last_os_error() == 0

test "ports: an empty buffer asks the size, a buffer that large holds every name ended by a zero byte"
    nothing: [u8] @= []
    need = ports(@nothing, count: 0)
    assert need >= 0
    assert last_error() == HERO_SERIAL_OK
    room: [u8] @= []
    got = ports(@room, count: (need + 64).to_u64().must())

    # A port may come or go between the two calls; the list is the system's
    # of each moment.
    if got >= 0 && got <= need + 64 && got > 0
        assert room[got - 1] == 0

test "open: an empty path is refused, a path that names nothing is HERO_SERIAL_NOT_FOUND"
    none = open("")
    assert none == nullptr
    assert last_error() == HERO_SERIAL_INVALID
    missing @= open("/dev/heroes-no-such-port")

    if missing == nullptr
        assert last_error() == HERO_SERIAL_NOT_FOUND || last_error() == HERO_SERIAL_DENIED
    else
        assert hero_stream.close(@missing) == 0

test "a pseudo-terminal: its port side opened, set and read back, bytes both ways, every byte value unchanged, each side closed once"
    c @= pseudo()

    if c == nullptr
        # Windows has none.
        assert last_error() == HERO_SERIAL_UNSUPPORTED
    else
        p @= open(test_path_of(c))
        assert p != nullptr
        assert configure(p, baud: 9600, data_bits: 8, parity: HERO_SERIAL_PARITY_NONE, stop_bits: HERO_SERIAL_STOP_ONE, flow: 0) == 0
        assert setting(p, which: HERO_SERIAL_SETTING_BAUD) == 9600
        assert setting(p, which: HERO_SERIAL_SETTING_DATA_BITS) == 8
        assert setting(p, which: HERO_SERIAL_SETTING_PARITY) == HERO_SERIAL_PARITY_NONE
        assert setting(p, which: HERO_SERIAL_SETTING_STOP_BITS) == HERO_SERIAL_STOP_ONE
        assert setting(p, which: HERO_SERIAL_SETTING_FLOW) == 0
        assert set_timeouts(p, read_ms: 2000, write_ms: 2000, gap_ms: 0) == 0
        assert set_timeouts(c, read_ms: 2000, write_ms: 2000, gap_ms: 0) == 0
        every: [u8] @= []

        for i in range(from: 0, to: 256)
            every @ every.push(i.to_u8().must())

        assert hero_stream.write(c, @every, n: 256) == 256
        back: [u8] @= []
        have: i64 @= 0
        piece: [u8] @= []

        while have < 256
            n = hero_stream.read(p, @piece, n: 256)
            assert n > 0

            for k in range(from: 0, to: n)
                back @ back.push(piece[k])

            have @ have + n

        assert back == every
        hello: [u8] @= [104, 105]
        assert hero_stream.write(p, @hello, n: 2) == 2
        heard: [u8] @= []
        assert hero_stream.read(c, @heard, n: 8) == 2
        assert heard[0] == 104 && heard[1] == 105
        assert hero_stream.close(@p) == 0
        assert hero_stream.close(@c) == 0

test "the controlling side is no port: settings, lines and breaks refused HERO_SERIAL_NOT_A_PORT, a port's path is HERO_SERIAL_INVALID"
    c @= pseudo()

    if c == nullptr
        assert last_error() == HERO_SERIAL_UNSUPPORTED
    else
        assert configure(c, baud: 9600, data_bits: 8, parity: HERO_SERIAL_PARITY_NONE, stop_bits: HERO_SERIAL_STOP_ONE, flow: 0) == -1
        assert last_error() == HERO_SERIAL_NOT_A_PORT
        assert lines(c) == -1
        assert last_error() == HERO_SERIAL_NOT_A_PORT
        assert send_break(c, ms: 1) == -1
        assert last_error() == HERO_SERIAL_NOT_A_PORT
        assert waiting(c, which: HERO_SERIAL_INPUT) == 0
        p @= open(test_path_of(c))
        room: [u8] @= []
        assert pseudo_path(p, @room, count: 8) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert hero_stream.close(@p) == 0
        assert hero_stream.close(@c) == 0

test "a stream of another member is no port: a pipe's end is HERO_SERIAL_NOT_A_PORT"
    reader: hero_stream.Stream @= nullptr
    writer: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @reader, writer: @writer) == 0
    assert setting(reader, which: HERO_SERIAL_SETTING_BAUD) == -1
    assert last_error() == HERO_SERIAL_NOT_A_PORT
    assert set_timeouts(writer, read_ms: 0, write_ms: 0, gap_ms: 0) == -1
    assert last_error() == HERO_SERIAL_NOT_A_PORT
    assert hero_stream.close(@reader) == 0
    assert hero_stream.close(@writer) == 0

test "timeouts: set and read back, -2 and a negative gap refused, the largest i64 taken, a read of 0 ms with nothing is HERO_STREAM_TIMED_OUT"
    c @= pseudo()

    if c == nullptr
        assert last_error() == HERO_SERIAL_UNSUPPORTED
    else
        r: i64 @= 0
        w: i64 @= 0
        g: i64 @= 0
        assert timeouts(c, read_ms: @r, write_ms: @w, gap_ms: @g) == 0
        assert r == HERO_SERIAL_FOREVER && w == HERO_SERIAL_FOREVER && g == 0
        assert set_timeouts(c, read_ms: -2, write_ms: 0, gap_ms: 0) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert set_timeouts(c, read_ms: 0, write_ms: 0, gap_ms: -1) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert set_timeouts(c, read_ms: 9223372036854775807, write_ms: 9223372036854775807, gap_ms: 9223372036854775807) == 0
        assert timeouts(c, read_ms: @r, write_ms: @w, gap_ms: @g) == 0
        assert r == 9223372036854775807 && g == 9223372036854775807
        p @= open(test_path_of(c))
        assert set_timeouts(p, read_ms: 0, write_ms: 0, gap_ms: 0) == 0
        nothing: [u8] @= []
        assert hero_stream.read(p, @nothing, n: 4) == -1
        assert hero_stream.last_error() == hero_stream.HERO_STREAM_TIMED_OUT
        assert hero_stream.close(@p) == 0
        assert hero_stream.close(@c) == 0

test "breaks, buffers and the lines of a port side: a break of 0 ms and of 5 ms, -1 refused, bytes counted and thrown away, a pty's lines HERO_SERIAL_UNSUPPORTED"
    c @= pseudo()

    if c == nullptr
        assert last_error() == HERO_SERIAL_UNSUPPORTED
    else
        p @= open(test_path_of(c))
        assert send_break(p, ms: 0) == 0
        assert send_break(p, ms: 5) == 0
        assert send_break(p, ms: -1) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert set_break(p, on: 1) == 0
        assert set_break(p, on: 0) == 0
        assert set_break(p, on: 2) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert discard(c, which: HERO_SERIAL_INPUT) == 0
        three: [u8] @= [1, 2, 3]
        assert hero_stream.write(c, @three, n: 3) == 3
        assert set_timeouts(p, read_ms: 2000, write_ms: 2000, gap_ms: 0) == 0
        seen: i64 @= 0
        tries: i64 @= 0

        while seen < 3 && tries < 200
            seen @ waiting(p, which: HERO_SERIAL_INPUT)
            tries @ tries + 1

        assert seen == 3
        assert discard(p, which: HERO_SERIAL_INPUT + HERO_SERIAL_OUTPUT) == 0
        assert waiting(p, which: HERO_SERIAL_INPUT) == 0
        assert discard(p, which: 4) == -1
        assert waiting(p, which: 3) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert drain(p) == 0
        assert lines(p) == -1
        assert last_error() == HERO_SERIAL_UNSUPPORTED
        assert set_line(p, line: HERO_SERIAL_LINE_RTS, on: 0) == -1
        assert last_error() == HERO_SERIAL_UNSUPPORTED
        assert set_line(p, line: HERO_SERIAL_LINE_CTS, on: 1) == -1
        assert last_error() == HERO_SERIAL_INVALID
        assert hero_stream.close(@p) == 0
        assert hero_stream.close(@c) == 0
