# The escapes of style sheets that the HTML mode writes a value with: a value
# where a declaration's value stands, refused unless it is a plain word, and
# a text inside a string, with the escapes of CSS. Each was written from the
# bytes Go's `html/template` 1.27 answered for every ASCII character and a
# sample past it, asked on 2026-11-16.

use strings
use template/internal/escape_text
use unicode

# `s` with the escapes of CSS read: a `\` and one to six hexadecimal digits,
# and one white space after them, is that code point; a `\` and another
# character is that character; a `\` at the end is dropped. Fails where a
# code point is 0 or no character.
function css_decoded(s: str) -> str?
    pieces: [str] @= []
    kept: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] != '\\'
            at @ at + 1
            continue

        if kept < at
            pieces @ pieces.push(s.slice(from: kept, to: at))
        at @ at + 1

        if at == s.len()
            kept @ at
            break

        if escape_text.is_hex(s[at])
            code: i64 @= 0
            digits: i64 @= 0

            while at < s.len() && digits < 6 && escape_text.is_hex(s[at])
                code @ code * 16 + hex_value(s[at])
                digits @ digits + 1
                at @ at + 1

            if code == 0
                return fail(code: "invalid", msg: "an escape of U+0000")
            pieces @ pieces.push(unicode.from_code_point(code)?)

            if at < s.len() && escape_text.is_space(s[at])
                at @ at + 1
        else
            width = unicode.width_at(s, at)
            pieces @ pieces.push(s.slice(from: at, to: at + width))
            at @ at + width
        kept @ at

    if kept < s.len()
        pieces @ pieces.push(s.slice(from: kept, to: s.len()))
    return ok(pieces.join(""))

# The value of a hexadecimal digit of either case.
function hex_value(b: u8) -> i64
    n = b.to_i64().must()

    if b >= '0' && b <= '9'
        return n - 48

    if b >= 'a' && b <= 'f'
        return n - 87
    return n - 55

# `s` where a value stands in a style sheet: its escapes read, and `escape_text.UNSAFE`
# where it then holds a quote, a bracket of any kind, `/`, `;`, `<`, `>`,
# `@`, `\`, a backtick or U+0000, or, its `-` dropped and in lower case,
# `expression` or `mozbinding`.
function css_value(s: str) -> str
    match css_decoded(s)
        .err _ => return escape_text.UNSAFE
        .ok decoded =>
            for at in range(from: 0, to: decoded.len())
                refused = match decoded[at]
                    '"'  => true
                    '\'' => true
                    '('  => true
                    ')'  => true
                    '/'  => true
                    ';'  => true
                    '<'  => true
                    '>'  => true
                    '@'  => true
                    '['  => true
                    ']'  => true
                    '\\' => true
                    '`'  => true
                    '{'  => true
                    '}'  => true
                    0    => true
                    _    => false

                if refused
                    return escape_text.UNSAFE

            folded = strings.replace_all(s: strings.to_lower_ascii(decoded), old: "-", new: "")

            if strings.contains(s: folded, substr: "expression") || strings.contains(s: folded, substr: "mozbinding")
                return escape_text.UNSAFE
            return decoded

# The CSS escape of `b` inside a string, "" where it is kept.
function css_byte(b: u8) -> str
    return match b
        0    => "\\0"
        '\t' => "\\9"
        '\n' => "\\a"
        0x0c => "\\c"
        '\r' => "\\d"
        '"'  => "\\22"
        '&'  => "\\26"
        '\'' => "\\27"
        '('  => "\\28"
        ')'  => "\\29"
        '+'  => "\\2b"
        '/'  => "\\2f"
        ':'  => "\\3a"
        ';'  => "\\3b"
        '<'  => "\\3c"
        '>'  => "\\3e"
        '\\' => "\\\\"
        '{'  => "\\7b"
        '}'  => "\\7d"
        _    => ""

# `s` inside a style sheet's string: quotes, brackets, `&`, `+`, `/`, `:`,
# `;`, `<`, `>`, `\` and the white space that ends a line as CSS's escapes,
# with a space after a hexadecimal one where a hexadecimal digit or white
# space follows it.
function css_string(s: str) -> str
    pieces: [str] @= []
    kept: i64 @= 0

    for at in range(from: 0, to: s.len())
        written = css_byte(s[at])

        if written != ""
            if kept < at
                pieces @ pieces.push(s.slice(from: kept, to: at))
            pieces @ pieces.push(written)

            if written != "\\\\" && at + 1 < s.len() && (escape_text.is_hex(s[at + 1]) || escape_text.is_space(s[at + 1]))
                pieces @ pieces.push(" ")
            kept @ at + 1

    if kept < s.len()
        pieces @ pieces.push(s.slice(from: kept, to: s.len()))
    return pieces.join("")

# `s` at the start of a style sheet's string, which may name a URL: `#` and
# `escape_text.UNSAFE` where it has another scheme than `http`, `https` and `mailto`,
# else as `css_string` writes it.
function css_string_start(s: str) -> str
    if !escape_text.is_safe_url(s)
        return "#" + escape_text.UNSAFE
    return css_string(s)

test "css_value: plain words, escapes read, and each value Go refuses"
    for value in ["red", "10px", "#fff", "é", "a-b_c#d.e,f:g%h!", ""]
        assert css_value(value) == value

    assert css_value("a\\z") == "az" && css_value("a\\3a b") == "a:b" && css_value("a\\") == "a"

    for value in ["expression(x)", "Expression", "-moz-binding", "mozbinding", "ex-pression", "\\65 xpression", "rgb(1,2,3)", "a\\(b", "a\\0", "a;b", "a/b"]
        assert css_value(value) == escape_text.UNSAFE

test "css_string: Go's escapes, the space after a hexadecimal one, and the filter at the start"
    assert css_string("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~") == "!\\22#$%\\26\\27\\28\\29*\\2b,-.\\2f\\3a\\3b\\3c=\\3e?@[\\\\]^_`\\7b|\\7d~"
    assert css_string("a\"b") == "a\\22 b" && css_string("a'b") == "a\\27 b" && css_string(" \t\n\r") == " \\9 \\a \\d"
    assert css_string("é1") == "é1"
    assert css_string_start("a:z") == "#ZrebelZ" && css_string_start("a b") == "a b"
