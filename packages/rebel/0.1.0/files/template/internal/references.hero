# HTML's character references read, as Python's `html.unescape` reads them,
# every rule observed from it on 2026-11-16: a name matched whole with its
# `;`, else by the longest of the names read with none that begins it; a
# number in decimal or after `x` in hexadecimal, its `;` optional, read as
# U+FFFD where it is 0, a surrogate or past U+10FFFF, through Windows-1252
# where it is 0x80 to 0x9F, and dropped where it is a control character or a
# noncharacter.

use strings
use template/internal/entities
use unicode

# The longest name a reference reads, in characters.
constant LONGEST_NAME: i64
    32

# The characters 0x80 to 0x9F name in Windows-1252, as a browser reads a
# number reference to them; the five the code page leaves out read as
# themselves.
constant WINDOWS_1252: [i64]
    [
        8364
        129
        8218
        402
        8222
        8230
        8224
        8225
        710
        8240
        352
        8249
        338
        141
        381
        143
        144
        8216
        8217
        8220
        8221
        8226
        8211
        8212
        732
        8482
        353
        8250
        339
        157
        382
        376
    ]

# What a reference at a place reads as: its text, and the byte after it.
record Read
    text: str
    next: i64

# The index of `name` in the table, or -1.
function index_of_name(name: str) -> i64
    low: i64 @= 0
    high: i64 @= entities.NAMES.len()

    while low < high
        middle = (low + high) / 2
        order = strings.compare(a: entities.NAMES[middle], b: name)

        if order == 0
            return middle

        if order < 0
            low @ middle + 1
        else
            high @ middle

    return -1

# The characters the name at `index` of the table reads as.
function value_of(index: i64) -> str
    points: [i64] @= [entities.FIRST[index]]

    if entities.SECOND[index] != 0
        points @ points.push(entities.SECOND[index])
    return unicode.from_code_points(points).must()

# The text the number `n` of a reference reads as.
function number_text(n: i64) -> str
    if n == 0 || n > 1114111 || n >= 0xd800 && n <= 0xdfff
        return "�"

    if n >= 0x80 && n <= 0x9f
        return unicode.from_code_point(WINDOWS_1252[n - 0x80]).must()
    dropped = n >= 1 && n <= 8 || n == 11 || n >= 14 && n <= 31 || n == 127
    noncharacter = n >= 0xfdd0 && n <= 0xfdef || n & 0xfffe == 0xfffe

    if dropped || noncharacter
        return ""
    return unicode.from_code_point(n).must()

# The value of the digit `b` in base 16, or -1.
function digit_value(b: u8, hex: bool) -> i64
    n = b.to_i64().must()

    if b >= '0' && b <= '9'
        return n - 48

    if hex && b >= 'a' && b <= 'f'
        return n - 87

    if hex && b >= 'A' && b <= 'F'
        return n - 55
    return -1

# The reference that begins with the `&` at `at` of `s`, read; `next` is `at`
# where none begins there.
function reference_at(s: str, at: i64) -> Read
    none = Read(text: "", next: at)
    k: i64 @= at + 1

    if k < s.len() && s[k] == '#'
        k @ k + 1
        hex = k < s.len() && (s[k] == 'x' || s[k] == 'X')

        if hex
            k @ k + 1
        first_digit = k
        n: i64 @= 0

        base: i64 = if hex
            16
        else
            10

        while k < s.len() && digit_value(s[k], hex: hex) >= 0
            if n <= 1114111
                n @ n * base + digit_value(s[k], hex: hex)
            k @ k + 1

        if k == first_digit
            return none

        if k < s.len() && s[k] == ';'
            k @ k + 1
        return Read(text: number_text(n), next: k)
    run_end: i64 @= k
    characters: i64 @= 0

    while run_end < s.len() && characters < LONGEST_NAME
        b = s[run_end]

        if b == '\t' || b == '\n' || b == 0x0c || b == ' ' || b == '<' || b == '&' || b == '#' || b == ';'
            break
        run_end @ run_end + unicode.width_at(s, run_end)
        characters @ characters + 1

    if run_end == k
        return none
    written_end: i64 @= run_end

    if run_end < s.len() && s[run_end] == ';'
        written_end @ run_end + 1
    whole = index_of_name(s.slice(from: k, to: written_end))

    if whole >= 0
        return Read(text: value_of(whole), next: written_end)
    length: i64 @= written_end - k - 1

    while length >= 2
        if unicode.is_char_boundary(s, k + length)
            found = index_of_name(s.slice(from: k, to: k + length))

            if found >= 0
                return Read(text: value_of(found), next: k + length)
        length @ length - 1

    return none

# `s` with every character reference read.
function unescape(s: str) -> str
    pieces: [str] @= []
    kept: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] != '&'
            at @ at + 1
            continue
        read = reference_at(s, at)

        if read.next == at
            at @ at + 1
            continue

        if kept < at
            pieces @ pieces.push(s.slice(from: kept, to: at))
        pieces @ pieces.push(read.text)
        at @ read.next
        kept @ at

    if pieces.len() == 0
        return s

    if kept < s.len()
        pieces @ pieces.push(s.slice(from: kept, to: s.len()))
    return pieces.join("")

test "index_of_name: the first and last names, one with no semicolon, and names absent"
    assert index_of_name("AElig") == 0
    assert index_of_name("zwnj;") == entities.NAMES.len() - 1
    assert index_of_name("amp") >= 0 && index_of_name("amp;") >= 0
    assert index_of_name("zz;") == -1 && index_of_name("") == -1

test "unescape: Python's html.unescape over numbers at every edge"
    cases: {str: str} = {
        "&#0;": "�"
        "&#1;&#8;&#11;&#14;&#31;&#127;": ""
        "&#9;&#13;": "\t\r"
        "&#128;&#130;&#159;": "€‚Ÿ"
        "&#xD800;&#x110000;&#99999999999999999999;": "���"
        "&#x10FFFF;&#xFDD0;&#xFFFE;&#x1FFFE;": ""
        "&#65&#x41g&#0000065;&#X41;": "AAgAA"
        "&#;&#x;": "&#;&#x;"
    }

    for text in keys(cases)
        assert unescape(text) == cases[text].must()

    c1: [u8] = [0xc2, 0x81, 0xc2, 0x8d]
    assert unescape("&#129;&#141;") == c1.validated_bytes().must()

test "unescape: Python's html.unescape over names, with and without their semicolon, and what is no reference"
    cases: {str: str} = {
        "&amp": "&"
        "&ampx": "&x"
        "&amp;x": "&x"
        "&notit;": "¬it;"
        "&notin;": "∉"
        "&noti": "¬i"
        "&AElig": "Æ"
        "&AEli": "&AEli"
        "&zz;": "&zz;"
        "& ;": "& ;"
        "&": "&"
        "&&lt;": "&<"
        "&LT": "<"
        "&Lt;": "≪"
        "&lt=": "<="
        "&am;": "&am;"
        "&NotEqualTilde;": "≂̸"
        "a &lt;b&gt; c": "a <b> c"
        "": ""
    }

    for text in keys(cases)
        assert unescape(text) == cases[text].must()
