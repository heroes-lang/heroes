        assert rendered(written, value) == cases[written].must()

# Go 1.27.4's html/template, each template executed with `true` and with
# `false`, observed 2026-11-22; the first five are defect 2657's.
test "html: an attribute written only where a value is true, the five shapes and those beside, else, a value, a comment and two in a row, as Go's html/template writes it"
    cases: {str: [str]} = {
        "<select><option{{ if . }} selected{{ end }}>a</option></select>": ["<select><option selected>a</option></select>", "<select><option>a</option></select>"]
        "<select><option {{ if . }}selected{{ end }}>a</option></select>": ["<select><option selected>a</option></select>", "<select><option >a</option></select>"]
        "<input type=\"checkbox\"{{ if . }} checked{{ end }}>": ["<input type=\"checkbox\" checked>", "<input type=\"checkbox\">"]
        "<input type=\"checkbox\" {{ if . }}checked{{ end }}>": ["<input type=\"checkbox\" checked>", "<input type=\"checkbox\" >"]
        "<input {{ if . }}checked {{ end }}type=\"checkbox\">": ["<input checked type=\"checkbox\">", "<input type=\"checkbox\">"]
        "<option {{ if . }}selected{{ else }}data-x{{ end }}>": ["<option selected>", "<option data-x>"]
        "<option {{ if . }}selected{{ else }}class=\"b\"{{ end }}>": ["<option selected>", "<option class=\"b\">"]
        "<option{{ if . }} selected{{ else }} class=\"b\"{{ end }}>": ["<option selected>", "<option class=\"b\">"]
        "<option{{ if . }} value=\"{{ . }}\"{{ end }}>": ["<option value=\"true\">", "<option>"]
        "<a{{ if . }} href=\"{{ . }}\"{{ end }}>x</a>": ["<a href=\"true\">x</a>", "<a>x</a>"]
        "<input{{ if . }} checked{{ end }}{{ if . }} disabled{{ end }}>": ["<input checked disabled>", "<input>"]
        "<input {{ if . }}checked{{ end }} {{ if . }}disabled{{ end }}>": ["<input checked disabled>", "<input  >"]
        "<input{{ if . }} checked{{ end }}/>": ["<input checked/>", "<input/>"]
        "<input {{ if . }}checked{{ end }} type=\"checkbox\">": ["<input checked type=\"checkbox\">", "<input  type=\"checkbox\">"]
        "<input {{/* a note */}}{{ if . }}checked{{ end }}>": ["<input checked>", "<input >"]
        "<input {{ if . }}checked{{/* a note */}}{{ end }}>": ["<input checked>", "<input >"]
        "<input{{ if . }} checked{{ end }}{{/* a note */}}>": ["<input checked>", "<input>"]
        "{{ if . }}<!-- c -->{{ end }}<b>x</b>": ["<b>x</b>", "<b>x</b>"]
        "<option {{ if . }}selected{{ end }}=x>": ["<option selected=x>", "<option =x>"]
        "<option{{ if . }} selected{{ end }}x>": ["<option selectedx>", "<optionx>"]
        "<option{{ if . }} selected{{ end }} {{ . }}>": ["<option selected true>", "<option false>"]
        "<input {{ if . }}checked {{ end }}{{ . }}>": ["<input checked true>", "<input false>"]
        "<input {{ if . }}checked{{ end }}>{{ . }}": ["<input checked>true", "<input >false"]
        "<script{{ if . }} async{{ end }}>var x = {{ . }};</script>": ["<script async>var x =  true ;</script>", "<script>var x =  false ;</script>"]
        "<input {{ if . }}checked{{ else }}{{ end }}>": ["<input checked>", "<input >"]
        "<input {{ if . }}{{ else }}checked{{ end }}>": ["<input >", "<input checked>"]
        "<input {{ if . }}checked=\"checked\"{{ end }}>": ["<input checked=\"checked\">", "<input >"]
        "<input {{ if . }}a{{ end }}{{ if . }}b{{ end }}>": ["<input ab>", "<input >"]
        "<input {{ if . }}a{{ end }} b{{ if . }}c{{ end }}>": ["<input a bc>", "<input  b>"]
        "<option{{ if . }}  selected  {{ end }}>": ["<option  selected  >", "<option>"]
        "<input type=\"checkbox\"{{ if . }}\tchecked{{ end }}>": ["<input type=\"checkbox\"\tchecked>", "<input type=\"checkbox\">"]
        "<opt{{ if . }}ion{{ end }}>": ["<option>", "<opt>"]
    }

    for written in keys(cases)
        assert rendered(written, .boolean(v: true)) == cases[written].must()[0]
        assert rendered(written, .boolean(v: false)) == cases[written].must()[1]

# Go 1.27.4's html/template, each template executed with `[true, false]` and
# with `[]`, observed 2026-11-22, its `range` written `for` here.
test "html: an attribute written in a loop's body inside a tag, its else, and an option marked in a loop, as Go's html/template writes it"
    cases: {str: [str]} = {
        "<input {{ for $x in . }}checked {{ end }}>": ["<input checked checked >", "<input >"]
        "<input{{ for $x in . }} checked{{ end }}>": ["<input checked checked>", "<input>"]
        "<select>{{ for $x in . }}<option{{ if $x }} selected{{ end }}>x</option>{{ end }}</select>": ["<select><option selected>x</option><option>x</option></select>", "<select></select>"]
        "<input {{ for $x in . }} checked{{ else }} disabled{{ end }}>": ["<input  checked checked>", "<input  disabled>"]
        "<input{{ for $x in . }} c{{ end }}x>": ["<input c cx>", "<inputx>"]
    }

    for written in keys(cases)
        assert rendered(written, json.parse("[true, false]").must()) == cases[written].must()[0]
        assert rendered(written, json.parse("[]").must()) == cases[written].must()[1]

# Each refused for every value. Go 1.27.4's html/template, observed
# 2026-11-22, refuses the last seven; it renders the first nine, writing a
# value into a tag's name (`<option="false">`, `<optionfalse>`), into an
# attribute's name (`<option ="false">`, `<input checkedtrue>`,
# `<input data-true data-false>`, `<a / ="…">`), a name longer at each turn
# (`<input checkedchecked>`), a value escaped as text inside a script
# (`<script>true`), and one escaped for a script where a way stands in none
# (`<scriptx>[]</script>`). The `include` was not asked of Go, whose
# `template` action is another.
test "html: ways apart inside a tag refused where a value, an `include` or the end meets them, and a value after a `=` that begins a name"
    refused = [
        "<option{{ if . }} selected{{ end }}=\"{{ . }}\">"
        "<option {{ if . }}selected{{ end }}=\"{{ . }}\">"
        "<input {{ if . }}checked{{ end }}{{ . }}>"
        "<option{{ if . }} selected{{ end }}{{ . }}>"
        "<input {{ for $x in . }}checked{{ end }}>"
        "<input{{ for $x in . }} data-{{ $x }}{{ end }}>"
        "<scr{{ if . }}ipt{{ end }}>{{ . }}"
        "<a / =\"{{ . }}\">"
        "<script{{ if . }} async{{ end }}x>{{ . }}</script>"
        "<input{{ if . }} checked{{ end }}{{ include \"x\" . }}>{{ define \"x\" }}{{ end }}"
        "<a {{ if . }}title{{ else }}href{{ end }}=\"{{ . }}\">"
        "<a {{ if . }}on{{ end }}click=\"{{ . }}\">"
        "<input {{ if . }}style{{ end }}=\"{{ . }}\">"
        "{{ if . }}<b{{ end }}>"
        "<input {{ if . }}checked{{ end }}"
        "<input {{ if . }}checked=checked{{ end }}>"
        "<a =\"{{ . }}\">"
    ]

    for written in refused
        assert rendered(written, .boolean(v: true)) == "ERR invalid"
        assert rendered(written, json.parse("[true]").must()) == "ERR invalid"

test "html: templates refused: branches in different places, a URL part unknown, a template ending inside a tag, and unquoted values holding a quote or =, as Go's html/template writes it"
    value: json.Value = .text(v: "x")
    cases: {str: str} = {
        "{{if .}}<a href=\"{{else}}<b>{{end}}\">": "ERR invalid"
        "<a href=\"{{if .}}/x{{else}}?{{end}}{{.}}\">": "ERR invalid"
        "<a href=\"{{.}}": "ERR invalid"
        "<a title=\"{{.}}": "ERR invalid"
        "<script>x": "ERR invalid"
        "<a href=/x?q={{.}}>": "ERR invalid"
        "<a title=x\"y>": "ERR invalid"
        "<a title=x'y>": "ERR invalid"
        "<a title=x`y>": "ERR invalid"
        "<a title=x<y>": "ERR invalid"
    }

    for written in keys(cases)
        assert rendered(written, value) == cases[written].must()
