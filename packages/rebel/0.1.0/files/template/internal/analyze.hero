        "<{{.}}>": "&lt;&lt;b&gt;>"
        "a </{{.}}": "a &lt;/&lt;b&gt;"
        "<?xml version=\"1.0\"?>{{.}}": "&lt;?xml version=\"1.0\"?>&lt;b&gt;"
        "<title>a < b {{.}}</title>": "<title>a &lt; b &lt;b&gt;</title>"
        "<textarea><b>{{.}}</b></textarea>": "<textarea>&lt;b>&lt;b&gt;&lt;/b></textarea>"
        "<!DOCTYPE html>{{.}}": "<!DOCTYPE html>&lt;b&gt;"
        "<![CDATA[ {{.}} ]]>": "&lt;![CDATA[ &lt;b&gt; ]]>"
        "<a href=\"x\"/>{{.}}": "<a href=\"x\"/>&lt;b&gt;"
        "<title>a</title>{{.}}": "<title>a</title>&lt;b&gt;"
        "<style>p{}</style>{{.}}": "<style>p{}</style>&lt;b&gt;"
        "<textarea>{{.}}</textarea >": "<textarea>&lt;b&gt;</textarea >"
    }

    for written in keys(cases)
        assert rendered(written, value) == cases[written].must()

