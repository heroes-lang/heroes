# A port reached through the server.
test "dial: the server's own SSH port"
    match opening.server()
        .err _ => skip_test(reason: "REBEL_SSH_PORT, REBEL_SSH_USER and REBEL_SSH_DIR name no sshd")
        .ok found =>
            c @= Client(state: opening.signed_in(found).must(), user: found.user)
            tunnel = dial(@c, host: "127.0.0.1", port: found.port).must()
            assert read(@c, channel: tunnel, n: 4).must() == bytes.from_text("SSH-")
            close_channel(@c, channel: tunnel).must()
            close(@c).must()

# A port the server listens on for this client.
test "listen_remote: a port the server chooses"
    match opening.server()
        .err _ => skip_test(reason: "REBEL_SSH_PORT, REBEL_SSH_USER and REBEL_SSH_DIR name no sshd")
        .ok found =>
            c @= Client(state: opening.signed_in(found).must(), user: found.user)
            port = listen_remote(@c, host: "127.0.0.1", port: 0).must()
            cancel_remote(@c, host: "127.0.0.1", port: port).must()
            close(@c).must()

# A connection the server forwarded.
test "accept_remote: one connection"
    match opening.server()
        .err _ => skip_test(reason: "REBEL_SSH_PORT, REBEL_SSH_USER and REBEL_SSH_DIR name no sshd")
        .ok found =>
            c @= Client(state: opening.signed_in(found).must(), user: found.user)
            port = listen_remote(@c, host: "127.0.0.1", port: 0).must()
            conn @= net.connect("127.0.0.1", port: port, deadline_ms: 10000).must()
            forwarded = accept_remote(@c).must()
            assert forwarded.origin_host != ""
            io.close(@conn.stream).must()
            close_channel(@c, channel: forwarded.channel).must()
            close(@c).must()

# A remote forward ended.
test "cancel_remote: a forward ended"
    match opening.server()
        .err _ => skip_test(reason: "REBEL_SSH_PORT, REBEL_SSH_USER and REBEL_SSH_DIR name no sshd")
        .ok found =>
            c @= Client(state: opening.signed_in(found).must(), user: found.user)
            port = listen_remote(@c, host: "127.0.0.1", port: 0).must()
            cancel_remote(@c, host: "127.0.0.1", port: port).must()
            close(@c).must()
