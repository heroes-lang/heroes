  python  S3.Client.get_object_acl, S3.Client.put_object_acl, S3.Client.get_object_retention, S3.Client.put_object_retention, S3.Client.get_object_legal_hold, S3.Client.put_object_legal_hold, S3.Client.get_object_lock_configuration, S3.Client.put_object_lock_configuration
