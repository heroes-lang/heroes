# The platform layer's access control lists, `hero_acl.h`, bound thin: one
# function per C function, in C's order, each answering what C answers. The
# floor of `fs/acl`: where a call fails its answer is -1 and `last_error` then
# the kind, which the face turns into a code.
#
# The layer is C of the language's own beside the runtime, so this group names
# its header and no `link`, and the same lines bind it on every platform. A
# list read and an id are the header's fill form: `buffer` is left `n` bytes
# long and the answer is how many bytes the whole answer has; where that is
# above `n` the buffer was too short and holds nothing to read, and the caller
# asks again with that many. A list is fields of text, each followed by a zero
# byte, in the form the header gives.

extern "hero_acl.h"
    # The kinds of failure `last_error` answers, the same numbers on every
    # platform; the header says what each means.
    constant HERO_ACL_OK: i64
    constant HERO_ACL_INVALID: i64
    constant HERO_ACL_NOT_FOUND: i64
    constant HERO_ACL_DENIED: i64
    constant HERO_ACL_NOT_A_DIRECTORY: i64
    constant HERO_ACL_LIMIT: i64
    constant HERO_ACL_UNSUPPORTED: i64
    constant HERO_ACL_OTHER: i64
    constant HERO_ACL_NOT_TEXT: i64
    constant HERO_ACL_UNKNOWN: i64
    constant HERO_ACL_CANNOT: i64
    # Why an entry cannot be held, after `HERO_ACL_CANNOT`.
    constant HERO_ACL_CANNOT_WHO: i64
    constant HERO_ACL_CANNOT_DENY: i64
    constant HERO_ACL_CANNOT_RIGHT: i64
    constant HERO_ACL_CANNOT_FLAG: i64
    constant HERO_ACL_CANNOT_PROTECT: i64
    constant HERO_ACL_CANNOT_DEFAULT: i64
    constant HERO_ACL_CANNOT_READ: i64
    # Whom an entry names.
    constant HERO_ACL_USER: i64
    constant HERO_ACL_GROUP: i64
    constant HERO_ACL_OWNER: i64
    constant HERO_ACL_OWNING_GROUP: i64
    constant HERO_ACL_OTHERS: i64
    constant HERO_ACL_MASK: i64
    # How many fields one entry holds.
    constant HERO_ACL_FIELDS: i64
    function hero_acl_read(path: cstr lent, follow: i64, @buffer: [u8] counted_by n lent, n: u64) -> i64
    function hero_acl_write(path: cstr lent, follow: i64, @list: [u8] counted_by size lent, size: u64) -> i64
    function hero_acl_id_of(name: cstr lent, group: i64, @buffer: [u8] counted_by n lent, n: u64) -> i64
    function hero_acl_last_error() -> i64
    function hero_acl_last_os_error() -> i64
    function hero_acl_last_reason() -> i64

# How many bytes `path`'s list has, or -1. It is written into `buffer` where
# `n` bytes hold it.
#
# - `path`: the file or folder asked; it holds no zero byte.
# - `follow`: 1 follows a link at the path's end, 0 asks the link itself.
# - `buffer`: where the list is written, where `n` bytes hold it; left `n`
#   long.
# - `n`: the bytes `buffer` holds; an answer above it says `buffer` was too
#   short and holds nothing to read.
function read(path: str, follow: i64, @buffer: [u8], n: u64) -> i64
    return hero_acl_read(path.cstr(), follow: follow, @buffer, n: n)

# 0 where `path`'s list is now the first `size` bytes of `list`, or -1.
#
# - `path`: the file or folder written; it holds no zero byte.
# - `follow`: 1 follows a link at the path's end, 0 writes the link itself.
# - `list`: the list, in the header's form; left as it was handed.
# - `size`: how many bytes of `list` are the list.
function write(path: str, follow: i64, @list: [u8], size: u64) -> i64
    return hero_acl_write(path.cstr(), follow: follow, @list, size: size)

# How many bytes the id of the user, or the group where `group` is 1, named
# `name` has, or -1. It is written into `buffer` where `n` bytes hold it.
#
# - `name`: the user's or group's name; it holds no zero byte.
# - `group`: 1 asks a group, 0 a user.
# - `buffer`: where the id is written, where `n` bytes hold it; left `n` long.
# - `n`: the bytes `buffer` holds; an answer above it says `buffer` was too
#   short and holds nothing to read.
function id_of(name: str, group: i64, @buffer: [u8], n: u64) -> i64
    return hero_acl_id_of(name.cstr(), group: group, @buffer, n: n)

# The kind of the last call's failure on this thread, `HERO_ACL_OK` after one
# that did not fail.
function last_error() -> i64
    return hero_acl_last_error()

# The platform's own number for the last failure on this thread, 0 where the
# layer itself refused, and after `HERO_ACL_CANNOT` the entry's place, from 1.
function last_os_error() -> i64
    return hero_acl_last_os_error()

# Why the entry `last_os_error` names cannot be held, after `HERO_ACL_CANNOT`;
# 0 after any other kind.
function last_reason() -> i64
    return hero_acl_last_reason()

# How many fields one entry of a list holds.
function fields() -> i64
    return HERO_ACL_FIELDS

## Tests

test "read: a path that is not there is the layer's not-found kind, and an empty path is refused before the system is asked"
    room: [u8] @= []
    assert read("hero-acl-floor-no-such-path", follow: 1, @room, n: 64) == -1
    assert last_error() == HERO_ACL_NOT_FOUND
    assert last_os_error() != 0
    assert read("", follow: 1, @room, n: 64) == -1
    assert last_error() == HERO_ACL_INVALID
    assert last_os_error() == 0

test "write: bytes that are not the header's form are invalid before the system is asked"
    list: [u8] @= ['0', 0, '9', 0]
    assert write("hero-acl-floor-no-such-path", follow: 1, @list, size: 4) == -1
    assert last_error() == HERO_ACL_INVALID
    assert last_reason() == 0

test "fields: the header's count, six fields to an entry"
    assert fields() == HERO_ACL_FIELDS
    assert fields() == 6
