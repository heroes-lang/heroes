# The wire, field by field: varints, fixed-width numbers, tags and
# length-delimited values written at the end of a buffer and read from a
# place in one, and a field skipped, a group's nesting held on a list. Every
# failure is `invalid` and its message names the byte, counted from 0.

use bytes

# The wire type of a varint.
constant VARINT: i64
    0

# The wire type of eight bytes.
constant FIXED64: i64
    1

# The wire type of a length-delimited value.
constant BYTES: i64
    2

# The wire type of a group's start.
constant START_GROUP: i64
    3

# The wire type of a group's end.
constant END_GROUP: i64
    4

# The wire type of four bytes.
constant FIXED32: i64
    5

# The largest field number.
constant MAX_NUMBER: i64
    536870911

# A number read, and the index after it.
record Number
    # The number.
    value: u64
    # The index of the byte after it.
    next: i64

# A tag read.
record Tag
    # The field number.
    number: i64
    # The wire type, 0 to 5.
    wire: i64
    # The index of the value's first byte.
    next: i64

# A length-delimited value read, and the index after it.
record Slice
    # The bytes.
    data: [u8]
    # The index of the byte after them.
    next: i64

# One field read with no schema, or the start or end of a group.
record Raw
    # The field number.
    number: i64
    # The wire type.
    wire: i64
    # A varint's or a fixed number's value.
    value: u64
    # A length-delimited value's bytes.
    data: [u8]

# Writes `v` as a varint at the end of `to`.
function push_varint(@to: [u8], v: u64)
    left: u64 @= v

    while left >= 128
        to @ to.push(to_u8(left % 128 + 128).must())
        left @ left / 128

    to @ to.push(to_u8(left).must())

# Writes `number`'s tag at the end of `to`.
function push_tag(@to: [u8], number: i64, wire: i64)
    assert number >= 1 && number <= MAX_NUMBER
    push_varint(@to, to_u64(number * 8 + wire).must())

# Writes `v` as four bytes, the lowest first.
function push_fixed32(@to: [u8], v: u32)
    left: u32 @= v

    for _ in range(from: 0, to: 4)
        to @ to.push(to_u8(left % 256).must())
        left @ left / 256

# Writes `v` as eight bytes, the lowest first.
function push_fixed64(@to: [u8], v: u64)
    left: u64 @= v

    for _ in range(from: 0, to: 8)
        to @ to.push(to_u8(left % 256).must())
        left @ left / 256

# Writes `v`'s length as a varint, then `v`.
function push_bytes(@to: [u8], v: [u8])
    push_varint(@to, to_u64(v.len()).must())

    for b in v
        to @ to.push(b)

# How many bytes `v` takes as a varint.
function varint_size(v: u64) -> i64
    size: i64 @= 1
    left: u64 @= v

    while left >= 128
        left @ left / 128
        size @ size + 1

    return size

# The varint at byte `at` of `data`.
function varint(data: [u8], at: i64) -> Number?
    if at < 0 || at >= data.len()
        return fail(code: "invalid", msg: f"byte {at}: the bytes end where a varint begins")

    match bytes.decode_uvarint(data, at: at)
        .ok read => return ok(Number(value: read.value, next: at + read.width))
        .err e =>
            if e.code == "does_not_fit"
                return fail(code: "invalid", msg: f"byte {at}: a varint passes 64 bits")
            return fail(code: "invalid", msg: f"byte {at}: the bytes end inside a varint")

# The four bytes at byte `at` of `data`, the lowest first.
function fixed32(data: [u8], at: i64) -> Number?
    if at < 0 || at + 4 > data.len()
        return fail(code: "invalid", msg: f"byte {at}: four bytes were expected, {data.len() - at} are left")
    v: u64 @= 0
    k: i64 @= 3

    while k >= 0
        v @ v * 256 + to_u64(data[at + k]).must()
        k @ k - 1

    return ok(Number(value: v, next: at + 4))

# The eight bytes at byte `at` of `data`, the lowest first.
function fixed64(data: [u8], at: i64) -> Number?
    if at < 0 || at + 8 > data.len()
        return fail(code: "invalid", msg: f"byte {at}: eight bytes were expected, {data.len() - at} are left")
    v: u64 @= 0
    k: i64 @= 7

    while k >= 0
        v @ v * 256 + to_u64(data[at + k]).must()
        k @ k - 1

    return ok(Number(value: v, next: at + 8))

# The tag at byte `at` of `data`.
function tag(data: [u8], at: i64) -> Tag?
    read = varint(data, at: at)?

    if read.value > 4294967295
        return fail(code: "invalid", msg: f"byte {at}: a tag passes 32 bits")
    whole = to_i64(read.value).must()
    number = whole / 8
    wire = whole % 8

    if wire > 5
        return fail(code: "invalid", msg: f"byte {at}: wire type {wire} is no wire type")

    if number < 1 || number > MAX_NUMBER
        return fail(code: "invalid", msg: f"byte {at}: field number {number} is outside 1 to {MAX_NUMBER}")
    return ok(Tag(number: number, wire: wire, next: read.next))

# Where the length-delimited value at byte `at` of `data` begins and ends:
# `value` is its length, `next` its first byte.
function span(data: [u8], at: i64) -> Number?
    read = varint(data, at: at)?
    left = data.len() - read.next

    if read.value > to_u64(left).must()
        return fail(code: "invalid", msg: f"byte {at}: a length of {read.value} passes the {left} bytes left")
    return ok(read)

# The bytes of the length-delimited value at byte `at` of `data`.
function delimited(data: [u8], at: i64) -> Slice?
    s = span(data, at: at)?
    to = s.next + to_i64(s.value).must()
    return ok(Slice(data: data.slice(from: s.next, to: to), next: to))

# The index past the value of the field whose tag ends at `at`.
function skip(data: [u8], number: i64, wire: i64, at: i64, max_depth: i64) -> i64?
    if wire == VARINT
        return ok(varint(data, at: at)?.next)

    if wire == FIXED64
        return ok(fixed64(data, at: at)?.next)

    if wire == FIXED32
        return ok(fixed32(data, at: at)?.next)

    if wire == BYTES
        s = span(data, at: at)?
        return ok(s.next + to_i64(s.value).must())

    if wire == END_GROUP
        return fail(code: "invalid", msg: f"byte {at}: the end of group {number} where no group is open")
    open: [i64] @= [number]
    here: i64 @= at

    while open.len() > 0
        t = tag(data, at: here)?

        if t.wire == START_GROUP
            if open.len() >= max_depth
                return fail(code: "invalid", msg: f"byte {here}: groups nested deeper than {max_depth}")
            open @ open.push(t.number)
            here @ t.next
        else if t.wire == END_GROUP
            if t.number != open[open.len() - 1]
                return fail(
                    code: "invalid",
                    msg: f"byte {here}: the end of group {t.number} inside group {open[open.len() - 1]}"
                )
            open @ open.slice(from: 0, to: open.len() - 1)
            here @ t.next
        else
            here @ skip(data, number: t.number, wire: t.wire, at: t.next, max_depth: 1)?

    return ok(here)

# The fields of `data`, read with no schema, a group's start and end each one
# of them, as `Raw` holds them.
function raw_fields(data: [u8], max_depth: i64) -> [Raw]?
    out: [Raw] @= []
    open: [i64] @= []
    at: i64 @= 0
    empty: [u8] = []

    while at < data.len()
        t = tag(data, at: at)?

        if t.wire == START_GROUP
            if open.len() >= max_depth
                return fail(code: "invalid", msg: f"byte {at}: groups nested deeper than {max_depth}")
            open @ open.push(t.number)
            out @ out.push(Raw(number: t.number, wire: START_GROUP, value: 0, data: empty))
            at @ t.next
        else if t.wire == END_GROUP
            if open.len() == 0 || open[open.len() - 1] != t.number
                return fail(code: "invalid", msg: f"byte {at}: the end of group {t.number} where it is not open")
            open @ open.slice(from: 0, to: open.len() - 1)
            out @ out.push(Raw(number: t.number, wire: END_GROUP, value: 0, data: empty))
            at @ t.next
        else if t.wire == BYTES
            got = delimited(data, at: t.next)?
            out @ out.push(Raw(number: t.number, wire: BYTES, value: 0, data: got.data))
            at @ got.next
        else
            read = if t.wire == VARINT
                varint(data, at: t.next)?
            else if t.wire == FIXED64
                fixed64(data, at: t.next)?
            else
                fixed32(data, at: t.next)?
            out @ out.push(Raw(number: t.number, wire: t.wire, value: read.value, data: empty))
            at @ read.next

    if open.len() > 0
        return fail(code: "invalid", msg: f"byte {at}: group {open[open.len() - 1]} has no end")
    return ok(out)

test "push_varint and varint: one byte, two, the largest, a long form, and each way it fails"
    out: [u8] @= []
    push_varint(@out, 1)
    push_varint(@out, 300)
    push_varint(@out, 18446744073709551615)
    assert out == [0x01, 0xac, 0x02, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01]
    assert varint(out, at: 1).must() == Number(value: 300, next: 3)
    assert varint(out, at: 3).must().value == 18446744073709551615
    assert varint([0x80, 0x00], at: 0).must() == Number(value: 0, next: 2)
    assert varint([0x80], at: 0).is_err() && varint([], at: 0).is_err()
    assert varint([0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x02], at: 0).is_err()
    assert varint([0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00], at: 0).is_err()
    assert varint_size(0) == 1 && varint_size(127) == 1 && varint_size(128) == 2 && varint_size(18446744073709551615) == 10

test "fixed32 and fixed64: the lowest byte first, and too few bytes"
    out: [u8] @= []
    push_fixed32(@out, 4294967295)
    push_fixed64(@out, 258)
    assert out == [0xff, 0xff, 0xff, 0xff, 0x02, 0x01, 0, 0, 0, 0, 0, 0]
    assert fixed32(out, at: 0).must().value == 4294967295
    assert fixed64(out, at: 4).must() == Number(value: 258, next: 12)
    assert fixed32(out, at: 9).is_err() && fixed64(out, at: 5).is_err()

test "tag: a number and a wire type, wire types 6 and 7, number 0, and past 2 to the 29th"
    assert tag([0x08], at: 0).must() == Tag(number: 1, wire: 0, next: 1)
    assert tag([0xfa, 0xff, 0xff, 0xff, 0x0f], at: 0).must().number == MAX_NUMBER
    assert tag([0x0e], at: 0).is_err() && tag([0x0f], at: 0).is_err() && tag([0x00], at: 0).is_err()
    assert tag([0x80, 0x80, 0x80, 0x80, 0x10], at: 0).is_err()

test "skip: each wire type, nested groups, a group not ended, and an end with no start"
    assert skip([0x96, 0x01, 0x00], number: 1, wire: VARINT, at: 0, max_depth: 100).must() == 2
    assert skip([0x02, 0x61, 0x62], number: 1, wire: BYTES, at: 0, max_depth: 100).must() == 3
    assert skip([0x02, 0x61], number: 1, wire: BYTES, at: 0, max_depth: 100).is_err()
    group: [u8] = [0x13, 0x08, 0x01, 0x14, 0x0c, 0x00]
    assert skip(group, number: 1, wire: START_GROUP, at: 0, max_depth: 100).must() == 5
    assert skip(group, number: 1, wire: START_GROUP, at: 0, max_depth: 1).is_err()
    assert skip([0x08, 0x01], number: 1, wire: START_GROUP, at: 0, max_depth: 100).is_err()
    assert skip([0x14], number: 1, wire: START_GROUP, at: 0, max_depth: 100).is_err()
    assert skip([], number: 1, wire: END_GROUP, at: 0, max_depth: 100).is_err()

test "raw_fields: every wire type, a group's two marks, and a group left open"
    data: [u8] = [0x08, 0x96, 0x01, 0x11, 1, 0, 0, 0, 0, 0, 0, 0, 0x1a, 0x01, 0x61, 0x23, 0x2d, 2, 0, 0, 0, 0x24]
    fields = raw_fields(data, max_depth: 100).must()
    assert fields.len() == 6
    assert fields[0].value == 150 && fields[1].value == 1 && fields[2].data == [0x61]
    assert fields[3].wire == START_GROUP && fields[4].number == 5 && fields[4].value == 2 && fields[5].wire == END_GROUP
    assert raw_fields([0x23], max_depth: 100).is_err() && raw_fields([0x24], max_depth: 100).is_err()
