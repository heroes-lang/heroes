# The bits of numbers as the wire holds them: an `i64` and a `u64` read as the
# same 64 bits in two's complement, and the low 32 bits of a varint. A float's
# and a double's IEEE 754 bits are `math`'s (`math.f32_to_bits`,
# `math.f64_to_bits` and back), `numbers`' from 2026-11-18 to 2026-11-20.

# 2^63, the sign bit of a `u64` read as an `i64`.
constant SIGN_64: u64
    9223372036854775808

# 2^32.
constant SPAN_32: u64
    4294967296

# The 64 bits of `n`, read as a `u64`.
function u64_of(n: i64) -> u64
    if n >= 0
        return to_u64(n).must()
    return to_u64(n + 9223372036854775807 + 1).must() + SIGN_64

# The 64 bits of `v`, read as an `i64`.
function i64_of(v: u64) -> i64
    if v < SIGN_64
        return to_i64(v).must()
    return to_i64(v - SIGN_64).must() - 9223372036854775807 - 1

# The low 32 bits of `v`, read as an `i32`, as a varint holds an `int32`.
function i32_of(v: u64) -> i32
    low = v % SPAN_32

    if low < 2147483648
        return to_i32(low).must()
    return to_i32(to_i64(low).must() - 4294967296).must()

# The low 32 bits of `v`.
function u32_of(v: u64) -> u32
    return to_u32(v % SPAN_32).must()

# `n` as the varint an `int32` or an `int64` writes: a negative one takes all
# 64 bits.
function varint_of(n: i64) -> u64
    return u64_of(n)

# `n` in zig-zag form.
function zigzag(n: i64) -> u64
    return u64_of(n << 1 ^ n >> 63)

# The number whose zig-zag form is `v`.
function unzigzag(v: u64) -> i64
    half = i64_of(v / 2)

    if v % 2 == 0
        return half
    return -1 - half

test "u64_of and i64_of: zero, one, minus one, and both ends of an i64"
    assert u64_of(0) == 0 && u64_of(-1) == 18446744073709551615
    assert u64_of(-9223372036854775808) == 9223372036854775808
    assert i64_of(18446744073709551615) == -1 && i64_of(9223372036854775807) == 9223372036854775807
    assert i64_of(9223372036854775808) == -9223372036854775808

test "i32_of and u32_of: the low 32 bits, read signed and unsigned"
    assert i32_of(4294967295) == -1 && i32_of(18446744071562067968) == -2147483648
    assert u32_of(18446744073709551615) == 4294967295 && i32_of(2147483647) == 2147483647

test "zigzag and unzigzag: as Go's protowire answers, both ends included"
    assert zigzag(0) == 0 && zigzag(-1) == 1 && zigzag(1) == 2 && zigzag(-2) == 3
    assert zigzag(9223372036854775807) == 18446744073709551614
    assert zigzag(-9223372036854775808) == 18446744073709551615
    assert unzigzag(18446744073709551615) == -9223372036854775808 && unzigzag(3) == -2
