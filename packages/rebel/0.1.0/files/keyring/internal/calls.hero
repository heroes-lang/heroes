# The work of `keyring`: each function of the face asked of the floor
# `keyring/hero_keyring`, the names checked first (`keyring/internal/names`),
# a buffer grown until what C fills fits, and a kind of the layer turned into
# a code (`keyring/internal/failure`). Every loop here counts its rounds and
# stops at four: a secret or a list that grows each time it is read is told,
# never read for ever.

use bytes
use keyring
use keyring/hero_keyring
use keyring/internal/failure
use keyring/internal/names

# The rounds a read takes at most, each with room for what the last one
# answered.
constant ROUNDS: i64
    4

# The bytes the names of the stores take at most: "Windows Credential
# Manager" is the longest, at 26.
constant SYSTEM_ROOM: i64
    64

# The bytes a listing of accounts is first given room for.
constant ACCOUNTS_ROOM: i64
    4096

# The name of the store this machine offers.
function system() -> str?
    asked = "asking this machine's keyring"
    buffer: [u8] @= []
    got = hero_keyring.system(@buffer, n: to_u64(SYSTEM_ROOM).must())

    if got < 0
        return failure.last(asked)

    if got > SYSTEM_ROOM
        return fail(code: keyring.FAILED, msg: f"{asked}: its name takes {got} bytes, past the {SYSTEM_ROOM} given")
    return bytes.to_text(buffer.slice(from: 0, to: got))

# `secret` stored under `service` and `account`.
function store(service: str, account: str, secret: [u8]) -> ()?
    asked = f"storing the secret of \"{account}\" under \"{service}\""
    names.checked(service: service, account: account, asked: asked)?
    names.checked_secret(secret: secret, asked: asked)?
    held @= secret

    if hero_keyring.store(service: service, account: account, @held, n: to_u64(held.len()).must()) < 0
        return failure.last(asked)
    return ok()

# The secret under `service` and `account`, read with room for
# `keyring.MAX_SECRET_BYTES` bytes first and, where another program stored a
# longer one, again with room for it.
function read(service: str, account: str) -> [u8]?
    asked = f"reading the secret of \"{account}\" under \"{service}\""
    names.checked(service: service, account: account, asked: asked)?
    room: i64 @= keyring.MAX_SECRET_BYTES
    round: i64 @= 0

    while round < ROUNDS
        buffer: [u8] @= []
        got = hero_keyring.read(service: service, account: account, @buffer, n: to_u64(room).must())

        if got < 0
            return failure.last(asked)

        if got <= room
            return ok(buffer.slice(from: 0, to: got))
        room @ got
        round @ round + 1

    return fail(code: keyring.FAILED, msg: f"{asked}: the secret grew each of the {ROUNDS} times it was read")

# The secret under `service` and `account` removed.
function remove(service: str, account: str) -> ()?
    asked = f"removing the secret of \"{account}\" under \"{service}\""
    names.checked(service: service, account: account, asked: asked)?

    if hero_keyring.remove(service: service, account: account) < 0
        return failure.last(asked)
    return ok()

# Every secret under `service` removed.
function remove_all(service: str) -> ()?
    asked = f"removing every secret under \"{service}\""
    names.checked_service(service: service, asked: asked)?

    if hero_keyring.remove_all(service) < 0
        return failure.last(asked)
    return ok()

# The accounts that hold a secret under `service`, ordered by their bytes,
# each once.
function accounts(service: str) -> [str]?
    asked = f"listing the accounts under \"{service}\""
    names.checked_service(service: service, asked: asked)?
    room: i64 @= ACCOUNTS_ROOM
    round: i64 @= 0

    while round < ROUNDS
        buffer: [u8] @= []
        got = hero_keyring.accounts(service, @buffer, n: to_u64(room).must())

        if got < 0
            return failure.last(asked)

        if got <= room
            return listed(buffer.slice(from: 0, to: got))
        room @ got
        round @ round + 1

    return fail(code: keyring.FAILED, msg: f"{asked}: the list grew each of the {ROUNDS} times it was read")

# The accounts a listing of the layer holds, each one's UTF-8 ended by a zero
# byte, ordered by their bytes and each once: a keychain that searches two
# keychains may give one account twice.
function listed(filled: [u8]) -> [str]?
    pieces = bytes.split(s: filled, sep: [0])
    found: [str] @= []

    # The last piece is what follows the last zero, always empty.
    for at in range(from: 0, to: pieces.len() - 1)
        found @ found.push(bytes.to_text(pieces[at])?)

    ordered = sort(found)
    once: [str] @= []

    for name in ordered
        if once.len() == 0 || once[once.len() - 1] != name
            once @ once.push(name)

    return ok(once)

test "listed: none, one empty account, two out of order, one twice, and a name of more than one byte"
    none: [u8] = []
    assert listed(none).must().len() == 0
    assert listed([0]).must() == [""]
    assert listed([98, 0, 97, 0]).must() == ["a", "b"]
    assert listed([97, 0, 97, 0, 98, 0]).must() == ["a", "b"]
    assert listed([195, 169, 0, 122, 0]).must() == ["z", "é"]

test "read, store, remove, remove_all, accounts: a name the layer cannot take is invalid before C is asked"
    secret: [u8] = [1]

    match store(service: "", account: "a", secret: secret)
        .ok _ => assert false
        .err e =>
            assert e.code == keyring.INVALID
            assert e.msg == "storing the secret of \"a\" under \"\": the service is empty, and a service names the program's secrets"

    assert read(service: "s", account: bytes.to_text([0]).must()).is_err()
    assert remove(service: bytes.to_text([97, 0]).must(), account: "a").is_err()
    assert remove_all("").is_err()
    assert accounts("").is_err()
