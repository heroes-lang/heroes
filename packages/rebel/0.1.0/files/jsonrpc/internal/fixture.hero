# What this package's tests and examples share, and nothing else calls: a
# server run on a thread of its own while the test's thread is the client,
# which answers one HTTP request with a body written ahead and gives back
# what it read; and the methods of the specification's examples with the
# handler a server of no state writes for them, over the face's types.

use bytes
use http
use io
use json
use jsonrpc
use net
use numbers
use strings
use threads

# What parts the pieces of a thread's argument and of its answer.
constant SEPARATOR: str
    "\u{1e}"

# A server running on a thread of its own, and the port it listens on.
record Started
    # The port the server listens on, which the system chose.
    port: i64
    # The server's thread, whose answer `threads.wait_text` gives: the body it
    # read, then its `Content-Type`, then its `Accept`.
    thread: threads.TextThread

# `serve_once` started on a thread of its own, to answer `status` and `body`:
# the server listens on a port the system chooses and tells it back over a
# connection to a listener of this thread, so no port is assumed free.
function start(status: i64, body: str) -> Started
    control @= net.listen(host: "127.0.0.1", port: 0).must()
    t = threads.spawn_text(body: serve_once, arg: [f"{control.address.port}", f"{status}", body].join(SEPARATOR)).must()
    told = net.accept(control, deadline_ms: 10_000).must()
    r @= io.reader(told.stream)
    port = numbers.parse_int(io.read_rest_text(@r).must()).must()
    io.close(@r.stream).must()
    net.close_listener(@control).must()
    return Started(port: port, thread: t)

# The body of `start`'s thread: it tells its port, answers one request, and
# gives back what it read.
function serve_once(arg: str) -> str
    parts = strings.split(s: arg, sep: SEPARATOR)
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    told @= net.connect("127.0.0.1", port: numbers.parse_int(parts[0]).must(), deadline_ms: 10_000).must()
    io.write_text(told.stream, text: f"{l.address.port}").must()
    io.close(@told.stream).must()
    conn = net.accept(l, deadline_ms: 10_000).must()
    reader @= io.reader(conn.stream)
    r = http.next_request(@reader, limits: http.default_limits()).must()
    response = http.respond(
        status: numbers.parse_int(parts[1]).must(),
        content_type: "application/json",
        body: bytes.from_text(parts[2])
    )
    http.write_answer(reader.stream, r: r, response: response).must()
    io.close(@reader.stream).must()
    net.close_listener(@l).must()
    return [bytes.to_text_lossy(r.body), http.value_of(r.headers, name: "Content-Type").default(""), http.value_of(r.headers, name: "Accept").default("")].join(
        SEPARATOR
    )

# The error codes of each answer `text` holds, one answer or a batch, 0 for a
# result: what a test compares where the data's words are not its point.
function codes_of(text: str) -> [i64]
    out: [i64] @= []
    value = json.parse(text).must()

    answers = match value
        .list l                                                    => l.items
        .null_value | .boolean _ | .number _ | .text _ | .object _ => [value]

    for answer in answers
        match json.value_at(answer, pointer: "/error/code")
            .ok code => out @ out.push(json.int_of(code).must())
            .err _   => out @ out.push(0)

    return out

# FOR TESTS AND EXAMPLES of the face: the methods of the specification's
# examples, § 7: `subtract` by position
# and by name, `sum` of up to three, `get_data`, and the notifications
# `update` and `notify_hello`; `foobar` and `foo.get` are not there.
function spec_methods() -> jsonrpc.Methods
    m @= jsonrpc.new_methods()
    jsonrpc.add_method(@m, name: "subtract", params: ["minuend", "subtrahend"], required: 2).must()
    jsonrpc.add_method(@m, name: "sum", params: ["a", "b", "c"], required: 0).must()
    jsonrpc.add_method(@m, name: "get_data", params: [], required: 0).must()
    jsonrpc.add_method(@m, name: "update", params: ["a", "b", "c", "d", "e"], required: 0).must()
    jsonrpc.add_method(@m, name: "notify_hello", params: ["n"], required: 1).must()
    return m

# The handler of `spec_methods`, as a server with no state writes it.
#
# - `found`: the method found and its parameters by name.
#
# Fails `invalid` where a parameter of `subtract` or `sum` is not a number.
function spec_handler(found: jsonrpc.Found) -> json.Value?
    if found.method == "subtract"
        a = json.number_of(jsonrpc.param_of(found, name: "minuend")?)?
        b = json.number_of(jsonrpc.param_of(found, name: "subtrahend")?)?
        return ok(.number(v: a - b))

    if found.method == "sum"
        total: f64 @= 0.0

        for name in keys(found.params)
            total @ total + json.number_of(found.params[name].must())?

        return ok(.number(v: total))

    if found.method == "get_data"
        return ok(json.parse("[\"hello\", 5]").must())
    return ok(.null_value)

# The answer of a server with no state to an HTTP request, as `http.exchange`
# hands it: the body read, dispatched to `spec_handler`, and answered.
#
# - `r`: the request.
function spec_over_http(r: http.Request) -> http.Response
    received = match jsonrpc.read_http(r, limits: jsonrpc.default_limits())
        .ok got => got
        .err e  => return jsonrpc.refusal_http(code: e.code, msg: e.msg)

    answers: [jsonrpc.Message] @= []

    for item in received.messages
        match item
            .err e => answers @ answers.push(jsonrpc.answer_invalid_request(e.msg))
            .ok m =>
                match m
                    .request q =>
                        answer = match jsonrpc.method_of(spec_methods(), method: q.method, params: q.params)
                            .ok found => jsonrpc.answer_outcome(q.id, outcome: spec_handler(found))
                            .err e    => jsonrpc.answer_refusal(q.id, code: e.code, msg: e.msg)

                        answers @ answers.push(answer)
                    .notification _ | .response _ => _ = 0

    return jsonrpc.respond_http(answers, batch: received.batch).must()
