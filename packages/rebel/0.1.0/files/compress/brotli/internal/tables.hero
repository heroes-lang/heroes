# The 121 transforms of Brotli, RFC 7932 Appendix B, and the context
# tables of section 7.1, written as the appendix's own serialization (each
# transform its prefix, a zero, its kind, its suffix, a zero) and as bytes,
# all in hexadecimal. The tables are data, made and not typed: a one-off
# program read the RFC's text (fetched 2026-11-18), held them to the
# lengths and CRC-32s the RFC gives (0x3d965f81; 0x8e91efb7, 0xd01a32f4,
# 0x0dd7a0d6), and wrote this module whole. Nothing here is edited by hand.

# The 121 transforms, serialized as the appendix says: 648 bytes.
constant TRANSFORMS: str
    ""

# Lut0 of section 7.1, by the byte before: what UTF8 context takes of it.
constant LUT0: str
    ""

# Lut1 of section 7.1, by the byte before that: what UTF8 context takes of it.
constant LUT1: str
    ""

# Lut2 of section 7.1: the class of a byte in signed context.
constant LUT2: str
    ""
