# Brotli's bits and prefix codes, read: numbers of up to 24 bits taken
# lowest first, as DEFLATE packs them, and a prefix code described simply
# (one to four symbols) or by its code lengths, themselves coded with a code
# of their own and runs of zeros and of the length before. A code must be
# complete; a code of one symbol takes no bit.

use compress/internal/codes
use compress/internal/cursor
use compress/internal/huffman

# A prefix code as the decoder reads it.
record Code
    # The table that reads a code of two symbols or more.
    table: huffman.Table
    # The one symbol of a code that has one, which takes no bit; -1
    # otherwise.
    single: i64

# The order in which a complex code's code length code lengths come.
constant ORDER: [i64]
    [1, 2, 3, 4, 0, 5, 17, 6, 16, 7, 8, 9, 10, 11, 12, 13, 14, 15]

# The next `n` bits, 0 to 24, the first lowest. Fails where the input ends.
function bits(@c: cursor.Cursor, input: [u8] lent, n: i64) -> i64?
    if n > 16
        low = bits(@c, input: input, n: 16)?
        high = bits(@c, input: input, n: n - 16)?
        return ok(low | high << 16)

    if !cursor.fill(@c, input, n: n)
        return codes.invalid_at(at: input.len(), why: "a Brotli stream cut short")
    return ok(cursor.take(@c, n: n))

# The next symbol of `code`.
function symbol(code: Code lent, @c: cursor.Cursor, input: [u8] lent) -> i64?
    if code.single >= 0
        return ok(code.single)
    s = huffman.decode(code.table, @c, input)

    if s == huffman.STARVED
        return codes.invalid_at(at: input.len(), why: "a Brotli stream cut short inside a code")

    if s == huffman.NO_CODE
        return codes.invalid_at(at: cursor.last_byte(c), why: "bits that are no code of a Brotli prefix code")
    return ok(s)

# How many bits a symbol of an alphabet of `size` takes in a simple code.
function alphabet_bits(size: i64) -> i64
    n: i64 @= 0

    while 1 << n < size
        n @ n + 1

    return n

# A table that reads no code: what a code of one symbol holds beside it.
function empty_table() -> huffman.Table
    nothing: [i64] = []
    return huffman.table_for(nothing).must()

# `n` zeros.
function zeros(n: i64) -> [i64]
    out: [i64] @= []

    for _ in range(from: 0, to: n)
        out @ out.push(0)

    return out

# A code length code length: 0 to 5, in two to four bits.
function length_length(@c: cursor.Cursor, input: [u8] lent) -> i64?
    two = bits(@c, input: input, n: 2)?

    if two == 0
        return ok(0)

    if two == 1
        return ok(4)

    if two == 2
        return ok(3)

    if bits(@c, input: input, n: 1)? == 0
        return ok(2)

    if bits(@c, input: input, n: 1)? == 0
        return ok(1)
    return ok(5)

# The prefix code over an alphabet of `size` symbols that comes next.
function read(@c: cursor.Cursor, input: [u8] lent, size: i64) -> Code?
    at = cursor.last_byte(c)
    skip = bits(@c, input: input, n: 2)?

    if skip == 1
        return simple(@c, input: input, size: size)
    lengths_of_lengths @= zeros(18)
    space: i64 @= 32
    used: i64 @= 0

    for i in range(from: skip, to: 18)
        v = length_length(@c, input: input)?
        lengths_of_lengths[ORDER[i]] @ v

        if v != 0
            space @ space - (32 >> v)
            used @ used + 1

            if space <= 0
                break

    if used != 1 && space != 0
        return codes.invalid_at(at: at, why: "a code length code that is not complete")
    inner: Code @= Code(table: empty_table(), single: -1)

    if used == 1
        for s in range(from: 0, to: 18)
            if lengths_of_lengths[s] != 0
                inner.single @ s
    else
        inner.table @ huffman.table_for(lengths_of_lengths)?
    lengths @= zeros(size)
    previous: i64 @= 8
    repeat_count: i64 @= 0
    repeat_length: i64 @= 0
    room: i64 @= 32768
    s: i64 @= 0

    while s < size && room > 0
        code = symbol(inner, @c, input: input)?

        if code < 16
            repeat_count @ 0
            lengths[s] @ code
            s @ s + 1

            if code != 0
                previous @ code
                room @ room - (32768 >> code)
            continue
        extra: i64 @= 3
        length: i64 @= 0

        if code == 16
            extra @ 2
            length @ previous

        if repeat_length != length
            repeat_count @ 0
            repeat_length @ length
        before = repeat_count

        if repeat_count > 0
            repeat_count @ repeat_count - 2 << extra
        repeat_count @ repeat_count + bits(@c, input: input, n: extra)? + 3
        delta = repeat_count - before

        if s + delta > size
            return codes.invalid_at(at: at, why: "a prefix code whose lengths run past its alphabet")

        for _ in range(from: 0, to: delta)
            lengths[s] @ length
            s @ s + 1

        if length != 0
            room @ room - (delta << 15 - length)

    if room != 0
        return codes.invalid_at(at: at, why: "a prefix code that is not complete")
    return ok(Code(table: huffman.table_for(lengths)?, single: -1))

# A simple prefix code: one to four symbols, their lengths implied.
function simple(@c: cursor.Cursor, input: [u8] lent, size: i64) -> Code?
    at = cursor.last_byte(c)
    count = bits(@c, input: input, n: 2)? + 1
    width = alphabet_bits(size)
    symbols: [i64] @= []

    for _ in range(from: 0, to: count)
        s = bits(@c, input: input, n: width)?

        if s >= size
            return codes.invalid_at(at: at, why: f"a symbol of {s} in an alphabet of {size}")

        for t in symbols
            if t == s
                return codes.invalid_at(at: at, why: "a simple prefix code naming one symbol twice")

        symbols @ symbols.push(s)

    if count == 1
        return ok(Code(table: empty_table(), single: symbols[0]))
    lengths @= zeros(size)

    if count == 2
        lengths[symbols[0]] @ 1
        lengths[symbols[1]] @ 1
    else if count == 3
        lengths[symbols[0]] @ 1
        lengths[symbols[1]] @ 2
        lengths[symbols[2]] @ 2
    else if bits(@c, input: input, n: 1)? == 0
        for s in symbols
            lengths[s] @ 2
    else
        lengths[symbols[0]] @ 1
        lengths[symbols[1]] @ 2
        lengths[symbols[2]] @ 3
        lengths[symbols[3]] @ 3
    return ok(Code(table: huffman.table_for(lengths)?, single: -1))

test "read: a simple code of one symbol takes no bit; of two, one bit each"
    c @= cursor.start()

    # HSKIP 1, NSYM-1 0, the symbol 5 in 8 bits: 01 00 00000101 lowest first.
    one = read(@c, input: [0x51, 0x00], size: 256).must()
    assert one.single == 5
    assert symbol(one, @c, input: [0x51, 0x00]).must() == 5

test "read: an alphabet's symbol past its size, and a code cut short"
    c @= cursor.start()

    # HSKIP 1, NSYM-1 0, symbol 30 of an alphabet of 26 in 5 bits: 1110 0001, then 1.
    match read(@c, input: [0xe1, 0x01], size: 26)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    d @= cursor.start()

    match read(@d, input: [], size: 256)
        .ok _  => assert false
        .err e => assert e.code == "invalid"
