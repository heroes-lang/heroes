# XXH64, the hash a Zstandard frame's checksum is the low 32 bits of, over
# 64-bit words held as the bits of an `i64`. The language wraps nothing, so
# the sum and the product modulo 2^64 are made of 32-bit and 16-bit pieces
# that cannot overflow, and a shift right that brings in zeros masks what
# `>>` copies of the sign.

# The five primes of XXH64, as the bits of an `i64`.
constant P1: i64
    0x9e3779b1 << 32 | 0x85ebca87

# The second prime.
constant P2: i64
    0xc2b2ae3d << 32 | 0x27d4eb4f

# The third prime.
constant P3: i64
    0x165667b1 << 32 | 0x9e3779f9

# The fourth prime.
constant P4: i64
    0x85ebca77 << 32 | 0xc2b2ae63

# The fifth prime.
constant P5: i64
    0x27d4eb2f << 32 | 0x165667c5

# `a` + `b` modulo 2^64.
function add(a: i64, b: i64) -> i64
    low = (a & 0xffffffff) + (b & 0xffffffff)
    high = (a >> 32 & 0xffffffff) + (b >> 32 & 0xffffffff) + (low >> 32)
    return (high & 0xffffffff) << 32 | low & 0xffffffff

# `a` × `b` modulo 2^64, from four 16-bit pieces of each.
function mul(a: i64, b: i64) -> i64
    a0 = a & 0xffff
    a1 = a >> 16 & 0xffff
    a2 = a >> 32 & 0xffff
    a3 = a >> 48 & 0xffff
    b0 = b & 0xffff
    b1 = b >> 16 & 0xffff
    b2 = b >> 32 & 0xffff
    b3 = b >> 48 & 0xffff
    r0 = a0 * b0
    r1 = a1 * b0 + a0 * b1 + (r0 >> 16)
    r2 = a2 * b0 + a1 * b1 + a0 * b2 + (r1 >> 16)
    r3 = a3 * b0 + a2 * b1 + a1 * b2 + a0 * b3 + (r2 >> 16)
    return (r3 & 0xffff) << 48 | (r2 & 0xffff) << 32 | (r1 & 0xffff) << 16 | r0 & 0xffff

# `x` shifted right by `n`, 1 to 63, zeros brought in.
function shr(x: i64, n: i64) -> i64
    return x >> n & (1 << 64 - n) - 1

# `x` rotated left by `n`, 1 to 63.
function rotl(x: i64, n: i64) -> i64
    return x << n | shr(x: x, n: 64 - n)

# The 8 bytes at `at` of `data`, the lowest first.
function lane(data: [u8] lent, at: i64) -> i64
    value: i64 @= 0
    k: i64 @= 7

    while k >= 0
        value @ value << 8 | to_i64(data[at + k]).must()
        k @ k - 1

    return value

# One round of a lane into an accumulator.
function round(acc: i64, input: i64) -> i64
    return mul(a: rotl(x: add(a: acc, b: mul(a: input, b: P2)), n: 31), b: P1)

# An accumulator merged into the hash.
function merge(hash: i64, acc: i64) -> i64
    return add(a: mul(a: hash ^ round(acc: 0, input: acc), b: P1), b: P4)

# The XXH64 of `data` from `from` to `to`, seed 0, as the bits of an `i64`.
function digest(data: [u8] lent, from: i64, to: i64) -> i64
    n = to - from
    p: i64 @= from
    h: i64 @= 0

    if n >= 32
        v1: i64 @= add(a: P1, b: P2)
        v2: i64 @= P2
        v3: i64 @= 0
        v4: i64 @= add(a: ~P1, b: 1)

        while p + 32 <= to
            v1 @ round(acc: v1, input: lane(data, at: p))
            v2 @ round(acc: v2, input: lane(data, at: p + 8))
            v3 @ round(acc: v3, input: lane(data, at: p + 16))
            v4 @ round(acc: v4, input: lane(data, at: p + 24))
            p @ p + 32

        h @ add(
            a: add(a: rotl(x: v1, n: 1), b: rotl(x: v2, n: 7)),
            b: add(a: rotl(x: v3, n: 12), b: rotl(x: v4, n: 18))
        )
        h @ merge(hash: h, acc: v1)
        h @ merge(hash: h, acc: v2)
        h @ merge(hash: h, acc: v3)
        h @ merge(hash: h, acc: v4)
    else
        h @ P5
    h @ add(a: h, b: n)

    while p + 8 <= to
        h @ add(a: mul(a: rotl(x: h ^ round(acc: 0, input: lane(data, at: p)), n: 27), b: P1), b: P4)
        p @ p + 8

    if p + 4 <= to
        word = to_i64(data[p]).must() | to_i64(data[p + 1]).must() << 8 | to_i64(data[p + 2]).must() << 16 | to_i64(data[p + 3]).must() << 24
        h @ add(a: mul(a: rotl(x: h ^ mul(a: word, b: P1), n: 23), b: P2), b: P3)
        p @ p + 4

    while p < to
        h @ mul(a: rotl(x: h ^ mul(a: to_i64(data[p]).must(), b: P5), n: 11), b: P1)
        p @ p + 1

    h @ h ^ shr(x: h, n: 33)
    h @ mul(a: h, b: P2)
    h @ h ^ shr(x: h, n: 29)
    h @ mul(a: h, b: P3)
    return h ^ shr(x: h, n: 32)

# The low 32 bits of the XXH64 of `data` from `from` to `to`: a frame's
# checksum.
function checksum(data: [u8] lent, from: i64, to: i64) -> i64
    return digest(data, from: from, to: to) & 0xffffffff

test "digest: nothing, and the sum and product that wrap"
    assert digest([], from: 0, to: 0) == 0xef46db37 << 32 | 0x51d8e999
    assert add(a: -1, b: 1) == 0
    assert mul(a: -1, b: -1) == 1
    assert mul(a: 1 << 32, b: 1 << 32) == 0
    assert shr(x: -1, n: 60) == 15
    assert rotl(x: 1 << 63, n: 1) == 1
