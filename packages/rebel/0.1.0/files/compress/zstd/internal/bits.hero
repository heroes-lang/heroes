# The bitstreams of Zstandard. A table's description is read forward, the
# first bit lowest. FSE and Huffman streams are read backward, from the
# highest bit of their last byte, which a 1 marks, down to their first bit,
# each number read highest bit first; a reader that runs past the first bit
# reads zeros and says it overflowed. The writer makes such a stream: what
# it puts first is read last.

use compress/internal/codes

# A backward stream inside an input.
record Back
    # The index of the stream's first byte in the input.
    start: i64
    # How many bits are left to read; below 0 once it overflowed.
    pos: i64

# The backward stream of `input` from `from` to `to`, its last byte marked.
function back(input: [u8] lent, from: i64, to: i64) -> Back?
    if to <= from
        return codes.invalid_at(at: from, why: "an empty Zstandard bitstream")
    last = to_i64(input[to - 1]).must()

    if last == 0
        return codes.invalid_at(at: to - 1, why: "a Zstandard bitstream whose last byte has no end mark")
    high: i64 @= 7

    while last >> high & 1 == 0
        high @ high - 1

    return ok(Back(start: from, pos: (to - 1 - from) * 8 + high))

# The bits of `b`'s stream from `lo` to `hi`, the first lowest; the bits
# below the stream are zeros. `hi` - `lo` is 0 to 32.
function span(b: Back lent, input: [u8] lent, lo: i64, hi: i64) -> i64
    if hi <= 0 || hi <= lo
        return 0
    from: i64 @= lo

    if from < 0
        from @ 0
    acc: i64 @= 0
    k: i64 @= hi - 1 >> 3
    first = from >> 3

    while k >= first
        acc @ acc << 8 | to_i64(input[b.start + k]).must()
        k @ k - 1

    value = acc >> from - first * 8 & (1 << hi - from) - 1
    return value << from - lo

# The next `n` bits of `b`, 0 to 32, read backward.
function read(@b: Back, input: [u8] lent, n: i64) -> i64
    value = span(b, input: input, lo: b.pos - n, hi: b.pos)
    b.pos @ b.pos - n
    return value

# The next `n` bits of `b` without moving it.
function peek(b: Back lent, input: [u8] lent, n: i64) -> i64
    return span(b, input: input, lo: b.pos - n, hi: b.pos)

# A forward stream inside an input: the bit index from its first byte.
record Ahead
    # The index of the stream's first byte in the input.
    start: i64
    # The bits read so far.
    pos: i64
    # The index past the last byte it may read.
    end: i64

# The next `n` bits of `a`, 0 to 24, the first lowest. Fails where `a`
# would pass its end.
function take(@a: Ahead, input: [u8] lent, n: i64) -> i64?
    hi = a.pos + n

    if a.start + (hi + 7 >> 3) > a.end
        return codes.invalid_at(at: a.end, why: "a Zstandard table description cut short")
    acc: i64 @= 0
    k: i64 @= hi - 1 >> 3
    first = a.pos >> 3

    while k >= first
        acc @ acc << 8 | to_i64(input[a.start + k]).must()
        k @ k - 1

    value = acc >> a.pos - first * 8 & (1 << n) - 1
    a.pos @ hi
    return ok(value)

# The next `n` bits of `a` without moving it, those past its end zeros.
function look(a: Ahead lent, input: [u8] lent, n: i64) -> i64
    acc: i64 @= 0
    k: i64 @= a.pos + n - 1 >> 3
    first = a.pos >> 3

    while k >= first
        byte: i64 @= 0

        if a.start + k < a.end
            byte @ to_i64(input[a.start + k]).must()
        acc @ acc << 8 | byte
        k @ k - 1

    return acc >> a.pos - first * 8 & (1 << n) - 1

# The bits written and not yet whole bytes, the first lowest.
record Writer
    # The pending bits.
    held: i64
    # How many there are: 0 to 7 between calls.
    count: i64

# A writer holding nothing.
function writer() -> Writer
    return Writer(held: 0, count: 0)

# Writes the `n` low bits of `value`, 0 to 32, after those before.
function put(@out: [u8], @w: Writer, value: i64, n: i64)
    w.held @ w.held | (value & (1 << n) - 1) << w.count
    w.count @ w.count + n

    while w.count >= 8
        out @ out.push(to_u8(w.held & 255).must())
        w.held @ w.held >> 8
        w.count @ w.count - 8

# Ends a backward stream: its mark, a 1, then zeros to a whole byte.
function close(@out: [u8], @w: Writer)
    put(@out, @w, value: 1, n: 1)

    if w.count > 0
        put(@out, @w, value: 0, n: 8 - w.count)

test "back and read: a stream written, then read from its end"
    out: [u8] @= []
    w @= writer()
    put(@out, @w, value: 5, n: 3)
    put(@out, @w, value: 0x1abcd, n: 17)
    put(@out, @w, value: 2, n: 2)
    close(@out, @w)
    b @= back(out, from: 0, to: out.len()).must()
    assert read(@b, input: out, n: 2) == 2
    assert read(@b, input: out, n: 17) == 0x1abcd
    assert read(@b, input: out, n: 3) == 5
    assert b.pos == 0
    assert read(@b, input: out, n: 4) == 0
    assert b.pos == -4

test "back: an empty stream and a last byte of zero"
    match back([1, 0], from: 0, to: 2)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    match back([1, 0], from: 1, to: 1)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

test "take and look: forward bits across bytes, and an end"
    data: [u8] = [0xb4, 0x01]
    a @= Ahead(start: 0, pos: 0, end: 2)
    assert look(a, input: data, n: 4) == 4
    assert take(@a, input: data, n: 4).must() == 4
    assert take(@a, input: data, n: 5).must() == 0x1b
    assert take(@a, input: data, n: 7).must() == 0

    match take(@a, input: data, n: 1)
        .ok _  => assert false
        .err e => assert e.code == "invalid"
