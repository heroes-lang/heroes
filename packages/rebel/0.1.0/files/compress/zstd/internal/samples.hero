# Frames to test with, made by the `zstd` tool 1.5.7 on this machine
# (2026-11-18) and written as hexadecimal text; Python's `compression.zstd`
# (3.15) reads each the same. Made by hand at a shell; no program calls it.

use bytes

# The text `SHORT` holds, with characters of two bytes at its end.
constant SHORT_TEXT: str
    "ziggy played guitar, jamming good with weird and gilly, and the spiders from mars; été"

# The document `WITH_DICTIONARY` holds.
constant DICTIONARY_TEXT: str
    "{\"name\": \"ground\", \"id\": 5, \"tags\": [\"jamming\", \"heroes\"], \"text\": \"ziggy stardust jamming heroes jamming mars spiders ziggy stardust stardust space weird tom ground ziggy major ground spiders oddity heroes\"}"

# `zstd -19` of the 88 bytes of `SHORT_TEXT`: Huffman literals and a checksum.
constant SHORT: str
    "28b52ffd24586d020032051114c0ebfffabf6769d9edb26b25a52dfed77ae8ba277236391fd8d2f393d6385b625bb10bd20034a6f98bf4bb5abc93d6ef9b129f519fa3e560696bc75f01d5a843e68e01010067a1400196a59416"

# `zstd -19 --no-content-size` of `SHORT_TEXT`: a header that says no size.
constant SHORT_STREAM: str
    "28b52ffd04686d020032051114c0ebfffabf6769d9edb26b25a52dfed77ae8ba277236391fd8d2f393d6385b625bb10bd20034a6f98bf4bb5abc93d6ef9b129f519fa3e560696bc75f01d5a843e68e01010067a1400196a59416"

# `zstd -19` of 1,200 bytes of every value, most of them small: Huffman weights compressed with FSE, four streams, and a checksum that guards the bytes.
constant SKEW: str
    ""

# `zstd -1` of 300 zero bytes.
constant ZEROS: str
    "28b52ffd642c004d00001000000100272ac00290ea003a"

# A dictionary of 1,024 bytes `zstd --train --maxdict=1024` made from 300 small JSON documents.
constant DICTIONARY: str
    ""

# `zstd -19 -D` with `DICTIONARY` of the 208 bytes of `DICTIONARY_TEXT`.
constant WITH_DICTIONARY: str
    "28b52ffd273b05ed00d0850100207b35727d14fc9a501a72979430362e533eccc0165ce8fd96d1c62a832f9ee5d00ee47195796968ac1630c1fcc2eb12db2029e0"

# The bytes of a sample's hexadecimal text.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()

# The bytes of a text.
function text(s: str) -> [u8]
    return bytes.from_text(s)

# `data` with byte `at` flipped by `mask`.
function flipped(data: [u8], at: i64, mask: u8) -> [u8]
    changed @= data
    changed[at] @ to_u8(to_i64(changed[at]).must() ^ to_i64(mask).must()).must()
    return changed

# `data` followed by `more`.
function followed(data: [u8], more: [u8]) -> [u8]
    joined @= data

    for b in more
        joined @ joined.push(b)

    return joined
