# What wraps DEFLATE data, written: zlib's header and preset dictionary id
# (RFC 1950) and gzip's header (RFC 1952), the codes of the three wrappings,
# gzip's flags, and the record of what a gzip header says. Their checksums
# are written by `deflater`; `wrap_read` reads all of it back.

use compress/internal/bitout
use compress/internal/codes
use compress/internal/latin
use hash

# DEFLATE with nothing around it.
constant RAW: i64
    0

# zlib's wrapping.
constant ZLIB: i64
    1

# gzip's wrapping.
constant GZIP: i64
    2

# The longest name or comment a gzip header read here may hold, in bytes:
# the bound of the extra field's own length. RFC 1952 sets none; Go refuses
# 512 bytes or more, Python none.
constant FIELD_MOST: i64
    65535

# gzip's flag: the data is probably text.
constant FLAG_TEXT: i64
    1

# gzip's flag: a CRC of the header follows it.
constant FLAG_HEADER_CRC: i64
    2

# gzip's flag: an extra field follows the fixed part.
constant FLAG_EXTRA: i64
    4

# gzip's flag: a name follows.
constant FLAG_NAME: i64
    8

# gzip's flag: a comment follows.
constant FLAG_COMMENT: i64
    16

# What a gzip header says, as the face's `Header` says it.
record Gzip
    # The file's name, "" for none.
    name: str
    # The comment, "" for none.
    comment: str
    # Seconds since 1970-01-01 UTC, 0 for none.
    modified: u32
    # The extra field, empty for none.
    extra: [u8]
    # The system it was made on.
    os: u8
    # Whether the data is probably text.
    is_text: bool

# A gzip header that says nothing: no name, no comment, no time, the system
# unknown (255).
function empty_gzip() -> Gzip
    return Gzip(name: "", comment: "", modified: 0, extra: [], os: 255, is_text: false)

# The two bytes of a zlib header, and the dictionary's id after them where
# `dictionary` is not empty. `level` 0 to 9 sets FLEVEL as RFC 1950 groups
# the levels: 0 and 1 the fastest, 2 to 5 fast, 6 the usual, 7 to 9 the most.
function zlib_header(level: i64, window_bits: i64, dictionary: [u8] lent) -> [u8]
    method = window_bits - 8 << 4 | 8
    group: i64 @= 3

    if level < 2
        group @ 0
    else if level < 6
        group @ 1
    else if level == 6
        group @ 2
    flags: i64 @= group << 6

    if dictionary.len() > 0
        flags @ flags | 32
    rest = (method * 256 + flags) % 31

    if rest != 0
        flags @ flags + 31 - rest
    out: [u8] @= [to_u8(method).must(), to_u8(flags).must()]

    if dictionary.len() > 0
        bitout.put_big(@out, value: to_i64(hash.adler32(dictionary)).must(), width: 4)
    return out

# The bytes of a gzip header for `g`, with the XFL byte RFC 1952 gives a
# `level` of 9 (2) or of 0 and 1 (4). Fails `invalid` where the name or the
# comment holds a character Latin-1 cannot write or U+0000, or the extra
# field passes 65,535 bytes.
function gzip_header(g: Gzip lent, level: i64) -> [u8]?
    name = latin.to_latin(s: g.name, what: "the gzip header's name")?
    comment = latin.to_latin(s: g.comment, what: "the gzip header's comment")?

    if g.extra.len() > 65535
        return fail(
            code: codes.INVALID,
            msg: f"the gzip header's extra field is {g.extra.len()} bytes, past the 65,535 it can hold"
        )
    flags: i64 @= 0

    if g.is_text
        flags @ flags | FLAG_TEXT

    if g.extra.len() > 0
        flags @ flags | FLAG_EXTRA

    if name.len() > 0
        flags @ flags | FLAG_NAME

    if comment.len() > 0
        flags @ flags | FLAG_COMMENT
    out: [u8] @= [0x1f, 0x8b, 8, to_u8(flags).must()]
    bitout.put_little(@out, value: to_i64(g.modified).must(), width: 4)
    xfl: u8 @= 0

    if level == 9
        xfl @ 2
    else if level < 2
        xfl @ 4
    out @ out.push(xfl)
    out @ out.push(g.os)

    if g.extra.len() > 0
        bitout.put_little(@out, value: g.extra.len(), width: 2)

        for b in g.extra
            out @ out.push(b)

    if name.len() > 0
        for b in name
            out @ out.push(b)

        out @ out.push(0)

    if comment.len() > 0
        for b in comment
            out @ out.push(b)

        out @ out.push(0)
    return ok(out)

test "zlib_header: Python's two bytes for each group of levels, and a window of 512"
    none: [u8] = []
    assert zlib_header(level: 0, window_bits: 15, dictionary: none) == [0x78, 0x01]
    assert zlib_header(level: 1, window_bits: 15, dictionary: none) == [0x78, 0x01]
    assert zlib_header(level: 2, window_bits: 15, dictionary: none) == [0x78, 0x5e]
    assert zlib_header(level: 5, window_bits: 15, dictionary: none) == [0x78, 0x5e]
    assert zlib_header(level: 6, window_bits: 15, dictionary: none) == [0x78, 0x9c]
    assert zlib_header(level: 9, window_bits: 15, dictionary: none) == [0x78, 0xda]
    assert zlib_header(level: 6, window_bits: 9, dictionary: none) == [0x18, 0x95]

test "gzip_header: Python's ten bytes at levels 6, 9 and 1"
    g = empty_gzip()
    assert gzip_header(g, level: 6).must() == [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 0xff]
    assert gzip_header(g, level: 9).must() == [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 2, 0xff]
    assert gzip_header(g, level: 1).must() == [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 4, 0xff]

test "gzip_header: a name past U+00FF, and an extra field too long"
    named = Gzip(name: "☃", comment: "", modified: 0, extra: [], os: 255, is_text: false)

    match gzip_header(named, level: 6)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    long: [u8] @= []

    for _ in range(from: 0, to: 65536)
        long @ long.push(0)

    wide = Gzip(name: "", comment: "", modified: 0, extra: long, os: 255, is_text: false)

    match gzip_header(wide, level: 6)
        .ok _  => assert false
        .err e => assert e.msg == "the gzip header's extra field is 65536 bytes, past the 65,535 it can hold"
