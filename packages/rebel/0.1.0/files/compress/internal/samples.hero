constant GZIP_NAMED: str
    ""

# How many bytes it decompresses to, as Python answers.
constant GZIP_NAMED_LEN: i64
    3001

# The CRC-32 of what it decompresses to, as Python's `zlib.crc32` answers.
constant GZIP_NAMED_CRC: i64
    13033868

# The text as two gzip members and four zero bytes of padding, by Python.
constant GZIP_MEMBERS: str
    ""

# How many bytes it decompresses to, as Python answers.
constant GZIP_MEMBERS_LEN: i64
    3001

# The CRC-32 of what it decompresses to, as Python's `zlib.crc32` answers.
constant GZIP_MEMBERS_CRC: i64
    13033868

# The text at zlib level 6 with the preset dictionary `DICTIONARY`, by Python.
constant ZLIB_DICT: str
    ""

# How many bytes it decompresses to, as Python answers.
constant ZLIB_DICT_LEN: i64
    3001

# The CRC-32 of what it decompresses to, as Python's `zlib.crc32` answers.
constant ZLIB_DICT_CRC: i64
    13033868

# The text at zlib level 6, a sync or full flush every 500 bytes, by Python.
constant ZLIB_FLUSHED: str
    ""

# How many bytes it decompresses to, as Python answers.
constant ZLIB_FLUSHED_LEN: i64
    3001

# The CRC-32 of what it decompresses to, as Python's `zlib.crc32` answers.
constant ZLIB_FLUSHED_CRC: i64
    13033868

# A million zero bytes at zlib level 9, by Python: a small input that expands a thousandfold.
constant ZLIB_ZEROS: str
    ""

# How many bytes it decompresses to, as Python answers.
constant ZLIB_ZEROS_LEN: i64
    1000000

# The CRC-32 of what it decompresses to, as Python's `zlib.crc32` answers.
constant ZLIB_ZEROS_CRC: i64
    309971870

# The bytes of the hexadecimal text `hex`, which is one.
function of(hex: str) -> [u8]
    # Every constant above is hexadecimal, written by the script.
    return bytes.parse_hex(hex).must()

# The bytes of `TEXT`.
function text() -> [u8]
    return bytes.from_text(TEXT)

# The bytes of the preset dictionary.
function dictionary() -> [u8]
    return text().slice(from: 0, to: DICTIONARY_LEN)
