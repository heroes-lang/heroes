# Frames and blocks to test with, made by the `lz4` tool 1.11.0 and by
# Python's `lz4` 4.4.5 on this machine (2026-11-19) and written as
# hexadecimal text; the tool and Python read each back to its text. Made by
# hand at a shell; no program calls it.

use bytes

# The text most samples hold, with a character of two bytes at its end.
constant SHORT_TEXT: str
    "ziggy played guitar, jamming good with weird and gilly; we can be heroes, we can be heroes, just for one day: été"

# The dictionary `SHORT_SIZED_HIGH` and `SHORT_DICTIONARY` were made with.
constant DICTIONARY_TEXT: str
    "we can be heroes, just for one day; we could be heroes, forever and ever; ziggy stardust and the spiders from mars"

# `lz4 -1` of `SHORT_TEXT`'s bytes, the tool's defaults for a small file: blocks of 64 KiB that stand alone and a content checksum.
constant SHORT_TOOL: str
    "04224d186440a767000000ff3a7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c120000f0086a75737420666f72206f6e65206461793a20c3a974c3a900000000a3b498a1"

# `lz4 -12 --content-size -BX` of `SHORT_TEXT`: the highest level, the size said, a checksum after each block.
constant SHORT_HIGH: str
    "04224d187c4073000000000000005167000000fe3b7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c201200f0086a75737420666f72206f6e65206461793a20c3a974c3a9386c45f700000000a3b498a1"

# `lz4 -l` of `SHORT_TEXT`: a legacy frame.
constant SHORT_LEGACY: str
    "02214c1867000000ff3a7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c120000f0086a75737420666f72206f6e65206461793a20c3a974c3a9"

# Python's `lz4.block.compress` of `SHORT_TEXT` with `store_size=False`: a bare block.
constant SHORT_BLOCK: str
    "ff3a7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c120000f0086a75737420666f72206f6e65206461793a20c3a974c3a9"

# Python's `lz4.block.compress` of `SHORT_TEXT`, its length before it.
constant SHORT_SIZED: str
    "73000000ff3a7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c120000f0086a75737420666f72206f6e65206461793a20c3a974c3a9"

# Python's `lz4.block.compress` of `SHORT_TEXT` in mode `high_compression` with `dict` the bytes of `DICTIONARY_TEXT`, its length before it.
constant SHORT_SIZED_HIGH: str
    "73000000022800f117706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726446004367696c6c86000aaa000fbc000f703a20c3a974c3a9"

# Python's `lz4.frame.compress` of `SHORT_TEXT` at level 9, blocks linked, both checksums and the size.
constant SHORT_PYTHON: str
    "04224d187c4073000000000000005167000000ff3a7a6967677920706c61796564206775697461722c206a616d6d696e6720676f6f64207769746820776569726420616e642067696c6c793b2077652063616e206265206865726f65732c120000f0086a75737420666f72206f6e65206461793a20c3a974c3a9ef026d7100000000a3b498a1"

# `lz4 -D` of `SHORT_TEXT` with the bytes of `DICTIONARY_TEXT` as the dictionary, blocks linked.
constant SHORT_DICTIONARY: str
    "04224d186440a743000000022800f117706c61796564206775697461722c206a616d6d696e6720676f6f6420776974682077656972645f004367696c6c86000aaa000fbc000f703a20c3a974c3a900000000a3b498a1"

# `lz4 -BD -B4 -BX --content-size` of `noise(70000)`: two linked blocks of 64 KiB at most, the second reaching back into the first.
constant NOISE_LINKED: str
    ""

# `lz4 -BI -B4` of `noise(70000)`: two blocks that stand alone.
constant NOISE_INDEPENDENT: str
    ""

# The bytes of a sample's hexadecimal text.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()

# The bytes of a text.
function text(s: str) -> [u8]
    return bytes.from_text(s)

# `n` bytes of noise from a linear congruential generator seeded with 7,
# repeating every 1,000 bytes: what the `NOISE_` samples hold. Python made
# the same bytes with the same formula.
function noise(n: i64) -> [u8]
    unit: [u8] @= []
    x: i64 @= 7

    for _ in range(from: 0, to: 1000)
        x @ (x * 1103515245 + 12345) % 2147483648
        unit @ unit.push(to_u8(x >> 16 & 255).must())

    out: [u8] @= []
    i: i64 @= 0

    while i < n
        out @ out.push(unit[i % 1000])
        i @ i + 1

    return out

# `data` with byte `at` flipped by `mask`.
function flipped(data: [u8], at: i64, mask: u8) -> [u8]
    changed @= data
    changed[at] @ to_u8(to_i64(changed[at]).must() ^ to_i64(mask).must()).must()
    return changed

# `data` followed by `more`.
function followed(data: [u8], more: [u8]) -> [u8]
    joined @= data

    for b in more
        joined @ joined.push(b)

    return joined
