# Streams to test with, made by the `xz` tool 5.8.4 on this machine
# (2026-11-18) and written as hexadecimal text; Python's `lzma` (3.15)
# reads each but `SHORT_X86` the same. Made by hand at a shell; no program
# calls it.

use bytes

# The text the samples hold, with characters of two bytes at its end.
constant SHORT_TEXT: str
    "ziggy played guitar, jamming good with weird and gilly, and the spiders from mars; été"

# `xz -6` of the 88 bytes of `SHORT_TEXT`, its check CRC-64.
constant SHORT: str
    ""

# `xz --check=sha256` of the one byte "a".
constant ONE_SHA256: str
    "fd377a585a00000ae1fb0ca104c005012101160000000000000000000482698d0100006100000000ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb0001390107080559189b4b9a01000000000a595a"

# `xz --delta=dist=3 --lzma2` of `SHORT_TEXT`: two filters in its block.
constant SHORT_DELTA: str
    ""

# `xz --block-size=30` of `SHORT_TEXT`: three blocks, their index listing three.
constant SHORT_BLOCKS: str
    ""

# `xz --x86 --lzma2` of `SHORT_TEXT`: a branch converter before LZMA2.
constant SHORT_X86: str
    ""

# `xz --format=lzma` of `SHORT_TEXT`: its size unknown, ended by the end marker.
constant SHORT_LZMA: str
    "5d00008000ffffffffffffffff003d1a492d34664d1ed984c1b40534d15019fb199833e07a911097c977c9f9eb1a7a73551ee208acd5ddaa83e67575f5a94336431cb58dfe8b99771d544461fcbfec73fc69b17d5bd45bb7bec0a939e53996fed8fd88fc4471c0"

# `xz -0 --check=crc32` of the one byte "a".
constant ONE_CRC32: str
    "fd377a585a0000016922de3603c0050121010c0000000000ef4ed9b8010000610000000043beb7e800011901a52c81cc9042990d010000000001595a"

# The bytes of a sample's hexadecimal text.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()

# The bytes of `SHORT_TEXT`.
function short_text() -> [u8]
    return bytes.from_text(SHORT_TEXT)

# `data` with byte `at` flipped by `mask`.
function flipped(data: [u8], at: i64, mask: u8) -> [u8]
    changed @= data
    changed[at] @ to_u8(to_i64(changed[at]).must() ^ to_i64(mask).must()).must()
    return changed

# `data` followed by `more`.
function followed(data: [u8], more: [u8]) -> [u8]
    joined @= data

    for b in more
        joined @ joined.push(b)

    return joined
