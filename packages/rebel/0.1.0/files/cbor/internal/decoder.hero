# Bytes decoded into the flat events of one CBOR item, by RFC 8949's rules of
# a well-formed item and the validity a caller asks for: text strings UTF-8,
# no key twice in a map, the deterministic encoding. The containers still open
# wait on a stack this module holds, so an item nested a million deep costs a
# list of a million entries and never the machine's stack, and the nesting a
# caller allows is a number it sets. No length is trusted before the bytes
# that would fill it are there.

use bytes
use cbor/internal/appendix
use cbor/internal/encoder
use cbor/internal/event
use cbor/internal/floats

# The code of bytes that are not one well-formed and valid item.
constant INVALID: str
    "invalid"

# The code of a text string whose bytes are not UTF-8.
constant NOT_TEXT: str
    "not_text"

# How bytes are decoded.
record Reading
    # The deepest nesting accepted: `[]` and a tag are 1 deep.
    max_depth: i64
    # Whether a map may hold one key twice.
    duplicate_keys: bool
    # Whether the bytes must be the deterministic encoding.
    deterministic: bool

# What `read` answers.
record Read
    # The item's events, in the order the bytes hold them.
    events: [event.Event]
    # The byte index past the item.
    next: i64

# The head of one item: its major type, its additional information, the
# argument that information gives, and where the head ends.
record Head
    # The major type, 0 to 7.
    major: i64
    # The additional information, 0 to 31; 31 where the length is indefinite
    # or the byte is a break.
    info: i64
    # The argument, 0 where `info` is 31.
    arg: u64
    # The byte index past the head.
    next: i64

# A string read: its event, and the byte index past it.
record Scanned
    # The string's event, its byte index set.
    item: event.Event
    # The byte index past the string, its break included.
    end: i64

# A container still open: the index of its event, how many items it still
# waits for, or -1 where its length is indefinite, and how many it has had.
record Open
    # The index of the container's event in the events.
    index: i64
    # The items still to come, or -1 for an indefinite length.
    waiting: i64
    # The items read so far.
    seen: i64

# The reading that accepts every well-formed item, with no limit of nesting:
# what this package uses on bytes its own encoder wrote.
function lenient() -> Reading
    return Reading(max_depth: 9223372036854775807, duplicate_keys: true, deterministic: false)

# The name of the items of `major` type, as a message says it.
function major_name(major: i64) -> str
    names = [
        "an unsigned integer"
        "a negative integer"
        "a byte string"
        "a text string"
        "an array"
        "a map"
        "a tag"
        "a simple value or float"
    ]
    return names[major]

# The head that begins at byte `at` of `data`. Fails `invalid` where the data
# ends inside it or its additional information is reserved.
function head_at(data: [u8], at: i64) -> Head?
    if at >= data.len()
        return fail(code: INVALID, msg: f"byte {at}: the data ends where an item was expected")

    b = to_i64(data[at]).must()
    major = b >> 5
    info = b & 31

    if info < 24
        return ok(Head(major: major, info: info, arg: to_u64(info).must(), next: at + 1))
    else if info > 27 && info < 31
        return fail(code: INVALID, msg: f"byte {at}: the additional information {info} is reserved")
    else if info == 31
        return ok(Head(major: major, info: info, arg: 0, next: at + 1))

    size = 1 << info - 24

    if at + 1 + size > data.len()
        return fail(code: INVALID, msg: f"byte {at}: the data ends inside the head of {major_name(major)}")

    arg = if size == 1
        to_u64(data[at + 1]).must()
    else if size == 2
        to_u64(bytes.decode_u16_be(s: data, at: at + 1).must()).must()
    else if size == 4
        to_u64(bytes.decode_u32_be(s: data, at: at + 1).must()).must()
    else
        bytes.decode_u64_be(s: data, at: at + 1).must()
    return ok(Head(major: major, info: info, arg: arg, next: at + 1 + size))

# Fails `invalid` where `count` items, each at least `each` bytes long, cannot
# fit in the bytes of `data` after `from`.
function fits(data: [u8], from: i64, count: u64, each: u64, at: i64) -> ()?
    left = to_u64(data.len() - from).must()

    if count > left / each
        return fail(code: INVALID, msg: f"byte {at}: {count} items of {each} bytes or more where {left} bytes remain")
    return ok()

# The bytes of a string whose head is `h`, read at `at`, and where it ends: a
# definite string's, or the chunks of an indefinite one up to its break.
# Fails `invalid` where a length passes the data's end or a chunk is not a
# definite string of the same major type; fails `not_text` where a text
# string, or a chunk of one, is not UTF-8.
function string_at(data: [u8], h: Head, at: i64) -> Scanned?
    out: [u8] @= []
    pos: i64 @= h.next
    chunks: [Head] @= []

    if h.info == 31
        while pos < data.len() && data[pos] != 0xff
            c = head_at(data: data, at: pos)?

            if c.major != h.major || c.info == 31
                return fail(
                    code: INVALID,
                    msg: f"byte {pos}: {major_name(c.major)} inside an indefinite {major_name(h.major)}, where only definite chunks of its kind stand"
                )
            chunks @ chunks.push(c)
            fits(data: data, from: c.next, count: c.arg, each: 1, at: pos)?
            pos @ c.next + to_i64(c.arg).must()

        if pos >= data.len()
            return fail(
                code: INVALID,
                msg: f"byte {at}: the data ends before the break of an indefinite {major_name(h.major)}"
            )
        pos @ pos + 1
    else
        chunks @ chunks.push(h)
        fits(data: data, from: h.next, count: h.arg, each: 1, at: at)?
        pos @ h.next + to_i64(h.arg).must()

    for c in chunks
        piece = data.slice(from: c.next, to: c.next + to_i64(c.arg).must())

        if h.major == 3 && bytes.to_text(piece).is_err()
            return fail(code: NOT_TEXT, msg: f"byte {at}: a text string whose bytes are not UTF-8")
        bytes.push_all(to: @out, from: piece)

    e = if h.major == 2
        event.of_binary(out)
    else
        event.of_text(bytes.to_text(out).must())
    return ok(Scanned(item: event.placed(e: e, at: at), end: pos))

# The events of the one item that begins at byte `from` of `data`, and where
# it ends, read as `reading` asks. Fails `invalid` where the bytes are no
# well-formed item, the nesting passes `reading.max_depth`, a map holds one key
# twice that `reading` refuses, or the encoding is not the deterministic one
# `reading` asks for; fails `not_text` where a text string is not UTF-8. Each
# message opens `byte B:`.
function read(data: [u8], from: i64, reading: Reading) -> Read?
    events: [event.Event] @= []
    open: [Open] @= []
    depth: i64 @= 0
    at: i64 @= from
    complete: bool @= false

    while !complete
        h = head_at(data: data, at: at)?
        finished: bool @= true

        if h.major == 7 && h.info == 31
            if depth == 0 || open[depth - 1].waiting != -1
                return fail(code: INVALID, msg: f"byte {at}: a break where no indefinite length is open")

            top = open[depth - 1]
            container = events[top.index]

            if container.kind == event.PAIRS && top.seen % 2 == 1
                return fail(code: INVALID, msg: f"byte {at}: a break after a key with no value")

            items = if container.kind == event.PAIRS
                top.seen / 2
            else
                top.seen
            events[top.index].arg @ to_u64(items).must()
            depth @ depth - 1
            at @ h.next
        else if (h.major == 0 || h.major == 1 || h.major == 6) && h.info == 31
            return fail(code: INVALID, msg: f"byte {at}: {major_name(h.major)} has no indefinite length")
        else if h.major == 2 || h.major == 3
            got = string_at(data: data, h: h, at: at)?
            events @ events.push(got.item)
            at @ got.end
        else if h.major == 4 || h.major == 5 || h.major == 6
            if depth + 1 > reading.max_depth
                return fail(code: INVALID, msg: f"byte {at}: the nesting passes {reading.max_depth} levels")

            kind = if h.major == 4
                event.LIST
            else if h.major == 5
                event.PAIRS
            else
                event.TAG

            each: u64 = if h.major == 5
                2
            else
                1

            if h.major != 6 && h.info != 31
                fits(data: data, from: h.next, count: h.arg, each: each, at: at)?

            made = if h.major == 6
                event.of_tag(tag: h.arg, count: 1)
            else
                event.of_kind(kind: kind, arg: h.arg)
            events @ events.push(event.placed(e: made, at: at))

            waiting = if h.info == 31
                -1
            else if h.major == 6
                1
            else
                to_i64(h.arg).must() * to_i64(each).must()

            if waiting != 0
                opened = Open(index: events.len() - 1, waiting: waiting, seen: 0)

                if depth == open.len()
                    open @ open.push(opened)
                else
                    open[depth] @ opened
                depth @ depth + 1
                finished @ false
            at @ h.next
        else
            events @ events.push(event.placed(e: scalar_of(data: data, h: h, at: at)?, at: at))
            at @ h.next

        while finished && depth > 0
            top = open[depth - 1]

            if top.waiting == -1
                open[depth - 1].seen @ top.seen + 1
                finished @ false
            else if top.waiting > 1
                open[depth - 1].waiting @ top.waiting - 1
                open[depth - 1].seen @ top.seen + 1
                finished @ false
            else
                depth @ depth - 1

        complete @ finished && depth == 0

    if !reading.duplicate_keys || reading.deterministic
        written = encoder.write(events: events, order: encoder.BYTEWISE, duplicates: reading.duplicate_keys)?

        if reading.deterministic
            same_to(data: data, from: from, written: written)?
    return ok(Read(events: events, next: at))

# Fails `invalid` where `written`, the deterministic encoding, differs from the
# bytes of `data` from `from`, naming the first byte that does.
function same_to(data: [u8], from: i64, written: [u8]) -> ()?
    for k in range(from: 0, to: written.len())
        if data[from + k] != written[k]
            return fail(
                code: INVALID,
                msg: f"byte {from + k}: 0x{bytes.format_hex([data[from + k]])} where the deterministic encoding writes 0x{bytes.format_hex([written[k]])}"
            )

    return ok()

# The event of the item of major type 0, 1 or 7 whose head is `h`. Fails
# `invalid` for a simple value written in two bytes that one byte holds.
function scalar_of(data: [u8], h: Head, at: i64) -> event.Event?
    if h.major == 0
        return ok(event.of_kind(kind: event.UNSIGNED, arg: h.arg))
    else if h.major == 1
        return ok(event.of_kind(kind: event.NEGATIVE, arg: h.arg))
    else if h.info < 20
        return ok(event.of_kind(kind: event.SIMPLE, arg: h.arg))
    else if h.info == 20 || h.info == 21
        return ok(event.of_boolean(h.info == 21))
    else if h.info == 22
        return ok(event.of_kind(kind: event.NULL_VALUE, arg: 0))
    else if h.info == 23
        return ok(event.of_kind(kind: event.UNDEFINED, arg: 0))
    else if h.info == 24 && h.arg < 32
        return fail(
            code: INVALID,
            msg: f"byte {at}: simple value {h.arg} written in two bytes, which only one byte may write"
        )
    else if h.info == 24
        return ok(event.of_kind(kind: event.SIMPLE, arg: h.arg))
    else if h.info == 25
        return ok(event.of_float(floats.half_value(to_i64(h.arg).must())))
    else if h.info == 26
        return ok(event.of_float(floats.single_value(to_i64(h.arg).must())))
    return ok(event.of_float(floats.double_value(data: data, at: at + 1)))

# The code and message `read` fails with on the bytes `hex` writes, read as
# `reading` asks, or "" where they are read.
function failure_of(hex: str, reading: Reading) -> str
    return match read(data: bytes.parse_hex(hex).must(), from: 0, reading: reading)
        .ok _  => ""
        .err e => f"{e.code}: {e.msg}"

# The reading of `strict`: a key once, any encoding, nesting to 512.
function strictly() -> Reading
    return Reading(max_depth: 512, duplicate_keys: false, deterministic: false)

test "read: every example of RFC 8949 appendix A, written again deterministically"
    deterministic = Reading(max_depth: 512, duplicate_keys: false, deterministic: true)

    for row in appendix.rows()
        data = bytes.parse_hex(row.encoded).must()
        got = read(data: data, from: 0, reading: strictly()).must()
        assert got.next == data.len()
        written = encoder.write(events: got.events, order: encoder.BYTEWISE, duplicates: false).must()
        assert bytes.format_hex(written) == row.written
        assert read(data: data, from: 0, reading: deterministic).is_err() == (row.encoded != row.written)

test "read: every example of RFC 8949 appendix F is refused"
    ends = [
        "18"
        "19"
        "1a"
        "1b"
        "1901"
        "1a0102"
        "1b01020304050607"
        "38"
        "58"
        "78"
        "98"
        "9a01ff00"
        "b8"
        "d8"
        "f8"
        "f900"
        "fa0000"
        "fb000000"
    ]
    short = ["41", "61", "5affffffff00", "5bffffffffffffffff010203", "7affffffff00", "7b7fffffffffffffff010203"]
    unclosed = ["81", "818181818181818181", "8200", "a1", "a20102", "a100", "a2000000", "c0", "5f4100", "7f6100"]
    unbroken = ["9f", "9f0102", "bf", "bf01020102", "819f", "9f8000", "9f9f9f9f9fffffffff", "9f819f819f9fffffff"]
    reserved = [
        "1c"
        "1d"
        "1e"
        "3c"
        "3d"
        "3e"
        "5c"
        "5d"
        "5e"
        "7c"
        "7d"
        "7e"
        "9c"
        "9d"
        "9e"
        "bc"
        "bd"
        "be"
        "dc"
        "dd"
        "de"
        "fc"
        "fd"
        "fe"
    ]
    simple = ["f800", "f801", "f818", "f81f"]
    chunks = [
        "5f00ff"
        "5f21ff"
        "5f6100ff"
        "5f80ff"
        "5fa0ff"
        "5fc000ff"
        "5fe0ff"
        "7f4100ff"
        "5f5f4100ffff"
        "7f7f6100ffff"
    ]
    breaks = [
        "ff"
        "81ff"
        "8200ff"
        "a1ff"
        "a1ff00"
        "a100ff"
        "a20000ff"
        "9f81ff"
        "9f829f819f9fffffffff"
        "bf00ff"
        "bf000000ff"
    ]
    indefinite = ["1f", "3f", "df"]

    for group in [ends, short, unclosed, unbroken, reserved, simple, chunks, breaks, indefinite]
        for hex in group
            assert failure_of(hex: hex, reading: strictly()) != ""

test "read: the messages of an empty input, a reserved head, a stray break"
    assert failure_of(hex: "", reading: strictly()) == "invalid: byte 0: the data ends where an item was expected"
    assert failure_of(hex: "1c", reading: strictly()) == "invalid: byte 0: the additional information 28 is reserved"
    assert failure_of(hex: "8201ff", reading: strictly()) == "invalid: byte 2: a break where no indefinite length is open"
    assert failure_of(hex: "bf00ff", reading: strictly()) == "invalid: byte 2: a break after a key with no value"
    assert failure_of(hex: "df", reading: strictly()) == "invalid: byte 0: a tag has no indefinite length"
    assert failure_of(hex: "f818", reading: strictly()) == "invalid: byte 0: simple value 24 written in two bytes, which only one byte may write"

test "read: a length no remaining byte could fill fails before anything is held"
    assert failure_of(hex: "5bffffffffffffffff010203", reading: strictly()) == "invalid: byte 0: 18446744073709551615 items of 1 bytes or more where 3 bytes remain"
    assert failure_of(hex: "9bffffffffffffffff00", reading: strictly()) == "invalid: byte 0: 18446744073709551615 items of 1 bytes or more where 1 bytes remain"
    assert failure_of(hex: "bb000000000000000201", reading: strictly()) == "invalid: byte 0: 2 items of 2 bytes or more where 1 bytes remain"
    assert failure_of(hex: "5f41", reading: strictly()) == "invalid: byte 1: 1 items of 1 bytes or more where 0 bytes remain"

test "read: a text string not UTF-8, whole or split between two chunks"
    assert failure_of(hex: "61ff", reading: strictly()) == "not_text: byte 0: a text string whose bytes are not UTF-8"
    assert failure_of(hex: "7f61c361bcff", reading: strictly()) == "not_text: byte 0: a text string whose bytes are not UTF-8"
    assert failure_of(hex: "7f62c3bc61e6ff", reading: strictly()) == "not_text: byte 0: a text string whose bytes are not UTF-8"
    assert failure_of(hex: "41ff", reading: strictly()) == ""

test "read: the depth allowed, at its edge and one past it, a tag counting"
    shallow = Reading(max_depth: 2, duplicate_keys: false, deterministic: false)
    assert failure_of(hex: "8181", reading: shallow) == "invalid: byte 1: 1 items of 1 bytes or more where 0 bytes remain"
    assert failure_of(hex: "818100", reading: shallow) == ""
    assert failure_of(hex: "81818100", reading: shallow) == "invalid: byte 2: the nesting passes 2 levels"
    assert failure_of(hex: "81c100", reading: shallow) == ""
    assert failure_of(hex: "81c1c100", reading: shallow) == "invalid: byte 2: the nesting passes 2 levels"
    none = Reading(max_depth: 0, duplicate_keys: false, deterministic: false)
    assert failure_of(hex: "00", reading: none) == ""
    assert failure_of(hex: "80", reading: none) == "invalid: byte 0: the nesting passes 0 levels"

test "read: one key twice, refused, allowed, and equal only once encoded alike"
    assert failure_of(hex: "a2010201f6", reading: strictly()) == "invalid: byte 0: a map holds one key twice, encoded 01"
    assert failure_of(hex: "a201021801f6", reading: strictly()) == "invalid: byte 0: a map holds one key twice, encoded 01"
    allowed = Reading(max_depth: 512, duplicate_keys: true, deterministic: false)
    assert failure_of(hex: "a2010201f6", reading: allowed) == ""
    assert failure_of(hex: "a2f90000f6f98000f6", reading: strictly()) == ""
    assert failure_of(hex: "81a2616101616102", reading: strictly()) == "invalid: byte 1: a map holds one key twice, encoded 6161"

test "read: the deterministic encoding asked, a longer head and keys out of order"
    deterministic = Reading(max_depth: 512, duplicate_keys: false, deterministic: true)
    assert failure_of(hex: "1817", reading: deterministic) == "invalid: byte 0: 0x18 where the deterministic encoding writes 0x17"
    assert failure_of(hex: "a2616201616102", reading: deterministic) == "invalid: byte 2: 0x62 where the deterministic encoding writes 0x61"
    assert failure_of(hex: "fb3ff8000000000000", reading: deterministic) == "invalid: byte 0: 0xfb where the deterministic encoding writes 0xf9"
    assert failure_of(hex: "a2616101616202", reading: deterministic) == ""

test "read: an item from an offset, and where the next begins"
    data = bytes.parse_hex("0161618200f6").must()
    first = read(data: data, from: 0, reading: strictly()).must()
    assert first.next == 1
    second = read(data: data, from: 1, reading: strictly()).must()
    assert second.next == 3 && second.events[0].text == "a" && second.events[0].at == 1
    third = read(data: data, from: 3, reading: strictly()).must()
    assert third.next == 6 && third.events.len() == 3
    assert failure_of(hex: "", reading: lenient()) == "invalid: byte 0: the data ends where an item was expected"

test "head_at: each width and the end of the data inside one"
    data = bytes.parse_hex("1bffffffffffffffff").must()
    h = head_at(data: data, at: 0).must()
    assert h.major == 0 && h.info == 27 && h.arg == 18446744073709551615 && h.next == 9
    assert head_at(data: bytes.parse_hex("19ff").must(), at: 0).is_err()
    assert head_at(data: bytes.parse_hex("5f").must(), at: 0).must().info == 31

test "major_name and fits: the names, and a count at the edge of what remains"
    assert major_name(0) == "an unsigned integer"
    assert major_name(7) == "a simple value or float"
    assert !fits(data: [0, 0, 0], from: 1, count: 2, each: 1, at: 0).is_err()
    assert fits(data: [0, 0, 0], from: 1, count: 3, each: 1, at: 0).is_err()
    assert fits(data: [0, 0, 0], from: 1, count: 2, each: 2, at: 0).is_err()

test "string_at: a definite string, chunks joined, an empty indefinite string"
    data = bytes.parse_hex("5f42010243030405ff").must()
    h = head_at(data: data, at: 0).must()
    got = string_at(data: data, h: h, at: 0).must()
    assert got.item.data == [1, 2, 3, 4, 5] && got.end == 9
    empty = bytes.parse_hex("7fff").must()
    e = string_at(data: empty, h: head_at(data: empty, at: 0).must(), at: 0).must()
    assert e.item.text == "" && e.end == 2

test "scalar_of: the named values, a simple value in one byte and two"
    data = bytes.parse_hex("f8ff").must()
    assert scalar_of(data: data, h: head_at(data: data, at: 0).must(), at: 0).must().arg == 255
    one = bytes.parse_hex("e0").must()
    assert scalar_of(data: one, h: head_at(data: one, at: 0).must(), at: 0).must().kind == event.SIMPLE
