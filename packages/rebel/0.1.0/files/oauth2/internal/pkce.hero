# PKCE (RFC 7636): a verifier drawn from the system's generator by
# `random`, and its S256 challenge; the same drawing makes a state and a
# nonce.

use bytes
use crypto
use random

# A verifier, a state or a nonce: 32 random bytes in base64url, 43
# characters.
function drawn() -> str?
    return random.secure_token_base64_url(32)

# Whether `verifier` is one RFC 7636 § 4.1 allows: 43 to 128 characters of
# letters, digits, `-`, `.`, `_` and `~`.
function is_verifier(verifier: str) -> bool
    if verifier.len() < 43 || verifier.len() > 128
        return false

    for at in range(from: 0, to: verifier.len())
        c = verifier[at]
        letter = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
        digit = c >= '0' && c <= '9'

        if !letter && !digit && c != '-' && c != '.' && c != '_' && c != '~'
            return false

    return true

# The S256 challenge of `verifier`.
function challenge(verifier: str) -> str
    return bytes.format_base64_url_unpadded(crypto.sha256_text(verifier))

test "challenge: RFC 7636 Appendix B's verifier and challenge"
    assert challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"

test "is_verifier: 43 and 128 characters, 42 and 129, a character outside the alphabet, the four marks"
    assert is_verifier(repeat("a", 43))
    assert is_verifier(repeat("Z", 128))
    assert !is_verifier(repeat("a", 42))
    assert !is_verifier(repeat("a", 129))
    assert !is_verifier(repeat("a", 42) + "+")
    assert is_verifier(repeat("a", 39) + "-._~")

test "drawn: 43 characters, a verifier, two draws apart"
    one = drawn().must()
    assert one.len() == 43 && is_verifier(one)
    assert one != drawn().must()
