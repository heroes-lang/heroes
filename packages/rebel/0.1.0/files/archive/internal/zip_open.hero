# A zip archive's central directory read into the face's `ZipReader`, from
# a stream or from bytes held: each member's kind, method and mode made from
# what the directory states.

use archive
use archive/internal/zip_read

# The reader of the zip archive `src` holds, its central directory read.
# Fails as `zip_read.read_directory` fails.
function reader_of(src: zip_read.Source) -> archive.ZipReader?
    dir = zip_read.read_directory(src)?
    entries: [archive.ZipEntry] @= []

    for m in dir.members
        unix = m.made_by >> 8 == 3
        type = m.external >> 16 & 0o170000
        mode: i64 @= m.external >> 16 & 0o7777
        kind: archive.Kind @= .file
        name: str @= m.name

        if name.len() > 0 && name[name.len() - 1] == '/'
            kind @ .directory
            name @ name.slice(from: 0, to: name.len() - 1)
        else if unix && type == 0o120000
            kind @ .symlink
        else if unix && type == 0o040000
            kind @ .directory

        if !unix || mode == 0
            mode @ 0o644

            match kind
                .directory                               => mode @ 0o755
                .file | .symlink | .hard_link | .other _ => _ = 0
        method: archive.Method @= .deflated

        if m.method == zip_read.STORED
            method @ .stored
        entries @ entries.push(
            archive.ZipEntry(name: name, kind: kind, method: method, size: m.size, compressed_size: m.compressed, crc: to_u32(m.crc).must(), modified: m.modified, mode: mode, comment: m.comment, offset: m.offset)
        )

    return ok(
        archive.ZipReader(source: src, size: zip_read.size_of(src)?, entries: entries, comment: dir.comment, members: dir.members)
    )
