# Archives to test with, made by Python's `tarfile` and `zipfile` (3.15),
# written as hexadecimal text; the tars are gzip-compressed to keep them
# small. Made by a script outside the tree on 2026-11-16; no program calls
# it.

use bytes

# Python's tarfile, PAX format, gzip: a folder, files, a non-ASCII name, a name of 154 bytes, a symbolic link, a hard link, a PAX comment, a time with a fraction.
constant TAR_PAX: str
    ""

# Python's tarfile, GNU format, gzip: a long name, an id in base 256, a long link.
constant TAR_GNU: str
    ""

# Python's tarfile, ustar format, gzip: one file in a folder.
constant TAR_USTAR: str
    "1f8b08000000000002ffedd1310ac2401404d07f144fa0ab6e76cf63616b403790e3e793d25e417caf1998668a594ef3e37e1ceb88cf29a9d5ba677acf748d739d2eb5f752f7be4fadc5a1c4172caf717be664fca77c3f000000000000000000f83d1b268fc0a900280000"

# A tar whose second entry is `../evil.txt`.
constant TAR_EVIL_UP: str
    "1f8b08000000000002ffedd4310a80300c85e11cc513d456a23d8f83832814b48ac7b77674715290fedff2204b86f01226138f28afb249a79a33b967d288d3b651efade6b977ad93caca07b635f64b5a29650a93a060c6d4c33eceaf3e81e7feebbdffde29fdffc2757c5a000000000000000000000000f05f27603cf71100280000"

# A tar whose entry is `/tmp/evil.txt`.
constant TAR_EVIL_ABS: str
    "1f8b08000000000002ffedd1310ac2401404d07f144f6036fa4dce63612144105dc5e3bb49995e417caf19986a60ba7ab976a7e779dad6578dcf28cd90b964b3ce26a3cfc32ec7b1e4dcf7653f94d894f882c7bd1e6f6d4afca7f9fa000000000000000000e0e7bc010225e78600280000"

# A tar whose entry is a symbolic link to `/etc`.
constant TAR_EVIL_LINK_ABS: str
    "1f8b08000000000002ffedceb10d8430100440974207f8e11ed78310191198fedf72f83901d24cb2a74df68ef4bcdc2c113d9bffecf727be539492a3f74b99731aa671afdbd3cfdd575dcf3699000000000000000000e03d7e95575cc400280000"

# A tar whose entry is a symbolic link `d/l` to `../../x`.
constant TAR_EVIL_LINK_UP: str
    "1f8b08000000000002ffedce310ac3300c05501fa527881da3d8e70964ecd4b490e3d778ec9ea1f01e82ffd1221df999ee5686163173f8cdd9d7d86af45e62ee7b5d5b7ad465c963ae5b9ffb9ceffd354e26000000000000000000f81f5f65a9ab7700280000"

# A tar with a link `l` to `d`, inside, then a file `l/x.txt` through it.
constant TAR_EVIL_THROUGH: str
    "1f8b08000000000002ffedd33d0e80200c40e11ec51308d42ae7317174524c38be84d11d7fe2fb96362c0c2f5d9c34e78bc9accee23aeb1e6c548bd15b7d9f54a374a3dce0d8d3bc952fe59f567965ff418374bad0bf797f97fb94d3c3fdc3a57f542bfd3df7df5c160000000000000000000000007cd909b721d36d00280000"

# A tar whose entry is a hard link to `../x`.
constant TAR_EVIL_HARD: str
    "1f8b08000000000002ffedceb90d8030100440974205bc67a8878c9847a27c2c87e4044833c99e36d9dbd2f7fa628ea859bcb3de43e43196a58fdacf394fa919dab6bbbf7eee3ace752f9309000000000000000000fee301bdc2445a00280000"

# A tar whose entry is a character device.
constant TAR_EVIL_DEVICE: str
    "1f8b08000000000002ffedcfb90d84401004c00d85107806361ea42301bef859ad85b0e1ac2aa747ed8cfab79ce96b6d3145d42c9e59ef2ec63e726ea3f63947979a21fdc1b1edf35a5ebe31f23e0e0000000000000000003e7401d7e783d300280000"

# Python's zipfile: a folder, a stored and a deflated file, a UTF-8 name, comments, a symbolic link.
constant ZIP_PY: str
    ""

# Python's zipfile with ZIP64 forced on one member.
constant ZIP_64: str
    ""

# A zip with `ok.txt` and `../evil.txt`.
constant ZIP_EVIL_UP: str
    ""

# A zip whose member is `/tmp/evil.txt`.
constant ZIP_EVIL_ABS: str
    "504b0304140000000800aab16e575231fb8d06000000040000000d0000002f746d702f6576696c2e7478744b2dcbcc0100504b01021403140000000800aab16e575231fb8d06000000040000000d0000000000000000000000a481000000002f746d702f6576696c2e747874504b050600000000010001003b000000310000000000"

# A zip whose member is a symbolic link to `/etc/passwd`.
constant ZIP_EVIL_LINK: str
    "504b0304140000000000aab16e570ab91f290b0000000b000000010000006c2f6574632f706173737764504b01021403140000000000aab16e570ab91f290b0000000b000000010000000000000000000000ffa1000000006c504b050600000000010001002f0000002a0000000000"

# The bytes of the hexadecimal text `hex`, which is one.
function of(hex: str) -> [u8]
    # Every constant above is hexadecimal, written by the script.
    return bytes.parse_hex(hex).must()
