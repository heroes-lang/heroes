# A zip member's data read from the archive's stream, in chunks: stored or
# deflated, decompressed to no more than the size the directory states, its
# CRC-32 and size checked at its end. `zip_read` finds the member.

use archive/internal/codes
use archive/internal/zip_read
use compress
use hash
use io

# A member's data being read.
record Reading
    # The archive's stream.
    s: io.Stream
    # The stream's size.
    size: i64
    # The member.
    m: zip_read.Member
    # Where the next compressed byte is.
    at: i64
    # The compressed bytes not yet read.
    left: i64
    # The decompressor of a deflated member.
    d: compress.Decompressor
    # The CRC-32 of the data so far.
    check: hash.State32
    # How many bytes of data so far.
    made: i64
    # Whether the data has ended and been checked.
    ended: bool

# A reading of `m`'s data in `s`, a stream of `size` bytes. Fails
# `unsupported` on an encrypted member or a method other than stored and
# deflated, `limit` where its size passes `limit`, and `invalid` where its
# local header is not one or its data passes the stream's end.
function start_reading(s: io.Stream, size: i64, m: zip_read.Member, limit: i64) -> Reading?
    if m.flags & zip_read.FLAG_ENCRYPTED != 0
        return fail(
            code: codes.UNSUPPORTED,
            msg: f"the member \"{m.name}\" is encrypted, which this reader does not read"
        )

    if m.method != zip_read.STORED && m.method != zip_read.DEFLATED
        return fail(
            code: codes.UNSUPPORTED,
            msg: f"the member \"{m.name}\" is compressed by method {m.method}; this reader reads 0 (stored) and 8 (deflated)"
        )

    if m.size > limit
        return fail(code: codes.LIMIT, msg: f"the member \"{m.name}\" holds {m.size} bytes, past the limit of {limit}")
    local = zip_read.bytes_at(s, at: m.offset, count: 30, size: size, what: f"the local header of \"{m.name}\"")?

    if zip_read.le(local, at: 0, width: 4) != zip_read.LOCAL
        return codes.invalid_at(at: m.offset, why: f"the local header of \"{m.name}\" is not one")
    start = m.offset + 30 + zip_read.le(local, at: 26, width: 2) + zip_read.le(local, at: 28, width: 2)

    if start + m.compressed > size
        return codes.invalid_at(at: start, why: f"the data of \"{m.name}\" reaches past the end of the archive")

    if m.method == zip_read.STORED && m.compressed != m.size
        return codes.invalid_at(
            at: m.offset,
            why: f"the stored member \"{m.name}\" states {m.compressed} bytes stored and {m.size} bytes of data"
        )
    return ok(
        Reading(s: s, size: size, m: m, at: start, left: m.compressed, d: compress.decompressor(.raw, limit: m.size), check: hash.start32(.crc32), made: 0, ended: false)
    )

# The next chunk of the member's data, none at its end, where its CRC-32
# and size are checked. Fails `invalid` where they do not match, the
# deflated data is not DEFLATE or ends early, and as the stream fails.
function next_chunk(@r: Reading) -> [u8]?
    while !r.ended
        out: [u8] @= []

        if r.left > 0
            ask: i64 @= r.left

            if ask > 65536
                ask @ 65536
            _ = io.seek(r.s, offset: r.at, from: .start)?
            got = io.read(r.s, n: ask)?

            if got.len() == 0
                return codes.invalid_at(at: r.at, why: f"the archive ends inside the data of \"{r.m.name}\"")
            r.at @ r.at + got.len()
            r.left @ r.left - got.len()

            if r.m.method == zip_read.STORED
                out @ got
            else
                out @ compress.decompress_part(@r.d, data: got, most: r.m.size + 1)?
        else
            if r.m.method == zip_read.DEFLATED
                out @ compress.decompress_part(@r.d, data: [], most: r.m.size + 1)?

                if out.len() == 0 && !compress.is_done(r.d)
                    return codes.invalid_at(
                        at: r.at,
                        why: f"the deflated data of \"{r.m.name}\" ends before its stream does"
                    )

            if out.len() == 0
                r.ended @ true

                if r.made != r.m.size
                    return codes.invalid_at(
                        at: r.at,
                        why: f"the member \"{r.m.name}\" holds {r.made} bytes where its header says {r.m.size}"
                    )

                if to_i64(r.check.value).must() != r.m.crc
                    return codes.invalid_at(
                        at: r.at,
                        why: f"the member \"{r.m.name}\" has a CRC-32 of {to_i64(r.check.value).must()} where its header says {r.m.crc}"
                    )
                return ok([])

        if out.len() > 0
            hash.update32(@r.check, out)
            r.made @ r.made + out.len()

            if r.made > r.m.size
                return codes.invalid_at(
                    at: r.at,
                    why: f"the member \"{r.m.name}\" holds more than the {r.m.size} bytes its header says"
                )
            return ok(out)

    return ok([])

# Writes the member's data to `to`, its CRC-32 and size checked at its end.
# Fails as `next_chunk` does and as the stream fails.
function copy_member(@r: Reading, to: io.Stream) -> ()?
    while true
        got = next_chunk(@r)?

        if got.len() == 0
            return ok()
        io.write(to, data: got)?

    return ok()

# The member's data whole, its CRC-32 and size checked.
function read_member(@r: Reading) -> [u8]?
    out: [u8] @= []

    while true
        got = next_chunk(@r)?

        if got.len() == 0
            return ok(out)

        for b in got
            out @ out.push(b)

    return ok(out)
