# The runtime's thread doors, `hero_os.h`, bound thin: the floor of `threads`,
# in the header's order, each answering what C answers. spec § 13 states what
# crosses: one `i64`, or one `str` copied each way, and nothing else.
#
# The header is the runtime's, spec § 13's *threads, processes and files from
# the language's `hero_os.h`*, so this group names it and no `link`. A handle
# is the runtime's index of the thread, never a system thread. The runtime
# holds `hero_thread_limit()` threads at once and panics past them; it panics
# too on a handle joined twice, a handle it never gave, and a thread joined by
# the door of the other kind.

extern "hero_os.h"
    # Starts `body` on `arg` on a new thread with a stack of at least `bytes`,
    # 0 asking the runtime's own floor; -1 with the system's own number in
    # `why` where the system refuses.
    #
    # - `body`: the function the thread runs, once, on `arg`.
    # - `arg`: the one number handed to `body`.
    # - `bytes`: the least stack in bytes; 0 asks the runtime's own floor,
    #   below 0 panics.
    # - `why`: set to the system's own number where it refuses the thread.
    function hero_thread_spawn_sized(body: (function(i64) -> i64), arg: i64, bytes: i64, @why: i64) -> i64
    # Waits for a thread `hero_thread_spawn_sized` started and answers what
    # its body returned; the handle is spent.
    #
    # - `handle`: a thread `hero_thread_spawn_sized` started, joined once.
    function hero_thread_join(handle: i64) -> i64
    # Starts `body` on a copy of `arg` on a new thread with a stack of at
    # least `bytes`, 0 asking the runtime's own floor; -1 with the system's
    # own number in `why` where the system refuses.
    #
    # - `body`: the function the thread runs, once, on its copy of `arg`.
    # - `arg`: the text handed to `body`, its bytes copied.
    # - `bytes`: the least stack in bytes; 0 asks the runtime's own floor,
    #   below 0 panics.
    # - `why`: set to the system's own number where it refuses the thread.
    function hero_thread_spawn_str_sized(body: (function(str) -> str), arg: str, bytes: i64, @why: i64) -> i64
    # Waits for a thread `hero_thread_spawn_str_sized` started and answers a copy of
    # what its body returned; the handle is spent.
    #
    # - `handle`: a thread `hero_thread_spawn_str_sized` started, joined once.
    function hero_thread_join_str(handle: i64) -> str
    # How many threads the runtime holds at once.
    function hero_thread_limit() -> i64

# `hero_thread_spawn_sized`: `body` on `arg` on a stack of at least `bytes`,
# answering the handle, or -1 with the system's number in `why`.
#
# - `body`: the function the new thread runs, once, on `arg`; what it returns
#   is what `finish` answers.
# - `arg`: the one number handed to `body`.
# - `bytes`: the least stack the thread gets, in bytes; 0 asks for the
#   runtime's own floor, below 0 panics.
# - `why`: set to the operating system's own number where it refuses the
#   thread, and left as it was otherwise.
#
# The handle is the runtime's index of the thread, joined once by `finish`;
# past `limit` threads at once the runtime panics.
function start(body: (function(i64) -> i64), arg: i64, bytes: i64, @why: i64) -> i64
    return hero_thread_spawn_sized(body: body, arg: arg, bytes: bytes, why: @why)

# `hero_thread_join`: what the body of the thread `handle` returned.
#
# - `handle`: a thread `start` began, waited for here; it is spent. One
#   joined twice, one never given, or one `start_text` began panics.
function finish(handle: i64) -> i64
    return hero_thread_join(handle)

# `hero_thread_spawn_str_sized`: `body` on a copy of `arg` on a stack of at
# least `bytes`, answering the handle, or -1 with the system's number in
# `why`.
#
# - `body`: the function the new thread runs, once, on its copy of `arg`;
#   what it returns is copied back by `finish_text`.
# - `arg`: the text handed to `body`, its bytes copied here, so no block is
#   held by two threads.
# - `bytes`: the least stack the thread gets, in bytes; 0 asks for the
#   runtime's own floor, below 0 panics.
# - `why`: set to the operating system's own number where it refuses the
#   thread, and left as it was otherwise.
function start_text(body: (function(str) -> str), arg: str, bytes: i64, @why: i64) -> i64
    return hero_thread_spawn_str_sized(body: body, arg: arg, bytes: bytes, why: @why)

# `hero_thread_join_str`: a copy of what the body of the thread `handle`
# returned.
#
# - `handle`: a thread `start_text` began, waited for here; it is spent. One
#   joined twice, one never given, or one `start` began panics.
function finish_text(handle: i64) -> str
    return hero_thread_join_str(handle)

# `hero_thread_limit`: how many threads the runtime holds at once.
function limit() -> i64
    return hero_thread_limit()
