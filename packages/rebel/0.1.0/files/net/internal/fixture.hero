# What the face's tests share and a program never calls: the index of the
# machine's loopback interface, whether another program holds a port, a
# port where nothing listens, the connect defect 2623's test steers to the
# port the system gives next, and the connection a test's own client made,
# or how an accept no client of the test reaches ends, with another
# program's connection passed over (defect 2643), each through the face
# itself, which a private module may use since panel 252's R1.

use io
use net

# The index of the interface holding 127.0.0.1, the machine's loopback, 0
# where none is listed: what the tests join and send on, since it holds on
# any network.
function loopback_index() -> i64
    for i in net.interfaces().must()
        for n in i.addresses
            if i.loopback && n.host == net.loopback_v4()
                return i.index

    return 0

# Whether a socket other than the caller's holds `port` of the loopback
# address where a listen sees it: a listen there fails `exists` where a
# program of any user listens on that address, or one of another user on
# every address, as Tailscale's daemon, run as root, does on a Mac (defect
# 2623). A listener of the caller's own user on every address leaves the
# listen made on macOS, so this answers false for its port (macOS 27.2.1,
# measured 2026-11-21); a listener made is closed at once.
function held_elsewhere(port: i64) -> bool
    match net.listen("127.0.0.1", port: port)
        .ok l =>
            held @= l
            net.close_listener(@held).must()
            return false
        .err e => return e.code == net.EXISTS

# A port of the loopback address where nothing listens, for a test of what
# a connect there answers. A port a listener chose and let go is any
# program's at once, a connect's or a listener's, before the test's connect
# reaches it; this one lies from 20000 to 31999, below Linux's 32768 to 60999
# and macOS's and Windows' 49152 to 65535, so no system gives it to a socket
# of its own choosing, and is kept where a connect there is refused, so a
# listener of another program is passed over, on that address or on every
# address, which a listen on 127.0.0.1 does not see on macOS when the
# program is the same user's (measured 2026-11-21); a hundred draws at most.
# Each draw is the port the system gives a listener of this test, which no
# two sockets hold at once, carried one to one onto those 12,000 ports
# (7919, a prime, shares no factor with 12,000), so two copies of the tests
# at once draw two ports, and the draw needs no package but `net`.
function silent_port() -> i64
    tries @= 0

    while tries < 100
        tries @ tries + 1
        probe @= net.listen("127.0.0.1", port: 0).must()
        port = 20000 + probe.address.port * 7919 % 12000
        net.close_listener(@probe).must()

        match net.connect("127.0.0.1", port: port, deadline_ms: 10000)
            .ok c =>
                s @= c.stream

                match io.close(@s)
                    .ok _  => _ = 0
                    .err _ => _ = 0
            .err e =>
                if e.code == net.CLOSED
                    return port

    assert false
    return 0

# The connection `l` accepted from the test's own client, whose end stands
# at `client`, its every read and write ending by `deadline_ms` as
# `net.accept` sets it. A port of the loopback is any program's to connect
# to, and a test that steers its connect to the port the system gives next
# reaches a listener of another test that took it (defect 2643): such a
# connection is closed and passed over, ten at most. The client's own,
# once its connect is made, waits in the listener's queue behind those that
# came before it.
#
# Fails `failed` where ten connections of other programs came first, and as
# `net.accept` fails.
function accepted_from(l: net.Listener, client: net.Address, deadline_ms: i64) -> net.Conn?
    tries @= 0

    while tries < 10
        tries @ tries + 1
        c = net.accept(l, deadline_ms: deadline_ms)?

        if c.remote == client
            return ok(c)
        stranger @= c.stream

        match io.close(@stranger)
            .ok _  => _ = 0
            .err _ => _ = 0

    return fail(code: net.FAILED, msg: "accepting the test's own client: ten connections of other programs came first")

# The connection the test's own client made, whose end stands at `client`,
# as `net.accept_number` gives it up and `net.conn_of` takes it back with
# `deadline_ms`; another program's is taken back, closed and passed over,
# ten at most, as `accepted_from` says.
#
# Fails `failed` where ten connections of other programs came first, and as
# `net.accept_number` and `net.conn_of` fail.
function numbered_from(l: net.Listener, client: net.Address, deadline_ms: i64) -> net.Conn?
    tries @= 0

    while tries < 10
        tries @ tries + 1
        c = net.conn_of(n: net.accept_number(l)?, deadline_ms: deadline_ms)?

        if c.remote == client
            return ok(c)
        stranger @= c.stream

        match io.close(@stranger)
            .ok _  => _ = 0
            .err _ => _ = 0

    return fail(code: net.FAILED, msg: "accepting the test's own client: ten connections of other programs came first")

# How an accept on `l` ends where no client of the test connects: the code
# it fails with, `timeout` where the listener's deadline passed. A
# connection another program makes to the listener's port in that time is
# closed and passed over, ten at most, as `accepted_from` says; the
# deadline counts from when it was set, so passing one over does not move it.
function quiet_accept(l: net.Listener, deadline_ms: i64) -> str
    tries @= 0

    while tries < 10
        tries @ tries + 1

        match net.accept(l, deadline_ms: deadline_ms)
            .ok c =>
                stranger @= c.stream

                match io.close(@stranger)
                    .ok _  => _ = 0
                    .err _ => _ = 0
            .err e => return e.code

    return "ten connections of other programs came"

# One connect to the port the system gives next, where nothing of this test
# listens, and what it answered, for defect 2623's test: `closed` where it
# was refused as nothing listening there; `itself` where it was handed back
# connected to its own port, as Linux makes it; `elsewhere` where a socket
# of another program held the port before the connect or after a wrong
# answer, or where the connection made reached one from a port of its own;
# else the code and words of the wrong answer.
#
# A listener on port 0 shows the port the system gave last, and on macOS,
# which gives ports in order, the connect is given the next, the very port
# it connects to. A program that takes that port in the moment before the
# connect and lets it go before the witness after it leaves a wrong answer
# nothing explains, so the test asks again on one, as `tls`'s does, and
# tells the defect, which answered wrong on 500 tries of 500 before step
# 89a, by three in a row.
function steered() -> str
    l @= net.listen("127.0.0.1", port: 0).must()
    target = l.address.port + 1
    net.close_listener(@l).must()

    if target > 65535 || held_elsewhere(target)
        return "elsewhere"

    match net.connect("127.0.0.1", port: target, deadline_ms: 10000)
        .ok c =>
            s @= c.stream

            match io.close(@s)
                .ok _  => _ = 0
                .err _ => _ = 0

            if c.local.port == c.remote.port
                return "itself"
            return "elsewhere"
        .err e =>
            if e.code == net.CLOSED
                return "closed"

            if held_elsewhere(target)
                return "elsewhere"
            return e.code + ": " + e.msg

test "loopback_index: the interface named holds 127.0.0.1, or none is listed"
    index = loopback_index()

    if index != 0
        found: bool @= false

        for i in net.interfaces().must()
            if i.index == index
                found @ i.loopback

        assert found
