# What the face's tests share and a program never calls: the index of the
# machine's loopback interface, whether another program holds a port, a
# port where nothing listens, and the connect defect 2623's test steers to
# the port the system gives next, each through the face itself, which a
# private module may use since panel 252's R1.

use io
use net
use os

# The index of the interface holding 127.0.0.1, the machine's loopback, 0
# where none is listed: what the tests join and send on, since it holds on
# any network.
function loopback_index() -> i64
    for i in net.interfaces().must()
        for n in i.addresses
            if i.loopback && n.host == net.loopback_v4()
                return i.index

    return 0

# Whether a socket other than the caller's holds `port` of the loopback
# address: a listen there fails `exists`, as it does on macOS where another
# program listens on that address or on every address (the four listeners
# other programs held on a Mac, Tailscale's on every address among them,
# defect 2623); a listener made instead is closed at once.
function held_elsewhere(port: i64) -> bool
    match net.listen("127.0.0.1", port: port)
        .ok l =>
            held @= l
            net.close_listener(@held).must()
            return false
        .err e => return e.code == net.EXISTS

# A port of the loopback address where nothing listens, for a test of what
# a connect there answers. A port a listener chose and let go is any
# program's at once, a connect's or a listener's, before the test's connect
# reaches it; this one is drawn by the system's generator from 20000 to
# 31999, below Linux's 32768 to 60999 and macOS's and Windows' 49152 to
# 65535, so no system gives it to a socket of its own choosing, and kept
# where a connect there is refused, so a listener of another program is
# passed over, on that address or on every address, which a listen on
# 127.0.0.1 does not see on macOS when the program is the same user's
# (measured 2026-11-21); a hundred draws at most.
function silent_port() -> i64
    tries @= 0

    while tries < 100
        tries @ tries + 1
        drawn = os.random_bytes(2).must()
        port = 20000 + (drawn[0].to_i64().must() * 256 + drawn[1].to_i64().must()) % 12000

        match net.connect("127.0.0.1", port: port, deadline_ms: 10000)
            .ok c =>
                s @= c.stream

                match io.close(@s)
                    .ok _  => _ = 0
                    .err _ => _ = 0
            .err e =>
                if e.code == net.CLOSED
                    return port

    assert false
    return 0

# One connect to the port the system gives next, where nothing of this test
# listens, and what it answered, for defect 2623's test: `closed` where it
# was refused as nothing listening there; `itself` where it was handed back
# connected to its own port, as Linux makes it; `elsewhere` where a socket
# of another program held the port before the connect or after a wrong
# answer, or where the connection made reached one from a port of its own;
# else the code and words of the wrong answer.
#
# A listener on port 0 shows the port the system gave last, and on macOS,
# which gives ports in order, the connect is given the next, the very port
# it connects to. A program that takes that port in the moment before the
# connect and lets it go before the witness after it leaves a wrong answer
# nothing explains, so the test asks again on one, as `tls`'s does, and
# tells the defect, which answered wrong on 500 tries of 500 before step
# 89a, by three in a row.
function steered() -> str
    l @= net.listen("127.0.0.1", port: 0).must()
    target = l.address.port + 1
    net.close_listener(@l).must()

    if target > 65535 || held_elsewhere(target)
        return "elsewhere"

    match net.connect("127.0.0.1", port: target, deadline_ms: 10000)
        .ok c =>
            s @= c.stream

            match io.close(@s)
                .ok _  => _ = 0
                .err _ => _ = 0

            if c.local.port == c.remote.port
                return "itself"
            return "elsewhere"
        .err e =>
            if e.code == net.CLOSED
                return "closed"

            if held_elsewhere(target)
                return "elsewhere"
            return e.code + ": " + e.msg

test "loopback_index: the interface named holds 127.0.0.1, or none is listed"
    index = loopback_index()

    if index != 0
        found: bool @= false

        for i in net.interfaces().must()
            if i.index == index
                found @ i.loopback

        assert found
