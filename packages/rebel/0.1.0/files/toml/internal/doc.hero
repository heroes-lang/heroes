# A TOML 1.0.0 document read into an arena of nodes, the root table first:
# headers, arrays of tables, keys bare, quoted and dotted, arrays and inline
# tables. A table remembers how it was defined, so that the rules of
# definition hold as Python's tomllib holds them: a header names a table
# once; a dotted key adds no key to a table a header defined, nor, past the
# next header, to one it defined itself; an inline table and an array written
# as a value take nothing more. Nesting deeper than `MAX_DEPTH` fails, so no
# walk of a document follows it down the machine's stack.

use strings
use toml/internal/scalar

# The deepest a value may stand below the root: the keys of its path, and the
# arrays and inline tables around it, counted together.
constant MAX_DEPTH: i64
    512

# One table, array or value of a document.
record Node
    # `scalar.TABLE`, `scalar.ARRAY`, or the kind of a value.
    kind: i64
    # A table's keys, in the order first defined.
    keys: [str]
    # A table's members, in the order of `keys`, or an array's items: indices
    # into the arena.
    children: [i64]
    # A value's own payload.
    value: scalar.Lexed
    # Whether a header, or a dotted key in a section now closed, defined the
    # table, so that no header may define it again.
    explicit: bool
    # Whether it was written whole as a value, an inline table or an array,
    # so that nothing may add to it.
    frozen: bool
    # Whether it is an array that headers `[[...]]` made.
    of_tables: bool
    # How deep it stands below the root, which is 0.
    depth: i64

# An empty table or array of `kind` at `depth`.
function container(kind: i64, depth: i64) -> Node
    return Node(
        kind: kind,
        keys: [],
        children: [],
        value: scalar.lexed(kind: kind, end: 0),
        explicit: false,
        frozen: false,
        of_tables: false,
        depth: depth
    )

# The keys of `first`, then those of `then`.
function joined(first: [str], then: [str]) -> [str]
    all_keys @= first

    for key in then
        all_keys @ all_keys.push(key)

    return all_keys

# A key path as a message writes it: its keys joined by dots.
function dotted(path: [str]) -> str
    return path.join(".")

# Where the member `key` of the table `table` stands in the arena. Fails
# `invalid` where it holds none.
function member(nodes: [Node] lent, table: i64, key: str) -> i64?
    names = nodes[table].keys

    for at in range(from: 0, to: names.len())
        if names[at] == key
            return ok(nodes[table].children[at])

    return fail(code: scalar.INVALID, msg: "no member")

# Adds `node` to the arena as the member `key` of `table`, and answers where
# it stands. Fails `invalid` where it stands deeper than `MAX_DEPTH`.
function add_member(@nodes: [Node], table: i64, key: str, node: Node, text: str, at: i64) -> i64?
    if node.depth > MAX_DEPTH
        return scalar.wrong(text: text, at: at, what: f"nesting deeper than {MAX_DEPTH} levels")
    nodes @ nodes.push(node)
    index = nodes.len() - 1
    nodes[table].keys @ nodes[table].keys.push(key)
    nodes[table].children @ nodes[table].children.push(index)
    return ok(index)

# Moves `at` past the spaces and tabs there.
function skip_spaces(text: str, @at: i64)
    while at < text.len() && (text[at] == ' ' || text[at] == '\t')
        at @ at + 1

# Moves `at`, a `#`, to the line end that ends the comment. Fails `invalid` at
# a control character inside it.
function skip_comment(text: str, @at: i64) -> ()?
    while at < text.len() && text[at] != '\n'
        if scalar.is_control(text[at]) && scalar.line_end_len(text, at) == 0
            return scalar.wrong(text: text, at: at, what: "a control character inside a comment")
        at @ at + 1

    return ok()

# Moves `at` past the spaces, a comment and the line end that end a
# statement. Fails `invalid` where anything else stands there.
function end_line(text: str, @at: i64) -> ()?
    skip_spaces(text, @at)

    if at < text.len() && text[at] == '#'
        skip_comment(text, @at)?

    if at >= text.len()
        return ok()
    width = scalar.line_end_len(text, at)

    if width == 0
        shown = text.slice(from: at, to: strings.ceil_boundary(s: text, at: at + 1))
        return scalar.wrong(text: text, at: at, what: f"expected the end of the line, found \"{shown}\"")
    at @ at + width
    return ok()

# Moves `at` past the spaces, comments and line ends between an array's
# items.
function skip_blank(text: str, @at: i64) -> ()?
    while true
        skip_spaces(text, @at)

        if at < text.len() && text[at] == '#'
            skip_comment(text, @at)?
        width = scalar.line_end_len(text, at)

        if width == 0
            return ok()
        at @ at + width

    return ok()

# Whether `b` may stand in a bare key: an ASCII letter or digit, `_`, `-`.
function is_bare(b: u8) -> bool
    return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_' || b == '-'

# The one key at `at`: bare, or a string of one line.
function read_simple_key(text: str, @at: i64) -> str?
    start = at

    if at < text.len() && (text[at] == '"' || text[at] == '\'')
        if scalar.holds(text: text, at: at, want: "\"\"\"") || scalar.holds(text: text, at: at, want: "'''")
            return scalar.wrong(text: text, at: at, what: "a key may not be a string of several lines")
        s = scalar.read_string(text, at)?
        at @ s.end
        return ok(s.text)

    while at < text.len() && is_bare(text[at])
        at @ at + 1

    if at == start
        shown = text.slice(from: at, to: strings.ceil_boundary(s: text, at: at + 1))
        return scalar.wrong(text: text, at: at, what: f"expected a key, found \"{shown}\"")
    return ok(text.slice(from: start, to: at))

# The key at `at`, its parts split at dots, spaces allowed around them.
function read_key(text: str, @at: i64) -> [str]?
    if at >= text.len()
        return scalar.wrong(text: text, at: at, what: "expected a key")
    parts: [str] @= [read_simple_key(text, @at)?]

    while true
        mark = at
        skip_spaces(text, @at)

        if at < text.len() && text[at] == '.'
            at @ at + 1
            skip_spaces(text, @at)
            parts @ parts.push(read_simple_key(text, @at)?)
        else
            at @ mark
            return ok(parts)

    return ok(parts)

# Places the value at `value` under the dotted key `path` of the inline table
# `table`, making the tables between.
function place_inline(@nodes: [Node], table: i64, path: [str], value: i64, text: str, at: i64) -> ()?
    t @= table

    for k in range(from: 0, to: path.len() - 1)
        match member(nodes, t, path[k])
            .ok c =>
                if nodes[c].kind != scalar.TABLE || nodes[c].frozen
                    return scalar.wrong(
                        text: text,
                        at: at,
                        what: f"\"{dotted(path.slice(from: 0, to: k + 1))}\" is defined already, as a value"
                    )
                t @ c
            .err _ => t @ add_member(@nodes, table: t, key: path[k], node: container(kind: scalar.TABLE, depth: nodes[t].depth + 1), text: text, at: at)?

    last = path[path.len() - 1]

    if !member(nodes, t, last).is_err()
        return scalar.wrong(text: text, at: at, what: f"the key \"{dotted(path)}\" is defined twice in an inline table")
    nodes[t].keys @ nodes[t].keys.push(last)
    nodes[t].children @ nodes[t].children.push(value)
    return ok()

# The key at `at` of an inline table and the `=` after it, white space
# skipped on either side. Fails `invalid` at a line end, which TOML 1.0.0
# refuses inside an inline table.
function read_inline_key(text: str, @at: i64) -> [str]?
    if scalar.line_end_len(text, at) > 0 || at < text.len() && text[at] == '#'
        return scalar.wrong(text: text, at: at, what: "a line end inside an inline table, which TOML 1.0.0 refuses")
    path = read_key(text, @at)?
    skip_spaces(text, @at)

    if at >= text.len() || text[at] != '='
        return scalar.wrong(text: text, at: at, what: "expected \"=\" after a key")
    at @ at + 1
    skip_spaces(text, @at)
    return ok(path)

# The value at `at`, added to the arena at `depth`; answers where it stands.
# The arrays and inline tables open around the value being read wait on a
# stack this function holds, so that no nesting reaches the machine's stack.
function read_value(text: str, @at: i64, @nodes: [Node], depth: i64) -> i64?
    # The arrays and inline tables open around the value being read, the
    # innermost last: where each stands in the arena and, for an inline
    # table, the key its next value is read for and where that key began.
    open: [i64] @= []
    paths: [[str]] @= []
    key_ats: [i64] @= []

    # The items of the innermost open container, and those of the ones
    # around it.
    items: [i64] @= []
    held: [[i64]] @= []

    # How deep the value about to be read stands.
    here @= depth

    while true
        if here > MAX_DEPTH
            return scalar.wrong(text: text, at: at, what: f"nesting deeper than {MAX_DEPTH} levels")

        # The value just finished, where one is: its place in the arena.
        done: i64 @= -1

        if at < text.len() && (text[at] == '[' || text[at] == '{')
            array = text[at] == '['
            kind: i64 @= scalar.TABLE

            if array
                kind @ scalar.ARRAY
            nodes @ nodes.push(container(kind: kind, depth: here))
            index = nodes.len() - 1
            open @ open.push(index)
            paths @ paths.push([])
            key_ats @ key_ats.push(0)
            held @ held.push(items)
            items @ []
            at @ at + 1

            if array
                skip_blank(text, @at)?

                if at < text.len() && text[at] == ']'
                    at @ at + 1
                    done @ index
                else
                    here @ here + 1
            else
                skip_spaces(text, @at)

                if at < text.len() && text[at] == '}'
                    at @ at + 1
                    done @ index
                else
                    key_at = at
                    path = read_inline_key(text, @at)?
                    paths[paths.len() - 1] @ path
                    key_ats[key_ats.len() - 1] @ key_at
                    here @ here + path.len()
        else
            v = scalar.read_scalar(text, at)?
            at @ v.end
            nodes @ nodes.push(
                Node(kind: v.kind, keys: [], children: [], value: v, explicit: false, frozen: false, of_tables: false, depth: here)
            )
            done @ nodes.len() - 1

        # Hands the value finished to the container around it, closing each
        # container it completes, until one waits for another value.
        while done >= 0
            if open.len() == 0
                return ok(done)
            top = open.len() - 1
            t = open[top]
            closing: bool @= false

            if done == t
                closing @ true
            else if nodes[t].kind == scalar.ARRAY
                items @ items.push(done)
                skip_blank(text, @at)?

                if at < text.len() && text[at] == ','
                    at @ at + 1
                    skip_blank(text, @at)?

                    if at < text.len() && text[at] == ']'
                        at @ at + 1
                        closing @ true
                    else
                        here @ nodes[t].depth + 1
                        done @ -1
                else if at < text.len() && text[at] == ']'
                    at @ at + 1
                    closing @ true
                else
                    return scalar.wrong(text: text, at: at, what: "expected \",\" or \"]\" in an array")
            else
                place_inline(@nodes, table: t, path: paths[top], value: done, text: text, at: key_ats[top])?
                skip_spaces(text, @at)

                if at < text.len() && text[at] == ','
                    at @ at + 1
                    skip_spaces(text, @at)

                    if at < text.len() && text[at] == '}'
                        return scalar.wrong(
                            text: text,
                            at: at,
                            what: "a comma before the end of an inline table, which TOML 1.0.0 refuses"
                        )
                    key_at = at
                    path = read_inline_key(text, @at)?
                    paths[top] @ path
                    key_ats[top] @ key_at
                    here @ nodes[t].depth + path.len()
                    done @ -1
                else if at < text.len() && text[at] == '}'
                    at @ at + 1
                    closing @ true
                else if scalar.line_end_len(text, at) > 0 || at < text.len() && text[at] == '#'
                    return scalar.wrong(
                        text: text,
                        at: at,
                        what: "a line end inside an inline table, which TOML 1.0.0 refuses"
                    )
                else
                    return scalar.wrong(text: text, at: at, what: "expected \",\" or \"}\" in an inline table")

            if closing
                if nodes[t].kind == scalar.ARRAY
                    nodes[t].children @ items
                nodes[t].frozen @ true
                items @ held[top]
                held @ held.slice(from: 0, to: top)
                open @ open.slice(from: 0, to: top)
                paths @ paths.slice(from: 0, to: top)
                key_ats @ key_ats.slice(from: 0, to: top)
                done @ t

    return ok(-1)

# What `open_header` answers.
record Opened
    # Where the table opened stands in the arena.
    table: i64
    # Its path from the root, as the header wrote it.
    path: [str]

# The table the header at `at` opens, `[a.b]`, or with `of_tables` the new
# element of the array of tables `[[a.b]]`, made where it is not there.
function open_header(text: str, @at: i64, @nodes: [Node], of_tables: bool) -> Opened?
    start = at

    if of_tables
        at @ at + 2
    else
        at @ at + 1
    skip_spaces(text, @at)
    path = read_key(text, @at)?
    skip_spaces(text, @at)
    close: str @= "]"

    if of_tables
        close @ "]]"

    if !scalar.holds(text: text, at: at, want: close)
        return scalar.wrong(text: text, at: at, what: f"expected \"{close}\" to close the header")
    at @ at + close.len()
    t @= 0

    for k in range(from: 0, to: path.len() - 1)
        so_far = dotted(path.slice(from: 0, to: k + 1))

        match member(nodes, t, path[k])
            .ok c =>
                if nodes[c].frozen
                    return scalar.wrong(
                        text: text,
                        at: start,
                        what: f"\"{so_far}\" was written whole as a value, and nothing may add to it"
                    )

                if nodes[c].kind == scalar.ARRAY
                    t @ nodes[c].children[nodes[c].children.len() - 1]
                else if nodes[c].kind == scalar.TABLE
                    t @ c
                else
                    return scalar.wrong(text: text, at: start, what: f"\"{so_far}\" is a value, not a table")
            .err _ => t @ add_member(@nodes, table: t, key: path[k], node: container(kind: scalar.TABLE, depth: nodes[t].depth + 1), text: text, at: start)?

    last = path[path.len() - 1]
    whole = dotted(path)

    match member(nodes, t, last)
        .ok c =>
            if nodes[c].frozen
                return scalar.wrong(
                    text: text,
                    at: start,
                    what: f"\"{whole}\" was written whole as a value, and nothing may add to it"
                )

            if of_tables
                if !nodes[c].of_tables
                    return scalar.wrong(
                        text: text,
                        at: start,
                        what: f"\"{whole}\" is defined already, and not as an array of tables"
                    )
                element = container(kind: scalar.TABLE, depth: nodes[c].depth + 1)
                nodes @ nodes.push(element)
                index = nodes.len() - 1
                nodes[index].explicit @ true
                nodes[c].children @ nodes[c].children.push(index)
                return ok(Opened(table: index, path: path))

            if nodes[c].kind != scalar.TABLE || nodes[c].explicit
                return scalar.wrong(text: text, at: start, what: f"the table \"{whole}\" is defined already")
            nodes[c].explicit @ true
            return ok(Opened(table: c, path: path))
        .err _ => _ = 0

    if of_tables
        array @= container(kind: scalar.ARRAY, depth: nodes[t].depth + 1)
        array.of_tables @ true
        array.explicit @ true
        a = add_member(@nodes, table: t, key: last, node: array, text: text, at: start)?
        element @= container(kind: scalar.TABLE, depth: nodes[a].depth + 1)
        element.explicit @ true
        nodes @ nodes.push(element)
        index = nodes.len() - 1
        nodes[a].children @ [index]
        return ok(Opened(table: index, path: path))
    made @= container(kind: scalar.TABLE, depth: nodes[t].depth + 1)
    made.explicit @ true
    made_at = add_member(@nodes, table: t, key: last, node: made, text: text, at: start)?
    return ok(Opened(table: made_at, path: path))

# Reads the key and value at `at` into the table `table`; the tables its
# dotted key passes through join `pending`, defined once the next header
# opens.
function read_pair(text: str, @at: i64, @nodes: [Node], table: i64, prefix: [str], @pending: [i64]) -> ()?
    start = at
    path = read_key(text, @at)?
    skip_spaces(text, @at)

    if at >= text.len() || text[at] != '='
        return scalar.wrong(text: text, at: at, what: "expected \"=\" after a key")
    at @ at + 1
    skip_spaces(text, @at)
    value = read_value(text: text, at: @at, nodes: @nodes, depth: nodes[table].depth + path.len())?
    t @= table

    for k in range(from: 0, to: path.len() - 1)
        so_far = dotted(joined(first: prefix, then: path.slice(from: 0, to: k + 1)))

        match member(nodes, t, path[k])
            .ok c =>
                if nodes[c].frozen
                    return scalar.wrong(
                        text: text,
                        at: start,
                        what: f"\"{so_far}\" was written whole as a value, and nothing may add to it"
                    )

                if nodes[c].kind != scalar.TABLE
                    return scalar.wrong(text: text, at: start, what: f"\"{so_far}\" is a value, not a table")

                if nodes[c].explicit
                    return scalar.wrong(
                        text: text,
                        at: start,
                        what: f"the table \"{so_far}\" is defined already, so a dotted key may not add to it"
                    )
                t @ c
            .err _ => t @ add_member(@nodes, table: t, key: path[k], node: container(kind: scalar.TABLE, depth: nodes[t].depth + 1), text: text, at: start)?

        pending @ pending.push(t)

    last = path[path.len() - 1]

    if !member(nodes, t, last).is_err()
        return scalar.wrong(
            text: text,
            at: start,
            what: f"the key \"{dotted(joined(first: prefix, then: path))}\" is defined already"
        )
    nodes[t].keys @ nodes[t].keys.push(last)
    nodes[t].children @ nodes[t].children.push(value)
    return ok()

# Every node of the document `text`, the root table first. Fails `invalid`,
# the message opening `line L, column C:`, where `text` is not TOML 1.0.0,
# and `does_not_fit` where an integer is past an `i64`.
function parse_document(text: str) -> [Node]?
    root @= container(kind: scalar.TABLE, depth: 0)
    root.explicit @ true
    nodes: [Node] @= [root]
    current: i64 @= 0
    prefix: [str] @= []
    pending: [i64] @= []
    at @= 0

    while at < text.len()
        skip_spaces(text, @at)

        if at >= text.len()
            break
        b = text[at]

        if b == '#' || scalar.line_end_len(text, at) > 0
            end_line(text, @at)?
        else if b == '['
            for p in pending
                nodes[p].explicit @ true

            pending @ []
            of_tables = scalar.holds(text: text, at: at, want: "[[")
            opened = open_header(text, @at, @nodes, of_tables)?
            current @ opened.table
            prefix @ opened.path
            end_line(text, @at)?
        else
            read_pair(text, at: @at, nodes: @nodes, table: current, prefix: prefix, pending: @pending)?
            end_line(text, @at)?

    return ok(nodes)

# The node at `at` of `nodes` written as a test reads it: a table as its keys
# and members in braces, an array in brackets, a value by its payload.
function shape(nodes: [Node], at: i64) -> str
    n = nodes[at]

    if n.kind == scalar.TABLE
        parts: [str] @= []

        for k in range(from: 0, to: n.keys.len())
            parts @ parts.push(n.keys[k] + "=" + shape(nodes, n.children[k]))

        return "{" + parts.join(",") + "}"

    if n.kind == scalar.ARRAY
        parts: [str] @= []

        for c in n.children
            parts @ parts.push(shape(nodes, c))

        return "[" + parts.join(",") + "]"

    if n.kind == scalar.TEXT
        return "'" + n.value.text + "'"

    if n.kind == scalar.INTEGER
        return f"{n.value.integer}"

    if n.kind == scalar.BOOLEAN
        return f"{n.value.flag}"
    return f"#{n.kind}"

# The document `text` as `shape` writes its root, or the failure's message.
function read_shape(text: str) -> str
    match parse_document(text)
        .ok nodes => return shape(nodes, 0)
        .err e    => return e.msg

test "parse_document: tables, a super-table defined after its child, arrays of tables and their sub-tables, as tomllib reads them"
    assert read_shape("[a.b.c]\nx=1\n[a]\ny=2") == "{a={b={c={x=1}},y=2}}"
    assert read_shape("[[a]]\nx=1\n[[a]]\nx=2\n[a.b]\ny=3") == "{a=[{x=1},{x=2,b={y=3}}]}"
    assert read_shape("[a]\n[a.b]\n[a.b.c]\n[a.b.c.d]\nx=1") == "{a={b={c={d={x=1}}}}}"
    assert read_shape("a=true # c\n\n\n[b] # c\n") == "{a=true,b={}}"
    assert read_shape("a = 1\n[ b ]\nc = 2\n") == "{a=1,b={c=2}}"
    assert read_shape("") == "{}"

test "parse_document: keys bare, quoted, dotted with spaces, empty and numeric, as tomllib reads them"
    assert read_shape("\"quoted key\"=1\n'lit.key'=2\na . b = 3\n\"\" = 4") == "{quoted key=1,lit.key=2,a={b=3},=4}"
    assert read_shape("[ a . \"b c\" ]\nx=1") == "{a={b c={x=1}}}"
    assert read_shape("\"a.b\"=1\na.b=2") == "{a.b=1,a={b=2}}"
    assert read_shape("1234=1\n-_=2\n1.5=3") == "{1234=1,-_=2,1={5=3}}"
    assert read_shape("a.\"b\".c=1") == "{a={b={c=1}}}"

test "parse_document: dotted keys extend their own tables and those a header made on the way, and nothing else"
    assert read_shape("[a]\nb.c=1\n[a.b.e]\nd=2") == "{a={b={c=1,e={d=2}}}}"
    assert read_shape("[a.b.c]\nx=1\n[a]\nb.d=1") == "{a={b={c={x=1},d=1}}}"
    assert read_shape("a.b=1\na.c=2") == "{a={b=1,c=2}}"
    assert read_shape("[a.b]\nx=1\n[a]\nb.y=2") == "line 4, column 1: the table \"a.b\" is defined already, so a dotted key may not add to it"
    assert read_shape("[a]\nb.c=1\n[a.b]\nd=2") == "line 3, column 1: the table \"a.b\" is defined already"
    assert read_shape("[a]\nb.c.d=1\n[a.b.c]") == "line 3, column 1: the table \"a.b.c\" is defined already"
    assert read_shape("a.b=1\n[a]\nc=2") == "line 2, column 1: the table \"a\" is defined already"

test "parse_document: a table, a key or an array of tables defined twice, and a value used as a table"
    assert read_shape("[a]\nx=1\n[a]") == "line 3, column 1: the table \"a\" is defined already"
    assert read_shape("x=1\nx=2") == "line 2, column 1: the key \"x\" is defined already"
    assert read_shape("a.b=1\na.b.c=2") == "line 2, column 1: \"a.b\" is a value, not a table"
    assert read_shape("[[a]]\n[a]") == "line 2, column 1: the table \"a\" is defined already"
    assert read_shape("[a]\n[[a]]") == "line 2, column 1: \"a\" is defined already, and not as an array of tables"
    assert read_shape("a=1\n[a.b]") == "line 2, column 1: \"a\" is a value, not a table"
    assert read_shape("[[a]]\nb.c=1\n[a.b]") == "line 3, column 1: the table \"a.b\" is defined already"

test "parse_document: inline tables and arrays written whole take nothing more"
    assert read_shape("a={x=1}\na.y=2") == "line 2, column 1: \"a\" was written whole as a value, and nothing may add to it"
    assert read_shape("a=[1]\n[[a]]") == "line 2, column 1: \"a\" was written whole as a value, and nothing may add to it"
    assert read_shape("a = { b = 1 }\n[a.c]") == "line 2, column 1: \"a\" was written whole as a value, and nothing may add to it"
    assert read_shape("a=[{x=1}]\n[[a]]") == "line 2, column 1: \"a\" was written whole as a value, and nothing may add to it"

test "parse_document: inline tables, dotted keys inside, and the commas and line ends TOML 1.0.0 refuses"
    assert read_shape("a = { x = 1, y.z = 2 }") == "{a={x=1,y={z=2}}}"
    assert read_shape("a={}") == "{a={}}"
    assert read_shape("a = { x = 1, }") == "line 1, column 14: a comma before the end of an inline table, which TOML 1.0.0 refuses"
    assert read_shape("a = { x = 1,\n y = 2 }") == "line 1, column 13: a line end inside an inline table, which TOML 1.0.0 refuses"
    assert read_shape("a = { x = 1, x = 2 }") == "line 1, column 14: the key \"x\" is defined twice in an inline table"
    assert read_shape("a = { x = 1, x.y = 2 }") == "line 1, column 14: \"x\" is defined already, as a value"

test "parse_document: arrays across lines with comments, a trailing comma, nested, empty, and broken"
    assert read_shape("a = [\n  1, # one\n  2,\n]") == "{a=[1,2]}"
    assert read_shape("a=[[1,2],[\"a\"]]") == "{a=[[1,2],['a']]}"
    assert read_shape("a = [ ]") == "{a=[]}"
    assert read_shape("a = [,]") == "line 1, column 6: expected a value, found \",\""
    assert read_shape("a = [1 2]") == "line 1, column 8: expected \",\" or \"]\" in an array"
    assert read_shape("a = [1") == "line 1, column 7: expected \",\" or \"]\" in an array"

test "parse_document: statements that are not TOML: two on a line, no value, no key, a header left open, a lone CR"
    assert read_shape("a=1 b=2") == "line 1, column 5: expected the end of the line, found \"b\""
    assert read_shape("k = ") == "line 1, column 5: expected a value"
    assert read_shape(" = 1") == "line 1, column 2: expected a key, found \"=\""
    assert read_shape("[a]]") == "line 1, column 4: expected the end of the line, found \"]\""
    assert read_shape("[a") == "line 1, column 3: expected \"]\" to close the header"
    assert read_shape("a=1\rb=2") == "line 1, column 4: expected the end of the line, found \"\r\""
    assert read_shape("# c\u{1}\na=1") == "line 1, column 4: a control character inside a comment"
    assert read_shape("a=1\r\nb=2\r\n") == "{a=1,b=2}"
    assert read_shape("\"\"\"k\"\"\"=1") == "line 1, column 1: a key may not be a string of several lines"

test "parse_document: nesting past the most allowed refused, at the edge read"
    assert !parse_document("a=" + repeat("[", 512) + repeat("]", 512)).is_err()
    assert read_shape("a=" + repeat("[", 513) + repeat("]", 513)) == "line 1, column 515: nesting deeper than 512 levels"

test "parse_document: inline tables nested to the edge, and arrays and tables mixed, read without the machine's stack"
    assert !parse_document("a=" + repeat("{b=", 511) + "1" + repeat("}", 511)).is_err()
    assert read_shape("a=" + repeat("{b=", 512) + "1" + repeat("}", 512)) == "line 1, column 1539: nesting deeper than 512 levels"
    assert read_shape("a=[{b=[1, {c=[]}]}, [[2]]]") == "{a=[{b=[1,{c=[]}]},[[2]]]}"
