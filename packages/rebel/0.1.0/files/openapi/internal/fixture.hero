# The documents the tests of `openapi` read: a store of pets in YAML, the
# same text the reference libraries were asked about (openapi-core 0.23.1 for
# requests and responses, openapi-spec-validator 0.8.5 for the document), and
# one operation for each parameter style, asked of kin-openapi 0.153.0.

use bytes
use http

# The store of pets, YAML.
function pets_yaml() -> str
    lines = [
        "openapi: 3.1.0"
        "info:"
        "  title: Pets"
        "  version: 1.0.0"
        "servers:"
        "  - url: https://api.example.com/v1"
        "paths:"
        "  /pets:"
        "    get:"
        "      operationId: listPets"
        "      parameters:"
        "        - name: limit"
        "          in: query"
        "          schema: {type: integer, minimum: 1, maximum: 100, default: 20}"
        "        - name: tags"
        "          in: query"
        "          schema: {type: array, items: {type: string}}"
        "        - name: ids"
        "          in: query"
        "          style: form"
        "          explode: false"
        "          schema: {type: array, items: {type: integer}}"
        "        - name: color"
        "          in: query"
        "          style: deepObject"
        "          explode: true"
        "          schema: {type: object, properties: {R: {type: integer}, G: {type: integer}}}"
        "        - name: words"
        "          in: query"
        "          style: spaceDelimited"
        "          explode: false"
        "          schema: {type: array, items: {type: string}}"
        "        - name: pipes"
        "          in: query"
        "          style: pipeDelimited"
        "          explode: false"
        "          schema: {type: array, items: {type: integer}}"
        "        - name: flag"
        "          in: query"
        "          allowEmptyValue: true"
        "          schema: {type: string}"
        "        - name: X-Request-Ids"
        "          in: header"
        "          schema: {type: array, items: {type: integer}}"
        "        - name: session"
        "          in: cookie"
        "          schema: {type: string, minLength: 3}"
        "      responses:"
        "        \"200\":"
        "          description: The pets"
        "          headers:"
        "            X-Total:"
        "              required: true"
        "              schema: {type: integer}"
        "          content:"
        "            application/json:"
        "              schema: {type: array, items: {$ref: \"#/components/schemas/Pet\"}}"
        "        default:"
        "          description: An error"
        "          content:"
        "            application/json:"
        "              schema: {$ref: \"#/components/schemas/Error\"}"
        "    post:"
        "      operationId: createPet"
        "      security:"
        "        - key: []"
        "        - bearer: []"
        "      requestBody:"
        "        required: true"
        "        content:"
        "          application/json:"
        "            schema: {$ref: \"#/components/schemas/NewPet\"}"
        "          application/x-www-form-urlencoded:"
        "            schema: {$ref: \"#/components/schemas/NewPet\"}"
        "      responses:"
        "        \"201\":"
        "          description: Created"
        "  /pets/{petId}:"
        "    parameters:"
        "      - name: petId"
        "        in: path"
        "        required: true"
        "        schema: {type: integer, minimum: 1}"
        "    get:"
        "      operationId: showPetById"
        "      responses:"
        "        \"200\":"
        "          description: The pet"
        "          content:"
        "            application/json:"
        "              schema: {$ref: \"#/components/schemas/Pet\"}"
        "  /pets/mine:"
        "    get:"
        "      operationId: myPets"
        "      responses:"
        "        \"200\":"
        "          description: Mine"
        "  /labels/{ids}:"
        "    get:"
        "      operationId: labels"
        "      parameters:"
        "        - name: ids"
        "          in: path"
        "          required: true"
        "          style: label"
        "          explode: true"
        "          schema: {type: array, items: {type: integer}}"
        "      responses:"
        "        \"204\":"
        "          description: Nothing"
        "  /matrix/{point}:"
        "    get:"
        "      operationId: matrix"
        "      parameters:"
        "        - name: point"
        "          in: path"
        "          required: true"
        "          style: matrix"
        "          explode: true"
        "          schema: {type: object, properties: {x: {type: integer}, y: {type: integer}}}"
        "      responses:"
        "        \"204\":"
        "          description: Nothing"
        "components:"
        "  schemas:"
        "    Pet:"
        "      type: object"
        "      required: [id, name]"
        "      properties:"
        "        id: {type: integer}"
        "        name: {type: string}"
        "        tag: {type: string}"
        "    NewPet:"
        "      type: object"
        "      required: [name]"
        "      properties:"
        "        name: {type: string, minLength: 1}"
        "        age: {type: integer, minimum: 0}"
        "    Error:"
        "      type: object"
        "      required: [message]"
        "      properties:"
        "        message: {type: string}"
        "  securitySchemes:"
        "    key: {type: apiKey, in: header, name: X-API-Key}"
        "    bearer: {type: http, scheme: bearer}"
    ]
    return lines.join("\n")

# One operation for each style, YAML.
function styles_yaml() -> str
    lines = [
        "openapi: 3.1.0"
        "info: {title: t, version: \"1\"}"
        "paths:"
        "  /labels/{ids}:"
        "    get:"
        "      parameters:"
        "        - {name: ids, in: path, required: true, style: label, explode: true, schema: {type: array, maxItems: 3, items: {type: integer}}}"
        "      responses: {\"204\": {description: x}}"
        "  /labelc/{ids}:"
        "    get:"
        "      parameters:"
        "        - {name: ids, in: path, required: true, style: label, explode: false, schema: {type: array, maxItems: 3, items: {type: integer}}}"
        "      responses: {\"204\": {description: x}}"
        "  /matrix/{point}:"
        "    get:"
        "      parameters:"
        "        - {name: point, in: path, required: true, style: matrix, explode: true, schema: {type: object, required: [x, y], additionalProperties: false, properties: {x: {type: integer}, y: {type: integer}}}}"
        "      responses: {\"204\": {description: x}}"
        "  /matrixa/{ids}:"
        "    get:"
        "      parameters:"
        "        - {name: ids, in: path, required: true, style: matrix, explode: false, schema: {type: array, maxItems: 3, items: {type: integer}}}"
        "      responses: {\"204\": {description: x}}"
        "  /simple/{ids}:"
        "    get:"
        "      parameters:"
        "        - {name: ids, in: path, required: true, schema: {type: array, maxItems: 3, items: {type: integer}}}"
        "      responses: {\"204\": {description: x}}"
        "  /q:"
        "    get:"
        "      parameters:"
        "        - {name: words, in: query, style: spaceDelimited, explode: false, schema: {type: array, items: {type: string, maxLength: 1}}}"
        "        - {name: pipes, in: query, style: pipeDelimited, explode: false, schema: {type: array, items: {type: integer}}}"
        "        - {name: obj, in: query, style: form, explode: false, schema: {type: object, additionalProperties: false, properties: {a: {type: integer}, b: {type: string}}}}"
        "        - {name: h, in: header, explode: true, schema: {type: object, additionalProperties: false, properties: {a: {type: integer}, b: {type: string}}}}"
        "      responses: {\"204\": {description: x}}"
    ]
    return lines.join("\n")

# A document of `paths` and `components`, each a list of YAML lines written
# as they stand under those fields.
function doc_of(paths: [str], components: [str]) -> str
    lines: [str] @= ["openapi: 3.1.0", "info: {title: t, version: \"1\"}", "paths:"]

    for line in paths
        lines @ lines.push("  " + line)

    if paths.len() == 0
        lines @ lines.push("  {}")

    if components.len() > 0
        lines @ lines.push("components:")

        for line in components
            lines @ lines.push("  " + line)
    return lines.join("\n")

# A request of `method` to `target`, with no field and no body.
function request(method: str, target: str) -> http.Request
    return http.request(method: method, target: target).must()

# `r` with the header field `name` set to `value`.
function with_field(r: http.Request, name: str, value: str) -> http.Request
    out @= r
    fields @= r.headers
    fields @ fields.push(http.Header(name: name, value: value))
    out.headers @ fields
    return out

# `r` with the body `body` of the type `content_type`.
function with_text_body(r: http.Request, content_type: str, body: str) -> http.Request
    return http.with_body(r, content_type: content_type, body: bytes.from_text(body))

# A response of `status` whose body is `body` of the type `content_type`.
function response(status: i64, content_type: str, body: str) -> http.Response
    return http.respond(status, content_type: content_type, body: bytes.from_text(body))

# A document of every object OpenAPI 3.1 has, each once or more, extensions
# included: openapi-spec-validator 0.8.5 finds it valid but for its link's
# `server`, which the specification names and its schema of 2022-10-07 does
# not.
function full_yaml() -> str
    lines = [
        "openapi: 3.1.1"
        "info:"
        "  title: Full"
        "  summary: Every object"
        "  description: All of them"
        "  termsOfService: https://example.com/terms"
        "  contact: {name: Ann, url: \"https://example.com\", email: ann@example.com, x-c: 1}"
        "  license: {name: Apache 2.0, identifier: Apache-2.0}"
        "  version: 2.0.0"
        "  x-info: true"
        "jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base"
        "servers:"
        "  - url: \"https://{region}.example.com/{base}\""
        "    description: Regional"
        "    variables:"
        "      region: {enum: [eu, us], default: eu, description: Where}"
        "      base: {default: v2}"
        "paths:"
        "  /items/{id}:"
        "    summary: An item"
        "    parameters:"
        "      - $ref: \"#/components/parameters/id\""
        "    get:"
        "      tags: [items]"
        "      summary: Read"
        "      description: Reads one"
        "      externalDocs: {url: \"https://example.com/docs\"}"
        "      operationId: readItem"
        "      deprecated: true"
        "      security: []"
        "      servers:"
        "        - url: /local"
        "      responses:"
        "        \"200\":"
        "          $ref: \"#/components/responses/Item\""
        "        x-responses: 1"
        "    put:"
        "      operationId: putItem"
        "      requestBody:"
        "        $ref: \"#/components/requestBodies/Item\""
        "      callbacks:"
        "        done:"
        "          \"{$request.body#/callback}\":"
        "            post:"
        "              requestBody:"
        "                content:"
        "                  application/json:"
        "                    schema: {type: object}"
        "              responses:"
        "                \"200\": {description: ok}"
        "        later:"
        "          $ref: \"#/components/callbacks/later\""
        "      responses:"
        "        \"204\":"
        "          description: Stored"
        "          links:"
        "            read:"
        "              operationId: readItem"
        "              parameters: {id: $request.path.id}"
        "              requestBody: {a: 1}"
        "              description: Read it back"
        "              server: {url: \"https://example.com\"}"
        "            other: {$ref: \"#/components/links/other\"}"
        "  x-paths: {note: kept}"
        "webhooks:"
        "  newItem:"
        "    post:"
        "      requestBody:"
        "        content:"
        "          application/json:"
        "            schema: {$ref: \"#/components/schemas/Item\"}"
        "      responses:"
        "        \"200\": {description: ok}"
        "components:"
        "  schemas:"
        "    Item:"
        "      type: object"
        "      properties:"
        "        id: {type: integer, format: int64}"
        "        name: {type: [string, \"null\"]}"
        "  responses:"
        "    Item:"
        "      description: The item"
        "      headers:"
        "        X-Rate: {$ref: \"#/components/headers/Rate\"}"
        "        X-Note: {description: a note, schema: {type: string}, example: hi}"
        "      content:"
        "        application/json:"
        "          schema: {$ref: \"#/components/schemas/Item\"}"
        "          examples:"
        "            one: {summary: One, value: {id: 1, name: a}}"
        "            two: {$ref: \"#/components/examples/two\"}"
        "  parameters:"
        "    id: {name: id, in: path, required: true, description: The id, schema: {type: integer}}"
        "  examples:"
        "    two: {summary: Two, externalValue: \"https://example.com/two.json\"}"
        "  requestBodies:"
        "    Item:"
        "      description: An item"
        "      required: true"
        "      content:"
        "        multipart/form-data:"
        "          schema: {type: object, properties: {file: {type: string, contentMediaType: image/png}}}"
        "          encoding:"
        "            file: {contentType: image/png, headers: {X-Part: {schema: {type: string}}}}"
        "        application/x-www-form-urlencoded:"
        "          schema: {type: object}"
        "          encoding:"
        "            tags: {style: spaceDelimited, explode: true, allowReserved: true}"
        "  headers:"
        "    Rate: {description: The rate, required: true, schema: {type: integer}}"
        "  securitySchemes:"
        "    key: {type: apiKey, name: X-Key, in: header, description: A key}"
        "    basic: {type: http, scheme: basic}"
        "    jwt: {type: http, scheme: bearer, bearerFormat: JWT}"
        "    oauth:"
        "      type: oauth2"
        "      flows:"
        "        authorizationCode:"
        "          authorizationUrl: \"https://example.com/auth\""
        "          tokenUrl: \"https://example.com/token\""
        "          refreshUrl: \"https://example.com/refresh\""
        "          scopes: {read: Read, write: Write}"
        "        clientCredentials:"
        "          tokenUrl: \"https://example.com/token\""
        "          scopes: {}"
        "        x-flows: 1"
        "    oidc: {type: openIdConnect, openIdConnectUrl: \"https://example.com/.well-known/openid-configuration\"}"
        "    tls: {type: mutualTLS}"
        "  links:"
        "    other: {operationRef: \"#/paths/~1items~1{id}/get\"}"
        "  callbacks:"
        "    later:"
        "      \"{$request.query.url}\":"
        "        post:"
        "          responses:"
        "            \"200\": {description: ok}"
        "  pathItems:"
        "    shared:"
        "      get:"
        "        responses:"
        "          \"200\": {description: ok}"
        "  x-components: 1"
        "security:"
        "  - key: []"
        "  - oauth: [read, write]"
        "tags:"
        "  - {name: items, description: Items, externalDocs: {url: \"https://example.com/items\"}, x-tag: 1}"
        "externalDocs: {description: More, url: \"https://example.com/more\"}"
        "x-top: {a: [1, 2]}"
    ]
    return lines.join("\n")
