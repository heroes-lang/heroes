# The bins of a histogram: as d3-array's `bin` makes them by default (a
# count of bins by Sturges' formula, edges at the nice ticks of the values'
# range), as NumPy's `histogram` makes a count of bins of one width from the
# least value to the greatest, or between edges a caller gives.
#
# A value that is not a number is not counted; the face refuses an infinite
# one before it calls.

use chart/internal/ticks
use math

# A bin: the values from `low` up to `high`, the last bin taking `high` too.
record Bin
    low: f64
    high: f64
    count: i64

# The values that are numbers.
function numbers_of(values: [f64]) -> [f64]
    out: [f64] @= []

    for v in values
        if v == v
            out @ out.push(v)

    return out

# The least and the greatest of `xs`, which holds at least one value.
function extent_of(xs: [f64]) -> ticks.Span
    low @= xs[0]
    high @= xs[0]

    for x in xs
        if x < low
            low @ x

        if x > high
            high @ x

    return ticks.Span(low: low, high: high)

# One bin from half below `v` to half above it holding `count` values: the
# bin of values that are all the same, as NumPy widens their range.
function single(v: f64, count: i64) -> [Bin]
    return [Bin(low: v - 0.5, high: v + 0.5, count: count)]

# The bins d3-array's `bin` makes with its default thresholds: Sturges'
# count, the range moved out to its nice ticks, those ticks the edges.
function automatic(values: [f64]) -> [Bin]
    xs = numbers_of(values)
    out: [Bin] @= []

    if xs.len() == 0
        return out
    span = extent_of(xs)

    if span.low == span.high
        return single(v: span.low, count: xs.len())
    n = to_f64(xs.len())
    count = math.max(a: 1.0, b: math.ceil(math.ln(n) / math.LN_2) + 1.0)
    largest = span.high
    niced = ticks.nice_unbounded(low: span.low, high: span.high, count: count)
    x0 = niced.low
    x1 @= niced.high
    tz @= ticks.ticks(start: x0, stop: x1, count: count)
    step @= math.NAN

    if tz.len() > 0 && tz[0] <= x0
        step @ ticks.increment(start: x0, stop: x1, count: count)

    if tz.len() > 0 && tz[tz.len() - 1] >= x1
        if largest >= x1
            inc = ticks.increment(start: x0, stop: x1, count: count)

            if math.is_finite(inc)
                if inc > 0.0
                    x1 @ (math.floor(x1 / inc) + 1.0) * inc
                else if inc < 0.0
                    x1 @ (math.ceil(x1 * -inc) + 1.0) / -inc
        else
            tz @ tz.slice(from: 0, to: tz.len() - 1)
    a @= 0

    while a < tz.len() && tz[a] <= x0
        a @ a + 1

    b @= tz.len()

    while b > a && tz[b - 1] > x1
        b @ b - 1

    edges = tz.slice(from: a, to: b)
    m = edges.len()
    counts: [i64] @= []

    for _ in range(from: 0, to: m + 1)
        counts @ counts.push(0)

    for x in xs
        if x0 <= x && x <= x1
            j @= 0

            if math.is_finite(step) && step > 0.0
                j @ math.min_i64(a: m, b: to_i64(math.floor((x - x0) / step)).must())
            else if math.is_finite(step) && step < 0.0
                k = to_i64(math.floor((x0 - x) * step)).must()

                if k < m && edges[k] <= x
                    j @ math.min_i64(a: m, b: k + 1)
                else
                    j @ math.min_i64(a: m, b: k)
            else
                j @ upper_bound(edges: edges, x: x)
            counts[j] @ counts[j] + 1

    for i in range(from: 0, to: m + 1)
        low @= x0
        high @= x1

        if i > 0
            low @ edges[i - 1]

        if i < m
            high @ edges[i]
        out @ out.push(Bin(low: low, high: high, count: counts[i]))

    return out

# The number of `edges` at or below `x`: the bin `x` falls in where the
# edges are its thresholds.
function upper_bound(edges: [f64], x: f64) -> i64
    lo @= 0
    hi @= edges.len()

    while lo < hi
        mid = (lo + hi) / 2

        if edges[mid] <= x
            lo @ mid + 1
        else
            hi @ mid

    return lo

# `count` bins of one width from the least value to the greatest, as NumPy's
# `histogram` makes them: the edges NumPy's `linspace` gives, a value placed
# by its offset over the width and moved by one where rounding put it past an
# edge, the last bin taking the greatest value.
function uniform(values: [f64], count: i64) -> [Bin]
    xs = numbers_of(values)
    first @= 0.0
    last @= 1.0

    if xs.len() > 0
        span = extent_of(xs)
        first @ span.low
        last @ span.high

    if first == last
        first @ first - 0.5
        last @ last + 0.5
    width = (last - first) / to_f64(count)
    edges: [f64] @= []

    for i in range(from: 0, to: count)
        edges @ edges.push(to_f64(i) * width + first)

    edges @ edges.push(last)
    counts: [i64] @= []

    for _ in range(from: 0, to: count)
        counts @ counts.push(0)

    denominator = last - first

    for x in xs
        if x >= first && x <= last
            j @= to_i64(math.floor((x - first) / denominator * to_f64(count))).must()

            if j >= count
                j @ count - 1

            if j > 0 && x < edges[j]
                j @ j - 1
            else if j < count - 1 && x >= edges[j + 1]
                j @ j + 1
            counts[j] @ counts[j] + 1

    out: [Bin] @= []

    for i in range(from: 0, to: count)
        out @ out.push(Bin(low: edges[i], high: edges[i + 1], count: counts[i]))

    return out

# The bins between `edges`, which rise strictly and number at least two: a
# value from one edge up to the next, the last bin taking its upper edge, and
# a value outside them not counted, as NumPy's `histogram` counts.
function between(values: [f64], edges: [f64]) -> [Bin]
    m = edges.len() - 1
    counts: [i64] @= []

    for _ in range(from: 0, to: m)
        counts @ counts.push(0)

    for x in values
        if x == x && x >= edges[0] && x <= edges[m]
            j = math.min_i64(a: m - 1, b: upper_bound(edges: edges, x: x) - 1)
            counts[j] @ counts[j] + 1

    out: [Bin] @= []

    for i in range(from: 0, to: m)
        out @ out.push(Bin(low: edges[i], high: edges[i + 1], count: counts[i]))

    return out

## Tests

# The expected values are d3-array 3.2.4's `bin` and NumPy 2.5.4's
# `histogram` over the same values, run on 2026-11-24.

test "automatic: no value, no bin; one value repeated, one bin about it"
    assert automatic([]).len() == 0
    assert automatic([5.0, 5.0, 5.0]) == [Bin(low: 4.5, high: 5.5, count: 3)]
    assert automatic([0.0 / 0.0]).len() == 0

test "automatic: d3's bins of eight values"
    assert automatic([1.0, 2.0, 2.0, 3.0, 3.0, 3.0, 4.0, 9.0]) == [Bin(low: 0.0, high: 2.0, count: 1), Bin(low: 2.0, high: 4.0, count: 5), Bin(low: 4.0, high: 6.0, count: 1), Bin(low: 6.0, high: 8.0, count: 0), Bin(low: 8.0, high: 10.0, count: 1)]

test "automatic: d3's bins of values about zero"
    assert automatic([0.13, 0.27, -0.4, 0.9, 0.05, -0.31, 0.61]) == [Bin(low: -0.5, high: 0.0, count: 2), Bin(low: 0.0, high: 0.5, count: 3), Bin(low: 0.5, high: 1.0, count: 2)]

test "uniform: NumPy's four bins of one width"
    assert uniform(values: [0.13, 0.27, -0.4, 0.9, 0.05, -0.31, 0.61], count: 4) == [Bin(low: -0.4, high: -0.07500000000000001, count: 2), Bin(low: -0.07500000000000001, high: 0.25, count: 2), Bin(low: 0.25, high: 0.5750000000000001, count: 1), Bin(low: 0.5750000000000001, high: 0.9, count: 2)]

test "uniform: no value cuts 0 to 1, as NumPy does"
    assert uniform(values: [], count: 2) == [Bin(low: 0.0, high: 0.5, count: 0), Bin(low: 0.5, high: 1.0, count: 0)]

test "between: NumPy's bins between edges, the last taking its edge"
    assert between(values: [1.0, 2.0, 2.0, 3.0, 3.0, 3.0, 4.0, 9.0], edges: [0.0, 2.5, 5.0, 10.0]) == [Bin(low: 0.0, high: 2.5, count: 3), Bin(low: 2.5, high: 5.0, count: 4), Bin(low: 5.0, high: 10.0, count: 1)]
    assert between(values: [10.0, 11.0, -1.0, 0.0 / 0.0], edges: [0.0, 5.0, 10.0]) == [Bin(low: 0.0, high: 5.0, count: 0), Bin(low: 5.0, high: 10.0, count: 1)]
