# Server-sent events, read and served: a reader that connects again as a
# browser's `EventSource` does (the WHATWG HTML standard, § 9.2), and a hub
# that keeps the clients of an event stream, tells each of them what happens,
# remembers what it told so a client that connects again is told what it
# missed, and keeps a silent connection from being closed by a proxy.
#
# **What `http` and `web` already do.** One event, as a client reads it and a
# server writes it, is `http.Event`; `http.event_reader` and `http.read_event`
# read a stream on a connection the program holds, `web.start_events`,
# `web.write_event` and `web.write_comment` write one. This package is what a
# program that uses them again and again would otherwise write itself: the
# connection made through the client's proxy (`http.open_stream`), made again
# after it ends, with the last id the stream gave (`Last-Event-ID`) and the
# wait it asked for (`retry`); and the list of clients, the history and the
# heartbeat.
#
# **A reader is `Source`**, made by `source`, and read by `next`, which waits
# for an event, connecting and connecting again as it needs. It follows the
# standard's processing model: a stream is accepted where the answer is 200
# and `text/event-stream`, and any other answer, a certificate refused or a
# coding not undone ends the source (`invalid`, `unsupported`), as the
# standard says the connection fails, with `Reading.statuses` to name the
# statuses a program would rather wait out (a server restarting answers 503);
# the network's failures, the stream's end and a silent stream (`idle`) are
# waited out and the connection made again. The standard says no more than a
# wait of "a few seconds"; here it doubles after each failure in a row, up to
# `Reading.longest`, and ends the source (`limit`) after `most_failures`.
#
# **A hub is `Hub`**, a value the program's own loop holds and changes, since
# `web.serve` answers each request with a response held whole and a stream
# kept open is the program's own loop's (`web.start_events`): it hands the hub
# the connection of each request it chooses to stream (`subscribe`), calls
# `publish` where something happens and `heartbeat` on a timer (`due` says
# when), and the hub writes to each client, with a wait bounded for each, and
# drops the one whose write fails. One thread, no locks and no thread of the
# package's own.
#
# Not done, the ledger saying so of each: a hub for several topics (a program
# keeps one hub for each), events delivered to a client that was not connected
# when they happened and has no id to ask with, and a stream read over HTTP/2
# (`http.open_stream` speaks HTTP/1.1, which is what every server of event
# streams answers).
#
# The codes it fails with: `invalid`, `unsupported`, `limit`, `stopped`,
# `closed` and `not_found`, and those of `http`, `web`, `io` and `time` that
# a call hands on where it says so.

use http
use io
use net
use sse/internal/fixture
use sse/internal/members
use sse/internal/opening
use sse/internal/replaying
use sse/internal/waiting
use strings
use time
use tls
use url
use web

## Codes

# The code of a source that has ended, or was closed.
constant CLOSED: str
    "closed"

# The code of a source that gave up after `most_failures` failures in a row.
constant LIMIT: str
    "limit"

# The code of a program asked to stop while a source waited.
constant STOPPED: str
    "stopped"

# The code of an event, a target or a setting this package does not take.
constant INVALID: str
    "invalid"

# The code of a target that is not `http://` or `https://`.
constant UNSUPPORTED: str
    "unsupported"

# The code of a client number no client of the hub has.
constant NOT_FOUND: str
    "not_found"

## Reading a stream

# How a `Source` waits and gives up.
record Reading
    # The wait before a connection is made again until the stream says another
    # in its `retry` field: three seconds, as Chrome waits.
    retry: time.Duration
    # The longest wait between two attempts: the wait doubles after each
    # failure in a row up to this, and goes back to the stream's own once an
    # event comes.
    longest: time.Duration
    # The most connection attempts in a row that deliver no event before
    # `next` fails `limit`; `UNLIMITED` to try for ever, as a browser does.
    most_failures: i64
    # How long a connection may be silent of events before it is given up and
    # made again with `Last-Event-ID`; a comment does not count, so a program
    # whose server sends heartbeats sets it above their interval, and
    # `time.max_duration()` waits as long as the peer takes.
    idle: time.Duration
    # The statuses that are waited out and tried again, where the standard
    # fails the connection on any status but 200: `[502, 503, 504]` for a
    # server that restarts.
    statuses: [i64]

# The most failures in a row: no limit.
constant UNLIMITED: i64
    9_223_372_036_854_775_807

# The usual reading: the standard's wait of three seconds, at most a minute
# between attempts, ten failures in a row, no limit on the silence and no
# status waited out.
function default_reading() -> Reading
    return Reading(
        retry: time.seconds(3).must(),
        longest: time.seconds(60).must(),
        most_failures: 10,
        idle: time.max_duration(),
        statuses: []
    )

# An event stream being read, connecting as it needs. Made by `source`,
# advanced by `next`, ended by `close`.
record Source
    # The stream's address, `http://` or `https://`.
    target: str
    # How the connection is made: its proxy, its time for the connection and
    # the head of the answer (`deadline`), its certificate authorities, its
    # limits and its redirects; `http.default_client()` where the program has
    # no other.
    client: http.Client
    # How it waits and gives up.
    reading: Reading
    # The fields of every request, `Authorization` or `Cookie`, after the
    # `Accept`, `Cache-Control` and `Last-Event-ID` this package writes.
    headers: [http.Header]
    # The last event id the stream gave, which a connection made again sends.
    # Only this package writes it.
    last_id: str
    # The wait before the next connection, the stream's or the reading's.
    retry: time.Duration
    # The failures in a row.
    failures: i64
    # The connection open, `not_found` where none is.
    link: opening.Link?
    # Whether the source has ended.
    finished: bool

# A source of the stream at `target`, which connects at its first `next` and
# not before.
#
# - `target`: an absolute `http://` or `https://` URL; redirects are followed
#   as `client.max_redirects` says, never to another scheme.
# - `client`: how connections are made; see `Source.client`.
# - `reading`: how it waits and gives up; see `default_reading`.
#
# Fails `invalid` where `target` is no URL with a host or a time of `reading`
# is below zero, and `unsupported` for a scheme other than `http` and
# `https`. See also `next`.
function source(target: str, client: http.Client, reading: Reading) -> Source?
    u = url.parse(target)?

    if u.scheme != "http" && u.scheme != "https"
        return fail(
            code: UNSUPPORTED,
            msg: f"the event stream at {url.redacted(u)}: only http:// and https:// are spoken here"
        )

    if u.host == ""
        return fail(code: INVALID, msg: f"the event stream at {url.redacted(u)}: its URL names no host")

    if reading.retry.nanoseconds < 0 || reading.longest.nanoseconds < 0 || reading.idle.nanoseconds < 0 || reading.most_failures < 0
        return fail(
            code: INVALID,
            msg: "reading an event stream: a retry, a longest wait, an idle time or a count of failures below zero"
        )
    return ok(
        Source(target: target, client: client, reading: reading, headers: [], last_id: "", retry: reading.retry, failures: 0, link: fail(code: NOT_FOUND, msg: "no connection is open"), finished: false)
    )

# The next event of the stream `s` reads, waiting for it and connecting, or
# connecting again, as it needs: the request carries `Last-Event-ID` where the
# stream has given an id, and a stream that ends, or fails in a way the
# network may mend, is waited out for its `retry` (doubled after each failure
# in a row) and read again.
#
# - `s`: the source; its last id, its wait and its connection change.
#
# Fails `invalid` where the stream answers other than 200 and
# `text/event-stream` (a status of `reading.statuses` aside), refuses its
# certificate, or sends an event whose lines pass `client.limits`, and
# `unsupported` where its body is coded; the source has ended then and every
# later call fails `closed`, as a browser fails the connection and tries no
# more. Fails `limit` where `reading.most_failures` attempts in a row gave no
# event, and `stopped` where the program was asked to stop while it waited,
# the source then left as it was. See also `close`, `source`.
function next(@s: Source) -> http.Event?
    while true
        if s.finished
            return fail(code: CLOSED, msg: f"the event stream at {url.redacted(url.parse(s.target).must())} is closed")
        code: str @= ""
        problem: str @= ""

        if s.link.is_err()
            match opening.attempt(s.client, target: s.target, headers: s.headers, last_id: s.last_id, waits: s.reading.statuses)
                .ok link => s.link @ ok(link)
                .err e =>
                    code @ e.code
                    problem @ e.msg

        if code == ""
            link = s.link.must()
            reader @= link.reader
            events @= link.events
            s.link @ fail(code: NOT_FOUND, msg: "no connection is open")

            got: http.Event? = match tls.set_deadline(reader.stream, deadline: s.reading.idle)
                .ok _  => http.read_event(@reader, @events)
                .err e => fail(code: e.code, msg: e.msg)

            if events.last_id != ""
                s.last_id @ events.last_id

            if events.retry != time.seconds(3).must()
                s.retry @ events.retry

            match got
                .ok event =>
                    s.failures @ 0
                    s.link @ ok(opening.Link(reader: reader, events: events))
                    return ok(event)
                .err e =>
                    opening.shut(@reader.stream)

                    if e.code == LIMIT
                        s.finished @ true
                        return fail(
                            code: LIMIT,
                            msg: f"the event stream at {url.redacted(url.parse(s.target).must())}: {e.msg}"
                        )
                    code @ e.code
                    problem @ e.msg
        v = waiting.verdict(
            code,
            failures: s.failures,
            most_failures: s.reading.most_failures,
            base_ms: time.to_units(s.retry, unit: .millisecond),
            longest_ms: time.to_units(s.reading.longest, unit: .millisecond)
        )
        s.failures @ v.failures

        if v.ends
            s.finished @ true

            if v.gave_up
                return fail(
                    code: LIMIT,
                    msg: f"the event stream at {url.redacted(url.parse(s.target).must())} gave no event in {v.failures - 1} attempts in a row, the last failing as {code}: {problem}"
                )
            return fail(code: v.code, msg: problem)
        waiting.pause(v.wait_ms)?

    return fail(code: CLOSED, msg: "unreachable")

# Ends the source `s`: its connection closed and every later `next` failing
# `closed`. Closing a source that has ended is no failure.
#
# - `s`: the source.
function close(@s: Source)
    match s.link
        .ok link =>
            stream @= link.reader.stream
            opening.shut(@stream)
        .err _ => _ = 0

    s.link @ fail(code: NOT_FOUND, msg: "no connection is open")
    s.finished @ true

# The last event id `s` was given: what its next connection sends as
# `Last-Event-ID`, "" where the stream gave none.
#
# - `s`: the source.
function last_id_of(s: Source) -> str
    return s.last_id

# The wait `s` makes before it connects again: the stream's `retry`, or the
# reading's until the stream says one.
#
# - `s`: the source.
function retry_of(s: Source) -> time.Duration
    return s.retry

## Serving a stream

# The clients of an event stream, what they were last told and when. Made by
# `default_hub`; the program may set its first four fields, and the others are
# this package's alone.
record Hub
    # How many events are kept to tell a client that connects again; 0 or
    # below keeps none.
    history: i64
    # How long a client may be told nothing before `heartbeat` writes it a
    # comment, so a proxy does not close the connection: fifteen seconds, as
    # the standard suggests. Zero writes one at every `heartbeat`.
    heartbeat: time.Duration
    # How long a write to a client may wait, since a client that reads nothing
    # fills the connection and would hold the program; past it the client is
    # dropped. Zero drops a client whose write would wait at all.
    write_wait: time.Duration
    # The wait a new client is told to make before it connects again, in its
    # `retry` line; zero tells none, and a browser waits three seconds.
    retry: time.Duration
    # The events kept, the oldest first.
    events: [http.Event]
    # The number the next event with no id of its own is given.
    number: i64
    # The clients.
    members: [members.Member]
    # The number the next client is given.
    issued: i64

# A hub with no clients: a hundred events kept, a comment after fifteen quiet
# seconds, ten seconds for each write, and no `retry` told.
function default_hub() -> Hub
    return Hub(
        history: 100,
        heartbeat: time.seconds(15).must(),
        write_wait: time.seconds(10).must(),
        retry: time.Duration(nanoseconds: 0),
        events: [],
        number: 1,
        members: [],
        issued: 1
    )

# The last event id a request carries, which a browser sends when it connects
# again, "" where it carries none.
#
# - `r`: the request a program read from the client's connection.
function last_event_id_of(r: http.Request) -> str
    return http.value_of(r.headers, name: "Last-Event-ID").default("")

# Makes the client on `s` a client of `hub`: writes the head of an event
# stream (`web.start_events`), the `retry` the hub is to tell, and the events
# the client missed, the history after `last_id` (every event the history
# holds where `last_id` is that of none of them, and none where it is ""),
# then counts it among the clients. The connection is the hub's from here:
# it closes it when the client goes, on `drop` and on `close`, and where this
# call fails.
#
# - `hub`: the hub.
# - `s`: the client's connection, after its request was read.
# - `last_id`: the client's `Last-Event-ID`, `last_event_id_of` of its
#   request.
# - `headers`: fields added to the head, as `web.start_events` takes them.
#
# The number the client is given, for `drop` and `stream_of`. Fails as
# `web.start_events`, `web.write_event` and `web.write_retry` fail, `closed`
# among them where the client is already gone.
function subscribe(@hub: Hub, s: io.Stream, last_id: str, headers: [http.Header]) -> i64?
    owned @= s

    now = match time.mark()
        .ok m => m
        .err e =>
            opening.shut(@owned)
            return fail(code: e.code, msg: e.msg)

    told = members.opened(
        owned,
        wait: hub.write_wait,
        retry: hub.retry,
        replay: replaying.after(hub.events, last_id: last_id),
        headers: headers
    )

    match told
        .ok _ => _ = 0
        .err e =>
            opening.shut(@owned)
            return fail(code: e.code, msg: e.msg)

    id = hub.issued
    hub.issued @ id + 1
    hub.members @ hub.members.push(members.Member(id: id, stream: owned, quiet: now))
    return ok(id)

# Tells every client `event` and keeps it for the clients that connect again:
# an event with no id is given the next number as its id, so a client's
# `Last-Event-ID` finds it. A client whose write fails or waits past
# `hub.write_wait` is dropped and its connection closed.
#
# - `hub`: the hub.
# - `event`: the event.
#
# How many clients were told. Fails `invalid` as `web.format_event` fails, with
# nothing kept and nobody told, and as `time.mark` fails where the system
# cannot read its monotonic clock, the event kept and nobody told.
function publish(@hub: Hub, event: http.Event) -> i64?
    stamped @= event

    if event.id == ""
        stamped.id @ f"{hub.number}"
    text = web.format_event(stamped)?

    if event.id == ""
        hub.number @ hub.number + 1
    hub.events @ replaying.kept_with(hub.events, event: stamped, most: hub.history)
    now = time.mark()?
    kept: [members.Member] @= []
    told: i64 @= 0

    for m in hub.members
        match members.written(m, wait: hub.write_wait, text: text)
            .ok _ =>
                kept @ kept.push(members.Member(id: m.id, stream: m.stream, quiet: now))
                told @ told + 1
            .err _ =>
                gone @= m.stream
                opening.shut(@gone)

    hub.members @ kept
    return ok(told)

# Writes a comment to every client told nothing for `hub.heartbeat`, which a
# reader skips and a proxy takes for traffic. A client whose write fails is
# dropped and its connection closed.
#
# - `hub`: the hub.
#
# How many clients were dropped. Call it on a timer, `due` saying how long
# until it is next needed. Fails as `time.mark` and `time.elapsed` fail, where
# the system cannot read its monotonic clock. See also `publish`.
function heartbeat(@hub: Hub) -> i64?
    now = time.mark()?
    kept: [members.Member] @= []
    dropped: i64 @= 0

    for m in hub.members
        if time.elapsed(m.quiet)?.nanoseconds < hub.heartbeat.nanoseconds
            kept @ kept.push(m)
            continue

        match members.commented(m, wait: hub.write_wait)
            .ok _ => kept @ kept.push(members.Member(id: m.id, stream: m.stream, quiet: now))
            .err _ =>
                gone @= m.stream
                opening.shut(@gone)
                dropped @ dropped + 1

    hub.members @ kept
    return ok(dropped)

# How long until some client has been told nothing for `hub.heartbeat`, which
# is the longest a loop waits before it calls `heartbeat`; zero where one
# already has, and `time.max_duration()` where the hub has no client.
#
# - `hub`: the hub.
function due(hub: Hub) -> time.Duration
    least: time.Duration @= time.max_duration()

    for m in hub.members
        left = match time.elapsed(m.quiet)
            .ok spent =>
                match time.difference(a: hub.heartbeat, b: spent)
                    .ok d  => d
                    .err _ => time.Duration(nanoseconds: 0)
            .err _ => time.Duration(nanoseconds: 0)

        floor = if left.nanoseconds < 0
            time.Duration(nanoseconds: 0)
        else
            left

        if floor.nanoseconds < least.nanoseconds
            least @ floor

    return least

# How many clients the hub has.
#
# - `hub`: the hub.
function count(hub: Hub) -> i64
    return hub.members.len()

# The connection of the client `id`, for a loop that waits on its clients with
# `poll` to learn that one has gone. Fails `not_found` where no client has
# that number.
#
# - `hub`: the hub.
# - `id`: the number `subscribe` gave the client.
function stream_of(hub: Hub, id: i64) -> io.Stream?
    for m in hub.members
        if m.id == id
            return ok(m.stream)

    return fail(code: NOT_FOUND, msg: f"the hub has no client {id}")

# Removes the client `id` and closes its connection. Fails `not_found` where
# no client has that number.
#
# - `hub`: the hub.
# - `id`: the number `subscribe` gave the client.
function drop(@hub: Hub, id: i64) -> ()?
    kept: [members.Member] @= []
    found: bool @= false

    for m in hub.members
        if m.id == id
            gone @= m.stream
            opening.shut(@gone)
            found @ true
        else
            kept @ kept.push(m)

    hub.members @ kept

    if !found
        return fail(code: NOT_FOUND, msg: f"the hub has no client {id}")
    return ok()

# Removes every client and closes every connection; the history stays.
#
# - `hub`: the hub.
function close_all(@hub: Hub)
    for m in hub.members
        gone @= m.stream
        opening.shut(@gone)

    hub.members @ []

## Tests

test "source: a target that is no URL, no http, no host, or a reading below zero is refused, and a good one starts quiet"
    c = http.default_client()
    assert source("not a url", client: c, reading: default_reading()).is_err()
    assert source("ftp://example.test/feed", client: c, reading: default_reading()).is_err()
    assert source("http:///feed", client: c, reading: default_reading()).is_err()
    assert source("", client: c, reading: default_reading()).is_err()
    below @= default_reading()
    below.idle @ time.Duration(nanoseconds: -1)
    assert source("http://example.test/feed", client: c, reading: below).is_err()
    few @= default_reading()
    few.most_failures @ -1
    assert source("http://example.test/feed", client: c, reading: few).is_err()
    s = source("https://example.test/feed", client: c, reading: default_reading()).must()
    assert last_id_of(s) == "" && retry_of(s) == time.seconds(3).must() && !s.finished

test "next: events across a stream that ends, the last id sent again, the stream's retry kept, and a source closed"
    t @= fixture.start(
        [fixture.stream_head() + "retry: 10\nid: 1\ndata: a\n\n", fixture.stream_head() + "id: 2\nevent: tick\ndata: b\n\n"]
    )
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s).must() == http.Event(name: "message", data: "a", id: "1")
    assert next(@s).must() == http.Event(name: "tick", data: "b", id: "2")
    assert last_id_of(s) == "2" && retry_of(s) == time.milliseconds(10).must()
    close(@s)
    assert next(@s).is_err()
    seen = fixture.seen_by(@t)
    assert seen == ["GET /feed - text/event-stream", "GET /feed 1 text/event-stream"]

test "next: an answer that is no event stream ends the source at once, whatever its status"
    t @= fixture.start(["HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"])
    s @= source(f"http://127.0.0.1:{t.port}/gone", client: http.default_client(), reading: fixture.quick()).must()

    match next(@s)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert next(@s).is_err()
    assert fixture.seen_by(@t).len() == 1
    h @= fixture.start(["HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"])
    s2 @= source(f"http://127.0.0.1:{h.port}/page", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s2).is_err() && next(@s2).is_err()
    assert fixture.seen_by(@h).len() == 1

test "next: a status of `statuses` is waited out and the stream asked for again"
    t @= fixture.start(
        ["HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", fixture.stream_head() + "data: up\n\n"]
    )
    r @= fixture.quick()
    r.statuses @ [502, 503, 504]
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: r).must()
    assert next(@s).must().data == "up"
    assert fixture.seen_by(@t).len() == 2
    close(@s)
    plain @= fixture.start(["HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"])
    s2 @= source(f"http://127.0.0.1:{plain.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s2).is_err()
    assert fixture.seen_by(@plain).len() == 1

test "next: a redirect is followed with the last id kept, and a stream that ends with no event is tried again"
    t @= fixture.start(
        ["HTTP/1.1 302 Found\r\nLocation: /two\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", fixture.stream_head() + ": nothing yet\n\n", fixture.stream_head() + "id: 5\ndata: late\n\n"]
    )
    s @= source(f"http://127.0.0.1:{t.port}/one", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s).must().id == "5"
    assert fixture.seen_by(@t) == ["GET /one - text/event-stream", "GET /two - text/event-stream", "GET /one - text/event-stream"]
    close(@s)

test "next: no one listening is waited out, doubled up to the longest, and given up on after `most_failures`"
    gone @= net.listen(host: "127.0.0.1", port: 0).must()
    port = gone.address.port
    net.close_listener(@gone).must()
    r @= fixture.quick()
    r.most_failures @ 2
    s @= source(f"http://127.0.0.1:{port}/feed", client: http.default_client(), reading: r).must()
    began = time.mark().must()

    match next(@s)
        .ok _ => assert false
        .err e =>
            assert e.code == LIMIT
            assert strings.contains(s: e.msg, substr: "in 2 attempts")

    assert time.to_units(time.elapsed(began).must(), unit: .millisecond) >= 30
    assert next(@s).is_err()

test "next: a connection silent of events for `idle` is given up and made again with the last id"
    t @= fixture.start(
        ["hold:" + fixture.stream_head() + "id: 1\ndata: a\n\n", fixture.stream_head() + "id: 2\ndata: b\n\n"]
    )
    r @= fixture.quick()
    r.idle @ time.milliseconds(100).must()
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: r).must()
    assert next(@s).must().data == "a"
    assert next(@s).must().data == "b"
    close(@s)
    assert fixture.seen_by(@t) == ["GET /feed - text/event-stream", "GET /feed 1 text/event-stream"]

test "next: a source with headers sends them, the program's `Authorization` among them"
    t @= fixture.start([fixture.stream_head() + "data: x\n\n"])
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    s.headers @ [http.Header(name: "Accept", value: "text/event-stream, text/x")]
    assert next(@s).must().data == "x"
    close(@s)
    assert fixture.seen_by(@t) == ["GET /feed - text/event-stream, text/x"]

test "subscribe and publish: a client is told what happens, each event with the id it was given"
    hub @= default_hub()
    p @= fixture.pair()
    id = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    assert count(hub) == 1 && id == 1
    events @= fixture.watched(@p)
    assert publish(@hub, event: http.Event(name: "", data: "one", id: "")).must() == 1
    assert publish(@hub, event: http.Event(name: "note", data: "two\nlines", id: "abc")).must() == 1
    assert http.read_event(@p.client, @events).must() == http.Event(name: "message", data: "one", id: "1")
    assert http.read_event(@p.client, @events).must() == http.Event(name: "note", data: "two\nlines", id: "abc")
    close_all(@hub)
    assert count(hub) == 0
    io.close(@p.client.stream).must()

test "subscribe: a client that connects again is told what it missed, all of it where its id is gone, none with no id"
    hub @= default_hub()

    for n in range(from: 1, to: 4)
        assert publish(@hub, event: http.Event(name: "", data: f"e{n}", id: "")).must() == 0

    known @= fixture.pair()
    _ = subscribe(@hub, s: known.server, last_id: "1", headers: []).must()
    known_events @= fixture.watched(@known)
    assert http.read_event(@known.client, @known_events).must().data == "e2"
    assert http.read_event(@known.client, @known_events).must().data == "e3"
    gone @= fixture.pair()
    _ = subscribe(@hub, s: gone.server, last_id: "zzz", headers: []).must()
    gone_events @= fixture.watched(@gone)
    assert http.read_event(@gone.client, @gone_events).must().data == "e1"
    fresh @= fixture.pair()
    _ = subscribe(@hub, s: fresh.server, last_id: "", headers: []).must()
    fresh_events @= fixture.watched(@fresh)
    assert publish(@hub, event: http.Event(name: "", data: "e4", id: "")).must() == 3
    assert http.read_event(@fresh.client, @fresh_events).must().data == "e4"
    close_all(@hub)
    io.close(@known.client.stream).must()
    io.close(@gone.client.stream).must()
    io.close(@fresh.client.stream).must()

test "subscribe: the history holds the most it was told to, and the `retry` a hub tells is read by the client"
    hub @= default_hub()
    hub.history @ 2
    hub.retry @ time.seconds(7).must()

    for n in range(from: 1, to: 5)
        _ = publish(@hub, event: http.Event(name: "", data: f"e{n}", id: "")).must()

    assert hub.events.len() == 2
    p @= fixture.pair()
    _ = subscribe(
        @hub,
        s: p.server,
        last_id: "zzz",
        headers: [http.Header(name: "X-Accel-Buffering", value: "no")]
    ).must()
    events @= fixture.watched(@p)
    assert http.read_event(@p.client, @events).must().data == "e3"
    assert events.retry == time.seconds(7).must()
    close_all(@hub)
    io.close(@p.client.stream).must()

test "publish: an event a stream cannot carry is refused and kept by none, and one with an id of its own keeps it"
    hub @= default_hub()
    assert publish(@hub, event: http.Event(name: "bad\nname", data: "x", id: "")).is_err()
    assert publish(@hub, event: http.Event(name: "", data: "x", id: "has\nbreak")).is_err()
    assert hub.events.len() == 0 && hub.number == 1
    _ = publish(@hub, event: http.Event(name: "", data: "x", id: "mine")).must()
    assert hub.events[0].id == "mine" && hub.number == 1

test "heartbeat: a comment is written to a client quiet for the interval, and to none that was just told"
    hub @= default_hub()
    hub.heartbeat @ time.Duration(nanoseconds: 0)
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    _ = fixture.watched(@p)
    assert heartbeat(@hub).must() == 0
    assert io.read_n(@p.client, n: 2).must() == [58, 10]
    hub.heartbeat @ time.seconds(3_600).must()
    assert heartbeat(@hub).must() == 0
    assert due(hub).nanoseconds <= time.seconds(3_600).must().nanoseconds && due(hub).nanoseconds > 0
    close_all(@hub)
    assert due(hub) == time.max_duration()
    io.close(@p.client.stream).must()

test "publish and heartbeat: a client that has gone is dropped, its connection closed, and the others still told"
    hub @= default_hub()
    hub.heartbeat @ time.Duration(nanoseconds: 0)
    gone @= fixture.pair()
    kept @= fixture.pair()
    _ = subscribe(@hub, s: gone.server, last_id: "", headers: []).must()
    id = subscribe(@hub, s: kept.server, last_id: "", headers: []).must()
    kept_events @= fixture.watched(@kept)
    io.close(@gone.client.stream).must()
    left: i64 @= 2
    tries: i64 @= 0

    while left > 1 && tries < 50
        _ = publish(@hub, event: http.Event(name: "", data: "x", id: "")).must()
        left @ count(hub)
        tries @ tries + 1

    assert count(hub) == 1 && stream_of(hub, id: id).is_err() == false
    assert http.read_event(@kept.client, @kept_events).must().data == "x"
    assert drop(@hub, id: id).is_err() == false
    assert drop(@hub, id: id).is_err() && count(hub) == 0
    io.close(@kept.client.stream).must()

test "publish: a client that reads nothing is dropped once its connection is full, not waited for"
    hub @= default_hub()
    hub.write_wait @ time.Duration(nanoseconds: 0)
    slow @= fixture.pair()
    _ = subscribe(@hub, s: slow.server, last_id: "", headers: []).must()
    big = http.Event(name: "", data: repeat("x", 32_768), id: "")
    tries: i64 @= 0

    while count(hub) > 0 && tries < 4_000
        _ = publish(@hub, event: big).must()
        tries @ tries + 1

    assert count(hub) == 0 && tries < 4_000
    io.close(@slow.client.stream).must()

test "last_event_id_of: the field of a request, and nothing where it has none"
    r = http.request(method: "GET", target: "http://example.test/feed").must()
    assert last_event_id_of(r) == ""
    with_id @= r
    with_id.headers @ [http.Header(name: "Last-Event-ID", value: "17")]
    assert last_event_id_of(with_id) == "17"

test "stream_of and drop: a number no client has is not found"
    hub @= default_hub()
    assert stream_of(hub, id: 9).is_err()
    assert drop(@hub, id: 9).is_err()

## Examples

# The usual reading, changed for a server that restarts: its 503 waited out
# and the stream asked for again.
test "default_reading: a reading that waits out a restarting server"
    r @= default_reading()
    r.statuses @ [503]
    assert r.retry == time.seconds(3).must() && r.most_failures == 10

# A source of a feed, which connects at its first `next` and not before.
test "source: a source of a news feed"
    s = source("https://example.test/news", client: http.default_client(), reading: default_reading()).must()
    assert last_id_of(s) == "" && !s.finished

# The events of a stream as they come, read from a server on the loopback.
test "next: two events of a stream"
    t @= fixture.start([fixture.stream_head() + "data: a\n\nevent: tick\ndata: b\n\n"])
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s).must().data == "a"
    second = next(@s).must()
    assert second.name == "tick" && second.data == "b"
    close(@s)
    assert fixture.seen_by(@t) == ["GET /feed - text/event-stream"]

# A source the program is done with: its connection closed, and every later
# `next` failing `closed`.
test "close: a source ended by the program"
    t @= fixture.start([fixture.stream_head() + "data: a\n\n"])
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    assert next(@s).must().data == "a"
    close(@s)

    match next(@s)
        .ok _  => assert false
        .err e => assert e.code == CLOSED

    _ = fixture.seen_by(@t)

# The id of the last event read, which the next connection sends as
# `Last-Event-ID`.
test "last_id_of: the id a stream gave"
    t @= fixture.start([fixture.stream_head() + "id: 7\ndata: a\n\n"])
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: fixture.quick()).must()
    assert last_id_of(s) == ""
    _ = next(@s).must()
    assert last_id_of(s) == "7"
    close(@s)
    _ = fixture.seen_by(@t)

# The wait before connecting again: the reading's, until the stream asks for
# another in its `retry` field.
test "retry_of: the wait a stream asks for"
    t @= fixture.start([fixture.stream_head() + "retry: 250\ndata: a\n\n"])
    s @= source(f"http://127.0.0.1:{t.port}/feed", client: http.default_client(), reading: default_reading()).must()
    assert retry_of(s) == time.seconds(3).must()
    _ = next(@s).must()
    assert retry_of(s) == time.milliseconds(250).must()
    close(@s)
    _ = fixture.seen_by(@t)

# A hub that keeps fewer events and writes a comment sooner than the usual one.
test "default_hub: a hub with a shorter history and heartbeat"
    hub @= default_hub()
    hub.history @ 10
    hub.heartbeat @ time.seconds(5).must()
    assert count(hub) == 0 && hub.events == []

# The id a browser that connects again sends, read from its request.
test "last_event_id_of: a browser connecting again"
    r @= http.request(method: "GET", target: "http://example.test/feed").must()
    r.headers @ [http.Header(name: "Last-Event-ID", value: "17")]
    assert last_event_id_of(r) == "17"

# A client made one of the hub's: the head of an event stream written to it,
# and the number it is known by.
test "subscribe: a client given its number"
    hub @= default_hub()
    p @= fixture.pair()
    id = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    assert count(hub) == 1 && id == 1
    _ = fixture.watched(@p)
    close_all(@hub)
    io.close(@p.client.stream).must()

# An event told to every client, given a number as its id where it has none.
test "publish: an event told to a client"
    hub @= default_hub()
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    events @= fixture.watched(@p)
    assert publish(@hub, event: http.Event(name: "", data: "hello", id: "")).must() == 1
    assert http.read_event(@p.client, @events).must() == http.Event(name: "message", data: "hello", id: "1")
    close_all(@hub)
    io.close(@p.client.stream).must()

# A comment written to a client told nothing for the hub's interval, which
# its reader skips.
test "heartbeat: a comment to a quiet client"
    hub @= default_hub()
    hub.heartbeat @ time.Duration(nanoseconds: 0)
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    _ = fixture.watched(@p)
    assert heartbeat(@hub).must() == 0
    assert io.read_n(@p.client, n: 2).must() == [58, 10]
    close_all(@hub)
    io.close(@p.client.stream).must()

# How long a loop may wait before it calls `heartbeat`: no longer than the
# hub's interval once it has a client, and for ever while it has none.
test "due: the wait before the next heartbeat"
    hub @= default_hub()
    assert due(hub) == time.max_duration()
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    assert due(hub).nanoseconds <= hub.heartbeat.nanoseconds
    close_all(@hub)
    io.close(@p.client.stream).must()

# How many clients a hub holds.
test "count: a hub with one client"
    hub @= default_hub()
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    assert count(hub) == 1
    close_all(@hub)
    io.close(@p.client.stream).must()

# The connection of one client, as a loop that waits with `poll` adds it to its
# set.
test "stream_of: a client's connection"
    hub @= default_hub()
    p @= fixture.pair()
    id = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    assert !stream_of(hub, id: id).is_err()

    match stream_of(hub, id: id + 1)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    close_all(@hub)
    io.close(@p.client.stream).must()

# A client removed by the program, its connection closed, which its reader
# sees as the stream's end.
test "drop: a client removed"
    hub @= default_hub()
    p @= fixture.pair()
    id = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    drop(@hub, id: id).must()
    assert count(hub) == 0
    io.close(@p.client.stream).must()

# Every client removed and every connection closed, as a server that stops
# does; the history stays for the clients that come back.
test "close_all: a hub emptied"
    hub @= default_hub()
    p @= fixture.pair()
    _ = subscribe(@hub, s: p.server, last_id: "", headers: []).must()
    _ = publish(@hub, event: http.Event(name: "", data: "kept", id: "")).must()
    close_all(@hub)
    assert count(hub) == 0 && hub.events.len() == 1
    io.close(@p.client.stream).must()
