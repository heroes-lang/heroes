# Another program run, fed, read and waited for: a command built as a record,
# run to its end with what it writes captured, or started as a child whose
# pipes are `io.Stream`s, waited for, asked to end or ended at once; a program
# looked up on PATH; a text quoted for a POSIX shell. The face stands on the
# floor `process/hero_proc`, the thin binding of `hero_proc.h`.
#
# **No shell reads a command.** A program and its arguments are a list, and
# each argument reaches the child whole, spaces, quotes and `$` included.
# `shell` is the one door through the system's shell, and its comment says
# what that costs.
#
# **Nothing a function here starts outlives it.** `run` and `capture` wait
# for their child, and end it at once where a failure stops them; `start`
# hands the child to the program, which ends it with `wait` or gives it up
# with `release`. A child nobody gives back is told when `main` returns, as
# every handle is (spec § 13).
#
# **A time is nanoseconds on the monotonic clock**, which never goes back.
#
# What it does NOT do: this process's own number, environment, folders and
# exit (`os`); a channel or memory shared with another running program
# (`ipc`); a command line written for Windows (`strings.quote_windows_args`).
# A process found by its number rather than by the handle that started it is
# refused (`process.ledger`).
#
# **A shell's job control** (POSIX): a child started in a process group of its
# own, or in another child's, any signal sent to it or to its group, a stop
# and a going on told, and the terminal handed to its group and taken back.
# Windows has no such group for a console program, and says `unsupported`.

use bytes
use io
use os
use process/hero_proc
use process/internal/clock
use process/internal/codes
use process/internal/ending
use process/internal/environment
use process/internal/fixture
use process/internal/launch
use process/internal/quoting
use process/internal/search
use process/internal/temporary
use strings
use time

## Codes

# A program that is not there: a name in no folder of PATH, or a path that
# names nothing that runs.
constant NOT_FOUND: str
    codes.NOT_FOUND

# A command's working folder names nothing.
constant FILE_NOT_FOUND: str
    codes.FILE_NOT_FOUND

# A command's working folder names what is no folder.
constant NOT_A_DIRECTORY: str
    codes.NOT_A_DIRECTORY

# The system will not run the program for this one.
constant PERMISSION: str
    codes.PERMISSION

# The input is not what the function reads: a zero byte in a word, a
# variable's name that names none, a time limit not above 0, a child given up
# already, a file that is no program; the message says which.
constant INVALID: str
    codes.INVALID

# A stream given to a child is closed.
constant CLOSED: str
    codes.CLOSED

# A child ran past its command's time limit and was ended.
constant TIMEOUT: str
    codes.TIMEOUT

# The system has no process or descriptor left, or a command holds more than
# 4,096 arguments or variables.
constant LIMIT: str
    codes.LIMIT

# This platform has no such thing: a request to end a child on Windows, a
# script holding `"` for Windows' shell.
constant UNSUPPORTED: str
    codes.UNSUPPORTED

# A child's output read as text is not UTF-8.
constant NOT_TEXT: str
    codes.NOT_TEXT

# A child did not end with the exit code 0, or the system refused for a
# reason none of the other codes names; the message says which.
constant FAILED: str
    codes.FAILED

## A command

# What a child's input is: this process's, nothing, a pipe, a stream the
# program holds, or bytes given whole.
variant Input
    # This process's own input, which the child reads beside it.
    parent
    # Nothing: the system's null device, whose end the child reads at once.
    nothing
    # A new pipe: `start` hands its writing end to the program as the child's
    # `input`, and `run` closes it at once, so the child reads its end.
    pipe
    # A stream the program holds and keeps: the child reads its own copy.
    stream
        # The stream, open to read; the program still closes it.
        stream: io.Stream
    # These bytes, then the end.
    bytes
        # The bytes the child reads; none is an input whose end comes at once.
        data: [u8]
    # This text as its UTF-8 bytes, then the end.
    text
        # The text the child reads.
        text: str

# Where a child's output or its error goes: this process's, nowhere, a pipe,
# or a stream the program holds.
variant Output
    # This process's own output, or its own error.
    parent
    # Nowhere: the system's null device.
    nothing
    # A new pipe: `start` hands its reading end to the program as the child's
    # `output` or `error`, and `run` answers every byte the child wrote to it.
    pipe
    # A stream the program holds and keeps: the child writes to its own copy.
    stream
        # The stream, open to write; the program still closes it.
        stream: io.Stream

# How long a child may run: without end, or a time from its start.
variant Limit
    # As long as it runs.
    none
    # This long from its start; past it the child is ended at once.
    after
        # How long it may run, above zero.
        limit: time.Duration

# Which process group a child starts in (POSIX): the group is what Ctrl-C and
# Ctrl-Z at the terminal reach, what `send_group_signal` sends to and what
# `give_terminal` puts in front, so a shell starts each job in a group of its
# own and hands it the terminal.
variant Group
    # This process's own group: a Ctrl-C at the terminal reaches the child and
    # this process both.
    parent
    # A group of its own, the child its leader: a job's first program.
    own
    # The group a child the program started stands in: a job's later programs
    # join its first.
    joined
        # That child's handle, as its `Child.handle`; `with_group_of` copies
        # it, and the child must not have ended when this one starts.
        leader: hero_proc.Proc

# A program to run, with its arguments, its environment, its working folder,
# what each of its three standard streams is, how long it may run and the
# process group it starts in.
# `command` builds one, and each `with_` function answers a copy with one
# thing changed.
record Command
    # The program: a path where it holds a separator (`/`, or `\` on
    # Windows), else a name looked for in the folders of PATH.
    program: str
    # The arguments after the program, each reaching the child whole.
    arguments: [str]
    # Whether the child's variables start from this process's, `true`, or
    # from none at all.
    env_inherited: bool
    # Variables set for the child over those it starts from, name to value.
    env_set: {str: str}
    # Names taken out of the variables the child starts from.
    env_removed: [str]
    # The child's working folder, "" for this process's own.
    dir: str
    # What the child's input is.
    input: Input
    # Where the child's output goes.
    output: Output
    # Where the child's error goes, unless `error_to_output`.
    error: Output
    # Whether the child's error goes where its output goes, the two
    # interleaved in the order the child writes them.
    error_to_output: bool
    # How long the child may run.
    time_limit: Limit
    # The process group the child starts in.
    group: Group

## How a child ended

# How a child ended: by itself with an exit code, by a signal on POSIX, or at
# its command's time limit.
variant Status
    # It ended by itself.
    exited
        # Its exit code: 0 to 255 on POSIX, and the code the system keeps on
        # Windows; 0 means success by convention.
        code: i64
    # A signal ended it, which happens on POSIX alone.
    signaled
        # The signal's number: 9 is SIGKILL and 15 is SIGTERM.
        signal: i64
    # Its command's time limit ran out and it was ended at once.
    timed_out

# The CPU time a child used once it has ended: its own, and on POSIX that of
# the children it waited for.
record CpuTime
    # The time spent running its own code.
    user: time.Duration
    # The time the system spent working for it.
    system: time.Duration

# What `run` answers: how the child ended, what it wrote where its command
# asked for a pipe, and the CPU time it used.
record Finished
    # How the child ended.
    status: Status
    # Every byte the child wrote to its output, where the command's output is
    # `.pipe`, and its error too where `error_to_output`; empty otherwise.
    output: [u8]
    # Every byte the child wrote to its error, where the command's error is
    # `.pipe` and not sent to its output; empty otherwise.
    error: [u8]
    # The CPU time the child used.
    cpu: CpuTime

## A started child

# Where a started child stands: running, stopped by a signal, or seen to have
# ended.
variant State
    # It runs, or it ended or stopped and no call has seen it.
    running
    # A signal stopped it, Ctrl-Z's or another, and it was not seen to go on
    # since: `wait_or_stop` or `state_of` saw it (POSIX).
    stopped
        # The signal's number, as `os.signal_of` names it.
        signal: i64
    # `wait` or `has_ended` saw it end.
    ended
        # How it ended.
        status: Status
        # The CPU time it used.
        cpu: CpuTime

# A child `start` began: its process, the program's ends of its pipes, and
# what is known of its end. `wait` ends it; `release` gives it up.
record Child
    # The floor's handle of the process, `nullptr` once `wait` or `release`
    # has given it back.
    handle: hero_proc.Proc
    # The command it was started from.
    command: Command
    # The system's number for the process, to show: the handle names the
    # process, never the number.
    id: i64
    # The writing end of the pipe that is the child's input, where its
    # command's input is `.pipe`; else a closed place, every call through
    # which fails `closed`.
    input: io.Stream
    # The reading end of the pipe that is the child's output, where its
    # command's output is `.pipe`; else a closed place.
    output: io.Stream
    # The reading end of the pipe that is the child's error, where its
    # command's error is `.pipe` and not sent to its output; else a closed
    # place.
    error: io.Stream
    # When it started, in nanoseconds on the monotonic clock: where its time
    # limit counts from.
    started: i64
    # Where it stands.
    state: State

## Building a command

# A command that runs `program` with `arguments`, with this process's
# variables, working folder, three standard streams and process group, and no
# time limit.
#
# - `program`: a path where it holds a separator (`/`, or `\` on Windows),
#   read from this process's working folder where it is relative; else a name
#   looked for in the folders of this process's PATH when the command starts.
# - `arguments`: the arguments after the program, in order, each reaching the
#   child whole, an empty one included; empty for none.
#
# Nothing is checked here: a program that is not there fails `not_found` when
# the command starts.
function command(program: str, arguments: [str]) -> Command
    return Command(
        program: program,
        arguments: arguments,
        env_inherited: true,
        env_set: {},
        env_removed: [],
        dir: "",
        input: .parent,
        output: .parent,
        error: .parent,
        error_to_output: false,
        time_limit: .none,
        group: .parent
    )

# A command that runs `script` through the system's shell: `/bin/sh -c
# script` on POSIX, and `cmd.exe /d /s /c script` on Windows.
#
# - `script`: the text the shell reads, as it would read a line typed to it;
#   empty runs nothing and ends with the code 0.
#
# Fails `unsupported` on Windows where `script` holds `"`, which the line
# Windows hands a child cannot carry to `cmd.exe` unchanged.
#
# What it costs: the shell reads every byte of `script`, so a space splits
# words, `$`, `*`, `;`, `|`, `&`, quotes and backquotes mean what the shell
# says, and a word from outside the program written into `script` can run any
# program it names. Run a program with `command` and a list wherever that can
# be done; where a shell is needed, put each outside word through `quote`. The
# shells of POSIX and of Windows read the same script differently.
function shell(script: str) -> Command?
    if os.system() != .windows
        return ok(command("/bin/sh", ["-c", script]))

    for i in range(from: 0, to: script.len())
        if script[i] == '"'
            return codes.of(
                code: codes.UNSUPPORTED,
                asked: "running a script through cmd.exe",
                why: "it holds `\"`, which the line Windows hands a child cannot carry to cmd.exe unchanged"
            )

    program: str @= os.env("ComSpec").default("")

    if program == ""
        program @ "cmd.exe"
    return ok(command(program, ["/d", "/s", "/c", script]))

# `c` with `arguments` in place of its own.
#
# - `c`: the command to copy.
# - `arguments`: the arguments after the program, in order, each reaching the
#   child whole; empty for none.
function with_arguments(c: Command, arguments: [str]) -> Command
    changed @= c
    changed.arguments @ arguments
    return changed

# `c` with the variable `name` set to `value` for its child, over the
# variables the child starts from, in place of one of that name.
#
# - `c`: the command to copy.
# - `name`: the variable's name, compared without its ASCII case on Windows as
#   the system compares it; one that is empty or holds `=` or a zero byte
#   fails `invalid` when the command starts.
# - `value`: its value, empty for a variable set empty; one holding a zero
#   byte fails `invalid` when the command starts.
function with_env(c: Command, name: str, value: str) -> Command
    folding = environment.folds()
    changed @= c
    changed.env_set @ environment.set_one(c.env_set, name: name, value: value, folding: folding)
    changed.env_removed @ environment.names_without(c.env_removed, name: name, folding: folding)
    return changed

# `c` with every one of `variables` set for its child as `with_env`
# sets one, in the map's order.
#
# - `c`: the command to copy.
# - `variables`: names to values, each held to `with_env`'s rules; an empty
#   map changes nothing.
function with_env_all(c: Command, variables: {str: str}) -> Command
    changed @= c

    for name in keys(variables)
        changed @ with_env(changed, name: name, value: variables[name].must())

    return changed

# `c` with the variable `name` out of its child's environment, whether
# `with_env` set it or it would come from this process's.
#
# - `c`: the command to copy.
# - `name`: the variable's name, compared as `with_env` compares it; a name no
#   variable holds changes nothing.
function with_env_removed(c: Command, name: str) -> Command
    folding = environment.folds()
    changed @= c
    changed.env_set @ environment.set_without(c.env_set, name: name, folding: folding)
    changed.env_removed @ environment.names_with(c.env_removed, name: name, folding: folding)
    return changed

# `c` whose child starts with no variable at all but those `with_env`
# sets after this call.
#
# - `c`: the command to copy.
#
# The command's own program is still looked for in this process's PATH.
function with_env_cleared(c: Command) -> Command
    changed @= c
    changed.env_inherited @ false
    changed.env_set @ {}
    changed.env_removed @ []
    return changed

# The variables `c`'s child would start with, name to value: this
# process's as they stand now, or none, with the command's changes made.
#
# - `c`: the command to read.
#
# Fails `not_text` where a variable it would take from this process is not
# UTF-8, and with the system's code where the environment cannot be read.
#
# The variables this process holds come first in its order, then those the
# command sets, in theirs.
function env_of(c: Command) -> {str: str}?
    return environment.listed(inherited: c.env_inherited, set: c.env_set, removed: c.env_removed)

# `c` with its child working in `dir`.
#
# - `c`: the command to copy.
# - `dir`: the child's working folder, read from this process's where it is
#   relative, "" for this process's own. One that names nothing fails
#   `file_not_found` when the command starts, one that names no folder
#   `not_a_directory`, and one holding a zero byte `invalid`.
#
# This process's own working folder never moves.
function with_dir(c: Command, dir: str) -> Command
    changed @= c
    changed.dir @ dir
    return changed

# `c` with `from` as its child's input.
#
# - `c`: the command to copy.
# - `from`: what the child reads.
function with_input(c: Command, from: Input) -> Command
    changed @= c
    changed.input @ from
    return changed

# `c` with its child's output going to `to`.
#
# - `c`: the command to copy.
# - `to`: where the child's output goes.
function with_output(c: Command, to: Output) -> Command
    changed @= c
    changed.output @ to
    return changed

# `c` with its child's error going to `to`, and no longer to its output.
#
# - `c`: the command to copy.
# - `to`: where the child's error goes.
function with_error(c: Command, to: Output) -> Command
    changed @= c
    changed.error @ to
    changed.error_to_output @ false
    return changed

# `c` with its child's error going wherever its output goes, the two
# interleaved in the order the child writes them.
#
# - `c`: the command to copy.
#
# Both reach one pipe, one stream, or one capture of `run`; `with_error`
# parts them again.
function with_error_to_output(c: Command) -> Command
    changed @= c
    changed.error_to_output @ true
    return changed

# `c` whose child may run `limit` from its start, and is ended at once past
# it.
#
# - `c`: the command to copy.
# - `limit`: how long, on the monotonic clock, above zero; zero or below
#   fails `invalid` when the command starts, since a child given no time
#   cannot run. A command given no limit runs as long as its child does.
#
# `run`, `capture`, `wait` and `has_ended` keep the limit, and a child ended
# for it reports `.timed_out`. A read of a started child's pipe waits as long
# as the child keeps the pipe open, past the limit too: read through `run`,
# or ask `has_ended` between reads.
function with_time_limit(c: Command, limit: time.Duration) -> Command
    changed @= c
    changed.time_limit @ .after(limit: limit)
    return changed

# `c` whose child starts as the leader of a process group of its own (POSIX):
# Ctrl-C at the terminal no longer reaches it with this process, and
# `send_group_signal` and `give_terminal` name its group.
#
# - `c`: the command to copy.
#
# Starting it fails `unsupported` on Windows, which has no such group for a
# console program. See also `with_group_of`.
function with_own_group(c: Command) -> Command
    changed @= c
    changed.group @ .own
    return changed

# `c` whose child starts in the process group `leader` stands in (POSIX), as a
# shell starts a pipeline's later programs in its first one's group.
#
# - `c`: the command to copy.
# - `leader`: a child the program started, which stands in a group of its
#   own and must not have ended, been waited for or given up when the command
#   starts.
#
# Starting it fails `invalid` where `leader` has ended, was waited for or
# given up, or stands in this process's own group, and `unsupported` on
# Windows. See also `with_own_group`.
function with_group_of(c: Command, leader: Child) -> Command
    changed @= c
    changed.group @ .joined(leader: leader.handle)
    return changed

## Running a command to its end

# How `c`'s child ended and what it wrote, once it has ended: started,
# fed, waited for, and what it wrote to its pipes read whole.
#
# - `c`: the command to run. Where its input is `.pipe` the child reads
#   its end at once; where its output or its error is `.pipe`, every byte
#   written there is answered.
#
# Fails `not_found` where the program is not there; `file_not_found` or
# `not_a_directory` for its working folder; `permission` where the system
# will not run it; `invalid` where a word holds a zero byte, a variable's
# name names none, the time limit is not above 0 or the file is no program;
# `closed` where a stream given to the child is closed; `limit` where the
# system has no process or descriptor left or the command holds more than
# 4,096 arguments or variables; and `failed`, with the system's number, where
# it refuses for another reason. A child that ends with another code than 0
# is no failure: its status says so.
#
# What the child writes to a pipe passes through a temporary file in the
# system's temporary folder, removed before `run` answers, so a child that
# writes much is never stopped by a full pipe and its time limit is kept
# whatever it writes; the bytes are held in memory once it ends. A failure
# after the start ends the child at once, so nothing it started outlives it.
function run(c: Command) -> Finished?
    files @= temporary.prepared(output: c.output == .pipe, error: c.error == .pipe && !c.error_to_output)?
    plan @= c

    if c.input == .pipe
        plan.input @ .nothing

    if files.output
        plan.output @ .stream(stream: files.output_file.stream)

    if files.error
        plan.error @ .stream(stream: files.error_file.stream)

    match start(plan)
        .err e =>
            temporary.discarded(@files)
            return fail(code: e.code, msg: e.msg)
        .ok begun =>
            child @= begun
            temporary.written(@files)

            match wait(@child)
                .err e =>
                    _ = hero_proc.kill(child.handle)
                    _ = hero_proc.release(@child.handle)
                    child.handle @ nullptr
                    launch.dropped(@child.input)
                    launch.dropped(@child.output)
                    launch.dropped(@child.error)
                    temporary.discarded(@files)
                    return fail(code: e.code, msg: e.msg)
                .ok status =>
                    got = temporary.collected(@files)?
                    return ok(Finished(status: status, output: got.output, error: got.error, cpu: cpu_of(child)?))

# The text `c`'s child writes to its output, once it has ended with the
# exit code 0.
#
# - `c`: the command to run; its output is captured whatever it says,
#   and its input and its error are as it says.
#
# Fails as `run` does; `failed` where the child ends with another code or by
# a signal, the message saying how and holding what it wrote to its error
# where that is `.pipe`; `timeout` where its time limit ran out; `not_text`
# where its output is not UTF-8.
#
# The text is every byte written, the last line's end included.
function capture(c: Command) -> str?
    finished = run(with_output(c, to: .pipe))?
    asked = f"capturing the output of \"{c.program}\""

    if finished.status == .timed_out
        return codes.of(code: codes.TIMEOUT, asked: asked, why: "it ran past its time limit and was ended")

    if !is_success(finished.status)
        return codes.of(
            code: codes.FAILED,
            asked: asked,
            why: codes.told(f"it {format_status(finished.status)}", error: finished.error)
        )

    match finished.output.validated_bytes()
        .ok text => return ok(text)
        .err _   => return codes.of(code: codes.NOT_TEXT, asked: asked, why: "its output is not UTF-8")

## A started child

# A child running `c`, begun and not waited for: the program writes to
# its input and reads its output and its error through the `io.Stream`s of
# the answer, then ends it with `wait`, or gives it up with `release`.
#
# - `c`: the command to start. Where its input is `.bytes` or `.text`,
#   the bytes pass through a temporary file, removed before `start` answers.
#
# Fails as `run` does.
#
# The time limit counts from here. A child whose output and error are both
# `.pipe` is read on both: one full while the program waits on the other
# stops the child, and the program with it; `with_error_to_output`, or `run`,
# leaves nothing to interleave.
function start(c: Command) -> Child?
    asked = f"starting \"{c.program}\""

    match c.time_limit
        .none => _ = 0
        .after given =>
            if given.limit.nanoseconds <= 0
                return codes.of(
                    code: codes.INVALID,
                    asked: asked,
                    why: f"its time limit is {time.format_duration(given.limit)}, where a limit is above zero"
                )

    env = environment.given(inherited: c.env_inherited, set: c.env_set, removed: c.env_removed, asked: asked)?
    fed: [u8] @= []
    feeding: bool @= false

    input = match c.input
        .parent      => launch.plain(hero_proc.HERO_PROC_STDIO_PARENT)
        .nothing     => launch.plain(hero_proc.HERO_PROC_STDIO_NOTHING)
        .pipe        => launch.plain(hero_proc.HERO_PROC_STDIO_PIPE)
        .stream held => launch.End(kind: hero_proc.HERO_PROC_STDIO_STREAM, stream: held.stream.handle)
        .bytes given =>
            fed @ given.data
            feeding @ true
            launch.plain(hero_proc.HERO_PROC_STDIO_NOTHING)
        .text given =>
            fed @ bytes.from_text(given.text)
            feeding @ true
            launch.plain(hero_proc.HERO_PROC_STDIO_NOTHING)

    output = match c.output
        .parent      => launch.plain(hero_proc.HERO_PROC_STDIO_PARENT)
        .nothing     => launch.plain(hero_proc.HERO_PROC_STDIO_NOTHING)
        .pipe        => launch.plain(hero_proc.HERO_PROC_STDIO_PIPE)
        .stream held => launch.End(kind: hero_proc.HERO_PROC_STDIO_STREAM, stream: held.stream.handle)

    error = match c.error
        .parent      => launch.plain(hero_proc.HERO_PROC_STDIO_PARENT)
        .nothing     => launch.plain(hero_proc.HERO_PROC_STDIO_NOTHING)
        .pipe        => launch.plain(hero_proc.HERO_PROC_STDIO_PIPE)
        .stream held => launch.End(kind: hero_proc.HERO_PROC_STDIO_STREAM, stream: held.stream.handle)

    group = match c.group
        .parent => launch.ungrouped()
        .own    => launch.Grouping(kind: hero_proc.HERO_PROC_GROUP_NEW, leader: nullptr)
        .joined j =>
            if j.leader == nullptr
                return codes.of(
                    code: codes.INVALID,
                    asked: asked,
                    why: "the group's leader was waited for or given up, so it names no group"
                )
            launch.Grouping(kind: hero_proc.HERO_PROC_GROUP_JOIN, leader: j.leader)

    began = clock.now()?
    begun = launch.started(program: c.program, arguments: c.arguments, env: env, dir: c.dir, input: input, output: output, error: error, fed: fed, feeding: feeding, merged: c.error_to_output, group: group)?
    return ok(
        Child(handle: begun.proc, command: c, id: hero_proc.id(begun.proc), input: begun.input, output: begun.output, error: begun.error, started: began, state: .running)
    )

# How `child` ended, waiting for it. Its input's end is closed first, so a
# child reading it to the end goes on; once it has ended, every end of its
# pipes the program did not close is closed and its process is given back.
#
# - `child`: the child to wait for. Asked again, it answers the same at once.
#
# Fails `invalid` where `child` was given up by `release`, and `failed` with
# the system's number where it cannot be waited for; the child is then still
# the program's, to `kill` and `release`.
#
# Read the child's pipes to their end before waiting: they are closed here,
# so a read after `wait` fails `closed`, and a child that fills a pipe nobody
# reads never ends. Past its command's time limit the child is ended at once
# and its status is `.timed_out`. A stopped child is waited for until it
# ends, so it is sent `.resume` first (`send_signal`), or waited for with
# `wait_or_stop`.
function wait(@child: Child) -> Status?
    asked = f"waiting for \"{child.command.program}\""

    unended = match child.state
        .ended _              => false
        .running | .stopped _ => true

    if unended
        if child.handle == nullptr
            return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")
        launch.dropped(@child.input)

        limit = match child.command.time_limit
            .none        => 0
            .after given => given.limit.nanoseconds

        seen = ending.waited(child.handle, started: child.started, limit: limit, asked: asked, program: child.command.program)?

        status: Status = if seen.timed_out
            .timed_out
        else if seen.signal != 0
            .signaled(signal: seen.signal)
        else
            .exited(code: seen.code)
        child.state @ .ended(
            status: status,
            cpu: CpuTime(user: time.nanoseconds(seen.user_ns), system: time.nanoseconds(seen.system_ns))
        )
    launch.dropped(@child.input)
    launch.dropped(@child.output)
    launch.dropped(@child.error)

    if child.handle != nullptr
        _ = hero_proc.release(@child.handle)
        child.handle @ nullptr

    match child.state
        .ended seen => return ok(seen.status)
        .running | .stopped _ => return codes.of(
            code: codes.INVALID,
            asked: asked,
            why: "the child was not seen to end"
        )

# Whether `child` has ended, never waiting for it: `true` once it has, its
# status kept for `wait`.
#
# - `child`: the child to ask. Past its command's time limit it is ended at
#   once and `true` is answered.
#
# Fails as `wait` does.
function has_ended(@child: Child) -> bool?
    asked = f"asking whether \"{child.command.program}\" has ended"

    match child.state
        .ended _              => return ok(true)
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    limit = match child.command.time_limit
        .none        => 0
        .after given => given.limit.nanoseconds

    seen = ending.looked(child.handle, started: child.started, limit: limit, asked: asked, program: child.command.program)?

    if !seen.ended
        return ok(false)

    status: Status = if seen.timed_out
        .timed_out
    else if seen.signal != 0
        .signaled(signal: seen.signal)
    else
        .exited(code: seen.code)
    child.state @ .ended(
        status: status,
        cpu: CpuTime(user: time.nanoseconds(seen.user_ns), system: time.nanoseconds(seen.system_ns))
    )
    return ok(true)

# Asks `child` to end: SIGTERM on POSIX, which a program may catch to end
# cleanly, or not end at all.
#
# - `child`: the child to ask. One that has ended already is sent nothing.
#
# Fails `unsupported` on Windows, which has no such request for a console
# program, so `kill` ends it there; `invalid` where `child` was given up by
# `release`.
function terminate(child: Child) -> ()?
    asked = f"asking \"{child.command.program}\" to end"

    match child.state
        .ended _              => return ok()
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    if hero_proc.terminate(child.handle) < 0
        return codes.last(asked: asked, program: child.command.program, dir: "")
    return ok()

# Ends `child` at once: SIGKILL on POSIX, and on Windows the end of its
# process with the exit code 1.
#
# - `child`: the child to end. One that has ended already is sent nothing.
#
# Fails `invalid` where `child` was given up by `release`, and `failed` with
# the system's number where it cannot be ended.
#
# The child may not have ended yet when this answers: `wait` for it.
function kill(child: Child) -> ()?
    asked = f"ending \"{child.command.program}\" at once"

    match child.state
        .ended _              => return ok()
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    if hero_proc.kill(child.handle) < 0
        return codes.last(asked: asked, program: child.command.program, dir: "")
    return ok()

# Gives `child` up: every end of its pipes the program did not close is
# closed and its process given back, so nothing of it is the program's.
#
# - `child`: the child to give up. One `wait` ended, or given up already, is
#   no failure.
#
# Fails with the code of the first end that could not be closed; the rest is
# given up either way.
#
# A child that still runs runs on, and the system keeps no record of it once
# it ends.
function release(@child: Child) -> ()?
    closed = launch.closed_all(input: @child.input, output: @child.output, error: @child.error)

    if child.handle != nullptr
        _ = hero_proc.release(@child.handle)
        child.handle @ nullptr
    return closed

# The CPU time `child` used, once `wait` or `has_ended` has seen it end.
#
# - `child`: the child to ask.
#
# Fails `invalid` where it has not been seen to end.
function cpu_of(child: Child) -> CpuTime?
    match child.state
        .ended seen => return ok(seen.cpu)
        .running | .stopped _ =>
            return codes.of(
                code: codes.INVALID,
                asked: f"reading the CPU time of \"{child.command.program}\"",
                why: "it has not been seen to end; `wait` for it"
            )

# What `child` holds and has spent now, while it runs: its resident and
# virtual memory and the processor time it has used, as `os.process_usage`
# reads a process.
#
# - `child`: a child `start` began, not yet seen to end by `wait` or
#   `has_ended` and not given up by `release`.
#
# A child that has ended and that neither `wait` nor `has_ended` has seen yet
# answers what the system still keeps of it, which `os.process_usage` says.
#
# Fails `invalid` where `child` has been seen to end or was given up, since its
# id may name another process by then (`cpu_of` answers an ended child's
# time); and where `os.process_usage` fails, with its code. See also `cpu_of`.
function usage_of(child: Child) -> os.ProcessUsage?
    if child.handle == nullptr
        return codes.of(
            code: codes.INVALID,
            asked: f"reading the usage of \"{child.command.program}\"",
            why: "it was waited for or given up, and its id may name another process now"
        )

    match child.state
        .ended _ =>
            return codes.of(
                code: codes.INVALID,
                asked: f"reading the usage of \"{child.command.program}\"",
                why: "it has been seen to end; `cpu_of` answers the time it used"
            )
        .running | .stopped _ => return os.process_usage(child.id)

## Job control

# Where `child` stands now, never waiting: running, stopped by a signal, or
# ended, a stop and a going on seen as well as an end, as a shell asks of each
# job before its prompt.
#
# - `child`: the child to ask; what is seen is kept in its `state`, and once
#   it has ended `wait` answers at once. Past its command's time limit it is
#   ended at once, a stopped child too.
#
# Fails as `wait` does. A child stays `.stopped` until a call sees it go on or
# end. On Windows no child stops, so it is `.running` or `.ended`. See also
# `wait_or_stop`, `has_ended`.
function state_of(@child: Child) -> State?
    asked = f"asking where \"{child.command.program}\" stands"

    match child.state
        .ended _              => return ok(child.state)
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    limit = match child.command.time_limit
        .none        => 0
        .after given => given.limit.nanoseconds

    seen = ending.looked_state(child.handle, started: child.started, limit: limit, asked: asked, program: child.command.program)?

    if seen.ended
        status: Status = if seen.timed_out
            .timed_out
        else if seen.signal != 0
            .signaled(signal: seen.signal)
        else
            .exited(code: seen.code)
        child.state @ .ended(
            status: status,
            cpu: CpuTime(user: time.nanoseconds(seen.user_ns), system: time.nanoseconds(seen.system_ns))
        )
    else if seen.stop_signal != 0
        child.state @ .stopped(signal: seen.stop_signal)
    else
        child.state @ .running
    return ok(child.state)

# How `child` ended, or the signal that stopped it, waiting for the first of
# the two: what a shell waits for of the job it runs in front, which Ctrl-Z
# stops.
#
# - `child`: the child to wait for. A stop it was seen in before this call is
#   waited past until it goes on, so a stopped child is sent `.resume` first
#   (`send_group_signal`); one that has ended answers at once.
#
# Answers `.ended` or `.stopped`, never `.running`. On an end it does what
# `wait` does, every end of its pipes closed and its process given back; on a
# stop its pipes stay as they are. Past its command's time limit the child is
# ended at once and its status is `.timed_out`.
#
# Fails as `wait` does. On Windows no child stops, and it waits for the end.
# See also `state_of`, `wait`.
function wait_or_stop(@child: Child) -> State?
    asked = f"waiting for \"{child.command.program}\" to end or stop"

    was_stopped = match child.state
        .ended _   => return ok(child.state)
        .running   => false
        .stopped _ => true

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    limit = match child.command.time_limit
        .none        => 0
        .after given => given.limit.nanoseconds

    seen = ending.waited_state(child.handle, started: child.started, limit: limit, was_stopped: was_stopped, asked: asked, program: child.command.program)?

    if !seen.ended
        child.state @ .stopped(signal: seen.stop_signal)
        return ok(child.state)

    status: Status = if seen.timed_out
        .timed_out
    else if seen.signal != 0
        .signaled(signal: seen.signal)
    else
        .exited(code: seen.code)
    child.state @ .ended(
        status: status,
        cpu: CpuTime(user: time.nanoseconds(seen.user_ns), system: time.nanoseconds(seen.system_ns))
    )
    _ = wait(@child)?
    return ok(child.state)

# Sends `signal` to `child` alone: a stop, a going on, Ctrl-C's, or any other
# signal `os.Signal` names (POSIX).
#
# - `child`: the child; one that has ended is sent nothing.
# - `signal`: the signal sent.
#
# Fails `invalid` where `child` was given up by `release`, `unsupported` on
# Windows, where a console's signals reach its whole group and never one
# process, and with the system's code where it refuses. See also
# `send_group_signal`, `terminate`, `kill`.
function send_signal(child: Child, signal: os.Signal) -> ()?
    asked = f"sending {os.signal_name(signal)} to \"{child.command.program}\""

    match child.state
        .ended _              => return ok()
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")
    number = os.signal_number(signal)?

    if hero_proc.signal(child.handle, sig: number, group: 0) < 0
        return codes.last(asked: asked, program: child.command.program, dir: "")
    return ok()

# Sends `signal` to every process of the group `child` stands in, its own
# children included: what a shell sends a job to stop it, continue it or end
# it (POSIX).
#
# - `child`: a child of the group that has not ended, started by a command
#   `with_own_group` or `with_group_of` made.
# - `signal`: the signal sent.
#
# Fails `invalid` where `child` has ended, since a group is named by a child of
# it that runs or is stopped, where it was given up by `release`, and where it
# stands in this process's own group, which the signal would reach too;
# `unsupported` on Windows; and with the system's code where it refuses.
#
# The group is read and sent to while nothing has taken `child`'s status, so
# its number names that group and no other. See also `send_signal`.
function send_group_signal(child: Child, signal: os.Signal) -> ()?
    asked = f"sending {os.signal_name(signal)} to the group of \"{child.command.program}\""

    match child.state
        .ended _ =>
            return codes.of(
                code: codes.INVALID,
                asked: asked,
                why: "the child has ended, so it names no group: name it by a child of it that runs or is stopped"
            )
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")
    number = os.signal_number(signal)?

    if hero_proc.signal(child.handle, sig: number, group: 1) < 0
        return codes.last(asked: asked, program: child.command.program, dir: "")
    return ok()

# Puts the group `child` stands in in front at the terminal `terminal`, so
# Ctrl-C, Ctrl-Z and the terminal's reads reach that group and not this
# process: what a shell does for the job it runs in front (POSIX).
#
# - `child`: a child of the group, as `send_group_signal` takes it.
# - `terminal`: a stream on this process's controlling terminal, a shell's
#   input; it stays the program's.
#
# Fails `unsupported` where `terminal` is no terminal, or not this process's
# controlling one, and on Windows; `invalid` as `send_group_signal` fails it. This
# process may be outside the terminal's front when it calls: the signal the
# system would stop it with is held for the call. See also `take_terminal`,
# `holds_terminal`.
function give_terminal(child: Child, terminal: io.Stream) -> ()?
    asked = f"giving the terminal to the group of \"{child.command.program}\""

    match child.state
        .ended _ =>
            return codes.of(
                code: codes.INVALID,
                asked: asked,
                why: "the child has ended, so it names no group: name it by a child of it that runs or is stopped"
            )
        .running | .stopped _ => _ = 0

    if child.handle == nullptr
        return codes.of(code: codes.INVALID, asked: asked, why: "the child was given up by `release`")

    if hero_proc.give_terminal(terminal.handle, p: child.handle) < 0
        return codes.last(asked: asked, program: child.command.program, dir: "")
    return ok()

# Puts this process's own group in front at `terminal` again: what a shell
# does once the job it ran in front ended or stopped (POSIX).
#
# - `terminal`: a stream on this process's controlling terminal; it stays
#   the program's.
#
# Fails `unsupported` where `terminal` is no terminal, or not this process's
# controlling one, and on Windows. See also `give_terminal`.
function take_terminal(terminal: io.Stream) -> ()?
    if hero_proc.take_terminal(terminal.handle) < 0
        return codes.last(asked: "taking the terminal back", program: "", dir: "")
    return ok()

# Whether this process's own group is in front at `terminal`: a shell takes
# job control only where it holds its terminal (POSIX).
#
# - `terminal`: a stream on this process's controlling terminal; it stays
#   the program's.
#
# Fails `unsupported` where `terminal` is no terminal, or not this process's
# controlling one, and on Windows. See also `give_terminal`.
function holds_terminal(terminal: io.Stream) -> bool?
    held = hero_proc.holds_terminal(terminal.handle)

    if held < 0
        return codes.last(asked: "asking who holds the terminal", program: "", dir: "")
    return ok(held == 1)

## Asking how a child ended

# Whether `status` says the child ended by itself with the exit code 0.
#
# - `status`: how the child ended.
function is_success(status: Status) -> bool
    return status == .exited(code: 0)

# The exit code `status` holds.
#
# - `status`: how the child ended.
#
# Fails `not_found` where a signal or the time limit ended the child.
function code_of(status: Status) -> i64?
    match status
        .exited e => return ok(e.code)
        .signaled _ | .timed_out =>
            return codes.of(
                code: codes.NOT_FOUND,
                asked: "reading an exit code",
                why: f"the child {format_status(status)}"
            )

# The number of the signal that ended the child, on POSIX.
#
# - `status`: how the child ended.
#
# Fails `not_found` where the child ended by itself or at its time limit.
function signal_of(status: Status) -> i64?
    match status
        .signaled s => return ok(s.signal)
        .exited _ | .timed_out =>
            return codes.of(
                code: codes.NOT_FOUND,
                asked: "reading the signal that ended a child",
                why: f"the child {format_status(status)}"
            )

# Nothing, where `status` says the child ended by itself with the exit code
# 0.
#
# - `status`: how the child ended.
#
# Fails `failed` where it ended with another code or by a signal, and
# `timeout` where its time limit ended it; the message says which.
function require_success(status: Status) -> ()?
    if status == .timed_out
        return codes.of(
            code: codes.TIMEOUT,
            asked: "asking a child's success",
            why: "it ran past its time limit and was ended"
        )

    if !is_success(status)
        return codes.of(
            code: codes.FAILED,
            asked: "asking a child's success",
            why: f"it {format_status(status)}, where the code 0 was asked"
        )
    return ok()

# `status` as words to show: `exited with code 3`, `ended by signal 9`, or
# `ended at its time limit`.
#
# - `status`: how the child ended.
function format_status(status: Status) -> str
    return match status
        .exited e   => f"exited with code {e.code}"
        .signaled s => f"ended by signal {s.signal}"
        .timed_out  => "ended at its time limit"

## Finding a program

# Where `start` finds `program`: `program` itself where it holds a separator
# and names a file that runs, else the first file named `program` that runs
# in the folders the search reads.
#
# - `program`: a path, or a name; on Windows a name with no extension is
#   looked for with `.exe`.
#
# Fails `not_found` where no such file is there, and `invalid` where
# `program` is empty or holds a zero byte.
#
# On POSIX the folders are those of PATH in its order, an empty entry being
# this process's working folder, and `/usr/bin` then `/bin` where PATH is not
# set; a file runs where it is a file, its links followed, and a permission
# bit lets someone run it. On Windows they are this program's folder, the
# working folder, the system's folders, then PATH; a file runs where it is a
# file. A file found may still be refused at the start: by the rights of the
# user who runs it, or on Windows as a batch file.
function path_of(program: str) -> str?
    return search.located(program)

## Quoting for a POSIX shell

# `word` as a POSIX shell reads it back whole: as it is where it holds only
# ASCII letters, digits and `@%+=:,./-_`, else between single quotes, each
# `'` in it written `'"'"'`.
#
# - `word`: any text; empty is `''`.
#
# For `sh` and the shells that keep its rules, never for Windows' `cmd.exe`.
# See also `strings.quote_windows_arg`, which writes a word as a Windows
# program's C runtime reads it back.
function quote(word: str) -> str
    return quoting.quoted(word)

# Every one of `words` put through `quote`, joined with one space: a line a
# POSIX shell reads back as those words.
#
# - `words`: the words, in order; none is "".
function quote_all(words: [str]) -> str
    return quoting.quoted_all(words)

## Tests

test "command: what it holds before any change"
    c = command("cat", ["-u"])
    assert c.program == "cat" && c.arguments == ["-u"]
    assert c.env_inherited && keys(c.env_set).len() == 0 && c.env_removed.len() == 0
    assert c.dir == "" && c.input == .parent && c.output == .parent && c.error == .parent
    assert !c.error_to_output && c.time_limit == .none

test "the with_ functions: each changes one thing, and with_error parts what with_error_to_output joined"
    none: [str] = []
    c = command("cat", none)
    assert with_arguments(c, arguments: ["a", ""]).arguments == ["a", ""]
    assert with_arguments(c, arguments: none) == c
    assert with_dir(c, dir: "/tmp").dir == "/tmp"
    assert with_input(c, from: .nothing).input == .nothing
    assert with_input(c, from: .text(text: "")).input == .text(text: "")
    assert with_output(c, to: .pipe).output == .pipe
    assert with_error(c, to: .nothing).error == .nothing
    joined = with_error_to_output(c)
    assert joined.error_to_output
    assert !with_error(joined, to: .pipe).error_to_output
    assert with_time_limit(c, limit: time.nanoseconds(5)).time_limit == .after(limit: time.nanoseconds(5))
    assert c.dir == "" && c.output == .parent

test "with_env, with_env_all, with_env_removed and with_env_cleared, read back by env_of"
    none: [str] = []
    c = command("cat", none)
    set = with_env(c, name: "REBEL_WORD", value: "bowie")
    assert env_of(set).must()["REBEL_WORD"].must() == "bowie"
    again = with_env(set, name: "REBEL_WORD", value: "")
    assert again.env_set["REBEL_WORD"].must() == ""
    assert keys(again.env_set) == ["REBEL_WORD"]
    removed = with_env_removed(again, name: "REBEL_WORD")
    assert keys(removed.env_set).len() == 0
    assert removed.env_removed == ["REBEL_WORD"]
    assert env_of(removed).must()["REBEL_WORD"].is_err()
    assert env_of(with_env_removed(c, name: "PATH")).must()["PATH"].is_err()
    assert env_of(with_env_removed(c, name: "REBEL_NOT_SET")).must() == env_of(c).must()
    cleared = with_env_cleared(with_env(c, name: "A", value: "1"))
    assert keys(env_of(cleared).must()).len() == 0
    many = with_env_all(cleared, variables: {"A": "1", "B": "2"})
    assert keys(env_of(many).must()) == ["A", "B"]
    empty: {str: str} = {}
    assert with_env_all(c, variables: empty) == c

test "run: an exit code of 0 and of 3, nothing captured where no pipe was asked for, and the CPU time"
    zero = run(with_output(shell(fixture.exit_script(0)).must(), to: .nothing)).must()
    assert zero.status == .exited(code: 0)
    assert zero.output.len() == 0 && zero.error.len() == 0
    assert zero.cpu.user.nanoseconds >= 0 && zero.cpu.system.nanoseconds >= 0
    three = run(shell(fixture.exit_script(3)).must()).must()
    assert three.status == .exited(code: 3)

test "run: the output captured, the error captured, and both joined in the order written"
    out = run(with_output(shell("echo hello").must(), to: .pipe)).must()
    assert fixture.line(out.output) == "hello" && out.error.len() == 0
    err = run(with_error(shell(fixture.error_script("oops")).must(), to: .pipe)).must()
    assert fixture.line(err.error) == "oops" && err.output.len() == 0
    both_script = fixture.both_script(first: "one", second: "two")
    parted = run(with_error(with_output(shell(both_script).must(), to: .pipe), to: .pipe)).must()
    assert fixture.line(parted.output) == "one" && fixture.line(parted.error) == "two"
    joined = run(with_error_to_output(with_output(shell(both_script).must(), to: .pipe))).must()
    assert fixture.unix_lines(fixture.line(joined.output)) == "one\ntwo"
    assert joined.error.len() == 0

test "run: input as bytes, as text of more than one byte a character, none, and a pipe whose end comes at once"
    none: [str] = []
    copy = with_output(command(fixture.copier(), none), to: .pipe)
    raw = run(with_input(copy, from: .bytes(data: [114, 101, 98, 101, 108, 10]))).must()
    assert fixture.line(raw.output) == "rebel"
    text = run(with_input(copy, from: .text(text: "héros\n"))).must()
    assert fixture.line(text.output) == "héros"
    empty: [u8] = []
    nothing = run(with_input(copy, from: .bytes(data: empty))).must()
    assert nothing.output.len() == 0 && nothing.status == .exited(code: 0)
    piped = run(with_input(copy, from: .pipe)).must()
    assert piped.output.len() == 0 && piped.status == .exited(code: 0)
    silent = run(with_input(copy, from: .nothing)).must()
    assert silent.output.len() == 0

# POSIX alone: a megabyte from `head`, more than any pipe holds, which would
# stop a child writing into a pipe nobody reads.
test "run: a megabyte of output and a megabyte of input pass whole, with no pipe to fill"
    if !fixture.on_windows()
        big = run(with_output(shell("head -c 1048576 /dev/zero").must(), to: .pipe)).must()
        assert big.output.len() == 1048576
        data: [u8] @= []

        for i in range(from: 0, to: 1048576)
            data @ data.push((i % 251).to_u8().must())

        none: [str] = []
        back = run(with_output(with_input(command(fixture.copier(), none), from: .bytes(data: data)), to: .pipe)).must()
        assert back.output == data

test "run: a working folder, and one that names nothing or names a file"
    here = run(with_output(with_dir(shell(fixture.folder_script()).must(), dir: fixture.a_folder()), to: .pipe)).must()
    assert fixture.same_path(a: fixture.line(here.output), b: fixture.a_folder())

    match run(with_dir(shell("echo").must(), dir: "build/rebel-process-no-such-folder"))
        .ok _ => assert false
        .err e =>
            assert e.code == FILE_NOT_FOUND
            assert e.msg == f"starting \"{fixture.shell_program()}\": the working folder \"build/rebel-process-no-such-folder\" names nothing"

    match run(with_dir(shell("echo").must(), dir: fixture.shell_program()))
        .ok _  => assert false
        .err e => assert e.code == NOT_A_DIRECTORY

test "run: a program that is not there, a zero byte, an empty program, and a variable's name that names none"
    none: [str] = []

    match run(command("rebel-no-such-program", none))
        .ok _ => assert false
        .err e =>
            assert e.code == NOT_FOUND
            assert e.msg == "starting \"rebel-no-such-program\": no program \"rebel-no-such-program\" in the folders of PATH"

    match run(command("build/rebel-no-such-folder/program", none))
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    zero_bytes: [u8] = [97, 0]
    zero = zero_bytes.validated_bytes().must()

    match run(command("/bin/echo", [zero]))
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match run(command("", none))
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match run(with_env(command("/bin/echo", none), name: "A=B", value: "x"))
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match run(with_env(command("/bin/echo", none), name: "", value: "x"))
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "run: a time limit of zero, one below, and one a quick child never meets"
    quick = shell(fixture.exit_script(0)).must()

    match run(with_time_limit(quick, limit: time.nanoseconds(0)))
        .ok _ => assert false
        .err e =>
            assert e.code == INVALID
            assert e.msg == f"starting \"{fixture.shell_program()}\": its time limit is 0s, where a limit is above zero"

    match run(with_time_limit(quick, limit: time.nanoseconds(-1)))
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert run(with_time_limit(quick, limit: time.seconds(60).must())).must().status == .exited(code: 0)
    assert run(with_time_limit(quick, limit: time.max_duration())).must().status == .exited(code: 0)

test "run: a child past its time limit of 200 ms is ended, and its status says so"
    sleepy = with_time_limit(
        command(fixture.sleeper(), fixture.sleeper_arguments(30)),
        limit: time.milliseconds(200).must()
    )
    ended = run(with_output(sleepy, to: .nothing)).must()
    assert ended.status == .timed_out

test "run: a stream the program holds, as the child's output and as its input, and one that is closed"
    pair @= io.pipe().must()
    wrote = run(with_output(shell("echo held").must(), to: .stream(stream: pair.writer))).must()
    assert wrote.status == .exited(code: 0)
    io.close(@pair.writer).must()
    assert fixture.line(io.read_all(pair.reader).must()) == "held"
    io.close(@pair.reader).must()
    shut @= io.pipe().must()
    io.close(@shut.reader).must()
    none: [str] = []

    match run(with_input(command(fixture.copier(), none), from: .stream(stream: shut.reader)))
        .ok _  => assert false
        .err e => assert e.code == CLOSED

    io.close(@shut.writer).must()

test "shell: an empty script, a script that the shell reads, and a word quoted for it"
    assert run(shell("").must()).must().status == .exited(code: 0)

    # `cmd.exe` parts two commands with `&` and ends a line with CR LF; `quote`
    # writes for POSIX's shells alone, so no shell of Windows reads it back.
    if fixture.on_windows()
        assert capture(shell("echo a& echo b").must()).must() == "a\r\nb\r\n"
    else
        assert capture(shell("echo a; echo b").must()).must() == "a\nb\n"
        word = "it's $HOME; *"
        assert capture(shell("printf %s " + quote(word)).must()).must() == word

test "capture: the output as text, a failure holding the error's text, a time limit, and bytes that are no text"
    hello = capture(shell("echo hello").must()).must()

    if fixture.on_windows()
        assert hello == "hello\r\n"
    else
        assert hello == "hello\n"

    assert capture(shell("").must()).must() == ""
    failing = with_error(shell(fixture.error_script("broken") + " && " + fixture.exit_script(2)).must(), to: .pipe)

    match capture(failing)
        .ok _ => assert false
        .err e =>
            assert e.code == FAILED
            assert e.msg == f"capturing the output of \"{fixture.shell_program()}\": it exited with code 2; its error ends: broken"

    match capture(with_time_limit(command(fixture.sleeper(), fixture.sleeper_arguments(30)), limit: time.milliseconds(100).must()))
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

    match capture(shell(fixture.no_text_script()).must())
        .ok _  => assert false
        .err e => assert e.code == NOT_TEXT

test "start: text written to a child's input comes back from its output, and wait answers its end"
    none: [str] = []
    child @= start(with_output(with_input(command(fixture.copier(), none), from: .pipe), to: .pipe)).must()
    assert child.id > 0
    assert child.state == .running
    assert io.is_closed(child.error)
    io.write_text(child.input, text: "rebel\n").must()
    io.close(@child.input).must()
    assert fixture.line(io.read_all(child.output).must()) == "rebel"
    assert wait(@child).must() == .exited(code: 0)
    assert child.handle == nullptr
    assert io.is_closed(child.output)
    assert wait(@child).must() == .exited(code: 0)
    assert cpu_of(child).must().user.nanoseconds >= 0
    release(@child).must()

test "start: wait closes the input first, so a child reading to its end goes on, and every end after"
    none: [str] = []
    child @= start(with_output(with_input(command(fixture.copier(), none), from: .pipe), to: .pipe)).must()
    io.write_text(child.input, text: "x\n").must()
    assert wait(@child).must() == .exited(code: 0)
    assert io.is_closed(child.input) && io.is_closed(child.output)

    match io.read_all(child.output)
        .ok _  => assert false
        .err e => assert e.code == io.CLOSED

test "start: kill ends a child at once, terminate asks one to end, and neither sends anything to one that ended"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(30))).must()
    assert !has_ended(@child).must()
    assert cpu_of(child).is_err()
    kill(child).must()
    status = wait(@child).must()

    if fixture.on_windows()
        assert status == .exited(code: 1)
    else
        assert status == .signaled(signal: 9)
    kill(child).must()
    terminate(child).must()
    asked @= start(command(fixture.sleeper(), fixture.sleeper_arguments(30))).must()

    match terminate(asked)
        .ok _ => assert wait(@asked).must() == .signaled(signal: 15)
        .err e =>
            assert fixture.on_windows() && e.code == UNSUPPORTED
            kill(asked).must()
            assert wait(@asked).must() == .exited(code: 1)

test "start: has_ended answers false while the child runs, true once it ended, and the status then waits for nobody"
    child @= start(shell(fixture.exit_script(4)).must()).must()

    while !has_ended(@child).must()
        _ = 0

    assert child.state != .running
    assert child.handle != nullptr
    assert wait(@child).must() == .exited(code: 4)
    assert child.handle == nullptr

test "start: has_ended and wait past a time limit end the child, and its status says so"
    sleepy = with_time_limit(
        command(fixture.sleeper(), fixture.sleeper_arguments(30)),
        limit: time.milliseconds(100).must()
    )
    polled @= start(sleepy).must()

    while !has_ended(@polled).must()
        _ = 0

    assert wait(@polled).must() == .timed_out
    waited @= start(sleepy).must()
    assert wait(@waited).must() == .timed_out

test "start: the output and the error joined into one pipe, and the error alone a pipe of its own"
    both_script = fixture.both_script(first: "one", second: "two")
    joined @= start(with_error_to_output(with_output(shell(both_script).must(), to: .pipe))).must()
    assert io.is_closed(joined.error)
    assert fixture.unix_lines(fixture.line(io.read_all(joined.output).must())) == "one\ntwo"
    assert wait(@joined).must() == .exited(code: 0)
    parted @= start(with_error(shell(both_script).must(), to: .pipe)).must()
    assert io.is_closed(parted.output)
    assert fixture.line(io.read_all(parted.error).must()) == "two"
    assert wait(@parted).must() == .exited(code: 0)

test "start: one child's output is another's input, a pipeline with no shell"
    none: [str] = []
    first @= start(with_output(shell("echo rebel").must(), to: .pipe)).must()
    second @= start(
        with_output(with_input(command(fixture.copier(), none), from: .stream(stream: first.output)), to: .pipe)
    ).must()
    io.close(@first.output).must()
    assert fixture.line(io.read_all(second.output).must()) == "rebel"
    assert wait(@first).must() == .exited(code: 0)
    assert wait(@second).must() == .exited(code: 0)

test "start: a child writing into a pipe the program holds ends by SIGPIPE once its reader is gone, and the program's own writes there still answer"
    if !fixture.on_windows()
        none: [str] = []
        gone @= io.pipe().must()
        io.close(@gone.reader).must()
        writer @= start(
            with_error(with_output(command("yes", none), to: .stream(stream: gone.writer)), to: .nothing)
        ).must()
        assert wait(@writer).must() == .signaled(signal: 13)

        match io.write_text(gone.writer, text: "after")
            .ok _  => assert false
            .err e => assert e.code == CLOSED

        io.close(@gone.writer).must()
        kept @= io.pipe().must()
        io.write_text(kept.writer, text: "before\n").must()
        echo @= start(with_output(shell("echo child").must(), to: .stream(stream: kept.writer))).must()
        assert wait(@echo).must() == .exited(code: 0)
        io.write_text(kept.writer, text: "after\n").must()
        io.close(@kept.writer).must()
        assert io.read_all_text(kept.reader).must() == "before\nchild\nafter\n"
        io.close(@kept.reader).must()

test "start: input as text through a temporary file, a program that is not there, and a time limit not above 0"
    none: [str] = []
    child @= start(
        with_output(with_input(command(fixture.copier(), none), from: .text(text: "fed\n")), to: .pipe)
    ).must()
    assert fixture.line(io.read_all(child.output).must()) == "fed"
    assert wait(@child).must() == .exited(code: 0)
    assert start(command("rebel-no-such-program", none)).is_err()
    assert start(with_time_limit(command("cat", none), limit: time.nanoseconds(0))).is_err()

test "release: a child that still runs is given up and runs on unseen; wait, kill and terminate then refuse it"
    none: [str] = []
    child @= start(with_output(with_input(command(fixture.copier(), none), from: .pipe), to: .pipe)).must()
    release(@child).must()
    assert child.handle == nullptr
    assert io.is_closed(child.input) && io.is_closed(child.output)
    release(@child).must()

    match wait(@child)
        .ok _ => assert false
        .err e =>
            assert e.code == INVALID
            assert e.msg == f"waiting for \"{fixture.copier()}\": the child was given up by `release`"

    assert kill(child).is_err()
    assert terminate(child).is_err()
    assert has_ended(@child).is_err()
    assert cpu_of(child).is_err()

test "release after wait: nothing is left, and no failure"
    child @= start(shell(fixture.exit_script(0)).must()).must()
    assert wait(@child).must() == .exited(code: 0)
    release(@child).must()

test "is_success, code_of, signal_of and format_status: an exit of 0 and of 255, a signal, and a time out"
    assert is_success(.exited(code: 0))
    assert !is_success(.exited(code: 255)) && !is_success(.signaled(signal: 9)) && !is_success(.timed_out)
    assert code_of(.exited(code: 255)).must() == 255
    assert code_of(.signaled(signal: 9)).is_err() && code_of(.timed_out).is_err()

    match code_of(.timed_out)
        .ok _ => assert false
        .err e =>
            assert e.code == NOT_FOUND
            assert e.msg == "reading an exit code: the child ended at its time limit"

    assert signal_of(.signaled(signal: 15)).must() == 15
    assert signal_of(.exited(code: 0)).is_err() && signal_of(.timed_out).is_err()
    assert format_status(.exited(code: 3)) == "exited with code 3"
    assert format_status(.signaled(signal: 9)) == "ended by signal 9"
    assert format_status(.timed_out) == "ended at its time limit"

test "require_success: a success, an exit code, a signal, and a time out"
    require_success(.exited(code: 0)).must()

    match require_success(.exited(code: 1))
        .ok _ => assert false
        .err e =>
            assert e.code == FAILED
            assert e.msg == "asking a child's success: it exited with code 1, where the code 0 was asked"

    match require_success(.signaled(signal: 9))
        .ok _  => assert false
        .err e => assert e.code == FAILED

    match require_success(.timed_out)
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT

test "path_of: the system's shell by name and by path, a folder, a name nowhere, and an empty name"
    found = path_of(fixture.shell_name()).must()
    assert strings.has_suffix(s: found, suffix: fixture.shell_ending())
    assert path_of(fixture.shell_program()).must() == fixture.shell_program()
    assert path_of(fixture.a_folder()).is_err()

    match path_of("rebel-no-such-program")
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    match path_of("")
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "quote and quote_all: the empty word, a plain word, a quote inside, no words, and a word left empty among others"
    assert quote("") == "''"
    assert quote("abc") == "abc"
    assert quote("it's") == "'it'\"'\"'s'"
    assert quote("é") == "'é'"
    none: [str] = []
    assert quote_all(none) == ""
    assert quote_all(["a", "b c", ""]) == "a 'b c' ''"

test "usage_of: a running child read twice, then refused once waited for, and refused once given up"
    child @= start(with_input(command(fixture.copier(), []), from: .pipe)).must()
    first = usage_of(child).must()
    assert first.resident_bytes > 0 && first.virtual_bytes > 0
    assert first.user_ns >= 0 && first.system_ns >= 0
    second = usage_of(child).must()
    assert second.user_ns >= first.user_ns && second.system_ns >= first.system_ns
    io.close(@child.input).must()
    assert wait(@child).must() == .exited(code: 0)

    match usage_of(child)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    other @= start(with_input(command(fixture.copier(), []), from: .pipe)).must()
    release(@other).must()

    match usage_of(other)
        .ok _  => assert false
        .err e => assert e.code == INVALID

# A sleeper of thirty seconds, which every test below ends and waits for.
test "with_own_group and with_group_of: this process's group by default, one of its own, and another child's"
    c = command(fixture.sleeper(), fixture.sleeper_arguments(30))
    assert c.group == .parent
    assert with_own_group(c).group == .own
    leader @= start(c).must()
    assert with_group_of(c, leader: leader).group == .joined(leader: leader.handle)
    kill(leader).must()
    _ = wait(@leader).must()

test "send_signal and send_group_signal: a child of this process's group signalled alone, its group refused, and an ended child sent nothing"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(30))).must()

    if fixture.on_windows()
        match send_signal(child, signal: .interrupt)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED

        kill(child).must()
        _ = wait(@child).must()
    else
        match send_group_signal(child, signal: .terminate)
            .ok _  => assert false
            .err e => assert e.code == INVALID

        send_signal(child, signal: .terminate).must()
        assert wait(@child).must() == .signaled(signal: 15)
        send_signal(child, signal: .terminate).must()

        match send_group_signal(child, signal: .terminate)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "with_own_group and with_group_of: a job of two children in one group of its own, ended by one signal to the group"
    leading = with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(30)))

    if fixture.on_windows()
        match start(leading)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED
    else
        leader @= start(leading).must()
        member @= start(with_group_of(command(fixture.sleeper(), fixture.sleeper_arguments(30)), leader: leader)).must()
        send_group_signal(member, signal: .terminate).must()
        assert wait(@leader).must() == .signaled(signal: 15)
        assert wait(@member).must() == .signaled(signal: 15)

test "with_group_of: a leader in this process's group, one waited for and one seen to end are refused, and nothing is started"
    if !fixture.on_windows()
        sleeping = command(fixture.sleeper(), fixture.sleeper_arguments(30))
        plain @= start(sleeping).must()

        match start(with_group_of(sleeping, leader: plain))
            .ok _  => assert false
            .err e => assert e.code == INVALID

        kill(plain).must()
        _ = wait(@plain).must()

        match start(with_group_of(sleeping, leader: plain))
            .ok _  => assert false
            .err e => assert e.code == INVALID

        quick @= start(with_own_group(shell(fixture.exit_script(0)).must())).must()

        while !has_ended(@quick).must()
            clock.rest(clock.SHORTEST)

        match start(with_group_of(sleeping, leader: quick))
            .ok _  => assert false
            .err e => assert e.code == INVALID

        _ = wait(@quick).must()

test "wait_or_stop and state_of: a child stopped, seen stopped, sent on, seen running, stopped by Ctrl-Z's signal, then ended at once while stopped"
    if !fixture.on_windows()
        child @= start(with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(30)))).must()
        assert state_of(@child).must() == .running
        stop = os.signal_number(.stop).must()
        send_signal(child, signal: .stop).must()
        assert wait_or_stop(@child).must() == .stopped(signal: stop)
        assert state_of(@child).must() == .stopped(signal: stop)
        assert !has_ended(@child).must()
        send_group_signal(child, signal: .resume).must()
        tries @= 0

        while state_of(@child).must() != .running && tries < 5000
            clock.rest(clock.SHORTEST)
            tries @ tries + 1

        assert child.state == .running
        send_signal(child, signal: .terminal_stop).must()
        assert wait_or_stop(@child).must() == .stopped(signal: os.signal_number(.terminal_stop).must())
        kill(child).must()

        match wait_or_stop(@child).must()
            .ended e              => assert e.status == .signaled(signal: 9)
            .running | .stopped _ => assert false

        assert child.handle == nullptr
        assert wait(@child).must() == .signaled(signal: 9)

test "wait_or_stop: a stopped child past its time limit is ended at once, and its status says so"
    if !fixture.on_windows()
        limited = with_time_limit(
            with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(30))),
            limit: time.milliseconds(300).must()
        )
        child @= start(limited).must()
        send_signal(child, signal: .stop).must()
        seen @= wait_or_stop(@child).must()

        if seen != .stopped(signal: os.signal_number(.stop).must())
            assert seen == child.state
        else
            seen @ wait_or_stop(@child).must()

        match seen
            .ended e              => assert e.status == .timed_out
            .running | .stopped _ => assert false

test "give_terminal, take_terminal and holds_terminal: a stream that is no terminal is unsupported, and a child that ended names no group"
    pair = io.pipe().must()
    reader @= pair.reader
    writer @= pair.writer

    match holds_terminal(reader)
        .ok _  => assert false
        .err e => assert e.code == UNSUPPORTED

    match take_terminal(reader)
        .ok _  => assert false
        .err e => assert e.code == UNSUPPORTED

    if !fixture.on_windows()
        child @= start(with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(30)))).must()

        match give_terminal(child, terminal: reader)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED

        kill(child).must()
        _ = wait(@child).must()

        match give_terminal(child, terminal: reader)
            .ok _  => assert false
            .err e => assert e.code == INVALID
    io.close(@reader).must()
    io.close(@writer).must()

# This process counts the request to end, which the platform layer hands over
# as it hands Ctrl-C, and a signal of the runtime's own door, and a child it
# started sends it three of each: each is counted and none ends the test
# (feature 2669). Ctrl-C itself is the `run` cases', which set its
# disposition first: a test a shell started in the background inherits it
# ignored, and it stays so.
test "os.count_signal: three requests to end and three SIGUSR1 a child sends this process are counted one by one, and the process goes on"
    if !fixture.on_windows()
        os.count_signal(.terminate).must()
        os.count_signal(.user1).must()

        for _ in range(from: 0, to: 3)
            asked @= start(shell(f"kill -TERM {os.pid()}").must()).must()
            assert wait(@asked).must() == .exited(code: 0)
            assert os.take_signals(.terminate) == 1
            own @= start(shell(f"kill -USR1 {os.pid()}").must()).must()
            assert wait(@own).must() == .exited(code: 0)
            assert os.take_signals(.user1) == 1

## Examples

# A command built from a program and its arguments, each reaching the child
# whole: nothing is run yet.
test "command: git asked for its short status"
    c = command("git", ["status", "--short"])
    assert c.program == "git" && c.arguments == ["status", "--short"]

# A line read by the system's shell, where a pipe or a redirection is wanted.
test "shell: a line the shell reads"
    assert fixture.unix_lines(capture(shell("echo hello").must()).must()) == "hello\n"

# A command with its arguments replaced.
test "with_arguments: a listing asked long"
    c = with_arguments(command("ls", []), arguments: ["-l"])
    assert c.arguments == ["-l"]

# A variable set for the child alone.
test "with_env: the compiler a build uses"
    c = with_env(command("make", []), name: "CC", value: "clang")
    assert env_of(c).must()["CC"].must() == "clang"

# Several variables set at once.
test "with_env_all: two settings for a build"
    c = with_env_all(command("make", []), variables: {"CC": "clang", "CFLAGS": "-O2"})
    assert env_of(c).must()["CFLAGS"].must() == "-O2"

# A variable the child does not take from this process.
test "with_env_removed: no debugging for the child"
    c = with_env_removed(with_env(command("make", []), name: "DEBUG", value: "1"), name: "DEBUG")
    assert env_of(c).must()["DEBUG"].is_err()

# A child that starts from no variable at all.
test "with_env_cleared: a clean environment with one variable"
    c = with_env(with_env_cleared(command("make", [])), name: "HOME", value: "/tmp")
    assert env_of(c).must() == {"HOME": "/tmp"}

# The variables a child will start with.
test "env_of: the one variable a cleared command sets"
    c = with_env(with_env_cleared(command("env", [])), name: "LANG", value: "C")
    assert env_of(c).must() == {"LANG": "C"}

# A child run in another working folder.
test "with_dir: a build run inside its folder"
    c = with_dir(command("make", []), dir: "build")
    assert c.dir == "build"

# A child fed a text, then the end.
test "with_input: a line fed to the copier"
    c = with_output(with_input(command(fixture.copier(), []), from: .text(text: "hi\n")), to: .pipe)
    assert fixture.line(run(c).must().output) == "hi"

# A child's output kept by the program.
test "with_output: what a child prints, kept"
    c = with_output(shell("echo out").must(), to: .pipe)
    assert fixture.line(run(c).must().output) == "out"

# A child's error kept by the program.
test "with_error: what a child writes to its error, kept"
    c = with_error(shell(fixture.error_script("oops")).must(), to: .pipe)
    assert fixture.line(run(c).must().error) == "oops"

# A child's output and error read as one, in the order written.
test "with_error_to_output: both streams in one"
    c = with_error_to_output(with_output(shell(fixture.both_script(first: "a", second: "b")).must(), to: .pipe))
    assert fixture.unix_lines(fixture.line(run(c).must().output)) == "a\nb"

# A child ended at once when it runs too long.
test "with_time_limit: a sleep of five seconds cut at a tenth of one"
    c = with_time_limit(command(fixture.sleeper(), fixture.sleeper_arguments(5)), limit: time.milliseconds(100).must())
    assert run(c).must().status == .timed_out

# What a child prints, as text, where it must succeed.
test "capture: the text a child prints"
    text = capture(command(fixture.shell_program(), fixture.shell_arguments("echo hi"))).must()
    assert fixture.unix_lines(text) == "hi\n"

# A child started and fed through its pipe while the program goes on.
test "start: a child fed through its input pipe"
    child @= start(with_output(with_input(command(fixture.copier(), []), from: .pipe), to: .nothing)).must()
    io.write_text(child.input, text: "line\n").must()
    io.close(@child.input).must()
    assert wait(@child).must() == .exited(code: 0)

# The end of a child waited for, and how it ended.
test "wait: a child that exits with 3"
    child @= start(shell(fixture.exit_script(3)).must()).must()
    assert wait(@child).must() == .exited(code: 3)

# Whether a child has ended, asked without waiting.
test "has_ended: a sleeping child has not"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(5))).must()
    assert !has_ended(@child).must()
    kill(child).must()
    assert !is_success(wait(@child).must())

# A child asked to end, which it may answer by cleaning up first.
test "terminate: a sleeping child asked to end"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(5))).must()

    match terminate(child)
        .ok _ => assert wait(@child).must() == .signaled(signal: 15)
        .err e =>
            assert e.code == UNSUPPORTED && fixture.on_windows()
            kill(child).must()
            assert !is_success(wait(@child).must())

# A child ended at once.
test "kill: a sleeping child ended at once"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(5))).must()
    kill(child).must()
    assert !is_success(wait(@child).must())

# A child given up, left to run without the program waiting for it.
test "release: a child let go"
    child @= start(with_input(command(fixture.copier(), []), from: .pipe)).must()
    release(@child).must()

# The CPU time a child used, once it has ended.
test "cpu_of: the time a short child used"
    child @= start(shell(fixture.exit_script(0)).must()).must()
    assert wait(@child).must() == .exited(code: 0)
    used = cpu_of(child).must()
    assert used.user.nanoseconds >= 0 && used.system.nanoseconds >= 0

# Whether a child succeeded.
test "is_success: exit code 0 and exit code 1"
    assert is_success(.exited(code: 0)) && !is_success(.exited(code: 1))

# The exit code a child ended with.
test "code_of: the code 3"
    assert code_of(.exited(code: 3)).must() == 3

# The signal that ended a child.
test "signal_of: SIGTERM"
    assert signal_of(.signaled(signal: 15)).must() == 15

# A failure where a child did not succeed, to hand on with `?`.
test "require_success: a child that exits with 2 fails"
    match require_success(.exited(code: 2))
        .ok _  => assert false
        .err e => assert e.code == FAILED

# How a child ended, in words for a message.
test "format_status: an exit code"
    assert format_status(.exited(code: 3)) == "exited with code 3"

# Where a program found on PATH stands.
test "path_of: the system's shell"
    assert fixture.ends_with(text: path_of(fixture.shell_name()).must(), tail: fixture.shell_ending())

# A word written so a POSIX shell reads it back whole.
test "quote: a word with a quote in it"
    assert quote("it's") == "'it'\"'\"'s'"

# Words written as one line a POSIX shell reads back as those words.
test "quote_all: a file name with a space"
    assert quote_all(["ls", "my file"]) == "ls 'my file'"

# The memory a child holds while it runs, then its end waited for.
test "usage_of: the memory a running child holds"
    child @= start(with_input(command(fixture.copier(), []), from: .pipe)).must()
    held = usage_of(child).must().resident_bytes
    assert held > 0
    io.close(@child.input).must()
    assert wait(@child).must() == .exited(code: 0)

# A job's first program started in a group of its own, which Ctrl-C at the
# terminal then reaches without this process.
test "with_own_group: a job's first program"
    c = with_own_group(command("make", []))
    assert c.group == .own

# A pipeline's second program started in its first one's group.
test "with_group_of: a pipeline's second program"
    first @= start(command(fixture.sleeper(), fixture.sleeper_arguments(0))).must()
    second = with_group_of(command("sort", []), leader: first)
    assert second.group == .joined(leader: first.handle)
    _ = wait(@first).must()

# A shell asks each job where it stands before its prompt.
test "state_of: a job asked until it ended"
    child @= start(shell(fixture.exit_script(3)).must()).must()

    while state_of(@child).must() == .running
        clock.rest(clock.SHORTEST)

    _ = wait(@child).must()

# A shell waits for the job it runs in front, which ends here and might have
# been stopped by Ctrl-Z.
test "wait_or_stop: the job in front waited for"
    child @= start(shell(fixture.exit_script(3)).must()).must()

    match wait_or_stop(@child).must()
        .ended e   => assert e.status == .exited(code: 3)
        .stopped s => print(f"stopped by signal {s.signal}")
        .running   => assert false

# A child asked to end with SIGTERM, which Windows has no such request for.
test "send_signal: a child asked to end"
    child @= start(command(fixture.sleeper(), fixture.sleeper_arguments(30))).must()

    match send_signal(child, signal: .terminate)
        .ok _ => _ = wait(@child).must()
        .err e =>
            assert e.code == UNSUPPORTED
            kill(child).must()
            _ = wait(@child).must()

# A whole job ended by one signal to its group.
test "send_group_signal: a job ended"
    if !fixture.on_windows()
        job @= start(with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(30)))).must()
        send_group_signal(job, signal: .terminate).must()
        assert wait(@job).must() == .signaled(signal: 15)

# A shell hands its terminal to the job it runs in front, where it holds the
# terminal at all.
test "give_terminal: the terminal to the job in front"
    if holds_terminal(io.stdin()).default(false)
        job @= start(with_own_group(command(fixture.sleeper(), fixture.sleeper_arguments(0)))).must()
        give_terminal(job, terminal: io.stdin()).must()
        _ = wait_or_stop(@job).must()
        take_terminal(io.stdin()).must()

# The terminal taken back once the job in front ended or stopped.
test "take_terminal: the terminal back after a job"
    if holds_terminal(io.stdin()).default(false)
        take_terminal(io.stdin()).must()

# Whether this shell holds its terminal, which job control needs.
test "holds_terminal: job control only in front"
    match holds_terminal(io.stdin())
        .ok held => print(f"in front: {held}")
        .err e   => assert e.code == UNSUPPORTED
