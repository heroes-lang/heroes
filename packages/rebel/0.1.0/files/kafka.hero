            close(@c).must()

# Two members sharing a topic of three partitions.
test "assign_range: two members, three partitions"
    out = assign_range(
        [Subscription(member_id: "a", topics: ["t"]), Subscription(member_id: "b", topics: ["t"])],
        partition_counts: {"t": 3}
    )
    assert out[0].partitions.len() == 2 && out[1].partitions == [TopicPartition(topic: "t", partition: 2)]

# A batch of one message.
test "encode_batch: one message, read back"
    assert decode_batches(encode_batch([message([1])], compression: .none).must()).must()[0].value.must() == [1]

# The messages of a batch.
test "decode_batches: one batch"
    data = encode_batch([message([1]), message([2])], compression: .gzip).must()
    assert decode_batches(data).must().len() == 2

# The name of an error a broker answers.
test "error_name: an unknown topic"
    assert error_name(3).must() == "UNKNOWN_TOPIC_OR_PARTITION"
