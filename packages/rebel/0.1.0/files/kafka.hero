# The options of a consumer that commits by hand.
test "group_options: commits by hand"
    g @= group_options("billing", topics: ["orders"])
    g.auto_commit_interval @ time.max_duration()
    assert g.topics == ["orders"] && g.auto_commit_interval == time.max_duration()

# A consumer joined to its group.
test "subscribe: a group of one"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-l"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            k @= subscribe(options(["localhost:9092"]), group: group_options(name, topics: [name])).must()
            close_consumer(@k).must()
            delete_topics(@c, names: [name]).must()
