# Messages read by a consumer.
test "poll: what the partitions hold"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-m"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            _ = produce(@c, topic: name, partition: 0, messages: [message([1])]).must()
            k @= subscribe(options(["localhost:9092"]), group: group_options(name, topics: [name])).must()
            assert poll(@k, wait: time.seconds(1).must()).must().len() == 1
            close_consumer(@k).must()
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# A consumer's positions committed.
test "commit: after a poll"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-n"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            k @= subscribe(options(["localhost:9092"]), group: group_options(name, topics: [name])).must()
            _ = poll(@k, wait: time.milliseconds(100).must()).must()
            commit(@k).must()
            close_consumer(@k).must()
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# A consumer sent back to the start of a partition.
test "seek: the offset 0"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-o"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            k @= subscribe(options(["localhost:9092"]), group: group_options(name, topics: [name])).must()
            seek(@k, topic: name, partition: 0, offset: 0).must()
            close_consumer(@k).must()
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# A consumer's position in a partition.
test "position_of: at the start of an empty partition"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-p"
