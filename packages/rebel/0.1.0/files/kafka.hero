# The first message of a partition deleted.
test "delete_records: before the second offset"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-e"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            _ = produce(@c, topic: name, partition: 0, messages: [message([1]), message([2])]).must()
            assert delete_records(@c, topic: name, partition: 0, before: 1).must() == 1
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# A message of text.
test "message: a value"
    m = message(bytes.from_text("hello"))
    assert m.key.is_err() && m.value.must() == bytes.from_text("hello") && m.partition == -1

# A message keyed by a user's identifier.
test "with_key: a user's identifier"
    m = with_key(message([1]), key: bytes.from_text("user-42"))
    assert m.key.must() == bytes.from_text("user-42")

# A tombstone that removes a user's last value from a compacted topic.
test "tombstone: a user's value removed"
    m = tombstone(bytes.from_text("user-42"))
    assert m.key.must() == bytes.from_text("user-42") && m.value.is_err()

# A message with a header.
test "with_header: a trace's identifier"
    m = with_header(message([1]), key: "trace", value: [7])
    assert m.headers == [Header(key: "trace", value: [7])]

# The partition Java's client chooses for a key.
test "partition_of: the key a among seven partitions"
    assert partition_of([97], partitions: 7) == 5

# A batch written to one partition.
test "produce: two messages to the partition 0"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-f"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            assert produce(@c, topic: name, partition: 0, messages: [message([1]), message([2])]).must().base_offset == 0
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# Messages written to the partitions their keys choose.
test "send: a keyed message"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-g"
            create_topics(@c, topics: [new_topic(name, partitions: 3)]).must()
            m @= message([1]).with_key([97])
            m.topic @ name
            assert send(@c, messages: [m]).must()[0].partition == partition_of([97], partitions: 3)
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# A partition's messages read from its start.
test "fetch: from the offset 0"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
            c @= first
            name = f"rebel-example-{os.pid()}-h"
            create_topics(@c, topics: [new_topic(name, partitions: 1)]).must()
            _ = produce(@c, topic: name, partition: 0, messages: [message([1])]).must()
            assert fetch(@c, topic: name, partition: 0, offset: 0, wait: time.milliseconds(500).must()).must().messages[0].value.must() == [1]
            delete_topics(@c, names: [name]).must()
            close(@c).must()

# The end of a partition's log.
test "list_offset: the latest"
    match connect(options(["localhost:9092"]))
        .err e => skip_test(reason: f"no Kafka broker reached on this machine: {e.msg}")
        .ok first =>
