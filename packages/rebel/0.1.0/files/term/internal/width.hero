# How many cells of a terminal a text takes, measured by
# `unicode/segment.width_of` (Unicode 17.0.0), the one measure of the library:
# grapheme by grapheme, 2 for a wide character of East Asian scripts or an
# emoji drawn wide, 0 for a mark, a format character or a control, 1 for every
# other, and an ECMA-48 sequence a style writes taking none, so a styled text
# measures as it shows and a sequence of emoji joined into one picture counts
# once. It is the measure the line editor and the tables align by; and the
# byte steps the line editor moves by, one character at a time.

use unicode/segment

# Whether the character that starts at byte `at` of `s` takes no cell alone: a
# mark, a format character, a control, a Hangul vowel or final consonant, so
# that the line editor moves over it with the character before it.
function takes_no_cell(s: str lent, at: i64) -> bool
    return segment.width_of(s.slice(from: at, to: next_at(s, at))) == 0

# The byte just after the character that starts at byte `at` of `s`.
function next_at(s: str lent, at: i64) -> i64
    first = s[at]

    if first < 0x80
        return at + 1

    if first < 0xe0
        return at + 2

    if first < 0xf0
        return at + 3
    return at + 4

# The start of the character that ends at byte `at` of `s`, `at` above 0 and
# at a character's start or the text's end.
function previous_at(s: str lent, at: i64) -> i64
    back: i64 @= at - 1

    while back > 0 && s[back] >= 0x80 && s[back] < 0xc0
        back @ back - 1

    return back

# The cells `s` takes on a terminal, its control sequences taking none.
function cells_of(s: str lent) -> i64
    return segment.width_of(s)

# The cells the bytes of `s` from `from` to `to` take, both at a character's
# start or the text's end.
function cells_between(s: str lent, from: i64, to: i64) -> i64
    return segment.width_of(s.slice(from: from, to: to))

test "width takes_no_cell: a control, ASCII, a mark, a wide ideograph, an emoji, a Hangul vowel, the soft hyphen, a zero-width space"
    s = "\u{1b}á中😀ᅡ­​x"
    at: i64 @= 0
    told: [bool] @= []

    while at < s.len()
        told @ told.push(takes_no_cell(s, at))
        at @ next_at(s, at)

    # The soft hyphen takes no cell by `unicode/segment.width_of`, where this
    # package's own table of 2026-11-17 gave it one, wcwidth's way: the one
    # code point of the tests where the two measures part.
    assert told == [true, false, true, false, false, true, true, true, false]

test "width next_at and previous_at: a character of each length"
    s = "aé中😀"
    assert next_at(s, 0) == 1 && next_at(s, 1) == 3 && next_at(s, 3) == 6 && next_at(s, 6) == 10
    assert previous_at(s, 10) == 6 && previous_at(s, 6) == 3 && previous_at(s, 3) == 1 && previous_at(s, 1) == 0

test "width cells_of: empty, ASCII, wide, a combining accent, an emoji joined into one picture, a flag, and a styled text whose sequences take none"
    assert cells_of("") == 0
    assert cells_of("abc") == 3
    assert cells_of("中文") == 4
    assert cells_of("é") == 1
    assert cells_of("\u{1b}[1;31mred\u{1b}[0m") == 3
    assert cells_of("\u{1b}7x") == 1
    assert cells_of("x\u{1b}") == 1
    assert cells_of("x\u{1b}[12") == 1

test "width cells_between: a part of a text of wide characters"
    s = "a中b"
    assert cells_between(s, from: 0, to: s.len()) == 4
    assert cells_between(s, from: 1, to: 4) == 2
    assert cells_between(s, from: 4, to: 4) == 0
