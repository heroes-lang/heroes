# The codes `term` fails with, and the one place a kind of the floor
# `term/hero_term` becomes one, its message saying what was asked and what the
# layer answered (README § A4).

use term/hero_term

constant INVALID: str
    "invalid"

constant UNSUPPORTED: str
    "unsupported"

constant TIMEOUT: str
    "timeout"

constant CLOSED: str
    "closed"

constant STOPPED: str
    "stopped"

constant FAILED: str
    "failed"

constant NOT_TEXT: str
    "not_text"

# What a code and its words are, for one kind of the floor.
record Told
    # The code of README § A4.
    code: str
    # What the layer or the system answered, in words a reader can act on.
    why: str

# The code and the words for `kind`, one of `HERO_TERM_*`, the platform's own
# number `os_error` in the words where the layer names no kind of its own.
function told(kind: i64, os_error: i64) -> Told
    if kind == hero_term.HERO_TERM_INVALID
        return Told(code: INVALID, why: "the layer refuses the argument")

    if kind == hero_term.HERO_TERM_NOT_A_TERMINAL
        return Told(code: UNSUPPORTED, why: "the program has no terminal")

    if kind == hero_term.HERO_TERM_TIMED_OUT
        return Told(code: TIMEOUT, why: "no key came in the time allowed")

    if kind == hero_term.HERO_TERM_NOT_OPEN
        return Told(code: CLOSED, why: "the stream is closed")
    return Told(code: FAILED, why: f"the system refused, its error number {os_error}")

# The failure the floor's last call on this thread named, as a `T?`.
function last<T>(asked: str) -> T?
    t = told(kind: hero_term.last_error(), os_error: hero_term.last_os_error())
    return fail(code: t.code, msg: f"{asked}: {t.why}")

# A failure of `code` the package itself finds, its message `asked` then
# `why`.
function of<T>(code: str, asked: str, why: str) -> T?
    return fail(code: code, msg: f"{asked}: {why}")

test "told: every kind of the floor is a code of README § A4, an unknown one failed with its number"
    assert told(kind: hero_term.HERO_TERM_INVALID, os_error: 0).code == INVALID
    assert told(kind: hero_term.HERO_TERM_NOT_A_TERMINAL, os_error: 0).code == UNSUPPORTED
    assert told(kind: hero_term.HERO_TERM_TIMED_OUT, os_error: 0).code == TIMEOUT
    assert told(kind: hero_term.HERO_TERM_NOT_OPEN, os_error: 0).code == CLOSED
    assert told(kind: hero_term.HERO_TERM_OTHER, os_error: 5).code == FAILED
    assert told(kind: hero_term.HERO_TERM_OTHER, os_error: 5).why == "the system refused, its error number 5"
    assert told(kind: 77, os_error: 0).code == FAILED

test "of: the message is what was asked, then why"
    r: str? = of(code: STOPPED, asked: "reading a secret", why: "Ctrl-C was pressed")

    match r
        .ok _ => assert false
        .err e =>
            assert e.code == STOPPED
            assert e.msg == "reading a secret: Ctrl-C was pressed"
