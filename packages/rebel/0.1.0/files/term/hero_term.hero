# The platform layer's terminal, `hero_term.h`, bound thin: one function per C
# function, each answering what C answers, in C's order. Where a call fails it
# answers -1, and `last_error` then the kind. Rebel's floor of `term`
# (`examples/packages/README.md` § 4.1): no policy stands here, and the face
# above it turns every kind into a code and every key's bytes into a key.
#
# The layer is C of the language's own beside the runtime, so this group names
# its header and no `link`. The terminal is the process's own, found by the
# layer at its first use, so nothing here is a handle a program holds.

use io/hero_stream

extern "hero_term.h"
    # The kinds of failure `last_error` answers, the same numbers on every
    # platform.
    constant HERO_TERM_OK: i64
    constant HERO_TERM_INVALID: i64
    constant HERO_TERM_NOT_A_TERMINAL: i64
    constant HERO_TERM_TIMED_OUT: i64
    constant HERO_TERM_OTHER: i64
    constant HERO_TERM_NOT_OPEN: i64
    # The most bytes one key takes, and the least a key's buffer holds.
    constant HERO_TERM_KEY_MOST: i64
    function hero_term_enter_keys() -> i64
    function hero_term_leave() -> i64
    function hero_term_read_key(@buffer: [u8] counted_by n lent, n: u64, ms: i64) -> i64
    function hero_term_write(@data: [u8] counted_by n lent, n: u64) -> i64
    function hero_term_sequences(s: hero_stream.Stream) -> i64
    function hero_term_last_error() -> i64
    function hero_term_last_os_error() -> i64

# 0 once this call has put the terminal where it hands each key as it is
# pressed, nothing echoed and no key ending the program, 1 where it stood so
# already; or -1, `HERO_TERM_NOT_A_TERMINAL` where the process has none.
function enter_keys() -> i64
    return hero_term_enter_keys()

# 0 once the terminal is as it was before the first `enter_keys`, also where
# no mode stood; or -1.
function leave() -> i64
    return hero_term_leave()

# How many bytes of `buffer`, `n` long, one key takes, waiting at most `ms`
# milliseconds for it (0 not at all, -1 with no limit); 0 where the terminal
# is gone; or -1. `n` is `HERO_TERM_KEY_MOST` or more. It leaves `buffer` `n`
# bytes long, the key's first.
function read_key(@buffer: [u8], n: u64, ms: i64) -> i64
    return hero_term_read_key(@buffer, n: n, ms: ms)

# The `n` first bytes of `data` written to the terminal, answered as `n`; or
# -1. It leaves `data` as it was handed.
function write(@data: [u8], n: u64) -> i64
    return hero_term_write(@data, n: n)

# 1 where the stream `s` is a terminal that takes escape sequences, 0 where it
# takes none, -1 with `HERO_TERM_NOT_OPEN` where it is no open stream.
function sequences(s: hero_stream.Stream) -> i64
    return hero_term_sequences(s)

# The kind of the last call's failure on this thread.
function last_error() -> i64
    return hero_term_last_error()

# The platform's own number for that failure, 0 where the layer refused.
function last_os_error() -> i64
    return hero_term_last_os_error()

## The tests: the edges first. A test runs with a terminal (a person's) or
## with none (a test run by another program), and each holds in both.

test "read_key: a buffer below HERO_TERM_KEY_MOST bytes and a time below -1 are refused before the terminal is asked"
    small: [u8] @= [0, 0, 0, 0]
    assert read_key(@small, n: 4, ms: 0) == -1
    assert last_error() == HERO_TERM_INVALID
    room: [u8] @= []

    for _ in range(from: 0, to: HERO_TERM_KEY_MOST)
        room @ room.push(0)

    assert read_key(@room, n: to_u64(HERO_TERM_KEY_MOST - 1).must(), ms: 0) == -1
    assert last_error() == HERO_TERM_INVALID
    assert read_key(@room, n: to_u64(HERO_TERM_KEY_MOST).must(), ms: -2) == -1
    assert last_error() == HERO_TERM_INVALID

test "read_key: with no key waiting, a time of 0 answers at once, timed out, or not a terminal where the process has none"
    room: [u8] @= []

    for _ in range(from: 0, to: 64)
        room @ room.push(0)

    answer = read_key(@room, n: 64, ms: 0)
    assert answer == -1
    assert last_error() == HERO_TERM_TIMED_OUT || last_error() == HERO_TERM_NOT_A_TERMINAL

# Run in a pseudo-terminal on macOS before 2026-11-19, this test and the one
# above never ended: Darwin's poll(2) answers POLLNVAL for `/dev/tty`, and the
# layer then waited in a read for a key nobody sent.
test "read_key: with no key waiting, a limit of 200 ms ends timed out on a terminal, or not a terminal where the process has none"
    room: [u8] @= []

    for _ in range(from: 0, to: 64)
        room @ room.push(0)

    answer = read_key(@room, n: 64, ms: 200)
    assert answer == -1
    assert last_error() == HERO_TERM_TIMED_OUT || last_error() == HERO_TERM_NOT_A_TERMINAL

test "enter_keys and leave: 0 then 1 then a leave on a terminal, or the enter not a terminal; a leave with no mode standing is 0, twice"
    assert leave() == 0
    assert leave() == 0
    entered = enter_keys()

    if entered == 0
        assert enter_keys() == 1
        assert leave() == 0
        assert enter_keys() == 0
        assert leave() == 0
    else
        assert entered == -1
        assert last_error() == HERO_TERM_NOT_A_TERMINAL
    assert leave() == 0
    assert last_error() == HERO_TERM_OK

test "write: no bytes is 0 on a terminal, or not a terminal where the process has none"
    none: [u8] @= []
    written = write(@none, n: 0)
    assert written == 0 || written == -1 && last_error() == HERO_TERM_NOT_A_TERMINAL

test "sequences: a pipe's two ends and a file take none, nullptr is no open stream, and the process's output takes them exactly where it is a terminal"
    reader: hero_stream.Stream @= nullptr
    writer: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @reader, writer: @writer) == 0
    assert sequences(reader) == 0
    assert sequences(writer) == 0
    assert hero_stream.close(@reader) == 0
    assert hero_stream.close(@writer) == 0
    assert sequences(nullptr) == -1
    assert last_error() == HERO_TERM_NOT_OPEN
    folder = hero_stream.scratch("term-file")
    file @= hero_stream.open(path: folder + "/f", access: hero_stream.HERO_STREAM_ACCESS_CREATE, perm: 420)
    assert sequences(file) == 0
    assert hero_stream.close(@file) == 0
    assert hero_stream.cleared(folder)
    out = hero_stream.std(hero_stream.HERO_STREAM_STD_OUT)
    assert sequences(out) == hero_stream.is_terminal(out)
