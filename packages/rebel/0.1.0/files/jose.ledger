# The ledger of `jose`: what the JOSE libraries of Go, Python and Rust let a
# program do with signatures (JWS, RFC 7515), keys (JWK, RFC 7517), tokens
# (JWT, RFC 7519) and encryption (JWE, RFC 7516), one block per capability,
# and what Rebel answers. None of the three standard libraries has JOSE, so
# the yardstick is the census of third-party libraries the author chose on
# 2026-11-17. Measured on this machine: Go's golang-jwt v5.2.2 and
# `golang.org/x/oauth2/jws` v0.36.0 (`go doc -all`, from the module cache,
# no download); Python's PyJWT 2.15.1, authlib 1.9.1's `authlib.jose` and
# joserfc 1.7.7 (`dir()`, in the Python 3.15 environment of an application
# installed here, run with `-I`). Not on this machine, so their entries are
# recalled from their documentation and are a question rather than a
# measurement: Go's go-jose v4, python-jose, Rust's `jsonwebtoken` and
# `josekit`. Expected values in the tests come from the RFCs' own examples
# (RFC 7515 Appendix A, RFC 7517 Appendix A, RFC 7518 Appendix C, RFC 7519
# § 3.1, RFC 7520 §§ 3 to 5, RFC 7638 § 3.1, RFC 8037 Appendix A) and from
# PyJWT's and joserfc's answers to the same inputs.

capability jws/algorithms  the signature algorithms named, written and read by their JOSE names
  heroes  jose.Algorithm, jose.format_algorithm, jose.parse_algorithm, jose.is_available
  go      jwt.GetAlgorithms, jwt.GetSigningMethod, jwt.SigningMethod, jwt.SigningMethod.Alg, jwt.RegisterSigningMethod
  rust    jsonwebtoken::Algorithm, Algorithm::from_str
  python  jwt.get_algorithm_by_name, jwt.algorithms.Algorithm, PyJWS.get_algorithms, PyJWS.get_algorithm_by_name, PyJWS.register_algorithm, PyJWS.unregister_algorithm, jwt.register_algorithm, jwt.unregister_algorithm, JsonWebSignature.ALGORITHMS_REGISTRY, JsonWebSignature.register_algorithm, joserfc.jws.JWSRegistry, joserfc.jws.JWSAlgModel, joserfc.jws.construct_registry, joserfc.jws.default_registry, joserfc.jws.setup_jws_algorithms
  note    A closed variant, so a misspelt algorithm is a compile error; registering one's own is refused, since a signature here is computed by `crypto` or `crypto/keypairs` and never by the program's function

capability jws/hmac  HS256, HS384 and HS512 (RFC 7518 § 3.2)
  heroes  jose.Algorithm.hs256, jose.Algorithm.hs384, jose.Algorithm.hs512
  go      jwt.SigningMethodHMAC, jwt.SigningMethodHS256, jwt.SigningMethodHS384, jwt.SigningMethodHS512, SigningMethodHMAC.Sign, SigningMethodHMAC.Verify
  rust    Algorithm::HS256, Algorithm::HS384, Algorithm::HS512, EncodingKey::from_secret, DecodingKey::from_secret
  python  jwt.algorithms.HMACAlgorithm, authlib.jose.OctKey, joserfc.jwk.OctKey

capability jws/rsa-pkcs1  RS256, RS384 and RS512 (RFC 7518 § 3.3)
  heroes  jose.Algorithm.rs256, jose.Algorithm.rs384, jose.Algorithm.rs512
  go      jwt.SigningMethodRSA, jwt.SigningMethodRS256, jwt.SigningMethodRS384, jwt.SigningMethodRS512, SigningMethodRSA.Sign, SigningMethodRSA.Verify, jws.Encode, jws.Verify
  rust    Algorithm::RS256, Algorithm::RS384, Algorithm::RS512, EncodingKey::from_rsa_pem, DecodingKey::from_rsa_components
  python  jwt.algorithms.RSAAlgorithm, authlib.jose.RSAKey, joserfc.jwk.RSAKey

capability jws/rsa-pss  PS256, PS384 and PS512 (RFC 7518 § 3.5)
  heroes  jose.Algorithm.ps256, jose.Algorithm.ps384, jose.Algorithm.ps512
  go      jwt.SigningMethodRSAPSS, jwt.SigningMethodPS256, jwt.SigningMethodPS384, jwt.SigningMethodPS512
  rust    Algorithm::PS256, Algorithm::PS384, Algorithm::PS512
  python  jwt.algorithms.RSAPSSAlgorithm

capability jws/ecdsa  ES256 and ES384 (RFC 7518 § 3.4), the signature as R and S of fixed length
  heroes  jose.Algorithm.es256, jose.Algorithm.es384
  go      jwt.SigningMethodECDSA, jwt.SigningMethodES256, jwt.SigningMethodES384, jwt.ErrECDSAVerification
  rust    Algorithm::ES256, Algorithm::ES384, EncodingKey::from_ec_pem, DecodingKey::from_ec_components
  python  jwt.algorithms.ECAlgorithm, jwt.algorithms.ECDSA, authlib.jose.ECKey, joserfc.jwk.ECKey

capability jws/ecdsa-p521  ES512 over P-521
  heroes  pending
  go      jwt.SigningMethodES512
  rust    -
  python  jwt.algorithms.SECP521R1
  note    `crypto/keypairs` has no P-521; `parse_algorithm("ES512")` fails `unsupported` saying so

capability jws/secp256k1  ES256K (RFC 8812)
  heroes  pending
  go      -
  rust    -
  python  jwt.algorithms.SECP256K1, joserfc.jwk.register_secp256k1
  note    `crypto/keypairs` has no secp256k1

capability jws/eddsa  EdDSA and Ed25519 (RFC 8037, RFC 9864) over Ed25519
  heroes  jose.Algorithm.eddsa, jose.Algorithm.ed25519
  go      jwt.SigningMethodEd25519, jwt.SigningMethodEdDSA
  rust    Algorithm::EdDSA, EncodingKey::from_ed_pem, DecodingKey::from_ed_components
  python  jwt.algorithms.OKPAlgorithm, authlib.jose.OKPKey, joserfc.jwk.OKPKey
  note    `crypto/keypairs`' Ed25519: Linux's OpenSSL 3, and on macOS Monocypher, a C library the runtime vendors (since 2026-11-20); Windows' CNG has none and answers `unsupported`. RFC 8037 Appendix A.4 signed byte for byte through `sign_compact` on this Mac 2026-11-20 (and `jose/internal/vectors`' test)

capability jws/ed448  EdDSA over Ed448
  heroes  pending
  go      -
  rust    -
  python  jwt.algorithms.Ed448PrivateKey, jwt.algorithms.Ed448PublicKey
  note    `crypto/keypairs` has no Ed448

capability jws/none  the algorithm `none`, a token with no signature
  heroes  refused: a token anybody can write is never accepted (RFC 8725 § 3.2); no case of `Algorithm` names it, and a header naming it fails `invalid`
  go      jwt.SigningMethodNone, jwt.UnsafeAllowNoneSignatureType, jwt.NoneSignatureTypeDisallowedError
  rust    -
  python  jwt.algorithms.NoneAlgorithm

capability jws/accepted  the algorithms a verifier accepts named by the caller, the token's own `alg` never trusted alone
  heroes  jose.verify_compact, jose.verify_json, jose.Rules
  go      jwt.WithValidMethods
  rust    Validation::algorithms
  python  jwt.decode(algorithms=...), JsonWebSignature(algorithms=...)
  note    An empty list accepts nothing; a key is used only for the algorithms its type serves, so an RSA key's public bytes are never an HMAC secret (the algorithm confusion of RFC 8725 § 2.1)

capability jws/compact-sign  a payload signed in the compact serialization
  heroes  jose.sign_compact
  go      jwt.Token.SignedString, jwt.Token.SigningString, jwt.Token.EncodeSegment, jws.Encode, jws.EncodeWithSigner, jws.Signer
  rust    jsonwebtoken::encode
  python  PyJWS.encode, JsonWebSignature.serialize_compact, joserfc.jws.serialize_compact, joserfc.jws.sign_compact, joserfc.jws.sign_rfc7515_compact

capability jws/compact-verify  a compact serialization verified by one of several keys
  heroes  jose.verify_compact
  go      jwt.Parse, jwt.Parser.Parse, jwt.Keyfunc, jws.Verify, jwt.Parser.DecodeSegment, jwt.WithPaddingAllowed, jwt.WithStrictDecoding
  rust    jsonwebtoken::decode, DecodingKey
  python  PyJWS.decode, PyJWS.decode_complete, JsonWebSignature.deserialize_compact, JsonWebSignature.deserialize, joserfc.jws.deserialize_compact, joserfc.jws.verify_compact, joserfc.jws.extract_compact, joserfc.jws.validate_compact, joserfc.jws.CompactSignature
  note    The key is chosen by the header's `kid` among those given, as a `Keyfunc` would; base 64 is read strictly, no padding and no other alphabet, as golang-jwt's `WithStrictDecoding`

capability jws/unverified-header  the header of a compact serialization read before any key is chosen
  heroes  jose.header_of
  go      jwt.Parser.ParseUnverified
  rust    jsonwebtoken::decode_header, Header
  python  jwt.get_unverified_header, PyJWS.get_unverified_header

capability jws/json  the general and flattened JSON serializations, signed and verified, several signatures
  heroes  jose.sign_json, jose.sign_flattened, jose.verify_json, jose.Signer, jose.Message
  go      -
  rust    -
  python  JsonWebSignature.serialize_json, JsonWebSignature.deserialize_json, joserfc.jws.serialize_json, joserfc.jws.deserialize_json, joserfc.jws.sign_general_json, joserfc.jws.sign_flattened_json, joserfc.jws.verify_general_json, joserfc.jws.verify_flattened_json, joserfc.jws.extract_general_json, joserfc.jws.extract_flattened_json, joserfc.jws.GeneralJSONSerialization, joserfc.jws.FlattenedJSONSerialization, joserfc.jws.GeneralJSONSignature, joserfc.jws.FlattenedJSONSignature, joserfc.jws.HeaderMember
  note    go-jose's `JSONWebSignature.FullSerialize` (recalled); golang-jwt has the compact form alone

