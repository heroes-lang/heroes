  heroes  markdown.Options.strikethrough
  go      extension.Strikethrough, extension.NewStrikethroughParser, extension.NewStrikethroughHTMLRenderer, extension.StrikethroughHTMLRenderer, extension.StrikethroughAttributeFilter
