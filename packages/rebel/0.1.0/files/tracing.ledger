  python  trace.NoOpTracer, NoOpTracerProvider, NonRecordingSpan, INVALID_SPAN, Once, deprecated, types, util, OTEL_SDK_DISABLED, OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED, create_tracer_metrics, create_exporter_metrics, create_processor_metrics, RuleBasedConfigurator, LogDroppedAttributesWarning, LogRecordDroppedAttributesWarning, DuplicateFilter, Span.to_json, Span.instrumentation_info
