# Jobs kept in Redis, as Sidekiq, asynq and RQ keep them: each job a hash,
# each queue sorted sets of the jobs ready, waiting, running and finished,
# and every change a Lua script the server runs whole, so any number of
# workers each claim a job once and never see one half moved. Every call
# works on the program's client of `redis`, and the store's clock is the
# server's own `TIME`.
#
# Its keys begin with `PREFIX`; a program that keeps two stores in one
# server gives each its own database (`redis.Options.database`). Its
# instants are microseconds, and its sets order by milliseconds, so two jobs
# of one priority due in one millisecond are claimed in the order of their
# ids.
#
# It cannot enqueue in a transaction of another database: a job enqueued
# here is kept at once, whatever the program's database then does, so a
# program whose jobs must follow its own commits keeps them in
# `jobs/postgres_store`. It does not wake a worker when a job comes: a
# worker that finds no job ready sleeps its `poll` and asks again. It needs
# Redis 5 or later, whose scripts may read the clock, and refuses a
# cluster's redirections as `redis` does.
#
# It keeps the limits every worker shares, each a `jobs.Bucket` under a
# name: `set_limit` makes one, and `allow`, `reserve`, `reserve_within` and
# `cancel_reservation` take and give back its tokens in one script the
# server runs whole, so workers on any number of connections and processes
# take them one after another and never more than it holds. A limit reads
# the server's `TIME` as the script runs, never earlier than the latest time
# it read, in nanoseconds whose steps are microseconds, the arithmetic exact
# past what Lua's numbers hold. It lives as long as the server keeps its
# keys: a server restarted with nothing saved forgets it, and a worker that
# asks it then fails `not_found` until `set_limit` makes it again, full.
#
# It fails with `jobs`'s codes, and with `redis`'s, handed on from the
# client, where the server refuses or the connection is lost: `closed`,
# `timeout`, `permission` where the server asks for a password.
#
# Not written yet, each a `pending` block of its ledger: a worker woken by a
# blocking pop or a message when a job comes.

use jobs
use jobs/internal/limits
use jobs/internal/taking
use jobs/redis_store/internal/buckets
use jobs/redis_store/internal/live
use jobs/redis_store/internal/replies
use jobs/redis_store/internal/scripts
use jobs/redis_store/internal/takers
use json
use numbers
use redis
use strings
use time

## The keys

# The prefix of every key the store writes: `rebel_jobs:job:<id>` for a
# job's fields, `rebel_jobs:ready:<queue>` and the other sets of a queue,
# `rebel_jobs:unique:<key>`, `rebel_jobs:periodic:<name>`,
# `rebel_jobs:limit:<name>` for a limit workers share.
constant PREFIX: str
    "rebel_jobs:"

## Enqueueing

# Enqueues `job` and answers its id.
#
# - `c`: the client.
# - `job`: the job, checked by `jobs.check_job`.
#
# Fails as `jobs.check_job` fails; `exists` where another job not finished
# holds its unique key, the message naming that job; and as `redis.call`
# fails. See also `enqueue_many`, `find_unique`.
function enqueue(@c: redis.Client, job: jobs.Job) -> i64?
    words: [str] @= ["EVAL", scripts.enqueue(), "0", PREFIX, "1"]

    for w in replies.job_words(job)?
        words @ words.push(w)

    items = redis.texts_of(redis.call(@c, words)?)?

    if replies.word_at(items, 0)? == "exists"
        holder = replies.word_at(items, 2)?
        return fail(
            code: jobs.EXISTS,
            msg: f"the unique key \"{job.unique_key}\" is held by job {replies.id_text(holder)}"
        )
    return replies.whole(replies.word_at(items, 1)?)

# Enqueues every job of `batch`, all or none, in one script, and answers
# their ids in its order.
#
# - `c`: the client.
# - `batch`: the jobs, each checked by `jobs.check_job`; none is a list of
#   no id.
#
# Fails as `enqueue` fails for the first job refused, the message naming its
# place in `batch`, and then keeps none of them. The server runs the script
# whole, so a long batch holds it for its length. See also `enqueue`.
function enqueue_many(@c: redis.Client, batch: [jobs.Job]) -> [i64]?
    if batch.len() == 0
        return ok([])
    words: [str] @= ["EVAL", scripts.enqueue(), "0", PREFIX, to_str(batch.len())]

    for i in range(from: 0, to: batch.len())
        match replies.job_words(batch[i])
            .err e => return fail(code: e.code, msg: f"the job at {i} of the batch: {e.msg}")
            .ok more =>
                for w in more
                    words @ words.push(w)

    items = redis.texts_of(redis.call(@c, words)?)?

    if replies.word_at(items, 0)? == "exists"
        place = replies.word_at(items, 1)?
        holder = replies.word_at(items, 2)?

        if holder == "batch"
            return fail(
                code: jobs.EXISTS,
                msg: f"the job at {place} of the batch: its unique key is held by a job before it in the batch"
            )
        return fail(
            code: jobs.EXISTS,
            msg: f"the job at {place} of the batch: its unique key is held by job {replies.id_text(holder)}"
        )
    return replies.ids_of(items)

# The job not finished, waiting or running, that holds the unique key `key`.
#
# - `c`: the client.
# - `key`: the key, not empty.
#
# Fails `invalid` where `key` is empty, `not_found` where no job not
# finished holds it. See also `enqueue`.
function find_unique(@c: redis.Client, key: str) -> jobs.Info?
    limits.check_name(what: "the unique key", name: key, empty_allowed: false)?

    match redis.text_of(redis.call(@c, ["GET", PREFIX + "unique:" + key])?)
        .err _     => return fail(code: jobs.NOT_FOUND, msg: f"no job not finished holds the unique key \"{key}\"")
        .ok member => return replies.info_of_reply(redis.call(@c, ["HGETALL", PREFIX + "job:" + member])?)

## Claiming and finishing

# Claims the next job due in `worker`'s queues and answers it running, its
# lease held for `worker.lease`: the first by priority, then by when it
# became due, then by id, in any queue of the worker that is not paused.
#
# - `c`: the client.
# - `worker`: who claims, checked by `jobs.check_worker`.
#
# The job's `attempt` is the attempt now begun, which every call about it
# hands back. Fails `not_found` where no job is ready, and the program
# sleeps `worker.poll` before it asks again; fails as `jobs.check_worker`
# and `redis.call` fail. See also `complete`, `fail_attempt`, `extend`.
function claim(@c: redis.Client, worker: jobs.Worker) -> jobs.Info?
    jobs.check_worker(worker)?
    words: [str] @= ["EVAL", scripts.claim(), "0", PREFIX, to_str(replies.micros(worker.lease)), worker.name]

    for q in worker.queues
        words @ words.push(q)

    r = redis.call(@c, words)?

    if redis.list_of(r)?.len() == 0
        return fail(code: jobs.NOT_FOUND, msg: f"no job is ready in the queues {worker.queues.join(", ")}")
    return replies.info_of_reply(r)

# Marks the claimed attempt done, the job completed, keeping `output`.
#
# - `c`: the client.
# - `claimed`: the job as `claim` answered it.
# - `output`: what the work answered, for whoever reads the job later;
#   `.null_value` for nothing.
#
# A job whose cancellation was asked while it ran is completed all the
# same: the work is done. Fails `not_found` where the attempt is no longer
# running, as its lease ran out and `rescue` gave it back; fails as
# `json.format` fails where `output` holds a `nan`. See also `claim`.
function complete(@c: redis.Client, claimed: jobs.Info, output: json.Value) -> ()?
    text = json.format(output)?
    r = redis.call(@c, ["EVAL", scripts.complete(), "0", PREFIX, to_str(claimed.id), to_str(claimed.attempt), text])?
    return replies.answered(r, claimed)

# Marks the claimed attempt failed with `error`, and answers the job as it
# now stands: waiting a wait of `worker.backoff` before its next attempt,
# or failed for good where it had no attempt left, or cancelled where its
# cancellation was asked while it ran.
#
# - `c`: the client.
# - `worker`: the worker that claimed it, whose `backoff` gives the wait.
# - `claimed`: the job as `claim` answered it.
# - `error`: what went wrong, kept with the job's errors; any text.
#
# Fails `not_found` where the attempt is no longer running; as
# `jobs.check_worker` and `jobs.retry_wait` fail. See also `discard`,
# `snooze`, `fail_attempt_with`, `jobs.retry_wait`.
function fail_attempt(@c: redis.Client, worker: jobs.Worker, claimed: jobs.Info, error: str) -> jobs.Info?
    jobs.check_worker(worker)?
    wait = jobs.retry_wait(worker.backoff, attempt: claimed.attempt)?
    return fail_attempt_with(@c, claimed: claimed, error: error, wait: wait)

# Marks the claimed attempt failed with `error`, as `fail_attempt` does, the
# job waiting `wait` before its next attempt where it has one left: the wait
# the program computed itself, `jobs.retry_wait_with` over a fraction it
# drew from a generator it seeded, so its waits repeat run after run.
#
# - `c`: the client.
# - `claimed`: the job as `claim` answered it.
# - `error`: what went wrong, kept with the job's errors; any text.
# - `wait`: how long before the next attempt may be claimed, zero or more;
#   kept to the microsecond, as the store keeps every time.
#
# Fails `invalid` where `wait` is below zero, `not_found` where the attempt
# is no longer running. See also `fail_attempt`, `jobs.retry_wait_with`.
function fail_attempt_with(@c: redis.Client, claimed: jobs.Info, error: str, wait: time.Duration) -> jobs.Info?
    if wait.nanoseconds < 0
        return fail(code: jobs.INVALID, msg: f"the wait, {time.format_duration(wait)}, is below zero")
    r = redis.call(@c, ["EVAL", scripts.fail_attempt(), "0", PREFIX, to_str(claimed.id), to_str(claimed.attempt), json.quote(error), "retry", to_str(replies.micros(wait))])?
    return replies.job_answered(r, claimed)

# Marks the claimed attempt failed with `error` and the job failed for
# good, whatever attempts it had left: for an error no retry can mend, a
# payload the program cannot read.
#
# - `c`: the client.
# - `claimed`: the job as `claim` answered it.
# - `error`: why, kept with the job's errors.
#
# A job whose cancellation was asked is cancelled instead. Fails
# `not_found` where the attempt is no longer running. See also
# `fail_attempt`, `retry`.
function discard(@c: redis.Client, claimed: jobs.Info, error: str) -> ()?
    r = redis.call(@c, ["EVAL", scripts.fail_attempt(), "0", PREFIX, to_str(claimed.id), to_str(claimed.attempt), json.quote(error), "discard", "0"])?
    _ = replies.job_answered(r, claimed)?
    return ok()

# Gives the claimed attempt back uncounted, the job to run again after
# `wait`: for work that must wait for something else, a resource busy, a
# limit of calls.
#
# - `c`: the client.
# - `claimed`: the job as `claim` answered it.
# - `wait`: how long before it may be claimed again, zero or more.
#
# A job whose cancellation was asked is cancelled instead. Fails `invalid`
# where `wait` is below zero, `not_found` where the attempt is no longer
# running. See also `fail_attempt`.
function snooze(@c: redis.Client, claimed: jobs.Info, wait: time.Duration) -> ()?
    if wait.nanoseconds < 0
        return fail(code: jobs.INVALID, msg: f"the wait, {time.format_duration(wait)}, is below zero")
    r = redis.call(@c, ["EVAL", scripts.snooze(), "0", PREFIX, to_str(claimed.id), to_str(claimed.attempt), to_str(replies.micros(wait))])?
    return replies.answered(r, claimed)

# Renews the claimed attempt's lease for `worker.lease` from now, and
# answers the job: a job that runs longer than its lease calls it before the
# lease ends, and so learns whether its cancellation was asked.
#
# - `c`: the client.
# - `worker`: the worker that claimed it, whose `lease` is renewed.
# - `claimed`: the job as `claim` answered it.
#
# Fails `stopped` where the job's cancellation was asked: the lease is
# renewed all the same, and the worker stops and calls `fail_attempt`,
# which cancels the job. Fails `not_found` where the attempt is no longer
# running, and as `jobs.check_worker` fails. See also `cancel`.
function extend(@c: redis.Client, worker: jobs.Worker, claimed: jobs.Info) -> jobs.Info?
    jobs.check_worker(worker)?
    r = redis.call(@c, ["EVAL", scripts.extend(), "0", PREFIX, to_str(claimed.id), to_str(claimed.attempt), to_str(replies.micros(worker.lease))])?
    renewed = replies.job_answered(r, claimed)?

    if renewed.cancel_requested
        return fail(code: jobs.STOPPED, msg: f"job {claimed.id}'s cancellation was asked while it ran")
    return ok(renewed)

## Keeping the store

# Gives back every running job whose lease ran out, its worker gone or
# stalled, and answers how many: each attempt counts as failed with the
# store's words, and the job is ready again at once, or failed for good
# where it had no attempt left, or cancelled where that was asked.
#
# - `c`: the client.
#
# Any worker may call it, as often as it likes; a worker loop calls it
# every few minutes. Fails as `redis.call` fails. See also `extend`.
function rescue(@c: redis.Client) -> i64?
    return redis.int_of(redis.call(@c, ["EVAL", scripts.rescue(), "0", PREFIX])?)

# Removes every job of `state` that finished more than `older_than` ago, and
# answers how many.
#
# - `c`: the client.
# - `state`: `completed`, `failed` or `cancelled`.
# - `older_than`: how long ago at least, zero or more; zero removes all.
#
# Fails `invalid` where `state` is not finished or `older_than` is below
# zero. The server runs it whole, so purging many jobs holds it for that
# long. See also `jobs.is_finished`.
function purge(@c: redis.Client, state: jobs.State, older_than: time.Duration) -> i64?
    if !jobs.is_finished(state)
        return fail(
            code: jobs.INVALID,
            msg: f"only finished jobs are purged, and {jobs.state_name(state)} is not finished"
        )

    if older_than.nanoseconds < 0
        return fail(code: jobs.INVALID, msg: f"the age, {time.format_duration(older_than)}, is below zero")
    return redis.int_of(
        redis.call(@c, ["EVAL", scripts.purge(), "0", PREFIX, jobs.state_name(state), to_str(replies.micros(older_than))])?
    )

# Pauses `queue`: no worker claims from it until `resume`, and its jobs
# wait. A job running goes on.
#
# - `c`: the client.
# - `queue`: the queue, which need not hold a job yet.
#
# Fails `invalid` where `queue` is empty, too long or holds a zero byte.
# See also `resume`, `paused_queues`.
function pause(@c: redis.Client, queue: str) -> ()?
    limits.check_name(what: "the queue", name: queue, empty_allowed: false)?
    _ = redis.call(@c, ["SADD", PREFIX + "paused", queue])?
    return ok()

# Resumes `queue`, paused or not.
#
# - `c`: the client.
# - `queue`: the queue.
#
# Fails `invalid` where `queue` is empty, too long or holds a zero byte.
# See also `pause`.
function resume(@c: redis.Client, queue: str) -> ()?
    limits.check_name(what: "the queue", name: queue, empty_allowed: false)?
    _ = redis.call(@c, ["SREM", PREFIX + "paused", queue])?
    return ok()

# The queues paused, in the order of their names' bytes.
#
# - `c`: the client.
#
# Fails as `redis.call` fails. See also `pause`.
function paused_queues(@c: redis.Client) -> [str]?
    return ok(sort(redis.texts_of(redis.call(@c, ["SMEMBERS", PREFIX + "paused"])?)?))

## Reading and changing a job

# The job `id`.
#
# - `c`: the client.
# - `id`: its id.
#
# Fails `not_found` where the store holds no such job. See also `list`.
function get(@c: redis.Client, id: i64) -> jobs.Info?
    match replies.info_of_reply(redis.call(@c, ["HGETALL", PREFIX + "job:" + replies.member_of(id)])?)
        .ok i => return ok(i)
        .err e =>
            if e.code == jobs.NOT_FOUND
                return fail(code: jobs.NOT_FOUND, msg: f"the store holds no job {id}")
            return fail(code: e.code, msg: e.msg)

# The jobs of `queue` in `state`, at most `limit` after the first `offset`:
# for `available` in the order they would be claimed, those ready first;
# for `running` the lease that runs out first first; for the finished the
# newest first.
#
# - `c`: the client.
# - `queue`: the queue.
# - `state`: the state.
# - `offset`: how many to pass over, zero or more.
# - `limit`: how many at most, from 0 to 1000.
#
# Fails `invalid` where `offset` is below zero or `limit` outside 0 to
# 1000. See also `counts`, `get`.
function list(@c: redis.Client, queue: str, state: jobs.State, offset: i64, limit: i64) -> [jobs.Info]?
    if offset < 0 || limit < 0 || limit > 1_000
        return fail(
            code: jobs.INVALID,
            msg: f"the page of {limit} jobs after {offset} is outside 0 to 1000 jobs after 0 or more"
        )
    r = redis.call(@c, ["EVAL", scripts.list(), "0", PREFIX, queue, jobs.state_name(state), to_str(offset), to_str(limit)])?
    found: [jobs.Info] @= []

    for item in redis.list_of(r)?
        found @ found.push(replies.info_of_reply(item)?)

    return ok(found)

# How many jobs stand in each queue and state, those with none left out,
# in the order of the queues' names, then of the states' names.
#
# - `c`: the client.
#
# Fails as `redis.call` fails. See also `list`.
function counts(@c: redis.Client) -> [jobs.Count]?
    texts = redis.texts_of(redis.call(@c, ["EVAL", scripts.counts(), "0", PREFIX])?)?
    seen_keys: [str] @= []
    by_key: {str: jobs.Count} @= {}
    at: i64 @= 0

    while at + 2 < texts.len()
        key = texts[at] + "\n" + texts[at + 1]
        seen_keys @ seen_keys.push(key)
        by_key[key] @ jobs.Count(
            queue: texts[at],
            state: jobs.parse_state(texts[at + 1])?,
            jobs: replies.whole(texts[at + 2])?
        )
        at @ at + 3

    out: [jobs.Count] @= []

    for key in sort(seen_keys)
        out @ out.push(by_key[key]?)

    return ok(out)

# Cancels job `id` and answers its state after: `cancelled` where it waited
# or was cancelled already; `running` where it runs, its cancellation asked,
# which its worker learns from `extend` and which a failed attempt then
# carries out.
#
# - `c`: the client.
# - `id`: the job.
#
# Fails `not_found` where the store holds no such job, `invalid` where it
# completed or failed already. See also `extend`, `retry`.
function cancel(@c: redis.Client, id: i64) -> jobs.State?
    answer = redis.text_of(redis.call(@c, ["EVAL", scripts.cancel(), "0", PREFIX, to_str(id)])?)?

    if answer == "missing"
        return fail(code: jobs.NOT_FOUND, msg: f"the store holds no job {id}")
    state = jobs.parse_state(answer)?

    if state == .cancelled || state == .running
        return ok(state)
    return fail(code: jobs.INVALID, msg: f"job {id} is {answer} already, so nothing is left to cancel")

# Makes job `id` ready to run now, and answers it: a job failed, cancelled
# or completed runs again, with one attempt more where it had none left; a
# job waiting is made ready at once.
#
# - `c`: the client.
# - `id`: the job.
#
# Fails `not_found` where the store holds no such job; `invalid` where it
# runs; `exists` where another job not finished holds its unique key. See
# also `cancel`, `discard`.
function retry(@c: redis.Client, id: i64) -> jobs.Info?
    r = redis.call(@c, ["EVAL", scripts.retry(), "0", PREFIX, to_str(id)])?
    texts = redis.texts_of(r)?

    if texts.len() == 1 && texts[0] == "missing"
        return fail(code: jobs.NOT_FOUND, msg: f"the store holds no job {id}")

    if texts.len() == 1 && texts[0] == "running"
        return fail(code: jobs.INVALID, msg: f"job {id} is running, so it cannot be retried until its attempt ends")

    if texts.len() == 2 && texts[0] == "exists"
        return fail(code: jobs.EXISTS, msg: f"job {id}'s unique key is held by job {replies.id_text(texts[1])}")
    return replies.info_of_reply(r)

# Removes job `id`, whatever it stands in but `running`.
#
# - `c`: the client.
# - `id`: the job.
#
# Fails `not_found` where the store holds no such job, `invalid` where it
# runs: `cancel` it, and remove it once its worker has stopped. See also
# `purge`.
function delete(@c: redis.Client, id: i64) -> ()?
    answer = redis.text_of(redis.call(@c, ["EVAL", scripts.delete(), "0", PREFIX, to_str(id)])?)?

    if answer == "missing"
        return fail(code: jobs.NOT_FOUND, msg: f"the store holds no job {id}")

    if answer == "running"
        return fail(code: jobs.INVALID, msg: f"job {id} is running, so it cannot be removed: cancel it first")
    return ok()

## Periodic jobs

# Enqueues the job of each schedule of `schedules` whose run is due, and
# answers the ids enqueued: any number of programs may call it, as often as
# they like, and each due run is enqueued once.
#
# - `c`: the client.
# - `schedules`: the schedules, each checked; a schedule first seen, or
#   whose cron text changed, is kept with its next run after now and
#   enqueues nothing yet.
#
# The store keeps each schedule's next run by its name: the program that
# finds it due moves it to the first run after now and enqueues its job in
# one script, so runs missed while no program called are enqueued once, not
# once each. A job refused for its unique key is not enqueued, and its run
# is passed all the same. Fails as `jobs.check_job` fails, `not_found`
# where a schedule never runs again, and as `redis.call` fails. See also
# `jobs.new_periodic`.
function enqueue_due(@c: redis.Client, schedules: [jobs.Periodic]) -> [i64]?
    for p in schedules
        jobs.check_job(p.job)?

    ids: [i64] @= []

    for p in schedules
        clock = redis.texts_of(redis.call(@c, ["TIME"])?)?
        now = time.from_unix(whole_seconds: replies.whole(replies.word_at(clock, 0)?)?, extra_nanoseconds: replies.whole(replies.word_at(clock, 1)?)? * 1_000)?
        first = jobs.next_due(p, after: now)?
        kept = redis.texts_of(redis.call(@c, ["EVAL", scripts.keep_schedule(), "0", PREFIX, p.name, p.schedule.text, to_str(time.unix_microseconds(first))])?)?
        kept_at = replies.word_at(kept, 0)?
        next_at = replies.whole(kept_at)?
        server_now = time.from_unix_microseconds(replies.whole(replies.word_at(kept, 1)?)?)?

        if next_at <= time.unix_microseconds(server_now)
            next = jobs.next_due(p, after: server_now)?
            once @= p.job
            once.start @ .now
            words: [str] @= [
                "EVAL"
                scripts.advance()
                "0"
                PREFIX
                p.name
                kept_at
                to_str(time.unix_microseconds(next))
            ]

            for w in replies.job_words(once)?
                words @ words.push(w)

            id = redis.text_of(redis.call(@c, words)?)?

            if id != ""
                ids @ ids.push(replies.whole(id)?)

    return ok(ids)

## Limits workers share

# Makes the limit `name` full, a token every `every` and a burst of `burst`,
# or gives the limit of that name this rate and burst, holding the tokens it
# held, as many as the new burst allows, a debt kept: `jobs.bucket` and
# `jobs.with_rate` kept in the store, where every worker of the server takes
# from the one limit. Answers the limit after, its `seen` the server's time
# of the change.
#
# - `c`: the client.
# - `name`: the limit's name, a job's kind or a host or any key, checked as a
#   kind is; it is kept under its own key, `PREFIX`, `limit:` and the name,
#   so two names never share one.
# - `every`: the time to earn one token.
# - `burst`: the most tokens it holds, so the most attempts that go at once.
#
# The change is a script the server runs whole: no other client's command
# falls between its reading of the limit and its writing. The tokens held
# are rounded to the nanosecond at the new rate. Fails `invalid` as
# `jobs.bucket` does, where `name` is empty, too long or holds a zero byte,
# and where its key holds something the store did not write as a limit;
# `does_not_fit` where the debt kept at the new rate reaches past what an
# `Instant` holds, the limit unchanged; and as `redis.call` fails. See also
# `allow`, `remove_limit`.
function set_limit(@c: redis.Client, name: str, every: time.Duration, burst: i64) -> jobs.Bucket?
    return buckets.set(@c, name: name, every: every, burst: burst, clock: .server)

# Removes the limit `name`; a worker that asks it next fails `not_found`.
#
# - `c`: the client.
# - `name`: the limit's name.
#
# Fails `not_found` where no limit has that name, `invalid` where `name` is
# not one a store keeps, and as `redis.call` fails. See also `set_limit`.
function remove_limit(@c: redis.Client, name: str) -> ()?
    return buckets.remove(@c, name: name)

# The limit `name` as it stands now, its `seen` the server's time of the
# reading: `jobs.tokens(limit, at: limit.seen)` is what it holds then.
#
# - `c`: the client.
# - `name`: the limit's name.
#
# Fails `not_found` where no limit has that name, `invalid` where `name` is
# not one a store keeps or its key holds something the store did not write
# as a limit, and as `redis.call` fails. See also `set_limit`.
function limit_named(@c: redis.Client, name: str) -> jobs.Bucket?
    return buckets.read(@c, name: name, clock: .server)

# Whether `n` tokens of the limit `name` are there now, taking them where
# they are, as `jobs.allow` does of a bucket the program holds; any number of
# workers on any number of connections take from it, and none more than it
# holds.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `n`: how many tokens the attempt costs, 1 or more.
#
# Where they are not all there nothing is taken and `granted` is false, the
# attempt asking for more than the burst included; the limit answered is the
# one read, its `seen` the server's time, so `jobs.reserve(found.bucket, at:
# found.bucket.seen, n)` tells the wait, which a worker gives `snooze`, whose
# clock is the same server's. The time is the server's `TIME` as the script
# runs, never earlier than the latest time the limit read. Fails `invalid`
# where `n` is below 1 or `name` is not one a store keeps, `not_found` where
# no limit has that name, `does_not_fit` where the tokens are earned past
# what an `Instant` holds, and as `redis.call` fails. See also `reserve`,
# `set_limit`.
function allow(@c: redis.Client, name: str, n: i64) -> jobs.Allowed?
    taken = buckets.take(@c, name: name, n: n, longest: time.Duration(nanoseconds: 0), clock: .server)?
    return taking.allowed(taken)

# Takes `n` tokens of the limit `name` now even if they are not there, and
# tells how long to wait for them: reservations of every worker queue, each
# behind the ones before, as `jobs.reserve` does.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `n`: how many tokens, from 1 to the burst.
#
# Fails `invalid` where `n` is below 1 or past the burst or `name` is not one
# a store keeps, `not_found` where no limit has that name, `does_not_fit`
# where the tokens are earned past what an `Instant` holds, and as
# `redis.call` fails. See also `reserve_within`, `cancel_reservation`.
function reserve(@c: redis.Client, name: str, n: i64) -> jobs.Reservation?
    return reserve_within(@c, name: name, n: n, within: time.max_duration())

# `reserve`, the tokens taken only where the wait for them is no longer than
# `within`, as `jobs.reserve_within` does.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `n`: how many tokens.
# - `within`: the longest wait the caller will accept; nothing means the
#   tokens must be there.
#
# Fails `timeout` where the wait is longer, nothing taken, and as `reserve`
# does. See also `allow`.
function reserve_within(@c: redis.Client, name: str, n: i64, within: time.Duration) -> jobs.Reservation?
    taken = buckets.take(@c, name: name, n: n, longest: within, clock: .server)?
    return taking.reserved(taken, within: within)

# Gives the reservation `taken` of the limit `name` back, as far as no later
# taking of any worker has used what it took, as `jobs.cancel` does, and
# answers the limit after.
#
# - `c`: the client.
# - `name`: the limit the reservation was taken of.
# - `taken`: the reservation, as `reserve` answered it; once its time to act
#   has passed it gives back nothing.
#
# Fails `invalid` where the reservation holds no token or `name` is not one
# a store keeps, `not_found` where no limit has that name, `does_not_fit`
# where what it gives back leaves the limit empty past what an `Instant`
# holds, and as `redis.call` fails. See also `reserve`.
function cancel_reservation(@c: redis.Client, name: str, taken: jobs.Reservation) -> jobs.Bucket?
    return buckets.give_back(@c, name: name, taken: taken, clock: .server)

## Tests

test "PREFIX: every key of the store begins with rebel_jobs:"
    assert PREFIX == "rebel_jobs:"

test "live: the version of the server REBEL_REDIS_URL names"
    match live.connect()
        .ok first =>
            c @= first
            info = redis.text_of(redis.call(@c, ["INFO", "server"]).must()).must()
            print(
                "jobs/redis_store live: against ",
                strings.split(s: strings.split(s: info, sep: "redis_version:")[1], sep: "\r\n")[0]
            )
            redis.close(@c).must()
        .err e => skip_test(reason: e.msg)

test "enqueue live: each start, a past instant ready at once, a payload of more than one byte, a unique key held and freed, and the refusals"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            later @= jobs.new_job("later", .null_value)
            later.start @ .after(wait: time.milliseconds(400).must())
            later_id = enqueue(@c, later).must()
            past @= jobs.new_job("past", .text(v: "città 🎸"))
            past.start @ .at(instant: time.epoch())
            past_id = enqueue(@c, past).must()
            future @= jobs.new_job("future", .null_value)
            future.start @ .at(instant: time.add(time.now().must(), time.hours(1).must()).must())
            _ = enqueue(@c, future).must()
            got = claim(@c, worker).must()
            assert got.id == past_id && got.payload == .text(v: "città 🎸") && got.run_at == time.epoch() && got.attempt == 1

            match claim(@c, worker)
                .ok _  => assert false
                .err e => assert e.code == jobs.NOT_FOUND && e.msg == "no job is ready in the queues default"

            time.sleep(time.milliseconds(500).must())
            assert claim(@c, worker).must().id == later_id
            u @= jobs.new_job("sync", .null_value)
            u.unique_key @ "sync:1"
            held = enqueue(@c, u).must()

            match enqueue(@c, u)
                .ok _  => assert false
                .err e => assert e.code == jobs.EXISTS && e.msg == f"the unique key \"sync:1\" is held by job {held}"

            assert find_unique(@c, "sync:1").must().id == held
            complete(@c, claim(@c, worker).must(), .null_value).must()
            again = enqueue(@c, u).must()
            assert again > held && find_unique(@c, "sync:1").must().id == again
            assert find_unique(@c, "").is_err() && find_unique(@c, "none").is_err()
            bad = jobs.new_job("", .null_value)
            assert enqueue(@c, bad).is_err()
            redis.close(@c).must()

test "enqueue_many live: none, all kept, and a duplicate keeping none, held before or within the batch"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            assert enqueue_many(@c, []).must() == []
            u @= jobs.new_job("u", .null_value)
            u.unique_key @ "u"
            ids = enqueue_many(@c, [jobs.new_job("a", .null_value), u]).must()
            assert ids.len() == 2 && ids[1] == ids[0] + 1

            match enqueue_many(@c, [jobs.new_job("b", .null_value), u])
                .ok _  => assert false
                .err e => assert e.code == jobs.EXISTS && e.msg == f"the job at 1 of the batch: its unique key is held by job {ids[1]}"

            v @= u
            v.unique_key @ "v"

            match enqueue_many(@c, [v, jobs.new_job("c", .null_value), v])
                .ok _  => assert false
                .err e => assert e.code == jobs.EXISTS && e.msg == "the job at 2 of the batch: its unique key is held by a job before it in the batch"

            assert counts(@c).must() == [jobs.Count(queue: "default", state: .available, jobs: 2)]
            bad @= jobs.new_job("x", .null_value)
            bad.priority @ 0

            match enqueue_many(@c, [jobs.new_job("d", .null_value), bad])
                .ok _  => assert false
                .err e => assert e.code == jobs.INVALID && e.msg == "the job at 1 of the batch: the priority 0 is outside 1 to 9"

            redis.close(@c).must()

test "claim live: by priority across queues, ids in order within one millisecond, a queue paused passed over, and a bad worker refused"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            low @= jobs.new_job("low", .null_value)
            low.priority @ 9
            high @= jobs.new_job("high", .null_value)
            high.priority @ 1
            high.queue @ "mail"
            other @= jobs.new_job("other", .null_value)
            other.queue @ "other"
            other.priority @ 1
            batch: [jobs.Job] @= [low, high, other]

            for i in range(from: 0, to: 12)
                batch @ batch.push(jobs.new_job(f"middle{i}", .null_value))

            _ = enqueue_many(@c, batch).must()
            worker @= jobs.new_worker(["default", "mail"])
            assert claim(@c, worker).must().kind == "high"
            pause(@c, "default").must()
            assert claim(@c, worker).is_err()
            resume(@c, "default").must()

            for i in range(from: 0, to: 12)
                assert claim(@c, worker).must().kind == f"middle{i}"

            assert claim(@c, worker).must().kind == "low"
            assert claim(@c, worker).is_err()
            worker.queues @ []
            assert claim(@c, worker).is_err()
            redis.close(@c).must()

test "complete and fail_attempt live: a second completion refused, attempts spent fail for good with every error, and an error of quotes and more than one byte"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            done_id = enqueue(@c, jobs.new_job("once", .null_value)).must()
            done = claim(@c, worker).must()
            complete(@c, done, .object(members: {"rows": .number(v: 3.0)})).must()

            match complete(@c, done, .null_value)
                .ok _  => assert false
                .err e => assert e.code == jobs.NOT_FOUND && e.msg == f"job {done.id}'s attempt 1 is no longer running: its lease ran out and `rescue` gave it back, or it was finished, cancelled or deleted"

            finished = get(@c, done_id).must()
            assert finished.state == .completed && finished.output == .object(members: {"rows": .number(v: 3.0)}) && !finished.finished_at.is_err()
            two @= jobs.new_job("twice", .null_value)
            two.max_attempts @ 2
            id = enqueue(@c, two).must()
            first_try = claim(@c, worker).must()
            waiting = fail_attempt(@c, worker, first_try, error: "città \"quoted\"").must()
            assert waiting.state == .available && waiting.finished_at.is_err() && waiting.lease_until.is_err()
            assert time.is_after(
                a: waiting.run_at,
                b: time.add(first_try.attempted_at.must(), time.seconds(11).must()).must()
            )
            assert claim(@c, worker).is_err()
            assert retry(@c, id).must().state == .available
            second_try = claim(@c, worker).must()
            assert second_try.attempt == 2 && second_try.errors.len() == 1
            ended = fail_attempt(@c, worker, second_try, error: "again").must()
            assert ended.state == .failed && !ended.finished_at.is_err()
            assert ended.errors.len() == 2 && ended.errors[0].error == "città \"quoted\"" && ended.errors[1].error == "again" && ended.errors[1].attempt == 2
            assert fail_attempt(@c, worker, second_try, error: "again").is_err()
            assert counts(@c).must() == [jobs.Count(queue: "default", state: .completed, jobs: 1), jobs.Count(queue: "default", state: .failed, jobs: 1)]
            redis.close(@c).must()

test "fail_attempt_with live: the job waits the wait given, zero runs it again at once, the last attempt fails for good, and a wait below zero refused"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            three @= jobs.new_job("thrice", .null_value)
            three.max_attempts @ 3
            id = enqueue(@c, three).must()
            first_try = claim(@c, worker).must()

            match fail_attempt_with(@c, claimed: first_try, error: "never", wait: time.Duration(nanoseconds: -1))
                .ok _  => assert false
                .err e => assert e.code == jobs.INVALID && e.msg == "the wait, -1ns, is below zero"

            waiting = fail_attempt_with(@c, claimed: first_try, error: "first", wait: time.seconds(90).must()).must()
            assert waiting.state == .available && waiting.errors.len() == 1
            began = first_try.attempted_at.must()
            assert time.is_after(a: waiting.run_at, b: time.add(began, time.seconds(89).must()).must())
            assert time.is_after(a: time.add(began, time.seconds(150).must()).must(), b: waiting.run_at)
            assert claim(@c, worker).is_err()
            assert retry(@c, id).must().state == .available
            second_try = claim(@c, worker).must()
            again = fail_attempt_with(
                @c,
                claimed: second_try,
                error: "second",
                wait: time.Duration(nanoseconds: 0)
            ).must()
            assert again.state == .available
            third_try = claim(@c, worker).must()
            assert third_try.attempt == 3
            ended = fail_attempt_with(@c, claimed: third_try, error: "third", wait: time.seconds(5).must()).must()
            assert ended.state == .failed && ended.errors.len() == 3 && ended.errors[2].error == "third"
            assert fail_attempt_with(
                @c,
                claimed: third_try,
                error: "late",
                wait: time.Duration(nanoseconds: 0)
            ).is_err()
            redis.close(@c).must()

test "discard, snooze and extend live: failed for good at once, an attempt given back uncounted, a lease renewed, and a cancellation learnt"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            id = enqueue(@c, jobs.new_job("a", .null_value)).must()
            claimed = claim(@c, worker).must()
            assert snooze(@c, claimed, wait: time.Duration(nanoseconds: -1)).is_err()
            snooze(@c, claimed, wait: time.Duration(nanoseconds: 0)).must()
            assert get(@c, id).must().attempt == 0
            again = claim(@c, worker).must()
            assert again.attempt == 1
            renewed = extend(@c, worker, again).must()
            assert renewed.attempt == 1 && !time.is_after(a: again.lease_until.must(), b: renewed.lease_until.must())
            assert cancel(@c, id).must() == .running
            assert get(@c, id).must().cancel_requested

            match extend(@c, worker, again)
                .ok _  => assert false
                .err e => assert e.code == jobs.STOPPED && e.msg == f"job {id}'s cancellation was asked while it ran"

            assert fail_attempt(@c, worker, again, error: "stopped").must().state == .cancelled
            other = enqueue(@c, jobs.new_job("b", .null_value)).must()
            discard(@c, claim(@c, worker).must(), error: "unreadable").must()
            gone = get(@c, other).must()
            assert gone.state == .failed && gone.attempt == 1 && gone.max_attempts == 25 && gone.errors[0].error == "unreadable"
            redis.close(@c).must()

test "rescue live: a lease run out given back counted, a late completion refused, and a job of one attempt failed for good"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker @= jobs.new_worker([jobs.DEFAULT_QUEUE])
            worker.lease @ time.seconds(1).must()
            id = enqueue(@c, jobs.new_job("slow", .null_value)).must()
            one @= jobs.new_job("single", .null_value)
            one.max_attempts @ 1
            single = enqueue(@c, one).must()
            slow = claim(@c, worker).must()
            _ = claim(@c, worker).must()
            assert rescue(@c).must() == 0
            time.sleep(time.milliseconds(1_100).must())
            assert rescue(@c).must() == 2
            back = get(@c, id).must()
            assert back.state == .available && back.attempt == 1 && back.errors.len() == 1
            assert back.errors[0].error == f"the lease of the worker \"{worker.name}\" ran out before the attempt finished"
            assert get(@c, single).must().state == .failed
            assert complete(@c, slow, .null_value).is_err()
            assert claim(@c, worker).must().attempt == 2
            redis.close(@c).must()

test "purge, get, list and counts live: the finished removed by age, a job not there, pages of a queue, and the refusals"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker(["q"])
            batch: [jobs.Job] @= []

            for i in range(from: 0, to: 5)
                j @= jobs.new_job(f"k{i}", .null_value)
                j.queue @ "q"
                j.priority @ 5 - i
                batch @ batch.push(j)

            ids = enqueue_many(@c, batch).must()
            later @= jobs.new_job("later", .null_value)
            later.queue @ "q"
            later.start @ .after(wait: time.hours(1).must())
            later_id = enqueue(@c, later).must()
            page = list(@c, queue: "q", state: .available, offset: 1, limit: 2).must()
            assert page.len() == 2 && page[0].id == ids[3] && page[1].id == ids[2]
            tail = list(@c, queue: "q", state: .available, offset: 4, limit: 10).must()
            assert tail.len() == 2 && tail[0].id == ids[0] && tail[1].id == later_id
            assert list(@c, queue: "q", state: .available, offset: 0, limit: 0).must() == []
            assert list(@c, queue: "q", state: .available, offset: -1, limit: 1).is_err()
            assert list(@c, queue: "q", state: .available, offset: 0, limit: 1_001).is_err()
            complete(@c, claim(@c, worker).must(), .null_value).must()
            time.sleep(time.milliseconds(5).must())
            complete(@c, claim(@c, worker).must(), .null_value).must()
            finished = list(@c, queue: "q", state: .completed, offset: 0, limit: 10).must()
            assert finished.len() == 2 && finished[0].id == ids[3] && finished[1].id == ids[4]
            assert counts(@c).must() == [jobs.Count(queue: "q", state: .available, jobs: 4), jobs.Count(queue: "q", state: .completed, jobs: 2)]
            assert purge(@c, .available, older_than: time.Duration(nanoseconds: 0)).is_err()
            assert purge(@c, .completed, older_than: time.Duration(nanoseconds: -1)).is_err()
            assert purge(@c, .completed, older_than: time.hours(1).must()).must() == 0
            time.sleep(time.milliseconds(5).must())
            assert purge(@c, .completed, older_than: time.Duration(nanoseconds: 0)).must() == 2
            assert get(@c, ids[4]).is_err()

            match get(@c, 999_999)
                .ok _  => assert false
                .err e => assert e.code == jobs.NOT_FOUND && e.msg == "the store holds no job 999999"

            redis.close(@c).must()

test "pause, resume and paused_queues live: two paused in order, one resumed, a queue never seen, and a bad name"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            pause(@c, "zeta").must()
            pause(@c, "alpha").must()
            pause(@c, "alpha").must()
            assert paused_queues(@c).must() == ["alpha", "zeta"]
            resume(@c, "zeta").must()
            resume(@c, "never").must()
            assert paused_queues(@c).must() == ["alpha"]
            assert pause(@c, "").is_err() && resume(@c, "").is_err()
            redis.close(@c).must()

test "cancel, retry and delete live: each state answered, a running job kept, a held key refused, and a job not there"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            assert cancel(@c, 424_242).is_err() && retry(@c, 424_242).is_err() && delete(@c, 424_242).is_err()
            u @= jobs.new_job("u", .null_value)
            u.unique_key @ "key"
            u.max_attempts @ 1
            id = enqueue(@c, u).must()
            assert cancel(@c, id).must() == .cancelled
            assert cancel(@c, id).must() == .cancelled
            assert !get(@c, id).must().finished_at.is_err()
            newer = enqueue(@c, u).must()

            match retry(@c, id)
                .ok _  => assert false
                .err e => assert e.code == jobs.EXISTS && e.msg == f"job {id}'s unique key is held by job {newer}"

            running = claim(@c, worker).must()
            assert running.id == newer

            match retry(@c, newer)
                .ok _  => assert false
                .err e => assert e.code == jobs.INVALID

            assert delete(@c, newer).is_err()
            assert fail_attempt(@c, worker, running, error: "no").must().state == .failed
            again = retry(@c, newer).must()
            assert again.state == .available && again.max_attempts == 2 && again.finished_at.is_err()
            complete(@c, claim(@c, worker).must(), .null_value).must()

            match cancel(@c, newer)
                .ok _  => assert false
                .err e => assert e.code == jobs.INVALID && e.msg == f"job {newer} is completed already, so nothing is left to cancel"

            assert retry(@c, newer).must().state == .available
            delete(@c, newer).must()
            delete(@c, id).must()
            assert get(@c, id).is_err() && counts(@c).must() == []
            assert find_unique(@c, "key").is_err()
            redis.close(@c).must()

test "enqueue_due live: first seen nothing, due once enqueued once, called again nothing, a changed schedule kept anew, and a held key passed"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            job @= jobs.new_job("report", .null_value)
            job.queue @ "reports"
            nightly = jobs.new_periodic(name: "nightly", cron: "0 3 * * *", job: job).must()
            assert enqueue_due(@c, [nightly]).must() == []
            _ = redis.call(@c, ["HSET", PREFIX + "periodic:nightly", "next_at", "1000000"]).must()
            ids = enqueue_due(@c, [nightly]).must()
            assert ids.len() == 1 && get(@c, ids[0]).must().queue == "reports"
            assert enqueue_due(@c, [nightly, nightly]).must() == []
            kept = redis.int_of(redis.call(@c, ["HGET", PREFIX + "periodic:nightly", "next_at"]).must()).must()
            assert kept % 86_400_000_000 == 3 * 3_600_000_000
            hourly = jobs.new_periodic(name: "nightly", cron: "0 * * * *", job: job).must()
            assert enqueue_due(@c, [hourly]).must() == []
            moved = redis.int_of(redis.call(@c, ["HGET", PREFIX + "periodic:nightly", "next_at"]).must()).must()
            assert moved % 3_600_000_000 == 0 && moved <= kept
            held @= job
            held.unique_key @ "one-report"
            _ = enqueue(@c, held).must()
            once = jobs.new_periodic(name: "held", cron: "* * * * *", job: held).must()
            assert enqueue_due(@c, [once]).must() == []
            _ = redis.call(@c, ["HSET", PREFIX + "periodic:held", "next_at", "1000000"]).must()
            assert enqueue_due(@c, [once]).must() == []
            assert redis.int_of(redis.call(@c, ["HGET", PREFIX + "periodic:held", "next_at"]).must()).must() > 1_000_000
            bad @= job
            bad.kind @ ""
            assert enqueue_due(@c, [jobs.new_periodic(name: "bad", cron: "* * * * *", job: bad).must()]).is_err()
            redis.close(@c).must()

test "allow live: forty tokens shared by takers on eight threads here and on four threads in each of three child processes, two hundred asked, forty granted in all"
    if takers.is_child()
        exit(code: takers.child())

    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "crawl", every: time.hours(1).must(), burst: 40).must()
            answers = takers.run(limit: "crawl", mode: "allow", times: 10, here: 8, children: 3, each: 4).must()
            granted: i64 @= 0

            for one in answers
                match numbers.parse_int(one)
                    .ok n => granted @ granted + n
                    .err _ =>
                        print("a taker answered: ", one)
                        assert false

            print("allow live: ", answers.len(), " takers granted ", granted, " tokens of a burst of 40")
            assert answers.len() == 20 && granted == 40
            assert !allow(@c, name: "crawl", n: 1).must().granted
            redis.close(@c).must()

test "reserve live: twenty-four reservations of a token every ten seconds by takers here and in two child processes, each ready at a time of its own, ten seconds after the one before"
    if takers.is_child()
        exit(code: takers.child())

    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "feed", every: time.seconds(10).must(), burst: 1).must()
            answers = takers.run(limit: "feed", mode: "reserve", times: 2, here: 4, children: 2, each: 4).must()
            ready: [i64] @= []

            for one in answers
                for part in strings.split(s: one, sep: ",")
                    match numbers.parse_int(part)
                        .ok n => ready @ ready.push(n)
                        .err _ =>
                            print("a taker answered: ", one)
                            assert false

            assert answers.len() == 12 && ready.len() == 24
            ordered = sort(ready)

            for i in range(from: 1, to: ordered.len())
                assert ordered[i] - ordered[i - 1] == 10_000_000_000

            redis.close(@c).must()

test "set_limit live: limits whose names differ by a byte, a colon, a case or a character of more than one byte keep a key each, and a taking of one leaves the others full"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            names = ["host", "host:", "Host", "hóst", "hos", "job:000000000000001"]

            for name in names
                _ = set_limit(@c, name: name, every: time.hours(1).must(), burst: 2).must()

            stored = sort(redis.texts_of(redis.call(@c, ["KEYS", PREFIX + "*"]).must()).must())
            wanted: [str] @= []

            for name in names
                wanted @ wanted.push(PREFIX + "limit:" + name)

            assert stored == sort(wanted)
            assert allow(@c, name: "host", n: 2).must().granted

            for name in names
                now = limit_named(@c, name: name).must()
                held = jobs.available(limit: now, at: now.seen)

                if name == "host"
                    assert held == 0
                else
                    assert held == 2

            enqueued = enqueue(@c, jobs.new_job("host", .null_value)).must()
            assert enqueued == 1 && get(@c, 1).must().kind == "host"
            remove_limit(@c, name: "host").must()
            assert !limit_named(@c, name: "host:").is_err() && !get(@c, 1).is_err()
            redis.close(@c).must()

test "allow live: a connection the server ended fails closed on every limit call and is closed, a new one finds the limit as it stood, and a server nobody answers at fails closed"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "api", every: time.hours(1).must(), burst: 3).must()
            assert allow(@c, name: "api", n: 1).must().granted
            id = redis.int_of(redis.call(@c, ["CLIENT", "ID"]).must()).must()
            other @= live.connect_kept().must()
            assert redis.int_of(redis.call(@other, ["CLIENT", "KILL", "ID", to_str(id)]).must()).must() == 1

            match allow(@c, name: "api", n: 1)
                .ok _  => assert false
                .err e => assert e.code == redis.CLOSED

            assert redis.is_closed(c)

            match set_limit(@c, name: "api", every: time.hours(1).must(), burst: 3)
                .ok _  => assert false
                .err e => assert e.code == redis.CLOSED

            assert limit_named(@c, name: "api").is_err() && reserve(@c, name: "api", n: 1).is_err()
            redis.close(@c).must()
            again @= live.connect_kept().must()
            now = limit_named(@again, name: "api").must()
            assert jobs.available(limit: now, at: now.seen) == 2
            assert allow(@again, name: "api", n: 2).must().granted && !allow(@again, name: "api", n: 1).must().granted
            redis.close(@again).must()
            redis.close(@other).must()
            nobody @= redis.options("127.0.0.1")
            nobody.port @ 1
            nobody.security @ .plain

            match redis.connect(nobody)
                .ok lost =>
                    l @= lost
                    redis.close(@l).must()
                    assert false
                .err e => assert e.code == redis.CLOSED

test "allow live: a limit refused now is granted once the wait it told has passed on the server's clock"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "tick", every: time.milliseconds(50).must(), burst: 1).must()
            assert allow(@c, name: "tick", n: 1).must().granted
            refused = allow(@c, name: "tick", n: 1).must()
            assert !refused.granted
            wait = jobs.reserve(limit: refused.bucket, at: refused.bucket.seen, n: 1).must().delay
            assert wait.nanoseconds > 0 && !time.is_longer(a: wait, b: time.milliseconds(50).must())
            time.sleep(time.sum(a: wait, b: time.milliseconds(5).must()).must())
            assert allow(@c, name: "tick", n: 1).must().granted
            redis.close(@c).must()

## Examples

# A job enqueued, to run as soon as a worker claims it.
test "enqueue: a welcome email"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("send_welcome", .object(members: {"user": .number(v: 7.0)}))).must()
            assert get(@c, id).must().state == .available
            redis.close(@c).must()

# Two jobs enqueued, all or none.
test "enqueue_many: two jobs"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            ids = enqueue_many(@c, [jobs.new_job("a", .null_value), jobs.new_job("b", .null_value)]).must()
            assert ids.len() == 2
            redis.close(@c).must()

# The job that holds a unique key.
test "find_unique: a nightly sync not yet run"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            j @= jobs.new_job("sync", .null_value)
            j.unique_key @ "sync:shop-1"
            id = enqueue(@c, j).must()
            assert find_unique(@c, "sync:shop-1").must().id == id
            redis.close(@c).must()

# A worker's loop: claim, run the program's own function, complete.
test "claim: the next job, run and completed"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = enqueue(@c, jobs.new_job("resize", .text(v: "photo.png"))).must()
            claimed = claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must()
            assert claimed.kind == "resize" && claimed.attempt == 1
            complete(@c, claimed, .null_value).must()
            redis.close(@c).must()

# A job completed with what it answered.
test "complete: a job and its output"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("count", .null_value)).must()
            complete(@c, claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must(), .number(v: 42.0)).must()
            assert get(@c, id).must().output == .number(v: 42.0)
            redis.close(@c).must()

# A failed attempt, the job waiting to run again.
test "fail_attempt: the first attempt failed, the job waits"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = enqueue(@c, jobs.new_job("charge", .null_value)).must()
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            after = fail_attempt(@c, worker, claim(@c, worker).must(), error: "the bank did not answer").must()
            assert after.state == .available && after.errors.len() == 1
            redis.close(@c).must()

# A failed attempt given the wait the program drew itself, the job waiting
# exactly that long.
test "fail_attempt_with: a wait of the program's own"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("charge", .null_value)).must()
            claimed = claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must()
            after = fail_attempt_with(
                @c,
                claimed: claimed,
                error: "the bank did not answer",
                wait: time.minutes(3).must()
            ).must()
            assert after.state == .available && get(@c, id).must().errors.len() == 1
            redis.close(@c).must()

# A job failed for good, whatever attempts it had left.
test "discard: a payload the program cannot read"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("import", .text(v: "not a file"))).must()
            discard(
                @c,
                claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must(),
                error: "the payload names no file"
            ).must()
            assert get(@c, id).must().state == .failed
            redis.close(@c).must()

# An attempt given back, the job to run again in a minute.
test "snooze: a resource busy"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("export", .null_value)).must()
            snooze(@c, claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must(), wait: time.minutes(1).must()).must()
            assert get(@c, id).must().attempt == 0
            redis.close(@c).must()

# A long job renewing its lease.
test "extend: the lease of a long job renewed"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = enqueue(@c, jobs.new_job("render", .null_value)).must()
            worker = jobs.new_worker([jobs.DEFAULT_QUEUE])
            claimed = claim(@c, worker).must()
            assert extend(@c, worker, claimed).must().attempt == 1
            redis.close(@c).must()

# The jobs of workers gone given back.
test "rescue: no lease has run out"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            assert rescue(@c).must() == 0
            redis.close(@c).must()

# The completed jobs of more than a day ago removed.
test "purge: completed jobs older than a day"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            assert purge(@c, .completed, older_than: time.hours(24).must()).must() == 0
            redis.close(@c).must()

# A queue paused, its jobs waiting.
test "pause: the mail queue"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            pause(@c, "mail").must()
            assert paused_queues(@c).must() == ["mail"]
            redis.close(@c).must()

# A queue paused, then claimed from again.
test "resume: the mail queue"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            pause(@c, "mail").must()
            resume(@c, "mail").must()
            assert paused_queues(@c).must() == []
            redis.close(@c).must()

# The queues paused.
test "paused_queues: none"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            assert paused_queues(@c).must() == []
            redis.close(@c).must()

# A job read by its id.
test "get: a job just enqueued"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("thumbnail", .null_value)).must()
            assert get(@c, id).must().kind == "thumbnail"
            redis.close(@c).must()

# The jobs waiting in a queue, in the order they would be claimed.
test "list: the jobs waiting in the default queue"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = enqueue(@c, jobs.new_job("a", .null_value)).must()
            assert list(@c, queue: jobs.DEFAULT_QUEUE, state: .available, offset: 0, limit: 10).must().len() == 1
            redis.close(@c).must()

# How many jobs stand in each queue and state.
test "counts: one job waiting"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = enqueue(@c, jobs.new_job("a", .null_value)).must()
            assert counts(@c).must() == [jobs.Count(queue: "default", state: .available, jobs: 1)]
            redis.close(@c).must()

# A job cancelled before it ran.
test "cancel: a job waiting"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("a", .null_value)).must()
            assert cancel(@c, id).must() == .cancelled
            redis.close(@c).must()

# A job failed for good, run again.
test "retry: a job discarded, run again"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("a", .null_value)).must()
            discard(@c, claim(@c, jobs.new_worker([jobs.DEFAULT_QUEUE])).must(), error: "no").must()
            assert retry(@c, id).must().state == .available
            redis.close(@c).must()

# A job removed.
test "delete: a job waiting"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            id = enqueue(@c, jobs.new_job("a", .null_value)).must()
            delete(@c, id).must()
            assert get(@c, id).is_err()
            redis.close(@c).must()

# A nightly report: its schedule kept the first time, enqueued once due.
test "enqueue_due: a schedule first seen enqueues nothing yet"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            nightly = jobs.new_periodic(
                name: "nightly",
                cron: "0 3 * * *",
                job: jobs.new_job("report", .null_value)
            ).must()
            assert enqueue_due(@c, [nightly]).must() == []
            redis.close(@c).must()

# A limit of two tokens a second with a burst of five, made full.
test "set_limit: two a second, five at once"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            made = set_limit(@c, name: "mail", every: time.milliseconds(500).must(), burst: 5).must()
            assert jobs.available(limit: made, at: made.seen) == 5
            redis.close(@c).must()

# A limit no longer needed.
test "remove_limit: a limit removed, then not found"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "import", every: time.seconds(1).must(), burst: 1).must()
            remove_limit(@c, name: "import").must()
            assert limit_named(@c, name: "import").is_err()
            redis.close(@c).must()

# The tokens a limit holds now.
test "limit_named: one of three tokens taken"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "api", every: time.hours(1).must(), burst: 3).must()
            assert allow(@c, name: "api", n: 1).must().granted
            now = limit_named(@c, name: "api").must()
            assert jobs.available(limit: now, at: now.seen) == 2
            redis.close(@c).must()

# A crawler's politeness toward one host: one request a second.
test "allow: a second request to a host refused, and its wait"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "example.org", every: time.seconds(1).must(), burst: 1).must()
            assert allow(@c, name: "example.org", n: 1).must().granted
            refused = allow(@c, name: "example.org", n: 1).must()
            assert !refused.granted
            wait = jobs.reserve(limit: refused.bucket, at: refused.bucket.seen, n: 1).must().delay
            assert wait.nanoseconds > 0 && !time.is_longer(a: wait, b: time.seconds(1).must())
            redis.close(@c).must()

# Reservations of every worker queue behind one another.
test "reserve: a third token waits its turn"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "report", every: time.hours(1).must(), burst: 2).must()
            _ = reserve(@c, name: "report", n: 2).must()
            third = reserve(@c, name: "report", n: 1).must()
            assert time.is_longer(a: third.delay, b: time.minutes(59).must()) && !time.is_longer(a: third.delay, b: time.hours(1).must())
            redis.close(@c).must()

# A wait longer than the caller accepts takes nothing.
test "reserve_within: a wait of an hour where a minute is allowed"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "sync", every: time.hours(1).must(), burst: 1).must()
            assert allow(@c, name: "sync", n: 1).must().granted

            match reserve_within(@c, name: "sync", n: 1, within: time.minutes(1).must())
                .ok _  => assert false
                .err e => assert e.code == jobs.TIMEOUT

            redis.close(@c).must()

# A reservation a worker no longer needs, given back.
test "cancel_reservation: the token comes back"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set_limit(@c, name: "upload", every: time.hours(1).must(), burst: 1).must()
            assert allow(@c, name: "upload", n: 1).must().granted
            waiting = reserve(@c, name: "upload", n: 1).must()
            back = cancel_reservation(@c, name: "upload", taken: waiting).must()
            assert jobs.tokens(limit: back, at: back.seen) > -0.5
            redis.close(@c).must()
