# A connection for the tests that run against a live Redis: the server the
# variable `REBEL_REDIS_URL` names, every key of the store's prefix removed
# first, so each test starts from an empty store. Point it at a server of
# tests: it removes those keys.

use jobs/redis_store
use os
use redis

# A connection to the server `REBEL_REDIS_URL` names, the store's keys
# removed. Fails `not_found` where the variable is not set, and as
# `redis.parse_url`, `redis.connect` and the commands fail.
function connect() -> redis.Client?
    c @= connect_kept()?

    match redis.call(@c, ["EVAL", "for _, k in ipairs(redis.call('KEYS', ARGV[1] .. '*')) do redis.call('DEL', k) end return 0", "0", redis_store.PREFIX])
        .ok _ => return ok(c)
        .err e =>
            # A test that is told this skips, and a client left open would
            # end its run in a panic at the return of `main`.
            _ = redis.close(@c).is_err()
            return fail(code: e.code, msg: e.msg)

# A connection to the server `REBEL_REDIS_URL` names, the store's keys kept:
# for a second client of a test, and for the takers a test starts, which
# share the keys their test made. Fails `not_found` where the variable is
# not set, and as `redis.parse_url` and `redis.connect` fail.
function connect_kept() -> redis.Client?
    url = match os.env("REBEL_REDIS_URL")
        .ok u  => u
        .err _ => return fail(code: redis.NOT_FOUND, msg: "REBEL_REDIS_URL names no server")

    return redis.connect(redis.parse_url(url)?)
