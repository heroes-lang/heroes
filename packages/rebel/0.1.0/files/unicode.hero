test "the category constants: each is what category answers for the first character of it"
    assert category("A") == UPPERCASE_LETTER
    assert category("a") == LOWERCASE_LETTER
    assert category("ǅ") == TITLECASE_LETTER
    assert category("ʰ") == MODIFIER_LETTER
    assert category("ª") == OTHER_LETTER
    assert category(from_code_point(0x300).must()) == NONSPACING_MARK
    assert category(from_code_point(0x903).must()) == SPACING_MARK
    assert category(from_code_point(0x488).must()) == ENCLOSING_MARK
    assert category("0") == DECIMAL_NUMBER
    assert category("ᛮ") == LETTER_NUMBER
    assert category("²") == OTHER_NUMBER
    assert category("_") == CONNECTOR_PUNCTUATION
    assert category("-") == DASH_PUNCTUATION
    assert category("(") == OPEN_PUNCTUATION
    assert category(")") == CLOSE_PUNCTUATION
    assert category("«") == INITIAL_PUNCTUATION
    assert category("»") == FINAL_PUNCTUATION
    assert category("!") == OTHER_PUNCTUATION
    assert category("+") == MATH_SYMBOL
    assert category("$") == CURRENCY_SYMBOL
    assert category("^") == MODIFIER_SYMBOL
    assert category("¦") == OTHER_SYMBOL
    assert category(from_code_point(0x20).must()) == SPACE_SEPARATOR
    assert category(from_code_point(0x2028).must()) == LINE_SEPARATOR
    assert category(from_code_point(0x2029).must()) == PARAGRAPH_SEPARATOR
    assert category(from_code_point(0x0).must()) == CONTROL
    assert category(from_code_point(0xad).must()) == FORMAT
    assert category(from_code_point(0xe000).must()) == PRIVATE_USE
    assert category(from_code_point(0x378).must()) == UNASSIGNED

