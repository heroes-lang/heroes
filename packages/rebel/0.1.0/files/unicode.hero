test "simple_upper: letters of one, two and three cases, the edges, and numbers past the range"
    assert simple_upper(0xdf) == 0xdf
    assert simple_upper(0x1c4) == 0x1c4
    assert simple_upper(0x1c5) == 0x1c4
    assert simple_upper(0x1c6) == 0x1c4
    assert simple_upper(0x130) == 0x130
    assert simple_upper(0x3c2) == 0x3a3
    assert simple_upper(0x4b) == 0x4b
    assert simple_upper(0x6b) == 0x4b
    assert simple_upper(0x212a) == 0x212a
    assert simple_upper(0x10428) == 0x10400
    assert simple_upper(0x31) == 0x31
    assert simple_upper(0x0) == 0x0
    assert simple_upper(0x7f) == 0x7f
    assert simple_upper(0x80) == 0x80
    assert simple_upper(0xd7ff) == 0xd7ff
    assert simple_upper(0xe000) == 0xe000
    assert simple_upper(0x10ffff) == 0x10ffff
    assert simple_upper(-2) == -2
    assert simple_upper(0x110000) == 0x110000
    assert simple_upper(-9223372036854775808) == -9223372036854775808

