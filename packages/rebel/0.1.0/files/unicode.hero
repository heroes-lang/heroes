test "digit_value: digits of four scripts, and characters that are numbers but no decimal digit"
    assert digit_value("0").must() == 0
    assert digit_value("9").must() == 9
    assert digit_value("٣").must() == 3
    assert digit_value("𝟿").must() == 9
    assert digit_value("９").must() == 9
    assert digit_value("Ⅻ").is_err()
    assert digit_value("½").is_err()
    assert digit_value("a").is_err()
    assert digit_value(from_code_point(0x0).must()).is_err()
    assert digit_value(from_code_point(0x7f).must()).is_err()
    assert digit_value(from_code_point(0x80).must()).is_err()
    assert digit_value(from_code_point(0xd7ff).must()).is_err()
    assert digit_value(from_code_point(0xe000).must()).is_err()
    assert digit_value(from_code_point(0x10ffff).must()).is_err()

    match digit_value("x")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "U+0078 is no decimal digit: its category is Ll"

test "the limits: the tables' version is Python's, the largest code point, the replacement character"
    assert UNICODE_VERSION == "17.0.0"
    assert MAX_CODE_POINT == 0x10ffff
    assert code_point(REPLACEMENT_CHARACTER) == 0xfffd
    assert to_utf8(MAX_CODE_POINT).must().len() == MAX_UTF8_LEN

test "code_point: the six edges and a character of each width"
    assert code_point(from_code_point(0).must()) == 0
    assert code_point(from_code_point(0x7f).must()) == 0x7f
    assert code_point(from_code_point(0x80).must()) == 0x80
    assert code_point(from_code_point(0xd7ff).must()) == 0xd7ff
    assert code_point(from_code_point(0xe000).must()) == 0xe000
    assert code_point(from_code_point(0x10ffff).must()) == 0x10ffff
    assert code_point("a") == 97
    assert code_point("é") == 233
    assert code_point("€") == 0x20ac
    assert code_point("😀") == 0x1f600

test "from_code_point: each width, and what is no scalar value, refused with why"
    assert from_code_point(0x61).must() == "a"
    assert from_code_point(0xe9).must() == "é"
    assert from_code_point(0x20ac).must() == "€"
    assert from_code_point(0x1f600).must() == "😀"
    assert from_code_point(0x10ffff).must().len() == 4
    assert from_code_point(-1).is_err()
    assert from_code_point(0xdfff).is_err()
    assert from_code_point(-9223372036854775808).is_err()
    assert from_code_point(9223372036854775807).is_err()

    match from_code_point(0xd800)
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "U+D800 is a surrogate, which no character has as its code point"

    match from_code_point(0x110000)
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "U+110000 is no code point: they run from U+0000 to U+10FFFF"

test "code_points and from_code_points: nothing, characters of each width, a surrogate at an index"
    none: [i64] = []
    assert code_points("") == none
    assert code_points("aé€😀") == [0x61, 0xe9, 0x20ac, 0x1f600]
    assert from_code_points(none).must() == ""
    assert from_code_points([0x61, 0xe9, 0x20ac, 0x1f600]).must() == "aé€😀"

    match from_code_points([0x61, 0xd800])
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "U+D800 is a surrogate, which no character has as its code point, at index 1"

test "is_scalar_value: the edges of the range and of the surrogates, and the widest numbers"
    assert is_scalar_value(0)
    assert is_scalar_value(0xd7ff)
    assert !is_scalar_value(0xd800)
    assert !is_scalar_value(0xdfff)
    assert is_scalar_value(0xe000)
    assert is_scalar_value(0x10ffff)
    assert !is_scalar_value(0x110000)
    assert !is_scalar_value(-1)
    assert !is_scalar_value(-9223372036854775808)
    assert !is_scalar_value(9223372036854775807)

test "is_alphanumeric and is_number: a number that is no digit, and a vowel sign that is alphabetic"
    assert is_number("½") && !is_digit("½") && is_alphanumeric("½")
    assert is_alphabetic(from_code_point(0x903).must()) && !is_letter(from_code_point(0x903).must())

test "to_utf8: the last code point of each width and the first of the next, and what is refused"
    assert to_utf8(0).must() == [0]
    assert to_utf8(0x7f).must() == [0x7f]
    assert to_utf8(0x80).must() == [0xc2, 0x80]
    assert to_utf8(0x7ff).must() == [0xdf, 0xbf]
    assert to_utf8(0x800).must() == [0xe0, 0xa0, 0x80]
    assert to_utf8(0xffff).must() == [0xef, 0xbf, 0xbf]
    assert to_utf8(0x10000).must() == [0xf0, 0x90, 0x80, 0x80]
    assert to_utf8(0x10ffff).must() == [0xf4, 0x8f, 0xbf, 0xbf]
    assert to_utf8(0xd800).is_err()
    assert to_utf8(0x110000).is_err()
    assert to_utf8(-1).is_err()

test "utf8_len: as Go's RuneLen answers, and what it answers -1 for refused"
    assert utf8_len(0).must() == 1
    assert utf8_len(0x7f).must() == 1
    assert utf8_len(0x80).must() == 2
    assert utf8_len(0x7ff).must() == 2
    assert utf8_len(0x800).must() == 3
    assert utf8_len(0xffff).must() == 3
    assert utf8_len(0x10000).must() == 4
    assert utf8_len(0x10ffff).must() == 4
    assert utf8_len(0xd800).is_err()
    assert utf8_len(0x110000).is_err()
    assert utf8_len(-1).is_err()

test "utf8_width: a first byte of each width, a continuation, and the bytes UTF-8 never holds"
    assert utf8_width(0).must() == 1
    assert utf8_width(0x61).must() == 1
    assert utf8_width(0xc3).must() == 2
    assert utf8_width(0xe2).must() == 3
    assert utf8_width(0xf0).must() == 4
    assert utf8_width(0xc0).is_err()
    assert utf8_width(255).is_err()

    match utf8_width(0x80)
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the byte 0x80 continues a character and begins none"

test "from_utf8: nothing, characters of each width, and the first wrong byte named"
    none: [u8] = []
    nothing: [i64] = []
    assert from_utf8(none).must() == nothing
    assert from_utf8([0x61, 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80]).must() == [0x61, 0xe9, 0x20ac, 0x1f600]
    assert from_utf8([0xc0, 0x80]).is_err()
    assert from_utf8([0xed, 0xa0, 0x80]).is_err()
    assert from_utf8([0xf4, 0x90, 0x80, 0x80]).is_err()

    match from_utf8([0x61, 0xff])
        .ok _  => assert false
        .err e => assert e.code == NOT_TEXT && e.msg == "the byte 0xff is never in UTF-8, at index 1"

test "decode_at: as Go's DecodeRune answers, and where it answers RuneError"
    first = decode_at(bytes: [0x61, 0xc3, 0xa9], index: 0).must()
    assert first.code_point == 0x61 && first.width == 1
    second = decode_at(bytes: [0x61, 0xc3, 0xa9], index: 1).must()
    assert second.code_point == 0xe9 && second.width == 2
    euro = decode_at(bytes: [0xe2, 0x82, 0xac, 0x80], index: 0).must()
    assert euro.code_point == 0x20ac && euro.width == 3
    assert decode_at(bytes: [0xc0, 0x80], index: 0).is_err()
    assert decode_at(bytes: [0xed, 0xa0, 0x80], index: 0).is_err()
    assert decode_at(bytes: [0xf4, 0x90, 0x80, 0x80], index: 0).is_err()
    assert decode_at(bytes: [0xe2, 0x82], index: 0).is_err()

test "decode_before: as Go's DecodeLastRune answers, and where it answers RuneError"
    last = decode_before(bytes: [0x61, 0xc3, 0xa9], end: 3).must()
    assert last.code_point == 0xe9 && last.width == 2
    before = decode_before(bytes: [0x61, 0xc3, 0xa9], end: 1).must()
    assert before.code_point == 0x61 && before.width == 1
    assert decode_before(bytes: [0xe2, 0x82, 0xac, 0x80], end: 4).is_err()
    assert decode_before(bytes: [0xc0, 0x80], end: 2).is_err()
    assert decode_before(bytes: [0xed, 0xa0, 0x80], end: 3).is_err()
    assert decode_before(bytes: [0xe2, 0x82], end: 2).is_err()

test "is_utf8: as Go's Valid answers, nothing among them"
    none: [u8] = []
    assert is_utf8(none)
    assert is_utf8([0x61, 0xc3, 0xa9])
    assert !is_utf8([0xe2, 0x82, 0xac, 0x80])
    assert !is_utf8([0xc0, 0x80])
    assert !is_utf8([0xed, 0xa0, 0x80])
    assert !is_utf8([0xf4, 0x90, 0x80, 0x80])
    assert !is_utf8([0xe2, 0x82])

test "utf8_prefix_len and is_utf8_prefix: as Rust's valid_up_to and error_len answer"
    none: [u8] = []
    assert utf8_prefix_len(none) == 0
    assert utf8_prefix_len([0x61, 0xc3, 0xa9]) == 3
    assert utf8_prefix_len([0x61, 0xff]) == 1
    assert utf8_prefix_len([0x61, 0xe2, 0x82]) == 1
    assert is_utf8_prefix(none)
    assert is_utf8_prefix([0x61, 0xc3, 0xa9])
    assert is_utf8_prefix([0x61, 0xe2, 0x82])
    assert !is_utf8_prefix([0x61, 0xff])
    assert !is_utf8_prefix([0x61, 0xe2, 0x82, 0x61])
    assert !is_utf8_prefix([0xed, 0xa0])

test "is_continuation: as Go's RuneStart answers, the other way round"
    assert !is_continuation(0)
    assert !is_continuation(0x7f)
    assert is_continuation(0x80)
    assert is_continuation(0xbf)
    assert !is_continuation(0xc0)
    assert !is_continuation(255)

test "code_point_at and width_at: the first byte of a character of each width"
    s = "aé€😀"
    assert code_point_at(s: s, index: 0) == 0x61 && width_at(s: s, index: 0) == 1
    assert code_point_at(s: s, index: 1) == 0xe9 && width_at(s: s, index: 1) == 2
    assert code_point_at(s: s, index: 3) == 0x20ac && width_at(s: s, index: 3) == 3
    assert code_point_at(s: s, index: 6) == 0x1f600 && width_at(s: s, index: 6) == 4

test "char_count: nothing, one byte, and characters of each width, as Rust's chars().count() answers"
    assert char_count("") == 0
    assert char_count("a") == 1
    assert char_count("aé€😀") == 4
    assert char_count("😀😀") == 2

test "is_char_boundary: every index of a text, its end, and past it on either side, as Rust answers"
    s = "aé€😀"
    expected = [true, true, false, true, false, false, true, false, false, false, true, false, false]
    at: i64 @= 0

    while at < expected.len()
        assert [to_str(at), to_str(is_char_boundary(s: s, index: at))] == [to_str(at), to_str(expected[at])]
        at @ at + 1

    assert !is_char_boundary(s: s, index: -1)
    assert is_char_boundary(s: "", index: 0)

test "floor_char_boundary and ceil_char_boundary: every index of a text and past it, as Rust answers"
    s = "aé€😀"
    floors = [0, 1, 1, 3, 3, 3, 6, 6, 6, 6, 10, 10, 10]
    ceilings = [0, 1, 3, 3, 6, 6, 6, 10, 10, 10, 10, 10, 10]
    at: i64 @= 0

    while at < floors.len()
        assert [at, floor_char_boundary(s: s, index: at)] == [at, floors[at]]
        assert [at, ceil_char_boundary(s: s, index: at)] == [at, ceilings[at]]
        at @ at + 1

    assert floor_char_boundary(s: s, index: -5) == 0
    assert ceil_char_boundary(s: s, index: -5) == 0
    assert floor_char_boundary(s: "", index: 3) == 0
    assert ceil_char_boundary(s: "", index: 3) == 0

test "to_utf16: one unit, two, and what is refused"
    assert to_utf16(0).must() == [0]
    assert to_utf16(0xffff).must() == [0xffff]
    assert to_utf16(0x1f600).must() == [0xd83d, 0xde00]
    assert to_utf16(0x10ffff).must() == [0xdbff, 0xdfff]
    assert to_utf16(0xd800).is_err()
    assert to_utf16(0x110000).is_err()

test "from_utf16 and from_surrogates: a pair, a surrogate alone, a half out of place"
    assert from_utf16([0x61, 0xd83d, 0xde00]).must() == [0x61, 0x1f600]
    assert from_utf16([0xde00]).is_err()
    assert from_surrogates(high: 0xd83d, low: 0xde00).must() == 0x1f600
    assert from_surrogates(high: 0xde00, low: 0xd83d).is_err()

test "to_digit and from_digit: a digit of each run, either case, a digit of another script refused"
    assert to_digit(c: "7", base: 8).must() == 7
    assert to_digit(c: "8", base: 8).is_err()
    assert to_digit(c: "F", base: 16).must() == 15
    assert to_digit(c: "z", base: 36).must() == 35
    assert to_digit(c: "٣", base: 10).is_err()
    assert to_digit(c: "é", base: 36).is_err()
    assert from_digit(value: 10, base: 16).must() == "a"
    assert from_digit(value: 35, base: 36).must() == "z"
    assert from_digit(value: 36, base: 36).is_err()

## Examples

# The code points of a letter of ASCII and of an accented one.
test "code_point: a letter and an accented letter"
    assert code_point("A") == 65
    assert code_point("é") == 0xe9

# A character made from its code point, the smiling face U+263A.
test "from_code_point: a character from its number"
    assert from_code_point(0x263a).must() == "☺"

# A word taken apart into its code points.
test "code_points: the code points of a word"
    assert code_points("café") == [0x63, 0x61, 0x66, 0xe9]

# A word put back together from its code points.
test "from_code_points: a word from its code points"
    assert from_code_points([0x63, 0x61, 0x66, 0xe9]).must() == "café"

# A number checked before it is used as a code point: a surrogate is none.
test "is_scalar_value: a letter's number and a surrogate"
    assert is_scalar_value(0x41)
    assert !is_scalar_value(0xd800)

# Letters of two scripts, and a digit that is no letter.
test "is_letter: letters and a digit"
    assert is_letter("é") && is_letter("京")
    assert !is_letter("7")

# A Roman numeral is alphabetic though it is no letter.
test "is_alphabetic: a letter and a Roman numeral"
    assert is_alphabetic("a")
    assert is_alphabetic("Ⅻ") && !is_letter("Ⅻ")

# A decimal digit of ASCII and one of the Arabic script; a fraction is none.
test "is_digit: two scripts' digits and a fraction"
    assert is_digit("7") && is_digit("٣")
    assert !is_digit("½")

# A fraction is a number, though no digit.
test "is_number: a fraction and a letter"
    assert is_number("½")
    assert !is_number("x")

# Which characters of an identifier are letters or numbers.
test "is_alphanumeric: a letter, a digit and a hyphen"
    assert is_alphanumeric("x") && is_alphanumeric("9")
    assert !is_alphanumeric("-")

# White space of ASCII and the ideographic space; an underscore is none.
test "is_space: a space, a tab and the ideographic space"
    assert is_space(" ") && is_space("\t") && is_space(from_code_point(0x3000).must())
    assert !is_space("_")

# A capital letter and a capital Roman numeral are upper case.
test "is_upper: a capital and a small letter"
    assert is_upper("A") && is_upper("Ⅻ")
    assert !is_upper("a")

# A small letter, the German sharp s among them.
test "is_lower: two small letters and a capital"
    assert is_lower("a") && is_lower("ß")
    assert !is_lower("A")

# The one character that writes a capital D and a small z with a caron.
test "is_title: a title case letter and a plain capital"
    assert is_title("ǅ")
    assert !is_title("D")

# Letters of Latin have a case; an ideograph has none.
test "is_cased: a Latin letter and an ideograph"
    assert is_cased("a")
    assert !is_cased("京")

# An apostrophe and a full stop are passed over when a word's case is read.
test "is_case_ignorable: an apostrophe, a full stop and a letter"
    assert is_case_ignorable("'") && is_case_ignorable(".")
    assert !is_case_ignorable("a")

# An exclamation mark is punctuation; a plus sign is a symbol.
test "is_punctuation: punctuation and a symbol"
    assert is_punctuation("!") && is_punctuation("«")
    assert !is_punctuation("+")

# Signs of mathematics and of currencies are symbols.
test "is_symbol: a sign of mathematics and a currency"
    assert is_symbol("+") && is_symbol("€")
    assert !is_symbol("a")

# The combining acute accent is a mark; the letter it sits on is not.
test "is_mark: a combining accent and a letter"
    assert is_mark(from_code_point(0x301).must())
    assert !is_mark("e")

# A line feed is a control code; a space is not.
test "is_control: a line feed and a space"
    assert is_control("\n")
    assert !is_control(" ")

# A letter and a space are drawn or leave room; a line feed does neither.
test "is_graphic: a letter, a space and a line feed"
    assert is_graphic("a") && is_graphic(" ")
    assert !is_graphic("\n")

# The space prints as itself; the no-break space, U+00A0, does not.
test "is_printable: the space and the no-break space"
    assert is_printable(" ") && is_printable("é")
    assert !is_printable(from_code_point(0xa0).must())

# A letter of ASCII and one beyond it.
test "is_ascii: a plain letter and an accented one"
    assert is_ascii("z")
    assert !is_ascii("é")

# The categories of a small letter, a currency sign and a digit.
test "category: three characters, three categories"
    assert category("a") == LOWERCASE_LETTER
    assert category("€") == CURRENCY_SYMBOL
    assert category("7") == DECIMAL_NUMBER

# The value of a digit of the Arabic script.
test "digit_value: an Arabic-Indic three"
    assert digit_value("٣").must() == 3

# A digit of hexadecimal, read in either case.
test "to_digit: a digit of base sixteen"
    assert to_digit(c: "f", base: 16).must() == 15
    assert to_digit(c: "F", base: 16).must() == 15

# The digit eleven written in base sixteen.
test "from_digit: eleven in hexadecimal"
    assert from_digit(value: 11, base: 16).must() == "b"

# Upper case may write more than one character.
test "to_upper: an accented letter and the sharp s"
    assert to_upper("é") == "É"
    assert to_upper("ß") == "SS"

# The lower case of a Greek capital sigma.
test "to_lower: a Greek capital"
    assert to_lower("Σ") == "σ"

# The title case of a digraph is its capital followed by a small letter.
test "to_title: a digraph at the start of a word"
    assert to_title("ǆ") == "ǅ"
    assert to_upper("ǆ") == "Ǆ"

# Two letters compared ignoring case, the sharp s folding to two.
test "to_casefold: letters folded for comparing"
    assert to_casefold("K") == to_casefold("k")
    assert to_casefold("ß") == "ss"

# The letters `K`, `k` and the kelvin sign, walked round by folding.
test "simple_fold: the three forms of k"
    k = code_point("K")
    assert simple_fold(k) == code_point("k")
    assert simple_fold(code_point("k")) == 0x212a
    assert simple_fold(0x212a) == k

# A small letter's capital by the simple mapping; the sharp s has none.
test "simple_upper: one code point to one"
    assert simple_upper(code_point("a")) == code_point("A")
    assert simple_upper(code_point("ß")) == code_point("ß")

# A capital's small letter by the simple mapping.
test "simple_lower: one code point to one"
    assert simple_lower(code_point("A")) == code_point("a")

# A digraph's title case by the simple mapping.
test "simple_title: one code point to one"
    assert simple_title(code_point("ǆ")) == code_point("ǅ")

# The two bytes that write `é`.
test "to_utf8: an accented letter's bytes"
    assert to_utf8(0xe9).must() == [0xc3, 0xa9]

# How many bytes the euro sign takes.
test "utf8_len: the euro sign takes three bytes"
    assert utf8_len(0x20ac).must() == 3

# How long a character is, read from its first byte.
test "utf8_width: the first byte of the euro sign"
    assert utf8_width(0xe2).must() == 3

# Bytes read as code points.
test "from_utf8: the bytes of a word"
    assert from_utf8([0x63, 0x61, 0x66, 0xc3, 0xa9]).must() == [0x63, 0x61, 0x66, 0xe9]

# The second character of some bytes, and how far to step past it.
test "decode_at: an accented letter after a plain one"
    d = decode_at(bytes: [0x61, 0xc3, 0xa9], index: 1).must()
    assert d.code_point == 0xe9 && d.width == 2

# The last character of some bytes, read from the end.
test "decode_before: the last character of a word"
    d = decode_before(bytes: [0x61, 0xc3, 0xa9], end: 3).must()
    assert d.code_point == 0xe9 && d.width == 2

# Bytes checked before they are read as a text.
test "is_utf8: good bytes and a stray byte"
    assert is_utf8([0x61, 0xc3, 0xa9])
    assert !is_utf8([0x61, 0xff])

# How far some bytes hold good UTF-8.
test "utf8_prefix_len: the good part before a stray byte"
    assert utf8_prefix_len([0x61, 0x62, 0xff, 0x63]) == 2

# Bytes cut inside a character wait for more; a stray byte is wrong.
test "is_utf8_prefix: bytes cut short and bytes that are wrong"
    assert is_utf8_prefix([0x61, 0xe2, 0x82])
    assert !is_utf8_prefix([0x61, 0xff])

# The second byte of `é` continues it; the first begins it.
test "is_continuation: the two bytes of an accented letter"
    assert is_continuation(0xa9)
    assert !is_continuation(0xc3)

# The code point of a character found inside a text.
test "code_point_at: the euro sign in a price"
    assert code_point_at(s: "9€", index: 1) == 0x20ac

# Walking a text a character at a time.
test "width_at: from one character to the next"
    s = "a€b"
    assert width_at(s: s, index: 1) == 3
    assert code_point_at(s: s, index: 1 + width_at(s: s, index: 1)) == code_point("b")

# The characters of a word, against its bytes.
test "char_count: characters and bytes"
    assert char_count("café") == 4
    assert "café".len() == 5

# Where a slice of a text may cut.
test "is_char_boundary: inside and around an accented letter"
    assert is_char_boundary(s: "é", index: 0)
    assert !is_char_boundary(s: "é", index: 1)
    assert is_char_boundary(s: "é", index: 2)

# A text cut to at most eleven bytes without splitting a character.
test "floor_char_boundary: a cut that splits no character"
    s = "naïve café"
    assert s.slice(from: 0, to: floor_char_boundary(s: s, index: 11)) == "naïve caf"

# The first place at or after an index where a character begins.
test "ceil_char_boundary: past the middle of a character"
    assert ceil_char_boundary(s: "aé", index: 2) == 3

# A character above U+FFFF written as two surrogates.
test "to_utf16: the grinning face as a pair"
    assert to_utf16(0x1f600).must() == [0xd83d, 0xde00]

# Units of UTF-16 read back as code points.
test "from_utf16: a letter and a pair"
    assert from_utf16([0x61, 0xd83d, 0xde00]).must() == [0x61, 0x1f600]

# Two surrogates joined into one code point.
test "from_surrogates: the grinning face"
    assert from_surrogates(high: 0xd83d, low: 0xde00).must() == 0x1f600
