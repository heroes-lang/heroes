# What a character is: its code point, its classes, its case, and how UTF-8
# and UTF-16 write it. The tables hold Unicode 17.0.0, which `UNICODE_VERSION`
# says; a code point that version leaves unassigned is in no class and has no
# case.
#
# It reads one character at a time, and a text is read whole elsewhere: its
# case changed, a text compared ignoring case and searched, by `strings`; two
# texts that write one character in different code points made equal, and
# a text folded for comparing, by `unicode/normalize`; a text cut into what a
# reader sees as one character, into words and sentences, and measured in the
# columns a terminal draws, by `unicode/segment`; a character's name, its
# script and its block by `unicode/names`; and bytes in an encoding other than
# UTF-8 and UTF-16, Latin-1 and Shift_JIS among them, by `unicode/encodings`.
#
# A character is a `str` of exactly one character, which is what the built-in
# `chars()` yields; a code point is an `i64`. `code_point` and
# `from_code_point` go between the two. A function that takes a character
# aborts where it is handed the empty text or more than one character: cut a
# text with `chars()` first. Every index and every width is counted in bytes.

use unicode/internal/casing
use unicode/internal/classes
use unicode/internal/radix
use unicode/internal/utf16
use unicode/internal/utf8

## Codes

# The code of a failure on input that is not what the function reads: a number
# that is no code point of a character, a byte that begins no character.
constant INVALID: str
    "invalid"

# The code of a failure on bytes that are not UTF-8, the language's own.
constant NOT_TEXT: str
    "not_text"

## Limits

# The version of Unicode the tables hold.
constant UNICODE_VERSION: str
    "17.0.0"

# The largest code point, U+10FFFF.
constant MAX_CODE_POINT: i64
    0x10ffff

# The character U+FFFD, written where a character could not be read.
constant REPLACEMENT_CHARACTER: str
    "�"

# The most bytes one character takes in UTF-8.
constant MAX_UTF8_LEN: i64
    4

## The general categories

# What `category` answers for an upper case letter.
constant UPPERCASE_LETTER: str
    "Lu"

# What `category` answers for a lower case letter.
constant LOWERCASE_LETTER: str
    "Ll"

# What `category` answers for a title case letter, one character that writes
# an upper case letter and a lower case one.
constant TITLECASE_LETTER: str
    "Lt"

# What `category` answers for a modifier letter.
constant MODIFIER_LETTER: str
    "Lm"

# What `category` answers for a letter with no case, an ideograph among them.
constant OTHER_LETTER: str
    "Lo"

# What `category` answers for a mark that takes no room of its own.
constant NONSPACING_MARK: str
    "Mn"

# What `category` answers for a mark that takes room.
constant SPACING_MARK: str
    "Mc"

# What `category` answers for a mark that encloses the character before it.
constant ENCLOSING_MARK: str
    "Me"

# What `category` answers for a decimal digit.
constant DECIMAL_NUMBER: str
    "Nd"

# What `category` answers for a number written as a letter, a Roman numeral
# among them.
constant LETTER_NUMBER: str
    "Nl"

# What `category` answers for any other number, a fraction among them.
constant OTHER_NUMBER: str
    "No"

# What `category` answers for punctuation that joins two words, as `_` does.
constant CONNECTOR_PUNCTUATION: str
    "Pc"

# What `category` answers for a dash or a hyphen.
constant DASH_PUNCTUATION: str
    "Pd"

# What `category` answers for an opening bracket.
constant OPEN_PUNCTUATION: str
    "Ps"

# What `category` answers for a closing bracket.
constant CLOSE_PUNCTUATION: str
    "Pe"

# What `category` answers for an opening quotation mark.
constant INITIAL_PUNCTUATION: str
    "Pi"

# What `category` answers for a closing quotation mark.
constant FINAL_PUNCTUATION: str
    "Pf"

# What `category` answers for any other punctuation.
constant OTHER_PUNCTUATION: str
    "Po"

# What `category` answers for a symbol of mathematics.
constant MATH_SYMBOL: str
    "Sm"

# What `category` answers for a sign of a currency.
constant CURRENCY_SYMBOL: str
    "Sc"

# What `category` answers for a modifier symbol, as `^` is.
constant MODIFIER_SYMBOL: str
    "Sk"

# What `category` answers for any other symbol.
constant OTHER_SYMBOL: str
    "So"

# What `category` answers for a space.
constant SPACE_SEPARATOR: str
    "Zs"

# What `category` answers for U+2028, the line separator.
constant LINE_SEPARATOR: str
    "Zl"

# What `category` answers for U+2029, the paragraph separator.
constant PARAGRAPH_SEPARATOR: str
    "Zp"

# What `category` answers for a control code.
constant CONTROL: str
    "Cc"

# What `category` answers for a format character, drawn as nothing.
constant FORMAT: str
    "Cf"

# What `category` answers for a character kept for private use.
constant PRIVATE_USE: str
    "Co"

# What `category` answers for a code point this version of Unicode assigns
# nothing to.
constant UNASSIGNED: str
    "Cn"

## Characters and code points

# The code point of `c`, one character.
#
# - `c`: the character to read, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `from_code_point`,
# `code_points`.
function code_point(c: str) -> i64
    return utf8.one(c)

# The character whose code point is `n`.
#
# - `n`: the code point, 0 to `MAX_CODE_POINT`.
#
# Fails `invalid` where `n` is no scalar value: below 0, above
# `MAX_CODE_POINT`, or a surrogate, U+D800 to U+DFFF. See also `code_point`,
# `is_scalar_value`.
function from_code_point(n: i64) -> str?
    utf8.check_scalar_value(n)?
    return ok(utf8.text_of([n]))

# The code points of `s`, one for each character, in order.
#
# - `s`: the text to read; the empty text gives an empty list.
#
# See also `from_code_points`, `char_count`.
function code_points(s: str) -> [i64]
    points: [i64] @= []
    at: i64 @= 0

    while at < s.len()
        points @ points.push(utf8.code_point_at(s, at))
        at @ at + utf8.width_at(s, at)

    return points

# The text that `points` write, one character for each.
#
# - `points`: the code points, in order; an empty list gives the empty text.
#
# Fails `invalid` at the first number that is no scalar value, as
# `from_code_point` does, and the message says which and where.
function from_code_points(points: [i64]) -> str?
    at: i64 @= 0

    while at < points.len()
        match utf8.check_scalar_value(points[at])
            .ok _  => at @ at + 1
            .err e => return fail(code: INVALID, msg: f"{e.msg}, at index {at}")

    return ok(utf8.text_of(points))

# Whether `n` is a scalar value, a code point a character can have: 0 to
# `MAX_CODE_POINT`, the surrogates U+D800 to U+DFFF left out.
#
# - `n`: the number to ask about, any `i64`.
function is_scalar_value(n: i64) -> bool
    return utf8.is_scalar_value(n)

## Classes

# Whether `c` is a letter: its general category is one of the five that begin
# with `L`.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_alphabetic`.
function is_letter(c: str) -> bool
    return classes.is_letter(utf8.one(c))

# Whether `c` is alphabetic, Unicode's Alphabetic property: a letter, a number
# written as a letter, or a sign a script writes as part of a word, a vowel
# sign among them.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_letter`.
function is_alphabetic(c: str) -> bool
    return classes.is_alphabetic(utf8.one(c))

# Whether `c` is a decimal digit, general category `Nd`: one of the ten digits
# of some script.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# `digit_value` answers which digit it is. Aborts where `c` is not exactly one
# character. See also `is_number`.
function is_digit(c: str) -> bool
    return classes.is_digit(utf8.one(c))

# Whether `c` is a number of any kind, a general category that begins with
# `N`: a decimal digit, a Roman numeral, a fraction, a circled number.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_digit`.
function is_number(c: str) -> bool
    return classes.is_number(utf8.one(c))

# Whether `c` is alphabetic or a number: `is_alphabetic` or `is_number`.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_alphanumeric(c: str) -> bool
    return classes.is_alphanumeric(utf8.one(c))

# Whether `c` is white space, Unicode's White_Space property: space, tab, line
# feed, vertical tab, form feed, carriage return, U+0085, U+00A0, and the
# spaces and separators above them, 25 code points in all.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_space(c: str) -> bool
    return classes.is_space(utf8.one(c))

# Whether `c` is upper case, Unicode's Uppercase property: an upper case
# letter, or a sign that is one by its use, as a Roman numeral or a circled
# capital.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_cased`.
function is_upper(c: str) -> bool
    return classes.is_upper(utf8.one(c))

# Whether `c` is lower case, Unicode's Lowercase property: a lower case
# letter, or a sign that is one by its use, as the ordinal indicators.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_cased`.
function is_lower(c: str) -> bool
    return classes.is_lower(utf8.one(c))

# Whether `c` is a title case letter, general category `Lt`: one character
# that writes two letters, the first upper case.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `to_title`.
function is_title(c: str) -> bool
    return classes.is_title(utf8.one(c))

# Whether `c` has a case, Unicode's Cased property: `is_upper`, `is_lower` or
# `is_title`.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_cased(c: str) -> bool
    return classes.is_cased(utf8.one(c))

# Whether `c` is passed over when the letters around it are asked their case,
# Unicode's Case_Ignorable property: a mark, a modifier, an apostrophe, a full
# stop.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# A sigma that ends a word is told from one inside it by this class. Aborts
# where `c` is not exactly one character.
function is_case_ignorable(c: str) -> bool
    return classes.is_case_ignorable(utf8.one(c))

# Whether `c` is punctuation, a general category that begins with `P`.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# The signs of mathematics and of currencies are symbols, not punctuation:
# `+`, `$` and `^` answer false here and true to `is_symbol`. Aborts where `c`
# is not exactly one character.
function is_punctuation(c: str) -> bool
    return classes.is_punctuation(utf8.one(c))

# Whether `c` is a symbol, a general category that begins with `S`: a sign of
# mathematics, of a currency, a modifier such as `^`, or any other symbol.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_punctuation`.
function is_symbol(c: str) -> bool
    return classes.is_symbol(utf8.one(c))

# Whether `c` is a mark, a general category that begins with `M`: an accent or
# a sign that combines with the character before it.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_mark(c: str) -> bool
    return classes.is_mark(utf8.one(c))

# Whether `c` is a control code, general category `Cc`: U+0000 to U+001F and
# U+007F to U+009F.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_control(c: str) -> bool
    return classes.is_control(utf8.one(c))

# Whether `c` is drawn or leaves a space: a letter, a mark, a number,
# punctuation, a symbol, or a space of category `Zs`.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character. See also `is_printable`.
function is_graphic(c: str) -> bool
    return classes.is_graphic(utf8.one(c))

# Whether `c` may be printed as itself: `is_graphic`, with U+0020 the only
# space.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# A space other than U+0020, the no-break space among them, answers false.
# Aborts where `c` is not exactly one character.
function is_printable(c: str) -> bool
    return classes.is_printable(utf8.one(c))

# Whether `c` is ASCII, a code point below 128.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# Aborts where `c` is not exactly one character.
function is_ascii(c: str) -> bool
    return utf8.one(c) < 0x80

# The general category of `c`, Unicode's two letters for it: one of the
# constants `UPPERCASE_LETTER` to `UNASSIGNED` above.
#
# - `c`: the character to ask about, a text of exactly one character.
#
# The first letter is the major class, so a category that begins with `Z` is a
# separator; a code point this version leaves unassigned answers
# `UNASSIGNED`. Aborts where `c` is not exactly one character.
function category(c: str) -> str
    return classes.name_of(utf8.one(c))

## Numbers

# The value of `c`, a decimal digit of any script, 0 to 9.
#
# - `c`: the character to read, a text of exactly one character.
#
# Fails `invalid` where `c` is no decimal digit, which is where `is_digit`
# answers false. Aborts where `c` is not exactly one character. See also
# `to_digit`, which reads a digit of a base in ASCII.
function digit_value(c: str) -> i64?
    return classes.digit_value(utf8.one(c))

## Digits of a base

# The value of `c` as a digit of `base`, 0 to `base` less one: `0` to `9`,
# then the letters `a` to `z`, of either case, for ten to thirty-five.
#
# - `c`: the character to read, a text of exactly one character.
# - `base`: the base the digit is written in, 2 to 36.
#
# It reads ASCII alone, as a number is written in a base; `digit_value` reads
# the decimal digits of every script. Fails `invalid` where `c` is no digit of
# `base`. Aborts where `base` is not 2 to 36, or `c` is not exactly one
# character. See also `from_digit`.
function to_digit(c: str, base: i64) -> i64?
    return radix.digit_of(n: utf8.one(c), base: base)

# The character that writes `value` as a digit of `base`: `0` to `9`, then a
# letter in lower case.
#
# - `value`: the digit's value, 0 to `base` less one.
# - `base`: the base the digit is written in, 2 to 36.
#
# Fails `invalid` where `value` is not 0 to `base` less one. Aborts where
# `base` is not 2 to 36. See also `to_digit`.
function from_digit(value: i64, base: i64) -> str?
    return radix.digit_text(value: value, base: base)

## Case

# The upper case of `c`, one character, as a text of one to three characters:
# the upper case of `ß` is `SS`.
#
# - `c`: the character to change, a text of exactly one character.
#
# A character with no upper case is answered as it is. Aborts where `c` is not
# exactly one character. See also `simple_upper`, which answers one code
# point.
function to_upper(c: str) -> str
    n = utf8.one(c)
    return casing.mapped_text(c: c, n: n, packed: casing.full_upper(n))

# The lower case of `c`, one character, as a text of one or two characters.
#
# - `c`: the character to change, a text of exactly one character.
#
# A character with no lower case is answered as it is. It reads `c` alone: a
# sigma that ends a word is the caller's to tell. Aborts where `c` is not
# exactly one character. See also `simple_lower`.
function to_lower(c: str) -> str
    n = utf8.one(c)
    return casing.mapped_text(c: c, n: n, packed: casing.full_lower(n))

# The title case of `c`, one character, as a text of one to three characters:
# the form a word's first letter takes, where the title case of `ǆ` is `ǅ` and
# its upper case is `Ǆ`.
#
# - `c`: the character to change, a text of exactly one character.
#
# A character with no title case is answered as it is. Aborts where `c` is not
# exactly one character. See also `simple_title`.
function to_title(c: str) -> str
    n = utf8.one(c)
    return casing.mapped_text(c: c, n: n, packed: casing.full_title(n))

# The folded form of `c`, one character, as a text of one to three characters:
# two texts are the same ignoring case where their characters fold to the same
# texts.
#
# - `c`: the character to fold, a text of exactly one character.
#
# It is Unicode's full case folding, so `ß` folds to `ss`; a folded text is for
# comparing, never for showing. Aborts where `c` is not exactly one character.
# See also `simple_fold`.
function to_casefold(c: str) -> str
    n = utf8.one(c)
    return casing.mapped_text(c: c, n: n, packed: casing.full_fold(n))

# The next code point that is the same letter as `n` ignoring case, one to
# one: the smallest such above `n`, or the smallest of all where `n` is the
# largest.
#
# - `n`: the code point to start from, any `i64`.
#
# Asked again and again it walks the whole set and comes back: `K`, `k`,
# U+212A the kelvin sign, `K`. A number with no such other, a number that is
# no code point among them, is answered as it is. See also `to_casefold`.
function simple_fold(n: i64) -> i64
    return casing.next_in_fold(n)

# The upper case of the code point `n` where that is one code point, by
# Unicode's simple mapping, which leaves `ß` as it is.
#
# - `n`: the code point to change, any `i64`.
#
# A number with none, a number that is no code point among them, is answered
# as it is. See also `to_upper`.
function simple_upper(n: i64) -> i64
    return casing.simple_upper(n)

# The lower case of the code point `n` where that is one code point, by
# Unicode's simple mapping.
#
# - `n`: the code point to change, any `i64`.
#
# A number with none, a number that is no code point among them, is answered
# as it is. See also `to_lower`.
function simple_lower(n: i64) -> i64
    return casing.simple_lower(n)

# The title case of the code point `n` where that is one code point, by
# Unicode's simple mapping.
#
# - `n`: the code point to change, any `i64`.
#
# A number with none, a number that is no code point among them, is answered
# as it is. See also `to_title`.
function simple_title(n: i64) -> i64
    return casing.simple_title(n)

## UTF-8, on bytes

# What `decode_at` and `decode_before` answer: one character read from bytes.
record Decoded
    # The code point of the character.
    code_point: i64
    # How many bytes write it, 1 to 4.
    width: i64

# The bytes that write the code point `n` in UTF-8, one to four.
#
# - `n`: the code point to write.
#
# Fails `invalid` where `n` is no scalar value. See also `from_utf8`,
# `utf8_len`.
function to_utf8(n: i64) -> [u8]?
    utf8.check_scalar_value(n)?
    out: [u8] @= []
    utf8.add_encoded(@out, n)
    return ok(out)

# How many bytes write the code point `n` in UTF-8, 1 to 4.
#
# - `n`: the code point to measure.
#
# Fails `invalid` where `n` is no scalar value. See also `utf8_width`.
function utf8_len(n: i64) -> i64?
    utf8.check_scalar_value(n)?
    return ok(utf8.len_of(n))

# How many bytes the character takes whose first byte is `first`, 1 to 4.
#
# - `first`: the first byte of a character.
#
# Fails `invalid` where no character begins with `first`: a byte that
# continues one, 0x80 to 0xBF, and the bytes UTF-8 never holds, 0xC0, 0xC1 and
# 0xF5 to 0xFF. See also `utf8_len`.
function utf8_width(first: u8) -> i64?
    return utf8.width_of(first)

# The code points that `bytes` write in UTF-8, in order.
#
# - `bytes`: the bytes to read; none give an empty list.
#
# Fails `not_text` where the bytes are not UTF-8, and the message says the
# index of the first byte that is not. The built-in `validated_bytes` reads the
# same bytes as a text. See also `to_utf8`, `is_utf8`.
function from_utf8(bytes: [u8]) -> [i64]?
    points: [i64] @= []
    at: i64 @= 0

    while at < bytes.len()
        n = utf8.decode(bytes, at)?
        points @ points.push(n)
        at @ at + utf8.len_of(n)

    return ok(points)

# The character that begins at `index` of `bytes`.
#
# - `bytes`: the bytes to read from.
# - `index`: the byte index where the character begins.
#
# Fails `not_text` where the bytes from there begin no whole character of
# UTF-8: a wrong byte, a character the end cuts short, a surrogate, a form
# longer than the shortest. Aborts where `index` is not an index of `bytes`.
# See also `decode_before`.
function decode_at(bytes: [u8], index: i64) -> Decoded?
    n = utf8.decode(bytes, index)?
    return ok(Decoded(code_point: n, width: utf8.len_of(n)))

# The character that ends just before `end` in `bytes`: its last byte is
# `bytes[end - 1]`.
#
# - `bytes`: the bytes to read from.
# - `end`: the byte index just past the character, 1 to the length of `bytes`.
#
# Fails `not_text` where no whole character of UTF-8 ends there. Aborts where
# `end` is below 1 or above the length of `bytes`. See also `decode_at`.
function decode_before(bytes: [u8], end: i64) -> Decoded?
    n = utf8.decode_ending(bytes, end)?
    return ok(Decoded(code_point: n, width: utf8.len_of(n)))

# Whether `bytes` are UTF-8 from the first to the last.
#
# - `bytes`: the bytes to ask about; empty bytes answer true.
#
# See also `utf8_prefix_len`, `is_utf8_prefix`.
function is_utf8(bytes: [u8]) -> bool
    return utf8.valid_len(bytes) == bytes.len()

# How many bytes at the start of `bytes` are whole characters of UTF-8.
#
# - `bytes`: the bytes to read.
#
# The answer is the length of `bytes` where `is_utf8`, else the index of the
# first byte that is not.
function utf8_prefix_len(bytes: [u8]) -> i64
    return utf8.valid_len(bytes)

# Whether `bytes` are the beginning of UTF-8: they are UTF-8, or they stop
# inside a last character that more bytes could complete.
#
# - `bytes`: the bytes read so far; empty bytes answer true.
#
# A reader of a stream asks it to tell bytes cut short, which wait for more,
# from bytes that are wrong.
function is_utf8_prefix(bytes: [u8]) -> bool
    valid = utf8.valid_len(bytes)
    return valid == bytes.len() || utf8.is_cut_short(bytes, valid)

# Whether `byte` continues a character, 0x80 to 0xBF: in UTF-8 no such byte
# begins one, and every byte of a character after its first is one.
#
# - `byte`: the byte to ask about.
function is_continuation(byte: u8) -> bool
    return utf8.is_continuation(byte)

## UTF-8, on a text

# The code point of the character that begins at `index` of `s`.
#
# - `s`: the text to read from.
# - `index`: the byte index where the character begins.
#
# It cuts no slice. Aborts where `index` is not the first byte of a character
# of `s`. See also `width_at`.
function code_point_at(s: str, index: i64) -> i64
    return utf8.code_point_at(s, index)

# How many bytes the character takes that begins at `index` of `s`, 1 to 4, so
# the next begins at `index` plus it.
#
# - `s`: the text to read from.
# - `index`: the byte index where the character begins.
#
# Aborts where `index` is not the first byte of a character of `s`. See also
# `code_point_at`.
function width_at(s: str, index: i64) -> i64
    return utf8.width_at(s, index)

# How many characters `s` holds, where `s.len()` counts its bytes.
#
# - `s`: the text to count; the empty text holds none.
#
# It reads every byte once and builds nothing.
function char_count(s: str) -> i64
    count: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if !utf8.is_continuation(s[at])
            count @ count + 1
        at @ at + 1

    return count

# Whether `index` is where a character of `s` begins, or the end of `s`: where
# a slice may cut.
#
# - `s`: the text to ask about.
# - `index`: the byte index to ask about; one outside `s` answers false.
#
# See also `floor_char_boundary`, `ceil_char_boundary`.
function is_char_boundary(s: str, index: i64) -> bool
    if index == s.len()
        return true
    return index >= 0 && index < s.len() && !utf8.is_continuation(s[index])

# The nearest index at or before `index` where a character of `s` begins, or
# the end of `s`: the largest that `is_char_boundary` accepts and is not above
# `index`.
#
# - `s`: the text to cut.
# - `index`: the byte index to start from; below 0 answers 0, and above the
#   length answers the length.
function floor_char_boundary(s: str, index: i64) -> i64
    if index >= s.len()
        return s.len()

    if index <= 0
        return 0
    at: i64 @= index

    while at > 0 && utf8.is_continuation(s[at])
        at @ at - 1

    return at

# The nearest index at or after `index` where a character of `s` begins, or
# the end of `s`: the smallest that `is_char_boundary` accepts and is not
# below `index`.
#
# - `s`: the text to cut.
# - `index`: the byte index to start from; below 0 answers 0, and above the
#   length answers the length.
function ceil_char_boundary(s: str, index: i64) -> i64
    if index <= 0
        return 0

    if index >= s.len()
        return s.len()
    at: i64 @= index

    while at < s.len() && utf8.is_continuation(s[at])
        at @ at + 1

    return at

## UTF-16

# The units that write the code point `n` in UTF-16: one, or the two
# surrogates of a code point above U+FFFF, the high one first.
#
# - `n`: the code point to write.
#
# Fails `invalid` where `n` is no scalar value. See also `from_utf16`.
function to_utf16(n: i64) -> [u16]?
    utf8.check_scalar_value(n)?
    return ok(utf16.units_of(n))

# The code points that `units` write in UTF-16, in order.
#
# - `units`: the units to read; none give an empty list.
#
# Fails `invalid` at a surrogate with no partner, and the message says its
# index. See also `to_utf16`, `from_surrogates`.
function from_utf16(units: [u16]) -> [i64]?
    return utf16.decoded(units)

# The code point that the surrogates `high` and `low` write together, U+10000
# or above.
#
# - `high`: the first unit of the pair, U+D800 to U+DBFF.
# - `low`: the second unit of the pair, U+DC00 to U+DFFF.
#
# Fails `invalid` where `high` or `low` is outside its range.
function from_surrogates(high: i64, low: i64) -> i64?
    return utf16.joined(high: high, low: low)

## Tests

# Every expected answer below is what Python 3.15.2 (`unicodedata`, `str`),
# Go 1.27.3 (`unicode`, `unicode/utf8`) or Rust 1.100 (`str`, `char`)
# answered for the same input, observed 2026-11-15. The classes and the case
# of every code point are held to the reference libraries in the tests of
# `unicode/internal/classes` and `unicode/internal/casing`; these hold the
# face to them, a character at a time.

test "is_letter to is_ascii: 36 characters, the six edges among them, each answer a bit"
    samples = [
        from_code_point(0x0).must()
        from_code_point(0x7f).must()
        from_code_point(0x80).must()
        from_code_point(0xd7ff).must()
        from_code_point(0xe000).must()
        from_code_point(0x10ffff).must()
        from_code_point(0x9).must()
        from_code_point(0x20).must()
        "a"
        "A"
        "5"
        "_"
        "+"
        "$"
        from_code_point(0xa0).must()
        "ª"
        "½"
        "ß"
        "é"
        "ǅ"
        "ʰ"
        from_code_point(0x300).must()
        from_code_point(0x345).must()
        "Σ"
        "٣"
        from_code_point(0x903).must()
        from_code_point(0x200b).must()
        "’"
        "€"
        "Ⅻ"
        "Ⓐ"
        from_code_point(0x3000).must()
        "京"
        "Ａ"
        "𝐀"
        "😀"
    ]
    questions: [(function(str) -> bool)] = [
        is_letter
        is_alphabetic
        is_digit
        is_number
        is_alphanumeric
        is_space
        is_upper
        is_lower
        is_title
        is_cased
        is_case_ignorable
        is_punctuation
        is_symbol
        is_mark
        is_control
        is_graphic
        is_printable
        is_ascii
    ]
    expected: [i64] = [
        147456
        147456
        16384
        0
        0
        0
        147488
        229408
        230035
        229971
        229404
        231424
        233472
        233472
        32800
        98963
        98328
        98963
        98963
        99091
        99987
        107520
        108178
        98899
        98332
        106514
        1024
        101376
        102400
        98906
        102994
        32800
        98323
        98899
        98899
        102400
    ]
    at: i64 @= 0

    while at < samples.len()
        mask: i64 @= 0
        k: i64 @= 0

        while k < questions.len()
            if questions[k](samples[at])
                mask @ mask | 1 << k
            k @ k + 1

        assert [code_point(samples[at]), mask] == [code_point(samples[at]), expected[at]]
        at @ at + 1

