# The classes of bytes the standard's tokenizer, tree construction and
# selectors ask about: ASCII letters, digits and white space, compared by the
# byte, since every one of them is a single byte in UTF-8 and no byte of a
# longer character is ever one of them.

# Whether `b` is an ASCII letter, `A` to `Z` or `a` to `z`.
function is_alpha(b: u8) -> bool
    return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z'

# Whether `b` is an ASCII upper-case letter.
function is_upper(b: u8) -> bool
    return b >= 'A' && b <= 'Z'

# Whether `b` is an ASCII digit.
function is_digit(b: u8) -> bool
    return b >= '0' && b <= '9'

# Whether `b` is an ASCII letter or digit.
function is_alnum(b: u8) -> bool
    return is_alpha(b) || is_digit(b)

# Whether `b` is an ASCII hexadecimal digit, in either case.
function is_hex(b: u8) -> bool
    return is_digit(b) || b >= 'a' && b <= 'f' || b >= 'A' && b <= 'F'

# Whether `b` is ASCII white space as the standard counts it: tab, line feed,
# form feed, carriage return and space.
function is_white(b: u8) -> bool
    return b == ' ' || b == '\t' || b == '\n' || b == 12 || b == '\r'

# Whether `s` holds nothing but ASCII white space; true for the empty text.
function is_all_white(s: str) -> bool
    for i in range(from: 0, to: s.len())
        if !is_white(s[i])
            return false

    return true

# The byte index of the first byte of `s` at or after `from` that is not ASCII
# white space; `s.len()` where there is none.
function skip_white(s: str, from: i64) -> i64
    at: i64 @= from

    while at < s.len() && is_white(s[at])
        at @ at + 1

    return at

# `s` with its ASCII white space taken off both ends.
function trim_white(s: str) -> str
    first = skip_white(s, 0)
    last: i64 @= s.len()

    while last > first && is_white(s[last - 1])
        last @ last - 1

    return s.slice(from: first, to: last)

# The parts of `s` between runs of ASCII white space, in order, none empty.
function split_white(s: str) -> [str]
    parts: [str] @= []
    at: i64 @= skip_white(s, 0)

    while at < s.len()
        end: i64 @= at

        while end < s.len() && !is_white(s[end])
            end @ end + 1

        parts @ parts.push(s.slice(from: at, to: end))
        at @ skip_white(s, end)

    return parts

# `s` with its ASCII upper-case letters in lower case; `s` itself, copied
# nowhere, where it holds none.
function to_lower(s: str) -> str
    found: bool @= false

    for i in range(from: 0, to: s.len())
        if is_upper(s[i])
            found @ true
            break

    if !found
        return s
    pieces: [str] @= []
    run: i64 @= 0

    for i in range(from: 0, to: s.len())
        if is_upper(s[i])
            pieces @ pieces.push(s.slice(from: run, to: i))
            pieces @ pieces.push(LOWER[to_i64(s[i] - 'A').must()])
            run @ i + 1

    pieces @ pieces.push(s.slice(from: run, to: s.len()))
    return pieces.join("")

# Whether `a` and `b` are the same text but for the case of ASCII letters.
function equals_ignoring_case(a: str, b: str) -> bool
    if a.len() != b.len()
        return false

    for i in range(from: 0, to: a.len())
        x = a[i]
        y = b[i]

        if x != y
            lx = if is_upper(x)
                x + 32
            else
                x

            ly = if is_upper(y)
                y + 32
            else
                y

            if lx != ly
                return false

    return true

# Whether the bytes of `s` from `at` are `word` but for the case of ASCII
# letters; false where `s` ends first.
function has_word_at(s: str, at: i64, word: str) -> bool
    if at + word.len() > s.len()
        return false

    for i in range(from: 0, to: word.len())
        x = s[at + i]
        y = word[i]

        lx = if is_upper(x)
            x + 32
        else
            x

        ly = if is_upper(y)
            y + 32
        else
            y

        if lx != ly
            return false

    return true

# The lower-case letters, `a` to `z`, each as a text.
constant LOWER: [str]
    [
        "a"
        "b"
        "c"
        "d"
        "e"
        "f"
        "g"
        "h"
        "i"
        "j"
        "k"
        "l"
        "m"
        "n"
        "o"
        "p"
        "q"
        "r"
        "s"
        "t"
        "u"
        "v"
        "w"
        "x"
        "y"
        "z"
    ]

## Tests

test "is_alpha, is_upper, is_digit, is_alnum and is_hex: the edges of each range"
    assert is_alpha('a') && is_alpha('Z') && !is_alpha('@') && !is_alpha('[') && !is_alpha('`') && !is_alpha('{')
    assert is_upper('A') && !is_upper('a') && is_digit('0') && is_digit('9') && !is_digit('/') && !is_digit(':')
    assert is_alnum('q') && !is_alnum('-') && is_hex('F') && is_hex('a') && !is_hex('g') && !is_hex('G')
    assert !is_alpha(195) && !is_digit(169)

test "is_white, is_all_white, skip_white, trim_white and split_white: the five spaces, and a vertical tab kept"
    assert is_white('\t') && is_white('\n') && is_white(12) && is_white('\r') && is_white(' ') && !is_white(11)
    assert is_all_white("") && is_all_white(" \t\n") && !is_all_white(" x ")
    assert skip_white("  a", 0) == 2 && skip_white("  ", 0) == 2 && skip_white("a", 0) == 0
    assert trim_white("\t a b \n") == "a b" && trim_white("") == "" && trim_white("   ") == "" && trim_white("\u{b}x ") == "\u{b}x"
    assert split_white(" a  b\tc ") == ["a", "b", "c"] && split_white("") == [] && split_white(" ") == []

test "to_lower: ASCII letters alone, and text of more than one byte kept"
    assert to_lower("DiV") == "div" && to_lower("") == "" && to_lower("ÉA") == "Éa" && to_lower("abc") == "abc"

test "equals_ignoring_case and has_word_at: ASCII case only, a shorter text, and past the end"
    assert equals_ignoring_case(a: "DocType", b: "doctype") && !equals_ignoring_case(a: "a", b: "ab") && !equals_ignoring_case(a: "É", b: "é")
    assert has_word_at(s: "<!DOCTYPE", at: 2, word: "doctype") && !has_word_at(s: "<!DOC", at: 2, word: "doctype") && has_word_at(s: "x", at: 1, word: "")
