# Elements taken out of a list by what they are: those a test accepts, the
# first or every one equal to a value, the repeats in each run of equal
# neighbours, and a list's own beginning or end.

use lists/internal/codes
use lists/internal/samples
use lists/internal/searching

# `xs` without the elements `accepts` accepts.
function remove_where<T>(xs: [T], accepts: (function(T) -> bool)) -> [T]
    out: [T] @= []

    for x in xs
        if !accepts(x)
            out @ out.push(x)

    return out

# `xs` without its first element that `same` says is `value`, failing
# `not_found` where there is none.
function remove<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> [T]?
    at = searching.first_same(xs, value, same)

    if at == xs.len()
        return fail(code: codes.NOT_FOUND, msg: codes.none_is(count: xs.len(), what: "the value to remove"))
    out: [T] @= xs.slice(from: 0, to: at)
    rest: i64 @= at + 1

    while rest < xs.len()
        out @ out.push(xs[rest])
        rest @ rest + 1

    return ok(out)

# `xs` without every element that `same` says is `value`.
function remove_all<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> [T]
    out: [T] @= []

    for x in xs
        if !same(left: x, right: value)
            out @ out.push(x)

    return out

# `xs` with each run of neighbours `same` says are the same reduced to its
# first element: an element is left out where `same` accepts it as `right`
# beside the element before it as `left`, which is Go's rule and not Rust's,
# so `compact` keeps the first element of each run `runs_by` answers.
function compact<T>(xs: [T], same: (function(left: T, right: T) -> bool)) -> [T]
    out: [T] @= []
    at: i64 @= 0

    while at < xs.len()
        if at == 0 || !same(left: xs[at - 1], right: xs[at])
            out @ out.push(xs[at])
        at @ at + 1

    return out

# `xs` without `prefix` at its start, where it begins with it.
function trim_prefix<T>(xs: [T], prefix: [T], same: (function(left: T, right: T) -> bool)) -> [T]
    if !searching.has_prefix(xs: xs, prefix: prefix, same: same)
        return xs
    return xs.slice(from: prefix.len(), to: xs.len())

# `xs` without `suffix` at its end, where it ends with it.
function trim_suffix<T>(xs: [T], suffix: [T], same: (function(left: T, right: T) -> bool)) -> [T]
    if !searching.has_suffix(xs: xs, suffix: suffix, same: same)
        return xs
    return xs.slice(from: 0, to: xs.len() - suffix.len())

## Tests

test "remove_where: some, none, all, and an empty list"
    nothing: [i64] = []
    assert remove_where([0, 1, 2, 3, 4, 5], samples.is_even) == [1, 3, 5]
    assert remove_where([1, 3], samples.is_even) == [1, 3]
    assert remove_where([2, 4], samples.is_even) == nothing
    assert remove_where(nothing, samples.is_even) == nothing

test "remove: the first of two, the only one, absent, and an empty list"
    nothing: [i64] = []
    assert remove([1, 2, 3, 2], 2, samples.same_number).must() == [1, 3, 2]
    assert remove([2], 2, samples.same_number).must() == nothing
    assert remove(["é", "a"], "é", samples.same_text).must() == ["a"]

    match remove([1, 2], 9, samples.same_number)
        .ok _  => assert false
        .err e => assert e.code == "not_found" && e.msg == "none of the 2 elements of the list is the value to remove"

    assert remove(nothing, 9, samples.same_number).is_err()

test "remove_all: several, none, all, and an empty list"
    nothing: [i64] = []
    assert remove_all([2, 1, 2, 3, 2], 2, samples.same_number) == [1, 3]
    assert remove_all([1, 3], 2, samples.same_number) == [1, 3]
    assert remove_all([2, 2], 2, samples.same_number) == nothing
    assert remove_all(nothing, 2, samples.same_number) == nothing

test "compact: runs at either end and inside, no runs, one element, an empty list, and neighbours compared"
    nothing: [i64] = []
    assert compact([1, 1, 2, 2, 2, 1, 3, 3], samples.same_number) == [1, 2, 1, 3]
    assert compact([1, 2, 3], samples.same_number) == [1, 2, 3]
    assert compact([4], samples.same_number) == [4]
    assert compact(nothing, samples.same_number) == nothing
    assert compact([1, 2, 3, 4, 10], samples.near) == [1, 10]

test "trim_prefix: present, absent, empty, the whole list, and longer than the list"
    nothing: [i64] = []
    assert trim_prefix(xs: [1, 2, 3], prefix: [1, 2], same: samples.same_number) == [3]
    assert trim_prefix(xs: [1, 2, 3], prefix: [2], same: samples.same_number) == [1, 2, 3]
    assert trim_prefix(xs: [1, 2], prefix: nothing, same: samples.same_number) == [1, 2]
    assert trim_prefix(xs: [1, 2], prefix: [1, 2], same: samples.same_number) == nothing
    assert trim_prefix(xs: [1], prefix: [1, 2], same: samples.same_number) == [1]

test "trim_suffix: present, absent, empty, the whole list, and longer than the list"
    nothing: [i64] = []
    assert trim_suffix(xs: [1, 2, 3], suffix: [2, 3], same: samples.same_number) == [1]
    assert trim_suffix(xs: [1, 2, 3], suffix: [2], same: samples.same_number) == [1, 2, 3]
    assert trim_suffix(xs: [1, 2], suffix: nothing, same: samples.same_number) == [1, 2]
    assert trim_suffix(xs: [1, 2], suffix: [1, 2], same: samples.same_number) == nothing
    assert trim_suffix(xs: [2], suffix: [1, 2], same: samples.same_number) == [2]
