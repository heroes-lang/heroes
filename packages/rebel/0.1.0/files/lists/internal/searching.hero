# A value or an accepted element looked for in a list, from either end;
# how many there are; whether a list begins or ends with another, or holds
# the same elements as another. The equality is the caller's, since a type
# parameter has none: `same(left:, right:)`, the list's element as `left`.

use lists/internal/codes
use lists/internal/samples

# The index of the first element of `xs` `accepts` accepts, from `from` on,
# or the length where there is none.
function first_accepted<T>(xs: [T], accepts: (function(T) -> bool), from: i64) -> i64
    at: i64 @= from

    while at < xs.len() && !accepts(xs[at])
        at @ at + 1

    return at

# The index of the first element of `xs` that `same` says is `value`, or the
# length where there is none.
function first_same<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> i64
    at: i64 @= 0

    while at < xs.len() && !same(left: xs[at], right: value)
        at @ at + 1

    return at

# Whether `xs` holds an element that `same` says is `value`.
function contains<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> bool
    return first_same(xs, value, same) < xs.len()

# The index of the first element of `xs` that `same` says is `value`, failing
# `not_found` where there is none.
function index_of<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> i64?
    at = first_same(xs, value, same)

    if at == xs.len()
        return fail(code: codes.NOT_FOUND, msg: codes.none_is(count: xs.len(), what: "the value sought"))
    return ok(at)

# The index of the last element of `xs` that `same` says is `value`, failing
# `not_found` where there is none.
function index_of_last<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> i64?
    at: i64 @= xs.len()

    while at > 0
        at @ at - 1

        if same(left: xs[at], right: value)
            return ok(at)

    return fail(code: codes.NOT_FOUND, msg: codes.none_is(count: xs.len(), what: "the value sought"))

# The index of the first element of `xs` `accepts` accepts, failing
# `not_found` where there is none.
function index_where<T>(xs: [T], accepts: (function(T) -> bool)) -> i64?
    at = first_accepted(xs, accepts, 0)

    if at == xs.len()
        return fail(code: codes.NOT_FOUND, msg: codes.none_is(count: xs.len(), what: "accepted"))
    return ok(at)

# The index of the last element of `xs` `accepts` accepts, failing
# `not_found` where there is none.
function index_where_last<T>(xs: [T], accepts: (function(T) -> bool)) -> i64?
    at: i64 @= xs.len()

    while at > 0
        at @ at - 1

        if accepts(xs[at])
            return ok(at)

    return fail(code: codes.NOT_FOUND, msg: codes.none_is(count: xs.len(), what: "accepted"))

# How many elements of `xs` `same` says are `value`.
function count_of<T>(xs: [T], value: T, same: (function(left: T, right: T) -> bool)) -> i64
    count: i64 @= 0

    for x in xs
        if same(left: x, right: value)
            count @ count + 1

    return count

# Whether the `part.len()` elements of `xs` from `from` on are those of
# `part`, each the same by `same`; `from` and the part's length are inside
# `xs`.
function holds_at<T>(xs: [T], part: [T], from: i64, same: (function(left: T, right: T) -> bool)) -> bool
    at: i64 @= 0

    while at < part.len()
        if !same(left: xs[from + at], right: part[at])
            return false
        at @ at + 1

    return true

# Whether `xs` begins with the elements of `prefix`.
function has_prefix<T>(xs: [T], prefix: [T], same: (function(left: T, right: T) -> bool)) -> bool
    if prefix.len() > xs.len()
        return false
    return holds_at(xs: xs, part: prefix, from: 0, same: same)

# Whether `xs` ends with the elements of `suffix`.
function has_suffix<T>(xs: [T], suffix: [T], same: (function(left: T, right: T) -> bool)) -> bool
    if suffix.len() > xs.len()
        return false
    return holds_at(xs: xs, part: suffix, from: xs.len() - suffix.len(), same: same)

# Whether `left` and `right` hold as many elements, each pair the same by
# `same`.
function equal_by<T>(left: [T], right: [T], same: (function(left: T, right: T) -> bool)) -> bool
    if left.len() != right.len()
        return false
    return holds_at(xs: left, part: right, from: 0, same: same)

## Tests

test "contains: present, absent, an empty list, and texts of more than one byte"
    nothing: [i64] = []
    assert contains([1, 2, 3], 2, samples.same_number)
    assert !contains([1, 2, 3], 9, samples.same_number)
    assert !contains(nothing, 0, samples.same_number)
    assert contains(["a", "é"], "é", samples.same_text)
    assert !contains(["a", "é"], "e", samples.same_text)

test "index_of: the first of two, at either end, absent, and an empty list"
    nothing: [i64] = []
    assert index_of([1, 2, 3, 2], 2, samples.same_number).must() == 1
    assert index_of([1, 2], 1, samples.same_number).must() == 0
    assert index_of([1, 2], 2, samples.same_number).must() == 1

    match index_of([1, 2], 9, samples.same_number)
        .ok _  => assert false
        .err e => assert e.code == "not_found" && e.msg == "none of the 2 elements of the list is the value sought"

    match index_of(nothing, 9, samples.same_number)
        .ok _  => assert false
        .err e => assert e.msg == "an empty list holds no element that is the value sought"

test "index_of_last: the last of two, at either end, absent, and an empty list"
    nothing: [i64] = []
    assert index_of_last([1, 2, 3, 2], 2, samples.same_number).must() == 3
    assert index_of_last([1, 2], 1, samples.same_number).must() == 0
    assert index_of_last([5], 5, samples.same_number).must() == 0
    assert index_of_last([1, 2], 9, samples.same_number).is_err()
    assert index_of_last(nothing, 9, samples.same_number).is_err()

test "index_where: the first accepted, none, all, and an empty list"
    nothing: [i64] = []
    assert index_where([1, 3, 4, 6], samples.is_even).must() == 2
    assert index_where([2], samples.is_even).must() == 0

    match index_where([1, 3], samples.is_even)
        .ok _  => assert false
        .err e => assert e.code == "not_found" && e.msg == "none of the 2 elements of the list is accepted"

    assert index_where(nothing, samples.is_even).is_err()

test "index_where_last: the last accepted, none, one, and an empty list"
    nothing: [i64] = []
    assert index_where_last([1, 4, 6, 7], samples.is_even).must() == 2
    assert index_where_last([2], samples.is_even).must() == 0

    match index_where_last([1], samples.is_even)
        .ok _  => assert false
        .err e => assert e.code == "not_found" && e.msg == "the one element of the list is not accepted"

    assert index_where_last(nothing, samples.is_even).is_err()

test "count_of: several, one, none, and an empty list"
    nothing: [i64] = []
    assert count_of([1, 2, 3, 2], 2, samples.same_number) == 2
    assert count_of([1, 2], 1, samples.same_number) == 1
    assert count_of([1, 2], 9, samples.same_number) == 0
    assert count_of(nothing, 9, samples.same_number) == 0

test "has_prefix: empty, equal, shorter, longer, and a mismatch"
    nothing: [i64] = []
    assert has_prefix(xs: [1], prefix: nothing, same: samples.same_number)
    assert has_prefix(xs: nothing, prefix: nothing, same: samples.same_number)
    assert has_prefix(xs: [1, 2, 3], prefix: [1, 2], same: samples.same_number)
    assert has_prefix(xs: [1, 2], prefix: [1, 2], same: samples.same_number)
    assert !has_prefix(xs: [1], prefix: [1, 2], same: samples.same_number)
    assert !has_prefix(xs: [1, 2, 3], prefix: [2], same: samples.same_number)

test "has_suffix: empty, equal, shorter, longer, and a mismatch"
    nothing: [str] = []
    assert has_suffix(xs: ["a"], suffix: nothing, same: samples.same_text)
    assert has_suffix(xs: ["a", "b", "é"], suffix: ["b", "é"], same: samples.same_text)
    assert !has_suffix(xs: ["é"], suffix: ["a", "é"], same: samples.same_text)
    assert !has_suffix(xs: ["a", "b"], suffix: ["a"], same: samples.same_text)

test "equal_by: equal, of other lengths, one difference, both empty, and an equality that is not structural"
    nothing: [i64] = []
    assert equal_by(left: [1, 2], right: [1, 2], same: samples.same_number)
    assert !equal_by(left: [1, 2], right: [1, 2, 3], same: samples.same_number)
    assert !equal_by(left: [1, 2], right: [1, 3], same: samples.same_number)
    assert equal_by(left: nothing, right: nothing, same: samples.same_number)
    assert equal_by(left: [1, 5], right: [2, 4], same: samples.near)
