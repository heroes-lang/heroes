# The SSH protocol's data types (RFC 4251 § 5) read from bytes and written
# to them: `byte`, `boolean`, `uint32`, `uint64`, `string`, `mpint` and
# `name-list`. Every reader checks a length against the bytes left before it
# cuts, so bytes from the peer fail `invalid` and never index past their end.

use bytes

## Codes

# Bytes that are not the type asked for: too few, a length past the end, an
# mpint not in its shortest form, a name-list holding an empty name.
constant INVALID: str
    "invalid"

## Reading

# A place in bytes being read, from `at` to the end of `data`.
record Reader
    # The bytes read.
    data: [u8]
    # The index of the next byte to read, from 0 to `data`'s length.
    at: i64

# A reader at the first byte of `data`.
function reader(data: [u8]) -> Reader
    return Reader(data: data, at: 0)

# How many bytes `r` has not read.
function left(r: Reader lent) -> i64
    return r.data.len() - r.at

# The next `n` bytes of `r`, which moves past them; `what` names them in a
# failure.
function take(@r: Reader, n: i64, what: str) -> [u8]?
    if n < 0 || n > left(r)
        return fail(
            code: INVALID,
            msg: f"{what}: {n} bytes asked where {left(r)} are left"
        )
    part = r.data.slice(from: r.at, to: r.at + n)
    r.at @ r.at + n
    return ok(part)

# The next byte of `r`.
function read_byte(@r: Reader, what: str) -> u8?
    if left(r) < 1
        return fail(code: INVALID, msg: f"{what}: no byte is left")
    b = r.data[r.at]
    r.at @ r.at + 1
    return ok(b)

# The next `boolean` of `r`: any byte but 0 is true (RFC 4251 § 5).
function read_bool(@r: Reader, what: str) -> bool?
    b = read_byte(@r, what: what)?
    return ok(b != 0)

# The next `uint32` of `r`, big-endian, as an `i64` from 0 to 2^32 - 1.
function read_u32(@r: Reader, what: str) -> i64?
    four = take(@r, n: 4, what: what)?
    return ok(u32_of(four, at: 0))

# The next `uint64` of `r`, big-endian, as an `i64`; one past 2^63 - 1 fails
# `invalid`, no length or offset of the protocols here reaching it.
function read_u64(@r: Reader, what: str) -> i64?
    eight = take(@r, n: 8, what: what)?

    if eight[0] > 127
        return fail(code: INVALID, msg: f"{what}: a uint64 past 2^63 - 1")
    return ok(u32_of(eight, at: 0) * 4294967296 + u32_of(eight, at: 4))

# The next `string` of `r`: a `uint32` length and that many bytes.
function read_string(@r: Reader, what: str) -> [u8]?
    n = read_u32(@r, what: what)?
    return take(@r, n: n, what: what)

# The next `string` of `r` read as UTF-8 text.
function read_text(@r: Reader, what: str) -> str?
    raw = read_string(@r, what: what)?

    match bytes.to_text(raw)
        .ok t  => return ok(t)
        .err _ => return fail(code: INVALID, msg: f"{what}: the string is not UTF-8")

# The next `mpint` of `r` as a positive or zero number: its magnitude's
# bytes, big-endian with no leading zero, empty for zero. A negative one,
# or one not in RFC 4251 § 5's shortest form, fails `invalid`.
function read_mpint(@r: Reader, what: str) -> [u8]?
    raw = read_string(@r, what: what)?

    if raw.len() == 0
        return ok(raw)

    if raw[0] > 127
        return fail(code: INVALID, msg: f"{what}: a negative mpint")

    if raw[0] == 0
        if raw.len() == 1 || raw[1] < 128
            return fail(code: INVALID, msg: f"{what}: an mpint with a needless leading zero")
        return ok(raw.slice(from: 1, to: raw.len()))
    return ok(raw)

# The next `name-list` of `r`: names of US-ASCII joined by commas, none
# empty; an empty list is an empty string.
function read_name_list(@r: Reader, what: str) -> [str]?
    raw = read_string(@r, what: what)?
    names: [str] @= []

    if raw.len() == 0
        return ok(names)
    piece: [u8] @= []

    for b in raw
        if b == ','
            if piece.len() == 0
                return fail(code: INVALID, msg: f"{what}: a name-list holding an empty name")
            names @ names.push(ascii_of(piece))
            piece @ []
        else if b < 33 || b > 126
            return fail(code: INVALID, msg: f"{what}: a name-list holding a byte that is no printable US-ASCII")
        else
            piece @ piece.push(b)

    if piece.len() == 0
        return fail(code: INVALID, msg: f"{what}: a name-list ending in a comma")
    names @ names.push(ascii_of(piece))
    return ok(names)

# The bytes of `r` not read, which moves to the end.
function read_rest(@r: Reader) -> [u8]
    rest = r.data.slice(from: r.at, to: r.data.len())
    r.at @ r.data.len()
    return rest

# Fails `invalid` where `r` holds bytes not read: a message that must hold
# nothing more.
function expect_end(r: Reader lent, what: str) -> ()?
    if left(r) != 0
        return fail(code: INVALID, msg: f"{what}: {left(r)} bytes past its end")
    return ok()

## Writing

# `b` added to `out`.
function put_byte(@out: [u8], b: u8)
    out @ out.push(b)

# `v` added to `out` as a `boolean`, 1 or 0.
function put_bool(@out: [u8], v: bool)
    if v
        out @ out.push(1)
    else
        out @ out.push(0)

# `n` added to `out` as a `uint32`. Aborts outside 0 to 2^32 - 1, a length
# the program itself computed.
function put_u32(@out: [u8], n: i64)
    assert n >= 0 && n <= 4294967295
    out @ out.push(to_u8(n >> 24 & 255).must())
    out @ out.push(to_u8(n >> 16 & 255).must())
    out @ out.push(to_u8(n >> 8 & 255).must())
    out @ out.push(to_u8(n & 255).must())

# `n` added to `out` as a `uint64`. Aborts below 0.
function put_u64(@out: [u8], n: i64)
    assert n >= 0
    put_u32(@out, n: n >> 32)
    put_u32(@out, n: n & 4294967295)

# `data` added to `out` as a `string`: its length, then its bytes.
function put_string(@out: [u8], data: [u8] lent)
    put_u32(@out, n: data.len())

    for b in data
        out @ out.push(b)

# `text`'s UTF-8 bytes added to `out` as a `string`.
function put_text(@out: [u8], text: str)
    put_string(out: @out, data: bytes.from_text(text))

# The positive or zero number whose magnitude is `magnitude`, big-endian,
# added to `out` as an `mpint`: its leading zeros dropped, and a zero byte
# put before a first byte past 127 so it does not read as negative.
function put_mpint(@out: [u8], magnitude: [u8] lent)
    first: i64 @= 0

    while first < magnitude.len() && magnitude[first] == 0
        first @ first + 1

    if first == magnitude.len()
        put_u32(@out, n: 0)
        return

    if magnitude[first] > 127
        put_u32(@out, n: magnitude.len() - first + 1)
        out @ out.push(0)
    else
        put_u32(@out, n: magnitude.len() - first)

    while first < magnitude.len()
        out @ out.push(magnitude[first])
        first @ first + 1

# `names` added to `out` as a `name-list`, joined by commas.
function put_name_list(@out: [u8], names: [str] lent)
    put_text(@out, text: join(names, ","))

# `data` written as a `string` alone.
function string_of(data: [u8] lent) -> [u8]
    out: [u8] @= []
    put_string(out: @out, data: data)
    return out

# `n` written as a `uint32` alone.
function u32_bytes(n: i64) -> [u8]
    out: [u8] @= []
    put_u32(@out, n: n)
    return out

## Bytes and text

# The `uint32` at `at` in `four`, big-endian. Aborts past the end.
function u32_of(four: [u8] lent, at: i64) -> i64
    a = to_i64(four[at]).must()
    b = to_i64(four[at + 1]).must()
    c = to_i64(four[at + 2]).must()
    d = to_i64(four[at + 3]).must()
    return a << 24 | b << 16 | c << 8 | d

# `raw`, bytes of US-ASCII the caller checked, as text.
function ascii_of(raw: [u8] lent) -> str
    return bytes.to_text(raw).must()

## Tests

test "put_mpint and read_mpint: RFC 4251 § 5's examples, a negative one refused, a needless zero refused"
    zero: [u8] @= []
    put_mpint(out: @zero, magnitude: [])
    assert zero == [0, 0, 0, 0]
    long: [u8] @= []
    put_mpint(out: @long, magnitude: [9, 163, 120, 249, 178, 227, 50, 167])
    assert long == [0, 0, 0, 8, 9, 163, 120, 249, 178, 227, 50, 167]
    high: [u8] @= []
    put_mpint(out: @high, magnitude: [0, 128])
    assert high == [0, 0, 0, 2, 0, 128]
    r @= reader(high)
    assert read_mpint(@r, what: "x").must() == [128]
    negative @= reader([0, 0, 0, 2, 237, 204])
    assert read_mpint(@negative, what: "x").is_err()
    padded @= reader([0, 0, 0, 2, 0, 5])
    assert read_mpint(@padded, what: "x").is_err()

test "put_name_list and read_name_list: RFC 4251 § 5's examples, an empty name and a byte past US-ASCII refused"
    two: [u8] @= []
    put_name_list(@two, names: ["zlib", "none"])
    assert two == [0, 0, 0, 9, 122, 108, 105, 98, 44, 110, 111, 110, 101]
    r @= reader(two)
    assert read_name_list(@r, what: "x").must() == ["zlib", "none"]
    empty @= reader([0, 0, 0, 0])
    assert read_name_list(@empty, what: "x").must().len() == 0
    hole @= reader([0, 0, 0, 2, 97, 44])
    assert read_name_list(@hole, what: "x").is_err()
    wide @= reader([0, 0, 0, 1, 200])
    assert read_name_list(@wide, what: "x").is_err()

test "read_string, read_u32 and read_u64: a length past the end, the largest uint32, a uint64 past 2^63 - 1"
    short @= reader([0, 0, 0, 9, 1])
    assert read_string(@short, what: "x").is_err()
    top @= reader([255, 255, 255, 255])
    assert read_u32(@top, what: "x").must() == 4294967295
    huge @= reader([128, 0, 0, 0, 0, 0, 0, 0])
    assert read_u64(@huge, what: "x").is_err()
    big_one @= reader([127, 255, 255, 255, 255, 255, 255, 255])
    assert read_u64(@big_one, what: "x").must() == 9223372036854775807
    none @= reader([])
    assert read_byte(@none, what: "x").is_err()
