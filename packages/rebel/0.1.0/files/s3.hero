# A form that lets a browser upload one photo of at most 10 MB for an hour.
test "presign_post: a photo's upload form"
    c = aws_client(
        region: "eu-west-1",
        credentials: Credentials(access_key_id: "AKID", secret_access_key: "s", session_token: "")
    )
    form = presign_post(
        c,
        bucket: "uploads",
        key: "photos/cat.jpg",
        content_type: "image/jpeg",
        max_size: 10_000_000,
        at: time.now().must(),
        expires_seconds: 3_600
    ).must()
    assert form.target == "https://uploads.s3.eu-west-1.amazonaws.com/" && form.fields.len() == 7

