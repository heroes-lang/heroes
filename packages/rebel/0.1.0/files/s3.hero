# Data of two parts put, where a MinIO of its defaults answers on this
# machine and holds the bucket; elsewhere it skips.
test "put_object_in_parts: parts of 5 MiB"
    c = minio_client(
        endpoint: "http://127.0.0.1:9000",
        credentials: Credentials(access_key_id: "minioadmin", secret_access_key: "minioadmin", session_token: "")
    )

    match put_object_in_parts(c, bucket: "rebel-examples", key: "small.bin", data: [1, 2, 3], part_size: MIN_PART_SIZE, options: put_options())
        .ok s  => assert s.etag != ""
        .err e => skip_test(reason: f"no S3 server holding the bucket rebel-examples answered on this machine: {e.msg}")

# What a pipe holds put, where a MinIO of its defaults answers on this
# machine and holds the bucket; elsewhere it skips.
test "put_object_from: a stream's bytes"
    c = minio_client(
        endpoint: "http://127.0.0.1:9000",
        credentials: Credentials(access_key_id: "minioadmin", secret_access_key: "minioadmin", session_token: "")
    )
    p = io.pipe().must()
    io.write(p.writer, data: bytes.from_text("streamed")).must()
    w @= p.writer
    io.close(@w).must()

    match put_object_from(c, bucket: "rebel-examples", key: "streamed.txt", s: p.reader, part_size: MIN_PART_SIZE, options: put_options())
        .ok s  => assert s.etag != ""
        .err e => skip_test(reason: f"no S3 server holding the bucket rebel-examples answered on this machine: {e.msg}")

    r @= p.reader
    io.close(@r).must()

# A URL that deletes an object for five minutes, signed now.
test "presign_url: a DELETE"
    c = minio_client(
        endpoint: "http://127.0.0.1:9000",
        credentials: Credentials(access_key_id: "minioadmin", secret_access_key: "minioadmin", session_token: "")
    )
    link = presign_url(
        c,
        method: "DELETE",
        bucket: "photos",
        key: "cat.jpg",
        headers: [],
        at: time.now().must(),
        expires_seconds: 300
    ).must()
    assert strings.has_prefix(s: link, prefix: "http://127.0.0.1:9000/photos/cat.jpg?X-Amz-Algorithm=AWS4-HMAC-SHA256")

# A URL that reads an object for an hour.
test "presign_get: an hour"
    c = minio_client(
        endpoint: "http://127.0.0.1:9000",
        credentials: Credentials(access_key_id: "minioadmin", secret_access_key: "minioadmin", session_token: "")
    )
    assert strings.contains(
        s: presign_get(c, bucket: "photos", key: "cat.jpg", expires_seconds: 3_600).must(),
        substr: "X-Amz-Expires=3600"
    )

# A URL that puts an object for ten minutes.
test "presign_put: ten minutes"
    c = minio_client(
        endpoint: "http://127.0.0.1:9000",
        credentials: Credentials(access_key_id: "minioadmin", secret_access_key: "minioadmin", session_token: "")
    )
    assert strings.contains(
        s: presign_put(c, bucket: "uploads", key: "in.csv", expires_seconds: 600).must(),
        substr: "X-Amz-SignedHeaders=host"
    )
