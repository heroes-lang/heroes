    )

    match create_multipart_upload(c, bucket: "rebel-examples", key: "joined.txt", options: put_options())
        .ok u =>
            match upload_part_copy(c, upload: u, number: 1, from_bucket: "rebel-examples", from_key: "hello.txt", span: .whole)
                .ok p  => assert p.etag != ""
                .err _ => _ = 0

            abort_multipart_upload(c, upload: u).must()
        .err e => skip_test(reason: f"no S3 server holding the bucket rebel-examples answered on this machine: {e.msg}")

