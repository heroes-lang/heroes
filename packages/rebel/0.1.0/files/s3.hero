    )

    match create_multipart_upload(c, bucket: "rebel-examples", key: "parts.bin", options: put_options())
        .ok u =>
            p = upload_part(c, upload: u, number: 1, data: [1, 2, 3]).must()
            assert p.number == 1 && p.etag != ""
            abort_multipart_upload(c, upload: u).must()
        .err e => skip_test(reason: f"no S3 server holding the bucket rebel-examples answered on this machine: {e.msg}")

