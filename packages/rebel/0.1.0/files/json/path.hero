# JSONPath as RFC 9535 defines it: a query read once, checked against the
# RFC's grammar and its rules of types, and run against a `json.Value` to
# select the values it names, each with its place as a normalized path and as
# a JSON pointer; and the places a query selects given new values.
#
# Everything the RFC defines is read: the root `$`, names, `*`, indices and
# slices, the descendant segment `..`, filters with `@`, comparisons, `&&`,
# `||`, `!` and parentheses, and the five functions of its registry: `length`,
# `count`, `match`, `search` and `value`. Nothing past it: no parent operator,
# no arithmetic, no sorting, no function of a program's own. A pattern of
# `match` and `search` is an I-Regexp (RFC 9485), matched by `regex` in time
# linear in the text.
#
# The value a query runs against is read by `json.parse`; a member's order is
# the order its object keeps, which the RFC leaves to the implementation.
# Nothing here follows the data with recursion: the descendant segment walks a
# value nested as deep as a program builds it on a stack this package holds
# itself. A query's own nesting, of filters inside filters and of
# parentheses, is bounded by `MAX_NESTING`.
#
# Fails `invalid` where a query is not one, the message saying where and why;
# `not_found` where `select_one` finds nothing.
#
# `use <rebel>/json/path` binds the name `path`, which `use <rebel>/path`
# binds too, and the compiler refuses a file that binds one name twice
# (`module_binding_taken`): a program that uses both writes `use
# <rebel>/json/path as json_path` and calls `json_path.parse`.

use json
use json/path/internal/cts
use json/path/internal/edit
use json/path/internal/places
use json/path/internal/program
use json/path/internal/reader
use json/path/internal/run
use json/path/internal/samples

## Codes and bounds

# The code of a query that is not one, of a location that is not a
# normalized path, and of a `select_one` that finds several values: `parse`,
# `to_pointer` and `select_one` fail with it.
constant INVALID: str
    "invalid"

# The code of a `select_one` that finds nothing.
constant NOT_FOUND: str
    "not_found"

# The deepest a query nests filters inside filters, queries inside a
# function's arguments, and parentheses, counted together; `parse` refuses a
# query nested deeper, so that running it never runs out of the machine's
# stack.
constant MAX_NESTING: i64
    64

## A query

# A query read and checked, ready to run against any number of values. Only
# `parse` makes one.
record Query
    # The query's text as it was given.
    text: str
    # The query as `parse` read it, which only this package reads.
    code: program.Program

# The query `text` writes, read and checked.
#
# - `text`: a JSONPath query, beginning with `$`; white space is allowed where
#   RFC 9535 allows it and nowhere else, so none before the `$` or after the
#   end.
#
# Fails `invalid` where `text` is not a query by the RFC's grammar, or breaks
# its rules of types: a function unknown or given the wrong number or kind of
# arguments, a query that can select several values compared with `==`, a
# `match` or `search` compared at all, an index or a slice's number past
# 2^53 - 1 either way or written `-0` or with a leading zero, and a query
# nested deeper than `MAX_NESTING`. The message says where, counted in bytes
# from 0, and what was expected.
function parse(text: str) -> Query?
    return ok(Query(text: text, code: reader.read(text)?))

# Whether `text` is a query: true exactly where `parse` succeeds.
#
# - `text`: the text asked about.
function is_valid(text: str) -> bool
    return !parse(text).is_err()

## Selecting

# One value a query selects, and where it stands in the value queried.
record Node
    # Its place as RFC 9535's normalized path: `$` for the whole value, then
    # `['name']` for a member and `[3]` for an element, as `$['a'][0]`.
    location: str
    # Its place as a JSON pointer, RFC 6901: `""` for the whole value, then
    # `/name` and `/3`, as `/a/0`; `json.value_at` reads it back.
    pointer: str
    # The value itself.
    value: json.Value

# The values `query` selects in `doc`, in the RFC's order.
#
# - `query`: a query `parse` made.
# - `doc`: the value queried.
#
# The order is the RFC's: each segment's selections in turn, a list's
# elements by index and an object's members in the order the object keeps
# them, and the descendant segment's in document order, a value before the
# values it holds. A value selected twice, by `$[0, 0]`, comes twice. Nothing
# selected gives an empty list, never a failure.
function select(query: Query, doc: json.Value) -> [json.Value]
    out: [json.Value] @= []

    for found in run.run(query.code, doc: doc, with_places: false)
        out @ out.push(found.value)

    return out

# The values `query` selects in `doc` with their places, in the order
# `select` gives.
#
# - `query`: a query `parse` made.
# - `doc`: the value queried.
function select_nodes(query: Query, doc: json.Value) -> [Node]
    out: [Node] @= []

    for found in run.run(query.code, doc: doc, with_places: true)
        out @ out.push(Node(location: found.location, pointer: found.pointer, value: found.value))

    return out

# The one value `query` selects in `doc`.
#
# - `query`: a query `parse` made.
# - `doc`: the value queried.
#
# Fails `not_found` where it selects nothing, and `invalid` where it selects
# more than one, the message saying how many.
function select_one(query: Query, doc: json.Value) -> json.Value?
    found = select(query, doc: doc)

    if found.len() == 0
        return fail(code: NOT_FOUND, msg: f"{query.text} selects nothing")

    if found.len() > 1
        return fail(code: INVALID, msg: f"{query.text} selects {found.len()} values, where one was asked")
    return ok(found[0])

## Places

# The JSON pointer of the place a normalized path names.
#
# - `location`: a normalized path as RFC 9535 § 2.7 writes one, such as
#   `Node.location` holds.
#
# Fails `invalid` where `location` is not a normalized path: a name in double
# quotes, an escape the normalized form does not use, a negative index or a
# wildcard are not.
function to_pointer(location: str) -> str?
    return places.pointer_of(location)

## Changing what a query selects

# `doc` with every value `query` selects replaced by `value`.
#
# - `query`: a query `parse` made.
# - `doc`: the value changed; the caller's own is never changed.
# - `value`: the value put at each place selected.
#
# Where a place selected holds another place selected, the outer one is
# replaced last, so `value` stands there. Nothing selected answers `doc`.
function replace_all(query: Query, doc: json.Value, value: json.Value) -> json.Value
    pointers: [str] @= []

    for found in run.run(query.code, doc: doc, with_places: true)
        pointers @ pointers.push(found.pointer)

    changed: json.Value @= doc

    for pointer in edit.deepest_first(pointers)
        changed @ edit.put(doc: changed, pointer: pointer, value: value)

    return changed

# `doc` with every value `query` selects replaced by what `by` answers for it.
#
# - `query`: a query `parse` made.
# - `doc`: the value changed.
# - `by`: called once for each place selected, with the value there, and its
#   answer is put in its place; a place inside another is changed first, so
#   the outer place's call receives its value with the inner ones changed.
function replace_all_by(query: Query, doc: json.Value, by: (function(json.Value) -> json.Value)) -> json.Value
    changed: json.Value @= doc

    pointers: [str] @= []

    for found in run.run(query.code, doc: doc, with_places: true)
        pointers @ pointers.push(found.pointer)

    for pointer in edit.deepest_first(pointers)
        old = json.value_at(changed, pointer).must()
        changed @ edit.put(doc: changed, pointer: pointer, value: by(old))

    return changed

## Tests

test "cts: the JSONPath Compliance Test Suite, from its commit"
    assert cts.VERSION == "20ebdcce"

## Examples

# A query read.
test "parse: the authors of every book"
    q = parse("$.store.book[*].author").must()
    assert q.text == "$.store.book[*].author"

# A text asked whether it is a query.
test "is_valid: a filter and a missing root"
    assert is_valid("$[?@.price < 10]") && !is_valid("store.book")

# The values a filter selects.
test "select: the cheap books' titles"
    doc = json.parse("{\"book\": [{\"title\": \"A\", \"price\": 8}, {\"title\": \"B\", \"price\": 22}]}").must()
    assert select(parse("$.book[?@.price < 10].title").must(), doc) == [.text(v: "A")]

# The values selected with their places.
test "select_nodes: every price, with its place"
    doc = json.parse("{\"book\": [{\"price\": 8}, {\"price\": 22}]}").must()
    found = select_nodes(parse("$..price").must(), doc)
    assert found.len() == 2 && found[1].location == "$['book'][1]['price']" && found[1].pointer == "/book/1/price"

# The one value a query selects.
test "select_one: a member by name"
    doc = json.parse("{\"a\": {\"b\": true}}").must()
    assert select_one(parse("$.a.b").must(), doc).must() == .boolean(v: true)

# A normalized path written as a pointer.
test "to_pointer: a member and an element"
    assert to_pointer("$['a/b'][3]").must() == "/a~1b/3"

# Every place a query selects given one value.
test "replace_all: every price made 0"
    doc = json.parse("{\"book\": [{\"price\": 8}, {\"price\": 22}]}").must()
    done = replace_all(parse("$..price").must(), doc: doc, value: .number(v: 0.0))
    assert json.format(done).must() == "{\"book\":[{\"price\":0},{\"price\":0}]}"

# Every place a query selects given what a function answers.
test "replace_all_by: every number doubled"
    doc = json.parse("[1, 2, \"x\"]").must()
    done = replace_all_by(parse("$[?@ >= 0]").must(), doc, samples.doubled)
    assert json.format(done).must() == "[2,4,\"x\"]"
