    )

test "man.test 61: .[-2]"
    assert passes(program: ".[-2]", input: "[1,2,3]", expected: ["2"])

test "man.test 65: .[2:4]"
    assert passes(program: ".[2:4]", input: "[\"a\",\"b\",\"c\",\"d\",\"e\"]", expected: ["[\"c\", \"d\"]"])

test "man.test 69: .[2:4]"
    assert passes(program: ".[2:4]", input: "\"abcdefghi\"", expected: ["\"cd\""])

test "man.test 73: .[:3]"
    assert passes(program: ".[:3]", input: "[\"a\",\"b\",\"c\",\"d\",\"e\"]", expected: ["[\"a\", \"b\", \"c\"]"])

test "man.test 77: .[-2:]"
    assert passes(program: ".[-2:]", input: "[\"a\",\"b\",\"c\",\"d\",\"e\"]", expected: ["[\"d\", \"e\"]"])

test "man.test 81: .[]"
    assert passes(
        program: ".[]",
        input: f"[{{\"name\":\"JSON\", \"good\":true}}, {{\"name\":\"XML\", \"good\":false}}]",
        expected: [f"{{\"name\":\"JSON\", \"good\":true}}", f"{{\"name\":\"XML\", \"good\":false}}"]
    )

test "man.test 86: .[]"
    expected: [str] = []
    assert passes(program: ".[]", input: "[]", expected: expected)

test "man.test 89: .foo[]"
    assert passes(program: ".foo[]", input: f"{{\"foo\":[1,2,3]}}", expected: ["1", "2", "3"])

test "man.test 95: .[]"
    assert passes(program: ".[]", input: f"{{\"a\": 1, \"b\": 1}}", expected: ["1", "1"])

test "man.test 100: .foo, .bar"
    assert passes(
