# The examples of jq 1.7.1's manual, as jq's `tests/man.test` of the tag jq-1.7.1 holds them (SHA-256 1d0c3138...), fetched on 2026-11-17.
#
# Each case is a test: the filter run on its input must output exactly the
# values the file lists, in order, an error after them allowed, as jq's own
# runner allows one; a case jq refuses to compile must be refused. 219 cases
# are tests here; the ones that cannot run are named below with their reason.
#
# - line 9, `[., tojson]`: a number past an f64 kept to its literal digits by `tojson`; a `json.Value` holds an f64
# - line 17, `map([., . == 1]) | tojson`: a number's literal digits, `1.000`, kept by `tojson`; a `json.Value` holds an f64
# - line 21, `. as $big | [$big, $big + 1] | map(. > 100000000000000000...`: an integer past an f64 compared exactly; a `json.Value` holds an f64
# - line 661, `$ENV.PAGER`: `$ENV` read from the process's environment, `PAGER` set by jq's runner; here the caller gives `$ENV`
# - line 665, `env.PAGER`: `env` read from the process's environment, `PAGER` set by jq's runner; here the caller gives `$ENV`

use json
use json/jq/internal/compile
use json/jq/internal/machine
use json/jq/internal/state
use json/jq/internal/text
use json/jq/internal/values

# The release of jq the cases were taken from.
constant VERSION: str
    "jq-1.7.1"

# The values `program` outputs for the JSON text `input`, which may hold
# `nan`, as jq's tests write it.
function outputs_of(program: str, input: str) -> [json.Value]
    code = compile.compile(program).must()
    m: state.Machine @= machine.start(
        code,
        input: text.read_json(input).must(),
        variables: {},
        inputs: [],
        environment: .object(members: {}),
        now: 0.0,
        max_steps: 10000000,
        max_outputs: 100000,
        max_depth: 10000,
        stop_after: 0
    )
    machine.run(@m)
    assert m.ending != state.LIMITED
    return m.outputs

# Whether `program` on `input` outputs the values `expected` writes, in order.
function passes(program: str, input: str, expected: [str]) -> bool
    got = outputs_of(program: program, input: input)

    if got.len() != expected.len()
        return false

    for i in range(from: 0, to: got.len())
        if !values.equal(a: got[i], b: text.read_json(expected[i]).must())
            return false

    return true

# U+FEFF, the byte order mark, which a case puts before its input: made from
# its bytes, so no invisible character stands in this file.
function bom() -> str
    mark: [u8] = [239, 187, 191]
    return mark.validated_bytes().must()

# Whether `program` is refused.
function refused(program: str) -> bool
    return compile.compile(program).is_err()

## Tests

test "man.test 1: ."
    assert passes(program: ".", input: "\"Hello, world!\"", expected: ["\"Hello, world!\""])

test "man.test 5: ."
    assert passes(program: ".", input: "0.12345678901234567890123456789", expected: ["0.12345678901234567890123456789"])

test "man.test 13: . < 0.12345678901234567890123456788"
    assert passes(
        program: ". < 0.12345678901234567890123456788",
        input: "0.12345678901234567890123456789",
        expected: ["false"]
    )

test "man.test 25: .foo"
    assert passes(program: ".foo", input: f"{{\"foo\": 42, \"bar\": \"less interesting data\"}}", expected: ["42"])

test "man.test 29: .foo"
    assert passes(program: ".foo", input: f"{{\"notfoo\": true, \"alsonotfoo\": false}}", expected: ["null"])

test "man.test 33: .['foo']"
    assert passes(program: ".[\"foo\"]", input: f"{{\"foo\": 42}}", expected: ["42"])

test "man.test 37: .foo?"
    assert passes(program: ".foo?", input: f"{{\"foo\": 42, \"bar\": \"less interesting data\"}}", expected: ["42"])

test "man.test 41: .foo?"
    assert passes(program: ".foo?", input: f"{{\"notfoo\": true, \"alsonotfoo\": false}}", expected: ["null"])

test "man.test 45: .['foo']?"
    assert passes(program: ".[\"foo\"]?", input: f"{{\"foo\": 42}}", expected: ["42"])

test "man.test 49: [.foo?]"
    assert passes(program: "[.foo?]", input: "[1,2]", expected: ["[]"])

test "man.test 53: .[0]"
    assert passes(
        program: ".[0]",
        input: f"[{{\"name\":\"JSON\", \"good\":true}}, {{\"name\":\"XML\", \"good\":false}}]",
        expected: [f"{{\"name\":\"JSON\", \"good\":true}}"]
    )

