test "jq.test 1038: setpath([-1]; 1)"
    assert passes(program: "setpath([-1]; 1)", input: "[0]", expected: ["[1]"])

test "jq.test 1042: pick(.a.b.c)"
    assert passes(program: "pick(.a.b.c)", input: "null", expected: [f"{{\"a\":{{\"b\":{{\"c\":null}}}}}}"])

