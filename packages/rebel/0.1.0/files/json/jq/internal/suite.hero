test "jq.test 1099: .[] | try (getpath(['a',0,'b']) |= 5) catch ."
    assert passes(
        program: ".[] | try (getpath([\"a\",0,\"b\"]) |= 5) catch .",
        input: f"[null,{{\"b\":0}},{{\"a\":0}},{{\"a\":null}},{{\"a\":[0,1]}},{{\"a\":{{\"b\":1}}}},{{\"a\":[{{}}]}},{{\"a\":[{{\"c\":3}}]}}]",
        expected: [f"{{\"a\":[{{\"b\":5}}]}}", f"{{\"b\":0,\"a\":[{{\"b\":5}}]}}", "\"Cannot index number with number\"", f"{{\"a\":[{{\"b\":5}}]}}", "\"Cannot index number with string \\\"b\\\"\"", "\"Cannot index object with number\"", f"{{\"a\":[{{\"b\":5}}]}}", f"{{\"a\":[{{\"c\":3,\"b\":5}}]}}"]
    )

