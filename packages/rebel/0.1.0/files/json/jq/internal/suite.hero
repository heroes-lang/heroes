# The cases of jq 1.7.1's own test file, `tests/jq.test` of the tag jq-1.7.1 (SHA-256 35aade21...), fetched on 2026-11-17.
#
# Each case is a test: the filter run on its input must output exactly the
# values the file lists, in order, an error after them allowed, as jq's own
# runner allows one; a case jq refuses to compile must be refused. 442 cases
# are tests here; the ones that cannot run are named below with their reason.
#
# - line 559, `9E999999999, 9999999999E999999990, 1E-999999999, 0.000000...`: numbers past an f64 written as jq 1.7 keeps a literal's own digits (`9E+999999999`); a `json.Value` holds an f64
# - line 1839, `.[0] | tostring`: an integer literal past 2^53 kept to its last digit; a `json.Value` holds an f64
# - line 1843, `.x | tojson`: an integer literal past 2^53 kept to its last digit; a `json.Value` holds an f64
# - line 1847, `13911860366432393 == 13911860366432392`: two integers past 2^53 told apart; a `json.Value` holds an f64
# - line 1949, `try input catch .`: `input` answers `break` under jq's own test runner, which feeds it; a caller here gives the inputs, and with none `input` raises `No more inputs`

use json
use json/jq/internal/compile
use json/jq/internal/machine
use json/jq/internal/state
use json/jq/internal/text
use json/jq/internal/values

# The release of jq the cases were taken from.
constant VERSION: str
    "jq-1.7.1"

# The values `program` outputs for the JSON text `input`, which may hold
# `nan`, as jq's tests write it.
function outputs_of(program: str, input: str) -> [json.Value]
    code = compile.compile(program).must()
    m: state.Machine @= machine.start(
        code,
        input: text.read_json(input).must(),
        variables: {},
        inputs: [],
        environment: .object(members: {}),
        now: 0.0,
        max_steps: 10000000,
        max_outputs: 100000,
        max_depth: 10000,
        stop_after: 0
    )
    machine.run(@m)
    assert m.ending != state.LIMITED
    return m.outputs

# Whether `program` on `input` outputs the values `expected` writes, in order.
function passes(program: str, input: str, expected: [str]) -> bool
    got = outputs_of(program: program, input: input)

    if got.len() != expected.len()
        return false

    for i in range(from: 0, to: got.len())
        if !values.equal(a: got[i], b: text.read_json(expected[i]).must())
            return false

    return true

# U+FEFF, the byte order mark, which a case puts before its input: made from
# its bytes, so no invisible character stands in this file.
function bom() -> str
    mark: [u8] = [239, 187, 191]
    return mark.validated_bytes().must()

# Whether `program` is refused.
function refused(program: str) -> bool
    return compile.compile(program).is_err()

## Tests

test "jq.test 8: true"
    assert passes(program: "true", input: "null", expected: ["true"])

test "jq.test 12: false"
    assert passes(program: "false", input: "null", expected: ["false"])

test "jq.test 16: null"
    assert passes(program: "null", input: "42", expected: ["null"])

test "jq.test 20: 1"
    assert passes(program: "1", input: "null", expected: ["1"])

test "jq.test 25: -1"
    assert passes(program: "-1", input: "null", expected: ["-1"])

test "jq.test 31: ()"
    assert passes(program: f"{{}}", input: "null", expected: [f"{{}}"])

test "jq.test 35: []"
    assert passes(program: "[]", input: "null", expected: ["[]"])

test "jq.test 39: (x: -1)"
    assert passes(program: f"{{x: -1}}", input: "null", expected: [f"{{\"x\": -1}}"])

test "jq.test 46: ."
    assert passes(program: ".", input: bom() + "\"byte order mark\"", expected: ["\"byte order mark\""])

test "jq.test 52: 'Aa/r/n/t/b/f/u03bc'"
    assert passes(
        program: "\"Aa\\r\\n\\t\\b\\f\\u03bc\"",
        input: "null",
        expected: ["\"Aa\\u000d\\u000a\\u0009\\u0008\\u000c\\u03bc\""]
    )

test "jq.test 56: ."
    assert passes(
        program: ".",
        input: "\"Aa\\r\\n\\t\\b\\f\\u03bc\"",
        expected: ["\"Aa\\u000d\\u000a\\u0009\\u0008\\u000c\\u03bc\""]
    )

test "jq.test 60: 'inter/('pol' + 'ation')'"
    assert passes(program: "\"inter\\(\"pol\" + \"ation\")\"", input: "null", expected: ["\"interpolation\""])

test "jq.test 64: @text,@json,([1,.]|@csv,@tsv),@html,@uri,@sh,(@base64|.,@..."
    assert passes(
        program: "@text,@json,([1,.]|@csv,@tsv),@html,@uri,@sh,(@base64|.,@base64d)",
        input: "\"!()<>&'\\\"\\t\"",
        expected: ["\"!()<>&'\\\"\\t\"", "\"\\\"!()<>&'\\\\\\\"\\\\t\\\"\"", "\"1,\\\"!()<>&'\\\"\\\"\\t\\\"\"", "\"1\\t!()<>&'\\\"\\\\t\"", "\"!()&lt;&gt;&amp;&apos;&quot;\\t\"", "\"%21%28%29%3C%3E%26%27%22%09\"", "\"'!()<>&'\\\\''\\\"\\t'\"", "\"ISgpPD4mJyIJ\"", "\"!()<>&'\\\"\\t\""]
    )

