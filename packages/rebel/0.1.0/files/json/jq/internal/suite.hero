    assert passes(program: ".foo |= .+1", input: f"{{\"foo\": 42}}", expected: [f"{{\"foo\": 43}}"])

test "jq.test 1074: .[] += 2, .[] *= 2, .[] -= 2, .[] /= 2, .[] %=2"
