# `import` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1584: import 'a' as foo; import 'b' as bar; def fooa: foo::a; [..."
    assert refused("import \"a\" as foo; import \"b\" as bar; def fooa: foo::a; [fooa, bar::a, bar::b, foo::a]")

# `import` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1588: import 'c' as foo; [foo::a, foo::c]"
    assert refused("import \"c\" as foo; [foo::a, foo::c]")

# `include` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1592: include 'c'; [a, c]"
    assert refused("include \"c\"; [a, c]")

# `import` reads data from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1596: import 'data' as $e; import 'data' as $d; [$d[].this,$e[]..."
    assert refused(
        "import \"data\" as $e; import \"data\" as $d; [$d[].this,$e[].that,$d::d[].this,$e::e[].that]|join(\";\")"
    )

# `import` reads data from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1601: import 'data' as $a; import 'data' as $b; def f: ($a, $b); f"
    assert refused(f"import \"data\" as $a; import \"data\" as $b; def f: {{$a, $b}}; f")

# `include` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1605: include 'shadow1'; e"
    assert refused("include \"shadow1\"; e")

# `include` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1609: include 'shadow1'; include 'shadow2'; e"
    assert refused("include \"shadow1\"; include \"shadow2\"; e")

# `import` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1613: import 'shadow1' as f; import 'shadow2' as f; import 'sha..."
    assert refused("import \"shadow1\" as f; import \"shadow2\" as f; import \"shadow1\" as e; [e::e, f::e]")

test "jq.test 1617: module (.+1); 0"
    assert refused("module (.+1); 0")

test "jq.test 1621: module []; 0"
    assert refused("module []; 0")

test "jq.test 1625: include 'a' (.+1); 0"
    assert refused("include \"a\" (.+1); 0")

test "jq.test 1629: include 'a' []; 0"
    assert refused("include \"a\" []; 0")

test "jq.test 1633: include '/ '; 0"
    assert refused("include \"\\ \"; 0")

test "jq.test 1637: include '/(a)'; 0"
    assert refused("include \"\\(a)\"; 0")

# `modulemeta` reads a module's file, which this interpreter refuses: the case asserts the refusal
test "jq.test 1641: modulemeta"
    assert refused("modulemeta")

# `modulemeta` reads a module's file, which this interpreter refuses: the case asserts the refusal
test "jq.test 1645: modulemeta | .deps | length"
    assert refused("modulemeta | .deps | length")

# `modulemeta` reads a module's file, which this interpreter refuses: the case asserts the refusal
test "jq.test 1649: modulemeta | .defs | length"
    assert refused("modulemeta | .defs | length")

test "jq.test 1653: import 'syntaxerror' as e; ."
    assert refused("import \"syntaxerror\" as e; .")

test "jq.test 1657: %::wat"
    assert refused("%::wat")

# `import` reads definitions from files, which this interpreter refuses: the case asserts the refusal
test "jq.test 1661: import 'test_bind_order' as check; check::check"
    assert refused("import \"test_bind_order\" as check; check::check")

