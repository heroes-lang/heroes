test "jq.test 935: [any,all]"
    assert passes(program: "[any,all]", input: "[]", expected: ["[false,true]"])

test "jq.test 939: [any,all]"
    assert passes(program: "[any,all]", input: "[true]", expected: ["[true,true]"])

test "jq.test 943: [any,all]"
    assert passes(program: "[any,all]", input: "[false]", expected: ["[false,false]"])

test "jq.test 947: [any,all]"
    assert passes(program: "[any,all]", input: "[true,false]", expected: ["[true,false]"])

test "jq.test 951: [any,all]"
    assert passes(program: "[any,all]", input: "[null,null,true]", expected: ["[true,false]"])

test "jq.test 959: path(.foo[0,1])"
    assert passes(program: "path(.foo[0,1])", input: "null", expected: ["[\"foo\", 0]", "[\"foo\", 1]"])

test "jq.test 964: path(.[] | select(.>3))"
    assert passes(program: "path(.[] | select(.>3))", input: "[1,5,3]", expected: ["[1]"])

test "jq.test 968: path(.)"
    assert passes(program: "path(.)", input: "42", expected: ["[]"])

test "jq.test 972: try path(.a | map(select(.b == 0))) catch ."
    assert passes(
        program: "try path(.a | map(select(.b == 0))) catch .",
        input: f"{{\"a\":[{{\"b\":0}}]}}",
        expected: [f"\"Invalid path expression with result [{{\\\"b\\\":0}}]\""]
    )

test "jq.test 976: try path(.a | map(select(.b == 0)) | .[0]) catch ."
    assert passes(
        program: "try path(.a | map(select(.b == 0)) | .[0]) catch .",
        input: f"{{\"a\":[{{\"b\":0}}]}}",
        expected: [f"\"Invalid path expression near attempt to access element 0 of [{{\\\"b\\\":0}}]\""]
    )

test "jq.test 980: try path(.a | map(select(.b == 0)) | .c) catch ."
    assert passes(
        program: "try path(.a | map(select(.b == 0)) | .c) catch .",
        input: f"{{\"a\":[{{\"b\":0}}]}}",
        expected: [f"\"Invalid path expression near attempt to access element \\\"c\\\" of [{{\\\"b\\\":0}}]\""]
    )

test "jq.test 984: try path(.a | map(select(.b == 0)) | .[]) catch ."
    assert passes(
        program: "try path(.a | map(select(.b == 0)) | .[]) catch .",
        input: f"{{\"a\":[{{\"b\":0}}]}}",
        expected: [f"\"Invalid path expression near attempt to iterate through [{{\\\"b\\\":0}}]\""]
    )

test "jq.test 988: path(.a[path(.b)[0]])"
    assert passes(program: "path(.a[path(.b)[0]])", input: f"{{\"a\":{{\"b\":0}}}}", expected: ["[\"a\",\"b\"]"])

test "jq.test 992: [paths]"
    assert passes(program: "[paths]", input: f"[1,[[],{{\"a\":2}}]]", expected: ["[[0],[1],[1,0],[1,1],[1,1,\"a\"]]"])

test "jq.test 996: ['foo',1] as $p | getpath($p), setpath($p; 20), delpaths(..."
    assert passes(
        program: "[\"foo\",1] as $p | getpath($p), setpath($p; 20), delpaths([$p])",
        input: f"{{\"bar\": 42, \"foo\": [\"a\", \"b\", \"c\", \"d\"]}}",
        expected: ["\"b\"", f"{{\"bar\": 42, \"foo\": [\"a\", 20, \"c\", \"d\"]}}", f"{{\"bar\": 42, \"foo\": [\"a\", \"c\", \"d\"]}}"]
    )

test "jq.test 1002: map(getpath([2])), map(setpath([2]; 42)), map(delpaths([[..."
    assert passes(
        program: "map(getpath([2])), map(setpath([2]; 42)), map(delpaths([[2]]))",
        input: "[[0], [0,1], [0,1,2]]",
        expected: ["[null, null, 2]", "[[0,null,42], [0,1,42], [0,1,42]]", "[[0], [0,1], [0,1]]"]
    )

test "jq.test 1008: map(delpaths([[0,'foo']]))"
    assert passes(
        program: "map(delpaths([[0,\"foo\"]]))",
        input: f"[[{{\"foo\":2, \"x\":1}}], [{{\"bar\":2}}]]",
        expected: [f"[[{{\"x\":1}}], [{{\"bar\":2}}]]"]
    )

test "jq.test 1012: ['foo',1] as $p | getpath($p), setpath($p; 20), delpaths(..."
    assert passes(
        program: "[\"foo\",1] as $p | getpath($p), setpath($p; 20), delpaths([$p])",
        input: f"{{\"bar\":false}}",
        expected: ["null", f"{{\"bar\":false, \"foo\": [null, 20]}}", f"{{\"bar\":false}}"]
    )

test "jq.test 1018: delpaths([[-200]])"
    assert passes(program: "delpaths([[-200]])", input: "[1,2,3]", expected: ["[1,2,3]"])

test "jq.test 1022: try delpaths(0) catch ."
    assert passes(
        program: "try delpaths(0) catch .",
        input: f"{{}}",
        expected: ["\"Paths must be specified as an array\""]
    )

test "jq.test 1026: del(.), del(empty), del((.foo,.bar,.baz) | .[2,3,0]), del..."
    assert passes(
        program: "del(.), del(empty), del((.foo,.bar,.baz) | .[2,3,0]), del(.foo[0], .bar[0], .foo, .baz.bar[0].x)",
        input: f"{{\"foo\": [0,1,2,3,4], \"bar\": [0,1]}}",
        expected: ["null", f"{{\"foo\": [0,1,2,3,4], \"bar\": [0,1]}}", f"{{\"foo\": [1,4], \"bar\": [1]}}", f"{{\"bar\": [1]}}"]
    )

test "jq.test 1033: del(.[1], .[-6], .[2], .[-3:9])"
