    )

test "jq.test 1094: def inc(x): x |= .+1; inc(.[].a)"
    assert passes(
        program: "def inc(x): x |= .+1; inc(.[].a)",
        input: f"[{{\"a\":1,\"b\":2}},{{\"a\":2,\"b\":4}},{{\"a\":7,\"b\":8}}]",
        expected: [f"[{{\"a\":2,\"b\":2}},{{\"a\":3,\"b\":4}},{{\"a\":8,\"b\":8}}]"]
