    assert passes(program: f"(.[{{}}] = 0)?", input: "null", expected: expected)

test "jq.test 1732: INDEX(range(5)|[., 'foo/(.)']; .[0])"
    assert passes(
        program: "INDEX(range(5)|[., \"foo\\(.)\"]; .[0])",
        input: "null",
        expected: [f"{{\"0\":[0,\"foo0\"],\"1\":[1,\"foo1\"],\"2\":[2,\"foo2\"],\"3\":[3,\"foo3\"],\"4\":[4,\"foo4\"]}}"]
    )

test "jq.test 1736: JOIN(('0':[0,'abc'],'1':[1,'bcd'],'2':[2,'def'],'3':[3,'e..."
    assert passes(
        program: f"JOIN({{\"0\":[0,\"abc\"],\"1\":[1,\"bcd\"],\"2\":[2,\"def\"],\"3\":[3,\"efg\"],\"4\":[4,\"fgh\"]}}; .[0]|tostring)",
        input: "[[5,\"foo\"],[3,\"bar\"],[1,\"foobar\"]]",
        expected: ["[[[5,\"foo\"],null],[[3,\"bar\"],[3,\"efg\"]],[[1,\"foobar\"],[1,\"bcd\"]]]"]
    )

test "jq.test 1740: range(5;10)|IN(range(10))"
    assert passes(
        program: "range(5;10)|IN(range(10))",
        input: "null",
        expected: ["true", "true", "true", "true", "true"]
    )

test "jq.test 1748: range(5;13)|IN(range(0;10;3))"
    assert passes(
        program: "range(5;13)|IN(range(0;10;3))",
        input: "null",
        expected: ["false", "true", "false", "false", "true", "false", "false", "false"]
    )

test "jq.test 1759: range(10;12)|IN(range(10))"
    assert passes(program: "range(10;12)|IN(range(10))", input: "null", expected: ["false", "false"])

test "jq.test 1764: IN(range(10;20); range(10))"
    assert passes(program: "IN(range(10;20); range(10))", input: "null", expected: ["false"])

test "jq.test 1768: IN(range(5;20); range(10))"
    assert passes(program: "IN(range(5;20); range(10))", input: "null", expected: ["true"])

test "jq.test 1773: (.a as $x | .b) = 'b'"
    assert passes(
        program: "(.a as $x | .b) = \"b\"",
        input: f"{{\"a\":null,\"b\":null}}",
        expected: [f"{{\"a\":null,\"b\":\"b\"}}"]
    )

test "jq.test 1778: (.. | select(type == 'object' and has('b') and (.b | type..."
    assert passes(
        program: "(.. | select(type == \"object\" and has(\"b\") and (.b | type) == \"array\")|.b) |= .[0]",
        input: f"{{\"a\": {{\"b\": [1, {{\"b\": 3}}]}}}}",
        expected: [f"{{\"a\": {{\"b\": 1}}}}"]
    )

test "jq.test 1782: isempty(empty)"
    assert passes(program: "isempty(empty)", input: "null", expected: ["true"])

test "jq.test 1786: isempty(range(3))"
    assert passes(program: "isempty(range(3))", input: "null", expected: ["false"])

test "jq.test 1790: isempty(1,error('foo'))"
    assert passes(program: "isempty(1,error(\"foo\"))", input: "null", expected: ["false"])

test "jq.test 1795: index('')"
    assert passes(program: "index(\"\")", input: "\"\"", expected: ["null"])

test "jq.test 1800: builtins|length > 10"
    assert passes(program: "builtins|length > 10", input: "null", expected: ["true"])

test "jq.test 1804: '-1'|IN(builtins[] / '/'|.[1])"
    assert passes(program: "\"-1\"|IN(builtins[] / \"/\"|.[1])", input: "null", expected: ["false"])

test "jq.test 1808: all(builtins[] / '/'; .[1]|tonumber >= 0)"
    assert passes(program: "all(builtins[] / \"/\"; .[1]|tonumber >= 0)", input: "null", expected: ["true"])

test "jq.test 1812: builtins|any(.[:1] == '_')"
    assert passes(program: "builtins|any(.[:1] == \"_\")", input: "null", expected: ["false"])

test "jq.test 1833: map(. == 1)"
    assert passes(
        program: "map(. == 1)",
        input: "[1, 1.0, 1.000, 100e-2, 1e+0, 0.0001e4]",
        expected: ["[true, true, true, true, true, true]"]
    )

test "jq.test 1854: . - 10"
    assert passes(program: ". - 10", input: "13911860366432393", expected: ["13911860366432382"])

test "jq.test 1858: .[0] - 10"
    assert passes(program: ".[0] - 10", input: "[13911860366432393]", expected: ["13911860366432382"])

test "jq.test 1862: .x - 10"
    assert passes(program: ".x - 10", input: f"{{\"x\":13911860366432393}}", expected: ["13911860366432382"])

test "jq.test 1866: . |= try . catch ."
    assert passes(program: ". |= try . catch .", input: "1", expected: ["1"])

test "jq.test 1871: .[] as $n | $n+0 | [., tostring, . == $n]"
    assert passes(
        program: ".[] as $n | $n+0 | [., tostring, . == $n]",
        input: "[-9007199254740993, -9007199254740992, 9007199254740992, 9007199254740993, 13911860366432393]",
        expected: ["[-9007199254740992,\"-9007199254740992\",true]", "[-9007199254740992,\"-9007199254740992\",true]", "[9007199254740992,\"9007199254740992\",true]", "[9007199254740992,\"9007199254740992\",true]", "[13911860366432392,\"13911860366432392\",true]"]
    )

test "jq.test 1880: abs"
    assert passes(program: "abs", input: "\"abc\"", expected: ["\"abc\""])

test "jq.test 1884: map(abs)"
    assert passes(program: "map(abs)", input: "[-0, 0, -10, -1.1]", expected: ["[0,0,10,1.1]"])

test "jq.test 1888: map(fabs == length) | unique"
    assert passes(
        program: "map(fabs == length) | unique",
        input: "[-10, -1.1, -1e-1, 1000000000000000002]",
        expected: ["[true]"]
    )

test "jq.test 1893: map(abs)"
    assert passes(program: "map(abs)", input: "[0.1,1000000000000000002]", expected: ["[1e-1, 1000000000000000002]"])

test "jq.test 1899: 123 as $label | $label"
    assert passes(program: "123 as $label | $label", input: "null", expected: ["123"])

test "jq.test 1903: [ label $if | range(10) | ., (select(. == 5) | break $if) ]"
    assert passes(
        program: "[ label $if | range(10) | ., (select(. == 5) | break $if) ]",
        input: "null",
        expected: ["[0,1,2,3,4,5]"]
    )

test "jq.test 1907: reduce .[] as $then (4 as $else | $else; . as $elif | . +..."
    assert passes(
        program: "reduce .[] as $then (4 as $else | $else; . as $elif | . + $then * $elif)",
        input: "[1,2,3]",
        expected: ["96"]
    )

test "jq.test 1911: 1 as $foreach | 2 as $and | 3 as $or | ( $foreach, $and, ..."
    assert passes(
        program: f"1 as $foreach | 2 as $and | 3 as $or | {{ $foreach, $and, $or, a }}",
        input: f"{{\"a\":4,\"b\":5}}",
        expected: [f"{{\"foreach\":1,\"and\":2,\"or\":3,\"a\":4}}"]
    )

test "jq.test 1915: [ foreach .[] as $try (1 as $catch | $catch - 1; . + $try..."
    assert passes(
        program: "[ foreach .[] as $try (1 as $catch | $catch - 1; . + $try; .) ]",
        input: "[10,9,8,7]",
        expected: ["[10,19,27,34]"]
    )

test "jq.test 1922: ( a, $__loc__, c )"
    assert passes(
        program: f"{{ a, $__loc__, c }}",
        input: f"{{\"a\":[1,2,3],\"b\":\"foo\",\"c\":{{\"hi\":\"hey\"}}}}",
        expected: [f"{{\"a\":[1,2,3],\"__loc__\":{{\"file\":\"<top-level>\",\"line\":1}},\"c\":{{\"hi\":\"hey\"}}}}"]
    )

test "jq.test 1926: 1 as $x | '2' as $y | '3' as $z | ( $x, as, $y: 4, ($z): ..."
    assert passes(
        program: f"1 as $x | \"2\" as $y | \"3\" as $z | {{ $x, as, $y: 4, ($z): 5, if: 6, foo: 7 }}",
        input: f"{{\"as\":8}}",
        expected: [f"{{\"x\":1,\"as\":8,\"2\":4,\"3\":5,\"if\":6,\"foo\":7}}"]
    )

test "jq.test 1933: fromjson | isnan"
    assert passes(program: "fromjson | isnan", input: "\"nan\"", expected: ["true"])

test "jq.test 1937: tojson | fromjson"
    assert passes(program: "tojson | fromjson", input: f"{{\"a\":nan}}", expected: [f"{{\"a\":null}}"])

test "jq.test 1942: fromjson | isnan"
    assert passes(program: "fromjson | isnan", input: "\"nan1234\"", expected: ["true"])

test "jq.test 1953: debug"
    assert passes(program: "debug", input: "1", expected: ["1"])

test "jq.test 1958: 'foo' | try ((try . catch 'caught too much') | error) cat..."
    assert passes(
        program: "\"foo\" | try ((try . catch \"caught too much\") | error) catch \"caught just right\"",
        input: "null",
        expected: ["\"caught just right\""]
    )

test "jq.test 1962: .[]|(try (if .=='hi' then . else error end) catch empty) ..."
    assert passes(
        program: ".[]|(try (if .==\"hi\" then . else error end) catch empty) | \"\\(.) there!\"",
        input: "[\"hi\",\"ho\"]",
        expected: ["\"hi there!\""]
    )

test "jq.test 1966: try (['hi','ho']|.[]|(try . catch (if .=='ho' then 'BROKE..."
    assert passes(
        program: "try ([\"hi\",\"ho\"]|.[]|(try . catch (if .==\"ho\" then \"BROKEN\"|error else empty end)) | if .==\"ho\" then error else \"\\(.) there!\" end) catch \"caught outside \\(.)\"",
        input: "null",
        expected: ["\"hi there!\"", "\"caught outside ho\""]
    )

test "jq.test 1971: .[]|(try . catch (if .=='ho' then 'BROKEN'|error else emp..."
    assert passes(
        program: ".[]|(try . catch (if .==\"ho\" then \"BROKEN\"|error else empty end)) | if .==\"ho\" then error else \"\\(.) there!\" end",
        input: "[\"hi\",\"ho\"]",
        expected: ["\"hi there!\""]
    )

test "jq.test 1975: try (try error catch 'inner catch /(.)') catch 'outer cat..."
    assert passes(
        program: "try (try error catch \"inner catch \\(.)\") catch \"outer catch \\(.)\"",
        input: "\"foo\"",
        expected: ["\"inner catch foo\""]
    )

test "jq.test 1979: try ((try error catch 'inner catch /(.)')|error) catch 'o..."
    assert passes(
        program: "try ((try error catch \"inner catch \\(.)\")|error) catch \"outer catch \\(.)\"",
        input: "\"foo\"",
        expected: ["\"outer catch inner catch foo\""]
    )

test "jq.test 1984: first(.?,.?)"
    assert passes(program: "first(.?,.?)", input: "null", expected: ["null"])

test "jq.test 1989: (foo: 'bar') | .foo |= .?"
    assert passes(program: f"{{foo: \"bar\"}} | .foo |= .?", input: "null", expected: [f"{{\"foo\": \"bar\"}}"])

test "jq.test 1994: . |= try 2"
    assert passes(program: ". |= try 2", input: "1", expected: ["2"])

test "jq.test 1998: . |= try 2 catch 3"
    assert passes(program: ". |= try 2 catch 3", input: "1", expected: ["2"])

test "jq.test 2002: .[] |= try tonumber"
    assert passes(program: ".[] |= try tonumber", input: "[\"1\", \"2a\", \"3\", 4]", expected: ["[1, 3, 4]"])

test "jq.test 2007: any(keys[]|tostring?;true)"
    assert passes(
        program: "any(keys[]|tostring?;true)",
        input: f"{{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}}",
        expected: ["true"]
    )

test "jq.test 2015: implode|explode"
    assert passes(
        program: "implode|explode",
        input: "[-1,0,1,2,3,1114111,1114112,55295,55296,57343,57344,1.1,1.9]",
        expected: ["[65533,0,1,2,3,1114111,65533,55295,65533,65533,57344,1,1]"]
    )

test "jq.test 2019: map(try implode catch .)"
    assert passes(
        program: "map(try implode catch .)",
        input: "[123,[\"a\"],[nan]]",
        expected: ["[\"implode input must be an array\",\"string (\\\"a\\\") can't be imploded, unicode codepoint needs to be numeric\",\"number (null) can't be imploded, unicode codepoint needs to be numeric\"]"]
    )

test "jq.test 2024: walk(.)"
    assert passes(program: "walk(.)", input: f"{{\"x\":0}}", expected: [f"{{\"x\":0}}"])

test "jq.test 2028: walk(1)"
    assert passes(program: "walk(1)", input: f"{{\"x\":0}}", expected: ["1"])

test "jq.test 2033: [walk(.,1)]"
    assert passes(program: "[walk(.,1)]", input: f"{{\"x\":0}}", expected: [f"[{{\"x\":0}},1]"])

test "jq.test 2038: walk(select(IN((), []) | not))"
    assert passes(
        program: f"walk(select(IN({{}}, []) | not))",
        input: f"{{\"a\":1,\"b\":[]}}",
        expected: [f"{{\"a\":1}}"]
    )

test "jq.test 2043: [range(10)] | .[1.2:3.5]"
    assert passes(program: "[range(10)] | .[1.2:3.5]", input: "null", expected: ["[1,2,3]"])

test "jq.test 2047: [range(10)] | .[1.5:3.5]"
    assert passes(program: "[range(10)] | .[1.5:3.5]", input: "null", expected: ["[1,2,3]"])

test "jq.test 2051: [range(10)] | .[1.7:3.5]"
    assert passes(program: "[range(10)] | .[1.7:3.5]", input: "null", expected: ["[1,2,3]"])

test "jq.test 2055: [range(10)] | .[1.7:4294967295]"
    assert passes(program: "[range(10)] | .[1.7:4294967295]", input: "null", expected: ["[1,2,3,4,5,6,7,8,9]"])

test "jq.test 2059: [range(10)] | .[1.7:-4294967296]"
    assert passes(program: "[range(10)] | .[1.7:-4294967296]", input: "null", expected: ["[]"])

test "jq.test 2063: [[range(10)] | .[1.1,1.5,1.7]]"
    assert passes(program: "[[range(10)] | .[1.1,1.5,1.7]]", input: "null", expected: ["[1,1,1]"])

test "jq.test 2067: [range(5)] | .[1.1] = 5"
    assert passes(program: "[range(5)] | .[1.1] = 5", input: "null", expected: ["[0,5,2,3,4]"])

test "jq.test 2071: [range(3)] | .[nan:1]"
    assert passes(program: "[range(3)] | .[nan:1]", input: "null", expected: ["[0]"])

test "jq.test 2075: [range(3)] | .[1:nan]"
    assert passes(program: "[range(3)] | .[1:nan]", input: "null", expected: ["[1,2]"])

test "jq.test 2079: [range(3)] | .[nan]"
    assert passes(program: "[range(3)] | .[nan]", input: "null", expected: ["null"])

test "jq.test 2083: try ([range(3)] | .[nan] = 9) catch ."
    assert passes(
        program: "try ([range(3)] | .[nan] = 9) catch .",
        input: "null",
        expected: ["\"Cannot set array element at NaN index\""]
    )

test "jq.test 2087: try ('foobar' | .[1.5:3.5] = 'xyz') catch ."
    assert passes(
        program: "try (\"foobar\" | .[1.5:3.5] = \"xyz\") catch .",
        input: "null",
        expected: ["\"Cannot update string slices\""]
    )

test "jq.test 2091: try ([range(10)] | .[1.5:3.5] = ['xyz']) catch ."
    assert passes(
        program: "try ([range(10)] | .[1.5:3.5] = [\"xyz\"]) catch .",
        input: "null",
        expected: ["[0,\"xyz\",4,5,6,7,8,9]"]
    )

test "jq.test 2095: try ('foobar' | .[1.5]) catch ."
    assert passes(
        program: "try (\"foobar\" | .[1.5]) catch .",
        input: "null",
        expected: ["\"Cannot index string with number\""]
    )

test "jq.test 2102: try ['ok', setpath([1]; 1)] catch ['ko', .]"
    assert passes(
        program: "try [\"ok\", setpath([1]; 1)] catch [\"ko\", .]",
        input: f"{{\"hi\":\"hello\"}}",
        expected: ["[\"ko\",\"Cannot index object with number\"]"]
    )

test "jq.test 2109: try ltrimstr(1) catch 'x', try rtrimstr(1) catch 'x' | 'ok'"
    assert passes(
        program: "try ltrimstr(1) catch \"x\", try rtrimstr(1) catch \"x\" | \"ok\"",
        input: "\"hi\"",
        expected: ["\"ok\"", "\"ok\""]
    )

test "jq.test 2114: try ltrimstr('x') catch 'x', try rtrimstr('x') catch 'x' ..."
    assert passes(
        program: "try ltrimstr(\"x\") catch \"x\", try rtrimstr(\"x\") catch \"x\" | \"ok\"",
        input: f"{{\"hey\":[]}}",
        expected: ["\"ok\"", "\"ok\""]
    )
