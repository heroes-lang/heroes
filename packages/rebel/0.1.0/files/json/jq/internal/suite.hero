test "jq.test 1050: pick(first|first)"
    assert passes(program: "pick(first|first)", input: "[[10,20],30]", expected: ["[[10]]"])

test "jq.test 1055: try pick(last) catch ."
    assert passes(
        program: "try pick(last) catch .",
        input: "[1,2]",
