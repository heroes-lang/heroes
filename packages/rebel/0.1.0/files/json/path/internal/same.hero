# Two values compared as JSON compares them, on a stack this module holds:
# numbers by value, texts by bytes, lists element by element, objects member
# by member whatever their order. The language's `==` says the same but
# follows the nesting with recursion, which a value built deep enough would
# run out of stack on.

use json
use json/path/internal/stack

# Whether `a` and `b` are the same JSON value.
function equal(a: json.Value, b: json.Value) -> bool
    lefts: [json.Value] @= [a]
    rights: [json.Value] @= [b]
    top: i64 @= 1

    while top > 0
        top @ top - 1
        left = lefts[top]
        right = rights[top]

        match left
            .null_value =>
                if !json.is_null(right)
                    return false
            .boolean l =>
                match right
                    .boolean r =>
                        if l.v != r.v
                            return false
                    .null_value | .number _ | .text _ | .list _ | .object _ => return false
            .number l =>
                match right
                    .number r =>
                        if l.v != r.v
                            return false
                    .null_value | .boolean _ | .text _ | .list _ | .object _ => return false
            .text l =>
                match right
                    .text r =>
                        if l.v != r.v
                            return false
                    .null_value | .boolean _ | .number _ | .list _ | .object _ => return false
            .list l =>
                match right
                    .list r =>
                        if l.items.len() != r.items.len()
                            return false

                        for at in range(from: 0, to: l.items.len())
                            stack.put(items: @lefts, top: top, item: l.items[at])
                            stack.put(items: @rights, top: top, item: r.items[at])
                            top @ top + 1
                    .null_value | .boolean _ | .number _ | .text _ | .object _ => return false
            .object l =>
                match right
                    .object r =>
                        names = keys(l.members)

                        if names.len() != keys(r.members).len()
                            return false

                        for name in names
                            match r.members[name]
                                .err _ => return false
                                .ok found =>
                                    stack.put(items: @lefts, top: top, item: l.members[name].must())
                                    stack.put(items: @rights, top: top, item: found)
                                    top @ top + 1
                    .null_value | .boolean _ | .number _ | .text _ | .list _ => return false

    return true

## Tests

test "equal: each kind, a number written two ways, and members in another order"
    assert equal(a: .null_value, b: .null_value)
    assert !equal(a: .null_value, b: .boolean(v: false))
    assert equal(a: json.parse("1").must(), b: json.parse("1.0").must())
    assert !equal(a: .number(v: 1.0), b: .text(v: "1"))
    assert equal(a: json.parse("{\"a\":1,\"b\":[2,{}]}").must(), b: json.parse("{\"b\":[2,{}],\"a\":1}").must())
    assert !equal(a: json.parse("{\"a\":1}").must(), b: json.parse("{\"a\":1,\"b\":2}").must())
    assert !equal(a: json.parse("{\"a\":1}").must(), b: json.parse("{\"b\":1}").must())
    assert !equal(a: json.parse("[1,2]").must(), b: json.parse("[2,1]").must())
    assert equal(a: .text(v: "città"), b: .text(v: "città"))

test "equal: two lists nested a hundred thousand deep"
    a: json.Value @= .null_value
    b: json.Value @= .null_value

    for _ in range(from: 0, to: 100000)
        a @ .list(items: [a])
        b @ .list(items: [b])

    assert equal(a: a, b: b)
    assert !equal(a: a, b: .list(items: [b]))
