    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"examples\":[{\"type\":\"string\"}],\"$ref\":\"#/examples/0\"}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":\"a string\",\"valid\":true},{\"description\":\"mismatch\",\"data\":42,\"valid\":false}]") == ""

test "optional/non-schemas 12: reference of an arbitrary keyword of a sub-schema with encoded ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{\"unknown/keyword\":{\"type\":\"integer\"}},\"bar\":{\"$ref\":\"#/properties/foo/unknown~1keyword\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":{\"bar\":3},\"valid\":true},{\"description\":\"mismatch\",\"data\":{\"bar\":true},\"valid\":false}]") == ""
