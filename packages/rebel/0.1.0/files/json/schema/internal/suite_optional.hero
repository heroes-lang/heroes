# The JSON Schema Test Suite (github.com/json-schema-org/JSON-Schema-Test-Suite,
# commit e2a68a15 of 2026-11-16, its `validation/tests` as fetched on
# 2026-11-17): every case its `compatibility` gives to draft 7 or to 2020-12
# among `optional/bignum.json`, `optional/content.json`, `optional/cross-draft.json` and the rest of its group,
# each run under each dialect it is given to. A case tagged
# `format-assertion` is run with formats asserted. Each is a test; nothing
# else here is compiled into a program.

use json/schema/internal/suite

# How many of the suite's cases this module holds.
constant CASES: i64
    70

test "optional/bignum 0: integer"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"integer\"}", externals: "{}", tests: "[{\"description\":\"a bignum is an integer\",\"data\":12345678910111213141516171819202122232425262728293031,\"valid\":true},{\"description\":\"a negative bignum is an integer\",\"data\":-12345678910111213141516171819202122232425262728293031,\"valid\":true}]") == ""

test "optional/bignum 1: number"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"number\"}", externals: "{}", tests: "[{\"description\":\"a bignum is a number\",\"data\":98249283749234923498293171823948729348710298301928331,\"valid\":true},{\"description\":\"a negative bignum is a number\",\"data\":-98249283749234923498293171823948729348710298301928331,\"valid\":true}]") == ""

test "optional/bignum 2: string"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\"}", externals: "{}", tests: "[{\"description\":\"a bignum is not a string\",\"data\":98249283749234923498293171823948729348710298301928331,\"valid\":false}]") == ""

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 3: maximum integer comparison"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maximum\":18446744073709551615}", externals: "{}", tests: "[{\"description\":\"comparison works for high numbers\",\"data\":18446744073709551600,\"valid\":true},{\"description\":\"just above the maximum is invalid\",\"data\":18446744073709551616,\"valid\":false}]") == "7: just above the maximum is invalid; 2020: just above the maximum is invalid"

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 5: float comparison with high precision"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"exclusiveMaximum\":9.727837981879871e+26}", externals: "{}", tests: "[{\"description\":\"below the exclusive maximum is valid\",\"data\":9.727837981879871e+26,\"valid\":true},{\"description\":\"comparison works for high numbers\",\"data\":9.727837981879871e+26,\"valid\":false}]") == "7: below the exclusive maximum is valid; 2020: below the exclusive maximum is valid"

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 6: minimum integer comparison"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minimum\":-18446744073709551615}", externals: "{}", tests: "[{\"description\":\"comparison works for very negative numbers\",\"data\":-18446744073709551600,\"valid\":true},{\"description\":\"just below the minimum is invalid\",\"data\":-18446744073709551616,\"valid\":false}]") == "7: just below the minimum is invalid; 2020: just below the minimum is invalid"

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 8: float comparison with high precision on negative numbers"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"exclusiveMinimum\":-9.727837981879871e+26}", externals: "{}", tests: "[{\"description\":\"above the exclusive minimum is valid\",\"data\":-9.727837981879871e+26,\"valid\":true},{\"description\":\"comparison works for very negative numbers\",\"data\":-9.727837981879871e+26,\"valid\":false}]") == "7: above the exclusive minimum is valid; 2020: above the exclusive minimum is valid"

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 9: enum comparison with high precision"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"enum\":[0.12345678912345678]}", externals: "{}", tests: "[{\"description\":\"the exact decimal is valid\",\"data\":0.12345678912345678,\"valid\":true},{\"description\":\"a slightly smaller decimal is invalid\",\"data\":0.12345678912345678,\"valid\":false},{\"description\":\"a slightly larger decimal is invalid\",\"data\":0.12345678912345678,\"valid\":false}]") == "7: a slightly smaller decimal is invalid; 7: a slightly larger decimal is invalid; 2020: a slightly smaller decimal is invalid; 2020: a slightly larger decimal is invalid"

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 10: const comparison with high precision"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":0.12345678912345678}", externals: "{}", tests: "[{\"description\":\"the exact decimal is valid\",\"data\":0.12345678912345678,\"valid\":true},{\"description\":\"a slightly smaller decimal is invalid\",\"data\":0.12345678912345678,\"valid\":false},{\"description\":\"a slightly larger decimal is invalid\",\"data\":0.12345678912345678,\"valid\":false}]") == "7: a slightly smaller decimal is invalid; 7: a slightly larger decimal is invalid; 2020: a slightly smaller decimal is invalid; 2020: a slightly larger decimal is invalid"

test "optional/bignum 11: all integers are multiples of 0.5, if overflow is handled"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"number\",\"multipleOf\":0.5}", externals: "{}", tests: "[{\"description\":\"valid if optional overflow handling is implemented\",\"data\":1e+308,\"valid\":true}]") == ""

# Answered otherwise than the suite on purpose: a number is an f64 here, as `json` reads it, so an integer past 2^53 or a decimal of more than seventeen digits compares as its nearest f64.
test "optional/bignum 12: uniqueItems comparison with high precision"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"uniqueItems\":true}", externals: "{}", tests: "[{\"description\":\"distinct high-precision decimals are unique\",\"data\":[0.12345678912345678,0.12345678912345678],\"valid\":true},{\"description\":\"the same high-precision decimal is not unique\",\"data\":[0.12345678912345678,0.12345678912345678],\"valid\":false},{\"description\":\"trailing zeroes do not make decimals unique\",\"data\":[0.12345678912345678,0.12345678912345678],\"valid\":false},{\"description\":\"arrays containing distinct decimals are unique\",\"data\":[[0.12345678912345678],[0.12345678912345678]],\"valid\":true},{\"description\":\"arrays containing the same decimal are not unique\",\"data\":[[0.12345678912345678],[0.12345678912345678]],\"valid\":false},{\"description\":\"objects containing distinct decimals are unique\",\"data\":[{\"value\":0.12345678912345678},{\"value\":0.12345678912345678}],\"valid\":true},{\"description\":\"objects containing the same decimal are not unique\",\"data\":[{\"value\":0.12345678912345678},{\"value\":0.12345678912345678}],\"valid\":false}]") == "7: distinct high-precision decimals are unique; 7: arrays containing distinct decimals are unique; 7: objects containing distinct decimals are unique; 2020: distinct high-precision decimals are unique; 2020: arrays containing distinct decimals are unique; 2020: objects containing distinct decimals are unique"

test "optional/bignum 13: multipleOf with integers above 2^53"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"multipleOf\":3}", externals: "{}", tests: "[{\"description\":\"3e20 is multiple of 3\",\"data\":300000000000000000000,\"valid\":true},{\"description\":\"1e20 is not multiple of 3\",\"data\":100000000000000000000,\"valid\":false}]") == ""

test "optional/content 0: validation of string-encoded content based on media type"
    assert suite.failures(dialects: [7], asserting: false, content: true, schema: "{\"contentMediaType\":\"application/json\"}", externals: "{}", tests: "[{\"description\":\"a valid JSON document\",\"data\":\"{\\\"foo\\\": \\\"bar\\\"}\",\"valid\":true},{\"description\":\"an invalid JSON document\",\"data\":\"{:}\",\"valid\":false},{\"description\":\"ignores non-strings\",\"data\":100,\"valid\":true}]") == ""

test "optional/content 1: validation of binary string-encoding"
    assert suite.failures(dialects: [7], asserting: false, content: true, schema: "{\"contentEncoding\":\"base64\"}", externals: "{}", tests: "[{\"description\":\"a valid base64 string\",\"data\":\"eyJmb28iOiAiYmFyIn0K\",\"valid\":true},{\"description\":\"an invalid base64 string (% is not a valid character)\",\"data\":\"eyJmb28iOi%iYmFyIn0K\",\"valid\":false},{\"description\":\"ignores non-strings\",\"data\":100,\"valid\":true}]") == ""

test "optional/content 2: validation of binary-encoded media type documents"
    assert suite.failures(dialects: [7], asserting: false, content: true, schema: "{\"contentMediaType\":\"application/json\",\"contentEncoding\":\"base64\"}", externals: "{}", tests: "[{\"description\":\"a valid base64-encoded JSON document\",\"data\":\"eyJmb28iOiAiYmFyIn0K\",\"valid\":true},{\"description\":\"a validly-encoded invalid JSON document\",\"data\":\"ezp9Cg==\",\"valid\":false},{\"description\":\"an invalid base64 string that is valid JSON\",\"data\":\"{}\",\"valid\":false},{\"description\":\"ignores non-strings\",\"data\":100,\"valid\":true}]") == ""

# Answered otherwise than the suite on purpose: 2019-09 is a dialect this package does not read, so the schema is refused, `unsupported`.
test "optional/cross-draft 0: refs to future drafts are processed as future drafts (2019)"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"type\":\"object\",\"allOf\":[{\"properties\":{\"foo\":true}},{\"$ref\":\"http://localhost:1234/draft2019-09/dependentRequired.json\"}]}", externals: "{\"http://localhost:1234/draft2019-09/dependentRequired.json\":{\"$schema\":\"https://json-schema.org/draft/2019-09/schema\",\"dependentRequired\":{\"foo\":[\"bar\"]}}}", tests: "[{\"description\":\"missing bar is invalid\",\"data\":{\"foo\":\"any value\"},\"valid\":false},{\"description\":\"present bar is valid\",\"data\":{\"foo\":\"any value\",\"bar\":\"also any value\"},\"valid\":true}]") == "7: the schema does not compile: unsupported: the dialect \"https://json-schema.org/draft/2019-09/schema\": this package reads draft 7 and 2020-12"

test "optional/cross-draft 1: refs to future drafts are processed as future drafts (2020)"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"type\":\"array\",\"$ref\":\"http://localhost:1234/draft2020-12/prefixItems.json\"}", externals: "{\"http://localhost:1234/draft2020-12/prefixItems.json\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"prefixItems\":[{\"type\":\"string\"}]}}", tests: "[{\"description\":\"first item not a string is invalid\",\"data\":[1,2,3],\"valid\":false},{\"description\":\"first item is a string is valid\",\"data\":[\"a string\",1,2,3],\"valid\":true}]") == ""

test "optional/cross-draft 2: refs to historic drafts are processed as historic drafts (7)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"type\":\"object\",\"allOf\":[{\"properties\":{\"foo\":true}},{\"$ref\":\"http://localhost:1234/draft7/ignore-dependentRequired.json\"}]}", externals: "{\"http://localhost:1234/draft7/ignore-dependentRequired.json\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"dependentRequired\":{\"foo\":[\"bar\"]}}}", tests: "[{\"description\":\"missing bar is valid\",\"data\":{\"foo\":\"any value\"},\"valid\":true}]") == ""

# Answered otherwise than the suite on purpose: 2019-09 is a dialect this package does not read, so the schema is refused, `unsupported`.
test "optional/cross-draft 3: refs to historic drafts are processed as historic drafts (2019)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"type\":\"array\",\"$ref\":\"http://localhost:1234/draft2019-09/ignore-prefixItems.json\"}", externals: "{\"http://localhost:1234/draft2019-09/ignore-prefixItems.json\":{\"$schema\":\"https://json-schema.org/draft/2019-09/schema\",\"prefixItems\":[{\"type\":\"string\"}]}}", tests: "[{\"description\":\"first item not a string is valid\",\"data\":[1,2,3],\"valid\":true}]") == "2020: the schema does not compile: unsupported: the dialect \"https://json-schema.org/draft/2019-09/schema\": this package reads draft 7 and 2020-12"

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 0: single dependency"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"bar\":[\"foo\"]}}", externals: "{}", tests: "[{\"description\":\"neither\",\"data\":{},\"valid\":true},{\"description\":\"nondependant\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"with dependency\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"missing dependency\",\"data\":{\"bar\":2},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[\"bar\"],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"foobar\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true}]") == "2020: missing dependency"

test "optional/dependencies-compatibility 1: empty dependents"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"bar\":[]}}", externals: "{}", tests: "[{\"description\":\"empty object\",\"data\":{},\"valid\":true},{\"description\":\"object with one property\",\"data\":{\"bar\":2},\"valid\":true},{\"description\":\"non-object is valid\",\"data\":1,\"valid\":true}]") == ""

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 2: multiple dependents required"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"quux\":[\"foo\",\"bar\"]}}", externals: "{}", tests: "[{\"description\":\"neither\",\"data\":{},\"valid\":true},{\"description\":\"nondependants\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"with dependencies\",\"data\":{\"foo\":1,\"bar\":2,\"quux\":3},\"valid\":true},{\"description\":\"missing dependency\",\"data\":{\"foo\":1,\"quux\":2},\"valid\":false},{\"description\":\"missing other dependency\",\"data\":{\"bar\":1,\"quux\":2},\"valid\":false},{\"description\":\"missing both dependencies\",\"data\":{\"quux\":1},\"valid\":false}]") == "2020: missing dependency; 2020: missing other dependency; 2020: missing both dependencies"

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 3: dependencies with escaped characters"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"foo\\nbar\":[\"foo\\rbar\"],\"foo\\\"bar\":[\"foo'bar\"]}}", externals: "{}", tests: "[{\"description\":\"CRLF\",\"data\":{\"foo\\nbar\":1,\"foo\\rbar\":2},\"valid\":true},{\"description\":\"quoted quotes\",\"data\":{\"foo'bar\":1,\"foo\\\"bar\":2},\"valid\":true},{\"description\":\"CRLF missing dependent\",\"data\":{\"foo\\nbar\":1,\"foo\":2},\"valid\":false},{\"description\":\"quoted quotes missing dependent\",\"data\":{\"foo\\\"bar\":2},\"valid\":false}]") == "2020: CRLF missing dependent; 2020: quoted quotes missing dependent"

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 4: single schema dependency"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"bar\":{\"properties\":{\"foo\":{\"type\":\"integer\"},\"bar\":{\"type\":\"integer\"}}}}}", externals: "{}", tests: "[{\"description\":\"valid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"no dependency\",\"data\":{\"foo\":\"quux\"},\"valid\":true},{\"description\":\"wrong type\",\"data\":{\"foo\":\"quux\",\"bar\":2},\"valid\":false},{\"description\":\"wrong type other\",\"data\":{\"foo\":2,\"bar\":\"quux\"},\"valid\":false},{\"description\":\"wrong type both\",\"data\":{\"foo\":\"quux\",\"bar\":\"quux\"},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[\"bar\"],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"foobar\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true}]") == "2020: wrong type; 2020: wrong type other; 2020: wrong type both"

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 5: boolean subschemas"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"foo\":true,\"bar\":false}}", externals: "{}", tests: "[{\"description\":\"object with property having schema true is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"object with property having schema false is invalid\",\"data\":{\"bar\":2},\"valid\":false},{\"description\":\"object with both properties is invalid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":false},{\"description\":\"empty object is valid\",\"data\":{},\"valid\":true}]") == "2020: object with property having schema false is invalid; 2020: object with both properties is invalid"

# Answered otherwise than the suite on purpose: `dependencies` is draft 7's keyword, which 2020-12 split in two, `dependentRequired` and `dependentSchemas`; a 2020-12 schema writing it writes an unknown keyword, as the dialect says.
test "optional/dependencies-compatibility 6: schema dependencies with escaped characters"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"dependencies\":{\"foo\\tbar\":{\"minProperties\":4},\"foo'bar\":{\"required\":[\"foo\\\"bar\"]}}}", externals: "{}", tests: "[{\"description\":\"quoted tab\",\"data\":{\"foo\\tbar\":1,\"a\":2,\"b\":3,\"c\":4},\"valid\":true},{\"description\":\"quoted quote\",\"data\":{\"foo'bar\":{\"foo\\\"bar\":1}},\"valid\":false},{\"description\":\"quoted tab invalid under dependent schema\",\"data\":{\"foo\\tbar\":1,\"a\":2},\"valid\":false},{\"description\":\"quoted quote invalid under dependent schema\",\"data\":{\"foo'bar\":1},\"valid\":false}]") == "2020: quoted quote; 2020: quoted tab invalid under dependent schema; 2020: quoted quote invalid under dependent schema"

test "optional/dynamicRef 1: $dynamicRef skips over intermediate resources - pointer reference across resource boundary (2020)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/optional/main\",\"type\":\"object\",\"properties\":{\"bar-item\":{\"$ref\":\"bar#/$defs/item\"}},\"$defs\":{\"bar\":{\"$id\":\"bar\",\"type\":\"array\",\"items\":{\"$ref\":\"item\"},\"$defs\":{\"item\":{\"$id\":\"item\",\"type\":\"object\",\"properties\":{\"content\":{\"$dynamicRef\":\"#content\"}},\"$defs\":{\"defaultContent\":{\"$dynamicAnchor\":\"content\",\"type\":\"integer\"}}},\"content\":{\"$dynamicAnchor\":\"content\",\"type\":\"string\"}}}}}", externals: "{}", tests: "[{\"description\":\"integer property passes\",\"data\":{\"bar-item\":{\"content\":42}},\"valid\":true},{\"description\":\"string property fails\",\"data\":{\"bar-item\":{\"content\":\"value\"}},\"valid\":false}]") == ""

test "optional/ecmascript-regex 0: ECMA 262 regex $ does not match trailing newline"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^abc$\"}", externals: "{}", tests: "[{\"description\":\"matches in Python, but not in ECMA 262\",\"data\":\"abc\\\\n\",\"valid\":false},{\"description\":\"matches\",\"data\":\"abc\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 1: ECMA 262 regex converts \\t to horizontal tab"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\t$\"}", externals: "{}", tests: "[{\"description\":\"does not match\",\"data\":\"\\\\t\",\"valid\":false},{\"description\":\"matches\",\"data\":\"\\t\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 2: ECMA 262 regex escapes control codes with \\c and upper letter"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\cC$\"}", externals: "{}", tests: "[{\"description\":\"does not match\",\"data\":\"\\\\cC\",\"valid\":false},{\"description\":\"matches\",\"data\":\"\\u0003\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 3: ECMA 262 regex escapes control codes with \\c and lower letter"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\cc$\"}", externals: "{}", tests: "[{\"description\":\"does not match\",\"data\":\"\\\\cc\",\"valid\":false},{\"description\":\"matches\",\"data\":\"\\u0003\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 4: ECMA 262 \\d matches ascii digits only"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\d$\"}", externals: "{}", tests: "[{\"description\":\"ASCII zero matches\",\"data\":\"0\",\"valid\":true},{\"description\":\"NKO DIGIT ZERO does not match (unlike e.g. Python)\",\"data\":\"߀\",\"valid\":false},{\"description\":\"NKO DIGIT ZERO (as \\\\u escape) does not match\",\"data\":\"߀\",\"valid\":false}]") == ""

test "optional/ecmascript-regex 5: ECMA 262 \\D matches everything but ascii digits"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\D$\"}", externals: "{}", tests: "[{\"description\":\"ASCII zero does not match\",\"data\":\"0\",\"valid\":false},{\"description\":\"NKO DIGIT ZERO matches (unlike e.g. Python)\",\"data\":\"߀\",\"valid\":true},{\"description\":\"NKO DIGIT ZERO (as \\\\u escape) matches\",\"data\":\"߀\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 6: ECMA 262 \\w matches ascii letters only"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\w$\"}", externals: "{}", tests: "[{\"description\":\"ASCII 'a' matches\",\"data\":\"a\",\"valid\":true},{\"description\":\"latin-1 e-acute does not match (unlike e.g. Python)\",\"data\":\"é\",\"valid\":false}]") == ""

test "optional/ecmascript-regex 7: ECMA 262 \\W matches everything but ascii letters"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\W$\"}", externals: "{}", tests: "[{\"description\":\"ASCII 'a' does not match\",\"data\":\"a\",\"valid\":false},{\"description\":\"latin-1 e-acute matches (unlike e.g. Python)\",\"data\":\"é\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 8: ECMA 262 \\s matches whitespace"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\s$\"}", externals: "{}", tests: "[{\"description\":\"ASCII space matches\",\"data\":\" \",\"valid\":true},{\"description\":\"Character tabulation matches\",\"data\":\"\\t\",\"valid\":true},{\"description\":\"Line tabulation matches\",\"data\":\"\\u000b\",\"valid\":true},{\"description\":\"Form feed matches\",\"data\":\"\\f\",\"valid\":true},{\"description\":\"latin-1 non-breaking-space matches\",\"data\":\" \",\"valid\":true},{\"description\":\"zero-width whitespace matches\",\"data\":\"\\ufeff\",\"valid\":true},{\"description\":\"line feed matches (line terminator)\",\"data\":\"\\n\",\"valid\":true},{\"description\":\"paragraph separator matches (line terminator)\",\"data\":\"\\u2029\",\"valid\":true},{\"description\":\"EM SPACE matches (Space_Separator)\",\"data\":\" \",\"valid\":true},{\"description\":\"Non-whitespace control does not match\",\"data\":\"\\u0001\",\"valid\":false},{\"description\":\"Non-whitespace does not match\",\"data\":\"–\",\"valid\":false}]") == ""

test "optional/ecmascript-regex 9: ECMA 262 \\S matches everything but whitespace"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\S$\"}", externals: "{}", tests: "[{\"description\":\"ASCII space does not match\",\"data\":\" \",\"valid\":false},{\"description\":\"Character tabulation does not match\",\"data\":\"\\t\",\"valid\":false},{\"description\":\"Line tabulation does not match\",\"data\":\"\\u000b\",\"valid\":false},{\"description\":\"Form feed does not match\",\"data\":\"\\f\",\"valid\":false},{\"description\":\"latin-1 non-breaking-space does not match\",\"data\":\" \",\"valid\":false},{\"description\":\"zero-width whitespace does not match\",\"data\":\"\\ufeff\",\"valid\":false},{\"description\":\"line feed does not match (line terminator)\",\"data\":\"\\n\",\"valid\":false},{\"description\":\"paragraph separator does not match (line terminator)\",\"data\":\"\\u2029\",\"valid\":false},{\"description\":\"EM SPACE does not match (Space_Separator)\",\"data\":\" \",\"valid\":false},{\"description\":\"Non-whitespace control matches\",\"data\":\"\\u0001\",\"valid\":true},{\"description\":\"Non-whitespace matches\",\"data\":\"–\",\"valid\":true}]") == ""

test "optional/ecmascript-regex 10: patterns always use unicode semantics with pattern"
