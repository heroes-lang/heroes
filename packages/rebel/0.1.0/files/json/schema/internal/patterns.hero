# An ECMA-262 regular expression, the dialect `pattern` and
# `patternProperties` are written in, translated into the syntax `regex`
# reads: `\uXXXX` and `\u{...}` become `\x{...}`, `\s` and `.` take
# ECMAScript's characters, a Unicode property's long name becomes its short
# one, and a `{` that opens no count is a character. What `regex` cannot match
# in linear time, a look-around and a back-reference, is `unsupported`.

use numbers
use unicode

# The code of a text that is no ECMA-262 regular expression.
constant INVALID: str
    "invalid"

# The code of a regular expression `regex` does not read.
constant UNSUPPORTED: str
    "unsupported"

# ECMAScript's white space and line terminators, as the inside of a class.
constant SPACES: str
    "\\t\\n\\x{b}\\x{c}\\r \\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}\\x{feff}"

# The short name of a Unicode general category ECMAScript names long, or
# `""` where `name` is none.
function category_of(name: str) -> str
    longs = [
        "Letter"
        "Uppercase_Letter"
        "Lowercase_Letter"
        "Titlecase_Letter"
        "Modifier_Letter"
        "Other_Letter"
        "Mark"
        "Nonspacing_Mark"
        "Spacing_Mark"
        "Enclosing_Mark"
        "Number"
        "Decimal_Number"
        "digit"
        "Letter_Number"
        "Other_Number"
        "Punctuation"
        "punct"
        "Connector_Punctuation"
        "Dash_Punctuation"
        "Open_Punctuation"
        "Close_Punctuation"
        "Initial_Punctuation"
        "Final_Punctuation"
        "Other_Punctuation"
        "Symbol"
        "Math_Symbol"
        "Currency_Symbol"
        "Modifier_Symbol"
        "Other_Symbol"
        "Separator"
        "Space_Separator"
        "Line_Separator"
        "Paragraph_Separator"
        "Other"
        "Control"
        "cntrl"
        "Format"
        "Unassigned"
        "Private_Use"
        "Surrogate"
    ]
    shorts = [
        "L"
        "Lu"
        "Ll"
        "Lt"
        "Lm"
        "Lo"
        "M"
        "Mn"
        "Mc"
        "Me"
        "N"
        "Nd"
        "Nd"
        "Nl"
        "No"
        "P"
        "P"
        "Pc"
        "Pd"
        "Ps"
        "Pe"
        "Pi"
        "Pf"
        "Po"
        "S"
        "Sm"
        "Sc"
        "Sk"
        "So"
        "Z"
        "Zs"
        "Zl"
        "Zp"
        "C"
        "Cc"
        "Cc"
        "Cf"
        "Cn"
        "Co"
        "Cs"
    ]

    bare = if name.len() > 17 && name.slice(from: 0, to: 17) == "General_Category="
        name.slice(from: 17, to: name.len())
    else if name.len() > 3 && name.slice(from: 0, to: 3) == "gc="
        name.slice(from: 3, to: name.len())
    else
        name

    for at in range(from: 0, to: longs.len())
        if longs[at] == bare || shorts[at] == bare
            return shorts[at]

    return ""

# The value of the hexadecimal digits of `s`, or -1 where one is none.
function hex_value(s: str) -> i64
    if s.len() == 0 || s.len() > 6
        return -1
    return numbers.parse_int_base(s, base: 16).default(-1)

# A piece of a pattern translated: its text and the byte past it.
record Piece
    # The piece as `regex` reads it.
    text: str
    # The byte of the pattern past it.
    next: i64
    # Whether it is one character, which a class may take as a range's end;
    # its code point is `point`.
    single: bool
    # The code point of a piece that is one character.
    point: i64

# The character `point` as `regex` reads it, inside a class or out of one.
function written(point: i64) -> str
    return f"\\x{{{numbers.format_int(n: point, base: 16)}}}"

# The escape beginning with the backslash at byte `at`, inside a class where
# `in_class` says so.
function read_escape(p: str, at: i64, in_class: bool) -> Piece?
    if at + 1 >= p.len()
        return fail(code: INVALID, msg: "a pattern that ends with a backslash")
    e = p[at + 1]

    if e == 'd' || e == 'D' || e == 'w' || e == 'W'
        return ok(Piece(text: p.slice(from: at, to: at + 2), next: at + 2, single: false, point: 0))

    if e == 's'
        text = if in_class
            SPACES
        else
            "[" + SPACES + "]"
        return ok(Piece(text: text, next: at + 2, single: false, point: 0))

    if e == 'S'
        if in_class
            return fail(code: UNSUPPORTED, msg: "`\\S` inside a class")
        return ok(Piece(text: "[^" + SPACES + "]", next: at + 2, single: false, point: 0))

    if e == 'b' || e == 'B'
        if in_class && e == 'b'
            return ok(Piece(text: written(8), next: at + 2, single: true, point: 8))

        if in_class
            return fail(code: INVALID, msg: "`\\B` inside a class")
        return ok(Piece(text: p.slice(from: at, to: at + 2), next: at + 2, single: false, point: 0))
    shorts = "tnrfv"
    points = [9, 10, 13, 12, 11]

    for i in range(from: 0, to: 5)
        if e == shorts[i]
            return ok(Piece(text: written(points[i]), next: at + 2, single: true, point: points[i]))

    if e == '0' && !(at + 2 < p.len() && p[at + 2] >= '0' && p[at + 2] <= '9')
        return ok(Piece(text: written(0), next: at + 2, single: true, point: 0))

    if e >= '1' && e <= '9'
        return fail(code: UNSUPPORTED, msg: "a back-reference")

    if e == 'k'
        return fail(code: UNSUPPORTED, msg: "a back-reference by name")

    if e == 'c'
        if at + 2 < p.len() && (p[at + 2] >= 'a' && p[at + 2] <= 'z' || p[at + 2] >= 'A' && p[at + 2] <= 'Z')
            point = to_i64(p[at + 2]).must() % 32
            return ok(Piece(text: written(point), next: at + 3, single: true, point: point))
        return fail(code: INVALID, msg: "`\\c` with no letter after it")

    if e == 'x'
        value = if at + 4 <= p.len()
            hex_value(p.slice(from: at + 2, to: at + 4))
        else
            -1

        if value < 0
            return fail(code: INVALID, msg: "`\\x` with no two hexadecimal digits after it")
        return ok(Piece(text: written(value), next: at + 4, single: true, point: value))

    if e == 'u'
        if at + 2 < p.len() && p[at + 2] == '{'
            close: i64 @= at + 3

            while close < p.len() && p[close] != '}'
                close @ close + 1

            value = if close < p.len()
                hex_value(p.slice(from: at + 3, to: close))
            else
                -1

            if value < 0 || value > 0x10ffff
                return fail(code: INVALID, msg: "`\\u` with braces and no code point between them")
            return ok(Piece(text: written(value), next: close + 1, single: true, point: value))

        value = if at + 6 <= p.len()
            hex_value(p.slice(from: at + 2, to: at + 6))
        else
            -1

        if value < 0
            return fail(code: INVALID, msg: "`\\u` with no four hexadecimal digits after it")

        if value >= 0xd800 && value <= 0xdbff && at + 12 <= p.len() && p[at + 6] == '\\' && p[at + 7] == 'u'
            low = hex_value(p.slice(from: at + 8, to: at + 12))

            if low >= 0xdc00 && low <= 0xdfff
                point = 0x10000 + (value - 0xd800) * 0x400 + (low - 0xdc00)
                return ok(Piece(text: written(point), next: at + 12, single: true, point: point))

        if value >= 0xd800 && value <= 0xdfff
            return fail(code: UNSUPPORTED, msg: "half a surrogate pair")
        return ok(Piece(text: written(value), next: at + 6, single: true, point: value))

    if e == 'p' || e == 'P'
        if !(at + 2 < p.len() && p[at + 2] == '{')
            return fail(code: INVALID, msg: "`\\p` with no braces")
        close: i64 @= at + 3

        while close < p.len() && p[close] != '}'
            close @ close + 1

        if close >= p.len()
            return fail(code: INVALID, msg: "`\\p` with no closing brace")
        short = category_of(p.slice(from: at + 3, to: close))

        if short == ""
            return fail(code: UNSUPPORTED, msg: "a property `regex` does not read: a script or a binary property")
        return ok(
            Piece(text: f"\\{p.slice(from: at + 1, to: at + 2)}{{{short}}}", next: close + 1, single: false, point: 0)
        )

    if e < 0x80 && !(e >= 'a' && e <= 'z' || e >= 'A' && e <= 'Z' || e >= '0' && e <= '9')
        return ok(Piece(text: p.slice(from: at, to: at + 2), next: at + 2, single: true, point: to_i64(e).must()))
    return fail(code: INVALID, msg: f"no escape `\\{p.slice(from: at + 1, to: at + 2)}` in ECMAScript's patterns")

# The width of the character at byte `at`.
function width_at(p: str, at: i64) -> i64
    return unicode.utf8_len_of_first(p[at]).default(1)

# The class beginning with the `[` at byte `at`.
function read_class(p: str, at: i64) -> Piece?
    i: i64 @= at + 1
    pieces: [str] @= ["["]

    if i < p.len() && p[i] == '^'
        pieces @ pieces.push("^")
        i @ i + 1

    if i < p.len() && p[i] == ']'
        if pieces.len() == 2
            return ok(Piece(text: "(?s:.)", next: i + 1, single: false, point: 0))
        return fail(code: UNSUPPORTED, msg: "an empty class, which matches nothing")

    while true
        if i >= p.len()
            return fail(code: INVALID, msg: "a class with no `]`")

        if p[i] == ']'
            pieces @ pieces.push("]")
            return ok(Piece(text: pieces.join(""), next: i + 1, single: false, point: 0))
        low: Piece @= Piece(text: "", next: 0, single: false, point: 0)

        if p[i] == '\\'
            low @ read_escape(p, at: i, in_class: true)?
        else
            width = width_at(p, at: i)
            c = p.slice(from: i, to: i + width)
            point = unicode.code_point(c)

            text = if p[i] == '[' || p[i] == '-' || p[i] == '^' || point < 0x20
                written(point)
            else
                c
            low @ Piece(text: text, next: i + width, single: true, point: point)
        i @ low.next

        if low.single && i + 1 < p.len() && p[i] == '-' && p[i + 1] != ']'
            high: Piece @= Piece(text: "", next: 0, single: false, point: 0)

            if p[i + 1] == '\\'
                high @ read_escape(p, at: i + 1, in_class: true)?
            else
                width = width_at(p, at: i + 1)
                c = p.slice(from: i + 1, to: i + 1 + width)
                high @ Piece(
                    text: written(unicode.code_point(c)),
                    next: i + 1 + width,
                    single: true,
                    point: unicode.code_point(c)
                )

            if !high.single
                return fail(code: INVALID, msg: "a range that ends with a class")

            if high.point < low.point
                return fail(code: INVALID, msg: "a range whose end comes before its start")
            pieces @ pieces.push(written(low.point) + "-" + written(high.point))
            i @ high.next
        else
            pieces @ pieces.push(low.text)

    return fail(code: INVALID, msg: "unreachable")

# Whether a count `{n}`, `{n,}` or `{n,m}` begins at byte `at`, and where it
# ends, past its `}`; -1 where none does.
function count_end(p: str, at: i64) -> i64
    i: i64 @= at + 1
    digits: i64 @= 0

    while i < p.len() && p[i] >= '0' && p[i] <= '9'
        i @ i + 1
        digits @ digits + 1

    if digits == 0
        return -1

    if i < p.len() && p[i] == ','
        i @ i + 1

        while i < p.len() && p[i] >= '0' && p[i] <= '9'
            i @ i + 1

    if i < p.len() && p[i] == '}'
        return i + 1
    return -1

# `pattern` as `regex` reads it. Fails `invalid` where it is no ECMA-262
# pattern, and `unsupported` where it needs what `regex` does not read.
function translate(pattern: str) -> str?
    pieces: [str] @= []
    i: i64 @= 0
    depth: i64 @= 0

    while i < pattern.len()
        b = pattern[i]

        if b == '\\'
            piece = read_escape(pattern, at: i, in_class: false)?
            pieces @ pieces.push(piece.text)
            i @ piece.next
        else if b == '['
            piece = read_class(pattern, at: i)?
            pieces @ pieces.push(piece.text)
            i @ piece.next
        else if b == '('
            if i + 2 < pattern.len() && pattern[i + 1] == '?' && (pattern[i + 2] == '=' || pattern[i + 2] == '!')
                return fail(code: UNSUPPORTED, msg: "a look-ahead")

            if i + 3 < pattern.len() && pattern[i + 1] == '?' && pattern[i + 2] == '<' && (pattern[i + 3] == '=' || pattern[i + 3] == '!')
                return fail(code: UNSUPPORTED, msg: "a look-behind")

            if i + 1 < pattern.len() && pattern[i + 1] == '?' && !(i + 2 < pattern.len() && (pattern[i + 2] == ':' || pattern[i + 2] == '<'))
                return fail(code: INVALID, msg: "a `(?` that is no group ECMAScript writes")
            depth @ depth + 1
            pieces @ pieces.push("(")
            i @ i + 1
        else if b == ')'
            if depth == 0
                return fail(code: INVALID, msg: "a `)` that closes nothing")
            depth @ depth - 1
            pieces @ pieces.push(")")
            i @ i + 1
        else if b == '.'
            pieces @ pieces.push("[^\\n\\r\\x{2028}\\x{2029}]")
            i @ i + 1
        else if b == '{'
            end = count_end(pattern, at: i)

            if end < 0
                pieces @ pieces.push("\\{")
                i @ i + 1
            else
                pieces @ pieces.push(pattern.slice(from: i, to: end))
                i @ end
        else if b == '}'
            pieces @ pieces.push("\\}")
            i @ i + 1
        else if b == ']'
            pieces @ pieces.push("\\]")
            i @ i + 1
        else
            width = width_at(pattern, at: i)
            c = pattern.slice(from: i, to: i + width)

            if b < 0x20
                pieces @ pieces.push(written(unicode.code_point(c)))
            else
                pieces @ pieces.push(c)
            i @ i + width

    if depth != 0
        return fail(code: INVALID, msg: "a `(` with no `)`")
    return ok(pieces.join(""))

## Tests

test "translate: escapes of ECMAScript written as regex writes them"
    assert translate("^a*$").must() == "^a*$"
    assert translate("\\u0041\\u{1F600}\\uD83D\\uDE00").must() == "\\x{41}\\x{1f600}\\x{1f600}"
    assert translate("\\p{Letter}\\P{digit}").must() == "\\p{L}\\P{Nd}"
    assert translate("a.b").must() == "a[^\\n\\r\\x{2028}\\x{2029}]b"
    assert translate("a{b").must() == "a\\{b"
    assert translate("x{2,3}").must() == "x{2,3}"
    assert translate("[^]").must() == "(?s:.)"
    assert translate("\\cJ").must() == "\\x{a}"
    assert translate("[a-c\\-]").must() == "[\\x{61}-\\x{63}\\-]"

test "translate: what regex does not read, and what is no pattern"
    for pattern in ["(?=a)", "(?!a)", "(?<=a)b", "(\\w)\\1", "\\k<n>", "\\p{Script=Greek}"]
        match translate(pattern)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED

    for pattern in ["(a", "a)", "[a", "\\", "\\x4", "\\u12", "[z-a]", "(?x)"]
        match translate(pattern)
            .ok _  => assert false
            .err e => assert e.code == INVALID
