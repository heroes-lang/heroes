# SASL PLAIN's one message as Kafka carries it in `SaslAuthenticate`. SCRAM's
# three are the package `scram`'s, which `broker.hero` carries.

use bytes

# PLAIN's message: no identity to act as, the user's name and the password,
# each after a zero byte.
#
# - `username`: the user's name.
# - `password`: the password.
function plain(username: str, password: str) -> [u8]
    return bytes.concat([[0], bytes.from_text(username), [0], bytes.from_text(password)])

test "plain: no identity, the name and the password"
    assert plain(username: "u", password: "p") == [0, 'u', 0, 'p']
