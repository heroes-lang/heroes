# Where a text may be cut: after a blank line, after a line break, between
# sentences, after the white space that ends a word, between graphemes, or
# before a separator.
# Every boundary answered is also a boundary between graphemes, those of the
# whole text, so no cut splits what a reader sees as one character; a
# boundary that is not one, a separator before a combining mark for
# instance, is passed over.

use unicode
use unicode/segment

# After a blank line.
constant PARAGRAPHS: i64
    1

# After a line break.
constant LINES: i64
    2

# Between sentences, UAX #29's.
constant SENTENCES: i64
    3

# After each run of white space, a word keeping the spaces after it and its
# marks of punctuation.
constant WORDS: i64
    4

# Between graphemes.
constant GRAPHEMES: i64
    5

# Before each occurrence of a separator.
constant SEPARATOR: i64
    6

# A way of cutting: a level, or a separator to cut before.
record Cutter
    # One of the six constants above.
    level: i64
    # The separator, for `SEPARATOR`; "" otherwise.
    separator: str

# Whether `b` is white space that may stand in a blank line or around it:
# space, tab, carriage return, line feed.
function is_blank_byte(b: u8) -> bool
    return b == ' ' || b == '\t' || b == '\r' || b == '\n'

# The boundaries of `s` after each run of spaces, tabs and line breaks that
# holds two line breaks or more, a blank line: 0, those, and the length.
function paragraph_bounds(s: str) -> [i64]
    out: [i64] @= [0]
    at: i64 @= 0

    while at < s.len()
        if is_blank_byte(s[at])
            breaks: i64 @= 0

            while at < s.len() && is_blank_byte(s[at])
                if s[at] == '\n' || s[at] == '\r' && (at + 1 == s.len() || s[at + 1] != '\n')
                    breaks @ breaks + 1
                at @ at + 1

            if breaks >= 2 && at < s.len() && out[out.len() - 1] != at
                out @ out.push(at)
        else
            at @ at + 1

    if out[out.len() - 1] != s.len()
        out @ out.push(s.len())
    return out

# The boundaries of `s` after each line break, a line feed, a carriage return
# and a line feed, or a carriage return alone: 0, those, and the length.
function line_bounds(s: str) -> [i64]
    out: [i64] @= [0]
    at: i64 @= 0

    while at < s.len()
        if s[at] == '\n' || s[at] == '\r' && (at + 1 == s.len() || s[at + 1] != '\n')
            if at + 1 < s.len()
                out @ out.push(at + 1)
        at @ at + 1

    if out[out.len() - 1] != s.len()
        out @ out.push(s.len())
    return out

# How many bytes the character of Unicode's White_Space at `at` in `s` takes,
# or 0 where the character there is none.
function space_width(s: str, at: i64) -> i64
    b = s[at]

    if b < 0x80
        if b == ' ' || b >= 9 && b <= 13
            return 1
        return 0
    width = unicode.len_at(s, index: at)

    if unicode.is_space(s.slice(from: at, to: at + width))
        return width
    return 0

# The boundaries of `s` after each run of white space that more text
# follows: 0, those, and the length.
function word_bounds(s: str) -> [i64]
    out: [i64] @= [0]
    at: i64 @= 0

    while at < s.len()
        width = space_width(s, at: at)

        if width == 0
            at @ at + unicode.len_at(s, index: at)
        else
            while at < s.len() && space_width(s, at: at) > 0
                at @ at + space_width(s, at: at)

            if at < s.len() && out[out.len() - 1] != at
                out @ out.push(at)

    if out[out.len() - 1] != s.len()
        out @ out.push(s.len())
    return out

# The boundaries of `s` before each occurrence of `separator`, not empty,
# taken from the left, none overlapping: 0, those, and the length.
function separator_bounds(s: str, separator: str) -> [i64]
    out: [i64] @= [0]
    at: i64 @= 0

    while at + separator.len() <= s.len()
        matched: i64 @= 0

        while matched < separator.len() && s[at + matched] == separator[matched]
            matched @ matched + 1

        if matched == separator.len()
            if at > 0 && out[out.len() - 1] != at
                out @ out.push(at)
            at @ at + separator.len()
        else
            at @ at + 1

    if out[out.len() - 1] != s.len()
        out @ out.push(s.len())
    return out

# Whether `at` is among `sorted`, ascending.
function holds(sorted: [i64] lent, at: i64) -> bool
    low: i64 @= 0
    high: i64 @= sorted.len()

    while low < high
        middle = (low + high) / 2

        if sorted[middle] < at
            low @ middle + 1
        else
            high @ middle

    return low < sorted.len() && sorted[low] == at

# Where `s` may be cut from `from` to `to` by `cutter`, as byte indices of
# `s`, ascending, `from` and `to` the first and the last, each also in
# `graphemes`, the grapheme boundaries of all of `s`.
function bounds(s: str, from: i64, to: i64, cutter: Cutter lent, graphemes: [i64] lent) -> [i64]
    if from >= to
        return [from]
    out: [i64] @= [from]

    if cutter.level == GRAPHEMES
        low: i64 @= 0
        high: i64 @= graphemes.len()

        while low < high
            middle = (low + high) / 2

            if graphemes[middle] <= from
                low @ middle + 1
            else
                high @ middle

        while low < graphemes.len() && graphemes[low] < to
            out @ out.push(graphemes[low])
            low @ low + 1

        out @ out.push(to)
        return out

    piece = if from == 0 && to == s.len()
        s
    else
        s.slice(from: from, to: to)

    local = if cutter.level == PARAGRAPHS
        paragraph_bounds(piece)
    else if cutter.level == LINES
        line_bounds(piece)
    else if cutter.level == SENTENCES
        segment.sentence_boundaries(piece)
    else if cutter.level == WORDS
        word_bounds(piece)
    else
        separator_bounds(s: piece, separator: cutter.separator)

    for at in local
        place = from + at

        if place > from && place < to && holds(graphemes, at: place)
            out @ out.push(place)

    out @ out.push(to)
    return out

test "paragraph_bounds: blank lines, a line break alone, CR LF, spaces in the blank line, and blank lines at either end"
    assert paragraph_bounds("a\n\nb\nc\n \t\nd") == [0, 3, 10, 11]
    assert paragraph_bounds("a\r\n\r\nb") == [0, 5, 6]
    assert paragraph_bounds("\n\na\n\n") == [0, 2, 5]
    assert paragraph_bounds("") == [0]
    assert paragraph_bounds("one") == [0, 3]

test "line_bounds: a line feed, CR LF, a carriage return alone, and a break at the end"
    assert line_bounds("a\nb\r\nc\rd\n") == [0, 2, 5, 7, 9]
    assert line_bounds("") == [0]

test "word_bounds: words with their spaces, punctuation kept, white space above ASCII, and runs at either end"
    assert word_bounds("Hi, you  there.") == [0, 4, 9, 15]
    assert word_bounds("a\u{85}b　c") == [0, 3, 7, 8]
    assert word_bounds("  a ") == [0, 2, 4]
    assert word_bounds("") == [0]

test "separator_bounds: at the start, inside, twice in a row, overlapping, and absent"
    assert separator_bounds(s: ", a, b,, c", separator: ", ") == [0, 3, 7, 10]
    assert separator_bounds(s: "aaa", separator: "aa") == [0, 3]
    assert separator_bounds(s: "abc", separator: "x") == [0, 3]

test "bounds: sentences of a slice, graphemes inside a range, and a separator before a combining mark passed over"
    s = "Hi. Yo! 😀👍🏽 éx"
    graphemes = segment.grapheme_boundaries(s)
    assert bounds(s, from: 0, to: 8, cutter: Cutter(level: SENTENCES, separator: ""), graphemes: graphemes) == [0, 4, 8]
    assert bounds(s, from: 8, to: 20, cutter: Cutter(level: GRAPHEMES, separator: ""), graphemes: graphemes) == [8, 12, 20]
    t = "é́e"
    assert bounds(t, from: 0, to: t.len(), cutter: Cutter(level: SEPARATOR, separator: "́"), graphemes: segment.grapheme_boundaries(t)) == [0, 6]
    assert bounds(s, from: 3, to: 3, cutter: Cutter(level: WORDS, separator: ""), graphemes: graphemes) == [3]
