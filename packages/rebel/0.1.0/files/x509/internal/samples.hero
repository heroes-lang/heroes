# The certificates, the request and the revocation list the tests read,
# made by Python's `cryptography` 50.0.2 on 2026-11-17 (the script, and what
# Python and Go answered of them, are in the scratch folder's `x509`). Each
# is a function that only the tests call: about 12 KB of text a program
# using `x509` holds where its linker keeps what nothing calls.

# The root of the samples' chain: a P-384 key, self-signed by ECDSA over SHA-384, a CA with a path length of 1.
function root() -> str
    lines = [
        "-----BEGIN CERTIFICATE-----"
        "MIIB6TCCAW+gAwIBAgIBATAKBggqhkjOPQQDAzA8MQswCQYDVQQGEwJJVDEUMBIG"
        "A1UECgwLSGVyb2VzIFRlc3QxFzAVBgNVBAMMDkhlcm9lcyBSb290IENBMB4XDTI2"
        "MDEwMTAwMDAwMFoXDTM2MDEwMTAwMDAwMFowPDELMAkGA1UEBhMCSVQxFDASBgNV"
        "BAoMC0hlcm9lcyBUZXN0MRcwFQYDVQQDDA5IZXJvZXMgUm9vdCBDQTB2MBAGByqG"
        "SM49AgEGBSuBBAAiA2IABMAmydMDFl/aLZ2AI4agZOTzLOFRzfczKOQP3c/RyRgS"
        "2fEBwEVIFo26591JXHSVm8bmYWyp5UUA+SSYJlcQomZ4xg0iPJY8HguOXx2Qdh6R"
        "xBkMkKsLPo+0rTyCliPmgqNFMEMwEgYDVR0TAQH/BAgwBgEB/wIBATAOBgNVHQ8B"
        "Af8EBAMCAQYwHQYDVR0OBBYEFAwJgUNZQO6Hdw8wBhnT0QDPPDnvMAoGCCqGSM49"
        "BAMDA2gAMGUCMCSEUlqhGYT+LKXFKNVeDLl68tpftnOMqEr2hfOd0yWLfQt8EbAa"
        "F2fJbdH5cbXPigIxAMIXLsfqHhaSEUMqicxwWYxwkRti3hQNuc7wRHVJYzwEBu29"
        "jKGU71l2MDqK0KmdoQ=="
        "-----END CERTIFICATE-----"
    ]
    return lines.join("\n") + "\n"

