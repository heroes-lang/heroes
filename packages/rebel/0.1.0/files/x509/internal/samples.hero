# A certificate request for `request.example.com`, with a challenge password and a subject alternative name requested.
function request() -> str
    lines = [
        "-----BEGIN CERTIFICATE REQUEST-----"
        "MIIBNzCB3gIBADA0MRwwGgYDVQQDDBNyZXF1ZXN0LmV4YW1wbGUuY29tMRQwEgYD"
        "VQQKDAtIZXJvZXMgVGVzdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABA3dsVnK"
        "yz4wawSiBCRzz+Xo1cCBtT/2G2F+mGlky1M/2uG5KixGX4fOXgfu/cJSY0SLZIM3"
        "G4T4mPiNzrZhe5egSDAVBgkqhkiG9w0BCQcxCAwGc2VjcmV0MC8GCSqGSIb3DQEJ"
        "DjEiMCAwHgYDVR0RBBcwFYITcmVxdWVzdC5leGFtcGxlLmNvbTAKBggqhkjOPQQD"
        "AgNIADBFAiEA3KN85VHF77I0A8IziRwxV3ru1m88FtILbOLqvG9zCiMCIE0T4g2G"
        "AtdxDEIBZ0MzjeKeTKoudndPWKy503ww7LXJ"
        "-----END CERTIFICATE REQUEST-----"
    ]
    return lines.join("\n") + "\n"

