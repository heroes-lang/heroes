# A self-signed Ed25519 certificate valid until `99991231235959Z`.
function ed25519() -> str
    lines = [
        "-----BEGIN CERTIFICATE-----"
        "MIHxMIGkoAMCAQICAQcwBQYDK2VwMBcxFTATBgNVBAMMDEVkMjU1MTkgU2VsZjAg"
        "Fw0yNjAxMDEwMDAwMDBaGA85OTk5MTIzMTIzNTk1OVowFzEVMBMGA1UEAwwMRWQy"
        "NTUxOSBTZWxmMCowBQYDK2VwAyEANPwnXZLevYOY2aSHzQEDjTaRH8mMBnkHyn6V"
        "j0wcrr2jEzARMA8GA1UdEwEB/wQFMAMBAf8wBQYDK2VwA0EAvB3fafbD03AWDpwG"
        "L6OVr45918r8W6EBmvP86NpxJFttX7zArSXDknjddCVPKLpMvgpQsWMYFSvAFO63"
        "iiuzAA=="
        "-----END CERTIFICATE-----"
    ]
    return lines.join("\n") + "\n"

