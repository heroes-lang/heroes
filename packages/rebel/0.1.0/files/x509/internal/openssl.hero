# `openssl req -new` of the Ed25519 key: subject `O=Heroes Test, CN=csr.example.org`, an extension request of `CA:FALSE`, `digitalSignature`, `serverAuth` and two alternative names.
function request() -> str
    lines = [
        "-----BEGIN CERTIFICATE REQUEST-----"
        "MIIBFjCByQIBADAwMRQwEgYDVQQKDAtIZXJvZXMgVGVzdDEYMBYGA1UEAwwPY3Ny"
        "LmV4YW1wbGUub3JnMCowBQYDK2VwAyEAhs7rZiy0WltbV2Y4mhheYd1E0VKTQNuO"
        "PzhenciLNS2gZjBkBgkqhkiG9w0BCQ4xVzBVMAwGA1UdEwEB/wQCMAAwDgYDVR0P"
        "AQH/BAQDAgeAMBMGA1UdJQQMMAoGCCsGAQUFBwMBMCAGA1UdEQQZMBeCD2Nzci5l"
        "eGFtcGxlLm9yZ4cEwAACCTAFBgMrZXADQQD2ftLwJjbP0BtKayHgAaNnsOs30fJn"
        "UCU4GCLNOOqjm9n176sUgXzpPASb3esJUaeovhkJBDa3Ae4F5v6PVAkJ"
        "-----END CERTIFICATE REQUEST-----"
    ]
    return lines.join("\n") + "\n"

# `openssl ca -gencrl` of the Ed25519 root: number 5, 2026-11-10 to 2026-12-10, three entries (`0AAA` with no reason, `1234` superseded, `7EDCBA9876543210` key compromise) in the order `openssl ca` sorts them.
function crl() -> str
    lines = [
        "-----BEGIN X509 CRL-----"
        "MIIBSTCB/AIBATAFBgMrZXAwPjELMAkGA1UEBhMCSVQxFDASBgNVBAoMC0hlcm9l"
        "cyBUZXN0MRkwFwYDVQQDDBBIZXJvZXMgTWFkZSBSb290Fw0yNjExMTAwMDAwMDBa"
        "Fw0yNjEyMTAwMDAwMDBaMGEwEwICCqoXDTI2MTEwNzAwMDAwMFowIQICEjQXDTI2"
        "MTEwNjAwMDAwMFowDDAKBgNVHRUEAwoBBDAnAgh+3LqYdlQyEBcNMjYxMTA1MTIw"
        "MDAwWjAMMAoGA1UdFQQDCgEBoC8wLTAfBgNVHSMEGDAWgBQJjtd9ikTvgm31oTtA"
        "KkH5IqHsVTAKBgNVHRQEAwIBBTAFBgMrZXADQQCuI8fKgrTMz0V3ee08hz3JbJKh"
        "KkFISsGRXL7LPgUBgVH5smxVHnXeGhMKnea0Z5nJlrCZ1AST5WyOvUZlQDEO"
        "-----END X509 CRL-----"
    ]
    return lines.join("\n") + "\n"
