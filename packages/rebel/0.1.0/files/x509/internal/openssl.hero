# The keys the tests of `create_certificate`, `create_self_signed`,
# `create_request` and `create_crl` sign with, and the answers OpenSSL 4.1.0
# (2026-11-23) gave for the same fields, which the tests compare byte for
# byte. The three keys are made for these tests and protect nothing. The
# Ed25519 and RSA PKCS #1 v1.5 signatures are deterministic, so what OpenSSL
# signed and what this package signs are the same bytes; ECDSA and RSA-PSS
# are checked by OpenSSL's `verify` and `req -verify` instead (the commands are
# in the commit that added this file). Each is a function that only the tests
# call.

# An Ed25519 key, `openssl genpkey -algorithm ed25519`.
function ed25519_key() -> str
    lines = [
        "-----BEGIN PRIVATE KEY-----"
        "MC4CAQAwBQYDK2VwBCIEIBlIUfKDgKlOJkF3Rd9M3ucB54jRc07ArfZ98EIewUZd"
        "-----END PRIVATE KEY-----"
    ]
    return lines.join("\n") + "\n"

# A P-256 key, `openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256`.
function p256_key() -> str
    lines = [
        "-----BEGIN PRIVATE KEY-----"
        "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgKQZlHfrzQ4bgyzLm"
        "OVxgQpEC2WpYHB8wS+bZ3mlDK3GhRANCAAQlGOAJoC/LgO0jdM6d32AgTXUpHaEw"
        "jWQAfSXbzR/GKmmpliWNDNie1qe2eBJ2sf+RA8ALDHB/o+gBIbzGmZdC"
        "-----END PRIVATE KEY-----"
    ]
    return lines.join("\n") + "\n"

