# `openssl req -x509` of the Ed25519 key: subject `C=IT, O=Heroes Test, CN=Heroes Made Root`, serial `0102030405060708090a0b0c0d0e0f1011121314`, 2026-11-01 to 2036-11-01, `subjectKeyIdentifier = hash`, `basicConstraints = critical,CA:TRUE,pathlen:1`, `keyUsage = critical,keyCertSign,cRLSign`.
function root() -> str
    lines = [
        "-----BEGIN CERTIFICATE-----"
        "MIIBgzCCATWgAwIBAgIUAQIDBAUGBwgJCgsMDQ4PEBESExQwBQYDK2VwMD4xCzAJ"
        "BgNVBAYTAklUMRQwEgYDVQQKDAtIZXJvZXMgVGVzdDEZMBcGA1UEAwwQSGVyb2Vz"
        "IE1hZGUgUm9vdDAeFw0yNjExMDEwMDAwMDBaFw0zNjExMDEwMDAwMDBaMD4xCzAJ"
        "BgNVBAYTAklUMRQwEgYDVQQKDAtIZXJvZXMgVGVzdDEZMBcGA1UEAwwQSGVyb2Vz"
        "IE1hZGUgUm9vdDAqMAUGAytlcAMhAIbO62YstFpbW1dmOJoYXmHdRNFSk0Dbjj84"
        "Xp3IizUto0UwQzAdBgNVHQ4EFgQUCY7XfYpE74Jt9aE7QCpB+SKh7FUwEgYDVR0T"
        "AQH/BAgwBgEB/wIBATAOBgNVHQ8BAf8EBAMCAQYwBQYDK2VwA0EA31umv0MwmZxn"
