# A path as text, by POSIX's rules and by Windows', touching no disk: what a
# path's parts are, where it begins, how two paths stand to each other, and a
# path cleaned, joined or changed, a path matched against a pattern, and
# whether gitignore files ignore a path. Nothing here asks the system what a
# path names, so nothing fails for what the disk holds, and a link on the disk
# may lead where the text does not say.
#
# Every function comes in two forms. The short one, `clean`, reads by the rules
# of the system the program runs on. The one ending in `_by`, `clean_by`, takes
# the rules, so a program reads a Windows path on any system, and both rules
# are tested on every machine. A path is a `str`, so UTF-8; every position a
# function cuts at is beside a separator, a dot or a colon, so none splits a
# character. The patterns of gitignore files are read by git's rules alone,
# `/` separating, on every system, so they have no `_by` form.
#
# What asks the disk or the system is elsewhere: a path made absolute from
# where the program stands is `fs.to_abs`, its links followed `fs.resolve`,
# the paths a pattern matches on the disk `fs.glob`, a tree walked `fs.walk`,
# all of `fs`; the user's home folder is `os.home_dir`, and the environment's
# PATH itself `os.env`.

use path/hero_os
use path/internal/change
use path/internal/codes
use path/internal/ignoring
use path/internal/lexical
use path/internal/local
use path/internal/relation
use path/internal/roots
use path/internal/scan
use path/internal/wildcard

## Codes

# The code a function fails with where a path holds nothing of what was asked:
# no name, no extension, no volume.
constant NOT_FOUND: str
    codes.NOT_FOUND

# The code a function fails with where its input is not what it reads; the
# message says what was wrong.
constant INVALID: str
    codes.INVALID

## The rules

# Which rules a path is read by.
variant Rules
    # POSIX's: `/` separates, a path that begins with `/` is absolute, and
    # there is no volume.
    posix
    # Windows': `\` and `/` both separate, a path may begin with a volume, a
    # drive `C:` or a share `\\host\share`, and names are compared with the
    # case of the ASCII letters set aside. A letter outside ASCII keeps its
    # case: which of those Windows takes as one is its file system's to say,
    # and not the text's.
    windows

# The rules of the system the program runs on: `windows` on Windows, `posix` on
# every other. Every short form reads by them.
function system_rules() -> Rules
    if hero_os.run_exe_suffix() == ".exe"
        return .windows
    return .posix

# The separator the system writes a path with: `\` on Windows, `/` elsewhere.
function sep() -> str
    return sep_by(system_rules())

# The separator `rules` write a path with: `/` by POSIX's, `\` by Windows'.
#
# - `rules`: the rules, whatever the system.
function sep_by(rules: Rules) -> str
    return scan.separator(rules == .windows)

# Whether `c` is a character that separates the parts of a path on this
# system: `/` everywhere, and `\` too on Windows.
#
# - `c`: the character to ask about; a text of any other length is none.
function is_sep(c: str) -> bool
    return is_sep_by(c, system_rules())

# Whether `c` is a character that separates the parts of a path by `rules`:
# `/` by both, and `\` too by Windows'.
#
# - `c`: the character to ask about; a text of any other length is none.
# - `rules`: the rules, whatever the system.
function is_sep_by(c: str, rules: Rules) -> bool
    return c.len() == 1 && scan.is_sep(c[0], rules == .windows)

# The separator between the paths of a list such as the environment's PATH on
# this system: `;` on Windows, `:` elsewhere.
function list_sep() -> str
    return list_sep_by(system_rules())

# The separator between the paths of a list by `rules`: `:` by POSIX's, `;` by
# Windows'.
#
# - `rules`: the rules, whatever the system.
function list_sep_by(rules: Rules) -> str
    return match rules
        .posix   => ":"
        .windows => ";"

# The paths of `list`, a list such as the environment's PATH, cut at each
# `list_sep`.
#
# - `list`: the list's text; the empty text holds no path, and an empty piece
#   is kept as "", which a system reads as the folder the program stands in.
#   By Windows' rules a piece may stand in double quotes to hold a `;`, and
#   the quotes are dropped.
#
# See also `join_list`, which builds such a list.
function split_list(list: str) -> [str]
    return split_list_by(list, system_rules())

# What `split_list` answers, cutting by `rules` and not by the system's own.
#
# - `list`: the list's text, as `split_list` reads it.
# - `rules`: the rules, whatever the system.
function split_list_by(list: str, rules: Rules) -> [str]
    return local.split_list(list, rules == .windows)

# `paths` written as one list such as the environment's PATH, `list_sep`
# between each two: what `split_list` reads back.
#
# - `paths`: the paths, in order; an empty one is written as an empty piece,
#   which a system reads as the folder the program stands in, and no paths
#   answer "".
#
# By Windows' rules a path that holds `;` is written in double quotes, as
# `split_list` reads it. Fails `invalid` where a path holds what the list
# cannot carry: by POSIX's rules a `:`, by Windows' a `"`. A list of one empty
# path is "", which `split_list` reads as no path.
function join_list(paths: [str]) -> str?
    return join_list_by(paths, system_rules())

# What `join_list` answers, writing by `rules` and not by the system's own.
#
# - `paths`: the paths, in order, as `join_list` writes them.
# - `rules`: the rules, whatever the system.
#
# Fails `invalid` where a path holds what the list cannot carry.
function join_list_by(paths: [str], rules: Rules) -> str?
    return local.join_list(paths, rules == .windows)

## A path cleaned and joined

# The shortest path that names what `path` names, by its text alone:
# separators that repeat become one, every `.` goes, every `..` goes with the
# part before it, a `..` at a root goes, and no separator is left at the end.
#
# - `path`: the path to clean; the empty path answers `.`.
#
# By Windows' rules every separator is written `\`, and a drive with no root
# keeps the `..` it cannot resolve: `C:..\a`. It reads no disk: where a part is
# a link, the cleaned path may name another place, and `fs.resolve` follows
# the links. See also `join_all`.
function clean(path: str) -> str
    return clean_by(path, system_rules())

# What `clean` answers, by `rules` and not by the system's own.
#
# - `path`: the path to clean.
# - `rules`: the rules, whatever the system.
function clean_by(path: str, rules: Rules) -> str
    return lexical.clean(path, rules == .windows)

# `paths` joined into one path, each read from the one before it: a separator
# goes between two where none stands.
#
# - `paths`: the paths, in order; an empty one adds nothing, and one that is
#   absolute starts the path over, since it names the same place from
#   anywhere. No paths answer "".
#
# By Windows' rules a path with a root and no volume keeps the volume so far,
# and a path with another volume starts over. Nothing is cleaned: `clean` does
# that. See also `parts`.
function join_all(paths: [str]) -> str
    return join_all_by(paths, system_rules())

# What `join_all` answers, by `rules` and not by the system's own.
#
# - `paths`: the paths, in order, as `join_all` joins them.
# - `rules`: the rules, whatever the system.
function join_all_by(paths: [str], rules: Rules) -> str
    return lexical.join_paths(paths, rules == .windows)

## The parts of a path

# What `split_name` answers: a path cut before its last part.
record NameSplit
    # The path without its last part, as `parent` answers it.
    parent: str
    # The last part, as `name` answers it.
    name: str

# `path` without its last part: `a/b` answers `a`.
#
# - `path`: the path; separators at the end and `.` parts are skipped first.
#
# A path of one part answers `.`, and a root or a volume alone answers itself,
# so the answer always names a folder. It drops the last part as written, a
# `..` included: the parent of `..` is `.` here, since no text says what
# stands above it. See also `name`, `ancestors`.
function parent(path: str) -> str
    return parent_by(path, system_rules())

# What `parent` answers, by `rules` and not by the system's own.
#
# - `path`: the path, as `parent` reads it.
# - `rules`: the rules, whatever the system.
function parent_by(path: str, rules: Rules) -> str
    return lexical.parent(path, rules == .windows)

# The last part of `path`, where it is a name: `a/b.txt` answers `b.txt`.
#
# - `path`: the path; separators at the end and `.` parts are skipped, so
#   `a/b/` answers `b`.
#
# Fails `not_found` where the path ends in no name: the empty path, `.`, a
# root or a volume alone, and a path whose last part is `..`. So an answer is
# never empty, never `.` or `..`, and holds no separator. See also `parent`,
# `stem`, `ext`.
function name(path: str) -> str?
    return name_by(path, system_rules())

# What `name` answers, by `rules` and not by the system's own.
#
# - `path`: the path, as `name` reads it.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name.
function name_by(path: str, rules: Rules) -> str?
    return lexical.last_name(path, rules == .windows)

# The name of `path` without its extension: `a/b.tar.gz` answers `b.tar`.
#
# - `path`: the path whose name is read.
#
# A name with no extension is its own stem, so the stem and the extension
# together are always the name. Fails `not_found` where the path ends in no
# name. See also `stem_all`, `ext`.
function stem(path: str) -> str?
    return stem_by(path, system_rules())

# What `stem` answers, by `rules` and not by the system's own.
#
# - `path`: the path whose name is read.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name.
function stem_by(path: str, rules: Rules) -> str?
    return lexical.stem(path, rules == .windows)

# The name of `path` without any of its extensions: `a/b.tar.gz` answers `b`.
#
# - `path`: the path whose name is read.
#
# It is what stands before the extensions `ext_all` answers. Fails `not_found`
# where the path ends in no name.
function stem_all(path: str) -> str?
    return stem_all_by(path, system_rules())

# What `stem_all` answers, by `rules` and not by the system's own.
#
# - `path`: the path whose name is read.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name.
function stem_all_by(path: str, rules: Rules) -> str?
    return lexical.stem_all(path, rules == .windows)

# The extension of the name of `path`, with its dot: `a/b.tar.gz` answers
# `.gz`.
#
# - `path`: the path whose name is read.
#
# An extension begins at the name's last dot, unless only dots stand before
# it: `.bashrc` has none, and `a.` has the extension `.`. Fails `not_found`
# where the path ends in no name, or the name has no extension. See also
# `ext_all`, `with_ext`.
function ext(path: str) -> str?
    return ext_by(path, system_rules())

# What `ext` answers, by `rules` and not by the system's own.
#
# - `path`: the path whose name is read.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name, or the name has no
# extension.
function ext_by(path: str, rules: Rules) -> str?
    return lexical.ext(path, rules == .windows)

# Every extension of the name of `path`, each with its dot, in the order they
# stand: `a/b.tar.gz` answers `[".tar", ".gz"]`.
#
# - `path`: the path whose name is read.
#
# A path with no name, or a name with no extension, has none. The dots a name
# begins with open no extension.
function ext_all(path: str) -> [str]
    return ext_all_by(path, system_rules())

# What `ext_all` answers, by `rules` and not by the system's own.
#
# - `path`: the path whose name is read.
# - `rules`: the rules, whatever the system.
function ext_all_by(path: str, rules: Rules) -> [str]
    return lexical.ext_all(path, rules == .windows)

# `path` cut before its last part: its parent and its name, as `parent` and
# `name` answer them.
#
# - `path`: the path to cut.
#
# Fails `not_found` where the path ends in no name.
function split_name(path: str) -> NameSplit?
    return split_name_by(path, system_rules())

# What `split_name` answers, by `rules` and not by the system's own.
#
# - `path`: the path to cut.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name.
function split_name_by(path: str, rules: Rules) -> NameSplit?
    windows = rules == .windows
    last = lexical.last_name(path, windows)?
    return ok(NameSplit(parent: lexical.parent(path, windows), name: last))

# Every part of `path` in order: first its volume and root as one part, where
# it has either, then each name and each `..`.
#
# - `path`: the path; the empty path and `.` have no part.
#
# Empty parts and `.` parts are skipped, each name stands as written, and the
# first part is written with the separator of the rules and its root as one:
# `/usr//lib/` answers `["/", "usr", "lib"]`, and by Windows' rules `C:/a`
# answers `["C:\", "a"]`. `join_all` of the parts names what the path names.
function parts(path: str) -> [str]
    return parts_by(path, system_rules())

# What `parts` answers, by `rules` and not by the system's own.
#
# - `path`: the path, as `parts` reads it.
# - `rules`: the rules, whatever the system.
function parts_by(path: str, rules: Rules) -> [str]
    return lexical.parts(path, rules == .windows)

# Every path above `path`, nearest first: its parent, the parent of that, and
# so on to the root, or to `.` where the path is relative.
#
# - `path`: the path; a root, a volume alone, `.` and the empty path have
#   none.
#
# `/a/b` answers `["/a", "/"]` and `a/b` answers `["a", "."]`. See also
# `parent`.
function ancestors(path: str) -> [str]
    return ancestors_by(path, system_rules())

# What `ancestors` answers, by `rules` and not by the system's own.
#
# - `path`: the path, as `ancestors` reads it.
# - `rules`: the rules, whatever the system.
function ancestors_by(path: str, rules: Rules) -> [str]
    return lexical.ancestors(path, rules == .windows)

## Where a path begins

# What `split_root` answers: a path in three pieces which, written one after
# the other, are the path.
record RootSplit
    # The volume as written, a drive `C:`, a share `\\host\share` or a device
    # `\\.\pipe`; "" where the path names none, as every path does by POSIX's
    # rules.
    volume: str
    # The separators that follow the volume and say the path begins at its
    # top; "" where the path is relative.
    root: str
    # What follows: the parts of the path, which never begin with a separator.
    rest: str

# Whether `path` names one place wherever the program stands.
#
# - `path`: the path to ask about.
#
# By POSIX's rules it begins with `/`. By Windows' it has a volume and a root,
# `C:\a`, or its volume is a share or a device; `\a`, which lacks the volume,
# and `C:a`, which lacks the root, are not absolute. A relative path made
# absolute from where the program stands is `fs.to_abs`'s. See also
# `has_root`.
function is_abs(path: str) -> bool
    return is_abs_by(path, system_rules())

# What `is_abs` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `rules`: the rules, whatever the system.
function is_abs_by(path: str, rules: Rules) -> bool
    windows = rules == .windows
    return roots.is_abs(roots.split(path, windows), windows)

# Whether `path` begins at the top of its volume: `/a`, and by Windows' rules
# `\a`, `C:\a` and every share and device, but not `C:a`.
#
# - `path`: the path to ask about.
#
# See also `is_abs`, `split_root`.
function has_root(path: str) -> bool
    return has_root_by(path, system_rules())

# What `has_root` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `rules`: the rules, whatever the system.
function has_root_by(path: str, rules: Rules) -> bool
    return roots.has_root(roots.split(path, rules == .windows))

# The volume `path` begins with, as written: a drive `C:`, a share
# `\\host\share`, a device `\\.\pipe`.
#
# - `path`: the path to read.
#
# Fails `not_found` where the path begins with none, as every path does by
# POSIX's rules.
function volume(path: str) -> str?
    return volume_by(path, system_rules())

# What `volume` answers, by `rules` and not by the system's own.
#
# - `path`: the path to read.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path begins with no volume.
function volume_by(path: str, rules: Rules) -> str?
    anchor = roots.split(path, rules == .windows)

    if anchor.volume == ""
        return fail(code: NOT_FOUND, msg: f"no volume begins \"{path}\"")
    return ok(anchor.volume)

# `path` in three pieces: its volume, its root, and the rest.
#
# - `path`: the path to cut.
#
# A piece the path lacks is "", and the three written one after the other are
# the path.
function split_root(path: str) -> RootSplit
    return split_root_by(path, system_rules())

# What `split_root` answers, by `rules` and not by the system's own.
#
# - `path`: the path to cut.
# - `rules`: the rules, whatever the system.
function split_root_by(path: str, rules: Rules) -> RootSplit
    anchor = roots.split(path, rules == .windows)
    return RootSplit(volume: anchor.volume, root: anchor.root, rest: anchor.rest)

## One path against another

# The way from `base` to `path`: the relative path that, joined to `base`,
# names what `path` names.
#
# - `path`: where the way leads; cleaned first.
# - `base`: where it starts; cleaned first.
#
# It goes up with `..` where `path` is not under `base`, and answers `.` where
# the two are the same. Fails `invalid` where the text holds no way: one
# begins at a root and the other does not, the two begin with different
# volumes, or `base` goes up by a `..` that `path` does not share, so that the
# folder to come back into has no name. See also `is_under`.
function relative(path: str, base: str) -> str?
    return relative_by(path: path, base: base, rules: system_rules())

# What `relative` answers, by `rules` and not by the system's own.
#
# - `path`: where the way leads.
# - `base`: where it starts.
# - `rules`: the rules, whatever the system.
#
# Fails `invalid` where the text holds no way from `base` to `path`.
function relative_by(path: str, base: str, rules: Rules) -> str?
    return relation.relative(path: path, base: base, windows: rules == .windows)

# Whether `path` is `root` or stands under it, both cleaned first: `/a/b` is
# under `/a`, and `/a/../b` is not.
#
# - `path`: the path to ask about.
# - `root`: the folder it may stand under; a relative path is under `.`
#   unless it begins with `..`, and under `..` always.
#
# Where `root` climbs further up than `path` and then names a folder, as
# `../b` does for `a`, the text cannot say and the answer is false. It reads
# the text alone: a link on the disk may still lead out of `root`.
function is_under(path: str, root: str) -> bool
    return is_under_by(path: path, root: root, rules: system_rules())

# What `is_under` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `root`: the folder it may stand under.
# - `rules`: the rules, whatever the system.
function is_under_by(path: str, root: str, rules: Rules) -> bool
    return relation.is_under(path: path, root: root, windows: rules == .windows)

# Whether the last parts of `path` are the parts of `tail`, whole parts only:
# `/etc/resolv.conf` has the tails `resolv.conf` and `etc/resolv.conf`, and
# not `conf`.
#
# - `path`: the path to ask about.
# - `tail`: the parts it may end with; one that begins with a root or a volume
#   is a tail only of the path that has the same parts from its own
#   beginning.
function has_tail(path: str, tail: str) -> bool
    return has_tail_by(path: path, tail: tail, rules: system_rules())

# What `has_tail` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `tail`: the parts it may end with.
# - `rules`: the rules, whatever the system.
function has_tail_by(path: str, tail: str, rules: Rules) -> bool
    return relation.has_tail(path: path, tail: tail, windows: rules == .windows)

# Whether `path` stays under the folder it is read from, whichever folder that
# is.
#
# - `path`: the path to ask about.
#
# It is not empty, has no root and no volume, and its `..` parts never climb
# above where it began, so `a/../b` is local and `a/../../b` is not. By
# Windows' rules it also holds no name `is_reserved` refuses. It reads the
# text alone: a link on the disk may still lead out. See also `localize`.
function is_local(path: str) -> bool
    return is_local_by(path, system_rules())

# What `is_local` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `rules`: the rules, whatever the system.
function is_local_by(path: str, rules: Rules) -> bool
    return local.is_local(path, rules == .windows)

# Whether a part of `path` is a name Windows keeps for itself, so that no file
# may bear it.
#
# - `path`: the path whose parts are asked.
#
# A reserved name is a device's name such as `NUL`, `CON` or `COM1`, with or
# without an extension or a stream after a colon, and in any case of its
# letters; a name that ends with a dot or a space; and a name that holds a
# control character or one of `*?"<>|`. `.` and `..` are not reserved. By
# POSIX's rules no name is.
function is_reserved(path: str) -> bool
    return is_reserved_by(path, system_rules())

# What `is_reserved` answers, by `rules` and not by the system's own.
#
# - `path`: the path whose parts are asked.
# - `rules`: the rules, whatever the system.
function is_reserved_by(path: str, rules: Rules) -> bool
    return local.is_reserved(path, rules == .windows)

# `path`, written with slashes as an archive or a URL writes one, as a local
# path of this system.
#
# - `path`: the slash-separated path; `.` alone is itself.
#
# An answer is local, as `is_local` reads it. Fails `invalid` where the path is
# not a plain relative one: empty, or with an empty part, a `.` or a `..`, a
# slash at either end; and where the system cannot hold it as written: a zero
# byte, and by Windows' rules a part that holds `\` or `:` or that
# `is_reserved` refuses. See also `from_slash`, which checks nothing.
function localize(path: str) -> str?
    return localize_by(path, system_rules())

# What `localize` answers, by `rules` and not by the system's own.
#
# - `path`: the slash-separated path.
# - `rules`: the rules, whatever the system.
#
# Fails `invalid` where the path is not a plain relative one, or the rules
# cannot hold it as written.
function localize_by(path: str, rules: Rules) -> str?
    return local.localize(path, rules == .windows)

# The longest path that every one of `paths` is or stands under, cleaned:
# `/usr/lib` and `/usr/local/bin` answer `/usr`.
#
# - `paths`: the paths, one or more.
#
# Relative paths with nothing in common answer `.`, and where they climb by
# different numbers of `..`, the highest of those folders: `../a` and `b`
# answer `..`. Fails `invalid` where `paths` is empty, where some begin at a
# root and others do not, and where two begin with different volumes.
function common(paths: [str]) -> str?
    return common_by(paths, system_rules())

# What `common` answers, by `rules` and not by the system's own.
#
# - `paths`: the paths, one or more.
# - `rules`: the rules, whatever the system.
#
# Fails `invalid` where `paths` is empty or the paths share no beginning.
function common_by(paths: [str], rules: Rules) -> str?
    return relation.common(paths, rules == .windows)

# Whether `path` and `other` are the same path once cleaned.
#
# - `path`: one path.
# - `other`: the other.
#
# By Windows' rules `\` and `/` are the same separator and ASCII letters are
# compared without their case. It reads the text alone: two different texts
# may still name one file on the disk. See also `compare`.
function is_same(path: str, other: str) -> bool
    return is_same_by(path: path, other: other, rules: system_rules())

# What `is_same` answers, by `rules` and not by the system's own.
#
# - `path`: one path.
# - `other`: the other.
# - `rules`: the rules, whatever the system.
function is_same_by(path: str, other: str, rules: Rules) -> bool
    return relation.compare(path: path, other: other, windows: rules == .windows) == 0

# The order of `path` and `other`, part by part once cleaned: below zero where
# `path` comes first, zero where the two are the same path as `is_same` reads
# them, above zero where `path` comes after.
#
# - `path`: one path.
# - `other`: the other.
#
# A part is ordered by its bytes, and a path comes before every path under it,
# so a sorted list keeps a folder together with what it holds. By Windows'
# rules ASCII letters are ordered as small ones. Before the names come the
# volumes, and a path with no root before one with a root.
function compare(path: str, other: str) -> i64
    return compare_by(path: path, other: other, rules: system_rules())

# What `compare` answers, by `rules` and not by the system's own.
#
# - `path`: one path.
# - `other`: the other.
# - `rules`: the rules, whatever the system.
function compare_by(path: str, other: str, rules: Rules) -> i64
    return relation.compare(path: path, other: other, windows: rules == .windows)

## A path changed

# `path` with its last part changed to the name `to`: `a/b.txt` changed to `c`
# answers `a/c`.
#
# - `path`: the path to change.
# - `to`: the new name, one name.
#
# Fails `not_found` where the path ends in no name, and `invalid` where `to` is
# not one name: empty, `.`, `..`, or holding a separator or, by Windows'
# rules, a volume. See also `with_stem`, `with_ext`.
function with_name(path: str, to: str) -> str?
    return with_name_by(path: path, to: to, rules: system_rules())

# What `with_name` answers, by `rules` and not by the system's own.
#
# - `path`: the path to change.
# - `to`: the new name.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name, and `invalid` where `to` is
# not one name.
function with_name_by(path: str, to: str, rules: Rules) -> str?
    return change.with_name(path: path, to: to, windows: rules == .windows)

# `path` with the stem of its name changed to `to` and its extension kept:
# `a/b.txt` changed to `c` answers `a/c.txt`.
#
# - `path`: the path to change.
# - `to`: the new stem.
#
# Fails `not_found` where the path ends in no name, and `invalid` where the new
# name would not be one name, as `with_name` reads it.
function with_stem(path: str, to: str) -> str?
    return with_stem_by(path: path, to: to, rules: system_rules())

# What `with_stem` answers, by `rules` and not by the system's own.
#
# - `path`: the path to change.
# - `to`: the new stem.
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name, and `invalid` where the new
# name would not be one name.
function with_stem_by(path: str, to: str, rules: Rules) -> str?
    return change.with_stem(path: path, to: to, windows: rules == .windows)

# `path` with the extension of its name changed to `to`: `a/b.txt` changed to
# `.md` answers `a/b.md`.
#
# - `path`: the path to change; a name with no extension gains one.
# - `to`: the new extension with its dot, or "" to remove the extension.
#
# Fails `not_found` where the path ends in no name, and `invalid` where `to` is
# neither empty nor a dot followed by text that holds no separator.
function with_ext(path: str, to: str) -> str?
    return with_ext_by(path: path, to: to, rules: system_rules())

# What `with_ext` answers, by `rules` and not by the system's own.
#
# - `path`: the path to change.
# - `to`: the new extension with its dot, or "".
# - `rules`: the rules, whatever the system.
#
# Fails `not_found` where the path ends in no name, and `invalid` where `to` is
# not an extension.
function with_ext_by(path: str, to: str, rules: Rules) -> str?
    return change.with_ext(path: path, to: to, windows: rules == .windows)

# `path` with every separator of this system written `/`, the form a URL, an
# archive and a configuration file write a path in.
#
# - `path`: the path; where `/` is the only separator it is answered as it
#   is.
#
# See also `from_slash`.
function to_slash(path: str) -> str
    return to_slash_by(path, system_rules())

# `path` with every separator of `rules` written `/`: by Windows' rules each
# `\` becomes `/`.
#
# - `path`: the path; by POSIX's rules, where `\` is a character of a name, it
#   is answered as it is.
# - `rules`: the rules, whatever the system.
function to_slash_by(path: str, rules: Rules) -> str
    return scan.with_seps(path: path, to: "/", windows: rules == .windows)

# `path` with every `/` written as the separator of this system.
#
# - `path`: the slash-separated path.
#
# It checks nothing: `localize` is the form that refuses a path the system
# cannot hold. See also `to_slash`.
function from_slash(path: str) -> str
    return from_slash_by(path, system_rules())

# `path` with every `/` written as the separator of `rules`: `\` by Windows'.
#
# - `path`: the slash-separated path; by POSIX's rules it is answered as it
#   is.
# - `rules`: the rules, whatever the system.
function from_slash_by(path: str, rules: Rules) -> str
    windows = rules == .windows
    return scan.with_seps(path: path, to: scan.separator(windows), windows: windows)

# Whether `path` ends with a separator after a part, the way a program says
# that it means a folder: `a/` does, and `a` does not.
#
# - `path`: the path to ask about; a root or a volume alone, which ends with
#   the separator that makes it one, does not.
function has_trailing_sep(path: str) -> bool
    return has_trailing_sep_by(path, system_rules())

# What `has_trailing_sep` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `rules`: the rules, whatever the system.
function has_trailing_sep_by(path: str, rules: Rules) -> bool
    return change.has_trailing_sep(path, rules == .windows)

# `path` ending with a separator: `a` answers `a/`.
#
# - `path`: the path; one that ends with a separator already, a root
#   included, is answered as it is.
#
# Where a separator alone would turn the path into a root, as after the empty
# path or a drive `C:`, a `.` goes before it: `./`.
function with_trailing_sep(path: str) -> str
    return with_trailing_sep_by(path, system_rules())

# What `with_trailing_sep` answers, by `rules` and not by the system's own.
#
# - `path`: the path to end with a separator.
# - `rules`: the rules, whatever the system.
function with_trailing_sep_by(path: str, rules: Rules) -> str
    return change.with_trailing_sep(path, rules == .windows)

# `path` without the separators at its end: `a//` answers `a`.
#
# - `path`: the path; a root keeps its own, so `/` answers `/`.
function trim_trailing_sep(path: str) -> str
    return trim_trailing_sep_by(path, system_rules())

# What `trim_trailing_sep` answers, by `rules` and not by the system's own.
#
# - `path`: the path to trim.
# - `rules`: the rules, whatever the system.
function trim_trailing_sep_by(path: str, rules: Rules) -> str
    return change.trim_trailing_sep(path, rules == .windows)

## A pattern matched

# Whether the whole of `path` matches `pattern`.
#
# - `path`: the path to ask about.
# - `pattern`: `*` stands for any run of characters within one part, `?` for
#   one character within a part, `[abc]` and `[a-z]` for one character of a
#   class, `[!abc]` or `[^abc]` for one outside it, and a part that is `**`
#   alone for any number of whole parts, none included, or for one or more
#   where it ends the pattern, so `a/**` matches what `a` holds and not `a`
#   itself. A `]` first in a class and a `-` at either end of one stand for
#   themselves.
#
# Empty parts and `.` parts of both are skipped, and the volume and root of
# the pattern are compared as written with the path's. By POSIX's rules `\`
# before a character makes it stand for itself; by Windows' rules `\` is a
# separator, a character stands for itself inside a class, and ASCII letters
# match without their case. Fails `invalid` where the pattern is malformed, a
# class left open or a `\` at its end, whatever the path. It takes time in
# proportion to the path times the pattern at most. The paths a pattern
# matches on the disk are `fs.glob`'s to find.
function matches(path: str, pattern: str) -> bool?
    return matches_by(path: path, pattern: pattern, rules: system_rules())

# What `matches` answers, by `rules` and not by the system's own.
#
# - `path`: the path to ask about.
# - `pattern`: the pattern, as `matches` reads it.
# - `rules`: the rules, whatever the system.
#
# Fails `invalid` where the pattern is malformed.
function matches_by(path: str, pattern: str, rules: Rules) -> bool?
    return wildcard.matches(path: path, pattern: pattern, windows: rules == .windows)

## Paths ignored, as git reads a gitignore file

# The patterns of one or more gitignore files, each with the folder it
# stands in, as git reads them: what `is_ignored` asks. Built by
# `parse_ignore` and grown by `with_ignore_file`; a value, so a copy grown
# leaves the one it was copied from as it was.
#
# The files of patterns outside a tree, git's `.git/info/exclude` and the
# file `core.excludesFile` names, are the caller's to read: given to
# `parse_ignore` first, before the root's own file is added at `""`, they
# stand where git puts them, below every gitignore file of the tree.
record Ignores
    # The files read, each with its folder, in the order they were added.
    files: [ignoring.PatternFile]

# The pattern that decides whether a path is ignored, as `ignore_pattern_of`
# answers it and `git check-ignore -v` prints it.
record IgnorePattern
    # The folder of the file it was read from, its names joined by `/`; ""
    # for the root's.
    dir: str
    # Its line in that file, from 1.
    line: i64
    # The pattern as its line writes it, its trailing spaces taken off and
    # its `!` and last `/` kept.
    text: str
    # Whether it opens with `!`, so the path it decides is not ignored.
    negated: bool

# The patterns of `text`, one gitignore file standing in the root's own
# folder.
#
# - `text`: the file's text, UTF-8, as gitignore(5) writes it; the empty
#   text holds no pattern, so nothing is ignored.
#
# A line is read as git 2.56 reads it: a byte order mark at the start and a
# carriage return before a line feed taken off; a blank line, and one whose
# first character is `#`, holding no pattern; trailing spaces taken off but
# one a `\` escapes; `!` first making a negation, which includes again what
# an earlier pattern ignored, and `\!` or `\#` a pattern that begins with that
# character; a `/` last making a pattern of folders alone; a `/` first or
# between names anchoring it to the folder of its file, where a pattern with
# none matches a last name at any depth below that folder. In a pattern `*`
# stands for any run of bytes but `/`, `?` for one byte but `/`, `[a-z]`,
# `[!a-z]`, `[^a-z]` and `[[:digit:]]` for one byte of a class or outside it,
# never `/`, and `\` before a byte for that byte; `**/` first stands for any
# number of folders, `/**/` for any number of folders between, none included,
# and `/**` last for everything inside. A pattern git would never match, one
# ending in a `\` that escapes nothing, holding a class left open or a class
# name git has not, matches nothing, as in git.
#
# git reads bytes, so `?` is one byte and not one character: `caff?` does
# not match `caffè`. See also `with_ignore_file`, `is_ignored`.
function parse_ignore(text: str) -> Ignores
    return Ignores(files: [ignoring.parsed(dir: "", text: text)])

# A copy of `ignores` with the patterns of one more gitignore file, standing
# in the folder `dir` below the root.
#
# - `ignores`: the patterns read so far.
# - `dir`: the folder the file stands in, below the root, its names joined
#   by `/`; empty and `.` names are left out, so `""`, `"."` and `"/"` name
#   the root itself.
# - `text`: the file's text, read as `parse_ignore` reads it.
#
# A file deeper in the tree decides before one above it, and of two files
# added for one folder the one added later decides first. See also
# `parse_ignore`.
function with_ignore_file(ignores: Ignores, dir: str, text: str) -> Ignores
    files: [ignoring.PatternFile] @= ignores.files
    files @ files.push(ignoring.parsed(dir: dir, text: text))
    return Ignores(files: files)

# Whether `ignores` ignore `path`, as `git check-ignore` answers.
#
# - `ignores`: the patterns.
# - `path`: the path asked, below the root, its names joined by `/`, as
#   `to_slash` writes a Windows path; empty and `.` names are left out, and a
#   `\` is part of a name, as git reads it on POSIX. The empty path is never
#   ignored.
# - `is_dir`: whether `path` names a folder, which a pattern ending in `/`
#   asks; the caller knows it, since nothing here reads the disk.
#
# It is ignored where a folder above it is ignored, whatever a negation says
# of it, since git never reads inside an ignored folder; else where the
# pattern that decides, the last that matches it in the deepest file that has
# one, is not a negation. It takes time in proportion to the patterns times
# the path's length, for each folder above the path.
#
# See also `ignore_pattern_of`, `fs.walk_ignoring`.
function is_ignored(ignores: Ignores, path: str, is_dir: bool) -> bool
    found = ignoring.decision(ignores.files, path: path, is_dir: is_dir)
    return found.found && !found.negated

# The pattern that decides whether `ignores` ignore `path`, as
# `git check-ignore -v` names it: what tells a person why a file is left out.
#
# - `ignores`: the patterns.
# - `path`: the path asked, as `is_ignored` reads it.
# - `is_dir`: whether `path` names a folder.
#
# It is the pattern that ignores the highest ignored folder above `path`
# where there is one, else the last that matches `path` in the deepest file
# that has one: a negation where `path` is included again.
#
# Fails `not_found` where no pattern matches `path` or a folder above it, so
# it is not ignored. See also `is_ignored`.
function ignore_pattern_of(ignores: Ignores, path: str, is_dir: bool) -> IgnorePattern?
    found = ignoring.decision(ignores.files, path: path, is_dir: is_dir)

    if !found.found
        return fail(code: NOT_FOUND, msg: f"no pattern decides whether \"{path}\" is ignored")
    return ok(IgnorePattern(dir: found.dir, line: found.line, text: found.text, negated: found.negated))

## Tests

test "system_rules: Windows' where a program's file takes `.exe`, POSIX's elsewhere"
    windows = hero_os.run_exe_suffix() == ".exe"
    assert system_rules() == .windows == windows
    assert sep() == sep_by(system_rules()) && list_sep() == list_sep_by(system_rules())

test "sep_by, list_sep_by and is_sep_by: each rules' own, and a text of another length"
    assert sep_by(.posix) == "/" && sep_by(.windows) == "\\"
    assert list_sep_by(.posix) == ":" && list_sep_by(.windows) == ";"
    assert is_sep_by("/", .posix) && !is_sep_by("\\", .posix) && is_sep_by("\\", .windows)
    assert !is_sep_by("", .windows) && !is_sep_by("//", .posix) && !is_sep_by("é", .windows)
    assert is_sep("/")

test "the short forms answer what their `_by` forms answer by the system's rules"
    rules = system_rules()
    path = "C:\\a/b.tar.gz"
    assert clean(path) == clean_by(path, rules) && parent(path) == parent_by(path, rules)
    assert name(path).must() == name_by(path, rules).must() && parts(path) == parts_by(path, rules)
    assert ext_all(path) == ext_all_by(path, rules) && ancestors(path) == ancestors_by(path, rules)
    assert is_abs(path) == is_abs_by(path, rules) && has_root(path) == has_root_by(path, rules)
    assert split_root(path) == split_root_by(path, rules) && to_slash(path) == to_slash_by(path, rules)
    assert join_all(["a", path]) == join_all_by(["a", path], rules)
    assert split_list("a;b:c") == split_list_by("a;b:c", rules)
    assert is_local(path) == is_local_by(path, rules) && is_reserved(path) == is_reserved_by(path, rules)
    assert matches(path: path, pattern: "**").must() == matches_by(path: path, pattern: "**", rules: rules).must()

test "split_root_by: three pieces that are the path, by each rules"
    assert split_root_by("C:\\x", .windows) == RootSplit(volume: "C:", root: "\\", rest: "x")
    assert split_root_by("C:\\x", .posix) == RootSplit(volume: "", root: "", rest: "C:\\x")
    assert split_root_by("//a", .posix) == RootSplit(volume: "", root: "//", rest: "a")
    assert split_root_by("", .windows) == RootSplit(volume: "", root: "", rest: "")

test "volume_by: a drive, a share, a device, and none by POSIX's rules"
    assert volume_by("c:x", .windows).must() == "c:"
    assert volume_by("//h/s/x", .windows).must() == "//h/s"
    assert volume_by("\\\\.\\pipe\\x", .windows).must() == "\\\\.\\pipe"

    match volume_by("C:\\x", .posix)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND && e.msg == "no volume begins \"C:\\x\""

    assert volume_by("\\x", .windows).is_err()

test "split_name_by: the parent and the name, and a path that ends in none"
    assert split_name_by("a/b/c.txt", .posix).must() == NameSplit(parent: "a/b", name: "c.txt")
    assert split_name_by("C:x", .windows).must() == NameSplit(parent: "C:", name: "x")
    assert split_name_by("a", .posix).must() == NameSplit(parent: ".", name: "a")

    match split_name_by("/", .posix)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

test "is_same_by and compare_by: cleaned, and the case set aside by Windows' rules alone"
    assert is_same_by(path: "a/./b/", other: "a/b", rules: .posix)
    assert !is_same_by(path: "A/b", other: "a/b", rules: .posix)
    assert is_same_by(path: "C:/A/b", other: "c:\\a\\B\\", rules: .windows)
    assert compare_by(path: "a", other: "a/b", rules: .posix) == -1

test "to_slash_by and from_slash_by: Windows' separators turned each way, POSIX's text kept"
    assert to_slash_by("C:\\a\\b/c", .windows) == "C:/a/b/c"
    assert to_slash_by("a\\b", .posix) == "a\\b"
    assert from_slash_by("C:/a/b\\c", .windows) == "C:\\a\\b\\c"
    assert from_slash_by("a/b", .posix) == "a/b"

## Examples

# The rules of this system, which every short form reads a path by.
test "system_rules: what the short forms read by"
    assert clean("a//b") == clean_by("a//b", system_rules())

# A path built by hand with this system's separator.
test "sep: a path built by hand"
    assert "usr" + sep() + "bin" == from_slash("usr/bin")

# Each rules' separator.
test "sep_by: POSIX's and Windows'"
    assert sep_by(.posix) == "/"
    assert sep_by(.windows) == "\\"

# A slash separates on every system; a letter never does.
test "is_sep: a slash and a letter"
    assert is_sep("/")
    assert !is_sep("a")

# A backslash separates by Windows' rules and is a character of a name by
# POSIX's.
test "is_sep_by: a backslash by each rules"
    assert is_sep_by("\\", .windows)
    assert !is_sep_by("\\", .posix)

# A list of two paths built with this system's list separator.
test "list_sep: a list built by hand"
    assert split_list("a" + list_sep() + "b") == ["a", "b"]

# Each rules' list separator.
test "list_sep_by: POSIX's and Windows'"
    assert list_sep_by(.posix) == ":"
    assert list_sep_by(.windows) == ";"

# The folders a PATH lists, cut by this system's separator.
test "split_list: the folders of a PATH"
    assert split_list("/usr/bin" + list_sep() + "/bin") == ["/usr/bin", "/bin"]

# A PATH of each system cut, Windows' with a quoted folder that holds a `;`.
test "split_list_by: POSIX's list and Windows' quoted one"
    assert split_list_by("/usr/bin:/bin", .posix) == ["/usr/bin", "/bin"]
    assert split_list_by("C:\\a;\"C:\\b;c\"", .windows) == ["C:\\a", "C:\\b;c"]

# A folder added to a list of folders, written back as one list.
test "join_list: a list written back"
    assert join_list(["/usr/bin", "/bin"]).must() == "/usr/bin" + list_sep() + "/bin"

# A list of each system written, a folder with a `:` refused by POSIX's rules.
test "join_list_by: POSIX's list, Windows' quoted one, and a path refused"
    assert join_list_by(["/usr/bin", "/bin"], .posix).must() == "/usr/bin:/bin"
    assert join_list_by(["C:\\b;c"], .windows).must() == "\"C:\\b;c\""
    assert join_list_by(["/usr/bi:n"], .posix).is_err()

# A path cleaned of repeated separators, `.` and `..`.
test "clean: a path written carelessly"
    assert to_slash(clean("a//b/../c/.")) == "a/c"

# A path cleaned by each rules.
test "clean_by: by POSIX's rules and by Windows'"
    assert clean_by("/a/./b/../c/", .posix) == "/a/c"
    assert clean_by("C:/a/../b", .windows) == "C:\\b"

# Folder names joined into one path.
test "join_all: folders into a path"
    assert to_slash(join_all(["usr", "local", "bin"])) == "usr/local/bin"

# An absolute path among the parts starts the path over.
test "join_all_by: a later absolute path starts over"
    assert join_all_by(["/usr", "lib"], .posix) == "/usr/lib"
    assert join_all_by(["a", "/etc"], .posix) == "/etc"

# The folder a file stands in.
test "parent: the folder of a file"
    assert to_slash(parent("docs/notes/today.md")) == "docs/notes"

# The parent of an absolute path, and of a path of one part.
test "parent_by: an absolute path and a name alone"
    assert parent_by("/a/b", .posix) == "/a"
    assert parent_by("a", .posix) == "."

# A file's name, and a path that ends in none.
test "name: a file's name, and `..`"
    assert name("docs/today.md").must() == "today.md"
    assert name("..").is_err()

# A Windows path's name, read on any system.
test "name_by: a name by Windows' rules"
    assert name_by("C:\\a\\b.txt", .windows).must() == "b.txt"

# A name without its last extension.
test "stem: an archive's name"
    assert stem("a/b.tar.gz").must() == "b.tar"

# A Windows path's stem.
test "stem_by: by Windows' rules"
    assert stem_by("C:\\a\\report.pdf", .windows).must() == "report"

# A name without any extension.
test "stem_all: an archive's name"
    assert stem_all("a/b.tar.gz").must() == "b"

# A Windows path's name without any extension.
test "stem_all_by: by Windows' rules"
    assert stem_all_by("C:\\a\\b.tar.gz", .windows).must() == "b"

# A file's extension, and a hidden file that has none.
test "ext: an archive's last extension, and a dotfile"
    assert ext("a/b.tar.gz").must() == ".gz"
    assert ext(".bashrc").is_err()

# A Windows path's extension.
test "ext_by: by Windows' rules"
    assert ext_by("C:\\a\\b.TXT", .windows).must() == ".TXT"

# Every extension of a name.
test "ext_all: an archive's extensions"
    assert ext_all("a/b.tar.gz") == [".tar", ".gz"]

# Every extension of a Windows path's name.
test "ext_all_by: by Windows' rules"
    assert ext_all_by("C:\\b.tar.gz", .windows) == [".tar", ".gz"]

# A path cut into its folder and its name.
test "split_name: a folder and a name"
    s = split_name("docs/today.md").must()
    assert to_slash(s.parent) == "docs" && s.name == "today.md"

# A Windows path cut into its folder and its name.
test "split_name_by: by Windows' rules"
    assert split_name_by("C:\\a\\b.txt", .windows).must() == NameSplit(parent: "C:\\a", name: "b.txt")

# The parts of a path, empty ones skipped.
test "parts: a relative path"
    assert parts("usr//lib/") == ["usr", "lib"]

# The parts of an absolute path, its root first.
test "parts_by: a root and a volume as the first part"
    assert parts_by("/usr//lib/", .posix) == ["/", "usr", "lib"]
    assert parts_by("C:/a", .windows) == ["C:\\", "a"]

# Every folder above a relative path, nearest first.
test "ancestors: the folders above a file"
    assert ancestors("a/b/c").map(to_slash) == ["a/b", "a", "."]

# Every folder above an absolute path.
test "ancestors_by: up to the root"
    assert ancestors_by("/a/b", .posix) == ["/a", "/"]

# A relative path names a place only from where the program stands.
test "is_abs: a relative path"
    assert !is_abs("notes/today.md")

# What is absolute by each rules.
test "is_abs_by: a root alone, and a drive with a root"
    assert is_abs_by("/usr", .posix)
    assert !is_abs_by("/usr", .windows)
    assert is_abs_by("C:\\Users", .windows)

# A path from the top of its volume, and one from where the program stands.
test "has_root: a rooted path and a relative one"
    assert has_root("/a")
    assert !has_root("a/b")

# By Windows' rules a drive without its root has none.
test "has_root_by: a drive with and without a root"
    assert has_root_by("C:\\a", .windows)
    assert !has_root_by("C:a", .windows)

# A relative path begins with no volume.
test "volume: none in a relative path"
    assert volume("a/b").is_err()

# A drive and a share by Windows' rules.
test "volume_by: a drive and a share"
    assert volume_by("C:\\a", .windows).must() == "C:"
    assert volume_by("\\\\host\\share\\x", .windows).must() == "\\\\host\\share"

# A relative path is all rest.
test "split_root: a relative path"
    assert split_root("a/b") == RootSplit(volume: "", root: "", rest: "a/b")

# A Windows path in its three pieces.
test "split_root_by: a drive, its root and the rest"
    assert split_root_by("C:\\x", .windows) == RootSplit(volume: "C:", root: "\\", rest: "x")

# The way from a project's folder to a file inside it.
test "relative: a file below a folder"
    assert to_slash(relative(path: "a/b/c", base: "a").must()) == "b/c"

# The way up and across, by POSIX's rules.
test "relative_by: up one folder and down another"
    assert relative_by(path: "/a/x", base: "/a/b", rules: .posix).must() == "../x"

# A path below a folder, and one that climbs out of it.
test "is_under: inside, and out through `..`"
    assert is_under(path: "a/b", root: "a")
    assert !is_under(path: "a/../b", root: "a")

# A Windows path under a folder, the case of its letters set aside.
test "is_under_by: by Windows' rules"
    assert is_under_by(path: "C:\\Data\\x", root: "c:\\data", rules: .windows)

# A path's last parts, whole parts only.
test "has_tail: a file's name and part of it"
    assert has_tail(path: "etc/resolv.conf", tail: "resolv.conf")
    assert !has_tail(path: "etc/resolv.conf", tail: "conf")

# A Windows path's last two parts.
test "has_tail_by: by Windows' rules"
    assert has_tail_by(path: "C:\\etc\\hosts", tail: "etc/hosts", rules: .windows)

# A path from an archive that stays where it is unpacked, and one that climbs
# out.
test "is_local: staying in, and climbing out"
    assert is_local("a/../b")
    assert !is_local("a/../../b")

# A drive is no local path by Windows' rules, and a plain name by POSIX's.
test "is_local_by: `C:a` by each rules"
    assert !is_local_by("C:a", .windows)
    assert is_local_by("C:a", .posix)

# An ordinary name is reserved nowhere.
test "is_reserved: an ordinary name"
    assert !is_reserved("a/notes.txt")

# A device's name Windows keeps for itself, whatever its extension.
test "is_reserved_by: `NUL.txt` by each rules"
    assert is_reserved_by("NUL.txt", .windows)
    assert !is_reserved_by("NUL.txt", .posix)

# A path read from an archive made a path of this system, and one that would
# climb out refused.
test "localize: an archive's path, and one that climbs"
    assert to_slash(localize("docs/a.txt").must()) == "docs/a.txt"
    assert localize("../a").is_err()

# By Windows' rules a colon cannot stand in a name.
test "localize_by: by Windows' rules"
    assert localize_by("a/b", .windows).must() == "a\\b"
    assert localize_by("a:b", .windows).is_err()

# The folder two paths share.
test "common: two paths under one folder"
    assert to_slash(common(["usr/lib", "usr/local/bin"]).must()) == "usr"

# The folder two absolute paths share.
test "common_by: by POSIX's rules"
    assert common_by(["/usr/lib", "/usr/local/bin"], .posix).must() == "/usr"

# Two texts of one path.
test "is_same: a path written two ways"
    assert is_same(path: "a/./b/", other: "a/b")

# By Windows' rules case and separators do not count.
test "is_same_by: by Windows' rules"
    assert is_same_by(path: "C:/A/b", other: "c:\\a\\B\\", rules: .windows)

# A folder sorts before what it holds.
test "compare: a folder before its contents"
    assert compare(path: "a", other: "a/b") < 0

# By Windows' rules two cases of one name are the same.
test "compare_by: by Windows' rules"
    assert compare_by(path: "A", other: "a", rules: .windows) == 0

# A file renamed in its folder.
test "with_name: a new name"
    assert to_slash(with_name(path: "a/b.txt", to: "c").must()) == "a/c"

# A Windows file renamed in its folder.
test "with_name_by: by Windows' rules"
    assert with_name_by(path: "C:\\a\\b.txt", to: "c.md", rules: .windows).must() == "C:\\a\\c.md"

# A file's stem changed, its extension kept.
test "with_stem: a new stem"
    assert to_slash(with_stem(path: "a/b.txt", to: "c").must()) == "a/c.txt"

# A Windows file's stem changed.
test "with_stem_by: by Windows' rules"
    assert with_stem_by(path: "C:\\a\\b.txt", to: "c", rules: .windows).must() == "C:\\a\\c.txt"

# A file's extension changed, and removed.
test "with_ext: a new extension, and none"
    assert to_slash(with_ext(path: "a/b.txt", to: ".md").must()) == "a/b.md"
    assert to_slash(with_ext(path: "a/b.txt", to: "").must()) == "a/b"

# A Windows file's extension changed.
test "with_ext_by: by Windows' rules"
    assert with_ext_by(path: "C:\\a\\b.txt", to: ".md", rules: .windows).must() == "C:\\a\\b.md"

# A path built on this system written as a URL writes it.
test "to_slash: a path for a URL"
    assert to_slash(join_all(["a", "b"])) == "a/b"

# Windows' separators turned to slashes, on any system.
test "to_slash_by: by Windows' rules"
    assert to_slash_by("C:\\a\\b", .windows) == "C:/a/b"

# A path from a configuration file made a path of this system.
test "from_slash: a configured path"
    assert from_slash("a/b") == join_all(["a", "b"])

# Slashes turned to Windows' separators, on any system.
test "from_slash_by: by Windows' rules"
    assert from_slash_by("a/b", .windows) == "a\\b"

# A trailing separator says a folder is meant.
test "has_trailing_sep: a folder meant, and a name"
    assert has_trailing_sep("a/")
    assert !has_trailing_sep("a")

# A root alone has no trailing separator.
test "has_trailing_sep_by: the root"
    assert !has_trailing_sep_by("/", .posix)

# A separator added to say a folder is meant.
test "with_trailing_sep: a folder"
    assert to_slash(with_trailing_sep("a")) == "a/"

# A separator after the empty path, which a `.` keeps from being a root.
test "with_trailing_sep_by: the empty path"
    assert with_trailing_sep_by("", .posix) == "./"

# The separators at a path's end taken off.
test "trim_trailing_sep: a folder"
    assert trim_trailing_sep("a//") == "a"

# A root keeps its separator.
test "trim_trailing_sep_by: the root"
    assert trim_trailing_sep_by("/", .posix) == "/"

# Source files matched by a pattern, and everything below a folder.
test "matches: a pattern within a part, and one across parts"
    assert matches(path: "src/main.go", pattern: "src/*.go").must()
    assert matches(path: "a/b/c.txt", pattern: "a/**").must()
    assert !matches(path: "src/sub/main.go", pattern: "src/*.go").must()

# By Windows' rules letters match without their case.
test "matches_by: case set aside by Windows' rules"
    assert matches_by(path: "README.MD", pattern: "*.md", rules: .windows).must()
    assert !matches_by(path: "README.MD", pattern: "*.md", rules: .posix).must()

# The patterns of one file asked of a file and a folder.
test "parse_ignore: a project's own patterns read"
    ignores = parse_ignore("*.o\nbuild/\n!keep.o\n")
    assert is_ignored(ignores, path: "src/main.o", is_dir: false)
    assert !is_ignored(ignores, path: "src/keep.o", is_dir: false)

# A folder's own file deciding before the root's.
test "with_ignore_file: a folder's patterns over the root's"
    ignores = with_ignore_file(parse_ignore("*.log\n"), dir: "logs", text: "!today.log\n")
    assert is_ignored(ignores, path: "old.log", is_dir: false)
    assert !is_ignored(ignores, path: "logs/today.log", is_dir: false)

# A file inside an ignored folder, which no negation brings back.
test "is_ignored: a file below an ignored folder"
    ignores = parse_ignore("build/\n!build/keep\n")
    assert is_ignored(ignores, path: "build/keep", is_dir: false)
    assert !is_ignored(ignores, path: "src/build", is_dir: false)

# Why a path is left out, as `git check-ignore -v` tells it.
test "ignore_pattern_of: the line that ignores a file"
    found = ignore_pattern_of(parse_ignore("# objects\n*.o\n"), path: "a/b.o", is_dir: false).must()
    assert found == IgnorePattern(dir: "", line: 2, text: "*.o", negated: false)
