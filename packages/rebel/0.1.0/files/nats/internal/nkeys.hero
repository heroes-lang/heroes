# NATS's NKeys: Ed25519 keys written as text, a seed as 58 characters and a
# public key as 56, each base 32 (RFC 4648, no padding) of a prefix naming
# its kind, the key's 32 bytes and a CRC-16 (XMODEM) of them, least
# significant byte first. The arithmetic of a key is `crypto/keypairs`',
# the system's own; this module reads and writes the text, and the
# credentials file that holds a user's JWT beside its seed.

use bytes
use crypto/keypairs
use nats/internal/model
use strings

# The base 32 alphabet of RFC 4648.
constant ALPHABET: str
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# The prefix of a seed's first byte, 18 << 3.
constant SEED_BYTE: i64
    144

# The prefix of a user's key, `U`: 20 << 3.
constant USER: i64
    160

# What a seed holds: the prefix of the kind of its key, and its 32 bytes.
record Seed
    # The kind's prefix byte: 0 an account, 112 an operator, 160 a user,
    # 104 a server, 16 a cluster.
    prefix: i64
    # The Ed25519 seed's 32 bytes.
    raw: [u8]

# `data` in base 32, no padding.
#
# - `data`: the bytes.
function base32(data: [u8]) -> str
    out: [str] @= []
    held: i64 @= 0
    bits: i64 @= 0

    for b in data
        held @ held << 8 | to_i64(b).must()
        bits @ bits + 8

        while bits >= 5
            at = held >> bits - 5 & 31
            out @ out.push(ALPHABET.slice(from: at, to: at + 1))
            bits @ bits - 5
            held @ held & (1 << bits) - 1

    if bits > 0
        at = held << 5 - bits & 31
        out @ out.push(ALPHABET.slice(from: at, to: at + 1))
    return out.join("")

# The bytes `text` writes in base 32, no padding.
#
# - `text`: the characters, upper case.
#
# Fails `invalid` where a character is none of the alphabet's.
function unbase32(text: str) -> [u8]?
    out: [u8] @= []
    held: i64 @= 0
    bits: i64 @= 0

    for at in range(from: 0, to: text.len())
        c = text[at]
        v: i64 @= -1

        if c >= 'A' && c <= 'Z'
            v @ to_i64(c - 'A').must()
        else if c >= '2' && c <= '7'
            v @ to_i64(c - '2').must() + 26

        if v < 0
            return fail(code: model.INVALID, msg: f"byte {at} of the key is no character of base 32")
        held @ held << 5 | v
        bits @ bits + 5

        if bits >= 8
            out @ out.push(to_u8(held >> bits - 8 & 255).must())
            bits @ bits - 8
            held @ held & (1 << bits) - 1

    return ok(out)

# The CRC-16 of `data` by XMODEM's rule: polynomial 0x1021, from 0.
#
# - `data`: the bytes.
function crc16(data: [u8]) -> i64
    crc: i64 @= 0

    for b in data
        crc @ crc ^ to_i64(b).must() << 8

        for _ in range(from: 0, to: 8)
            if crc & 32768 != 0
                crc @ (crc << 1 ^ 4129) & 65535
            else
                crc @ crc << 1 & 65535

    return crc

# `body` with its CRC-16 after it, least significant byte first, in base 32.
#
# - `body`: the prefix bytes and the key.
function encode(body: [u8]) -> str
    out @= body
    crc = crc16(body)
    out @ out.push(to_u8(crc & 255).must())
    out @ out.push(to_u8(crc >> 8).must())
    return base32(out)

# The bytes `text` writes before its CRC-16, the CRC checked.
#
# - `text`: a key or a seed.
# - `length`: the bytes expected with the CRC, 35 for a public key, 36 for a
#   seed.
function decode(text: str, length: i64) -> [u8]?
    raw = unbase32(text)?

    if raw.len() != length
        return fail(code: model.INVALID, msg: f"\"{text}\" is no key: it holds {raw.len()} bytes, not {length}")
    body = raw.slice(from: 0, to: length - 2)
    said = to_i64(raw[length - 2]).must() | to_i64(raw[length - 1]).must() << 8

    if crc16(body) != said
        return fail(code: model.INVALID, msg: f"\"{text}\" is no key: its checksum does not hold")
    return ok(body)

# Whether `prefix` names a kind of NKey that signs: an account, an
# operator, a user, a server or a cluster.
#
# - `prefix`: the prefix byte.
function is_signing_prefix(prefix: i64) -> bool
    return prefix == 0 || prefix == 112 || prefix == USER || prefix == 104 || prefix == 16

# The kind and the key a seed's text holds.
#
# - `seed`: the seed, 58 characters beginning `S`.
#
# Fails `invalid` where it is no seed of a key that signs.
function read_seed(seed: str) -> Seed?
    body = decode(seed, length: 36)?
    b0 = to_i64(body[0]).must()
    b1 = to_i64(body[1]).must()

    if b0 & 248 != SEED_BYTE
        return fail(code: model.INVALID, msg: "the text is no NKey seed: it does not begin with S")
    prefix = (b0 & 7) << 5 | (b1 & 248) >> 3

    if !is_signing_prefix(prefix)
        return fail(code: model.INVALID, msg: "the seed's key is of no kind that signs")
    return ok(Seed(prefix: prefix, raw: body.slice(from: 2, to: 34)))

# A seed's text, of the kind `prefix` and the key `raw`.
#
# - `prefix`: the kind's prefix byte.
# - `raw`: the 32 bytes.
function write_seed(prefix: i64, raw: [u8]) -> str
    body: [u8] @= [to_u8(SEED_BYTE | prefix >> 5).must(), to_u8((prefix & 31) << 3).must()]
    bytes.push_all(to: @body, from: raw)
    return encode(body)

# A public key's text, of the kind `prefix` and the key `raw`.
#
# - `prefix`: the kind's prefix byte.
# - `raw`: the 32 bytes.
function write_public(prefix: i64, raw: [u8]) -> str
    body: [u8] @= [to_u8(prefix).must()]
    bytes.push_all(to: @body, from: raw)
    return encode(body)

# The private key a seed's text holds, for the caller to close.
#
# - `seed`: the seed.
function private_of(seed: str) -> keypairs.PrivateKey?
    s = read_seed(seed)?
    return keypairs.parse_private_raw(kind: .ed25519, raw: s.raw)

# The public key of a seed, as text.
#
# - `seed`: the seed.
function public_of(seed: str) -> str?
    s = read_seed(seed)?
    key @= keypairs.parse_private_raw(kind: .ed25519, raw: s.raw)?

    raw = match keypairs.public_of(key)
        .err e =>
            _ = keypairs.close_private(@key).is_err()
            return fail(code: e.code, msg: e.msg)
        .ok got =>
            pk @= got
            answer = keypairs.format_public_raw(pk)
            _ = keypairs.close_public(@pk).is_err()
            answer

    _ = keypairs.close_private(@key).is_err()
    return ok(write_public(prefix: s.prefix, raw: raw?))

# The signature of `data` by the seed's key.
#
# - `seed`: the seed.
# - `data`: the bytes signed.
function sign(seed: str, data: [u8]) -> [u8]?
    key @= private_of(seed)?
    signed = keypairs.sign(key, scheme: .ed25519, message: data)
    _ = keypairs.close_private(@key).is_err()
    return signed

# Whether `signature` signs `data` by the key `public_key` writes.
#
# - `public_key`: the public key's text.
# - `data`: the bytes signed.
# - `signature`: the signature.
function verify(public_key: str, data: [u8], signature: [u8]) -> bool?
    body = decode(public_key, length: 35)?

    if !is_signing_prefix(to_i64(body[0]).must())
        return fail(code: model.INVALID, msg: f"\"{public_key}\" is no public key of a kind that signs")
    key @= keypairs.parse_public_raw(kind: .ed25519, raw: body.slice(from: 1, to: 33))?
    held = keypairs.verify(key, scheme: .ed25519, message: data, signature: signature)
    _ = keypairs.close_public(@key).is_err()
    return held

# A new user's seed.
function generate_user() -> str?
    key @= keypairs.generate(.ed25519)?
    raw = keypairs.format_private_raw(key)
    _ = keypairs.close_private(@key).is_err()
    return ok(write_seed(prefix: USER, raw: raw?))

# The content of the block whose opening line holds `label`: the first line
# after it that is not empty, trimmed.
#
# - `lines`: the file's lines.
# - `label`: the words of the opening line, `NATS USER JWT`.
function block_of(lines: [str], label: str) -> str?
    at: i64 @= 0

    while at < lines.len()
        line = strings.trim(lines[at])

        if strings.has_prefix(s: line, prefix: "---") && strings.contains(s: line, substr: "BEGIN " + label)
            next: i64 @= at + 1

            while next < lines.len() && strings.trim(lines[next]) == ""
                next @ next + 1

            if next < lines.len()
                content = strings.trim(lines[next])

                if content != "" && !strings.has_prefix(s: content, prefix: "---")
                    return ok(content)
            return fail(code: model.INVALID, msg: f"the block {label} of the credentials is empty")
        at @ at + 1

    return fail(code: model.INVALID, msg: f"the credentials hold no block {label}")

# The JWT and the seed of a credentials file.
#
# - `text`: the file's text.
function credentials(text: str) -> model.Auth?
    lines = strings.split(s: text, sep: "\n")
    jwt = block_of(lines, label: "NATS USER JWT")?
    seed = block_of(lines, label: "USER NKEY SEED")?
    return ok(.credentials(jwt: jwt, seed: seed))

# The raw seed of 0, 1, 2 ... 31, which Go's nkeys answered for the tests.
function counting_seed() -> [u8]
    raw: [u8] @= []

    for at in range(from: 0, to: 32)
        raw @ raw.push(to_u8(at).must())

    return raw

test "crc16: XMODEM's check value of 123456789, and of nothing"
    assert crc16(bytes.from_text("123456789")) == 12739 && crc16([]) == 0

test "base32: nothing, one byte, five, and back"
    assert base32([]) == "" && base32([0]) == "AA" && base32(bytes.from_text("hello")) == "NBSWY3DP"
    assert unbase32("NBSWY3DP").must() == bytes.from_text("hello") && unbase32("").must() == []

test "unbase32: a lower-case letter, a 1, a padding"
    assert unbase32("nb").is_err() && unbase32("A1").is_err() && unbase32("AA==").is_err()

test "write_seed and write_public: the texts Go's nkeys answered for the bytes 0 to 31, a user's and an account's"
    assert write_seed(prefix: USER, raw: counting_seed()) == "SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y"
    assert write_seed(prefix: 0, raw: counting_seed()) == "SAAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4HYMHI"

test "read_seed: a user's, an account's, a checksum broken, a public key, a length cut"
    s = read_seed("SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y").must()
    assert s.prefix == USER && s.raw == counting_seed()
    assert read_seed("SAAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4HYMHI").must().prefix == 0
    assert read_seed("SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H766Y").is_err()
    assert read_seed("UAB2CB576PHBBPQ5ODORRZ2LYCMWPZGWGCN2KDK7DXOIMZASKUY3RLKK").is_err()
    assert read_seed("SUAAAAICAMCAKBQH").is_err()

test "public_of, sign and verify: Go's public key and signature for the bytes 0 to 31, where the system has Ed25519"
    seed = "SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y"

    if keypairs.is_available(.ed25519)
        pub = public_of(seed).must()
        assert pub == "UAB2CB576PHBBPQ5ODORRZ2LYCMWPZGWGCN2KDK7DXOIMZASKUY3RLKK"
        sig = sign(seed, data: bytes.from_text("abc")).must()
        assert bytes.format_base64_url_unpadded(sig) == "zEbWLTdU9BdUsntuosssJyuvp6Wh9gYr0GD0FOUMqurC2matOc70QkqQI26pB7fYBX40Q9xav8mYaWfuchOkBw"
        assert verify(public_key: pub, data: bytes.from_text("abc"), signature: sig).must()
        assert !verify(public_key: pub, data: bytes.from_text("abd"), signature: sig).must()
        fresh = generate_user().must()
        assert strings.has_prefix(s: fresh, prefix: "SU") && fresh.len() == 58
        assert verify(
            public_key: public_of(fresh).must(),
            data: [1, 2],
            signature: sign(fresh, data: [1, 2]).must()
        ).must()
    else
        match public_of(seed)
            .ok _  => assert false
            .err e => assert e.code == "unsupported"

test "verify: a public key that is a seed, and one broken"
    assert verify(
        public_key: "SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y",
        data: [],
        signature: []
    ).is_err()
    assert verify(
        public_key: "UAB2CB576PHBBPQ5ODORRZ2LYCMWPZGWGCN2KDK7DXOIMZASKUY3RLKA",
        data: [],
        signature: []
    ).is_err()

test "credentials: a file as nsc writes it, one with no seed, one with an empty block"
    text = "-----BEGIN NATS USER JWT-----\neyJ0eXAi.abc.def\n------END NATS USER JWT------\n\n************************* IMPORTANT *************************\n\n-----BEGIN USER NKEY SEED-----\nSUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y\n------END USER NKEY SEED------\n"

    match credentials(text).must()
        .credentials c                       => assert c.jwt == "eyJ0eXAi.abc.def" && c.seed == "SUAAAAICAMCAKBQHBAEQUCYMBUHA6EARCIJRIFIWC4MBSGQ3DQOR4H776Y"
        .none | .token _ | .user _ | .nkey _ => assert false

    assert credentials("-----BEGIN NATS USER JWT-----\nabc\n------END NATS USER JWT------\n").is_err()
    assert credentials(
        "-----BEGIN NATS USER JWT-----\n\n------END NATS USER JWT------\n-----BEGIN USER NKEY SEED-----\nS\n"
    ).is_err()
