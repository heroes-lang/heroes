# What carries a client's bytes: a TCP connection of `net`, a TLS stream of
# `tls`, or a WebSocket of `websocket`, read, written, given a deadline and
# closed alike. A read answers what one read brings; the end of the
# connection is a failure `closed`, so a caller never stands still on it.

use bytes
use io
use nats/internal/model
use net
use time
use tls
use websocket

# The bytes asked of a stream at a time.
constant CHUNK: i64
    65536

# The most bytes of one WebSocket frame or message read: 8 MiB, past a
# message of the largest payload a server is usually given.
constant MOST_FRAME: i64
    8388608

# What carries the bytes.
variant Link
    # A TCP connection of `net` or a TLS stream of `tls`, one `io.Stream`
    # whose deadline `tls.set_deadline` moves alike.
    connected
        # The connection's stream.
        stream: io.Stream
        # Whether it is TLS.
        secured: bool
    # A WebSocket, binary messages carrying the protocol's bytes.
    socket
        # The connection.
        conn: websocket.Conn
    # Nothing: closed, or not connected yet.
    gone

# The failure of a link that carries nothing.
#
# - `target`: how the server is named.
function closed_failure<T>(target: str) -> T?
    return fail(code: model.CLOSED, msg: f"the connection to {target} is closed")

# The time `ms` milliseconds stand for as `tls` takes it: 0, no limit in
# this package's private modules, is `time.max_duration()`, and a count past
# what a `time.Duration` holds is `time.max_duration()` too.
#
# - `ms`: milliseconds, 0 for no limit.
function tls_deadline(ms: i64) -> time.Duration?
    if ms == 0
        return ok(time.max_duration())
    return ok(time.milliseconds(ms).default(time.max_duration()))

# The whole milliseconds of `d`, a part of one counting as a whole one, as
# the session counts its waits; below zero, -1, which the session refuses.
#
# - `d`: a time the face was handed.
function ms_of(d: time.Duration) -> i64
    if d.nanoseconds < 0
        return -1
    whole = d.nanoseconds / 1_000_000

    if d.nanoseconds % 1_000_000 != 0
        return whole + 1
    return whole

# The milliseconds of `d` where the session reads 0 as none:
# `time.max_duration()` is 0; any other is rounded up to a whole
# millisecond and is 1 at least; below zero, -1.
#
# - `d`: a time the face was handed.
function none_ms_of(d: time.Duration) -> i64
    if d == time.max_duration()
        return 0
    ms = ms_of(d)

    if ms == 0
        return 1
    return ms

# The whole seconds of `d`, a part of one counting as a whole one, as a
# keep-alive is sent; below zero, -1.
#
# - `d`: a time the face was handed.
function seconds_of(d: time.Duration) -> i64
    if d.nanoseconds < 0
        return -1
    whole = d.nanoseconds / 1_000_000_000

    if d.nanoseconds % 1_000_000_000 != 0
        return whole + 1
    return whole

# A TCP connection to `host` at `port`, made within `ms`.
#
# - `host`: the host.
# - `port`: the port.
# - `ms`: milliseconds, 1 or more.
function open_plain(host: str, port: i64, ms: i64) -> Link?
    c = net.connect_timeout(host, port: port, timeout_ms: ms, deadline_ms: net.FOREVER)?
    return ok(.connected(stream: c.stream, secured: false))

# A TLS connection to `host` at `port`, TLS from its first byte.
#
# - `host`: the host, which the certificate must name.
# - `port`: the port.
# - `ms`: milliseconds the connection and its handshake may take.
# - `roots`: the authorities trusted, "" for the system's.
function open_tls(host: str, port: i64, ms: i64, roots: str) -> Link?
    s = tls.connect(host: host, port: port, deadline: tls_deadline(ms)?, client: tls.Client(roots: roots, protocols: []))?.stream
    return ok(.connected(stream: s, secured: true))

# A TLS connection to `host` at `port` begun after the server's first line,
# which begins `INFO` and is read and dropped below TLS.
#
# - `host`: the host.
# - `port`: the port.
# - `ms`: milliseconds the whole may take.
# - `roots`: the authorities trusted.
function open_after_info(host: str, port: i64, ms: i64, roots: str) -> Link?
    s = tls.connect_after(host: host, port: port, deadline: tls_deadline(ms)?, client: tls.Client(roots: roots, protocols: []), steps: [.expect_line(prefix: "INFO")])?.stream
    return ok(.connected(stream: s, secured: true))

# A WebSocket to `target`.
#
# - `target`: a `ws://` or `wss://` URL.
# - `ms`: milliseconds the connection and its handshake may take.
# - `roots`: the authorities trusted for `wss://`.
function open_socket(target: str, ms: i64, roots: str) -> Link?
    client @= websocket.default_client()
    client.tls @ tls.Client(roots: roots, protocols: [])
    client.deadline @ tls_deadline(ms)?
    client.redirects @ 0
    client.settings.frame_bytes @ MOST_FRAME
    client.settings.message_bytes @ MOST_FRAME
    client.settings.close_wait @ time.seconds(1).must()
    c = websocket.connect(target, client: client)?
    return ok(.socket(conn: c))

# TLS begun over the TCP connection `l`, as the client of `host`.
#
# - `l`: a plain link; its connection is the TLS stream's from then on, or
#   closed where TLS cannot begin.
# - `host`: the host the certificate must name.
# - `roots`: the authorities trusted.
#
# Fails as `tls.client_over` fails, `unsupported` on macOS.
function upgrade(@l: Link, host: str, roots: str) -> ()?
    match l
        .connected c =>
            if c.secured
                return ok()
            inner @= c.stream

            match tls.client_over(@inner, host: host, client: tls.Client(roots: roots, protocols: []))
                .ok s =>
                    l @ .connected(stream: s, secured: true)
                    return ok()
                .err e =>
                    _ = io.close(@inner).is_err()
                    l @ .gone
                    return fail(code: e.code, msg: e.msg)
        .socket _ | .gone => return fail(code: model.UNSUPPORTED, msg: "TLS begins only over a TCP connection")

# Whether `l` is TLS, or a WebSocket over TLS.
#
# - `l`: the link.
# - `secure`: whether a WebSocket was made over TLS.
function is_secured(l: Link, secure: bool) -> bool
    return match l
        .connected c => c.secured
        .socket _    => secure
        .gone        => false

# Makes every read and write of `l` end by `ms` milliseconds from now, 0
# for none.
#
# - `l`: the link.
# - `ms`: milliseconds, 0 or more.
function arm(l: Link, ms: i64) -> ()?
    return match l
        .connected c => tls.set_deadline(c.stream, deadline: tls_deadline(ms)?)
        .socket w    => websocket.set_deadline(w.conn, deadline: tls_deadline(ms)?)
        .gone        => fail(code: model.CLOSED, msg: "the connection is closed")

# The bytes one read of `l` brings: at least one from a TCP or TLS stream;
# from a WebSocket, the data of every message the read completes, joined in
# order, and none where it completes none. A WebSocket's read takes every
# message it completes because one read of its stream may bring several,
# and a message the WebSocket kept is one `poll`, the stream drained, never
# tells a program of (defect 2675).
#
# - `l`: the link; a WebSocket's state moves.
# - `target`: how the server is named.
#
# Fails `closed` where the server ended the connection, and as the read
# fails.
function read(@l: Link, target: str) -> [u8]?
    match l
        .connected c =>
            got = io.read(c.stream, n: CHUNK)?

            if got.len() == 0
                return fail(code: model.CLOSED, msg: f"{target} closed the connection")
            return ok(got)
        .socket w =>
            c @= w.conn
            answer = websocket.read_ready(@c)
            l @ .socket(conn: c)
            joined: [u8] @= []

            for m in answer?
                bytes.push_all(to: @joined, from: websocket.data_of(m))

            return ok(joined)
        .gone => return closed_failure(target)

# Writes `data` to `l`.
#
# - `l`: the link.
# - `data`: the bytes.
function write(@l: Link, data: [u8]) -> ()?
    match l
        .connected c => return io.write(c.stream, data: data)
        .socket w =>
            c @= w.conn
            done = websocket.write_binary(@c, data: data)
            l @ .socket(conn: c)
            return done
        .gone => return fail(code: model.CLOSED, msg: "the connection is closed")

# Closes `l`, whatever it holds, and leaves it `gone`.
#
# - `l`: the link.
function close(@l: Link)
    match l
        .connected c =>
            s @= c.stream
            _ = io.close(@s).is_err()
        .socket w =>
            c @= w.conn
            _ = websocket.drop(@c).is_err()
        .gone => _ = 0

    l @ .gone

# Whether `l` carries nothing.
#
# - `l`: the link.
function is_gone(l: Link) -> bool
    return match l
        .gone                    => true
        .connected _ | .socket _ => false

# The stream under `l`, for a program that waits on it.
#
# - `l`: the link.
function stream_of(l: Link) -> io.Stream?
    return match l
        .connected c => ok(c.stream)
        .socket w    => ok(w.conn.stream)
        .gone        => fail(code: model.CLOSED, msg: "the client is closed")

test "a link over a pair of connections: written, read, armed, closed, and gone after"
    two = net.pair(5000).must()
    l: Link @= .connected(stream: two.first.stream, secured: false)
    peer @= two.second.stream
    write(@l, data: [1, 2, 3]).must()
    assert io.read_exact(peer, n: 3).must() == [1, 2, 3]
    io.write(peer, data: [9]).must()
    assert read(@l, target: "t").must() == [9]
    arm(l, ms: 50).must()

    match read(@l, target: "t")
        .ok _  => assert false
        .err e => assert e.code == "timeout"

    io.close(@peer).must()
    arm(l, ms: 0).must()

    match read(@l, target: "t")
        .ok _  => assert false
        .err e => assert e.code == "closed"

    close(@l)
    assert stream_of(l).is_err() && write(@l, data: [1]).is_err() && !is_secured(l, secure: false)

test "read: over a WebSocket, every message one read completes, nothing where it completes none, then the rest"
    two @= net.pair(5000).must()
    server @= websocket.conn_of(@two.second.stream, role: .server, settings: websocket.default_settings())
    l: Link @= .socket(
        conn: websocket.conn_of(@two.first.stream, role: .client, settings: websocket.default_settings())
    )

    # Both messages in one write: two writes on a pair with Nagle's algorithm
    # on may come in two reads.
    both = bytes.concat([websocket.prepare(.binary(data: [1, 2])).frame, websocket.prepare(.binary(data: [3])).frame])
    io.write(server.stream, data: both).must()
    assert read(@l, target: "t").must() == [1, 2, 3]
    io.write(server.stream, data: [130, 3, 9]).must()
    assert read(@l, target: "t").must() == []
    io.write(server.stream, data: [8, 7]).must()
    assert read(@l, target: "t").must() == [9, 8, 7]
    close(@l)
    _ = websocket.drop(@server).is_err()
