# Waiting on the server within a deadline: for a message held or arriving,
# for an acknowledgement, for a `PINGRESP`, for what one read completes; a
# `PINGREQ` sent where the keep-alive asks one, and the connection made again
# where it is found lost.

use io
use mqtt/internal/dialing
use mqtt/internal/fixture
use mqtt/internal/link
use mqtt/internal/model
use mqtt/internal/reading
use mqtt/internal/state
use poll
use strings
use time

# The moment `wait_ms` from now on the monotonic clock, a wait of 0 given
# one millisecond to read what has come.
#
# - `wait_ms`: the wait.
function deadline(wait_ms: i64) -> i64
    if wait_ms < 1
        return reading.now_ms() + 1
    return reading.now_ms() + wait_ms

# Waits once for bytes, within `until`, sending a `PINGREQ` where one is due
# and losing the connection where its `PINGRESP` is late.
#
# - `s`: the session, open.
# - `until`: when the wait ends, in milliseconds.
function wait_once(@s: state.Session, until: i64) -> ()?
    now = reading.now_ms()
    left = until - now

    if left <= 0
        return fail(code: model.TIMEOUT, msg: f"no answer of {s.target} came in time")
    arm: i64 @= left

    if s.keep_alive_ms > 0
        if s.ping_sent && now >= s.ping_late
            return dialing.lose(@s, code: model.CLOSED, msg: f"{s.target} left a PINGREQ unanswered")

        if !s.ping_sent && now >= s.ping_due
            match reading.write(@s, p: .pingreq)
                .ok _  => _ = 0
                .err e => return dialing.lose(@s, code: e.code, msg: e.msg)

            s.ping_sent @ true
            s.ping_late @ now + s.keep_alive_ms

        due = if s.ping_sent
            s.ping_late
        else
            s.ping_due

        if due - now < arm
            arm @ due - now

    if arm < 1
        arm @ 1

    match link.arm(s.link, ms: arm)
        .ok _  => _ = 0
        .err e => return dialing.lose(@s, code: e.code, msg: e.msg)

    match reading.fill(@s)
        .ok _ => return ok()
        .err e =>
            if e.code == model.TIMEOUT
                return ok()

            if e.code == model.STOPPED
                return fail(code: e.code, msg: e.msg)
            return dialing.lose(@s, code: e.code, msg: e.msg)

# One packet of the server acted on, within the wait that ends at `until`,
# the connection made again where it is lost.
#
# - `s`: the session.
# - `until`: when the wait ends, in milliseconds.
function step_until(@s: state.Session, until: i64) -> reading.Event?
    while true
        if s.closed
            return dialing.closed_failure(@s)

        if !s.open
            dialing.recover(@s, code: model.CLOSED, msg: "the connection was lost")?

        match reading.buffered(@s)
            .err e => dialing.lose(@s, code: e.code, msg: e.msg)?
            .ok got =>
                if got.complete
                    match reading.apply(@s, p: got.packet)
                        .ok event => return ok(event)
                        .err e =>
                            if s.closed
                                return fail(code: e.code, msg: e.msg)
                            dialing.lose(@s, code: e.code, msg: e.msg)?
                else
                    wait_once(@s, until: until)?

# The acknowledgement of type `kind` for `packet_id`, or `other` where the
# connection was made again meanwhile, so the request is sent again. What
# came behind it is left for the call that waits to `settle` once its whole
# exchange is done: QoS 2's `PUBCOMP` follows its `PUBREC` in one call.
#
# - `s`: the session.
# - `kind`: 4, 5, 7, 9 or 11.
# - `packet_id`: the identifier.
# - `until`: when the wait ends.
function await_ack(@s: state.Session, kind: i64, packet_id: i64, until: i64) -> reading.Event?
    made = s.stats.reconnects

    while true
        event = step_until(@s, until: until)?

        if s.stats.reconnects != made
            return ok(.other)

        match event
            .ack a =>
                if a.kind == kind && a.packet_id == packet_id
                    return ok(event)
            .acks a =>
                if a.kind == kind && a.packet_id == packet_id
                    return ok(event)
            .held | .pong | .other => _ = 0

# The next message held or arriving.
#
# - `s`: the session.
# - `wait_ms`: milliseconds to wait, 0 or more.
function next(@s: state.Session, wait_ms: i64) -> model.Message?
    if wait_ms < 0
        return fail(code: model.INVALID, msg: f"a wait is 0 milliseconds or more, and {wait_ms} was asked")
    until = deadline(wait_ms)

    while true
        match state.take_first(@s)
            .ok m =>
                settle(@s)
                return ok(m)
            .err _ => _ = 0

        if s.closed
            return dialing.closed_failure(@s)
        _ = step_until(@s, until: until)?

# Sends a `PINGREQ` and waits for its `PINGRESP`.
#
# - `s`: the session.
# - `wait_ms`: milliseconds, 1 or more.
function ping(@s: state.Session, wait_ms: i64) -> ()?
    if wait_ms < 1
        return fail(code: model.INVALID, msg: f"a wait is 1 millisecond or more, and {wait_ms} was asked")
    until = deadline(wait_ms)

    while true
        dialing.send(@s, p: .pingreq)?
        s.ping_sent @ true
        s.ping_late @ until
        target = s.pongs + 1
        made = s.stats.reconnects

        while s.pongs < target && s.stats.reconnects == made
            _ = step_until(@s, until: until)?

        if s.stats.reconnects == made
            settle(@s)
            return ok()

# The messages held and those one read completes; what the buffer holds
# whole is acted on first, and the read is made only where nothing is held.
#
# - `s`: the session.
function read_ready(@s: state.Session) -> [model.Message]?
    if state.held_count(s) == 0 && s.closed
        return dialing.closed_failure(@s)

    if s.open
        match whole(@s)
            .ok _ => _ = 0
            .err e =>
                if state.held_count(s) == 0
                    return fail(code: e.code, msg: e.msg)

        if state.held_count(s) == 0 && s.open
            match link.arm(s.link, ms: s.options.wait_ms)
                .ok _  => _ = 0
                .err e => dialing.lose(@s, code: e.code, msg: e.msg)?

            if s.open
                match reading.fill(@s)
                    .ok _ => whole(@s)?
                    .err e =>
                        if e.code == model.STOPPED
                            return fail(code: e.code, msg: e.msg)

                        if e.code != model.TIMEOUT
                            dialing.lose(@s, code: e.code, msg: e.msg)?

    return ok(state.take_all(@s))

# Acts on every packet whole in the buffer, reading nothing.
#
# - `s`: the session.
function whole(@s: state.Session) -> ()?
    while s.open
        got = match reading.buffered(@s)
            .ok one => one
            .err e  => return dialing.lose(@s, code: e.code, msg: e.msg)

        if !got.complete
            return ok()

        match reading.apply(@s, p: got.packet)
            .ok _  => _ = 0
            .err e => return dialing.lose(@s, code: e.code, msg: e.msg)

    return ok()

# Acts on every packet whole in the buffer once a wait has its answer: one
# read may bring the answer and what the server wrote after it, and a
# message left there as bytes is one `held_count` does not count and that
# `poll`, the stream drained, never tells a program of (defect 2675). The
# answer came, so the call answers it whatever follows: a connection found
# lost here is made again as `whole` does it, and where that fails the
# session keeps the failure, which the next call answers.
#
# - `s`: the session.
function settle(@s: state.Session)
    match whole(@s)
        .ok _ => _ = 0
        .err e =>
            if s.closed
                s.kept @ fail(code: e.code, msg: e.msg)

# For the tests: the payload of every message a loop on one thread takes in
# `turns` turns, as a program serving several clients with `poll` writes
# it: what the session holds is read at once, and otherwise its stream is
# waited on for a tenth of a second and read where it is readable.
#
# - `s`: the session, open over a stream `poll` waits on.
# - `turns`: the turns.
function polled(@s: state.Session, turns: i64) -> [[u8]]
    set @= poll.make(2).must()
    _ = poll.add_stream(set, s: link.stream_of(s.link).must(), interest: .read).must()
    got: [[u8]] @= []

    for _ in range(from: 0, to: turns)
        if state.held_count(s) > 0 || poll.wait(set, limit: time.milliseconds(100).must()).must().len() > 0
            for m in read_ready(@s).must()
                got @ got.push(m.payload)

    poll.close(@set).must()
    return got

test "next: a message read, a held one first, a timeout where nothing comes, a wait below 0"
    r @= fixture.rig_bytes([48, 5, 0, 1, 97, 0, 7, 48, 5, 0, 1, 98, 0, 8])
    assert next(@r.session, wait_ms: 1000).must().payload == [7]
    assert next(@r.session, wait_ms: 0).must().topic == "b"

    match next(@r.session, wait_ms: 0)
        .ok _  => assert false
        .err e => assert e.code == "timeout"

    assert next(@r.session, wait_ms: -1).is_err()
    fixture.close_rig(@r)

test "ping: the PINGRESP of the PINGREQ, then a timeout where none comes"
    r @= fixture.rig_bytes([208, 0])
    ping(@r.session, wait_ms: 1000).must()
    assert r.session.pongs == 1 && ping(@r.session, wait_ms: 50).is_err()
    assert fixture.heard(r.peer) == [192, 0, 192, 0]
    fixture.close_rig(@r)

test "wait_once: the keep-alive's PINGREQ sent when due, and the connection lost where its PINGRESP is late"
    r @= fixture.rig("")
    r.session.keep_alive_ms @ 30
    r.session.ping_due @ reading.now_ms()
    _ = next(@r.session, wait_ms: 20).is_err()
    assert r.session.ping_sent && fixture.heard(r.peer) == [192, 0]

    match next(@r.session, wait_ms: 200)
        .ok _  => assert false
        .err e => assert e.code == "closed" && r.session.closed

    fixture.close(@r.peer.stream)

test "await_ack: other packets held meanwhile, the acknowledgement asked for answered"
    r @= fixture.rig_bytes([48, 5, 0, 1, 97, 0, 7, 64, 2, 0, 9, 64, 2, 0, 5])
    got = await_ack(@r.session, kind: 4, packet_id: 5, until: deadline(1000)).must()
    assert got == .ack(kind: 4, packet_id: 5, reason: 0, properties: []) && state.held_count(r.session) == 1
    fixture.close_rig(@r)

test "ping and next: the messages read behind the PINGRESP and behind the message answered are held, and a loop on poll takes them"
    r @= fixture.rig_bytes([208, 0, 48, 5, 0, 1, 97, 0, 7])
    ping(@r.session, wait_ms: 1000).must()
    assert state.held_count(r.session) == 1 && polled(@r.session, turns: 3) == [[7]]
    io.write(r.peer.stream, data: [48, 5, 0, 1, 97, 0, 8, 48, 5, 0, 1, 98, 0, 9]).must()
    assert next(@r.session, wait_ms: 1000).must().payload == [8]
    assert state.held_count(r.session) == 1 && polled(@r.session, turns: 3) == [[9]]
    fixture.close_rig(@r)

test "read_ready: what one read completes, then nothing"
    r @= fixture.rig_bytes([48, 5, 0, 1, 97, 0, 7, 48, 5, 0, 1, 98, 0, 8])
    r.session.options.wait_ms @ 100
    assert read_ready(@r.session).must().len() == 2 && read_ready(@r.session).must().len() == 0
    fixture.close_rig(@r)

test "ping: bytes that are no MQTT behind the PINGRESP end the session, ping answers, and the call after says why, once"
    r @= fixture.rig_bytes([208, 0, 0, 0])
    ping(@r.session, wait_ms: 1000).must()
    assert r.session.closed

    match next(@r.session, wait_ms: 0)
        .ok _  => assert false
        .err e => assert e.code == "closed" && strings.contains(s: e.msg, substr: "the options make it no more")

    match next(@r.session, wait_ms: 0)
        .ok _  => assert false
        .err e => assert e.msg == "the client of the test's server is closed"

    fixture.close(@r.peer.stream)

test "a connection the server ends, with no reconnection allowed, closes the client"
    r @= fixture.rig("")
    fixture.close(@r.peer.stream)

    match next(@r.session, wait_ms: 1000)
        .ok _  => assert false
        .err e => assert e.code == "closed" && r.session.closed
