# What carries a client's packets: a TCP connection of `net`, a TLS stream of
# `tls`, or a WebSocket of `websocket`, read, written, given a deadline and
# closed alike. A read answers what one read brings; the end of the
# connection is a failure `closed`, so a caller never stands still on it.

use io
use mqtt/internal/model
use net
use tls
use websocket

# The bytes asked of a stream at a time.
constant CHUNK: i64
    65536

# What carries the bytes.
variant Link
    # A TCP connection of `net` or a TLS stream of `tls`, one `io.Stream`
    # whose deadline `tls.set_deadline` moves alike.
    connected
        # The connection's stream.
        stream: io.Stream
        # Whether it is TLS.
        secured: bool
    # A WebSocket, binary messages carrying the protocol's bytes.
    socket
        # The connection.
        conn: websocket.Conn
    # Nothing: closed, or not connected yet.
    gone

# The failure of a link that carries nothing.
#
# - `target`: how the server is named.
function closed_failure<T>(target: str) -> T?
    return fail(code: model.CLOSED, msg: f"the connection to {target} is closed")

# A TCP connection to `host` at `port`, made within `ms`.
#
# - `host`: the host.
# - `port`: the port.
# - `ms`: milliseconds, 1 or more.
function open_plain(host: str, port: i64, ms: i64) -> Link?
    c = net.connect_timeout(host, port: port, timeout_ms: ms, deadline_ms: 0)?
    return ok(.connected(stream: c.stream, secured: false))

# A TLS connection to `host` at `port`, TLS from its first byte.
#
# - `host`: the host, which the certificate must name.
# - `port`: the port.
# - `ms`: milliseconds the connection and its handshake may take.
# - `roots`: the authorities trusted, "" for the system's.
function open_tls(host: str, port: i64, ms: i64, roots: str) -> Link?
    s = tls.connect(host: host, port: port, deadline_ms: ms, client: tls.Client(roots: roots, protocols: []))?
    return ok(.connected(stream: s, secured: true))

# A WebSocket to `target`, its subprotocol `mqtt` as MQTT 3.1.1 and 5 ask.
#
# - `target`: a `ws://` or `wss://` URL.
# - `ms`: milliseconds the connection and its handshake may take.
# - `roots`: the authorities trusted for `wss://`.
# - `most`: the most bytes of one frame or message read.
function open_socket(target: str, ms: i64, roots: str, most: i64) -> Link?
    client @= websocket.default_client()
    client.tls @ tls.Client(roots: roots, protocols: [])
    client.protocols @ ["mqtt"]
    client.deadline_ms @ ms
    client.redirects @ 0
    client.settings.frame_bytes @ most
    client.settings.message_bytes @ most
    client.settings.close_wait_ms @ 1000
    c = websocket.connect(target, client: client)?

    if c.protocol != "mqtt"
        s @= c
        _ = websocket.drop(@s).is_err()
        return fail(code: model.UNSUPPORTED, msg: f"the server of \"{target}\" agreed no subprotocol mqtt")
    return ok(.socket(conn: c))

# Whether `l` is TLS, or a WebSocket over TLS.
#
# - `l`: the link.
# - `secure`: whether a WebSocket was made over TLS.
function is_secured(l: Link, secure: bool) -> bool
    return match l
        .connected c => c.secured
        .socket _    => secure
        .gone        => false

# Makes every read and write of `l` end by `ms` milliseconds from now, 0
# for none.
#
# - `l`: the link.
# - `ms`: milliseconds, 0 or more.
function arm(l: Link, ms: i64) -> ()?
    return match l
        .connected c => tls.set_deadline(c.stream, deadline_ms: ms)
        .socket w    => websocket.set_deadline(w.conn, ms: ms)
        .gone        => fail(code: model.CLOSED, msg: "the connection is closed")

# The bytes one read of `l` brings, at least one.
#
# - `l`: the link; a WebSocket's state moves.
# - `target`: how the server is named.
#
# Fails `closed` where the server ended the connection, and as the read
# fails.
function read(@l: Link, target: str) -> [u8]?
    got = match l
        .connected c => io.read(c.stream, n: CHUNK)?
        .socket w =>
            c @= w.conn
            answer = websocket.read_message(@c)
            l @ .socket(conn: c)
            websocket.data_of(answer?)
        .gone => return closed_failure(target)

    if got.len() == 0
        return fail(code: model.CLOSED, msg: f"{target} closed the connection")
    return ok(got)

# Writes `data` to `l`.
#
# - `l`: the link.
# - `data`: the bytes.
function write(@l: Link, data: [u8]) -> ()?
    match l
        .connected c => return io.write(c.stream, data: data)
        .socket w =>
            c @= w.conn
            done = websocket.write_binary(@c, data: data)
            l @ .socket(conn: c)
            return done
        .gone => return fail(code: model.CLOSED, msg: "the connection is closed")

# Closes `l`, whatever it holds, and leaves it `gone`.
#
# - `l`: the link.
function close(@l: Link)
    match l
        .connected c =>
            s @= c.stream
            _ = io.close(@s).is_err()
        .socket w =>
            c @= w.conn
            _ = websocket.drop(@c).is_err()
        .gone => _ = 0

    l @ .gone

# Whether `l` carries nothing.
#
# - `l`: the link.
function is_gone(l: Link) -> bool
    return match l
        .gone                    => true
        .connected _ | .socket _ => false

# The stream under `l`, for a program that waits on it.
#
# - `l`: the link.
function stream_of(l: Link) -> io.Stream?
    return match l
        .connected c => ok(c.stream)
        .socket w    => ok(w.conn.stream)
        .gone        => fail(code: model.CLOSED, msg: "the client is closed")

test "a link over a pair of connections: written, read, armed, closed, and gone after"
    two = net.pair(5000).must()
    l: Link @= .connected(stream: two.first.stream, secured: false)
    peer @= two.second.stream
    write(@l, data: [1, 2, 3]).must()
    assert io.read_exact(peer, n: 3).must() == [1, 2, 3]
    io.write(peer, data: [9]).must()
    assert read(@l, target: "t").must() == [9]
    arm(l, ms: 50).must()

    match read(@l, target: "t")
        .ok _  => assert false
        .err e => assert e.code == "timeout"

    io.close(@peer).must()
    arm(l, ms: 0).must()

    match read(@l, target: "t")
        .ok _  => assert false
        .err e => assert e.code == "closed"

    close(@l)
    assert stream_of(l).is_err() && write(@l, data: [1]).is_err() && !is_secured(l, secure: false)
