# Which upstream a request goes to, as nginx's upstream module documents its
# methods: a weighted round-robin, each turn given to the upstream whose
# running weight is the highest (nginx's smooth round-robin), or the fewest
# requests in flight for its weight, ties taken in that same turn. And the
# passive marks: `max_fails` failures within `fail_ms` keep an upstream out
# for `fail_ms`, a success clears its count, and a lone upstream is never
# kept out, as nginx never keeps out the one server of a group.

## The state

# One upstream as the balancer counts it.
record Peer
    # Its share of the turns, 1 or more.
    weight: i64
    # Its running weight in the round-robin.
    current: i64
    # The requests sent to it and not yet done.
    active: i64
    # The failures counted since `first_ms`.
    fails: i64
    # When the first of `fails` was counted, on the balancer's clock.
    first_ms: i64
    # Until when it is kept out, on the balancer's clock; 0 where it is not.
    out_until_ms: i64

# The upstreams and how one is chosen. The clock is the caller's: any count
# of milliseconds that never goes back.
record State
    # The upstreams, in the program's order.
    peers: [Peer]
    # Whether the fewest requests in flight decide, else the round-robin.
    least: bool
    # The failures within `fail_ms` that keep an upstream out; 0 counts none.
    max_fails: i64
    # The span the failures are counted in, and how long one is kept out.
    fail_ms: i64

# What became of a request sent to an upstream.
variant Outcome
    # It answered.
    answered
    # It could not be reached, or failed before its answer's head: counted
    # toward its mark.
    failed
    # Neither: the client went away, or the request was cut.
    neither

# The balancer over upstreams of `weights`, each 1 or more, nothing counted
# yet. Aborts where a weight is below 1, `max_fails` below 0 or `fail_ms`
# below 0, which the caller checks first.
function state_of(weights: [i64], least: bool, max_fails: i64, fail_ms: i64) -> State
    assert max_fails >= 0 && fail_ms >= 0
    peers: [Peer] @= []

    for w in weights
        assert w >= 1
        peers @ peers.push(Peer(weight: w, current: 0, active: 0, fails: 0, first_ms: 0, out_until_ms: 0))

    return State(peers: peers, least: least, max_fails: max_fails, fail_ms: fail_ms)

## Choosing

# Whether upstream `i` may take a request at `now_ms`: not in `avoid`, and
# not kept out, a lone upstream never being kept out.
function eligible(s: State, i: i64, now_ms: i64, avoid: [i64]) -> bool
    for a in avoid
        if a == i
            return false

    return s.peers.len() == 1 || s.peers[i].out_until_ms <= now_ms

# The upstream the next request goes to at `now_ms`, those in `avoid` (tried
# already for this request) left out, its request counted in flight. Fails
# `not_found` where none may take it.
function choose(@s: State, now_ms: i64, avoid: [i64]) -> i64?
    fewest: i64 @= -1
    i: i64 @= 0

    while i < s.peers.len()
        if eligible(s, i: i, now_ms: now_ms, avoid: avoid)
            if fewest < 0 || fewer(a: s.peers[i], b: s.peers[fewest])
                fewest @ i
        i @ i + 1

    if fewest < 0
        return fail(
            code: "not_found",
            msg: f"no upstream of {s.peers.len()} may take the request: each is kept out or was tried"
        )
    total: i64 @= 0
    best: i64 @= -1
    j: i64 @= 0

    while j < s.peers.len()
        tied = !s.least || !fewer(a: s.peers[fewest], b: s.peers[j])

        if eligible(s, i: j, now_ms: now_ms, avoid: avoid) && tied
            s.peers[j].current @ s.peers[j].current + s.peers[j].weight
            total @ total + s.peers[j].weight

            if best < 0 || s.peers[j].current > s.peers[best].current
                best @ j
        j @ j + 1

    s.peers[best].current @ s.peers[best].current - total
    s.peers[best].active @ s.peers[best].active + 1
    return ok(best)

# Whether `a` has fewer requests in flight than `b` for its weight, as nginx
# compares them: `a.active * b.weight < b.active * a.weight`.
function fewer(a: Peer, b: Peer) -> bool
    return a.active * b.weight < b.active * a.weight

# The milliseconds from `now_ms` until the first upstream kept out comes
# back: 0 where one may take a request now.
function back_in_ms(s: State, now_ms: i64) -> i64
    soonest: i64 @= -1

    for p in s.peers
        if s.peers.len() == 1 || p.out_until_ms <= now_ms
            return 0

        if soonest < 0 || p.out_until_ms < soonest
            soonest @ p.out_until_ms

    if soonest < 0
        return 0
    return soonest - now_ms

## Counting

# Records what became of a request sent to upstream `i` at `now_ms`: its
# request no longer in flight, a failure counted toward its mark, an answer
# clearing its count. Aborts where `i` names no upstream or none is in
# flight there.
function done(@s: State, i: i64, outcome: Outcome, now_ms: i64)
    assert s.peers[i].active > 0
    s.peers[i].active @ s.peers[i].active - 1

    match outcome
        .neither => _ = 0
        .answered =>
            s.peers[i].fails @ 0
            s.peers[i].out_until_ms @ 0
        .failed =>
            if s.max_fails > 0
                if s.peers[i].fails == 0 || now_ms - s.peers[i].first_ms >= s.fail_ms
                    s.peers[i].fails @ 0
                    s.peers[i].first_ms @ now_ms
                s.peers[i].fails @ s.peers[i].fails + 1

                if s.peers[i].fails >= s.max_fails
                    s.peers[i].out_until_ms @ now_ms + s.fail_ms
                    s.peers[i].fails @ 0

## Tests

# The upstreams `turns` requests go to, each done at once.
function turns_of(@s: State, turns: i64) -> [i64]
    out: [i64] @= []

    for _ in range(from: 0, to: turns)
        i = choose(@s, now_ms: 0, avoid: []).must()
        done(@s, i: i, outcome: .answered, now_ms: 0)
        out @ out.push(i)

    return out

test "choose: weights 5, 1 and 1 give nginx's documented seven turns, smoothly"
    s @= state_of([5, 1, 1], least: false, max_fails: 1, fail_ms: 10_000)
    assert turns_of(@s, turns: 7) == [0, 0, 1, 0, 2, 0, 0]
    assert turns_of(@s, turns: 7) == [0, 0, 1, 0, 2, 0, 0]

test "choose: equal weights take turns, and an upstream tried already is left out"
    s @= state_of([1, 1, 1], least: false, max_fails: 1, fail_ms: 10_000)
    assert turns_of(@s, turns: 4) == [0, 1, 2, 0]
    i = choose(@s, now_ms: 0, avoid: [1, 2]).must()
    assert i == 0
    assert choose(@s, now_ms: 0, avoid: [0, 1, 2]).is_err()

test "choose: the fewest in flight win, ties taken in turn"
    s @= state_of([1, 1, 1], least: true, max_fails: 1, fail_ms: 10_000)
    a = choose(@s, now_ms: 0, avoid: []).must()
    b = choose(@s, now_ms: 0, avoid: []).must()
    c = choose(@s, now_ms: 0, avoid: []).must()
    assert [a, b, c] == [0, 1, 2]
    done(@s, i: 1, outcome: .answered, now_ms: 0)
    assert choose(@s, now_ms: 0, avoid: []).must() == 1
    done(@s, i: 0, outcome: .neither, now_ms: 0)
    done(@s, i: 2, outcome: .neither, now_ms: 0)
    assert choose(@s, now_ms: 0, avoid: []).must() == 2
    assert choose(@s, now_ms: 0, avoid: []).must() == 0

test "choose: the fewest in flight for a weight, as nginx compares them"
    s @= state_of([3, 1], least: true, max_fails: 1, fail_ms: 10_000)
    got = [
        choose(@s, now_ms: 0, avoid: []).must()
        choose(@s, now_ms: 0, avoid: []).must()
        choose(@s, now_ms: 0, avoid: []).must()
        choose(@s, now_ms: 0, avoid: []).must()
    ]
    assert got == [0, 1, 0, 0]
    assert s.peers[0].active == 3 && s.peers[1].active == 1

test "done: max_fails within fail_ms keep an upstream out for fail_ms, then it comes back"
    s @= state_of([1, 1], least: false, max_fails: 2, fail_ms: 10_000)
    assert choose(@s, now_ms: 0, avoid: []).must() == 0
    done(@s, i: 0, outcome: .failed, now_ms: 0)
    assert choose(@s, now_ms: 100, avoid: []).must() == 1
    done(@s, i: 1, outcome: .answered, now_ms: 100)
    assert choose(@s, now_ms: 200, avoid: [1]).must() == 0
    done(@s, i: 0, outcome: .failed, now_ms: 200)
    assert s.peers[0].out_until_ms == 10_200
    assert choose(@s, now_ms: 300, avoid: [1]).is_err()
    assert back_in_ms(s, now_ms: 300) == 0
    assert choose(@s, now_ms: 10_200, avoid: [1]).must() == 0

test "done: failures further apart than fail_ms start the count again, an answer clears it"
    s @= state_of([1, 1], least: false, max_fails: 2, fail_ms: 1_000)
    _ = choose(@s, now_ms: 0, avoid: [1]).must()
    done(@s, i: 0, outcome: .failed, now_ms: 0)
    _ = choose(@s, now_ms: 5_000, avoid: [1]).must()
    done(@s, i: 0, outcome: .failed, now_ms: 5_000)
    assert s.peers[0].out_until_ms == 0 && s.peers[0].fails == 1
    _ = choose(@s, now_ms: 5_100, avoid: [1]).must()
    done(@s, i: 0, outcome: .answered, now_ms: 5_100)
    assert s.peers[0].fails == 0

test "back_in_ms: every upstream kept out tells the soonest; a lone one is never kept out"
    s @= state_of([1, 1], least: false, max_fails: 1, fail_ms: 1_000)
    _ = choose(@s, now_ms: 0, avoid: [1]).must()
    done(@s, i: 0, outcome: .failed, now_ms: 0)
    _ = choose(@s, now_ms: 400, avoid: []).must()
    done(@s, i: 1, outcome: .failed, now_ms: 400)
    assert choose(@s, now_ms: 500, avoid: []).is_err()
    assert back_in_ms(s, now_ms: 500) == 500
    one @= state_of([1], least: false, max_fails: 1, fail_ms: 1_000)
    _ = choose(@one, now_ms: 0, avoid: []).must()
    done(@one, i: 0, outcome: .failed, now_ms: 0)
    assert choose(@one, now_ms: 1, avoid: []).must() == 0
    assert back_in_ms(one, now_ms: 1) == 0

test "done: max_fails 0 counts no failure"
    s @= state_of([1, 1], least: false, max_fails: 0, fail_ms: 1_000)
    _ = choose(@s, now_ms: 0, avoid: [1]).must()
    done(@s, i: 0, outcome: .failed, now_ms: 0)
    assert s.peers[0].out_until_ms == 0
