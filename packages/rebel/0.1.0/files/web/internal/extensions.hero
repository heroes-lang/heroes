# A file's media type by its extension: one table carried here, the same on
# every machine. Its types are what Go 1.27's `mime.TypeByExtension` answers
# on macOS, else what Python 3.15's built-in `mimetypes` table answers, both
# observed on 2026-11-16; a type of text carries `charset=utf-8`.

use strings

# The type of the extension `ext`, without its dot and in lower case; "" for
# one the table does not hold.
function type_of_ext(ext: str) -> str
    return match ext
        "html" | "htm"         => "text/html; charset=utf-8"
        "css"                  => "text/css; charset=utf-8"
        "js" | "mjs"           => "text/javascript; charset=utf-8"
        "json"                 => "application/json"
        "xml"                  => "application/xml"
        "txt"                  => "text/plain; charset=utf-8"
        "csv"                  => "text/csv; charset=utf-8"
        "tsv"                  => "text/tab-separated-values; charset=utf-8"
        "md"                   => "text/markdown; charset=utf-8"
        "svg"                  => "image/svg+xml"
        "png"                  => "image/png"
        "jpg" | "jpeg"         => "image/jpeg"
        "gif"                  => "image/gif"
        "webp"                 => "image/webp"
        "avif"                 => "image/avif"
        "ico"                  => "image/x-icon"
        "bmp"                  => "image/bmp"
        "tif" | "tiff"         => "image/tiff"
        "pdf"                  => "application/pdf"
        "zip"                  => "application/zip"
        "gz"                   => "application/gzip"
        "tar"                  => "application/x-tar"
        "wasm"                 => "application/wasm"
        "woff"                 => "font/woff"
        "woff2"                => "font/woff2"
        "ttf"                  => "font/ttf"
        "otf"                  => "font/otf"
        "eot"                  => "application/vnd.ms-fontobject"
        "mp3"                  => "audio/mpeg"
        "mp4"                  => "video/mp4"
        "m4v"                  => "video/x-m4v"
        "webm"                 => "video/webm"
        "ogg" | "oga" | "opus" => "audio/ogg"
        "ogv"                  => "video/ogg"
        "wav"                  => "audio/x-wav"
        "flac"                 => "audio/x-flac"
        "m4a"                  => "audio/mp4a-latm"
        "aac"                  => "audio/x-aac"
        "mov"                  => "video/quicktime"
        "avi"                  => "video/x-msvideo"
        "mpeg" | "mpg"         => "video/mpeg"
        "webmanifest"          => "application/manifest+json"
        "rss"                  => "application/rss+xml"
        "atom"                 => "application/atom+xml"
        "ics"                  => "text/calendar; charset=utf-8"
        "vcf"                  => "text/x-vcard; charset=utf-8"
        "yaml" | "yml"         => "application/yaml"
        "toml"                 => "application/toml"
        "doc"                  => "application/msword"
        "docx"                 => "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        "xls"                  => "application/vnd.ms-excel"
        "xlsx"                 => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        "ppt"                  => "application/vnd.ms-powerpoint"
        "pptx"                 => "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        "odt"                  => "application/vnd.oasis.opendocument.text"
        "ods"                  => "application/vnd.oasis.opendocument.spreadsheet"
        "epub"                 => "application/epub+zip"
        "rtf"                  => "application/rtf"
        "7z"                   => "application/x-7z-compressed"
        "rar"                  => "application/x-rar-compressed"
        "bz2"                  => "application/x-bzip2"
        "xz"                   => "application/x-xz"
        "sh"                   => "application/x-sh"
        "apng"                 => "image/apng"
        "jxl"                  => "image/jxl"
        "heic"                 => "image/heic"
        "heif"                 => "image/heif"
        "jar"                  => "application/java-archive"
        "swf"                  => "application/x-shockwave-flash"
        "mid" | "midi"         => "audio/midi"
        "weba"                 => "audio/webm"
        "3gp"                  => "video/3gpp"
        "ts" | "mts"           => "video/mp2t"
        _                      => ""

# The type of `ext`, an extension with or without its dot, in any case.
function type_of(ext: str) -> str
    return type_of_ext(strings.to_lower_ascii(strings.trim_prefix(s: ext, prefix: ".")))

test "type_of_ext: text carries its charset, an image none, an unknown one empty"
    assert type_of_ext("html") == "text/html; charset=utf-8"
    assert type_of_ext("png") == "image/png"
    assert type_of_ext("json") == "application/json"
    assert type_of_ext("") == "" && type_of_ext("nope") == ""

test "type_of_ext: where Go and Python disagree, Go's taken; where Go has none, Python's"
    assert type_of_ext("xml") == "application/xml"
    assert type_of_ext("ico") == "image/x-icon"
    assert type_of_ext("md") == "text/markdown; charset=utf-8"
    assert type_of_ext("yaml") == "application/yaml" && type_of_ext("webmanifest") == "application/manifest+json"

test "type_of: a dot and upper case read, a dot alone"
    assert type_of(".HTML") == "text/html; charset=utf-8" && type_of("Css") == "text/css; charset=utf-8"
    assert type_of(".") == ""
