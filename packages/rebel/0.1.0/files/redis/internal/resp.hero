# The bytes of RESP, the Redis serialization protocol, versions 2 and 3, as
# Redis's "Protocol specification" lays them out: a command written as an
# array of bulk strings, and one token of a reply read at a time, a scalar
# whole or an aggregate's header, each failing `invalid` where the bytes are
# no RESP and telling where the bytes end before the token does.

use bytes
use numbers
use strings

constant INVALID: str
    "invalid"

constant LIMIT: str
    "limit"

constant UNSUPPORTED: str
    "unsupported"

# The longest bulk string read, 512 MiB, Redis's own default for
# `proto-max-bulk-len`.
constant MOST_BULK: i64
    536870912

# The longest line read, a simple string's or a header's, 1 MiB.
constant MOST_LINE: i64
    1048576

# One token of a reply.
record Token
    # Its type's byte: `+`, `-`, `:`, `$`, `*`, `_`, `,`, `#`, `!`, `=`,
    # `(`, `%`, `~`, `|` or `>`.
    kind: u8
    # An aggregate's count, of elements, or of pairs for `%` and `|`; -1 for
    # RESP2's null bulk string and null array; 0 for a scalar.
    count: i64
    # A scalar's bytes: the line after the type's byte, or a bulk's bytes.
    data: [u8]
    # The byte index where the next token begins.
    next: i64

# What a scan found: a token, or bytes that end before one does.
record Scanned
    # Whether the token is whole; false where more bytes are needed.
    complete: bool
    # The token, where it is whole.
    token: Token

# The bytes of the command `words` as RESP writes one: an array of bulk
# strings.
#
# - `words`: the command's name, then its arguments, each any bytes.
function command(words: [[u8]]) -> [u8]
    out: [u8] @= ['*']
    push_digits(@out, n: words.len())
    out @ out.push('\r')
    out @ out.push('\n')

    for a in words
        out @ out.push('$')
        push_digits(@out, n: a.len())
        out @ out.push('\r')
        out @ out.push('\n')

        for b in a
            out @ out.push(b)

        out @ out.push('\r')
        out @ out.push('\n')

    return out

# Adds the decimal digits of `n` to `out`.
#
# - `out`: the bytes being written.
# - `n`: 0 or more.
function push_digits(@out: [u8], n: i64)
    for b in bytes.from_text(to_str(n))
        out @ out.push(b)

# A token that is not whole yet.
function incomplete() -> Scanned
    return Scanned(complete: false, token: Token(kind: 0, count: 0, data: [], next: 0))

# Where the line that begins at `at` ends: the index of its `\r`, which a
# `\n` follows; -1 where `data` ends first.
#
# - `data`: the bytes.
# - `at`: where the line begins.
#
# Fails `invalid` where a `\r` stands without its `\n`, and `limit` where the
# line passes `MOST_LINE` with no end.
function line_end(data: [u8], at: i64) -> i64?
    i: i64 @= at

    while i < data.len()
        if data[i] == '\r'
            if i + 1 >= data.len()
                return ok(-1)

            if data[i + 1] != '\n'
                return fail(code: INVALID, msg: f"the reply holds a carriage return without its line feed at byte {i}")
            return ok(i)

        if data[i] == '\n'
            return fail(code: INVALID, msg: f"the reply holds a line feed without its carriage return at byte {i}")

        if i - at >= MOST_LINE
            return fail(code: LIMIT, msg: f"the reply holds a line past {MOST_LINE} bytes at byte {at}")
        i @ i + 1

    if i - at > MOST_LINE
        return fail(code: LIMIT, msg: f"the reply holds a line past {MOST_LINE} bytes at byte {at}")
    return ok(-1)

# The number the bytes of `data` from `from` to `to` write: digits, a `-`
# or `+` before them allowed.
#
# - `data`: the bytes.
# - `from`: the first.
# - `to`: one past the last.
#
# Fails `invalid` where they write no number of an `i64`.
function number(data: [u8], from: i64, to: i64) -> i64?
    at: i64 @= from
    negative = at < to && data[at] == '-'

    if at < to && (data[at] == '-' || data[at] == '+')
        at @ at + 1

    if at >= to
        return fail(code: INVALID, msg: f"the reply holds no number at byte {from}")
    n: i64 @= 0

    while at < to
        d = data[at]

        if d < '0' || d > '9'
            return fail(code: INVALID, msg: f"the reply holds no number at byte {from}")
        digit = to_i64(d - '0').must()

        if negative
            if n < (-9223372036854775807 - 1 + digit) / 10
                return fail(code: INVALID, msg: f"the reply holds a number past an i64 at byte {from}")
            n @ n * 10 - digit
        else
            if n > (9223372036854775807 - digit) / 10
                return fail(code: INVALID, msg: f"the reply holds a number past an i64 at byte {from}")
            n @ n * 10 + digit
        at @ at + 1

    return ok(n)

# The token that begins at `at` of `data`, or that it is not whole yet.
#
# - `data`: the bytes read so far.
# - `at`: where the token begins, 0 to `data`'s length.
#
# Fails `invalid` where the bytes are no RESP: an unknown type's byte, a
# length or count that is no number or below -1, a bulk not ended by
# `\r\n`, a boolean other than `t` or `f`; `limit` where a bulk passes
# `MOST_BULK` or a line `MOST_LINE`; `unsupported` for RESP3's streamed
# strings and aggregates (`$?`, `*?`), which Redis never sends.
function scan(data: [u8], at: i64) -> Scanned?
    if at >= data.len()
        return ok(incomplete())
    end = line_end(data, at: at + 1)?

    if end < 0
        return ok(incomplete())
    kind = data[at]
    after = end + 2

    if kind == '+' || kind == '-' || kind == ':' || kind == ',' || kind == '(' || kind == '_' || kind == '#'
        line = data.slice(from: at + 1, to: end)

        if kind == ':'
            _ = number(data, from: at + 1, to: end)?

        if kind == '_' && line.len() != 0
            return fail(code: INVALID, msg: f"the reply's null at byte {at} carries bytes")

        if kind == '#' && (line.len() != 1 || line[0] != 't' && line[0] != 'f')
            return fail(code: INVALID, msg: f"the reply's boolean at byte {at} is neither t nor f")
        return ok(Scanned(complete: true, token: Token(kind: kind, count: 0, data: line, next: after)))

    if (kind == '$' || kind == '*') && end == at + 2 && data[at + 1] == '?'
        return fail(
            code: UNSUPPORTED,
            msg: f"the reply streams a string or an aggregate at byte {at}, which Redis never sends"
        )

    if kind == '$' || kind == '!' || kind == '='
        n = number(data, from: at + 1, to: end)?

        if n == -1 && kind == '$'
            return ok(Scanned(complete: true, token: Token(kind: kind, count: -1, data: [], next: after)))

        if n < 0
            return fail(code: INVALID, msg: f"the reply's length at byte {at} is {n}")

        if n > MOST_BULK
            return fail(code: LIMIT, msg: f"the reply's string at byte {at} is {n} bytes, past {MOST_BULK}")

        if data.len() - after < n + 2
            return ok(incomplete())

        if data[after + n] != '\r' || data[after + n + 1] != '\n'
            return fail(
                code: INVALID,
                msg: f"the reply's string at byte {at} is not ended by a carriage return and a line feed"
            )

        if kind == '=' && (n < 4 || data[after + 3] != ':')
            return fail(code: INVALID, msg: f"the reply's verbatim string at byte {at} has no format")
        return ok(
            Scanned(complete: true, token: Token(kind: kind, count: 0, data: data.slice(from: after, to: after + n), next: after + n + 2))
        )

    if kind == '*' || kind == '%' || kind == '~' || kind == '|' || kind == '>'
        n = number(data, from: at + 1, to: end)?

        if n == -1 && kind == '*'
            return ok(Scanned(complete: true, token: Token(kind: kind, count: -1, data: [], next: after)))

        if n < 0
            return fail(code: INVALID, msg: f"the reply's count at byte {at} is {n}")
        return ok(Scanned(complete: true, token: Token(kind: kind, count: n, data: [], next: after)))
    return fail(
        code: INVALID,
        msg: f"the reply holds '{bytes.format_escaped([kind])}' at byte {at}, which begins no RESP type"
    )

# Whether `data` writes an integer of any size: decimal digits, a `-` before
# them allowed.
#
# - `data`: the big number's bytes.
function is_big_number(data: [u8]) -> bool
    at: i64 @= 0

    if data.len() > 0 && data[0] == '-'
        at @ 1

    if at >= data.len()
        return false

    while at < data.len()
        if data[at] < '0' || data[at] > '9'
            return false
        at @ at + 1

    return true

# `data` as text.
#
# - `data`: a scalar's bytes.
#
# Fails `invalid` where they are not UTF-8.
function text_of(data: [u8]) -> str?
    match bytes.to_text(data)
        .ok s  => return ok(s)
        .err _ => return fail(code: INVALID, msg: "the reply holds text that is not UTF-8")

# The double `s` writes, as RESP3's doubles and Redis's own replies write
# one: decimal digits with a point and an exponent, or `inf`, `-inf`, `nan`.
#
# - `s`: the text.
#
# Fails `invalid` where it writes none.
function double_of(s: str) -> f64?
    lower = strings.to_lower(s)

    if lower == "inf" || lower == "+inf"
        return ok(1.0 / 0.0)

    if lower == "-inf"
        return ok(-1.0 / 0.0)

    if lower == "nan" || lower == "-nan"
        return ok(0.0 / 0.0)

    match numbers.parse_float(s)
        .ok x  => return ok(x)
        .err _ => return fail(code: INVALID, msg: f"\"{s}\" is no number")

# The digits of a big number, as text.
#
# - `data`: its bytes.
#
# Fails `invalid` where they write no integer.
function big_number_of(data: [u8]) -> str?
    s = text_of(data)?

    if !is_big_number(data)
        return fail(code: INVALID, msg: f"the big number \"{s}\" is no number")
    return ok(s)

# How many tokens follow an aggregate's header, its elements' first tokens:
# twice its count for a map or an attribute.
#
# - `t`: the header.
function elements_of(t: Token) -> i64
    if t.kind == '%' || t.kind == '|'
        return t.count * 2
    return t.count

# Whether `t` opens an aggregate that has elements to follow.
#
# - `t`: the token.
function is_open(t: Token) -> bool
    return (t.kind == '*' || t.kind == '%' || t.kind == '~' || t.kind == '|' || t.kind == '>') && t.count > 0

test "command: the documentation's LLEN mylist, an empty argument and bytes that are not text"
    assert command([bytes.from_text("LLEN"), bytes.from_text("mylist")]) == bytes.from_text("*2\r\n$4\r\nLLEN\r\n$6\r\nmylist\r\n")
    assert command([bytes.from_text("SET"), [], [0, 255, '\r']]) == bytes.concat([bytes.from_text("*3\r\n$3\r\nSET\r\n$0\r\n\r\n$3\r\n"), [0, 255, '\r', '\r', '\n']])

test "scan: each scalar of RESP2 and RESP3 as the documentation writes it"
    simple = scan(bytes.from_text("+OK\r\n"), at: 0).must()
    assert simple.complete && simple.token == Token(kind: '+', count: 0, data: bytes.from_text("OK"), next: 5)
    assert scan(bytes.from_text("-ERR unknown command 'foobar'\r\n"), at: 0).must().token.data == bytes.from_text("ERR unknown command 'foobar'")
    assert scan(bytes.from_text(":-1000\r\n"), at: 0).must().token.data == bytes.from_text("-1000")
    assert scan(bytes.from_text("$5\r\nhello\r\n"), at: 0).must().token == Token(kind: '$', count: 0, data: bytes.from_text("hello"), next: 11)
    assert scan(bytes.from_text("$0\r\n\r\n"), at: 0).must().token.data == []
    assert scan(bytes.from_text("$-1\r\n"), at: 0).must().token.count == -1
    assert scan(bytes.from_text("*-1\r\n"), at: 0).must().token.count == -1
    assert scan(bytes.from_text("_\r\n"), at: 0).must().token.kind == '_'
    assert scan(bytes.from_text("#t\r\n"), at: 0).must().token.data == ['t']
    assert scan(bytes.from_text(",1.23\r\n"), at: 0).must().token.data == bytes.from_text("1.23")
    assert scan(bytes.from_text("(3492890328409238509324850943850943825024385\r\n"), at: 0).must().token.kind == '('
    assert scan(bytes.from_text("!21\r\nSYNTAX invalid syntax\r\n"), at: 0).must().token.data == bytes.from_text("SYNTAX invalid syntax")
    assert scan(bytes.from_text("=15\r\ntxt:Some string\r\n"), at: 0).must().token.data == bytes.from_text("txt:Some string")

test "scan: headers of aggregates, and bytes that end before a token"
    assert scan(bytes.from_text("*2\r\n"), at: 0).must().token == Token(kind: '*', count: 2, data: [], next: 4)
    assert elements_of(scan(bytes.from_text("%2\r\n"), at: 0).must().token) == 4
    assert is_open(scan(bytes.from_text(">3\r\n"), at: 0).must().token)
    assert !is_open(scan(bytes.from_text("*0\r\n"), at: 0).must().token)
    assert !scan(bytes.from_text("+OK"), at: 0).must().complete
    assert !scan(bytes.from_text("+OK\r"), at: 0).must().complete
    assert !scan(bytes.from_text("$5\r\nhel"), at: 0).must().complete
    assert !scan([], at: 0).must().complete

test "scan: a type unknown, a bare line feed, a bad length, a bulk not ended, a bad boolean, a streamed string and a bulk too long"
    for bad in ["?x\r\n", "+OK\n", "$x\r\n", "$-2\r\n", "$2\r\nabc\r\n", "#x\r\n", ":12a\r\n", ":99999999999999999999\r\n", "*-2\r\n", "=3\r\nabc\r\n"]
        match scan(bytes.from_text(bad), at: 0)
            .ok _  => assert false
            .err e => assert e.code == "invalid"

    match scan(bytes.from_text("$?\r\n"), at: 0)
        .ok _  => assert false
        .err e => assert e.code == "unsupported"

    match scan(bytes.from_text("$536870913\r\n"), at: 0)
        .ok _  => assert false
        .err e => assert e.code == "limit"

test "is_big_number: digits, a sign, nothing after the sign, and a letter"
    assert is_big_number(bytes.from_text("-3492890328409238509324850943850943825024385"))
    assert !is_big_number(bytes.from_text("-")) && !is_big_number([]) && !is_big_number(bytes.from_text("12a"))

test "text_of, double_of and big_number_of: text that is not UTF-8, the infinities, an exponent, and digits after a letter"
    assert text_of([255]).is_err()
    assert double_of("-inf").must() == -1.0 / 0.0 && double_of("1.5e3").must() == 1500.0
    nan = double_of("nan").must()
    assert nan != nan
    assert double_of("1.2.3").is_err()
    assert big_number_of(bytes.from_text("-12")).must() == "-12" && big_number_of(bytes.from_text("1a")).is_err()

test "number: the edges of an i64, a sign, and none"
    assert number(bytes.from_text("9223372036854775807"), from: 0, to: 19).must() == 9223372036854775807
    assert number(bytes.from_text("-9223372036854775808"), from: 0, to: 20).must() == -9223372036854775807 - 1
    assert number(bytes.from_text("9223372036854775808"), from: 0, to: 19).is_err()
    assert number(bytes.from_text("+7"), from: 0, to: 2).must() == 7
    assert number(bytes.from_text("-"), from: 0, to: 1).is_err()

test "scan: a type unknown, told by its character (defect 2598)"
    match scan(bytes.from_text("?x\r\n"), at: 0)
        .ok _  => assert false
        .err e => assert e.msg == "the reply holds '?' at byte 0, which begins no RESP type"
