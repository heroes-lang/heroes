# What this package's tests and examples share, and nothing outside them
# calls: a peer, the two ends of a connection on whose far end the answers of
# a server are written ahead, one message a line, so that a client's requests
# are answered in order with no thread; and the server of the tests, over the
# face's types, with its answers and the threads that serve it by lines and
# over Streamable HTTP; and a port where nothing listens.

use http
use io
use json
use jsonrpc
use mcp
use net
use os
use strings

# The two ends of a connection whose second end has written `results` ahead,
# each the result of the request of id 1, 2 and so on: the client reads them
# from the first end.
function peer(results: [str]) -> net.Pair
    two = net.pair(deadline_ms: 10_000).must()

    for at in range(from: 0, to: results.len())
        answer = jsonrpc.answer_result(.number(v: to_f64(at + 1)), value: json.parse(results[at]).must())
        jsonrpc.write_message(two.second.stream, m: answer, framing: .lines).must()

    return two

# Closes both ends of `two`.
function shut(two: net.Pair)
    first @= two.first.stream
    io.close(@first).must()
    second @= two.second.stream
    io.close(@second).must()

# The `_meta` every request of the tests carries: this revision, and a
# client that asks its user by forms.
constant TEST_META: str
    "\"_meta\": {\"io.modelcontextprotocol/protocolVersion\": \"2026-07-28\", \"io.modelcontextprotocol/clientInfo\": {\"name\": \"t\", \"version\": \"1\"}, \"io.modelcontextprotocol/clientCapabilities\": {\"elicitation\": {}}}"

# A request of the tests: `extra` members, each followed by a comma, then
# `TEST_META`.
#
# - `id`: the request's id.
# - `method`: its method.
# - `extra`: its other members as JSON text, each with a comma after it.
function test_request(id: f64, method: str, extra: str) -> jsonrpc.Message
    return .request(id: .number(v: id), method: method, params: json.parse("{" + extra + TEST_META + "}").must())

# The server of the tests: three tools on pages of two, a resource, a
# template, a prompt, completions, and changes told.
function test_server() -> mcp.Server
    s @= mcp.new_server(mcp.implementation(name: "test", version: "1"))
    add @= mcp.new_tool(
        name: "add",
        description: "adds",
        input_schema: json.parse("{\"type\": \"object\", \"properties\": {\"a\": {\"type\": \"number\"}, \"b\": {\"type\": \"number\"}}, \"required\": [\"a\", \"b\"]}").must()
    )
    add.output_schema @ json.parse("{\"type\": \"object\", \"required\": [\"sum\"]}").must()
    echo = mcp.new_tool(
        name: "echo",
        description: "echoes",
        input_schema: json.parse("{\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\", \"x-mcp-header\": \"Text\"}}}").must()
    )
    greet = mcp.new_tool(
        name: "greet",
        description: "greets",
        input_schema: json.parse("{\"type\": \"object\"}").must()
    )
    s.tools @ [add, echo, greet]
    s.resources @ [mcp.new_resource(uri: "notes://readme", name: "readme")]
    s.templates @ [mcp.new_template(uri_template: "greeting://{name}", name: "greeting")]
    s.prompts @ [
        mcp.new_prompt(name: "review", description: "reviews", arguments: [mcp.PromptArgument(name: "code", title: "", description: "", required: true)])
    ]
    s.completions @ true
    s.list_changed @ true
    s.subscribe @ true
    s.page_size @ 2
    return s

# The test server's answer to `request`, as a program writes its own. Fails
# `not_found` where nothing answers it.
#
# - `s`: the test server.
# - `request`: what a message asks.
function test_answer(s: mcp.Server, request: mcp.Request) -> jsonrpc.Message?
    match request
        .answered a => return ok(a.answer)
        .call_tool c =>
            if c.call.name == "add"
                a = json.number_of(json.member(c.call.arguments, key: "a").must()).must()
                b = json.number_of(json.member(c.call.arguments, key: "b").must()).must()
                sum: {str: json.Value} @= {}
                sum["sum"] @ .number(v: a + b)
                return ok(mcp.answer_tool(s, call: c.call, result: mcp.structured_result(.object(members: sum)).must()))

            if c.call.name == "echo"
                return ok(
                    mcp.answer_tool(s, call: c.call, result: mcp.text_result(json.text_of(json.member(c.call.arguments, key: "text").must()).must()))
                )

            match mcp.elicited_of(c.call.inputs, key: "who")
                .ok got => return ok(
                    mcp.answer_tool(s, call: c.call, result: mcp.text_result(f"Hello, {json.text_of(got.content["name"].default(.null_value)).default("?")}"))
                )
                .err _ =>
                    ask: {str: mcp.InputRequest} @= {}
                    ask["who"] @ .form(
                        message: "Who?",
                        schema: json.parse("{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}}}").must()
                    )
                    return ok(
                        mcp.answer_input_required(s, id: c.call.id, meta: c.call.meta, input: mcp.InputRequired(requests: ask, state: "first"))
                    )
        .read_resource r => return ok(
            mcp.answer_resource(s, read: r.read, contents: [.text(uri: r.read.uri, mime_type: "text/plain", text: r.read.values["name"].default("readme"))])
        )
        .get_prompt g => return ok(
            mcp.answer_prompt(s, get: g.get, result: mcp.PromptResult(description: "d", messages: [mcp.PromptMessage(role: "user", content: mcp.text_content(g.get.arguments["code"].must()))]))
        )
        .complete c => return ok(mcp.answer_completion(s, completion: c.completion, values: ["Ada", "Alan"]))
        .listen l => return ok(mcp.acknowledge(s, listen: l.listen))
        .respond _ | .cancelled _ | .ignored => return fail(code: mcp.NOT_FOUND, msg: "nothing answers it")

# A thread's body: serves the connection `accepted` names, one message a
# line, until it closes; a subscription's acknowledgment is followed by a
# change of the tools. Answers how many messages it read.
#
# - `accepted`: the number `net.accept_number` gave.
function serve_lines(accepted: i64) -> i64
    conn = net.conn_of(n: accepted, deadline_ms: 10_000).must()
    reader @= io.reader(conn.stream)
    s = test_server()
    served: i64 @= 0

    while true
        request = match mcp.read_request(@reader, s: s)
            .ok got => got
            .err _  => break

        match test_answer(s, request: request)
            .ok m  => jsonrpc.write_message(reader.stream, m: m, framing: .lines).must()
            .err _ => _ = 0

        match request
            .listen l => jsonrpc.write_message(
                reader.stream,
                m: mcp.changed_notification(s, listen: l.listen, list: "tools").must(),
                framing: .lines
            ).must()
            .answered _ | .respond _ | .cancelled _ | .ignored | .call_tool _ | .read_resource _ | .get_prompt _ | .complete _ => _ = 0

        served @ served + 1

    io.close(@reader.stream).must()
    return served

# Tells `text`, the port a server listens on, to the control listener at
# `control` after the word `told` that marks it as the server's (`told`),
# and closes.
function tell(control: i64, text: str)
    c @= net.connect("127.0.0.1", port: control, deadline_ms: 10_000).must()
    io.write_text(c.stream, text: "told " + text).must()
    io.close(@c.stream).must()

# What a server tells `control`, the listener its starter holds: the text
# after `told ` of the first connection that says it within five seconds of
# its accept, ten connections at most and thirty seconds in all, or why none
# did. Any other connection is closed and passed over, as one another
# program makes to a port it did not choose: beside a test of `tls` that
# steers its connect to the port the system gives next, such a connection
# reached a starter's listener and held its read to its deadline in 62
# rounds of 3,000 (defect 2633).
function told(control: net.Listener) -> str
    net.set_accept_deadline(control, deadline_ms: 30_000).must()
    tries @= 0

    while tries < 10
        tries @ tries + 1

        match net.accept(control, deadline_ms: 5_000)
            .err e =>
                if e.code == net.TIMEOUT
                    return e.code + ": " + e.msg
            .ok c =>
                r @= io.reader(c.stream)
                said = io.read_rest_text(@r)

                match io.close(@r.stream)
                    .ok _  => _ = 0
                    .err _ => _ = 0

                match said
                    .ok text =>
                        if strings.has_prefix(s: text, prefix: "told ")
                            return text.slice(from: 5, to: text.len())
                    .err _ => _ = 0

    return "none of ten connections told a port"

# A thread's body: listens on a port the system chooses, tells it to the
# control listener at `control`, and serves Streamable HTTP, a request
# without `Authorization` answered 401, until it is asked `/stop`, or for a
# minute at most. Answers how many requests it served, `/stop` not among
# them. It served for two seconds after its listen before: a client whose
# first request came later, behind a connection of another program its
# starter passed over or on a loaded machine, found nothing listening, in
# 12 rounds of 400 beside two loops of tests that steer their connect to
# the port the system gives next (2026-11-21).
#
# - `control`: the port of the test's control listener.
function serve_http_many(control: i64) -> i64
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    tell(control: control, text: f"{l.address.port}")
    net.set_accept_deadline(l, deadline_ms: 60_000).must()
    s = test_server()
    served: i64 @= 0
    stopping: bool @= false

    while !stopping
        conn = match net.accept(l, deadline_ms: 10_000)
            .ok got => got
            .err _  => break

        reader @= io.reader(conn.stream)

        while true
            r = match http.next_request(@reader, limits: http.default_limits())
                .ok got => got
                .err _  => break

            if r.url.path == "/stop"
                stopping @ true
                http.write_answer(reader.stream, r: r, response: http.respond_status(200)).must()
                break

            response = if http.value_of(r.headers, name: "Authorization").is_err()
                mcp.unauthorized(
                    metadata_url: "http://127.0.0.1/.well-known/oauth-protected-resource",
                    scope: "mcp:tools"
                )
            else
                handled = mcp.read_http(r, s: s)

                match handled
                    .respond x => x.response
                    .answered _ | .cancelled _ | .ignored | .call_tool _ | .read_resource _ | .get_prompt _ | .complete _ | .listen _ =>
                        mcp.respond_http(test_answer(s, request: handled).must())
            served @ served + 1
            http.write_answer(reader.stream, r: r, response: response).must()

            if r.closing || response.closing
                break

        io.close(@reader.stream).must()

    net.close_listener(@l).must()
    return served

# A port of the loopback address where nothing listens, for a test of what
# a connect there answers. Port 1, taken for one before, is none: on macOS a
# program of any user may listen on it on every address, and a connect to
# 127.0.0.1 then reaches it (measured 2026-11-21). This one is drawn by the
# system's generator from 20000 to 31999, below Linux's 32768 to 60999 and
# macOS's and Windows' 49152 to 65535, so no system gives it to a socket of
# its own choosing in the moment before the test's connect, and kept where a
# connect there is refused, so a listener of another program is passed over,
# a hundred draws at most.
function silent_port() -> i64
    tries @= 0

    while tries < 100
        tries @ tries + 1
        drawn = os.random_bytes(2).must()
        port = 20000 + (drawn[0].to_i64().must() * 256 + drawn[1].to_i64().must()) % 12000

        match net.connect("127.0.0.1", port: port, deadline_ms: 10000)
            .ok c =>
                s @= c.stream

                match io.close(@s)
                    .ok _  => _ = 0
                    .err _ => _ = 0
            .err e =>
                if e.code == net.CLOSED
                    return port

    assert false
    return 0
