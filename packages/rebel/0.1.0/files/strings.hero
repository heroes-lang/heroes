# Text searched, cut, trimmed, replaced, padded and cased. A position is a
# byte index, an `i64`, as the language indexes a `str`, and every index a
# function here cuts at is a character's first byte, so no text read from
# outside makes one abort. A search that finds nothing fails `not_found`; none
# answers -1. A failure's message quotes a text it names where it is 32 bytes
# or shorter, its control and invisible characters escaped, and names a
# longer one by its length. A character is what `s.chars()` yields, a `str`
# of one character, and a function that takes a function takes a top-level
# one over one character. What the language does itself is not here: `join`,
# `repeat`, `chars`, `slice`, `+`, and `map`, `filter`, `any` and `all` over
# `s.chars()`. A word quoted for a POSIX shell is `process.quote`'s, beside
# the shell it runs; a text read as the words a shell or a Windows command
# line gives is here.
#
# A count a caller gives, `split_n`'s `n` and `replace_n`'s, is a `u64`, as
# the built-in `repeat`'s, so a negative one does not compile; a width, an
# index and a count a function answers are `i64`s, as `len()` answers. Text
# cut where Unicode says its parts end, into graphemes, words and sentences,
# and measured or padded in the columns a terminal draws, is
# `unicode/segment`'s; text put in a normal form, and cased by the rules of
# one language (Turkish, Azeri, Lithuanian), is `unicode/normalize`'s.

use strings/internal/automaton
use strings/internal/bounds
use strings/internal/bytewise
use strings/internal/casing
use strings/internal/messages
use strings/internal/multi
use strings/internal/padding
use strings/internal/pieces
use strings/internal/replacing
use strings/internal/runs
use strings/internal/samples
use strings/internal/search
use strings/internal/shell
use strings/internal/slug
use strings/internal/styles
use strings/internal/trimming
use strings/internal/windows_args
use unicode

## Codes

# The code a search fails with where the text holds nothing of what was asked.
constant NOT_FOUND: str
    "not_found"

# The code `slice_checked` fails with where its indices cut no part of the
# text, `split_shell` where a quote is never closed or a backslash ends the
# line, and `quote_windows_args` where a program name holds a double quote.
constant INVALID: str
    "invalid"

## Searching

# Whether `s` holds `substr`.
#
# - `s`: the text searched.
# - `substr`: the text looked for.
#
# Every text holds the empty text.
function contains(s: str, substr: str) -> bool
    return search.contains(s: s, substr: substr)

# Whether `s` holds any character of `set`.
#
# - `s`: the text searched.
# - `set`: the characters looked for, each one alone; their order does not
#   count.
#
# No text holds a character of the empty text.
function contains_any(s: str, set: str) -> bool
    return search.contains_any(s: s, set: set)

# Whether `s` begins with `prefix`.
#
# - `s`: the text asked about.
# - `prefix`: the text it may begin with.
#
# Every text begins with the empty text.
function has_prefix(s: str, prefix: str) -> bool
    return search.has_prefix_at(s: s, prefix: prefix, at: 0)

# Whether `prefix` stands in `s` at byte `at`.
#
# - `s`: the text asked about.
# - `prefix`: the text that may stand at `at`.
# - `at`: a byte index of `s`; any value.
#
# It is false for an `at` below 0 or past the end, so it never aborts; the
# empty text stands where a character begins and at the end. It copies
# nothing, where `has_prefix` on a slice copies the slice.
function has_prefix_at(s: str, prefix: str, at: i64) -> bool
    return search.has_prefix_at(s: s, prefix: prefix, at: at)

# Whether `s` ends with `suffix`.
#
# - `s`: the text asked about.
# - `suffix`: the text it may end with.
#
# Every text ends with the empty text.
function has_suffix(s: str, suffix: str) -> bool
    return search.has_suffix(s: s, suffix: suffix)

# Where `substr` first begins in `s`, as a byte index.
#
# - `s`: the text searched.
# - `substr`: the text looked for.
#
# Fails `not_found` where `s` holds none. The empty text is found at 0.
function index_of(s: str, substr: str) -> i64?
    return search.index_of_from(s: s, substr: substr, from: 0)

# Where `substr` first begins in `s` at or after byte `from`.
#
# - `s`: the text searched.
# - `substr`: the text looked for.
# - `from`: the byte where the search begins; any value.
#
# Fails `not_found` where that part of `s` holds none. A `from` below 0
# searches the whole text and one past the end finds nothing, so it never
# aborts; the empty text is found at the first character that begins at or
# after `from`, or at the end. It copies nothing, where `index_of` on a slice
# copies the slice.
function index_of_from(s: str, substr: str, from: i64) -> i64?
    return search.index_of_from(s: s, substr: substr, from: from)

# Where `substr` last begins in `s`, as a byte index.
#
# - `s`: the text searched.
# - `substr`: the text looked for.
#
# Fails `not_found` where `s` holds none. The empty text is found at the end,
# `s.len()`.
function index_of_last(s: str, substr: str) -> i64?
    return search.index_of_last(s: s, substr: substr)

# Where the first character of `s` that `set` holds begins, as a byte index.
#
# - `s`: the text searched.
# - `set`: the characters looked for, each one alone.
#
# Fails `not_found` where `s` holds no character of `set`, as it always does
# for an empty `set`.
function index_of_any(s: str, set: str) -> i64?
    return search.index_of_any_from(s: s, set: set, from: 0)

# Where the first character that `set` holds begins in `s` at or after byte
# `from`.
#
# - `s`: the text searched.
# - `set`: the characters looked for, each one alone.
# - `from`: the byte where the search begins; any value.
#
# Fails `not_found` where that part of `s` holds none. A `from` below 0
# searches the whole text, one past the end finds nothing, and one inside a
# character starts at the next character.
function index_of_any_from(s: str, set: str, from: i64) -> i64?
    return search.index_of_any_from(s: s, set: set, from: from)

# Where the last character of `s` that `set` holds begins, as a byte index.
#
# - `s`: the text searched.
# - `set`: the characters looked for, each one alone.
#
# Fails `not_found` where `s` holds no character of `set`.
function index_of_any_last(s: str, set: str) -> i64?
    return search.index_of_any_last(s: s, set: set)

# Where the first character of `s` that `accepts` accepts begins, as a byte
# index.
#
# - `s`: the text searched.
# - `accepts`: asked of each character, a `str` of one, in order; true ends
#   the search there.
#
# Fails `not_found` where it accepts none. `accepts` is asked each character
# in order and no more once it accepts one.
function index_where(s: str, accepts: (function(str) -> bool)) -> i64?
    return search.index_where_from(s: s, accepts: accepts, from: 0)

# Where the first character that `accepts` accepts begins in `s` at or after
# byte `from`.
#
# - `s`: the text searched.
# - `accepts`: asked of each character from `from` on, in order.
# - `from`: the byte where the search begins; any value.
#
# Fails `not_found` where it accepts none there. A `from` below 0 searches the
# whole text, one past the end finds nothing, and one inside a character
# starts at the next character.
function index_where_from(s: str, accepts: (function(str) -> bool), from: i64) -> i64?
    return search.index_where_from(s: s, accepts: accepts, from: from)

# Where the last character of `s` that `accepts` accepts begins, as a byte
# index.
#
# - `s`: the text searched.
# - `accepts`: asked of each character, from the last one back.
#
# Fails `not_found` where it accepts none. `accepts` is asked each character
# from the end backwards.
function index_where_last(s: str, accepts: (function(str) -> bool)) -> i64?
    return search.index_where_last(s: s, accepts: accepts)

# How many times `s` holds `substr`, counted from the start with no two
# occurrences sharing a byte: "aaaa" holds "aa" twice.
#
# - `s`: the text searched.
# - `substr`: the text counted.
#
# The empty text is counted once more than `s` has characters.
function count_of(s: str, substr: str) -> i64
    return search.count_of(s: s, substr: substr)

# Where each occurrence of `substr` begins in `s`, in order, as byte indices,
# taken from the start with no two sharing a byte.
#
# - `s`: the text searched.
# - `substr`: the text looked for.
#
# The empty text is found before every character and at the end.
function index_of_all(s: str, substr: str) -> [i64]
    return search.index_of_all(s: s, substr: substr)

## Comparing

# Which of `a` and `b` orders first: -1 where `a` does, 1 where `b` does, 0
# where they are the same text.
#
# - `a`: the first text.
# - `b`: the second text.
#
# The order is by bytes, the one the built-in `sort` gives a `[str]`, which
# for UTF-8 is the order of the code points; a text orders before every longer
# text that begins with it.
function compare(a: str, b: str) -> i64
    return bytewise.compare(a: a, b: b)

# Whether `a` and `b` are the same text once the case of their letters is set
# aside, by Unicode's case folding, which is the same for every language.
#
# - `a`: the first text.
# - `b`: the second text.
#
# Nothing is normalised: a letter with its accent written as one character
# differs from the same letter followed by a combining accent.
function equals_ignoring_case(a: str, b: str) -> bool
    return casing.equals_ignoring_case(a: a, b: b)

# Whether `a` and `b` are the same text once the case of their ASCII letters,
# "a" to "z", is set aside.
#
# - `a`: the first text.
# - `b`: the second text.
#
# Every other character must be the same byte for byte, so "É" and "é" differ.
function equals_ignoring_case_ascii(a: str, b: str) -> bool
    return bytewise.equals_ignoring_case_ascii(a: a, b: b)

## Splitting

# What `split_once` and `split_once_last` answer: a text cut in two around a
# separator, which is in neither part.
record Halves
    # The text before the separator.
    before: str
    # The text after the separator.
    after: str

# The text of `s` before its first `sep` and the text after it.
#
# - `s`: the text cut.
# - `sep`: the separator, looked for from the start.
#
# Fails `not_found` where `s` holds no `sep`. An empty `sep` is found at the
# start, so `before` is empty and `after` is `s`.
function split_once(s: str, sep: str) -> Halves?
    at = search.index_of_from(s: s, substr: sep, from: 0)?
    return ok(Halves(before: s.slice(from: 0, to: at), after: s.slice(from: at + sep.len(), to: s.len())))

# The text of `s` before its last `sep` and the text after it.
#
# - `s`: the text cut.
# - `sep`: the separator, looked for from the end.
#
# Fails `not_found` where `s` holds no `sep`. An empty `sep` is found at the
# end, so `before` is `s` and `after` is empty.
function split_once_last(s: str, sep: str) -> Halves?
    at = search.index_of_last(s: s, substr: sep)?
    return ok(Halves(before: s.slice(from: 0, to: at), after: s.slice(from: at + sep.len(), to: s.len())))

# The pieces of `s` between its `sep`s, one more than `count_of` counts: a
# `sep` at either end leaves an empty piece there, and a text holding no `sep`
# is its own one piece, the empty text included.
#
# - `s`: the text cut.
# - `sep`: the separator, which no piece holds.
#
# An empty `sep` cuts between every two characters, so the pieces are the
# characters of `s`, and none for the empty text.
function split(s: str, sep: str) -> [str]
    return pieces.split(s: s, sep: sep)

# At most `n` pieces of `s` between its `sep`s, cut from the start; the last
# piece holds the rest of `s`, later `sep`s included.
#
# - `s`: the text cut.
# - `sep`: the separator.
# - `n`: the most pieces answered.
#
# No piece at all for an `n` of 0. An empty `sep` cuts after each character.
function split_n(s: str, sep: str, n: u64) -> [str]
    return pieces.split_n(s: s, sep: sep, n: n)

# At most `n` pieces of `s` between its `sep`s, cut from the end; the first
# piece holds the rest of `s`, earlier `sep`s included.
#
# - `s`: the text cut.
# - `sep`: the separator.
# - `n`: the most pieces answered.
#
# The pieces stand in the order of the text. No piece at all for an `n` of 0.
# An empty `sep` cuts before each character.
function split_n_last(s: str, sep: str, n: u64) -> [str]
    return pieces.split_n_last(s: s, sep: sep, n: n)

# The pieces of `s`, each ending with the `sep` that follows it, and a last
# piece for what follows the last `sep` where anything does.
#
# - `s`: the text cut.
# - `sep`: the separator, kept at the end of the piece it ends.
#
# Joined with "" they are `s` again, and none is empty, so the empty text has
# no pieces. With "\n" they are the lines of `s` with their ends. An empty
# `sep` gives the characters of `s`.
function split_after(s: str, sep: str) -> [str]
    return pieces.split_after(s: s, sep: sep)

# At most `n` pieces of `s`, each ending with the `sep` that follows it, cut
# from the start; the last piece holds the rest of `s`.
#
# - `s`: the text cut.
# - `sep`: the separator, kept at the end of the piece it ends.
# - `n`: the most pieces answered.
#
# No piece at all for an `n` of 0, and none is empty.
function split_after_n(s: str, sep: str, n: u64) -> [str]
    return pieces.split_after_n(s: s, sep: sep, n: n)

# The pieces of `s` that `sep` ends: what `split` answers without the empty
# piece after a final `sep`, so "a;b;" and "a;b" are both "a" and "b".
#
# - `s`: the text cut.
# - `sep`: what ends each piece, as ";" ends a statement.
#
# The empty text has no pieces.
function split_terminated(s: str, sep: str) -> [str]
    return pieces.split_terminated(s: s, sep: sep)

# The pieces of `s` between its characters that `set` holds, one more than
# there are such characters.
#
# - `s`: the text cut.
# - `set`: the characters that separate, each one alone.
#
# An empty `set` cuts nowhere and answers `s` as its one piece.
function split_any(s: str, set: str) -> [str]
    return pieces.split_any(s: s, set: set)

# The pieces of `s` between its characters that `separates` accepts, one more
# than there are such characters, so two of them side by side leave an empty
# piece between; `words_where` leaves none.
#
# - `s`: the text cut.
# - `separates`: asked of each character, a `str` of one, in order; true makes
#   it a separator.
function split_where(s: str, separates: (function(str) -> bool)) -> [str]
    return pieces.split_where(s: s, separates: separates)

# The words of `s`: the pieces between its runs of white space, none of them
# empty, so a text of white space alone has no words.
#
# - `s`: the text; white space is Unicode's, as `trim` reads it.
#
# The words of a language, as UAX #29 finds them between punctuation and in
# scripts written without spaces, are `unicode/segment.words`. See also
# `words_n`.
function words(s: str) -> [str]
    return runs.words(s)

# The pieces of `s` between its runs of characters that `separates` accepts,
# none of them empty.
#
# - `s`: the text cut.
# - `separates`: asked of each character, in order; a run of characters it
#   accepts separates two words.
function words_where(s: str, separates: (function(str) -> bool)) -> [str]
    return runs.words_where(s: s, separates: separates)

# At most `n` words of `s`, read from the start, as Python's `split` with no
# separator reads them: the white space at the start is passed over, and the
# last word holds the rest of `s` from where it begins, the white space at its
# end kept.
#
# - `s`: the text cut.
# - `n`: the most words answered.
#
# No word at all for an `n` of 0. White space is `trim`'s.
function words_n(s: str, n: u64) -> [str]
    return runs.words_n(s: s, n: n)

# At most `n` words of `s`, read from the end, in the order of the text: the
# white space at the end is passed over, and the first word holds the rest of
# `s` up to where it ends, the white space at its start kept.
#
# - `s`: the text cut.
# - `n`: the most words answered.
#
# No word at all for an `n` of 0.
function words_n_last(s: str, n: u64) -> [str]
    return runs.words_n_last(s: s, n: n)

# The lines of `s`, each without its end, which is "\n" or "\r\n".
#
# - `s`: the text; the empty text has no lines.
#
# The last line's end is optional, so "a\nb" and "a\nb\n" are the same two
# lines, and a "\r" with no "\n" after it ends nothing. See also
# `split_after`, whose pieces with "\n" are the lines with their ends kept.
function lines(s: str) -> [str]
    return runs.lines(s)

## Trimming

# `s` without the white space at either end.
#
# - `s`: the text trimmed.
#
# White space is Unicode's White_Space as the package `unicode` reads it:
# space, tab, line feed and carriage return among others, and the no-break
# space.
function trim(s: str) -> str
    return trimming.trim(s)

# `s` without the white space at its start, white space being `trim`'s.
#
# - `s`: the text trimmed.
function trim_start(s: str) -> str
    return trimming.trim_start(s)

# `s` without the white space at its end, white space being `trim`'s.
#
# - `s`: the text trimmed.
function trim_end(s: str) -> str
    return trimming.trim_end(s)

# `s` without the characters of `set` at either end: a character is taken off
# an end for as long as `set` holds it.
#
# - `s`: the text trimmed.
# - `set`: the characters taken off, each one alone; the empty set takes
#   nothing off.
#
# `set` is a set, not a text to match; `trim_prefix` and `trim_suffix` take a
# text off.
function trim_any(s: str, set: str) -> str
    return trimming.trim_any(s: s, set: set)

# `s` without the characters of `set` at its start.
#
# - `s`: the text trimmed.
# - `set`: the characters taken off, each one alone.
function trim_start_any(s: str, set: str) -> str
    return trimming.trim_start_any(s: s, set: set)

# `s` without the characters of `set` at its end.
#
# - `s`: the text trimmed.
# - `set`: the characters taken off, each one alone.
function trim_end_any(s: str, set: str) -> str
    return trimming.trim_end_any(s: s, set: set)

# `s` without the characters that `accepts` accepts at either end.
#
# - `s`: the text trimmed.
# - `accepts`: asked of each character at an end, a `str` of one; true takes
#   it off.
function trim_where(s: str, accepts: (function(str) -> bool)) -> str
    return trimming.trim_where(s: s, accepts: accepts)

# `s` without the characters that `accepts` accepts at its start.
#
# - `s`: the text trimmed.
# - `accepts`: asked of each character from the start; true takes it off.
function trim_start_where(s: str, accepts: (function(str) -> bool)) -> str
    return trimming.trim_start_where(s: s, accepts: accepts)

# `s` without the characters that `accepts` accepts at its end.
#
# - `s`: the text trimmed.
# - `accepts`: asked of each character from the end; true takes it off.
function trim_end_where(s: str, accepts: (function(str) -> bool)) -> str
    return trimming.trim_end_where(s: s, accepts: accepts)

# `s` without `prefix` at its start, or `s` itself where it does not begin
# with it.
#
# - `s`: the text trimmed.
# - `prefix`: the text taken off its start.
#
# The prefix is taken off once: `trim_prefix_all` takes off every one, and
# `after_prefix` says whether it was there.
function trim_prefix(s: str, prefix: str) -> str
    return trimming.trim_prefix(s: s, prefix: prefix)

# `s` without `suffix` at its end, or `s` itself where it does not end with
# it.
#
# - `s`: the text trimmed.
# - `suffix`: the text taken off its end.
#
# The suffix is taken off once: `trim_suffix_all` takes off every one, and
# `before_suffix` says whether it was there.
function trim_suffix(s: str, suffix: str) -> str
    return trimming.trim_suffix(s: s, suffix: suffix)

# `s` without `prefix` at its start, taken off for as many times as what is
# left begins with it: "ababc" without "ab" is "c".
#
# - `s`: the text trimmed.
# - `prefix`: the text taken off its start, again and again.
#
# An empty `prefix` takes nothing off.
function trim_prefix_all(s: str, prefix: str) -> str
    return trimming.trim_prefix_all(s: s, prefix: prefix)

# `s` without `suffix` at its end, taken off for as many times as what is left
# ends with it: "cabab" without "ab" is "c".
#
# - `s`: the text trimmed.
# - `suffix`: the text taken off its end, again and again.
#
# An empty `suffix` takes nothing off.
function trim_suffix_all(s: str, suffix: str) -> str
    return trimming.trim_suffix_all(s: s, suffix: suffix)

# The text of `s` after `prefix`.
#
# - `s`: the text read.
# - `prefix`: the text it must begin with.
#
# Fails `not_found` where `s` does not begin with `prefix`. An empty `prefix`
# is always there, and the text after it is `s`.
function after_prefix(s: str, prefix: str) -> str?
    return trimming.after_prefix(s: s, prefix: prefix)

# The text of `s` before `suffix`.
#
# - `s`: the text read.
# - `suffix`: the text it must end with.
#
# Fails `not_found` where `s` does not end with `suffix`. An empty `suffix` is
# always there, and the text before it is `s`.
function before_suffix(s: str, suffix: str) -> str?
    return trimming.before_suffix(s: s, suffix: suffix)

# The text of `s` between `prefix` at its start and `suffix` at its end.
#
# - `s`: the text read.
# - `prefix`: the text it must begin with.
# - `suffix`: the text it must end with, after `prefix`.
#
# Fails `not_found` where `s` does not begin with `prefix`, does not end with
# `suffix`, or is too short to hold the two apart: "aba" is not "ab" then
# "ba".
function between(s: str, prefix: str, suffix: str) -> str?
    return trimming.between(s: s, prefix: prefix, suffix: suffix)

## Replacing

# `s` with every `old` replaced by `new`, the occurrences taken from the start
# with no two sharing a byte.
#
# - `s`: the text read.
# - `old`: the text replaced.
# - `new`: the text written in its place.
#
# An empty `old` stands before every character and at the end, so `new` is
# written in each of those places.
function replace_all(s: str, old: str, new: str) -> str
    return replacing.replace_all(s: s, old: old, new: new)

# `s` with its first `n` occurrences of `old` replaced by `new`, taken as
# `replace_all` takes them; `s` itself for an `n` of 0.
#
# - `s`: the text read.
# - `old`: the text replaced.
# - `new`: the text written in its place.
# - `n`: the most occurrences replaced.
function replace_n(s: str, old: str, new: str, n: u64) -> str
    return replacing.replace_n(s: s, old: old, new: new, n: n)

# `s` with its last `old` replaced by `new`, or `s` itself where it holds
# none.
#
# - `s`: the text read.
# - `old`: the text replaced.
# - `new`: the text written in its place.
#
# An empty `old` stands at the end, so `new` is written there.
function replace_last(s: str, old: str, new: str) -> str
    return replacing.replace_last(s: s, old: old, new: new)

# `s` with each key of `pairs` replaced by its value, in one pass from the
# start: at each position the first key, in the order the map was filled, that
# stands there is replaced, and the search goes on after it, so what a
# replacement wrote is never replaced again and two pairs can swap two texts.
#
# - `s`: the text read.
# - `pairs`: each text to replace, mapped to the text written in its place.
#
# A pair whose key is empty is passed over.
function replace_pairs(s: str, pairs: {str: str}) -> str
    return replacing.replace_pairs(s: s, pairs: pairs)

## Padding

# `s` with `pad` written before it until the whole is `width` characters long.
#
# - `s`: the text padded; it is answered as it is where it is `width`
#   characters long or more.
# - `width`: the characters the answer holds; any value.
# - `pad`: the text written, again and again, cut after a character where the
#   width is reached; the empty one pads nothing.
#
# The width counts characters, not bytes and not the columns a terminal draws:
# a column of text in any script is aligned by
# `unicode/segment.pad_start_columns`, which counts what
# `unicode/segment.width_of` counts. See also `pad_end`, `pad_zeros`.
function pad_start(s: str, width: i64, pad: str) -> str
    return padding.pad_start(s: s, width: width, pad: pad)

# `s` with `pad` written after it until the whole is `width` characters long,
# or `s` itself where it is that long already or `pad` is empty.
#
# - `s`: the text padded; it is answered as it is where it is `width`
#   characters long or more.
# - `width`: the characters the answer holds; any value.
# - `pad`: the text written, again and again.
#
# The width and a `pad` of several characters are read as `pad_start` reads
# them.
function pad_end(s: str, width: i64, pad: str) -> str
    return padding.pad_end(s: s, width: width, pad: pad)

# `s` with `pad` written on both sides until the whole is `width` characters
# long, half of the padding before and half after, the odd character after;
# `s` itself where it is that long already or `pad` is empty.
#
# - `s`: the text padded; it is answered as it is where it is `width`
#   characters long or more.
# - `width`: the characters the answer holds; any value.
# - `pad`: the text written on each side.
#
# The width and a `pad` of several characters are read as `pad_start` reads
# them, each side starting `pad` afresh.
function center(s: str, width: i64, pad: str) -> str
    return padding.center(s: s, width: width, pad: pad)

# `s`, the text of a number, with zeros written after its sign, "+" or "-", or
# at its start where it has none, until the whole is `width` characters long;
# `s` itself where it is that long already.
#
# - `s`: the number's text.
# - `width`: the characters the answer holds; any value.
#
# It does not ask whether `s` is a number.
function pad_zeros(s: str, width: i64) -> str
    return padding.pad_zeros(s: s, width: width)

# `s` with each tab replaced by the spaces that reach the next tab stop, a
# stop standing every `tab_width` characters from the start of the line.
#
# - `s`: the text; a line starts after "\n" or "\r".
# - `tab_width`: the characters between two stops; 0 or less takes the tabs
#   out.
#
# A line starts after "\n" or "\r", and a tab at a stop takes `tab_width`
# spaces. A `tab_width` of 0 or less takes the tabs out and writes nothing for
# them.
function expand_tabs(s: str, tab_width: i64) -> str
    return padding.expand_tabs(s: s, tab_width: tab_width)

## Case

# `s` in lower case by Unicode's full mapping, the same for every language:
# each character lowered alone but the capital sigma, which becomes "ς" where
# it ends a word and "σ" elsewhere, by Unicode's Final_Sigma (a cased letter
# before it and none after it, an apostrophe or another case-ignorable
# character passed over), as Python and Rust write it: "ΣΊΣΥΦΟΣ" is "σίσυφος".
#
# - `s`: the text lowered.
#
# The text may change its length in bytes and in characters. Turkish, Azeri
# and Lithuanian lower some letters by rules of their own, "I" to a dotless
# "ı" in Turkish: `unicode/normalize.to_lower_for`. See also `to_lower_ascii`,
# `to_casefold`.
function to_lower(s: str) -> str
    return casing.to_lower(s)

# `s` in upper case, each character by Unicode's mapping, which is the same
# for every language.
#
# - `s`: the text raised.
#
# The text may change its length in bytes and in characters: "ß" is "SS".
# Turkish, Azeri and Lithuanian raise some letters by rules of their own, "i"
# to a dotted "İ" in Turkish: `unicode/normalize.to_upper_for`. See also
# `to_upper_ascii`.
function to_upper(s: str) -> str
    return casing.to_upper(s)

# `s` with the first letter of each word in title case and its other letters
# in lower case.
#
# - `s`: the text written in title case.
#
# A word is a run of letters that have a case, so a digit, an apostrophe or an
# underscore ends one and the letter after it starts the next: "they're"
# becomes "They'Re".
function to_title(s: str) -> str
    return casing.to_title(s)

# `s` with its first character in title case and every other in lower case.
#
# - `s`: the text capitalised; the empty text answers itself.
function capitalize(s: str) -> str
    return casing.capitalize(s)

# `s` with each upper case letter in lower case and each lower case letter in
# upper case.
#
# - `s`: the text whose case is swapped.
#
# Swapping twice does not always give `s` back, since a letter's other case
# can be more than one character.
function swap_case(s: str) -> str
    return casing.swap_case(s)

# `s` folded, the form two texts take where they differ only in the case of
# their letters, by Unicode's full case folding: "Straße" and "STRASSE" fold
# alike.
#
# - `s`: the text folded.
#
# A folded text is for comparing, never for showing. Turkish and Azeri fold
# "I" and "İ" by rules of their own: `unicode/normalize.to_casefold_for`; a
# fold that sets canonical equivalence aside too is
# `unicode/normalize.to_caseless`. See also `equals_ignoring_case`.
function to_casefold(s: str) -> str
    return casing.to_casefold(s)

# `s` with its ASCII letters "A" to "Z" in lower case and every other
# character as it was.
#
# - `s`: the text lowered.
#
# The length does not change.
function to_lower_ascii(s: str) -> str
    return bytewise.ascii_case(s: s, upper: false)

# `s` with its ASCII letters "a" to "z" in upper case and every other
# character as it was.
#
# - `s`: the text raised.
#
# The length does not change.
function to_upper_ascii(s: str) -> str
    return bytewise.ascii_case(s: s, upper: true)

# Whether `s` holds a letter that has a case and none of them is upper or
# title case.
#
# - `s`: the text asked about.
#
# Characters with no case, digits and spaces among them, are passed over, and
# a text with no cased letter is not lower case.
function is_lower(s: str) -> bool
    return casing.is_lower(s)

# Whether `s` holds a letter that has a case and none of them is lower or
# title case.
#
# - `s`: the text asked about.
#
# Characters with no case, digits and spaces among them, are passed over, and
# a text with no cased letter is not upper case.
function is_upper(s: str) -> bool
    return casing.is_upper(s)

# Whether `s` is in the form `to_title` writes: it holds a letter that has a
# case, every word begins with an upper or title case letter, and every other
# cased letter is lower case.
#
# - `s`: the text asked about.
function is_title(s: str) -> bool
    return casing.is_title(s)

## Case styles

# The words of `s` as the case style functions cut them, each as it stands
# in `s`: its runs of letters and numbers, every other character ending one,
# each run cut after a lower case letter that an upper case one follows, and
# before the last capital of a run of them that a lower case letter follows,
# so "XMLHttpRequest" is "XML", "Http" and "Request". A digit or a letter with
# no case cuts nothing: "Version2Point0" is "Version2" and "Point0".
#
# - `s`: the name or text cut; a combining mark that follows a letter stays
#   in its word.
#
# The words are in the order of `s`, none of them empty, so a text with no
# letter or number has none. These are the boundaries of Rust's crate heck.
# See also `to_snake_case`.
function case_words(s: str) -> [str]
    return styles.case_words(s)

# `s` as snake_case: the words of `case_words` in lower case, joined by `_`.
#
# - `s`: the name or text written; the empty text answers itself.
#
# See also `to_screaming_snake_case` and `to_kebab_case`.
function to_snake_case(s: str) -> str
    return styles.snake(s)

# `s` as kebab-case: the words of `case_words` in lower case, joined by `-`.
#
# - `s`: the name or text written.
#
# See also `to_snake_case`.
function to_kebab_case(s: str) -> str
    return styles.kebab(s)

# `s` as SCREAMING_SNAKE_CASE: the words of `case_words` in upper case, joined
# by `_`, the form of a constant's name. A letter's upper case may be longer:
# "ß" is "SS".
#
# - `s`: the name or text written.
#
# See also `to_snake_case`.
function to_screaming_snake_case(s: str) -> str
    return styles.screaming_snake(s)

# `s` as SCREAMING-KEBAB-CASE: the words of `case_words` in upper case, joined
# by `-`.
#
# - `s`: the name or text written.
#
# See also `to_kebab_case`.
function to_screaming_kebab_case(s: str) -> str
    return styles.screaming_kebab(s)

# `s` as camelCase: the first word of `case_words` in lower case and every
# other with its first character in title case and the rest in lower case,
# joined with nothing between.
#
# - `s`: the name or text written; words that are digits alone join with
#   nothing between, so "1_2" is "12".
#
# See also `to_pascal_case`.
function to_camel_case(s: str) -> str
    return styles.camel(s)

# `s` as PascalCase: every word of `case_words` with its first character in
# title case and the rest in lower case, joined with nothing between. Title
# case is the form a letter takes at the start of a word: "ǅ" for "ǆ", "Ss"
# for "ß", where heck writes the upper case, "Ǆ" and "SS".
#
# - `s`: the name or text written.
#
# See also `to_camel_case` and `to_title_case`.
function to_pascal_case(s: str) -> str
    return styles.pascal(s)

# `s` as Title Case: the words of `case_words`, each capitalised as
# `to_pascal_case` capitalises it, joined by one space. Unlike `to_title`,
# which keeps every character of `s`, it cuts `s` into words first:
# "XMLHttpRequest" is "Xml Http Request".
#
# - `s`: the name or text written.
#
# See also `to_train_case`.
function to_title_case(s: str) -> str
    return styles.title_words(s)

# `s` as Train-Case: the words of `case_words`, each capitalised as
# `to_pascal_case` capitalises it, joined by `-`, the form of an HTTP header's
# name.
#
# - `s`: the name or text written.
#
# See also `to_title_case`.
function to_train_case(s: str) -> str
    return styles.train(s)

# The slug of `s`, the part of a URL that names a page, as Django's `slugify`
# makes it: `s` in lower case, kept to its letters, numbers, underscores,
# hyphens and white space, each run of white space and hyphens written as one
# `-`, and `-` and `_` taken off both ends.
#
# - `s`: the title; a text with no letter or number answers the empty text.
#
# Letters and numbers of every script stay, so "日本語" is a slug of its own. A
# text is not decomposed first: an accent written as a mark of its own is
# taken away, "e" and U+0301 giving "e", but one written in the same character
# as its letter stays, "é" giving "é". Decomposed first,
# `strings.to_slug(normalize.to_nfkd(s))`, it is the slug Django writes: "Café
# au lait" gives "cafe-au-lait" (run 2026-11-20). See also `to_kebab_case`.
function to_slug(s: str) -> str
    return slug.slug(s)

## Command lines

# The words a POSIX shell reads in `s`, by its quoting alone: blanks (space,
# tab, line feed) between words; single quotes, inside which every character
# stands as it is; double quotes, inside which a backslash takes `$`, a
# backquote, `"`, a backslash or a line feed as itself and stands as itself
# before any other character; a backslash outside quotes that takes the
# character after it as itself; a backslash before a line feed taken away
# with it; and a comment from a `#` that begins a word to the end of its
# line.
#
# - `s`: the line; empty quotes make an empty word.
#
# Nothing is expanded and no operator is read, as Python's `shlex.split` and
# Rust's crate shlex read them: `$HOME`, `*.txt` and `a;b` are words as they
# stand. Fails `invalid` where a quote is never closed or a backslash ends
# `s`, the message naming its byte. See also `process.quote`, which writes a
# word this reads back whole, and `split_windows_args`.
function split_shell(s: str) -> [str]?
    return shell.split(s)

# The arguments of a Windows command line, the program name first, as the C
# runtime reads them into a program's `argv` by Microsoft's documented rules
# since Visual Studio 2008: arguments between spaces and tabs; double quotes
# that group, two side by side inside a quoted part making one quote and the
# part going on; backslashes as they stand but before a double quote, where
# they are halved and an odd one left makes the quote itself; and a program
# name that runs to the first blank outside double quotes, its quotes taken
# away and its backslashes as they stand.
#
# - `s`: the command line; one that begins with a blank names an empty
#   program, and one that ends inside double quotes ends its last argument.
#
# The empty line has no arguments, where `CommandLineToArgvW` answers the
# path of the program running. Shell32's `CommandLineToArgvW` reads the same
# but for two double quotes inside a quoted part, which it makes one quote
# that closes the part: `p "a""b" c` is `p`, `a"b`, `c` here and in the C
# runtime, and `p`, `a"b c` there (both run on Windows, 2026-11-18). See also
# `quote_windows_args` and `split_shell`.
function split_windows_args(s: str) -> [str]
    return windows_args.split(s)

# `argument` written as one argument of a Windows command line, read back
# whole by `split_windows_args` after the program name: as it stands where it
# is not empty and holds no space or tab, else between double quotes; each
# double quote after a backslash, and the backslashes before it doubled, and
# the backslashes that end a quoted argument doubled, as Python's
# `subprocess.list2cmdline` writes it.
#
# - `argument`: the argument; the empty one is written `""`.
#
# See also `quote_windows_args`.
function quote_windows_arg(argument: str) -> str
    return windows_args.quoted(argument)

# The Windows command line whose arguments are `arguments`, read back by
# `split_windows_args` as the same list: the program name `arguments[0]` between
# double quotes where it is empty or holds a space or a tab, each other
# argument by `quote_windows_arg`, one space between.
#
# - `arguments`: the program name, then its arguments; none make the empty
#   line.
#
# Fails `invalid` where the program name holds a double quote, which its own
# rule cannot carry. Python's `list2cmdline` writes a program name as an
# argument, so a name that ends in a backslash, "C:\dir\", is read back with
# the backslash doubled; here it is not. See also `split_windows_args`.
function quote_windows_args(arguments: [str]) -> str?
    return windows_args.quoted_line(arguments)

## Bytes and boundaries

# Whether every character of `s` is ASCII, which is whether every byte is
# below 128.
#
# - `s`: the text asked about.
#
# The empty text is.
function is_ascii(s: str) -> bool
    return bounds.is_ascii(s)

# The bytes of `s`, which are its UTF-8.
#
# - `s`: the text.
#
# `validated_bytes` reads them back as the same text.
function to_bytes(s: str) -> [u8]
    return bounds.to_bytes(s)

# Whether byte index `at` of `s` stands between two characters: at 0, at
# `s.len()`, or where a character begins.
#
# - `s`: the text.
# - `at`: a byte index of `s`; any value.
#
# It is false for an `at` below 0 or past the end, so it never aborts. A slice
# may start and end only at such an index.
function is_boundary(s: str, at: i64) -> bool
    return unicode.is_char_boundary(s, at)

# The nearest index at or below `at` where `is_boundary` holds, so that
# `s.slice(from: 0, to: floor_boundary(s, at))` is `s` cut to at most `at`
# bytes without splitting a character.
#
# - `s`: the text.
# - `at`: a byte index of `s`; any value.
#
# An `at` below 0 answers 0 and one past the end answers `s.len()`.
function floor_boundary(s: str, at: i64) -> i64
    return unicode.floor_char_boundary(s, at)

# The nearest index at or above `at` where `is_boundary` holds.
#
# - `s`: the text.
# - `at`: a byte index of `s`; any value.
#
# An `at` below 0 answers 0 and one past the end answers `s.len()`.
function ceil_boundary(s: str, at: i64) -> i64
    return unicode.ceil_char_boundary(s, at)

# The part of `s` from byte `from` up to byte `to`, which is not included.
#
# - `s`: the text cut.
# - `from`: the first byte of the part; any value, which is checked.
# - `to`: the byte after the part's last; any value, which is checked.
#
# Fails `invalid` where either index is below 0 or past the end, where `to` is
# below `from`, or where either stands inside a character: the cases in which
# the built-in `slice` aborts. It is for indices that come from outside the
# program.
function slice_checked(s: str, from: i64, to: i64) -> str?
    return bounds.slice_checked(s: s, from: from, to: to)

## Many patterns at once

# How a search for many patterns at once chooses among the matches that
# overlap or begin at one place, the three kinds of Rust's crate aho-corasick.
variant MatchKind
    # The match whose end is read first, and among the matches that end there
    # the longest: the kind of Aho and Corasick's own automaton. With "b" and
    # "abcd", the text "abcd" matches "b".
    standard
    # The match that begins first, and among the matches that begin there the
    # pattern that stands first in the list, as a regular expression `a|b`
    # takes its first branch. With "Sam" before "Samwise", the text "Samwise"
    # matches "Sam".
    leftmost_first
    # The match that begins first, and among the matches that begin there the
    # longest. With "Sam" and "Samwise" in either order, the text "Samwise"
    # matches "Samwise".
    leftmost_longest

# Many patterns made into one automaton, the one of Aho and Corasick, so that
# a text is searched for all of them in one pass. It is made only by
# `compile_patterns` or `compile_patterns_ignoring_case_ascii`; one built
# directly searches for nothing it says.
record Patterns
    # The patterns, in the order they were given; a match names its pattern
    # by its index here.
    texts: [str]
    # How a search chooses among the matches.
    kind: MatchKind
    # Whether an ASCII letter matches its other case: "A" to "Z" and "a" to
    # "z" alike, every other byte only itself.
    ignores_case_ascii: bool
    # The automaton the patterns compiled to, which the functions below run.
    compiled: automaton.Machine

# One match of one of many patterns in a text.
record PatternMatch
    # The pattern that matched, by its index in the list it was compiled from.
    pattern: i64
    # Where the match begins in the text searched, as a byte index.
    start: i64
    # Where it ends: the byte index just after its last byte.
    end: i64
    # The text matched, which is the pattern itself but where ASCII letters
    # were matched without their case.
    text: str

# `patterns` compiled into one automaton, searched by `kind`, every byte
# matching only itself.
#
# - `patterns`: the texts sought, their order being their priority for
#   `leftmost_first`; none matches nothing, the empty text matches where
#   every character begins and at the end, and a text given twice is
#   reported as the first of the two, but by `search_patterns_overlapping`,
#   which reports both.
# - `kind`: how a search chooses among matches that overlap or begin at one
#   place.
#
# It costs time and memory linear in the patterns' total length, once. See
# also `compile_patterns_ignoring_case_ascii` and `search_patterns_all`.
function compile_patterns(patterns: [str], kind: MatchKind) -> Patterns
    code = match kind
        .standard         => automaton.STANDARD
        .leftmost_first   => automaton.LEFTMOST_FIRST
        .leftmost_longest => automaton.LEFTMOST_LONGEST

    return Patterns(
        texts: patterns,
        kind: kind,
        ignores_case_ascii: false,
        compiled: automaton.build(patterns: patterns, kind: code, caseless: false)
    )

# `patterns` compiled into one automaton, searched by `kind`, each ASCII
# letter matching itself in either case, so "Rebel" matches "REBEL" and
# "rebel".
#
# - `patterns`: the texts sought, read as `compile_patterns` reads them; a
#   letter outside ASCII, "É" or "é", matches only itself.
# - `kind`: how a search chooses among matches.
#
# See also `compile_patterns` and `equals_ignoring_case_ascii`.
function compile_patterns_ignoring_case_ascii(patterns: [str], kind: MatchKind) -> Patterns
    code = match kind
        .standard         => automaton.STANDARD
        .leftmost_first   => automaton.LEFTMOST_FIRST
        .leftmost_longest => automaton.LEFTMOST_LONGEST

    return Patterns(
        texts: patterns,
        kind: kind,
        ignores_case_ascii: true,
        compiled: automaton.build(patterns: patterns, kind: code, caseless: true)
    )

# Whether `s` holds any of the patterns.
#
# - `s`: the text searched.
# - `patterns`: the compiled patterns; whatever their kind, any match
#   answers true, and an empty pattern makes every text hold one.
#
# It stops at the first match's end. See also `search_patterns`.
function has_match(s: str, patterns: Patterns lent) -> bool
    return multi.earliest(m: patterns.compiled, s: s, from: 0).pattern != -1

# The first match of the patterns in `s`, chosen by their kind.
#
# - `s`: the text searched.
# - `patterns`: the compiled patterns.
#
# Fails `not_found` where `s` holds none of them. It reads `s` once, but
# where the kind is leftmost it may read on past the match by up to the
# length of the longest pattern. See also `search_patterns_from` and
# `search_patterns_all`.
function search_patterns(s: str, patterns: Patterns lent) -> PatternMatch?
    return search_patterns_from(s: s, patterns: patterns, from: 0)

# The first match of the patterns that begins in `s` at or after byte `from`,
# chosen by their kind.
#
# - `s`: the text searched.
# - `patterns`: the compiled patterns.
# - `from`: the byte where the search begins; below 0 the search begins at
#   0, inside a character at the next character, and past the end it finds
#   nothing.
#
# Fails `not_found` where that part of `s` holds none of them. It copies
# nothing, where `search_patterns` on a slice copies the slice. See also
# `match_patterns_at`.
function search_patterns_from(s: str, patterns: Patterns lent, from: i64) -> PatternMatch?
    if from > s.len()
        return fail(code: NOT_FOUND, msg: search.missing(what: "pattern", s: s, from: from))
    begin = unicode.ceil_char_boundary(s, from)
    f = multi.search_from(m: patterns.compiled, s: s, from: begin)

    if f.pattern == -1
        return fail(code: NOT_FOUND, msg: search.missing(what: "pattern", s: s, from: from))
    return ok(PatternMatch(pattern: f.pattern, start: f.start, end: f.end, text: s.slice(from: f.start, to: f.end)))

# The match of the patterns that begins at byte `at` of `s`, as a lexer reads
# a token where the last one ended: the shortest for `standard`, the first in
# the list for `leftmost_first`, the longest for `leftmost_longest`.
#
# - `s`: the text read.
# - `patterns`: the compiled patterns.
# - `at`: the byte where the match must begin; below 0, past the end or
#   inside a character, nothing begins there.
#
# Fails `not_found` where no pattern begins at `at`. It reads no further than
# the longest pattern. See also `search_patterns_from`.
function match_patterns_at(s: str, patterns: Patterns lent, at: i64) -> PatternMatch?
    f = multi.anchored(m: patterns.compiled, s: s, at: at)

    if f.pattern == -1
        return fail(code: NOT_FOUND, msg: f"no pattern at byte {at} of {messages.shown(s)}")
    return ok(PatternMatch(pattern: f.pattern, start: f.start, end: f.end, text: s.slice(from: f.start, to: f.end)))

# Every match of the patterns in `s`, one after another from the start, each
# chosen by their kind where the one before ended, none overlapping another.
#
# - `s`: the text searched.
# - `patterns`: the compiled patterns.
#
# The matches stand in the order of the text. An empty match is not reported
# where the match before it ended, and the search then goes on a character
# later, so a text of n characters has at most n + 1 matches of the empty
# pattern. See also `search_patterns_overlapping` and `replace_patterns_all`.
function search_patterns_all(s: str, patterns: Patterns lent) -> [PatternMatch]
    found = multi.one_by_one(m: patterns.compiled, s: s)
    all_found: [PatternMatch] @= []

    for f in found
        all_found @ all_found.push(
            PatternMatch(pattern: f.pattern, start: f.start, end: f.end, text: s.slice(from: f.start, to: f.end))
        )

    return all_found

# Every match of every pattern in `s`, overlapping or not, whatever the
# patterns' kind: "abcd" holds "b", "abc" and "abcd" at once.
#
# - `s`: the text searched.
# - `patterns`: the compiled patterns; a text given twice is reported twice.
#
# The matches stand in the order of their ends, and at one end the longest
# first, the patterns of one text in the order they were given. Their number
# can be the length of `s` times the number of patterns. See also
# `search_patterns_all`.
function search_patterns_overlapping(s: str, patterns: Patterns lent) -> [PatternMatch]
    found = multi.overlapping(m: patterns.compiled, s: s)
    all_found: [PatternMatch] @= []

    for f in found
        all_found @ all_found.push(
            PatternMatch(pattern: f.pattern, start: f.start, end: f.end, text: s.slice(from: f.start, to: f.end))
        )

    return all_found

# `s` with every match of the patterns replaced, each by the replacement of
# its pattern, in one pass: what a replacement wrote is never searched again,
# so two patterns can swap two texts.
#
# - `s`: the text read.
# - `patterns`: the compiled patterns; the matches are those of
#   `search_patterns_all`.
# - `replacements`: the text written for each pattern, by its index.
#
# Aborts where `replacements` and the patterns are not as many. See also
# `replace_patterns_all_by` and `replace_pairs`.
function replace_patterns_all(s: str, patterns: Patterns lent, replacements: [str]) -> str
    assert replacements.len() == patterns.texts.len()
    parts: [str] @= []
    done: i64 @= 0

    for f in multi.one_by_one(m: patterns.compiled, s: s)
        parts @ parts.push(s.slice(from: done, to: f.start))
        parts @ parts.push(replacements[f.pattern])
        done @ f.end

    parts @ parts.push(s.slice(from: done, to: s.len()))
    return parts.join("")

# `s` with every match of the patterns replaced by what `by` answers for it,
# in one pass.
#
# - `s`: the text read.
# - `patterns`: the compiled patterns; the matches are those of
#   `search_patterns_all`.
# - `by`: asked once for each match, in the order of the text; what it
#   answers is written in the match's place and never searched again.
#
# See also `replace_patterns_all`.
function replace_patterns_all_by(s: str, patterns: Patterns lent, by: (function(PatternMatch) -> str)) -> str
    parts: [str] @= []
    done: i64 @= 0

    for f in multi.one_by_one(m: patterns.compiled, s: s)
        parts @ parts.push(s.slice(from: done, to: f.start))
        parts @ parts.push(
            by(PatternMatch(pattern: f.pattern, start: f.start, end: f.end, text: s.slice(from: f.start, to: f.end)))
        )
        done @ f.end

    parts @ parts.push(s.slice(from: done, to: s.len()))
    return parts.join("")

## Tests

test "split_once: the first separator, one at the end, a missing one, an empty one, and characters of more than one byte"
    halves = split_once(s: "key=value=more", sep: "=").must()
    assert halves.before == "key" && halves.after == "value=more"
    empty = split_once(s: "abc", sep: "").must()
    assert empty.before == "" && empty.after == "abc"
    last = split_once(s: "a;", sep: ";").must()
    assert last.before == "a" && last.after == ""
    accents = split_once(s: "città→è→à", sep: "→").must()
    assert accents.before == "città" && accents.after == "è→à"

    match split_once(s: "abc", sep: ";")
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND && e.msg == "no \";\" in \"abc\""

test "split_once_last: the last separator, an empty one, a missing one, and characters of more than one byte"
    halves = split_once_last(s: "a=b=c", sep: "=").must()
    assert halves.before == "a=b" && halves.after == "c"
    empty = split_once_last(s: "abc", sep: "").must()
    assert empty.before == "abc" && empty.after == ""
    accents = split_once_last(s: "città→è→à", sep: "→").must()
    assert accents.before == "città→è" && accents.after == "à"
    assert split_once_last(s: "abc", sep: ";").is_err()

test "search_patterns_from: a start below 0, inside a character, at the end, past it, and the message"
    p = compile_patterns(["é", "x"], .leftmost_first)
    assert search_patterns_from(s: "aéx", patterns: p, from: -5).must().start == 1
    assert search_patterns_from(s: "aéx", patterns: p, from: 2).must() == PatternMatch(pattern: 1, start: 3, end: 4, text: "x")
    assert search_patterns_from(s: "aéx", patterns: p, from: 4).is_err()

    match search_patterns_from(s: "aéx", patterns: p, from: 9)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND && e.msg == "no pattern in \"aéx\" at or after byte 9"

test "match_patterns_at: each kind at one place, nothing there, past the end, and no pattern at all"
    pats = ["a", "abc", "ab"]
    assert match_patterns_at(s: "abcd", patterns: compile_patterns(pats, .standard), at: 0).must().text == "a"
    assert match_patterns_at(s: "abcd", patterns: compile_patterns(pats, .leftmost_first), at: 0).must().text == "a"
    assert match_patterns_at(s: "abcd", patterns: compile_patterns(pats, .leftmost_longest), at: 0).must().text == "abc"
    assert match_patterns_at(s: "abcd", patterns: compile_patterns(pats, .leftmost_longest), at: 1).is_err()
    assert match_patterns_at(s: "abcd", patterns: compile_patterns(pats, .leftmost_longest), at: 5).is_err()
    assert match_patterns_at(s: "abcd", patterns: compile_patterns([], .leftmost_longest), at: 0).is_err()

test "search_patterns_all: the empty pattern beside another, a text of more than one byte, the case of ASCII letters, and no match"
    longest = search_patterns_all(s: "aèa", patterns: compile_patterns(["", "a"], .leftmost_longest))
    assert longest.len() == 2 && longest[0].end == 1 && longest[1].start == 3 && longest[1].text == "a"
    first = search_patterns_all(s: "aè", patterns: compile_patterns(["", "a"], .leftmost_first))
    assert first.len() == 3 && first[1].start == 1 && first[2].start == 3 && first[2].text == ""
    caseless = compile_patterns_ignoring_case_ascii(["Rebel", "É"], .leftmost_first)
    texts: [str] @= []

    for m in search_patterns_all(s: "REBEL rebel é É", patterns: caseless)
        texts @ texts.push(m.text)

    assert texts == ["REBEL", "rebel", "É"]
    assert search_patterns_all(s: "", patterns: caseless) == []

test "replace_patterns_all: no match, an empty text, a replacement holding a pattern, and characters of more than one byte"
    p = compile_patterns(["à", "a"], .leftmost_first)
    assert replace_patterns_all(s: "xyz", patterns: p, replacements: ["1", "2"]) == "xyz"
    assert replace_patterns_all(s: "", patterns: p, replacements: ["1", "2"]) == ""
    assert replace_patterns_all(s: "città a", patterns: p, replacements: ["a", "à"]) == "citta à"

test "has_match: the kinds alike, the empty pattern, and no pattern"
    assert has_match(s: "xabcd", patterns: compile_patterns(["abcd", "c"], .leftmost_longest))
    assert !has_match(s: "xabd", patterns: compile_patterns(["abcd", "c"], .standard))
    assert has_match(s: "", patterns: compile_patterns([""], .standard))
    assert !has_match(s: "abc", patterns: compile_patterns([], .leftmost_first))

## Examples

# A name lowered, its first sigma inside the word and its last one ending it.
test "to_lower: a Greek name, whose last sigma ends its word"
    assert to_lower("ΣΊΣΥΦΟΣ") == "σίσυφος"

# The words of a name in camel case, a run of capitals among them.
test "case_words: a name with an acronym"
    assert case_words("parseXMLDocument2") == ["parse", "XML", "Document2"]

# A field's name in Rust or Python from its name in JavaScript.
test "to_snake_case: a name in camel case"
    assert to_snake_case("userAccountID") == "user_account_id"

# A name as a command-line option writes it.
test "to_kebab_case: a name in Pascal case"
    assert to_kebab_case("MaxRetryCount") == "max-retry-count"

# A constant's name from a phrase.
test "to_screaming_snake_case: a phrase"
    assert to_screaming_snake_case("default page size") == "DEFAULT_PAGE_SIZE"

# The name of an environment variable some tools write with hyphens.
test "to_screaming_kebab_case: a name in snake case"
    assert to_screaming_kebab_case("http_proxy") == "HTTP-PROXY"

# A JSON field's name from a column's.
test "to_camel_case: a column's name"
    assert to_camel_case("created_at") == "createdAt"

# A type's name from a file's.
test "to_pascal_case: a file's name"
    assert to_pascal_case("user-profile.hero") == "UserProfileHero"

# A heading from an identifier.
test "to_title_case: an identifier"
    assert to_title_case("first_name") == "First Name"

# An HTTP header's name.
test "to_train_case: a header in lower case"
    assert to_train_case("content_type") == "Content-Type"

# The slug of an article's title.
test "to_slug: an article's title"
    assert to_slug("Hello, World: Rebel's 1st Release!") == "hello-world-rebels-1st-release"

# A command line written in a configuration file, read into its words.
test "split_shell: a command with a quoted argument"
    assert split_shell("grep -n 'two words' \"my file.txt\"").must() == ["grep", "-n", "two words", "my file.txt"]

# A Windows command line read into its arguments.
test "split_windows_args: a program in Program Files and a quoted argument"
    assert split_windows_args("\"C:\\Program Files\\app.exe\" --name \"a b\"") == ["C:\\Program Files\\app.exe", "--name", "a b"]

# An argument with a space and a quote, written for a Windows command line.
test "quote_windows_arg: a space and a quote"
    assert quote_windows_arg("say \"hi\"") == "\"say \\\"hi\\\"\""

# A command line written from a list, read back the same.
test "quote_windows_args: a program and two arguments"
    line = quote_windows_args(["C:\\Tools\\run.exe", "a b", "c"]).must()
    assert line == "C:\\Tools\\run.exe \"a b\" c"
    assert split_windows_args(line) == ["C:\\Tools\\run.exe", "a b", "c"]

# A list of words found in one pass, each with the pattern that matched.
test "compile_patterns: fruit in a sentence"
    fruit = compile_patterns(["apple", "maple", "Snapple"], .leftmost_first)
    found = search_patterns_all(s: "Nobody likes maple in their apple flavored Snapple.", patterns: fruit)
    assert found.len() == 3
    assert found[0] == PatternMatch(pattern: 1, start: 13, end: 18, text: "maple")
    assert found[2] == PatternMatch(pattern: 2, start: 43, end: 50, text: "Snapple")

# A name found in any case of its ASCII letters.
test "compile_patterns_ignoring_case_ascii: a name shouted"
    names = compile_patterns_ignoring_case_ascii(["rebel"], .standard)
    assert search_patterns(s: "REBEL yell", patterns: names).must().text == "REBEL"

# Whether a line holds any word of a list.
test "has_match: a word of a list in a line"
    banned = compile_patterns(["spam", "scam"], .standard)
    assert has_match(s: "this is no scam", patterns: banned)

# The first match, the longest of those that begin first.
test "search_patterns: the longest name at the start"
    names = compile_patterns(["Sam", "Samwise"], .leftmost_longest)
    assert search_patterns(s: "Samwise Gamgee", patterns: names).must() == PatternMatch(pattern: 1, start: 0, end: 7, text: "Samwise")

# The next match after the one already read.
test "search_patterns_from: the second marker"
    markers = compile_patterns(["TODO", "FIXME"], .leftmost_first)
    assert search_patterns_from(s: "TODO: x; FIXME: y; TODO", patterns: markers, from: 4).must() == PatternMatch(pattern: 1, start: 9, end: 14, text: "FIXME")

# The operator a lexer reads where a token begins, the longest of a list.
test "match_patterns_at: the longest operator"
    operators = compile_patterns(["=", "==", "=>", "!="], .leftmost_longest)
    assert match_patterns_at(s: "a == b", patterns: operators, at: 2).must() == PatternMatch(pattern: 1, start: 2, end: 4, text: "==")

# Every marker in a line, one after another.
test "search_patterns_all: two words of a list in a line"
    markers = compile_patterns(["TODO", "FIXME"], .leftmost_first)
    found = search_patterns_all(s: "TODO: x; FIXME: y; TODO", patterns: markers)
    assert found.len() == 3 && found[1].text == "FIXME" && found[2].start == 19

# Every pattern that ends in a text, nested ones included.
test "search_patterns_overlapping: three patterns nested"
    p = compile_patterns(["b", "abc", "abcd"], .standard)
    found = search_patterns_overlapping(s: "abcd", patterns: p)
    assert found == [PatternMatch(pattern: 0, start: 1, end: 2, text: "b"), PatternMatch(pattern: 1, start: 0, end: 3, text: "abc"), PatternMatch(pattern: 2, start: 0, end: 4, text: "abcd")]

# Two words swapped in one pass.
test "replace_patterns_all: two words swapped"
    pets = compile_patterns(["cat", "dog"], .leftmost_first)
    assert replace_patterns_all(s: "cat chases dog", patterns: pets, replacements: ["dog", "cat"]) == "dog chases cat"

# Each match written between brackets by a function.
test "replace_patterns_all_by: matches between brackets"
    markers = compile_patterns_ignoring_case_ascii(["todo", "fixme"], .leftmost_first)
    assert replace_patterns_all_by(s: "todo: x; Fixme: y", patterns: markers, by: samples.bracketed) == "[todo]: x; [Fixme]: y"

# A word looked for in a line.
test "contains: a word in a line"
    assert contains(s: "the quick brown fox", substr: "brown")
    assert !contains(s: "the quick brown fox", substr: "Brown")

# Whether a file's name holds a character a Windows path refuses.
test "contains_any: a character a Windows file name refuses"
    assert contains_any(s: "report?.txt", set: "<>:\"/\\|?*")
    assert !contains_any(s: "report.txt", set: "<>:\"/\\|?*")

# A line read as a comment where it begins with a hash.
test "has_prefix: a comment line"
    assert has_prefix(s: "# a comment", prefix: "#")

# A keyword asked at the place a reader has reached, without cutting a slice.
test "has_prefix_at: a keyword at a reader's place"
    assert has_prefix_at(s: "x = return y", prefix: "return", at: 4)
    assert !has_prefix_at(s: "x = return y", prefix: "return", at: 0)

# A file's name asked whether it ends with an extension.
test "has_suffix: an extension"
    assert has_suffix(s: "photo.jpeg", suffix: ".jpeg")

# Where a key begins in a line of settings.
test "index_of: a key in a line"
    assert index_of(s: "name=Ada; lang=en", substr: "lang").must() == 10

# The second occurrence of a word, searched for after the first.
test "index_of_from: the second occurrence"
    first = index_of(s: "to be or not to be", substr: "be").must()
    assert index_of_from(s: "to be or not to be", substr: "be", from: first + 1).must() == 16

# Where a file's extension begins: after its last dot.
test "index_of_last: the last dot of a name"
    assert index_of_last(s: "archive.tar.gz", substr: ".").must() == 11

# Where the first separator of several kinds stands.
test "index_of_any: the first separator"
    assert index_of_any(s: "a,b;c", set: ";,").must() == 1

# The next separator after the first.
test "index_of_any_from: the separator after the first"
    assert index_of_any_from(s: "a,b;c", set: ";,", from: 2).must() == 3

# The last separator of a path written with either slash.
test "index_of_any_last: the last slash of either kind"
    assert index_of_any_last(s: "C:\\dir/sub\\file", set: "/\\").must() == 10

# Where the first digit of a version stands.
test "index_where: the first digit"
    assert index_where(s: "version 2.1", accepts: unicode.is_digit).must() == 8

# The first digit after a place.
test "index_where_from: a digit after a place"
    assert index_where_from(s: "a1 b2", accepts: unicode.is_digit, from: 2).must() == 4

# Where the last digit of a name stands.
test "index_where_last: the last digit"
    assert index_where_last(s: "file12.txt", accepts: unicode.is_digit).must() == 5

# How many times a word stands in a sentence.
test "count_of: a word in a sentence"
    assert count_of(s: "to be or not to be", substr: "be") == 2

# Every place a word begins in a sentence.
test "index_of_all: every occurrence of a word"
    assert index_of_all(s: "to be or not to be", substr: "be") == [3, 16]

# Two names ordered by their bytes, as the built-in `sort` orders them.
test "compare: two names"
    assert compare(a: "apple", b: "banana") == -1
    assert compare(a: "pear", b: "pear") == 0

# Two spellings of a name compared without their case, "ß" folding to "ss".
test "equals_ignoring_case: a German street"
    assert equals_ignoring_case(a: "Straße", b: "STRASSE")

# An HTTP header's name compared as the protocol compares it.
test "equals_ignoring_case_ascii: a header's name"
    assert equals_ignoring_case_ascii(a: "Content-Type", b: "content-type")

# A setting cut at its first equals sign.
test "split_once: a key and its value"
    halves = split_once(s: "url=https://example.com/?a=1", sep: "=").must()
    assert halves.before == "url" && halves.after == "https://example.com/?a=1"

# A file's name cut at its last dot.
test "split_once_last: a name and its extension"
    halves = split_once_last(s: "archive.tar.gz", sep: ".").must()
    assert halves.before == "archive.tar" && halves.after == "gz"

# A line of comma-separated values cut into its fields, an empty one kept.
test "split: comma-separated fields"
    assert split(s: "a,b,,c", sep: ",") == ["a", "b", "", "c"]

# A line cut into a command and the rest of it.
test "split_n: a command and its arguments"
    assert split_n(s: "set name Ada Lovelace", sep: " ", n: 3) == ["set", "name", "Ada Lovelace"]

# A name cut at its last dot only.
test "split_n_last: a module's path and its name"
    assert split_n_last(s: "a.b.c", sep: ".", n: 2) == ["a.b", "c"]

# Lines read with their ends, so that joining them gives the text again.
test "split_after: lines with their ends"
    assert split_after(s: "one\ntwo\nthree", sep: "\n") == ["one\n", "two\n", "three"]

# The first line cut off with its end, the rest left whole.
test "split_after_n: the first line and the rest"
    assert split_after_n(s: "one\ntwo\nthree", sep: "\n", n: 2) == ["one\n", "two\nthree"]

# Statements each ended by a semicolon, the last one too.
test "split_terminated: statements ended by semicolons"
    assert split_terminated(s: "a;b;", sep: ";") == ["a", "b"]

# Fields separated by either a comma or a semicolon.
test "split_any: two separators"
    assert split_any(s: "a,b;c", set: ",;") == ["a", "b", "c"]

# A text cut at its punctuation.
test "split_where: cut at punctuation"
    assert split_where(s: "a.b,c", separates: unicode.is_punctuation) == ["a", "b", "c"]

# The words of a line, however many spaces stand between them.
test "words: a line with runs of spaces"
    assert words("  the quick\tbrown  ") == ["the", "quick", "brown"]

# The words of a list whose separators are runs of punctuation.
test "words_where: words between punctuation"
    assert words_where(s: "a, b,,c", separates: unicode.is_punctuation) == ["a", " b", "c"]

# A command and the rest of its line, as Python's `split(maxsplit=1)` reads
# them.
test "words_n: a command and the rest"
    assert words_n(s: "  say hello  world ", n: 2) == ["say", "hello  world "]

# The last word of a line and what stands before it.
test "words_n_last: the last word and the rest"
    assert words_n_last(s: "a b  c", n: 2) == ["a b", "c"]

# The lines of a file written with Windows' ends.
test "lines: lines ended by carriage returns and line feeds"
    assert lines("one\r\ntwo\r\n") == ["one", "two"]

# A field read from a form, its spaces taken off.
test "trim: a field with spaces around it"
    assert trim("  Ada Lovelace \n") == "Ada Lovelace"

# A line's indentation taken off.
test "trim_start: indentation"
    assert trim_start("    return x") == "return x"

# The spaces at a line's end taken off.
test "trim_end: spaces at the end"
    assert trim_end("text   \n") == "text"

# The quotes around a word taken off.
test "trim_any: quotes around a word"
    assert trim_any(s: "\"'word'\"", set: "\"'") == "word"

# The zeros before a number taken off.
test "trim_start_any: zeros before a number"
    assert trim_start_any(s: "000120", set: "0") == "120"

# The slashes at a path's end taken off.
test "trim_end_any: slashes at the end"
    assert trim_end_any(s: "/srv/www///", set: "/") == "/srv/www"

# The punctuation around a word taken off.
test "trim_where: punctuation around a word"
    assert trim_where(s: "...hello!?", accepts: unicode.is_punctuation) == "hello"

# The digits before a name taken off.
test "trim_start_where: digits before a name"
    assert trim_start_where(s: "42abc", accepts: unicode.is_digit) == "abc"

# The digits after a name taken off.
test "trim_end_where: digits after a name"
    assert trim_end_where(s: "file123", accepts: unicode.is_digit) == "file"

# A scheme taken off a URL, once.
test "trim_prefix: a URL's scheme"
    assert trim_prefix(s: "https://example.com", prefix: "https://") == "example.com"

# An extension taken off a file's name.
test "trim_suffix: an extension"
    assert trim_suffix(s: "notes.txt", suffix: ".txt") == "notes"

# Every "../" at a path's start taken off.
test "trim_prefix_all: steps up a tree"
    assert trim_prefix_all(s: "../../lib", prefix: "../") == "lib"

# Every exclamation mark at a sentence's end taken off.
test "trim_suffix_all: marks at the end"
    assert trim_suffix_all(s: "Wow!!!", suffix: "!") == "Wow"

# What follows a command's name, only where the line names it.
test "after_prefix: a command's argument"
    assert after_prefix(s: "say hello", prefix: "say ").must() == "hello"
    assert after_prefix(s: "ask hello", prefix: "say ").is_err()

# A file's name without its extension, only where it has that one.
test "before_suffix: a name without its extension"
    assert before_suffix(s: "report.pdf", suffix: ".pdf").must() == "report"

# A word read between its brackets.
test "between: a word between brackets"
    assert between(s: "[note]", prefix: "[", suffix: "]").must() == "note"

# Every comma written as a semicolon.
test "replace_all: every separator"
    assert replace_all(s: "a,b,c", old: ",", new: ";") == "a;b;c"

# The first two commas replaced, the rest kept.
test "replace_n: the first two separators"
    assert replace_n(s: "a,b,c,d", old: ",", new: ";", n: 2) == "a;b;c,d"

# The last comma of a list written as "and".
test "replace_last: the last comma"
    assert replace_last(s: "red, green, blue", old: ", ", new: " and ") == "red, green and blue"

# Two characters escaped for HTML in one pass.
test "replace_pairs: two characters escaped"
    assert replace_pairs(s: "a < b & c", pairs: {"<": "&lt;", "&": "&amp;"}) == "a &lt; b &amp; c"

# A number written to the right of a column.
test "pad_start: a column of numbers"
    assert pad_start(s: "42", width: 6, pad: " ") == "    42"

# A label filled with dots to the width of a menu.
test "pad_end: a menu's leaders"
    assert pad_end(s: "Soup", width: 10, pad: ".") == "Soup......"

# A title centred in a banner.
test "center: a banner"
    assert center(s: "menu", width: 10, pad: "*") == "***menu***"

# A number written with zeros before it, after its sign.
test "pad_zeros: a negative number"
    assert pad_zeros(s: "-42", width: 6) == "-00042"

# Tabs written as the spaces that reach the next stop of four.
test "expand_tabs: stops every four characters"
    assert expand_tabs(s: "a\tbc\td", tab_width: 4) == "a   bc  d"

# A text in upper case, its sharp s written as two letters.
test "to_upper: a German word"
    assert to_upper("straße") == "STRASSE"

# A sentence with its words in title case.
test "to_title: a heading"
    assert to_title("the old man and the sea") == "The Old Man And The Sea"

# A sentence with its first letter in capital.
test "capitalize: a sentence"
    assert capitalize("hELLO wORLD") == "Hello world"

# A name with its case swapped.
test "swap_case: a mixed name"
    assert swap_case("Hello World") == "hELLO wORLD"

# Two spellings of a word folded alike for comparing.
test "to_casefold: a German word in two spellings"
    assert to_casefold("Straße") == to_casefold("STRASSE")

# A protocol's keyword lowered, its other characters untouched.
test "to_lower_ascii: a keyword and a letter outside ASCII"
    assert to_lower_ascii("SELECT É") == "select É"

# A protocol's keyword raised, its other characters untouched.
test "to_upper_ascii: a keyword and a letter outside ASCII"
    assert to_upper_ascii("get é") == "GET é"

# A text asked whether its letters are in lower case, digits passed over.
test "is_lower: a name with a number"
    assert is_lower("ada99") && !is_lower("Ada99")

# A text asked whether its letters are in upper case.
test "is_upper: an acronym"
    assert is_upper("NASA") && !is_upper("NaSA")

# A heading asked whether it is in title case.
test "is_title: a heading"
    assert is_title("The Old Man") && !is_title("The old man")

# A text asked whether it is ASCII.
test "is_ascii: plain and accented"
    assert is_ascii("hello") && !is_ascii("héllo")

# The bytes of a text, its UTF-8.
test "to_bytes: a letter of two bytes"
    assert to_bytes("é") == [0xc3, 0xa9]

# A byte index asked whether a slice may cut there.
test "is_boundary: inside a letter of two bytes"
    assert is_boundary(s: "héllo", at: 1) && !is_boundary(s: "héllo", at: 2)

# A text cut to at most three bytes without splitting a character.
test "floor_boundary: a cut that would split a letter"
    s = "naïve"
    assert s.slice(from: 0, to: floor_boundary(s: s, at: 3)) == "na"

# The first place at or after a byte where a slice may begin.
test "ceil_boundary: a place inside a letter"
    assert ceil_boundary(s: "naïve", at: 3) == 4

# A part of a text cut at indices read from outside, a wrong one refused.
test "slice_checked: indices from a request"
    assert slice_checked(s: "hello world", from: 6, to: 11).must() == "world"
    assert slice_checked(s: "hello", from: 2, to: 9).is_err()
