## Tests

test "property_table: RUNS ascends from 0, every field within its codes"
    at: i64 @= 1

    while at < RUNS.len()
        assert RUNS[at - 1] >> 18 < RUNS[at] >> 18
        assert RUNS[at] >> 11 & 15 <= 11
        assert RUNS[at] >> 8 & 7 <= 4
        at @ at + 1

    assert RUNS[0] >> 18 == 0
    assert RUNS.len() == 1716
