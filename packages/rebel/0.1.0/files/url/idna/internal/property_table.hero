## Tests

test "property_table: RUNS ascends from 0, every field within its codes"
    at: i64 @= 1

    while at < RUNS.len()
        assert RUNS[at - 1] >> 21 < RUNS[at] >> 21
        assert RUNS[at] >> 14 & 15 <= 11
        assert RUNS[at] >> 11 & 7 <= 4
        assert RUNS[at] >> 8 & 7 <= 2
        at @ at + 1

    assert RUNS[0] >> 21 == 0
    assert RUNS.len() == 1904
