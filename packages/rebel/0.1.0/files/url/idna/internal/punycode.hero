# Punycode, RFC 3492: a sequence of code points written in the letters,
# digits and hyphen a host name may hold, and read back. Written from the
# RFC's prose (§§ 5, 6.1 to 6.3) with its parameters for IDNA (§ 5). The
# arithmetic is checked before each step, so a number that would pass the
# largest `i64` is `invalid` and nothing wraps.

constant INVALID: str
    "invalid"

# The parameters of RFC 3492 § 5, for IDNA.
constant BASE: i64
    36

constant T_MIN: i64
    1

constant T_MAX: i64
    26

constant SKEW: i64
    38

constant DAMP: i64
    700

constant INITIAL_BIAS: i64
    72

constant INITIAL_N: i64
    128

# The largest `i64`, which the decoder's numbers may not pass.
constant MOST: i64
    0x7fffffffffffffff

# The largest code point, U+10FFFF.
constant MAX_CODE_POINT: i64
    0x10ffff

# The bias after a delta, RFC 3492 § 6.1: `delta` the delta just written or
# read, `points` how many code points the output holds now, `first` whether it
# was the first delta.
function adapted(delta: i64, points: i64, first: bool) -> i64
    d: i64 @= if first
        delta / DAMP
    else
        delta / 2
    d @ d + d / points
    k: i64 @= 0

    while d > (BASE - T_MIN) * T_MAX / 2
        d @ d / (BASE - T_MIN)
        k @ k + BASE

    return k + (BASE - T_MIN + 1) * d / (d + SKEW)

# The threshold of the digit at position `k` under `bias`, RFC 3492 § 6.1's
# `t`: from `T_MIN` to `T_MAX`.
function threshold(k: i64, bias: i64) -> i64
    if k <= bias
        return T_MIN

    if k >= bias + T_MAX
        return T_MAX
    return k - bias

# The byte that writes the digit `d`, 0 to 35: "a" to "z", then "0" to "9".
function digit_byte(d: i64) -> u8
    if d < 26
        return ('a' + d).to_u8().must()
    return ('0' + d - 26).to_u8().must()

# The value of the digit `b` writes, 0 to 35, either case of a letter read
# alike; -1 where `b` writes no digit.
function digit_value(b: u8) -> i64
    if b >= 'a' && b <= 'z'
        return b.to_i64().must() - 'a'

    if b >= 'A' && b <= 'Z'
        return b.to_i64().must() - 'A'

    if b >= '0' && b <= '9'
        return b.to_i64().must() - '0' + 26
    return -1

# Writes the generalized variable-length integer `q` under `bias` from the
# position `k` on, RFC 3492 § 6.3's inner loop, into `out`.
function add_number(@out: [u8], q: i64, bias: i64)
    rest: i64 @= q
    k: i64 @= BASE

    while true
        t = threshold(k: k, bias: bias)

        if rest < t
            break
        out @ out.push(digit_byte(t + (rest - t) % (BASE - t)))
        rest @ (rest - t) / (BASE - t)
        k @ k + BASE

    out @ out.push(digit_byte(rest))

## Counting by place

# A Fenwick tree over `size` places, every count 0: entry 0 unused, entry `j`
# the sum of the counts of the places from `j - (j & -j)` up to `j`.
function counts_of(size: i64) -> [i64]
    tree: [i64] @= []
    at: i64 @= 0

    while at <= size
        tree @ tree.push(0)
        at @ at + 1

    return tree

# A Fenwick tree over `size` places, every count 1.
function ones_of(size: i64) -> [i64]
    tree: [i64] @= [0]
    at: i64 @= 1

    while at <= size
        tree @ tree.push(at & -at)
        at @ at + 1

    return tree

# Adds `value` to the count of the place `place`, from 0, of `tree`.
function add_count(@tree: [i64], place: i64, value: i64)
    at: i64 @= place + 1

    while at < tree.len()
        tree[at] @ tree[at] + value
        at @ at + (at & -at)

# The sum of the counts of the first `places` places of `tree`.
function sum_before(tree: [i64] lent, places: i64) -> i64
    total: i64 @= 0
    at: i64 @= places

    while at > 0
        total @ total + tree[at]
        at @ at - (at & -at)

    return total

# The place, from 0, of the one numbered `rank`, from 0, among the counts of
# `tree`, each 0 or 1: where they first add up to `rank` plus 1. `tree` holds
# more than `rank` ones.
function place_of_one(tree: [i64] lent, rank: i64) -> i64
    step: i64 @= 1

    while step * 2 < tree.len()
        step @ step * 2

    place: i64 @= 0
    remaining: i64 @= rank + 1

    while step > 0
        next = place + step

        if next < tree.len() && tree[next] < remaining
            place @ next
            remaining @ remaining - tree[next]
        step @ step / 2

    return place

## Encoding and decoding

# The Punycode of `points`, RFC 3492 § 6.3: the basic code points, those
# below 128, as they are and then a "-" where there is one, then the others
# as digits. Every entry of `points` is a scalar value. The code points above
# ASCII are taken in order of value, and how many smaller ones stand before
# each is counted by a Fenwick tree, so the cost grows with n log n of the
# code points, where the RFC's own loop reads them all once for each
# different one. No number passes an `i64` for fewer than 2^40 code points,
# more than a program's memory holds.
function encode(points: [i64] lent) -> str
    out: [u8] @= []
    tree: [i64] @= counts_of(points.len())
    pairs: [i64] @= []
    place: i64 @= 0

    for p in points
        if p < 0x80
            out @ out.push(p.to_u8().must())
            add_count(@tree, place: place, value: 1)
        else
            pairs @ pairs.push(p << 40 | place)
        place @ place + 1

    basic = out.len()
    handled: i64 @= basic

    if basic > 0
        out @ out.push('-')
    order = sort(pairs)
    n: i64 @= INITIAL_N
    delta: i64 @= 0
    bias: i64 @= INITIAL_BIAS
    next: i64 @= 0

    while next < order.len()
        m = order[next] >> 40
        delta @ delta + (m - n) * (handled + 1)
        n @ m
        group_end: i64 @= next

        while group_end < order.len() && order[group_end] >> 40 == m
            group_end @ group_end + 1

        after: i64 @= 0
        at: i64 @= next

        while at < group_end
            position = order[at] & 0xffffffffff
            delta @ delta + sum_before(tree, places: position) - sum_before(tree, places: after)
            add_number(@out, q: delta, bias: bias)
            bias @ adapted(delta: delta, points: handled + 1, first: handled == basic)
            delta @ 0
            handled @ handled + 1
            after @ position + 1
            at @ at + 1

        delta @ delta + sum_before(tree, places: points.len()) - sum_before(tree, places: after)
        at @ next

        while at < group_end
            add_count(@tree, place: order[at] & 0xffffffffff, value: 1)
            at @ at + 1

        delta @ delta + 1
        n @ n + 1
        next @ group_end

    return out.validated_bytes().must()

# The code points the Punycode `s` writes, RFC 3492 § 6.2. The basic code
# points before the last "-" are kept as they are, case and all; a "-" at the
# start has no code point before it and is read as a digit, so it fails, as
# the RFC reads it. Digits are read in either case. Fails `invalid` where `s`
# holds a byte above ASCII before its last "-", a byte that is no digit after
# it, a number cut short at the end, a number past the largest `i64`, or a
# code point that is no scalar value; the message names the byte's place.
# Each code point's place at its insertion is kept, and the places are
# settled last to first by a Fenwick tree of the free places, so the cost
# grows with n log n of the code points, where inserting each in a list
# would grow with their square.
function decode(s: str) -> [i64]?
    last: i64 @= s.len() - 1

    while last >= 0 && s[last] != '-'
        last @ last - 1

    values: [i64] @= []
    places: [i64] @= []
    at: i64 @= 0

    if last > 0
        while at < last
            if s[at] >= 0x80
                return fail(code: INVALID, msg: f"Punycode holds a byte above ASCII at {at}, before its last \"-\"")
            values @ values.push(s[at].to_i64().must())
            places @ places.push(at)
            at @ at + 1

        at @ last + 1
    n: i64 @= INITIAL_N
    i: i64 @= 0
    bias: i64 @= INITIAL_BIAS

    while at < s.len()
        old = i
        w: i64 @= 1
        k: i64 @= BASE

        while true
            if at >= s.len()
                return fail(code: INVALID, msg: f"Punycode ends inside a number, at {at}")
            digit = digit_value(s[at])

            if digit < 0
                return fail(code: INVALID, msg: f"Punycode holds a byte that is no digit, {shown_at(s, at)}, at {at}")

            if digit > (MOST - i) / w
                return fail(code: INVALID, msg: f"Punycode writes a number past the largest i64 at {at}")
            i @ i + digit * w
            at @ at + 1
            t = threshold(k: k, bias: bias)

            if digit < t
                break

            if w > MOST / (BASE - t)
                return fail(code: INVALID, msg: f"Punycode writes a number past the largest i64 at {at}")
            w @ w * (BASE - t)
            k @ k + BASE

        count = values.len() + 1
        bias @ adapted(delta: i - old, points: count, first: old == 0)

        if i / count > MOST - n
            return fail(code: INVALID, msg: f"Punycode writes a code point past the largest i64 before {at}")
        n @ n + i / count
        i @ i % count

        if n > MAX_CODE_POINT || n >= 0xd800 && n <= 0xdfff
            return fail(code: INVALID, msg: f"Punycode writes {n}, which is no scalar value, before {at}")
        values @ values.push(n)
        places @ places.push(i)
        i @ i + 1

    return ok(settled(values: values, places: places))

# The list `values` make when each is inserted, in order, at the place of
# `places` beside it, counted among those inserted before it: the last one
# takes the free place of its rank, then the one before it, so each lands
# where the later ones leave it.
function settled(values: [i64] lent, places: [i64] lent) -> [i64]
    tree: [i64] @= ones_of(values.len())
    out: [i64] @= []

    for _ in values
        out @ out.push(0)

    at: i64 @= values.len() - 1

    while at >= 0
        place = place_of_one(tree, rank: places[at])
        out[place] @ values[at]
        add_count(@tree, place: place, value: -1)
        at @ at - 1

    return out

# The byte at `at` of `s` as a message shows it: a printable ASCII character
# quoted, `'`, `"` and `\` behind a `\` as `bytes.format_escaped` writes
# them, and any other byte as its number, this package using no other
# (defect 2598).
function shown_at(s: str, at: i64) -> str
    if s[at] < 32 || s[at] > 126
        return f"byte {s[at]}"
    c = s.slice(from: at, to: at + 1)

    if c == "'" || c == "\"" || c == "\\"
        return "'\\" + c + "'"
    return "'" + c + "'"

## Tests

test "encode: nothing, basic code points alone, a hyphen, one code point above ASCII, the largest, and around the surrogates"
    assert encode([]) == ""
    assert encode([0x61]) == "a-"
    assert encode([0x61, 0x2d]) == "a--"
    assert encode([0x2d]) == "--"
    assert encode([0x30]) == "0-"
    assert encode([0xfc]) == "tda"
    assert encode([0x10ffff]) == "dn32g"
    assert encode([0xd7ff]) == "hb9b"
    assert encode([0xe000]) == "0y0c"
    assert encode([0x62, 0xfc, 0x63, 0x68, 0x65, 0x72]) == "bcher-kva"

test "decode: nothing, basic code points alone, a hyphen at the start read as a digit, either case, and a last hyphen inside the basic part"
    assert decode("").must() == []
    assert decode("a-").must() == [0x61]
    assert decode("abc-").must() == [0x61, 0x62, 0x63]
    assert decode("tda").must() == [0xfc]
    assert decode("TDA").must() == [0xfc]
    assert decode("bcher-kva").must() == [0x62, 0xfc, 0x63, 0x68, 0x65, 0x72]
    assert decode("Bcher-KVA").must() == [0x42, 0xfc, 0x63, 0x68, 0x65, 0x72]
    assert decode("abc").must() == [0x82, 0x81, 0x80]
    assert decode("dn32g").must() == [0x10ffff]
    assert decode("-a").is_err()
    assert decode("-").is_err()
    assert decode("---").must() == [0x2d, 0x2d]

test "decode: a byte above ASCII before the hyphen, a byte that is no digit, a number cut short, past the largest i64, past U+10FFFF, and a surrogate"
    assert decode("é-a").is_err()
    assert decode("a-!").is_err()
    assert decode("9").is_err()
    assert decode("zzzzzzzzz").is_err()
    assert decode("99999999999999999999999999").is_err()
    assert decode("99999a").is_err()
    assert decode("ib9b").is_err()
    assert decode("a-rc4g").is_err()

    match decode("99999999999999999999999999")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "Punycode writes a number past the largest i64 at 17"

