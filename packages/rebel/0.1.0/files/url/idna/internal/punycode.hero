test "encode and decode: a character above ASCII repeated, alone, among basic ones, before a long run of them, and the largest code point twice"
    a = [0xfc, 0x61, 0xfc, 0x62, 0xf6, 0xfc, 0xdf, 0xfc]
    assert encode(a) == "ab-hia5g1abcb" && decode("ab-hia5g1abcb").must() == a
    assert encode([0xe4, 0xe4, 0xe4, 0xe4]) == "4caaaa" && decode("4caaaa").must() == [0xe4, 0xe4, 0xe4, 0xe4]
    b = [0x61, 0xe4, 0x62, 0xe4, 0x63, 0xe4]
    assert encode(b) == "abc-qlabb" && decode("abc-qlabb").must() == b
    run: [i64] @= [0xe4]

    while run.len() < 123
        run @ run.push(0x61)

    assert encode(run) == repeat("a", 122) + "-pbk" && decode(repeat("a", 122) + "-pbk").must() == run
    c = [0x10ffff, 0x10000, 0x80, 0x10ffff, 0x80]
    assert encode(c) == "aa6337qe6r5kca" && decode("aa6337qe6r5kca").must() == c

test "encode and decode: 30,000 code points of 20,000 different values, and 30,000 with a basic one in three, as Python's codec writes them"
    many: [i64] @= []
    mixed: [i64] @= []
    j: i64 @= 0

    while j < 30000
        many @ many.push(0x4e00 + j * 7919 % 20000)

        if j % 3 == 0
            mixed @ mixed.push(0x61)
        else
            mixed @ mixed.push(0x100 + j * 31 % 5000)
        j @ j + 1

    text = encode(many)
    assert text.len() == 88444
    assert text.slice(from: 0, to: 40) == "4gqacdefgfcgdheinopqrnfogphqir0a1a2a3a4a"
    assert text.slice(from: text.len() - 40, to: text.len()) == "ggzvspztwyuwyvwywwyl1rm7gmzvn7gnzvo7gozv"
    assert decode(text).must() == many
    other = encode(mixed)
    assert other.len() == 70003
    assert other.slice(from: 0, to: 40) == repeat("a", 40)
    assert other.slice(from: other.len() - 40, to: other.len()) == "eu6ln3i28ev6l24euse3qgw6l34epxkypk34ey6l"
    assert decode(other).must() == mixed

test "counts_of, ones_of, add_count and sum_before: none, one place, and sums across the tree"
    assert counts_of(0) == [0]
    assert sum_before(ones_of(0), places: 0) == 0
    tree: [i64] @= counts_of(10)
    add_count(@tree, place: 0, value: 1)
    add_count(@tree, place: 9, value: 1)
    add_count(@tree, place: 4, value: 2)
    assert sum_before(tree, places: 0) == 0
    assert sum_before(tree, places: 1) == 1
    assert sum_before(tree, places: 5) == 3
    assert sum_before(tree, places: 10) == 4
    assert sum_before(ones_of(7), places: 7) == 7

test "place_of_one and settled: the first and the last one, after places are taken, and insertions at the start, inside and at the end"
    tree: [i64] @= ones_of(5)
    assert place_of_one(tree, rank: 0) == 0
    assert place_of_one(tree, rank: 4) == 4
    add_count(@tree, place: 0, value: -1)
    add_count(@tree, place: 2, value: -1)
    assert place_of_one(tree, rank: 0) == 1
    assert place_of_one(tree, rank: 1) == 3
    assert settled(values: [], places: []) == []
    assert settled(values: [1, 2, 3], places: [0, 1, 2]) == [1, 2, 3]
    assert settled(values: [1, 2, 3], places: [0, 0, 0]) == [3, 2, 1]
    assert settled(values: [1, 2, 3, 9], places: [0, 1, 2, 1]) == [1, 9, 2, 3]

test "decode: a byte that is no digit, told as the character it is (defect 2598)"
    match decode("ab-c!")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "Punycode holds a byte that is no digit, '!', at 4"

    assert shown_at("a'\u{7f}", 1) == "'\\''"
    assert shown_at("a'\u{7f}", 2) == "byte 127"
