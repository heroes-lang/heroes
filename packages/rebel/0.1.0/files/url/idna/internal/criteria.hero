# UTS #46's validity criteria for one label (§ 4.1, Unicode 17.0.0), RFC
# 5892's ContextJ rules and RFC 5893's bidi rule, and UAX #15's quick check
# for NFC, which stands in for the normalization that waits for
# `unicode/normalize`: a text it answers yes is in NFC already, a label it
# answers no is not, and where it answers maybe the caller says so rather
# than guess. Written from UTS #46's and the RFCs' text.

use unicode
use url/idna/internal/lookup
use url/idna/internal/written

# UTS #46's flags, as the face's `Options` gives them.
record Checks
    # CheckHyphens: no "--" at the third and fourth characters, no "-" at
    # either end.
    hyphens: bool
    # CheckBidi: RFC 5893's six rules in a domain that holds a character
    # written right to left.
    bidi: bool
    # CheckJoiners: RFC 5892's ContextJ rules for U+200C and U+200D.
    joiners: bool
    # UseSTD3ASCIIRules: an ASCII character is a lowercase letter, a digit or
    # "-".
    std3: bool
    # Transitional_Processing: the deviations mapped.
    transitional: bool
    # VerifyDnsLength: ToASCII's lengths checked.
    dns_length: bool
    # IgnoreInvalidPunycode: a label whose Punycode does not decode is kept
    # as written, with no fault.
    ignore_invalid_punycode: bool

# What `verdict` finds of one label: a fault, "" where none, and whether the
# label's normalization to NFC could not be settled.
record Verdict
    # The fault, said in words, "" where the label meets every criterion.
    fault: str
    # Whether the quick check answered maybe.
    undecided: bool

## The quick check

# UAX #15's quick check of `points` for NFC: `lookup.QUICK_YES` where they are
# in NFC, `lookup.QUICK_NO` where they are not, `lookup.QUICK_MAYBE` where the
# check cannot tell.
function quick_check(points: [i64] lent) -> i64
    last: i64 @= 0
    answer: i64 @= lookup.QUICK_YES

    for p in points
        combining = lookup.combining_of(p)

        if combining != 0 && last > combining
            return lookup.QUICK_NO
        quick = lookup.quick_of(p)

        if quick == lookup.QUICK_NO
            return lookup.QUICK_NO

        if quick == lookup.QUICK_MAYBE
            answer @ lookup.QUICK_MAYBE
        last @ combining

    return answer

## The validity criteria

# Whether `label` begins with "xn--".
function is_ace(label: [i64] lent) -> bool
    return label.len() >= 4 && label[0] == 'x' && label[1] == 'n' && label[2] == '-' && label[3] == '-'

# The fault of the status of `p` in a label, "" where it may stand there:
# valid, or a deviation where `transitional` is false; and under `std3`, an
# ASCII character that is a lowercase letter, a digit or "-".
function status_fault(p: i64, checks: Checks lent, transitional: bool) -> str
    status = lookup.status_of(p)

    if !(status == lookup.VALID || status == lookup.DEVIATION && !transitional)
        name = if status == lookup.IGNORED
            "ignored"
        else if status == lookup.MAPPED
            "mapped"
        else if status == lookup.DEVIATION
            "a deviation, which transitional processing maps"
        else
            "disallowed"
        return f"holds {written.code_name(p)}, whose status is {name} (V7)"

    if checks.std3 && p < 0x80 && !(p >= 'a' && p <= 'z' || p >= '0' && p <= '9' || p == '-')
        return f"holds {written.code_name(p)}, which UseSTD3ASCIIRules refuses (U1)"
    return ""

# The fault of U+200C or U+200D at `at` of `label` by RFC 5892's ContextJ
# rules, "" where the rules allow it: after a virama; or U+200C between a
# character joining to the right and one joining to the left, characters
# joining through allowed between.
function joiner_fault(label: [i64] lent, at: i64) -> str
    after_virama = at > 0 && lookup.combining_of(label[at - 1]) == lookup.VIRAMA

    if label[at] == 0x200d
        if after_virama
            return ""
        return "holds U+200D, a zero width joiner, after no virama (C2)"

    if after_virama
        return ""
    back: i64 @= at - 1

    while back >= 0 && lookup.joining_of(label[back]) == lookup.JOINS_THROUGH
        back @ back - 1

    before = back >= 0 && (lookup.joining_of(label[back]) == lookup.JOINS_LEFT || lookup.joining_of(label[back]) == lookup.JOINS_DUAL)
    ahead: i64 @= at + 1

    while ahead < label.len() && lookup.joining_of(label[ahead]) == lookup.JOINS_THROUGH
        ahead @ ahead + 1

    following = ahead < label.len() && (lookup.joining_of(label[ahead]) == lookup.JOINS_RIGHT || lookup.joining_of(label[ahead]) == lookup.JOINS_DUAL)

    if before && following
        return ""
    return "holds U+200C, a zero width non-joiner, neither after a virama nor between letters that join (C1)"

# What UTS #46's validity criteria (§ 4.1) find of `label`, not empty: in
# NFC, its hyphens, no "xn--" where hyphens go unchecked, no ".", no mark
# first, every status allowed, and the joiners' context.
function verdict(label: [i64] lent, checks: Checks lent, transitional: bool) -> Verdict
    quick = quick_check(label)

    if quick == lookup.QUICK_NO
        return Verdict(fault: "is not in NFC (V1)", undecided: false)

    if checks.hyphens
        if label.len() >= 4 && label[2] == '-' && label[3] == '-'
            return Verdict(fault: "holds \"--\" at its third and fourth characters (V2)", undecided: false)

        if label[0] == '-' || label[label.len() - 1] == '-'
            return Verdict(fault: "begins or ends with \"-\" (V3)", undecided: false)
    else if is_ace(label)
        return Verdict(fault: "begins with \"xn--\" (V4)", undecided: false)

    for p in label
        if p == '.'
            return Verdict(fault: "holds \".\" (V5)", undecided: false)

    if unicode.is_mark(unicode.from_code_point(label[0]).must())
        return Verdict(fault: f"begins with {written.code_name(label[0])}, a combining mark (V6)", undecided: false)

    for p in label
        fault = status_fault(p, checks: checks, transitional: transitional)

        if fault != ""
            return Verdict(fault: fault, undecided: false)

    if checks.joiners
        at: i64 @= 0

        while at < label.len()
            if label[at] == 0x200c || label[at] == 0x200d
                fault = joiner_fault(label, at: at)

                if fault != ""
                    return Verdict(fault: fault, undecided: false)
            at @ at + 1

    return Verdict(fault: "", undecided: quick == lookup.QUICK_MAYBE)

## The bidi rule

# Whether `labels` make a Bidi domain name: one of their characters is of
# the class R, AL or AN.
function is_bidi_domain(labels: [[i64]] lent) -> bool
    for label in labels
        for p in label
            bidi = lookup.bidi_of(p)

            if bidi == lookup.R || bidi == lookup.AL || bidi == lookup.AN
                return true

    return false

# Whether the class `bidi` is one of `allowed`.
function is_one_of(bidi: i64, allowed: [i64] lent) -> bool
    for a in allowed
        if a == bidi
            return true

    return false

# The fault RFC 5893's rules (§ 2) find of `label`, "" where it meets all six:
# a label right to left begins with R or AL, holds only the classes the rule
# allows it, ends with R, AL, EN or AN before its marks, and never holds both
# EN and AN; a label left to right begins with L, holds only its classes, and
# ends with L or EN before its marks. An empty label meets them.
function bidi_fault(label: [i64] lent) -> str
    if label.len() == 0
        return ""
    first = lookup.bidi_of(label[0])

    if first != lookup.L && first != lookup.R && first != lookup.AL
        return "begins with a character that is neither left to right nor right to left (B1)"
    end: i64 @= label.len()

    while end > 0 && lookup.bidi_of(label[end - 1]) == lookup.NSM
        end @ end - 1

    last = if end > 0
        lookup.bidi_of(label[end - 1])
    else
        lookup.NSM

    if first == lookup.L
        allowed = [lookup.L, lookup.EN, lookup.ES, lookup.CS, lookup.ET, lookup.ON, lookup.BN, lookup.NSM]

        for p in label
            if !is_one_of(lookup.bidi_of(p), allowed: allowed)
                return f"is left to right and holds {written.code_name(p)}, of a class it may not hold (B5)"

        if last != lookup.L && last != lookup.EN
            return "is left to right and does not end with a letter left to right or a digit (B6)"
        return ""
    allowed = [
        lookup.R
        lookup.AL
        lookup.AN
        lookup.EN
        lookup.ES
        lookup.CS
        lookup.ET
        lookup.ON
        lookup.BN
        lookup.NSM
    ]
    european: bool @= false
    arabic: bool @= false

    for p in label
        bidi = lookup.bidi_of(p)

        if !is_one_of(bidi, allowed: allowed)
            return f"is right to left and holds {written.code_name(p)}, of a class it may not hold (B2)"

        if bidi == lookup.EN
            european @ true

        if bidi == lookup.AN
            arabic @ true

    if last != lookup.R && last != lookup.AL && last != lookup.EN && last != lookup.AN
        return "is right to left and does not end with a letter right to left or a digit (B3)"

    if european && arabic
        return "is right to left and holds both European and Arabic-Indic digits (B4)"
    return ""

## Tests

# Every check on, nontransitional, as UTS #46's test file runs ToASCII.
function strict() -> Checks
    return Checks(
        hyphens: true,
        bidi: true,
        joiners: true,
        std3: true,
        transitional: false,
        dns_length: true,
        ignore_invalid_punycode: false
    )

# Every check off.
function lax() -> Checks
    return Checks(
        hyphens: false,
        bidi: false,
        joiners: false,
        std3: false,
        transitional: false,
        dns_length: false,
        ignore_invalid_punycode: false
    )

test "quick_check: nothing, ASCII, a mark after a letter, marks out of their order, and a character NFC never holds"
    assert quick_check([]) == lookup.QUICK_YES
    assert quick_check([0x61, 0x62]) == lookup.QUICK_YES
    assert quick_check([0x61, 0x300]) == lookup.QUICK_MAYBE
    assert quick_check([0x61, 0x301, 0x316]) == lookup.QUICK_NO
    assert quick_check([0x958]) == lookup.QUICK_NO

test "verdict: hyphens checked and not, a mark first, a status refused, the STD3 rule, and both joiners"
    assert verdict([0x61, 0x62, 0x2d, 0x2d, 0x63], checks: strict(), transitional: false).fault != ""
    assert verdict([0x61, 0x62, 0x2d, 0x2d, 0x63], checks: lax(), transitional: false).fault == ""
    assert verdict([0x2d, 0x61], checks: strict(), transitional: false).fault != ""
    assert verdict([0x78, 0x6e, 0x2d, 0x2d, 0x61], checks: lax(), transitional: false).fault == "begins with \"xn--\" (V4)"
    assert verdict([0x300, 0x61], checks: lax(), transitional: false).fault == "begins with U+0300, a combining mark (V6)"
    assert verdict([0x41], checks: lax(), transitional: false).fault == "holds U+0041, whose status is mapped (V7)"
    assert verdict([0xdf], checks: lax(), transitional: false).fault == ""
    assert verdict([0xdf], checks: lax(), transitional: true).fault != ""
    assert verdict([0x5f], checks: strict(), transitional: false).fault == "holds U+005F, which UseSTD3ASCIIRules refuses (U1)"
    assert verdict([0x5f], checks: lax(), transitional: false).fault == ""
    assert verdict([0x61, 0x200d], checks: strict(), transitional: false).fault != ""
    assert verdict([0x915, 0x94d, 0x200d], checks: strict(), transitional: false).fault == ""
    assert verdict([0x628, 0x200c, 0x627], checks: strict(), transitional: false).fault == ""
    assert verdict([0x628, 0x300, 0x200c, 0x300, 0x627], checks: strict(), transitional: false).fault == ""
    assert verdict([0x627, 0x200c, 0x628], checks: strict(), transitional: false).fault != ""
    assert verdict([0x627, 0x200c, 0x628], checks: lax(), transitional: false).fault == ""
    assert verdict([0x61, 0x300], checks: strict(), transitional: false).undecided

test "bidi_fault: empty, left to right, right to left, a digit first, and both kinds of digits"
    assert bidi_fault([]) == ""
    assert bidi_fault([0x61, 0x62]) == ""
    assert bidi_fault([0x5d0, 0x5d1]) == ""
    assert bidi_fault([0x30, 0x5d0]) != ""
    assert bidi_fault([0x5d0, 0x30, 0x660, 0x5d0]) == "is right to left and holds both European and Arabic-Indic digits (B4)"
    assert bidi_fault([0x61, 0x5d0]) != ""
    assert bidi_fault([0x5d0, 0x61]) != ""
    assert bidi_fault([0x61, 0x300]) == ""
