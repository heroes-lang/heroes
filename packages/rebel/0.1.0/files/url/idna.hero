# Host names between Unicode and ASCII by IDNA: UTS #46's processing for
# Unicode 17.0.0 (its mapping table, its validity criteria, RFC 5892's
# ContextJ rules and RFC 5893's bidi rule), ToASCII and ToUnicode over it,
# and Punycode (RFC 3492) on its own. "Bücher.de" becomes
# "xn--bcher-kva.de", the name DNS and TLS are asked, and back.
#
# It does not read a URL (`url` does, and leaves its host as written), nor
# ask DNS for a name (`net`), nor normalize a text (`unicode/normalize`, which
# makes UTS #46's normalization to NFC here). Its tables are apart from `url`
# so that only the programs that convert a host carry them. Every one of UTS
# #46's own 6,389 test cases a `str` can hold is answered as the test file
# says.
#
# It fails with `invalid`, a host UTS #46 refuses, the message naming the
# label, its number and the rule, with the rule's code in UTS #46's test
# file (`V1`, `B1`, `P4`).

use unicode
use url/idna/internal/conformance_cases
use url/idna/internal/criteria
use url/idna/internal/process
use url/idna/internal/punycode
use url/idna/internal/written

## Codes

# The code of a host UTS #46 refuses, and of Punycode that does not decode;
# the message names the label and the rule.
constant INVALID: str
    "invalid"

# The version of Unicode whose IDNA mapping table and properties the tables
# hold.
constant UNICODE_VERSION: str
    "17.0.0"

## Options

# UTS #46's flags, which decide how strict a conversion is: each field one of
# its input flags, named as UTS #46 names it. Built by `strict_options`, every check
# on, or `url_options`, as a browser reads a URL's host; a program changes a
# field of either as it needs.
record Options
    # CheckHyphens: a label holds no "-" at its third and fourth characters
    # together, and none at either end. Off, a label may not begin with
    # "xn--" unless it is Punycode.
    check_hyphens: bool
    # CheckBidi: in a name holding a character written right to left, each
    # label meets RFC 5893's six rules.
    check_bidi: bool
    # CheckJoiners: U+200C and U+200D stand only where RFC 5892's ContextJ
    # rules allow them.
    check_joiners: bool
    # UseSTD3ASCIIRules: an ASCII character in a label is a lowercase letter,
    # a digit or "-", so "_" and " " are refused.
    use_std3_ascii_rules: bool
    # Transitional_Processing, which UTS #46 deprecates: the four deviations
    # (U+00DF, U+03C2, U+200C, U+200D) mapped as IDNA 2003 did, so "faß.de"
    # becomes "fass.de" and not "xn--fa-hia.de".
    transitional: bool
    # VerifyDnsLength, read by `to_ascii` alone: the name is 1 to 253 bytes
    # as ASCII and each label 1 to 63, so an empty label, a trailing "."
    # included, is refused.
    verify_dns_length: bool
    # IgnoreInvalidPunycode: a label that begins with "xn--" and does not
    # decode is kept as written, with no fault, where it would be `invalid`.
    ignore_invalid_punycode: bool

# Every check on and nontransitional, as UTS #46's test file runs ToASCII and
# as a name looked up in DNS needs: hyphens, bidi, joiners, the STD3 rules
# and the lengths checked, Punycode that does not decode refused.
function strict_options() -> Options
    return Options(
        check_hyphens: true,
        check_bidi: true,
        check_joiners: true,
        use_std3_ascii_rules: true,
        transitional: false,
        verify_dns_length: true,
        ignore_invalid_punycode: false
    )

# The flags WHATWG's URL Standard gives UTS #46 for a URL's host ("domain to
# ASCII", not strict): bidi and joiners checked, hyphens, the STD3 rules and
# the lengths not, nontransitional, Punycode that does not decode refused.
function url_options() -> Options
    return Options(
        check_hyphens: false,
        check_bidi: true,
        check_joiners: true,
        use_std3_ascii_rules: false,
        transitional: false,
        verify_dns_length: false,
        ignore_invalid_punycode: false
    )

## Hosts

# The host `host` names, in ASCII: UTS #46's ToASCII, every label holding a
# character above ASCII written "xn--" and its Punycode.
#
# - `host`: a domain name, labels joined by "." or by one of the full stops
#   UTS #46 maps to it ("。", "．", "｡"); capitals and the other mapped
#   characters are mapped first, the text normalized to NFC, and a label
#   already in Punycode is decoded and checked. Empty, it is refused under `options.verify_dns_length`, and
#   answered empty otherwise.
# - `options`: the checks, from `strict_options` or `url_options`.
#
# The answer is in lower case where the host's letters map so, and keeps a
# trailing "." where `options.verify_dns_length` is false.
#
# Fails `invalid` where UTS #46 refuses `host`: a character disallowed, a
# label against a criterion or a rule `options` asks (a label written in
# Punycode that is not in NFC among them), Punycode that does not decode, or a
# length past DNS's; the message names the label, its number and the rule.
# Each character is looked up by a binary search of the tables, and a label's
# Punycode costs n log n of its characters. See also `to_unicode`.
function to_ascii(host: str, options: Options) -> str?
    checks = criteria.Checks(
        hyphens: options.check_hyphens,
        bidi: options.check_bidi,
        joiners: options.check_joiners,
        std3: options.use_std3_ascii_rules,
        transitional: options.transitional,
        dns_length: options.verify_dns_length,
        ignore_invalid_punycode: options.ignore_invalid_punycode
    )
    return process.to_ascii(host, checks: checks)

# The host `host` names, in Unicode: UTS #46's ToUnicode, every label written
# in Punycode decoded, for a person to read.
#
# - `host`: a domain name, as `to_ascii` reads it; empty, it is answered
#   empty.
# - `options`: the checks, from `strict_options` or `url_options`;
#   `options.verify_dns_length` is not read.
#
# The answer is mapped as `to_ascii`'s is: "Bücher.DE" is "bücher.de".
#
# Fails `invalid` as `to_ascii` does, the lengths aside.
# See also `to_ascii`.
function to_unicode(host: str, options: Options) -> str?
    checks = criteria.Checks(
        hyphens: options.check_hyphens,
        bidi: options.check_bidi,
        joiners: options.check_joiners,
        std3: options.use_std3_ascii_rules,
        transitional: options.transitional,
        dns_length: options.verify_dns_length,
        ignore_invalid_punycode: options.ignore_invalid_punycode
    )
    return process.to_unicode(host, checks: checks)

## Punycode

# `s` written in Punycode (RFC 3492), without the "xn--" a host's label
# takes: its ASCII characters as they are, a "-" after them where there are
# any, then the others as digits and letters.
#
# - `s`: any text; empty, the answer is empty. Its case is kept and no
#   character is mapped or checked: that is `to_ascii`'s work.
#
# The characters above ASCII are taken in order of value and counted by a
# Fenwick tree, so the cost grows with n log n of the characters of `s`,
# where RFC 3492's own loop reads them all once for each different one. See
# also `parse_punycode`.
function format_punycode(s: str) -> str
    return punycode.encode(unicode.code_points(s))

# The text the Punycode `s` writes (RFC 3492), without the "xn--" a host's
# label takes.
#
# - `s`: Punycode, its digits in either case; empty, the answer is empty. A
#   "-" at its start, after no ASCII character, is read as a digit, so it
#   fails, as RFC 3492 reads it.
#
# Fails `invalid` where `s` holds a character above ASCII before its last
# "-", a character that is no digit after it, a number cut short, a number
# past the largest `i64`, or a code point that is no character (past U+10FFFF
# or a surrogate); the message names the byte's place. The places of the
# characters are settled last to first by a Fenwick tree, so the cost grows
# with n log n of the characters decoded, where inserting each into a list as
# RFC 3492 writes it grows with their square. See also `format_punycode`.
function parse_punycode(s: str) -> str?
    points = punycode.decode(s)?
    return ok(written.text_of(points))

## Tests

test "strict_options and url_options: every flag as documented"
    o = strict_options()
    assert o.check_hyphens && o.check_bidi && o.check_joiners && o.use_std3_ascii_rules && o.verify_dns_length
    assert !o.transitional && !o.ignore_invalid_punycode
    u = url_options()
    assert !u.check_hyphens && u.check_bidi && u.check_joiners && !u.use_std3_ascii_rules && !u.verify_dns_length
    assert !u.transitional && !u.ignore_invalid_punycode

test "to_ascii and to_unicode: url_options let through an underscore, a double hyphen and a trailing dot that strict_options refuse"
    assert to_ascii("my_host.example", options: strict_options()).is_err()
    assert to_ascii("my_host.example", options: url_options()).must() == "my_host.example"
    assert to_ascii("r3---sn-abc.example", options: strict_options()).is_err()
    assert to_ascii("r3---sn-abc.example", options: url_options()).must() == "r3---sn-abc.example"
    assert to_ascii("example.com.", options: url_options()).must() == "example.com."
    assert to_unicode("XN--BCHER-KVA.example", options: url_options()).must() == "bücher.example"

test "format_punycode and parse_punycode: empty, ASCII alone, one character above ASCII, and a refusal"
    assert format_punycode("") == ""
    assert format_punycode("abc") == "abc-"
    assert format_punycode("ü") == "tda"
    assert parse_punycode("").must() == ""
    assert parse_punycode("bcher-kva").must() == "bücher"
    assert parse_punycode("-a").is_err()

test "conformance: every case of UTS #46's test file a text can hold is run by the module that holds them"
    assert conformance_cases.CASES == 6389

test "to_ascii and to_unicode: a host whose mapping must be normalized to NFC, and a Punycode label that is not in NFC"
    apart = unicode.from_code_points([0x61, 0x301]).must() + ".example"
    assert to_ascii(apart, options: strict_options()).must() == "xn--1ca.example"
    assert to_unicode(apart, options: url_options()).must() == unicode.from_code_points([0xe1]).must() + ".example"

    match to_unicode("xn--a-xbb.example", options: strict_options())
        .ok _  => assert false
        .err e => assert e.code == INVALID

## Examples

# A host with a character above ASCII, as DNS is asked it.
test "to_ascii: a German host name"
    assert to_ascii("Bücher.de", options: strict_options()).must() == "xn--bcher-kva.de"

# A host written in Punycode, for a person to read.
test "to_unicode: a host in Punycode"
    assert to_unicode("xn--bcher-kva.de", options: strict_options()).must() == "bücher.de"

# The options a browser gives a URL's host, here letting an underscore through.
test "url_options: a host with an underscore"
    assert to_ascii("my_host.Example", options: url_options()).must() == "my_host.example"

# Every check on, so an underscore is refused.
test "strict_options: an underscore refused"
    assert to_ascii("my_host.example", options: strict_options()).is_err()

# A label written in Punycode, without its "xn--".
test "format_punycode: a word with an umlaut"
    assert format_punycode("bücher") == "bcher-kva"

# Punycode read back into the text it writes.
test "parse_punycode: a word with an umlaut"
    assert parse_punycode("bcher-kva").must() == "bücher"
