# An integer drawn evenly below a bound: as many random bytes as the bound
# has, the bits above its length cleared, drawn again while the number is not
# below the bound. Each draw is below the bound with a chance above one half,
# so the loop ends after two draws on the average.

use big/internal/limbs
use big/internal/octets
use random

# A magnitude from 0 to `n` less one, `n` above zero.
function below(@generator: random.Generator, n: [i64]) -> [i64]
    assert n.len() > 0
    bits = limbs.bit_len(n)
    count = (bits + 7) / 8
    mask = (1 << bits - (count - 1) * 8) - 1

    while true
        b: [u8] @= random.next_bytes(@generator, count)
        b[count - 1] @ to_u8(to_i64(b[count - 1]).must() & mask).must()
        m = octets.magnitude_of(b)

        if limbs.compare(a: m, b: n) < 0
            return m
