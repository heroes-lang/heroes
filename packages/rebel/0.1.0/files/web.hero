# Routes for an HTTP server in the manner of Go's Echo: explicit routes,
# values, no magic. A router is a value built by functions: routes by method
# and pattern, `/users/:id` and `/files/*path`, each with a name, and groups
# under a prefix. `route` answers which route takes a request and what its
# parameters hold; the program calls its own function for that name, with its
# own state. Steps before and after a handler are plain functions the program
# calls in its order: a log line, CORS, a failure answered 500, a request id,
# a body's limit, Basic and Bearer checks, gzip, a rate limit per client.
# Responses of a template, of a file and of a folder's files, served safely,
# errors as text or JSON, and server-sent events written as they are made.
# Cookies signed or sealed with their end inside, sessions kept in them, and
# CSRF tokens checked against the secret the server keeps; helmet's security
# headers; the client read through the proxies the program trusts; entity
# tags and 304 for a handler's own responses; a route refusing 406 what it
# cannot answer; a router tried with no network; serving ended gracefully
# at the stop; health and readiness answered from the program's own checks;
# and webhooks signed and verified as Standard Webhooks signs them.
#
# **Why the program dispatches.** The language has no closure, and a function
# value takes no `@` parameter (spec § 9), so no handler a router held could
# carry the program's state as Echo's closures carry it. So the router finds
# and the program calls: it writes `match found.name` and calls its own
# function, handing it the state it holds by `@`.
#
# **A program with no state** hands `serve` its router and one top-level
# function, which routes each request and answers it; `serve` hands the
# router to it as `http.serve_with` hands a program's value. **A program
# with state** writes the loop itself: `net.accept` a connection, `io.reader`
# on its stream, then for each request `http.next_request`, `route`, its own
# function called with its `@` state (or `not_routed` where no route takes
# the request), and `http.write_answer`, until the request or the response
# closes the connection; `route`'s example of a program's own loop is that
# loop, whole, and `http` answers its 100, 417, 431, 505 and 501 and keeps
# its connection alive as `http.serve` does.
#
# **What it does not do.** The connection, the reading and the writing of a
# message are `http`'s, a URL's parts `url`'s, a JSON value `json`'s, a
# template `template`'s, a file `fs`'s, a line of log `log`'s. A query, a form,
# a field, a cookie, Basic's credentials and a Bearer token are read by
# `http.query_of`, `http.form_of`, `http.value_of`, `http.cookie_of`,
# `http.basic_auth_of` and `http.bearer_token_of`, a multipart body's files
# by `http.parts_of`. A request's JSON body is read here, by `json_of`, which
# refuses a body not typed as JSON as a server must, where `http.json_of`
# reads a response's by its charset. A response of text, of JSON or a
# redirect is made by `http.respond_text`, `http.respond_json` and
# `http.respond_redirect`; this package adds only the ones a router needs
# (`error_response`, `not_routed`, `render`, `serve_file`, `serve_folder`,
# `respond_events`). A body is held whole, as `http` holds it, but an event
# stream's, which `start_events` begins and the program writes as it goes; a
# client reads one with `http.event_reader`. A handler cannot be stopped
# midway, so no step times one out.
#
# A WebSocket is `websocket`'s: the program's loop that found the route hands
# its `io.Reader` and the request to `websocket.upgrade`, so a WebSocket
# route needs the loop with state, not `serve`. Not done, the ledger saying
# so of each: a route chosen by its parameter's kind (a parameter takes any
# segment, and the handler reads it), requests passed on to another server
# (a reverse proxy), and HTTP sent to HTTPS or a host to its `www.` form.
#
# The codes it fails with: `invalid`, `not_found`, `exists`, `not_text`,
# `limit` (a cookie too long), `unsupported` (a cookie sealed on a Linux
# machine with no `libcrypto.so.3`), and, from the connection, `closed`,
# `timeout`, `stopped`, `limit` and `failed`.
#
# Not written yet, each a `pending` block of its ledger: a parameter matched by
# its kind or an expression, `/posts/{id:[0-9]+}`; HTTP sent to HTTPS, or a host
# to its `www.` form and back; requests passed to another server; webhooks
# signed and verified with Ed25519, the specification's `v1a`, `whsk_` and
# `whpk_` keys.

use bytes
use compress
use crypto
use crypto/seal
use http
use io
use json
use log
use net
use os
use path
use strings
use template
use time
use tls
use url
use uuid
use web/internal/csrf
use web/internal/event_stream
use web/internal/fixture
use web/internal/folders
use web/internal/health
use web/internal/limiting
use web/internal/patterns
use web/internal/proxies
use web/internal/reading
use web/internal/routing
use web/internal/signing
use web/internal/sniffing
use web/internal/webhooks

## Codes

# The code of a pattern, a prefix or a name that is not one; of a request's
# body that is not what a step reads; and of a path whose escapes do not read.
constant INVALID: str
    "invalid"

# The code of a request no route takes, of a name no route has, of a
# parameter, a cookie or a token the request does not hold.
constant NOT_FOUND: str
    "not_found"

# The code of a route whose method and shape a router holds already, and of
# a name given to a second pattern.
constant EXISTS: str
    "exists"

# The code of a cookie that would pass `MOST_COOKIE_BYTES`.
constant LIMIT: str
    "limit"

## Routers

# One route a router holds, as `add` made it.
record Route
    # The method it takes, as written: `http.METHOD_GET`; "" for every method.
    method: str
    # The whole pattern, its groups' prefixes before it: `/admin/users/:id`.
    pattern: str
    # The name `route` answers for it, which the program dispatches on.
    name: str
    # The names of the groups it was added in, the outermost first; none for a
    # route added to a router made by `new_router`.
    groups: [str]

# How this package writes an error's body.
variant ErrorForm
    # Text: the message and a line end, typed `text/plain; charset=utf-8`.
    text
    # JSON as Echo writes it: `{"message":"Not Found"}`, typed
    # `application/json`.
    json

# A set of routes and how a request no route takes is answered. Made by
# `new_router` and `new_group`; `add`, `add_any` and `mount` add its routes,
# and the program may set `redirect_slash` and `errors` directly.
record Router
    # The prefix every pattern added gets before it: "" for a router `new_router`
    # made, `/admin` for a group of that prefix.
    prefix: str
    # The names of the groups this router stands for, the outermost first.
    groups: [str]
    # Every route, in the order it was added.
    routes: [Route]
    # Whether a path no route takes is sent, by `not_routed`, to the same path
    # with its last `/` added or taken away where a route takes that one:
    # false unless the program sets it.
    redirect_slash: bool
    # How `not_routed` writes its bodies.
    errors: ErrorForm
    # What `route` reads: each route's pieces and the tree of their segments.
    index: routing.Index

# An empty router: no prefix, no group, errors written as text, no slash
# redirected.
#
# See also `new_group`, `add`.
function new_router() -> Router
    return Router(prefix: "", groups: [], routes: [], redirect_slash: false, errors: .text, index: routing.empty())

# An empty router for the group `name`, whose routes take `prefix` after the
# prefix of `parent`, to be mounted into `parent` once its routes are added.
#
# - `parent`: the router the group belongs to; its prefix, its groups, its
#   `redirect_slash` and its `errors` are copied, and its routes are not.
# - `name`: the group's name, which a found route's `groups` holds: letters,
#   digits and `_`, not empty.
# - `prefix`: the prefix, beginning with `/` and not ending with one, holding
#   no wildcard: `/admin`, `/users/:id`.
#
# Fails `invalid` where `name` or `prefix` is not one. See also `mount`,
# `is_in_group`.
function new_group(parent: Router, name: str, prefix: str) -> Router?
    if !patterns.is_name(name)
        return fail(code: INVALID, msg: f"the group's name \"{name}\" is not of letters, digits and `_`")

    if prefix == "" || prefix[0] != '/' || prefix[prefix.len() - 1] == '/'
        return fail(code: INVALID, msg: f"the prefix \"{prefix}\" does not begin with `/` or ends with one")
    whole = parent.prefix + prefix

    for p in patterns.parse(whole)?
        match p
            .fixed _ => _ = 0
            .param _ => _ = 0
            .rest _  => return fail(code: INVALID, msg: f"the prefix \"{prefix}\" holds a wildcard")

    groups @= parent.groups
    groups @ groups.push(name)
    return ok(
        Router(prefix: whole, groups: groups, routes: [], redirect_slash: parent.redirect_slash, errors: parent.errors, index: routing.empty())
    )

# Adds to `router` the route `name` for `method` and `pattern`.
#
# - `router`: the router, which gains the route.
# - `method`: the method it takes, a token: `http.METHOD_GET`, `"PURGE"`. A
#   route of `GET` takes `HEAD` too, where no route of `HEAD` does.
# - `pattern`: the path after the router's prefix, of segments parted by `/`:
#   a segment as written is matched as the request's segment unescaped reads;
#   `:name` matches one segment that is not empty, whatever it holds, so a
#   handler reads a number from it itself (`numbers.parse_int` on
#   `param_of`); `*name`, the last, matches the rest of the path, empty or
#   not. It begins with `/`, or is "" in a
#   group, where it names the prefix itself; it holds no empty segment but
#   the last, and no parameter's name twice.
# - `name`: the route's name, which `route` answers: any text but the empty
#   one; several methods of one pattern may share it.
#
# Fails `invalid` where the method, the pattern or the name is not one;
# `exists` where `router` holds a route of that method and that shape, the
# names of its parameters set aside, or `name` on another pattern. See also
# `add_any`, `route`.
function add(@router: Router, method: str, pattern: str, name: str) -> ()?
    if !routing.is_token(method)
        return fail(code: INVALID, msg: f"the method \"{method}\" is not a token")

    if pattern != "" && pattern[0] != '/'
        return fail(code: INVALID, msg: f"the pattern \"{pattern}\" does not begin with `/`")
    whole = router.prefix + pattern
    routing.add(@router.index, method: method, whole: whole, name: name)?
    router.routes @ router.routes.push(Route(method: method, pattern: whole, name: name, groups: router.groups))
    return ok()

# Adds to `router` the route `name` for every method on `pattern`.
#
# - `router`: the router, which gains the route.
# - `pattern`: as `add` reads it.
# - `name`: as `add` reads it.
#
# A route of one method takes a request of its method first. Fails as `add`
# does.
function add_any(@router: Router, pattern: str, name: str) -> ()?
    if pattern != "" && pattern[0] != '/'
        return fail(code: INVALID, msg: f"the pattern \"{pattern}\" does not begin with `/`")
    whole = router.prefix + pattern
    routing.add(@router.index, method: "", whole: whole, name: name)?
    router.routes @ router.routes.push(Route(method: "", pattern: whole, name: name, groups: router.groups))
    return ok()

# Adds to `router` every route of `group`, which `new_group` made from it.
#
# - `router`: the router, which gains the routes.
# - `group`: the group, its routes' patterns whole already.
#
# Fails `exists` as `add` does, adding none of them then.
function mount(@router: Router, group: Router) -> ()?
    routing.merge(index: @router.index, other: group.index)?
    list @= router.routes

    for each in group.routes
        list @ list.push(each)

    router.routes @ list
    return ok()

# The path of the route named `name`, its parameters filled from `params`.
#
# - `router`: the router.
# - `name`: the route's name.
# - `params`: a value for each parameter of its pattern, by name; each is
#   escaped as one segment, and a wildcard's value keeps its `/`.
#
# Fails `not_found` where no route has the name or a parameter has no value,
# and `invalid` where a parameter's value is empty, which no request would
# match, or a wildcard's holds a `.` or `..` segment. See also `route`.
function path_for(router: Router, name: str, params: [Param]) -> str?
    for i in range(from: 0, to: router.index.names.len())
        if router.index.names[i] == name
            names: [str] @= []
            values: [str] @= []

            for p in params
                names @ names.push(p.name)
                values @ values.push(p.value)

            return patterns.fill(router.index.pieces[i], names: names, values: values)

    return fail(code: NOT_FOUND, msg: f"no route is named \"{name}\"")

## Routing a request

# One parameter of a route as a request fills it.
record Param
    # The parameter's name, as the pattern writes it after its `:` or `*`.
    name: str
    # Its value: the segment unescaped, or for a wildcard every segment of the
    # rest unescaped and joined by `/`.
    value: str

# The route that takes a request, and what its parameters hold.
record Found
    # The route's name.
    name: str
    # The route's whole pattern.
    pattern: str
    # The names of the groups the route was added in, the outermost first.
    groups: [str]
    # Its parameters, in the order its pattern writes them.
    params: [Param]

# The route of `router` that takes `r`, and its parameters.
#
# - `router`: the router.
# - `r`: the request; its method and its target's path are read.
#
# Segment by segment from the left, a segment as written is tried before a
# parameter, and a parameter before a wildcard; where the rest does not
# match, the next is tried. At each path that matches, a route of `r`'s
# method takes it, then a route of `GET` for `HEAD`, then a route of every
# method. Fails `not_found` where no route takes it, a path with a `.` or
# `..` segment or an empty segment before its last included, and the program
# answers `not_routed`; `invalid` and `not_text` where an escape of the path
# does not read. See also `not_routed`, `param_of`.
function route(router: Router, r: http.Request) -> Found?
    if r.url.path != "" && r.url.path[0] != '/'
        return fail(code: NOT_FOUND, msg: f"no route takes the target \"{r.url.path}\"")
    segments = routing.at_least_root(url.parse_path(r.url.path)?)

    if !patterns.is_clean(segments)
        return fail(code: NOT_FOUND, msg: f"the path \"{r.url.path}\" holds a `.`, a `..` or an empty segment")
    at = routing.route_of(router.index, method: r.method, segments: segments)?
    found = patterns.values_of(router.index.pieces[at], segments: segments)
    params: [Param] @= []

    for i in range(from: 0, to: found.names.len())
        params @ params.push(Param(name: found.names[i], value: found.values[i]))

    each = router.routes[at]
    return ok(Found(name: each.name, pattern: each.pattern, groups: each.groups, params: params))

# The methods a route of `router` takes on `r`'s path, sorted by their bytes:
# what an `Allow` field says.
#
# - `router`: the router.
# - `r`: the request; its target's path is read.
#
# `HEAD` where `GET` is, `OPTIONS` where any is, since `not_routed` answers
# it; none where no route takes the path.
function allowed_of(router: Router, r: http.Request) -> [str]
    if r.url.path != "" && r.url.path[0] != '/'
        return []

    match url.parse_path(r.url.path)
        .ok segments => return routing.allowed(router.index, segments: routing.at_least_root(segments))
        .err _       => return []

# The answer to `r` where `route` found no route: what the client should be
# told.
#
# - `router`: the router; its `errors` and `redirect_slash` are read.
# - `r`: the request.
#
# 308 to the clean path where the path holds a `.` or `..` segment or an
# empty one before its last; 204 and `Allow` for `OPTIONS` where a route
# takes the path, and for `OPTIONS *`; 405 and `Allow` where routes take the
# path but none its method; 308 to the path with its last `/` added or taken
# away where `redirect_slash` asks and a route takes it; 400 where an escape
# does not read; else 404. A redirect keeps the query. See also `allowed_of`.
function not_routed(router: Router, r: http.Request) -> http.Response
    m = routing.miss(
        router.index,
        method: r.method,
        path: r.url.path,
        query: r.url.query,
        redirect_slash: router.redirect_slash
    )

    if m.status == http.STATUS_PERMANENT_REDIRECT
        return http.respond_redirect(m.status, location: m.location)

    if m.status == http.STATUS_NO_CONTENT
        out @= http.respond_status(m.status)
        out.headers @ [http.Header(name: "Allow", value: m.allow.join(", "))]
        return out
    out @= error_response(router.errors, status: m.status, message: http.status_text(m.status).default(""))

    if m.allow.len() > 0
        out.headers @ http.with_header(out.headers, name: "Allow", value: m.allow.join(", "))
    return out

# The value of the parameter `name` of `found`.
#
# - `found`: the route found.
# - `name`: the parameter's name, as the pattern writes it.
#
# Fails `not_found` where the route has no such parameter. A number or an
# identifier is read from the text by `numbers.parse_int` or `uuid.parse`.
function param_of(found: Found, name: str) -> str?
    for p in found.params
        if p.name == name
            return ok(p.value)

    return fail(code: NOT_FOUND, msg: f"the route \"{found.name}\" has no parameter \"{name}\"")

# Whether `found` was added in the group `name`, or in a group inside it.
#
# - `found`: the route found.
# - `name`: the group's name.
function is_in_group(found: Found, name: str) -> bool
    for g in found.groups
        if g == name
            return true

    return false

## Reading a request

# The body of `r` as a JSON value.
#
# - `r`: the request; its `Content-Type` is `application/json` or a type
#   ending in `+json`, compared without case and without its parameters.
#
# Fails `invalid` where the type is another or none, or the body is no JSON;
# `not_text` where the body is not UTF-8; and as `json.parse` does.
function json_of(r: http.Request) -> json.Value?
    kind = reading.media_type(http.value_of(r.headers, name: "Content-Type").default(""))

    if kind != "application/json" && !strings.has_suffix(s: kind, suffix: "+json")
        return fail(code: INVALID, msg: f"reading a JSON body: the request's body is typed \"{kind}\", not as JSON")
    return json.parse(bytes.to_text(r.body)?)

## Answering

# A response of `status` whose body says `message` in `form`.
#
# - `form`: text or JSON.
# - `status`: the status.
# - `message`: the message, any text.
#
# See also `not_routed`, `recover`.
function error_response(form: ErrorForm, status: i64, message: str) -> http.Response
    match form
        .text => return http.respond_text(status, text: message + "\n")
        .json => return http.respond(
            status,
            content_type: "application/json",
            body: bytes.from_text("{\"message\":" + json.quote(message) + "}")
        )

# A response of `status` whose body is the template `name` of `t` made of
# `value`.
#
# - `status`: the status.
# - `t`: the templates, read by `template.parse_html` or `template.parse`.
# - `name`: the template run, one of `t.names`.
# - `value`: what `.` names in it.
#
# Typed `text/html; charset=utf-8` where `t` was read in the HTML mode, which
# escapes every value by its place; `text/plain; charset=utf-8` where it was
# read in the text mode, which escapes nothing. Fails as
# `template.render_named` does.
function render(status: i64, t: template.Template, name: str, value: json.Value) -> http.Response?
    text = template.render_named(t, name, value)?

    if t.html
        return ok(http.respond(status, content_type: "text/html; charset=utf-8", body: bytes.from_text(text)))
    return ok(http.respond(status, content_type: "text/plain; charset=utf-8", body: bytes.from_text(text)))

# A copy of `response` that a browser saves as the file `filename`, or shows
# in the page under that name.
#
# - `response`: the response.
# - `filename`: the name, any text; a `"`, a `\` or a control character in it
#   is written `_`.
# - `download`: true to save it (`attachment`), false to show it (`inline`).
#
# RFC 6266: `filename` in ASCII, each other character `_`, and `filename*`
# in UTF-8 where the name is not ASCII.
function with_disposition(response: http.Response, filename: str, download: bool) -> http.Response
    kind: str @= "inline"

    if download
        kind @ "attachment"
    value: str @= kind + "; filename=" + reading.quoted(reading.ascii_name(filename))

    if reading.ascii_name(filename) != filename
        value @ value + "; filename*=UTF-8''" + url.escape_segment(filename)
    out @= response
    out.headers @ http.with_header(response.headers, name: "Content-Disposition", value: value)
    return out

## Files

# Where `serve_folder` answers from, and how. Made by `default_folder`, its
# fields changed by the program.
record Folder
    # The folder's path, as `fs` reads it.
    root: str
    # The file answered for a folder, "" for none: `index.html`.
    index: str
    # Whether a folder with no index is answered with a page of its names.
    listing: bool
    # Whether a name beginning with `.` is answered; false refuses it 404.
    hidden: bool

# The usual way to answer from `root`: `index.html` for a folder, no
# listing, no hidden name.
#
# - `root`: the folder's path.
function default_folder(root: str) -> Folder
    return Folder(root: root, index: "index.html", listing: false, hidden: false)

# The answer to `r` from the file of `folder` that `rest` names.
#
# - `r`: the request: `GET` or `HEAD`, others answered 405; its
#   `If-Modified-Since`, `Range` and `If-Range` fields are read.
# - `folder`: where and how.
# - `rest`: the path under the folder, `/` between its names, as a wildcard's
#   value holds it: `css/site.css`; "" names the folder itself.
#
# 404 where `rest` holds a `..` or `.` name, a `\`, a zero byte or a name
# beginning with `.` that the folder does not show, where it names nothing,
# or where it leads through a link out of the folder. 301 to the path with a
# `/` where a folder is named without one; then its index, or its listing, or
# 404. A file is answered with `Last-Modified`, `Accept-Ranges` and its type,
# as `serve_file` answers it. See also `default_folder`.
function serve_folder(r: http.Request, folder: Folder, rest: str) -> http.Response
    return folders.serve_folder(
        r,
        root: folder.root,
        index: folder.index,
        listing: folder.listing,
        hidden: folder.hidden,
        rest: rest
    )

# The answer to `r` from the file `file`.
#
# - `r`: the request: `GET` or `HEAD`, others answered 405; its
#   `If-Modified-Since`, `Range` and `If-Range` fields are read.
# - `file`: the file's path, which the program chose; nothing from the
#   request should reach it but through `serve_folder`.
#
# Its type by its name, else by its first bytes; `Last-Modified` and
# `Accept-Ranges: bytes`. 304 where `If-Modified-Since` is not older than the
# file; 206 and `Content-Range` for one range of `Range`, the whole file for
# several or where `If-Range` is not the file's date; 416 where no range
# fits; 404 where `file` names nothing or a folder; 403 where the system
# refuses it; 500 where it cannot be read.
function serve_file(r: http.Request, file: str) -> http.Response
    return folders.serve_file(r, file: file)

# The media type the first bytes of `data` show, by the WHATWG's rules as Go
# reads them: `application/octet-stream` where they show none.
#
# - `data`: the bytes; the first 512 are read.
#
# A file's type by its name is `mail.media_type_of`'s.
function sniff(data: [u8]) -> str
    return sniffing.sniff(data)

## Steps before and after a handler

# What a step before a handler answers: go on with the request, or answer
# here.
variant Step
    # Go on, with this request: the one given, or a copy the step changed.
    go_on
        # The request the next step or the handler reads.
        request: http.Request
    # Stop: this response answers the request, and no handler runs.
    answer
        # The response.
        response: http.Response

# Runs `steps` on `r` in their order, until one answers.
#
# - `r`: the request the first step reads.
# - `steps`: the steps, each given what the one before went on with; none
#   goes on with `r`.
#
# The first `answer`, or `go_on` with what the last step went on with. A step
# that needs more than the request is called by the program itself.
function before(r: http.Request, steps: [(function(http.Request) -> Step)]) -> Step
    current @= r

    for step in steps
        match step(current)
            .go_on g  => current @ g.request
            .answer a => return .answer(response: a.response)

    return .go_on(request: current)

# Runs `steps` on `response` in their order, each given `r` and what the one
# before answered.
#
# - `r`: the request answered.
# - `response`: the handler's response.
# - `steps`: the steps; none answers `response`.
function after(r: http.Request, response: http.Response, steps: [(function(http.Request, http.Response) -> http.Response)]) -> http.Response
    current @= response

    for step in steps
        current @ step(r, current)

    return current

# Refuses `r` 413 where its body is longer than `most_bytes`.
#
# - `r`: the request.
# - `most_bytes`: the most bytes of the body, 0 or more.
#
# A route's own limit; the server's is `http.Server.limits`. Aborts where
# `most_bytes` is below 0.
function limit_body(r: http.Request, most_bytes: i64) -> Step
    assert most_bytes >= 0

    if r.body.len() > most_bytes
        return .answer(
            response: error_response(.text, status: http.STATUS_CONTENT_TOO_LARGE, message: f"the body holds {r.body.len()} bytes, past {most_bytes}")
        )
    return .go_on(request: r)

# Refuses `r` 401 unless its Basic credentials are ones `accepts` takes.
#
# - `r`: the request.
# - `realm`: the realm the challenge names, any text without a `"` or `\`.
# - `accepts`: called once with the credentials where `r` carries them;
#   true lets `r` go on.
#
# The challenge is `challenge_basic`'s. A program that checks credentials
# against its own state reads them with `http.basic_auth_of` and answers
# `challenge_basic` itself.
function require_basic(r: http.Request, realm: str, accepts: (function(http.Credentials) -> bool)) -> Step
    match http.basic_auth_of(r)
        .err _ => return .answer(response: challenge_basic(realm))
        .ok c =>
            if accepts(c)
                return .go_on(request: r)
            return .answer(response: challenge_basic(realm))

# The answer 401 that asks for Basic credentials in `realm`.
#
# - `realm`: the realm, any text; a `"` or a `\` in it is escaped.
#
# `WWW-Authenticate: Basic realm="…", charset="UTF-8"`, RFC 7617.
function challenge_basic(realm: str) -> http.Response
    out @= error_response(.text, status: http.STATUS_UNAUTHORIZED, message: "Unauthorized")
    out.headers @ http.with_header(
        out.headers,
        name: "WWW-Authenticate",
        value: "Basic realm=" + reading.quoted(realm) + ", charset=\"UTF-8\""
    )
    return out

# Refuses `r` unless its Bearer token is one `accepts` takes, as RFC 6750
# answers: 401 where it has none or `accepts` refuses it, 400 where the field
# is no token.
#
# - `r`: the request.
# - `realm`: the realm the challenge names.
# - `accepts`: called once with the token where `r` carries one; true lets
#   `r` go on.
#
# See also `http.bearer_token_of`, `challenge_bearer`.
function require_bearer(r: http.Request, realm: str, accepts: (function(str) -> bool)) -> Step
    match http.bearer_token_of(r)
        .err e =>
            if e.code == http.INVALID
                return .answer(response: challenge_bearer(realm: realm, error: "invalid_request"))
            return .answer(response: challenge_bearer(realm: realm, error: ""))
        .ok token =>
            if accepts(token)
                return .go_on(request: r)
            return .answer(response: challenge_bearer(realm: realm, error: "invalid_token"))

# The answer that asks for a Bearer token in `realm`, RFC 6750: 401, or 400
# for `invalid_request`.
#
# - `realm`: the realm, any text; a `"` or a `\` in it is escaped.
# - `error`: RFC 6750's error code: "" where the request carried no token,
#   `invalid_token`, `invalid_request` (answered 400) or
#   `insufficient_scope` (answered 403).
function challenge_bearer(realm: str, error: str) -> http.Response
    status: i64 @= http.STATUS_UNAUTHORIZED

    if error == "invalid_request"
        status @ http.STATUS_BAD_REQUEST
    else if error == "insufficient_scope"
        status @ http.STATUS_FORBIDDEN
    value: str @= "Bearer realm=" + reading.quoted(realm)

    if error != ""
        value @ value + ", error=" + reading.quoted(error)
    out @= error_response(.text, status: status, message: http.status_text(status).default(""))
    out.headers @ http.with_header(out.headers, name: "WWW-Authenticate", value: value)
    return out

# Which other origins a browser may let read the answers, and how, by the
# Fetch standard's CORS. Made by `default_cors`, its fields changed by the
# program.
record Cors
    # The origins allowed, as a browser writes them: `https://example.com`;
    # `*` among them allows every one.
    origins: [str]
    # The methods a preflight allows, beyond the safe ones.
    methods: [str]
    # The request fields a preflight allows; none allows those the browser
    # asks for.
    headers: [str]
    # The response fields a page may read beyond the safe ones.
    exposed: [str]
    # Whether the browser sends its cookies and credentials; the origin is
    # then written, never `*`.
    credentials: bool
    # How long a browser may keep a preflight's answer, written in whole
    # seconds, a part of one counting as a whole one; zero writes none.
    max_age: time.Duration

# The usual CORS for `origins`: the methods `GET`, `HEAD`, `PUT`, `PATCH`,
# `POST` and `DELETE`, the fields the browser asks, no credentials, no age.
#
# - `origins`: the origins allowed; `["*"]` allows every one.
function default_cors(origins: [str]) -> Cors
    return Cors(
        origins: origins,
        methods: ["GET", "HEAD", "PUT", "PATCH", "POST", "DELETE"],
        headers: [],
        exposed: [],
        credentials: false,
        max_age: time.nanoseconds(0)
    )

# Answers `r` 204 where it is a CORS preflight, and lets every other request
# go on.
#
# - `r`: the request: a preflight is an `OPTIONS` with `Origin` and
#   `Access-Control-Request-Method`.
# - `cors`: what is allowed.
#
# The answer carries `Access-Control-Allow-Origin`, `-Methods`, `-Headers`,
# `-Credentials` and `-Max-Age` where the origin is allowed, and none of them
# where it is not, which the browser reads as a refusal. See also
# `with_cors`.
function preflight(r: http.Request, cors: Cors) -> Step
    if r.method != http.METHOD_OPTIONS
        return .go_on(request: r)

    origin = match http.value_of(r.headers, name: "Origin")
        .ok o  => o
        .err _ => return .go_on(request: r)

    if !http.has_header(r.headers, name: "Access-Control-Request-Method")
        return .go_on(request: r)
    out @= http.respond_status(http.STATUS_NO_CONTENT)
    fields @= reading.with_vary([], name: "Origin")
    fields @ reading.with_vary(fields, name: "Access-Control-Request-Method")
    fields @ reading.with_vary(fields, name: "Access-Control-Request-Headers")

    if reading.is_allowed(origin, origins: cors.origins)
        fields @ reading.with_allow_origin(fields, origin: origin, origins: cors.origins, credentials: cors.credentials)
        fields @ http.with_header(fields, name: "Access-Control-Allow-Methods", value: cors.methods.join(", "))
        asked = http.values_of(r.headers, name: "Access-Control-Request-Headers")

        if cors.headers.len() > 0
            fields @ http.with_header(fields, name: "Access-Control-Allow-Headers", value: cors.headers.join(", "))
        else if asked.len() > 0
            fields @ http.with_header(fields, name: "Access-Control-Allow-Headers", value: asked.join(", "))

        if cors.max_age.nanoseconds > 0
            fields @ http.with_header(
                fields,
                name: "Access-Control-Max-Age",
                value: to_str(webhooks.whole_seconds(cors.max_age))
            )

    out.headers @ fields
    return .answer(response: out)

# A copy of `response` carrying what lets the page of `r`'s origin read it.
#
# - `r`: the request; its `Origin` is read.
# - `response`: the response.
# - `cors`: what is allowed.
#
# `Access-Control-Allow-Origin`, `-Credentials` and `-Expose-Headers` where
# the origin is allowed, and `Vary: Origin` where the answer depends on it;
# `response` as it is where `r` has no `Origin`.
function with_cors(r: http.Request, response: http.Response, cors: Cors) -> http.Response
    origin = match http.value_of(r.headers, name: "Origin")
        .ok o  => o
        .err _ => return response

    out @= response
    every = reading.is_listed("*", list: cors.origins) && !cors.credentials

    if !every
        out.headers @ reading.with_vary(out.headers, name: "Origin")

    if !reading.is_allowed(origin, origins: cors.origins)
        return out
    out.headers @ reading.with_allow_origin(
        out.headers,
        origin: origin,
        origins: cors.origins,
        credentials: cors.credentials
    )

    if cors.exposed.len() > 0
        out.headers @ http.with_header(
            out.headers,
            name: "Access-Control-Expose-Headers",
            value: cors.exposed.join(", ")
        )
    return out

# A copy of `r` whose `X-Request-Id` holds an identifier: the one the client
# sent, or a new one.
#
# - `r`: the request; an `X-Request-Id` of 1 to 128 visible ASCII characters
#   is kept, any other replaced.
#
# A new one is a UUID of version 4. Fails as `uuid.new_v4` does. See also
# `copy_request_id`.
function with_request_id(r: http.Request) -> http.Request?
    match http.value_of(r.headers, name: "X-Request-Id")
        .ok held =>
            if held.len() >= 1 && held.len() <= 128 && reading.is_printable_ascii(held)
                return ok(r)
        .err _ => _ = 0

    out @= r
    out.headers @ http.with_header(r.headers, name: "X-Request-Id", value: uuid.format(uuid.new_v4()?))
    return ok(out)

# A copy of `response` carrying `r`'s `X-Request-Id`, where it has one.
#
# - `r`: the request.
# - `response`: the response.
function copy_request_id(r: http.Request, response: http.Response) -> http.Response
    match http.value_of(r.headers, name: "X-Request-Id")
        .err _ => return response
        .ok id =>
            out @= response
            out.headers @ http.with_header(response.headers, name: "X-Request-Id", value: id)
            return out

# Writes one line about `r` and its `response` through `logger`.
#
# - `logger`: where and how; the line's time is its clock's.
# - `r`: the request.
# - `response`: the response.
# - `started`: when the request began, by the logger's clock.
#
# Level `info` below 500 and `error` from 500; the message `request`, then
# `method`, `path` (with its query), `status`, `bytes` (the body's),
# `milliseconds`, `remote` and `id` where `r` has an `X-Request-Id`. Fails as
# `log.write` does.
function log_request(logger: log.Logger, r: http.Request, response: http.Response, started: time.Instant) -> ()?
    read_clock = logger.clock
    now = read_clock()?
    took = time.between(from: started, to: now)?
    fields: [log.Field] @= [
        log.text(key: "method", value: r.method)
        log.text(key: "path", value: url.request_target(r.url))
        log.integer(key: "status", value: response.status)
        log.integer(key: "bytes", value: response.body.len())
        log.integer(key: "milliseconds", value: took.nanoseconds / 1_000_000)
        log.text(key: "remote", value: r.remote)
    ]

    match http.value_of(r.headers, name: "X-Request-Id")
        .ok id => fields @ fields.push(log.text(key: "id", value: id))
        .err _ => _ = 0

    if response.status >= 500
        return log.error(logger, msg: "request", fields: fields)
    return log.info(logger, msg: "request", fields: fields)

# The response `answer` holds, or, where it is a failure, 500 and a line
# through `logger` saying the failure.
#
# - `logger`: where the failure is written, at level `error`.
# - `r`: the request, whose method and path the line names.
# - `answer`: what the handler answered.
# - `form`: how the 500's body is written; it says `Internal Server Error`,
#   never the failure, which may hold what the client must not read.
#
# A failure to write the line changes nothing. An abort ends the program,
# which no step can stop.
function recover(logger: log.Logger, r: http.Request, answer: http.Response?, form: ErrorForm) -> http.Response
    match answer
        .ok got => return got
        .err e =>
            fields = [
                log.text(key: "method", value: r.method)
                log.text(key: "path", value: url.request_target(r.url))
                log.text(key: "code", value: e.code)
                log.text(key: "failure", value: e.msg)
            ]

            match log.error(logger, msg: "handler failed", fields: fields)
                .ok _  => _ = 0
                .err _ => _ = 0

            return error_response(form, status: http.STATUS_INTERNAL_SERVER_ERROR, message: "Internal Server Error")

# A copy of `response` with its body compressed by gzip, where `r` accepts it
# and it is worth it: `http.with_compression`, by gzip alone and past a
# size.
#
# - `r`: the request; its `Accept-Encoding` is read, `gzip` or `*` with a
#   weight above 0.
# - `response`: the response.
# - `min_bytes`: the fewest bytes of a body compressed; 0 compresses every
#   body.
#
# Not compressed: a body shorter, and what `http.with_compression` answers
# as it is (a response with a `Content-Encoding`, no body, a status 1xx,
# 204, 206 or 304). Every other response gains `Vary: Accept-Encoding`,
# whether `r` accepts gzip or not, and `Content-Encoding: gzip` where its
# body is compressed. See also `http.with_compression`.
function gzip(r: http.Request, response: http.Response, min_bytes: i64) -> http.Response
    if response.body.len() < min_bytes
        return response

    if reading.accepts_gzip(http.values_of(r.headers, name: "Accept-Encoding"))
        return http.with_compression(response, r: r)
    refused @= r
    refused.headers @ http.with_header(r.headers, name: "Accept-Encoding", value: "identity")
    return http.with_compression(response, r: refused)

# Lets `r` go on with its body decompressed where its `Content-Encoding` is
# `gzip`, and refuses it where that body does not read.
#
# - `r`: the request.
# - `most_bytes`: the most bytes the decompressed body may hold.
#
# 413 past `most_bytes`, 400 where the body is no gzip, 415 for an encoding
# other than `gzip` and `identity`. The copy holds no `Content-Encoding`.
function gunzip_body(r: http.Request, most_bytes: i64) -> Step
    coding = strings.to_lower_ascii(strings.trim(http.value_of(r.headers, name: "Content-Encoding").default("")))

    if coding == "" || coding == "identity"
        return .go_on(request: r)

    if coding != "gzip" && coding != "x-gzip"
        refused @= error_response(
            .text,
            status: http.STATUS_UNSUPPORTED_MEDIA_TYPE,
            message: f"the body's coding \"{coding}\" is not one this server reads"
        )
        refused.headers @ http.with_header(refused.headers, name: "Accept-Encoding", value: "gzip")
        return .answer(response: refused)

    match compress.decompress(r.body, format: .gzip, limit: most_bytes)
        .ok data =>
            out @= r
            out.body @ data
            out.headers @ http.without_header(r.headers, name: "Content-Encoding")
            return .go_on(request: out)
        .err e =>
            if e.code == compress.LIMIT
                return .answer(
                    response: error_response(.text, status: http.STATUS_CONTENT_TOO_LARGE, message: f"the body holds more than {most_bytes} bytes once decompressed")
                )
            return .answer(
                response: error_response(.text, status: http.STATUS_BAD_REQUEST, message: "the body is no gzip: " + e.msg)
            )

# Refuses 403 a request of a method that changes something, sent by a page of
# another origin, as Go's `CrossOriginProtection` does.
#
# - `r`: the request; `GET`, `HEAD` and `OPTIONS` always go on.
# - `trusted`: the other origins allowed, as a browser writes them:
#   `https://example.com`.
#
# Read from `Sec-Fetch-Site` where the browser sends it (`same-origin` and
# `none` go on), else from `Origin` against `Host`; a request with neither is
# no browser's and goes on.
function refuse_cross_origin(r: http.Request, trusted: [str]) -> Step
    if r.method == http.METHOD_GET || r.method == http.METHOD_HEAD || r.method == http.METHOD_OPTIONS
        return .go_on(request: r)
    origin = http.value_of(r.headers, name: "Origin")

    match origin
        .ok o =>
            if reading.is_listed(o, list: trusted)
                return .go_on(request: r)
        .err _ => _ = 0

    refused: Step = .answer(
        response: error_response(.text, status: http.STATUS_FORBIDDEN, message: "cross-origin request refused")
    )

    match http.value_of(r.headers, name: "Sec-Fetch-Site")
        .ok site =>
            if site == "same-origin" || site == "none"
                return .go_on(request: r)
            return refused
        .err _ => _ = 0

    match origin
        .err _ => return .go_on(request: r)
        .ok o =>
            if reading.origin_host(o) != "" && reading.origin_host(o) == http.value_of(r.headers, name: "Host").default("")
                return .go_on(request: r)
            return refused

# Refuses `r` 415 where it has a body whose type is none of `types`.
#
# - `r`: the request.
# - `types`: the media types read, `application/json`, compared without case
#   and without parameters.
#
# A request with no body goes on.
function require_type(r: http.Request, types: [str]) -> Step
    if r.body.len() == 0
        return .go_on(request: r)
    kind = reading.media_type(http.value_of(r.headers, name: "Content-Type").default(""))

    for t in types
        if strings.to_lower_ascii(t) == kind
            return .go_on(request: r)

    return .answer(
        response: error_response(.text, status: http.STATUS_UNSUPPORTED_MEDIA_TYPE, message: f"the body is typed \"{kind}\", which this route does not read")
    )

# Lets a `POST` go on as the method its `X-HTTP-Method-Override` field
# names, for a client that can send only `GET` and `POST`, as Echo's
# `MethodOverride` does.
#
# - `r`: the request; another method, or a `POST` with no such field, goes on
#   as it is.
#
# The field may name `PUT`, `PATCH` or `DELETE`, in any case; another is
# answered 400. The copy holds no such field.
function override_method(r: http.Request) -> Step
    if r.method != http.METHOD_POST
        return .go_on(request: r)

    match http.value_of(r.headers, name: "X-HTTP-Method-Override")
        .err _ => return .go_on(request: r)
        .ok said =>
            wanted = strings.to_upper_ascii(strings.trim(said))

            if wanted != http.METHOD_PUT && wanted != http.METHOD_PATCH && wanted != http.METHOD_DELETE
                return .answer(
                    response: error_response(.text, status: http.STATUS_BAD_REQUEST, message: f"a POST may stand for PUT, PATCH or DELETE, not \"{said}\"")
                )
            out @= r
            out.method @ wanted
            out.headers @ http.without_header(r.headers, name: "X-HTTP-Method-Override")
            return .go_on(request: out)

## Server-sent events

# The text of `event` in the `text/event-stream` format of the WHATWG HTML
# standard: an `id` line where its id is not "", an `event` line where its
# name is not "", one `data` line for each line of its data, and the empty
# line that makes a reader dispatch it.
#
# - `event`: the event; its data is cut into lines at a carriage return and
#   a line feed, a line feed, or a carriage return alone, as a reader cuts
#   them, so it reads back the same with its line ends made line feeds; "" is
#   one empty `data` line, which a reader dispatches as an event of no data.
#
# Every value is written after a colon and one space, which a reader drops.
# Fails `invalid` where the name or the id holds a line end, or the id a zero
# byte, which a reader would read as another line or ignore. See also
# `write_event` and `http.events_of`, which reads the text back.
function format_event(event: http.Event) -> str?
    return event_stream.format(event)

# Writes to `s` the head of an event stream kept open: 200,
# `Content-Type: text/event-stream`, `Cache-Control: no-cache` where
# `headers` sets none, and `Connection: close`, the stream running to the
# connection's end.
#
# - `s`: the connection's stream, which the program's own loop read the
#   request from; it writes the events on it as they are made and closes it
#   to end the stream.
# - `headers`: fields added to the head, `Access-Control-Allow-Origin` for
#   instance; a `Content-Type` among them is replaced.
#
# **How a stream is kept open.** `serve` answers each request with a
# response held whole, so a program that streams writes its own loop, as
# `route`'s example does: where the route is the stream's, it calls
# `start_events` on the connection in place of `http.write_answer`, writes
# each event with `write_event` as it is made (each write goes to the
# connection at once, with nothing to flush), a comment now and then where
# nothing is said for long, since a proxy closes a silent connection, and
# closes the connection when it is done or a write fails `closed`, the client
# gone. The loop serves nothing else while it streams; a program with several
# streams at once waits on their connections with `poll`. A program with no
# state answers `respond_events`, a stream held whole. Fails as
# `http.write_response_head` does. See also `write_event`.
function start_events(s: io.Stream, headers: [http.Header]) -> ()?
    fields @= http.with_header(headers, name: "Content-Type", value: "text/event-stream")

    if !http.has_header(fields, name: "Cache-Control")
        fields @ http.with_header(fields, name: "Cache-Control", value: "no-cache")
    return http.write_response_head(
        s,
        response: http.Response(status: http.STATUS_OK, reason: "", headers: fields, body: [], closing: true)
    )

# Writes `event` to the event stream `s` carries, as `format_event` writes
# it, at once.
#
# - `s`: the connection's stream, after `start_events`.
# - `event`: the event.
#
# Fails `invalid` before writing a byte as `format_event` fails, and as
# `io.write` fails: `closed` where the client has gone. See also
# `start_events`, `write_comment`.
function write_event(s: io.Stream, event: http.Event) -> ()?
    return io.write_text(s, text: format_event(event)?)

# Writes to the event stream `s` carries a `retry` line: the milliseconds a
# client waits before it connects again once the stream ends.
#
# - `s`: the connection's stream, after `start_events`.
# - `ms`: the milliseconds, 0 or more.
#
# Fails `invalid` where `ms` is below 0, and as `io.write` fails. See also
# `http.EventReader`, whose `retry` reads it.
function write_retry(s: io.Stream, ms: i64) -> ()?
    if ms < 0
        return fail(code: INVALID, msg: f"a retry of {ms} ms, where a client reads 0 or more")
    return io.write_text(s, text: f"retry: {ms}\n")

# Writes to the event stream `s` carries a comment, which a reader skips: a
# line opening with a colon for each line of `text`, what keeps a proxy from
# closing a connection where no event is said for long.
#
# - `s`: the connection's stream, after `start_events`.
# - `text`: the comment, any text; each of its lines is a comment line, and
#   "" writes a lone colon.
#
# Fails as `io.write` fails. See also `write_event`.
function write_comment(s: io.Stream, text: str) -> ()?
    return io.write_text(s, text: event_stream.comment(text))

# A response holding `events` whole as an event stream, for a handler that
# cannot keep a connection open: the client reads them, and connects again
# once the response ends, after its `retry`.
#
# - `events`: the events, in their order; none makes an empty stream.
#
# Typed `text/event-stream`, with `Cache-Control: no-cache`. Fails `invalid`
# as `format_event` fails on any of them. See also `start_events`.
function respond_events(events: [http.Event]) -> http.Response?
    texts: [str] @= []

    for event in events
        texts @ texts.push(format_event(event)?)

    out @= http.respond(http.STATUS_OK, content_type: "text/event-stream", body: bytes.from_text(texts.join("")))
    out.headers @ http.with_header(out.headers, name: "Cache-Control", value: "no-cache")
    return ok(out)

## Rate limits

# The token buckets of many clients, one per key, as golang.org/x/time/rate
# documents one: a bucket holds up to `burst` tokens, refills at `rate`
# tokens a second, and each request takes one. The program holds it and lends
# it by `@` to `allow` and `limit_rate` with the time it read itself, so
# nothing reads a clock here and nothing is global. Made by `new_limiter`;
# a program may change its first three fields, keeping what `new_limiter`
# checks.
record Limiter
    # The tokens a bucket gains each second, above 0 and finite: 0.5 is one
    # request every two seconds.
    rate: f64
    # The most tokens a bucket holds, 1 or more: how many requests a client
    # makes at once after resting.
    burst: i64
    # The most clients whose buckets are not full again held at once, 1 or
    # more; past it, those seen longest ago are forgotten, half at a time.
    most_keys: i64
    # The buckets not full again, by key. A full one is forgotten, which
    # loses nothing, since a client met anew starts full. Only this package
    # reads it.
    buckets: {str: limiting.Bucket}

# A limiter of `rate` tokens a second and `burst` at once, for at most
# `most_keys` clients at once, every bucket full.
#
# - `rate`: the tokens a bucket gains each second, above 0 and finite.
# - `burst`: the most tokens a bucket holds, 1 or more.
# - `most_keys`: the most clients held at once, 1 or more: the memory it
#   holds is about that many keys and buckets.
#
# Fails `invalid` where `rate` is not above 0, is not a number or is
# infinite, or `burst` or `most_keys` is below 1. See also `allow`.
function new_limiter(rate: f64, burst: i64, most_keys: i64) -> Limiter?
    if rate != rate || rate - rate != 0.0 || rate <= 0.0
        return fail(code: INVALID, msg: f"a rate of {rate} tokens a second, where a limit takes a finite rate above 0")

    if burst < 1
        return fail(code: INVALID, msg: f"a burst of {burst}, where a bucket holds 1 token or more")

    if most_keys < 1
        return fail(code: INVALID, msg: f"at most {most_keys} clients, where a limit holds 1 or more")
    return ok(Limiter(rate: rate, burst: burst, most_keys: most_keys, buckets: {}))

# Takes a token from the bucket of `key` and answers true where it holds one
# at `now`; else takes none, leaves the bucket as it was and answers false:
# Go's `Limiter.AllowN` for one.
#
# - `limiter`: the limiter, whose bucket of `key` changes.
# - `key`: the client, as the program names it: its address
#   (`forwarded_of`'s `address`), a user, a token; a key met anew starts
#   full.
# - `now`: the time, as the program read it (`time.now`); one earlier than
#   the bucket's last token taken counts no time, as Go's limiter counts it.
#
# Aborts where the limiter's fields break what `new_limiter` checks. It costs
# a lookup, and where `most_keys` buckets are held and `key` is new, a pass
# over them. See also `wait_of` and `limit_rate`.
function allow(@limiter: Limiter, key: str, now: time.Instant) -> bool
    assert limiting.is_valid(rate: limiter.rate, burst: limiter.burst, most_keys: limiter.most_keys)
    return limiting.take(
        @limiter.buckets,
        key: key,
        now: now.unix_nanoseconds,
        rate: limiter.rate,
        burst: limiter.burst,
        most_keys: limiter.most_keys
    )

# How long from `now` until the bucket of `key` holds a token: zero where it
# holds one, so `allow` would answer true.
#
# - `limiter`: the limiter, read.
# - `key`: the client.
# - `now`: the time, as the program read it.
#
# Rounded up to the nanosecond, and at most about 292 years. Aborts where
# the limiter's fields break what `new_limiter` checks. See also `allow`.
function wait_of(limiter: Limiter, key: str, now: time.Instant) -> time.Duration
    assert limiting.is_valid(rate: limiter.rate, burst: limiter.burst, most_keys: limiter.most_keys)
    return time.nanoseconds(
        limiting.wait_ns(limiter.buckets, key: key, now: now.unix_nanoseconds, rate: limiter.rate, burst: limiter.burst)
    )

# Lets `r` go on where the bucket of `key` holds a token at `now`, taking
# it; else answers 429 with `Retry-After`, the whole seconds until it holds
# one, rounded up.
#
# - `limiter`: the limiter, whose bucket of `key` changes.
# - `r`: the request.
# - `key`: the client, as `allow` reads it.
# - `now`: the time, as the program read it.
# - `form`: how the 429 says it, as text or JSON; its message is Echo's,
#   "rate limit exceeded", and the wait.
#
# A step the program calls in its own loop with its own limiter, since a
# step `before` calls takes no `@` value. Aborts where the limiter's fields
# break what `new_limiter` checks. See also `allow`.
function limit_rate(@limiter: Limiter, r: http.Request, key: str, now: time.Instant, form: ErrorForm) -> Step
    if allow(@limiter, key: key, now: now)
        return .go_on(request: r)
    seconds = limiting.seconds_up(wait_of(limiter, key: key, now: now).nanoseconds)
    out @= error_response(
        form,
        status: http.STATUS_TOO_MANY_REQUESTS,
        message: f"rate limit exceeded: the next request is allowed in {seconds} s"
    )
    out.headers @ http.with_header(out.headers, name: "Retry-After", value: to_str(seconds))
    return .answer(response: out)

## Serving

# Serves every connection `l` accepts, one at a time, until the program asks
# to stop, each request answered by `handler` with `router`:
# `http.serve_with` with the router as the program's value.
#
# - `server`: how it serves, as `http.serve` reads it.
# - `l`: the listener; its owner closes it.
# - `router`: handed to `handler` with each request, never copied while
#   nothing writes it.
# - `handler`: called once for each request read, on this thread, with
#   `router` and the request; it routes the request and answers it, a step
#   before and after included. A response it answers that cannot be written
#   is answered 500.
#
# For a program with no state; a program with state writes its own loop, as
# `route`'s example of one does. Fails as `http.serve_with` does. See also
# `serve_stream`.
function serve(server: http.Server, l: net.Listener, router: Router, handler: (function(Router, http.Request) -> http.Response)) -> ()?
    return http.serve_with(server, l: l, state: router, handler: handler)

# `serve` over the TLS connections `l` accepts: `http.serve_tls_with` with
# the router as the program's value.
#
# - `server`: as `serve` reads it; its `deadline_ms` is the milliseconds a
#   client's handshake may take.
# - `l`: the TLS listener; its owner closes it.
# - `router`: handed to `handler`.
# - `handler`: as `serve` calls it.
#
# A handshake that fails ends that client alone. Fails as
# `http.serve_tls_with` does.
function serve_tls(server: http.Server, l: tls.Listener, router: Router, handler: (function(Router, http.Request) -> http.Response)) -> ()?
    return http.serve_tls_with(server, l: l, state: router, handler: handler)

# Serves the requests that come on `stream`, one after another, and answers
# how many were answered: `http.serve_stream_with` with the router as the
# program's value.
#
# - `server`: how it serves.
# - `stream`: the stream read and written; its owner closes it.
# - `remote`: what each request's `remote` holds, "" where it is not known.
# - `router`: handed to `handler`.
# - `handler`: as `serve` calls it.
#
# It ends as `http.serve_stream` does: where the client closes, sends what is
# no request (answered 400, 413, 417, 431, 501 or 505 first), or asks the
# connection closed, and where the response closes it or cannot be written.
function serve_stream(server: http.Server, stream: io.Stream, remote: str, router: Router, handler: (function(Router, http.Request) -> http.Response)) -> i64
    return http.serve_stream_with(server, stream: stream, remote: remote, state: router, handler: handler)

## Signed and sealed cookies

# The most bytes a `Set-Cookie` value this package writes may hold, as
# gorilla/securecookie bounds its own: a browser keeps 4,096 bytes of a
# cookie at least (RFC 6265 § 6.1) and no more is promised.
constant MOST_COOKIE_BYTES: i64
    4096

# How a cookie this package signs or seals is written and read. Made by
# `default_cookie_options`; the program changes its fields directly.
record CookieOptions
    # The cookie's name, a token: `session`.
    name: str
    # The path below which the browser sends it: `/`.
    path: str
    # The host it is sent to with its subdomains; "" for this host alone.
    domain: str
    # How long it lasts, a second or more, written in whole seconds as
    # `Max-Age`, a part of one counting as a whole one, and signed or sealed
    # inside the value, so a client that keeps it longer has it refused.
    max_age: time.Duration
    # Whether the browser sends it over HTTPS alone.
    secure: bool
    # Whether no script of the page may read it.
    http_only: bool
    # Its `SameSite`: `"Lax"`, `"Strict"`, `"None"`, or "" for none.
    same_site: str
    # The keys that sign, of 32 bytes or more each: the first signs, every
    # one verifies, so a key is rotated by putting the new one first and
    # keeping the old one until its cookies have ended.
    keys: [[u8]]
    # The keys that seal, where the value must also be unreadable: the
    # first seals, every one opens. Where it is empty the value is signed by
    # `keys` and readable by the client; else sealed, and `keys` is not
    # read. The program closes them.
    sealing: [seal.Key]

# Options for a cookie named `name` signed by `ring`: the path `/`, 30 days,
# `Secure`, `HttpOnly` and `SameSite=Lax`, nothing sealed.
#
# - `name`: the cookie's name.
# - `ring`: the signing keys, as `CookieOptions.keys` reads them.
#
# gorilla/sessions' path and 30 days; `Secure`, `HttpOnly` and `Lax` where
# its options leave them false and none, since a session's cookie wants
# them. See also `secure_cookie_of`, `with_secure_cookie`.
function default_cookie_options(name: str, ring: [[u8]]) -> CookieOptions
    return CookieOptions(
        name: name,
        path: "/",
        domain: "",
        max_age: time.days(30).must(),
        secure: true,
        http_only: true,
        same_site: "Lax",
        keys: ring,
        sealing: []
    )

# `value` signed for the cookie `name` with the first of `ring`, valid before
# `expires`: the value and the end in the clear, and an HMAC-SHA256 tag over
# the name, the value and the end.
#
# - `ring`: the keys; the first signs. Aborts where there is none or one
#   holds fewer than 32 bytes.
# - `name`: the cookie's name, bound into the tag, so a value moved to
#   another cookie is refused.
# - `value`: any text.
# - `expires`: the instant from which `verify_value` refuses it, to the
#   second.
#
# URL-safe base 64 and digits parted by `.`, which a cookie holds as it is.
# See also `verify_value`, `seal_value`.
function sign_value(ring: [[u8]], name: str, value: str, expires: time.Instant) -> str
    assert signing.are_keys(ring)
    return signing.sign(ring, name: name, value: value, expires: time.unix_seconds(expires))

# The value `signed` holds for the cookie `name`, as `sign_value` wrote it.
#
# - `ring`: the keys; any one of them may have signed it. Aborts as
#   `sign_value` does.
# - `name`: the cookie's name.
# - `signed`: the cookie's value, as the client sent it.
# - `now`: the instant compared with its end.
#
# Fails `invalid` where it is not of the form, no key's tag matches, each
# compared in constant time, or its end is not after `now`; `not_text` where
# its value is not UTF-8. See also `sign_value`.
function verify_value(ring: [[u8]], name: str, signed: str, now: time.Instant) -> str?
    assert signing.are_keys(ring)
    return signing.verify(ring, name: name, signed: signed, now: time.unix_seconds(now))

# `value` sealed for the cookie `name` under the first of `ring`, valid
# before `expires`: encrypted and authenticated by `crypto/seal`, the name
# bound beside it, as gorilla/securecookie's encrypted form keeps a value
# from the client's eyes.
#
# - `ring`: the keys; the first seals. Aborts where there is none.
# - `name`: the cookie's name, authenticated, not encrypted.
# - `value`: any text.
# - `expires`: the instant from which `open_value` refuses it.
#
# URL-safe base 64. Fails as `seal.seal` does: `unsupported` on a Linux
# machine with no `libcrypto.so.3`. See also `open_value`.
function seal_value(ring: [seal.Key], name: str, value: str, expires: time.Instant) -> str?
    assert ring.len() > 0
    return signing.seal_value(ring, name: name, value: value, expires: time.unix_seconds(expires))

# The value `sealed` holds for the cookie `name`, as `seal_value` wrote it.
#
# - `ring`: the keys; any one of them may have sealed it.
# - `name`: the cookie's name.
# - `sealed`: the cookie's value, as the client sent it.
# - `now`: the instant compared with its end.
#
# Fails `invalid` where it is no base 64, no key opens it, or its end is not
# after `now`; `unsupported` and `closed` as `seal.open` fails; `not_text`
# where its value is not UTF-8. See also `seal_value`.
function open_value(ring: [seal.Key], name: str, sealed: str, now: time.Instant) -> str?
    return signing.open_value(ring, name: name, sealed: sealed, now: time.unix_seconds(now))

# The value of the cookie `options.name` that `r` sends, verified or opened
# as `options` says.
#
# - `r`: the request; the first cookie of that name is read.
# - `options`: how the cookie was written.
# - `now`: the instant compared with its end.
#
# Fails `not_found` where `r` sends no such cookie, and as `verify_value` or
# `open_value` fails. See also `with_secure_cookie`.
function secure_cookie_of(r: http.Request, options: CookieOptions, now: time.Instant) -> str?
    said = http.cookie_of(r, name: options.name)?

    if options.sealing.len() > 0
        return open_value(options.sealing, name: options.name, sealed: said, now: now)
    return verify_value(options.keys, name: options.name, signed: said, now: now)

# A copy of `response` setting the cookie `options.name` to `value`, signed
# or sealed as `options` says, for `options.max_age` from `now`.
#
# - `response`: the response; a `Set-Cookie` field is added after its own.
# - `options`: how the cookie is written; aborts where its name is no token,
#   its `max_age` below a second, or its keys as `sign_value` refuses them.
# - `value`: any text.
# - `now`: the instant the cookie's life counts from.
#
# The field holds `Max-Age` and `Expires` both. Fails `limit` where the
# field's value would pass `MOST_COOKIE_BYTES`, and as `seal_value` does.
# See also `secure_cookie_of`, `without_cookie`.
function with_secure_cookie(response: http.Response, options: CookieOptions, value: str, now: time.Instant) -> http.Response?
    max_age_seconds = webhooks.whole_seconds(options.max_age)
    assert max_age_seconds >= 1
    expires = time.add(now, d: time.seconds(max_age_seconds).default(time.max_duration())).default(time.max_instant())
    written: str @= ""

    if options.sealing.len() > 0
        written @ seal_value(options.sealing, name: options.name, value: value, expires: expires)?
    else
        written @ sign_value(options.keys, name: options.name, value: value, expires: expires)
    c = http.Cookie(
        name: options.name,
        value: written,
        domain: options.domain,
        host_only: options.domain == "",
        path: options.path,
        expires: expires,
        persistent: true,
        secure: options.secure,
        http_only: options.http_only,
        same_site: options.same_site
    )
    field = http.format_set_cookie(c) + f"; Max-Age={max_age_seconds}"

    if field.len() > MOST_COOKIE_BYTES
        return fail(
            code: LIMIT,
            msg: f"setting the cookie {options.name}: its {field.len()} bytes pass the {MOST_COOKIE_BYTES} a browser keeps"
        )
    out @= response
    out.headers @ out.headers.push(http.Header(name: "Set-Cookie", value: field))
    return ok(out)

# A copy of `response` that makes the browser forget the cookie
# `options.name`: an empty value, `Max-Age=0` and an end in 1970.
#
# - `response`: the response; a `Set-Cookie` field is added after its own.
# - `options`: the cookie's name, path and domain, as it was written.
#
# Aborts where the name is no token. See also `with_secure_cookie`.
function without_cookie(response: http.Response, options: CookieOptions) -> http.Response
    c = http.Cookie(
        name: options.name,
        value: "",
        domain: options.domain,
        host_only: options.domain == "",
        path: options.path,
        expires: time.epoch(),
        persistent: true,
        secure: options.secure,
        http_only: options.http_only,
        same_site: options.same_site
    )
    out @= response
    out.headers @ out.headers.push(http.Header(name: "Set-Cookie", value: http.format_set_cookie(c) + "; Max-Age=0"))
    return out

## Sessions

# A session kept in a cookie: values the server gave the client to send back,
# signed or sealed so it cannot change them, as Flask's and gorilla's cookie
# stores keep one. Made by `new_session` or read by `session_of`; the
# program changes `values` directly and writes it with `with_session`.
record Session
    # The values, by their keys, in the order they were first set.
    values: {str: str}
    # Whether it was made new, no cookie read.
    is_new: bool

# An empty session, new.
#
# See also `session_of`.
function new_session() -> Session
    return Session(values: {}, is_new: true)

# The session `r`'s cookie holds, as `with_session` wrote it.
#
# - `r`: the request.
# - `options`: how the session's cookie was written.
# - `now`: the instant compared with its end.
#
# Fails `not_found` where `r` sends no such cookie, `invalid` where the
# cookie is refused (changed, signed by no key, ended) or holds no session,
# and as `secure_cookie_of` fails; a program begins a `new_session` then, as
# gorilla's and Flask's stores begin one. See also `with_session`.
function session_of(r: http.Request, options: CookieOptions, now: time.Instant) -> Session?
    text = secure_cookie_of(r, options: options, now: now)?

    members = match json.members_of(json.parse(text).default(.null_value))
        .ok m => m
        .err _ => return fail(
            code: INVALID,
            msg: f"reading the session of the cookie {options.name}: its value is no object"
        )

    values: {str: str} @= {}

    for k in keys(members)
        match json.text_of(members[k].must())
            .ok v => values[k] @ v
            .err _ => return fail(
                code: INVALID,
                msg: f"reading the session of the cookie {options.name}: the value of {k} is no text"
            )

    return ok(Session(values: values, is_new: false))

# A copy of `response` writing `session` into its cookie, as
# `with_secure_cookie` writes one, its values as a JSON object.
#
# - `response`: the response.
# - `session`: the session; its `is_new` is not written.
# - `options`: how the cookie is written.
# - `now`: the instant the cookie's life counts from.
#
# Fails `limit` where the cookie would pass `MOST_COOKIE_BYTES`, and as
# `with_secure_cookie` fails. See also `session_of`, `without_cookie`.
function with_session(response: http.Response, session: Session, options: CookieOptions, now: time.Instant) -> http.Response?
    members: {str: json.Value} @= {}

    for k in keys(session.values)
        members[k] @ .text(v: session.values[k].must())

    text = json.format(.object(members: members))?
    return with_secure_cookie(response, options: options, value: text, now: now)

## Forms protected from forgery (CSRF)

# The form field a CSRF token is read from: `csrf_token`.
constant CSRF_FIELD: str
    "csrf_token"

# The header field a CSRF token is read from, gorilla/csrf's: `X-CSRF-Token`.
constant CSRF_HEADER: str
    "X-CSRF-Token"

# The key of `Session.values` under which `csrf_secret` keeps a session's
# secret.
constant CSRF_KEY: str
    "_csrf"

# A new secret for CSRF tokens: 32 bytes from the system's generator, in
# URL-safe base 64, which the server keeps, in the session or in a signed
# cookie of its own, and never writes into a page.
#
# Fails as `os.random_bytes` does. See also `csrf_secret`, `mask_csrf`.
function new_csrf_secret() -> str?
    return csrf.new_secret()

# The CSRF secret `session` keeps, made and kept in it where it has none:
# the synchronizer token pattern, the secret living as long as the session.
#
# - `session`: the session; a new secret is set under `CSRF_KEY`, and the
#   program writes the session back with `with_session`.
#
# Fails as `new_csrf_secret` does. See also `check_csrf`.
function csrf_secret(@session: Session) -> str?
    match session.values[CSRF_KEY]
        .ok s  => return ok(s)
        .err _ => _ = 0

    made = new_csrf_secret()?
    session.values[CSRF_KEY] @ made
    return ok(made)

# The token a page writes in its form, or a script sends in `CSRF_HEADER`,
# for `secret`: masked anew at each call, so a compressed page never repeats
# the secret's bytes, as Django and gorilla/csrf mask theirs against BREACH.
#
# - `secret`: the secret, as `new_csrf_secret` made it.
#
# 86 characters of URL-safe base 64. Fails `invalid` where `secret` is no
# secret, and as `os.random_bytes` does. See also `check_csrf`.
function mask_csrf(secret: str) -> str?
    return csrf.mask(secret)

# The CSRF token `r` sends: its `CSRF_HEADER` field, else its form's
# `CSRF_FIELD`, a form sent as `application/x-www-form-urlencoded` or as
# `multipart/form-data`.
#
# - `r`: the request.
#
# Fails `not_found` where it sends none. See also `check_csrf`.
function csrf_token_of(r: http.Request) -> str?
    match http.value_of(r.headers, name: CSRF_HEADER)
        .ok t  => return ok(t)
        .err _ => _ = 0

    match http.form_of(r)
        .ok pairs =>
            for p in pairs
                if p.key == CSRF_FIELD
                    return ok(p.value)
        .err _ => _ = 0

    match http.parts_of(r, limits: http.default_part_limits())
        .ok parts =>
            match http.part_of(parts, name: CSRF_FIELD)
                .ok part => return bytes.to_text(part.data)
                .err _   => _ = 0
        .err _ => _ = 0

    return fail(code: NOT_FOUND, msg: f"the request sends no CSRF token, by {CSRF_HEADER} or the field {CSRF_FIELD}")

# Refuses `r` 403 where it changes something and its CSRF token does not
# unmask to `secret`; a safe method goes on.
#
# - `r`: the request; `GET`, `HEAD`, `OPTIONS` and `TRACE` go on, as Django
#   lets them.
# - `secret`: the secret the server keeps: the session's (`csrf_secret`),
#   or, for the double-submit cookie, the one its own signed cookie holds
#   (`secure_cookie_of`).
#
# The token is read by `csrf_token_of` and compared in constant time; 403
# says Django's words, `CSRF token missing.` or `CSRF token incorrect.`. It
# stands beside `refuse_cross_origin`, which needs no state. See also
# `mask_csrf`.
function check_csrf(r: http.Request, secret: str) -> Step
    if r.method == http.METHOD_GET || r.method == http.METHOD_HEAD || r.method == http.METHOD_OPTIONS || r.method == http.METHOD_TRACE
        return .go_on(request: r)

    token = match csrf_token_of(r)
        .ok t => t
        .err _ =>
            return .answer(
                response: error_response(.text, status: http.STATUS_FORBIDDEN, message: "CSRF token missing.")
            )

    if !csrf.holds(token: token, secret: secret)
        return .answer(response: error_response(.text, status: http.STATUS_FORBIDDEN, message: "CSRF token incorrect."))
    return .go_on(request: r)

## Security headers

# The fields a response carries against framing, sniffing, leaking its
# address and loading what it did not mean to: helmet's set, each field ""
# where it is not written. Made by `default_security_headers`; the program
# changes its fields directly.
record SecurityHeaders
    # `Content-Security-Policy`: what a page may load and run.
    content_security_policy: str
    # `Strict-Transport-Security`: how long the browser comes back over HTTPS
    # alone; `format_hsts` writes one.
    strict_transport_security: str
    # `X-Content-Type-Options`: `nosniff`.
    content_type_options: str
    # `X-Frame-Options`: `SAMEORIGIN` or `DENY`.
    frame_options: str
    # `Referrer-Policy`: what the browser says of this page when it leaves.
    referrer_policy: str
    # `Permissions-Policy`: the browser's features the page may use,
    # `camera=(), microphone=()`.
    permissions_policy: str
    # `Cross-Origin-Opener-Policy`: `same-origin` keeps other pages' windows
    # apart.
    opener_policy: str
    # `Cross-Origin-Resource-Policy`: who may load this response.
    resource_policy: str
    # `Origin-Agent-Cluster`: `?1` asks a process of its own.
    origin_agent_cluster: str
    # Other fields, written as they are: helmet's older ones.
    others: [http.Header]

# helmet's defaults, as helmet 8.3.0 answered on 2026-11-17: a policy of
# `self` for everything, `object-src 'none'`, `upgrade-insecure-requests`;
# HSTS for a year with subdomains; `nosniff`; `SAMEORIGIN`; `no-referrer`;
# `same-origin` for both cross-origin policies; `?1`; and its older fields
# `X-DNS-Prefetch-Control: off`, `X-Download-Options: noopen`,
# `X-Permitted-Cross-Domain-Policies: none` and `X-XSS-Protection: 0`. No
# `Permissions-Policy`, which helmet does not write.
#
# Django's `SecurityMiddleware` writes fewer by default: `nosniff`,
# `Referrer-Policy: same-origin`, `Cross-Origin-Opener-Policy: same-origin`,
# `X-Frame-Options: DENY`, no HSTS. See also `with_security_headers`,
# `minimal_security_headers`.
function default_security_headers() -> SecurityHeaders
    return SecurityHeaders(
        content_security_policy: "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests",
        strict_transport_security: format_hsts(max_age: time.days(365).must(), subdomains: true, preload: false),
        content_type_options: "nosniff",
        frame_options: "SAMEORIGIN",
        referrer_policy: "no-referrer",
        permissions_policy: "",
        opener_policy: "same-origin",
        resource_policy: "same-origin",
        origin_agent_cluster: "?1",
        others: [http.Header(name: "X-DNS-Prefetch-Control", value: "off"), http.Header(name: "X-Download-Options", value: "noopen"), http.Header(name: "X-Permitted-Cross-Domain-Policies", value: "none"), http.Header(name: "X-XSS-Protection", value: "0")]
    )

# Three fields that cost no page anything, each written where a response has
# none: `X-Content-Type-Options: nosniff`, `X-Frame-Options: SAMEORIGIN` and
# `Referrer-Policy: strict-origin-when-cross-origin`, against a page sniffed,
# framed by another site or followed with its full address; every other
# field "". `with_security_headers` writes them. See also
# `default_security_headers`, helmet's whole set.
function minimal_security_headers() -> SecurityHeaders
    return SecurityHeaders(
        content_security_policy: "",
        strict_transport_security: "",
        content_type_options: "nosniff",
        frame_options: "SAMEORIGIN",
        referrer_policy: "strict-origin-when-cross-origin",
        permissions_policy: "",
        opener_policy: "",
        resource_policy: "",
        origin_agent_cluster: "",
        others: []
    )

# A `Strict-Transport-Security` value, RFC 6797 § 6.1.
#
# - `max_age`: how long the browser comes back over HTTPS alone, written in
#   whole seconds, a part of one counting as a whole one; zero makes it
#   forget.
# - `subdomains`: whether `includeSubDomains` is written.
# - `preload`: whether `preload` is written, which browsers' lists read.
#
# A browser reads it only over HTTPS (RFC 6797 § 8.1), so it is written
# whatever the connection, as helmet writes it; Django writes it only on a
# request it knows came over HTTPS. Aborts where `max_age` is below zero.
function format_hsts(max_age: time.Duration, subdomains: bool, preload: bool) -> str
    max_age_s = webhooks.whole_seconds(max_age)
    assert max_age_s >= 0
    out: [str] @= [f"max-age={max_age_s}"]

    if subdomains
        out @ out.push("includeSubDomains")

    if preload
        out @ out.push("preload")
    return out.join("; ")

# A copy of `response` carrying each field of `headers` that is not "",
# where `response` has none of that name, so a handler's own field wins.
#
# - `response`: the response.
# - `headers`: the fields, as `default_security_headers` makes them.
#
# A step after the handler; `minimal_security_headers` makes three of them
# alone.
function with_security_headers(response: http.Response, headers: SecurityHeaders) -> http.Response
    pairs: [http.Header] @= [
        http.Header(name: "Content-Security-Policy", value: headers.content_security_policy)
        http.Header(name: "Strict-Transport-Security", value: headers.strict_transport_security)
        http.Header(name: "X-Content-Type-Options", value: headers.content_type_options)
        http.Header(name: "X-Frame-Options", value: headers.frame_options)
        http.Header(name: "Referrer-Policy", value: headers.referrer_policy)
        http.Header(name: "Permissions-Policy", value: headers.permissions_policy)
        http.Header(name: "Cross-Origin-Opener-Policy", value: headers.opener_policy)
        http.Header(name: "Cross-Origin-Resource-Policy", value: headers.resource_policy)
        http.Header(name: "Origin-Agent-Cluster", value: headers.origin_agent_cluster)
    ]

    for h in headers.others
        pairs @ pairs.push(h)

    out @= response.headers

    for h in pairs
        if h.value != "" && !http.has_header(out, name: h.name)
            out @ out.push(h)

    answer @= response
    answer.headers @ out
    return answer

## The client behind proxies

# What a request says of its client once the proxies the program trusts are
# read through: made by `forwarded_of`.
record Forwarded
    # The client's address, without its port: `203.0.113.7`, `2001:db8::1`;
    # a proxy's word where it hid it (`unknown`, `_hidden`); "" where the
    # request has no `remote`.
    address: str
    # The scheme the client asked with, `http` or `https`, as the trusted
    # proxy says it; "" where none says, the program knowing whether it
    # serves TLS itself.
    scheme: str
    # The host the client asked for, as the trusted proxy says it, else the
    # request's own `Host`.
    host: str
    # The trusted proxies read through: 0 where the connection's own peer is
    # not trusted.
    proxies: i64

# The networks of `list`, each an address, `10.0.0.1` or `::1`, or a network,
# `10.0.0.0/8` or `fd00::/8`: the proxies a program trusts.
#
# - `list`: the addresses and networks.
#
# An address alone is a network of itself only. Fails `invalid` where one
# reads as neither, its message naming it. See also `forwarded_of`.
function trusted_networks(list: [str]) -> [net.Network]?
    out: [net.Network] @= []

    for item in list
        if strings.contains(s: item, substr: "/")
            out @ out.push(net.parse_network(item)?)
        else
            a = net.unmap(net.parse_host(item)?)
            out @ out.push(net.network_of(a, bits: net.bits_of(a))?)

    return ok(out)

# The client of `r`, read through the proxies `trusted` holds: from RFC
# 7239's `Forwarded` where `r` sends one, else from `X-Forwarded-For`,
# `X-Forwarded-Proto` and `X-Forwarded-Host`.
#
# - `r`: the request; its `remote` is the nearest hop.
# - `trusted`: the networks of the proxies the program trusts, as
#   `trusted_networks` makes them; none trusts none, and no field is read.
#
# The hops are walked from the nearest back while each is trusted, so the
# client is the first hop no trusted network holds, or the farthest where
# every one is held: a client that writes the fields itself names only hops
# behind it. With `Forwarded` the scheme and the host are its element's
# `proto` and `host`; with `X-Forwarded-For`, the last value of
# `X-Forwarded-Proto` and of `X-Forwarded-Host`, the nearest proxy's, as
# werkzeug's `ProxyFix` reads one value each. See also `trusted_networks`.
function forwarded_of(r: http.Request, trusted: [net.Network]) -> Forwarded
    host = http.value_of(r.headers, name: "Host").default("")

    if r.remote == ""
        return Forwarded(address: "", scheme: "", host: host, proxies: 0)
    direct = proxies.address_part(r.remote)

    if !proxies.is_trusted(direct, trusted: trusted)
        return Forwarded(address: direct, scheme: "", host: host, proxies: 0)
    elements = http.values_of(r.headers, name: "Forwarded")

    if elements.len() > 0
        hops = proxies.hops_of_forwarded(elements)
        w = proxies.walk(hops, trusted: trusted)

        if hops.len() == 0
            return Forwarded(address: direct, scheme: "", host: host, proxies: 0)
        hop = hops[w.at]

        told_host = if hop.host != ""
            hop.host
        else
            host
        return Forwarded(address: hop.address, scheme: hop.scheme, host: told_host, proxies: w.passed)

    hops = proxies.hops_of_list(http.values_of(r.headers, name: "X-Forwarded-For"))

    if hops.len() == 0
        return Forwarded(address: direct, scheme: "", host: host, proxies: 0)
    w = proxies.walk(hops, trusted: trusted)
    scheme = strings.to_lower_ascii(proxies.last_member(http.values_of(r.headers, name: "X-Forwarded-Proto")))
    said_host = proxies.last_member(http.values_of(r.headers, name: "X-Forwarded-Host"))

    told_host = if said_host != ""
        said_host
    else
        host
    return Forwarded(address: hops[w.at].address, scheme: scheme, host: told_host, proxies: w.passed)

## Caching dynamic responses

# A strong entity tag for `body`, or a weak one: the first 16 bytes of its
# SHA-256 in hexadecimal, quoted, `W/` before it where `weak`.
#
# - `body`: the bytes the tag stands for.
# - `weak`: whether the tag is weak, for a body that may differ in bytes and
#   not in meaning (a date inside it, its spaces).
#
# Equal bodies have equal tags; 128 bits make two different ones meet by
# chance about never. See also `with_etag`.
function etag_of(body: [u8], weak: bool) -> str
    tag = "\"" + bytes.format_hex(crypto.sha256(body).slice(from: 0, to: 16)) + "\""

    if weak
        return "W/" + tag
    return tag

# A step after the handler: `response` given a strong `ETag` of its body
# where it is a 200 to `GET` or `HEAD` with none, then answered 304 where `r`
# holds its copy, by `If-None-Match` or by `If-Modified-Since` against its
# `Last-Modified`.
#
# - `r`: the request.
# - `response`: the handler's response; its own `ETag` is kept.
#
# The work is still done, as Django's `ConditionalGetMiddleware` does it:
# what is spared is the body on the wire. See also `http.is_not_modified`,
# `http.respond_not_modified`.
function with_etag(r: http.Request, response: http.Response) -> http.Response
    out @= response

    if response.status == http.STATUS_OK && (r.method == http.METHOD_GET || r.method == http.METHOD_HEAD) && !http.has_header(response.headers, name: "ETag")
        out.headers @ out.headers.push(http.Header(name: "ETag", value: etag_of(response.body, weak: false)))

    if http.is_not_modified(r, response: out)
        return http.respond_not_modified(out)
    return out

## Negotiation

# A step that refuses `r` 406 where it accepts none of `offered`, by its
# `Accept` fields, saying what is offered.
#
# - `r`: the request.
# - `offered`: the media types the route answers, its preferred first.
#
# The handler then answers `http.negotiate_type(r, offered)`'s type, which
# is not a failure once this step goes on.
function require_acceptable(r: http.Request, offered: [str]) -> Step
    match http.negotiate_type(r, offered: offered)
        .ok _ => return .go_on(request: r)
        .err _ =>
            return .answer(
                response: error_response(.text, status: http.STATUS_NOT_ACCEPTABLE, message: f"this route answers {offered.join(", ")}, none of which the request accepts")
            )

## Handlers tried without a network

# The response `handler` gives `r` with `router`, carried both ways in
# memory as a connection would carry them: `http.exchange_with` with the
# router as the program's value, as Go's `httptest` and Flask's
# `test_client` try a handler.
#
# - `r`: the request, as a client makes it.
# - `router`: handed to `handler`.
# - `handler`: called once with `router` and the request as a server reads
#   it, unless the server would refuse it first.
#
# A program with state tries its own function between `http.to_served` and
# `http.to_received`. Fails as `http.exchange_with` does.
function exchange(r: http.Request, router: Router, handler: (function(Router, http.Request) -> http.Response)) -> http.Response?
    return http.exchange_with(r, state: router, handler: handler)

## Stopping gracefully

# Serves every connection `l` accepts, one at a time, until the program asks
# to stop, and ends gracefully: `http.serve_until_stopped` with the router as
# the program's value.
#
# - `server`: how it serves.
# - `l`: the listener; its owner closes it.
# - `router`: handed to `handler` with each request.
# - `handler`: called once for each request, with `router` and the request.
# - `grace`: how long after the stop a request whose bytes have come may
#   still begin to be answered, zero or more, a part of a millisecond
#   counting as a whole one.
#
# The counts of what it served and what the stop cut. Fails as
# `http.serve_until_stopped` does. See also `serve`.
function serve_until_stopped(server: http.Server, l: net.Listener, router: Router, handler: (function(Router, http.Request) -> http.Response), grace: time.Duration) -> http.Served?
    return http.serve_until_stopped(server, l: l, state: router, handler: handler, grace: grace)

## Health and readiness

# One check a program ran for its health or its readiness: its name and what
# it found. The program runs its checks itself, with its own state, and hands
# what they found to `health_response`.
record Check
    # The check's name, as the answer lists it: `database`, `disk`.
    name: str
    # What it found: `ok()` where it passed; where it did not, its failure,
    # whose message says why.
    outcome: ()?

# The answer of a health, liveness or readiness endpoint, `/healthz`,
# `/livez` or `/readyz` as Kubernetes names them, for the checks a program
# ran: 200 where every check passed, 503 where one did not.
#
# - `r`: the request. A `verbose` key in its query, with any value or none,
#   asks for every check by name, as Kubernetes's `?verbose` does. An `Accept`
#   that weighs `application/health+json` or `application/json` above
#   `text/plain` asks for JSON; none, or one that accepts neither, gets text.
# - `checks`: the checks the program ran, in the order they are listed; none
#   at all is a pass.
# - `detail`: whether a failed check's message is written; where not,
#   `reason withheld` stands for it, as Kubernetes withholds it from a client
#   it does not trust.
#
# Text is written as Kubernetes writes it: `ok` where every check passed and
# no more was asked; else `[+]name ok` or `[-]name failed: message` for each
# check, a line each, then `health check passed` or `health check failed`.
# JSON is the IETF draft "Health Check Response Format for HTTP APIs"'s
# `application/health+json`: `{"status":"pass","checks":{"db":[{"status":
# "pass"}]}}`, the whole `pass` or `fail`, each name with the list of its
# results, a failure with its `output`. Either answer is marked
# `Cache-Control: no-store`, so no cache answers for the program.
#
# See also `Check`.
function health_response(r: http.Request, checks: [Check], detail: bool) -> http.Response
    names: [str] @= []
    passed: [bool] @= []
    messages: [str] @= []

    for c in checks
        names @ names.push(c.name)

        match c.outcome
            .ok _ =>
                passed @ passed.push(true)
                messages @ messages.push("")
            .err e =>
                passed @ passed.push(false)
                messages @ messages.push(e.msg)

    status = if passed.all(health.is_true)
        http.STATUS_OK
    else
        http.STATUS_SERVICE_UNAVAILABLE
    verbose @= false

    for pair in http.query_of(r).default([])
        if pair.key == "verbose"
            verbose @ true

    offered = ["text/plain", "application/health+json", "application/json"]
    chosen = http.negotiate_type(r, offered: offered).default("text/plain")
    answer @= http.respond_text(
        status,
        health.text_body(names: names, passed: passed, messages: messages, verbose: verbose, detail: detail)
    )

    if chosen != "text/plain"
        written = json.format(health.json_body(names: names, passed: passed, messages: messages, detail: detail)).default(
            "{}"
        )
        answer @ http.respond(status, content_type: "application/health+json", body: bytes.from_text(written))
    answer.headers @ http.with_header(answer.headers, name: "Cache-Control", value: "no-store")
    return answer

## Webhooks signed as Standard Webhooks signs them

# How far a webhook's timestamp may stand from the clock that reads it,
# either way: five minutes, as the specification's libraries allow.
function default_webhook_tolerance() -> time.Duration
    return time.minutes(5).must()

# A new secret for signing webhooks: `whsec_` and the standard base 64 of 32
# bytes the system's generator draws.
#
# Fails as `os.random_bytes` does. See also `sign_webhook`.
function new_webhook_secret() -> str?
    return ok(webhooks.secret_of(os.random_bytes(webhooks.SECRET_BYTES)?))

# The `webhook-signature` of `payload` sent as `id` at `sent`, by the
# Standard Webhooks specification: `v1,` and the standard base 64 of the
# HMAC-SHA256 of `id`, `.`, the decimal of `sent`'s Unix seconds, `.` and the
# payload, keyed by the secret's bytes.
#
# - `secret`: `whsec_` and standard base 64, as `new_webhook_secret` writes
#   one; the prefix may be left out.
# - `id`: the message's id, unique for each message: `msg_2KWPBgLlAfxdpx2AI54pPJ85f4W`.
# - `sent`: when it is sent; its whole seconds are signed, as `sign_webhook`
#   writes them.
# - `payload`: the body, its bytes as sent.
#
# Fails `invalid` where `secret` is no base 64 after its prefix, or holds no
# byte. See also `sign_webhook`, `verify_webhook`.
function webhook_signature(secret: str, id: str, sent: time.Instant, payload: [u8]) -> str?
    key = webhooks.secret_bytes(secret)?
    return ok(webhooks.signature(key: key, id: id, timestamp_s: time.unix_seconds(sent), payload: payload))

# The three header fields a webhook is sent with, by the Standard Webhooks
# specification: `webhook-id`, `webhook-timestamp` and `webhook-signature`.
#
# - `secret`: the secret, as `webhook_signature` reads it.
# - `id`: the message's id; a message sent again keeps its id.
# - `sent`: when it is sent; its whole seconds are written.
# - `payload`: the body.
#
# Fails `invalid` where `secret` does not read. See also `verify_webhook`.
function sign_webhook(secret: str, id: str, sent: time.Instant, payload: [u8]) -> [http.Header]?
    seconds = time.unix_seconds(sent)
    signed = webhook_signature(secret: secret, id: id, sent: sent, payload: payload)?
    return ok(
        [http.Header(name: "webhook-id", value: id), http.Header(name: "webhook-timestamp", value: to_str(seconds)), http.Header(name: "webhook-signature", value: signed)]
    )

# The id of the webhook `headers` and `payload` carry, where one of
# `secrets` signed it as the Standard Webhooks specification says and it was
# sent within `tolerance` of `now`.
#
# - `headers`: the request's header fields; `webhook-id`,
#   `webhook-timestamp` and `webhook-signature` are read, in any case.
# - `payload`: the body, its bytes as received, before any reading of them.
# - `secrets`: the secrets that may have signed it, the newest first; a
#   signature by any of them passes, so a secret rotates without a message
#   lost.
# - `now`: the time it is read.
# - `tolerance`: how far the timestamp may stand from `now`, either way,
#   counted in whole seconds, a part of one counting as a whole one;
#   `default_webhook_tolerance()` is the specification's libraries'.
#
# Fails `invalid` where a field is missing or does not read, a secret does
# not read, the timestamp is further than `tolerance` from `now` or
# `tolerance` is below zero, or no
# `v1` signature of the field matches one of `secrets`, compared in constant
# time; the message says which. A signature of another version, `v1a`, is
# passed over. A receiver keeps the id to refuse the same message twice.
#
# See also `sign_webhook`.
function verify_webhook(headers: [http.Header], payload: [u8], secrets: [str], now: time.Instant, tolerance: time.Duration) -> str?
    tolerance_s = webhooks.whole_seconds(tolerance)

    if tolerance_s < 0
        return fail(code: INVALID, msg: f"a tolerance of {time.format_duration(tolerance)}, below zero")

    id = match http.value_of(headers, name: "webhook-id")
        .ok v  => v
        .err _ => return fail(code: INVALID, msg: "the webhook carries no webhook-id field")

    field = match http.value_of(headers, name: "webhook-timestamp")
        .ok v  => v
        .err _ => return fail(code: INVALID, msg: "the webhook carries no webhook-timestamp field")

    signatures = match http.value_of(headers, name: "webhook-signature")
        .ok v  => v
        .err _ => return fail(code: INVALID, msg: "the webhook carries no webhook-signature field")

    sent = webhooks.timestamp_of(field)?
    seconds = time.unix_seconds(now)

    if sent < seconds - tolerance_s
        return fail(code: INVALID, msg: f"the webhook was sent at {sent}, more than {tolerance_s} s before {seconds}")

    if sent > seconds + tolerance_s
        return fail(code: INVALID, msg: f"the webhook was sent at {sent}, more than {tolerance_s} s after {seconds}")

    if !webhooks.has_v1(signatures)
        return fail(code: INVALID, msg: "the webhook-signature field holds no v1 signature")
    expected: [str] @= []

    for secret in secrets
        key = webhooks.secret_bytes(secret)?
        expected @ expected.push(webhooks.signature(key: key, id: id, timestamp_s: sent, payload: payload))

    if !webhooks.holds_signature(signatures, expected: expected)
        return fail(code: INVALID, msg: f"no signature of the webhook {id} matches one of the {secrets.len()} secrets")
    return ok(id)

## Tests

test "route: a fixed segment before a parameter before a wildcard, parameters unescaped"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/users/:id", name: "user").must()
    add(@rt, method: "GET", pattern: "/users/new", name: "new_user").must()
    add(@rt, method: "GET", pattern: "/files/*path", name: "files").must()
    assert route(rt, fixture.request_of(method: "GET", target: "/users/new", headers: [])).must().name == "new_user"
    one = route(rt, fixture.request_of(method: "GET", target: "/users/a%2Fb", headers: [])).must()
    assert one.name == "user" && one.params == [Param(name: "id", value: "a/b")]
    assert param_of(route(rt, fixture.request_of(method: "GET", target: "/files/a/b%20c", headers: [])).must(), name: "path").must() == "a/b c"
    assert param_of(route(rt, fixture.request_of(method: "GET", target: "/files/", headers: [])).must(), name: "path").must() == ""
    assert param_of(route(rt, fixture.request_of(method: "GET", target: "/files", headers: [])).must(), name: "path").must() == ""
    assert route(rt, fixture.request_of(method: "GET", target: "/users/", headers: [])).is_err()

test "route: HEAD taken by GET, every method last, a dirty path and a bad escape refused"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/a", name: "get_a").must()
    add_any(@rt, pattern: "/a", name: "get_a").must()
    assert route(rt, fixture.request_of(method: "HEAD", target: "/a", headers: [])).must().name == "get_a"
    assert route(rt, fixture.request_of(method: "PATCH", target: "/a", headers: [])).must().name == "get_a"

    match route(rt, fixture.request_of(method: "GET", target: "/b/../a", headers: []))
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    match route(rt, fixture.request_of(method: "GET", target: "/caf%C3", headers: []))
        .ok _  => assert false
        .err e => assert e.code == "not_text"

test "not_routed: 404, 405 with Allow, OPTIONS, the clean path, a slash where asked, JSON"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/users/:id", name: "user").must()
    add(@rt, method: "DELETE", pattern: "/users/:id", name: "user").must()
    add(@rt, method: "GET", pattern: "/dir/", name: "dir").must()
    missing = not_routed(rt, fixture.request_of(method: "GET", target: "/nothing", headers: []))
    assert missing.status == 404 && http.text_of(missing).must() == "Not Found\n"
    refused = not_routed(rt, fixture.request_of(method: "PUT", target: "/users/7", headers: []))
    assert refused.status == 405 && http.value_of(refused.headers, name: "Allow").must() == "DELETE, GET, HEAD, OPTIONS"
    options = not_routed(rt, fixture.request_of(method: "OPTIONS", target: "/users/7", headers: []))
    assert options.status == 204 && options.body.len() == 0
    dirty @= fixture.request_of(method: "GET", target: "/x?x=1", headers: [])
    dirty.url.path @ "//users/7"
    moved = not_routed(rt, dirty)
    assert moved.status == 308 && http.value_of(moved.headers, name: "Location").must() == "/users/7?x=1"
    assert not_routed(rt, fixture.request_of(method: "GET", target: "/dir", headers: [])).status == 404
    rt.redirect_slash @ true
    assert http.value_of(not_routed(rt, fixture.request_of(method: "GET", target: "/dir", headers: [])).headers, name: "Location").must() == "/dir/"
    rt.errors @ .json
    assert http.text_of(not_routed(rt, fixture.request_of(method: "GET", target: "/x", headers: []))).must() == "{\"message\":\"Not Found\"}"

test "new_group: nested groups, their prefixes and names, a prefix refused"
    rt @= new_router()
    api @= new_group(rt, name: "api", prefix: "/api").must()
    v1 @= new_group(api, name: "v1", prefix: "/v1").must()
    add(@v1, method: "GET", pattern: "", name: "v1_root").must()
    add(@v1, method: "GET", pattern: "/users/:id", name: "v1_user").must()
    mount(router: @api, group: v1).must()
    mount(router: @rt, group: api).must()
    found = route(rt, fixture.request_of(method: "GET", target: "/api/v1/users/3", headers: [])).must()
    assert found.groups == ["api", "v1"] && is_in_group(found, name: "api") && !is_in_group(found, name: "admin")
    assert route(rt, fixture.request_of(method: "GET", target: "/api/v1", headers: [])).must().name == "v1_root"

    for bad in ["", "admin", "/admin/", "/a/*b"]
        match new_group(rt, name: "g", prefix: bad)
            .ok _  => assert false
            .err e => assert e.code == INVALID

    assert new_group(rt, name: "a-b", prefix: "/x").is_err() && !new_group(rt, name: "u", prefix: "/users/:id").is_err()

test "add: a method no token, a pattern with no slash, the same shape twice, a name on two patterns"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/u/:id", name: "u").must()

    match add(@rt, method: "G T", pattern: "/x", name: "x")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match add(@rt, method: "GET", pattern: "x", name: "x")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match add(@rt, method: "GET", pattern: "/u/:other", name: "v")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    match add(@rt, method: "POST", pattern: "/w", name: "u")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    assert rt.routes.len() == 1

test "mount: a conflict adds none of the group's routes"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/g/b", name: "b").must()
    g @= new_group(rt, name: "g", prefix: "/g").must()
    add(@g, method: "GET", pattern: "/a", name: "a").must()
    add(@g, method: "GET", pattern: "/b", name: "b2").must()
    assert mount(router: @rt, group: g).is_err() && rt.routes.len() == 1 && route(rt, fixture.request_of(method: "GET", target: "/g/a", headers: [])).is_err()

test "path_for: escaped values, a wildcard, an unknown name, a missing value"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/users/:id/files/*rest", name: "file").must()
    assert path_for(rt, name: "file", params: [Param(name: "id", value: "a b"), Param(name: "rest", value: "x/y.txt")]).must() == "/users/a%20b/files/x/y.txt"
    assert path_for(rt, name: "nope", params: []).is_err()

    match path_for(rt, name: "file", params: [Param(name: "id", value: "1")])
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

test "allowed_of: none, sorted, every method"
    rt @= new_router()
    add(@rt, method: "POST", pattern: "/a", name: "a").must()
    add_any(@rt, pattern: "/b", name: "b").must()
    assert allowed_of(rt, fixture.request_of(method: "GET", target: "/c", headers: [])).len() == 0
    assert allowed_of(rt, fixture.request_of(method: "GET", target: "/a", headers: [])) == ["OPTIONS", "POST"]
    assert allowed_of(rt, fixture.request_of(method: "GET", target: "/b", headers: [])).len() == 9

test "json_of: a +json type, another type, no type, a body that is no JSON"
    ok_one = http.with_body(
        fixture.request_of(method: "POST", target: "/", headers: []),
        content_type: "application/merge-patch+json; charset=utf-8",
        body: bytes.from_text("{\"a\":1}")
    )
    assert json.int_of(json.member(json_of(ok_one).must(), key: "a").must()).must() == 1

    for kind in ["text/plain", ""]
        match json_of(http.with_body(fixture.request_of(method: "POST", target: "/", headers: []), content_type: kind, body: bytes.from_text("1")))
            .ok _  => assert false
            .err e => assert e.code == INVALID

    assert json_of(
        http.with_body(fixture.request_of(method: "POST", target: "/", headers: []), content_type: "application/json", body: bytes.from_text("{"))
    ).is_err()

test "error_response: text with its line end, JSON with a quote escaped"
    assert http.text_of(error_response(.text, status: 400, message: "bad")).must() == "bad\n"
    j = error_response(.json, status: 409, message: "say \"no\"")
    assert j.status == 409 && http.text_of(j).must() == "{\"message\":\"say \\\"no\\\"\"}" && http.value_of(j.headers, name: "Content-Type").must() == "application/json"

test "render: the HTML mode escapes and is typed HTML, the text mode is typed text, a missing template"
    page = template.parse_html("<p>{{ .name }}</p>").must()
    got = render(200, t: page, name: page.main, value: .object(members: {"name": .text(v: "<b>")})).must()
    assert http.text_of(got).must() == "<p>&lt;b&gt;</p>" && http.value_of(got.headers, name: "Content-Type").must() == "text/html; charset=utf-8"
    plain = template.parse("{{ .name }}").must()
    assert http.value_of(render(200, t: plain, name: plain.main, value: .object(members: {"name": .text(v: "<b>")})).must().headers, name: "Content-Type").must() == "text/plain; charset=utf-8"

    match render(200, t: plain, name: "nope", value: .null_value)
        .ok _  => assert false
        .err e => assert e.code == "not_found"

test "with_disposition: an ASCII name, a name above ASCII, a quote, inline"
    base = http.respond_text(200, text: "x")
    assert http.value_of(with_disposition(base, filename: "a.pdf", download: true).headers, name: "Content-Disposition").must() == "attachment; filename=\"a.pdf\""
    assert http.value_of(with_disposition(base, filename: "café.txt", download: true).headers, name: "Content-Disposition").must() == "attachment; filename=\"caf_.txt\"; filename*=UTF-8''caf%C3%A9.txt"
    assert http.value_of(with_disposition(base, filename: "a\"b", download: false).headers, name: "Content-Disposition").must() == "inline; filename=\"a_b\"; filename*=UTF-8''a%22b"

test "serve_file: a file, HEAD, a folder, nothing, a method refused"
    root = fixture.lay_out()
    file = path.join_all([root, "a.txt"])
    got = serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: []), file: file)
    assert got.status == 200 && http.text_of(got).must() == "hello world"
    assert http.value_of(got.headers, name: "Last-Modified").must() == "Sun, 06 Nov 1994 08:49:37 GMT"
    assert http.value_of(got.headers, name: "Accept-Ranges").must() == "bytes" && http.value_of(got.headers, name: "Content-Type").must() == "text/plain; charset=utf-8"
    assert serve_file(fixture.request_of(method: "HEAD", target: "/a.txt", headers: []), file: file).status == 200
    assert serve_file(fixture.request_of(method: "GET", target: "/", headers: []), file: root).status == 404
    assert serve_file(fixture.request_of(method: "GET", target: "/", headers: []), file: path.join_all([root, "none"])).status == 404
    no = serve_file(fixture.request_of(method: "POST", target: "/a.txt", headers: []), file: file)
    assert no.status == 405 && http.value_of(no.headers, name: "Allow").must() == "GET, HEAD"
    fixture.remove(root)

test "serve_file: ranges as Go answers them, and the whole file for several"
    root = fixture.lay_out()
    file = path.join_all([root, "a.txt"])

    for want in [["bytes=0-4", "206", "hello", "bytes 0-4/11"], ["bytes=-3", "206", "rld", "bytes 8-10/11"], ["bytes=6-", "206", "world", "bytes 6-10/11"], ["bytes=0-100", "206", "hello world", "bytes 0-10/11"], ["bytes=-20", "206", "hello world", "bytes 0-10/11"], ["bytes=20-,0-1", "206", "he", "bytes 0-1/11"], ["bytes=0-1,3-4", "200", "hello world", ""], ["items=0-1", "200", "hello world", ""]]
        got = serve_file(
            fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "Range", value: want[0])]),
            file: file
        )
        assert to_str(got.status) == want[1] && http.text_of(got).must() == want[2] && http.value_of(got.headers, name: "Content-Range").default("") == want[3]

    for bad in ["bytes=20-", "bytes=3-1", "bytes=x", "bytes=-0"]
        got = serve_file(
            fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "Range", value: bad)]),
            file: file
        )
        assert got.status == 416 && http.value_of(got.headers, name: "Content-Range").must() == "bytes */11"

    fixture.remove(root)

test "serve_file: If-Modified-Since, If-Unmodified-Since, If-Range and If-None-Match"
    root = fixture.lay_out()
    file = path.join_all([root, "a.txt"])
    same = "Sun, 06 Nov 1994 08:49:37 GMT"
    older = "Sat, 05 Nov 1994 08:49:37 GMT"
    fresh = serve_file(
        fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-Modified-Since", value: same)]),
        file: file
    )
    assert fresh.status == 304 && fresh.body.len() == 0 && http.value_of(fresh.headers, name: "Last-Modified").must() == same
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-Modified-Since", value: older)]), file: file).status == 200
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-Modified-Since", value: "nonsense")]), file: file).status == 200
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-Unmodified-Since", value: older)]), file: file).status == 412
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "Range", value: "bytes=0-1"), http.Header(name: "If-Range", value: older)]), file: file).status == 200
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "Range", value: "bytes=0-1"), http.Header(name: "If-Range", value: same)]), file: file).status == 206
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-None-Match", value: "*"), http.Header(name: "If-Modified-Since", value: older)]), file: file).status == 304
    assert serve_file(fixture.request_of(method: "GET", target: "/a.txt", headers: [http.Header(name: "If-None-Match", value: "\"x\""), http.Header(name: "If-Modified-Since", value: same)]), file: file).status == 200
    fixture.remove(root)

test "serve_folder: a folder's redirect, its index, its listing, a file named with a slash"
    root = fixture.lay_out()
    f @= default_folder(root)
    sub = serve_folder(
        fixture.request_of(method: "GET", target: "/static/sub?x=1", headers: []),
        folder: f,
        rest: "sub"
    )
    assert sub.status == 301 && http.value_of(sub.headers, name: "Location").must() == "sub/?x=1"
    assert serve_folder(fixture.request_of(method: "GET", target: "/static/sub/", headers: []), folder: f, rest: "sub/").status == 404
    assert http.text_of(serve_folder(fixture.request_of(method: "GET", target: "/static/idx/", headers: []), folder: f, rest: "idx/")).must() == "IDX"
    index = serve_folder(
        fixture.request_of(method: "GET", target: "/static/idx/index.html", headers: []),
        folder: f,
        rest: "idx/index.html"
    )
    assert index.status == 301 && http.value_of(index.headers, name: "Location").must() == "./"
    slash = serve_folder(
        fixture.request_of(method: "GET", target: "/static/a.txt/", headers: []),
        folder: f,
        rest: "a.txt/"
    )
    assert slash.status == 301 && http.value_of(slash.headers, name: "Location").must() == "../a.txt"
    f.listing @ true
    page = http.text_of(
        serve_folder(fixture.request_of(method: "GET", target: "/static/sub/", headers: []), folder: f, rest: "sub/")
    ).must()
    assert page == "<!doctype html>\n<meta name=\"viewport\" content=\"width=device-width\">\n<pre>\n<a href=\"a%20b%26%27.txt\">a b&amp;&#39;.txt</a>\n<a href=\"b.html\">b.html</a>\n<a href=\"dir/\">dir/</a>\n</pre>\n"
    fixture.remove(root)

test "serve_folder: a dot segment, a backslash, a hidden name, a link out, nothing, a method"
    root = fixture.lay_out()
    f @= default_folder(root)

    for rest in ["../outside.txt", "sub/../../outside.txt", ".", "a\\b", ".hidden", "out.txt", "nothing", "sub/nothing"]
        assert serve_folder(fixture.request_of(method: "GET", target: "/static/x", headers: []), folder: f, rest: rest).status == 404

    f.hidden @ true
    assert http.text_of(serve_folder(fixture.request_of(method: "GET", target: "/static/.hidden", headers: []), folder: f, rest: ".hidden")).must() == "s"
    assert serve_folder(fixture.request_of(method: "DELETE", target: "/static/a.txt", headers: []), folder: f, rest: "a.txt").status == 405
    assert http.value_of(serve_folder(fixture.request_of(method: "GET", target: "/static/sub/b.html", headers: []), folder: f, rest: "sub/b.html").headers, name: "Content-Type").must() == "text/html; charset=utf-8"
    fixture.remove(root)

test "before: none goes on with the request, the first answer stops the rest"
    r = fixture.request_of(
        method: "POST",
        target: "/",
        headers: [http.Header(name: "X-HTTP-Method-Override", value: "put")]
    )

    match before(r, steps: [])
        .go_on g  => assert g.request == r
        .answer _ => assert false

    match before(r, steps: [override_method, override_method])
        .go_on g  => assert g.request.method == "PUT"
        .answer _ => assert false

test "after: none answers the response as it is"
    response = http.respond_status(204)
    assert after(fixture.request_of(method: "GET", target: "/", headers: []), response: response, steps: []) == response

test "limit_body: at the limit, past it, an empty body and a limit of 0"
    r = http.with_text(fixture.request_of(method: "POST", target: "/", headers: []), text: "four")

    match limit_body(r, most_bytes: 4)
        .go_on _  => _ = 0
        .answer _ => assert false

    match limit_body(r, most_bytes: 3)
        .go_on _  => assert false
        .answer a => assert a.response.status == 413

    match limit_body(fixture.request_of(method: "GET", target: "/", headers: []), most_bytes: 0)
        .go_on _  => _ = 0
        .answer _ => assert false

test "require_basic: none, wrong credentials, the right ones, a field that does not read"
    refused: [[http.Header]] = [
        []
        [http.Header(name: "Authorization", value: "Basic " + bytes.format_base64(bytes.from_text("alice:x")))]
        [http.Header(name: "Authorization", value: "Basic !!!")]
    ]

    for header in refused
        match require_basic(fixture.request_of(method: "GET", target: "/", headers: header), realm: "admin", accepts: fixture.is_alice)
            .go_on _  => assert false
            .answer a => assert a.response.status == 401 && http.value_of(a.response.headers, name: "WWW-Authenticate").must() == "Basic realm=\"admin\", charset=\"UTF-8\""

    right = http.with_basic_auth(
        fixture.request_of(method: "GET", target: "/", headers: []),
        user: "alice",
        password: "secret"
    )

    match require_basic(right, realm: "admin", accepts: fixture.is_alice)
        .go_on _  => _ = 0
        .answer _ => assert false

test "require_bearer: none, another scheme, a malformed token, a refused one, the right one"
    cases = [
        ["", "401", "Bearer realm=\"api\""]
        ["Basic YTpi", "401", "Bearer realm=\"api\""]
        ["Bearer a b", "400", "Bearer realm=\"api\", error=\"invalid_request\""]
        ["Bearer bad", "401", "Bearer realm=\"api\", error=\"invalid_token\""]
    ]

    for c in cases
        headers: [http.Header] @= []

        if c[0] != ""
            headers @ [http.Header(name: "Authorization", value: c[0])]

        match require_bearer(fixture.request_of(method: "GET", target: "/", headers: headers), realm: "api", accepts: fixture.is_good_token)
            .go_on _  => assert false
            .answer a => assert to_str(a.response.status) == c[1] && http.value_of(a.response.headers, name: "WWW-Authenticate").must() == c[2]

    match require_bearer(http.with_bearer_auth(fixture.request_of(method: "GET", target: "/", headers: []), token: "good-token"), realm: "api", accepts: fixture.is_good_token)
        .go_on _  => _ = 0
        .answer _ => assert false

test "challenge_bearer: insufficient scope is 403, a realm's quote escaped"
    got = challenge_bearer(realm: "a\"b", error: "insufficient_scope")
    assert got.status == 403 && http.value_of(got.headers, name: "WWW-Authenticate").must() == "Bearer realm=\"a\\\"b\", error=\"insufficient_scope\""

test "preflight: an allowed origin, one refused, a request that is no preflight, the fields asked"
    c = default_cors(["https://a.example"])
    asking = [
        http.Header(name: "Origin", value: "https://a.example")
        http.Header(name: "Access-Control-Request-Method", value: "PUT")
        http.Header(name: "Access-Control-Request-Headers", value: "X-Token")
    ]

    match preflight(fixture.request_of(method: "OPTIONS", target: "/x", headers: asking), cors: c)
        .go_on _ => assert false
        .answer a =>
            h = a.response.headers
            assert a.response.status == 204 && http.value_of(h, name: "Access-Control-Allow-Origin").must() == "https://a.example"
            assert http.value_of(h, name: "Access-Control-Allow-Methods").must() == "GET, HEAD, PUT, PATCH, POST, DELETE"
            assert http.value_of(h, name: "Access-Control-Allow-Headers").must() == "X-Token" && !http.has_header(h, name: "Access-Control-Max-Age")

    other = [
        http.Header(name: "Origin", value: "https://b.example")
        http.Header(name: "Access-Control-Request-Method", value: "PUT")
    ]

    match preflight(fixture.request_of(method: "OPTIONS", target: "/x", headers: other), cors: c)
        .go_on _  => assert false
        .answer a => assert !http.has_header(a.response.headers, name: "Access-Control-Allow-Origin") && http.has_header(a.response.headers, name: "Vary")

    match preflight(fixture.request_of(method: "OPTIONS", target: "/x", headers: [http.Header(name: "Origin", value: "https://a.example")]), cors: c)
        .go_on _  => _ = 0
        .answer _ => assert false

test "with_cors: no origin, every origin, credentials, exposed fields, a refused origin"
    response = http.respond_text(200, text: "x")
    from_a = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Origin", value: "https://a.example")]
    )
    assert with_cors(fixture.request_of(method: "GET", target: "/", headers: []), response: response, cors: default_cors(["*"])) == response
    every = with_cors(from_a, response: response, cors: default_cors(["*"]))
    assert http.value_of(every.headers, name: "Access-Control-Allow-Origin").must() == "*" && !http.has_header(every.headers, name: "Vary")
    c @= default_cors(["*"])
    c.credentials @ true
    c.exposed @ ["X-Total"]
    both = with_cors(from_a, response: response, cors: c)
    assert http.value_of(both.headers, name: "Access-Control-Allow-Origin").must() == "https://a.example" && http.value_of(both.headers, name: "Access-Control-Allow-Credentials").must() == "true"
    assert http.value_of(both.headers, name: "Access-Control-Expose-Headers").must() == "X-Total" && http.value_of(both.headers, name: "Vary").must() == "Origin"
    refused = with_cors(from_a, response: response, cors: default_cors(["https://b.example"]))
    assert !http.has_header(refused.headers, name: "Access-Control-Allow-Origin") && http.value_of(refused.headers, name: "Vary").must() == "Origin"

test "with_request_id: one kept, one too long or with a space replaced, none made"
    kept = with_request_id(
        fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "X-Request-Id", value: "abc-1")])
    ).must()
    assert http.value_of(kept.headers, name: "X-Request-Id").must() == "abc-1"

    for bad in ["a b", "x".repeat(to_u64(129).must())]
        made = with_request_id(
            fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "X-Request-Id", value: bad)])
        ).must()
        assert http.value_of(made.headers, name: "X-Request-Id").must().len() == 36 && http.values_of(made.headers, name: "X-Request-Id").len() == 1

    assert uuid.parse(http.value_of(with_request_id(fixture.request_of(method: "GET", target: "/", headers: [])).must().headers, name: "X-Request-Id").must()).must().high > 0

test "copy_request_id: copied, and nothing where the request has none"
    response = http.respond_status(204)
    assert copy_request_id(fixture.request_of(method: "GET", target: "/", headers: []), response: response) == response

test "log_request: info below 500, error from 500, the id where there is one"
    two @= net.pair(deadline_ms: 5_000).must()
    logger = log.with_clock(log.to(two.first.stream), clock: fixture.clock)
    r @= fixture.request_of(method: "GET", target: "/a?b=1", headers: [http.Header(name: "X-Request-Id", value: "r1")])
    r.remote @ "192.0.2.1:5000"
    log_request(logger, r: r, response: http.respond_text(200, text: "four"), started: fixture.started()).must()
    log_request(
        logger,
        r: fixture.request_of(method: "POST", target: "/", headers: []),
        response: http.respond_status(503),
        started: fixture.started()
    ).must()
    reader @= io.reader(two.second.stream)
    assert io.read_line(@reader).must() == "1994-11-06T08:49:37.000Z INFO request method=GET path=\"/a?b=1\" status=200 bytes=4 milliseconds=250 remote=192.0.2.1:5000 id=r1"
    assert io.read_line(@reader).must() == "1994-11-06T08:49:37.000Z ERROR request method=POST path=/ status=503 bytes=0 milliseconds=250 remote=\"\""
    io.close(@two.first.stream).must()
    io.close(@reader.stream).must()

test "recover: a response passed on, a failure answered 500 and logged, its message kept from the client"
    two @= net.pair(deadline_ms: 5_000).must()
    logger = log.with_clock(log.to(two.first.stream), clock: fixture.clock)
    r = fixture.request_of(method: "GET", target: "/x", headers: [])
    fine: http.Response? = ok(http.respond_status(204))
    assert recover(logger, r: r, answer: fine, form: .text).status == 204
    broken: http.Response? = fail(code: "failed", msg: "the database is gone")
    got = recover(logger, r: r, answer: broken, form: .json)
    assert got.status == 500 && http.text_of(got).must() == "{\"message\":\"Internal Server Error\"}"
    reader @= io.reader(two.second.stream)
    assert io.read_line(@reader).must() == "1994-11-06T08:49:37.000Z ERROR handler failed method=GET path=/x code=failed failure=\"the database is gone\""
    io.close(@two.first.stream).must()
    io.close(@reader.stream).must()

test "gzip: compressed where accepted, Vary alone where not, a short body, 204, an encoding there already"
    body = "hello hello hello hello hello hello"
    response = http.respond_text(200, text: body)
    accepting = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Accept-Encoding", value: "br, gzip")]
    )
    packed = gzip(accepting, response: response, min_bytes: 10)
    assert http.value_of(packed.headers, name: "Content-Encoding").must() == "gzip" && http.value_of(packed.headers, name: "Vary").must() == "Accept-Encoding"
    assert bytes.to_text(compress.decompress(packed.body, format: .gzip, limit: 1_000).must()).must() == body
    plain = gzip(fixture.request_of(method: "GET", target: "/", headers: []), response: response, min_bytes: 10)
    assert plain.body == response.body && http.value_of(plain.headers, name: "Vary").must() == "Accept-Encoding"
    assert gzip(accepting, response: response, min_bytes: 1_000) == response
    assert gzip(accepting, response: http.respond_status(204), min_bytes: 0) == http.respond_status(204)
    coded @= response
    coded.headers @ http.with_header(coded.headers, name: "Content-Encoding", value: "br")
    assert gzip(accepting, response: coded, min_bytes: 0) == coded

test "gunzip_body: decompressed, past the limit, no gzip, another coding, identity"
    data = compress.compress(bytes.from_text("hello"), options: compress.default_options(.gzip)).must()
    sent @= http.with_body(
        fixture.request_of(method: "POST", target: "/", headers: []),
        content_type: "text/plain",
        body: data
    )
    sent.headers @ http.with_header(sent.headers, name: "Content-Encoding", value: "gzip")

    match gunzip_body(sent, most_bytes: 100)
        .go_on g  => assert g.request.body == bytes.from_text("hello") && !http.has_header(g.request.headers, name: "Content-Encoding")
        .answer _ => assert false

    match gunzip_body(sent, most_bytes: 2)
        .go_on _  => assert false
        .answer a => assert a.response.status == 413

    broken @= sent
    broken.body @ bytes.from_text("nope")

    match gunzip_body(broken, most_bytes: 100)
        .go_on _  => assert false
        .answer a => assert a.response.status == 400

    other @= sent
    other.headers @ http.with_header(sent.headers, name: "Content-Encoding", value: "br")

    match gunzip_body(other, most_bytes: 100)
        .go_on _  => assert false
        .answer a => assert a.response.status == 415 && http.value_of(a.response.headers, name: "Accept-Encoding").must() == "gzip"

    match gunzip_body(fixture.request_of(method: "POST", target: "/", headers: [http.Header(name: "Content-Encoding", value: "identity")]), most_bytes: 0)
        .go_on _  => _ = 0
        .answer _ => assert false

test "refuse_cross_origin: as Go's CrossOriginProtection answers"
    cases = [
        ["GET", "", "go"]
        ["POST", "", "go"]
        ["POST", "Sec-Fetch-Site: same-origin", "go"]
        ["POST", "Sec-Fetch-Site: none", "go"]
        ["POST", "Sec-Fetch-Site: cross-site", "refuse"]
        ["POST", "Sec-Fetch-Site: same-site", "refuse"]
        ["POST", "Origin: http://example.com", "go"]
        ["POST", "Origin: https://example.com", "go"]
        ["POST", "Origin: http://other.com", "refuse"]
        ["POST", "Origin: https://trusted.example", "go"]
        ["HEAD", "Sec-Fetch-Site: cross-site", "go"]
        ["OPTIONS", "Sec-Fetch-Site: cross-site", "go"]
        ["DELETE", "Origin: null", "refuse"]
        ["PUT", "Origin: http://EXAMPLE.com", "refuse"]
    ]

    for c in cases
        headers: [http.Header] @= [http.Header(name: "Host", value: "example.com")]

        if c[1] != ""
            pair = strings.split_once(s: c[1], sep: ": ").must()
            headers @ headers.push(http.Header(name: pair.before, value: pair.after))

        match refuse_cross_origin(fixture.request_of(method: c[0], target: "/x", headers: headers), trusted: ["https://trusted.example"])
            .go_on _  => assert c[2] == "go"
            .answer a => assert c[2] == "refuse" && a.response.status == 403

    both = [
        http.Header(name: "Host", value: "example.com")
        http.Header(name: "Sec-Fetch-Site", value: "cross-site")
        http.Header(name: "Origin", value: "https://trusted.example")
    ]

    match refuse_cross_origin(fixture.request_of(method: "POST", target: "/x", headers: both), trusted: ["https://trusted.example"])
        .go_on _  => _ = 0
        .answer _ => assert false

test "require_type: a type read, its parameters set aside, another refused, no body"
    r = http.with_body(
        fixture.request_of(method: "POST", target: "/", headers: []),
        content_type: "Application/JSON; charset=utf-8",
        body: [49]
    )

    match require_type(r, types: ["application/json"])
        .go_on _  => _ = 0
        .answer _ => assert false

    match require_type(r, types: ["text/csv"])
        .go_on _  => assert false
        .answer a => assert a.response.status == 415

    match require_type(fixture.request_of(method: "POST", target: "/", headers: []), types: [])
        .go_on _  => _ = 0
        .answer _ => assert false

test "override_method: another method, no field, a method refused"
    put = fixture.request_of(
        method: "PUT",
        target: "/",
        headers: [http.Header(name: "X-HTTP-Method-Override", value: "DELETE")]
    )

    match override_method(put)
        .go_on g  => assert g.request.method == "PUT"
        .answer _ => assert false

    match override_method(fixture.request_of(method: "POST", target: "/", headers: [http.Header(name: "X-HTTP-Method-Override", value: "GET")]))
        .go_on _  => assert false
        .answer a => assert a.response.status == 400

test "serve_stream: what is no request answered 400, then the stream ends"
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(two.first.stream, text: "nonsense\r\n\r\n").must()
    assert serve_stream(http.default_server(), stream: two.second.stream, remote: "", router: new_router(), handler: not_routed) == 0
    reader @= io.reader(two.first.stream)
    got = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    assert got.status == 400 && got.closing
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_stream: a body past the limits answered 413"
    small @= http.default_server()
    small.limits.body_bytes @ 2
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(two.first.stream, text: "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello").must()
    assert serve_stream(small, stream: two.second.stream, remote: "", router: new_router(), handler: not_routed) == 0
    reader @= io.reader(two.first.stream)
    assert http.read_response(@reader, method: "POST", limits: http.default_limits()).must().status == 413
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_stream: a head past the limits 431, an expectation 417, a version 505, a coding 501, each as http answers"
    small @= http.default_server()
    small.limits.head_bytes @ 60
    given = [
        ["GET / HTTP/1.1\r\nHost: h\r\nX-Long: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n\r\n", "431"]
        ["GET / HTTP/1.1\r\nExpect: magic\r\n\r\n", "417"]
        ["GET / HTTP/3.0\r\n\r\n", "505"]
        ["GET / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n", "501"]
    ]

    for g in given
        two @= net.pair(deadline_ms: 5_000).must()
        io.write_text(two.first.stream, text: g[0]).must()
        assert serve_stream(small, stream: two.second.stream, remote: "", router: new_router(), handler: not_routed) == 0
        reader @= io.reader(two.first.stream)
        assert to_str(http.read_response(@reader, method: "GET", limits: http.default_limits()).must().status) == g[1]
        io.close(@two.second.stream).must()
        io.close(@reader.stream).must()

test "serve_stream: Expect 100-continue answered 100 before the body, HTTP/1.0 kept alive where it asks"
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "POST /a HTTP/1.1\r\nHost: h\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nhiGET /b HTTP/1.0\r\nConnection: keep-alive\r\n\r\nGET /c HTTP/1.0\r\n\r\n"
    ).must()
    assert serve_stream(http.default_server(), stream: two.second.stream, remote: "", router: new_router(), handler: not_routed) == 3
    reader @= io.reader(two.first.stream)
    assert io.read_line(@reader).must() == "HTTP/1.1 100 Continue"
    _ = io.read_line(@reader).must()
    assert http.read_response(@reader, method: "POST", limits: http.default_limits()).must().status == 404
    kept = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    assert http.value_of(kept.headers, name: "Connection").must() == "keep-alive"
    assert http.read_response(@reader, method: "GET", limits: http.default_limits()).must().closing
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "with_secure_cookie and secure_cookie_of: read back, Max-Age and Expires written, refused after its end, past the size refused"
    now = fixture.clock().must()
    options = default_cookie_options("s", ring: fixture.ring())
    written = with_secure_cookie(http.respond_status(http.STATUS_OK), options: options, value: "v", now: now).must()
    field = http.value_of(written.headers, name: "Set-Cookie").must()
    assert strings.contains(s: field, substr: "; Max-Age=2592000") && strings.contains(s: field, substr: "Expires=") && strings.contains(s: field, substr: "Secure; HttpOnly; SameSite=Lax")
    cookie = http.parse_set_cookie(field, now: now).must()
    r = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: f"s={cookie.value}")]
    )
    assert secure_cookie_of(r, options: options, now: now).must() == "v"
    later = time.add(now, d: time.seconds(2_592_000).must()).must()
    assert secure_cookie_of(r, options: options, now: later).is_err()
    assert with_secure_cookie(
        http.respond_status(http.STATUS_OK),
        options: options,
        value: "x".repeat(4096),
        now: now
    ).is_err()

test "secure_cookie_of: no cookie not_found, a cookie of another key or name invalid, a rotated key read"
    now = fixture.clock().must()
    options = default_cookie_options("s", ring: fixture.ring())
    none = fixture.request_of(method: "GET", target: "/", headers: [])

    match secure_cookie_of(none, options: options, now: now)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    by_second = sign_value(
        [fixture.ring()[1]],
        name: "s",
        value: "old",
        expires: time.add(now, d: time.seconds(60).must()).must()
    )
    old = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: f"s={by_second}")]
    )
    assert secure_cookie_of(old, options: options, now: now).must() == "old"
    other = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: f"t={by_second}; s=x.1.y")]
    )

    match secure_cookie_of(other, options: options, now: now)
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "session_of and with_session: values of more than one byte read back, a cookie that is no session refused"
    now = fixture.clock().must()
    options = default_cookie_options("session", ring: fixture.ring())
    s @= new_session()
    s.values["user"] @ "zoë"
    s.values["n"] @ ""
    written = with_session(http.respond_status(http.STATUS_OK), session: s, options: options, now: now).must()
    cookie = http.parse_set_cookie(http.value_of(written.headers, name: "Set-Cookie").must(), now: now).must()
    r = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: f"session={cookie.value}")]
    )
    got = session_of(r, options: options, now: now).must()
    assert !got.is_new && got.values["user"].must() == "zoë" && got.values["n"].must() == "" && keys(got.values) == ["user", "n"]
    plain = sign_value(
        fixture.ring(),
        name: "session",
        value: "[1]",
        expires: time.add(now, d: time.seconds(60).must()).must()
    )
    bad = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: f"session={plain}")]
    )

    match session_of(bad, options: options, now: now)
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "without_cookie: an empty value, Max-Age=0, an end in 1970"
    got = without_cookie(
        http.respond_status(http.STATUS_OK),
        options: default_cookie_options("s", ring: fixture.ring())
    )
    field = http.value_of(got.headers, name: "Set-Cookie").must()
    assert strings.has_prefix(s: field, prefix: "s=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT") && strings.has_suffix(s: field, suffix: "; Max-Age=0")

test "seal_value and open_value through the face: read back before its end and refused at it, where the platform seals"
    now = fixture.clock().must()
    later = time.add(now, d: time.seconds(60).must()).must()

    if !seal.is_available(.aes_256_gcm)
        skip_test(reason: "this platform's cryptography offers no AES-256-GCM to seal")
    k @= seal.generate(.aes_256_gcm).must()
    sealed = seal_value([k], name: "s", value: "secret", expires: later).must()
    assert open_value([k], name: "s", sealed: sealed, now: now).must() == "secret" && open_value([k], name: "s", sealed: sealed, now: later).is_err()
    seal.close(@k).must()

test "check_csrf: safe methods go on; a POST with no token, a wrong one and a right one by field, header and multipart"
    secret = new_csrf_secret().must()
    get = fixture.request_of(method: "GET", target: "/", headers: [])
    assert check_csrf(get, secret: secret) == .go_on(request: get)
    bare = fixture.request_of(method: "POST", target: "/", headers: [])

    match check_csrf(bare, secret: secret)
        .go_on _  => assert false
        .answer a => assert a.response.status == http.STATUS_FORBIDDEN && http.text_of(a.response).must() == "CSRF token missing.\n"

    wrong = http.with_form(bare, pairs: [url.Pair(key: CSRF_FIELD, value: mask_csrf(new_csrf_secret().must()).must())])

    match check_csrf(wrong, secret: secret)
        .go_on _  => assert false
        .answer a => assert http.text_of(a.response).must() == "CSRF token incorrect.\n"

    by_form = http.with_form(
        bare,
        pairs: [url.Pair(key: "a", value: "1"), url.Pair(key: CSRF_FIELD, value: mask_csrf(secret).must())]
    )
    assert check_csrf(by_form, secret: secret) == .go_on(request: by_form)
    by_header = fixture.request_of(
        method: "DELETE",
        target: "/",
        headers: [http.Header(name: CSRF_HEADER, value: mask_csrf(secret).must())]
    )
    assert check_csrf(by_header, secret: secret) == .go_on(request: by_header)
    by_part = http.with_multipart(
        bare,
        parts: [http.Part(name: CSRF_FIELD, filename: "", content_type: "", data: bytes.from_text(mask_csrf(secret).must()))]
    )
    assert check_csrf(by_part, secret: secret) == .go_on(request: by_part)

test "csrf_secret: made once and kept in the session"
    s @= new_session()
    first = csrf_secret(@s).must()
    assert csrf_secret(@s).must() == first && s.values[CSRF_KEY].must() == first

test "minimal_security_headers: the three written, one the response has kept, nothing else"
    held @= http.respond_status(200)
    held.headers @ [http.Header(name: "X-Frame-Options", value: "DENY")]
    got = with_security_headers(held, headers: minimal_security_headers())
    assert http.value_of(got.headers, name: "X-Frame-Options").must() == "DENY" && http.value_of(got.headers, name: "X-Content-Type-Options").must() == "nosniff" && got.headers.len() == 3
    assert http.value_of(got.headers, name: "Referrer-Policy").must() == "strict-origin-when-cross-origin"

test "with_security_headers: every field written where none stands, a handler's own kept, an empty one not written"
    own @= http.respond_text(http.STATUS_OK, text: "x")
    own.headers @ own.headers.push(http.Header(name: "X-Frame-Options", value: "DENY"))
    got = with_security_headers(own, headers: default_security_headers())
    assert http.value_of(got.headers, name: "X-Frame-Options").must() == "DENY" && http.values_of(got.headers, name: "X-Frame-Options").len() == 1
    assert http.value_of(got.headers, name: "Strict-Transport-Security").must() == "max-age=31536000; includeSubDomains"
    assert http.value_of(got.headers, name: "X-XSS-Protection").must() == "0" && !http.has_header(got.headers, name: "Permissions-Policy")
    assert got.headers.len() == own.headers.len() + 11

test "format_hsts: forgetting, every part, and none"
    assert format_hsts(max_age: time.nanoseconds(0), subdomains: false, preload: false) == "max-age=0"
    assert format_hsts(max_age: time.hours(17520).must(), subdomains: true, preload: true) == "max-age=63072000; includeSubDomains; preload"

test "trusted_networks: addresses and networks of both families, a mapped address, what reads as neither"
    got = trusted_networks(["10.0.0.1", "::1", "192.168.0.0/16", "fd00::/8", "::ffff:10.0.0.2"]).must()
    assert got.len() == 5 && net.format_network(got[0]) == "10.0.0.1/32" && net.format_network(got[1]) == "::1/128"
    assert net.format_network(got[4]) == "10.0.0.2/32" && trusted_networks([]).must().len() == 0

    for bad in [["x"], ["10.0.0.0/33"], [""]]
        assert trusted_networks(bad).is_err()

test "forwarded_of: no remote, an untrusted peer's fields ignored, X-Forwarded-For walked, Forwarded preferred, every hop trusted"
    trusted = trusted_networks(["10.0.0.0/8", "127.0.0.1"]).must()
    r @= fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Host", value: "inner"), http.Header(name: "X-Forwarded-For", value: "1.1.1.1, 203.0.113.7, 10.0.0.5"), http.Header(name: "X-Forwarded-Proto", value: "HTTPS"), http.Header(name: "X-Forwarded-Host", value: "a.test, example.com")]
    )
    assert forwarded_of(r, trusted: trusted) == Forwarded(address: "", scheme: "", host: "inner", proxies: 0)
    r.remote @ "198.51.100.9:4000"
    assert forwarded_of(r, trusted: trusted) == Forwarded(address: "198.51.100.9", scheme: "", host: "inner", proxies: 0)
    r.remote @ "10.0.0.2:4000"
    assert forwarded_of(r, trusted: trusted) == Forwarded(address: "203.0.113.7", scheme: "https", host: "example.com", proxies: 2)
    assert forwarded_of(r, trusted: []).address == "10.0.0.2"
    both @= r
    both.headers @ both.headers.push(
        http.Header(name: "Forwarded", value: "for=192.0.2.43;proto=http;host=f.test, for=\"[2001:db8::7]:99\";proto=https")
    )
    assert forwarded_of(both, trusted: trusted) == Forwarded(address: "2001:db8::7", scheme: "https", host: "inner", proxies: 1)
    every @= r
    every.headers @ [http.Header(name: "X-Forwarded-For", value: "10.9.9.9, 10.0.0.5")]
    assert forwarded_of(every, trusted: trusted) == Forwarded(address: "10.9.9.9", scheme: "", host: "", proxies: 2)
    empty @= r
    empty.headers @ [http.Header(name: "X-Forwarded-For", value: " , ")]
    assert forwarded_of(empty, trusted: trusted).address == "10.0.0.2"

test "etag_of: strong and weak, the empty body's, Python's SHA-256 cut to 16 bytes"
    assert etag_of([], weak: false) == "\"e3b0c44298fc1c149afbf4c8996fb924\"" && etag_of([], weak: true) == "W/\"e3b0c44298fc1c149afbf4c8996fb924\""

test "with_etag: a tag added and a 304 for its copy, a tag of the handler's kept, a POST and a 404 left alone, If-Modified-Since"
    get = fixture.request_of(method: "GET", target: "/", headers: [])
    tagged = with_etag(get, response: http.respond_text(http.STATUS_OK, text: "hello"))
    tag = http.value_of(tagged.headers, name: "ETag").must()
    assert tagged.status == 200 && tag == etag_of(bytes.from_text("hello"), weak: false)
    again = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "If-None-Match", value: "W/" + tag)]
    )
    assert with_etag(again, response: http.respond_text(http.STATUS_OK, text: "hello")).status == http.STATUS_NOT_MODIFIED
    assert with_etag(again, response: http.respond_text(http.STATUS_OK, text: "changed")).status == http.STATUS_OK
    post = fixture.request_of(method: "POST", target: "/", headers: [http.Header(name: "If-None-Match", value: "*")])
    assert !http.has_header(with_etag(post, response: http.respond_text(http.STATUS_OK, text: "x")).headers, name: "ETag")
    assert with_etag(again, response: http.respond_status(http.STATUS_NOT_FOUND)).status == http.STATUS_NOT_FOUND
    dated @= http.respond_text(http.STATUS_OK, text: "x")
    dated.headers @ [
        http.Header(name: "ETag", value: "\"mine\"")
        http.Header(name: "Last-Modified", value: "Sun, 06 Nov 1994 08:49:37 GMT")
    ]
    since = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "If-Modified-Since", value: "Sun, 06 Nov 1994 08:49:37 GMT")]
    )
    assert with_etag(since, response: dated).status == http.STATUS_NOT_MODIFIED
    older = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "If-Modified-Since", value: "Sun, 06 Nov 1994 08:49:36 GMT")]
    )
    assert with_etag(older, response: dated).status == http.STATUS_OK
    both = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "If-None-Match", value: "\"other\""), http.Header(name: "If-Modified-Since", value: "Sun, 06 Nov 1994 08:49:37 GMT")]
    )
    assert with_etag(both, response: dated).status == http.STATUS_OK

test "require_acceptable: no Accept goes on, an accepted type goes on, none answered 406"
    none = fixture.request_of(method: "GET", target: "/", headers: [])
    assert require_acceptable(none, offered: ["application/json"]) == .go_on(request: none)
    image = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "Accept", value: "image/*")])

    match require_acceptable(image, offered: ["application/json", "text/html"])
        .go_on _  => assert false
        .answer a => assert a.response.status == http.STATUS_NOT_ACCEPTABLE && http.text_of(a.response).must() == "this route answers application/json, text/html, none of which the request accepts\n"

test "exchange: a route's 405 with its Allow, a refusal before the handler"
    rt @= new_router()
    add(@rt, method: "GET", pattern: "/a", name: "a").must()
    got = exchange(
        fixture.request_of(method: "POST", target: "/a", headers: []),
        router: rt,
        handler: not_routed
    ).must()
    assert got.status == http.STATUS_METHOD_NOT_ALLOWED && http.value_of(got.headers, name: "Allow").must() == "GET, HEAD, OPTIONS"
    refused = exchange(
        fixture.request_of(method: "GET", target: "/a", headers: [http.Header(name: "Expect", value: "x")]),
        router: rt,
        handler: not_routed
    ).must()
    assert refused.status == http.STATUS_EXPECTATION_FAILED && refused.closing

test "health_response: all passed and quiet, the code and the cache said"
    r = fixture.request_of(method: http.METHOD_GET, target: "/healthz", headers: [])
    got = health_response(r, checks: [Check(name: "db", outcome: ok())], detail: false)
    assert got.status == 200
    assert bytes.to_text(got.body).must() == "ok\n"
    assert http.value_of(got.headers, name: "Cache-Control").must() == "no-store"
    assert http.value_of(got.headers, name: "Content-Type").must() == "text/plain; charset=utf-8"
    none: [Check] = []
    assert health_response(r, checks: none, detail: false).status == 200

test "health_response: a failure answered 503, its message withheld or written, and verbose"
    checks = [Check(name: "db", outcome: ok()), Check(name: "disk", outcome: fail(code: "failed", msg: "disk full"))]
    r = fixture.request_of(method: http.METHOD_GET, target: "/readyz", headers: [])
    withheld = health_response(r, checks: checks, detail: false)
    assert withheld.status == 503
    assert bytes.to_text(withheld.body).must() == "[+]db ok\n[-]disk failed: reason withheld\nhealth check failed\n"
    told = health_response(r, checks: checks, detail: true)
    assert bytes.to_text(told.body).must() == "[+]db ok\n[-]disk failed: disk full\nhealth check failed\n"
    verbose = fixture.request_of(method: http.METHOD_GET, target: "/livez?verbose", headers: [])
    assert bytes.to_text(health_response(verbose, checks: [checks[0]], detail: false).body).must() == "[+]db ok\nhealth check passed\n"

test "health_response: JSON where the Accept asks it, text where it asks text or nothing it offers"
    checks = [Check(name: "disk", outcome: fail(code: "failed", msg: "full"))]
    wants_json = fixture.request_of(
        method: http.METHOD_GET,
        target: "/healthz",
        headers: [http.Header(name: "Accept", value: "application/json")]
    )
    got = health_response(wants_json, checks: checks, detail: true)
    assert http.value_of(got.headers, name: "Content-Type").must() == "application/health+json"
    assert bytes.to_text(got.body).must() == "{\"status\":\"fail\",\"checks\":{\"disk\":[{\"status\":\"fail\",\"output\":\"full\"}]}}"
    wants_image = fixture.request_of(
        method: http.METHOD_GET,
        target: "/healthz",
        headers: [http.Header(name: "Accept", value: "image/png")]
    )
    assert bytes.to_text(health_response(wants_image, checks: checks, detail: false).body).must() == "[-]disk failed: reason withheld\nhealth check failed\n"

test "webhook_signature: the Standard Webhooks libraries' test vector, a secret without its prefix, and one that does not read"
    payload = bytes.from_text("{\"test\": 2432232314}")
    want = "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
    assert webhook_signature(secret: "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw", id: "msg_p5jXN8AQM9LWM0D4loKWxJek", sent: time.from_unix(whole_seconds: 1614265330, extra_nanoseconds: 0).must(), payload: payload).must() == want
    assert webhook_signature(secret: "MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw", id: "msg_p5jXN8AQM9LWM0D4loKWxJek", sent: time.from_unix(whole_seconds: 1614265330, extra_nanoseconds: 0).must(), payload: payload).must() == want

    match webhook_signature(secret: "whsec_%%", id: "m", sent: time.from_unix(whole_seconds: 0, extra_nanoseconds: 0).must(), payload: payload)
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "verify_webhook: signed and verified, a rotated secret, the tolerance's edges, and what is refused"
    old_secret = "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
    new_secret = new_webhook_secret().must()
    assert new_secret.len() == 6 + 44
    sent = time.from_unix(whole_seconds: 1614265330, extra_nanoseconds: 0).must()
    payload = bytes.from_text("{\"a\":1}")
    headers = sign_webhook(secret: old_secret, id: "msg_1", sent: sent, payload: payload).must()
    assert verify_webhook(headers, payload: payload, secrets: [new_secret, old_secret], now: sent, tolerance: default_webhook_tolerance()).must() == "msg_1"
    late = time.from_unix(whole_seconds: 1614265330 + 300, extra_nanoseconds: 0).must()
    early = time.from_unix(whole_seconds: 1614265330 - 300, extra_nanoseconds: 0).must()
    assert verify_webhook(headers, payload: payload, secrets: [old_secret], now: late, tolerance: time.minutes(5).must()).must() == "msg_1"
    assert verify_webhook(headers, payload: payload, secrets: [old_secret], now: early, tolerance: time.minutes(5).must()).must() == "msg_1"
    too_late = time.from_unix(whole_seconds: 1614265330 + 301, extra_nanoseconds: 0).must()
    too_early = time.from_unix(whole_seconds: 1614265330 - 301, extra_nanoseconds: 0).must()
    two = [
        http.Header(name: "Webhook-Id", value: "msg_1")
        http.Header(name: "webhook-timestamp", value: "1614265330")
        http.Header(name: "webhook-signature", value: "v1a,x v1,AAAA " + http.value_of(headers, name: "webhook-signature").must())
    ]
    assert verify_webhook(two, payload: payload, secrets: [old_secret], now: sent, tolerance: time.minutes(5).must()).must() == "msg_1"
    refused = [
        verify_webhook(headers, payload: payload, secrets: [old_secret], now: too_late, tolerance: time.minutes(5).must())
        verify_webhook(headers, payload: payload, secrets: [old_secret], now: too_early, tolerance: time.minutes(5).must())
        verify_webhook(headers, payload: bytes.from_text("{\"a\":2}"), secrets: [old_secret], now: sent, tolerance: time.minutes(5).must())
        verify_webhook(headers, payload: payload, secrets: [new_secret], now: sent, tolerance: time.minutes(5).must())
        verify_webhook([headers[0], headers[1]], payload: payload, secrets: [old_secret], now: sent, tolerance: time.minutes(5).must())
        verify_webhook([headers[0], headers[1], http.Header(name: "webhook-signature", value: "v1a,abc")], payload: payload, secrets: [old_secret], now: sent, tolerance: time.minutes(5).must())
        verify_webhook([headers[0], http.Header(name: "webhook-timestamp", value: "+1614265330"), headers[2]], payload: payload, secrets: [old_secret], now: sent, tolerance: time.minutes(5).must())
        verify_webhook(headers, payload: payload, secrets: ["whsec_"], now: sent, tolerance: time.minutes(5).must())
    ]

    for one in refused
        match one
            .ok _  => assert false
            .err e => assert e.code == INVALID

## Examples

# An empty router, whose errors are text.
test "new_router: no route, no prefix"
    rt = new_router()
    assert rt.routes.len() == 0 && rt.prefix == "" && rt.errors == .text

# A group under `/admin`, its routes mounted into the router it came from.
test "new_group: an admin group mounted"
    rt @= new_router()
    admin @= new_group(rt, name: "admin", prefix: "/admin").must()
    add(@admin, method: http.METHOD_GET, pattern: "/users", name: "admin_users").must()
    mount(router: @rt, group: admin).must()
    assert rt.routes[0].pattern == "/admin/users" && rt.routes[0].groups == ["admin"]

# A route named for the program's dispatch.
test "add: a route of GET with a parameter"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/users/:id", name: "user").must()
    assert rt.routes == [Route(method: "GET", pattern: "/users/:id", name: "user", groups: [])]

# A route for every method.
test "add_any: one route, every method"
    rt @= new_router()
    add_any(@rt, pattern: "/echo", name: "echo").must()
    assert route(rt, fixture.request_of(method: "PURGE", target: "/echo", headers: [])).must().name == "echo"

# A group's routes taken into the router.
test "mount: a group's route reached through the router"
    rt @= new_router()
    api @= new_group(rt, name: "api", prefix: "/api").must()
    add(@api, method: http.METHOD_GET, pattern: "/ping", name: "ping").must()
    mount(router: @rt, group: api).must()
    assert route(rt, fixture.request_of(method: "GET", target: "/api/ping", headers: [])).must().name == "ping"

# The path of a named route, for a redirect or a link.
test "path_for: a user's path"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/users/:id", name: "user").must()
    assert path_for(rt, name: "user", params: [Param(name: "id", value: "42")]).must() == "/users/42"

# The route of a request and its parameter, which the program dispatches on.
test "route: a user's route and its id"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/users/:id", name: "user").must()
    found = route(rt, fixture.request_of(method: "GET", target: "/users/42", headers: [])).must()
    assert found.name == "user" && param_of(found, name: "id").must() == "42"

# The methods a path allows.
test "allowed_of: GET and the two this package adds"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/a", name: "a").must()
    assert allowed_of(rt, fixture.request_of(method: "PUT", target: "/a", headers: [])) == ["GET", "HEAD", "OPTIONS"]

# The answer for a request no route takes.
test "not_routed: 405 for a method no route of the path takes"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/a", name: "a").must()
    got = not_routed(rt, fixture.request_of(method: "PUT", target: "/a", headers: []))
    assert got.status == 405 && http.value_of(got.headers, name: "Allow").must() == "GET, HEAD, OPTIONS"

# A parameter's value by its name.
test "param_of: the id of a found route"
    found = Found(name: "user", pattern: "/users/:id", groups: [], params: [Param(name: "id", value: "7")])
    assert param_of(found, name: "id").must() == "7"

# Whether a route stands in a group, for a step the group asks.
test "is_in_group: a route of the admin group"
    found = Found(name: "users", pattern: "/admin/users", groups: ["admin"], params: [])
    assert is_in_group(found, name: "admin")

# A JSON body read.
test "json_of: an object"
    r = http.with_body(
        fixture.request_of(method: "POST", target: "/", headers: []),
        content_type: "application/json",
        body: bytes.from_text("{\"n\":2}")
    )
    assert json.int_of(json.member(json_of(r).must(), key: "n").must()).must() == 2

# An error answered as JSON.
test "error_response: a 404 as JSON"
    got = error_response(.json, status: 404, message: "no such user")
    assert http.text_of(got).must() == "{\"message\":\"no such user\"}"

# A page made by a template read in the HTML mode.
test "render: a greeting page"
    page = template.parse_html("<h1>Hello, {{ .name }}</h1>").must()
    got = render(200, t: page, name: page.main, value: .object(members: {"name": .text(v: "Ada")})).must()
    assert http.text_of(got).must() == "<h1>Hello, Ada</h1>"

# A download under a file's name.
test "with_disposition: a report saved"
    got = with_disposition(
        http.respond(200, content_type: "application/pdf", body: [37]),
        filename: "report.pdf",
        download: true
    )
    assert http.value_of(got.headers, name: "Content-Disposition").must() == "attachment; filename=\"report.pdf\""

# The usual way to answer from a folder.
test "default_folder: index.html, no listing, no hidden name"
    assert default_folder("public") == Folder(root: "public", index: "index.html", listing: false, hidden: false)

# A file of a folder, named by a wildcard's value.
test "serve_folder: a file under the folder"
    root = fixture.lay_out()
    got = serve_folder(
        fixture.request_of(method: "GET", target: "/static/a.txt", headers: []),
        folder: default_folder(root),
        rest: "a.txt"
    )
    assert got.status == 200 && http.text_of(got).must() == "hello world"
    fixture.remove(root)

# One file the program names.
test "serve_file: a file, one range of it"
    root = fixture.lay_out()
    got = serve_file(
        fixture.request_of(method: "GET", target: "/a", headers: [http.Header(name: "Range", value: "bytes=0-4")]),
        file: path.join_all([root, "a.txt"])
    )
    assert got.status == 206 && http.text_of(got).must() == "hello"
    fixture.remove(root)

# A body's type by its first bytes.
test "sniff: a PNG"
    assert sniff([137, 80, 78, 71, 13, 10, 26, 10, 0]) == "image/png"

# The steps before a handler, in their order.
test "before: a POST standing for DELETE"
    r = fixture.request_of(
        method: "POST",
        target: "/items/3",
        headers: [http.Header(name: "X-HTTP-Method-Override", value: "DELETE")]
    )

    match before(r, steps: [override_method])
        .go_on g  => assert g.request.method == "DELETE"
        .answer _ => assert false

# The steps after a handler, in their order.
test "after: the request's id copied to the response"
    r = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "X-Request-Id", value: "r-1")])
    got = after(r, response: http.respond_status(204), steps: [copy_request_id])
    assert http.value_of(got.headers, name: "X-Request-Id").must() == "r-1"

# A body past a route's limit refused.
test "limit_body: a body of 5 bytes past a limit of 4"
    match limit_body(http.with_text(fixture.request_of(method: "POST", target: "/", headers: []), text: "hello"), most_bytes: 4)
        .go_on _  => assert false
        .answer a => assert a.response.status == 413

# Basic credentials the program accepts.
test "require_basic: alice let in"
    r = http.with_basic_auth(
        fixture.request_of(method: "GET", target: "/", headers: []),
        user: "alice",
        password: "secret"
    )

    match require_basic(r, realm: "admin", accepts: fixture.is_alice)
        .go_on _  => _ = 0
        .answer _ => assert false

# The answer that asks for Basic credentials.
test "challenge_basic: 401 and its challenge"
    got = challenge_basic("admin")
    assert got.status == 401 && http.value_of(got.headers, name: "WWW-Authenticate").must() == "Basic realm=\"admin\", charset=\"UTF-8\""

# A Bearer token the program accepts.
test "require_bearer: a good token let in"
    r = http.with_bearer_auth(fixture.request_of(method: "GET", target: "/", headers: []), token: "good-token")

    match require_bearer(r, realm: "api", accepts: fixture.is_good_token)
        .go_on _  => _ = 0
        .answer _ => assert false

# The answer to a token refused.
test "challenge_bearer: an invalid token"
    got = challenge_bearer(realm: "api", error: "invalid_token")
    assert got.status == 401 && http.value_of(got.headers, name: "WWW-Authenticate").must() == "Bearer realm=\"api\", error=\"invalid_token\""

# The usual CORS for one origin.
test "default_cors: one origin, the usual methods"
    c = default_cors(["https://app.example"])
    assert c.origins == ["https://app.example"] && !c.credentials && c.methods.len() == 6

# A preflight answered.
test "preflight: an allowed origin's preflight"
    r = fixture.request_of(
        method: "OPTIONS",
        target: "/x",
        headers: [http.Header(name: "Origin", value: "https://app.example"), http.Header(name: "Access-Control-Request-Method", value: "PUT")]
    )

    match preflight(r, cors: default_cors(["https://app.example"]))
        .go_on _  => assert false
        .answer a => assert a.response.status == 204 && http.value_of(a.response.headers, name: "Access-Control-Allow-Origin").must() == "https://app.example"

# A response a page of another origin may read.
test "with_cors: every origin allowed"
    r = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Origin", value: "https://a.example")]
    )
    got = with_cors(r, response: http.respond_status(204), cors: default_cors(["*"]))
    assert http.value_of(got.headers, name: "Access-Control-Allow-Origin").must() == "*"

# An identifier for a request that has none.
test "with_request_id: a new identifier"
    r = with_request_id(fixture.request_of(method: "GET", target: "/", headers: [])).must()
    assert http.value_of(r.headers, name: "X-Request-Id").must().len() == 36

# The request's id copied to its response.
test "copy_request_id: the id copied"
    r = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "X-Request-Id", value: "abc")])
    assert http.value_of(copy_request_id(r, response: http.respond_status(204)).headers, name: "X-Request-Id").must() == "abc"

# One line for one request.
test "log_request: a line in the text form"
    two @= net.pair(deadline_ms: 5_000).must()
    logger = log.with_clock(log.to(two.first.stream), clock: fixture.clock)
    log_request(
        logger,
        r: fixture.request_of(method: "GET", target: "/", headers: []),
        response: http.respond_status(204),
        started: fixture.started()
    ).must()
    reader @= io.reader(two.second.stream)
    assert io.read_line(@reader).must() == "1994-11-06T08:49:37.000Z INFO request method=GET path=/ status=204 bytes=0 milliseconds=250 remote=\"\""
    io.close(@two.first.stream).must()
    io.close(@reader.stream).must()

# A failed handler answered 500.
test "recover: a failure answered 500"
    two @= net.pair(deadline_ms: 5_000).must()
    logger = log.to(two.first.stream)
    broken: http.Response? = fail(code: "failed", msg: "no database")
    assert recover(logger, r: fixture.request_of(method: "GET", target: "/", headers: []), answer: broken, form: .text).status == 500
    io.close(@two.first.stream).must()
    io.close(@two.second.stream).must()

# A response compressed for a client that accepts gzip.
test "gzip: a long text compressed"
    r = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "Accept-Encoding", value: "gzip")])
    got = gzip(r, response: http.respond_text(200, text: "abc".repeat(to_u64(100).must())), min_bytes: 256)
    assert http.value_of(got.headers, name: "Content-Encoding").must() == "gzip" && got.body.len() < 300

# A gzip body read as the bytes it holds.
test "gunzip_body: a compressed body read"
    data = compress.compress(bytes.from_text("hi"), options: compress.default_options(.gzip)).must()
    r = fixture.request_of(method: "POST", target: "/", headers: [http.Header(name: "Content-Encoding", value: "gzip")])

    match gunzip_body(http.with_body(r, content_type: "text/plain", body: data), most_bytes: 1_000)
        .go_on g  => assert g.request.body == bytes.from_text("hi")
        .answer _ => assert false

# A POST from another site refused.
test "refuse_cross_origin: a cross-site POST"
    r = fixture.request_of(
        method: "POST",
        target: "/x",
        headers: [http.Header(name: "Sec-Fetch-Site", value: "cross-site")]
    )

    match refuse_cross_origin(r, trusted: [])
        .go_on _  => assert false
        .answer a => assert a.response.status == 403

# A body of JSON let in where JSON is read.
test "require_type: JSON let in"
    r = http.with_body(
        fixture.request_of(method: "POST", target: "/", headers: []),
        content_type: "application/json",
        body: [123, 125]
    )

    match require_type(r, types: ["application/json"])
        .go_on _  => _ = 0
        .answer _ => assert false

# A form's POST standing for a PATCH.
test "override_method: PATCH"
    r = fixture.request_of(
        method: "POST",
        target: "/",
        headers: [http.Header(name: "X-HTTP-Method-Override", value: "PATCH")]
    )

    match override_method(r)
        .go_on g  => assert g.request.method == "PATCH" && !http.has_header(g.request.headers, name: "X-HTTP-Method-Override")
        .answer _ => assert false

# A server with no state: one connection answered, then the listener's
# deadline ends the loop.
test "serve: a router with no route answering 404"
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    conn = net.connect("127.0.0.1", port: l.address.port, deadline_ms: 5_000).must()
    io.write_text(conn.stream, text: "GET /x HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n").must()
    net.set_accept_deadline(l, deadline_ms: 300).must()

    match serve(http.default_server(), l: l, router: new_router(), handler: not_routed)
        .ok _  => assert false
        .err e => assert e.code == http.TIMEOUT

    reader @= io.reader(conn.stream)
    assert http.read_response(@reader, method: "GET", limits: http.default_limits()).must().status == 404
    io.close(@reader.stream).must()
    net.close_listener(@l).must()

# The TLS loop, here over a listener closed already, which ends it.
test "serve_tls: a closed listener ends it"
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: ["http/1.1"])
    ).must()
    tls.close_listener(@l).must()

    match serve_tls(http.default_server(), l: l, router: new_router(), handler: not_routed)
        .ok _  => assert false
        .err e => assert e.code == http.CLOSED

# The requests of one stream served, the second closing it.
test "serve_stream: two requests"
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
    ).must()
    assert serve_stream(http.default_server(), stream: two.second.stream, remote: "", router: new_router(), handler: not_routed) == 2
    io.close(@two.second.stream).must()
    io.close(@two.first.stream).must()

# A program with state writes its own loop: each request read by
# `http.next_request`, routed, and handed to its own function with its state
# lent by `@`, the answer written by `http.write_answer`, until the request
# closes the connection.
test "route: a program's own loop, its state passed with @"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/users/:id", name: "user").must()
    two = net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET /users/1 HTTP/1.1\r\nHost: h\r\n\r\nGET /nope HTTP/1.1\r\nHost: h\r\n\r\nGET /users/2 HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
    ).must()
    hits: i64 @= 0
    reader @= io.reader(two.second.stream)

    while true
        r = match http.next_request(@reader, limits: http.default_limits())
            .ok got => got
            .err _  => break

        response = match route(rt, r)
            .ok found => fixture.visit(@hits, name: found.name, id: param_of(found, name: "id").default(""))
            .err _    => not_routed(rt, r)

        http.write_answer(reader.stream, r: r, response: response).must()

        if r.closing || response.closing
            break

    client @= io.reader(two.first.stream)
    first = http.read_response(@client, method: "GET", limits: http.default_limits()).must()
    second = http.read_response(@client, method: "GET", limits: http.default_limits()).must()
    third = http.read_response(@client, method: "GET", limits: http.default_limits()).must()
    assert http.text_of(first).must() == "user 1 1" && second.status == 404 && http.text_of(third).must() == "user 2 2" && hits == 2
    io.close(@reader.stream).must()
    io.close(@client.stream).must()

# Two events written as a stream's text: a named one with an id, and plain
# data of two lines.
test "format_event: a named event with an id, and data of two lines"
    assert format_event(http.Event(name: "tick", data: "1", id: "41")).must() == "id: 41\nevent: tick\ndata: 1\n\n"
    assert format_event(http.Event(name: "", data: "a\nb", id: "")).must() == "data: a\ndata: b\n\n"

# A program's own loop answering the route of a stream: the head written in
# place of an answer, two events and a comment as they are made, then the
# connection closed; the client reads them as they come.
test "start_events: a stream kept open by a program's own loop"
    rt @= new_router()
    add(@rt, method: http.METHOD_GET, pattern: "/events", name: "events").must()
    two = net.pair(deadline_ms: 5_000).must()
    io.write_text(two.first.stream, text: "GET /events HTTP/1.1\r\nHost: h\r\nAccept: text/event-stream\r\n\r\n").must()
    reader @= io.reader(two.second.stream)
    r = http.next_request(@reader, limits: http.default_limits()).must()
    assert route(rt, r).must().name == "events"
    start_events(reader.stream, headers: [http.Header(name: "Access-Control-Allow-Origin", value: "*")]).must()
    write_event(reader.stream, event: http.Event(name: "", data: "first", id: "1")).must()
    write_comment(reader.stream, text: "keep-alive").must()
    write_event(reader.stream, event: http.Event(name: "done", data: "second", id: "2")).must()
    io.close(@reader.stream).must()
    client @= io.reader(two.first.stream)
    started = http.read_response_head(@client, method: http.METHOD_GET, limits: http.default_limits()).must()
    assert http.value_of(started.headers, name: "Cache-Control").must() == "no-cache"
    events @= http.event_reader(started, limits: http.default_limits()).must()
    first = http.read_event(@client, @events).must()
    second = http.read_event(@client, @events).must()
    assert first.data == "first" && first.id == "1" && second.name == "done" && events.last_id == "2"
    assert http.read_event(@client, @events).is_err()
    io.close(@client.stream).must()

# An event written as it is made, read back by a client.
test "write_event: one event on an open stream"
    p = io.pipe().must()
    start_events(p.writer, headers: []).must()
    write_event(p.writer, event: http.Event(name: "price", data: "42", id: "")).must()
    writer @= p.writer
    io.close(@writer).must()
    reader @= io.reader(p.reader)
    got = http.events_of(
        http.read_response(@reader, method: http.METHOD_GET, limits: http.default_limits()).must()
    ).must()
    assert got.len() == 1 && got[0].name == "price" && got[0].data == "42"
    io.close(@reader.stream).must()

# A stream telling its client to wait ten seconds before it connects again.
test "write_retry: ten seconds"
    p = io.pipe().must()
    start_events(p.writer, headers: []).must()
    write_retry(p.writer, ms: 10_000).must()
    writer @= p.writer
    io.close(@writer).must()
    reader @= io.reader(p.reader)
    started = http.read_response_head(@reader, method: http.METHOD_GET, limits: http.default_limits()).must()
    events @= http.event_reader(started, limits: http.default_limits()).must()
    assert http.read_event(@reader, @events).is_err() && events.retry == time.seconds(10).must()
    io.close(@reader.stream).must()

# A comment a reader skips, written where no event is said for long.
test "write_comment: a keep-alive between two events"
    p = io.pipe().must()
    write_comment(p.writer, text: "keep-alive").must()
    writer @= p.writer
    io.close(@writer).must()
    assert io.read_all_text(p.reader).must() == ": keep-alive\n"
    rest @= p.reader
    io.close(@rest).must()

# The events of a handler with no state, answered whole.
test "respond_events: two events held whole"
    response = respond_events(
        [http.Event(name: "", data: "a", id: "1"), http.Event(name: "", data: "b", id: "2")]
    ).must()
    assert http.value_of(response.headers, name: "Content-Type").must() == "text/event-stream"
    got = http.events_of(response).must()
    assert got.len() == 2 && got[1].data == "b" && got[1].id == "2"

# A limit of two requests a second, five at once.
test "new_limiter: two a second, five at once, for ten thousand clients"
    limiter = new_limiter(rate: 2.0, burst: 5, most_keys: 10_000).must()
    assert limiter.burst == 5 && limiter.buckets.len() == 0
    assert new_limiter(rate: 0.0, burst: 5, most_keys: 1).is_err()

# A client allowed its burst at once, then refused until a token comes back.
test "allow: a burst of two, the third refused, one back after a second"
    limiter @= new_limiter(rate: 1.0, burst: 2, most_keys: 100).must()
    start = time.from_unix(whole_seconds: 1_700_000_000, extra_nanoseconds: 0).must()
    assert allow(@limiter, key: "203.0.113.7", now: start)
    assert allow(@limiter, key: "203.0.113.7", now: start)
    assert !allow(@limiter, key: "203.0.113.7", now: start)
    assert allow(@limiter, key: "198.51.100.1", now: start)
    assert allow(@limiter, key: "203.0.113.7", now: time.add(start, d: time.seconds(1).must()).must())

# How long a refused client waits for its next token.
test "wait_of: a quarter of a second at four a second"
    limiter @= new_limiter(rate: 4.0, burst: 1, most_keys: 100).must()
    now = time.from_unix(whole_seconds: 1_700_000_000, extra_nanoseconds: 0).must()
    assert wait_of(limiter, key: "a", now: now).nanoseconds == 0
    assert allow(@limiter, key: "a", now: now)
    assert wait_of(limiter, key: "a", now: now) == time.milliseconds(250).must()

# A program's loop limiting each client by its address: the second request
# of a client within its second is answered 429, with the seconds to wait.
test "limit_rate: 429 and Retry-After past one request a second"
    limiter @= new_limiter(rate: 1.0, burst: 1, most_keys: 100).must()
    now = time.from_unix(whole_seconds: 1_700_000_000, extra_nanoseconds: 0).must()
    r = http.request(method: http.METHOD_GET, target: "/").must()

    match limit_rate(@limiter, r: r, key: "203.0.113.7", now: now, form: .json)
        .go_on _  => _ = 0
        .answer _ => assert false

    match limit_rate(@limiter, r: r, key: "203.0.113.7", now: now, form: .json)
        .go_on _ => assert false
        .answer a =>
            assert a.response.status == http.STATUS_TOO_MANY_REQUESTS
            assert http.value_of(a.response.headers, name: "Retry-After").must() == "1"

# The options of a session's cookie.
test "default_cookie_options: a month, secure, the path /"
    options = default_cookie_options("session", ring: fixture.ring())
    assert options.max_age == time.days(30).must() && options.secure && options.http_only && options.same_site == "Lax" && options.path == "/"

# A value signed for a cookie, then verified.
test "sign_value: a user's name kept by the client, unchangeable"
    now = fixture.clock().must()
    signed = sign_value(
        fixture.ring(),
        name: "user",
        value: "ada",
        expires: time.add(now, d: time.seconds(3_600).must()).must()
    )
    assert verify_value(fixture.ring(), name: "user", signed: signed, now: now).must() == "ada"

# A signed value refused once changed.
test "verify_value: one byte changed is refused"
    now = fixture.clock().must()
    signed = sign_value(
        fixture.ring(),
        name: "user",
        value: "ada",
        expires: time.add(now, d: time.seconds(60).must()).must()
    )
    assert verify_value(
        fixture.ring(),
        name: "user",
        signed: "b" + signed.slice(from: 1, to: signed.len()),
        now: now
    ).is_err()

# A value sealed for a cookie, where the system seals.
test "seal_value: a secret kept by the client, unreadable"
    if !seal.is_available(.aes_128_gcm)
        skip_test(reason: "this platform's cryptography offers no AES-128-GCM to seal")
    k @= seal.generate(.aes_128_gcm).must()
    now = fixture.clock().must()
    sealed = seal_value(
        [k],
        name: "c",
        value: "42",
        expires: time.add(now, d: time.seconds(60).must()).must()
    ).must()
    assert !strings.contains(s: sealed, substr: "42") && open_value([k], name: "c", sealed: sealed, now: now).must() == "42"
    seal.close(@k).must()

# A sealed value no key opens, refused.
test "open_value: a value no key of the ring opens"
    match open_value([], name: "c", sealed: "AAAA", now: fixture.clock().must())
        .ok _  => assert false
        .err e => assert e.code == INVALID

# A signed cookie read from a request.
test "secure_cookie_of: the value of a cookie this server set"
    now = fixture.clock().must()
    options = default_cookie_options("theme", ring: fixture.ring())
    value = sign_value(
        options.keys,
        name: "theme",
        value: "dark",
        expires: time.add(now, d: time.seconds(60).must()).must()
    )
    r = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "Cookie", value: f"theme={value}")])
    assert secure_cookie_of(r, options: options, now: now).must() == "dark"

# A signed cookie set on a response.
test "with_secure_cookie: one Set-Cookie field with its attributes"
    got = with_secure_cookie(
        http.respond_status(http.STATUS_OK),
        options: default_cookie_options("theme", ring: fixture.ring()),
        value: "dark",
        now: fixture.clock().must()
    ).must()
    assert strings.has_prefix(s: http.value_of(got.headers, name: "Set-Cookie").must(), prefix: "theme=ZGFyaw.")

# A cookie forgotten by the browser.
test "without_cookie: the session ended"
    got = without_cookie(
        http.respond_status(http.STATUS_OK),
        options: default_cookie_options("session", ring: fixture.ring())
    )
    assert strings.has_suffix(s: http.value_of(got.headers, name: "Set-Cookie").must(), suffix: "Max-Age=0")

# A new session, empty.
test "new_session: empty and new"
    assert new_session() == Session(values: {}, is_new: true)

# A session written to a response and read from the next request.
test "session_of: the user kept between two requests"
    now = fixture.clock().must()
    options = default_cookie_options("session", ring: fixture.ring())
    s @= new_session()
    s.values["user"] @ "ada"
    written = with_session(http.respond_status(http.STATUS_OK), session: s, options: options, now: now).must()
    cookie = http.parse_set_cookie(http.value_of(written.headers, name: "Set-Cookie").must(), now: now).must()
    next = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "Cookie", value: "session=" + cookie.value)]
    )
    assert session_of(next, options: options, now: now).must().values["user"].must() == "ada"

# A session's values written into its cookie.
test "with_session: a cart of two items"
    s @= new_session()
    s.values["cart"] @ "2"
    got = with_session(
        http.respond_status(http.STATUS_OK),
        session: s,
        options: default_cookie_options("session", ring: fixture.ring()),
        now: fixture.clock().must()
    ).must()
    assert http.values_of(got.headers, name: "Set-Cookie").len() == 1

# A secret for CSRF tokens.
test "new_csrf_secret: 43 characters of base 64"
    assert new_csrf_secret().must().len() == 43

# The secret a session keeps for its forms.
test "csrf_secret: made in a new session"
    s @= new_session()
    secret = csrf_secret(@s).must()
    assert s.values[CSRF_KEY].must() == secret

# A token for one page's form.
test "mask_csrf: two pages, two tokens, one secret"
    secret = new_csrf_secret().must()
    assert mask_csrf(secret).must() != mask_csrf(secret).must()

# The token a form sends back.
test "csrf_token_of: the form's field"
    r = http.with_form(
        fixture.request_of(method: "POST", target: "/", headers: []),
        pairs: [url.Pair(key: CSRF_FIELD, value: "t")]
    )
    assert csrf_token_of(r).must() == "t"

# A form's POST checked against the session's secret.
test "check_csrf: the token of the page accepted"
    s @= new_session()
    secret = csrf_secret(@s).must()
    r = http.with_form(
        fixture.request_of(method: "POST", target: "/", headers: []),
        pairs: [url.Pair(key: CSRF_FIELD, value: mask_csrf(secret).must())]
    )
    assert check_csrf(r, secret: secret) == .go_on(request: r)

# helmet's fields.
test "default_security_headers: helmet's policy and fields"
    h = default_security_headers()
    assert h.frame_options == "SAMEORIGIN" && h.referrer_policy == "no-referrer" && h.others.len() == 4

# The three fields every page can carry.
test "minimal_security_headers: nosniff for a page"
    got = with_security_headers(http.respond_status(200), headers: minimal_security_headers())
    assert http.value_of(got.headers, name: "X-Content-Type-Options").must() == "nosniff"

# A two-year HSTS value for a site in browsers' preload lists.
test "format_hsts: two years, subdomains, preload"
    assert format_hsts(max_age: time.hours(17520).must(), subdomains: true, preload: true) == "max-age=63072000; includeSubDomains; preload"

# A response given helmet's fields, a policy of the program's own among them.
test "with_security_headers: a stricter frame policy"
    h @= default_security_headers()
    h.frame_options @ "DENY"
    got = with_security_headers(http.respond_text(http.STATUS_OK, text: "hi"), headers: h)
    assert http.value_of(got.headers, name: "X-Frame-Options").must() == "DENY" && http.has_header(got.headers, name: "Content-Security-Policy")

# The proxies a program trusts.
test "trusted_networks: a load balancer and a private network"
    assert trusted_networks(["10.0.0.1", "172.16.0.0/12"]).must().len() == 2

# The client behind a trusted proxy.
test "forwarded_of: the client a load balancer names"
    r @= fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "X-Forwarded-For", value: "203.0.113.7"), http.Header(name: "X-Forwarded-Proto", value: "https")]
    )
    r.remote @ "10.0.0.1:51000"
    got = forwarded_of(r, trusted: trusted_networks(["10.0.0.1"]).must())
    assert got.address == "203.0.113.7" && got.scheme == "https" && got.proxies == 1

# The entity tag of a body.
test "etag_of: the tag of a page"
    assert etag_of(bytes.from_text("hello"), weak: false) == "\"2cf24dba5fb0a30e26e83b2ac5b9e29e\""

# A page not sent again to a client holding it.
test "with_etag: 304 for a client holding the page"
    page = http.respond_text(http.STATUS_OK, text: "hello")
    r = fixture.request_of(
        method: "GET",
        target: "/",
        headers: [http.Header(name: "If-None-Match", value: etag_of(page.body, weak: false))]
    )
    assert with_etag(r, response: page).status == http.STATUS_NOT_MODIFIED

# A route answering JSON alone, refusing a client that wants an image.
test "require_acceptable: 406 for a client that wants an image"
    r = fixture.request_of(method: "GET", target: "/", headers: [http.Header(name: "Accept", value: "image/png")])

    match require_acceptable(r, offered: ["application/json"])
        .go_on _  => assert false
        .answer a => assert a.response.status == http.STATUS_NOT_ACCEPTABLE

# A router tried without a network.
test "exchange: a path no route takes answered 404"
    got = exchange(
        fixture.request_of(method: "GET", target: "/nothing", headers: []),
        router: new_router(),
        handler: not_routed
    ).must()
    assert got.status == http.STATUS_NOT_FOUND

# A router served until the stop, here ended by its listener's deadline.
test "serve_until_stopped: a listener with no client, its deadline passed"
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    net.set_accept_deadline(l, deadline_ms: 100).must()

    match serve_until_stopped(http.default_server(), l: l, router: new_router(), handler: not_routed, grace: time.seconds(1).must())
        .ok _  => assert false
        .err e => assert e.code == "timeout"

    net.close_listener(@l).must()

# A readiness endpoint answering the program's own checks, one of which
# failed.
test "health_response: a readiness probe with a database down"
    r = fixture.request_of(method: http.METHOD_GET, target: "/readyz", headers: [])
    checks = [Check(name: "database", outcome: fail(code: "failed", msg: "no connection"))]
    answer = health_response(r, checks: checks, detail: false)
    assert answer.status == http.STATUS_SERVICE_UNAVAILABLE

# A new secret, as a sender gives one to each receiver.
test "new_webhook_secret: a secret to share with a receiver"
    secret = new_webhook_secret().must()
    assert strings.has_prefix(s: secret, prefix: "whsec_")

# The signature the Standard Webhooks project's own libraries test against.
test "webhook_signature: the Standard Webhooks libraries' test vector"
    payload = bytes.from_text("{\"test\": 2432232314}")
    signed = webhook_signature(
        secret: "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        id: "msg_p5jXN8AQM9LWM0D4loKWxJek",
        sent: time.from_unix(whole_seconds: 1614265330, extra_nanoseconds: 0).must(),
        payload: payload
    )
    assert signed.must() == "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="

# The fields a sender adds to its request.
test "sign_webhook: the three fields of a message"
    sent = time.from_unix(whole_seconds: 1700000000, extra_nanoseconds: 0).must()
    fields = sign_webhook(
        secret: "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        id: "msg_1",
        sent: sent,
        payload: bytes.from_text("{}")
    ).must()
    assert fields[1] == http.Header(name: "webhook-timestamp", value: "1700000000")

# A receiver checking a webhook as it arrives, against its two secrets while
# one rotates.
test "verify_webhook: a message received"
    sent = time.from_unix(whole_seconds: 1700000000, extra_nanoseconds: 0).must()
    body = bytes.from_text("{\"type\":\"invoice.paid\"}")
    fields = sign_webhook(
        secret: "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        id: "msg_1",
        sent: sent,
        payload: body
    ).must()
    secrets = [new_webhook_secret().must(), "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"]
    assert verify_webhook(fields, payload: body, secrets: secrets, now: sent, tolerance: default_webhook_tolerance()).must() == "msg_1"
