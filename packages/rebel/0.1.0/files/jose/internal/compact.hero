# A JWS in the compact serialization (RFC 7515 § 7.1), signed and verified,
# its payload carried in the token or apart (Appendix F), base64url or as it
# is (RFC 7797).

use bytes
use jose/internal/algorithms
use jose/internal/jwk
use jose/internal/segments
use jose/internal/signing
use json

# The code of a token or an argument refused.
constant INVALID: str
    "invalid"

# A JWS verified, as the face's `Message` holds it.
record Verified
    # The protected header's members.
    protected: {str: json.Value}
    # The unprotected header's members.
    unprotected: {str: json.Value}
    # The payload.
    payload: [u8]

# The protected header a signer writes: `alg`, then `header`'s members in
# their order, then `kid` where `key` has one and neither header does.
function protected_of(name: str, key: jwk.Jwk, header: {str: json.Value}, unprotected: {str: json.Value}) -> {str: json.Value}?
    if !header["alg"].is_err() || !unprotected["alg"].is_err()
        return fail(
            code: INVALID,
            msg: "a header given with \"alg\": the algorithm is the call's, and the call writes it"
        )
    members: {str: json.Value} @= {}
    members["alg"] @ .text(v: name)

    for member in keys(header)
        if !unprotected[member].is_err()
            return fail(code: INVALID, msg: f"\"{member}\" stands in both headers, which RFC 7515 § 7.2.1 forbids")
        members[member] @ header[member].must()

    if key.id != "" && members["kid"].is_err() && unprotected["kid"].is_err()
        members["kid"] @ .text(v: key.id)
    return ok(members)

# The signature by `key` with the algorithm `name` of `payload` under the
# protected header `members`: the header's segment and the signature.
record Made
    # The protected header's base64url.
    protected_segment: str
    # Whether the payload is base64url.
    encoded: bool
    # The signature.
    signature: [u8]

# `payload` signed by `key`, read from its JSON, with the algorithm `name`.
function made(payload: [u8], key: json.Value, name: str, header: {str: json.Value}, unprotected: {str: json.Value}) -> Made?
    k = jwk.read(key)?
    facts = algorithms.signature(name)?
    signing.serves(k, facts: facts, operation: "sign")?
    members = protected_of(name, key: k, header: header, unprotected: unprotected)?
    encoded = segments.encoded_payload(protected: members, unprotected: unprotected)?
    segment = segments.header_segment(members)?
    signature = signing.sign(segments.signing_input(protected_segment: segment, payload: payload, encoded: encoded), key: k, facts: facts)?
    return ok(Made(protected_segment: segment, encoded: encoded, signature: signature))

# The payload as a serialization writes it: base64url, or the text itself.
function payload_segment(payload: [u8], encoded: bool) -> str?
    if encoded
        return ok(bytes.format_base64_url_unpadded(payload))

    match bytes.to_text(payload)
        .ok t  => return ok(t)
        .err _ => return fail(code: INVALID, msg: "a payload signed as it is (\"b64\": false) that is not UTF-8")

# `payload` signed in the compact serialization.
function sign(payload: [u8], key: json.Value, name: str, header: {str: json.Value}) -> str?
    none: {str: json.Value} = {}
    m = made(payload, key: key, name: name, header: header, unprotected: none)?
    text = payload_segment(payload, encoded: m.encoded)?

    if !m.encoded
        for b in payload
            if b == '.'
                return fail(
                    code: INVALID,
                    msg: "a payload signed as it is (\"b64\": false) holds a dot, which the compact serialization cannot carry"
                )

    return ok(m.protected_segment + "." + text + "." + bytes.format_base64_url_unpadded(m.signature))

# The compact JWS `token` verified by one of `trusted` with one of
# `accepted`: its payload its own where `detached` is false, else `given`,
# which a non-empty middle part must equal.
function verify(token: str, given: [u8], detached: bool, trusted: [json.Value], accepted: [str]) -> Verified?
    parts = segments.pieces(token)

    if parts.len() != 3
        return fail(code: INVALID, msg: f"a compact JWS has 3 parts between dots, and this one has {parts.len()}")
    protected = segments.header_members(segment: parts[0], what: "the JWS header")?
    none: {str: json.Value} = {}
    encoded = segments.encoded_payload(protected: protected, unprotected: none)?
    facts = segments.accepted_facts(protected, accepted: accepted)?
    payload: [u8] @= given

    if !detached
        if encoded
            payload @ segments.decoded(segment: parts[1], what: "the JWS payload")?
        else
            payload @ bytes.from_text(parts[1])
    else if parts[1] != ""
        if payload_segment(given, encoded: encoded)? != parts[1]
            return fail(code: INVALID, msg: "the token carries a payload, and it is not the content given")
    signature = segments.decoded(segment: parts[2], what: "the JWS signature")?
    serving = segments.candidates(segments.readable(trusted), joined: protected, facts: facts, operation: "verify")?
    input = segments.signing_input(protected_segment: parts[0], payload: payload, encoded: encoded)
    segments.verify_by_any(input: input, signature: signature, serving: serving, facts: facts)?
    return ok(Verified(protected: protected, unprotected: none, payload: payload))

test "sign and verify: RFC 7520 § 4.4's HS256, the token byte for byte, and back"
    key = json.parse(
        "{\"kty\":\"oct\",\"kid\":\"018c0ae5-4d9b-471b-bfd6-eef314bc7037\",\"use\":\"sig\",\"alg\":\"HS256\",\"k\":\"hJtXIZ2uSN5kbQfbtTNWbpdmhkV8FJG-Onbc6mxCcYg\"}"
    ).must()
    payload = bytes.from_text(
        "It’s a dangerous business, Frodo, going out your door. You step onto the road, and if you don't keep your feet, there’s no knowing where you might be swept off to."
    )
    none: {str: json.Value} = {}
    token = sign(payload, key: key, name: "HS256", header: none).must()
    assert token == "eyJhbGciOiJIUzI1NiIsImtpZCI6IjAxOGMwYWU1LTRkOWItNDcxYi1iZmQ2LWVlZjMxNGJjNzAzNyJ9.SXTigJlzIGEgZGFuZ2Vyb3VzIGJ1c2luZXNzLCBGcm9kbywgZ29pbmcgb3V0IHlvdXIgZG9vci4gWW91IHN0ZXAgb250byB0aGUgcm9hZCwgYW5kIGlmIHlvdSBkb24ndCBrZWVwIHlvdXIgZmVldCwgdGhlcmXigJlzIG5vIGtub3dpbmcgd2hlcmUgeW91IG1pZ2h0IGJlIHN3ZXB0IG9mZiB0by4.s0h6KThzkfBBBkLspW1h84VsJZFTsPPqMDA7g1Md7p0"
    got = verify(token, given: [], detached: false, trusted: [key], accepted: ["HS256"]).must()
    assert got.payload == payload

test "verify: RFC 7515 Appendix A.1, its CR LF header read as written"
    key = json.parse(
        "{\"kty\":\"oct\",\"k\":\"AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow\"}"
    ).must()
    token = "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    got = verify(token, given: [], detached: false, trusted: [key], accepted: ["HS256"]).must()
    assert got.protected["typ"].must() == .text(v: "JWT")
    assert bytes.to_text(got.payload).must().slice(from: 0, to: 13) == "{\"iss\":\"joe\","

test "verify: refused, a changed signature, an algorithm not accepted, none, two parts, a key of another type"
    key = json.parse(
        "{\"kty\":\"oct\",\"k\":\"AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow\"}"
    ).must()
    head = "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ"
    assert verify(
        head + ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXl",
        given: [],
        detached: false,
        trusted: [key],
        accepted: ["HS256"]
    ).is_err()
    assert verify(
        head + ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
        given: [],
        detached: false,
        trusted: [key],
        accepted: ["HS384"]
    ).is_err()
    assert verify(head, given: [], detached: false, trusted: [key], accepted: ["HS256"]).is_err()
    nothing = "eyJhbGciOiJub25lIn0.eyJpc3MiOiJqb2UifQ."
    assert verify(nothing, given: [], detached: false, trusted: [key], accepted: ["HS256"]).is_err()
    rsa = json.parse("{\"kty\":\"RSA\",\"n\":\"AQAB\",\"e\":\"AQAB\"}").must()
    assert verify(
        head + ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
        given: [],
        detached: false,
        trusted: [rsa],
        accepted: ["HS256"]
    ).is_err()

test "sign and verify: detached, the payload as it is under b64 false, a dot refused there"
    key = json.parse("{\"kty\":\"oct\",\"k\":\"hJtXIZ2uSN5kbQfbtTNWbpdmhkV8FJG-Onbc6mxCcYg\"}").must()
    header: {str: json.Value} = {"b64": .boolean(v: false), "crit": .list(items: [.text(v: "b64")])}
    token = sign(bytes.from_text("$.02"), key: key, name: "HS256", header: header)
    assert token.is_err()
    plain = sign(bytes.from_text("$02"), key: key, name: "HS256", header: header).must()
    assert segments.pieces(plain)[1] == "$02"
    assert verify(plain, given: [], detached: false, trusted: [key], accepted: ["HS256"]).must().payload == bytes.from_text("$02")
    none: {str: json.Value} = {}
    whole = segments.pieces(sign(bytes.from_text("content"), key: key, name: "HS256", header: none).must())
    apart = whole[0] + ".." + whole[2]
    assert verify(apart, given: bytes.from_text("content"), detached: true, trusted: [key], accepted: ["HS256"]).must().payload == bytes.from_text("content")
    assert verify(apart, given: bytes.from_text("other"), detached: true, trusted: [key], accepted: ["HS256"]).is_err()

test "protected_of: alg written first, kid added, alg given refused, a member in both refused"
    key = jwk.read(json.parse("{\"kty\":\"oct\",\"kid\":\"k1\",\"k\":\"AQ\"}").must()).must()
    header: {str: json.Value} = {"typ": .text(v: "JWT")}
    none: {str: json.Value} = {}
    members = protected_of("HS256", key: key, header: header, unprotected: none).must()
    assert keys(members) == ["alg", "typ", "kid"]
    with_alg: {str: json.Value} = {"alg": .text(v: "HS512")}
    assert protected_of("HS256", key: key, header: with_alg, unprotected: none).is_err()
    assert protected_of("HS256", key: key, header: header, unprotected: header).is_err()
