function protecting_none() -> str
    return "{\"payload\":\"SXTigJlzIGEgZGFuZ2Vyb3VzIGJ1c2luZXNzLCBGcm9kbywgZ29pbmcgb3V0IHlvdXIgZG9vci4gWW91IHN0ZXAgb250byB0aGUgcm9hZCwgYW5kIGlmIHlvdSBkb24ndCBrZWVwIHlvdXIgZmVldCwgdGhlcmXigJlzIG5vIGtub3dpbmcgd2hlcmUgeW91IG1pZ2h0IGJlIHN3ZXB0IG9mZiB0by4\",\"header\":{\"alg\":\"HS256\",\"kid\":\"018c0ae5-4d9b-471b-bfd6-eef314bc7037\"},\"signature\":\"xuLifqLGiblpv9zBpuZczWhNj1gARaLV3UxvxhJxZuk\"}"

# RFC 7520 § 4.8, Figure 71: RS256, ES512 and HS256 over one payload, general.
function three_signatures() -> str
    return "{\"payload\":\"SXTigJlzIGEgZGFuZ2Vyb3VzIGJ1c2luZXNzLCBGcm9kbywgZ29pbmcgb3V0IHlvdXIgZG9vci4gWW91IHN0ZXAgb250byB0aGUgcm9hZCwgYW5kIGlmIHlvdSBkb24ndCBrZWVwIHlvdXIgZmVldCwgdGhlcmXigJlzIG5vIGtub3dpbmcgd2hlcmUgeW91IG1pZ2h0IGJlIHN3ZXB0IG9mZiB0by4\",\"signatures\":[{\"protected\":\"eyJhbGciOiJSUzI1NiJ9\",\"header\":{\"kid\":\"bilbo.baggins@hobbiton.example\"},\"signature\":\"MIsjqtVlOpa71KE-Mss8_Nq2YH4FGhiocsqrgi5NvyG53uoimic1tcMdSg-qptrzZc7CG6Svw2Y13TDIqHzTUrL_lR2ZFcryNFiHkSw129EghGpwkpxaTn_THJTCglNbADko1MZBCdwzJxwqZc-1RlpO2HibUYyXSwO97BSe0_evZKdjvvKSgsIqjytKSeAMbhMBdMma622_BG5t4sdbuCHtFjp9iJmkio47AIwqkZV1aIZsv33uPUqBBCXbYoQJwt7mxPftHmNlGoOSMxR_3thmXTCm4US-xiNOyhbm8afKK64jU6_TPtQHiJeQJxz9G3Tx-083B745_AfYOnlC9w\"},{\"header\":{\"alg\":\"ES512\",\"kid\":\"bilbo.baggins@hobbiton.example\"},\"signature\":\"ARcVLnaJJaUWG8fG-8t5BREVAuTY8n8YHjwDO1muhcdCoFZFFjfISu0Cdkn9Ybdlmi54ho0x924DUz8sK7ZXkhc7AFM8ObLfTvNCrqcI3Jkl2U5IX3utNhODH6v7xgy1Qahsn0fyb4zSAkje8bAWz4vIfj5pCMYxxm4fgV3q7ZYhm5eD\"},{\"protected\":\"eyJhbGciOiJIUzI1NiIsImtpZCI6IjAxOGMwYWU1LTRkOWItNDcxYi1iZmQ2LWVlZjMxNGJjNzAzNyJ9\",\"signature\":\"s0h6KThzkfBBBkLspW1h84VsJZFTsPPqMDA7g1Md7p0\"}]}"

# RFC 7520 § 5.6, Figure 130: an AES key of 128 bits.
function dir_key() -> str
    return "{\"kty\":\"oct\",\"kid\":\"77c7e2b8-6e13-45cf-8672-617b5b45243a\",\"use\":\"enc\",\"alg\":\"A128GCM\",\"k\":\"XctOhJAkA-pD9Lh7ZgW_2A\"}"

# RFC 7520 § 5.6, Figure 137: dir and A128GCM, general JSON.
function dir_general() -> str
    return "{\"protected\":\"eyJhbGciOiJkaXIiLCJraWQiOiI3N2M3ZTJiOC02ZTEzLTQ1Y2YtODY3Mi02MTdiNWI0NTI0M2EiLCJlbmMiOiJBMTI4R0NNIn0\",\"iv\":\"refa467QzzKx6QAB\",\"ciphertext\":\"JW_i_f52hww_ELQPGaYyeAB6HYGcR559l9TYnSovc23XJoBcW29rHP8yZOZG7YhLpT1bjFuvZPjQS-m0IFtVcXkZXdH_lr_FrdYt9HRUYkshtrMmIUAyGmUnd9zMDB2n0cRDIHAzFVeJUDxkUwVAE7_YGRPdcqMyiBoCO-FBdE-Nceb4h3-FtBP-c_BIwCPTjb9o0SbdcdREEMJMyZBH8ySWMVi1gPD9yxi-aQpGbSv_F9N4IZAxscj5g-NJsUPbjk29-s7LJAGb15wEBtXphVCgyy53CoIKLHHeJHXex45Uz9aKZSRSInZI-wjsY0yu3cT4_aQ3i1o-tiE-F8Ios61EKgyIQ4CWao8PFMj8TTnp\",\"tag\":\"vbb32Xvllea2OtmHAdccRQ\"}"

# The text member `name` of the JSON object `text`.
function member_text(text: str, name: str) -> str
    return json.text_of(json.member(json.parse(text).must(), key: name).must()).must()

# The compact serialization of the flattened JWS `text`.
function compact_of(text: str) -> str
    return member_text(text: text, name: "protected") + "." + member_text(text: text, name: "payload") + "." + member_text(text: text, name: "signature")

# The JSON value of `text`.
function value_of(text: str) -> json.Value
    return json.parse(text).must()

test "RFC 7520 § 4.1: RS256 signed byte for byte as the RFC prints it, and verified compact and flattened"
    token = compact_of(rs256_flattened())
    public = value_of(rsa_public())
    payload = compact.verify(token, given: [], detached: false, trusted: [public], accepted: ["RS256"]).must().payload
    assert bytes.to_text(payload).must().slice(from: 0, to: 5) == "It’"
    none: {str: json.Value} = {}
    assert compact.sign(payload, key: value_of(rsa_private()), name: "RS256", header: none).must() == token
    assert general.verify(rs256_flattened(), trusted: [public], accepted: ["RS256"]).must().payload == payload
    assert compact.verify(token, given: [], detached: false, trusted: [public], accepted: ["PS256"]).is_err()

test "RFC 7520 § 4.2: PS384 verified, flattened and compact, and refused where only RS384 is accepted"
    public = value_of(rsa_public())
    assert general.verify(ps384_flattened(), trusted: [public], accepted: ["PS384"]).must().payload.len() == 167
    assert compact.verify(compact_of(ps384_flattened()), given: [], detached: false, trusted: [public], accepted: ["PS384"]).must().payload.len() == 167
    assert general.verify(ps384_flattened(), trusted: [public], accepted: ["RS384"]).is_err()

test "RFC 7520 § 4.3: ES512 on P-521, which no package below offers, unsupported"
    match general.verify(es512_flattened(), trusted: [value_of(ec_p521_public())], accepted: ["ES512"])
        .ok _  => assert false
        .err e => assert e.code == "unsupported"

test "RFC 7520 § 4.5: HS256 with its content detached, verified over the content given"
    token = member_text(text: detached_flattened(), name: "protected") + ".." + member_text(text: detached_flattened(), name: "signature")
    content = bytes.parse_base64_url_unpadded(member_text(text: rs256_flattened(), name: "payload")).must()
    got = compact.verify(
        token,
        given: content,
        detached: true,
        trusted: [value_of(hmac_key())],
        accepted: ["HS256"]
    ).must()
    assert got.payload == content
    assert compact.verify(
        token,
        given: bytes.from_text("other"),
        detached: true,
        trusted: [value_of(hmac_key())],
        accepted: ["HS256"]
    ).is_err()

test "RFC 7520 § 4.6 and § 4.7: a kid in the unprotected header, and an alg there with no protected header"
    some = general.verify(protecting_some(), trusted: [value_of(hmac_key())], accepted: ["HS256"]).must()
    assert some.protected["alg"].must() == .text(v: "HS256")
    assert some.unprotected["kid"].must() == .text(v: "018c0ae5-4d9b-471b-bfd6-eef314bc7037")
    bare = general.verify(protecting_none(), trusted: [value_of(hmac_key())], accepted: ["HS256"]).must()
    assert bare.protected.len() == 0 && bare.unprotected["alg"].must() == .text(v: "HS256")

test "RFC 7520 § 4.8: three signatures, the RSA one and the HMAC one each verified by its own key, ES512 passed over"
    by_rsa = general.verify(three_signatures(), trusted: [value_of(rsa_public())], accepted: ["RS256"]).must()
    assert by_rsa.unprotected["kid"].must() == .text(v: "bilbo.baggins@hobbiton.example")
    by_hmac = general.verify(three_signatures(), trusted: [value_of(hmac_key())], accepted: ["HS256", "RS256"]).must()
    assert by_hmac.protected["alg"].must() == .text(v: "HS256")
    assert general.verify(three_signatures(), trusted: [value_of(hmac_key())], accepted: ["RS256"]).is_err()

test "RFC 7520 § 5.6: dir and A128GCM decrypted to Figure 72's text, or unsupported where the platform has no AES-GCM"
    general_form = dir_general()
    token = [member_text(text: general_form, name: "protected"), "", member_text(text: general_form, name: "iv"), member_text(text: general_form, name: "ciphertext"), member_text(text: general_form, name: "tag")].join(
        "."
    )
    expected = "You can trust us to stick with you through thick and thin–to the bitter end. And you can trust us to keep any secret of yours–closer than you keep it yourself. But you cannot trust us to let you face trouble alone, and go off without a word. We are your friends, Frodo."

    match encryption.decrypt(token, trusted: [value_of(dir_key())], accepted_algorithms: ["dir"], accepted_encryptions: ["A128GCM"])
        .err e => assert e.code == "unsupported"
        .ok got =>
            assert got.plaintext == bytes.from_text(expected)
            changed = token.slice(from: 0, to: token.len() - 2) + "AA"
            assert encryption.decrypt(
                changed,
                trusted: [value_of(dir_key())],
                accepted_algorithms: ["dir"],
                accepted_encryptions: ["A128GCM"]
            ).is_err()

test "RFC 8037 Appendix A.4: Ed25519 signed byte for byte, or unsupported where the platform has no Ed25519"
    key = value_of(
        "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"
    )
    expected = "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc.hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg"
    none: {str: json.Value} = {}

    match compact.sign(bytes.from_text("Example of Ed25519 signing"), key: key, name: "EdDSA", header: none)
        .err e => assert e.code == "unsupported"
        .ok token =>
            assert token == expected
            assert !compact.verify(expected, given: [], detached: false, trusted: [jwk.write(jwk.public_of(jwk.read(key).must()).must())], accepted: ["EdDSA"]).is_err()

test "RFC 7517 Appendix A.2's EC private key read and its public half: the members, the curve, the use"
    key = jwk.read(
        value_of("{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4\",\"y\":\"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM\",\"d\":\"870MB6gfuTJ4HtUnUvYMyJpr5eUZNP4Bk43bVdj3eAE\",\"use\":\"enc\",\"kid\":\"1\"}")
    ).must()
    assert key.usage == "enc" && key.material["d"].must().len() == 32
    assert !jwk.is_private(jwk.public_of(key).must())
