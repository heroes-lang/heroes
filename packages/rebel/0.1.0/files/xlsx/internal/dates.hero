# Excel's serial numbers of days and the calendar's dates, both ways, by the
# 1900 epoch and the 1904 one. A serial counts days and its fraction the time
# of day; the 1900 system counts the 29th of February 1900 that never was, so
# a day from the 1st of March 1900 is one more than the days since 1899-12-31.
# A date here reaches 9999-12-31, past what `time.Instant` holds, so the days
# are counted with the civil calendar's own arithmetic.

use time

constant INVALID: str
    "invalid"

constant UNSUPPORTED: str
    "unsupported"

# Milliseconds in a day.
constant DAY_MS: i64
    86400000

# The serial of 9999-12-31 in the 1900 system.
constant LAST_1900: i64
    2958465

# The days between the two epochs' day zero, 1899-12-30 and 1904-01-01.
constant EPOCH_GAP: i64
    1462

# The days from 1970-01-01 to the date `year`, `month`, `day` of the proleptic
# Gregorian calendar, negative before it.
function days_from_civil(year: i64, month: i64, day: i64) -> i64
    y: i64 @= year

    if month <= 2
        y @ y - 1
    era: i64 @= y / 400

    if y < 0 && y % 400 != 0
        era @ era - 1
    year_of_era = y - era * 400
    shifted: i64 @= month - 3

    if month <= 2
        shifted @ month + 9
    day_of_year = (153 * shifted + 2) / 5 + day - 1
    day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468

# The date `days` after 1970-01-01, as a `time.DateTime` at midnight.
function civil_from_days(days: i64) -> time.DateTime
    z = days + 719468
    era: i64 @= z / 146097

    if z < 0 && z % 146097 != 0
        era @ era - 1
    day_of_era = z - era * 146097
    year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
    day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    shifted = (5 * day_of_year + 2) / 153
    day = day_of_year - (153 * shifted + 2) / 5 + 1
    month: i64 @= shifted + 3

    if shifted >= 10
        month @ shifted - 9
    year: i64 @= year_of_era + era * 400

    if month <= 2
        year @ year + 1
    return time.DateTime(year: year, month: month, day: day, hour: 0, minute: 0, second: 0, nanosecond: 0)

# The day zero of an epoch, as days since 1970-01-01: 1899-12-30 for the 1900
# system, 1904-01-01 for the 1904 one.
function day_zero(from_1904: bool) -> i64
    if from_1904
        return days_from_civil(year: 1904, month: 1, day: 1)
    return days_from_civil(year: 1899, month: 12, day: 30)

# The moment the serial `serial` names, rounded to the millisecond.
function date_of(serial: f64, from_1904: bool) -> time.DateTime?
    last: i64 @= LAST_1900

    if from_1904
        last @ LAST_1900 - EPOCH_GAP

    if serial != serial || serial < 0.0 || serial >= to_f64(last + 1)
        return fail(code: INVALID, msg: f"the serial {serial} names no day from the epoch to 9999-12-31")
    whole: i64 @= to_i64(serial).must()
    ms: i64 @= to_i64((serial - to_f64(whole)) * to_f64(DAY_MS) + 0.5).must()

    if ms >= DAY_MS
        whole @ whole + 1
        ms @ ms - DAY_MS

    if whole > last
        return fail(code: INVALID, msg: f"the serial {serial} names no day from the epoch to 9999-12-31")
    days: i64 @= whole

    if !from_1904 && whole >= 1 && whole <= 60
        days @ whole + 1

        if whole == 60
            days @ 60
    date @= civil_from_days(day_zero(from_1904) + days)
    date.hour @ ms / 3600000
    date.minute @ ms / 60000 % 60
    date.second @ ms / 1000 % 60
    date.nanosecond @ ms % 1000 * 1000000
    return ok(date)

# Whether `date`'s fields are each within its range.
function check_fields(date: time.DateTime) -> ()?
    if date.month < 1 || date.month > 12
        return fail(code: INVALID, msg: f"the month {date.month} is outside 1 to 12")
    month_days = time.days_in_month(year: date.year, month: date.month)?

    if date.day < 1 || date.day > month_days
        return fail(code: INVALID, msg: f"the day {date.day} is outside 1 to {month_days} of {date.year}-{date.month}")

    if date.hour < 0 || date.hour > 23
        return fail(code: INVALID, msg: f"the hour {date.hour} is outside 0 to 23")

    if date.minute < 0 || date.minute > 59
        return fail(code: INVALID, msg: f"the minute {date.minute} is outside 0 to 59")

    if date.second < 0 || date.second > 59
        return fail(code: INVALID, msg: f"the second {date.second} is outside 0 to 59")

    if date.nanosecond < 0 || date.nanosecond > 999999999
        return fail(code: INVALID, msg: f"the nanosecond {date.nanosecond} is outside 0 to 999,999,999")
    return ok()

# The serial Excel holds for `date`: its days since the epoch's day zero, one
# fewer in the 1900 system before the 1st of March 1900, and its time of day
# as the fraction.
function serial_of(date: time.DateTime, from_1904: bool) -> f64?
    check_fields(date)?

    if date.year > 9999
        return fail(code: UNSUPPORTED, msg: f"the year {date.year} is past 9999, the last a workbook holds")
    on = days_from_civil(year: date.year, month: date.month, day: date.day)
    zero = day_zero(from_1904)
    days: i64 @= on - zero

    if !from_1904
        first = days_from_civil(year: 1900, month: 1, day: 1)

        if on != zero && on < first
            return fail(
                code: UNSUPPORTED,
                msg: f"the date {date.year}-{date.month}-{date.day} is before 1900-01-01, the first day of the 1900 system"
            )

        if on < days_from_civil(year: 1900, month: 3, day: 1) && on != zero
            days @ days - 1
    else if on < zero
        return fail(
            code: UNSUPPORTED,
            msg: f"the date {date.year}-{date.month}-{date.day} is before 1904-01-01, the first day of the 1904 system"
        )
    seconds = to_f64(days * 86400 + date.hour * 3600 + date.minute * 60 + date.second) + to_f64(date.nanosecond) / 1000000000.0
    return ok(seconds / 86400.0)

test "days_from_civil and civil_from_days: the Unix epoch, the epochs' day zero, a leap day, before year 0 and 9999-12-31"
    assert days_from_civil(year: 1970, month: 1, day: 1) == 0
    assert days_from_civil(year: 1899, month: 12, day: 30) == -25569
    assert days_from_civil(year: 1904, month: 1, day: 1) == -24107
    assert days_from_civil(year: 2000, month: 2, day: 29) == 11016
    assert civil_from_days(11016) == time.DateTime(year: 2000, month: 2, day: 29, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert civil_from_days(-25569).year == 1899
    assert civil_from_days(days_from_civil(year: 9999, month: 12, day: 31)).day == 31
    assert civil_from_days(days_from_civil(year: -1, month: 3, day: 1)).year == -1

test "date_of: openpyxl's and excelize's answers, the day that never was, the last day and outside"
    one = date_of(1.0, from_1904: false).must()
    assert one.year == 1900 && one.month == 1 && one.day == 1
    feb = date_of(59.0, from_1904: false).must()
    assert feb.month == 2 && feb.day == 28
    never = date_of(60.0, from_1904: false).must()
    assert never.month == 2 && never.day == 28
    march = date_of(61.0, from_1904: false).must()
    assert march.month == 3 && march.day == 1
    noon = date_of(0.5, from_1904: false).must()
    assert noon.year == 1899 && noon.month == 12 && noon.day == 30 && noon.hour == 12

    # openpyxl reads 45000.123456789 as 2023-03-15 02:57:46.667.
    t = date_of(45000.123456789, from_1904: false).must()
    assert t == time.DateTime(year: 2023, month: 3, day: 15, hour: 2, minute: 57, second: 46, nanosecond: 667000000)
    last = date_of(2958465.9999999, from_1904: false).must()
    assert last == time.DateTime(year: 9999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 991000000)
    mac = date_of(1.0, from_1904: true).must()
    assert mac.year == 1904 && mac.month == 1 && mac.day == 2
    quarter = date_of(0.25, from_1904: true).must()
    assert quarter.year == 1904 && quarter.hour == 6
    assert date_of(-1.0, from_1904: false).is_err()
    assert date_of(2958466.0, from_1904: false).is_err()
    assert date_of(2957004.0, from_1904: true).is_err()
    assert date_of(0.0 / 0.0, from_1904: false).is_err()
    assert date_of(1.0 / 0.0, from_1904: false).is_err()

test "serial_of: openpyxl's answers, the day zero, before the epoch, a field out of range and past 9999"
    at = time.DateTime(year: 1900, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert serial_of(at, from_1904: false).must() == 1.0
    feb @= at
    feb.month @ 2
    feb.day @ 28
    assert serial_of(feb, from_1904: false).must() == 59.0
    march @= at
    march.month @ 3
    assert serial_of(march, from_1904: false).must() == 61.0

    # openpyxl writes 2026-11-18 13:45:30.5 as 46344.57326967592.
    late = time.DateTime(year: 2026, month: 11, day: 18, hour: 13, minute: 45, second: 30, nanosecond: 500000000)
    assert serial_of(late, from_1904: false).must() == 46344.57326967592
    zero = time.DateTime(year: 1899, month: 12, day: 30, hour: 12, minute: 0, second: 0, nanosecond: 0)
    assert serial_of(zero, from_1904: false).must() == 0.5
    eve @= zero
    eve.day @ 31
    assert serial_of(eve, from_1904: false).is_err()
    mac = time.DateTime(year: 1904, month: 1, day: 2, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert serial_of(mac, from_1904: true).must() == 1.0
    assert serial_of(at, from_1904: true).is_err()
    bad @= at
    bad.day @ 30
    bad.month @ 2
    assert serial_of(bad, from_1904: false).is_err()
    far @= at
    far.year @ 10000
    assert serial_of(far, from_1904: false).is_err()
