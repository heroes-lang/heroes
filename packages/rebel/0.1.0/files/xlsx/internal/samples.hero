# Workbooks to test with, written as hexadecimal text: three made by openpyxl
# 3.1.5 and one by excelize 2.11.1 on 2026-11-18, by scripts outside the tree
# that no program calls; and zips made here of the parts a test names, for
# the files no library would write.

use archive
use bytes
use fs
use io

# openpyxl's workbook: two sheets, the second hidden; text inline, numbers,
# booleans, a formula with no value, a date, a day and a time; a font, a
# fill, a border, an alignment and a number format; a merged area, a width, a
# height, a frozen pane, a defined name and the title and creator.
constant PY_BOOK: str
    ""

# openpyxl's workbook of the 1904 epoch: 2026-11-18 in `A1`, the number 1 in
# `A2`.
constant PY_1904: str
    ""

# excelize's workbook: shared strings, one rich, a number, a boolean, a
# formula with no value, a date of the built-in format 14, and a second sheet
# with a name local to it.
constant GO_BOOK: str
    ""

# openpyxl's workbook of links: `A1` of the sheet `Links` to a web address
# with a tip, `B2` to `Other!A1` with the text it shows.
constant PY_LINKS: str
    ""

# The bytes the hexadecimal `hex` writes.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()

# A zip of the parts `names`, each holding the text of `bodies` at its index,
# made in a temporary file and read back.
function zip_of(names: [str], bodies: [str]) -> [u8]
    temp @= fs.make_temp_file(dir: "", pattern: "rebel-xlsx-test-*.zip").must()
    w @= archive.zip_writer(temp.stream)
    at: i64 @= 0

    while at < names.len()
        archive.write_zip_entry(
            @w,
            entry: archive.zip_entry(names[at], kind: .file),
            data: bytes.from_text(bodies[at])
        ).must()
        at @ at + 1

    archive.finish_zip(@w, comment: "").must()
    io.close(@temp.stream).must()
    data = fs.read_bytes(temp.path).must()
    fs.remove(temp.path).must()
    return data

test "of and zip_of: the samples are zips, and a zip made of two parts"
    for hex in [PY_BOOK, PY_1904, GO_BOOK, PY_LINKS]
        data = of(hex)
        assert data[0] == 'P' && data[1] == 'K'

    made = zip_of(names: ["a.xml", "b.xml"], bodies: ["<a/>", "<b/>"])
    assert made[0] == 'P' && made.len() > 100
