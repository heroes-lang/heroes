# A formula's references moved by a number of rows and columns, as Excel
# moves them when a shared formula covers another cell: `A1*2` written in
# `B1` and shared down to `B3` reads `A3*2` there. Text in quotes, sheet names
# in quotes and what stands in brackets are kept as they are; a part written
# with `$` does not move; a reference moved off the sheet becomes `#REF!`.

use xlsx/internal/names

# Whether `b` may stand inside a name: a letter, a digit, `_` or `.`.
function is_name_byte(b: u8) -> bool
    return names.is_letter(b) || names.is_digit(b) || b == '_' || b == '.' || b == '\\'

# One reference read: where it ends, its parts and whether each is absolute;
# a column of -1 where it has none, a row of -1 where it has none.
record Ref
    # The index past its last byte.
    end: i64
    # The column, from 0, or -1.
    column: i64
    # Whether the column is written with `$`.
    column_fixed: bool
    # The row, from 0, or -1.
    row: i64
    # Whether the row is written with `$`.
    row_fixed: bool

# The reference that begins at `at` of `s`: an optional `$` and letters, an
# optional `$` and digits; a column of -1 and a row of -1 where none begins.
function ref_at(s: str, at: i64) -> Ref
    none = Ref(end: at, column: -1, column_fixed: false, row: -1, row_fixed: false)
    i: i64 @= at
    column_fixed: bool @= false

    if i < s.len() && s[i] == '$'
        column_fixed @ true
        i @ i + 1
    letters = i

    while i < s.len() && names.is_letter(s[i])
        i @ i + 1

    column: i64 @= -1

    if i > letters
        column @ names.letters_at(s, from: letters, to: i)

        if column < 0
            return none
    else if column_fixed
        # A `$` with no letters fixes the row.
        i @ letters - 1
    row_fixed: bool @= false

    if i < s.len() && s[i] == '$'
        row_fixed @ true
        i @ i + 1
    digits = i

    while i < s.len() && names.is_digit(s[i])
        i @ i + 1

    row: i64 @= -1

    if i > digits
        row @ names.digits_at(s, from: digits, to: i)

        if row < 0
            return none
    else if row_fixed
        return none

    if column < 0 && row < 0
        return none
    return Ref(end: i, column: column, column_fixed: column_fixed, row: row, row_fixed: row_fixed)

# `r` moved by `rows` and `columns` and written again, or `#REF!` where it
# moves off the sheet.
function moved(r: Ref, rows: i64, columns: i64) -> str
    out: [str] @= []

    if r.column >= 0
        column: i64 @= r.column

        if !r.column_fixed
            column @ column + columns

        match names.letters_of(column)
            .ok letters =>
                if r.column_fixed
                    out @ out.push("$")
                out @ out.push(letters)
            .err _ => return "#REF!"

    if r.row >= 0
        row: i64 @= r.row

        if !r.row_fixed
            row @ row + rows

        if row < 0 || row >= names.ROWS
            return "#REF!"

        if r.row_fixed
            out @ out.push("$")
        out @ out.push(to_str(row + 1))

    return out.join("")

# Whether the byte at `at` of `s` ends a reference: the end, or a byte that
# is not part of a name, not `(` and not `!`.
function ends_ref(s: str, at: i64) -> bool
    if at >= s.len()
        return true
    b = s[at]
    return !is_name_byte(b) && b != '(' && b != '!'

# The index past the text in quotes that opens at `at` with `quote`, a
# doubled quote inside it read as one.
function past_quoted(s: str, at: i64, quote: u8) -> i64
    i: i64 @= at + 1

    while i < s.len()
        if s[i] == quote
            if i + 1 < s.len() && s[i + 1] == quote
                i @ i + 2
            else
                return i + 1
        else
            i @ i + 1

    return s.len()

# The index past the brackets that open at `at`, nested ones included.
function past_brackets(s: str, at: i64) -> i64
    depth: i64 @= 0
    i: i64 @= at

    while i < s.len()
        if s[i] == '['
            depth @ depth + 1
        else if s[i] == ']'
            depth @ depth - 1

            if depth == 0
                return i + 1
        i @ i + 1

    return s.len()

# `formula` with its references moved by `rows` and `columns`.
function shifted(formula: str, rows: i64, columns: i64) -> str
    if rows == 0 && columns == 0
        return formula
    s = formula
    out: [str] @= []
    start: i64 @= 0
    i: i64 @= 0

    while i < s.len()
        b = s[i]

        if b == '"' || b == '\''
            i @ past_quoted(s, at: i, quote: b)
        else if b == '['
            i @ past_brackets(s, at: i)
        else if i > 0 && is_name_byte(s[i - 1])
            i @ i + 1
        else if b == '$' || names.is_letter(b) || names.is_digit(b)
            first = ref_at(s, at: i)
            whole_cell = first.column >= 0 && first.row >= 0

            if whole_cell && ends_ref(s, at: first.end)
                out @ out.push(s.slice(from: start, to: i))
                out @ out.push(moved(first, rows: rows, columns: columns))
                i @ first.end
                start @ i
            else if !whole_cell && first.end > i && first.end < s.len() && s[first.end] == ':'
                second = ref_at(s, at: first.end + 1)
                same_kind = second.column >= 0 && first.column >= 0 && second.row < 0 && first.row < 0 || second.row >= 0 && first.row >= 0 && second.column < 0 && first.column < 0

                if same_kind && second.end > first.end + 1 && ends_ref(s, at: second.end)
                    out @ out.push(s.slice(from: start, to: i))
                    out @ out.push(moved(first, rows: rows, columns: columns))
                    out @ out.push(":")
                    out @ out.push(moved(second, rows: rows, columns: columns))
                    i @ second.end
                    start @ i
                else
                    i @ skip_name(s, at: i)
            else
                i @ skip_name(s, at: i)
        else
            i @ i + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out.join("")

# The index past the name or number that begins at `at`, a `$` among it, and
# an exponent's sign after a number's `E`.
function skip_name(s: str, at: i64) -> i64
    i: i64 @= at + 1

    while i < s.len() && (is_name_byte(s[i]) || s[i] == '$')
        if (s[i] == 'E' || s[i] == 'e') && names.is_digit(s[at]) && i + 1 < s.len() && (s[i + 1] == '+' || s[i + 1] == '-')
            i @ i + 2
        else
            i @ i + 1

    return i

test "shifted: a cell, an area, absolute parts, a sheet's name, text, a function, a number and off the sheet"
    assert shifted("A1*2", rows: 2, columns: 0) == "A3*2"
    assert shifted("SUM(A1:B2)", rows: 1, columns: 1) == "SUM(B2:C3)"
    assert shifted("$A$1+A$1+$A1", rows: 1, columns: 1) == "$A$1+B$1+$A2"
    assert shifted("Sheet1!A1+'My Sheet'!B2", rows: 1, columns: 0) == "Sheet1!A2+'My Sheet'!B3"
    assert shifted("\"A1\"&A1", rows: 1, columns: 0) == "\"A1\"&A2"
    assert shifted("LOG10(A1)+ATAN2(B1,C1)", rows: 1, columns: 0) == "LOG10(A2)+ATAN2(B2,C2)"
    assert shifted("1E+5+A1+1.5", rows: 1, columns: 0) == "1E+5+A2+1.5"
    assert shifted("A1-1", rows: -1, columns: 0) == "#REF!-1"
    assert shifted("SUM(A:A)+SUM($1:3)", rows: 1, columns: 1) == "SUM(B:B)+SUM($1:4)"
    assert shifted("Table1[[#This Row],[A1]]+A1", rows: 1, columns: 0) == "Table1[[#This Row],[A1]]+A2"
    assert shifted("TRUE+rate", rows: 1, columns: 1) == "TRUE+rate"
    assert shifted("XFD1+A1048576", rows: 1, columns: 1) == "#REF!+#REF!"
    assert shifted("A1", rows: 0, columns: 0) == "A1"
    assert shifted("", rows: 1, columns: 1) == ""
    assert shifted("'unclosed", rows: 1, columns: 1) == "'unclosed"
