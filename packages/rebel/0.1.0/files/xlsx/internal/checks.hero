# What a workbook must be to be written: a sheet's name, a defined name, a
# cell's place and text, and a number a cell can hold. Building checks them as
# a program adds each thing, and writing checks the whole workbook again, so
# a workbook built directly is held to the same rules.

use strings
use xlsx/internal/names

constant INVALID: str
    "invalid"

constant UNSUPPORTED: str
    "unsupported"

# The characters a cell's text may hold.
constant MAX_TEXT_CHARS: i64
    32767

# Whether `a` and `b` are one name to Excel: equal once their ASCII letters
# are made small.
function same_name(a: str, b: str) -> bool
    return a.len() == b.len() && strings.to_lower_ascii(a) == strings.to_lower_ascii(b)

# Fails `invalid` where `name` cannot name a sheet.
function sheet_name(name: str) -> ()?
    if name == ""
        return fail(code: INVALID, msg: "a sheet's name is empty: it holds 1 to 31 characters")
    count = name.chars().len()

    if count > 31
        return fail(code: INVALID, msg: f"the sheet's name \"{name}\" holds {count} characters, past 31")

    for c in name.chars()
        if c == "[" || c == "]" || c == ":" || c == "*" || c == "?" || c == "/" || c == "\\"
            return fail(code: INVALID, msg: f"the sheet's name \"{name}\" holds `{c}`, which no sheet's name may hold")

        if c.len() == 1 && c[0] < 0x20
            return fail(code: INVALID, msg: f"the sheet's name \"{name}\" holds a control character")

    if name[0] == '\'' || name[name.len() - 1] == '\''
        return fail(code: INVALID, msg: f"the sheet's name \"{name}\" opens or ends with `'`")
    return ok()

# Fails `invalid` where `name` cannot be a defined name: a letter, `_` or `\`
# first, then letters, digits, `_`, `.` and `\`, at most 255 characters, and
# not a cell's name.
function defined_name(name: str) -> ()?
    if name == ""
        return fail(code: INVALID, msg: "a defined name is empty")

    if name.chars().len() > 255
        return fail(code: INVALID, msg: f"the defined name \"{name}\" is longer than 255 characters")
    first: bool @= true

    for c in name.chars()
        letter = c.len() > 1 || names.is_letter(c[0])
        ok_first = letter || c == "_" || c == "\\"

        if first && !ok_first || !first && !ok_first && !names.is_digit(c[0]) && c != "."
            return fail(code: INVALID, msg: f"the defined name \"{name}\" holds `{c}` where a name may not")
        first @ false

    if !names.spot_of(name).is_err() || is_r1c1(name)
        return fail(code: INVALID, msg: f"the defined name \"{name}\" is a cell's name")
    return ok()

# Whether `name` reads as a cell in Excel's other notation, `R1C1`, `R`, `C`.
function is_r1c1(name: str) -> bool
    lower = strings.to_lower_ascii(name)

    if lower == "r" || lower == "c"
        return true

    if lower[0] != 'r' && lower[0] != 'c'
        return false

    for c in lower.chars()
        if !(c == "r" || c == "c" || names.is_digit(c[0]))
            return false

    return true

# Fails `invalid` where `row` and `column` are outside a sheet.
function place(row: i64, column: i64) -> ()?
    if row < 0 || row >= names.ROWS
        return fail(code: INVALID, msg: f"the row {row} is outside a sheet, whose rows are 0 to {names.ROWS - 1}")

    if column < 0 || column >= names.COLUMNS
        return fail(
            code: INVALID,
            msg: f"the column {column} is outside a sheet, whose columns are 0 to {names.COLUMNS - 1}"
        )
    return ok()

# Fails `invalid` where `s` passes the characters a cell holds.
function cell_text(s: str) -> ()?
    if s.len() <= MAX_TEXT_CHARS
        return ok()
    count = s.chars().len()

    if count > MAX_TEXT_CHARS
        return fail(code: INVALID, msg: f"a text of {count} characters, past the {MAX_TEXT_CHARS} a cell holds")
    return ok()

# Fails `unsupported` where `x` is a NaN or an infinity, which no cell holds.
function number(x: f64) -> ()?
    if x != x || x - x != 0.0
        return fail(code: UNSUPPORTED, msg: f"the number {x}, which a workbook has no form for")
    return ok()

# Fails `invalid` where `s` is no colour: `RRGGBB` in hexadecimal, or empty.
function color(s: str) -> ()?
    if s == ""
        return ok()

    if s.len() == 6
        all_hex: bool @= true

        for c in s.chars()
            if !(names.is_digit(c[0]) || c[0] >= 'a' && c[0] <= 'f' || c[0] >= 'A' && c[0] <= 'F')
                all_hex @ false

        if all_hex
            return ok()
    return fail(
        code: INVALID,
        msg: f"\"{s}\" is no colour: six hexadecimal digits, `RRGGBB`, or empty for the automatic one"
    )

test "color: a colour in either case, the automatic one, and what is none"
    assert !color("FF00aa").is_err() && !color("").is_err()
    assert color("FF00AA00").is_err() && color("GG0000").is_err() && color("red").is_err()

test "sheet_name: a name, every refused character, too long, quotes at the ends, and empty"
    assert !sheet_name("Données 2026").is_err()
    assert !sheet_name(repeat("é", 31)).is_err()
    assert sheet_name(repeat("a", 32)).is_err()

    for bad in ["a[b", "a]b", "a:b", "a*b", "a?b", "a/b", "a\\b", "'a", "a'", "", "a\tb"]
        assert sheet_name(bad).is_err()

test "defined_name: names, a print area's, a cell's name, R1C1, and refused characters"
    for good in ["rate", "_xlnm.Print_Area", "\\x", "Tax.Rate2", "été"]
        assert !defined_name(good).is_err()

    for bad in ["", "A1", "xfd1048576", "R1C1", "r", "C", "1rate", "a b", "a-b", ".x"]
        assert defined_name(bad).is_err()

test "same_name, place, cell_text and number: case, the sheet's edges, the longest text and what no cell holds"
    assert same_name(a: "Sheet1", b: "SHEET1") && !same_name(a: "Été", b: "été")
    assert !place(row: 0, column: 0).is_err() && !place(row: 1048575, column: 16383).is_err()
    assert place(row: 1048576, column: 0).is_err() && place(row: 0, column: -1).is_err()
    assert !cell_text(repeat("é", 32767)).is_err()
    assert cell_text(repeat("a", 32768)).is_err()
    assert !number(1.5).is_err()
    assert number(0.0 / 0.0).is_err() && number(1.0 / 0.0).is_err() && number(-1.0 / 0.0).is_err()
