# The process's world: its environment, its working folder, the folders the
# system keeps for a program's data, state, cache, settings and sockets, who it
# runs as and on what machine, the signals it counts, and a URL or a file
# handed to the application the user's system keeps for it. Files and folders
# by path are the package `fs`'s, and other programs the package `process`'s.
# The program's arguments and its exit are the language's own, the built-ins
# `args()` and `exit`, and its arguments read as flags and options are
# `flags`'.
#
# The environment is read and never written: in C a write of it beside another
# thread's read is undefined, so no function here sets, removes or clears a
# variable, and a child is given another environment through `process`. Every
# answer the system can refuse is a `T?`, and a code says why.
#
# Not written yet, each a `pending` block of its ledger: the groups a named user
# belongs to; the user or the groups the process runs as changed; a limit or a
# setting of the system asked by its name; the time of each processor apart; the
# prefix and suffix of a shared library's file; the process's scheduling
# priority, read or changed; the mask of permissions a new file is made without;
# a wait that ends when a counted signal comes.

use os/hero_disk
use os/hero_os
use os/hero_stop
use os/hero_sys
use os/internal/codes
use os/internal/counters
use os/internal/expansion
use os/internal/filled
use os/internal/opening
use os/internal/variables

## Codes

# A variable that is not set, or a name the machine does not give.
constant NOT_FOUND: str
    codes.NOT_FOUND

# A path given to `change_dir` names nothing.
constant FILE_NOT_FOUND: str
    codes.FILE_NOT_FOUND

# A path given to `change_dir` names something that is not a folder.
constant NOT_A_DIRECTORY: str
    codes.NOT_A_DIRECTORY

# The system refuses this to the program.
constant PERMISSION: str
    codes.PERMISSION

# The input is not what the function reads; the message says where.
constant INVALID: str
    codes.INVALID

# The system has no more of what the call needs.
constant LIMIT: str
    codes.LIMIT

# This platform has no such thing: a user id on Windows, the size of an output
# that is not a terminal.
constant UNSUPPORTED: str
    codes.UNSUPPORTED

# Bytes the system holds that are not UTF-8, so no `str`.
constant NOT_TEXT: str
    codes.NOT_TEXT

# The system refused for a reason none of the other codes names; the message
# carries the system's own number.
constant FAILED: str
    codes.FAILED

## The environment

# What `env_all_bytes` answers for one variable: its name and its value as the
# system holds them, which need not be UTF-8.
record RawVariable
    # The bytes before the first `=`, never empty.
    name: [u8]
    # The bytes after it.
    value: [u8]

# The value of the environment variable `name`.
#
# - `name`: the variable's name; on Windows it is compared without its case,
#   as the system compares it.
#
# Fails `not_found` where it is not set, which is never the same as set empty;
# `not_text` where its value is not UTF-8 (`env_bytes` reads it); `invalid`
# where `name` is empty or holds `=` or a zero byte, which name no variable on
# any system. See also `env_all`, `expand_env`.
function env(name: str) -> str?
    return variables.value_of(name)

# The value of the environment variable `name` as the bytes the system holds,
# UTF-8 or not.
#
# - `name`: the variable's name, as `env` reads it.
#
# Fails as `env` does, but never `not_text`.
function env_bytes(name: str) -> [u8]?
    return variables.bytes_of(name)

# Every variable of the environment, name to value, in the order the system
# holds them. Fails `not_text` where a name or a value is not UTF-8
# (`env_all_bytes` reads them), and with the system's code where it cannot be
# read. An entry with no `=`, or one whose name is empty, as Windows' own
# `=C:` are, is left out, so every name here is one `env` reads; where a name
# stands twice its first value is kept, the one `env` answers.
function env_all() -> {str: str}?
    return variables.as_map()

# Every variable of the environment as the bytes the system holds, in its
# order, left out and kept as `env_all` leaves and keeps them. Fails with the
# system's code where the environment cannot be read.
function env_all_bytes() -> [RawVariable]?
    every = variables.entries()?
    out: [RawVariable] @= []
    at: i64 @= 0

    while at < every.names.len()
        out @ out.push(RawVariable(name: every.names[at], value: every.values[at]))
        at @ at + 1

    return ok(out)

# `s` with each `$NAME` and `${NAME}` replaced by what `lookup` answers for
# `NAME`, a name being ASCII letters, digits and `_`.
#
# - `s`: the text to expand; `$$` writes one `$`, and a `$` before anything
#   else stays as it is written.
# - `lookup`: called once for each place a name stands, with the name; what
#   it answers stands there, and its failure is the call's.
#
# Fails with `lookup`'s own error where it fails, and `invalid` where a `${`
# has no `}` or holds what is not a name. See also `expand_env`.
function expand(s: str, lookup: (function(str) -> str?)) -> str?
    return expansion.expanded(s, lookup: lookup)

# `s` with each `$NAME` and `${NAME}` replaced by the environment's value, as
# `expand` reads them.
#
# - `s`: the text to expand.
#
# Fails `not_found` naming the first variable that is not set, never writing
# it as empty, and as `env` fails for a value.
function expand_env(s: str) -> str?
    return expansion.expanded(s, lookup: env)

## The working folder and the user's folders

# The working folder, absolute, every link on the way followed. Fails
# `not_text` where its path is not UTF-8, and `failed` with the system's
# number where it cannot be read: removed, or a folder above it not this
# user's to search.
function working_dir() -> str?
    status: i64 @= -1
    marks: i64 @= -1
    here = hero_os.resolved_shown(".", status: @status, marks: @marks)

    if status == hero_os.HERO_OS_NOT_TEXT
        return fail(code: codes.NOT_TEXT, msg: "the working folder's path is not UTF-8")

    if status != hero_os.HERO_OS_OK
        return fail(
            code: codes.FAILED,
            msg: f"the working folder cannot be read: the system's number {hero_os.fs_why()}"
        )
    return ok(here)

# Makes `path` the working folder, which every relative path is read in from
# then on.
#
# - `path`: the folder to enter; a relative one is read in the old working
#   folder.
#
# The folder is the process's, one for all its threads: a thread that reads a
# relative path while another changes it may read either folder. Fails
# `file_not_found` where `path` names nothing, `not_a_directory` where it
# names no folder, `permission` where the folder is not this user's to enter,
# and `invalid` where `path` is empty of meaning to the system or holds a zero
# byte. See also `working_dir`.
function change_dir(path: str) -> ()?
    if codes.has_zero(path)
        return fail(code: codes.INVALID, msg: "a path holding a zero byte names no folder")

    if hero_disk.enter(path) != 0
        return codes.disk_failed(asked: f"entering \"{path}\"")
    return ok()

# The system's folder for temporary files: on POSIX `TMPDIR` where it is set
# and not empty, else `/tmp`; on Windows the system's own. It is named, never
# made nor asked whether it is there. Fails `not_text` where its path is not
# UTF-8.
function temp_dir() -> str?
    return filled.text_of(.temp)

# The user's home folder: on POSIX `HOME`, or where that is unset or empty the
# one the system's record of the user names; on Windows the profile folder.
# Fails `not_found` where neither names one, `not_text` where its path is not
# UTF-8. It is named, never made nor asked whether it is there.
function home_dir() -> str?
    return filled.text_of(.home)

# The folder every program keeps what it can make again in, each under a name
# of its own: `Library/Caches` under the home folder on Darwin,
# `XDG_CACHE_HOME` where it is absolute or else `.cache` under the home folder
# on every other POSIX, the local application data on Windows. Fails as
# `home_dir` does.
function cache_dir() -> str?
    return filled.text_of(.cache)

# The folder every program keeps its settings in, each under a name of its
# own: `Library/Application Support` under the home folder on Darwin,
# `XDG_CONFIG_HOME` where it is absolute or else `.config` under the home
# folder on every other POSIX, the roaming application data on Windows. Fails
# as `home_dir` does.
function config_dir() -> str?
    return filled.text_of(.settings)

# The folder every program keeps the data it makes and reads again in, each
# under a name of its own.
#
# On Darwin `Library/Application Support` under the home folder; on every
# other POSIX `XDG_DATA_HOME` where it is absolute, else `.local/share` under
# the home folder, as the XDG Base Directory specification says; on Windows
# the known folder of the roaming application data. It is named, never made
# nor asked whether it is there.
#
# Fails as `home_dir` does. See also `state_dir`, `cache_dir`, `config_dir`.
function data_dir() -> str?
    return filled.text_of(.data)

# The folder every program keeps in what outlasts a restart but is not worth
# carrying to another machine, a history, a log, where a window stood, each
# under a name of its own.
#
# On Darwin `Library/Application Support` under the home folder, as for
# data: Apple names no folder of state apart; on every other POSIX
# `XDG_STATE_HOME` where it is absolute, else `.local/state` under the home
# folder; on Windows the known folder of the local application data, which
# stays on the machine. It is named, never made nor asked whether it is
# there.
#
# Fails as `home_dir` does. See also `data_dir`, `runtime_dir`.
function state_dir() -> str?
    return filled.text_of(.state)

# The folder of the user's own sockets, pipes and locks, private to the user
# and gone with the session, each program's under a name of its own.
#
# On Darwin the user's own temporary folder, which the system makes for each
# user and readable by that user alone; on every other POSIX
# `XDG_RUNTIME_DIR` where it is absolute. It is named, never made nor asked
# whether it is there.
#
# Fails `not_found` where `XDG_RUNTIME_DIR` is unset, which the XDG
# specification leaves the program to answer, `unsupported` on Windows, which
# keeps no such folder, and `not_text` where the path is not UTF-8. See also
# `temp_dir`, `state_dir`.
function runtime_dir() -> str?
    return filled.text_of(.runtime)

# The path of the program's own executable, absolute and with its links
# followed. Fails `not_found` where the machine gives none (a Linux with no
# `/proc`), never guessing from the program's first argument, and `not_text`
# where the path is not UTF-8.
function executable_path() -> str?
    status: i64 @= -1
    marks: i64 @= -1
    exe = hero_os.exe_path_shown(status: @status, marks: @marks)

    if status == hero_os.HERO_OS_NOT_FOUND
        return fail(code: codes.NOT_FOUND, msg: "this machine gives no path for the program's executable")

    if status == hero_os.HERO_OS_NOT_TEXT
        return fail(code: codes.NOT_TEXT, msg: "the executable's path is not UTF-8")

    if status != hero_os.HERO_OS_OK
        return fail(code: codes.FAILED, msg: f"the executable's path cannot be read (status {status})")
    return ok(exe)

## Opening in the default application

# Opens `url` in the application the user's system keeps for it, a browser
# or a mail program, and returns once the system has taken it.
#
# - `url`: an absolute URL of the scheme `http`, `https` or `mailto`, in any
#   case, with no white space and no control character: `https://example.com`.
#
# On Darwin `open` is run with `url` as its one argument, on every other
# POSIX `xdg-open`, each with no shell between and waited for; on Windows
# `ShellExecuteW` opens it.
#
# Fails `invalid` where `url` is not such a URL: another scheme may start any
# program that registered it, so it is refused here, and a path is
# `open_path`'s. Fails `not_found` where the launcher is not on the machine
# (no `xdg-open`), `unsupported` where the system keeps no application for
# it, and `failed` where the launcher ended otherwise, with its exit status.
#
# See also `open_path`.
function open_url(url: str) -> ()?
    opening.check_url(url)?

    if hero_sys.open(url) != 0
        return codes.sys_failed(asked: f"opening \"{url}\"")
    return ok()

# Opens the file or the folder `path` names in the application the user's
# system keeps for its kind, and returns once the system has taken it.
#
# - `path`: absolute, or relative to the working folder; one that begins with
#   `-` is handed as `./` and the path, so no launcher reads it as an option.
#
# It is opened as `open_url` opens a URL: `open`, `xdg-open` or
# `ShellExecuteW`.
#
# Fails `file_not_found` where `path` names nothing, asked before the
# launcher is, `invalid` where it is empty or holds a zero byte,
# `unsupported` where the system keeps no application for its kind, and
# `failed` where the launcher ended otherwise.
#
# See also `open_url`.
function open_path(path: str) -> ()?
    if path.len() == 0 || codes.has_zero(path)
        return fail(code: codes.INVALID, msg: "an empty path, or one holding a zero byte, names nothing to open")
    none: [i64] @= []

    if hero_disk.facts_through(path, @none, n: 0) < 0
        return codes.disk_failed(asked: f"opening \"{path}\"")

    if hero_sys.open(opening.launch_target(path)) != 0
        return codes.sys_failed(asked: f"opening \"{path}\"")
    return ok()

## Who runs the process, and where

# What `terminal_size` answers: how many characters the terminal shows.
record TerminalSize
    # Characters in a line, above 0.
    columns: i64
    # Lines on the screen, above 0.
    rows: i64

# Which system a program runs on, the one it was built for: Darwin, Linux,
# Windows, or another that keeps POSIX's rules.
variant System
    # Darwin, the kernel of macOS.
    darwin
    # Linux.
    linux
    # Windows.
    windows
    # A system that keeps POSIX's rules and is neither Darwin nor Linux.
    other

# Which processor architecture a program is built for: x86-64, arm64, or
# another.
variant Architecture
    # 64-bit x86, which some systems name `amd64`.
    x86_64
    # 64-bit Arm, which some systems name `aarch64`.
    arm64
    # Any other.
    other

# What `process_times` answers: the processor time the process has spent,
# every thread of it counted.
record ProcessTimes
    # Nanoseconds spent running the program's own code.
    user_ns: i64
    # Nanoseconds the system spent working on the program's behalf.
    system_ns: i64

# What `load_average` answers: how many processes were running or waiting to
# run, on average, each in thousandths, so 1500 is one and a half.
record LoadAverage
    # Over the last minute.
    one_minute: i64
    # Over the last five minutes.
    five_minutes: i64
    # Over the last fifteen minutes.
    fifteen_minutes: i64

# What `memory` answers: the machine's memory in bytes, read at one moment.
# `available_bytes` is never above `total_bytes`, and both are above 0.
record Memory
    # Bytes of memory the system manages, all of it.
    total_bytes: i64
    # Bytes the system could give programs now without writing anything out
    # to disk, from 0 to `total_bytes`.
    available_bytes: i64

# The suffix an executable's file takes on this system: `.exe` on Windows,
# where a program without it cannot be started, and "" on every other.
function executable_suffix() -> str
    return hero_os.run_exe_suffix()

# The process's own id, as the system numbers it.
function pid() -> i64
    return hero_os.os_pid()

# The id of the process that started this one. On POSIX, once that one has
# ended, the id of the one the system gave this process to; on Windows the id
# recorded when this process was made, which may by now name another. Fails
# with the system's code where it cannot be read.
function parent_pid() -> i64?
    return codes.sys_number(hero_sys.parent_pid(), asked: "the parent's id")

# The id of the user who started the process. Fails `unsupported` on Windows,
# which names its users otherwise.
function user_id() -> i64?
    return codes.sys_number(hero_sys.user_id(), asked: "the user's id")

# The id of the user whose rights the process has. Fails `unsupported` on
# Windows.
function effective_user_id() -> i64?
    return codes.sys_number(hero_sys.effective_user_id(), asked: "the effective user's id")

# The id of the group the process was started in. Fails `unsupported` on
# Windows.
function group_id() -> i64?
    return codes.sys_number(hero_sys.group_id(), asked: "the group's id")

# The id of the group whose rights the process has. Fails `unsupported` on
# Windows.
function effective_group_id() -> i64?
    return codes.sys_number(hero_sys.effective_group_id(), asked: "the effective group's id")

# The ids of the other groups the process belongs to, in the system's order.
# Whether the effective group is among them is the system's choice, and Darwin
# tells at most sixteen. Fails `unsupported` on Windows.
function group_ids() -> [i64]?
    return filled.group_ids()

# The machine's host name: the kernel's on POSIX, qualified or not as the
# machine was set up; the computer's DNS name on Windows, never qualified.
# Fails `not_text` where it is not UTF-8, and with the system's code where it
# cannot be read.
function host_name() -> str?
    return filled.text_of(.host_name)

# The bytes of one page of memory. Fails with the system's code where it
# cannot be read.
function page_size() -> i64?
    return codes.sys_number(hero_sys.page_size(), asked: "the size of a page")

# How many processors the program may run on at once, at least 1: on Linux
# the ones its thread is allowed, a container's set heeded and its quota of
# time not; on Darwin the ones online; on Windows the ones of the process's
# mask. Fails with the system's code where it cannot be read.
function processor_count() -> i64?
    return codes.sys_number(hero_sys.processor_count(), asked: "the count of processors")

# The system the program runs on, the one it was built for.
#
# `other` is a system that keeps POSIX's rules and is neither Darwin nor Linux,
# so `system() != .windows` asks whether POSIX's rules hold; how a path is
# written there is `path.system_rules`'s. Nothing is asked of the machine, so
# it never fails.
function system() -> System
    named = hero_sys.system()

    if named == hero_sys.HERO_SYS_SYSTEM_DARWIN
        return .darwin

    if named == hero_sys.HERO_SYS_SYSTEM_LINUX
        return .linux

    if named == hero_sys.HERO_SYS_SYSTEM_WINDOWS
        return .windows
    return .other

# The processor architecture the program was built for.
#
# A program built for x86-64 and run by a translator on an Arm machine answers
# `x86_64`. Nothing is asked of the machine, so it never fails.
function architecture() -> Architecture
    built = hero_sys.architecture()

    if built == hero_sys.HERO_SYS_ARCH_X86_64
        return .x86_64

    if built == hero_sys.HERO_SYS_ARCH_ARM64
        return .arm64
    return .other

# The system's version as the system writes it.
#
# Fails `not_text` where it is not UTF-8, and with the system's code where it
# cannot be read. On POSIX it is the kernel's release, as `uname -r` prints it,
# which on Darwin is the kernel's number and not macOS's own, though the two
# may agree; on Windows it is `major.minor.build`.
function system_version() -> str?
    return filled.text_of(.version)

# The name of the user the process runs as.
#
# Fails `not_found` where the machine names none, `not_text` where it is not
# UTF-8, and with the system's code where it cannot be read. On POSIX it is the
# name the system's record of the effective user holds, or `USER` where no
# record names one; on Windows the thread's user, without its domain.
function user_name() -> str?
    return filled.text_of(.user_name)

# The processor time the process has spent so far, in its own code and in the
# system's on its behalf, every thread counted.
#
# Fails with the system's code where it cannot be read. The system counts it in
# steps of its own, so two readings close together may be equal; a later one
# is never less.
function process_times() -> ProcessTimes?
    user_ns: i64 @= 0
    system_ns: i64 @= 0

    if hero_sys.process_times(user_ns: @user_ns, system_ns: @system_ns) != 0
        return codes.sys_failed(asked: "the process's processor time")
    return ok(ProcessTimes(user_ns: user_ns, system_ns: system_ns))

# The system's load averages over the last one, five and fifteen minutes, in
# thousandths, in one reading.
#
# Fails `unsupported` on Windows, which keeps no such average, and with the
# system's code where it cannot be read.
function load_average() -> LoadAverage?
    one: i64 @= 0
    five: i64 @= 0
    fifteen: i64 @= 0

    if hero_sys.load_average(one: @one, five: @five, fifteen: @fifteen) != 0
        if hero_sys.last_error() == hero_sys.HERO_SYS_UNSUPPORTED
            return fail(code: codes.UNSUPPORTED, msg: "this system keeps no load averages")
        return codes.sys_failed(asked: "the load averages")
    return ok(LoadAverage(one_minute: one, five_minutes: five, fifteen_minutes: fifteen))

# The machine's memory, all of it and what is available now, in bytes, in one
# reading.
#
# What counts as available is each system's own: on Darwin the free and the
# inactive pages, the ones the compressor holds not counted; on Linux the
# kernel's `MemAvailable`, or where it gives none its free and buffer memory,
# which is less; on Windows the standby, free and zeroed memory. A container's
# limit is not read, so inside one both are the host's.
#
# Fails `unsupported` on a POSIX system neither Darwin nor Linux, and with the
# system's code where it cannot be read. See also `page_size`.
function memory() -> Memory?
    total: i64 @= 0
    available: i64 @= 0

    if hero_sys.memory(total: @total, available: @available) != 0
        if hero_sys.last_error() == hero_sys.HERO_SYS_UNSUPPORTED
            return fail(
                code: codes.UNSUPPORTED,
                msg: "the memory of this system is not read: Darwin, Linux and Windows are"
            )
        return codes.sys_failed(asked: "the machine's memory")
    return ok(Memory(total_bytes: total, available_bytes: available))

## What a monitor reads

# What `cpu_times` answers: the time every processor of the machine has spent
# since it started, summed over the processors, in microseconds, read at one
# moment. Two readings make a share of busy time: `cpu_usage`.
record CpuTimes
    # Microseconds running programs' own code, niced ones included.
    user_us: i64
    # Microseconds running the system's own code, interrupts included.
    system_us: i64
    # Microseconds idle.
    idle_us: i64
    # Microseconds idle while a read or a write was waited for: Linux's
    # `iowait`; 0 on Darwin and Windows, whose idle holds it.
    waiting_us: i64
    # Microseconds a hypervisor took for another machine: Linux's `steal`; 0
    # on Darwin and Windows.
    stolen_us: i64

# What `process_usage` answers: what a process holds and has spent, read at
# one moment.
record ProcessUsage
    # Bytes of its memory in RAM now: its resident set, on Windows its working
    # set.
    resident_bytes: i64
    # Bytes of its virtual memory: on Darwin and Linux the size of its address
    # space, which on Darwin is hundreds of gigabytes for any program; on
    # Windows the bytes committed for it alone.
    virtual_bytes: i64
    # Nanoseconds spent running its own code, every thread counted.
    user_ns: i64
    # Nanoseconds the system spent working on its behalf.
    system_ns: i64

# What `network_counters` answers for one network interface: what it has
# carried since the machine started, every count at or above 0. A count goes
# back to 0 where the system starts it again: an interface removed and added,
# a driver reloaded.
record NetworkCounters
    # The interface's name: `en0` on Darwin, `eth0` on Linux, the name a
    # person gave it on Windows (`Ethernet`, `Wi-Fi`).
    name: str
    # Bytes received.
    bytes_received: i64
    # Bytes sent.
    bytes_sent: i64
    # Packets received.
    packets_received: i64
    # Packets sent.
    packets_sent: i64
    # Packets received with an error.
    errors_received: i64
    # Packets the interface failed to send.
    errors_sent: i64
    # Packets received and dropped.
    dropped_received: i64
    # Packets dropped before they were sent: on Darwin those of the send
    # queue, counted in 32 bits.
    dropped_sent: i64

# The time every processor of the machine has spent since it started, summed,
# in microseconds, in one reading.
#
# On Darwin the ticks each processor counts, a hundredth of a second each,
# which start again from 0 after about 497 days of one processor's time; on
# Linux `/proc/stat`'s first line; on Windows `GetSystemTimes`. Time the
# machine spent asleep is no processor's.
#
# Fails `unsupported` on a POSIX system neither Darwin nor Linux, and with the
# system's code where it cannot be read. See also `cpu_usage`.
function cpu_times() -> CpuTimes?
    user: i64 @= 0
    system_us: i64 @= 0
    idle: i64 @= 0
    waiting: i64 @= 0
    stolen: i64 @= 0

    if hero_sys.cpu_times(user_us: @user, system_us: @system_us, idle_us: @idle, waiting_us: @waiting, stolen_us: @stolen) != 0
        if hero_sys.last_error() == hero_sys.HERO_SYS_UNSUPPORTED
            return fail(
                code: codes.UNSUPPORTED,
                msg: "the processors' time of this system is not read: Darwin, Linux and Windows are"
            )
        return codes.sys_failed(asked: "the processors' time")
    return ok(CpuTimes(user_us: user, system_us: system_us, idle_us: idle, waiting_us: waiting, stolen_us: stolen))

# The share of the machine's processors' time that was busy between two
# readings, in percent, from 0.0 to 100.0, as psutil's `cpu_percent` answers.
#
# - `before`: the earlier reading of `cpu_times`.
# - `after`: a later reading of the same machine.
#
# Busy is the user's, the system's and the stolen time; idle and waiting are
# not. Two readings within one tick of the system's clock answer 0.0, nothing
# having been counted between them. The program waits between the two itself,
# a second for a reading as `top` shows one.
#
# Fails `invalid` where a time of `after` is below the same time of `before`:
# the two are not two readings of one machine in order, or a count started
# again. See also `cpu_times`.
function cpu_usage(before: CpuTimes, after: CpuTimes) -> f64?
    if after.user_us < before.user_us || after.system_us < before.system_us || after.idle_us < before.idle_us
        return fail(
            code: codes.INVALID,
            msg: "`after` holds less time than `before`: not a later reading of the same machine"
        )

    if after.waiting_us < before.waiting_us || after.stolen_us < before.stolen_us
        return fail(
            code: codes.INVALID,
            msg: "`after` holds less time than `before`: not a later reading of the same machine"
        )
    user = (after.user_us - before.user_us).to_f64()
    busy = user + (after.system_us - before.system_us).to_f64() + (after.stolen_us - before.stolen_us).to_f64()
    idle = (after.idle_us - before.idle_us).to_f64() + (after.waiting_us - before.waiting_us).to_f64()

    if busy + idle == 0.0
        return ok(0.0)
    return ok(busy / (busy + idle) * 100.0)

# What the process `id` holds and has spent, read at one moment: its
# resident and virtual memory, and its time in its own code and the system's.
#
# - `id`: the system's id of the process, `pid()` for this one; above 0.
#
# A process that has ended and is not yet waited for answers what the system
# still keeps of it: on Linux its times and a resident memory of 0, on Darwin
# `not_found`.
#
# Fails `invalid` for an id below 1, `not_found` where no process has it,
# `permission` where the system does not let this process read that one (on
# Darwin a process of another user), `unsupported` on a POSIX system neither
# Darwin nor Linux, and with the system's code where it cannot be read. An id
# names whichever process holds it now: one that ended may have given its id
# to another. See also `process_times`, `process.usage_of`.
function process_usage(id: i64) -> ProcessUsage?
    if id < 1
        return fail(code: codes.INVALID, msg: f"no process has the id {id}: ids are above 0")
    resident: i64 @= 0
    virtual_bytes: i64 @= 0
    user: i64 @= 0
    system_ns: i64 @= 0

    if hero_sys.process_usage(pid: id, resident: @resident, virtual_bytes: @virtual_bytes, user_ns: @user, system_ns: @system_ns) != 0
        kind = hero_sys.last_error()

        if kind == hero_sys.HERO_SYS_NOT_FOUND
            return fail(code: codes.NOT_FOUND, msg: f"no process has the id {id}")

        if kind == hero_sys.HERO_SYS_INVALID
            return fail(code: codes.INVALID, msg: f"no process has the id {id}: the system's ids are smaller")

        if kind == hero_sys.HERO_SYS_UNSUPPORTED
            return fail(
                code: codes.UNSUPPORTED,
                msg: "another process is not read on this system: Darwin, Linux and Windows are"
            )
        return codes.sys_failed(asked: f"the usage of the process {id}")
    return ok(ProcessUsage(resident_bytes: resident, virtual_bytes: virtual_bytes, user_ns: user, system_ns: system_ns))

# The counters of every network interface of the machine, in the system's
# order, each since the machine started.
#
# On Darwin the interface MIB's exact counts, each interface read in turn; on
# Linux `/proc/net/dev`; on Windows `GetIfTable2`, filter interfaces left out
# since they count again what the interface below them counts. A rate is two
# readings apart, the program's own clock between them.
#
# Fails `unsupported` on a POSIX system neither Darwin nor Linux, `not_text`
# where an interface's name is not UTF-8, and with the system's code where
# they cannot be read.
function network_counters() -> [NetworkCounters]?
    found = counters.interfaces_of(filled.bytes_of(.network)?)?
    answer: [NetworkCounters] @= []

    for one in found
        c = one.counters
        answer @ answer.push(
            NetworkCounters(name: one.name, bytes_received: c[0], bytes_sent: c[1], packets_received: c[2], packets_sent: c[3], errors_received: c[4], errors_sent: c[5], dropped_received: c[6], dropped_sent: c[7])
        )

    return ok(answer)

## Random bytes and the terminal

# `count` bytes from the system's generator for keys, fit for a unique name or
# a key.
#
# - `count`: how many bytes, 0 or more.
#
# Fails `invalid` where `count` is below 0, and with the system's code where
# the generator refuses. On Linux it may wait, early in the machine's start,
# until the generator is ready. Numbers drawn from a seed, repeatable, are
# `random`'s.
function random_bytes(count: i64) -> [u8]?
    if count < 0
        return fail(code: codes.INVALID, msg: f"{count} random bytes asked: a count is 0 or more")
    buffer: [u8] @= []

    if hero_sys.random(@buffer, n: count.to_u64().must()) < 0
        return codes.sys_failed(asked: f"{count} random bytes")
    return ok(buffer)

# The size of the terminal the process's standard output is, in one reading.
# Fails `unsupported` where that output is a file, a pipe, none at all, or a
# terminal that tells no size.
function terminal_size() -> TerminalSize?
    columns: i64 @= 0
    rows: i64 @= 0

    if hero_sys.terminal_size(columns: @columns, rows: @rows) != 0
        if hero_sys.last_error() == hero_sys.HERO_SYS_UNSUPPORTED
            return fail(code: codes.UNSUPPORTED, msg: "the standard output is not a terminal that tells its size")
        return codes.sys_failed(asked: "the terminal's size")
    return ok(TerminalSize(columns: columns, rows: rows))

## The program's stop

# Makes Ctrl-C and SIGTERM, on Windows Ctrl-C, Ctrl-Break and the console
# closing, ask the program's stop instead of ending it; a second one still
# ends it. From the first, every call of the library that waits on the system
# (a socket's, a TLS stream's, a serial port's, a poller's, a watcher's, a
# channel's) fails `stopped`, on every thread, so a program ends its loops and
# closes what it holds.
#
# Fails `invalid` where `count_signal` counts `.interrupt` or `.terminate`
# already, since a signal is the stop's or a count's for the process's life,
# and `failed` where the system refuses. It changes the whole process, and a
# second call changes nothing. See also `ask_stop`, `is_stop_asked`,
# `count_signal`.
function catch_stop() -> ()?
    if hero_stop.catch_stop() != 0
        if hero_stop.last_error() == hero_stop.HERO_NET_INVALID
            return fail(
                code: codes.INVALID,
                msg: "catching the stop: `count_signal` counts Ctrl-C or SIGTERM already, and a signal is the stop's or a count's, never both"
            )
        return fail(
            code: codes.FAILED,
            msg: f"catching the stop: the system refused, its error {hero_stop.last_os_error()}"
        )
    return ok()

# Asks the program's own stop, from any thread: from this call every call
# that waits fails `stopped`, as after a signal `catch_stop` caught. A stop
# once asked stays asked for the rest of the process. See also
# `is_stop_asked`.
function ask_stop()
    hero_stop.ask_stop()

# Whether the stop was asked, by a signal after `catch_stop` or by
# `ask_stop`: a loop that works between its waits asks it between two pieces
# of work.
function is_stop_asked() -> bool
    return hero_stop.stop_asked() == 1

## Signals

# A signal, named the same on every platform, where each system numbers it its
# own way (`signal_number`). `count_signal` counts one the program receives.
variant Signal
    # SIGHUP: the terminal the program ran in has gone.
    hangup
    # SIGINT: Ctrl-C at the terminal; on Windows Ctrl-C and Ctrl-Break.
    interrupt
    # SIGQUIT: Ctrl-\ at the terminal.
    quit
    # SIGKILL: the end at once, which no program can count or refuse.
    kill
    # SIGUSR1, which means what the program that receives it says it means.
    user1
    # SIGUSR2, which means what the program that receives it says it means.
    user2
    # SIGTERM: the request to end that `kill`, `timeout` and a service
    # manager send.
    terminate
    # SIGCHLD: a child of the program ended, stopped or went on.
    child
    # SIGCONT: a stopped process goes on, whether or not it counts the signal.
    resume
    # SIGSTOP: a stop no program can count or refuse.
    stop
    # SIGTSTP: Ctrl-Z at the terminal, a stop a program may count instead.
    terminal_stop
    # SIGTTIN: a process outside the terminal's foreground read from it.
    terminal_input
    # SIGTTOU: a process outside the terminal's foreground wrote to it or
    # changed it.
    terminal_output
    # SIGWINCH: the terminal's window changed its size.
    window_changed

# Makes each `signal` the program receives counted, for `take_signals` to
# answer, instead of doing what it would: ending the program, stopping it, or
# nothing. Ctrl-C counted so never ends the program, however many times it
# comes, which a shell or a REPL that runs its children in front needs.
#
# - `signal`: the signal to count; `.kill` and `.stop` no program can.
#
# Fails `invalid` for `.kill` and `.stop`, and for `.interrupt` and
# `.terminate` once `catch_stop` made them the program's stop, since a signal
# is the stop's or a count's for the process's life; `unsupported` where no
# such signal comes on this platform, on Windows every one but `.interrupt`,
# which is Ctrl-C and Ctrl-Break there; and `failed` where the system
# refuses.
#
# It changes the whole process, and a second call changes nothing. A signal
# the program inherited ignored stays ignored, so a job a shell started with
# `&` hears no Ctrl-C; a child the program starts begins with the signal at
# its default. See also `take_signals`, `catch_stop`.
function count_signal(signal: Signal) -> ()?
    asked = f"counting {signal_name(signal)}"

    if signal == .kill || signal == .stop
        return fail(code: codes.INVALID, msg: f"{asked}: the system acts on it alone, and no program can count it")
    number = signal_number(signal)?
    sig = number.to_i32().must()

    if signal == .interrupt || signal == .terminate
        if hero_stop.count_signal(sig) != 0
            kind = hero_stop.last_error()

            if kind == hero_stop.HERO_NET_INVALID
                return fail(
                    code: codes.INVALID,
                    msg: f"{asked}: `catch_stop` made it the program's stop already, and a signal is the stop's or a count's, never both"
                )

            if kind == hero_stop.HERO_NET_UNSUPPORTED
                return fail(code: codes.UNSUPPORTED, msg: f"{asked}: nothing sends one to a program on this system")
            return fail(code: codes.FAILED, msg: f"{asked}: the system refused, its error {hero_stop.last_os_error()}")
        return ok()

    if hero_os.signal_watch(sig) != 0
        return fail(code: codes.FAILED, msg: f"{asked}: the system refused the handler or the pipe that counts it")
    return ok()

# How many times `signal` came since the last call, the count set back to 0;
# 0 for a signal `count_signal` does not count.
#
# - `signal`: the signal counted.
#
# The system joins a signal sent while the same one waits to be delivered, so
# a burst is counted short of what was sent.
function take_signals(signal: Signal) -> i64
    return match signal_number(signal)
        .ok n  => hero_os.signal_take(n.to_i32().must())
        .err _ => 0

# The number this platform gives `signal`: the number `process.Status` holds
# for a signal that ended a child. SIGTSTP is 18 on macOS and 20 on Linux.
#
# - `signal`: the signal.
#
# Fails `unsupported` where no such signal comes on this platform: on Windows
# every one but `.interrupt`. See also `signal_of`.
function signal_number(signal: Signal) -> i64?
    name = match signal
        .hangup          => hero_os.HERO_SIGNAL_HANGUP
        .interrupt       => hero_os.HERO_SIGNAL_INTERRUPT
        .quit            => hero_os.HERO_SIGNAL_QUIT
        .kill            => hero_os.HERO_SIGNAL_KILL
        .user1           => hero_os.HERO_SIGNAL_USER1
        .user2           => hero_os.HERO_SIGNAL_USER2
        .terminate       => hero_os.HERO_SIGNAL_TERMINATE
        .child           => hero_os.HERO_SIGNAL_CHILD
        .resume          => hero_os.HERO_SIGNAL_CONTINUE
        .stop            => hero_os.HERO_SIGNAL_STOP
        .terminal_stop   => hero_os.HERO_SIGNAL_TERMINAL_STOP
        .terminal_input  => hero_os.HERO_SIGNAL_TERMINAL_INPUT
        .terminal_output => hero_os.HERO_SIGNAL_TERMINAL_OUTPUT
        .window_changed  => hero_os.HERO_SIGNAL_WINDOW

    number = hero_os.signal_number(name)

    if number < 0
        return fail(code: codes.UNSUPPORTED, msg: f"{signal_name(signal)} comes to no program on this system")
    return ok(number.to_i64().must())

# The signal this platform numbers `number`.
#
# - `number`: a signal's number, as a `process.Status` holds it.
#
# Fails `not_found` where it is none of the signals `Signal` names on this
# platform. See also `signal_number`.
function signal_of(number: i64) -> Signal?
    every: [Signal] = [
        .hangup
        .interrupt
        .quit
        .kill
        .user1
        .user2
        .terminate
        .child
        .resume
        .stop
        .terminal_stop
        .terminal_input
        .terminal_output
        .window_changed
    ]

    for one in every
        match signal_number(one)
            .ok n =>
                if n == number
                    return ok(one)
            .err _ => _ = 0

    return fail(code: codes.NOT_FOUND, msg: f"{number} is the number of no signal `Signal` names on this system")

# The name POSIX gives `signal`, as a shell's `kill -l` writes it: `SIGINT`
# for `.interrupt`.
#
# - `signal`: the signal.
function signal_name(signal: Signal) -> str
    return match signal
        .hangup          => "SIGHUP"
        .interrupt       => "SIGINT"
        .quit            => "SIGQUIT"
        .kill            => "SIGKILL"
        .user1           => "SIGUSR1"
        .user2           => "SIGUSR2"
        .terminate       => "SIGTERM"
        .child           => "SIGCHLD"
        .resume          => "SIGCONT"
        .stop            => "SIGSTOP"
        .terminal_stop   => "SIGTSTP"
        .terminal_input  => "SIGTTIN"
        .terminal_output => "SIGTTOU"
        .window_changed  => "SIGWINCH"

## Tests

test "env: a set variable, one never set, the empty name, names holding = at either end, and a zero byte"
    assert env("PATH").must().len() > 0

    match env("REBEL_OS_NEVER_SET")
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    zero: [u8] = ['P', 0]

    for name in ["", "A=B", "=A", "A=", zero.validated_bytes().must()]
        match env(name)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "env_bytes: the bytes of a set variable's text, and the failures env has"
    path = env("PATH").must()
    bytes = env_bytes("PATH").must()
    assert bytes.len() == path.len()
    assert bytes.validated_bytes().must() == path
    assert env_bytes("REBEL_OS_NEVER_SET").is_err()
    assert env_bytes("").is_err()

test "env_all and env_all_bytes: PATH among them, every name read back by env, one order for both"
    every = env_all().must()
    raw = env_all_bytes().must()
    names = keys(every)
    assert names.len() == raw.len() && names.len() > 0
    assert every["PATH"].must() == env("PATH").must()
    at: i64 @= 0

    while at < raw.len()
        assert raw[at].name.validated_bytes().must() == names[at]
        assert env(names[at]).must() == every[names[at]].must()
        assert raw[at].value.validated_bytes().must() == every[names[at]].must()
        at @ at + 1

test "expand and expand_env: a name with and without braces, $$, a name not set, and braces unclosed"
    path = env("PATH").must()
    assert expand("é$PATH-${PATH}é$$PATH", lookup: env).must() == "é" + path + "-" + path + "é$PATH"
    assert expand("", lookup: env).must() == ""
    assert expand("$REBEL_OS_NEVER_SET", lookup: env).is_err()
    assert expand_env("[$PATH]").must() == "[" + path + "]"

    match expand_env("x ${REBEL_OS_NEVER_SET} y")
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND && e.msg == "the variable \"REBEL_OS_NEVER_SET\" is not set"

    match expand_env("${PATH")
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "working_dir and change_dir: absolute, the parent entered and left, and a missing path, a file, an empty one and a zero byte refused"
    here = working_dir().must()
    absolute = here[0] == '/' || here.len() > 2 && here[1] == ':'
    assert absolute
    change_dir("..").must()
    above = working_dir().must()
    assert above.len() < here.len() && here.slice(from: 0, to: above.len()) == above
    change_dir(here).must()
    assert working_dir().must() == here
    change_dir(".").must()
    assert working_dir().must() == here

    match change_dir("rebel-os-never-there")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    match change_dir(executable_path().must())
        .ok _  => assert false
        .err e => assert e.code == NOT_A_DIRECTORY

    zero: [u8] = ['.', 0]

    match change_dir(zero.validated_bytes().must())
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert change_dir("").is_err()
    assert working_dir().must() == here

test "temp_dir: TMPDIR without the separator at its end where it is set, /tmp where not, on POSIX"
    temp = temp_dir().must()
    assert temp.len() > 0

    if system() == .windows
        assert temp[temp.len() - 1] != '\\'
    else
        given = env("TMPDIR").default("")

        if given == ""
            assert temp == "/tmp"
        else
            assert temp != "/" && temp[temp.len() - 1] != '/'
            assert given.slice(from: 0, to: temp.len()) == temp

test "home_dir, cache_dir and config_dir: HOME on POSIX where it is set, and three folders apart"
    home = home_dir().must()
    cache = cache_dir().must()
    config = config_dir().must()
    assert home != cache && home != config && cache != config

    if system() == .windows
        assert home.len() > 2
    else
        given = env("HOME").default("")
        assert given == "" || home == given

test "executable_path, executable_suffix and system: an absolute file, one of two suffixes, the system they tell"
    exe = executable_path().must()
    suffix = executable_suffix()
    assert exe.len() > suffix.len()
    assert exe.slice(from: exe.len() - suffix.len(), to: exe.len()) == suffix

    if system() == .windows
        assert suffix == ".exe"
    else
        assert suffix == "" && exe[0] == '/'

test "pid and parent_pid: above 0, the same twice, and two processes"
    assert pid() > 0 && pid() == pid()
    parent = parent_pid().must()
    assert parent > 0 && parent != pid()

test "user_id, effective_user_id, group_id, effective_group_id, group_ids: numbers on POSIX, unsupported on Windows"
    ids: [i64?] = [user_id(), effective_user_id(), group_id(), effective_group_id()]

    for id in ids
        match id
            .ok n  => assert n >= 0 && system() != .windows
            .err e => assert e.code == UNSUPPORTED && system() == .windows

    match group_ids()
        .ok groups =>
            for g in groups
                assert g >= 0
        .err e => assert e.code == UNSUPPORTED && system() == .windows

test "host_name, page_size and processor_count: a name, a power of two, at least one"
    host = host_name().must()
    assert host.len() > 0 && !codes.has_zero(host)
    page = page_size().must()
    assert page > 0 && page & page - 1 == 0
    assert processor_count().must() >= 1

test "system and architecture: Windows or a system of POSIX's rules, and the same answers twice"
    match system()
        .windows                  => assert system() == .windows
        .darwin | .linux | .other => assert system() != .windows

    assert system() == system()
    assert architecture() == architecture()

test "system_version and user_name: text with no zero byte, the same on a second reading"
    version = system_version().must()
    assert version.len() > 0 && !codes.has_zero(version)
    assert system_version().must() == version
    name = user_name().must()
    assert name.len() > 0 && !codes.has_zero(name)
    assert user_name().must() == name

test "process_times: at or above 0, and a second reading never below the first"
    first = process_times().must()
    assert first.user_ns >= 0 && first.system_ns >= 0
    second = process_times().must()
    assert second.user_ns >= first.user_ns && second.system_ns >= first.system_ns

test "load_average: three averages at or above 0 on POSIX, unsupported on Windows"
    match load_average()
        .ok load =>
            assert system() != .windows
            assert load.one_minute >= 0 && load.five_minutes >= 0 && load.fifteen_minutes >= 0
        .err e => assert e.code == UNSUPPORTED && system() == .windows

test "memory: a total above 0, the available above 0 and never above it, read twice, or unsupported on another POSIX system"
    match memory()
        .ok first =>
            assert system() != .other
            assert first.total_bytes > 0 && first.available_bytes > 0
            assert first.available_bytes <= first.total_bytes
            second = memory().must()
            assert second.available_bytes <= second.total_bytes
        .err e => assert e.code == UNSUPPORTED && system() == .other

test "random_bytes: none, one, an odd count, two readings that differ, and counts below 0"
    assert random_bytes(0).must() == []
    assert random_bytes(1).must().len() == 1
    assert random_bytes(257).must().len() == 257
    assert random_bytes(32).must() != random_bytes(32).must()

    for count in [-1, -9223372036854775807 - 1]
        match random_bytes(count)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "terminal_size: columns and rows above 0, or unsupported where the output is no terminal"
    match terminal_size()
        .ok size => assert size.columns > 0 && size.rows > 0
        .err e   => assert e.code == UNSUPPORTED

test "cpu_times: five times at or above 0, the busy and the idle above 0, read twice in order, or unsupported on another POSIX system"
    match cpu_times()
        .ok first =>
            assert system() != .other
            assert first.user_us > 0 && first.system_us > 0 && first.idle_us > 0
            assert first.waiting_us >= 0 && first.stolen_us >= 0
            second = cpu_times().must()
            share = cpu_usage(before: first, after: second).must()
            assert share >= 0.0 && share <= 100.0
        .err e => assert e.code == UNSUPPORTED && system() == .other

test "cpu_usage: no time between, all busy, half, waiting counted idle, stolen counted busy, the largest times, and each time going back"
    zero = CpuTimes(user_us: 0, system_us: 0, idle_us: 0, waiting_us: 0, stolen_us: 0)
    assert cpu_usage(before: zero, after: zero).must() == 0.0
    busy = CpuTimes(user_us: 10, system_us: 30, idle_us: 0, waiting_us: 0, stolen_us: 0)
    assert cpu_usage(before: zero, after: busy).must() == 100.0
    half = CpuTimes(user_us: 25, system_us: 25, idle_us: 50, waiting_us: 0, stolen_us: 0)
    assert cpu_usage(before: zero, after: half).must() == 50.0
    waits = CpuTimes(user_us: 0, system_us: 0, idle_us: 0, waiting_us: 40, stolen_us: 0)
    assert cpu_usage(before: zero, after: waits).must() == 0.0
    steals = CpuTimes(user_us: 0, system_us: 0, idle_us: 75, waiting_us: 0, stolen_us: 25)
    assert cpu_usage(before: zero, after: steals).must() == 25.0
    most = 9223372036854775807
    largest = CpuTimes(user_us: most, system_us: most, idle_us: most, waiting_us: most, stolen_us: most)
    assert cpu_usage(before: zero, after: largest).must() == 60.0
    assert cpu_usage(before: largest, after: largest).must() == 0.0
    later = CpuTimes(user_us: 2, system_us: 2, idle_us: 2, waiting_us: 2, stolen_us: 2)
    backs = [
        CpuTimes(user_us: 1, system_us: 2, idle_us: 2, waiting_us: 2, stolen_us: 2)
        CpuTimes(user_us: 2, system_us: 1, idle_us: 2, waiting_us: 2, stolen_us: 2)
        CpuTimes(user_us: 2, system_us: 2, idle_us: 1, waiting_us: 2, stolen_us: 2)
        CpuTimes(user_us: 2, system_us: 2, idle_us: 2, waiting_us: 1, stolen_us: 2)
        CpuTimes(user_us: 2, system_us: 2, idle_us: 2, waiting_us: 2, stolen_us: 1)
    ]

    for back in backs
        match cpu_usage(before: later, after: back)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "process_usage: this process, its memory above 0 and its time growing, or unsupported on another POSIX system"
    match process_usage(pid())
        .ok first =>
            assert system() != .other
            assert first.resident_bytes > 0 && first.virtual_bytes > 0
            assert first.user_ns >= 0 && first.system_ns >= 0
            spent: i64 @= 0

            for i in range(from: 0, to: 200000)
                spent @ spent + i % 7

            assert spent > 0
            second = process_usage(pid()).must()
            assert second.user_ns >= first.user_ns && second.system_ns >= first.system_ns
        .err e => assert e.code == UNSUPPORTED && system() == .other

test "process_usage fails: ids 0 and below, an id past the system's, and an id nobody has"
    for id in [0, -1, -9223372036854775807 - 1, 9223372036854775807]
        match process_usage(id)
            .ok _  => assert false
            .err e => assert e.code == INVALID || e.code == UNSUPPORTED && system() == .other

    match process_usage(2147483647)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND || e.code == UNSUPPORTED && system() == .other

test "process_usage: the first process the system started is read, refused to another user, or not there"
    match process_usage(1)
        .ok usage => assert usage.resident_bytes >= 0 && usage.user_ns >= 0
        .err e    => assert e.code == PERMISSION || e.code == NOT_FOUND || e.code == UNSUPPORTED && system() == .other

test "network_counters: at least one interface, names not empty and not repeated, counts at or above 0, never less a moment later"
    match network_counters()
        .ok first =>
            assert system() != .other
            assert first.len() > 0
            names: {str: i64} @= {}

            for one in first
                assert one.name != "" && names[one.name].is_err()
                names[one.name] @ one.bytes_received
                assert one.bytes_received >= 0 && one.bytes_sent >= 0
                assert one.packets_received >= 0 && one.packets_sent >= 0
                assert one.errors_received >= 0 && one.errors_sent >= 0
                assert one.dropped_received >= 0 && one.dropped_sent >= 0

            for one in network_counters().must()
                match names[one.name]
                    .ok before => assert one.bytes_received >= before
                    .err _     => _ = 0
        .err e => assert e.code == UNSUPPORTED && system() == .other

test "open_url: every refusal is invalid and starts nothing"
    for url in ["", "example.com", "ftp://example.com", "file:///etc/hosts", "https://", "https://a b", "-a"]
        match open_url(url)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "open_path: empty and a zero byte invalid, a missing file file_not_found, nothing started"
    zeroed: [u8] = [97, 0, 98]

    for path in ["", zeroed.validated_bytes().must()]
        match open_path(path)
            .ok _  => assert false
            .err e => assert e.code == INVALID

    match open_path("-rebel-no-such-file")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

test "count_signal: the end at once and the stop refused, Ctrl-C counted with none come, a second call, then the stop refused"
    refused: [Signal] = [.kill, .stop]

    for one in refused
        match count_signal(one)
            .ok _  => assert false
            .err e => assert e.code == INVALID

    count_signal(.interrupt).must()
    count_signal(.interrupt).must()
    assert take_signals(.interrupt) == 0

    match catch_stop()
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "count_signal: Ctrl-C and SIGTERM refused once the stop is caught, SIGTERM unsupported on Windows"
    catch_stop().must()
    stops: [Signal] = [.interrupt, .terminate]

    for one in stops
        match count_signal(one)
            .ok _  => assert false
            .err e => assert e.code == INVALID || system() == .windows && one == .terminate && e.code == UNSUPPORTED

test "count_signal: every signal a program may count, each unsupported on Windows but Ctrl-C"
    countable: [Signal] = [
        .hangup
        .interrupt
        .quit
        .user1
        .user2
        .terminate
        .child
        .resume
        .terminal_stop
        .terminal_input
        .terminal_output
        .window_changed
    ]

    for one in countable
        match count_signal(one)
            .ok _  => assert system() != .windows || one == .interrupt
            .err e => assert system() == .windows && e.code == UNSUPPORTED && one != .interrupt

        assert take_signals(one) == 0

test "take_signals: 0 for a signal never counted, and the same at a second call"
    assert take_signals(.user2) == 0
    assert take_signals(.user2) == 0
    assert take_signals(.kill) == 0

test "signal_number and signal_of: every signal there and back, each number apart, POSIX's fixed numbers, and numbers no signal has"
    every: [Signal] = [
        .hangup
        .interrupt
        .quit
        .kill
        .user1
        .user2
        .terminate
        .child
        .resume
        .stop
        .terminal_stop
        .terminal_input
        .terminal_output
        .window_changed
    ]
    seen: {i64: bool} @= {}

    for one in every
        match signal_number(one)
            .ok n =>
                assert n > 0 && seen[n].is_err()
                seen[n] @ true
                assert signal_of(n).must() == one
            .err e => assert e.code == UNSUPPORTED && system() == .windows && one != .interrupt

    assert signal_number(.interrupt).must() == 2

    if system() != .windows
        assert signal_number(.hangup).must() == 1 && signal_number(.kill).must() == 9 && signal_number(.terminate).must() == 15

    for n in [0, -1, 65, 9223372036854775807, -9223372036854775807 - 1]
        match signal_of(n)
            .ok _  => assert false
            .err e => assert e.code == NOT_FOUND

test "signal_name: each signal's POSIX name, every one apart"
    every: [Signal] = [
        .hangup
        .interrupt
        .quit
        .kill
        .user1
        .user2
        .terminate
        .child
        .resume
        .stop
        .terminal_stop
        .terminal_input
        .terminal_output
        .window_changed
    ]
    seen: {str: bool} @= {}

    for one in every
        name = signal_name(one)
        assert name.len() > 3 && name.slice(from: 0, to: 3) == "SIG" && seen[name].is_err()
        seen[name] @ true

    assert signal_name(.resume) == "SIGCONT" && signal_name(.window_changed) == "SIGWINCH"

## Examples

# The folders the system searches for programs, and a variable never set.
test "env: PATH, and a variable never set"
    assert env("PATH").must().len() > 0
    assert env("REBEL_OS_EXAMPLE_NEVER_SET").is_err()

# A variable's bytes, which are its text where it is UTF-8.
test "env_bytes: PATH's bytes"
    assert env_bytes("PATH").must().len() == env("PATH").must().len()

# Every variable of the environment, each name one `env` reads.
test "env_all: every variable"
    assert env_all().must().len() > 0

# Every variable as the system holds its bytes.
test "env_all_bytes: every variable's bytes"
    for variable in env_all_bytes().must()
        assert variable.name.len() > 0

# A text expanded with the environment as its lookup, as a shell would.
test "expand: names looked up by a function"
    assert expand(s: "${PATH}", lookup: env).must() == env("PATH").must()
    assert expand(s: "costs $$5", lookup: env).must() == "costs $5"

# A path written with a variable in it, expanded.
test "expand_env: a variable in a path"
    assert expand_env("$PATH").must() == env("PATH").must()
    assert expand_env("$REBEL_OS_EXAMPLE_NEVER_SET/x").is_err()

# The folder the program stands in.
test "working_dir: where the program stands"
    assert working_dir().must().len() > 0

# The parent folder entered, then the folder the program stood in again.
test "change_dir: in and back"
    here = working_dir().must()
    change_dir("..").must()
    change_dir(here).must()
    assert working_dir().must() == here

# The folder for temporary files.
test "temp_dir: where temporary files go"
    assert temp_dir().must().len() > 0

# The user's home folder, where the machine names one.
test "home_dir: the user's home"
    match home_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == NOT_TEXT

# Where a program keeps what it can make again.
test "cache_dir: a program's cache"
    match cache_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == NOT_TEXT

# Where a program keeps its settings.
test "config_dir: a program's settings"
    match config_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == NOT_TEXT

# The program's own file, where the machine names it.
test "executable_path: the program's own file"
    match executable_path()
        .ok exe => assert exe.len() > 0
        .err e  => assert e.code == NOT_FOUND

# A program's file name, written as this system names one.
test "executable_suffix: a tool's file name"
    name = "tool" + executable_suffix()
    assert name == "tool" || name == "tool.exe"

# The process's own id, written into a lock file's name.
test "pid: a name only this process writes"
    assert pid() > 0
    assert ("lock." + to_str(pid())).len() > 5

# The process that started this one is another.
test "parent_pid: another process"
    assert parent_pid().must() != pid()

# The user's id on POSIX, none on Windows.
test "user_id: a number on POSIX"
    match user_id()
        .ok id => assert id >= 0
        .err e => assert e.code == UNSUPPORTED

# Whether the process runs with the rights of the system's own user.
test "effective_user_id: root or not"
    match effective_user_id()
        .ok id => assert id >= 0
        .err e => assert e.code == UNSUPPORTED

# The group the process was started in.
test "group_id: a number on POSIX"
    match group_id()
        .ok id => assert id >= 0
        .err e => assert e.code == UNSUPPORTED

# The group whose rights the process has.
test "effective_group_id: a number on POSIX"
    match effective_group_id()
        .ok id => assert id >= 0
        .err e => assert e.code == UNSUPPORTED

# The other groups the process belongs to.
test "group_ids: every one a number"
    match group_ids()
        .ok ids =>
            for id in ids
                assert id >= 0
        .err e => assert e.code == UNSUPPORTED

# The machine's name, as a log line writes it.
test "host_name: the machine's name"
    assert host_name().must().len() > 0

# The size of a page, a multiple of 4096 on every machine Rebel runs on.
test "page_size: a page of memory"
    assert page_size().must() % 4096 == 0

# How many workers a program starts, one per processor.
test "processor_count: one worker per processor"
    assert processor_count().must() >= 1

# The system's name, as a program's report writes it.
test "system: the system's name"
    name = match system()
        .darwin  => "macOS"
        .linux   => "Linux"
        .windows => "Windows"
        .other   => "another POSIX system"

    assert name.len() > 0

# The architecture's name, as a download page names it.
test "architecture: the processor's name"
    name = match architecture()
        .x86_64 => "amd64"
        .arm64  => "arm64"
        .other  => "other"

    assert name.len() > 0

# The system's version, as `uname -r` prints it on POSIX.
test "system_version: the version text"
    assert system_version().must().len() > 0

# The name of the user the process runs as, where the machine names one.
test "user_name: who runs the process"
    match user_name()
        .ok name => assert name.len() > 0
        .err e   => assert e.code == NOT_FOUND

# The processor time spent so far, in milliseconds.
test "process_times: the time spent so far"
    times = process_times().must()
    assert (times.user_ns + times.system_ns) / 1000000 >= 0

# The load over the last minute, as `uptime` shows it, where the system keeps
# one.
test "load_average: the last minute's load"
    match load_average()
        .ok load => assert load.one_minute >= 0
        .err e   => assert e.code == UNSUPPORTED

# A key of 32 random bytes.
test "random_bytes: a key"
    assert random_bytes(32).must().len() == 32

# The terminal's width, where the output is one.
test "terminal_size: the width of the terminal"
    match terminal_size()
        .ok size => assert size.columns > 0
        .err e   => assert e.code == UNSUPPORTED

# The share of the machine's memory available now, as a percentage.
test "memory: the share of the memory available now"
    match memory()
        .ok memory_now =>
            share = memory_now.available_bytes.to_f64() / memory_now.total_bytes.to_f64() * 100.0
            assert share > 0.0 && share <= 100.0
        .err e => assert e.code == UNSUPPORTED

# The time the machine's processors have spent idle since it started, in
# seconds.
test "cpu_times: the processors' idle time in seconds"
    match cpu_times()
        .ok times => assert times.idle_us / 1000000 >= 0
        .err e    => assert e.code == UNSUPPORTED

# The share of the processors' time that was busy over a span the program
# chose, as `top` shows it.
test "cpu_usage: the processors' busy share over a span"
    match cpu_times()
        .ok before =>
            spent: i64 @= 0

            for i in range(from: 0, to: 100000)
                spent @ spent + i % 3

            assert spent > 0
            share = cpu_usage(before: before, after: cpu_times().must()).must()
            assert share >= 0.0 && share <= 100.0
        .err e => assert e.code == UNSUPPORTED

# The memory this process holds now, in mebibytes.
test "process_usage: this process's own memory"
    match process_usage(pid())
        .ok usage => assert usage.resident_bytes / 1048576 >= 0
        .err e    => assert e.code == UNSUPPORTED

# The bytes every network interface has received, summed.
test "network_counters: the bytes received on every interface"
    match network_counters()
        .ok interfaces =>
            received: i64 @= 0

            for one in interfaces
                received @ received + one.bytes_received / 1024

            assert received >= 0
        .err e => assert e.code == UNSUPPORTED

# Where a program keeps its own data, under its name, made by `fs` when it
# first writes there.
test "data_dir: a program's own folder of data"
    match data_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == NOT_TEXT

# Where a program keeps its history: on a machine with a home folder, a path.
test "state_dir: where a history is kept"
    match state_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == NOT_TEXT

# Where a program puts its socket: a path, or told that the session has no
# such folder.
test "runtime_dir: where a socket goes"
    match runtime_dir()
        .ok dir => assert dir.len() > 0
        .err e  => assert e.code == NOT_FOUND || e.code == UNSUPPORTED

# A link refused before any program is started: its scheme starts programs.
test "open_url: a scheme refused, nothing opened"
    match open_url("javascript:alert(1)")
        .ok _  => assert false
        .err e => assert e.code == INVALID

# A file that is not there, told before any launcher runs.
test "open_path: a file that is not there"
    match open_path("/rebel-no-such-folder/report.pdf")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

# A server that ends its loops on Ctrl-C instead of dying in the middle of a
# write.
test "catch_stop: Ctrl-C asks the stop from now on"
    catch_stop().must()
    assert !is_stop_asked()

# The stop asked from inside the program, which every wait then ends on.
test "ask_stop: the stop asked from the program itself"
    ask_stop()
    assert is_stop_asked()

# Whether the stop was asked, as a loop asks it between two pieces of work.
test "is_stop_asked: not before the stop, yes after"
    assert !is_stop_asked()
    ask_stop()
    assert is_stop_asked()

# A shell or a REPL that outlives every Ctrl-C: each is counted, and the loop
# asks between two commands.
test "count_signal: Ctrl-C counted instead of ending the program"
    count_signal(.interrupt).must()
    assert take_signals(.interrupt) == 0

# What came since the program last asked: here nothing.
test "take_signals: the Ctrl-Cs since the last call"
    count_signal(.interrupt).must()

    if take_signals(.interrupt) > 0
        print("interrupted")

# The number a child's status holds for Ctrl-C, the same on every system.
test "signal_number: Ctrl-C's number"
    assert signal_number(.interrupt).must() == 2

# The signal a child's status names by its number.
test "signal_of: the signal behind a status's number"
    assert signal_of(2).must() == .interrupt

# The name a shell writes for Ctrl-Z.
test "signal_name: the name of Ctrl-Z's signal"
    assert signal_name(.terminal_stop) == "SIGTSTP"
