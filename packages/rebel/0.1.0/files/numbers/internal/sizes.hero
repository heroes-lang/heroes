# A count of bytes written for people, `1.2 MB` or `1.1 MiB`, and read back.
# Writing divides by the largest unit the count reaches, and writes the
# quotient's digits exactly, one at a time from the remainder, rounding the
# last half to even; nothing passes through a float. Reading multiplies the
# digits written by the unit and divides by the power of ten the point
# stands for, exactly, on `big`'s natural numbers, rounding the same way.

use numbers/internal/big

# The code of a text that is no size.
constant INVALID: str
    "invalid"

# The code of a size past what an `i64` holds.
constant DOES_NOT_FIT: str
    "does_not_fit"

# The prefixes of the units, from the kilo up: `k`, `M`, `G`, `T`, `P`, `E`.
constant PREFIXES: str
    "kMGTPE"

# The text of `size` bytes in units of `base` to the power of 1 to 6, 1000 or
# 1024, `precision` digits after the point: below `base`, the count and `B`.
# A quotient that rounds up to `base` is written in the next unit, where
# there is one.
function format(size: i64, base: i64, precision: i64) -> str
    assert precision >= 0
    negative = size < 0

    sign = if negative
        "-"
    else
        ""

    if size > 0 - base && size < base
        return to_str(size) + " B"
    power @= 0
    unit @= 1

    # The largest unit the size reaches: `unit` times `base` stays an `i64`
    # while it is no more than the size's magnitude, which an `i64` holds.
    while power < 6 && within(size: size, unit: unit, base: base)
        unit @ unit * base
        power @ power + 1

    written @= digits(size: size, unit: unit, base: base, precision: precision)

    if written.whole >= base && power < 6
        unit @ unit * base
        power @ power + 1
        written @ digits(size: size, unit: unit, base: base, precision: precision)
    letter = PREFIXES.slice(from: power - 1, to: power)

    name = if base == 1024
        strings_upper_k(letter) + "iB"
    else
        letter + "B"

    if precision == 0
        return f"{sign}{written.whole} {name}"
    return f"{sign}{written.whole}.{written.fraction} {name}"

# Whether `unit` times `base` is no more than the magnitude of `size`.
function within(size: i64, unit: i64, base: i64) -> bool
    if unit > 9223372036854775807 / base
        return false
    next = unit * base

    if size < 0
        return 0 - next >= size
    return next <= size

# `K` for `k`: the IEC writes its kibi upper case.
function strings_upper_k(letter: str) -> str
    if letter == "k"
        return "K"
    return letter

# The whole part and the fraction's digits of a quotient.
record Quotient
    # The whole part.
    whole: i64
    # The digits after the point, `precision` of them.
    fraction: str

# The magnitude of `size` divided by `unit`, a power of `base`, with
# `precision` digits after the point, the last rounded half to even from the
# exact remainder. A digit is the remainder times ten over the unit, taken
# as the remainder over a tenth of a decimal unit, or as five times the
# remainder over half a binary one, so that no product passes an `i64`.
function digits(size: i64, unit: i64, base: i64, precision: i64) -> Quotient
    whole @= size / unit
    rest @= size % unit

    if size < 0
        whole @ 0 - whole
        rest @ 0 - rest
    out: [i64] @= []

    for _ in range(from: 0, to: precision)
        if base == 1000
            tenth = unit / 10
            out @ out.push(rest / tenth)
            rest @ rest % tenth * 10
        else
            half = unit / 2
            fivefold = rest * 5
            out @ out.push(fivefold / half)
            rest @ fivefold % half * 2

    # Half to even: the remainder against half the unit, the last digit
    # written, or the whole part where none is, telling a tie.
    last = if out.len() > 0
        out[out.len() - 1]
    else
        whole
    up = rest * 2 > unit || rest * 2 == unit && last % 2 == 1

    if up
        at @= out.len() - 1
        carry @= true

        while carry && at >= 0
            if out[at] == 9
                out[at] @ 0
                at @ at - 1
            else
                out[at] @ out[at] + 1
                carry @ false

        if carry
            whole @ whole + 1
    text: [str] @= []

    for d in out
        text @ text.push(to_str(d))

    return Quotient(whole: whole, fraction: text.join(""))

# The bytes `s` writes, a number with or without a fraction, a sign before
# it where negative, then white space or none and a unit read without regard
# to case: `B` or none for bytes; `k`, `M`, `G`, `T`, `P` or `E`, alone or
# with `B`, for powers of `base`; the same with `i`, alone or with `B`, for
# powers of 1024. The product is rounded to a whole byte, half to even.
function parse(s: str, base: i64) -> i64?
    at @= 0
    negative = s.len() > 0 && s[0] == '-'

    if s.len() > 0 && (s[0] == '-' || s[0] == '+')
        at @ 1
    start = at

    while at < s.len() && is_digit(s[at])
        at @ at + 1

    if at == start
        return fail(code: INVALID, msg: f"\"{s}\" is no size: a digit is expected at byte {at}")
    whole_end = at
    fraction_end @= at

    if at < s.len() && s[at] == '.'
        at @ at + 1

        while at < s.len() && is_digit(s[at])
            at @ at + 1

        if at == whole_end + 1
            return fail(
                code: INVALID,
                msg: f"\"{s}\" is no size: a digit is expected after the point at byte {whole_end}"
            )
        fraction_end @ at

    while at < s.len() && (s[at] == ' ' || s[at] == '\t')
        at @ at + 1

    unit = unit_of(s.slice(from: at, to: s.len()), base: base)

    if unit.power < 0
        return fail(code: INVALID, msg: f"\"{s}\" is no size: \"{s.slice(from: at, to: s.len())}\" is no unit")
    written: [u8] @= []

    for k in range(from: start, to: fraction_end)
        if s[k] != '.'
            written @ written.push(s[k])

    places = if fraction_end > whole_end
        fraction_end - whole_end - 1
    else
        0
    scaled = scaled_by(big.of_digits(written), unit: unit)
    rounded = divided_rounded(scaled, places: places)

    if big.bit_len(rounded) > 63
        return fail(code: DOES_NOT_FIT, msg: f"\"{s}\" is past {9223372036854775807} bytes, the most an i64 holds")
    magnitude = value_of(rounded)

    if negative
        return ok(0 - magnitude)
    return ok(magnitude)

# Whether `b` is an ASCII digit.
function is_digit(b: u8) -> bool
    return b >= '0' && b <= '9'

# A unit read: the base it counts in and its power; a power below 0 where
# the text is no unit.
record Unit
    # 1000 or 1024.
    base: i64
    # From 0, the byte, to 6, the exa.
    power: i64

# The unit `text` names, read without regard to case, as `parse` says.
function unit_of(text: str, base: i64) -> Unit
    low = lower_ascii(text)
    none = Unit(base: base, power: -1)

    if low == "" || low == "b"
        return Unit(base: base, power: 0)
    names = "kmgtpe"

    for k in range(from: 0, to: 6)
        letter = names.slice(from: k, to: k + 1)

        if low == letter || low == letter + "b"
            return Unit(base: base, power: k + 1)

        if low == letter + "i" || low == letter + "ib"
            return Unit(base: 1024, power: k + 1)

    return none

# `s` with its ASCII capitals made small.
function lower_ascii(s: str) -> str
    out: [u8] @= []

    for k in range(from: 0, to: s.len())
        b = s[k]

        if b >= 'A' && b <= 'Z'
            out @ out.push(b + 32)
        else
            out @ out.push(b)

    return out.validated_bytes().default(s)

# `a` times the unit `unit`.
function scaled_by(a: [i64], unit: Unit) -> [i64]
    if unit.base == 1000
        return big.times_pow10(a: a, k: 3 * unit.power)
    return big.shifted(a: a, k: 10 * unit.power)

# `a` divided by ten to the `places`th, rounded half to even: the last digit
# taken off decides, the ones under it telling a tie from more.
function divided_rounded(a: [i64], places: i64) -> [i64]
    out @= a
    last @= 0
    under @= false

    for _ in range(from: 0, to: places)
        if last != 0
            under @ true
        cut = divided_by_ten(out)
        out @ cut.quotient
        last @ cut.remainder

    up = last > 5 || last == 5 && (under || is_odd(out))

    if up
        return big.times_add(a: out, factor: 1, add: 1)
    return out

# What `divided_by_ten` answers.
record Cut
    # The quotient.
    quotient: [i64]
    # The remainder, 0 to 9.
    remainder: i64

# `a` divided by ten, its limbs taken from the top.
function divided_by_ten(a: [i64]) -> Cut
    out: [i64] @= []

    for _ in a
        out @ out.push(0)

    rest @= 0
    at @= a.len() - 1

    while at >= 0
        t = rest * big.LIMB + a[at]
        out[at] @ t / 10
        rest @ t % 10
        at @ at - 1

    return Cut(quotient: big.trimmed(out), remainder: rest)

# Whether `a` is odd.
function is_odd(a: [i64]) -> bool
    return a.len() > 0 && a[0] % 2 == 1

# The `i64` of `a`, which needs 63 bits or fewer.
function value_of(a: [i64]) -> i64
    out @= 0
    at @= a.len() - 1

    while at >= 0
        out @ out * big.LIMB + a[at]
        at @ at - 1

    return out

## Tests

test "format: below a kilo, the units of 1000 and of 1024, and a precision of 0"
    assert format(size: 0, base: 1000, precision: 1) == "0 B"
    assert format(size: 999, base: 1000, precision: 1) == "999 B"
    assert format(size: 1000, base: 1000, precision: 1) == "1.0 kB"
    assert format(size: 1234567, base: 1000, precision: 1) == "1.2 MB"
    assert format(size: 1234567, base: 1024, precision: 1) == "1.2 MiB"
    assert format(size: 1153434, base: 1024, precision: 2) == "1.10 MiB"
    assert format(size: 1500, base: 1000, precision: 0) == "2 kB"
    assert format(size: 2500, base: 1000, precision: 0) == "2 kB"
    assert format(size: 1023, base: 1024, precision: 1) == "1023 B"

test "format: a round up into the next unit, a tie to even, the largest and the smallest i64"
    assert format(size: 999950, base: 1000, precision: 1) == "1.0 MB"
    assert format(size: 1048575, base: 1024, precision: 1) == "1.0 MiB"
    assert format(size: 1050, base: 1000, precision: 1) == "1.0 kB"
    assert format(size: 1150, base: 1000, precision: 1) == "1.2 kB"
    assert format(size: 9223372036854775807, base: 1000, precision: 3) == "9.223 EB"
    assert format(size: 9223372036854775807, base: 1024, precision: 3) == "8.000 EiB"
    assert format(size: 0 - 9223372036854775807 - 1, base: 1024, precision: 2) == "-8.00 EiB"
    assert format(size: -1500, base: 1000, precision: 1) == "-1.5 kB"

test "parse: units of either base and case, a fraction rounded, white space or none"
    assert parse("1.2 MB", base: 1000).must() == 1200000
    assert parse("1.1MiB", base: 1000).must() == 1153434
    assert parse("1 KB", base: 1024).must() == 1024
    assert parse("1 kb", base: 1000).must() == 1000
    assert parse("512", base: 1000).must() == 512
    assert parse("0.5 B", base: 1000).must() == 0
    assert parse("1.5 B", base: 1000).must() == 2
    assert parse("-2 k", base: 1000).must() == -2000
    assert parse("8 EiB", base: 1000).is_err()
    assert parse("7.999999999999999999 EiB", base: 1000).must() == 9223372036854775807
    assert parse("7.99999999999999999999 EiB", base: 1000).is_err()

test "parse: what is no size"
    for text in ["", "MB", "1.", ".5 MB", "1 XB", "1 MBB", "1,5 MB", "1 mib extra"]
        assert parse(text, base: 1000).is_err()
