# Files and folders by path: a file read or written whole, a file opened as
# an `io.Stream`, the facts of a path, folders made, read and removed, trees
# walked, globbed and copied, links made, read and resolved, temporaries
# made, a path's times, length, permission and owner set, a file written
# atomically, locked, or mapped in memory and read and written by copy, and a
# walk that leaves out what a tree's gitignore files ignore. Text is the
# language's own: `read_file` and `write_file` read and write a file as UTF-8
# text, and nothing here does it a second way.
#
# What it does NOT do: watch a folder for changes (`fs/watch`); pack a tree
# into an archive or unpack one (`archive`); make, join, clean or match a path
# as text, which touches no disk (`path`); the working folder and the
# system's folders, home, temporaries and caches (`os`).
#
# **Every failure is a code of README § A4.** Besides the codes each function
# names, every one fails `invalid` where a path holds a zero byte or is longer
# than the system takes, `permission` where the system refuses the call to
# this program, `limit` where it has no more of what the call needs, and
# `failed` with the system's own number for a reason no code names. A message
# says what was asked, the path in quotes, and what the system found.
#
# **Nothing here follows a link it was not asked to**, except where a
# function's comment says so: a walk lists a link as a link, and a tree that
# loops through its links never makes a function loop. Every function that
# goes down a tree holds its own list of what is left to do, so no tree is
# too deep for it.
#
# The floors are `os/hero_disk` (`hero_disk.h`), a path's facts and changes,
# its links, permission bits, owners, times and locks; `io/hero_stream`
# (`hero_stream.h`), a file opened; and `os/hero_os` (`hero_os.h`), a path
# resolved. What is not here yet is in the ledger, `fs.ledger`, as
# `pending`.

use fs/internal/atomic
use fs/internal/changes
use fs/internal/codes
use fs/internal/copying
use fs/internal/facts
use fs/internal/fixture
use fs/internal/ignored
use fs/internal/links
use fs/internal/listing
use fs/internal/locks
use fs/internal/mapped
use fs/internal/special
use fs/internal/temporary
use fs/internal/tree
use fs/internal/walking
use fs/internal/whole
use io
use io/hero_stream
use os/hero_disk
use path as paths
use time

## Codes

# A path names nothing: no file, no folder, no link.
constant FILE_NOT_FOUND: str
    codes.FILE_NOT_FOUND

# Something is at the path already, and the call would not replace it.
constant EXISTS: str
    codes.EXISTS

# The system refuses the call to this program.
constant PERMISSION: str
    codes.PERMISSION

# A folder was needed and the path, or a part on its way, is something else.
constant NOT_A_DIRECTORY: str
    codes.NOT_A_DIRECTORY

# The path names a folder where something else was needed.
constant IS_A_DIRECTORY: str
    codes.IS_A_DIRECTORY

# The folder holds something, and the call needs it empty.
constant NOT_EMPTY: str
    codes.NOT_EMPTY

# What the call was handed is not what it reads; the message says where.
constant INVALID: str
    codes.INVALID

# Bytes that are not UTF-8 where text was needed: a name, a link's target.
constant NOT_TEXT: str
    codes.NOT_TEXT

# The system has no more of what the call needs.
constant LIMIT: str
    codes.LIMIT

# This system has no such thing.
constant UNSUPPORTED: str
    codes.UNSUPPORTED

# The system refused for a reason no other code names; the message carries
# its number.
constant FAILED: str
    codes.FAILED

# The stream a lock was asked through is closed: `lock`, `try_lock`,
# `unlock`.
constant CLOSED: str
    codes.CLOSED

## The types

# What a path names.
variant Kind
    # A file of bytes.
    file
    # A folder, which holds names.
    directory
    # A symbolic link, which names another path.
    link
    # Anything else: a named pipe, a socket, a device.
    other

# The facts of what a path names, as the system gave them at one moment.
record Info
    # What the path names; never `link` where the facts were read through
    # links.
    kind: Kind
    # The length in bytes: a file's content, a link's target text, and what
    # the system says of a folder.
    size: i64
    # The permission bits, 0 to 0o7777. Windows keeps only whether the file
    # is read-only: 0o444 where it is, 0o666 where not.
    permission: i64
    # The last time the content was written.
    written: time.Instant
    # The last time the content was read, as fine as the volume keeps it.
    read: time.Instant
    # How many names the file has, its hard links.
    links: i64

# One entry of a folder, or of a walk under one.
record Entry
    # The entry's name; in a walk, its path below the folder walked, the
    # parts joined by the system's separator.
    name: str
    # What the entry is, the link itself where it is one.
    kind: Kind

# How `open_with` opens a file.
variant Access
    # To read a file that is there.
    read
    # To write a file from its start, made where it is not there and emptied
    # where it is.
    write
    # To write at a file's end, made where it is not there.
    append
    # To write a file that the call makes, failing `exists` where one is
    # there.
    create_new
    # To read and write a file that is there, nothing emptied.
    read_write

# A temporary file `make_temp_file` made: its path and the stream open to
# write it. The caller closes the stream and removes the file.
record TempFile
    # The file's path, in the folder asked for.
    path: str
    # The file, open to write.
    stream: io.Stream

# Which of the other kinds a path names, as `other_kind` answers: what
# `Kind.other` holds.
variant OtherKind
    # A named pipe, a FIFO.
    pipe
    # A socket's file, a Unix domain socket's name.
    socket
    # A device read and written a character at a time: a terminal, the
    # device that drops what it is written (`/dev/null`, `NUL`).
    character_device
    # A device read and written a block at a time: a disk.
    block_device
    # One the system names and this list does not.
    unknown

# The user and the group that own what a path names, by the system's
# numbers, as `owner` answers. Built by `owner` and `link_owner`, or
# directly to compare.
record Owner
    # The user's number, 0 or above.
    user: i64
    # The group's number, 0 or above.
    group: i64

# The space of the volume a path stands on, in bytes.
record Space
    # The bytes this user may still write.
    available: i64
    # The volume's size.
    total: i64

## Whole files

# The bytes of the file at `path`, all of them.
#
# - `path`: the file's path; every link on it is followed.
#
# Fails `file_not_found` where nothing is there and `is_a_directory` where it is
# a folder. It reads the whole file into memory.
function read_bytes(path: str) -> [u8]?
    return whole.read_all(path)

# Writes `data` as the whole of the file at `path`, made where it is not there
# and emptied first where it is.
#
# - `path`: the file's path; every link on it is followed, and its folder must
#   be there.
# - `data`: the bytes, all of the file once written; none leaves it empty.
#
# Fails `file_not_found` where the folder it would stand in is not there,
# `is_a_directory` where `path` is a folder. A file it makes has the permission
# 0o666 less the process's mask.
function write_bytes(path: str, data: [u8]) -> ()?
    return whole.written(
        at: path,
        data: data,
        access: hero_stream.HERO_STREAM_ACCESS_WRITE,
        asked: f"writing \"{path}\""
    )

# Adds `text` at the end of the file at `path`, made where it is not there.
#
# - `path`: the file's path; every link on it is followed.
# - `text`: the text added, as its UTF-8 bytes; "" adds nothing and still makes
#   the file.
#
# Fails as `write_bytes` does.
function append_text(path: str, text: str) -> ()?
    return whole.written_text(
        at: path,
        text: text,
        access: hero_stream.HERO_STREAM_ACCESS_APPEND,
        asked: f"appending to \"{path}\""
    )

# Adds `data` at the end of the file at `path`, made where it is not there.
#
# - `path`: the file's path; every link on it is followed.
# - `data`: the bytes added; none adds nothing and still makes the file.
#
# Fails as `write_bytes` does.
function append_bytes(path: str, data: [u8]) -> ()?
    return whole.written(
        at: path,
        data: data,
        access: hero_stream.HERO_STREAM_ACCESS_APPEND,
        asked: f"appending to \"{path}\""
    )

# Writes `text` as a new file at `path`.
#
# - `path`: the new file's path; its folder must be there.
# - `text`: the text, all of the file, as its UTF-8 bytes.
#
# Fails `exists` where anything is there, nothing written, and otherwise as
# `write_bytes` does. Whether anything is there and the making are one step of
# the system, so two programs never both make it.
function write_new_text(path: str, text: str) -> ()?
    return whole.written_text(
        at: path,
        text: text,
        access: hero_stream.HERO_STREAM_ACCESS_CREATE,
        asked: f"writing the new file \"{path}\""
    )

# Writes `data` as a new file at `path`, as `write_new_text` writes text.
#
# - `path`: the new file's path; its folder must be there.
# - `data`: the bytes, all of the file.
#
# Fails as `write_new_text` does.
function write_new_bytes(path: str, data: [u8]) -> ()?
    return whole.written(
        at: path,
        data: data,
        access: hero_stream.HERO_STREAM_ACCESS_CREATE,
        asked: f"writing the new file \"{path}\""
    )

# Writes `data` as the whole of the file at `path` in one step that no reader
# of `path`, and no crash of the machine, sees half done: a reader finds the
# old file or the new one, never a part of either.
#
# - `path`: the file to write, made where nothing is there and replaced where
#   a file is. A symbolic link at `path` is replaced itself by the file, never
#   what it names written, as Go's and Python's renaming do.
# - `data`: the bytes, all of them; none makes an empty file.
#
# The bytes go to a new temporary file beside `path`, in the same folder,
# which is written, put on the storage (Darwin's `F_FULLFSYNC`, `fsync`
# elsewhere, as `io.sync`), closed, given the permission bits of the file it
# replaces, and renamed over `path` in one step of the system; then the folder
# is put on the storage, so the new name outlives a crash too. A new file
# takes 0o666 less the process's mask, as `write_bytes` makes one. The owner
# is not kept: the file is this process's user's.
#
# Fails `invalid` where `path` ends in no name of a file (`a/..`, a root),
# `is_a_directory` where it names a folder, `file_not_found` where its folder
# is not there, `permission` where the folder refuses a new file. On every
# failure before the rename the temporary is removed and the file at `path`
# stands as it was; a failure of the folder's last step alone leaves the new
# file in place, and its message says so.
#
# Windows renames with `MoveFileExW`'s write-through, which waits for the
# disk, and has no call that puts a folder on the storage; no page of its
# reference promises that rename is one step, so there the promise above is
# POSIX's alone, and it is expected to refuse to replace a file marked
# read-only, `permission` (unrun until the Windows machine runs it). See also
# `write_atomic_text`, `write_bytes`.
function write_atomic_bytes(path: str, data: [u8]) -> ()?
    return atomic.written(at: path, data: data)

# Writes the UTF-8 of `text` as the whole of the file at `path` in one step,
# as `write_atomic_bytes` writes bytes.
#
# - `path`: the file to write, as `write_atomic_bytes` takes it.
# - `text`: the text, all of it; the empty text makes an empty file.
#
# Fails as `write_atomic_bytes` does. See also `write_atomic_bytes`.
function write_atomic_text(path: str, text: str) -> ()?
    return atomic.written_text(at: path, text: text)

# Makes an empty file at `path` where nothing is there, and sets the times of
# what is there to now where something is.
#
# - `path`: the path; every link on it is followed.
#
# Fails `file_not_found` where the folder it would stand in is not there.
function touch(path: str) -> ()?
    return whole.touched(path)

## Files as streams

# The file at `path` opened to read, as a stream the caller closes with
# `io.close`.
#
# - `path`: the file's path; every link on it is followed.
#
# Fails `file_not_found` where nothing is there and `is_a_directory` where it is
# a folder.
function open(path: str) -> io.Stream?
    return whole.opened(
        at: path,
        access: hero_stream.HERO_STREAM_ACCESS_READ,
        permission: 0,
        asked: f"opening \"{path}\" to read"
    )

# The file at `path` opened to write from its start, made where it is not there
# with the permission 0o666 less the process's mask, and emptied where it is.
#
# - `path`: the file's path; every link on it is followed.
#
# Fails as `open` does, and `file_not_found` where the folder it would stand in
# is not there.
function create(path: str) -> io.Stream?
    return whole.opened(
        at: path,
        access: hero_stream.HERO_STREAM_ACCESS_WRITE,
        permission: 0o666,
        asked: f"creating \"{path}\""
    )

# The file at `path` opened for `access`, a file the call makes taking
# `permission` less the process's mask.
#
# - `path`: the file's path; every link on it is followed.
# - `access`: what the stream does, and what is made or emptied, as its cases
#   say.
# - `permission`: the bits a file the call makes takes, such as 0o644; read only
#   where one is made.
#
# Fails `invalid` where `permission` is outside 0 to 0o777, `exists` for
# `create_new` where anything is there, and as `open` does. Windows keeps only
# whether a file it makes is read-only.
function open_with(path: str, access: Access, permission: i64) -> io.Stream?
    code = match access
        .read       => hero_stream.HERO_STREAM_ACCESS_READ
        .write      => hero_stream.HERO_STREAM_ACCESS_WRITE
        .append     => hero_stream.HERO_STREAM_ACCESS_APPEND
        .create_new => hero_stream.HERO_STREAM_ACCESS_CREATE
        .read_write => hero_stream.HERO_STREAM_ACCESS_READ_WRITE

    return whole.opened(at: path, access: code, permission: permission, asked: f"opening \"{path}\"")

## Facts of a path

# The facts of what `path` names, every link followed.
#
# - `path`: the path; every link on it is followed.
#
# Fails `file_not_found` where nothing is there, a link to nothing included, and
# `not_a_directory` where a part on the way is not a folder.
function info(path: str) -> Info?
    found = facts.of(at: path, through: true, asked: f"reading the facts of \"{path}\"")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    return ok(
        Info(kind: kinds[found.kind], size: found.size, permission: found.permission, written: found.written, read: found.read, links: found.links)
    )

# The facts of `path` itself: of the link where it is one, never of what it
# names.
#
# - `path`: the path; a link at its end is read itself, the links on the way
#   followed.
#
# Fails as `info` does.
function link_info(path: str) -> Info?
    found = facts.of(at: path, through: false, asked: f"reading the facts of the link \"{path}\"")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    return ok(
        Info(kind: kinds[found.kind], size: found.size, permission: found.permission, written: found.written, read: found.read, links: found.links)
    )

# The permission bits of what `path` names, every link followed, 0 to
# 0o7777.
#
# - `path`: the path.
#
# Fails `file_not_found` where nothing is there. Windows keeps only whether
# a file is read-only: 0o444 where it is, 0o666 where not.
#
# It answers what `info(path).permission` holds, by the same one call to the
# system: what it buys is the pair it makes with `set_permission`, for a
# program that copies or checks the bits alone, and a failure whose message
# says it was the permission that was read. See also `info`,
# `set_permission`.
function permission_of(path: str) -> i64?
    return special.permission_of(at: path, follow: true)

# When what `path` names was made, every link followed.
#
# - `path`: the path.
#
# Fails `file_not_found` where nothing is there, and `unsupported` where the
# system or the volume keeps no such time: Darwin and Windows keep it, Linux
# where the volume does (`statx`). See also `info`.
function created(path: str) -> time.Instant?
    return special.made_at(at: path, follow: true)

# The user and the group that own what `path` names, every link followed.
#
# - `path`: the path.
#
# Fails `file_not_found` where nothing is there, and `unsupported` on
# Windows, which names an owner by no number. See also `link_owner`,
# `set_owner`.
function owner(path: str) -> Owner?
    found = special.owner_of(at: path, follow: true)?
    return ok(Owner(user: found.user, group: found.group))

# The user and the group that own the link itself where `path` names one,
# and what it names where it names no link.
#
# - `path`: the path.
#
# Fails as `owner` does. See also `owner`, `set_link_owner`.
function link_owner(path: str) -> Owner?
    found = special.owner_of(at: path, follow: false)?
    return ok(Owner(user: found.user, group: found.group))

# Which other kind `path` names, every link followed, where `info` says its
# kind is `other`.
#
# - `path`: the path.
#
# Fails `invalid` where it names a file, a folder or a link to one, and
# `file_not_found` where nothing is there. POSIX tells all four; Windows
# tells a pipe and a character device and calls a socket's file a file. See
# also `info`.
function other_kind(path: str) -> OtherKind?
    which = special.other_of(path)?
    kinds: [OtherKind] = [.pipe, .socket, .character_device, .block_device, .unknown]
    return ok(kinds[which - 1])

# Whether `path` names something, every link followed, so a link to nothing
# answers false, as a path whose way holds a file does.
#
# - `path`: the path; every link on it is followed.
#
# Fails where the system will not say, never answering false for it.
function exists(path: str) -> bool?
    return ok(facts.presence(at: path, through: true, asked: f"asking whether \"{path}\" is there")? != facts.NOTHING)

# Whether `path` names a file, every link followed; false where nothing is
# there.
#
# - `path`: the path; every link on it is followed.
#
# Fails where the system will not say.
function is_file(path: str) -> bool?
    return ok(facts.presence(at: path, through: true, asked: f"asking whether \"{path}\" is a file")? == facts.FILE)

# Whether `path` names a folder, every link followed; false where nothing is
# there.
#
# - `path`: the path; every link on it is followed.
#
# Fails where the system will not say.
function is_dir(path: str) -> bool?
    return ok(
        facts.presence(at: path, through: true, asked: f"asking whether \"{path}\" is a folder")? == facts.DIRECTORY
    )

# Whether `path` is a symbolic link, whatever it names; false where nothing is
# there.
#
# - `path`: the path; a link at its end is asked about itself.
#
# Fails where the system will not say.
function is_link(path: str) -> bool?
    return ok(facts.presence(at: path, through: false, asked: f"asking whether \"{path}\" is a link")? == facts.LINK)

# Whether `path` and `other` name one file, every link followed.
#
# - `path`: one path; every link on it is followed.
# - `other`: the other path; every link on it is followed.
#
# Fails `file_not_found` where either names nothing.
function is_same_file(path: str, other: str) -> bool?
    return changes.same(first: path, second: other)

# The space of the volume `path` stands on.
#
# - `path`: any path on the volume asked about.
#
# Fails `file_not_found` where nothing is there.
function space(path: str) -> Space?
    room = changes.room(path)?
    return ok(Space(available: room.available, total: room.total))

## Folders

# Makes one folder at `path`, with the permission 0o777 less the process's mask.
#
# - `path`: the new folder's path; its parent must be there.
#
# Fails `exists` where anything is there, `file_not_found` where its parent is
# not.
function make_dir(path: str) -> ()?
    return changes.made_dir(path, permission: 0o777)

# Makes one folder at `path` with the permission `permission`, 0 to 0o7777, less
# the process's mask.
#
# - `path`: the new folder's path; its parent must be there.
# - `permission`: the bits it takes, 0 to 0o7777, such as 0o700 for this user
#   alone.
#
# Fails as `make_dir` does, and `invalid` where `permission` is outside its
# range.
function make_dir_with(path: str, permission: i64) -> ()?
    return changes.made_dir(path, permission: permission)

# Makes the folder `path` and every folder above it that is not there, each with
# the permission 0o777 less the process's mask.
#
# - `path`: the folder's path; the folders on its way are made where they are
#   not there.
#
# A folder there already is no failure. Fails `not_a_directory` where `path`, or
# a part on its way, is something other than a folder, and `file_not_found` for
# the empty path.
function make_dir_all(path: str) -> ()?
    return tree.made_all(path)

# The entries of the folder `path`, sorted by their names' bytes, `.` and `..`
# never among them; a link is listed as a link.
#
# - `path`: the folder's path; every link on it is followed.
#
# Fails `file_not_found` where nothing is there, `not_a_directory` where it is
# no folder, and `not_text` where a name is not UTF-8.
function read_dir(path: str) -> [Entry]?
    found = listing.listed(dir: path, asked: f"reading the folder \"{path}\"")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    entries: [Entry] @= []

    for f in found
        entries @ entries.push(Entry(name: f.name, kind: kinds[f.kind]))

    return ok(entries)

# Removes the file, the link or the empty folder at `path`; a link is removed,
# never what it names.
#
# - `path`: the path; a link at its end is removed itself.
#
# Fails `file_not_found` where nothing is there and `not_empty` where the folder
# holds something.
function remove(path: str) -> ()?
    return changes.removed(path)

# Removes `path` with everything it holds; a link inside is removed, never
# followed.
#
# - `path`: the path; a link at its end is removed itself, never what it names.
#
# Fails `file_not_found` where nothing is at `path`, and on the first entry that
# cannot be removed, leaving what it had not reached. An entry another program
# removes meanwhile is no failure.
function remove_all(path: str) -> ()?
    return tree.removed_all(path)

# Gives `from` the name `to`, on the same volume.
#
# - `from`: the path that changes name.
# - `to`: its new name, on the same volume.
#
# Where `to` is there, a file takes the place of a file and never of a folder
# (`is_a_directory`), and a folder takes the place of nothing (`exists`), on
# every system. Fails `file_not_found` where `from` names nothing or the folder
# of `to` is not there, and `failed` where the two are on different volumes,
# which `move` crosses.
function rename(from: str, to: str) -> ()?
    return changes.renamed(from: from, to: to)

# Moves `from` to `to`: renamed where both stand on one volume, and across
# volumes copied, with the times of each file, then removed.
#
# - `from`: the path moved, a file, a link or a folder with what it holds.
# - `to`: where it goes, on this volume or another.
#
# It takes the place of what is at `to` as `rename` does, and fails as it does
# but for the volumes; a copy across volumes that fails leaves `from` whole.
function move(from: str, to: str) -> ()?
    return copying.moved(from: from, to: to)

# Puts the entries of the folder at `path` on the storage itself, so a name
# made, renamed or removed in it outlives a crash of the machine: what a
# program that renames a file into place by itself owes after the rename,
# and what `write_atomic_bytes` does.
#
# - `path`: the folder, links followed.
#
# It asks Darwin's `F_FULLFSYNC` first, whose `fsync` leaves the drive's own
# buffer unwritten, and `fsync` where the volume has none.
#
# Fails `not_a_directory` where `path` names something else,
# `file_not_found` where nothing is there, and `unsupported` on Windows, which
# has no call that promises it of a folder: a rename there is written through
# by `write_atomic_bytes` instead. See also `rename`, `write_atomic_bytes`.
function sync_dir(path: str) -> ()?
    return atomic.folder_synced(path)

## Trees

# Every path under the folder `root`, depth first, the entries of each folder
# by their names' bytes, `root` itself not listed; each entry's `name` is its
# path below `root`.
#
# - `root`: the folder walked; it is followed where it is a link.
#
# A link is listed as a link and never entered. The list is answered whole:
# every folder of the tree is read and its entries held before the call
# returns, and none is left out; a walk that should not enter a folder
# (`node_modules`, `.git`) or go below a depth asks `walk_ignoring` or
# `walk_to_depth`, which never read what they leave out.
#
# Fails `file_not_found` where nothing is at `root`, `not_a_directory` where
# it is no folder, and on the first folder it cannot read, never answering a
# list that misses it.
function walk(root: str) -> [Entry]?
    found = walking.walked(root: root, follow: false, most_depth: -1, asked: f"walking \"{root}\"")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    entries: [Entry] @= []

    for f in found
        entries @ entries.push(Entry(name: f.name, kind: kinds[f.kind]))

    return ok(entries)

# What `walk` answers, every link followed: a link to a folder is entered and
# listed as a folder, a link to a file listed as a file.
#
# - `root`: the folder walked; it is followed where it is a link.
#
# A link to nothing, and one that leads back into a folder the walk is inside,
# are listed as links and not entered, so a tree that loops is walked once.
#
# Fails as `walk` does, and on a link it cannot follow.
function walk_following_links(root: str) -> [Entry]?
    found = walking.walked(root: root, follow: true, most_depth: -1, asked: f"walking \"{root}\" through its links")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    entries: [Entry] @= []

    for f in found
        entries @ entries.push(Entry(name: f.name, kind: kinds[f.kind]))

    return ok(entries)

# What `walk` answers down to `depth` levels below `root`, and nothing deeper:
# what a program listing a folder and its children asks.
#
# - `root`: the folder walked; it is followed where it is a link.
# - `depth`: the deepest level listed, 1 for the entries of `root` alone, 2
#   for theirs as well; a folder at that level is listed and never read. Below
#   1 fails `invalid`.
#
# A link is listed as a link and never entered, as `walk` lists it. Fails
# `invalid` as said, and as `walk` does.
function walk_to_depth(root: str, depth: i64) -> [Entry]?
    if depth < 1
        return fail(code: INVALID, msg: f"walking \"{root}\" to a depth of {depth}: a depth is 1 or more")
    found = walking.walked(root: root, follow: false, most_depth: depth, asked: f"walking \"{root}\" {depth} deep")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    entries: [Entry] @= []

    for f in found
        entries @ entries.push(Entry(name: f.name, kind: kinds[f.kind]))

    return ok(entries)

# Every path under the folder `root` that its gitignore files leave in, as
# `walk` lists them: what git leaves for a program to see, the files a tool
# reads or copies and the folders above them.
#
# - `root`: the folder walked, the root of the patterns; it is followed where
#   it is a link.
# - `ignores`: the patterns that stand outside the tree, below every file of
#   it: git's `.git/info/exclude` and the file `core.excludesFile` names,
#   read by the caller, or `path.parse_ignore("")` for none. A `.git/` among
#   them leaves out git's own folder, which git never lists.
# - `name`: the name of the file of patterns every folder may hold, the
#   root's included: `.gitignore` for git's own. Any other name is read the
#   same way, gitignore(5)'s.
#
# An entry the patterns ignore is not listed, and a folder ignored is not
# entered, so nothing below it is listed and no file below it is read: what
# `path.is_ignored` answers for its path below `root` with `/` between its
# names. Each folder's file is read as the walk enters the folder and decides
# for what is below it before the files above it. A link is listed as a link
# and never entered, and asked as a file, as git asks it. The files of
# patterns are listed like any other, unless they ignore themselves.
#
# Fails `file_not_found` where nothing is at `root`, `not_a_directory` where
# it is no folder, `invalid` where `name` is empty, `.`, `..` or holds a
# separator, `not_text` where a file of patterns is not UTF-8, and on the
# first folder or file it cannot read, never answering a list that misses
# it. Each entry is asked of every file of patterns read so far, for each
# folder above it. See also `walk`, `path.is_ignored`, `path.parse_ignore`.
function walk_ignoring(root: str, ignores: paths.Ignores, name: str) -> [Entry]?
    found = ignored.walked(root: root, ignores: ignores, name: name, asked: f"walking \"{root}\" by its {name} files")?
    kinds: [Kind] = [.file, .directory, .link, .other]
    entries: [Entry] @= []

    for f in found
        entries @ entries.push(Entry(name: f.name, kind: kinds[f.kind]))

    return ok(entries)

# The paths that match `pattern`, sorted, each written as the pattern begins:
# relative where it is relative.
#
# - `pattern`: the pattern, `path.matches`'s, a path whose parts may hold `*`,
#   `?`, classes and `**`.
#
# The pattern is `path.matches`'s, `*` and `?` within one part, classes, and
# `**` for any number of parts; `*` matches a name that begins with a dot. Links
# are followed, and a tree that loops is walked once. Fails `invalid` where the
# pattern is malformed, and on the first folder it cannot read; a folder the
# pattern begins with that is not there answers no paths.
function glob(pattern: str) -> [str]?
    return walking.globbed(pattern)

# Copies the file `from` to `to` and answers how many bytes it copied.
#
# - `from`: the file copied; every link on it is followed.
# - `to`: the copy's path; a file there is replaced, and its folder must be
#   there.
#
# A file it makes takes the permission bits of `from` less the process's mask;
# one there keeps its own and loses its bytes. Fails `file_not_found` where
# `from` names nothing, `is_a_directory` where either is a folder, and `invalid`
# where the two name one file, which would empty it.
function copy_file(from: str, to: str) -> i64?
    return copying.copied_file(from: from, to: to, keep_times: false, access: hero_stream.HERO_STREAM_ACCESS_WRITE)

# Copies the file `from` to `to`, as `copy_file` does, and then gives the
# copy the permission bits and the times of `from`, as Python's
# `shutil.copy2`: answers how many bytes it copied.
#
# - `from`: the original, every link followed.
# - `to`: the copy's path; a file there loses its bytes and takes the bits
#   and the times of `from`.
#
# Fails as `copy_file` does, and as `copy_facts` does once the bytes are
# copied, the copy then whole with its own facts. See also `copy_file`,
# `copy_facts`.
function copy_file_with_facts(from: str, to: str) -> i64?
    copied = copy_file(from: from, to: to)?
    copy_facts(from: from, to: to)?
    return ok(copied)

# Gives `to` the permission bits of `from`, every link followed in both, as
# Python's `shutil.copymode`.
#
# - `from`: the path whose bits are read.
# - `to`: the path whose bits are set, as given, no mask taking any away.
#
# Fails `file_not_found` where either is not there, and as `set_permission`
# does. See also `copy_facts`, `copy_file_with_facts`.
function copy_permission(from: str, to: str) -> ()?
    return special.permission_copied(from: from, to: to)

# Gives `to` the permission bits and the times of the last write and the
# last read of `from`, every link followed in both, as Python's
# `shutil.copystat` gives the three.
#
# - `from`: the path whose facts are read.
# - `to`: the path whose facts are set: the times first, then the bits.
#
# Fails as `copy_permission` and `set_times` do. See also
# `copy_permission`, `copy_file_with_facts`.
function copy_facts(from: str, to: str) -> ()?
    return special.facts_copied(from: from, to: to)

# Copies the folder `from`, with everything it holds, to a new folder `to`, each
# folder and file taking the permission bits of its original less the process's
# mask.
#
# - `from`: the folder copied.
# - `to`: the new folder's path, where nothing must be.
#
# Links are followed. Fails `exists` where anything is at `to`,
# `not_a_directory` where `from` is no folder, and, before anything is written,
# `file_not_found` for a link to nothing, `invalid` for a link that loops and
# `unsupported` for what is neither a file nor a folder.
function copy_tree(from: str, to: str) -> ()?
    return copying.copied_tree(from: from, to: to, keep_times: false)

## Links and absolute paths

# The target the symbolic link `path` holds, as the link holds it, relative or
# not.
#
# - `path`: the link's path.
#
# Fails `file_not_found` where nothing is there, `invalid` where it is no link,
# and `not_text` where the target is not UTF-8.
function read_link(path: str) -> str?
    return links.target_of(path)

# Makes `name` a second name of the file `existing` names, a hard link: the
# two names are then one file, its bytes and its facts shared.
#
# - `existing`: the file; a symbolic link is given the second name itself,
#   never what it names.
# - `name`: the new name, where nothing must be.
#
# Fails `exists` where anything is at `name`, `file_not_found` where
# `existing` or the folder of `name` is not there, `is_a_directory` where
# `existing` is a folder, and `failed` across two volumes. See also
# `symlink`.
function hard_link(existing: str, name: str) -> ()?
    return special.hard_linked(existing: existing, name: name)

# Makes `name` a symbolic link holding `target`.
#
# - `target`: the text the link holds, relative to the link's folder or
#   absolute; it is not looked for, so a link to nothing is made. Empty fails
#   `invalid`.
# - `name`: the link's own path, where nothing must be.
#
# Fails `exists` where anything is at `name`, `file_not_found` where its
# folder is not there. Windows makes a link only for an administrator or, in
# developer mode, for anybody, and fails `permission` elsewhere; it writes
# every `/` of `target` as `\`, and makes a folder's link where `target`
# names a folder when the link is made. See also `read_link`, `hard_link`.
function symlink(target: str, name: str) -> ()?
    return special.symlinked(target: target, name: name)

# The absolute path `path` names, every link on the way followed, cleaned.
#
# - `path`: the path, relative to the working folder or absolute.
#
# Fails `file_not_found` where it names nothing, a link to nothing included, and
# `not_text` where the answer is not UTF-8.
function resolve(path: str) -> str?
    return links.resolved(at: path, asked: f"resolving \"{path}\"")

# `path` made absolute against the working folder and cleaned, reading no link:
# a `..` takes away the part before it even where that part is a link.
#
# - `path`: the path, relative to the working folder or absolute.
#
# An absolute `path` is only cleaned. Fails where the working folder cannot be
# read, as `os.working_dir` does.
function to_abs(path: str) -> str?
    return links.absolute(path)

## Temporaries

# Makes a new folder in `dir` whose name is `pattern` with its last `*` replaced
# by sixteen random hexadecimal digits, or followed by them where it holds no
# `*`, and answers its path.
#
# - `dir`: the folder it is made in, or "" for the system's folder for temporary
#   files.
# - `pattern`: the name, its last `*` replaced by the random digits, such as
#   `build-*`; "" is the digits alone.
#
# The folder is 0o700, this user's alone. An empty `dir` is the system's folder
# for temporary files. Fails `invalid` where `pattern` holds a separator, and
# `file_not_found` where `dir` is not there. Nothing removes the folder but the
# caller.
function make_temp_dir(dir: str, pattern: str) -> str?
    return temporary.made_dir(dir: dir, pattern: pattern)

# Makes a new file in `dir`, named as `make_temp_dir` names a folder, 0o600, and
# answers its path with a stream open to write it.
#
# - `dir`: the folder it is made in, or "" for the system's folder for temporary
#   files.
# - `pattern`: the name, as `make_temp_dir` takes it, such as `report-*.txt`.
#
# Fails as `make_temp_dir` does. The caller closes the stream and removes the
# file.
function make_temp_file(dir: str, pattern: str) -> TempFile?
    made = temporary.made_file(dir: dir, pattern: pattern)?
    return ok(TempFile(path: made.at, stream: made.stream))

## Changing a path's facts

# Sets the times of the last write and the last read of what `path` names, every
# link followed, as fine as the volume keeps them.
#
# - `path`: the path; every link on it is followed.
# - `written`: the time of the last write.
# - `read`: the time of the last read.
#
# Fails `file_not_found` where nothing is there.
function set_times(path: str, written: time.Instant, read: time.Instant) -> ()?
    return changes.timed(path, written: written, read: read)

# Sets the times of the last write and the last read of the link itself
# where `path` names one, and of what it names where it names no link.
#
# - `path`: the path.
# - `written`: the time of the last write, kept as fine as the volume keeps
#   it.
# - `read`: the time of the last read, as `written`.
#
# Fails `file_not_found` where nothing is there; Windows keeps no time at or
# before 1601 and fails `invalid` for one. See also `set_times`.
function set_link_times(path: str, written: time.Instant, read: time.Instant) -> ()?
    return special.link_timed(at: path, written: written, read: read)

# Makes the file `path` names, every link followed, `length` bytes long:
# shorter, it loses its end; longer, its new bytes are zero.
#
# - `path`: the file's path; every link on it is followed.
# - `length`: its length afterwards, in bytes, 0 or more.
#
# Fails `invalid` where `length` is below 0, `is_a_directory` for a folder,
# `file_not_found` where nothing is there.
function truncate(path: str, length: i64) -> ()?
    return changes.truncated(path, length: length)

# Sets the permission bits of what `path` names, every link followed.
#
# - `path`: the path.
# - `permission`: the bits, 0 to 0o7777, set as given: the process's mask
#   takes none away.
#
# Fails `invalid` where `permission` is outside 0 to 0o7777,
# `file_not_found` where nothing is there, and `permission` where this user
# may not change them. Windows keeps read-only alone: it is set where
# `permission` grants nobody writing, no bit of 0o222, and cleared where it
# grants somebody. See also `set_link_permission`, `copy_permission`.
function set_permission(path: str, permission: i64) -> ()?
    return special.permission_set(at: path, permission: permission, follow: true)

# Sets the permission bits of the link itself where `path` names one, and of
# what it names where it names no link.
#
# - `path`: the path.
# - `permission`: the bits, 0 to 0o7777, as `set_permission` takes them.
#
# Fails as `set_permission` does, and `unsupported` for a link on Linux,
# which keeps no bits of a link's own; Darwin and Windows set the link's.
# See also `set_permission`.
function set_link_permission(path: str, permission: i64) -> ()?
    return special.permission_set(at: path, permission: permission, follow: false)

# Gives what `path` names, every link followed, to the user and the group of
# those numbers, -1 leaving either as it is.
#
# - `path`: the path; every link on it is followed.
# - `user`: the user's number, or -1 to keep it.
# - `group`: the group's number, or -1 to keep it.
#
# Fails `invalid` where a number is none the system has, `permission` where this
# user may not give it, `file_not_found` where nothing is there, and
# `unsupported` on Windows, which has no owner by number.
function set_owner(path: str, user: i64, group: i64) -> ()?
    return changes.owned(path, user: user, group: group, through: true)

# What `set_owner` does, to the link itself where `path` is one.
#
# - `path`: the path; a link at its end is given away itself.
# - `user`: the user's number, or -1 to keep it.
# - `group`: the group's number, or -1 to keep it.
#
# Fails as `set_owner` does, `unsupported` on Windows among it.
function set_link_owner(path: str, user: i64, group: i64) -> ()?
    return changes.owned(path, user: user, group: group, through: false)

## Locks

# Locks the whole file the stream `s` stands on, waiting as long as another
# holds a lock that excludes this one.
#
# - `s`: an open stream on a file, which holds the lock until `unlock` or its
#   close; the caller still closes it. A second lock on the same stream
#   replaces the first, which is let go before the second is asked.
# - `exclusive`: true for a lock nothing stands beside, false for a shared
#   one, which other shared locks stand beside.
#
# Fails `closed` where `s` is closed, `unsupported` where it stands on no
# file (a connection's stream). The wait has no deadline and the stop does
# not end it: a program that cannot wait asks `try_lock`. Every other stream
# on the file is kept out, of this process as of another. On POSIX a lock
# keeps out other locks and never a read or a write; on Windows it is
# enforced: another stream's read fails beside an exclusive lock, and a write
# fails through every stream but the one holding an exclusive lock, so a
# shared lock refuses a write through its own stream too. See also
# `try_lock`, `unlock`.
function lock(s: io.Stream, exclusive: bool) -> ()?
    _ = locks.locked(s, exclusive: exclusive, wait: true)?
    return ok()

# Whether the stream `s` now holds a lock on its whole file: true once it
# does, false at once where another holds a lock that excludes it.
#
# - `s`: an open stream on a file, as `lock` takes it.
# - `exclusive`: as `lock` takes it.
#
# Fails as `lock` does. See also `lock`, `unlock`.
function try_lock(s: io.Stream, exclusive: bool) -> bool?
    return locks.locked(s, exclusive: exclusive, wait: false)

# Lets go the lock the stream `s` holds, also where it holds none.
#
# - `s`: the stream, which stays open.
#
# Fails `closed` where `s` is closed. See also `lock`.
function unlock(s: io.Stream) -> ()?
    return locks.unlocked(s)

## Files mapped in memory

# How `open_mapping` maps a file.
variant MapAccess
    # To read alone: `write_at` fails `invalid`.
    read
    # To read and write the file itself: what is written reaches every other
    # map of the file and every reader of it, and the file when the system
    # writes it back, at the latest at `sync_mapping`.
    read_write
    # To read the file and write this map's memory alone: the file is opened
    # to read and never changed, Python's `ACCESS_COPY`.
    copy

# A file mapped in memory, which `open_mapping` answers and `close_mapping`
# closes. It holds a handle: every copy of it reaches the same map, and a copy
# made before `close_mapping` aborts where it is used after, as an
# `io.Stream`'s does. No address inside the map ever reaches the program,
# which reads and writes copies of its bytes.
#
# **The one hazard a copy cannot remove**: on POSIX another program may cut
# the file shorter while it is mapped, and the system then ends a process that
# touches a page past the new end (SIGBUS). Each `read_at` and `write_at` asks
# the file's size first and fails `failed` past it, saying so; a cut that
# falls between that question and the copy still ends the process. Windows
# refuses to cut a file while it is mapped.
record Mapping
    # The floor's handle, `nullptr` once `close_mapping` has emptied this
    # place.
    handle: hero_disk.Mapping
    # The path the file was mapped from, as it was given.
    path: str
    # How it was mapped.
    access: MapAccess
    # Its size in bytes: the file's when it was mapped, which stays, whatever
    # the file becomes.
    size: i64

# The file at `path` mapped whole in memory for `access`, read and written by
# `read_at` and `write_at` with no system call for the bytes themselves.
#
# - `path`: the file, links followed; it is mapped at the size it has now. A
#   file is made longer first, with `truncate`, to be written past its end.
# - `access`: to read, to read and write the file, or to write a private
#   copy.
#
# An empty file is a map of size 0, which reads and writes no byte, where
# Python refuses to map one. The map keeps its file open until
# `close_mapping`, so the process's bound on open files bounds the maps too,
# and the layer takes 4,096 at once.
#
# Fails `file_not_found` where nothing is there, `is_a_directory` for a
# folder, `invalid` for what is no file (a device, a pipe), `permission`
# where the file cannot be opened for `access`, `limit` where the system or
# the layer has no more room for a map, and `unsupported` where its volume
# maps no file. See also `read_at`, `write_at`, `close_mapping`.
function open_mapping(path: str, access: MapAccess) -> Mapping?
    how = match access
        .read       => hero_disk.HERO_DISK_MAP_READ
        .read_write => hero_disk.HERO_DISK_MAP_READ_WRITE
        .copy       => hero_disk.HERO_DISK_MAP_COPY

    made = mapped.opened(at: path, how: how)?
    return ok(Mapping(handle: made.handle, path: path, access: access, size: made.size))

# A copy of `count` bytes of the map `m` from `offset`.
#
# - `m`: the map.
# - `offset`: the first byte's place, 0 to `m.size`.
# - `count`: how many bytes, 0 to `m.size - offset`; 0 copies none.
#
# What another program writes to the file meanwhile may be read half old and
# half new. Where a `copy` map shows a write another made to the file after it
# was mapped is the system's (POSIX leaves it unspecified).
#
# Fails `invalid` where any byte asked stands outside the map, before a byte
# is read or room made for one, `closed` where `m` is closed, and `failed`
# where another program cut the file shorter than the bytes asked. See also
# `write_at`.
function read_at(m: Mapping, offset: i64, count: i64) -> [u8]?
    return mapped.read_at(m.handle, at: m.path, size: m.size, offset: offset, count: count)

# Copies `data` into the map `m` at `offset`.
#
# - `m`: the map, mapped `read_write` or `copy`.
# - `offset`: the first byte's place, 0 to `m.size`.
# - `data`: the bytes, which must all stand inside the map; a write never
#   makes the file longer.
#
# Fails `invalid` where `m` was mapped to read alone or any byte would stand
# outside the map, before a byte is written, `closed` where `m` is closed,
# and `failed` where another program cut the file shorter. See also
# `read_at`, `sync_mapping`.
function write_at(m: Mapping, offset: i64, data: [u8]) -> ()?
    writes = m.access != .read
    return mapped.write_at(m.handle, at: m.path, size: m.size, writes: writes, offset: offset, data: data)

# Puts what was written into the map `m` on the storage itself, as `io.sync`
# puts a stream's writes there: the map's pages, then the file (Darwin's
# `F_FULLFSYNC`, `FlushViewOfFile` and `FlushFileBuffers` on Windows).
#
# - `m`: the map; one mapped `read` or `copy` has nothing to put there, and
#   the call answers at once.
#
# Fails `closed` where `m` is closed, and with the system's code where the
# storage refused. See also `write_at`.
function sync_mapping(m: Mapping) -> ()?
    return mapped.synced(m.handle, at: m.path)

# Unmaps `m` and closes its file, emptying this place, so every later call
# through it fails `closed`.
#
# - `m`: the map, which the caller owns.
#
# What a `read_write` map was written reaches the file when the system writes
# it back, closed or not; only `sync_mapping` waits for the storage. A read or
# a write another thread is in on the map runs to its end, and the map is
# unmapped after it.
#
# Fails `closed` where `m` is closed already, and with the system's code,
# the map ended either way. See also `open_mapping`.
function close_mapping(@m: Mapping) -> ()?
    return mapped.closed(@m.handle, at: m.path)

## Tests

test "read_bytes, write_bytes and append_bytes: no bytes, bytes that are no text, appended to a file there and to none"
    dir = fixture.folder("face-bytes")
    nothing: [u8] = []
    assert !write_bytes(dir + "/f", data: nothing).is_err()
    assert read_bytes(dir + "/f").must() == nothing
    assert !write_bytes(dir + "/f", data: [0xff, 0, 0x80]).is_err()
    assert !append_bytes(dir + "/f", data: [1]).is_err()
    assert read_bytes(dir + "/f").must() == [0xff, 0, 0x80, 1]
    assert !append_bytes(dir + "/g", data: [2]).is_err()
    assert read_bytes(dir + "/g").must() == [2]

    match read_bytes(dir)
        .ok _  => assert false
        .err e => assert e.code == IS_A_DIRECTORY

    match write_bytes(dir, data: [1])
        .ok _  => assert false
        .err e => assert e.code == IS_A_DIRECTORY

    assert fixture.cleared(dir)

test "append_text, write_new_text, write_new_bytes and touch: text added, a new file made once, and a touched file kept"
    dir = fixture.folder("face-text")
    assert !append_text(path: dir + "/log", text: "a\n").is_err()
    assert !append_text(path: dir + "/log", text: "è\n").is_err()
    assert read_file(dir + "/log").must() == "a\nè\n"
    assert !write_new_text(path: dir + "/n", text: "once").is_err()

    match write_new_text(path: dir + "/n", text: "twice")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    match write_new_bytes(dir + "/n", data: [1])
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    assert read_file(dir + "/n").must() == "once"
    assert !touch(dir + "/n").is_err()
    assert read_file(dir + "/n").must() == "once"
    assert !touch(dir + "/t").is_err()
    assert read_file(dir + "/t").must() == ""

    match touch(dir + "/no/t")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "open, create and open_with: nothing to open, each access, a permission out of range, and a stream read back"
    dir = fixture.folder("face-open")

    match open(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    out @= create(dir + "/f").must()
    assert !io.write_text(out, "hello").is_err()
    assert !io.close(@out).is_err()
    both @= open_with(dir + "/f", access: .read_write, permission: 0).must()
    assert io.read_all_text(both).must() == "hello"
    assert !io.close(@both).is_err()
    tail @= open_with(dir + "/f", access: .append, permission: 0o644).must()
    assert !io.write_text(tail, "!").is_err()
    assert !io.close(@tail).is_err()
    back @= open(dir + "/f").must()
    assert io.read_all_text(back).must() == "hello!"
    assert !io.close(@back).is_err()

    match open_with(dir + "/f", access: .create_new, permission: 0o644)
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    match open_with(dir + "/g", access: .write, permission: 0o1000)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    emptied @= open_with(dir + "/f", access: .write, permission: 0o644).must()
    assert !io.close(@emptied).is_err()
    assert read_file(dir + "/f").must() == ""
    reading @= open_with(dir + "/f", access: .read, permission: 0).must()
    assert !io.close(@reading).is_err()
    assert fixture.cleared(dir)

test "info and link_info: a file, a folder, a link and what it names, and nothing there"
    dir = fixture.folder("face-info")
    assert !write_file(path: dir + "/f", text: "hello").is_err()
    assert !set_times(dir + "/f", written: time.Instant(unix_nanoseconds: 1_600_000_000_000_000_000), read: time.Instant(unix_nanoseconds: 1_600_000_000_000_000_000)).is_err()
    file = info(dir + "/f").must()
    assert file.kind == .file && file.size == 5 && file.links == 1
    assert file.written == time.Instant(unix_nanoseconds: 1_600_000_000_000_000_000)
    assert info(dir).must().kind == .directory

    if fixture.linked(target: "f", name: dir + "/l")
        assert info(dir + "/l").must().kind == .file
        assert link_info(dir + "/l").must().kind == .link
        assert link_info(dir + "/l").must().size == fixture.link_size("f")

    match info(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND && e.msg == f"reading the facts of \"{dir}/none\": nothing is there"

    assert fixture.cleared(dir)

test "exists, is_file, is_dir, is_link and is_same_file: each kind, nothing there, a file on the way, and a link to nothing"
    dir = fixture.folder("face-is")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert exists(dir + "/f").must() && is_file(dir + "/f").must() && !is_dir(dir + "/f").must()
    assert exists(dir).must() && is_dir(dir).must() && !is_file(dir).must()
    assert !exists(dir + "/none").must() && !is_file(dir + "/none").must() && !is_link(dir + "/none").must()
    assert !exists(dir + "/f/below").must()
    assert !is_link(dir + "/f").must()
    assert is_same_file(path: dir + "/f", other: dir + "/./f").must()

    if fixture.linked(target: "none", name: dir + "/dangling")
        assert is_link(dir + "/dangling").must()
        assert !exists(dir + "/dangling").must()
    assert fixture.cleared(dir)

test "space: the bytes available are at most the volume's size, and nothing there"
    dir = fixture.folder("face-space")
    room = space(dir).must()
    assert room.total > 0 && room.available >= 0 && room.available <= room.total

    match space(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "make_dir, make_dir_with, make_dir_all and read_dir: made, there already, deep, over a file, and listed sorted with their kinds"
    dir = fixture.folder("face-dirs")
    assert !make_dir(dir + "/b").is_err()

    match make_dir(dir + "/b")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    assert !make_dir_with(dir + "/a", permission: 0o700).is_err()
    bits = info(dir + "/a").must().permission
    assert bits == 0o700 || bits == 0o666

    match make_dir_with(dir + "/x", permission: -1)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert !make_dir_all(dir + "/c/d/e").is_err()
    assert !make_dir_all(dir + "/c/d/e").is_err()
    assert !write_file(path: dir + "/f", text: "x").is_err()

    match make_dir_all(dir + "/f/g")
        .ok _  => assert false
        .err e => assert e.code == NOT_A_DIRECTORY

    listed = read_dir(dir).must()
    assert listed == [Entry(name: "a", kind: .directory), Entry(name: "b", kind: .directory), Entry(name: "c", kind: .directory), Entry(name: "f", kind: .file)]
    nothing: [Entry] = []
    assert read_dir(dir + "/b").must() == nothing

    match read_dir(dir + "/f")
        .ok _  => assert false
        .err e => assert e.code == NOT_A_DIRECTORY

    assert fixture.cleared(dir)

test "remove, remove_all, rename and move: a file, a folder full and empty, a name not there, and a rename onto a folder"
    dir = fixture.folder("face-remove")
    assert !make_dir_all(dir + "/t/u").is_err()
    assert !write_file(path: dir + "/t/u/f", text: "x").is_err()

    match remove(dir + "/t")
        .ok _  => assert false
        .err e => assert e.code == NOT_EMPTY

    assert !rename(from: dir + "/t", to: dir + "/r").is_err()
    assert !move(from: dir + "/r", to: dir + "/m").is_err()
    assert read_file(dir + "/m/u/f").must() == "x"

    match rename(from: dir + "/m/u/f", to: dir + "/m")
        .ok _  => assert false
        .err e => assert e.code == IS_A_DIRECTORY

    assert !remove_all(dir + "/m").is_err()
    assert !exists(dir + "/m").must()

    match remove_all(dir + "/m")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    match remove(dir + "/m")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "walk, walk_following_links and glob: the empty folder, entries with their kinds, a link, and a pattern"
    dir = fixture.folder("face-walk")
    nothing: [Entry] = []
    assert walk(dir).must() == nothing
    assert !make_dir_all(dir + "/d").is_err()
    assert !write_file(path: dir + "/d/f.txt", text: "x").is_err()
    sep = paths.sep()
    assert walk(dir).must() == [Entry(name: "d", kind: .directory), Entry(name: "d" + sep + "f.txt", kind: .file)]

    if fixture.linked(target: "d", name: dir + "/l")
        assert walk(dir).must()[2] == Entry(name: "l", kind: .link)
        through = walk_following_links(dir).must()
        assert through.len() == 4 && through[2] == Entry(name: "l", kind: .directory)
        assert through[3] == Entry(name: "l" + sep + "f.txt", kind: .file)
    assert glob(dir + "/d/*.txt").must() == [dir + "/d/f.txt"]

    match walk(dir + "/d/f.txt")
        .ok _  => assert false
        .err e => assert e.code == NOT_A_DIRECTORY

    match glob(dir + "/[")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert fixture.cleared(dir)

test "walk_to_depth: the root's own entries, two levels, deeper than the tree, an unreadable folder below the bound left unread, and a depth below 1"
    dir = fixture.folder("face-walk-depth")
    assert !make_dir_all(dir + "/a/b/c").is_err()
    assert !write_file(path: dir + "/top.txt", text: "x").is_err()
    assert !write_file(path: dir + "/a/b/c/deep.txt", text: "y").is_err()
    sep = paths.sep()
    assert walk_to_depth(dir, depth: 1).must() == [Entry(name: "a", kind: .directory), Entry(name: "top.txt", kind: .file)]
    two = walk_to_depth(dir, depth: 2).must()
    assert two == [Entry(name: "a", kind: .directory), Entry(name: "a" + sep + "b", kind: .directory), Entry(name: "top.txt", kind: .file)]
    assert walk_to_depth(dir, depth: 9).must() == walk(dir).must()

    if !fixture.windows()
        assert !set_permission(dir + "/a/b", permission: 0).is_err()

        # A folder this user may not read stands at the bound: listed, and
        # never read, so the walk does not fail on it.
        assert walk_to_depth(dir, depth: 2).must() == two
        assert !set_permission(dir + "/a/b", permission: 0o755).is_err()

    for bad in [0, -1]
        match walk_to_depth(dir, depth: bad)
            .ok _  => assert false
            .err e => assert e.code == INVALID && e.msg == f"walking \"{dir}\" to a depth of {bad}: a depth is 1 or more"

    assert fixture.cleared(dir)

test "copy_file and copy_tree: bytes and their count, a tree, onto itself, and onto a folder there"
    dir = fixture.folder("face-copy")
    assert !write_file(path: dir + "/a", text: "caffè").is_err()
    assert copy_file(from: dir + "/a", to: dir + "/b").must() == 6
    assert read_file(dir + "/b").must() == "caffè"

    match copy_file(from: dir + "/a", to: dir + "/a")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert !make_dir_all(dir + "/t/u").is_err()
    assert !write_file(path: dir + "/t/u/f", text: "y").is_err()
    assert !copy_tree(from: dir + "/t", to: dir + "/c").is_err()
    assert read_file(dir + "/c/u/f").must() == "y"

    match copy_tree(from: dir + "/t", to: dir + "/c")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    assert fixture.cleared(dir)

test "read_link, resolve and to_abs: a link's target, a path through a link, a relative path, and no link"
    dir = fixture.folder("face-links")
    assert !make_dir(dir + "/real").is_err()
    real = resolve(dir + "/real").must()
    assert real == to_abs(dir + "/real").must()

    if fixture.linked(target: "real", name: dir + "/l")
        assert read_link(dir + "/l").must() == "real"
        assert resolve(dir + "/l").must() == real

    match read_link(dir + "/real")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match resolve(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert to_abs("").must() == to_abs(".").must()
    assert fixture.cleared(dir)

test "make_temp_dir and make_temp_file: names by the pattern, a stream to write, a separator refused"
    dir = fixture.folder("face-temp")
    made = make_temp_dir(dir: dir, pattern: "d-*").must()
    assert is_dir(made).must()
    file @= make_temp_file(dir: dir, pattern: "*.log").must()
    assert !io.write_text(file.stream, "kept").is_err()
    assert !io.close(@file.stream).is_err()
    assert read_file(file.path).must() == "kept"

    match make_temp_dir(dir: dir, pattern: "a/*")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert fixture.cleared(dir)

test "set_times, truncate, set_owner and set_link_owner: times read back, a length cut, an owner left, and nothing there"
    dir = fixture.folder("face-set")
    assert !write_file(path: dir + "/f", text: "hello").is_err()
    then = time.Instant(unix_nanoseconds: 0)
    assert !set_times(dir + "/f", written: then, read: then).is_err()
    assert info(dir + "/f").must().written == then
    assert !truncate(dir + "/f", length: 2).is_err()
    assert read_file(dir + "/f").must() == "he"

    match truncate(dir + "/f", length: -1)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match set_owner(dir + "/f", user: -1, group: -1)
        .ok _  => _ = 0
        .err e => assert e.code == UNSUPPORTED

    match set_link_owner(dir + "/f", user: -1, group: -1)
        .ok _  => _ = 0
        .err e => assert e.code == UNSUPPORTED

    match set_times(dir + "/none", written: then, read: then)
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "hard_link and symlink: a second name and a link to it, a name there already, a folder, an empty target, and Windows' refusal"
    dir = fixture.folder("face-links")
    assert !write_file(path: dir + "/f", text: "hello").is_err()
    assert !hard_link(existing: dir + "/f", name: dir + "/g").is_err()
    assert info(dir + "/f").must().links == 2
    assert is_same_file(path: dir + "/f", other: dir + "/g").must()

    match hard_link(existing: dir + "/f", name: dir + "/g")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    match hard_link(existing: dir, name: dir + "/h")
        .ok _  => assert false
        .err e => assert e.code == IS_A_DIRECTORY

    match symlink(target: "", name: dir + "/e")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match symlink(target: "f", name: dir + "/l")
        .ok _ =>
            assert read_link(dir + "/l").must() == "f"
            assert read_file(dir + "/l").must() == "hello"
        .err e => assert fixture.windows() && e.code == PERMISSION

    assert fixture.cleared(dir)

test "permission_of, set_permission and set_link_permission: bits read back, Windows' read-only, a link's own or unsupported, out of range"
    dir = fixture.folder("face-bits")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert !set_permission(dir + "/f", permission: 0o600).is_err()

    if fixture.windows()
        assert permission_of(dir + "/f").must() == 0o666
    else
        assert permission_of(dir + "/f").must() == 0o600
    assert !set_permission(dir + "/f", permission: 0o444).is_err()
    assert permission_of(dir + "/f").must() == 0o444
    assert !set_permission(dir + "/f", permission: 0o644).is_err()

    match set_permission(dir + "/f", permission: -1)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match permission_of(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    if fixture.linked(target: "f", name: dir + "/l")
        match set_link_permission(dir + "/l", permission: 0o444)
            .ok _  => assert link_info(dir + "/l").must().permission == 0o444
            .err e => assert e.code == UNSUPPORTED

        assert permission_of(dir + "/l").must() == permission_of(dir + "/f").must()
        _ = set_link_permission(dir + "/l", permission: 0o644).is_err()
    assert fixture.cleared(dir)

test "set_link_times, created, owner and link_owner: a link's own times, the time a file was made, its owner or unsupported"
    dir = fixture.folder("face-made")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)
    later = time.Instant(unix_nanoseconds: 1_600_000_000_000_000_000)
    assert !set_times(dir + "/f", written: later, read: later).is_err()

    if fixture.linked(target: "f", name: dir + "/l")
        assert !set_link_times(dir + "/l", written: then, read: then).is_err()
        assert link_info(dir + "/l").must().written == then
        assert info(dir + "/f").must().written == later

    match created(dir + "/f")
        .ok t  => assert t.unix_nanoseconds > 1_577_836_800_000_000_000
        .err e => assert e.code == UNSUPPORTED

    match owner(dir + "/f")
        .ok o =>
            assert o.user >= 0 && o.group >= 0
            assert link_owner(dir + "/f").must() == o
        .err e => assert fixture.windows() && e.code == UNSUPPORTED

    match created(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "other_kind: the device that drops bytes, a file that is no other, and nothing there"
    dir = fixture.folder("face-other")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    device: str @= "/dev/null"

    if fixture.windows()
        device @ "NUL"
    assert other_kind(device).must() == .character_device

    match other_kind(dir + "/f")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match other_kind(dir + "/none")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "copy_permission, copy_facts and copy_file_with_facts: bits and times given, a file there replaced, and one not there"
    dir = fixture.folder("face-copy-facts")
    assert !write_file(path: dir + "/a", text: "abc").is_err()
    assert !write_file(path: dir + "/b", text: "z").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)
    assert !set_times(dir + "/a", written: then, read: then).is_err()
    assert !set_permission(dir + "/a", permission: 0o640).is_err()
    assert !copy_permission(from: dir + "/a", to: dir + "/b").is_err()
    assert permission_of(dir + "/b").must() == permission_of(dir + "/a").must()
    assert !copy_facts(from: dir + "/a", to: dir + "/b").is_err()
    assert info(dir + "/b").must().written == then
    assert copy_file_with_facts(from: dir + "/a", to: dir + "/c").must() == 3
    assert read_file(dir + "/c").must() == "abc"
    assert info(dir + "/c").must().written == then
    assert permission_of(dir + "/c").must() == permission_of(dir + "/a").must()

    match copy_permission(from: dir + "/none", to: dir + "/b")
        .ok _  => assert false
        .err e => assert e.code == FILE_NOT_FOUND

    assert fixture.cleared(dir)

test "lock, try_lock and unlock: shared beside shared, exclusive refused at once, given once let go, and a closed stream"
    dir = fixture.folder("face-lock")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    a @= open(dir + "/f").must()
    b @= open(dir + "/f").must()
    assert !lock(a, exclusive: false).is_err()
    assert try_lock(b, exclusive: false).must()
    assert !try_lock(b, exclusive: true).must()
    assert !unlock(a).is_err()
    assert try_lock(b, exclusive: true).must()
    assert !try_lock(a, exclusive: false).must()
    assert !unlock(b).is_err()
    assert !unlock(b).is_err()
    assert !io.close(@b).is_err()

    match try_lock(b, exclusive: true)
        .ok _  => assert false
        .err e => assert e.code == CLOSED

    assert !io.close(@a).is_err()
    assert fixture.cleared(dir)

## Examples

# A file read whole as bytes, as an image or an archive is.
test "read_bytes: the bytes a file holds"
    dir = fixture.folder("example-read-bytes")
    assert !write_bytes(path: dir + "/data.bin", data: [0, 1, 255]).is_err()
    assert read_bytes(dir + "/data.bin").must() == [0, 1, 255]
    assert fixture.cleared(dir)

# A file written whole from bytes, replacing what it held.
test "write_bytes: a file made, then replaced"
    dir = fixture.folder("example-write-bytes")
    assert !write_bytes(path: dir + "/data.bin", data: [1, 2, 3]).is_err()
    assert !write_bytes(path: dir + "/data.bin", data: [9]).is_err()
    assert read_bytes(dir + "/data.bin").must() == [9]
    assert fixture.cleared(dir)

# A line added at the end of a log file.
test "append_text: two lines added to a log"
    dir = fixture.folder("example-append-text")
    assert !append_text(path: dir + "/app.log", text: "started\n").is_err()
    assert !append_text(path: dir + "/app.log", text: "stopped\n").is_err()
    assert read_file(dir + "/app.log").must() == "started\nstopped\n"
    assert fixture.cleared(dir)

# Bytes added at the end of a file.
test "append_bytes: a record added to a file of records"
    dir = fixture.folder("example-append-bytes")
    assert !append_bytes(path: dir + "/records", data: [1]).is_err()
    assert !append_bytes(path: dir + "/records", data: [2]).is_err()
    assert read_bytes(dir + "/records").must() == [1, 2]
    assert fixture.cleared(dir)

# A file made only where none is there, as a lock file or a claim is.
test "write_new_text: a second writer is told the file exists"
    dir = fixture.folder("example-write-new-text")
    assert !write_new_text(path: dir + "/claim", text: "mine").is_err()

    match write_new_text(path: dir + "/claim", text: "theirs")
        .ok _  => assert false
        .err e => assert e.code == EXISTS

    assert read_file(dir + "/claim").must() == "mine"
    assert fixture.cleared(dir)

# Bytes written to a file made only where none is there.
test "write_new_bytes: a new file of bytes"
    dir = fixture.folder("example-write-new-bytes")
    assert !write_new_bytes(path: dir + "/new.bin", data: [7]).is_err()
    assert read_bytes(dir + "/new.bin").must() == [7]
    assert fixture.cleared(dir)

# An empty file made, as a marker a build leaves.
test "touch: an empty marker file"
    dir = fixture.folder("example-touch")
    assert !touch(dir + "/done").is_err()
    assert info(dir + "/done").must().size == 0
    assert fixture.cleared(dir)

# A file opened as a stream and read line by line with `io`.
test "open: a file read through a stream"
    dir = fixture.folder("example-open")
    assert !write_file(path: dir + "/lines.txt", text: "one\ntwo\n").is_err()
    s @= open(dir + "/lines.txt").must()
    lines @= io.reader(s)
    assert io.read_line(@lines).must() == "one"
    io.close(@s).must()
    assert fixture.cleared(dir)

# A file made and written through a stream.
test "create: a file written through a stream"
    dir = fixture.folder("example-create")
    s @= create(dir + "/out.txt").must()
    io.write_text(s, text: "hello").must()
    io.close(@s).must()
    assert read_file(dir + "/out.txt").must() == "hello"
    assert fixture.cleared(dir)

# A file opened to add at its end, made where it is not there.
test "open_with: a log opened to append"
    dir = fixture.folder("example-open-with")
    s @= open_with(dir + "/app.log", access: .append, permission: 0o644).must()
    io.write_text(s, text: "line\n").must()
    io.close(@s).must()
    assert read_file(dir + "/app.log").must() == "line\n"
    assert fixture.cleared(dir)

# The facts of a file: its kind and its size.
test "info: a file of five bytes"
    dir = fixture.folder("example-info")
    assert !write_file(path: dir + "/f.txt", text: "hello").is_err()
    found = info(dir + "/f.txt").must()
    assert found.kind == .file && found.size == 5
    assert fixture.cleared(dir)

# The facts of a link itself, not of what it names.
test "link_info: a link is a link"
    dir = fixture.folder("example-link-info")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    if fixture.linked(target: "f", name: dir + "/l")
        assert link_info(dir + "/l").must().kind == .link
    assert fixture.cleared(dir)

# Whether a path names something.
test "exists: a file there, and a name of nothing"
    dir = fixture.folder("example-exists")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert exists(dir + "/f").must() && !exists(dir + "/none").must()
    assert fixture.cleared(dir)

# Whether a path names a file.
test "is_file: a file is, a folder is not"
    dir = fixture.folder("example-is-file")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert is_file(dir + "/f").must() && !is_file(dir).must()
    assert fixture.cleared(dir)

# Whether a path names a folder.
test "is_dir: a folder is, a file is not"
    dir = fixture.folder("example-is-dir")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert is_dir(dir).must() && !is_dir(dir + "/f").must()
    assert fixture.cleared(dir)

# Whether a path is a symbolic link.
test "is_link: a link is, its target is not"
    dir = fixture.folder("example-is-link")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    if fixture.linked(target: "f", name: dir + "/l")
        assert is_link(dir + "/l").must() && !is_link(dir + "/f").must()
    assert fixture.cleared(dir)

# Whether two paths name one file, as a copy onto itself is caught.
test "is_same_file: a file and a path through its folder"
    dir = fixture.folder("example-is-same-file")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert is_same_file(path: dir + "/f", other: dir + "/./f").must()
    assert fixture.cleared(dir)

# The room left on the volume a path stands on.
test "space: the working folder's volume"
    room = space(".").must()
    assert room.total > 0 && room.available <= room.total

# A folder made.
test "make_dir: one folder"
    dir = fixture.folder("example-make-dir")
    assert !make_dir(dir + "/cache").is_err()
    assert is_dir(dir + "/cache").must()
    assert fixture.cleared(dir)

# A folder made for this user alone.
test "make_dir_with: a private folder"
    dir = fixture.folder("example-make-dir-with")
    assert !make_dir_with(dir + "/private", permission: 0o700).is_err()
    assert is_dir(dir + "/private").must()
    assert fixture.cleared(dir)

# A folder made with every folder above it.
test "make_dir_all: a folder three levels down"
    dir = fixture.folder("example-make-dir-all")
    assert !make_dir_all(dir + "/a/b/c").is_err()
    assert is_dir(dir + "/a/b/c").must()
    assert fixture.cleared(dir)

# The entries of a folder, sorted by name.
test "read_dir: a folder's files and folders"
    dir = fixture.folder("example-read-dir")
    assert !write_file(path: dir + "/b.txt", text: "").is_err()
    assert !make_dir(dir + "/a").is_err()
    assert read_dir(dir).must() == [Entry(name: "a", kind: .directory), Entry(name: "b.txt", kind: .file)]
    assert fixture.cleared(dir)

# A file removed.
test "remove: a file gone"
    dir = fixture.folder("example-remove")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert !remove(dir + "/f").is_err()
    assert !exists(dir + "/f").must()
    assert fixture.cleared(dir)

# A folder removed with everything in it.
test "remove_all: a tree gone"
    dir = fixture.folder("example-remove-all")
    assert !make_dir_all(dir + "/t/u").is_err()
    assert !write_file(path: dir + "/t/u/f", text: "x").is_err()
    assert !remove_all(dir + "/t").is_err()
    assert !exists(dir + "/t").must()
    assert fixture.cleared(dir)

# A file renamed in its folder.
test "rename: a draft becomes the final file"
    dir = fixture.folder("example-rename")
    assert !write_file(path: dir + "/draft.txt", text: "x").is_err()
    assert !rename(from: dir + "/draft.txt", to: dir + "/final.txt").is_err()
    assert read_file(dir + "/final.txt").must() == "x" && !exists(dir + "/draft.txt").must()
    assert fixture.cleared(dir)

# A file moved into another folder, on this volume or another.
test "move: a file into an archive folder"
    dir = fixture.folder("example-move")
    assert !make_dir(dir + "/archive").is_err()
    assert !write_file(path: dir + "/old.log", text: "x").is_err()
    assert !move(from: dir + "/old.log", to: dir + "/archive/old.log").is_err()
    assert read_file(dir + "/archive/old.log").must() == "x"
    assert fixture.cleared(dir)

# Every path of a tree.
test "walk: a folder and the file in it"
    dir = fixture.folder("example-walk")
    assert !make_dir(dir + "/d").is_err()
    assert !write_file(path: dir + "/d/f.txt", text: "x").is_err()
    assert walk(dir).must() == [Entry(name: "d", kind: .directory), Entry(name: "d" + paths.sep() + "f.txt", kind: .file)]
    assert fixture.cleared(dir)

# Every path of a tree, a link to a folder entered.
test "walk_following_links: a link to a folder walked into"
    dir = fixture.folder("example-walk-following")
    assert !make_dir(dir + "/d").is_err()
    assert !write_file(path: dir + "/d/f", text: "x").is_err()

    if fixture.linked(target: "d", name: dir + "/l")
        assert walk_following_links(dir).must()[2] == Entry(name: "l", kind: .directory)
    assert fixture.cleared(dir)

# A folder's children and grandchildren, nothing deeper read.
test "walk_to_depth: two levels of a tree"
    dir = fixture.folder("example-walk-to-depth")
    assert !make_dir_all(dir + "/src/lib/deep").is_err()
    found = walk_to_depth(dir, depth: 2).must()
    assert found == [Entry(name: "src", kind: .directory), Entry(name: "src" + paths.sep() + "lib", kind: .directory)]
    assert fixture.cleared(dir)

# The files a pattern names.
test "glob: the text files of a folder"
    dir = fixture.folder("example-glob")
    assert !write_file(path: dir + "/a.txt", text: "").is_err()
    assert !write_file(path: dir + "/b.md", text: "").is_err()
    assert glob(dir + "/*.txt").must() == [dir + "/a.txt"]
    assert fixture.cleared(dir)

# A file copied, and how many bytes it held.
test "copy_file: a backup copy"
    dir = fixture.folder("example-copy-file")
    assert !write_file(path: dir + "/notes.txt", text: "abc").is_err()
    assert copy_file(from: dir + "/notes.txt", to: dir + "/notes.bak").must() == 3
    assert read_file(dir + "/notes.bak").must() == "abc"
    assert fixture.cleared(dir)

# A folder copied with everything in it.
test "copy_tree: a project's folder copied"
    dir = fixture.folder("example-copy-tree")
    assert !make_dir_all(dir + "/src/lib").is_err()
    assert !write_file(path: dir + "/src/lib/a.hero", text: "x").is_err()
    assert !copy_tree(from: dir + "/src", to: dir + "/copy").is_err()
    assert read_file(dir + "/copy/lib/a.hero").must() == "x"
    assert fixture.cleared(dir)

# The target a symbolic link holds.
test "read_link: the target as the link holds it"
    dir = fixture.folder("example-read-link")

    if fixture.linked(target: "elsewhere.txt", name: dir + "/l")
        assert read_link(dir + "/l").must() == "elsewhere.txt"
    assert fixture.cleared(dir)

# The absolute path a path names, its links followed.
test "resolve: a path made absolute through its folder"
    dir = fixture.folder("example-resolve")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    full = resolve(dir + "/./f").must()
    assert paths.is_abs(full) && is_same_file(path: full, other: dir + "/f").must()
    assert fixture.cleared(dir)

# A relative path made absolute, no link read.
test "to_abs: a relative path against the working folder"
    full = to_abs("notes/today.txt").must()
    assert paths.is_abs(full) && paths.name(full).must() == "today.txt"

# A scratch folder of its own, removed by the program when done.
test "make_temp_dir: a scratch folder"
    dir = fixture.folder("example-temp-dir")
    scratch = make_temp_dir(dir: dir, pattern: "work-*").must()
    assert is_dir(scratch).must() && paths.name(scratch).must().len() == 21
    assert fixture.cleared(dir)

# A scratch file and the stream that writes it.
test "make_temp_file: a scratch file written"
    dir = fixture.folder("example-temp-file")
    made @= make_temp_file(dir: dir, pattern: "report-*.txt").must()
    io.write_text(made.stream, text: "draft").must()
    io.close(@made.stream).must()
    assert read_file(made.path).must() == "draft"
    assert fixture.cleared(dir)

# A file's times set, as an archive's extraction keeps them.
test "set_times: a file dated 2017"
    dir = fixture.folder("example-set-times")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)
    assert !set_times(dir + "/f", written: then, read: then).is_err()
    assert info(dir + "/f").must().written == then
    assert fixture.cleared(dir)

# A file cut to a length.
test "truncate: a file cut to its first two bytes"
    dir = fixture.folder("example-truncate")
    assert !write_file(path: dir + "/f", text: "hello").is_err()
    assert !truncate(dir + "/f", length: 2).is_err()
    assert read_file(dir + "/f").must() == "he"
    assert fixture.cleared(dir)

# A file given to a user and a group, -1 keeping both: what a program that
# runs as root does to hand a file over.
test "set_owner: an owner kept as it is"
    dir = fixture.folder("example-set-owner")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    match set_owner(dir + "/f", user: -1, group: -1)
        .ok _  => assert !fixture.windows()
        .err e => assert e.code == UNSUPPORTED && fixture.windows()

    assert fixture.cleared(dir)

# A link given to a user and a group, the file it names left alone.
test "set_link_owner: a link's owner kept as it is"
    dir = fixture.folder("example-set-link-owner")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    if fixture.linked(target: "f", name: dir + "/l")
        match set_link_owner(dir + "/l", user: -1, group: -1)
            .ok _  => assert !fixture.windows()
            .err e => assert e.code == UNSUPPORTED && fixture.windows()
    assert fixture.cleared(dir)

# The files of a project git would see, its build output and git's own folder
# left out.
test "walk_ignoring: a project's sources, its build left out"
    dir = fixture.folder("example-walk-ignoring")
    assert !write_file(path: dir + "/.gitignore", text: "build/\n").is_err()
    assert !write_file(path: dir + "/main.hero", text: "").is_err()
    assert !make_dir_all(dir + "/build").is_err() && !make_dir_all(dir + "/.git").is_err()
    assert !write_file(path: dir + "/build/main", text: "").is_err()
    found = walk_ignoring(root: dir, ignores: paths.parse_ignore(".git/\n"), name: ".gitignore").must()
    assert found == [Entry(name: ".gitignore", kind: .file), Entry(name: "main.hero", kind: .file)]
    assert fixture.cleared(dir)

# A second name for a file: both names read the same bytes.
test "hard_link: a file under two names"
    dir = fixture.folder("example-hard-link")
    assert !write_file(path: dir + "/notes.txt", text: "kept").is_err()
    assert !hard_link(existing: dir + "/notes.txt", name: dir + "/copy.txt").is_err()
    assert read_file(dir + "/copy.txt").must() == "kept"
    assert fixture.cleared(dir)

# A link to a file beside it, read through and read itself.
test "symlink: a link to a file in the same folder"
    dir = fixture.folder("example-symlink")
    assert !write_file(path: dir + "/config.toml", text: "a = 1").is_err()

    match symlink(target: "config.toml", name: dir + "/current.toml")
        .ok _  => assert read_link(dir + "/current.toml").must() == "config.toml"
        .err e => assert e.code == PERMISSION

    assert fixture.cleared(dir)

# The bits of a file made read-only.
test "permission_of: a file made read-only reads 0o444"
    dir = fixture.folder("example-permission")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert !set_permission(dir + "/f", permission: 0o444).is_err()
    assert permission_of(dir + "/f").must() == 0o444
    assert !set_permission(dir + "/f", permission: 0o644).is_err()
    assert fixture.cleared(dir)

# A file made read-only and writable again.
test "set_permission: read-only, then writable again"
    dir = fixture.folder("example-set-permission")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    assert !set_permission(dir + "/f", permission: 0o444).is_err()
    assert !set_permission(dir + "/f", permission: 0o644).is_err()
    assert !write_file(path: dir + "/f", text: "y").is_err()
    assert fixture.cleared(dir)

# The bits of a link itself, where the system keeps them.
test "set_link_permission: a link made read-only, or unsupported on Linux"
    dir = fixture.folder("example-link-permission")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    if fixture.linked(target: "f", name: dir + "/l")
        match set_link_permission(dir + "/l", permission: 0o444)
            .ok _  => assert link_info(dir + "/l").must().permission == 0o444
            .err e => assert e.code == UNSUPPORTED
    assert fixture.cleared(dir)

# A link's own times, its target's left alone.
test "set_link_times: a link dated 2017"
    dir = fixture.folder("example-link-times")
    assert !write_file(path: dir + "/f", text: "x").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)

    if fixture.linked(target: "f", name: dir + "/l")
        assert !set_link_times(dir + "/l", written: then, read: then).is_err()
        assert link_info(dir + "/l").must().written == then
    assert fixture.cleared(dir)

# When a file was made, where the system keeps it.
test "created: a file made now"
    dir = fixture.folder("example-created")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    match created(dir + "/f")
        .ok t  => assert t.unix_nanoseconds > 1_577_836_800_000_000_000
        .err e => assert e.code == UNSUPPORTED

    assert fixture.cleared(dir)

# Who owns a file this program made: the user it runs as.
test "owner: a file this program made"
    dir = fixture.folder("example-owner")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    match owner(dir + "/f")
        .ok o  => assert o.user >= 0
        .err e => assert e.code == UNSUPPORTED

    assert fixture.cleared(dir)

# A link's own owner, which is a file's own where no link is there.
test "link_owner: of a file, the file's owner"
    dir = fixture.folder("example-link-owner")
    assert !write_file(path: dir + "/f", text: "x").is_err()

    match link_owner(dir + "/f")
        .ok o  => assert o == owner(dir + "/f").must()
        .err e => assert e.code == UNSUPPORTED

    assert fixture.cleared(dir)

# The device every system has that drops what it is written.
test "other_kind: the null device is a character device"
    device: str @= "/dev/null"

    if fixture.windows()
        device @ "NUL"
    assert other_kind(device).must() == .character_device

# A copy's permission bits made the original's.
test "copy_permission: a copy made read-only as its original"
    dir = fixture.folder("example-copy-permission")
    assert !write_file(path: dir + "/a", text: "x").is_err()
    assert !write_file(path: dir + "/b", text: "x").is_err()
    assert !set_permission(dir + "/a", permission: 0o444).is_err()
    assert !copy_permission(from: dir + "/a", to: dir + "/b").is_err()
    assert permission_of(dir + "/b").must() == 0o444
    assert fixture.cleared(dir)

# A copy dated as its original.
test "copy_facts: the times of the original given to another file"
    dir = fixture.folder("example-copy-facts")
    assert !write_file(path: dir + "/a", text: "x").is_err()
    assert !write_file(path: dir + "/b", text: "y").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)
    assert !set_times(dir + "/a", written: then, read: then).is_err()
    assert !copy_facts(from: dir + "/a", to: dir + "/b").is_err()
    assert info(dir + "/b").must().written == then
    assert fixture.cleared(dir)

# A backup that keeps its original's date.
test "copy_file_with_facts: a backup dated as the original"
    dir = fixture.folder("example-copy-with-facts")
    assert !write_file(path: dir + "/data", text: "abc").is_err()
    then = time.Instant(unix_nanoseconds: 1_500_000_000_000_000_000)
    assert !set_times(dir + "/data", written: then, read: then).is_err()
    assert copy_file_with_facts(from: dir + "/data", to: dir + "/data.bak").must() == 3
    assert info(dir + "/data.bak").must().written == then
    assert fixture.cleared(dir)

# One writer at a time: an exclusive lock held while the file is used.
test "lock: an exclusive lock held, then let go"
    dir = fixture.folder("example-lock")
    assert !write_file(path: dir + "/db", text: "x").is_err()
    s @= open(dir + "/db").must()
    assert !lock(s, exclusive: true).is_err()
    assert !unlock(s).is_err()
    assert !io.close(@s).is_err()
    assert fixture.cleared(dir)

# A settings file written whole: a reader finds the old text or the new.
test "write_atomic_text: a settings file replaced in one step"
    dir = fixture.folder("example-atomic-text")
    assert !write_file(path: dir + "/settings.toml", text: "size = 1\n").is_err()
    assert !write_atomic_text(path: dir + "/settings.toml", text: "size = 2\n").is_err()
    assert read_file(dir + "/settings.toml").must() == "size = 2\n"
    assert fixture.cleared(dir)

# Bytes written whole where no file was.
test "write_atomic_bytes: a new file of bytes"
    dir = fixture.folder("example-atomic-bytes")
    assert !write_atomic_bytes(dir + "/state.bin", data: [0xca, 0xfe]).is_err()
    assert read_bytes(dir + "/state.bin").must() == [0xca, 0xfe]
    assert fixture.cleared(dir)

# A file mapped to read, and closed.
test "open_mapping: a file mapped to read"
    dir = fixture.folder("example-open-mapping")
    assert !write_file(path: dir + "/data", text: "abcdef").is_err()
    m @= open_mapping(dir + "/data", access: .read).must()
    assert m.size == 6
    assert !close_mapping(@m).is_err()
    assert fixture.cleared(dir)

# A few bytes in the middle of a mapped file.
test "read_at: three bytes from the middle"
    dir = fixture.folder("example-read-at")
    assert !write_file(path: dir + "/data", text: "abcdef").is_err()
    m @= open_mapping(dir + "/data", access: .read).must()
    assert read_at(m, offset: 2, count: 3).must() == ['c', 'd', 'e']
    assert !close_mapping(@m).is_err()
    assert fixture.cleared(dir)

# A byte changed in place, which the file then holds.
test "write_at: a byte changed in the file"
    dir = fixture.folder("example-write-at")
    assert !write_file(path: dir + "/data", text: "abcdef").is_err()
    m @= open_mapping(dir + "/data", access: .read_write).must()
    assert !write_at(m, offset: 0, data: ['A']).is_err()
    assert !close_mapping(@m).is_err()
    assert read_file(dir + "/data").must() == "Abcdef"
    assert fixture.cleared(dir)

# A write put on the storage before the program goes on.
test "sync_mapping: a write made durable"
    dir = fixture.folder("example-sync-mapping")
    assert !write_file(path: dir + "/data", text: "abcdef").is_err()
    m @= open_mapping(dir + "/data", access: .read_write).must()
    assert !write_at(m, offset: 5, data: ['!']).is_err()
    assert !sync_mapping(m).is_err()
    assert read_file(dir + "/data").must() == "abcde!"
    assert !close_mapping(@m).is_err()
    assert fixture.cleared(dir)

# A map closed, and closed again.
test "close_mapping: once, and a second time refused"
    dir = fixture.folder("example-close-mapping")
    assert !write_file(path: dir + "/data", text: "x").is_err()
    m @= open_mapping(dir + "/data", access: .copy).must()
    assert !close_mapping(@m).is_err()

    match close_mapping(@m)
        .ok _  => assert false
        .err e => assert e.code == CLOSED

    assert fixture.cleared(dir)

# A file renamed into place, and its folder made to keep the new name.
test "sync_dir: a rename made to outlive a crash"
    dir = fixture.folder("example-sync-dir")
    assert !write_file(path: dir + "/new", text: "x").is_err()
    assert !rename(from: dir + "/new", to: dir + "/current").is_err()

    match sync_dir(dir)
        .ok _  => assert read_file(dir + "/current").must() == "x"
        .err e => assert e.code == UNSUPPORTED

    assert fixture.cleared(dir)

# A second stream on a file asks without waiting, and is told no.
test "try_lock: refused while another stream holds the file"
    dir = fixture.folder("example-try-lock")
    assert !write_file(path: dir + "/db", text: "x").is_err()
    first @= open(dir + "/db").must()
    second @= open(dir + "/db").must()
    assert try_lock(first, exclusive: true).must()
    assert !try_lock(second, exclusive: true).must()
    assert !io.close(@first).is_err()
    assert !io.close(@second).is_err()
    assert fixture.cleared(dir)

# A lock let go, which another stream then takes.
test "unlock: the file free for another stream"
    dir = fixture.folder("example-unlock")
    assert !write_file(path: dir + "/db", text: "x").is_err()
    first @= open(dir + "/db").must()
    second @= open(dir + "/db").must()
    assert try_lock(first, exclusive: true).must()
    assert !unlock(first).is_err()
    assert try_lock(second, exclusive: true).must()
    assert !io.close(@first).is_err()
    assert !io.close(@second).is_err()
    assert fixture.cleared(dir)
