# The content of the twelve character string types, read into a `str` and
# written from one, each checked against its alphabet (X.680 § 41): UTF-8;
# the digits and the space; PrintableString's letters, digits and eleven
# marks; ASCII; printable ASCII; UCS-4; UCS-2 with surrogate pairs read and
# never written; and the types of ISO 2022's registers (TeletexString,
# VideotexString, GraphicString, GeneralString, ObjectDescriptor), each byte
# read as the character of ISO 8859-1 it numbers, as Python's `cryptography`
# reads a TeletexString, so their bytes come back unchanged. A type is named
# by its universal number.

use bytes
use unicode

# The code of content of no string or a character a type lacks, on writing.
constant INVALID: str
    "invalid"

# The code of content whose characters are not its type's, on reading.
constant NOT_TEXT: str
    "not_text"

# Whether the universal type `number` is one of the twelve string types.
function is_text_type(number: i64) -> bool
    return number == 7 || number == 12 || number >= 18 && number <= 22 || number >= 25 && number <= 28 || number == 30

# Whether `number`'s type reads each byte as one character of ISO 8859-1.
function is_latin1_type(number: i64) -> bool
    return number == 7 || number == 20 || number == 21 || number == 25 || number == 27

# Whether the ASCII byte `c` is one PrintableString holds.
function is_printable_char(c: u8) -> bool
    return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == ' ' || c == '\'' || c == '(' || c == ')' || c == '+' || c == ',' || c == '-' || c == '.' || c == '/' || c == ':' || c == '=' || c == '?'

# Whether the byte `c` is one the ASCII type `number` holds: NumericString,
# PrintableString, IA5String or VisibleString.
function is_ascii_char(number: i64, c: u8) -> bool
    if number == 18
        return c >= '0' && c <= '9' || c == ' '

    if number == 19
        return is_printable_char(c)

    if number == 22
        return c < 0x80
    return c >= 0x20 && c <= 0x7e

# The characters of `content`, of the string type `number`. Fails `not_text`
# where a character is not the type's, and `invalid` where UCS-4 or UCS-2
# is cut inside a character.
function read_text(number: i64, content: [u8]) -> str?
    if number == 12
        match bytes.to_text(content)
            .ok s  => return ok(s)
            .err _ => return fail(code: NOT_TEXT, msg: "a UTF8String whose bytes are not UTF-8")

    if is_latin1_type(number)
        points: [i64] @= []

        for b in content
            points @ points.push(to_i64(b).must())

        return ok(unicode.from_code_points(points).must())

    if number == 28
        return read_universal(content)

    if number == 30
        return read_bmp(content)

    for i in range(from: 0, to: content.len())
        if !is_ascii_char(number: number, c: content[i])
            return fail(code: NOT_TEXT, msg: f"the byte {content[i]} at {i}, which a string of this type does not hold")

    return ok(bytes.to_text(content).must())

# The characters of UCS-4 `content`, four bytes each, big-endian.
function read_universal(content: [u8]) -> str?
    if content.len() % 4 != 0
        return fail(code: INVALID, msg: f"a UniversalString of {content.len()} bytes, not a multiple of 4")
    points: [i64] @= []
    i @= 0

    while i < content.len()
        n @= 0

        for k in range(from: 0, to: 4)
            n @ n * 256 + to_i64(content[i + k]).must()

        if !unicode.is_scalar_value(n)
            return fail(code: NOT_TEXT, msg: f"a UniversalString holding {n}, which is no character")
        points @ points.push(n)
        i @ i + 4

    return ok(unicode.from_code_points(points).must())

# The characters of UCS-2 `content`, two bytes each, big-endian; a pair of
# surrogates read as the character it makes.
function read_bmp(content: [u8]) -> str?
    if content.len() % 2 != 0
        return fail(code: INVALID, msg: f"a BMPString of {content.len()} bytes, not a multiple of 2")
    points: [i64] @= []
    i @= 0

    while i < content.len()
        unit = to_i64(content[i]).must() * 256 + to_i64(content[i + 1]).must()
        i @ i + 2

        if unit >= 0xd800 && unit <= 0xdbff
            if i + 2 > content.len()
                return fail(code: NOT_TEXT, msg: "a BMPString ending with half of a surrogate pair")
            low = to_i64(content[i]).must() * 256 + to_i64(content[i + 1]).must()

            if low < 0xdc00 || low > 0xdfff
                return fail(code: NOT_TEXT, msg: "a BMPString with half of a surrogate pair")
            i @ i + 2
            points @ points.push(0x10000 + (unit - 0xd800) * 0x400 + (low - 0xdc00))
        else if unit >= 0xdc00 && unit <= 0xdfff
            return fail(code: NOT_TEXT, msg: "a BMPString with half of a surrogate pair")
        else
            points @ points.push(unit)

    return ok(unicode.from_code_points(points).must())

# The content of `s` as the string type `number`. Fails `invalid` where `s`
# holds a character the type lacks, naming it.
function write_text(number: i64, s: str) -> [u8]?
    if number == 12
        return ok(bytes.from_text(s))
    out: [u8] @= []

    if is_latin1_type(number) || number == 28 || number == 30
        for c in s.chars()
            n = unicode.code_point(c)

            if is_latin1_type(number)
                if n > 0xff
                    return fail(code: INVALID, msg: f"\"{c}\", which a string of ISO 8859-1 does not hold")
                out @ out.push(to_u8(n).must())
            else if number == 28
                out @ out.push(to_u8(n >> 24).must())
                out @ out.push(to_u8(n >> 16 & 0xff).must())
                out @ out.push(to_u8(n >> 8 & 0xff).must())
                out @ out.push(to_u8(n & 0xff).must())
            else
                if n > 0xffff
                    return fail(code: INVALID, msg: f"\"{c}\", outside the Basic Multilingual Plane a BMPString holds")
                out @ out.push(to_u8(n >> 8).must())
                out @ out.push(to_u8(n & 0xff).must())

        return ok(out)

    for i in range(from: 0, to: s.len())
        if !is_ascii_char(number: number, c: s[i])
            return fail(
                code: INVALID,
                msg: f"\"{s}\" holds at byte {i} a character a string of this type does not hold"
            )

    return ok(bytes.from_text(s))

test "read_text: UTF-8, broken UTF-8, and characters of more than one byte"
    assert read_text(number: 12, content: bytes.from_text("café")).must() == "café"
    assert read_text(number: 12, content: [0xc3]).is_err()

test "read_text: each ASCII type's alphabet, and a character it lacks"
    assert read_text(number: 18, content: bytes.from_text("12 34")).must() == "12 34"
    assert read_text(number: 18, content: bytes.from_text("1a")).is_err()
    assert read_text(number: 19, content: bytes.from_text("Ground Control (1969)?")).must() == "Ground Control (1969)?"
    assert read_text(number: 19, content: bytes.from_text("a@b")).is_err()
    assert read_text(number: 19, content: bytes.from_text("a*b")).is_err()
    assert read_text(number: 22, content: bytes.from_text("a@b\n")).must() == "a@b\n"
    assert read_text(number: 22, content: [0x80]).is_err()
    assert read_text(number: 26, content: bytes.from_text("a b~")).must() == "a b~"
    assert read_text(number: 26, content: [0x09]).is_err()

test "read_text: ISO 8859-1's bytes, UCS-4 and UCS-2, as OpenSSL writes \"hi\""
    assert read_text(number: 20, content: [0x63, 0x61, 0x66, 0xe9]).must() == "café"
    assert read_text(number: 28, content: [0x00, 0x00, 0x00, 0x68, 0x00, 0x00, 0x00, 0x69]).must() == "hi"
    assert read_text(number: 28, content: [0x00, 0x00, 0xd8, 0x00]).is_err()
    assert read_text(number: 28, content: [0x00, 0x00, 0x68]).is_err()
    assert read_text(number: 30, content: [0x00, 0x68, 0x00, 0x69]).must() == "hi"
    assert read_text(number: 30, content: [0xd8, 0x3d, 0xde, 0x00]).must() == "😀"
    assert read_text(number: 30, content: [0xd8, 0x3d]).is_err()
    assert read_text(number: 30, content: [0xde, 0x00]).is_err()
    assert read_text(number: 30, content: [0x00]).is_err()

test "write_text: each kind, and characters a kind lacks"
    assert write_text(number: 12, s: "é").must() == [0xc3, 0xa9]
    assert write_text(number: 19, s: "US").must() == [0x55, 0x53]
    assert write_text(number: 19, s: "a@b").is_err()
    assert write_text(number: 20, s: "é").must() == [0xe9]
    assert write_text(number: 20, s: "€").is_err()
    assert write_text(number: 28, s: "hi").must() == [0x00, 0x00, 0x00, 0x68, 0x00, 0x00, 0x00, 0x69]
    assert write_text(number: 30, s: "hi").must() == [0x00, 0x68, 0x00, 0x69]
    assert write_text(number: 30, s: "😀").is_err()
    assert write_text(number: 18, s: "").must().len() == 0
