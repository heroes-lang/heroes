  heroes  time.Breaker, time.BreakerPolicy, time.BreakerState, time.breaker_policy, time.with_trials, time.with_failure_ratio, time.new_breaker, time.allow_call, time.record_success, time.record_failure, time.breaker_state
  go      -
  rust    -
