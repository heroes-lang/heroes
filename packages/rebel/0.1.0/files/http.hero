    421

# The status 422, "Unprocessable Content".
constant STATUS_UNPROCESSABLE_CONTENT: i64
    422

# The status 423, "Locked".
constant STATUS_LOCKED: i64
    423

# The status 424, "Failed Dependency".
constant STATUS_FAILED_DEPENDENCY: i64
    424

# The status 425, "Too Early".
