# The messages of a failure: where a byte of a text stands, as a line and a
# column, and what was found there, so that a message says what was expected
# and what stood in its place.

use numbers
use strings
use unicode

# The code of a text that is not XML, and of a tree that would not read back
# as itself.
constant INVALID: str
    "invalid"

# The code of a declaration naming another encoding than UTF-8.
constant UNSUPPORTED: str
    "unsupported"

# The code of a text past the depth its reading allows.
constant LIMIT: str
    "limit"

# Where byte `at` of `text` stands, as `line L, column C`, both counted from
# 1: a line ends at a line feed, a carriage return and line feed, or a carriage
# return alone, as XML 1.0 reads line ends, and the column counts characters.
function position(text: str, at: i64) -> str
    line: i64 @= 1
    line_start: i64 @= 0
    i: i64 @= 0

    while i < at && i < text.len()
        b = text[i]

        if b == '\n' || b == '\r' && !(i + 1 < text.len() && text[i + 1] == '\n')
            line @ line + 1
            line_start @ i + 1
        i @ i + 1

    column: i64 @= 1
    j: i64 @= line_start

    while j < at && j < text.len()
        if !unicode.is_continuation(text[j])
            column @ column + 1
        j @ j + 1

    return f"line {line}, column {column}"

# `n` as `U+` and at least four uppercase hexadecimal digits.
function code_name(n: i64) -> str
    return "U+" + strings.pad_zeros(strings.to_upper(numbers.format_int(n: n, base: 16)), 4)

# What stands at byte `at` of `text`, in words: the end of the text, a space,
# a tab, a line break, a character that shows quoted, or one that does not as
# its code point. Aborts where `at` is inside a character.
function found(text: str, at: i64) -> str
    if at >= text.len()
        return "the end of the text"
    b = text[at]

    if b == ' '
        return "a space"

    if b == '\t'
        return "a tab"

    if b == '\n' || b == '\r'
        return "a line break"

    if b < 0x20 || b == 0x7f
        return code_name(to_i64(b).must())

    if b < 0x80
        return f"\"{text.slice(from: at, to: at + 1)}\""
    c = text.slice(from: at, to: at + unicode.len_at(text, at))

    if !unicode.is_graphic(c)
        return code_name(unicode.code_point_at(text, at))
    return f"\"{c}\""

# `names` written for a message: each between backticks, separated by commas,
# or `none` where there is none.
function listed(names: [str]) -> str
    if names.len() == 0
        return "none"
    quoted: [str] @= []

    for name in names
        quoted @ quoted.push(f"`{name}`")

    return quoted.join(", ")

# The message of a failure at byte `at` of `text`: where, what was expected and
# what was found.
function expected(text: str, at: i64, what: str) -> str
    return f"{position(text, at)}: expected {what}, found {found(text, at)}"

# The message of a failure at byte `at` of `text` that `what` says in full.
function said(text: str, at: i64, what: str) -> str
    return f"{position(text, at)}: {what}"

## Tests

test "position: the start, a second line, each line end, and columns in characters"
    assert position(text: "", at: 0) == "line 1, column 1"
    assert position(text: "ab", at: 1) == "line 1, column 2"
    assert position(text: "a\nb", at: 2) == "line 2, column 1"
    assert position(text: "a\r\nb", at: 3) == "line 2, column 1"
    assert position(text: "a\r\nb", at: 2) == "line 1, column 3"
    assert position(text: "a\rb", at: 2) == "line 2, column 1"
    assert position(text: "è\né😀x", at: 9) == "line 2, column 3"

test "code_name: at least four digits, and more where the number needs them"
    assert code_name(0) == "U+0000"
    assert code_name(0xfeff) == "U+FEFF"
    assert code_name(0x1f600) == "U+1F600"

test "found: the end, white space, a control byte, ASCII, a character of more than one byte and an invisible one"
    assert found(text: "", at: 0) == "the end of the text"
    assert found(text: " ", at: 0) == "a space"
    assert found(text: "\t", at: 0) == "a tab"
    assert found(text: "\r\n", at: 0) == "a line break"
    assert found(text: "<", at: 0) == "\"<\""
    assert found(text: "aé", at: 1) == "\"é\""
    bom: [u8] = [0xef, 0xbb, 0xbf]
    assert found(text: bom.validated_bytes().must(), at: 0) == "U+FEFF"

test "listed: none, one, and several"
    assert listed([]) == "none"
    assert listed(["a"]) == "`a`"
    assert listed(["a", "p:b"]) == "`a`, `p:b`"

test "expected and said: the position before the words"
    assert expected(text: "<a>x", at: 3, what: "`<`") == "line 1, column 4: expected `<`, found \"x\""
    assert said(text: "a\nb", at: 2, what: "no") == "line 2, column 1: no"
