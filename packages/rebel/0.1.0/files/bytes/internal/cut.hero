# The pieces bytes are cut into: between the separators found from the start
# or from the end, between the bytes of a set or the bytes a function
# accepts, into words and into lines. Every piece is a new list, and the
# pieces stand in the order of the bytes.

use bytes/internal/ascii
use bytes/internal/finder
use bytes/internal/raw
use bytes/internal/search

# The pieces of `s` between its `sep`s, cut from the start: at most `n` of
# them where `bounded`, the last holding the rest of `s`; each ending with its
# `sep` where `keep`, which then leaves out an empty last piece. An empty
# `sep` cuts after each byte.
function from_start(s: [u8], sep: [u8], n: u64, bounded: bool, keep: bool) -> [[u8]]
    out: [[u8]] @= []

    if bounded && n == 0
        return out

    if sep.len() == 0
        return each_byte(s: s, n: n, bounded: bounded)
    f = finder.finder(sep)
    start: i64 @= 0
    made: u64 @= 1

    while !bounded || made < n
        match finder.first_from(f, s: s, from: start)
            .err _ => break
            .ok found =>
                end: i64 @= found

                if keep
                    end @ found + sep.len()
                out @ out.push(s.slice(from: start, to: end))
                start @ found + sep.len()
                made @ made + 1

    if !keep || start < s.len()
        out @ out.push(s.slice(from: start, to: s.len()))
    return out

# Each byte of `s` as a piece, from the start; where `bounded`, the `n`th
# piece holds the rest of `s`. The empty `s` has no pieces.
function each_byte(s: [u8], n: u64, bounded: bool) -> [[u8]]
    out: [[u8]] @= []
    at: i64 @= 0
    made: u64 @= 1

    while at < s.len()
        if bounded && made >= n
            out @ out.push(s.slice(from: at, to: s.len()))
            return out
        out @ out.push(s.slice(from: at, to: at + 1))
        at @ at + 1
        made @ made + 1

    return out

# At most `n` pieces of `s` between its `sep`s, cut from the end, the first
# holding the rest of `s`, in the order of the bytes. An empty `sep` cuts
# before each byte.
function from_end(s: [u8], sep: [u8], n: u64) -> [[u8]]
    out: [[u8]] @= []

    if n == 0
        return out

    if sep.len() == 0
        return each_byte_from_end(s, n)
    f = finder.finder(sep)
    cuts: [i64] @= []
    end: i64 @= s.len()
    made: u64 @= 1

    while made < n
        match finder.last_before(f, s: s, end: end)
            .err _ => break
            .ok found =>
                cuts @ cuts.push(found)
                end @ found
                made @ made + 1

    start: i64 @= 0
    k: i64 @= cuts.len() - 1

    while k >= 0
        out @ out.push(s.slice(from: start, to: cuts[k]))
        start @ cuts[k] + sep.len()
        k @ k - 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out

# Each of the last bytes of `s` as a piece, at most `n` pieces in all, the
# first holding the rest of `s`. The empty `s` has no pieces.
function each_byte_from_end(s: [u8], n: u64) -> [[u8]]
    out: [[u8]] @= []

    if s.len() == 0
        return out
    singles: i64 @= s.len() - 1

    # `singles` is not below 0 here, and `n - 1` below it fits an `i64`.
    if n - 1 < to_u64(singles).must()
        singles @ to_i64(n - 1).must()
    first = s.len() - singles
    out @ out.push(s.slice(from: 0, to: first))
    at: i64 @= first

    while at < s.len()
        out @ out.push(s.slice(from: at, to: at + 1))
        at @ at + 1

    return out

# The pieces of `s` that `sep` ends: `from_start`'s, without the empty piece
# after a final `sep`.
function split_terminated(s: [u8], sep: [u8]) -> [[u8]]
    pieces = from_start(s: s, sep: sep, n: 0, bounded: false, keep: false)

    if pieces.len() > 0 && pieces[pieces.len() - 1].len() == 0
        return pieces.slice(from: 0, to: pieces.len() - 1)
    return pieces

# The pieces of `s` between its bytes that `set` holds, in time linear in
# `s` whatever the set's length.
function split_any(s: [u8], set: [u8]) -> [[u8]]
    members = search.byte_set(set)
    out: [[u8]] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if search.in_set(members, s[at])
            out @ out.push(s.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out

# The pieces of `s` between its bytes that `separates` accepts.
function split_where(s: [u8], separates: (function(u8) -> bool)) -> [[u8]]
    out: [[u8]] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if separates(s[at])
            out @ out.push(s.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out

# The pieces of `s` between its runs of bytes that `separates` accepts, none
# of them empty.
function words_where(s: [u8], separates: (function(u8) -> bool)) -> [[u8]]
    out: [[u8]] @= []
    start: i64 @= 0
    inside: bool @= false
    at: i64 @= 0

    while at < s.len()
        if separates(s[at])
            if inside
                out @ out.push(s.slice(from: start, to: at))
                inside @ false
        else if !inside
            start @ at
            inside @ true
        at @ at + 1

    if inside
        out @ out.push(s.slice(from: start, to: s.len()))
    return out

# The lines of `s`, each without its end, a line feed or a carriage return
# and a line feed; the last line's end is optional.
function lines(s: [u8]) -> [[u8]]
    out: [[u8]] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] == '\n'
            end: i64 @= at

            if end > start && s[end - 1] == '\r'
                end @ end - 1
            out @ out.push(s.slice(from: start, to: end))
            start @ at + 1
        at @ at + 1

    if start < s.len()
        out @ out.push(s.slice(from: start, to: s.len()))
    return out

## Tests

# Python's `bytes.split` answered the first three on 2026-11-15; it refuses
# an empty separator, where Go's `bytes.Split` cuts after each character.
test "from_start as split: separators at either end and in a row, the empty list, the empty separator"
    t = raw.of_text
    nothing: [[u8]] = []
    every: u64 = 0
    assert from_start(s: t("a,b,,c,"), sep: t(","), n: every, bounded: false, keep: false) == [t("a"), t("b"), t(""), t("c"), t("")]
    assert from_start(s: t(""), sep: t(","), n: every, bounded: false, keep: false) == [t("")]
    assert from_start(s: t(","), sep: t(","), n: every, bounded: false, keep: false) == [t(""), t("")]
    assert from_start(s: t("a::b"), sep: t("::"), n: every, bounded: false, keep: false) == [t("a"), t("b")]
    assert from_start(s: t("abc"), sep: t(""), n: every, bounded: false, keep: false) == [t("a"), t("b"), t("c")]
    assert from_start(s: t(""), sep: t(""), n: every, bounded: false, keep: false) == nothing

# Python's `split(b",", 1)` and Go's `SplitN` answered the first and the
# empty separator's.
test "from_start as split_n: two pieces, none, one, and the empty separator"
    t = raw.of_text
    nothing: [[u8]] = []
    assert from_start(s: t("a,b,c"), sep: t(","), n: 2, bounded: true, keep: false) == [t("a"), t("b,c")]
    assert from_start(s: t("a,b,c"), sep: t(","), n: 0, bounded: true, keep: false) == nothing
    assert from_start(s: t("a,b,c"), sep: t(","), n: 1, bounded: true, keep: false) == [t("a,b,c")]
    assert from_start(s: t("a,b,c"), sep: t(","), n: 9, bounded: true, keep: false) == [t("a"), t("b"), t("c")]
    assert from_start(s: t("abc"), sep: t(""), n: 2, bounded: true, keep: false) == [t("a"), t("bc")]
    assert from_start(s: t(""), sep: t(""), n: 2, bounded: true, keep: false) == nothing

# Go's `SplitAfter` answers ["a," "b," ""] for "a,b,"; `strings` drops the
# empty last piece, and this follows `strings`.
test "from_start as split_after: a final separator, none, the empty list, and two pieces"
    t = raw.of_text
    nothing: [[u8]] = []
    every: u64 = 0
    assert from_start(s: t("a,b,"), sep: t(","), n: every, bounded: false, keep: true) == [t("a,"), t("b,")]
    assert from_start(s: t("a,b"), sep: t(","), n: every, bounded: false, keep: true) == [t("a,"), t("b")]
    assert from_start(s: t(""), sep: t(","), n: every, bounded: false, keep: true) == nothing
    assert from_start(s: t("a,b,c"), sep: t(","), n: 2, bounded: true, keep: true) == [t("a,"), t("b,c")]
    assert from_start(s: t("ab"), sep: t(""), n: every, bounded: false, keep: true) == [t("a"), t("b")]

# Python's `rsplit(b",", 1)` answered the first two.
test "from_end: two pieces, the empty list, the empty separator, none, and more than there are"
    t = raw.of_text
    nothing: [[u8]] = []
    assert from_end(s: t("a,b,c"), sep: t(","), n: 2) == [t("a,b"), t("c")]
    assert from_end(s: t(""), sep: t(","), n: 2) == [t("")]
    assert from_end(s: t("a,b,c"), sep: t(","), n: 9) == [t("a"), t("b"), t("c")]
    assert from_end(s: t(",a"), sep: t(","), n: 2) == [t(""), t("a")]
    assert from_end(s: t("a,b,c"), sep: t(","), n: 0) == nothing
    assert from_end(s: t("abc"), sep: t(""), n: 2) == [t("ab"), t("c")]
    assert from_end(s: t("abc"), sep: t(""), n: 5) == [t("a"), t("b"), t("c")]
    assert from_end(s: t(""), sep: t(""), n: 3) == nothing

test "split_terminated: a final separator, none, a separator alone, and the empty list"
    t = raw.of_text
    nothing: [[u8]] = []
    assert split_terminated(s: t("a;b;"), sep: t(";")) == [t("a"), t("b")]
    assert split_terminated(s: t("a;b"), sep: t(";")) == [t("a"), t("b")]
    assert split_terminated(s: t(";"), sep: t(";")) == [t("")]
    assert split_terminated(s: t(""), sep: t(";")) == nothing

test "split_any and split_where: a set of two, the empty set, separators side by side"
    t = raw.of_text
    assert split_any(s: t("a,b;c"), set: t(",;")) == [t("a"), t("b"), t("c")]
    assert split_any(s: t("ab"), set: t("")) == [t("ab")]
    assert split_any(s: t(""), set: t(",")) == [t("")]
    assert split_any(s: t(",,"), set: t(",")) == [t(""), t(""), t("")]
    assert split_any(s: t("a,b;c d"), set: t(",;:.!?-_+=*&^%$#@")) == [t("a"), t("b"), t("c d")]
    assert split_where(t("a b\tc"), ascii.is_space) == [t("a"), t("b"), t("c")]
    assert split_where(t("  "), ascii.is_space) == [t(""), t(""), t("")]

# Python's `bytes.split()` with no separator answered these on 2026-11-15.
test "words_where: runs at both ends and inside, the vertical tab, white space alone, nothing"
    t = raw.of_text
    nothing: [[u8]] = []
    mixed: [u8] = [0x20, 0x20, 0x61, 0x20, 0x09, 0x20, 0x62, 0x0b, 0x0c, 0x20, 0x63, 0x0d, 0x0a]
    assert words_where(mixed, ascii.is_space) == [t("a"), t("b"), t("c")]
    assert words_where(t(" \t\n"), ascii.is_space) == nothing
    assert words_where(t(""), ascii.is_space) == nothing
    assert words_where(t("abc"), ascii.is_space) == [t("abc")]

# Python's `splitlines` ends a line at a lone carriage return too, and Go's
# `Lines` keeps each end; `strings` ends a line at a line feed alone, and
# this follows `strings`.
test "lines: an empty line, CR LF, a lone CR, a last line with and without its end"
    t = raw.of_text
    nothing: [[u8]] = []
    assert lines(t("")) == nothing
    assert lines(t("\n")) == [t("")]
    assert lines(t("a\n\nb")) == [t("a"), t(""), t("b")]
    assert lines(t("a\r\nb\r\n")) == [t("a"), t("b")]
    assert lines(t("a\rb")) == [t("a\rb")]
    assert lines(t("a\nb")) == [t("a"), t("b")]
    assert lines(t("\r\n")) == [t("")]

test "each_byte and each_byte_from_end: every byte, the rest held whole, the largest count, nothing"
    t = raw.of_text
    nothing: [[u8]] = []
    last: [[u8]] = [[0xff]]
    assert each_byte(s: t("abc"), n: 0, bounded: false) == [t("a"), t("b"), t("c")]
    assert each_byte(s: t("abc"), n: 2, bounded: true) == [t("a"), t("bc")]
    assert each_byte(s: t("abc"), n: 1, bounded: true) == [t("abc")]
    assert each_byte(s: t(""), n: 0, bounded: false) == nothing
    assert each_byte_from_end(t("abc"), 1) == [t("abc")]
    assert each_byte_from_end(t("abc"), 18446744073709551615) == [t("a"), t("b"), t("c")]
    assert each_byte_from_end(t(""), 2) == nothing
    assert each_byte_from_end([0xff], 2) == last
