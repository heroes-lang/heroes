# The elements and the orders the tests of `slices` sort by, and the questions
# they ask of a result. They stand here and not in the face, since every
# function and record a face declares is a line of its card
# (`examples/packages/README.md` § 1.2).

# An element as the tests sort one: the key it is sorted by, and a name saying
# where it stood, which tells the order of a tie.
record Entry
    key: i64
    name: str

# Whether `a`'s key is less than `b`'s.
function by_key(a: Entry, b: Entry) -> bool
    return a.key < b.key

# Whether `a`'s key is greater than `b`'s.
function key_down(a: Entry, b: Entry) -> bool
    return a.key > b.key

# Whether `a` is less than `b`.
function up(a: i64, b: i64) -> bool
    return a < b

# False for any two: an order that puts nothing before anything.
function never(a: i64, b: i64) -> bool
    return a < b && b < a

# True for any two: an order that puts everything before everything.
function always(a: i64, b: i64) -> bool
    return a <= b || b < a

# An entry for each of `numbers`, its key, named for the place it stood: `at
# 0`, `at 1`.
function entries(numbers: [i64]) -> [Entry]
    out: [Entry] @= []

    for at in range(from: 0, to: numbers.len())
        one = Entry(key: numbers[at], name: "at " + at.to_str())
        out @ out.push(one)

    return out

# The place an entry of `entries` stood, read back from its name.
function place_of(e: Entry) -> i64
    total: i64 @= 0

    for at in range(from: 3, to: e.name.len())
        total @ total * 10 + to_i64(e.name[at] - '0').must()

    return total

# Whether `got` holds the entries of `given`, each once, by key, a tie in the
# order the two stood in `given`.
function sorted_stably(got: [Entry], given: [Entry]) -> bool
    if got.len() != given.len()
        return false

    for at in range(from: 1, to: got.len())
        earlier = got[at - 1]
        later = got[at]

        if earlier.key > later.key
            return false

        if earlier.key == later.key && place_of(earlier) > place_of(later)
            return false

    return names_of(got).sort() == names_of(given).sort()

# The names of `xs`, in their order.
function names_of(xs: [Entry]) -> [str]
    out: [str] @= []

    for one in xs
        out @ out.push(one.name)

    return out

# Every list of `length` keys from 0 up to `values`, each once: `values` to the
# power `length` of them.
function every_list(values: i64, length: i64) -> [[i64]]
    out: [[i64]] @= [[]]

    for _ in range(from: 0, to: length)
        longer: [[i64]] @= []

        for list in out
            for value in range(from: 0, to: values)
                grown = list.push(value)
                longer @ longer.push(grown)

        out @ longer

    return out

# `count` keys from a fixed recurrence, glibc's, from 0 up to `values`: the
# same on every machine, and many of them repeated where `values` is small.
function fixed_keys(count: i64, values: i64) -> [i64]
    out: [i64] @= []
    x: i64 @= 20261114

    for _ in range(from: 0, to: count)
        x @ (x * 1103515245 + 12345) % 2147483648
        key = x % values
        out @ out.push(key)

    return out

## Tests

test "the orders: by key either way, ascending, never and always"
    low = Entry(key: 1, name: "at 0")
    high = Entry(key: 2, name: "at 1")
    assert by_key(a: low, b: high) && !by_key(a: high, b: low) && !by_key(a: low, b: low)
    assert key_down(a: high, b: low) && !key_down(a: low, b: high)
    assert up(a: 1, b: 2) && !up(a: 2, b: 2)
    assert !never(a: 1, b: 2) && !never(a: 2, b: 1) && !never(a: 2, b: 2)
    assert always(a: 1, b: 2) && always(a: 2, b: 1) && always(a: 2, b: 2)

test "entries are named for their place, and the place reads back"
    none: [i64] = []
    assert entries(none).len() == 0
    assert entries([4, 4]) == [Entry(key: 4, name: "at 0"), Entry(key: 4, name: "at 1")]
    assert place_of(Entry(key: 0, name: "at 207")) == 207
    assert names_of(entries([9, 8])) == ["at 0", "at 1"]

test "sorted_stably: in order, out of order, a tie turned, and an entry lost"
    assert sorted_stably(got: entries([1, 2]), given: entries([1, 2]))
    assert !sorted_stably(got: [Entry(key: 2, name: "at 0"), Entry(key: 1, name: "at 1")], given: entries([2, 1]))
    assert !sorted_stably(got: [Entry(key: 5, name: "at 1"), Entry(key: 5, name: "at 0")], given: entries([5, 5]))
    assert !sorted_stably(got: entries([1]), given: entries([1, 2]))
    assert !sorted_stably(got: [Entry(key: 1, name: "at 0"), Entry(key: 1, name: "at 0")], given: entries([1, 1]))

test "every_list and fixed_keys: how many, and the same twice"
    assert every_list(values: 3, length: 0) == [[]]
    assert every_list(values: 2, length: 2) == [[0, 0], [0, 1], [1, 0], [1, 1]]
    assert every_list(values: 3, length: 4).len() == 81
    assert fixed_keys(count: 50, values: 7) == fixed_keys(count: 50, values: 7)
    assert fixed_keys(count: 50, values: 7).all(below_seven)

# Whether `n` is below seven, the bound the test above gives `fixed_keys`.
function below_seven(n: i64) -> bool
    return n >= 0 && n < 7

test "below_seven: the bound itself and below"
    assert below_seven(6) && !below_seven(7) && !below_seven(-1)
