# THE NUMBERS AN ISSUE IS KNOWN BY: a defect's, and a sitting's ratification's.
#
# `.claude/rules/records.md` § The issues, its title bullet and its labels bullet
# (panel 212's D1, ratified 2026-10-11, amended by the coordinator the same
# day). A defect's number is the one its file's name carries, else the `NNN — `
# its first field opens with, and its title and the organisation's `Defect`
# field read the same one: the title opens `Defect 235: `, or `Defects 018 to
# 021: ` for a file of several, and a defect with neither takes no prefix and no
# field value. A sitting's ratification, whose first field is `**panel NNN**`,
# opens `Panel 212: `. Each prefix stands only where the title does not open so
# already, in any case.

use <core>/strings as core_strings

use credit
use strings

# The numbers a defect's file name carries and how a title says them:
# `defect-235-` is `Defect 235`, `defects-018-to-021-` is `Defects 018 to 021`,
# and a list is `Defects 058 and 059` or `Defects 080, 081, 082 and 089`.
record Numbered
    numbers: [str]
    said: str

function numbers_in_name(name: str) -> Numbered
    nothing: [str] = []
    none = Numbered(numbers: nothing, said: "")

    if name.len() < 20
        return none

    # Sixteen ASCII bytes, `YYYY-MM-DD-HHMM-`, open an entry's name.
    words = strings.split_on(text: name.slice(from: 16, to: name.len()), byte: '-')

    if words.len() < 2 || !all_digits(words[1])
        return none

    if words[0] == "defect"
        return Numbered(numbers: [words[1]], said: "Defect " + words[1])

    if words[0] != "defects"
        return none
    listed: [str] @= [words[1]]
    at: i64 @= 2

    if words.len() > 3 && words[2] == "to" && all_digits(words[3])
        span = spanned(from: words[1], to: words[3])

        if span.len() == 0
            return none
        return Numbered(numbers: span, said: "Defects " + words[1] + " to " + words[3])

    while at < words.len() && (all_digits(words[at]) || words[at] == "and" && at + 1 < words.len() && all_digits(words[at + 1]))
        if words[at] != "and"
            listed @ listed.push(words[at])
        at @ at + 1

    if listed.len() == 1
        return Numbered(numbers: listed, said: "Defect " + listed[0])
    said = listed.slice(from: 0, to: listed.len() - 1).join(", ") + " and " + listed[listed.len() - 1]
    return Numbered(numbers: listed, said: "Defects " + said)

function all_digits(word: str) -> bool
    if word.len() == 0
        return false

    for b in word.chars()
        if b[0] < '0' || b[0] > '9'
            return false

    return true

# Every number from one to the other, three digits each; none where the last
# is below the first; and the two numbers the name writes, as written, where
# the span is wider than `credit.SPAN_LIMIT` or an end lies past an `i64`,
# which no count reaches.
#
# **Read by `.must()` until defect 2565** (2026-11-15): since defect 2545 the
# harness's `to_number` refuses an end past an `i64` by name, `does_not_fit`,
# and the `.must()` here turned that refusal into an abort of the issue
# program at exit 134. And the walk stops at its last number rather than
# stepping past it, since one past the largest `i64` aborts too.
#
# **And listed whole until defect 2579** (the same day): a name's
# `defects-001-to-999999999999-` asked `draft` for a trillion numbers, as a
# title's span asked `credit.numbers_after`. A span past the limit is the two
# numbers its name writes, which `draft` tells as it tells one, and so is a
# span with an end past an `i64`, which defect 2565's repair read as naming
# none, so that such a name went untold.
function spanned(from: str, to: str) -> [str]
    first = strings.to_number(from)
    last = strings.to_number(to)

    # Both ends are digits alone, so neither is negative and the width
    # cannot leave an `i64`.
    if first.is_err() || last.is_err() || last.must() - first.must() >= credit.SPAN_LIMIT
        return [padded(from), padded(to)]
    out: [str] @= []

    if last.must() < first.must()
        return out
    n: i64 @= first.must()

    while n < last.must()
        out @ out.push(padded(n.to_str()))
        n @ n + 1

    return out.push(padded(last.must().to_str()))

# `digits`, a run of ASCII digits, as a defect's number is written: the
# leading zeros off, then put back to three digits, so `14`, `014` and `0014`
# are each `014` and `2031` stays itself. It reads the digits as text and
# never as an `i64`, so a run of any length is written as it reads: until
# defect 2565 a first field's `NNN — ` was read through `to_number(...).must()`
# and a run past an `i64` aborted the issue program.
function padded(digits: str) -> str
    at: i64 @= 0

    while at + 1 < digits.len() && digits[at] == '0'
        at @ at + 1

    # Digits are ASCII, so the cut stands between characters.
    bare = digits.slice(from: at, to: digits.len())

    if bare.len() < 3
        return "0".repeat((3 - bare.len()).to_u64().must()) + bare
    return bare

# A defect's number: the name's, else the `NNN — ` that opens `first`, its
# first field, `**` off; none where neither holds one. The run of digits is
# one of any length, as `issue_title.numberless` takes it off a title, so
# a draft whose first field opens with one is told it names a number however
# long (defect 2565).
function defect_numbers(name: str, first: str) -> Numbered
    named = numbers_in_name(name)

    if named.numbers.len() > 0
        return named
    field = strings.trimmed(strings.split_text(text: first, separator: "**").join(""))
    digits: i64 @= 0

    while digits < field.len() && field[digits] >= '0' && field[digits] <= '9'
        digits @ digits + 1

    if digits == 0 || !core_strings.has_prefix(s: field.slice(from: digits, to: field.len()), prefix: " — ")
        return Numbered(numbers: [], said: "")

    # Digits are ASCII, so the cut stands between characters.
    number = padded(field.slice(from: 0, to: digits))
    return Numbered(numbers: [number], said: "Defect " + number)

# The digits of a first field that is `**panel NNN**` and nothing else, as
# written, or "".
function panel_of(field: str) -> str
    if !core_strings.has_prefix(s: field, prefix: "**panel ") || !core_strings.has_suffix(s: field, suffix: "**")
        return ""

    # Both ends are ASCII, so the cut stands between characters.
    digits = field.slice(from: 8, to: field.len() - 2)

    if !all_digits(digits)
        return ""
    return digits

# Whether `title` opens with one of `words` and then `number` already, in any
# case, so that no prefix doubles it: `defect 093`, `Defects 080`, `PANEL 212`.
function opens_so(title: str, words: [str], number: str) -> bool
    for word in words
        if folded_starts(text: title, prefix: word + " " + number)
            return true

    return false

function folded_starts(text: str, prefix: str) -> bool
    if prefix.len() > text.len()
        return false
    at: i64 @= 0

    while at < prefix.len()
        b: u8 @= text[at]

        if b >= 'A' && b <= 'Z'
            b @ b + 32

        if b != prefix[at]
            return false
        at @ at + 1

    return true

test "a defect's numbers come from its name, and a title opens with them once"
    assert numbers_in_name("2026-10-04-0409-defect-235-a-header-name.md").said == "Defect 235"
    assert numbers_in_name("2026-09-08-0713-defects-018-to-021-four.md").numbers == ["018", "019", "020", "021"]
    assert numbers_in_name("2026-09-08-0713-defects-018-to-021-four.md").said == "Defects 018 to 021"
    assert numbers_in_name("2026-09-18-0130-defects-058-and-059-close.md").said == "Defects 058 and 059"
    assert numbers_in_name("2026-09-24-1633-defects-080-081-082-089-closed.md").said == "Defects 080, 081, 082 and 089"
    assert numbers_in_name("2026-09-05-0628-2026-09-05-found-by-the-three.md").numbers.len() == 0
    assert numbers_in_name("2026-08-25-0418-defect-fixed-2026-08-16-m.md").numbers.len() == 0
    assert defect_numbers(name: "2026-09-05-0628-2026-09-05-found.md", first: "**014 — every FFI diagnostic**").said == "Defect 014"
    assert defect_numbers(name: "2026-10-04-0409-defect-235-a.md", first: "**014 — another**").numbers == ["235"]
    assert defect_numbers(name: "2026-08-13-0043-defect-half-fixed.md", first: "Covered").numbers.len() == 0
    assert defect_numbers(name: "2026-08-13-0043-defect-half-fixed.md", first: "**Defect 011 — two**").numbers.len() == 0
    assert opens_so(title: "Defect 065 closes", words: ["defect", "defects"], number: "065")
    assert opens_so(title: "defect 093 the lane", words: ["defect", "defects"], number: "093")
    assert opens_so(title: "Defects 080, 081 closed", words: ["defect", "defects"], number: "080")
    assert !opens_so(title: "a header name", words: ["defect", "defects"], number: "235")

test "a ratification's first field gives its sitting's number as written, and nothing else does"
    assert panel_of("**panel 212**") == "212"
    assert panel_of("**panel 062**") == "062"
    assert panel_of("panel 062") == ""
    assert panel_of("**panel 108 — ratify the resolution**") == ""
    assert panel_of("**M-issue-files**") == ""
    assert opens_so(title: "PANEL 212 sits", words: ["panel"], number: "212")
    assert !opens_so(title: "ratify R1 to R11", words: ["panel"], number: "212")

# DEFECT 2565, held as a test (2026-11-15): a first field opening with a run of
# digits past an `i64`, and a name's span with such an end, stopped the issue
# program at exit 134, `.must()` on the `does_not_fit` that `to_number`
# answers since defect 2545; and a span ending at the largest `i64` stepped
# one past it. A first field's run is read as written, as `issue_title`
# takes it off the title, so `draft` tells the writer the number it names. A
# span it cannot list named none until defect 2579, the same day, and is the
# two numbers its name writes since (the test below).
test "fixedbugs: a defect's number past an i64 is read as written, never an abort (defect 2565)"
    long = defect_numbers(name: "x.md", first: "**99999999999999999999 — a defect**")
    assert long.numbers == ["99999999999999999999"]
    assert long.said == "Defect 99999999999999999999"
    assert defect_numbers(name: "x.md", first: "**0014 — a defect**").said == "Defect 014"
    assert defect_numbers(name: "x.md", first: "**5 — a defect**").said == "Defect 005"
    assert defect_numbers(name: "x.md", first: "**000 — a defect**").said == "Defect 000"
    assert defect_numbers(name: "x.md", first: "**2031 — a defect**").said == "Defect 2031"
    reversed = "2026-11-15-1200-defects-021-to-018-x.md"
    assert numbers_in_name(reversed).numbers.len() == 0
    assert defect_numbers(name: reversed, first: "a defect").said == ""
    edge = numbers_in_name("2026-11-15-1200-defects-9223372036854775806-to-9223372036854775807-x.md")
    assert edge.numbers == ["9223372036854775806", "9223372036854775807"]
    assert numbers_in_name("2026-11-15-1200-defects-007-to-007-x.md").numbers == ["007"]

# DEFECT 2579, held as a test (2026-11-15): a name's span was listed whole, so
# `defects-001-to-999999999999-` asked `draft` for a trillion numbers. A span
# of more than `credit.SPAN_LIMIT` numbers is the two its name writes, and so
# is one with an end past an `i64`, each told by `draft` as one number is;
# the widest span the tree writes, `001-to-677`, is listed as before.
test "fixedbugs: a name's span past a thousand numbers, or past an i64, is the two numbers it writes (defect 2579)"
    wide = numbers_in_name("2026-11-15-1200-defects-001-to-999999999999-x.md")
    assert wide.numbers == ["001", "999999999999"]
    assert wide.said == "Defects 001 to 999999999999"
    assert numbers_in_name("2026-11-15-1200-defects-001-to-677-x.md").numbers.len() == 677
    assert numbers_in_name("2026-11-15-1200-defects-1-to-1000-x.md").numbers.len() == 1000
    assert numbers_in_name("2026-11-15-1200-defects-1-to-1001-x.md").numbers == ["001", "1001"]
    assert numbers_in_name("2026-11-15-1200-defects-0-to-9223372036854775807-x.md").numbers == ["000", "9223372036854775807"]
    assert numbers_in_name("2026-11-15-1200-defects-001-to-99999999999999999999-x.md").numbers == ["001", "99999999999999999999"]
    assert numbers_in_name("2026-11-15-1200-defects-99999999999999999999-to-001-x.md").numbers == ["99999999999999999999", "001"]
    assert defect_numbers(name: "2026-11-15-1200-defects-001-to-999999999999-x.md", first: "a defect").said == "Defects 001 to 999999999999"
