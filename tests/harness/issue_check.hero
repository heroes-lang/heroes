# WHETHER GITHUB WOULD TAKE AN ISSUE AS IT RENDERS: the one list of reasons a
# rendering is refused.
#
# `offences` is it: no title; a title over 250 characters; a body over 65,535
# bytes; a payload over 1,048,576; a body that would link our own issue,
# mention an account or leave a backlink on another project's issue
# (`issue_safe.live`); a control character's escape GitHub stores otherwise
# (`issue_controls.raw`, defect 675); and a closed day before the filed one,
# the one D3's source gave as much as the one rendered, which D3 raises to
# `filed`. `records/rendered` held every card of `issues/` to it from panel
# 212's R2 (ratified 2026-10-11) until the issues left the tree (the author's
# seven answers of 2026-10-12); since then the transcription program asks it of
# every draft before an issue is opened from it (`issue_draft.hero`), and of
# every issue file it renders while the folder stands (`issue_load.hero`).

use cards
use issue_controls
use issue_json
use issue_render
use issue_safe
use issue_title
use strings

constant BODY_LIMIT: i64
    65535

constant PAYLOAD_LIMIT: i64
    1048576

# Why GitHub would not take `r`, or what the rule cannot render of it: none
# where it renders whole.
function offences(r: issue_render.Rendered) -> [str]
    out: [str] @= []

    if r.refusal != ""
        return out.push(r.refusal)

    if r.title == ""
        out @ out.push("no title")

    if issue_title.characters(r.title) > issue_title.TITLE_LIMIT
        out @ out.push("a title of " + issue_title.characters(r.title).to_str() + " characters, over 250")

    if r.body.len() > BODY_LIMIT
        out @ out.push("a body of " + r.body.len().to_str() + " bytes, over 65,535")
    size = issue_json.payload(r).len()

    if size > PAYLOAD_LIMIT
        out @ out.push("a payload of " + size.to_str() + " bytes, over 1,048,576")

    for one in issue_safe.live(r.body)
        out @ out.push("its body still holds " + one)

    # Defect 675: GitHub stores such a sequence in caret notation.
    for one in issue_controls.raw(r.body)
        out @ out.push(
            "its body still holds `" + one + "` written bare, a control character's escape GitHub stores in caret notation (`issue_controls.hero`)"
        )

    for one in issue_controls.raw(r.title)
        out @ out.push("its title holds `" + one + "`, a control character's escape GitHub stores in caret notation")

    if r.closed && cards.day_of(r.closed_day).must() < cards.day_of(r.filed).must()
        out @ out.push("closed " + r.closed_day + ", before it was filed, " + r.filed)

    # D3 renders such a day at `filed`, and the record still says two things:
    # the source stands before the filing, so one of the two is wrong.
    if r.raised
        out @ out.push(
            "the day its " + r.closed_from + " gives stands before the day it was filed, " + r.filed + ", which D3 renders it closed at; one of the two is wrong"
        )
    return out

function said<T>(got: T?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

test "a rendering is refused for its title, its sizes, a live reference and a closed day before filed"
    none: [str] = []
    good = issue_render.Rendered(
        path: "issues/a.md",
        refusal: "",
        unborn: false,
        title: "t",
        cut: false,
        prefix: "",
        pathed: "",
        self_from: "",
        fields: 0,
        body: "Filed 2026-10-03\n\nsee `#3`",
        labels: none,
        milestone: "",
        defect: "",
        closed: true,
        filed: "2026-10-03",
        closed_day: "2026-10-04",
        closed_from: "body",
        raised: false,
        comment: ""
    )
    assert offences(good).len() == 0
    untitled = issue_render.Rendered(
        path: good.path,
        refusal: good.refusal,
        unborn: false,
        title: "",
        cut: false,
        prefix: "",
        pathed: "",
        self_from: "",
        fields: 0,
        body: good.body,
        labels: none,
        milestone: "",
        defect: "",
        closed: true,
        filed: good.filed,
        closed_day: good.closed_day,
        closed_from: "body",
        raised: false,
        comment: ""
    )
    assert offences(untitled) == ["no title"]
    long = issue_render.Rendered(
        path: good.path,
        refusal: "",
        unborn: false,
        title: "x".repeat(251),
        cut: false,
        prefix: "",
        pathed: "",
        self_from: "",
        fields: 0,
        body: "b".repeat(65536),
        labels: none,
        milestone: "",
        defect: "",
        closed: true,
        filed: good.filed,
        closed_day: good.closed_day,
        closed_from: "body",
        raised: false,
        comment: ""
    )
    assert offences(long).len() == 2
    live = issue_render.Rendered(
        path: good.path,
        refusal: "",
        unborn: false,
        title: "t",
        cut: false,
        prefix: "",
        pathed: "",
        self_from: "",
        fields: 0,
        body: "see #3 and @x",
        labels: none,
        milestone: "",
        defect: "",
        closed: true,
        filed: "2026-10-05",
        closed_day: "2026-10-04",
        closed_from: "body",
        raised: false,
        comment: ""
    )
    assert offences(live).len() == 3
    raised = issue_render.Rendered(
        path: good.path,
        refusal: "",
        unborn: false,
        title: "t",
        cut: false,
        prefix: "",
        pathed: "",
        self_from: "",
        fields: 0,
        body: "b",
        labels: none,
        milestone: "",
        defect: "",
        closed: true,
        filed: "2026-10-04",
        closed_day: "2026-10-04",
        closed_from: "commit",
        raised: true,
        comment: ""
    )
    assert strings.contains(text: offences(raised)[0], needle: "the day its commit gives stands before")
    assert offences(issue_render.refused(path: "p", why: "no title: x", unborn: false)) == ["no title: x"]
