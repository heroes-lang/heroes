# THE ISSUE FILES OF THE TREE, READ AND RENDERED, for each of `issues.hero`'s
# three words, and what git says about the pin they are rendered at.
#
# `render`, `plan` and `push` read the same files the same way: every file under
# `issues/` git tracks, in name order, `issues/README.md` aside; those named on
# the command line where some are; each rendered as `issue_render` renders it,
# pinned at one commit, and judged by `issue_check.offences`, so a card that
# cannot render is refused by its path and reason. `records/rendered` holds every
# card to the same modules.
#
# Two questions about the pin are `plan`'s and `push`'s alone
# (`.claude/rules/records.md` § The issues: the `Record:` permalink is pinned at
# a commit already on `origin/main`, given as `--pin` and the same on every
# rerun, R5): whether each file the run imports is in the pin's tree, since a
# `Record:` link to a file the pin does not hold is a dead link in a public
# record; and whether the pin is an ancestor of the trunk, asked of git as
# `git merge-base --is-ancestor`, the trunk being `origin/main` as this clone
# last fetched it.

use cards
use issue_check
use issue_git
use issue_match
use issue_render
use shell
use strings

# Every issue file read, those chosen that rendered, a line for each reason one
# could not (`unrendered` of them), and the pin's forty digits.
record Loaded
    every: [cards.Issue]
    chosen: [issue_match.Entry]
    refused: [str]
    unrendered: i64
    pin: str

# The tree's issue files, those of `paths` rendered at `pin`; a failure where
# the program cannot run: a path that is no issue file, git that cannot answer,
# a history too short to.
function loaded(scratch: str, paths: [str], pin: str) -> Loaded?
    every: [cards.Issue] @= []
    known: {str: bool} @= {}

    for path in shell.project_files(scratch)?
        if strings.starts_with(text: path, prefix: "issues/") && strings.ends_with(text: path, suffix: ".md") && path != "issues/README.md"
            text = read_file(path)

            if text.is_err()
                return fail(code: "unreadable", msg: "cannot read " + path + ": " + issue_check.said(text))
            every @ every.push(cards.issue_of(path: path, text: text.must()))
            known[path] @ true

    chosen: [cards.Issue] @= every

    if paths.len() > 0
        chosen @ []

        for path in paths
            if known[path].is_err()
                return fail(
                    code: "unknown",
                    msg: "`" + path + "` is no issue file of this tree; name one from the repository's root, `issues/<year-month>/<day>/<name>.md`"
                )

            for issue in every
                if issue.path == path
                    chosen @ chosen.push(issue)

    pinned = issue_git.pinned(scratch: scratch, pin: pin)?
    facts = issue_git.gather(scratch: scratch, issues: chosen, pin: pinned)

    if facts.is_err()
        return fail(code: "git", msg: "git could not answer: " + issue_check.said(facts))

    if !facts.must().history
        return fail(
            code: "shallow",
            msg: "this clone's history is shortened, so the commits the cards name cannot be asked for; run where the history is whole"
        )
    twins = issue_render.twins_of(every)
    none: [str] = []
    entries: [issue_match.Entry] @= []
    refused: [str] @= []
    unrendered: i64 @= 0

    for issue in chosen
        got = issue_render.render(issue: issue, facts: facts.must(), twins: twins[issue.path].default(none))
        wrong = issue_check.offences(got)

        for one in wrong
            refused @ refused.push(issue.path + ": " + one)

        if wrong.len() == 0
            entries @ entries.push(issue_match.Entry(r: got, github: issue.card.github))
        else
            unrendered @ unrendered + 1

    return ok(Loaded(every: every, chosen: entries, refused: refused, unrendered: unrendered, pin: pinned))

# The paths of `paths` the tree of commit `pin` does not hold, asked in one
# `git cat-file --batch-check`, `%(rest)` handing back the path each line asked.
function missing_at(scratch: str, pin: str, paths: [str]) -> [str]?
    out: [str] @= []

    if paths.len() == 0
        return ok(out)
    asked: [str] @= []

    for path in paths
        asked @ asked.push(pin + ":" + path + " " + path)

    said = issue_git.fed(scratch: scratch, words: ["git", "cat-file", "--batch-check=%(objecttype) %(rest)"], lines: asked)?
    held: {str: bool} @= {}

    for row in strings.lines(said)
        parts = strings.words(row)

        if parts.len() == 2 && parts[0] == "blob"
            held[parts[1]] @ true

    for path in paths
        if held[path].is_err()
            out @ out.push(path)

    return ok(out)

# Whether commit `pin` is an ancestor of `trunk`, or why git could not say.
function on_trunk(scratch: str, pin: str, trunk: str) -> bool?
    ran = shell.run(scratch: scratch, program: "git", words: ["git", "merge-base", "--is-ancestor", pin, trunk])?

    if ran.code == 0
        return ok(true)

    if ran.code == 1
        return ok(false)
    return fail(
        code: "git",
        msg: "`git merge-base --is-ancestor " + pin + " " + trunk + "` exited " + ran.code.to_str() + ": " + strings.trimmed(ran.err)
    )

# The cards of `every` whose `github:` is `none`, in the cards' order, by path.
function unaddressed(every: [cards.Issue]) -> [str]
    at: {str: str} @= {}

    for issue in every
        if issue.card.complaints.len() == 0 && issue.card.github == "none"
            at[issue.card.filed + " " + issue.name + " " + issue.path] @ issue.path

    out: [str] @= []

    for key in keys(at).sort()
        out @ out.push(at[key].must())

    return out

# Why `named`, the files a `push` was given, would break the files' order, or
# "": those of them whose `github:` is `none` must be the first such files in
# the cards' order, since each import takes the next number GitHub gives.
function out_of_order(every: [cards.Issue], named: [str]) -> str
    asked: {str: bool} @= {}

    for path in named
        asked[path] @ true

    waiting = unaddressed(every)
    count: i64 @= 0

    for path in waiting
        if !asked[path].is_err()
            count @ count + 1

    for path in waiting.slice(from: 0, to: count)
        if asked[path].is_err()
            return "`" + path + "` comes before the files named, its `github:` is `none` too and it is not named, so importing them first would give them the lower numbers; name the files from the first unaddressed one, in order"

    return ""

test "git says which files a pin's tree holds and whether a pin is on a trunk"
    scratch = shell.own_scratch()

    if issue_git.shallow(scratch).default(true)
        _ = shell.remove_tree(scratch).is_err()
        return
    old = "3088caa793819b38caa1ff492253789f94be26a9"
    held = "issues/2026-09/25/2026-09-25-1106-panel-178-ratify-the-rest-is-zero-where-it-is-written.md"
    assert missing_at(scratch: scratch, pin: old, paths: [held, "issues/no-such-file.md"]).must() == ["issues/no-such-file.md"]
    assert on_trunk(scratch: scratch, pin: old, trunk: "HEAD").must()
    assert !on_trunk(scratch: scratch, pin: "HEAD", trunk: old).must()
    assert on_trunk(scratch: scratch, pin: "0000000000000000000000000000000000000001", trunk: "HEAD").is_err()
    _ = shell.remove_tree(scratch).is_err()

test "the files of a push must be the first unaddressed ones, in the cards' order"
    a = cards.issue_of(
        path: "issues/x/2026-10-01-0000-a.md",
        text: cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-10-01", commit: "none", github: "none") + "- [ ] **M-issue-files** | a | b\n"
    )
    b = cards.issue_of(
        path: "issues/x/2026-10-02-0000-b.md",
        text: cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-10-02", commit: "none", github: "none") + "- [ ] **M-issue-files** | a | b\n"
    )
    c = cards.issue_of(
        path: "issues/x/2026-09-01-0000-c.md",
        text: cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-09-01", commit: "none", github: "https://github.com/heroes-lang/heroes/issues/1") + "- [ ] **M-issue-files** | a | b\n"
    )
    assert unaddressed([b, c, a]) == [a.path, b.path]
    assert out_of_order(every: [a, b, c], named: []) == ""
    assert out_of_order(every: [a, b, c], named: [a.path]) == ""
    assert out_of_order(every: [a, b, c], named: [c.path, a.path]) == ""
    assert strings.contains(text: out_of_order(every: [a, b, c], named: [b.path]), needle: a.path)
