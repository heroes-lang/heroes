# THE `records` CHECKS THAT ASK GITHUB, since the issues left the tree.
#
# The author's seven answers of 2026-10-12 (the decision
# https://github.com/heroes-lang/heroes/issues/2027,
# filed after the transcription) put every issue on GitHub alone, so what
# `records` held of the files it now holds of what `github_issues.hero` read:
#
# - `records/tagged`, its route for a tag whose own tree holds no `issues/`
#   (`standing` and `unqueued`; `suite_records.hero` keeps reading the tag's
#   tree where it holds one, the one exact record of what that tag stood over);
# - `records/defects-cited`, whose register is `register_of` here and whose
#   reading of the code is `credit.hero`'s;
# - `records/numbering`, that no number names two defects (`numbering`);
# - `records/verdicts`, that a pending sitting is asked by an open decision
#   (`queued`), one whose ratification GitHub closed after every answer the
#   tree holds excused as not yet received (`unasked_offence`, defect 2041);
# - `records/homes`, that an open feature or task names an open milestone
#   (`unhomed`), one GitHub numbered above every milestone whose row the tree
#   holds excused as not yet received (defect 2041);
# - `records/prior-art`, that a decision's `### Prior art` keeps its two forms
#   (`prior_art`), a sitting numbered above every one the tree holds excused as
#   not yet received (defect 2039).
#
# **Whose issues these judge** (defect 2042): `numbering`, `verdicts`,
# `homes` and `prior-art` hold the project's filings to their shape, so they
# read the project's own issues alone (`github_issues.own`), and a stranger's
# issue on the public repository, titled in its own words, its body the public
# form's, is no offence and answers for nothing; each says so where the
# listing holds none of the project's (`github_issues.foreign_floor`).
# `records/tagged` reads every author's, on purpose (`standing`).
#
# **The names of a defect** (the fifth answer): the defects filed until
# 2026-10-12 keep their numbers, 001 to `OLD_LAST`, each in its issue's title,
# `Defect 235:` or `Defects 018 to 021:`, and a file of several items holds the
# later ones as body lines `- **034 — ...**`; one filed since is named by its
# GitHub issue number, its title `Defect <its number>:`, which the transcription
# program's `file` word writes. GitHub had 2,021 issues when the second pass
# ended, so the two series never meet.

use cards
use credit
use github_issues
use issue_pace
use report
use strings

# The highest number of the old series, the defects filed while the issues
# were files of `issues/` (until 2026-10-12). Written as no range here: this
# check reads `defects N to M` as a citation of every number between, and 42
# numbers below this one were never issued (measured 2026-10-12).
constant OLD_LAST: i64
    677

# The one old number issued twice, held by two issues, each body naming the
# other (`.claude/rules/records.md` § The issues, the labels bullet).
constant ISSUED_TWICE: i64
    14

# An `adjacent` defect counts as `blocking` from this many tags it stood open
# at, the tag judged included (`.claude/rules/verification.md` § Bounded
# discovery: *it becomes `blocking` when two milestone tags have been placed
# since it was filed*); `suite_records.hero`'s reading of a tag's tree counts
# the same.
constant AGED_AT: i64
    2

constant BLOB: str
    "https://github.com/heroes-lang/heroes/blob/"

constant LABEL_NUMBERING: str
    "records/numbering"

constant LABEL_PRIOR_ART: str
    "records/prior-art"

# The defects' names as GitHub holds them: each old number to the issues whose
# title or body item names it, the issue numbers of the new defects, and the
# open defects whose title names no number at all.
record Register
    old: {i64: [i64]}
    new: {i64: bool}
    misnamed: [str]
    unnamed: [str]

# The numbers a title opens with after `Defect ` or `Defects `, in any case:
# `Defect 235: x`, `Defects 018 to 021: x`, `Defects 058 and 059: x`,
# `Defect 218 closed: x`, and a new defect's `Defect <its number>: x`.
function title_numbers(title: str) -> [i64]
    none: [i64] = []

    if !credit.spells_defect(text: title, i: 0)
        return none
    at: i64 @= 6

    if at < title.len() && (title[at] == 's' || title[at] == 'S')
        at @ at + 1

    if at >= title.len() || title[at] != ' '
        return none
    return credit.numbers_after(text: title, at: at + 1, wide: true)

# The old numbers of a body's later items, as the rendering writes them: a
# plain list line `- **034 — ...**` (a file's second and later item lines,
# D7), or an item line kept whole.
function body_numbers(body: str) -> [i64]
    out: [i64] @= []

    for row in strings.lines(body)
        line = strings.trimmed(row)
        field: str @= ""

        for opening in ["- **", "- [ ] **", "- [x] **"]
            if field == "" && strings.starts_with(text: line, prefix: opening)
                field @ strings.without_prefix(text: line, prefix: opening)

        digits = credit.digit_run(text: field, at: 0)

        if digits > 0 && digits <= 3 && credit.has_at(text: field, at: digits, piece: " — ")
            # Digits are ASCII, so the cut stands between characters.
            out @ out.push(strings.to_number(field.slice(from: 0, to: digits)).must())

    return out

# The register GitHub holds: every defect issue, pull requests aside.
#
# **A stranger's title names nothing but itself** (defect 2042): a defect
# issue whose title names its own number is that defect whoever wrote it, so
# the code may cite it; every other reading, an old number, another's, none, or
# a body's later items, is the project's own issues' alone, since a stranger
# writes a title in its own words and may well name the old defect it
# reports again.
function register_of(held: github_issues.Listing) -> Register
    old: {i64: [i64]} @= {}
    new: {i64: bool} @= {}
    misnamed: [str] @= []
    unnamed: [str] @= []
    none: [i64] = []

    for issue in github_issues.of_kind(held: held, kind: "defect")
        named = title_numbers(issue.title)
        mine = github_issues.own(issue)

        if named.len() == 0 && issue.open && mine
            unnamed @ unnamed.push(told(issue))

        for n in named
            if n == issue.number && n > OLD_LAST
                new[n] @ true
            else if !mine
                continue
            else if n > OLD_LAST
                misnamed @ misnamed.push(
                    told(issue) + " names defect " + n.to_str() + ", which is neither an old defect's number nor its own"
                )
            else
                old[n] @ old[n].default(none).push(issue.number)

        for n in body_numbers(issue.body)
            if mine && n <= OLD_LAST && !holds(numbers: old[n].default(none), number: issue.number)
                old[n] @ old[n].default(none).push(issue.number)

    return Register(old: old, new: new, misnamed: misnamed, unnamed: unnamed)

# Every name the register holds, old and new, which never meet.
function names_of(register: Register) -> {i64: bool}
    out: {i64: bool} @= {}

    for n in keys(register.old)
        out[n] @ true

    for n in keys(register.new)
        out[n] @ true

    return out

# The register as the cache file the write hook's narrowed run reads
# (`suite_records.hero`'s `REGISTER`): a line saying what it is, then one name a
# line, in order.
function register_text(names: {i64: bool}) -> str
    rows: [str] @= ["# the defects' names GitHub held at this records run: one a line"]

    for n in keys(names).sort()
        rows @ rows.push(n.to_str())

    return rows.join("\n") + "\n"

# The names a cache file holds, or why it holds none this can read.
function register_read(text: str) -> {i64: bool}?
    out: {i64: bool} @= {}

    for row in strings.lines(text)
        line = strings.trimmed(row)

        if line == "" || strings.starts_with(text: line, prefix: "#")
            continue
        n = strings.to_number(line)

        if n.is_err() || n.must() < 1
            return fail(code: "shape", msg: "`" + line + "` is not a defect's name")
        out[n.must()] @ true

    if keys(out).len() == 0
        return fail(code: "empty", msg: "it holds no name")
    return ok(out)

# `records/numbering`: no old number names two defects (`ISSUED_TWICE` aside),
# no defect's title names a new number not its own, and no open defect's title
# names none, since the number is how a defect is cited.
function numbering(@r: report.Report, held: github_issues.Listing)
    if !held.asked
        unanswered(@r, held: held, label: LABEL_NUMBERING)
        return
    register = register_of(held)
    offences: [str] @= []
    strangers = github_issues.foreign_floor(held)

    if strangers != ""
        offences @ offences.push(strangers)

    if keys(register.old).len() == 0
        offences @ offences.push(
            "this check read zero old defect numbers from GitHub, so it would pass whatever the issues held: the titles' shape moved, or the listing is not the repository's"
        )

    for n in keys(register.old).sort()
        holders = register.old[n].must()

        if holders.len() > 1 && n != ISSUED_TWICE
            shown: [str] @= []

            for one in holders.sort()
                shown @ shown.push(one.to_str())

            offences @ offences.push(
                "defect " + padded(n) + " is named by " + holders.len().to_str() + " issues, " + shown.join(", ") + ": two lanes took one number"
            )

    for one in register.misnamed
        offences @ offences.push(one)

    for one in register.unnamed
        offences @ offences.push(
            one + " is an open defect whose title names no number, and the number is how it is cited; `heroes run tests/harness/issues.hero -- edit <number> <draft.md>` makes it `Defect <number>: ...`"
        )

    if offences.len() > 0
        report.keep_failure(
            @r,
            label: LABEL_NUMBERING,
            detail: "  " + offences.join("\n  ") + "\n  An old defect keeps its number 001 to " + OLD_LAST.to_str() + ", in its issue's title; a new one is named by its own issue number,\n  `Defect <number>:` (`.claude/rules/records.md` § The issues)."
        )
    else
        report.keep_pass(@r)

# Whether an open decision of the project's own on GitHub asks for the sitting
# whose file's name opens with `digits`: its title opens `Panel <digits>`, as
# the file spells them or as the integer they are, and then no digit. A
# stranger's issue so titled asks for nothing (defect 2042).
function queued(digits: str, held: github_issues.Listing) -> bool
    bare: str @= digits
    number = strings.to_number(digits)

    if !number.is_err()
        bare @ number.must().to_str()

    for issue in github_issues.owned(held: held, kind: "decision")
        if issue.open && (names_panel(title: issue.title, digits: digits) || names_panel(title: issue.title, digits: bare))
            return true

    return false

# Whether `title` opens `panel <digits>`, in any case, and no digit follows.
function names_panel(title: str, digits: str) -> bool
    opening = "panel " + digits

    if title.len() < opening.len()
        return false
    at: i64 @= 0

    while at < opening.len()
        b: u8 @= title[at]

        if b >= 'A' && b <= 'Z'
            b @ b + 32

        if b != opening[at]
            return false
        at @ at + 1

    return at == title.len() || !cards.is_digit_byte(title[at])

# Why each open feature or task of the project's own GitHub holds is not owed
# to an open milestone, a stranger's wish being none of its milestones' work
# until the program files it (defect 2042), or why the listing cannot be
# judged (`github_issues.foreign_floor`): it names none, one with no row in
# § The chain (`chain`, each milestone to whether its row is open) that this
# tree has received, one whose row is closed, or one GitHub holds closed.
#
# **GitHub holds today's milestones, and the tree under test may be older than
# one of them** (defect 2041, the shape defect 2039 repaired for
# `records/prior-art`): a milestone is opened in its lane, its GitHub
# milestone made and its items filed there before its row reaches any other
# tree, so every older tree read the items as homeless. So the tree is placed
# among the milestones by its own value, the highest number GitHub gave a
# milestone whose row it holds (`milestones_received`): GitHub numbers a
# repository's milestones in the order they are made, so one numbered above it
# is one this tree has not received, and is not held against it; one at or
# below it with no row is missing, renamed or merged out of order, and stays
# an offence, the loud direction should the order break (two lanes each
# opening a milestone, merged in the other order). **0 excuses nothing**: a
# tree that places itself nowhere is no evidence of being early. A milestone
# no tree ever receives is told once a later one's row reaches the tree.
function unhomed(held: github_issues.Listing, chain: {str: bool}) -> [str]
    out: [str] @= []
    strangers = github_issues.foreign_floor(held)

    if strangers != ""
        out @ out.push(strangers)
    received = milestones_received(held: held, chain: chain)

    for kind in ["feature", "task"]
        for issue in github_issues.owned(held: held, kind: kind)
            if !issue.open
                continue
            home = issue.milestone

            if home == ""
                out @ out.push(
                    told(issue) + ": an open " + kind + " names no milestone, and a milestone's work is owed to one"
                )
                continue
            open_now = chain[home]

            if open_now.is_err()
                wrong = rowless_offence(home: home, number: issue.milestone_number, received: received)

                if wrong != ""
                    out @ out.push(told(issue) + ": " + wrong)
            else if !open_now.must()
                out @ out.push(told(issue) + ": " + home + " is CLOSED and this item of its work is still open")
            else if !issue.milestone_open
                out @ out.push(told(issue) + ": " + home + " is open in § The chain and closed on GitHub")

    return out

# The highest number GitHub gave a milestone whose row `chain` holds, among the
# milestones the listing's issues name, or 0 where it holds none: where the
# tree stands among the milestones (`unhomed`).
function milestones_received(held: github_issues.Listing, chain: {str: bool}) -> i64
    top: i64 @= 0

    for issue in held.issues
        if !issue.pull && issue.milestone != "" && !chain[issue.milestone].is_err() && issue.milestone_number > top
            top @ issue.milestone_number

    return top

# What is wrong with an open item's milestone `home`, numbered `number` by
# GitHub, that has no row in § The chain, or "" where the tree has not
# received it yet (`unhomed`).
function rowless_offence(home: str, number: i64, received: i64) -> str
    if received > 0 && number > received
        return ""
    wrong = home + " has no row in § The chain"

    if received == 0
        return wrong
    return wrong + ", and GitHub numbered it " + number.to_str() + ", not above " + received.to_str() + ", the highest milestone whose row this tree holds, so the row is missing, renamed or merged out of order rather than not yet received"

# The first instant GitHub closed, as completed, a ratification of each
# sitting, by the sitting's number: a decision of the project's own titled
# `Panel <digits>:` (`ratifies`), the earliest where there are several, since
# that is the least a tree holding the sitting's answer has received.
function first_answers(held: github_issues.Listing) -> {i64: github_issues.Listed}
    out: {i64: github_issues.Listed} @= {}

    for issue in github_issues.owned(held: held, kind: "decision")
        if issue.open || issue.reason != "completed" || !ratifies(issue.title)
            continue
        at = answered_at(issue)
        digits = credit.digit_run(text: issue.title, at: 6)

        # Digits are ASCII, so the cut stands between characters.
        sitting = strings.to_number(issue.title.slice(from: 6, to: 6 + digits))

        if at.is_err() || sitting.is_err()
            continue
        before = out[sitting.must()]

        if before.is_err() || at.must() < answered_at(before.must()).default(at.must())
            out[sitting.must()] @ issue

    return out

# The instant GitHub closed `issue`, in seconds since 1970 UTC. **An imported
# issue's noon is read as the first second of its day**: the import wrote each
# closed card's day as noon UTC (`at_or_before`), every import ran before the
# first issue `file` opened, so such a close came before every close of the
# program's own, and the day's first second keeps it there.
function answered_at(issue: github_issues.Listed) -> i64?
    seconds = epoch_of(issue.closed)

    if seconds.is_err()
        return seconds

    if strings.ends_with(text: issue.closed, suffix: "T12:00:00Z") && imported(issue)
        return ok(seconds.must() / 86400 * 86400)
    return seconds

# Where a tree stands among the author's answers.
record Answered
    at: i64
    sitting: i64
    closed: str

# **The tree is placed among the answers by its own value** (defect 2041): of
# the sittings it holds answered, `answered`, the latest first answer GitHub
# closed (`first_answers`), or `at` 0 where it holds none GitHub answered. An
# answer reaches a tree as the commit that writes it beneath the sitting's
# stub, which `close` names and so precedes. **The premise, a claim and not a
# guarantee**: the answers are closed in the order their commits land, so a
# ratification GitHub closed after the tree's latest is one this tree has not
# received. Where two land in the other order, the tree holding the later
# close and not the earlier is told the earlier as lost: the loud direction.
function answers_received(answered: [i64], first: {i64: github_issues.Listed}) -> Answered
    top: Answered @= Answered(at: 0, sitting: 0, closed: "")

    for sitting in answered
        issue = first[sitting]

        if issue.is_err()
            continue
        at = answered_at(issue.must())

        if !at.is_err() && at.must() > top.at
            top @ Answered(at: at.must(), sitting: sitting, closed: issue.must().closed)

    return top

# Why a sitting the tree holds with a `Pending` verdict that no open decision
# asks for (`queued`), numbered `sitting` and spelt `digits`, is an offence, or
# "" where GitHub closed its ratification after every answer the tree holds,
# an answer this tree has not received yet (defect 2041).
#
# **Not by asking git whether the commit `close` names is an ancestor of
# HEAD**, the repair the issue named: the CI's legs check out one commit
# (`actions/checkout`, `fetch-depth` 1, measured in `.github/workflows/ci.yml`
# 2026-10-14), so no commit but HEAD is there to ask, and an answer written in
# a lane that never lands would leave its sitting silent for good. Here it is
# told once a later answer reaches the tree, as defect 2039's sitting is.
# **0 excuses nothing**, as there.
function unasked_offence(sitting: i64, digits: str, first: {i64: github_issues.Listed}, received: Answered) -> str
    asked = "the verdict reads `Pending` and no open decision on GitHub, titled `Panel " + digits + ":`, asks for it"
    answer = first[sitting]

    if answer.is_err()
        return asked
    at = answered_at(answer.must()).default(0)

    if received.at > 0 && at > received.at
        return ""
    closed = asked + "; GitHub closed its ratification, " + told(answer.must()) + ", at " + answer.must().closed

    if received.at == 0
        return closed + ", and this tree holds no answered sitting GitHub answered, so nothing places it among the answers"
    return closed + ", not after " + received.closed + ", when it closed the ratification of " + padded(received.sitting) + ", which this tree holds answered, so the answer is lost or merged out of order rather than not yet received"

# The lines a body's `### Prior art` section opens, up to the next heading or
# the `Record:` line, or none where it has no such section.
function prior_art_rows(body: str) -> credit.Section
    rows = strings.lines(body)
    none: [str] = []
    i: i64 @= 0

    while i < rows.len()
        if strings.trimmed(rows[i]) == "### Prior art"
            taken: [str] @= []
            j: i64 @= i + 1

            while j < rows.len() && !strings.starts_with(text: rows[j], prefix: "#") && !strings.starts_with(text: rows[j], prefix: "Record: ")
                taken @ taken.push(rows[j])
                j @ j + 1

            return credit.Section(found: true, rows: taken)
        i @ i + 1

    return credit.Section(found: false, rows: none)

# `records/prior-art` over GitHub: a `### Prior art` section stands only on a
# decision, opens with its sitting's file and the day its links were re-read,
# and holds precedents in the two forms; a heading nearly it is told.
# `known` is every path the tree holds, which a sitting's file is asked of.
# **The project's own issues alone** (defect 2042): a stranger's body is the
# stranger's words, and its `## Prior art` names what the stranger read.
#
# **GitHub holds today's issues, and the tree under test may be older than a
# sitting one of them names** (defect 2039): a sitting's decision is opened
# from its own lane before its file is pushed (`/panel` step 4), so the trunk
# at `90d1e3f7e`, whose highest sitting is 212, went red on all four CI legs on
# issue 2037, which names panel 213's file, and so did the lanes' `records`
# runs. So the tree is placed among the sittings by its own value, the highest
# it holds (`credit.highest_sitting`), and a sitting numbered above it is not
# held against it (`credit.absent_offence`); one at or below it stays an
# offence.
#
# **Not by the issue's age against the commit's**, the other reading of
# "older": measured 2026-10-13, issue 2037 was opened at 23:07:58Z and the
# trunk at 00:18:33Z was still `90d1e3f7e` (21:49:10Z), holding no sitting
# 213, so a commit made in that window, this repair's own among them, is newer
# than the issue and lacks the file all the same, and a rule keyed on the
# commit's time reads it red until the sitting's lane lands. A committer's
# clock is the committer's machine's, too.
function prior_art(@r: report.Report, held: github_issues.Listing, known: {str: bool})
    if !held.asked
        unanswered(@r, held: held, label: LABEL_PRIOR_ART)
        return
    offences: [str] @= []
    received = credit.highest_sitting(known)
    strangers = github_issues.foreign_floor(held)

    if strangers != ""
        offences @ offences.push(strangers)

    for issue in held.issues
        if !github_issues.own(issue)
            continue
        where = told(issue)

        for line in credit.near_misses(issue.body)
            if line != "### Prior art"
                offences @ offences.push(
                    where + ": `" + line + "` is nearly the heading, which GitHub's body writes `### Prior art` exactly, and a section under another spelling is one no check reads"
                )

        section = prior_art_rows(issue.body)

        if section.found
            for wrong in credit.section_offences(where: where, kind: github_issues.kind_of(issue), rows: section.rows, known: known, received: received)
                offences @ offences.push(wrong)

    if offences.len() > 0
        report.keep_failure(
            @r,
            label: LABEL_PRIOR_ART,
            detail: "  " + offences.join("\n  ") + "\n  `.claude/rules/records.md` § And the record says whose idea it was (CL-082)."
        )
    else
        report.keep_pass(@r)

# A check that needs GitHub and could not ask it: a skip with the reason, or a
# failure where the answer came and could not be read.
function unanswered(@r: report.Report, held: github_issues.Listing, label: str)
    if held.broken
        report.keep_failure(@r, label: label, detail: "  GitHub's answer could not be read: " + held.why)
    else
        report.keep_skip(
            @r,
            label: label,
            detail: "  GitHub could not be asked, so this check judged nothing: " + held.why
        )

# A milestone tag and the instant `git` says it was created, in seconds since
# 1970 UTC.
record Tag
    name: str
    at: i64

# `git tag --format='%(creatordate:unix) %(refname:short)'`, newest first, as
# tags; a row this cannot read fails the listing, since a tag left out ages
# nothing.
function tags_of(out: str) -> [Tag]?
    tags: [Tag] @= []

    for row in strings.lines(out)
        if strings.trimmed(row) == ""
            continue
        parts = strings.words(row)

        if parts.len() != 2
            return fail(code: "shape", msg: "`" + row + "` is not `<seconds> <tag>`")
        at = strings.to_number(parts[0])

        if at.is_err() || at.must() < 0
            return fail(code: "shape", msg: "`" + row + "` does not open with the seconds of its tag")
        tags @ tags.push(Tag(name: parts[1], at: at.must()))

    return ok(tags)

# The seconds since 1970 UTC of an instant as GitHub writes one,
# `2026-10-11T12:00:00Z`, or a failure.
function epoch_of(instant: str) -> i64?
    wrong = "`" + instant + "` is not an instant `YYYY-MM-DDTHH:MM:SSZ`"

    if instant.len() != 20 || instant[10] != 'T' || instant[19] != 'Z' || instant[13] != ':' || instant[16] != ':'
        return fail(code: "shape", msg: wrong)
    day = cards.day_of(instant)

    if day.is_err()
        return fail(code: "shape", msg: wrong)
    seconds: i64 @= 0

    for at in [11, 14, 17]
        if !cards.is_digit_byte(instant[at]) || !cards.is_digit_byte(instant[at + 1])
            return fail(code: "shape", msg: wrong)
        seconds @ seconds * 60 + to_i64(instant[at] - '0').must() * 10 + to_i64(instant[at + 1] - '0').must()

    d = day.must()
    return ok(issue_pace.days_from_civil(year: d / 10000, month: d / 100 % 100, day: d % 100) * 86400 + seconds)

# Whether `issue` was imported from a file of `issues/`: its body's `Record:`
# line names such a file at a commit. The import dated each such issue from
# its card, a day and no minute, written as noon UTC.
function imported(issue: github_issues.Listed) -> bool
    for row in strings.lines(issue.body)
        if strings.starts_with(text: row, prefix: "Record: " + BLOB)
            rest = strings.without_prefix(text: row, prefix: "Record: " + BLOB)

            if rest.len() > 48 && cards.is_full_hash(rest.slice(from: 0, to: 40)) && strings.starts_with(text: rest.slice(from: 40, to: rest.len()), prefix: "/issues/")
                return true

    return false

# Whether the instant `instant` of `issue` stands at or before `at`.
#
# **An imported issue's noon is a day, not an instant**: the import wrote each
# card's day as noon UTC (`.claude/rules/records.md` § The issues, the days),
# so such an instant is read as its day, at or before `at` where its day is
# not later than `at`'s. Every import came before the folder left the tree,
# and so before every tag this route judges (`suite_records.hero` judges a tag
# placed while the folder stood by that tag's own tree), so an issue imported
# open, or closed, on the day of such a tag was so before it. Any other
# instant is GitHub's own, read to the second.
function at_or_before(issue: github_issues.Listed, instant: str, at: i64) -> bool
    seconds = epoch_of(instant)

    # An instant this cannot read stands after every tag: the issue is read as
    # not yet closed, never as closed early.
    if seconds.is_err()
        return false

    if strings.ends_with(text: instant, suffix: "T12:00:00Z") && imported(issue)
        return seconds.must() / 86400 <= at / 86400
    return seconds.must() <= at

# Whether `issue` stood open at the instant `at`: created by then, and not
# closed by then.
function open_at(issue: github_issues.Listed, at: i64) -> bool
    if !at_or_before(issue: issue, instant: issue.created, at: at)
        return false
    return issue.closed == "" || !at_or_before(issue: issue, instant: issue.closed, at: at)

# The open defects that count against the tag `judged`, `tags` being every
# milestone tag up to it, each with why: `blocking` and `systemic`, a defect
# with no class label (which counts as `blocking`), and an `adjacent` one open
# at `AGED_AT` tags or more, the judged among them; an `improvement` never.
#
# **Every author's, on purpose** (defect 2042 read it and left it): a
# stranger's defect report open at a tag is one nobody has classed, which
# counts as `blocking` because a tag over an unread report is what the clean
# list refuses, and an issue opened after the tag was not open at it, so a
# stranger cannot turn this check red between tags.
function standing(held: github_issues.Listing, judged: Tag, tags: [Tag]) -> [str]
    out: [str] @= []

    for one in counted(held: held, judged: judged, tags: tags)
        out @ out.push(one.said)

    return out

# A defect that counts against a tag, and the lines that say so.
record Counted
    number: i64
    said: str

# What `standing` says, each line with its defect's number.
function counted(held: github_issues.Listing, judged: Tag, tags: [Tag]) -> [Counted]
    out: [Counted] @= []

    for issue in github_issues.of_kind(held: held, kind: "defect")
        if !open_at(issue: issue, at: judged.at)
            continue
        classed = github_issues.label_value(issue: issue, name: "class")

        if classed == "improvement"
            continue

        if classed == ""
            out @ out.push(
                Counted(number: issue.number, said: told(issue) + "\n      no `class:` label, and a defect without one counts as `blocking`")
            )
            continue

        if classed != "adjacent"
            out @ out.push(Counted(number: issue.number, said: told(issue) + "\n      `" + classed + "`"))
            continue
        since: [str] @= []

        for tag in tags
            if tag.at <= judged.at && open_at(issue: issue, at: tag.at)
                since @ since.push(tag.name)

        if since.len() >= AGED_AT
            out @ out.push(
                Counted(number: issue.number, said: told(issue) + "\n      `adjacent`, open at " + since.len().to_str() + " tags (" + since.join(" ") + "), the tag judged among them, and an `adjacent` defect counts as `blocking` once " + AGED_AT.to_str() + " have been")
            )

    return out

# THE AUTHOR'S WAIVER, SINCE THE ISSUES LEFT THE TREE (the author's *B* of
# 2026-10-24, defect 2198). A tag placed over defects that count against it is
# excused where the author carried them past it, as `CARRIED_OVER` excused
# `m-agreed-retention` over defects 129 and 130 on 2026-09-28 while the issues
# were files (`git show 9f876589:tests/harness/suite_records.hero` holds it).
# A row is `<tag> | <the decision issue that carried them> | <the defect
# numbers>`, and it is not an amnesty: it holds only while the numbers are
# exactly the ones that count against that tag, never more and never fewer,
# and the decision is a closed `decision` issue of the project's own whose
# body names the tag and each `defect <n>`. It lasts one milestone by
# construction, since `tagged` judges the newest tag alone, so a later tag
# placed over a carried defect still open is excused by nothing.
constant CARRIED: [str]
    ["m-thesis-harness | 2200 | 2139 2143"]

# Whether `CARRIED` excuses `judged` over exactly the defects `against`.
function carried_over(held: github_issues.Listing, judged: Tag, against: [i64]) -> str
    return carried(held: held, judged: judged, against: against, rows: CARRIED)

# Whether one of `rows` excuses the tag `judged` over exactly the defects
# `against`: "" where one does, and why not where none does.
function carried(held: github_issues.Listing, judged: Tag, against: [i64], rows: [str]) -> str
    for row in rows
        fields = strings.split_text(text: row, separator: " | ")

        if fields.len() != 3
            return "CARRIED's row `" + row + "` is not `<tag> | <decision> | <defect numbers>`"

        if fields[0] != judged.name
            continue
        decision = strings.to_number(fields[1])

        if decision.is_err()
            return "CARRIED's row for " + judged.name + " names `" + fields[1] + "`, which is no issue number"
        named: [i64] @= []

        for word in strings.words(fields[2])
            number = strings.to_number(word)

            if number.is_err()
                return "CARRIED's row for " + judged.name + " names `" + word + "`, which is no defect number"
            named @ named.push(number.must())

        if named.sort() != against.sort()
            return "CARRIED names " + numbers_said(named) + " for " + judged.name + ", and the tag stands over " + numbers_said(against) + ": a row excuses exactly what its tag stands over, never more and never fewer"
        return waived_by(held: held, judged: judged, decision: decision.must(), named: named)

    return "Nothing in CARRIED names " + judged.name + ", so nothing excuses it."

# Whether the issue `decision` is the author's waiver of the defects `named`
# at `judged`: "" where it is, and why not where it is not.
function waived_by(held: github_issues.Listing, judged: Tag, decision: i64, named: [i64]) -> str
    for issue in held.issues
        if issue.number != decision
            continue
        whose = "CARRIED's row for " + judged.name + " names issue " + decision.to_str()

        if github_issues.kind_of(issue) != "decision" || !github_issues.by_project(association: issue.association, body: issue.body)
            return whose + ", which is not a decision of the project's own"

        if issue.open
            return whose + ", which is still open: a waiver is a decision taken, closed the day it is filed"

        if !strings.contains(text: issue.body, needle: judged.name)
            return whose + ", whose body does not name " + judged.name

        for number in named
            if !names_defect(body: issue.body, number: number)
                return whose + ", whose body does not name defect " + number.to_str()

        return ""

    return "CARRIED's row for " + judged.name + " names issue " + decision.to_str() + ", which GitHub does not list"

# Whether `body` names `defect <number>`, the number not followed by a digit.
function names_defect(body: str, number: i64) -> bool
    needle = "defect " + number.to_str()
    rest: str @= body

    while true
        at = strings.index_of(text: rest, needle: needle)

        if at.is_err()
            return false
        after = at.must() + needle.len()

        if after >= rest.len() || !cards.is_digit_byte(rest[after])
            return true
        rest @ rest.slice(from: after, to: rest.len())

    return false

function numbers_said(numbers: [i64]) -> str
    said: [str] @= []

    for one in numbers.sort()
        said @ said.push(one.to_str())

    return said.join(" ")

# The open decisions at the tag `judged` that are not a sitting's
# ratification, whose title opens `Panel <digits>:` as the rendering gives it.
function unqueued(held: github_issues.Listing, judged: Tag) -> [str]
    out: [str] @= []

    for issue in github_issues.of_kind(held: held, kind: "decision")
        if open_at(issue: issue, at: judged.at) && !ratifies(issue.title)
            out @ out.push(told(issue))

    return out

# Whether a decision's title is a sitting's ratification: `Panel <digits>:`.
function ratifies(title: str) -> bool
    if !strings.starts_with(text: title, prefix: "Panel ")
        return false
    digits = credit.digit_run(text: title, at: 6)
    return digits > 0 && credit.has_at(text: title, at: 6 + digits, piece: ":")

# An issue as a failure names it: its address and its title.
function told(issue: github_issues.Listed) -> str
    return "https://github.com/heroes-lang/heroes/issues/" + issue.number.to_str() + " (" + issue.title + ")"

function holds(numbers: [i64], number: i64) -> bool
    for one in numbers
        if one == number
            return true

    return false

function padded(n: i64) -> str
    if n < 10
        return "00" + n.to_str()

    if n < 100
        return "0" + n.to_str()
    return n.to_str()

constant RECORDED: str
    "Record: https://github.com/heroes-lang/heroes/blob/1111111111111111111111111111111111111111/issues/2026-10/01/2026-10-01-0000-a.md"

# An issue as the program files one: a `MEMBER`'s, its body opening `Filed`
# and the day it was created where `body` does not open so already.
function fixture(number: i64, title: str, kind: str, extra: [str], body: str, state: str, created: str, closed: str) -> str
    labels: [str] @= ["kind:" + kind]

    for one in extra
        labels @ labels.push(one)

    rendered: str @= body

    if !strings.starts_with(text: body, prefix: "Filed ")
        rendered @ "Filed " + created.slice(from: 0, to: 10) + "\\n\\n" + body
    return github_issues.json_of(
        number: number,
        title: title,
        body: rendered,
        state: state,
        labels: labels,
        milestone: "",
        created: created,
        closed: closed
    )

# An issue a stranger opens from a public form: its author GitHub's `NONE`,
# its body as written.
function foreign(number: i64, title: str, kind: str, body: str, milestone: str) -> str
    return github_issues.json_full(
        number: number,
        title: title,
        body: body,
        state: "open",
        labels: ["kind:" + kind],
        milestone: milestone,
        milestone_number: 0,
        author: "NONE",
        created: "2026-10-14T08:00:00Z",
        closed: ""
    )

test "a defect's names are its title's numbers and its body's later items, and a new one is its own number"
    assert title_numbers("Defect 235: a header") == [235]
    assert title_numbers("Defects 018 to 021: four") == [18, 19, 20, 21]
    assert title_numbers("Defects 058 and 059: two") == [58, 59]
    assert title_numbers("Defect 218 closed: a cube") == [218]
    assert title_numbers("defect 093 the lane") == [93]
    assert title_numbers("Def" + "ect 2031: a new one") == [2031]
    assert title_numbers("A decision about defect 235").len() == 0
    assert title_numbers("Defective").len() == 0
    assert body_numbers("Filed x\n\n- **034 — the counter** | a\n- **035 — b**\n- [x] **036 — c**\n- **2031 — no**\n- a plain line\n") == [34, 35, 36]
    held = github_issues.held_of(
        [fixture(number: 1215, title: "Defect 033: one", kind: "defect", extra: [], body: "- **034 — two**", state: "closed", created: "2026-09-15T12:00:00Z", closed: "2026-09-15T12:00:00Z"), fixture(number: 2031, title: "Def" + "ect 2031: new", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: ""), fixture(number: 2032, title: "Def" + "ect 2040: wrong", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: ""), fixture(number: 2033, title: "a title with no number", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: ""), fixture(number: 9, title: "Defect 500: a decision's title", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: "")]
    )
    register = register_of(held)
    assert register.old[33].must() == [1215]
    assert register.old[34].must() == [1215]
    assert register.old[500].is_err()
    assert !register.new[2031].is_err()
    assert register.new[2040].is_err()
    assert register.misnamed.len() == 1
    assert strings.contains(text: register.misnamed[0], needle: "names def" + "ect 2040")
    assert register.unnamed.len() == 1
    names = names_of(register)
    assert keys(names).sort() == [33, 34, 2031]
    text = register_text(names)
    assert text == "# the defects' names GitHub held at this records run: one a line\n33\n34\n2031\n"
    assert keys(register_read(text).must()).sort() == [33, 34, 2031]
    assert register_read("# nothing\n").is_err()
    assert register_read("12\nx\n").is_err()

test "numbering refuses an old number two issues name, a new number not the issue's own and an open defect with none"
    clean = github_issues.held_of(
        [fixture(number: 1, title: "Defect 014: one", kind: "defect", extra: [], body: "b", state: "closed", created: "2026-09-05T12:00:00Z", closed: "2026-09-05T12:00:00Z"), fixture(number: 2, title: "Defect 014: two", kind: "defect", extra: [], body: "b", state: "closed", created: "2026-09-06T12:00:00Z", closed: "2026-09-06T12:00:00Z"), fixture(number: 3, title: "Defect 235: x", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: "")]
    )
    r: report.Report @= report.empty()
    numbering(@r, held: clean)
    assert r.passed == 1
    assert r.failed == 0
    twice = github_issues.held_of(
        [fixture(number: 3, title: "Defect 235: x", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: ""), fixture(number: 4, title: "Defect 235: y", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: ""), fixture(number: 2040, title: "Def" + "ect 2041: z", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: ""), fixture(number: 2041, title: "no number", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-13T08:00:00Z", closed: "")]
    )
    t: report.Report @= report.empty()
    numbering(@t, held: twice)
    assert t.failed == 1
    assert strings.contains(text: t.failures[0], needle: "defect 235 is named by 2 issues, 3, 4")
    assert strings.contains(text: t.failures[0], needle: "names def" + "ect 2041, which is neither")
    assert strings.contains(
        text: t.failures[0],
        needle: "issues/2041 (no number) is an open defect whose title names no number"
    )
    empty: report.Report @= report.empty()
    numbering(@empty, held: github_issues.held_of([]))
    assert strings.contains(text: empty.failures[0], needle: "read zero old defect numbers")
    skipped: report.Report @= report.empty()
    numbering(@skipped, held: github_issues.unasked("no network"))
    assert skipped.failed == 0
    assert skipped.passed == 0
    assert strings.contains(text: skipped.skips[0], needle: "no network")
    broken: report.Report @= report.empty()
    numbering(@broken, held: github_issues.broken("not JSON"))
    assert broken.failed == 1

test "a sitting is queued by an open decision whose title opens with its number, padded or bare"
    asking = github_issues.held_of(
        [fixture(number: 5, title: "Panel 099: ratify", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: "")]
    )
    assert queued(digits: "099", held: asking)
    bare = github_issues.held_of(
        [fixture(number: 5, title: "Panel 99: ratify", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: "")]
    )
    assert queued(digits: "099", held: bare)
    assert !queued(digits: "999", held: asking)
    assert !queued(digits: "09", held: asking)
    tasked = github_issues.held_of(
        [fixture(number: 5, title: "Panel 099: ratify", kind: "task", extra: [], body: "b", state: "open", created: "2026-10-04T12:00:00Z", closed: "")]
    )
    assert !queued(digits: "099", held: tasked)
    answered = github_issues.held_of(
        [fixture(number: 5, title: "Panel 099: ratify", kind: "decision", extra: [], body: "b", state: "closed", created: "2026-10-04T12:00:00Z", closed: "2026-10-05T12:00:00Z")]
    )
    assert !queued(digits: "099", held: answered)
    assert names_panel(title: "PANEL 212 sits", digits: "212")
    assert !names_panel(title: "Panel 2120: x", digits: "212")

test "an open feature or task names a milestone open in the chain and on GitHub"
    chain: {str: bool} @= {}
    chain["M-issue-files"] @ true
    chain["M-ir-lowering"] @ false
    homed = github_issues.held_of(
        [github_issues.json_of(number: 1, title: "t", body: "Filed 2026-10-04\\n\\nb", state: "open", labels: ["kind:task"], milestone: "M-issue-files", created: "2026-10-04T12:00:00Z", closed: ""), github_issues.json_of(number: 2, title: "d", body: "Filed 2026-10-04\\n\\nb", state: "open", labels: ["kind:defect"], milestone: "", created: "2026-10-04T12:00:00Z", closed: ""), github_issues.json_of(number: 3, title: "done", body: "Filed 2026-10-04\\n\\nb", state: "closed", labels: ["kind:feature"], milestone: "M-ir-lowering", created: "2026-10-04T12:00:00Z", closed: "2026-10-05T12:00:00Z")]
    )
    assert unhomed(held: homed, chain: chain).len() == 0
    stray = github_issues.held_of(
        [github_issues.json_of(number: 4, title: "a", body: "Filed 2026-10-04\\n\\nb", state: "open", labels: ["kind:task"], milestone: "", created: "2026-10-04T12:00:00Z", closed: ""), github_issues.json_of(number: 5, title: "b", body: "Filed 2026-10-04\\n\\nb", state: "open", labels: ["kind:feature"], milestone: "M-ir-lowering", created: "2026-10-04T12:00:00Z", closed: ""), github_issues.json_of(number: 6, title: "c", body: "Filed 2026-10-04\\n\\nb", state: "open", labels: ["kind:task"], milestone: "M-guide-book", created: "2026-10-04T12:00:00Z", closed: "")]
    )
    said = unhomed(held: stray, chain: chain)
    assert said.len() == 3
    assert strings.contains(text: said[0], needle: "an open feature names") || strings.contains(text: said[0], needle: "M-ir-lowering is CLOSED")

test "a decision's prior art on GitHub keeps its opener and its two forms, and stands on a decision alone"
    known: {str: bool} @= {}
    known["docs/panel/196-a-sitting.md"] @ true
    known["docs/panel/196-reports/historian.md"] @ true
    good = "Filed 2026-10-11\\n\\n### Prior art\\n\\nPanel 196 (`docs/panel/196-a-sitting.md`), every link read 2026-10-11.\\n\\n- **Taken from Ada**: [AI05](https://example.org/ai): the refusal\\n\\n### Recommendation\\n\\nratify\\n\\nRecord: x"
    held = github_issues.held_of(
        [fixture(number: 7, title: "Panel 196: ratify", kind: "decision", extra: [], body: good, state: "open", created: "2026-10-11T12:00:00Z", closed: "")]
    )
    r: report.Report @= report.empty()
    prior_art(@r, held: held, known: known)
    assert r.failed == 0
    assert r.passed == 1
    assert prior_art_rows(held.issues[0].body).rows.len() == 5
    wrong = "### Prior art\\n\\nPanel 196, read on the day.\\n\\n- not searched\\n"
    bad = github_issues.held_of(
        [fixture(number: 8, title: "Defect 300: x", kind: "defect", extra: [], body: wrong, state: "open", created: "2026-10-11T12:00:00Z", closed: ""), fixture(number: 9, title: "y", kind: "decision", extra: [], body: "#### Prior Art\\n\\nx", state: "open", created: "2026-10-11T12:00:00Z", closed: "")]
    )
    t: report.Report @= report.empty()
    prior_art(@t, held: bad, known: known)
    assert t.failed == 1
    assert strings.contains(text: t.failures[0], needle: "stands on a `defect`")
    assert strings.contains(text: t.failures[0], needle: "is neither `- **Taken from <who>**:`")
    assert strings.contains(text: t.failures[0], needle: "`#### Prior Art` is nearly the heading")

# Issue 2037's shape, the reproducer of defect 2039: a ratification opened
# from the sitting's lane, naming panel 213's file and its historian's report,
# against a tree whose highest sitting is 212.
function ahead_of_tree(sitting: str, created: str) -> github_issues.Listing
    body = "Filed 2026-10-13\\n\\n### Prior art\\n\\nPanel 213 (`" + sitting + "`, `docs/panel/213-reports/historian.md`), read 2026-10-13.\\n\\n- **Reached first by Nim**: [nimlldb.py](https://example.org/nim): one module registers the summaries\\n"
    return github_issues.held_of(
        [fixture(number: 2037, title: "Panel 213: x", kind: "decision", extra: [], body: body, state: "open", created: created, closed: "")]
    )

test "a sitting the tree has not received yet is not held against it, whatever the issue's age, and a number the tree has passed is (defect 2039)"
    known: {str: bool} @= {}
    known["docs/panel/196-a-sitting.md"] @ true
    known["docs/panel/212-the-last.md"] @ true
    known["docs/panel/212-reports/historian.md"] @ true
    newer: report.Report @= report.empty()
    prior_art(
        @newer,
        held: ahead_of_tree(sitting: "docs/panel/213-a-stopped-program.md", created: "2026-10-12T23:07:58Z"),
        known: known
    )
    assert newer.failed == 0
    assert newer.passed == 1

    # The trunk's commits made after the issue and before the sitting's lane
    # landed hold no 213 either: the tree is placed by its sittings, not by a
    # clock.
    older: report.Report @= report.empty()
    prior_art(
        @older,
        held: ahead_of_tree(sitting: "docs/panel/213-a-stopped-program.md", created: "2026-10-01T12:00:00Z"),
        known: known
    )
    assert older.failed == 0
    held_number: report.Report @= report.empty()
    prior_art(
        @held_number,
        held: ahead_of_tree(sitting: "docs/panel/212-a-typo.md", created: "2026-10-12T23:07:58Z"),
        known: known
    )
    assert held_number.failed == 1
    assert strings.contains(
        text: held_number.failures[0],
        needle: "names `docs/panel/212-a-typo.md`, a sitting's file this tree does not hold, and its number is not above 212"
    )

    # A sitting that never lands is told once a later one reaches the tree.
    known["docs/panel/214-the-next.md"] @ true
    later: report.Report @= report.empty()
    prior_art(
        @later,
        held: ahead_of_tree(sitting: "docs/panel/213-a-stopped-program.md", created: "2026-10-12T23:07:58Z"),
        known: known
    )
    assert later.failed == 1
    assert strings.contains(text: later.failures[0], needle: "names `docs/panel/213-a-stopped-program.md`")

# A ratification GitHub closed, as `close` closes one: `Panel <n>:`, a
# decision, closed as completed at `closed`.
function ratified(number: i64, sitting: str, created: str, closed: str) -> str
    return fixture(
        number: number,
        title: "Panel " + sitting + ": a sitting",
        kind: "decision",
        extra: [],
        body: "Filed " + created.slice(from: 0, to: 10) + "\\n\\nratify",
        state: "closed",
        created: created,
        closed: closed
    )

test "a ratification GitHub closed after every answer the tree holds is not held against it, and one closed before is (defect 2041)"
    held = github_issues.held_of(
        [ratified(number: 2037, sitting: "213", created: "2026-10-12T23:07:58Z", closed: "2026-10-14T02:56:48Z"), ratified(number: 2057, sitting: "214", created: "2026-10-14T03:10:46Z", closed: "2026-10-14T07:59:37Z"), fixture(number: 1500, title: "Panel 150: an old one", kind: "decision", extra: [], body: RECORDED, state: "closed", created: "2026-09-20T12:00:00Z", closed: "2026-09-21T12:00:00Z"), ratified(number: 1501, sitting: "150", created: "2026-10-01T08:00:00Z", closed: "2026-10-01T09:00:00Z"), fixture(number: 2058, title: "Panel 150 finding: later", kind: "decision", extra: [], body: "b", state: "closed", created: "2026-10-14T08:00:00Z", closed: "2026-10-14T09:00:00Z"), fixture(number: 2059, title: "Panel 215: asked", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-14T08:00:00Z", closed: "")]
    )
    first = first_answers(held)

    # A finding is no ratification, an open decision no answer, and of two
    # answers the first is what a tree holding the sitting has received; an
    # imported noon is its day's first second.
    assert keys(first).sort() == [150, 213, 214]
    assert first[150].must().number == 1500
    assert answered_at(first[150].must()).must() == epoch_of("2026-09-21T00:00:00Z").must()

    # Issue 2057's shape at the round's tree `66777f8ed`: 213 answered, 214
    # pending, GitHub closing 214's ratification after `348fad5ca` wrote it.
    round = answers_received(answered: [150, 213], first: first)
    assert round.sitting == 213
    assert round.closed == "2026-10-14T02:56:48Z"
    assert unasked_offence(sitting: 214, digits: "214", first: first, received: round) == ""

    # A tree holding 214's answer and not 213's, closed before it, lost it.
    later = answers_received(answered: [150, 214], first: first)
    lost = unasked_offence(sitting: 213, digits: "213", first: first, received: later)
    assert strings.contains(
        text: lost,
        needle: "titled `Panel 213:`, asks for it; GitHub closed its ratification, https://github.com/heroes-lang/heroes/issues/2037 (Panel 213: a sitting), at 2026-10-14T02:56:48Z, not after 2026-10-14T07:59:37Z, when it closed the ratification of 214"
    )

    # No ratification at all is told as before, and a tree placed nowhere
    # excuses nothing.
    assert unasked_offence(sitting: 216, digits: "216", first: first, received: round) == "the verdict reads `Pending` and no open decision on GitHub, titled `Panel 216:`, asks for it"
    nowhere = answers_received(answered: [216], first: first)
    assert nowhere.at == 0
    assert strings.contains(
        text: unasked_offence(sitting: 214, digits: "214", first: first, received: nowhere),
        needle: "nothing places it among the answers"
    )

    # A ratification closed as not planned answers nothing.
    dropped = github_issues.held_of([ratified(number: 2060, sitting: "216", created: "2026-10-14T08:00:00Z", closed: "2026-10-14T10:00:00Z")]).issues[0]
    planned = github_issues.Listing(
        asked: true,
        broken: false,
        why: "",
        issues: [first[213].must(), github_issues.Listed(number: dropped.number, title: dropped.title, body: dropped.body, association: dropped.association, open: false, reason: "not_planned", labels: dropped.labels, milestone: "", milestone_open: false, milestone_number: 0, created: dropped.created, closed: dropped.closed, pull: false)]
    )
    assert keys(first_answers(planned)) == [213]

# An open item of a milestone GitHub numbered `numbered`.
function owed(number: i64, kind: str, milestone: str, numbered: i64) -> str
    return github_issues.json_full(
        number: number,
        title: "an item",
        body: "Filed 2026-10-14\\n\\nb",
        state: "open",
        labels: ["kind:" + kind],
        milestone: milestone,
        milestone_number: numbered,
        author: "MEMBER",
        created: "2026-10-14T08:00:00Z",
        closed: ""
    )

test "a milestone GitHub numbered above every one whose row the tree holds is not held against it, and one at or below it is (defect 2041)"
    chain: {str: bool} @= {}
    chain["M-typed-inspection"] @ true
    chain["M-issue-files"] @ false
    done = github_issues.json_full(
        number: 2,
        title: "done",
        body: "Filed 2026-10-12\\n\\nb",
        state: "closed",
        labels: ["kind:task"],
        milestone: "M-issue-files",
        milestone_number: 83,
        author: "MEMBER",
        created: "2026-10-12T12:00:00Z",
        closed: "2026-10-12T21:00:00Z"
    )
    ahead = github_issues.held_of(
        [done, owed(number: 3, kind: "feature", milestone: "M-typed-inspection", numbered: 69), owed(number: 4, kind: "task", milestone: "M-web-framework", numbered: 85)]
    )
    assert milestones_received(held: ahead, chain: chain) == 83
    assert unhomed(held: ahead, chain: chain).len() == 0

    # Numbered at or below the tree's highest: missing, renamed or merged out
    # of order.
    behind = github_issues.held_of([done, owed(number: 5, kind: "task", milestone: "M-doc-generator", numbered: 70)])
    said = unhomed(held: behind, chain: chain)
    assert said.len() == 1
    assert strings.contains(
        text: said[0],
        needle: "M-doc-generator has no row in § The chain, and GitHub numbered it 70, not above 83, the highest milestone whose row this tree holds"
    )

    # Its row landed, the milestone is judged as every other.
    chain["M-web-framework"] @ false
    landed = unhomed(held: ahead, chain: chain)
    assert landed.len() == 1
    assert strings.contains(text: landed[0], needle: "M-web-framework is CLOSED")

    # A tree placed nowhere excuses nothing, and a milestone that never lands
    # is told once a later one's row reaches the tree.
    none: {str: bool} = {}
    assert unhomed(held: ahead, chain: none) == [told(ahead.issues[1]) + ": M-typed-inspection has no row in § The chain", told(ahead.issues[2]) + ": M-web-framework has no row in § The chain"]
    passed: {str: bool} @= {}
    passed["M-online-compiler"] @ true
    beyond = github_issues.held_of(
        [owed(number: 4, kind: "task", milestone: "M-web-framework", numbered: 85), owed(number: 6, kind: "task", milestone: "M-online-compiler", numbered: 86)]
    )
    stray = unhomed(held: beyond, chain: passed)
    assert stray.len() == 1
    assert strings.contains(
        text: stray[0],
        needle: "M-web-framework has no row in § The chain, and GitHub numbered it 85, not above 86"
    )

# The public defect form's body, as GitHub writes it from the form.
constant FORM: str
    "### The program\\n\\n```text\\nx = 1\\n```\\n\\n### What happens\\n\\nit compiles"

test "a stranger's defect names nothing but itself and is no offence of the project's numbering (defect 2042)"
    held = github_issues.held_of(
        [fixture(number: 1, title: "Defect 014: one", kind: "defect", extra: [], body: "b", state: "closed", created: "2026-09-05T12:00:00Z", closed: "2026-09-05T12:00:00Z"), fixture(number: 3, title: "Defect 235: x", kind: "defect", extra: [], body: "b", state: "closed", created: "2026-10-04T12:00:00Z", closed: "2026-10-05T12:00:00Z"), foreign(number: 2100, title: "A wrong program compiles", kind: "defect", body: FORM, milestone: ""), foreign(number: 2101, title: "Defect 235: it is back", kind: "defect", body: FORM + "\\n- **236 — and this**", milestone: ""), foreign(number: 2102, title: "Def" + "ect 3000: mine", kind: "defect", body: FORM, milestone: ""), foreign(number: 2103, title: "Def" + "ect 2103: named as the program would", kind: "defect", body: FORM, milestone: "")]
    )
    r: report.Report @= report.empty()
    numbering(@r, held: held)
    assert r.failed == 0
    assert r.passed == 1
    register = register_of(held)
    assert register.old[235].must() == [3]
    assert register.old[236].is_err()
    assert keys(register.new) == [2103]
    assert register.misnamed.len() == 0
    assert register.unnamed.len() == 0

    # The same titles from the project's own hand stay offences.
    own = github_issues.held_of(
        [fixture(number: 3, title: "Defect 235: x", kind: "defect", extra: [], body: "b", state: "closed", created: "2026-10-04T12:00:00Z", closed: "2026-10-05T12:00:00Z"), fixture(number: 2101, title: "Defect 235: it is back", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-14T08:00:00Z", closed: ""), fixture(number: 2100, title: "A wrong program compiles", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-14T08:00:00Z", closed: "")]
    )
    t: report.Report @= report.empty()
    numbering(@t, held: own)
    assert t.failed == 1
    assert strings.contains(text: t.failures[0], needle: "defect 235 is named by 2 issues, 3, 2101")
    assert strings.contains(
        text: t.failures[0],
        needle: "issues/2100 (A wrong program compiles) is an open defect whose title names no number"
    )

    # A listing with none of the project's own is no pass.
    alone: report.Report @= report.empty()
    numbering(
        @alone,
        held: github_issues.held_of([foreign(number: 2100, title: "Defect 014: x", kind: "defect", body: FORM, milestone: "")])
    )
    assert alone.failed == 1
    assert strings.contains(
        text: alone.failures[0],
        needle: "GitHub listed 1 issues and none of them is the project's own"
    )

test "a stranger's prior art, wish and decision are none of the project's, and a listing of strangers alone is no pass (defect 2042)"
    known: {str: bool} @= {}
    known["docs/panel/196-a-sitting.md"] @ true
    mine = fixture(
        number: 7,
        title: "Panel 196: ratify",
        kind: "decision",
        extra: [],
        body: "x",
        state: "open",
        created: "2026-10-11T12:00:00Z",
        closed: ""
    )
    stranger = github_issues.held_of(
        [mine, foreign(number: 2104, title: "Use Rust's traits", kind: "decision", body: "Hello\\n\\n## Prior Art\\n\\nRust does it\\n\\n### Prior art\\n\\n- not a form", milestone: "")]
    )
    r: report.Report @= report.empty()
    prior_art(@r, held: stranger, known: known)
    assert r.failed == 0
    alone: report.Report @= report.empty()
    prior_art(
        @alone,
        held: github_issues.held_of([foreign(number: 2104, title: "x", kind: "decision", body: "y", milestone: "")]),
        known: known
    )
    assert alone.failed == 1
    assert strings.contains(text: alone.failures[0], needle: "none of them is the project's own")

    # A stranger's wish names no milestone; a stranger cannot set one.
    chain: {str: bool} @= {}
    chain["M-typed-inspection"] @ true
    wish = github_issues.held_of(
        [mine, foreign(number: 2105, title: "Add closures", kind: "feature", body: "### What it delivers\\n\\nclosures", milestone: "")]
    )
    assert unhomed(held: wish, chain: chain).len() == 0
    lonely = unhomed(
        held: github_issues.held_of([foreign(number: 2105, title: "Add closures", kind: "feature", body: "x", milestone: "")]),
        chain: chain
    )
    assert lonely.len() == 1
    assert strings.contains(text: lonely[0], needle: "none of them is the project's own")

    # A stranger's `Panel NNN:` asks for no sitting and answers none.
    asking = github_issues.held_of(
        [mine, foreign(number: 2106, title: "Panel 215: please merge my idea", kind: "decision", body: "hi", milestone: "")]
    )
    assert !queued(digits: "215", held: asking)
    assert queued(digits: "196", held: asking)

test "an instant is read to the second, and an imported issue's noon as its day"
    assert epoch_of("2026-10-12T10:00:00Z").must() == 1791799200
    assert epoch_of("1970-01-01T00:00:00Z").must() == 0
    assert epoch_of("2026-10-12 10:00:00Z").is_err()
    assert epoch_of("2026-13-12T10:00:00Z").is_err()
    assert epoch_of("2026-10-12T1a:00:00Z").is_err()
    tag = epoch_of("2026-10-11T09:57:53Z").must()
    imported_one = github_issues.held_of([fixture(number: 1973, title: "Defect 605: x", kind: "defect", extra: ["class:blocking"], body: RECORDED, state: "closed", created: "2026-10-10T12:00:00Z", closed: "2026-10-11T12:00:00Z")]).issues[0]
    assert imported(imported_one)
    assert !open_at(issue: imported_one, at: tag)
    written = github_issues.held_of([fixture(number: 2031, title: "Def" + "ect 2031: x", kind: "defect", extra: ["class:blocking"], body: "b", state: "closed", created: "2026-10-10T12:00:00Z", closed: "2026-10-11T12:00:00Z")]).issues[0]
    assert !imported(written)
    assert open_at(issue: written, at: tag)
    assert !open_at(issue: written, at: epoch_of("2026-10-10T11:00:00Z").must())

test "a tag stands over improvements and young adjacent defects, and over no blocking, systemic or unclassed one"
    judged = Tag(name: "m-judged", at: epoch_of("2026-10-20T10:00:00Z").must())
    earlier = Tag(name: "m-earlier", at: epoch_of("2026-10-15T10:00:00Z").must())
    tags = [judged, earlier]
    young = github_issues.held_of(
        [fixture(number: 2030, title: "Def" + "ect 2030: a", kind: "defect", extra: ["class:adjacent"], body: "b", state: "open", created: "2026-10-16T08:00:00Z", closed: ""), fixture(number: 2031, title: "Def" + "ect 2031: b", kind: "defect", extra: ["class:improvement"], body: "b", state: "open", created: "2026-10-01T08:00:00Z", closed: ""), fixture(number: 2032, title: "Def" + "ect 2032: c", kind: "defect", extra: ["class:blocking"], body: "b", state: "closed", created: "2026-10-01T08:00:00Z", closed: "2026-10-19T08:00:00Z"), fixture(number: 2033, title: "Def" + "ect 2033: d", kind: "defect", extra: ["class:blocking"], body: "b", state: "open", created: "2026-10-21T08:00:00Z", closed: "")]
    )
    assert standing(held: young, judged: judged, tags: tags).len() == 0
    aged = github_issues.held_of(
        [fixture(number: 2030, title: "Def" + "ect 2030: a", kind: "defect", extra: ["class:adjacent"], body: "b", state: "open", created: "2026-10-14T08:00:00Z", closed: "")]
    )
    said = standing(held: aged, judged: judged, tags: tags)
    assert said.len() == 1
    assert strings.contains(text: said[0], needle: "open at 2 tags (m-judged m-earlier)")
    hard = github_issues.held_of(
        [fixture(number: 2034, title: "Def" + "ect 2034: e", kind: "defect", extra: ["class:systemic"], body: "b", state: "open", created: "2026-10-01T08:00:00Z", closed: ""), fixture(number: 2035, title: "Def" + "ect 2035: f", kind: "defect", extra: [], body: "b", state: "open", created: "2026-10-01T08:00:00Z", closed: "")]
    )
    held = standing(held: hard, judged: judged, tags: tags)
    assert held.len() == 2
    assert strings.contains(text: held[0], needle: "`systemic`")
    assert strings.contains(text: held[1], needle: "no `class:` label")

test "the author's waiver excuses a tag over exactly the defects a closed decision of the project's carried, and nothing else"
    judged = Tag(name: "m-judged", at: epoch_of("2026-10-20T10:00:00Z").must())
    against = [2031, 2030]

    # Spelled apart, so that `records/defects-cited` reads no citation in a fixture.
    d = "def" + "ect "
    waiver = fixture(
        number: 9,
        title: "a tag placed over two defects the author carries",
        kind: "decision",
        extra: [],
        body: "m-judged stands over " + d + "2030 and " + d + "2031, carried.",
        state: "closed",
        created: "2026-10-20T11:00:00Z",
        closed: "2026-10-20T11:00:00Z"
    )
    held = github_issues.held_of([waiver])
    assert carried(held: held, judged: judged, against: against, rows: ["m-judged | 9 | 2030 2031"]) == ""
    assert carried(held: held, judged: judged, against: against, rows: ["m-other | 9 | 1", "m-judged | 9 | 2031 2030"]) == ""

    # No row, another tag's row, one defect fewer or one more, a row of another shape.
    assert strings.starts_with(
        text: carried(held: held, judged: judged, against: against, rows: []),
        prefix: "Nothing in CARRIED names m-judged"
    )
    assert strings.starts_with(
        text: carried(held: held, judged: judged, against: against, rows: ["m-other | 9 | 2030 2031"]),
        prefix: "Nothing in CARRIED"
    )
    assert strings.contains(
        text: carried(held: held, judged: judged, against: against, rows: ["m-judged | 9 | 2030"]),
        needle: "never more and never fewer"
    )
    assert strings.contains(
        text: carried(held: held, judged: judged, against: against, rows: ["m-judged | 9 | 2030 2031 2032"]),
        needle: "stands over 2030 2031"
    )
    assert strings.contains(
        text: carried(held: held, judged: judged, against: against, rows: ["m-judged | 9"]),
        needle: "is not `<tag> | <decision> | <defect numbers>`"
    )
    assert strings.contains(
        text: carried(held: held, judged: judged, against: against, rows: ["m-judged | nine | 2030 2031"]),
        needle: "which is no issue number"
    )

    # The decision: listed, a decision, the project's, closed, naming the tag and each defect.
    row = ["m-judged | 9 | 2030 2031"]
    assert strings.contains(
        text: carried(held: github_issues.held_of([]), judged: judged, against: against, rows: row),
        needle: "which GitHub does not list"
    )
    still = github_issues.held_of(
        [fixture(number: 9, title: "t", kind: "decision", extra: [], body: "m-judged " + d + "2030 " + d + "2031", state: "open", created: "2026-10-20T11:00:00Z", closed: "")]
    )
    assert strings.contains(
        text: carried(held: still, judged: judged, against: against, rows: row),
        needle: "which is still open"
    )
    short = github_issues.held_of(
        [fixture(number: 9, title: "t", kind: "decision", extra: [], body: "m-judged " + d + "2030 " + d + "20310", state: "closed", created: "2026-10-20T11:00:00Z", closed: "2026-10-20T11:00:00Z")]
    )
    assert strings.contains(
        text: carried(held: short, judged: judged, against: against, rows: row),
        needle: "does not name " + d + "2031"
    )
    untagged = github_issues.held_of(
        [fixture(number: 9, title: "t", kind: "decision", extra: [], body: "" + d + "2030 " + d + "2031", state: "closed", created: "2026-10-20T11:00:00Z", closed: "2026-10-20T11:00:00Z")]
    )
    assert strings.contains(
        text: carried(held: untagged, judged: judged, against: against, rows: row),
        needle: "does not name m-judged"
    )
    filed = github_issues.held_of(
        [fixture(number: 9, title: "Def" + "ect 9: t", kind: "defect", extra: ["class:blocking"], body: "m-judged " + d + "2030 " + d + "2031", state: "closed", created: "2026-10-20T11:00:00Z", closed: "2026-10-20T11:00:00Z")]
    )
    assert strings.contains(
        text: carried(held: filed, judged: judged, against: against, rows: row),
        needle: "not a decision of the project's own"
    )
    stranger = github_issues.held_of(
        [foreign(number: 9, title: "t", kind: "decision", body: "m-judged " + d + "2030 " + d + "2031", milestone: "")]
    )
    assert strings.contains(
        text: carried(held: stranger, judged: judged, against: against, rows: row),
        needle: "not a decision of the project's own"
    )

    # A number is named whole, a link's text included.
    assert names_defect(body: "the [" + d + "2139](https://x) and " + d + "2143.", number: 2139)
    assert names_defect(body: "" + d + "2143", number: 2143)
    assert !names_defect(body: "" + d + "21390 and " + d + "213", number: 2139)

test "the open decisions at a tag are its ratifications, and any other counts"
    judged = Tag(name: "m-judged", at: epoch_of("2026-10-20T10:00:00Z").must())
    held = github_issues.held_of(
        [fixture(number: 1, title: "Panel 212: ratify", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-11T12:00:00Z", closed: ""), fixture(number: 2, title: "Which shape the chain takes", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-11T12:00:00Z", closed: ""), fixture(number: 3, title: "Panel 118 finding: x", kind: "decision", extra: [], body: "b", state: "open", created: "2026-10-11T12:00:00Z", closed: "")]
    )
    said = unqueued(held: held, judged: judged)
    assert said.len() == 2
    assert ratifies("Panel 212: x")
    assert !ratifies("Panel 118 finding: x")
    assert !ratifies("panel 212: x")

test "the tags are read with their seconds, newest first, and a row this cannot read fails the listing"
    got = tags_of("1791712673 m-inferred-cell\n1790627131 m-agreed-retention\n").must()
    assert got.len() == 2
    assert got[0].name == "m-inferred-cell"
    assert got[0].at == 1791712673
    assert tags_of("").must().len() == 0
    assert tags_of("m-x\n").is_err()
    assert tags_of("x m-x\n").is_err()
