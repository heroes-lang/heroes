# The two sides of CLAUDE.md §9's comparison, read: the `#~` marks a case
# claims, and the diagnostics a compiler reported (design.md §4.17's rich form
# and `check --brief`'s one line).
#
# **One reader, in a module of its own since 2026-10-04 (defect 246).** It
# lived in `suite_annotations.hero`, and `absence.hero` read a case's marks
# through it to ask whether a missing library is the case's own subject. Then
# the annotations sweep had to ask `absence.hero` whether a program it steps
# aside is the machine's answer, and Heroes refuses a module cycle (CLAUDE.md
# §11's knot clause), so the reader moved here and both read it: a second copy
# would be two readers of one mark, and the day they disagreed a case would be
# skipped by one rule and judged by the other.

use strings

# Every annotation in a case, with `#~v` resolved to the next line.
#
# **A MARK IS NOT A SENTENCE QUOTING ONE**, and this project has now paid
# for that distinction twice. Step 1 of M-separate-compilation found the
# `ORDER:` inventory was a grep returning **10 hits in 8 files, four of
# them prose**; this function had the same hole, found the day the
# annotations sweep started reading directories that contain README-shaped
# comments. `externsignature/wrong.hero` explains in its header comment
# where its annotation lives — and the sentence contains the two characters,
# so every word after them was read as a diagnostic code: `annotation`,
# `belongs`, `the`, `own`.
#
# The rule is one line and it is about position rather than vocabulary: a
# row whose first non-blank character is `#` is PROSE unless the mark is
# the very next thing. A real mark either opens its own comment (`#~ code`)
# or trails code (`… -> i64    #~ ffi_return_type`), and in the second
# case the row does not start with `#` at all. Filtering on what a code
# looks like would not have worked here: `annotation` and `belongs` are
# both perfectly good snake_case.
function claimed_by(text: str) -> [str]
    found: [str] @ []
    rows = strings.lines(text)
    line: i64 @ 0

    for row in rows
        line @ line + 1

        for mark in marks_in(row: row, line: line)
            found @ found.push(mark)

    return found

# One row's marks, which is where the reader's whole rule lives — pulled out
# of `claimed_by` on 2026-09-12 so a test can reach the rule rather than
# imitate it, which is how the `v` defect below survived.
function marks_in(row: str, line: i64) -> [str]
    found: [str] @ []
    opener = strings.trimmed(row)

    if strings.starts_with(text: opener, prefix: "#") && !strings.starts_with(text: opener, prefix: "#~")
        return found
    at = strings.index_of(text: row, needle: "#~")

    if at.is_err()
        return found

    # One comment may carry both forms: `#~ empty_record #~v empty_variant`.
    after = row.slice(from: at.must() + 2, to: row.len())

    for chunk in strings.split_text(text: after, separator: "#~")
        # **The `v` is tested BEFORE the trim, and that is the whole rule.**
        # `#~v <code>` marks the next line and `#~ <code>` marks this one, so
        # the marker is the character immediately after `#~` — trim first and
        # `#~ variant_in_value_position` reads as `#~v` plus the code
        # `ariant_in_value_position`, silently.
        #
        # Found 2026-09-12, at the first golden that ever annotated a code
        # beginning with `v`. Two codes do, `variant_in_value_position` and
        # `variant_not_callable`, and neither had ever been annotated, so the
        # hole was real for as long as this reader has existed and nothing had
        # walked into it.
        delta: i64 @ 0
        codes: str @ strings.trimmed(chunk)

        if strings.starts_with(text: chunk, prefix: "v")
            delta @ 1
            codes @ strings.trimmed(strings.without_prefix(text: chunk, prefix: "v"))

        for code in strings.words(codes)
            found @ found.push((line + delta).to_str() + ":" + code)

    return found

# Every diagnostic in an expectation, as `<line>:<code>`.
#
# Two forms, because two commands print diagnostics: `check --brief`'s
# one-liner `<file>:<line>:<col>: <kind>[<code>]: <message>`, and §4.17's
# rich form, whose code and location are on consecutive lines. The KIND is
# read rather than assumed — `error` was the only one until `unsupported`
# arrived, and hard-coding it would have quietly exempted the new kind
# from the invariant.
function reported_by(text: str) -> [str]
    found: [str] @ []
    pending: str @ ""

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "  at ")
            if pending.len() > 0
                rest = strings.without_prefix(text: row, prefix: "  at ")
                parts = strings.split_on(text: rest, byte: 58)

                if parts.len() > 1
                    number = strings.to_number(parts[1])

                    if !number.is_err()
                        found @ found.push(number.must().to_str() + ":" + pending)
                pending @ ""
            continue
        code = code_of(row)

        if code.is_err()
            continue

        # The one-line form carries its own location; the rich form's
        # headline does not, so it waits for the `at` line.
        parts = strings.split_on(text: row, byte: 58)
        placed: bool @ false

        if parts.len() > 1
            number = strings.to_number(strings.trimmed(parts[1]))

            if !number.is_err()
                found @ found.push(number.must().to_str() + ":" + code.must())
                placed @ true

        if !placed
            pending @ code.must()

    return found

# Every diagnostic in real compiler output, as `<file>:<line>:<code>`.
# The rich form only: this reads what the compiler prints by default, and
# by default it prints §4.17's form, whose `  at <file>:<line>:<col>` line
# carries both halves the comparison needs.
function reported_with_file(text: str) -> [str]
    found: [str] @ []
    pending: str @ ""

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "  at ")
            if pending.len() > 0
                rest = strings.without_prefix(text: row, prefix: "  at ")
                parts = strings.split_on(text: rest, byte: 58)

                if parts.len() > 2
                    number = strings.to_number(parts[1])

                    if !number.is_err()
                        found @ found.push(parts[0] + ":" + number.must().to_str() + ":" + pending)
                pending @ ""
            continue
        code = code_of(row)

        if !code.is_err()
            pending @ code.must()

    return found

# The `<code>` out of `…<kind>[<code>]:…`, for any kind.
function code_of(row: str) -> str?
    open = strings.index_of(text: row, needle: "[")

    if open.is_err()
        return fail(code: "none", msg: "no bracket")
    tail = row.slice(from: open.must(), to: row.len())
    close = strings.index_of(text: tail, needle: "]")

    if close.is_err()
        return fail(code: "none", msg: "no closing bracket")
    before = row.slice(from: 0, to: open.must())
    kind = last_word(before)

    if kind.len() == 0 || !all_lower(kind)
        return fail(code: "none", msg: "the word before the bracket is not a kind")
    code = row.slice(from: open.must() + 1, to: open.must() + close.must())

    # Digits belong: `indentation_not_multiple_of_4` is a code.
    if code.len() == 0 || !all_code(code)
        return fail(code: "none", msg: "the bracket does not hold a code")
    return ok(code)

# The word before the bracket, cut at a space or a colon.
function last_word(text: str) -> str
    start: i64 @ 0
    i: i64 @ 0

    while i < text.len()
        if text[i] == 32 || text[i] == 58
            start @ i + 1
        i @ i + 1

    return text.slice(from: start, to: text.len())

function all_lower(text: str) -> bool
    for i in range(from: 0, to: text.len())
        if text[i] < 97 || text[i] > 122
            return false

    return true

function all_code(text: str) -> bool
    for i in range(from: 0, to: text.len())
        byte = text[i]
        lower = byte >= 97 && byte <= 122
        digit = byte >= 48 && byte <= 57

        if !lower && !digit && byte != 95
            return false

    return true

test "an annotation is read on its line, and #~v on the next"
    marks = claimed_by("function main()\n    x = 1   #~ unused_binding\n    y = 2   #~v empty_record\n")
    assert marks.len() == 2
    assert marks[0] == "2:unused_binding"
    assert marks[1] == "4:empty_record"

test "one comment may carry both forms and several codes"
    marks = claimed_by("a   #~ one two #~v three\n")
    assert marks.len() == 3
    assert marks.sort() == ["1:one", "1:two", "2:three"]

test "the one-line form carries its own location"
    said = reported_by("x.hero:3:5: error[unused_binding]: `x` is never read\n")
    assert said == ["3:unused_binding"]

test "the rich form waits for its `at` line, whatever the kind"
    text = "unsupported[pointer_element]: a `ptr` cannot live in a container\n  at x.hero:31:5\n     |\n  31 |     handles: [ptr] @ []\n     |     ^^^^^^^^^^^^^^^^^^^\n  note: a note in brackets [not_a_code]\n"
    assert reported_by(text) == ["31:pointer_element"]

# The reader the annotations sweep holds a run's output to, which had no test
# of its own until it moved here: the file rides with the line, and only the
# rich form's `at` line places a code, since that is what the compiler prints
# by default.
test "a run's output is read with its file, from the rich form's `at` line"
    text = "error[ffi_return_type]: the header says `seven` returns `long`\n  at sub/bind.hero:13:5\n     |\n  note: in brackets [not_a_code]\nerror[unused_binding]: `x` is never read\n  at main.hero:4:5\n"
    assert reported_with_file(text) == ["sub/bind.hero:13:ffi_return_type", "main.hero:4:unused_binding"]

    # The brief form names no `at` line, so nothing in it is placed.
    assert reported_with_file("x.hero:3:5: error[unused_binding]: `x` is never read\n").len() == 0

test "a bracket that is not a code is not a diagnostic"
    assert code_of("  note: install it [somewhere else]").is_err()
    assert code_of("no brackets at all").is_err()
    assert code_of("  Perhaps `x.pc'").is_err()
    assert code_of("error[ffi_package]: ...").must() == "ffi_package"
    assert code_of("unsupported[unit_field]: ...").must() == "unit_field"
    assert code_of("x.hero:1:1: error[indentation_not_multiple_of_4]: ...").must() == "indentation_not_multiple_of_4"

test "a code beginning with `v` is this line's, not the next one's"
    # The reader tested for `v` AFTER trimming until 2026-09-12, so
    # `#~ variant_in_value_position` was read as `#~v` plus the code
    # `ariant_in_value_position` — a whole class of codes that could not be
    # annotated, silently, for as long as this file has existed. Two codes are
    # in that class and neither had ever been annotated, which is why nothing
    # found it until a golden needed one.
    here = marks_in(row: "    print(Shape::circle)  #~ variant_in_value_position", line: 16)

    assert here.len() == 1
    assert here[0] == "16:variant_in_value_position"

    # And the real next-line marker still marks the next line.
    next_one = marks_in(row: "    #~v variant_not_callable", line: 16)

    assert next_one.len() == 1
    assert next_one[0] == "17:variant_not_callable"

    # Both forms in one comment, which the reader has always allowed.
    both = marks_in(row: "    x  #~ empty_record #~v variant_not_callable", line: 3)

    assert both.len() == 2
    assert both[0] == "3:empty_record"
    assert both[1] == "4:variant_not_callable"
