# A core package's face read for its card (task 2294): the module doc's first
# sentence, each record with its fields, each variant with its cases, each
# function with its signature, its parameters and its doc, each `str`
# constant, and what the card's form has no line for. The codes the package writes, and what the face says of each, are
# `package_codes.hero`'s.
#
# The face is read as text in canonical form, which the `canonical` suite holds
# `examples/` to, and in which `heroes fmt` writes each declaration on one line
# (measured 2026-11-06: a signature written over two lines comes back as one).
# A signature that does not close on its line is refused rather than guessed.
#
# **What the form has no line for is refused, by name, never left out.** A
# constant that names no code is a name a program writes, so a card that left
# it out would be a card that lies by omission; the refusal says what to teach
# this module first. A `variant` was refused so until 2026-11-10, when
# `encoding/json`'s `Value` was the first a face declared, and its card line
# was taught (`Choice`). A `str` constant a `fail` writes its code through is a
# code the package adds (the conventions' § 3.3), and the card lists it among
# the codes.
#
# **An `extern` group was refused so until 2026-11-13**, when `net`'s floor,
# `net/hero_net.hero`, was the first module over C a package published
# (`examples/packages/README.md` § 4.1, M-core-packages step 16). A floor's
# card is taught (`Bound`): the group's header, each record of the header and
# each run of its constants, which a program names through the module, and
# none of its functions, which a program cannot call: an `extern` is called in
# its own module alone (`extern_across_modules`), through the module's function
# of Heroes that the card lists as it lists every function. A module holds one
# group on a card; a second is refused by name.

use <core>/strings as core_strings

use module_docs
use strings

# A record's field, or a function's parameter, as declared: its name, its type
# as written, and the marks a parameter may carry.
record Slot
    name: str
    ty: str
    mutable: bool
    lent: bool

# A record of the face, for the card's `## Types`.
record Shape
    name: str
    fields: [Slot]
    said: str

# A case of a variant: its name, and its fields, none for a case that holds
# nothing.
record Case
    name: str
    fields: [Slot]

# A variant of the face, for the card's `## Types`: its name, its cases in
# their order, and its doc's first sentence.
record Choice
    name: str
    cases: [Case]
    said: str

# A function of the face, for the card's `## Functions`: its signature as the
# face writes it after `function `, its type parameters as written (`<A, B>` or
# ""), its parameters, its result ("" where it answers nothing), its doc's
# paragraphs joined, and the doc's first sentence.
record Callable
    name: str
    written: str
    generics: str
    params: [Slot]
    result: str
    doc: str
    said: str

# A `str` constant of the face, `constant NAME: str` over a plain literal,
# which may name a code the package writes: its name, its value and its doc's
# first sentence.
record Named
    name: str
    value: str
    said: str

# What a floor's group gives a program to name through the module: a record of
# the header, a handle where it has a `tag` and no field, or a run of the
# header's constants written one under the other, each run under its doc.
variant Bound
    bound_record
        name: str
        written: str
        fields: [Slot]
        said: str
    bound_constants
        names: [str]
        ty: str
        said: str

# What a face is to its card: its path under the package's root, what
# `use <core>/<path>` binds, its module doc's first sentence, the header its
# `extern` group names ("" for a face with none) and what the group gives a
# program to name, its records, variants, functions and `str` constants, its
# `use` lines, and what the card's form cannot say of it.
record Face
    path: str
    binding: str
    said: str
    header: str
    bound: [Bound]
    shapes: [Shape]
    choices: [Choice]
    callables: [Callable]
    constants: [Named]
    uses: [str]
    refused: [str]

# The face at `path` under the package's root, read from its text.
function face_of(path: str, text: str) -> Face
    rows = strings.lines(text)
    refused: [str] @= []
    said = first_said(module_docs.module_doc(rows))

    if said.len() == 0
        refused @ refused.push("the module has no doc, whose first sentence a card opens with")
    shapes: [Shape] @= []
    choices: [Choice] @= []
    callables: [Callable] @= []
    constants: [Named] @= []
    uses: [str] @= []
    header: str @= ""
    bound: [Bound] @= []
    at: i64 @= 0

    for row in rows
        if core_strings.has_prefix(s: row, prefix: "use ")
            uses @ uses.push(row)
        else if core_strings.has_prefix(s: row, prefix: "record ")
            shapes @ shapes.push(shape_at(rows: rows, at: at))
        else if core_strings.has_prefix(s: row, prefix: "variant ")
            choices @ choices.push(choice_at(rows: rows, at: at))
        else if core_strings.has_prefix(s: row, prefix: "function ")
            got = callable_at(rows: rows, at: at)

            if got.is_err()
                refused @ refused.push("line " + (at + 1).to_str() + ": " + why(got))
            else
                callables @ callables.push(got.must())
        else if core_strings.has_prefix(s: row, prefix: "constant ")
            value = module_docs.str_constant(rows: rows, at: at)

            if value.is_err()
                refused @ refused.push(
                    "line " + (at + 1).to_str() + ": `" + strings.trimmed(row) + "`, and a card has a line for a `str` constant naming a code alone: teach `package_face.hero` another before a face declares it"
                )
            else
                constants @ constants.push(
                    Named(name: module_docs.name_after(text: row, start: 9), value: value.must(), said: first_said(module_docs.doc_above(rows: rows, at: at)))
                )
        else if core_strings.has_prefix(s: row, prefix: "extern ")
            if header.len() > 0
                refused @ refused.push(
                    "line " + (at + 1).to_str() + ": `" + strings.trimmed(row) + "` is a second group, and a card names one group's header: teach `package_face.hero` another before a floor declares two"
                )
            else
                header @ quoted_in(row)
                bound @ bound_in(rows: rows, at: at)
        at @ at + 1

    for one in bound
        match one
            .bound_record r =>
                if r.said.len() == 0
                    refused @ refused.push(
                        "the group's `record " + r.name + "` has no doc, whose first sentence its card line writes"
                    )
            .bound_constants c =>
                if c.said.len() == 0
                    refused @ refused.push(
                        "the group's `constant " + c.names[0] + "` has no doc, whose first sentence its card line writes"
                    )

    for shape in shapes
        if shape.said.len() == 0
            refused @ refused.push("`record " + shape.name + "` has no doc, whose first sentence its card line writes")

    for choice in choices
        if choice.said.len() == 0
            refused @ refused.push(
                "`variant " + choice.name + "` has no doc, whose first sentence its card line writes"
            )

    for f in callables
        if f.said.len() == 0
            refused @ refused.push("`function " + f.name + "` has no doc, whose first sentence its card line writes")

    return Face(
        path: path,
        binding: binding_of(path),
        said: said,
        header: header,
        bound: bound,
        shapes: shapes,
        choices: choices,
        callables: callables,
        constants: constants,
        uses: uses,
        refused: refused
    )

# The text between the first two double quotes of `row`, the header an
# `extern` line names: `extern "hero_net.h"` gives `hero_net.h`.
function quoted_in(row: str) -> str
    parts = strings.split_on(text: row, byte: '"')

    if parts.len() < 3
        return ""
    return parts[1]

# What the group whose line is row `at` gives a program to name: each record,
# with the fields indented under it, and each run of constants written one
# under the other with no comment between, each with the doc directly above it
# inside the group. Its functions are left out, a program calling them through
# the module's own functions of Heroes.
function bound_in(rows: [str], at: i64) -> [Bound]
    out: [Bound] @= []
    run: [str] @= []
    run_ty: str @= ""
    run_said: str @= ""
    below: i64 @= at + 1

    while below < rows.len() && core_strings.has_prefix(s: rows[below], prefix: "    ")
        row = strings.trimmed(rows[below])
        declared = core_strings.has_prefix(s: row, prefix: "constant ")

        # A run of constants ends at any row that is not one of them.
        if !declared && run.len() > 0
            out @ out.push(.bound_constants(names: run, ty: run_ty, said: run_said))
            run @ []

        if declared
            name = module_docs.name_after(text: row, start: 9)
            ty = strings.trimmed(row.slice(from: 9 + name.len() + 1, to: row.len()))

            if run.len() == 0 || ty != run_ty
                if run.len() > 0
                    out @ out.push(.bound_constants(names: run, ty: run_ty, said: run_said))
                run @ []
                run_ty @ ty
                run_said @ first_said(member_doc(rows: rows, at: below))
            run @ run.push(name)
        else if core_strings.has_prefix(s: row, prefix: "record ")
            fields: [Slot] @= []
            under: i64 @= below + 1

            while under < rows.len() && core_strings.has_prefix(s: rows[under], prefix: "        ")
                inner = strings.trimmed(rows[under])

                if !core_strings.has_prefix(s: inner, prefix: "#")
                    fields @ fields.push(slot_of(inner))
                under @ under + 1

            out @ out.push(
                .bound_record(name: module_docs.name_after(text: row, start: 7), written: row, fields: fields, said: first_said(member_doc(rows: rows, at: below)))
            )
        below @ below + 1

    if run.len() > 0
        out @ out.push(.bound_constants(names: run, ty: run_ty, said: run_said))
    return out

# The doc of the group's member at row `at`: the comment rows directly above it,
# indented as it is.
function member_doc(rows: [str], at: i64) -> [str]
    top: i64 @= at

    while top > 0 && core_strings.has_prefix(s: rows[top - 1], prefix: "    #") && !core_strings.has_prefix(s: rows[top - 1], prefix: "    ##")
        top @ top - 1

    out: [str] @= []

    for row in rows.slice(from: top, to: at)
        out @ out.push(module_docs.uncommented(strings.trimmed(row)))

    return out

# What `use <core>/<path>` binds: the path's last part (spec § 1).
function binding_of(path: str) -> str
    parts = strings.split_on(text: path, byte: '/')
    return parts[parts.len() - 1]

# The first sentence of a doc's first paragraph, or "" where there is no doc.
function first_said(doc: [str]) -> str
    paragraphs = module_docs.paragraphs(doc)

    if paragraphs.len() == 0
        return ""
    return module_docs.first_sentence(paragraphs[0])

function why(got: Callable?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# The record declared at row `at`: its name, the fields indented under it, a
# comment among them skipped, and its doc's first sentence.
function shape_at(rows: [str], at: i64) -> Shape
    name = module_docs.name_after(text: rows[at], start: 7)
    fields: [Slot] @= []
    below: i64 @= at + 1

    while below < rows.len() && core_strings.has_prefix(s: rows[below], prefix: "    ")
        row = strings.trimmed(rows[below])

        if !core_strings.has_prefix(s: row, prefix: "#")
            fields @ fields.push(slot_of(row))
        below @ below + 1

    return Shape(name: name, fields: fields, said: first_said(module_docs.doc_above(rows: rows, at: at)))

# The variant declared at row `at`: each case a row indented once, each of
# its fields a row indented twice below it, a comment among them skipped, and
# its doc's first sentence.
function choice_at(rows: [str], at: i64) -> Choice
    name = module_docs.name_after(text: rows[at], start: 8)
    cases: [Case] @= []
    names: [str] @= []
    fields: [[Slot]] @= []
    below: i64 @= at + 1

    while below < rows.len() && core_strings.has_prefix(s: rows[below], prefix: "    ")
        row = strings.trimmed(rows[below])

        if core_strings.has_prefix(s: row, prefix: "#")
            below @ below + 1
            continue

        if core_strings.has_prefix(s: rows[below], prefix: "        ") && names.len() > 0
            last = fields.len() - 1
            fields[last] @ fields[last].push(slot_of(row))
        else
            nothing: [Slot] = []
            names @ names.push(row)
            fields @ fields.push(nothing)
        below @ below + 1

    for i in range(from: 0, to: names.len())
        cases @ cases.push(Case(name: names[i], fields: fields[i]))

    return Choice(name: name, cases: cases, said: first_said(module_docs.doc_above(rows: rows, at: at)))

# The function declared at row `at`, or why it cannot be read: a signature that
# does not close on its row, a parameter named `_`, which a call cannot write.
function callable_at(rows: [str], at: i64) -> Callable?
    written = strings.without_prefix(text: rows[at], prefix: "function ")
    name = module_docs.name_after(text: written, start: 0)
    rest = written.slice(from: name.len(), to: written.len())
    generics: str @= ""

    if core_strings.has_prefix(s: rest, prefix: "<")
        close = strings.index_of(text: rest, needle: ">")

        if close.is_err()
            return fail(code: "unread", msg: "`function " + name + "`'s type parameters do not close on its line")
        generics @ rest.slice(from: 0, to: close.must() + 1)
    after = rest.slice(from: generics.len(), to: rest.len())
    close = closing(text: after, open: 0)

    if !core_strings.has_prefix(s: after, prefix: "(") || close.is_err()
        return fail(
            code: "unread",
            msg: "`function " + name + "`'s parameters do not close on its line, which `heroes fmt` writes on one: format the face"
        )
    tail = after.slice(from: close.must() + 1, to: after.len())

    if tail.len() > 0 && !core_strings.has_prefix(s: tail, prefix: " -> ")
        return fail(code: "unread", msg: "`function " + name + "` has `" + tail + "` after its parameters")
    params: [Slot] @= []

    for piece in split_top(after.slice(from: 1, to: close.must()))
        slot = slot_of(piece)

        if slot.name == "_" || slot.name.len() == 0
            return fail(code: "unread", msg: "`function " + name + "` has a parameter with no name a call can write")
        params @ params.push(slot)

    doc = module_docs.paragraphs(module_docs.doc_above(rows: rows, at: at))
    return ok(
        Callable(name: name, written: written, generics: generics, params: params, result: strings.without_prefix(text: tail, prefix: " -> "), doc: doc.join(" "), said: first_said(module_docs.doc_above(rows: rows, at: at)))
    )

# A parameter or a field, `[@]name: Type [lent]`, read.
function slot_of(text: str) -> Slot
    piece = strings.trimmed(text)
    mutable = core_strings.has_prefix(s: piece, prefix: "@")
    body = strings.without_prefix(text: piece, prefix: "@")
    colon = strings.index_of(text: body, needle: ": ")

    if colon.is_err()
        return Slot(name: body, ty: "", mutable: mutable, lent: false)
    ty = body.slice(from: colon.must() + 2, to: body.len())
    lent = core_strings.has_suffix(s: ty, suffix: " lent")
    return Slot(
        name: body.slice(from: 0, to: colon.must()),
        ty: strings.without_suffix(text: ty, suffix: " lent"),
        mutable: mutable,
        lent: lent
    )

# The index of the bracket that closes the one at `open`, the brackets between
# counted, or none where the text ends first.
function closing(text: str, open: i64) -> i64?
    depth: i64 @= 0
    at: i64 @= open

    while at < text.len()
        byte = text[at]

        if byte == '(' || byte == '[' || byte == '{'
            depth @ depth + 1
        else if byte == ')' || byte == ']' || byte == '}'
            depth @ depth - 1

            if depth == 0
                return ok(at)
        at @ at + 1

    return fail(code: "open", msg: "the bracket does not close")

# `text` cut at each comma outside brackets, each part trimmed; nothing at all
# is no part.
function split_top(text: str) -> [str]
    out: [str] @= []

    if strings.trimmed(text).len() == 0
        return out
    depth: i64 @= 0
    start: i64 @= 0
    at: i64 @= 0

    while at < text.len()
        byte = text[at]

        if byte == '(' || byte == '[' || byte == '{'
            depth @ depth + 1
        else if byte == ')' || byte == ']' || byte == '}'
            depth @ depth - 1
        else if byte == ',' && depth == 0
            out @ out.push(strings.trimmed(text.slice(from: start, to: at)))
            start @ at + 1
        at @ at + 1

    return out.push(strings.trimmed(text.slice(from: start, to: text.len())))

## Tests

test "a face is read: its doc, its records with their fields, its functions with their parameters"
    text = "# Text, taken apart. More.\n\nuse strings/internal/scan\n\n# A pair. Of halves.\nrecord Halves\n    before: str\n    # a comment inside\n    after: str\n\n# Whether it begins.\nfunction has_prefix(s: str, prefix: str) -> bool\n    return true\n\n# Swaps.\nfunction swap<A>(@a: A, b: A lent)\n    _ = 0\n"
    face = face_of(path: "strings", text: text)
    assert face.binding == "strings"
    assert face.said == "Text, taken apart."
    assert face.uses == ["use strings/internal/scan"]
    assert face.refused.len() == 0
    assert face.shapes.len() == 1
    assert face.shapes[0].name == "Halves" && face.shapes[0].said == "A pair."
    assert face.shapes[0].fields.len() == 2
    assert face.shapes[0].fields[1].name == "after" && face.shapes[0].fields[1].ty == "str"
    assert face.callables.len() == 2
    first = face.callables[0]
    assert first.written == "has_prefix(s: str, prefix: str) -> bool"
    assert first.result == "bool" && first.said == "Whether it begins."
    assert first.params[1].name == "prefix" && first.params[1].ty == "str"
    second = face.callables[1]
    assert second.generics == "<A>" && second.result == ""
    assert second.params[0].mutable && second.params[0].ty == "A"
    assert second.params[1].lent && second.params[1].ty == "A"

test "a parameter's type keeps its brackets and its commas whole"
    assert split_top("xs: [A], f: (function(from: str, to: str) -> ()), m: {str: [i64]}") == ["xs: [A]", "f: (function(from: str, to: str) -> ())", "m: {str: [i64]}"]
    assert split_top("").len() == 0
    assert binding_of("net/http") == "http"

test "what the form has no line for is refused by name, and so is what cannot be read"
    face = face_of(
        path: "x",
        text: "# X.\n\nconstant MOST: i64\n    3\n\nextern \"x.h\"\n    function x_f()\n\nextern \"y.h\"\n    function y_f()\n\nfunction f(a: i64,\n\nfunction g(_: i64)\n    _ = 0\n\nfunction h() -> i64\n    return 1\n\nvariant Shape\n    dot\n"
    )
    assert face.refused.len() == 6
    assert core_strings.contains(
        s: face.refused[0],
        substr: "line 3: `constant MOST: i64`, and a card has a line for a `str` constant naming a code alone"
    )
    assert face.refused[1] == "line 9: `extern \"y.h\"` is a second group, and a card names one group's header: teach `package_face.hero` another before a floor declares two"
    assert face.header == "x.h" && face.bound.len() == 0
    assert core_strings.contains(s: face.refused[2], substr: "do not close on its line")
    assert core_strings.contains(s: face.refused[3], substr: "no name a call can write")
    assert face.refused[4] == "`variant Shape` has no doc, whose first sentence its card line writes"
    assert face.refused[5] == "`function h` has no doc, whose first sentence its card line writes"
    assert face_of(path: "y", text: "# Documents f.\nfunction f()\n    _ = 0\n").refused[0] == "the module has no doc, whose first sentence a card opens with"

# A floor's group (`examples/packages/README.md` § 4.1): its records and its runs
# of constants are read, each with the doc above it inside the group, and its
# functions, which no program can call across the module, are not.
test "a floor's group is read: its header, its records, its runs of constants, and no function of C"
    text = "# Floor.\n\nextern \"hero_net.h\"\n    # A socket. More.\n    record Socket tag hero_net_socket\n    # The kinds.\n    constant A: i64\n    constant B: i64\n    # Narrow.\n    constant C: i32\n    function hero_net_f(s: Socket) -> i64\n    # Two numbers.\n    record Pair tag pair\n        # a comment inside\n        x: i64\n        y: i64\n    constant D: i64\n\n# Reads.\nfunction f(s: Socket) -> i64\n    return hero_net_f(s)\n"
    face = face_of(path: "net/hero_net", text: text)
    assert face.header == "hero_net.h"
    assert face.callables.len() == 1 && face.callables[0].name == "f"
    assert face.bound.len() == 5
    assert face.bound[0] == .bound_record(name: "Socket", written: "record Socket tag hero_net_socket", fields: [], said: "A socket.")
    assert face.bound[1] == .bound_constants(names: ["A", "B"], ty: "i64", said: "The kinds.")
    assert face.bound[2] == .bound_constants(names: ["C"], ty: "i32", said: "Narrow.")

    match face.bound[3]
        .bound_record r    => assert r.name == "Pair" && r.fields.len() == 2 && r.fields[1].name == "y"
        .bound_constants _ => assert false

    assert face.bound[4] == .bound_constants(names: ["D"], ty: "i64", said: "")
    assert face.refused == ["the group's `constant D` has no doc, whose first sentence its card line writes"]
    assert quoted_in("extern \"a.h\" link \"a\"") == "a.h"
    assert quoted_in("extern") == ""

test "a variant is read with its cases, each with its fields, a comment among them skipped"
    text = "# J.\n\n# A value. More.\nvariant Value\n    nothing\n    # a comment inside\n    number\n        value: f64\n    pair\n        left: [Value]\n        right: {str: Value}\n\n# After.\nfunction f(v: Value) -> Value\n    return v\n"
    face = face_of(path: "encoding/json", text: text)
    assert face.refused.len() == 0
    assert face.binding == "json"
    assert face.choices.len() == 1
    choice = face.choices[0]
    assert choice.name == "Value" && choice.said == "A value."
    assert choice.cases.len() == 3
    assert choice.cases[0].name == "nothing" && choice.cases[0].fields.len() == 0
    assert choice.cases[1].name == "number" && choice.cases[1].fields[0].name == "value"
    assert choice.cases[1].fields[0].ty == "f64"
    assert choice.cases[2].fields.len() == 2 && choice.cases[2].fields[1].ty == "{str: Value}"
    assert face.callables.len() == 1
