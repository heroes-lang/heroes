# A generated program as text, in the canonical form `heroes fmt` prints
# (panel 231's prototype), so that oracle 3 can ask `fmt` for the same bytes.
#
# Three rules of that form are copied here, each read from `fmt`'s output on
# 2026-10-28 (the seat's report) and so each a premise about the formatter
# that oracle 3 judges: a parenthesis stands only where precedence or left
# association needs it (spec § 7's table); a `match`'s arms pad their
# patterns so every `=>` stands in one column; and a statement that opens a
# block has a blank line before it, unless it opens its own block, and a
# `for` and a `match` binding have one after them, where an `if` has none.

use gen_cboundary
use gen_eval
use gen_tree

# spec § 7's precedence, weakest first; a negative literal is a unary minus.
# A unary operand is never parenthesised for being unary: `fmt` prints
# `-(-8)` as `--8`, which reads back as the same tree (measured 2026-10-28).
function precedence(n: gen_tree.Node) -> i64
    op = n.op

    if op == "||"
        return 1

    if op == "&&"
        return 2

    if gen_tree.is_comparison(op)
        return 3

    if op == "|"
        return 4

    if op == "^"
        return 5

    if op == "&"
        return 6

    if op == "<<" || op == ">>"
        return 7

    if op == "+" || op == "-" || op == "concat"
        return 8

    if op == "*" || op == "/" || op == "%"
        return 9

    if op == "neg" || op == "not" || op == "~" || op == "lit" && n.value < 0
        return 10
    return 11

function expr(p: gen_tree.Program lent, at: i64) -> str
    n = p.nodes[at]

    if n.op == "lit"
        return n.value.to_str()

    if n.op == "true" || n.op == "false"
        return n.op

    if n.op == "name" || n.op == "field" || n.op == "bname" || n.op == "bfield"
        return n.name

    if n.op == "index"
        return n.name + "[" + expr(p, at: n.kids[0]) + "]"

    if n.op == "call"
        return n.name + "(" + arguments(p, n: n) + ")"

    if n.op == "slit"
        return "\"" + n.name + "\""

    if n.op == "sname"
        return n.name

    if n.op == "concat"
        return operand(p, at: n.kids[0], outer: 8, right: false) + " + " + operand(p, at: n.kids[1], outer: 8, right: true)

    if n.op == "tostr"
        return "to_str(" + expr(p, at: n.kids[0]) + ")"

    if n.op == "slice"
        return operand(p, at: n.kids[0], outer: 11, right: false) + ".slice(from: " + expr(p, at: n.kids[1]) + ", to: " + expr(p, at: n.kids[2]) + ")"

    if n.op == "strlen"
        return operand(p, at: n.kids[0], outer: 11, right: false) + ".len()"

    if n.op == "default"
        return expr(p, at: n.kids[0]) + ".default(" + expr(p, at: n.kids[1]) + ")"

    if n.op == "must"
        return expr(p, at: n.kids[0]) + ".must()"

    if n.op == "neg"
        return "-" + operand(p, at: n.kids[0], outer: 10, right: false)

    if n.op == "not"
        return "!" + operand(p, at: n.kids[0], outer: 10, right: false)

    if n.op == "~"
        return "~" + operand(p, at: n.kids[0], outer: 10, right: false)
    outer = precedence(n)
    return operand(p, at: n.kids[0], outer: outer, right: false) + " " + n.op + " " + operand(p, at: n.kids[1], outer: outer, right: true)

function operand(p: gen_tree.Program lent, at: i64, outer: i64, right: bool) -> str
    inner = precedence(p.nodes[at])
    text = expr(p, at: at)

    if inner < outer || right && inner == outer
        return "(" + text + ")"
    return text

# Two parameters of one type are named at the call (spec § 9); every
# parameter here is an `i64`, so a call of two or more names them all.
function arguments(p: gen_tree.Program lent, n: gen_tree.Node) -> str
    parts: [str] @= []
    i: i64 @= 0

    while i < n.kids.len()
        if n.kids.len() > 1
            parts @ parts.push("p" + i.to_str() + ": " + expr(p, at: n.kids[i]))
        else
            parts @ parts.push(expr(p, at: n.kids[i]))
        i @ i + 1

    return parts.join(", ")

# A statement of `main` as the lines it prints, and the two facts the
# blank-line rule asks of it.
record Unit
    lines: [str]
    block: bool
    after: bool

function units(p: gen_tree.Program lent, s: gen_tree.Stmt) -> [Unit]
    i = "    "

    return match s
        .bind_int b  => [plain(i + b.name + " = " + expr(p, at: b.expr))]
        .bind_bool b => [plain(i + b.name + " = " + expr(p, at: b.expr))]
        .bind_str b  => [plain(i + b.name + " = " + expr(p, at: b.expr))]
        .show w      => [plain(i + "print(" + printed(p, parts: w.parts) + ")")]
        .rec r => [
            plain(i + r.name + " = R0(a: " + expr(p, at: r.a) + ", b: " + expr(p, at: r.b) + ", f: " + expr(p, at: r.f) + ")")
        ]
        .arr r => [plain(i + r.name + " = [" + listed(p, items: r.elems) + "]")]
        .picked m => [
            plain(i + m.vname + ": V0 = " + built_case(p, m: s))
            Unit(lines: arms(p, m: s), block: true, after: true)
        ]
        .cond c =>
            lines = [
                i + "if " + expr(p, at: c.guard)
                i + i + c.name + " @ " + expr(p, at: c.yes)
                i + "else"
                i + i + c.name + " @ " + expr(p, at: c.no)
            ]
            [plain(i + c.name + " @= 0"), Unit(lines: lines, block: true, after: false)]
        .loop l =>
            head = i + "for " + l.counter + " in range(from: " + l.low.to_str() + ", to: " + l.high.to_str() + ")"
            step = i + i + l.name + " @ " + l.name + " " + l.op + " " + operand(p, at: l.body, outer: precedence(gen_tree.Node(op: l.op, value: 0, name: "", kids: [])), right: true)
            [plain(i + l.name + " @= " + expr(p, at: l.init)), Unit(lines: [head, step], block: true, after: true)]
        .shaped sh => shaped_units(p, at: sh.at)

# A shape's statements, one line each and none a block.
function shaped_units(p: gen_tree.Program lent, at: i64) -> [Unit]
    out: [Unit] @= []

    for line in p.shapes[at].lines
        out @ out.push(plain("    " + line))

    return out

function plain(line: str) -> Unit
    return Unit(lines: [line], block: false, after: false)

function printed(p: gen_tree.Program lent, parts: [i64]) -> str
    shown: [str] @= []

    for part in parts
        shown @ shown.push(expr(p, at: part))

    return shown.join(", \" \", ")

function listed(p: gen_tree.Program lent, items: [i64]) -> str
    shown: [str] @= []

    for item in items
        shown @ shown.push(expr(p, at: item))

    return shown.join(", ")

function built_case(p: gen_tree.Program lent, m: gen_tree.Stmt) -> str
    return match m
        .picked k =>
            if k.case_at == 0
                ".c0(v: " + expr(p, at: k.payload[0]) + ")"
            else if k.case_at == 1
                ".c1"
            else
                ".c2(w: " + expr(p, at: k.payload[0]) + ", z: " + expr(p, at: k.payload[1]) + ")"
        .bind_int | .bind_bool | .bind_str | .show | .rec | .arr | .cond | .loop | .shaped => ""

function arms(p: gen_tree.Program lent, m: gen_tree.Stmt) -> [str]
    lines: [str] @= []

    match m
        .picked k =>
            lines @ lines.push("    " + k.mname + " = match " + k.vname)
            patterns = [".c0 " + k.binders[0], ".c1", ".c2 " + k.binders[2]]
            widest: i64 @= 0

            for pattern in patterns
                if pattern.len() > widest
                    widest @ pattern.len()

            j: i64 @= 0

            while j < 3
                pad = repeat(" ", to_u64(widest - patterns[j].len()).must())
                lines @ lines.push("        " + patterns[j] + pad + " => " + expr(p, at: k.arms[j]))
                j @ j + 1
        .bind_int | .bind_bool | .bind_str | .show | .rec | .arr | .cond | .loop | .shaped => _ = 0

    return lines

# `main`'s statements as lines, with the blank lines the canonical form puts
# around a block.
function main_text(p: gen_tree.Program lent) -> str
    every: [Unit] @= []

    for s in p.body
        for u in units(p, s: s)
            every @ every.push(u)

    text: str @= "function main()\n"
    blank_owed: bool @= false
    first: bool @= true

    for u in every
        if !first && (u.block || blank_owed)
            text @ text + "\n"

        for line in u.lines
            text @ text + line + "\n"

        blank_owed @ u.after
        first @ false

    return text

function function_text(p: gen_tree.Program lent, f: gen_tree.Fn) -> str
    params: [str] @= []

    for name in f.params
        params @ params.push(name + ": i64")

    if p.nodes[f.body].op == "fallible"
        body = p.nodes[f.body]
        failing = "        return fail(code: \"" + gen_eval.REFUSED_CODE + "\", msg: \"" + gen_eval.REFUSED_MSG + "\")\n"
        return "function " + f.name + "(" + params.join(", ") + ") -> i64?\n    if " + expr(p, at: body.kids[0]) + "\n" + failing + "    return ok(" + expr(p, at: body.kids[1]) + ")\n"
    return "function " + f.name + "(" + params.join(", ") + ") -> i64\n    return " + expr(p, at: f.body) + "\n"

constant RECORD: str
    "record R0\n    a: i64\n    b: i64\n    f: bool\n"

constant VARIANT: str
    "variant V0\n    c0\n        v: i64\n    c1\n    c2\n        w: i64\n        z: bool\n"

# The whole file: its seed in a comment, the declarations it uses, `main`.
function program_text(p: gen_tree.Program lent, seed: i64, has_record: bool, has_variant: bool) -> str
    parts: [str] @= ["# Generated by tests/harness/generate.hero from seed " + seed.to_str() + ".\n"]

    if has_record
        parts @ parts.push(RECORD)

    if gen_cboundary.has_c(p)
        parts @ parts.push(gen_cboundary.extern_text(p, header: "g" + seed.to_str() + ".h"))

    if has_variant
        parts @ parts.push(VARIANT)

    for f in p.fns
        if !gen_cboundary.is_c(f)
            parts @ parts.push(function_text(p, f: f))

    for s in p.shapes
        for text in s.hero
            parts @ parts.push(text)

    parts @ parts.push(main_text(p))
    return parts.join("\n")

# The lines of a program's text, its last line feed ending the last line.
function lines_of(text: str) -> [str]
    rows: [str] @= []
    start: i64 @= 0
    i: i64 @= 0

    while i < text.len()
        if text[i] == 10
            rows @ rows.push(text.slice(from: start, to: i))
            start @ i + 1
        i @ i + 1

    if start < text.len()
        rows @ rows.push(text.slice(from: start, to: text.len()))
    return rows

function has_panic(answer: str) -> bool
    for row in lines_of(answer)
        if row.len() >= 8 && row.slice(from: 0, to: 8) == "!panic: "
            return true

    return false

# `answer` with `!at: <place>` written before its `!panic:` line.
function placed(answer: str, place: str) -> str
    out: str @= ""

    for row in lines_of(answer)
        if row.len() >= 8 && row.slice(from: 0, to: 8) == "!panic: "
            out @ out + "!at: " + place + "\n"
        out @ out + row + "\n"

    return out

test "an answer is placed before its `!panic:` line, and lines are read as written"
    assert placed(answer: "1\n2\n!panic: division by zero\n", place: "g3.hero:9:11") == "1\n2\n!at: g3.hero:9:11\n!panic: division by zero\n"
    assert lines_of("a\n\nb\n") == ["a", "", "b"]
    assert has_panic("1\n!panic: x\n")
    assert !has_panic("1\n")

test "a parenthesis stands only where precedence or association needs it"
    p: gen_tree.Program @= gen_tree.Program(nodes: [], fns: [], body: [], shapes: [])
    a = gen_tree.added(@p, gen_tree.leaf(op: "name", value: 0, name: "a"))
    b = gen_tree.added(@p, gen_tree.leaf(op: "lit", value: -5, name: ""))
    sum = gen_tree.binary(@p, op: "+", left: a, right: b)
    product = gen_tree.binary(@p, op: "*", left: sum, right: a)
    right = gen_tree.binary(@p, op: "-", left: a, right: sum)
    assert expr(p, at: sum) == "a + -5"
    assert expr(p, at: product) == "(a + -5) * a"
    assert expr(p, at: right) == "a - (a + -5)"
