# The generator's arithmetic, held to the contract over a whole grid (panel
# 231's R2, the compiler-engineer's amendment 1; M-generated-programs, task
# 931).
#
# **Why it exists.** The generator computes each program's answer with the
# `i64` operators of the compiler that built it, so a miscompilation of `>>`
# is written into the program's output and into its `.expected` alike, and
# oracle 2 sees nothing: measured on a planted `>>`, 0 of 300 programs failed
# with the generator built by the planted compiler, 36 of 300 with it built by
# the trunk's (`docs/panel/231-reports/compiler-engineer.md`, Q1). This module
# is the one place the model meets an answer it did not compute: every integer
# operator `gen_eval.arith` models, over every pair of operands in -8 to 7,
# against a REFERENCE that reaches the same value through other operators,
# so one operator's miscompilation cannot hide in its own reference.
#
#   `+` and `-` through a carry adder of `^`, `&` and `<<` (`added`);
#   `*` as repeated addition; `/` and `%` by repeated subtraction, truncating
#   toward zero (spec § 7), `%` as what the quotient leaves;
#   `<<` as repeated doubling, `>>` as repeated halving toward minus infinity
#   (design.md § 4.14: arithmetic);
#   `&`, `|` and `^` bit by bit, each bit read by the reference division, on
#   the four-bit two's complement the grid's operands and results all fit.
#
# A grid of 16 × 16 pairs is YARPGen's own move (measurement 056 § 1.2:
# *exhaustive testing of 4-bit values*), and every operand pair the grid holds
# is one a generated program can meet. The adder uses `<<` and the bit
# reading uses the reference `/`, so the references are not independent of
# every operator; they are independent of the one each checks, which is what
# a single-rule miscompilation needs.

use gen_eval

constant LOW: i64
    -8

constant HIGH: i64
    7

# The operators `gen_eval.arith` models, every one checked.
constant OPERATORS: [str]
    ["+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^"]

# `a + b` with no `+`: the sum of the bits without the carries, and the
# carries moved one place left, until no carry is left. Wraps as the
# hardware does, which the grid never reaches.
function added(a: i64, b: i64) -> i64
    sum: i64 @= a
    carry: i64 @= b
    turns: i64 @= 0

    while carry != 0 && turns < 64
        next_carry = (sum & carry) << 1
        sum @ sum ^ carry
        carry @ next_carry
        turns @ turns + 1

    return sum

function negated(a: i64) -> i64
    return added(a: ~a, b: 1)

function times(a: i64, b: i64) -> i64
    total: i64 @= 0
    k: i64 @= 0
    count = magnitude(b)

    while k < count
        total @ added(a: total, b: a)
        k @ k + 1

    if b < 0
        return negated(total)
    return total

function magnitude(a: i64) -> i64
    if a < 0
        return negated(a)
    return a

# Truncating division of the grid's operands, `b` not zero: how many times
# `|b|` fits in `|a|`, with the sign of the quotient.
function quotient(a: i64, b: i64) -> i64
    left: i64 @= magnitude(a)
    step = magnitude(b)
    fits: i64 @= 0

    while left >= step
        left @ added(a: left, b: negated(step))
        fits @ fits + 1

    if a < 0 != (b < 0)
        return negated(fits)
    return fits

function remainder(a: i64, b: i64) -> i64
    return added(a: a, b: negated(times(a: quotient(a: a, b: b), b: b)))

function doubled(a: i64, count: i64) -> i64
    x: i64 @= a
    k: i64 @= 0

    while k < count
        x @ added(a: x, b: x)
        k @ k + 1

    return x

# Halving toward minus infinity, `count` times: the truncated quotient, one
# lower where an odd negative number was cut toward zero.
function halved(a: i64, count: i64) -> i64
    x: i64 @= a
    k: i64 @= 0

    while k < count
        q = quotient(a: x, b: 2)

        if x < 0 && remainder(a: x, b: 2) != 0
            x @ added(a: q, b: -1)
        else
            x @ q
        k @ k + 1

    return x

# Bit `i` of a four-bit two's complement number, `i` from 0 to 3.
function bit(a: i64, i: i64) -> i64
    shifted = halved(a: a, count: i)

    if remainder(a: shifted, b: 2) != 0
        return 1
    return 0

# The bitwise operators bit by bit, bit 3 weighing -8.
function bitwise(op: str, a: i64, b: i64) -> i64
    total: i64 @= 0
    weights = [1, 2, 4, -8]
    i: i64 @= 0

    while i < 4
        x = bit(a: a, i: i)
        y = bit(a: b, i: i)
        on: bool @= false

        if op == "&"
            on @ x == 1 && y == 1
        else if op == "|"
            on @ x == 1 || y == 1
        else
            on @ x != y

        if on
            total @ added(a: total, b: weights[i])
        i @ i + 1

    return total

# The reference: the value the contract owes, or the abort it owes, for one
# operator and one pair of the grid.
function owed(op: str, a: i64, b: i64) -> i64?
    if op == "+"
        return ok(added(a: a, b: b))

    if op == "-"
        return ok(added(a: a, b: negated(b)))

    if op == "*"
        return ok(times(a: a, b: b))

    if op == "/" || op == "%"
        if b == 0
            return fail(code: "abort", msg: gen_eval.BY_ZERO)

        if op == "/"
            return ok(quotient(a: a, b: b))
        return ok(remainder(a: a, b: b))

    if op == "<<" || op == ">>"
        if b < 0
            return fail(code: "abort", msg: gen_eval.SHIFT)

        if op == "<<"
            return ok(doubled(a: a, count: b))
        return ok(halved(a: a, count: b))
    return ok(bitwise(op, a: a, b: b))

# Every disagreement between the model and the reference over the grid, one
# line each: empty where the model holds.
function disagreements() -> [str]
    out: [str] @= []

    for op in OPERATORS
        a: i64 @= LOW

        while a <= HIGH
            b: i64 @= LOW

            while b <= HIGH
                model = gen_eval.arith(op, a: a, b: b)
                reference = owed(op, a: a, b: b)
                said = told(model)

                if said != told(reference)
                    out @ out.push(
                        a.to_str() + " " + op + " " + b.to_str() + ": the model says " + said + ", the contract " + told(reference)
                    )
                b @ b + 1

            a @ a + 1

    return out

function told(v: i64?) -> str
    match v
        .ok n  => return n.to_str()
        .err e => return "abort `" + e.msg + "`"

test "the model agrees with the contract over every pair in -8 to 7 of every operator"
    wrong = disagreements()

    for line in wrong
        print(line)

    assert wrong.len() == 0

test "the references reach the contract's own constants"
    assert added(a: 7, b: -8) == -1
    assert negated(-8) == 8
    assert quotient(a: -7, b: 2) == -3
    assert remainder(a: -7, b: 2) == -1
    assert remainder(a: 7, b: -2) == 1
    assert halved(a: -8, count: 1) == -4
    assert halved(a: -1, count: 3) == -1
    assert doubled(a: -8, count: 7) == -1024
    assert bitwise("&", a: -1, b: 5) == 5
    assert bitwise("|", a: -8, b: 1) == -7
    assert bitwise("^", a: -1, b: 7) == -8
