# The rules the `packages` suite holds the core packages to, each a function over
# text so that a test can ask it of a literal: how a path and a declared name are
# spelled, what a code looks like, what a package may not do, what every function
# owes, what the driver reaches, and how the local static index the programs'
# catalogues read is written. `suite_packages.hero` walks the index and the
# programs and asks these; the conventions are `examples/packages/README.md`'s,
# each marked there "(the `packages` suite)".
#
# **The source is one tree since panel 235's R15** (ratified 2026-11-07,
# M-package-manager step 14): the core packages are one catalogue entry, `core`,
# published in the index at `INDEX`, `<index>/core/<version>/files/`, and each
# program fetches its version under its own `heroes.packages/`. The conventions
# are held over the newest version's files, the one a version in preparation is
# written in; every published version is held to its listing and its sum.

use module_docs
use module_text
use shell
use strings

# The local static index every program's catalogue under `examples/` reads, over
# `file://../index` (panel 235's R15 and R9's C4).
constant INDEX: str
    "examples/index"

# The one package the conventions hold, the catalogue entry every program names
# the core packages by: `use <core>/strings`.
constant PACKAGE: str
    "core"

# The calls no package makes, but `log` and `os`, whose work they are (the
# conventions' § 5.2). `args_checked` reads what `args` reads (spec § 11), so a
# package reading its program's words through it is the same mistake.
constant QUIET: [str]
    [
        "print"
        "exit"
        "args"
        "args_checked"
    ]

constant LOUD: [str]
    [
        "log"
        "os"
    ]

## The index

# The package's source: the `files/` of the newest version folder of `PACKAGE`
# in the index, published or in preparation, which is where a change is
# written and where `package_cards.hero -- write` writes its cards.
function source_root(scratch: str) -> str?
    package = INDEX + "/" + PACKAGE

    if !shell.is_directory(package)
        return fail(code: "absent", msg: package + " is not there, and the core packages' source is its newest version")
    versions: [str] @= []

    for dir in shell.list_directories(scratch: scratch, dir: package)?
        name = strings.base_name(path: dir)

        if version_shape(name)
            versions @ versions.push(name)

    last = newest(versions)

    if last.len() == 0
        return fail(
            code: "absent",
            msg: package + " holds no version folder, and the core packages' source is its newest"
        )
    return ok(package + "/" + last + "/files")

# One version an index lists: its number and the sum of its listing.
record Listed
    version: str
    sum: str

# An exact version, three numbers with no leading zero, the compiler's
# `sums.version_shape`: `0.1.0`, never `v0.1.0`, `0.1` or `01.0.0`.
function version_shape(version: str) -> bool
    parts = strings.split_on(text: version, byte: '.')

    if parts.len() != 3
        return false

    for part in parts
        if !number_shape(part)
            return false

    return true

function number_shape(text: str) -> bool
    if text.len() == 0 || text.len() > 1 && text[0] == '0'
        return false

    for at in range(from: 0, to: text.len())
        if text[at] < '0' || text[at] > '9'
            return false

    return true

# Whether version `a` comes before `b`, number by number; both in
# `version_shape`.
function earlier(a: str, b: str) -> bool
    left = strings.split_on(text: a, byte: '.')
    right = strings.split_on(text: b, byte: '.')

    for at in range(from: 0, to: 3)
        x = strings.to_number(left[at]).default(0)
        y = strings.to_number(right[at]).default(0)

        if x != y
            return x < y

    return false

# The newest of `versions`, each in `version_shape`, or "" for none.
function newest(versions: [str]) -> str
    best: str @= ""

    for one in versions
        if best.len() == 0 || earlier(a: best, b: one)
            best @ one

    return best

# `sha256-` then 64 lowercase hexadecimal digits, the compiler's
# `sums.sum_shape`.
function sum_shape(sum: str) -> bool
    if sum.len() != 71 || !strings.starts_with(text: sum, prefix: "sha256-")
        return false

    for at in range(from: 7, to: 71)
        b = sum[at]

        if !(b >= '0' && b <= '9' || b >= 'a' && b <= 'f')
            return false

    return true

# A package's `versions` file as the fetch verb reads it: one `<version> <sum>`
# a line, each line ended, no version twice; or what is wrong, by its line.
function versions_read(text: str) -> [Listed]?
    if text.len() == 0 || !strings.ends_with(text: text, suffix: "\n")
        return fail(code: "malformed", msg: "is empty or its last line has no end")
    out: [Listed] @= []
    number: i64 @= 0

    for line in strings.lines(text)
        number @ number + 1
        halves = strings.split_on(text: line, byte: ' ')

        if halves.len() != 2 || !version_shape(halves[0]) || !sum_shape(halves[1])
            return fail(
                code: "malformed",
                msg: "line " + number.to_str() + " is not `<version> sha256-<64 hex>`: `" + line + "`"
            )

        for one in out
            if one.version == halves[0]
                return fail(code: "malformed", msg: "lists " + halves[0] + " twice")

        out @ out.push(Listed(version: halves[0], sum: halves[1]))

    return ok(out)

# The canonical listing a package's sum is taken over (the compiler's
# `fingerprint.listing`, Go's `h1` in hexadecimal): one line per file, its
# SHA-256, two spaces, its path under the package's root, the lines sorted by
# the paths' bytes. `files` holds each path and its digest, in any order.
function listing_of(files: [[str]]) -> str
    sums: {str: str} @= {}
    names: [str] @= []

    for one in files
        sums[one[0]] @ one[1]
        names @ names.push(one[0])

    lines: [str] @= []

    for name in names.sort()
        lines @ lines.push(sums[name].default("") + "  " + name + "\n")

    return lines.join("")

# What differs between the listing a version holds and the one its files give,
# each file named once: changed, added since, or taken out since. Empty where
# the two are the same text.
function moved(listed: str, files: str) -> [str]
    held = listing_map(listed)
    found = listing_map(files)
    out: [str] @= []

    for name in keys(found).sort()
        before = held[name]

        if before.is_err()
            out @ out.push("`" + name + "` is not in the listing")
        else if before.must() != found[name].default("")
            out @ out.push("`" + name + "` is not the file its listing names")

    for name in keys(held).sort()
        if found[name].is_err()
            out @ out.push("`" + name + "` is in the listing and not among the files")

    if out.len() == 0 && listed != files
        out @ out.push(
            "the listing names its files, and is not written as `shasum -a 256` writes them, sorted by their names' bytes"
        )
    return out

# A listing's lines as name and digest; a line of another shape is kept under
# its own text, so `moved` names it.
function listing_map(text: str) -> {str: str}
    out: {str: str} @= {}

    for line in strings.lines(text)
        if line.len() > 66 && line[64] == ' ' && line[65] == ' '
            out[line.slice(from: 66, to: line.len())] @ line.slice(from: 0, to: 64)
        else
            out[line] @ ""

    return out

## A program's catalogue

# One entry of a catalogue written by `heroes add` from an index: its name,
# version and sum.
record Entry
    name: str
    version: str
    sum: str

# A catalogue as `heroes add` writes it for a program whose packages come from
# an index: the `index` line, then one `[dependencies.<name>]` table each with
# its `version` and `sum`. Anything else is refused by its line: a `path`, a
# `git` source, a comment, so a catalogue of `examples/` is the verb's and never
# a hand's (panel 235's R15: never `path` entries).
record Catalogue
    index: str
    entries: [Entry]

function catalogue_read(text: str) -> Catalogue?
    index: str @= ""
    entries: [Entry] @= []
    number: i64 @= 0

    for line in strings.lines(text)
        number @ number + 1

        if line.len() == 0
            continue

        if strings.starts_with(text: line, prefix: "[dependencies.") && strings.ends_with(text: line, suffix: "]")
            entries @ entries.push(Entry(name: line.slice(from: 14, to: line.len() - 1), version: "", sum: ""))
            continue
        value = quoted_value(line)

        if value.is_err()
            return fail(
                code: "malformed",
                msg: "line " + number.to_str() + " is not a line `heroes add` writes: `" + line + "`"
            )
        key = line.slice(from: 0, to: strings.index_of(text: line, needle: " = ").default(0))

        if key == "index" && entries.len() == 0 && index.len() == 0
            index @ value.must()
        else if key == "version" && entries.len() > 0 && entries[entries.len() - 1].version.len() == 0
            entries[entries.len() - 1].version @ value.must()
        else if key == "sum" && entries.len() > 0 && entries[entries.len() - 1].sum.len() == 0
            entries[entries.len() - 1].sum @ value.must()
        else
            return fail(
                code: "malformed",
                msg: "line " + number.to_str() + ", `" + line + "`, is not where `heroes add` writes it for an entry of the index: an `index` line first, then each entry's `version` and `sum`"
            )

    for e in entries
        if e.version.len() == 0 || e.sum.len() == 0
            return fail(code: "malformed", msg: "the entry `" + e.name + "` lacks its `version` or its `sum`")

    return ok(Catalogue(index: index, entries: entries))

# The text between the quotes of `<key> = "<text>"`, or a failure.
function quoted_value(line: str) -> str?
    at = strings.index_of(text: line, needle: " = \"")

    if at.is_err() || !strings.ends_with(text: line, suffix: "\"") || line.len() < at.must() + 5
        return fail(code: "malformed", msg: line)
    return ok(line.slice(from: at.must() + 4, to: line.len() - 1))

# The entry's name and version a placed tree's folder writes, `core@0.1.0-<key>`,
# or a failure for a folder of another shape: the compiler names a tree
# `<name>@<version>-<16 hex>` (`selfhost/module/placed.hero`'s `key`).
function placed_named(folder: str) -> Entry?
    at = strings.index_of(text: folder, needle: "@")

    if at.is_err()
        return fail(code: "malformed", msg: folder)
    rest = folder.slice(from: at.must() + 1, to: folder.len())
    dash = strings.index_of(text: rest, needle: "-")

    if dash.is_err() || rest.len() - dash.must() - 1 != 16
        return fail(code: "malformed", msg: folder)
    return ok(Entry(name: folder.slice(from: 0, to: at.must()), version: rest.slice(from: 0, to: dash.must()), sum: ""))

## The conventions

# A module's path under its package's root, without `.hero`:
# `strings/internal/scan` for `<root>/strings/internal/scan.hero`.
function module_path(root: str, path: str) -> str
    return strings.without_suffix(text: strings.without_prefix(text: path, prefix: root + "/"), suffix: ".hero")

# The parts of a path under a package's root that are not lower case: each
# directory `[a-z][a-z0-9_]*`, and the file's name the same before its one
# extension, `[a-z0-9]+` (`examples/packages/README.md` § 1.5). On a volume that
# folds case, two spellings are one file, and a module named in a capital
# compiles there and nowhere else.
function crooked_parts(rel: str) -> [str]
    out: [str] @= []
    parts = strings.split_on(text: rel, byte: '/')

    for part in parts.slice(from: 0, to: parts.len() - 1)
        if !lower_word(part)
            out @ out.push(part)

    name = parts[parts.len() - 1]
    halves = strings.split_on(text: name, byte: '.')

    if halves.len() > 2 || !lower_word(halves[0]) || halves.len() == 2 && !extension(halves[1])
        out @ out.push(name)
    return out

# Whether `word` is `[a-z][a-z0-9_]*`, the shape of a package's path and of a
# code (spec § 6: codes are stable snake_case strings).
function lower_word(word: str) -> bool
    if word.len() == 0 || word[0] < 'a' || word[0] > 'z'
        return false

    for at in range(from: 1, to: word.len())
        byte = word[at]

        if !(byte >= 'a' && byte <= 'z' || byte >= '0' && byte <= '9' || byte == '_')
            return false

    return true

function extension(word: str) -> bool
    if word.len() == 0
        return false

    for at in range(from: 0, to: word.len())
        byte = word[at]

        if !(byte >= 'a' && byte <= 'z' || byte >= '0' && byte <= '9')
            return false

    return true

# The paths that differ from an earlier one only in case, each named with the
# one it repeats: one file on a volume that folds case, two on one that does
# not. ASCII letters are folded, and only they, since a module's name is an
# identifier and spec § 1 keeps identifiers ASCII.
function case_twins(paths: [str]) -> [str]
    seen: {str: str} @= {}
    out: [str] @= []

    for path in paths
        low = folded(path)
        first = seen[low]

        if first.is_err()
            seen[low] @ path
        else
            out @ out.push("`" + first.must() + "` and `" + path + "`")

    return out

function folded(text: str) -> str
    bytes: [u8] @= []

    for at in range(from: 0, to: text.len())
        byte = text[at]

        if byte >= 'A' && byte <= 'Z'
            bytes @ bytes.push(byte + 32)
        else
            bytes @ bytes.push(byte)

    # Folding an ASCII capital leaves every other byte where it stood, so the
    # bytes of a `str` folded are UTF-8 still.
    return bytes.validated_bytes().must()

# The records and variants not named in PascalCase, `[A-Z][A-Za-z0-9]*`, and the
# constants not in SCREAMING_CASE, `[A-Z][A-Z0-9_]*` (`examples/packages/README.md` § 2.5):
# a declaration in column 0, or a member of an `extern` group indented under
# one, since no statement opens with these words.
function misnamed(text: str) -> [str]
    out: [str] @= []
    line: i64 @= 0

    for row in strings.lines(text)
        line @ line + 1
        content = strings.trimmed(row)

        for word in ["record", "variant", "constant"]
            if strings.starts_with(text: content, prefix: word + " ")
                name = module_docs.name_after(text: content, start: word.len() + 1)

                if word == "constant" && !screaming(name)
                    out @ out.push("line " + line.to_str() + ": `constant " + name + "` is not SCREAMING_CASE")
                else if word != "constant" && !pascal(name)
                    out @ out.push("line " + line.to_str() + ": `" + word + " " + name + "` is not PascalCase")

    return out

function pascal(name: str) -> bool
    if name.len() == 0 || name[0] < 'A' || name[0] > 'Z'
        return false

    for at in range(from: 1, to: name.len())
        if name[at] == '_'
            return false

    return true

function screaming(name: str) -> bool
    if name.len() == 0 || name[0] < 'A' || name[0] > 'Z'
        return false

    for at in range(from: 1, to: name.len())
        if name[at] >= 'a' && name[at] <= 'z'
            return false

    return true

# The codes a module's `fail` calls write that are not snake_case,
# `[a-z][a-z0-9_]*` (spec § 6, `examples/packages/README.md` § 3.2), tests included: each
# literal, and each `str` constant of the module a code is written through (the
# conventions' § 3.3), read for its value.
function crooked_codes(text: str) -> [str]
    out: [str] @= []

    for code in module_text.literal_codes(text)
        if !lower_word(code)
            out @ out.push("`fail(code: \"" + code + "\"`")

    rows = strings.lines(text)
    values: {str: str} @= {}

    for at in range(from: 0, to: rows.len())
        if strings.starts_with(text: rows[at], prefix: "constant ")
            value = module_docs.str_constant(rows: rows, at: at)

            if !value.is_err()
                values[module_docs.name_after(text: rows[at], start: 9)] @ value.must()

    for named in module_text.named_codes(text)
        value = values[named]

        if !value.is_err() && !lower_word(value.must())
            out @ out.push("`fail(code: " + named + "`, whose constant is \"" + value.must() + "\"")

    return out

# The calls of `QUIET` a module makes, in its code and its tests, never in a
# comment or a literal; none for a module of `log` or `os`. `module` is its path
# under its package's root.
function noisy(module: str, text: str) -> [str]
    out: [str] @= []

    for loud in LOUD
        if module == loud || strings.starts_with(text: module, prefix: loud + "/")
            return out

    code = module_text.bare(text)

    for name in QUIET
        for at in module_text.call_places(code: code, name: name)
            out @ out.push("line " + module_text.line_of(text: code, at: at).to_str() + ": `" + name + "(`")

    return out

# The top-level functions with no comment directly above them (the
# conventions' § 6.1), a `##` heading being none.
function undocumented(text: str) -> [str]
    out: [str] @= []
    rows = strings.lines(text)

    for f in module_docs.functions_of(rows)
        if f.at == 0 || !module_docs.commented(rows[f.at - 1])
            out @ out.push("line " + (f.at + 1).to_str() + ": `function " + f.name + "`")

    return out

# The top-level functions no `test` block of their own module calls (the
# conventions' § 6.2): `name(` in a test's code, never in its title, a comment
# or a literal.
function untested(text: str) -> [str]
    out: [str] @= []
    tested = module_text.bare(module_text.tests_only(text))

    for f in module_docs.functions_of(strings.lines(text))
        if module_text.call_places(code: tested, name: f.name).len() == 0
            out @ out.push("`" + f.name + "`")

    return out

# The paths a C emission's `#line` directives name, each once, in order: the
# modules a program reaches, as the compiler names them.
function line_paths(c: str) -> [str]
    out: [str] @= []
    seen: {str: bool} @= {}

    for row in strings.lines(c)
        if !strings.starts_with(text: row, prefix: "#line ")
            continue
        open = strings.index_of(text: row, needle: "\"")

        if open.is_err() || !strings.ends_with(text: row, suffix: "\"") || row.len() - 1 <= open.must()
            continue
        path = row.slice(from: open.must() + 1, to: row.len() - 1)

        if seen[path].is_err()
            seen[path] @ true
            out @ out.push(path)

    return out

# The titles of a module's `test` blocks, as `heroes test` prints them between
# their quotes: each line opening `test "` at column 0, read to its last quote.
function test_titles(text: str) -> [str]
    out: [str] @= []

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "test \"") && strings.ends_with(text: row, suffix: "\"") && row.len() > 7
            out @ out.push(row.slice(from: 6, to: row.len() - 1))

    return out

# The titles a `heroes test` run printed as passed: each line `ok   "<title>"`.
function passed_titles(said: str) -> {str: bool}
    out: {str: bool} @= {}

    for row in strings.lines(said)
        if strings.starts_with(text: row, prefix: "ok   \"") && strings.ends_with(text: row, suffix: "\"") && row.len() > 7
            out[row.slice(from: 6, to: row.len() - 1)] @ true

    return out

## Tests

test "a version is three numbers with no leading zero, and the newest is read number by number"
    assert version_shape("0.1.0")
    assert version_shape("10.20.3")
    assert !version_shape("v0.1.0")
    assert !version_shape("0.1")
    assert !version_shape("01.0.0")
    assert !version_shape("0.1.0.0")
    assert !version_shape("0.1.x")
    assert earlier(a: "0.9.0", b: "0.10.0")
    assert !earlier(a: "0.10.0", b: "0.9.0")
    assert !earlier(a: "1.0.0", b: "1.0.0")
    assert newest(["0.1.0", "0.10.0", "0.9.3"]) == "0.10.0"
    nothing: [str] = []
    assert newest(nothing) == ""

test "a versions file is one `<version> <sum>` a line, each ended, no version twice"
    sum = "sha256-" + "0123456789abcdef".repeat(4.to_u64().must())
    got = versions_read("0.1.0 " + sum + "\n0.2.0 " + sum + "\n").must()
    assert got.len() == 2 && got[1].version == "0.2.0" && got[1].sum == sum
    assert versions_read("").is_err()
    assert versions_read("0.1.0 " + sum).is_err()
    assert versions_read("0.1.0 " + sum + "\n0.1.0 " + sum + "\n").is_err()
    assert versions_read("v0.1.0 " + sum + "\n").is_err()
    assert versions_read("0.1.0 sha256-ABC\n").is_err()
    assert versions_read("0.1.0  " + sum + "\n").is_err()
    assert !sum_shape("sha256-" + "0123456789ABCDEF".repeat(4.to_u64().must()))

test "a listing is sorted by the paths' bytes, and what moved is named once each"
    a = "a".repeat(64.to_u64().must())
    b = "b".repeat(64.to_u64().must())
    listed = listing_of([["strings.hero", a], ["strconv.hero", b], ["strings/internal/scan.hero", a]])
    assert listed == b + "  strconv.hero\n" + a + "  strings.hero\n" + a + "  strings/internal/scan.hero\n"
    assert moved(listed: listed, files: listed).len() == 0
    changed = listing_of([["strings.hero", b], ["strconv.hero", b], ["strings/internal/scan.hero", a], ["new.md", a]])
    assert moved(listed: listed, files: changed) == ["`new.md` is not in the listing", "`strings.hero` is not the file its listing names"]
    gone = listing_of([["strings.hero", a], ["strconv.hero", b]])
    assert moved(listed: listed, files: gone) == ["`strings/internal/scan.hero` is in the listing and not among the files"]

    # The same lines in another order are the same files, written wrong.
    unsorted = a + "  strings.hero\n" + b + "  strconv.hero\n" + a + "  strings/internal/scan.hero\n"
    assert moved(listed: unsorted, files: listed).len() == 1

test "a catalogue of the examples is the verb's: an index line, then each entry's version and sum"
    sum = "sha256-" + "0123456789abcdef".repeat(4.to_u64().must())
    c = catalogue_read(
        "index = \"file://../index\"\n\n[dependencies.core]\nversion = \"0.1.0\"\nsum = \"" + sum + "\"\n"
    ).must()
    assert c.index == "file://../index"
    assert c.entries.len() == 1 && c.entries[0].name == "core" && c.entries[0].version == "0.1.0" && c.entries[0].sum == sum
    assert catalogue_read("[dependencies.core]\npath = \"../packages\"\n").is_err()
    assert catalogue_read("index = \"file://../index\"\n# a comment\n").is_err()
    assert catalogue_read("[dependencies.core]\nversion = \"0.1.0\"\n").is_err()
    assert catalogue_read(
        "[dependencies.core]\nversion = \"0.1.0\"\nversion = \"0.2.0\"\nsum = \"" + sum + "\"\n"
    ).is_err()
    assert quoted_value("sum = \"x\"").must() == "x"
    assert quoted_value("sum = x").is_err()

test "a placed tree's folder writes its entry's name and version, then sixteen hexadecimal digits"
    got = placed_named("core@0.1.0-0123456789abcdef").must()
    assert got.name == "core" && got.version == "0.1.0"
    assert placed_named("core@0.1.0").is_err()
    assert placed_named("core-0.1.0-0123456789abcdef").is_err()
    assert placed_named("core@0.1.0-0123").is_err()

test "every part of a path under a package's root is lower case"
    assert crooked_parts("strings/internal/scan.hero").len() == 0
    assert crooked_parts("strings.md").len() == 0
    assert crooked_parts("Strings.hero") == ["Strings.hero"]
    assert crooked_parts("net/HTTP/client.hero") == ["HTTP"]
    assert crooked_parts("a.b.hero") == ["a.b.hero"]
    assert crooked_parts("x/1st.hero") == ["1st.hero"]
    assert crooked_parts("x/a.Hero") == ["a.Hero"]
    assert module_path(root: "examples/index/core/0.1.0/files", path: "examples/index/core/0.1.0/files/strings/internal/scan.hero") == "strings/internal/scan"

test "two paths that differ only in case are named together"
    assert case_twins(["a/Strings.hero", "a/strings.hero", "b/x.hero"]) == ["`a/Strings.hero` and `a/strings.hero`"]
    assert case_twins(["a/x.hero", "b/x.hero"]).len() == 0
    assert folded("Core/ÉtÉ.hero") == "core/ÉtÉ.hero"

test "a record and a variant are PascalCase, a constant SCREAMING_CASE, indented ones too"
    assert misnamed("record Halves\n    before: str\nconstant MAX_DEPTH: i64\n    3\n").len() == 0
    assert misnamed("record halves\n") == ["line 1: `record halves` is not PascalCase"]
    assert misnamed("variant Http_Verb\n") == ["line 1: `variant Http_Verb` is not PascalCase"]
    assert misnamed("constant MaxDepth: i64\n") == ["line 1: `constant MaxDepth` is not SCREAMING_CASE"]
    assert misnamed("extern \"x.h\"\n    record db tag sqlite3\n") == ["line 2: `record db` is not PascalCase"]
    assert misnamed("# record lower, in prose\n").len() == 0

test "a literal code is snake_case, and a code that is not a literal is not asked"
    assert crooked_codes("return fail(code: \"not_found\", msg: m)\n").len() == 0
    assert crooked_codes("return fail(code: \"NotFound\", msg: m)\n") == ["`fail(code: \"NotFound\"`"]
    assert crooked_codes("return fail(code: \"2bad\", msg: m)\n").len() == 1
    assert crooked_codes("return fail(code: UNIQUE, msg: m)\n").len() == 0

    # A code written through a constant of the module is read for its value.
    assert crooked_codes("constant UNIQUE: str\n    \"unique\"\n\nfunction f() -> i64?\n    return fail(code: UNIQUE, msg: m)\n").len() == 0
    assert crooked_codes("constant BAD: str\n    \"NotSnake\"\n\nfunction f() -> i64?\n    return fail(code: BAD, msg: m)\n") == ["`fail(code: BAD`, whose constant is \"NotSnake\""]

test "a package neither prints, exits nor reads its words, but `log` and `os`"
    text = "function f()\n    print(\"x\")  # print(y)\n    s = \"exit(1)\"\n    _ = s\n\ntest \"t\"\n    _ = args_checked()\n"
    assert noisy(module: "strings", text: text) == ["line 2: `print(`", "line 7: `args_checked(`"]
    assert noisy(module: "log", text: text).len() == 0
    assert noisy(module: "os/internal/exec", text: text).len() == 0
    assert noisy(module: "logs", text: text).len() == 2

test "every top-level function has a doc and a test of its own module that calls it"
    text = "# Doc.\nfunction f() -> i64\n    return 1\n\nfunction g() -> i64\n    return 2\n\n## Heading\nfunction h()\n    _ = 0\n\ntest \"f() and g\"\n    assert f() == 1\n    # g()\n    assert \"g()\" != \"\"\n"
    assert undocumented(text) == ["line 5: `function g`", "line 9: `function h`"]
    assert untested(text) == ["`g`", "`h`"]

test "the `#line` paths of an emission are read once each, in order"
    c = "#line 65 \"main.c\"\n#line 9 \"examples/packages/main.hero\"\n#line 13\n#line 17 \"examples/packages/heroes.packages/core@0.1.0-0123456789abcdef/strings.hero\"\n#line 20 \"examples/packages/heroes.packages/core@0.1.0-0123456789abcdef/strings.hero\"\n"
    assert line_paths(c) == ["main.c", "examples/packages/main.hero", "examples/packages/heroes.packages/core@0.1.0-0123456789abcdef/strings.hero"]

test "a test's title is read as `heroes test` prints it, and only a passed one is passed"
    assert test_titles("test \"a b\"\n    assert true\n\n# test \"not one\"\n    test \"nor this\"\n") == ["a b"]
    passed = passed_titles("ok   \"a b\"\nFAIL \"c\"\n2 tests, 1 failed\n")
    assert !passed["a b"].is_err()
    assert passed["c"].is_err()
