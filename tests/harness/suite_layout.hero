# CLAUDE.md §11's per-file ceiling, enforced instead of remembered.
#
# NOT a port. `layout.rs` walks `crates/**/*.rs`; the compiler is
# `selfhost/*.hero` now, and three things about it change the check
# itself. This is the rewrite panel 085 R4 said it would have to be.
#
# 1. **A Heroes module holds its own tests.** The Rust excluded whole
#    FILES — anything under a `tests/` directory, and any `tests.rs` —
#    because §11's number "governs what a reader must hold in their head,
#    and a test file is read one case at a time". In this language the
#    cases live at the bottom of the module they test, so the exclusion
#    has to be of SECTIONS rather than of files. Measured 2026-08-18, and
#    the difference is the whole check: **30 of 144** files pass 300 lines
#    counted whole, and **17** counted as code.
#
# 2. **The knot rule.** §11 yields entirely where the LANGUAGE forbids the
#    seam: Heroes refuses module cycles (`module_cycle` fires on the `use`
#    edge), and a recursive-descent grammar is mutually recursive by
#    construction — so what is five files in the Rust is one file here,
#    and no cut exists. `grammar_expr.hero` is that file.
#
# 3. **So a bare ceiling would go red on day one**, which is the shape §9
#    calls a rule nobody can obey. What stands instead is a CEILING PER
#    FILE: 300 by default, and for a file already past it the number it
#    measures today. That number is a stop on growth, not an approval —
#    the reasons are the author's to give (DECIDE.md), and until they are
#    given this check says exactly what it knows: this file is this long,
#    and it may not get longer.
#
# `tests/harness/` is excluded the way the Rust excluded `tests/`: it is
# the net, not the compiler.

use report
use shell
use strings

constant COMPILER: str
    "selfhost"

# §11's number. A threshold to think at, not a limit to round.
constant CEILING: i64
    300

# Files already past the ceiling. **A stop on growth rather than a
# licence**: a file here that grows is red, exactly as `toolchain.rs`
# reaching 425 against a decided 400 was red in the Rust.
#
# **RE-BASELINED ONCE, 2026-08-28**, when `selfhost/` became canonical:
# every file went through `heroes fmt --in-place` and `code_lines` stopped
# counting blank lines in the same commit (its own comment carries that
# reason). Both halves of the table's meaning changed at once, so every
# number was re-measured rather than nudged — and the table is the same
# SIZE it was, 16 entries, with five files SMALLER than before and two
# (`cursor.hero`, `source.hero`) dropping out entirely.
#
# This is a re-baseline and not a raise, and the difference is worth
# stating because it is the only thing that keeps the ratchet honest: a
# raise hides the growth of a file somebody edited, and every number here
# moved because the metric and the layout both changed underneath all 165
# files at once. It happens exactly once. From the next commit on, a file
# here that grows is red again.
#
# The one number that WAS raised, four times, on 2026-08-26 and -28:
# `print_fmt.hero` 843 -> 888 -> 903 -> 996 -> 1005 for docs/defects/003,
# docs/defects/004, panel 095 stage 3 and WIDTH 88 -> 120. Raised, never
# split, because the language refuses the only cut available — 003's two
# functions read `power` and `wrapped`, so the seam runs print_bodies ->
# print_fmt -> print_bodies and `module_cycle` fires on the `use` edge
# (§11's knot clause). Four raises in three days is itself the signal, and
# `docs/work/DECIDE.md` is where the author has that question.
constant DECIDED: [str]
    [
        "selfhost/check_walk.hero 1583"
        "selfhost/ir_lower.hero 1483"
        "selfhost/print_fmt.hero 1083"
        "selfhost/grammar_expr.hero 954"
        "selfhost/parse_decl.hero 638"
        "selfhost/ir_print.hero 460"
        "selfhost/ast.hero 449"
        "selfhost/check_builtins.hero 374"
        "selfhost/ir_mono.hero 367"
        "selfhost/emit_ctype.hero 365"
        "selfhost/cli_verbs.hero 358"
        "selfhost/emit_gate.hero 341"
        "selfhost/resolve_cycles.hero 331"
        "selfhost/emit_inst.hero 324"
        "selfhost/modules.hero 320"
        "selfhost/resolve_state.hero 308"
    ]

# Measured 2026-08-18: 144 modules. The floor is the Rust's own idea —
# `assert!(files.len() > 100, "the walk is not reaching the tree")` — and
# it exists because a walk that finds nothing reports green.
constant LEAST: i64
    140

function run_all(scratch: str) -> report.Report?
    r: report.Report @ report.empty()
    files = shell.list_entries(scratch: scratch, dir: COMPILER)?
    modules: [str] @ []

    for path in files
        if strings.ends_with(text: path, suffix: ".hero")
            modules @ modules.push(path)

    if modules.len() < LEAST
        report.keep_failure(
            @r,
            label: "layout",
            detail: "  the walk found " + modules.len().to_str() + " modules and had " + LEAST.to_str() + " — it is not reaching the tree"
        )
    over: [str] @ []

    for path in modules
        text = read_file(path)

        if text.is_err()
            report.keep_failure(@r, label: "layout/" + strings.base_name(path: path), detail: "  cannot read " + path)
            continue
        lines = code_lines(text.must())
        limit = ceiling_for(path)

        if lines > limit
            if limit == CEILING
                over @ over.push(
                    "    " + path + ": " + lines.to_str() + " lines of code, past §11's " + CEILING.to_str()
                )
            else
                over @ over.push(
                    "    " + path + ": " + lines.to_str() + " lines of code, past the " + limit.to_str() + " it measured when this check was written — a file already over the ceiling may not grow further"
                )

    if over.len() > 0
        report.keep_failure(
            @r,
            label: "layout",
            detail: "  CLAUDE.md §11: *split a module before it passes ~300 lines*, because \"the author must be able to open any file and read it without drowning\":\n" + over.join("\n") + "\n  Split along a seam that names a concern, never at a line count. Where the LANGUAGE forbids the seam — a knot of mutually recursive functions, which cannot be two modules because Heroes refuses module cycles — the file stays and its module doc owes a map: the cycle, the entry points, which function calls which."
        )
    else
        report.keep_pass(@r)
    return ok(r)

# The lines a reader must hold in their head: everything outside a `test`
# block, AND NOT A BLANK LINE.
#
# A `test "..."` at column 0 opens one, and the block ends at the next
# line that starts at column 0 and is not a comment — which is the same
# boundary the language uses, since a block is what is indented under its
# header.
#
# BLANK LINES STOPPED COUNTING ON 2026-08-28, and the reason is §11's own
# sentence: this number governs *"what a reader must hold in their head"*,
# and a blank line is the one line nobody holds — it is what makes the
# others holdable. Counting them was harmless while the formatter only
# preserved the author's, and became perverse the day panel 095 had it
# INSERT them: the ceiling would have punished exactly the change made to
# make these files easier to read. Measured the day it changed, over the
# swept `selfhost/`: **36 files past their ceiling counting blanks, 10
# without**, and the re-baselined table is the same SIZE as the old one
# (16 entries) with **five files measuring SMALLER than before** —
# `ast.hero` 495 -> 449, `ir_print.hero` 485 -> 460, `resolve_state.hero`
# 338 -> 308 — and two, `cursor.hero` and `source.hero`, leaving the
# table entirely. That is what says the metric change is not a way to
# hide growth: it moves numbers in both directions.
function code_lines(text: str) -> i64
    count: i64 @ 0
    inside: bool @ false

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "test \"")
            inside @ true
            continue

        if inside && row.len() > 0 && !starts_indented(row) && !strings.starts_with(text: row, prefix: "#")
            inside @ false

        if !inside && strings.trimmed(row).len() > 0
            count @ count + 1

    return count

function starts_indented(row: str) -> bool
    return row[0] == 32 || row[0] == 9

# The ceiling this file is held to: its DECIDED number, or §11's.
function ceiling_for(path: str) -> i64
    for entry in DECIDED
        parts = strings.words(entry)

        if parts.len() == 2 && parts[0] == path
            number = strings.to_number(parts[1])

            if !number.is_err()
                return number.must()

    return CEILING

test "code_lines counts what a reader holds and not the cases"
    program = "function f() -> i64\n    return 1\n\ntest \"one\"\n    assert f() == 1\n    assert true\n\nfunction g() -> i64\n    return 2\n"

    # FOUR: the two functions' four lines and nothing else. It was five
    # until 2026-08-28, the fifth being the blank line before the test —
    # blank lines stopped counting when the formatter started inserting
    # them, and the reason is on `code_lines` itself. What the old comment
    # said about the blank AFTER the test is still true and still the
    # reason this is asserted rather than assumed: a blank line does not
    # close a block, so that one belongs to the case either way.
    assert code_lines(program) == 4
    assert code_lines("function f()\n    print(1)\n") == 2
    assert code_lines("test \"only a test\"\n    assert true\n") == 0

    # And the property the change is FOR, asserted directly: air inside a
    # body costs a reader nothing, so it costs this count nothing.
    dense = "function f() -> i64\n    a = 1\n    b = 2\n    return a + b\n"
    airy = "function f() -> i64\n    a = 1\n\n    b = 2\n\n    return a + b\n"
    assert code_lines(dense) == code_lines(airy)

test "a comment inside a test block does not close it"
    program = "test \"one\"\n    assert true\n# a comment at column 0, still inside the case's paragraph\n    assert true\nfunction after()\n    print(1)\n"
    assert code_lines(program) == 2

test "the ceiling is per file, and a decided file keeps its own"
    assert ceiling_for("selfhost/ir_lower.hero") == 1389
    assert ceiling_for("selfhost/source.hero") == 304
    assert ceiling_for("selfhost/anything-else.hero") == CEILING
    assert DECIDED.len() == 16
