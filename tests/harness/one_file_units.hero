# The units `build` writes for a program whose one file `--emit-c` refuses
# (defect 453, panel 202's R3, 2026-10-10). Since that day `--emit-c` writes
# the whole program as one file only where that file means the program the
# units build, and refuses at exit 1 with `ffi_one_file` elsewhere: two
# modules each binding a `static inline twice` of another type compile one
# unit each and not one file. A suite that asks a property of every run
# golden's C (`determinism`, `lines`) asks it of those units then, never
# passing such a program over.
#
# **The units are found by being new**: the build is run with an `--include`
# of an empty directory of this run's own, which the units' key names and
# their meaning does not, so every unit is compiled cold under `build/tu-…`
# whatever any earlier build left there; the directories that appear under
# `build/` while it runs, and whose unit opens naming this program, are its
# units. A suite running beside it may compile the same program in the same
# moment, and its units are the same text, so finding one of them too
# changes no answer.

use shell
use strings

# The code `--emit-c` refuses its one file with.
constant REFUSED: str
    "error[ffi_one_file]"

# Whether `--emit-c`'s words are the one file's refusal and nothing else's.
function refused_one_file(err: str) -> bool
    return strings.contains(text: err, needle: REFUSED)

# One unit: the file its C is written to, by its name, and its text.
record Unit
    name: str
    text: str

# The units `build` writes for `source`, `tag` naming this emission apart from
# any other the caller asks; sorted by name, the library's among them. Absent,
# with the build's own words, where it did not build, and where it built and
# no unit could be found, which is never read as a pass.
function units_of(scratch: str, compiler: str, source: str, tag: str) -> [Unit]?
    searched = scratch + "/one-file-units-" + tag
    shell.remove_tree(searched)?
    shell.mkdir_all(searched)?
    before = present(scratch)?
    built = shell.run(scratch: scratch, program: compiler, words: [compiler, "build", source, "--include", searched, "-o", scratch + "/one-file-binary-" + tag + shell.exe_suffix()])?

    if built.code != 0
        return fail(code: "unbuilt", msg: "`build " + source + "` exited " + built.code.to_str() + ":\n" + built.err)
    after = shell.list_directories(scratch: scratch, dir: "build")?
    found: {str: Unit} @= {}

    for dir in after
        if before[dir].is_err() && strings.starts_with(text: strings.base_name(dir), prefix: "tu-")
            for file in shell.list_entries(scratch: scratch, dir: dir)?
                if strings.ends_with(text: file, suffix: ".c")
                    text = read_file(file)?

                    if opens_naming(text: text, source: source)
                        found[strings.base_name(file)] @ Unit(name: strings.base_name(file), text: text)

    if found.len() == 0
        return fail(
            code: "no_units",
            msg: "`build " + source + "` built, and no unit it compiled was found under build/, so nothing of it was asked"
        )
    out: [Unit] @= []

    # ORDER: by the unit's file name — the caller compares two emissions
    # unit by unit, and a map gives its keys in no order.
    for name in keys(found).sort()
        out @ out.push(found[name].must())

    return ok(out)

# The directories under `build/` now, as a set.
function present(scratch: str) -> {str: bool}?
    out: {str: bool} @= {}

    if !shell.is_directory("build")
        return ok(out)

    for dir in shell.list_directories(scratch: scratch, dir: "build")?
        out[dir] @ true

    return ok(out)

# Whether a unit's first line names `source`, the program it was emitted
# from (`emit/decls.prelude`: `/* Generated by heroes … from <source>. Do not
# edit. */`).
function opens_naming(text: str, source: str) -> bool
    first = strings.lines(text)

    if first.len() == 0
        return false
    return strings.starts_with(text: first[0], prefix: "/* Generated by heroes ") && strings.contains(text: first[0], needle: " from " + source + ". ")

## Tests

test "a unit is this program's where its first line names it, and the code is the one file's refusal"
    assert opens_naming(
        text: "/* Generated by heroes 0.2.0 from tests/golden/run/a.hero. Do not edit. */\nint x;\n",
        source: "tests/golden/run/a.hero"
    )
    assert !opens_naming(text: "/* Generated by heroes 0.2.0 from tests/golden/run/ab.hero. Do not edit. */\n", source: "tests/golden/run/a.hero")
    assert !opens_naming(text: "", source: "a.hero")
    assert refused_one_file("error[ffi_one_file]: `--emit-c` writes this program as one file")
    assert !refused_one_file("error[ffi_header_refused]: ...")

# The real compiler on two modules whose headers declare one `twice` two ways:
# `--emit-c` refuses the one file, and the units `build` writes are found, one
# per module and the library's, twice alike.
test "the units of a program whose one file is refused are found, alike twice (defect 453)"
    compiler = shell.some_compiler()

    if compiler.is_err()
        return
    scratch = shell.own_scratch()
    planted = planted_two_ways(scratch)
    assert !planted.is_err()
    refused = shell.run(
        scratch: scratch,
        program: compiler.must(),
        words: [compiler.must(), "build", planted.must(), "--emit-c"]
    )
    assert !refused.is_err()
    assert refused.must().code == 1
    assert refused_one_file(refused.must().err)
    one = units_of(scratch: scratch, compiler: compiler.must(), source: planted.must(), tag: "a")
    two = units_of(scratch: scratch, compiler: compiler.must(), source: planted.must(), tag: "b")
    assert why_not(one) == ""
    assert why_not(two) == ""
    names: [str] @= []

    for unit in one.must()
        names @ names.push(unit.name)

    assert names == ["left.c", "library.c", "main.c", "right.c"]
    assert one.must().len() == two.must().len()

    for i in range(from: 0, to: one.must().len())
        assert one.must()[i].text == two.must()[i].text

    assert !shell.remove_tree(scratch).is_err()

# A stand-in compiler whose `build` writes no unit: what it built cannot be
# asked, and that is a refusal, never a pass.
test "a build that writes no unit is no units, never a pass (defect 453)"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    stub = scratch + "/stub-no-units.sh"
    assert !write_file(path: stub, text: "#!/bin/sh\nexit 0\n").is_err()
    assert !shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", stub]).is_err()
    got = units_of(scratch: scratch, compiler: stub, source: "tests/golden/run/exit-status.hero", tag: "none")
    assert got.is_err()
    assert strings.contains(text: why_not(got), needle: "no unit it compiled was found")
    assert !shell.remove_tree(scratch).is_err()

function why_not(got: [Unit]?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# A program of two modules, each binding a `static inline twice` of its own
# type from a header beside it, under `scratch`; its root's path.
function planted_two_ways(scratch: str) -> str?
    dir = scratch + "/one-file-two-ways"
    shell.remove_tree(dir)?
    shell.mkdir_all(dir)?
    write_file(path: dir + "/a.h", text: "static inline long long twice(long long x) { return 2 * x; }\n")?
    write_file(path: dir + "/b.h", text: "static inline int twice(int x) { return x + x; }\n")?
    write_file(path: dir + "/left.hero", text: "extern \"a.h\"\n    function twice(x: i64) -> i64\n\nfunction left(x: i64) -> i64\n    return twice(x: x)\n")?
    write_file(path: dir + "/right.hero", text: "extern \"b.h\"\n    function twice(x: i32) -> i32\n\nfunction right(x: i32) -> i32\n    return twice(x: x)\n")?
    write_file(path: dir + "/main.hero", text: "use left\nuse right\n\nfunction main()\n    print(left.left(x: 3))\n    print(right.right(x: 4))\n")?
    return ok(dir + "/main.hero")
