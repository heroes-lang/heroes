# THE REPORT OF A RUN: the verdicts under `samples/` joined into one JSON Lines
# file and read into the tables a measurement prints (M-thesis-harness,
# 2026-10-20; the shape of `docs/measurements/024-the-corpus-at-one-hundred-and-twenty-files.md`).
#
# One table per (model, arm, context): the samples, how many were green by
# turn 1, 2, 3 and the cap, Wilson's interval on green by turn 3, the buckets
# at the last turn (the three failure classes and the rest), the mean turns to
# green over the converged, the tokens, and the samples left out. **A sample
# the API refused (`api_refusal`), the transport lost past its retries
# (`transport_error`), or whose program `check` accepted and `build` refused
# (`build_failed`, a compiler defect) is outside every denominator**, counted in
# a column of its own and never resampled in silence (panel 226's R5 and its
# adjudication), and a pair either of whose verdicts is out leaves the paired
# contrasts (R8). Then **the flow**, how far each sample's last turn got,
# attempted, answered, extracted, compiled, ran, green, as `docs/metrics/tasks.md`
# names them, so every exclusion and
# every loss is a difference between two columns, an outcome the grader does
# not name counted apart rather than read as a stage; and **the `build_failed`
# samples by key**, each one refiled as a compiler defect, a table R1 expects
# empty.
#
# Then three paired contrasts per (model, context), each over a verdict of two
# arms of one generation matched by the key without its arm, with the cluster
# bootstrap's interval over tasks and McNemar's mid-p over the discordant
# pairs, the exact conditional p beside it (R2): **the primary**, green by turn
# 3, strict minus control; **the first secondary**, silent by turn 3, control
# minus strict; and **the message's value**, green by turn 3, strict (the full
# message) minus brief, over the pairs where either arm saw a refusal (R4). The
# report names the pre-registered primary and calls every other row
# exploratory, so no number is picked after the fact.
#
# **Then the strata** the labels beside the suite name (`thesis_strata.hero`,
# issue 2160): the primary in the tasks `traps.txt` names and in the rest,
# and by the construct classes of `constructs.txt`, each class over its own
# tasks, then the class-weighted difference, every class weighing alike,
# beside the flat one, each with its bootstrap interval; a label that is not
# there is said so, and a verdict the run's `tasks.txt` does not list is
# counted and stands in no stratum.

use json_fields
use json_read
use shell
use strings
use thesis_protocol
use thesis_stats
use thesis_strata
use thesis_verdict

constant TURNS_SHOWN: [i64]
    [1, 2, 3, 5]

constant ROUNDS: i64
    2000

record Group
    model: str
    arm: str
    context_sha: str
    verdicts: [thesis_verdict.Verdict]

# The verdicts under `out/samples/`, read; `out/verdicts.jsonl` written from
# their texts, one a line, by key; the report's Markdown returned.
function report(scratch: str, out: str, seed: i64, primary: str, labels: str) -> str?
    texts = thesis_verdict.all_kept(scratch: scratch, dir: out + "/samples")?

    # A folder with no verdict is told by the count, and nothing is written
    # (defect 2170: the word looked for `0 verdicts under` in the text, which
    # 540 verdicts write too).
    if texts.len() == 0
        return fail(code: "no_verdicts", msg: "no verdict under " + out + "/samples")
    verdicts: [thesis_verdict.Verdict] @= []

    for text in texts
        verdicts @ verdicts.push(thesis_verdict.read_verdict(text)?)

    write_file(path: out + "/verdicts.jsonl", text: texts.join("\n") + "\n")?
    dir: str @= labels

    if dir == ""
        dir @ suite_of(out)
    strata: [str] @= []
    numbers = thesis_strata.numbers_of(out)

    match numbers
        .ok n  => strata @ strata_lines(
            verdicts: verdicts,
            labels: thesis_strata.labels_at(dir)?,
            dir: dir,
            numbers: n,
            seed: seed
        )
        .err e => strata @ ["", "## The strata", "", e.msg + "; the strata are not written."]

    for line in deviation_lines(out: out, dir: dir)
        strata @ strata.push(line)

    return ok(
        rendered(verdicts: verdicts, seed: seed, primary: primary, through: [asked_through(out), capped_at(out), resumed_at(out)].join(" ")) + strata.join("\n") + "\n"
    )

# The run set against the pre-registration beside the suite: the block of
# `prediction.md` the `preregister` word printed, field by protocol field
# against `<out>/provenance.json`, a row for every field that differs.
function deviation_lines(out: str, dir: str) -> [str]
    lines: [str] @= ["", "## Deviations from the pre-registration", ""]
    held = read_file(path: dir + "/prediction.md")

    if held.is_err()
        return lines.push("No `prediction.md` beside " + dir + ", so the run is set against no pre-registration.")
    block = registered_block(held.must())

    if block == ""
        return lines.push(
            "`prediction.md` beside " + dir + " holds no `preregistered` block, the `preregister` word's output, so nothing is set against the run."
        )
    registered = json_read.read_json(block)
    ran = read_file(path: out + "/provenance.json")

    if registered.is_err() || ran.is_err()
        return lines.push(
            "The pre-registration's block or the run's `provenance.json` does not read as JSON, so nothing is set against the run."
        )
    run_doc = json_read.read_json(ran.must())

    if run_doc.is_err()
        return lines.push("The run's `provenance.json` does not read as JSON, so nothing is set against the run.")
    rows: [str] @= []

    for m in thesis_protocol.moved(was: registered.must(), is_now: run_doc.must())
        rows @ rows.push("| `" + m.name + "` | " + m.was + " | " + m.is_now + " |")

    if rows.len() == 0
        return lines.push(
            "None: the run holds every one of the " + thesis_protocol.PROTOCOL.len().to_str() + " protocol fields as the pre-registration did."
        )
    lines @ lines.push("| field | pre-registered | ran |").push("|---|---|---|")

    for row in rows
        lines @ lines.push(row)

    return lines

# The block between a line `` ```preregistered `` and the next fence, or "".
function registered_block(text: str) -> str
    kept: [str] @= []
    inside: bool @= false

    for line in strings.lines(text: text)
        if !inside && strings.trimmed(text: line) == "```preregistered"
            inside @ true
        else if inside && strings.trimmed(text: line) == "```"
            return kept.join("\n")
        else if inside
            kept @ kept.push(line)

    return ""

# The suite folder the run's provenance names, "" where it names none.
function suite_of(out: str) -> str
    held = read_file(path: out + "/provenance.json")

    if held.is_err()
        return ""
    doc = json_read.read_json(held.must())

    if doc.is_err()
        return ""
    return json_fields.text_at(of: doc.must(), name: "suite").default("")

# The strata the labels beside the suite name (`thesis_strata.hero`): the
# primary in the trap tasks and in the rest, and by construct class with the
# class-weighted difference beside the flat one, or a sentence naming the
# label that is missing; a verdict the run's `tasks.txt` does not list is
# counted and stands in no stratum.
function strata_lines(verdicts: [thesis_verdict.Verdict], labels: thesis_strata.Labels, dir: str, numbers: {str: str}, seed: i64) -> [str]
    out: [str] @= []
    unnumbered: i64 @= 0

    for v in verdicts
        if numbers[v.task_sha].is_err()
            unnumbered @ unnumbered + 1

    if unnumbered > 0
        out @ out.push("").push(
            unnumbered.to_str() + " verdicts name a task the run's `tasks.txt` does not list, and stand in no stratum."
        )
    out @ out.push("").push("## The primary by stratum, trap and not").push("")

    if !labels.has_traps
        out @ out.push("No `traps.txt` beside " + dir + ", so the primary is not stratified.")
    else
        trapped: [thesis_verdict.Verdict] @= []
        rest: [thesis_verdict.Verdict] @= []

        for v in verdicts
            number = numbers[v.task_sha].default("")

            if number == ""
                continue

            if thesis_strata.among(word: number, words: labels.traps)
                trapped @ trapped.push(v)
            else
                rest @ rest.push(v)

        for line in contrast_lines(groups: grouped(trapped), title: "### In the trap tasks", note: "The tasks `traps.txt` names, which tempt a plausible mistake on purpose.", first_arm: "control", second_arm: "strict", measure: "green", refused_only: false, seed: seed)
            out @ out.push(line)

        for line in contrast_lines(groups: grouped(rest), title: "### In the other tasks", note: "Every task `traps.txt` does not name.", first_arm: "control", second_arm: "strict", measure: "green", refused_only: false, seed: seed)
            out @ out.push(line)
    out @ out.push("").push("## The primary by construct class").push("")

    if !labels.has_constructs
        out @ out.push("No `constructs.txt` beside " + dir + ", so the primary is not weighed by class.")
        return out
    out @ out.push("Each class over its own tasks, a task of two classes standing in both; then every class weighing alike (panel 009's spec-warden), beside the flat difference, where every pair weighs alike.").push(
        ""
    )
    out @ out.push("| model | context | class | tasks | pairs | strict green@3 | control green@3 | difference | bootstrap 95% |").push(
        "|---|---|---|---|---|---|---|---|---|"
    )
    groups = grouped(verdicts)

    for g in groups
        if g.arm == "strict"
            other = group_of(groups: groups, model: g.model, arm: "control", context_sha: g.context_sha)

            if other.len() > 0
                made = paired(first: other[0], second: g, measure: "green", refused_only: false)

                for line in class_rows(made: made, labels: labels, numbers: numbers, g: g, seed: seed)
                    out @ out.push(line)

    return out

# One (model, context)'s rows: each class its tasks hold, the class-weighted
# difference, and the flat one.
function class_rows(made: Paired, labels: thesis_strata.Labels, numbers: {str: str}, g: Group, seed: i64) -> [str]
    classes: [[str]] @= []

    for cell in made.cells
        classes @ classes.push(thesis_strata.classes_of(labels: labels, number: numbers[cell.task].default("")))

    lead = "| " + g.model + " | " + context_name(g.context_sha) + " | "
    rows: [str] @= []

    for name in thesis_strata.CLASSES
        sub = thesis_stats.in_class(cells: made.cells, classes: classes, name: name)

        if sub.len() > 0
            rows @ rows.push(lead + name + " | " + cell_row(cells: sub, seed: seed))

    weighted = thesis_stats.bootstrap_weighted(cells: made.cells, classes: classes, rounds: ROUNDS, seed: seed)
    rows @ rows.push(
        lead + "class-weighted | " + made.cells.len().to_str() + " | " + made.pairs.to_str() + " | | | " + signed_percent(thesis_stats.class_weighted(cells: made.cells, classes: classes)) + " | " + signed_percent(weighted.low) + " to " + signed_percent(weighted.high) + " |"
    )
    return rows.push(lead + "flat | " + cell_row(cells: made.cells, seed: seed))

# Tasks, pairs, the two arms' greens, the difference and its interval.
function cell_row(cells: [thesis_stats.Cell], seed: i64) -> str
    pairs: i64 @= 0
    seconds: i64 @= 0
    firsts: i64 @= 0

    for cell in cells
        pairs @ pairs + cell.n
        seconds @ seconds + cell.second
        firsts @ firsts + cell.first

    interval = thesis_stats.bootstrap(cells: cells, rounds: ROUNDS, seed: seed)
    return cells.len().to_str() + " | " + pairs.to_str() + " | " + seconds.to_str() + " | " + firsts.to_str() + " | " + signed_percent(thesis_stats.difference(cells)) + " | " + signed_percent(interval.low) + " to " + signed_percent(interval.high) + " |"

# What the rows were asked through, as the run's `provenance.json` names it:
# a harness's rows are a table of their own and never pooled with the API's
# (panel 226's R9), so the report says which it is before its first table.
function asked_through(out: str) -> str
    held = read_file(path: out + "/provenance.json")

    if held.is_err()
        return "Asked through a transport no `provenance.json` names."
    doc = json_read.read_json(held.must())

    if doc.is_err()
        return "Asked through a transport `provenance.json` does not say: it does not read as JSON."
    transport = json_fields.text_at(of: doc.must(), name: "transport").default("api")

    if transport == "claude"
        return "Asked through the `claude -p` harness (" + json_fields.text_at(of: doc.must(), name: "harness").default("") + "), panel 226's route C: a table of its own, never pooled with the API's rows."

    if transport == "codex"
        return "Asked through the `codex exec` harness (" + json_fields.text_at(of: doc.must(), name: "harness").default("") + "), a ChatGPT plan's, on the assistant's tasks alone: a table of its own, never pooled with the API's rows."
    return "Asked through the API."

# The cap of turns the run's provenance names, and what it makes of green@k: a
# cap below three leaves green@2 and green@3 no turn to be green at, so they
# read green at the cap, and the page says so (defect 2171: a one-turn run's
# primary was headed green@3 with nothing to say no third turn was asked).
function capped_at(out: str) -> str
    held = read_file(path: out + "/provenance.json")

    if held.is_err()
        return "No `provenance.json` names the cap of turns."
    doc = json_read.read_json(held.must())

    if doc.is_err()
        return "The cap of turns is not said: `provenance.json` does not read as JSON."
    turns = json_fields.whole_at(of: doc.must(), name: "turns")

    if turns.is_err()
        return "`provenance.json` names no cap of turns."
    n = turns.must()

    if n == 1
        return "Each conversation was capped at 1 turn, so green@2 and green@3 read green@1."

    if n == 2
        return "Each conversation was capped at 2 turns, so green@3 reads green@2."
    return "Each conversation was capped at " + n.to_str() + " turns."

# The days and commits a run was resumed on into its folder, `resumed.txt`'s
# lines, which a resume holding the folder's protocol writes (defect 2180); a
# run asked in one go says so.
function resumed_at(out: str) -> str
    held = read_file(path: out + "/resumed.txt")

    if held.is_err()
        return "Asked in one go."
    told: [str] @= []

    for line in strings.lines(text: held.must())
        words = strings.words(text: line)

        if words.len() == 2
            told @ told.push(words[0] + " at `" + words[1] + "`")

    if told.len() == 0
        return "Asked in one go."

    if told.len() == 1
        return "Resumed once into its folder, its protocol held: " + told[0] + "."
    return "Resumed " + told.len().to_str() + " times into its folder, its protocol held: " + told.join("; ") + "."

function rendered(verdicts: [thesis_verdict.Verdict], seed: i64, primary: str, through: str) -> str
    lines: [str] @= [
        "## What the run read"
        ""
        verdicts.len().to_str() + " verdicts under `samples/`, joined into `verdicts.jsonl`; the bootstrap's seed is " + seed.to_str() + ", " + ROUNDS.to_str() + " resamples over the tasks."
        ""
        through
        ""
        "Prompt tokens are every turn's input, cache reads and cache writes together; tokens out hold the thinking with the answer. A loud failure is an abort, a crash or a timeout."
        ""
    ]
    groups = grouped(verdicts)
    lines @ lines.push(
        "| model | arm | context | n | green@1 | green@2 | green@3 | green@cap | Wilson 95% on green@3 | converged | mean turns to green | compile_error | loud (abort, crash, timeout) | silent | other | out: refusal / transport / build | prompt tokens | tokens out |"
    )
    lines @ lines.push("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")

    for g in groups
        lines @ lines.push(row_of(g))

    for line in flow_lines(groups)
        lines @ lines.push(line)

    for line in build_failed_lines(groups)
        lines @ lines.push(line)

    for line in contrast_lines(groups: groups, title: "## The primary: green@3, strict minus control", note: "The primary is " + primary + "; every other row is exploratory.", first_arm: "control", second_arm: "strict", measure: "green", refused_only: false, seed: seed)
        lines @ lines.push(line)

    for line in contrast_lines(groups: groups, title: "## The first secondary: silent@3, control minus strict", note: "Silent is a program that ran to exit 0 with the wrong output at turn 3, or at the turn its conversation ended before it (R3); exploratory, read beside the primary.", first_arm: "strict", second_arm: "control", measure: "silent", refused_only: false, seed: seed)
        lines @ lines.push(line)

    for line in contrast_lines(groups: groups, title: "## The message's value: green@3, strict minus brief, over the pairs where either arm saw a refusal", note: "The full message against the one-line form (design.md §4.17), over the pairs a message could reach (R4); exploratory.", first_arm: "brief", second_arm: "strict", measure: "green", refused_only: true, seed: seed)
        lines @ lines.push(line)

    return lines.join("\n") + "\n"

# One contrast's table: a row per (model, context) where both arms ran.
function contrast_lines(groups: [Group], title: str, note: str, first_arm: str, second_arm: str, measure: str, refused_only: bool, seed: i64) -> [str]
    out: [str] @= [
        ""
        title
        ""
        note
        ""
        "| model | context | pairs | " + second_arm + " " + measure + "@3 | " + first_arm + " " + measure + "@3 | difference | bootstrap 95% | discordant (" + second_arm + " only / " + first_arm + " only) | McNemar mid-p (exact beside) |"
        "|---|---|---|---|---|---|---|---|---|"
    ]

    for g in groups
        if g.arm == second_arm
            other = group_of(groups: groups, model: g.model, arm: first_arm, context_sha: g.context_sha)

            if other.len() > 0
                out @ out.push(
                    paired_row(first: other[0], second: g, measure: measure, refused_only: refused_only, seed: seed)
                )

    return out

function grouped(verdicts: [thesis_verdict.Verdict]) -> [Group]
    groups: [Group] @= []

    for v in verdicts
        placed: bool @= false

        for i in range(from: 0, to: groups.len())
            if groups[i].model == v.model && groups[i].arm == v.arm && groups[i].context_sha == v.context_sha
                groups[i].verdicts @ groups[i].verdicts.push(v)
                placed @ true

        if !placed
            groups @ groups.push(Group(model: v.model, arm: v.arm, context_sha: v.context_sha, verdicts: [v]))

    return groups

function group_of(groups: [Group], model: str, arm: str, context_sha: str) -> [Group]
    found: [Group] @= []

    for g in groups
        if g.model == model && g.arm == arm && g.context_sha == context_sha
            found @ found.push(g)

    return found

# Whether a verdict was green by turn `k`.
function green_by(v: thesis_verdict.Verdict, k: i64) -> bool
    return v.green_turn > 0 && v.green_turn <= k

function greens_by(g: Group, k: i64) -> i64
    count: i64 @= 0

    for v in g.verdicts
        if !excluded(v) && green_by(v: v, k: k)
            count @ count + 1

    return count

# Whether a verdict is outside every denominator: the API refused the answer,
# the transport lost the request past its retries (R5), or `build` refused what
# `check` accepted, a compiler defect and never the program's (the adjudication).
function excluded(v: thesis_verdict.Verdict) -> bool
    if v.turns.len() == 0
        return false
    last = v.turns[v.turns.len() - 1].outcome
    return last == "api_refusal" || last == "transport_error" || last == "build_failed"

# How far a last turn got: 0 attempted and not answered, 1 answered and no program
# taken, 2 a program the arm refused, 3 compiled and not run to an end, 4 run to
# an end and wrong, 5 green; -1 an outcome the grader does not name.
function stage_of(outcome: str) -> i64
    if outcome == "api_refusal" || outcome == "transport_error"
        return 0

    if outcome == "no_program" || outcome == "format_slip" || outcome == "truncated"
        return 1

    if outcome == "compile_error" || outcome == "refused_extern" || outcome == "hole" || outcome == "build_failed"
        return 2

    if outcome == "timeout" || outcome == "crash"
        return 3

    if outcome == "compiled_wrong" || outcome == "abort"
        return 4

    if outcome == "cases_pass"
        return 5
    return -1

# The flow, one row per (model, arm, context): how many samples reached each
# stage at their last turn.
function flow_lines(groups: [Group]) -> [str]
    lines: [str] @= [
        ""
        "## The flow: how far each sample's last turn got"
        ""
        "Every sample is counted once, by its last turn. A stage's count holds the samples that reached it, so a sample left out (`api_refusal`, `transport_error`, `build_failed`) and a sample lost to a failure are the difference between two columns; an outcome the grader does not name is counted in the last column and in no stage."
        ""
        "| model | arm | context | attempted | answered | extracted | compiled | ran | green | unnamed outcome |"
        "|---|---|---|---|---|---|---|---|---|---|"
    ]

    for g in groups
        lines @ lines.push(flow_row(g))

    return lines

function flow_row(g: Group) -> str
    reached: [i64] @= [0, 0, 0, 0, 0, 0]
    unnamed: i64 @= 0

    for v in g.verdicts
        stage = stage_of(v.turns[v.turns.len() - 1].outcome)

        if stage < 0
            unnamed @ unnamed + 1
        else
            for k in range(from: 0, to: stage + 1)
                reached[k] @ reached[k] + 1

    return "| " + g.model + " | " + g.arm + " | " + context_name(g.context_sha) + " | " + g.verdicts.len().to_str() + " | " + reached[1].to_str() + " | " + reached[2].to_str() + " | " + reached[3].to_str() + " | " + reached[4].to_str() + " | " + reached[5].to_str() + " | " + unnamed.to_str() + " |"

# The samples `build` refused after `check` accepted them, by key: each is
# refiled as a compiler defect, and R1 expects none.
function build_failed_lines(groups: [Group]) -> [str]
    lines: [str] @= [
        ""
        "## `build_failed`: refiled as compiler defects"
        ""
    ]
    found: [str] @= []

    for g in groups
        for v in g.verdicts
            if v.turns[v.turns.len() - 1].outcome == "build_failed"
                found @ found.push("| " + v.key + " | " + v.turns.len().to_str() + " |")

    if found.len() == 0
        lines @ lines.push("None: no program `check` accepted was refused by `build`, which panel 226's R1 expects.")
        return lines
    lines @ lines.push(
        found.len().to_str() + " samples, outside every denominator; each is a compiler defect to file with its program."
    )
    lines @ lines.push("")
    lines @ lines.push("| key | turn |")
    lines @ lines.push("|---|---|")

    for row in found
        lines @ lines.push(row)

    return lines

# Whether a verdict was silent by turn `k`: not green, and the turn it stood
# at, `k` or the last before it, ran to exit 0 with the wrong output (R3).
function silent_by(v: thesis_verdict.Verdict, k: i64) -> bool
    if green_by(v: v, k: k)
        return false
    at: i64 @= k

    if v.turns.len() < at
        at @ v.turns.len()

    if at == 0
        return false
    return v.turns[at - 1].outcome == "compiled_wrong"

# Whether any turn of a verdict was refused by the compiler: a message reached it.
function saw_refusal(v: thesis_verdict.Verdict) -> bool
    for t in v.turns
        if t.outcome == "compile_error" || t.outcome == "hole"
            return true

    return false

function measured(v: thesis_verdict.Verdict, measure: str) -> bool
    if measure == "silent"
        return silent_by(v: v, k: 3)
    return green_by(v: v, k: 3)

function row_of(g: Group) -> str
    n: i64 @= 0
    refused: i64 @= 0
    lost: i64 @= 0
    broken: i64 @= 0
    compile_errors: i64 @= 0
    aborts: i64 @= 0
    silent: i64 @= 0
    other: i64 @= 0
    converged: i64 @= 0
    turns_sum: i64 @= 0
    tokens_in: i64 @= 0
    tokens_out: i64 @= 0

    for v in g.verdicts
        last = v.turns[v.turns.len() - 1].outcome

        for t in v.turns
            tokens_in @ tokens_in + t.input + t.cache_read + t.cache_write
            tokens_out @ tokens_out + t.output

        if last == "api_refusal"
            refused @ refused + 1
            continue

        if last == "transport_error"
            lost @ lost + 1
            continue

        if last == "build_failed"
            broken @ broken + 1
            continue
        n @ n + 1

        if v.converged
            converged @ converged + 1
            turns_sum @ turns_sum + v.green_turn
        else if last == "compile_error" || last == "hole"
            compile_errors @ compile_errors + 1
        else if last == "abort" || last == "crash" || last == "timeout"
            aborts @ aborts + 1
        else if last == "compiled_wrong"
            silent @ silent + 1
        else
            other @ other + 1

    interval = thesis_stats.wilson(k: greens_by(g: g, k: 3), n: n)
    mean: str @= "n/a"

    if converged > 0
        mean @ tenths(numerator: turns_sum * 10, denominator: converged)
    return "| " + g.model + " | " + g.arm + " | " + context_name(g.context_sha) + " | " + n.to_str() + " | " + greens_by(g: g, k: 1).to_str() + " | " + greens_by(g: g, k: 2).to_str() + " | " + greens_by(g: g, k: 3).to_str() + " | " + converged.to_str() + " | " + thesis_stats.percent(interval.low) + " to " + thesis_stats.percent(interval.high) + " | " + converged.to_str() + " | " + mean + " | " + compile_errors.to_str() + " | " + aborts.to_str() + " | " + silent.to_str() + " | " + other.to_str() + " | " + refused.to_str() + " / " + lost.to_str() + " / " + broken.to_str() + " | " + tokens_in.to_str() + " | " + tokens_out.to_str() + " |"

# `numerator / denominator` with one decimal, the numerator already times ten.
function tenths(numerator: i64, denominator: i64) -> str
    scaled = (numerator + denominator / 2) / denominator
    return (scaled / 10).to_str() + "." + (scaled % 10).to_str()

function context_name(sha: str) -> str
    if sha == ""
        return "none"
    return sha.slice(from: 0, to: 8)

# One paired contrast between two arms of one (model, context): a verdict of
# each arm of one generation, matched by the key without its arm; `measure` is
# `green` or `silent` by turn 3, and the difference is `second` minus `first`.
# A pair either of whose verdicts is excluded is left out (R8), and
# `refused_only` keeps the pairs where either arm saw a refusal (R4).
# The pairs two arms' verdicts make, one generation each: how many, how many
# of each arm the measure holds, the discordant both ways, and a cell a task.
record Paired
    pairs: i64
    b: i64
    c: i64
    second_count: i64
    first_count: i64
    cells: [thesis_stats.Cell]

function paired(first: Group, second: Group, measure: str, refused_only: bool) -> Paired
    b: i64 @= 0
    c: i64 @= 0
    pairs: i64 @= 0
    second_count: i64 @= 0
    first_count: i64 @= 0
    cells: [thesis_stats.Cell] @= []

    for s in second.verdicts
        base = strings.without_suffix(text: s.key, suffix: "." + second.arm)

        for w in first.verdicts
            if strings.without_suffix(text: w.key, suffix: "." + first.arm) != base
                continue

            if excluded(s) || excluded(w)
                continue

            if refused_only && !saw_refusal(s) && !saw_refusal(w)
                continue
            pairs @ pairs + 1
            in_second = measured(v: s, measure: measure)
            in_first = measured(v: w, measure: measure)

            if in_second
                second_count @ second_count + 1

            if in_first
                first_count @ first_count + 1

            if in_second && !in_first
                b @ b + 1

            if in_first && !in_second
                c @ c + 1
            cells @ added(cells: cells, task: s.task_sha, first: in_first, second: in_second)

    return Paired(pairs: pairs, b: b, c: c, second_count: second_count, first_count: first_count, cells: cells)

function paired_row(first: Group, second: Group, measure: str, refused_only: bool, seed: i64) -> str
    made = paired(first: first, second: second, measure: measure, refused_only: refused_only)
    pairs = made.pairs
    b = made.b
    c = made.c
    second_count = made.second_count
    first_count = made.first_count
    cells = made.cells

    if pairs == 0
        return "| " + second.model + " | " + context_name(second.context_sha) + " | 0 | | | | | | |"
    difference = thesis_stats.difference(cells)
    interval = thesis_stats.bootstrap(cells: cells, rounds: ROUNDS, seed: seed)
    p: str @= thesis_stats.p_written(thesis_stats.mcnemar_midp(b: b, c: c)) + " (exact " + thesis_stats.p_written(thesis_stats.mcnemar(b: b, c: c)) + ")"

    if b + c == 0
        p @ "no discordant pair"
    return "| " + second.model + " | " + context_name(second.context_sha) + " | " + pairs.to_str() + " | " + second_count.to_str() + " | " + first_count.to_str() + " | " + signed_percent(difference) + " | " + signed_percent(interval.low) + " to " + signed_percent(interval.high) + " | " + b.to_str() + " / " + c.to_str() + " | " + p + " |"

function added(cells: [thesis_stats.Cell], task: str, first: bool, second: bool) -> [thesis_stats.Cell]
    out: [thesis_stats.Cell] @= cells
    one: i64 @= 0
    two: i64 @= 0

    if first
        one @ 1

    if second
        two @ 1

    for i in range(from: 0, to: out.len())
        if out[i].task == task
            out[i].first @ out[i].first + one
            out[i].second @ out[i].second + two
            out[i].n @ out[i].n + 1
            return out

    return out.push(thesis_stats.Cell(task: task, first: one, second: two, n: 1))

# A difference of rates as signed percentage points.
function signed_percent(x: f64) -> str
    if x < 0.0
        return "-" + thesis_stats.percent(0.0 - x) + "pp"
    return "+" + thesis_stats.percent(x) + "pp"

test "the report groups verdicts, counts greens by turn and buckets, and pairs the arms for the contrast"
    verdicts: [thesis_verdict.Verdict] @= []

    for i in range(from: 0, to: 6)
        task = "task" + i.to_str() + "0000000000"
        s_green: i64 @= 1
        c_green: i64 @= 0

        if i >= 4
            s_green @ 0

        if i % 3 == 0
            c_green @ 2
        verdicts @ verdicts.push(verdict_of(task: task, arm: "strict", green: s_green, last: "cases_pass"))
        verdicts @ verdicts.push(verdict_of(task: task, arm: "control", green: c_green, last: "compiled_wrong"))

    text = rendered(
        verdicts: verdicts,
        seed: 7,
        primary: "strict minus control on claude-haiku-5-5 in the spec context",
        through: "Asked through the API."
    )
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | strict | 21226405 | 6 | 4 | 4 | 4 | 4 |")
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | control | 21226405 | 6 | 0 | 2 | 2 | 2 |")
    assert strings.contains(text: text, needle: "| 6 | 4 | 2 | +33.3pp |")
    assert strings.contains(text: text, needle: "| 2 / 0 | 0.250 (exact 0.500) |")
    assert strings.contains(text: text, needle: "The primary is strict minus control")
    assert tenths(numerator: 70, denominator: 4) == "1.8"
    assert signed_percent(-0.125) == "-12.5pp"
    assert signed_percent(0.5) == "+50.0pp"

function verdict_of(task: str, arm: str, green: i64, last: str) -> thesis_verdict.Verdict
    turns: [thesis_verdict.Turn] @= []
    count: i64 @= green

    if count == 0
        count @ 1

    for t in range(from: 0, to: count)
        outcome: str @= last

        if green > 0 && t == count - 1
            outcome @ "cases_pass"
        else if green > 0
            outcome @ "compile_error"
        turns @ turns.push(
            thesis_verdict.Turn(outcome: outcome, codes: [], stop: "end_turn", input: 100, output: 50, cache_read: 0, cache_write: 0)
        )

    return thesis_verdict.Verdict(
        key: thesis_verdict.verdict_key(task_sha: task, model: "claude-haiku-5-5", context_sha: "212264059c985c2e", sample: 1, arm: arm),
        task_sha: task,
        model: "claude-haiku-5-5",
        arm: arm,
        context_sha: "212264059c985c2e",
        sample: 1,
        turns: turns,
        green_turn: green,
        converged: green > 0
    )

test "a folder of ten verdicts is reported, and a folder of none fails by its code, never by a phrase of the text"
    scratch = shell.own_scratch()
    out = scratch + "/ten"

    for i in range(from: 0, to: 5)
        for arm in ["strict", "control"]
            v = verdict_of(task: "task" + i.to_str() + "0000000000", arm: arm, green: 1, last: "cases_pass")
            thesis_verdict.keep(dir: out + "/samples", key: v.key, text: thesis_verdict.written_verdict(v)).must()

    text = report(scratch: scratch, out: out, seed: 1, primary: "strict minus control", labels: "").must()
    assert strings.contains(text: text, needle: "10 verdicts under")
    assert !read_file(path: out + "/verdicts.jsonl").is_err()
    empty = report(scratch: scratch, out: scratch + "/none", seed: 1, primary: "", labels: "")

    match empty
        .ok _ => assert false
        .err e =>
            assert e.code == "no_verdicts"
            assert e.msg == "no verdict under " + scratch + "/none/samples"

    assert read_file(path: scratch + "/none/verdicts.jsonl").is_err()

test "the excluded leave n and the pairs, silence is read by turn 3, and the message's value is read over the pairs a message reached"
    verdicts: [thesis_verdict.Verdict] = [
        verdict_turns(task: "task0aaaaaaaaaa", arm: "strict", outcomes: ["cases_pass"])
        verdict_turns(task: "task0aaaaaaaaaa", arm: "brief", outcomes: ["compile_error", "cases_pass"])
        verdict_turns(task: "task0aaaaaaaaaa", arm: "control", outcomes: ["compiled_wrong"])
        verdict_turns(task: "task1aaaaaaaaaa", arm: "strict", outcomes: ["compile_error", "cases_pass"])
        verdict_turns(task: "task1aaaaaaaaaa", arm: "brief", outcomes: ["compile_error", "compile_error", "compile_error"])
        verdict_turns(task: "task1aaaaaaaaaa", arm: "control", outcomes: ["cases_pass"])
        verdict_turns(task: "task2aaaaaaaaaa", arm: "strict", outcomes: ["transport_error"])
        verdict_turns(task: "task2aaaaaaaaaa", arm: "brief", outcomes: ["cases_pass"])
        verdict_turns(task: "task2aaaaaaaaaa", arm: "control", outcomes: ["compiled_wrong"])
        verdict_turns(task: "task3aaaaaaaaaa", arm: "strict", outcomes: ["compiled_wrong"])
        verdict_turns(task: "task3aaaaaaaaaa", arm: "brief", outcomes: ["compiled_wrong"])
        verdict_turns(task: "task3aaaaaaaaaa", arm: "control", outcomes: ["abort"])
    ]
    text = rendered(verdicts: verdicts, seed: 7, primary: "the test's", through: "Asked through the API.")
    assert strings.contains(text: text, needle: "resamples over the tasks.\n\nAsked through the API.\n\n")

    # The strict arm: four samples, one lost, so n is three and two are green.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | strict | 21226405 | 3 | 1 | 2 | 2 | 2 |")
    assert strings.contains(text: text, needle: "| 0 / 1 / 0 | ")

    # The primary over the three pairs left: strict 2, control 1, one discordant.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | 3 | 2 | 1 | +33.3pp |")
    assert strings.contains(text: text, needle: "| 1 / 0 | 0.500 (exact 1.000) |")

    # Silence: control silent on task0, strict on task3; no difference.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | 3 | 1 | 1 | +0.0pp |")

    # The message's value: task0 and task1 saw a refusal, task2 is out, task3 saw none.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | 2 | 2 | 1 | +50.0pp |")
    assert excluded(verdicts[6])
    assert !excluded(verdicts[0])
    assert silent_by(v: verdicts[2], k: 3)
    assert !silent_by(v: verdicts[3], k: 3)

function verdict_turns(task: str, arm: str, outcomes: [str]) -> thesis_verdict.Verdict
    turns: [thesis_verdict.Turn] @= []
    green: i64 @= 0

    for i in range(from: 0, to: outcomes.len())
        turns @ turns.push(
            thesis_verdict.Turn(outcome: outcomes[i], codes: [], stop: "end_turn", input: 100, output: 50, cache_read: 0, cache_write: 0)
        )

        if outcomes[i] == "cases_pass" && green == 0
            green @ i + 1

    return thesis_verdict.Verdict(
        key: thesis_verdict.verdict_key(task_sha: task, model: "claude-haiku-5-5", context_sha: "212264059c985c2e", sample: 1, arm: arm),
        task_sha: task,
        model: "claude-haiku-5-5",
        arm: arm,
        context_sha: "212264059c985c2e",
        sample: 1,
        turns: turns,
        green_turn: green,
        converged: green > 0
    )

test "the flow counts every sample once by how far its last turn got, a build refused after check is left out and listed, and an outcome nobody names is counted apart"
    verdicts: [thesis_verdict.Verdict] = [
        verdict_turns(task: "task0aaaaaaaaaa", arm: "strict", outcomes: ["api_refusal"])
        verdict_turns(task: "task1aaaaaaaaaa", arm: "strict", outcomes: ["transport_error"])
        verdict_turns(task: "task2aaaaaaaaaa", arm: "strict", outcomes: ["no_program"])
        verdict_turns(task: "task3aaaaaaaaaa", arm: "strict", outcomes: ["compile_error"])
        verdict_turns(task: "task4aaaaaaaaaa", arm: "strict", outcomes: ["compile_error", "build_failed"])
        verdict_turns(task: "task5aaaaaaaaaa", arm: "strict", outcomes: ["timeout"])
        verdict_turns(task: "task6aaaaaaaaaa", arm: "strict", outcomes: ["abort"])
        verdict_turns(task: "task7aaaaaaaaaa", arm: "strict", outcomes: ["compiled_wrong"])
        verdict_turns(task: "task8aaaaaaaaaa", arm: "strict", outcomes: ["compile_error", "cases_pass"])
        verdict_turns(task: "task9aaaaaaaaaa", arm: "strict", outcomes: ["something_else"])
    ]
    text = rendered(verdicts: verdicts, seed: 7, primary: "the test's", through: "Asked through the API.")

    # Ten attempted; seven answered (two left out, one unnamed); six extracted
    # (no program); four compiled (a refusal, a build refused); three ran to an
    # end (a timeout); one green.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | strict | 21226405 | 10 | 7 | 6 | 4 | 3 | 1 | 1 |")

    # The build refused after check is outside n, which is the ten less three.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | strict | 21226405 | 7 | 0 | 1 | 1 | 1 |")
    assert strings.contains(text: text, needle: "| 1 / 1 / 1 | ")
    assert strings.contains(text: text, needle: "1 samples, outside every denominator")
    assert strings.contains(text: text, needle: "| " + verdicts[4].key + " | 2 |")
    assert excluded(verdicts[4])
    assert stage_of("something_else") == -1
    assert stage_of("cases_pass") == 5

    clean = rendered(verdicts: [verdicts[8]], seed: 7, primary: "the test's", through: "Asked through the API.")
    assert strings.contains(text: clean, needle: "None: no program `check` accepted was refused by `build`")

test "the report says what its rows were asked through, from the run's provenance, and says so where none names it"
    scratch = shell.own_scratch()
    assert asked_through(scratch) == "Asked through a transport no `provenance.json` names."
    write_file(
        path: scratch + "/provenance.json",
        text: "{\"transport\":\"claude\",\"harness\":\"2.1.292 (Claude Code)\"}"
    ).must()
    assert strings.contains(
        text: asked_through(scratch),
        needle: "the `claude -p` harness (2.1.292 (Claude Code)), panel 226's route C"
    )
    write_file(
        path: scratch + "/provenance.json",
        text: "{\"transport\":\"codex\",\"harness\":\"codex-cli 0.163.0\"}"
    ).must()
    assert strings.contains(
        text: asked_through(scratch),
        needle: "the `codex exec` harness (codex-cli 0.163.0), a ChatGPT plan's, on the assistant's tasks alone"
    )
    write_file(path: scratch + "/provenance.json", text: "{\"transport\":\"api\"}").must()
    assert asked_through(scratch) == "Asked through the API."

    # A run's provenance from before the field was written was the API's, the one transport there was.
    write_file(path: scratch + "/provenance.json", text: "{\"schema\":1}").must()
    assert asked_through(scratch) == "Asked through the API."
    write_file(path: scratch + "/provenance.json", text: "not json").must()
    assert strings.contains(text: asked_through(scratch), needle: "does not read as JSON")

test "the report names the run's cap of turns, and what a cap below three makes of green@2 and green@3"
    scratch = shell.own_scratch()
    assert capped_at(scratch) == "No `provenance.json` names the cap of turns."
    write_file(path: scratch + "/provenance.json", text: "{\"turns\":1}").must()
    assert capped_at(scratch) == "Each conversation was capped at 1 turn, so green@2 and green@3 read green@1."
    write_file(path: scratch + "/provenance.json", text: "{\"turns\":2}").must()
    assert capped_at(scratch) == "Each conversation was capped at 2 turns, so green@3 reads green@2."
    write_file(path: scratch + "/provenance.json", text: "{\"turns\":5}").must()
    assert capped_at(scratch) == "Each conversation was capped at 5 turns."
    write_file(path: scratch + "/provenance.json", text: "{\"schema\":1}").must()
    assert capped_at(scratch) == "`provenance.json` names no cap of turns."
    write_file(path: scratch + "/provenance.json", text: "not json").must()
    assert strings.contains(text: capped_at(scratch), needle: "does not read as JSON")

test "the report says on which days and commits a run was resumed into its folder, and that a run with none was asked in one go"
    scratch = shell.own_scratch()
    assert resumed_at(scratch) == "Asked in one go."
    write_file(path: scratch + "/resumed.txt", text: "2026-10-21 10e27a55b\n").must()
    assert resumed_at(scratch) == "Resumed once into its folder, its protocol held: 2026-10-21 at `10e27a55b`."
    write_file(path: scratch + "/resumed.txt", text: "2026-10-21 aaaa\n2026-10-22 bbbb\n").must()
    assert resumed_at(scratch) == "Resumed 2 times into its folder, its protocol held: 2026-10-21 at `aaaa`; 2026-10-22 at `bbbb`."

test "a row's prompt tokens hold the cache's reads and writes beside the input, and a timeout is counted loud"
    cached = thesis_verdict.Turn(
        outcome: "cases_pass",
        codes: [],
        stop: "end_turn",
        input: 100,
        output: 50,
        cache_read: 1000,
        cache_write: 10
    )
    timed = thesis_verdict.Turn(
        outcome: "timeout",
        codes: [],
        stop: "end_turn",
        input: 7,
        output: 3,
        cache_read: 0,
        cache_write: 0
    )
    green = thesis_verdict.Verdict(
        key: thesis_verdict.verdict_key(task_sha: "taskaaaaaaaaaaaa", model: "claude-haiku-5-5", context_sha: "212264059c985c2e", sample: 1, arm: "strict"),
        task_sha: "taskaaaaaaaaaaaa",
        model: "claude-haiku-5-5",
        arm: "strict",
        context_sha: "212264059c985c2e",
        sample: 1,
        turns: [cached],
        green_turn: 1,
        converged: true
    )
    slow = thesis_verdict.Verdict(
        key: thesis_verdict.verdict_key(task_sha: "taskbbbbbbbbbbbb", model: "claude-haiku-5-5", context_sha: "212264059c985c2e", sample: 1, arm: "strict"),
        task_sha: "taskbbbbbbbbbbbb",
        model: "claude-haiku-5-5",
        arm: "strict",
        context_sha: "212264059c985c2e",
        sample: 1,
        turns: [timed],
        green_turn: 0,
        converged: false
    )
    text = rendered(verdicts: [green, slow], seed: 7, primary: "the test's", through: "Asked through the API.")
    assert strings.contains(text: text, needle: "| prompt tokens | tokens out |")
    assert strings.contains(text: text, needle: "| loud (abort, crash, timeout) |")

    # 100 + 1,000 + 10 and 7 in; 50 and 3 out; the timeout one loud failure.
    assert strings.contains(text: text, needle: "| 0 | 1 | 0 | 0 | 0 / 0 / 0 | 1117 | 53 |")

test "the primary is stratified by traps.txt and weighed by constructs.txt, on hand-computed numbers"
    verdicts: [thesis_verdict.Verdict] @= []

    # A, a record task: strict green in all three samples, control in none.
    for s in range(from: 1, to: 4)
        verdicts @ verdicts.push(sampled(task: "taskAaaaaaaaaaa", arm: "strict", sample: s, green: true)).push(
            sampled(task: "taskAaaaaaaaaaa", arm: "control", sample: s, green: false)
        )

    # B, a map task: each arm green in the first of two samples.
    verdicts @ verdicts.push(sampled(task: "taskBaaaaaaaaaa", arm: "strict", sample: 1, green: true)).push(
        sampled(task: "taskBaaaaaaaaaa", arm: "control", sample: 1, green: true)
    )
    verdicts @ verdicts.push(sampled(task: "taskBaaaaaaaaaa", arm: "strict", sample: 2, green: false)).push(
        sampled(task: "taskBaaaaaaaaaa", arm: "control", sample: 2, green: false)
    )

    # C, both classes: every sample green in both arms.
    for s in range(from: 1, to: 3)
        verdicts @ verdicts.push(sampled(task: "taskCaaaaaaaaaa", arm: "strict", sample: s, green: true)).push(
            sampled(task: "taskCaaaaaaaaaa", arm: "control", sample: s, green: true)
        )

    numbers: {str: str} = {"taskAaaaaaaaaaa": "01", "taskBaaaaaaaaaa": "02", "taskCaaaaaaaaaa": "03"}
    labels = thesis_strata.Labels(
        has_traps: true,
        traps: ["01"],
        has_constructs: true,
        numbers: ["01", "02", "03"],
        classes: [["record"], ["map"], ["record", "map"]]
    )
    text = strata_lines(verdicts: verdicts, labels: labels, dir: "tests/thesis", numbers: numbers, seed: 7).join("\n")

    # The trap task A alone: strict 3 of 3, control 0. The others, B and C: 3 and 3 of 4.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | 3 | 3 | 0 | +100.0pp |")
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | 4 | 3 | 3 | +0.0pp |")

    # Records over A and C, (5 - 2) / 5; maps over B and C, (3 - 3) / 4; their
    # mean 0.3; the flat (6 - 3) / 7.
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | record | 2 | 5 | 5 | 2 | +60.0pp |")
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | map | 2 | 4 | 3 | 3 | +0.0pp |")
    assert strings.contains(
        text: text,
        needle: "| claude-haiku-5-5 | 21226405 | class-weighted | 3 | 7 | | | +30.0pp |"
    )
    assert strings.contains(text: text, needle: "| claude-haiku-5-5 | 21226405 | flat | 3 | 7 | 6 | 3 | +42.9pp |")
    none: [str] = []
    no_classes: [[str]] = []
    bare = strata_lines(verdicts: verdicts, labels: thesis_strata.Labels(has_traps: false, traps: none, has_constructs: false, numbers: none, classes: no_classes), dir: "x", numbers: numbers, seed: 7).join(
        "\n"
    )
    assert strings.contains(text: bare, needle: "No `traps.txt` beside x")
    assert strings.contains(text: bare, needle: "No `constructs.txt` beside x")
    only_a: {str: str} = {"taskAaaaaaaaaaa": "01"}
    unlisted = strata_lines(verdicts: verdicts, labels: labels, dir: "x", numbers: only_a, seed: 7).join("\n")
    assert strings.contains(text: unlisted, needle: "8 verdicts name a task the run's `tasks.txt` does not list")

function sampled(task: str, arm: str, sample: i64, green: bool) -> thesis_verdict.Verdict
    outcome: str @= "compiled_wrong"
    turn: i64 @= 0

    if green
        outcome @ "cases_pass"
        turn @ 1
    return thesis_verdict.Verdict(
        key: thesis_verdict.verdict_key(task_sha: task, model: "claude-haiku-5-5", context_sha: "212264059c985c2e", sample: sample, arm: arm),
        task_sha: task,
        model: "claude-haiku-5-5",
        arm: arm,
        context_sha: "212264059c985c2e",
        sample: sample,
        turns: [thesis_verdict.Turn(outcome: outcome, codes: [], stop: "end_turn", input: 100, output: 50, cache_read: 0, cache_write: 0)],
        green_turn: turn,
        converged: green
    )

test "a run is set against its pre-registration field by protocol field, and a missing one or a missing block is said"
    scratch = shell.own_scratch()
    assert strings.contains(
        text: deviation_lines(out: scratch, dir: scratch).join("\n"),
        needle: "No `prediction.md` beside"
    )
    write_file(path: scratch + "/prediction.md", text: "# The prediction\n\nno block here\n").must()
    assert strings.contains(
        text: deviation_lines(out: scratch, dir: scratch).join("\n"),
        needle: "holds no `preregistered` block"
    )
    registered = "{\"date\":\"2026-10-20\",\"head\":\"aaa\",\"samples\":3,\"models\":[\"claude-sonnet-5-5\"],\"instrument\":\"i1\"}"
    write_file(
        path: scratch + "/prediction.md",
        text: "# The prediction\n\n```preregistered\n" + registered + "\n```\n"
    ).must()
    write_file(
        path: scratch + "/provenance.json",
        text: "{\"date\":\"2026-11-02\",\"head\":\"bbb\",\"samples\":3,\"models\":[\"claude-sonnet-5-5\"],\"instrument\":\"i1\"}"
    ).must()
    same = deviation_lines(out: scratch, dir: scratch).join("\n")
    assert strings.contains(text: same, needle: "None: the run holds every one of the 20 protocol fields")
    write_file(
        path: scratch + "/provenance.json",
        text: "{\"date\":\"2026-11-02\",\"head\":\"bbb\",\"samples\":1,\"models\":[\"claude-sonnet-5-5\"],\"instrument\":\"i2\",\"turns\":5}"
    ).must()
    moved = deviation_lines(out: scratch, dir: scratch).join("\n")
    assert strings.contains(text: moved, needle: "| `samples` | 3 | 1 |")
    assert strings.contains(text: moved, needle: "| `instrument` | \"i1\" | \"i2\" |")
    assert strings.contains(text: moved, needle: "| `turns` | (absent) | 5 |")
    assert !strings.contains(text: moved, needle: "`date`")
    assert !strings.contains(text: moved, needle: "`head`")
