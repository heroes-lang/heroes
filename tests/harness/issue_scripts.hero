# WHAT THE TESTS OF `plan` AND `push` HAND THE SCRIPTED TRANSPORT: issue files
# and GitHub's answers, written as GitHub writes them.
#
# The answers' shapes are the ones measurement 041 recorded for the import
# (`docs/measurements/041-the-import-endpoint-keeps-an-issues-own-days-and-an-imported-reference-leaves-no-backlink.md`:
# 202 and `"status":"pending"`, then `"status":"imported"` and `issue_url`) and
# the REST routes' documented ones for the lists; every answer carries a `date`
# header, as each of GitHub's does, so a run's day is read from it. Nothing here
# is called outside a `test` block.

use cards
use issue_git
use issue_json
use issue_match
use issue_pace
use issue_render
use issue_wire
use shell

constant DATE: str
    "Date: Mon, 12 Oct 2026 10:00:00 GMT"

constant PIN: str
    "1111111111111111111111111111111111111111"

constant IMPORTS: str
    "https://api.github.com/repos/heroes-lang/heroes/import/issues/"

# An open task's issue file, filed `filed`, of milestone `milestone` (`none` for
# none, as 1,817 of the 2,019 cards of 2026-10-12 are), its card's `github:`
# being `github`.
function card(filed: str, name: str, milestone: str, github: str) -> cards.Issue
    path = "issues/x/" + filed + "-0000-" + name + ".md"

    first = if milestone == "none"
        "a task"
    else
        milestone
    text = cards.card_text(kind: "task", area: "none", milestone: milestone, filed: filed, commit: "none", github: github) + "- [ ] **" + first + "** | " + name + " is owed | x\n"
    return cards.issue_of(path: path, text: text)

# `issue` rendered at `PIN`, as `issue_load` renders it.
function entry(issue: cards.Issue) -> issue_match.Entry
    made: {str: str} = {}
    made_by: {str: str} = {}
    unfollowed: {str: bool} = {}
    days: {str: str} = {}
    commits: {str: bool} = {}
    facts = issue_git.Facts(
        history: true,
        pin: PIN,
        made: made,
        made_by: made_by,
        unfollowed: unfollowed,
        days: days,
        commits: commits
    )
    none: [str] = []
    return issue_match.Entry(r: issue_render.render(issue: issue, facts: facts, twins: none), github: issue.card.github)

# A fresh directory holding `files` as a tree does.
function tree_of(files: [cards.Issue]) -> str
    root = shell.own_scratch()
    shell.mkdir_all(root + "/issues/x").must()

    for issue in files
        write_file(
            path: root + "/" + issue.path,
            text: cards.card_text(kind: issue.card.kind, area: issue.card.area, milestone: issue.card.milestone, filed: issue.card.filed, commit: issue.card.commit, github: issue.card.github) + issue.body
        ).must()

    return root

function answer(status: i64, body: str) -> issue_wire.Reply
    return issue_wire.answer(status: status, headers: [DATE], body: body)

function milestones(names: [str]) -> issue_wire.Reply
    rows: [str] @= []
    n: i64 @= 0

    for name in names
        n @ n + 1
        rows @ rows.push("{\"title\":\"" + name + "\",\"number\":" + n.to_str() + ",\"state\":\"open\"}")

    return answer(status: 200, body: "[" + rows.join(",") + "]")

function labels(names: [str]) -> issue_wire.Reply
    rows: [str] @= []

    for name in names
        rows @ rows.push("{\"name\":\"" + name + "\"}")

    return answer(status: 200, body: "[" + rows.join(",") + "]")

function limited() -> issue_wire.Reply
    return answer(
        status: 200,
        body: "{\"limit\":\"collaborators_only\",\"origin\":\"repository\",\"expires_at\":\"2026-10-13T10:00:00Z\"}"
    )

function unlimited() -> issue_wire.Reply
    return answer(status: 200, body: "{}")

# The issue an import of `e` made, numbered `number`, as the list gives it.
function held(e: issue_match.Entry, number: i64) -> str
    names: [str] @= []

    for label in e.r.labels
        names @ names.push("{\"name\":" + issue_json.quoted(label) + "}")

    milestone: str @= "null"

    if e.r.milestone != ""
        milestone @ "{\"title\":" + issue_json.quoted(e.r.milestone) + ",\"number\":1}"
    state: str @= "open"
    closed: str @= "null"

    if e.r.closed
        state @ "closed"
        closed @ issue_json.quoted(issue_render.instant(e.r.closed_day))
    return "{\"number\":" + number.to_str() + ",\"title\":" + issue_json.quoted(e.r.title) + ",\"body\":" + issue_json.quoted(e.r.body) + ",\"state\":\"" + state + "\",\"labels\":[" + names.join(",") + "],\"milestone\":" + milestone + ",\"created_at\":" + issue_json.quoted(issue_render.instant(e.r.filed)) + ",\"closed_at\":" + closed + ",\"comments\":0}"

function issues(held_issues: [str]) -> issue_wire.Reply
    return answer(status: 200, body: "[" + held_issues.join(",") + "]")

function pending(id: i64) -> issue_wire.Reply
    return answer(
        status: 202,
        body: "{\"id\":" + id.to_str() + ",\"status\":\"pending\",\"url\":\"" + IMPORTS + id.to_str() + "\"}"
    )

function imported(id: i64, issue: i64) -> issue_wire.Reply
    return answer(
        status: 200,
        body: "{\"id\":" + id.to_str() + ",\"status\":\"imported\",\"url\":\"" + IMPORTS + id.to_str() + "\",\"issue_url\":\"https://api.github.com/repos/heroes-lang/heroes/issues/" + issue.to_str() + "\"}"
    )

function still(id: i64) -> issue_wire.Reply
    return answer(
        status: 200,
        body: "{\"id\":" + id.to_str() + ",\"status\":\"pending\",\"url\":\"" + IMPORTS + id.to_str() + "\"}"
    )

function failed(id: i64) -> issue_wire.Reply
    return answer(
        status: 200,
        body: "{\"id\":" + id.to_str() + ",\"status\":\"failed\",\"url\":\"" + IMPORTS + id.to_str() + "\",\"errors\":[{\"location\":\"/issue/labels\",\"resource\":\"Label\",\"field\":\"name\",\"value\":\"kind:task\",\"code\":\"missing\"}]}"
    )

# An import GitHub failed on its own internal error, in the shape it answered
# twice on 2026-10-12: no location, `Internal Error` for the resource, an id of
# its own for the value.
function failed_inside(id: i64) -> issue_wire.Reply
    return answer(
        status: 200,
        body: "{\"id\":" + id.to_str() + ",\"status\":\"failed\",\"url\":\"" + IMPORTS + id.to_str() + "\",\"errors\":[{\"location\":null,\"resource\":\"Internal Error\",\"field\":null,\"value\":\"0df2f4eeafff731ce02167d408444d13d35787bc\",\"code\":\"error\"}]}"
    )

# The reads every run of `push` opens with: one milestone, the labels a task
# takes, the limit given, and the issues the list holds.
function opening(limit: issue_wire.Reply, held_issues: [str]) -> [issue_wire.Reply]
    return [milestones(["M-issue-files"]), labels(["kind:task"]), limit, issues(held_issues)]

# The address `path`'s card holds under `root` after a run.
function github_of(root: str, path: str) -> str
    return cards.read_card(read_file(root + "/" + path).must()).github

# How many writes a run asked.
function posts(s: issue_pace.Session) -> i64
    count: i64 @= 0

    for request in s.world.requests
        if request.method == "POST"
            count @ count + 1

    return count
