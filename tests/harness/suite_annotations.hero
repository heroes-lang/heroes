# CLAUDE.md §9's one unforgeable check: every diagnostic is annotated in
# the source that provokes it.
#
# Port of every_diagnostic_is_annotated_in_the_source_that_provokes_it
# (archive/bootstrap-rs/heroes-cli/tests/golden.rs:344), and panel 085 named it first
# among the tests with NO successor whatever — so this is the module that
# milestone exists for.
#
# WHY IT IS WORTH MORE THAN THE EXPECTATION FILES IT DUPLICATES. §9
# forbids `UPDATE_GOLDEN=1` in `check/` and relies on a human reading the
# diff. A regenerator can rewrite `x.expected` — that is what regenerators
# do — but it **cannot invent an annotation in `x.hero`**. Comparing the
# two turns a convention into an invariant: to fake a green run you would
# have to edit the program as well, in the right place, with the right
# code. rustc's rule and rustc's reason, and the retrofit's own evidence
# is that annotating all twenty-eight cases changed no `.expected` file by
# a single byte.
#
# Two forms, and the second exists because the annotation cannot always
# sit on the offending line (rustc has `//~^` and `//~v` for the same
# reason):
#
#   #~ <code>…    a diagnostic with each code is expected ON THIS LINE
#   #~v <code>…   on the NEXT line — `unterminated.hero` needs it because
#                 a trailing comment would land inside the unterminated
#                 string, and `missing-body.hero` because one diagnostic
#                 points past the last line of the file.
#
# `.fixed` files are deliberately not looked at: a repaired program keeps
# the annotations of diagnostics it no longer has, which is harmless — a
# comment provokes nothing — and only the `.hero` cases produce
# diagnostics.

use cases
use report
use shell
use strings

# `unsupported/` is in the sweep because its kind lives INSIDE the
# diagnostic system precisely so that it inherits this invariant (panel
# 020, the historian's decisive row): a report outside `Diagnostic` would
# be the only test class in the repo exempt from §9.
constant DIRECTORIES: [str]
    [
        "tests/golden/check"
        "tests/golden/unsupported"
    ]

# **The second sweep, and why there had to be one** (author decision
# 2026-08-26, `/decide` answer `5a`). The mechanism above compares a
# case's `.hero` with its `.expected`, so it can only reach cases that
# HAVE an expectation. Measured at M-separate-compilation close: **19
# annotations lived outside it** — 15 across 11 files in
# `tests/golden/fixedbugs/`, which has zero `.expected` for 16 `.hero`,
# and 4 across 3 in `surface-fixtures/`. Both are driven by
# `suite_surface` rows that run the compiler and match stderr, so there
# was no expectation file to compare against and the marks were
# decorations. The failure message below has said so about its own floor
# since it was written; it could not say it about these.
#
# So this half RUNS the compiler and reads what it prints. Three things
# it has to get right, each one measured on the real tree rather than
# assumed:
#
# 1. **Which command provokes the diagnostic.** `check` for a type error,
#    `build` for anything FFI — the probe block only reaches clang on a
#    build. Measured over all fourteen files: check-then-build resolves
#    every one, so the rule is *try check, and if it says nothing, build*.
# 2. **Which file to run.** A case is a DIRECTORY here, not a file: some
#    of these are modules with no `main`, whose diagnostic is provoked by
#    a neighbour. So every `.hero` in the group that has a `main` is run,
#    and their diagnostics are pooled.
# 3. **The comparison carries the FILE.** `externsignature/` is the case
#    that forced it: the annotation is in `bind.hero` and the `main` is in
#    `wrong.hero`, which is the general shape and not an oddity — a
#    diagnostic names the file it lands in. So both sides are
#    `<file>:<line>:<code>` here, where the sweep above needs only
#    `<line>:<code>`.
constant RUN_ROOTS: [str]
    [
        "tests/golden/fixedbugs"
        "tests/golden/surface-fixtures"
    ]

# The floor: how many diagnostics this file pins. `golden.rs` floored at
# 60, which was a number from when there were sixty — a floor at the real
# count is the same rule with the slack taken out.
#
# **181 over the two `.expected` directories, measured 2026-08-18. 207
# with the run-the-compiler half, measured 2026-08-26** — and the number
# was read out of the suite rather than added up by hand: the floor was
# briefly set impossibly high so the failure message would print the true
# count, which is this file's own rule applied to itself.
constant LEAST: i64
    207

function run_all(scratch: str, compiler: str) -> report.Report?
    r: report.Report @ report.empty()
    annotated: i64 @ 0
    witnessed: {str: bool} @ {}

    for dir in DIRECTORIES
        found = cases.collect(scratch: scratch, dir: dir)?

        for item in found
            source = read_file(item.source)
            expectation = read_file(item.expected)

            if source.is_err() || expectation.is_err()
                report.keep_failure(
                    @r,
                    label: "annotations/" + item.name,
                    detail: "  cannot read the case or its expectation"
                )
            else
                claimed = sorted(claimed_by(source.must()))
                reported = sorted(reported_by(expectation.must()))
                annotated @ annotated + reported.len()

                # `claimed` spells each mark `<line>:<code>`; the witness is the code.
                for mark in claimed
                    parts = strings.split_on(text: mark, byte: 58)
                    witnessed[parts[parts.len() - 1]] @ true

                if claimed != reported
                    report.keep_failure(
                        @r,
                        label: "annotations/" + item.name,
                        detail: "  " + item.source + ": the annotations and the diagnostics disagree\n    annotated: " + claimed.join(" ") + "\n    reported:  " + reported.join(" ") + "\n  `#~ <code>` marks this line, `#~v <code>` the next one"
                    )
                else
                    report.keep_pass(@r)

    every_thesis_rule_has_a_witness(@r, witnessed: witnessed)
    stepped_aside: i64 @ 0

    for group in groups(scratch)?
        annotated @ annotated + one_group(@r, scratch: scratch, compiler: compiler, group: group, @stepped_aside)

    # The floor counts what this machine could ask plus what it honestly could
    # not: a mark that stepped aside for a missing header is accounted, never
    # absorbed — so a machine that skips EVERYTHING still goes red here.
    if annotated + stepped_aside < LEAST
        report.keep_failure(
            @r,
            label: "annotations",
            detail: "  only " + annotated.to_str() + " annotated diagnostics (+" + stepped_aside.to_str() + " that this machine cannot ask), and there were " + LEAST.to_str() + " — annotations that stop being checked are the shape §9 calls a decoration"
        )
    return ok(r)

# SWEEP 001'S AUDIT S13, PORTED AT LAST (2026-09-03). The thesis rules —
# the codes `check --permissive` drops, which is what makes it Part 11's
# control arm — are a hand-maintained list in `selfhost/diag.hero`, and a
# hand-maintained list is the fifth root the sweep named: a code MISSING
# from it silently understates the number the thesis is argued from, and
# a code IN it with no golden is a rule nobody can show firing. The Rust
# bootstrap pinned the set (`measure::gate`'s shape: "adding a diagnostic
# turns it red until somebody writes the code down"); the port did not
# bring it, and measured the evening this was written, three of the
# fourteen — `declaration_in_arm`, `declared_twice`, `ufcs_on_mutable` —
# had no case under `check/` at all, only their own module's unit test.
# So: every code the list names is annotated by at least one case this
# suite already reads. The list is read from the source text rather than
# imported, because a `use` cannot climb out of `tests/harness/`
# (`module_path_climbs`), and a copy of the list here would be the second
# hand-maintained list the audit warns about.
constant THESIS_LIST: str
    "selfhost/diag.hero"

function every_thesis_rule_has_a_witness(@r: report.Report, witnessed: {str: bool})
    text = read_file(THESIS_LIST)

    if text.is_err()
        report.keep_failure(
            @r,
            label: "annotations/thesis",
            detail: "  cannot read " + THESIS_LIST + ", where the thesis rules are listed"
        )
        return
    listed = thesis_codes(text.must())

    if listed.len() == 0
        report.keep_failure(
            @r,
            label: "annotations/thesis",
            detail: "  " + THESIS_LIST + " has no `is_thesis_rule` list this suite can read — the list moved, and this reader has to follow it"
        )
        return

    for code in listed
        if witnessed[code].is_err()
            report.keep_failure(
                @r,
                label: "annotations/thesis",
                detail: "  `" + code + "` is a thesis rule (`check --permissive` drops it), and no case under " + DIRECTORIES.join(" or ") + " annotates it — Part 11's control arm counts a rule nobody can show firing"
            )
        else
            report.keep_pass(@r)

# The quoted codes between `function is_thesis_rule` and the loop that
# reads them, in the order written. Anything else on those lines is not a
# code: the list is one string per line, and that is the shape this reads.
function thesis_codes(diag_source: str) -> [str]
    out: [str] @ []
    inside: bool @ false

    for row in strings.lines(diag_source)
        if strings.starts_with(text: row, prefix: "function is_thesis_rule")
            inside @ true
            continue

        if inside && strings.contains(text: row, needle: "for one in codes")
            return out
        trimmed = strings.trimmed(row)

        if inside && trimmed.len() >= 2 && trimmed[0] == 34 && trimmed[trimmed.len() - 1] == 34
            out @ out.push(trimmed.slice(from: 1, to: trimmed.len() - 1))

    return out

# Every directory whose cases carry no `.expected`: `fixedbugs/` flat,
# plus each subdirectory of `surface-fixtures/`. Discovered rather than
# listed, because a list of directories is a premise about the tree and
# premises expire in silence (CLAUDE.md §11) — a new fixture directory
# joins this sweep by existing.
function groups(scratch: str) -> [str]?
    out: [str] @ []

    for root in RUN_ROOTS
        holds_cases: bool @ false

        for entry in shell.list_entries(scratch: scratch, dir: root)?
            if strings.ends_with(text: entry, suffix: ".hero")
                holds_cases @ true

        if holds_cases
            out @ out.push(root)

        for sub in shell.list_directories(scratch: scratch, dir: root)?
            out @ out.push(sub)

    return ok(out.sort())

# One group: run every program in it, pool what the compiler said, and
# compare against every annotation in it. Returns how many diagnostics
# were pinned, for the floor.
function one_group(@r: report.Report, scratch: str, compiler: str, group: str, @stepped_aside: i64) -> i64
    label = "annotations/" + group
    files = shell.list_entries(scratch: scratch, dir: group)

    if files.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot list " + group)
        return 0
    claimed: [str] @ []
    said: str @ ""
    ran: i64 @ 0

    for path in files.must()
        if !strings.ends_with(text: path, suffix: ".hero")
            continue
        text = read_file(path)

        if text.is_err()
            report.keep_failure(@r, label: label, detail: "  cannot read " + path)
            return 0
        marks = claimed_by(text.must())

        if strings.contains(text: text.must(), needle: "function main")
            out = provoked(scratch: scratch, compiler: compiler, path: path)

            # **A file this machine cannot ask steps aside, marks and all.**
            # `ffi-a-field-the-header-has-as-an-array.hero` binds `dirent.h`,
            # which Windows does not have, so the compiler answers
            # `ffi_missing_header` where the annotation pins `ffi_field_type`
            # — the machine's answer, not the program's, the same class every
            # other suite already skips. The guard is the annotations' own:
            # a case whose marks EXPECT the missing-header code (that golden
            # exists) claims it and is never skipped. The file's marks leave
            # the count with it, so the floor below stays honest.
            if machine_answered(out: out, marks: marks)
                stepped_aside @ stepped_aside + marks.len()
                continue
            said @ said + out
            ran @ ran + 1

        for mark in marks
            claimed @ claimed.push(path + ":" + mark)

    if claimed.len() == 0
        return 0

    if ran == 0
        report.keep_failure(
            @r,
            label: label,
            detail: "  " + claimed.len().to_str() + " annotations here and no program with a `main` to provoke them:\n    " + claimed.join("\n    ")
        )
        return 0
    reported = sorted(reported_with_file(said))

    if sorted(claimed) != reported
        report.keep_failure(
            @r,
            label: label,
            detail: "  the annotations and the diagnostics disagree\n    annotated: " + sorted(claimed).join(" ") + "\n    reported:  " + reported.join(" ") + "\n  `#~ <code>` marks this line, `#~v <code>` the next one. This group has no `.expected`, so what it is compared against is what the compiler printed just now."
        )
        return 0
    report.keep_pass(@r)
    return reported.len()

# Whether the output is the MACHINE's answer rather than the program's: a
# header or a package this machine does not have, unclaimed by the file's own
# annotations. Both codes are real expectations elsewhere, which is why the
# marks are consulted rather than the codes alone.
function machine_answered(out: str, marks: [str]) -> bool
    hit: bool @ false

    if strings.contains(text: out, needle: "error[ffi_missing_header]") && !holds_mark(marks, code: "ffi_missing_header")
        hit @ true

    if strings.contains(text: out, needle: "error[ffi_package]") && !holds_mark(marks, code: "ffi_package")
        hit @ true

    return hit

function holds_mark(marks: [str], code: str) -> bool
    for mark in marks
        if mark == code
            return true

    return false

# What the compiler says about one program: `check` first, and `build`
# when check is silent, because an FFI diagnostic only reaches clang on a
# build. Measured over all fourteen annotated files at the close.
function provoked(scratch: str, compiler: str, path: str) -> str
    checked = shell.run_guarded(scratch: scratch, words: [compiler, "check", path])

    if !checked.is_err() && checked.must().code == 1
        return checked.must().err
    built = shell.run_guarded(
        scratch: scratch,
        words: [compiler, "build", path, "-o", scratch + "/annotated.bin"]
    )

    if built.is_err()
        return ""
    return built.must().err

# Every diagnostic in real compiler output, as `<file>:<line>:<code>`.
# The rich form only: this reads what the compiler prints by default, and
# by default it prints §4.17's form, whose `  at <file>:<line>:<col>` line
# carries both halves the comparison needs.
function reported_with_file(text: str) -> [str]
    found: [str] @ []
    pending: str @ ""

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "  at ")
            if pending.len() > 0
                rest = strings.without_prefix(text: row, prefix: "  at ")
                parts = strings.split_on(text: rest, byte: 58)

                if parts.len() > 2
                    number = strings.to_number(parts[1])

                    if !number.is_err()
                        found @ found.push(parts[0] + ":" + number.must().to_str() + ":" + pending)
                pending @ ""
            continue
        code = code_of(row)

        if !code.is_err()
            pending @ code.must()

    return found

# Both sides are compared as sorted `<line>:<code>` strings: Heroes sorts
# numbers, strings and bools and not records (spec § 11 Built-ins), and the pair is
# what the comparison is about. The order is the same on both sides, which
# is all a set comparison needs.
function sorted(marks: [str]) -> [str]
    return marks.sort()

# Every annotation in a case, with `#~v` resolved to the next line.
#
# **A MARK IS NOT A SENTENCE QUOTING ONE**, and this project has now paid
# for that distinction twice. Step 1 of M-separate-compilation found the
# `ORDER:` inventory was a grep returning **10 hits in 8 files, four of
# them prose**; this function had the same hole, found the day the sweep
# below started reading directories that contain README-shaped comments.
# `externsignature/wrong.hero` explains in its header comment where its
# annotation lives — and the sentence contains the two characters, so
# every word after them was read as a diagnostic code: `annotation`,
# `belongs`, `the`, `own`.
#
# The rule is one line and it is about position rather than vocabulary: a
# row whose first non-blank character is `#` is PROSE unless the mark is
# the very next thing. A real mark either opens its own comment (`#~ code`)
# or trails code (`… -> i64    #~ ffi_return_type`), and in the second
# case the row does not start with `#` at all. Filtering on what a code
# looks like would not have worked here: `annotation` and `belongs` are
# both perfectly good snake_case.
function claimed_by(text: str) -> [str]
    found: [str] @ []
    rows = strings.lines(text)
    line: i64 @ 0

    for row in rows
        line @ line + 1
        opener = strings.trimmed(row)

        if strings.starts_with(text: opener, prefix: "#") && !strings.starts_with(text: opener, prefix: "#~")
            continue
        at = strings.index_of(text: row, needle: "#~")

        if at.is_err()
            continue

        # One comment may carry both forms: `#~ empty_record #~v empty_variant`.
        after = row.slice(from: at.must() + 2, to: row.len())

        for chunk in strings.split_text(text: after, separator: "#~")
            body = strings.trimmed(chunk)
            delta: i64 @ 0
            codes: str @ body

            if strings.starts_with(text: body, prefix: "v")
                delta @ 1
                codes @ strings.without_prefix(text: body, prefix: "v")

            for code in strings.words(codes)
                found @ found.push((line + delta).to_str() + ":" + code)

    return found

# Every diagnostic in an expectation, as `<line>:<code>`.
#
# Two forms, because two commands print diagnostics: `check --brief`'s
# one-liner `<file>:<line>:<col>: <kind>[<code>]: <message>`, and §4.17's
# rich form, whose code and location are on consecutive lines. The KIND is
# read rather than assumed — `error` was the only one until `unsupported`
# arrived, and hard-coding it would have quietly exempted the new kind
# from the invariant.
function reported_by(text: str) -> [str]
    found: [str] @ []
    pending: str @ ""

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "  at ")
            if pending.len() > 0
                rest = strings.without_prefix(text: row, prefix: "  at ")
                parts = strings.split_on(text: rest, byte: 58)

                if parts.len() > 1
                    number = strings.to_number(parts[1])

                    if !number.is_err()
                        found @ found.push(number.must().to_str() + ":" + pending)
                pending @ ""
            continue
        code = code_of(row)

        if code.is_err()
            continue

        # The one-line form carries its own location; the rich form's
        # headline does not, so it waits for the `at` line.
        parts = strings.split_on(text: row, byte: 58)
        placed: bool @ false

        if parts.len() > 1
            number = strings.to_number(strings.trimmed(parts[1]))

            if !number.is_err()
                found @ found.push(number.must().to_str() + ":" + code.must())
                placed @ true

        if !placed
            pending @ code.must()

    return found

# The `<code>` out of `…<kind>[<code>]:…`, for any kind.
function code_of(row: str) -> str?
    open = strings.index_of(text: row, needle: "[")

    if open.is_err()
        return fail(code: "none", msg: "no bracket")
    tail = row.slice(from: open.must(), to: row.len())
    close = strings.index_of(text: tail, needle: "]")

    if close.is_err()
        return fail(code: "none", msg: "no closing bracket")
    before = row.slice(from: 0, to: open.must())
    kind = last_word(before)

    if kind.len() == 0 || !all_lower(kind)
        return fail(code: "none", msg: "the word before the bracket is not a kind")
    code = row.slice(from: open.must() + 1, to: open.must() + close.must())

    # Digits belong: `indentation_not_multiple_of_4` is a code.
    if code.len() == 0 || !all_code(code)
        return fail(code: "none", msg: "the bracket does not hold a code")
    return ok(code)

# The word before the bracket, cut at a space or a colon.
function last_word(text: str) -> str
    start: i64 @ 0
    i: i64 @ 0

    while i < text.len()
        if text[i] == 32 || text[i] == 58
            start @ i + 1
        i @ i + 1

    return text.slice(from: start, to: text.len())

function all_lower(text: str) -> bool
    for i in range(from: 0, to: text.len())
        if text[i] < 97 || text[i] > 122
            return false

    return true

function all_code(text: str) -> bool
    for i in range(from: 0, to: text.len())
        byte = text[i]
        lower = byte >= 97 && byte <= 122
        digit = byte >= 48 && byte <= 57

        if !lower && !digit && byte != 95
            return false

    return true

test "an annotation is read on its line, and #~v on the next"
    marks = claimed_by("function main()\n    x = 1   #~ unused_binding\n    y = 2   #~v empty_record\n")
    assert marks.len() == 2
    assert marks[0] == "2:unused_binding"
    assert marks[1] == "4:empty_record"

test "one comment may carry both forms and several codes"
    marks = claimed_by("a   #~ one two #~v three\n")
    assert marks.len() == 3
    assert marks.sort() == ["1:one", "1:two", "2:three"]

test "the one-line form carries its own location"
    said = reported_by("x.hero:3:5: error[unused_binding]: `x` is never read\n")
    assert said == ["3:unused_binding"]

test "the rich form waits for its `at` line, whatever the kind"
    text = "unsupported[pointer_element]: a `ptr` cannot live in a container\n  at x.hero:31:5\n     |\n  31 |     handles: [ptr] @ []\n     |     ^^^^^^^^^^^^^^^^^^^\n  note: a note in brackets [not_a_code]\n"
    assert reported_by(text) == ["31:pointer_element"]

test "a bracket that is not a code is not a diagnostic"
    assert code_of("  note: install it [somewhere else]").is_err()
    assert code_of("no brackets at all").is_err()
    assert code_of("  Perhaps `x.pc'").is_err()
    assert code_of("error[ffi_package]: ...").must() == "ffi_package"
    assert code_of("unsupported[unit_field]: ...").must() == "unit_field"
    assert code_of("x.hero:1:1: error[indentation_not_multiple_of_4]: ...").must() == "indentation_not_multiple_of_4"

test "a case whose annotation disagrees with its diagnostic is caught"
    # The whole point: this is what a regenerator cannot fake, because it
    # would have to edit the .hero as well.
    claimed = sorted(claimed_by("a   #~ unused_binding\n"))
    reported = sorted(reported_by("x.hero:1:1: error[unused_variant]: ...\n"))
    assert claimed != reported
    same = sorted(reported_by("x.hero:1:1: error[unused_binding]: ...\n"))
    assert claimed == same

test "the thesis list is read from the source, one quoted code per line, and stops at its loop"
    text = "# prose\nfunction is_thesis_rule(d: Diagnostic) -> bool\n    codes = [\n        \"unused_binding\"\n        \"declared_twice\"\n    ]\n\n    for one in codes\n        if d.code == one\n            return true\n    \"not_a_code\"\n"
    got = thesis_codes(text)
    assert got.len() == 2
    assert got[0] == "unused_binding"
    assert got[1] == "declared_twice"
    assert thesis_codes("function other()\n    return 1\n").len() == 0

test "a thesis rule with no witness is one failure, and the real list is found"
    real = read_file("selfhost/diag.hero")
    assert !real.is_err()
    listed = thesis_codes(real.must())
    assert listed.len() >= 14
    all_seen: {str: bool} @ {}

    for code in listed
        all_seen[code] @ true

    green: report.Report @ report.empty()
    every_thesis_rule_has_a_witness(@green, witnessed: all_seen)
    assert green.failed == 0
    assert green.passed == listed.len()
    one_short: {str: bool} @ all_seen
    one_short @ {}

    for code in listed
        if code != "declared_twice"
            one_short[code] @ true

    red: report.Report @ report.empty()
    every_thesis_rule_has_a_witness(@red, witnessed: one_short)
    assert red.failed == 1
