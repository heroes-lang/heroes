# Programs nobody wrote, each with the answer it owes (panel 231's
# prototype, the compiler-engineer's seat; M-generated-programs, task 931).
#
#   heroes run tests/harness/generate.hero -- make --seed N --count K -o DIR [--declared PERCENT]
#   heroes run tests/harness/generate.hero -- judge DIR --compiler PATH
#   heroes run tests/harness/generate.hero -- reduce --seed N --declared PERCENT --compiler PATH -o DIR [--level -O0|-O2|sanitize]
#   heroes run tests/harness/generate.hero -- hunt --from S --count K --compiler PATH -o DIR [--declared PERCENT]
#   heroes run tests/harness/generate.hero -- answers --count 128 --declared 30
#
# `make` writes `gN.hero` and `gN.expected` for the K seeds from N, the
# declared arm planting one abort in PERCENT of them; `judge` holds every
# `.hero` of DIR to its `.expected` through the oracles of `gen_judge.hero`,
# one line each, and exits 1 where any is a defect; `reduce` takes a failing
# seed down. A program of the harness, as the net is, proposing no verb
# (CLAUDE.md § 10). **The compiler judged is the one `--compiler` names, and
# the generator is built by the one that runs this program**: with the two
# different (a round's base running it, the round's compiler judged), a
# miscompilation of an operator the generator also computes with is seen,
# and with the two the same it is not (panel 231, the compiler-engineer's Q1:
# 36 of 300 against 0 of 300 on a planted `>>`).

use gen_depth
use gen_eval
use gen_flags
use gen_hunt
use gen_judge
use gen_program
use gen_reduce
use gen_symptom
use gen_text
use shell
use strings

function main()
    words = args()

    if words.len() > 0 && words[0] == "reduce"
        reduce(words)
        return

    if words.len() > 0 && words[0] == "answers"
        f = gen_flags.flags_of(words: words, positional: 0, known: ["--count", "--declared"])
        answers(count: gen_flags.count_after(f, fallback: 128), declared: gen_flags.percent_after(f, fallback: 30))
        return

    if words.len() > 0 && words[0] == "symptom"
        exit(symptom_word(words))

    if words.len() > 0 && words[0] == "hunt"
        exit(hunt(words))

    if words.len() > 0 && words[0] == "deep"
        exit(deep(words))

    if words.len() > 1 && words[0] == "judge"
        judged = gen_flags.flags_of(words: words, positional: 1, known: ["--compiler"])
        exit(judge(dir: words[1], compiler: gen_flags.text(judged, flag: "--compiler", fallback: "heroes")))

    if words.len() < 1 || words[0] != "make"
        print(
            "usage: generate make --seed N --count K -o DIR [--declared PERCENT] | judge DIR --compiler PATH | reduce --seed N --compiler PATH -o DIR [--level L] | hunt --from S --count K --compiler PATH -o DIR [--declared PERCENT] | deep --depth N --compiler PATH -o DIR [--shapes if,while,records,variants,calls]"
        )
        exit(2)
    made = gen_flags.flags_of(words: words, positional: 0, known: ["--seed", "--count", "-o", "--declared"])
    seed = gen_flags.seed_after(made, flag: "--seed", fallback: 1)
    count = gen_flags.count_after(made, fallback: 10)
    gen_flags.told(gen_flags.seeds_fit(first: seed, count: count, first_flag: "--seed"))
    declared = gen_flags.percent_after(made, fallback: 0)
    dir = gen_flags.text(made, flag: "-o", fallback: "build/generated")
    shell.mkdir_all(dir).must()
    k: i64 @= 0

    while k < count
        n = seed + k
        g = gen_program.from_seed(seed: n, percent: declared)

        if gen_program.written(gen_program.files_of(g, seed: n), dir: dir).is_err()
            print("cannot write seed ", n, "'s files into ", dir)
            exit(2)
        k @ k + 1

# `reduce --seed N --declared PERCENT --compiler PATH -o DIR`: the program
# `make` wrote for seed N, taken down while PATH still fails it.
function reduce(words: [str])
    f = gen_flags.flags_of(words: words, positional: 0, known: ["--seed", "--declared", "--compiler", "-o", "--level"])
    n = gen_flags.seed_after(f, flag: "--seed", fallback: 1)
    declared = gen_flags.percent_after(f, fallback: 0)
    compiler = gen_flags.text(f, flag: "--compiler", fallback: "heroes")
    dir = gen_flags.text(f, flag: "-o", fallback: "build/reduced")
    level = levels(f)
    shell.mkdir_all(dir).must()
    g = gen_program.from_seed(seed: n, percent: declared)
    t: gen_symptom.Tally @= gen_symptom.Tally(judged: 0, kept: 0, refused: 0)
    seen = gen_symptom.symptom(g.p, compiler: compiler, dir: dir, level: level, @t)

    if seen == ""
        print("seed ", n, ": the compiler does not fail this program at ", level.join(" "))
        exit(1)
    print("seed ", n, ": the symptom held is ", seen)
    target = gen_symptom.Target(compiler: compiler, dir: dir, level: level, symptom: seen)
    small = gen_reduce.reduced(g.p, target: target, @t)
    text = gen_symptom.text_of(small)
    written(path: dir + "/r" + n.to_str() + ".hero", text: text)
    written(path: dir + "/r" + n.to_str() + ".expected", text: gen_eval.expected(small))
    print(
        "seed ",
        n,
        ": ",
        gen_symptom.text_of(g.p).len(),
        " bytes to ",
        text.len(),
        "; judged ",
        t.judged,
        ", kept ",
        t.kept,
        ", refused ",
        t.refused
    )

# Every `.hero` of `dir` judged by `compiler`, one line each, `<name>
# <WORD> <detail>`, then the counts: 0 where none is a defect, 1 where one
# is, 2 where the judging itself could not run.
function judge(dir: str, compiler: str) -> i64
    names = shell.list_entries(scratch: dir + "/.judge", dir: dir)

    if names.is_err()
        print("cannot list ", dir)
        return 2
    work = dir + "/.judge"
    shell.mkdir_all(work).must()
    defects: i64 @= 0
    judged: i64 @= 0
    limits: i64 @= 0

    # `list_entries` answers paths, each under `dir`.
    for path in sort(names.must())
        name = gen_judge.base_name(path)

        # A program is the `.hero` with its answer beside it: neither a
        # formatted copy nor a module of the program's own has one.
        if strings.has_suffix(s: name, suffix: ".hero") && shell.exists(strings.without_suffix(text: path, suffix: ".hero") + ".expected")
            got = gen_judge.judged(compiler: compiler, source: path, work: work)

            match got
                .err e =>
                    print(name, " UNJUDGED ", e.msg)
                    return 2
                .ok v =>
                    judged @ judged + 1
                    print(name, " ", gen_judge.word(v), " ", gen_judge.detail(v))

                    if gen_judge.is_defect(v)
                        defects @ defects + 1
                    else if gen_judge.word(v) == "CLANG-LIMIT" || gen_judge.word(v) == "DEPTH-LIMIT"
                        limits @ limits + 1

    print("judged ", judged, ": ", defects, " defects, ", limits, " at a designed limit")

    if defects > 0
        return 1
    return 0

# `deep --depth N --compiler PATH -o DIR [--shapes NAMES]`: the nesting
# shapes written N deep, the floor's four and a chain of calls, or those of
# them NAMES lists, comma-separated (a block's source grows with the square of
# its depth, 16 MB at 2,000), each built and run by PATH and
# read by oracle 1 (panel 231's R4: *in the hunt, up to and past 2,000 on
# purpose*). A limit panel 184 designed, at build or at run, is a defect at
# or under the floor and recorded past it; anything else wrong is a defect.
# 0 where none is, 1 where one is.
function deep(words: [str]) -> i64
    f = gen_flags.flags_of(words: words, positional: 0, known: ["--depth", "--compiler", "-o", "--shapes"])
    n = gen_flags.told(
        gen_flags.number(f, flag: "--depth", fallback: gen_depth.FLOOR, least: 1, most: gen_flags.I64_MOST)
    )
    compiler = gen_flags.text(f, flag: "--compiler", fallback: "heroes")
    dir = gen_flags.text(f, flag: "-o", fallback: "build/deep")
    asked = gen_flags.told(gen_flags.listed(f, flag: "--shapes", fallback: SHAPES.join(","), allowed: SHAPES))
    shell.mkdir_all(dir).must()
    defects: i64 @= 0
    every: [gen_depth.Shape] @= gen_depth.shapes_at(n)
    every @ every.push(gen_depth.calls(n))
    shapes: [gen_depth.Shape] @= []

    for shape in every
        if asked_for(name: shape.name, asked: asked)
            shapes @ shapes.push(shape)

    for shape in shapes
        source = dir + "/" + shape.name + ".hero"
        binary = dir + "/" + shape.name + shell.exe_suffix()
        written(path: source, text: shape.text)
        built = shell.run_bounded(
            scratch: dir,
            program: compiler,
            words: [compiler, "build", source, "-o", binary],
            seconds: 600,
            bytes: 0,
            stdin_path: ""
        ).must()
        fell = gen_judge.fallen(built, stage: "build")
        said: str @= "PASS"

        if !fell.is_err()
            said @ gen_judge.word(fell.must()) + " " + gen_judge.detail(fell.must())

            if gen_judge.is_defect(fell.must()) || n <= gen_depth.FLOOR
                defects @ defects + 1
        else
            ran = shell.run_bounded(
                scratch: dir,
                program: binary,
                words: [binary],
                seconds: gen_judge.RUN_SECONDS,
                bytes: gen_judge.program_bytes(),
                stdin_path: ""
            ).must()

            if ran.code == 134 && strings.contains(s: ran.err, substr: "stack exhausted in")
                said @ "DEPTH-LIMIT at run: " + gen_judge.first_line(ran.err)

                if n <= gen_depth.FLOOR
                    defects @ defects + 1
            else if ran.code != 0 || ran.out != shape.expected
                said @ "WRONG exit " + ran.code.to_str() + ": " + gen_judge.first_line(ran.err)
                defects @ defects + 1
        print(shape.name, " ", said)

    print(n, " deep: ", shapes.len(), " shapes, ", defects, " defects")

    if defects > 0
        return 1
    return 0

# The shapes `deep` writes, each a kind `--shapes` may name.
constant SHAPES: [str]
    ["if", "while", "records", "variants", "calls"]

# Whether the shape named `name`, `<kind>-<n>-deep`, is one `asked` lists.
function asked_for(name: str, asked: [str]) -> bool
    for kind in asked
        if strings.has_prefix(s: name, prefix: kind + "-")
            return true

    return false

# `answers`: the sample's answers as `tests/golden/generated/answers.txt`
# holds them, `== g<seed>` and the seed's `.expected` beneath, seeds 1 to
# `count`, printed for a person to read and redirect into that file when the
# generator changes on purpose (panel 231's R7): never written by a suite.
function answers(count: i64, declared: i64)
    seed: i64 @= 1

    while seed <= count
        name = "g" + seed.to_str()
        g = gen_program.from_seed(seed: seed, percent: declared)
        text = gen_text.program_text(g.p, seed: seed, has_record: g.has_record, has_variant: g.has_variant)
        print("== ", name)

        for row in gen_text.lines_of(gen_program.expected_of(g, text: text, stem: name))
            print(row)

        seed @ seed + 1

# `symptom --seed N --compiler PATH [--declared PERCENT] [--level L] -o DIR`:
# what the compiler does wrong with seed N's program, the symptom a
# reduction would hold, printed alone; 1 where it does something wrong, 0
# where it does not.
function symptom_word(words: [str]) -> i64
    f = gen_flags.flags_of(words: words, positional: 0, known: ["--seed", "--compiler", "--declared", "--level", "-o"])
    n = gen_flags.seed_after(f, flag: "--seed", fallback: 1)
    declared = gen_flags.percent_after(f, fallback: 0)
    level = levels(f)
    dir = gen_flags.text(f, flag: "-o", fallback: "build/symptom")
    shell.mkdir_all(dir).must()
    g = gen_program.from_seed(seed: n, percent: declared)
    t: gen_symptom.Tally @= gen_symptom.Tally(judged: 0, kept: 0, refused: 0)
    seen = gen_symptom.symptom(
        g.p,
        compiler: gen_flags.text(f, flag: "--compiler", fallback: "heroes"),
        dir: dir,
        level: level,
        @t
    )
    print("seed ", n, ": ", seen)

    if seen == ""
        return 0
    return 1

# `hunt`: the failures of seeds S to S + K - 1 written into DIR, each wrong
# answer reduced; 0 where none failed, 1 where one did, 2 where it could not
# run (`gen_hunt.hero`).
function hunt(words: [str]) -> i64
    f = gen_flags.flags_of(words: words, positional: 0, known: ["--from", "--count", "--compiler", "-o", "--declared"])
    from = gen_flags.seed_after(f, flag: "--from", fallback: 1)
    count = gen_flags.count_after(f, fallback: 100)
    gen_flags.told(gen_flags.seeds_fit(first: from, count: count, first_flag: "--from"))
    declared = gen_flags.percent_after(f, fallback: 30)
    out = gen_flags.text(f, flag: "-o", fallback: "build/hunt")
    got = gen_hunt.hunted(
        from: from,
        count: count,
        declared: declared,
        compiler: gen_flags.text(f, flag: "--compiler", fallback: "heroes"),
        out: out
    )

    match got
        .err e =>
            print("the hunt could not run: ", e.msg)
            return 2
        .ok h =>
            print("hunted ", h.judged, ": ", h.failed, " failed, ", h.reduced, " reduced, written into ", out)

            if h.failed > 0
                return 1
            return 0

# The flags a reduction builds with, from `--level`: `-O0` (the default),
# `-O2`, or `sanitize`, the `--sanitize -O0` configuration; any other word is
# told, where it read as `-O0` until defect 2580.
function levels(f: gen_flags.Flags) -> [str]
    said = gen_flags.told(gen_flags.one_of(f, flag: "--level", fallback: "-O0", allowed: ["-O0", "-O2", "sanitize"]))

    if said == "-O2"
        return ["-O2"]

    if said == "sanitize"
        return ["--sanitize", "-O0"]
    return []

function written(path: str, text: str)
    if write_file(path: path, text: text).is_err()
        print("cannot write ", path)
        exit(2)
