# The net, in Heroes — the harness that replaces `cargo test` when the
# Rust bootstrap is archived (M-harness-port; panel 085 R4).
#
# WHY THIS EXISTS. Everything that asks whether the compiler is right
# lives in archive/bootstrap-rs/heroes-cli/tests/*.rs today, and all of it dies with
# `archive/bootstrap-rs/`. Panel 085 measured what would be left: nothing runs
# `selfhost/`'s own tests, no selfhost test touches a golden, and 208
# golden cases go dark. This program is the replacement, and it is a
# PROGRAM rather than a subcommand because §10's stopping rule refuses the
# flag — two existing invocations (`heroes run`, and the compiler under
# test) already compose to it.
#
# HOW TO RUN IT
#
#     heroes run tests/harness/main.hero -- <compiler> [suite] [word]
#
# from the repository root, always: the goldens hold paths relative to the
# root, so the working directory is part of what the expectations pin. Naming
# the compiler is how the SAME harness is pointed at either one; naming a
# suite runs only that one.
#
# The third word narrows a suite that walks cases: to the cases whose name
# holds it (and `records` to one path, the one check that can judge a file
# alone, `defects-cited`, the write hook's question), or, written `<i>/<n>`, to shard `i` of `n` of `run`, `lldb` or a
# golden form, its cases dealt round by their sorted index so that `n` processes
# started with `1/n` to `n/n` run each case exactly once (defect 537,
# `cases.selected`). A shard asks none of the whole suite's questions, its
# floor and its skip ratio, and its line says so; whoever split the suite
# asks them of the shards' sums.
#
# With no compiler named, the machine is asked rather than a path assumed
# (`shell.some_compiler`): $HEROES_COMPILER, then `./heroes-from-seed` — what
# CI builds out of `seed/heroes.c` with clang alone — then `./build/heroes-seed`,
# then the bootstrap. That order is the archive's order, so this line does not
# change on the day `archive/bootstrap-rs/` moves.
#
# Exit: 0 all green · 1 something failed · 2 the harness could not run.
# That is §10's contract for a tool whose artifact is a verdict.
#
# WHAT IS HERE SO FAR (this milestone lands suites per step)
#   check/        every diagnostics case — stderr, exit 1
#   ir/           the lowered IR — stdout, exit 0
#   emit/         the generated C11 — stdout, exit 0
#   unsupported/  what the backend refuses — stderr, exit 1, no artifact
#   permissive/   what Part 11's control arm, `check --permissive`, says,
#                 the thesis rules dropped: stderr, exit 1
#   full/         `check`'s whole form, the excerpt, the notes and the
#                 fixes under each message: stderr, exit 1
#   run/          every program at -O0, -O2 and --sanitize
#   annotations   §9's `#~` invariant over check/ and unsupported/
#   determinism   the IR dump twice, the C twice and through -o
#   fixes         `.fixed` — every certain fix applied, and it checks clean;
#                 `.applied`, what `--apply` writes where it cannot; neither,
#                 and `--apply` leaves the case as it is
#   lines         every `#line` lands on a line the author wrote
#   lldb          lldb/: a program built at -O0, stopped on a `.hero` line,
#                 stepped and asked its locals; SKIP where lldb cannot run
#   corpus        examples/ — real programs, tests and output, three ways
#   warnings      the generated C compiles without a single warning
#   records       §14's identifiers, the alias table, stray C, the goldens
#   surface       what a user types: exit codes, streams, flags, rendering
#   special       the surface tests no table row can express
#   grammar       what `heroes grammar` prints against what the
#                 compiler's own source says: the keyword match and
#                 the precedence table, read as text, in order
#   layout        §11's per-file ceiling over selfhost/, tests excluded
#   order         §4.9's `# ORDER:` mark on every map walk in selfhost/
#   runtime       Part 7.13's two v1 invariants over runtime/: one
#                 allocation point, and a refcount boundary clang
#                 cannot inline away
#   emission      every program's emitted C against the bytes two
#                 compilers agreed on (M-bootstrap-archive step 1)
#   descriptors   every descriptor the blessed C names is defined in it,
#                 and every one it defines is named — both directions
#   wholes        every temporary the blessed C and the seed define is
#                 written whole before any part of it (panel 182)
#   seed          the seed defines what the compiler it builds reads of
#                 its own C, so stage 1 can build stage 2 (panel 222's R3)
#   cache         the per-module build cache: a header edit is not
#                 invisible, an untouched build still hits, an edit moves
#                 exactly the objects that read the edited file, and a
#                 reordered variant is never served from a warm object
#   units         what one translation unit contains: emitted identically
#                 twice, the prototype a caller compiles is the one the
#                 definition sits beside, and the runtime's descriptors
#                 are named and never copied
#   probe         `heroes probe` over the formatter's fixtures under every
#                 family and over the whole tree under `multi`, each row
#                 pinning its floors (panel 179)
#
# Nothing is left in Rust that this cannot ask. The last one to arrive was
# `emission`, and it is the only suite here whose ancestor could not be
# ported: `differential.rs` compares TWO compilers, so its oracle dies with
# the bootstrap, and what survives is the bytes it blessed.

use cases
use report
use shell
use suite_annotations
use suite_cache
use suite_canonical
use suite_corpus
use suite_descriptors
use suite_wholes
use suite_seed
use suite_determinism
use suite_emission
use suite_fixes
use suite_golden
use suite_layout
use suite_lines
use suite_lldb
use suite_order
use suite_probe
use suite_records
use suite_runtime
use suite_spec
use suite_grammar
use suite_special
use suite_surface
use suite_units
use suite_warnings
use suite_run
use suite_unseen
use strings

# The prefix of this run's scratch directory; the process id follows it
# (main, below), so that no two runs alive at once share a directory.
constant SCRATCH: str
    "build/harness"

function main()
    given = args()

    # No compiler named: ask the machine which one is here (shell.some_compiler
    # — the seed-built one first, the bootstrap last), so the same invocation
    # works before and after `archive/bootstrap-rs/` is archived. A
    # `HEROES_COMPILER` that is not UTF-8 is told and ends the run, where until
    # defect 243 it read as unset and the net judged another compiler.
    compiler: str @= ""

    if given.len() > 0
        compiler @ shell.started_as(given[0])
    else
        found = shell.some_compiler()

        if found.is_err()
            print("harness: " + reason(found))
            exit(2)
        compiler @ found.must()
    only: str @= ""

    if given.len() > 1
        only @ given[1]
    pick: str @= ""

    if given.len() > 2
        pick @ given[2]

    # The third word narrows a suite to the cases whose name holds it, for the
    # gate of one repair (CLAUDE.md § Verification, 2026-09-29). It binds only
    # the suites that walk cases: over any other it would run the whole suite
    # and read as a filtered green, which is `-- <compiler> golden` selecting
    # nothing (CL-072) in a new coat. So it needs a suite name, the suite must
    # take it, and a filter that selects nothing exits 2 below.
    if pick != "" && only == ""
        print("harness: a case filter needs a suite name: -- <compiler> <suite> " + pick)
        exit(2)

    if pick != "" && !takes_cases(only)
        print("harness: " + only + " walks no cases, so it takes no case filter")
        exit(2)

    # A shard, `<i>/<n>`, binds the suites whose cases are one sorted list, and
    # only a shard that exists (defect 537). Any other suite that takes a filter
    # walks more than that list (`annotations` its run roots' groups, `fixes`
    # its fixtures, `layout` its budgets), so a shard of its list would not be
    # a part of the whole, and `n` of them would not add up to it.
    if cases.is_shard(pick)
        if !takes_shards(only)
            print(
                "harness: " + only + " takes a case filter and no shard: it walks more than one list of cases, so a shard of it would not be a part of the whole"
            )
            exit(2)
        shard = cases.shard_of(pick)

        if shard.is_err()
            print("harness: " + unsharded(shard))
            exit(2)

    # The scratch directory holds the captured streams and the directory
    # listings. It is under build/ because that is the one directory this
    # project already treats as disposable, and it carries this process's
    # id because two harnesses started together used to share one — and a
    # blessing (`UPDATE_EMISSION=1`) wrote the other run's capture to disk
    # while both reported success (M-robustness-guards step 5, found by
    # doing it on 2026-08-28).
    scratch = SCRATCH + "-" + shell.pid().to_str()
    made = shell.mkdir_all(scratch)

    if made.is_err()
        print("harness: cannot create " + scratch)
        exit(2)

    # A compiler named that no case could start is refused here, saying what
    # the path is (defect 332): a directory or a file that will not start was
    # taken, and every case of every suite failed as a program that could not
    # be started. `shell.some_compiler` asks its answer the same question. The
    # scratch held only the start's captures, which went with it.
    if given.len() > 0
        refused = shell.unstartable(scratch: scratch, path: compiler)

        if refused.len() > 0
            print(
                "harness: the compiler named, `" + compiler + "`, cannot be started: " + refused + ", so every case would fail as a program that could not be started"
            )
            print("  build one first, or name its file: heroes run tests/harness/main.hero -- <compiler>")
            _ = shell.remove_tree(scratch).is_err()
            exit(2)

    forms: [suite_golden.Shape] = [
        suite_golden.shape_check()
        suite_golden.shape_ir()
        suite_golden.shape_emit()
        suite_golden.shape_unsupported()
        suite_golden.shape_permissive()
        suite_golden.shape_full()
    ]

    total: report.Report @= report.empty()
    ran: i64 @= 0

    for form in forms
        if only == "" || only == form.name
            got = suite_golden.run_all(scratch: scratch, compiler: compiler, shape: form, only: pick)

            if got.is_err()
                print("harness: the " + form.name + "/ suite could not run" + why(got))
                exit(2)
            print(
                "  " + shown(name: form.name, pick: pick) + ": " + report.counted(got.must())
            )
            total @ report.tally(one: total, two: got.must())
            ran @ ran + 1

    # `run/` is not a Shape: it builds, executes, and asks a different
    # question in each of three configurations, so it carries its own
    # runner rather than a row in the table above.
    if only == "" || only == "run"
        got = suite_run.run_all(scratch: scratch, compiler: compiler, only: pick)

        if got.is_err()
            print("harness: the run/ suite could not run" + why(got))
            exit(2)
        print(
            "  " + shown(name: "run", pick: pick) + ": " + report.counted(got.must())
        )
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The `#~` invariant reads files rather than running the compiler, so
    # it takes no compiler at all — it is about whether the goldens agree
    # with themselves.
    if only == "" || only == "annotations"
        got = suite_annotations.run_all(scratch: scratch, compiler: compiler, only: pick)

        if got.is_err()
            print("harness: the annotations sweep could not run" + why(got))
            exit(2)
        print(
            "  " + shown(name: "annotations", pick: pick) + ": " + report.counted(got.must())
        )
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "determinism"
        got = suite_determinism.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the determinism suite could not run" + why(got))
            exit(2)
        print("  determinism: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The blessed emissions: the differential's successor, and the one
    # suite that can WRITE into the repository — under UPDATE_EMISSION=1
    # and nothing else.
    if only == "" || only == "emission"
        got = suite_emission.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the emission suite could not run" + why(got))
            exit(2)
        print("  emission: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The same blessed bytes, asked a different question: is every
    # descriptor in them both defined and pointed at. Reads files and
    # runs no compiler, so it is the cheapest suite here.
    if only == "" || only == "descriptors"
        got = suite_descriptors.run_all(scratch: scratch)

        if got.is_err()
            print("harness: the descriptors suite could not run" + why(got))
            exit(2)
        print("  descriptors: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The same bytes again, and the seed with them: is every temporary
    # written whole before any part of it (panel 182). No compiler runs.
    if only == "" || only == "wholes"
        got = suite_wholes.run_all(scratch: scratch)

        if got.is_err()
            print("harness: the wholes suite could not run" + why(got))
            exit(2)
        print("  wholes: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The seed against the compiler's own source: what the compiler reads of
    # its own C, the seed defines (panel 222's R3). No compiler runs.
    if only == "" || only == "seed"
        got = suite_seed.run_all(scratch: scratch)

        if got.is_err()
            print("harness: the seed suite could not run" + why(got))
            exit(2)
        print("  seed: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The per-module build cache, asked across TWO invocations with a
    # file edited in between — the one question no golden row can put.
    if only == "" || only == "cache"
        got = suite_cache.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the cache suite could not run" + why(got))
            exit(2)
        print("  cache: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # What ONE translation unit holds, asked of the files a build wrote:
    # the cache suite above asks what the second invocation does, this
    # one asks what the first one produced.
    if only == "" || only == "units"
        got = suite_units.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the units suite could not run" + why(got))
            exit(2)
        print("  units: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "fixes"
        got = suite_fixes.run_default(scratch: scratch, compiler: compiler, only: pick)

        if got.is_err()
            print("harness: the fixes suite could not run" + why(got))
            exit(2)
        print(
            "  " + shown(name: "fixes", pick: pick) + ": " + report.counted(got.must())
        )
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "lines"
        got = suite_lines.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the lines sweep could not run" + why(got))
            exit(2)
        print("  lines: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # What `lines` reads in the emitted C, asked of a debugger reading the
    # binary: a breakpoint on a `.hero` line is hit, stepping walks the
    # author's lines, the frame shows its locals (issue 944). A machine where
    # lldb cannot run says SKIP for each case, with the reason.
    if only == "" || only == "lldb"
        got = suite_lldb.run_all(scratch: scratch, compiler: compiler, only: pick)

        if got.is_err()
            print("harness: the lldb suite could not run" + why(got))
            exit(2)
        print(
            "  " + shown(name: "lldb", pick: pick) + ": " + report.counted(got.must())
        )
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "corpus"
        got = suite_corpus.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the corpus suite could not run" + why(got))
            exit(2)
        print("  corpus: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "warnings"
        got = suite_warnings.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the warnings gate could not run" + why(got))
            exit(2)
        print("  warnings: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The record checks read the tree rather than the compiler, so they
    # take no compiler at all.
    if only == "" || only == "records"
        got = suite_records.run_all(scratch: scratch, only: pick)

        if got.is_err()
            print("harness: the record checks could not run" + why(got))
            exit(2)
        print("  records: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "surface"
        got = suite_surface.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the surface suite could not run" + why(got))
            exit(2)
        print("  surface: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "special"
        got = suite_special.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the special cases could not run" + why(got))
            exit(2)
        print("  special: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The spec's own gate: the budget, and whether the document and the
    # compiler still name the same language.
    if only == "" || only == "spec"
        got = suite_spec.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the spec checks could not run" + why(got))
            exit(2)
        print("  spec: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "grammar"
        got = suite_grammar.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the grammar checks could not run" + why(got))
            exit(2)
        print("  grammar: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if only == "" || only == "layout"
        got = suite_layout.run_all(scratch: scratch, only: pick)

        if got.is_err()
            print("harness: the layout check could not run" + why(got))
            exit(2)
        print(
            "  " + shown(name: "layout", pick: pick) + ": " + report.counted(got.must())
        )
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # design.md §4.15's SECOND purpose, which is a property of the
    # repository rather than of the tool: every source file in canonical
    # form, so that a textual difference between two versions is semantic.
    # 12 s for 371 files (2026-08-28).
    if only == "" || only == "canonical"
        got = suite_canonical.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the canonical check could not run" + why(got))
            exit(2)
        print("  canonical: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The formatter's probe: every comment placement the skeptic seats made
    # by hand, formatted and judged twice in one process (panel 179).
    if only == "" || only == "probe"
        got = suite_probe.run_all(scratch: scratch, compiler: compiler)

        if got.is_err()
            print("harness: the probe rows could not run" + why(got))
            exit(2)
        print("  probe: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # §4.9's mark over the compiler's own map walks. Reads files and runs
    # no compiler, like `layout` beside it.
    if only == "" || only == "order"
        got = suite_order.run_all(scratch)

        if got.is_err()
            print("harness: the order check could not run" + why(got))
            exit(2)
        print("  order: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # Part 7.13's two invariants over the runtime's own C. Reads files and
    # runs no compiler, like `layout` and `order` above it — and unlike
    # every other suite here, its subject is `runtime/` rather than
    # `selfhost/`, the goldens or the corpus.
    if only == "" || only == "runtime"
        got = suite_runtime.run_all(scratch)

        if got.is_err()
            print("harness: the runtime invariants could not run" + why(got))
            exit(2)
        print("  runtime: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    # The documents hold no character their reader cannot see (defect 356,
    # panel 192's R12). Reads files and runs no compiler, like `records`, and
    # beside it rather than in it: what it judges is a document's characters,
    # not a record's shape.
    if only == "" || only == "unseen"
        got = suite_unseen.run_all(scratch)

        if got.is_err()
            print("harness: the unseen check could not run" + why(got))
            exit(2)
        print("  unseen: " + report.counted(got.must()))
        total @ report.tally(one: total, two: got.must())
        ran @ ran + 1

    if ran == 0
        print("harness: no suite named " + only)
        exit(2)

    # A case skipped was selected, so a shard whose every case this machine
    # skipped is told as skipped rather than as selecting nothing.
    if pick != "" && total.passed + total.failed + total.skips.len() == 0
        print(
            "harness: no case of " + only + " matches " + pick + " — a run that selected nothing is a green run that tested nothing"
        )
        exit(2)

    clean = report.verdict(total, "harness")

    # This run's directory is its own (the pid is in the name), so removing
    # it cannot take another run's captures with it. It goes only on a run
    # that reached its verdict: a suite that could not run exits 2 above and
    # leaves the directory for whoever is diagnosing it. It was never removed
    # before this step, measured — `build/harness` outlived every run.
    swept = shell.remove_tree(scratch)

    if swept.is_err()
        print("harness: could not remove " + scratch)
        exit(2)

    if !clean
        exit(1)

# The suites the third word may narrow: the ones that walk cases (the six
# golden forms, `run`, `fixes`, `annotations`, `lldb`), `layout`, which walks
# modules and is asked about one file by the write-time hook, and `records`,
# asked by the same hook about one issue file or one file the code cites a
# defect in (`credit.hero`).
function takes_cases(suite: str) -> bool
    for name in ["check", "ir", "emit", "unsupported", "permissive", "full", "run", "fixes", "annotations", "lldb", "layout", "records"]
        if name == suite
            return true

    return false

# The suites a shard binds: the ones whose cases are one sorted list, the six
# golden forms, `run` (defect 537) and `lldb`. `annotations`, `fixes` and `layout`
# take a filter and no shard, `main` says why.
function takes_shards(suite: str) -> bool
    for name in ["check", "ir", "emit", "unsupported", "permissive", "full", "run", "lldb"]
        if name == suite
            return true

    return false

# Why a word in a shard's shape names no shard, as `cases.shard_of` says it.
function unsharded(got: cases.Shard?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# Why a suite could not run, for the line that says so: the error its run
# carried, which names what stopped it. Every such line dropped it until
# 2026-10-04, when a walk learned to refuse a name that is not UTF-8 by name
# rather than panic (defect 239), and the name would have been lost here.
function why(got: report.Report?) -> str
    return match got
        .ok _  => ""
        .err e => ": " + e.msg

# Why no compiler could be chosen, as `shell.some_compiler` says it.
function reason(got: str?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# The suite's line says when it was narrowed, so a filtered count is never
# read as the whole suite's; a shard's says which, and that the whole suite's
# questions were left to the whole (defect 537).
function shown(name: str, pick: str) -> str
    if pick == ""
        return name
    shard = cases.shard_of(pick)

    if !shard.is_err()
        return name + " (shard " + shard.must().index.to_str() + " of " + shard.must().count.to_str() + ", its floor and skip ratio left to the whole suite)"

    return name + " (only " + pick + ")"

# **THE HARNESS'S OTHER ROOT**, the issue program `ISSUE_PROGRAM`
# (`.claude/rules/records.md` § The issues), a program of its own beside this
# one. `heroes test` takes one file and runs the tests of the modules that file
# reaches, so the nineteen modules only the issue program reaches
# (`issue_links`, `issue_write`, `issue_draft` and the rest) were tested by no
# runner: this root's closure reached none of them, and nothing, no suite, CI
# step or hook, ran `heroes test tests/harness/issues.hero` (defect 2064,
# measured 2026-10-14: 162 tests, all passed, 20.46 s alone). So the net's own
# tests run that root's tests too, on every machine and every CI leg that runs
# these, through the one runner, and ask its count of the files.
constant ISSUE_PROGRAM: str
    "tests/harness/issues.hero"

# Every module the root `root` reaches through its `use` lines, the root among
# them, each a file of `dir`, in the order they are found. A `use` of any
# other shape, or one naming no file there, is a failure rather than a module
# left out, since a module left out is a count that agrees by accident.
function reached(dir: str, root: str) -> [str]?
    out: [str] @= []
    seen: {str: bool} @= {}
    waiting: [str] @= [root]

    while waiting.len() > 0
        name = waiting[waiting.len() - 1]
        waiting @ waiting.slice(from: 0, to: waiting.len() - 1)

        if !seen[name].is_err()
            continue
        seen[name] @ true
        text = read_file(dir + "/" + name + ".hero")

        if text.is_err()
            return fail(code: "absent", msg: "`use " + name + "` names no module " + dir + "/" + name + ".hero")
        out @ out.push(name)

        for line in strings.lines(text.must())
            if !strings.starts_with(text: line, prefix: "use ")
                continue
            used = strings.without_prefix(text: line, prefix: "use ")

            if used.len() == 0 || strings.words(used).len() != 1 || strings.contains(text: used, needle: "/")
                return fail(
                    code: "shape",
                    msg: dir + "/" + name + ".hero: `" + line + "` is not `use <module>`, which this count reads"
                )
            waiting @ waiting.push(used)

    return ok(out)

# How many `test` blocks open in the modules `root` reaches: what `heroes test`
# runs of it.
function blocks(dir: str, root: str) -> i64?
    count: i64 @= 0

    for name in reached(dir: dir, root: root)?
        for line in strings.lines(read_file(dir + "/" + name + ".hero")?)
            if strings.starts_with(text: line, prefix: "test \"")
                count @ count + 1

    return ok(count)

# The `SKIP` lines a test run printed, each with the reason lines indented
# beneath it, in order.
function skips_in(out: str) -> [str]
    said: [str] @= []
    inside: bool @= false

    for line in strings.lines(out)
        if strings.starts_with(text: line, prefix: "SKIP ")
            inside @ true
            said @ said.push(line)
        else if inside && strings.starts_with(text: line, prefix: "  ")
            said @ said.push(line)
        else
            inside @ false

    return said

# The lines of a test run of the root reaching `modules` that are none of a
# run's own: not `ok`, not `FAIL`, not its count, and not a test's own `SKIP`,
# which names the module it stands in (`SKIP issue_draft: ...`) with its
# reasons indented beneath. **A test that prints a fixture's output prints
# here** (defect 2069): report.hero's tests printed four fixture verdicts,
# `SKIP unsupported/x` among them, into every run until 2026-10-14, where a
# fixture's skip read as the run's.
function strays(out: str, modules: [str]) -> [str]
    said: [str] @= []
    inside: bool @= false

    for line in strings.lines(out)
        if inside && strings.starts_with(text: line, prefix: "  ")
            continue
        inside @ false
        words = strings.words(line)

        if words.len() > 1 && words[0] == "SKIP" && strings.ends_with(text: words[1], suffix: ":") && named(modules: modules, name: strings.without_suffix(text: words[1], suffix: ":"))
            inside @ true
            continue

        if line == "" || strings.starts_with(text: line, prefix: "ok   \"") || strings.starts_with(text: line, prefix: "FAIL \"")
            continue

        if counts(words)
            continue
        said @ said.push(line)

    return said

# Whether a line's words are the runner's count, `<n> tests, ...`, or `1 test,
# ...` (`selfhost/cli/verbs.hero`'s `run_test`).
function counts(words: [str]) -> bool
    return words.len() > 1 && (words[1] == "tests," || words[1] == "test,") && !strings.to_number(words[0]).is_err()

function named(modules: [str], name: str) -> bool
    for one in modules
        if one == name
            return true

    return false

test "a run's own lines are its verdicts, its count and its tests' skips, and a fixture's are strays (defect 2069)"
    modules = ["issue_git", "report"]
    own = "ok   \"a\"\nSKIP issue_git: a pin\n  this clone's history is shortened\nFAIL \"b\"\n2 tests, 1 failed\n"
    assert strays(out: own, modules: modules).len() == 0
    printed = "ok   \"a\"\nSKIP unsupported/x\n  clang does not find `gone.h` on this machine\nself-test: 1 passed, 0 failed\nFLOOR canonical\n  files: 1200\n1 test, all passed\n"
    assert strays(out: printed, modules: modules) == ["SKIP unsupported/x", "  clang does not find `gone.h` on this machine", "self-test: 1 passed, 0 failed", "FLOOR canonical", "  files: 1200"]
    assert counts(["1", "test,", "all", "passed"])
    assert counts(["164", "tests,", "2", "failed"])
    assert !counts(["self-test:", "1", "passed,"])
    assert strays(out: "SKIP elsewhere: x\n", modules: modules) == ["SKIP elsewhere: x"]

test "a run's skips are read with their reasons, and nothing else"
    assert skips_in("ok   \"a\"\nSKIP x: y\n  because\n  and so\nok   \"b\"\n  not a reason\nSKIP z\n") == ["SKIP x: y", "  because", "  and so", "SKIP z"]
    assert skips_in("ok   \"a\"\n").len() == 0

test "the modules a root reaches are read from its use lines, and one naming no file is no module"
    assert reached(dir: "tests/harness", root: "issues").must().len() > reached(dir: "tests/harness", root: "report").must().len()
    assert reached(dir: "tests/harness", root: "issues").must()[0] == "issues"
    assert !strings.contains(text: reached(dir: "tests/harness", root: "issues").must().join(" "), needle: "suite_")
    assert reached(dir: "tests/harness", root: "no_such_module").is_err()
    assert blocks(dir: "tests/harness", root: "issues").must() > blocks(dir: "tests/harness", root: "issue_links").must()

test "the issue program's own tests run with the net's own, every block its modules hold and all passed (defect 2064)"
    compiler = shell.some_compiler().must()
    scratch = shell.own_scratch()
    ran = shell.run(scratch: scratch, program: compiler, words: [compiler, "test", ISSUE_PROGRAM]).must()
    failed: [str] @= []

    for line in strings.lines(ran.out)
        if strings.starts_with(text: line, prefix: "FAIL \"")
            failed @ failed.push(line)

    # A test the issue program's run stepped aside is said here too, with its
    # reason, so the net's own run is never a silent pass over what it did not
    # ask (defect 2065).
    for line in skips_in(ran.out)
        print(ISSUE_PROGRAM + ": " + line)

    # The failing tests by name, then the whole verdict, then any line a test
    # printed that is not the run's own (defect 2069).
    assert failed.join("\n") == ""
    assert ran.code == 0
    assert strays(out: ran.out, modules: reached(dir: "tests/harness", root: "issues").must()).join("\n") == ""
    held = blocks(dir: "tests/harness", root: "issues").must()
    said: [str] @= []

    # The runner's verdict is the one line `<n> tests, ...`.
    for line in strings.lines(ran.out)
        if counts(strings.words(line))
            said @ said.push(line)

    assert said == [held.to_str() + " tests, all passed"]
    assert !shell.remove_tree(scratch).is_err()

test "the third word binds the suites that walk cases, records narrowed to a path, and no other"
    assert takes_cases("check")
    assert takes_cases("permissive")
    assert takes_cases("full")
    assert takes_cases("run")
    assert takes_cases("fixes")
    assert takes_cases("layout")
    assert takes_cases("lldb")

    # `records` takes a path since 2026-10-11, the write hook's question of
    # one issue file or one file citing a defect (`credit.hero`); it walks no
    # cases and takes no shard.
    assert takes_cases("records")
    assert !takes_shards("records")
    assert !takes_cases("emission")
    assert !takes_cases("spec")
    assert !takes_cases("")

test "a narrowed suite says so on its line"
    assert shown(name: "check", pick: "") == "check"
    assert shown(name: "check", pick: "fixedbugs-133") == "check (only fixedbugs-133)"
    assert shown(name: "run", pick: "2/6") == "run (shard 2 of 6, its floor and skip ratio left to the whole suite)"

test "a shard binds the suites whose cases are one list, and says why a word names none"
    for name in ["check", "ir", "emit", "unsupported", "permissive", "full", "run", "lldb"]
        assert takes_shards(name)
        assert takes_cases(name)

    # A suite that takes a filter and walks more than one list takes no shard.
    for name in ["annotations", "fixes", "layout", "records", ""]
        assert !takes_shards(name)

    assert unsharded(cases.shard_of("5/4")) == "`5/4` names no shard: a shard is `<i>/<n>`, the i-th of n, with 1 <= i <= n"
    assert unsharded(cases.shard_of("2/4")) == ""

test "a suite that could not run says what stopped it"
    stopped: report.Report? = fail(code: "not_text", msg: "the name of `x/caf<0xE9>.hero` is not UTF-8")
    assert why(stopped) == ": the name of `x/caf<0xE9>.hero` is not UTF-8"
    ran: report.Report? = ok(report.empty())
    assert why(ran) == ""
