# One invocation of the compiler, and everything a surface test asks
# about it — as data.
#
# `surface.rs` is 69 tests over 2,139 lines, and the shape of most of them
# is one sentence: run this argv, get this exit code, find these words on
# this stream and not those. Written out as Heroes functions that would be
# 69 near-identical blocks; written as a table it is 69 rows, and the rows
# are readable side by side, which is how a reader checks that the surface
# is covered.
#
# What does NOT fit the table gets a function of its own (suite_surface's
# second half): a test that runs the binary it just built, one that
# changes the child's working directory, one that drives clang instead of
# the compiler, one that compares two invocations against each other.
# Panel 016's contract is the reason those exist at all — the surface is
# what a user types, so a test of it has to type.
#
# Every field is "don't care" until it is set. The CHAIN that sets them
# lives in the module that writes the tables, and that is a fact about the
# language rather than a preference: UFCS does not cross a module
# boundary. `box.make(1).plus(2)` is `error[needs_qualifying]` — measured
# on both compilers, with and without an argument — because a name from
# another module is always written qualified (spec § 1 Files and layout), and `x.f(y)` names
# `f` unqualified. So `probe.Probe` travels between modules and the sugar
# that builds one does not.

use absence
use report
use shell
use strings

record Probe
    name: str
    argv: str
    code: i64
    out_has: [str]
    out_lacks: [str]
    err_has: [str]
    err_lacks: [str]
    out_starts: str
    err_starts: str
    out_is: str
    err_is: str
    out_state: str
    err_state: str
    err_lines: i64
    out_lines_max: i64
    library_skip: bool

# A probe with everything unasked. `code` is -1 for "do not care", which
# is what the exit-code-only tests need to say about the streams.
function probe(name: str, argv: str, code: i64) -> Probe
    none: [str] = []
    return Probe(
        name: name,
        argv: argv,
        code: code,
        out_has: none,
        out_lacks: none,
        err_has: none,
        err_lacks: none,
        out_starts: "",
        err_starts: "",
        out_is: "",
        err_is: "",
        out_state: "",
        err_state: "",
        err_lines: -1,
        out_lines_max: -1,
        library_skip: false
    )

# One sentence, as the words a shell would have made of it — separated by
# runs of spaces, with none of the quoting rules, because the table has
# nothing to quote.
function words_of(line: str) -> [str]
    out: [str] @ []
    word: str @ ""

    for ch in line.chars()
        if ch == " "
            if word.len() > 0
                out @ out.push(word)
                word @ ""
        else
            word @ word + ch

    if word.len() > 0
        out @ out.push(word)

    return out

# Run one probe. Answers "" where it held, the failure text where it did
# not, and "SKIP" where the machine lacks the library (`outcome` says which).
function unmet(scratch: str, compiler: str, p: Probe) -> str
    got = outcome(scratch: scratch, compiler: compiler, p: p)

    if got.kind == "skipped"
        return "SKIP"
    return got.text

# What one probe came to: `held`, `failed` with the text saying how, or
# `skipped` with the text saying which library this machine lacks.
record Outcome
    kind: str
    text: str

function outcome(scratch: str, compiler: str, p: Probe) -> Outcome
    # **`argv` is a sentence and the runtime wants words**, so it is split
    # here, on spaces, once. The table's 91 rows were checked: not one of
    # them carries an argument with a space inside it, so the split is
    # exact rather than a guess — and it is a fact about the table, which
    # this file can see, rather than a premise about arguments in general.
    said = shell.run_guarded(scratch: scratch, words: shell.both(first: [compiler], second: words_of(p.argv)))

    # The refusal's own words (defect 317).
    if said.is_err()
        return Outcome(kind: "failed", text: "  `" + p.argv + "`: " + shell.refusal(said))
    why = skip_of(scratch: scratch, p: p, said: said.must())

    if why.kind == "skipped"
        return why
    wrong = judged(p: p, said: said.must())

    if wrong.len() == 0
        return Outcome(kind: "held", text: "")

    if why.text.len() > 0
        return Outcome(kind: "failed", text: wrong + "\n  not skipped for a missing library: " + why.text)
    return Outcome(kind: "failed", text: wrong)

# Whether a row that may skip is skipped: the machine's answer only where the
# case its argv names binds what the compiler says is missing and the machine,
# asked, lacks it (`absence`). Until defect 246 the compiler's words alone made
# the skip. A row whose own needles ask about a missing-library message is
# that message's test, so it is never skipped, and neither is a row whose
# argv names no case to ask. `kind` is `skipped` with the reason, or `held`
# with why a skip the compiler's words asked for was refused ("" when none was).
function skip_of(scratch: str, p: Probe, said: shell.Run) -> Outcome
    if !p.library_skip || said.code == 0 || asks_about_absence(p)
        return Outcome(kind: "held", text: "")
    path = case_of(p.argv)

    if path.len() == 0
        return Outcome(kind: "held", text: "")
    lacks = absence.machine_lacks(scratch: scratch, path: path, expected: "", said: said.err)

    if !lacks.is_err()
        return Outcome(kind: "skipped", text: lacks.must())
    return Outcome(kind: "held", text: absence.refused(lacks))

# The case a row's argv hands the compiler: its first word ending in `.hero`,
# "" where there is none.
function case_of(argv: str) -> str
    for word in words_of(argv)
        if strings.ends_with(text: word, suffix: ".hero")
            return word

    return ""

# Whether a row's needles ask about a missing-library message itself.
function asks_about_absence(p: Probe) -> bool
    asked: [str] @ [p.out_starts, p.err_starts, p.out_is, p.err_is]

    for needle in p.out_has
        asked @ asked.push(needle)

    for needle in p.err_has
        asked @ asked.push(needle)

    for one in asked
        if strings.contains(text: one, needle: "ffi_missing_header") || strings.contains(text: one, needle: "ffi_package") || strings.contains(text: one, needle: "pkg-config is not on this machine")
            return true

    return false

# Every way one invocation disappointed a probe, "" where none did.
function judged(p: Probe, said: shell.Run) -> str
    out = said.out
    err = said.err
    wrong: [str] @ []

    if p.code >= 0 && said.code != p.code
        wrong @ wrong.push("    exited " + said.code.to_str() + ", not " + p.code.to_str())

    if p.out_state == "empty" && out.len() > 0
        wrong @ wrong.push("    stdout should be empty and holds " + out.len().to_str() + " bytes")

    if p.out_state == "nonempty" && out.len() == 0
        wrong @ wrong.push("    stdout is empty")

    if p.err_state == "empty" && err.len() > 0
        wrong @ wrong.push("    stderr should be empty and holds:\n" + err)

    if p.err_state == "nonempty" && err.len() == 0
        wrong @ wrong.push("    stderr is empty")

    if p.out_is.len() > 0 && out != p.out_is
        wrong @ wrong.push(
            "    stdout is not what it must be\n--- expected ---\n" + p.out_is + "--- actual ---\n" + out + "--- end ---"
        )

    if p.err_is.len() > 0 && err != p.err_is
        wrong @ wrong.push(
            "    stderr is not what it must be\n--- expected ---\n" + p.err_is + "--- actual ---\n" + err + "--- end ---"
        )

    if p.out_starts.len() > 0 && !strings.starts_with(text: out, prefix: p.out_starts)
        wrong @ wrong.push("    stdout does not start with `" + p.out_starts + "`, it starts:\n" + first_line(out))

    if p.err_starts.len() > 0 && !strings.starts_with(text: err, prefix: p.err_starts)
        wrong @ wrong.push("    stderr does not start with `" + p.err_starts + "`, it starts:\n" + first_line(err))

    for needle in p.out_has
        if !strings.contains(text: out, needle: needle)
            wrong @ wrong.push("    stdout does not carry `" + needle + "`")

    for needle in p.out_lacks
        if strings.contains(text: out, needle: needle)
            wrong @ wrong.push("    stdout carries `" + needle + "` and must not")

    for needle in p.err_has
        if !strings.contains(text: err, needle: needle)
            wrong @ wrong.push("    stderr does not carry `" + needle + "`")

    for needle in p.err_lacks
        if strings.contains(text: err, needle: needle)
            wrong @ wrong.push("    stderr carries `" + needle + "` and must not")

    if p.err_lines >= 0 && strings.lines(err).len() != p.err_lines
        wrong @ wrong.push(
            "    stderr has " + strings.lines(err).len().to_str() + " lines, not " + p.err_lines.to_str()
        )

    if p.out_lines_max >= 0 && strings.lines(out).len() > p.out_lines_max
        wrong @ wrong.push(
            "    stdout has " + strings.lines(out).len().to_str() + " lines, and must have at most " + p.out_lines_max.to_str()
        )

    if wrong.len() == 0
        return ""
    return "  `heroes " + p.argv + "`\n" + wrong.join("\n") + "\n  its stdout was:\n" + out + "  its stderr was:\n" + err

function first_line(text: str) -> str
    rows = strings.lines(text)

    if rows.len() == 0
        return "(nothing)"
    return "      " + rows[0]

# Run a table of probes into a report, with the skips floored: a machine
# missing every library must say so rather than report green.
function run_table(scratch: str, compiler: str, probes: [Probe], @r: report.Report)
    skipped: i64 @ 0

    for p in probes
        got = outcome(scratch: scratch, compiler: compiler, p: p)

        if got.kind == "skipped"
            skipped @ skipped + 1
            report.keep_skip(@r, label: "surface/" + p.name, detail: "  " + got.text)
        else if got.kind == "held"
            report.keep_pass(@r)
        else
            report.keep_failure(@r, label: "surface/" + p.name, detail: got.text)

    # A MAJORITY of skips is a machine testing nothing, and that stays red.
    # The line moved from one-third to one-half on 2026-08-31, measured on the
    # Windows leg: 7 of 17 probes there bind sqlite or curl through pkg-config,
    # which that platform does not carry, and the other 10 — exit codes,
    # streams, diagnostics, mutate — all run. A leg that asks 10 real questions
    # is testing the surface; the floor exists for the leg that asks none.
    if skipped > 0 && skipped * 2 > probes.len()
        report.keep_failure(
            @r,
            label: "surface",
            detail: "  " + skipped.to_str() + " of " + probes.len().to_str() + " probes were skipped for a missing library — this machine is not testing the surface"
        )

# DEFECT 246's cause here, held as a test (2026-10-04): a row that may skip was
# skipped on the compiler's words alone. A header the machine has, said to be
# missing, fails with the reason; a header no machine has, which the row's case
# binds, is skipped and named; and a row that asks about the missing-library
# message itself is that message's test, judged when the message changes.
test "fixedbugs: a row that may skip is skipped only where the machine lacks what its case binds"
    if !shell.can_run_scripts()
        return
    scratch = "build/harness-selftest"
    tree = scratch + "/probe-absence"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    has = absence.planted_case(dir: tree, name: "has", bound: "stdio.h", missing: "stdio.h")
    assert !has.is_err()
    refuted: Probe @ probe(name: "has", argv: "build " + has.must(), code: 1)
    refuted.library_skip @ true
    refuted.err_has @ ["error[ffi_return_type]"]
    got = outcome(scratch: scratch, compiler: compiler.must(), p: refuted)
    assert got.kind == "failed"
    assert strings.contains(text: got.text, needle: "not skipped for a missing library: clang finds `stdio.h`")
    lacks = absence.planted_case(dir: tree, name: "lacks", bound: absence.NOWHERE, missing: absence.NOWHERE)
    assert !lacks.is_err()
    excused: Probe @ probe(name: "lacks", argv: "build " + lacks.must(), code: 1)
    excused.library_skip @ true
    excused.err_has @ ["error[ffi_return_type]"]
    assert outcome(scratch: scratch, compiler: compiler.must(), p: excused).kind == "skipped"
    assert unmet(scratch: scratch, compiler: compiler.must(), p: excused) == "SKIP"
    asking: Probe @ probe(name: "asking", argv: "build " + lacks.must(), code: 1)
    asking.library_skip @ true
    asking.err_has @ ["error[ffi_missing_header]", "clang looked and found nothing"]
    assert outcome(scratch: scratch, compiler: compiler.must(), p: asking).kind == "failed"

    # And a table names the skip, beside the failure.
    r: report.Report @ report.empty()
    run_table(scratch: scratch, compiler: compiler.must(), probes: [excused, refuted], r: @r)
    assert r.skips.len() == 1
    assert strings.starts_with(text: r.skips[0], prefix: "SKIP surface/lacks\n")
    assert r.failed == 1
