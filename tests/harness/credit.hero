# WHO GOT THERE FIRST, AND WHAT A DEFECT'S NUMBER RESOLVES TO.
#
# The readings behind two checks of the `records` suite, each the executor of a
# rule the author gave on 2026-10-07 (`.claude/rules/records.md` § And the
# record says whose idea it was, and `.claude/rules/records.md` § The issues;
# CL-082 and CL-083):
#
# - **prior art**: a `## Prior art` section stands only on a `decision` of a
#   sitting the historian sat in; it opens with the sitting's file and the day
#   its links were re-read; every other line is one precedent, `Taken from` or
#   `Reached first by`, with its link; it is never empty, and a heading that is
#   nearly it is told. And a closed `feature` or `task` holds `## What was
#   done`, naming its card's commit. `section_offences` is the rule, which the
#   transcription program's `file` asks of a draft (`issue_offences`) and
#   `records_github.hero` of every issue GitHub holds (`records/prior-art`),
#   the second excusing a sitting the tree under test has not received yet
#   (`absent_offence`, defect 2039).
# - **`records/defects-cited`**: every `defect NNN` the compiler, the runtime,
#   the seed and the tests cite names a defect. Since the issues left the tree
#   (the author's seven answers of 2026-10-12) the names are GitHub's: an old
#   defect's number, 001 to 677, in its issue's title or as a later item of a
#   file of several, and a new defect's own issue number
#   (`records_github.register_of`); the full run reads them from GitHub and
#   keeps them in `build/`, which the write hook's run narrowed to one file
#   reads (`suite_records.hero`'s `REGISTER`).
#
# **The citations are asked of git, not read by this module**: the four roots
# held 125 MB on 2026-10-11, the seed 52 MB of it, and one `git grep` over
# them answered in two seconds where a walk in this language reads every byte.
# `ignored_by_git` in `suite_records.hero` took the same road for the same
# reason, and the grep's count stands on a floor, so a grep that read nothing
# is a red and not a green that tested nothing.
#
# **A test below spells the word in two pieces** where it cites a number no
# issue holds, because the grep reads this file too.

use cards
use floors
use report
use shell
use strings

constant PRIOR_ART: str
    "## Prior art"

constant WHAT_WAS_DONE: str
    "## What was done"

constant TAKEN: str
    "- **Taken from "

constant REACHED: str
    "- **Reached first by "

constant SITTINGS: str
    "docs/panel/"

# The roots whose citations are held to the register: the compiler, the
# runtime, the seed and the tests (`.claude/rules/records.md` § The issues).
constant CITED_ROOTS: [str]
    ["selfhost", "runtime", "seed", "tests"]

# The citations the check resolved on 2026-10-11, the day it was written: a
# run that reads fewer is not reading the tree, and one past it by more than
# `floors.SLACK` is told the number to write here.
constant CITED_FLOOR: i64
    7457

constant LABEL_CITED: str
    "records/defects-cited"

# The lines a heading opens in a body, the heading left out, up to the next
# `## ` heading or the end.
record Section
    found: bool
    rows: [str]

function section_of(body: str, heading: str) -> Section
    rows = strings.lines(body)
    none: [str] = []
    i: i64 @= 0

    while i < rows.len()
        if strings.trimmed(rows[i]) == heading
            taken: [str] @= []
            j: i64 @= i + 1

            while j < rows.len() && !strings.starts_with(text: strings.trimmed(rows[j]), prefix: "## ")
                taken @ taken.push(rows[j])
                j @ j + 1

            return Section(found: true, rows: taken)
        i @ i + 1

    return Section(found: false, rows: none)

# A heading that is nearly `## Prior art` and is not it: another level,
# another case, a colon. Told, because a check that reads the exact heading
# alone would pass a section it never read.
function near_misses(body: str) -> [str]
    out: [str] @= []

    for row in strings.lines(body)
        line = strings.trimmed(row)

        if !strings.starts_with(text: line, prefix: "#")
            continue

        if line == PRIOR_ART
            continue

        if strings.contains(text: line, needle: "rior art") || strings.contains(text: line, needle: "rior Art") || strings.contains(text: line, needle: "RIOR ART")
            out @ out.push(line)

    return out

# The code spans of a line, what stands between backticks, in order.
function code_spans(line: str) -> [str]
    parts = strings.split_on(text: line, byte: '`')
    out: [str] @= []
    i: i64 @= 1

    while i < parts.len()
        out @ out.push(parts[i])
        i @ i + 2

    return out

# Whether `line` says `read YYYY-MM-DD` with a day of the calendar: the day
# every link of the section was re-read.
function names_read_day(line: str) -> bool
    i: i64 @= 0

    while i + 15 <= line.len()
        if has_at(text: line, at: i, piece: "read ") && cards.looks_like_day(text: line, at: i + 5)
            return true
        i @ i + 1

    return false

# The sittings' files the opener names: every code span under `docs/panel/`
# that the tree holds and that is not a report of a sitting's folder. One issue
# may carry several sittings (a card ratifying seven of them in one act), and
# each is held to the same question, so the opener names them all.
function sittings_named(line: str, known: {str: bool}) -> [str]
    out: [str] @= []

    for span in code_spans(line)
        if !strings.starts_with(text: span, prefix: SITTINGS)
            continue

        if strings.contains(text: span, needle: "-reports/")
            continue

        if !known[span].is_err()
            out @ out.push(span)

    return out

# Every path under `docs/panel/` the opener names in a code span, a report of
# a sitting's folder aside: what `sittings_named` keeps where the tree holds
# it, and what `absent_offence` judges where it does not.
function panel_spans(line: str) -> [str]
    out: [str] @= []

    for span in code_spans(line)
        if strings.starts_with(text: span, prefix: SITTINGS) && !strings.contains(text: span, needle: "-reports/")
            out @ out.push(span)

    return out

# The number a sitting's file opens its name with, where `path` is one:
# `docs/panel/<digits>-<slug>.md`, directly under the folder, the slug not
# empty. A brief, a report, a folder or any other path is not a sitting's file.
function sitting_number(path: str) -> i64?
    wrong = "`" + path + "` is not a sitting's file, `" + SITTINGS + "<number>-<slug>.md`"

    if !strings.starts_with(text: path, prefix: SITTINGS) || !strings.ends_with(text: path, suffix: ".md")
        return fail(code: "shape", msg: wrong)
    name = strings.without_prefix(text: path, prefix: SITTINGS)
    digits = digit_run(text: name, at: 0)

    if strings.contains(text: name, needle: "/") || digits == 0 || !has_at(text: name, at: digits, piece: "-") || name.len() <= digits + 1 + 3
        return fail(code: "shape", msg: wrong)

    # Digits are ASCII, so the cut stands between characters.
    return strings.to_number(name.slice(from: 0, to: digits))

# The highest number of a sitting's file `known` holds, or 0 where it holds
# none.
function highest_sitting(known: {str: bool}) -> i64
    top: i64 @= 0

    for path in keys(known)
        n = sitting_number(path)

        if !n.is_err() && n.must() > top
            top @ n.must()

    return top

# What is wrong with a `docs/panel/` path an opener names, or "" where the tree
# holds it or has not received it yet.
#
# **`received` places the tree among the sittings, from its own value**
# (defect 2039): the highest sitting it holds, as `highest_sitting` reads it.
# Sittings are numbered in the order they sit, so a tree whose highest is 212
# has received no sitting from 213 on, and a sitting's file numbered above
# `received` is one this tree cannot hold yet: its decision was opened from the
# sitting's own lane before the file reached any other tree (`/panel` step 4,
# which `file` asks against that lane's tree). One numbered at or below it is
# misnamed, gone, or merged out of order, and stays an offence, which is the
# loud direction should the order ever break; so does a path that is not a
# sitting's file. **0 excuses nothing**: what `file` asks of a draft, filed from
# the tree that holds its sitting, and what a tree holding no sitting gets, since
# a tree that places itself nowhere is no evidence of being early.
function absent_offence(span: str, known: {str: bool}, received: i64) -> str
    if !known[span].is_err()
        return ""
    n = sitting_number(span)

    if n.is_err()
        return "a path this tree does not hold, and not a sitting's file `" + SITTINGS + "<number>-<slug>.md` either"

    if received > 0 && n.must() > received
        return ""

    if received == 0
        return "a sitting's file this tree does not hold"
    return "a sitting's file this tree does not hold, and its number is not above " + received.to_str() + ", the highest sitting the tree holds, so the name is misnamed, gone or merged out of order rather than not yet received"

# Whether the historian sat: the sitting's folder holds its report, or the
# synthesis names the seat.
function historian_sat(sitting: str, known: {str: bool}) -> bool
    slash = strings.index_of(text: sitting, needle: "-")

    if !slash.is_err()
        # The sitting's number and its dash open the name after the folder, so
        # the cut stands after the number.
        folder = sitting.slice(from: 0, to: slash.must()) + "-reports/historian.md"

        if !known[folder].is_err()
            return true
    text = read_file(sitting)

    if text.is_err()
        return false

    return strings.contains(text: text.must(), needle: "historian")

# What is wrong with one line of the section, or "" where it is a precedent
# in one of the two forms with its link.
function precedent_offence(row: str) -> str
    line = strings.trimmed(row)

    if line == ""
        return ""

    if !strings.starts_with(text: line, prefix: TAKEN) && !strings.starts_with(text: line, prefix: REACHED)
        return "is neither `- **Taken from <who>**:` nor `- **Reached first by <who>**:`, the two forms a precedent takes, and a sentence about an absence is not one"

    if !strings.contains(text: line, needle: "**: [")
        return "names no reference: the form is `- **Taken from <who>**: [<reference>](<url>): <what>`"

    if !strings.contains(text: line, needle: "](http")
        return "carries no link, and a precedent nobody can open is a claim"

    return ""

# Every offence of a `## Prior art` section standing on `issue`, a draft: its
# sitting is asked of the tree it is filed from, which holds it, so no sitting
# is excused as not yet received (`received` 0, `absent_offence`).
function prior_art_offences(issue: cards.Issue, section: Section, known: {str: bool}) -> [str]
    return section_offences(where: issue.path, kind: issue.card.kind, rows: section.rows, known: known, received: 0)

# Every offence of a prior-art section's `rows`, standing on an issue of `kind`
# that a message names `where`: a file's path, or an issue's address.
# `received` is the highest sitting the tree is placed at, 0 for none
# (`absent_offence`).
function section_offences(where: str, kind: str, rows: [str], known: {str: bool}, received: i64) -> [str]
    out: [str] @= []
    told = where + ": `## Prior art` "

    if kind != "decision"
        out @ out.push(
            told + "stands on a `" + kind + "`, and only the decision issue of a sitting carries one; a defect, a feature or a task says *Ruled by panel NNN* and links it"
        )
    opener: str @= ""
    precedents: i64 @= 0
    i: i64 @= 0

    while i < rows.len()
        row = rows[i]
        i @ i + 1

        if strings.trimmed(row) == ""
            continue

        if opener == ""
            opener @ row
            continue
        wrong = precedent_offence(row)

        if wrong != ""
            out @ out.push(told + "line `" + strings.trimmed(row) + "` " + wrong)
        else
            precedents @ precedents + 1

    if opener == ""
        out @ out.push(told + "is empty: a section that names no precedent is left out, not written")
        return out
    spans = panel_spans(opener)

    if spans.len() == 0
        out @ out.push(
            told + "opens with `" + strings.trimmed(opener) + "`, which names no sitting's file under `docs/panel/` in a code span"
        )

    # Each path is judged, so a misnamed one beside a sitting the tree holds is
    # told too; a sitting not yet received is asked nothing more, its file and
    # its folder being where this tree cannot read them.
    for span in spans
        wrong = absent_offence(span: span, known: known, received: received)

        if wrong != ""
            out @ out.push(told + "opens with `" + strings.trimmed(opener) + "`, which names `" + span + "`, " + wrong)

    for sitting in sittings_named(line: opener, known: known)
        if !historian_sat(sitting: sitting, known: known)
            out @ out.push(
                told + "rests on " + sitting + ", a sitting the historian did not sit in: no report of theirs in its folder and no mention in the synthesis"
            )

    if !names_read_day(opener)
        out @ out.push(
            told + "opens with `" + strings.trimmed(opener) + "`, which does not say `read YYYY-MM-DD`, the day every link was re-read"
        )

    if precedents == 0
        out @ out.push(told + "holds no precedent line after its opener")

    return out

# What is wrong with a closed feature's or task's `## What was done`, or "".
function done_offence(issue: cards.Issue) -> str
    section = section_of(body: issue.body, heading: WHAT_WAS_DONE)
    where = issue.path + ": a closed `" + issue.card.kind + "` "

    if !section.found
        return where + "holds no `## What was done` section, and its GitHub issue would say nothing of what it delivered"
    text: str @= ""

    for row in section.rows
        text @ text + " " + strings.trimmed(row)

    if strings.trimmed(text) == ""
        return where + "holds an empty `## What was done`"
    commit = issue.card.commit

    if commit == "self"
        if !strings.contains(text: text, needle: "self")
            return where + "says what was done and not that the commit is this file's own (`self`), as its card says"

        return ""

    if cards.is_full_hash(commit)
        # Forty hex digits, so the cut stands between characters.
        short = commit.slice(from: 0, to: 8)

        if !strings.contains(text: text, needle: short)
            return where + "says what was done and does not name its card's commit, `" + short + "`"

        return ""

    return where + "has `commit: " + commit + "` on its card, so `## What was done` cannot name the commit: fill the card first"

# Every offence of one issue file against the sections' rules: a heading
# nearly `## Prior art`, the section itself, and a closed feature's or task's
# `## What was done`. `known` is every path the tree holds, which a sitting's
# file is asked of. What `file` asks of a draft before it opens its issue.
function issue_offences(issue: cards.Issue, known: {str: bool}) -> [str]
    offences: [str] @= []

    for line in near_misses(issue.body)
        offences @ offences.push(
            issue.path + ": `" + line + "` is nearly the heading, which is `## Prior art` exactly, and a section under another spelling is one no check reads"
        )

    section = section_of(body: issue.body, heading: PRIOR_ART)

    if section.found
        for wrong in prior_art_offences(issue: issue, section: section, known: known)
            offences @ offences.push(wrong)

    if !issue.open && (issue.card.kind == "feature" || issue.card.kind == "task")
        wrong = done_offence(issue)

        if wrong != ""
            offences @ offences.push(wrong)

    return offences

# How many digits stand at `at`.
function digit_run(text: str, at: i64) -> i64
    n: i64 @= 0

    while at + n < text.len() && cards.is_digit_byte(text[at + n])
        n @ n + 1

    return n

# Whether `piece` stands at `at`, read byte by byte: a slice of the line
# would split a character where `piece` is shorter than the one standing
# there, as `, ` is against the em dash of `**235 — a title**`.
function has_at(text: str, at: i64, piece: str) -> bool
    if at + piece.len() > text.len()
        return false
    j: i64 @= 0

    while j < piece.len()
        if text[at + j] != piece[j]
            return false
        j @ j + 1

    return true

# The numbers a list names from `at`: `235`, `324 and 325`, `018 to 021`,
# `130, 131`; and not the day of `130, 2026-09-28` nor the lane of `130, lane
# b6`. A number of the old series has at most three digits; `wide` reads one
# of any length as well, a new defect's issue number, `2031`, and a run of
# digits a `-` and another digit follow is a day and ends the list.
function numbers_after(text: str, at: i64, wide: bool) -> [i64]
    out: [i64] @= []
    i: i64 @= at
    reading: bool @= true
    longest: i64 @= 3

    if wide
        longest @ 18

    while reading
        digits = digit_run(text: text, at: i)

        if digits == 0 || digits > longest || dated(text: text, at: i + digits)
            reading @ false
            continue

        # Digits are ASCII, so the cut stands between characters, and a run of
        # digits is a number.
        n = strings.to_number(text.slice(from: i, to: i + digits)).must()
        i @ i + digits

        if has_at(text: text, at: i, piece: " to ")
            more = digit_run(text: text, at: i + 4)

            if more > 0 && more <= longest && !dated(text: text, at: i + 4 + more)
                m = strings.to_number(text.slice(from: i + 4, to: i + 4 + more)).must()
                k: i64 @= n

                while k <= m
                    out @ out.push(k)
                    k @ k + 1

                i @ i + 4 + more
            else
                out @ out.push(n)
        else
            out @ out.push(n)

        if has_at(text: text, at: i, piece: ", and ")
            i @ i + 6
        else if has_at(text: text, at: i, piece: ", ")
            i @ i + 2
        else if has_at(text: text, at: i, piece: " and ")
            i @ i + 5
        else
            reading @ false

    return out

# Whether a `-` and a digit stand at `at`, after a run of digits: the run is
# then a year or a day of `2026-09-28`, never a number of a list.
function dated(text: str, at: i64) -> bool
    return at + 1 < text.len() && text[at] == '-' && cards.is_digit_byte(text[at + 1])

# Whether the six bytes at `i` spell `defect` in any case.
function spells_defect(text: str, i: i64) -> bool
    word = "defect"

    if i + 6 > text.len()
        return false
    j: i64 @= 0

    while j < 6
        byte = text[i + j]
        lower: u8 @= byte

        if byte >= 'A' && byte <= 'Z'
            lower @ byte + 32

        if lower != word[j]
            return false
        j @ j + 1

    return true

# Every defect number a line cites: `defect 235`, `Defect 235`, `DEFECT 235`,
# `defect-235`, `defects 324 and 325`, `defects 018 to 021`, and, where `wide`,
# a new defect's issue number, four digits or more; and none from
# `defect_register` or `defective`,
# where no space or dash follows the word, nor from *open defects 0*, a count,
# since the numbers issued start at 1.
function numbers_cited(text: str, wide: bool) -> [i64]
    out: [i64] @= []
    i: i64 @= 0

    while i < text.len()
        if !spells_defect(text: text, i: i)
            i @ i + 1
            continue
        j: i64 @= i + 6

        if j < text.len() && (text[j] == 's' || text[j] == 'S')
            j @ j + 1

        if j < text.len() && (text[j] == ' ' || text[j] == '-')
            for n in numbers_after(text: text, at: j + 1, wide: wide)
                if n > 0
                    out @ out.push(n)
        i @ j

    return out

# Whether `path` stands under one of the cited roots.
function under_roots(path: str) -> bool
    for root in CITED_ROOTS
        if path == root || strings.starts_with(text: path, prefix: root + "/")
            return true

    return false

# Whether the citations of `path` are read in the old series alone: a file of
# the frozen corpus of planted mistakes (panel 187's R2,
# `tests/golden/recovery/corpus/`), a copy of the tree of its day kept byte for
# byte, whose citations of a number of four digits or more are fixtures of
# a test it froze (the file name of the thousandth defect, in the old
# series' spelling) and no new defect's name,
# and which no repair may edit.
function old_names_only(path: str) -> bool
    return strings.ends_with(text: path, suffix: ".frozen")

# Every `defect NNN` under the cited roots, or under `only` where it names a
# path there, resolved among `names`, the defects' names `from` gave (GitHub's
# listing, or the copy of it the last full run kept); the whole walk's count
# floored.
function defects_cited(@r: report.Report, scratch: str, names: {i64: bool}, from: str, only: str)
    words: [str] @= ["git", "grep", "-n", "-a", "-i", "-E", "defects?[ -][0-9]", "--"]

    if only == ""
        for root in CITED_ROOTS
            words @ words.push(root)
    else
        words @ words.push(only)
    ran = shell.attempted(scratch: scratch, program: "git", words: words)

    if ran.is_err() || !ran.must().started
        report.keep_failure(
            @r,
            label: LABEL_CITED,
            detail: "  git could not be started, so no citation was read: " + shell.refusal(ran)
        )
        return
    offences: [str] @= []
    resolved: i64 @= 0

    for line in strings.lines(ran.must().out)
        first = strings.index_of(text: line, needle: ":")

        if first.is_err()
            continue
        after = line.slice(from: first.must() + 1, to: line.len())
        second = strings.index_of(text: after, needle: ":")

        if second.is_err()
            continue
        place = line.slice(from: 0, to: first.must() + 1 + second.must())
        text = after.slice(from: second.must() + 1, to: after.len())

        for n in numbers_cited(text: text, wide: !old_names_only(line.slice(from: 0, to: first.must())))
            if names[n].is_err()
                offences @ offences.push(place + ": defect " + n.to_str() + " names no defect " + from + " holds")
            else
                resolved @ resolved + 1

    if only == ""
        if !floors.sound(@r, label: LABEL_CITED, found: resolved, floor: CITED_FLOOR, what: "citations of a defect under selfhost/, runtime/, seed/ and tests/")
            return

    if offences.len() > 0
        report.keep_failure(
            @r,
            label: LABEL_CITED,
            detail: "  " + offences.join("\n  ") + "\n  A number the code cites is a name for ever (`.claude/rules/records.md` § The issues, CL-083): an old defect's\n  is the number its issue's title opens with, `Defect 235:`, and a new one's is its own issue number;\n  file the defect, or cite the one that exists."
        )
    else if only != ""
        report.keep_pass(@r)

test "a section is the lines its heading opens, up to the next heading"
    body = "- [x] **panel 196** | q | w\n\n    **Origin:** x.\n\n## Prior art\n\nopener\n- one\n\n## The repair\n\nlater\n"
    got = section_of(body: body, heading: PRIOR_ART)
    assert got.found
    assert got.rows.len() == 4
    assert strings.trimmed(got.rows[1]) == "opener"
    assert strings.trimmed(got.rows[2]) == "- one"
    assert !section_of(body: body, heading: WHAT_WAS_DONE).found
    assert near_misses(body).len() == 0
    assert near_misses("## Prior Art\n### Prior art\n## Prior art:\n## PRIOR ART\n").len() == 4

test "a precedent line is one of two forms, with a reference and a link"
    assert precedent_offence("- **Taken from Ada**: [AI05-0144](https://example.org/ai): the refusal") == ""
    assert precedent_offence("- **Reached first by Zig**: [#1717](https://example.org/z): closures") == ""
    assert precedent_offence("") == ""
    assert strings.contains(text: precedent_offence("- not searched"), needle: "neither")
    assert strings.contains(text: precedent_offence("- **Taken from Ada**: nothing"), needle: "no reference")
    assert strings.contains(text: precedent_offence("- **Taken from Ada**: [x](ftp://y): z"), needle: "no link")

test "the opener names the sitting's file in a code span and the day the links were re-read"
    known: {str: bool} @= {}
    known["docs/panel/196-a-sitting.md"] @ true
    known["docs/panel/196-reports/historian.md"] @ true
    opener = "Panel 196 (`docs/panel/196-a-sitting.md`, `docs/panel/196-reports/historian.md`), every link read 2026-10-11."
    assert sittings_named(line: opener, known: known) == ["docs/panel/196-a-sitting.md"]
    assert names_read_day(opener)
    assert !names_read_day("Panel 196, read on the day.")
    assert !names_read_day("read 2026-13-01")
    assert sittings_named(line: "Panel 196 (docs/panel/196-a-sitting.md)", known: known).len() == 0
    known["docs/panel/197-another.md"] @ true
    both = "Panels 196 and 197 (`docs/panel/196-a-sitting.md`, `docs/panel/197-another.md`), read 2026-10-11."
    assert sittings_named(line: both, known: known) == ["docs/panel/196-a-sitting.md", "docs/panel/197-another.md"]
    assert historian_sat(sitting: "docs/panel/196-a-sitting.md", known: known)

test "a sitting's file is named by its number and a slug, and the highest a tree holds places the tree"
    assert sitting_number("docs/panel/213-a-stopped-program.md").must() == 213
    assert sitting_number("docs/panel/002-ok-constructor.md").must() == 2
    assert sitting_number("docs/panel/213-reports/historian.md").is_err()
    assert sitting_number("docs/panel/213.md").is_err()
    assert sitting_number("docs/panel/213-.md").is_err()
    assert sitting_number("docs/panel/abc-x.md").is_err()
    assert sitting_number("docs/panel/213-x.txt").is_err()
    assert sitting_number("docs/other/213-x.md").is_err()
    known: {str: bool} @= {}
    assert highest_sitting(known) == 0
    known["docs/panel/196-a-sitting.md"] @ true
    known["docs/panel/212-the-last.md"] @ true
    known["docs/panel/212-reports/historian.md"] @ true
    known["docs/panel/999-briefs/brief.md"] @ true
    assert highest_sitting(known) == 212
    assert panel_spans("Panel 213 (`docs/panel/213-x.md`, `docs/panel/213-reports/historian.md`, `site/x`)") == ["docs/panel/213-x.md"]

test "a sitting the tree has not received is excused only where the tree places itself, and never in a draft"
    known: {str: bool} @= {}
    known["docs/panel/196-a-sitting.md"] @ true
    known["docs/panel/196-reports/historian.md"] @ true
    known["docs/panel/212-the-last.md"] @ true
    precedent = "- **Taken from Ada**: [AI05](https://example.org/ai): the refusal"
    ahead = [
        ""
        "Panel 213 (`docs/panel/213-new.md`, `docs/panel/213-reports/historian.md`), read 2026-10-13."
        ""
        precedent
    ]
    assert section_offences(where: "w", kind: "decision", rows: ahead, known: known, received: 212).len() == 0
    drafted = section_offences(where: "w", kind: "decision", rows: ahead, known: known, received: 0)
    assert drafted.len() == 1
    assert strings.contains(
        text: drafted[0],
        needle: "names `docs/panel/213-new.md`, a sitting's file this tree does not hold"
    )
    passed = ["Panel 150 (`docs/panel/150-gone.md`), read 2026-10-13.", precedent]
    told = section_offences(where: "w", kind: "decision", rows: passed, known: known, received: 212)
    assert told.len() == 1
    assert strings.contains(text: told[0], needle: "its number is not above 212, the highest sitting the tree holds")
    beside = ["Panel 196 (`docs/panel/196-a-sitting.md`, `docs/panel/196-a-typo.md`), read 2026-10-13.", precedent]
    typo = section_offences(where: "w", kind: "decision", rows: beside, known: known, received: 212)
    assert typo.len() == 1
    assert strings.contains(text: typo[0], needle: "names `docs/panel/196-a-typo.md`")
    shaped = ["Panel 213 (`docs/panel/213-notes/x.md`), read 2026-10-13.", precedent]
    odd = section_offences(where: "w", kind: "decision", rows: shaped, known: known, received: 212)
    assert odd.len() == 1
    assert strings.contains(text: odd[0], needle: "not a sitting's file")
    assert section_offences(where: "w", kind: "decision", rows: ["Panel 213, read 2026-10-13.", precedent], known: known, received: 212).len() == 1

test "a line cites every number it names after the word, in any case, and no day or lane"
    assert numbers_cited(text: "def" + "ect 235 was repaired", wide: true) == [235]
    assert numbers_cited(text: "Def" + "ect 235, 2026-09-28: a day", wide: true) == [235]
    assert numbers_cited(text: "def" + "ect 130, lane b6", wide: true) == [130]
    assert numbers_cited(text: "def" + "ects 324 and 325's cases", wide: true) == [324, 325]
    assert numbers_cited(text: "def" + "ects 018 to 021 misinformed", wide: true) == [18, 19, 20, 21]
    assert numbers_cited(text: "def" + "ect 130, 131, and 132", wide: true) == [130, 131, 132]
    assert numbers_cited(text: "DEF" + "ECT 014 (panel 113)", wide: true) == [14]
    assert numbers_cited(text: "fixedbugs-def" + "ect-382-x", wide: true) == [382]
    assert numbers_cited(text: "defect_register and a defective 3", wide: true).len() == 0
    assert numbers_cited(text: "def" + "ect 235 — a title with a dash", wide: true) == [235]
    assert numbers_cited(text: "open def" + "ects 0, open decisions 0", wide: true).len() == 0
    assert numbers_cited(text: "def" + "ects 058 and 059 — one string", wide: true) == [58, 59]

test "a new defect's name is its issue number, read where the file is not frozen, and a day is never one"
    assert numbers_cited(text: "def" + "ect 2031 was filed on GitHub", wide: true) == [2031]
    assert numbers_cited(text: "fixedbugs-def" + "ect-2031-x", wide: true) == [2031]
    assert numbers_cited(text: "def" + "ects 235 and 2031", wide: true) == [235, 2031]
    assert numbers_cited(text: "def" + "ect 2031 is no old number", wide: false).len() == 0
    assert numbers_cited(text: "def" + "ect 2026-10-12, a day", wide: true).len() == 0
    assert numbers_cited(text: "def" + "ect 130, 2026-09-28: a day", wide: true) == [130]
    assert numbers_cited(text: "def" + "ects 130 to 2026-09-28", wide: true) == [130]
    assert old_names_only("tests/golden/recovery/corpus/tests/harness/suite_records.hero.frozen")
    assert !old_names_only("tests/harness/suite_records.hero")

test "the cited roots are the compiler, the runtime, the seed and the tests"
    assert under_roots("tests/golden/check/x.hero")
    assert under_roots("seed")
    assert !under_roots("issues/2026-10/11/x.md")
    assert !under_roots("testsuite/x")

test "a closed feature's what-was-done names its card's commit, or self where the card says so"
    item = "- [x] **M-issue-files** | w | h\n\n## What was done\n\nLanded at `7d2f03be`.\n"
    text = cards.card_text(kind: "feature", area: "cli", milestone: "M-issue-files", filed: "2026-10-03", commit: "7d2f03bee011003fbd37562924582b0660789f03", github: "none") + item
    assert done_offence(cards.issue_of(path: "issues/x.md", text: text)) == ""
    other = cards.card_text(kind: "task", area: "cli", milestone: "M-issue-files", filed: "2026-10-03", commit: "self", github: "none") + "- [x] **M-issue-files** | w | h\n\n## What was done\n\nThis file's own commit (`self`).\n"
    assert done_offence(cards.issue_of(path: "issues/y.md", text: other)) == ""
    bare = cards.card_text(kind: "task", area: "cli", milestone: "M-issue-files", filed: "2026-10-03", commit: "self", github: "none") + "- [x] **M-issue-files** | w | h\n"
    assert strings.contains(text: done_offence(cards.issue_of(path: "issues/z.md", text: bare)), needle: "holds no")
