# The golden tree, read as pairs.
#
# Port of collect_cases at heroes-cli/tests/golden.rs:54 in the Rust bootstrap at `m-bootstrap-archive`, and it
# keeps that function's one sharp rule: an unpaired file is a BROKEN
# TEST, not a skip. A `.hero` with no `.expected` and an expectation with
# no source both stop the harness with the name of the offender, because
# the failure they hide is a case that silently stopped running — which is
# the same class of defect as an invariant that cannot fail (CLAUDE.md
# §9).
#
# Anything else in the directory is ignored on purpose: `.fixed` and
# `.applied` files belong to the certain-fix suite, and `.gitkeep` and editor droppings
# are not cases.
#
# **A case may be a folder** (panel 235's R19, M-package-manager step 6): one
# whose program reads files beside it no flat case can hold, a catalogue
# `heroes.toml` and the trees `heroes fetch` places under `heroes.packages/`,
# is a folder `<name>.case/` holding the file compiled, `main.hero`, and its
# expectation, `main.expected`, with the rest. The pair rule binds it as it
# binds a flat case: a folder missing either stops the harness by name. A
# folder not named `.case` is a case's modules, as it always was.
#
# **One walk reads a golden directory, `programs`** (defect 2341): `collect`
# is that walk with the pair rule laid on it, and a suite whose cases carry no
# expectation asks the walk alone, so a form of case this file learns reaches
# every suite at once.

use <core>/strings as core_strings

use shell
use strings

# A case's source as the compiler holds it (panel 189, defect 227): its text,
# or for a case that is not UTF-8 on purpose, the text with each byte that is
# not text shown as one U+FFFD, which keeps every line and every `#~` mark
# where it is. `read_file` failed such a case as *cannot read*, the defect's own
# shape inside the net. `runtime/parts/os.c` is the C.
extern "hero_os.h"
    function hero_file_read_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_TEXT: i64

record Shown
    text: str
    is_text: bool

function shown(path: str) -> Shown?
    status: i64 @= 0
    marks: i64 @= 0
    got = hero_file_read_shown(path: path.cstr(), status: @status, marks: @marks)

    if status != HERO_OS_OK && status != HERO_OS_NOT_TEXT
        return fail(code: "unreadable", msg: "cannot read " + path)
    return ok(Shown(text: got.slice(from: marks, to: got.len()), is_text: status == HERO_OS_OK))

# One golden case: its source, its expectation, and the name a failure
# message says. The expectation is "" where `programs` found none beside the
# source: `collect` refuses that, and a suite whose cases carry none reads it.
record Case
    source: str
    expected: str
    name: str

# The cases of `dir`, each paired with its expectation, or the failure naming
# the first half pair: `programs`, under the pair rule.
function collect(scratch: str, dir: str) -> [Case]?
    entries = shell.list_entries(scratch: scratch, dir: dir)?

    # Membership is asked of the listing rather than of the filesystem:
    # one walk answers every question, and a `test -e` per case would be
    # 200 more processes for an answer already in hand.
    present = listed(entries)

    for entry in entries
        if core_strings.has_suffix(s: entry, suffix: ".expected")
            owner = strings.without_suffix(text: entry, suffix: ".expected") + ".hero"

            if present[owner].is_err()
                return fail(code: "orphan", msg: "orphan expectation: " + entry + " has no .hero source")

    found = programs(scratch: scratch, dir: dir)?

    for item in found
        if item.expected == ""
            return fail(code: "half_pair", msg: "golden case " + item.source + " is missing its .expected file")

    return ok(found)

# **Every program of the golden directory `dir`, the one walk of it**: each
# `.hero` file in it, then the `main.hero` of each folder named `.case`, each
# list sorted, every one with its expectation where one is beside it and ""
# where none is. `collect` lays the pair rule on this walk; `suite_emission`
# asks it alone, its `fixedbugs/` carrying no expectation. Until defect 2341
# that suite walked each directory by hand and took its `.hero` files, so the
# folders this file learned to read at M-package-manager step 6 had no
# blessed emission.
#
# A folder named `.case` holding no `main.hero` stops the harness by name,
# whoever asks: it is a case that stopped running, which the pair rule exists
# to name.
function programs(scratch: str, dir: str) -> [Case]?
    entries = shell.list_entries(scratch: scratch, dir: dir)?
    present = listed(entries)
    found: [Case] @= []

    for entry in entries
        if core_strings.has_suffix(s: entry, suffix: ".hero")
            stem = strings.without_suffix(text: entry, suffix: ".hero")
            found @ found.push(
                Case(source: entry, expected: beside(present: present, path: stem + ".expected"), name: strings.base_name(path: stem))
            )

    for folder in shell.list_directories(scratch: scratch, dir: dir)?
        if core_strings.has_suffix(s: folder, suffix: CASE)
            found @ found.push(folder_case(scratch: scratch, folder: folder)?)

    return ok(found)

# The folder a case is, by its name's end.
constant CASE: str
    ".case"

# A folder case: its source, `main.hero`, its expectation, `main.expected`
# where the folder holds one, and its name, the folder's less `.case`; or the
# failure naming a folder that holds no `main.hero`, the file it compiles.
function folder_case(scratch: str, folder: str) -> Case?
    inside = listed(shell.list_entries(scratch: scratch, dir: folder)?)
    source = folder + "/main.hero"

    if inside[source].is_err()
        return fail(code: "half_pair", msg: "golden case " + folder + " holds no main.hero, the file it compiles")
    return ok(
        Case(source: source, expected: beside(present: inside, path: folder + "/main.expected"), name: strings.base_name(path: strings.without_suffix(text: folder, suffix: CASE)))
    )

# The entries of a listing as a set, so membership is asked of the listing in
# hand.
function listed(entries: [str]) -> {str: bool}
    present: {str: bool} @= {}

    for entry in entries
        present[entry] @ true

    return present

# `path` where `present` lists it, "" where it does not.
function beside(present: {str: bool}, path: str) -> str
    if present[path].is_err()
        return ""
    return path

# The harness's third word: the cases whose NAME holds `only`, every case when
# `only` is empty. Added 2026-09-29 for the gate of one repair (CLAUDE.md
# § Verification; `.claude/rules/verification.md`, the section on the batch), so that the
# form holding a defect's cases can be asked about those cases with the
# harness's own invocation rather than a `diff` by hand (CL-074). The caller
# decides what an empty answer means: `main` refuses it, because a run that
# selected nothing is a green run that tested nothing (CL-072).
function matching(found: [Case], only: str) -> [Case]
    if only == ""
        return found
    kept: [Case] @= []

    for item in found
        if core_strings.contains(s: item.name, substr: only)
            kept @ kept.push(item)

    return kept

# **A shard of a suite's cases, the third word's second form** (defect 537,
# 2026-10-09). `run` was the batch gate's critical path, 19:40 of gate B's
# 19:56 on 2026-10-09, and splitting it one harness process per case cost
# four seconds a process and read a one-case run's skipped case as a red. So
# the word `<i>/<n>` asks for shard `i` of `n`: the cases in the order
# `collect` gives them, which is the sorted listing, dealt round, the case at
# index `k` (from 0) to shard `k % n + 1`. Each case is in exactly one shard
# for any `n`, and the `n` shards' union is the suite, which a test below
# asserts over every `n` up to past the cases' count. Dealt round rather than
# cut in runs because neighbours in the listing share a defect's number and
# often its cost, so a run of them would load one shard.
#
# The word is a shard only in the shape `<digits>/<digits>`, at most six digits
# a side: no case name holds a `/` (a name is a file's stem), so the shape
# takes no filter anybody could mean, and a module's path, which a filter of
# `layout` names, is not in it. Where it is in the shape and out of range,
# `0/4`, `5/4`, `1/0`, it is refused by `main` with exit 2 rather than read
# as a filter that selects nothing.
record Shard
    index: i64
    count: i64

# The six digits a side: a count past a million shards is no gate's, and the
# bound keeps `strings.to_number` from an overflow the harness would abort on.
constant SHARD_DIGITS: i64
    6

# Whether the word has a shard's shape, `<digits>/<digits>`, in or out of range.
function shard_shaped(word: str) -> bool
    halves = strings.split_on(text: word, byte: 47)

    if halves.len() != 2
        return false

    for half in halves
        if half.len() == 0 || half.len() > SHARD_DIGITS || strings.to_number(half).is_err()
            return false

        if core_strings.has_prefix(s: half, prefix: "-")
            return false

    return true

# The word as a shard: `not_a_shard` where it lacks the shape, `bad_shard`
# with the words to tell where it has the shape and no shard is `i` of `n`
# with `1 <= i <= n`.
function shard_of(word: str) -> Shard?
    if !shard_shaped(word)
        return fail(code: "not_a_shard", msg: "`" + word + "` is not `<i>/<n>`")
    halves = strings.split_on(text: word, byte: 47)
    index = strings.to_number(halves[0])?
    count = strings.to_number(halves[1])?

    if count < 1 || index < 1 || index > count
        return fail(
            code: "bad_shard",
            msg: "`" + word + "` names no shard: a shard is `<i>/<n>`, the i-th of n, with 1 <= i <= n"
        )
    return ok(Shard(index: index, count: count))

# The cases of shard `index` of `count`, dealt round by their sorted index.
function sharded(found: [Case], shard: Shard) -> [Case]
    kept: [Case] @= []
    k: i64 @= 0

    for item in found
        if k % shard.count == shard.index - 1
            kept @ kept.push(item)
        k @ k + 1

    return kept

# The third word, either form: a shard where the word is one, else the cases
# whose name holds it (`matching`). A word in the shape and out of range keeps
# nothing; `main` refuses it before any suite runs.
function selected(found: [Case], only: str) -> [Case]
    shard = shard_of(only)

    if !shard.is_err()
        return sharded(found: found, shard: shard.must())

    if shard_shaped(only)
        none: [Case] = []
        return none
    return matching(found: found, only: only)

# Whether the word asks for a shard, so that a suite asks none of the whole
# suite's questions of it (its floor, its skip ratio).
function is_shard(only: str) -> bool
    return shard_shaped(only)

# The code of a shard's answer, `ok` where it is one, for the refusal `main`
# makes and the tests that read it.
function code_of(got: Shard?) -> str
    return match got
        .ok _  => "ok"
        .err e => e.code

test "a shard is <i>/<n>, and a word in that shape out of range is no shard and no filter"
    assert shard_of("2/6").must().index == 2
    assert shard_of("2/6").must().count == 6
    assert shard_of("1/1").must().index == 1
    assert shard_of("06/06").must().index == 6

    for word in ["0/4", "5/4", "1/0", "0/0"]
        assert shard_shaped(word)
        assert is_shard(word)
        assert code_of(shard_of(word)) == "bad_shard"

    # What is not a shard stays the filter it always was: a name, a path a
    # filter of `layout` names, and the shapes beside a shard's.
    for word in ["", "fixedbugs-133", "selfhost/g.hero", "2/", "/6", "2/6/1", "-1/4", "1/-4", "a/4", "1234567/2"]
        assert !shard_shaped(word)
        assert !is_shard(word)
        assert code_of(shard_of(word)) == "not_a_shard"

    a = Case(source: "x/a.hero", expected: "x/a.expected", name: "a")
    b = Case(source: "x/fixedbugs-133-b.hero", expected: "x/fixedbugs-133-b.expected", name: "fixedbugs-133-b")
    c = Case(source: "x/fixedbugs-134-c.hero", expected: "x/fixedbugs-134-c.expected", name: "fixedbugs-134-c")
    three: [Case] = [a, b, c]
    assert selected(found: three, only: "5/4").len() == 0
    assert selected(found: three, only: "fixedbugs").len() == 2
    assert selected(found: three, only: "").len() == 3
    assert selected(found: three, only: "2/2").len() == 1
    assert selected(found: three, only: "2/2")[0].name == "fixedbugs-133-b"
    assert selected(found: three, only: "1/2")[1].name == "fixedbugs-134-c"

test "the shards of any n are disjoint, their union is the suite, and none holds two more than another"
    # Every n from 1 to past the cases' count, so the shards that come out
    # empty are asked too, and the gate's own size with the shard counts a
    # gate would take.
    for size in [0, 1, 2, 7, 13, 423]
        found: [Case] @= []
        k: i64 @= 0

        while k < size
            name = "c" + k.to_str()
            found @ found.push(Case(source: "x/" + name + ".hero", expected: "x/" + name + ".expected", name: name))
            k @ k + 1

        last: i64 @= size + 3

        if size > 13
            last @ 8
        n: i64 @= 1

        while n <= last
            seen: {str: i64} @= {}
            total: i64 @= 0
            i: i64 @= 1

            while i <= n
                part = selected(found: found, only: i.to_str() + "/" + n.to_str())
                assert part.len() == size / n || part.len() == size / n + 1

                for item in part
                    assert seen[item.name].is_err()
                    seen[item.name] @ i
                    total @ total + 1

                i @ i + 1

            assert total == size

            for item in found
                assert !seen[item.name].is_err()

            n @ n + 1

test "the filter keeps the cases whose name holds the word, and an empty word keeps all"
    a = Case(source: "x/a.hero", expected: "x/a.expected", name: "a")
    b = Case(source: "x/fixedbugs-133-b.hero", expected: "x/fixedbugs-133-b.expected", name: "fixedbugs-133-b")
    c = Case(source: "x/fixedbugs-134-c.hero", expected: "x/fixedbugs-134-c.expected", name: "fixedbugs-134-c")
    three: [Case] = [a, b, c]
    assert matching(found: three, only: "").len() == 3
    assert matching(found: three, only: "fixedbugs-133").len() == 1
    assert matching(found: three, only: "fixedbugs-133")[0].name == "fixedbugs-133-b"
    assert matching(found: three, only: "fixedbugs").len() == 2
    assert matching(found: three, only: "zzz").len() == 0

test "the collector pairs, orders and refuses a half pair"
    scratch = shell.own_scratch()
    tree = scratch + "/cases"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()

    # Six files, written rather than `touch`ed through a shell. The
    # names are the point of the test: the collector has to pair `a`
    # with `a.expected`, order them, and ignore what is neither.
    for name in ["b.hero", "b.expected", "a.hero", "a.expected", "a.fixed", ".gitkeep"]
        assert !write_file(path: tree + "/" + name, text: "").is_err()

    found = collect(scratch: scratch, dir: tree)
    assert !found.is_err()
    assert found.must().len() == 2

    # Sorted, so a failure names the same case on every machine.
    assert found.must()[0].name == "a"
    assert found.must()[1].name == "b"
    assert found.must()[0].expected == tree + "/a.expected"
    assert !shell.remove_tree(scratch).is_err()

test "a folder named .case is one case, its main.hero and main.expected, and one missing either stops the harness"
    scratch = shell.own_scratch()
    tree = scratch + "/folders"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree + "/b.case/heroes.packages/x").is_err()
    assert !shell.mkdir_all(tree + "/modules").is_err()

    for name in ["a.hero", "a.expected", "b.case/main.hero", "b.case/main.expected", "b.case/heroes.toml", "b.case/heroes.packages/x/m.hero", "modules/m.hero"]
        assert !write_file(path: tree + "/" + name, text: "").is_err()

    found = collect(scratch: scratch, dir: tree)
    assert !found.is_err()
    assert found.must().len() == 2
    assert found.must()[1].name == "b"
    assert found.must()[1].source == tree + "/b.case/main.hero"
    assert found.must()[1].expected == tree + "/b.case/main.expected"

    # Either half missing is the broken test the flat pair rule refuses.
    assert !shell.mkdir_all(tree + "/c.case").is_err()
    assert !write_file(path: tree + "/c.case/main.hero", text: "").is_err()

    code = match collect(scratch: scratch, dir: tree)
        .ok _  => "ok"
        .err e => e.code

    assert code == "half_pair"
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2341, held as a test (2026-11-08): the walk under the pair rule is the
# one `suite_emission` asks of `fixedbugs/`, whose sources carry no
# expectation, so it reads a source and a folder case with none, and leaves a
# folder of modules alone; and a folder named `.case` with no `main.hero`
# directly inside stops it by name, as it stops `collect`.
test "fixedbugs: the walk under the pair rule reads every program, an expectation or none, and stops at a folder case with no main.hero (defect 2341)"
    scratch = shell.own_scratch()
    tree = scratch + "/programs"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree + "/b.case").is_err()
    assert !shell.mkdir_all(tree + "/modules").is_err()

    for name in ["a.hero", "a.expected", "c.hero", "b.case/main.hero", "b.case/heroes.toml", "modules/m.hero"]
        assert !write_file(path: tree + "/" + name, text: "").is_err()

    found = programs(scratch: scratch, dir: tree)
    assert !found.is_err()
    assert found.must().len() == 3
    assert found.must()[0].expected == tree + "/a.expected"
    assert found.must()[1].name == "c"
    assert found.must()[1].expected == ""
    assert found.must()[2].name == "b"
    assert found.must()[2].source == tree + "/b.case/main.hero"
    assert found.must()[2].expected == ""

    # What the walk reads, the pair rule refuses.
    code = match collect(scratch: scratch, dir: tree)
        .ok _  => "ok"
        .err e => e.code

    assert code == "half_pair"

    # The file it compiles one folder too deep is no `main.hero` of the case.
    assert !shell.mkdir_all(tree + "/d.case/inner").is_err()
    assert !write_file(path: tree + "/d.case/inner/main.hero", text: "").is_err()

    said = match programs(scratch: scratch, dir: tree)
        .ok _  => "ok"
        .err e => e.msg

    assert said == "golden case " + tree + "/d.case holds no main.hero, the file it compiles"
    assert !shell.remove_tree(scratch).is_err()

test "a source with no expectation stops the harness by name"
    scratch = shell.own_scratch()
    tree = scratch + "/half"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    assert !write_file(path: tree + "/lonely.hero", text: "").is_err()
    found = collect(scratch: scratch, dir: tree)

    code = match found
        .ok _  => "ok"
        .err e => e.code

    assert code == "half_pair"
    assert !shell.remove_tree(scratch).is_err()

test "an expectation with no source stops the harness by name"
    scratch = shell.own_scratch()
    tree = scratch + "/orphan"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    assert !write_file(path: tree + "/ghost.expected", text: "").is_err()
    found = collect(scratch: scratch, dir: tree)

    code = match found
        .ok _  => "ok"
        .err e => e.code

    assert code == "orphan"
    assert !shell.remove_tree(scratch).is_err()
