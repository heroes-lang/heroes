# The statement half of the generator (panel 231, M-generated-programs, task
# 931): the functions above `main`, its statements, each run as it is
# appended so the next one is built against what the program holds, and the
# declared arm, which plants one abort on purpose, a `print` of it, so the
# evaluator's run of `main` writes the `!panic:` it owes. Expressions are
# `gen_expr`'s, the C group `gen_cboundary`'s; a seed's program and its files
# are `gen_program`'s.

use gen_cboundary
use gen_declared
use gen_eval
use gen_expr
use gen_rng
use gen_tree

function functions(@g: gen_expr.Gen, count: i64)
    while g.p.fns.len() < count
        params: [str] @= ["p0"]

        if gen_rng.chance(@g.r, percent: 50)
            params @ params.push("p1")
        envs: [gen_eval.Env] @= []

        while envs.len() < 3
            e: gen_eval.Env @= gen_eval.empty()

            for name in params
                e.ints[name] @ gen_rng.constant_of(@g.r, m: g.mix)

            envs @ envs.push(e)

        s = gen_expr.Scope(
            ints: params,
            fields: [],
            bools: [],
            bfields: [],
            arrays: [],
            lengths: [],
            strs: [],
            fns: g.p.fns.len(),
            top: false
        )
        body: i64 @= gen_expr.int_expr(@g, s: s, envs: envs, depth: g.depth, context: gen_rng.below(@g.r, n: 6))

        for name in params
            body @ gen_expr.reading(@g, at: body, name: name)

        name: str @= "f" + g.p.fns.len().to_str()

        # A third of them fallible, `-> i64?` failing where a guard of their
        # own holds (panel 231's R3, the forms: `T?`).
        if gen_rng.chance(@g.r, percent: 35)
            body @ gen_expr.fallible_body(@g, s: s, envs: envs, value: body)
            name @ "h" + g.p.fns.len().to_str()
        g.p.fns @ g.p.fns.push(gen_tree.Fn(name: name, params: params, body: body))

# A statement appended to `main`, run at once so `env` holds what it bound.
function appended(@g: gen_expr.Gen, s: gen_tree.Stmt, @env: gen_eval.Env)
    g.p.body @ g.p.body.push(s)
    out: [str] @= []
    gen_eval.stepped(g.p, s: s, @env, @out).must()

function shown(@g: gen_expr.Gen, parts: [i64], @env: gen_eval.Env)
    appended(@g, s: .show(parts: parts), @env)

function statement(@g: gen_expr.Gen, @s: gen_expr.Scope, @env: gen_eval.Env, id: i64)
    envs = [env]
    n = id.to_str()
    k = gen_rng.below(@g.r, n: 100)
    depth = g.depth
    context = gen_rng.below(@g.r, n: 6)

    if k < 30
        e = gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context)
        appended(@g, s: .bind_int(name: "x" + n, expr: e), @env)
        s.ints @ s.ints.push("x" + n)
        shown(@g, parts: [gen_expr.named(@g, op: "name", name: "x" + n)], @env)

        if s.top
            g.reuse @ g.reuse.push(e)
    else if k < 40
        appended(@g, s: .bind_bool(name: "b" + n, expr: gen_expr.bool_expr(@g, s: s, envs: envs, depth: depth)), @env)
        s.bools @ s.bools.push("b" + n)
        shown(@g, parts: [gen_expr.named(@g, op: "bname", name: "b" + n)], @env)
    else if k < 50
        a = gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context)
        b = gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context)
        f = gen_expr.bool_expr(@g, s: s, envs: envs, depth: depth)
        appended(@g, s: .rec(name: "r" + n, a: a, b: b, f: f), @env)
        g.has_record @ true
        s.fields @ s.fields.push("r" + n + ".a").push("r" + n + ".b")
        s.bfields @ s.bfields.push("r" + n + ".f")
        shown(
            @g,
            parts: [gen_expr.named(@g, op: "field", name: "r" + n + ".a"), gen_expr.named(@g, op: "field", name: "r" + n + ".b"), gen_expr.named(@g, op: "bfield", name: "r" + n + ".f")],
            @env
        )
    else if k < 60
        elems: [i64] @= []
        size = 1 + gen_rng.below(@g.r, n: 5)

        while elems.len() < size
            elems @ elems.push(gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context))

        appended(@g, s: .arr(name: "a" + n, elems: elems), @env)
        s.arrays @ s.arrays.push("a" + n)
        s.lengths @ s.lengths.push(size)
        parts: [i64] @= []

        while parts.len() < size
            index = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: parts.len(), name: ""))
            parts @ parts.push(gen_tree.added(@g.p, gen_tree.Node(op: "index", value: 0, name: "a" + n, kids: [index])))

        shown(@g, parts: parts, @env)
    else if k < 72
        picked(@g, s: s, @env, n: n)
        s.ints @ s.ints.push("m" + n)
    else if k < 84
        guard = gen_expr.bool_expr(@g, s: s, envs: envs, depth: depth)
        yes = gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context)
        no = gen_expr.int_expr(@g, s: s, envs: envs, depth: depth, context: context)
        appended(@g, s: .cond(name: "y" + n, guard: guard, yes: yes, no: no), @env)
        s.ints @ s.ints.push("y" + n)
        shown(@g, parts: [gen_expr.named(@g, op: "name", name: "y" + n)], @env)
    else if k < 92
        looped(@g, s: s, @env, n: n)
        s.ints @ s.ints.push("s" + n)
    else
        appended(@g, s: .bind_str(name: "t" + n, expr: gen_expr.str_expr(@g, s: s, envs: envs, depth: depth)), @env)
        s.strs @ s.strs.push("t" + n)
        shown(@g, parts: [gen_expr.named(@g, op: "sname", name: "t" + n)], @env)

function picked(@g: gen_expr.Gen, s: gen_expr.Scope lent, @env: gen_eval.Env, n: str)
    envs = [env]
    taken = gen_rng.below(@g.r, n: 3)
    payload: [i64] @= []

    if taken == 0 || taken == 2
        payload @ payload.push(
            gen_expr.int_expr(@g, s: s, envs: envs, depth: g.depth, context: gen_rng.below(@g.r, n: 6))
        )

    if taken == 2
        payload @ payload.push(gen_expr.bool_expr(@g, s: s, envs: envs, depth: g.depth))
    arms: [i64] @= []
    binders: [str] @= []

    while arms.len() < 3
        j = arms.len()
        binder = "u" + n + ["a", "b", "c"][j]
        inner: gen_expr.Scope @= s
        inner.top @ false
        arm_env: gen_eval.Env @= env

        if j == 0
            inner.fields @ inner.fields.push(binder + ".v")
            arm_env.ints[binder + ".v"] @ 0

            if taken == 0
                arm_env.ints[binder + ".v"] @ gen_eval.int_of(g.p, at: payload[0], env: env).must()

        if j == 2
            inner.fields @ inner.fields.push(binder + ".w")
            arm_env.ints[binder + ".w"] @ 0

            if taken == 2
                arm_env.ints[binder + ".w"] @ gen_eval.int_of(g.p, at: payload[0], env: env).must()
        arm = gen_expr.int_expr(@g, s: inner, envs: [arm_env], depth: g.depth, context: gen_rng.below(@g.r, n: 6))
        arms @ arms.push(arm)

        if j != 1 && (gen_tree.reads(g.p, at: arm, name: binder + ".v") || gen_tree.reads(g.p, at: arm, name: binder + ".w"))
            binders @ binders.push(binder)
        else
            binders @ binders.push("_")

    g.has_variant @ true
    appended(
        @g,
        s: .picked(vname: "v" + n, case_at: taken, payload: payload, mname: "m" + n, arms: arms, binders: binders),
        @env
    )
    shown(@g, parts: [gen_expr.named(@g, op: "name", name: "m" + n)], @env)

function looped(@g: gen_expr.Gen, s: gen_expr.Scope lent, @env: gen_eval.Env, n: str)
    init = gen_expr.int_expr(@g, s: s, envs: [env], depth: g.depth, context: gen_rng.below(@g.r, n: 6))
    counter = "i" + n
    low = gen_rng.below(@g.r, n: 4)
    high = low + gen_rng.below(@g.r, n: 7)
    inner: gen_expr.Scope @= s
    inner.top @ false
    inner.ints @ inner.ints.push(counter)
    envs: [gen_eval.Env] @= []
    turn: i64 @= low

    while turn < high || envs.len() == 0
        e: gen_eval.Env @= env
        e.ints[counter] @ turn
        envs @ envs.push(e)
        turn @ turn + 1

    body = gen_expr.reading(
        @g,
        at: gen_expr.int_expr(@g, s: inner, envs: envs, depth: g.depth, context: gen_rng.below(@g.r, n: 6)),
        name: counter
    )
    ops = ["+", "-", "*", "^", "|", "&"]
    op: str @= ops[gen_rng.below(@g.r, n: 6)]
    acc: i64 @= gen_eval.int_of(g.p, at: init, env: env).must()

    for i in range(from: low, to: high)
        step = gen_eval.arith(op, a: acc, b: gen_eval.int_of(g.p, at: body, env: envs[i - low]).must())

        if step.is_err()
            op @ "^"
            acc @ acc ^ gen_eval.int_of(g.p, at: body, env: envs[i - low]).must()
        else
            acc @ step.must()

    appended(@g, s: .loop(name: "s" + n, init: init, counter: counter, low: low, high: high, op: op, body: body), @env)
    shown(@g, parts: [gen_expr.named(@g, op: "name", name: "s" + n)], @env)

# One program from one seed; `declared` plants one abort in it.
function made(seed: i64, declared: bool, with_c: bool) -> gen_expr.Gen
    r: gen_rng.Rng @= gen_rng.seeded(seed)
    mix = gen_rng.mix_for(@r)
    depth = 1 + gen_rng.below(@r, n: 4)
    leaf = 20 + gen_rng.below(@r, n: 50)
    g: gen_expr.Gen @= gen_expr.Gen(
        r: r,
        mix: mix,
        p: gen_tree.Program(nodes: [], fns: [], body: []),
        depth: depth,
        leaf: leaf,
        reuse: [],
        has_record: false,
        has_variant: false,
        site: -1
    )

    if with_c
        gen_cboundary.c_functions(@g.p, @g.r, mix: g.mix, count: 1 + gen_rng.below(@g.r, n: 3), depth: g.depth + 1)
    functions(@g, count: g.p.fns.len() + gen_rng.below(@g.r, n: 4))
    s: gen_expr.Scope @= gen_expr.Scope(
        ints: [],
        fields: [],
        bools: [],
        bfields: [],
        arrays: [],
        lengths: [],
        strs: [],
        fns: g.p.fns.len(),
        top: true
    )
    env: gen_eval.Env @= gen_eval.empty()
    count = 4 + gen_rng.below(@g.r, n: 11)
    site: i64 @= -1

    if declared
        site @ gen_rng.below(@g.r, n: count)
    id: i64 @= 0

    while id < count
        if id == site
            gen_declared.abort_site(@g, s: s, env: env)
        statement(@g, @s, @env, id: id)
        id @ id + 1

    return g
