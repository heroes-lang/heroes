# THE WORDS `issues.hero` IS RUN WITH, read: its first word, and the numbers,
# files and flags after it.
#
# Each word takes its own flags and no other, so a flag given to the wrong
# word is refused by name rather than ignored: `--kind`, `--milestone`,
# `--class` and `--json` are `open`'s, `--dry-run` is `link`'s, and no other
# word takes one. `link` is the second pass of panel 212's R9 item 6
# (`issue_links.hero`), every `defect NNN` and `panel NNN` a body names made a
# link; it takes no file.
#
# **The words of the issues on GitHub alone** (the author's seven answers of
# 2026-10-12): `file <draft.md>`, `close <number> <closing.md>`, `comment
# <number> <text.md>` and `edit <number> <draft.md>` write to GitHub and take no
# `--yes`, opening, commenting on, closing and correcting an issue through this
# program being asked once, by that answer (CLAUDE.md § Hard stops); `open`
# reads, and `draft <draft.md>` asks nothing of GitHub: it checks a draft as
# `file` does before its first request and prints the issue `file` would open.
# The transcription's words, `render`, `plan`, `push`, `repair`, `prepare` and
# `finish`, with their `--pin`, `--yes` and `--accept-gaps`, left with the
# folder of issue files the same day, and a word nobody takes is refused.

use cards
use issue_title
use strings

constant USAGE: str
    "heroes run tests/harness/issues.hero -- draft <draft.md>, file <draft.md>, close <number> <closing.md>, comment <number> <text.md>, edit <number> <draft.md>, open [--kind <kind>] [--milestone M-<name>] [--class <class>] [--json], or link [--dry-run]"

# The words of this program.
constant WORDS: [str]
    ["draft", "file", "close", "comment", "edit", "open", "link"]

# The words that name one issue by its number, then a file.
constant NUMBERED: [str]
    ["close", "comment", "edit"]

# What the words after the first asked for, or why they cannot be taken:
# `number` is the issue a numbered word names, 0 for none; `kind`,
# `milestone` and `grade` what `open` narrows to, "" for any.
record Asked
    word: str
    paths: [str]
    number: i64
    kind: str
    milestone: str
    grade: str
    json: bool
    dry: bool
    wrong: str

# Why the first word is not one this program takes.
function refusal(given: [str]) -> str
    if given.len() == 0
        return "no word given: " + USAGE
    return "`" + given[0] + "` is no word of this program: " + USAGE

function parsed(word: str, words: [str]) -> Asked
    paths: [str] @= []
    kind: str @= ""
    milestone: str @= ""
    grade: str @= ""
    json: bool @= false
    dry: bool @= false
    at: i64 @= 0

    while at < words.len()
        one = words[at]
        at @ at + 1

        if one == "--json" && word == "open"
            json @ true
        else if one == "--dry-run" && word == "link"
            dry @ true
        else if (one == "--kind" || one == "--milestone" || one == "--class") && word == "open"
            if at == words.len()
                return wrong(word: word, why: "`" + one + "` takes a value")
            value = words[at]
            at @ at + 1

            if one == "--kind"
                if kind != "" || !among(word: value, words: cards.KINDS)
                    return wrong(word: word, why: "`--kind` takes one of " + cards.KINDS.join(", ") + ", once")
                kind @ value
            else if one == "--milestone"
                if milestone != "" || !cards.is_milestone_name(value)
                    return wrong(word: word, why: "`--milestone` takes one name `M-<words>`, once")
                milestone @ value
            else if grade != "" || !among(word: value, words: issue_title.CLASSES)
                return wrong(word: word, why: "`--class` takes one of " + issue_title.CLASSES.join(", ") + ", once")
            else
                grade @ value
        else if strings.starts_with(text: one, prefix: "-")
            return wrong(word: word, why: "`" + one + "` is no flag of `" + word + "`: " + USAGE)
        else if word == "open" || word == "link"
            return wrong(word: word, why: "`" + word + "` takes no file: " + USAGE)
        else
            paths @ paths.push(strings.without_prefix(text: one, prefix: "./"))

    number: i64 @= 0

    if (word == "file" || word == "draft") && paths.len() != 1
        return wrong(word: word, why: "`" + word + "` takes one draft, a file written outside the tree: " + USAGE)

    if among(word: word, words: NUMBERED)
        if paths.len() != 2 || paths[0].len() == 0 || paths[0][0] == '0' || strings.to_number(paths[0]).default(0) < 1
            return wrong(word: word, why: "`" + word + "` takes the issue's number, then one file: " + USAGE)
        number @ strings.to_number(paths[0]).must()
        paths @ paths.slice(from: 1, to: 2)
    return Asked(
        word: word,
        paths: paths,
        number: number,
        kind: kind,
        milestone: milestone,
        grade: grade,
        json: json,
        dry: dry,
        wrong: ""
    )

function among(word: str, words: [str]) -> bool
    for one in words
        if one == word
            return true

    return false

function wrong(word: str, why: str) -> Asked
    none: [str] = []
    return Asked(
        word: word,
        paths: none,
        number: 0,
        kind: "",
        milestone: "",
        grade: "",
        json: false,
        dry: false,
        wrong: why
    )

test "the transcription's words and flags are refused by name, and a word nobody gave is refused"
    for gone in ["render", "plan", "push", "repair", "prepare", "finish"]
        assert strings.contains(text: refusal([gone]), needle: "is no word of this program")
        assert !among(word: gone, words: WORDS)

    for flag in ["--pin", "--yes", "--accept-gaps"]
        assert strings.contains(text: parsed(word: "file", words: [flag, "a.md"]).wrong, needle: "no flag of `file`")
        assert strings.contains(text: parsed(word: "open", words: [flag]).wrong, needle: "no flag of `open`")

    linking = parsed(word: "link", words: ["--dry-run"])
    assert linking.wrong == ""
    assert linking.dry
    assert !parsed(word: "link", words: []).dry
    assert strings.contains(text: parsed(word: "link", words: ["a.md"]).wrong, needle: "`link` takes no file")
    assert strings.contains(text: parsed(word: "open", words: ["--dry-run"]).wrong, needle: "no flag of `open`")
    assert strings.contains(text: refusal(["sync"]), needle: "no word")
    assert strings.contains(text: refusal([]), needle: "no word given")

test "the words of the issues on GitHub take a number and a file, or a draft, or open's flags, and no guard"
    drafted = parsed(word: "file", words: ["/tmp/x/2026-10-12-1800-a.md"])
    assert drafted.wrong == ""
    assert drafted.paths == ["/tmp/x/2026-10-12-1800-a.md"]
    assert strings.contains(text: parsed(word: "file", words: []).wrong, needle: "`file` takes one draft")
    assert strings.contains(text: parsed(word: "file", words: ["a.md", "b.md"]).wrong, needle: "`file` takes one draft")
    assert strings.contains(text: parsed(word: "file", words: ["--yes", "a.md"]).wrong, needle: "no flag of `file`")
    shown = parsed(word: "draft", words: ["/tmp/x/2026-10-12-1800-a.md"])
    assert shown.wrong == ""
    assert shown.paths == ["/tmp/x/2026-10-12-1800-a.md"]
    assert strings.contains(text: parsed(word: "draft", words: []).wrong, needle: "`draft` takes one draft")
    assert strings.contains(text: parsed(word: "draft", words: ["--json", "a.md"]).wrong, needle: "no flag of `draft`")
    closing = parsed(word: "close", words: ["2031", "/tmp/x/closing.md"])
    assert closing.wrong == ""
    assert closing.number == 2031
    assert closing.paths == ["/tmp/x/closing.md"]

    for word in ["close", "comment", "edit"]
        assert strings.contains(text: parsed(word: word, words: ["x.md"]).wrong, needle: "takes the issue's number")
        assert strings.contains(
            text: parsed(word: word, words: ["0", "x.md"]).wrong,
            needle: "takes the issue's number"
        )
        assert strings.contains(
            text: parsed(word: word, words: ["07", "x.md"]).wrong,
            needle: "takes the issue's number"
        )
        assert strings.contains(text: parsed(word: word, words: ["7"]).wrong, needle: "takes the issue's number")
        assert parsed(word: word, words: ["7", "x.md"]).number == 7

    listed = parsed(
        word: "open",
        words: ["--kind", "defect", "--milestone", "M-issue-files", "--class", "blocking", "--json"]
    )
    assert listed.wrong == ""
    assert listed.kind == "defect"
    assert listed.milestone == "M-issue-files"
    assert listed.grade == "blocking"
    assert listed.json
    assert parsed(word: "open", words: []).wrong == ""
    assert strings.contains(text: parsed(word: "open", words: ["--kind", "bug"]).wrong, needle: "`--kind` takes one of")
    assert strings.contains(
        text: parsed(word: "open", words: ["--class", "urgent"]).wrong,
        needle: "`--class` takes one of"
    )
    assert strings.contains(
        text: parsed(word: "open", words: ["--milestone", "x"]).wrong,
        needle: "`--milestone` takes one name"
    )
    assert strings.contains(text: parsed(word: "open", words: ["--kind"]).wrong, needle: "takes a value")
    assert strings.contains(text: parsed(word: "open", words: ["x.md"]).wrong, needle: "takes no file")
    assert strings.contains(text: parsed(word: "file", words: ["--json", "a.md"]).wrong, needle: "no flag of `file`")
