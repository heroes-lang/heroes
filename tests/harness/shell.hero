    assert !wide(w, words: ["mkdir", w.root + "/fw/sub"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/fw/x.hero", WIDE_WRONG]).is_err()
    assert !wide(w, words: ["mk", w.root + "/fw/sub/..\\uff0fx.hero", WIDE_CLEAN]).is_err()
    solidus = launched(w, cwd: w.root + "/fw/sub", setting: "-", words: [compiler, "check", "..\\uff0fx.hero"]).must()
    assert solidus.code == 0
    assert solidus.err == ""
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows every program `heroes build` links reads the UTF-8 code page, and a bound library's own fopen reads a name above ASCII (defect 238, W16, W21)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    acp = built_program(w, compiler: compiler, name: "acp", source: "extern \"windows.h\"\n    function GetACP() -> u32\n\nfunction main()\n    print(GetACP())\n").must(
    )
    page = run(scratch: scratch, program: acp, words: [acp]).must()
    assert page.out == "65001\n"
    assert !write_file(path: w.root + "/lib238.h", text: "#include <stdint.h>\nint64_t lib238_size(const char *path);\n").is_err()
    assert !write_file(path: w.root + "/lib238.c", text: "#include <stdio.h>\n#include <stdint.h>\n__declspec(dllexport) int64_t lib238_size(const char *path) {\n    FILE *f = fopen(path, \"rb\");\n    if (f == NULL) return -1;\n    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return -1; }\n    long n = ftell(f);\n    fclose(f);\n    return (int64_t)n;\n}\n").is_err()

    # **The DLL takes the C runtime its flag asks for, and only that one**
    # (defect 238's CI row, 2026-10-05). clang's driver puts
    # `-defaultlib:libcmt`, the static runtime, on every link that is not
    # clang-cl's, `-fms-runtime-lib=dll` or not (`MSVC.cpp`'s linker job, read
    # at `llvmorg-20.1.8` and on `main` the same day), while the object asks
    # for `msvcrt`: the CI's clang 20.1.8, linking with `link.exe`, took
    # `fclose` from the static `libucrt.lib` (LNK4217) and left `__imp_fopen`,
    # `__imp_fseek` and `__imp_ftell` unresolved, LNK1120, after LNK4098's own
    # advice, *use /NODEFAULTLIB:library*; the box's clang 23.1.1, linking with
    # `lld-link`, exits 0. So the link is told the three runtimes Microsoft's
    # page for LNK4098 names to ignore for `msvcrt.lib` (read 2026-10-05):
    # `libcmt`, `libcmtd` and `msvcrtd`.
    library = run(scratch: scratch, program: "clang", words: ["clang", "-shared", "-fms-runtime-lib=dll", "-Wl,-nodefaultlib:libcmt", "-Wl,-nodefaultlib:libcmtd", "-Wl,-nodefaultlib:msvcrtd", w.root + "/lib238.c", "-o", w.root + "/lib238.dll"]).must(
    )

    # A fixture that fails says why: the CI's run of `61e085ae` exited 1120
    # here and kept no word of it. The assert prints what clang said.
    if library.code != 0
        assert library.out + library.err == ""
    assert library.code == 0
    bound = w.root + "/bound.hero"
    assert !write_file(path: bound, text: "extern \"lib238.h\" link \"lib238\"\n    function lib238_size(path: cstr lent) -> i64\n\nfunction main()\n    print(lib238_size(path: \"café.txt\".cstr()))\n").is_err()
    linked = run(scratch: scratch, program: compiler, words: [compiler, "build", bound, "--include", w.root, "--library", w.root, "-o", w.root + "/bound.exe"]).must(
    )
    assert linked.code == 0
    assert !wide(w, words: ["mk", w.root + "/caf\\u00e9.txt", "hello\\n"]).is_err()
    sized = launched(w, cwd: w.root, setting: "-", words: [w.root + "/bound.exe"]).must()
    assert sized.out == "6\n"
    assert !remove_tree(scratch).is_err()

# W17: the runtime's own refusal, reached by answering GetACP as a Windows that
# ignores the UTF-8 code page would; the runtime included whole, GetACP alone
# replaced after the header that declares it. Its sentence is ASCII on stderr
# and nothing is on stdout, after the stream is made binary: 255 bytes and a
# line feed (panel 191's critic, settling 256 against 257).
test "fixedbugs: on Windows a program refuses to start where the UTF-8 code page is not honoured, in one ASCII sentence (defect 238, W17)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    unit = scratch + "/floor.c"
    binary = scratch + "/floor" + exe_suffix()
    assert !write_file(path: unit, text: "#include <windows.h>\n#define GetACP() 1252u\n#include \"runtime.c\"\nint main(int argc, char **argv) {\n    hero_args_set(argc, argv);\n    return 0;\n}\n").is_err()
    built = run(scratch: scratch, program: "clang", words: ["clang", "-D_CRT_SECURE_NO_WARNINGS", "-I", "runtime", unit, "-o", binary]).must(
    )
    assert built.code == 0
    refused = run(scratch: scratch, program: binary, words: [binary]).must()
    assert refused.code == 2
    assert refused.out == ""
    assert refused.err == "error: this program reads every file name, argument and environment value as UTF-8, and this Windows reads them in code page 1252: it does not honour the UTF-8 code page the program carries, so a name above ASCII would be read as another. Nothing was run.\n"
    assert refused.err.len() == 256
    assert !remove_tree(scratch).is_err()

# Three doors that RETURN a name, beside the listing's: a link's target, the
# compiler's own path and an environment value. The narrow ones answered a
# surrogate standing alone as U+FFFD under the UTF-8 code page, valid text
# naming another file; wide, the bytes are named, or refused as Linux refuses
# a target whose bytes are not UTF-8.
test "fixedbugs: on Windows a link, a compiler path and HEROES_RUNTIME holding a surrogate standing alone are named by their bytes, never written beside (defect 238)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    surrogate = "<0xED><0xA0><0x80>"
    assert !wide(w, words: ["mkdir", w.root + "/linked"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/linked/x\\ud800.hero", "function main()\\n    print( 1 )\\n"]).is_err()
    made = wide(w, words: ["symlink", w.root + "/linked/L.hero", "x\\ud800.hero"])

    # A link needs a privilege an account may lack (1314), and then this
    # half has nothing to ask; no other refusal is one.
    match made
        .err e => assert strings.contains(text: e.msg, needle: "symlink failed 1314")
        .ok _ =>
            followed = launched(w, cwd: w.root + "/linked", setting: "-", words: [compiler, "fmt", "L.hero", "--in-place"]).must(
            )
            assert followed.code == 2
            assert strings.contains(text: followed.err, needle: "the link cannot be followed")
            assert wide(w, words: ["ls", w.root + "/linked"]).must() == "L.hero\nx\\ud800.hero\n"
            assert wide(w, words: ["attrs", w.root + "/linked/L.hero"]).must() == "a link"

    inst = w.root + "/inst-\\ud800"
    assert !wide(w, words: ["mkdir", inst]).is_err()
    assert !wide(w, words: ["cp", compiler, inst + "/heroes.exe"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/hello.hero", WIDE_CLEAN]).is_err()
    placed = launched(w, cwd: w.root, setting: "HEROES_RUNTIME=", words: [inst + "/heroes.exe", "build", "hello.hero"]).must(
    )
    assert placed.code == 2
    assert strings.contains(text: placed.err, needle: "inst-" + surrogate)
    valued = launched(w, cwd: "-", setting: "HEROES_RUNTIME=" + w.root + "/rt\\ud800", words: [compiler, "doctor"]).must(
    )
    assert strings.contains(
        text: valued.out,
        needle: "runtime      `HEROES_RUNTIME` is set, and its value, `" + w.root + "/rt" + surrogate + "`, is not UTF-8"
    )
    assert !remove_tree(scratch).is_err()
