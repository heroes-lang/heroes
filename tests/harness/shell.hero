# The harness's entire contact with the operating system: run a command,
# capture its two streams and the status a shell would print, and list a
# directory.
#
# Port of what archive/bootstrap-rs/heroes-cli/tests/*.rs get from Rust's
# `std::process::Command` and `std::fs::read_dir`. design.md §1.11 is why
# this file exists at all — Heroes has no standard library, so a process
# and a directory arrive through C, and C's own `system()` is the one
# entry point every platform this project builds on already has
# (selfhost/cli/toolchain.hero:14 made the same call for clang).
#
# THREE THINGS HERE ARE MEASURED, NOT ASSUMED.
#
# 1. `sq` is the only way a path reaches the shell. Case names come from
#    a directory listing, so an apostrophe in a filename is a command the
#    harness did not mean to write. Measured: a file named `quo'te.hero`
#    is listed and read back intact.
#
# 2. The status is decoded, never used raw. `system()` answers in
#    waitpid's format — the exit code rides the high byte, a signal death
#    the low seven bits (panel 070: a hardcoded 134 reported a SIGSEGV as
#    an abort, and the instrument hid the defect from the person holding
#    it). `heroes check` exiting 1 and a compiler killed by SIGHUP are
#    both "1" if you forget this.
#
# 3. The directory walk survives a newline in a filename. Panel 085 R4
#    measured `ls > file` + `read_file` splitting such a name into two
#    entries at exit 0 — silently wrong, which CLAUDE.md §12's robustness
#    rule forbids — and named `popen`/`readdir` as the only sound routes.
#    There is a third and it costs no extern at all: `find -print0`
#    separates names with the NUL byte, and a Heroes `str` carries that
#    byte through `read_file` and byte indexing without trouble.
#    Measured on both compilers: 3 entries for 3 files, the newline name
#    whole, every one readable. The test below is that measurement, kept.

use strings

extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_limit(seconds: i64)
    function hero_run_limit_writes(bytes: i64) -> i64
    function hero_run_exe_suffix() -> str
    function hero_os_pid() -> i64
    # `lent`: each call reads the path while it runs and keeps nothing of it
    # (panel 171); this is the third of the three trees that bind the runtime,
    # and forgetting it here stops every suite of the net rather than the
    # compiler.
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_run_why() -> i64
    function hero_run_serial() -> i64
    function hero_run_discard_path() -> str
    function hero_fs_exists(path: cstr lent) -> i64
    function hero_fs_is_directory(path: cstr lent) -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_fs_remove(path: cstr lent) -> i64
    function hero_fs_newer_than(path: cstr lent, reference: cstr lent) -> i64
    # What is at a path, the link itself where it is one, and the file a link's
    # chain finally names: what a compiler path that cannot be started IS
    # (defect 332, `unstartable`).
    function hero_fs_kind(path: cstr lent) -> i64
    function hero_fs_landing(path: cstr lent) -> str
    constant HERO_FS_ABSENT: i64
    constant HERO_FS_LINK: i64
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    function hero_dir_release()
    function hero_dir_remove_tree(path: cstr lent) -> i64
    # The shown reads (defects 239 and 243): a name, or a value, that is not
    # UTF-8 comes back as a status and marks, never as a panic and never as
    # nothing. `hero_dir_at` aborts on such a name and `getenv` hands back
    # bytes `validated` can only refuse, so neither is bound here any more.
    function hero_dir_at_shown(index: i64, @status: i64, @marks: i64) -> str
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    # A captured stream is read the same way (defect 317): what a child wrote
    # that is not UTF-8 comes back as marks and shown text, never as a read
    # that failed.
    function hero_file_read_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64
    constant HERO_OS_NOT_TEXT: i64

# What `hero_dir_scan` is looking for.
constant DIR_FILES: i64
    0

constant DIR_DIRECTORIES: i64
    1

# One finished program: its exit status, and both streams.
#
# `started` is separate from `code` and must be read first. A program
# that never ran has no exit code, and the number that used to stand in
# for one — 127 — is also a code a program can legitimately exit with.
#
# **THAT SENTENCE WAS A COMMENT AND NOTHING PERFORMED IT**, which is why
# `run` below now refuses instead of asking. Measured 2026-09-21: thirteen
# of the net's twenty-four suites read `.code` and none of them read
# `.started`, 68 reads in all, while the compiler's own `Ran` is asked in
# ten places. The Windows CI leg that day reported 101 cases as
# `did not build (exit -1)` and five annotation groups as
# `the annotations and the diagnostics disagree` — two false sentences
# about one silence, because `-1` is this record's way of saying *there is
# no exit code* and both readers took it for one.
#
# `why` is the operating system's own number for the refusal, 0 where the
# program started. It is the answer the runtime always had and never handed
# over (`hero_os.h`, `hero_run_why`).
record Run
    code: i64
    out: str
    err: str
    started: bool
    why: i64

# Run `program` with `words` (its own name first), both streams captured
# to files under `scratch`, and read them back.
#
# **THIS TOOK A COMMAND LINE UNTIL M-argv-execution**, and the comment
# that stood here explained how to wrap it in a subshell so a redirection
# would bind to the whole line, and how to silence the shell's own
# announcements so that thirteen deliberately-aborting cases would not
# print thirteen lines looking like failures. All of that was the cost of
# handing a sentence to a parser. There is no sentence now: the words go
# to the operating system as a list, the streams are files this call
# opens, and a shell has no opinion about any of it.
#
# The two streams stay separate files because that is the distinction the
# goldens are about: `check/` diffs stderr while `run/` diffs stdout, and
# a harness that merged them could not tell a diagnostic from a program's
# output.
# **The same call, with a file on the child's standard input.** A sibling
# rather than a parameter on `run`, and the reason is arithmetic: `run` has
# 28 call sites and exactly one of them ever wants to feed a program, so a
# required parameter would make 27 places say "nothing" out loud. `run`
# below delegates here with the inherit sentinel, which is what the runtime
# has always meant by an empty path.
#
# **Why it exists at all**: the corpus had no program that reads its input,
# measured while planning M-corpus-depth, and every other language's example
# suite has one — Wren spells it `// stdin:` in the program itself. The price
# was measured before it was paid, which is the gate the scheduling item set:
# one file handle in `hero_run_child` on POSIX and one `CreateFileA` on the
# Windows arm, where the inherited handle already had a probe around it.
function run_fed(scratch: str, program: str, words: [str], stdin_path: str) -> Run?
    return insisted(
        ran: spawned(scratch: scratch, program: program, words: words, in_path: stdin_path, write_limit: 0)?,
        program: program
    )

function run(scratch: str, program: str, words: [str]) -> Run?
    return insisted(
        ran: spawned(scratch: scratch, program: program, words: words, in_path: "", write_limit: 0)?,
        program: program
    )

# **The same call, with every file the child writes held to `bytes`**: a
# write past it fails as a full disk fails, which is the nearest thing to
# one a case can ask for (defect 136, `suite_surface`'s in-place cases; the
# runtime's `hero_run_limit_writes` sets it between fork and exec, on that
# child alone). Where the platform has no such ceiling, `can_limit_writes`
# says so first and the caller runs nothing.
function run_limited(scratch: str, program: str, words: [str], bytes: i64) -> Run?
    return insisted(
        ran: spawned(scratch: scratch, program: program, words: words, in_path: "", write_limit: bytes)?,
        program: program
    )

# Whether a child can be held to a ceiling on what it writes: every POSIX
# platform, and not Windows. Asking clears any ceiling not yet taken.
function can_limit_writes() -> bool
    return hero_run_limit_writes(bytes: 0) == 1

# **The same call for the places that ASK whether a program is there.**
# Five of them, and each is a case whose SUBJECT is the machine: `git` that
# a record check needs, `/bin/sh` that Windows does not have, and the test
# below that names a program on purpose nobody has. They read `.started`
# and they are the reason `run` cannot simply always refuse.
#
# It is deliberately the longer name. A caller that wants the ordinary
# thing types the short one and gets the refusal; a caller that wants the
# machine's answer has to say so at the call, which is where a reader of
# the case will look for it.
function attempted(scratch: str, program: str, words: [str]) -> Run?
    return spawned(scratch: scratch, program: program, words: words, in_path: "", write_limit: 0)

# Why a `run` came back with no program verdict, for a caller about to print
# one. "" where it came back with one.
#
# The text is `insisted`'s, so it names the program and the operating system's
# own number: the pair design.md §4.17 asks a diagnostic to carry, which is
# `report.hero`'s rule for a test as much as the compiler's for a program.
# `suite_units.hero`'s `why` is the same shape over its own result type.
function refusal(got: Run?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# How a run ended, for a message about one that had to end well and did not:
# the refusal's own words where it came back with no program verdict, and its
# exit code with what it wrote on stderr where it did.
#
# **A run is told by its ending and never by a sentence of the caller's.** It
# was `complaint` until 2026-10-04, written because seven call sites built
# their failure out of `said.default(Run(err: "cannot run", …)).err`, so a
# compiler that could not be started and one that wrote three pages of
# diagnostics both printed `cannot run` (measured 2026-09-21: `suite_units`
# said `cannot runcannot run`). Its callers then prefixed it with *the build
# did not run*, of a build that ran and exited 1 and of one whose capture was
# not UTF-8 alike (defect 317), so it names the exit code too.
function ending(got: Run?) -> str
    return match got
        .ok r  => "it exited " + r.code.to_str() + said_on_stderr(r.err)
        .err e => e.msg

function said_on_stderr(err: str) -> str
    told = strings.trimmed(err)

    if told.len() == 0
        return ", with nothing on stderr"
    return ", and on stderr:\n    " + told

# A `Run` that started, or the reason there is none.
#
# **This is the executor for the sentence on `Run` above**, and the whole
# point is that it stands between the runtime and every caller rather than
# being a rule each caller remembers. What it costs is that a machine
# problem now stops a case instead of being reported as the program's own
# verdict, which is the trade the 2026-09-21 Windows leg priced: 106 red
# lines, not one of which named the machine.
function insisted(ran: Run, program: str) -> Run?
    if ran.started
        return ok(ran)

    return fail(
        code: "not_started",
        msg: program + " could not be started, so it has no exit code; the operating system's own reason is " + ran.why.to_str()
    )

function spawned(scratch: str, program: str, words: [str], in_path: str, write_limit: i64) -> Run?
    # **The scratch directory is this function's to make, not its caller's.**
    # The two streams are files opened under it, so a missing directory makes
    # the child fail to start — and `started: false` then means "the program is
    # not there", which is a lie about the program.
    #
    # Measured 2026-08-31 on the Linux CI leg: `a status is decoded the way a
    # shell prints it` asserted `started` on `/bin/sh -c 'exit 0'` and failed,
    # because the test three cases below it is the one that calls `mkdir_all`.
    # It passed here and on Darwin because `build/harness-selftest` was left
    # over from an earlier run. A test that passes on the strength of another
    # test's side effect passes for the wrong reason, and 28 call sites share
    # that directory — so the fix is the one place none of them can forget.
    mkdir_all(scratch)?

    # **A NAME NO EARLIER CALL CAN STILL BE HOLDING OPEN**, which is what this
    # serial buys and the reason panel 174 made it load-bearing.
    #
    # These two paths were `scratch + "/stdout"` and `scratch + "/stderr"` for
    # every one of the net's spawns. A descendant that outlives its parent keeps
    # the descriptor it inherited, and then the two platforms fail differently:
    # Windows refuses the next open with ERROR_SHARING_VIOLATION, so every later
    # spawn reports `started: false` with an empty stderr — 101 of 136 `run/`
    # cases and 19 of the annotation groups, CI run 35651518558, each printing
    # `the operating system's own reason is 32`. POSIX refuses NOTHING, and the
    # orphan's bytes land in the file a LATER case is judged on: measured on
    # Darwin at 497a048f, a 17-byte capture arriving as 150 bytes, 58 of them
    # NUL and three lines of them written by another case's process.
    #
    # A serial makes the second impossible rather than loud, and the first
    # impossible too: an orphan holds a name nobody will ask for again. It comes
    # from the runtime because this language has no mutable global (spec § 2).
    #
    # **And the process's id before it** (defect 320, 2026-10-04): the serial
    # counts this process's calls, so two processes that share a directory
    # wrote `stdout-1` at once, which is what two runs of the net's own tests
    # in one tree did, every test a process of its own.
    serial = pid().to_str() + "-" + hero_run_serial().to_str()
    out_path = scratch + "/stdout-" + serial
    err_path = scratch + "/stderr-" + serial
    hero_run_reset()

    # **Every call is guarded, and there is no way to ask for less.** The old
    # shape had `run` and `run_guarded`, the second prefixing coreutils'
    # `timeout 120`. Nothing this harness runs should be allowed to hang
    # forever, so the limit is not a parameter: it is what `run` means.
    hero_run_limit(seconds: WATCHDOG_SECONDS)

    # Taken by the one `hero_run_go` below and cleared there, so it never
    # reaches another child; 0 asks for none.
    if write_limit > 0
        _ = hero_run_limit_writes(bytes: write_limit)

    for word in words
        hero_run_arg(word: word)

    status: i64 @ 0
    code = hero_run_go(
        program: program.cstr(),
        in_path: in_path.cstr(),
        out_path: out_path.cstr(),
        err_path: err_path.cstr(),
        @status
    )
    hero_run_reset()

    if status != 0
        # `-1` is not an exit code and never was: it is this record saying
        # there is none, which is what `started: false` beside it means. The
        # operating system's own reason rides along rather than being asked
        # for later, because `hero_run_why` answers about the LAST call and a
        # caller that holds a `Run` may have made others since.
        why = hero_run_why()

        # The captures were opened before the program was asked for, so they
        # go here too (defect 320, 2026-10-04): two empty files per program
        # that never started, which stayed at two while the names repeated
        # and grew by two a run once they carried the process's id.
        _ = hero_fs_remove(path: out_path.cstr())
        _ = hero_fs_remove(path: err_path.cstr())
        return ok(Run(code: -1, out: "", err: "", started: false, why: why))
    out = captured(path: out_path, stream: "stdout")
    err = captured(path: err_path, stream: "stderr")

    # Read, so the names are free, and on EVERY path. **The answer is
    # deliberately not checked**: on Windows a file a descendant still holds
    # cannot be deleted, and that is precisely the case this scheme exists to
    # survive — the next spawn asks for a name nobody is holding. Refusing here
    # would turn the thing that was repaired back into a failure. Until defect
    # 317 a capture that did not read as text returned before this line, and
    # both of its files stayed on disk (measured 2026-10-04: two per such run).
    _ = hero_fs_remove(path: out_path.cstr())
    _ = hero_fs_remove(path: err_path.cstr())
    read_out = out?
    read_err = err?

    # **A child that wrote bytes that are not UTF-8 RAN, and it is told so**
    # (defect 317, 2026-10-04). Until then such a capture failed its read as
    # *cannot read the captured stdout*, and four suites wrote *cannot run the
    # compiler on* a case whose compiler had run and answered. It is still a
    # refusal rather than a `Run`: every expectation and every needle this
    # harness compares a stream against is text, so no such stream can match
    # one, and holding its bytes written as `<0xE9>` would let a stream that
    # wrote 0xE9 match an expectation that spells those six characters. So the
    # refusal names the program, how it ended and the bytes, and the case
    # fails with that sentence.
    unshown: [str] @ []

    for one in [read_out, read_err]
        if one.said.len() > 0
            unshown @ unshown.push(one.said)

    if unshown.len() > 0
        return fail(
            code: "not_text",
            msg: program + " ran and exited " + code.to_str() + ", and what it wrote is not UTF-8, which every stream this harness reads must be: " + unshown.join("; ")
        )
    return ok(Run(code: code, out: read_out.text, err: read_err.text, started: true, why: 0))

# One captured stream, read back: its text where it is UTF-8, and where it read
# whole and is not, no text and what a refusal says of it (`said`).
record Captured
    text: str
    said: str

# The capture at `path` of the stream named `stream`, read as the shown read
# reads it (`runtime/hero_os.h`), or why it could not be read at all.
function captured(path: str, stream: str) -> Captured?
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_file_read_shown(path: path.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_OK
        return ok(Captured(text: got, said: ""))

    if status == HERO_OS_NOT_TEXT
        return ok(Captured(text: "", said: "on " + stream + " " + unshown_said(answer: got, marks: marks)))
    return fail(code: "cannot_run", msg: "cannot read the captured " + stream + " at " + path)

# How far either side of the first byte that is not UTF-8 a refusal quotes, in
# bytes, before it cuts at a character's edge: a binary written to a stream is
# one line of megabytes, and a message is read by a person.
constant AROUND: i64
    60

# What a refusal says of a shown read's answer (`written` reads the same
# shape): how many of its bytes are not UTF-8, and the text around the first
# of them, from the line end or NUL before it to the one after it, `AROUND`
# bytes at most either way, each such byte written by its value.
function unshown_said(answer: str, marks: i64) -> str
    shown = answer.slice(from: marks, to: answer.len())
    bad: i64 @ 0
    first_pair: i64 @ -1
    pair: i64 @ 0

    while 2 * pair + 1 < marks
        if answer[2 * pair] != 45
            bad @ bad + 1

            if first_pair < 0
                first_pair @ pair
        pair @ pair + 1

    first = replacement_at(shown: shown, index: first_pair)

    if bad == 0 || first < 0
        return "its bytes are not UTF-8"
    start: i64 @ first

    while start > 0 && !ends_a_piece(shown[start - 1]) && first - start < AROUND
        start @ start - 1

    start @ strings.boundary_at_or_below(text: shown, at: start)
    end: i64 @ first + 3

    while end < shown.len() && !ends_a_piece(shown[end]) && end - first - 3 < AROUND
        end @ end + 1

    end @ strings.boundary_at_or_below(text: shown, at: end)
    quoted: str @ written_part(answer: answer, marks: marks, from: start, to: end)

    if start > 0 && !ends_a_piece(shown[start - 1])
        quoted @ "…" + quoted

    if end < shown.len() && !ends_a_piece(shown[end])
        quoted @ quoted + "…"

    if bad == 1
        return "1 byte is not, in `" + quoted + "`"
    return bad.to_str() + " bytes are not, the first in `" + quoted + "`"

# A line end or a NUL: where the text a refusal quotes stops, so that a
# listing of names separated by NULs (`git ls-files -z`) is quoted one name.
function ends_a_piece(byte: u8) -> bool
    return byte == 10 || byte == 0

# The offset in `shown` of its U+FFFD number `index`, counted from zero, or -1.
# The three bytes of U+FFFD stand for nothing else in UTF-8, so the count is
# exact.
function replacement_at(shown: str, index: i64) -> i64
    if index < 0
        return -1
    seen: i64 @ 0
    at: i64 @ 0

    while at + 2 < shown.len()
        if shown[at] == 239 && shown[at + 1] == 191 && shown[at + 2] == 189
            if seen == index
                return at
            seen @ seen + 1
            at @ at + 3
        else
            at @ at + 1

    return -1

# What a scan found: each name that is UTF-8, which a path can be made of, and
# each name that is not, written by its bytes (`written`), which no `str` can
# open and a message can name.
record Scanned
    names: [str]
    unnamed: [str]

# The names `hero_dir_scan` just found — and the listing is let go on the
# way out. The runtime holds those names in memory it allocated, so a
# caller that reads them and walks away leaks; the leak gate turns that
# into a panic at exit rather than a silence, which is how this line came
# to be written at all.
#
# **A name that is not UTF-8 is a value here, never a death** (defect 239,
# 2026-10-04). This read `hero_dir_at`, which panics on such a name: Linux
# keeps the bytes a program wrote, `caf<0xE9>.hero`, and Windows'
# `FindFirstFileA` answers `café.hero` in its ANSI code page, so one such file
# under a walked tree stopped the whole harness at exit 134, every suite after
# it unrun. The compiler's own walk asks `hero_dir_at_shown` since the same
# day (`selfhost/cli/process.hero`'s `walk`), and so does this one; each caller
# says what such a name means to it.
function scanned(count: i64) -> Scanned
    found: [str] @ []
    unnamed: [str] @ []
    at: i64 @ 0

    while at < count
        status: i64 @ 0
        marks: i64 @ 0
        name = hero_dir_at_shown(index: at, status: @status, marks: @marks)

        if status == HERO_OS_OK
            found @ found.push(name)
        else
            unnamed @ unnamed.push(written(answer: name, marks: marks))
        at @ at + 1

    hero_dir_release()
    return Scanned(names: found, unnamed: unnamed)

# A name or a value as the runtime's shown read hands it back, `marks` bytes
# of marks before the shown text (`runtime/hero_os.h`): each byte that is not
# UTF-8, shown as one U+FFFD, written by its value, `<0xE9>`, as the compiler
# writes it (`selfhost/cli/process.hero`'s `written_value`); a U+FFFD the
# bytes themselves held, marked `--`, stays as it is.
function written(answer: str, marks: i64) -> str
    return written_part(answer: answer, marks: marks, from: 0, to: answer.len() - marks)

# The shown text between `from` and `to`, two offsets that stand between its
# characters, written as `written` writes the whole: what a refusal quotes of a
# capture (`unshown_said`) is a part, and its marks start at the U+FFFD the
# part's first one is.
function written_part(answer: str, marks: i64, from: i64, to: i64) -> str
    shown = answer.slice(from: marks, to: answer.len())
    pieces: [str] @ []
    kept: i64 @ from
    at: i64 @ from
    mark: i64 @ 2 * replacements_before(shown: shown, at: from)

    while at + 2 < to
        if shown[at] == 239 && shown[at + 1] == 191 && shown[at + 2] == 189
            if mark + 1 < marks && answer[mark] != 45
                pieces @ pieces.push(shown.slice(from: kept, to: at))
                pieces @ pieces.push("<0x" + answer.slice(from: mark, to: mark + 2) + ">")
                kept @ at + 3
            mark @ mark + 2
            at @ at + 3
        else
            at @ at + 1

    pieces @ pieces.push(shown.slice(from: kept, to: to))
    return pieces.join("")

# How many U+FFFD of `shown` stand before `at`, an offset between characters.
function replacements_before(shown: str, at: i64) -> i64
    seen: i64 @ 0
    i: i64 @ 0

    while i + 2 < at
        if shown[i] == 239 && shown[i + 1] == 191 && shown[i + 2] == 189
            seen @ seen + 1
            i @ i + 3
        else
            i @ i + 1

    return seen

# Why a walk stopped at a name it cannot hold, in the compiler's words for the
# same refusal (`selfhost/cli/process.hero`'s `unnamed_said`).
function unnamed_said(path: str) -> str
    return "the name of `" + path + "` is not UTF-8, and this harness opens a file by a name it can hold: rename it"

# Every file directly inside `dir`, sorted, whatever its name holds.
#
# **The newline in a filename is why this used to run `find -print0`.**
# Panel 085 R4 measured `ls > file` + `read_file` splitting such a name
# into two entries at exit 0 — silently wrong — and named `readdir` as one
# of the two sound routes. The runtime takes that route now: a name never
# becomes text on its way here, so there is no separator to be confused
# by, not even the NUL the `-print0` trick was borrowing.
function list_entries(scratch: str, dir: str) -> [str]?
    _ = scratch
    found = hero_dir_scan(root: dir.cstr(), want: DIR_FILES, recursive: 0)

    if found < 0
        return fail(code: "cannot_walk", msg: "cannot list " + dir)
    scan = scanned(count: found)

    # Every caller reads each entry it is handed, a golden case or a blessed
    # file, so a name it cannot open stops the listing, named.
    if scan.unnamed.len() > 0
        return fail(code: "not_text", msg: unnamed_said(dir + "/" + scan.unnamed[0]))
    entries: [str] @ []

    for name in scan.names
        entries @ entries.push(dir + "/" + name)

    return ok(entries.sort())

# Every directory directly inside `dir`, sorted, `dir` itself excluded.
function list_directories(scratch: str, dir: str) -> [str]?
    _ = scratch
    found = hero_dir_scan(root: dir.cstr(), want: DIR_DIRECTORIES, recursive: 0)

    if found < 0
        return fail(code: "cannot_walk", msg: "cannot list the directories in " + dir)
    scan = scanned(count: found)

    if scan.unnamed.len() > 0
        return fail(code: "not_text", msg: unnamed_said(dir + "/" + scan.unnamed[0]))
    entries: [str] @ []

    for name in scan.names
        entries @ entries.push(dir + "/" + name)

    return ok(entries.sort())

# Every file this project OWNS — asked of git, which is the only thing that
# knows.
#
# **This exists because the alternative reported a TLS private key as a
# milestone identifier** (2026-08-19, found by the first run of the whole net
# from the seed-built compiler). `site/.cache/heroes-lang.org-key.pem` is a
# local certificate a parallel session had just written; it is gitignored
# (`site/.gitignore:4`), and both record walks — this one and its Rust twin —
# read it anyway and found a milestone-shaped fragment in the base64. `cargo test`
# was green at 00:05 and red at 00:47 with nothing committed in between. (The
# fragment itself is not quoted here on purpose: this is a living file, and the
# check that found it reads living files. `suite_records.hero` carries it, and
# that file is on the list of deliberate quotations.)
#
# The old question was *"what files are under this directory, minus a list of
# things I remembered to exclude"*, which is a premise about the world and
# expires whenever the world grows a new kind of junk (CLAUDE.md §11). The new
# question is *"what does git say belongs to this project"*: `--cached` for
# tracked, `--others --exclude-standard` for what is new and not ignored — so a
# file written one minute ago is still in scope, which is exactly the case the
# record checks exist for, while ignored output is not.
#
# Paths come back WITHOUT a leading `./`, unlike `list_tree`.
function project_files(scratch: str) -> [str]?
    listing = scratch + "/listing-project"
    ran = attempted(scratch: scratch, program: "git", words: ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"])?

    if !ran.started
        return fail(
            code: "cannot_walk",
            msg: "git is not on this machine, and the record checks ask git what belongs to this project"
        )

    if ran.code != 0
        return fail(
            code: "cannot_walk",
            msg: "`git ls-files` could not list this project's files — the record checks ask git what belongs here, and there is no sound fallback: a `find` reported a gitignored TLS key as a milestone identifier, which is why this function exists"
        )
    write_file(path: listing, text: ran.out)?
    entries: [str] @ []

    for piece in strings.split_on(text: ran.out, byte: 0)
        if piece.len() > 0
            entries @ entries.push(piece)

    return ok(entries.sort())

# Every file under `dir`, recursively, with whole subtrees pruned.
#
# The pruning is done by `find` and not in Heroes, and the reason is a
# measurement: this repository holds **343,010** files, of which **1,186**
# are outside `target/`, `build/` and `.git/`. Reading the long listing to
# throw 99.7% of it away would be a listing measured in megabytes for an
# answer measured in kilobytes.
function list_tree(scratch: str, dir: str, skip: [str]) -> [str]?
    _ = scratch
    found = walk_into(dir: dir, skip: skip)?

    return ok(found.sort())

# One level, then down into the directories that survive the prune.
#
# **The prune happens before the descent, and that is a measurement and
# not a style.** This repository holds 343,010 files, of which 1,186 are
# outside `target/`, `build/` and `.git/`. Walking everything and
# filtering afterwards would read megabytes to answer in kilobytes,
# which is what `find -not -path` was buying and what this has to keep.
function walk_into(dir: str, skip: [str]) -> [str]?
    files = hero_dir_scan(root: dir.cstr(), want: DIR_FILES, recursive: 0)

    if files < 0
        return fail(code: "cannot_walk", msg: "cannot list " + dir)
    scan = scanned(count: files)

    # The trees walked here are the project's own, every file of them read
    # or counted, and a directory whose name is not UTF-8 cannot be entered:
    # either stops the walk, named.
    if scan.unnamed.len() > 0
        return fail(code: "not_text", msg: unnamed_said(dir + "/" + scan.unnamed[0]))
    found: [str] @ []

    for name in scan.names
        found @ found.push(dir + "/" + name)

    dirs = hero_dir_scan(root: dir.cstr(), want: DIR_DIRECTORIES, recursive: 0)

    if dirs < 0
        return fail(code: "cannot_walk", msg: "cannot list the directories in " + dir)
    below = scanned(count: dirs)

    if below.unnamed.len() > 0
        return fail(code: "not_text", msg: unnamed_said(dir + "/" + below.unnamed[0]))

    for name in below.names
        if !skipped(name: name, skip: skip)
            for deeper in walk_into(dir: dir + "/" + name, skip: skip)?
                found @ found.push(deeper)

    return ok(found)

function skipped(name: str, skip: [str]) -> bool
    for one in skip
        if one == name
            return true

    return false

# How long a program may take before the harness stops waiting, as a
# command prefix — or "" where this machine has no `timeout`.
#
# **A corpus program can hang, and a hang is worse than a failure here**
# (2026-08-14, found by the author looking at their own screen): an
# `examples/sdl/` binding linked SDL2, whose shim opens a MODAL DIALOG
# when it cannot load SDL3, and two processes sat at 0% CPU for ninety
# minutes waiting for a click nobody could give them. This harness runs
# unattended, in three configurations: a program that never returns burns
# **THE WATCHDOG IS THE RUNTIME'S NOW, and `timeout` is gone from this
# project.** `patience()` used to answer the words to put in front of a
# program — coreutils' `timeout 120` — and `is_a_watchdog` used to work out
# whether this machine's `timeout` was that program at all.
#
# Both are deleted, and the reason is that the question could not be answered
# well enough. Windows ships a `TIMEOUT.EXE` that PAUSES for N seconds and
# launches nothing: it starts (so the first probe said yes, and 271 of the
# net's checks died), and it exits 1 on a bad argument list (so the second
# probe said yes too, and the numbers came back identical). The third probe
# finally read the child's own words and said no — correctly — and left
# Windows with **no watchdog**, which showed inside one run: two orphan
# `heroes.exe` and a `clang.exe` held `build/harness/stdout` open, and Windows
# refuses to delete a file a handle still holds, so the next run could not
# clear its own build directory.
#
# A limit is not a program. `WaitForSingleObject` already takes a deadline and
# POSIX gets one by waiting in small steps, so `hero_run_limit` is the whole
# of it — one runtime call, both platforms, no probe and nothing to be wrong
# about. It answers **124** on a kill, which is the number coreutils used, so
# every caller that read that answer reads the same one.
#
# Two minutes is the line between *slow* and *never*, chosen against the
# slowest thing the corpus actually does — seconds, not minutes — so it is not
# a performance budget in disguise (CLAUDE.md §13).
constant WATCHDOG_SECONDS: i64
    120

# **What an executable is CALLED on this machine** — "" on POSIX, ".exe" on
# Windows. The harness needs it wherever it names a binary with `-o` and then
# runs it: clang honours `-o` to the letter, and `CreateProcess` given a name
# with no extension looks for `<name>.exe` — which then does not exist. That
# was `run/`'s entire 0-of-91 on the Windows leg (every case "exit -1", never
# started), measured 2026-08-31. The answer comes from the runtime, which is
# the one place allowed to know what machine this is.
function exe_suffix() -> str
    return hero_run_exe_suffix()

# **Whether this machine runs POSIX shell scripts, asked by running one.**
# Twelve of the harness's own tests build stub compilers as `#!/bin/sh`
# scripts, ask `/bin/sh` for two streams, or write a filename with a newline
# in it — POSIX facts, and their SUBJECT, not their plumbing: the newline
# case exists because `ls` splits such a name, the stub cases because a fake
# tool must be cheap to write. On Windows `CreateProcess` reads no shebang
# and NTFS refuses the filename, so the premise these cases test is absent —
# measured 2026-08-31, 12 of 92 self-tests red on the CI leg, every one of
# them in this class, while the NET ITSELF was green there. Each such case
# asks this and steps aside where the answer is no; the net's own suites
# never call it, so nothing the compiler is judged on can hide behind it.
function can_run_scripts() -> bool
    said = attempted(scratch: SELFTEST, program: "/bin/sh", words: ["/bin/sh", "-c", "exit 0"])

    if said.is_err()
        return false

    return said.must().started && said.must().code == 0

# Kept as its own name because 40 call sites read it, and because it says at
# the call what `run` now guarantees everywhere: this will come back.
function run_guarded(scratch: str, words: [str]) -> Run?
    return run(scratch: scratch, program: words[0], words: words)

# Every file under `dir`, recursively, whose name ends in `suffix` and
# which is newer than `reference`. What `find -name … -newer` answered,
# without a `find`.
#
# An empty `suffix` matches everything; an empty `reference` drops the
# age question. The two are separate because the callers ask them
# separately, and joining them would make one of the two a premise.
function found_under(dir: str, suffix: str, reference: str) -> [str]?
    count = hero_dir_scan(root: dir.cstr(), want: DIR_FILES, recursive: 1)

    if count < 0
        return fail(code: "cannot_walk", msg: "cannot walk " + dir)
    scan = scanned(count: count)

    # **Only a name the caller asked for stops this walk.** Its callers walk
    # `build/`, where any test may leave a file of any name, for one suffix
    # each: the compiler's own test of defect 239 leaves
    # `build/selftest-walk-names/only/caf<0xE9>.hero` on Linux, and `cache`
    # asks this walk for `.o`. A name that is not UTF-8 ends in the suffix
    # exactly when its written form does, every suffix asked being ASCII.
    for name in scan.unnamed
        if suffix.len() == 0 || ends_with(text: name, tail: suffix)
            return fail(code: "not_text", msg: unnamed_said(dir + "/" + name))

    out: [str] @ []

    for name in scan.names
        full = dir + "/" + name

        if suffix.len() > 0 && !ends_with(text: name, tail: suffix)
            continue

        if reference.len() > 0 && hero_fs_newer_than(path: full.cstr(), reference: reference.cstr()) != 1
            continue
        out @ out.push(full)

    return ok(out.sort())

# Asked of the bytes, as `strings.ends_with` asks them: the slice this was
# put its cut inside a character above ASCII, and a file such as `é.txt`
# under a walked tree would have stopped the harness (found beside defect
# 110, 2026-09-27).
function ends_with(text: str, tail: str) -> bool
    return strings.ends_with(text: text, suffix: tail)

# One list after another. `+` joins two `str`s and this language does
# not overload it onto arrays, which is why this exists rather than
# being written inline at six call sites.
function both(first: [str], second: [str]) -> [str]
    out: [str] @ first

    for one in second
        out @ out.push(one)

    return out

# One environment variable: "" where it is unset, its value where that is
# UTF-8, and a failure naming the variable where it is set and not, which the
# caller tells at its place. The failure does not quote the value; a caller
# whose variable names a place quotes it with `env_written`.
#
# **It answered "" for a value that is not UTF-8 until 2026-10-04** (defect
# 243): `getenv` and `validated`, defaulted, so a `HEROES_COMPILER` naming a
# compiler in bytes that are not UTF-8 was read as unset and the harness
# judged `./heroes` instead, no word said. The compiler's own `env` (in
# `selfhost/cli/process.hero`) answers this way since the same day, through
# the same runtime call.
function env(name: str) -> str?
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_env_shown(name: name.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_NOT_FOUND
        return ok("")

    if status == HERO_OS_OK
        return ok(got)
    return fail(
        code: "not_text",
        msg: "`" + name + "` is set, and its value is not UTF-8, which a value this harness reads must be"
    )

# A variable's value as a message may quote it, each byte that is not UTF-8
# written by its value, `<0xE9>`; "" where it is unset. For a variable that
# names a place, never for one that may hold a secret.
function env_written(name: str) -> str
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_env_shown(name: name.cstr(), status: @status, marks: @marks)
    return written(answer: got, marks: marks)

# The compilers this harness's own test blocks may use, in the order they are
# tried. Read as: whatever the caller named, then the binary in the repository
# root — the one every command in CLAUDE.md § Commands and the ROADMAP's *Verify
# it yourself* block names — then what CI builds from the seed with clang alone,
# then a local seed build.
#
# **`./heroes` was missing from this list and `./target/debug/heroes` was on it**
# until 2026-08-25 (author decision, `/decide` answer `a`). The second is the
# bootstrap, archived at M-bootstrap-archive, so the list reached for a dead path
# before the live one — and the comment below has said *"the path they must not
# name is the bootstrap's"* since the day of the archive, with the list under it
# naming it. What that cost is measured: `suite_run`'s self-test reached a
# `build/heroes-seed` dated 2026-08-19 and every program it built died on
# `_Static_assert` against `HERO_RUNTIME_ABI 15` — the stamp doing exactly its
# job (CLAUDE.md §7, version skew) against a test that trusted whatever binary
# was lying around.
#
# A stale `./heroes` is no safer than a stale seed build, and that is the point:
# the ABI stamp turns skew into a loud clang error rather than a wrong answer,
# and the ROADMAP's first line rebuilds it in 3.5 s. In CI nothing here is
# reached at all — the leg names `HEROES_COMPILER`, so the answer is decided
# rather than searched for.
constant CANDIDATES: [str]
    [
        "./heroes"
        "./heroes-from-seed"
        "./build/heroes-seed"
    ]

# A compiler these self-tests can run, asked of the MACHINE rather than
# assumed from a path.
#
# **The path they must not name is the bootstrap's.** `./target/debug/heroes` is
# what the archive deletes, and the day it goes is the day this harness matters
# most — which is exactly why `suite_golden.hero`'s stubs exist. Nine self-tests
# named it as a literal, so nine of them would have started failing on the move
# commit, in the net that was built to survive it (found 2026-08-19, while
# adding the seed leg to CI). It stayed in the list above for six more days,
# which is the whole argument for the CI leg that now runs this file.
#
# No answer is a loud failure rather than a skip: the harness is being run
# BY a compiler, so one exists, and if none of these paths holds it the
# failure says which places it looked at.
#
# **A `HEROES_COMPILER` that is not UTF-8 is a refusal, never a fallback**
# (defect 243): until 2026-10-04 it read as unset, and the net judged
# whichever compiler came first in the list below without a word.
function some_compiler() -> str?
    named = env(name: "HEROES_COMPILER")

    if named.is_err()
        return fail(
            code: "not_text",
            msg: "HEROES_COMPILER is set to `" + env_written(name: "HEROES_COMPILER") + "`, which is not UTF-8, and this harness runs a compiler by a path it can hold: set it in UTF-8, or name the compiler, -- <compiler>"
        )

    # **And one that names nothing is a refusal too** (defect 316,
    # 2026-10-04). It was passed over in silence for the first candidate, so a
    # value with a slip in it, or one naming a compiler since moved, had the
    # net judge `./heroes` without a word. The value is asked as the machine
    # spells a program, its suffix added where it has one, as the candidates
    # below are. An empty value is no value, as the compiler's own `env` reads
    # an empty `HEROES_RUNTIME` (`selfhost/cli/process.hero`).
    #
    # **And one that names what no case could start is refused as well**
    # (defect 332, 2026-10-07): a directory, a file this machine will not
    # start, a link to nothing. Each was answered as the compiler, and every
    # case of every suite then failed as a program that could not be started,
    # 4,000 failures and 23 suites before one could not run, measured with a
    # directory that day; `unstartable` says what the path is instead.
    hint = named.must()

    if hint.len() > 0
        for name in spellings(hint)
            if hero_fs_kind(path: name.cstr()) != HERO_FS_ABSENT
                why = unstartable(scratch: SELFTEST, path: name)

                if why.len() > 0
                    return fail(
                        code: "unstartable",
                        msg: "HEROES_COMPILER is set to `" + hint + "`, and " + why + ", so it names no compiler this machine can start: set it to one, unset it, or name the compiler, -- <compiler>"
                    )
                return ok(started_as(name))

        return fail(
            code: "absent",
            msg: "HEROES_COMPILER is set to `" + hint + "`, and no file is there, so it names no compiler: set it to one, unset it, or name the compiler, -- <compiler>"
        )

    # The first place that holds anything is the answer, and what it holds
    # must start: a directory or a link to nothing at `./heroes` is refused by
    # name (defect 332), never passed over for the next place, which would
    # judge a compiler nobody chose without a word, defect 316's shape.
    for path in CANDIDATES
        for name in spellings(path)
            if hero_fs_kind(path: name.cstr()) != HERO_FS_ABSENT
                why = unstartable(scratch: SELFTEST, path: name)

                if why.len() > 0
                    return fail(
                        code: "unstartable",
                        msg: "`" + name + "` is the first place this harness finds anything where it looks for a compiler, and " + why + ", so no compiler is chosen: build one there, or name the compiler, -- <compiler>"
                    )
                return ok(name)

    return fail(code: "none", msg: no_compiler_anywhere())

# A program's name as given, then as the machine spells it: `./heroes` is
# `./heroes.exe` on Windows, and a list that forgets the suffix answers "" on a
# machine with a perfectly good compiler in the root — measured 2026-08-31,
# four self-tests red on the VPS while CI passed them only because its leg
# names HEROES_COMPILER.
function spellings(name: str) -> [str]
    if exe_suffix().len() == 0
        return [name]
    return [name, name + exe_suffix()]

# WHY A PATH NAMES NO COMPILER A CASE COULD START, "" where it names one
# (defect 332, 2026-10-07). Every case of every suite starts the compiler it is
# handed, so a path naming a directory, a file this machine will not start or a
# link to nothing was one failure per case, each *could not be started*, where
# one refusal at the start says it. What is at the path is asked first, so the
# refusal names it; then the machine is asked to start it, as every case would,
# with `--version`, which a compiler answers and nothing here reads, since only
# a start says whether this machine runs a file. The program started is the one
# a case starts (`started_as`, defect 331), and its two captures go as every
# run's do.
function unstartable(scratch: str, path: str) -> str
    if path.len() == 0
        return "it is an empty word, which names no file"
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_ABSENT
        return "no file is there"

    if kind == HERO_FS_LINK && !exists(path)
        target = hero_fs_landing(path: path.cstr())

        if target.len() == 0
            return "it is a link whose chain cannot be followed"
        return "it is a link to `" + target + "`, and no file is there"

    if is_directory(path)
        return "it is a directory"
    program = started_as(path)
    said: str @ ""

    match attempted(scratch: scratch, program: program, words: [program, "--version"])
        .ok ran =>
            if !ran.started
                said @ "this machine refuses to start it, the operating system's own reason being " + ran.why.to_str() + " (13 is a file it may not run, on Linux and macOS)"
        .err e =>
            # It ran and wrote what is not text (defect 317), which is a start;
            # anything else kept the question from being asked.
            if e.code != "not_text"
                said @ "it could not be asked to start: " + e.msg

    return said

# The name a compiler is checked by and started by: one string for both
# (defect 331). `exists` asks for a name with no separator in the working
# directory, as it asks for every path here, and the start of a program so
# named searches the PATH (`execvp`), so with `HEROES_COMPILER=heroes` or
# `-- heroes` the file checked was `./heroes` and the program judged was the
# PATH's `heroes`, measured 2026-10-04 with a stub on the PATH. `./` makes the
# name a path, which no start searches. A `\` and a drive's `:` part a path
# only where Windows writes paths, and are bytes of a name elsewhere
# (`selfhost/cli/runtime_places.hero`'s rule); the runtime says which machine
# this is.
function started_as(name: str) -> str
    windows = exe_suffix() == ".exe"
    at: i64 @ 0

    while at < name.len()
        if name[at] == '/' || windows && (name[at] == '\\' || name[at] == ':')
            return name
        at @ at + 1

    if name.len() == 0
        return name
    return "./" + name

# What to print when there is none — the four places, named.
function no_compiler_anywhere() -> str
    return "no compiler found: set HEROES_COMPILER, or build one at " + CANDIDATES.join(" / ")

function exists(path: str) -> bool
    return hero_fs_exists(path: path.cstr()) == 1

function is_directory(path: str) -> bool
    return hero_fs_is_directory(path: path.cstr()) == 1

function mkdir_all(path: str) -> ()?
    if hero_fs_mkdir_all(path: path.cstr()) != 0
        return fail(code: "cannot_run", msg: "cannot create the directory " + path)
    return ok()

function remove_tree(path: str) -> ()?
    if hero_dir_remove_tree(path: path.cstr()) != 0
        return fail(code: "cannot_run", msg: "cannot remove " + path)
    return ok()

# THE NET'S OWN TESTS, EACH IN A DIRECTORY NO OTHER LIVE PROCESS USES (defect
# 320, 2026-10-04). `heroes test` runs every test in a process of its own, and
# the tests wrote their files under one fixed `build/harness-selftest`, so two
# runs of this file in one tree ran the same test over the same files at the
# same moment: 13 and 14 failures where either run alone read 0, measured that
# day, every one a test reading another's files. A test that writes files asks
# for this directory, made fresh, since a process that had the same id before
# may have left one, and removes it as it ends; one that fails leaves it for
# whoever reads why, as the net leaves its own when a suite cannot run.
constant SELFTEST: str
    "build/harness-selftest"

function own_scratch() -> str
    dir = SELFTEST + "/" + pid().to_str()
    _ = remove_tree(dir).is_err()
    _ = mkdir_all(dir).is_err()
    return dir

# This process's id — the one number no other process running now shares,
# which is what a scratch directory's name needs (main.hero).
function pid() -> i64
    return hero_os_pid()

test "a name's suffix is asked of its bytes, whatever the name holds above ASCII"
    assert ends_with(text: "a.hero", tail: ".hero")
    assert ends_with(text: "café/é.hero", tail: ".hero")
    assert !ends_with(text: "é.txt", tail: ".hero")
    assert !ends_with(text: "cafés.md", tail: ".hero")
    assert !ends_with(text: "😀", tail: ".hero")

test "a status is decoded the way a shell prints it"
    # POSIX is this case's subject, and this machine answers for itself
    # (shell.hero::can_run_scripts carries the measurement).
    if !can_run_scripts()
        return

    # 1 << 8 is `exit 1`; 134 is the shape panel 070's hardcoded number
    # got wrong — SIGABRT is 6, so waitpid says 6 and a shell says 134.
    # **`status_of` is gone and the runtime answers instead.** It decoded
    # waitpid's format by hand — the exit code in the high byte, a signal
    # in the low seven bits — which was right on POSIX and wrong on
    # Windows, where the same call answers the exit code directly. These
    # assertions are now about what a program really did.
    quiet = run(scratch: "build/harness-selftest", program: "/bin/sh", words: ["/bin/sh", "-c", "exit 0"])
    assert !quiet.is_err()
    assert quiet.must().started
    assert quiet.must().code == 0

    angry = run(scratch: "build/harness-selftest", program: "/bin/sh", words: ["/bin/sh", "-c", "exit 2"])
    assert !angry.is_err()
    assert angry.must().code == 2

    absent = attempted(
        scratch: "build/harness-selftest",
        program: "heroes-no-such-program",
        words: ["heroes-no-such-program"]
    )
    assert !absent.is_err()
    assert !absent.must().started

    # **The operating system says WHY, and this is the assertion that keeps
    # it saying so.** The number itself differs by platform — POSIX answers
    # `ENOENT`, Windows `ERROR_FILE_NOT_FOUND` — so what is asserted is that
    # there IS one, which is the property the 2026-09-21 Windows leg lacked.
    assert absent.must().why != 0

    # And the ordinary `run` refuses the same program rather than handing
    # back a record whose `code` means nothing.
    refused = run(
        scratch: "build/harness-selftest",
        program: "heroes-no-such-program",
        words: ["heroes-no-such-program"]
    )
    assert refused.is_err()

test "a command's two streams come back apart, with its status"
    # POSIX is this case's subject, and this machine answers for itself
    # (shell.hero::can_run_scripts carries the measurement).
    if !can_run_scripts()
        return
    scratch = own_scratch()
    assert !mkdir_all(scratch).is_err()

    # **`/bin/sh` is the PROGRAM here, and that is the honest shape.** The
    # case needs something that writes to both streams and exits 3, and a
    # shell is a perfectly ordinary program to ask for that — what is gone
    # is the harness handing a sentence to a shell it did not name. On a
    # machine with no `/bin/sh` this one test reports `started: false`
    # rather than a wrong answer, and the same case written in Heroes and
    # compiled would cost this module a dependency on the compiler under
    # test, which is the one thing a self-test may not have.
    said = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "printf 'to out'; printf 'to err' 1>&2; exit 3"]
    )
    assert !said.is_err()
    assert said.must().out == "to out"

    assert said.must().err == "to err"
    assert said.must().code == 3
    assert !remove_tree(scratch).is_err()

# **THE CAPTURES DO NOT PILE UP, and this is the instrument that says so.**
#
# Author instruction 2026-09-22, in their own words: *avoid like death errors
# that go and fill the disk with useless files.* Panel 174 gave every spawn its
# own pair of capture files, which is what closed defect 074 — and it moved the
# cost from a name collision to a file count. The net starts thousands of
# processes in one run, so a removal that quietly stops working turns two files
# into tens of thousands and nothing else in the tree would notice.
#
# It watches the WORLD and not this module's own bookkeeping: it runs real
# programs through the real `run`, then asks the directory what is in it. What
# would still pass if the removal were broken? Nothing — the count is the
# subject.
#
# **IT COUNTED NOTHING UNTIL DEFECT 330** (2026-10-07). Its loop asked each
# listed PATH, whole, whether it opened with `stdout-`, and a listing names
# `<dir>/stdout-…`, so it counted 0 over any directory: measured with 2 and with
# 24 captures planted beside its twelve runs, it read 0 and passed both. It
# reads the names now, through `captures_left`, the count the tests of defects
# 317 and 320 already asked, and it plants two captures and asks that count to
# see them, so a count that stops seeing a capture fails here before it can
# pass over a pile of them.
#
# **The ceiling is 0.** It was 2, for a capture in flight in a directory another
# process shared; since defect 320 the directory is this test's own, the twelve
# runs have ended when it is read, and nothing else writes a capture in it.
test "the captures are removed, so a run cannot fill the disk with them"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    assert !remove_tree(scratch).is_err()
    assert !mkdir_all(scratch).is_err()

    for _ in range(from: 0, to: 12)
        said = run(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", "exit 0"])
        assert !said.is_err()

    # Twelve spawns wrote twenty-four capture files. If the removal works the
    # directory holds none of them; if it does not, it holds twenty-four and a
    # real run holds thousands.
    assert captures_left(scratch) == 0

    # The count sees what a removal that stopped working would leave.
    assert !write_file(path: scratch + "/stdout-planted", text: "").is_err()
    assert !write_file(path: scratch + "/stderr-planted", text: "").is_err()
    assert captures_left(scratch) == 2
    assert !remove_tree(scratch).is_err()

test "the directory walk keeps a filename that contains a newline"
    # POSIX is this case's subject, and this machine answers for itself
    # (shell.hero::can_run_scripts carries the measurement).
    if !can_run_scripts()
        return

    # Panel 085 R4's falsifier, kept as a test: this is the case `ls`
    # splits in two at exit 0. If the NUL route ever stops working, this
    # is what fires, and the harness stops trusting its own case list.
    scratch = own_scratch()
    hostile = scratch + "/hostile"
    assert !remove_tree(hostile).is_err()
    assert !mkdir_all(hostile).is_err()

    # **The files are written by the language, not by `touch` inside a
    # subshell.** `write_file` carries an apostrophe and a newline in a
    # path the same way it carries any other byte, so the case that used
    # to need a shell — and a quoting function to survive it — is now
    # four ordinary calls.
    assert !write_file(path: hostile + "/plain.hero", text: "").is_err()
    assert !write_file(path: hostile + "/two\nlines.hero", text: "").is_err()
    assert !write_file(path: hostile + "/quo'te.hero", text: "").is_err()
    found = list_entries(scratch: scratch, dir: hostile)
    assert !found.is_err()
    assert found.must().len() == 3
    readable: i64 @ 0

    for entry in found.must()
        if !read_file(entry).is_err()
            readable @ readable + 1

    assert readable == 3
    assert !remove_tree(scratch).is_err()

test "fixedbugs: the watchdog is a runtime limit, because no probe could name the program"
    # Symptom: 271 of 357 net checks failed on the Windows leg with
    # `ERROR: Invalid syntax`, every one of them the compiler never launched.
    # Cause: the harness prefixed every invocation with coreutils' `timeout
    # 120`, and Windows ships a `TIMEOUT.EXE` that pauses for N seconds and
    # launches nothing. Date: 2026-08-31.
    #
    # **Three probes, and the reason this case now asserts an absence.** The
    # first asked whether a program called `timeout` STARTS — TIMEOUT.EXE
    # starts. The second asked whether it exits 1 on a refused argument —
    # TIMEOUT.EXE exits 1, and the net came back with numbers identical to the
    # round before, 686/357 both times. The third read the child's own words
    # and said no, correctly, which left Windows with no watchdog at all: two
    # orphan `heroes.exe` and a `clang.exe` held `build/harness/stdout` open,
    # and Windows will not delete a file a handle holds, so the next run could
    # not clear its build directory.
    #
    # A limit is not a program, so it stopped being one. What this case can
    # assert is that the number every caller relies on is still the number
    # coreutils used, and that the guard is asked for rather than assumed.
    assert WATCHDOG_SECONDS == 120

    # It really runs a program and really gets its code back, with a limit
    # nothing here comes near.
    quick = run(scratch: "build/harness-selftest", program: "clang", words: ["clang", "--heroes-no-such-flag"])
    assert !quick.is_err()
    assert quick.must().started
    assert quick.must().code == 1

# The runtime's shown answer (`runtime/hero_os.h`): two marks for each U+FFFD
# of the text, the byte it replaced in hexadecimal, or `--` for one the bytes
# themselves held, and the text after them.
test "a name that is not UTF-8 is written by its bytes, and a U+FFFD it holds stays"
    assert written(answer: "E9caf�.hero", marks: 2) == "caf<0xE9>.hero"
    assert written(answer: "C3FFa��b", marks: 4) == "a<0xC3><0xFF>b"
    assert written(answer: "--E9a�b�c", marks: 4) == "a�b<0xE9>c"
    assert written(answer: "plain", marks: 0) == "plain"
    assert written(answer: "a�", marks: 0) == "a�"

# Defect 239 in the harness's own walk (2026-10-04): a name that is not UTF-8
# is named by its bytes and never panics, and a walk for one suffix passes
# over a name that does not end in it. Only C can make such a name, so a
# program of a few lines does: Linux keeps `caf<0xE9>.hero` as written, and
# this Mac's APFS refuses the name (errno 92), where the test asserts the
# walks whole. **On Windows the only such name holds a surrogate standing
# alone**, made by `CreateFileW` (panel 191's R3): this branch made `café.hero`
# through the narrow `fopen` until 2026-10-04 and read it back through the
# narrow listing, both in code page 1252, so it passed while testing defect
# 238 as the platform. The walk names the surrogate's three bytes and enters a
# directory so named (panel 191's R2), and the tree goes whole by its names.
test "fixedbugs: a walk names a file whose name is not UTF-8, and never panics (defect 239)"
    scratch = own_scratch()
    dir = scratch + "/walk-names"
    only = dir + "/only"
    nothing: [str] = []
    assert !remove_tree(dir).is_err()
    assert !mkdir_all(only).is_err()
    assert !write_file(path: only + "/plain.hero", text: "").is_err()
    windows = exe_suffix() == ".exe"
    maker = dir + "/maker" + exe_suffix()
    assert !write_file(path: dir + "/maker.c", text: maker_source(only: only, windows: windows)).is_err()
    built = run(scratch: scratch, program: "clang", words: ["clang", dir + "/maker.c", "-o", maker])
    assert !built.is_err()
    assert built.must().code == 0
    made = run(scratch: scratch, program: maker, words: [maker])
    assert !made.is_err()
    assert made.must().code == 0 || made.must().code == 3 && !windows
    byte: str @ "<0xE9>"

    if windows
        byte @ "<0xED><0xA0><0x80>"

    if made.must().code == 0
        file = "the name of `" + only + "/caf" + byte + ".hero` is not UTF-8"
        assert strings.contains(text: refused_walk(list_entries(scratch: scratch, dir: only)), needle: file)
        assert strings.contains(
            text: refused_walk(list_tree(scratch: scratch, dir: only, skip: nothing)),
            needle: "is not UTF-8"
        )
        assert strings.contains(
            text: refused_walk(list_directories(scratch: scratch, dir: only)),
            needle: "the name of `" + only + "/d" + byte + "` is not UTF-8"
        )
        assert strings.contains(
            text: refused_walk(found_under(dir: only, suffix: ".hero", reference: "")),
            needle: byte
        )

        # A walk for another suffix passes over both, as `cache` walks
        # `build/` for `.o` beside what the compiler's own tests leave there.
        assert found_under(dir: only, suffix: ".o", reference: "").must().len() == 0
    else
        assert list_entries(scratch: scratch, dir: only).must() == [only + "/plain.hero"]
        assert list_directories(scratch: scratch, dir: only).must().len() == 0
        assert list_tree(scratch: scratch, dir: only, skip: nothing).must() == [only + "/plain.hero"]
        assert found_under(dir: only, suffix: ".hero", reference: "").must() == [only + "/plain.hero"]

    # The runtime removes a tree by its names' bytes, so none is left behind.
    assert !remove_tree(dir).is_err()
    assert !exists(dir)
    assert !remove_tree(scratch).is_err()

# A program that makes, under `only`, a file and a directory whose names are
# not UTF-8, and a file inside that directory: exit 3 where the file cannot be
# made, 4 the directory, 5 the file inside it. On POSIX the names hold the
# byte 0xE9; on Windows a surrogate standing alone, by the wide calls, the
# one name NTFS keeps that is not UTF-8.
function maker_source(only: str, windows: bool) -> str
    if windows
        return "#include <windows.h>\nstatic int touch(const wchar_t *path) {\n    HANDLE h = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);\n    if (h == INVALID_HANDLE_VALUE) return 0;\n    return CloseHandle(h) != 0;\n}\nint main(void) {\n    if (!touch(L\"" + only + "/caf\\xD800.hero\")) return 3;\n    if (!CreateDirectoryW(L\"" + only + "/d\\xD800\", NULL)) return 4;\n    if (!touch(L\"" + only + "/d\\xD800/x.hero\")) return 5;\n    return 0;\n}\n"
    return "#include <stdio.h>\n#include <sys/stat.h>\nstatic int touch(const char *path) {\n    FILE *f = fopen(path, \"wb\");\n    if (f == NULL) return 0;\n    return fclose(f) == 0;\n}\nint main(void) {\n    if (!touch(\"" + only + "/caf\\xe9.hero\")) return 3;\n    if (mkdir(\"" + only + "/d\\xe9\", 0755) != 0) return 4;\n    if (!touch(\"" + only + "/d\\xe9/x.hero\")) return 5;\n    return 0;\n}\n"

# Why a walk refused, "" where it answered.
function refused_walk(got: [str]?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# Defect 243 in the harness (2026-10-04): a variable set to bytes that are not
# UTF-8 is named, never read as unset. Only a child's environment can hold such
# bytes, and only a shell puts them there, so the harness's own modules, byte
# for byte, are built under a program printing what each reader answers, and
# run three ways. Until that day the first run printed `compiler ok ./heroes`,
# the list's first candidate, judged in silence.
test "fixedbugs: a HEROES_COMPILER or HEROES_RUNTIME that is not UTF-8 is named, never read as unset (defect 243)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    compiler = some_compiler().must()
    probe = env_probe(scratch).must()
    bad = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "HEROES_COMPILER=\"$(printf 'nowhere/heroes\\351')\" HEROES_RUNTIME=\"$(printf 'nowhere/rt\\351')\" exec \"$0\"", probe]
    )
    assert !bad.is_err()
    assert strings.contains(
        text: bad.must().out,
        needle: "compiler not_text: HEROES_COMPILER is set to `nowhere/heroes<0xE9>`, which is not UTF-8"
    )
    assert strings.contains(
        text: bad.must().out,
        needle: "runtime unasked: HEROES_RUNTIME is set to `nowhere/rt<0xE9>`, which is not UTF-8"
    )
    assert strings.contains(
        text: bad.must().out,
        needle: "env not_text: `HEROES_RUNTIME` is set, and its value is not UTF-8"
    )

    # The same readers over values that are text, and over none.
    good = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "HEROES_COMPILER=\"$1\" HEROES_RUNTIME=rt exec \"$0\"", probe, compiler]
    )
    assert !good.is_err()
    assert strings.contains(text: good.must().out, needle: "compiler ok " + compiler + "\n")
    assert strings.contains(text: good.must().out, needle: "runtime ok rt\n")
    unset = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "unset HEROES_COMPILER HEROES_RUNTIME; exec \"$0\"", probe]
    )
    assert !unset.is_err()
    assert strings.contains(text: unset.must().out, needle: "compiler ok ")
    assert strings.contains(text: unset.must().out, needle: "runtime ok \n")
    assert !remove_tree(scratch).is_err()

# DEFECT 316, held as a test (2026-10-04): a `HEROES_COMPILER` that is UTF-8
# and names nothing is a refusal naming it, where it was passed over in
# silence for `./heroes` and the net judged a compiler nobody named; a value
# with a stray space names nothing too. An empty value is no value, and the
# candidates are asked.
test "fixedbugs: a HEROES_COMPILER that names nothing is refused, never passed over (defect 316)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    probe = env_probe(scratch).must()

    for value in ["/nonexistent/heroes", " ./heroes"]
        told = run(
            scratch: scratch,
            program: "/bin/sh",
            words: ["/bin/sh", "-c", "HEROES_COMPILER=\"$1\" exec \"$0\"", probe, value]
        )
        assert !told.is_err()
        assert strings.contains(
            text: told.must().out,
            needle: "compiler absent: HEROES_COMPILER is set to `" + value + "`, and no file is there, so it names no compiler"
        )

    empty = run(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", "HEROES_COMPILER= exec \"$0\"", probe])
    assert !empty.is_err()
    assert strings.contains(text: empty.must().out, needle: "compiler ok ")
    assert !remove_tree(scratch).is_err()

# DEFECT 332, held as a test (2026-10-07): a compiler path naming a directory,
# a file this machine will not start or a link to nothing is refused, saying
# which, where each was answered as the compiler and every case then failed as
# a program that could not be started. Asked of `unstartable`, which the net's
# start asks of `-- <compiler>`; of `HEROES_COMPILER` through a child's
# environment, as the net reads it; and of `./heroes`, the first place looked
# at, from a folder where it is a directory. Until that day the probe printed
# `compiler ok` for each value, and `checked ./heroes` for the folder.
test "fixedbugs: a compiler path that names a directory, a file that will not start or a link to nothing is refused, saying which (defect 332)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    folder = scratch + "/a-folder"
    plain = scratch + "/a-plain-file"
    link = scratch + "/a-link"
    assert !mkdir_all(folder).is_err()
    assert !write_file(path: plain, text: "#!/bin/sh\nexit 0\n").is_err()
    linked = run(scratch: scratch, program: "ln", words: ["ln", "-s", "nothing-332", link])
    assert !linked.is_err()
    assert linked.must().code == 0
    assert unstartable(scratch: scratch, path: folder) == "it is a directory"
    assert unstartable(scratch: scratch, path: plain) == "this machine refuses to start it, the operating system's own reason being 13 (13 is a file it may not run, on Linux and macOS)"
    assert unstartable(scratch: scratch, path: link) == "it is a link to `" + scratch + "/nothing-332`, and no file is there"
    assert unstartable(scratch: scratch, path: scratch + "/nothing-332") == "no file is there"
    assert unstartable(scratch: scratch, path: "") == "it is an empty word, which names no file"
    assert unstartable(scratch: scratch, path: some_compiler().must()) == ""

    # The starts asked leave no capture behind.
    assert captures_left(scratch) == 0
    probe = env_probe(scratch).must()

    for value in [folder, plain, link]
        told = run(
            scratch: scratch,
            program: "/bin/sh",
            words: ["/bin/sh", "-c", "HEROES_COMPILER=\"$1\" exec \"$0\"", probe, value]
        )
        assert !told.is_err()
        assert strings.contains(
            text: told.must().out,
            needle: "compiler unstartable: HEROES_COMPILER is set to `" + value + "`, and " + unstartable(scratch: scratch, path: value) + ", so it names no compiler this machine can start"
        )

    # `./heroes` a directory, HEROES_COMPILER unset: refused by name, never
    # passed over for the next place and never started.
    here = scratch + "/candidate"
    assert !mkdir_all(here + "/heroes").is_err()
    start = harness_probe(scratch: scratch, name: "candidate-probe", main: START_PROBE).must()
    ran = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "p=\"$PWD/$0\"; cd \"$1\" && unset HEROES_COMPILER && exec \"$p\"", start, here]
    )
    assert !ran.is_err()
    assert ran.must().out == "refused unstartable: `./heroes` is the first place this harness finds anything where it looks for a compiler, and it is a directory, so no compiler is chosen: build one there, or name the compiler, -- <compiler>\n"
    assert !remove_tree(scratch).is_err()

# DEFECT 331, held as a test (2026-10-04): a compiler named bare is the file
# the harness checked, the working directory's, and never one the PATH holds.
# A stub stands in each place, and a probe asking `some_compiler` and starting
# its answer as every suite starts the compiler runs where the first stands.
# Until that day it printed `checked heroes` and started the PATH's. Windows
# searches the working directory before the PATH, and runs no script, so
# there the rule is asserted of the names alone.
test "fixedbugs: a compiler named bare is started as the file that was checked, never from the PATH (defect 331)"
    assert started_as("heroes") == "./heroes"
    assert started_as("./heroes") == "./heroes"
    assert started_as("bin/heroes") == "bin/heroes"
    assert started_as("/opt/heroes") == "/opt/heroes"
    assert started_as("") == ""

    if exe_suffix() == ".exe"
        assert started_as("C:\\w\\heroes.exe") == "C:\\w\\heroes.exe"
        assert started_as("bin\\heroes.exe") == "bin\\heroes.exe"
        assert started_as("C:heroes.exe") == "C:heroes.exe"
    else
        assert started_as("a\\heroes") == "./a\\heroes"

    if !can_run_scripts()
        return
    scratch = own_scratch()
    here = scratch + "/bare-here"
    elsewhere = scratch + "/bare-path"
    assert !mkdir_all(here).is_err()
    assert !mkdir_all(elsewhere).is_err()
    assert !stub_named(path: here + "/heroes", says: "the working directory's", scratch: scratch).is_err()
    assert !stub_named(path: elsewhere + "/heroes", says: "the PATH's", scratch: scratch).is_err()
    probe = harness_probe(scratch: scratch, name: "bare-probe", main: START_PROBE).must()
    ran = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "p=\"$PWD/$0\"; bin=\"$PWD/$2\"; cd \"$1\" && PATH=\"$bin:$PATH\" HEROES_COMPILER=heroes exec \"$p\"", probe, here, elsewhere]
    )
    assert !ran.is_err()
    assert ran.must().out == "checked ./heroes\nstarted the working directory's\n"
    assert !remove_tree(scratch).is_err()

# DEFECT 281, held as a test (2026-10-04): an argument of the compiler's own
# that is not UTF-8 is named by its bytes and told by what it is to the
# command, where every one drew a program author's advice; only an argument
# after `run`'s `--` is the program's and draws it. Only a shell puts such
# bytes in a command line here, so this asks for POSIX as the script cases do.
test "fixedbugs: an argument of the compiler's own that is not UTF-8 is named by its bytes (defect 281)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    compiler = some_compiler().must()
    file = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "exec \"$0\" check \"$(printf 'caf\\351.hero')\"", compiler]
    )
    assert !file.is_err()
    assert file.must().code == 2
    assert file.must().err == "error: the name of `caf<0xE9>.hero` is not UTF-8, and this compiler opens a file by a name it can hold: rename it\n"
    out = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "exec \"$0\" build x.hero -o \"$(printf 'caf\\351')\"", compiler]
    )
    assert !out.is_err()
    assert out.must().code == 2
    assert out.must().err == "error: the value of `-o`, `caf<0xE9>`, is not UTF-8, and this compiler holds each word it is given as a Heroes `str`, which is UTF-8 (spec § 3 Types): give it in UTF-8\n"
    program = run(
        scratch: scratch,
        program: "/bin/sh",
        words: ["/bin/sh", "-c", "exec \"$0\" run x.hero -- \"$(printf '\\351')\"", compiler]
    )
    assert !program.is_err()
    assert program.must().code == 2
    assert program.must().err == "error: argument 4, `<0xE9>`, is for the program and is not UTF-8, and `heroes run` passes a program's arguments as Heroes `str`s, which are UTF-8 (spec § 3 Types)\nnote: build the program with `heroes build`, run it with this argument, and read it with `args_checked()`\n"
    assert !remove_tree(scratch).is_err()

# DEFECT 349, held as a test (2026-10-05): `-o ""` is refused by the argument
# parser, naming the flag, at exit 2, and no empty path reaches the writer,
# which told it as *the link cannot be followed: the operating system's own
# reason is 0*. An empty word passes as an argument on every platform.
test "fixedbugs: an empty `-o` is refused naming the flag, never told as a link (defect 349)"
    scratch = own_scratch()
    compiler = some_compiler().must()
    program = scratch + "/real.hero"
    assert !write_file(path: program, text: "function main()\n    print(1)\n").is_err()
    built = run(scratch: scratch, program: compiler, words: [compiler, "build", program, "-o", ""]).must()
    assert built.code == 2
    assert built.err == "error: `-o` needs a path, and was given an empty one: `heroes build <file.hero> -o <path>`\n"
    assert !remove_tree(scratch).is_err()

# A script at `path` that writes `says` and exits 0, made executable.
function stub_named(path: str, says: str, scratch: str) -> ()?
    write_file(path: path, text: "#!/bin/sh\nprintf '%s' \"" + says + "\"\n")?
    made = run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])?

    if made.code != 0
        return fail(code: "cannot_run", msg: "cannot make " + path + " executable")
    return ok()

# The program the test above builds over the harness's own modules: what
# `some_compiler` answers, and what the program so named says when started.
constant START_PROBE: str
    "use shell\n\nfunction main()\n    match shell.some_compiler()\n        .ok path =>\n            print(\"checked \" + path)\n\n            match shell.run(scratch: \"build/start-probe\", program: path, words: [path])\n                .ok r  => print(\"started \" + r.out)\n                .err e => print(\"not started: \" + e.msg)\n        .err e => print(\"refused \" + e.code + \": \" + e.msg)\n"

# `ENV_PROBE` built over the harness's own modules, byte for byte, under
# `scratch`, so the readers of `HEROES_COMPILER` and `HEROES_RUNTIME` are
# asked from a child's environment as the net reads them.
function env_probe(scratch: str) -> str?
    return harness_probe(scratch: scratch, name: "env-values", main: ENV_PROBE)

# `main` built over the harness's own modules under `scratch/name`.
function harness_probe(scratch: str, name: str, main: str) -> str?
    dir = scratch + "/" + name
    remove_tree(dir)?
    mkdir_all(dir)?

    for module in ["absence", "mark_readers", "shell", "strings"]
        text = read_file("tests/harness/" + module + ".hero")?
        write_file(path: dir + "/" + module + ".hero", text: text)?

    write_file(path: dir + "/main.hero", text: main)?
    compiler = some_compiler()?
    probe = dir + "/probe" + exe_suffix()
    built = run(scratch: scratch, program: compiler, words: [compiler, "build", dir + "/main.hero", "-o", probe])?

    if built.code != 0
        return fail(code: "unbuilt", msg: "the probe did not build: " + built.err)
    return ok(probe)

# The program the two tests above build over the harness's own modules.
constant ENV_PROBE: str
    "use absence\nuse shell\n\nfunction main()\n    match shell.some_compiler()\n        .ok path => print(\"compiler ok \" + path)\n        .err e   => print(\"compiler \" + e.code + \": \" + e.msg)\n\n    match absence.runtime_hint()\n        .ok value => print(\"runtime ok \" + value)\n        .err e    => print(\"runtime \" + e.code + \": \" + e.msg)\n\n    match shell.env(name: \"HEROES_RUNTIME\")\n        .ok value => print(\"env ok \" + value)\n        .err e    => print(\"env \" + e.code + \": \" + e.msg)\n"

# DEFECT 317, held as a test (2026-10-04). A child that writes bytes that are
# not UTF-8 RAN: the refusal says so, names how it ended, and quotes the text
# around the first such byte, each written by its value, on stdout and on
# stderr, one byte and several, a line among others and a name among NULs, a
# long line cut at its edges and between characters. A U+FFFD the bytes hold is
# text. And the captures go as any other's do, where until that day both stayed
# on disk. Only a program can write such bytes, and `printf` in `/bin/sh` is
# the one at hand (POSIX, as the script cases here).
test "fixedbugs: a child that writes bytes that are not UTF-8 ran, and its refusal says so (defect 317)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    told = "/bin/sh ran and exited "
    because = ", and what it wrote is not UTF-8, which every stream this harness reads must be: "
    assert said_by(scratch: scratch, script: "printf 'caf\\351'") == told + "0" + because + "on stdout 1 byte is not, in `caf<0xE9>`"
    assert said_by(scratch: scratch, script: "printf 'x.hero:1:1: error[boom]: caf\\351\\n' 1>&2; exit 1") == told + "1" + because + "on stderr 1 byte is not, in `x.hero:1:1: error[boom]: caf<0xE9>`"
    assert said_by(scratch: scratch, script: "printf 'a\\351'; printf 'b\\377' 1>&2; exit 3") == told + "3" + because + "on stdout 1 byte is not, in `a<0xE9>`; on stderr 1 byte is not, in `b<0xFF>`"

    # A character cut short is two bytes, quoted on the line that holds them.
    assert said_by(scratch: scratch, script: "printf 'ok\\nbad \\342\\202 end\\nmore'") == told + "0" + because + "on stdout 2 bytes are not, the first in `bad <0xE2><0x82> end`"

    # A name among NULs, as `git ls-files -z` lists them, is quoted alone.
    assert said_by(scratch: scratch, script: "printf 'a.hero\\000caf\\351.hero\\000b.hero'") == told + "0" + because + "on stdout 1 byte is not, in `caf<0xE9>.hero`"

    # A long line is cut `AROUND` bytes either side of the byte, and a cut
    # that would land inside a character moves to its first byte.
    sixty = zeros(60)
    assert said_by(scratch: scratch, script: "printf '%0100d\\351%0100d' 0 0") == told + "0" + because + "on stdout 1 byte is not, in `…" + sixty + "<0xE9>" + sixty + "…`"
    assert said_by(scratch: scratch, script: "printf 'xé%059d\\351' 0") == told + "0" + because + "on stdout 1 byte is not, in `…é" + zeros(59) + "<0xE9>`"

    # A U+FFFD the bytes hold is text, and comes back as it is.
    held = run(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", "printf 'a\\357\\277\\275b'"])
    assert !held.is_err()
    assert held.must().out == "a�b"

    # The machine-asking run says the same, since a stream is read one way.
    asked = attempted(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", "printf 'caf\\351'"])
    assert refusal(asked) == told + "0" + because + "on stdout 1 byte is not, in `caf<0xE9>`"

    # Every capture of the eleven runs above is gone, the refused ones included.
    assert captures_left(scratch) == 0
    assert !remove_tree(scratch).is_err()

# What `/bin/sh -c <script>` is refused with, "" where it is not.
function said_by(scratch: str, script: str) -> str
    return refusal(run(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", script]))

function zeros(count: i64) -> str
    pieces: [str] @ []

    for _ in range(from: 0, to: count)
        pieces @ pieces.push("0")

    return pieces.join("")

# How many capture files stand directly in `dir`, by their names' own start.
function captures_left(dir: str) -> i64
    left: i64 @ 0

    for path in list_entries(scratch: dir, dir: dir).must()
        name = strings.base_name(path: path)

        if strings.starts_with(text: name, prefix: "stdout-") || strings.starts_with(text: name, prefix: "stderr-")
            left @ left + 1

    return left

# DEFECT 320, held as a test (2026-10-04). Two runs of the net's own tests in
# one tree run the same test at the same moment, each test a process of its
# own, so a run's captures and a test's files are named by the process that
# makes them: a capture holds this process's id before its serial, as a child
# listing the directory while it runs shows, and a test's own directory holds
# the id and starts empty, whatever an earlier process of that id left there.
test "fixedbugs: a capture and a test's files are named by the process that makes them (defect 320)"
    if !can_run_scripts()
        return
    scratch = own_scratch()
    assert scratch == SELFTEST + "/" + pid().to_str()
    assert !write_file(path: scratch + "/left-over", text: "").is_err()
    assert own_scratch() == scratch
    assert list_entries(scratch: scratch, dir: scratch).must().len() == 0
    listed = run(scratch: scratch, program: "/bin/sh", words: ["/bin/sh", "-c", "ls \"$0\"", scratch])
    assert !listed.is_err()
    assert strings.contains(text: listed.must().out, needle: "stdout-" + pid().to_str() + "-")
    assert strings.contains(text: listed.must().out, needle: "stderr-" + pid().to_str() + "-")

    # A program that never starts leaves no capture either.
    absent = attempted(scratch: scratch, program: "heroes-no-such-program", words: ["heroes-no-such-program"])
    assert !absent.must().started
    assert captures_left(scratch) == 0
    assert !remove_tree(scratch).is_err()

# THE WIDE WORLD, for defect 238's cases (panel 191's R3, 2026-10-04). On
# Windows a name reaches a program through a code page, and a case is red at
# the narrow runtime only where its names are made, its program launched or its
# answer read through the wide API: a name a Heroes program makes and a Heroes
# program launches read right at that runtime, `CreateProcessA` turning UTF-8
# into the code page's text and the child's C runtime turning it back (both
# seats, measured on the box), so such a case is refused as a witness. This
# helper is the wide world, built by each case that asks: every name, value
# and command line it is given is ASCII with `\uXXXX` units, so no launcher's
# code page touches one, and it answers in ASCII the same way.
#
# **The cases live in the net's own tests, and that is where a compiler is
# named**: each launches the compiler under test, or a program it built, and
# only the net holds that compiler (`some_compiler`); the compiler's own tests
# run no compiler. The two that need none are defect 239's, in both trees.
# Windows alone: elsewhere a name is its bytes, and none of these is a question.
constant WIDE_TOOL: str
    "/* The wide world, for defect 238's cases (panel 191's R3). Every name, value\n * and command line is made, passed and read through the wide API, so no code\n * page of a launcher touches it. Every argument is ASCII: `\\uXXXX` is a UTF-16\n * unit, `\\n` a line end, `\\\\` a backslash; every answer is ASCII the same way,\n * a byte of a file's contents above ASCII as `\\xHH`.\n *   mk <path> <text>          a file by a wide name, holding <text> as UTF-8\n *   mkdir <path>\n *   cp <from> <to>\n *   ls <dir>                  its names by FindFirstFileW, one a line\n *   cat <path>                its bytes, or `absent`\n *   abs <path>                its absolute path\n *   symlink <name> <target>   a symbolic link to a file\n *   attrs <path>              `a link`, `a directory`, `a plain file`, `absent`\n *   run <cwd|-> <NAME=VALUE|NAME=|-> <out> <err> <program> <args...>\n *                             started by CreateProcessW, the program and the\n *                             folder made absolute first, `NAME=` removing the\n *                             variable; answers `exit N`\n *   runraw <out> <err> <program> <line>   the command line handed over as is\n * Exit 0, or 1 with the reason on stdout. */\n#include <fcntl.h>\n#include <io.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <wchar.h>\n#include <windows.h>\n\nstatic wchar_t *wide(const char *s) {\n    size_t n = strlen(s);\n    wchar_t *w = calloc(n + 1, sizeof *w);\n    size_t at = 0;\n    for (size_t i = 0; i < n;) {\n        if (s[i] == '\\\\' && i + 6 <= n && s[i + 1] == 'u') {\n            char hex[5] = {s[i + 2], s[i + 3], s[i + 4], s[i + 5], 0};\n            w[at++] = (wchar_t)strtoul(hex, NULL, 16);\n            i += 6;\n        } else if (s[i] == '\\\\' && s[i + 1] == 'n') {\n            w[at++] = L'\\n';\n            i += 2;\n        } else if (s[i] == '\\\\' && s[i + 1] == '\\\\') {\n            w[at++] = L'\\\\';\n            i += 2;\n        } else {\n            w[at++] = (wchar_t)(unsigned char)s[i];\n            i += 1;\n        }\n    }\n    w[at] = 0;\n    return w;\n}\n\nstatic void say_wide(const wchar_t *w) {\n    for (; *w != 0; w++) {\n        if (*w >= 0x20 && *w < 0x7F && *w != L'\\\\') putchar((int)*w);\n        else if (*w == L'\\\\') fputs(\"\\\\\\\\\", stdout);\n        else printf(\"\\\\u%04x\", (unsigned)*w);\n    }\n}\n\nstatic wchar_t *absolute(const wchar_t *path) {\n    DWORD room = GetFullPathNameW(path, 0, NULL, NULL);\n    if (room == 0) return NULL;\n    wchar_t *out = calloc(room, sizeof *out);\n    if (GetFullPathNameW(path, room, out, NULL) == 0) return NULL;\n    return out;\n}\n\n/* One word of a command line as the C runtime reads it back: quoted where it\n * holds a space, a tab or a quote or is empty, a quote inside escaped, and the\n * backslashes before a quote doubled. */\nstatic void quoted(wchar_t *line, size_t *at, const wchar_t *word) {\n    int needs = word[0] == 0 || wcspbrk(word, L\" \\t\\\"\") != NULL;\n    if (!needs) {\n        for (const wchar_t *p = word; *p != 0; p++) line[(*at)++] = *p;\n        return;\n    }\n    line[(*at)++] = L'\"';\n    for (const wchar_t *p = word;;) {\n        size_t slashes = 0;\n        while (*p == L'\\\\') { slashes += 1; p++; }\n        if (*p == 0) {\n            for (size_t k = 0; k < slashes * 2; k++) line[(*at)++] = L'\\\\';\n            break;\n        }\n        if (*p == L'\"') {\n            for (size_t k = 0; k < slashes * 2 + 1; k++) line[(*at)++] = L'\\\\';\n        } else {\n            for (size_t k = 0; k < slashes; k++) line[(*at)++] = L'\\\\';\n        }\n        line[(*at)++] = *p;\n        p++;\n    }\n    line[(*at)++] = L'\"';\n}\n\nstatic int started(wchar_t *program, wchar_t *line, wchar_t *cwd, const char *out_path, const char *err_path) {\n    SECURITY_ATTRIBUTES sa = {sizeof sa, NULL, TRUE};\n    HANDLE out = CreateFileW(wide(out_path), GENERIC_WRITE, FILE_SHARE_READ, &sa, CREATE_ALWAYS, 0, NULL);\n    HANDLE err = CreateFileW(wide(err_path), GENERIC_WRITE, FILE_SHARE_READ, &sa, CREATE_ALWAYS, 0, NULL);\n    HANDLE nul = CreateFileW(L\"NUL\", GENERIC_READ, FILE_SHARE_READ, &sa, OPEN_EXISTING, 0, NULL);\n    if (out == INVALID_HANDLE_VALUE || err == INVALID_HANDLE_VALUE || nul == INVALID_HANDLE_VALUE) {\n        printf(\"streams failed %lu\\n\", GetLastError());\n        return 1;\n    }\n    STARTUPINFOW si;\n    memset(&si, 0, sizeof si);\n    si.cb = sizeof si;\n    si.dwFlags = STARTF_USESTDHANDLES;\n    si.hStdInput = nul;\n    si.hStdOutput = out;\n    si.hStdError = err;\n    PROCESS_INFORMATION pi;\n    if (!CreateProcessW(program, line, NULL, NULL, TRUE, 0, NULL, cwd, &si, &pi)) {\n        printf(\"run failed %lu\\n\", GetLastError());\n        return 1;\n    }\n    WaitForSingleObject(pi.hProcess, INFINITE);\n    DWORD code = 0;\n    GetExitCodeProcess(pi.hProcess, &code);\n    CloseHandle(pi.hThread);\n    CloseHandle(pi.hProcess);\n    CloseHandle(out);\n    CloseHandle(err);\n    CloseHandle(nul);\n    printf(\"exit %lu\\n\", code);\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    _setmode(_fileno(stdout), _O_BINARY);\n    if (argc < 2) return 64;\n    const char *verb = argv[1];\n    if (!strcmp(verb, \"mk\") && argc == 4) {\n        wchar_t *text = wide(argv[3]);\n        int bytes = WideCharToMultiByte(CP_UTF8, 0, text, -1, NULL, 0, NULL, NULL);\n        char *utf8 = calloc((size_t)bytes + 1, 1);\n        WideCharToMultiByte(CP_UTF8, 0, text, -1, utf8, bytes, NULL, NULL);\n        HANDLE h = CreateFileW(wide(argv[2]), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);\n        if (h == INVALID_HANDLE_VALUE) { printf(\"mk failed %lu\\n\", GetLastError()); return 1; }\n        DWORD put = 0;\n        DWORD want = (DWORD)strlen(utf8);\n        BOOL wrote = WriteFile(h, utf8, want, &put, NULL);\n        CloseHandle(h);\n        if (!wrote || put != want) { printf(\"mk failed to write\\n\"); return 1; }\n        return 0;\n    }\n    if (!strcmp(verb, \"mkdir\") && argc == 3) {\n        if (!CreateDirectoryW(wide(argv[2]), NULL) && GetLastError() != ERROR_ALREADY_EXISTS) {\n            printf(\"mkdir failed %lu\\n\", GetLastError());\n            return 1;\n        }\n        return 0;\n    }\n    if (!strcmp(verb, \"cp\") && argc == 4) {\n        if (!CopyFileW(wide(argv[2]), wide(argv[3]), FALSE)) { printf(\"cp failed %lu\\n\", GetLastError()); return 1; }\n        return 0;\n    }\n    if (!strcmp(verb, \"ls\") && argc == 3) {\n        wchar_t *dir = wide(argv[2]);\n        size_t n = wcslen(dir);\n        wchar_t *pattern = calloc(n + 3, sizeof *pattern);\n        wcscpy(pattern, dir);\n        wcscat(pattern, L\"\\\\*\");\n        WIN32_FIND_DATAW d;\n        HANDLE h = FindFirstFileW(pattern, &d);\n        if (h == INVALID_HANDLE_VALUE) { printf(\"ls failed %lu\\n\", GetLastError()); return 1; }\n        do {\n            if (!wcscmp(d.cFileName, L\".\") || !wcscmp(d.cFileName, L\"..\")) continue;\n            say_wide(d.cFileName);\n            putchar('\\n');\n        } while (FindNextFileW(h, &d));\n        FindClose(h);\n        return 0;\n    }\n    if (!strcmp(verb, \"cat\") && argc == 3) {\n        HANDLE h = CreateFileW(wide(argv[2]), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);\n        if (h == INVALID_HANDLE_VALUE) { printf(\"absent\"); return 0; }\n        unsigned char buf[4096];\n        DWORD got = 0;\n        while (ReadFile(h, buf, sizeof buf, &got, NULL) && got > 0) {\n            for (DWORD i = 0; i < got; i++) {\n                unsigned char b = buf[i];\n                if (b == '\\n') fputs(\"\\\\n\", stdout);\n                else if (b == '\\\\') fputs(\"\\\\\\\\\", stdout);\n                else if (b >= 0x20 && b < 0x7F) putchar(b);\n                else printf(\"\\\\x%02x\", b);\n            }\n        }\n        CloseHandle(h);\n        return 0;\n    }\n    if (!strcmp(verb, \"abs\") && argc == 3) {\n        wchar_t *full = absolute(wide(argv[2]));\n        if (full == NULL) { printf(\"abs failed %lu\\n\", GetLastError()); return 1; }\n        say_wide(full);\n        return 0;\n    }\n    if (!strcmp(verb, \"symlink\") && argc == 4) {\n        if (!CreateSymbolicLinkW(wide(argv[2]), wide(argv[3]), SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE)) {\n            printf(\"symlink failed %lu\\n\", GetLastError());\n            return 1;\n        }\n        return 0;\n    }\n    if (!strcmp(verb, \"attrs\") && argc == 3) {\n        DWORD a = GetFileAttributesW(wide(argv[2]));\n        if (a == INVALID_FILE_ATTRIBUTES) printf(\"absent\");\n        else if (a & FILE_ATTRIBUTE_REPARSE_POINT) printf(\"a link\");\n        else if (a & FILE_ATTRIBUTE_DIRECTORY) printf(\"a directory\");\n        else printf(\"a plain file\");\n        return 0;\n    }\n    if (!strcmp(verb, \"run\") && argc >= 7) {\n        wchar_t *cwd = strcmp(argv[2], \"-\") ? absolute(wide(argv[2])) : NULL;\n        if (strcmp(argv[3], \"-\")) {\n            wchar_t *pair = wide(argv[3]);\n            wchar_t *eq = wcschr(pair, L'=');\n            if (eq == NULL) return 66;\n            *eq = 0;\n            SetEnvironmentVariableW(pair, eq[1] != 0 ? eq + 1 : NULL);\n        }\n        wchar_t *program = absolute(wide(argv[6]));\n        if (program == NULL) { printf(\"abs failed %lu\\n\", GetLastError()); return 1; }\n        size_t room = 16 + 2 * wcslen(program) + 3;\n        for (int i = 7; i < argc; i++) room += 2 * strlen(argv[i]) + 3;\n        wchar_t *line = calloc(room, sizeof *line);\n        size_t at = 0;\n        quoted(line, &at, program);\n        for (int i = 7; i < argc; i++) {\n            line[at++] = L' ';\n            quoted(line, &at, wide(argv[i]));\n        }\n        line[at] = 0;\n        return started(program, line, cwd, argv[4], argv[5]);\n    }\n    if (!strcmp(verb, \"runraw\") && argc == 6) {\n        wchar_t *program = absolute(wide(argv[4]));\n        if (program == NULL) { printf(\"abs failed %lu\\n\", GetLastError()); return 1; }\n        return started(program, wide(argv[5]), NULL, argv[2], argv[3]);\n    }\n    return 64;\n}\n"

# The helper built under a test's own scratch, and the folder its names go in.
record Wide
    tool: str
    root: str
    scratch: str

function wide_world(scratch: str) -> Wide?
    root = scratch + "/wide"
    mkdir_all(root)?
    write_file(path: scratch + "/wide-tool.c", text: WIDE_TOOL)?
    tool = scratch + "/wide-tool" + exe_suffix()
    built = run(scratch: scratch, program: "clang", words: ["clang", scratch + "/wide-tool.c", "-o", tool])?

    if built.code != 0
        return fail(code: "unbuilt", msg: "the wide-world helper did not build: " + ending(ok(built)))
    return ok(Wide(tool: tool, root: root, scratch: scratch))

# What the helper answers to `words`, or why it refused.
function wide(w: Wide, words: [str]) -> str?
    ran = run(scratch: w.scratch, program: w.tool, words: both(first: [w.tool], second: words))?

    if ran.code != 0
        return fail(
            code: "wide",
            msg: "the wide-world helper refused `" + words.join(" ") + "`: " + strings.trimmed(ran.out)
        )
    return ok(ran.out)

# A program the helper started from the wide world, its exit code and its two
# streams as text.
record Launched
    code: i64
    out: str
    err: str

# `words` started by the helper in `cwd` with `setting` set (`NAME=VALUE`, or
# `NAME=` to take it away), `-` for either left as it is.
function launched(w: Wide, cwd: str, setting: str, words: [str]) -> Launched?
    serial = pid().to_str() + "-" + hero_run_serial().to_str()
    out = w.scratch + "/launched-out-" + serial
    err = w.scratch + "/launched-err-" + serial
    return said_launched(
        w: w,
        said: wide(w, words: both(first: ["run", cwd, setting, out, err], second: words))?,
        out: out,
        err: err
    )

# `line` handed to the program whole, as a command line the program's C
# runtime splits itself.
function launched_raw(w: Wide, program: str, line: str) -> Launched?
    serial = pid().to_str() + "-" + hero_run_serial().to_str()
    out = w.scratch + "/launched-out-" + serial
    err = w.scratch + "/launched-err-" + serial
    return said_launched(w: w, said: wide(w, words: ["runraw", out, err, program, line])?, out: out, err: err)

function said_launched(w: Wide, said: str, out: str, err: str) -> Launched?
    _ = w

    if !strings.starts_with(text: said, prefix: "exit ")
        return fail(code: "wide", msg: "the wide-world helper said `" + said + "`")
    code = strings.to_number(strings.trimmed(strings.without_prefix(text: said, prefix: "exit ")))?
    return ok(Launched(code: code, out: read_file(out)?, err: read_file(err)?))

# A program built from `source` by the compiler under test, its source and its
# binary named in ASCII in the case's folder.
function built_program(w: Wide, compiler: str, name: str, source: str) -> str?
    path = w.root + "/" + name + ".hero"
    write_file(path: path, text: source)?
    binary = w.root + "/" + name + exe_suffix()
    made = run(scratch: w.scratch, program: compiler, words: [compiler, "build", path, "-o", binary])?

    if made.code != 0
        return fail(code: "unbuilt", msg: name + " did not build: " + ending(ok(made)))
    return ok(binary)

# The runtime's files copied under `to`, a folder the helper names wide.
function copied_runtime(w: Wide, to: str) -> ()?
    _ = wide(w, words: ["mkdir", to])?

    for sub in list_directories(scratch: w.scratch, dir: "runtime")?
        _ = wide(w, words: ["mkdir", to + strings.without_prefix(text: sub, prefix: "runtime")])?

    nothing: [str] = []

    for file in list_tree(scratch: w.scratch, dir: "runtime", skip: nothing)?
        _ = wide(w, words: ["cp", file, to + strings.without_prefix(text: file, prefix: "runtime")])?

    return ok()

# A correct program, and one whose second line names nothing, as the helper
# takes a text.
constant WIDE_CLEAN: str
    "function main()\\n    print(1)\\n"

constant WIDE_WRONG: str
    "function main()\\n    print(nowhere)\\n"

# A program printing each of its arguments, or `not text` for one that is not.
constant ARGS_PROBE: str
    "function main()\n    for a in args_checked()\n        match a\n            .ok s  => print(s)\n            .err _ => print(\"not text\")\n"

test "fixedbugs: on Windows a name above ASCII from the wide world is the file checked (defect 238, W1, W7)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    assert !wide(w, words: ["mk", w.root + "/caf\\u00e9.hero", WIDE_CLEAN]).is_err()
    one = launched(w, cwd: w.root, setting: "-", words: [compiler, "check", "caf\\u00e9.hero"]).must()
    assert one.code == 0
    assert one.err == ""
    assert !wide(w, words: ["mkdir", w.root + "/d\\u00e9"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/d\\u00e9/p.hero", WIDE_CLEAN]).is_err()
    seven = launched(w, cwd: w.root, setting: "-", words: [compiler, "check", "d\\u00e9/p.hero"]).must()
    assert seven.code == 0
    assert seven.err == ""
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows `check` and `fmt --in-place` of a name above ASCII reach that file and never its best fit (defect 238, W2, W3)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    assert !wide(w, words: ["mkdir", w.root + "/judged"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/judged/\\u015d.hero", WIDE_WRONG]).is_err()
    assert !wide(w, words: ["mk", w.root + "/judged/s.hero", WIDE_CLEAN]).is_err()
    judged = launched(w, cwd: w.root + "/judged", setting: "-", words: [compiler, "check", "\\u015d.hero"]).must()
    assert judged.code == 1
    assert strings.contains(
        text: judged.err,
        needle: "error[unknown_name]: nothing named `nowhere` is in scope\n  at ŝ.hero:2:11"
    )
    unformatted = "function main()\\n    print( 1 )\\n"
    assert !wide(w, words: ["mkdir", w.root + "/placed"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/placed/\\u015d.hero", unformatted]).is_err()
    assert !wide(w, words: ["mk", w.root + "/placed/s.hero", unformatted]).is_err()
    placed = launched(w, cwd: w.root + "/placed", setting: "-", words: [compiler, "fmt", "\\u015d.hero", "--in-place"]).must(
    )
    assert placed.code == 0
    assert wide(w, words: ["cat", w.root + "/placed/\\u015d.hero"]).must() == "function main()\\n    print(1)\\n"
    assert wide(w, words: ["cat", w.root + "/placed/s.hero"]).must() == unformatted
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows a built program's arguments, reads and writes keep a name above ASCII (defect 238, W4, W5, W6, W20)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    program = built_program(w, compiler: compiler, name: "args", source: ARGS_PROBE).must()
    argued = launched(w, cwd: "-", setting: "-", words: [program, "a", "\\u015d", "caf\\u00e9"]).must()
    assert argued.code == 0
    assert argued.out == "a\nŝ\ncafé\n"

    # This process reads and writes by the runtime under test, the names
    # made and listed wide.
    assert !wide(w, words: ["mk", w.root + "/caf\\u00e9.txt", "hello"]).is_err()
    assert read_file(w.root + "/café.txt").must() == "hello"
    assert !wide(w, words: ["mkdir", w.root + "/out"]).is_err()
    assert !write_file(path: w.root + "/out/café-out.txt", text: "written").is_err()
    assert wide(w, words: ["ls", w.root + "/out"]).must() == "caf\\u00e9-out.txt\n"
    assert wide(w, words: ["cat", w.root + "/out/caf\\u00e9-out.txt"]).must() == "written"

    # A program reading the file its argument names, a decoy at the best fit.
    reader = built_program(w, compiler: compiler, name: "reader", source: "function main()\n    for a in args()\n        match read_file(a)\n            .ok text => print(text)\n            .err e   => print(\"cannot read: \" + e.msg)\n").must(
    )
    assert !wide(w, words: ["mk", w.root + "/\\u015d.txt", "the real one"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/s.txt", "decoy"]).is_err()
    read = launched(w, cwd: w.root, setting: "-", words: [reader, "\\u015d.txt"]).must()
    assert read.code == 0
    assert read.out == "the real one\n"
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows `probe` and `mutate` walk folders holding names above ASCII, and a name of 300 bytes (defect 238, W8, W13)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    assert !wide(w, words: ["mkdir", w.root + "/walk1"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/walk1/caf\\u00e9.hero", WIDE_CLEAN]).is_err()
    probed = launched(w, cwd: w.root, setting: "-", words: [compiler, "probe", "walk1"]).must()
    assert probed.code == 0
    assert strings.starts_with(text: probed.out, prefix: "probe: 1 seeds, and 0 files the parser refuses\n")
    mutated = launched(w, cwd: w.root, setting: "-", words: [compiler, "mutate", "walk1"]).must()
    assert mutated.code == 0
    assert strings.starts_with(text: mutated.out, prefix: "corpus: 1 programs under walk1\n")
    assert !wide(w, words: ["mkdir", w.root + "/walk2"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/walk2/\\u015d.hero", WIDE_CLEAN]).is_err()
    hatted = launched(w, cwd: w.root, setting: "-", words: [compiler, "probe", "walk2"]).must()
    assert hatted.code == 0
    assert strings.starts_with(text: hatted.out, prefix: "probe: 1 seeds, and 0 files the parser refuses\n")

    # A hundred CJK characters are 100 units on disk and 300 bytes of UTF-8,
    # past the 260 a narrow listing holds: it ended the listing there under
    # the UTF-8 code page, error 234, and the walk said 3 of 6 (panel 191).
    long = "m" + "\\u6f22".repeat(100)

    assert !wide(w, words: ["mkdir", w.root + "/six"]).is_err()

    for name in ["a", "b", "c", long, "y", "z"]
        assert !wide(w, words: ["mk", w.root + "/six/" + name + ".hero", WIDE_CLEAN]).is_err()

    six = launched(w, cwd: w.root, setting: "-", words: [compiler, "probe", "six"]).must()
    assert six.code == 0
    assert strings.starts_with(text: six.out, prefix: "probe: 6 seeds, and 0 files the parser refuses\n")
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows a name holding a surrogate standing alone is named by its bytes, in a file and through a directory, and an empty such directory is walked (defect 238, W14, panel 191's R2)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    surrogate = "<0xED><0xA0><0x80>"
    assert !wide(w, words: ["mkdir", w.root + "/file"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/file/ok.hero", WIDE_CLEAN]).is_err()
    assert !wide(w, words: ["mk", w.root + "/file/caf\\ud800.hero", WIDE_CLEAN]).is_err()
    file = launched(w, cwd: w.root, setting: "-", words: [compiler, "probe", "file"]).must()
    assert file.code == 2
    assert file.err == "error: the name of `file/caf" + surrogate + ".hero` is not UTF-8, and this compiler opens a file by a name it can hold: rename it\n"

    # A directory so named holding a program is entered, and the program
    # named by its path's bytes, where the walk said *cannot read the
    # directory* of a readable folder, at the base and under the route.
    assert !wide(w, words: ["mkdir", w.root + "/filled"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/filled/ok.hero", WIDE_CLEAN]).is_err()
    assert !wide(w, words: ["mkdir", w.root + "/filled/x\\ud800"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/filled/x\\ud800/a.hero", WIDE_CLEAN]).is_err()
    filled = launched(w, cwd: w.root, setting: "-", words: [compiler, "mutate", "filled"]).must()
    assert filled.code == 2
    assert filled.err == "error: the name of `filled/x" + surrogate + "/a.hero` is not UTF-8, and this compiler opens a file by a name it can hold: rename it\n"

    # An empty one holds no file a walk could name.
    assert !wide(w, words: ["mkdir", w.root + "/empty"]).is_err()
    assert !wide(w, words: ["mk", w.root + "/empty/ok.hero", WIDE_CLEAN]).is_err()
    assert !wide(w, words: ["mkdir", w.root + "/empty/x\\ud800"]).is_err()
    empty = launched(w, cwd: w.root, setting: "-", words: [compiler, "probe", "empty"]).must()
    assert empty.code == 0
    assert strings.starts_with(text: empty.out, prefix: "probe: 1 seeds, and 0 files the parser refuses\n")

    # And this process's own walk removes every one of them by its name.
    assert !remove_tree(scratch).is_err()
    assert !exists(scratch)

test "fixedbugs: on Windows HEROES_RUNTIME above ASCII, and a compiler installed under such a folder, find their runtime (defect 238, W9, W12)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    copied_runtime(w, to: w.root + "/rt\\u00e9").must()
    named = launched(w, cwd: "-", setting: "HEROES_RUNTIME=" + w.root + "/rt\\u00e9", words: [compiler, "doctor"]).must(
    )
    assert strings.contains(text: named.out, needle: "\nok   runtime      " + w.root + "/rté\n")
    inst = w.root + "/inst-\\u00e9"
    assert !wide(w, words: ["mkdir", inst]).is_err()
    assert !wide(w, words: ["cp", compiler, inst + "/heroes.exe"]).is_err()
    copied_runtime(w, to: inst + "/runtime").must()
    beside = launched(w, cwd: w.root, setting: "HEROES_RUNTIME=", words: [inst + "/heroes.exe", "doctor"]).must()
    assert strings.contains(text: beside.out, needle: "\nok   runtime      ")
    assert !wide(w, words: ["mk", w.root + "/hello.hero", "function main()\\n    print(\"hello\")\\n"]).is_err()
    built = launched(w, cwd: w.root, setting: "HEROES_RUNTIME=", words: [inst + "/heroes.exe", "build", "hello.hero", "-o", "hello.exe"]).must(
    )
    assert built.code == 0
    hello = launched(w, cwd: w.root, setting: "-", words: [w.root + "/hello.exe"]).must()
    assert hello.out == "hello\n"
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows a program named above ASCII builds and runs, by relative names and by absolute ones (defect 238, W10, W11)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    assert !wide(w, words: ["mk", w.root + "/caf\\u00e9.hero", WIDE_CLEAN]).is_err()
    built = launched(w, cwd: w.root, setting: "-", words: [compiler, "build", "caf\\u00e9.hero", "-o", "caf\\u00e9.exe"]).must(
    )
    assert built.code == 0
    ran = launched(w, cwd: w.root, setting: "-", words: [w.root + "/caf\\u00e9.exe"]).must()
    assert ran.out == "1\n"
    proj = w.root + "/proj-\\u00e9"
    assert !wide(w, words: ["mkdir", proj]).is_err()
    assert !wide(w, words: ["mk", proj + "/main.hero", "use helper\\n\\nfunction main()\\n    print(helper.answer())\\n"]).is_err()
    assert !wide(w, words: ["mk", proj + "/helper.hero", "function answer() -> i64\\n    return 42\\n"]).is_err()
    root = wide(w, words: ["abs", proj]).must()
    absolute = launched(w, cwd: proj, setting: "-", words: [compiler, "build", root + "/main.hero", "-o", root + "/abs.exe"]).must(
    )
    assert absolute.code == 0
    answered = launched(w, cwd: proj, setting: "-", words: [root + "/abs.exe"]).must()
    assert answered.out == "42\n"
    assert !remove_tree(scratch).is_err()

test "fixedbugs: on Windows a command line's fullwidth quotes stay characters, and a fullwidth solidus never reaches another folder (defect 238, W15, W19)"
    if exe_suffix() != ".exe"
        return
    scratch = own_scratch()
    w = wide_world(scratch).must()
    compiler = some_compiler().must()
    program = built_program(w, compiler: compiler, name: "args", source: ARGS_PROBE).must()
    split = launched_raw(w, program: program, line: "args.exe \\uff02a b\\uff02 c").must()
    assert split.code == 0
    assert split.out == "＂a\nb＂\nc\n"
