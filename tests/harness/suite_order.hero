# design.md §4.9's `ORDER:` mark, enforced instead of grepped.
#
# WHAT THE RULE IS. `keys(m)` gives the keys in NO ORDER — and measurably
# not in a stable one: `cap` derives from a literal's duplicate-inclusive
# pair count, so two `==`-equal maps written differently iterate
# differently. Any walk whose order somebody can SEE therefore owes an
# explicit `sort`, and the sort owes a `# ORDER:` mark naming the key and
# what observes it. The bootstrap got the order free from `BTreeMap` and
# left the marks as notes for the port; the port pays each one with a
# `sort`.
#
# WHY IT IS A CHECK AND NOT A CONVENTION. It has been a grep since panel
# 006, and a grep cannot tell a mark from a sentence quoting one. Measured
# 2026-08-25: `grep -rn "ORDER:" selfhost/` returned **10 hits in 8
# files**, of which four were prose — three quotations of a bootstrap mark
# and one mid-sentence mention — so the live inventory reported walks that
# were fine as marked and said nothing about the ones that were not.
# Panel 086 R4 recorded the gap against the bootstrap's 13 and asked for a
# count that reports itself. This is that count.
#
# WHAT AN UNPAID SORT COSTS, measured rather than feared: unsorted, the
# per-option walk in `emit_ctype.hero` put four generated functions per
# option in the runtime's bucket order and produced 20.8 MB of C whose
# LINES matched the bootstrap's exactly and whose SEQUENCE did not, on
# 3,330 of 724,197 lines (2026-08-17). It was the last thing standing
# between the port and the fixpoint. Under M-separate-compilation the same
# mistake is multiplied by one translation unit per module.
#
# WHAT IS CHECKED. Every line of `selfhost/**.hero` outside a `test` block
# that walks a map's keys carries a `# ORDER:` mark — above the walk, or
# in the doc comment of the function holding it. `tests/harness/` is
# excluded the way `suite_layout` excludes it: it is the net, not the
# compiler.

use report
use floors
use shell
use strings

constant COMPILER: str
    "selfhost"

# The mark, in the one shape a grep can read: a comment whose FIRST word
# is `ORDER:`. A line that quotes a mark inside a sentence is prose, and
# prose is what made the old inventory unreadable.
constant MARK: str
    "# ORDER:"

# What a walk over a map's keys looks like in this language. There is
# exactly one spelling — `keys(m)` composed with `for` and `sort` — which
# is why one needle finds them all (design.md §4.9: iteration is not a
# form of its own).
constant WALK: str
    "keys("

# Floors. They exist for the reason `suite_layout`'s does — a sweep that reaches
# nothing reports green — and they are floors rather than equalities, so deleting
# a map does not turn a refactor red.
#
# **Set 2026-08-25 at 14 and 10, against 16 marks in 12 files and 13 walks.
# Re-measured 2026-09-12: 23 and 22**, so the marks floor had 9 of slack and the
# walks floor had 12 — more than the floor itself, which is a net with a hole
# wider than the net. Re-based to today's counts by `floors.check`, and that
# check is now what will notice the next time.
constant LEAST_MARKS: i64
    23

constant LEAST_WALKS: i64
    22

function run_all(scratch: str) -> report.Report?
    r: report.Report @ report.empty()

    # **`list_tree`, not `list_entries`** — see `suite_layout`'s note at the
    # same call. `list_entries` is `recursive: 0`, and M-selfhost-nesting put
    # 133 of 170 modules a directory down. Measured before the change: of the
    # 23 `# ORDER:` marks in 15 files, only **5 in 2 files** are in files that
    # stayed flat, against a floor of 14 — so this suite would have gone red
    # rather than quiet. Recursing is still the repair, because a floor tells
    # you the sweep shrank and not which files it stopped reading.
    nothing: [str] = []
    files = shell.list_tree(scratch: scratch, dir: COMPILER, skip: nothing)?
    modules: [str] @ []

    for path in files
        if strings.ends_with(text: path, suffix: ".hero")
            modules @ modules.push(path)

    unmarked: [str] @ []
    marks: i64 @ 0
    walks: i64 @ 0

    for path in modules
        text = read_file(path)

        if text.is_err()
            report.keep_failure(@r, label: "order/" + strings.base_name(path: path), detail: "  cannot read " + path)
            continue
        rows = strings.lines(text.must())
        code = outside_tests(rows)
        at: i64 @ 0

        while at < rows.len()
            if is_mark(rows[at])
                marks @ marks + 1

            if code[at] && !is_comment(rows[at]) && strings.contains(text: rows[at], needle: WALK)
                walks @ walks + 1

                if !marked_above(rows, at: at)
                    unmarked @ unmarked.push("    " + path + ":" + (at + 1).to_str() + ": " + strings.trimmed(rows[at]))
            at @ at + 1

    if unmarked.len() > 0
        report.keep_failure(
            @r,
            label: "order",
            detail: "  design.md §4.9: `keys(m)` gives the keys in NO ORDER, so a walk over them owes an explicit `sort` and a `" + MARK + "` mark naming the sort key and what observes the order. These walks carry no mark:\n" + unmarked.join("\n") + "\n  Put the mark above the walk, or in the doc comment of the function that holds it. Where nothing can observe the order, the mark is `" + MARK + " none — <why>`: that is a judgement recorded, not a rule dodged, and it is the only thing that tells the next reader somebody looked."
        )
    else
        report.keep_pass(@r)

    floors.check(@r, label: "order", found: walks, floor: LEAST_WALKS, what: "map walks")
    floors.check(@r, label: "order", found: marks, floor: LEAST_MARKS, what: "`# ORDER:` marks")
    return ok(r)

# Which rows a reader must hold in their head: everything outside a `test`
# block. The boundary is `suite_layout`'s, and for its reason — a Heroes
# module carries its own cases at the bottom, so the exclusion is of
# SECTIONS rather than of files. A `test "..."` at column 0 opens one, and
# the next column-0 line that is not a comment closes it.
function outside_tests(rows: [str]) -> [bool]
    out: [bool] @ []
    inside: bool @ false

    for row in rows
        if strings.starts_with(text: row, prefix: "test \"")
            inside @ true
            out @ out.push(false)
            continue

        if inside && row.len() > 0 && !starts_indented(row) && !strings.starts_with(text: row, prefix: "#")
            inside @ false
        out @ out.push(!inside)

    return out

# Is the walk at `at` covered by a mark? The search is the mark's own
# scope, not a line window: from the walk, upward through its function's
# body, across that function's header ONCE, and on through the doc
# comment attached to it. Both shapes in the tree are inside that scope —
# a mark directly above the loop, and a mark in the doc block — and a mark
# belonging to the function above is not, which is the point.
function marked_above(rows: [str], at: i64) -> bool
    crossed: bool @ false
    j: i64 @ at - 1

    while j >= 0
        row = rows[j]

        if is_mark(row)
            return true

        if is_comment(row)
            j @ j - 1
            continue

        if strings.trimmed(row).len() == 0
            # A blank line above the header ends the doc comment: what is
            # further up belongs to the previous declaration.
            if crossed
                return false
            j @ j - 1
            continue

        if starts_indented(row)
            if crossed
                return false
            j @ j - 1
            continue

        # A column-0 line that is not a comment: this walk's own
        # declaration header. Crossing it reaches the doc block; a second
        # one means the declaration is behind us and carried no mark.
        if crossed
            return false
        crossed @ true
        j @ j - 1

    return false

function is_mark(row: str) -> bool
    return strings.starts_with(text: strings.trimmed(row), prefix: MARK)

function is_comment(row: str) -> bool
    return strings.starts_with(text: strings.trimmed(row), prefix: "#")

function starts_indented(row: str) -> bool
    return row[0] == 32 || row[0] == 9

test "a mark covers the loop under it, and the doc comment above the header"
    body: [str] = [
        "function f(m: {i64: bool}) -> i64"
        "    total: i64 @ 0"
        "    # ORDER: ascending id — the sum is printed"
        "    for k in sort(keys(m))"
        "        total @ total + k"
        "    return total"
    ]
    assert marked_above(body, at: 3)
    doc: [str] = [
        "# ORDER: ascending id — a diagnostic reads this"
        "function g(m: {i64: bool}) -> [i64]"
        "    return sort(keys(m))"
    ]
    assert marked_above(doc, at: 2)

test "a mark does not reach past its own declaration"
    two: [str] = [
        "# ORDER: ascending id — this one belongs to f"
        "function f(m: {i64: bool}) -> [i64]"
        "    return sort(keys(m))"
        ""
        "function g(m: {i64: bool}) -> [i64]"
        "    return keys(m)"
    ]
    assert marked_above(two, at: 2)
    assert !marked_above(two, at: 5)

test "prose that quotes a mark is not a mark"
    assert is_mark("    # ORDER: ascending TyId — the emitted C reads it")
    assert is_mark("# ORDER: none — nothing observes this")
    assert !is_mark("    # \"ORDER: ascending TyId\" (the bootstrap's own mark)")
    assert !is_mark("    # because those names are not in it. ORDER: ascending")
    assert !is_mark("    for k in sort(keys(m))")
    assert is_comment("   ## Tests")
    assert !is_comment("    for k in keys(m)")

test "the cases at the bottom of a module are outside the sweep"
    rows: [str] = [
        "function f(m: {i64: bool}) -> i64"
        "    return len(keys(m))"
        ""
        "test \"counting\""
        "    assert len(keys(one_map())) == 1"
    ]
    flags = outside_tests(rows)
    assert flags.len() == 5
    assert flags[1]
    assert !flags[4]
