# The build cache never serves an answer the world has moved past
# (M-separate-compilation acceptance row 2; panel 093 R4/R5).
#
# WHY IT IS A SUITE AND NOT A GOLDEN. Every question here is about a
# SECOND invocation: what the compiler does the time after this one,
# with a file on disk changed in between. A golden is one argv and one
# expected text, so none of this fits a row — the same reason
# `suite_special` exists, one department over.
#
# WHAT IT PINS, and each one is a direction the cache can be wrong in:
#
# 1. **A header edit is not invisible.** The measured defect, 2026-08-26:
#    `extern "conf.h"` with `constant CONF_LIMIT` emits `return
#    CONF_LIMIT;` whatever the header says, so the emitted C is
#    byte-identical across an edit and the key could not see it. The
#    program printed `1` at exit 0 with the header saying `2`. A build
#    system's worst outcome is a wrong answer that looks like a right
#    one, and CLAUDE.md §12 puts stopping that ahead of everything else
#    in this file.
# 2. **The cache still HITS.** The cheapest way to pass (1) is to
#    recompile every time, so (2) is what makes (1) worth anything: two
#    builds with nothing touched leave every object exactly where it
#    was, asked of the filesystem with `find -newer` rather than of a
#    number the compiler prints about itself.
# 3. **Only the module that READ the header is rebuilt.** This is
#    acceptance row 1 seen from the cache's side: the header travels
#    with the `extern` into exactly one translation unit, so an edit to
#    it must move exactly one object. If it moved all of them the
#    architecture would be sound and the cache pointless; if it moved
#    none, (1) would be back.
# 4. **A reordered variant is never served from a warm object** — panel
#    093's tag-reorder witness, and the engineer's own prediction to
#    score. A variant's cases are numbered by position, so moving them
#    renumbers every tag; the caller's `match` is a C `switch` over
#    those numbers, and it lives in a DIFFERENT translation unit. What
#    stops the caller being served a warm object full of the old numbers
#    is that a TU's text carries the tag enum of every type it reaches,
#    so the edit changes the caller's own text and therefore its key
#    (R4, with R6's content-derived names underneath). The failure this
#    catches has no diagnostic and no crash: the program prints the
#    wrong case at exit 0.
# 5. **A warm cache never turns a failure into a pass** — acceptance row
#    4's third claim (panel 093 R5), and the one half of that row no
#    golden can hold, because it is about the SECOND invocation. The
#    programs it refuses and then accepts are in
#    `tests/golden/surface-fixtures/externsignature/`, whose README
#    carries the row; what is here is that the refusal SURVIVES a build
#    where every healthy object is already warm. A build that goes green
#    on its second run is the worst outcome a build system has, because
#    nobody re-reads a green build.
#
# THE PROGRAM IS WRITTEN HERE rather than kept under
# `tests/golden/surface-fixtures/`, and the header is why: the case is
# about EDITING a C header, so the header is test data with three
# versions and no single resting state. Keeping one in the repository
# would also put a `.h` outside the three directories that own C, which
# `suite_records.c_files` refuses by design.

use report
use shell
use strings

# Where the two-module program and its header live for the duration.
# Under the scratch directory, so `heroes build`'s own `build/` (at the
# repository root, where the harness runs) stays the one it always is.
constant HOME: str
    "cache-program"

constant BIND: str
    "extern \"conf.h\"\n    constant CONF_LIMIT: i64\n\nfunction limit() -> i64\n    return CONF_LIMIT\n"

constant PROG: str
    "use bind\n\nfunction main()\n    print(bind.limit())\n"

# The tag-reorder witness's own program: a variant in one module, a
# `match` over it in another. `TAGS_HOME` is a second directory rather
# than a second state of the first, because the two cases edit different
# files and a shared tree would make each one's setup the other's
# leftovers.
constant TAGS_HOME: str
    "cache-tags"

constant TAGS_CALLER: str
    "use hue\n\nfunction main()\n    print(hue.name_of(c: .blue))\n"

# Acceptance row 4's own program: a declaring module whose `extern`
# signature the header refuses, and a caller that is correct.
constant FAIL_HOME: str
    "cache-failure"

constant FAIL_BIND: str
    "extern \"math.h\" link \"m\"\n    function sqrt(x: i64) -> i64\n\nfunction root(x: i64) -> i64\n    return sqrt(x: x)\n"

constant GOOD_BIND: str
    "extern \"math.h\" link \"m\"\n    function sqrt(x: f64) -> f64\n\nfunction root(x: f64) -> f64\n    return sqrt(x: x)\n"

constant FAIL_CALLER: str
    "use failbind\n\nfunction main()\n    print(failbind.root(x: 16))\n"

constant GOOD_CALLER: str
    "use failbind\n\nfunction main()\n    print(failbind.root(x: 16.0))\n"

function run_all(scratch: str, compiler: str) -> report.Report?
    r: report.Report @ report.empty()
    a_header_edit_is_not_invisible(@r, scratch: scratch, compiler: compiler)
    an_untouched_build_still_hits(@r, scratch: scratch, compiler: compiler)
    only_the_module_that_read_it_is_rebuilt(@r, scratch: scratch, compiler: compiler)
    a_reordered_variant_is_not_served_warm(@r, scratch: scratch, compiler: compiler)
    a_warm_cache_never_turns_a_failure_into_a_pass(@r, scratch: scratch, compiler: compiler)
    return ok(r)

# The program, freshly laid down with the header at `value`. Returns
# the directory it lives in.
function laid_out(scratch: str, value: str) -> str?
    dir = scratch + "/" + HOME
    shell.remove_tree(dir)?
    shell.mkdir_all(dir)?
    write_file(path: dir + "/bind.hero", text: BIND)?
    write_file(path: dir + "/prog.hero", text: PROG)?
    write_header(dir: dir, value: value)?
    return ok(dir)

function write_header(dir: str, value: str) -> ()?
    return write_file(path: dir + "/conf.h", text: "#define CONF_LIMIT " + value + "\n")

# **A header edit is not invisible.** Three values in a row, and the
# third is a repeat of nothing seen before so a two-entry cache cannot
# pass by luck.
function a_header_edit_is_not_invisible(@r: report.Report, scratch: str, compiler: str)
    label = "cache/a header edit is not invisible"
    dir = laid_out(scratch: scratch, value: "1")
    if dir.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the program out under " + scratch)
        return
    wrong: [str] @ []
    for value in ["1", "2", "7", "2"]
        if write_header(dir: dir.must(), value: value).is_err()
            report.keep_failure(@r, label: label, detail: "  cannot write the header")
            return
        said = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " run " + shell.sq(dir.must() + "/prog.hero"))
        if said.is_err() || said.must().code != 0
            wrong @ wrong.push("    the header said " + value + " and the build did not run: " + said.default(shell.Run(code: -1, out: "", err: "cannot run")).err)
            continue
        if said.must().out != value + "\n"
            wrong @ wrong.push("    the header said " + value + " and the program printed " + strings.trimmed(said.must().out) + " — a cached object built against an older header")
    if wrong.len() > 0
        report.keep_failure(@r, label: label, detail: wrong.join("\n") + "\n  the key cannot see a header edit by construction (the emitted C is identical), so what stands between this and a wrong answer at exit 0 is `cli_deps`: clang's own dependency listing, recorded per object and re-checked before a warm one is served.")
    else
        report.keep_pass(@r)

# **The cache still hits.** Recompiling everything would pass the case
# above and cost the whole architecture, so this is the other half of
# the same claim. Asked of the filesystem: after a build, a marker; then
# a second build that touches nothing; then no object may be newer than
# the marker.
function an_untouched_build_still_hits(@r: report.Report, scratch: str, compiler: str)
    label = "cache/an untouched build still hits"
    dir = laid_out(scratch: scratch, value: "3")
    if dir.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the program out under " + scratch)
        return
    first = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " build " + shell.sq(dir.must() + "/prog.hero"))
    if first.is_err() || first.must().code != 0
        report.keep_failure(@r, label: label, detail: "  the first build did not run")
        return
    moved = objects_newer_than(scratch: scratch, marker: dir.must() + "/marker", command: shell.patience() + shell.sq(compiler) + " build " + shell.sq(dir.must() + "/prog.hero"))
    if moved.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot ask the filesystem which objects moved")
        return
    if moved.must().len() > 0
        report.keep_failure(@r, label: label, detail: "  nothing was edited and these objects were rebuilt:\n    " + moved.must().join("\n    ") + "\n  A cache that misses on every build passes the header case above for the worst possible reason.")
    else
        report.keep_pass(@r)

# **Only the module that read the header is rebuilt.** Acceptance row 1
# from the cache's side: the header reaches exactly one translation
# unit, so an edit to it moves exactly one object.
function only_the_module_that_read_it_is_rebuilt(@r: report.Report, scratch: str, compiler: str)
    label = "cache/only the module that read it is rebuilt"
    dir = laid_out(scratch: scratch, value: "4")
    if dir.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the program out under " + scratch)
        return
    first = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " build " + shell.sq(dir.must() + "/prog.hero"))
    if first.is_err() || first.must().code != 0
        report.keep_failure(@r, label: label, detail: "  the first build did not run")
        return
    if write_header(dir: dir.must(), value: "5").is_err()
        report.keep_failure(@r, label: label, detail: "  cannot rewrite the header")
        return
    moved = objects_newer_than(scratch: scratch, marker: dir.must() + "/marker", command: shell.patience() + shell.sq(compiler) + " build " + shell.sq(dir.must() + "/prog.hero"))
    if moved.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot ask the filesystem which objects moved")
        return
    names: [str] @ []
    for path in moved.must()
        names @ names.push(strings.base_name(path))
    only = names.sort()
    if only.len() != 1 || only[0] != "bind.o"
        report.keep_failure(@r, label: label, detail: "  the header edit should move `bind.o` and nothing else — it moved:\n    " + only.join("\n    ") + "\n  Nothing means the edit was invisible; everything means the header reached translation units that never declared the `extern`.")
    else
        report.keep_pass(@r)

# **A reordered variant is not served from a warm object.** Three
# orderings in a row, the third one seen by neither of the first two, and
# after each the caller must still print the case it names by NAME.
#
# Nothing here edits the caller's file. That is the point: the caller's
# text is regenerated from the module it reaches, so the edit lands in
# its key without anybody writing the dependency down.
#
# **That the case has teeth was measured rather than assumed** (step 8,
# 2026-08-26): the three orderings put `h_hue_Colour_tag_blue` at 2, then
# 0, then 1 in the CALLER's own emitted C, and each one landed under a
# different cache key. So a key blind to the tag enum would hand the
# second build an object that still switches on 2 while the module now
# says 0, and the program would print `red` at exit 0.
function a_reordered_variant_is_not_served_warm(@r: report.Report, scratch: str, compiler: str)
    label = "cache/a reordered variant is not served warm"
    dir = scratch + "/" + TAGS_HOME
    if shell.remove_tree(dir).is_err() || shell.mkdir_all(dir).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the program out under " + dir)
        return
    if write_file(path: dir + "/caller.hero", text: TAGS_CALLER).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot write the caller")
        return
    wrong: [str] @ []
    orders: [[str]] = [
        ["red", "green", "blue"]
        ["blue", "green", "red"]
        ["green", "blue", "red"]
    ]
    for order in orders
        if write_file(path: dir + "/hue.hero", text: hue_module(order)).is_err()
            report.keep_failure(@r, label: label, detail: "  cannot write the variant module")
            return
        said = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " run " + shell.sq(dir + "/caller.hero"))
        if said.is_err() || said.must().code != 0
            wrong @ wrong.push("    with the cases in the order " + order.join(", ") + " the build did not run: " + said.default(shell.Run(code: -1, out: "", err: "cannot run")).err)
            continue
        if said.must().out != "blue\n"
            wrong @ wrong.push("    with the cases in the order " + order.join(", ") + " the program printed " + strings.trimmed(said.must().out) + " where it names `.blue`")
    if wrong.len() > 0
        report.keep_failure(@r, label: label, detail: wrong.join("\n") + "\n  A variant's cases are numbered by position and the caller's `match` is a C `switch` over those numbers, in another translation unit. What keeps them together is that a TU's text carries the tag enum of every type it reaches, so this edit changes the CALLER's own text and therefore its key. A wrong case here is exit 0 with no diagnostic anywhere.")
    else
        report.keep_pass(@r)

# **A warm cache never turns a failure into a pass** — M-separate-compilation
# acceptance row 4, in the shape panel 093 R5 re-read it into. The row was
# written as *"exit 1 in both TUs"* and the sitting measured that
# unsatisfiable: the caller here is CORRECT, and the mistake is one module
# over, so there is no second failing unit to demand.
#
# What is left is the half that can go wrong, and it can only go wrong on
# the SECOND invocation, which is why it lives in this file. Build once: the
# declaring module's `extern` is rejected by clang against the real header,
# and the verdict is exit 1 on the author's own line. Build again with every
# healthy object now warm, and the temptation the architecture has to resist
# is reporting success because there was nothing left to compile. Three
# builds, because a cache that fails once and then forgets would pass a pair.
#
# The fourth build repairs the signature and must reach exit 0 and the right
# answer, so the case cannot pass by simply refusing everything forever.
function a_warm_cache_never_turns_a_failure_into_a_pass(@r: report.Report, scratch: str, compiler: str)
    label = "cache/a warm cache never turns a failure into a pass"
    dir = scratch + "/" + FAIL_HOME
    if shell.remove_tree(dir).is_err() || shell.mkdir_all(dir).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the program out under " + dir)
        return
    if write_file(path: dir + "/failbind.hero", text: FAIL_BIND).is_err() || write_file(path: dir + "/caller.hero", text: FAIL_CALLER).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot write the program")
        return
    wrong: [str] @ []
    for attempt in ["first", "second", "third"]
        said = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " build " + shell.sq(dir + "/caller.hero"))
        if said.is_err()
            report.keep_failure(@r, label: label, detail: "  the " + attempt + " build could not run at all")
            return
        if said.must().code != 1
            wrong @ wrong.push("    the " + attempt + " build exited " + said.must().code.to_str() + " where the `extern` disagrees with `math.h` — exit 1 is the contract, and a warm cache is not a reason to stop checking")
        if !strings.contains(text: said.must().err, needle: "error[ffi_return_type]")
            wrong @ wrong.push("    the " + attempt + " build did not report `ffi_return_type`; it said:\n      " + strings.trimmed(said.must().err))
        if !strings.contains(text: said.must().err, needle: "failbind.hero")
            wrong @ wrong.push("    the " + attempt + " build blamed something other than the declaring module — the span must land on the author's line, wherever the cache happens to be warm")
    # And it is a refusal rather than a stuck compiler: repair the
    # signature and the same command must run.
    if write_file(path: dir + "/failbind.hero", text: GOOD_BIND).is_err() || write_file(path: dir + "/caller.hero", text: GOOD_CALLER).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot write the repaired program")
        return
    fixed = shell.run(scratch: scratch, command: shell.patience() + shell.sq(compiler) + " run " + shell.sq(dir + "/caller.hero"))
    if fixed.is_err() || fixed.must().code != 0 || fixed.must().out != "4.0\n"
        wrong @ wrong.push("    the repaired program did not run: exit " + fixed.default(shell.Run(code: -1, out: "", err: "cannot run")).code.to_str() + ", printed " + strings.trimmed(fixed.default(shell.Run(code: -1, out: "", err: "")).out) + " where `sqrt` of 16.0 is 4.0\n    Without this the case would pass by refusing every program forever.")
    if wrong.len() > 0
        report.keep_failure(@r, label: label, detail: wrong.join("\n") + "\n  Panel 093 R5: every dirty TU compiles before any verdict is rendered, the declaring TU's clang failure maps to exit 1 on the `.hero` line, and a cache hit never converts a failure into a success. A build that goes green on its second run is the worst outcome a build system has, because nobody re-reads a green build.")
    else
        report.keep_pass(@r)

# The variant module, with its cases in the order given. The arms are
# written in the same order, which is arbitrary — `match` is exhaustive
# by name and the order of the arms is not the order of the tags.
function hue_module(order: [str]) -> str
    text: str @ "variant Colour\n"
    for name in order
        text @ text + "    " + name + "\n"
    text @ text + "\nfunction name_of(c: Colour) -> str\n    return match c\n"
    for name in order
        text @ text + "        ." + name + " => \"" + name + "\"\n"
    return text

# Run `command`, and answer which object files under `build/` came out
# of it newer than a marker written just before.
#
# `find -newer` rather than a timestamp read and compared: the harness
# has no clock, and the question is a comparison between two files
# rather than a moment in time. The marker is written first and the
# command runs after it, so anything newer was written by the command.
function objects_newer_than(scratch: str, marker: str, command: str) -> [str]?
    touched = shell.run(scratch: scratch, command: "touch " + shell.sq(marker))
    if touched.is_err() || touched.must().code != 0
        return fail("cannot_run", "cannot write the marker at " + marker)
    ran = shell.run(scratch: scratch, command: command)
    if ran.is_err() || ran.must().code != 0
        return fail("cannot_run", "the build did not run: " + ran.default(shell.Run(code: -1, out: "", err: "cannot run")).err)
    listed = shell.run(scratch: scratch, command: "find build -name '*.o' -newer " + shell.sq(marker))
    if listed.is_err()
        return fail("cannot_run", "cannot list what moved under build/")
    out: [str] @ []
    for row in strings.lines(listed.must().out)
        # The runtime's own object is not in scope: it is keyed on the
        # runtime's contents and nothing here edits those.
        if row.len() > 0 && !strings.starts_with(text: strings.base_name(row), prefix: "runtime-")
            out @ out.push(row)
    return ok(out.sort())
