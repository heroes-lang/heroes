# The generated C compiles with NO warnings at all — over the goldens and
# over the corpus.
#
# Ports golden.rs:811 and corpus.rs:382. Two directories of cases and
# fourteen real programs, each built at -O0 and at -O2, because clang's
# warnings differ by level and reach stderr even on success, and a warning
# nobody sees cannot falsify anything. It ran `build` and `run` for the two
# levels until defect 299 (below, `judge`).
#
# WHY A ZERO-WARNING BAR AND NOT A LIST OF ACCEPTABLE ONES: the flag set
# has `-Werror=` on four warnings and plain `-W` on
# `-Wconditional-uninitialized`, which panel 020 adopted with a falsifiable
# disposition — zero fires across the corpus promotes it to `-Werror=`,
# one fire is a lowering bug and gets a case named after it. This test is
# that measurement, standing. If it ever fails, read the warning before
# touching it: clang has found something about the emitter.
#
# `tests/golden/run/` was held to this from M-scalars-run and the corpus
# was not, which is how a dead temporary reached a real program — `_ =
# f(x)?` on a fallible left an `int64_t t72;` that nothing read, and clang
# said so on every build of `examples/maze/` while every golden stayed
# silent.
#
# THERE IS NO EXEMPTION, AND THERE WAS ONE UNTIL 2026-09-03. A program
# that handed C an `@` parameter of type `ptr` emitted `void **` where the
# header wanted `sqlite3 **`, and C converts `void *` to any object pointer
# but never `void **`; that warning was TRUE, so this suite forwarded it and
# asserted BOTH ways — a program lending a `ptr` HAD to warn, and only with
# that text. The premise under it was an M-ffi-ladder decision: a cast the
# emitter inserted would compile clean and hide a real limit of `ptr`.
# Panel 103 overturned it on a measurement: clang 22 made that warning an
# ERROR by default, so the same program was refused on two of the three
# platforms and accepted on the third, and the emitter now passes
# `(void *)&x` for a `ptr` out-parameter — the one pointee the spec leaves
# to the header — while a NUMERIC `@` is checked by the compiler itself
# (`cli/pointee.hero`). The second half of this suite fired on
# `examples/sqlite` the same afternoon, exactly as the sentence above it
# promised, and the exemption was deleted by the step that made it obsolete.

use absence
use cases
use floors
use gallery
use platform_skips
use report
use shell
use strings

constant RUN_DIR: str
    "tests/golden/run"

constant EMIT_DIR: str
    "tests/golden/emit"

constant EXAMPLES: str
    "examples"

# **The floors of what the suite walks, since defect 2534** (2026-11-15):
# until then it held none, so a walk broken to find nothing read `0 passed, 0
# failed` and passed the gate (measured that day from a folder holding the
# golden directories and the gallery empty). Each is the count its list held
# at 0f924302a by the walk's own rule: in `run/` 800 `.hero` cases and 25
# `.case` folders, in `emit/` 13 cases (`cases.collect`), and 56 of the
# folders of `examples/` holding a `main.hero`, the count `corpus` floors. The
# gallery's floor is its module's, `gallery.LEAST`, as `corpus` asks it.
# Raised as `floors.check` tells, never lowered to fit a walk.
constant LEAST_RUN: i64
    825

constant LEAST_EMIT: i64
    13

# **55 since 2026-11-19, lowered on purpose, the world moved and not the
# floor to fit it** (M-rebel-library step 55g), as `corpus`'s at step 55b:
# the author's decision of 2026-11-15 splits the examples in two groups, and
# `packages`, the one program that held a package's own tests, moved to
# `examples-rebel/packages/`; this suite's walk read 55 folders holding a
# `main.hero` that day, and failed on its floor of 56 alone.
constant LEAST_EXAMPLES: i64
    55

# What the suite walks, each list with its floor: the golden directories, the
# folders of the examples, and the gallery.
record Walks
    golden: [floors.Walked]
    examples: floors.Walked
    gallery: floors.Walked

# The tree's lists, as `run_all` walks them.
function walks() -> Walks
    return Walks(
        golden: [floors.Walked(dir: RUN_DIR, least: LEAST_RUN), floors.Walked(dir: EMIT_DIR, least: LEAST_EMIT)],
        examples: floors.Walked(dir: EXAMPLES, least: LEAST_EXAMPLES),
        gallery: floors.Walked(dir: gallery.DIR, least: gallery.LEAST)
    )

# `only` narrows the walk to the programs whose name holds it, the name each
# one's label gives after `warnings/` (defect 2529): a golden case's, an
# example's folder's and a gallery program's alike. Until then the suite took
# no word, and `main` told the person narrowing a repair to its cases that it
# walked none, while it built every case of `run/` and `emit/`, every example
# and every gallery program at two levels. The skip ratio is asked of the
# programs walked, as `run` asks it of a filter's cases. A filter's programs
# are not the tree, so it asks no floor (`cases.asks_floor`).
function run_all(scratch: str, compiler: str, only: str) -> report.Report?
    return walk(scratch: scratch, compiler: compiler, lists: walks(), only: only)

# The suite over the lists it is handed: what `run_all` asks of the tree, with
# the lists and their floors as parameters so a test asks it of a tree of its
# own (defect 2534). Each list's whole count is held to its floor before its
# programs are judged.
function walk(scratch: str, compiler: str, lists: Walks, only: str) -> report.Report?
    r: report.Report @= report.empty()
    judged: i64 @= 0
    skipped: i64 @= 0

    for walked in lists.golden
        whole = cases.collect(scratch: scratch, dir: walked.dir)?
        floored(@r, walked: walked, found: whole.len(), what: "cases in " + walked.dir, only: only)

        for item in cases.matching(found: whole, only: only)
            judge(@r, @skipped, scratch: scratch, compiler: compiler, label: "warnings/" + item.name, main: item.source)
            judged @ judged + 1

    examples = example_programs(scratch: scratch, dir: lists.examples.dir)?
    floored(
        @r,
        walked: lists.examples,
        found: examples.len(),
        what: "folders holding a main.hero in " + lists.examples.dir,
        only: only
    )

    for dir in examples
        main = dir + "/main.hero"

        if !kept_by_word(name: strings.base_name(path: dir), only: only)
            continue
        judge(
            @r,
            @skipped,
            scratch: scratch,
            compiler: compiler,
            label: "warnings/" + strings.base_name(path: dir),
            main: main
        )
        judged @ judged + 1

    # **The gallery's programs, one file each, since 2026-10-11** (defect
    # 606): the walk above finds a directory's `main.hero`, and the gallery
    # has none, so no program the site's gallery shows was held to this bar.
    # One with holes produces no C (spec § 12), which `check`'s answer says
    # (`gallery.unfinished`); a check that cannot run leaves the build to say
    # why, as a failure.
    lessons = gallery.programs_in(scratch: scratch, dir: lists.gallery.dir)?
    floored(@r, walked: lists.gallery, found: lessons.len(), what: "programs in " + lists.gallery.dir, only: only)

    for path in lessons
        if !kept_by_word(name: gallery.name_of(path), only: only)
            continue
        said = gallery.checked(scratch: scratch, compiler: compiler, path: path)

        if !said.is_err() && gallery.unfinished(said.must())
            continue
        judge(
            @r,
            @skipped,
            scratch: scratch,
            compiler: compiler,
            label: "warnings/" + gallery.name_of(path),
            main: path
        )
        judged @ judged + 1

    # **A skip is not a pass, and a machine skipping a third of the programs
    # is not judging them** (defect 299, 2026-10-04): every other form that
    # skips for a missing library holds this floor, and this one held none,
    # so a machine lacking every library read green with nothing judged.
    if starved(skipped: skipped, found: judged)
        report.keep_failure(
            @r,
            label: "warnings",
            detail: cases.starved_words(skipped: skipped, count: judged, noun: "programs", only: only, whole: "testing the warnings")
        )
    return ok(r)

# One list's whole count held to its floor, where the run asks one: the whole
# suite, never a filter, whose programs are not the tree.
function floored(@r: report.Report, walked: floors.Walked, found: i64, what: str, only: str)
    if cases.asks_floor(only)
        floors.check(@r, label: "warnings", found: found, floor: walked.least, what: what)

# The folders of the examples' directory `dir` holding a `main.hero`, each a
# program the suite builds; a folder with none, the gallery's among them, is
# not one.
function example_programs(scratch: str, dir: str) -> [str]?
    out: [str] @= []

    for folder in shell.list_directories(scratch: scratch, dir: dir)?
        if !read_file(folder + "/main.hero").is_err()
            out @ out.push(folder)

    return ok(out)

# Whether the third word keeps the program whose label names it `name`: every
# program where the word is empty, else the ones whose name holds it, as
# `cases.matching` reads a case's.
function kept_by_word(name: str, only: str) -> bool
    return only == "" || strings.contains(s: name, substr: only)

# A machine that skipped a third of the programs for libraries it lacks: the
# floor `run`, `lines` and the golden forms hold.
function starved(skipped: i64, found: i64) -> bool
    return skipped > 0 && skipped * 3 >= found

# The two levels a program is built at, as `build` spells them.
constant LEVELS: [str]
    [
        "-O0"
        "-O2"
    ]

# One program built at both levels, and no warning at either; `skipped`
# gains one where the machine lacks a library the program binds.
#
# **A build that fails is a failure, and the build is asked at -O2 as at
# -O0** (defect 299, 2026-10-04). A build that exited non-zero for a reason
# other than a library this machine lacks fell through to the warning scan,
# and with no `warning:` line on its stderr it read as passing: a planted
# compiler that refused every program read `1 passed, 0 failed` (measured
# that day). And -O2 was asked through `run`, which builds through the same
# `produce` as `build -O2` (`selfhost/cli/verbs.hero`, the two verbs differing
# in their default level and in running the binary after) and then answers
# with the PROGRAM's exit code, so a build that failed and a program that
# exited 1 could not be told apart, and a program's own stderr was scanned
# for warnings as well. `build -O2` asks the build alone.
#
# **A program this platform cannot build is skipped by name before either
# level**, apart from the missing libraries' floor, as `run` skips it
# (`platform_skips.build_reason`, defect 2523): until then it was built and
# told as a failure at -O0 on the CI's Windows leg.
function judge(@r: report.Report, @skipped: i64, scratch: str, compiler: str, label: str, main: str)
    unbuilt = platform_skips.build_reason(main)

    if !unbuilt.is_err()
        report.keep_skip(@r, label: label, detail: "  " + unbuilt.must())
        return

    for level in LEVELS
        said = shell.run_guarded(scratch: scratch, words: [compiler, "build", main, level])

        # The refusal's own words (defect 317): it names the compiler and
        # why there is no verdict, a stream that is not UTF-8 among them.
        if said.is_err()
            report.keep_failure(
                @r,
                label: label + " at " + level,
                detail: "  `build " + main + " " + level + "`: " + shell.refusal(said)
            )
            return

        # A program this machine cannot build for a library it lacks says
        # nothing about warnings: skipped, by name. It is the machine's only
        # where the program binds what the compiler says is missing and the
        # machine, asked, lacks it (`absence`); until defect 246 the compiler's
        # words alone dropped the program, with no pass, no failure and no
        # line. Any other build that fails is a failure, said with its exit.
        if said.must().code != 0
            lacks = absence.machine_lacks(scratch: scratch, path: main, expected: "", said: said.must().err)

            if !lacks.is_err()
                skipped @ skipped + 1
                report.keep_skip(@r, label: label, detail: "  " + lacks.must())
                return
            detail: str @= "  `build " + main + " " + level + "` exited " + said.must().code.to_str() + ", so its C was never judged for warnings:\n    " + strings.trimmed(said.must().err)
            why = absence.refused(lacks)

            if why.len() > 0
                detail @ detail + "\n  not skipped for a missing library: " + why
            report.keep_failure(@r, label: label + " at " + level, detail: detail)
            return
        noise = warnings_in(said.must().err)

        if noise.len() > 0
            blamed = foreign_program(noise: noise, main: main)

            if blamed.len() > 0
                report.keep_failure(
                    @r,
                    label: label + " at " + level,
                    detail: "  this invocation was building " + main + " and its stderr carried warnings about " + blamed + ":\n    " + noise.join("\n    ") + "\n  a warning names the program it is about, so one program's warnings reaching another's\n  stderr is a misattribution and not a finding (defect 057). Look for a file two clang\n  invocations share: before 2026-09-17 every one of them wrote `build/clang-stderr.txt`."
                )
                return
            report.keep_failure(
                @r,
                label: label + " at " + level,
                detail: "  " + main + " produced clang warnings:\n    " + noise.join("\n    ")
            )
            return

    report.keep_pass(@r)

function warnings_in(err: str) -> [str]
    found: [str] @= []

    for row in strings.lines(err)
        if strings.contains(s: row, substr: "warning:")
            found @ found.push(row)

    return found

test "a warning line is found wherever clang puts it, and nothing else is"
    said = "x.c:3:5: warning: unused variable 'a' [-Wunused-variable]\nx.c:9:1: note: here\n"
    assert warnings_in(said).len() == 1
    assert warnings_in("").len() == 0
    assert warnings_in("no warnings here\n").len() == 0

# **A warning names the program it is about, and this suite had no way to say
# so** (defect 057, 2026-09-17). One net run reported three warnings against
# `examples/curl` that named `tests/golden/ir/regression-extern-parameter-types`,
# a program curl does not touch, and the row read as curl's own defect. The
# repair is in the compiler, where every clang invocation now writes its own
# stderr file instead of the build directory's one; this is the half that makes
# the next occurrence say what it is rather than blame the nearest program.
#
# A `use` starts at the directory of the file being compiled (spec § 1), so
# every module a program reaches is under that program's own directory. A
# `.hero` path outside it, in this invocation's stderr, is therefore another
# program's — and a C or header path is not evidence either way, since a
# program may legitimately warn about a header it includes from anywhere.
function foreign_program(noise: [str], main: str) -> str
    home = directory_of(main)

    for row in noise
        for word in strings.words(row)
            if !strings.contains(s: word, substr: ".hero")
                continue
            at = strings.index_of(text: word, needle: ".hero").must()
            named = word.slice(from: 0, to: at + 5)

            if named == main
                continue

            if home.len() > 0 && strings.has_prefix(s: named, prefix: home + "/")
                continue
            return named

    return ""

# The directory a path sits in, or "" for a bare name.
function directory_of(path: str) -> str
    name = strings.base_name(path: path)

    if name.len() >= path.len()
        return ""
    return path.slice(from: 0, to: path.len() - name.len() - 1)

test "a warning naming another program is told apart from one naming this program's own modules"
    mine = "examples/curl/main.hero"
    own = ["examples/curl/http.hero:4:9: warning: unused variable 'a'"]
    theirs = ["tests/golden/ir/regression-extern-parameter-types.hero:14:109: warning: absolute value"]
    generated = ["build/tu-08401abe1c35d47d/x.c:28:29: warning: absolute value function 'abs'"]
    assert foreign_program(noise: own, main: mine) == ""
    assert foreign_program(noise: theirs, main: mine) == "tests/golden/ir/regression-extern-parameter-types.hero"

    # A C path names no program, so it is not evidence: the `.hero` line beside
    # it is what says whose compile this was.
    assert foreign_program(noise: generated, main: mine) == ""
    assert foreign_program(noise: [], main: mine) == ""
    assert directory_of("examples/curl/main.hero") == "examples/curl"
    assert directory_of("main.hero") == ""

    # A `note:` mentioning the word is not a warning line; a real warning
    # line always carries `warning:` itself.
    assert warnings_in("  note: this warning: is quoted\n").len() == 1

# DEFECT 246's cause in this suite, held as a test (2026-10-04): the compiler's
# words alone dropped a program with no line at all. A header the machine has,
# said to be missing, is a program that did not build; a header no machine has,
# which the program binds, is skipped by name.
test "fixedbugs: a program that cannot build is skipped only where the machine lacks what it binds"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = scratch + "/warnings-absence"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    has = absence.planted_case(dir: tree, name: "has", bound: "stdio.h", missing: "stdio.h")
    assert !has.is_err()
    refuted: report.Report @= report.empty()
    none: i64 @= 0
    judge(@refuted, @none, scratch: scratch, compiler: compiler.must(), label: "warnings/has", main: has.must())
    assert none == 0
    assert refuted.failed == 1
    assert refuted.passed == 0
    assert refuted.skips.len() == 0
    assert strings.contains(s: refuted.failures[0], substr: "clang finds `stdio.h`")
    lacks = absence.planted_case(dir: tree, name: "lacks", bound: absence.NOWHERE, missing: absence.NOWHERE)
    assert !lacks.is_err()
    excused: report.Report @= report.empty()
    one: i64 @= 0
    judge(@excused, @one, scratch: scratch, compiler: compiler.must(), label: "warnings/lacks", main: lacks.must())
    assert one == 1
    assert excused.failed == 0
    assert excused.passed == 0
    assert excused.skips.len() == 1
    assert strings.has_prefix(s: excused.skips[0], prefix: "SKIP warnings/lacks\n")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2523, held as a test (2026-11-14): a program the Windows target
# cannot build is skipped there by name before either level, apart from the
# missing libraries' floor, and built everywhere else. The compiler named is a
# file nobody wrote, so a build asked is a failure naming it.
test "fixedbugs: a program Windows cannot build is skipped there before its build, and built elsewhere (defect 2523)"
    scratch = shell.own_scratch()
    r: report.Report @= report.empty()
    none_skipped: i64 @= 0
    judge(
        @r,
        @none_skipped,
        scratch: scratch,
        compiler: scratch + "/no-compiler-here",
        label: "warnings/unbuilt",
        main: platform_skips.unbuildable_on_windows()[1].name
    )
    assert none_skipped == 0
    assert r.passed == 0

    if shell.exe_suffix() == ".exe"
        assert r.failed == 0
        assert r.skips.len() == 1
        assert strings.has_prefix(s: r.skips[0], prefix: "SKIP warnings/unbuilt\n  POSIX's signal sets")
    else
        assert r.failed == 1
        assert r.skips.len() == 0
        assert strings.has_prefix(s: r.failures[0], prefix: "FAIL warnings/unbuilt at -O0\n")
        assert strings.contains(s: r.failures[0], substr: "no-compiler-here")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 299, held as a test (2026-10-04). A build that fails for a reason
# that is not a library this machine lacks is a failure, said with its exit,
# where it read as passing: a stand-in compiler refusing every program, its
# stderr holding no `warning:` line, read `1 passed, 0 failed`. The build is
# asked at -O2 as at -O0, so one that fails at -O2 alone is told at -O2. And
# the skips hold the third every other form that skips holds.
test "fixedbugs: a build that fails is a failure at either level, and the skips are floored (defect 299)"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    main = scratch + "/x.hero"
    assert !write_file(path: main, text: "function main()\n    print(1)\n").is_err()
    always = stub_compiler(
        scratch: scratch,
        name: "stub-refuses.sh",
        body: "printf 'error[boom]: the build failed\\n  at x.hero:1:1\\n' 1>&2\nexit 1"
    ).must()
    refused: report.Report @= report.empty()
    none: i64 @= 0
    judge(@refused, @none, scratch: scratch, compiler: always, label: "warnings/x", main: main)
    assert refused.passed == 0
    assert refused.failed == 1
    assert strings.has_prefix(s: refused.failures[0], prefix: "FAIL warnings/x at -O0\n")
    assert strings.contains(
        s: refused.failures[0],
        substr: " -O0` exited 1, so its C was never judged for warnings:\n    error[boom]: the build failed"
    )
    late = stub_compiler(
        scratch: scratch,
        name: "stub-late.sh",
        body: "case \" $* \" in *' -O2 '*) printf 'error[boom]: at -O2 alone\\n' 1>&2; exit 1 ;; esac\nexit 0"
    ).must()
    at_o2: report.Report @= report.empty()
    judge(@at_o2, @none, scratch: scratch, compiler: late, label: "warnings/x", main: main)
    assert at_o2.failed == 1
    assert strings.has_prefix(s: at_o2.failures[0], prefix: "FAIL warnings/x at -O2\n")
    clean = stub_compiler(scratch: scratch, name: "stub-clean.sh", body: "exit 0").must()
    quiet: report.Report @= report.empty()
    judge(@quiet, @none, scratch: scratch, compiler: clean, label: "warnings/x", main: main)
    assert quiet.passed == 1
    assert quiet.failed == 0
    assert none == 0

    # The floor: a third of the programs skipped is a machine not judging them.
    assert starved(skipped: 3, found: 3)
    assert starved(skipped: 2, found: 6)
    assert !starved(skipped: 1, found: 4)
    assert !starved(skipped: 0, found: 3)
    assert !shell.remove_tree(scratch).is_err()

# A stand-in compiler: a POSIX script of `body`, made executable.
function stub_compiler(scratch: str, name: str, body: str) -> str?
    path = scratch + "/" + name
    write_file(path: path, text: "#!/bin/sh\n" + body + "\n")?
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])?

    if made.code != 0
        return fail(code: "cannot_run", msg: "cannot make " + path + " executable")
    return ok(path)

# DEFECT 2529, held as a test (2026-11-14): the third word narrows the walk to
# the programs whose name holds it, where `main` refused it as the word of a
# suite that walks no cases. The word is the first `run/` case's whole name,
# which no example's folder and no gallery program's name holds (asserted, so
# the day one does the test says so), and every program the run judged is one
# of the golden cases it names.
test "fixedbugs: the third word narrows the walk to the programs whose name holds it (defect 2529)"
    compiler = shell.some_compiler()

    if compiler.is_err()
        return
    scratch = shell.own_scratch()
    word = cases.collect(scratch: scratch, dir: RUN_DIR).must()[0].name
    named: i64 @= 0

    for walked in walks().golden
        named @ named + cases.matching(found: cases.collect(scratch: scratch, dir: walked.dir).must(), only: word).len()

    for dir in shell.list_directories(scratch: scratch, dir: EXAMPLES).must()
        assert !kept_by_word(name: strings.base_name(path: dir), only: word)

    for path in gallery.programs(scratch).must()
        assert !kept_by_word(name: gallery.name_of(path), only: word)

    got = run_all(scratch: scratch, compiler: compiler.must(), only: word).must()
    assert named >= 1
    assert got.passed + got.failed + got.skips.len() == named

    # The word reads a program's name as its label gives it after `warnings/`:
    # every program for no word, a gallery program by `gallery/`, and a name
    # that does not hold the word is left.
    assert kept_by_word(name: "anything", only: "")
    assert kept_by_word(name: "gallery/hello", only: "gallery/")
    assert !kept_by_word(name: "curl", only: "gallery/")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2534, held as a test (2026-11-15): the suite held no floor, so run
# from a folder holding the golden directories and the gallery empty it read
# `0 passed, 0 failed`, exit 0. Handed empty lists of a test's own, each floored
# at one, it fails once per list, naming it, a folder of the examples with no
# `main.hero` counting for none; a filter asks no floor of them; and a floor
# its list meets is a pass. No program is built, so the compiler named is a
# file nobody wrote.
test "fixedbugs: a walk that finds nothing in a list fails by that list's floor, and a filter asks none (defect 2534)"
    scratch = shell.own_scratch()
    tree = scratch + "/warnings-2534"
    assert !shell.remove_tree(tree).is_err()

    for dir in ["run", "emit", "examples/gallery", "gallery"]
        assert !shell.mkdir_all(tree + "/" + dir).is_err()

    compiler = scratch + "/no-compiler-here"
    empty = Walks(
        golden: [floors.Walked(dir: tree + "/run", least: 1), floors.Walked(dir: tree + "/emit", least: 1)],
        examples: floors.Walked(dir: tree + "/examples", least: 1),
        gallery: floors.Walked(dir: tree + "/gallery", least: 1)
    )
    got = walk(scratch: scratch, compiler: compiler, lists: empty, only: "").must()
    assert got.passed == 0
    assert got.failed == 4
    head = "FAIL warnings\n  the walk found 0 "
    assert strings.has_prefix(s: got.failures[0], prefix: head + "cases in " + tree + "/run and had 1 — ")
    assert strings.has_prefix(s: got.failures[1], prefix: head + "cases in " + tree + "/emit and had 1 — ")
    assert strings.has_prefix(
        s: got.failures[2],
        prefix: head + "folders holding a main.hero in " + tree + "/examples and had 1 — "
    )
    assert strings.has_prefix(s: got.failures[3], prefix: head + "programs in " + tree + "/gallery and had 1 — ")
    filtered = walk(scratch: scratch, compiler: compiler, lists: empty, only: "fixedbugs-2534").must()
    assert filtered.passed == 0
    assert filtered.failed == 0
    unset = floors.Walked(dir: tree + "/run", least: 0)
    none: [floors.Walked] = []
    met = walk(
        scratch: scratch,
        compiler: compiler,
        lists: Walks(golden: none, examples: unset, gallery: unset),
        only: ""
    ).must()
    assert met.passed == 2
    assert met.failed == 0
    assert !shell.remove_tree(scratch).is_err()
