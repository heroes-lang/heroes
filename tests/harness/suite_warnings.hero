# The generated C compiles with NO warnings at all — over the goldens and
# over the corpus.
#
# Ports golden.rs:811 and corpus.rs:382. Two directories of cases and
# fourteen real programs, each built at -O0 and at -O2, because clang's
# warnings differ by level and reach stderr even on success, and a warning
# nobody sees cannot falsify anything. It ran `build` and `run` for the two
# levels until defect 299 (below, `judge`).
#
# WHY A ZERO-WARNING BAR AND NOT A LIST OF ACCEPTABLE ONES: the flag set
# has `-Werror=` on four warnings and plain `-W` on
# `-Wconditional-uninitialized`, which panel 020 adopted with a falsifiable
# disposition — zero fires across the corpus promotes it to `-Werror=`,
# one fire is a lowering bug and gets a case named after it. This test is
# that measurement, standing. If it ever fails, read the warning before
# touching it: clang has found something about the emitter.
#
# `tests/golden/run/` was held to this from M-scalars-run and the corpus
# was not, which is how a dead temporary reached a real program — `_ =
# f(x)?` on a fallible left an `int64_t t72;` that nothing read, and clang
# said so on every build of `examples/maze/` while every golden stayed
# silent.
#
# THERE IS NO EXEMPTION, AND THERE WAS ONE UNTIL 2026-09-03. A program
# that handed C an `@` parameter of type `ptr` emitted `void **` where the
# header wanted `sqlite3 **`, and C converts `void *` to any object pointer
# but never `void **`; that warning was TRUE, so this suite forwarded it and
# asserted BOTH ways — a program lending a `ptr` HAD to warn, and only with
# that text. The premise under it was an M-ffi-ladder decision: a cast the
# emitter inserted would compile clean and hide a real limit of `ptr`.
# Panel 103 overturned it on a measurement: clang 22 made that warning an
# ERROR by default, so the same program was refused on two of the three
# platforms and accepted on the third, and the emitter now passes
# `(void *)&x` for a `ptr` out-parameter — the one pointee the spec leaves
# to the header — while a NUMERIC `@` is checked by the compiler itself
# (`cli/pointee.hero`). The second half of this suite fired on
# `examples/sqlite` the same afternoon, exactly as the sentence above it
# promised, and the exemption was deleted by the step that made it obsolete.

use absence
use cases
use report
use shell
use strings

constant GOLDEN_DIRS: [str]
    [
        "tests/golden/run"
        "tests/golden/emit"
    ]

constant EXAMPLES: str
    "examples"

function run_all(scratch: str, compiler: str) -> report.Report?
    r: report.Report @ report.empty()
    judged: i64 @ 0
    skipped: i64 @ 0

    for dir in GOLDEN_DIRS
        for item in cases.collect(scratch: scratch, dir: dir)?
            judge(@r, @skipped, scratch: scratch, compiler: compiler, label: "warnings/" + item.name, main: item.source)
            judged @ judged + 1

    for dir in shell.list_directories(scratch: scratch, dir: EXAMPLES)?
        main = dir + "/main.hero"

        if read_file(main).is_err()
            continue
        judge(
            @r,
            @skipped,
            scratch: scratch,
            compiler: compiler,
            label: "warnings/" + strings.base_name(path: dir),
            main: main
        )
        judged @ judged + 1

    # **A skip is not a pass, and a machine skipping a third of the programs
    # is not judging them** (defect 299, 2026-10-04): every other form that
    # skips for a missing library holds this floor, and this one held none,
    # so a machine lacking every library read green with nothing judged.
    if starved(skipped: skipped, found: judged)
        report.keep_failure(
            @r,
            label: "warnings",
            detail: "  " + skipped.to_str() + " of " + judged.to_str() + " programs were skipped for a missing library: this machine is not testing the warnings"
        )
    return ok(r)

# A machine that skipped a third of the programs for libraries it lacks: the
# floor `run`, `lines` and the golden forms hold.
function starved(skipped: i64, found: i64) -> bool
    return skipped > 0 && skipped * 3 >= found

# The two levels a program is built at, as `build` spells them.
constant LEVELS: [str]
    [
        "-O0"
        "-O2"
    ]

# One program built at both levels, and no warning at either; `skipped`
# gains one where the machine lacks a library the program binds.
#
# **A build that fails is a failure, and the build is asked at -O2 as at
# -O0** (defect 299, 2026-10-04). A build that exited non-zero for a reason
# other than a library this machine lacks fell through to the warning scan,
# and with no `warning:` line on its stderr it read as passing: a planted
# compiler that refused every program read `1 passed, 0 failed` (measured
# that day). And -O2 was asked through `run`, which builds through the same
# `produce` as `build -O2` (`selfhost/cli/verbs.hero`, the two verbs differing
# in their default level and in running the binary after) and then answers
# with the PROGRAM's exit code, so a build that failed and a program that
# exited 1 could not be told apart, and a program's own stderr was scanned
# for warnings as well. `build -O2` asks the build alone.
function judge(@r: report.Report, @skipped: i64, scratch: str, compiler: str, label: str, main: str)
    for level in LEVELS
        said = shell.run_guarded(scratch: scratch, words: [compiler, "build", main, level])

        # The refusal's own words (defect 317): it names the compiler and
        # why there is no verdict, a stream that is not UTF-8 among them.
        if said.is_err()
            report.keep_failure(
                @r,
                label: label + " at " + level,
                detail: "  `build " + main + " " + level + "`: " + shell.refusal(said)
            )
            return

        # A program this machine cannot build for a library it lacks says
        # nothing about warnings: skipped, by name. It is the machine's only
        # where the program binds what the compiler says is missing and the
        # machine, asked, lacks it (`absence`); until defect 246 the compiler's
        # words alone dropped the program, with no pass, no failure and no
        # line. Any other build that fails is a failure, said with its exit.
        if said.must().code != 0
            lacks = absence.machine_lacks(scratch: scratch, path: main, expected: "", said: said.must().err)

            if !lacks.is_err()
                skipped @ skipped + 1
                report.keep_skip(@r, label: label, detail: "  " + lacks.must())
                return
            detail: str @ "  `build " + main + " " + level + "` exited " + said.must().code.to_str() + ", so its C was never judged for warnings:\n    " + strings.trimmed(said.must().err)
            why = absence.refused(lacks)

            if why.len() > 0
                detail @ detail + "\n  not skipped for a missing library: " + why
            report.keep_failure(@r, label: label + " at " + level, detail: detail)
            return
        noise = warnings_in(said.must().err)

        if noise.len() > 0
            blamed = foreign_program(noise: noise, main: main)

            if blamed.len() > 0
                report.keep_failure(
                    @r,
                    label: label + " at " + level,
                    detail: "  this invocation was building " + main + " and its stderr carried warnings about " + blamed + ":\n    " + noise.join("\n    ") + "\n  a warning names the program it is about, so one program's warnings reaching another's\n  stderr is a misattribution and not a finding (defect 057). Look for a file two clang\n  invocations share: before 2026-09-17 every one of them wrote `build/clang-stderr.txt`."
                )
                return
            report.keep_failure(
                @r,
                label: label + " at " + level,
                detail: "  " + main + " produced clang warnings:\n    " + noise.join("\n    ")
            )
            return

    report.keep_pass(@r)

function warnings_in(err: str) -> [str]
    found: [str] @ []

    for row in strings.lines(err)
        if strings.contains(text: row, needle: "warning:")
            found @ found.push(row)

    return found

test "a warning line is found wherever clang puts it, and nothing else is"
    said = "x.c:3:5: warning: unused variable 'a' [-Wunused-variable]\nx.c:9:1: note: here\n"
    assert warnings_in(said).len() == 1
    assert warnings_in("").len() == 0
    assert warnings_in("no warnings here\n").len() == 0

# **A warning names the program it is about, and this suite had no way to say
# so** (defect 057, 2026-09-17). One net run reported three warnings against
# `examples/curl` that named `tests/golden/ir/regression-extern-parameter-types`,
# a program curl does not touch, and the row read as curl's own defect. The
# repair is in the compiler, where every clang invocation now writes its own
# stderr file instead of the build directory's one; this is the half that makes
# the next occurrence say what it is rather than blame the nearest program.
#
# A `use` starts at the directory of the file being compiled (spec § 1), so
# every module a program reaches is under that program's own directory. A
# `.hero` path outside it, in this invocation's stderr, is therefore another
# program's — and a C or header path is not evidence either way, since a
# program may legitimately warn about a header it includes from anywhere.
function foreign_program(noise: [str], main: str) -> str
    home = directory_of(main)

    for row in noise
        for word in strings.words(row)
            if !strings.contains(text: word, needle: ".hero")
                continue
            at = strings.index_of(text: word, needle: ".hero").must()
            named = word.slice(from: 0, to: at + 5)

            if named == main
                continue

            if home.len() > 0 && strings.starts_with(text: named, prefix: home + "/")
                continue
            return named

    return ""

# The directory a path sits in, or "" for a bare name.
function directory_of(path: str) -> str
    name = strings.base_name(path: path)

    if name.len() >= path.len()
        return ""
    return path.slice(from: 0, to: path.len() - name.len() - 1)

test "a warning naming another program is told apart from one naming this program's own modules"
    mine = "examples/curl/main.hero"
    own = ["examples/curl/http.hero:4:9: warning: unused variable 'a'"]
    theirs = ["tests/golden/ir/regression-extern-parameter-types.hero:14:109: warning: absolute value"]
    generated = ["build/tu-08401abe1c35d47d/x.c:28:29: warning: absolute value function 'abs'"]
    assert foreign_program(noise: own, main: mine) == ""
    assert foreign_program(noise: theirs, main: mine) == "tests/golden/ir/regression-extern-parameter-types.hero"

    # A C path names no program, so it is not evidence: the `.hero` line beside
    # it is what says whose compile this was.
    assert foreign_program(noise: generated, main: mine) == ""
    assert foreign_program(noise: [], main: mine) == ""
    assert directory_of("examples/curl/main.hero") == "examples/curl"
    assert directory_of("main.hero") == ""

    # A `note:` mentioning the word is not a warning line; a real warning
    # line always carries `warning:` itself.
    assert warnings_in("  note: this warning: is quoted\n").len() == 1

# DEFECT 246's cause in this suite, held as a test (2026-10-04): the compiler's
# words alone dropped a program with no line at all. A header the machine has,
# said to be missing, is a program that did not build; a header no machine has,
# which the program binds, is skipped by name.
test "fixedbugs: a program that cannot build is skipped only where the machine lacks what it binds"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = scratch + "/warnings-absence"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    has = absence.planted_case(dir: tree, name: "has", bound: "stdio.h", missing: "stdio.h")
    assert !has.is_err()
    refuted: report.Report @ report.empty()
    none: i64 @ 0
    judge(@refuted, @none, scratch: scratch, compiler: compiler.must(), label: "warnings/has", main: has.must())
    assert none == 0
    assert refuted.failed == 1
    assert refuted.passed == 0
    assert refuted.skips.len() == 0
    assert strings.contains(text: refuted.failures[0], needle: "clang finds `stdio.h`")
    lacks = absence.planted_case(dir: tree, name: "lacks", bound: absence.NOWHERE, missing: absence.NOWHERE)
    assert !lacks.is_err()
    excused: report.Report @ report.empty()
    one: i64 @ 0
    judge(@excused, @one, scratch: scratch, compiler: compiler.must(), label: "warnings/lacks", main: lacks.must())
    assert one == 1
    assert excused.failed == 0
    assert excused.passed == 0
    assert excused.skips.len() == 1
    assert strings.starts_with(text: excused.skips[0], prefix: "SKIP warnings/lacks\n")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 299, held as a test (2026-10-04). A build that fails for a reason
# that is not a library this machine lacks is a failure, said with its exit,
# where it read as passing: a stand-in compiler refusing every program, its
# stderr holding no `warning:` line, read `1 passed, 0 failed`. The build is
# asked at -O2 as at -O0, so one that fails at -O2 alone is told at -O2. And
# the skips hold the third every other form that skips holds.
test "fixedbugs: a build that fails is a failure at either level, and the skips are floored (defect 299)"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    main = scratch + "/x.hero"
    assert !write_file(path: main, text: "function main()\n    print(1)\n").is_err()
    always = stub_compiler(scratch: scratch, name: "stub-refuses.sh", body: "printf 'error[boom]: the build failed\\n  at x.hero:1:1\\n' 1>&2\nexit 1").must(
    )
    refused: report.Report @ report.empty()
    none: i64 @ 0
    judge(@refused, @none, scratch: scratch, compiler: always, label: "warnings/x", main: main)
    assert refused.passed == 0
    assert refused.failed == 1
    assert strings.starts_with(text: refused.failures[0], prefix: "FAIL warnings/x at -O0\n")
    assert strings.contains(
        text: refused.failures[0],
        needle: " -O0` exited 1, so its C was never judged for warnings:\n    error[boom]: the build failed"
    )
    late = stub_compiler(scratch: scratch, name: "stub-late.sh", body: "case \" $* \" in *' -O2 '*) printf 'error[boom]: at -O2 alone\\n' 1>&2; exit 1 ;; esac\nexit 0").must(
    )
    at_o2: report.Report @ report.empty()
    judge(@at_o2, @none, scratch: scratch, compiler: late, label: "warnings/x", main: main)
    assert at_o2.failed == 1
    assert strings.starts_with(text: at_o2.failures[0], prefix: "FAIL warnings/x at -O2\n")
    clean = stub_compiler(scratch: scratch, name: "stub-clean.sh", body: "exit 0").must()
    quiet: report.Report @ report.empty()
    judge(@quiet, @none, scratch: scratch, compiler: clean, label: "warnings/x", main: main)
    assert quiet.passed == 1
    assert quiet.failed == 0
    assert none == 0

    # The floor: a third of the programs skipped is a machine not judging them.
    assert starved(skipped: 3, found: 3)
    assert starved(skipped: 2, found: 6)
    assert !starved(skipped: 1, found: 4)
    assert !starved(skipped: 0, found: 3)
    assert !shell.remove_tree(scratch).is_err()

# A stand-in compiler: a POSIX script of `body`, made executable.
function stub_compiler(scratch: str, name: str, body: str) -> str?
    path = scratch + "/" + name
    write_file(path: path, text: "#!/bin/sh\n" + body + "\n")?
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])?

    if made.code != 0
        return fail(code: "cannot_run", msg: "cannot make " + path + " executable")
    return ok(path)
