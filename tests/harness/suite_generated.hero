# generated — programs nobody wrote, in the net (panel 231's R7;
# M-generated-programs, task 931).
#
# Two checks, in order. **The contract grid** first: the generator's own
# arithmetic against references that reach each value through other
# operators, every operator over every pair in -8 to 7 (`gen_contract.hero`);
# a disagreement there is either the compiler that built this harness
# miscompiling an operator or the model wrong, and either way the sample
# below would be judged against wrong answers, so it is told first. **Then
# the sample**: the programs of seeds 1 to `SAMPLE`, regenerated into this
# suite's scratch by `gen_program.from_seed`, the map `generate.hero make`
# reads, each judged by the compiler under test through every oracle of
# `gen_judge.hero`. **Its answers are committed and its programs are not**
# (panel 231's R7, the critic's finding 18): `ANSWERS` holds every seed's
# `.expected`, and each seed is held to it twice, the generator's own answer
# equal to the committed one and the program's run judged against the
# committed one, so every leg of the CI meets the same answers whatever the
# compiler that built this harness computes, and a miscompilation shared by
# the generator and the program on one platform is seen there. The sample is
# deterministic under its seeds, so it goes red when the compiler or the
# generator changes and never at random, and a failure is reproduced by its
# number,
# `heroes run tests/harness/generate.hero -- make --seed <n> --count 1
# --declared 30`.
#
# **In the net every reading but a pass is a failure**, the two limits panel
# 184 designed included: the sample's depth is at most 4 and its lines are
# short, far under the floor of 2,000 the `run` form pins on four legs
# (`run/fixedbugs-169-*-2000-*`), so a clang that dies or a stack that runs
# out on one of these programs is the compiler's defect, not a limit.
#
# **Which compiler builds the generator decides what the sample can see**
# (the compiler-engineer's Q1, the critic's finding 1): the harness is built
# by the compiler that runs it and judges the one named after `--`, so the
# net run as `<seed's compiler> run tests/harness/main.hero -- <stage 2>`
# computes every answer with a generator that does not share a
# miscompilation introduced since the seed was last refreshed. Run with one
# compiler on both sides, the grid above is the guard.

use gen_contract
use gen_depth
use gen_judge
use gen_program
use gen_text
use report
use shell
use strings

# The seeds the net judges: 128, panel 231's R7, about 3.6 minutes at the
# 1.67 s a program the compiler-engineer measured four checks to cost (an
# inference from that rate; the judge here builds three configurations and
# runs `fmt`, so the first batch gate reads its real cost).
constant SAMPLE: i64
    128

# The share of the sample whose program plants one abort, as `make`'s
# `--declared`.
constant DECLARED: i64
    30

# The seconds a floor's source is given to build: a block 2,000 deep is 16
# megabytes of text, 2.2 s of wall on this Mac on 2026-10-28; the bound is
# the harness's watchdog, so a slower leg is measured rather than cut.
constant DEPTH_SECONDS: i64
    600

# The sample's committed answers, made by `generate.hero answers` and read by
# a person before they are committed.
constant ANSWERS: str
    "tests/golden/generated/answers.txt"

function run_all(scratch: str, compiler: str, only: str) -> report.Report?
    r: report.Report @= report.empty()

    for line in gen_contract.disagreements()
        report.keep_failure(@r, label: "generated/contract", detail: "  " + line)

    if !report.green(r)
        return ok(r)
    committed = answers_in(read_file(ANSWERS)?)

    if committed.len() < SAMPLE
        report.keep_failure(
            @r,
            label: "generated/answers",
            detail: "  " + ANSWERS + " holds " + committed.len().to_str() + " answers and the sample is " + SAMPLE.to_str() + ": `heroes run tests/harness/generate.hero -- answers --count " + SAMPLE.to_str() + " --declared " + DECLARED.to_str() + "` prints them"
        )
        return ok(r)
    dir = scratch + "/generated"
    work = dir + "/work"
    shell.mkdir_all(work)?
    judged: i64 @= 0
    seed: i64 @= 1

    while seed <= SAMPLE
        name = "g" + seed.to_str()

        if only == "" || strings.contains(text: name, needle: only)
            g = gen_program.from_seed(seed: seed, percent: DECLARED)
            source = dir + "/" + name + ".hero"
            files = gen_program.files_of(g, seed: seed)
            gen_program.written(files, dir: dir)?
            computed = files[1].text
            owed = committed[name].default("")

            if computed != owed
                report.keep_failure(
                    @r,
                    label: "generated/" + name + "/answer",
                    detail: "  the generator computes this seed's answer otherwise than " + ANSWERS + " holds it: the generator changed (print the answers again and read them), or the compiler that built this harness computes an operator otherwise\n--- committed ---\n" + owed + "--- computed ---\n" + computed + "--- end ---"
                )
            write_file(path: dir + "/" + name + ".expected", text: owed)?
            v = gen_judge.judged(compiler: compiler, source: source, work: work)?
            judged @ judged + 1

            match v
                .passed _ => report.keep_pass(@r)
                .refused _ | .clang_limit _ | .depth_limit _ | .fell _ | .wrong _ | .sanitized _ | .misformatted _ | .header _ =>
                    report.keep_failure(
                        @r,
                        label: "generated/" + name,
                        detail: "  " + gen_judge.word(v) + ": " + gen_judge.detail(v) + "\n  reproduce: heroes run tests/harness/generate.hero -- make --seed " + seed.to_str() + " --count 1 --declared " + DECLARED.to_str() + " -o <dir>"
                    )
        seed @ seed + 1

    depth_asked = only == "" || strings.contains(text: "depth", needle: only)

    if judged == 0 && !depth_asked
        report.keep_failure(
            @r,
            label: "generated",
            detail: "  `" + only + "` names no seed of 1 to " + SAMPLE.to_str() + ": a run that judged nothing is a green run that tested nothing"
        )

    if depth_asked
        floored(@r, compiler: compiler, dir: dir + "/depth")?
    return ok(r)

# **The floor, on this leg** (panel 184's R6, panel 231's R4): every shape
# `gen_depth` writes, `FLOOR` deep, must build and its binary print its
# answer at exit 0. A reading of oracle 1 that is a designed limit past the
# floor is a defect AT it, since the floor is what R6 promises.
function floored(@r: report.Report, compiler: str, dir: str) -> ()?
    shell.mkdir_all(dir)?

    for shape in gen_depth.shapes()
        source = dir + "/" + shape.name + ".hero"
        binary = dir + "/" + shape.name + shell.exe_suffix()
        write_file(path: source, text: shape.text)?
        built = shell.run_bounded(scratch: dir, program: compiler, words: [compiler, "build", source, "-o", binary], seconds: DEPTH_SECONDS, bytes: 0, stdin_path: "")?
        fell = gen_judge.fallen(built, stage: "build")

        if !fell.is_err()
            report.keep_failure(
                @r,
                label: "generated/depth/" + shape.name,
                detail: "  " + gen_judge.word(fell.must()) + ": " + gen_judge.detail(fell.must()) + "\n  a source " + gen_depth.FLOOR.to_str() + " deep must compile on every platform (panel 184's R6)"
            )
            continue
        ran = shell.run_bounded(scratch: dir, program: binary, words: [binary], seconds: gen_judge.RUN_SECONDS, bytes: gen_judge.program_bytes(), stdin_path: "")?

        if ran.code != 0 || ran.out != shape.expected
            report.keep_failure(
                @r,
                label: "generated/depth/" + shape.name,
                detail: "  built, and its binary ended with exit " + ran.code.to_str() + " printing " + ran.out + " where it owes " + shape.expected + ran.err
            )
            continue
        report.keep_pass(@r)

    return ok()

# The committed answers, `== <name>` and the lines beneath, by name.
function answers_in(text: str) -> {str: str}
    found: {str: str} @= {}
    name: str @= ""
    block: str @= ""

    for row in gen_text.lines_of(text)
        if strings.starts_with(text: row, prefix: "== ")
            if name != ""
                found[name] @ block
            name @ strings.without_prefix(text: row, prefix: "== ")
            block @ ""
        else
            block @ block + row + "\n"

    if name != ""
        found[name] @ block
    return found

test "the committed answers are read back by name, each block its lines"
    got = answers_in("== g1\n3\n== g2\n1\n!at: g2.hero:7:11\n!panic: integer overflow\n")
    assert got["g1"].must() == "3\n"
    assert got["g2"].must() == "1\n!at: g2.hero:7:11\n!panic: integer overflow\n"
    assert got["g3"].is_err()

test "the sample is the map `make` reads, so a seed reproduces"
    a = gen_program.files_of(gen_program.from_seed(seed: 7, percent: DECLARED), seed: 7)
    b = gen_program.files_of(gen_program.from_seed(seed: 7, percent: DECLARED), seed: 7)
    assert a == b
