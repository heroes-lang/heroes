# WHAT A RUN HAS SPENT, AND WHAT ITS NEXT REQUEST MAY SPEND: the price of
# each model the thesis runs on, the cost of an answer from the usage the API
# reported for it, and the most a request can cost before it is sent, which is
# what keeps a live run under the author's cap (M-thesis-harness, 2026-10-20;
# the author's cap of $20 on the trial, issue 2155).
#
# Money is counted in nano-dollars, a billionth of a dollar, as whole numbers:
# every price below is a whole number of them per token, so a cost is exact
# and two runs over the same usage sum to the same figure on every platform.
# The prices are the per-million rows of the `claude-api` skill's model table
# (`shared/models.md`, a cached table, read 2026-10-20): Haiku 5.5 $0.10 in and
# $0.50 out while the prompt is 100K tokens or fewer, $0.50 and $2.50 above;
# Sonnet 5.5 $2 and $10; Opus 5.5 $4 and $20; Fable 5.1 $10 and $50. A cache
# read is $0.20 on Sonnet 5.5 and Opus 5.5 and $0.25 on Fable 5.1, which the
# table gives, and 0.1x the input price on Haiku 5.5, which the prompt-caching
# page gives for every model it names no other multiplier for; a cache write is
# 1.25x the input price, the 5-minute entry `thesis_answer` asks for. Haiku's
# cache rates above 100K are those multipliers applied to its higher input
# rate: an inference from the two pages, not a row either gives. **A model
# with no row has no price**, and a run capped in dollars refuses to start on
# it rather than counting it as free.
#
# The bound on a request not yet sent rests on one fact about text, not on an
# estimate: a token stands for at least one byte, so a prompt of `n` bytes is
# at most `n` tokens, plus the few the API adds around the turns, for which
# `SLACK` is far more than room. Every one of those tokens is priced as a
# cache write, the dearest way an input token is billed, and the answer at
# `max_tokens` of output, thinking included.

# One model's prices, nano-dollars per token.
record Price
    input: i64
    output: i64
    cache_read: i64
    cache_write: i64

# The tokens the API wraps around a prompt's own bytes, bounded from above.
constant SLACK: i64
    1000

constant NANOS_PER_DOLLAR: i64
    1000000000

# The prices of `model` for a prompt of `prompt_tokens`, cache reads and
# writes included; a model with no row fails by name.
function price_of(model: str, prompt_tokens: i64) -> Price?
    if model == "claude-haiku-5-5"
        if prompt_tokens > 100000
            return ok(Price(input: 500, output: 2500, cache_read: 50, cache_write: 625))
        return ok(Price(input: 100, output: 500, cache_read: 10, cache_write: 125))

    if model == "claude-sonnet-5-5"
        return ok(Price(input: 2000, output: 10000, cache_read: 200, cache_write: 2500))

    if model == "claude-opus-5-5"
        return ok(Price(input: 4000, output: 20000, cache_read: 200, cache_write: 5000))

    if model == "claude-fable-5-1"
        return ok(Price(input: 10000, output: 50000, cache_read: 250, cache_write: 12500))
    return fail(
        code: "no_price",
        msg: "no price is written for `" + model + "` in tests/harness/thesis_price.hero, so a cap in dollars cannot be kept on it"
    )

# What one answer cost, from the four counts the API reported: the prompt is
# the uncached input, the cache read and the cache write together.
function cost(model: str, input: i64, output: i64, cache_read: i64, cache_write: i64) -> i64?
    p = price_of(model: model, prompt_tokens: input + cache_read + cache_write)?
    return ok(input * p.input + output * p.output + cache_read * p.cache_read + cache_write * p.cache_write)

# The most a request of `prompt_bytes` bytes can cost on `model`: every byte a
# token written to cache, and the answer at `max_tokens`.
function worst(model: str, prompt_bytes: i64, max_tokens: i64) -> i64?
    bound = prompt_bytes + SLACK
    p = price_of(model: model, prompt_tokens: bound)?
    return ok(bound * p.cache_write + max_tokens * p.output)

# Why the next request may not be sent under a cap of `max_dollars`, or "":
# what was spent and the most the next can cost, together over the cap.
function over_cap(spent: i64, next: i64, max_dollars: i64) -> str
    if max_dollars <= 0 || spent + next <= max_dollars * NANOS_PER_DOLLAR
        return ""
    return "the cap of $" + max_dollars.to_str() + " would be passed: $" + dollars(spent) + " spent, and the next request may cost up to $" + dollars(next) + " (its answer at max_tokens, every prompt byte a token written to cache)"

# Nano-dollars as dollars and cents, a part of a cent rounded up, so what is
# said spent is never less than what was.
function dollars(nanos: i64) -> str
    cents = (nanos + 9999999) / 10000000
    part = cents % 100

    if part < 10
        return (cents / 100).to_str() + ".0" + part.to_str()
    return (cents / 100).to_str() + "." + part.to_str()

test "an answer's cost is its four counts at its model's prices, Haiku's dearer rate above 100K tokens of prompt"
    assert cost(model: "claude-opus-5-5", input: 1000, output: 2000, cache_read: 10000, cache_write: 0).must() == 46000000
    assert cost(model: "claude-sonnet-5-5", input: 500, output: 3000, cache_read: 0, cache_write: 12000).must() == 61000000
    assert cost(model: "claude-haiku-5-5", input: 200, output: 1000, cache_read: 10000, cache_write: 0).must() == 620000
    assert cost(model: "claude-haiku-5-5", input: 100000, output: 0, cache_read: 0, cache_write: 0).must() == 10000000
    assert cost(model: "claude-haiku-5-5", input: 100001, output: 0, cache_read: 0, cache_write: 0).must() == 50000500
    assert cost(model: "claude-fable-5-1", input: 0, output: 1000, cache_read: 4000, cache_write: 0).must() == 51000000

test "a model with no price fails by name, and a request's bound prices every byte as a cache write and the answer at max_tokens"
    unknown = cost(model: "gpt-5", input: 1, output: 1, cache_read: 0, cache_write: 0)
    assert unknown.is_err()

    match unknown
        .ok _ => assert false
        .err e =>
            assert e.code == "no_price"
            assert e.msg == "no price is written for `gpt-5` in tests/harness/thesis_price.hero, so a cap in dollars cannot be kept on it"

    # 41,000 tokens at $5 and 32,000 at $20 a million: $0.205 and $0.64.
    assert worst(model: "claude-opus-5-5", prompt_bytes: 40000, max_tokens: 32000).must() == 845000000
    assert worst(model: "claude-haiku-5-5", prompt_bytes: 99000, max_tokens: 0).must() == 100000 * 125
    assert worst(model: "claude-haiku-5-5", prompt_bytes: 99001, max_tokens: 0).must() == 100001 * 625

test "the cap stops a request whose bound would pass it, and dollars round a part of a cent up"
    assert over_cap(spent: 19000000000, next: 845000000, max_dollars: 20) == ""
    assert over_cap(spent: 19155000000, next: 845000000, max_dollars: 20) == ""
    assert over_cap(spent: 19155000001, next: 845000000, max_dollars: 20) == "the cap of $20 would be passed: $19.16 spent, and the next request may cost up to $0.85 (its answer at max_tokens, every prompt byte a token written to cache)"
    assert over_cap(spent: 500000000000, next: 845000000, max_dollars: 0) == ""
    assert dollars(0) == "0.00"
    assert dollars(1) == "0.01"
    assert dollars(46000000) == "0.05"
    assert dollars(10000000) == "0.01"
    assert dollars(20000000000) == "20.00"
    assert dollars(1234500000000) == "1234.50"
