# THE ISSUES OF `heroes-lang/heroes`, WRITTEN AND READ, a second root of the
# harness:
#
#     heroes run tests/harness/issues.hero -- draft <draft.md>
#     heroes run tests/harness/issues.hero -- file <draft.md>
#     heroes run tests/harness/issues.hero -- close <number> <closing.md>
#     heroes run tests/harness/issues.hero -- comment <number> <text.md>
#     heroes run tests/harness/issues.hero -- edit <number> <draft.md>
#     heroes run tests/harness/issues.hero -- open [--kind <k>] [--milestone M-<name>] [--class <c>] [--json]
#     heroes run tests/harness/issues.hero -- link [--dry-run]
#
# from the repository's root, always. **Since the author's seven answers of
# 2026-10-12 the issues live on GitHub alone** (the decision
# https://github.com/heroes-lang/heroes/issues/2027,
# filed after the transcription), and these seven words are how a session
# writes and reads them; opening, commenting on, closing and correcting an
# issue through them is asked once, by that answer (CLAUDE.md § Hard stops),
# so they take no `--yes`, and no hook sees a write a program `gh` is spawned
# from makes (the last bullet of layer 1 in `.claude/rules/verification.md` §
# A suite is the last judge): the guard is what each refuses before any write.
#
# - `draft` checks a draft as `file` does before its first request and prints
#   the issue `file` would open, asking GitHub nothing, so a lane reads its
#   issue before it is public.
# - `file` opens the issue of a draft a lane wrote outside the tree in the
#   card's shape (`issue_draft.hero`, `issue_write.filed`): refused, with every
#   reason, where the card reader or the rendering rule refuses it, where
#   GitHub lacks a milestone or a label it names, or where its card's `filed`
#   is not the day GitHub dates it; then `POST /repos/heroes-lang/heroes/issues`,
#   the address printed on stdout the moment the issue exists, a defect's title
#   numbered `Defect <number>: ` by its own issue, a decision taken (its item
#   ticked, its card naming the commit that applies it) closed `completed` with
#   its settling comment, and the issue read back; **the draft is removed only
#   once its issue reads back whole** (exit 0), so no copy of an issue stands
#   beside it, and a draft whose run stopped anywhere stays for the rerun,
#   which opens no second issue.
# - `close` appends a closing text to the issue's body under a defect's
#   `## The repair` or every other kind's `## What was done` (the text opening
#   with that heading, or with none, which then takes it), its last line the
#   commit, bare; posts `Fixed by` or `Settled by` and the commit; and closes
#   the issue `completed`.
# - `comment` posts one comment; `edit` makes an OPEN issue's title, body,
#   labels and milestone a corrected draft's (`issue_repair.owed`), a closed
#   issue being a record corrected underneath, by `comment`. Each prints the
#   address it wrote.
# - `open` prints the open issues, one line each or JSON (`issue_open.hero`),
#   and writes nothing: the skills' reader of the lists.
# - `link` is the transcription's second pass (panel 212's R9 item 6,
#   `issue_links.hero`): every `defect NNN` and `panel NNN` a body names made a
#   link to the one issue that answers it, each body written by one `PATCH`
#   and read back; `--dry-run` prints what it would write and writes nothing.
#
# **The transcription's six words left with the folder** on 2026-10-12:
# `render`, `plan`, `push`, `repair`, `prepare` and `finish` imported issues 1
# to 2,029 from the files of `issues/` in the order of their names and kept
# each issue its file's (panel 212), and with the files gone they had
# nothing to read. Their last state, and the modules only they used, are the
# tree of the commit `ISSUES_ARCHIVED_AT` names
# (`tests/harness/suite_records.hero`).
#
# Panel 212's R1, ratified 2026-10-11, made this a program of the harness and no
# verb of `heroes`, the author reading a Heroes program run with `heroes run` as
# no script (CLAUDE.md § 10); `.claude/rules/records.md` § The issues is the
# rule it renders and writes by. Every request to GitHub goes through `gh`
# (`issue_wire.hero`), which holds the token; this program never reads it.
#
# Exit (R11): 0 clean; 1 the input has diagnostics: a draft or a closing text
# refused, a milestone or a label a write names and GitHub lacks, or an issue
# GitHub still holds otherwise after a write, each told on stderr;
# 2 the program could not run: an argument it does not take, a refusal of a
# guard, git or `gh` that could not answer, or a request GitHub refused that
# waiting does not answer.

use cards
use issue_args
use issue_draft
use issue_git
use issue_github
use issue_links
use issue_open
use issue_pace
use issue_safe
use issue_wire
use issue_write
use records_github
use shell
use strings

extern "hero_os.h"
    function hero_write_err(text: str)

constant SCRATCH: str
    "build/issues"

function main()
    given = args()

    if given.len() == 0 || !issue_args.among(word: given[0], words: issue_args.WORDS)
        told(issue_args.refusal(given))
        exit(code: 2)
    asked = issue_args.parsed(word: given[0], words: given.slice(from: 1, to: given.len()))

    if asked.wrong != ""
        told(asked.wrong)
        exit(code: 2)
    scratch = SCRATCH + "-" + shell.pid().to_str()
    code: i64 @= 0

    if asked.word == "draft"
        code @ previewed(scratch: scratch, asked: asked)
    else if asked.word == "file" || asked.word == "edit"
        code @ drafting(scratch: scratch, asked: asked)
    else if asked.word == "close" || asked.word == "comment"
        code @ answering(scratch: scratch, asked: asked)
    else if asked.word == "link"
        code @ linked_all(scratch: scratch, asked: asked)
    else
        code @ listing(scratch: scratch, asked: asked)
    _ = shell.remove_tree(scratch).is_err()
    exit(code: code)

# A session on the real transport, its lines printed as they are said.
function live(scratch: str) -> issue_pace.Session
    return issue_pace.session(transport: issue_wire.gh(), world: issue_wire.world_at(scratch), live: true)

# What a draft is held to in the tree: every path git tracks, which a sitting's
# file is asked of, and each milestone of § The chain to whether its row is
# open.
record Tree
    known: {str: bool}
    chain: {str: bool}

function tree_of(scratch: str) -> Tree?
    walked = shell.project_files(scratch)

    if walked.is_err()
        return fail(code: "git", msg: "git could not say which files the tree holds: " + issue_github_failure(walked))
    known: {str: bool} @= {}

    for path in walked.must()
        known[path] @ true

    roadmap = read_file("ROADMAP.md")
    chain: {str: bool}? @= fail(code: "unread", msg: "ROADMAP.md cannot be read")

    if !roadmap.is_err()
        chain @ cards.chain_states(roadmap.must())

    if chain.is_err()
        return fail(
            code: "chain",
            msg: "the chain a draft's milestone is held to cannot be read: " + issue_github_failure(chain)
        )
    return ok(Tree(known: known, chain: chain.must()))

# `draft`: the draft read and checked as `file` checks it before its first
# request, and the issue it would open printed (`issue_draft.preview`), so a
# lane reads its issue before it is public; GitHub is asked nothing and
# nothing is written. Exit 1 where the draft is refused, each reason told.
function previewed(scratch: str, asked: issue_args.Asked) -> i64
    tree = tree_of(scratch)

    if tree.is_err()
        told(issue_github_failure(tree))
        return 2
    path = asked.paths[0]
    draft = issue_draft.drafted(
        scratch: scratch,
        path: path,
        known: tree.must().known,
        chain: tree.must().chain,
        numbered: ""
    )

    if draft.is_err()
        told(issue_github_failure(draft))
        return 2

    for one in draft.must().refused
        told(path + ": " + one)

    print(issue_draft.preview(draft.must()))

    if draft.must().refused.len() > 0
        return 1
    return 0

# `link`: the second pass (`issue_links.hero`), the sittings read from the
# tree's paths and each one's file linked at the commit `origin/main` names, as
# this clone last fetched it, so every link points at a file GitHub holds.
function linked_all(scratch: str, asked: issue_args.Asked) -> i64
    walked = shell.project_files(scratch)

    if walked.is_err()
        told("git could not say which files the tree holds: " + issue_github_failure(walked))
        return 2
    pin = issue_git.pinned(scratch: scratch, pin: "origin/main")

    if pin.is_err()
        told("origin/main names no commit this clone holds: " + issue_github_failure(pin))
        return 2
    s: issue_pace.Session @= live(scratch)
    return issue_links.linking(
        @s,
        write: !asked.dry,
        sittings: issue_links.sittings_of(walked.must()),
        pin: pin.must()
    )

# `file` and `edit`: the draft read, checked and rendered (`issue_draft`), and
# its issue opened or made to match it (`issue_write`). An old defect `edit`
# corrects keeps the number its title holds.
function drafting(scratch: str, asked: issue_args.Asked) -> i64
    tree = tree_of(scratch)

    if tree.is_err()
        told(issue_github_failure(tree))
        return 2
    s: issue_pace.Session @= live(scratch)
    numbered: str @= ""

    if asked.word == "edit"
        held = issue_github.issue(@s, number: asked.number)

        if held.is_err()
            told("GitHub could not be read: " + issue_github_failure(held))
            return 2
        old: [str] @= []

        for n in records_github.title_numbers(held.must().title)
            if n <= records_github.OLD_LAST && n != asked.number
                old @ old.push(records_github.padded(n))

        numbered @ old.join(" ")
    path = asked.paths[0]
    draft = issue_draft.drafted(
        scratch: scratch,
        path: path,
        known: tree.must().known,
        chain: tree.must().chain,
        numbered: numbered
    )

    if draft.is_err()
        told(issue_github_failure(draft))
        return 2

    if asked.word == "edit"
        return issue_write.edited(@s, number: asked.number, draft: draft.must())
    code = issue_write.filed(@s, draft: draft.must())

    # Its issue read back whole, the draft goes, so no copy of an issue stands
    # beside it; one the program cannot remove is told, the issue standing.
    if code == 0
        if shell.is_directory(path) || shell.remove_tree(path).is_err()
            told("the issue stands, read back whole, and its draft " + path + " could not be removed: remove it")
        else
            told("removed the draft " + path)
    return code

# `close` and `comment`: the text read, the commits it names asked of git, and
# the issue written (`issue_write`).
function answering(scratch: str, asked: issue_args.Asked) -> i64
    text = read_file(asked.paths[0])

    if text.is_err()
        told("cannot read " + asked.paths[0])
        return 2
    words: [str] @= issue_safe.hash_words(text.must())

    for word in issue_safe.bare_hash_words(text.must())
        words @ words.push(word)

    for row in strings.lines(text.must())
        if cards.is_full_hash(strings.trimmed(row))
            words @ words.push(strings.trimmed(row))

    commits = issue_git.commits_among(scratch: scratch, words: words)

    if commits.is_err()
        told("git could not say which words name a commit: " + issue_github_failure(commits))
        return 2
    s: issue_pace.Session @= live(scratch)

    if asked.word == "close"
        return issue_write.closed_with(@s, number: asked.number, given: text.must(), commits: commits.must())
    return issue_write.commented(@s, number: asked.number, given: text.must(), commits: commits.must())

# `open`: the open issues GitHub holds, read and printed (`issue_open`).
function listing(scratch: str, asked: issue_args.Asked) -> i64
    s: issue_pace.Session @= live(scratch)
    return issue_open.opened(
        @s,
        wanted: issue_open.Narrowed(kind: asked.kind, milestone: asked.milestone, grade: asked.grade),
        json: asked.json
    )

function issue_github_failure<T>(result: T?) -> str
    return match result
        .ok _  => ""
        .err e => e.msg

function told(text: str)
    hero_write_err(text: "issues: " + text + "\n")
