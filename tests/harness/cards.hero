# THE CARD AN ISSUE FILE OPENS WITH, AND THE READINGS IT IS HELD TO.
#
# Since 2026-10-04 every item this project tracks is one file under `issues/`,
# one file for one GitHub issue (the author's instruction of that day, meant as:
# *everything goes into a top-level issues folder, it is more orderly; change
# the rules, toward a final definition*). The rules are
# `.claude/rules/records.md` § The issues, their one home; this module is what
# reads them, and `suite_records.hero`'s `records/cards` is what judges a tree
# with it.
#
# **A card is eight lines and a blank one**, so the item a file always held
# starts on line 10:
#
#     ---
#     kind: defect
#     area: ir
#     milestone: none
#     filed: 2026-10-03
#     commit: none
#     github: none
#     ---
#
# GitHub shows such a block as a table at the top of the file, which is the one
# reason it is YAML-shaped; nothing here parses YAML. Each value is a bare word
# from a list below, a day, a commit or an address, so a line is read as
# `<field>: <value>` to its end and nothing else is allowed on it.
#
# **No path is written in this module**, deliberately: the trees are
# `suite_records.hero`'s, where `.claude/rules/verification.md`'s map command
# finds the paths each suite reads. What reads a file's name or its tree hands
# this module the text and asks.

use strings

constant FENCE: str
    "---"

# The fields in the order a card writes them. The order is the rule, so that
# two cards always differ where their values do and never where somebody's
# habit did.
constant FIELDS: [str]
    [
        "kind"
        "area"
        "milestone"
        "filed"
        "commit"
        "github"
    ]

# Eight lines and the blank one under them.
constant CARD_LINES: i64
    9

# What an issue IS. A defect is a measured failure; a decision a question with
# the default it leaves running, a sitting's ratification, or a decision taken,
# which is an issue closed the day it is filed; a feature changes what a Heroes
# program or the `heroes` command does for somebody writing programs; a task
# serves the project, its instruments, records, platforms and site; a learn
# item is a question of comprehension.
constant KINDS: [str]
    [
        "defect"
        "decision"
        "feature"
        "task"
        "learn"
    ]

# WHERE IN THE TREE AN ISSUE IS ABOUT, enumerated from the tree on 2026-10-04:
# the eleven directories of `selfhost/`, `compiler` for a module at its top,
# and the project's other top-level directories, `tests/` split in two. It is a
# premise about the world, so `records/cards` holds it to the tree each run:
# a directory of `selfhost/` this list does not name is a failure, not a file
# filed under nothing.
constant AREAS: [str]
    [
        "check"
        "cli"
        "emit"
        "ir"
        "measure"
        "module"
        "mutate"
        "parse"
        "print"
        "probe"
        "resolve"
        "compiler"
        "runtime"
        "seed"
        "harness"
        "golden"
        "examples"
        "spec"
        "design"
        "records"
        "process"
        "site"
        "ci"
        "editors"
        "tools"
        "archive"
        "vendor"
    ]

# The one repository an issue's address may name. A card holds the address of
# the issue it became, or `none` until it is written there.
constant ISSUE_URL: str
    "https://github.com/heroes-lang/heroes/issues/"

# AN ISSUE FILE AS READ: its path and its name, its card, the text below the
# card and the line that text starts on, and whether it is OPEN, which is
# whether that text holds an item line still unticked. The state has no field
# of its own because it has a home already, the item's box (CL-032): a file
# whose every item is ticked is closed, and so is a decision recorded as taken,
# which holds no box at all.
record Issue
    path: str
    name: str
    card: Card
    body: str
    first: i64
    open: bool

function issue_of(path: str, text: str) -> Issue
    found = read_card(text)
    below = strip_card(text)

    return Issue(
        path: path,
        name: strings.base_name(path),
        card: found,
        body: below,
        first: found.consumed + 1,
        open: holds_open_item(below)
    )

function holds_open_item(text: str) -> bool
    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "- [ ] ")
            return true

    return false

# A card as read: the six values, empty unless `complaints` is, and how many
# lines `strip_card` takes off, decided by the SHAPE alone so that a card with a
# wrong value is still taken off and the item under it is judged as the item.
record Card
    kind: str
    area: str
    milestone: str
    filed: str
    commit: str
    github: str
    consumed: i64
    complaints: [str]

function empty_card(consumed: i64, complaints: [str]) -> Card
    return Card(
        kind: "",
        area: "",
        milestone: "",
        filed: "",
        commit: "",
        github: "",
        consumed: consumed,
        complaints: complaints
    )

# The card at the top of `text`, or why there is none this can read.
function read_card(text: str) -> Card
    rows = strings.lines(text)

    if rows.len() == 0 || rows[0] != FENCE
        opening: str @ "nothing"

        if rows.len() > 0
            opening @ "`" + shown(rows[0]) + "`"

        return empty_card(
            consumed: 0,
            complaints: ["line 1 is " + opening + ", and an issue file opens with its card, " + template()]
        )
    close: i64 @ 1

    while close < rows.len() && close <= FIELDS.len() + 1 && rows[close] != FENCE
        close @ close + 1

    if close >= rows.len() || rows[close] != FENCE
        return empty_card(
            consumed: 0,
            complaints: ["line 1 opens a card that no `---` closes within " + (FIELDS.len() + 2).to_str() + " lines, " + template()]
        )
    consumed: i64 @ close + 1
    complaints: [str] @ []

    if consumed < rows.len() && rows[consumed] == ""
        consumed @ consumed + 1
    else
        complaints @ complaints.push(
            "line " + (close + 2).to_str() + " is not blank, and one blank line separates the card from the item"
        )

    if close != FIELDS.len() + 1
        complaints @ complaints.push(
            "the card holds " + (close - 1).to_str() + " lines between its fences, and it holds " + FIELDS.len().to_str() + ", one per field: " + FIELDS.join(", ")
        )
        return empty_card(consumed: consumed, complaints: complaints)
    values: [str] @ []
    i: i64 @ 0

    while i < FIELDS.len()
        value = field_value(row: rows[i + 1], field: FIELDS[i])

        if value.is_err()
            complaints @ complaints.push("line " + (i + 2).to_str() + ": " + failure_of(value))
            values @ values.push("")
        else
            values @ values.push(value.must())
        i @ i + 1

    if complaints.len() > 0
        return empty_card(consumed: consumed, complaints: complaints)

    for complaint in value_offences(values)
        complaints @ complaints.push(complaint)

    if complaints.len() > 0
        return empty_card(consumed: consumed, complaints: complaints)
    none: [str] = []

    return Card(
        kind: values[0],
        area: values[1],
        milestone: values[2],
        filed: values[3],
        commit: values[4],
        github: values[5],
        consumed: consumed,
        complaints: none
    )

# `<field>: <value>`, the value a bare word: nothing before the field's name,
# one space after the colon, nothing quoted and nothing trailing.
function field_value(row: str, field: str) -> str?
    opening = field + ": "

    if !strings.starts_with(text: row, prefix: opening)
        return fail(
            code: "shape",
            msg: "`" + shown(row) + "` is not `" + field + ": <value>`, and the fields stand in the order " + FIELDS.join(", ")
        )
    value = strings.without_prefix(text: row, prefix: opening)

    if value.len() == 0 || strings.trimmed(value) != value || strings.contains(text: value, needle: " ")
        return fail(code: "shape", msg: "`" + field + "` holds `" + shown(value) + "`, and a value is one bare word")

    if strings.contains(text: value, needle: "\"") || strings.contains(text: value, needle: "'")
        return fail(code: "shape", msg: "`" + field + "` is quoted, and a value is written bare")

    return ok(value)

# Each value against its own vocabulary, one complaint per value that departs.
function value_offences(values: [str]) -> [str]
    out: [str] @ []

    if !among(word: values[0], words: KINDS)
        out @ out.push("line 2: `kind` is `" + values[0] + "`, and a kind is one of " + told(KINDS))

    if values[1] != "none" && !among(word: values[1], words: AREAS)
        out @ out.push("line 3: `area` is `" + values[1] + "`, and an area is `none` or one of " + told(AREAS))

    if values[2] != "none" && !is_milestone_name(values[2])
        out @ out.push("line 4: `milestone` is `" + values[2] + "`, and a milestone is `none` or a name `M-<words>`")

    if values[3].len() != 10 || day_of(values[3]).is_err()
        out @ out.push("line 5: `filed` is `" + values[3] + "`, and it is the day the issue was filed, YYYY-MM-DD")

    if values[4] != "self" && values[4] != "none" && !is_full_hash(values[4])
        out @ out.push(
            "line 6: `commit` is `" + values[4] + "`, and it is `self`, `none`, or the forty hexadecimal digits of the commit that settled the issue"
        )

    if values[5] != "none" && !is_issue_url(values[5])
        out @ out.push("line 7: `github` is `" + values[5] + "`, and it is `none` or " + ISSUE_URL + "<number>")

    return out

# The text below the card, which is the item exactly as it stood before cards
# existed: every reader of an item asks this first, so a card never moves what
# an item's line numbers mean except by the count `card_lines` gives.
function strip_card(text: str) -> str
    taken = read_card(text).consumed

    if taken == 0
        return text
    rows = strings.split_on(text: text, byte: 10)

    if taken >= rows.len()
        return ""
    kept: [str] @ []
    i: i64 @ taken

    while i < rows.len()
        kept @ kept.push(rows[i])
        i @ i + 1

    return kept.join("\n")

# How many lines the card above an item takes, 0 where there is none.
function card_lines(text: str) -> i64
    return read_card(text).consumed

# A card written out, for a test and for the template a refusal prints.
function card_text(kind: str, area: str, milestone: str, filed: str, commit: str, github: str) -> str
    return FENCE + "\nkind: " + kind + "\narea: " + area + "\nmilestone: " + milestone + "\nfiled: " + filed + "\ncommit: " + commit + "\ngithub: " + github + "\n" + FENCE + "\n\n"

function template() -> str
    return "eight lines and a blank one: `---`, `kind: <" + KINDS.join("|") + ">`, `area: <an area or none>`, `milestone: <a milestone or none>`, `filed: YYYY-MM-DD`, `commit: <self|none|the commit>`, `github: <none or the issue's address>`, `---` (.claude/rules/records.md § The issues)"

# `M-` and words of lowercase letters and digits joined by one `-`, the shape
# `.claude/rules/records.md` § Milestone identifiers gives every name.
function is_milestone_name(name: str) -> bool
    if !strings.starts_with(text: name, prefix: "M-") || name.len() < 3
        return false
    rest = strings.without_prefix(text: name, prefix: "M-")

    if rest[0] == '-' || rest[rest.len() - 1] == '-'
        return false
    i: i64 @ 0

    while i < rest.len()
        byte = rest[i]

        if byte == '-'
            if rest[i + 1] == '-'
                return false
        else if !(byte >= 'a' && byte <= 'z') && !(byte >= '0' && byte <= '9')
            return false
        i @ i + 1

    return true

# Forty lowercase hexadecimal digits: a commit named whole, because a prefix
# that is unique today stops being unique as the history grows, and a record
# that resolved when it was written would stop resolving.
function is_full_hash(text: str) -> bool
    if text.len() != 40
        return false

    return is_hex(text)

function is_hex(text: str) -> bool
    if text.len() == 0
        return false
    i: i64 @ 0

    while i < text.len()
        byte = text[i]

        if !(byte >= '0' && byte <= '9') && !(byte >= 'a' && byte <= 'f')
            return false
        i @ i + 1

    return true

function is_issue_url(text: str) -> bool
    if !strings.starts_with(text: text, prefix: ISSUE_URL)
        return false
    number = strings.without_prefix(text: text, prefix: ISSUE_URL)

    if number.len() == 0 || number[0] == '0'
        return false
    i: i64 @ 0

    while i < number.len()
        if number[i] < '0' || number[i] > '9'
            return false
        i @ i + 1

    return true

# WHAT THE BODY SAYS THAT THE CARD ALSO SAYS. Three of the card's values state
# in a structured line a fact the item states in prose, and records.md makes
# the card that fact's structured home and the prose its account; these are
# the readings `records/cards` holds the two to agree with.

# The first day written YYYY-MM-DD in the paragraph that opens with
# `**Origin:**`, a body line that STARTS with it, or the empty string where the
# body has no such paragraph or it names no day. **A line that starts with it,
# and not the words anywhere** (2026-10-04): a decision that explains the rule
# quotes `**Origin:**` mid-sentence, and fourteen files did, the first read of
# this function taking the day after the quotation for the issue's birth.
function origin_day(body: str) -> str
    rows = strings.lines(body)
    i: i64 @ 0

    while i < rows.len() && !strings.starts_with(text: strings.trimmed(rows[i]), prefix: "**Origin:**")
        i @ i + 1

    if i == rows.len()
        return ""
    paragraph: [str] @ []

    while i < rows.len() && strings.trimmed(rows[i]) != ""
        paragraph @ paragraph.push(rows[i])
        i @ i + 1

    return first_day(paragraph.join("\n"))

# The first YYYY-MM-DD in `text` that is a day of the calendar and stands
# alone, no digit before it or after it.
function first_day(text: str) -> str
    i: i64 @ 0

    while i + 10 <= text.len()
        before_ok = i == 0 || !is_digit_byte(text[i - 1])
        after_ok = i + 10 == text.len() || !is_digit_byte(text[i + 10])

        if before_ok && after_ok && looks_like_day(text: text, at: i)
            # Ten ASCII bytes, so both cuts stand between characters.
            return text.slice(from: i, to: i + 10)
        i @ i + 1

    return ""

function looks_like_day(text: str, at: i64) -> bool
    j: i64 @ 0

    while j < 10
        byte = text[at + j]

        if j == 4 || j == 7
            if byte != '-'
                return false
        else if !is_digit_byte(byte)
            return false
        j @ j + 1

    # Ten ASCII bytes were just read, so the cut stands between characters.
    return !day_of(text.slice(from: at, to: at + 10)).is_err()

function is_digit_byte(byte: u8) -> bool
    return byte >= '0' && byte <= '9'

# The commits a body says repaired it, as `Repaired at \`<hash>\`` writes each,
# in the order written: the one sentence `.claude/rules/verification.md` § The
# batch gives a repair, so the one this reads.
function repaired_hashes(body: str) -> [str]
    out: [str] @ []
    pieces = strings.split_text(text: body, separator: "Repaired at `")
    i: i64 @ 1

    while i < pieces.len()
        close = strings.index_of(text: pieces[i], needle: "`")

        if !close.is_err()
            # The backtick is ASCII, so the cut stands between characters.
            hash = pieces[i].slice(from: 0, to: close.must())

            if hash.len() >= 7 && is_hex(hash)
                out @ out.push(hash)
        i @ i + 1

    return out

# The milestone an item's line names as its first field, `**M-<name>`, read to
# the first byte a name does not hold; the empty string where the first field
# opens with no milestone.
function first_field_milestone(line: str) -> str
    opening: str @ ""

    if strings.starts_with(text: line, prefix: "- [ ] **M-")
        opening @ "- [ ] **"

    if strings.starts_with(text: line, prefix: "- [x] **M-")
        opening @ "- [x] **"

    if opening == ""
        return ""
    rest = strings.without_prefix(text: line, prefix: opening)
    end: i64 @ 2

    while end < rest.len() && (rest[end] >= 'a' && rest[end] <= 'z' || rest[end] >= '0' && rest[end] <= '9' || rest[end] == '-')
        end @ end + 1

    # Every byte read was ASCII, so the cut stands between characters.
    name = rest.slice(from: 0, to: end)

    if !is_milestone_name(name)
        return ""

    return name

# A DAY WRITTEN YYYY-MM-DD, as the number YYYYMMDD, so that two days compare as
# numbers do (spec § 7 Operators: `<` takes a number only). Moved here from
# `suite_records.hero` on 2026-10-04, where the class rule was its only reader:
# a card's `filed` is the second, and one reading of a day is one place for it
# to be wrong. The ten bytes are read by index and never sliced, so a character
# of several bytes among them is a refusal rather than an abort, and an
# eleventh digit is refused, or `2026-10-021` would read as the second of
# October.
function day_of(text: str) -> i64?
    wrong = "`" + shown(text) + "` does not open with a day written YYYY-MM-DD"

    if text.len() < 10
        return fail(code: "shape", msg: wrong)
    digits: i64 @ 0
    i: i64 @ 0

    while i < 10
        byte = text[i]

        if i == 4 || i == 7
            if byte != '-'
                return fail(code: "shape", msg: wrong)
        else if byte < '0' || byte > '9'
            return fail(code: "shape", msg: wrong)
        else
            digits @ digits * 10 + (byte - '0').to_i64().must()
        i @ i + 1

    if text.len() > 10 && text[10] >= '0' && text[10] <= '9'
        return fail(code: "shape", msg: wrong)
    year = digits / 10000
    month = digits / 100 % 100
    day = digits % 100

    if month < 1 || month > 12 || day < 1 || day > days_in(year: year, month: month)
        return fail(code: "shape", msg: "`" + shown(text) + "` names no day of the calendar")

    return ok(digits)

function days_in(year: i64, month: i64) -> i64
    if month == 2
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
            return 29
        return 28

    if month == 4 || month == 6 || month == 9 || month == 11
        return 30

    return 31

# YYYYMMDD written back as YYYY-MM-DD, for a message.
function day_text(day: i64) -> str
    return (day / 10000).to_str() + "-" + padded_two(day / 100 % 100) + "-" + padded_two(day % 100)

function padded_two(n: i64) -> str
    if n < 10
        return "0" + n.to_str()

    return n.to_str()

# THE AREA A PATH IS IN, the vocabulary above read off a path: a directory of
# `selfhost/` is its own area and a module at its top is `compiler`; the empty
# string for a path no area names, which `records/cards` reports where the path
# is under `selfhost/`, so a new directory there cannot stay unnamed.
function area_of_path(path: str) -> str
    if strings.starts_with(text: path, prefix: "selfhost/")
        rest = strings.without_prefix(text: path, prefix: "selfhost/")
        slash = strings.index_of(text: rest, needle: "/")

        if slash.is_err()
            return "compiler"

        # The slash is ASCII, so the cut stands between characters.
        directory = rest.slice(from: 0, to: slash.must())

        if among(word: directory, words: AREAS)
            return directory

        return ""

    for pair in HEADS
        cut = strings.index_of(text: pair, needle: " ")

        # Every row holds one space, between two ASCII words.
        head = pair.slice(from: 0, to: cut.must())

        if strings.starts_with(text: path, prefix: head)
            return pair.slice(from: cut.must() + 1, to: pair.len())

    return ""

# A head of the tree and the area it is, in the order a longer head must be
# asked before a shorter one that opens it.
constant HEADS: [str]
    [
        "runtime/ runtime"
        "seed/ seed"
        "tests/harness/ harness"
        "tests/golden/ golden"
        "tests/emission/ golden"
        "examples/ examples"
        "spec/ spec"
        "docs/design/ design"
        "docs/ records"
        "issues/ records"
        ".claude/ process"
        "CLAUDE.md process"
        "site/ site"
        ".github/ ci"
        "editors/ editors"
        "tools/ tools"
        "archive/ archive"
        "vendor/ vendor"
    ]

function among(word: str, words: [str]) -> bool
    for one in words
        if one == word
            return true

    return false

function told(words: [str]) -> str
    return "`" + words.join("`, `") + "`"

# Enough of a line to recognise it, cut where a character starts.
function shown(row: str) -> str
    if row.len() <= 60
        return row

    return row.slice(from: 0, to: strings.boundary_at_or_below(text: row, at: 60)) + " …"

# A test's way to ask the vocabulary of six values without writing a card.
function offences_of(kind: str, area: str, milestone: str, filed: str, commit: str, github: str) -> [str]
    return value_offences([kind, area, milestone, filed, commit, github])

function failure_of<T>(got: T?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

test "a whole card is read into its six values, and the item under it is what was there before"
    item = "- [ ] **231 — a title** | what | where · **class: blocking**\n\n    **Origin:** lane x, 2026-10-03.\n"
    text = card_text(kind: "defect", area: "ir", milestone: "none", filed: "2026-10-03", commit: "none", github: "none") + item
    got = read_card(text)
    assert got.complaints.len() == 0
    assert got.kind == "defect"
    assert got.area == "ir"
    assert got.milestone == "none"
    assert got.filed == "2026-10-03"
    assert got.commit == "none"
    assert got.github == "none"
    assert got.consumed == CARD_LINES
    assert card_lines(text) == 9
    assert strip_card(text) == item

test "a file with no card is refused with the card to write, and stripping it changes nothing"
    item = "- [ ] **231 — a title** | what | where · **class: blocking**\n"
    got = read_card(item)
    assert got.complaints.len() == 1
    assert strings.contains(text: got.complaints[0], needle: "line 1 is")
    assert strings.contains(text: got.complaints[0], needle: "`filed: YYYY-MM-DD`")
    assert got.consumed == 0
    assert strip_card(item) == item
    assert read_card("").complaints.len() == 1

test "every line of a card is held to its place"
    good = card_text(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "self", github: "none")

    # The fields out of order.
    swapped = "---\narea: none\nkind: task\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\n\nx\n"
    assert strings.contains(text: read_card(swapped).complaints[0], needle: "line 2:")
    assert read_card(swapped).consumed == 9

    # A quoted value, a trailing space, two words, nothing.
    assert strings.contains(
        text: read_card("---\nkind: \"task\"\narea: none\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\n\nx\n").complaints[0],
        needle: "quoted"
    )
    assert read_card("---\nkind: task \narea: none\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\n\nx\n").complaints.len() == 1
    assert read_card("---\nkind: task\narea: two words\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\n\nx\n").complaints.len() == 1
    assert read_card("---\nkind: \narea: none\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\n\nx\n").complaints.len() == 1

    # A field missing, so the fence closes early; one too many; no fence at all.
    short = "---\nkind: task\narea: none\nmilestone: none\nfiled: 2026-10-04\ncommit: self\n---\n\nx\n"
    assert strings.contains(text: read_card(short).complaints[0], needle: "holds 5 lines")
    assert strip_card(short) == "x\n"
    assert strings.contains(text: read_card("---\nkind: task\nx\n").complaints[0], needle: "no `---` closes")

    # The blank line under the card is owed, and the card is still taken off.
    tight = "---\nkind: task\narea: none\nmilestone: none\nfiled: 2026-10-04\ncommit: self\ngithub: none\n---\nx\n"
    assert strings.contains(text: read_card(tight).complaints[0], needle: "line 9 is not blank")
    assert strip_card(tight) == "x\n"
    assert read_card(good + "x\n").complaints.len() == 0

test "every value is held to its vocabulary"
    assert offences_of(kind: "bug", area: "none", milestone: "none", filed: "2026-10-04", commit: "none", github: "none")[0] == "line 2: `kind` is `bug`, and a kind is one of `defect`, `decision`, `feature`, `task`, `learn`"
    assert offences_of(kind: "task", area: "parser", milestone: "none", filed: "2026-10-04", commit: "none", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "m-x", filed: "2026-10-04", commit: "none", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "M-Upper", filed: "2026-10-04", commit: "none", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "M-ir-lowering", filed: "2026-10-04", commit: "none", github: "none").len() == 0
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-02-30", commit: "none", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "5ba5296c", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "5ba5296c0123456789abcdef0123456789abcdef", github: "none").len() == 0
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "5BA5296C0123456789ABCDEF0123456789ABCDEF", github: "none").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "none", github: "https://github.com/heroes-lang/heroes/issues/12").len() == 0
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "none", github: "https://github.com/heroes-lang/heroes/issues/x1").len() == 1
    assert offences_of(kind: "task", area: "none", milestone: "none", filed: "2026-10-04", commit: "none", github: "https://github.com/someone/else/issues/12").len() == 1

test "the body's own readings: the origin's day, the repairs, the first field's milestone"
    body = "- [ ] **M-ir-lowering** | a thing | x\n\n    **Origin:** found on\n    2026-09-03 by a run, filed 2026-09-04.\n\n    Repaired at `5ba5296c`, then Repaired at `c539f58d`.\n"
    assert origin_day(body) == "2026-09-03"
    assert origin_day("- [ ] **x** | y | z\n") == ""
    assert origin_day("- [ ] x\n\n    **Origin:** the author.\n\n    2026-09-01 below\n") == ""

    # The words quoted mid-sentence are not the paragraph: a decision explaining
    # the rule names `**Origin:**` and a day after it that is not its birth.
    assert origin_day("# A rule\n\nThe day the `**Origin:**` names, since 2026-09-12.\n") == ""
    assert origin_day("# A rule\n\nThe `**Origin:**` words.\n\n    **Origin:** a lane, 2026-10-01.\n") == "2026-10-01"
    assert repaired_hashes(body) == ["5ba5296c", "c539f58d"]
    assert repaired_hashes("Repaired at `not a hash`").len() == 0
    assert first_field_milestone("- [ ] **M-ir-lowering** | a | b") == "M-ir-lowering"
    assert first_field_milestone("- [x] **M-ir-lowering.1** | a | b") == "M-ir-lowering"
    assert first_field_milestone("- [ ] **231 — x** | a | b") == ""
    assert first_day("on 2026-10-021 and 2026-10-02.") == "2026-10-02"

test "a day is YYYY-MM-DD of the calendar, read without a slice"
    assert day_of("2026-10-02").must() == 20261002
    assert day_of("2026-10-02 (the rule)").must() == 20261002
    assert day_of("2024-02-29").must() == 20240229
    assert day_of("2026-02-29").is_err()
    assert day_of("2026-04-31").is_err()
    assert day_of("2026-10-00").is_err()
    assert day_of("2026-00-10").is_err()
    assert day_of("2026-10-2").is_err()
    assert day_of("2026-10-021").is_err()

    # A character of several bytes where a digit belongs is a refusal, never an
    # abort: the bytes are read by index.
    assert day_of("2026·10-02").is_err()
    assert day_text(20261002) == "2026-10-02"
    assert day_text(20260101) == "2026-01-01"

test "an issue is open while an item in it is unticked, and its body is what stands below the card"
    open_one = issue_of(
        path: "x/2026-10-04-0000-defect-231-a.md",
        text: card_text(kind: "defect", area: "ir", milestone: "none", filed: "2026-10-04", commit: "none", github: "none") + "- [ ] **231 — a** | b | c · **class: blocking**\n"
    )
    assert open_one.open
    assert open_one.first == 10
    assert open_one.name == "2026-10-04-0000-defect-231-a.md"
    assert strings.starts_with(text: open_one.body, prefix: "- [ ] **231")
    closed_one = issue_of(path: "x/y.md", text: "- [x] **231 — a** | b | c\n\n- [x] another, ticked\n")
    assert !closed_one.open
    assert closed_one.first == 1
    assert !issue_of(path: "x/z.md", text: "# A decision taken\n\n2026-10-04 | it | because\n").open

test "a path is in the area its head names, and a directory of selfhost/ nobody named is in none"
    assert area_of_path("selfhost/ir/lower.hero") == "ir"
    assert area_of_path("selfhost/lexer.hero") == "compiler"
    assert area_of_path("selfhost/nowhere/x.hero") == ""
    assert area_of_path("tests/harness/cards.hero") == "harness"
    assert area_of_path("tests/emission/x.c") == "golden"
    assert area_of_path("docs/design/design.md") == "design"
    assert area_of_path("docs/panel/190-x.md") == "records"
    assert area_of_path("CLAUDE.md") == "process"
    assert area_of_path("README.md") == ""
