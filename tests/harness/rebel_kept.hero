        Kept(check: "ledgers", key: "errors/connection in llm/anthropic, llm/openai", why: TWO_LLM_CLIENTS)
        Kept(check: "ledgers", key: "errors/status in llm/anthropic, llm/openai", why: TWO_LLM_CLIENTS)
        Kept(check: "ledgers", key: "html/escape in html, template", why: TEMPLATE_MAY_USE_HTML)
        Kept(check: "ledgers", key: "html/unescape in html, template", why: TEMPLATE_MAY_USE_HTML)
        Kept(check: "ledgers", key: "http/client in graphql, jsonrpc", why: TWO_MEANINGS)
        Kept(check: "ledgers", key: "http/server in graphql, jsonrpc", why: TWO_MEANINGS)
        Kept(check: "ledgers", key: "message/values in jsonrpc, protobuf", why: TWO_MEANINGS)
