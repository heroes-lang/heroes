## Tests

test "every kept finding gives its reason, and no finding is kept twice"
    seen: {str: bool} @= {}

    for k in kept()
        assert k.why.len() > 0
        assert seen[k.check + " " + k.key].is_err()
        seen[k.check + " " + k.key] @ true
