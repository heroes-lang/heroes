# The judge of one generated program: the oracles of panel 231, in Heroes
# (M-generated-programs, task 931). The prototype's judge was a shell script
# in a seat's scratch; a judge is an instrument, and an instrument here is a
# program of the harness (CLAUDE.md § 10, *never a script*).
#
# **Oracle 1, read so it cannot lie** (the compiler-engineer's Q5): the
# compiler's answer to a program valid by construction is one of five.
#
#   (a) exit 0: the program is judged by the oracles after it;
#   (b) exit 1: a correct program refused, catalogue shape E, a defect;
#   (c) exit 2 saying *clang died on the C*: clang's limit, designed by panel
#       184's R7, recorded with the program and never a defect by itself;
#   (d) exit 134 saying *stack exhausted in*: the compiler's own depth limit,
#       designed by panel 184's R6 past a floor the specification has yet to
#       state, recorded, a defect only below the floor once it is stated;
#   (e) anything else, `internal error` or `hero_unreachable` anywhere in what
#       it said, a signal, a timeout: the compiler fell over, a defect.
#
# **Oracle 2**, the answer the generator computed, in three configurations:
# the `-O0` binary run by the judge, `run -O2`, and `run --sanitize -O0`,
# where a sanitiser saying a word is a defect of its own (a generated program
# corrupts nothing by construction). The sanitised binary runs twice, every
# byte ASan hands out filled first with 0 and then with 190 (panel 231's R5,
# the ffi-pragmatist's measurement: an uninitialised read printed `5` and
# `-4702111234474983741` under the two), each run held to the answer, so a
# read of a byte nobody wrote moves the output under one fill at least.
# R5 asks it of a program with an `extern`; it is asked of every program,
# since a byte the compiler's own C leaves unwritten is read the same way
# and the second run costs no build. **Oracle 3**, the formatter: its output
# is a fixed point and builds to the same answer, bytes equal where the
# generator already wrote the canonical form (the compiler-engineer's P5:
# 159 of 300 differ only by `fmt`'s 120-column wrap). **Oracle 4** is the
# judge's own `build` of a program `check` accepts, so a refusal at build is
# asked of `check` too, to say which stage refused. **Oracle 5**, a leak of
# the program's own, is the runtime's count at exit, which a silent stderr
# already reads (`expectation.hero`); a leak through C is the C arm's, read
# by LeakSanitizer under `--sanitize -O0` on Linux and by `leaks --atExit`
# on the `-O0` binary on Darwin (`gen_cjudge.leak_free`, task 972).

use expectation
use gen_cjudge
use shell
use strings

variant Verdict
    passed
        declared: bool
        reformatted: bool
    refused
        said: str
    clang_limit
        said: str
    depth_limit
        said: str
    fell
        said: str
    wrong
        where: str
        said: str
    sanitized
        said: str
    leaked
        said: str
    misformatted
        said: str
    header
        said: str

# Seconds the compiler is given for one small program, and the program
# itself; and the bytes a program may write where the platform can hold it
# to them (`.claude/rules/verification.md` § A run that may not end: a
# miscompiled loop must not fill a disk).
constant COMPILE_SECONDS: i64
    120

constant RUN_SECONDS: i64
    20

constant RUN_BYTES: i64
    1048576

# The two fills the sanitised binary runs under, ASan's options handed
# through `env` as `freed_bytes.FILL` is: every block filled at its whole
# length, the largest the option takes in a 32-bit word.
constant FILLS: [str]
    [
        "ASAN_OPTIONS=max_malloc_fill_size=2147483647:malloc_fill_byte=0"
        "ASAN_OPTIONS=max_malloc_fill_size=2147483647:malloc_fill_byte=190"
    ]

# The bounds every child of a judgement runs under, as the C arm's checks
# are handed them.
function bounds() -> gen_cjudge.Bounds
    return gen_cjudge.Bounds(compile: COMPILE_SECONDS, run: RUN_SECONDS, bytes: program_bytes())

# Whether the verdict is a defect to report: every reading but a pass and
# the two limits panel 184 designed.
function is_defect(v: Verdict) -> bool
    match v
        .passed _ | .clang_limit _ | .depth_limit _                                              => return false
        .refused _ | .fell _ | .wrong _ | .sanitized _ | .leaked _ | .misformatted _ | .header _ => return true

# One word for a verdict, the first field of the judge's line.
function word(v: Verdict) -> str
    match v
        .passed p =>
            if p.declared
                return "PASS-declared"
            return "PASS"
        .refused _      => return "REFUSED"
        .clang_limit _  => return "CLANG-LIMIT"
        .depth_limit _  => return "DEPTH-LIMIT"
        .fell _         => return "FELL"
        .wrong w        => return "WRONG" + w.where
        .sanitized _    => return "SANITIZED"
        .leaked _       => return "LEAKED"
        .misformatted _ => return "MISFORMATTED"
        .header _       => return "HEADER"

# What the verdict says beyond its word: the first line that decided it.
function detail(v: Verdict) -> str
    match v
        .passed p =>
            if p.reformatted
                return "fmt re-printed it, to a fixed point with the same answer"
            return ""
        .refused r      => return r.said
        .clang_limit c  => return c.said
        .depth_limit d  => return d.said
        .fell f         => return f.said
        .wrong w        => return w.said
        .sanitized s    => return s.said
        .leaked l       => return l.said
        .misformatted m => return m.said
        .header h       => return h.said

# Oracle 1 over what the compiler said and how it ended: a verdict where it
# did not stand, or `stood` where it did (`run` passes a program's own exit
# through, so the caller asks this only of what the compiler alone decides).
function fallen(ran: shell.Run, stage: str) -> Verdict?
    said = ran.out + ran.err

    if strings.contains(text: said, needle: "internal error") || strings.contains(text: said, needle: "hero_unreachable")
        return ok(.fell(said: stage + ": " + first_line(said)))

    if ran.code == 0
        return fail(code: "stood", msg: "the compiler stood")

    if ran.code == 1
        return ok(.refused(said: stage + ": " + first_line(ran.err)))

    if ran.code == 2 && strings.contains(text: ran.err, needle: "clang died on the C")
        return ok(.clang_limit(said: stage + ": " + first_line(ran.err)))

    if ran.code == 134 && strings.contains(text: ran.err, needle: "stack exhausted in")
        return ok(.depth_limit(said: stage + ": " + first_line(ran.err)))
    return ok(.fell(said: stage + ": exit " + ran.code.to_str() + ", " + first_line(said)))

function first_line(text: str) -> str
    rows = strings.lines(text)

    if rows.len() == 0
        return "(nothing said)"
    return rows[0]

# The first line of `text` holding `needle`, else its first line.
function line_naming(text: str, needle: str) -> str
    for row in strings.lines(text)
        if strings.contains(text: row, needle: needle)
            return row

    return first_line(text)

# The bytes a program may write, where this platform can hold it to them.
function program_bytes() -> i64
    if shell.can_limit_writes()
        return RUN_BYTES
    return 0

# A configuration's run against the expectation: a verdict where it failed.
function missed(want: expectation.Expectation, ran: shell.Run, where: str) -> Verdict?
    if ran.code == 124
        return ok(.wrong(where: where, said: "ran past " + RUN_SECONDS.to_str() + " s, and a generated program ends"))

    # LeakSanitizer first: its report ends `SUMMARY: AddressSanitizer:`, so
    # the general test below would call a leak a corruption. Each says the
    # line that names its sanitiser, since a report opens with a rule of `=`.
    if strings.contains(text: ran.err, needle: "LeakSanitizer")
        return ok(.leaked(said: where + ": " + line_naming(text: ran.err, needle: "LeakSanitizer")))

    if strings.contains(text: ran.err, needle: "AddressSanitizer")
        return ok(.sanitized(said: where + ": " + line_naming(text: ran.err, needle: "AddressSanitizer")))

    if strings.contains(text: ran.err, needle: "runtime error:")
        return ok(.sanitized(said: where + ": " + line_naming(text: ran.err, needle: "runtime error:")))
    unmet = expectation.unmet(want, out: ran.out, err: ran.err, code: ran.code)

    if !unmet.is_err()
        return ok(.wrong(where: where, said: first_line(unmet.must())))
    return fail(code: "met", msg: "the run met its expectation")

# The whole judgement of `source`, whose `.expected` stands beside it, by
# `compiler`, its files written under `work`, which the caller owns.
function judged(compiler: str, source: str, work: str) -> Verdict?
    stem = strings.without_suffix(text: source, suffix: ".hero")
    want = expectation.split(read_file(stem + ".expected")?)?
    declared = want.ending != .silent
    binary = work + "/" + base_name(stem) + shell.exe_suffix()
    driver = read_file(stem + ".driver.c")

    # **A program that binds C has its header proved first** (panel 231's
    # R4): the driver beside it calls every function of its group at fixed
    # operands, built with clang's UBSan stopping at the first report, and
    # what it prints must be what the generator's model computes, so a header
    # the model gets wrong is the generator's and never the compiler's.
    if !driver.is_err()
        proof = gen_cjudge.proved(stem: stem, work: work, bounds: bounds())?

        if proof != ""
            return ok(.header(said: proof))
    built = shell.run_bounded(scratch: work, program: compiler, words: [compiler, "build", source, "-o", binary], seconds: COMPILE_SECONDS, bytes: 0, stdin_path: "")?
    fell = fallen(built, stage: "build")

    if !fell.is_err()
        return ok(stage_named(fell.must(), compiler: compiler, source: source, work: work))
    plain = shell.run_bounded(scratch: work, program: binary, words: [binary], seconds: RUN_SECONDS, bytes: program_bytes(), stdin_path: "")?
    at_o0 = missed(want, ran: plain, where: "-O0")

    if !at_o0.is_err()
        return at_o0

    # Each other configuration is BUILT, never `run`: the bytes a program may
    # write are held to `RUN_BYTES`, and under `run` the compiler that writes
    # the runtime's instrumented objects would be held to them too (measured
    # 2026-10-28: 40 of 40 programs read as `the runtime did not compile`
    # under `run --sanitize -O0` with the ceiling, 0 of 40 by hand).
    level_at: i64 @= 1

    for level in [["-O2"], ["--sanitize", "-O0"]]
        where = " " + level.join(" ")
        leveled = binary + "-" + level_at.to_str() + shell.exe_suffix()
        level_at @ level_at + 1
        words: [str] @= [compiler, "build", source, "-o", leveled]

        for flag in level
            words @ words.push(flag)

        again = shell.run_bounded(scratch: work, program: compiler, words: words, seconds: COMPILE_SECONDS, bytes: 0, stdin_path: "")?
        fell_here = fallen(again, stage: "build" + where)

        if !fell_here.is_err()
            return fell_here

        for words_run in runs_of(level, binary: leveled)
            ran = shell.run_bounded(scratch: work, program: words_run[0], words: words_run, seconds: RUN_SECONDS, bytes: program_bytes(), stdin_path: "")?
            at_level = missed(want, ran: ran, where: where + fill_named(words_run))

            if !at_level.is_err()
                return at_level

    # Oracle 5 at the boundary: a program that ends at exit 0, since one that
    # aborts by design ends before `atexit`, where `leaks` reads.
    if !driver.is_err() && !declared
        leak = gen_cjudge.leak_free(binary: binary, work: work, bounds: bounds())?

        if leak != ""
            return ok(.leaked(said: "leaks --atExit -O0: " + leak))

    if !driver.is_err()
        artifact = gen_cjudge.artifact_agrees(compiler: compiler, source: source, work: work, plain: plain, bounds: bounds())?

        if artifact != ""
            return ok(.wrong(where: " --emit-c", said: artifact))
    return formatted(compiler: compiler, source: source, work: work, plain: plain, declared: declared)

# How a configuration's binary is run: once, or under each of `FILLS`
# where it is the sanitised one.
function runs_of(level: [str], binary: str) -> [[str]]
    sanitised: bool @= false

    for flag in level
        if flag == "--sanitize"
            sanitised @ true

    if !sanitised
        return [[binary]]
    runs: [[str]] @= []

    for fill in FILLS
        runs @ runs.push(["env", fill, binary])

    return runs

# The fill a run was given, for its verdict's place: ` fill 0`, or "".
function fill_named(words: [str]) -> str
    if words.len() < 3 || words[0] != "env"
        return ""
    return " fill " + strings.without_prefix(text: words[1], prefix: "ASAN_OPTIONS=max_malloc_fill_size=2147483647:malloc_fill_byte=")

# Oracle 4's question, asked only where `build` refused: whether `check`
# accepted what `build` refused, which names the stage the defect is in.
function stage_named(v: Verdict, compiler: str, source: str, work: str) -> Verdict
    match v
        .refused r =>
            checked = shell.run_bounded(
                scratch: work,
                program: compiler,
                words: [compiler, "check", source],
                seconds: COMPILE_SECONDS,
                bytes: 0,
                stdin_path: ""
            )

            if !checked.is_err() && checked.must().code == 0
                return .refused(said: r.said + " (and `check` accepts it: oracle 4)")
            return v
        .passed _ | .clang_limit _ | .depth_limit _ | .fell _ | .wrong _ | .sanitized _ | .leaked _ | .misformatted _ | .header _ => return v

# Oracle 3: `fmt`'s output is a fixed point and means what the program meant.
# The formatted copy is written beside the program, where a header its
# `extern` group names stands, never in the work folder.
function formatted(compiler: str, source: str, work: str, plain: shell.Run, declared: bool) -> Verdict?
    original = read_file(source)?
    once = shell.run_bounded(scratch: work, program: compiler, words: [compiler, "fmt", source], seconds: COMPILE_SECONDS, bytes: 0, stdin_path: "")?

    if once.code != 0
        return ok(.misformatted(said: "fmt exited " + once.code.to_str() + ": " + first_line(once.err)))

    if once.out == original
        return ok(.passed(declared: declared, reformatted: false))
    copy = strings.without_suffix(text: source, suffix: ".hero") + "_f.hero"
    write_file(path: copy, text: once.out)?
    twice = shell.run_bounded(scratch: work, program: compiler, words: [compiler, "fmt", copy], seconds: COMPILE_SECONDS, bytes: 0, stdin_path: "")?

    if twice.code != 0 || twice.out != once.out
        return ok(.misformatted(said: "fmt's output is not a fixed point: a second fmt moved it"))
    binary = work + "/" + base_name(strings.without_suffix(text: copy, suffix: ".hero")) + shell.exe_suffix()
    built = shell.run_bounded(scratch: work, program: compiler, words: [compiler, "build", copy, "-o", binary], seconds: COMPILE_SECONDS, bytes: 0, stdin_path: "")?

    if built.code != 0
        return ok(.misformatted(said: "fmt's output does not build: " + first_line(built.err)))
    again = shell.run_bounded(scratch: work, program: binary, words: [binary], seconds: RUN_SECONDS, bytes: program_bytes(), stdin_path: "")?

    if again.code != plain.code || again.out != plain.out
        return ok(
            .misformatted(said: "fmt's output means something else: exit " + again.code.to_str() + " where the program exited " + plain.code.to_str())
        )
    return ok(.passed(declared: declared, reformatted: true))

# The last part of a path, the directory's slashes either way.
function base_name(path: str) -> str
    i: i64 @= path.len()

    while i > 0
        if path[i - 1] == '/' || path[i - 1] == '\\'
            return path.slice(from: i, to: path.len())
        i @ i - 1

    return path

test "oracle 1 tells the five readings apart"
    clang = shell.Run(
        code: 2,
        out: "",
        err: "build stopped: clang died on the C instead of judging it (Illegal instruction: 4), so nothing in it was refused\n",
        started: true,
        why: 0
    )
    deep = shell.Run(code: 134, out: "", err: "panic: stack exhausted in flatten.expr\n", started: true, why: 0)
    inner = shell.Run(
        code: 2,
        out: "",
        err: "internal error: lowering met a shape it does not know\n",
        started: true,
        why: 0
    )
    refusal = shell.Run(
        code: 1,
        out: "",
        err: "error[type_mismatch]: expected `i64`, found `bool`\n",
        started: true,
        why: 0
    )
    stood = shell.Run(code: 0, out: "", err: "", started: true, why: 0)
    assert word(fallen(clang, stage: "build").must()) == "CLANG-LIMIT"
    assert word(fallen(deep, stage: "build").must()) == "DEPTH-LIMIT"
    assert word(fallen(inner, stage: "build").must()) == "FELL"
    assert word(fallen(refusal, stage: "build").must()) == "REFUSED"
    assert fallen(stood, stage: "build").is_err()
    assert !is_defect(fallen(clang, stage: "build").must())
    assert is_defect(fallen(inner, stage: "build").must())

test "a 134 that is not the stack, and a 2 that is not clang, are the compiler falling over"
    other = shell.Run(code: 134, out: "", err: "panic: array index out of range\n", started: true, why: 0)
    two = shell.Run(code: 2, out: "", err: "heroes: cannot read the runtime\n", started: true, why: 0)
    assert word(fallen(other, stage: "build").must()) == "FELL"
    assert word(fallen(two, stage: "build").must()) == "FELL"

test "a run is wrong where it prints otherwise, ends otherwise, or a sanitiser speaks"
    want = expectation.split("3\n").must()
    right = shell.Run(code: 0, out: "3\n", err: "", started: true, why: 0)
    printed = shell.Run(code: 0, out: "4\n", err: "", started: true, why: 0)
    spoke = shell.Run(
        code: 0,
        out: "3\n",
        err: "x.c:1:2: runtime error: signed integer overflow\n",
        started: true,
        why: 0
    )
    hung = shell.Run(code: 124, out: "", err: "", started: true, why: 0)
    lost = shell.Run(
        code: 23,
        out: "3\n",
        err: "\n=================================================================\n==9==ERROR: LeakSanitizer: detected memory leaks\n\nSUMMARY: AddressSanitizer: 6400 byte(s) leaked in 200 allocation(s).\n",
        started: true,
        why: 0
    )
    assert missed(want, ran: right, where: "-O0").is_err()
    assert word(missed(want, ran: lost, where: " --sanitize -O0").must()) == "LEAKED"
    assert detail(missed(want, ran: lost, where: " --sanitize -O0").must()) == " --sanitize -O0: ==9==ERROR: LeakSanitizer: detected memory leaks"
    assert word(missed(want, ran: printed, where: "-O0").must()) == "WRONG-O0"
    assert word(missed(want, ran: spoke, where: " --sanitize -O0").must()) == "SANITIZED"
    assert word(missed(want, ran: hung, where: " -O2").must()) == "WRONG -O2"

test "the sanitised binary runs under both fills, every other once"
    once = runs_of(["-O2"], binary: "b")
    assert once.len() == 1
    assert once[0] == ["b"]
    filled = runs_of(["--sanitize", "-O0"], binary: "b")
    assert filled.len() == 2
    assert filled[0] == ["env", FILLS[0], "b"]
    assert fill_named(filled[1]) == " fill 190"
    assert fill_named(["b"]) == ""

test "the last part of a path"
    assert base_name("build/g/g12") == "g12"
    assert base_name("g12") == "g12"
