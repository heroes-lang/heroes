    assert json_fields.text_at(of: read, name: "template_sha").default("") == template.sha
    assert json_fields.text_at(of: read, name: "layout_sha").default("") == thesis_answer.layout_sha(dialect: "anthropic", layout: "cached")
    assert json_fields.text_at(of: read, name: "layout_sha").default("") != template.sha
    assert json_fields.text_at(of: read, name: "suite_sha").default("") == "1d6a524d"
    assert json_fields.text_at(of: read, name: "sources").default("") == "7792ecfe50a531e8"
    assert strings.contains(text: text, needle: "\"models\":[\"claude-sonnet-5-5\"]")
    assert strings.contains(text: text, needle: "\"arms\":[\"strict\",\"control\"]")
    assert json_fields.text_at(of: read, name: "transport").default("") == "api"
    assert json_fields.text_at(of: read, name: "harness").default("x") == ""
    assert strings.contains(text: text, needle: "\"sha\":\"" + spec.spec_sha + "\"")

# A plan of the tests below: one model, the `none` context, the folder given.
function test_plan(dir: str, out: str, arms: [str]) -> Plan
    return Plan(
        suite_dir: dir,
        models: ["claude-haiku-5-5"],
        arms: arms,
        contexts: ["none"],
        samples: 1,
        turns: 3,
        effort: "low",
        max_tokens: 32000,
        layout: "cached",
        dialect: "anthropic",
        transport: "api",
        harness: "",
        instrument: "",
        base: "https://api.example",
        out: out,
        live: true,
        max_requests: 0,
        max_dollars: 0,
        seconds: 10,
        bytes: 1048576,
        date: "",
        head: "",
        sources: "",
        compiler: "",
        quiet: true
    )

# The assistant's tasks numbered, copied into a suite of the test's own: a
# script answers its tasks in order, so it reads those tasks and no others,
# however many `tests/thesis/` grows to hold.
function suite_of(scratch: str, numbers: [str]) -> str?
    dir = scratch + "/suite"
    shell.mkdir_all(dir)?

    for number in numbers
        copied = shell.run(scratch: scratch, program: "cp", words: ["cp", "-R", "tests/thesis/" + number, dir + "/" + number])?

        if copied.code != 0
            return fail(code: "copy", msg: "cp -R tests/thesis/" + number + " exited " + copied.code.to_str())

    write_file(path: dir + "/LABEL", text: "assistant\n")?
    return ok(dir)

# Five 529s: one request asked past every try.
function overloaded() -> [issue_wire.Reply]
    out: [issue_wire.Reply] @= []

    for _ in range(from: 0, to: 5)
        out @ out.push(issue_wire.answer(status: 529, headers: [], body: ""))

    return out

test "a generation lost past its retries is every arm's transport_error and the run goes on; three in a row stop it before the third is written"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    suite = suite_of(scratch: scratch, numbers: ["01", "02", "03"]).must()
    second = answer_json(text: thesis_grade.as_answer(read_file(path: suite + "/02/reference.hero").must()))
    third = answer_json(text: thesis_grade.as_answer(read_file(path: suite + "/03/reference.hero").must()))
    script: [issue_wire.Reply] @= overloaded()
    script @ script.push(issue_wire.answer(status: 200, headers: [], body: second)).push(
        issue_wire.answer(status: 200, headers: [], body: third)
    )
    tally = run(
        plan: test_plan(dir: suite, out: scratch + "/out", arms: ["strict", "control"]),
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: script),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert tally.lost == 1
    assert tally.stopped == ""
    assert tally.generations == 2

    # The lost request was sent five times, the two answered once each.
    assert tally.attempts == 7
    assert tally.verdicts == 6
    lost: i64 @= 0

    for text in thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/out/samples").must()
        v = thesis_verdict.read_verdict(text).must()

        if v.turns[0].outcome == "transport_error"
            lost @ lost + 1
            assert !v.converged

    assert lost == 2

    down: [issue_wire.Reply] @= []

    for _ in range(from: 0, to: 3)
        for one in overloaded()
            down @ down.push(one)

    stopped = run(
        plan: test_plan(dir: suite, out: scratch + "/down", arms: ["strict"]),
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: down),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert stopped.lost == 3
    assert strings.contains(text: stopped.stopped, needle: "3 requests in a row were lost")
    assert stopped.verdicts == 2
    assert thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/down/samples").must().len() == 2

test "two arms whose history is the same bytes share their second turn: one request, two verdicts"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    _ = shell.mkdir_all(scratch + "/one").is_err()
    copied = shell.run(
        scratch: scratch,
        program: "cp",
        words: ["cp", "-R", "tests/thesis/03", scratch + "/one/01"]
    ).must()
    assert copied.code == 0
    write_file(path: scratch + "/one/LABEL", text: "assistant\n").must()

    # Compiles in both strict arms and fails the visible example the same way,
    # so the feedback, and the whole history, is the same in both.
    wrong = answer_json(text: thesis_grade.as_answer("function main()\n    print(0)\n"))
    right = answer_json(text: thesis_grade.as_answer(read_file(path: "tests/thesis/03/reference.hero").must()))
    script = [
        issue_wire.answer(status: 200, headers: [], body: wrong)
        issue_wire.answer(status: 200, headers: [], body: right)
    ]
    tally = run(
        plan: test_plan(dir: scratch + "/one", out: scratch + "/out", arms: ["strict", "brief"]),
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: script),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert tally.requests == 2
    assert tally.shared == 1
    assert tally.verdicts == 2

    for text in thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/out/samples").must()
        v = thesis_verdict.read_verdict(text).must()
        assert v.green_turn == 2
        assert v.turns[0].outcome == "compiled_wrong"

test "a capped run stops before the request whose bound would pass the cap, and a rerun counts what the stopped one spent"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    suite = suite_of(scratch: scratch, numbers: ["01", "02", "03"]).must()

    # A million tokens out on Haiku is $0.50, and 100 in is a hundred-thousandth of a dollar.
    dear: [str] @= []

    for number in ["01", "02", "03"]
        dear @ dear.push(
            answer_costing(text: thesis_grade.as_answer(read_file(path: suite + "/" + number + "/reference.hero").must()), output: 1000000)
        )

    one: Plan @= test_plan(dir: suite, out: scratch + "/out", arms: ["strict"])
    one.max_dollars @ 1
    first = run(
        plan: one,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: [issue_wire.answer(status: 200, headers: [], body: dear[0]), issue_wire.answer(status: 200, headers: [], body: dear[1]), issue_wire.answer(status: 200, headers: [], body: dear[2])]),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert first.generations == 2
    assert first.verdicts == 2
    assert first.requests == 2
    assert first.attempts == 2
    assert first.spent == 2 * (100 * 100 + 1000000 * 500)
    assert strings.starts_with(
        text: first.stopped,
        prefix: "the cap of $1 would be passed: $1.01 spent, and the next request may cost up to $0."
    )

    # Under the same cap the rerun asks nothing; under $2 it counts the dollar
    # the answers on disk cost and asks the third task alone.
    held = run(
        plan: one,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: []),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert held.generations == 0
    assert held.spent == first.spent
    assert held.stopped != ""
    one.max_dollars @ 2
    rest = run(
        plan: one,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: [issue_wire.answer(status: 200, headers: [], body: dear[2])]),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert rest.generations == 1
    assert rest.stopped == ""
    assert rest.spent == 3 * (100 * 100 + 1000000 * 500)

    # A cap on a model with no price refuses the run before anything is asked.
    unpriced: Plan @= test_plan(dir: suite, out: scratch + "/unpriced", arms: ["strict"])
    unpriced.models @ ["gpt-5"]
    unpriced.max_dollars @ 1
    refused = run(
        plan: unpriced,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: []),
        scratch: scratch,
        compiler: compiler
    )
    assert refused.is_err()
    assert !shell.is_directory(scratch + "/unpriced")

test "a run resumed into its folder holds the protocol it began with: another is refused before anything is asked, and the same keeps the first provenance and notes the resume"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    suite = suite_of(scratch: scratch, numbers: ["03"]).must()
    right = answer_json(text: thesis_grade.as_answer(read_file(path: suite + "/03/reference.hero").must()))
    first: Plan @= test_plan(dir: suite, out: scratch + "/out", arms: ["strict"])
    first.date @ "2026-10-20"
    first.head @ "aaaa"
    began = run(
        plan: first,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: [issue_wire.answer(status: 200, headers: [], body: right)]),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert began.verdicts == 1
    kept = read_file(path: scratch + "/out/provenance.json").must()

    # Five turns where it began with three: the folder's record stands and the
    # run is refused by the field that moved (defect 2180).
    other: Plan @= first
    other.turns @ 5
    refused = run(
        plan: other,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: []),
        scratch: scratch,
        compiler: compiler
    )
    assert read_file(path: scratch + "/out/provenance.json").must() == kept

    match refused
        .ok _  => assert false
        .err e => assert strings.contains(text: e.msg, needle: "`turns`")

    # The same protocol a day later at another commit: the first record stands
    # and the resume is noted beside it.
    later: Plan @= first
    later.date @ "2026-10-21"
    later.head @ "bbbb"
    again = run(
        plan: later,
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: []),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert again.requests == 0
    assert again.verdicts == 0
    assert read_file(path: scratch + "/out/provenance.json").must() == kept
    assert read_file(path: scratch + "/out/resumed.txt").must() == "2026-10-21 bbbb\n"

test "an answer is the asked model's when it names that id or that id dated, and anything else, nothing included, is another's"
    assert substituted(asked: "claude-haiku-5-5", answered: "claude-haiku-5-5") == ""
    assert substituted(asked: "claude-haiku-4-5", answered: "claude-haiku-4-5-20251001") == ""
    assert substituted(asked: "claude-haiku-5-5", answered: "claude-haiku-4-5-20251001") == "asked `claude-haiku-5-5`, answered by `claude-haiku-4-5-20251001`: a row is the asked model's or none, so the run stops before keeping it"

    # A longer id that opens with the asked one is a different model, not a dated one.
    assert substituted(asked: "claude-sonnet-5", answered: "claude-sonnet-5-5") != ""
    assert substituted(asked: "claude-sonnet-5", answered: "claude-sonnet-5-2026101") != ""
    assert strings.contains(text: substituted(asked: "m", answered: ""), needle: "names no model")

test "a run answered by another model than the one it asked stops at that answer and keeps nothing of it"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    suite = suite_of(scratch: scratch, numbers: ["01", "02"]).must()
    first = answer_json(text: thesis_grade.as_answer(read_file(path: suite + "/01/reference.hero").must()))
    other = answered_json(
        text: thesis_grade.as_answer(read_file(path: suite + "/02/reference.hero").must()),
        output: 50,
        model: "claude-haiku-4-5-20251001"
    )
    tally = run(
        plan: test_plan(dir: suite, out: scratch + "/out", arms: ["strict"]),
        transport: issue_wire.scripted(),
        world: issue_wire.world_of(scratch: scratch, script: [issue_wire.answer(status: 200, headers: [], body: first), issue_wire.answer(status: 200, headers: [], body: other)]),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert tally.generations == 1
    assert tally.verdicts == 1
    assert strings.contains(text: tally.stopped, needle: "answered by `claude-haiku-4-5-20251001`")
    assert thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/out/generations").must().len() == 1

# The script's reply as the model the request names: `{{MODEL}}` in its body
# becomes the request's `model`, so a request naming the wrong model is
# answered by it, and defect 2173's rule stops the run (defect 2176).
function echoed_sent(world: issue_wire.World, request: issue_wire.Request) -> issue_wire.Answered
    got = issue_wire.script_sent(world: world, request: request)
    named = json_read.read_json(request.body)
    model: str @= ""

    if !named.is_err()
        model @ json_fields.text_at(of: named.must(), name: "model").default("")
    reply: issue_wire.Reply @= got.reply
    reply.body @ strings.split_text(text: reply.body, separator: "{{MODEL}}").join(model)
    return issue_wire.Answered(world: got.world, reply: reply)

test "every model of a run is asked by its own name at turn 1 and at a later turn, and answers as itself"
    if thesis_sandbox.unrunnable() != ""
        print("SKIP thesis_run: " + thesis_sandbox.unrunnable())
        return

    scratch = shell.own_scratch()
    compiler = shell.some_compiler().must()
    suite = suite_of(scratch: scratch, numbers: ["01"]).must()
    green = answered_json(
        text: thesis_grade.as_answer(read_file(path: suite + "/01/reference.hero").must()),
        output: 50,
        model: "{{MODEL}}"
    )
    refused = answered_json(
        text: "```\nfunction main()\n    unused = 3\n    print(2)\n```\n",
        output: 50,
        model: "{{MODEL}}"
    )
    two: Plan @= test_plan(dir: suite, out: scratch + "/out", arms: ["strict"])
    two.models @ ["claude-haiku-5-5", "claude-sonnet-5-5"]

    # Haiku green at once; Sonnet refused at turn 1, green at turn 2.
    script = [
        issue_wire.answer(status: 200, headers: [], body: green)
        issue_wire.answer(status: 200, headers: [], body: refused)
        issue_wire.answer(status: 200, headers: [], body: green)
    ]
    tally = run(
        plan: two,
        transport: issue_wire.Transport(send: echoed_sent, pause: issue_wire.noted),
        world: issue_wire.world_of(scratch: scratch, script: script),
        scratch: scratch,
        compiler: compiler
    ).must()
    assert tally.stopped == ""
    assert tally.generations == 2
    assert tally.requests == 3
    asked: [str] @= []

    for text in thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/out/generations").must()
        g = thesis_verdict.read_generation(text).must()
        assert g.answered_by == g.model
        asked @ asked.push(g.model)

    assert asked.len() == 2
    assert asked[0] != asked[1]

    for text in thesis_verdict.all_kept(scratch: scratch, dir: scratch + "/out/turns").must()
        assert thesis_verdict.read_generation(text).must().answered_by == "claude-sonnet-5-5"
