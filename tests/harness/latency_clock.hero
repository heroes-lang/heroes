# THE CLOCK'S READING, AND WHAT IS KEPT OF IT (M-latency-ceiling, 2026-10-30).
#
# `/usr/bin/time -p` prints three lines on stderr after the program it ran,
# `real`, `user` and `sys`, each in seconds with two decimals. This module
# reads them and applies the rule of CLAUDE.md § Verification to a set of
# runs: the first is discarded, a run whose `real` stands more than
# `WAITING_ALLOWANCE_MS` above `user` plus `sys` is discarded as waiting on
# something other than its own work, and of what is left the best is the
# number and the spread is the noise. No clock runs here: `latency_runs.hero`
# spawns and this module judges, so that every rule below has a test that
# needs no machine to be still.
#
# Times are milliseconds in an `i64`. `time -p` writes hundredths, a third
# decimal is read where a platform writes one, and nothing here is a float:
# a reading is compared and printed as the integer it was read as.

use strings

record Reading
    real_ms: i64
    user_ms: i64
    sys_ms: i64

# What a clock's runs come to once the rule has been applied: `kept` holds
# the indices of the runs that count, `reasons` one line per run saying what
# became of it, and `best_ms` and `spread_ms` are 0 where nothing was kept,
# which `has_best` says.
record Judged
    runs: [Reading]
    kept: [i64]
    reasons: [str]
    best_ms: i64
    spread_ms: i64

# How far `real` may stand above `user` plus `sys` before the run is read as
# waiting: the 0.1 s task 2279's seven pairs were read by on 2026-10-30, and
# the opening's eighteen runs that day, one of which it discarded.
constant WAITING_ALLOWANCE_MS: i64
    100

# "6.90" -> 6900. Digits, at most one point, at most three decimals and at
# most eight digits before the point; anything else is refused with the text,
# since a number this instrument cannot read is one it must not guess at.
function parse_seconds(text: str) -> i64?
    whole: i64 @= 0
    fraction: i64 @= 0
    decimals: i64 @= 0
    after_point: bool @= false
    digits: i64 @= 0
    i: i64 @= 0

    while i < text.len()
        byte = text[i]

        if byte == 46
            if after_point
                return fail(code: "not_seconds", msg: "`" + text + "` has two points")
            after_point @ true
        else if byte >= 48 && byte <= 57
            digit = (byte - 48).to_i64().must()
            digits @ digits + 1

            if after_point
                if decimals == 3
                    return fail(code: "not_seconds", msg: "`" + text + "` has more than three decimals")
                fraction @ fraction * 10 + digit
                decimals @ decimals + 1
            else
                if whole >= 10000000
                    return fail(code: "not_seconds", msg: "`" + text + "` has more than eight digits before the point")
                whole @ whole * 10 + digit
        else
            return fail(code: "not_seconds", msg: "`" + text + "` is not a number of seconds")
        i @ i + 1

    if digits == 0
        return fail(code: "not_seconds", msg: "`" + text + "` has no digits")

    while decimals < 3
        fraction @ fraction * 10
        decimals @ decimals + 1

    return ok(whole * 1000 + fraction)

# 6900 -> "6.90": seconds with two decimals, as `time -p` printed them, a
# third decimal rounded half up.
function seconds_text(ms: i64) -> str
    hundredths = (ms + 5) / 10
    frac = hundredths % 100
    pad: str @= ""

    if frac < 10
        pad @ "0"
    return (hundredths / 100).to_str() + "." + pad + frac.to_str()

# The reading a capture of stderr holds: the LAST `real`, `user` and `sys`
# lines, since the program timed writes its own lines before them, and a
# capture missing any of the three is no reading.
function reading_in(err: str) -> Reading?
    real: i64 @= -1
    user: i64 @= -1
    sys: i64 @= -1

    for line in strings.lines(err)
        row = strings.trimmed(line)

        if strings.starts_with(text: row, prefix: "real ")
            real @ parse_seconds(strings.trimmed(strings.without_prefix(text: row, prefix: "real ")))?
        else if strings.starts_with(text: row, prefix: "user ")
            user @ parse_seconds(strings.trimmed(strings.without_prefix(text: row, prefix: "user ")))?
        else if strings.starts_with(text: row, prefix: "sys ")
            sys @ parse_seconds(strings.trimmed(strings.without_prefix(text: row, prefix: "sys ")))?

    if real < 0 || user < 0 || sys < 0
        return fail(code: "no_reading", msg: "the capture holds no `real`, `user` and `sys` lines of `time -p`")
    return ok(Reading(real_ms: real, user_ms: user, sys_ms: sys))

# A run that waited: its `real` stands more than the allowance above the
# time its own work took. `user` plus `sys` may exceed `real` where the
# program ran threads, which is not waiting.
function waiting(one: Reading) -> bool
    return one.real_ms - (one.user_ms + one.sys_ms) > WAITING_ALLOWANCE_MS

# The rule applied to runs in the order they were made.
function judged(runs: [Reading]) -> Judged
    kept: [i64] @= []
    reasons: [str] @= []
    i: i64 @= 0

    while i < runs.len()
        one = runs[i]

        if i == 0
            reasons @ reasons.push("discarded, the first")
        else if waiting(one)
            reasons @ reasons.push(
                "discarded, waiting: real " + seconds_text(one.real_ms) + " against user plus sys " + seconds_text(one.user_ms + one.sys_ms)
            )
        else
            reasons @ reasons.push("kept")
            kept @ kept.push(i)
        i @ i + 1

    best: i64 @= 0
    worst: i64 @= 0
    first: bool @= true

    for k in kept
        ms = runs[k].real_ms

        if first || ms < best
            best @ ms

        if first || ms > worst
            worst @ ms
        first @ false

    spread: i64 @= 0

    if kept.len() > 0
        spread @ worst - best
    return Judged(runs: runs, kept: kept, reasons: reasons, best_ms: best, spread_ms: spread)

function has_best(j: Judged) -> bool
    return j.kept.len() > 0

# "6 kept of 7"
function kept_text(j: Judged) -> str
    return j.kept.len().to_str() + " kept of " + j.runs.len().to_str()

# The ledger's cell for the runs kept: "6/7".
function kept_cell(j: Judged) -> str
    return j.kept.len().to_str() + "/" + j.runs.len().to_str()

# One line a reader reads after the runs: the best, the kept and the spread.
function summary(j: Judged) -> str
    if !has_best(j)
        return "no run kept of " + j.runs.len().to_str()
    return "best " + seconds_text(j.best_ms) + " s, " + kept_text(j) + ", spread " + seconds_text(j.spread_ms) + " s"

test "seconds are read to the millisecond and refused where they are not seconds"
    assert parse_seconds("6.90").must() == 6900
    assert parse_seconds("0.00").must() == 0
    assert parse_seconds("8").must() == 8000
    assert parse_seconds("1.5").must() == 1500
    assert parse_seconds("1.234").must() == 1234
    assert parse_seconds("88.60").must() == 88600
    assert parse_seconds("1.2345").is_err()
    assert parse_seconds("six").is_err()
    assert parse_seconds("-1").is_err()
    assert parse_seconds("").is_err()
    assert parse_seconds(".").is_err()
    assert parse_seconds("1.2.3").is_err()
    assert parse_seconds("123456789").is_err()

test "milliseconds print as time -p printed them, two decimals, a third rounded half up"
    assert seconds_text(6900) == "6.90"
    assert seconds_text(37710) == "37.71"
    assert seconds_text(5) == "0.01"
    assert seconds_text(4) == "0.00"
    assert seconds_text(0) == "0.00"
    assert seconds_text(1000) == "1.00"
    assert seconds_text(88600) == "88.60"
    assert seconds_text(parse_seconds("8.29").must()) == "8.29"

test "a reading is the last real, user and sys lines of a capture, after whatever the program said"
    said = "warning: a line the compiler wrote\nreal 0.10\nuser 0.05\nsys 0.01\nreal 6.90\nuser 6.85\nsys 0.03\n"
    got = reading_in(said).must()
    assert got.real_ms == 6900
    assert got.user_ms == 6850
    assert got.sys_ms == 30
    assert reading_in("real 6.90\nuser 6.85\n").is_err()
    assert reading_in("").is_err()
    assert reading_in("real six\nuser 1.00\nsys 0.00\n").is_err()

test "the first run is discarded, a waiting run is discarded, and the best and the spread are the kept runs'"
    runs = [
        Reading(real_ms: 6860, user_ms: 6720, sys_ms: 50)
        Reading(real_ms: 6900, user_ms: 6850, sys_ms: 30)
        Reading(real_ms: 7040, user_ms: 6940, sys_ms: 40)
        Reading(real_ms: 8520, user_ms: 8180, sys_ms: 140)
        Reading(real_ms: 7020, user_ms: 6970, sys_ms: 30)
    ]
    got = judged(runs)
    assert got.kept == [1, 2, 4]
    assert got.best_ms == 6900
    assert got.spread_ms == 140
    assert got.reasons[0] == "discarded, the first"
    assert got.reasons[3] == "discarded, waiting: real 8.52 against user plus sys 8.32"
    assert has_best(got)
    assert kept_text(got) == "3 kept of 5"
    assert kept_cell(got) == "3/5"
    assert summary(got) == "best 6.90 s, 3 kept of 5, spread 0.14 s"

test "a run whose threads worked longer than the clock is not waiting, and one 0.1 s above is kept"
    assert !waiting(Reading(real_ms: 8000, user_ms: 12000, sys_ms: 500))
    assert !waiting(Reading(real_ms: 8100, user_ms: 7950, sys_ms: 50))
    assert waiting(Reading(real_ms: 8101, user_ms: 7950, sys_ms: 50))

test "one run alone leaves nothing kept, and a fastest first run is still discarded"
    none = judged([Reading(real_ms: 100, user_ms: 90, sys_ms: 5)])
    assert !has_best(none)
    assert none.best_ms == 0
    assert summary(none) == "no run kept of 1"
    two = judged([Reading(real_ms: 100, user_ms: 90, sys_ms: 5), Reading(real_ms: 200, user_ms: 190, sys_ms: 5)])
    assert two.kept == [1]
    assert two.best_ms == 200
    assert two.spread_ms == 0

# What two clocks alternated in one sitting say of each other: `after`
# against `before`, their bests, and the noise floor, the larger of the two
# spreads. `after` slower by more than the floor is the one verdict the
# rule admits as a breach; within it, or faster, is none.
record Verdict
    text: str
    slower: bool

function compared(before: Judged, after: Judged) -> Verdict
    if !has_best(before) || !has_best(after)
        return Verdict(text: "no verdict: a side kept no run", slower: false)
    floor: i64 @= before.spread_ms

    if after.spread_ms > floor
        floor @ after.spread_ms
    diff = after.best_ms - before.best_ms
    size: i64 @= diff

    if diff < 0
        size @ 0 - diff
    share = percent_text(part: size, whole: before.best_ms)
    floor_text = " the floor of " + seconds_text(floor) + " s"

    if diff == 0
        return Verdict(
            text: "the same best, " + seconds_text(before.best_ms) + " s on both sides, with" + floor_text,
            slower: false
        )
    beyond: str @= "within"

    if size > floor
        beyond @ "beyond"

    if diff > 0
        return Verdict(
            text: "after slower by " + seconds_text(diff) + " s, " + share + ", " + beyond + floor_text,
            slower: size > floor
        )
    return Verdict(
        text: "after faster by " + seconds_text(size) + " s, " + share + ", " + beyond + floor_text,
        slower: false
    )

# "2.0 %": a part of a whole to a tenth, or `n/a` of a whole of nothing.
function percent_text(part: i64, whole: i64) -> str
    if whole <= 0
        return "n/a"
    permille = (part * 1000 + whole / 2) / whole
    return (permille / 10).to_str() + "." + (permille % 10).to_str() + " %"

test "a comparison reads the two bests against the larger spread, and only slower beyond it is a breach"
    before = judged(
        [Reading(real_ms: 7000, user_ms: 6900, sys_ms: 50), Reading(real_ms: 6890, user_ms: 6850, sys_ms: 30), Reading(real_ms: 6940, user_ms: 6900, sys_ms: 30)]
    )
    after = judged(
        [Reading(real_ms: 7100, user_ms: 7000, sys_ms: 50), Reading(real_ms: 7030, user_ms: 6990, sys_ms: 30), Reading(real_ms: 7050, user_ms: 7010, sys_ms: 30)]
    )
    got = compared(before: before, after: after)
    assert got.slower
    assert got.text == "after slower by 0.14 s, 2.0 %, beyond the floor of 0.05 s"
    same = compared(before: before, after: before)
    assert !same.slower
    assert same.text == "the same best, 6.89 s on both sides, with the floor of 0.05 s"
    back = compared(before: after, after: before)
    assert !back.slower
    assert back.text == "after faster by 0.14 s, 2.0 %, beyond the floor of 0.05 s"

test "a difference inside the floor is within it, whichever side is slower, and a side with no run gives no verdict"
    wide = judged(
        [Reading(real_ms: 7000, user_ms: 6900, sys_ms: 50), Reading(real_ms: 6900, user_ms: 6850, sys_ms: 30), Reading(real_ms: 7050, user_ms: 7000, sys_ms: 30)]
    )
    near = judged(
        [Reading(real_ms: 7000, user_ms: 6900, sys_ms: 50), Reading(real_ms: 6950, user_ms: 6900, sys_ms: 30), Reading(real_ms: 6960, user_ms: 6910, sys_ms: 30)]
    )
    got = compared(before: wide, after: near)
    assert !got.slower
    assert got.text == "after slower by 0.05 s, 0.7 %, within the floor of 0.15 s"
    none = compared(before: wide, after: judged([]))
    assert !none.slower
    assert none.text == "no verdict: a side kept no run"
    assert percent_text(part: 140, whole: 6890) == "2.0 %"
    assert percent_text(part: 1, whole: 0) == "n/a"
    assert percent_text(part: 5, whole: 1000) == "0.5 %"

# THE PAIRED READING, which is the verdict (M-latency-ceiling step 2,
# 2026-10-31). `compared` above reads two bests against the larger spread,
# and on its first real use it said *within the floor* of two compilers whose
# five clean pairs all put `after` behind, by 0.10 to 0.25 s: a best is one
# run of each side, and the pairs are what alternating bought. So the pairs
# are read one by one: the first pair is discarded as a first run is, a pair
# is dropped where either run waited, and of the pairs kept `after` is slower
# in some, faster in others, tied in the rest. Under no difference each
# untied pair falls either way as a coin does, so the chance of `slower` or
# more of them falling slower is a binomial tail, the sign test's, counted
# exactly in integers: `after` is slower when that tail is under 1 in 20 over
# at least `LEAST_PAIRS` untied pairs. The runs of a pair alternate their
# order too (`latency_runs.alternated`), so an effect of order, the second
# run of two finding the machine warmer, falls on both sides alike.
record Paired
    kept: i64
    slower: i64
    faster: i64
    median_ms: i64
    share: str
    tail: str
    slower_verdict: bool
    text: str

constant LEAST_PAIRS: i64
    5

# `--runs` is held under this, so 2 to the number of pairs fits an `i64` with
# room for the tail's arithmetic.
constant MOST_PAIRS: i64
    41

# How many ways `k` or more of `n` coins fall heads: the tail's numerator,
# 2 to the `n` its denominator.
function tail_count(n: i64, k: i64) -> i64
    total: i64 @= 0
    ways: i64 @= 1
    j: i64 @= 0

    while j <= n
        if j >= k
            total @ total + ways
        ways @ ways * (n - j) / (j + 1)
        j @ j + 1

    return total

function power_of_two(n: i64) -> i64
    out: i64 @= 1
    i: i64 @= 0

    while i < n
        out @ out * 2
        i @ i + 1

    return out

function median_of(values: [i64]) -> i64
    if values.len() == 0
        return 0
    sorted = sort(values)
    mid = sorted.len() / 2

    if sorted.len() % 2 == 1
        return sorted[mid]
    return (sorted[mid - 1] + sorted[mid]) / 2

# The pairs `before[i]` and `after[i]`, made in one sitting, read as above.
function paired(before: [Reading], after: [Reading]) -> Paired
    differences: [i64] @= []
    bases: [i64] @= []
    slower: i64 @= 0
    faster: i64 @= 0
    i: i64 @= 1

    while i < before.len() && i < after.len()
        if !waiting(before[i]) && !waiting(after[i])
            d = after[i].real_ms - before[i].real_ms
            differences @ differences.push(d)
            bases @ bases.push(before[i].real_ms)

            if d > 0
                slower @ slower + 1
            else if d < 0
                faster @ faster + 1
        i @ i + 1

    kept = differences.len()
    untied = slower + faster
    median = median_of(differences)
    size: i64 @= median

    if median < 0
        size @ 0 - median
    share = percent_text(part: size, whole: median_of(bases))

    if untied < LEAST_PAIRS
        return Paired(
            kept: kept,
            slower: slower,
            faster: faster,
            median_ms: median,
            share: share,
            tail: "n/a",
            slower_verdict: false,
            text: kept.to_str() + " pairs kept, " + untied.to_str() + " of them untied, fewer than " + LEAST_PAIRS.to_str() + ": no verdict"
        )
    ways = tail_count(n: untied, k: slower)
    all_ways = power_of_two(untied)
    tail = percent_text(part: ways, whole: all_ways)
    verdict = ways * 20 < all_ways
    direction: str @= "by"

    if median < 0
        direction @ "faster by"
    else if median == 0
        direction @ "by"
    ruling: str @= "not under 5 %: no verdict of slower"

    if verdict
        ruling @ "under 5 %: slower"
    return Paired(
        kept: kept,
        slower: slower,
        faster: faster,
        median_ms: median,
        share: share,
        tail: tail,
        slower_verdict: verdict,
        text: "after slower in " + slower.to_str() + " of " + untied.to_str() + " untied pairs kept, the median " + direction + " " + seconds_text(size) + " s, " + share + "; the sign test's tail " + tail + ", " + ruling
    )

test "the pairs of 2026-10-31 are read one by one: five of five slower is a tail of 3.1 %, a verdict"
    before = [
        Reading(real_ms: 316660, user_ms: 6630, sys_ms: 60)
        Reading(real_ms: 6910, user_ms: 6620, sys_ms: 30)
        Reading(real_ms: 6700, user_ms: 6650, sys_ms: 30)
        Reading(real_ms: 6800, user_ms: 6770, sys_ms: 30)
        Reading(real_ms: 6740, user_ms: 6700, sys_ms: 30)
        Reading(real_ms: 6760, user_ms: 6720, sys_ms: 30)
        Reading(real_ms: 6760, user_ms: 6720, sys_ms: 30)
    ]
    after = [
        Reading(real_ms: 6670, user_ms: 6630, sys_ms: 30)
        Reading(real_ms: 6760, user_ms: 6730, sys_ms: 30)
        Reading(real_ms: 6950, user_ms: 6910, sys_ms: 30)
        Reading(real_ms: 6900, user_ms: 6870, sys_ms: 30)
        Reading(real_ms: 6880, user_ms: 6850, sys_ms: 30)
        Reading(real_ms: 6980, user_ms: 6930, sys_ms: 30)
        Reading(real_ms: 6910, user_ms: 6870, sys_ms: 30)
    ]
    got = paired(before: before, after: after)
    assert got.kept == 5
    assert got.slower == 5
    assert got.faster == 0
    assert got.median_ms == 150
    assert got.slower_verdict
    assert got.text == "after slower in 5 of 5 untied pairs kept, the median by 0.15 s, 2.2 %; the sign test's tail 3.1 %, under 5 %: slower"

    # The same sitting read by bests alone: what the first verdict said.
    assert compared(before: judged(before), after: judged(after)).text == "after slower by 0.06 s, 0.9 %, within the floor of 0.22 s"

test "mixed signs are no verdict, a faster after is none, and too few untied pairs are none"
    base = Reading(real_ms: 7000, user_ms: 6950, sys_ms: 30)
    before = [base, base, base, base, base, base]
    mixed = [
        base
        Reading(real_ms: 7100, user_ms: 7050, sys_ms: 30)
        Reading(real_ms: 6900, user_ms: 6850, sys_ms: 30)
        Reading(real_ms: 7050, user_ms: 7000, sys_ms: 30)
        Reading(real_ms: 6950, user_ms: 6900, sys_ms: 30)
        Reading(real_ms: 7020, user_ms: 6970, sys_ms: 30)
    ]
    got = paired(before: before, after: mixed)
    assert got.slower == 3
    assert got.faster == 2
    assert !got.slower_verdict
    assert got.tail == "50.0 %"
    quicker = [
        base
        Reading(real_ms: 6800, user_ms: 6750, sys_ms: 30)
        Reading(real_ms: 6810, user_ms: 6760, sys_ms: 30)
        Reading(real_ms: 6820, user_ms: 6770, sys_ms: 30)
        Reading(real_ms: 6830, user_ms: 6780, sys_ms: 30)
        Reading(real_ms: 6840, user_ms: 6790, sys_ms: 30)
    ]
    fast = paired(before: before, after: quicker)
    assert !fast.slower_verdict
    assert fast.text == "after slower in 0 of 5 untied pairs kept, the median faster by 0.18 s, 2.6 %; the sign test's tail 100.0 %, not under 5 %: no verdict of slower"
    short = paired(before: [base, base, base], after: [base, base, base])
    assert !short.slower_verdict
    assert short.text == "2 pairs kept, 0 of them untied, fewer than 5: no verdict"

test "the tail is counted exactly: one way in 32 for five of five, seven in 64 for five of six"
    assert tail_count(n: 5, k: 5) == 1
    assert tail_count(n: 5, k: 3) == 16
    assert tail_count(n: 6, k: 5) == 7
    assert tail_count(n: 6, k: 0) == 64
    assert tail_count(n: 40, k: 0) == power_of_two(40)
    assert power_of_two(5) == 32
    assert median_of([250, 100, 140, 220, 150]) == 150
    assert median_of([1, 3]) == 2
    assert median_of([]) == 0
