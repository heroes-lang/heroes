# **The one file that must hold Italian in order to refuse it: this one.** Its
# test quotes the sentences the check has to catch, and a check that cannot
# state its own witnesses is a check nobody can read or trust. It is the same
# argument, in the same module, as `QUOTES_THE_OLD_SPELLING` above, which is
# there because these assertions quote `M0` and `M5b`.
#
# Exact match and one entry, so the exemption cannot spread: any OTHER harness
# file that grows an Italian line is reported like anything else.
constant QUOTES_THE_ITALIAN: [str]
    [
        "tests/harness/suite_records.hero"
    ]

function run_all(scratch: str, only: str) -> report.Report?
    r: report.Report @= report.empty()

    # The quoting files leave the walk ONCE, for every check — which is
    # what the Rust `walk` does and what the first draft of this port got
    # wrong by filtering inside one check only. The three deliberate
    # misspellings `milestones.rs` quotes (to say what this check catches)
    # were reported as three real defects.
    # **Git answers which files are this project's** (shell.project_files), and
    # RECORD then removes the ones that are RECORDS. The two questions used to be
    # one `find` with a list of exclusions, and that list could not keep up with
    # the world: a gitignored TLS key in `site/.cache/` was read as `M3KN` on
    # 2026-08-19 — a milestone identifier, in a file nobody wrote and git already
    # knew to ignore.
    walked = shell.project_files(scratch)?

    # **Narrowed to one path, the write hook's question** (layer 0,
    # `.claude/rules/verification.md` § A suite is the last judge): the one
    # check that can judge a file alone, `defects-cited`, over `only` where it
    # stands under the cited roots, its register the copy the last full run
    # kept (`REGISTER`), so the hook asks GitHub nothing; with no copy it is a
    # skip, which the hook prints nothing for. A word that selects none is a
    # run that would test nothing, and it is refused rather than green
    # (CL-072).
    if only != ""
        if !credit.under_roots(only)
            return fail(
                code: "no_case",
                msg: "`" + only + "` stands under none of selfhost/, runtime/, seed/ or tests/, so a run narrowed to it would test nothing"
            )
        narrowed(@r, scratch: scratch, only: only)
        return ok(r)

    # **What GitHub holds of the issues is read once, here** (`github_issues`),
    # and handed to the six checks that ask about them; where GitHub cannot be
    # asked, each of them says `SKIP` and why, and every other check runs.
    held = github_issues.held_at(scratch: scratch, transport: issue_wire.gh())
    closed: {str: bool} @= {}

    # **The issue files are an archive while they stand** (the author's seven
    # answers of 2026-10-12): GitHub holds the issues, so a file of `ISSUES`
    # is read by no check, as a closed issue was a record before it.
    for path in walked
        if strings.starts_with(text: path, prefix: ISSUES + "/")
            closed[path] @ true

    # **A question answered is a record too**, since the questions left
    # `ISSUES` on 2026-10-05: the 25 closed ones were entries of the old record
    # and keep the words they were written with, the retired milestone spelling
    # and paths of a tree since archived among them.
    for path in walked
        if is_question(path)
            question = read_file(path)?

            if !strings.starts_with(text: question, prefix: "- [ ] ")
                closed[path] @ true

    living: [str] @= []

    for path in walked
        if !quoting(path) && !is_record(path) && !is_generated(path) && closed[path].is_err()
            living @ living.push(path)

    archive = archive_of(scratch: scratch, present: walked)
    known: {str: bool} @= {}

    for path in walked
        known[path] @ true

    numbered(@r, living: living)
    named(@r, living: living)
    sections(@r, living: living)
    c_files(@r, living: living)
    citations(@r, scratch: scratch, present: walked, closed: closed, archive: archive)
    english(@r, present: walked, closed: closed)
    exemptions(@r, present: walked)
    redirects(@r, present: walked, archive: archive)
    rules(@r, present: walked)
    expectations(@r, scratch: scratch)
    boundary(@r)
    verdicts(@r, present: walked, held: held)
    where_we_are(@r)
    homed(@r, present: walked, held: held)
    lists(@r, present: walked)
    areas(@r, present: walked)
    records_github.prior_art(@r, held: held, known: known)
    cited(@r, scratch: scratch, held: held)
    tagged(@r, scratch: scratch, held: held)
    appended(@r, scratch: scratch)
    records_github.numbering(@r, held: held)
    unmerged(@r, scratch: scratch)
    entries(@r, present: walked)
    portable.check(@r, present: walked)
    return ok(r)

# EVERY DIRECTORY OF `selfhost/` IS AN AREA A CARD MAY NAME (`cards.AREAS`,
# enumerated from the tree on 2026-10-04 and a premise about the world, so held
# to the tree each run): a directory the list does not name is a failure, since
# no issue about it could say where it is. Part of `records/cards` until the
# issues left the tree on 2026-10-12, and kept, its object being the tree.
function areas(@r: report.Report, present: [str])
    unnamed: [str] @= []

    for path in present
        if strings.starts_with(text: path, prefix: "selfhost/") && cards.area_of_path(path) == ""
            directory = strings.split_on(text: strings.without_prefix(text: path, prefix: "selfhost/"), byte: 47)[0]

            if !is_among(directory, seen: unnamed)
                unnamed @ unnamed.push(directory)

    if unnamed.len() > 0
        told: [str] @= []

        for one in unnamed
            told @ told.push("    selfhost/" + one + "/")

        report.keep_failure(
            @r,
            label: "records/areas",
            detail: "  a directory of selfhost/ that `cards.AREAS` does not name, so no issue about it can say where it is:\n" + told.join("\n") + "\n  Add it to the list in tests/harness/cards.hero (.claude/rules/records.md § The issues, the labels)."
        )
    else
        report.keep_pass(@r)

# WHERE THE FULL RUN KEEPS THE DEFECTS' NAMES IT READ FROM GITHUB, for the run
# narrowed to one file that the write hook asks (`.claude/hooks/fmt_check.py`):
# one name a line (`records_github.register_text`), under `build/`, which git
# ignores and every clone and lane keeps for itself. A copy, and so possibly
# older than GitHub: the full run is the judge, and the hook's question is the
# early one.
constant REGISTER: str
    "build/defect-register"

# `records/defects-cited` over the whole of the cited roots, its register
# GitHub's, kept at `REGISTER` for the narrowed run; a skip where GitHub could
# not be asked.
function cited(@r: report.Report, scratch: str, held: github_issues.Listing)
    if !held.asked
        records_github.unanswered(@r, held: held, label: credit.LABEL_CITED)
        return
    names = records_github.names_of(records_github.register_of(held))

    if shell.mkdir_all("build").is_err() || write_file(path: REGISTER, text: records_github.register_text(names)).is_err()
        report.keep_failure(
            @r,
            label: credit.LABEL_CITED,
            detail: "  cannot write " + REGISTER + ", the copy of the defects' names the write hook reads"
        )
    credit.defects_cited(@r, scratch: scratch, names: names, from: "GitHub", only: "")

# `records/defects-cited` over one file, against the copy the last full run
# kept: a skip where there is none, a failure where it cannot be read.
function narrowed(@r: report.Report, scratch: str, only: str)
    kept = read_file(REGISTER)

    if kept.is_err()
        report.keep_skip(
            @r,
            label: credit.LABEL_CITED,
            detail: "  no copy of the defects' names at " + REGISTER + " (a full `records` run writes one from GitHub), so " + only + " was not judged"
        )
        return
    names = records_github.register_read(kept.must())

    if names.is_err()
        report.keep_failure(
            @r,
            label: credit.LABEL_CITED,
            detail: "  " + REGISTER + " cannot be read: " + failure_of(names) + "; a full `records` run writes it again"
        )
        return
    credit.defects_cited(
        @r,
        scratch: scratch,
        names: names.must(),
        from: "the copy of GitHub's names at " + REGISTER,
        only: only
    )

# A MILESTONE IS TAGGED ONLY OVER A CLEAN LIST (author instruction
# 2026-09-08, and CLAUDE.md § Verification is the rule's home).
#
# The author asked for zero open decisions and zero open defects at a tag.
# Zero defects is taken whole: an open defect is something BROKEN, and
# nothing depends on it staying open. Zero decisions is taken with one
# exception, named rather than assumed, because the literal rule would
# block every milestone that held a sitting: § 4 says a panel never
# blocks, so each one leaves a `panel NNN` item, and
# `records/verdicts` above catches an unratified sitting only while that
# item exists. A ratification pending is waiting on the AUTHOR, not
# broken.
#
# IT READS THE NEWEST TAG'S OWN COMMIT and not the working tree, which is
# what makes the rule livable: a defect filed at 10am and repaired at 4pm
# is ordinary work, and only a tag placed over it is the mistake. So this
# check is silent all through a milestone and speaks once, at its close.
#
# It binds from the tag it first sees onwards. Older tags are not
# re-judged, which is not leniency but § 14: a record is not rewritten,
# and a rule cannot be applied to a commit made before it existed.
#
# **Since 2026-10-02 a defect counts by its class** (the author's *D1a D2a
# D3a*, `.claude/rules/verification.md` § Bounded discovery): a tag stands
# over zero `blocking` and zero `systemic` items, an `adjacent` one counts
# as `blocking` from the second tag placed since it was filed, and an
# `improvement` never counts. **An item with no class at the tag's commit
# counts as `blocking`**, because every tag before that day was placed under
# zero of all, and reading an unclassed item as anything weaker would loosen
# history in silence. `counted_at` below decides it from the list's text and
# the tags, and nothing here decides anything but what to read.
#
# **Two routes since the issues left the tree** (the author's seven answers of
# 2026-10-12), and the newest tag's own tree chooses, as it chose between the
# list's shapes before: where that tree holds the issue files, or an older
# shape of the list, they are what the tag stood over and they are read there,
# to the commit (`tree_route`); where it holds none, the tag was placed after
# the folder left, and what it stood over is GitHub's
# (`records_github.standing` and `unqueued`), each issue open at the tag's
# instant by GitHub's own days. GitHub's days cannot serve the older tags:
# the import wrote a card's day as noon UTC, and measured 2026-10-12 against
# `m-inferred-cell` (placed 09:57 UTC on 2026-10-11) that put defects 602 to
# 605, closed in the tag's own commit, open at it, and 671 and 672, filed
# after it the same day, there before it. The two excuses this check carried,
# `TAGGED_OVER` (`m-readable-bytes` over defects 061 and 062) and
# `CARRIED_OVER` (`m-agreed-retention` over 129 and 130), went the same day:
# each named a tag that is no longer the newest and never again can be, tags
# being immovable and the newest judged alone (`git show 0a235eeb:tests/harness/suite_records.hero`
# holds them).
function tagged(@r: report.Report, scratch: str, held: github_issues.Listing)
    listed = shell.run(
        scratch: scratch,
        program: "git",
        words: ["git", "tag", "--list", "m-*", "--sort=-creatordate", "--format=%(creatordate:short) %(refname:short)"]
    )

    if listed.is_err()
        report.keep_failure(@r, label: "records/tagged", detail: "  cannot list the milestone tags")
        return

    # A `git` that ran and failed prints nothing on its standard output, and
    # nothing read as no tag is the first-day pass below: the exit code is
    # asked first so that a failure is never mistaken for an empty history.
    if listed.must().code != 0
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  `git tag --list` exited " + listed.must().code.to_str() + ": " + strings.trimmed(listed.must().err)
        )
        return
    placed = placed_tags(listed.must().out)

    if placed.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read the milestone tags' days: " + failure_of(placed)
        )
        return

    if placed.must().len() == 0
        # No milestone has been tagged yet, which is a true state of this
        # repository's first day and not a failure.
        report.keep_pass(@r)
        return
    newest = placed.must()[0].name
    shapes = listed_at(scratch: scratch, tag: newest, roots: [ISSUES, DEFECT_FILES, DEFECTS])

    if shapes.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot ask git what " + newest + "'s tree holds: " + failure_of(shapes)
        )
        return

    if shapes.must().len() > 0
        tree_route(@r, scratch: scratch, placed: placed.must())
    else
        github_route(@r, scratch: scratch, held: held, newest: newest)

# The newest tag judged by its own tree, which holds the issue files or an
# older shape of the list.
function tree_route(@r: report.Report, scratch: str, placed: [Placed])
    newest = placed[0].name

    # **The list in the shape the tag's own tree holds it**, since 2026-10-04:
    # the files of `DEFECT_FILES` where the tag has them, and `DEFECTS.md`'s
    # items where it has not, which is every tag placed before that day.
    list_then = list_text_at(scratch: scratch, tag: newest)

    if list_then.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read the defect list at " + newest + ": " + failure_of(list_then)
        )
        return
    before = earlier_tags(scratch: scratch, text: list_then.must(), tags: placed)

    if before.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read the defect list at an earlier tag: " + failure_of(before)
        )
        return
    standing = counted_at(text: list_then.must(), at: placed[0], before: before.must())

    if standing.len() > 0
        told: [str] @= []

        for one in standing
            told @ told.push(one.row + "\n      " + one.why)

        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  " + newest + " was placed over " + standing.len().to_str() + " open defect(s) that count against a tag:\n    " + told.join("\n    ") + "\n  " + TAGGED_RULE
        )
        return
    open_decisions = decision_rows_at(scratch: scratch, tag: newest)

    if open_decisions.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read the open decisions at " + newest + ": " + failure_of(open_decisions)
        )
        return
    strict = carried_the_rule(scratch: scratch, tag: newest)

    if strict.is_err()
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read " + EXECUTOR + " at " + newest + "\n  Without it this check cannot tell whether that tag was placed under the\n  strict reading of a ratification or the historical one, and reading the\n  silence as either would weaken this check without saying so."
        )
        return
    unqueued: [str] @= []

    for row in open_decisions.must()
        ratified: bool @= strings.contains(text: row, needle: "panel ")

        if strict.must()
            ratified @ is_ratification(row: row)

        if !ratified
            unqueued @ unqueued.push(row)

    if unqueued.len() > 0
        reading: str @= "the historical reading, the substring `panel `, because that tag's own\n  tree did not carry the strict one"

        if strict.must()
            reading @ "the strict reading: the origin field is `panel NNN` and nothing more, so\n  a sitting's FINDING does not count as its ratification"
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  " + newest + " was placed over " + unqueued.len().to_str() + " open decision(s) that are not a sitting's ratification:\n    " + unqueued.join("\n    ") + "\n  " + DECISIONS_RULE + "\n  Applied: " + reading + "."
        )
        return
    report.keep_pass(@r)

# The newest tag judged by what GitHub holds: its tree holds no issue file,
# so it was placed after they left the tree.
function github_route(@r: report.Report, scratch: str, held: github_issues.Listing, newest: str)
    if !held.asked
        records_github.unanswered(@r, held: held, label: "records/tagged")
        return
    listed = shell.run(
        scratch: scratch,
        program: "git",
        words: ["git", "tag", "--list", "m-*", "--sort=-creatordate", "--format=%(creatordate:unix) %(refname:short)"]
    )

    if listed.is_err() || listed.must().code != 0
        report.keep_failure(@r, label: "records/tagged", detail: "  cannot list the milestone tags with their instants")
        return
    tags = records_github.tags_of(listed.must().out)

    if tags.is_err() || tags.must().len() == 0 || tags.must()[0].name != newest
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  cannot read the milestone tags' instants, or they name another newest tag than their days: " + failure_of(tags)
        )
        return
    judged = tags.must()[0]
    standing = records_github.standing(held: held, judged: judged, tags: tags.must())

    if standing.len() > 0
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  " + newest + " was placed over " + standing.len().to_str() + " open defect(s) that count against a tag:\n    " + standing.join("\n    ") + "\n  " + TAGGED_RULE
        )
        return
    unqueued = records_github.unqueued(held: held, judged: judged)

    if unqueued.len() > 0
        report.keep_failure(
            @r,
            label: "records/tagged",
            detail: "  " + newest + " was placed over " + unqueued.len().to_str() + " open decision(s) that are not a sitting's ratification:\n    " + unqueued.join("\n    ") + "\n  " + DECISIONS_RULE + "\n  Applied: the strict reading, a title opening `Panel NNN:` as the rendering gives a ratification."
        )
        return
    report.keep_pass(@r)

# What the two failures of `tagged` say beneath what they list.
constant TAGGED_RULE: str
    "A milestone is tagged over zero `blocking` and zero `systemic` items (CLAUDE.md § Verification;\n  .claude/rules/verification.md § Bounded discovery). An item with no class counts\n  as `blocking`, and an `adjacent` one counts as `blocking` from the second tag\n  placed since it was filed."

constant DECISIONS_RULE: str
    "A pending `panel NNN` is allowed to stand at a tag, because § 4 says the\n  panel never blocks. Anything else is a decision this milestone could have\n  settled and left hanging instead (CLAUDE.md § Verification)."

# The `- [ ] ` lines of a list AS IT WAS at a tag, which is the only way to
# ask what a tag was placed over. `git show <tag>:<path>` and not the
# working tree, deliberately: see `tagged`. The defect list has its own
# reader since 2026-10-04, `defect_rows_at`, because it has two shapes.
function open_items_at(scratch: str, tag: str, path: str) -> [str]?
    shown = shell.run(scratch: scratch, program: "git", words: ["git", "show", tag + ":" + path])?

    if shown.code != 0
        return fail(code: "no_such_file", msg: path + " does not exist at " + tag)

    return ok(open_rows_in(shown.out))

# The `- [ ] ` lines of a list's text, trimmed: what every count here reads.
function open_rows_in(text: str) -> [str]
    open_rows: [str] @= []

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "- [ ] ")
            open_rows @ open_rows.push(strings.trimmed(row))

    return open_rows

# The open defects' lines AS THEY WERE at a tag, in whichever shape the tag
# holds the list (`list_text_at`), its failure's code kept: `no_such_file`
# where the tag had no list at all.
function defect_rows_at(scratch: str, tag: str) -> [str]?
    text = list_text_at(scratch: scratch, tag: tag)?

    return ok(open_rows_in(text))

# THE DEFECT LIST AS IT WAS AT A TAG, in the shape that tag's own tree holds it.
#
# **Two shapes since 2026-10-04, and the tag decides which.** A record is not
# rewritten, so every tag placed before that day holds `DEFECTS.md` with its
# banners and its items, and every tag after holds `DEFECT_FILES`: where the
# tag's tree has the directory, the list is its files; where it has not, it is
# `DEFECTS.md`; where it has neither, there was no list, which `earlier_tags`
# reads as nothing open and `tagged` as a failure.
#
# **One text either way, and it is why the readers after it did not change.**
# `item_shape.open_regions`, `item_shape.classed` and `open_rows_in` read the files
# joined one after another (`joined_files`) exactly as they read the old
# region, because every file opens with its item's line: a body still runs to
# the next item, and nothing downstream knows which shape it came from.
#
# **Two processes a tag, whatever it holds.** `git ls-tree` says which shape
# and names the files, and ONE `git cat-file --batch` reads them all, where
# one `git show` per file would be a process per defect at every tag
# `earlier_tags` reads: every tag older than the newest `adjacent` item's day,
# which on 2026-10-04 is every one of the fifty `m-*` tags. Both are plumbing,
# whose output no porcelain setting of the machine reshapes.
function list_text_at(scratch: str, tag: str) -> str?
    paths = listed_at(scratch: scratch, tag: tag, roots: [ISSUES, DEFECT_FILES, DEFECTS])?
    shape = shape_listed(paths)

    if !shape.directory && shape.files.len() == 0
        return fail(
            code: "no_such_file",
            msg: "neither " + ISSUES + ", " + DEFECT_FILES + " nor " + DEFECTS + " exists at " + tag
        )

    if shape.files.len() == 0
        return ok("")
    texts = blobs_at(scratch: scratch, tag: tag, paths: shape.files)?

    if !shape.issues
        return ok(joined_files(texts))

    # **The third shape, since 2026-10-04**: the open defects are the issues
    # whose card says `defect` and whose item is unticked, read below their
    # cards, so that every reader after this one meets the text it always
    # met: a body ends at the next item, and no card falls into the item
    # before it.
    kept: [str] @= []
    i: i64 @= 0

    while i < texts.len()
        issue = cards.issue_of(path: shape.files[i], text: texts[i])

        if issue.open && issue.card.kind == "defect"
            kept @ kept.push(issue.body)
        i @ i + 1

    return ok(joined_files(kept))

# The paths under `roots` in a tag's tree, as `git ls-tree` names them.
function listed_at(scratch: str, tag: str, roots: [str]) -> [str]?
    words: [str] @= ["git", "ls-tree", "--full-tree", "-r", "-z", "--name-only", tag, "--"]

    for root in roots
        words @ words.push(root)

    listed = shell.run(scratch: scratch, program: "git", words: words)?

    if listed.code != 0
        return fail(
            code: "git",
            msg: "`git ls-tree` at " + tag + " exited " + listed.code.to_str() + ": " + strings.trimmed(listed.err)
        )
    paths: [str] @= []

    for piece in strings.split_on(text: listed.out, byte: 0)
        if piece.len() > 0
            paths @ paths.push(piece)

    return ok(paths)

# The texts of `paths` at a tag, in the order asked, read by ONE `git cat-file
# --batch` whatever their number.
function blobs_at(scratch: str, tag: str, paths: [str]) -> [str]?
    asked: [str] @= []

    for path in paths
        asked @ asked.push(tag + ":" + path)

    names = scratch + "/defect-objects"
    shell.mkdir_all(scratch)?
    write_file(path: names, text: asked.join("\n") + "\n")?
    shown = shell.run_fed(scratch: scratch, program: "git", words: ["git", "cat-file", "--batch"], stdin_path: names)?

    if shown.code != 0
        return fail(
            code: "git",
            msg: "`git cat-file --batch` at " + tag + " exited " + shown.code.to_str() + ": " + strings.trimmed(shown.err)
        )
    texts = blobs_in(shown.out)?

    if texts.len() != paths.len()
        return fail(
            code: "shape",
            msg: "asked git for " + paths.len().to_str() + " files at " + tag + " and read " + texts.len().to_str()
        )

    return ok(texts)

# The open decisions' lines AS THEY WERE at a tag: the open `decision` issues'
# items where the tag's tree holds `ISSUES`, and `DECIDE.md`'s where it does
# not, which is every tag placed before 2026-10-04.
function decision_rows_at(scratch: str, tag: str) -> [str]?
    paths = issue_files(listed_at(scratch: scratch, tag: tag, roots: [ISSUES])?)

    if paths.len() == 0
        return open_items_at(scratch: scratch, tag: tag, path: DECISIONS)
    texts = blobs_at(scratch: scratch, tag: tag, paths: paths)?
    rows: [str] @= []
    i: i64 @= 0

    while i < texts.len()
        issue = cards.issue_of(path: paths[i], text: texts[i])

        if issue.open && issue.card.kind == "decision"
            for row in open_rows_in(issue.body)
                rows @ rows.push(row)
        i @ i + 1

    return ok(rows)

# What `git ls-tree` names at a tag, read: whether the list was a directory,
# and the files that hold it. `ISSUES` where the tag has it, every issue file;
# else `DEFECT_FILES`' defect files, the keeper aside; else `DEFECTS.md`; and
# none where none was. A directory holding only its keeper is the goal's shape
# at a tag, and reads as no item.
record ListAt
    directory: bool
    issues: bool
    files: [str]

function shape_listed(paths: [str]) -> ListAt
    for path in paths
        if strings.starts_with(text: path, prefix: ISSUES + "/")
            return ListAt(directory: true, issues: true, files: issue_files(paths))

    directory: bool @= false

    for path in paths
        if strings.starts_with(text: path, prefix: DEFECT_FILES + "/")
            directory @ true

    if directory
        return ListAt(directory: true, issues: false, files: defect_files(paths))
    files: [str] @= []

    for path in paths
        if path == DEFECTS
            files @ files.push(path)

    return ListAt(directory: false, issues: false, files: files)

# `git cat-file --batch`'s answer as the texts it holds, in the order asked:
# each object is `<name> blob <size>`, a line end, exactly `<size>` bytes and
# one more line end. **The size decides where a text ends**, so a text may hold
# any line, a blank one or one shaped like a header, and is still read whole.
# A header this cannot read, an object git calls missing, or a size that does
# not end at the line end git writes after every object is a failure and
# never a shorter list: a defect left unread at a tag is a defect the tag is
# said not to have stood over, which is the direction this check refuses.
function blobs_in(out: str) -> [str]?
    texts: [str] @= []
    at: i64 @= 0

    while at < out.len()
        end: i64 @= at

        while end < out.len() && out[end] != '\n'
            end @ end + 1

        header = out.slice(from: at, to: end)

        if end == out.len()
            return fail(code: "shape", msg: "`" + head_of(header) + "` has no line end after it")
        fields = strings.words(header)

        if fields.len() == 2 && fields[1] == "missing"
            return fail(code: "missing", msg: "git has no object " + fields[0])

        if fields.len() != 3 || fields[1] != "blob" || fields[2].len() > 18
            return fail(code: "shape", msg: "`" + head_of(header) + "` is not `<object> blob <size>`")
        size = strings.to_number(fields[2])

        if size.is_err() || size.must() < 0
            return fail(code: "shape", msg: "`" + head_of(header) + "` gives no size")
        start = end + 1
        stop = start + size.must()

        # The byte after the text is the line end git writes after every
        # object, asked BEFORE the cut, and it is what makes the cut safe: a
        # line end is one byte that stands inside no character, so `stop`
        # starts one, and `slice` cannot split it (spec § 10).
        if stop >= out.len() || out[stop] != '\n'
            return fail(code: "shape", msg: "`" + head_of(header) + "` gives a size its bytes do not end at")
        texts @ texts.push(out.slice(from: start, to: stop))
        at @ stop + 1

    return ok(texts)

# The directory's files as ONE list text: each file's own bytes, its last line
# ended where the file left it open, and one blank line between two files, as
# the old list held its items. Every file opens with its item's line, so an
# item's body ends where the next file begins (`item_shape.open_regions`).
function joined_files(texts: [str]) -> str
    ended: [str] @= []

    for text in texts
        if text == "" || strings.ends_with(text: text, suffix: "\n")
            ended @ ended.push(text)
        else
            ended @ ended.push(text + "\n")

    return ended.join("\n")

# THE STRICT READING OF *a sitting's ratification*, AND WHY IT ASKS THE TAG'S
# OWN TREE WHETHER IT CARRIED THIS RULE.
#
# `tagged` accepted any row containing the substring `panel `, which accepts
# `- [ ] **panel 118 finding**` as though it were a ratification. It is not
# one. A pending `panel NNN` is waiting on the AUTHOR, which is why § 4 lets it
# stand at a tag; a FINDING is a decision the milestone could have settled and
# left hanging, which is the exact thing this check exists to refuse. The
# measurement that settles it rather than an opinion: `m-closures-verdict` was
# placed over three `panel 118 finding` items on 2026-09-08 and **all three
# were settled by one `/decide` session** the same day, two of them without
# needing the author at all — one was already answered by design.md §1.12
# before it was asked. Found by reading this function while zeroing the list;
# the author asked for the repair the same day.
#
# So the rule reads the ORIGIN FIELD — `**panel NNN**` and nothing more.
#
# **AND IT BINDS ONLY ON A TAG WHOSE OWN TREE CARRIED IT**, which is this
# neighbourhood's own comment turned into code instead of left as a sentence:
# *a rule cannot be applied to a commit made before it existed*, and
# `m-closures-verdict` was placed under the loose reading, and a record is not
# rewritten (CLAUDE.md §14). The alternative was a constant naming that tag,
# and this file already carries a check — `exemptions` — that exists because a
# dead entry sat for weeks reading like a live rule. Asking the tree needs no
# such constant and retires itself.
#
# The three outcomes are kept apart deliberately: the marker present is the
# strict reading, the marker absent is the historical one, and the executor
# **unreadable** at that tag is a reported failure. Collapsing the third into
# the second is what would make a rename weaken this check in silence, which is
# the one direction this repository refuses.
constant EXECUTOR: str
    "tests/harness/suite_records.hero"

# The sentence a tag's tree must carry for the strict reading to bind. A
# CONSTANT for `VERDICT_HEADING`'s reason, and its value reaches the tree by
# being written here, which is the whole mechanism: this file contains it
# because this line is in it.
constant RATIFICATION_MARKER: str
    "tagged reads the origin field and not the substring"

# A milestone tag, the day `git` says it was created on, and the defect
# numbers open in the defect list at it (`defect_rows_at`). `open` is read
# only for a tag whose day is not later than the newest `adjacent` item's
# day, because a tag of a later day counts against such an item by its day
# alone; everywhere else it is empty and nothing asks it.
record Placed
    name: str
    day: i64
    open: [str]

# An open defect that counts against the tag it stands at: its line, as
# `open_rows_in` gives it, and why it counts, in words the failure prints.
record Standing
    row: str
    why: str

# `git tag --format='%(creatordate:short) %(refname:short)'`, newest first,
# as `Placed`s with nothing read yet. A row this cannot read fails the whole
# listing rather than dropping out of it: a tag left out is a tag that ages
# nothing, which is the direction this check refuses to fail in.
function placed_tags(out: str) -> [Placed]?
    tags: [Placed] @= []

    for row in strings.lines(out)
        if strings.trimmed(row) == ""
            continue
        day = cards.day_of(row)

        if day.is_err() || row.len() < 12 || row[10] != ' '
            return fail(code: "shape", msg: "`" + head_of(row) + "` does not open with a day as YYYY-MM-DD and a space")
        name = strings.trimmed(row.slice(from: 11, to: row.len()))

        if name == ""
            return fail(code: "shape", msg: "`" + head_of(row) + "` names no tag after its day")
        none: [str] = []
        tags @ tags.push(Placed(name: name, day: day.must(), open: none))

    return ok(tags)

# The tags before the newest, each with the defect numbers open at it where an
# `adjacent` item at the newest needs them (`Placed`). A tag whose tree has
# neither `DEFECT_FILES` nor `DEFECTS.md` held no item of it; any other failure
# to read is a failure, never an empty list.
function earlier_tags(scratch: str, text: str, tags: [Placed]) -> [Placed]?
    latest: i64 @= 0

    for region in item_shape.open_regions(text)
        item = item_shape.classed(region.text)

        if item.kind == "adjacent" && item.day > latest
            latest @ item.day

    before: [Placed] @= []
    i: i64 @= 1

    while i < tags.len()
        tag = tags[i]
        held: [str] @= []

        if latest > 0 && tag.day <= latest
            got = defect_rows_at(scratch: scratch, tag: tag.name)
            code = failure_code(got)

            if code == ""
                for row in got.must()
                    n = defect_number(row)

                    if n != ""
                        held @ held.push(n)
            else if code != "no_such_file"
                return fail(code: code, msg: tag.name + ": " + failure_of(got))

        before @ before.push(Placed(name: tag.name, day: tag.day, open: held))
        i @ i + 1

    return ok(before)

# The open items of `text`, the defect list at the tag `at` as `list_text_at`
# reads it, that count against it, `before` being every earlier tag. **Pure,
# so the tests below drive it with lists and tags written for them**, the
# division `list_offences` keeps for the same reason: a check nobody has
# watched fail is a check nobody has watched.
function counted_at(text: str, at: Placed, before: [Placed]) -> [Standing]
    out: [Standing] @= []

    for region in item_shape.open_regions(text)
        why = counts_because(
            item: item_shape.classed(region.text),
            number: defect_number(region.head),
            at: at,
            before: before
        )

        if why != ""
            out @ out.push(Standing(row: region.head, why: why))

    return out

# Why one item counts against the tag `at`, or the empty string where it does
# not. **The aging of `adjacent` asks the world twice**, and either answer
# counts a tag: its day is later than the item's `**Class:` day, or the item
# stood open at it. The second is what the rule's own word, *filed*, needs:
# an item re-dated to a later day, or classed `adjacent` long after it was
# filed, still counts every tag that stood over it; and a tag of the item's
# own day counts only if it came after the filing, which only that tag's tree
# can say. The tag judged counts by construction, since the item is open at it.
function counts_because(item: item_shape.Classed, number: str, at: Placed, before: [Placed]) -> str
    if item.kind == "improvement"
        return ""

    if item.kind == ""
        return "no class this check can read (" + item.complaints.join("; ") + "), and an item without one counts as `blocking`"

    if item.kind != "adjacent"
        return "`" + item.kind + "`"

    if item.day > at.day
        return "`adjacent`, classed " + cards.day_text(item.day) + ", after " + at.name + "'s own day " + cards.day_text(at.day) + ", which no item standing at it can be: it counts as `blocking`"
    since: [str] @= [at.name]

    for tag in before
        if tag.day > item.day || holds(numbers: tag.open, number: number)
            since @ since.push(tag.name)

    if since.len() < records_github.AGED_AT
        return ""

    return "`adjacent`, classed " + cards.day_text(item.day) + ", with " + since.len().to_str() + " tags placed since it was filed (" + since.join(" ") + "), the tag judged among them, and an `adjacent` item counts as `blocking` once " + records_github.AGED_AT.to_str() + " have been"

function holds(numbers: [str], number: str) -> bool
    if number == ""
        return false

    for one in numbers
        if one == number
            return true

    return false

# The message of a failed value, or the empty string where it holds one: what
# `shell.complaint` is for a `Run?`, for any other fallible this check reads.
function failure_of<T>(got: T?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

# Its code, the empty string where it holds a value.
function failure_code<T>(got: T?) -> str
    return match got
        .ok _  => ""
        .err e => e.code

# Whether `newest`'s own tree carried the strict rule. An error means the
# executor could not be read there and is never read as either answer.
function carried_the_rule(scratch: str, tag: str) -> bool?
    shown = shell.run(scratch: scratch, program: "git", words: ["git", "show", tag + ":" + EXECUTOR])?

    if shown.code != 0
        return fail(code: "no_such_file", msg: EXECUTOR + " does not exist at " + tag)

    return ok(strings.contains(text: shown.out, needle: RATIFICATION_MARKER))

# A ratification row's origin field is `panel NNN` and nothing else. The
# padded spelling is `docs/work/DECIDE.md`'s own rule, written there for
# `queued`'s sake, so this reads what that file already promises rather than
# inventing a second shape.
function is_ratification(row: str) -> bool
    at = strings.index_of(text: row, needle: "**")

    if at.is_err()
        return false
    rest = row.slice(from: at.must() + 2, to: row.len())
    close = strings.index_of(text: rest, needle: "**")

    if close.is_err()
        return false
    field = rest.slice(from: 0, to: close.must())

    if !strings.starts_with(text: field, prefix: "panel ")
        return false
    number = strings.to_number(text: strings.without_prefix(text: field, prefix: "panel "))

    # `to_number` reads a leading `-`, so the sign is refused here rather than
    # left to a spelling nobody writes today (`.claude/rules/module-shape.md`:
    # close the class, not the reachable case).
    return !number.is_err() && number.must() > 0

test "a ratification row is `panel NNN` and a finding row is not"
    assert is_ratification(row: "- [ ] **panel 120** | ratify or overturn | `docs/panel/120`")
    assert is_ratification(row: "- [ ] **panel 7** | one digit is a sitting too | x")

    # The row this whole repair exists for. It contains `panel ` and it is not
    # a ratification, which is what the substring test could not tell.
    assert !is_ratification(row: "- [ ] **panel 118 finding** | may a `certain` fix preserve the bug? | x")
    assert strings.contains(text: "- [ ] **panel 118 finding** | x", needle: "panel ")

test "the shapes beside a ratification row, one at a time"
    # No origin field at all, an unclosed one, an empty one, a non-sitting
    # origin, a sitting with no number, and a number that is not one.
    assert !is_ratification(row: "- [ ] panel 120 | no bold at all | x")
    assert !is_ratification(row: "- [ ] **panel 120 | unclosed | x")
    assert !is_ratification(row: "- [ ] **** | empty | x")
    assert !is_ratification(row: "- [ ] **M-core-packages** | a milestone, not a sitting | x")
    assert !is_ratification(row: "- [ ] **panel ** | no number | x")
    assert !is_ratification(row: "- [ ] **panel twelve** | a word, not a number | x")
    assert !is_ratification(row: "- [ ] **panel -5** | a sign is not a sitting | x")
    assert !is_ratification(row: "- [ ] **panel 118 R5** | a resolution, not a sitting | x")

# Whether this path is one of the dated records — the pruning `find` used to do
# with `-not -path`, done here now that the listing comes from git. Same rule as
# the Rust twin's `rel == *r || rel.starts_with(&format!("{r}/"))`.
function is_record(path: str) -> bool
    for entry in RECORD
        if path == entry || strings.starts_with(text: path, prefix: entry + "/")
            return true

    return false

# Whether this path is an artifact nobody writes. Exact match, and the reason
# it is not a prefix match like `is_record` is up at GENERATED.
function is_generated(path: str) -> bool
    for entry in GENERATED
        if path == entry
            return true

    return false

# Every exemption still selects a file.
#
# This is the check `site/log.html` (deleted 2026-08-18) needed and did not have. That entry stopped
# matching anything the day the site's pages moved into `site/public/`, and it
# went on sitting in RECORD reading like a rule — the walk skipped nothing, and
# nothing said so. The comment above QUOTES_THE_OLD_SPELLING describes the same
# accident from the other side: a record was renamed, its SUFFIX match silently
# stopped firing, and 486 KB of legacy identifiers would have been reported as
# breaches. Both are one failure, an exemption that no longer reaches anything,
# and it is invisible in both directions — the list still reads as correct.
#
# The three lists match differently and the question is the same for all three:
# does this line still reach a file git tracks? RECORD names trees, GENERATED
# names one file exactly, QUOTES_THE_OLD_SPELLING matches a suffix.
# Every row of `MOVED` still says something true: the old path is gone and the
# new one is there. See the table's own comment for what it is for.
#
# **A row that lands in `ISSUES` lands in its archive once the folder is
# gone** (2026-10-12): the issue files' last commit, `ISSUES_ARCHIVED_AT`, is
# where the old paths are followed to, so such a row is asked of that commit's
# tree; where it names none it fails as the citations do, and where this
# clone cannot show it the row is a skip.
function redirects(@r: report.Report, present: [str], archive: Archive)
    if !floors.sound(@r, label: "records/redirects", found: MOVED.len(), floor: LEAST_MOVED, what: "rows in MOVED")
        return
    wrong: [str] @= []
    unread: [str] @= []

    for row in MOVED
        at = strings.index_of(text: row, needle: " -> ")

        if at.is_err()
            wrong @ wrong.push("    no ` -> ` in: " + row)
            continue
        written = strings.trimmed(row.slice(from: 0, to: at.must()))
        landed = strings.trimmed(row.slice(from: at.must() + 4, to: row.len()))

        archived = archive.state != "tree" && (landed == ISSUES || strings.starts_with(text: landed, prefix: ISSUES + "/"))

        if archived && archive.state == "read"
            if !selects_exactly(entry: landed, present: archive.paths) && !selects_tree(entry: landed, present: archive.paths)
                wrong @ wrong.push("    points at nothing at " + ISSUES_ARCHIVED_AT + ": " + row)
        else if archived && archive.state == "unreadable"
            unread @ unread.push("    " + row)
        else if archived
            wrong @ wrong.push("    lands in the archive, which " + archive.why + ": " + row)
        else if !selects_exactly(entry: landed, present: present) && !selects_tree(entry: landed, present: present)
            wrong @ wrong.push("    points at nothing: " + row)

        # **Only a row whose left side is a whole PATH can claim the old one is
        # gone.** Where it names a section — `docs/ROADMAP.md § The names` — the
        # file it opens with is still there and still right, and asserting its
        # absence would refuse the true rows. So this half runs on the plain
        # paths and says so, rather than being written to fire on everything and
        # quietly exempted later.
        if strings.index_of(text: written, needle: " §").is_err()
            if selects_exactly(entry: written, present: present) || selects_tree(entry: written, present: present)
                wrong @ wrong.push("    still there, so it did not move: " + row)

    if wrong.len() > 0
        report.keep_failure(
            @r,
            label: "records/redirects",
            detail: "  a redirect does not say something true:\n" + wrong.join("\n") + "\n  A record names the old path forever, so this table is the only thing that\n  keeps the citation followable. A row pointing at nothing is worse than no\n  row: it reads as an answer."
        )
    else
        report.keep_pass(@r)

    if unread.len() > 0
        report.keep_skip(
            @r,
            label: "records/redirects",
            detail: "  " + archive.why + ", so these rows were not asked of it:\n" + unread.join("\n")
        )

function exemptions(@r: report.Report, present: [str])
    dead: [str] @= []

    for entry in RECORD
        if !selects_tree(entry: entry, present: present)
            dead @ dead.push("    RECORD: " + entry)

    for entry in GENERATED
        if !selects_exactly(entry: entry, present: present)
            dead @ dead.push("    GENERATED: " + entry)

    for entry in QUOTES_THE_OLD_SPELLING
        if !selects_suffix(entry: entry, present: present)
            dead @ dead.push("    QUOTES_THE_OLD_SPELLING: " + entry)

    # THE OTHER ELEVEN LISTS, none of which was covered until 2026-09-12. Three
    # were checked and eleven were not, which is the same asymmetry this function
    # exists to close one level down: a list nobody asks about goes on reading
    # like a rule long after it stops selecting anything.
    for entry in HOMES
        if entry != "" && !selects_tree(entry: strings.without_suffix(text: entry, suffix: "/"), present: present)
            dead @ dead.push("    HOMES: " + entry)

    # `ISSUES` left this list on 2026-10-12: GitHub holds the issues, and the
    # folder is an archive no check reads as a list, gone once the coordinator
    # removes it (`ISSUES_ARCHIVED_AT`).
    for entry in [LEARNING, LEARNING_PAGE, MILESTONES]
        if !selects_tree(entry: entry, present: present)
            dead @ dead.push("    a named list: " + entry)

    for entry in APPEND_ONLY
        if !selects_exactly(entry: strings.words(entry)[0], present: present)
            dead @ dead.push("    APPEND_ONLY: " + entry)

    for entry in ENTRY_TREES
        if !selects_tree(entry: entry, present: present)
            dead @ dead.push("    ENTRY_TREES: " + entry)

    # AND THE INVERSE RULE, which is the only one of its kind here: a retired
    # root must select NOTHING. A root that comes back is not retired, and the
    # entry saying so would be a lie nobody reads twice.
    for entry in RETIRED_ROOTS
        if selects_tree(entry: entry, present: present)
            dead @ dead.push("    RETIRED_ROOTS, and it is back: " + entry)

    if dead.len() > 0
        report.keep_failure(
            @r,
            label: "records/exemptions",
            detail: "  an exemption selects no file this repository tracks:\n" + dead.join("\n") + "\n  Either the path moved, and the entry has to follow it, or nothing needs the\n  exemption any more and the line comes out. A rule that reaches nothing still\n  reads as a rule to whoever finds it next."
        )
    else
        report.keep_pass(@r)

function selects_tree(entry: str, present: [str]) -> bool
    for path in present
        if path == entry || strings.starts_with(text: path, prefix: entry + "/")
            return true

    return false

function selects_exactly(entry: str, present: [str]) -> bool
    for path in present
        if path == entry
            return true

    return false

function selects_suffix(entry: str, present: [str]) -> bool
    for path in present
        if strings.ends_with(text: path, suffix: entry)
            return true

    return false

# EVERY `paths:` GLOB OF A TREE-LOCAL RULE REACHES SOMETHING.
#
# `.claude/rules/*.md` load on a path match and cost nothing in the sessions that
# never go there (CLAUDE.md § Where the rest lives). That is the whole design,
# and it has one failure mode nobody could see: **nothing verifies that a rule
# still loads**. A directory moves, its glob stops matching, and the rule simply
# never arrives — no error, no red, no session the wiser. It is `exemptions`
# one level up, about the rules instead of the lists.
#
# The matcher is the prefix up to the first `*`, which is enough for every shape
# these files use: `docs/**` asks for `docs`, `selfhost/emit/ffi*` asks for
# `selfhost/emit/ffi` and is a partial FILE name, so the test is a plain prefix
# and not a tree.
function rules(@r: report.Report, present: [str])
    dead: [str] @= []
    globs: i64 @= 0

    # The walk is already in hand, so this asks nobody: a `shell.run` here would
    # spend a process AND write `stdout`, `stderr` and a listing into whatever
    # directory it was given, which is what the first draft did to the repository
    # root.
    for rule in present
        if !strings.starts_with(text: rule, prefix: ".claude/rules/") || !strings.ends_with(text: rule, suffix: ".md")
            continue
        text = read_file(rule)

        if text.is_err()
            dead @ dead.push("    cannot read " + rule)
            continue
        fences: i64 @= 0

        for row in strings.lines(text.must())
            if strings.trimmed(row) == "---"
                fences @ fences + 1

            if fences != 1
                continue

            if !strings.starts_with(text: strings.trimmed(row), prefix: "- ")
                continue
            glob = unquoted(strings.without_prefix(text: strings.trimmed(row), prefix: "- "))
            globs @ globs + 1

            if !selects_prefix(entry: prefix_of(glob), present: present)
                dead @ dead.push("    " + rule + ": `" + glob + "` reaches nothing")

    if globs == 0
        report.keep_failure(
            @r,
            label: "records/rules",
            detail: "  no `paths:` glob was read at all, so this check would pass however the\n  rules were pointed. Either `.claude/rules` moved, or the frontmatter stopped\n  being the shape this reader knows."
        )
        return

    if dead.len() > 0
        report.keep_failure(
            @r,
            label: "records/rules",
            detail: "  a tree-local rule points at nothing, so it never loads:\n" + dead.join("\n") + "\n  A rule that cannot be reached still reads as a rule to whoever finds it, and\n  nothing else in this repository would have said so. Repoint the glob, or take\n  the line out because nothing needs the rule any more."
        )
    else
        report.keep_pass(@r)

# The part of a glob before its first `*`: `docs/**` gives `docs`, and
# `selfhost/emit/ffi*` gives `selfhost/emit/ffi`.
function prefix_of(glob: str) -> str
    at = strings.index_of(text: glob, needle: "*")

    if at.is_err()
        return glob
    cut = glob.slice(from: 0, to: at.must())

    if strings.ends_with(text: cut, suffix: "/")
        return cut.slice(from: 0, to: cut.len() - 1)

    return cut

function unquoted(text: str) -> str
    out: str @= text

    if strings.starts_with(text: out, prefix: "\"")
        out @ out.slice(from: 1, to: out.len())

    if strings.ends_with(text: out, suffix: "\"")
        out @ out.slice(from: 0, to: out.len() - 1)

    return out

function selects_prefix(entry: str, present: [str]) -> bool
    for path in present
        if path == entry || strings.starts_with(text: path, prefix: entry)
            return true

    return false

# THE APPEND-ONLY RULE HAD NO EXECUTOR UNTIL THIS BLOCK, AND THAT IS MEASURED
# RATHER THAN SUSPECTED.
#
# CLAUDE.md §14 says a record is never rewritten: a falsified sentence is
# corrected underneath, with its date, never deleted. Four documents state it —
# the contract, `.claude/rules/records.md`, this file's own RECORD comment, and
# `docs/work/DONE.md`'s preamble — and until 2026-09-12 nothing performed it.
# Commit `76799a18` removed one `- [x]` line from the record and every suite
# stayed green. A rule stated everywhere and executed nowhere is CL-031's story,
# told here about the rule those four documents exist to protect.
#
# THE WINDOW IS THE WORKING TREE, NOT THE LAST COMMIT, and the choice is
# deliberate twice over. It speaks while the deletion is still yours to undo,
# which is when a warning is worth anything; and `git diff HEAD` needs no
# history, so it reads the same on this Mac and in a CI leg whose checkout is
# `fetch-depth: 1` and has no `HEAD~1` to compare against. A check that could
# only run where the history is deep would be a check that never ran in CI.
#
# The number is the record's FIRST LINE, not its banner's: two of the three
# records have no banner at all. Above it is the preamble, which is prose
# somebody may correct — `7c2198ff` rewrote eighteen lines of DONE's and was
# right to. Below it is the record.
constant APPEND_ONLY: [str]
    [
        "docs/records/contract/case-law.md 34"
    ]

function appended(@r: report.Report, scratch: str)
    offences: [str] @= []

    if APPEND_ONLY.len() == 0
        report.keep_failure(
            @r,
            label: "records/appended",
            detail: "  this list is empty, so this check guards nothing and passes for the\n  wrong reason. Every record that grows BY LINE belongs here; one that\n  grows by FILE belongs in ROTATED, where its height is pinned instead."
        )
        return

    for entry in APPEND_ONLY
        fields = strings.words(entry)

        if fields.len() != 2
            offences @ offences.push("    " + entry + " is not `<path> <first record line>`")
            continue
        floor = strings.to_number(fields[1]).default(0)

        if floor == 0
            offences @ offences.push("    " + entry + " does not name a line number")
            continue
        diffed = shell.run(
            scratch: scratch,
            program: "git",
            words: ["git", "diff", "HEAD", "--", fields[0]]
        )

        if diffed.is_err()
            offences @ offences.push("    cannot ask git what the working tree changed in " + fields[0])
            continue

        for row in removed_below(text: diffed.must().out, floor: floor)
            offences @ offences.push("    " + fields[0] + ": " + row)

    # **A CLOSED QUESTION OF `LEARNING` IS A RECORD FROM ITS FIRST LINE**, having
    # no card (2026-10-05), and an open one is a living item that may be edited,
    # ticked included. So each question the working tree changes is asked as
    # HEAD holds it: closed there, no line of it may go. **The issue files left
    # this half on 2026-10-12**: a closed issue was a record below its card, and
    # since the author's seven answers GitHub holds the issues, the folder an
    # archive no check reads, so nothing here asks it.
    tree_diff = shell.run(scratch: scratch, program: "git", words: ["git", "diff", "HEAD", "--", LEARNING])

    if tree_diff.is_err()
        offences @ offences.push("    cannot ask git what the working tree changed in " + LEARNING)
    else
        floors_at: {str: i64} @= {}

        for removal in removed_by_file(tree_diff.must().out)
            if !is_entry_name(strings.base_name(removal.path))
                continue

            if floors_at[removal.path].is_err()
                floors_at[removal.path] @ closed_floor_at_head(scratch: scratch, path: removal.path)
            closed_floor = floors_at[removal.path].must()

            if closed_floor > 0 && removal.line >= closed_floor
                offences @ offences.push("    " + removal.path + ": " + removal.row)

    if offences.len() > 0
        report.keep_failure(
            @r,
            label: "records/appended",
            detail: "  a line is being removed from a record:\n" + offences.join("\n") + "\n  A record is never rewritten (CLAUDE.md §14). Where the sentence has since\n  been falsified, the correction is ADDED UNDERNEATH with its date: a\n  measurement that was right when it was taken is history, and a record that\n  quietly loses its inconvenient half is worth less than none.\n  The preamble above the record's first line is not covered and may be edited."
        )
    else
        report.keep_pass(@r)

# One line a diff removes: the file, its line in the old file, and the line.
record Removal
    path: str
    line: i64
    row: str

# Every line a diff of MANY files removes, each with its file. A file's own
# header opens a new file and ends the last one's hunks, which is the one thing
# `removed_below` never had to know: it reads a diff of one file, and there
# `--- a/x` comes before the first `@@`. Here it comes after another file's.
function removed_by_file(text: str) -> [Removal]
    out: [Removal] @= []
    path: str @= ""
    old: i64 @= 0
    started: bool @= false

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "diff --git ")
            started @ false
            at = strings.index_of(text: row, needle: " b/")

            if at.is_err()
                path @ ""
            else
                path @ row.slice(from: at.must() + 3, to: row.len())
        else if strings.starts_with(text: row, prefix: "@@ -")
            old @ hunk_start(row)
            started @ true
        else if started
            if strings.starts_with(text: row, prefix: "-")
                out @ out.push(Removal(path: path, line: old, row: strings.trimmed(row)))
                old @ old + 1
            else if !strings.starts_with(text: row, prefix: "+")
                old @ old + 1

    return out

# The first line of a question as HEAD holds it, a question carrying no card,
# when it was closed there; 0 when it was open, or new. The caller asks once a
# file. (A card, where one stood, was stepped over: the reading of an issue file
# until 2026-10-12.)
function closed_floor_at_head(scratch: str, path: str) -> i64
    shown = shell.run(scratch: scratch, program: "git", words: ["git", "show", "HEAD:" + path])

    if shown.is_err() || shown.must().code != 0
        return 0
    issue = cards.issue_of(path: path, text: shown.must().out)

    if issue.open
        return 0

    return issue.first

# The lines a working-tree diff removes at or below `floor`, read out of the
# hunk headers rather than out of the file. A unified diff carries its own
# numbering — `@@ -240,7 +240,9 @@` says the next old line is 240 — so where a
# removal lands is readable without opening anything.
#
# Nothing before the first `@@` is counted: `--- a/x` and `+++ b/x` open with
# the same bytes as a removal and an addition, and reading them as content is
# how a diff parser reports the file header as a deleted line.
function removed_below(text: str, floor: i64) -> [str]
    out: [str] @= []
    old: i64 @= 0
    started: bool @= false

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "@@ -")
            old @ hunk_start(row)
            started @ true
        else if started
            if strings.starts_with(text: row, prefix: "-")
                if old >= floor
                    out @ out.push(strings.trimmed(row))
                old @ old + 1
            else if !strings.starts_with(text: row, prefix: "+")
                old @ old + 1

    return out

# The old-file line a hunk opens at: 240, out of `@@ -240,7 +240,9 @@`. A
# header this cannot read yields 0, which `removed_below` then compares against
# a floor of at least 1 — so an unreadable header reports every removal in that
# hunk rather than none. The loud direction (`.claude/rules/module-shape.md`).
function hunk_start(row: str) -> i64
    rest = strings.without_prefix(text: row, prefix: "@@ -")
    end: i64 @= 0

    while end < rest.len()
        byte = rest[end]

        if byte < '0' || byte > '9'
            break
        end @ end + 1

    if end == 0
        return 0

    return strings.to_number(rest.slice(from: 0, to: end)).default(0)

# The `NNN` of `- [ ] **NNN — title**`, or the empty string where the line is
# not a defect item. It asks the value in hand — this row's own bytes — and
# never how many defects the project is supposed to have. The number is read
# as `issued_digits` reads one, so the thousandth defect's line has one.
function defect_number(row: str) -> str
    marker: str @= ""

    if strings.starts_with(text: row, prefix: "- [ ] **")
        marker @ "- [ ] **"

    if strings.starts_with(text: row, prefix: "- [x] **")
        marker @ "- [x] **"

    if marker == ""
        return ""
    rest = strings.without_prefix(text: row, prefix: marker)
    digits = issued_digits(rest)

    if digits == 0
        return ""

    # Digits are ASCII, so the cut stands between characters.
    number = rest.slice(from: 0, to: digits)

    if !strings.starts_with(text: strings.without_prefix(text: rest, prefix: number), prefix: " — ")
        return ""

    return number

# How many bytes of a defect number open `text`, or 0 where none does: three
# digits or more, padded with zeros to three and never past three, so `009`,
# `277` and `1000` are numbers and `99` and `0999` are not (a second spelling
# of 999 would let two files name one defect). **It read exactly three until
# defect 280 (2026-10-04)**, so the thousandth defect would have had no name
# `records/defects` accepted and no line any count could read (both read the
# files of `issues/`, and left with them on 2026-10-12).
function issued_digits(text: str) -> i64
    count: i64 @= 0

    while count < text.len() && text[count] >= '0' && text[count] <= '9'
        count @ count + 1

    if count < 3 || count > 3 && text[0] == '0'
        return 0

    return count

function is_among(needle: str, seen: [str]) -> bool
    for one in seen
        if one == needle
            return true

    return false

# NO TRACKED FILE CARRIES A MERGE CONFLICT MARKER.
#
# This is the way to fail that working in parallel introduces, and the one no
# other check here can see: a resolution left half-finished enters a commit and
# stays, and every reader in this file — the citation walk, the English walk,
# the list reader — takes the marker for ordinary prose and carries on. It is
# loud the moment somebody looks and invisible until then.
#
# GIT IS ASKED RATHER THAN THE FILES. `git grep` reads the index in one
# process, over exactly the paths git tracks, which is the same oracle
# `project_files` uses and a fraction of the cost of reading every file again.
#
# THE PATTERN IS BUILT AND NOT WRITTEN, and that is not a flourish: an
# instrument that looked for a marker by spelling one out would report ITSELF
# on its first run, and the lesson a reader would take from that is that this
# check cannot be trusted.
function unmerged(@r: report.Report, scratch: str)
    opening = repeat("<", 7)
    closing = repeat(">", 7)
    found = shell.run(
        scratch: scratch,
        program: "git",
        words: ["git", "grep", "-l", "-E", "^(" + opening + "|" + closing + ") "]
    )

    if found.is_err()
        report.keep_failure(
            @r,
            label: "records/unmerged",
            detail: "  cannot ask git whether a tracked file carries a conflict marker"
        )
        return
    run = found.must()

    if run.code == 1
        # git grep exits 1 when it matched nothing, which is the ordinary state
        # of this repository and the only quiet outcome here.
        report.keep_pass(@r)
        return

    if run.code != 0
        report.keep_failure(
            @r,
            label: "records/unmerged",
            detail: "  git grep exited " + run.code.to_str() + ", so nothing was searched:\n    " + strings.trimmed(run.err)
        )
        return
    files: [str] @= []

    for row in strings.lines(run.out)
        if strings.trimmed(row) != ""
            files @ files.push("    " + strings.trimmed(row))

    report.keep_failure(
        @r,
        label: "records/unmerged",
        detail: "  a tracked file carries an unresolved merge conflict:\n" + files.join("\n") + "\n  Every other check here reads the marker as prose and passes. Resolve the\n  conflict in the file, then run this suite again."
    )

# A TREE OF ENTRIES, READ IN NAME ORDER (`.claude/rules/records.md` § A tree of
# entries). The story beats are one file each, `YYYY-MM-DD-HHMM-<slug>.md`, and
# the directory read in name order is the book's chronology, so the name is the
# one thing this asks of each, and that the tree holds anything at all.
#
# **There were maps until 2026-10-05**: `docs/records/book/beats.md`,
# `docs/design/DESIGN-LOG.md` and `docs/work/DONE.md` stayed behind at the
# heights of the records they were rotated from, so that a `<map>:NNN` citation
# landed where it always had, and `rotated` and `positions` held them to it. The
# author deleted all three that day, meant as: *I prefer cleanliness for the
# future to keeping the historical legacy*. Every living citation by line was
# resolved to the file it named first; the ones inside dated records read
# against the maps as they stand at `d8a9913e`, the last commit that held them.
constant ENTRY_TREES: [str]
    [
        "docs/records/book/beats"
    ]

function entries(@r: report.Report, present: [str])
    offences: [str] @= []

    for tree in ENTRY_TREES
        held: i64 @= 0

        for path in present
            if strings.starts_with(text: path, prefix: tree + "/")
                held @ held + 1

                if !is_entry_name(strings.base_name(path))
                    offences @ offences.push(
                        "    " + path + " is not named `YYYY-MM-DD-HHMM-<slug>.md`, and the directory is read in name order"
                    )

        if held == 0
            offences @ offences.push(
                "    " + tree + " holds nothing, so this check read zero entries and would pass whatever the record had lost"
            )

    if offences.len() > 0
        report.keep_failure(
            @r,
            label: "records/entries",
            detail: "  a tree of dated entries is not in the shape its order rests on:\n" + offences.join("\n") + "\n  An entry is a NEW FILE named for its day and its place in that day; the directory\n  read in name order is the chronology, and no index of it is kept."
        )
    else
        report.keep_pass(@r)

# `YYYY-MM-DD-HHMM-<slug>.md`, and nothing else, because the directory is read
# in NAME order and that order is what CLAUDE.md § RUN IT's *read forward* rests
# on. The minute is a position rather than a clock reading for every entry
# written before the rotation: a historical entry has no time, and two entries
# of one day still have an order.
function is_entry_name(name: str) -> bool
    if !strings.ends_with(text: name, suffix: ".md")
        return false

    if name.len() < 20
        return false
    shape = "nnnn-nn-nn-nnnn-"
    i: i64 @= 0

    while i < shape.len()
        want = shape[i]
        byte = name[i]

        if want == 'n' && (byte < '0' || byte > '9')
            return false

        if want == '-' && byte != '-'
            return false
        i @ i + 1

    rest = name.slice(from: shape.len(), to: name.len() - 3)

    if rest.len() == 0
        return false
    j: i64 @= 0

    while j < rest.len()
        byte = rest[j]
        lower = byte >= 'a' && byte <= 'z'
        digit = byte >= '0' && byte <= '9'

        if !lower && !digit && byte != '-'
            return false
        j @ j + 1

    return true

# No living file names a numbered milestone.
#
# If this fires on a file you just wrote: the identifier is a name now —
# the map is `docs/roadmap/names.md` and the algorithm is CLAUDE.md
# §14. If the file is a dated record, add it to RECORD and say why in the
# commit.
function numbered(@r: report.Report, living: [str])
    offenders: [str] @= []

    for path in living
        text = read_file(path)

        if text.is_err()
            continue
        found = numbered_in(text.must())

        if !found.is_err()
            offenders @ offenders.push("    " + path + ": " + found.must())

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/numbered",
            detail: "  a living file names a numbered milestone — §14 says identifiers are names:\n" + offenders.join("\n")
        )
    else
        report.keep_pass(@r)

# Every `M-<name>` in use has a row in the ROADMAP's alias table, and the
# table has the number of rows it had. The map is parsed out of the
# ROADMAP so the table cannot drift from the tree in EITHER direction: a
# new milestone with no row fails here, and so does a row nobody uses
# being the only place a name exists.
function named(@r: report.Report, living: [str])
    table = alias_table()

    if table.len() != ROWS
        report.keep_failure(
            @r,
            label: "records/table",
            detail: "  the alias table has " + table.len().to_str() + " rows, not " + ROWS.to_str()
        )
    known: {str: bool} @= {}

    for row in table
        known[row] @ true

    for name in REFUSED
        known[name] @ true

    unknown: [str] @= []

    for path in living
        text = read_file(path)

        if text.is_err()
            continue

        for name in names_used(text.must())
            if known[name].is_err()
                unknown @ unknown.push("    " + path + ": " + name)

    if unknown.len() > 0
        report.keep_failure(
            @r,
            label: "records/names",
            detail: "  a name with no row in the alias table:\n" + unknown.join("\n")
        )
    else
        report.keep_pass(@r)

# Every section of the operating contract a LIVING file points at is a section
# that contract still has.
#
# **This is the third blind spot, and finding it is what turned a renumbering
# into a refusal.** Measured 2026-09-07: `CLAUDE.md` section numbers are cited
# 3280 times across this repository, **2599 of them inside records that §14
# forbids anybody to rewrite** and **346 in commit bodies**, which cannot be
# edited at all. Nothing verified a section number. So renaming `§7` to anything
# would have made every one of those pointers wrong, in silence, with the whole
# net green: the dead-citation check reads paths and stops at the first colon
# followed by a digit, and a section number is neither a path nor a line.
#
# The numbers are therefore permanent, which the contract now says in its own
# § Where the rest lives. What this check holds is the half still movable: a live
# document may not point at a section that is not there. Records are exempt by
# construction, because it walks `living`: a record's pointer is history, and
# §14 has it corrected underneath rather than edited.
#
# Both spellings in use are read, `CLAUDE.md §14` and `CLAUDE.md § 7`. A named
# section, `CLAUDE.md § Hard stops`, carries no number and is not this check's
# business: nothing cites a title but the harness's own comments, and a title is
# free to change.
function sections(@r: report.Report, living: [str])
    text = read_file(CONTRACT)

    if text.is_err()
        report.keep_failure(@r, label: "records/sections", detail: "  " + CONTRACT + " cannot be read")
        return
    present = numbered_headings(text.must())

    # The floor, and it is the shape this check would fail in: a heading style
    # this reader does not recognise leaves the map empty, and every citation in
    # the tree then passes for the wrong reason.
    if present.len() == 0
        report.keep_failure(
            @r,
            label: "records/sections",
            detail: "  " + CONTRACT + " has no `## N.` heading this reader can see, so every citation in the tree would pass vacuously"
        )
        return
    known: {str: bool} @= {}

    for number in present
        known[number] @ true

    offenders: [str] @= []

    for path in living
        body = read_file(path)

        if body.is_err()
            continue

        for number in unknown_sections(text: body.must(), known: known)
            offenders @ offenders.push("    " + path + ": section " + number)

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/sections",
            detail: "  a living file points at a section of " + CONTRACT + " that does not exist:\n" + offenders.join("\n") + "\n  The numbered sections do not move: they are cited 3280 times, 2599 of those\n  inside records nobody may rewrite and 346 in commit bodies. So this is a\n  citation to repair, never a section to renumber."
        )
    else
        report.keep_pass(@r)

# The `## N.` headings of the contract, by number.
function numbered_headings(text: str) -> [str]
    found: [str] @= []

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "## ")
            at = strings.index_of(text: row, needle: ".")

            if !at.is_err() && at.must() > 3
                number = row.slice(from: 3, to: at.must())

                if all_digits(number)
                    found @ found.push(number)

    return found

# The sections a text cites and the contract does not have.
function unknown_sections(text: str, known: {str: bool}) -> [str]
    missing: [str] @= []

    for number in sections_cited(text)
        state = known[number]

        if state.is_err()
            missing @ missing.push(number)

    return missing

# Every contract section a text points at. A byte walk, like every other reader
# in this file, and it has to know that `§` is TWO bytes in UTF-8, 0xC2 0xA7:
# there is no character index here to trust.
function sections_cited(text: str) -> [str]
    found: [str] @= []
    marker = CONTRACT + " "
    i: i64 @= 0

    while i < text.len()
        if text[i] == marker[0] && marked_at(text: text, at: i, needle: marker)
            at: i64 @= i + marker.len()

            if at + 1 < text.len() && text[at] == 194 && text[at + 1] == 167
                at @ at + 2

                if at < text.len() && text[at] == 32
                    at @ at + 1
                last: i64 @= at

                while last < text.len() && is_digit(text[last])
                    last @ last + 1

                if last > at
                    found @ found.push(text.slice(from: at, to: last))
                i @ last
            else
                i @ i + 1
        else
            i @ i + 1

    return found

# Whether `needle` sits at `at`. `strings.index_of` answers the same question
# from the start of the text only, and this walk needs it at an offset.
function marked_at(text: str, at: i64, needle: str) -> bool
    if at + needle.len() > text.len()
        return false
    k: i64 @= 0

    while k < needle.len()
        if text[at + k] != needle[k]
            return false
        k @ k + 1

    return true

# `all_digits` is further down this file, where `item_milestone` already needed
# it: one file is one module, so the second copy this check first carried was a
# `declared_twice` error at the first build, which is the language doing the job
# CLAUDE.md's preamble asks a reader to do.

# No C file lives outside the directories that own C, unless a program beside
# it names it in an `extern`.
#
# This exists because a throwaway that measured `__builtin_classify_type`
# was left in the repository root and `git add -A` committed and pushed it
# (2026-08-14). The list is of DIRECTORIES that own C, not of file names:
# a new runtime part or a fifth spike needs no edit here.
#
# **And a header a program claims is owned by that program** (2026-09-09).
# `examples/gallery/13-lease.hero` teaches text that a C library KEEPS, and no
# library the three platforms share keeps a `const char *` it is handed, so the
# lesson carries its own seven lines of C beside it, as
# `tests/golden/run/lease-c-keeps-the-pointer.h` already did inside a record.
# The cheap repair was to list `examples/gallery/` here, and a directory is
# wider than the fact: the header is legitimate because a `.hero` in the same
# directory says `extern "13-lease.h"`, so that is what is read, and a stray
# `probe.c` in the gallery is still reported.
function c_files(@r: report.Report, living: [str])
    # No leading `./`: `git ls-files` spells a path from the repository root,
    # where `find .` spelled it from the current directory.
    # `docs/platforms/` since 2026-10-08: a probe written by hand for one
    # machine lives with that machine's page, as defect 463's does, run on a
    # Linux with SELinux enforcing, which no leg of the net is.
    owns: [str] = ["runtime/", "tools/spike/", "seed/", "docs/platforms/"]
    strays: [str] @= []

    for path in living
        if !strings.ends_with(text: path, suffix: ".c") && !strings.ends_with(text: path, suffix: ".h")
            continue
        owned: bool @= false

        for dir in owns
            if strings.starts_with(text: path, prefix: dir)
                owned @ true

        if !owned && !claimed(path: path, living: living)
            strays @ strays.push("    " + path)

    if strays.len() > 0
        report.keep_failure(
            @r,
            label: "records/c",
            detail: "  a C file outside the directories that own C, and no program beside it names it in an `extern`:\n" + strays.join("\n")
        )
    else
        report.keep_pass(@r)

# Whether a `.hero` in the same directory as this C file names it in an
# `extern`. Only programs BESIDE the file count: the compiler resolves a quoted
# header next to the program that names it, so a claim from another directory
# would be a claim the build itself does not honour.
function claimed(path: str, living: [str]) -> bool
    header = strings.base_name(path)
    dir = path.slice(from: 0, to: path.len() - header.len())

    for other in living
        if !strings.ends_with(text: other, suffix: ".hero") || !beside(other: other, dir: dir)
            continue
        text = read_file(other)

        if !text.is_err() && names_header(text: text.must(), header: header)
            return true

    return false

# Whether `text` carries a line `extern "<header>"` at column zero, which is
# where every `extern` in this tree stands. A quoted header is the one the
# compiler looks for beside the program; `<header>` is the system's and claims
# nothing here. A mention in a comment or in prose is not a claim.
function names_header(text: str, header: str) -> bool
    for line in strings.lines(text)
        if strings.starts_with(text: line, prefix: "extern \"" + header + "\"")
            return true

    return false

# Whether `other` lives in exactly `dir`, the directory spelled with its
# trailing slash as `claimed` cuts it.
function beside(other: str, dir: str) -> bool
    base = strings.base_name(other)
    return other.slice(from: 0, to: other.len() - base.len()) == dir

test "a C file is claimed by an `extern` at column zero in a program beside it, and by nothing else"
    assert names_header(text: "use strings\n\nextern \"13-lease.h\"\n", header: "13-lease.h")
    assert names_header(text: "extern \"13-lease.h\" link \"m\"\n", header: "13-lease.h")

    # A mention in prose, the system spelling, a different header, and the
    # same header indented, which no `extern` in this tree is.
    assert !names_header(text: "# see `13-lease.h`, beside this file\n", header: "13-lease.h")
    assert !names_header(text: "extern <13-lease.h>\n", header: "13-lease.h")
    assert !names_header(text: "extern \"sqlite3.h\" link \"sqlite3\"\n", header: "13-lease.h")
    assert !names_header(text: "    extern \"13-lease.h\"\n", header: "13-lease.h")

    assert beside(other: "examples/gallery/13-lease.hero", dir: "examples/gallery/")
    assert !beside(other: "examples/13-lease.hero", dir: "examples/gallery/")
    assert !beside(other: "examples/gallery/deeper/13-lease.hero", dir: "examples/gallery/")
    assert !beside(other: "tests/golden/run/13-lease.hero", dir: "examples/gallery/")

# Directories this repository HAS HAD, beside the ones it has. **Panel 086's
# measured hole, closed rather than recorded**: anchoring a claim on directories
# that exist TODAY is self-adjusting in the wrong direction, because a citation
# into a tree that was archived stops being a claim on the very day it most needs
# to be one. Measured 2026-08-19, one commit after the check landed: 6 passed,
# three dead citations unseen. These four are retirements the record already
# documents, and this list grows only when something is retired.
# **Where a moved file went, so a citation in a record can still be followed.**
#
# A record is never rewritten (`.claude/rules/records.md`), so a path named
# inside one is named forever — and `records/citations` skips records by
# construction, which means those citations are checked by NOTHING. Measured
# 2026-09-12, before `design.md` moved: **1498** citations named it and **961**
# were inside records, of which **272** carried a line number. Moving it without
# this table would not have turned a check red; it would have gone quiet, which
# is the failure this repository keeps finding in itself.
#
# What the table buys is exactly one thing, said narrowly: a reader who meets
# `design.md:2869` in a record of 2026-08-12 can find the file it meant. It does
# NOT promise line 2869 still says what it said — nothing could, and that is
# what a citation's DATE is for (CL-037).
#
# `records/redirects` keeps it honest in both directions: the left side must be
# gone from the tree, or the row is a redirect for a file that never moved, and
# the right side must be present, or the row points at nothing.
constant MOVED: [str]
    [
        "docs/work/learn -> docs/learn"
        "docs/learn/LEARN.md -> docs/learn"
        "design.md -> docs/design.md"
        "DESIGN-LOG.md -> issues"
        "docs/ROADMAP.md § The names -> docs/roadmap/names.md"
        "docs/ROADMAP.md § Verify it yourself -> docs/roadmap/verify.md"
        "docs/ROADMAP.md § What production-ready means -> docs/roadmap/production-ready.md"
        "docs/ROADMAP.md § The milestones, one by one -> docs/roadmap/milestones"
        "docs/ROADMAP.md § Decisions this file records -> docs/roadmap/shape.md"
        "docs/ROADMAP.md § Who scheduled what -> docs/roadmap/scheduling.md"
        "docs/ref/environment/linux/Dockerfile -> docs/platforms/linux/Dockerfile.amd64"
        "docs/design/design.md -> docs/design.md"
        "docs/ref/assets -> docs/assets"
        "docs/ref/environment -> docs/platforms"
        "docs/ref/glossary -> docs/learn/glossary"
        "docs/roadmap/decisions.md -> docs/roadmap/shape.md"
        "docs/work/DECIDE.md -> issues/README.md"
        "docs/work/DEFECTS.md -> issues/README.md"
        "docs/work/defects -> issues"
        "docs/design/DESIGN-LOG.md -> issues"
        "docs/work/DONE.md -> issues"
        "docs/records/book/beats.md -> docs/records/book/beats"
        "docs/work/milestones -> docs/roadmap/milestones"
        "docs/roadmap/milestones.md -> docs/roadmap/milestones"
        "docs/records/done -> issues"
        "docs/records/log -> issues"
        "harness -> docs/metrics"
        "harness/mutations -> docs/metrics"
        "harness/prompts -> docs/metrics"
        "harness/tasks -> docs/metrics"
        "harness/tasks/README.md -> docs/metrics/tasks.md"
    ]

# The floor. A table that has emptied out is a table nobody is maintaining, and
# an empty loop passes.
constant LEAST_MOVED: i64
    31

constant RETIRED_ROOTS: [str]
    [
        "crates"
        "docs/debrief"
        "docs/defects"
        "docs/reasoning"
        "docs/records/done"
        "docs/records/log"
        "docs/work/defects"
        "docs/work"
        "docs/ref"
        "docs/design"
        "harness"
    ]

# Where this repository's prose puts a module when it writes the SHORT name.
# `ir/lower.hero` means `selfhost/ir/lower.hero`, and every document in the tree
# writes it that way; so does `parts/thread.c` for `runtime/parts/thread.c`. A
# checker that does not know the house shorthand shouts at correct prose, which
# is the 52%-false-positive rule panel 086 measured and refused.
constant HOMES: [str]
    [
        ""
        "selfhost/"
        "tests/"
        "tests/harness/"
        "runtime/"
        "examples/"
        "docs/"
        "site/"
        "site/src/"
        "tests/golden/"
        ".claude/skills/"
        "archive/bootstrap-rs/"
        "archive/bootstrap-rs/heroes/"
        "archive/bootstrap-rs/heroes/src/"
        "archive/bootstrap-rs/heroes-cli/"
        "archive/bootstrap-rs/heroes-cli/src/"
    ]

# Whether this line is a human writing to a human, which is the only place a
# CITATION can be. A path inside a string literal is DATA: a `NOSUCH.md` under `docs/` in
# a test is the fixture that proves the compiler says *no such file*, and a
# checker that reads it reports the test as the defect. Measured before this
# rule existed: of 299 candidates in live files, 5 whole classes were code and
# not prose.
function is_prose(document: str, row: str) -> bool
    if strings.ends_with(text: document, suffix: ".md")
        return true
    t = strings.trimmed(row)

    if strings.starts_with(text: t, prefix: "#")
        return true

    if strings.starts_with(text: t, prefix: "//")
        return true

    if strings.starts_with(text: t, prefix: "*")
        return true
    return strings.starts_with(text: t, prefix: "/*")

# The punctuation a citation sits inside, turned to space so `words` can cut it:
# backticks, quotes, brackets and the separators prose puts between two paths.
function unpunctuated(row: str) -> str
    out: [str] @= []

    for ch in row.chars()
        if ch == "`" || ch == "\"" || ch == "'" || ch == "(" || ch == ")" || ch == "[" || ch == "]" || ch == "," || ch == ";"
            out @ out.push(" ")
        else
            out @ out.push(ch)

    return out.join("")

# A citation may end in a line or a line RANGE — `stack.c:202-213`, `x.hero:5:12`
# — and the path claim is the half before the first `:` that is followed by a
# digit. Cutting it is the same move `without_member` makes for `::name`.
# **Byte offsets and not character offsets, and the difference is a panic.**
# `.chars()` counts characters and `slice` cuts bytes; the two agree on ASCII
# and part company on the first accented word in a comment. Measured: this
# function read a character index into a byte slice and the suite died with
# `panic: string slice splits a character` on the real tree.
function without_position(token: str) -> str
    i: i64 @= 0

    while i + 1 < token.len()
        if token[i] == ':' && is_digit(token[i + 1])
            return token.slice(from: 0, to: i)
        i @ i + 1

    return token

# Leading and trailing prose punctuation. A sentence ends and a citation does
# not: `runtime/parts/desc.c.` names a file whose name has no full stop.
function unedged(token: str) -> str
    first: i64 @= 0
    past: i64 @= token.len()

    while first < past && (token[first] == '*' || token[first] == ':')
        first @ first + 1

    while past > first && (token[past - 1] == '.' || token[past - 1] == '*' || token[past - 1] == ':' || token[past - 1] == '?' || token[past - 1] == '!')
        past @ past - 1

    return token.slice(from: first, to: past)

# `syntax/{decl,data}.rs` is TWO claims, and until 2026-09-06 it was none: the
# brace form is one of the two shapes panel 086 measured this check cannot read,
# and it is 26 citations in `selfhost/` alone. Expanding it is not a heuristic —
# it is the shell's own semantics, exactly.
function expanded(token: str) -> [str]
    open_at = strings.index_of(text: token, needle: "{")

    if open_at.is_err()
        return [token]
    close_at = strings.index_of(text: token, needle: "}")

    if close_at.is_err() || close_at.must() < open_at.must()
        # A brace form wrapped across two lines — `emit/{ctype,\n typedefs}.rs`.
        # Half a token is half a promise, and neither half is checkable, so the
        # line says nothing rather than something false.
        return []
    before = token.slice(from: 0, to: open_at.must())
    after = token.slice(from: close_at.must() + 1, to: token.len())
    out: [str] @= []

    for part in strings.split_text(text: token.slice(from: open_at.must() + 1, to: close_at.must()), separator: ",")
        for one in expanded(before + strings.trimmed(part) + after)
            out @ out.push(one)

    return out

# Whether the line carries its own evidence for a path that does not resolve.
# **This is what replaces an exemption list**, and it is not a new rule: it is
# the sentence this check's own failure message already asks for — *if the claim
# is dated history, say so in the sentence and point at where the bytes are
# now*. A list of exempt paths is a second place where truth lives, and this
# repository's record is a long account of second places going stale.
function is_dated(row: str) -> bool
    cs = row.chars()
    i: i64 @= 0

    while i + 9 < cs.len()
        if four_digits(cs, at: i) && cs[i + 4] == "-" && two_digits(cs, at: i + 5) && cs[i + 7] == "-" && two_digits(cs, at: i + 8)
            return true
        i @ i + 1

    return false

function four_digits(cs: [str], at: i64) -> bool
    return two_digits(cs, at: at) && two_digits(cs, at: at + 2)

function two_digits(cs: [str], at: i64) -> bool
    if at + 1 >= cs.len()
        return false

    if cs[at].len() != 1 || !is_digit(cs[at][0])
        return false
    return cs[at + 1].len() == 1 && is_digit(cs[at + 1][0])

# Does this token name something, resolved the way a READER resolves it? From
# the repository root when it starts at one; through the house shorthand
# (`HOMES`); and from the citing file's own directory or any directory above
# it, which is how a relative pointer inside a package is followed. Every
# expansion of a brace form must name something: `syntax/{decl,data}.rs` is a
# promise about two files and half a promise is a broken one.
function names_something(token: str, document: str, known: {str: bool}) -> bool
    for part in expanded(token)
        if !one_names(part: part, document: document, known: known)
            return false

    return true

# Where `part` went, or the empty string. The left side of a `MOVED` row, up to
# its first ` §` where it names a section.
function moved_to(part: str) -> str
    for row in MOVED
        at = strings.index_of(text: row, needle: " -> ")

        if at.is_err()
            continue
        written = strings.trimmed(row.slice(from: 0, to: at.must()))
        mark = strings.index_of(text: written, needle: " §")
        head: str @= written

        if !mark.is_err()
            head @ strings.trimmed(written.slice(from: 0, to: mark.must()))

        # A directory is cited with its slash as often as without, and a row
        # names it without: `docs/records/done/` is the row `docs/records/done`.
        if head == part || head + "/" == part
            return strings.trimmed(row.slice(from: at.must() + 4, to: row.len()))

    return ""

# A file of a directory that MOVED names something where the same file stands
# under the directory it moved to: `docs/work/milestones/M-issue-files.md` is
# `docs/roadmap/milestones/M-issue-files.md` since 2026-10-05. Asked of the file, never of
# the directory alone, so a citation of a file that is gone stays dead.
function moved_under(part: str, known: {str: bool}) -> bool
    for row in MOVED
        at = strings.index_of(text: row, needle: " -> ")

        if at.is_err()
            continue
        written = strings.trimmed(row.slice(from: 0, to: at.must()))

        if !strings.index_of(text: written, needle: " §").is_err() || !strings.starts_with(text: part, prefix: written + "/")
            continue
        landed = strings.trimmed(row.slice(from: at.must() + 4, to: row.len()))

        if !known[landed + "/" + strings.without_prefix(text: part, prefix: written + "/")].is_err()
            return true

    return false

function one_names(part: str, document: str, known: {str: bool}) -> bool
    if !known[part].is_err()
        return true

    # **A path that MOVED still names something**, and this is what lets a
    # citation keep the short spelling a reader knows. Measured before
    # `design.md` moved into `docs/design/` on 2026-09-12: **1684** living
    # citations name it and **1045** of those are `design.md §N`, a reference
    # to a section rather than a path, spread over roughly two hundred module
    # docs. Rewriting every one to `docs/design/design.md §N` would add twelve
    # characters to each for nothing a reader gains, so the table answers
    # instead and the citation stays as it was written.
    if moved_to(part).len() > 0
        return true

    if moved_under(part: part, known: known)
        return true

    # **A file of a tree that moved into `ISSUES` resolves by the rule**,
    # since 2026-10-04: it kept its name and stands in the folder of its
    # name's day, so `docs/records/done/<name>` is followed to that file and
    # stays a claim that can die, rather than a path nothing checks.
    moved_issue = issue_redirect(part: part, known: known)

    if moved_issue != "" || shortened_issue(part: part, known: known)
        return true

    # **And a question of comprehension cited in the flat shape** the learning
    # list had until 2026-10-04, `docs/learn/<name>`: it stands in its name's
    # day's folder of `LEARNING` since 2026-10-05, keeping its name.
    if strings.starts_with(text: part, prefix: LEARNING + "/")
        flat = strings.without_prefix(text: part, prefix: LEARNING + "/")

        if !strings.contains(text: flat, needle: "/") && is_entry_name(flat)
            # Sixteen ASCII bytes open an entry's name.
            if !known[LEARNING + "/" + flat.slice(from: 0, to: 7) + "/" + flat.slice(from: 8, to: 10) + "/" + flat].is_err()
                return true

    for home in HOMES
        if !known[home + part].is_err()
            return true

    dir: str @= document
    walking: bool @= true

    while walking
        at = last_slash(dir)

        if at.is_err()
            walking @ false
        else
            dir @ dir.slice(from: 0, to: at.must())

            if !known[dir + "/" + part].is_err()
                return true

    # The slug case, and it is the only one that pays a scan: a record cited by
    # its number alone, `docs/panel/042`. Everything above is a map lookup,
    # because `known` carries every directory as well as every file.
    return exists_or_prefixes(token: part, known: known)

# Where a file of a retired tree went, by the rule
# `.claude/rules/records.md` § The issues gives, or the empty string where
# `part` is no such file or the file it names is not there. A log entry and a record shared one name, and
# the log's took `-decided` (`SHARED_NAME`).
function issue_redirect(part: str, known: {str: bool}) -> str
    name = strings.base_name(part)

    for root in ["docs/records/done/", "docs/records/log/", "docs/done/", "docs/log/"]
        if strings.starts_with(text: part, prefix: root) && strings.without_prefix(text: part, prefix: root) == name
            landed: str @= issue_home(name)

            if part == SHARED_NAME
                landed @ issue_home(strings.without_suffix(text: name, suffix: ".md") + "-decided.md")

            if landed != "" && !known[landed].is_err()
                return landed

    if strings.starts_with(text: part, prefix: "docs/work/defects/") && strings.without_prefix(text: part, prefix: "docs/work/defects/") == name
        for path in keys(known)
            if strings.starts_with(text: path, prefix: ISSUES + "/") && strings.ends_with(text: path, suffix: "-defect-" + name)
                return path

    return ""

# A citation of an issue file shortened by hand, its name cut after the words
# a reader needs and ended with `…`, or wrapped at the end of a line: it names
# something where a file of the issue files opens with what it holds, in the
# folder its day gives. It holds the whole stamp at least, `YYYY-MM-DD-HHMM-`,
# so that no shorter prefix names a day's every file. Measured 2026-10-12, the
# day an issue path's own day stopped excusing it: four such citations stood in
# living files, in `docs/design.md`, `docs/learn/`, a milestone's page and
# `selfhost/indent_runs.hero`, every one of a file of the old log.
function shortened_issue(part: str, known: {str: bool}) -> bool
    cut = strings.without_suffix(text: part, suffix: "…")
    rest: str @= ""

    for root in [ISSUES + "/", "docs/records/done/", "docs/records/log/", "docs/done/", "docs/log/"]
        if strings.starts_with(text: cut, prefix: root)
            rest @ strings.without_prefix(text: cut, prefix: root)

    # A path under `ISSUES` holds its folders before its name.
    if strings.starts_with(text: cut, prefix: ISSUES + "/")
        rest @ strings.base_name(cut)

    if rest.len() < 16 || strings.contains(text: rest, needle: "/") || !is_stamp(rest)
        return false

    # The stamp is sixteen ASCII bytes, so every cut stands between characters.
    return exists_or_prefixes(
        token: ISSUES + "/" + rest.slice(from: 0, to: 7) + "/" + rest.slice(from: 8, to: 10) + "/" + rest,
        known: known
    )

# Whether `text` opens with an entry's stamp, `YYYY-MM-DD-HHMM-`.
function is_stamp(text: str) -> bool
    shape = "nnnn-nn-nn-nnnn-"

    if text.len() < shape.len()
        return false
    i: i64 @= 0

    while i < shape.len()
        if shape[i] == 'n' && !is_digit(text[i])
            return false

        if shape[i] == '-' && text[i] != '-'
            return false
        i @ i + 1

    return true

# The one name two trees shared when they moved into `ISSUES`: the same
# decision written as a closed item and as a log entry.
constant SHARED_NAME: str
    "docs/records/log/2026-09-23-1215-a-seats-copy-is-its-own.md"

function last_slash(text: str) -> i64?
    at: i64? @= fail(code: "none", msg: "no slash")
    i: i64 @= 0

    while i < text.len()
        if text[i] == '/'
            at @ ok(i)
        i @ i + 1

    return at

# Whether this bare word is a path CLAIM: it has a `/`, no glob or angle
# bracket, and its first component is a directory this repository has or HAS
# HAD. Braces are allowed here where `anchored` refuses them, because
# `expanded` reads them exactly.
function is_claim(token: str, roots: {str: bool}) -> bool
    at = strings.index_of(text: token, needle: "/")

    if at.is_err()
        return false

    if strings.starts_with(text: token, prefix: "/") || strings.starts_with(text: token, prefix: "http")
        return false

    for ch in token.chars()
        if ch == " " || ch == "*" || ch == "<" || ch == ">" || ch == "?" || ch == "|" || ch == "\\"
            return false

    head = token.slice(from: 0, to: at.must())

    if !roots[head].is_err()
        return true

    for retired in RETIRED_ROOTS
        if head == retired || strings.starts_with(text: token, prefix: retired + "/")
            return true

    # **Panel 092's half, narrowed to the languages this repository writes its
    # own source in.** A root that has DIED is not a root, so anchoring on
    # today's directories goes green over exactly the citations this check
    # exists for — which is how `commands/flags.rs::FLAGS` sat in `CLAUDE.md`
    # for months. An extension is a fact about the token itself and survives the
    # deletion of everything around it. **`.rs` and `.hero` and not `.h`**,
    # measured 2026-09-06: a `.h` under an unknown root is a C library's header
    # — `sys/stat.h`, `curl/curl.h`, `SDL3/SDL.h` — which is a name in C's world
    # and not a path in this one, and reading them as claims put a whole class
    # of correct prose on the report. **And not `.hero` either**, measured the
    # same hour: a `.hero` under an unknown root is this language's own MODULE
    # PATH being explained — `use syntax/decl`, `geom/point.hero`, `lib/util.hero`
    # — which is vocabulary rather than citation, and reading it as a claim put
    # fourteen correct sentences on the report. `.rs` is left because this
    # repository writes no Rust any more: a `.rs` in live prose is a pointer
    # into the bootstrap and nothing else.
    return strings.ends_with(text: token, suffix: ".rs")

# Every path claim on one line of prose.
function claims_on(row: str, roots: {str: bool}) -> [str]
    found: [str] @= []

    for piece in strings.words(unpunctuated(row))
        token = unedged(without_position(without_member(piece)))

        if is_claim(token: token, roots: roots)
            found @ found.push(token)

    return found

function slashes(token: str) -> i64
    n: i64 @= 0

    for ch in token.chars()
        if ch == "/"
            n @ n + 1

    return n

# EVERY living file may not cite a path that does not exist, and a path that
# does not exist is accepted only when the line carries its own evidence.
#
# **This is the check Linux had to build.** `make refcheckdocs`
# (`scripts/documentation-file-ref-check`) exists because live documentation
# kept citing paths that had moved — a 27-patch *"docs: Fix more broken
# references"* series in 2018 — and panel 086's historian named it as the
# documented failure mode of leaving a citation pointing into an archive.
#
# **IT READ TWO DOCUMENTS UNTIL 2026-09-06 AND WAS GREEN OVER 164 DEAD
# POINTERS.** Measured 2026-09-06: `crates/` appeared 179 times in 145 files under
# `selfhost/` and 19 under `tests/`, eighteen days after that tree became
# `archive/bootstrap-rs/`, and one of the 164 was THIS FILE. Three reasons, and
# each one is a line of code above: it read `design.md` and `CLAUDE.md` only;
# it read backticked tokens only, while the compiler's own citations are bare;
# and it could not read the brace form, which panel 086 measured and recorded as
# a permanent limit — `expanded` reads it exactly now, because shell brace
# expansion is semantics rather than a guess.
#
# **THERE IS NO EXEMPTION LIST, AND THAT IS THE DESIGN.** Four shapes of
# path-like prose are legitimate and would each have wanted a line in one: a
# sentence that says a file is gone and where it went; a placeholder; a
# deliberately absent path in a fixture; a generated artefact. An exemption list
# is a second place where truth lives, and this repository's record is a long
# account of second places going stale — `DECIDE.md` at 391 KB with zero open
# items, a rule written in three documents and performed by none. So instead:
# **the LINE carries its own evidence.** A path that does not resolve is
# accepted when the line holds a date, or another path that does resolve. That
# is not a new rule — it is the sentence this check's own failure message has
# always asked for. Fixtures and generated artefacts fall out for free, because
# `is_prose` reads comments and markdown and never a string literal.
# What git deliberately does NOT track, asked of git rather than guessed at.
# `site/dist/`, `/build`, `.claude/worktrees/`, `site/.cache/` are real things
# this repository writes and refuses to keep, and prose about them is correct
# prose. A checker that calls them dead citations is reading `.gitignore` as a
# list of mistakes. One command, not a list in this file: the list already
# exists and git is the thing that reads it.
# **A path git IGNORES is not a dead citation, and the question goes to git's
# RULES rather than to this disk.** This is the whole of the defect that kept the
# net red on every platform but the one it was written on, from 2026-09-06 22:19
# to 2026-09-07.
#
# The answer used to come from `git ls-files --others --ignored --directory`,
# which lists the ignored paths that HAPPEN TO EXIST. `site/dist/`,
# `site/.cache/` and `.claude/worktrees/` exist on a machine that has built the
# site and made a worktree, so twelve live citations resolved here; a fresh
# checkout has none of them, so the same twelve read as dead and the Linux leg
# failed three runs running while this Mac was green in all three
# configurations. **The machine that wrote the check could not see the defect**,
# which is the shape the platform rules exist for.
#
# `git check-ignore` answers for a path that is not there, measured 2026-09-07:
# `site/dist/index.html` comes back ignored on a tree where nothing under
# `site/dist` was ever built. That is the difference between asking the rule and
# asking the world, and it is CLAUDE.md § 11's narrowing rule in the instrument
# that enforces CLAUDE.md's citations (`docs/records/contract/case-law.md` CL-004).
#
# **AND EVERY TOKEN IS ASKED TWICE, ONCE WITH A TRAILING SLASH.** The first
# repair replaced the oracle and still asked it the wrong question: it cut the
# Linux failure from twelve dead citations to five, and all five were bare
# directory names. Measured in the container 2026-09-07, on a tree where the
# directories are absent:
#
#     NOT      site/dist            IGNORED  site/dist/
#     NOT      .claude/worktrees    IGNORED  .claude/worktrees/
#
# The reason is in `.gitignore` itself: the patterns are `dist/`, `.cache/` and
# `.claude/worktrees/`, and a trailing slash there means *a directory only*. Git
# decides whether a path IS a directory by looking at it, and it cannot look at
# a path that is not there, so the pattern does not match the bare name. A file
# INSIDE such a directory matched all along, because `site/.cache/key.pem` has
# `.cache` as a directory component in the string itself.
#
# So the token is asked as written and as a directory. Either answer excuses it,
# and neither form can be inferred from the other.
#
# At the end, over only the tokens that survived every other route: a run with
# no dead citation never spawns git at all.
#
# **IN BATCHES, AND WINDOWS IS WHAT SAID SO.** `runtime/parts/run.c` sets
# `HERO_RUN_MAX_ARGS` to 256 and panics past it, so one call per run is a
# promise this function cannot keep: two words per token means 127 tokens is the
# whole budget, and a tree with more unresolved citations than that kills the
# suite instead of reporting them. Measured 2026-09-07 on the Windows box, whose
# checkout sat at an older commit and therefore had plenty:
#
#     panic: a command line reached 256 arguments
#
# **Neither of the other two machines could see it.** The Mac excuses those
# citations before they ever reach here, and the Linux container had five. That
# is the second defect in one afternoon that only the third platform showed, and
# the reason the contract asks for all three before a commit rather than after.
#
# **`tree` is the directory git is asked in** (defect 2065), `.` for this
# suite: its test asks a repository it plants, since a copy of the tree made
# without `.git`, as the Linux machine's recipe makes one, has no rules git
# can read.
function ignored_by_git(scratch: str, tree: str, tokens: [str]) -> {str: bool}
    out: {str: bool} @= {}
    at: i64 @= 0

    while at < tokens.len()
        words: [str] @= ["git", "-C", tree, "check-ignore"]
        taken: i64 @= 0

        while at < tokens.len() && taken < IGNORE_BATCH
            token = tokens[at]
            words @ words.push(token)

            if !strings.ends_with(text: token, suffix: "/")
                words @ words.push(token + "/")
            taken @ taken + 1
            at @ at + 1

        # `attempted`, because the sentence below is about a git that is not
        # there and `run` would turn that into a refusal this loop cannot read.
        ran = shell.attempted(scratch: scratch, program: "git", words: words)

        # **Exit 1 here means *nothing matched*, not *the command failed*.** So
        # the code is not read: only the output is, and a git that could not
        # start leaves the tokens unexcused. The safe direction for a check is
        # to speak.
        if ran.is_err()
            return out

        if !ran.must().started
            return out

        for line in strings.lines(ran.must().out)
            entry = strings.trimmed(line)

            if entry.len() > 0
                out[entry] @ true

    return out

# THE LAST COMMIT THAT HOLDS `issues/`. The author's fourth answer of
# 2026-10-12 keeps the dated records as written, read against the last commit
# that holds the folder, as the specification's line citations read against
# `834d804f` and the old maps against `d8a9913e`: so once the folder has left
# the tree, a citation of an issue file, or of a file of a tree that moved into
# it, is resolved in this commit's tree (`archive_of`). **The coordinator sets
# it in the commit that removes the folder**; while the folder stands it is not
# read, and once the folder is gone an empty value fails `records/citations`
# loudly rather than leaving every such citation dead or unjudged.
constant ISSUES_ARCHIVED_AT: str
    "92e08d824de230ccb0f95eb74bbe19a2f4faff0d"

# What the archive answers a run: `tree` while the folder stands, so nothing
# is added; `read`, every path under `ISSUES` at `ISSUES_ARCHIVED_AT`;
# `unset` where the folder is gone and the constant names no commit holding it
# (a failure); `unreadable` where this clone's history is shortened and cannot
# show the commit (a skip, as the CI's one-commit checkout is). `why` says
# which.
record Archive
    state: str
    why: str
    paths: [str]

function archive_of(scratch: str, present: [str]) -> Archive
    none: [str] = []

    if selects_tree(entry: ISSUES, present: present)
        return Archive(state: "tree", why: "", paths: none)

    if ISSUES_ARCHIVED_AT == ""
        return Archive(
            state: "unset",
            why: "`" + ISSUES + "/` has left the tree and `ISSUES_ARCHIVED_AT` (tests/harness/suite_records.hero) names no commit: set it to the last commit that holds the folder",
            paths: none
        )
    listed = listed_at(scratch: scratch, tag: ISSUES_ARCHIVED_AT, roots: [ISSUES])

    if listed.is_err()
        shallow = shell.run(scratch: scratch, program: "git", words: ["git", "rev-parse", "--is-shallow-repository"])

        if !shallow.is_err() && shallow.must().code == 0 && strings.trimmed(shallow.must().out) == "true"
            return Archive(
                state: "unreadable",
                why: "this clone's history is shortened and cannot show " + ISSUES_ARCHIVED_AT + ", the issue files' last commit",
                paths: none
            )
        return Archive(
            state: "unset",
            why: "`ISSUES_ARCHIVED_AT` names " + ISSUES_ARCHIVED_AT + ", which git cannot show: " + failure_of(listed),
            paths: none
        )

    if listed.must().len() == 0
        return Archive(
            state: "unset",
            why: "`ISSUES_ARCHIVED_AT` names " + ISSUES_ARCHIVED_AT + ", whose tree holds no `" + ISSUES + "/`: name the last commit that holds the folder",
            paths: none
        )
    return Archive(state: "read", why: "", paths: listed.must())

# How many of a list a failure shows: five, or all of a shorter one.
function first_few(count: i64) -> i64
    if count < 5
        return count
    return 5

# Whether a citation lands in the issue files: a path under `ISSUES`, or one of
# a tree whose files moved into it on 2026-10-04 (`issue_redirect`).
function lands_in_issues(token: str) -> bool
    for root in [ISSUES + "/", "docs/records/done/", "docs/records/log/", "docs/done/", "docs/log/", "docs/work/defects/"]
        if strings.starts_with(text: token, prefix: root)
            return true

    return false

function citations(@r: report.Report, scratch: str, present: [str], closed: {str: bool}, archive: Archive)
    known: {str: bool} @= {}
    roots: {str: bool} @= {}

    # Once the folder has left the tree its files are still what a citation
    # names, followed to the archive: every path there, every directory above
    # one, and its root, so `issues/...` is still a claim that can die.
    if archive.state != "tree"
        roots[ISSUES] @ true

    for path in archive.paths
        known[path] @ true
        above: str @= path
        climbing: bool @= true

        while climbing
            cut = last_slash(above)

            if cut.is_err()
                climbing @ false
            else
                above @ above.slice(from: 0, to: cut.must())
                known[above] @ true

    for path in present
        known[path] @ true
        at = strings.index_of(text: path, needle: "/")

        if !at.is_err()
            roots[path.slice(from: 0, to: at.must())] @ true

        # every directory above it, so that naming a directory is a LOOKUP and
        # not a scan over every path the repository has
        dir: str @= path
        walking: bool @= true

        while walking
            cut = last_slash(dir)

            if cut.is_err()
                walking @ false
            else
                dir @ dir.slice(from: 0, to: cut.must())
                known[dir] @ true

    dead: [str] @= []

    # In lockstep with `dead`: entry i of one is the token of entry i of the
    # other, so the git pass below can excuse a line without re-parsing the
    # message written for a human.
    tokens: [str] @= []

    for document in present
        if is_record(document) || is_generated(document) || !closed[document].is_err()
            continue
        text = read_file(document)

        if text.is_err()
            continue
        number: i64 @= 0

        for row in strings.lines(text.must())
            number @ number + 1

            if !is_prose(document: document, row: row)
                continue
            found = claims_on(row: row, roots: roots)

            if found.len() > 0
                read_the_line(
                    dead: @dead,
                    tokens: @tokens,
                    row: row,
                    found: found,
                    document: document,
                    number: number,
                    known: known
                )

    # **The ignore pass, and it runs LAST on purpose.** Asking git costs a
    # process, so it is asked once, about the handful of tokens that survived
    # every cheaper route, and never at all on a clean run. `ignored_by_git`
    # carries the measurement that made this the last step rather than the
    # first.
    excused = ignored_by_git(scratch: scratch, tree: ".", tokens: tokens)
    speaking: [str] @= []
    unjudged: [str] @= []
    at: i64 @= 0

    while at < dead.len()
        token = tokens[at]

        # Either form: `ignored_by_git` asks both and says why. A citation of
        # an issue file where the archive cannot answer is set aside, said
        # once below with the reason, and never read as dead.
        if (archive.state == "unset" || archive.state == "unreadable") && lands_in_issues(token)
            unjudged @ unjudged.push(dead[at])
        else if excused[token].is_err() && excused[token + "/"].is_err()
            speaking @ speaking.push(dead[at])
        at @ at + 1

    if unjudged.len() > 0 && archive.state == "unset"
        report.keep_failure(
            @r,
            label: "records/citations",
            detail: "  " + archive.why + ".\n  " + unjudged.len().to_str() + " citations of an issue file could not be followed, the first of them:\n" + unjudged.slice(from: 0, to: first_few(unjudged.len())).join("\n")
        )

    if unjudged.len() > 0 && archive.state == "unreadable"
        report.keep_skip(
            @r,
            label: "records/citations",
            detail: "  " + archive.why + ", so " + unjudged.len().to_str() + " citations of an issue file were not followed; they are judged where the history is whole"
        )

    if speaking.len() > 0
        report.keep_failure(
            @r,
            label: "records/citations",
            detail: "  a living file cites a path that does not exist:\n" + speaking.join("\n") + "\n  A citation into a moved or deleted file is read as current by whoever follows\n  it. If the file moved, repoint the sentence. If the claim is dated history,\n  the line needs its DATE or a path that still resolves — that is the evidence\n  this check accepts, and it is why there is no list of exemptions to edit."
        )
    else
        report.keep_pass(@r)

# One line's verdict. Split out because `citations` is already a walk inside a
# walk inside a walk, and this is the part with the rule in it.
function read_the_line(@dead: [str], @tokens: [str], row: str, found: [str], document: str, number: i64, known: {str: bool})
    missing: [str] @= []

    for token in found
        if !names_something(token: token, document: document, known: known)
            missing @ missing.push(token)

    if missing.len() == 0
        return

    # **A DATE, and not a living path beside it.** A resolving sibling was
    # accepted as evidence until it was measured: `runtime/parts/run.c` cites a
    # golden that does not exist and names a live file on the same line, so the
    # sibling rule silenced a real dead citation by coincidence. A date is a
    # claim a reader can check against the history; a neighbour is an accident.
    #
    # **And the day in an issue file's own name is no evidence for it**
    # (2026-10-12): an issue file is named for the day it was filed, so every
    # citation of one carried a date and no such citation could ever die, the
    # folder present or gone. Its own day is taken out of the line before the
    # line's date is asked for, and a citation of the issue files is judged by
    # the tree, or by their archive once they leave it (`ISSUES_ARCHIVED_AT`).
    told: str @= row

    for token in missing
        if lands_in_issues(token)
            told @ strings.split_text(text: told, separator: token).join(" ")

    if is_dated(told)
        return

    for token in missing
        dead @ dead.push("    " + document + ":" + number.to_str() + ": " + token)
        tokens @ tokens.push(token)

# **The repository's working text is English** (CLAUDE.md §11), and this is the
# check that says so out loud instead of trusting whoever writes next.
#
# It reads every file that is not a record — the records keep the words they were
# written with (§14) — so a red line here is never history: it is a rule, a
# comment or a page that somebody wrote in Italian today. It takes the whole
# walk and does its own pruning rather than the `living` list, because `living`
# drops `CLAUDE.md` and `docs/ROADMAP.md`, which quote the retired milestone
# spelling, and those two held 35 of the 55 Italian spans repaired on
# 2026-09-04: a check reading `living` would run green over the two files it
# exists for.
#
# **Why per line and not per file.** The shape this catches is one Italian
# sentence inside an English document: a quoted author instruction, a module doc
# citing one, a gloss nobody translated. A file-wide ratio drowns one sentence in
# four hundred English ones, which is exactly the case that got past every reader
# for a month.
function english(@r: report.Report, present: [str], closed: {str: bool})
    found: [str] @= []

    for path in present
        if is_record(path) || is_generated(path) || !closed[path].is_err()
            continue

        if quotes_the_italian(path)
            continue

        if !reads_as_prose(path) || italian_by_design(path)
            continue

        text = read_file(path)

        if text.is_err()
            continue

        for line in strings.lines(text.must())
            if italian_line(line)
                found @ found.push("    " + path + ": " + strings.trimmed(line))

        for span in quoted_spans(text.must())
            if italian_quote(span)
                found @ found.push("    " + path + ", quoted: " + strings.trimmed(span))

    if found.len() > 0
        report.keep_failure(
            @r,
            label: "records/english",
            detail: "  a living file is written in Italian:\n" + found.join("\n") + "\n  CLAUDE.md §11: everything written is English, and that binds a quoted author\n  instruction too — it is written down for what it MEANT, in English, and the\n  original stays in the git history and in the dated records. If this text is a\n  translation somebody reads on purpose, it belongs under §11's second declared\n  exception and its path goes in ITALIAN_BY_DESIGN with a measurement beside it."
        )
    else
        report.keep_pass(@r)

# Whether this file carries prose a human wrote. An extension list rather than a
# guess at the content: a `.json` lockfile and a `.svg` icon hold neither
# English nor Italian, and reading them buys only the chance of a false word.
function reads_as_prose(path: str) -> bool
    for suffix in [".md", ".hero", ".c", ".h", ".html", ".astro", ".txt"]
        if strings.ends_with(text: path, suffix: suffix)
            return true

    return false

# Prefix match, so a directory covers the files under it — `is_record`'s rule,
# and the `/` guard is why an `italy.md` under `site/src/html/` would not be exempted by an
# entry naming `site/src/html/it`.
# This module itself, by exact name. A suffix match like `quoting`'s would also
# exempt a copy of this file anywhere in the tree; there is one.
function quotes_the_italian(path: str) -> bool
    for entry in QUOTES_THE_ITALIAN
        if path == entry
            return true

    return false

# The record with no directory of its own, kept out by exact name.
function italian_by_design(path: str) -> bool
    for entry in ITALIAN_BY_DESIGN
        if path == entry || strings.starts_with(text: path, prefix: entry + "/")
            return true

    return false

function is_marker(word: str) -> bool
    for marker in ITALIAN_MARKERS
        if same_folded(word: word, marker: marker)
            return true

    return false

# ASCII case-folded equality. The fold happens HERE rather than while the word
# is being cut, because cutting builds a word out of slices of the line and a
# slice carries the byte it found: lowercasing at comparison time is the one
# place where the byte is a value and not a position. `Non` and `non` are the
# same marker; the markers themselves are all lowercase.
function same_folded(word: str, marker: str) -> bool
    if word.len() != marker.len()
        return false

    i: i64 @= 0

    while i < word.len()
        b: u8 @= word[i]

        if b >= 65 && b <= 90
            b @ b + 32

        if b != marker[i]
            return false
        i @ i + 1

    return true

# The line's words, split at every byte that is not an ASCII letter. Case is
# left alone here and folded by `same_folded` when a word is compared.
#
# **The inline code spans go first**, before a single word is counted, because
# `site/CLAUDE.md`'s Italian spelling rule is a row of backticked Italian words
# — `dai`, `perch`, `po'` — being ruled ON rather than written IN, and it is the
# one line in the repository that would fire while obeying every rule in it.
# Stripping code spans also drops identifiers, paths and emitted C, none of
# which is prose in any language.
function latin_words(line: str) -> [str]
    out: [str] @= []
    piece: [str] @= []
    inside_code: bool @= false
    i: i64 @= 0

    while i < line.len()
        byte = line[i]

        if byte == 96
            inside_code @ !inside_code

            if piece.len() > 0
                out @ out.push(piece.join(""))
                piece @ []
            i @ i + 1
            continue

        letter: bool @= false

        if !inside_code
            if is_lower(byte) || byte >= 65 && byte <= 90
                piece @ piece.push(line.slice(from: i, to: i + 1))
                letter @ true

        if !letter && piece.len() > 0
            out @ out.push(piece.join(""))
            piece @ []
        i @ i + 1

    if piece.len() > 0
        out @ out.push(piece.join(""))

    return out

# A citation may name what is IN the file — `selfhost/cli/flags.hero::flags()` —
# and the path claim is the half before the `::`. Cutting it is not cosmetic:
# **it is what would have caught the citation that provoked this** (panel 092).
# `CLAUDE.md` cited `commands/flags.rs::FLAGS` for months and this check never
# looked at it, because `anchored` asks whether the first component is a
# directory this repository has (`commands` is not) OR whether the token ends in
# a file extension (`::FLAGS` is not one). Cut the member and the same token ends
# in `.rs`, is anchored by its extension, and is reported dead. Found by a panel
# judge with no `grep`, reading the contract as a stranger would — which is the
# argument for the cut rather than for a wider net.
function without_member(token: str) -> str
    at = strings.index_of(text: token, needle: "::")

    if at.is_err()
        return token
    return token.slice(from: 0, to: at.must())

# Whether the token's last component carries a `.suffix` of one to nine letters or
# digits — `gate.rs`, `ci.yml`, `heroes-spec.md`. Not `docs/panel/042`, and not
# `application/json`.
function has_extension(token: str) -> bool
    cs = token.chars()
    dot: i64 @= -1
    slash: i64 @= -1
    i: i64 @= 0

    while i < cs.len()
        if cs[i] == "."
            dot @ i

        if cs[i] == "/"
            slash @ i
        i @ i + 1

    if dot <= slash + 1 || dot == cs.len() - 1
        return false

    if cs.len() - 1 - dot > 9
        return false
    j: i64 @= dot + 1

    while j < cs.len()
        if cs[j].len() != 1 || !is_lower(cs[j][0]) && !is_digit(cs[j][0])
            return false
        j @ j + 1

    return true

# A token names something if a file IS it, or if a file begins with it — which
# covers a directory (`tests/golden/check/`) and a record cited by its number
# without its slug (`docs/panel/042`). **A token written with its slash is a
# directory, and a directory begins its files only up to that slash**: on
# 2026-10-05 `docs/design/` died while `docs/design.md` begins with
# `docs/design`, and reading the slash away had resolved the one through the
# other. Without its slash the prefix stays the string's, measured that day:
# holding it to the dash a slug opens with turned 16 living lines red, and
# every one was a real name, a module by its path (`selfhost/emit/ffi`), a case
# without its extension, a family of cases (`tests/golden/run/dead-`) or of
# modules, or a sitting's number written with its dash.
function exists_or_prefixes(token: str, known: {str: bool}) -> bool
    if !known[token].is_err()
        return true

    for path in keys(known)
        if strings.starts_with(text: path, prefix: token)
            return true

    return false

# No golden's expected output names a milestone in EITHER spelling.
#
# The byte-pinned diagnostic text is where a leak from any diagnostic
# would surface — not only from the emit gate, which is the only one with
# a guard of its own. §4.17's standard: everything needed without opening
# another file, and a milestone identifier is a pointer into a file the
# reader does not have.
function expectations(@r: report.Report, scratch: str)
    none: [str] = []
    listing = shell.list_tree(scratch: scratch, dir: "tests/golden", skip: none)

    if listing.is_err()
        report.keep_failure(@r, label: "records/expected", detail: "  cannot walk tests/golden")
        return
    offenders: [str] @= []

    for path in listing.must()
        if !strings.ends_with(text: path, suffix: ".expected")
            continue
        text = read_file(path)

        if text.is_err()
            continue
        found = numbered_in(text.must())

        if !found.is_err()
            offenders @ offenders.push("    " + path + ": " + found.must())

        for name in names_used(text.must())
            offenders @ offenders.push("    " + path + ": " + name)

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/expected",
            detail: "  a pinned diagnostic names a milestone:\n" + offenders.join("\n")
        )
    else
        report.keep_pass(@r)

# The boundary rule, asserted in both directions — the check that keeps
# the two checks above honest.
# EVERY SITTING CARRIES ITS AUTHOR'S VERDICT, AND IT DOES NOT SAY `Pending`.
#
# CLAUDE.md §4 says a panel never blocks: it adopts a conservative default,
# ships it, and queues the author's ratification. That contract has one hole and
# it is not in the rule — it is that NOTHING ASKS. Panels 085, 086 and 087 sat
# unratifiable for four days because no list carried the item; panels 069 to 079
# sat for eight, eleven of them, and were found by accident on 2026-08-24 while
# ratifying three others.
#
# **WHY THIS CHECK ASKS THE VALUE AND NOT THE VOCABULARY** (CLAUDE.md §11's own
# distinction, and this is the measurement that proves it). Five attempts to
# count the unratified by hand that day returned 51, 7, 16, 12 and 11, every one
# wrong differently:
#   - `## Author's verdict` was a recent convention, so old sittings ratified by
#     a DESIGN-LOG line looked unratified;
#   - **the phrase `ratification pending` CONTAINS the string `ratif`**, so a
#     grep for *ratified* counted every unratified sitting as ratified;
#   - `docs/panel/080` says *"no ratification pending"* and matched as pending,
#     its own negation read as the thing it denies;
#   - and a yes is written as *ratified*, *author decision*, *author instruction*
#     or *decided by the author*, across four different files.
# Every one of those failures is a premise about the WORLD — about which words
# the record happens to use. This check rests on a fact about the FILE IN HAND:
# it has exactly one verdict section, and that section does not open with
# `Pending`. A vocabulary can drift; a section either exists or it does not.
#
# The rule has NO EXCEPTION, deliberately. `080` is a retro-record settled before
# its own sitting, and rather than teach the check about retro-records it was
# given a verdict section saying so — a rule with an exception is a rule the next
# exception breaks.
#
# **Who is asking is GitHub's since 2026-10-12**: an open decision whose title
# opens `Panel NNN:` (`records_github.queued`). Where GitHub cannot be asked,
# the sittings this rests on are named in a skip, and the verdict sections are
# judged all the same.
#
# **And GitHub's answer may be newer than the tree** (defect 2041): a
# ratification is written beneath its sitting's stub by one commit and its
# decision closed by `close`, which names that commit, so every tree without
# the commit holds a `Pending` nobody asks about any more. Measured 2026-10-14:
# the round's tree at `a0dd1aa55` holds panel 214 `Pending`, GitHub closed its
# decision at 07:59:37Z after `fda81bd14` wrote the answer, and this check read
# that tree red. So the tree is placed among the author's answers by the
# sittings it holds answered (`records_github.answers_received`), and a
# ratification GitHub closed after the latest of them is not held against it
# (`records_github.unasked_offence`).
function verdicts(@r: report.Report, present: [str], held: github_issues.Listing)
    offenders: [str] @= []
    unasked: [str] @= []
    answered: [i64] @= []
    waiting: [str] @= []
    seen: i64 @= 0

    for path in present
        if !is_sitting(path)
            continue
        seen @ seen + 1
        number = sitting_number(path)

        if number.default(0) < VERDICT_FLOOR
            continue
        text = read_file(path)

        if text.is_err()
            report.keep_failure(@r, label: "records/verdicts", detail: "  cannot read " + path)
            return
        pieces = strings.split_text(text: text.must(), separator: VERDICT_HEADING)

        if pieces.len() != 2
            offenders @ offenders.push(
                "    " + path + ": " + (pieces.len() - 1).to_str() + " verdict sections, want exactly 1"
            )
            continue

        if !opens_pending(text: pieces[1]) || answered_beneath(text: pieces[1])
            answered @ answered.push(number.must())
            continue
        digits = sitting_digits(path)

        if !held.asked
            unasked @ unasked.push("    " + path)
        else if digits.is_err() || !records_github.queued(digits: digits.must(), held: held)
            waiting @ waiting.push(path)

    # A pending sitting nobody asks about is judged once the tree is placed
    # among the answers, which takes every sitting it holds.
    first = records_github.first_answers(held)
    received = records_github.answers_received(answered: answered, first: first)

    for path in waiting
        wrong = records_github.unasked_offence(
            sitting: sitting_number(path).default(0),
            digits: sitting_digits(path).default("NNN"),
            first: first,
            received: received
        )

        if wrong != ""
            offenders @ offenders.push("    " + path + ": " + wrong)

    if seen == 0
        report.keep_failure(
            @r,
            label: "records/verdicts",
            detail: "  `" + SITTINGS + "` holds no numbered sitting, so this check read zero files and\n  would pass whatever the panel had left unratified. Either that tree moved and\n  `is_sitting` did not follow it, or the prefix arithmetic stopped matching.\n  This floor is counted BEFORE the VERDICT_FLOOR filter on purpose: a broken\n  prefix takes every sitting at once, so zero is the shape it makes."
        )
        return

    if unasked.len() > 0
        if held.broken
            records_github.unanswered(@r, held: held, label: "records/verdicts")
        else
            report.keep_skip(
                @r,
                label: "records/verdicts",
                detail: "  GitHub could not be asked whether an open decision asks for these pending sittings: " + held.why + "\n" + unasked.join("\n")
            )

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/verdicts",
            detail: "  a sitting has no answer from the author:\n" + offenders.join("\n") + "\n  CLAUDE.md §4: a panel never blocks, it queues the author's ratification — so\n  something has to ask. Give the file one `" + VERDICT_HEADING.slice(from: 1, to: VERDICT_HEADING.len()) + "` section saying what the yes\n  settles and what it does not. A sitting settled BEFORE it ran is a retro-record\n  and says so under the same heading; there is no exception to teach this check."
        )
    else
        report.keep_pass(@r)

# WHERE THE RULE STARTS, AND WHY IT IS A NUMBER.
#
# Measured 2026-08-24, on the check's first run: **57 sittings below 063 carry no
# verdict section at all**, and every one of them is nonetheless RATIFIED — by a
# `DESIGN-LOG.md` line, by the panel watch list (`OPEN-QUESTIONS.md`, retired
# 2026-09-04: ten of its nineteen items were closed, and the file said which
# sittings the author had decided), or by a blanket author
# instruction. They predate the convention rather than break it. CLAUDE.md §14
# says a dated record is not rewritten, so this check does not demand that 57
# files be retrofitted to satisfy an instrument invented after them.
#
# 063 is the floor because it is exact rather than round: every sitting from 063
# up carries a verdict, and no sitting below it does. If that ever stops being
# true the floor moves DOWN with a line saying which sitting moved it — never up,
# because raising it would hide the thing the check exists to find.
constant VERDICT_FLOOR: i64
    63

# The sitting's number, or an error where the name does not start with one.
function sitting_number(path: str) -> i64?
    rest = strings.without_prefix(text: path, prefix: SITTINGS)
    at = strings.index_of(text: rest, needle: "-")

    if at.is_err()
        return fail(code: "unnumbered", msg: "no `-` after the number in " + path)
    return strings.to_number(text: rest.slice(from: 0, to: at.must()))

# **A PENDING VERDICT IS FINE — A PENDING VERDICT NOBODY IS ASKING ABOUT IS NOT**,
# and the difference is the whole defect this check was built for (corrected
# 2026-08-25, hours after the check landed, by the check firing on the panel held
# that evening).
#
# The first version failed on any `Pending`, which made every freshly-held sitting
# a red build until the author answered — and CLAUDE.md §4 says in its own words
# that **a panel never blocks**: it adopts a conservative default, ships it, and
# QUEUES the ratification. A check that contradicts the contract it enforces is
# worse than no check.
#
# What actually went wrong with panels 085-087, and with 069-079 for eight days,
# was never that they were pending. It was that **no list carried the item**, so
# nothing asked. So that is what this asks: a sitting may say `Pending` for as
# long as it likes, provided an OPEN item in `docs/work/DECIDE.md` names it.
# The pair is the invariant; neither half alone is.
#
# **The constant was called `QUEUE` and held `docs/debrief/QUEUE.md`'s neighbour (gone 2026-08-26)
# until 2026-08-26**, which is the confusion the rename fixed one level up: it
# reads the DECISIONS list, and calling it the queue is what let `/panel`'s own
# skill file tell a sitting to append its ratification item to the record instead
# — to the one file this function never opens. A miss here is silent in the worst
# direction: `read_file` fails, `queued` returns false for every sitting, and
# every pending panel is reported as unqueued.
constant DECISIONS: str
    "docs/work/DECIDE.md"

# The list of work that already has a milestone. Read by `homed` below, which is
# the executor of that file's own preamble rule.
# The list of compiler defects that are still open. No instrument opened this
# file at all until 2026-09-07, which is how it came to carry 2753 bytes of
# prose about five defects that had already moved to the record.
#
# **Since 2026-10-04 it is the list's FRONT PAGE and holds no item** (the
# author's *5a* of 2026-10-03, meant as: *since DEFECTS.md holds a great many
# defects, restructure it, one defect one file, so that we have no conflicts*).
# It keeps its path because the contract, the skills and the records cite it,
# and `front_page_offences` holds it to its rules alone, no item, no banner and
# no count, so that it cannot quietly become a second list beside the files.
constant DEFECTS: str
    "docs/work/DEFECTS.md"

# THE OPEN DEFECTS, ONE FILE EACH, since 2026-10-04: the shape `LEARNING` took
# on 2026-09-12, for the reason the author gave this time. Batch 8's four lanes
# each edited the one file, and the merge of their round had two conflicts, at
# the list's end and on its banner, both resolved by hand; four files are four
# lanes that never write one line.
#
# **No register of numbers and no count line**: the directory's listing IS the
# register, and the count is DERIVED by walking it (`defect_files`), so it
# cannot drift the way a written one can. `records/defects` held the names to
# what a register would have owed a reader, until the issues left the tree on
# 2026-10-12; the tree route of `records/tagged` still reads this shape at a
# tag that holds it.
constant DEFECT_FILES: str
    "docs/work/defects"

# What keeps the directory in every clone on the day it holds no defect, which
# is the goal. Git tracks no empty directory, so without a file of its own the
# goal and a directory moved away would read alike, zero files, and a fresh
# clone would not have the directory at all. Empty on purpose, as
# `tests/golden/check/.gitkeep` is: a sentence in it would be a second front
# page.
constant DEFECT_KEEPER: str
    "docs/work/defects/.gitkeep"

# `**OPEN: 41**`, the line under the opening banner. The number is in the file so
# that a reader sees at a glance whether anything is owed, and it is READ here so
# that it cannot be the kind of count that drifts in the copy nobody re-opens.
constant OPEN_PREFIX: str
    "**OPEN: "

# THE TWO LIVE LISTS CARRY A SHORT PREAMBLE — author instruction 2026-09-16.
#
# What sits above the opening banner is the file's rules, and `list_offences`
# never looked there: it polices the item region alone, so `DEFECTS.md` grew to
# 982 words of preamble — 4551 bytes of them ONE sentence recording who issued
# which defect number — under the check written to keep that very file short.
# The instrument was watching the half of the file that was not the problem,
# and the register it held stated the next number TWICE with two different
# values, which is what a paragraph nothing reads does.
#
# **The milestone files are deliberately NOT judged here.** Their preamble IS
# the milestone's reasoning, which `/step` § 1 calls the thing that must not be
# lost; the longest runs to 224 lines. The author's rule names `DEFECTS.md`,
# `DECIDE.md` and the ROADMAP, and this exemption is written down so that a
# later session does not finish a job nobody asked for and delete the one thing
# a milestone file exists to carry.
#
# Measured 2026-09-16 after the trim: `DEFECTS.md` 19 lines, `DECIDE.md` 22.
# The ceiling is that plus room and never a round figure (CL-069).
#
# **Since 2026-10-04 the defects' front page is held to it whole**, having no
# banner to stand above: 29 lines the day it became the page, what a defect
# file is, how one is filed and how one closes, against `DECIDE.md`'s 22.
constant PREAMBLE_CEILING: i64
    34

# The comprehension list. It takes the same shape as the three above and one
# rule fewer: a ticked question stays in it (`/learn`'s rule — the list is also
# its own record), so `records/lists` reads it with `ticked_allowed`.
# **The learning list is a DIRECTORY since 2026-09-12** (author instruction:
# *can the contention be eliminated further?*), one file per question, the shape
# the records took the same morning. The reason is measured rather than
# aesthetic: it was 1939 lines with 364 items and ONE hand-written count on line
# 42, so two lanes filing an offer both wrote that line and both appended at the
# bottom — and it is the list that grows at every close, which made it the one
# that conflicted at every close.
#
# **No map was left behind, and that is a measurement too**: zero citations
# anywhere named `LEARN.md:NNN`, so nothing resolved by line and a map would
# have kept a height no reader uses.
#
# **And the count line is gone rather than moved.** `LEARNING_FLOOR` below
# replaces it: the number is now DERIVED by walking this directory, so it cannot
# drift the way a written one can, and nothing has to be edited to keep it true.
# What a derived count still needs is a floor, because an empty walk passes.
#
# **The questions were issues of the kind `learn` from 2026-10-04 to 05**, and
# came back here by the author's *1a 2a* of 2026-10-05, meant as: *if they are
# not issues, they must not be filed inside issues/*. Each keeps its name, in
# the folder of its name's day, and carries no card: a card is what makes a
# file one GitHub issue, and a question is never one. The floor counts the
# open ones (`learn_offences`).
constant LEARNING: str
    "docs/learn"

# The learning list's front page: what a question is, how one is written and
# how one is answered, and no item.
constant LEARNING_PAGE: str
    "docs/learn/README.md"

# A question's file: under `LEARNING`, in a folder of a year and a month. The
# list's front page and the glossary beside the questions (`docs/learn/glossary/`,
# since 2026-10-05) are not questions.
function is_question(path: str) -> bool
    if !strings.starts_with(text: path, prefix: LEARNING + "/")
        return false
    rest = strings.without_prefix(text: path, prefix: LEARNING + "/")

    return rest.len() > 0 && is_digit(rest[0])

constant LEARNING_FLOOR: i64
    300

# THE ISSUES, since 2026-10-04 (`.claude/rules/records.md` § The issues, the
# author's instruction of that day, meant as: *everything goes into a top-level
# issues folder, it is more orderly; change the rules, toward a final
# definition*). Every item this project tracks is one file here, in the folder
# of the day its name carries, `issues/<year-month>/<day>/`, open and closed side by
# side, and **nothing moves when one closes**: the box is ticked where it
# stands, so a link to the file, GitHub's included, stays good for ever.
#
# It replaced six homes in one move: the open defects' directory, the decision
# list, the items of the milestone pages, the learning list, and the record's
# two trees, `docs/records/done` and `docs/records/log`, whose files kept their
# names, so a citation of one resolves by the rule (`issue_redirect`).
constant ISSUES: str
    "issues"

# Every issue file of `present`, the front page aside, in the walk's order,
# which is the names' and so the order of birth: what a tag's tree held, for
# `records/tagged`'s tree route.
function issue_files(present: [str]) -> [str]
    out: [str] @= []

    for path in present
        if strings.starts_with(text: path, prefix: ISSUES + "/") && strings.ends_with(text: path, suffix: ".md") && path != ISSUES + "/README.md"
            out @ out.push(path)

    return out

# The folder an issue named `name` lives in, or the empty string where the name
# is not `YYYY-MM-DD-HHMM-<slug>.md` and so carries no day to file it under.
function issue_home(name: str) -> str
    if !is_entry_name(name)
        return ""

    # Sixteen ASCII bytes open an entry's name, so every cut stands between
    # characters.
    return ISSUES + "/" + name.slice(from: 0, to: 7) + "/" + name.slice(from: 8, to: 10) + "/" + name

# The digits a sitting's filename opens with, exactly as written. Kept apart from
# `sitting_number` because the two answer different questions: the floor needs an
# integer to compare, and the queue needs the spelling the record uses.
function sitting_digits(path: str) -> str?
    rest = strings.without_prefix(text: path, prefix: SITTINGS)
    at = strings.index_of(text: rest, needle: "-")

    if at.is_err()
        return fail(code: "unnumbered", msg: "no `-` after the number in " + path)
    return ok(rest.slice(from: 0, to: at.must()))

# A numbered sitting under `docs/panel/`. The digit is what is asked, and the
# reason is historical: this directory held one unnumbered file until 2026-09-04
# — `OPEN-QUESTIONS.md`, the watch list, which had no resolution and which nobody
# ratified. The rule stays after the file went, so the next unnumbered thing to
# land here is not read as a sitting either.
function is_sitting(path: str) -> bool
    if !strings.starts_with(text: path, prefix: SITTINGS)
        return false

    if !strings.ends_with(text: path, suffix: ".md")
        return false
    rest = path.slice(from: SITTINGS.len(), to: path.len())

    if rest.len() == 0
        return false

    # A sitting is a file sitting DIRECTLY in that tree, so what remains after
    # the prefix carries no separator. Without this clause the predicate takes
    # everything under a subdirectory too, and it always has:
    # `docs/panel/000-plan-review/README.md` has matched since the day it was
    # written and was only ever skipped by `VERDICT_FLOOR`, its number being 0.
    # Panel 147 is the first sitting to keep its briefs beside it, at
    # `docs/panel/147-briefs/`, and 147 is above the floor — so twelve files
    # that are not sittings were asked for an author's verdict, which is how
    # a masked predicate finally answered out loud.
    if strings.contains(text: rest, needle: "/")
        return false

    # The BYTE, not a one-character slice: `<` and friends take a number in this
    # language and never a `str` (spec § Operators), which is the first thing
    # this function got wrong.
    first = rest[0]
    return first >= '0' && first <= '9'

# Does this section OPEN with the stub? Only the first non-empty line is asked,
# and the emphasis markers are stepped over, because a real verdict may quote the
# word `pending` while saying what it settles — 089's does, twice. Asking the
# first line asks whether anybody answered; asking the whole section would ask
# what they wrote about, which is a different question and not this one.
function opens_pending(text: str) -> bool
    for line in strings.lines(text: text)
        bare: str @= ""

        for ch in line.chars()
            if ch != "*" && ch != " " && ch != "\t" && ch != "_"
                bare @ bare + ch

        if bare.len() == 0
            continue
        return strings.starts_with(text: bare, prefix: "Pending")

    return true

# **A verdict answered beneath its stub** (2026-10-11, panel 209's file): a
# record is not rewritten, so a sitting whose `Pending.` stood until the author
# answered keeps that line and gains the answer under it, as
# `.claude/rules/records.md` § A record is never rewritten asks. Only a line
# that OPENS with the answer and its date counts, the emphasis stepped over as
# `opens_pending` steps over it: `Ratified,`, `Amended,` or `Overturned,`, in
# either case, then a digit. A section that only quotes the word keeps its
# `Pending`, so the question stays whether anybody answered.
function answered_beneath(text: str) -> bool
    first: bool @= true

    for line in strings.lines(text: text)
        bare: str @= ""

        for ch in line.chars()
            if ch != "*" && ch != " " && ch != "\t" && ch != "_"
                bare @ bare + ch

        if bare.len() == 0
            continue

        if first
            first @ false
            continue

        for word in ["Ratified,", "RATIFIED,", "Amended,", "AMENDED,", "Overturned,", "OVERTURNED,"]
            if strings.starts_with(text: bare, prefix: word) && bare.len() > word.len()
                next = bare[word.len()]

                if next >= '0' && next <= '9'
                    return true

    return false

test "a verdict answered beneath its stub is answered, and a quoted word is not"
    assert answered_beneath(
        text: "\nPending. The decision issue is\n`x`.\n\n**Ratified, 2026-10-10 17:57** (the line above stood).\n"
    )
    assert answered_beneath(text: "Pending.\n\n**RATIFIED, 2026-10-11**, R1 to R5.\n")
    assert !answered_beneath(text: "Pending. Nothing is ratified yet.\n\nThe author has not answered.\n")
    assert !answered_beneath(text: "**Ratified, 2026-10-10**, R1.\n")
    assert !answered_beneath(text: "Pending.\n\nRatified, without a date.\n")

# **`docs/ROADMAP.md` § Where we are, held to its own ceiling.**
#
# The rule is `/step`'s milestone-close checklist: that section says what is
# NEXT, and a closed milestone's record is its journal, so the section stays at
# 15 lines. It was written with its reason — the file reached 935 lines, growing
# ~66 per close, and a reader met 512 lines about the past before the first line
# about the future.
#
# **It had no executor, and it was broken by 16 lines.** Measured 2026-08-31 at
# M-argv-execution: 31 lines, two long paragraphs of re-measurement history that
# belong to the journals. CLAUDE.md §3 names this exact shape — a rule written in
# three documents that no skill performed, which is how `DECIDE.md` grew to
# 391 KB. A number in a checklist is a wish; a number an instrument reads is a
# rule.
#
# The count is every line from the heading to the `---` that ends the section,
# blank lines included, because a blank line costs a reader the same scroll as
# any other.
#
# **AND THE TERMINATOR IS THE WHOLE LINE, NOT A PREFIX — which is the second
# thing this check got wrong, and the interesting one** (M-thread-stacks step 2,
# 2026-09-06). It asked `starts_with("---")`, and on that day the section held
# **three stacked blocks**: M-isolated-threads' close had APPENDED its table
# instead of replacing the one before it, and the two older blocks had lost their
# `| | |` header rows, so each began with the mangled separator `---|---|`. That
# string starts with `---`. So the count stopped at the first mangled line,
# reported **14**, passed — and **27 lines were invisible to the one instrument
# that exists to see them**. With the terminator read as a whole line the same
# file counts **41** against a ceiling of 15 and goes red, which is what it did.
#
# This is CLAUDE.md §9's shape one level up: a self-check that reads the record
# through a loose pattern can only see what that pattern admits, and the
# corruption it was built to catch is exactly what slipped through it. So there
# are two failures below rather than one. The count is the rule; the malformed
# rule is named on its own because *"41 lines"* would send a reader to trim
# prose, and what is actually wrong is that a table lost its head.
record WhereScan
    counted: i64
    mangled: i64
    found: bool

# The scan itself, over TEXT rather than over the file, so the two shapes it
# judges can be written down as literals in a test (CLAUDE.md §9: every verifier
# check has a test that makes it fire). The version this replaced could only be
# exercised by breaking the real ROADMAP, which is why the defect it missed went
# unnoticed for as long as it existed.
function scan_where(text: str) -> WhereScan
    counted: i64 @= 0
    mangled: i64 @= 0
    inside: bool @= false
    closed: bool @= false

    for row in strings.lines(text)
        if strings.starts_with(text: row, prefix: "## Where we are")
            inside @ true

        if inside && !closed
            bare = strings.trimmed(text: row)

            if bare == "---"
                closed @ true
            else
                counted @ counted + 1

                if strings.starts_with(text: bare, prefix: "---")
                    mangled @ mangled + 1

    return WhereScan(counted: counted, mangled: mangled, found: inside)

function where_we_are(@r: report.Report)
    text = read_file("docs/ROADMAP.md")

    if text.is_err()
        report.keep_failure(@r, label: "records/roadmap", detail: "  docs/ROADMAP.md cannot be read")
        return
    got = scan_where(text.must())

    if !got.found
        report.keep_failure(
            @r,
            label: "records/roadmap",
            detail: "  docs/ROADMAP.md has no `## Where we are` section, and /step's checklist names one"
        )
        return

    if got.mangled > 0
        report.keep_failure(
            @r,
            label: "records/roadmap",
            detail: "  § Where we are holds " + got.mangled.to_str() + " line(s) that begin `---` without BEING `---`, and a table whose head is gone reads as a horizontal rule to anything scanning for one. That is how a close appends a second block instead of replacing the first: collapse the section to ONE table, or restore the `| | |` header the mangled line ate"
        )
    else
        report.keep_pass(@r)

    if got.counted > WHERE_CEILING
        report.keep_failure(
            @r,
            label: "records/roadmap",
            detail: "  § Where we are is " + got.counted.to_str() + " lines and the ceiling is " + WHERE_CEILING.to_str() + " — the ROADMAP says what is NEXT, and a closed milestone's record is its journal (/step, milestone close)"
        )
    else
        report.keep_pass(@r)

# **Every open item in `docs/work/SCHEDULED.md (retired 2026-09-12)` names a milestone that has a row
# in `docs/ROADMAP.md` § The chain and is NOT closed** (author instruction
# 2026-09-04; the rule is in that list's own preamble, this is what performs it).
#
# **It arrived with twelve items of twenty-nine already breaking it.** Nine named
# a waiting condition instead of a milestone — *"the next panel that touches
# emission"*, *"trigger, not a milestone"*, *"the milestone that makes the stack
# guard per-thread"* — and three named a milestone that had CLOSED, one of them
# filed the day before at an id closed 2026-08-12. **A closed home and no home
# read identically in that list**: the item looks scheduled either way. Neither is
# reachable by `/step`, which finds an item by grepping the milestone's name, so
# nine of them were invisible to the one command obliged to open them.
#
# CLAUDE.md §3 tells this story twice already — `DECIDE.md` grew to 391 KB under
# a rule three documents stated and no skill performed. A rule in a preamble is a
# wish; a rule an instrument reads is a rule.
#
# **The first field only.** Everything after the first `|` is prose and may name
# any milestone it likes, closed ones included — that is how an item records the
# home it used to have, which is what several of them now do.
# **AND THE FILE IS NOW THE KEY**, since 2026-09-12. One milestone is one file
# is one lane: the file named for a milestone carries that milestone's reasoning and its open
# items, and two sessions working two milestones write two files with no line in
# common. `docs/work/SCHEDULED.md (retired 2026-09-12)` held all 53 items of 22 milestones in one
# ordered list until that day, so every filing touched the same file and, since
# 2026-09-10, the same ORDER.
#
# What that buys this check is a second question it could not ask before: an
# item's first field must equal the NAME OF THE FILE IT IS IN. In one list an
# item could sit anywhere; here the file is its home, and a mis-filed item is
# one a reader opening that milestone would never see.
#
# **AND THE CARD IS NOW THE KEY**, since 2026-10-04: the items left the pages
# for `ISSUES`, where an open `feature` or `task` says its milestone on its
# card's fourth line. The page keeps the milestone's reasoning and holds no
# item (`lists`), and what this check asks moved with the items: an open item
# of a milestone's work names a milestone, that milestone has a row in § The
# chain, and the row is not closed. A `learn`, a `defect` or a `decision` may
# name a closed one, because there the milestone is where the item came from
# rather than where it is owed.
#
# **And since 2026-10-12 the issues are GitHub's** (the author's seven
# answers): an open feature or task names the milestone it is owed to as its
# GitHub milestone, held to the chain the same way and to GitHub's own state
# (`records_github.unhomed`); where GitHub cannot be asked that half is a
# skip, and the pages are judged all the same.
function homed(@r: report.Report, present: [str], held: github_issues.Listing)
    chain = read_file("docs/ROADMAP.md")

    if chain.is_err()
        report.keep_failure(@r, label: "records/homes", detail: "  docs/ROADMAP.md cannot be read")
        return
    states = cards.chain_states(chain.must())

    if states.is_err()
        report.keep_failure(@r, label: "records/homes", detail: "  " + cards.failure_of(states))
        return
    is_open = states.must()
    files = milestone_pages(present)

    if files.len() == 0
        report.keep_failure(
            @r,
            label: "records/homes",
            detail: "  `" + MILESTONES + "` holds no page, so this check read zero milestones and\n  would pass whatever had been filed. Either the tree moved and this reader\n  did not follow it, or every milestone has been closed."
        )
        return

    if is_among("docs/work/SCHEDULED.md", seen: present)
        report.keep_failure(
            @r,
            label: "records/homes",
            detail: "  `docs/work/SCHEDULED.md` is back, and two places now claim to hold the\n  scheduled work. It became `" + MILESTONES + "` on 2026-09-12, one file per\n  milestone; a list in two homes is the shape this repository's record is a\n  long account of."
        )
        return
    offenders: [str] @= []

    for path in files
        own = strings.without_suffix(text: strings.base_name(path), suffix: ".md")

        if is_open[own].is_err()
            offenders @ offenders.push("    " + own + ": a page and no row in § The chain")

    for path in present
        if strings.starts_with(text: path, prefix: MILESTONES + "/") && !is_among(path, seen: files)
            offenders @ offenders.push(
                "    " + path + ": below the pages, and a milestone's items are its issues on GitHub"
            )

    if held.asked
        for one in records_github.unhomed(held: held, chain: is_open)
            offenders @ offenders.push("    " + one)
    else
        records_github.unanswered(@r, held: held, label: "records/homes")

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/homes",
            detail: "  an item is filed where a reader would not find it — an open feature or task\n  names as its GitHub milestone the milestone it is owed to, and that milestone has an\n  open row in § The chain:\n" + offenders.join("\n")
        )
    else
        report.keep_pass(@r)

# The one milestone list, and the tree that holds it.
constant MILESTONES: str
    "docs/roadmap/milestones"

# A milestone's page, `M-<name>.md` directly in the tree: its reasoning, the
# description of the milestone it becomes on GitHub, and no item.
function milestone_pages(present: [str]) -> [str]
    out: [str] @= []

    for path in present
        rest = strings.without_prefix(text: path, prefix: MILESTONES + "/")

        if strings.starts_with(text: path, prefix: MILESTONES + "/") && strings.ends_with(text: path, suffix: ".md") && !strings.contains(text: rest, needle: "/")
            out @ out.push(path)

    return out

# `- [ ] **M-guide-book** | …` — the milestone an OPEN item is scheduled at.
# A ticked item is not read at all: it belongs to `docs/work/DONE.md`, and the
# record is allowed to name a milestone that has since closed.
function item_milestone(row: str) -> str?
    if !strings.starts_with(text: row, prefix: "- [ ] **M-")
        return fail(code: "shape", msg: "the first field is not a milestone")
    rest = strings.without_prefix(text: row, prefix: "- [ ] **")
    end = strings.index_of(text: rest, needle: "**")

    if end.is_err()
        return fail(code: "shape", msg: "the name is not closed")
    return ok(rest.slice(from: 0, to: end.must()))

function all_digits(text: str) -> bool
    if text.len() == 0
        return false
    i: i64 @= 0

    while i < text.len()
        if !is_digit(text[i])
            return false
        i @ i + 1

    return true

# Enough of an offending line to recognise it without printing the item, which
# runs to several thousand characters.
#
# The cut asks where a character boundary is, and it has to: 78 is an offset
# chosen for width, and the line is prose. Measured 2026-09-13 — a fixed cut here
# took the whole suite down with `panic: string slice splits a character` on a
# 79-byte and an 80-byte line ending in an em dash, while 81 and 82 passed,
# because at those two lengths the dash's three bytes straddled the offset. The
# item was legal and the instrument died reporting it.
function head_of(row: str) -> str
    if row.len() <= 78
        return row
    return row.slice(from: 0, to: strings.boundary_at_or_below(text: row, at: 78)) + " …"

# The three live lists hold OPEN items and nothing else — the shape the author
# asked for on 2026-09-07: the items with their state and their description, no
# prose around them, and one loud line where they begin, so that a glance says
# whether anything is owed.
#
# **This is the executor of a rule four documents already stated.** CLAUDE.md §3
# states it, `/decide` states it, `/step` states it, and each file's own preamble
# states it — and nothing performed it, which is CLAUDE.md §3's own story about
# `DECIDE.md` reaching 391 KB told for the third time. What it cost here is
# measured rather than imagined: `DEFECTS.md` had grown 2753 bytes of prose about
# FIVE already-repaired defects, every one of them already in `docs/work/DONE.md`,
# and `DECIDE.md` carried three paragraphs about items it no longer held. A list
# that describes items it does not hold reads exactly like a list that lost one.
#
# Four accusations, and each is a shape one of the three files has been in.
#
# And a fifth, since 2026-10-02, for the defects alone: every item carries
# one class (`class_offences`), and the rule is printed once under the items
# it refuses, so the message says what to write as well as where.
#
# **Since 2026-10-04 the defects are a front page and a file per item**, the
# author's *5a*. The item region's rules move to the file that holds the item
# (`defect_file_offences`): an open item, alone, its line first and its body
# indented, the number in the file's name the number on its line. The page is
# held to holding none of it (`front_page_offences`). And the record's own
# tree is asked for an open item, file by file, because a defect now closes
# by moving its whole file into it.
#
# **Since 2026-10-04 the items are issues**, the author's instruction of that
# day: one file per item in `ISSUES`, open and closed side by side, and this
# check held each open one to the item's shape and its front page to holding
# none. **Since 2026-10-12 the issues are GitHub's** (the author's seven
# answers), and what this held of an issue's file is held of a draft by the
# transcription program before it opens an issue (`issue_draft.hero`, with
# `item_shape.hero`'s readings); what stays here is the pages: a milestone's
# holds its reasoning and no item, the learning list's front page its rules,
# and each question its one item.
function lists(@r: report.Report, present: [str])
    offenders: [str] @= []

    for path in milestone_pages(present)
        page = read_file(path)

        if page.is_err()
            offenders @ offenders.push("    " + path + ": cannot be read")
        else
            for complaint in front_page_offences(text: page.must(), home: ON_GITHUB, ceiling: 0)
                offenders @ offenders.push("    " + path + ": " + complaint)

    learning_page = read_file(LEARNING_PAGE)

    if learning_page.is_err()
        offenders @ offenders.push("    " + LEARNING_PAGE + ": cannot be read")
    else
        for complaint in front_page_offences(text: learning_page.must(), home: "a file of its own in " + LEARNING, ceiling: PREAMBLE_CEILING)
            offenders @ offenders.push("    " + LEARNING_PAGE + ": " + complaint)

    asked: i64 @= 0

    for path in present
        if !is_question(path)
            continue
        question = read_file(path)

        if question.is_err()
            offenders @ offenders.push("    " + path + ": cannot be read")
            continue

        for complaint in learn_offences(path: path, text: question.must())
            offenders @ offenders.push("    " + path + ": " + complaint)

        if strings.starts_with(text: question.must(), prefix: "- [ ] ")
            asked @ asked + 1

    if asked < LEARNING_FLOOR
        offenders @ offenders.push(
            "    " + LEARNING + ": " + asked.to_str() + " open questions and the floor is " + LEARNING_FLOOR.to_str() + " — a walk that reads almost nothing passes for the wrong reason, which is what the count line used to catch"
        )

    if offenders.len() > 0
        report.keep_failure(
            @r,
            label: "records/lists",
            detail: "  a page is not in the shape its rules state — a milestone's page and a front page hold their rules and no item, a question its one item, its line first and its body indented:\n" + offenders.join("\n")
        )
    else
        report.keep_pass(@r)

# Where a milestone's item lives since the issues left the tree: what a
# milestone page's item is told it should have been.
constant ON_GITHUB: str
    "an issue of its own on GitHub, with the milestone set"

# A front page against its rules: what its files are, how one is filed and how
# one closes, and **no item, no banner and no count**, each of which would make
# the page a second list beside the files, the count in one drifting from the
# other. Held whole to `ceiling` where one is given, having no banner to stand
# above; a milestone's page is given none, its preamble being the milestone's
# reasoning, which `/step` § 1 calls the thing that must not be lost.
function front_page_offences(text: str, home: str, ceiling: i64) -> [str]
    out: [str] @= []
    number: i64 @= 0

    for row in strings.lines(text)
        number @ number + 1

        if strings.starts_with(text: row, prefix: "- [")
            out @ out.push(
                "line " + number.to_str() + ": an item, and an item is " + home + ": " + head_of(row)
            )
        else if row == item_shape.BANNER
            out @ out.push("line " + number.to_str() + ": a banner, and a front page fences no item region")
        else if strings.starts_with(text: row, prefix: OPEN_PREFIX)
            out @ out.push(
                "line " + number.to_str() + ": a count line, and an open count is counted where the items are, never written beside them: " + head_of(row)
            )

    if ceiling > 0 && number > ceiling
        out @ out.push(
            number.to_str() + " lines, ceiling " + ceiling.to_str() + " — the rules stay, a story moves to docs/records/"
        )
    return out

# ONE QUESTION OF COMPREHENSION against its shape, since 2026-10-05: in the
# folder of its name's day, `docs/learn/<year-month>/<day>/`, one item on its
# first line, ticked or not (a question answered STAYS, `/learn`'s rule), every
# other line blank or indented under it, and **no card**, because a card is
# what makes a file one GitHub issue and a question never becomes one.
function learn_offences(path: str, text: str) -> [str]
    out: [str] @= []
    name = strings.base_name(path)

    if !is_entry_name(name)
        out @ out.push("its name is not `YYYY-MM-DD-HHMM-<slug>.md`, and a question is named for the day it was asked")
    else
        # An entry's name opens with sixteen ASCII bytes, so every cut stands
        # between characters.
        home = LEARNING + "/" + name.slice(from: 0, to: 7) + "/" + name.slice(from: 8, to: 10) + "/" + name

        if path != home
            out @ out.push(
                "it stands in another day's folder, and a question lives in the folder its name's day gives: " + home
            )

    if strings.starts_with(text: text, prefix: cards.FENCE + "\n")
        out @ out.push("line 1 opens a card, and a question is not an issue: it carries no card")
        return out

    # A question answered is a record, and keeps the shape it was written in:
    # the 25 that came from the old record were written before the lists took
    # one shape. Only an open question is held to the shape.
    if strings.starts_with(text: text, prefix: "- [x] ")
        return out
    rows = strings.lines(text)

    if rows.len() == 0 || !strings.starts_with(text: rows[0], prefix: "- [ ] ") && !strings.starts_with(text: rows[0], prefix: "- [x] ")
        out @ out.push("line 1 is not the question's line, and a question opens with it, `- [ ]` or `- [x]`")
        return out
    i: i64 @= 1

    while i < rows.len()
        row = rows[i]

        if strings.starts_with(text: row, prefix: "- [")
            out @ out.push(
                "line " + (i + 1).to_str() + ": a second item, and a file here holds one question: " + head_of(row)
            )
        else if strings.trimmed(row).len() > 0 && !strings.starts_with(text: row, prefix: "    ")
            out @ out.push(
                "line " + (i + 1).to_str() + ": prose at column zero, and a question's body is indented under it: " + head_of(row)
            )
        i @ i + 1

    return out

# The open defects' files: every path under `DEFECT_FILES` but its keeper, in
# the walk's order, which is the names' and so the numbers'.
function defect_files(present: [str]) -> [str]
    out: [str] @= []

    for path in present
        if strings.starts_with(text: path, prefix: DEFECT_FILES + "/") && path != DEFECT_KEEPER
            out @ out.push(path)

    return out

test "a front page holds its rules and no item, no banner and no count"
    page = "# Issues\n\nthe rules, and where the files are\n"
    assert front_page_offences(text: page, home: ON_GITHUB, ceiling: PREAMBLE_CEILING).len() == 0
    assert strings.contains(
        text: front_page_offences(text: page + "- [ ] **177 — x** | a | b\n", home: ON_GITHUB, ceiling: PREAMBLE_CEILING)[0],
        needle: "line 4: an item, and an item is an issue of its own on GitHub"
    )
    assert strings.contains(
        text: front_page_offences(text: page + item_shape.BANNER + "\n", home: ON_GITHUB, ceiling: PREAMBLE_CEILING)[0],
        needle: "line 4: a banner"
    )
    assert strings.contains(
        text: front_page_offences(text: page + "**OPEN: 52**\n", home: ON_GITHUB, ceiling: PREAMBLE_CEILING)[0],
        needle: "line 4: a count line"
    )

    # The single list a page used to be is every one of the three at once.
    old = page + item_shape.BANNER + "\n**OPEN: 1**\n\n- [ ] **177 — x** | a | b\n\n" + item_shape.BANNER + "\n"
    assert front_page_offences(text: old, home: ON_GITHUB, ceiling: PREAMBLE_CEILING).len() == 4

    # Held whole to a ceiling where one is given, at the line and one past it;
    # a milestone's page is given none, its preamble being its reasoning.
    at_ceiling: str @= ""
    written: i64 @= 0

    while written < PREAMBLE_CEILING
        at_ceiling @ at_ceiling + "a rule\n"
        written @ written + 1

    assert front_page_offences(text: at_ceiling, home: ON_GITHUB, ceiling: PREAMBLE_CEILING).len() == 0
    assert strings.contains(
        text: front_page_offences(text: at_ceiling + "a story\n", home: ON_GITHUB, ceiling: PREAMBLE_CEILING)[0],
        needle: "lines, ceiling"
    )
    assert front_page_offences(text: at_ceiling + at_ceiling + at_ceiling, home: ON_GITHUB, ceiling: 0).len() == 0

test "the section ends at a rule and not at anything that merely starts like one"
    # The shape the record was actually in on 2026-09-06: one good block, then a
    # second whose `| | |` header had been eaten, leaving `---|---|` where a
    # table head belonged. Under `starts_with` that line ended the count at 5 and
    # the check passed over everything below it.
    broken = "## Where we are\n\n| | |\n|---|---|\n| a | b |\n\n---|---|\n| c | d |\n\n---\n"
    torn = scan_where(broken)
    assert torn.found
    assert torn.mangled == 1
    assert torn.counted == 9

    # The same section with one block: nine lines become six and nothing is
    # mangled, which is what a close is supposed to leave behind.
    whole = "## Where we are\n\n| | |\n|---|---|\n| a | b |\n\n---\n"
    kept = scan_where(whole)
    assert kept.found
    assert kept.mangled == 0
    assert kept.counted == 6

    # A rule with trailing spaces still ends the section: the terminator is the
    # line's CONTENT, and an invisible space is not a reason to read on.
    assert scan_where("## Where we are\n| a |\n---   \n| b |\n").counted == 2

    # And a file with no such section says so rather than answering zero, which
    # is a different failure with a different message.
    assert !scan_where("# The Heroes Language\n\nprose\n").found

test "an item's home is its first field, and the prose after the bar is not"
    item = "- [ ] **M-guide-book** | **M-guide-book** (author decision) | the tasks |"
    assert item_milestone(item).must() == "M-guide-book"
    assert item_milestone("- [ ] **M-core-packages** step 0 — three repairs |").must() == "M-core-packages"

    # The nine shapes this check was written for.
    assert item_milestone("- [ ] **The next panel that touches emission** — it rides a sitting |").is_err()
    assert item_milestone("- [ ] **Trigger, not a milestone: the day `grep` returns a generic** |").is_err()

    # A ticked item belongs to the record and is not read here.
    assert item_milestone("- [x] **M-corpus-depth** | closed |").is_err()

test "a row number is digits and nothing else"
    assert all_digits("35")
    assert all_digits("7")
    assert !all_digits("")
    assert !all_digits("3a")
    assert !all_digits(" 35")
    assert !all_digits("**Last closed**")

function boundary(@r: report.Report)
    caught: [str] = ["scheduled for M8c", "at M5b the increfs", "M0 was day zero", "(M6+)"]
    clean: [str] = [
        "STAC-M3 Antuco benchmarks"
        "INT64_MIN % -1 does not trap on ARM64"
        "the RM64 encoding"
        "M-selfhost-fixpoint is v1"
        "hero_desc_str"
    ]
    wrong: [str] @= []

    for text in caught
        if numbered_in(text).is_err()
            wrong @ wrong.push("    not caught: " + text)

    for text in clean
        if !numbered_in(text).is_err()
            wrong @ wrong.push("    false positive: " + text)

    if wrong.len() > 0
        report.keep_failure(@r, label: "records/boundary", detail: "  the boundary rule is wrong:\n" + wrong.join("\n"))
    else
        report.keep_pass(@r)

# An `M` followed by a digit at a word boundary — nothing alphanumeric,
# `_` or `-` before the `M`, so `ARM64` is not a milestone and neither is
# `STAC-M3`, kdb+'s benchmark suite: the one genuine false positive a
# word-anchored search hits, and the reason the rule looks behind.
function numbered_in(text: str) -> str?
    i: i64 @= 0

    while i < text.len()
        if text[i] == 77 && opens_at(text: text, at: i) && i + 1 < text.len() && is_digit(text[i + 1])
            # **Four bytes AT MOST, and never across a character.** `slice`
            # aborts when it splits one (spec § 10 Strings, arrays, maps), and the Rust twin cannot:
            # it reaches for `String::from_utf8_lossy`, which replaces a broken
            # byte instead of stopping. Heroes has no lossy conversion, so the
            # window stops at the first byte above ASCII — every byte in the
            # answer is then one character wide. Found 2026-08-19 the first time
            # this walk read a file with an em dash three bytes after an `M8a`.
            last: i64 @= i + 1

            while last < text.len() && last < i + 4 && text[last] < 128
                last @ last + 1

            return ok(text.slice(from: i, to: last))
        i @ i + 1

    return fail(code: "none", msg: "no numbered milestone")

# Every `M-<name>` in the text, with a trailing hyphen left to the prose.
function names_used(text: str) -> [str]
    found: [str] @= []
    i: i64 @= 0

    while i < text.len()
        if text[i] == 77 && opens_at(text: text, at: i) && i + 2 < text.len() && text[i + 1] == 45 && is_lower(text[i + 2])
            last: i64 @= i + 2

            while last < text.len() && (is_lower(text[last]) || text[last] == 45)
                last @ last + 1

            while last > i + 2 && text[last - 1] == 45
                last @ last - 1

            found @ found.push(text.slice(from: i, to: last))
            i @ last
        else
            i @ i + 1

    return found

# Whether this file is one that quotes the retired spelling on purpose.
function quoting(path: str) -> bool
    for name in QUOTES_THE_OLD_SPELLING
        if strings.ends_with(text: path, suffix: name)
            return true

    return false

function opens_at(text: str, at: i64) -> bool
    if at == 0
        return true
    before = text[at - 1]

    if is_lower(before) || is_digit(before)
        return false

    if before >= 65 && before <= 90
        return false
    return before != 95 && before != 45

function is_digit(byte: u8) -> bool
    return byte >= 48 && byte <= 57

function is_lower(byte: u8) -> bool
    return byte >= 97 && byte <= 122

# The names the alias table carries: every row opening with "| `M-".
#
# **It moved out of `docs/ROADMAP.md` on 2026-09-12** (author instruction: the
# chain file is the chain and the status, nothing else), and this line followed
# it in the same commit rather than going quiet a check later.
function alias_table() -> [str]
    text = read_file("docs/roadmap/names.md")

    if text.is_err()
        none: [str] = []
        return none
    rows: [str] @= []

    for row in strings.lines(text.must())
        if strings.starts_with(text: row, prefix: "| `M-")
            rest = strings.without_prefix(text: row, prefix: "| `")
            at = strings.index_of(text: rest, needle: "`")

            if !at.is_err()
                rows @ rows.push(rest.slice(from: 0, to: at.must()))

    return rows

test "a dead citation is caught, and the anchored rule ignores what it must"
    roots: {str: bool} @= {}
    roots["docs"] @ true
    roots["selfhost"] @ true
    known: {str: bool} @= {}
    known["docs/ROADMAP.md"] @ true
    known["docs/panel/086-the-ledger-that-outlives-its-file.md"] @ true
    known["selfhost/main.hero"] @ true

    # A path claim that holds, one that does not.
    assert exists_or_prefixes(token: "docs/ROADMAP.md", known: known)
    assert !exists_or_prefixes(token: "docs/NOSUCH.md", known: known)

    # A record cited by its number, without its slug — the case that would need an
    # allow-list under a stricter rule.
    assert exists_or_prefixes(token: "docs/panel/086", known: known)

    # A directory, with and without its slash.
    assert exists_or_prefixes(token: "selfhost/", known: known)

    # A file beside a directory, its name beginning with the directory's, is not
    # inside it; without the slash the prefix is the string's, which is how a
    # module is cited by its path.
    known["docs/design.md"] @ true
    assert !exists_or_prefixes(token: "docs/design/", known: known)
    assert exists_or_prefixes(token: "selfhost/main", known: known)

    # What the rule must NOT read as a path claim: a glob, a bare word, an
    # absolute path and a URL. **A brace form IS one now**, where the old rule
    # refused it: `expanded` reads it exactly, so it is two claims and not zero.
    assert !is_claim(token: "docs/**/*.md", roots: roots)
    assert !is_claim(token: "SPEC_TOKENS", roots: roots)
    assert !is_claim(token: "/usr/include/stdio.h", roots: roots)
    assert !is_claim(token: "https://example.com/a.md", roots: roots)
    assert is_claim(token: "docs/heroes/src/{lexer,syntax}/mod.rs", roots: roots)
    assert expanded("docs/x/{a,b}.rs") == ["docs/x/a.rs", "docs/x/b.rs"]

    # And what it must read: an ordinary citation, and one whose root has DIED,
    # which is the case panel 086 measured this check going green over.
    assert is_claim(token: "docs/ROADMAP.md", roots: roots)
    assert is_claim(token: "selfhost/main.hero", roots: roots)
    assert is_claim(token: "crates/heroes/src/emit/gate.rs", roots: roots)

    # **The tokens no longer come out of the backticks alone**, and that is the
    # repair: the compiler's own citations carry none, which is how 164 files
    # pointed at a moved tree while this check stayed green.
    bare = claims_on(
        row: "# Port of selfhost/main.hero, and `docs/ROADMAP.md` beside it, and plain is not a path",
        roots: roots
    )
    assert bare == ["selfhost/main.hero", "docs/ROADMAP.md"]

    # A line that carries its own evidence: a date, or a path that resolves.
    assert is_dated("# it was `docs/debrief/QUEUE.md` until 2026-08-26")
    assert !is_dated("# it is `docs/debrief/QUEUE.md`")

    # The check itself, firing: a stand-in document citing something absent.
    fired: report.Report @= report.empty()
    no_closed: {str: bool} = {}
    unarchived: [str] = []
    citations(
        @fired,
        scratch: "build/harness-selftest",
        present: ["design.md"],
        closed: no_closed,
        archive: Archive(state: "tree", why: "", paths: unarchived)
    )
    assert fired.failed + fired.passed == 1

    # **The defect this check shipped with, named after itself** (§9: a fixed
    # defect gets a case). An ignored path that does not exist must be excused,
    # and this asserts it against git's rules rather than against the disk, so it
    # answers the same on a fresh checkout as on a machine that has built the
    # site. `site/` ignores `dist/`, and `site/dist/nosuch.html` has never
    # existed anywhere.
    #
    # **Asked of a repository this test plants, the tree's own rule copied**
    # (defect 2065): a copy of the tree made without `.git`, as
    # `docs/platforms/linux/LINUX-MACHINE.md` makes one, has no rules git can
    # read, `fatal: not a git repository` whether or not `--no-index` is given
    # (measured 2026-10-14 on Linux arm64), and this test read red there. A
    # planted repository answers in that copy, in a fresh `git init` and in the
    # CI's one-commit clone alike; a machine where git does not start says so.
    # **And on Windows**: this asked `shell.can_run_scripts()` until then, a
    # POSIX question this test's subject is not, and the box answers it no, so
    # the assertions below had never run there; git answers them there all the
    # same (measured on the box the same day).
    planted = planted_ignores("build/harness-selftest")

    if planted.is_err()
        print("SKIP suite_records: the ignore rule of a dead citation\n  " + planted_failure(planted))
    else
        excused = ignored_by_git(
            scratch: "build/harness-selftest",
            tree: planted.must(),
            tokens: ["site/dist/nosuch.html", "site/dist", "CLAUDE.md"]
        )
        assert !excused["site/dist/nosuch.html"].is_err()
        assert excused["CLAUDE.md"].is_err()

        # **The bare directory name, which is the half the first repair missed.**
        # `.gitignore` says `dist/`, a directory-only pattern, and git cannot
        # tell a path is a directory when the path is not there: five citations
        # stayed red on Linux until the token was asked with a slash too. The
        # slashed form is what must come back, and the bare one does not on a
        # tree where `site/dist` has never been built.
        assert !excused["site/dist/"].is_err()
        assert excused["site/dist"].is_err()

        # And no tokens means no process: the common case pays nothing.
        none: [str] = []
        assert ignored_by_git(scratch: "build/harness-selftest", tree: planted.must(), tokens: none).len() == 0
        assert !shell.remove_tree(planted.must()).is_err()

# A repository of its own under `scratch`, `ignores`, holding the tree's rule
# for the site's build, `site/.gitignore`'s `dist/` (defect 2065): its path, or
# why git could not make it.
function planted_ignores(scratch: str) -> str?
    dir = scratch + "/ignores"
    _ = shell.remove_tree(dir).is_err()
    shell.mkdir_all(dir + "/site")?
    made = shell.attempted(scratch: scratch, program: "git", words: ["git", "-C", dir, "init", "-q"])?

    if !made.started
        return fail(code: "git", msg: "git does not start on this machine, so its ignore rules cannot be asked here")

    if made.code != 0
        return fail(
            code: "git",
            msg: "`git init` at " + dir + " exited " + made.code.to_str() + ": " + strings.trimmed(made.err) + ", so git's ignore rules cannot be asked here"
        )
    write_file(path: dir + "/site/.gitignore", text: "dist/\n")?
    return ok(dir)

function planted_failure(planted: str?) -> str
    return match planted
        .ok _  => ""
        .err e => e.msg

test "a pointer into a section the contract does not have is caught, and both spellings are read"
    # The two spellings in use, and a bare `§` that belongs to another document.
    assert sections_cited("see CLAUDE.md §7 and CLAUDE.md § 14 for the rest") == ["7", "14"]
    assert sections_cited("design.md §1.6 sets the budget") == []
    assert sections_cited("CLAUDE.md § Hard stops is a name, not a number") == []

    # `§` is two bytes, so a walk that assumed one would read the second of them
    # as the start of the number and answer 167 or nothing.
    assert sections_cited("CLAUDE.md §11 twice, CLAUDE.md §11") == ["11", "11"]

    # The headings, read off the shape the contract actually uses: numbered ones
    # yes, named ones no.
    assert numbered_headings("## 1. Re-read protocol\n## Hard stops\n## 15. Working instructions\n") == ["1", "15"]
    assert numbered_headings("# 3. not a section heading\n") == []

    # The detection firing: a document pointing at a section that is not on the
    # map. It is tested here rather than by writing a broken file into the tree,
    # because the walk would then read that file as a real offender.
    known: {str: bool} @= {}
    known["7"] @ true
    assert unknown_sections(text: "CLAUDE.md §7 is fine", known: known) == []
    assert unknown_sections(text: "CLAUDE.md §16 is not", known: known) == ["16"]

    # And the vacuous-pass floor: a contract whose headings this reader cannot
    # see must fail rather than bless every citation in the tree.
    blind: report.Report @= report.empty()
    sections(@blind, living: ["design.md"])
    assert blind.failed + blind.passed == 1

test "the boundary rule catches the numbers and nothing else"
    assert !numbered_in("scheduled for M8c").is_err()
    assert !numbered_in("at M5b the increfs").is_err()
    assert !numbered_in("M0 was day zero").is_err()
    assert !numbered_in("(M6+)").is_err()
    assert numbered_in("STAC-M3 Antuco benchmarks").is_err()
    assert numbered_in("INT64_MIN % -1 does not trap on ARM64").is_err()
    assert numbered_in("the RM64 encoding").is_err()
    assert numbered_in("M-selfhost-fixpoint is v1").is_err()
    assert numbered_in("hero_desc_str").is_err()

# The check that CLAUDE.md §11 is obeyed, made to fire on purpose (§9: every
# verifier check has a test that makes it fire). The Italian line is the shape
# that got past every reader for a month — one quoted instruction inside an
# English document — and the English lines are the three that would have made
# this check cry wolf: a `constant` full of identifiers, a sentence about the
# Italian edition, and the spelling rule whose subject is Italian words.
test "an Italian line is caught, and the English ones around it are not"
    assert italian_line("non voglio nulla in memoria e voglio tutto nel Claude MD")
    assert italian_line("metti come regola che chi capita sul sito non sia un esperto")
    assert italian_line("Non le voglio le date, non le voglio assolutamente")
    assert !italian_line("Italian nav labels are wider, plus the language badge, so the")
    assert !italian_line("never `dai`; `perche`, `finche`, `trentatre` with the acute accent")
    assert !italian_line("the author studies from the Italian, so where the two diverge")
    assert !italian_line("a b c d e")

    assert italian_by_design("site/src/html/it/index.html")
    assert italian_by_design(".claude/skills/where/italian-vocabulary.md")
    assert !italian_by_design("site/src/html/index.html")
    assert !italian_by_design("CLAUDE.md")

    assert reads_as_prose("CLAUDE.md")
    assert reads_as_prose("selfhost/grammar_expr.hero")
    assert !reads_as_prose("site/package-lock.json")

    assert latin_words("due, tre cose").len() == 3
    assert latin_words("a `token dropped` b").len() == 2
    assert same_folded(word: "Non", marker: "non")
    assert !same_folded(word: "none", marker: "non")

# The quotation rule, on the five shapes the LINE rule could not see: a short
# instruction inside an English sentence. Every one of these was a real span in
# this repository on 2026-09-04, and the line rule missed all five.
test "a short Italian quotation is caught where a per-line count cannot see it"
    assert italian_quote("convoca il panel e finisci")
    assert italian_quote("supera la regola per heroes")
    assert italian_quote("un artefatto di interfaccia")
    assert italian_quote("panel usa sempre soluzione piu robusta e sicura mai piu economica")
    assert italian_quote("usa questa immagine duotonata nella pagina autore")
    assert italian_quote("NO AI SLOP via tutti i")

    # The floor, asserted so that it is a known bound and not a surprise: three
    # words carrying one function word cannot be told from English by counting.
    assert !italian_quote("continua senza chiedermelo")

    # The English quotations this contract and the site rulebook actually carry.
    # Every one of them is a span the check reads on every run.
    assert !italian_quote("this is huge")
    assert !italian_quote("it took 0.94 of the time")
    assert !italian_quote("any textual difference between two versions is SEMANTIC")
    assert !italian_quote("the copy that used to stand here is deleted rather than corrected a third time")
    assert !italian_quote("a suite that had never been run")
    assert !italian_quote("every commit subject cites that path")

    assert quoted_spans("a *\"one two three\"* b").len() == 1
    assert quoted_spans("*\"first\"* and *\"second\"*").len() == 2
    assert quoted_spans("an unterminated *\"span").len() == 0

# **Four markers AND a quarter of the line.** Both, because a long English line
# reaches four markers on its own and a short one reaches a quarter on `una`
# alone. Six words before the line is looked at at all, so a heading, a table
# cell and a nav label are below the horizon.
#
# Measured 2026-09-04 over every tracked `.md`, `.hero`, `.c`, `.h`, `.html`,
# `.astro` and `.txt` file outside the records: **23 files fire, and all 23 are
# declared** — the Italian edition's 22 pages and the `/where` vocabulary. Zero
# false positives, which is the number this threshold was chosen to hit.
# **The quotation rule.** A span of three words or more, inside `*"…"*`, where
# two of the words and a fifth of them are Italian. Lower than the line rule on
# both counts because the span is known to be somebody's quoted words: there is
# no English sentence around them to dilute, and no code to mistake.
#
# Measured 2026-09-04 over every `*"…"*` span in the tree outside the records:
# the only spans it fires on are Italian. **The one span of the 42 it misses is
# `*"continua senza chiedermelo"*`** — three words, one of them a function word,
# so it cannot reach two markers whatever the percentage is. That is the floor
# of this rule rather than a bug in it: a three-word quotation carrying one
# Italian preposition is not distinguishable from an English one by counting,
# and a rule loose enough to take it would take `*"this is huge"*` with it.
# The bound is stated here rather than left to be discovered: **an Italian
# instruction of three words or fewer walks past this check.**
function italian_quote(span: str) -> bool
    words = latin_words(span)

    if words.len() < 3
        return false

    marked: i64 @= 0

    for word in words
        if is_quoted_marker(word)
            marked @ marked + 1

    return marked >= 2 && marked * 100 >= 20 * words.len()

function is_quoted_marker(word: str) -> bool
    for marker in QUOTED_MARKERS
        if same_folded(word: word, marker: marker)
            return true

    return false

# Every `*"…"*` span in a file, in order. A quotation may run over several lines
# — most of the long ones do — so this reads the whole text rather than a line,
# and an unterminated `*"` is simply not a span.
function quoted_spans(text: str) -> [str]
    out: [str] @= []
    i: i64 @= 0

    while i + 1 < text.len()
        if text[i] == 42 && text[i + 1] == 34
            j: i64 @= i + 2
            closed: bool @= false

            while j + 1 < text.len()
                if text[j] == 34 && text[j + 1] == 42
                    closed @ true
                    break
                j @ j + 1

            if closed
                out @ out.push(text.slice(from: i + 2, to: j))
                i @ j + 2
                continue
        i @ i + 1

    return out

function italian_line(line: str) -> bool
    words = latin_words(line)

    if words.len() < 6
        return false

    marked: i64 @= 0

    for word in words
        if is_marker(word)
            marked @ marked + 1

    return marked >= 4 && marked * 100 >= 25 * words.len()

test "names_used reads a name and leaves the prose alone"
    assert names_used("M-harness-port is next") == ["M-harness-port"]
    assert names_used("see M-selfhost-fixpoint — and M-bootstrap-archive").len() == 2

    # A trailing hyphen belongs to the prose, not to the name.
    assert names_used("the M-harness-port- dash")[0] == "M-harness-port"
    assert names_used("ARM-based").len() == 0
    assert names_used("no names here").len() == 0

test "the alias table is read out of the ROADMAP"
    table = alias_table()
    assert table.len() == ROWS
    assert table[0].len() > 2

test "a sitting's queue item is found by the digits the record actually writes"
    # The defect this repaired: `091-*.md` parsed to 91 and hunted for
    # `panel 91`, while every item in the queue writes `panel 091`. The
    # padded form is what the repository uses; the bare one is accepted
    # because a human may reach for it and it names no other sitting.
    assert sitting_digits("docs/panel/091-a-name.md").must() == "091"
    assert sitting_digits("docs/panel/007-a-name.md").must() == "007"

    # The watch list's own name, kept as a case after the file was retired on
    # 2026-09-04: a dashed name with no digits parses to something, and what it
    # parses to must still not read as a sitting number. `is_sitting` is what
    # refuses it, and this line is why that function asks for a digit.
    assert sitting_digits("docs/panel/OPEN-QUESTIONS.md").must() == "OPEN"
    assert sitting_digits("docs/panel/nodash.md").is_err()

    # The integer is still what the floor compares, and the two answers
    # differ exactly where the defect lived.
    assert sitting_number("docs/panel/091-a-name.md").must() == 91
    assert sitting_digits("docs/panel/091-a-name.md").must() != sitting_number("docs/panel/091-a-name.md").must().to_str()

test "a sitting is a file in that tree and never one under a subdirectory of it"
    # The four clauses, each asserted on the value in hand. Added 2026-09-14 at
    # panel 147, the first sitting to keep its briefs beside it.
    assert is_sitting("docs/panel/147-a-name.md")
    assert !is_sitting("docs/panel/a-name.md")
    assert !is_sitting("docs/panel/147-a-name.txt")
    assert !is_sitting("elsewhere/147-a-name.md")

    # The clause this test exists for, and it was MISSING until a file provoked
    # it. `docs/panel/000-plan-review/README.md` has satisfied the other three
    # since the day it was written and was skipped only by `VERDICT_FLOOR`,
    # its number being 0 — so the predicate was wrong for as long as nothing
    # numbered above the floor lived in a subdirectory. Panel 147's twelve
    # brief and report files were the first, and twelve things that are not
    # sittings were asked for an author's verdict.
    assert !is_sitting("docs/panel/147-briefs/00-shared.md")
    assert !is_sitting("docs/panel/147-reports/historian.md")
    assert !is_sitting("docs/panel/000-plan-review/README.md")

test "a citation that names a member is checked at its file, and that is the hole it closes"
    # The token that provoked panel 092: `CLAUDE.md` carried it for months and
    # this check never looked, because neither half of `anchored` fired — the
    # first component is not a repo directory and `::FLAGS` is not an extension.
    assert without_member("commands/flags.rs::FLAGS") == "commands/flags.rs"
    assert without_member("selfhost/cli/flags.hero::flags()") == "selfhost/cli/flags.hero"
    assert without_member("selfhost/cli/flags.hero") == "selfhost/cli/flags.hero"
    assert without_member("no colons here") == "no colons here"

    # And with the member cut, the dead one anchors on its extension — which is
    # the whole repair: it becomes visible to the check rather than skipped.
    roots: {str: bool} @= {}
    roots["selfhost"] @ true
    assert is_claim(token: without_member("commands/flags.rs::FLAGS"), roots: roots)
    assert !is_claim(token: "commands/flags.rs::FLAGS", roots: roots)
    assert is_claim(token: without_member("selfhost/cli/flags.hero::flags()"), roots: roots)

# **A SECOND ASSERT STOOD IN THE CASE BELOW UNTIL 2026-09-12.** It read
# `assert WHERE_CEILING == 15`, under the words *"the ceiling is a number this
# file states rather than one it remembers"* — and what it stated was the
# constant against itself, declared in the same file. No defect could fail it:
# not a wrong ceiling, which it would have agreed with, and not a broken count,
# which the call in the case already catches. What it did do was demand a hand
# edit at every raise, which is the cost `suite_layout.hero`'s ceiling table
# paid twice in red CI legs before the same shape was retired there on this
# same day.
#
# A number written twice earns its second copy by PROVING something about the
# first — that a lookup reads it, say. This one proved that a constant equals
# itself, so it is gone rather than raised.
test "the ROADMAP's § Where we are is counted to its own ceiling"
    # The real file, which is the point: this check exists because the section
    # was 31 lines against a rule nobody measured. The rule said 15 then and
    # says 32 since 2026-09-12; the reason for both numbers is above
    # `WHERE_CEILING`, which is the one place either is written.
    r: report.Report @= report.empty()
    where_we_are(@r)
    assert r.failed == 0

# Whether git is deliberately not tracking this, or anything above it.
# **`is_ignored` stood here until 2026-09-07**, walking a map of the ignored
# paths that existed on the machine running the check. `ignored_by_git` above
# replaces it, and the parameter it needed is gone from `names_something` and
# `one_names` with it: two oracles for one question, and the cheaper one was
# wrong on every machine but the author's.

test "a removal below the record's first line is caught and one above it is not"
    # The shape `git diff HEAD` produces, file header included — those two rows
    # open with the same bytes as a removal and an addition, and a reader that
    # counts them reports the header as a deleted line.
    diffed = "diff --git a/DESIGN-LOG.md b/DESIGN-LOG.md\nindex 1111111..2222222 100644\n--- a/DESIGN-LOG.md\n+++ b/DESIGN-LOG.md\n@@ -3,3 +3,3 @@\n \n-Format: the preamble, reworded\n+Format: the preamble, reworded better\n@@ -240,3 +240,2 @@\n 2026-08-11 | a decision | reason | § | 017\n-2026-08-12 | the decision somebody deleted | reason | § | 018\n 2026-08-13 | another | reason | § | 019\n"
    caught = removed_below(text: diffed, floor: 5)
    assert caught.len() == 1
    assert strings.contains(text: caught[0], needle: "the decision somebody deleted")

    # And the preamble is editable on purpose: `7c2198ff` rewrote eighteen
    # lines of DONE's and was right to.
    assert removed_below(text: diffed, floor: 5000).len() == 0

test "a hunk header gives its old line, and one this cannot read gives zero"
    assert hunk_start("@@ -240,7 +240,9 @@") == 240
    assert hunk_start("@@ -1 +1 @@") == 1

    # The loud direction: zero is below every floor, so a header this cannot
    # read reports every removal in its hunk rather than none.
    assert hunk_start("@@ nothing numeric here") == 0

test "a defect item gives its number, and five shapes that are not one"
    assert defect_number("- [ ] **027 — the title**") == "027"
    assert defect_number("- [x] **014 — repaired the same day**") == "014"

    # A milestone item and a sitting item: the other two lists write their own
    # first field in the same position, and neither issues a defect number.
    assert defect_number("- [ ] **M-core-packages** | work | here") == ""
    assert defect_number("- [x] **panel 131** | ratified | there") == ""

    # Indented, so it is a body line and not an item — every count in this
    # project reads the `- [ ] ` line.
    assert defect_number("    - [ ] **027 — indented**") == ""

    # Two digits and four: the width is part of the shape, because the record
    # writes it padded and a reader sorts on it.
    assert defect_number("- [ ] **27 — two digits**") == ""
    assert defect_number("- [ ] **0271 — four digits**") == ""

test "an entry file carries its day and its place in that day, and six names that do not"
    assert is_entry_name("2026-08-03-0000-the-author-arrived.md")
    assert is_entry_name("2026-09-12-2359-a.md")

    # No minute: two entries of one day would then order by slug, and the order
    # a directory is read in is what `read forward` rests on.
    assert !is_entry_name("2026-08-03-the-author-arrived.md")

    # No date at all, and a date that is not one.
    assert !is_entry_name("the-author-arrived.md")
    assert !is_entry_name("2026-8-3-0000-the-author-arrived.md")

    # Upper case, which sorts before lower case and would put one entry of a
    # day in front of the others.
    assert !is_entry_name("2026-08-03-0000-The-Author.md")

    # `README.md`, and this one is the rule rather than a shape: a directory
    # index is a second place where truth lives, and the only tabulated index in
    # this project drifted for nine closes in silence.
    assert !is_entry_name("README.md")

    # Not markdown at all.
    assert !is_entry_name("2026-08-03-0000-the-author-arrived.txt")

# `entries` is not driven from a `test` block, and the reason
# is worth writing down rather than leaving as an omission: it needs the walk,
# the walk needs a scratch directory, and a test that passes `"."` for one makes
# the shell write `stdout`, `stderr` and `listing-project` into the repository
# root. That is what happened here first. They are exercised where they belong,
# by `run_all` over the real tree, and what a literal CAN drive, the name shape,
# is driven above.

test "a paths glob is asked for the part before its star"
    assert prefix_of("docs/**") == "docs"
    assert prefix_of("selfhost/emit/ffi*") == "selfhost/emit/ffi"
    assert prefix_of("CLAUDE.md") == "CLAUDE.md"

    # A partial file name is a PREFIX and not a tree, which is why the matcher
    # beside it is not `selects_tree`: `selfhost/emit/ffi` names no directory and
    # reaches twelve files.
    present = ["one/ffi_gate.hero", "one/other.hero"]
    assert selects_prefix(entry: "one/ffi", present: present)
    assert !selects_prefix(entry: "one/zzz", present: present)

test "a quoted glob loses its quotes and an unquoted one is unchanged"
    assert unquoted("\"docs/**\"") == "docs/**"
    assert unquoted("docs/**") == "docs/**"

# A `docs/work/DEFECTS.md` holding exactly these items, for the tag tests below.
function defects_holding(items: [str]) -> str
    rows: [str] @= [item_shape.BANNER, "**OPEN: " + items.len().to_str() + "**", ""]

    for item in items
        rows @ rows.push(item)
        rows @ rows.push("")

    rows @ rows.push(item_shape.BANNER)
    return rows.join("\n") + "\n"

# One item in the list's shape, its class on its line and in its body.
function defect_item(number: str, kind: str, day: str) -> str
    return "- [ ] **" + number + " — a defect** | what | where · **class: " + kind + "**\n\n    **Class: " + kind + "**, " + day + ", its reason."

# THE PROOF THAT A ROUND CAN NOW END WHILE ADJACENT ITEMS STAND (the author's
# *D3a*, `.claude/rules/verification.md` § Bounded discovery). Each tag here is
# written for the test, so its day is the test's and not the repository's.
test "a tag stands over young adjacent items and improvements, and over no blocking or systemic one"
    none: [str] = []
    no_tags: [Placed] = []
    judged = Placed(name: "m-judged", day: 20261009, open: none)
    earlier = [Placed(name: "m-earlier", day: 20260928, open: ["129"])]
    standing = [
        defect_item(number: "161", kind: "adjacent", day: "2026-10-02")
        defect_item(number: "162", kind: "adjacent", day: "2026-10-05")
        defect_item(number: "163", kind: "improvement", day: "2026-10-02")
    ]
    young = defects_holding(standing)
    assert counted_at(text: young, at: judged, before: earlier).len() == 0
    assert counted_at(text: young, at: judged, before: no_tags).len() == 0

    # One `blocking` among them counts, and so does one `systemic`, alone.
    blocking = defects_holding(standing.push(defect_item(number: "164", kind: "blocking", day: "2026-10-02")))
    told = counted_at(text: blocking, at: judged, before: earlier)
    assert told.len() == 1
    assert strings.starts_with(text: told[0].row, prefix: "- [ ] **164 — ")
    assert told[0].why == "`blocking`"
    systemic = defects_holding(standing.push(defect_item(number: "165", kind: "systemic", day: "2026-10-02")))
    held = counted_at(text: systemic, at: judged, before: earlier)
    assert held.len() == 1
    assert held[0].why == "`systemic`"

test "an adjacent item counts as blocking from the second tag placed since it was filed"
    none: [str] = []
    no_tags: [Placed] = []
    item = defects_holding([defect_item(number: "161", kind: "adjacent", day: "2026-10-02")])
    judged = Placed(name: "m-judged", day: 20261009, open: none)

    # A tag of a later day than the item's was placed since it was filed.
    later = [Placed(name: "m-between", day: 20261005, open: none)]
    aged = counted_at(text: item, at: judged, before: later)
    assert aged.len() == 1
    assert strings.contains(text: aged[0].why, needle: "2 tags placed since it was filed (m-judged m-between)")

    # A tag of its own day counts only where the item stood open at it: the
    # morning's tag, placed before the filing, does not; the evening's does.
    morning = [Placed(name: "m-morning", day: 20261002, open: ["129"])]
    assert counted_at(text: item, at: judged, before: morning).len() == 0
    evening = [Placed(name: "m-evening", day: 20261002, open: ["129", "161"])]
    assert counted_at(text: item, at: judged, before: evening).len() == 1

    # Re-dated, or classed `adjacent` long after it was filed: a tag it stood
    # open at counts whatever day its line names, the rule's word being *filed*.
    redated = [Placed(name: "m-earlier", day: 20260928, open: ["161"])]
    assert counted_at(text: item, at: judged, before: redated).len() == 1

    # Classed after the judged tag's own day, which no item at that tag can be.
    early = Placed(name: "m-early", day: 20261001, open: none)
    future = counted_at(text: item, at: early, before: no_tags)
    assert future.len() == 1
    assert strings.contains(text: future[0].why, needle: "after m-early's own day 2026-10-01")

test "an item without a class at a tag counts as blocking"
    none: [str] = []
    no_tags: [Placed] = []
    tag = Placed(name: "m-carrying", day: 20260928, open: none)

    # Every tag before 2026-10-02 was placed over items in this shape.
    old = defects_holding(["- [ ] **129 — a minus alone** | x | y", "- [ ] **130 — a skipped statement** | x | y"])
    standing = counted_at(text: old, at: tag, before: no_tags)
    assert standing.len() == 2
    assert strings.contains(text: standing[0].why, needle: "no class this check can read")
    assert strings.contains(text: standing[0].why, needle: "counts as `blocking`")

    # A class this cannot read is no class: two tokens, and `adjacent` with them.
    twice = "- [ ] **161 — x** | a | b · **class: adjacent** · **class: improvement**"
    doubled = defects_holding([twice + "\n\n    **Class: adjacent**, 2026-10-02, a reason."])
    judged = Placed(name: "m-judged", day: 20261009, open: none)
    assert counted_at(text: doubled, at: judged, before: no_tags).len() == 1

test "the tags are read with their days, newest first, and a row that has none fails the listing"
    got = placed_tags("2026-09-28 m-agreed-retention\n2026-09-21 m-declared-extents\n")
    assert got.must().len() == 2
    assert got.must()[0].name == "m-agreed-retention"
    assert got.must()[0].day == 20260928
    assert got.must()[1].day == 20260921
    assert placed_tags("").must().len() == 0

    # A tag left out ages nothing, so a row this cannot read is a failure.
    assert placed_tags("m-agreed-retention\n").is_err()
    assert placed_tags("2026-09-28\n").is_err()
    assert placed_tags("2026-09-28 \n").is_err()
    assert placed_tags("2026-9-28 m-agreed-retention\n").is_err()

# THE TWO SHAPES A TAG CAN HOLD THE LIST IN (2026-10-04). Every tag placed
# before that day holds `DEFECTS.md`, every tag after it the directory, and the
# readers downstream are handed one text and cannot tell which it came from.
test "a list at a tag is its directory where the tag has one, and DEFECTS.md where it has not"
    single = shape_listed(["docs/work/DEFECTS.md"])
    assert !single.directory
    assert single.files == ["docs/work/DEFECTS.md"]
    filed = shape_listed(
        ["docs/work/DEFECTS.md", "docs/work/defects/.gitkeep", "docs/work/defects/177-a.md", "docs/work/defects/178-b.md"]
    )
    assert filed.directory
    assert filed.files == ["docs/work/defects/177-a.md", "docs/work/defects/178-b.md"]

    # The goal at a tag: the directory and its keeper, no defect, no item.
    goal = shape_listed(["docs/work/DEFECTS.md", "docs/work/defects/.gitkeep"])
    assert goal.directory
    assert goal.files.len() == 0

    # Neither: a tag placed before the list existed.
    none: [str] = []
    neither = shape_listed(none)
    assert !neither.directory
    assert neither.files.len() == 0

test "git's batch answer is cut by its sizes, and a size that lies is a failure, never a shorter list"
    sha = repeat("1", 40)
    assert blobs_in(sha + " blob 6\nfirst\n\n" + sha + " blob 7\nsecond\n\n").must() == ["first\n", "second\n"]

    # A text holding a blank line and a line shaped like a header is read whole.
    tricky = "- [ ] **177 — a** | x | y\n\n" + sha + " blob 3\n"
    assert blobs_in(sha + " blob " + tricky.len().to_str() + "\n" + tricky + "\n").must() == [tricky]

    # A last line with no line end, an empty file, and no object at all.
    assert blobs_in(sha + " blob 5\nfirst\n").must() == ["first"]
    assert blobs_in(sha + " blob 0\n\n").must() == [""]
    assert blobs_in("").must().len() == 0

    # An object git calls missing, a header that is not a blob's, and sizes
    # too long and too short for the bytes that follow.
    assert failure_code(blobs_in("m-x:docs/work/defects/177-a.md missing\n")) == "missing"
    assert blobs_in(sha + " tree 5\nfirst\n").is_err()
    assert blobs_in(sha + " blob 9\nfirst\n\n").is_err()
    assert blobs_in(sha + " blob 3\nfirst\n\n").is_err()
    assert blobs_in(sha + " blob 6\nfirst\n").is_err()

    # A size that would cut a character in two is refused by the line end it
    # does not reach, and never cut: `—` is three bytes.
    dash = "— x"
    assert blobs_in(sha + " blob 2\n" + dash + "\n").is_err()
    assert blobs_in(sha + " blob 5\n" + dash + "\n").must() == [dash]

test "a tag's directory is read as its single file was, so a tag counts the same items in either shape"
    none: [str] = []
    no_tags: [Placed] = []
    items = [
        defect_item(number: "161", kind: "adjacent", day: "2026-10-02")
        defect_item(number: "164", kind: "blocking", day: "2026-10-02")
        defect_item(number: "165", kind: "systemic", day: "2026-10-03")
    ]
    files: [str] @= []

    for item in items
        files @ files.push(item + "\n")

    as_files = joined_files(files)
    as_list = defects_holding(items)
    judged = Placed(name: "m-judged", day: 20261009, open: none)
    from_files = counted_at(text: as_files, at: judged, before: no_tags)
    assert from_files.len() == 2
    assert from_files == counted_at(text: as_list, at: judged, before: no_tags)
    assert open_rows_in(as_files) == open_rows_in(as_list)

    # Each item's body ends at the next file's line, never inside it.
    regions = item_shape.open_regions(as_files)
    assert regions.len() == 3
    assert strings.contains(text: regions[1].text, needle: "**Class: blocking**")
    assert !strings.contains(text: regions[1].text, needle: "systemic")

    # One blank line between two files, whether or not a file ended its line.
    bare = joined_files(["- [ ] **161 — a** | x | y", "- [ ] **162 — b** | x | y\n"])
    assert bare == "- [ ] **161 — a** | x | y\n\n- [ ] **162 — b** | x | y\n"

test "an issue lives in the folder of its name's day, and a name with no day has none"
    assert issue_home("2026-10-04-1440-defect-239-a.md") == "issues/2026-10/04/2026-10-04-1440-defect-239-a.md"
    assert issue_home("2026-08-03-0000-x.md") == "issues/2026-08/03/2026-08-03-0000-x.md"
    assert issue_home("239-a.md") == ""
    assert issue_home("README.md") == ""
    assert issue_files(["issues/README.md", "issues/2026-10/04/2026-10-04-0000-x.md", "issues/notes.txt", "docs/x.md"]) == ["issues/2026-10/04/2026-10-04-0000-x.md"]

test "once the issue files leave the tree a citation of one is followed to their last commit, and an archive that cannot answer says so"
    scratch = shell.own_scratch()
    shell.mkdir_all(scratch).must()
    document = scratch + "/note.md"
    write_file(
        path: document,
        text: "see `issues/2026-10/01/2026-10-01-0000-a.md` and `docs/records/done/2026-10-01-0000-a.md`\n"
    ).must()
    closed: {str: bool} = {}
    none: [str] = []
    held = Archive(state: "read", why: "", paths: ["issues/2026-10/01/2026-10-01-0000-a.md"])
    found: report.Report @= report.empty()
    citations(@found, scratch: scratch, present: [document], closed: closed, archive: held)
    assert found.failed == 0
    assert found.passed == 1
    other = Archive(state: "read", why: "", paths: ["issues/2026-10/01/2026-10-01-0001-b.md"])
    lost: report.Report @= report.empty()
    citations(@lost, scratch: scratch, present: [document], closed: closed, archive: other)
    assert lost.failed == 1
    assert strings.contains(text: lost.failures[0], needle: "issues/2026-10/01/2026-10-01-0000-a.md")
    unset: report.Report @= report.empty()
    citations(
        @unset,
        scratch: scratch,
        present: [document],
        closed: closed,
        archive: Archive(state: "unset", why: "the constant names no commit", paths: none)
    )
    assert unset.failed == 1
    assert strings.contains(text: unset.failures[0], needle: "the constant names no commit")
    assert strings.contains(text: unset.failures[0], needle: "2 citations of an issue file could not be followed")
    shallow: report.Report @= report.empty()
    citations(
        @shallow,
        scratch: scratch,
        present: [document],
        closed: closed,
        archive: Archive(state: "unreadable", why: "this clone's history is shortened", paths: none)
    )
    assert shallow.failed == 0
    assert strings.contains(text: shallow.skips[0], needle: "2 citations of an issue file were not followed")
    assert archive_of(scratch: scratch, present: ["issues/2026-10/01/2026-10-01-0000-a.md"]).state == "tree"
    assert lands_in_issues("issues/2026-10/01/x.md")
    assert lands_in_issues("docs/work/defects/187-four.md")
    assert !lands_in_issues("docs/panel/190-x.md")
    _ = shell.remove_tree(scratch).is_err()

test "a redirect that lands in the issue files is asked of their archive once they are gone"
    present: [str] @= []

    # Every other row's landing stands, so the rows into the issue files are
    # the ones judged.
    for row in MOVED
        landed = strings.trimmed(strings.split_text(text: row, separator: " -> ")[1])

        if !lands_in_issues(landed + "/") && landed != ISSUES
            present @ present.push(landed)

    none: [str] = []
    read = Archive(state: "read", why: "", paths: ["issues/README.md", "issues/2026-10/01/2026-10-01-0000-a.md"])
    r: report.Report @= report.empty()
    redirects(@r, present: present, archive: read)
    assert r.failed == 0
    unset: report.Report @= report.empty()
    redirects(
        @unset,
        present: present,
        archive: Archive(state: "unset", why: "the constant names no commit", paths: none)
    )
    assert unset.failed == 1
    assert strings.contains(text: unset.failures[0], needle: "lands in the archive, which the constant names no commit")
    shallow: report.Report @= report.empty()
    redirects(
        @shallow,
        present: present,
        archive: Archive(state: "unreadable", why: "this clone's history is shortened", paths: none)
    )
    assert strings.contains(text: shallow.skips[0], needle: "docs/work/defects -> issues")

test "a citation of an issue file shortened by hand names the file it opens, and a bare day names none"
    known: {str: bool} @= {}
    known["issues/2026-08/26/2026-08-26-0001-the-log-entry-of-a-day.md"] @ true
    assert shortened_issue(part: "docs/records/log/2026-08-26-0001-…", known: known)
    assert shortened_issue(part: "docs/records/log/2026-08-26-0001-the-log", known: known)
    assert shortened_issue(part: "issues/2026-08/26/2026-08-26-0001-the-…", known: known)
    assert !shortened_issue(part: "docs/records/log/2026-08-26-0002-…", known: known)
    assert !shortened_issue(part: "docs/records/log/2026-08-26…", known: known)
    assert !shortened_issue(part: "docs/panel/2026-08-26-0001-…", known: known)

test "a citation of a file that moved into the issues is followed by the rule, and still dies with its file"
    known: {str: bool} @= {}
    known["issues/2026-10/04/2026-10-04-1440-defect-239-a.md"] @ true
    known["issues/2026-09/23/2026-09-23-1215-a-seats-copy-is-its-own-decided.md"] @ true
    known["issues/2026-10/02/2026-10-02-0000-defect-187-four.md"] @ true
    assert issue_redirect(part: "docs/records/done/2026-10-04-1440-defect-239-a.md", known: known) == "issues/2026-10/04/2026-10-04-1440-defect-239-a.md"
    assert issue_redirect(part: "docs/done/2026-10-04-1440-defect-239-a.md", known: known) == "issues/2026-10/04/2026-10-04-1440-defect-239-a.md"
    assert issue_redirect(part: SHARED_NAME, known: known) == "issues/2026-09/23/2026-09-23-1215-a-seats-copy-is-its-own-decided.md"
    assert issue_redirect(part: "docs/work/defects/187-four.md", known: known) == "issues/2026-10/02/2026-10-02-0000-defect-187-four.md"

    # A file the rule would find and that is not there; a path the rule does
    # not cover; a file below a retired tree's directory.
    assert issue_redirect(part: "docs/records/done/2026-10-04-1441-gone.md", known: known) == ""
    assert issue_redirect(part: "docs/panel/190-x.md", known: known) == ""
    assert issue_redirect(part: "docs/records/done/sub/2026-10-04-1440-defect-239-a.md", known: known) == ""

test "a diff of many files names each removal's own file and its line in the old file"
    diffed = "diff --git a/issues/a.md b/issues/a.md\nindex 1..2 100644\n--- a/issues/a.md\n+++ b/issues/a.md\n@@ -10,2 +10,1 @@\n-gone from a\n kept\ndiff --git a/issues/b.md b/issues/b.md\n--- a/issues/b.md\n+++ b/issues/b.md\n@@ -3,1 +3,2 @@\n kept\n+added\n@@ -12,1 +13,0 @@\n-gone from b\n"
    got = removed_by_file(diffed)
    assert got.len() == 2
    assert got[0].path == "issues/a.md"
    assert got[0].line == 10
    assert got[0].row == "-gone from a"
    assert got[1].path == "issues/b.md"
    assert got[1].line == 12

    # The second file's own header is never read as a line it removes, which is
    # what reading the diff as one file would do.
    for one in got
        assert !strings.contains(text: one.row, needle: "--- a/")

test "a list at a tag is its issues where the tag has them, and the older shapes where it has not"
    issues_shape = shape_listed(
        ["issues/README.md", "issues/2026-10/04/2026-10-04-0000-defect-1-x.md", "docs/work/DEFECTS.md"]
    )
    assert issues_shape.issues
    assert issues_shape.files == ["issues/2026-10/04/2026-10-04-0000-defect-1-x.md"]
    directory = shape_listed(["docs/work/defects/.gitkeep", "docs/work/defects/177-a.md"])
    assert !directory.issues
    assert directory.files == ["docs/work/defects/177-a.md"]
    single = shape_listed(["docs/work/DEFECTS.md"])
    assert !single.directory
    assert single.files == ["docs/work/DEFECTS.md"]

test "a milestone's page stands directly in its tree, and the chain says which milestones are open"
    pages = milestone_pages(
        ["docs/roadmap/milestones/M-x.md", "docs/roadmap/milestones/M-x/2026-10-04-0000-a.md", "docs/roadmap/milestones/README.txt"]
    )
    assert pages == ["docs/roadmap/milestones/M-x.md"]
    states = cards.chain_states(
        "| 1 | **M-day-zero** | done 2026-08-03 | `m0` |\n| 83 | **M-issue-files** | **OPEN** | — |\n| 82 | **M-guide-book** | scheduled | — |\n| **Current milestone** | **M-other** |\n"
    ).must()
    assert !states["M-day-zero"].must()
    assert states["M-issue-files"].must()
    assert states["M-guide-book"].must()
    assert states["M-other"].is_err()

test "a file under a directory that moved is found under the directory it moved to, and a gone file is not"
    known: {str: bool} @= {}
    known["docs/roadmap/milestones/M-issue-files.md"] @ true
    assert moved_under(part: "docs/work/milestones/M-issue-files.md", known: known)
    assert !moved_under(part: "docs/work/milestones/M-never-written.md", known: known)
    assert !moved_under(part: "docs/work/milestones", known: known)
    assert !moved_under(part: "elsewhere/M-issue-files.md", known: known)

test "a question of comprehension lives in its day's folder, holds one item, and carries no card"
    good = "- [ ] **M-ir-lowering.1** | how many instructions | x\n\n    **Origin:** step 1, 2026-08-03.\n"
    path = "docs/learn/2026-08/03/2026-08-03-0000-first-ir.md"
    assert learn_offences(path: path, text: good).len() == 0
    assert learn_offences(path: path, text: "- [x] **M-ir-lowering.1** | answered, and it stays | x\n").len() == 0
    assert learn_offences(path: path, text: "- [x] The record | M1.1 | written before one shape\n  CLOSED at column two, kept as written\n").len() == 0
    assert strings.contains(
        text: learn_offences(path: "docs/learn/2026-08/04/2026-08-03-0000-first-ir.md", text: good)[0],
        needle: "another day's folder"
    )
    assert strings.contains(
        text: learn_offences(path: "docs/learn/first-ir.md", text: good)[0],
        needle: "its name is not"
    )
    with_card = cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-08-03", commit: "none", github: "none") + good
    assert strings.contains(text: learn_offences(path: path, text: with_card)[0], needle: "a question is not an issue")
    assert strings.contains(
        text: learn_offences(path: path, text: good + "- [ ] another\n")[0],
        needle: "a second item"
    )
    assert strings.contains(
        text: learn_offences(path: path, text: good + "\nloose prose\n")[0],
        needle: "prose at column zero"
    )
    assert strings.contains(
        text: learn_offences(path: path, text: "# a title\n" + good)[0],
        needle: "not the question's line"
    )

test "a question cited in the learning list's old flat shape is found in its day's folder"
    known: {str: bool} @= {}
    known["docs/learn/2026-08/03/2026-08-03-0000-first-ir.md"] @ true
    assert one_names(part: "docs/learn/2026-08/03/2026-08-03-0000-first-ir.md", document: "x.md", known: known)
    assert one_names(part: "docs/learn/2026-08-03-0000-first-ir.md", document: "x.md", known: known)
    assert !one_names(part: "docs/learn/2026-08-03-0001-never-asked.md", document: "x.md", known: known)

test "a question is a file of a year-and-month folder of the learning list, and the glossary beside it is not"
    assert is_question("docs/learn/2026-08/03/2026-08-03-0000-first-ir.md")
    assert !is_question("docs/learn/README.md")
    assert !is_question("docs/learn/glossary/000-basic-block.md")
    assert !is_question("docs/learn/glossary/README.md")
    assert !is_question("issues/2026-08/03/2026-08-03-0000-first-ir.md")

test "a directory of selfhost/ the areas do not name is refused, and one they name is not"
    listed: report.Report @= report.empty()
    areas(@listed, present: ["selfhost/ir/lower.hero", "selfhost/lexer.hero", "docs/x.md"])
    assert listed.passed == 1
    assert listed.failed == 0
    stray: report.Report @= report.empty()
    areas(@stray, present: ["selfhost/nowhere/a.hero", "selfhost/nowhere/b.hero"])
    assert stray.failed == 1
    assert strings.contains(text: stray.failures[0], needle: "    selfhost/nowhere/\n  Add it")
