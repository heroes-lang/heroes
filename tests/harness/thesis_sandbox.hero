# THE SANDBOX A MODEL'S PROGRAM RUNS IN (M-thesis-harness step 6, 2026-10-20;
# panel 226's R11). A Heroes program with no `extern` can still write any file
# its user can, read the author's home, fill the disk and allocate without a
# ceiling (spec § 11: `read_file`, `write_file`); a program a model wrote is
# run as untrusted, and **the grader refuses to run one outside a sandbox**.
#
# ON THIS MAC, `/usr/bin/sandbox-exec` with a profile measured on 2026-10-20
# (the coordinator's probe, panel 226's synthesis § What was measured): `deny
# default`; the process may exec, read its own information and signal itself;
# `sysctl-read` stays, since without it the runtime dies sealing a guard page
# (*the system refused to seal the page after it*); reads are allowed where
# the system's libraries live and denied under `/Users`, `/Volumes` and every
# temporary folder, so the author's files and another sample's scratch are
# unreadable; reads and writes are allowed in the sample's scratch alone, and
# writes on `/dev` for the terminal; the network is denied. Measured: the
# probe wrote inside, was refused outside and in the author's home, read
# neither, and ran the same with its stdout on a pipe. In front of it,
# `/bin/sh -c 'ulimit -f <blocks>; exec env -i PATH=… sandbox-exec …'`: a
# file written past the cap kills the program with SIGXFSZ (exit 153, measured
# on a 10 MB write under `-f 1024`), and `env -i` hands it an empty
# environment. **No memory ceiling exists here**: `ulimit -v`, `-d` and `-m`
# answer *Invalid argument* on this Mac (measured), and the runtime has no
# allocation cap, so memory is bounded by the case's wall-clock bound alone.
#
# NARROWED ON THE FFI-PRAGMATIST'S MEASUREMENTS (panel 226 § 3): `process-exec`
# is allowed for the binary alone (`literal`), which runs it and refuses
# `/bin/sleep`; fork is denied by the absence of `process-fork` (a fork bomb is
# impossible, measured); `/Library/Keychains` and `/Library/Preferences` are
# denied beside the home. **What no profile hides is another process's
# environment**: a C program calling `sysctl(KERN_PROCARGS2)` inside it reads
# the grader's, with `sysctl-read` and `process-info*` denied too (measured,
# `hits=1`), so a seal's key is never in the environment of a process that runs
# a model's program (`keys_held`, `prepared`), and the secrecy rests on that
# rule and on `refused_extern`, never on this profile.
#
# ON LINUX (the CI's `thesis-attest` and any Linux leg), `bwrap`: the system
# bound read-only, the scratch bound read-write, `--unshare-all` (no network,
# own pid space), `--die-with-parent`, `--clearenv`, and `ulimit -f` and
# `ulimit -v` inside it, where RLIMIT_AS is enforced. **Unrun on this Mac,
# and on every CI leg until issue 2162**: the legs that run the net's own
# tests install no bubblewrap, and `thesis-attest`, which does, grades only
# once a sealed suite exists (`.claude/rules/platforms.md`).
#
# Where neither tool exists the words are refused with `no_sandbox`, and
# `thesis_grade` runs no case: a measurement taken outside the sandbox would be
# one a model's program could have forged. **So a test that runs a model's
# program asks `unrunnable()` first and says `SKIP` with its answer**: on the
# CI's Windows leg neither tool exists, and its Linux legs install no
# bubblewrap (the `thesis-attest` job alone does), so the Linux words are
# judged where bubblewrap is installed and nowhere else (issue 2162).

use <core>/strings as core_strings

use shell
use strings
use thesis_seal

constant DARWIN_TOOL: str
    "/usr/bin/sandbox-exec"

constant LINUX_TOOL: str
    "/usr/bin/bwrap"

# `ulimit -f` counts 512-byte blocks: 4096 blocks are 2 MiB per file written.
constant FILE_BLOCKS: i64
    4096

# `ulimit -v` counts KiB: 1 GiB of address space, where the platform enforces it.
constant ADDRESS_KIB: i64
    1048576

# A seal's key is held in a variable whose name opens with `KEY_OPENING` and
# ends with `KEY_CLOSING`, `HEROES_*_KEY`, as panel 226's R10 and R11 write
# the rule: a process holding one runs no model's program, since the profile
# cannot hide one process's environment from another (the ffi-pragmatist's
# measurement, panel 226 § 3: `sysctl(KERN_PROCARGS2)` reads it with
# `sysctl-read` denied too). Today's are the held-out suite's three, its suite,
# its reserve and its runs' transcripts, and the paired run's package suite and
# reserve (task 2300, panel 234's R14).
#
# **Every such name, never a list of them, since defect 2569** (2026-11-15):
# until then the five names above were a list here, three of them until task
# 2300 added two, so a suite sealed under a sixth name would have been graded
# beside its key. The one name apart is the tests' throwaway
# `thesis_seal.TEST_KEY`: it seals a suite of the tests' own, and no model's
# program ever runs under it.
constant KEY_OPENING: str
    "HEROES_"

constant KEY_CLOSING: str
    "_KEY"

# Lists the environment it was given, through POSIX awk's `ENVIRON`, which
# macOS's awk, gawk, mawk and BusyBox's all hold: the name of every variable
# that holds a value, one a line, a newline inside a name written as a space so
# the name stays one line, and never a value, so no key reaches the capture
# file under `build/`. A variable set to nothing holds no key, and awk alone
# reads a value, so one that is not UTF-8 is listed as any other is.
constant AWK: str
    "/usr/bin/awk"

constant NAMES_ONLY: str
    "BEGIN { for (name in ENVIRON) if (ENVIRON[name] != \"\") { shown = name; gsub(/\\n/, \" \", shown); print shown } }"

# Where the listing's two captures are written and removed: the grader's own
# folder under `build/`, never a sample's scratch, which a model's program reads.
constant LISTING_SCRATCH: str
    "build/thesis-environment"

# Why a model's program cannot run on this machine now, or "" where it can:
# neither sandbox tool present, a seal's key in this process's environment, or
# an environment that cannot be listed to say there is none. Every test that
# runs one asks it first and says `SKIP` with the answer, so a suite's verdict
# never depends on what the machine or the shell held.
function unrunnable() -> str
    return unrunnable_with(darwin: DARWIN_TOOL, linux: LINUX_TOOL, held: keys_held())

# The tools are asked first, so a machine that has neither, Windows, answers
# that, whatever its environment's listing could say.
function unrunnable_with(darwin: str, linux: str, held: [str]?) -> str
    if !shell.exists(darwin) && !shell.exists(linux)
        return "neither " + darwin + " nor " + linux + " is on this machine, and a model's program runs inside one or not at all"

    match held
        .err e => return e.msg
        .ok names =>
            if names.len() > 0
                return key_said(names) + ", and no process holding a seal's key runs a program; run the tests in a shell where it is not"

    return ""

# Whether `name` is a seal key's variable: `HEROES_*_KEY`, the `*` any run of
# characters, none included, and not the tests' throwaway key.
function is_key_name(name: str) -> bool
    if name == thesis_seal.TEST_KEY || name.len() < KEY_OPENING.len() + KEY_CLOSING.len()
        return false
    return core_strings.has_prefix(s: name, prefix: KEY_OPENING) && core_strings.has_suffix(s: name, suffix: KEY_CLOSING)

# Every seal key's variable this process's environment holds, in order, or why
# the environment could not be listed: `prepared` refuses to run a model's
# program while one is set or while none can be said to be, and a test that
# grades says `SKIP` naming them.
function keys_held() -> [str]?
    return ok(sort(environment_names(given: [])?).filter(is_key_name))

# The names holding a value in the environment a child of this process is
# given, this process's own with `given` laid over it (`shell.run_given`), as
# `AWK` lists them.
function environment_names(given: [shell.Variable]) -> [str]?
    ran = shell.run_given(scratch: LISTING_SCRATCH, program: AWK, words: [AWK, NAMES_ONLY], given: given)

    match ran
        .err e =>
            return fail(
                code: "environment_unlisted",
                msg: "this process's environment could not be listed, so no seal's key can be said to be absent from it: " + e.msg
            )
        .ok r =>
            if r.code != 0
                return fail(
                    code: "environment_unlisted",
                    msg: "this process's environment could not be listed, so no seal's key can be said to be absent from it: " + AWK + " exited " + r.code.to_str() + ": " + strings.trimmed(r.err)
                )
            return ok(strings.lines(r.out))

# The variables `held` names, as a sentence's subject: `A is set`, `A and B
# are set`.
function key_said(held: [str]) -> str
    if held.len() == 1
        return held[0] + " is set"
    return held.slice(from: 0, to: held.len() - 1).join(", ") + " and " + held[held.len() - 1] + " are set"

# How a program is run inside the sandbox: the program spawned and the words
# before the program's own, which the caller appends its arguments to.
record Sandbox
    program: str
    words: [str]
    tool: str

# The profile `sandbox-exec` is given: the sample's scratch and the binary
# quoted as SBPL asks (a double-quoted string; neither path holds a quote,
# since both are the instrument's own under `build/`).
function profile(scratch: str, binary: str) -> str
    return "(version 1)\n(deny default)\n(allow process-exec (literal \"" + binary + "\"))\n(allow process-info*)\n(allow signal (target self))\n(allow sysctl-read)\n(allow file-read* file-read-metadata file-map-executable)\n(deny file-read* (subpath \"/Users\") (subpath \"/Volumes\") (subpath \"/private/tmp\") (subpath \"/tmp\") (subpath \"/private/var/tmp\") (subpath \"/private/var/folders\") (subpath \"/Library/Keychains\") (subpath \"/Library/Preferences\"))\n(allow file-read* file-write* (subpath \"" + scratch + "\"))\n(allow file-read* (literal \"" + binary + "\"))\n(allow file-write* file-ioctl (subpath \"/dev\"))\n(deny network*)\n"

# The limits a program runs under, one `ulimit` a call joined by `&&`, so a
# limit the shell refuses stops the program rather than letting it run
# without one: dash, Debian's and Ubuntu's `/bin/sh`, refuses two limits in
# one call, and with a `;` the program ran unbounded (defect 2167). macOS sets
# no address-space limit, which its kernel does not keep.
function limited(limits: [str]) -> str
    parts: [str] @= []

    for one in limits
        parts @ parts.push("ulimit " + one)

    return parts.join(" && ") + " && exec "

# macOS: the file limit, then `sandbox-exec` with the profile in an empty
# environment.
function darwin_words(profile_path: str, binary: str) -> [str]
    return [
        "/bin/sh"
        "-c"
        limited(["-f " + FILE_BLOCKS.to_str()]) + "/usr/bin/env -i PATH=/usr/bin:/bin " + DARWIN_TOOL + " -f \"$0\" \"$@\""
        profile_path
        binary
    ]

# Linux: the system read-only, the scratch the one place written, every
# namespace new, no environment, then the file and address-space limits.
function linux_words(scratch: str, binary: str) -> [str]
    return [
        LINUX_TOOL
        "--ro-bind"
        "/usr"
        "/usr"
        "--ro-bind-try"
        "/lib"
        "/lib"
        "--ro-bind-try"
        "/lib64"
        "/lib64"
        "--ro-bind-try"
        "/bin"
        "/bin"
        "--ro-bind-try"
        "/etc"
        "/etc"
        "--bind"
        scratch
        scratch
        "--dev"
        "/dev"
        "--proc"
        "/proc"
        "--unshare-all"
        "--die-with-parent"
        "--clearenv"
        "--setenv"
        "PATH"
        "/usr/bin:/bin"
        "--chdir"
        scratch
        "/bin/sh"
        "-c"
        limited(["-f " + FILE_BLOCKS.to_str(), "-v " + ADDRESS_KIB.to_str()]) + "\"$0\" \"$@\""
        binary
    ]

# The sandbox for `binary` run with its working files in `scratch`, which must
# be an absolute path (the profile names it, and the program's own `{dir}`
# arguments do too); the profile is written into the scratch.
function prepared(scratch: str, binary: str) -> Sandbox?
    if !core_strings.has_prefix(s: scratch, prefix: "/") || !core_strings.has_prefix(s: binary, prefix: "/")
        return fail(
            code: "relative_path",
            msg: "a sandbox names its scratch and its binary by absolute paths; given " + scratch + " and " + binary
        )

    tool = tool_here()

    if tool == ""
        return fail(
            code: "no_sandbox",
            msg: "neither " + DARWIN_TOOL + " nor " + LINUX_TOOL + " is on this machine, and a model's program is run inside one or not at all"
        )
    held = keys_held()?

    if held.len() > 0
        return fail(
            code: "key_in_environment",
            msg: key_said(held) + " in this process's environment, and no process holding a seal's key, a `" + KEY_OPENING + "*" + KEY_CLOSING + "`, runs a model's program: a program inside the sandbox reads another process's environment through `sysctl(KERN_PROCARGS2)` (panel 226, the ffi-pragmatist). Open the archive first, `unseal --sealed <file> --into <dir>`, then grade the folder in a shell where no such key is set"
        )

    if tool == DARWIN_TOOL
        path = scratch + "/sandbox.sb"
        write_file(path: path, text: profile(scratch: scratch, binary: binary))?
        return ok(
            Sandbox(program: "/bin/sh", words: darwin_words(profile_path: path, binary: binary), tool: DARWIN_TOOL)
        )
    return ok(Sandbox(program: LINUX_TOOL, words: linux_words(scratch: scratch, binary: binary), tool: LINUX_TOOL))

# The sandbox tool this machine holds, `DARWIN_TOOL` before `LINUX_TOOL`, or
# "" where it holds neither. The tool is asked before the environment, so a
# machine that has neither, Windows, is told that, whatever its listing says.
function tool_here() -> str
    if shell.exists(DARWIN_TOOL)
        return DARWIN_TOOL

    if shell.exists(LINUX_TOOL)
        return LINUX_TOOL
    return ""

# The words to spawn: the sandbox's, then the program's own arguments.
function words_with(sandbox: Sandbox, arguments: [str]) -> [str]
    out: [str] @= sandbox.words

    for a in arguments
        out @ out.push(a)

    return out

test "the profile denies by default, allows the scratch alone for writing, and denies the home and the network"
    text = profile(scratch: "/x/scratch", binary: "/x/scratch/main")
    assert core_strings.has_prefix(s: text, prefix: "(version 1)\n(deny default)\n")
    assert core_strings.contains(s: text, substr: "(allow file-read* file-write* (subpath \"/x/scratch\"))")
    assert core_strings.contains(s: text, substr: "(deny file-read* (subpath \"/Users\")")
    assert core_strings.contains(s: text, substr: "(deny network*)")
    assert core_strings.contains(s: text, substr: "(allow sysctl-read)")
    assert !core_strings.contains(s: text, substr: "allow default")

    match prepared(scratch: "relative", binary: "/x/main")
        .ok _  => assert false
        .err e => assert e.code == "relative_path"

test "a program run inside the sandbox writes in its scratch, is refused outside it and in the home, and reads neither"
    # Wherever either tool stands: `sandbox-exec`'s profile on macOS, and on
    # Linux `bwrap`, which mounts the scratch alone, so the folder beside it is
    # not there to be written or read (issue 2162).
    if unrunnable() != ""
        print("SKIP thesis_sandbox: " + unrunnable())
        return

    compiler = shell.some_compiler()

    if compiler.is_err()
        print("SKIP thesis_sandbox: no compiler to build the probe with")
        return

    scratch = shell.own_scratch()
    _ = shell.mkdir_all(scratch).is_err()
    absolute = shell.run(scratch: scratch, program: "pwd", words: ["pwd"]).must()
    root = strings.trimmed(text: absolute.out)
    inside = root + "/" + scratch + "/inside"
    outside = root + "/" + scratch + "/outside"
    _ = shell.mkdir_all(inside).is_err()
    _ = shell.mkdir_all(outside).is_err()
    write_file(path: outside + "/secret.txt", text: "top secret\n").must()
    write_file(
        path: scratch + "/probe.hero",
        text: "function main()\n    given = args()\n    print(\"in \" + write_file(path: given[0] + \"/inside.txt\", text: \"ok\\n\").is_err().to_str())\n    print(\"out \" + write_file(path: given[1] + \"/leak.txt\", text: \"leak\\n\").is_err().to_str())\n    print(\"read \" + read_file(path: given[2]).is_err().to_str())\n"
    ).must()
    built = shell.run(
        scratch: scratch,
        program: compiler.must(),
        words: [compiler.must(), "build", scratch + "/probe.hero", "-o", inside + "/probe"]
    ).must()
    assert built.code == 0
    sandbox = prepared(scratch: inside, binary: inside + "/probe").must()

    if shell.exists(DARWIN_TOOL)
        assert sandbox.tool == DARWIN_TOOL
    else
        assert sandbox.tool == LINUX_TOOL
    ran = shell.run_bounded(
        scratch: scratch,
        program: sandbox.program,
        words: words_with(sandbox: sandbox, arguments: [inside, outside, outside + "/secret.txt"]),
        seconds: 10,
        bytes: 65536,
        stdin_path: ""
    ).must()
    assert ran.code == 0
    assert core_strings.contains(s: ran.out, substr: "in false")
    assert core_strings.contains(s: ran.out, substr: "out true")
    assert core_strings.contains(s: ran.out, substr: "read true")
    assert shell.exists(inside + "/inside.txt")
    assert !shell.exists(outside + "/leak.txt")

test "a machine with neither sandbox tool cannot run a model's program, and says which two it looked for"
    # The environment's answer is given, not read, so the test asks the tools
    # alone on every machine, a shell holding a key included.
    none: [str] = []
    told = unrunnable_with(darwin: "/no/such/sandbox-exec", linux: "/no/such/bwrap", held: ok(none))
    assert core_strings.contains(s: told, substr: "neither /no/such/sandbox-exec nor /no/such/bwrap")

    # A tool that exists answers nothing, whichever of the two it is: the test
    # makes the file it names, since a path the machine is supposed to hold,
    # `/bin/sh` until defect 2166, is missing on the CI's Windows leg.
    scratch = shell.own_scratch()
    tool = scratch + "/tool"
    write_file(path: tool, text: "").must()
    assert unrunnable_with(darwin: tool, linux: "/no/such/bwrap", held: ok(none)) == ""
    assert unrunnable_with(darwin: "/no/such/sandbox-exec", linux: tool, held: ok(none)) == ""

    # And with a tool present, a key held or an environment unlisted is the
    # answer, while with neither tool the tools are.
    held = unrunnable_with(darwin: tool, linux: "/no/such/bwrap", held: ok(["HEROES_A_KEY", "HEROES_B_KEY"]))
    assert core_strings.has_prefix(
        s: held,
        prefix: "HEROES_A_KEY and HEROES_B_KEY are set, and no process holding a seal's key runs a program"
    )
    unlisted: [str]? = fail(code: "environment_unlisted", msg: "this process's environment could not be listed")
    assert unrunnable_with(darwin: tool, linux: "/no/such/bwrap", held: unlisted) == "this process's environment could not be listed"
    assert core_strings.contains(
        s: unrunnable_with(darwin: "/no/such/sandbox-exec", linux: "/no/such/bwrap", held: unlisted),
        substr: "neither "
    )

# DEFECT 2569, held as a test (2026-11-15): the grader refused five names it
# listed where panel 226's R10 and R11 and `docs/metrics/tasks.md` say every
# `HEROES_*_KEY`, so a suite sealed under a sixth name would have been graded
# beside its key. Every such name is a key's now, the tests' throwaway apart,
# and the names are listed from the environment itself: a child given a sixth
# name lists it, and the rule calls it a key's.
test "fixedbugs: every HEROES_*_KEY in the environment is a seal key's, the five once listed and a sixth alike (defect 2569)"
    for name in ["HEROES_TASKS_KEY", "HEROES_RESERVE_KEY", "HEROES_RUNS_KEY", "HEROES_PACKAGES_KEY", "HEROES_PACKAGES_RESERVE_KEY", "HEROES_SIXTH_SUITE_KEY", "HEROES__KEY", "HEROES_a-b.c_KEY"]
        assert is_key_name(name)

    for name in [thesis_seal.TEST_KEY, "HEROES_KEY", "HEROES_TASKS_KEYS", "HEROES_TASKS_KEY_OLD", "heroes_tasks_key", "XHEROES_TASKS_KEY", "ANTHROPIC_API_KEY", ""]
        assert !is_key_name(name)

    assert key_said(["HEROES_A_KEY"]) == "HEROES_A_KEY is set"
    assert key_said(["HEROES_A_KEY", "HEROES_B_KEY", "HEROES_C_KEY"]) == "HEROES_A_KEY, HEROES_B_KEY and HEROES_C_KEY are set"

    if !shell.exists(AWK)
        print("SKIP thesis_sandbox: " + AWK + " is not on this machine, so no environment is listed here")
        return

    # A variable set to nothing holds no key, and is not listed.
    given = [
        shell.Variable(name: "HEROES_SIXTH_SUITE_KEY", value: "not-a-key")
        shell.Variable(name: "HEROES_EMPTY_SUITE_KEY", value: "")
    ]
    names = environment_names(given: given).must()
    assert names.filter(is_key_name).any(sixth_named)
    assert !names.any(empty_named)
    assert names.any(path_named)

    # This process's own listing reads the same way, whatever the shell held.
    _ = keys_held().must()

function sixth_named(name: str) -> bool
    return name == "HEROES_SIXTH_SUITE_KEY"

function empty_named(name: str) -> bool
    return name == "HEROES_EMPTY_SUITE_KEY"

function path_named(name: str) -> bool
    return name == "PATH"

test "every limit is set by a `ulimit` of its own, joined so a refused one stops the program (defect 2167)"
    linux = linux_words(scratch: "/s", binary: "/s/answer")
    script = linux[linux.len() - 2]
    assert script == "ulimit -f " + FILE_BLOCKS.to_str() + " && ulimit -v " + ADDRESS_KIB.to_str() + " && exec \"$0\" \"$@\""
    assert linux[linux.len() - 1] == "/s/answer"
    darwin = darwin_words(profile_path: "/s/sandbox.sb", binary: "/s/answer")
    assert core_strings.has_prefix(
        s: darwin[2],
        prefix: "ulimit -f " + FILE_BLOCKS.to_str() + " && exec /usr/bin/env -i "
    )

    for words in [linux, darwin]
        for word in words
            assert !core_strings.contains(s: word, substr: "; exec")
