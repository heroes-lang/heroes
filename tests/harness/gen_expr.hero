# The expression half of the generator (panel 231, M-generated-programs, task
# 931): from *an expression of type T is needed* down to the leaves, every
# node's value known on every sample while it is built, so a program
# type-checks by construction and its answer is computed beside it.
# `gen_make` writes the statements and the program around these.
#
# **Values are tracked over samples.** At `main`'s top level a node has one
# value; inside a function body it has one per sample of its arguments,
# inside a loop body one per turn, inside a `match` arm the taken arm's.
# An operator whose operands would abort on any sample is REPAIRED to
# another, YARPGen's local fix, `^` last since it never aborts.
#
# **The policies** are YARPGen's (measurement 056 § 1.2): an operator
# context per region of a tree, a constants mix drawn per program, a buffer
# of earlier subexpressions reused at `main`'s top level, and the depth and
# the share of leaves drawn per program.

use gen_eval
use gen_rng
use gen_tree

record Scope
    ints: [str]
    fields: [str]
    bools: [str]
    bfields: [str]
    arrays: [str]
    lengths: [i64]
    strs: [str]
    fns: i64
    top: bool

record Gen
    r: gen_rng.Rng
    mix: gen_rng.Mix
    p: gen_tree.Program
    depth: i64
    leaf: i64
    reuse: [i64]
    has_record: bool
    has_variant: bool
    # The node the declared arm planted, the expression whose evaluation
    # stops the program, or -1 where none was planted (panel 231's R5: a
    # declared abort is held to its place as well as its message).
    site: i64

function context_ops(c: i64) -> [str]
    if c == 0
        return ["+", "-"]

    if c == 1
        return ["*", "/", "%"]

    if c == 2
        return ["&", "|", "^"]

    if c == 3
        return ["<<", ">>"]

    if c == 4
        return ["+", "-", "*"]
    return ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>"]

function safe(p: gen_tree.Program lent, at: i64, envs: [gen_eval.Env] lent) -> bool
    for env in envs
        if gen_eval.int_of(p, at: at, env: env).is_err()
            return false

    return true

# The node at `at`, safe on every sample: its operator changed until it is,
# and a literal where no operator saves it (a reused subtree or a call that
# aborts on a sample it was not built for).
function repaired(@g: Gen, at: i64, envs: [gen_eval.Env] lent) -> i64
    if safe(g.p, at: at, envs: envs)
        return at

    if g.p.nodes[at].op == "neg"
        g.p.nodes[at].op @ "~"
        return at
    order = context_ops(5)
    start = gen_rng.below(@g.r, n: order.len())
    k: i64 @= 0

    while k < order.len()
        g.p.nodes[at].op @ order[(start + k) % order.len()]

        if safe(g.p, at: at, envs: envs)
            return at
        k @ k + 1

    g.p.nodes[at] @ gen_tree.leaf(op: "lit", value: 0, name: "")
    return at

function literal(@g: Gen) -> i64
    v = gen_rng.constant_of(@g.r, m: g.mix)

    if v == gen_eval.MIN
        left = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: gen_eval.MAX * -1, name: ""))
        right = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: 1, name: ""))
        return gen_tree.binary(@g.p, op: "-", left: left, right: right)
    return gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: v, name: ""))

function named(@g: Gen, op: str, name: str) -> i64
    return gen_tree.added(@g.p, gen_tree.leaf(op: op, value: 0, name: name))

function int_expr(@g: Gen, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64, context: i64) -> i64
    if depth <= 0 || gen_rng.chance(@g.r, percent: g.leaf)
        return int_leaf(@g, s: s, envs: envs, depth: depth)
    c: i64 @= context

    if gen_rng.chance(@g.r, percent: 30)
        c @ gen_rng.below(@g.r, n: 6)

    if gen_rng.chance(@g.r, percent: 12)
        kid = int_expr(@g, s: s, envs: envs, depth: depth - 1, context: c)
        op: str @= "~"

        if gen_rng.chance(@g.r, percent: 60)
            op @ "neg"
        return repaired(@g, at: gen_tree.unary(@g.p, op: op, kid: kid), envs: envs)
    left = int_expr(@g, s: s, envs: envs, depth: depth - 1, context: c)
    ops = context_ops(c)
    op = ops[gen_rng.below(@g.r, n: ops.len())]
    right = operand(@g, op: op, s: s, envs: envs, depth: depth - 1, context: c)
    at = gen_tree.binary(@g.p, op: op, left: left, right: right)
    return repaired(@g, at: at, envs: envs)

# The right operand of `op`, drawn from that operator's own domain where it
# has one (panel 231's R3, the critic's finding 12): a shift's count over
# the whole of 0 to 63, never only where the constants mix happens to land,
# which left a `>>` miscompiled for counts of 32 and up unseen in 300 of 300
# programs and seen in 61 of 300 once counts were drawn so; a divisor near 0
# and -1, where `/` and `%` have their edges. Elsewhere, an expression like
# any other.
function operand(@g: Gen, op: str, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64, context: i64) -> i64
    if (op == "<<" || op == ">>") && gen_rng.chance(@g.r, percent: 70)
        return gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: gen_rng.below(@g.r, n: 64), name: ""))

    if (op == "/" || op == "%") && gen_rng.chance(@g.r, percent: 30)
        divisors = [-2, -1, 1, 2, 3, -3]
        return gen_tree.added(
            @g.p,
            gen_tree.leaf(op: "lit", value: divisors[gen_rng.below(@g.r, n: divisors.len())], name: "")
        )
    return int_expr(@g, s: s, envs: envs, depth: depth, context: context)

function int_leaf(@g: Gen, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64) -> i64
    k = gen_rng.below(@g.r, n: 100)

    if k < 30 && s.ints.len() > 0
        return named(@g, op: "name", name: s.ints[gen_rng.below(@g.r, n: s.ints.len())])

    if k < 40 && s.fields.len() > 0
        return named(@g, op: "field", name: s.fields[gen_rng.below(@g.r, n: s.fields.len())])

    if k < 50 && s.arrays.len() > 0
        j = gen_rng.below(@g.r, n: s.arrays.len())
        index = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: gen_rng.below(@g.r, n: s.lengths[j]), name: ""))
        return gen_tree.added(@g.p, gen_tree.Node(op: "index", value: 0, name: s.arrays[j], kids: [index]))

    if k < 60 && s.fns > 0 && depth > 0
        return call(@g, s: s, envs: envs, depth: depth)

    if k < 70 && s.top && g.reuse.len() > 0
        return g.reuse[gen_rng.below(@g.r, n: g.reuse.len())]

    if k < 78 && depth > 0
        return gen_tree.unary(@g.p, op: "strlen", kid: str_expr(@g, s: s, envs: envs, depth: depth - 1))
    return literal(@g)

# The texts a string literal is drawn from: none holds a brace, a quote or a
# backslash, so each is a literal without an `f` and needs no escape, and
# three hold a character of more than one byte, where a slice can split one.
constant POOL: [str]
    ["", "a", "hero", "é", "naïve", "x y", "0", "-", "über", "zz"]

# An expression of type `str`, its value known on every sample. A slice is
# made only where there is one sample, so its bounds are chosen from the
# value itself, at the boundaries of its characters.
function str_expr(@g: Gen, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64) -> i64
    if depth <= 0 || gen_rng.chance(@g.r, percent: g.leaf)
        if s.strs.len() > 0 && gen_rng.chance(@g.r, percent: 50)
            return named(@g, op: "sname", name: s.strs[gen_rng.below(@g.r, n: s.strs.len())])
        return gen_tree.added(@g.p, gen_tree.leaf(op: "slit", value: 0, name: POOL[gen_rng.below(@g.r, n: POOL.len())]))
    k = gen_rng.below(@g.r, n: 3)

    if k == 0
        left = str_expr(@g, s: s, envs: envs, depth: depth - 1)
        right = str_expr(@g, s: s, envs: envs, depth: depth - 1)
        return gen_tree.binary(@g.p, op: "concat", left: left, right: right)

    if k == 1 || envs.len() != 1
        return gen_tree.unary(
            @g.p,
            op: "tostr",
            kid: int_expr(@g, s: s, envs: envs, depth: depth - 1, context: gen_rng.below(@g.r, n: 6))
        )
    base = str_expr(@g, s: s, envs: envs, depth: depth - 1)
    value = gen_eval.str_of(g.p, at: base, env: envs[0]).must()
    cuts = boundaries(value)
    a = cuts[gen_rng.below(@g.r, n: cuts.len())]
    b = cuts[gen_rng.below(@g.r, n: cuts.len())]
    from: i64 @= a
    to: i64 @= b

    if a > b
        from @ b
        to @ a
    return sliced(@g, base: base, from: from, to: to)

function sliced(@g: Gen, base: i64, from: i64, to: i64) -> i64
    low = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: from, name: ""))
    high = gen_tree.added(@g.p, gen_tree.leaf(op: "lit", value: to, name: ""))
    return gen_tree.added(@g.p, gen_tree.Node(op: "slice", value: 0, name: "", kids: [base, low, high]))

# The byte offsets of `text` a slice may stand at: every one that begins a
# character, and its length.
function boundaries(text: str) -> [i64]
    out: [i64] @= []
    i: i64 @= 0

    while i <= text.len()
        if !gen_eval.splits(text, at: i)
            out @ out.push(i)
        i @ i + 1

    return out

# The declared arm's string abort, a slice of a string in scope past its
# end, or, where one holds a character of more than one byte, through it;
# -1 where no string is in scope.
function str_site(@g: Gen, s: Scope lent, env: gen_eval.Env lent) -> i64
    if s.strs.len() == 0
        return -1
    name = s.strs[gen_rng.below(@g.r, n: s.strs.len())]
    value = env.strs[name].must()
    base = named(@g, op: "sname", name: name)
    i: i64 @= 0

    while i < value.len()
        if gen_eval.splits(value, at: i) && gen_rng.chance(@g.r, percent: 60)
            return sliced(@g, base: base, from: 0, to: i)
        i @ i + 1

    return sliced(@g, base: base, from: 0, to: value.len() + 1 + gen_rng.below(@g.r, n: 3))

function call(@g: Gen, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64) -> i64
    f = g.p.fns[gen_rng.below(@g.r, n: s.fns)]
    kids: [i64] @= []

    while kids.len() < f.params.len()
        kids @ kids.push(int_expr(@g, s: s, envs: envs, depth: depth - 1, context: gen_rng.below(@g.r, n: 6)))

    at = gen_tree.added(@g.p, gen_tree.Node(op: "call", value: 0, name: f.name, kids: kids))

    if safe(g.p, at: at, envs: envs)
        return at
    return literal(@g)

function bool_expr(@g: Gen, s: Scope lent, envs: [gen_eval.Env] lent, depth: i64) -> i64
    if depth <= 0 || gen_rng.chance(@g.r, percent: g.leaf)
        k = gen_rng.below(@g.r, n: 100)

        if k < 10
            if gen_rng.chance(@g.r, percent: 50)
                return named(@g, op: "true", name: "")
            return named(@g, op: "false", name: "")

        if k < 30 && s.bools.len() > 0
            return named(@g, op: "bname", name: s.bools[gen_rng.below(@g.r, n: s.bools.len())])

        if k < 40 && s.bfields.len() > 0
            return named(@g, op: "bfield", name: s.bfields[gen_rng.below(@g.r, n: s.bfields.len())])
        left = int_expr(@g, s: s, envs: envs, depth: depth - 1, context: gen_rng.below(@g.r, n: 6))
        right = int_expr(@g, s: s, envs: envs, depth: depth - 1, context: gen_rng.below(@g.r, n: 6))
        ops = ["<", "<=", ">", ">=", "==", "!="]
        return gen_tree.binary(@g.p, op: ops[gen_rng.below(@g.r, n: 6)], left: left, right: right)

    if gen_rng.chance(@g.r, percent: 20)
        return gen_tree.unary(@g.p, op: "not", kid: bool_expr(@g, s: s, envs: envs, depth: depth - 1))
    left = bool_expr(@g, s: s, envs: envs, depth: depth - 1)
    right = bool_expr(@g, s: s, envs: envs, depth: depth - 1)

    if gen_rng.chance(@g.r, percent: 50)
        return gen_tree.binary(@g.p, op: "&&", left: left, right: right)
    return gen_tree.binary(@g.p, op: "||", left: left, right: right)

# `at`, made to read `name` where it does not: `name ^ at` never aborts.
function reading(@g: Gen, at: i64, name: str) -> i64
    if gen_tree.reads(g.p, at: at, name: name)
        return at
    return gen_tree.binary(@g.p, op: "^", left: named(@g, op: "name", name: name), right: at)
