# `prepare` AND `finish`: THE OUTWARD ACTS BEFORE AND AFTER A TRANSCRIPTION.
#
# Panel 212's R6, ratified 2026-10-11, names what stands on GitHub before the
# first issue is imported, each act the author's to allow; nothing performed
# items 3 and 4 until this module. `prepared` does, in this order:
#
# 1. **the milestones** (R6 item 3): one per row of `docs/ROADMAP.md` § The
#    chain, in the rows' order, `POST /repos/heroes-lang/heroes/milestones`
#    for each that GitHub lacks, titled `M-<name>`, `closed` where its row is
#    closed and `open` otherwise (`issue_plan.chain_of` reads which, from the
#    chain itself), described by one plain sentence naming the row's number
#    and, where the tree holds one, the milestone's page; **a milestone GitHub
#    holds already is never edited**, and one whose state differs from its row
#    is reported (R10's rule, read for milestones);
# 2. **the label `kind:learn` deleted** where it exists (R6 item 3, the task
#    filed 2026-10-05 as https://github.com/heroes-lang/heroes/issues/1689),
#    its name written percent-encoded in the path;
# 3. **the interaction limit set** (R6 item 4): `PUT
#    /repos/heroes-lang/heroes/interaction-limits` with `collaborators_only` and
#    the shortest expiry GitHub's REST documentation lists for the endpoint,
#    `one_day` (*Can be one of: one_day, three_days, one_week, one_month,
#    six_months*, the default `one_day`, read 2026-10-12 at
#    https://docs.github.com/en/rest/interactions/repos), unless a
#    `collaborators_only` limit is in force already, which is left as it is.
#
# A rerun creates nothing that exists: every act reads first what GitHub holds.
# `finished` lifts the limit, `DELETE` of the same path, and says so where none
# is in force; GitHub answers 409 to either write where the limit is the
# owner's rather than the repository's (the same page), which only the owner
# changes, so that is a refusal told, never retried. Every request goes through
# the session `push` uses (`issue_pace.exchange`): serial, a second between two
# writes, the rate limit waited out.

use issue_github
use issue_json
use issue_match
use issue_pace
use issue_plan
use issue_scripts
use issue_state
use issue_wire
use json_fields
use json_read
use shell
use strings

constant LEARN: str
    "kind:learn"

constant LIMIT: str
    "collaborators_only"

constant EXPIRY: str
    "one_day"

constant PAGES: str
    "docs/roadmap/milestones/"

# The one sentence a row's milestone is described by; `pages` holds the paths
# of the milestone pages the tree has.
function described(row: issue_match.Row, pages: {str: bool}) -> str
    page = PAGES + row.name + ".md"

    if pages[page].is_err()
        return "Row " + row.number.to_str() + " of the chain in docs/ROADMAP.md."
    return "Row " + row.number.to_str() + " of the chain in docs/ROADMAP.md, whose page is " + page + "."

# The request that creates `row`'s milestone.
function milestone_request(row: issue_match.Row, pages: {str: bool}) -> issue_wire.Request
    state = if row.closed
        "closed"
    else
        "open"
    body = "{\"title\":" + issue_json.quoted(row.name) + ",\"state\":\"" + state + "\",\"description\":" + issue_json.quoted(described(row: row, pages: pages)) + "}"
    return issue_wire.Request(method: "POST", path: issue_github.REPO + "/milestones", accept: "", body: body)

# `text` written as one segment of a URL's path: every byte but the unreserved
# ones of RFC 3986 percent-encoded, so `kind:learn` is `kind%3Alearn`.
function segment(text: str) -> str
    out: [str] @= []
    at: i64 @= 0

    while at < text.len()
        b = text[at]

        if b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '-' || b == '.' || b == '_' || b == '~'
            out @ out.push(text.slice(from: at, to: at + 1))
        else
            out @ out.push("%" + hex_upper(to_i64(b / 16).must()) + hex_upper(to_i64(b % 16).must()))
        at @ at + 1

    return out.join("")

function hex_upper(value: i64) -> str
    return "0123456789ABCDEF".slice(from: value, to: value + 1)

# The acts of R6 items 3 and 4; the exit code (R11).
function prepared(@s: issue_pace.Session, rows: [issue_match.Row], pages: {str: bool}) -> i64
    milestones = issue_github.milestones(@s)
    labels = issue_github.labels(@s)
    limit = issue_github.limit(@s)

    if milestones.is_err() || labels.is_err() || limit.is_err()
        issue_pace.warn(
            @s,
            text: "GitHub could not be read: " + issue_github.failure(milestones) + issue_github.failure(labels) + issue_github.failure(limit)
        )
        return 2
    held: {str: bool} @= {}

    for one in milestones.must()
        held[one.title] @ one.open

    by_number: {i64: issue_match.Row} @= {}

    for row in rows
        by_number[row.number] @ row

    created: i64 @= 0
    differing: i64 @= 0

    for number in keys(by_number).sort()
        row = by_number[number].must()

        match held[row.name]
            .ok open =>
                if open == row.closed
                    differing @ differing + 1
                    issue_pace.say(
                        @s,
                        text: "differs " + row.name + ": " + state_word(open) + " on GitHub, its row " + row.number.to_str() + " `" + row.mark + "`; left as it is"
                    )
            .err _ =>
                reply = issue_pace.exchange(@s, request: milestone_request(row: row, pages: pages))

                if reply.is_err() || reply.must().status != 201
                    issue_pace.warn(@s, text: "the milestone " + row.name + " was not created: " + told(reply))
                    return 2
                n = json_fields.whole_at(
                    of: json_read.read_json(reply.must().body).default(.null_value),
                    name: "number"
                )
                issue_pace.say(
                    @s,
                    text: "created " + row.name + ", milestone " + n.default(0).to_str() + ", " + state_word(!row.closed)
                )
                held[row.name] @ !row.closed
                created @ created + 1

    learned: bool @= false

    for label in labels.must()
        if label == LEARN
            learned @ true

    if learned
        path = issue_github.REPO + "/labels/" + segment(LEARN)
        reply = issue_pace.exchange(@s, request: issue_wire.Request(method: "DELETE", path: path, accept: "", body: ""))

        if reply.is_err() || reply.must().status != 204 && reply.must().status != 404
            issue_pace.warn(@s, text: "the label " + LEARN + " was not deleted: " + told(reply))
            return 2

        if reply.must().status == 404
            issue_pace.say(@s, text: "the label " + LEARN + " was gone between the list and its deletion")
        else
            issue_pace.say(@s, text: "deleted the label " + LEARN)
    else
        issue_pace.say(@s, text: "the label " + LEARN + " is not on GitHub; nothing to delete")

    if limit.must().limit == LIMIT
        issue_pace.say(
            @s,
            text: "the interaction limit " + LIMIT + " is in force already, until " + limit.must().expires + "; left as it is"
        )
    else
        body = "{\"limit\":\"" + LIMIT + "\",\"expiry\":\"" + EXPIRY + "\"}"
        path = issue_github.REPO + "/interaction-limits"
        reply = issue_pace.exchange(@s, request: issue_wire.Request(method: "PUT", path: path, accept: "", body: body))

        if reply.is_err() || reply.must().status != 200
            issue_pace.warn(@s, text: "the interaction limit was not set: " + told(reply) + owners(reply))
            return 2
        until = json_fields.text_at(of: json_read.read_json(reply.must().body).default(.null_value), name: "expires_at").default(
            ""
        )
        issue_pace.say(@s, text: "set the interaction limit " + LIMIT + " for " + EXPIRY + ", until " + until)
    issue_pace.say(
        @s,
        text: "prepare: " + created.to_str() + " milestones created, " + (rows.len() - created).to_str() + " there already, " + differing.to_str() + " of them open or closed otherwise than their row"
    )
    return 0

# `prepare` or `finish` as the program runs it: the chain read from the tree,
# the milestone pages the tree holds, and a word where a run's imports are still
# unsettled, since lifting the limit then lets a stranger's issue in.
function run_word(@s: issue_pace.Session, scratch: str, word: str) -> i64
    if word == "finish"
        state = issue_state.read_state(issue_state.PATH)

        if !state.is_err() && state.must().flights.len() > 0
            issue_pace.warn(
                @s,
                text: issue_state.PATH + " still holds " + state.must().flights.len().to_str() + " imports a run did not settle; the limit is lifted all the same"
            )
        return finished(@s)
    roadmap = read_file("docs/ROADMAP.md")
    files = shell.project_files(scratch)

    if roadmap.is_err() || files.is_err()
        issue_pace.warn(@s, text: issue_github.failure(roadmap) + issue_github.failure(files))
        return 2
    pages: {str: bool} @= {}

    for path in files.must()
        if strings.starts_with(text: path, prefix: PAGES) && strings.ends_with(text: path, suffix: ".md")
            pages[path] @ true

    chain = issue_plan.chain_of(roadmap.must())

    if chain.is_err()
        issue_pace.warn(@s, text: issue_github.failure(chain))
        return 2
    return prepared(@s, rows: chain.must(), pages: pages)

# The interaction limit lifted; the exit code.
function finished(@s: issue_pace.Session) -> i64
    limit = issue_github.limit(@s)

    if limit.is_err()
        issue_pace.warn(@s, text: "GitHub could not be read: " + issue_github.failure(limit))
        return 2

    if limit.must().limit == ""
        issue_pace.say(@s, text: "no interaction limit is in force; nothing to lift")
        return 0
    reply = issue_pace.exchange(
        @s,
        request: issue_wire.Request(method: "DELETE", path: issue_github.REPO + "/interaction-limits", accept: "", body: "")
    )

    if reply.is_err() || reply.must().status != 204
        issue_pace.warn(@s, text: "the interaction limit was not lifted: " + told(reply) + owners(reply))
        return 2
    issue_pace.say(
        @s,
        text: "lifted the interaction limit " + limit.must().limit + ", which ran until " + limit.must().expires
    )
    return 0

function state_word(open: bool) -> str
    if open
        return "open"
    return "closed"

# What a write's answer said, or why there is none.
function told(reply: issue_wire.Reply?) -> str
    return match reply
        .ok r  => "GitHub answered " + issue_github.said(r)
        .err e => e.msg

# The reason a 409 gives, where it is one.
function owners(reply: issue_wire.Reply?) -> str
    if !reply.is_err() && reply.must().status == 409
        return "; a 409 here means the limit is the owner's, the organisation's or the user's, which only the owner changes"
    return ""

function held_milestones(open: [str], closed: [str]) -> issue_wire.Reply
    rows: [str] @= []

    for name in open
        rows @ rows.push("{\"title\":\"" + name + "\",\"number\":" + (rows.len() + 1).to_str() + ",\"state\":\"open\"}")

    for name in closed
        rows @ rows.push(
            "{\"title\":\"" + name + "\",\"number\":" + (rows.len() + 1).to_str() + ",\"state\":\"closed\"}"
        )

    return issue_scripts.answer(status: 200, body: "[" + rows.join(",") + "]")

function rows_of() -> [issue_match.Row]
    return [
        issue_match.Row(number: 2, name: "M-journey-book", mark: "scheduled", closed: false)
        issue_match.Row(number: 1, name: "M-day-zero", mark: "done", closed: true)
        issue_match.Row(number: 3, name: "M-issue-files", mark: "open", closed: false)
    ]

constant SET: str
    "{\"limit\":\"collaborators_only\",\"origin\":\"repository\",\"expires_at\":\"2026-10-13T10:00:00Z\"}"

test "prepare creates each milestone GitHub lacks in the rows' order, deletes kind:learn, and sets the shortest limit"
    pages: {str: bool} @= {}
    pages["docs/roadmap/milestones/M-day-zero.md"] @ true
    replies = [
        held_milestones(open: ["M-issue-files"], closed: [])
        issue_scripts.labels(["kind:learn", "kind:task"])
        issue_scripts.unlimited()
        issue_scripts.answer(status: 201, body: "{\"number\":2,\"title\":\"M-day-zero\",\"state\":\"closed\"}")
        issue_scripts.answer(status: 201, body: "{\"number\":3,\"title\":\"M-journey-book\",\"state\":\"open\"}")
        issue_scripts.answer(status: 204, body: "")
        issue_scripts.answer(status: 200, body: SET)
    ]
    s: issue_pace.Session @= issue_pace.scripted(replies)
    assert prepared(@s, rows: rows_of(), pages: pages) == 0
    asked = s.world.requests
    assert asked.len() == 7
    assert asked[3].method == "POST"
    assert asked[3].path == "/repos/heroes-lang/heroes/milestones"
    assert asked[3].body == "{\"title\":\"M-day-zero\",\"state\":\"closed\",\"description\":\"Row 1 of the chain in docs/ROADMAP.md, whose page is docs/roadmap/milestones/M-day-zero.md.\"}"
    assert asked[4].body == "{\"title\":\"M-journey-book\",\"state\":\"open\",\"description\":\"Row 2 of the chain in docs/ROADMAP.md.\"}"
    assert asked[5].method == "DELETE"
    assert asked[5].path == "/repos/heroes-lang/heroes/labels/kind%3Alearn"
    assert asked[5].body == ""
    assert asked[6].method == "PUT"
    assert asked[6].path == "/repos/heroes-lang/heroes/interaction-limits"
    assert asked[6].body == "{\"limit\":\"collaborators_only\",\"expiry\":\"one_day\"}"
    assert s.world.waits == [1, 1, 1]
    assert s.out == ["created M-day-zero, milestone 2, closed", "created M-journey-book, milestone 3, open", "deleted the label kind:learn", "set the interaction limit collaborators_only for one_day, until 2026-10-13T10:00:00Z", "prepare: 2 milestones created, 1 there already, 0 of them open or closed otherwise than their row"]

test "a rerun of prepare writes nothing that exists, and a milestone whose state differs from its row is told, never edited"
    pages: {str: bool} = {}
    replies = [
        held_milestones(open: ["M-day-zero", "M-journey-book"], closed: ["M-issue-files"])
        issue_scripts.labels(["kind:task"])
        issue_scripts.limited()
    ]
    s: issue_pace.Session @= issue_pace.scripted(replies)
    assert prepared(@s, rows: rows_of(), pages: pages) == 0
    assert s.world.requests.len() == 3
    assert s.out[0] == "differs M-day-zero: open on GitHub, its row 1 `done`; left as it is"
    assert s.out[1] == "differs M-issue-files: closed on GitHub, its row 3 `open`; left as it is"
    assert s.out[2] == "the label kind:learn is not on GitHub; nothing to delete"
    assert s.out[3] == "the interaction limit collaborators_only is in force already, until 2026-10-13T10:00:00Z; left as it is"

test "a refused write stops prepare, and a limit that is the owner's is told by its 409"
    pages: {str: bool} = {}
    replies = [
        held_milestones(open: [], closed: [])
        issue_scripts.labels([])
        issue_scripts.unlimited()
        issue_scripts.answer(status: 422, body: "{\"message\":\"Validation Failed\"}")
    ]
    s: issue_pace.Session @= issue_pace.scripted(replies)
    assert prepared(@s, rows: rows_of(), pages: pages) == 2
    assert s.err == ["the milestone M-day-zero was not created: GitHub answered 422: Validation Failed"]
    assert s.world.requests.len() == 4
    owned = [
        held_milestones(open: ["M-day-zero", "M-journey-book", "M-issue-files"], closed: [])
        issue_scripts.labels([])
        issue_scripts.unlimited()
        issue_scripts.answer(status: 409, body: "{\"message\":\"Conflict\"}")
    ]
    t: issue_pace.Session @= issue_pace.scripted(owned)
    assert prepared(@t, rows: rows_of(), pages: pages) == 2
    assert strings.contains(text: t.err[0], needle: "a 409 here means the limit is the owner's")

test "finish lifts the limit, says so where none is in force, and tells the owner's limit"
    s: issue_pace.Session @= issue_pace.scripted([issue_scripts.limited(), issue_scripts.answer(status: 204, body: "")])
    assert finished(@s) == 0
    assert s.world.requests[1].method == "DELETE"
    assert s.world.requests[1].path == "/repos/heroes-lang/heroes/interaction-limits"
    assert s.out == ["lifted the interaction limit collaborators_only, which ran until 2026-10-13T10:00:00Z"]
    t: issue_pace.Session @= issue_pace.scripted([issue_scripts.unlimited()])
    assert finished(@t) == 0
    assert t.out == ["no interaction limit is in force; nothing to lift"]
    assert t.world.requests.len() == 1
    u: issue_pace.Session @= issue_pace.scripted(
        [issue_scripts.limited(), issue_scripts.answer(status: 409, body: "{\"message\":\"Conflict\"}")]
    )
    assert finished(@u) == 2
    assert strings.contains(
        text: u.err[0],
        needle: "GitHub answered 409: Conflict; a 409 here means the limit is the owner's"
    )

test "a label's name is one segment of the path, percent-encoded"
    assert segment("kind:learn") == "kind%3Alearn"
    assert segment("a b/é~") == "a%20b%2F%C3%A9~"
