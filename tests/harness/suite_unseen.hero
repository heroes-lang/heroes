# The repository's documents hold no character their reader cannot see
# (defect 356, panel 192's R12).
#
# WHY. A model writing a file through a tool wrote a backslash escape,
# `\u200b`, and the tool decoded it: the committed bytes held a raw ZERO
# WIDTH SPACE, three times in one sitting, each found only by a scan somebody
# thought to run (panel 192's historian and critic). Since that sitting the
# compiler refuses such characters in a program's strings and comments
# (`selfhost/raw_refusal.hero`); nothing read the documents, the issues, the
# specification or the contract, where a reader is a person or a model too.
#
# WHAT IS REFUSED, each a fact about the code point:
# - a control character but the tab and the line feed: C0, DEL and C1, which
#   a terminal acts on and no screen shows;
# - the twelve bidirectional controls, U+2028 and U+2029, which reorder or
#   break the line a reader sees, Trojan Source's shape;
# - the zero-width space and its kin, nothing on a screen and nothing in any
#   word: U+200B, the word joiner U+2060, the invisible operators U+2061 to
#   U+2064, the byte order mark U+FEFF, the soft hyphen U+00AD, U+180E, and
#   the Hangul fillers U+115F, U+1160, U+3164 and U+FFA0.
#
# WHAT IS NOT: the joiners U+200C and U+200D, the variation selectors and the
# tag characters, which real text spells with (an emoji sequence, Persian, a
# flag: the sitting's reports quote each), and the spaces, which a screen
# shows as space.
#
# WHERE: every file `git` names as the project's (`shell.project_files`, the
# tracked and the untracked not ignored, so a file is read before it is
# committed) that decodes as UTF-8, but the trees whose bytes are a case's on
# purpose: `tests/golden/`, where a program the compiler must refuse holds
# the raw character, and `tests/emission/` and `seed/`, C the compiler wrote.
# A file that is not UTF-8 is a picture or a font, not a document. **And a
# tree a package fetch placed**, any folder named `heroes.packages` (panel
# 235's R7, `placed_trees.hero`): its files are the package author's, held
# to their fingerprint and never edited here, so a character in one is read
# where the package's source is written, the index its programs read, which
# this walk reads. **And an upstream's resources a generator keeps byte for
# byte**, `generators/unicode_encodings/whatwg/`: the WHATWG Encoding
# Standard's indexes, whose third column is the character a byte maps to
# written as itself, C1 controls, soft hyphens, marks and fillers among them,
# kept unchanged because the standard serves only its latest version. The
# generator holds every file of the folder to the SHA-256 of its bytes as
# fetched before it reads one (`layout.FETCHED_SHA256`), as a placed tree is
# held to its fingerprint; its tables, which this walk reads, write each
# character as a number.
#
# A record is never rewritten (`.claude/rules/records.md`), so a character
# already in one stays, its correction underneath: `known` lists each by its
# place, and a place that no longer holds its character is red too, so the
# list cannot outlive what it excuses.

use floors
use placed_trees
use report
use shell
use strings

# The trees whose files hold such characters on purpose.
constant EXEMPT: [str]
    [
        "tests/golden/"
        "tests/emission/"
        "seed/"
        # An upstream's resources kept byte for byte, the Encoding Standard's
        # indexes, which write each character as itself: held to a SHA-256 per
        # file by `generators/unicode_encodings/`, which refuses to run on a
        # file that moved, as a placed package tree is held to its fingerprint.
        "generators/unicode_encodings/whatwg/"
    ]

# How many documents the walk read, the count on the day it was written, so
# a walk that stops reaching the tree is red (`floors`). **5,072 on
# 2026-10-05**, lane b12-str192's tree, measured by this suite. **6,381 at
# batch 14's gate, 2026-10-07**, the merged round: the issues filed since,
# panel 197's sitting and the batch's new modules and cases. **5,252 on
# 2026-10-12**, lowered on purpose in the commit that removed `issues/`, its
# 2,030 files having left the tree for GitHub (the author's answers of that
# day); measured by this suite on that commit's tree. **5,246 the same
# evening**, the six modules of the transcription's words having left with
# the folder's last readers. **6,600 at M-panic-location's batch gate,
# 2026-10-26**, raised on purpose as `floors.check` asked, the tree having
# outgrown 5,246 by more than a quarter in the fourteen days since.
# **11,501 on 2026-11-23**, raised on purpose as `floors.check` told it at the
# gate of M-rebel-library's landing, the tree having outgrown 6,600 by more
# than a quarter (Rebel's packages, their ledgers and the applications'
# documents among the files read); measured by this suite on the merge of
# rebel-round at b9129d41b.
constant LEAST_DOCUMENTS: i64
    11501

# One character found, by its file, its line and its code.
record Found
    path: str
    line: i64
    code: i64

# The characters already in a record, each where it stands: the place is
# stable, since a record is only appended to.
function known() -> [Found]
    return [
        # Panel 188's critic quoted a message as a terminal received it, a
        # zero-width space before `stdio.h` and an override in a header's
        # name, each written raw.
        Found(path: "docs/panel/188-reports/completeness-critic.md", line: 577, code: 8203)
        Found(path: "docs/panel/188-reports/completeness-critic.md", line: 580, code: 8238)
        # Panel 192's historian wrote `\u200b` twice and the tool decoded it;
        # the report says so at its own line 492.
        Found(path: "docs/panel/192-reports/historian.md", line: 311, code: 8203)
        Found(path: "docs/panel/192-reports/historian.md", line: 331, code: 8203)
        # Panel 213's ffi-pragmatist kept two Linux transcripts as lldb-dap
        # and lldb wrote them, evidence of what a debugger received: a bell,
        # a carriage return and shift-out bytes in the adapter's console,
        # and the NUL of a C string an embedded summary printed.
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 161, code: 7)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 173, code: 13)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 179, code: 14)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 179, code: 6)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 179, code: 5)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 179, code: 4)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 180, code: 14)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 180, code: 6)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 180, code: 5)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-dap-linux-shapes-initcommands.txt", line: 180, code: 4)
        Found(path: "docs/panel/213-reports/ffi-pragmatist-work/lldb-linux-embedded-summary.txt", line: 1, code: 0)
    ]

# THE FILES WHOSE STRINGS CARRY ONE OF THE ZERO-WIDTH KIN AS DATA, each with
# the codes it carries, in decimal (M-rebel-library's landing, 2026-11-20).
# A string writes such a character only as itself: `\u{200b}` is refused,
# `escape_not_needed`, since one character has one spelling and this one
# needs no escape (`selfhost/code_escape.hero`), and a constant's body, where
# these tables stand, may call nothing that would build it from bytes,
# `constant_body`. Measured that day with the round's compiler on each of
# the thirteen this file's header names: written as itself in a string, each
# checks at exit 0, and its `\u{…}` is refused; a control character, U+061C,
# U+200E, U+202E and U+2028 the other way round. So here a document refuses
# what the language has no other way to write, and only the data's own
# files stand in that place: CLDR 49's Khmer and Lao texts, which break a
# line between words at U+200B, and tiktoken's cases of a text holding one.
#
# Only a code a row names is excused, and only one of `AS_ITSELF`: a control
# or a bidirectional character in one of these files has its escape, and is
# refused there as anywhere. A row whose file is gone, or which no longer
# holds a code it names, is red, as `known`'s are.
constant DATA: [str]
    [
        "packages/rebel/0.1.0/files/i18n/dates/internal/date_tables.hero 8203"
        "packages/rebel/0.1.0/files/i18n/dates/internal/unit_tables.hero 8203"
        # CLDR 49's display names, its Lao names of languages and scripts
        # among them. **A row added 2026-11-24** (defect d-gap-net2-1): the
        # table was born at M-rebel-library's step 137e, and `unseen` reported
        # its 223 U+200B at that merge; `\u{200b}` is refused there as in its
        # three neighbours (measured that day, `escape_not_needed`).
        "packages/rebel/0.1.0/files/i18n/names/internal/name_tables.hero 8203"
        "packages/rebel/0.1.0/files/i18n/numbers/internal/number_tables.hero 8203"
        "packages/rebel/0.1.0/files/tokenizer/tables/internal/cases.hero 8203"
    ]

# The zero-width kin of the header, which a string writes only as itself:
# U+00AD, U+115F, U+1160, U+180E, U+200B, U+2060 to U+2064, U+3164, U+FEFF
# and U+FFA0.
constant AS_ITSELF: [i64]
    [173, 4447, 4448, 6158, 8203, 8288, 8289, 8290, 8291, 8292, 12644, 65279, 65440]

# The codes `DATA` excuses in `path`, none where no row names it.
function data_codes(path: str) -> [i64]
    out: [i64] @= []

    for row in DATA
        words = strings.words(row)

        if words.len() > 1 && words[0] == path
            for word in words.slice(from: 1, to: words.len())
                code = strings.to_number(word)

                if !code.is_err() && held_in(code.must(), within: AS_ITSELF)
                    out @ out.push(code.must())

    return out

function held_in(code: i64, within: [i64]) -> bool
    for one in within
        if one == code
            return true

    return false

## The characters

# WHAT IS REFUSED, as data: each row the first and the last code point of a
# run, in decimal, the rows in order and apart. It is the ONE list. The commit
# guard reads a commit's message against these rows, from this file
# (`.claude/hooks/unseen.py`, defect 378), so a message and a document are
# refused the same characters and no second copy can drift from this one.
constant REFUSED: [str]
    [
        # C0 but the tab and the line feed
        "0 8"
        "11 31"
        # DEL and C1
        "127 159"
        # U+00AD SOFT HYPHEN
        "173 173"
        # U+061C ARABIC LETTER MARK
        "1564 1564"
        # U+115F and U+1160, the Hangul choseong and jungseong fillers
        "4447 4448"
        # U+180E MONGOLIAN VOWEL SEPARATOR
        "6158 6158"
        # U+200B ZERO WIDTH SPACE
        "8203 8203"
        # U+200E LRM and U+200F RLM
        "8206 8207"
        # U+2028, U+2029, and U+202A LRE to U+202E RLO
        "8232 8238"
        # U+2060 WORD JOINER and the invisible operators to U+2064
        "8288 8292"
        # U+2066 LRI to U+2069 PDI
        "8294 8297"
        # U+3164 HANGUL FILLER
        "12644 12644"
        # U+FEFF BYTE ORDER MARK
        "65279 65279"
        # U+FFA0 HALFWIDTH HANGUL FILLER
        "65440 65440"
    ]

# The rows of `REFUSED` as numbers, each run's first and last in turn, read
# once a walk. A row that does not read as two numbers reads as nothing here,
# and the test below holds every row to its shape and its order.
function refused_runs() -> [i64]
    out: [i64] @= []

    for row in REFUSED
        parts = strings.words(row)

        if parts.len() == 2
            first = strings.to_number(parts[0])
            last = strings.to_number(parts[1])

            if !first.is_err() && !last.is_err()
                out @ out.push(first.must())
                out @ out.push(last.must())

    return out

# Whether a document refuses `code` written as itself, `runs` being
# `refused_runs()`: the runs are in order, so the first that starts past
# `code` ends the search.
function refused_in(code: i64, runs: [i64]) -> bool
    at: i64 @= 0

    while at + 1 < runs.len()
        if code < runs[at]
            return false

        if code <= runs[at + 1]
            return true
        at @ at + 2

    return false

# Whether a document refuses `code` written as itself.
function refused(code: i64) -> bool
    return refused_in(code, runs: refused_runs())

# Which of the 128 ASCII codes `runs` refuses, by index, asked once a walk:
# nearly every byte of a document is ASCII, and a byte asked by its index
# costs what the comparisons this list replaced did, where a search of the
# runs at every byte cost the walk three quarters more (41.7 billion
# instructions against 23.9, measured 2026-10-07).
function ascii_refused(runs: [i64]) -> [bool]
    out: [bool] @= []

    for code in range(from: 0, to: 128)
        out @ out.push(refused_in(code, runs: runs))

    return out

# The characters of `text` a document refuses, each at its line, `path`
# left for the caller, `runs` being `refused_runs()` and `ascii` its
# `ascii_refused`. ASCII is asked byte by byte and anything above it decoded,
# a `str` being well-formed UTF-8 (spec § 3).
function found_in(text: str, runs: [i64], ascii: [bool]) -> [Found]
    out: [Found] @= []
    line: i64 @= 1
    at: i64 @= 0

    while at < text.len()
        b = text[at]

        if b == 10
            line @ line + 1
            at @ at + 1
            continue

        if b < 128
            if ascii[to_i64(b).must()]
                out @ out.push(Found(path: "", line: line, code: to_i64(b).must()))
            at @ at + 1
            continue
        width = width_of(b)
        code = decoded(text, at: at, width: width)

        if refused_in(code, runs: runs)
            out @ out.push(Found(path: "", line: line, code: code))
        at @ at + width

    return out

# How many bytes the character led by `b` takes.
function width_of(b: u8) -> i64
    if b >= 240
        return 4

    if b >= 224
        return 3
    return 2

# The code point of the `width` bytes at `at`.
function decoded(text: str, at: i64, width: i64) -> i64
    lead = to_i64(text[at]).must()
    code: i64 @= lead & 31

    if width == 3
        code @ lead & 15
    else if width == 4
        code @ lead & 7

    for k in range(from: 1, to: width)
        if at + k < text.len()
            code @ code * 64 + (to_i64(text[at + k]).must() & 63)

    return code

# `U+` and the code in four hexadecimal digits at least, as Unicode writes it.
function named(code: i64) -> str
    digits = "0123456789ABCDEF"
    out: str @= ""
    left: i64 @= code

    while left > 0
        out @ digits.slice(from: left % 16, to: left % 16 + 1) + out
        left @ left / 16

    while out.len() < 4
        out @ "0" + out

    return "U+" + out

function exempt(path: str) -> bool
    if placed_trees.within(path)
        return true

    for tree in EXEMPT
        if strings.has_prefix(s: path, prefix: tree)
            return true

    return false

function listed(one: Found, among: [Found]) -> bool
    for other in among
        if other.path == one.path && other.line == one.line && other.code == one.code
            return true

    return false

# What is wrong with `DATA` against the walk: a row whose file `files` does
# not hold, a code that is not one of `AS_ITSELF`, and a code no character
# `carried` holds in its file, each told by its row.
function data_offences(files: [str], carried: [Found]) -> [str]
    out: [str] @= []

    for row in DATA
        words = strings.words(row)

        if words.len() < 2
            out @ out.push("DATA names no code: " + row)
            continue
        there: bool @= false

        for path in files
            if path == words[0]
                there @ true

        if !there
            out @ out.push("DATA names a file that is not there: " + words[0])
            continue

        for word in words.slice(from: 1, to: words.len())
            code = strings.to_number(word)

            if code.is_err() || !held_in(code.must(), within: AS_ITSELF)
                out @ out.push("DATA names a code that has an escape or is no code: " + words[0] + " " + word)
                continue
            seen: bool @= false

            for one in carried
                if one.path == words[0] && one.code == code.must()
                    seen @ true

            if !seen
                out @ out.push(words[0] + ": " + named(code.must()))

    return out

## The walk

function run_all(scratch: str) -> report.Report?
    r: report.Report @= report.empty()
    files = shell.project_files(scratch)?
    documents: i64 @= 0
    found: [Found] @= []
    held = refused_runs()
    ascii = ascii_refused(held)

    for path in files
        if exempt(path)
            continue
        text = read_file(path)

        if text.is_err()
            continue
        documents @ documents + 1

        for one in found_in(text.must(), runs: held, ascii: ascii)
            found @ found.push(Found(path: path, line: one.line, code: one.code))

    excused = known()
    unexcused: [str] @= []
    carried: [Found] @= []

    for one in found
        if held_in(one.code, within: data_codes(one.path))
            carried @ carried.push(one)
        else if !listed(one, among: excused)
            unexcused @ unexcused.push("    " + one.path + ":" + one.line.to_str() + ": " + named(one.code))

    stale: [str] @= []

    for one in excused
        if !listed(one, among: found)
            stale @ stale.push("    " + one.path + ":" + one.line.to_str() + ": " + named(one.code))

    for line in data_offences(files: files, carried: carried)
        stale @ stale.push("    " + line)

    if unexcused.len() > 0
        report.keep_failure(
            @r,
            label: "unseen",
            detail: "  a document holds a character its reader cannot see, written as itself: a control character, a bidirectional control, U+2028 or U+2029, or a zero-width space or its kin (defect 356):\n" + unexcused.join("\n") + "\n  Write it as the text means: its name, `U+200B`. In a program's string, a control or bidirectional character is its escape, `\\u{1b}`; one of the zero-width kin has no escape, a string writing it only as itself, so a program builds it from its bytes as it runs, and a table a constant must hold names its file and the code in `DATA`. A tool that decodes a written escape is how they arrive."
        )
    else
        report.keep_pass(@r)

    if stale.len() > 0
        report.keep_failure(
            @r,
            label: "unseen/known",
            detail: "  `known` excuses a character a record holds, or `DATA` a code a file carries, and these no longer hold theirs: a record is only appended to, so the list is what moved. Remove the rows:\n" + stale.join("\n")
        )
    else
        report.keep_pass(@r)

    floors.check(@r, label: "unseen", found: documents, floor: LEAST_DOCUMENTS, what: "documents read")
    return ok(r)

## Tests

# Built from bytes, since a document's raw character is what is under test.
function of(bytes: [u8]) -> str
    return bytes.validated_bytes().must()

test "a document refuses a control character, a bidirectional one and the zero-width kin, and keeps what text spells with"
    for code in [0, 1, 13, 27, 127, 133, 159, 173, 1564, 6158, 8203, 8206, 8207, 8232, 8233, 8234, 8238, 8288, 8292, 8294, 8297, 65279, 4447, 12644, 65440]
        assert refused(code)

    for code in [9, 10, 32, 65, 160, 233, 8204, 8205, 8364, 8193, 12288, 65039, 917601, 128512]
        assert !refused(code)

test "a character is found at its line and named by its code"
    text = "one\ntwo " + of([226, 128, 139]) + "\nthree " + of([226, 128, 174]) + " and " + of([27]) + "\n" + of([240, 159, 145, 168, 226, 128, 141, 240, 159, 146, 187]) + "\n"
    got = found_in(text, runs: refused_runs(), ascii: ascii_refused(refused_runs()))
    assert got.len() == 3
    assert got[0].line == 2
    assert got[0].code == 8203
    assert got[1].line == 3
    assert got[1].code == 8238
    assert got[2].code == 27
    assert named(8203) == "U+200B"
    assert named(27) == "U+001B"
    assert named(917601) == "U+E0061"

test "the refused runs are two numbers each, in order and apart, so the search may stop early"
    held = refused_runs()
    assert held.len() == REFUSED.len() * 2
    at: i64 @= 0

    while at + 1 < held.len()
        assert held[at] <= held[at + 1]

        if at + 2 < held.len()
            assert held[at + 1] < held[at + 2]
        at @ at + 2

    ascii = ascii_refused(held)
    assert ascii.len() == 128

    for code in range(from: 0, to: 128)
        assert ascii[code] == refused(code)

test "a case's tree is exempt and a document is not"
    assert exempt("tests/golden/check/fixedbugs-283-x.hero")
    assert exempt("seed/heroes.c")
    assert !exempt("docs/panel/192-reports/historian.md")
    assert !exempt("tests/harness/suite_unseen.hero")

test "an upstream's resources a generator holds to their bytes are exempt, and the generator beside them is not"
    assert exempt("generators/unicode_encodings/whatwg/index-windows-1252.txt")
    assert exempt("generators/unicode_encodings/whatwg/encodings.json")
    assert !exempt("generators/unicode_encodings/main.hero")
    assert !exempt("generators/unicode_encodings/layout.hero")
    assert !exempt("generators/unicode_encodings/whatwgx/index-windows-1252.txt")
    assert !exempt("generators/html_entities/whatwg/entities.json")
    assert !exempt("packages/rebel/0.1.0/files/unicode/encodings/internal/single_byte_table.hero")

# Panel 235's R7: the folder is left out by its name, at any depth, and
# nothing beside it is, the package's own source least of all.
test "a placed tree is exempt by its folder's name, and the package's source beside it is not"
    assert exempt("examples/ini/heroes.packages/rebel@0.1.0-0123456789abcdef/strings.md")
    assert exempt("heroes.packages/rebel@0.1.0-0123456789abcdef/strings.hero")
    assert !exempt("packages/rebel/0.1.0/files/strings.md")
    assert !exempt("examples/ini/heroes.packagesx/strings.md")
    assert !exempt("examples/ini/my.heroes.packages/strings.md")
    assert !exempt("examples/ini/main.hero")

# The kin `DATA` may name are refused written as themselves in a document,
# and none of them is a control or a bidirectional character, which a string
# writes by its escape: the line `AS_ITSELF` draws is the language's.
test "the zero-width kin a data file may carry are refused characters with no escape, and a row excuses only its own file's codes"
    for code in AS_ITSELF
        assert refused(code)
        assert code > 159
        assert code != 1564 && code != 8206 && code != 8207
        assert code < 8232 || code > 8238
        assert code < 8294 || code > 8297

    tables = "packages/rebel/0.1.0/files/i18n/dates/internal/date_tables.hero"
    assert data_codes(tables) == [8203]
    assert data_codes(tables + ".md").len() == 0
    assert data_codes("packages/rebel/0.1.0/files/i18n/dates/internal").len() == 0
    assert data_codes("docs/panel/192-reports/historian.md").len() == 0

# Built from `DATA` itself, so a row added is held as the others are: the
# test named three files while the constant named four, and failed.
test "a data row is held to its file and to a code that file still carries"
    files: [str] @= []
    carried: [Found] @= []
    lost: [str] @= []

    for row in DATA
        words = strings.words(row)
        files @ files.push(words[0])
        lost @ []

        for word in words.slice(from: 1, to: words.len())
            code = strings.to_number(word).must()
            carried @ carried.push(Found(path: words[0], line: 1, code: code))
            lost @ lost.push(words[0] + ": " + named(code))

    last = files[files.len() - 1]
    kept: [Found] @= []

    for one in carried
        if one.path != last
            kept @ kept.push(one)

    assert files.len() == DATA.len() && lost.len() > 0
    assert data_offences(files: files, carried: carried).len() == 0
    assert data_offences(files: files.slice(from: 0, to: files.len() - 1), carried: carried) == ["DATA names a file that is not there: " + last]
    assert data_offences(files: files, carried: kept) == lost
