# Same input, same bytes — twice, and through `-o`.
#
# Ports golden.rs:261 (the IR dump) and golden.rs:652 (the emitted C,
# which CLAUDE.md §7 says "stays green at all times"). Two artifacts, one
# property, so one module.
#
# THE ANCESTOR IS NAMED RATHER THAN INVENTED: GCC's bootstrap compares
# stage2 and stage3 objects, and its manual says a mismatch "normally
# indicates that the stage2 compiler has compiled GCC incorrectly" — the
# fixpoint this project reached at M-selfhost-fixpoint, thirty years
# earlier. Determinism is what makes that comparison mean anything: two
# runs that differ turn every later byte-for-byte claim into noise, and
# this repository now has one that matters — `seed/heroes.c` is checked by
# `cmp` against what the seed-built compiler emits, in CI's *The seed is
# what today's source emits*, Linux at tags. That sentence stood here for
# four days while the check DID NOT EXIST (panel 087, found by two
# independent greps); it is true from 2026-08-23, and the reason it is
# named with its home is that a comment asserting an instrument is worth
# nothing without one — CLAUDE.md §11's premise that expires in silence.
# It runs at the tag and not here because the emission is 15m41s.
#
# The `-o` leg is a second property with its own reason: the C is
# identical whether it goes to stdout or through `-o`, BECAUSE the emitted
# text never mentions the output path (§7). A compiler that stamped its
# own output filename into a comment would pass the twice-test and fail
# this one.
#
# For the IR, determinism is the ONLY promise panel 019 made about the
# artifact — it is explicitly not version-stable, which is LLVM's stance
# on `.ll` — and a promise nothing checks is not a promise.

use <core>/strings as core_strings

use absence
use cases
use floors
use one_file_units
use platform_skips
use report
use shell

constant IR_DIR: str
    "tests/golden/ir"

# The two directories whose every case has an emittable program.
constant EMIT_DIR: str
    "tests/golden/emit"

constant RUN_DIR: str
    "tests/golden/run"

# **The floors of the three directories, since defect 2534** (2026-11-15):
# until then the suite held none, so a walk broken to find nothing read
# `0 passed, 0 failed` and passed the gate (measured that day from a folder
# holding the three directories empty). Each is the count of `.hero` cases
# and `.case` folders its directory held at 0f924302a, the walk's own rule
# (`cases.collect`): 29 in `ir/`, 13 in `emit/`, and 800 files and 25 folders
# in `run/`. Raised as `floors.check` tells, never lowered.
constant LEAST_IR: i64
    29

constant LEAST_EMIT: i64
    13

constant LEAST_RUN: i64
    825

# The IR's directory, with its floor.
function ir_walk() -> floors.Walked
    return floors.Walked(dir: IR_DIR, least: LEAST_IR)

# The directories whose cases emit C, each with its floor.
function c_walks() -> [floors.Walked]
    return [floors.Walked(dir: EMIT_DIR, least: LEAST_EMIT), floors.Walked(dir: RUN_DIR, least: LEAST_RUN)]

# `only` narrows the suite to the cases whose name holds it, in each directory
# it walks (`cases.matching`, defect 2529): until then the suite took no word,
# and `main` told the person narrowing a repair to its cases that it walked
# none, while it emitted every case of `ir/`, `emit/` and `run/`. The skip
# ratio is asked of the cases walked, as `run` asks it of a filter's; a word
# that selects nothing is `main`'s to refuse, as it is for every suite. A
# filter's cases are not the tree, so it asks no floor (`cases.asks_floor`).
function run_all(scratch: str, compiler: str, only: str) -> report.Report?
    return walk(scratch: scratch, compiler: compiler, ir: ir_walk(), c: c_walks(), only: only)

# The suite over the directories it is handed: what `run_all` asks of the
# tree, with the directories and their floors as parameters so a test asks it
# of a tree of its own (defect 2534). Each directory's whole count is held to
# its floor before its cases are judged.
function walk(scratch: str, compiler: str, ir: floors.Walked, c: [floors.Walked], only: str) -> report.Report?
    r: report.Report @= report.empty()
    written = scratch + "/determinism"
    shell.mkdir_all(written)?
    skipped: i64 @= 0
    total: i64 @= 0
    ir_cases = cases.collect(scratch: scratch, dir: ir.dir)?
    floored(@r, walked: ir, found: ir_cases.len(), only: only)

    for item in cases.matching(found: ir_cases, only: only)
        total @ total + 1
        first = dumped(scratch: scratch, compiler: compiler, item: item, flag: "--dump-ir", into: "")
        second = dumped(scratch: scratch, compiler: compiler, item: item, flag: "--dump-ir", into: "")

        if first.is_err() || second.is_err()
            report.keep_failure(
                @r,
                label: "determinism/ir/" + item.name,
                detail: "  cannot dump " + item.source + ":\n    " + last_error(first) + last_error(second)
            )
        else if first.must() != second.must()
            report.keep_failure(
                @r,
                label: "determinism/ir/" + item.name,
                detail: "  " + item.source + " dumps differently twice — the one promise panel 019 made about this artifact"
            )
        else
            report.keep_pass(@r)

    for walked in c
        whole = cases.collect(scratch: scratch, dir: walked.dir)?
        floored(@r, walked: walked, found: whole.len(), only: only)

        for item in cases.matching(found: whole, only: only)
            total @ total + 1
            c_case(@r, @skipped, scratch: scratch, compiler: compiler, written: written, item: item)

    if skipped > 0 && skipped * 3 >= total
        report.keep_failure(
            @r,
            label: "determinism",
            detail: "  " + skipped.to_str() + " of " + total.to_str() + " cases were skipped for a missing library — this machine is not checking determinism"
        )
    return ok(r)

# One directory's whole count held to its floor, where the run asks one: the
# whole suite, never a filter, whose cases are not the tree.
function floored(@r: report.Report, walked: floors.Walked, found: i64, only: str)
    if cases.asks_floor(only)
        floors.check(@r, label: "determinism", found: found, floor: walked.least, what: "cases in " + walked.dir)

# One case's C: twice to stdout and once through `-o`, the same bytes all three.
#
# A case this machine cannot emit because a library it binds is missing is the
# machine's answer, not the compiler's: skipped, by name, and floored by the
# caller. It is the machine's only where the case binds what the compiler says
# is missing and the machine, asked, lacks it (`absence`); until defect 246 the
# compiler's words alone made the skip.
#
# A case whose one file `--emit-c` refuses (`ffi_one_file`, defect 453) is
# judged on the units `build` writes for it, a unit per module, emitted twice
# and alike (`one_file_units`): never passed over.
#
# A case this platform cannot build is skipped by name before its first
# emission, apart from the missing libraries' floor, as `run` skips it
# (`platform_skips.build_reason`, defect 2523): until then it was emitted and
# told as a failure on the CI's Windows leg.
function c_case(@r: report.Report, @skipped: i64, scratch: str, compiler: str, written: str, item: cases.Case)
    unbuilt = platform_skips.build_reason(item.source)

    if !unbuilt.is_err()
        report.keep_skip(@r, label: "determinism/c/" + item.name, detail: "  " + unbuilt.must())
        return
    first = dumped(scratch: scratch, compiler: compiler, item: item, flag: "--emit-c", into: "")

    if first.is_err() && one_file_units.refused_one_file(last_error(first))
        units_alike(@r, scratch: scratch, compiler: compiler, item: item)
        return

    if first.is_err()
        lacks = absence.machine_lacks(scratch: scratch, path: item.source, expected: "", said: last_error(first))

        if !lacks.is_err()
            skipped @ skipped + 1
            report.keep_skip(@r, label: "determinism/c/" + item.name, detail: "  " + lacks.must())
            return
        detail: str @= "  cannot emit " + item.source + ":\n" + last_error(first)
        why = absence.refused(lacks)

        if why.len() > 0
            detail @ detail + "\n  not skipped for a missing library: " + why
        report.keep_failure(@r, label: "determinism/c/" + item.name, detail: detail)
        return
    second = dumped(scratch: scratch, compiler: compiler, item: item, flag: "--emit-c", into: "")

    if second.is_err() || first.must() != second.must()
        report.keep_failure(
            @r,
            label: "determinism/c/" + item.name,
            detail: "  " + item.source + " emits differently twice — §7 says this stays green at all times"
        )
        return
    target = written + "/" + item.name + ".c"
    through = dumped(scratch: scratch, compiler: compiler, item: item, flag: "--emit-c", into: target)

    if through.is_err()
        report.keep_failure(
            @r,
            label: "determinism/c/" + item.name,
            detail: "  cannot emit " + item.source + " through -o"
        )
        return
    kept = read_file(target)

    if kept.is_err()
        report.keep_failure(
            @r,
            label: "determinism/c/" + item.name,
            detail: "  -o wrote nothing readable at " + target
        )
    else if kept.must() != first.must()
        report.keep_failure(
            @r,
            label: "determinism/c/" + item.name,
            detail: "  " + item.source + " differs between stdout and -o: the C mentions its own output path"
        )
    else
        report.keep_pass(@r)

# The units `build` writes for a case, twice, the same files with the same
# bytes.
function units_alike(@r: report.Report, scratch: str, compiler: str, item: cases.Case)
    label = "determinism/c/" + item.name
    one = one_file_units.units_of(scratch: scratch, compiler: compiler, source: item.source, tag: item.name + "-a")
    two = one_file_units.units_of(scratch: scratch, compiler: compiler, source: item.source, tag: item.name + "-b")

    if one.is_err() || two.is_err()
        report.keep_failure(
            @r,
            label: label,
            detail: "  `--emit-c` refuses " + item.source + "'s one file, and its units could not be asked twice:\n" + last_units_error(one) + last_units_error(two)
        )
        return
    wrong: [str] @= []

    if names_of(one.must()) != names_of(two.must())
        wrong @ wrong.push(
            "    the units were " + names_of(one.must()).join(", ") + " and then " + names_of(two.must()).join(", ")
        )
    else
        for i in range(from: 0, to: one.must().len())
            if one.must()[i].text != two.must()[i].text
                wrong @ wrong.push("    " + one.must()[i].name + " came out with different bytes the second time")

    if wrong.len() > 0
        report.keep_failure(
            @r,
            label: label,
            detail: "  `--emit-c` refuses " + item.source + "'s one file, and the units `build` writes for it differ twice — §7 says this stays green at all times:\n" + wrong.join("\n")
        )
    else
        report.keep_pass(@r)

function names_of(units: [one_file_units.Unit]) -> [str]
    out: [str] @= []

    for unit in units
        out @ out.push(unit.name)

    return out

function last_units_error(got: [one_file_units.Unit]?) -> str
    return match got
        .ok _  => ""
        .err e => "    " + e.msg + "\n"

# One emission, as text. `into` empty means stdout, which is what the
# comparison uses; a non-empty `into` writes through `-o` and the answer
# is read from the file instead.
function dumped(scratch: str, compiler: str, item: cases.Case, flag: str, into: str) -> str?
    line: [str] @= [compiler, "build", item.source, flag]

    if into.len() > 0
        line @ line.push("-o")
        line @ line.push(into)
    said = shell.run(scratch: scratch, program: compiler, words: line)?

    if said.code != 0
        return fail(code: "cannot_emit", msg: said.err)
    return ok(said.out)

# The compiler's own words about the emission that failed, "" where it did not.
#
# **It used to read `scratch + "/stderr"` by name**, which was the one
# dependency on that path outside `shell.hero` — and it was reading whatever
# process had written there last rather than this case's. A skip decision rests
# on it (`absence.machine_lacks`), so the wrong words there turn a failure
# into a SKIP. `dumped` already carries the stderr in its own failure message,
# so the answer is in the value the caller is holding (panel 174, route B).
function last_error(got: str?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

test "the determinism suite passes identical emissions and catches a wobbling one"
    # POSIX is this case's subject, and this machine answers for itself
    # (can_run_scripts carries the measurement).
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = scratch + "/determinism-case"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    assert !write_file(path: tree + "/x.hero", text: "function main()\n    print(1)\n").is_err()
    assert !write_file(path: tree + "/x.expected", text: "").is_err()
    item = cases.Case(source: tree + "/x.hero", expected: tree + "/x.expected", name: "x")

    # The real compiler, twice: this is the property itself.
    one = dumped(scratch: scratch, compiler: shell.some_compiler().must(), item: item, flag: "--emit-c", into: "")
    two = dumped(scratch: scratch, compiler: shell.some_compiler().must(), item: item, flag: "--emit-c", into: "")
    assert !one.is_err()
    assert one.must() == two.must()
    assert one.must().len() > 0

    # A stand-in that answers differently every time — a compiler with a
    # hash seed, an address in a comment, a timestamp. It must be caught.
    #
    # **The stand-in read the clock until 2026-08-30, and on the CI's macOS it
    # stood still.** `date +%s%N` asks for nanoseconds, `%N` is a GNU coreutils
    # extension, and BSD `date` prints the letter instead: the Darwin leg failed
    # with `left: 1788126203N` and `right: 1788126203N`, two calls inside one
    # second answering the same string, so the wobbler this test exists to catch
    # was not wobbling. It passed on the author's machine because Darwin 25's
    # `date` does support `%N` — a defect a newer laptop hides from the runner
    # that finds it. Eight bytes of `/dev/urandom` ask no calendar and no
    # platform: 200 calls, 200 distinct answers, measured.
    wobbler = scratch + "/stub-wobble.sh"
    assert !write_file(path: wobbler, text: "#!/bin/sh\nod -An -N8 -tx1 /dev/urandom\n").is_err()
    assert !shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", wobbler]).is_err()
    a = dumped(scratch: scratch, compiler: wobbler, item: item, flag: "--emit-c", into: "")
    b = dumped(scratch: scratch, compiler: wobbler, item: item, flag: "--emit-c", into: "")
    assert !a.is_err()
    assert !b.is_err()
    assert a.must() != b.must()
    assert !shell.remove_tree(scratch).is_err()

test "an emission that fails is an error carrying the compiler's words"
    scratch = shell.own_scratch()
    tree = scratch + "/determinism-broken"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree).is_err()
    assert !write_file(path: tree + "/b.hero", text: "function main()\n    print(nope)\n").is_err()
    assert !write_file(path: tree + "/b.expected", text: "").is_err()
    item = cases.Case(source: tree + "/b.hero", expected: tree + "/b.expected", name: "b")
    got = dumped(scratch: scratch, compiler: shell.some_compiler().must(), item: item, flag: "--emit-c", into: "")
    assert got.is_err()
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 246's cause in this suite, held as a test (2026-10-04): the skip took
# the compiler's words for the machine's. A header the machine has, said to be
# missing, is judged and fails; a header no machine has, which the case binds,
# is skipped by name.
test "fixedbugs: a case that cannot emit is skipped only where the machine lacks what it binds"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = scratch + "/determinism-absence"
    assert !shell.remove_tree(tree).is_err()
    assert !shell.mkdir_all(tree + "/written").is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    has = absence.planted_case(dir: tree, name: "has", bound: "stdio.h", missing: "stdio.h")
    assert !has.is_err()
    refuted: report.Report @= report.empty()
    none_skipped: i64 @= 0
    c_case(
        @refuted,
        @none_skipped,
        scratch: scratch,
        compiler: compiler.must(),
        written: tree + "/written",
        item: cases.Case(source: has.must(), expected: "", name: "has")
    )
    assert refuted.failed == 1
    assert none_skipped == 0
    assert refuted.skips.len() == 0
    assert core_strings.contains(s: refuted.failures[0], substr: "clang finds `stdio.h`")
    lacks = absence.planted_case(dir: tree, name: "lacks", bound: absence.NOWHERE, missing: absence.NOWHERE)
    assert !lacks.is_err()
    excused: report.Report @= report.empty()
    one_skipped: i64 @= 0
    c_case(
        @excused,
        @one_skipped,
        scratch: scratch,
        compiler: compiler.must(),
        written: tree + "/written",
        item: cases.Case(source: lacks.must(), expected: "", name: "lacks")
    )
    assert excused.failed == 0
    assert one_skipped == 1
    assert excused.skips.len() == 1
    assert core_strings.has_prefix(s: excused.skips[0], prefix: "SKIP determinism/c/lacks\n")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2523, held as a test (2026-11-14): a case the Windows target cannot
# build is skipped there by name before its first emission, apart from the
# missing libraries' floor, and emitted everywhere else. The compiler named is
# a file nobody wrote, so an emission asked is a failure naming it.
test "fixedbugs: a case Windows cannot build is skipped there before its emission, and emitted elsewhere (defect 2523)"
    scratch = shell.own_scratch()
    r: report.Report @= report.empty()
    none_skipped: i64 @= 0
    c_case(
        @r,
        @none_skipped,
        scratch: scratch,
        compiler: scratch + "/no-compiler-here",
        written: scratch,
        item: cases.Case(source: platform_skips.unbuildable_on_windows()[1].name, expected: "", name: "unbuilt")
    )
    assert none_skipped == 0
    assert r.passed == 0

    if shell.exe_suffix() == ".exe"
        assert r.failed == 0
        assert r.skips.len() == 1
        assert core_strings.has_prefix(s: r.skips[0], prefix: "SKIP determinism/c/unbuilt\n  POSIX's signal sets")
    else
        assert r.failed == 1
        assert r.skips.len() == 0
        assert core_strings.contains(s: r.failures[0], substr: "no-compiler-here")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 453's widening in this suite, held as a test (2026-10-10): a program
# whose one file `--emit-c` refuses is judged on the units `build` writes,
# alike twice, and reads as a pass, never a skip.
test "fixedbugs: a case whose one file --emit-c refuses is judged on its units, alike twice (defect 453)"
    compiler = shell.some_compiler()

    if compiler.is_err()
        return
    scratch = shell.own_scratch()
    planted = one_file_units.planted_two_ways(scratch)
    assert !planted.is_err()
    judged: report.Report @= report.empty()
    none_skipped: i64 @= 0
    c_case(
        @judged,
        @none_skipped,
        scratch: scratch,
        compiler: compiler.must(),
        written: scratch,
        item: cases.Case(source: planted.must(), expected: "", name: "two-ways")
    )
    assert judged.passed == 1
    assert judged.failed == 0
    assert none_skipped == 0
    assert judged.skips.len() == 0
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2529, held as a test (2026-11-14): the third word narrows the walk to
# the cases whose name holds it, in every directory the suite walks, where
# `main` refused it as the word of a suite that walks no cases. The word is the
# first `ir/` case's whole name, so the cases it names are few and cheap to
# dump; every case the run judged, passed, failed or skipped, is one of them,
# and every one of them is judged.
test "fixedbugs: the third word narrows the walk to the cases whose name holds it, in every directory it walks (defect 2529)"
    compiler = shell.some_compiler()

    if compiler.is_err()
        return
    scratch = shell.own_scratch()
    word = cases.collect(scratch: scratch, dir: IR_DIR).must()[0].name
    named: i64 @= cases.matching(found: cases.collect(scratch: scratch, dir: IR_DIR).must(), only: word).len()

    for walked in c_walks()
        named @ named + cases.matching(found: cases.collect(scratch: scratch, dir: walked.dir).must(), only: word).len()

    got = run_all(scratch: scratch, compiler: compiler.must(), only: word).must()
    assert named >= 1
    assert got.passed + got.failed + got.skips.len() == named
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 2534, held as a test (2026-11-15): the suite held no floor, so run
# from a folder holding its three directories empty it read `0 passed, 0
# failed`, exit 0. Handed three empty directories of a test's own, each floored
# at one, it fails once per directory, naming it; a filter asks no floor of
# them; and a floor its directory meets is a pass. No case is emitted, so the
# compiler named is a file nobody wrote.
test "fixedbugs: a walk that finds nothing in a directory fails by that directory's floor, and a filter asks none (defect 2534)"
    scratch = shell.own_scratch()
    tree = scratch + "/determinism-2534"
    assert !shell.remove_tree(tree).is_err()

    for dir in ["ir", "emit", "run"]
        assert !shell.mkdir_all(tree + "/" + dir).is_err()

    compiler = scratch + "/no-compiler-here"
    ir = floors.Walked(dir: tree + "/ir", least: 1)
    c: [floors.Walked] = [floors.Walked(dir: tree + "/emit", least: 1), floors.Walked(dir: tree + "/run", least: 1)]
    empty = walk(scratch: scratch, compiler: compiler, ir: ir, c: c, only: "").must()
    assert empty.passed == 0
    assert empty.failed == 3

    for i in range(from: 0, to: 3)
        dir = ["ir", "emit", "run"][i]
        assert core_strings.has_prefix(
            s: empty.failures[i],
            prefix: "FAIL determinism\n  the walk found 0 cases in " + tree + "/" + dir + " and had 1 — "
        )

    filtered = walk(scratch: scratch, compiler: compiler, ir: ir, c: c, only: "fixedbugs-2534").must()
    assert filtered.passed == 0
    assert filtered.failed == 0
    none: [floors.Walked] = []
    met = walk(
        scratch: scratch,
        compiler: compiler,
        ir: floors.Walked(dir: tree + "/ir", least: 0),
        c: none,
        only: ""
    ).must()
    assert met.passed == 1
    assert met.failed == 0
    assert !shell.remove_tree(scratch).is_err()
