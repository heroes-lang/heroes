# The six golden suites that ask one question with six sets of
# parameters: run one command per case, diff ONE stream against the
# `.expected` file, and check how the compiler ended.
#
# Ports golden.rs:124 (`check/`), :220 (`ir/`), :459 (`unsupported/`) and
# :520 (`emit/`), and since defect 211 (2026-10-04) asks `check/`'s question
# of the control arm (`permissive/`), and since defect 289 the same day of the
# whole form a message is written in (`full/`). One runner rather than six, because
# they differ only in the verb, the flags, which stream carries the artifact
# and the exit code the case must produce, and a second copy is a second place
# for the exit-code rule to drift. What is deliberately NOT folded in is
# anything carrying a second question: the `#~` annotation invariant, the
# IR dump's determinism, the `#line` sweep and the certain-fix suite each
# get a module of their own.
#
# THE THREE RULES THAT ARE NOT ABOUT DIFFING, and each one is a defect
# somebody already paid for:
#
# - the exit code is exact, never merely non-zero. Panel 016's contract
#   separates "the input has diagnostics" (1) from "the tool could not
#   run" (2), so a case that started CRASHING instead of diagnosing must
#   not pass;
# - a suite has a FLOOR. `tests/golden/ir` losing nineteen files would
#   otherwise report green over the one that remained — the shape §9 calls
#   an invariant that cannot fail;
# - a skip is not a pass. `unsupported/` may skip a case this machine cannot
#   judge, a library the case binds that the machine lacks, and only where
#   the expectation, the case and the machine all say so, never the
#   compiler's words alone (`absence.hero`, defect 246). Each skip is named,
#   and the count is floored: a machine skipping everything says so instead
#   of reporting green.
#
# UPDATE_GOLDEN is not implemented and must not be — CLAUDE.md §9 forbids
# it in `check/` and `ir/`, and a flag that cannot be typed is a rule that
# cannot be broken by accident.

use absence
use cases
use report
use floors
use shell
use strings

# One suite, as data. `flags` follow the verb and the case, in their order.
record Shape
    name: str
    dir: str
    verb: str
    flags: [str]
    on_stderr: bool
    want_code: i64
    least: i64

    # **Whether this shape's floor is watched for DECAY as well as for a walk
    # that found nothing.** The six real shapes set it; the cases below build
    # Shapes over two-file trees with a floor of 1, and calling those outgrown
    # would turn every case red. The flag is the seam between a floor that is a
    # measurement of the tree and one that is a fixture.
    watched: bool
    silent_stdout: bool
    library_skip: bool

# The floors are the case counts, so a case that stops running is a red harness
# rather than a smaller green one. golden.rs floored only three of the four, and
# at hand-written numbers (20, 3, 3); a floor at the real count is the same rule
# with the slack taken out.
#
# **Measured 2026-08-18 at check 65 · ir 20 · emit 6 · unsupported 11, and
# re-measured 2026-09-12 at 112 · 23 · 6 · 12.** The sentence above forbids slack
# and `check` had accumulated 47 — in the one directory where `UPDATE_GOLDEN=1`
# is forbidden OUTRIGHT by the contract's hard stops, so the most protected
# corpus in the repository was the one whose floor had gone slackest. Nothing
# could see it: a floor is a premise about the world, and the comment stating it
# went on reading as true. `floors.check` is what sees it now, and these numbers
# are re-based to today's count.
#
# **`check` 142 -> 178 on 2026-09-28**, re-based when `floors.check` said so:
# defect 129's twelve `fixedbugs-129-` cases took the directory from 166 to
# 178, past the floor by more than a quarter.
#
# **`check` 181 from defects 130 and 131's lane, 2026-09-29**: its fifteen
# `fixedbugs-130-*` and `fixedbugs-131-*` cases took the tree past its floor
# of 142 by more than a quarter, and the suite printed 181.
#
# **198 where the two lanes met, 2026-09-29**: defect 129's lane merged the
# trunk at `0ba7b084`, which carried lane 130's cases, and on the merged tree
# the suite printed 198, its seventeen and lane 130's fifteen over 166.
#
# **250 where lane Y met the trunk, 2026-09-29**: lanes 132, 133, X1, X2
# and Y took the directory past 198 by more than a quarter, and on the merged
# tree the suite asked for 250.
#
# **314 in lane recovery-b4, 2026-09-30**: the recovery cluster's batches took
# the directory past 250 by more than a quarter at the fourth batch's panel 183
# cases, and the suite asked for 314.
#
# **393 in lane recovery-b7, 2026-10-02**: the batches after it took the
# directory past 314 by more than a quarter at that lane's eighth case, its
# CRLF `f` literal, and the suite asked for 393.
#
# **498 at batch 10's merge, 2026-10-04**: batches 8, 9 and 10 took the
# directory past 393 by more than a quarter at lane b10-cli's cases for
# defects 324 and 325, and the merged tree's suite asked for 498.
function shape_check() -> Shape
    return Shape(
        name: "check",
        dir: "tests/golden/check",
        verb: "check",
        flags: ["--brief"],
        on_stderr: true,
        want_code: 1,
        least: 498,
        watched: true,
        silent_stdout: false,
        library_skip: false
    )

function shape_ir() -> Shape
    return Shape(
        name: "ir",
        dir: "tests/golden/ir",
        verb: "build",
        flags: ["--dump-ir"],
        on_stderr: false,
        want_code: 0,
        least: 23,
        watched: true,
        silent_stdout: false,
        library_skip: false
    )

function shape_emit() -> Shape
    return Shape(
        name: "emit",
        dir: "tests/golden/emit",
        verb: "build",
        flags: ["--emit-c"],
        on_stderr: false,
        want_code: 0,
        least: 6,
        watched: true,
        silent_stdout: false,
        library_skip: false
    )

# `unsupported/` runs a plain `build`: the case is a program the backend
# REFUSES, so the artifact is the refusal on stderr and there must be
# nothing on stdout at all.
#
# **25 in lane emit, 2026-10-01**: defect 144's eleven `fixedbugs-144-` cases,
# one per declared result type, took the directory from 14 cases to 25, past
# its floor of 12 by more than a quarter, and the suite asked for 25. **34 the
# same day**, defect 145's nine `fixedbugs-145-` cases, one per way a header
# names a struct. **46 in lane ffi-macro, 2026-10-02**: defect 152's nine
# `fixedbugs-152-` cases, one per kind of name a header holds that is not a
# function, and the suite asked for 46. **63 the same day**: seven
# `fixedbugs-152-a-field-the-header-lacks-` cases and defect 143's ten
# `fixedbugs-143-` cases (panel 185 R1). **84 in lane land186, the same day**:
# panel 186's landing, twelve `fixedbugs-151-` cases and seven
# `fixedbugs-156-` ones, over 65. **79 in lane h158, the same day**:
# defect 158's fourteen `fixedbugs-158-` cases, one per way a header the
# machine lacks is reached, took the directory from 65 past 63 by more than a
# quarter. **84 at the round's merge of the two lanes, the same day**: the
# higher of the two floors, since a floor moves one way. **118 at the round's
# third gate, the same day**: lane land186's seventeen, eleven
# `ffi-a-construction-` cases (panel 186 R7), `ffi-a-field-named-after-a-header-macro`
# (defect 164) and five `fixedbugs-157-`, and lane h158's
# `fixedbugs-163-` case, took the directory from 100 past 84 by more than a
# quarter, and the suite asked for 118. It is the tree's count, the same on
# every platform: a case a machine skips for a library it lacks is judged
# by the third below, never by this floor.
function shape_unsupported() -> Shape
    return Shape(
        name: "unsupported",
        dir: "tests/golden/unsupported",
        verb: "build",
        flags: NO_FLAGS,
        on_stderr: true,
        want_code: 1,
        least: 118,
        watched: true,
        silent_stdout: true,
        library_skip: true
    )

constant NO_FLAGS: [str]
    []

# `full/` is `check/`'s question asked of the whole form (defect 289,
# 2026-10-04): `check` with no `--brief`, so what is compared is every part
# design.md §4.17 asks a message to carry, its place, the line quoted under its
# gutter and caret, its notes and its fixes. Every `check/` case asks
# `--brief`, which prints a message's first line alone, so a note, an excerpt
# or a fix that changed moved no golden: 0 of 466 `check/` expectations held an
# `at` line, counted at `703af779`, and defect 244's excerpt was pinned in its
# message alone. **5 cases on 2026-10-04**, the count, and so the floor.
function shape_full() -> Shape
    return Shape(
        name: "full",
        dir: "tests/golden/full",
        verb: "check",
        flags: NO_FLAGS,
        on_stderr: true,
        want_code: 1,
        least: 5,
        watched: true,
        silent_stdout: false,
        library_skip: false
    )

# `permissive/` is `check/` asked of Part 11's control arm: the same verb and
# the same brief form, with `--permissive`, which drops the diagnostics that
# exist for the thesis (`selfhost/diag.hero`'s `is_thesis_rule`) at every stage
# and reads the parse as a language without them does (`selfhost/parse.hero`'s
# `control`). A case's `#~` marks there are the control arm's diagnostics, where
# in `check/` they are the normal arm's, which is why the arm has a directory of
# its own.
#
# **No golden form ran it until defect 211** (panel 187's R3, 2026-10-03): the
# surface rows ask its exit code and its silence (`suite_surface.hero`,
# `permissive drops them`), never its words, so a control-arm row could not be
# pinned, and Part 11's control arm could say anything else with every golden
# green. **4 cases on 2026-10-04**, the count, and so the floor. **6 on
# 2026-10-05**, as the suite asked: defect 193's control-arm case and defect
# 251's, which pins that the control arm keeps refusing a character a reader
# cannot see (panel 192's R4).
function shape_permissive() -> Shape
    return Shape(
        name: "permissive",
        dir: "tests/golden/permissive",
        verb: "check",
        flags: ["--brief", "--permissive"],
        on_stderr: true,
        want_code: 1,
        least: 6,
        watched: true,
        silent_stdout: false,
        library_skip: false
    )

# `only` narrows the form to the cases whose name holds it (cases.matching);
# a narrowed run is not the whole form, so its floor is not asked.
function run_all(scratch: str, compiler: str, shape: Shape, only: str) -> report.Report?
    found = cases.matching(found: cases.collect(scratch: scratch, dir: shape.dir)?, only: only)
    r: report.Report @ report.empty()

    if only == "" && shape.watched
        floors.check(@r, label: shape.name, found: found.len(), floor: shape.least, what: "cases in " + shape.dir)
    else if only == "" && found.len() < shape.least
        report.keep_failure(
            @r,
            label: shape.name,
            detail: "  " + shape.dir + " has " + found.len().to_str() + " cases and had " + shape.least.to_str() + " — a golden that stopped running is not a golden"
        )
    skipped: i64 @ 0

    for item in found
        expectation = read_file(item.expected)

        if expectation.is_err()
            report.keep_failure(@r, label: shape.name + "/" + item.name, detail: "  cannot read " + item.expected)
        else
            line: [str] @ [compiler, shape.verb, item.source]

            for flag in shape.flags
                line @ line.push(flag)

            said = shell.run(scratch: scratch, program: compiler, words: line)

            # The refusal's own words, never a sentence of this suite's: until
            # defect 317 this said *cannot run the compiler on* of a compiler
            # that ran and wrote bytes that are not UTF-8.
            if said.is_err()
                report.keep_failure(
                    @r,
                    label: shape.name + "/" + item.name,
                    detail: "  " + item.source + ": " + shell.refusal(said)
                )
            else if shape.library_skip
                judged_or_skipped(
                    @r,
                    @skipped,
                    scratch: scratch,
                    shape: shape,
                    item: item,
                    expected: expectation.must(),
                    said: said.must()
                )
            else
                verdict(@r, shape: shape, item: item, expected: expectation.must(), said: said.must(), refused: "")

    if skipped > 0 && skipped * 3 >= found.len()
        report.keep_failure(
            @r,
            label: shape.name,
            detail: "  " + skipped.to_str() + " of " + found.len().to_str() + " cases were skipped for a missing library — this machine is not testing the refusals"
        )
    return ok(r)

# One case of a form that may skip for a missing library, `unsupported/`.
#
# It is judged against what the compiler would write on THIS machine
# (`absence.quoted_here`: the three expectations that quote `pkg-config` take
# this machine's answer), and skipped only where `absence.machine_lacks` finds
# the difference is the machine's: a library neither the expectation nor the
# case's own `#~` marks make its subject, which the case binds and the machine,
# asked, lacks. The skip is kept by name.
#
# **The comparison came first before defect 246 too, and it was not enough.**
# A case whose expectation IS a missing-library message differs from a changed
# one, and the changed one still holds the words, so 21 cases read green over
# any change to their message; and nothing asked whether the machine lacked
# what the compiler said it did. A skip refused says why beside the mismatch,
# so the reader knows the compiler named a library and was not believed.
function judged_or_skipped(@r: report.Report, @skipped: i64, scratch: str, shape: Shape, item: cases.Case, expected: str, said: shell.Run)
    here = absence.quoted_here(scratch: scratch, expected: expected)

    if said.err == here
        verdict(@r, shape: shape, item: item, expected: here, said: said, refused: "")
        return
    lacks = absence.machine_lacks(scratch: scratch, path: item.source, expected: here, said: said.err)

    if !lacks.is_err()
        skipped @ skipped + 1
        report.keep_skip(@r, label: shape.name + "/" + item.name, detail: "  " + lacks.must())
        return
    verdict(@r, shape: shape, item: item, expected: here, said: said, refused: absence.refused(lacks))

# One case's questions, in the order a reader wants them: what it
# printed, whether it wrote an artifact it should not have, then how it
# ended. `refused` is why the case was not skipped, where a skip was asked.
function verdict(@r: report.Report, shape: Shape, item: cases.Case, expected: str, said: shell.Run, refused: str)
    label = shape.name + "/" + item.name
    actual: str @ said.out

    if shape.on_stderr
        actual @ said.err

    if actual != expected
        detail: str @ report.mismatch(what: item.source, expected: expected, actual: actual)

        if refused.len() > 0
            detail @ detail + "\n  not skipped for a missing library: " + refused
        report.keep_failure(@r, label: label, detail: detail)
        return

    if shape.silent_stdout && said.out.len() > 0
        report.keep_failure(
            @r,
            label: label,
            detail: "  " + item.source + " is refused, so there is no artifact — it wrote " + said.out.len().to_str() + " bytes to stdout"
        )
        return

    if said.code != shape.want_code
        report.keep_failure(
            @r,
            label: label,
            detail: "  " + item.source + " must exit " + shape.want_code.to_str() + " — it exited " + said.code.to_str()
        )
        return
    report.keep_pass(@r)

# A stand-in compiler: one shell script that says what the caller wants,
# on the stream the caller wants, and ends how the caller wants. The
# suites are tested against THIS rather than against the real binary, for
# the reason CLAUDE.md §9 gives about verifier checks — a check nobody has
# seen fail is a decoration — and because a test that needed
# ./target/debug/heroes would die the day the bootstrap is archived, which
# is the day this harness matters most.
function stub(scratch: str, name: str, says: str, on_stderr: bool, ends: i64) -> str?
    path = scratch + "/" + name
    stream: str @ ""

    if on_stderr
        stream @ " 1>&2"
    write_file(path: path, text: "#!/bin/sh\nprintf '%s' " + inside_a_script(says) + stream + "\nexit " + ends.to_str() + "\n")?
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])?

    if made.code != 0
        return fail(code: "cannot_run", msg: "cannot make " + path + " executable")
    return ok(path)

# A one-case golden tree, for the tests below.
function one_case_tree(scratch: str, name: str, expectation: str) -> str?
    tree = scratch + "/" + name
    shell.remove_tree(tree)?
    shell.mkdir_all(tree)?
    write_file(path: tree + "/x.hero", text: "function main()\n    print(1)\n")?
    write_file(path: tree + "/x.expected", text: expectation)?
    return ok(tree)

constant SAID: str
    "x.hero:1:1: error[boom]: a diagnostic\n"

test "a diagnostics suite passes on a match and fails on either half"
    # POSIX is this case's subject, and this machine answers for itself
    # (can_run_scripts carries the measurement).
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "check", expectation: SAID)
    assert !tree.is_err()
    form = Shape(
        name: "check",
        dir: tree.must(),
        verb: "check",
        flags: ["--brief"],
        on_stderr: true,
        want_code: 1,
        least: 1,
        watched: false,
        silent_stdout: false,
        library_skip: false
    )

    right = stub(scratch: scratch, name: "stub-right.sh", says: SAID, on_stderr: true, ends: 1)
    assert !right.is_err()
    green = run_all(scratch: scratch, compiler: right.must(), shape: form, only: "")
    assert !green.is_err()
    assert green.must().passed == 1
    assert green.must().failed == 0

    wrong = stub(
        scratch: scratch,
        name: "stub-wrong.sh",
        says: "x.hero:1:1: error[other]: something else\n",
        on_stderr: true,
        ends: 1
    )
    assert !wrong.is_err()
    red = run_all(scratch: scratch, compiler: wrong.must(), shape: form, only: "")
    assert !red.is_err()
    assert red.must().passed == 0
    assert red.must().failed == 1

    # The right text at exit 0 — panel 016's contract: the compiler
    # answered, but as if the program were clean.
    quiet = stub(scratch: scratch, name: "stub-exit0.sh", says: SAID, on_stderr: true, ends: 0)
    assert !quiet.is_err()
    silent = run_all(scratch: scratch, compiler: quiet.must(), shape: form, only: "")
    assert !silent.is_err()
    assert silent.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

test "an artifact suite reads stdout, and a diagnostic on stderr does not save it"
    # POSIX is this case's subject, and this machine answers for itself
    # (can_run_scripts carries the measurement).
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "ir", expectation: "fn main:\n  bb0:\n")
    assert !tree.is_err()
    form = Shape(
        name: "ir",
        dir: tree.must(),
        verb: "build",
        flags: ["--dump-ir"],
        on_stderr: false,
        want_code: 0,
        least: 1,
        watched: false,
        silent_stdout: false,
        library_skip: false
    )

    right = stub(scratch: scratch, name: "stub-dump.sh", says: "fn main:\n  bb0:\n", on_stderr: false, ends: 0)
    assert !right.is_err()
    green = run_all(scratch: scratch, compiler: right.must(), shape: form, only: "")
    assert !green.is_err()
    assert green.must().passed == 1

    # The same text on the wrong stream: an artifact suite must not read
    # it, so this is a mismatch against an empty stdout.
    misplaced = stub(scratch: scratch, name: "stub-misplaced.sh", says: "fn main:\n  bb0:\n", on_stderr: true, ends: 0)
    assert !misplaced.is_err()
    red = run_all(scratch: scratch, compiler: misplaced.must(), shape: form, only: "")
    assert !red.is_err()
    assert red.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

# Defect 211: the control arm's form is `check` with `--brief` and
# `--permissive`, in that order, after the case. The stub answers with its own
# arguments, one per line, so the form's real shape, pointed at a one-case tree,
# passes only while it asks the control arm.
test "fixedbugs: the control arm's form runs check with --brief and --permissive"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "permissive", expectation: "")
    assert !tree.is_err()
    asked = "check\n" + tree.must() + "/x.hero\n--brief\n--permissive\n"
    assert !write_file(path: tree.must() + "/x.expected", text: asked).is_err()
    path = scratch + "/stub-argv.sh"
    assert !write_file(path: path, text: "#!/bin/sh\nprintf '%s\\n' \"$@\" 1>&2\nexit 1\n").is_err()
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])
    assert !made.is_err()
    form: Shape @ shape_permissive()
    form.dir @ tree.must()
    form.least @ 1
    form.watched @ false
    got = run_all(scratch: scratch, compiler: path, shape: form, only: "")
    assert !got.is_err()
    assert got.must().passed == 1
    assert got.must().failed == 0

    # The normal arm's form, over the same case, is not asking the same thing.
    plain: Shape @ shape_check()
    plain.dir @ tree.must()
    plain.least @ 1
    plain.watched @ false
    other = run_all(scratch: scratch, compiler: path, shape: plain, only: "")
    assert !other.is_err()
    assert other.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

# Defect 289: the whole form is `check` and the case, with no other word, so
# no `--brief` cuts what is compared. The stub answers with its own arguments,
# one per line, so the form's real shape, pointed at a one-case tree, passes
# only while it asks for the whole form, and `check`'s own form does not.
test "fixedbugs: the whole form runs check with no other word (defect 289)"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "full", expectation: "")
    assert !tree.is_err()
    assert !write_file(path: tree.must() + "/x.expected", text: "check\n" + tree.must() + "/x.hero\n").is_err()
    path = scratch + "/stub-argv.sh"
    assert !write_file(path: path, text: "#!/bin/sh\nprintf '%s\\n' \"$@\" 1>&2\nexit 1\n").is_err()
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])
    assert !made.is_err()
    form: Shape @ shape_full()
    form.dir @ tree.must()
    form.least @ 1
    form.watched @ false
    got = run_all(scratch: scratch, compiler: path, shape: form, only: "")
    assert !got.is_err()
    assert got.must().passed == 1
    assert got.must().failed == 0
    brief: Shape @ shape_check()
    brief.dir @ tree.must()
    brief.least @ 1
    brief.watched @ false
    other = run_all(scratch: scratch, compiler: path, shape: brief, only: "")
    assert !other.is_err()
    assert other.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 317 at the forms (2026-10-04): a compiler that writes bytes that are
# not UTF-8 on stderr RAN, and its case fails in the refusal's words, naming
# the byte, where it said *cannot run the compiler on*.
test "fixedbugs: a compiler that writes bytes that are not UTF-8 is told as one that ran (defect 317)"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "not-text-317", expectation: SAID)
    assert !tree.is_err()
    path = scratch + "/stub-latin.sh"
    assert !write_file(path: path, text: "#!/bin/sh\nprintf 'x.hero:1:1: error[boom]: caf\\351\\n' 1>&2\nexit 1\n").is_err()
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])
    assert !made.is_err()
    form: Shape @ shape_check()
    form.dir @ tree.must()
    form.least @ 1
    form.watched @ false
    got = run_all(scratch: scratch, compiler: path, shape: form, only: "")
    assert !got.is_err()
    assert got.must().failed == 1
    failure = got.must().failures[0]
    assert strings.contains(text: failure, needle: tree.must() + "/x.hero: " + path + " ran and exited 1")
    assert strings.contains(text: failure, needle: "on stderr 1 byte is not, in `x.hero:1:1: error[boom]: caf<0xE9>`")
    assert !strings.contains(text: failure, needle: "cannot run")
    assert !shell.remove_tree(scratch).is_err()

test "a refusal that writes an artifact fails, and so does a suite below its floor"
    # POSIX is this case's subject, and this machine answers for itself
    # (can_run_scripts carries the measurement).
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = one_case_tree(scratch: scratch, name: "unsupported", expectation: SAID)
    assert !tree.is_err()
    refuse = Shape(
        name: "unsupported",
        dir: tree.must(),
        verb: "build",
        flags: NO_FLAGS,
        on_stderr: true,
        want_code: 1,
        least: 1,
        watched: false,
        silent_stdout: true,
        library_skip: true
    )

    # Says the right refusal on stderr, exits 1 — and leaves a byte on
    # stdout, which means it half-built something.
    path = scratch + "/stub-leaky.sh"
    assert !write_file(path: path, text: "#!/bin/sh\nprintf '%s' " + inside_a_script(SAID) + " 1>&2\nprintf 'x'\nexit 1\n").is_err()
    made = shell.run(scratch: scratch, program: "chmod", words: ["chmod", "+x", path])
    assert !made.is_err()
    leaky = run_all(scratch: scratch, compiler: path, shape: refuse, only: "")
    assert !leaky.is_err()
    assert leaky.must().failed == 1

    # The floor: the same one-case tree, told to expect two.
    floored = Shape(
        name: "unsupported",
        dir: tree.must(),
        verb: "build",
        flags: NO_FLAGS,
        on_stderr: true,
        want_code: 1,
        least: 2,
        watched: false,
        silent_stdout: true,
        library_skip: true
    )
    right = stub(scratch: scratch, name: "stub-refuse.sh", says: SAID, on_stderr: true, ends: 1)
    assert !right.is_err()
    short = run_all(scratch: scratch, compiler: right.must(), shape: floored, only: "")
    assert !short.is_err()
    assert short.must().passed == 1
    assert short.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

test "a machine missing the library skips, but a machine missing every library fails"
    # POSIX is this case's subject, and this machine answers for itself
    # (can_run_scripts carries the measurement).
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = fresh_tree(scratch: scratch, name: "skipping")
    assert !tree.is_err()

    # Until defect 246 this stub said `error[ffi_package]: pkg-config does not
    # know raylib`, a sentence no compiler writes, for a case that binds
    # nothing, and the words alone made it a skip. A skip now needs a library
    # the case binds and the machine lacks: a header no machine has.
    missing = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: " — clang looked and did not find it",
        at: "x.hero:1:1"
    )
    assert !planted(tree: tree.must(), name: "x", source: binding(absence.NOWHERE), expected: SAID, said: missing).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(tree.must()), only: "")
    assert !got.is_err()

    # One case, one skip: that is 100% skipped, which the floor refuses, and
    # the skip is named all the same.
    assert got.must().passed == 0
    assert got.must().failed == 1
    assert got.must().skips.len() == 1
    assert strings.contains(text: got.must().failures[0], needle: "not testing the refusals")
    assert !shell.remove_tree(scratch).is_err()

# DEFECT 246's reproducer, held as a test (2026-10-04). A case whose expectation
# IS a missing-library message was counted as skipped when its message changed,
# since the changed text still held the words: `unsupported` read `136 passed,
# 0 failed` over one such change on the real tree. Each case below changes one
# part of such a message and must FAIL, never skip: the header's own words, a
# header reached through another, a package's note, the expected message with
# a second one beside it; and, where only the PLACE says the message is the
# case's subject, a header misnamed where the case pins one (defect 232's
# class), an expectation whose words are past reading, and a mark of the case's
# own where its expectation lost the code.
test "fixedbugs: a changed missing-library message fails, and is never skipped"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = fresh_tree(scratch: scratch, name: "changed")
    assert !tree.is_err()
    dir = tree.must()
    direct = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: " — clang looked and did not find it",
        at: "x.hero:1:1"
    )
    reworded = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: " — clang looked and found nothing",
        at: "x.hero:1:1"
    )
    assert !planted(tree: dir, name: "a-words", source: binding(absence.NOWHERE), expected: direct, said: reworded).is_err()
    outer = ", and `heroes-golden-outer.h`, the header this group names, includes it"
    through = absence.missing_header_said(header: absence.NOWHERE, tail: outer + " at line 1", at: "x.hero:1:1")
    moved = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: outer + " through `heroes-golden-mid.h`",
        at: "x.hero:1:1"
    )
    assert !planted(tree: dir, name: "b-through", source: binding("heroes-golden-outer.h"), expected: through, said: moved).is_err()
    package = "error[ffi_package]: the package `heroes-golden-gone` is not installed on this machine\n  at x.hero:1:26\n"
    told = package + "  note: install its development files, or name the library directly with `link`\n"
    retold = package + "  note: install it\n"
    asking = "extern \"stdio.h\" package \"heroes-golden-gone\"\n    function seven() -> i32\n"
    assert !planted(tree: dir, name: "c-package", source: asking, expected: told, said: retold).is_err()
    second = direct + "error[unused_binding]: a second message nobody expected\n  at x.hero:5:5\n"
    assert !planted(tree: dir, name: "d-padded", source: binding(absence.NOWHERE), expected: direct, said: second).is_err()

    # The case's group reaches the header named, and no machine has the cut
    # name either, so only the place keeps this from reading as the machine's.
    spot = dir + "/e-misnamed.hero:1:1"
    pinned_here = absence.missing_header_said(header: absence.NOWHERE, tail: outer + " at line 1", at: spot)
    cut = absence.missing_header_said(header: "heroes-golden-a-header", tail: outer + " at line 1", at: spot)
    assert !planted(tree: dir, name: "e-misnamed", source: binding("heroes-golden-outer.h"), expected: pinned_here, said: cut).is_err()
    told_at = "error[ffi_package]: the package `heroes-golden-gone` is not installed on this machine\n  at " + dir + "/f-unread.hero:1:26\n"
    unread = "error[ffi_package]: the package `heroes-golden-gone` is not on this machine at all\n  at " + dir + "/f-unread.hero:1:26\n"
    assert !planted(tree: dir, name: "f-unread", source: asking, expected: unread, said: told_at).is_err()
    marked = "extern \"stdio.h\" package \"heroes-golden-gone\"  #~ ffi_package\n    function seven() -> i32\n"
    lost = "error[ffi_pakage]: the package `heroes-golden-gone` is not installed on this machine\n  at " + dir + "/g-marked.hero:1:26\n"
    told_marked = "error[ffi_package]: the package `heroes-golden-gone` is not installed on this machine\n  at " + dir + "/g-marked.hero:1:26\n"
    assert !planted(tree: dir, name: "g-marked", source: marked, expected: lost, said: told_marked).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(dir), only: "")
    assert !got.is_err()
    assert got.must().passed == 0
    assert got.must().failed == 7
    assert got.must().skips.len() == 0

    # And each failure says why the compiler's word was not taken.
    for failure in got.must().failures
        assert strings.contains(
            text: failure,
            needle: "not skipped for a missing library: the expectation names the same missing library"
        )

    assert !shell.remove_tree(scratch).is_err()

test "a library the case binds and this machine lacks is skipped by name, among cases judged"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = fresh_tree(scratch: scratch, name: "lacking")
    assert !tree.is_err()
    dir = tree.must()

    for name in ["a", "b", "c"]
        assert !planted(tree: dir, name: name, source: binding("stdio.h"), expected: REFUSED, said: REFUSED).is_err()

    missing = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: " — clang looked and did not find it",
        at: "x.hero:1:1"
    )
    assert !planted(tree: dir, name: "d", source: binding(absence.NOWHERE), expected: REFUSED, said: missing).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(dir), only: "")
    assert !got.is_err()

    # One skip in four is under the floor's third, so the run is green and
    # the skip is a line of its own, naming the case and clang's answer.
    assert got.must().passed == 3
    assert got.must().failed == 0
    assert got.must().skips.len() == 1
    assert strings.starts_with(text: got.must().skips[0], prefix: "SKIP unsupported/d\n")
    assert strings.contains(text: got.must().skips[0], needle: "which clang does not find")
    assert !shell.remove_tree(scratch).is_err()

test "a library said to be missing is judged where the machine has it, or the case binds none"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = fresh_tree(scratch: scratch, name: "refuted")
    assert !tree.is_err()
    dir = tree.must()

    # `stdio.h` is on every machine this compiler builds on, so clang finds it
    # and the compiler's word is refuted.
    has = absence.missing_header_said(header: "stdio.h", tail: " — clang looked and did not find it", at: "x.hero:1:1")
    assert !planted(tree: dir, name: "a-has", source: binding("stdio.h"), expected: REFUSED, said: has).is_err()

    # A header missing everywhere, but one no group of this case names.
    elsewhere = absence.missing_header_said(
        header: absence.NOWHERE,
        tail: " — clang looked and did not find it",
        at: "x.hero:1:1"
    )
    assert !planted(tree: dir, name: "b-unbound", source: binding("stdio.h"), expected: REFUSED, said: elsewhere).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(dir), only: "")
    assert !got.is_err()
    assert got.must().passed == 0
    assert got.must().failed == 2
    assert got.must().skips.len() == 0
    assert strings.contains(text: got.must().failures[0], needle: "clang finds `stdio.h`")
    assert strings.contains(text: got.must().failures[1], needle: "binds no such header")
    assert !shell.remove_tree(scratch).is_err()

test "a pkg-config said to be missing is believed only where it does not start"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    tree = fresh_tree(scratch: scratch, name: "tool")
    assert !tree.is_err()
    asking = "extern \"stdio.h\" package \"heroes-golden-gone\"\n    function seven() -> i32\n"
    absent = "pkg-config is not on this machine, and `package \"heroes-golden-gone\"` asks it where the library is\n"
    assert !planted(tree: tree.must(), name: "x", source: asking, expected: REFUSED, said: absent).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(tree.must()), only: "")
    assert !got.is_err()
    here = shell.attempted(scratch: scratch, program: "pkg-config", words: ["pkg-config", "--version"])
    assert !here.is_err()

    # Each branch is this machine's fact: where `pkg-config` runs, the word is
    # refuted and the case judged; where it does not, the case is skipped by
    # name, and as the only case it is refused by the floor.
    if here.must().started
        assert got.must().failed == 1
        assert got.must().skips.len() == 0
        assert strings.contains(text: got.must().failures[0], needle: "`pkg-config` runs on this machine")
    else
        assert got.must().skips.len() == 1
        assert got.must().failed == 1
    assert !shell.remove_tree(scratch).is_err()

test "an expectation quoting pkg-config is judged on this machine's answer, and the compiler's own lines still are"
    if !shell.can_run_scripts()
        return
    scratch = shell.own_scratch()
    package = "heroes-golden-gone"
    notes = absence.quotation(scratch: scratch, package: package)

    # No `pkg-config` here, or an answer the rebuild refuses: then the
    # expectation is judged as written, which the tests above already hold.
    if notes.is_err()
        assert !shell.remove_tree(scratch).is_err()
        return
    head = "error[ffi_package]: the package `" + package + "` is not installed on this machine\n"
    last = "  note: install its development files, or name the library directly with `link`\n"
    quoted = notes.must().join("\n") + "\n" + last
    foreign = head + "  at x.hero:1:26\n  note: pkg-config said: Package " + package + " was not found, in another machine's words\n" + last
    tree = fresh_tree(scratch: scratch, name: "quoted")
    assert !tree.is_err()
    dir = tree.must()
    asking = "extern \"stdio.h\" package \"" + package + "\"\n    function seven() -> i32\n"
    assert !planted(tree: dir, name: "a-same", source: asking, expected: foreign, said: head + "  at x.hero:1:26\n" + quoted).is_err()

    # The quotation is this machine's; the place the compiler names is its own.
    assert !planted(tree: dir, name: "b-moved", source: asking, expected: foreign, said: head + "  at x.hero:1:27\n" + quoted).is_err()
    compiler = absence.said_stub(scratch)
    assert !compiler.is_err()
    got = run_all(scratch: scratch, compiler: compiler.must(), shape: refusing(dir), only: "")
    assert !got.is_err()
    assert got.must().passed == 1
    assert got.must().failed == 1
    assert got.must().skips.len() == 0
    assert strings.contains(text: got.must().failures[0], needle: "unsupported/b-moved")
    assert !shell.remove_tree(scratch).is_err()

# An empty golden tree under `scratch`.
function fresh_tree(scratch: str, name: str) -> str?
    tree = scratch + "/" + name
    shell.remove_tree(tree)?
    shell.mkdir_all(tree)?
    return ok(tree)

# One case planted in `tree`: its source, its expectation, and what
# `absence.said_stub` answers for it. `.said` is no extension `cases.collect` reads.
function planted(tree: str, name: str, source: str, expected: str, said: str) -> ()?
    write_file(path: tree + "/" + name + ".hero", text: source)?
    write_file(path: tree + "/" + name + ".expected", text: expected)?
    write_file(path: tree + "/" + name + ".said", text: said)?
    return ok()

# The `unsupported` form over a test tree, floored at one.
function refusing(dir: str) -> Shape
    return Shape(
        name: "unsupported",
        dir: dir,
        verb: "build",
        flags: NO_FLAGS,
        on_stderr: true,
        want_code: 1,
        least: 1,
        watched: false,
        silent_stdout: true,
        library_skip: true
    )

# A case's source: one group binding `header`.
function binding(header: str) -> str
    return "extern \"" + header + "\"\n    function seven() -> i32\n\nfunction main()\n    print(seven())\n"

# A refusal that names no missing library: what a case expects where the
# machine has everything it binds.
constant REFUSED: str
    "error[ffi_return_type]: the header says `seven` returns `long`, and this group says `i32`\n  at x.hero:2:5\n"

# Quoting for the CONTENT of a shell script this test writes, which is
# not the same job `shell.sq` had. That one wrapped a filename on its way
# to a command line the harness was composing; this wraps a word inside a
# file that a shell will read later, on its own. The harness composes no
# command lines any more, so the function went with them — but a script
# is still a script, and its text still has to be well formed.
function inside_a_script(text: str) -> str
    out: str @ "'"

    for ch in text.chars()
        if ch == "'"
            out @ out + "'\\''"
        else
            out @ out + ch

    return out + "'"
