# The command surface: what a user types, and what comes back.
#
# Port of the table-shaped half of archive/bootstrap-rs/heroes-cli/tests/surface.rs (69
# tests, 2,139 lines). Panel 085 measured what the archive would leave of
# it: 17 in-process successors that "test functions rather than the
# binary — `cli_argv.parse(...)` returning a value is not `heroes check
# x.hero --brief` exiting 1 with that stderr". This module types.
#
# Three groups here, each a table of `probe.Probe` rows:
#   argv     the three exit codes, the streams, strictness, the stops
#   help     what `--help` must say
#   render   the four ways a diagnostic can be printed, and `--apply`
#
# The rest of surface.rs lands beside it: the FFI fixtures, the module
# fixtures, `mutate`, `test`, and the handful that cannot be a row at all
# because they run a second process, change the child's directory, or
# compare two invocations against each other.
#
# EVERY PATH IS RELATIVE TO THE REPOSITORY ROOT, because the compiler
# echoes the path it was given and an expectation must not also record
# which directory ran the harness.

use probe
use report
use strings
use shell

# The chain that builds a row. It lives here rather than beside the record
# because UFCS does not cross a module boundary (measured: `box.make(1)
# .plus(2)` is error[needs_qualifying] on both compilers), and a table
# written as nested calls is a table nobody proof-reads.
function row(name: str, argv: str, code: i64) -> probe.Probe
    return probe.probe(name: name, argv: argv, code: code)

function out_has(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_has @ p.out_has.push(needle)
    return out

function out_lacks(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_lacks @ p.out_lacks.push(needle)
    return out

function err_has(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_has @ p.err_has.push(needle)
    return out

function err_lacks(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_lacks @ p.err_lacks.push(needle)
    return out

function out_starts(p: probe.Probe, prefix: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_starts @ prefix
    return out

function err_starts(p: probe.Probe, prefix: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_starts @ prefix
    return out

function out_is(p: probe.Probe, text: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_is @ text
    return out

function err_is(p: probe.Probe, text: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_is @ text
    return out

function out_empty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.out_state @ "empty"
    return out

function out_nonempty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.out_state @ "nonempty"
    return out

function err_empty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.err_state @ "empty"
    return out

function err_nonempty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.err_state @ "nonempty"
    return out

function err_lines(p: probe.Probe, count: i64) -> probe.Probe
    out: probe.Probe @ p
    out.err_lines @ count
    return out

function out_lines_max(p: probe.Probe, count: i64) -> probe.Probe
    out: probe.Probe @ p
    out.out_lines_max @ count
    return out

# Green where this machine lacks the C library the case binds — the same
# rule every other suite carries, and floored by the caller.
function may_skip(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.library_skip @ true
    return out

function run_all(scratch: str, compiler: str) -> report.Report?
    r: report.Report @ report.empty()
    probe.run_table(scratch: scratch, compiler: compiler, probes: argv_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: help_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: render_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: ffi_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: verb_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: bracket_probes(), r: @r)
    in_place_cases(scratch: scratch, compiler: compiler, r: @r)
    return ok(r)

# **A VERB THAT REWRITES THE AUTHOR'S FILE AND CANNOT FINISH LEAVES IT BYTE
# FOR BYTE** (defect 136), which no row can hold: the case makes its own file
# and makes the write fail. It fails the way a full disk does, a ceiling on
# what the child may write (`shell.run_limited`) below the new text and above
# the message. Measured before the repair on a 2 MB disk image: `fmt
# --in-place` left the program at 0 bytes and `check --apply --in-place` cut
# it mid-token, both at exit 2; under this ceiling the same compiler cuts the
# file at the ceiling. Windows keeps no such ceiling, so there the two cases
# do not run and are not counted, and the compiler's own tests hold the
# refusals every platform can make.
function in_place_cases(scratch: str, compiler: str, @r: report.Report)
    if !shell.can_limit_writes()
        return
    in_place_case(@r, scratch: scratch, compiler: compiler, verb: "fmt", flags: ["--in-place"], text: unformatted())
    in_place_case(
        @r,
        scratch: scratch,
        compiler: compiler,
        verb: "check",
        flags: ["--apply", "--in-place"],
        text: fn_swaps()
    )

# Below what either verb writes and above what it says: `fmt` writes 1,746
# bytes and `check --apply` 2,232 (measured 2026-09-30), and the message
# that says the file is untouched fits under it.
constant IN_PLACE_CEILING: i64
    1024

function in_place_case(@r: report.Report, scratch: str, compiler: str, verb: str, flags: [str], text: str)
    label = "surface/" + verb + " " + flags.join(" ") + " under a full disk leaves the author's file byte for byte (defect 136)"
    dir = scratch + "/in-place-" + verb
    path = dir + "/p.hero"
    _ = shell.remove_tree(dir).is_err()

    if shell.mkdir_all(dir).is_err() || write_file(path: path, text: text).is_err()
        report.keep_failure(@r, label: label, detail: "  cannot make " + path)
        return
    words: [str] @ [compiler, verb, path]

    for flag in flags
        words @ words.push(flag)

    ran = shell.run_limited(scratch: scratch, program: compiler, words: words, bytes: IN_PLACE_CEILING)
    after = read_file(path).default("(unreadable)")
    left = shell.list_entries(scratch: scratch, dir: dir).default([])

    if ran.is_err()
        report.keep_failure(@r, label: label, detail: "  " + shell.refusal(ran))
        return
    said = ran.must()
    wrong: [str] @ []

    if said.code != 2
        wrong @ wrong.push("  exit " + said.code.to_str() + ", where a write that failed is 2")

    if !strings.contains(text: said.err, needle: path + " is untouched")
        wrong @ wrong.push("  stderr does not say the file is untouched: " + said.err)

    if after != text
        wrong @ wrong.push(report.mismatch(what: path + " afterwards", expected: text, actual: after))

    if left != [path]
        wrong @ wrong.push("  beside it: " + left.join(", "))

    if wrong.len() > 0
        report.keep_failure(@r, label: label, detail: wrong.join("\n"))
        return
    report.keep_pass(@r)

# A program of 1,266 bytes `fmt` rewrites into 1,746: eighty `vN=N+N*2`
# lines.
function unformatted() -> str
    lines: [str] @ ["function main()"]

    for n in range(from: 0, to: 80)
        lines @ lines.push("    v" + n.to_str() + "=" + n.to_str() + "+" + n.to_str() + "*2")

    return lines.join("\n") + "\n"

# A program of 1,872 bytes `check --apply` rewrites into 2,232: sixty `fn` heads,
# each with the certain swap to `function`.
function fn_swaps() -> str
    parts: [str] @ []

    for n in range(from: 0, to: 60)
        parts @ parts.push("fn f" + n.to_str() + "() -> i64\n    return " + n.to_str() + "\n")

    return parts.join("\n") + "\nfunction main()\n    print(f0())\n"

# **The three exit codes mean three different things** (panel 016): 0 the
# input is clean, 1 the input has diagnostics, 2 the tool could not run.
# The whole contract is falsifiable in five invocations.
function argv_probes() -> [probe.Probe]
    return [
        row(name: "a clean file exits 0", argv: "check examples/gallery/01-points.hero", code: 0)
        row(name: "a file with diagnostics exits 1", argv: "check tests/golden/check/shadowing.hero", code: 1)
        row(name: "a file that is not there exits 2", argv: "check no/such/file.hero", code: 2)
        row(name: "an unknown flag exits 2", argv: "check --nonsense examples/gallery/00-first.hero", code: 2)
        row(name: "an unknown command exits 2", argv: "frobnicate", code: 2)
        row(name: "a dump is the artifact", argv: "parse examples/gallery/00-first.hero --dump-ast", code: 0).out_nonempty().err_empty()
        row(name: "a diagnostic is not an artifact", argv: "check tests/golden/check/shadowing.hero", code: 1).out_empty().err_nonempty()
        row(name: "an unknown flag names what is accepted", argv: "check --dump-ast examples/gallery/00-first.hero", code: 2).err_starts("error: `check` does not accept `--dump-ast` — it accepts --dump-scopes")
        row(name: "a verb with no flags says so", argv: "doctor --json", code: 2).err_has("takes no flags")
        row(name: "a retired flag names its replacement", argv: "fmt --write examples/gallery/00-first.hero", code: 2).err_is("error: `--write` is no longer a flag of `fmt` — use `--in-place`\n")
        row(name: "the refused --no-line names what to do instead", argv: "build examples/gallery/00-first.hero --no-line", code: 2).err_has("no longer a flag").err_has("--emit-c")
        row(name: "a stage is silent unless asked", argv: "lex examples/gallery/00-first.hero", code: 0).out_empty()
        row(name: "a dump prints the tokens", argv: "lex examples/gallery/00-first.hero --dump-tokens", code: 0).out_has("ident main")
        row(name: "json changes how, not what", argv: "lex examples/gallery/00-first.hero --dump-tokens --json", code: 0).out_starts("[\n").out_has("\"kind\"")
        row(name: "json alone selects no output", argv: "lex examples/gallery/00-first.hero --json", code: 0).out_empty()
        row(name: "json writes a tab inside a token as an escape and never raw, so the output is JSON (defect 102; in a comment since panel 192)", argv: "lex tests/golden/surface-fixtures/json102/tab.hero --dump-tokens --json", code: 0).out_has("a\\tb").out_lacks("\t")
        row(name: "and a control byte by its code, where it arrives inside an error token", argv: "lex tests/golden/surface-fixtures/json102/control.hero --dump-tokens --json", code: 1).out_has("\\u0001")
        row(name: "a control byte the language refuses is named by its code in check's JSON, where the byte went raw", argv: "check tests/golden/surface-fixtures/json102/control.hero --json", code: 1).err_has("\"message\": \"the control character U+0001 is not part of the language's syntax\"")
        row(name: "a character a terminal shows as nothing, or that reorders the line, is named by its code alone, and one that can be seen is shown and named", argv: "check tests/golden/surface-fixtures/json102/unseen.hero", code: 1).err_has("the invisible character U+202E is not").err_has("the invisible character U+200B is not").err_has("`€` (U+20AC) is not")
        row(name: "and the token dump writes those two by their code as well, and the one that can be seen as itself (defect 291)", argv: "lex tests/golden/surface-fixtures/json102/unseen.hero --dump-tokens", code: 1).out_has("2:11 error <U+202E>\n").out_has("3:11 error <U+200B>\n").out_has("4:11 error €\n").out_lacks("\u{202e}")
        row(name: "a missing operand shows the shape", argv: "check", code: 2).err_is("error: `check` needs a file: `heroes check <file.hero>`\n")
        row(name: "two files are refused", argv: "check a.hero b.hero", code: 2).err_has("takes one file")
        row(name: "-o needs a path", argv: "build examples/gallery/00-first.hero -o", code: 2).err_has("needs a path")
        row(name: "two stops are refused", argv: "build examples/gallery/00-first.hero --dump-ir --emit-c", code: 2).err_has("one artifact at a time")
        row(name: "run passes arguments after --", argv: "run tests/golden/run/edges-file-args-exit.hero -- alpha beta", code: 0).out_has("arguments: 2")
        row(name: "only run takes program arguments", argv: "check examples/gallery/00-first.hero -- x", code: 2).err_has("only `heroes run` does")
        row(name: "build takes -O2", argv: "build examples/gallery/00-first.hero -O2", code: 0)
        row(name: "build takes -O0", argv: "build examples/gallery/00-first.hero -O0", code: 0)
        row(name: "run takes -O0", argv: "run examples/gallery/00-first.hero -O0", code: 0)
        row(name: "two levels are refused", argv: "build examples/gallery/00-first.hero -O0 -O2", code: 2).err_has("one level at a time")
        row(name: "an unknown level names the two", argv: "build examples/gallery/00-first.hero -O1", code: 2).err_has("-O0, -O2")
    ]

# The artifact on stdout, diagnostics on stderr — §10's contract,
# asked of both halves at once.

# An unknown flag names what the command DOES accept, which is the
# difference between a refusal and a dead end.

# A retired flag names its replacement rather than reporting that
# it is unknown: the user typed something that USED to work.

# A stage prints only when asked: `lex` alone is a check, not a
# dump. `--json` says HOW to print and never WHAT (§10).

# A missing or doubled operand is named with the shape that works.

# Arguments reach the program, and only through `run`.

# The optimisation level is a flag with the verb's default, and
# two of them at once is a refusal rather than a last-wins.

# The help text is the surface's only documentation, so what it must
# carry is asserted rather than reviewed.
function help_probes() -> [probe.Probe]
    return [
        row(name: "help states the exit codes and the streams", argv: "--help", code: 0).out_has("1 diagnostics were reported, no artifact was produced").out_has("2 the tool could not run.").out_has("HEROES_RUNTIME").out_has("streams: the artifact on stdout")
        row(name: "every flag in the table is documented", argv: "--help", code: 0).out_has("--dump-tokens").out_has("--json").out_has("--dump-ast").out_has("--dump-scopes").out_has("--in-place")
        row(name: "measure states its default", argv: "--help", code: 0).out_has("(default: spec/heroes-spec.md)")
        row(name: "measure runs with no operand", argv: "measure", code: 0)
        row(name: "probe states its default and names its two flags' values", argv: "--help", code: 0).out_has("  probe [file]\n").out_has("(default: the formatter's fixture directories)").out_has("--family <name>").out_has("--stride <count>")
    ]

# Four ways one diagnostic is printed — rich, brief, json, applied — and
# the hole report, which is an ARTIFACT and goes to stdout at exit 0.
function render_probes() -> [probe.Probe]
    return [
        row(name: "the rich form carries the line, the caret and the other end", argv: "check tests/golden/check/certain-labels.hero", code: 1).err_starts("error[wrong_label]: `Point` has nothing called `z` at this position — it is `y`\n").err_has("  at tests/golden/check/certain-labels.hero:10:21").err_has("    a = Point(x: 1, z: 2)").err_has("^").err_has("fix (certain): write `y:`")
        row(name: "brief is one line per diagnostic", argv: "check tests/golden/check/certain-labels.hero --brief", code: 1).err_lines(3).err_starts("tests/golden/check/certain-labels.hero:")
        row(name: "json is versioned and carries the fixes", argv: "check tests/golden/check/certain-labels.hero --json", code: 1).err_starts("{\n  \"schema\": 2,\n  \"kind\": \"diagnostics\",\n").err_has("\"code\": \"wrong_label\"").err_has("\"certainty\": \"certain\"").err_has("\n      \"line\": 10,\n")
        row(name: "a certain fix says where it applies and what --apply's first round does with it: the enclosing one withheld, the one inside written (defect 271, panel 193)", argv: "check tests/golden/surface-fixtures/certain137-inside/main.hero --json", code: 1).err_has("\"line\": 25, \"col\": 11, \"end_line\": 25, \"end_col\": 34, \"byte_start\": 726, \"byte_end\": 749, \"text\": \"total(xs.must()).must()\", \"first_round\": \"withheld\"").err_has("\"byte_start\": 732, \"byte_end\": 741, \"text\": \"xs.must()\", \"first_round\": \"written\"").err_has("\"byte_start\": 825, \"byte_end\": 825, \"text\": \"\", \"first_round\": \"written\"")
        row(name: "a certain fix in another module is placed in that module's own bytes, and --apply's first round leaves it elsewhere", argv: "check tests/golden/surface-fixtures/applyx/main.hero --json", code: 1).err_has("\"file\": \"tests/golden/surface-fixtures/applyx/geom.hero\", \"line\": 3, \"col\": 12, \"end_line\": 3, \"end_col\": 17, \"byte_start\": 66, \"byte_end\": 71, \"text\": \"total\", \"first_round\": \"elsewhere\"")
        row(name: "a guess carries its place, for showing, and no first round", argv: "check tests/golden/check/a-label-that-names-another-position-of-a-function-value.hero --json", code: 1).err_has("\"certainty\": \"guess\", \"file\": \"tests/golden/check/a-label-that-names-another-position-of-a-function-value.hero\", \"line\": 19, \"col\": 16, \"end_line\": 19, \"end_col\": 18, \"byte_start\": 994, \"byte_end\": 996, \"text\": \"to\"}")
        row(name: "a message at a CRLF line's end is placed in JSON where the LF file places it (defect 373)", argv: "check tests/golden/check/fixedbugs-373-a-message-at-a-crlf-line-end-is-told-at-the-line-s-end.hero --json", code: 1).err_has("\"line\": 16,\n      \"col\": 8,\n").err_has("\"line\": 17,\n      \"col\": 36,\n")
        row(name: "the thesis rules fire by default", argv: "check tests/golden/check/unused-bindings.hero --brief", code: 1).err_lines(4)
        row(name: "permissive drops them", argv: "check tests/golden/check/unused-bindings.hero --brief --permissive", code: 0).err_empty()
        row(name: "permissive keeps the rest", argv: "check tests/golden/check/unknown-type.hero --brief --permissive", code: 1)
        row(name: "apply repairs with certain fixes only", argv: "check tests/golden/check/certain-fixes.hero --apply", code: 0).out_has("print(total)").out_has("for _ in range(from: 0, to: 3)").out_has(".num _ => 1").out_lacks("The Heroes library")
        row(name: "apply reaches a mutation", argv: "check tests/golden/check/not-mutable.hero --apply", code: 0).out_has("    x @ 2")
        row(name: "a hole is an artifact at exit 0", argv: "check examples/gallery/09-holes.hero", code: 0).out_has("hole at examples/gallery/09-holes.hero:").out_has("this function returns: Entry").out_has("expected type: str").out_has("in scope:").out_has("entries: [Entry]")
    ]

# `--permissive` drops the diagnostics that exist for the thesis
# and keeps the rest — the control arm of Part 11's measurement,
# asserted on both sides so it cannot quietly become "drop
# everything".

# `--apply` writes the repaired program to stdout, certain fixes
# only, and never the library it did not read.

# A hole is not an error: the compiler reports what belongs there,
# on stdout, and the exit code stays 0.

# **A verdict about the author's `extern` is exit 1 on the `.hero` line,
# never exit 2 on the compiler** (CLAUDE.md §7, panel 036 as widened by
# 048). Every row below asserts three things at once: the code, the words
# that make the diagnostic actionable, and — the half that is easy to
# forget — that clang's own vocabulary did NOT leak. `internal error`,
# `_Static_assert`, `_Generic`, `hero_ffi_probe` and a `build/` path are
# what the reader must never see, because each one sends them to a file
# they did not write.
#
# The two `ffi-pointee-void` / `ffi-pointee-opaque` rows are defect 010 and
# its adjacent shape (2026-09-04): a sized `@` against a pointee that has no
# size — `void`, or a struct the header leaves incomplete — used to be the
# compiler's exit 2. The `void` witness (`memcpy`, C89) carries every leg;
# the opaque one carries its own header beside it, so no leg skips it.
function ffi_probes() -> [probe.Probe]
    return [
        row(name: "a freer that cannot free a string is refused at the MARK, not at the declaration (panel 116)", argv: "build tests/golden/fixedbugs/ffi-a-freer-that-cannot-free-a-string.hero", code: 1).may_skip().err_has("error[ffi_freer_type]").err_has("`fclose` cannot free a string").err_has("owned fclose").err_lacks("function fclose(f: ptr)").err_lacks("internal error").err_lacks("hero_ffi_probe")
        row(name: "a parameter wider than the header is the author's error", argv: "build tests/golden/fixedbugs/ffi-parameter-width.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`c` of `putchar`").err_has("`int`").err_has("Declare it `i32`").err_lacks("internal error").err_lacks("hero_ffi_probe").err_lacks("build/")
        row(name: "a field the header has as an array is the author's error", argv: "build tests/golden/fixedbugs/ffi-a-field-the-header-has-as-an-array.hero", code: 1).may_skip().err_has("error[ffi_field_type]").err_has("`Dirent.d_name`").err_lacks("internal error")
        row(name: "a word-width parameter names the platform", argv: "build tests/golden/fixedbugs/ffi-word-width.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`size` of `malloc`").err_has("`offset` of `fseek`").err_has("the platform's word").err_has("Windows").err_lacks("internal error").err_lacks("hero_ffi_probe")
        row(name: "a sized @ against a void pointee is the author's error, and the repair is ptr", argv: "build tests/golden/fixedbugs/ffi-pointee-void.hero", code: 1).err_has("error[ffi_parameter_type]").err_has("`dst` of `memcpy`").err_has("`void`").err_has("dst: ptr").err_lacks("internal error").err_lacks("invalid operands").err_lacks("build/")
        row(name: "a sized @ against an opaque struct is the author's error, found from the type clang names", argv: "build tests/golden/fixedbugs/ffi-pointee-opaque.hero", code: 1).err_has("error[ffi_parameter_type]").err_has("`out` of `fill`").err_has("`struct opaque`").err_has("out: ptr").err_lacks("internal error").err_lacks("incomplete type 'struct opaque'\n").err_lacks("build/")
        row(name: "a lend C would write through, from a `=` binding, is the author's error at the LEND (panel 166, defect 065)", argv: "build tests/golden/fixedbugs/ffi-a-lent-field-c-would-write.hero", code: 1).err_has("error[field_lend_written]").err_has("`t.nsap.ptr()` lends a field of `t` to `slot_fill`").err_has("`void *`").err_has("`t` is not a `@` name").err_has("would-write.hero:33:18").err_lacks("internal error").err_lacks("discards qualifiers").err_lacks("build/")
        row(name: "an extent past the field is the author's error at the NUMBER, on a partial record too (panel 166, defect 063)", argv: "build tests/golden/fixedbugs/ffi-a-lent-field-extent-overstated.hero", code: 1).err_has("error[field_lend_extent]").err_has("lends a field of 8 bytes, and `n` states 64").err_has("states 4096").err_has("states 24").err_has("state the field's own length, 8").err_lacks("internal error").err_lacks("static assertion").err_lacks("build/")
        row(name: "a cstr that cannot be used says what turns it into a str", argv: "check tests/golden/check/ffi-cstr-has-a-route.hero", code: 1).err_has("error[bad_operand]").err_has("validated").err_has("null_cstr").err_has("not_text")
        row(name: "a wrong extern return type is the author's error", argv: "build tests/golden/fixedbugs/ffi-return-type.hero", code: 1).err_has("error[ffi_return_type]").err_has("returns `double` in `math.h`, not `i64`").err_lacks("internal error").err_lacks("_Static_assert").err_lacks("_Generic")
        row(name: "a wrong pointer return is a diagnostic", argv: "build tests/golden/fixedbugs/ffi-pointer-return.hero", code: 1).err_has("error[ffi_return_type]").err_has("getenv").err_has("stdlib.h").err_lacks("internal error").err_lacks("unary expression").err_lacks("_Generic")
        row(name: "a wrong extern constant type is the author's error", argv: "build tests/golden/fixedbugs/ffi-constant-type.hero", code: 1).err_has("error[ffi_constant_type]").err_has("`M_PI` is `double` in `math.h`, not `i64`").err_lacks("does not return").err_lacks("internal error").err_lacks("_Static_assert")
        row(name: "a C object is not a constant", argv: "build tests/golden/fixedbugs/ffi-not-constant.hero", code: 1).err_has("error[ffi_not_constant]").err_has("has `stdout`, but not as a constant").err_has("reading it twice could give two answers").err_lacks("internal error").err_lacks("__builtin_constant_p")
        row(name: "a misspelled extern name says the header has no such name", argv: "build tests/golden/fixedbugs/ffi-unknown-name.hero", code: 1).may_skip().err_has("error[ffi_unknown_name]").err_has("declares no `sqlite3_openn`").err_has("sqlite3.h").err_has("fix (guess)").err_has("`sqlite3_open`").err_lacks("ffi_return_type").err_lacks("internal error").err_lacks("_Static_assert")
        row(name: "a macro-only extern name is told as a macro, and the function it drafts names no declared C type (panel 185 R1)", argv: "build tests/golden/unsupported/fixedbugs-143-a-function-like-macro-of-the-programs-own-header.hero", code: 1).err_has("error[ffi_macro_name]").err_has("defines `SQUARE` as a macro, not a function").err_has("hero_SQUARE(<C type> x)").err_lacks("int32_t x").err_lacks("ffi_unknown_name").err_lacks("declares no").err_lacks("internal error")
        row(name: "a missing link is the author's error", argv: "build tests/golden/fixedbugs/ffi-missing-link.hero", code: 1).may_skip().err_has("error[ffi_missing_link]").err_has("ffi-missing-link.hero:").err_has("link \"<library>\"").err_lacks("internal error").err_lacks("build/")
        row(name: "a const pointer reads", argv: "run tests/golden/fixedbugs/ffi-const-pointer.hero", code: 0).out_has("false 3").out_has("ziggy").out_has("stardust")
        row(name: "a cstr is not any pointer", argv: "build tests/golden/fixedbugs/ffi-cstr-is-not-any-pointer.hero", code: 1).err_has("ffi_return_type")
        row(name: "a float parameter never converts in silence", argv: "build tests/golden/fixedbugs/ffi-float-parameters.hero", code: 1).err_has("error[ffi_parameter_type]").err_has("`x` of `pow` is declared narrower than the header's `double`").err_has("Declare it `f64`").err_has("`x` of `powf` is declared wider than the header's `float`").err_has("Declare it `f32`").err_has("`n` of `ldexp` is declared a different kind of number from the header's `int`").err_has("drop the fraction").err_has("`x` of `sqrt` is declared a different kind of number from the header's `double`").err_has("round large values").err_lacks("internal error").err_lacks("hero_ffi_probe").err_lacks("build/")
        row(name: "an integer narrowing below the 64-to-32 window is the author's error", argv: "build tests/golden/fixedbugs/ffi-int-narrowing-below-32.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`pair` of `init_pair` is declared wider than the header's").err_has("Declare it `i16`").err_lacks("internal error").err_lacks("hero_ffi_probe")
        row(name: "libcurl takes a variadic and returns an enum", argv: "run examples/curl/main.hero", code: 0).may_skip().out_starts("libcurl: libcurl/").out_has("the url was accepted").out_has("code 1 means: Unsupported protocol")
        row(name: "an enum-returning extern needs no unary plus", argv: "build examples/curl/main.hero", code: 0).may_skip()
