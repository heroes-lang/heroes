# The command surface: what a user types, and what comes back.
#
# Port of the table-shaped half of crates/heroes-cli/tests/surface.rs (69
# tests, 2,139 lines). Panel 085 measured what the archive would leave of
# it: 17 in-process successors that "test functions rather than the
# binary — `cli_argv.parse(...)` returning a value is not `heroes check
# x.hero --brief` exiting 1 with that stderr". This module types.
#
# Three groups here, each a table of `probe.Probe` rows:
#   argv     the three exit codes, the streams, strictness, the stops
#   help     what `--help` must say
#   render   the four ways a diagnostic can be printed, and `--apply`
#
# The rest of surface.rs lands beside it: the FFI fixtures, the module
# fixtures, `mutate`, `test`, and the handful that cannot be a row at all
# because they run a second process, change the child's directory, or
# compare two invocations against each other.
#
# EVERY PATH IS RELATIVE TO THE REPOSITORY ROOT, because the compiler
# echoes the path it was given and an expectation must not also record
# which directory ran the harness.

use probe
use report
use strings
use shell

# The chain that builds a row. It lives here rather than beside the record
# because UFCS does not cross a module boundary (measured: `box.make(1)
# .plus(2)` is error[needs_qualifying] on both compilers), and a table
# written as nested calls is a table nobody proof-reads.
function row(name: str, argv: str, code: i64) -> probe.Probe
    return probe.probe(name: name, argv: argv, code: code)

function out_has(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_has @ p.out_has.push(needle)
    return out

function out_lacks(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_lacks @ p.out_lacks.push(needle)
    return out

function err_has(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_has @ p.err_has.push(needle)
    return out

function err_lacks(p: probe.Probe, needle: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_lacks @ p.err_lacks.push(needle)
    return out

function out_starts(p: probe.Probe, prefix: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_starts @ prefix
    return out

function err_starts(p: probe.Probe, prefix: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_starts @ prefix
    return out

function out_is(p: probe.Probe, text: str) -> probe.Probe
    out: probe.Probe @ p
    out.out_is @ text
    return out

function err_is(p: probe.Probe, text: str) -> probe.Probe
    out: probe.Probe @ p
    out.err_is @ text
    return out

function out_empty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.out_state @ "empty"
    return out

function out_nonempty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.out_state @ "nonempty"
    return out

function err_empty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.err_state @ "empty"
    return out

function err_nonempty(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.err_state @ "nonempty"
    return out

function err_lines(p: probe.Probe, count: i64) -> probe.Probe
    out: probe.Probe @ p
    out.err_lines @ count
    return out

function out_lines_max(p: probe.Probe, count: i64) -> probe.Probe
    out: probe.Probe @ p
    out.out_lines_max @ count
    return out

# Green where this machine lacks the C library the case binds — the same
# rule every other suite carries, and floored by the caller.
function may_skip(p: probe.Probe) -> probe.Probe
    out: probe.Probe @ p
    out.library_skip @ true
    return out

function run_all(scratch: str, compiler: str) -> report.Report?
    r: report.Report @ report.empty()
    probe.run_table(scratch: scratch, compiler: compiler, probes: argv_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: help_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: render_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: ffi_probes(), r: @r)
    probe.run_table(scratch: scratch, compiler: compiler, probes: verb_probes(), r: @r)
    return ok(r)

# **The three exit codes mean three different things** (panel 016): 0 the
# input is clean, 1 the input has diagnostics, 2 the tool could not run.
# The whole contract is falsifiable in five invocations.
function argv_probes() -> [probe.Probe]
    return [
        row(name: "a clean file exits 0", argv: "check examples/gallery/01-points.hero", code: 0)
        row(name: "a file with diagnostics exits 1", argv: "check tests/golden/check/shadowing.hero", code: 1)
        row(name: "a file that is not there exits 2", argv: "check no/such/file.hero", code: 2)
        row(name: "an unknown flag exits 2", argv: "check --nonsense examples/gallery/00-first.hero", code: 2)
        row(name: "an unknown command exits 2", argv: "frobnicate", code: 2)
        row(name: "a dump is the artifact", argv: "parse examples/gallery/00-first.hero --dump-ast", code: 0).out_nonempty().err_empty()
        row(name: "a diagnostic is not an artifact", argv: "check tests/golden/check/shadowing.hero", code: 1).out_empty().err_nonempty()
        row(name: "an unknown flag names what is accepted", argv: "check --dump-ast examples/gallery/00-first.hero", code: 2).err_starts("error: `check` does not accept `--dump-ast` — it accepts --dump-scopes")
        row(name: "a verb with no flags says so", argv: "doctor --json", code: 2).err_has("takes no flags")
        row(name: "a retired flag names its replacement", argv: "fmt --write examples/gallery/00-first.hero", code: 2).err_is("error: `--write` is no longer a flag of `fmt` — use `--in-place`\n")
        row(name: "the refused --no-line names what to do instead", argv: "build examples/gallery/00-first.hero --no-line", code: 2).err_has("no longer a flag").err_has("--emit-c")
        row(name: "a stage is silent unless asked", argv: "lex examples/gallery/00-first.hero", code: 0).out_empty()
        row(name: "a dump prints the tokens", argv: "lex examples/gallery/00-first.hero --dump-tokens", code: 0).out_has("ident main")
        row(name: "json changes how, not what", argv: "lex examples/gallery/00-first.hero --dump-tokens --json", code: 0).out_starts("[\n").out_has("\"kind\"")
        row(name: "json alone selects no output", argv: "lex examples/gallery/00-first.hero --json", code: 0).out_empty()
        row(name: "a missing operand shows the shape", argv: "check", code: 2).err_is("error: `check` needs a file: `heroes check <file.hero>`\n")
        row(name: "two files are refused", argv: "check a.hero b.hero", code: 2).err_has("takes one file")
        row(name: "-o needs a path", argv: "build examples/gallery/00-first.hero -o", code: 2).err_has("needs a path")
        row(name: "two stops are refused", argv: "build examples/gallery/00-first.hero --dump-ir --emit-c", code: 2).err_has("one artifact at a time")
        row(name: "run passes arguments after --", argv: "run tests/golden/run/edges-file-args-exit.hero -- alpha beta", code: 0).out_has("arguments: 2")
        row(name: "only run takes program arguments", argv: "check examples/gallery/00-first.hero -- x", code: 2).err_has("only `heroes run` does")
        row(name: "build takes -O2", argv: "build examples/gallery/00-first.hero -O2", code: 0)
        row(name: "build takes -O0", argv: "build examples/gallery/00-first.hero -O0", code: 0)
        row(name: "run takes -O0", argv: "run examples/gallery/00-first.hero -O0", code: 0)
        row(name: "two levels are refused", argv: "build examples/gallery/00-first.hero -O0 -O2", code: 2).err_has("one level at a time")
        row(name: "an unknown level names the two", argv: "build examples/gallery/00-first.hero -O1", code: 2).err_has("-O0, -O2")
    ]

# The artifact on stdout, diagnostics on stderr — §10's contract,
# asked of both halves at once.

# An unknown flag names what the command DOES accept, which is the
# difference between a refusal and a dead end.

# A retired flag names its replacement rather than reporting that
# it is unknown: the user typed something that USED to work.

# A stage prints only when asked: `lex` alone is a check, not a
# dump. `--json` says HOW to print and never WHAT (§10).

# A missing or doubled operand is named with the shape that works.

# Arguments reach the program, and only through `run`.

# The optimisation level is a flag with the verb's default, and
# two of them at once is a refusal rather than a last-wins.

# The help text is the surface's only documentation, so what it must
# carry is asserted rather than reviewed.
function help_probes() -> [probe.Probe]
    return [
        row(name: "help states the exit codes and the streams", argv: "--help", code: 0).out_has("1 diagnostics were reported, no artifact was produced").out_has("2 the tool could not run.").out_has("HEROES_RUNTIME").out_has("streams: the artifact on stdout")
        row(name: "every flag in the table is documented", argv: "--help", code: 0).out_has("--dump-tokens").out_has("--json").out_has("--dump-ast").out_has("--dump-scopes").out_has("--in-place")
        row(name: "measure states its default", argv: "--help", code: 0).out_has("(default: spec/heroes-spec.md)")
        row(name: "measure runs with no operand", argv: "measure", code: 0)
    ]

# Four ways one diagnostic is printed — rich, brief, json, applied — and
# the hole report, which is an ARTIFACT and goes to stdout at exit 0.
function render_probes() -> [probe.Probe]
    return [
        row(name: "the rich form carries the line, the caret and the other end", argv: "check tests/golden/check/certain-labels.hero", code: 1).err_starts("error[wrong_label]: `Point` has nothing called `z` at this position — it is `y`\n").err_has("  at tests/golden/check/certain-labels.hero:10:21").err_has("    a = Point(x: 1, z: 2)").err_has("^").err_has("fix (certain): write `y:`")
        row(name: "brief is one line per diagnostic", argv: "check tests/golden/check/certain-labels.hero --brief", code: 1).err_lines(3).err_starts("tests/golden/check/certain-labels.hero:")
        row(name: "json is versioned and carries the fixes", argv: "check tests/golden/check/certain-labels.hero --json", code: 1).err_starts("{\n  \"schema\": 1,\n").err_has("\"code\": \"wrong_label\"").err_has("\"certainty\": \"certain\"").err_has("\"line\": 10")
        row(name: "the thesis rules fire by default", argv: "check tests/golden/check/unused-bindings.hero --brief", code: 1).err_lines(4)
        row(name: "permissive drops them", argv: "check tests/golden/check/unused-bindings.hero --brief --permissive", code: 0).err_empty()
        row(name: "permissive keeps the rest", argv: "check tests/golden/check/unknown-type.hero --brief --permissive", code: 1)
        row(name: "apply repairs with certain fixes only", argv: "check tests/golden/check/certain-fixes.hero --apply", code: 0).out_has("print(total)").out_has("for _ in range(from: 0, to: 3)").out_has(".num _ => 1").out_lacks("The Heroes library")
        row(name: "apply reaches a mutation", argv: "check tests/golden/check/not-mutable.hero --apply", code: 0).out_has("    x @ 2")
        row(name: "a hole is an artifact at exit 0", argv: "check examples/gallery/09-holes.hero", code: 0).out_has("hole at examples/gallery/09-holes.hero:").out_has("this function returns: Entry").out_has("expected type: str").out_has("in scope:").out_has("entries: [Entry]")
    ]

# `--permissive` drops the diagnostics that exist for the thesis
# and keeps the rest — the control arm of Part 11's measurement,
# asserted on both sides so it cannot quietly become "drop
# everything".

# `--apply` writes the repaired program to stdout, certain fixes
# only, and never the library it did not read.

# A hole is not an error: the compiler reports what belongs there,
# on stdout, and the exit code stays 0.

# **A verdict about the author's `extern` is exit 1 on the `.hero` line,
# never exit 2 on the compiler** (CLAUDE.md §7, panel 036 as widened by
# 048). Every row below asserts three things at once: the code, the words
# that make the diagnostic actionable, and — the half that is easy to
# forget — that clang's own vocabulary did NOT leak. `internal error`,
# `_Static_assert`, `_Generic`, `hero_ffi_probe` and a `build/` path are
# what the reader must never see, because each one sends them to a file
# they did not write.
function ffi_probes() -> [probe.Probe]
    return [
        row(name: "a parameter wider than the header is the author's error", argv: "build tests/golden/fixedbugs/ffi-parameter-width.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`c` of `putchar`").err_has("`int`").err_has("Declare it `i32`").err_lacks("internal error").err_lacks("hero_ffi_probe").err_lacks("build/")
        row(name: "a field the header has as an array is the author's error", argv: "build tests/golden/fixedbugs/ffi-a-field-the-header-has-as-an-array.hero", code: 1).may_skip().err_has("error[ffi_field_type]").err_has("`Dirent.d_name`").err_lacks("internal error")
        row(name: "a word-width parameter names the platform", argv: "build tests/golden/fixedbugs/ffi-word-width.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`size` of `malloc`").err_has("`offset` of `fseek`").err_has("the platform's word").err_has("Windows").err_lacks("internal error").err_lacks("hero_ffi_probe")
        row(name: "a cstr that cannot be used says what turns it into a str", argv: "check tests/golden/check/ffi-cstr-has-a-route.hero", code: 1).err_has("error[bad_operand]").err_has("validated").err_has("null_cstr").err_has("not_text")
        row(name: "a wrong extern return type is the author's error", argv: "build tests/golden/fixedbugs/ffi-return-type.hero", code: 1).err_has("error[ffi_return_type]").err_has("does not return `i64`").err_has("math.h").err_lacks("internal error").err_lacks("_Static_assert").err_lacks("_Generic")
        row(name: "a wrong pointer return is a diagnostic", argv: "build tests/golden/fixedbugs/ffi-pointer-return.hero", code: 1).err_has("error[ffi_return_type]").err_has("getenv").err_has("stdlib.h").err_lacks("internal error").err_lacks("unary expression").err_lacks("_Generic")
        row(name: "a wrong extern constant type is the author's error", argv: "build tests/golden/fixedbugs/ffi-constant-type.hero", code: 1).err_has("error[ffi_constant_type]").err_has("`M_PI` is not `i64`").err_has("math.h").err_lacks("does not return").err_lacks("internal error").err_lacks("_Static_assert")
        row(name: "a C object is not a constant", argv: "build tests/golden/fixedbugs/ffi-not-constant.hero", code: 1).err_has("error[ffi_not_constant]").err_has("has `stdout`, but not as a constant").err_has("reading it twice could give two answers").err_lacks("internal error").err_lacks("__builtin_constant_p")
        row(name: "a misspelled extern name says the header has no such name", argv: "build tests/golden/fixedbugs/ffi-unknown-name.hero", code: 1).may_skip().err_has("error[ffi_unknown_name]").err_has("declares no `sqlite3_openn`").err_has("sqlite3.h").err_has("fix (guess)").err_has("`sqlite3_open`").err_lacks("ffi_return_type").err_lacks("internal error").err_lacks("_Static_assert")
        row(name: "a missing link is the author's error", argv: "build tests/golden/fixedbugs/ffi-missing-link.hero", code: 1).may_skip().err_has("error[ffi_missing_link]").err_has("ffi-missing-link.hero:").err_has("link \"<library>\"").err_lacks("internal error").err_lacks("build/")
        row(name: "a const pointer reads", argv: "run tests/golden/fixedbugs/ffi-const-pointer.hero", code: 0).out_has("false 3").out_has("ziggy").out_has("stardust")
        row(name: "a cstr is not any pointer", argv: "build tests/golden/fixedbugs/ffi-cstr-is-not-any-pointer.hero", code: 1).err_has("ffi_return_type")
        row(name: "a float parameter never converts in silence", argv: "build tests/golden/fixedbugs/ffi-float-parameters.hero", code: 1).err_has("error[ffi_parameter_type]").err_has("`x` of `pow` is declared narrower than the header's `double`").err_has("Declare it `f64`").err_has("`x` of `powf` is declared wider than the header's `float`").err_has("Declare it `f32`").err_has("`n` of `ldexp` is declared a different kind of number from the header's `int`").err_has("drop the fraction").err_has("`x` of `sqrt` is declared a different kind of number from the header's `double`").err_has("round large values").err_lacks("internal error").err_lacks("hero_ffi_probe").err_lacks("build/")
        row(name: "an integer narrowing below the 64-to-32 window is the author's error", argv: "build tests/golden/fixedbugs/ffi-int-narrowing-below-32.hero", code: 1).may_skip().err_has("error[ffi_parameter_type]").err_has("`pair` of `init_pair` is declared wider than the header's").err_has("Declare it `i16`").err_lacks("internal error").err_lacks("hero_ffi_probe")
        row(name: "libcurl takes a variadic and returns an enum", argv: "run examples/curl/main.hero", code: 0).may_skip().out_starts("libcurl: libcurl/").out_has("the url was accepted").out_has("code 1 means: Unsupported protocol")
        row(name: "an enum-returning extern needs no unary plus", argv: "build examples/curl/main.hero", code: 0).may_skip()
        row(name: "sqlite opens, queries and closes with no shim", argv: "run examples/sqlite/main.hero", code: 0).may_skip().out_is("rows: 3\nlongest: 6\n")
    ]

# End to end against libraries this machine actually has: the
# binding is only proven by the answer coming back.

# The verbs and what they produce: an artifact, a program's own status, a
# hole report, and the tests a file carries.
function verb_probes() -> [probe.Probe]
    return [
        row(name: "build dumps the IR on stdout", argv: "build examples/gallery/00-first.hero --dump-ir", code: 0).out_starts("function main()").out_has("bb0").err_empty()
        row(name: "build honours the exit code contract, clean", argv: "build examples/gallery/00-first.hero", code: 0)
        row(name: "build honours it for diagnostics", argv: "build tests/golden/check/shadowing.hero", code: 1)
        row(name: "build honours it for a refusal", argv: "build tests/golden/unsupported/three-capabilities.hero", code: 1)
        row(name: "build honours it for a missing file", argv: "build no/such/file.hero", code: 2)
        row(name: "build refuses a flag that is not its own", argv: "build --dump-ast examples/gallery/00-first.hero", code: 2)
        row(name: "run compiles and executes", argv: "run examples/gallery/00-first.hero", code: 0).out_is("20\n").err_empty()
        row(name: "exit forwards the program's own status", argv: "run tests/golden/run/exit-status.hero", code: 3).out_is("before\n")
        row(name: "an ordinary build ignores test blocks", argv: "build examples/calculator/whole.hero --emit-c", code: 0).out_lacks("hero_panic_assert")
        row(name: "a hole stops the build and says how many", argv: "build examples/gallery/09-holes.hero", code: 1).out_nonempty().err_starts("no binary: 2 holes")
        row(name: "a hole does not stop check", argv: "check examples/gallery/09-holes.hero", code: 0)
        row(name: "a hole does not stop the IR dump", argv: "build examples/gallery/09-holes.hero --dump-ir", code: 0)
        row(name: "test runs each block", argv: "test examples/calculator/whole.hero", code: 0).out_has("ok   \"precedence and parens\"").out_has("7 tests, all passed")
        row(name: "the split calculator passes the same tests across four modules", argv: "test examples/calculator/main.hero", code: 0).out_has("7 tests, all passed").out_has("ok   \"generics work across types\"").out_has("ok   \"tokenizes numbers, names and symbols\"")
        row(name: "every module names itself in the emitted C", argv: "build examples/calculator/main.hero --emit-c", code: 0).out_has("examples/calculator/main.hero\"").out_has("examples/calculator/lex.hero\"").out_has("examples/calculator/parse.hero\"").out_has("examples/calculator/eval.hero\"")
        row(name: "a file with no main is the author's error under build", argv: "build tests/golden/surface-fixtures/no-main.hero", code: 1).err_has("error[no_entry_point]").err_has("no-main.hero").err_lacks("internal error").err_lacks("library")
        row(name: "a file with no main is the author's error under run", argv: "run tests/golden/surface-fixtures/no-main.hero", code: 1).err_has("error[no_entry_point]").err_has("no-main.hero").err_lacks("internal error").err_lacks("library")
        row(name: "an extern is never callable across a module boundary", argv: "check tests/golden/surface-fixtures/externroute/wrong.hero", code: 1).err_has("error[extern_across_modules]").err_has("`system` is an `extern` of module `bind`").err_has("only `bind` carries the header").err_has("write a Heroes function beside the `extern` in `bind`").err_lacks("internal error")
        row(name: "the route is a Heroes function in the declaring module", argv: "run tests/golden/surface-fixtures/externroute/right.hero", code: 0).out_is("0\n")
        row(name: "a wrong extern signature is exit 1 on the declaring module's line", argv: "build tests/golden/surface-fixtures/externsignature/wrong.hero", code: 1).err_has("error[ffi_return_type]").err_has("externsignature/bind.hero:13:5").err_has("that is what `math.h` says").err_lacks("internal error").err_lacks("build/").err_lacks("hero_ffi_probe")
        row(name: "the same shape with the header's own signature runs", argv: "run tests/golden/surface-fixtures/externsignature/right.hero", code: 0).out_is("4.0\n")
        row(name: "one C symbol carries two bindings, in two modules", argv: "run tests/golden/surface-fixtures/twoarity/main.hero", code: 0).out_is("n = 42\ns = forty-two\n")
        row(name: "a local may not take the name a use bound, and one mistake is one diagnostic", argv: "check tests/golden/surface-fixtures/localtakesamodule/main.hero", code: 1).err_has("error[shadowed_binding]").err_has("what this file calls the module `state`").err_has("use state as <other>").err_has("or rename this binding").err_lacks("module_is_not_a_value").err_lacks("internal error")
        row(name: "a ptr local wearing a module's name is two diagnostics, and the qualifying repair is a guess", argv: "check tests/golden/surface-fixtures/qualifyptr/main.hero", code: 1).err_has("error[shadowed_binding]").err_has("error[needs_qualifying]").err_lacks("fix (certain)").err_lacks("internal error")
        row(name: "apply on it leaves the text untouched, because a fix that reproduced itself was no fix", argv: "check tests/golden/surface-fixtures/qualifyptr/main.hero --apply", code: 0).out_is("use window\n\nfunction main()\n    window: ptr @ nullptr  #~ shadowed_binding\n    window @ nullptr\n    _ = window.destroy()  #~ needs_qualifying\n").out_lacks("window.window")
        row(name: "deep recursion stops with a word at -O0, on every platform", argv: "run tests/golden/surface-fixtures/deep/main.hero -O0", code: -1).err_has("panic: stack exhausted").out_empty()
        row(name: "a recursion of WIDE frames stops with the same word at -O0: the probe reaches the guard before sp does (docs/defects/007)", argv: "run tests/golden/surface-fixtures/wideframe/main.hero -O0", code: -1).err_has("panic: stack exhausted").out_empty()
        row(name: "and at -O2, where the frame is smaller and the witness is the other one", argv: "run tests/golden/surface-fixtures/wideframe/main.hero -O2", code: -1).err_has("panic: stack exhausted").out_empty()
        row(name: "a nested program runs from its root, the leaf reading the root's module by path", argv: "run tests/golden/surface-fixtures/nested/main.hero", code: 0).out_is("2\n20\n")
        row(name: "a leaf below the root, compiled directly, refuses and names the directory it read from and the file that decided it", argv: "check tests/golden/surface-fixtures/nested/lib/leaf.hero", code: 1).err_has("error[unknown_module]").err_has("reads `tests/golden/surface-fixtures/nested/lib/util.hero`").err_has("from the directory of `tests/golden/surface-fixtures/nested/lib/leaf.hero`, the file you compile")
        row(name: "beside a decoy module the same leaf checks clean against the wrong file, which is the stated hazard and not a defect", argv: "check tests/golden/surface-fixtures/nested/decoy/lib/leaf.hero", code: 0).err_empty()
        row(name: "and the decoy program itself, compiled from its root, reads the root's module", argv: "run tests/golden/surface-fixtures/nested/decoy/main.hero", code: 0).out_is("3\n30\n")
        row(name: "text names the file a diagnostic is in", argv: "check tests/golden/surface-fixtures/cross/main.hero --brief", code: 1).err_has("geom.hero:5:")
        row(name: "json names it too", argv: "check tests/golden/surface-fixtures/cross/main.hero --json", code: 1).err_has("\"line\": 5,")
        row(name: "the hole count names the file the holes are in", argv: "build tests/golden/surface-fixtures/holes/main.hero", code: 1).err_has("no binary: 1 hole in ").err_has("geom.hero")
        row(name: "apply does not panic on a fix in another module", argv: "check tests/golden/surface-fixtures/applyx/main.hero --apply", code: 0).err_has("another module").err_has("geom.hero").out_has("use geom").out_lacks("function area")
        row(name: "dump-tokens shows the file that was named", argv: "lex examples/gallery/00-first.hero --dump-tokens", code: 0).out_starts("1:1 ").out_lacks("range").out_lines_max(39)
        row(name: "mutate refuses a corpus that does not compile", argv: "mutate tests/golden/check", code: 2).out_empty().err_has("this corpus does not compile").err_has("already refused by").err_has("tests/golden/check/")
        row(name: "mutate accepts the gallery", argv: "mutate examples/gallery", code: 0)
        row(name: "mutate reads a nested program from its root: the leaf below it is checked from there, not from its own directory", argv: "mutate examples/shapes --operator typo-digit", code: 0).out_has("corpus: 6 programs").out_has("| **total** |")
        row(name: "mutate reads the WHOLE corpus — the gate every leg runs, one cheap operator, so a program the tool cannot read is red the day it lands", argv: "mutate examples --operator typo-digit", code: 0).out_has("corpus: ").out_has("| typo-digit |").err_empty()
        row(name: "mutate prints the survivors of one operator", argv: "mutate examples/gallery --operator swap-args --survivors", code: 0).out_has("| swap-args |").out_lacks("| typo-ident |")
        row(name: "an unknown operator names the ones there are", argv: "mutate --operator swapargs", code: 2).err_has("no operator `swapargs`").err_has("swap-args")
        row(name: "the zen prints and says nothing on stderr", argv: "this", code: 0).err_empty().out_has("20. We can be heroes, just for one day.\n")
    ]

# Panel 099 R5 (M-robustness-guards step 6): a nested program, its leaf
# compiled directly. The root program runs; the leaf alone refuses and
# says where it looked and which file decided that; and beside a decoy
# `lib/util.hero` the leaf alone checks CLEAN against a different module
# — the hazard the root base carries, stated by a row rather than by a
# silence (the historian's standing prediction is Zig #13970's shape).

# A hole is not an error and not a binary: the report is the
# artifact, and `build` is the one verb that must refuse.

# `heroes test` runs each block and reports one line each.

# Modules: every one names itself in the emitted C, a file with no
# main is the author's error, and a diagnostic in another module
# says which file it is in — in both spellings.

# Acceptance row 4, as panel 093 R5 re-read it. The caller is
# correct and the mistake is one module over, so what these pin is
# that the verdict finds the AUTHOR's line in the declaring module
# rather than blaming whichever translation unit was compiling.

# Panel 094's refutation, kept as a program. One C symbol bound at
# two signatures in two modules: the probes are mangled per module
# and the call goes through the header's own prototype, so C sees
# one `printf` and Heroes sees two bindings. The claim this refutes
# — that a C name carries one arity — was the whole stated case for
# adding a rename clause to the language.

# `mutate` refuses a corpus that does not compile, and prints the
# survivors of one operator when asked for them.
# The corpus that cannot compile is `tests/golden/check/` — 65 programs
# the compiler is SUPPOSED to refuse. It was the bootstrap's library
# directory until M-bootstrap-archive, which is a directory that no
# longer exists, and the row then failed for the wrong reason (`find:
# No such file or directory`). The new corpus is better than a repointed
# path: `check/` exists to hold refused programs, so this row cannot rot
# for want of a wrong one — and the count is deliberately not pinned
# here, because a new check case must not turn this red.

# The zen is the one verb with no input at all.

test "the tables are what this module is, so they are counted"
    # Counted by running the count, after the first draft asserted two
    # numbers somebody had counted on screen (25 and 8, against 26 and 9).
    assert argv_probes().len() == 26
    assert help_probes().len() == 4
    assert render_probes().len() == 9
    assert ffi_probes().len() == 17

    # 33 -> 35 on 2026-09-03, M-robustness-guards step 2: `qualifyptr`'s two
    # rows — the program whose `certain` fix reproduced itself, now a guess,
    # and `--apply` leaving its text untouched.
    # 35 -> 36 on 2026-09-03, M-robustness-guards step 4: the deep-recursion
    # row, the first surface row whose exit code is not asserted — `abort()`
    # is 134 on POSIX and the MSVC runtime's own number on Windows, and the
    # message is the fact.
    # 36 -> 40 on 2026-09-03, M-robustness-guards step 6: the four rows of
    # panel 099 R5's nested-leaf fixture.
    # 40 -> 42 on 2026-09-03, M-corpus-depth steps 1 and 2: `mutate` reads a
    # nested program from its root (the corpus was refused for a day because
    # it did not — measurement 014), and the gate over the whole corpus that
    # every leg runs, one cheap operator (typo-digit, 29 mutants, 2.1 s of
    # base check over 78 files measured the day it was written).
    # 42 -> 44 on 2026-09-03, the repair of defect 007: the WIDE-frame
    # recursion at -O0 and -O2. Its -O0 frame is 32 KiB and the prologue
    # probes it with `___chkstk_darwin` before `sp` moves, which is the shape
    # the guard's second witness missed — `heroes check` died at 139 in
    # silence on a legal program. Not under `--sanitize`: the guard yields to
    # ASan there by design, and ASan's own `stack-overflow` report is what
    # `run/`'s judge refuses on sight, so the case cannot live in `run/`.
    assert verb_probes().len() == 44

test "a probe holds when everything it asks for is true"
    scratch = "build/harness-selftest"
    p = row(name: "the zen", argv: "this", code: 0).out_has("We can be heroes").err_empty()
    assert probe.unmet(scratch: scratch, compiler: shell.some_compiler(), p: p) == ""

test "a probe names every way one invocation disappointed it"
    scratch = "build/harness-selftest"
    p = row(name: "wrong", argv: "this", code: 2).out_has("not there").err_nonempty()
    wrong = probe.unmet(scratch: scratch, compiler: shell.some_compiler(), p: p)
    assert wrong.len() > 0
    assert strings.contains(text: wrong, needle: "exited 0, not 2")
    assert strings.contains(text: wrong, needle: "does not carry `not there`")
    assert strings.contains(text: wrong, needle: "stderr is empty")

test "the chain leaves the probe it was given alone"
    one = row(name: "a", argv: "b", code: 0)
    two = one.out_has("x").err_has("y")
    assert one.out_has.len() == 0
    assert two.out_has.len() == 1
    assert two.err_has.len() == 1
