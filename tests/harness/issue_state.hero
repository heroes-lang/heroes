# WHAT A RUN OF `push` KEEPS BETWEEN TWO RUNS, AND THE ONE LINE IT WRITES INTO A
# CARD.
#
# `.claude/rules/records.md` § The issues (panel 212's R5, ratified 2026-10-11):
# **the state lives in the cards**, the address written into a card's `github:`
# line as soon as its import reads `imported` and before the next request; and
# the run's state file records the pin, the same on every rerun, and the imports
# answered `pending`, which the next run reads first. This module is both.
#
# THE STATE FILE is `build/issues-push.state` in the tree the run works in
# (R5: its own worktree under `.claude/worktrees/`). `build/` because git
# ignores it, so the file never dirties the tree or travels in a commit, and
# because it is the tree's own: a second worktree's run keeps its own. Lost,
# it costs the pin's check and the order of polling, never an issue twice: a
# run that finds no state reconciles by the list all the same (`issue_push`).
# One line each:
#
#     pin <forty digits>
#     sent <issue file> <day>        an import asked, its answer not yet read
#     pending <issue file> <url>     an import answered `pending` at <url>
#
# A `sent` line is written BEFORE the import is asked, so a run killed while it
# waits for the answer leaves a line saying the import may exist; the day is
# GitHub's, from the newest answer before it, for the list of imports since.
#
# THE CARD'S LINE is its seventh, `github: none`, and nothing else of the file
# moves: the file is read, that one line replaced, the file written whole
# (`write_file` replaces a file through a rename since defect 438, so a run
# killed while writing leaves the old card or the new and never half of one),
# and read back to say it holds the address. A card that already holds the
# same address is left as it is; one holding another is refused, since
# `github:` is the truth of the mapping (the rule's last bullets) and two
# issues of one file are a fault no run repairs on its own.

use cards
use shell
use strings

constant PATH: str
    "build/issues-push.state"

# An import of the run: its issue file, the import's `url` once GitHub answered
# with one, "" before, and the day it was asked.
record Flight
    path: str
    url: str
    day: str

record State
    pin: str
    flights: [Flight]

function empty() -> State
    none: [Flight] = []
    return State(pin: "", flights: none)

# The state at `path`; an empty one where no file is.
function read_state(path: str) -> State?
    match read_file(path)
        .ok text => return parsed(text)
        .err e =>
            if e.code == "file_not_found"
                return ok(empty())
            return fail(code: "state", msg: "cannot read the run's state at " + path + ": " + e.msg)

function parsed(text: str) -> State?
    state: State @= empty()
    row_number: i64 @= 0

    for row in strings.lines(text)
        row_number @ row_number + 1
        parts = strings.split_on(text: row, byte: ' ')

        if parts.len() == 2 && parts[0] == "pin" && cards.is_full_hash(parts[1]) && state.pin == ""
            state.pin @ parts[1]
        else if parts.len() == 3 && parts[0] == "sent"
            state.flights @ state.flights.push(Flight(path: parts[1], url: "", day: parts[2]))
        else if parts.len() == 3 && parts[0] == "pending" && parts[2] != ""
            state.flights @ state.flights.push(Flight(path: parts[1], url: parts[2], day: ""))
        else
            return fail(
                code: "state",
                msg: "line " + row_number.to_str() + " of the run's state is `" + row + "`, which is none of `pin <hash>`, `sent <file> <day>` and `pending <file> <url>`"
            )

    return ok(state)

function text_of(state: State) -> str
    rows: [str] @= []

    if state.pin != ""
        rows @ rows.push("pin " + state.pin)

    for flight in state.flights
        if flight.url == ""
            rows @ rows.push("sent " + flight.path + " " + flight.day)
        else
            rows @ rows.push("pending " + flight.path + " " + flight.url)

    if rows.len() == 0
        return ""
    return rows.join("\n") + "\n"

function write_state(path: str, state: State) -> ()?
    match write_file(path: path, text: text_of(state))
        .ok _  => return ok()
        .err e => return fail(code: "state", msg: "cannot write the run's state at " + path + ": " + e.msg)

# `state` with `path`'s flight, if any, replaced by `flight`.
function flown(state: State, flight: Flight) -> State
    out: State @= landed(state: state, path: flight.path)
    out.flights @ out.flights.push(flight)
    return out

# `state` with no flight of `path`.
function landed(state: State, path: str) -> State
    kept: [Flight] @= []

    for flight in state.flights
        if flight.path != path
            kept @ kept.push(flight)

    return State(pin: state.pin, flights: kept)

# The card of `path` under `root` given `url` on its `github:` line.
function addressed(root: str, path: str, url: str) -> ()?
    file = root + "/" + path
    text = read_file(file)?
    card = cards.read_card(text)

    if card.complaints.len() > 0
        return fail(code: "card", msg: file + ": its card cannot be read: " + card.complaints[0])

    if card.github == url
        return ok()

    if card.github != "none"
        return fail(
            code: "card",
            msg: file + " holds `github: " + card.github + "`, and the run found its issue at " + url + "; two issues of one file are the author's to settle"
        )
    rows: [str] @= strings.split_on(text: text, byte: 10)

    if rows.len() < 8 || rows[6] != "github: none"
        return fail(code: "card", msg: file + ": line 7 is not `github: none`")
    rows[6] @ "github: " + url
    write_file(path: file, text: rows.join("\n"))?
    again = cards.read_card(read_file(file)?)

    if again.github != url
        return fail(code: "card", msg: file + " was written and does not read back `github: " + url + "`")
    return ok()

test "the state is read and written line for line, and a line of another shape is refused"
    text = "pin " + "a".repeat(40) + "\nsent issues/x/a.md 2026-10-12\npending issues/x/b.md https://api.github.com/repos/heroes-lang/heroes/import/issues/7\n"
    state = parsed(text).must()
    assert state.pin == "a".repeat(40)
    assert state.flights.len() == 2
    assert state.flights[0].url == ""
    assert state.flights[0].day == "2026-10-12"
    assert state.flights[1].path == "issues/x/b.md"
    assert text_of(state) == text
    assert text_of(empty()) == ""
    assert parsed("pin short\n").is_err()
    assert parsed("sent onlyone\n").is_err()
    flying = flown(state: state, flight: Flight(path: "issues/x/a.md", url: "u", day: ""))
    assert flying.flights.len() == 2
    assert flying.flights[1].url == "u"
    assert landed(state: flying, path: "issues/x/b.md").flights.len() == 1

test "a card takes its address on its seventh line alone, once, and refuses a second"
    scratch = shell.own_scratch()
    path = "issues/2026-10/12/2026-10-12-0000-a.md"
    shell.mkdir_all(scratch + "/issues/2026-10/12").must()
    text = cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-10-12", commit: "none", github: "none") + "- [ ] **M-issue-files** | a | b\n\n    github: none, in the body\n"
    write_file(path: scratch + "/" + path, text: text).must()
    url = "https://github.com/heroes-lang/heroes/issues/3"
    addressed(root: scratch, path: path, url: url).must()
    after = read_file(scratch + "/" + path).must()
    assert after == cards.card_text(kind: "task", area: "none", milestone: "none", filed: "2026-10-12", commit: "none", github: url) + "- [ ] **M-issue-files** | a | b\n\n    github: none, in the body\n"
    addressed(root: scratch, path: path, url: url).must()
    assert addressed(root: scratch, path: path, url: "https://github.com/heroes-lang/heroes/issues/4").is_err()
    assert addressed(root: scratch, path: "issues/none.md", url: url).is_err()
    assert read_state(scratch + "/no-state").must().pin == ""
    write_state(
        path: scratch + "/state",
        state: State(pin: "b".repeat(40), flights: [Flight(path: path, url: "", day: "2026-10-12")])
    ).must()
    assert read_state(scratch + "/state").must().flights[0].day == "2026-10-12"
    _ = shell.remove_tree(scratch).is_err()
