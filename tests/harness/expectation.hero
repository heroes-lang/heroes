# What a running program is expected to do, and the one reader of it.
#
# Port of archive/bootstrap-rs/heroes-cli/tests/expectation/mod.rs, and it exists here
# for the reason it exists there: two suites execute programs and diff
# what comes out — `run/` and, when it lands, the corpus — so the
# convention lives in one file rather than in whichever suite was written
# first. A second copy is a second place for the meaning of `!exit: 0` to
# drift.
#
# The convention is QBE's: the expected output lives in the case, and so
# does the way the program ends. An expectation is the program's stdout,
# optionally followed by one last line saying it does NOT end at exit 0
# with a silent stderr:
#
#   !panic: <message>   an abort, and the text stderr must carry
#   !exit: <code>       exit(code), and the status the shell must see
#
# Both exist because the interesting half of §4.14 is the aborts: a
# program that overflows must STOP, and the wrong emitter does not crash
# — it prints a wrapped number at exit 0. That is only a golden if the
# harness can spell it. A case with no last line still has to exit 0, so
# a program that starts exiting by accident is still a failure.
#
# AND ONE LINE MAY COME BEFORE THAT ENDING, since panel 173 (2026-09-21):
#
#   !sanitizer: <needle>   under `--sanitize` the sanitiser MUST report,
#                          and its report must carry this text
#
# `suite_run.hero` runs every case a third time under `--sanitize` and
# fails any case whose stderr says `AddressSanitizer`, which is right for
# every case that is a correct program: a sanitiser speaking there is the
# defect the third run exists to find. It is wrong for a case whose whole
# subject is a program C corrupts — defect 070's, where the bytes of a
# `.lease()` are freed by a C function and the sanitiser's `bad-free` is
# not an accident but the evidence. Three such cases could not enter
# `tests/golden/run/` at all, measured at panel 173: `run` went 132 passed
# to 133 passed and 4 failed, every one *tripped a sanitiser*, whatever
# the `.expected` said.
#
# So the line does two things at once and that is the point: it WAIVES the
# refusal and REPLACES it with an assertion, so the sanitiser's verdict
# becomes an artifact the case pins rather than a thing the case tolerates.
# A case that stops provoking it goes red, which is the direction that
# matters — `.claude/rules/diagnostics-and-goldens.md`, an instrument
# watches the world and not the program's current behaviour.
#
# TWO THINGS IT DOES NOT DO. It does not relax the plain runs: `-O0` and
# `-O2` are judged by the ending as before, so the runtime's own report is
# still pinned where it prints. And it does not assert an exit code under
# the sanitiser, because there is none to assert: ASan aborts on Darwin
# (134) and calls `_exit(1)` on Linux, measured at panel 173, and the
# runtime's handler yields to it at compile time so our own line is absent
# there on both.

use strings

# How a case ends, when it does not end at exit 0 with nothing on stderr.
variant Ending
    silent
    panics
        message: str
    exits
        code: i64

record Expectation
    stdout: str
    ending: Ending
    # The text the sanitiser's report must carry, when the case declares one
    # with `!sanitizer:` (panel 173). Absent is the ordinary case, where a
    # sanitiser that speaks at all is a failure.
    sanitizer: str?

# Splits an expectation file into the stdout it promises and how it ends.
#
# A malformed ending is an error rather than a silent `silent`: `!exit:
# three` is a broken case, and a harness that read it as "no ending
# expected" would then demand exit 0 and report a mismatch about
# something else entirely.
function split(text: str) -> Expectation?
    rows = strings.lines(text)
    ending: Ending @ .silent
    kept: [str] @ rows

    if rows.len() > 0
        last = rows[rows.len() - 1]

        if strings.starts_with(text: last, prefix: "!panic: ")
            ending @ .panics(message: strings.without_prefix(text: last, prefix: "!panic: "))
            kept @ rows.slice(from: 0, to: rows.len() - 1)
        else if strings.starts_with(text: last, prefix: "!exit: ")
            code = strings.to_number(strings.trimmed(strings.without_prefix(text: last, prefix: "!exit: ")))

            if code.is_err()
                return fail(code: "bad_expectation", msg: "`" + last + "` is not an exit code")
            ending @ .exits(code: code.must())
            kept @ rows.slice(from: 0, to: rows.len() - 1)

    # The sanitiser line sits BEFORE the ending, so it is read after the
    # ending has been taken off: a case declares both, and the two judge
    # different runs (panel 173).
    sanitizer: str? @ fail(code: "none", msg: "no sanitiser line")

    if kept.len() > 0
        before = kept[kept.len() - 1]

        if strings.starts_with(text: before, prefix: "!sanitizer: ")
            needle = strings.trimmed(strings.without_prefix(text: before, prefix: "!sanitizer: "))

            if needle.len() == 0
                return fail(
                    code: "bad_expectation",
                    msg: "`" + before + "` names no text the sanitiser must say — a waiver with nothing to assert is the refusal removed and nothing put in its place"
                )
            sanitizer @ ok(needle)
            kept @ kept.slice(from: 0, to: kept.len() - 1)
    out: str @ kept.join("\n")

    if out.len() > 0
        out @ out + "\n"
    return ok(Expectation(stdout: out, ending: ending, sanitizer: sanitizer))

# What a run must satisfy, as one verdict. `where` names the
# configuration, so a failure says which of the three disagreed with the
# other two — a mismatch that reports stdout alone looks identical
# whether the program printed nothing, failed to build, aborted early or
# was killed (golden.rs:62, paid for by a CI round trip on the first
# Linux run this project ever had).
function unmet(e: Expectation, out: str, err: str, code: i64) -> str?
    if out != e.stdout
        return ok(
            "printed something else\n--- expected ---\n" + e.stdout + "--- actual ---\n" + out + "--- it ended: exit " + code.to_str() + ", and its stderr was ---\n" + err + "--- end ---"
        )

    match e.ending
        .silent =>
            if code != 0
                return ok("must exit 0, and exited " + code.to_str() + "\n  its stderr was:\n" + err)
        .exits x =>
            if code != x.code
                return ok(
                    "must exit " + x.code.to_str() + ", and exited " + code.to_str() + "\n  its stderr was:\n" + err
                )
        .panics p =>
            if !strings.contains(text: err, needle: p.message)
                return ok("must abort saying `" + p.message + "`, and said:\n" + err)

            if code == 0
                return ok(
                    "must not exit 0: an abort that returns success is the silent wrong answer this case exists to catch"
                )

    return fail(code: "met", msg: "the run matched its expectation")

# What the `--sanitize` run must satisfy, for a case that declares one.
# Answers the failure, so the caller reads it the way it reads `unmet`.
#
# It asks for the text and nothing else. The exit code is deliberately
# unasserted: ASan aborts on Darwin and `_exit(1)`s on Linux, both measured
# at panel 173, and a case that pinned either would be red on the other
# platform for a reason that is not about the program.
function sanitizer_unmet(e: Expectation, err: str) -> str?
    if e.sanitizer.is_err()
        return fail(code: "none", msg: "this case declares no sanitiser report")

    if !strings.contains(text: err, needle: e.sanitizer.must())
        return ok(
            "must be caught by the sanitiser saying `" + e.sanitizer.must() + "`, and it said:\n" + err
        )

    return fail(code: "met", msg: "the sanitiser said what the case demands")

test "an expectation with no ending is stdout and exit 0"
    e = split("one\ntwo\n").must()
    assert e.stdout == "one\ntwo\n"
    assert e.ending == .silent
    assert unmet(e, out: "one\ntwo\n", err: "", code: 0).is_err()
    assert !unmet(e, out: "one\ntwo\n", err: "", code: 1).is_err()
    assert !unmet(e, out: "one\n", err: "", code: 0).is_err()

test "an empty expectation promises no output at all"
    e = split("").must()
    assert e.stdout == ""
    assert unmet(e, out: "", err: "", code: 0).is_err()
    assert !unmet(e, out: "x\n", err: "", code: 0).is_err()

test "!exit takes the code off the stdout and demands it"
    e = split("before\n!exit: 3\n").must()
    assert e.stdout == "before\n"
    assert e.ending == .exits(code: 3)
    assert unmet(e, out: "before\n", err: "", code: 3).is_err()
    assert !unmet(e, out: "before\n", err: "", code: 0).is_err()

test "!panic asks stderr for the message and refuses a zero exit"
    e = split("half\n!panic: index 5 is out of bounds\n").must()
    assert e.stdout == "half\n"
    assert unmet(e, out: "half\n", err: "hero: index 5 is out of bounds\n", code: 134).is_err()

    # The right message at exit 0 — an abort that returned success.
    assert !unmet(e, out: "half\n", err: "hero: index 5 is out of bounds\n", code: 0).is_err()

    # Aborted, but about something else.
    assert !unmet(e, out: "half\n", err: "hero: divide by zero\n", code: 134).is_err()

test "a malformed ending is a broken case, not a silent one"
    assert split("x\n!exit: three\n").is_err()

    # `!exit` without the space is ordinary output, not an ending.
    assert split("x\n!exit:3\n").must().ending == .silent

# Panel 173's line, and the three things it has to get right: it comes off
# the stdout, it sits BEFORE the ending so a case may declare both, and an
# ordinary case is untouched by it.
test "!sanitizer takes its needle off the stdout and sits before the ending"
    e = split("1\n!sanitizer: bad-free\n!panic: still live\n").must()
    assert e.stdout == "1\n"
    assert e.ending == .panics(message: "still live")
    assert !e.sanitizer.is_err()
    assert e.sanitizer.must() == "bad-free"

    # A case may declare the sanitiser with no ending at all.
    only = split("1\n!sanitizer: heap-use-after-free\n").must()
    assert only.stdout == "1\n"
    assert only.ending == .silent
    assert only.sanitizer.must() == "heap-use-after-free"

    # And an ordinary case declares none, which is what keeps the refusal
    # in place everywhere it belongs.
    assert split("1\n!panic: still live\n").must().sanitizer.is_err()
    assert split("one\ntwo\n").must().sanitizer.is_err()

test "a sanitiser line with nothing to assert is a broken case"
    assert split("x\n!sanitizer: \n").is_err()
    assert split("x\n!sanitizer:\n").must().sanitizer.is_err()

test "the sanitiser verdict asks for the text and says nothing about the code"
    e = split("1\n!sanitizer: bad-free\n!panic: still live\n").must()

    # Darwin aborts, Linux exits 1: neither is asserted, and the text is.
    assert sanitizer_unmet(e, err: "SUMMARY: AddressSanitizer: bad-free giveaway.h:3").is_err()
    assert !sanitizer_unmet(e, err: "AddressSanitizer: heap-use-after-free").is_err()

    # A case that declares nothing is not judged this way at all.
    assert sanitizer_unmet(split("1\n").must(), err: "anything").is_err()
