# What the environment clang reads may still do, and one edit no golden form
# can hold, asked of the compiler by `suite_special.hero` (panel 237's R2,
# defect 2344, 2026-11-08).
#
# **The environment's folders count among the folders a build names**, so a
# file there standing in for a header the compiler's C reads is refused
# (`tests/golden/unsupported/fixedbugs-2344-*`). What that must still let
# through is held here, every build's variables given to its compiler alone
# through `/usr/bin/env`, never set in this harness's process, since an empty
# `CPATH` is no unset (`case_setting.hero` has the measurement); a machine
# without it, Windows, steps aside.
#
# - **A binding's header found through `CPATH`**, the shape of the GNU
#   readline binding the compiler's own `machine_locked_path` note sends to
#   `CPATH` (panel 237's ffi-pragmatist, 2051 where libedit's header says
#   1026): `readline/readline.h` and the siblings it includes by angle, a
#   header this Mac's SDK also has, build and print the folder's value.
# - **Every folder clang searches on its own, named by `CPATH` at once**,
#   builds and prints `true`: a tie goes to the platform.
# - **A linker's edit through `CCC_OVERRIDE_OPTIONS`**, `-Wl,-S`, builds and
#   runs: every other edit goes through.
# - **An edit that fires only at `-O2`**, `s/-O2/-D<a kept name>/`, which the
#   `-###` question asked at `-O0` does not show, is refused from the job the
#   listing's `-v` prints; and the program built at `-O2` with no edit after
#   it panics at its overflow, where until then it read the objects the edit
#   had compiled under the same key and printed the wrong sum at exit 0.

use report
use shell
use strings

constant ENV: str
    "/usr/bin/env"

# The readline binding's shape: a group naming a header a folder of
# `CPATH`'s holds, read whole from there.
constant READLINE_PROGRAM: str
    "extern \"readline/readline.h\"\n    constant RL_READLINE_VERSION: i64\n\nfunction main()\n    print(RL_READLINE_VERSION)\n"

constant READLINE_FILES: [[str]]
    [
        ["/rl/readline/readline.h", "#include <readline/rlstdc.h>\n#include <readline/keymaps.h>\n#define RL_READLINE_VERSION 0x0803\n"]
        ["/rl/readline/rlstdc.h", "#define __RLSTDC_H 1\n"]
        ["/rl/readline/keymaps.h", "#include <readline/chardefs.h>\n"]
        ["/rl/readline/chardefs.h", "#include <ctype.h>\n#include <string.h>\n"]
    ]

constant TRUE_PROGRAM: str
    "function main()\n    b = true\n    print(b)\n"

constant PAST_THE_TOP: str
    "function main()\n    big: i64 = 9223372036854775807\n    print(big + args().len())\n"

constant KEPT_DEFINE: str
    "-D__builtin_add_overflow(a,b,r)=((*(r)=(a)+(b)),0)"

function the_environment_lets_through_what_it_must(@r: report.Report, scratch: str, compiler: str)
    label = "special/the environment clang reads lets a binding, the platform's folders and a linker's edit through, and an edit at -O2 is refused"

    if shell.exe_suffix() == ".exe"
        report.keep_skip(
            @r,
            label: label,
            detail: "  the builds start their compiler through `" + ENV + "`, which this platform has not"
        )
        return
    home = scratch + "/environment-2344"
    laid: ()? @= shell.remove_tree(home)

    if !laid.is_err()
        laid @ shell.mkdir_all(home + "/rl/readline")

    for pair in [["/readline.hero", READLINE_PROGRAM], ["/true.hero", TRUE_PROGRAM], ["/sum.hero", PAST_THE_TOP]]
        if !laid.is_err()
            laid @ write_file(path: home + pair[0], text: pair[1])

    for pair in READLINE_FILES
        if !laid.is_err()
            laid @ write_file(path: home + pair[0], text: pair[1])

    if laid.is_err()
        report.keep_failure(@r, label: label, detail: "  cannot lay the programs out under " + home)
        return
    wrong: [str] @= []
    own = clangs_own(scratch)

    if own.len() == 0
        wrong @ wrong.push("    clang printed no folder it searches on its own")

    for one in [["CPATH=" + home + "/rl", "/readline", "2051"], ["CPATH=" + own.join(":"), "/true", "true"], ["CCC_OVERRIDE_OPTIONS=#+-Wl,-S", "/true", "true"]]
        said = printed(scratch: scratch, compiler: compiler, variable: one[0], source: home + one[1], level: "-O0")

        if said != one[2]
            wrong @ wrong.push(
                "    `" + one[0] + "` over `" + one[1] + ".hero`: " + said + ", where it prints " + one[2]
            )

    edited = shell.run(
        scratch: scratch,
        program: ENV,
        words: [ENV, "CCC_OVERRIDE_OPTIONS=#s/-O2/" + KEPT_DEFINE + "/", compiler, "build", home + "/sum.hero", "-O2", "-o", home + "/sum-edited" + shell.exe_suffix()]
    )

    if edited.is_err() || edited.must().code != 1 || !strings.contains(text: edited.must().err, needle: "error[shadowed_macro]")
        wrong @ wrong.push(
            "    an edit firing at `-O2` alone: " + shell.ending(edited) + ", where it is refused `shadowed_macro`"
        )
    clean = printed(scratch: scratch, compiler: compiler, variable: "", source: home + "/sum", level: "-O2")

    if !strings.starts_with(text: clean, prefix: "panic: integer overflow")
        wrong @ wrong.push("    the same program at `-O2` with no edit, after it: " + clean + ", where it panics")

    if wrong.len() > 0
        report.keep_failure(@r, label: label, detail: "  " + wrong.join("\n"))
        return
    report.keep_pass(@r)

# What `source` + `.hero` prints, built at `level` with `variable`, `NAME=VALUE`
# or none, given to its compiler alone: its first line, or how the build or
# the run ended.
function printed(scratch: str, compiler: str, variable: str, source: str, level: str) -> str
    binary = source + "-" + level.slice(from: 1, to: level.len()) + shell.exe_suffix()
    words: [str] @= [ENV]

    if variable.len() > 0
        words @ words.push(variable)
    words @ words.push(compiler).push("build").push(source + ".hero").push(level).push("-o").push(binary)
    made = shell.run(scratch: scratch, program: ENV, words: words)

    if made.is_err() || made.must().code != 0
        return "the build ended " + shell.ending(made)
    ran = shell.run(scratch: scratch, program: binary, words: [binary, "one"])

    if ran.is_err()
        return "the binary did not run: " + shell.refusal(ran)
    said: str @= strings.trimmed(ran.must().out)

    if ran.must().code != 0
        said @ strings.trimmed(ran.must().err)
    lines = strings.split_on(text: said, byte: 10)
    return lines[0]

# The folders clang searches on its own for `<...>`, as `clang -v` prints
# them for an empty C file, a framework folder's mark taken off.
function clangs_own(scratch: str) -> [str]
    out: [str] @= []
    empty = scratch + "/environment-2344-empty.c"

    if write_file(path: empty, text: "").is_err()
        return out
    said = shell.run(
        scratch: scratch,
        program: "clang",
        words: ["clang", "-v", "-E", "-x", "c", empty, "-o", scratch + "/environment-2344-empty.i"]
    )

    if said.is_err()
        return out
    inside: bool @= false

    for row in strings.split_on(text: said.must().err, byte: 10)
        line = strings.trimmed(row)

        if line == "#include <...> search starts here:"
            inside @ true
        else if line == "End of search list."
            inside @ false
        else if inside && line.len() > 0
            out @ out.push(strings.without_suffix(text: line, suffix: " (framework directory)"))

    return out
