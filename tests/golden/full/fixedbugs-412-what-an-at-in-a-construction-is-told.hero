# Defect 412, lane b13-zero401, 2026-10-06: the whole form of what an `@`
# handed to a construction is told. The argument is quoted as written, the
# drop of its `@` offered as a guess, and `rest: @zero`, which is not the
# words, says what the words take.

extern "fixedbugs-412.h"
    record Pair tag pair
        a: i32
        b: i32

record Point
    x: i64
    y: i64

function main()
    n: i64 @ 1
    zero: i32 @ 0
    p = Point(x: @n, y: 2)  #~ marker_mismatch
    q = Pair(a: 1, rest: @zero)  #~ marker_mismatch
    print(p.x, q.a)
