# Fixed defect 552, 2026-10-09: the whole form of a form inside a generic
# function's argument, and of one inside a UFCS receiver, each told what the
# literal around it takes its type from, and each guess binding the whole
# argument or value first with the parameter's own type, never the form alone
# (`check/fixedbugs-552-a-form-inside-a-generic-function-s-argument-names-it`
# holds every shape).

function g<A>(x: A, ns: [i64?]) -> A
    _ = ns.len()
    return x

function h(ns: [i64?]) -> i64
    return ns.len()

function main()
    print(g(x: 1, ns: [ok(1)]))  #~ cannot_infer
    print([ok(1)].h())  #~ cannot_infer
