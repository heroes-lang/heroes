#~ shadowed_header
# fixedbugs, defect 2447, lane b30-shadow, 2026-11-10 (panel 243's R3): the
# shape beside `d` and `e`. `lib/clock.h` writes `#include "sys/timeb.h"`, C
# finds no `lib/sys/timeb.h` and searches, and the program's folder answers
# before the system's: the quoted form fell back to the search, as the angle
# form does, so the file stands in for the system's `sys/timeb.h` and is
# refused. Its message tells the include as written, in quotes, where it named
# the angle form; its note offers the path from the header's own folder,
# `"../sys/timeb.h"`, which C reads from there and the rule takes as its own;
# this line is its mark.

extern "lib/clock.h"
    constant CLOCK_TICKS: i64

function main()
    print(CLOCK_TICKS)
