#~ shadowed_header
# fixedbugs, defect 2447, lane b30-shadow, 2026-11-10 (panel 243's R3, the
# completeness critic's `live`): the program's `sys/clock.h` reads its guarded
# sibling `types.h`, its own, and then the SDK's `<sys/socket.h>` includes
# `<sys/types.h>`, which the program's folder answers: the guard skips that
# second open and the SDK's header reads the program's file in its own place.
# `-H` listed the file at its first open alone and the rule judged that open
# alone, so with the program's group first it built at exit 0, printing 42
# and 2; every include is judged now, the skipped one listed by
# `-fshow-skipped-includes`. Refused in this order and the other; this line is
# its mark.

extern "sys/clock.h"
    constant CLOCK_TICKS: i64

extern "sys/socket.h"
    constant AF_INET: i64

function main()
    print(CLOCK_TICKS)
    print(AF_INET)
