# FIXED DEFECT 2421's `@` shape, 2026-11-10, lane b30-variadic.
#
# SYMPTOM: none new: an `@` parameter past a header's `...` has been refused
# since defect 2106 (decision 2107), here `slot_wide(count: i32, @n: i32)`
# over a body writing `int64_t` through it. Its note named *declares a
# `static inline` function*, which reads as a second declaration of the
# variadic (panel 052 refused one); it names the door every refusal past
# `...` names now, a function of a new name with a fixed prototype.
#
# FIX: the note of every refusal past `...` is one door (panel 243's R1,
# provisional, author ratification pending; `emit/ffi_past_prototype.hero`'s
# `door`): a header of the program's own defines a `static inline` function of
# a new name with a fixed prototype, taking `n` as a pointer to the C type the
# variadic writes through it, and the group binds that. The route is
# `tests/golden/run/fixedbugs-2106-a-variadic-function-is-called-through-a-prototype-of-ones-own.hero`.

extern "fixedbugs-2421-variadic.h"
    record Pair
        a: i32
        b: i32
    function slot_wide(count: i32, @n: i32) -> i64  #~ ffi_parameter_type

function main()
    p: Pair @= Pair(a: 1, b: 2)
    print(slot_wide(count: 1, n: @p.a))
    print(p.a)
    print(p.b)
