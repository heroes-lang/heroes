# fixedbugs, defect 563, lane b18-ffi, 2026-10-10 (panel 204's R3; the
# ffi-pragmatist's GMP on Linux, whose `gmp.h` declares `__gmpz_out_str` only
# after `stdio.h`).
#
# `fixedbugs-563-out.h` declares `out_str` only where `EOF` is defined, so
# read before the second group's `stdio.h` it declares nothing. Until
# 2026-10-10 this was told *`fixedbugs-563-out.h` declares no `out_str`*.
# The header is asked with the other group moved above it, and the move is
# told.
extern "fixedbugs-563-out.h"
    function out_str() -> i64  #~ ffi_unknown_name

extern "stdio.h"
    function puts(s: cstr lent) -> i32

function main()
    print(out_str())
