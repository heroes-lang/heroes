# fixedbugs, defect 2514, lane b35-ffi, 2026-11-13.
#
# SYMPTOM: a record whose `tag` names a typedef of a number, Darwin's
# `sigset_t`, was told *a record takes a typedef by its own name, with no
# `tag`*, `record sigset_t partial`, the form refused with the false note of
# `fixedbugs-2514-a-record-over-a-typedef-of-a-number`, so the reader went
# round the three refusals.
#
# CAUSE: the refused round asked whether the tag is a type name and not what
# the type is. It now asks that too, the width and kind the round asks of each
# field (`emit/field_asked.hero`), and a typedef of a number is told the number.

extern "fixedbugs-2514-kinds.h"
    record Mask tag mask2514_t partial  #~ ffi_unknown_tag
        x: i64

function main()
    print(1)
