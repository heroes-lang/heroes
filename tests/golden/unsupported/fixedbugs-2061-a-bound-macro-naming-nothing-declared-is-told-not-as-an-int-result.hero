# FIX: the walk ends at a name that is no macro, clang finds it undeclared,
# and the binding is told so before any reader of its declaration's lines.

extern "fixedbugs-2061-reach.h"
    function nowhere(x: f64) -> f64  #~ ffi_unknown_name

function main()
    print(nowhere(-3.0))
