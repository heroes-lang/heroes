# fixedbugs, defect 094, lane ffi13, 2026-10-06: a brace list with an element
# the record has no field for. C builds the record and drops the element,
# saying so only as a warning, so the accessor makes it an error and the
# author is told on the constant's line, with the header's line that spells
# the value. `internal error`, exit 2, before the repair.

extern "fixedbugs-094-values.h"
    record Pt tag pt
        x: i32
        y: i32
    constant PT_EXCESS: Pt  #~ ffi_constant_type

function main()
    print(PT_EXCESS.y)
