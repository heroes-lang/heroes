# The list as it stands, and the file's job is to keep proving that all of it arrives
# at once rather than one invocation at a time.
#
# Rewritten ten times, and each rewrite is the gate working — `str` and `f64` at M5b,
# `record` at M5c step 3, `array` at step 5, writing one element at step 6, `T?` and
# `{K: V}` at M5d, and at M6 step 3 the three built-ins that used to stand here
# (`sort`, `join`, `chars`) all acquired entry points. **Every type in the language
# emits, and every Tier-1 built-in emits**, so what is left is three different KINDS of
# refusal rather than three names:
#
#   1. a built-in refused by OPERAND TYPE — `sort` orders `int`, `f64` and `str`,
#      and a `[P]` has no order this backend has decided on (panel 027 R1). The
#      "refused by NAME" row can no longer fire at all: every one of the 23
#      reserved names now has an entry point, a library body, or a lowering, and
#      `emit/tests/gate.rs` asserts that partition instead of an example;
#   2. a GENERIC function and the six higher-order built-ins, which all emit now —
#      they are in the file to prove the two refusals are not about them;
#   3. a UNIT-typed container element, which has no C declaration at all — `void t0;`
#      is a hard error, so the type that occupies no storage is refused where a
#      storage location is required.
#      Three rows have stopped being refusable rather than been implemented around:
#      function values at M6 step 5 (a plain C function pointer), generics at step 6
#      (one copy per type tuple, no template left), and `extern` at M-ffi-ladder step 5 —
#      the one whose reason was a veto rather than a milestone, and what lifted it
#      was the `#include` arriving, exactly as §4.19 said it would.
#
# Everything else stays in the file deliberately: the record, the array, the element
# write, the map, the `T?` and the six built-ins that now emit all work, so their
# presence proves the refusals below are about those three capabilities and nothing
# else.
# Bulk regression case.

record P
    x: int

function add(a: int, b: int) -> int
    return a + b

function tag(p: P) -> int
    return p.x

function first<T>(items: [T]) -> T
    return items[0]

function main()
    p = P(x: 1)
    print(p.x)
    xs: [int] @ [1, 2]
    xs[0] @ 7
    print(xs[0], len(xs))
    m = {"a": 1}
    print(!m["a"].is_err(), m["a"].default(0))
    # These emit now, and are here to prove the refusals are not about them —
    # `range` among them, which is what step 4 changed.
    print(sort(xs)[0], join(chars("ab"), "-"), len(slice(xs, from: 0, to: 1)))
    print(to_int(1.5), to_f64(2), to_str(3))
    print(len(range(from: 0, to: 2)))
    ps = [P(x: 2), P(x: 1)]
    print(len(sort(ps)))      #~ builtin
    # A function value emits now, and stays here to prove the refusals are not
    # about it.
    f = add
    print(f(1, 2))
    print(len(map(ps, tag)))
    print(first(xs))
    us: [()] @ []      #~ unit_element
    print(len(us))
