# Three unsupported capabilities, three diagnostics, sorted by span: a message
# that carries the list is one round trip, and three invocations is three.
#
# Rewritten twice, and each rewrite is the gate working: at M5b the original's `str`
# and `f64` started emitting, and at M5c step 3 the `record` did. The `record P` stays
# in the file deliberately — it now emits, so it proves the three refusals below are
# about the three forms named and not about the program having an aggregate in it.
# Bulk regression case.

record P
    x: int

function main()
    p = P(x: 1)
    print(p.x)
    #~v array
    xs = [1, 2]
    print(xs[0])
    #~v map
    m = {"a": 1}
    print(m.has("a"))     #~ builtin
