# The list as it stands, and the file's job is to keep proving that all of it arrives
# at once rather than one invocation at a time.
#
# Rewritten six times, and each rewrite is the gate working — `str` and `f64` at M5b,
# `record` at M5c step 3, `array` at step 5, writing one element at step 6, `T?` and
# `{K: V}` at M5d. **Every type in the language now emits**, so what is left is
# built-ins with no runtime entry point, and the name of this file is now about the
# shape of the assertion rather than a headcount.
#
# The record, the array, the element write, the map and the `T?` all stay in the file
# deliberately: every one of them emits, so their presence proves the refusals below
# are about the three named built-ins and not about the program's types.
# Bulk regression case.

record P
    x: int

function main()
    p = P(x: 1)
    print(p.x)
    xs: [int] @ [1, 2]
    xs[0] @ 7
    print(xs[0], len(xs))
    m = {"a": 1}
    print(has(m, "a"), m["a"].default(0))
    print(sort(xs)[0])        #~ builtin
    print(join(["a"], "-"))   #~ builtin
    print(chars("ab")[0])     #~ builtin
