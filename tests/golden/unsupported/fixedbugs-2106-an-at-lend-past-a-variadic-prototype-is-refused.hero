# FIXED DEFECT 2106, 2026-10-17, lane land215.
#
# SYMPTOM: `va_wide(k: i32, @n: i32)` over a header's `int64_t va_wide(int32_t
# k, ...)`, whose body writes `*va_arg(ap, int64_t *) = -1`, handed `n: @p.a`,
# a 4-byte field of a local record, built at exit 0 and printed `-1` for
# `p.b`, the field beside it; `n: @xs[0]` the same for `xs[1]`; under
# `--sanitize` both exited 0 alike, the write staying inside one object.
#
# CAUSE: what an `@` parameter points at is held to the header's own type, its
# width and sign, and past a variadic header's `...` there is none: C reads the
# pointer as whatever type it asks for, and the width question was dropped in
# silence. A local lent there is fenced and aborts when C writes past it; a
# field, an element and a narrower write are not seen.
#
# FIX: an `@` parameter past the `...` is refused on its declaration as
# `ffi_parameter_type`, the scalar and the record alike, the note naming a
# header of the program's own whose prototype holds the width
# (`emit/ffi_past_prototype.hero`). That route is
# `tests/golden/run/fixedbugs-2106-a-variadic-function-is-called-through-a-prototype-of-ones-own.hero`.

extern "fixedbugs-2106-variadic.h"
    record Pair
        a: i32
        b: i32
    function va_wide(k: i32, @n: i32) -> i64  #~ ffi_parameter_type
    function va_pair(k: i32, @p: Pair) -> i64  #~ ffi_parameter_type

function main()
    p: Pair @= Pair(a: 1, b: 2)
    print(va_wide(k: 1, n: @p.a))
    print(va_pair(k: 2, @p))
    print(p.b)
