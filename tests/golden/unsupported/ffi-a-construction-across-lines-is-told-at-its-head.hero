# Panel 186 R7, lane land186, 2026-10-02: a group's record over a C union is
# built naming exactly one member of each union, an anonymous struct's fields
# counting as one, and every field outside them (spec § 13). What a
# construction leaves out is judged by `build`, from the header's layout, at
# the construction (`selfhost/emit/layout_sites.hero`).
#
# A construction written across lines is told at its first, where the
# record's name is.

extern "ffi-a-construction.h"
    record SA
        kind: i32
        i: i32
        f: f32
        x: i32
    function sa_f(s: SA) -> f32
    function sa_x(s: SA) -> i32

function main()
    b = SA(  #~ missing_fields
        kind: 2,
        f: 1.5
    )
    print(sa_f(b))
