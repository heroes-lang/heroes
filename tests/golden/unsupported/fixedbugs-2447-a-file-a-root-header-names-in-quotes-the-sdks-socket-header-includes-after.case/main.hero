#~ shadowed_header
# fixedbugs, defect 2447, lane b30-shadow, 2026-11-10 (panel 243's R3, the
# compiler-engineer's `gg`): a root `clock.h` writes `#include
# "sys/types.h"`, its own file by the rule `g` lands, and the SDK's
# `<sys/socket.h>` reads the same file after it. Refused; this line is its
# mark.

extern "clock.h"
    constant CLOCK_TICKS: i64

extern "sys/socket.h"
    constant AF_INET: i64

function main()
    print(CLOCK_TICKS)
    print(AF_INET)
