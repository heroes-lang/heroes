# UNVERIFIED — pending debrief
# Panel 215's R2, issue 1335, 2026-10-16, adversarial: a C function taking
# the record by value is the header's own signature, and its binding is not
# refused (refusing it refused a binding that builds, the sitting's
# ffi-pragmatist measured); the call that hands C a copy is told at its
# argument.

extern "ffi-lock-copied.h"
    record Box tag box partial
        n: i64
    function box_init(@b: Box) -> i32
    function box_peek(b: Box) -> i64

function main()
    m: Box @= Box(n: 3, rest: zero)
    _ = box_init(@m)
    print(box_peek(m))  #~ ffi_lock_copied
