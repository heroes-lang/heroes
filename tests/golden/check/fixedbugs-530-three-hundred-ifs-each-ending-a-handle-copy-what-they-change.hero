function beside(c: bool)
    x = f_open()
    y = f_open()

    if c
        f_close(x: x)

    if c
        z = f_open()
        f_close(x: z)
    else
        f_close(x: y)
        y2 = f_open()
        f_close(x: y2)
        f_close(x: x)
    print(f_peek(x: x))
    print(f_peek(x: y))

function main()
    ended(true)
    looped(true)
    beside(true)
