# Panel 181 (2026-09-28, provisional): outside brackets a line ends its
# statement, in both directions. A line that ends where its statement
# cannot, and a line that begins with a token that can only go on with the
# line above, are one mistake, refused by one diagnostic at the line break,
# `continuation_outside_brackets`, with the two lines handed to the parser as
# the one the author broke. Every shape here is refused with exactly one
# diagnostic, and every fix here is `certain`: the next line cannot stand
# alone, so joining the two is the only repair, and `x.fixed` is this file
# with each break written on one line (`selfhost/open_line.hero`).

record P
    x: i64

variant S
    a
    b
    c

## The line ends where its statement cannot

# At the statement's own margin, where the next line reads as a new one.
function same_margin(a: i64) -> i64
    #~v continuation_outside_brackets
    y = a +
    1
    return y

# One level deeper, where it reads as a block.
function deeper(a: i64) -> i64
    #~v continuation_outside_brackets
    y = a *
        2
    return y

# Across a blank line, which is no line at all.
function across_a_blank_line(a: i64) -> i64
    #~v continuation_outside_brackets
    y = a -

    3
    return y

# A block head's condition, broken before its body.
function condition(a: i64, b: bool) -> i64
    #~v continuation_outside_brackets
    if a > 0 &&
    b
        return 1
    return 0

# A loop's iterable, after `in`.
function iterable(xs: [i64]) -> i64
    total: i64 @= 0

    #~v continuation_outside_brackets
    for x in
    xs
        total @ total + x
    return total

# A header's result type, after `->`, at the declaration's own column.
#~v continuation_outside_brackets
function header(a: i64) ->
i64
    return a

# An arm's inline value, after `=>`, at the arm's margin.
function arm(s: S) -> i64
    return match s
        #~v continuation_outside_brackets
        .a =>
        1
        .b => 2
        .c => 3

## The next line can only go on with the line above

# A binary operator at the head of the line, the way PEP 8 and Black break.
function leading_operator(a: i64) -> i64
    y = a
    + 4  #~ continuation_outside_brackets
    return y

# A `-` set apart from its operand, which the spec never lets open a line.
function leading_minus(base: i64, fee: i64) -> i64
    total = base
    - fee  #~ continuation_outside_brackets
    return total

# A condition broken before its `&&`, the body below.
function leading_and(a: i64, b: bool) -> i64
    if a > 0
    && b  #~ continuation_outside_brackets
        return 1
    return 0

# The `?` that propagates, alone on its line.
function half(n: i64) -> i64?
    return ok(n / 2)

function leading_question(n: i64) -> i64?
    m = half(n: n)
    ?  #~ continuation_outside_brackets
    return ok(m)

# The `::` that names a field.
function leading_colons() -> str
    name = P
    ::x  #~ continuation_outside_brackets
    return name

# A pattern joined by `|` at the head of the next arm line.
function leading_pipe(s: S) -> i64
    return match s
        .a
        | .b => 1  #~ continuation_outside_brackets
        .c => 2

function main()
    print(same_margin(a: 1) + deeper(a: 1) + across_a_blank_line(a: 5) + header(a: 1))
    print(condition(a: 1, b: true) + iterable(xs: [1, 2]) + arm(s: .a))
    print(leading_operator(a: 1) + leading_minus(base: 100, fee: 7) + leading_and(a: 1, b: true))
    print(leading_question(n: 4).must() + leading_pipe(s: .b))
    print(leading_colons())
