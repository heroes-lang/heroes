# Fixed 2026-10-07, defect 264, lane b14-check.
# Symptom: every lookup of a built-in by name or by index built the whole
# table of forty-one built-ins again: 137,680 tables in the compiler's own
# check, about six per built-in call along a chain of them.
# Cause: the inventory was the body of a function, `inventory.table()`. The
# names are now a constant clang lays out once, which `index_of` and
# `name_of` read without building anything, and `labelled_of` builds only
# the entry it answers with.
# This case: a chain of 2,000 built-in calls, the floor panel 184's R6
# measured, and each message that names a built-in it found by a lookup:
# the labels of `fail` and `slice`, a built-in read as a value, and a lend
# that stands outside a call.

extern "string.h"
    function strlen(s: cstr lent) -> u64

function first(xs: [str]) -> str?
    if xs.len() == 0
        return fail("empty", "no first element")  #~ needs_label needs_label
    return ok(xs[0])

