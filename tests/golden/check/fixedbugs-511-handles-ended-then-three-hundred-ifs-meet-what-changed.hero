    f_close(x: a299)  #~ handle_used_after_end
    return t

function nested(c: bool, d: bool)
    x = f_open()
    y = f_open()

    if c
        f_close(x: x)

        if d
            f_close(x: y)
        else
            f_close(x: y)
    else
        f_close(x: x)
        f_close(x: y)
    f_close(x: x)  #~ handle_used_after_end
    f_close(x: y)  #~ handle_used_after_end

function picked(p: Pick)
    m = f_open()
    n = f_open()

    match p
        .left =>
            f_close(x: m)
            f_close(x: n)
        .right => f_close(x: m)

    f_close(x: m)  #~ handle_used_after_end
    f_close(x: n)

function shorted(c: bool)
    q = f_open()
    r = f_open()
    f_close(x: r)

    if c && f_done(x: q)
        f_close(x: r)  #~ handle_used_after_end
    f_close(x: q)

function main()
    print(many(true))
    nested(c: true, d: false)
    picked(.left)
    shorted(true)
