# UNVERIFIED — pending debrief
# Adversarial case for panel 017's two flow rules, which are easy to get
# backwards. A jump has **no type**: an `int`-valued `match` with a `return` arm
# is legal, and typing the jump `()` — RFC 1216's recorded wrong turn — would
# reject it. But a construct whose **every** branch jumps produces nothing, and
# binding that is the error. Then the mirror pair: a `()` value cannot be bound
# (017 C, Nim's rule), and a non-`()` value alone on a line cannot be discarded
# silently (panel 003).
variant Token
    num
        v: int
    eof

function nothing_to_bind(t: Token) -> int
    tag = match t
        .num _ => return 1
        .eof   => return 0
    return tag

function bound_nothing(xs: [int]) -> int
    done = print("counting")
    print(done)
    xs.push(4)
    return xs.len()
