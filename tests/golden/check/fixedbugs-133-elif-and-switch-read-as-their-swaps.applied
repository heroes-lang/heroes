# Fixed defect 133's class, 2026-09-29, `elif` and `switch` (lane 133's
# finding). Symptom: `elif` after an `if`'s block cost the lexer's
# `reserved_word` and then `unexpected_block` for its body and
# `expected_expression` at the `else` below; `switch` cost `reserved_word`
# and `unexpected_block` for its arms; and each construct's own mistakes were
# reported only once `check --apply` had written `else if` or `match`. Cause:
# the parser read the construct as the refused word it was. It now reads it
# as the certain swap writes it, as the top level reads `fn` as `function`
# (`parse/swap_reading`, asked through `foreign_at`): `elif` opening its line
# in an `if`'s chain is its `else if`, and `switch` where an expression
# begins is its `match`. One shape per function, a mistake of its own in
# some.

function an_elif(x: i64)
    if x == 1
        print(1)
    else if x == 2  #~ reserved_word
        print(2)
    else
        print(3)

function two_elifs(x: i64)
    if x == 1
        print(1)
    else if x == 2  #~ reserved_word
        print(2)
    else if x == 3  #~ reserved_word
        print(3)

function an_elif_with_its_own_mistake(x: i64)
    if x == 1
        print(1)
    else if x == )  #~ reserved_word expected_expression
        print(2)

function an_elif_over_a_body_with_a_mistake(x: i64)
    if x == 1
        print(1)
    else if x == 2  #~ reserved_word
        y = 3 )  #~ expected_end_of_line

function an_elif_in_a_value(x: i64) -> i64
    return if x == 1
        1
    else if x == 2  #~ reserved_word
        2
    else
        3

function a_switch(x: i64) -> i64
    return match x  #~ reserved_word
        1 => 2
        _ => 3

function a_switch_with_a_bad_arm(x: i64) -> i64
    return match x  #~ reserved_word
        + => 2  #~ expected_pattern
        _ => 3

function main()
    an_elif(x: 1)
    two_elifs(x: 1)
    an_elif_with_its_own_mistake(x: 1)
    an_elif_over_a_body_with_a_mistake(x: 1)
    print(an_elif_in_a_value(x: 1) + a_switch(x: 1) + a_switch_with_a_bad_arm(x: 1))
