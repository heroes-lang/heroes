# Bulk regression case (assistant-written): `x.f(y)` is `f(x, y)` (§4.11), so
# an unknown name after the dot is answerable before any type exists — and the
# message teaches the rewrite rather than naming a receiver type the language
# does not have. The `h.cb(n)` call is the control: `cb` IS a field somewhere in
# this file and a field can hold a function value (§4.13), so the resolver must
# stay silent and leave it to M3c.
record Holder
    cb: (function(i64) -> i64)

function run(h: Holder, n: i64) -> i64
    m: {str: i64} @ {}
    m.set("a", 1)  #~ unknown_function
    return h.cb(n)
