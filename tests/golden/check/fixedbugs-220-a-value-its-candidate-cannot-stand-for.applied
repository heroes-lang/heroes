    width: i64 = True  #~ unknown_name
    print(flag, width)
    ys = items.map(double)  #~ unknown_name
    zs = items.map(shuot)  #~ unknown_name
    print(ys.len() + zs.len())
    p: Point = Point(x: 1, y: 2)  #~ unknown_type
    a: Amont = 5  #~ unknown_type
    print(p.x + a.n)
    counter: i64 @ 0
    label: str @ ""
    counter @ 5  #~ unknown_name
    lable @ 5  #~ unknown_name
    print(counter, label)
    fs = [2.0, 1.0]
    hs = sort(fs)  #~ unknown_name
    print(hs.len())
    gs = sqrt(fs)  #~ unknown_name
