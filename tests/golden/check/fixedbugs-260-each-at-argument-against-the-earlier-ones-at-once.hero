    c63: i64 @ 63
    many(v00: @c00, v01: @c01, v02: @c02, v03: @c03, v04: @c04, v05: @c05, v06: @c06, v07: @c07, v08: @c08, v09: @c09, v10: @c10, v11: @c11, v12: @c12, v13: @c13, v14: @c14, v15: @c15, v16: @c16, v17: @c17, v18: @c18, v19: @c19, v20: @c20, v21: @c21, v22: @c22, v23: @c23, v24: @c24, v25: @c25, v26: @c26, v27: @c27, v28: @c28, v29: @c29, v30: @c30, v31: @c31, v32: @c32, v33: @c33, v34: @c34, v35: @c35, v36: @c36, v37: @c37, v38: @c38, v39: @c39, v40: @c40, v41: @c41, v42: @c42, v43: @c43, v44: @c44, v45: @c45, v46: @c46, v47: @c47, v48: @c48, v49: @c49, v50: @c50, v51: @c51, v52: @c52, v53: @c53, v54: @c54, v55: @c55, v56: @c56, v57: @c57, v58: @c58, v59: @c59, v60: @c60, v61: @c61, v62: @c62, v63: @c63)
    print(p.x, q.y, xs[0], ys[0], c00 + c63)
