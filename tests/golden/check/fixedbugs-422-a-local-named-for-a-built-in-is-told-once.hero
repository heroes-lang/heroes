# fixedbugs, defect 422, lane b13-zero401, 2026-10-06, found by lane
# b13-fixed405.
#
# SYMPTOM: `args: i64 @= 1`, then `args @ 2` and `args @ 3`, was told
# `builtin_name_taken` at the binding and `no_mutable_globals` at each write,
# the writes saying `args` was a top-level declaration: three messages for
# one name. So for a parameter, an `@` argument, a field's write, any name a
# built-in holds, and a local named for a top-level declaration.
#
# CAUSE: the binding was refused and left unbound, so every later mention
# meant the built-in or the declaration, and a write to either is refused.
#
# FIX: the name is told once, at the binding, and bound all the same, as a
# local named for a `use` already was: what follows in its scope is the
# binding's. Whether it is read is asked once it is renamed, so the first,
# which never reads its cell, is one message too. Each function below binds
# one such name (`any` reported by lane b13-fixed405); the last is a name no
# built-in holds, unchanged.

record P
    x: i64

variant V
    one
        x: i64

function helper() -> i64
    return 1

function bump(@n: i64)
    n @ n + 1

function written_never_read()
    args: i64 @= 1  #~ builtin_name_taken
    args @ 2
    args @ 3

function written_and_read() -> i64
    args: i64 @= 1  #~ builtin_name_taken
    args @ 2
    args @ 3
    return args

function a_built_in_written_in_heroes() -> bool
    any: bool @= false  #~ builtin_name_taken
    any @ true
    return any

function a_runtime_built_in() -> i64
    len: i64 @= 1  #~ builtin_name_taken
    len @ len + 1
    return len

function a_parameter(@args: i64)  #~ builtin_name_taken
    args @ args + 1

function a_loop_variable() -> i64
    total: i64 @= 0

    for range in [1, 2]  #~ builtin_name_taken
        total @ total + range

    return total

function a_payload(v: V) -> i64
    return match v
        .one print => print.x  #~ builtin_name_taken

function an_at_argument_and_a_field() -> i64
    sort: i64 @= 1  #~ builtin_name_taken
    bump(@sort)
    keys: P @= P(x: sort)  #~ builtin_name_taken
    keys.x @ 2
    return keys.x

function a_top_level_name() -> i64
    helper: i64 @= 1  #~ shadowed_binding
    helper @ 2
    return helper

function no_built_in() -> i64
    n: i64 @= 1
    n @ 2
    n @ 3
    return n

function main()
    n: i64 @= 1
    a_parameter(@n)
    written_never_read()
    print(written_and_read(), a_runtime_built_in(), a_loop_variable(), a_payload(.one(x: 1)))
    print(an_at_argument_and_a_field(), a_top_level_name(), no_built_in(), helper(), n, a_built_in_written_in_heroes())
