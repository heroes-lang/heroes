# Fixed defect 309, 2026-10-05 (lane b11-parse). Symptom: a function type
# with no parameter whose `)` was written past the result, `function( ->
# i64)`, was told `expected_type`, *expected a type, found `->`*, which names
# no move; with a parameter, `function(i64 -> i64)`, defect 197's repair says
# that the `)` goes before the `->`. Cause: `parse/type.function_params` read
# a parameter type at the `->` and refused it, and the `->` was then a report
# standing already. Repair: at a `->` right after the `(`, no parameter is
# read, and the `->` is told as 197's are, `function() -> i64`, under 197's
# code. Each shape below is told once for that `)`, beside its other mistakes:
# the bare type's parentheses, an outer `(` left open, a missing result,
# `fn`. A parameter list never closed has no `)` written past the result, and
# is told by the lexer's `unclosed_bracket` alone, as 197's is.

function repro(g: (function( -> i64)))  #~ expected_function_type_params_close
    print(1)

function bare(g: function( -> i64))  #~ expected_function_type_params_close expected_type
    print(1)

function outer_open(g: (function( -> i64))  #~ unclosed_bracket expected_function_type_params_close
    print(1)

function no_result(g: (function( -> )))  #~ expected_function_type_params_close expected_type
    print(1)

function nothing_closed(g: (function( -> i64  #~ unclosed_bracket unclosed_bracket unclosed_bracket
    print(1)

function generic<A>(g: (function( -> A)))  #~ expected_function_type_params_close
    print(1)

function as_a_result() -> (function( -> i64))  #~ expected_function_type_params_close
    print(1)

function as_a_binding(d: (function() -> i64))
    g: (function( -> i64)) @ d  #~ expected_function_type_params_close
    print(1)

record Holder
    g: (function( -> i64))  #~ expected_function_type_params_close

function swapped(g: (fn( -> i64)))  #~ reserved_word expected_function_type_params_close
    print(1)

function in_place(g: (function() -> i64))
    print(1)

function main()
    print(1)
