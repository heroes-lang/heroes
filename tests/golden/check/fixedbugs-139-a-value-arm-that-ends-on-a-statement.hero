# Fixed 2026-10-01, defect 139's class, lane flow (the first pass beside the
# item). Symptom: in a `match` used as a value, an arm that is one statement
# and neither jumps nor gives a value, `.blue => assert false` or `.blue => n
# @ 5`, checked clean, and `build` stopped on clang's *variable is used
# uninitialized*: on that path the binding took its value from nothing, and
# clang seeing the read was all that refused it. With every arm such a
# statement, `no_value` said *every branch jumps*, which none did. Cause: a
# branch carried divergence as an absent value, which an arm that ended on a
# statement has too, so the join skipped the one as the other (panel 017 R1:
# one join routine, divergence carried as data). Now `join.Branch` carries
# `jumps`: an arm that is one statement is told as a block's last line is, and
# *every branch jumps* is said only where every branch did.

variant Color
    red
    blue

function bound(c: Color) -> i64
    x = match c
        .red  => 1
        .blue => assert false

    return x

function typed(c: Color) -> i64
    x: i64 = match c
        .red  => 1
        .blue => assert false

    return x

function returned(c: Color) -> i64
    return match c
        .red  => 1
        .blue => assert false

function mutated(c: Color) -> i64
    n: i64 @= 0

    x = match c
        .red  => 1
        .blue => n @ 5  #~ no_value

    return x + n

# Two arms, two statements, two messages, and no *every branch jumps*.
function every_arm_a_statement(c: Color) -> i64
    x = match c
        .red  => assert false
        .blue => assert true  #~ no_value

    return x

function main()
    print(bound(c: .red))
    print(typed(c: .red))
    print(returned(c: .red))
    print(mutated(c: .red))
    print(every_arm_a_statement(c: .red))

# Corrected 2026-10-02, defect 174, lane flow4, below the program so its
# lines stay where they were, and by hand as panel 185's R5 says: under panel
# 184's R4 `assert false` ends a path, as `exit(code:)` and a `while true`
# nothing breaks do, so the four `assert false` arms of lines 21, 28, 35 and
# 49 leave, as a `return` there would, and are no longer refused; their
# annotations are taken off, and the lowering ends each with `unreachable`
# (`Checked.ends`). What this file pins still holds of the two arms that end
# on a statement that does not end a path, `n @ 5` and `assert true`, each
# told once at its line, and `every_arm_a_statement` is now one message and
# not two, the `assert true` arm's.
