# Adversarial case (panel 018). # UNVERIFIED — pending debrief.
# Guards the Python suite colon — the slip the blind experiment pre-registered
# above every other (12-18% of files). It must be loud on every block header,
# and the fix is certain: a `:` is never legal at a block boundary, so
# dropping it can never repair the wrong program.
record Point  #~ trailing_colon
    x: i64
    y: i64

function double(n: i64) -> i64  #~ trailing_colon
    return n * 2
