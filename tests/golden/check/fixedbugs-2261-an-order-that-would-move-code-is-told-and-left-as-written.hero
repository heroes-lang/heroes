# Defect 2261, the shapes beside its reproducer whose order is not applied.
# Where a value runs code, a call here, writing the values in the order
# declared would run it at another point among the values that are not
# literals, so the one message offers the order and `check --apply` writes
# nothing (`tests/harness/suite_fixes.hero`'s third answer). Where the values
# fit the positions they stand at and not the ones their labels name, the
# labels may be what is out of place, and renaming them is offered, not
# applied. A value that fits neither position keeps its own message.
function add2(a: i64, b: str) -> str
    return b + a.to_str()

function pair(first: i64, second: i64) -> i64
    return first - second

function noisy(n: i64) -> i64
    print(n)
    return n

function main()
    x = 3
    print(pair(second: noisy(2), first: noisy(10)))  #~ wrong_label
    print(pair(second: noisy(2), first: x))  #~ wrong_label
    print(add2(b: 1, a: "xy"))  #~ wrong_label
    print(add2(b: true, a: 1))  #~ wrong_label type_mismatch
