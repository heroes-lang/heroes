# Fixed defect 129, 2026-09-29, the coordinator's widening of its class (B).
# Symptom: a join whose operand is built of literals, not one literal alone,
# kept its `certain`: `x = a &&` over `-1`, over `1 + 2`, over `!1`, `x = a -`
# over `("s")`, and `while` over `1 + 2` joined to programs `check` refuses.
# Cause: only a lone literal was judged. A run of literals, a prefix operator
# on one, a bracketed run and a binary run that binds tighter than the join,
# takes its family by `selfhost/operand_families.hero`'s table
# (`selfhost/literal_operands.hero`), and a name beside a literal takes the
# literal's family, both sides of an operator being of one type (spec § 7):
# `x = a &&` over `1 + b`.
#
# Every join here is a `guess`, so `check --apply` writes the file back
# unchanged, and `tests/harness/suite_fixes.hero` asserts exactly that of a
# case with no `.fixed` or `.applied`: a join that turned `certain` again goes
# red there.

function negative(a: bool) -> bool
    #~v continuation_outside_brackets
    x = a &&
    -1
    return x

function sum(a: bool) -> bool
    #~v continuation_outside_brackets
    x = a &&
    1 + 2
    return x

function not_an_integer(a: bool) -> bool
    #~v continuation_outside_brackets
    x = a &&
    !1
    return x

function bracketed_string(a: i64) -> i64
    #~v continuation_outside_brackets
    x = a -
    ("s")
    return x

function a_name_beside_a_literal(a: bool, b: i64) -> bool
    #~v continuation_outside_brackets
    x = a &&
    1 + b
    return x

function condition(n: i64)
    #~v continuation_outside_brackets
    while
    1 + 2
        print(n)

function main()
    print(negative(a: true) || sum(a: true) || not_an_integer(a: true) || a_name_beside_a_literal(a: true, b: 1))
    print(bracketed_string(a: 1))
    condition(n: 1)
