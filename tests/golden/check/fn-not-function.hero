# Adversarial case, ratified by the author 2026-08-04.
# Guards panel 013: `fn` is one word with one meaning — an error — in BOTH
# positions, and the same certain fix repairs both. If `fn` ever becomes legal
# in a type, the registry starts asserting something false.
function apply(f: (fn(int) -> int), x: int) -> int  #~ reserved_word
    return f(x)

fn double(n: int) -> int  #~ reserved_word
    return n * 2
