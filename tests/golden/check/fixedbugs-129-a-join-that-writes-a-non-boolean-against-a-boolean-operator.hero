# Fixed defect 129, 2026-09-28, class (B). Symptom: `x = a &&` over `1` had its
# join `certain`, and `check --apply` wrote `x = a && 1`, which is
# `bad_operand`; so did `||` at the head of a line before `1`, `&&` before a
# string, and `!` before an integer. Cause: a join wrote an operator against
# a literal it takes under no type. `&&`, `||` and `!` take `true` or `false`
# alone (`selfhost/operand_families.hero`), so these joins are a `guess`.
#
# A golden cannot hold a `guess`: this `.expected` is `--brief`, which prints
# no certainty, and a `.fixed` must check clean. So what this file pins is one
# diagnostic per break; the certainties are held by `selfhost/lexer.hero`'s
# defect 129 tests, which lex the same shapes.

function and_over_an_integer(a: bool) -> bool
    #~v continuation_outside_brackets
    x = a &&
    1
    return x

function or_before_an_integer(a: bool) -> bool
    x = a
    || 1  #~ continuation_outside_brackets
    return x

function and_over_a_string(a: bool) -> bool
    #~v continuation_outside_brackets
    x = a &&
    "s"
    return x

function not_over_an_integer() -> bool
    #~v continuation_outside_brackets
    x = !
    1
    return x

function main()
    print(and_over_an_integer(a: true) || or_before_an_integer(a: true))
    print(and_over_a_string(a: true) || not_over_an_integer())
