# Fixed defect 130's class, 2026-10-01, ruling 1 of the recovery batches
# (lane recovery-b5's C2). Symptom: a `(` or a `[` left open inside a body in
# braces went unsaid behind the `{`'s one report (the audit's row 130-H-003),
# and the braces' `}`, wherever its line stood, was the one closer that
# counted. Cause: the lexer took the body's `{` for a bracket, so the `(`
# inside it was one more bracket open, and the lines below it were inside
# both. Repair: the lexer lays a body's braces out as the block their fix
# leaves (`selfhost/brace_layout.hero`), so a bracket left open in it is
# named where the next line at its statement's margin begins, as with no
# braces around it. A `}` closes the innermost braces open, wherever its
# margin stands; one alone on its line, and a `,` or `;` after it, is no line
# of the program, and a `}` after the braces closed is a closer of nothing,
# told. A `}` whose line goes on keeps the line's rest for what follows the
# braces, `} else {` read as the `else` of the `if` the braces close.

function paren() {  #~ missing_body
    x = (1 + 2  #~ unclosed_bracket
    print(x)
}

function list() {  #~ missing_body
    x = [1, 2,  #~ unclosed_bracket
    print(x)
}

function closers(n: i64) {  #~ missing_body
    if n == 1 {  #~ missing_body
        print(1)
    } else {  #~ missing_body
        print(2)
        }
}}  #~ expected_declaration

function main()
    paren()
