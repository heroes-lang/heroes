# Panel 194 R1 (M-buildable-structs), lane b13-bs, 2026-10-06: `rest: zero`
# ends a construction, after every field it names (spec § 13); anywhere else
# in the list the parser refuses it, `rest_not_last`.

extern "rest-zero-elsewhere.h"
    record Pair tag pair
        a: i32
        b: i32

function main()
    p = Pair(rest: zero, a: 1)  #~ rest_not_last
    print(p.a)
