# Panel 261's R3 (2026-11-26, ratified): a write of a place with itself is no
# write (spec § 5), so a cell whose one write is `v @ v`, an `@` parameter
# whose one write is `a @ a`, a field `a.n @ a.n` or an element `xs[0] @
# xs[0]` is `never_rebound`, told why, every repair a `guess` since the line
# stays; a write of the place with another value is a write, and a self-write
# beside a real one changes nothing.
record App
    n: i64

function touch(@a: App) -> i64  #~ never_rebound
    a @ a
    return a.n

function field_touch(@a: App) -> i64  #~ never_rebound
    a.n @ a.n
    return a.n

function written(@a: App) -> i64
    a.n @ a.n
    a.n @ a.n + 1
    return a.n

function main()
    v @= 0  #~ never_rebound
    v @ v
    print(v)
    xs @= [1, 2]  #~ never_rebound
    xs[0] @ xs[0]
    print(xs[0])
    w @= 1
    w @ w + 0
    print(w)
    app @= App(n: 0)
    print(touch(@app) + field_touch(@app) + written(@app))
