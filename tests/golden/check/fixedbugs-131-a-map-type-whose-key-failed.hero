# Fixed defect 131's class, 2026-09-29, a map type whose key is no type.
# Symptom: `a: {2: i64} @= {}` cost `expected_type` twice at the `2`, once
# for the key and once for the value, and the value after the `:` was never
# read, so `{2: [3]}` hid its second mistake. Cause: the key's reader leaves
# the token it refused under the cursor, the `:` owed after it was not asked
# for there, and the value's reader then refused that same token. Now a type
# asked for at a token a report already stands on says nothing more, and a
# key that refused leaves the map to resume at its own `:`, outside the
# brackets the key opened, so the value is read and says its own mistakes
# (`selfhost/parse/type.hero`).

function f(m: {2: i64}) -> i64  #~ expected_type
    return 1

function main()
    a: {2: i64} @= {}  #~ expected_type
    b: {str: {2: i64}} @= {}  #~ expected_type
    c: {[2]: i64} @= {}  #~ expected_type
    d: {2 3: i64} @= {}  #~ expected_type
    e: {2} @= {}  #~ expected_type
    g: {2: [3]} @= {}  #~ expected_type expected_type
    print(1)
