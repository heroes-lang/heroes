# Fixed 2026-10-11, defect 608, lane b20-check: the shape beside it in a
# `match` arm, a scope its payload opens, and in an `if` branch. Symptom:
# both were accepted as discards. Now each is told once, with the certain fix
# that writes `=`.

variant Shape
    circle
        r: i64
    dot

function f(x: i64) -> i64
    return x + 1

function main()
    s: Shape = .circle(r: 2)

    match s
        .circle c =>
            _ @= f(c.r)  #~ never_rebound
        .dot => print("dot")

    if f(0) > 0
        _ @= f(1)  #~ never_rebound
    print("done")
