# Bulk regression case (assistant-written): `f(@x)` WRITES `x` — the callee
# copies its result back into the argument (§4.8) — so the argument's root
# answers to the rule of the left of `@` (spec:88). A pattern binding is not a cell.
# Accepted until 2026-09-03: the program printed `2` at exit 0.
record Bag
    items: [str]

function add(@b: Bag, s: str)
    b.items @ b.items.push(s)

variant Holder
    some
        bag: Bag
    none

function reader(h: Holder)
    match h
        .some s =>
            add(@s.bag, "x")  #~ not_mutable
            print(s.bag.items.len())
        .none => print(0)

function main()
    reader(.some(bag: Bag(items: ["a"])))
