# fixedbugs, defect 412, lane b13-zero401, 2026-10-06: the shapes beside a
# construction's `@`, a function whose parameter has no `@`, called by name,
# with a label, through UFCS, through a value and as a built-in. Each was
# already refused, `marker_mismatch`, by the checker, and stays so: the
# construction is the one door the defect found, and this case pins the rest.

function f(x: i64) -> i64
    return x

function add(a: i64, b: i64) -> i64
    return a + b

function pick() -> (function(i64) -> i64)
    return f

function main()
    n: i64 @ 1
    m: i64 @ 2
    print(f(@n))  #~ marker_mismatch
    print(f(x: @m))  #~ marker_mismatch
    print(n.add(b: @m))  #~ marker_mismatch
    print(pick()(@n))  #~ marker_mismatch
    print(@n, m)  #~ marker_mismatch
