# Task 2312 (panel 235's R6, R19): an entry from the index by its `version`
# holding a `tag`, which only a git source has. The catalogue does not read,
# so it names no package, and the `use` that reaches through it is refused at
# its line.
use <json>/parse  #~ catalogue_refused

function main()
    print(parse.x().to_str())
