# Adversarial case, ratified by the author 2026-08-04 (panel 015).
# Guards the shadow ban in the three positions that matter: over
# a parameter, over a top-level name (which is in scope everywhere), and over a
# built-in. The two `for x in` loops are the control: they are SIBLINGS, not
# nested, so reusing `x` is legal and this file must report nothing about them.
# Java (JLS §6.4) and C# (CS0136) say the same thing in as many words.
constant MAX: i64
    64

function report(n: i64, xs: [i64], ys: [i64]) -> i64
    n = 1  #~ shadowed_binding
    MAX = 2  #~ shadowed_binding
    total: i64 @ 0
    for x in xs
        total @ total + x
    for x in ys
        total @ total + x
    return total + n + MAX
