# UNVERIFIED — pending debrief
# Adversarial case for the shadow ban in the three positions that matter: over
# a parameter, over a top-level name (which is in scope everywhere), and over a
# built-in. The two `for x in` loops are the control: they are SIBLINGS, not
# nested, so reusing `x` is legal and this file must report nothing about them.
# Java (JLS §6.4) and C# (CS0136) say the same thing in as many words.
MAX = constant: int
    64

report = function: (n: int, xs: [int], ys: [int]) -> int
    n = 1
    MAX = 2
    total: int @ 0
    for x in xs
        total @ total + x
    for x in ys
        total @ total + x
    return total + n + MAX
