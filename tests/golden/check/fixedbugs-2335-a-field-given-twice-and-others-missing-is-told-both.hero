# fixedbugs, defect 2335, 2026-11-08: one field given twice and the two
# others not at all. Two mistakes, each told: the rule of naming every field,
# which this construction breaks, and the second `a`.
record R
    a: i64
    b: i64
    c: i64

function main()
    r = R(a: 1, a: 2)  #~ missing_fields wrong_label
    print(r.a)
