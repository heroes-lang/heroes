# UNVERIFIED — pending debrief
# A label at a call made through a function VALUE whose type names nothing,
# which was accepted and ignored until panel 128 measured it: `f(nonsense: "a",
# rubbish: 2)` printed the arguments at exit 0, so a label there was not a claim
# about anything.
#
# Since defect 026's repair the sentence has a narrower subject, and that is
# what this case pins. A function type whose parameters CAN be confused — two
# of one type — carries names and every call through it is checked against
# them. This type's two are `str` and `i64`, so no argument can go to the wrong
# one, the type names none, and a label here claims a check nobody is doing.
# The fix is `certain`: the label goes, the value stays where it is, and the
# program does what it already did — which is why `.fixed` exists beside this
# file.
function report(code: str, at: i64) -> str
    return code + "/" + at.to_str()

function main()
    f: (function(str, i64) -> str) @ report
    print(f("a", 2))  #~ label_on_function_value label_on_function_value
