# Fixed 2026-10-01, defect 140, lane emit: the refusal half.
# Symptom: a refusal over records nested by value a thousand deep never
# came: `check` stopped at 134, *stack exhausted in
# checkpartial.reaches_within*, before any rule could speak.
# Cause: the walks that find what a type reaches recursed once per record;
# they keep a stack of their own now, and the rule is said at any depth.
# This case: a handle at the bottom of a map key.

extern "stdio.h"
    record File tag FILE
    function fclose(f: File consumes) -> i64

record R0
    f: File

record R1
    inner: R0

