# Fixed defect 130, 2026-09-28, a branch with no body before its `else`.
# Symptom: `if n > 0` with no body over `else` was named `missing_body` at the
# `else`, and then the `else` line and the block under it were dropped, with
# the mistake inside that block; so after an `else if` with no body. Cause:
# `grammar_expr.finish` dropped the line after the failed `if`, which was its
# own `else`; and once it no longer did, `if_expr`, which gave up at the first
# branch it could not read, left that `else` to be read as a statement of its
# own, refused a second time at the column of the first. The chain is read to
# its end, and the `if` is refused as a whole.

function if_before_else(n: i64)
    if n > 0
    else  #~ missing_body
        y = 3 )  #~ expected_end_of_line
    z = 4 )  #~ expected_end_of_line

function else_if_before_else(n: i64)
    if n > 0
        print(1)
    else if n < 0
    else  #~ missing_body
        y = 3 )  #~ expected_end_of_line
    z = 4 )  #~ expected_end_of_line

function main()
    print(1)
