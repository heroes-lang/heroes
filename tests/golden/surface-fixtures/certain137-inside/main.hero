# Defect 137: certain fixes that enclose others, inside a body. Each line
# used to come out of `check --apply` with text no fix proposed: the next
# line's first letter eaten, the `@` or the labels the inner fix wrote lost
# under the enclosing one, a closer left over. And the last line is a chain
# the checker reports at its first link alone, which one pass cut by one
# `.must()`. `main.fixed` is what one `--apply` writes now.
record Counter
    n: i64

function total(n: i64) -> i64
    return n + 1

function bump(@c: Counter) -> i64
    c.n @ c.n + 1
    return c.n

function copy_text(from: str, to: str) -> str
    return from + " -> " + to

function one() -> i64
    return 1

function main()
    xs = 4
    print(total(xs.must()).must())  #~ bad_operand bad_operand
    k: Counter @= Counter(n: 0)
    print(bump(k).must())  #~ bad_operand marker_mismatch
    print(copy_text("a", to: "b").default("none"))  #~ bad_operand needs_label
    print(one().must().must().must())  #~ bad_operand

# Corrected 2026-09-30, integrating lanes 136 and 135b, below the program so
# its lines stay where they were. Line 28 wrote `copy_text("a", "b")`, and
# defect 135's rule (`5ea6b86f`) makes both of its labels guesses: the two
# parameters are `str`, so either order is a reading. With `to:` written,
# `from` is the one label the position gives, so it stays certain, and the
# enclosing `.default("none")` is still made again from the text that label
# left: before defect 137's repair this line came out as
# `print(copy_text("a", to: "b")none"))`.
