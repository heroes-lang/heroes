# A package's mark on every shape a `use` line takes (panel 235's R1,
# M-package-manager step 2): alone, a path, renamed, and beside a module of
# the program's own. The probe's variants put a comment and a broken bracket
# at every place on these lines, and `fmt` prints the file back byte for byte.
use <json>/parse
use <json>/text/lines as lines
use <yaml>/load  # the loader

use geom

function main()
    print(parse.value() + lines.count() + load.size() + geom.area())
