# Panel 181, defect 119: `(5)` at the statement's margin after an `if` whose
# branches are functions, which ran as a call of the `if`'s value and
# printed 10, and on which `fmt` exited 2. A statement whose last part is a
# block ends with it, so `(5)` is a line of its own, a value nothing
# receives: refused once, by the rule that says so, and `fmt` formats the
# file at exit 0 with `(5)` a statement of its own, where it exited 2.

function double(n: i64) -> i64
    return n * 2

function triple(n: i64) -> i64
    return n * 3

function main()
    c: bool = true
    f = if c
        double
    else
        triple
    (5)  #~ discarded_value
    print(f(1))
