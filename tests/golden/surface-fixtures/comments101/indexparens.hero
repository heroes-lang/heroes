# A comment inside the author's parentheses inside index brackets (the third
# skeptic seat's `min1`, and 571 of the 575 refusals its parenthesis
# generator found over 83ac68c1). `fmt` dropped the parentheses, which bind
# nothing, and broke the line after `a`: the parser then skipped a line's
# end before a group's `)` and not before an index's `]`, so the output did
# not parse, exit 2; since panel 180 it skips one before both. The
# parentheses around a comment are kept now where the one-line text breaks:
# after the value, on a line of their own, beside an operand, around a sum,
# in a mutation's place, and nested.

function f(ys: [i64], a: i64, b: i64) -> i64
    x = ys[(a  # after the value
    )]
    y = ys[(
        a  # on the value's own line
    )]
    z = ys[(a
        # on a line of its own
    )]
    w = ys[b + (a  # beside an operand
    )]
    v = ys[(a + b  # after a sum
    )]
    zs: [i64] @ ys
    zs[(a  # in a place
    )] @ 1
    return x + y + z + w + v + zs[0]

function g(cards: [i64], i: i64, n: i64) -> i64
    return cards[((i  # nested
    ) + 2) % n]

function main()
    print(f(ys: [1, 2, 3, 4, 5, 6], a: 1, b: 2) + g(cards: [1, 2, 3], i: 0, n: 3))
