--- !tapi-tbd
# Panel 245's R3, 2026-11-11: a text stub of the platform's zlib, holding
# one name, so a folder the build names holds a library `z` on Darwin with
# no binary in the tree; the loader takes the platform's libz at run time.
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos, arm64e-macos ]
install-name:    '/usr/lib/libz.1.dylib'
current-version: 1.2.12
exports:
  - targets:     [ x86_64-macos, arm64-macos, arm64e-macos ]
    symbols:     [ _zlibVersion ]
...
