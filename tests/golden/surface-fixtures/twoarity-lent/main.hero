# Both arities of `printf`, one module lending its value read-only past the
# `...`: refused on that module's parameter, the other module's binding of the
# same C name left alone (defect 2102's reader, 2026-10-17).

use as_int
use as_text

function main()
    _ = as_int.say(format: "n = %d\n", value: 42)
    _ = as_text.say(format: "s = %s\n", value: "forty-two")
