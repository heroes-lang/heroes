# Defect 107 (panel 180's compiler-engineer and its critic, 2026-09-27): a
# comment after a `.` or a `::` where the only bracket around it is the
# author's parentheses. `fmt` dropped them, which bind nothing, and broke the
# line after the token the comment follows, so the next line stood at the
# statement's depth, where a margin is structure: `a = (p.  # a field` over
# `x)` was printed `a = p.` over an indented `x`, which does not parse, and
# `fmt` refused at exit 2. A value no bracket of the page holds is printed
# as a group now, inside the author's innermost pair around it: here as a
# binding's value, a declaration's, a mutation's, a `return`'s, an
# `assert`'s, a discarded one and an arm's, after the dot of a method, a
# field, a field's name and a variant case with and without its fields.

record Point
    x: i64
    y: i64

variant Op
    plus
    num
        v: i64

function size(xs: [i64]) -> i64
    return (xs.  # a return's
        len())

function main()
    xs = [1, 2, 3]
    p = Point(x: 4, y: 5)
    a = (p.  # a field
        x)
    b: str = (Point::  # a field's name
        y)
    c: i64 @= (xs.
        # on a line of its own
        len())
    c @ (p.  # a mutation's value
        y)
    op: Op = (.  # a case
        plus)
    num: Op = (.  # a case with its fields
        num(v: 6))
    assert (xs.  # an assert's
        len()) == 3
    _ = (xs.  # a discarded value
        len())
    k = 1
    d = match k
        1 => (p.  # an arm's value
            x)
        _ => 0
    print(size(xs: xs) + a + c + d)
    print(b)

    match op
        .plus  => print("plus")
        .num n => print(n.v)

    match num
        .plus  => print("plus")
        .num n => print(n.v)
