# Part 11's control arm RUNS this program (panel 226's R1, 2026-10-20): the
# strict build refuses it under `declared_place`, a thesis rule, and the control arm,
# `build --permissive`, gives the dropped rule the meaning the sitting's
# table pins: `p.x @= 2` on a field is the write `p.x @ 2`.
# The witness is the compiler-engineer's (w22-declared_place), one of 27 it ran before the
# resolution was written (`docs/panel/226-reports/compiler-engineer.md`).

record P
    x: i64

function main()
    p: P @= P(x: 1)
    p.x @= 2  #~ declared_place
    print(p.x)
