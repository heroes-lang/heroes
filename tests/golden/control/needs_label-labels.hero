# Part 11's control arm RUNS this program (panel 226's R1, 2026-10-20): the
# strict build refuses it under `needs_label`, a thesis rule, and the control arm,
# `build --permissive`, gives the dropped rule the meaning the sitting's
# table pins: arguments are read by position where their labels are missing or wrong.
# The witness is the compiler-engineer's (w13-labels), one of 27 it ran before the
# resolution was written (`docs/panel/226-reports/compiler-engineer.md`).

function pair(a: i64, b: i64) -> i64
    return a * 10 + b

function main()
    print(pair(1, 2))  #~ needs_label needs_label
    print(pair(b: 1, a: 2))  #~ wrong_label
