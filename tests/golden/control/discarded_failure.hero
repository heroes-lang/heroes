# Part 11's control arm RUNS this program (panel 226's R1, 2026-10-20): the
# strict build refuses it under `discarded_failure`, a thesis rule, and the control arm,
# `build --permissive`, gives the dropped rule the meaning the sitting's
# table pins: `_ = risky()` drops the failure and the program goes on.
# The witness is the compiler-engineer's (w20-discarded_failure), one of 27 it ran before the
# resolution was written (`docs/panel/226-reports/compiler-engineer.md`).

function risky(n: i64) -> i64?
    if n < 0
        return fail(code: "neg", msg: "negative")
    return ok(n)

function main()
    _ = risky(0 - 1)  #~ discarded_failure
    print(1)
