strings
    0  "zero"
    1  "one"
    2  "many"

function first_even_after(xs: [int], floor: int) -> int
    slots  i: int · v: int
    bb0  entry
        $t1: int = const 0
        store i <- $t1
        jump bb1
    bb1  while: test    preds bb0, bb5
        $t2: int = load i
        $t3: [int] = load xs
        $t4: int = call builtin len($t3)
        $t5: bool = lt $t2, $t4
        branch $t5 -> bb2 else bb3
    bb2  while: body    preds bb1
        $t6: [int] = load xs
        $t7: int = load i
        $t8: int = index! $t6, $t7
        store v <- $t8
        $t9: int = load i
        $t10: int = const 1
        $t11: int = add! $t9, $t10
        store i <- $t11
        $t12: int = load v
        $t13: int = load floor
        $t14: bool = le $t12, $t13
        branch $t14 -> bb5 else bb6
    bb3  while: exit    preds bb1, bb7
        $t21: int = const 0
        $t22: int = const 1
        $t23: int = sub! $t21, $t22
        return $t23
    bb4  if: join    preds bb6
        $t15: int = load v
        $t16: int = const 2
        $t17: int = rem! $t15, $t16
        $t18: int = const 0
        $t19: bool = eq $t17, $t18
        branch $t19 -> bb8 else bb9
    bb5  if: then    preds bb2
        jump bb1
    bb6  if: else    preds bb2
        jump bb4
    bb7  if: join    preds bb9
        jump bb3
    bb8  if: then    preds bb4
        $t20: int = load v
        return $t20
    bb9  if: else    preds bb4
        jump bb7

function named(n: int) -> str
    slots  $s0: int · $r0: str
    bb0  entry
        $t1: int = load n
        store $s0 <- $t1
        $t2: int = load $s0
        $t3: int = const 0
        $t4: bool = eq $t2, $t3
        branch $t4 -> bb2 else bb3
    bb1  match: join    preds bb2, bb4, bb6
        $t11: str = load $r0
        incref $t11
        $t15: str = load $r0
        decref $t15
        return $t11
    bb2  match: arm    preds bb0
        $t8: str = const str 0
        $t12: str = load $r0
        incref $t8
        store $r0 <- $t8
        decref $t12
        jump bb1
    bb3  match: test    preds bb0
        $t5: int = load $s0
        $t6: int = const 1
        $t7: bool = eq $t5, $t6
        branch $t7 -> bb4 else bb5
    bb4  match: arm    preds bb3
        $t9: str = const str 1
        $t13: str = load $r0
        incref $t9
        store $r0 <- $t9
        decref $t13
        jump bb1
    bb5  match: test    preds bb3
        jump bb6
    bb6  match: arm    preds bb5
        $t10: str = const str 2
        $t14: str = load $r0
        incref $t10
        store $r0 <- $t10
        decref $t14
        jump bb1
