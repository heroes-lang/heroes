function set_cell(@g: Grid, r: i64, c: i64, v: i64)
    bb0  entry
        $t1: i64 = load r
        $t2: i64 = load c
        $t3: i64 = load v
        store g.rows[$t1].cells[$t2] <- $t3
        copyout g
        return

function cell_of(g: Grid, r: i64, c: i64) -> i64
    bb0  entry
        $t1: Grid = load g
        $t2: [Row] = field $t1.rows
        $t3: i64 = load r
        $t4: Row = index! $t2, $t3
        $t5: [i64] = field $t4.cells
        $t6: i64 = load c
        $t7: i64 = index! $t5, $t6
        return $t7
