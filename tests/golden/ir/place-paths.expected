function set_cell(@g: Grid, r: i64, c: i64, v: i64)
    bb0  entry
        $t1: i64 = load r
        $t2: i64 = load c
        $t3: i64 = load v
        store g.rows[$t1].cells[$t2] <- $t3
        copyout g
        return

function cell_of(g: Grid, r: i64, c: i64) -> i64
    bb0  entry
        $t1: [Row] = load g.rows
        $t2: i64 = load r
        $t3: Row = index! $t1, $t2
        $t4: [i64] = field $t3.cells
        $t5: i64 = load c
        $t6: i64 = index! $t4, $t5
        return $t6
