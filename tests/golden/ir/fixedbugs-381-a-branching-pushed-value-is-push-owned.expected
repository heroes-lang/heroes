strings
    0  "odd"

function half(n: i64) -> i64?
    slots  $ret0: i64? · $own2: i64? · $own3: i64?
    bb0  entry
        $t1: i64 = load n
        $t2: i64 = const 2
        $t3: i64 = rem! $t1, $t2
        $t4: i64 = const 0
        $t5: bool = eq $t3, $t4
        branch $t5 -> bb2 else bb3
    bb1  if: join    preds bb3
        $t10: str = const str 0
        $t11: str = const str 0
        incref $t10
        incref $t11
        $t12: i64? = construct fail($t10, $t11)
        $t14: i64? = load $own2
        store $own2 <- $t12
        decref $t14
        store $ret0 <- $t12
        jump bb4
    bb2  if: then    preds bb0
        $t6: i64 = load n
        $t7: i64 = const 2
        $t8: i64 = div! $t6, $t7
        $t9: i64? = construct ok($t8)
        $t15: i64? = load $own3
        store $own3 <- $t9
        decref $t15
        store $ret0 <- $t9
        jump bb4
    bb3  if: else    preds bb0
        jump bb1
    bb4  exit    preds bb1, bb2
        $t13: i64? = load $ret0
        incref $t13
        decref_slot $own2
        decref_slot $own3
        return $t13

function bump(@xs: [i64]) -> i64
    bb0  entry
        $t2: i64 = const 100
        push_owned xs <- $t2
        $t4: [i64] = load xs
        $t5: i64 = call builtin len($t4)
        copyout xs
        return $t5

function grown(n: i64) -> [i64]?
    slots  out: [i64] · $f0: i64? · $f1: i64? · $r0: i64 · $f2: i64? · $ret0: [i64]? · $own7: [i64] · $own8: i64? · $own9: i64? · $own10: i64? · $own11: [i64]? · $own12: [i64]?
    bb0  entry
        $t1: [i64] = construct array()
        $t42: [i64] = load $own7
        store $own7 <- $t1
        decref $t42
        $t43: [i64] = load out
        incref $t1
        store out <- $t1
        decref $t43
        $t3: i64 = load n
        $t4: i64? = call heroes half($t3)
        $t44: i64? = load $own8
        store $own8 <- $t4
        decref $t44
        $t45: i64? = load $f0
        incref $t4
        store $f0 <- $t4
        decref $t45
        $t5: i64? = load $f0
        $t6: i64 = tag $t5
        $t7: i64 = const 0
        $t8: bool = eq $t6, $t7
        branch $t8 -> bb1 else bb2
    bb1  must: ok    preds bb0
        $t11: i64? = load $f0
        $t12: i64 = payload $t11 .ok
        push_owned out <- $t12
        $t15: i64 = load n
        $t16: i64? = call heroes half($t15)
        $t46: i64? = load $own9
        store $own9 <- $t16
        decref $t46
        $t47: i64? = load $f1
        incref $t16
        store $f1 <- $t16
        decref $t47
        $t17: i64? = load $f1
        $t18: i64 = tag $t17
        $t19: i64 = const 0
        $t20: bool = eq $t18, $t19
        branch $t20 -> bb3 else bb4
    bb2  must: abort    preds bb0
        $t9: i64? = load $f0
        $t10: the error (`code`, `msg`) = payload $t9 .err
        abort must($t10)
        unreachable
    bb3  default: ok    preds bb1
        $t21: i64? = load $f1
        $t22: i64 = payload $t21 .ok
        store $r0 <- $t22
        jump bb5
    bb4  default: else    preds bb1
        $t23: i64 = const 0
        store $r0 <- $t23
        jump bb5
    bb5  default: join    preds bb3, bb4
        $t24: i64 = load $r0
        push_owned out <- $t24
        $t27: i64 = load n
        $t28: i64? = call heroes half($t27)
        $t48: i64? = load $own10
        store $own10 <- $t28
        decref $t48
        $t49: i64? = load $f2
        incref $t28
        store $f2 <- $t28
        decref $t49
        $t29: i64? = load $f2
        $t30: i64 = tag $t29
        $t31: i64 = const 0
        $t32: bool = eq $t30, $t31
        branch $t32 -> bb6 else bb7
    bb6  ?: ok    preds bb5
        $t36: i64? = load $f2
        $t37: i64 = payload $t36 .ok
        push_owned out <- $t37
        $t39: [i64] = load out
        incref $t39
        $t40: [i64]? = construct ok($t39)
        $t50: [i64]? = load $own11
        store $own11 <- $t40
        decref $t50
        store $ret0 <- $t40
        jump bb8
    bb7  ?: propagate    preds bb5
        $t33: i64? = load $f2
        $t34: the error (`code`, `msg`) = payload $t33 .err
        incref $t34
        $t35: [i64]? = construct err($t34)
        $t51: [i64]? = load $own12
        store $own12 <- $t35
        decref $t51
        store $ret0 <- $t35
        jump bb8
    bb8  exit    preds bb6, bb7
        $t41: [i64]? = load $ret0
        incref $t41
        decref_slot out
        decref_slot $f0
        decref_slot $f1
        decref_slot $f2
        decref_slot $own7
        decref_slot $own8
        decref_slot $own9
        decref_slot $own10
        decref_slot $own11
        decref_slot $own12
        return $t41

function flags(n: i64) -> [bool]
    slots  out: [bool] · $b0: bool · $b1: bool · $own4: [bool]
    bb0  entry
        $t1: [bool] = construct array()
        $t21: [bool] = load $own4
        store $own4 <- $t1
        decref $t21
        $t22: [bool] = load out
        incref $t1
        store out <- $t1
        decref $t22
        $t3: i64 = load n
        $t4: i64 = const 1
        $t5: bool = gt $t3, $t4
        store $b0 <- $t5
        branch $t5 -> bb1 else bb2
    bb1  &&: right    preds bb0
        $t6: i64 = load n
        $t7: i64 = const 4
        $t8: bool = lt $t6, $t7
        store $b0 <- $t8
        jump bb2
    bb2  &&: join    preds bb0, bb1
        $t9: bool = load $b0
        push_owned out <- $t9
        $t12: i64 = load n
        $t13: i64 = const 1
        $t14: bool = lt $t12, $t13
        store $b1 <- $t14
        branch $t14 -> bb4 else bb3
    bb3  ||: right    preds bb2
        $t15: i64 = load n
        $t16: i64 = const 3
        $t17: bool = gt $t15, $t16
        store $b1 <- $t17
        jump bb4
    bb4  ||: join    preds bb2, bb3
        $t18: bool = load $b1
        push_owned out <- $t18
        $t20: [bool] = load out
        incref $t20
        decref_slot out
        decref_slot $own4
        return $t20

function kept_classic() -> [i64]
    slots  out: [i64] · kept: [i64] · $f0: i64? · $own3: [i64] · $own4: [i64] · $own5: i64? · $own6: [i64]
    bb0  entry
        $t1: i64 = const 1
        $t2: [i64] = construct array($t1)
        $t21: [i64] = load $own3
        store $own3 <- $t2
        decref $t21
        $t22: [i64] = load out
        incref $t2
        store out <- $t2
        decref $t22
        $t3: [i64] = load out
        $t23: [i64] = load kept
        incref $t3
        store kept <- $t3
        decref $t23
        $t4: [i64] = load out
        incref $t4
        $t24: [i64] = load $own4
        store $own4 <- $t4
        decref $t24
        $t5: i64 = const 2
        $t6: i64? = call heroes half($t5)
        $t25: i64? = load $own5
        store $own5 <- $t6
        decref $t25
        $t26: i64? = load $f0
        incref $t6
        store $f0 <- $t6
        decref $t26
        $t7: i64? = load $f0
        $t8: i64 = tag $t7
        $t9: i64 = const 0
        $t10: bool = eq $t8, $t9
        branch $t10 -> bb1 else bb2
    bb1  must: ok    preds bb0
        $t13: i64? = load $f0
        $t14: i64 = payload $t13 .ok
        $t15: i64 = call heroes bump(@out)
        $t16: i64 = add! $t14, $t15
        $t17: [i64] = call builtin push($t4, $t16)
        $t27: [i64] = load $own6
        store $own6 <- $t17
        decref $t27
        $t28: [i64] = load out
        incref $t17
        store out <- $t17
        decref $t28
        $t18: [i64] = load kept
        $t19: i64 = call builtin len($t18)
        call builtin print($t19) variadic
        $t20: [i64] = load out
        incref $t20
        decref_slot out
        decref_slot kept
        decref_slot $f0
        decref_slot $own3
        decref_slot $own4
        decref_slot $own5
        decref_slot $own6
        return $t20
    bb2  must: abort    preds bb0
        $t11: i64? = load $f0
        $t12: the error (`code`, `msg`) = payload $t11 .err
        abort must($t12)
        unreachable

function main()
    slots  $f0: [i64]? · $own1: [i64]? · $own2: [bool] · $own3: [i64]
    bb0  entry
        $t1: i64 = const 2
        $t2: [i64]? = call heroes grown($t1)
        $t17: [i64]? = load $own1
        store $own1 <- $t2
        decref $t17
        $t18: [i64]? = load $f0
        incref $t2
        store $f0 <- $t2
        decref $t18
        $t3: [i64]? = load $f0
        $t4: i64 = tag $t3
        $t5: i64 = const 0
        $t6: bool = eq $t4, $t5
        branch $t6 -> bb1 else bb2
    bb1  must: ok    preds bb0
        $t9: [i64]? = load $f0
        $t10: [i64] = payload $t9 .ok
        $t11: i64 = call builtin len($t10)
        $t12: i64 = const 2
        $t13: [bool] = call heroes flags($t12)
        $t19: [bool] = load $own2
        store $own2 <- $t13
        decref $t19
        $t14: i64 = call builtin len($t13)
        $t15: [i64] = call heroes kept_classic()
        $t20: [i64] = load $own3
        store $own3 <- $t15
        decref $t20
        $t16: i64 = call builtin len($t15)
        call builtin print($t11, $t14, $t16) variadic
        decref_slot $f0
        decref_slot $own1
        decref_slot $own2
        decref_slot $own3
        return
    bb2  must: abort    preds bb0
        $t7: [i64]? = load $f0
        $t8: the error (`code`, `msg`) = payload $t7 .err
        abort must($t8)
        unreachable
