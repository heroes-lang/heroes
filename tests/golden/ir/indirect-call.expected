function double(n: i64) -> i64
    bb0  entry
        $t1: i64 = load n
        $t2: i64 = const 2
        $t3: i64 = mul! $t1, $t2
        return $t3

function apply_twice(n: i64, f: (function(i64) -> i64)) -> i64
    bb0  entry
        $t1: (function(i64) -> i64) = load f
        $t2: (function(i64) -> i64) = load f
        $t3: i64 = load n
        $t4: i64 = call indirect $t2($t3)
        $t5: i64 = call indirect $t1($t4)
        return $t5

function main()
    bb0  entry
        $t1: i64 = const 3
        $t2: (function(i64) -> i64) = funcref heroes double
        $t3: i64 = call heroes apply_twice($t1, $t2)
        call builtin print($t3) variadic
        return
