function moved(p: Point, by: int) -> Point
    bb0  entry
        $t1: Point = load p
        $t2: int = field $t1.x
        $t3: int = load by
        $t4: int = add! $t2, $t3
        $t5: Point = load p
        $t6: int = field $t5.y
        $t7: Point = construct Point($t4, $t6)
        return $t7

function copy_between(from: int, to: int) -> int
    bb0  entry
        $t1: int = load to
        $t2: int = load from
        $t3: int = sub! $t1, $t2
        return $t3

function main()
    bb0  entry
        $t1: int = const 1
        $t2: int = const 4
        $t3: int = call heroes copy_between($t1, $t2)
        call builtin print($t3) variadic
        return
