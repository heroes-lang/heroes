# Part 5, row 1: `if` / `else if` / `else`. The IR has no `if` — it has a
# two-way branch per test, and a join slot holding the value when the `if` is
# used as one (§4.7 makes it an expression).
function sign_of(n: int) -> int
    kind = if n < 0
        0 - 1
    else if n > 0
        1
    else
        0
    return kind
