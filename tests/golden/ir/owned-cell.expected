strings
    0  "none"
    1  "nothing yet"
    2  "no reason given"

extern function free(p: ptr)
    no body — C provides it

extern function describe(code: i32, @message: cstr) -> i32
    no body — C provides it

function reason(code: i32) -> str
    slots  message: str? · $cell0: cstr · $owned0: cstr · $owned1: str? · $f0: str? · $r0: str · $own7: str? · $own8: str?
    bb0  entry
        $t1: str = const str 0
        $t2: str = const str 1
        incref $t1
        incref $t2
        $t3: str? = construct fail($t1, $t2)
        $t25: str? = load $own7
        store $own7 <- $t3
        decref $t25
        $t26: str? = load message
        incref $t3
        store message <- $t3
        decref $t26
        $t4: i32 = load code
        $t5: cstr = const nullptr
        store $cell0 <- $t5
        $t6: i32 = call extern describe($t4, @$cell0)
        $t7: cstr = load $cell0
        store $owned0 <- $t7
        $t8: cstr = load $owned0
        $t9: str? = call heroes validated($t8)
        $t27: str? = load $own8
        store $own8 <- $t9
        decref $t27
        $t28: str? = load $owned1
        incref $t9
        store $owned1 <- $t9
        decref $t28
        $t10: cstr = const nullptr
        $t11: cstr = load $owned0
        $t12: bool = ne $t11, $t10
        branch $t12 -> bb1 else bb2
    bb1  owned: free    preds bb0
        $t13: cstr = load $owned0
        $t14: ptr = cast cstr_to_ptr $t13
        call extern free($t14)
        jump bb2
    bb2  owned: done    preds bb0, bb1
        $t15: str? = load $owned1
        $t29: str? = load message
        incref $t15
        store message <- $t15
        decref $t29
        $t16: str? = load message
        $t30: str? = load $f0
        incref $t16
        store $f0 <- $t16
        decref $t30
        $t17: str? = load $f0
        $t18: i64 = tag $t17
        $t19: i64 = const 0
        $t20: bool = eq $t18, $t19
        branch $t20 -> bb3 else bb4
    bb3  default: ok    preds bb2
        $t21: str? = load $f0
        $t22: str = payload $t21 .ok
        $t31: str = load $r0
        incref $t22
        store $r0 <- $t22
        decref $t31
        jump bb5
    bb4  default: else    preds bb2
        $t23: str = const str 2
        $t32: str = load $r0
        incref $t23
        store $r0 <- $t23
        decref $t32
        jump bb5
    bb5  default: join    preds bb3, bb4
        $t24: str = load $r0
        incref $t24
        decref_slot message
        decref_slot $owned1
        decref_slot $f0
        decref_slot $r0
        decref_slot $own7
        decref_slot $own8
        return $t24
