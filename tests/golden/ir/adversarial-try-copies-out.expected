strings
    0  "empty"
    1  "nothing to parse"

function parsed(s: str) -> i64?
    slots  $ret0: i64? · $own2: i64? · $own3: i64?
    bb0  entry
        $t1: str = load s
        $t2: i64 = call builtin len($t1)
        $t3: i64 = const 0
        $t4: bool = eq $t2, $t3
        branch $t4 -> bb2 else bb3
    bb1  if: join    preds bb3
        $t8: str = load s
        $t9: i64 = call builtin len($t8)
        $t10: i64? = construct ok($t9)
        $t12: i64? = load $own2
        store $own2 <- $t10
        decref $t12
        store $ret0 <- $t10
        jump bb4
    bb2  if: then    preds bb0
        $t5: str = const str 0
        $t6: str = const str 1
        incref $t5
        incref $t6
        $t7: i64? = construct fail($t5, $t6)
        $t13: i64? = load $own3
        store $own3 <- $t7
        decref $t13
        store $ret0 <- $t7
        jump bb4
    bb3  if: else    preds bb0
        jump bb1
    bb4  exit    preds bb1, bb2
        $t11: i64? = load $ret0
        incref $t11
        decref_slot $own2
        decref_slot $own3
        return $t11

function advance_over(@r: Reader, s: str) -> i64?
    slots  $f0: i64? · n: i64 · $ret0: i64? · $own5: i64? · $own6: i64? · $own7: i64? · $own8: i64?
    bb0  entry
        $t1: str = load s
        $t2: i64? = call heroes parsed($t1)
        $t24: i64? = load $own5
        store $own5 <- $t2
        decref $t24
        $t25: i64? = load $f0
        incref $t2
        store $f0 <- $t2
        decref $t25
        $t3: i64? = load $f0
        $t4: i64 = tag $t3
        $t5: i64 = const 0
        $t6: bool = eq $t4, $t5
        branch $t6 -> bb1 else bb2
    bb1  ?: ok    preds bb0
        $t10: i64? = load $f0
        $t11: i64 = payload $t10 .ok
        store n <- $t11
        $t12: i64 = load n
        $t13: i64 = const 0
        $t14: bool = eq $t12, $t13
        branch $t14 -> bb4 else bb5
    bb2  ?: propagate    preds bb0
        $t7: i64? = load $f0
        $t8: the error (`code`, `msg`) = payload $t7 .err
        incref $t8
        $t9: i64? = construct err($t8)
        $t26: i64? = load $own6
        store $own6 <- $t9
        decref $t26
        store $ret0 <- $t9
        jump bb6
    bb3  if: join    preds bb5
        $t17: Reader = load r
        $t18: i64 = field $t17.pos
        $t19: i64 = load n
        $t20: i64 = add! $t18, $t19
        store r.pos <- $t20
        $t21: i64 = load n
        $t22: i64? = construct ok($t21)
        $t27: i64? = load $own7
        store $own7 <- $t22
        decref $t27
        store $ret0 <- $t22
        jump bb6
    bb4  if: then    preds bb1
        $t15: i64 = const 0
        $t16: i64? = construct ok($t15)
        $t28: i64? = load $own8
        store $own8 <- $t16
        decref $t28
        store $ret0 <- $t16
        jump bb6
    bb5  if: else    preds bb1
        jump bb3
    bb6  exit    preds bb2, bb3, bb4
        copyout r
        $t23: i64? = load $ret0
        incref $t23
        decref_slot $f0
        decref_slot $own5
        decref_slot $own6
        decref_slot $own7
        decref_slot $own8
        return $t23
