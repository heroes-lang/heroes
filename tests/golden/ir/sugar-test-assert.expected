strings
    0  "add(a: 2, b: 3) == 5"

function add(a: i64, b: i64) -> i64
    bb0  entry
        $t1: i64 = load a
        $t2: i64 = load b
        $t3: i64 = add! $t1, $t2
        return $t3

test "addition holds"
    bb0  entry
        $t1: str = const str 0
        $t2: i64 = const 2
        $t3: i64 = const 3
        $t4: i64 = call heroes add($t2, $t3)
        $t5: i64 = const 5
        $t6: bool = eq $t4, $t5
        branch $t6 -> bb1 else bb2
    bb1  assert: held    preds bb0
        return
    bb2  assert: failed    preds bb0
        abort assert($t1, $t4, $t5)
        unreachable
