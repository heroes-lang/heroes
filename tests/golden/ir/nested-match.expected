strings
    0  "red dot"
    1  "blue dot"
    2  "red line"
    3  "blue line"

function describe(s: Shape, c: Colour) -> str
    slots  $s0: Shape · $r0: str · $s1: Colour · $r1: str · $s2: Colour · $r2: str
    bb0  entry
        $t1: Shape = load s
        store $s0 <- $t1
        $t2: Shape = load $s0
        $t3: i64 = tag $t2
        switch $t3 case 0 -> bb2, case 1 -> bb3
    bb1  match: join    preds bb4, bb7
        $t16: str = load $r0
        incref $t16
        $t23: str = load $r0
        decref $t23
        $t24: str = load $r1
        decref $t24
        $t25: str = load $r2
        decref $t25
        return $t16
    bb2  match: arm    preds bb0
        $t4: Colour = load c
        store $s1 <- $t4
        $t5: Colour = load $s1
        $t6: i64 = tag $t5
        switch $t6 case 0 -> bb5, case 1 -> bb6
    bb3  match: arm    preds bb0
        $t10: Colour = load c
        store $s2 <- $t10
        $t11: Colour = load $s2
        $t12: i64 = tag $t11
        switch $t12 case 0 -> bb8, case 1 -> bb9
    bb4  match: join    preds bb5, bb6
        $t9: str = load $r1
        $t17: str = load $r0
        incref $t9
        store $r0 <- $t9
        decref $t17
        jump bb1
    bb5  match: arm    preds bb2
        $t7: str = const str 0
        $t18: str = load $r1
        incref $t7
        store $r1 <- $t7
        decref $t18
        jump bb4
    bb6  match: arm    preds bb2
        $t8: str = const str 1
        $t19: str = load $r1
        incref $t8
        store $r1 <- $t8
        decref $t19
        jump bb4
    bb7  match: join    preds bb8, bb9
        $t15: str = load $r2
        $t20: str = load $r0
        incref $t15
        store $r0 <- $t15
        decref $t20
        jump bb1
    bb8  match: arm    preds bb3
        $t13: str = const str 2
        $t21: str = load $r2
        incref $t13
        store $r2 <- $t13
        decref $t21
        jump bb7
    bb9  match: arm    preds bb3
        $t14: str = const str 3
        $t22: str = load $r2
        incref $t14
        store $r2 <- $t14
        decref $t22
        jump bb7
