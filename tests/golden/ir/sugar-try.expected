strings
    0  "empty"
    1  "no first element"

function first_of(xs: [int]) -> int?
    bb0  entry
        $t1: [int] = load xs
        $t2: int = call builtin len($t1)
        $t3: int = const 0
        $t4: bool = eq $t2, $t3
        branch $t4 -> bb2 else bb3
    bb1  if: join    preds bb3
        $t8: [int] = load xs
        $t9: int = const 0
        $t10: int = index! $t8, $t9
        $t11: int? = construct ok($t10)
        return $t11
    bb2  if: then    preds bb0
        $t5: str = const str 0
        $t6: str = const str 1
        $t7: int? = construct fail($t5, $t6)
        return $t7
    bb3  if: else    preds bb0
        jump bb1

function step(@r: Reader, xs: [int]) -> int?
    slots  $f0: int? · v: int
    bb0  entry
        $t1: [int] = load xs
        $t2: int? = call heroes first_of($t1)
        store $f0 <- $t2
        $t3: int? = load $f0
        $t4: int = tag $t3
        $t5: int = const 0
        $t6: bool = eq $t4, $t5
        branch $t6 -> bb1 else bb2
    bb1  ?: ok    preds bb0
        $t10: int? = load $f0
        $t11: int = payload $t10 .ok
        store v <- $t11
        $t12: Reader = load r
        $t13: int = field $t12.pos
        $t14: int = const 1
        $t15: int = add! $t13, $t14
        store r.pos <- $t15
        $t16: int = load v
        $t17: int? = construct ok($t16)
        copyout r
        return $t17
    bb2  ?: propagate    preds bb0
        $t7: int? = load $f0
        $t8: the error (`code`, `msg`) = payload $t7 .err
        $t9: int? = construct err($t8)
        copyout r
        return $t9
