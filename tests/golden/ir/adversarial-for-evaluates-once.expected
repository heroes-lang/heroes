strings
    0  "built"

function numbers() -> [i64]
    slots  $own0: [i64]
    bb0  entry
        $t1: str = const str 0
        call builtin print($t1) variadic
        $t2: i64 = const 1
        $t3: i64 = const 2
        $t4: i64 = const 3
        $t5: [i64] = construct array($t2, $t3, $t4)
        $t6: [i64] = load $own0
        store $own0 <- $t5
        decref $t6
        incref $t5
        $t7: [i64] = load $own0
        decref $t7
        return $t5

function total() -> i64
    slots  sum: i64 · $xs0: [i64] · $i0: i64 · n: i64 · $own4: [i64]
    bb0  entry
        $t1: i64 = const 0
        store sum <- $t1
        $t2: [i64] = call heroes numbers()
        $t18: [i64] = load $own4
        store $own4 <- $t2
        decref $t18
        $t19: [i64] = load $xs0
        incref $t2
        store $xs0 <- $t2
        decref $t19
        $t3: i64 = const 0
        store $i0 <- $t3
        jump bb1
    bb1  for: test    preds bb0, bb3
        $t4: i64 = load $i0
        $t5: [i64] = load $xs0
        $t6: i64 = len $t5
        $t7: bool = lt $t4, $t6
        branch $t7 -> bb2 else bb4
    bb2  for: body    preds bb1
        $t8: [i64] = load $xs0
        $t9: i64 = load $i0
        $t10: i64 = index! $t8, $t9
        store n <- $t10
        $t11: i64 = load sum
        $t12: i64 = load n
        $t13: i64 = add! $t11, $t12
        store sum <- $t13
        jump bb3
    bb3  for: step    preds bb2
        $t14: i64 = load $i0
        $t15: i64 = const 1
        $t16: i64 = add! $t14, $t15
        store $i0 <- $t16
        jump bb1
    bb4  for: exit    preds bb1
        $t17: i64 = load sum
        $t20: [i64] = load $xs0
        decref $t20
        $t21: [i64] = load $own4
        decref $t21
        return $t17
