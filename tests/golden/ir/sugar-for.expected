function total_of(xs: [i64]) -> i64
    slots  sum: i64 · $xs0: [i64] · $i0: i64 · x: i64
    bb0  entry
        $t1: i64 = const 0
        store sum <- $t1
        $t2: [i64] = load xs
        $t18: [i64] = load $xs0
        incref $t2
        store $xs0 <- $t2
        decref $t18
        $t3: i64 = const 0
        store $i0 <- $t3
        jump bb1
    bb1  for: test    preds bb0, bb3
        $t4: i64 = load $i0
        $t5: [i64] = load $xs0
        $t6: i64 = len $t5
        $t7: bool = lt $t4, $t6
        branch $t7 -> bb2 else bb4
    bb2  for: body    preds bb1
        $t8: [i64] = load $xs0
        $t9: i64 = load $i0
        $t10: i64 = index! $t8, $t9
        store x <- $t10
        $t11: i64 = load sum
        $t12: i64 = load x
        $t13: i64 = add! $t11, $t12
        store sum <- $t13
        jump bb3
    bb3  for: step    preds bb2
        $t14: i64 = load $i0
        $t15: i64 = const 1
        $t16: i64 = add! $t14, $t15
        store $i0 <- $t16
        jump bb1
    bb4  for: exit    preds bb1
        $t17: i64 = load sum
        $t19: [i64] = load $xs0
        decref $t19
        return $t17
