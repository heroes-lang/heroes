# Words counted and joined: the reference `heroes doc` prints of a module of
# two functions, each with its parameter lines, its call and an example under
# `## Examples` (spec § 1; panel 253's R2).

# How many words `text` holds, a word being a run of bytes that are not
# spaces.
#
# - `text`: the words, spaced by one or more spaces
function count_words(text: str) -> i64
    n: i64 @= 0
    inside: bool @= false

    for c in text.chars()
        if c == " "
            inside @ false
        else if !inside
            inside @ true
            n @ n + 1

    return n

# `first` then `second`, with `sep` between.
#
# - `first`: the text that opens the result
# - `second`: the text that closes it
# - `sep`: what stands between them
function joined(first: str, second: str, sep: str) -> str
    return first + sep + second

## Examples

# Three words, two spaces between two of them.
test "count_words: three words"
    assert count_words("one two  three") == 3

# A dash between two words.
test "joined: a dash"
    assert joined(first: "a", second: "b", sep: "-") == "a-b"
