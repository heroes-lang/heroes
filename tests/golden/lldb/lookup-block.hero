# A frame stopped inside the block the emitter writes for one instruction
# lists the author's bindings and nothing the emitter declared there (panel
# 213's R1, ratified by the author on 2026-10-14). A map lookup's C is a
# block holding its own scratch local, `found`, the answer of the runtime's
# `hero_map_find`; stopped in that call and looked at from `age_of`, `up`, the
# frame lists `ages`, `who`, `base` and `got`, four, and no `found`. `got` is
# not yet written there, so its value is whatever the stack held and the
# session names no value of it. The names are still the emitted C's.
# Corrected 2026-10-26 (panel 230's R1, kind 2; M-panic-location step 6a): the
# call is `hero_map_find_at`, the twin handed the lookup's place, so the
# session breaks there; `hero_map_find` is no longer on the lookup's path.

function age_of(ages: {str: i64}, who: str) -> i64
    base = 10
    got = ages[who]
    return base + got.default(0)

function main()
    ages = {"ada": 36, "grace": 85}
    print(age_of(ages: ages, who: "ada"))
