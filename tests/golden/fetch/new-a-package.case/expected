# The package `greet`, its face: a program reaches it by `use <greet>/greet`,
# once `heroes add` has written its entry in the program's catalogue. This
# module declares only what a program calls; what the package keeps to
# itself stands under `greet/internal/`, which no module outside it names.

use greet/internal/words

# The greeting for `who`: the word a greeting opens with, then `who`.
function hello(who: str) -> str
    return words.opening() + ", " + who

test "hello greets who it is given, an empty name included"
    assert hello("ana") == "hello, ana"
    assert hello("") == "hello, "
