# Drawing, in a different directory from the geometry it draws.
#
# The `use` line below is character for character the one in `main.hero` and
# in `geom/area.hero`. Three files at two depths, one spelling: that is the
# whole of what the root base buys, and it is why copying an import from a
# neighbouring file is the correct move here rather than the classic mistake.
use geom/point

# `use scale` — and there is a `render/scale.hero` BESIDE this file. This line
# reaches the ROOT's `scale.hero`, because every `use` starts at the directory
# of the file you compile. `scale.hero`'s own doc is where that is explained.
use scale

function bar(width: i64) -> str
    origin = point.Point(x: 0, y: 0)
    tip = point.Point(x: width, y: 0)
    return "#".repeat(point.span(from: origin, to: tip).to_u64().must())

function frame(width: i64, height: i64) -> str
    rows: [str] @ [bar(width: width)]
    at: i64 @ 1

    while at < height
        rows @ rows.push(bar(width: width))
        at @ at + 1

    return rows.join("\n")

test "a bar is as wide as the span it is given, and a frame repeats it"
    assert bar(width: 3) == "###"
    assert bar(width: 0) == ""
    assert frame(width: 2, height: 2) == "##\n##"

# The root's factor, reached from a subdirectory by a bare `use`.
function scaled(width: i64) -> i64
    return width * scale.factor()

test "the bare use reached the root, so the factor is ten"
    assert scaled(width: 2) == 20
