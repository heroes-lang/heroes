# The answer, rendered: columns that line up, and numbers that do not lie
# about how many rows they stand for (spec § Strings, arrays, maps).
#
# Corpus material (CLAUDE.md §9), M-corpus-depth. The rendering is here
# rather than in `run/engine.hero` for the reason `examples/todo/` states
# about its own split: every decision about *what* the answer is stays in a
# module with no `print` in it, so the engine's tests never have to read
# text to know whether a query was right. This module holds the padding and
# nothing else.
#
# WIDTHS ARE MEASURED IN BYTES, and the program says so rather than
# discovering it: `spec:56` indexes and measures a `str` in bytes, and every
# name this table prints is ASCII by construction — a team from a written
# list, a name the generator builds out of `p` and digits. A column of text
# somebody typed would need `chars()` and a different function, which is
# `examples/widths/`'s subject and not this one.

use data/row
use query/plan

# One column of the report: which field, and how wide it came out.
record Field
    column: plan.Column
    width: i64

# A line of cells padded to their column's width, joined by two spaces.
# Trailing space is trimmed by construction: the last cell is written
# without padding, because a line that ends in blanks is a line a diff
# argues about.
function padded(cells: [str], widths: [i64]) -> str
    out: str @ ""
    at: i64 @ 0

    while at < cells.len()
        if at > 0
            out @ out + "  "

        if at == cells.len() - 1
            out @ out + cells[at]
        else
            out @ out + wide(text: cells[at], to: widths[at])
        at @ at + 1

    return out

# `text` padded on the right to `to` bytes — never truncated, because a
# report that cuts a value to fit is a report that shows the wrong value.
function wide(text: str, to: i64) -> str
    if text.len() >= to
        return text
    return text + repeat(" ", to_u64(to - text.len()).must())

# The width each column needs: the widest of its heading and its values.
function widths_for(columns: [plan.Column], rows: [row.Row]) -> [i64]
    out: [i64] @ []

    for c in columns
        widest: i64 @ plan.heading(c).len()

        for r in rows
            here = plan.text_at(c, r).len()

            if here > widest
                widest @ here

        out @ out.push(widest)

    return out

# The rows as a table: a heading line, then one line per row.
function table(columns: [plan.Column], rows: [row.Row]) -> str
    widths = widths_for(columns, rows)
    headings: [str] @ []

    for c in columns
        headings @ headings.push(plan.heading(c))

    lines: [str] @ [padded(headings, widths)]

    for r in rows
        cells: [str] @ []

        for c in columns
            cells @ cells.push(plan.text_at(c, r))

        lines @ lines.push(padded(cells, widths))

    return lines.join("\n")

# A joined row's line: the row's own columns, then its region.
function joined_table(columns: [plan.Column], rows: [plan.Joined]) -> str
    plain: [row.Row] @ []

    for j in rows
        plain @ plain.push(j.r)

    widths = widths_for(columns, plain)
    headings: [str] @ []

    for c in columns
        headings @ headings.push(plan.heading(c))

    headings @ headings.push("region")
    with_region = widths.push(6)
    lines: [str] @ [padded(headings, with_region)]

    for j in rows
        cells: [str] @ []

        for c in columns
            cells @ cells.push(plan.text_at(c, j.r))

        cells @ cells.push(j.region)
        lines @ lines.push(padded(cells, with_region))

    return lines.join("\n")

# A group's line: the key, then its four numbers. The mean is printed
# through the `T?` that computes it, so an empty group would print the
# refusal's own word rather than a number nobody should trust — and it
# cannot happen, because a group exists only where a row put it.
function group_line(g: plan.Group, s: plan.Summary) -> str
    mean = plan.mean_of(s)
    shown: str @ "-"

    if !mean.is_err()
        shown @ rounded(mean.must())
    return wide(text: g.team, to: 6) + "  " + wide(text: active_text(g.active), to: 8) + "  " + wide(text: s.rows.to_str(), to: 5) + "  " + wide(text: s.total.to_str(), to: 7) + "  " + wide(text: s.best.to_str(), to: 4) + "  " + shown

function active_text(active: bool) -> str
    if active
        return "active"
    return "idle"

# A mean to two decimals, so a float's full spelling does not decide
# whether this program's output is stable.
#
# **It ROUNDS rather than truncating, and a test is why.** `to_i64`
# truncates toward zero (spec § Failure), and the first draft relied on
# that — then asserted `rounded(9.09) == "9.08"` on the reasoning that
# `9.09 * 100.0` lands a hair under 909. Measured on this machine it lands
# exactly on 909, so the assertion was a guess about floating point dressed
# as a fact, and the test failed on the program that was right. Adding a
# half before truncating makes the answer the nearest hundredth whatever
# the last bit does, which is what a reader of a mean expects anyway. The
# value here is never negative — it is a mean of non-negative rates — so
# the half goes on unconditionally.
function rounded(v: f64) -> str
    hundredths = to_i64(v * 100.0 + 0.5).must()
    whole = hundredths / 100
    rest = hundredths % 100
    tail: str @ rest.to_str()

    if rest < 10
        tail @ "0" + tail
    return whole.to_str() + "." + tail

constant GROUP_HEADING: str
    "team    state     rows   total    best  mean"

test "a cell is padded to its column and never cut"
    assert wide(text: "ab", to: 5) == "ab   "
    assert wide(text: "abcdef", to: 3) == "abcdef"
    assert wide(text: "", to: 2) == "  "

test "a line has no trailing blanks, however wide its last column"
    widths: [i64] = [4, 4]
    line = padded(["a", "b"], widths)
    assert line == "a     b"
    assert line[line.len() - 1] != ' '

test "a column is as wide as the widest of its heading and its values"
    rows: [row.Row] = [
        row.Row(id: 1, team: "argo", name: "p1", active: true, score: 1000, rate: 1.0)
        row.Row(id: 22, team: "b", name: "p22", active: false, score: 2, rate: 2.0)
    ]
    columns: [plan.Column] = [.id, .score]
    widths = widths_for(columns, rows)
    assert widths[0] == 2
    assert widths[1] == 5

test "the table's first line is its headings and it has one line per row"
    rows = row.generated(3)
    columns: [plan.Column] = [.id, .team, .score]
    text = table(columns, rows)
    lines = split_lines(text)
    assert lines.len() == 4
    assert lines[0].slice(from: 0, to: 2) == "id"

test "a mean prints to two decimals, and the second decimal is not dropped"
    assert rounded(1.5) == "1.50"
    assert rounded(0.0) == "0.00"
    assert rounded(0.25) == "0.25"
    assert rounded(12.5) == "12.50"

    # A value whose hundredth is exact either way, so this case says what
    # the function does rather than what the last bit of a double does.
    assert rounded(9.0) == "9.00"

test "a group line carries its key and its four numbers"
    s = plan.Summary(rows: 3, total: 30, best: 20, rate_sum: 6.0)
    line = group_line(plan.Group(team: "argo", active: true), s)
    assert line.slice(from: 0, to: 4) == "argo"
    assert holds(text: line, needle: "2.00")
    assert holds(text: group_line(plan.Group(team: "argo", active: false), s), needle: "idle")

function split_lines(text: str) -> [str]
    out: [str] @ []
    start: i64 @ 0
    at: i64 @ 0

    while at < text.len()
        if text[at] == '\n'
            out @ out.push(text.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    out @ out.push(text.slice(from: start, to: text.len()))
    return out

function holds(text: str, needle: str) -> bool
    if needle.len() > text.len()
        return false
    at: i64 @ 0

    while at + needle.len() <= text.len()
        if text.slice(from: at, to: at + needle.len()) == needle
            return true
        at @ at + 1

    return false
