# Markdown to plain text.
#
#     heroes run examples/markdown/main.hero -- examples/markdown/sample.md
#     heroes run examples/markdown/main.hero -- examples/markdown/sample.md outline
#
#     main.hero      the program: arguments, the file, the two views
#     render.hero    blocks out, lines in
#     blocks.hero    lines out, blocks in
#     inline.hero    one line, with its markup removed
#
# What it exercises: a seven-case variant matched exhaustively in three
# different modules, a `while` over an index because a fenced block consumes
# lines the loop has not reached, `continue` as a `match` arm body, and the
# language's rule that two parameters of one type must be named at the call
# site — which is why `starts` is written `head.starts(word: "```")`.

use blocks
use render

function main()
    given = args()

    if len(given) == 0
        print("usage: markdown <file.md> [outline]")
        exit(2)

    match read_file(given[0])
        .err e     => stop("cannot read " + given[0] + ": " + e.code)
        .ok source => show(source, given)

function stop(message: str)
    print(message)
    exit(1)

function show(source: str, given: [str])
    document = blocks.read(source)

    if len(given) > 1 && given[1] == "outline"
        for line in headings(document)
            print(line)
    else
        write(render.render(document))

# The headings alone, indented by their level — the view that answers "what is
# in this document" without reading it.
#
# `continue` is the body of the arm that has nothing to do, which the spec allows
# precisely here: a jump is a valid arm body and yields no value, so the `match`
# stays exhaustive without a case that pretends to compute something.
function headings(document: [blocks.Block]) -> [str]
    out: [str] @ []

    for b in document
        match b
            .heading h                                                          => out @ out.push(
                repeat("  ", (h.level - 1).to_u64().must()) + h.text
            )
            .paragraph _ | .bullet _ | .numbered _ | .quote _ | .code _ | .rule => continue

    return out

# The rendered text, printed exactly once.
#
# `render` ends its text in a newline and `print` adds exactly one of its own
# (spec § Strings), so the last one is dropped here rather than left to double.
# The empty document is its own case: there is no last character to drop.
function write(text: str)
    if text == ""
        print("(nothing but markup)")
    else
        print(text.slice(from: 0, to: text.len() - 1))

test "the sample renders through both views"
    source = read_file("examples/markdown/sample.md").must()
    document = blocks.read(source)
    assert headings(document) == ["Heroes", "  Why it exists", "  What it refuses"]
    assert render.render(document).len() > source.len() - 40

test "an argument that is not `outline` is a file that is not there"
    assert read_file("examples/markdown/no-such-file.md").is_err()
