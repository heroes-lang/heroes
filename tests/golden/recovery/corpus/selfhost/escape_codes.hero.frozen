# Where an escape by a character's code ends, and the code it names (spec
# § 2 Literals; design.md §4.17; defect 135's class, lanes recovery-b3 and
# literals).
#
# The byte questions `escape_readings` asks before it can say that an escape
# is a character by its code, and the one `escape_report` asks after, to show
# the character itself: past which byte `\x41`, `\u{1F600}`, `\x{41}` or
# `\cA` ends, and which character it names. Split from `escape_readings` on
# 2026-10-02, when the braced, short and control forms took it past the
# 300 lines `suite_layout` holds a module to: this half answers about the
# bytes of one escape and knows nothing of the literal around it, which is
# the reading's.

use escape

## Where an escape by its code ends

# Where an escape that names a character by its code ends, from the byte after
# its backslash at `at`: past the digits of `\x41`, `\u00e9`, `\u{1F600}`,
# `\U0001F600` and `\101`, past the letter of `\a` `\b` `\e` `\f` `\v`; and
# `at` itself where the bytes name no code, `\u` in `"C:\users"` among them.
#
# **A code one digit short is still a code, and so is one braced** (defect
# 135's L4): `\u41` and `\U41` are what an author who miscounted wrote, and
# `\x{41}`, `\o{101}`, `\u{…}` and `\N{U+2014}` take everything to their `}`,
# so in an `f"…"` literal the brace is the escape's and opens no hole. And a
# control character by its letter is one character: Perl's, Ruby's and the
# shell's `\cA` and `\c[`, Ruby's and Emacs Lisp's `\C-a` and `\M-A`, GCC's
# and the shell's `\E`.
function code_end(text: str, at: i64) -> i64
    b = text[at]

    if (b == 'x' || b == 'u' || b == 'o') && opens_brace(text, at: at)
        return brace_end(text, from: at + 2)

    if b == 'N' && opens_brace(text, at: at) && byte_at(text, at + 2) == 'U' && byte_at(text, at + 3) == '+'
        return brace_end(text, from: at + 2)

    if b == 'x'
        return counted(text, from: at + 1, least: 1, most: 2, hex: true, none: at)

    if b == 'u'
        return counted(text, from: at + 1, least: 1, most: 4, hex: true, none: at)

    if b == 'U'
        return counted(text, from: at + 1, least: 1, most: 8, hex: true, none: at)

    if b >= '0' && b <= '7'
        return counted(text, from: at, least: 1, most: 3, hex: false, none: at)

    if b == 'a' || b == 'b' || b == 'e' || b == 'E' || b == 'f' || b == 'v'
        return at + 1

    if b == 'c' && control_mark(byte_at(text, at + 1))
        return at + 2

    if b == 'C' && byte_at(text, at + 1) == '-' && control_mark(byte_at(text, at + 2))
        return at + 3

    if b == 'M' && byte_at(text, at + 1) == '-'
        if byte_at(text, at + 2) == '\\' && byte_at(text, at + 3) == 'C' && byte_at(text, at + 4) == '-' && control_mark(byte_at(text, at + 5))
            return at + 6

        if visible(byte_at(text, at + 2))
            return at + 3
    return at

# Whether the escape's letter at `at` is followed by a `{`.
function opens_brace(text: str, at: i64) -> bool
    return byte_at(text, at + 1) == '{'

# Past the `}` that closes a braced escape whose text starts at `from`, or
# `from` itself, past the `{` alone, where a quote, a backslash, another `{`
# or the line's end comes first: what the author wrote there is still a
# character by its name or code, and the literal's own end stays its own.
function brace_end(text: str, from: i64) -> i64
    i: i64 @= from

    while i < text.len()
        b = text[i]

        if b == '}'
            return i + 1

        if b == '"' || b == '\'' || b == '\\' || b == '{' || b == '\n' || b == '\r'
            return from
        i @ i + 1

    return from

# The letters and marks a control escape takes: `\cA` to `\cZ` in either
# case, `\c@`, `\c[`, `\c]`, `\c^`, `\c_` and `\c?`.
function control_mark(b: u8) -> bool
    return b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || b == '@' || b == '[' || b == ']' || b == '^' || b == '_' || b == '?'

# A visible ASCII byte that is neither quote nor a backslash, so an escape
# taking it never takes its literal's end.
function visible(b: u8) -> bool
    return b > 32 && b < 127 && b != '"' && b != '\'' && b != '\\'

# The byte at `i`, or 0 past the text's end, which no byte asked about is.
function byte_at(text: str, i: i64) -> u8
    if i < 0 || i >= text.len()
        return 0
    return text[i]

# Past the digits from `from`, at most `most` of them, hexadecimal or octal;
# `none` where there are fewer than `least`.
function counted(text: str, from: i64, least: i64, most: i64, hex: bool, none: i64) -> i64
    i: i64 @= from

    while i < text.len() && i - from < most && digit_of(text[i], hex: hex) >= 0
        i @ i + 1

    if i - from < least
        return none
    return i

# One digit's value, or -1 where the byte is none.
function digit_of(b: u8, hex: bool) -> i64
    if b >= '0' && b <= '7'
        return to_i64(b - '0').must()

    if hex && (b == '8' || b == '9')
        return to_i64(b - '0').must()

    if hex && b >= 'a' && b <= 'f'
        return to_i64(b - 'a').must() + 10

    if hex && b >= 'A' && b <= 'F'
        return to_i64(b - 'A').must() + 10
    return -1

## The value of an escape by its code

# The code an escape names, from its first byte after the backslash at `at` to
# `end`, where `code_end` put it; -1 where it names none this compiler can
# say, a brace never closed or holding what is not a digit, or a code past
# Unicode's last, which also bounds the sum a long brace could overflow.
function code_value(text: str, at: i64, end: i64) -> i64
    b = text[at]

    if b == 'a'
        return 7

    if b == 'b'
        return 8

    if b == 'e' || b == 'E'
        return 27

    if b == 'f'
        return 12

    if b == 'v'
        return 11

    if b == 'c'
        return control_value(text[at + 1])

    if b == 'C'
        return control_value(text[at + 2])

    if b == 'M' && end == at + 6
        return 128 + control_value(text[at + 5])

    if b == 'M'
        return 128 + to_i64(text[at + 2]).must()
    from: i64 @= at + 1
    hex: bool @= b != 'o'
    braced = (b == 'x' || b == 'u' || b == 'o' || b == 'N') && opens_brace(text, at: at)

    if b >= '0' && b <= '7'
        from @ at
        hex @ false
    else if b == 'N'
        from @ at + 4
    else if braced
        from @ at + 2
    value: i64 @= 0
    i: i64 @= from

    while i < end && digit_of(text[i], hex: hex) >= 0 && value <= 1114111
        if hex
            value @ value * 16 + digit_of(text[i], hex: hex)
        else
            value @ value * 8 + digit_of(text[i], hex: hex)
        i @ i + 1

    if value > 1114111 || braced && (i == from || i != end - 1)
        return -1
    return value

# The code a control escape's mark names, Perl's `ord(uc mark) ^ 64`: `A`
# and `a` 1, `@` 0, `[` 27, `?` 127.
function control_value(b: u8) -> i64
    if b == '?'
        return 127

    if b >= 'a' && b <= 'z'
        return to_i64(b - 'a').must() + 1
    return to_i64(b - '@').must()

# The visible ASCII characters, 32 to 126, for the one question a code can be
# answered with as text here: which of them it names.
constant VISIBLE: str
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# The character a code names, as it is written inside the literal `ctx` is, or
# nothing where the code names no visible ASCII character.
function written(value: i64, ctx: escape.Quoted) -> str?
    if value < 32 || value > 126
        return fail(code: "unseen", msg: "not a visible ASCII character")
    ch = VISIBLE.slice(from: value - 32, to: value - 31)

    if ch == "\\"
        return ok("\\\\")

    if ch == "\"" && ctx == .in_str
        return ok("\\\"")

    if ch == "'" && ctx == .in_char
        return ok("\\'")
    return ok(ch)

## Tests

test "an escape by a character's code ends past its digits and names its value"
    assert code_end("x41Z", at: 0) == 3
    assert code_end("u00e9Z", at: 0) == 5
    assert code_end("u{1F600}Z", at: 0) == 8
    assert code_end("U0001F600Z", at: 0) == 9
    assert code_end("101Z", at: 0) == 3
    assert code_end("0Z", at: 0) == 1
    assert code_end("aZ", at: 0) == 1
    assert code_end("dZ", at: 0) == 0
    assert code_end("users", at: 0) == 0
    assert code_value("x41", at: 0, end: 3) == 65
    assert code_value("u{1F600}", at: 0, end: 8) == 128512
    assert code_value("101", at: 0, end: 3) == 65
    assert code_value("0", at: 0, end: 1) == 0
    assert written(65, .in_str).must() == "A"
    assert written(34, .in_str).must() == "\\\""
    assert written(39, .in_char).must() == "\\'"
    assert written(0, .in_char).is_err()

test "a code braced or by a control letter names its value, and none past a brace never closed"
    assert code_value("\"\\x{41}\"", at: 2, end: 7) == 65
    assert code_value("\"\\x{41\"", at: 2, end: 4) == -1
    assert code_value("\"\\o{101}\"", at: 2, end: 8) == 65
    assert code_value("\"\\N{U+41}\"", at: 2, end: 9) == 65
    assert code_value("\"\\cA\"", at: 2, end: 4) == 1
    assert code_value("\"\\c?\"", at: 2, end: 4) == 127
    assert code_value("\"\\C-a\"", at: 2, end: 5) == 1
    assert code_value("\"\\M-A\"", at: 2, end: 5) == 193
    assert code_value("\"\\M-\\C-a\"", at: 2, end: 8) == 129
    assert code_value("\"\\E\"", at: 2, end: 3) == 27
