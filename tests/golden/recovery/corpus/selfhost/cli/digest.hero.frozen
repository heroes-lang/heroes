# The content digest every cache key in this compiler is built from.
#
# It lived in `toolchain.hero` until 2026-08-26 and moved for a
# reason the LANGUAGE gave: `deps.hero` needs to hash a file, and
# `toolchain.hero` needs to ask `cli_deps` whether the runtime's
# object is still fresh. Heroes refuses module cycles (`module_cycle`
# fires on the `use` edge whatever it carries), so the two could not
# both exist while the hash sat inside the toolchain. Hashing bytes is
# not toolchain business anyway — nothing here knows what clang is —
# and CLAUDE.md §11's single-concern rule says the same thing from the
# other side.
#
# TWO POLYNOMIAL HASHES, bases 131 and 137, mod 2^31-1 — the mangler's
# own math, sixteen hex digits, deterministic across runs and machines
# with no seed. That last property is the one the caches rest on, and
# it is the same guarantee CLAUDE.md §5's BTreeMap-only rule bought for
# map order. FNV-64 was refused for a reason that is about this
# language rather than about the hash: Heroes arithmetic ABORTS on
# overflow by design, so wrapping u64 multiplication is not a thing
# this language can say. 62 bits of key against the bootstrap's 64.

function digest(text: str) -> str
    m = 2147483647
    a: i64 @ 0
    b: i64 @ 0
    index: i64 @ 0

    while index < text.len()
        v = text[index].to_i64().must()
        a @ (a * 131 + v) % m
        b @ (b * 137 + v) % m
        index @ index + 1

    return hex8(a) + hex8(b)

function hex8(number: i64) -> str
    ds = "0123456789abcdef"
    out: str @ ""
    value: i64 @ number
    count: i64 @ 0

    while count < 8
        d = value % 16
        out @ ds.slice(from: d, to: d + 1) + out
        value @ value / 16
        count @ count + 1

    return out

test "the digest is a function of the bytes, and always sixteen wide"
    assert digest(text: "abc") == digest(text: "abc")
    assert digest(text: "abc") != digest(text: "abd")
    assert digest(text: "").len() == 16
    assert digest(text: "abc").len() == 16

    # A one-byte difference at the END moves it too: a hash that only
    # looked at a prefix would pass the line above and let a cache serve
    # yesterday's object for a file edited on its last line.
    assert digest(text: "aaaaaaaaaaaaaaaaaaaa1") != digest(text: "aaaaaaaaaaaaaaaaaaaa2")

test "hex8 pads to eight and reads low digits first"
    assert hex8(number: 0) == "00000000"
    assert hex8(number: 255) == "000000ff"
    assert hex8(number: 2147483647) == "7fffffff"
