# What the words beside a foreign word say about it, read from the text alone
# (design.md §4.17; defect 133, 2026-09-29).
#
# `word_place.hero` says WHERE a word stands; these questions ask what stands
# BESIDE it, which decides whether a certain swap writes the word the place
# wants (`foreign_at.hero`): a header after `include`, a name after a
# declaration's keyword, a value after `elif` and `switch`, an `if` above an
# `elif` that the `elif` continues, arms below a `switch`. Split from
# `word_place.hero` at the coordinator's gate of lane 132, where the `if` a
# line's value begins (`return if c`) was added and took that module past §11's
# 300 lines; the seam is the one its own section heading named.
#
# | entry | called by |
# |---|---|
# | `header_after`, `continues_an_if`, `name_after`, `value_after`, `arms_below` | `foreign_at` |

use token
use bytes
use word_place

## The questions

# Whether what follows the word names a C header: a string that ends in
# `.h`, or `<`, as `include <stdio.h>` writes it.
function header_after(text: str, end: i64) -> bool
    i: i64 @ end

    while i < text.len() && text[i] == ' '
        i @ i + 1

    if i >= text.len()
        return false

    if text[i] == '<'
        return true

    if text[i] != '"'
        return false
    close: i64 @ i + 1

    while close < text.len() && text[close] != '"' && text[close] != '\n'
        close @ close + 1

    return close - i > 2 && text[close - 2] == '.' && text[close - 1] == 'h'

# Whether the line the word opens continues an `if` above it: the nearest
# line above at a margin no deeper, past blank lines and comments, is at the
# same margin and opens with `if`, `else if` or `elif`, or holds an `if` as
# the value its line begins (`return if c`, `x = if c`), whose `else` stands
# at that line's margin too.
function continues_an_if(text: str, span: token.Span) -> bool
    begins = word_place.line_start(text, at: span.start)
    margin = span.start - begins
    at: i64 @ begins

    while at > 0
        above = word_place.line_start(text, at: at - 1)
        first = word_place.first_mark(text, from: above)

        if first < text.len() && text[first] != '\n' && text[first] != '#' && first - above <= margin
            if first - above != margin
                return false
            word = text.slice(from: first, to: word_place.word_end(text, from: first))

            # A plain `else` ends the chain: only `else if` goes on with it.
            if word == "else"
                after = word_place.first_mark(text, from: first + 4)
                return text.slice(from: after, to: word_place.word_end(text, from: after)) == "if"
            return word == "if" || word == "elif" || holds_an_if(text, from: first)
        at @ above

    return false

# Whether the line at `from` holds the word `if` outside its strings,
# characters and comment: the value `return if c` and `x = if c` begin,
# which the lines below it continue as a chain does.
function holds_an_if(text: str, from: i64) -> bool
    i: i64 @ from

    while i + 1 < text.len() && text[i] != '\n' && text[i] != '#'
        ch = text[i]

        if ch == '"' || ch == '\''
            i @ word_place.past_quoted(text, from: i, quote: ch, limit: text.len())
        else if ch == 'i' && text[i + 1] == 'f' && (i == from || !is_word_byte(text[i - 1])) && (i + 2 >= text.len() || !is_word_byte(text[i + 2]))
            return true
        i @ i + 1

    return false

function is_word_byte(ch: u8) -> bool
    return bytes.is_alnum(ch) || ch == '_'

# Whether a `match` could stand where the word does: a value follows it on
# its line, and the next line with words, deeper than this one, holds an
# arm's `=>`. `switch x = 5`, `switch` alone and `switch f()` over a body are
# none of them a `match`.
function arms_below(text: str, span: token.Span) -> bool
    if !value_after(text, end: span.end)
        return false
    at = word_place.first_mark(text, from: span.end)
    begins = word_place.line_start(text, at: span.start)
    margin = word_place.first_mark(text, from: begins) - begins
    line: i64 @ at

    while line < text.len() && text[line] != '\n'
        line @ line + 1

    while line < text.len()
        next = line + 1
        first = word_place.first_mark(text, from: next)

        if first >= text.len()
            return false

        if text[first] != '\n' && text[first] != '#'
            if first - next <= margin
                return false
            return holds_an_arrow(text, from: first)
        line @ first

        while line < text.len() && text[line] != '\n'
            line @ line + 1

    return false

# Whether a name follows the word on its line, which every declaration's
# keyword owes: `const` alone heads nothing.
function name_after(text: str, end: i64) -> bool
    at = word_place.first_mark(text, from: end)
    return at < text.len() && (bytes.is_alpha(text[at]) || text[at] == '_' || text[at] == '"')

# Whether a value begins after `end` on its line: `elif x` has its
# condition, `elif` alone has none.
function value_after(text: str, end: i64) -> bool
    at = word_place.first_mark(text, from: end)
    return at < text.len() && begins_a_value(text[at])

function begins_a_value(ch: u8) -> bool
    return bytes.is_alnum(ch) || ch == '_' || ch == '(' || ch == '[' || ch == '"' || ch == '\'' || ch == '-' || ch == '!' || ch == '.'

function holds_an_arrow(text: str, from: i64) -> bool
    i: i64 @ from

    while i + 1 < text.len() && text[i] != '\n'
        if text[i] == '=' && text[i + 1] == '>'
            return true
        i @ i + 1

    return false

## Tests

function at_word(text: str, word: str) -> token.Span
    i: i64 @ 0

    while i + word.len() <= text.len()
        if text.slice(from: i, to: i + word.len()) == word && (i == 0 || !bytes.is_alnum(text[i - 1]))
            return token.Span(start: i, end: i + word.len())
        i @ i + 1

    return token.Span(start: 0, end: 0)

test "a match stands only over a value with arms below it"
    over = "    y = switch x\n        1 => 2\n"
    assert arms_below(over, at_word(text: over, word: "switch"))
    bound = "    switch x = 5\n    print(x)\n"
    assert !arms_below(bound, at_word(text: bound, word: "switch"))
    alone = "    y = switch\n"
    assert !arms_below(alone, at_word(text: alone, word: "switch"))
    body = "    switch f()\n        print(1)\n"
    assert !arms_below(body, at_word(text: body, word: "switch"))

test "a declaration's keyword owes a name after it"
    assert name_after("const MAX", end: 5)
    assert !name_after("const\n", end: 5)
    assert !name_after("fn(x)", end: 2)

test "a header follows an include, and an elif continues an if"
    assert header_after("include \"stdio.h\"", end: 7)
    assert header_after("include <stdio.h>", end: 7)
    assert !header_after("import \"geom\"", end: 6)
    assert !header_after("import geom", end: 6)
    chain = "function f()\n    if x\n        print(1)\n\n    elif y\n"
    assert continues_an_if(chain, at_word(text: chain, word: "elif"))
    alone = "function f()\n    print(1)\n    elif y\n"
    assert !continues_an_if(alone, at_word(text: alone, word: "elif"))
    ended = "function f()\n    if x\n        print(1)\n    else\n        print(2)\n    elif y\n"
    assert !continues_an_if(ended, at_word(text: ended, word: "elif"))
    chained = "function f()\n    if x\n        print(1)\n    else if z\n        print(2)\n    elif y\n"
    assert continues_an_if(chained, at_word(text: chained, word: "elif"))

# An `if` that is a line's value is continued at that line's margin, as
# `else` continues it (the coordinator's gate of lane 132, 2026-09-29: the
# rule read only a line that opens with `if`, so `return if` lost its
# `elif` and cost two messages of debris below it).
test "an elif continues an if that is its line's value, and no if in a string or a comment"
    valued = "function f() -> i64\n    return if x == 1\n        1\n    elif x == 2\n"
    assert continues_an_if(valued, at_word(text: valued, word: "elif"))
    bound = "function f()\n    y = if x\n        1\n    elif z\n"
    assert continues_an_if(bound, at_word(text: bound, word: "elif"))
    quoted = "function f()\n    s = \"if\"\n    elif z\n"
    assert !continues_an_if(quoted, at_word(text: quoted, word: "elif"))
    commented = "function f()\n    s = 1  # if\n    elif z\n"
    assert !continues_an_if(commented, at_word(text: commented, word: "elif"))
    named = "function f()\n    if_done = true\n    elif z\n"
    assert !continues_an_if(named, at_word(text: named, word: "elif"))
