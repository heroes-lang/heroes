# The report of an escape the language does not have: the diagnostic, in
# the escape's own words, and the fixes its reading owes (spec § 2 Literals;
# design.md §4.17; defect 135's class, lane recovery-b3). What the escape
# reads as is `escape_readings`, which asks only its bytes; this module turns
# that answer into what the author reads, so a reading's repair is written
# once, beside its message. Called by `literals.escape_step`, for every
# escape `escape.escape_text` refuses that is not the other context's.

use token
use diag
use state
use escape
use bytes
use escape_readings
use escape_codes
use raw_chars
use shown_char

# The diagnostic for the escape whose backslash is at `backslash`, in the
# escape's own words, its fixes by its reading, pushed; and the position past
# the escape, which for one by its code is past its digits, so a character
# literal counts `'\x41'` as the one character it was written as.
function report(@l: state.LexState, text: str, backslash: i64, literal: i64, ctx: escape.Quoted) -> i64
    escaped = bytes.char_at(text, backslash + 1)
    r = escape_readings.reading(text, backslash: backslash, literal: literal, ctx: ctx)

    end = match r
        .code c                               => c.end
        .name n                               => n.end
        .backslash | .hole _ | .bare | .brace => backslash + 1 + escaped.len()

    span = token.Span(start: backslash, end: end)
    shown = text.slice(from: backslash, to: end)
    opening = escape_readings.quoted(shown) + " is not an escape sequence — "

    # In the piece of an `f"…"` literal a `{` opens a hole and a `}` alone is
    # refused, so a guess that writes a brace there writes it doubled, and
    # means what its title says: the backslash before `\x{41}` is
    # `\\x{{41}}` (defect 135's L4; the `}` since panel 184 R1).
    in_piece = ctx == .in_str && text[literal] != '"'
    backslashed = diag.Fix(
        title: "escape the backslash: " + escape_readings.quoted(as_text("\\" + shown, in_piece: in_piece)),
        replacement: as_text("\\" + shown, in_piece: in_piece),
        span: span,
        certainty: .guess
    )
    d: diag.Diagnostic @= diag.new_diagnostic(code: "unknown_escape", message: opening, span: span)

    match r
        .backslash =>
            d.message @ opening + "the escapes are " + escape.legal(ctx) + "; write `\\\\` for a literal backslash"
            d.fixes @ d.fixes.push(
                diag.Fix(title: backslashed.title, replacement: backslashed.replacement, span: span, certainty: .certain)
            )
        .hole h =>
            hole = "{" + text.slice(from: backslash + 2, to: h.close) + "}"
            d.message @ opening + "a value is written into a string as " + escape_readings.quoted(hole) + " in an `f\"…\"` literal, and `\\\\` writes a backslash"
            d.fixes @ d.fixes.push(
                hole_fix(text: text, hole: hole, backslash: backslash, close: h.close, literal: literal)
            )
            d.fixes @ d.fixes.push(backslashed)
        .code c =>
            value = escape_codes.code_value(text, at: backslash + 1, end: c.end)
            one = escape_codes.written(value, ctx)

            if ctx == .in_char
                d.message @ opening + "a character literal is its character's code, an integer, and this language has no escape for a character by its code: write the character, or its number"

                if value >= 0 && literal + 1 == backslash && c.end < text.len() && text[c.end] == '\''
                    d.fixes @ d.fixes.push(
                        diag.Fix(title: "write the number: `" + value.to_str() + "`", replacement: value.to_str(), span: token.Span(start: literal, end: c.end + 1), certainty: .guess)
                    )
            else
                d.message @ opening + by_code(value) + "; write `\\\\` for a literal backslash"

            # A character a line cannot show is written `\u{1b}` (panel 192's
            # R5), its braces the escape's own, never doubled in an `f` piece,
            # and a tab, a line feed or a carriage return by its letter. A
            # guess: the same bytes are a path's backslash, `"bin\x86"`, as
            # often as a character.
            if ctx == .in_str && raw_chars.written_by_code(value)
                d.fixes @ d.fixes.push(
                    diag.Fix(title: "write it by its code: `" + raw_chars.escaped(value) + "`", replacement: raw_chars.escaped(value), span: span, certainty: .guess)
                )

            if ctx == .in_str && value >= 0 && value < 32 && escape.letter_of(value).len() > 0
                d.fixes @ d.fixes.push(
                    diag.Fix(title: "write it as `" + escape.letter_of(value) + "`", replacement: escape.letter_of(value), span: span, certainty: .guess)
                )

            if !one.is_err()
                itself = as_text(one.must(), in_piece: in_piece)
                d.fixes @ d.fixes.push(
                    diag.Fix(title: "write the character itself: " + escape_readings.quoted(itself), replacement: itself, span: span, certainty: .guess)
                )

            if ctx == .in_str
                d.fixes @ d.fixes.push(backslashed)
        .name _ =>
            # A name this compiler has no table for, so the character itself
            # is the author's to write; `\\` is the one repair it can show.
            if ctx == .in_char
                d.message @ opening + "a character literal is its character's code, an integer, and this language has no escape for a character by its name: write the character, or its number"
            else
                d.message @ opening + "a string holds its characters as themselves, and this language has no escape for one by its name: write the character itself, or `\\\\` for a literal backslash"
                d.fixes @ d.fixes.push(backslashed)
        .bare =>
            d.fixes @ d.fixes.push(
                diag.Fix(title: "drop the backslash: " + escape_readings.quoted(escaped), replacement: escaped, span: span, certainty: .guess)
            )

            if ctx == .in_char
                d.message @ opening + "the escapes are " + escape.legal(ctx) + "; a character literal holds one character, written bare, and a backslash is `'\\\\'`"
                d.fixes @ d.fixes.push(
                    diag.Fix(title: "write a backslash: `\\\\`", replacement: "\\\\", span: span, certainty: .guess)
                )
            else
                d.message @ opening + escape_readings.quoted(escaped) + " needs no escape inside a string, write it bare; write `\\\\` for a literal backslash"
                d.fixes @ d.fixes.push(backslashed)
        .brace =>
            doubled = escaped + escaped
            d.message @ opening + "a brace is written `" + doubled + "` in an `f\"…\"` literal; write `\\\\` for a literal backslash"
            d.fixes @ d.fixes.push(
                diag.Fix(title: "write the brace: `" + doubled + "`", replacement: doubled, span: span, certainty: .guess)
            )
            d.fixes @ d.fixes.push(backslashed)

    state.push_diagnostic(@l.diagnostics, d)
    return end

# What a string says of an escape by code that names `value` (panel 192's
# R5): a character a line cannot show is written `\u{…}`, a tab, a line feed
# and a carriage return by their letters, a NUL by no escape, and any other
# as itself.
function by_code(value: i64) -> str
    if value < 0 || value > 1114111 || value >= 55296 && value <= 57343
        return "it names no character, and a string writes by its code only " + raw_chars.CLASS + ", as `\\u{1b}`, in lowercase hexadecimal"

    if value == 0
        return "no escape writes a NUL, a byte no screen shows: a `str` that must hold one is built from bytes as the program runs, a `[u8]` read by `validated_bytes()`"

    if raw_chars.written_by_code(value)
        return "a string writes " + shown_char.named(escape.encoded(value)) + " by its code, as `" + raw_chars.escaped(value) + "`"

    if value < 32
        return "a string writes this character as `" + escape.letter_of(value) + "`"
    return "a string holds its characters as themselves, and writes by its code only " + raw_chars.CLASS + ", as `\\u{1b}`"

# The value written into the string: in the piece of an `f"…"` literal the
# hole alone, over the escape to its `)`; in a plain string the whole literal
# as the `f"…"` one it meant, where it closes on its line; and where it does
# not, the hole over the escape, which is then only an example.
function hole_fix(text: str, hole: str, backslash: i64, close: i64, literal: i64) -> diag.Fix
    here = token.Span(start: backslash, end: close + 1)

    if text[literal] == '"'
        closes = escape_readings.plain_end(text, literal: literal)

        if closes >= 0
            rewritten = escape_readings.interpolated(text, from: literal, to: closes)
            return diag.Fix(
                title: "write the value into an `f` literal: " + escape_readings.quoted(rewritten),
                replacement: rewritten,
                span: token.Span(start: literal, end: closes),
                certainty: .guess
            )
    return diag.Fix(
        title: "write the value as a hole: " + escape_readings.quoted(hole),
        replacement: hole,
        span: here,
        certainty: .guess
    )

# The text a fix writes, as it reads where it lands: in the piece of an
# `f"…"` literal every brace doubled, since a `{` alone opens a hole there, a
# `}` alone is refused (panel 184 R1), and `{{` and `}}` are the braces;
# anywhere else as it is.
function as_text(s: str, in_piece: bool) -> str
    if !in_piece
        return s
    out: [str] @= []
    run: i64 @= 0
    i: i64 @= 0

    while i < s.len()
        if s[i] == '{' || s[i] == '}'
            out @ out.push(s.slice(from: run, to: i + 1) + s.slice(from: i, to: i + 1))
            run @ i + 1
        i @ i + 1

    out @ out.push(s.slice(from: run, to: s.len()))
    return out.join("")

test "a fix's text in an f piece doubles its brace, and elsewhere stays"
    # Panel 184 R1: the first read `\\x{{41}` until 2026-10-02, a lone `}`.
    assert as_text("\\\\x{41}", in_piece: true) == "\\\\x{{41}}"
    assert as_text("\\\\x{41}", in_piece: false) == "\\\\x{41}"
    assert as_text("{", in_piece: true) == "{{"
    assert as_text("}", in_piece: true) == "}}"
    assert as_text("é{é}", in_piece: true) == "é{{é}}"
