# fixedbugs, defect 094, lane ffi13, 2026-10-06: the spellings the return
# assertion refused before the repair, held now that the accessor's
# declaration asks instead: a compound literal of another struct and a
# number, each told as before, naming the header's type.

extern "fixedbugs-094-values.h"
    record Pt tag pt
        x: i32
        y: i32
    constant PT_OTHER: Pt  #~ ffi_constant_type
    constant PT_SCALAR: Pt  #~ ffi_constant_type

function main()
    print(PT_OTHER.y)
    print(PT_SCALAR.y)
