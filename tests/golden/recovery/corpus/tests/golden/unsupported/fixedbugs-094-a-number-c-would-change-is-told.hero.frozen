# fixedbugs, defect 094, lane ffi13, 2026-10-06: a value C would build
# changed, `300` into a `char` and `1.5` into an `int`, which C says only as
# a warning and the program would have run on 44 and 1. Each is an error in
# the accessor and told on its constant. `internal error`, exit 2, before the
# repair.

extern "fixedbugs-094-values.h"
    record Pt tag pt
        x: i32
        y: i32
    record Cp tag cp
        c: i8
        y: i32
    constant CP_WIDE: Cp  #~ ffi_constant_type
    constant PT_HALF: Pt  #~ ffi_constant_type

function main()
    print(CP_WIDE.c)
    print(PT_HALF.x)
