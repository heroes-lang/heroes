variant R28
    a
        inner: R27
    b

variant R29
    a
        inner: R28
    b

variant R30
    a
        inner: R29
    b

variant R31
    a
        inner: R30
    b

function main()
    xs: [R31] = []
    print(xs.len())
    print(xs == xs)
