# Defect 387, 2026-10-06: the write's other shapes. The callee writes its `@`
# parameter by a store rather than a push; the `@` call stands nested inside
# another call's argument; the write comes BEFORE the load in the expression,
# so the load sees it and nothing is borrowed across it; and the read and the
# write repeat in a loop, where the array the load borrowed is grown in
# place on one turn and moved to a new block on another. Each array is one
# nothing else holds, and each line prints what was read.

function half(n: i64) -> i64?
    if n % 2 == 0
        return ok(n / 2)
    return fail(code: "odd", msg: "odd")

function bump(@xs: [i64]) -> i64
    xs @ xs.push(100)
    return xs.len()

function clear(@xs: [i64]) -> i64
    xs @ [9, 9, 9]
    return 0

function total(xs: [i64], n: i64) -> i64
    return xs.len() * 1000 + n

function later(n: i64, xs: [i64]) -> i64
    return xs.len() * 1000 + n

function main()
    a: [i64] @= []
    a @ a.push(5)
    print(total(a, half(4).must() + clear(@a)), " ", a.len())
    b: [i64] @= []
    b @ b.push(5)
    print(total(b, half(4).must() + total(b, bump(@b))))
    c: [i64] @= []
    c @ c.push(5)
    print(later(bump(@c) + half(4).must(), c))
    d: [i64] @= []
    d @ d.push(5)
    sum: i64 @= 0

    for at in range(from: 0, to: 4)
        sum @ sum + total(d, half(at * 2).must() + bump(@d))

    print(sum, " ", d.len())
