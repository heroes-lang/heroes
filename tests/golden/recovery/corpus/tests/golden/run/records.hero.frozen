# Records, end to end: construction with mandatory labels, field reads, nesting, and
# structural `==` (spec lines 57-58, 76-77). A record is a C struct BY VALUE, so
# `b = a` copies and `Pair(one: p, two: q)` copies twice — which is the whole point,
# and what makes the last two lines true.
#
# `dist2` takes its arguments labelled because both are `Point`: §4.9's rule, and it
# fired the first time this file was written unlabelled.
# Bulk regression case.

record Point
    x: i64
    y: i64

record Pair
    one: Point
    two: Point

function dist2(a: Point, b: Point) -> i64
    dx = a.x - b.x
    dy = a.y - b.y
    return dx * dx + dy * dy

function moved(p: Point) -> Point
    return Point(x: p.x + 10, y: p.y)

function main()
    p = Point(x: 0, y: 0)
    q = Point(x: 3, y: 4)
    print(dist2(a: p, b: q))
    print(p == q, p == Point(x: 0, y: 0))
    both = Pair(one: p, two: q)
    print(both.two.y)
    print(both == Pair(one: p, two: q))

    # A copy is independent, so mutating the copy leaves the original alone.
    r: Point @ p
    r @ moved(r)

    # Two prints, not one: `print(r.x, p.x)` writes `100`, which a golden cannot
    # tell from `(1, 0, 0)` — the spec's no-separator rule is right and makes an
    # assertion on two numbers ambiguous.
    print(r.x)
    print(p.x)

    # Nesting, twice deep, compared field by field — never by bytes, which is why
    # `Point`'s two ints padding differently could not make these disagree.
    print(Pair(one: p, two: p) == Pair(one: p, two: q))
