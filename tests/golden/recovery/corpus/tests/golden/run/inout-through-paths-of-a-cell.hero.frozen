# Bulk regression case (assistant-written): the legal side of `@` through a
# path — the root is a cell — and the shape that crashed on 2026-09-03 while
# the eight refusals beside it were being measured. `add(@bs[0], "y")` on a
# cell was accepted and died at exit 138: the emitter had no lvalue for an
# element of a copy-on-write array and handed the callee `&h0_bs`, the whole
# array. `ir/inout.hero` now reads the element into a temporary, the callee
# copies out into it, and the temporary is stored back through the index after
# the call (M-robustness-guards step 1). Three things this case pins: the
# element really changes; two `@` arguments through two indices of two cells
# store back in argument order; and the index expression is evaluated ONCE,
# so `pick` prints once.
#
# **The parenthesis here said *"two through ONE cell is panel 010's alias
# refusal, whatever the indices"* until 2026-09-04, and it was wrong twice
# over.** It was a claim nothing ran — the refusal did not exist in the
# compiler at all, which is defect 011 — and when it landed it landed as a
# comparison of PLACES rather than roots (panel 110): `@xs[0]` and `@xs[1]`
# of one cell reach disjoint memory and are accepted, while `@xs[i]` and
# `@xs[j]` are refused. The refusals live in
# `tests/golden/check/fixedbugs-two-mutable-arguments-of-one-place.hero` and
# the accepted pairs in
# `tests/golden/run/mutable-arguments-that-do-not-overlap.hero`, so both
# halves are now programs instead of a sentence.
record Bag
    items: [str]

function add(@b: Bag, s: str)
    b.items @ b.items.push(s)

function add_items(@xs: [str], s: str)
    xs @ xs.push(s)

function swap(@a: Bag, @b: Bag)
    held = a
    a @ b
    b @ held

function pick() -> i64
    print("pick")
    return 0

function main()
    b: Bag @ Bag(items: ["a"])
    add_items(@b.items, "x")
    print(b.items.len())
    bs: [Bag] @ [Bag(items: ["a"]), Bag(items: ["b", "c"])]
    add(@bs[0], "y")
    print(bs[0].items.len())
    add_items(@bs[1].items, "z")
    print(bs[1].items.len())
    cs: [Bag] @ [Bag(items: ["d", "e", "f", "g"])]
    swap(a: @bs[0], b: @cs[0])
    print(bs[0].items.len())
    print(cs[0].items.len())
    add(@bs[pick()], "w")
    print(bs[0].items.len())
