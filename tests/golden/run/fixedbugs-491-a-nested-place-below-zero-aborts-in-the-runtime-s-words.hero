# FIXED DEFECT 491, 2026-10-08 (lane b15-emit): as the case beside it, for an
# index below zero, the other branch of the in-place check.

record Row
    cells: [i64]

function main()
    rows: [Row] @= [Row(cells: [1, 2]), Row(cells: [3, 4])]
    at: i64 = 0 - 1
    rows[0].cells[1] @ 20
    print(rows[0].cells[1])
    rows[at].cells[0] @ 1
    print(0)
