# fixedbugs, defect 2058, lane b17-ffi, 2026-10-14.
#
# SYMPTOM: past `typeorder`'s depth of 32, `rest: zero`'s whole write was
# `t = (T){};`, C23's empty braces, which panel 194 ruled out and which
# `-Werror=c23-extensions` refuses; `{0}` there kills clang by brace elision
# (defect 549), and so do a designated `{.inner = {0}}` and a designator
# chain to the scalar (measured at a thousand deep, Apple clang 21).
#
# FIX: past the depth the whole write reads the cell back through the memset
# that zeroes it, `t = *(T *)__builtin_memset(&t, 0, sizeof t);`, C11 with
# no initialiser (`emit/zeroed.hero`); the memset after it stands. Records
# forty deep, a union at the bottom, an array of them beside: every field
# zero but the one named.

extern "fixedbugs-2058-deep.h"
    record D0
        i: i32
        f: f32
        v: i64
    record D1
        inner: D0
        n: i32
