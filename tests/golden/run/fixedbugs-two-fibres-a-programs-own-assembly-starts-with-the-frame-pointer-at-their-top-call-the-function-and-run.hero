# Fixed 2026-11-26, defect d-lane-sig-family-3, lane sig-family (step 199g):
# panel 262's compiler-engineer's `fm_top`. Two fibres on quarters of a C
# frame's array, each started by the header's own assembly with its frame
# pointer at its stack's top, switched by `_setjmp`/`_longjmp`; no signal
# handler anywhere, the callback called on a fibre.
# Symptom: before, under `--sanitize` and `--sanitize -O0` on this Mac, exit
# 134, `panic: fmtop.run was called from inside a signal handler: C called it
# while handling a signal`, 3 of 3; plain and Linux arm64 right.
# Cause: the signal guard's walk climbed from the fibre's first frame record,
# at its stack's top, onto two words the runtime itself had left there: its
# own copies of the delivery address it learned, spilled in frames that were
# gone; and on Darwin the only delivery learned is the route's trampoline,
# which a live delivery always records as an entry.
# Fix: the learned addresses are kept masked, so no copy of them reads as a
# delivery; the probe that learns them runs on an alternate stack of its own;
# and the walk looks for the kernel's own delivery alone, none on Darwin.
extern "fixedbugs-two-fibres-a-programs-own-assembly-starts-with-the-frame-pointer-at-their-top.h"
    function fm_start(k: i64, f: (function(i64) -> i64))
    function fm_yield()
    function fm_resume(k: i64) -> i64
    function fm_host(body: (function(i64) -> i64), n: i64) -> i64

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function run(k: i64) -> i64
    v = e5(k + 10)
    fm_yield()
    w = e5(k + 20)
    return v.a.a.a.a.a.x + w.b.b.b.b.b.x

function body(n: i64) -> i64
    mine = e5(n)
    fm_start(k: 0, f: run)
    fm_start(k: 1, f: run)
    print("body holds ", mine.a.a.a.a.a.x)
    b = fm_resume(k: 1)
    print("body holds ", mine.a.a.a.a.a.x)
    a = fm_resume(k: 0)
    print("body holds ", mine.a.a.a.a.a.x, " fibres ", a, " ", b, " (7, 30 and 32 are right)")
    return mine.h.h.h.h.h.x

function main()
    print("fibres carved, jumped into: ", fm_host(body: body, n: 7))
