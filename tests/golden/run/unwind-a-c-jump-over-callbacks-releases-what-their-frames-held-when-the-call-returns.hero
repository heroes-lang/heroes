# Panel 258's R2, ratified by the author's reading on 2026-11-27 (decision
# 2758): a C library jumps over the frames of the function the program handed
# it, 1,000 times, as libpng's `png_error` jumps over a read function. The
# frames C leaves hold a `str`, an array of them, a map, a record holding a
# `str`, an option and a case, two frames deep under the callback, and a
# callback nested in a second call of the same library.
# Before R2: each jump left what those frames held owned by nobody, 9 blocks a
# round here, and the exit audit forgave every program in which a callback
# never returned (defect 2704), so a leak of the compiler's was forgiven too.
# Since R2: the program hands a C library's group a function, so every counted
# slot of the functions C may call back and of all they reach is declared with
# a cleanup and its unit built `-fexceptions`; the jump's hook unwinds the
# frames it leaves, the cleanups move each value onto a list, and the list is
# released when `uw_guard`, the call holding the save point, returns into
# `main` (`runtime/parts/unwind.c`). No callback stays unfinished, so the exit
# audit reads the balance and finds every block given back: this case ends at
# exit 0 only if each value was collected and released, once.
extern "unwind-catch.h"
    function uw_guard(cb: (function(i64) -> i64), n: i64) -> i64
    function uw_throw()

record Named
    name: str
    size: i64

variant Shape
    circle
        label: str
    square
        side: i64

function deeper(n: i64) -> i64
    words: [str] = [f"w{n}", f"x{n}"]
    seen: {str: i64} @= {}
    seen[f"k{n}"] @ n
    named = Named(name: f"named {n}", size: n)
    maybe: str? = ok(f"maybe {n}")
    shape: Shape = .circle(label: f"circle {n}")

    if n >= 0
        uw_throw()
    return words.len() + seen.len() + named.size + maybe.must().len() + shape_size(shape)

function shape_size(s: Shape) -> i64
    return match s
        .circle c => c.label.len()
        .square q => q.side

function body(n: i64) -> i64
    held = f"held by the callback, round {n}"

    # The inner call jumps to the inner save point, leaving `inner` alone;
    # this frame and `deeper`'s are left by the outer jump below.
    _ = uw_guard(cb: inner, n: n)
    return held.len() + deeper(n)

function inner(n: i64) -> i64
    kept = f"inner {n}"
    uw_throw()
    return kept.len()

function main()
    jumped: i64 @= 0

    for round in range(from: 0, to: 1000)
        if uw_guard(cb: body, n: round) == -1
            jumped @ jumped + 1

    print("C jumped over the callbacks ", jumped, " times")
