# Panel 194 R1 (M-buildable-structs), lane b13-bs, 2026-10-06: a `partial`
# record names some of the header's fields, and a construction ending with
# `rest: zero` leaves what it does not name zero, a union the record never
# declares included: its size is C's, and so are the bytes the words zero.

extern "ffi-rest-zero.h"
    record SP partial
        kind: i32
    function dirty()
    function sp_union(@s: SP) -> i64

function built() -> SP
    return SP(kind: 4, rest: zero)

function main()
    dirty()
    s: SP @ built()
    print(s.kind, " ", sp_union(@s))
