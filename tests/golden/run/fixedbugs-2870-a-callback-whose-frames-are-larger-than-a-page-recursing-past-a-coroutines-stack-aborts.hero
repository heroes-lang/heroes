# Fixed 2026-11-27, defect 2870, lane sig-family-2 (panel 262's
# compiler-engineer, `so`): the same recursion, each frame holding a record of
# 32 KiB, so each is probed before it is touched (`___chkstk_darwin` on this
# Mac, `-fstack-clash-protection` on Linux) and the probe faults where `sp`
# still stands above it.
# Symptom: the program died by the fault with nothing said, Bus error, exit
# 138, on this Mac and Segmentation fault, exit 139, on Linux arm64, where the
# same recursion on the thread's own stack says `panic: stack exhausted`.
# Cause: the stack guard's handler (`runtime/parts/stack.c`) asked a fault of
# the thread's own stack alone, and a coroutine's stack is no stack it
# measured, so the fault went on to the default.
# Fix: where the thread's own stack does not explain a fault, the stack
# `makecontext` was handed whose lowest address lies nearest above it is asked
# the same two witnesses, and the walk that names the function is bounded by
# that stack.
extern "fixedbugs-2870-a-coroutines-guarded-stack.h"
    function gs_run(cb: (function(i64) -> i64), n: i64) -> i64
    record Big tag gs_big partial
        first: i64
    function gs_big_first(b: Big) -> i64

function deep(n: i64) -> i64
    if n == 0
        return 1
    big = Big(first: n, rest: zero)
    return gs_big_first(b: big) + deep(n - 1)

function main()
    print("depth reached: ", gs_run(cb: deep, n: 10000000))
