# Fixed 2026-11-13, defect 2496, lane b34-signals: a signal sent to the
# process while a thread `hero_thread_spawn` started is beginning.
# Symptom: a Heroes function given to C's `signal` stopped the program at 134,
# `ran on a thread this program did not start`, when the signal reached a
# worker before the worker had claimed itself: 8 runs of 50 on this Mac and 3
# of 50 in Linux arm64 with one worker (the issue's `whichthread2`).
# Cause: a worker could take a signal from its first instruction and claimed
# itself only once its start ran; it now begins with every signal but a
# fault's held off, lets them through once its claim and its stack guard
# stand, and `hero_thread_spawn` returns only then, so the handler runs on a
# thread this program owns. Each of 200 rounds starts a worker, holds SIGUSR1
# off `main` so that only the worker can take it, and sends it at once; the
# worker waits for its round's signal, and the handler counts and allocates
# nothing. Without the repair the first rounds already reach a worker
# unclaimed.
# Rewritten 2026-11-13, lane b35-signals (panel 247's R8): since R1 a Heroes
# function given to `signal` is refused at its first signal, so the handler
# is the program's own C, handed to `signal` from Heroes, and it keeps the
# thread it ran on: each worker counts its round only where the handler ran
# on itself, which the count alone did not say (with the handler deferred to
# another thread it printed 200 all the same, panel 247's compiler-engineer).
# What the case holds of the repair is the worker's mask: started with every
# signal held off and let through once claimed, as its starter's was.

extern "fixedbugs-2496-a-signal-sent-as-a-thread-starts.h"
    function fresh_hold() -> i64
    function fresh_free() -> i64
    function fresh_send() -> i64
    function fresh_on_signal(sig: i32)
    function fresh_here() -> i64
    function fresh_heard_count() -> i64
    function fresh_wait_heard(want: i64) -> i64

extern "signal.h"
    constant SIGUSR1: i32
    function signal(sig: i32, handler: (function(sig: i32) -> ())) -> ptr

extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64

# The worker's whole life is waiting for its round's signal, so the signal
# finds it alive and letting signals through: 1 once it was handled meanwhile
# on this worker, the one thread not holding it then; 0 if it never came or
# another thread ran the handler.
function awaits(round: i64) -> i64
    heard = fresh_wait_heard(want: round + 1) - round

    if heard == 1 && fresh_here() == 1
        return 1
    return 0

function main()
    _ = signal(sig: SIGUSR1, handler: fresh_on_signal)
    rounds @= 0
    seen @= 0

    while rounds < 200
        worker = hero_thread_spawn(body: awaits, arg: rounds)
        _ = fresh_hold()
        _ = fresh_send()
        seen @ seen + hero_thread_join(handle: worker)
        _ = fresh_free()
        rounds @ rounds + 1

    print(rounds, " rounds, ", seen, " signals handled on the worker they were sent to")
