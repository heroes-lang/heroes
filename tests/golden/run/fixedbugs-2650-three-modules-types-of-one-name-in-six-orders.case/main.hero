# fixedbugs, defect 2650, 2026-11-21: three modules' `Value`, in the six
# orders of `(function(a: A, b: B) -> C)`: every order rendered alike and
# named one set, so the six were one C typedef and one instance of `call`.
#
# The cause, for every case of defect 2650: a synthetic C name was the hash
# of the type's rendering, which writes no module, and of the sorted set of the
# declared types it names, the same set either way round. Where that set does
# not tell which declaration each name stands for, the key also carries those
# declarations in the rendering's order (`selfhost/emit/synth_places.hero`).
use other
use third

record Value
    n: i64

function abc(a: Value, b: other.Value) -> third.Value
    return third.Value(n: a.n + b.n * 10)

function acb(a: Value, b: third.Value) -> other.Value
    return other.Value(n: a.n + b.n * 10)

function bac(a: other.Value, b: Value) -> third.Value
    return third.Value(n: a.n + b.n * 10)

function bca(a: other.Value, b: third.Value) -> Value
    return Value(n: a.n + b.n * 10)

function cab(a: third.Value, b: Value) -> other.Value
    return other.Value(n: a.n + b.n * 10)

function cba(a: third.Value, b: other.Value) -> Value
    return Value(n: a.n + b.n * 10)

function call<A, B, C>(f: (function(a: A, b: B) -> C), x: A, y: B) -> C
    return f(a: x, b: y)

function main()
    m = Value(n: 1)
    o = other.Value(n: 2)
    t = third.Value(n: 3)
    print(call(f: abc, x: m, y: o).n, " ", call(f: acb, x: m, y: t).n, " ", call(f: bac, x: o, y: m).n)
    print(call(f: bca, x: o, y: t).n, " ", call(f: cab, x: t, y: m).n, " ", call(f: cba, x: t, y: o).n)
