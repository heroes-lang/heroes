# WRONG on purpose, and the far edge of
# `dead-handle-read-by-c-through-a-cell-it-should-only-write`: the same wrong
# binding, and C reads the last word of an object as large as the region the
# dead value points at, 65,528 bytes in. The region is 64 KiB mapped with no
# access, so the read faults inside it at 0xfff8 and the handler names a dead
# handle rather than a wild address. Defect 115, 2026-09-27: on Windows the
# handler printed no offset at all. Under `--sanitize` ASan's own handler
# reports the fault.

extern "dead-handle-read-by-c-at-the-last-word-of-the-dead-region.h"
    record X509 tag ob
    function ob_new() -> X509 acquires ob_put
    function ob_last_cell(@a: X509 retains ob_put) -> i32 when 1
    function ob_put(a: X509 consumes)
    function ob_refs(a: X509) -> i64
    function one() -> i64

function main()
    cert: X509 @= ob_new()

    if one() == 1
        ob_put(a: cert)
    assert ob_last_cell(a: @cert) == 1
    print("references held: ", ob_refs(a: cert))
