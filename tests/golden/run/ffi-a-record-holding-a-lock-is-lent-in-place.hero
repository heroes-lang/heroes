# Panel 215's R2, issue 1335, 2026-10-16: what reaches C as the place itself
# is no copy, and builds: an `@` lend of a cell, of a field, and of a field
# of a record of the program's own; an `@` parameter handed on; a field read
# and written in place; a construction into its cell; and a record C returns
# by value, landing in a cell. The sitting's ffi-pragmatist ran these shapes
# on Darwin, Linux arm64 and the Windows box, each building and printing the
# same before and after the refusal (`215-reports/ffi-pragmatist-build.md`).

extern "ffi-a-lock-held-in-place.h"
    record Counter tag counter partial
        n: i64
    function counter_init(@c: Counter) -> i32
    function counter_lock(@c: Counter) -> i32
    function counter_unlock(@c: Counter) -> i32
    function add_to(@n: i64) -> i32
    function counter_made() -> Counter

record Holder
    c: Counter
    k: i64

function twice(@c: Counter)
    _ = counter_lock(@c)
    _ = add_to(@c.n)
    _ = add_to(@c.n)
    _ = counter_unlock(@c)

function main()
    c: Counter @= Counter(n: 0, rest: zero)
    _ = counter_init(@c)
    twice(@c)
    h: Holder @= Holder(c: Counter(n: 5, rest: zero), k: 1)
    _ = counter_init(@h.c)
    twice(@h.c)
    h.c.n @ h.c.n + 1
    m: Counter @= counter_made()
    _ = counter_lock(@m)
    _ = counter_unlock(@m)
    print(c.n, " ", h.c.n, " ", h.k, " ", m.n)
