# DEFECT 2584: on Darwin a raised SIGILL was told as dying at a trap
# instruction (batch 39's lane b39-runtime, beside defect 2571, 2026-11-15).
#
# The lease handler's line names who raised the signal from `siginfo_t`, and
# it said `at a trap instruction` for every `si_code` above 0. Darwin delivers
# `raise(SIGILL)` with `si_code` 2 and `si_pid` 0, exactly as it delivers a
# `udf`, so the line named a trap the program never ran: `the process is
# dying of SIGILL, at a trap instruction, under ...`, exit 132, 3 of 3 on
# this Mac. Nothing in `siginfo_t` shows a trap instruction on every platform,
# and the clause is no longer said; a sender is named where one is shown.
#
# What the line holds differs by platform (Linux shows the sender, Darwin
# does not), and what this case asserts is an absence, which an ending line
# cannot. So the program is its own child: with `child` it raises SIGILL and
# dies; with nothing it starts that child, keeps its standard error in a file
# under `build/`, and says what the child's line holds
# (`fixedbugs-2584-a-raised-sigill-names-no-trap-instruction.h`).
extern "fixedbugs-2584-a-raised-sigill-names-no-trap-instruction.h"
    function raised_ill()

extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_limit(seconds: i64)
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_dir_remove_tree(path: cstr lent) -> i64
    function hero_os_pid() -> i64
    constant HERO_OS_OK: i64

# Whether `needle` occurs in `text`, a byte at a time.
function holds(text: str, needle: str) -> bool
    at: i64 @= 0

    while at + needle.len() <= text.len()
        k: i64 @= 0

        while k < needle.len() && text[at + k] == needle[k]
            k @ k + 1

        if k == needle.len()
            return true
        at @ at + 1

    return false

function main()
    if args().len() > 0 && args()[0] == "child"
        raised_ill()
        print("not reached")
        return
    root = "build/heroes-golden-2584-" + hero_os_pid().to_str()
    _ = hero_fs_mkdir_all(path: root.cstr())
    status: i64 @= 0
    marks: i64 @= 0
    program = hero_exe_path_shown(status: @status, marks: @marks)
    hero_run_arg(word: program)
    hero_run_arg(word: "child")
    hero_run_limit(seconds: 60)
    code = hero_run_go(
        program: program.cstr(),
        in_path: "".cstr(),
        out_path: (root + "/out.txt").cstr(),
        err_path: (root + "/err.txt").cstr(),
        @status
    )
    hero_run_reset()
    said = read_file(root + "/err.txt").default("")
    print("the child started: ", status == HERO_OS_OK)
    print("the child stopped: ", code != 0)
    print(
        "its line says this runtime did not raise it: ",
        holds(text: said, needle: "and this runtime did not raise it")
    )
    print("its line names a trap instruction: ", holds(text: said, needle: "at a trap instruction"))
    _ = hero_dir_remove_tree(path: root.cstr())
