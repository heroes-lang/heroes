# fixedbugs, defect 2334, 2026-11-08 (panel 236's R1 and R6): 1,024 reads of
# elements of an 8 KiB group record's fixed-array field in one function. Each
# read loaded the whole record into a temporary of its own and took the element
# from the copy: 1,025 temporaries of 8 KiB, `total`'s frame 8,956,096 bytes at
# `-O0`, `panic: stack exhausted` at the default level. Rule B now keeps the
# record off the frame and hands it to `total` in place, and an element of a
# fixed array a place holds is read from the place itself (`ir/in_place.hero`'s
# `element`): no read copies the record, and 1,000 calls at `-O2` cost what they
# cost before rule B moved the copies into the room.
extern "fixedbugs-2334-big.h"
    record Big tag fixedbugs_2334_big
        f0: u8[8192]
    function fixedbugs_2334_make() -> Big

function total(b: Big) -> i64
    t: i64 @= 0
    t @ t + b.f0[0].to_i64().must()
    t @ t + b.f0[7].to_i64().must()
    t @ t + b.f0[14].to_i64().must()
    t @ t + b.f0[21].to_i64().must()
    t @ t + b.f0[28].to_i64().must()
    t @ t + b.f0[35].to_i64().must()
