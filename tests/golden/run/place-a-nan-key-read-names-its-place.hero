# M-panic-location, panel 230's R1, kind 2: a map read at a key not equal to
# itself, a nan, stops the program at the place where `m[k]` begins. A float key
# is refused where it is written (`float_map_key`); through a type parameter it
# cannot be, and the runtime is what stops it.

function seen<K>(k: K) -> bool
    m: {K: i64} = {}
    return !m[k].is_err()

function main()
    zero = 0.0
    print(seen(k: 1.0))
    print(seen(k: zero / zero))
