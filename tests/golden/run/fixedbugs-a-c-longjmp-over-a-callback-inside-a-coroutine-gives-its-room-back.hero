# Fixed 2026-11-25, the defect lane panel258-r1 found beside defect 2752,
# lane-coroutine-room: inside a `makecontext` coroutine, C's `longjmp` jumps
# 5,000 times over a callback holding a 256 KB record, while another
# coroutine holds one of its own suspended below. A correct program.
# Symptom: the program aborted with `panic: stack exhausted in e5: the room
# large values take off the stack is full, 1 GiB for the whole program`, 3
# runs of 3: panel 258's R1 judged no take of a coroutine's stack gone.
# Cause: the room was one stack per thread, and R1 asked a frame's depth only
# on the thread's own stack.
# Fix: a coroutine's takes stand aside tagged with their stack's range
# (`runtime/parts/stack_lane.c`), and a take or a thunk's entry on that stack
# gives back the takes of its frames below its own, R1's rule among one
# stack's takes (`runtime/parts/frame_aside.c`).
extern "fixedbugs-coroutines-switched-by-hand.h"
    function cr_start(k: i64, f: (function(i64) -> i64))
    function cr_yield()
    function cr_resume(k: i64) -> i64

extern "fixedbugs-2704-longjmp.h"
    function ab_try(cb: (function(i64) -> i64)) -> i64
    function ab_throw()

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function thrown(n: i64) -> i64
    v = e5(n)
    ab_throw()
    return v.a.a.a.a.a.x

function holder(k: i64) -> i64
    v = e5(k + 10)
    cr_yield()
    return v.a.a.a.a.a.x

function jumper(k: i64) -> i64
    sum: i64 @= 0

    for _ in range(from: 0, to: 5000)
        sum @ sum + ab_try(cb: thrown)

    w = e5(k + 20)
    cr_yield()
    return sum + w.b.b.b.b.b.x

function main()
    cr_start(k: 0, f: holder)
    cr_start(k: 1, f: jumper)
    a = cr_resume(k: 0)
    b = cr_resume(k: 1)
    print("jumped inside a coroutine: ", a, " ", b)

# Corrected 2026-11-25, lane land259 (panel 259's R1 and R2, provisional,
# author ratification pending): the fix above is gone. No take is judged
# given back by its frame's address any more, since an order of addresses a
# switch of stacks C makes can falsify handed live values to other frames
# (panel 259's cells); what the frames C left held stays held until the
# program ends, counted against the room's 1 GiB, the end spec section 13
# promises such a program. So this loop now ends at that bound's abort,
# which says how many callbacks C called have not returned, and the case's
# `.expected` was changed by hand that day to pin it.
