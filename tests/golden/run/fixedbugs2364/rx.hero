# fixedbugs, defect 2364: a `partial` record whose header adds a hidden field
# between its two where a macro another header defines is read before it.
extern "fixedbugs-2364-rx.h"
    record Rx partial
        a: i32
        b: i32
    function rx_make(v: i32) -> Rx
    function rx_sum(@r: Rx) -> i32

function make(v: i32) -> Rx
    return rx_make(v: v)

function sum(r: Rx) -> i32
    c @= r
    return rx_sum(@c)
