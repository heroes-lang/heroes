# Fixed 2026-11-19, defect 2587, lane-251: the shape beside the defect's own,
# a `.must()` on an error on `main` while a worker sits blocked printing into
# a pipe nobody reads.
# Symptom: as the index's: the report waited on stdout's lock and was never
# said.
# Cause: the `.must()` report flushed stdout unconditionally. It flushes only
# where the lock can be had.
extern "fixedbugs-2552-stdout-into-a-pipe-nobody-reads.h"
    function unread_stdout() -> i64

extern "unistd.h"
    function usleep(useconds: u32) -> i32

extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64

function talk(n: i64) -> i64
    i @= 0

    while i < 1_000_000_000
        print("worker ", i)
        i @ i + 1

    return n

function refused(n: i64) -> i64?
    if n >= 0
        return fail(code: "refused", msg: "no number is wanted here")
    return ok(n)

function main()
    if unread_stdout() == 1
        t = hero_thread_spawn(body: talk, arg: 7)
        _ = usleep(useconds: 200000)
        print(refused(t).must())
        _ = hero_thread_join(handle: t)
