# fixedbugs, defect 2333, lane pm-cbound, 2026-11-08: the header a group names
# defines `__builtin_sub_overflow` to report nothing. The guard left the names
# C reserves for the implementation to the headers, on purpose, so before the
# repair the difference past the bottom printed `9223372036854775807` at exit 0 where the program aborts; the reserved pair now saves
# and gives back every such name the compiler's own C writes, around the
# groups (`emit/guarded_names.hero`, `runtime/heroes_reserved_open.h`).

extern "fixedbugs-2333-overflow.h"
    constant HERO_2333_ONE: i64

function main()
    small: i64 = -9223372036854775807 - 1
    print(HERO_2333_ONE)
    print(small - HERO_2333_ONE)
