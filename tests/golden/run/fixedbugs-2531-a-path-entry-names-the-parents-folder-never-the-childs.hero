# Defect 2531, 2026-11-14: the program a child runs is found by a search
# THIS process makes before the fork, never by one the child makes after
# it. POSIX promises the child of a process that may hold other threads
# only its async-signal-safe calls until `exec`, and `execvp`, which made
# the search, is not one; the runtime now writes the paths the search tries
# before the fork and the child tries each by `execve`, which is. So every
# entry of the `PATH` it reads names what it names in the PARENT's folder
# (panel 248's R3), and here the child's folder holds the same program
# under the same names, so a search read in the child's folder would start
# one of those instead. The program is its own child. With no argument it
# makes a folder of its own under `build/`, holding the program as
# `door-2531-tool` and `bin/door-2531-tool`, the same two names under
# `the-childs-folder/`, a file of that name that is no program under
# `locked/` and a folder of that name under `dirs/`. Then it starts a middle
# run in that folder whose `PATH` opens with:
#
# - `bin`, a relative entry;
# - an empty entry, and in a second run `.`;
# - an empty entry LAST, after the parent's own;
# - `locked`, `dirs` and `bin`: a file this user may not run and a folder,
#   each passed over as `execvp` passed them;
#
# and the middle starts `door-2531-tool` by its bare name in
# `the-childs-folder`, whose run says whether it was started from there:
# never. Once more with an empty entry and no folder staged, the child then
# in the middle's own folder; and a name nobody has, not found, the control.
#
# The same transcript on every system: `CreateProcessW` searches the
# parent's own folder before any entry of `PATH` and never the child's
# (panel 248's seats, measured on the box), and it looks for a name with
# `.exe`, so `locked/` and `dirs/` hold nothing it looks at there.
extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_env(name: str, value: str)
    function hero_run_dir(folder: str)
    function hero_run_limit(seconds: i64)
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_run_why() -> i64
    function hero_run_exe_suffix() -> str
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_fs_link(existing: cstr lent, name: cstr lent) -> i64
    function hero_dir_remove_tree(path: cstr lent) -> i64
    function hero_os_pid() -> i64
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64

constant TOOL: str
    "door-2531-tool"

# The folder each child is started in, which holds the decoys.
constant CHILDS: str
    "the-childs-folder"

function itself() -> str
    status: i64 @= 0
    marks: i64 @= 0
    return hero_exe_path_shown(status: @status, marks: @marks)

function separator() -> str
    if hero_run_exe_suffix() == ".exe"
        return ";"
    return ":"

# Whether `path` ends with `tail`, read on its last bytes alone: every name
# a tail holds is ASCII, and so is the folder name before it.
function ends_with(path: str, tail: str) -> bool
    if path.len() < tail.len()
        return false
    return path.slice(from: path.len() - tail.len(), to: path.len()) == tail

# Whether this run's own program is one of the two names under the child's
# folder, on either separator.
function from_the_childs_folder() -> bool
    exe = itself()
    name = TOOL + hero_run_exe_suffix()

    for sep in ["/", "\\"]
        if ends_with(path: exe, tail: CHILDS + sep + name) || ends_with(path: exe, tail: CHILDS + sep + "bin" + sep + name)
            return true

    return false

# What a status is called, so the transcript reads the same on every system.
function said(status: i64) -> str
    if status == HERO_OS_OK
        return "started"

    if status == HERO_OS_NOT_FOUND
        return "not found"
    return "status " + status.to_str()

# The middle run: `name` started by its bare name, in `folder` ("-" for this
# process's own), through the `PATH` this process was given.
function middle(what: str, folder: str, name: str)
    hero_run_arg(word: name)
    hero_run_arg(word: "who")
    hero_run_limit(seconds: 60)

    if folder != "-"
        hero_run_dir(folder: folder)
    status: i64 @= 0
    code = hero_run_go(program: name.cstr(), in_path: "".cstr(), out_path: "".cstr(), err_path: "".cstr(), @status)
    hero_run_reset()

    if status == HERO_OS_OK
        print(what + ": " + said(status) + ", exit ", code)
    else
        print(what + ": " + said(status) + ", exit ", code, ", a reason given ", hero_run_why() != 0)

# A middle run started by `program` in `root`, `path` its `PATH`.
function through(program: str, root: str, what: str, path: str, folder: str, name: str)
    hero_run_arg(word: program)
    hero_run_arg(word: "middle")
    hero_run_arg(word: what)
    hero_run_arg(word: folder)
    hero_run_arg(word: name)
    hero_run_limit(seconds: 60)
    hero_run_env(name: "PATH", value: path)
    hero_run_dir(folder: root)
    status: i64 @= 0
    code = hero_run_go(program: program.cstr(), in_path: "".cstr(), out_path: "".cstr(), err_path: "".cstr(), @status)
    hero_run_reset()

    if status != HERO_OS_OK || code != 0
        print("the middle of `" + what + "`: " + said(status) + ", exit ", code)

function main()
    if args().len() > 0 && args()[0] == "who"
        print("  started from the child's folder: ", from_the_childs_folder())
        return

    if args().len() > 3 && args()[0] == "middle"
        middle(what: args()[1], folder: args()[2], name: args()[3])
        return
    root = "build/heroes-golden-2531-" + hero_os_pid().to_str()
    childs = root + "/" + CHILDS
    name = TOOL + hero_run_exe_suffix()
    program = itself()
    made: bool @= true

    for folder in [root + "/bin", childs + "/bin", root + "/locked", root + "/dirs/" + TOOL]
        made @ made && hero_fs_mkdir_all(path: folder.cstr()) == HERO_OS_OK

    for place in [root + "/" + name, root + "/bin/" + name, childs + "/" + name, childs + "/bin/" + name]
        made @ made && hero_fs_link(existing: program.cstr(), name: place.cstr()) == HERO_OS_OK

    made @ made && !write_file(path: root + "/locked/" + TOOL, text: "no program\n").is_err()
    print("four more names of the program made, two in the child's folder: ", made)
    sep = separator()
    path_status: i64 @= 0
    marks: i64 @= 0
    own = hero_env_shown(name: "PATH".cstr(), status: @path_status, marks: @marks)
    through(
        program: program,
        root: root,
        what: "a bare name through a relative entry, in the folder",
        path: "bin" + sep + own,
        folder: CHILDS,
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a bare name through an empty entry, in the folder",
        path: sep + own,
        folder: CHILDS,
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a bare name through `.`, in the folder",
        path: "." + sep + own,
        folder: CHILDS,
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a bare name through an empty entry last, in the folder",
        path: own + sep,
        folder: CHILDS,
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a bare name past a file that is no program and a folder, in the folder",
        path: "locked" + sep + "dirs" + sep + "bin" + sep + own,
        folder: CHILDS,
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a bare name through an empty entry, no folder staged",
        path: sep + own,
        folder: "-",
        name: TOOL
    )
    through(
        program: program,
        root: root,
        what: "a name nobody has, in the folder",
        path: "bin" + sep + own,
        folder: CHILDS,
        name: "heroes-no-such-program-2531"
    )
    _ = hero_dir_remove_tree(path: root.cstr())
