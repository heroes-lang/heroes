# Defect 2490 (panel 248's R3, provisional, author ratification pending): a
# child's working folder is given at the spawn, `hero_run_dir` in
# `runtime/hero_os.h`, and the program that stages it never changes its own;
# every relative path of the launch is read in the PARENT's folder, as
# `CreateProcessW` reads it, and a folder that cannot be entered has its own
# answer. The program is its own child, under three names. With no argument
# it makes a folder of its own under `build/`, `inner/` holding a marker,
# then:
#
# - starts itself with `where` in `inner/`, named relative to its own
#   folder, its output a path relative to its own folder too: the child sees
#   the marker by its bare name, and its words land where the parent names
#   them, not under `inner/`;
# - starts a second name of itself, `tool/`'s, by a RELATIVE program path
#   holding a folder, in `inner/`: found in the parent's folder (in the
#   child's it would be `inner/build/...`, which is nothing);
# - starts a middle run whose `PATH` opens with a RELATIVE folder, `bin/`,
#   holding a third name; the middle starts that name bare in `inner/`, found
#   through the entry read in the middle's folder, where `inner/` has no
#   `bin/`;
# - stages a folder that does not exist and one that is a file: each is
#   refused before any program runs, HERO_OS_NO_FOLDER and a reason, never a
#   missing program's HERO_OS_NOT_FOUND, and the output file the launch names
#   is left as it was, so no stream was opened for it;
# - starts a program that does not exist in a folder that does: told
#   HERO_OS_NOT_FOUND, the control that the two answers are apart;
# - stages the missing folder and then `inner/`: the later is the child's;
# - and after `hero_run_reset`, a launch with nothing staged: the child is
#   back in the parent's folder, where no marker is.
#
# Written 2026-11-14 for lane b36-dir; the Windows arm is run on the box.
extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_env(name: str, value: str)
    function hero_run_dir(folder: str)
    function hero_run_limit(seconds: i64)
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_run_why() -> i64
    function hero_run_exe_suffix() -> str
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_exists(path: cstr lent) -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_fs_link(existing: cstr lent, name: cstr lent) -> i64
    function hero_dir_remove_tree(path: cstr lent) -> i64
    function hero_os_pid() -> i64
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64
    constant HERO_OS_NO_FOLDER: i64

constant MARKER: str
    "door-2490-marker.txt"

# The third name, found only through the middle's relative `PATH` entry.
constant TOOL: str
    "door-2490-tool"

function itself() -> str
    status: i64 @= 0
    marks: i64 @= 0
    return hero_exe_path_shown(status: @status, marks: @marks)

function windows() -> bool
    return hero_run_exe_suffix() == ".exe"

# What a status is called, so the transcript reads the same on every system.
function said(status: i64) -> str
    if status == HERO_OS_OK
        return "started"

    if status == HERO_OS_NO_FOLDER
        return "no folder"

    if status == HERO_OS_NOT_FOUND
        return "not found"
    return "status " + status.to_str()

# `program` started with `role`, in `folder` ("" for this process's own),
# its standard output written to `out` ("" for this process's own), given
# `given_path` as its `PATH` where that is not empty; the launch given back
# after it.
function launched(program: str, role: str, folder: str, out: str, given_path: str, @status: i64) -> i64
    hero_run_arg(word: program)
    hero_run_arg(word: role)
    hero_run_limit(seconds: 60)

    if given_path.len() > 0
        hero_run_env(name: "PATH", value: given_path)

    if folder.len() > 0
        hero_run_dir(folder: folder)
    code = hero_run_go(program: program.cstr(), in_path: "".cstr(), out_path: out.cstr(), err_path: "".cstr(), @status)
    hero_run_reset()
    return code

# One launch, told: its answer, its exit, and whether a reason was given.
function told(what: str, status: i64, code: i64)
    if status == HERO_OS_OK
        print(what + ": " + said(status) + ", exit ", code)
    else
        print(what + ": " + said(status) + ", exit ", code, ", a reason given ", hero_run_why() != 0)

# The middle run: its own `PATH` opens with a relative folder, and it starts
# the third name bare in `inner`.
function middle(inner: str)
    status: i64 @= 0
    code = launched(program: TOOL, role: "where", folder: inner, out: "", given_path: "", @status)
    told(what: "a bare name through a relative PATH entry, in the folder", status: status, code: code)

function main()
    if args().len() > 0 && args()[0] == "where"
        print("  the child sees the marker by its bare name: ", hero_fs_exists(path: MARKER.cstr()) == 1)
        return

    if args().len() > 1 && args()[0] == "middle"
        middle(args()[1])
        return
    root = "build/heroes-golden-2490-" + hero_os_pid().to_str()
    inner = root + "/inner"
    suffix = hero_run_exe_suffix()
    _ = hero_fs_mkdir_all(path: inner.cstr())
    _ = hero_fs_mkdir_all(path: (root + "/tool").cstr())
    _ = hero_fs_mkdir_all(path: (root + "/bin").cstr())
    _ = write_file(path: inner + "/" + MARKER, text: "here").is_err()
    _ = write_file(path: root + "/a-file", text: "not a folder").is_err()
    program = itself()
    second = root + "/tool/door-2490" + suffix
    linked = hero_fs_link(existing: program.cstr(), name: second.cstr()) == HERO_OS_OK
    linked2 = hero_fs_link(existing: program.cstr(), name: (root + "/bin/" + TOOL + suffix).cstr()) == HERO_OS_OK
    print("two more names of the program made: ", linked && linked2)
    print("the parent sees the marker by its bare name: ", hero_fs_exists(path: MARKER.cstr()) == 1)
    status: i64 @= 0

    # In `inner`, named relative to this folder, its output relative too.
    code = launched(program: program, role: "where", folder: inner, out: root + "/out.txt", given_path: "", @status)
    told(what: "in the folder", status: status, code: code)
    print("its words, read where the parent names them: ", read_file(root + "/out.txt").default("(none)"))
    print(
        "nothing written under the folder instead: ",
        hero_fs_exists(path: (inner + "/" + root + "/out.txt").cstr()) != 1
    )

    # A relative program path holding a folder, read in this folder.
    code2 = launched(program: second, role: "where", folder: inner, out: "", given_path: "", @status)
    told(what: "a relative program path, in the folder", status: status, code: code2)

    # A middle run whose `PATH` opens with the relative `bin`.
    separator: str @= ":"

    if windows()
        separator @ ";"
    path_status: i64 @= 0
    marks: i64 @= 0
    own_path = hero_env_shown(name: "PATH".cstr(), status: @path_status, marks: @marks)
    hero_run_arg(word: program)
    hero_run_arg(word: "middle")
    hero_run_arg(word: inner)
    hero_run_limit(seconds: 60)
    hero_run_env(name: "PATH", value: root + "/bin" + separator + own_path)
    code3 = hero_run_go(program: program.cstr(), in_path: "".cstr(), out_path: "".cstr(), err_path: "".cstr(), @status)
    hero_run_reset()
    told(what: "the middle", status: status, code: code3)

    # A folder that does not exist, and one that is a file: the output file
    # the launch names stays as it was.
    kept = root + "/kept.txt"
    _ = write_file(path: kept, text: "kept").is_err()
    code4 = launched(program: program, role: "where", folder: root + "/nowhere", out: kept, given_path: "", @status)
    told(what: "a folder that does not exist", status: status, code: code4)
    code5 = launched(program: program, role: "where", folder: root + "/a-file", out: kept, given_path: "", @status)
    told(what: "a folder that is a file", status: status, code: code5)
    print("the output file it named, as it was: ", read_file(kept).default("(none)") == "kept")

    # A program that does not exist, in a folder that does.
    code6 = launched(
        program: root + "/no-such-program" + suffix,
        role: "where",
        folder: inner,
        out: "",
        given_path: "",
        @status
    )
    told(what: "a program that does not exist, in the folder", status: status, code: code6)

    # Staged twice: the later folder is the child's.
    hero_run_dir(folder: root + "/nowhere")
    code7 = launched(program: program, role: "where", folder: inner, out: "", given_path: "", @status)
    told(what: "a folder staged twice, the later in the folder", status: status, code: code7)

    # Nothing staged after the reset.
    code8 = launched(program: program, role: "where", folder: "", out: "", given_path: "", @status)
    told(what: "nothing staged after the reset", status: status, code: code8)
    print("the parent's folder holds no tree of the child's: ", hero_fs_exists(path: (inner + "/" + root).cstr()) != 1)
    _ = hero_dir_remove_tree(path: root.cstr())
