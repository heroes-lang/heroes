# Fixed 2026-10-11, defect 622, lane b21-misc.
# Symptom: a record chain a thousand deep took about a minute and 2.7 GB of
# clang to build under `--sanitize` at `-O2` (defect 539's case on the CI's
# clang 18): UBSan checks each member access through a pointer, and the
# chain's per-type functions, inlined into each other, held a check per
# level below them. Past `typeorder`'s depth those functions now leave out
# the null, alignment and object-size checks when optimising under UBSan
# (`emit/tu_local.hero`), ASan still checking each load and store.
# This case: a chain 40 deep, past the depth, its `_retain` and `_release`
# reached by copies and drops, its `_eq` by `==` and its `_hash` by a map
# key, in every configuration of the `run` form, the sanitised two among
# them, each of which must print the same and say nothing on stderr.

record R0
    s: str
    n: i64

record R1
    inner: R0

record R2
    inner: R1

record R3
    inner: R2

record R4
    inner: R3

record R5
    inner: R4

record R6
    inner: R5

record R7
    inner: R6

record R8
    inner: R7

record R9
    inner: R8

record R10
    inner: R9

record R11
    inner: R10

record R12
    inner: R11

record R13
    inner: R12

record R14
    inner: R13

record R15
    inner: R14

record R16
    inner: R15

record R17
    inner: R16

record R18
    inner: R17

record R19
    inner: R18

record R20
    inner: R19

record R21
    inner: R20

record R22
    inner: R21

record R23
    inner: R22

record R24
    inner: R23

record R25
    inner: R24

record R26
    inner: R25

record R27
    inner: R26

record R28
    inner: R27

record R29
    inner: R28

record R30
    inner: R29

record R31
    inner: R30

record R32
    inner: R31

record R33
    inner: R32

record R34
    inner: R33

record R35
    inner: R34

record R36
    inner: R35

record R37
    inner: R36

record R38
    inner: R37

record R39
    inner: R38

record R40
    inner: R39

function chain(s: str, n: i64) -> R40
    v0 = R0(s: s, n: n)
    v1 = R1(inner: v0)
    v2 = R2(inner: v1)
    v3 = R3(inner: v2)
    v4 = R4(inner: v3)
    v5 = R5(inner: v4)
    v6 = R6(inner: v5)
    v7 = R7(inner: v6)
    v8 = R8(inner: v7)
    v9 = R9(inner: v8)
    v10 = R10(inner: v9)
    v11 = R11(inner: v10)
    v12 = R12(inner: v11)
    v13 = R13(inner: v12)
    v14 = R14(inner: v13)
    v15 = R15(inner: v14)
    v16 = R16(inner: v15)
    v17 = R17(inner: v16)
    v18 = R18(inner: v17)
    v19 = R19(inner: v18)
    v20 = R20(inner: v19)
    v21 = R21(inner: v20)
    v22 = R22(inner: v21)
    v23 = R23(inner: v22)
    v24 = R24(inner: v23)
    v25 = R25(inner: v24)
    v26 = R26(inner: v25)
    v27 = R27(inner: v26)
    v28 = R28(inner: v27)
    v29 = R29(inner: v28)
    v30 = R30(inner: v29)
    v31 = R31(inner: v30)
    v32 = R32(inner: v31)
    v33 = R33(inner: v32)
    v34 = R34(inner: v33)
    v35 = R35(inner: v34)
    v36 = R36(inner: v35)
    v37 = R37(inner: v36)
    v38 = R38(inner: v37)
    v39 = R39(inner: v38)
    v40 = R40(inner: v39)
    return v40

function main()
    a = chain("x", 1)
    b: R40 @= chain("x", 1)
    c = chain("y", 2)
    print(a == b, a == c)
    seen: {R40: i64} @= {}
    seen[a] @ 10
    seen[c] @ 20
    print(seen[b].default(0), seen[c].default(0), keys(seen).len())
    copies: [R40] @= []
    k @= 0

    while k < 100
        copies @ copies.push(b)
        k @ k + 1

    b @ c
    print(
        copies.len(),
        copies[99].inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.s,
        b.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.n,
        copies[0] == a
    )
