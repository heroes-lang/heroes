# After a transfer the wrapper ends the life, and the program's own release
# of the handed-over value is a stray: the message names this as the third
# thing that produces one, found missing from the list by the landing review
# (2026-09-24, CL-057: the list is a measurement). The checker has no flow
# analysis, so the release reaches the runtime, which stops it before C.
extern "fixedbugs-a-release-after-a-transfer-is-a-stray.h"
    record Ob tag ob
    record Wr tag wr
    function ob_new() -> Ob acquires ob_put
    function ob_put(o: Ob consumes)
    function wr_new(o: Ob transfers ob_put) -> Wr acquires wr_free
    function wr_free(w: Wr consumes)

function main()
    a = ob_new()
    w = wr_new(o: a)
    print("handed over")
    ob_put(o: a)
    wr_free(w: w)
    print("not reached")
