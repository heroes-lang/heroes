# fixedbugs, defect 2420, lane b29-boundary, 2026-11-10.
#
# A header in a folder of its own, `sys/clock.h`, includes its sibling as
# `#include "timeb.h"`, a name every platform's C library holds as
# `sys/timeb.h`. C reads a quoted name from the including header's own folder
# first, so the file is `sys/clock.h`'s own (design.md §4.19's sentence on a
# header's sibling). It was refused `shadowed_header` as standing in for the
# library's `<sys/timeb.h>`, since the spelling was asked to be the name the
# folder gives the file, `sys/timeb.h`: Homebrew's keg-only libcurl 8.23.0,
# whose `curl/curl.h` includes `"curlver.h"` and nine more siblings so, could
# not be bound. It builds and reads its own `TIMEB_OWN`, 21.

extern "sys/clock.h"
    constant CLOCK_TICKS: i64

function main()
    print(CLOCK_TICKS)
