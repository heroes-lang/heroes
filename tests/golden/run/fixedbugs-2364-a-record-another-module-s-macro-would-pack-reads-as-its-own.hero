# fixedbugs, defect 2364, lane p239-land-a, 2026-11-09 (panel 239's R4; the
# briefs' `pack`).
#
# `fixedbugs-2364-packed.h` defines the macro under which
# `fixedbugs-2364-rp.h` packs `Rp`; module `rp` reads `rp.h` alone, padded.
# Before the repair this unit read `packed.h` first, so `Rp.b` stood at byte
# 1 here and at byte 4 in `rp`'s unit, and the program built at exit 0 and
# printed `-402653184` for 1000. A field's type cannot see it; the record's
# layout, asked of clang in both units, does.
use fixedbugs2364/defines_packed
use fixedbugs2364/rp

function main()
    p = defines_packed.make(v: 4)
    r = rp.make(v: 1000)
    print(p.w)
    print(r.c)
    print(r.b)
