# Defect 2490 (panel 248's R3): a working folder staged for a child that
# holds a NUL byte is refused, since C reads the folder to that byte and the
# child would start in another folder (`sub\0x` in `sub`). The NUL comes from
# a file, as feature 2424's NUL cases make one, since no literal writes it.
extern "stdio.h"
    function fopen(path: cstr lent, mode: cstr lent) -> ptr
    function fputc(c: i32, stream: ptr) -> i32
    function fclose(stream: ptr) -> i32

extern "hero_os.h"
    function hero_run_dir(folder: str)

constant HELD: str
    "build/heroes-golden-2490-folder-nul.bin"

function held() -> str
    handle = fopen(path: HELD.cstr(), mode: "wb".cstr())
    assert handle != nullptr
    _ = fputc(c: 0, stream: handle)
    _ = fclose(stream: handle)
    return read_file(HELD).must()

function main()
    nul = held()
    print("before")
    hero_run_dir(folder: "build" + nul + "x")
    print("unreachable")
