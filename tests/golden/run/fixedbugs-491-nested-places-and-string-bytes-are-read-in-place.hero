# FIXED DEFECT 491, 2026-10-08 (lane b15-emit): a string's byte and the
# element a nested place descends through are read in place, as defect 389's
# reads are, and nothing a program can see moves. Every spelling in one
# program: a scan that reads a byte per step; a place one array step deep and
# two and three deep (the first descent reads in place, a deeper one over a
# place that holds a call keeps the runtime's, `emit/array_read.hero`); an
# element handed to a function through `@`, at one step and at three; and
# copy-on-write intact, a binding made before the writes keeps what it held.
#
# The values are what the program's own arithmetic says. The bytes of
# "heroes" are 104 101 114 111 101 115, which sum to 646; the writes land at
# rows[1].cells[2], grid[1][0][1], xs[1], rows[0].cells[0] and grid[0][1][0],
# and every cell beside them keeps its first value.

record Row
    cells: [i64]
    label: str

function bump(@x: i64, by: i64)
    x @ x + by

function main()
    text = "heroes"
    rows: [Row] @ [Row(cells: [1, 2, 3], label: "a"), Row(cells: [4, 5, 6], label: "b")]
    grid: [[[i64]]] @ [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    xs: [i64] @ [10, 20, 30]
    before = grid
    i: i64 @ 0
    sum: i64 @ 0

    while i < text.len()
        sum @ sum + to_i64(text[i]).must()
        i @ i + 1

    rows[1].cells[2] @ 60
    grid[1][0][1] @ 99
    bump(x: @xs[1], by: 5)
    bump(x: @rows[0].cells[0], by: 100)
    bump(x: @grid[0][1][0], by: 1000)
    print(sum)
    print(rows[1].cells[2])
    print(grid[1][0][1])
    print(xs[1])
    print(rows[0].cells[0])
    print(grid[0][1][0])
    print(rows[1].cells[1])
    print(grid[1][0][0])
    print(before[1][0][1])
    print(before[0][1][0])
