# Defect 425, 2026-10-07. Symptom: `timeout 3 heroes run forever.hero` exited
# 124 and the program ran on with parent 1, as every program did under a
# `heroes` the harness's watchdog ended; on 2026-10-06 one of them wrote 146 GB
# in 44 minutes and filled the disk. Cause: `hero_run_go` gives every child a
# process group of its own, so a signal ending its caller reached no child, and
# the watchdog killed with SIGKILL, which no caller can pass on. Now the
# watchdog asks with SIGTERM first and kills after a grace, and a caller ended
# by SIGTERM, SIGINT, SIGHUP or SIGQUIT passes the signal to every child it
# waits on, kills what stands after its own shorter grace, and dies of the
# signal (`runtime/parts/run.c`); on Windows the job object a child is put in
# dies with the job that holds its caller.
#
# The program is its own three generations, through the runtime's door every
# `heroes` verb and the harness itself go through: the first runs the second
# under a two-second watchdog, the second runs the third with none, and the
# third beats until it is ended, each beat a new empty file in a directory of
# its own. The first counts the beats, waits a second, and counts again: the
# same count, nothing outlived the one that ran it. A beat is a file written
# once, never a file rewritten, so neither a read beside a write nor a kill in
# the middle of one can make a living program look ended. `build/` for the
# directory, `edges-file-args-exit.hero`'s reason.

extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_limit(seconds: i64)
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_os_pid() -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    function hero_dir_release()
    function hero_dir_remove_tree(path: cstr lent) -> i64
    constant HERO_DIR_FILES: i64

# This program's own path, the one it runs again.
function itself() -> str
    status: i64 @ 0
    marks: i64 @ 0
    return hero_exe_path_shown(status: @status, marks: @marks)

# This program run again with `words`, under a watchdog of `seconds`, 0 for
# none: the code it answered.
function again(words: [str], seconds: i64) -> i64
    program = itself()
    hero_run_reset()
    hero_run_arg(word: program)

    for word in words
        hero_run_arg(word: word)

    hero_run_limit(seconds: seconds)
    status: i64 @ 0
    code = hero_run_go(program: program.cstr(), in_path: "".cstr(), out_path: "".cstr(), err_path: "".cstr(), @status)
    hero_run_reset()
    return code

# The third generation: a beat in `dir` every 2^24 turns until something ends
# it, each a file of its own.
function beat(dir: str)
    n: i64 @ 0
    k: i64 @ 0

    while true
        n @ n + 1

        if n % 16777216 == 0
            k @ k + 1

            # A beat that cannot be written is the next one's to make.
            if write_file(path: dir + "/" + k.to_str(), text: "").is_err()
                k @ k - 1

# A loop the watchdog ends, which is how the first generation waits.
function spin() -> i64
    n: i64 @ 0

    while true
        n @ n + 1

        if n == 1000000000
            n @ 0

    return n

# How many beats `dir` holds.
function beats(dir: str) -> i64
    count = hero_dir_scan(root: dir.cstr(), want: HERO_DIR_FILES, recursive: 0)
    hero_dir_release()
    return count

function first()
    dir = "build/heroes-golden-425-" + hero_os_pid().to_str()
    _ = hero_fs_mkdir_all(path: dir.cstr())
    print("the watchdog ended the second generation: ", again(["second", dir], seconds: 2))
    before = beats(dir)

    if before < 1
        print("the third generation never beat")
    else
        _ = again(["nap"], seconds: 1)

        if beats(dir) == before
            print("the third generation ended with it")
        else
            print("the third generation outlived the one that ran it")
    _ = hero_dir_remove_tree(path: dir.cstr())

function main()
    words = args()

    if words.len() == 0
        first()
    else if words[0] == "second"
        print("the second generation's child answered ", again(["third", words[1]], seconds: 0))
    else if words[0] == "third"
        beat(words[1])
    else
        print(spin())
