# Fixed 2026-11-27, defect 2870, lane sig-family-2 (panel 262's
# compiler-engineer, `so`): the coroutine is started on a thread the program
# spawned, whose own stack and alternate signal stack are its own, and the
# callback recurses past the coroutine's stack there.
# Symptom: the program died by the fault with nothing said, Bus error, exit
# 138, on this Mac, where the same recursion on the thread's own stack says
# `panic: stack exhausted`. On Linux arm64 it was told already, at both
# levels, 3 runs of 3, by the one claim the guard then made, the thread's own:
# so the coroutine's stack lay within its window, a mebibyte under the spawned
# thread's stack, a layout no program chooses.
# Cause: the stack guard's handler (`runtime/parts/stack.c`) asked a fault of
# the thread's own stack alone, and a coroutine's stack is no stack it
# measured, so the fault went on to the default.
# Fix: where the thread's own stack does not explain a fault, the stack
# `makecontext` was handed whose lowest address lies nearest above it is asked
# the same two witnesses, and the walk that names the function is bounded by
# that stack.
extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64

extern "fixedbugs-2870-a-coroutines-guarded-stack.h"
    function gs_run(cb: (function(i64) -> i64), n: i64) -> i64

function deep(n: i64) -> i64
    if n == 0
        return 1
    r = deep(n - 1)
    return r * 3 % 1000003 + n % 7

function worker(n: i64) -> i64
    return gs_run(cb: deep, n: n)

function main()
    t = hero_thread_spawn(body: worker, arg: 10000000)
    print(hero_thread_join(handle: t))
