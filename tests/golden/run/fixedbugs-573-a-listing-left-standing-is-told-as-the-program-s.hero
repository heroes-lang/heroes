# Fixed defect 573, 2026-10-10: the shape beside the launch list, a
# directory listing `hero_dir_scan` keeps until `hero_dir_release()`, left
# standing. The exit check told it *a runtime call kept what it borrowed —
# this is a runtime bug*, of a program that had only not released it; it is
# told as the program's now (`runtime/parts/alloc.c`, `runtime/parts/dir.c`).
# This case: a directory of its own under `build/` holding one file, scanned,
# then the file and the directory removed, the listing still held.

extern "hero_os.h"
    function hero_os_pid() -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_fs_remove(path: cstr lent) -> i64
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    constant HERO_DIR_FILES: i64

function main()
    dir = "build/heroes-golden-573-" + hero_os_pid().to_str()
    _ = hero_fs_mkdir_all(path: dir.cstr())

    if write_file(path: dir + "/one", text: "").is_err()
        print("the file could not be written")
    print(hero_dir_scan(root: dir.cstr(), want: HERO_DIR_FILES, recursive: 0))
    _ = hero_fs_remove(path: (dir + "/one").cstr())
    _ = hero_fs_remove(path: dir.cstr())
