# Defect 382, 2026-10-06. An empty constant is a static header with no
# elements, `HERO_ARRAY_STATIC_EMPTY`, because C11 has no array of no
# elements (panel 195's R1); under `--sanitize` it is built at every read
# (R2). Each is read, walked, compared and grown through a copy, and stays
# empty.

constant NONE: [i64]
    []

constant NO_WORDS: [str]
    []

constant HOLLOW: [[i64]]
    [[]]

function main()
    walked: i64 @= 0

    for x in NONE
        walked @ walked + x

    print(walked, " ", NONE.len(), " ", NO_WORDS.len(), " ", HOLLOW.len(), " ", HOLLOW[0].len())
    print(NONE == [], " ", NO_WORDS.join(","), "|", HOLLOW[0] == NONE)
    xs: [i64] @= NONE
    xs @ xs.push(4)
    words: [str] @= NO_WORDS
    words @ words.push("mars")
    deep: [[i64]] @= HOLLOW
    deep[0] @ deep[0].push(9)
    print(xs.len(), " ", words[0], " ", deep[0][0], " ", NONE.len(), " ", NO_WORDS.len(), " ", HOLLOW[0].len())
