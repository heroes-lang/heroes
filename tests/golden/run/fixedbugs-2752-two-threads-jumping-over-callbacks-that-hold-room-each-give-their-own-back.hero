# Fixed 2026-11-24, defect 2752, lane-panel258-r1 (panel 258's R1): two
# threads, each jumping 1,500 times over a callback holding 256 KB in its own
# thread's room. A correct program.
# Symptom: the program aborted with `panic: stack exhausted in
# room_threads.e5: the room large values take off the stack is full, 1 GiB
# for the whole program`.
# Cause and fix: as the first case of defect 2752, each thread's room and
# marks its own.
extern "fixedbugs-2752-levels.h"
    function lv_try(cb: (function(i64) -> i64), n: i64) -> i64
    function lv_throw(up: i64)

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function body(n: i64) -> i64
    v = e5(n)
    lv_throw(up: 0)
    return v.a.a.a.a.a.x

function worker(n: i64) -> i64
    total: i64 @= 0

    for i in range(from: 0, to: 1500)
        total @ total + lv_try(cb: body, n: i)

    return total + n

function main()
    a = spawn(worker, 1).must()
    b = spawn(worker, 2).must()
    print("threads ", a.wait(), " ", b.wait())

# Corrected 2026-11-25, lane land259 (panel 259's R1 and R2, provisional,
# author ratification pending): the fix above is gone. No take is judged
# given back by its frame's address any more, since an order of addresses a
# switch of stacks C makes can falsify handed live values to other frames
# (panel 259's cells); what the frames C left held stays held until the
# program ends, counted against the room's 1 GiB, the end spec section 13
# promises such a program. So this loop now ends at that bound's abort,
# which says how many callbacks C called have not returned, and the case's
# `.expected` was changed by hand that day to pin it (the words up to the number: with the other thread still running the number leaves its callbacks out, defect d-lane-land259-2).
#
# Corrected 2026-11-26, lane room-mixedown (defect 2854): the number counts
# both threads now, every thread's count being the program's and read while
# it runs (`runtime/parts/callback.c`), where it left the other thread's
# out: 1021, 916, 1016, 797, 1036 and 1141 in six runs on this Mac before,
# 2047 three times and 2046 five times in eight after. Which of the two
# depends on whether the other thread was inside a callback when the abort
# read its count, which the two threads' order decides and nothing in this
# program fixes, so the case still pins the words up to `while`; the exact
# count is pinned where a mailbox orders the threads
# (`fixedbugs-2854-the-rooms-abort-counts-the-callbacks-a-thread-still-running-has-not-returned`).
