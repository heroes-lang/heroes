# Fixed 2026-11-19, defect 2587, lane-251: the defect's own line,
# `runtime/parts/panic.c`'s `hero_panic`, reached on `main` by a join of a
# handle the program was never given, while a worker sits blocked printing
# into a pipe nobody reads.
# Symptom: as the index's: `hero_panic` flushed stdout before its line, the
# flush waited on the lock the blocked worker holds, and nothing was said.
# Cause: the flush waited. It is taken only where the lock can be had.
extern "fixedbugs-2552-stdout-into-a-pipe-nobody-reads.h"
    function unread_stdout() -> i64

extern "unistd.h"
    function usleep(useconds: u32) -> i32

extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64

function talk(n: i64) -> i64
    i @= 0

    while i < 1_000_000_000
        print("worker ", i)
        i @ i + 1

    return n

function main()
    if unread_stdout() == 1
        t = hero_thread_spawn(body: talk, arg: 7)
        _ = usleep(useconds: 200000)
        _ = hero_thread_join(handle: t + 1000)
