# Panel 258's R2, ratified by the author's reading on 2026-11-27 (decision
# 2758), and the ffi-pragmatist's prediction of that sitting: a callback lends
# C the bytes of a `str` it holds, C keeps the pointer and jumps over the
# callback's frame, and C's catch reads the message after the landing, before
# the call holding the save point returns, as libpng's error function hands
# `png_error`'s message to a binding's catch (`pngmsg_lent`, real libpng
# 1.6.59, in the sitting). 500 refusals.
# What it pins: the unwind COLLECTS the `str` at the jump and RELEASES it when
# `uw_guard` returns, never before. Released at the jump, as a cleanup that
# released in the unwind would, the catch read freed bytes: an empty or wrong
# message in a plain build, a heap use after free under `--sanitize` (the
# sitting's mode 2, measured in C with real libpng). And the exit audit reads
# every block given back after the 500 releases (`runtime/parts/unwind.c`).
extern "unwind-catch.h"
    function uw_guard(cb: (function(i64) -> i64), n: i64) -> i64
    function uw_fail(msg: cstr lent)
    function uw_heard() -> cstr

function refuse(stream: i64) -> i64
    said = f"the program refused stream {stream} at byte 4096"
    uw_fail(said.cstr())
    return said.len()

function main()
    last: str @= ""
    agreed: i64 @= 0

    for stream in range(from: 0, to: 500)
        if uw_guard(cb: refuse, n: stream) == -1
            heard = uw_heard().validated().must()

            if heard == f"the program refused stream {stream} at byte 4096"
                agreed @ agreed + 1
            last @ heard

    print("the binding heard ", agreed, " of 500; the last: ", last)
