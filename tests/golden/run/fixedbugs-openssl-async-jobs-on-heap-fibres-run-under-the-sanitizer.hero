# Fixed 2026-11-27, draft d-lane-sig-family-9, lane sig-family (step 199l).
# OpenSSL ASYNC's jobs on fibres from `malloc`, the library's own choice of
# stack, each holding a large value across its pause: libcrypto, which
# `--sanitize` does not instrument, switches between them by its own
# `_longjmp` on this Mac (by `swapcontext` on Debian x86-64, defect 2853's
# header says).
# Symptom: before, the `run` form's `--sanitize` legs on this Mac wrote
# AddressSanitizer's `WARNING: ASan is ignoring requested
# __asan_handle_no_return: stack type: default` on stderr; right plain.
# Cause: the runtime's rewrite of libcrypto's `_longjmp` reached the C
# library's through ASan's interceptor, which asks ASan to clear the shadow of
# the stack it leaves, on a fibre's heap stack ASan was never told of; it
# clears nothing there and says so.
# Fix: the jumps are the C library's own, found behind ASan's interposer, and
# the runtime clears what a jump leaves: from the jumping frame to the top of
# the range `makecontext` was handed, asking ASan only on the thread's own
# stack and the alternate stack, which it knows.
extern "fixedbugs-2853-openssl-async-fibres.h" pkgconfig "libcrypto"
    function aj_go(k: i64, f: (function(i64) -> i64)) -> i64
    function aj_pause()
    function aj_host(body: (function(i64) -> i64), n: i64) -> i64
    function aj_mem() -> i64

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function run(k: i64) -> i64
    v = e5(k + 10)
    aj_pause()
    w = e5(k + 20)
    return v.a.a.a.a.a.x + w.b.b.b.b.b.x

function body(n: i64) -> i64
    mine = e5(n)
    s0 = aj_go(k: 0, f: run)
    s1 = aj_go(k: 1, f: run)
    print("body holds ", mine.a.a.a.a.a.x, " paused ", s0, " ", s1)
    b = aj_go(k: 1, f: run)
    print("body holds ", mine.a.a.a.a.a.x)
    a = aj_go(k: 0, f: run)
    print("body holds ", mine.a.a.a.a.a.x, " jobs ", a, " ", b)
    return mine.h.h.h.h.h.x

function main()
    print("allocator ", aj_mem())
    print("jobs on the heap: ", body(n: 7))
