# fixedbugs, defect 2364, lane p239-land-a, 2026-11-09 (panel 239's R4; the
# critic's `pragma`).
#
# `fixedbugs-2364-leaves-pack.h` leaves `#pragma pack(1)` set past its end,
# and defines no macro: `fixedbugs-2364-rp.h` read after it packs `Rp`. Before
# the repair this unit read `leaves-pack.h` first and the program built at
# exit 0 printing `-402653184` for 1000; no comparison of macros sees a
# pragma left set, and the layout does.
use fixedbugs2364/leaves_pack
use fixedbugs2364/rp

function main()
    p = leaves_pack.make(v: 4)
    r = rp.make(v: 1000)
    print(p.w)
    print(r.c)
    print(r.b)
