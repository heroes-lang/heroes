# fixedbugs, defect 2278, 2026-11-01, panel 233: the filing's second shape, a record of eight-way
# records built in one function, at 2 MiB: 40.65 billion instructions and 1.21 GB at `-O2` before, a few
# billion and under 100 MB since, and it runs at both levels.

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

record E6
    a: E5
    b: E5
    c: E5
    d: E5
    e: E5
    f: E5
    g: E5
    h: E5

function main()
    print("before")
    v0 = E0(x: 1)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    v4 = E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)
    v5 = E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)
    v6 = E6(a: v5, b: v5, c: v5, d: v5, e: v5, f: v5, g: v5, h: v5)
    print(v6.a.a.a.a.a.a.x)
