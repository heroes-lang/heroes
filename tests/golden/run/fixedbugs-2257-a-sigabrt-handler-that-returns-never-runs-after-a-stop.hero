# Fixed 2026-10-29, defect 2257, lane c-boundary: the shape beside
# `fixedbugs-2257-a-c-function-heroes-hands-signal-for-sigabrt-never-runs-after-a-stop`,
# a handler that returns.
# Symptom: the status was the abort's, 134, but the handler's lines were
# printed after the runtime's report, Heroes code running inside the stop.
# Cause: the one of `hero_abort` raising `SIGABRT` with the program's
# disposition; the runtime sets it back to its default first, and the
# handler never runs.
# Rewritten 2026-11-13, defect 2494, lane b35-signals (panel 247's R8): the
# handler was a Heroes function, which since panel 247's R1 is refused at
# the first signal that calls it; it is now a C function of the program's own
# header, handed to `signal` from Heroes, and returns as the Heroes one did.

extern "fixedbugs-2257-a-sigabrt-handler-that-returns-never-runs-after-a-stop.h"
    function return_on_abort(sig: i32)

extern "signal.h"
    constant SIGABRT: i32
    function signal(sig: i32, handler: (function(sig: i32) -> ())) -> ptr

function main()
    _ = signal(sig: SIGABRT, handler: return_on_abort)
    xs = [1, 2]
    print("about to read past the end")
    print(xs[len(args()) + 4])
    print("never reached")
