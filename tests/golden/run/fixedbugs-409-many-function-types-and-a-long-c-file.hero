# Fixed 2026-10-07, defect 409 (class improvement): the type table pushed
# through its own fields, `t.nodes @ t.nodes.push(ty)` and the parameter and
# name runs of a function type the same, so each new type copied every type
# before it; and the C writer pushed each line onto its chunk, and each chunk
# onto the output, through the writer's field. Both grow in place now
# (`check/type_runs.hero`, `table.append_node`, `writer.add_line`). The
# counts are the lane's report; what this case pins is the program they
# compile: 40 functions whose two `i64` parameters make their names part of
# their type, one parameter run shared by all and 40 runs of names, each
# called directly and through a value of its own type, and a C file long
# enough to flush the writer's chunk many times.

function f0(a0: i64, b0: i64) -> i64
    return a0 * 1 + b0

function f1(a1: i64, b1: i64) -> i64
    return a1 * 2 + b1

function f2(a2: i64, b2: i64) -> i64
    return a2 * 3 + b2

function f3(a3: i64, b3: i64) -> i64
    return a3 * 4 + b3

function f4(a4: i64, b4: i64) -> i64
    return a4 * 5 + b4

function f5(a5: i64, b5: i64) -> i64
    return a5 * 6 + b5

function f6(a6: i64, b6: i64) -> i64
    return a6 * 7 + b6

function f7(a7: i64, b7: i64) -> i64
    return a7 * 8 + b7

function f8(a8: i64, b8: i64) -> i64
    return a8 * 9 + b8

function f9(a9: i64, b9: i64) -> i64
    return a9 * 10 + b9

function f10(a10: i64, b10: i64) -> i64
    return a10 * 11 + b10

function f11(a11: i64, b11: i64) -> i64
    return a11 * 12 + b11

function f12(a12: i64, b12: i64) -> i64
    return a12 * 13 + b12

