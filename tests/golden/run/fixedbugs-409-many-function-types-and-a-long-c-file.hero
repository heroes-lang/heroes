    return a13 * 14 + b13

function f14(a14: i64, b14: i64) -> i64
    return a14 * 15 + b14

function f15(a15: i64, b15: i64) -> i64
    return a15 * 16 + b15

function f16(a16: i64, b16: i64) -> i64
    return a16 * 17 + b16

function f17(a17: i64, b17: i64) -> i64
    return a17 * 18 + b17

function f18(a18: i64, b18: i64) -> i64
    return a18 * 19 + b18

function f19(a19: i64, b19: i64) -> i64
    return a19 * 20 + b19

function f20(a20: i64, b20: i64) -> i64
    return a20 * 21 + b20

function f21(a21: i64, b21: i64) -> i64
    return a21 * 22 + b21

function f22(a22: i64, b22: i64) -> i64
    return a22 * 23 + b22

function f23(a23: i64, b23: i64) -> i64
    return a23 * 24 + b23

function f24(a24: i64, b24: i64) -> i64
    return a24 * 25 + b24

function f25(a25: i64, b25: i64) -> i64
    return a25 * 26 + b25

function f26(a26: i64, b26: i64) -> i64
    return a26 * 27 + b26

function f27(a27: i64, b27: i64) -> i64
    return a27 * 28 + b27

function f28(a28: i64, b28: i64) -> i64
    return a28 * 29 + b28

function f29(a29: i64, b29: i64) -> i64
    return a29 * 30 + b29

function f30(a30: i64, b30: i64) -> i64
    return a30 * 31 + b30

function f31(a31: i64, b31: i64) -> i64
    return a31 * 32 + b31

function f32(a32: i64, b32: i64) -> i64
    return a32 * 33 + b32

function f33(a33: i64, b33: i64) -> i64
    return a33 * 34 + b33

function f34(a34: i64, b34: i64) -> i64
    return a34 * 35 + b34

function f35(a35: i64, b35: i64) -> i64
    return a35 * 36 + b35

function f36(a36: i64, b36: i64) -> i64
    return a36 * 37 + b36

function f37(a37: i64, b37: i64) -> i64
    return a37 * 38 + b37

function f38(a38: i64, b38: i64) -> i64
    return a38 * 39 + b38

function f39(a39: i64, b39: i64) -> i64
    return a39 * 40 + b39

function main()
    total: i64 @= 0
    g0 = f0
    total @ total + f0(a0: 0, b0: 1) + g0(a0: 2, b0: 0)
    g1 = f1
    total @ total + f1(a1: 1, b1: 1) + g1(a1: 2, b1: 1)
    g2 = f2
    total @ total + f2(a2: 2, b2: 1) + g2(a2: 2, b2: 2)
    g3 = f3
    total @ total + f3(a3: 3, b3: 1) + g3(a3: 2, b3: 3)
