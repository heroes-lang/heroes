    g12 = f12
    total @ total + f12(a12: 12, b12: 1) + g12(a12: 2, b12: 12)
    g13 = f13
    total @ total + f13(a13: 13, b13: 1) + g13(a13: 2, b13: 13)
    g14 = f14
    total @ total + f14(a14: 14, b14: 1) + g14(a14: 2, b14: 14)
    g15 = f15
    total @ total + f15(a15: 15, b15: 1) + g15(a15: 2, b15: 15)
    g16 = f16
    total @ total + f16(a16: 16, b16: 1) + g16(a16: 2, b16: 16)
    g17 = f17
    total @ total + f17(a17: 17, b17: 1) + g17(a17: 2, b17: 17)
    g18 = f18
    total @ total + f18(a18: 18, b18: 1) + g18(a18: 2, b18: 18)
    g19 = f19
    total @ total + f19(a19: 19, b19: 1) + g19(a19: 2, b19: 19)
    g20 = f20
    total @ total + f20(a20: 20, b20: 1) + g20(a20: 2, b20: 20)
    g21 = f21
    total @ total + f21(a21: 21, b21: 1) + g21(a21: 2, b21: 21)
    g22 = f22
    total @ total + f22(a22: 22, b22: 1) + g22(a22: 2, b22: 22)
    g23 = f23
    total @ total + f23(a23: 23, b23: 1) + g23(a23: 2, b23: 23)
    g24 = f24
    total @ total + f24(a24: 24, b24: 1) + g24(a24: 2, b24: 24)
    g25 = f25
    total @ total + f25(a25: 25, b25: 1) + g25(a25: 2, b25: 25)
    g26 = f26
    total @ total + f26(a26: 26, b26: 1) + g26(a26: 2, b26: 26)
    g27 = f27
    total @ total + f27(a27: 27, b27: 1) + g27(a27: 2, b27: 27)
    g28 = f28
    total @ total + f28(a28: 28, b28: 1) + g28(a28: 2, b28: 28)
    g29 = f29
    total @ total + f29(a29: 29, b29: 1) + g29(a29: 2, b29: 29)
    g30 = f30
    total @ total + f30(a30: 30, b30: 1) + g30(a30: 2, b30: 30)
    g31 = f31
    total @ total + f31(a31: 31, b31: 1) + g31(a31: 2, b31: 31)
    g32 = f32
    total @ total + f32(a32: 32, b32: 1) + g32(a32: 2, b32: 32)
    g33 = f33
    total @ total + f33(a33: 33, b33: 1) + g33(a33: 2, b33: 33)
    g34 = f34
    total @ total + f34(a34: 34, b34: 1) + g34(a34: 2, b34: 34)
    g35 = f35
    total @ total + f35(a35: 35, b35: 1) + g35(a35: 2, b35: 35)
