# Fixed 2026-11-20, defect 2606, lane-platform: the Windows twin of
# `fixedbugs-2606-a-runtime-panic-ends-while-a-thread-is-blocked-writing-
# stderr`, whose `unistd.h` the box lacks: `main` joins a handle the program
# was never given, a runtime panic, while a worker sits blocked writing
# stderr into a pipe nobody reads.
# Symptom: on the Windows box the program never ended, 3 runs of 3 killed at
# 20 s: the report waited on stderr's locks the blocked worker holds, and
# past them on the full pipe.
# Cause: Windows' report kept its stdio path. Each piece is now written past
# the locks on a thread the report waits for at most 50 ms; a pipe that takes
# nothing in that time drops the rest, and the program ends at its status, 127
# on the box. The program makes its own stderr the unread pipe (its header),
# so nothing reaches the harness's stderr.
extern "fixedbugs-2606-windows-stderr-into-a-pipe-nobody-reads.h"
    function unread_stderr() -> i64
    function pause_us(us: i64) -> i64

extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64
    function hero_write_err(text: str)

function talk(n: i64) -> i64
    i @= 0

    while i < 1_000_000_000
        hero_write_err(f"worker {i}\n")
        i @ i + 1

    return n

function main()
    print("main stops now")

    if unread_stderr() == 1
        t = hero_thread_spawn(body: talk, arg: 7)
        _ = pause_us(us: 300000)
        _ = hero_thread_join(handle: t + 1000)
