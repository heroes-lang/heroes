# Defect 2504, 2026-11-13. Symptom: a socket given up for a number and never
# taken back was told at exit by a first sentence saying *every life a mark
# began, `acquires` or `retains`, owes one release*, while the place beneath
# named `hero_net_number`, the platform layer's door, which began that life
# (panel 246's R6). Cause: the sentence was written when a mark began every
# life the handle set holds. Now the report reads who began each life still
# standing, a door's place naming no line of the program, and names those
# and no one else (`runtime/parts/alloc.c`, `parts/panic.c`'s
# `hero_place_is_a_door`). Here a door's life stands alone.
extern "hero_net.h"
    record Socket tag hero_net_socket
    function hero_net_listen(address: cstr lent, port: i64) -> Socket acquires hero_net_close
    function hero_net_connect(address: cstr lent, port: i64) -> Socket acquires hero_net_close
    function hero_net_accept(listener: Socket) -> Socket acquires hero_net_close | hero_net_number
    function hero_net_port(s: Socket) -> i64
    function hero_net_close(s: Socket consumes) -> i64
    function hero_net_number(s: Socket consumes) -> i64
    function hero_net_of(n: i64) -> Socket acquires hero_net_close | hero_net_number

function main()
    listener = hero_net_listen(address: "127.0.0.1".cstr(), port: 0)

    if listener == nullptr
        print("no listener")
        return
    client = hero_net_connect(address: "127.0.0.1".cstr(), port: hero_net_port(listener))

    if client == nullptr
        _ = hero_net_close(listener)
        print("no connection")
        return
    accepted = hero_net_accept(listener)

    if accepted == nullptr
        _ = hero_net_close(client)
        _ = hero_net_close(listener)
        print("no accept")
        return
    number = hero_net_number(accepted)
    print(f"the accepted socket is given up for a number, and nothing takes it back: {number > 0}")
    _ = hero_net_close(client)
    _ = hero_net_close(listener)
    print("main returns")
