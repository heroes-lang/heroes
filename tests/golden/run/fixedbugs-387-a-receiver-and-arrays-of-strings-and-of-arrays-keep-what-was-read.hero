# Defect 387, 2026-10-06: the load borrowed by a read past a branch, as a push's
# receiver and over counted elements. `out @ out.push(half(4).must() +
# bump(@out))` reads its receiver first, so it pushes onto the array as it
# was before `bump` grew it; `count` and `rows` read a `[str]` and a
# `[[i64]]` loaded before the branch. Each array is one nothing else holds,
# and each line prints what was read before the write.

function half(n: i64) -> i64?
    if n % 2 == 0
        return ok(n / 2)
    return fail(code: "odd", msg: "odd")

function bump(@xs: [i64]) -> i64
    xs @ xs.push(100)
    return xs.len()

function more(@ws: [str]) -> i64
    ws @ ws.push("w")
    return ws.len()

function count(ws: [str], n: i64) -> str
    return ws.join("") + to_str(ws.len() * 1000 + n)

function deeper(@g: [[i64]]) -> i64
    g @ g.push([1])
    return g.len()

function rows(g: [[i64]], n: i64) -> i64
    return g.len() * 1000 + g[0][0] * 100 + n

function main()
    out: [i64] @ []
    out @ out.push(5)
    out @ out.push(half(4).must() + bump(@out))
    print(out.len(), " ", out[0], " ", out[1])
    ws: [str] @ []
    ws @ ws.push("a")
    print(count(ws, half(4).must() + more(@ws)))
    g: [[i64]] @ []
    g @ g.push([5])
    print(rows(g, half(4).must() + deeper(@g)))
