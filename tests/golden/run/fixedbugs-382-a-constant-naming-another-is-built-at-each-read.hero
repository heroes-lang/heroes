# Defect 382, 2026-10-06. A constant whose body names another constant reads
# it by a call, so its own body is built at every read, as before panel 195;
# what it names, if that is literals, is a static block, and the built
# array holds that block's address, which no count moves (panel 195's R1).
# Below: an array of a constant twice, a constant that is another, a scalar
# constant inside a literal, a case whose payload is a constant, and a body
# with a branch; under `--sanitize` every one of them is built at every read
# (R2).

variant Shape
    line
        pts: [i64]

constant BASE: i64
    40

constant INNER: [i64]
    [1, 2]

constant OUTER: [[i64]]
    [INNER, INNER]

constant ALIAS: [i64]
    INNER

constant SCALED: [i64]
    [BASE, 2]

constant SHAPES: [Shape]
    [.line(pts: INNER)]

constant PICK: [i64]
    if BASE > 10
        [BASE, BASE * 2]
    else
        []

function main()
    total: i64 @ 0
    at: i64 @ 0

    while at < 100
        total @ total + OUTER[at % 2][1] + ALIAS[0] + SCALED[at % 2] + PICK[1]
        at @ at + 1

    print(total, " ", OUTER[1] == INNER, " ", ALIAS == INNER, " ", SCALED[0], " ", PICK.len())

    match SHAPES[0]
        .line l => print(l.pts[1], " ", l.pts == INNER)

    copy: [[i64]] @ OUTER
    copy[0][0] @ 9
    print(copy[0][0], " ", OUTER[0][0], " ", INNER[0], " ", copy[1][0])
