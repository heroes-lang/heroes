# Defect 245, panel 192's R1, 2026-10-05: the two doors whose types promise a
# failure. `read_file` and `write_file` lent their path to C, which read it to
# its NUL, so a path `<victim>` NUL `x` read the victim's text and overwrote
# it, at exit 0 (the ffi-pragmatist's probes, 19 doors of 29 acting on a file
# the program never named). They now take the `str` and answer a failure the
# program reads, `read_failed` and `write_failed`, before any file is opened;
# the victim keeps its text.
#
# The NUL comes from a file, as in the lend's case; `build/` for the paths.

extern "stdio.h"
    function fopen(path: cstr lent, mode: cstr lent) -> ptr
    function fputc(c: i32, stream: ptr) -> i32
    function fclose(stream: ptr) -> i32

constant ZERO: str
    "build/heroes-golden-245-zero.bin"

constant VICTIM: str
    "build/heroes-golden-245-victim.txt"

# One NUL byte, written by C and read back as a `str` of length 1.
function zero() -> str
    handle = fopen(path: ZERO.cstr(), mode: "wb".cstr())
    assert handle != nullptr
    _ = fputc(c: 0, stream: handle)
    _ = fclose(stream: handle)
    return read_file(ZERO).must()

function main()
    write_file(path: VICTIM, text: "the victim's text").must()
    path = VICTIM + zero() + "x"
    print("the path holds ", path.len(), " bytes")

    match read_file(path)
        .ok text => print("read another file: ", text)
        .err e   => print("read: ", e.code, ": ", e.msg)

    match write_file(path: path, text: "overwritten")
        .ok _  => print("wrote another file")
        .err e => print("write: ", e.code, ": ", e.msg)

    print("the victim holds: ", read_file(VICTIM).must())
