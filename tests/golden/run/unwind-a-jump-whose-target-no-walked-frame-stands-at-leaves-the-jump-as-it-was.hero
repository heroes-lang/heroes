# Panel 258's R2, ratified by the author's reading on 2026-11-27 (decision
# 2758): where the unwind cannot be made it degrades to the behaviour before
# R2. The save point's frame moves its stack pointer after the save
# (`uw_guard_moved` `alloca`s a buffer before it calls the callback), so no
# frame the hook's walk reads stands at the stack pointer the jump installs,
# and C jumps over the callback 1,000 times.
# What it pins: the hook unwinds only where a frame of the chain stands at the
# jump's target exactly (`runtime/parts/unwind.c`, `hero_unwind_jump`), and
# otherwise makes the jump as it always was: what the callback held stays held,
# its callback stays unfinished and the exit audit forgives the program as a
# program that calls `exit` is forgiven (defect 2704), with no false word, no
# crash and no cleanup run. A walk that stops at a frame built without unwind
# information, before the target, takes the same branch; such a frame cannot
# be written in a header the unit compiles: under `-fexceptions` clang gives
# a `nouwtable` and `nothrow` function its unwind entry all the same (this
# lane's runs, Darwin arm64 and Linux arm64), and Darwin's linker covers a
# function with none by its neighbour's compact entry.
extern "unwind-catch.h"
    function uw_guard_moved(cb: (function(i64) -> i64), n: i64) -> i64
    function uw_throw()

function body(n: i64) -> i64
    held = f"held by the callback, round {n}"
    words: [str] = [held, "and another"]
    uw_throw()
    return words.len()

function main()
    jumped: i64 @= 0

    for round in range(from: 0, to: 1000)
        if uw_guard_moved(cb: body, n: round) == -1
            jumped @ jumped + 1

    print("C jumped over the callback ", jumped, " times, to a frame that moved its stack")
