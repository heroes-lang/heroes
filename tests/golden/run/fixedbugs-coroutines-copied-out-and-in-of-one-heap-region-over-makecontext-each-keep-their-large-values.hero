# Fixed 2026-11-25, panel 259's R1 (route E, provisional, author
# ratification pending), lane land259 (panel 259's ffi-pragmatist,
# `cpu_heap`): two coroutines made by `makecontext` on ONE heap region and
# switched by `swapcontext`, every switch one the runtime sees, the occupant
# copied out before the other runs there and back before it resumes. A
# correct program.
# Symptom: `body holds 7`, then `panic: a null pointer was read
# through, at offset 0x1c, called from hero_frame_aside_unlink`, words about a
# handle the program never had, 3 runs of 3 on this Mac; SIGSEGV on Linux
# arm64 and x86-64 (the sitting's cells). The header unpoisons the region for
# AddressSanitizer at each switch in (its own comment says why).
# Cause: panel 258's R1 gave back the room of every take of a frame
# below the taking one on the thread's own stack, an order of addresses a
# switch C makes can falsify, so a live value's room was handed to another
# frame.
# Fix: no take and no lend is judged given back by its frame's address: each
# is a block or a region of its own, given back by its own give
# (`runtime/parts/frame.c`, `runtime/parts/lend_aside.c`; panel 259's R1,
# route E).
extern "fixedbugs-coroutines-copied-out-and-in-of-one-heap-region-over-makecontext.h"
    function cpu_start(k: i64, f: (function(i64) -> i64))
    function cpu_yield()
    function cpu_resume(k: i64) -> i64

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function run(k: i64) -> i64
    v = e5(k + 10)
    cpu_yield()
    w = e5(k + 20)
    return v.a.a.a.a.a.x + w.b.b.b.b.b.x

function body(n: i64) -> i64
    mine = e5(n)
    cpu_start(k: 0, f: run)
    cpu_start(k: 1, f: run)
    print("body holds ", mine.a.a.a.a.a.x)
    b = cpu_resume(k: 1)
    print("body holds ", mine.a.a.a.a.a.x)
    a = cpu_resume(k: 0)
    print("body holds ", mine.a.a.a.a.a.x, " coroutines ", a, " ", b)
    return mine.h.h.h.h.h.x

function main()
    print("copied by ucontext, heap: ", body(n: 7))
