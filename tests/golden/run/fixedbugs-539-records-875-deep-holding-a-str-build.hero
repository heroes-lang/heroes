# Fixed 2026-10-09, defect 539, lane b17-emit (panel 200's R5).
# Symptom: records nested by value 875 deep (`R0` holding a `str`, each
# `R<i>` the one before) stopped `build` at exit 2, *clang died on the C
# (Segmentation fault: 11)*, with a note blaming the C compiler's limit;
# 750 built, 875 and 1,000 died, and an `i64` at the bottom built at 7,000.
# Cause: the prologue zeroed each refcounted slot with `= {0}`, and clang
# reaches the first scalar of `{0}` by brace elision, a recursion as deep as
# the chain; an `i64` chain's slot takes no initialiser, so it never did.
# Now past `typeorder`'s depth the slot is zeroed by bytes,
# `__builtin_memset(&slot, 0, sizeof slot)`, still zero as panel 182 rules.
# This case: the chain built in one body, held in a slot, written again.

record R0
    s: str

record R1
    inner: R0

