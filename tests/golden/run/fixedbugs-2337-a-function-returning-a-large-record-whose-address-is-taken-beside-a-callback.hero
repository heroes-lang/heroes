# fixedbugs, defect 2337, 2026-11-08: the same with the record as the result,
# which the function writes through its caller's slot (`hero_out`): the thunk
# called it with C's by-value arguments alone, `too few arguments to function
# call, expected 2, have 1`, `heroes build` exit 2. It now gets no thunk and no
# table row (`large_value.crosses`). Panel 236 found it.

extern "fixedbugs-2337-callback.h"
    function fixedbugs_2337_apply(cb: (function(i64) -> i64), n: i64) -> i64

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

# 8,192 counted bytes, past `LARGE`: a function takes it as a pointer and
# returns it through its caller's slot (panel 233's R2).
record E4
    a: E3
    b: E3

function e1(n: i64) -> E1
    z = E0(x: n)
    return E1(a: z, b: z, c: z, d: z, e: z, f: z, g: z, h: z)

function e2(n: i64) -> E2
    z = e1(n: n)
    return E2(a: z, b: z, c: z, d: z, e: z, f: z, g: z, h: z)

function e3(n: i64) -> E3
    z = e2(n: n)
    return E3(a: z, b: z, c: z, d: z, e: z, f: z, g: z, h: z)

function one(n: i64) -> i64
    return n + 1

function build_one(n: i64) -> E4
    return E4(a: e3(n: n), b: e3(n: n + 1))

function main()
    f = build_one
    print(build_one(n: 4).b.h.h.h.x)
    print(f(6).a.a.a.a.x)
    print(fixedbugs_2337_apply(cb: one, n: 1))
