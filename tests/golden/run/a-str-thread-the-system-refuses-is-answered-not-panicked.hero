# The coherence review of Rebel's X08, 2026-11-20: `hero_thread_spawn_str`
# panics where the operating system refuses a thread, so Rebel's
# `threads.spawn_text` stopped the program where `spawn` failed `limit`. Its
# sized door, `hero_thread_spawn_str_sized`, answers the refusal as
# `hero_thread_spawn_sized` does, -1 with the system's own number in `why`,
# and gives back the copy of the argument it had made. A stack no machine
# reserves, 2^62 bytes, is refused; a thread on the runtime's own floor and
# one on two megabytes start, take their copy and answer theirs.
extern "hero_os.h"
    function hero_thread_spawn_str_sized(body: (function(str) -> str), arg: str, bytes: i64, @why: i64) -> i64
    function hero_thread_join_str(handle: i64) -> str

function shout(word: str) -> str
    return word + "!"

function main()
    why: i64 @= 0
    refused = hero_thread_spawn_str_sized(body: shout, arg: "never", bytes: 4611686018427387904, why: @why)
    print("a stack of 2^62 bytes: ", refused, ", the system's number given: ", why != 0)
    why @ 0
    floor = hero_thread_spawn_str_sized(body: shout, arg: "hello", bytes: 0, why: @why)
    print("the runtime's own stack: ", hero_thread_join_str(floor), ", nothing refused: ", why == 0)
    two = hero_thread_spawn_str_sized(body: shout, arg: "héllo", bytes: 2097152, why: @why)
    print("two megabytes: ", hero_thread_join_str(two))
