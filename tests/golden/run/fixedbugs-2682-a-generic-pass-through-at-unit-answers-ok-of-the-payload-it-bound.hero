# A generic function instantiated at `()` builds `ok(v)` from a unit value
# (defect 2682, 2026-11-22). `heroes check` accepted it, since `ok(v)` with
# `v: T` is checked once for every `T`, and `heroes build` stopped at exit 2:
# clang refused `.as.ok = t6`, a temporary the unit rule never declares. The
# emitter now builds such an `ok` as `ok()` is, the tag alone.
#
# This shape: the payload a match arm binds, handed back to `ok`.

# Passes `r` on unchanged.
#
# - `r`: the result.
function pass<T>(r: T?) -> T?
    match r
        .ok v  => return ok(v)
        .err e => return fail(code: e.code, msg: e.msg)

function main()
    x: ()? = ok()
    print(pass(x).is_err())
    y: ()? = fail(code: "kept", msg: "the failure passes through")

    match pass(y)
        .ok _  => print("ok")
        .err e => print(e.code)
