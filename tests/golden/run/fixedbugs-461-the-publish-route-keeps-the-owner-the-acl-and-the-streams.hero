# Defect 461, 2026-10-08, the compiler's own door beside the program's.
# Symptom: on Windows the publish route (`fmt --in-place`, `check --apply
# --in-place` and every rewrite of a file the author named) staged its new
# text and moved it over the file with `MoveFileEx`, and the file that came
# out had the directory's inherited ACEs alone, no named stream (a downloaded
# file's mark of the web is one) and this process's owner: measured on the box
# at `56def9b4` (clang 23.1.1, NTFS) by a case of C over the runtime's own
# doors, an explicit ACE, `Zone.Identifier` and the owner all gone after the
# route, and the hidden attribute alone carried. Cause: the stage gave the new
# file the attributes and nothing else, and a move puts a new file at the
# name. Now the stage is created under the file's own owner, group and DACL
# and `hero_fs_replace` puts it in place with `ReplaceFileW`, which keeps the
# DACL, the streams and the attributes (`runtime/parts/replace.c`).
#
# The doors are the ones `cli/files.hero` binds, called as the route calls
# them: stage under a private name beside the file, then replace. The same
# lines on every platform, the marks each keeps on a file put by the fixture
# (`fixedbugs-461-a-rewrite-keeps-the-owner-the-acl-and-the-streams.h`).
# `build/` for the directory, defect 438's case's reason.

extern "fixedbugs-461-a-rewrite-keeps-the-owner-the-acl-and-the-streams.h"
    function mark(path: cstr lent) -> i64
    function keeps(path: cstr lent) -> i64
    function unmark(path: cstr lent)

extern "hero_os.h"
    function hero_os_pid() -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    function hero_dir_release()
    function hero_dir_remove_tree(path: cstr lent) -> i64
    function hero_file_stage(staged: cstr lent, text: str, like: cstr lent) -> i64
    function hero_fs_replace(staged: cstr lent, path: cstr lent) -> i64
    constant HERO_DIR_FILES: i64
    constant HERO_STAGE_DONE: i64
    constant HERO_OS_OK: i64

constant TEXT: str
    "the new text\n"

function main()
    dir = "build/heroes-golden-461-route-" + hero_os_pid().to_str()
    path = dir + "/marked.txt"
    staged = path + ".staged"

    if hero_fs_mkdir_all(path: dir.cstr()) != 0 || write_file(path: path, text: "OLD").is_err()
        print("cannot make ", path)
        return
    print("marked ", mark(path: path.cstr()) == 1)
    print("staged ", hero_file_stage(staged: staged.cstr(), text: TEXT, like: path.cstr()) == HERO_STAGE_DONE)
    print("replaced ", hero_fs_replace(staged: staged.cstr(), path: path.cstr()) == HERO_OS_OK)
    print("holds the text ", read_file(path).default("(unreadable)") == TEXT)
    print("keeps its marks ", keeps(path: path.cstr()) == 1)
    print("beside it ", hero_dir_scan(root: dir.cstr(), want: HERO_DIR_FILES, recursive: 0))
    hero_dir_release()
    unmark(path: path.cstr())
    _ = hero_dir_remove_tree(path: dir.cstr())
