# Defect 382, 2026-10-06. A constant of variant cases is laid out with each
# case a compound literal in the static block's initializer, the arrays a
# payload holds static blocks of their own (panel 195's R1); under
# `--sanitize` it is built at every read (R2). Below: a case with no payload,
# a string payload, an array payload empty and not, a payload of two narrow
# fields that leaves padding, a case holding another variant's case, and a
# variant that holds itself through an array.

variant Mark
    plain
    count
        n: i64

variant Shape
    dot
    named
        label: str
    line
        n: i64
        pts: [i64]
    small
        b: u8
        flag: bool
    wrap
        inner: Mark

variant Tree
    leaf
        v: i64
    node
        kids: [Tree]

constant SHAPES: [Shape]
    [
        .dot
        .named(label: "ziggy")
        .line(n: 7, pts: [1, 2, 3])
        .line(n: 2, pts: [])
        .small(b: 255, flag: true)
        .wrap(inner: .count(n: 5))
        .wrap(inner: .plain)
    ]

constant FOREST: [Tree]
    [.node(kids: [.leaf(v: 1), .node(kids: [.leaf(v: 4)]), .node(kids: [])]), .leaf(v: 2)]

function weight(s: Shape) -> i64
    return match s
        .dot     => 1
        .named m => m.label.len()
        .line l  => l.n + l.pts.len()
        .small m => m.b.to_i64().must()
        .wrap w =>
            match w.inner
                .plain   => 100
                .count c => c.n

function sum(t: Tree) -> i64
    return match t
        .leaf l => l.v
        .node n => n.kids.fold(0, add)

function add(acc: i64, item: Tree) -> i64
    return acc + sum(item)

function main()
    total: i64 @ 0
    at: i64 @ 0

    while at < 700
        total @ total + weight(SHAPES[at % 7])
        at @ at + 1

    print(total, " ", sum(FOREST[0]), " ", sum(FOREST[1]), " ", SHAPES[4] == .small(b: 255, flag: true))
    copy: [Shape] @ SHAPES
    copy[1] @ .named(label: "mars")
    print(weight(copy[1]), " ", weight(SHAPES[1]), " ", copy == SHAPES, " ", SHAPES == SHAPES)
