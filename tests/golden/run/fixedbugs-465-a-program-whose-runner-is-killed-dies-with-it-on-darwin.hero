# Defect 465, 2026-10-10 (panel 200's R2). Symptom: on macOS a `heroes` ended
# by SIGKILL left the program it ran still running, its parent 1: 0 of 5 ended
# in the sitting and on this lane's base. Cause: no process can catch SIGKILL,
# and Darwin has no `PR_SET_PDEATHSIG`, the request defect 437 made on Linux.
# Repair: the runner's sentinel, a process forked at its first launch that
# holds the read end of a pipe only the runner writes, and ends every child
# still named down it when the pipe reads its end (`runtime/parts/run.c`).
#
# The program is defect 437's three generations without its Linux request:
# the first runs the second under a watchdog, the second runs the third, the
# third beats once, kills the second with SIGKILL, and beats on for ten
# seconds at most; the first counts the beats, waits a second, and counts
# again. The same count is the third ended with the one that ran it, by the
# sentinel on Darwin and by the request on Linux; `unistd.h` and `kill` are
# POSIX's, so the Windows box, whose job object is that arm's road, skips it by
# its build's own words. `build/` for the directory, as defect 437's case.

extern "signal.h"
    constant SIGKILL: i32
    function kill(pid: i32, sig: i32) -> i32

extern "unistd.h"
    function getppid() -> i32

extern "time.h"
    function time(at: ptr) -> i64

extern "hero_os.h"
    function hero_run_reset()
    function hero_run_arg(word: str)
    function hero_run_limit(seconds: i64)
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    function hero_os_pid() -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    function hero_dir_release()
    function hero_dir_remove_tree(path: cstr lent) -> i64
    constant HERO_DIR_FILES: i64

# How long the third generation beats before it ends by itself, in seconds:
# the bound on an orphan where the request is missing.
constant LIFE: i64
    10

function itself() -> str
    status: i64 @ 0
    marks: i64 @ 0
    return hero_exe_path_shown(status: @status, marks: @marks)

# This program run again with `words`, under a watchdog of `seconds`, 0 for
# none: the code it answered.
function again(words: [str], seconds: i64) -> i64
    program = itself()
    hero_run_reset()
    hero_run_arg(word: program)

    for word in words
        hero_run_arg(word: word)

    hero_run_limit(seconds: seconds)
    status: i64 @ 0
    code = hero_run_go(program: program.cstr(), in_path: "".cstr(), out_path: "".cstr(), err_path: "".cstr(), @status)
    hero_run_reset()
    return code

# How many beats `dir` holds.
function beats(dir: str) -> i64
    count = hero_dir_scan(root: dir.cstr(), want: HERO_DIR_FILES, recursive: 0)
    hero_dir_release()
    return count

# The second generation: the third, which kills it.
function second(dir: str)
    _ = again(["third", dir], seconds: 0)

# The third generation: a beat, its parent killed, and beats on, one every
# 2^20 turns, until something ends it or LIFE seconds have passed.
function third(dir: str)
    if write_file(path: dir + "/beats/0", text: "").is_err()
        return
    _ = kill(pid: getppid(), sig: SIGKILL)
    born = time(at: nullptr)
    n: i64 @ 0
    k: i64 @ 0

    while time(at: nullptr) - born < LIFE
        n @ n + 1

        if n % 1048576 == 0
            k @ k + 1

            # A beat that cannot be written is the next one's to make.
            if write_file(path: dir + "/beats/" + k.to_str(), text: "").is_err()
                k @ k - 1

# A loop the watchdog ends, which is how the first generation waits.
function spin() -> i64
    n: i64 @ 0

    while true
        n @ n + 1

        if n == 1000000000
            n @ 0

    return n

function first()
    dir = "build/heroes-golden-465-" + hero_os_pid().to_str()
    _ = hero_fs_mkdir_all(path: (dir + "/beats").cstr())
    code = again(["second", dir], seconds: 30)
    print("the second generation was killed by SIGKILL: ", code == 128 + SIGKILL.to_i64().must())
    before = beats(dir + "/beats")

    if before < 1
        print("the third generation never beat")
    else
        _ = again(["nap"], seconds: 1)

        if beats(dir + "/beats") == before
            print("the third generation ended with it")
        else
            print("the third generation outlived the one that ran it")
    _ = hero_dir_remove_tree(path: dir.cstr())

function main()
    words = args()

    if words.len() == 0
        first()
    else if words[0] == "second"
        second(words[1])
    else if words[0] == "third"
        third(words[1])
    else
        print(spin())
