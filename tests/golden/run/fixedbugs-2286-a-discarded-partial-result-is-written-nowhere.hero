# fixedbugs, defect 2286, 2026-11-08 (panel 236's R2): a call whose result is
# discarded passes no destination (`hero_out` is `NULL`), so nothing receives
# the 128 MiB record; on the base the discarded result was still a temporary of
# the caller's frame at `-O0` and the program aborted there.
extern "fixedbugs-2253-held.h"
    record Held tag heroes_held partial
        first: i64

function make(n: i64) -> Held
    print(n)
    return Held(first: n, rest: zero)

function go()
    _ = make(n: 7)
    print(8)

function main()
    print("before")
    go()
