# Fixed 2026-11-25, the defect lane panel258-r1 found beside defect 2752,
# lane-coroutine-room: two coroutines on the heap's stacks, switched by a
# switch of the header's own in assembly that the runtime never sees, each
# holding a 256 KB record across a switch, resumed in the order they started
# and then in the other. A correct program.
# Symptom: the program aborted with `panic: internal error: a large value's
# room was given back out of order (compiler bug)`, 3 runs of 3.
# Cause: the room was one stack per thread, and two coroutines on one thread
# interleave their frames.
# Fix: a frame off the thread's own stack takes a block of its own, given
# back in any order (`runtime/parts/stack_lane.c`,
# `runtime/parts/frame_aside.c`); a stack nobody can name is never judged.
extern "fixedbugs-coroutines-switched-by-a-librarys-own-switch.h"
    function ow_start(k: i64, f: (function(i64) -> i64))
    function ow_yield()
    function ow_resume(k: i64) -> i64

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function run(k: i64) -> i64
    v = e5(k + 10)
    ow_yield()
    w = e5(k + 20)
    return v.a.a.a.a.a.x + w.b.b.b.b.b.x

function main()
    ow_start(k: 0, f: run)
    ow_start(k: 1, f: run)
    a = ow_resume(k: 0)
    b = ow_resume(k: 1)
    print("order 0 1: ", a, " ", b)
    ow_start(k: 0, f: run)
    ow_start(k: 1, f: run)
    d = ow_resume(k: 1)
    c = ow_resume(k: 0)
    print("order 1 0: ", c, " ", d)

# Corrected 2026-11-25, lane land259 (panel 259's R1, route E,
# provisional, author ratification pending): the fix above is gone, and on
# that date `runtime/parts/stack_lane.c` and `runtime/parts/frame_aside.c`
# with it. No take and no lend is judged given back by its frame's address
# on any stack, since an order of addresses a switch of stacks C makes can
# falsify handed live values to other frames (panel 259's cells): each is a
# block or a region of its own, given back by its own give
# (`runtime/parts/frame.c`, `runtime/parts/lend_aside.c`), which is what
# keeps this program right now.
