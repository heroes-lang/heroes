# fixedbugs, defect 157 widened, lane land186, 2026-10-02: the routes
# `ffi_tag_is_a_union`'s note gives a handle over a union named only by its
# tag, and a record named for that tag, built and run. The header beside
# this case stands for the program's own: `typedef union utag UH_t;` after
# `tag` makes the handle `UH_t *`, and `typedef union utag utag;` makes the
# record's own name a type C reads.

extern "fixedbugs-157-handle-unions.h"
    record UH tag UH_t
    record utag
        i: i32
    function new_u() -> UH
    function read_u(p: UH) -> i32
    function make_u() -> utag

function main()
    print(read_u(p: new_u()))
    print(make_u().i)
