# Fixed 2026-11-20, defect 2606, lane-signals: `main` joins a handle the
# program was never given, a runtime panic, while a worker sits blocked
# writing stderr into a pipe nobody reads.
# Symptom: the program never ended (killed at 6 s, 3 runs of 3 on this Mac):
# the report waited on stderr's lock, which the blocked worker holds inside
# its `write`, and past the lock the pipe is full.
# Cause: a report's bytes went through stdio and a `write` with no bound.
# Every report now asks stderr's lock for a bound, and writes its bytes to
# the descriptor only as `poll` says it takes them; a descriptor that takes
# nothing for that bound ends the report, and the program ends at its status.
# The program makes its own stderr the unread pipe (its header), so nothing
# reaches the harness's stderr.
extern "fixedbugs-2600-stderr-into-a-pipe-nobody-reads.h"
    function unread_stderr() -> i64

extern "unistd.h"
    function usleep(useconds: u32) -> i32

extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64
    function hero_write_err(text: str)

function talk(n: i64) -> i64
    i @= 0

    while i < 1_000_000_000
        hero_write_err(f"worker {i}\n")
        i @ i + 1

    return n

function main()
    print("main stops now")

    if unread_stderr() == 1
        t = hero_thread_spawn(body: talk, arg: 7)
        _ = usleep(useconds: 300000)
        _ = hero_thread_join(handle: t + 1000)
