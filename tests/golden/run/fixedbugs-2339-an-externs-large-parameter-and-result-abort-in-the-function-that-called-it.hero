# fixedbugs, defect 2339, 2026-11-08: a record handed to an `extern` by
# value and returned by it, two copies on the calling function's frame, which
# passes the stack at `go`'s entry, after `main` printed `before`. Kept out
# of line, `go` is named at every level, and the line is printed. Windows'
# guard names no function (`tests/harness/platform_skips.hero`).
extern "fixedbugs-2339-held.h"
    record Held tag heroes_held partial
        first: i64
    function heroes_held_bump(h: Held, by: i64) -> Held

function go()
    h = heroes_held_bump(h: Held(first: 7, rest: zero), by: 1)
    print(h.first)

function main()
    print("before")
    go()
