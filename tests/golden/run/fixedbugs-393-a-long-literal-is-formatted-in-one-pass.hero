    at: i64 @= 1

    for x in xs
        weighted @ weighted + x * at
        at @ at + 1

    keyed: i64 @= 0

    for k in range(from: 0, to: 64)
        keyed @ keyed + m[f"k{k}"].must() * (k + 1)

    print(xs.len(), " ", weighted, " ", m.len(), " ", keyed, " ", chained)
