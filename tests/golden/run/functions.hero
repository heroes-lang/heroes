# Declaration order carries no meaning (§4.2) and mutual recursion needs no
# forward declaration — which is C's problem, solved by emitting every prototype
# before every definition. `is_even` and `is_odd` call each other.
# Bulk regression case.

function is_even(n: int) -> bool
    if n == 0
        return true
    return is_odd(n - 1)

function is_odd(n: int) -> bool
    if n == 0
        return false
    return is_even(n - 1)

function main()
    print(is_even(10))
    print(is_odd(10))
    print(fib(10))

function fib(n: int) -> int
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)
