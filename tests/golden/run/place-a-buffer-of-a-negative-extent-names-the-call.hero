# M-panic-location, panel 230's R1, kind 2: a buffer lent to C with an extent
# below zero is refused before C runs, naming the call it was to be lent to,
# where `fill_cell(...)` begins. The header and the program are defect 396's.

extern "fixedbugs-396-buffers.h"
    function fill_cell(@buf: [u8] counted_by n lent, @n: i32) -> i64

function main()
    counts: [i32] @= [3, -1]
    buf: [u8] @= []
    print(fill_cell(@buf, @counts[0]), " ", buf.len(), " ", buf[2])
    print(fill_cell(@buf, @counts[1]))
    print("not reached")
