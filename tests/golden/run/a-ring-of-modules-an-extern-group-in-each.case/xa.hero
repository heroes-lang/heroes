use xb

extern "xa.h"
    record XRect
        w: i64
        h: i64
    function xa_twice(n: i64) -> i64

# Twice `n`, by this module's header.
function twice(n: i64) -> i64
    return xa_twice(n: n)

# Sends a C record to the other module of the ring.
function run() -> i64
    r = XRect(w: 3, h: 4)
    return xb.area(r: r) + xb.add(a: 1, b: 2)
