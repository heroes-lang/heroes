# Fixed 2026-11-25, the defect lane panel258-r1 found beside defect 2752,
# lane-coroutine-room: three `makecontext` coroutines, each lending C a local
# in place for its function's life and a buffer to a call that switches away
# and back before it returns, resumed in another order than they started. A
# correct program.
# Symptom: the program aborted with `panic: a buffer lent to C was given back
# at an address its region does not hold`, which blamed C writing past a
# field of the frame, 3 runs of 3.
# Cause: the regions a buffer or a local is lent to C from were one stack per
# thread, and the coroutines' frames interleave on the thread.
# Fix: the thread's lend regions hold only what frames of the thread's own
# stack lent (`runtime/parts/stack_lane.c`); a frame on any other stack lends
# from a region of its own, guarded and watched as every region is, given
# back in any order (`runtime/parts/lend_aside.c`).
extern "fixedbugs-coroutines-switched-by-hand.h"
    function cr_start(k: i64, f: (function(i64) -> i64))
    function cr_yield()
    function cr_resume(k: i64) -> i64
    function cr_bump(@n: i64)
    function cr_yield_lent(k: i64, @buf: [u8] counted_by 8 lent)

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function e4(n: i64) -> E4
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    return E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)

function e5(n: i64) -> E5
    v4 = e4(n)
    return E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)

function run(k: i64) -> i64
    n: i64 @= k * 100
    cr_bump(@n)
    buf: [u8] @= []
    cr_yield_lent(k: k, @buf)
    cr_bump(@n)
    v = e4(k)
    cr_yield()
    cr_bump(@n)
    print("coroutine ", k, " lent ", buf[0], " ", buf[1])
    return n + v.a.a.a.a.x

function main()
    cr_start(k: 0, f: run)
    cr_start(k: 1, f: run)
    cr_start(k: 2, f: run)
    _ = cr_resume(k: 2)
    _ = cr_resume(k: 0)
    _ = cr_resume(k: 1)
    a = cr_resume(k: 1)
    b = cr_resume(k: 2)
    c = cr_resume(k: 0)
    print("lent across switches: ", c, " ", a, " ", b)

# Corrected 2026-11-25, lane land259 (panel 259's R1, route E,
# provisional, author ratification pending): the fix above is gone, and on
# that date `runtime/parts/stack_lane.c` and `runtime/parts/frame_aside.c`
# with it. No take and no lend is judged given back by its frame's address
# on any stack, since an order of addresses a switch of stacks C makes can
# falsify handed live values to other frames (panel 259's cells): each is a
# block or a region of its own, given back by its own give
# (`runtime/parts/frame.c`, `runtime/parts/lend_aside.c`), which is what
# keeps this program right now.
