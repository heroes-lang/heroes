# M-panic-location, panel 230's R1, kind 2: a map written at a key not equal to
# itself, a nan, stops the program at the place where the store begins. A float
# key is refused where it is written (`float_map_key`); through a type parameter
# it cannot be, and the runtime is what stops it.

function store<K>(k: K) -> {K: i64}
    m: {K: i64} @= {}
    m[k] @ 1
    return m

function main()
    zero = 0.0
    print(store(k: 1.0).len())
    print(store(k: zero / zero).len())
