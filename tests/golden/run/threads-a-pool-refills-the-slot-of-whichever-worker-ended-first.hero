# A pool learns which of its running threads ended first without asking any
# of them (feature 2668): every worker sends its own number on one mailbox as
# it ends, and the scheduler receives from it, the first to end the first
# received, then waits for that thread, whose wait no longer blocks. A
# `receive(within_ms: 0)` asks whether one has ended without waiting, taking
# its number if so, and a bound asks with a limit. Here a slow step holds one of two slots, held
# until every quick step has run, and the five quick steps run one after
# another in the other slot, each refilling it the moment the one before
# ended: a build's `-j 2` keeps its parallelism behind one slow step.

record Step
    id: i64
    held: (mailbox i64)
    done: (mailbox i64)

function run_step(s: Step) -> i64
    if s.id == 0
        _ = s.held.receive(within_ms: 0 - 1).is_err()
    s.done.send(s.id).must()
    return s.id * 10

function main()
    done: (mailbox i64) = mailbox()
    held: (mailbox i64) = mailbox()
    running: {i64: (thread i64)} @= {}
    total = 6
    next: i64 @= 0

    while next < 2
        running[next] @ spawn(run_step, Step(id: next, held: held, done: done)).must()
        next @ next + 1

    finished: i64 @= 0
    order: [i64] @= []

    while finished < total
        ended = done.receive(within_ms: 10000).must()
        order @ order.push(ended)
        print(f"step {ended} ended first of those running, its answer {running[ended].must().wait()}")
        finished @ finished + 1

        if next < total
            running[next] @ spawn(run_step, Step(id: next, held: held, done: done)).must()
            next @ next + 1
        else if finished == total - 1
            held.send(1).must()

    print(order.len(), " steps in the order they ended, the slow one last")

    match done.receive(within_ms: 0)
        .ok n  => print(f"step {n} ended again")
        .err e => print(f"asked without waiting, none has ended since: {e.code}")
