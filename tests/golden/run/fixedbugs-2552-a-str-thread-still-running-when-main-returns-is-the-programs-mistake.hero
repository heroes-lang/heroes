# Fixed 2026-11-19, defect 2552, lane-251 (panel 251's R2): the `str` door's
# thread (feature 2521) still running when `main` returns.
# Symptom: told as a compiler bug, 2 heap blocks still live, 20 runs of 20 (the
# sitting's `unjoined_str`): the `str` its body built is the program's value,
# counted, and alive on the thread nobody joined.
# Cause: the balance was read before the thread table. A thread of either door
# nobody joins is told as the program's mistake (spec § 13).
extern "unistd.h"
    function usleep(useconds: u32) -> i32

extern "hero_os.h"
    function hero_thread_spawn_str(body: (function(str) -> str), arg: str) -> i64
    function hero_thread_join_str(handle: i64) -> str

function busy(s: str) -> str
    word = "held by a thread: " + s
    _ = usleep(useconds: 1000000)
    _ = usleep(useconds: 1000000)
    return word

function main()
    handle = hero_thread_spawn_str(body: busy, arg: "seven")
    _ = usleep(useconds: 200000)
    print("started ", handle, ", never joined, still running")
