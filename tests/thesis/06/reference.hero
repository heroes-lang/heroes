# Task 6, a grid turned: the assistant's reference solution (M-thesis-harness,
# 2026-10-20, labelled `assistant`). Read by `dry` alone.
function main()
    given = args()

    if given.len() != 2
        exit(code: 2)
    turns = parsed(given[1])
    text = read_file(path: given[0])

    if turns.is_err() || text.is_err()
        exit(code: 2)
    grid: [str] @= rows(text.must())

    if grid.len() == 0
        return

    for row in grid
        if row.len() == 0 || row.len() != grid[0].len()
            print("ragged")
            exit(code: 1)

    for _ in range(from: 0, to: turns.must() % 4)
        turned(@grid)

    for row in grid
        print(row)

# K: one or more decimal digits.
function parsed(digits: str) -> i64?
    if digits.len() == 0
        return fail(code: "bad_turns", msg: "no digits")
    value: i64 @= 0

    for i in range(from: 0, to: digits.len())
        if digits[i] < '0' || digits[i] > '9'
            return fail(code: "bad_turns", msg: "not a digit")
        value @ value * 10 + to_i64(digits[i] - '0').must()

    return ok(value)

# The file's lines; a final line feed starts no row.
function rows(text: str) -> [str]
    out: [str] @= []
    start: i64 @= 0

    for i in range(from: 0, to: text.len())
        if text[i] == '\n'
            out @ out.push(text.slice(from: start, to: i))
            start @ i + 1

    if start < text.len()
        out @ out.push(text.slice(from: start, to: text.len()))
    return out

# One quarter turn clockwise: column c, read from the bottom row up, is row c.
function turned(@grid: [str])
    height = grid.len()
    out: [str] @= []

    for c in range(from: 0, to: grid[0].len())
        column: [str] @= []

        for r in range(from: 0, to: height)
            column @ column.push(grid[height - 1 - r].slice(from: c, to: c + 1))

        out @ out.push(column.join(""))

    grid @ out
