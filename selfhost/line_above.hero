# What the line above holds, asked where `open_line` decides a line break
# (design.md §4.15, §4.17; panel 181): the questions about the tokens already
# lexed, where `next_line` asks the text not lexed yet.
#
# Each reads the token stream and, for a word the lexer refused, the text
# that word stands in, and none of them decides whether a program compiles:
# an answer picks which diagnostic the author reads, as every heuristic of
# panel 181 item 1 does.
#
# | entry | called by |
# |---|---|
# | `headed_by_a_refused_word` | `open_line.refuse_the_end` and `open_line.goes_on_below` |
# | `heads_a_declaration`, `opens_a_line`, `names_a_declaration` | `open_line` |

use token
use state
use foreign_at
use next_line

## A line a refused word heads

# Is the line whose last significant token is at `at` headed by a word the
# lexer refused, one the parser reads as no word of the language? Then the
# line is that word's mistake, and its tokens open no break: the parser drops
# a line such a word heads, so a line below joined into it went with it, its
# own mistakes unsaid, and the break its last token left was the foreign
# habit's own shape (`include <stdio.h>` at its `>`), a second message for one
# mistake (defect 132's class, lane 133's finding). A foreign word the parser
# reads as its certain swap heads the line its swap does, `fn main() ->` as
# `function main() ->`, so the same mistake takes the same codes before and
# after `check --apply` writes the swap (`next_line.opening_keyword`).
function headed_by_a_refused_word(tokens: [token.Token], breaks: [state.Break], text: str, at: i64) -> bool
    head = tokens[line_head(tokens, breaks: breaks, at: at)]

    if head.kind != .error || foreign_at.repair_at(text, head.span).is_err()
        return false
    return next_line.opening_keyword(text, at: head.span.start).is_err()

# The index of the first token of the line that holds the token at `at`: past
# the last line end before it, or past the last break the lexer joined, where
# the line below a break begins, and past a comment. Walked back once per
# line decided, over that line's own tokens.
function line_head(tokens: [token.Token], breaks: [state.Break], at: i64) -> i64
    floor: i64 @ 0

    if breaks.len() > 0 && breaks[breaks.len() - 1].after <= at
        floor @ breaks[breaks.len() - 1].after
    i: i64 @ at

    while i > floor && !is_line_end(tokens[i - 1].kind)
        i @ i - 1

    while i < at && tokens[i].kind == .comment
        i @ i + 1

    return i

function is_line_end(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent

## A statement's head

# Does the statement the tokens end with open with a declaration's keyword?
function heads_a_declaration(tokens: [token.Token]) -> bool
    i: i64 @ tokens.len() - 1

    while i > 0 && !is_line_end(tokens[i - 1].kind)
        i @ i - 1

    while i < tokens.len() - 1 && tokens[i].kind == .comment
        i @ i + 1

    k = tokens[i].kind
    return k == .kw_function || k == .kw_constant || k == .kw_record || k == .kw_variant || k == .kw_test || k == .kw_extern || k == .kw_use

# Does the token at `at` begin its line in the stream: nothing before it but
# comments, back to a line's end, a block's edge or the file's start?
function opens_a_line(tokens: [token.Token], at: i64) -> bool
    i: i64 @ at - 1

    while i >= 0 && tokens[i].kind == .comment
        i @ i - 1

    return i < 0 || is_line_end(tokens[i].kind)

# Is the token at `at` the colon of a statement's `name:`, which the next
# line's type and binding complete?
function names_a_declaration(tokens: [token.Token], at: i64) -> bool
    if at < 1 || tokens[at].kind != .colon || tokens[at - 1].kind != .ident
        return false

    if at == 1
        return true
    return is_line_end(tokens[at - 2].kind)
