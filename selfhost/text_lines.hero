# Line and column, read out of a source text by byte offset.
#
# Split out of `cursor.hero` on 2026-08-26, along a seam §11 names rather
# than at a line count: reading lines out of a text is not the token
# cursor's job, and it has no idea what a token is. Nothing here imports
# anything, which is the tell that the concern is its own.
#
# **THREE OF THE FOUR FUNCTIONS EXIST BECAUSE THE FOURTH WAS THIS
# COMPILER'S SINGLE LARGEST COST.** `line_col` answers with a line NUMBER,
# so it walks from byte 0. `doc_comments.take_docs` asked it once per declaration
# and once per comment it examined, and the parse runs over the whole
# concatenated Source (§1.11 appends the library to every compilation) —
# so on this compiler's own 1.2 MB source each call read up to a million
# bytes, and the pair was quadratic in the file. Measured with `sample`
# over `heroes check selfhost/main.hero`: **21,119 of 21,254 samples**
# were inside `line_col` and the three runtime calls it makes, 99.4% of
# the profile, for a question about two ADJACENT lines.
#
# The rule the split records: **ask for the distance you need, not for the
# position you could derive it from**. A distance between two adjacent
# offsets is tens of bytes; a position is the file.
#
# `line_col` stays, because a diagnostic really does want a line number and
# asks for it once per diagnostic (`parse_use` is its only caller here).

## The position of one offset

# Line and column of a byte offset, both 1-based.
record Position
    line: i64
    col: i64

function line_col(text: str, offset: i64) -> Position
    line: i64 @ 1
    col: i64 @ 1
    i: i64 @ 0

    while i < offset && i < text.len()
        if text[i] == '\n'
            line @ line + 1
            col @ 1
        else
            col @ col + 1
        i @ i + 1

    return Position(line: line, col: col)

## Distances, which is what adjacency questions actually ask

# How many line ends lie between two offsets, `from` included and `to`
# excluded. Zero means the two offsets are on the same line.
function newlines_between(text: str, from: i64, to: i64) -> i64
    count: i64 @ 0
    i: i64 @ from

    while i < to && i < text.len()
        if text[i] == '\n'
            count @ count + 1
        i @ i + 1

    return count

# The 1-based column of an offset, read BACKWARDS to the line end above it
# — so the cost is the length of one line rather than of the file.
function column_of(text: str, offset: i64) -> i64
    i: i64 @ offset

    if i > text.len()
        i @ text.len()
    col: i64 @ 1

    while i > 0 && text[i - 1] != '\n'
        col @ col + 1
        i @ i - 1

    return col

# How many lines above `decl` the offset `comment` sits. A comment at or
# past the declaration's own offset is on its line or after it, which every
# caller treats as a trailing note rather than documentation.
function lines_above(text: str, comment: i64, decl: i64) -> i64
    if comment >= decl
        return 0
    return newlines_between(text: text, from: comment, to: decl)

## Margins

# Whether `at` begins its line of the text and that line's margin holds a tab.
function margin_has_tab(text: str, at: i64) -> bool
    width = margin_width(text, at: at)

    if width < 0
        return false
    i: i64 @ at - width

    while i < at
        if text[i] == '\t'
            return true
        i @ i + 1

    return false

# The width of the blank margin of the line that holds byte `at`, wherever on
# its line `at` stands (`parse/unclosed.swallows_the_body`).
function line_margin(text: str, at: i64) -> i64
    start: i64 @ at

    while start > 0 && text[start - 1] != '\n'
        start @ start - 1

    i: i64 @ start

    while i < text.len() && (text[i] == ' ' || text[i] == '\t')
        i @ i + 1

    return i - start

# How many bytes of blank margin stand before `at` on its line, or -1 where
# something else does and `at` does not begin its line.
function margin_width(text: str, at: i64) -> i64
    i: i64 @ at - 1

    while i >= 0 && text[i] != '\n'
        if text[i] != ' ' && text[i] != '\t'
            return -1
        i @ i - 1

    return at - 1 - i

## Where one offset stands, said from another

# Where the byte `at` stands, said from the line of the byte `from` at or
# below it: "at column 9 of this line", "on the line above, at column 9",
# "3 lines above, at column 9". A distance between two offsets of one file
# is true in whichever file of a compilation it is read, where a line counted
# from the joined text's first byte would name the first file's line (panel
# 187's R6). The column counts characters, as a caret does (`source.line_col`).
function place_above(text: str, at: i64, from: i64) -> str
    start = at - column_of(text, at) + 1
    column = "column " + (text.slice(from: start, to: at).chars().len() + 1).to_str()
    above = newlines_between(text: text, from: at, to: from)

    if above == 0
        return "at " + column + " of this line"

    if above == 1
        return "on the line above, at " + column
    return above.to_str() + " lines above, at " + column

test "line and column are 1-based and count the newline"
    text = "ab\ncd"
    assert line_col(text, 0).line == 1
    assert line_col(text, 0).col == 1
    assert line_col(text, 1).col == 2
    assert line_col(text, 3).line == 2
    assert line_col(text, 3).col == 1

test "the local readings agree with the walk from byte zero, at every offset"
    # THE PREMISE THE REPAIR RESTS ON, given a test that fires the day it
    # dies (CLAUDE.md §11). The cheap readings are correct only because they
    # answer what the expensive walk answered. Every offset of a text with a
    # leading newline, an empty line and a trailing one is checked, so the
    # agreement is a measurement rather than a sentence.
    text = "\nab\n\ncdef\n"
    i: i64 @ 0

    while i <= text.len()
        assert column_of(text, i) == line_col(text, i).col
        assert newlines_between(text: text, from: 0, to: i) == line_col(text, i).line - 1
        i @ i + 1

test "lines above is a distance, and a comment at or past the declaration is none"
    text = "# far\n\n# near\nfunction f()\n"

    # `# near` starts at 7 and `function` at 14: one line end between them,
    # which is the only distance a doc comment may have.
    assert lines_above(text: text, comment: 7, decl: 14) == 1

    # `# far` at 0 is THREE line ends up, not two — the blank line counts,
    # and it is exactly the blank line that makes it not documentation.
    assert lines_above(text: text, comment: 0, decl: 14) == 3

    # A trailing note sits at or past the declaration's own offset.
    assert lines_above(text: text, comment: 14, decl: 14) == 0
    assert lines_above(text: text, comment: 20, decl: 14) == 0

test "a place above is a distance in lines, its column counted in characters"
    # Same line, the line above, three lines above across a blank line.
    assert place_above("ab[c)", at: 2, from: 4) == "at column 3 of this line"
    assert place_above("a[\nb)", at: 1, from: 4) == "on the line above, at column 2"
    assert place_above("  [\n1\n\nb)", at: 2, from: 8) == "3 lines above, at column 3"

    # `é` is two bytes and one character, and a caret counts characters.
    assert place_above("é[\n)", at: 2, from: 4) == "on the line above, at column 2"

test "a margin is measured to the line's start, and a tab in it is seen"
    text = "a\n    b\n\tc\n  x y\n"
    assert margin_width(text, at: 0) == 0
    assert margin_width(text, at: 6) == 4
    assert !margin_has_tab(text, at: 6)
    assert margin_width(text, at: 9) == 1
    assert margin_has_tab(text, at: 9)

    # `y` does not begin its line.
    assert margin_width(text, at: 15) == -1
    assert !margin_has_tab(text, at: 15)
