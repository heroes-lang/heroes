# What the `@` a marked parameter asks of a call site can stand before
# (design.md §4.8; spec § 9: the callee works on the caller's place
# itself).
#
# A marked argument is a place the call writes into, so the `@` it owes
# stands only before a place whose root the program may write: a cell, or an
# `@` parameter. Asked of the argument in hand, its root's binding as the
# resolver recorded it (defect 135, the certain-fix audit's C8): `bump(k)`
# over `k = Counter(n: 0)` took a certain `@k`, refused anew as
# `not_mutable`, and `bump(Counter(n: 0))` took `@Counter(…)`, refused as
# `not_a_place`; a loop variable, a plain parameter, a payload and a constant
# did the same. `data_errors.marker_mismatch` offers the `@` only where it can
# stand, and says what answers elsewhere.
#
# AND WHAT IT ASKS OF A VALUE: nothing can carry it (defect 398). A function
# type has no `@` — `(function(@Box) -> ())` is `expected_type` at the `@`,
# measured since panel 109 — so a function with a marked parameter has no
# value at all, and an `@` at a call through a value marks an argument no
# value changes. Both were `check` 0 and then clang's refusal of `void
# (int64_t *)` as `void (*)(int64_t)`, an internal error at exit 2.

use ast
use check/kept_cells
use check/leasing
use check/state
use check/table
use data_errors
use diag
use resolved
use source
use token

# Why the argument cannot take the `@`, empty where it can. The words follow
# `not_mutable`'s, the refusal the `@` alone would earn, one per binding; the
# `@` is quoted before the argument as written, `@h.inner`, and the binding
# named is its root, `h`, the one that must change.
function blocked(a: ast.Ast, r: resolved.Resolved, s: source.Source, value: i64) -> str
    root = leasing.place_root(a, at: value)

    if root.is_err()
        return "`@` stands before a place the call writes back into, a name, a field or an element, and this is a value: bind it to a cell first, `x: <type> @= …`, and pass `@x`"
    name = source.span_text(s, a.exprs[root.must()].span)
    marked = "`@" + source.span_text(s, a.exprs[value].span) + "`"

    match r.uses[root.must()]
        .local l =>
            one = r.locals[l.at]

            if one.mutable
                return ""

            return match one.kind
                .param => "`" + name + "` is a parameter without `@`, so " + marked + " would be refused: mark it `@" + name + "` in the signature too, and at every call"
                .loop_var => "`" + name + "` is the loop variable, bound afresh for each element, so " + marked + " would be refused: pass a cell declared outside the loop"
                .payload => "`" + name + "` is bound by the pattern, so " + marked + " would be refused: bind what you need with `@` outside the `match`"
                .bind | .cell => "`" + name + "` was bound with `=`, which binds once, so " + marked + " would be refused: declare it a cell, `" + name + " @= <value>`, and pass " + marked
        .top | .module | .builtin | .unresolved => return "`" + name + "` is no cell, and there are no mutable globals: pass a cell declared with `@=`"

    return ""

# Whether the function a name stands for as a VALUE marks a parameter `@`,
# told where it stands; `true` is a refusal, and the name's type is then the
# error type, so the call or the binding it reaches says nothing more. The
# first marked parameter is named: one is enough to have no value. The
# function is named as written, `helper.bump` where a module qualifies it.
function refused_as_value(@c: state.Checker, s: source.Source, decls: [ast.Decl], decl: i64, span: token.Span) -> bool
    match decls[decl].kind
        .function_decl fd =>
            # A function of the program is a value of the type its signature
            # writes, each mode with it (panel 261); an `extern`'s `@` is a
            # cell C writes and its `lent` panel 171's, which no Heroes value
            # carries across.
            if !fd.value.is_extern
                return false

            for p in fd.value.params
                if p.mutable
                    state.push_diagnostic(
                        @c,
                        data_errors.mutable_parameter_as_value(name: source.span_text(s, span), param: source.span_text(s, p.name), span: span)
                    )
                    return true

                # A parameter lent read-only is handed a place, which no
                # function type carries either (panel 217's R2).
                if p.lent && !p.mutable && (!fd.value.is_extern || !pointer_crossed(c, p))
                    state.push_diagnostic(
                        @c,
                        data_errors.lent_parameter_as_value(name: source.span_text(s, span), param: source.span_text(s, p.name), span: span)
                    )
                    return true
        .constant_decl | .record_decl | .variant_decl | .test_decl => return false

    return false

# A `cstr` or a `ptr`, whose `lent` on an `extern` is panel 171's: the
# pointer crosses by value.
function pointer_crossed(c: state.Checker, p: ast.Param) -> bool
    written = state.written_type(c.out, p.ty)

    if written.is_err()
        return false
    kind = table.get(c.out.types, written.must())
    return kind == .cstr || kind == .ptr

# §4.8: UFCS does not apply when the first parameter is `@` (spec § 9),
# because `l.advance()` would hide the mutation the marker exists to show.
# Out of `check/walk.hero` with defect 629, whose dotted call paid for its
# line here; `check/self_call.hero` asks it too.
function ufcs_hides_the_marker(decls: [ast.Decl], decl: i64) -> bool
    return match decls[decl].kind
        .function_decl fd => fd.value.params.len() > 0 && fd.value.params[0].mutable
        .constant_decl | .record_decl | .variant_decl | .test_decl => false

# An argument of a call through a function value against its position's
# mode (panel 261): the TYPE decides as a declaration does by name, so an `@`
# is owed exactly where the type carries one, and refused elsewhere.
function through_a_value(@c: state.Checker, a: ast.Ast, r: resolved.Resolved, s: source.Source, arg: ast.Arg, mode: str, callee: str)
    wants = mode == "@"

    # A cell handed bare where the type asks `@` is one the certain `@`
    # re-binds, so its never-re-bound verdict, left here by the resolver
    # (`resolve/value_calls.hero`), is not told.
    if wants && !arg.mutable
        kept_cells.keep_root(@c, a, r, value: arg.value)

    # The rule of the left of `@`, which the resolver asks of a call by name
    # (`resolve/writes.inout_root`) and sets aside for a value, whose type it
    # cannot read: an `@` the type takes stands only before a cell or an `@`
    # parameter, or the callee would write a binding, a loop variable or a
    # by-value parameter in place (measured: a heap abort, exit 134).
    if arg.mutable && wants
        why = blocked(a, r, s, arg.value)

        if why.len() > 0
            state.push_diagnostic(
                @c,
                diag.new_diagnostic(code: "not_mutable", message: why, span: a.exprs[arg.value].span)
            )

    if arg.mutable != wants
        state.push_diagnostic(
            @c,
            data_errors.marker_mismatch(name: callee, wants: wants, blocked: blocked(a, r, s, arg.value), span: a.exprs[arg.value].span)
        )
