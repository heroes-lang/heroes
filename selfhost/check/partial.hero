# What a PARTIAL record may not do, and how far the refusal reaches
# (spec § FFI; panel 061, ratified 2026-08-15).
# Port of archive/bootstrap-rs/heroes/src/types/partial.rs.
#
# A group's record marked `partial` names some of the header's struct.
# Every operation that COPIES the value is safe at any size (124 of 124
# unnamed bytes survived a full round trip, measured). What is refused is
# the three operations that READ the fields: `==` (structural, and the
# generated walk reads a field list that is not the struct), `hash` (must
# agree with `==` or a map breaks), and a map key (`hash` reached from a
# place the author wrote no operator at).
#
# Construction is permitted, and that is a decision rather than an
# omission: refusing it deletes the only expression that produces an
# SDL_Event, and it buys no safety — the zero-fill is deterministic, and
# the identical SEGV is reachable from a COMPLETE binding whose ptr field
# is nullptr.
#
# The reach is TRANSITIVE for comparison ([Font] == [Font] reaches
# Font_eq through hero_array_eq — four routes, all measured firing) and
# per-declaration for construction.

use ast
use parse
use resolved
use check/table
use check/state

# Is this declaration a record its group marked `partial`?
function is_partial(decls: [ast.Decl], decl: i64) -> bool
    return match decls[decl].kind
        .record_decl r                                               => r.partial
        .constant_decl | .function_decl | .variant_decl | .test_decl => false

# The partial record this type REACHES, if any — itself, or one inside
# it. Descends [T], {K: V}, T?, a record's fields and a VARIANT CASE's
# fields, because each is a route by which the generated _eq or _hash of
# the inner type is called; the variant case is the one a list of
# container kinds would have missed. Returns the DECLARATION reached
# rather than a boolean, so the diagnostic can name it (§4.17).
function reaches(c: state.Checker, decls: [ast.Decl], ty: i64) -> i64?
    seen: {i64: bool} @ {}
    return reaches_within(c, decls, ty: ty, @seen)

# **THE BOUND WAS `depth > 16` UNTIL 2026-09-16 AND THAT WAS DEFECT 046**
# (panel 156's convening measurement; panel 155 R4 filed it). The sentence
# above it said the bound was *what makes the walk total*, and it was —
# by GIVING UP. A chain of records 16 deep ending in a `partial` was
# `check` 0 where 15 deep was `check` 1, with no generic anywhere near
# it, so `spec § 13`'s promise *for it and for any value holding it* held
# to a depth and not to a value. `check/map_keys.hero`'s float twin
# carried the identical line and the identical hole, and this is defect
# 035's shape for the third time.
#
# What replaces it is what `check/reaches.hero` already uses, so the
# compiler now answers this question one way: a set of the type ids
# already walked. It is total without giving up — the arena is finite and
# every id is entered once — and it is why the cyclic-generic worry the
# old comment named is answered rather than bounded. A type already
# walked returned absence then and returns it now, so the memo is
# correct as well as terminating.
function reaches_within(c: state.Checker, decls: [ast.Decl], ty: i64, @seen: {i64: bool}) -> i64?
    if !seen[ty].is_err()
        return fail(code: "absent", msg: "this type was already walked")
    seen[ty] @ true

    match table.get(c.out.types, ty)
        .named n =>
            if is_partial(decls, n.decl)
                return ok(n.decl)

            match decls[n.decl].kind
                .record_decl r =>
                    for field in r.fields
                        found = through_field(c, decls, field_ty: field.ty, @seen)

                        if !found.is_err()
                            return found
                .variant_decl v =>
                    for one_case in v.cases
                        for field in one_case.fields
                            found = through_field(c, decls, field_ty: field.ty, @seen)

                            if !found.is_err()
                                return found
                .constant_decl | .function_decl | .test_decl => return fail(
                    code: "absent",
                    msg: "not a data declaration"
                )

            return fail(code: "absent", msg: "no partial inside")
        .array a    => return reaches_within(c, decls, ty: a.element, @seen)
        .fallible o => return reaches_within(c, decls, ty: o.payload, @seen)
        .map m =>
            in_key = reaches_within(c, decls, ty: m.key, @seen)

            if !in_key.is_err()
                return in_key
            return reaches_within(c, decls, ty: m.value, @seen)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr => return fail(
            code: "absent",
            msg: "a scalar reaches nothing"
        )
        .unit | .fixed | .function_ty | .case_ty | .failure | .generic | .error => return fail(
            code: "absent",
            msg: "this shape reaches nothing"
        )

    return fail(code: "absent", msg: "unreached")

function through_field(c: state.Checker, decls: [ast.Decl], field_ty: i64, @seen: {i64: bool}) -> i64?
    written = state.written_type(c.out, field_ty)

    if written.is_err()
        return fail(code: "absent", msg: "the field's type was never lowered")
    return reaches_within(c, decls, ty: written.must(), @seen)

## Tests

test "the reach is transitive through array, fallible and map"
    p = parse.parse("extern \"s.h\"\n    record Font partial\n        size: i64\n")
    r: resolved.Resolved @ resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    font = table.intern(@c.out.types, .named(decl: 0))
    assert reaches(c, p.decls, font).must() == 0
    xs = table.intern(@c.out.types, .array(element: font))
    assert reaches(c, p.decls, xs).must() == 0
    maybe = table.intern(@c.out.types, .fallible(payload: font))
    assert reaches(c, p.decls, maybe).must() == 0
    keyed = table.intern(@c.out.types, .map(key: table.str_ty(c.out.types), value: font))
    assert reaches(c, p.decls, keyed).must() == 0
    plain = table.intern(@c.out.types, .array(element: table.int_ty_id(c.out.types)))
    assert reaches(c, p.decls, plain).is_err()
