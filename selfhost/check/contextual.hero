# Which expressions have no type of their own (design.md §4.5; spec §
# Types; panels 023, 042, 053, 060).
# Port of archive/bootstrap-rs/heroes/src/types/contextual.rs — the one list both of
# §4.5's modes need first: is this form ⇐-only? Listed in one place
# precisely so every rule agrees what the list is; two readings of it
# would be two languages, and for one day on the Rust side they were.
#
# Two facts, and the second is the one that gets rediscovered:
# - a `.case`, a `???` and an empty literal have NO TYPE AT ALL, so an
#   expectation is the only information there is and they adopt anything;
# - a NUMBER literal is ⇐-only too — that is what makes eight widths
#   usable rather than merely present, since `255` has a value but no
#   width — but it does NOT adopt anything, because it already has a
#   value. Offering an f64 to an integer literal is how `1 + 2.0` stops
#   being an error, a defect fixed three times.
#
# Port note, and it is the probe's own prophecy landing: Rust's
# literal_value returns i128 — wide enough for u64's top and i64's
# bottom at once. Heroes has no i128, and the probe journal wrote where
# the answer would live: "u64 holds every literal a program can write,
# and the signed lower bound moves to where negation lives — the checker
# port". Here it is: a value is a SIGN and a u64 MAGNITUDE, and every
# width check reads the pair.

use token
use ast
use source
use resolved
use digits
use escape
use check/table
use check/state

# True where an expression has no type of its own and must be checked
# against one — §4.5's ⇐-only forms.
function contextual(a: ast.Ast, id: i64) -> bool
    return match a.exprs[id].kind
        .variant_case | .hole => true
        .array elements       => elements.elements.len() == 0
        .map entries          => entries.entries.len() == 0
        # `nullptr` joined at panel 053, for the reason the other members
        # share: the value exists and the TYPE does not — C's null inhabits
        # `ptr` and `cstr` alike, so fixing it at `ptr` made `v == nullptr`
        # unwritable for a `cstr`.

        .null_ptr                                                     => true
        .int_lit | .char_lit | .float_lit | .unary                    => number_literal(a, id) || float_literal(a, id)
        .str_lit | .bool_lit | .name | .binary | .field | .index      => false
        .call | .method | .try_expr | .if_expr | .match_expr | .error => false

# Whether this expression IS a number literal, sign included. `-128` is
# unary minus applied to `128`, so the sign has to be read with the
# digits: `128` does not fit an `i8` on its own and `-128` does. And the
# recursion is the whole predicate — `-x` is not a literal, because
# nothing under the minus is one. Two rules read that question flatly and
# both were wrong the same way (fixedbugs 2026-08-13): `x @ -x` on an f64
# was "expected f64, found i64".
function number_literal(a: ast.Ast, id: i64) -> bool
    return match a.exprs[id].kind
        .int_lit | .char_lit => true
        .unary u =>
            if u.op == .neg
                number_literal(a, u.operand)
            else
                false
        .float_lit | .str_lit | .bool_lit | .null_ptr | .name | .hole => false
        .binary | .field | .index | .call | .method | .variant_case   => false
        .array | .map | .try_expr | .if_expr | .match_expr | .error   => false

# The same question for a FLOAT literal, which f32 made a real one (panel
# 060). Separate from number_literal rather than folded in, and the
# separation is the whole point: the two adopt DISJOINT sets — folding
# them would make each adopt the other's widths, which is how the integer
# half acquired that bug in the first hour it existed.
function float_literal(a: ast.Ast, id: i64) -> bool
    return match a.exprs[id].kind
        .float_lit => true
        .unary u =>
            if u.op == .neg
                float_literal(a, u.operand)
            else
                false
        .int_lit | .char_lit | .str_lit | .bool_lit | .null_ptr | .name             => false
        .hole | .binary | .field | .index | .call | .method                         => false
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error => false

# Whether a contextual expression will actually take the type offered.
# A number literal adopts an integer width and nothing else — without
# this, `1.5 & 1` produced TWO diagnostics. A float literal adopts a
# float width and nothing else, disjoint by construction. `nullptr`
# adopts a pointer and nothing else. The other contextual forms adopt
# anything: they have no type at all, so the expectation is the only
# information there is.
function adopts(c: state.Checker, a: ast.Ast, id: i64, offered: i64) -> bool
    if number_literal(a, id)
        return match table.get(c.out.types, offered)
            .int_ty                                                  => true
            .float_ty | .bool | .str | .ptr | .cstr | .unit | .array => false
            .fixed | .map | .fallible | .function_ty | .named        => false
            .case_ty | .failure | .generic | .error                  => false

    if float_literal(a, id)
        return match table.get(c.out.types, offered)
            .float_ty                                              => true
            .int_ty | .bool | .str | .ptr | .cstr | .unit | .array => false
            .fixed | .map | .fallible | .function_ty | .named      => false
            .case_ty | .failure | .generic | .error                => false

    is_null = match a.exprs[id].kind
        .null_ptr                                                                   => true
        .int_lit | .char_lit | .float_lit | .str_lit | .bool_lit | .name            => false
        .hole | .unary | .binary | .field | .index | .call | .method                => false
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error => false

    if is_null
        return match table.get(c.out.types, offered)
            .ptr | .cstr                                        => true
            .int_ty | .float_ty | .bool | .str | .unit | .array => false
            .fixed | .map | .fallible | .function_ty | .named   => false
            .case_ty | .failure | .generic | .error             => false
    return true

## The value a literal denotes

# A sign and a u64 magnitude — wide enough for every width's top and
# bottom at once, which is what Rust's i128 bought. The sign is folded in
# HERE rather than checked separately: `-128` fits an `i8` and `128` does
# not, so a check that saw them one at a time would refuse the only way
# to write that type's lowest value.
record LitValue
    negative: bool
    magnitude: u64

function literal_value(a: ast.Ast, s: source.Source, id: i64) -> LitValue?
    span = a.exprs[id].span

    match a.exprs[id].kind
        .int_lit =>
            decoded = digits.decode_u64(digits.canonical_int(source.span_text(s, span)))

            if decoded.is_err()
                return fail("no_value", "the literal does not fit a u64, and the lexer said so")
            return ok(LitValue(negative: false, magnitude: decoded.must()))
        # §4.3: a character literal IS a number, and its value is one ASCII
        # character — so it fits every width and needs no special range.

        .char_lit =>
            text = escape.unescape(source.span_text(s, span))

            if text.len() == 0
                return fail("no_value", "an empty character literal was already reported")
            return ok(LitValue(negative: false, magnitude: text[0].to_u64().must()))
        .unary u =>
            if u.op != .neg
                return fail("no_value", "not a literal")
            inner = literal_value(a, s, u.operand)

            if inner.is_err()
                return inner
            flipped = inner.must()
            return ok(LitValue(negative: !flipped.negative, magnitude: flipped.magnitude))
        .float_lit | .str_lit | .bool_lit | .null_ptr | .name | .hole => return fail("no_value", "not a number literal")
        .binary | .field | .index | .call | .method | .variant_case   => return fail("no_value", "not a literal")
        .array | .map | .try_expr | .if_expr | .match_expr | .error   => return fail("no_value", "not a literal")

    return fail("no_value", "unreached")

## Tests

function lit(@a: ast.Ast, kind: ast.ExprKind, start: i64, end: i64) -> i64
    return ast.push_expr(@a.exprs, ast.Expr(kind: kind, span: token.Span(start: start, end: end)))

test "the sign travels with the digits, and the pair holds every width"
    #        0123456789012345678901234567890
    # text: "128 18446744073709551615 'a'"
    s = source.new_source(name: "t.hero", text: "128 18446744073709551615 'a'\n")
    a: ast.Ast @ ast.new_ast()
    small = lit(@a, kind: .int_lit, start: 0, end: 3)
    negated = ast.push_expr(
        @a.exprs,
        ast.Expr(kind: .unary(op: .neg, operand: small), span: token.Span(start: 0, end: 3))
    )
    top = lit(@a, kind: .int_lit, start: 4, end: 24)
    ch = lit(@a, kind: .char_lit, start: 25, end: 28)
    plain = literal_value(a, s, small).must()
    assert !plain.negative && plain.magnitude == 128
    minus = literal_value(a, s, negated).must()
    assert minus.negative && minus.magnitude == 128
    wide = literal_value(a, s, top).must()
    assert wide.magnitude == 18446744073709551615
    letter = literal_value(a, s, ch).must()
    assert letter.magnitude == 97

test "number and float literals adopt disjoint width sets"
    s = source.new_source(name: "t.hero", text: "1 1.5\n")
    _ = s
    a: ast.Ast @ ast.new_ast()
    one = lit(@a, kind: .int_lit, start: 0, end: 1)
    half = lit(@a, kind: .float_lit, start: 2, end: 5)
    r: resolved.Resolved @ resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 2)
    u8_id = table.intern(@c.out.types, .int_ty(kind: .u8))
    f32_id = table.intern(@c.out.types, .float_ty(kind: .f32))
    assert adopts(c, a, id: one, offered: u8_id)
    assert !adopts(c, a, id: one, offered: f32_id)
    assert adopts(c, a, id: half, offered: f32_id)
    assert !adopts(c, a, id: half, offered: u8_id)
    assert !adopts(c, a, id: one, offered: table.str_ty(c.out.types))

test "nullptr is contextual between ptr and cstr, and nothing else"
    a: ast.Ast @ ast.new_ast()
    null_id = lit(@a, kind: .null_ptr, start: 0, end: 7)
    assert contextual(a, null_id)
    r: resolved.Resolved @ resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 1)
    cstr_id = table.intern(@c.out.types, .cstr)
    ptr_id = table.intern(@c.out.types, .ptr)
    assert adopts(c, a, id: null_id, offered: cstr_id)
    assert adopts(c, a, id: null_id, offered: ptr_id)
    assert !adopts(c, a, id: null_id, offered: table.str_ty(c.out.types))

test "the empty literals are contextual and the filled ones are not"
    a: ast.Ast @ ast.new_ast()
    none: [i64] = []
    empty = ast.push_expr(@a.exprs, ast.Expr(kind: .array(elements: none), span: token.Span(start: 0, end: 2)))
    one = lit(@a, kind: .int_lit, start: 0, end: 1)
    filled: [i64] = [one]
    full = ast.push_expr(@a.exprs, ast.Expr(kind: .array(elements: filled), span: token.Span(start: 0, end: 3)))
    assert contextual(a, empty)
    assert !contextual(a, full)
    hole = ast.push_expr(@a.exprs, ast.Expr(kind: .hole, span: token.Span(start: 0, end: 3)))
    assert contextual(a, hole)

    # -x is NOT a literal: nothing under the minus is one.
    named = ast.push_expr(@a.exprs, ast.Expr(kind: .name, span: token.Span(start: 0, end: 1)))
    neg_name = ast.push_expr(
        @a.exprs,
        ast.Expr(kind: .unary(op: .neg, operand: named), span: token.Span(start: 0, end: 2))
    )
    assert !number_literal(a, neg_name)
    assert !contextual(a, neg_name)
