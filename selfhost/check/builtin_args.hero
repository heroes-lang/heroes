# What a built-in call's arguments are refused for before they are typed: an
# `@` no built-in but `end_lease` takes, and a count the built-in does not take
# (panel 227's R3, route E, defect 2175; built by the sitting's compiler seat).
#
# `slice(from: 0, to: 5)` is `slice` with nothing to slice. Read label by
# label it was told twice, `builtin_shape` and a `wrong_label` whose guess
# wrote `from:` a second time, because the label at the receiver's position
# is never asked (`check/labels.hero`'s `check_label`) and every label after
# it is read one position off. A declared function given the same call is
# told once, `wrong_arity` with its signature as the note (`check/walk.hero`'s
# `user_call`), so a built-in is told the same way, its shape as the note.

use token
use ast
use diag
use inventory
use value_errors
use data_errors
use check/state

# §4.8's marker, on this side of the table too: ONE built-in takes an @
# parameter — `end_lease(@x)`, which nulls the cell it frees (panel 125) —
# and every other one answers a new value, push a new array, sort a new one,
# so an @ on those is a claim about the call that is false. It went unchecked
# until a spec-only reader guessed otherwise and the failure said nothing
# about the @ (fixedbugs 2026-08-13). Whether the @ is on the RIGHT thing is
# `check/lending.hero`'s question, asked over the whole file.
function marked(@c: state.Checker, name: str, at: bool, span: token.Span)
    if at && name != "end_lease"
        state.push_diagnostic(@c, data_errors.marker_mismatch(name: name, wants: false, blocked: "", span: span))

# Whether the call is refused here, the one message pushed: a built-in with
# one count, called with another, its receiver counted. Its labels are then
# not read, and its arguments are still walked, so a mistake inside one is
# told beside the count.
function refused(@c: state.Checker, name: str, given: [ast.Arg], receiver: bool, span: token.Span) -> bool
    count = inventory.arity_of(name)
    got: i64 @= given.len()

    if receiver
        got @ got + 1

    if count.is_err() || got == count.must()
        return false
    d: diag.Diagnostic @= value_errors.arity(
        name: name,
        expected: count.must(),
        got: got,
        declared: fail(code: "absent", msg: "a built-in has no line to cite"),
        span: span
    )
    entry = inventory.labelled_of(name)

    if !entry.is_err() && entry.must().params[0].len() == 0
        d.notes @ d.notes.push(shape(name, entry.must().params))
    state.push_diagnostic(@c, d)
    return true

# The call's shape, read from the built-in's labels: the value first, before
# the dot or as the first argument, then each labelled position.
function shape(name: str, params: [str]) -> str
    rest: [str] @= []
    letters = "abcdefgh"
    i: i64 @= 1

    while i < params.len()
        rest @ rest.push(params[i] + ": " + letters.slice(from: i - 1, to: i))
        i @ i + 1

    bounds = rest.join(", ")
    return "`" + name + "` is called `xs." + name + "(" + bounds + ")` or `" + name + "(xs, " + bounds + ")`, the value it works on first"

## Tests

test "slice's shape names the value first and both bounds"
    params = inventory.labelled_of("slice").must().params
    assert shape("slice", params) == "`slice` is called `xs.slice(from: a, to: b)` or `slice(xs, from: a, to: b)`, the value it works on first"
