# What `sort` can order, and how the refusal explains itself (spec §
# Strings, arrays, maps; panel 068 R2, ratified 2026-08-16; panel 084).
# Port of archive/bootstrap-rs/heroes/src/types/ordering.rs.
#
# THE RULE: `sort` orders an array whose element is one of twelve types —
# the eight integer widths, the two floats, `str`, and `bool`. The set is
# the rows the runtime's comparator dispatches on, and the two questions
# come apart in both directions: `str` has NO `<` in the surface and
# sorts; a record could be given a `<` and still have no order the
# compiler may invent (it may hold a map, or a function value whose
# address comparison the linker decides — the nondeterminism the fixpoint
# exists to exclude).
#
# The refusal lives in the CHECKER because panel 068 moved it: it used to
# be the emitter's, so `heroes check` said a program was fine and `heroes
# build` refused it — a program the checker accepts must build. And
# `generic` came OFF the exempt list at panel 084: `sort` on an
# unconstrained type parameter was the single outlier among restricted
# built-ins, the one row where check passed and build died.
#
# The descent is check_partial's, for the same reason: a reader handed
# "`[Line]` is none of those" about a record they believe is made of
# numbers has been told the verdict and not the cause. The walk is for
# the NOTE, never for the verdict.

use ast
use source
use parse
use resolve
use check/lower
use check/table
use check/state

# The twelve. Total on Ty by construction: every other case falls through.
function is_ordered(c: state.Checker, ty: i64) -> bool
    return match table.get(c.out.types, ty)
        .int_ty | .float_ty | .str | .bool            => true
        .ptr | .cstr | .unit | .array | .fixed | .map => false
        .fallible | .function_ty | .named | .case_ty  => false
        .failure | .generic | .error                  => false

# Whether this element type is one the checker may REFUSE — narrower than
# whether it is ordered: an error's diagnostic was already reported (one
# mistake, one message), and since panel 084 that is the ONLY exemption.
function is_refusable(c: state.Checker, ty: i64) -> bool
    if is_ordered(c, ty)
        return false
    return table.get(c.out.types, ty) != .error

# What inside this type has no order, phrased for a note — absent when
# the type is not a record or variant, in which case the type's own name
# is the whole answer: "`[[i64]]` is none of those" leaves nothing to
# explain, while a record is the case where the reader is looking at a
# name and cannot see what is inside it.
function why_unordered(c: state.Checker, s: source.Source, decls: [ast.Decl], ty: i64) -> str?
    is_named = match table.get(c.out.types, ty)
        .named                                                    => true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => false
        .array | .fixed | .map | .fallible | .function_ty         => false
        .case_ty | .failure | .generic | .error                   => false

    if !is_named
        return fail("absent", "the type's own name is the whole answer")
    return within(c, s, decls, ty: ty, depth: 0)

# The recursion, bounded exactly as the partial walk is bounded and for
# the same reason. The fallback at depth is absence, which HERE is the
# safe direction and not the loud one — losing the note costs a sentence,
# while losing the verdict would let a program through. The verdict is
# is_ordered's and never this walk's.
function within(c: state.Checker, s: source.Source, decls: [ast.Decl], ty: i64, depth: i64) -> str?
    if depth > 16
        return fail("absent", "past any nesting worth naming")

    match table.get(c.out.types, ty)
        # The three that are the answer wherever they are found: addresses
        # are the linker's answer, and a map's order is the order of a
        # walk nobody has fixed.
        .map         => return ok("a map")
        .function_ty => return ok("a function value")
        .ptr | .cstr => return ok("a pointer")
        .named n =>
            name = source.span_text(s, decls[n.decl].name)
            return dotted_path(c, s, decls, prefix: name, decl: n.decl, depth: depth)
        .array                                  => return ok("an array")
        .fixed                                  => return ok("a fixed array")
        .fallible                               => return ok("a fallible value")
        .unit                                   => return ok("`()`")
        .int_ty | .float_ty | .bool | .str      => return fail("absent", "ordered, nothing to explain")
        .case_ty | .failure | .generic | .error => return fail("absent", "no note for this shape")

    return fail("absent", "unreached")

# The first member of this declaration with no order, as ONE dotted path
# and ONE description — "`Line.inner.m` is a map". The path is threaded
# DOWN rather than assembled on the way back up, and that is not a style
# choice: composing on the return produced "`Line.inner` is `Inner.m` is
# a map" on the first nested case tried — two subjects, no path.
function dotted_path(c: state.Checker, s: source.Source, decls: [ast.Decl], prefix: str, decl: i64, depth: i64) -> str?
    if depth > 16
        return fail("absent", "past any nesting worth naming")

    match decls[decl].kind
        .record_decl rec => return first_unordered(c, s, decls, prefix: prefix, fields: rec.fields, depth: depth)
        # A case payload is not a container in the surface language, which
        # is exactly why a list of container kinds would miss it.

        .variant_decl v =>
            for one_case in v.cases
                found = first_unordered(c, s, decls, prefix: prefix, fields: one_case.fields, depth: depth)

                if !found.is_err()
                    return found

            return fail("absent", "every payload is ordered")
        .constant_decl | .function_decl | .test_decl => return fail("absent", "not a data declaration")

    return fail("absent", "unreached")

function first_unordered(c: state.Checker, s: source.Source, decls: [ast.Decl], prefix: str, fields: [ast.Field], depth: i64) -> str?
    for field in fields
        written = state.written_type(c.out, field.ty)

        if written.is_err()
            continue
        field_ty = written.must()

        if is_ordered(c, field_ty)
            continue
        here = prefix + "." + source.span_text(s, field.name)

        # A record or variant field: keep descending under the longer
        # path, so the note ends at a field the reader can actually
        # change; if every field of it is ordered, the record ITSELF is
        # the cause — there is nothing further in to name.
        inner_decl: i64 @ -1

        match table.get(c.out.types, field_ty)
            .named inner                                              => inner_decl @ inner.decl
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => inner_decl @ -1
            .array | .fixed | .map | .fallible | .function_ty         => inner_decl @ -1
            .case_ty | .failure | .generic | .error                   => inner_decl @ -1

        if inner_decl >= 0
            deeper = dotted_path(c, s, decls, prefix: here, decl: inner_decl, depth: depth + 1)

            if !deeper.is_err()
                return deeper
            return ok("`" + here + "` is `" + state.show(c, s, decls, field_ty) + "`, a record")
        described = within(c, s, decls, ty: field_ty, depth: depth + 1)

        if !described.is_err()
            return ok("`" + here + "` is " + described.must())
        return ok("`" + here + "` is `" + state.show(c, s, decls, field_ty) + "`")

    return fail("absent", "every field is ordered")

## Tests

function lowered(text: str) -> state.Checker
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checker @ state.new_checker(out_of: out, expr_count: p.tree.exprs.len())
    i: i64 @ 0

    while i < p.tree.types.len()
        _ = lower.lower_ty(@c, p.tree, out, i)
        i @ i + 1

    return c

test "the twelve are ordered, and only the reported error is exempt"
    c = lowered("record P\n    x: i64\n")
    assert is_ordered(c, table.int_ty_id(c.out.types))
    assert is_ordered(c, table.str_ty(c.out.types))
    assert is_ordered(c, table.bool_ty(c.out.types))
    c2: state.Checker @ c
    u8_id = table.intern(@c2.out.types, .int_ty(kind: .u8))
    assert is_ordered(c2, u8_id)
    xs = table.intern(@c2.out.types, .array(element: table.int_ty_id(c2.out.types)))
    assert !is_ordered(c2, xs)
    assert is_refusable(c2, xs)
    assert !is_refusable(c2, table.error_ty(c2.out.types))

    # Panel 084: a type parameter is refusable — the outlier row is closed.
    a_param = table.intern(@c2.out.types, .generic(at: 0))
    assert is_refusable(c2, a_param)

test "the note threads one dotted path down to the cause"
    text = "record Inner\n    m: {str: i64}\n\nrecord Line\n    inner: Inner\n    n: i64\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checker @ state.new_checker(out_of: out, expr_count: p.tree.exprs.len())
    i: i64 @ 0

    while i < p.tree.types.len()
        _ = lower.lower_ty(@c, p.tree, out, i)
        i @ i + 1

    line_ty = table.intern(@c.out.types, .named(decl: 1))
    note = why_unordered(c, s, p.decls, ty: line_ty)
    assert note.must() == "`Line.inner.m` is a map"

    # A record of numbers has no note: the name is the whole answer.
    flat = table.intern(@c.out.types, .named(decl: 0))
    _ = flat
    only_numbers = lowered("record P\n    x: i64\n    y: i64\n")
    p2 = parse.parse("record P\n    x: i64\n    y: i64\n")
    s2 = source.new_source(name: "t.hero", text: "record P\n    x: i64\n    y: i64\n")
    c3: state.Checker @ only_numbers
    p_ty = table.intern(@c3.out.types, .named(decl: 0))
    assert why_unordered(c3, s2, p2.decls, ty: p_ty).is_err()

    # And a bare array is not a record: no note, the type prints whole.
    c4: state.Checker @ c3
    xs = table.intern(@c4.out.types, .array(element: table.int_ty_id(c4.out.types)))
    assert why_unordered(c4, s2, p2.decls, ty: xs).is_err()
