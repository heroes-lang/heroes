# Whether one function type may stand where another is expected, and which
# positions of a parameter run share a type: the relation §4.9 asks of two
# function types, since defect 026 and panels 128 to 130 (design.md §4.9).
#
# Out of `check/table.hero` on 2026-10-07 (defect 259), when the entries that
# answer `poisoned` in one read would have taken the table past the 389 lines
# `tests/harness/suite_layout.hero` decided for it. The seam is the concern:
# the table interns a type and answers what it IS, and this file relates two
# of them. It uses the table, and nothing in the table uses it.

use check/table

# Whether a value of type `got` may stand where `wanted` is expected. It is an
# ID COMPARISON in every case but TWO, and both are the same idea said at two
# scales: a name that is not there fits whatever the expected type calls that
# position. One is a parameter a declaration called `_`, which says the body
# ignores that position and makes no claim about it. The other is a type that
# carries NO run of names at all, which is every declared function with no two
# parameters of one type — and refusing THAT made a written type naming a
# position nothing can confuse uninhabited by any function in the language
# (panel 130's spec-warden, which built its own compiler and ran the program
# rather than reading for it).
#
# **It is a widening, and the word is used on purpose**: panel 129's compiler
# seat named widening as what this route was supposed to avoid, and two of them
# are here. Both are blanks being filled rather than types being related, so the
# answer is still an id comparison at the end — but a reader who is told
# otherwise would be told something false. Nothing else is relaxed — the parameter types, the
# result and every name that IS written still have to be equal — and the answer
# stays an id comparison, because the blanks are filled in and the type is
# interned again rather than a second notion of sameness entering the checker.
#
# Panel 129's ffi seat is why this exists. `plain_free(_: ptr, address: ptr)`
# and `pooled_free(opaque: ptr, address: ptr)` are two implementations of zlib's
# one `free_func`, and refusing the first would have made the rule refuse what a
# C callback does for a living.
function fits(@t: table.Types, wanted: i64, got: i64) -> bool
    if wanted == got
        return true
    wl: [str] @ []

    match table.get(t, wanted)
        .function_ty w                                            => wl @ table.labels_of(t, w.labels)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .array | .fixed | .map | .fallible | .named | .case_ty    => return false
        .failure | .generic | .error                              => return false

    if wl.len() == 0
        return false
    filled: [str] @ []
    spelled: [i64] @ []
    result: i64 @ 0

    match table.get(t, got)
        .function_ty g =>
            gl = table.labels_of(t, g.labels)

            # A run of the wrong LENGTH is a different shape and not a blank; a
            # run of length ZERO is a type that names nothing anywhere, which is
            # every declared function with no two parameters of one type
            # (`check/labels.hero`'s `declared_labels`). Refusing that made every
            # written type carrying a name at a position nothing can confuse
            # UNINHABITED — panel 130's spec-warden, which built its own compiler
            # and ran `(function(item: i64) -> i64)` rather than reading for it.
            if gl.len() != wl.len() && gl.len() != 0
                return false
            spelled @ table.params_of(t, g.params)
            result @ g.result
            i: i64 @ 0

            while i < wl.len()
                if i >= gl.len() || gl[i].len() == 0
                    filled @ filled.push(wl[i])
                else
                    filled @ filled.push(gl[i])
                i @ i + 1
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .array | .fixed | .map | .fallible | .named | .case_ty    => return false
        .failure | .generic | .error                              => return false

    return table.intern_function(@t, spelled, filled, result: result) == wanted

# Whether `a` and `b` are one function type but for the names of its
# parameters, where the nameless one is a type the program WROTE with two
# positions of one type (defect 554). `check/type_labels.hero` refuses that
# type where it is written, `needs_parameter_names`, so the mismatch between
# the two is that refusal's shadow, a second message for one mistake (§4.5):
# `g: (function(i64, i64) -> i64) = add` was told both, and so was every
# place the value of `g` met a named one. A pair that differs in a parameter's
# type or in the result is a mistake of its own and is still told, and so is
# a nameless type nothing wrote, one a generic's letters made, which nothing
# refuses. Asked only where a mismatch is about to be said, so the walk over
# `written` costs a refused program alone.
function unnamed_shadow(t: table.Types, written: {i64: i64}, a: i64, b: i64) -> bool
    return names_alone(t, written, nameless: a, named: b) || names_alone(t, written, nameless: b, named: a)

function names_alone(t: table.Types, written: {i64: i64}, nameless: i64, named: i64) -> bool
    match table.get(t, nameless)
        .function_ty w =>
            match table.get(t, named)
                .function_ty g =>
                    ws = table.params_of(t, w.params)
                    gs = table.params_of(t, g.params)

                    if table.labels_of(t, w.labels).len() > 0 || table.labels_of(t, g.labels).len() == 0
                        return false

                    if w.result != g.result || ws.len() != gs.len()
                        return false
                    i: i64 @ 0

                    while i < ws.len()
                        if ws[i] != gs[i]
                            return false
                        i @ i + 1

                    shares: bool @ false

                    for one in shared(ws)
                        if one
                            shares @ true

                    if !shares
                        return false

                    # ORDER: none — the walk asks whether any written node's type is
                    # this one, an answer no order of the keys can change.
                    for id in keys(written)
                        if written[id].must() == nameless
                            return true

                    return false
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
                .array | .fixed | .map | .fallible | .named | .case_ty    => return false
                .failure | .generic | .error                              => return false
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .array | .fixed | .map | .fallible | .named | .case_ty    => return false
        .failure | .generic | .error                              => return false

    return false

# Whether each position of a parameter run shares its type with another — the
# single fact §4.9 rests on, since defect 026 for a function TYPE as well as for
# a declaration. The rule that makes a name mandatory in the type
# (`check/type_labels.hero`), the names a declaration's type carries
# (`check/labels.declared_labels`) and the two calls that owe a label, by name
# and through a value (`check/walk.hero`), all ask it HERE, so none can answer
# it differently — and answering per position is what lets a type name the
# two `u64` of `qsort` and leave its `ptr` alone. Each type is counted once,
# so a run costs its length (defect 477): asked of one position against every
# other, n positions cost n times n, and the call by name asked it in a copy
# of its own.
function shared(params: [i64]) -> [bool]
    count: {i64: i64} @ {}

    for p in params
        seen = count[p]

        if seen.is_err()
            count[p] @ 1
        else
            count[p] @ seen.must() + 1

    out: [bool] @ []

    for p in params
        out @ out.push(count[p].must() > 1)

    return out
