# A type, written the way the author would have written it.
# Port of heroes/src/types/render.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# Every mismatch message goes through this, and it prints SURFACE syntax —
# `[{str: Point}?]`, not a tree. design.md §4.17: an error carries what is
# needed to fix the program, and a type spelled in a notation the language
# does not have fails that test.
#
# A `record` or `variant` prints its declared name, which is why this
# needs the declarations: nominal types are names, and the name lives in
# the declaration list.

use source
use ast
use parse
use widths
use resolved
use check/table

# `generics` names the type parameters of the function the message is
# about (§4.12 keeps generics on functions, and a message is always about
# one), so `A` prints as `A`. An empty list is legal and prints `#0`,
# which only happens where a caller outside the checker has no function
# in hand.
#
# **THAT LAST SENTENCE WAS FALSE AND IS DEFECT 021** (panel 120,
# 2026-09-08). `generics` is the letter list of the function the message
# is written FROM, not the one the type came from, so a callee's type
# parameter has no name here — and six lines of ordinary generic code
# reached it: `function id<T>(x: T) -> T` and `join(xs.map(id).map(id))`
# gave *`join` takes `[str]` and `str`, found `[#0]`*. `#0` is an index
# into the checker's own tables and is not a type anyone can write, which
# §4.17 forbids in a message a reader is meant to act on. The premise is
# left above rather than deleted, because what it claimed is why nobody
# looked.
# Who reads a type (defect 2205): the module a message or a hole's report
# stands in, and what that file calls each module it `use`s, by the module's
# whole name. A record or variant of another module is written as that file
# writes it, `lib.Box`, and one of a module the file does not `use` with the
# module path's last part, the name a `use` of it binds; a type of the
# reader's own module or of the library stays bare. `bare_reader` reads
# every type bare, as `render_ty` always did.
record Reader
    module: str
    calls: {str: str}

function bare_reader() -> Reader
    calls: {str: str} = {}
    return Reader(module: "", calls: calls)

# The reader standing in `module`, from what the resolver recorded of the
# `use` lines of that module's file.
function reader_of(r: resolved.Resolved, module: str) -> Reader
    return Reader(module: module, calls: calls_of(r, module: module))

# What `module`'s file calls each module it `use`s, by that module's whole
# name: the resolver's table for the file, turned around.
function calls_of(r: resolved.Resolved, module: str) -> {str: str}
    calls: {str: str} @= {}
    bound = resolved.bindings_of(r, from: module)

    if !bound.is_err()
        uses = bound.must()

        # ORDER: none — a file names a module by one `use` alone, a second
        # refused as `used_twice` and never recorded, so each module's entry
        # is written once.
        for binding in sort(keys(uses))
            calls[uses[binding].must()] @ binding
    return calls

function render_ty(t: table.Types, s: source.Source, decls: [ast.Decl], id: i64, generics: [str]) -> str
    return render_read(t, s, decls, id, generics, reader: bare_reader())

# `render_ty` for a reader standing in a module, every name it writes one
# that module's file can write.
function render_read(t: table.Types, s: source.Source, decls: [ast.Decl], id: i64, generics: [str], reader: Reader) -> str
    return match table.get(t, id)
        .int_ty k   => widths.int_name(k.kind)
        .float_ty k => widths.float_name(k.kind)
        .bool       => "bool"
        .str        => "str"
        .ptr        => "ptr"
        .cstr       => "cstr"
        .unit       => "()"
        .fixed x    => render_read(t, s, decls, x.element, generics, reader: reader) + "[" + x.length.to_str() + "]"
        .array a    => "[" + render_read(t, s, decls, a.element, generics, reader: reader) + "]"
        .map m => "{" + render_read(t, s, decls, m.key, generics, reader: reader) + ": " + render_read(t, s, decls, m.value, generics, reader: reader) + "}"
        .fallible o => render_read(t, s, decls, o.payload, generics, reader: reader) + "?"
        .function_ty f =>
            rendered: [str] @= []
            names = table.labels_of(t, f.labels)
            at: i64 @= 0

            for p in table.params_of(t, f.params)
                one = render_read(t, s, decls, p, generics, reader: reader)

                if at < names.len() && names[at].len() > 0
                    rendered @ rendered.push(names[at] + ": " + one)
                else
                    rendered @ rendered.push(one)
                at @ at + 1

            "(function(" + rendered.join(", ") + ") -> " + render_read(t, s, decls, f.result, generics, reader: reader) + ")"
        .named n => written_name(s, decls, decl: n.decl, reader: reader)
        # `Token.num` — a case is not writable as a type, and pretending it
        # is would send the reader looking for a syntax that does not
        # exist.

        .case_ty vc => case_name(s, decls, decl: vc.decl, at: vc.at, reader: reader)
        .failure    => "the error (`code`, `msg`)"
        # A type parameter prints as it was declared: `A`, not `#0`.

        .generic g =>
            if g.at < generics.len()
                generics[g.at]
            else

                # The loud honest noun, not a table index. Threading the
                # callee's letters is the fuller repair and
                # `selfhost/check/walk.hero` already does it for two other
                # messages — but that file stands at 1697 of a DECIDED 1700,
                # so the thread waits for a ceiling raise and this says the
                # true thing meanwhile.
                "a type parameter"
        .error => "?"

function case_name(s: source.Source, decls: [ast.Decl], decl: i64, at: i64, reader: Reader) -> str
    name = written_name(s, decls, decl: decl, reader: reader)

    return match decls[decl].kind
        .variant_decl v => name + "." + source.span_text(s, v.cases[at].name)
        .constant_decl | .function_decl | .record_decl | .test_decl => name

# A record's or a variant's name as `reader`'s file writes it.
function written_name(s: source.Source, decls: [ast.Decl], decl: i64, reader: Reader) -> str
    name = source.span_text(s, decls[decl].name)
    home = source.module_at(s, decls[decl].span.start)

    if reader.module == "" || home == reader.module || home == source.LIBRARY_MODULE
        return name
    called = reader.calls[home]

    if !called.is_err()
        return called.must() + "." + name
    parts = module_last_part(home)
    return parts + "." + name

# A module path's last part, `decl` of `syntax/decl`: the name a `use` of it
# binds when it writes no `as`.
function module_last_part(path: str) -> str
    at: i64 @= path.len()

    while at > 0 && path[at - 1] != '/'
        at @ at - 1

    return path.slice(from: at, to: path.len())

## Tests

# The fixture's text is the name table; parse builds the real decls so
# the nominal names come from a genuine tree.
function fixture(text: str) -> parse.ParseOutput
    return parse.parse(text)

test "fixedbugs: a type of another module is written as the reader's file writes it (defect 2205)"
    text = "record Box\n    width: i64\n"
    p = fixture(text)
    s = source.new_source(name: "geom.hero", text: text)
    calls: {str: str} @= {}
    calls["geom"] @ "g"
    elsewhere: {str: str} = {}
    assert written_name(s, p.decls, decl: 0, reader: bare_reader()) == "Box"
    assert written_name(s, p.decls, decl: 0, reader: Reader(module: "geom", calls: elsewhere)) == "Box"
    assert written_name(s, p.decls, decl: 0, reader: Reader(module: "main", calls: calls)) == "g.Box"
    assert written_name(s, p.decls, decl: 0, reader: Reader(module: "main", calls: elsewhere)) == "geom.Box"
    assert module_last_part("syntax/decl") == "decl"
    assert module_last_part("geom") == "geom"

test "a compound type prints as the author would write it"
    p = fixture("record Point\n    x: i64\n")
    s = source.new_source(name: "t.hero", text: "record Point\n    x: i64\n")
    t: table.Types @= table.new_types()
    point = table.intern(@t, .named(decl: 0))
    keyed = table.intern(@t, .map(key: table.str_ty(t), value: point))
    maybe = table.intern(@t, .fallible(payload: keyed))
    xs = table.intern(@t, .array(element: maybe))
    none: [str] = []
    assert render_ty(t, s, p.decls, xs, none) == "[{str: Point}?]"
    assert render_ty(t, s, p.decls, table.unit_ty(t), none) == "()"
    fixed = table.intern(@t, .fixed(element: table.int_ty_id(t), length: 4))
    assert render_ty(t, s, p.decls, fixed, none) == "i64[4]"

test "a function type keeps its mandatory parentheses"
    p = fixture("record Point\n    x: i64\n")
    s = source.new_source(name: "t.hero", text: "record Point\n    x: i64\n")
    t: table.Types @= table.new_types()
    ps: [i64] = [table.int_ty_id(t), table.str_ty(t)]
    none: [str] = []
    f = table.intern_function(@t, ps, none, result: table.bool_ty(t))
    assert render_ty(t, s, p.decls, f, none) == "(function(i64, str) -> bool)"

    # The names are part of the type, so they are part of its one spelling.
    pair: [i64] = [table.str_ty(t), table.str_ty(t)]
    written: [str] = ["code", "msg"]
    named = table.intern_function(@t, pair, written, result: table.str_ty(t))
    assert render_ty(t, s, p.decls, named, none) == "(function(code: str, msg: str) -> str)"

test "a case prints its variant's dot spelling, a generic its own name"
    text = "variant Token\n    num\n        v: i64\n    plus\n"
    p = fixture(text)
    s = source.new_source(name: "t.hero", text: text)
    t: table.Types @= table.new_types()
    num = table.intern(@t, .case_ty(decl: 0, at: 0))
    plus = table.intern(@t, .case_ty(decl: 0, at: 1))
    none: [str] = []
    assert render_ty(t, s, p.decls, num, none) == "Token.num"
    assert render_ty(t, s, p.decls, plus, none) == "Token.plus"
    a = table.intern(@t, .generic(at: 0))
    names: [str] = ["A", "B"]
    assert render_ty(t, s, p.decls, a, names) == "A"

    # Defect 021: this asserted `#0` until 2026-09-08, which is how the
    # module doc's dead premise stayed comfortable — the case it called
    # unreachable had a test pinning its output.
    assert render_ty(t, s, p.decls, a, none) == "a type parameter"
    assert render_ty(t, s, p.decls, table.error_ty(t), none) == "?"
