# The copies of a record C forbids to copy, refused at `build` once clang
# has said which group records hold a lock (panel 215's R2, issue 1335;
# `cli/locks.hero`), as `ffi_lock_copied`: POSIX XSH 2.9.9, *the effect of
# referring to a copy of the object when locking, unlocking, or destroying
# it is undefined*. What is allowed is what reaches C as the place itself:
# an `@` lend of the cell or of a field, a field read or write through it,
# and a construction or a group's constant that initialises its cell or a
# field of a construction. Everything else of the
# type copies C's bytes, the lock among them: a binding from a place, a
# by-value parameter, a result, an argument handed on by value, an element,
# a comparison. A Heroes record or a fixed array holding one by value holds
# it too, which is `partial`'s "for it and for any value holding it" (spec
# § 13). The set comes from the header, by type identity, and never from a
# word the binding writes (the sitting's route C over its route B: no word,
# so nothing a formatter can drop, and no spec token).
#
# An extern's own signature is not judged: it is the header's, and its
# result is a fresh value C made, which lands in a cell; what a call hands C
# by value is judged at its argument. Judging it refused `counter_make() ->
# Counter`, a binding that builds and runs (the sitting's ffi-pragmatist,
# measured; a condition of that seat's approval).

use ast
use source
use resolved
use diag
use check/state
use check/table
use check/lending
use check/leasing
use emit/lock_screen
use ir/layout
use read_lend
use token

constant CODE: str
    "ffi_lock_copied"

function copies(a: ast.Ast, r: resolved.Resolved, s: source.Source, decls: [ast.Decl], c: state.Checked, found: {i64: lock_screen.Found}) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= []

    if found.len() == 0
        return out
    why: {i64: str} @= {}
    signatures(a, s, decls, c, found: found, @why, @out)
    into = lending.argument_of(a)
    written = leasing.written_roots(a)
    based = bases(a)
    starts = initialisers(r)
    held_by_value = elements(a, r, s)
    at: i64 @= 0

    while at < a.exprs.len() && at < c.expr_types.len()
        held = locked(s, decls, c, found: found, ty: c.expr_types[at], @why, depth: 0)

        if held.len() > 0 && written[at].is_err() && based[at].is_err()
            lent = !into[at].is_err() && (leasing.marked_in(a, call: into[at].must(), value: at) || read_in_place(a, r, s, decls, c, call: into[at].must(), value: at))
            made = fresh(a, r, at: at) && (!starts[at].is_err() || constructs(a, r, decls, into: into, at: at))

            if !lent && !made
                d: diag.Diagnostic @= diag.new_diagnostic(
                    code: CODE,
                    message: "this copies " + held + ", which C forbids to copy",
                    span: a.exprs[at].span
                )
                extra: str @= ""

                if !held_by_value[at].is_err()
                    extra @ ELEMENT
                else if fresh(a, r, at: at)
                    extra @ FRESH
                d.notes @ notes(extra: extra)
                out @ out.push(d)
        at @ at + 1

    return out

# What an element's copy needs said beside the rest: no container of this
# record can be built, so the way out is a place of its own for each.
constant ELEMENT: str
    "an array or a map holds its elements by value, so each element is a copy: keep each record in a cell of its own, `c: T @= T(...)`, and lend it with `@`"

# What a construction stored, passed or returned needs said (panel 217's R4,
# the two readers of twenty who stored a fresh one into a place): the record
# is copied wherever it lands, so it is built where it lives.
constant FRESH: str
    "a construction is copied into wherever it lands: build the record where it lives, at its own declaration, `c: T @= T(...)`, and change it there field by field, `c.n @ 0`"

function notes(extra: str) -> [str]
    out: [str] @= [
        "a copy of a lock is a second lock holding the first one's state: the copy of a held mutex reads held, and unlocking one leaves the other locked"
    ]

    if extra.len() > 0
        out @ out.push(extra)
    out @ out.push(
        "lend the place instead: a function taking `c: T lent` reads the caller's own cell and changes nothing, `f(c)`; one taking `@c` may change it, `f(@c)`; a field is read in place, `c.n`"
    )
    return out

# A parameter neither `@` nor `lent`, or a result, of a type holding a lock.
function signatures(a: ast.Ast, s: source.Source, decls: [ast.Decl], c: state.Checked, found: {i64: lock_screen.Found}, @why: {i64: str}, @out: [diag.Diagnostic])
    for d in decls
        match d.kind
            .function_decl fd =>
                # An extern's signature is the header's (the head of this
                # file says why).
                if fd.value.is_extern
                    continue

                for p in fd.value.params
                    ty = state.written_type(c, p.ty)

                    if !p.mutable && !p.lent && !ty.is_err()
                        held = locked(s, decls, c, found: found, ty: ty.must(), @why, depth: 0)

                        if held.len() > 0
                            name = source.span_text(s, p.name)
                            one: diag.Diagnostic @= diag.new_diagnostic(
                                code: CODE,
                                message: "`" + name + "` takes by value " + held + ", a copy C forbids",
                                span: p.name
                            )
                            one.notes @ notes(extra: "")
                            end = a.types[p.ty].span.end
                            one.fixes @ [
                                diag.Fix(title: "read it in place, the caller's own cell and no copy: `" + name + ": " + source.span_text(s, a.types[p.ty].span) + " lent`", replacement: " lent", span: token.Span(start: end, end: end), certainty: .guess)
                                diag.Fix(title: "or, where the function changes it, take it by place and lend it at each call with `@`", replacement: "@" + name, span: p.name, certainty: .guess)
                            ]
                            out @ out.push(one)

                result = state.written_type(c, fd.value.result)

                if !result.is_err()
                    held = locked(s, decls, c, found: found, ty: result.must(), @why, depth: 0)

                    if held.len() > 0
                        one: diag.Diagnostic @= diag.new_diagnostic(
                            code: CODE,
                            message: "`" + source.span_text(s, d.name) + "` returns " + held + ", a copy out of its place, which C forbids",
                            span: d.name
                        )
                        one.notes @ notes(
                            extra: "build it where it lives, `c: T @= T(...)`, then hand it to a function that takes `@c`"
                        )
                        out @ out.push(one)
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

# What a value of `ty` holds that C forbids to copy, said for the message,
# or "" where it holds none.
function locked(s: source.Source, decls: [ast.Decl], c: state.Checked, found: {i64: lock_screen.Found}, ty: i64, @why: {i64: str}, depth: i64) -> str
    if depth > 64
        return ""

    match table.get(c.types, ty)
        .named n => return record_locked(s, decls, c, found: found, decl: n.decl, @why, depth: depth)
        .fixed f => return locked(s, decls, c, found: found, ty: f.element, @why, depth: depth + 1)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return ""
        .array | .map | .fallible | .function_ty => return ""
        .case_ty | .failure | .generic | .error => return ""

    return ""

# A group record clang found a lock in, or a record holding one by value;
# each answer kept by its declaration, a record being asked once.
function record_locked(s: source.Source, decls: [ast.Decl], c: state.Checked, found: {i64: lock_screen.Found}, decl: i64, @why: {i64: str}, depth: i64) -> str
    if !why[decl].is_err()
        return why[decl].must()
    why[decl] @ ""
    name = source.span_text(s, decls[decl].name)
    out: str @= ""

    if !found[decl].is_err()
        f = found[decl].must()
        at: str @= "itself"

        if f.path.len() > 0
            at @ "at `" + f.path + "`"
        out @ "a `" + name + "`, whose C struct `" + f.c_type + "` holds a `" + f.lock + "` " + at
    else
        match decls[decl].kind
            .record_decl rec =>
                for field in rec.fields
                    written = state.written_type(c, field.ty)

                    if out.len() == 0 && !written.is_err()
                        inner = locked(s, decls, c, found: found, ty: written.must(), @why, depth: depth + 1)

                        if inner.len() > 0
                            out @ "a `" + name + "`, whose field `" + source.span_text(s, field.name) + "` holds " + inner
            .constant_decl | .function_decl | .variant_decl | .test_decl => out @ ""

    why[decl] @ out
    return out

# A value that has no place yet: a construction or a group's constant.
function fresh(a: ast.Ast, r: resolved.Resolved, at: i64) -> bool
    match a.exprs[at].kind
        .call =>
            return true
        .name =>
            match r.uses[at]
                .top                                      => return true
                .local | .builtin | .module | .unresolved => return false
        .method | .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit => return false
        .field_name | .null_ptr | .hole | .unary | .binary | .field | .index         => return false
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error  => return false

    return false

# Whether `at` is an argument of a record's construction.
function constructs(a: ast.Ast, r: resolved.Resolved, decls: [ast.Decl], into: {i64: i64}, at: i64) -> bool
    if into[at].is_err()
        return false

    match a.exprs[into[at].must()].kind
        .call cl =>
            match r.uses[cl.callee]
                .top t =>
                    match decls[t.at].kind
                        .record_decl                                                 => return true
                        .constant_decl | .function_decl | .variant_decl | .test_decl => return false
                .local | .builtin | .module | .unresolved => return false
        .method | .name | .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit => return false
        .field_name | .null_ptr | .hole | .unary | .binary | .field | .index                 => return false
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error          => return false

    return false

# Every expression that is the base of a field or an index expression.
function bases(a: ast.Ast) -> {i64: bool}
    out: {i64: bool} @= {}

    for e in a.exprs
        match e.kind
            .field f                                                                         => out[f.base] @ true
            .index i                                                                         => out[i.base] @ true
            .call | .method | .name | .int_lit | .char_lit | .float_lit | .str_lit | .interp => continue
            .bool_lit | .field_name | .null_ptr | .hole | .unary | .binary | .variant_case   => continue
            .array | .map | .try_expr | .if_expr | .match_expr | .error                      => continue

    return out

# Every expression a container takes as one of its elements: an array
# literal's element, a map literal's value, and what `push` adds, written
# `xs.push(v)` or `push(xs, v)`; `push` is a name no program can declare
# (`builtin_name_taken`).
function elements(a: ast.Ast, r: resolved.Resolved, s: source.Source) -> {i64: bool}
    out: {i64: bool} @= {}

    for e in a.exprs
        match e.kind
            .array arr =>
                for one in arr.elements
                    out[one] @ true
            .map m =>
                for entry in m.entries
                    out[entry.value] @ true
            .method m =>
                if source.span_text(s, m.name) == "push"
                    for arg in m.args
                        out[arg.value] @ true
            .call cl =>
                match r.uses[cl.callee]
                    .builtin =>
                        if source.span_text(s, a.exprs[cl.callee].span) == "push"
                            for arg in cl.args
                                out[arg.value] @ true
                    .top | .local | .module | .unresolved => continue
            .name | .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit => continue
            .field_name | .null_ptr | .hole | .unary | .binary | .field | .index       => continue
            .variant_case | .try_expr | .if_expr | .match_expr | .error                => continue

    return out

# Every expression that initialises a local where it is declared.
function initialisers(r: resolved.Resolved) -> {i64: bool}
    out: {i64: bool} @= {}

    for local in r.locals
        if !local.value.is_err()
            out[local.value.must()] @ true

    return out

# An argument lent read-only in place (panel 217's R1 and R2, `read_lend.hero`): the
# lowering hands its place, so nothing is copied. A dotted call whose
# receiver holds a function in a field of that name calls the field, as the
# lowering does (panel 079), and lends nothing.
function read_in_place(a: ast.Ast, r: resolved.Resolved, s: source.Source, decls: [ast.Decl], c: state.Checked, call: i64, value: i64) -> bool
    if !read_lend.handed_in_place(a, r, s, decls, call: call, value: value) || to_a_letter(a, r, decls, c, call: call, value: value)
        return false

    match a.exprs[call].kind
        .method m =>
            field = layout.field_type(decls, c, s, owner: c.expr_types[m.receiver], name: m.name)
            return field.is_err() || !table.is_function_ty(c.types, field.must())
        .call | .name | .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit => return true
        .field_name | .null_ptr | .hole | .unary | .binary | .field | .index               => return true
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error        => return true

    return true

# Whether the lent parameter is a bare type parameter, `x: T lent`: its body
# may hand `x` on by value as a `T`, which this rule cannot see as the
# record it is, so the record lent there stays a copy, as handed by value it
# is (measured: `apply<T>(x: T lent, f: (function(T) -> i64))` returning
# `f(x)` handed C a lock by value, exit 0).
function to_a_letter(a: ast.Ast, r: resolved.Resolved, decls: [ast.Decl], c: state.Checked, call: i64, value: i64) -> bool
    callee = read_lend.callee_of(a, r, call: call)

    if callee.is_err()
        return false
    at = read_lend.position_of(a, call: call, value: value, first: callee.must().first)

    match decls[callee.must().decl].kind
        .function_decl fd =>
            if at < 0 || at >= fd.value.params.len()
                return false
            written = state.written_type(c, fd.value.params[at].ty)

            if written.is_err()
                return false

            match table.get(c.types, written.must())
                .generic                                                  => return true
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
                .array | .fixed | .map | .fallible | .function_ty         => return false
                .named | .case_ty | .failure | .error                     => return false
        .constant_decl | .record_decl | .variant_decl | .test_decl => return false

    return false
