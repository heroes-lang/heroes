# The `owned <freer>` marks of a program, by the name each gives: the table
# every call to a declared function and every extern probe asks, built once
# (defect 111). Split out of `check/freer.hero` on 2026-09-27, when the table
# took that file past design.md §11's ~300 lines; the refusal it feeds stays
# there.

use token
use ast
use source

# Every `owned <freer>` mark in the program, by the name it gives: the table
# `marked_as_freer` answers from, built in one pass over the declarations.
#
# **One pass, read at every call** (defect 111). The question used to walk
# every declaration and every parameter of the program at every call to a
# declared function, so `check` grew with calls times declarations and the
# walk was 23,277 of 27,436 samples of `heroes check selfhost/main.hero`.
#
# The FIRST mark per name is kept — a second mark naming the same freer is the
# same refusal, and pointing at one is what a reader can act on — in the order
# the walk read them: declarations in order, and within one the result before
# the parameters. Both positions are read, because both are the mark: a `cstr`
# result and a parameter the header spells `char **`.
function marks(decls: [ast.Decl], s: source.Source) -> {str: token.Span}
    found: {str: token.Span} @= {}

    for one in decls
        match one.kind
            .function_decl fd =>
                if !fd.value.owned_result.is_err()
                    keep_first(@found, s, mark: fd.value.owned_result.must())

                for param in fd.value.params
                    if !param.owned.is_err()
                        keep_first(@found, s, mark: param.owned.must())
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

    return found

# The table is lent, so the store lands in the one map it is (design.md Part 8
# wart 8's cheap spelling).
function keep_first(@found: {str: token.Span}, s: source.Source, mark: token.Span)
    name = source.span_text(s, mark)

    if found[name].is_err()
        found[name] @ mark

# The `owned <freer>` mark that names this function, if any declaration in the
# program has one: the first, as `marks` keeps it.
function marked_as_freer(freers: {str: token.Span}, name: str) -> token.Span?
    found = freers[name]

    if found.is_err()
        return fail(code: "absent", msg: "nothing names this function as a freer")
    return found
