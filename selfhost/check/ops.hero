# §4.14's operators, and there are no promotions anywhere.
# Port of archive/bootstrap-rs/heroes/src/types/ops.rs.
#
# Every rule here is monomorphic on purpose: `1 + 2.0` is an error, and
# the error names the conversion the spec provides. That is the whole of
# "no implicit conversions" — one table, no coercion lattice, and a model
# that guesses wrong is told which function to write.
#
# Four shapes: arithmetic (`+ - * / %`, same numeric type both sides, and
# `+` also joins two `str` — panel 017 B); comparison (`< <= > >=`, a
# number only: ordering on `str` would need a collation the language does
# not specify, and a rejection can be relaxed later); equality (`== !=`,
# any two values of THE SAME type, structural); boolean (`&& || !`,
# `bool` only, short-circuiting).

use token
use ast
use source
use parse
use resolved
use check/table
use check/state
use check/partial
use value_errors
use ffi_errors

function binary(@c: state.Checker, s: source.Source, decls: [ast.Decl], op: ast.BinaryOp, left: i64, right: i64, span: token.Span) -> i64
    # A type that is already wrong was already reported: stay quiet
    # (§4.17 — one mistake, one message).
    if table.poisoned(c.out.types, left) || table.poisoned(c.out.types, right)
        return state.error_ty_of(c)

    match op
        .add | .sub | .mul | .div | .rem => return arithmetic(@c, s, decls, op, left: left, right: right, span: span)
        .eq | .ne =>
            if left != right
                a = state.show(c, s, decls, left)
                b = state.show(c, s, decls, right)
                state.push_diagnostic(@c, value_errors.mismatch(expected: a, got: b, span: span))
                return state.error_ty_of(c)

            # A partial record cannot answer `==`, and neither can anything
            # holding one (panel 061): the generated _eq walks the field
            # list, and the field list is not the struct. Asked of the TYPE
            # rather than of the operand's syntax, because [Font] == [Font]
            # reaches Font_eq with no Font written anywhere on the line.
            reached = partial.reaches(c, decls, left)

            if !reached.is_err()
                shown = state.show(c, s, decls, left)
                name = source.span_text(s, decls[reached.must()].name)
                state.push_diagnostic(
                    @c,
                    ffi_errors.partial_operation(holder: name, shown: shown, what: "compared with `==`", span: span)
                )
                return state.error_ty_of(c)
            return table.bool_ty(c.out.types)
        # `i64` only, and both sides (§4.14). A bit pattern is what these
        # operate on, and f64's bits are not its value. `bool` is excluded
        # for the reason §4.14 keeps `&&` and `&` apart: one
        # short-circuits, and a language where both work on bool invites
        # the reader to assume they are the same operator.

        .bit_and | .bit_or | .bit_xor | .shl | .shr =>
            int_id = table.int_ty_id(c.out.types)

            if left != int_id || right != int_id
                bad: i64 @ left

                if left == int_id
                    bad @ right
                got = state.show(c, s, decls, bad)
                state.push_diagnostic(
                    @c,
                    value_errors.bad_operand(op: op_name(op), allowed: "`i64`", got: got, span: span)
                )
                return state.error_ty_of(c)
            return int_id
        .lt | .le | .gt | .ge =>
            ordered = match table.get(c.out.types, left)
                .int_ty | .float_ty                                   => true
                .bool | .str | .ptr | .cstr | .unit | .array | .fixed => false
                .map | .fallible | .function_ty | .named | .case_ty   => false
                .failure | .generic | .error                          => false

            if !ordered
                got = state.show(c, s, decls, left)
                state.push_diagnostic(
                    @c,
                    value_errors.bad_operand(op: op_name(op), allowed: "any integer or a float", got: got, span: span)
                )
                return state.error_ty_of(c)

            if left != right
                a = state.show(c, s, decls, left)
                b = state.show(c, s, decls, right)
                state.push_diagnostic(
                    @c,
                    value_errors.mixed_arithmetic(op: op_name(op), left: a, right: b, span: span)
                )
                return state.error_ty_of(c)
            return table.bool_ty(c.out.types)
        .and | .or =>
            wanted = table.bool_ty(c.out.types)

            if left != wanted || right != wanted
                bad: i64 @ left

                if left == wanted
                    bad @ right
                got = state.show(c, s, decls, bad)
                state.push_diagnostic(
                    @c,
                    value_errors.bad_operand(op: op_name(op), allowed: "`bool`", got: got, span: span)
                )
                return state.error_ty_of(c)
            return wanted

    return state.error_ty_of(c)

function arithmetic(@c: state.Checker, s: source.Source, decls: [ast.Decl], op: ast.BinaryOp, left: i64, right: i64, span: token.Span) -> i64
    both = left == right

    # `+` on two `str` is concatenation (panel 017 B1) — the only
    # non-numeric arithmetic rule in the language.
    if both && table.get(c.out.types, left) == .str
        if op == .add
            return table.str_ty(c.out.types)
        state.push_diagnostic(
            @c,
            value_errors.bad_operand(op: op_name(op), allowed: "any integer or a float", got: "str", span: span)
        )
        return state.error_ty_of(c)

    if both && is_numeric(c, left)
        return left

    # Two operands the operator accepts, of different types: name both,
    # because the mistake is the pairing and not either one.
    if !both && acceptable(c, left, op) && acceptable(c, right, op)
        a = state.show(c, s, decls, left)
        b = state.show(c, s, decls, right)
        state.push_diagnostic(@c, value_errors.mixed_arithmetic(op: op_name(op), left: a, right: b, span: span))
        return state.error_ty_of(c)
    offender: i64 @ left

    if acceptable(c, left, op)
        offender @ right
    got = state.show(c, s, decls, offender)
    allowed: str @ "`i64` with `i64` or `f64` with `f64`"

    if op == .add
        allowed @ "`i64` with `i64`, `f64` with `f64`, or `str` with `str`"
    state.push_diagnostic(@c, value_errors.bad_operand(op: op_name(op), allowed: allowed, got: got, span: span))
    return state.error_ty_of(c)

function unary(@c: state.Checker, s: source.Source, decls: [ast.Decl], op: ast.UnaryOp, operand: i64, span: token.Span) -> i64
    if table.poisoned(c.out.types, operand)
        return state.error_ty_of(c)

    match op
        .neg =>
            if is_numeric(c, operand)
                return operand
            got = state.show(c, s, decls, operand)
            state.push_diagnostic(
                @c,
                value_errors.bad_operand(op: "-", allowed: "any integer or a float", got: got, span: span)
            )
            return state.error_ty_of(c)
        .not =>
            wanted = table.bool_ty(c.out.types)

            if operand == wanted
                return wanted
            got = state.show(c, s, decls, operand)
            state.push_diagnostic(@c, value_errors.bad_operand(op: "!", allowed: "`bool`", got: got, span: span))
            return state.error_ty_of(c)
        .bit_not =>
            int_id = table.int_ty_id(c.out.types)

            if operand == int_id
                return int_id
            got = state.show(c, s, decls, operand)
            state.push_diagnostic(@c, value_errors.bad_operand(op: "~", allowed: "`i64`", got: got, span: span))
            return state.error_ty_of(c)

    return state.error_ty_of(c)

function is_numeric(c: state.Checker, ty: i64) -> bool
    return match table.get(c.out.types, ty)
        .int_ty | .float_ty                                   => true
        .bool | .str | .ptr | .cstr | .unit | .array | .fixed => false
        .map | .fallible | .function_ty | .named | .case_ty   => false
        .failure | .generic | .error                          => false

function acceptable(c: state.Checker, ty: i64, op: ast.BinaryOp) -> bool
    if is_numeric(c, ty)
        return true
    return op == .add && table.get(c.out.types, ty) == .str

# The operator as written, for the message.
function op_name(op: ast.BinaryOp) -> str
    return match op
        .add     => "+"
        .sub     => "-"
        .mul     => "*"
        .div     => "/"
        .rem     => "%"
        .eq      => "=="
        .ne      => "!="
        .lt      => "<"
        .le      => "<="
        .gt      => ">"
        .ge      => ">="
        .bit_and => "&"
        .bit_or  => "|"
        .bit_xor => "^"
        .shl     => "<<"
        .shr     => ">>"
        .and     => "&&"
        .or      => "||"

## Tests

function bare_checker() -> state.Checker
    r: resolved.Resolved @ resolved.new_resolved()
    return state.new_checker(out_of: r, expr_count: 0)

function no_decls() -> [ast.Decl]
    return []

function anywhere() -> token.Span
    return token.Span(start: 0, end: 1)

test "arithmetic is monomorphic and the mix names the conversion"
    c: state.Checker @ bare_checker()
    s = source.new_source(name: "t.hero", text: "x\n")
    int_id = table.int_ty_id(c.out.types)
    f64_id = table.f64_ty(c.out.types)
    assert binary(@c, s, no_decls(), .add, left: int_id, right: int_id, span: anywhere()) == int_id
    assert binary(@c, s, no_decls(), .mul, left: f64_id, right: f64_id, span: anywhere()) == f64_id
    assert c.out.diagnostics.len() == 0
    _ = binary(@c, s, no_decls(), .add, left: int_id, right: f64_id, span: anywhere())
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].code == "mixed_arithmetic"
    assert c.out.diagnostics[0].message == "`+` takes two of one type — two integers of the SAME width, or two floats of the same width — and found `i64` and `f64`"

test "plus joins two str and nothing else does"
    c: state.Checker @ bare_checker()
    s = source.new_source(name: "t.hero", text: "x\n")
    str_id = table.str_ty(c.out.types)
    assert binary(@c, s, no_decls(), .add, left: str_id, right: str_id, span: anywhere()) == str_id
    assert c.out.diagnostics.len() == 0
    _ = binary(@c, s, no_decls(), .sub, left: str_id, right: str_id, span: anywhere())
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].code == "bad_operand"

test "equality wants one type, ordering wants a number, logic wants bool"
    c: state.Checker @ bare_checker()
    s = source.new_source(name: "t.hero", text: "x\n")
    int_id = table.int_ty_id(c.out.types)
    str_id = table.str_ty(c.out.types)
    wanted = table.bool_ty(c.out.types)
    assert binary(@c, s, no_decls(), .eq, left: str_id, right: str_id, span: anywhere()) == wanted
    _ = binary(@c, s, no_decls(), .eq, left: int_id, right: str_id, span: anywhere())
    assert c.out.diagnostics[0].code == "type_mismatch"
    _ = binary(@c, s, no_decls(), .lt, left: str_id, right: str_id, span: anywhere())
    assert c.out.diagnostics[1].code == "bad_operand"
    assert c.out.diagnostics[1].message == "`<` takes any integer or a float, found `str`"
    _ = binary(@c, s, no_decls(), .and, left: int_id, right: wanted, span: anywhere())
    assert c.out.diagnostics[2].message == "`&&` takes `bool`, found `i64`"
    _ = binary(@c, s, no_decls(), .bit_and, left: wanted, right: wanted, span: anywhere())
    assert c.out.diagnostics[3].message == "`&` takes `i64`, found `bool`"

test "a partial record refuses == transitively, with the record named"
    p = parse.parse("extern \"s.h\"\n    record Font partial\n        size: i64\n")
    s = source.new_source(name: "t.hero", text: "extern \"s.h\"\n    record Font partial\n        size: i64\n")
    r: resolved.Resolved @ resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    font = table.intern(@c.out.types, .named(decl: 0))
    xs = table.intern(@c.out.types, .array(element: font))
    _ = binary(@c, s, p.decls, .eq, left: xs, right: xs, span: anywhere())
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].code == "ffi_partial_operation"
    assert c.out.diagnostics[0].message == "`Font` is `partial`, so it cannot be compared with `==` — reached through `[Font]`: the fields it does not name are part of the answer, and this program cannot see them"

test "unary keeps the same three fences, and poison stays silent"
    c: state.Checker @ bare_checker()
    s = source.new_source(name: "t.hero", text: "x\n")
    int_id = table.int_ty_id(c.out.types)
    f64_id = table.f64_ty(c.out.types)
    wanted = table.bool_ty(c.out.types)
    assert unary(@c, s, no_decls(), .neg, operand: f64_id, span: anywhere()) == f64_id
    assert unary(@c, s, no_decls(), .not, operand: wanted, span: anywhere()) == wanted
    assert unary(@c, s, no_decls(), .bit_not, operand: int_id, span: anywhere()) == int_id
    assert c.out.diagnostics.len() == 0
    _ = unary(@c, s, no_decls(), .bit_not, operand: f64_id, span: anywhere())
    assert c.out.diagnostics.len() == 1
    poisoned = table.error_ty(c.out.types)
    _ = binary(@c, s, no_decls(), .add, left: poisoned, right: int_id, span: anywhere())
    _ = unary(@c, s, no_decls(), .neg, operand: poisoned, span: anywhere())
    assert c.out.diagnostics.len() == 1
