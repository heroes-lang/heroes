# Your own call of a declared freer is refused (design.md §4.19, spec § FFI;
# panel 109, condition 2 of eight, ratified 2026-09-04).
#
# **The one condition four seats wrote independently**, and the only one that
# turns a silent double release at exit 0 into a diagnostic. `owned
# sqlite3_free` on a result or a `@` parameter tells the compiler to free that
# string with that function. A program that ALSO calls `sqlite3_free` itself
# frees it twice: on both platforms that is exit 0 with nothing on either
# stream, which is the worst answer a memory bug can give.
#
# **It needs only the callee's NAME**, which is why it is a check and not a
# dataflow pass: a function this program has named as a freer is a function
# this program has handed to the compiler, and calling it from Heroes is asking
# for the release to happen twice. The mark's own span is what the message
# points at, because the repair is a choice between the two — keep the mark and
# delete the call, or delete the mark and free it yourself.
#
# **Refusing every call and not only the provably-owned one is the robust
# reading and it is deliberate** (CLAUDE.md §4: the most robust resolution,
# never the cheapest). A freer called on some OTHER pointer is exactly the
# shape that double-frees by accident the day the two pointers become one, and
# no program in the closure list needs it: the compiler is doing the freeing.
# The narrow reading would have to prove which value reaches the call, which is
# the dataflow this file exists not to need.

use token
use ast
use source
use diag
use check/table
use parse

# The `owned <freer>` mark that names this function, if any declaration in the
# program has one. The FIRST is enough — a second mark naming the same freer
# is the same refusal, and pointing at one is what a reader can act on.
#
# Both positions are searched, because both are the mark: a `cstr` result and a
# parameter the header spells `char **`.
function marked_as_freer(decls: [ast.Decl], s: source.Source, name: str) -> token.Span?
    for one in decls
        match one.kind
            .function_decl fd =>
                if !fd.value.owned_result.is_err()
                    if source.span_text(s, fd.value.owned_result.must()) == name
                        return ok(fd.value.owned_result.must())

                for param in fd.value.params
                    if !param.owned.is_err()
                        if source.span_text(s, param.owned.must()) == name
                            return ok(param.owned.must())
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

    return fail("absent", "nothing names this function as a freer")

# What a marked call HANDS BACK, which is not what its signature declares.
#
# **§4.19's own sentence**: the compiler frees that string with that function
# and *hands it over as a `str?`*. The `cstr` in the declaration is the C truth
# — it is what clang checks the header against — and the `str?` is the Heroes
# truth, because by the time the program can touch the value the bytes C gave
# it are already copied and already freed. A program that saw the `cstr` would
# hold a pointer into memory the compiler is about to release, which is the
# whole hazard the mark exists to remove.
#
# **This and the release are ONE COMMIT OR NONE, measured.** Written alone on
# 2026-09-06 it read correctly in both directions and then made clang refuse
# the generated C — `assigning to 'h_0opt_…' from incompatible type 'const char
# *'`, `internal error`, exit 2, the compiler blaming itself for a `.hero`
# file. It was parked until `ir/owned_release.hero` existed.
#
# Asked here rather than written twice: `user_call` reaches it from the
# plain-call arm and from the method arm, and two copies of one rule drift.
function handed_back(@t: table.Types, fd: ast.FunctionDecl, declared: i64) -> i64
    if fd.owned_result.is_err()
        return declared
    return table.intern(@t, .fallible(payload: table.str_ty(t)))

# The same question for a marked `@` parameter: the CALLER's cell is a `str?`,
# never the `cstr` the header spells. §4.19's *the `@` cell is only written*:
# C writes a pointer into a hidden cell the lowering owns, and what reaches the
# program's own cell is the copy, already validated, with the original freed
# (`selfhost/ir/owned_release.hero`'s cells). A caller whose cell were a `cstr`
# would hold the pointer the compiler is about to release.
#
# **The two halves land together or neither, measured a second time.** With
# this alone, written 2026-09-07, `error: @problem` on a `str?` cell
# type-checked and the same program was `internal error … passing 'h_0opt_… *'
# to parameter of type 'char **'`, exit 2 — the result position's lesson, in
# the same words, one day later.
function handed_back_param(@t: table.Types, param: ast.Param, declared: i64) -> i64
    if param.owned.is_err()
        return declared
    return table.intern(@t, .fallible(payload: table.str_ty(t)))

# Whether the marks on this declaration name a freer the release can call —
# an `extern` of THIS module, taking exactly one parameter — and the refusal
# for each one that does not.
#
# **A mark naming nothing was `internal error` at exit 2 until 2026-09-07**:
# `-> cstr owned bogus_name` type-checked (the result became a `str?`), the
# lowering found no extern under that name and fell back to a plain call, and
# clang refused `assigning to 'h_0opt_…' from incompatible type 'const char *'`
# — the compiler blaming itself for a typo in a `.hero` file (CLAUDE.md §7).
# The probe cannot catch it, because a function nobody declared has no probe.
#
# THIS module, because the release is a C call emitted in the marked
# declaration's own unit, and that unit includes only its own groups' headers:
# a freer declared in another module would be `call to undeclared function`.
# One parameter, because the release hands the freer exactly one thing — the
# string — and panel 109's condition 1 names the arity as what is verified.
function mark_refusals(s: source.Source, decls: [ast.Decl], at: i64) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @ []

    match decls[at].kind
        .function_decl fd =>
            if !fd.value.owned_result.is_err()
                found = refusal_for_mark(s, decls, at: at, mark: fd.value.owned_result.must())

                if !found.is_err()
                    out @ out.push(found.must())

            for param in fd.value.params
                if !param.owned.is_err()
                    found = refusal_for_mark(s, decls, at: at, mark: param.owned.must())

                    if !found.is_err()
                        out @ out.push(found.must())
        .constant_decl | .record_decl | .variant_decl | .test_decl => return out

    return out

# One mark's verdict: absent when the name is a one-parameter `extern` of the
# marked declaration's module.
function refusal_for_mark(s: source.Source, decls: [ast.Decl], at: i64, mark: token.Span) -> diag.Diagnostic?
    name = source.span_text(s, mark)
    module = source.component_at(s, decls[at].span.start)
    heroes_function: bool @ false
    arity: i64? @ fail("absent", "no extern declares it")

    for one in decls
        match one.kind
            .function_decl fd =>
                if source.span_text(s, one.name) == name
                    if fd.value.is_extern && source.component_at(s, one.span.start) == module
                        arity @ ok(fd.value.params.len())
                    else if !fd.value.is_extern
                        heroes_function @ true
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

    if arity.is_err()
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "unknown_freer",
            message: "`" + name + "` frees nothing here: no `extern` in this module declares it, so `owned " + name + "` names a function the compiler cannot call",
            span: mark
        )

        if heroes_function
            d.notes @ d.notes.push(
                "`" + name + "` is a Heroes function in this program; a freer is the C function that owns the allocation, declared in a group"
            )
        d.notes @ d.notes.push(
            "declare `function " + name + "(p: ptr)` in a group of this module — the header that group names is what clang checks the freer against"
        )
        d.notes @ d.notes.push(
            "§4.19: the compiler frees an `owned` string by calling the freer by name, so the name has to be one this module's headers know"
        )
        return ok(d)

    if arity.must() != 1
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "freer_arity",
            message: "`" + name + "` takes " + arity.must().to_str() + " parameters, and a freer for an `owned` string is handed exactly one: the string",
            span: mark
        )
        d.notes @ d.notes.push(
            "name the function that frees THIS string — `free` for `strdup`, `sqlite3_free` for SQLite's own — or drop the `owned " + name + "` mark and free it yourself"
        )
        return ok(d)

    return fail("fine", "a one-parameter extern of this module")

# The diagnostic, when a call names one.
function refusal(s: source.Source, name: str, mark: token.Span, span: token.Span) -> diag.Diagnostic
    at_line = source.elsewhere(s, here: span.start, there: mark.start)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "owned_freer_called",
        message: "`" + name + "` is what frees an `owned` string in this program, so the compiler already calls it — calling it here frees the string twice",
        span: span
    )
    d.notes @ d.notes.push("the `owned " + name + "` that says so is " + at_line)
    d.notes @ d.notes.push(
        "§4.19: a marked string is handed over as a `str?`, already copied — the bytes C gave you are gone by the time you hold it"
    )

    # Two repairs and they are opposite, so neither can be `certain`: which one
    # is right is a question about what the program means, not about its text.
    d.notes @ d.notes.push(
        "delete this call and let the compiler free it, or delete the `owned " + name + "` mark and free it yourself"
    )
    return d

## Tests

test "the mark is found at both positions, and another program's freer is not this one"
    text = "extern \"x.h\"\n    function a(p: ptr) -> cstr owned release\n    function b(@e: cstr owned drop) -> i32\n    function other(p: ptr)\n\nfunction main()\n    print(0)\n"
    parsed = parse.parse(text)
    assert parsed.diagnostics.len() == 0
    s = source.new_source(name: "t.hero", text: text)

    # Both positions the mark can take, because a refusal that reads only the
    # result position would let the `@` half through in silence.
    assert !marked_as_freer(parsed.decls, s, name: "release").is_err()
    assert !marked_as_freer(parsed.decls, s, name: "drop").is_err()

    # **The two negative shapes, and they are the reason this is a refusal and
    # not a ban**: a function nobody marked, and a name no mark carries. Get
    # either wrong and every `extern` that frees anything stops compiling.
    assert marked_as_freer(parsed.decls, s, name: "other").is_err()
    assert marked_as_freer(parsed.decls, s, name: "sqlite3_free").is_err()

test "a program with no mark at all names no freer"
    text = "extern \"x.h\"\n    function a(p: ptr) -> cstr\n    function free_it(p: ptr)\n\nfunction main()\n    print(0)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    assert marked_as_freer(parsed.decls, s, name: "free_it").is_err()

# Whether the parameter at this position carries `owned <freer>`. Read from the
# declaration, because the mark rides the AST parameter and never becomes a
# slot — and asked HERE because the probe writer and the diagnostic reader both
# need it, and two copies of one question drift.
function owned_parameter(decls: [ast.Decl], at: i64, index: i64) -> bool
    match decls[at].kind
        .function_decl fd =>
            if index >= fd.value.params.len()
                return false

            return !fd.value.params[index].owned.is_err()
        .constant_decl | .record_decl | .variant_decl | .test_decl => return false

    return false
