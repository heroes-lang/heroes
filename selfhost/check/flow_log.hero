# Which locals an event changed since control split, which
# `check/flow.hero`'s `meet` reads (defect 511): every path from a split goes
# on from one flow, its base, and a local no path changed holds on each what
# it held there, so where the paths meet again only the changed ones are
# met. Meeting every local at each join instead cost the square of the
# handles, 41.3 billion instructions for 2,000 handles ended and then 2,000
# `if`s.
#
# **The record is the groups' own clock since defect 530**: each change
# stamps its group with the clock of its path, one later than the last, and
# each node of `check/flow_groups.hero`'s tree keeps the latest stamp below
# it, so the groups a path changed after its split's clock are found by
# going down only where a node's latest is later. Until then the record was
# a list of the locals changed since the outermost split and a map of where
# each was written, which, as the code reads, a path's first change copied
# whole as it copied the groups, so that inside a loop every `if` copied
# what the loop's body had changed so far: 2,000 `if`s in one turn of a
# loop, each branch ending a handle, read 29.07 billion instructions, and
# 4.66 billion with the clock and the tree.

use check/flow_groups

# The locals two paths changed after the clock `from`, each once, `one`'s
# first, each path's in the order of their numbers.
function since(one: flow_groups.Groups, two: flow_groups.Groups, from: i64) -> [str]
    out: [str] @ []
    named: {str: bool} @ {}

    for g in [one, two]
        for local in after(g, from: from)
            if named[local].is_err()
                named[local] @ true
                out @ out.push(local)

    return out

# The locals of `g` whose group changed after `from`, in the order of their
# numbers.
function after(g: flow_groups.Groups, from: i64) -> [str]
    out: [str] @ []

    if g.root.latest > from
        later(@out, n: g.root, level: g.levels, from: from)
    return out

function later(@out: [str], n: flow_groups.Node, level: i64, from: i64)
    at: i64 @ 0

    if level > 0
        while at < n.kids.len()
            if n.kids[at].latest > from
                later(@out, n: n.kids[at], level: level - 1, from: from)
            at @ at + 1

        return

    while at < n.held.len()
        if n.held[at].stamp > from
            out @ out.push(n.held[at].local)
        at @ at + 1

test "what changed after a clock is found on each path, each local once"
    base: flow_groups.Groups @ flow_groups.none()
    flow_groups.put(@base, one: stamped("3", stamp: 1))
    flow_groups.put(@base, one: stamped("4", stamp: 2))
    one: flow_groups.Groups @ base
    flow_groups.put(@one, one: stamped("5", stamp: 3))
    flow_groups.put(@one, one: stamped("3", stamp: 4))
    two: flow_groups.Groups @ base
    flow_groups.put(@two, one: stamped("70000", stamp: 3))
    flow_groups.put(@two, one: stamped("5", stamp: 4))
    assert since(one: one, two: two, from: 2) == ["3", "5", "70000"]
    assert since(one: two, two: one, from: 2) == ["5", "70000", "3"]
    assert since(one: one, two: one, from: 3) == ["3"]
    assert since(one: base, two: base, from: 2).len() == 0
    assert after(base, from: 0) == ["3", "4"]

function stamped(local: str, stamp: i64) -> flow_groups.Held
    one: flow_groups.Held @ flow_groups.empty(local)
    one.kept @ one.kept.push([local])
    one.stamp @ stamp
    return one
