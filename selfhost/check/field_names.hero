# A field's own NAME, `Point::x`, and the dot written where `::` may belong
# (design.md §4.9; panel 132).
#
# Split out of `check/access.hero` on 2026-09-30, lane 135b, when defect
# 135's reading of `Room.name` would have taken that file past §11's 300
# lines. The seam is panel 132's form: a record's name on the left of `::` or
# `.` holds no value, so everything here asks the declaration, never a type.
#
# `Point::x` — the FIELD'S OWN NAME as a `str`, and never its value.
#
# It exists because a program handing a field name to a foreign notation —
# JSON, CSV, a query — otherwise types that name as a string nothing checks,
# and one wrong letter compiles, runs and ships (panel 132, measured: a
# hand-written marshaller of three records types 18 such strings, and
# `f["witdh"]` leaves the compiler silent at exit 0).
#
# Read from the RESOLVER, never from a table keyed by a span: the route
# `.module` in base position already takes, and `check/state.hero`'s rule that
# a span-keyed table belongs on the token side of the line.
#
# The spelling is `::` and not `.` by the author's choice at panel 132,
# against a prototype that was already built and green: `.` already qualifies
# a module and already reads a field from a value, so a third meaning would
# make the line legible only to a reader who knows whether the base names a
# type or a value, which is not on that line.

use token
use ast
use diag
use source
use resolved
use check/table
use check/state
use data_errors
use resolve/near_names

function names_a_record(r: resolved.Resolved, decls: [ast.Decl], base: i64) -> bool
    match r.uses[base]
        .top t =>
            match decls[t.at].kind
                .record_decl                                                 => return true
                .variant_decl | .constant_decl | .function_decl | .test_decl => return false
        .module | .local | .builtin | .unresolved => return false

    return false

# The type of `Point::x`: `str` when `x` is a field of `Point`, and an error
# otherwise. Two different mistakes get two different messages, because they
# are two different mistakes: a base that names no record at all, and a
# record that has no such field.
function field_name_type(@c: state.Checker, s: source.Source, r: resolved.Resolved, decls: [ast.Decl], base: i64, base_span: token.Span, field: token.Span) -> i64
    name = source.span_text(s, field)
    at: i64 @ 0

    match r.uses[base]
        .top t => at @ t.at
        .module | .local | .builtin | .unresolved =>
            state.push_diagnostic(@c, not_a_record_name(what: source.span_text(s, base_span), span: base_span))
            return state.error_ty_of(c)

    match decls[at].kind
        .record_decl rec =>
            known: [str] @ []

            for candidate in rec.fields
                known @ known.push(source.span_text(s, candidate.name))

            for candidate in known
                if candidate == name
                    return table.str_ty(c.out.types)

            state.push_diagnostic(
                @c,
                data_errors.no_such_field(holder: source.span_text(s, decls[at].name), field: name, known: known, span: field)
            )
            return state.error_ty_of(c)
        .variant_decl | .constant_decl | .function_decl | .test_decl =>
            state.push_diagnostic(@c, not_a_record_name(what: source.span_text(s, base_span), span: base_span))
            return state.error_ty_of(c)

    return state.error_ty_of(c)

# `Room.name` where `Room` names a record and `name` is one of its fields,
# told from either of §4.5's modes: `expected` is the type the position asks
# for, absent where it asks for none. True where it was told, and the walk
# then gives the expression the error type.
#
# **`::` is certain only where it is the one reading** (defect 135, the
# certain-fix audit's C10). It gives the field's name, a `str`, so it is
# the repair where the position asks for a `str` and no value spelled like
# the record is bound in the declaration. Where one is, `Point.x` may be that
# value's field with the record's capital (`point.x`); where the position
# asks for nothing, the habit of Java's static field reads it as a value
# (`Config.retries.to_str()`); both took `::`, and checked clean or were
# refused anew. There `::` is a guess. Where the position asks for another
# type, `::` cannot be the repair and is not offered.
function dot_on_a_record_name(@c: state.Checker, a: ast.Ast, s: source.Source, r: resolved.Resolved, decls: [ast.Decl], base: i64, name: token.Span, expected: i64?) -> bool
    field = source.span_text(s, name)

    if !names_a_record(r, decls, base: base) || !record_has_field(s, r, decls, base: base, field: field)
        return false
    holder = source.span_text(s, a.exprs[base].span)
    span = token.Span(start: a.exprs[base].span.end, end: name.start)
    twin = value_named_like(s, r, decls, holder: holder, at: span.start)
    certainty: diag.Certainty? @ ok(.guess)
    notes: [str] @ []

    if !twin.is_err()
        notes @ notes.push(
            "`" + twin.must() + "` is bound here, and `" + twin.must() + "." + field + "` reads its field"
        )

    if !expected.is_err() && !table.poisoned(c.out.types, expected.must())
        if expected.must() == table.str_ty(c.out.types)
            if twin.is_err()
                certainty @ ok(.certain)
        else
            certainty @ fail(code: "absent", msg: "`::` gives a `str`")
            notes @ notes.push(
                "this position asks for `" + state.show(c, s, decls, expected.must()) + "`, and `" + holder + "::" + field + "` is a `str`: a field's value is read from a value that holds a `" + holder + "`"
            )
    state.push_diagnostic(
        @c,
        dot_where_colons_belong(holder: holder, field: field, span: span, certainty: certainty, notes: notes)
    )
    return true

# `Room.name` where `Room` NAMES a record and `name` IS one of its fields:
# the author may have reached for the field's name and used the wrong
# operator. Before `::` existed this could only be `record_name_alone`, a
# message about construction, which is not the mistake that was made — so
# the repair is named, with the certainty `dot_on_a_record_name` gives it.
function dot_where_colons_belong(holder: str, field: str, span: token.Span, certainty: diag.Certainty?, notes: [str]) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "dot_on_a_record_name",
        message: "`" + holder + "` names a record, so `" + holder + "." + field + "` reads a field from a value that is not there — `" + holder + "::" + field + "` is the NAME of that field, and `" + holder + "(field: value, …)` builds one",
        span: span
    )

    for note in notes
        d.notes @ d.notes.push(note)

    if !certainty.is_err()
        d.fixes @ d.fixes.push(
            diag.Fix(title: "write `::`", replacement: "::", span: span, certainty: certainty.must())
        )
    return d

# A value bound in the declaration this expression stands in whose name is
# the record's in another case, `point` for `Point`, asked of the positions
# in hand: the declaration whose span holds the expression, and every local
# whose name stands inside it, earlier or later.
function value_named_like(s: source.Source, r: resolved.Resolved, decls: [ast.Decl], holder: str, at: i64) -> str?
    for d in decls
        if d.span.start <= at && at < d.span.end
            for local in r.locals
                written = source.span_text(s, local.name)

                if local.name.start >= d.span.start && local.name.start < d.span.end && written != holder && near_names.same_ignoring_case(a: written, b: holder)
                    return ok(written)

    return fail(code: "absent", msg: "no value spelled like the record here")

# Whether `field` is one of `base`'s fields, asked of the declaration rather
# than of a type: the base names a record, so it has no type to ask.
function record_has_field(s: source.Source, r: resolved.Resolved, decls: [ast.Decl], base: i64, field: str) -> bool
    at: i64 @ 0

    match r.uses[base]
        .top t                                    => at @ t.at
        .module | .local | .builtin | .unresolved => return false

    match decls[at].kind
        .record_decl rec =>
            for candidate in rec.fields
                if source.span_text(s, candidate.name) == field
                    return true

            return false
        .variant_decl | .constant_decl | .function_decl | .test_decl => return false

    return false

# The left of `::` must be a record's name. It says what IS there rather than
# only what is missing, because the two plausible slips — a value where a type
# belongs, and a variant where a record belongs — read identically otherwise.
function not_a_record_name(what: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "not_a_record_name",
        message: "`" + what + "` does not name a record, so `" + what + "::` has no field to name — `::` takes a record's own name on its left, and `x.field` reads a field from a value",
        span: span
    )
