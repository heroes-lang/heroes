# ??? output: what the compiler already knows (design.md §4.16).
# Port of heroes/src/types/holes.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# A hole is NOT an error. The compiler reaches it, finds it has
# nothing to compute, and prints what it was about to need instead:
# the expected type, and what is in scope to build one from. §4.16's
# claim is that this costs nothing — the checker holds all of it for
# its ordinary work and normally throws it away. This file is the
# throwing-away, undone. Two normative rules: CAPPED AT 5 in
# deterministic order (unbounded "nearby functions" would flood a
# model's context and vary with layout), and a file with holes
# type-checks everything else — the report is OUTPUT, exit 0.

use ast
use source
use resolved
use check/table
use check/state
use check/render
use parse
use resolve
use checker
use check/holes_gather
use check/hole_place

# §4.16's cap, and the reason it exists: identical holes must give
# identical guidance, whatever the file's size.
constant SUGGESTIONS: i64
    5

# The report for every hole in the file, in source order.
function report(tree: ast.Ast, r: resolved.Resolved, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> str
    rows: [str] @= []
    none: [str] = []

    if c.holes.len() == 0
        return ""
    g = holes_gather.gather(r, c, decls)
    held = hole_place.holders(tree, s)

    for hole in c.holes
        # locate, never line_col plus s.name: the hole report is not a
        # Diagnostic, which is how it survived a sweep still naming
        # the root file at concatenated lines (panel 033 D2).
        found = source.locate(s, hole.span.start)

        # Every type and name below written as the hole's own file writes
        # it (defect 2205).
        reader = render.reader_of(r, module: source.module_at(s, hole.span.start))
        rows @ rows.push("hole at " + found.file + ":" + found.line.to_str() + ":" + found.col.to_str() + "\n")
        expected: i64 @= hole.expected
        is_error: bool @= false

        match table.get(c.types, hole.expected)
            .error                                                     => is_error @ true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => is_error @ is_error
            .array | .fixed | .map | .fallible | .function_ty | .named => is_error @ is_error
            .case_ty | .failure | .generic                             => is_error @ is_error

        # A hole the checker only synthesized carries no type, and its
        # place says what it asks (`check/hole_place.hero`, defect 2204).
        place = hole_place.place_of(held, c, id: hole.at)

        if is_error && place.ty >= 0
            expected @ place.ty
            is_error @ false

        if is_error && !place.statement
            asked: str @= "nothing here fixes its type"

            if place.said != ""
                asked @ place.said
            rows @ rows.push("  position: a value — " + asked + "\n")
        else if is_error
            # A hole in statement position: nothing is expected of it,
            # and "expected `?`" would be worse than saying nothing.
            rows @ rows.push("  position: statement — any type, or none\n")

        if is_error
            # Where the place fixes no type, what the model needs is what the
            # FUNCTION owes.
            owner = owner_of(g, decls, at: hole.span.start)

            if !owner.is_err()
                result = state.result_type(c, owner.must())

                if !result.is_err()
                    is_unit: bool @= false

                    match table.get(c.types, result.must())
                        .unit                                                      => is_unit @ true
                        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .error => is_unit @ is_unit
                        .array | .fixed | .map | .fallible | .function_ty | .named => is_unit @ is_unit
                        .case_ty | .failure | .generic                             => is_unit @ is_unit

                    if !is_unit
                        rows @ rows.push(
                            "  this function returns: " + render.render_read(c.types, s, decls, result.must(), none, reader: reader) + "\n"
                        )
        else
            rows @ rows.push(
                "  expected type: " + render.render_read(c.types, s, decls, expected, none, reader: reader) + "\n"
            )
        rows @ rows.push(in_scope(r, c, s, decls, id: hole.at, reader: reader))
        rows @ rows.push(fields_of(c, s, decls, expected: expected, reader: reader))
        rows @ rows.push(nearby(g, r, c, s, decls, expected: expected, at: hole.span.start, reader: reader))

    return rows.join("")

# The locals visible at the hole `id`, with their types, in the order they
# were bound: what the resolver held in scope where it met the hole
# (`resolve/names.hero`'s `hole`), never a model of it. Until defect 2203
# this read every local of the declaration whose name began before the
# hole, and so listed the binding a hole's own initialiser defines and the
# names of a block already closed. The resolver meets every `???` the
# checker does, so a hole it never met is the compiler's own fault, told
# loud by `must`.
function in_scope(r: resolved.Resolved, c: state.Checked, s: source.Source, decls: [ast.Decl], id: i64, reader: render.Reader) -> str
    none: [str] = []
    shown: [str] @= []

    for index in r.hole_scopes[id].must()
        local = r.locals[index]
        ty = state.local_type(c, index)
        marker: str @= ""

        if local.mutable
            marker @ " (mutable)"

        # A name bound to what the checker could not type, `x = ???`, has no
        # type to write: `?` reads as the fallible suffix (defect 2204's
        # widening, panel 228's critic).
        if hole_place.is_value_type(c, ty: ty) || is_unit_type(c, ty: ty)
            shown @ shown.push(
                source.span_text(s, local.name) + ": " + render.render_read(c.types, s, decls, ty, none, reader: reader) + marker
            )
        else
            shown @ shown.push(source.span_text(s, local.name) + ", its type not known here" + marker)

    if shown.len() == 0
        return ""
    rows: [str] @= ["  in scope:\n"]
    kept: i64 @= 0

    for line in shown
        if kept < SUGGESTIONS
            rows @ rows.push("    " + line + "\n")
        kept @ kept + 1

    if shown.len() > SUGGESTIONS
        rows @ rows.push("    … and " + (shown.len() - SUGGESTIONS).to_str() + " more\n")
    return rows.join("")

# The fields of the expected type, where it is a record — the hole is
# most often a value that has to be built, and the fields are what it
# is built from (§4.9: every field named, always).
function fields_of(c: state.Checked, s: source.Source, decls: [ast.Decl], expected: i64, reader: render.Reader) -> str
    decl_at: i64 @= -1
    none: [str] = []

    match table.get(c.types, expected)
        .named n                                                   => decl_at @ n.decl
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => decl_at @ decl_at
        .array | .fixed | .map | .fallible | .function_ty | .error => decl_at @ decl_at
        .case_ty | .failure | .generic                             => decl_at @ decl_at

    if decl_at == -1
        return ""

    match decls[decl_at].kind
        .record_decl rec =>
            shown: [str] @= []

            for f in rec.fields
                shown @ shown.push(
                    source.span_text(s, f.name) + ": " + typed(c, s, decls, ty: f.ty, letters: none, reader: reader)
                )

            return "  fields of " + render.written_name(s, decls, decl: decl_at, reader: reader) + ": " + shown.join(", ") + "\n"
        .variant_decl v =>
            shown: [str] @= []

            for one_case in v.cases
                shown @ shown.push("." + source.span_text(s, one_case.name))

            return "  cases of " + render.written_name(s, decls, decl: decl_at, reader: reader) + ": " + shown.join(", ") + "\n"
        .constant_decl | .function_decl | .test_decl => return ""

    return ""

# Functions whose result is the expected type, with their
# documentation — ranked by type-relevance and capped, because on a
# file with forty functions the five that RETURN WHAT IS NEEDED HERE
# are the answer. A name from another module is offered the only way
# it can be written — qualified — AND ONLY from a module this file can
# name: a hole in geom.hero offered main.tally is three errors, and
# §4.16's promise is the answer handed over, not a guess to repair.
function nearby(g: holes_gather.Gathered, r: resolved.Resolved, c: state.Checked, s: source.Source, decls: [ast.Decl], expected: i64, at: i64, reader: render.Reader) -> str
    here = source.module_at(s, at)
    is_error: bool @= false

    match table.get(c.types, expected)
        .error                                                     => is_error @ true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => is_error @ is_error
        .array | .fixed | .map | .fallible | .function_ty | .named => is_error @ is_error
        .case_ty | .failure | .generic                             => is_error @ is_error

    if is_error
        return ""
    shown: [str] @= []
    row = g.maker_at[expected]

    if row.is_err()
        return ""

    # ORDER: ascending (module, name), the order `gather` read them in, so
    # the cap picks the same five it picked when this walked every module
    # per hole (design.md §4.9).
    for m in g.makers[row.must()]
        if shown.len() == SUGGESTIONS
            break
        reachable: bool @= m.module == here || m.module == source.LIBRARY_MODULE

        if !reachable
            reachable @ !resolved.binding_in(r, from: here, module: m.module).is_err()

        if !reachable
            continue
        written: str @= m.name

        if m.module != here
            # The form the author would TYPE, which is what THIS FILE
            # calls the module — its `as` name where it has one, and the
            # path's last part where it does not (panel 100). A hole's
            # whole job is to hand back lines that can be pasted, and
            # `syntax/decl.foo(...)` cannot be.
            #
            # **No `.must()` here, and that is panel 100's engineer's own
            # defect**: it wrote one and `heroes check` answered
            # `panic: .must() on an error: absent: library`, because the
            # library is in every compilation and no file `use`s it. The
            # reachability test above is the same question, so a miss here
            # cannot happen — and the loud `continue` is what makes that
            # true rather than hoped.
            local = resolved.binding_in(r, from: here, module: m.module)

            if local.is_err()
                continue
            written @ local.must() + "." + m.name
        line: str @= written + "(" + params_read(c, s, decls, decl: m.decl, reader: reader) + ")"

        if decls[m.decl].doc.len() > 0
            line @ line + "\n      " + source.span_text(s, decls[m.decl].doc[0])
        shown @ shown.push(line)

    if shown.len() == 0
        return ""
    rows: [str] @= ["  functions that return it:\n"]

    for line in shown
        rows @ rows.push("    " + line + "\n")

    return rows.join("")

# Whether `ty` is `()`, a type a local can hold and a report writes.
function is_unit_type(c: state.Checked, ty: i64) -> bool
    return match table.get(c.types, ty)
        .unit                                                      => true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .error => false
        .array | .fixed | .map | .fallible | .function_ty | .named => false
        .case_ty | .failure | .generic                             => false

# A function's parameters as a hole's file reads them, each type the one the
# checker lowered its written type to, written by `reader`: they were the
# declaring file's own text, `lib.grow(b: Box)`, a type the reader cannot
# write (defect 2205).
function params_read(c: state.Checked, s: source.Source, decls: [ast.Decl], decl: i64, reader: render.Reader) -> str
    shown: [str] @= []

    match decls[decl].kind
        .function_decl fd =>
            letters: [str] @= []

            for g in fd.value.generics
                letters @ letters.push(source.span_text(s, g))

            for p in fd.value.params
                marker: str @= ""

                if p.mutable
                    marker @ "@"
                shown @ shown.push(
                    marker + source.span_text(s, p.name) + ": " + typed(c, s, decls, ty: p.ty, letters: letters, reader: reader)
                )
        .constant_decl | .record_decl | .variant_decl | .test_decl => return ""

    return shown.join(", ")

# A written type node as `reader` reads it, through the type the checker
# lowered it to. A declaration a report reads was checked whole, its every
# written type lowered, so one missing is the compiler's own fault, told
# loud by `must`.
function typed(c: state.Checked, s: source.Source, decls: [ast.Decl], ty: i64, letters: [str], reader: render.Reader) -> str
    return render.render_read(c.types, s, decls, state.written_type(c, ty).must(), letters, reader: reader)

# Which declaration a byte offset falls inside: the last one starting at or
# before it, found by halving where the declarations' starts ascend, which
# they do when the sources are joined in load order; where they did not, the
# walk over every declaration it replaced answers instead, so a premise that
# stopped holding would cost time and never an answer.
function owner_of(g: holes_gather.Gathered, decls: [ast.Decl], at: i64) -> i64?
    if !g.ascending
        index: i64 @= 0

        for decl in decls
            if decl.span.start <= at && at < decl.span.end
                return ok(index)
            index @ index + 1

        return fail(code: "none", msg: "no declaration holds this offset")
    low: i64 @= 0
    high: i64 @= g.starts.len()

    while low < high
        middle = (low + high) / 2

        if g.starts[middle] <= at
            low @ middle + 1
        else
            high @ middle

    if low == 0
        return fail(code: "none", msg: "no declaration holds this offset")
    found = low - 1

    if at < decls[found].span.end
        return ok(found)
    return fail(code: "none", msg: "no declaration holds this offset")

## Tests

test "a hole reports the expected type, the scope, the fields and the makers"
    text = "record Point\n    x: i64\n    y: i64\n\n# Builds the origin.\nfunction origin() -> Point\n    return Point(x: 0, y: 0)\n\nfunction main()\n    n = 3\n    p: Point @= ???\n    print(p.x + n)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    assert c.holes.len() == 1
    got = report(parsed.tree, out, c, s, parsed.decls)
    assert has_text(text: got, needle: "hole at t.hero:11:17\n")
    assert has_text(text: got, needle: "  expected type: Point\n")
    assert has_text(text: got, needle: "  in scope:\n    n: i64\n")
    assert has_text(text: got, needle: "  fields of Point: x: i64, y: i64\n")
    assert has_text(text: got, needle: "  functions that return it:\n    origin()\n      # Builds the origin.\n")
    assert !has_text(text: got, needle: "    p: Point")

test "fixedbugs: a hole lists what the resolver holds in scope there, never its own binding nor a closed block's names (defect 2203)"
    text = "function main()\n    a = 1\n    if a > 0\n        inner = 2\n        print(inner)\n    for k in [1, 2]\n        print(k)\n    x @= 0\n    x @ ???\n    d: i64 = ???\n    print(d + a + x)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    assert c.holes.len() == 2
    got = report(parsed.tree, out, c, s, parsed.decls)
    assert has_text(
        text: got,
        needle: "hole at t.hero:9:9\n  expected type: i64\n  in scope:\n    a: i64\n    x: i64 (mutable)\nhole at t.hero:10:14\n"
    )
    assert has_text(
        text: got,
        needle: "hole at t.hero:10:14\n  expected type: i64\n  in scope:\n    a: i64\n    x: i64 (mutable)\n"
    )
    assert !has_text(text: got, needle: "inner")
    assert !has_text(text: got, needle: "    k: ")
    assert !has_text(text: got, needle: "    d: ")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
