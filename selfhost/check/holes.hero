# ??? output: what the compiler already knows (design.md §4.16).
# Port of heroes/src/types/holes.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# A hole is NOT an error. The compiler reaches it, finds it has
# nothing to compute, and prints what it was about to need instead:
# the expected type, and what is in scope to build one from. §4.16's
# claim is that this costs nothing — the checker holds all of it for
# its ordinary work and normally throws it away. This file is the
# throwing-away, undone, as text: what each report holds is decided once
# in `check/hole_report.hero`, which `cli/holes_json.hero` writes as JSON
# too (panel 228's R3, provisional, author ratification pending). Two
# normative rules: CAPPED AT 5 in deterministic order, every list the cap
# cuts counted (unbounded "nearby functions" would flood a model's context
# and vary with layout), and a file with holes type-checks everything
# else — the report is OUTPUT, exit 0.

use ast
use source
use resolved
use check/state
use check/hole_report
use parse
use resolve
use checker

# The report for every hole in the file, in source order.
function report(tree: ast.Ast, r: resolved.Resolved, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> str
    return text_of(hole_report.reports(tree, r, c, s, decls))

# The reports as text, each hole a block of lines.
function text_of(reported: [hole_report.Report]) -> str
    rows: [str] @= []

    for one in reported
        rows @ rows.push("hole at " + one.file + ":" + one.line.to_str() + ":" + one.col.to_str() + "\n")

        if one.expected != ""
            rows @ rows.push("  expected type: " + one.expected + "\n")
        else if one.statement
            # A hole in statement position: nothing is expected of it, and
            # "expected `?`" would be worse than saying nothing.
            rows @ rows.push("  position: statement — any type, or none\n")
        else
            rows @ rows.push("  position: a value — " + one.asked + "\n")

        if one.returns != ""
            rows @ rows.push("  this function returns: " + one.returns + "\n")

        if one.in_scope.len() > 0
            rows @ rows.push("  in scope:\n")

            for seen in one.in_scope
                rows @ rows.push("    " + scoped(seen) + "\n")

            if one.more_in_scope > 0
                rows @ rows.push("    … and " + one.more_in_scope.to_str() + " more\n")

        if one.owner != "" && one.of_variant
            rows @ rows.push("  cases of " + one.owner + ": " + one.cases.join(", ") + "\n")
        else if one.owner != ""
            fields: [str] @= []

            for f in one.fields
                fields @ fields.push(f.name + ": " + f.ty)

            rows @ rows.push("  fields of " + one.owner + ": " + fields.join(", ") + "\n")

        if one.functions.len() > 0
            rows @ rows.push("  functions that return it:\n")

            for offered in one.functions
                rows @ rows.push("    " + offered.call + "\n")

                if offered.doc != ""
                    rows @ rows.push("      " + offered.doc + "\n")

            if one.more_functions > 0
                rows @ rows.push("    … and " + one.more_functions.to_str() + " more\n")

    return rows.join("")

# A name in scope as the text writes it: its type where the checker holds
# one, and where it holds none, `x = ???`, no `?`, which reads as the
# fallible suffix.
function scoped(seen: hole_report.Seen) -> str
    marker: str @= ""

    if seen.mutable
        marker @ " (mutable)"

    if seen.ty == ""
        return seen.name + ", its type not known here" + marker
    return seen.name + ": " + seen.ty + marker

## Tests

test "a hole reports the expected type, the scope, the fields and the makers"
    text = "record Point\n    x: i64\n    y: i64\n\n# Builds the origin.\nfunction origin() -> Point\n    return Point(x: 0, y: 0)\n\nfunction main()\n    n = 3\n    p: Point @= ???\n    print(p.x + n)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    assert c.holes.len() == 1
    got = report(parsed.tree, out, c, s, parsed.decls)
    assert has_text(text: got, needle: "hole at t.hero:11:17\n")
    assert has_text(text: got, needle: "  expected type: Point\n")
    assert has_text(text: got, needle: "  in scope:\n    n: i64\n")
    assert has_text(text: got, needle: "  fields of Point: x: i64, y: i64\n")
    assert has_text(text: got, needle: "  functions that return it:\n    origin()\n      # Builds the origin.\n")
    assert !has_text(text: got, needle: "    p: Point")

test "fixedbugs: a hole lists what the resolver holds in scope there, never its own binding nor a closed block's names (defect 2203)"
    text = "function main()\n    a = 1\n    if a > 0\n        inner = 2\n        print(inner)\n    for k in [1, 2]\n        print(k)\n    x @= 0\n    x @ ???\n    d: i64 = ???\n    print(d + a + x)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    assert c.holes.len() == 2
    got = report(parsed.tree, out, c, s, parsed.decls)
    assert has_text(
        text: got,
        needle: "hole at t.hero:9:9\n  expected type: i64\n  in scope:\n    a: i64\n    x: i64 (mutable)\nhole at t.hero:10:14\n"
    )
    assert has_text(
        text: got,
        needle: "hole at t.hero:10:14\n  expected type: i64\n  in scope:\n    a: i64\n    x: i64 (mutable)\n"
    )
    assert !has_text(text: got, needle: "inner")
    assert !has_text(text: got, needle: "    k: ")
    assert !has_text(text: got, needle: "    d: ")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
