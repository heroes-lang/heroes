# What a refused fixed array set off, withdrawn: each message the typing
# told only because a `T[N]` the sweep refuses stood where its `[T]`
# belongs (defects 423, 432 and 433; design.md §4.17, §4.19).
#
# The checker types every body before `check/ffi_sweep.hero` runs, so with
# `x: i64[2][3]` refused, `x = []` was told `type_mismatch`, `len(x)`
# `bad_operand`, `x[0][7]` `fixed_index_out_of_range` and `for row in x`
# `not_iterable`: one mistake, a message at every place it reached, each gone
# once the refusal's own repair, `[[i64]]`, is written. The typing cannot
# know the type will be refused, a group's field holding the same type
# legally.
#
# SO THE PROGRAM IS TYPED AGAIN AS THE REFUSAL REPAIRS IT, by the same stages
# (`checker.hero`'s `typed`), and a message it does not tell again, at the
# same place with the same code, is withdrawn. Each rule answers for itself:
# a `str` where the array stood, `print(x)` or a group field's own length are
# told by the repaired program too and stay, and no rule is copied here to
# guess which would pass. Only the refusal itself is kept unasked, the
# repaired program having nothing left to refuse.
#
# **Until the same night this module listed the positions** (defect 423's
# first repair, `3e92cbfb`): a binding's value, a store, a constant, a
# `return`, an argument, literals and branches, judged by whether the value
# fit the `[T]`. A use, `len(x)`, and a value through `ok(...)` or a call
# were not on the list (defects 432 and 433), and every position added would
# have been a copy of a rule the typing already holds.

use ast
use diag
use token
use parse

# The program as the refusal repairs it: every fixed array in a refused
# node, at any depth, written as the `[T]` of what it holds. Spans stay, so
# the repaired program's messages are found at the same places.
function repaired(a: ast.Ast, refused: {i64: bool}) -> ast.Ast
    out: ast.Ast @ a

    for node in range(from: 0, to: a.types.len())
        if !refused[node].is_err()
            grown(@out, node)

    return out

function grown(@a: ast.Ast, id: i64)
    match a.types[id].kind
        .fixed x =>
            a.types[id] @ ast.TypeNode(kind: .array_of(element: x.element), span: a.types[id].span)
            grown(@a, x.element)
        .array_of inner => grown(@a, inner.element)
        .fallible o     => grown(@a, o.inner)
        .map_of m =>
            grown(@a, m.key)
            grown(@a, m.value)
        .function_type f =>
            for p in f.params
                grown(@a, p)

            grown(@a, f.result)
        .named | .unit | .error => return

# What `told` keeps: the refusal, and every message `again`, the repaired
# program's typing, tells at the same place with the same code.
function reproduced(told: [diag.Diagnostic], again: [diag.Diagnostic]) -> [diag.Diagnostic]
    kept: [diag.Diagnostic] @ []

    for d in told
        if d.code == "fixed_outside_a_group" || told_again(again, d)
            kept @ kept.push(d)

    return kept

function told_again(again: [diag.Diagnostic], d: diag.Diagnostic) -> bool
    for e in again
        if e.code == d.code && e.span == d.span
            return true

    return false

## Tests

# A refused node and every fixed array inside it become arrays, the rest of
# the arena untouched; a group field's own fixed array is never refused, so
# it is never in the map.
test "the repaired program writes each refused fixed array as its [T]"
    p = parse.parse("function f(g: i64[2][3], h: u8[4]) -> i64\n    return 0\n")
    refused: {i64: bool} @ {}

    match p.decls[0].kind
        .function_decl f                                           => refused[f.value.params[0].ty] @ true
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

    grown_tree = repaired(p.tree, refused)
    arrays: i64 @ 0
    fixed: i64 @ 0

    for t in grown_tree.types
        match t.kind
            .array_of                                                      => arrays @ arrays + 1
            .fixed                                                         => fixed @ fixed + 1
            .named | .unit | .map_of | .fallible | .function_type | .error => arrays @ arrays

    # `i64[2][3]` is two arrays now; `u8[4]` was not refused and stays fixed.
    assert arrays == 2
    assert fixed == 1

test "a message the repaired program tells again stays, and the refusal stays"
    at = token.Span(start: 4, end: 9)
    elsewhere = token.Span(start: 20, end: 24)
    refusal = diag.new_diagnostic(code: "fixed_outside_a_group", message: "m", span: at)
    consequence = diag.new_diagnostic(code: "bad_operand", message: "m", span: elsewhere)
    own = diag.new_diagnostic(code: "type_mismatch", message: "m", span: elsewhere)
    kept = reproduced(told: [refusal, consequence, own], again: [own])
    assert kept.len() == 2
    assert kept[0].code == "fixed_outside_a_group"
    assert kept[1].code == "type_mismatch"
