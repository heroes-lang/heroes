# §4.9's same-typed-argument rule where the callee is a BUILT-IN — the one
# place the rule did not reach (defect 025, panel 127).
#
# A declared function's labels come from its declaration: `check/walk.hero`
# reads `fd.value.params[position].name`, a span into the source the author
# wrote, and compares the call site's label against the text at that position.
# A Tier-1 built-in has no declaration and therefore no span, so the name has
# to be a `str` the compiler carries: `inventory.labelled_of`.
#
# Both halves of the rule live here, because they are one rule: a missing label
# is `needs_label` and a label at the wrong position is `wrong_label`. The
# second half is what kills the mutation the first half only discourages —
# `heroes mutate --operator swap-args` moves the label WITH its value
# (`selfhost/mutate/edits.hero:29`), so a swapped `fail(code:, msg:)` is a
# legal-looking call whose labels are in the wrong order.
#
# **And the question every call asks before it writes a missing label**
# (defect 135): what else the argument could be. A label written in position
# order is certain only where nothing else could stand there, so each kind of
# call, a declared function, a function value, a built-in, a record or a case,
# asks it here of what it holds: the other positions of the argument's type,
# and marker, that no label of the call has taken.

use token
use diag
use ast
use source
use label_errors
use resolved
use inventory
use check/table
use check/state
use check/contextual

# One argument of a built-in call: refuse it if the rule names this position
# and the call site does not, or names it wrongly. `position` counts the
# receiver, because `xs.slice(1, 3)` and `slice(xs, 1, 3)` are the same call.
# `taken` are the labels the call writes. A built-in's labelled positions share
# its one type (`inventory.labelled`), so an unlabelled argument could be any
# of them not taken: `fail("empty", "no first element")` may mean either order.
function check_label(@c: state.Checker, s: source.Source, name: str, position: i64, written: token.Span?, value_span: token.Span, taken: [str])
    entry = inventory.labelled_of(name)

    if entry.is_err()
        return
    params = entry.must().params

    if position >= params.len()
        return

    if params[position].len() == 0
        return
    wanted = params[position]

    others = unwritten(params: params, position: position, taken: taken)

    if written.is_err()
        state.push_diagnostic(
            @c,
            label_errors.needs_label(name: name, expected: wanted, shared: entry.must().shared, others: others, span: value_span, at: value_span.start)
        )
        return
    seen = source.span_text(s, written.must())

    if seen != wanted
        # A label naming another position is a swap, and offers its own
        # position's name alone; one naming nothing could be any position
        # no label writes, all of one type here.
        elsewhere = names_a_position(params, seen)
        readings: [str] @ others

        if elsewhere
            readings @ []
        state.push_diagnostic(
            @c,
            label_errors.wrong_label(holder: name, written: seen, expected: wanted, elsewhere: elsewhere, doubled: listed(taken, wanted), others: readings, span: written.must())
        )

# The labelled positions of a built-in other than `position` that no label of
# the call writes: what else its argument could be.
function unwritten(params: [str], position: i64, taken: [str]) -> [str]
    others: [str] @ []
    q: i64 @ 0

    for label in params
        if q != position && label.len() > 0 && !listed(taken, label)
            others @ others.push(label)
        q @ q + 1

    return others

# Whether the label the author wrote names another position of this built-in,
# which is what makes the fix a guess rather than a repair (`label_errors`).
function names_a_position(params: [str], written: str) -> bool
    for p in params
        if p.len() > 0 && p == written
            return true

    return false

# The labels a call writes, in order.
function written_labels(s: source.Source, given: [ast.Arg]) -> [str]
    out: [str] @ []

    for arg in given
        if !arg.name.is_err()
            out @ out.push(source.span_text(s, arg.name.must()))

    return out

function listed(xs: [str], x: str) -> bool
    for it in xs
        if it == x
            return true

    return false

function holds(xs: [i64], x: i64) -> bool
    for it in xs
        if it == x
            return true

    return false

# A label that is not its position's name, at a declared function, a function
# value or a construction (`check/walk.hero`; a built-in's is `check_label`).
# What its fix's certainty rests on is a fact about the call in hand: a label
# naming ANOTHER position is an argument swap wearing labels, and renaming it
# leaves both values where they are (panel 127's compiler seat measured the
# program printing the other answer); one naming nothing is renamed by its
# position only where nothing else could stand there (`other_labels`).
# `every` is each position's name and `open` the same with "" where only its
# own argument can stand (`open_names`). Asked once the argument is checked,
# because what else a label naming nothing could be asks its type.
function misnamed(c: state.Checker, a: ast.Ast, s: source.Source, decls: [ast.Decl], holder: str, label: token.Span, every: [str], open: [str], types: [i64], at: i64, from: i64, value: i64, taken: [str]) -> diag.Diagnostic
    written = source.span_text(s, label)
    expected = every[at]
    elsewhere = listed(every, written)
    others: [str] @ []

    if !elsewhere
        others @ other_labels(c, a, decls, names: open, types: types, at: at, from: from, value: value, taken: taken)
    return label_errors.wrong_label(
        holder: holder,
        written: written,
        expected: expected,
        elsewhere: elsewhere,
        doubled: listed(taken, expected),
        others: others,
        span: label
    )

# What else a label that names no position could be (defect 135, C3): a
# position past the receiver (`from`) with a name, that no label of the call
# writes, of the type this position has or of one the argument can take. With
# none, the position the label stands at is all the argument can be, and its
# rename is certain: `Size(height: 640, widht: 480)`. With one,
# `Size(widht: 640, heigth: 480)` may be the two names swapped as much as
# misspelt, and renaming by position binds 640 to `height` in a program that
# checks clean. The position's own type counts as well as the argument's,
# because a type parameter's position takes what the argument's type does
# not name.
function other_labels(c: state.Checker, a: ast.Ast, decls: [ast.Decl], names: [str], types: [i64], at: i64, from: i64, value: i64, taken: [str]) -> [str]
    out: [str] @ []
    q: i64 @ from

    while q < names.len() && q < types.len()
        fits = types[q] == types[at] || could_take(c, a, decls, value: value, ty: types[q])

        if q != at && names[q].len() > 0 && !listed(taken, names[q]) && fits
            out @ out.push(names[q])
        q @ q + 1

    return out

# The same at a declared function, whose names are its parameters'.
function misnamed_parameter(c: state.Checker, a: ast.Ast, s: source.Source, decls: [ast.Decl], holder: str, label: token.Span, declared: [ast.Param], types: [i64], ambiguous: [i64], given: [ast.Arg], at: i64, from: i64, value: i64, taken: [str]) -> diag.Diagnostic
    return misnamed(
        c,
        a,
        s,
        decls,
        holder: holder,
        label: label,
        every: parameter_names(s, declared),
        open: open_names(s, declared, ambiguous: ambiguous, given: given, from: from),
        types: types,
        at: at,
        from: from,
        value: value,
        taken: taken
    )

# A declared function's parameter names, and the same with "" where a label
# could not mean that position: a parameter called `_`, and a position whose
# type no other shares holding an unlabelled argument, which stands there by
# §4.9's rule and not by the order written.
function parameter_names(s: source.Source, declared: [ast.Param]) -> [str]
    out: [str] @ []

    for p in declared
        out @ out.push(source.span_text(s, p.name))

    return out

function open_names(s: source.Source, declared: [ast.Param], ambiguous: [i64], given: [ast.Arg], from: i64) -> [str]
    out: [str] @ []
    q: i64 @ 0

    for p in declared
        name: str @ source.span_text(s, p.name)
        argument = q - from

        if name == "_"
            name @ ""

        if argument >= 0 && argument < given.len() && given[argument].name.is_err() && !holds(ambiguous, q)
            name @ ""
        out @ out.push(name)
        q @ q + 1

    return out

# The other parameters an unlabelled argument at position `at` of a declared
# function could be: among `ambiguous`, the positions whose type another
# shares, those of its type, past the UFCS receiver (`from`), whose name no
# label of the call writes. Its `@` or none tells the positions apart only
# where it agrees with its own position's: `add_to(@t, 5)` over
# `add_to(@total, amount)` has one reading, while `swap(x, y)` over
# `swap(@a, @b)` lacks both markers, which is `marker_mismatch`'s to say and
# says nothing about the order.
function other_parameters(s: source.Source, declared: [ast.Param], types: [i64], ambiguous: [i64], at: i64, from: i64, taken: [str], mutable: bool) -> [str]
    out: [str] @ []
    marker_tells = declared[at].mutable == mutable

    for q in ambiguous
        name = source.span_text(s, declared[q].name)
        same_marker = !marker_tells || declared[q].mutable == mutable

        if q != at && q >= from && types[q] == types[at] && same_marker && !listed(taken, name)
            out @ out.push(name)

    return out

# The same through a function value, whose type carries the names: a named
# position of the same type, past the receiver, that no label takes.
function other_names(names: [str], types: [i64], at: i64, from: i64, taken: [str]) -> [str]
    out: [str] @ []
    q: i64 @ from

    while q < names.len() && q < types.len()
        if q != at && names[q].len() > 0 && types[q] == types[at] && !listed(taken, names[q])
            out @ out.push(names[q])
        q @ q + 1

    return out

# The other fields an unlabelled argument at `at` of a construction could
# fill: those no label takes whose type the argument takes, a literal's by
# what it adopts (`contextual.adopts`) and anything else's by the type it was
# checked to have. Asked once every argument is checked, since the fields
# may be of several types and only the argument tells which it can be.
function other_fields(c: state.Checker, a: ast.Ast, decls: [ast.Decl], names: [str], types: [i64], at: i64, value: i64, taken: [str]) -> [str]
    out: [str] @ []
    q: i64 @ 0

    while q < names.len() && q < types.len()
        if q != at && !listed(taken, names[q]) && could_take(c, a, decls, value: value, ty: types[q])
            out @ out.push(names[q])
        q @ q + 1

    return out

function could_take(c: state.Checker, a: ast.Ast, decls: [ast.Decl], value: i64, ty: i64) -> bool
    if contextual.contextual(a, value)
        return contextual.adopts(c, a, decls, id: value, offered: ty)
    return c.out.expr_types[value] == ty

# A declared function used as a VALUE carries its parameter names into its
# type, and only where §4.9 needs them: two positions of one type. Anywhere
# else the type stays bare, so `(function(i64, str) -> ())` is ONE type however
# it was reached, and `check/type_labels.hero`'s two rules and this one agree
# on which types have names.
#
# Defect 026 is why it is not decoration. Without it an annotation could rename
# the positions of the function assigned to it — `f: (function(msg: str, code:
# str) -> str) @ report` where `report` is `(code, msg)` — and the call site
# would obey the annotation while the callee obeyed itself. With the names in
# the type's identity (`check/table.hero`) that assignment is a mismatch.
# Moved here from `check/walk.hero` on 2026-10-03 (lane flow4), unchanged,
# beside the rule that reads labels at a call: it calls nothing back in the
# walk, and the walk's decided ceiling had no room for panel 185's R4.
function declared_labels(s: source.Source, params: [ast.Param], lowered: [i64]) -> [str]
    names: [str] @ []
    none: [str] = []
    any_shared: bool @ false
    i: i64 @ 0

    while i < lowered.len()
        written = source.span_text(s, params[i].name)

        if table.shared_at(lowered, at: i) && written != "_"
            any_shared @ true
            names @ names.push(written)
        else

            # Two reasons for an empty name, and they are the same reason. A
            # position nothing can be confused with needs none, so two
            # declarations differing only in what they call THAT parameter are
            # one type. And a position the body called `_` makes no claim about
            # itself — which is what `_` means at every other site in this
            # language — so it fits whatever the expected type calls it
            # (`table.fits`). Panel 129's ffi seat is why: zlib's `free_func`
            # ignores `opaque` in most implementations and reads it in the ones
            # that pool, and one header typedef takes both.
            names @ names.push("")
        i @ i + 1

    if !any_shared
        return none

    return names

## Tests

test "a positional argument of fail is refused with the label to write"
    r = resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "    return fail(\"empty_list\", \"there is no first element\")\n")
    none: token.Span? @ fail(code: "absent", msg: "written positionally")
    nothing: [str] = []
    check_label(
        @c,
        s,
        name: "fail",
        position: 0,
        written: none,
        value_span: token.Span(start: 16, end: 28),
        taken: nothing
    )
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].code == "needs_label"

    # Defect 135: the order written may not be the order meant, so `code:`
    # is one reading and `msg:` the other, and neither is applied.
    assert c.out.diagnostics[0].message == "two of `fail`'s parameters are `str`, so every one of them is named at the call site — this one is `code` in the order written, or `msg` in the other order"
    assert c.out.diagnostics[0].fixes.len() == 2
    assert c.out.diagnostics[0].fixes[0].replacement == "code: "
    assert c.out.diagnostics[0].fixes[0].certainty == .guess
    assert c.out.diagnostics[0].fixes[0].span.start == 16
    assert c.out.diagnostics[0].fixes[0].span.end == 16

    # With `msg:` written elsewhere, `code` is all this one can be.
    one: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    taken: [str] = ["msg"]
    check_label(
        @one,
        s,
        name: "fail",
        position: 0,
        written: none,
        value_span: token.Span(start: 16, end: 28),
        taken: taken
    )
    assert one.out.diagnostics[0].fixes.len() == 1
    assert one.out.diagnostics[0].fixes[0].certainty == .certain

test "a label in the wrong position is the swap, and it is refused too"
    r = resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "fail(msg: \"m\", code: \"c\")\n")
    at: token.Span? @ ok(token.Span(start: 5, end: 8))
    taken: [str] = ["msg", "code"]
    check_label(@c, s, name: "fail", position: 0, written: at, value_span: token.Span(start: 10, end: 13), taken: taken)
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].code == "wrong_label"
    assert c.out.diagnostics[0].message == "`fail` has nothing called `msg` at this position — it is `code`"
    assert c.out.diagnostics[0].fixes[0].replacement == "code"

test "the receiver's position is exempt and the right label passes"
    r = resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "xs.slice(from: 1, to: 3)\n")
    none: token.Span? @ fail(code: "absent", msg: "the receiver is the dot")
    taken: [str] = ["from", "to"]
    check_label(
        @c,
        s,
        name: "slice",
        position: 0,
        written: none,
        value_span: token.Span(start: 0, end: 2),
        taken: taken
    )
    right: token.Span? @ ok(token.Span(start: 9, end: 13))
    check_label(
        @c,
        s,
        name: "slice",
        position: 1,
        written: right,
        value_span: token.Span(start: 15, end: 16),
        taken: taken
    )
    assert c.out.diagnostics.len() == 0

    # And a built-in with no same-typed pair says nothing at any position.
    check_label(@c, s, name: "join", position: 1, written: none, value_span: token.Span(start: 0, end: 2), taken: taken)
    assert c.out.diagnostics.len() == 0

# Defect 135, C3: `fail(msg: "m", cdoe: "e")`. `cdoe` names nothing, and its
# position's name, `msg`, is written by the first label, while `code` is
# written by none: the order written is one reading of two, and neither
# rename is applied. With `msg` in its place, `code` is all `cdoe` can be.
test "a built-in's label naming nothing is certain only where nothing else could stand there"
    r = resolved.new_resolved()
    c: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "fail(msg: \"m\", cdoe: \"e\")\n")
    at: token.Span? @ ok(token.Span(start: 15, end: 19))
    swapped: [str] = ["msg", "cdoe"]
    check_label(
        @c,
        s,
        name: "fail",
        position: 1,
        written: at,
        value_span: token.Span(start: 21, end: 24),
        taken: swapped
    )
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].message == "`fail` has nothing called `cdoe` at this position — it is `msg` in the order written, or `code` in the other order"
    assert c.out.diagnostics[0].fixes.len() == 2
    assert c.out.diagnostics[0].fixes[0].certainty == .guess
    assert c.out.diagnostics[0].fixes[1].replacement == "code"
    placed: state.Checker @ state.new_checker(out_of: r, expr_count: 0)
    t = source.new_source(name: "t.hero", text: "fail(cdoe: \"e\", msg: \"m\")\n")
    first: token.Span? @ ok(token.Span(start: 5, end: 9))
    in_place: [str] = ["cdoe", "msg"]
    check_label(
        @placed,
        t,
        name: "fail",
        position: 0,
        written: first,
        value_span: token.Span(start: 11, end: 14),
        taken: in_place
    )
    assert placed.out.diagnostics[0].fixes.len() == 1
    assert placed.out.diagnostics[0].fixes[0].replacement == "code"
    assert placed.out.diagnostics[0].fixes[0].certainty == .certain
    assert unwritten(params: ["code", "msg"], position: 0, taken: in_place).len() == 0
