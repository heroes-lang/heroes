# The EXTENT of a `ptr` lend: declared on the group's parameter, landed on by
# the lend (design.md §4.19, §1.12; panel 166's route C, ratified 2026-09-19;
# defect 063).
#
# WHY A LEND NEEDS ONE. `f.ptr()` hands C the address of a fixed byte field and
# nothing else: how far C reads or writes through it is the CALL's word, and
# until this module nothing related that word to the field. `sl_fill(p:
# s.name.ptr(), n: 64)` on an `i8[8]` moved the sibling `id` to `0x41414141` at
# exit 0 with every suite green, and every overshoot from 9 to 4096 bytes was
# as silent (panel 166's critic). The relation has to be DECLARED: `f(p: ptr,
# n: i64)` is two independent parameters, and the sentence defect 063's first
# entry rested on — *the extent argument is checked* — was corrected as
# unimplementable the day it was written, because nothing says which argument
# that is.
#
# THE DECLARATION IS `counted_by`, ON THE POINTER, NAMING ITS SIBLING:
# `function read(fd: i32, buf: ptr counted_by n, n: u64) -> i64`. It is the
# spelling Apple's SDK and the Linux kernel use for the same relation
# (`__counted_by`), and it is `owned`'s and `acquires`'s shape here: a
# declaration-site mark the checker reads, the lowering drops, and the emitter
# turns into one C assertion where the extent is a constant
# (`emit/lend_extent.hero`). Three things are judged about the mark, each a fact
# about the declaration in hand and never about the world: the marked parameter
# is a `ptr` or a group's record lent whole through `@`, the name is a sibling,
# and the sibling is an integer C takes by value or reads through an `@` cell.
#
# THE RECORD AND THE CELL SINCE PANEL 194's R7 (defect 092). `read(fd: 0, buf:
# @h, n: 4096)` into a 48-byte `addrinfo` wrote 4048 bytes over the stack at
# `check` 0, because a record lent whole had no word to tie it to its count; it
# takes `counted_by` now, and an undeclared one the header takes as `void *` is
# refused at the build (`emit/ffi_unit.hero`). A count C reads through a
# pointer, `getsockopt`'s `socklen_t *optlen`, is an `@` cell: the call is
# compared with the value it holds on the way in, which is what C reads.
#
# AND THE SECOND MARK IS `lent`, SINCE PANEL 171: `function strlen(s: cstr
# lent) -> u64`, the declaration's word for *this call keeps nothing of what
# it is handed*. The author's ruling of 2026-09-20 made the default the
# pessimistic one — a C parameter is assumed to KEEP what it is handed unless
# its declaration says otherwise — because a lend lives for its call and no
# longer, and a pointer C kept past it reads bytes the program has since
# changed or freed, at exit 0 and past every sanitizer (defects 066 and 068).
# Like `counted_by` it is judged here as a fact about the declaration: read on
# a by-value `cstr` or a counted `ptr`, refused anywhere else as dead text.
#
# THIS MODULE JUDGES THE MARKS WHERE THEY ARE DECLARED, AND NOWHERE ELSE. Where
# a lend LANDS — which declaration a call reaches, at which position, and
# whether that parameter says what the lend needs — is `check/lend_landing.hero`,
# the other half of what was one file until the third question put it past
# §11's 300 lines. Absence is a refusal and never silence over there, for the
# header, the extent and the word alike (panel 166's engineer's condition, and
# the author's ruling at 171), and a reader meets one message per lend.

use ast
use token
use source
use handles
use check/state
use check/table
use check/lower
use check/ffi_buffer
use ffi_errors
use digits
use widths
use parse
use resolve

## The declaration

# Every `counted_by` in an extern signature, judged where it is written. A
# parameter whose type the boundary check already refused (`refused`, by
# position) is not judged again: one mistake, one message (panel 196's R8).
#
# WHAT THE MARK MAY NAME, SINCE PANEL 196's R5: the sibling C reads the count
# from, as before; a `constant` of the same group, the header's own macro
# (`SHA256_DIGEST_LENGTH`), whose value only C knows and which the emitter
# writes by its name; or a number, `counted_by 32`, at least one. A name that
# is a sibling is the sibling, whatever the group also declares.
function declared_extents(@c: state.Checker, a: ast.Ast, s: source.Source, decls: [ast.Decl], f: ast.FunctionDecl, declared_name: token.Span, refused: {i64: bool})
    function_name = source.span_text(s, declared_name)
    position: i64 @ 0 - 1

    for param in f.params
        position @ position + 1

        if param.counted_by.is_err() || !refused[position].is_err()
            continue
        mark = param.counted_by.must()
        param_name = source.span_text(s, param.name)
        sibling_name = source.span_text(s, mark)
        why: str @ ""

        if !is_ptr(c, param.ty) && !lent_whole(c, decls, param) && !ffi_buffer.is_array_out(c, param)
            why @ "`counted_by` says how far C reads or writes through a `ptr`, through a group's record lent whole with `@`, or through an array lent with `@` as a buffer, and `" + param_name + "` is none of them"
        sibling = sibling_named(f, s, owner: param.name, name: sibling_name)
        literal = is_literal(sibling_name)

        if why == "" && literal
            why @ literal_why(text: sibling_name)
        else if why == "" && sibling.is_err()
            why @ constant_why(a, s, decls, f: f, name: sibling_name, function_name: function_name)
        else if why == "" && !sibling.is_err() && !integer_count(c, sibling.must())
            why @ "`" + sibling_name + "` is not an integer C takes by value or reads through an `@` cell, so it cannot say how far C reads — an extent is `i32`, `u64`, or another width the header spells"

        if why != ""
            state.push_diagnostic(
                @c,
                ffi_errors.counted_by_shape(parameter: param_name, function_name: function_name, why: why, span: mark)
            )

# Whether a mark's text is a number, `counted_by 32`: the lexer starts every
# integer literal with a digit and every name with something else.
function is_literal(text: str) -> bool
    return text.len() > 0 && text[0] >= '0' && text[0] <= '9'

# Why a stated number is no extent, or "" where it is one: at least one
# element, and no more than an `i64` counts, which is what the emitter hands
# the runtime.
function literal_why(text: str) -> str
    value = digits.decode_int(digits.canonical_int(text))

    if value.is_err()
        return "`" + text + "` is more elements than an `i64` counts, and no buffer C can be handed holds that many"

    if value.must() < 1
        return "`" + text + "` states no element at all — a stated extent is the number of elements C reaches, at least one"
    return ""

# Why a name that is no sibling is no extent either, or "" where it is a
# `constant` of the function's own group, of an integer type: the header's
# macro, which C reads where the call is compiled. The group is the header
# the two declarations were written under, compared by its text.
function constant_why(a: ast.Ast, s: source.Source, decls: [ast.Decl], f: ast.FunctionDecl, name: str, function_name: str) -> str
    nowhere = "`" + name + "` names no other parameter of `" + function_name + "` and no `constant` of its group — the extent is the sibling C reads the count from, a constant the group declares from the header, or the number itself"

    if f.header.is_err()
        return nowhere
    header = source.span_text(s, f.header.must())

    for d in decls
        if source.span_text(s, d.name) == name
            match d.kind
                .constant_decl k =>
                    if k.header.is_err()
                        return nowhere

                    if source.span_text(s, k.header.must()) != header
                        return "`" + name + "` is a `constant` of the group of " + source.span_text(s, k.header.must()) + ", and the extent's macro must be one the header declaring `" + function_name + "` defines — declare the constant in that function's own group"

                    # The type AS WRITTEN, never `written_type`: that table is
                    # filled in declaration order, so a constant declared below
                    # the function, or in a later group, has no entry yet, and
                    # declaration order never matters (§ 4).
                    if !int_spelled(source.span_text(s, a.types[k.ty].span))
                        return "`" + name + "` is not an integer constant, so it counts no elements — an extent is a whole number of what C's pointer points at"
                    return ""
                .function_decl | .record_decl | .variant_decl | .test_decl => return nowhere

    return nowhere

# Whether a type as written is one of the eight integer widths.
function int_spelled(text: str) -> bool
    for kind in widths.int_kinds()
        if widths.int_name(kind) == text
            return true

    return false

# The parameter of this signature with that name, other than the one carrying
# the mark: `p: ptr counted_by p` names no sibling.
function sibling_named(f: ast.FunctionDecl, s: source.Source, owner: token.Span, name: str) -> ast.Param?
    for param in f.params
        if param.name.start != owner.start && source.span_text(s, param.name) == name
            return ok(param)

    return fail(code: "none", msg: "no such sibling")

function is_ptr(c: state.Checker, ty: i64) -> bool
    written = state.written_type(c.out, ty)

    if written.is_err()
        return false
    return table.get(c.out.types, written.must()) == .ptr

function is_cstr(c: state.Checker, ty: i64) -> bool
    written = state.written_type(c.out, ty)

    if written.is_err()
        return false
    return table.get(c.out.types, written.must()) == .cstr

# Every `lent` in an extern signature, judged where it is written (panel 171).
# The word is read on a by-value `cstr` or a `ptr` that declares its extent —
# the two parameters a lend can land on — and, since panel 196's R3, on every
# `@` parameter, where it says C keeps nothing of the ADDRESS after the call:
# an `@` argument is the place itself (R1), and a temporary the emitter makes
# for a call, the buffer C fills (R4), reaches only a parameter so declared.
# Elsewhere nothing reads it: on a handle or a number by value nothing is
# lent, and a `ptr` with no `counted_by` refuses every lend before the word is
# read. Unread, it is
# refused, which is `check/marks.hero`'s rule for the handle words applied to
# this one. The word landed one commit before this rule did, so the seed
# compiler that built this one could parse the marks it writes on the
# compiler's own bindings (`seed/README.md`'s chain; the one-commit landing was
# run and broke at `selfhost/cli/process.hero:42:40` with no binary).
function declared_lends(@c: state.Checker, s: source.Source, f: ast.FunctionDecl, declared_name: token.Span)
    for param in f.params
        if !param.lent
            continue
        param_name = source.span_text(s, param.name)
        why: str @ ""

        if param.mutable
            continue

        if !is_ptr(c, param.ty) && !is_cstr(c, param.ty)
            why @ "`" + param_name + "` is not a `cstr` or a `ptr`, and only those two are ever lent"
        else if is_ptr(c, param.ty) && param.counted_by.is_err()
            why @ "`" + param_name + "` is a `ptr` that declares no extent, and a `ptr` lend reaches only a parameter declared `counted_by` — nothing is ever lent here, so the word is dead text; write `counted_by <n> lent`"

        if why != ""
            state.push_diagnostic(
                @c,
                ffi_errors.lent_shape(parameter: param_name, function_name: source.span_text(s, declared_name), why: why, span: param.name)
            )

# A group's record lent whole: an `@` parameter whose type is a record of a
# group and not a handle, which is a pointer already and lends nothing.
function lent_whole(c: state.Checker, decls: [ast.Decl], param: ast.Param) -> bool
    written = state.written_type(c.out, param.ty)

    if !param.mutable || written.is_err()
        return false

    match table.get(c.out.types, written.must())
        .named n =>
            match decls[n.decl].kind
                .record_decl r => return !r.header.is_err() && !handles.is_handle(decls[n.decl])
                .constant_decl | .function_decl | .variant_decl | .test_decl => return false
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .array | .fixed | .map | .fallible | .function_ty         => return false
        .case_ty | .failure | .generic | .error                   => return false

    return false

# An integer: one the header takes by value, or an `@` cell C reads the count
# from (panel 194's R7), the way `getsockopt` reads `*optlen`. A float, a
# `bool` and a pointer are refused as extents.
function integer_count(c: state.Checker, param: ast.Param) -> bool
    written = state.written_type(c.out, param.ty)

    if written.is_err()
        return false

    match table.get(c.out.types, written.must())
        .int_ty                                                    => return true
        .float_ty | .bool | .str | .ptr | .cstr | .unit            => return false
        .array | .fixed | .map | .fallible | .function_ty | .named => return false
        .case_ty | .failure | .generic | .error                    => return false

    return false

## Tests

# A bare checker and the lowering loop, which is `check/lending.hero`'s shape
# and for its reason one level up: `checker.hero` imports THAT module, and this
# one is imported by it, so a `use checker` here would be a module cycle the
# language refuses outright. The lowering loop is not decoration —
# `declared_extents` reads `written_types`, and `lower_ty` is what fills it.
function shape_refusals(text: str) -> i64
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checker @ state.new_checker(out_of: out, expr_count: p.tree.exprs.len())
    i: i64 @ 0

    while i < p.tree.types.len()
        _ = lower.lower_ty(@c, p.tree, out, i)
        i @ i + 1

    for decl in p.decls
        match decl.kind
            .function_decl fd =>
                if fd.value.is_extern
                    none: {i64: bool} = {}
                    declared_extents(@c, p.tree, s, p.decls, f: fd.value, declared_name: decl.name, refused: none)
            .constant_decl | .record_decl | .variant_decl | .test_decl =>
                _ = 0

    n: i64 @ 0

    for d in c.out.diagnostics
        if d.code == "counted_by_shape"
            n @ n + 1

    return n

test "the three shapes of a wrong mark are refused, and the right one is quiet"
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 0
    assert shape_refusals("extern \"s.h\"\n    function f(p: i64 counted_by n, n: i64) -> i64\n\nfunction main()\n    print(f(p: 0, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by m, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, n: f64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0.0))\n") == 1

test "a mark naming its own parameter names no extent, and an `@` cell is a count C reads"
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by p, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, @n: i64) -> i64\n\nfunction main()\n    k: i64 @ 0\n    print(f(p: nullptr, @k))\n") == 0
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, @n: f64) -> i64\n\nfunction main()\n    k: f64 @ 0.0\n    print(f(p: nullptr, @k))\n") == 1

# Panel 194's R7: a group's record lent whole through `@` takes the mark; the
# same record by value lends nothing, and a handle is a pointer already.
test "a record lent whole takes counted_by, by value and as a handle it does not"
    one = "extern \"s.h\"\n    record One tag one\n        a: i32\n    record Op tag opaque\n"
    assert shape_refusals(one + "    function f(@b: One counted_by n, n: u64) -> i64\n\nfunction main()\n    print(1)\n") == 0
    assert shape_refusals(one + "    function f(b: One counted_by n, n: u64) -> i64\n\nfunction main()\n    print(1)\n") == 1
    assert shape_refusals(one + "    function f(@h: Op counted_by n, n: u64) -> i64\n\nfunction main()\n    print(1)\n") == 1

# Panel 196's R5: the declaration may state the extent itself, a number of at
# least one or a constant of its own group, of an integer type.
test "a stated extent is a number of at least one or an integer constant of the function's own group"
    group = "extern \"s.h\"\n    constant LEN: i64\n    constant SCALE: f64\n"
    other = "extern \"o.h\"\n    constant OTHER: i64\n"
    tail = "\nfunction main()\n    print(1)\n"
    assert shape_refusals(group + "    function f(p: ptr counted_by 32)\n" + tail) == 0
    assert shape_refusals(group + "    function f(p: ptr counted_by 0x20)\n" + tail) == 0
    assert shape_refusals(group + "    function f(p: ptr counted_by LEN)\n" + tail) == 0
    assert shape_refusals(group + "    function f(p: ptr counted_by 0)\n" + tail) == 1
    assert shape_refusals(group + "    function f(p: ptr counted_by 99999999999999999999)\n" + tail) == 1
    assert shape_refusals(group + "    function f(p: ptr counted_by SCALE)\n" + tail) == 1
    assert shape_refusals(group + "    function f(p: ptr counted_by OTHER)\n" + other + tail) == 1
    assert shape_refusals(group + "    function f(p: ptr counted_by LEN, LEN: u64)\n" + tail) == 0
