# The EXTENT of a `ptr` lend: declared on the group's parameter, landed on by
# the lend (design.md §4.19, §1.12; panel 166's route C, ratified 2026-09-19;
# defect 063).
#
# WHY A LEND NEEDS ONE. `f.ptr()` hands C the address of a fixed byte field and
# nothing else: how far C reads or writes through it is the CALL's word, and
# until this module nothing related that word to the field. `sl_fill(p:
# s.name.ptr(), n: 64)` on an `i8[8]` moved the sibling `id` to `0x41414141` at
# exit 0 with every suite green, and every overshoot from 9 to 4096 bytes was
# as silent (panel 166's critic). The relation has to be DECLARED: `f(p: ptr,
# n: i64)` is two independent parameters, and the sentence defect 063's first
# entry rested on — *the extent argument is checked* — was corrected as
# unimplementable the day it was written, because nothing says which argument
# that is.
#
# THE DECLARATION IS `counted_by`, ON THE POINTER, NAMING ITS SIBLING:
# `function read(fd: i32, buf: ptr counted_by n, n: u64) -> i64`. It is the
# spelling Apple's SDK and the Linux kernel use for the same relation
# (`__counted_by`), and it is `owned`'s and `acquires`'s shape here: a
# declaration-site mark the checker reads, the lowering drops, and the emitter
# turns into one C assertion where the extent is a constant
# (`emit/lend_extent.hero`). Three things are judged about the mark, each a fact
# about the declaration in hand and never about the world: the marked parameter
# is a `ptr`, the name is a sibling, and the sibling is an integer C takes by
# value.
#
# AND THE SECOND MARK IS `lent`, SINCE PANEL 171: `function strlen(s: cstr
# lent) -> u64`, the declaration's word for *this call keeps nothing of what
# it is handed*. The author's ruling of 2026-09-20 made the default the
# pessimistic one — a C parameter is assumed to KEEP what it is handed unless
# its declaration says otherwise — because a lend lives for its call and no
# longer, and a pointer C kept past it reads bytes the program has since
# changed or freed, at exit 0 and past every sanitizer (defects 066 and 068).
# Like `counted_by` it is judged here as a fact about the declaration: read on
# a by-value `cstr` or a counted `ptr`, refused anywhere else as dead text.
#
# THIS MODULE JUDGES THE MARKS WHERE THEY ARE DECLARED, AND NOWHERE ELSE. Where
# a lend LANDS — which declaration a call reaches, at which position, and
# whether that parameter says what the lend needs — is `check/lend_landing.hero`,
# the other half of what was one file until the third question put it past
# §11's 300 lines. Absence is a refusal and never silence over there, for the
# header, the extent and the word alike (panel 166's engineer's condition, and
# the author's ruling at 171), and a reader meets one message per lend.

use ast
use token
use source
use check/state
use check/table
use check/lower
use ffi_errors
use parse
use resolve

## The declaration

# Every `counted_by` in an extern signature, judged where it is written.
function declared_extents(@c: state.Checker, s: source.Source, f: ast.FunctionDecl, declared_name: token.Span)
    function_name = source.span_text(s, declared_name)

    for param in f.params
        if param.counted_by.is_err()
            continue
        mark = param.counted_by.must()
        param_name = source.span_text(s, param.name)
        sibling_name = source.span_text(s, mark)
        why: str @ ""

        if !is_ptr(c, param.ty)
            why @ "`counted_by` says how far C reads or writes through a `ptr`, and `" + param_name + "` is not one"
        sibling = sibling_named(f, s, owner: param.name, name: sibling_name)

        if why == "" && sibling.is_err()
            why @ "`" + sibling_name + "` names no other parameter of `" + function_name + "` — the extent is a sibling in the same signature, the one C reads the count from"

        if why == "" && !integer_by_value(c, sibling.must())
            why @ "`" + sibling_name + "` is not an integer C takes by value, so it cannot say how far C reads — an extent is `i32`, `u64`, or another width the header spells"

        if why != ""
            state.push_diagnostic(
                @c,
                ffi_errors.counted_by_shape(parameter: param_name, function_name: function_name, why: why, span: mark)
            )

# The parameter of this signature with that name, other than the one carrying
# the mark: `p: ptr counted_by p` names no sibling.
function sibling_named(f: ast.FunctionDecl, s: source.Source, owner: token.Span, name: str) -> ast.Param?
    for param in f.params
        if param.name.start != owner.start && source.span_text(s, param.name) == name
            return ok(param)

    return fail(code: "none", msg: "no such sibling")

function is_ptr(c: state.Checker, ty: i64) -> bool
    written = state.written_type(c.out, ty)

    if written.is_err()
        return false
    return table.get(c.out.types, written.must()) == .ptr

function is_cstr(c: state.Checker, ty: i64) -> bool
    written = state.written_type(c.out, ty)

    if written.is_err()
        return false
    return table.get(c.out.types, written.must()) == .cstr

# Every `lent` in an extern signature, judged where it is written (panel 171).
# The word is read on a by-value `cstr` or a `ptr` that declares its extent —
# the two parameters a lend can land on — and nowhere else: in an `@` position
# no lend can stand, on a handle or a number nothing is lent, and a `ptr` with
# no `counted_by` refuses every lend before the word is read. Unread, it is
# refused, which is `check/marks.hero`'s rule for the handle words applied to
# this one. The word landed one commit before this rule did, so the seed
# compiler that built this one could parse the marks it writes on the
# compiler's own bindings (`seed/README.md`'s chain; the one-commit landing was
# run and broke at `selfhost/cli/process.hero:42:40` with no binary).
function declared_lends(@c: state.Checker, s: source.Source, f: ast.FunctionDecl, declared_name: token.Span)
    for param in f.params
        if !param.lent
            continue
        param_name = source.span_text(s, param.name)
        why: str @ ""

        if param.mutable
            why @ "`" + param_name + "` is an `@` out-parameter, and no lend can stand in an `@` position"
        else if !is_ptr(c, param.ty) && !is_cstr(c, param.ty)
            why @ "`" + param_name + "` is not a `cstr` or a `ptr`, and only those two are ever lent"
        else if is_ptr(c, param.ty) && param.counted_by.is_err()
            why @ "`" + param_name + "` is a `ptr` that declares no extent, and a `ptr` lend reaches only a parameter declared `counted_by` — nothing is ever lent here, so the word is dead text; write `counted_by <n> lent`"

        if why != ""
            state.push_diagnostic(
                @c,
                ffi_errors.lent_shape(parameter: param_name, function_name: source.span_text(s, declared_name), why: why, span: param.name)
            )

# An integer the header takes by value: not `@`, and an `int_ty`. A float, a
# `bool` and a pointer are refused as extents; so is `@n`, which is C's
# out-parameter and holds no count on the way in.
function integer_by_value(c: state.Checker, param: ast.Param) -> bool
    if param.mutable
        return false
    written = state.written_type(c.out, param.ty)

    if written.is_err()
        return false

    match table.get(c.out.types, written.must())
        .int_ty                                                    => return true
        .float_ty | .bool | .str | .ptr | .cstr | .unit            => return false
        .array | .fixed | .map | .fallible | .function_ty | .named => return false
        .case_ty | .failure | .generic | .error                    => return false

    return false

## Tests

# A bare checker and the lowering loop, which is `check/lending.hero`'s shape
# and for its reason one level up: `checker.hero` imports THAT module, and this
# one is imported by it, so a `use checker` here would be a module cycle the
# language refuses outright. The lowering loop is not decoration —
# `declared_extents` reads `written_types`, and `lower_ty` is what fills it.
function shape_refusals(text: str) -> i64
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checker @ state.new_checker(out_of: out, expr_count: p.tree.exprs.len())
    i: i64 @ 0

    while i < p.tree.types.len()
        _ = lower.lower_ty(@c, p.tree, out, i)
        i @ i + 1

    for decl in p.decls
        match decl.kind
            .function_decl fd =>
                if fd.value.is_extern
                    declared_extents(@c, s, f: fd.value, declared_name: decl.name)
            .constant_decl | .record_decl | .variant_decl | .test_decl =>
                _ = 0

    n: i64 @ 0

    for d in c.out.diagnostics
        if d.code == "counted_by_shape"
            n @ n + 1

    return n

test "the three shapes of a wrong mark are refused, and the right one is quiet"
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 0
    assert shape_refusals("extern \"s.h\"\n    function f(p: i64 counted_by n, n: i64) -> i64\n\nfunction main()\n    print(f(p: 0, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by m, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, n: f64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0.0))\n") == 1

test "a mark naming its own parameter, or an `@` sibling, names no extent"
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by p, n: i64) -> i64\n\nfunction main()\n    print(f(p: nullptr, n: 0))\n") == 1
    assert shape_refusals("extern \"s.h\"\n    function f(p: ptr counted_by n, @n: i64) -> i64\n\nfunction main()\n    k: i64 @ 0\n    print(f(p: nullptr, @k))\n") == 1
