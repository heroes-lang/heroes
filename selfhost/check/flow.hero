# The state route M (must) carries through a body: which places a call has
# ENDED on every path to here, and which have had a reference added that
# keeps them alive (panel 177's item 3; defects 077 and 088).
# `check/moved.hero` is the walk that carries it; this module is the lattice
# and nothing else, so the three questions the walk asks can each be read in
# a dozen lines.
#
# A PLACE is a path of segments rooted at a local: `["7"]` is local 7 whole,
# `["7", ".cell"]` its field `cell`, `["7", "[0]"]` its element at a literal
# index, and `["7", "[?]"]` an element at an index only the run can know.
#
# Every question takes the ALIVE answer wherever the path cannot settle it,
# because a refusal here is a fact about the program's shape and never a guess
# about a value (panel 177's compiler-engineer, E10: zero false refusals on
# every shape run). A read of `p` is dead when a dead path is a DEFINITE
# prefix of `p`, every segment equal and none of them `[?]`, since `xs[0]`
# given back says nothing about `xs[i]`. A crossing of `p` whole into C is
# dead when, besides that, `p` is a definite prefix of a dead path: C would
# read the dead part. A write to `p` revives everything it could reach, `[?]`
# matching any element either way, since `xs[i] @ fresh` may well be `xs[0]`.
#
# Where paths meet, a place stays dead only if it is dead on BOTH. That is
# the whole difference between route M (must) and the route M (may) the
# sitting refused, which took the union and refused two correct programs
# whose correctness was a value (`if_correlated`, `match_correlated`, E10).
#
# **The places are kept one group per local** (defect 499). A path's first
# segment is its local, written in decimal, and never an element, so two
# paths on two locals neither overlap nor prefix each other: every question
# about a path is asked of its local's group alone, and an end, a write or a
# read costs what that local holds, not what the body has ended. Kept as one
# list, each end rebuilt it without the place it ended and each binding
# without what it revived: ending 2,000 handles cost 26.8 billion
# instructions, the square of the handles. A group grows in place, lent
# (defect 409), and is rebuilt only where an event takes a place out of it.
#
# **Where paths meet, only the locals they changed are met** (defect 511):
# the walk splits a flow where control splits, every path goes on from that
# flow, and `meet` starts from it and meets the locals the paths changed
# after its clock (`check/flow_log.hero`), so a join costs what the paths did
# and not what the body holds.
#
# **And a path's first change copies what it changes, not every group**
# (defect 530): the groups are a tree indexed by the local's number
# (`check/flow_groups.hero`), so the copy a value's first change makes of
# what it shares with the base is one node a level. They were one array,
# which each branch's first change and each join copied whole, as the code
# reads: 10.77 billion instructions for 2,000 `if`s whose branches each end
# a handle after defect 511's repair, 4.21 billion with the tree.

use token
use check/flow_groups
use check/flow_log

record Flow
    # A group per local an event has named.
    groups: flow_groups.Groups
    # False after `return`, `break` and `continue`: nothing is reachable here,
    # so nothing read here is refused, and it contributes nothing where paths
    # meet.
    live: bool
    # The clock of the last change on this path: each change stamps its group
    # one later, and a join reads what changed after its split's clock.
    clock: i64

function start() -> Flow
    return Flow(groups: flow_groups.none(), live: true, clock: 0)

function unreachable() -> Flow
    f: Flow @ start()
    f.live @ false
    return f

# The local a path is rooted at. Both makers of a path start from its local
# (`moved_calls.place_of`, `moved_walk.revive`), so a path with no segment is
# a defect in its maker, stopped here rather than answered as some local's.
function local_of(path: [str]) -> str
    assert path.len() > 0
    return path[0]

# Where control splits: the paths from here go on from this flow, which is
# their base when `meet` meets them, and its clock is when they began.
function split(f: Flow) -> Flow
    return f

# Where two paths that went on from `base` meet: dead on both, or alive;
# kept on either, or not. A local neither path changed holds on both what it
# held at the base, and met with itself it is itself, so the base answers
# for it and only the locals changed after the base's clock are met with
# their twins, each stamped later than either path.
function meet(base: Flow, one: Flow, two: Flow) -> Flow
    if !one.live
        return two

    if !two.live
        return one
    out: Flow @ base
    out.clock @ one.clock

    if two.clock > out.clock
        out.clock @ two.clock
    out.clock @ out.clock + 1

    for local in flow_log.since(one: one.groups, two: two.groups, from: base.clock)
        both: flow_groups.Held @ met(
            mine: flow_groups.get(one.groups, local: local),
            theirs: flow_groups.get(two.groups, local: local)
        )
        both.stamp @ out.clock
        flow_groups.put(@out.groups, one: both)

    return out

# A local's group met with its twin: dead on both, in `mine`'s order; kept on
# either.
function met(mine: flow_groups.Held, theirs: flow_groups.Held) -> flow_groups.Held
    both: [flow_groups.Dead] @ []
    kept: [[str]] @ mine.kept

    for d in mine.dead
        if holds(theirs.dead, path: d.path)
            both @ both.push(d)

    for k in theirs.kept
        if !listed(kept, path: k)
            kept @ kept.push(k)

    return flow_groups.Held(local: mine.local, dead: both, kept: kept, stamp: mine.stamp)

# The group `h`, changed on this path, put back stamped one later.
function changed(@f: Flow, h: flow_groups.Held)
    f.clock @ f.clock + 1
    one: flow_groups.Held @ h
    one.stamp @ f.clock
    flow_groups.put(@f.groups, one: one)

function holds(set: [flow_groups.Dead], path: [str]) -> bool
    for d in set
        if d.path == path
            return true

    return false

function listed(set: [[str]], path: [str]) -> bool
    for one in set
        if one == path
            return true

    return false

## The three questions

# `k` names, on every run, a part of what `p` names, or all of it.
function definite_prefix(k: [str], p: [str]) -> bool
    if k.len() > p.len()
        return false
    at: i64 @ 0

    while at < k.len()
        if k[at] != p[at] || k[at] == "[?]"
            return false
        at @ at + 1

    return true

# `a` and `b` may name overlapping storage on some run.
function may_overlap(a: [str], b: [str]) -> bool
    at: i64 @ 0

    while at < a.len() && at < b.len()
        if a[at] != b[at] && !(is_element(a[at]) && is_element(b[at]) && (a[at] == "[?]" || b[at] == "[?]"))
            return false
        at @ at + 1

    return true

function is_element(segment: str) -> bool
    return segment.len() > 0 && segment[0] == 91

# The places ended on `path`'s local, in the order they were ended.
function dead_on(f: Flow, path: [str]) -> [flow_groups.Dead]
    return flow_groups.get(f.groups, local: local_of(path)).dead

# A read of `path`: dead where an ended place covers it for certain.
function dead_read(f: Flow, path: [str]) -> flow_groups.Dead?
    for d in dead_on(f, path: path)
        if definite_prefix(k: d.path, p: path)
            return ok(d)

    return fail(code: "none", msg: "alive")

# `path` handed to C whole: dead where it covers an ended place for certain,
# or one covers it.
function dead_crossing(f: Flow, path: [str]) -> flow_groups.Dead?
    for d in dead_on(f, path: path)
        if definite_prefix(k: d.path, p: path) || definite_prefix(k: path, p: d.path)
            return ok(d)

    return fail(code: "none", msg: "alive")

## The three events

# An event takes its local's group out to change it, so the group it
# changes is the one copy of its places it holds (`flow_groups.taken`), and
# puts it back stamped (`changed`). A write asks first, since most reach no
# group, and a path that changes nothing copies nothing.

# An end of a place ended before on this path moves it to the end of its
# local's order, as a second end of it would have been written last. A place
# a reference keeps is not ended, and its group goes back as it was.
function ended(@f: Flow, path: [str], shown: str, callee: str, at: token.Span)
    h: flow_groups.Held @ flow_groups.taken(@f.groups, local: local_of(path))

    for k in h.kept
        if may_overlap(a: k, b: path)
            flow_groups.put(@f.groups, one: h)
            return

    one = flow_groups.Dead(path: path, shown: shown, callee: callee, at: at)

    if holds(h.dead, path: path)
        ended_again(@h.dead, last: one)
    else
        add_dead(@h.dead, one: one)
    changed(@f, h: h)

function add_dead(@dead: [flow_groups.Dead], one: flow_groups.Dead)
    dead @ dead.push(one)

function ended_again(@dead: [flow_groups.Dead], last: flow_groups.Dead)
    survivors: [flow_groups.Dead] @ []

    for d in dead
        if d.path != last.path
            survivors @ survivors.push(d)

    dead @ survivors.push(last)

# A write revives what it could reach on its local, and nothing on another;
# a group it reaches is shorter after it, and changed.
function written(@f: Flow, path: [str])
    if !reached(f, path: path)
        return
    h: flow_groups.Held @ flow_groups.taken(@f.groups, local: local_of(path))
    revived(@h, path: path)
    changed(@f, h: h)

function reached(f: Flow, path: [str]) -> bool
    h = flow_groups.get(f.groups, local: local_of(path))
    return reaches_dead(h.dead, path: path) || reaches_kept(h.kept, path: path)

function revived(@h: flow_groups.Held, path: [str])
    if reaches_dead(h.dead, path: path)
        survivors: [flow_groups.Dead] @ []

        for d in h.dead
            if !may_overlap(a: d.path, b: path)
                survivors @ survivors.push(d)

        h.dead @ survivors

    if reaches_kept(h.kept, path: path)
        still: [[str]] @ []

        for k in h.kept
            if !may_overlap(a: k, b: path)
                still @ still.push(k)

        h.kept @ still

function reaches_dead(set: [flow_groups.Dead], path: [str]) -> bool
    for d in set
        if may_overlap(a: d.path, b: path)
            return true

    return false

function reaches_kept(set: [[str]], path: [str]) -> bool
    for k in set
        if may_overlap(a: k, b: path)
            return true

    return false

function retained(@f: Flow, path: [str])
    if kept_already(f, path: path)
        return
    h: flow_groups.Held @ flow_groups.taken(@f.groups, local: local_of(path))
    add_kept(@h.kept, path: path)
    changed(@f, h: h)

function kept_already(f: Flow, path: [str]) -> bool
    return listed(flow_groups.get(f.groups, local: local_of(path)).kept, path: path)

function add_kept(@kept: [[str]], path: [str])
    kept @ kept.push(path)

## Tests

function span_at(n: i64) -> token.Span
    return token.Span(start: n, end: n + 1)

# Every place a flow holds dead, local by local, and every kept one: what
# the one list held before defect 499, for the tests to read.
function every_dead(f: Flow) -> [flow_groups.Dead]
    out: [flow_groups.Dead] @ []

    for h in flow_groups.each(f.groups)
        for d in h.dead
            out @ out.push(d)

    return out

function every_kept(f: Flow) -> [[str]]
    out: [[str]] @ []

    for h in flow_groups.each(f.groups)
        for k in h.kept
            out @ out.push(k)

    return out

test "a read is dead under a definite prefix and alive under an element only the run knows"
    f: Flow @ start()
    ended(@f, path: ["3", ".cell"], shown: "x.cell", callee: "close", at: span_at(0))
    assert !dead_read(f, path: ["3", ".cell"]).is_err()
    assert !dead_read(f, path: ["3", ".cell", ".inner"]).is_err()
    assert dead_read(f, path: ["3"]).is_err()
    assert dead_read(f, path: ["3", ".other"]).is_err()
    assert dead_read(f, path: ["4", ".cell"]).is_err()
    ended(@f, path: ["5", "[?]"], shown: "xs[i]", callee: "close", at: span_at(1))
    assert dead_read(f, path: ["5", "[?]"]).is_err()
    assert dead_read(f, path: ["5", "[0]"]).is_err()
    ended(@f, path: ["6", "[0]"], shown: "ys[0]", callee: "close", at: span_at(2))
    assert !dead_read(f, path: ["6", "[0]"]).is_err()
    assert dead_read(f, path: ["6", "[1]"]).is_err()
    assert dead_read(f, path: ["6", "[?]"]).is_err()

test "a crossing into C is dead when the whole covers a dead part, and not through an unknown element"
    f: Flow @ start()
    ended(@f, path: ["3", ".cell"], shown: "x.cell", callee: "close", at: span_at(0))
    ended(@f, path: ["5", "[?]"], shown: "xs[i]", callee: "close", at: span_at(1))
    assert !dead_crossing(f, path: ["3"]).is_err()
    assert !dead_crossing(f, path: ["3", ".cell"]).is_err()
    assert dead_crossing(f, path: ["3", ".other"]).is_err()
    assert !dead_crossing(f, path: ["5"]).is_err()
    assert dead_crossing(f, path: ["5", "[0]"]).is_err()
    assert dead_crossing(f, path: ["5", "[?]"]).is_err()

test "a write revives what it could reach, and a reference keeps a place alive"
    f: Flow @ start()
    ended(@f, path: ["3", ".cell"], shown: "x.cell", callee: "close", at: span_at(0))
    ended(@f, path: ["6", "[0]"], shown: "ys[0]", callee: "close", at: span_at(1))
    written(@f, path: ["3"])
    assert dead_read(f, path: ["3", ".cell"]).is_err()
    assert !dead_read(f, path: ["6", "[0]"]).is_err()
    written(@f, path: ["6", "[?]"])
    assert dead_read(f, path: ["6", "[0]"]).is_err()
    retained(@f, path: ["7"])
    ended(@f, path: ["7"], shown: "cert", callee: "free", at: span_at(2))
    assert dead_read(f, path: ["7"]).is_err()
    written(@f, path: ["7"])
    ended(@f, path: ["7"], shown: "cert", callee: "free", at: span_at(3))
    assert !dead_read(f, path: ["7"]).is_err()

test "where paths meet a place is dead only on both, and kept on either"
    base = split(start())
    one: Flow @ base
    two: Flow @ base
    ended(@one, path: ["1"], shown: "a", callee: "close", at: span_at(0))
    ended(@one, path: ["2"], shown: "b", callee: "close", at: span_at(1))
    ended(@two, path: ["2"], shown: "b", callee: "close", at: span_at(2))
    retained(@two, path: ["3"])
    both = meet(base: base, one: one, two: two)
    assert both.live
    assert every_dead(both).len() == 1
    assert every_dead(both)[0].shown == "b"
    assert every_dead(both)[0].at.start == 1
    assert every_kept(both) == [["3"]]
    assert every_dead(meet(base: base, one: unreachable(), two: one)).len() == 2
    assert every_dead(meet(base: base, one: one, two: unreachable())).len() == 2
    assert !meet(base: base, one: unreachable(), two: unreachable()).live

# Defect 511: a join starts from the split and meets what the paths changed
# after its clock, a split inside another included, even where the inner one
# never met (a `break` takes the flow as it stands); a local nothing changed
# is the base's. And what the join met is changed after the outer split's
# clock, for the join of that split to meet (defect 530's clock).
test "a join meets only what its paths changed since the split, under splits inside splits"
    f: Flow @ start()
    ended(@f, path: ["1"], shown: "a", callee: "close", at: span_at(0))
    ended(@f, path: ["4"], shown: "d", callee: "close", at: span_at(1))
    assert f.clock == 2
    outer = split(f)
    one: Flow @ outer
    ended(@one, path: ["2"], shown: "b", callee: "close", at: span_at(2))
    deep: Flow @ split(one)
    ended(@deep, path: ["3"], shown: "c", callee: "close", at: span_at(3))
    written(@deep, path: ["1"])
    two: Flow @ outer
    ended(@two, path: ["3"], shown: "c", callee: "close", at: span_at(4))
    ended(@two, path: ["2"], shown: "b", callee: "close", at: span_at(5))
    both = meet(base: outer, one: deep, two: two)
    assert dead_read(both, path: ["1"]).is_err()
    assert dead_read(both, path: ["2"]).must().at.start == 2
    assert dead_read(both, path: ["3"]).must().at.start == 3
    assert dead_read(both, path: ["4"]).must().at.start == 1
    assert flow_log.since(one: both.groups, two: f.groups, from: f.clock) == ["1", "2", "3"]
    assert flow_log.since(one: both.groups, two: both.groups, from: both.clock).len() == 0

# Defect 499: each local's places are its own group. An end of one place
# again moves it last on its local, and the first place a read finds is the
# earliest ended that covers it; a write to one local leaves every other
# local's places dead; and a join keeps each local's order.
test "each local's places are one group, kept in the order they were ended"
    f: Flow @ start()
    ended(@f, path: ["4", ".a"], shown: "x.a", callee: "close", at: span_at(0))
    ended(@f, path: ["4"], shown: "x", callee: "close", at: span_at(1))
    ended(@f, path: ["9"], shown: "y", callee: "close", at: span_at(2))
    assert dead_read(f, path: ["4", ".a"]).must().shown == "x.a"
    ended(@f, path: ["4", ".a"], shown: "x.a", callee: "close", at: span_at(3))
    assert dead_read(f, path: ["4", ".a"]).must().shown == "x"
    assert dead_crossing(f, path: ["4"]).must().shown == "x"
    assert every_dead(f).len() == 3

    # Writing `x.b` reaches `x` whole, which holds it, and not `x.a`.
    written(@f, path: ["4", ".b"])
    assert every_dead(f).len() == 2
    assert dead_read(f, path: ["4", ".a"]).must().shown == "x.a"
    written(@f, path: ["4"])
    assert every_dead(f).len() == 1
    assert !dead_read(f, path: ["9"]).is_err()
    assert dead_read(f, path: ["4", ".a"]).is_err()
    many: Flow @ start()
    k: i64 @ 0

    while k < 300
        ended(@many, path: [k.to_str()], shown: "h", callee: "close", at: span_at(k))
        k @ k + 1

    assert flow_groups.each(many.groups).len() == 300
    base = split(many)
    again = meet(base: base, one: base, two: base)
    assert every_dead(again).len() == 300
    assert every_dead(again)[299].at.start == 299
    assert flow_log.since(one: again.groups, two: again.groups, from: base.clock).len() == 0

# Defect 530: a path's change leaves the base it went on from as it was,
# whatever the number of its local.
test "a path changes its own groups, and the base keeps its own"
    f: Flow @ start()
    ended(@f, path: ["3"], shown: "a", callee: "close", at: span_at(0))
    ended(@f, path: ["70000", ".cell"], shown: "b.cell", callee: "close", at: span_at(1))
    base = split(f)
    one: Flow @ base
    written(@one, path: ["70000"])
    ended(@one, path: ["40"], shown: "c", callee: "close", at: span_at(2))
    assert dead_read(one, path: ["70000", ".cell"]).is_err()
    assert !dead_read(base, path: ["70000", ".cell"]).is_err()
    assert dead_read(base, path: ["40"]).is_err()
    assert flow_log.since(one: one.groups, two: base.groups, from: base.clock) == ["40", "70000"]
