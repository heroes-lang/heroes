# What Windows reads otherwise in a group head's name (design.md §4.19; panel
# 188's R2 and R6, extended to Windows by the author on 2026-10-03; defects
# 234 and 235). Measured on the Windows box by panel 188's ffi-pragmatist (its
# report's section *Windows, measured*: clang 23.1.1 over NTFS): `*`, `<`, `?`
# and `|` can stand in no file's name there, where this Mac and Linux build;
# and, each against *file not found* on this Mac and on Linux, a part ending in
# `.` or a space is
# stored under the name without them, so `<ab.h.>` and `<d./ab.h>` opened
# `ab.h` and `d/ab.h`; a `:` names a drive or a stream of another file,
# `<ab:c.h>` the stream `c.h` of a file `ab`; a `~` an 8.3 short name,
# `<ABCDEF~1.H>` opening `abcdefghij.h`; `<zz/../ab.h>` opened `ab.h` with no
# `zz` there; and `<NUL>` the null device. Judged on the value, part by part
# between `/`, the rules refuse 0 of the header names surveyed on three
# platforms, of this Mac's 1,371 library and 487 `.pc` names, and of the
# tree's group-head strings.
#
# A header's value is a file's whole name; a `link`'s and a `package`'s are
# the stem of one the tool builds, `X.lib` from clang's Windows driver
# (measured with `-###`) and `X.pc`, so the end of their last part is not the
# end of a file's name, and a `.` or a space there is no reason to refuse.
# What lld-link does with a `>`, a `"`, a `\` and a `/` in such a name was
# measured on the box on 2026-10-07 (defect 252, `library_unwritable`); a
# Windows `pkg-config` is unrun, the box carrying none, so a package's name is
# judged by what NTFS can hold.
#
# A leaf, read by `head_names`: `unwritable` and `library_unwritable` give
# `unwritable_name`'s reason on Windows, a name it stores as another file's,
# a device's or no file's, and `locked` gives `machine_locked_path`'s, a name
# whose file depends on the machine.

use bytes

# Why Windows holds no file of this name, or "": one of `*`, `<`, `>`, `"`,
# `?` and `|`, which NTFS refuses in any file's name (Win32 error 123,
# defects 235 and 252); a part ending in `.` or a space; or a part naming a
# device, the part before its first `.` read in any case. `suffixed` is true
# where the tool adds to the last part. A header's `"` is told here since
# defect 445, before panel 188's `undefined_header_name`, a thesis rule, which
# `check --permissive` drops: no Windows file holds the name, so without the
# thesis the program still names nothing there, as `*` names nothing.
function unwritable(value: str, suffixed: bool) -> str
    reserved = reserved_byte(value)

    if reserved.len() > 0
        return "holds `" + reserved + "`, which no file's name on Windows can hold"
    start: i64 @ 0
    at: i64 @ 0

    while at <= value.len()
        if at == value.len() || value[at] == '/'
            said = part_unwritable(part: value.slice(from: start, to: at), last: at == value.len(), suffixed: suffixed)

            if said.len() > 0
                return said
            start @ at + 1
        at @ at + 1

    return ""

function reserved_byte(value: str) -> str
    at: i64 @ 0

    while at < value.len()
        b = value[at]

        if b == '*' || b == '<' || b == '>' || b == '"' || b == '?' || b == '|'
            return value.slice(from: at, to: at + 1)
        at @ at + 1

    return ""

# What a `link`'s or a `package`'s name holds past `unwritable`'s that names
# no one file on every machine, as its reason, or "" (defect 252). Measured
# on the box on 2026-10-07, clang 23.1.1 driving lld-link over NTFS: `>` and
# `"` stand in no file's name there, `CopyFileW` into `a>b.lib`, `a"b.lib`,
# `a>b.pc` and `a"b.pc` failing with Win32 error 123 as into `a*b.lib`, and
# lld-link, handed `g>h.lib` and `g"h.lib` by `-l`, by `/defaultlib:` and as a
# path, could not open them, *invalid argument*, Git Bash having written both,
# which `reserved_byte` tells since defect 445; a `\` is a directory to
# lld-link, `-la\b` linking `b.lib` inside `a`, where
# ld64 and GNU ld 2.44 link one file, `liba\b.a`; and in a `link` a `/` is a
# directory to every linker but not the same one, lld-link opening
# `sub/m252.lib` and ld64 and GNU ld `libsub/m252.a`, `lib` written before the
# directory. A package's `/` passes, as a header's `sub/foo.h` does:
# `pkg-config` looks it up under each search directory.
#
# **A `rooted` value holds them for the same reasons** (defect 446): until
# then its `/` and `\` were left to panel 055's `machine_locked_path`, a thesis
# rule, which `check --permissive` drops. Measured on 2026-10-08, ld64 and GNU
# ld 2.44 read a rooted `link` below each directory they search, not at the
# path written: `-l/opt/q/m446` opened `<dir>/lib/opt/q/m446.a`, `-lC:/side/m`
# `<dir>/libC:/side/m.a`, GNU's `-l:/w/abs/libm446.a` `<dir>/w/abs/libm446.a`,
# where lld-link is handed `/opt/q/m446.lib` (clang's `-###`) and reads
# `/out:pwn.lib` as its own `/out:` option, writing the program there (lld-link
# 22 in the Linux container). Such a value's message keeps its route, which
# `head_names` adds.
function library_unwritable(value: str, what: str, rooted: bool) -> str
    at: i64 @ 0

    while at < value.len()
        b = value[at]

        if b == '\\'
            return "holds `\\`, which no file's name on Windows can hold"

        if b == '/' && what == "link" && rooted
            return "holds `/`, which macOS's and Linux's linkers read below each directory they search and not from the root it names"

        if b == '/' && what == "link"
            return "holds `/`, which every linker reads as a directory and not the same one, `" + value + ".lib` on Windows and `lib" + value + "` on macOS and Linux"
        at @ at + 1

    return ""

function part_unwritable(part: str, last: bool, suffixed: bool) -> str
    if part.len() == 0 || part == "." || part == ".."
        return ""
    end = part[part.len() - 1]

    if (end == '.' || end == ' ') && !(last && suffixed)
        return "has a part ending in " + ending(end) + ", which Windows drops from a file's name"

    if device(part)
        return "has a part Windows reads as one of its devices, not as a file"
    return ""

function ending(b: u8) -> str
    if b == '.'
        return "`.`"
    return "a space"

# Whether a part names one of Windows' devices: CON, PRN, AUX, NUL, CONIN$,
# CONOUT$, and COM and LPT with a digit from 1 to 9 or one of ISO 8859-1's
# superscripts `¹`, `²` and `³` (UTF-8 `c2 b9`, `c2 b2`, `c2 b3`), in any
# ASCII case; read on the part before its first `.`, the spaces ending it
# dropped (defect 253). The names are Microsoft's *Naming Files, Paths, and
# Namespaces* (read 2026-10-07, its date 2024-08-28), which reserves them
# followed by an extension too, and the console's two of `CreateFileW`'s
# page; CPython's `ntpath.isreserved` and Wine's `RtlIsDosDeviceName_U` read
# the same set the same way, spaces dropped, *the rules varying across Windows
# versions*. Measured on the box (Windows 10.0.26100, `CreateFileW`,
# `GetFullPathNameW` and `RtlIsDosDeviceName_U` itself): each of them bare is
# the device, `\\.\COM¹`, the console's two opened as the console; `COM0`,
# `LPT0`, `COM10`, `COM⁰`, `COM⁴`, `COM１`, `CONERR$` and `CLOCK$` are files.
# That build reads a file where the page and Wine read the device, behind an
# extension (`COM¹.h`, `NUL.h`, `CONIN$.h`) or after a directory (`sub/COM¹`;
# `sub/NUL` stays the device), and refuses a directory so named (error 267).
# Git Bash wrote every one bare as a file, and clang's `#include` of `NUL`
# then read the device, its declaration unseen.
function device(part: str) -> bool
    stem: i64 @ 0

    while stem < part.len() && part[stem] != '.'
        stem @ stem + 1

    while stem > 0 && part[stem - 1] == ' '
        stem @ stem - 1

    if stem == 3
        return same_letters(part: part, word: "con") || same_letters(part: part, word: "prn") || same_letters(part: part, word: "aux") || same_letters(part: part, word: "nul")

    if stem == 6
        return same_letters(part: part, word: "conin$")

    if stem == 7
        return same_letters(part: part, word: "conout$")

    if stem < 4 || !(same_letters(part: part, word: "com") || same_letters(part: part, word: "lpt"))
        return false

    if stem == 4
        return part[3] >= '1' && part[3] <= '9'
    return stem == 5 && part[3] == 194 && (part[4] == 185 || part[4] == 178 || part[4] == 179)

# Whether `part` begins with the lower-case `word` in any ASCII case.
function same_letters(part: str, word: str) -> bool
    if part.len() < word.len()
        return false
    i: i64 @ 0

    while i < word.len()
        if bytes.lower(part[i]) != word[i]
            return false
        i @ i + 1

    return true

# Why the file this value names depends on the machine, or "": a `:`, a `~`,
# or a `..` that climbs out of a directory the value named (a leading `../`
# climbs out of none, and stays: the tree holds `../i2.h`).
function locked(value: str) -> str
    if !bytes.rfind(text: value, needle: ":").is_err()
        return "holds `:`, which Windows reads as a drive or as a stream of another file"

    if !bytes.rfind(text: value, needle: "~").is_err()
        return "holds `~`, which Windows can read as the short name of another file"

    if climbs_back(value)
        return "climbs back out of a directory it names, with `..`, which Windows does without that directory, and macOS and Linux only through it"
    return ""

function climbs_back(value: str) -> bool
    depth: i64 @ 0
    start: i64 @ 0
    at: i64 @ 0

    while at <= value.len()
        if at == value.len() || value[at] == '/'
            part = value.slice(from: start, to: at)

            if part == ".." && depth > 0
                return true

            if part.len() > 0 && part != "." && part != ".."
                depth @ depth + 1
            start @ at + 1
        at @ at + 1

    return false

## Tests

test "a part Windows stores under another name, or reads as a device (defect 234)"
    assert unwritable(value: "ab.h", suffixed: false) == ""
    assert unwritable(value: "a*b.h", suffixed: false) == "holds `*`, which no file's name on Windows can hold"
    assert unwritable(value: "a<b.h", suffixed: false) != ""
    assert unwritable(value: "a?b.h", suffixed: false) != ""
    assert unwritable(value: "sub/a|b.h", suffixed: false) != ""
    assert unwritable(value: "a?b", suffixed: true) != ""
    assert unwritable(value: "a!=c", suffixed: true) == ""
    assert unwritable(value: "ab.h.", suffixed: false) != ""
    assert unwritable(value: "ab.h ", suffixed: false) != ""
    assert unwritable(value: "ab.h..", suffixed: false) != ""
    assert unwritable(value: "d./ab.h", suffixed: false) != ""
    assert unwritable(value: "d /ab.h", suffixed: false) != ""
    assert unwritable(value: "./ab.h", suffixed: false) == ""
    assert unwritable(value: "../ab.h", suffixed: false) == ""
    assert unwritable(value: ".hidden.h", suffixed: false) == ""
    assert unwritable(value: "m.", suffixed: true) == ""
    assert unwritable(value: "d./m", suffixed: true) != ""
    assert unwritable(value: "NUL", suffixed: false) != ""
    assert unwritable(value: "nul.h", suffixed: false) != ""
    assert unwritable(value: "sub/Con.h", suffixed: false) != ""
    assert unwritable(value: "aux", suffixed: true) != ""
    assert unwritable(value: "COM1", suffixed: false) != ""
    assert unwritable(value: "com.h", suffixed: false) == ""
    assert unwritable(value: "comx.h", suffixed: false) == ""
    assert unwritable(value: "com10.h", suffixed: false) == ""
    assert unwritable(value: "nullish.h", suffixed: false) == ""
    assert unwritable(value: "a.nul", suffixed: false) == ""
    assert unwritable(value: "é.h", suffixed: false) == ""

# Defect 253: the superscript digits and the console's two are devices as
# `COM1` is, and `COM0` and `LPT0` are files, the box's measure and
# Microsoft's list both.
test "a device is named by a superscript digit or by the console's two, and never by 0 (defect 253)"
    device_said = "has a part Windows reads as one of its devices, not as a file"
    assert unwritable(value: "COM¹.h", suffixed: false) == device_said
    assert unwritable(value: "com²", suffixed: false) != ""
    assert unwritable(value: "sub/Com³.txt", suffixed: false) != ""
    assert unwritable(value: "LPT¹", suffixed: true) != ""
    assert unwritable(value: "lpt².h", suffixed: false) != ""
    assert unwritable(value: "lPt³", suffixed: true) != ""
    assert unwritable(value: "CONIN$", suffixed: true) == device_said
    assert unwritable(value: "conin$.h", suffixed: false) != ""
    assert unwritable(value: "CONOUT$", suffixed: true) != ""
    assert unwritable(value: "sub/Conout$.txt", suffixed: false) != ""
    assert unwritable(value: "nul .h", suffixed: false) != ""
    assert unwritable(value: "COM¹  .h", suffixed: false) != ""
    assert unwritable(value: "com0.h", suffixed: false) == ""
    assert unwritable(value: "LPT0", suffixed: true) == ""
    assert unwritable(value: "COM⁰.h", suffixed: false) == ""
    assert unwritable(value: "COM⁴.h", suffixed: false) == ""
    assert unwritable(value: "COM¹¹.h", suffixed: false) == ""
    assert unwritable(value: "COM¼.h", suffixed: false) == ""
    assert unwritable(value: "CONERR$.h", suffixed: false) == ""
    assert unwritable(value: "CLOCK$", suffixed: true) == ""
    assert unwritable(value: "CONIN.h", suffixed: false) == ""
    assert unwritable(value: "conins$", suffixed: true) == ""
    assert unwritable(value: " nul.h", suffixed: false) == ""
    assert device("CONOUT$ ")
    assert !device("CONOUT")

# Defect 445: `>` and `"` are NTFS's too (defect 252's measure), so every
# string tells them here, a header's `"` before panel 188's thesis rule.
test "a name holding `>` or `\"` is one no Windows file holds, in every string (defects 252 and 445)"
    held = "holds `\"`, which no file's name on Windows can hold"
    assert unwritable(value: "a\"b.h", suffixed: false) == held
    assert unwritable(value: "\"stdio.h\"", suffixed: false) == held
    assert unwritable(value: "sub/a\"b", suffixed: true) == held
    assert unwritable(value: "/a\"b.h", suffixed: false) == held
    assert unwritable(value: "a>b", suffixed: true) == "holds `>`, which no file's name on Windows can hold"
    assert unwritable(value: "a'b.h", suffixed: false) == ""
    assert library_unwritable(value: "a\"b", what: "link", rooted: false) == ""
    assert library_unwritable(value: "a\\b", what: "link", rooted: false) == "holds `\\`, which no file's name on Windows can hold"

test "a name whose file depends on the machine: a `:`, a `~`, a climb out of a named directory (defect 234)"
    assert locked("ab.h") == ""
    assert locked("ab:c.h") != ""
    assert locked("ab.h::$DATA") != ""
    assert locked("ABCDEF~1.H") != ""
    assert locked("zz/../ab.h") != ""
    assert locked("zz/./../ab.h") != ""
    assert locked("../ab.h") == ""
    assert locked("../../ab.h") == ""
    assert locked("./../ab.h") == ""
    assert locked("sub/ab.h") == ""
    assert locked("a..b/c.h") == ""
