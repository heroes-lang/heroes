# The closers one after another that a failed line's reader names once
# (design.md §4.17; defects 306, 456 and 482; out of `parse/brace_habit` on
# 2026-10-09, the seam the parser's budget lets a move pay along).
#
# A stray closer is told with the ones right after it on its line, one
# message at the first (`stray_run`), since past the first, which closes
# nothing the line opened, none does; where a line's reader names what it
# found, the run it begins is what it names (`found_run`); and `told_to` says
# where the last report that began at a token ends, so a report standing on
# a run's first closer is known to have told the run.
#
# A leaf: it reads the tokens, the text and the reports the cursor holds.
#
# | entry | called by |
# |---|---|
# | `stray_run`, `found_run` | `parse/brace_habit.a_closer_too_many`, `parse/statement_end`, `parse/opening`, `parse/list_line`, `grammar_expr` |
# | `told_to` | `parse/brace_habit.a_closer_too_many` |

use token
use text_lines
use cursor

# The closers from token `at` on, one after another on its line: a run of
# strays told at once, since past the first, which closes nothing the line
# opened, none does (defect 306); any other token alone.
function stray_run(c: cursor.Cursor, text: str, at: i64) -> token.Span
    last: i64 @ at

    while token.is_closer(c.tokens[at].kind) && last + 1 < c.tokens.len() && token.is_closer(c.tokens[last + 1].kind) && text_lines.newlines_between(text, from: c.tokens[last].span.end, to: c.tokens[last + 1].span.start) == 0
        last @ last + 1

    return token.Span(start: c.tokens[at].span.start, end: c.tokens[last].span.end)

# What a line's reader names at the token under the cursor, `found` where it
# stands alone, or the run of strays it begins (`stray_run`).
function found_run(c: cursor.Cursor, text: str, found: str) -> str
    run = stray_run(c, text, at: c.pos)

    if run.end == cursor.current_span(c).end
        return found
    return "`" + cursor.slice_of(text, run) + "`"

# Where the last report said that begins at the token `at` ends, or -1: a
# walk back from the last, which finds one said on the line in hand at once.
function told_to(c: cursor.Cursor, at: i64) -> i64
    i: i64 @ c.diagnostics.len() - 1

    while i >= 0 && c.diagnostics[i].span.start != c.tokens[at].span.start
        i @ i - 1

    if i < 0
        return -1
    return c.diagnostics[i].span.end
