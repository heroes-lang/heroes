# [T] and {K: V} as C: built through the runtime, read through a
# descriptor, written with ONE UNSHARE PER STEP (design.md §4.9, §4.10;
# panels 022, 062). Port of crates/heroes/src/emit/container.rs.
#
# One file because they are the same mechanism wearing two names:
# neither is a C aggregate, both are a pointer to a runtime header, and
# every element or pair crosses that boundary BY ADDRESS, copied
# through its HeroDesc — which is what lets one runtime function insert
# a str key and a Point value.
#
# The two rules worth reading before changing anything:
# - Copy-on-write is one unshare per step of a mutated place (panel
#   022, measured). Not one at the primitive — that lets a nested store
#   alias, and every instrument in this project reported success while
#   it did.
# - A map step ends a place walk and an array step does not: m[k] @ v
#   inserts, so there is no element to descend into; xs[i] @ v has one,
#   and descending means unsharing this level first.
#
# What is NOT here: hero_array_at's bounds check and hero_map_find's
# NULL are the runtime's. This module only spells the calls.

use ast
use source
use check_table
use check_state
use ir
use ir_state
use ir_layout
use emit_mangle
use emit_ctype
use emit_descriptors
use emit_aggregate
use emit_storageless
use parse
use resolve
use checker
use token

# t4 = hero_array_new(&hero_desc_int, 3); plus one push per element.
# Built by pushing rather than writing the elements directly, because
# push is where the element's copy runs — and that copy is what takes
# the array's own reference to a counted element. Each push hands back
# a NEW array and the previous one is released: n+1 blocks, n freed —
# §4.10's declared bill in its smallest form.
function build_array(c: check_state.Checked, names: emit_ctype.Names, result: i64, arguments: [str], into: str) -> [str]?
    element: i64 @ 0 - 1
    match check_table.get(c.types, result)
        .array arr => element @ arr.element
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => element @ element
        .fixed | .map | .fallible | .function_ty | .named => element @ element
        .case_ty | .failure | .generic | .error => element @ element
    if element < 0
        return fail("none", "not an array")
    desc = emit_descriptors.pointer(c, names, ty: element)
    if desc.is_err()
        return fail("none", "no descriptor for the element")
    hint: i64 @ arguments.len()
    if hint < 1
        hint @ 1
    lines: [str] @ [into + " = hero_array_new(" + desc.must() + ", " + hint.to_str() + ");"]
    for value in arguments
        lines @ lines.push("{ HeroArrayHeader *grown = hero_array_push(" + into + ", &" + value + ");")
        lines @ lines.push("  hero_array_decref(" + into + "); " + into + " = grown; }")
    return ok(lines)

# t9 = *(const int64_t *)hero_array_at(t7, t8); — the read goes through
# the runtime because that is where the bounds check lives. The cast is
# on the RESULT, so the element type is stated at every read and clang
# checks the assignment. `{spelling} const *`, not `const {spelling} *`:
# the two differ exactly when the element is itself a pointer.
function read_element(c: check_state.Checked, s: source.Source, decls: [ast.Decl], names: emit_ctype.Names, f: ir_state.Function, base: i64, index: i64) -> str?
    # A fixed array is subscripted directly, and guarded HERE (panel
    # 062): the subscript stays on an array-typed lvalue because that is
    # the only form UBSan's array-bounds can see, and the guard is the
    # compiler's because -Warray-bounds was measured not to fire on an
    # opaque index. Unsigned comparison so one test catches both ends.
    #
    # THE BASE ROUTES THROUGH storageless.fixed_text, and the note that
    # used to stand here instead is why (panel 085 R6). It said the
    # routing would arrive "when that module lands", and the module
    # landed — emit_construct.hero already calls it — while this call
    # site kept the plain temporary. A fixed array is never DECLARED, so
    # that temporary does not exist: the emitted C read `t20[...]` where
    # `t20` appeared nowhere else in 20 MB of output, and `heroes build`
    # was exit 2 with `use of undeclared identifier` on three ordinary
    # programs. The note's closing clause — "the same bytes for every
    # case the tests cover today" — was true only because no test
    # covered it, which is CLAUDE.md §11's premise that expires in
    # silence while the sentence around it still reads as correct.
    is_fixed: bool @ false
    fixed_len: i64 @ 0
    match check_table.get(c.types, ir_state.value_type(f, base))
        .fixed x =>
            is_fixed @ true
            fixed_len @ x.length
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_fixed @ is_fixed
        .array | .map | .fallible | .function_ty | .named => is_fixed @ is_fixed
        .case_ty | .failure | .generic | .error => is_fixed @ is_fixed
    if is_fixed
        i = emit_mangle.value(index)
        base_text: str @ emit_mangle.value(base)
        rendered = emit_storageless.fixed_text(c, s, decls, f, value: base)
        if !rendered.is_err()
            base_text @ rendered.must()
        return ok(base_text + "[((uint64_t)(" + i + ") >= UINT64_C(" + fixed_len.to_str() + ") ? (hero_panic(\"index out of range for a fixed array\"), (int64_t)0) : (" + i + "))]")
    element: i64 @ 0 - 1
    match check_table.get(c.types, ir_state.value_type(f, base))
        .array arr => element @ arr.element
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => element @ element
        .fixed | .map | .fallible | .function_ty | .named => element @ element
        .case_ty | .failure | .generic | .error => element @ element
    if element < 0
        return fail("none", "not an array")
    spelling = emit_ctype.c_type(names, c: c, ty: element)
    if spelling.is_err()
        return fail("none", "an element with no C type")
    return ok("*(" + spelling.must() + " const *)hero_array_at(" + emit_mangle.value(base) + ", " + emit_mangle.value(index) + ")")

# xs[i] @ v, and every deeper spelling of it: one unshare per array
# step, each writing back at its own level. The walk keeps a C LVALUE
# for the place reached so far rather than an address. The last step's
# set unshares a third time and that is deliberate: it is a refcount
# test, it is idempotent, and one entry point that cannot be reached
# without it beats an emitter that has to remember.
function write_element(c: check_state.Checked, names: emit_ctype.Names, s: source.Source, decls: [ast.Decl], f: ir_state.Function, at: ir.Place, value: i64) -> [str]?
    slot = f.slots[at.root]
    lvalue: str @ emit_mangle.slot(index: at.root, name: slot.name)
    ty: i64 @ slot.ty
    steps = ir_state.steps_of(f, at.path)
    lines: [str] @ []
    position: i64 @ 0
    for step in steps
        last = position + 1 == steps.len()
        match step
            .field_step fs =>
                found = emit_aggregate.field(c, s, decls, owner: ty, index: fs.at)
                if found.is_err()
                    return fail("none", "not a field of this type")
                lvalue @ lvalue + "." + found.must().member
                ty @ found.must().ty
                # A field is not an indirection: nothing to unshare. A
                # trailing field store is a plain assignment — done HERE
                # when the path holds an index, because the array levels
                # above were unshared on the way down. (Until 2026-08-17
                # this arm returned None on last, and xs[i].f @ v — first
                # written by the ported resolver — emitted
                # hero_unreachable: a runtime abort on a legal program.
                # THIS session's own fixedbugs case.)
                if last
                    # hero_array_set releases the old ELEMENT; this
                    # replaces one FIELD of it, so releasing the old
                    # value is this line's own job — without it, one
                    # heap block still live at exit, measured.
                    if ir_layout.is_refcounted(c, ty)
                        release: str @ ""
                        match check_table.get(c.types, ty)
                            .str => release @ "hero_str_decref(" + lvalue + ");"
                            .array => release @ "hero_array_decref(" + lvalue + ");"
                            .map => release @ "hero_map_decref(" + lvalue + ");"
                            .failure => release @ "hero_failure_release(&(" + lvalue + "));"
                            .named | .case_ty | .fallible =>
                                sat = emit_ctype.satellite_name(names, c, ty: ty)
                                if sat.is_err()
                                    return fail("none", "a counted field with no release")
                                release @ sat.must() + "_release(&(" + lvalue + "));"
                            .int_ty | .float_ty | .bool | .ptr | .cstr | .unit => release @ release
                            .fixed | .function_ty | .generic | .error => release @ release
                        lines @ lines.push(release)
                    lines @ lines.push(lvalue + " = " + emit_mangle.value(value) + ";")
                    return ok(lines)
            .index_step ix =>
                # A map step ends the walk: m[k] @ v inserts, so there
                # is no element to descend into.
                is_map: bool @ false
                element: i64 @ 0 - 1
                match check_table.get(c.types, ty)
                    .map => is_map @ true
                    .array arr => element @ arr.element
                    .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_map @ is_map
                    .fixed | .fallible | .function_ty | .named => is_map @ is_map
                    .case_ty | .failure | .generic | .error => is_map @ is_map
                if is_map
                    if !last
                        return fail("none", "a map step must end the walk")
                    lines @ lines.push("hero_map_set(&(" + lvalue + "), &" + emit_mangle.value(ix.value) + ", &" + emit_mangle.value(value) + ");")
                    return ok(lines)
                if element < 0
                    return fail("none", "not a container step")
                if last
                    lines @ lines.push("hero_array_set(&(" + lvalue + "), " + emit_mangle.value(ix.value) + ", &" + emit_mangle.value(value) + ");")
                    return ok(lines)
                lines @ lines.push("hero_array_unshare(&(" + lvalue + "));")
                spelling = emit_ctype.c_type(names, c: c, ty: element)
                if spelling.is_err()
                    return fail("none", "an element with no C type")
                lvalue @ "(*(" + spelling.must() + " *)hero_array_at_mut(" + lvalue + ", " + emit_mangle.value(ix.value) + "))"
                ty @ element
        position @ position + 1
    return fail("none", "not an element write")

# t5 = hero_map_new(&hero_desc_str, &hero_desc_int, 2); plus one put per
# pair — the arguments alternate key, value, both in by address.
function build_map(c: check_state.Checked, names: emit_ctype.Names, result: i64, arguments: [str], into: str) -> [str]?
    key: i64 @ 0 - 1
    value_ty: i64 @ 0 - 1
    match check_table.get(c.types, result)
        .map m =>
            key @ m.key
            value_ty @ m.value
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => key @ key
        .array | .fixed | .fallible | .function_ty | .named => key @ key
        .case_ty | .failure | .generic | .error => key @ key
    if key < 0
        return fail("none", "not a map")
    key_desc = emit_descriptors.pointer(c, names, ty: key)
    value_desc = emit_descriptors.pointer(c, names, ty: value_ty)
    if key_desc.is_err() || value_desc.is_err()
        return fail("none", "a side with no descriptor")
    pairs = arguments.len() / 2
    lines: [str] @ [into + " = hero_map_new(" + key_desc.must() + ", " + value_desc.must() + ", " + pairs.to_str() + ");"]
    walk: i64 @ 0
    while walk + 1 < arguments.len()
        lines @ lines.push("hero_map_put(" + into + ", &" + arguments[walk] + ", &" + arguments[walk + 1] + ");")
        walk @ walk + 2
    return ok(lines)

# m[k], which is NOT xs[i]: it yields a V? and cannot abort. The
# runtime hands back the value's address or NULL — it cannot build the
# option, that struct is generated per payload type — so the wrapping
# is here, and the found value is COPIED through its descriptor: the
# map still owns its copy, and the V? needs one of its own.
function map_get(c: check_state.Checked, names: emit_ctype.Names, f: ir_state.Function, map_value: i64, key: i64, result: i64, into: str) -> [str]?
    value_ty: i64 @ 0 - 1
    match check_table.get(c.types, ir_state.value_type(f, map_value))
        .map m => value_ty @ m.value
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => value_ty @ value_ty
        .array | .fixed | .fallible | .function_ty | .named => value_ty @ value_ty
        .case_ty | .failure | .generic | .error => value_ty @ value_ty
    if value_ty < 0
        return fail("none", "not a map")
    option = emit_ctype.option_of(names, ty: result)
    lines: [str] @ ["{"]
    lines @ lines.push("  const void *found = hero_map_find(" + emit_mangle.value(map_value) + ", &" + emit_mangle.value(key) + ");")
    lines @ lines.push("  if (found == NULL) {")
    lines @ lines.push("    " + into + " = (" + option + "){.tag = INT64_C(1), .as.err = hero_failure_missing_key()};")
    lines @ lines.push("  } else {")
    lines @ lines.push("    " + into + ".tag = INT64_C(0);")
    # A unit value type has no ok member at all, so the tag is the
    # whole answer.
    if !emit_ctype.c_type(names, c: c, ty: value_ty).is_err()
        desc = emit_descriptors.pointer(c, names, ty: value_ty)
        if desc.is_err()
            return fail("none", "a value with no descriptor")
        lines @ lines.push("    (" + desc.must() + ")->copy(&" + into + ".as.ok, found);")
    lines @ lines.push("  }")
    lines @ lines.push("}")
    return ok(lines)

## Tests

record Setup
    c: check_state.Checked
    s: source.Source
    decls: [ast.Decl]
    names: emit_ctype.Names

function ready(text: str) -> Setup
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: check_state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names = emit_ctype.new_names(s, p.decls)
    return Setup(c: c, s: s, decls: p.decls, names: names)

test "an array literal is new plus push/decref pairs, a read is a cast"
    got = ready("function main()\n    xs = [1, 2]\n    print(xs[0])\n")
    arr = check_table.lookup(got.c.types, .array(element: check_table.int_ty_id(got.c.types))).must()
    lines = build_array(got.c, got.names, result: arr, arguments: ["t1", "t2"], into: "t3")
    assert lines.must().len() == 5
    assert lines.must()[0] == "t3 = hero_array_new(&hero_desc_int, 2);"
    assert lines.must()[1] == "{ HeroArrayHeader *grown = hero_array_push(t3, &t1);"
    assert lines.must()[2] == "  hero_array_decref(t3); t3 = grown; }"
    f = ir_state.Function(name: "t", decl: 0, kind: .function_kind, generics: [], params: [], result: 0, slots: [], blocks: [], values: [arr, check_table.int_ty_id(got.c.types)], arguments: [], steps: [], instance: [], call_instances: {}, span: token.Span(start: 0, end: 1))
    read = read_element(got.c, got.s, got.decls, got.names, f, base: 0, index: 1)
    assert read.must() == "*(int64_t const *)hero_array_at(t0, t1)"

test "the session's own fixedbug: a trailing field behind an index releases then assigns"
    got = ready("record Row\n    label: str\n\nfunction main()\n    rows = [Row(label: \"a\")]\n    rows[0].label @ \"b\"\n    print(rows[0].label)\n")
    row = check_table.lookup(got.c.types, .named(decl: 0)).must()
    arr = check_table.lookup(got.c.types, .array(element: row)).must()
    int_id = check_table.int_ty_id(got.c.types)
    slots: [ir_state.Slot] = [ir_state.Slot(name: "rows", ty: arr, kind: .local_slot)]
    steps: [ir.PathStep] = [.index_step(value: 1), .field_step(at: 0)]
    f = ir_state.Function(name: "t", decl: 1, kind: .function_kind, generics: [], params: [], result: 0, slots: slots, blocks: [], values: [arr, int_id, check_table.str_ty(got.c.types)], arguments: [], steps: steps, instance: [], call_instances: {}, span: token.Span(start: 0, end: 1))
    lines = write_element(got.c, got.names, got.s, got.decls, f, at: ir.Place(root: 0, path: ir.Run(start: 0, length: 2)), value: 2)
    # Unshare the array level, release the old str, assign — the three
    # lines the bootstrap fix of 2026-08-17 settled on.
    assert lines.must().len() == 3
    assert lines.must()[0] == "hero_array_unshare(&(h0_rows));"
    assert lines.must()[1] == "hero_str_decref((*(h_t_Row *)hero_array_at_mut(h0_rows, t1)).f_label);"
    assert lines.must()[2] == "(*(h_t_Row *)hero_array_at_mut(h0_rows, t1)).f_label = t2;"
