# The module diagnostics (M-module-namespace, panel 031).
# Port of heroes/src/resolve/errors_modules.rs in the Rust bootstrap at `m-bootstrap-archive` — in Rust a submodule
# re-exported through errors.rs; here its own file, because the §11
# threshold is a reason to split where Rust's namespacing was a reason not
# to bother.
#
# Four of them exist only because **`use` binds**: naming a module twice,
# naming one the file also declares, never reading one, and writing a
# module where a value belongs. The other three are the qualification rules
# themselves — and two of those are what the spec bought instead of a
# sentence (panel 031 R5), so the wording carries the whole rule and the
# fix carries the repair.
#
# The line between certain and guess is resolve_errors' own, applied once
# more: the near name in `geom.f` is offered as a guess and made certain by
# `rename_fit.hero` where it repairs the line and the program it writes
# says nothing new; `f` from a module with no `use` is a GUESS because
# applying it leaves a file that still needs the `use`.
#
# Two `use` lines binding one name, `module_binding_taken`, and the alias its
# fix writes are `module/binding_taken.hero`'s since defect 2368, when that
# alias grew a package's rule past this file's ceiling.
#
# **A `use` line is quoted as the file writes it, never as the compilation
# names its module** (defect 2373): in a package's own file `use text/strs`
# is the module `<core>/text/strs`, and a message quoting that, or offering
# `use <core>/text/strs`, names a line the file cannot hold, refused
# `unknown_entry` there. Each caller hands in the line's own text where it
# stands on one, and `placed.written_in` answers where it does not; the module
# itself, named in prose, keeps its identity.

use diag
use module/names as module_names
use module/placed
use placed_use
use source
use token

# One module named twice in one file. Not a shadowing error and not a
# duplicate declaration — it is a line that does nothing, and saying which
# of the three it is costs nothing here and a guess to the reader otherwise.
# `written` is the path the line writes.
function used_twice(written: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "used_twice",
        message: "`" + written + "` is already named by a `use` in this file — one `use` per module is all there is to say",
        span: span
    )

# `use geom` in a file that also declares `geom`. Spec's shadowing rule,
# reached because `use` BINDS (panel 031 R3): the module name and the
# declaration are one name meaning two things.
#
# `line` is what the line writes after `use`, its `as` too, and `binding`
# the name it takes: until defect 2373 the binding was quoted as the line,
# so `use text/strs` was told as *`use strs` binds `strs`*, a line no file
# held, in the program's own file as in a package's.
function use_shadows_a_declaration(line: str, binding: str, declared_at: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "shadowed_binding",
        message: "`use " + line + "` binds `" + binding + "`, and this file already declares `" + binding + "` at " + declared_at + " — shadowing is an error here, so one of the two has to be renamed",
        span: span
    )

# The mirror of the one above: a LOCAL, a parameter or an `@` cell taking a
# name a `use` already bound. Same rule, same code, and the direction nobody
# wrote until panel 102 found what it let through — `state.value` meaning a
# record field in one function and a module function in another, exit 0.
# The fix stays a **`guess`** for panel 101 R4's reason: either name may give
# way, and §8 makes `certain` machine-applicable.
#
# The module is named as the local's file writes it, `placed.written_in`
# asked here rather than by the caller, which stands in a module already
# past its ceiling (`resolve/state.hero`); a module bound by a line of the
# file always has that path, and its identity stands in for the "" no line
# reaches.
function local_shadows_a_use(name: str, module: str, s: source.Source, span: token.Span) -> diag.Diagnostic
    shown: str @= placed.written_in(s.reached.aliases, from: source.module_at(s, span.start), module: module)

    if shown == ""
        shown @ module
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "shadowed_binding",
        message: "`" + name + "` is what this file calls the module `" + shown + "`, so a local may not take it — shadowing is an error here",
        span: span
    )
    d.notes @ d.notes.push(
        "rename the module for this file with `use " + shown + " as <other>`, which clears every collision in it at once, or rename this binding"
    )
    return d

# A `use` nothing read. The unused rule, reached the same way. `written` is
# the path the line writes.
function unused_use(written: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unused_binding",
        message: "`use " + written + "` is never used — nothing in this file names anything from `" + written + "`",
        span: span
    )
    d.notes @ d.notes.push("delete the line: an import that is not read is a dependency that is not real")
    return d

# `geom.f` where `geom` is a module this file `use`s and `f` is not in it.
#
# `qualifier` is what the author WROTE before the dot and `module` is the
# module's own name; since `as` exists they differ, and the fix has to carry
# the first one (panel 101 — this fix was `certain` and did not compile).
#
# **The one near name is offered as a guess, and certain only where
# `rename_fit.hero` proves it**, as a local name's rename is: the name's own
# letters allow it alone (`near_names.one_reading`; defect 135, the
# certain-fix audit's R3, which found this site with no guard at all:
# `calc.sub(a: 7, b: 2)` became `calc.sum` and printed 9 where 5 was meant,
# and `calc.median([1, 2, 9])` became `calc.mean` and printed 4 where 2 was),
# and the program it writes says nothing new (defect 220: `calc.totl(2.5)`
# became `calc.total`, which takes `[i64]`, refused anew).
function not_in_module(module: str, qualifier: str, name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unknown_in_module",
        message: "module `" + module + "` declares nothing called `" + name + "`",
        span: span
    )

    if near.len() == 1
        d.message @ "module `" + module + "` declares nothing called `" + name + "` — it has `" + near[0] + "`"
        d.fixes @ d.fixes.push(
            diag.Fix(title: "write `" + qualifier + "." + near[0] + "`", replacement: near[0], span: span, certainty: .guess)
        )
    else if near.len() > 1
        d.message @ "module `" + module + "` declares nothing called `" + name + "` — it has " + listed(near)
    return d

# The one panel 031 R5 bought instead of a spec sentence: an unqualified
# name that exists, in a module this file already `use`s. The error says
# everything at the call site, with the repair pre-written (CLAUDE.md §8) —
# and the repair is a GUESS, not a certain fix, since 2026-09-03.
#
# **Why it was certain, and why it is not.** Panel 031's trade was that the
# spec says nothing about UFCS across a module boundary because this error
# carries the repair, and it carried it as `.certain` until a measurement
# on the seed of 2026-09-02 17:52: `use window` beside a local `window: ptr`
# and `_ = window.destroy()` — the FFI's most natural spelling — gives
# `shadowed_binding` AND this diagnostic, and `heroes check --apply` wrote
# `window.window.destroy()`; applying that writes
# `window.window.window.destroy()`. The fix reproduces itself, because
# `ptr` has no fields, so the dot falls to the module path every time and
# the repair prepends a qualifier the line already has. Panel 101 R4: a
# certain fix that does not compile is the one thing a fix may never be —
# and CLAUDE.md §8's promise that CI checks an applied certain fix had never
# once run on a module diagnostic, because `.fixed` lived only in `check/`
# and every module diagnostic needs two files. M-robustness-guards step 2
# gives the multi-file fixtures a `.fixed` of their own, and
# `tests/golden/surface-fixtures/qualifyptr/` pins this program.
# **The qualifier is what the IMPORTING FILE calls the module** (spec
# § Files and layout; panels 099 R3, 100). It is passed in rather than
# derived here, because since `as` exists only the caller knows it: the
# module's own name answers a different question, and a fix built from it
# would name a line the author never wrote.
function needs_qualifying(name: str, qualifier: str, module: str, span: token.Span) -> diag.Diagnostic
    binding = qualifier
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "needs_qualifying",
        message: "`" + name + "` is declared in module `" + module + "`, and a name from another module is always written qualified — `" + binding + "." + name + "`",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `" + binding + "." + name + "`", replacement: binding + "." + name, span: span, certainty: .guess)
    )
    return d

# The same, for a module the file has not named yet. The fix is NOT
# certain: it repairs this line and leaves the file needing a `use`, and a
# machine-applicable fix has to leave a program that checks clean.
# **The one site that legitimately derives the binding rather than reading
# it**: this file does not `use` the module yet, so there is no per-file name
# to read — the message tells the author to add the `use`, and the qualifier it
# offers must therefore be what that `use` WOULD bind. That is the language's
# default rule, and `module_names.binding_of` is where the rule lives. Every
# other site asks `resolved.binding_in`, because every other site has a file.
# The line to add is `written`, the path this file's `use` writes for the
# module (`placed.written_in`; defect 2373): in a package's own file the
# package's module is written bare, `use text/strs`.
function needs_a_use(name: str, module: str, written: str, span: token.Span) -> diag.Diagnostic
    binding = module_names.binding_of(module)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "needs_qualifying",
        message: "`" + name + "` is declared in module `" + module + "`, which this file does not name — add `use " + written + "` at the top and write `" + binding + "." + name + "`",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `" + binding + "." + name + "` (and add `use " + written + "`)", replacement: binding + "." + name, span: span, certainty: .guess)
    )
    return d

# A name only modules no `use` of this file can name declare (defect 2379):
# `mine()` in a file of the package `core` where the program's own
# `other/strings` alone declares `mine`. It was told `unknown_name` with a near
# name's rename and a note on binding C, both pointing away from the cause.
# Each module is named by its identity with why no line of `from` reaches
# it, in three groups: the program's, which no file of a package names (spec
# § 1: a package's `use` starts at its own root, and its brackets name the
# entries of its own catalogue); a package's that `from`'s package lists in no
# catalogue of its own; one private to another (panel 235's R16), the one
# group whose module `placed.written_in` spells, the line being there and
# refused. No fix: where the declaration should stand is the author's choice.
function out_of_reach(name: str, modules: [str], s: source.Source, from: str, span: token.Span) -> diag.Diagnostic
    program: [str] @= []
    packaged: [str] @= []
    held: [str] @= []
    owners: [str] @= []

    for module in modules
        if placed.written_in(s.reached.aliases, from: from, module: module) != ""
            held @ held.push(module)
            owners @ owners.push(placed_use.internal_owner(module))
        else if placed.is_package(module)
            packaged @ packaged.push(module)
        else
            program @ program.push(module)

    said: [str] @= []

    if program.len() > 0
        said @ said.push(
            listed(program) + " " + counted(program, one: "is a module", many: "are modules") + " of the program, and no file of the package `" + placed.entry_of(from) + "` names a module of the program that uses it"
        )

    if packaged.len() > 0
        said @ said.push(
            listed(packaged) + " " + counted(packaged, one: "is a module of a package", many: "are modules of packages") + " that the package `" + placed.entry_of(from) + "` lists in no catalogue of its own"
        )

    for at in range(from: 0, to: held.len())
        said @ said.push("`" + held[at] + "` is private to `" + owners[at] + "`")

    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unknown_name",
        message: "nothing named `" + name + "` is in scope, and no `use` of this file can name a module declaring it: " + said.join("; "),
        span: span
    )

    if program.len() + packaged.len() > 0
        d.notes @ d.notes.push(
            "inside a package a `use` starts at the package's own root, and its angle brackets name the entries of the package's own catalogue (spec § 1): what a package calls is declared in the package itself or in a package its catalogue lists"
        )

    if held.len() > 0
        d.notes @ d.notes.push(
            placed_use.PRIVATE_RULE + ": name what its owner offers instead"
        )
    return d

# `one` for a single module, `many` for several.
function counted(modules: [str], one: str, many: str) -> str
    if modules.len() == 1
        return one
    return many

# An `extern` reached from another module (panel 033 R5, carried by
# M-separate-compilation acceptance row 1). clang verifies an extern
# against its header only in the translation unit that declares it, so a
# cross-module mention would be compiled where the header's checks are
# not — the shape row 1 exists to prevent, measured: a caller built on a
# compiler-written prototype took a double-returning C function declared
# `-> i64` at exit 0 and printed 3 where the truth is 3.5 (panel 091).
# One diagnostic for both spellings (qualified, and the library's
# unqualified reach) and for both uses — a call, and taking the function
# as a value, because the address needs the header exactly as the call
# does. The library arm names the route a reader can actually take: its
# externs are all wrapped, and the wrapper is the Heroes function.
function extern_across_modules(name: str, module: str, is_library: bool, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "extern_across_modules",
        message: "`" + name + "` is an `extern` of module `" + module + "` — an extern is never reachable across a module boundary, because only `" + module + "` carries the header that checks it",
        span: span
    )

    if is_library
        d.message @ "`" + name + "` is the library's own `extern` — an extern is never reachable across a module boundary, and the library is a module"
        d.notes @ d.notes.push(
            "every extern the library declares is wrapped by a library function, and the wrapper is the route — it adds the checks the raw extern does not have"
        )
    else
        d.notes @ d.notes.push(
            "write a Heroes function beside the `extern` in `" + module + "` and call that — the wrapper is compiled in the module whose header clang checks"
        )
    return d

# A module name standing on its own. It is not a value in any position —
# only a dot may follow it — and "unknown name" would be a lie about a name
# the file's own `use` line put there.
function module_is_not_a_value(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "module_is_not_a_value",
        message: "`" + name + "` names a module, not a value — a module can only be followed by a dot, as in `" + name + ".something`",
        span: span
    )

# `geom.f` where `geom` is not a module this file names.
function not_a_module(name: str, known: [str], span: token.Span) -> diag.Diagnostic
    message: str @= "`" + name + "` is not a module this file names, and not a value either"

    if known.len() > 0
        message @ message + " — it names " + listed(known)
    return diag.new_diagnostic(code: "not_a_module", message: message, span: span)

# `a, b and c`, which is how every list in this file's messages is written.
function listed(items: [str]) -> str
    if items.len() == 0
        return ""

    if items.len() == 1
        return "`" + items[0] + "`"
    head: [str] @= []
    i: i64 @= 0

    while i < items.len() - 1
        head @ head.push("`" + items[i] + "`")
        i @ i + 1

    return head.join(", ") + " and `" + items[items.len() - 1] + "`"

## Tests

test "one candidate is offered as a guess, several stay prose"
    span = token.Span(start: 0, end: 4)
    one: [str] = ["dist2"]
    d = not_in_module(module: "geom", qualifier: "geom", name: "dsit2", near: one, span: span)
    assert d.message == "module `geom` declares nothing called `dsit2` — it has `dist2`"
    assert d.fixes.len() == 1
    assert d.fixes[0].replacement == "dist2"

    # Defect 220: what makes it certain is `rename_fit.hero`'s to prove.
    assert d.fixes[0].certainty == .guess
    twin = not_in_module(module: "geom", qualifier: "geom", name: "dist", near: one, span: span)
    assert twin.fixes.len() == 1
    assert twin.fixes[0].certainty == .guess
    three: [str] = ["a", "b", "c"]
    e = not_in_module(module: "geom", qualifier: "geom", name: "dist", near: three, span: span)
    assert e.fixes.len() == 0
    assert e.message == "module `geom` declares nothing called `dist` — it has `a`, `b` and `c`"

test "neither qualification fix is certain, and the used half's reason is measured"
    span = token.Span(start: 0, end: 5)
    have = needs_qualifying(name: "dist2", qualifier: "geom", module: "geom", span: span)
    assert have.fixes[0].certainty == .guess
    assert have.fixes[0].replacement == "geom.dist2"
    missing = needs_a_use(name: "dist2", module: "geom", written: "geom", span: span)
    assert missing.fixes[0].certainty == .guess
    assert missing.code == "needs_qualifying"

test "the list reads as prose, whatever its length"
    zero: [str] = []
    assert listed(zero) == ""
    one: [str] = ["x"]
    assert listed(one) == "`x`"
    two: [str] = ["x", "y"]
    assert listed(two) == "`x` and `y`"
    three: [str] = ["x", "y", "z"]
    assert listed(three) == "`x`, `y` and `z`"

test "an unused use carries its note, not a fix"
    d = unused_use(written: "geom", span: token.Span(start: 0, end: 8))
    assert d.fixes.len() == 0
    assert d.notes.len() == 1
    assert d.notes[0] == "delete the line: an import that is not read is a dependency that is not real"
