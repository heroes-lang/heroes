# Whether the file a `use` names is not there, or is there and cannot be read
# (spec § 1 Files and layout; design.md §1.12; defect 236). Asked by
# `modules.load_text` when the read of a module's file fails, because that
# failure does not say which: `read_file` answers `file_not_found` for a file
# it may not open, measured on this Mac 2026-10-03 for a mode of 000 and for
# a file in a directory it may not search, and the loader took every failure
# for absence, so a file that was there was told *that file is not there*.
#
# Its own module because `modules.hero` may not grow (the layout check's
# ceiling for it, 320), and because the question is the filesystem's, asked
# through `cli/files` as every other question about what is at a path is.
#
# **And whether a file that is there is text** (panel 189, defect 227): every
# source file the compilation holds is read here, the root by `cli/input`, so
# a file that is not UTF-8 is held as what it is, a text the compiler can show
# and a list of the bytes that are not text, instead of a failure that every
# reader took for *cannot read*, or for absence.

use source
use diag
use not_text
use byte_evidence
use cli/digest
use cli/files
use cli/process

# `runtime/parts/os.c` is the C, and `runtime/hero_os.h` says what the result
# holds. `lent`: the call reads the path while it runs and keeps nothing.
extern "hero_os.h"
    function hero_file_read_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64
    constant HERO_OS_NOT_TEXT: i64

# The key of a file's bytes, made in C (defect 484): `runtime/parts/key.c`,
# declared in `runtime/hero_compiler.h`, the compiler's own doors. `status` is
# the shown read's.
extern "hero_compiler.h"
    function hero_file_key(path: cstr lent, @status: i64) -> str

# A file as the compilation holds it: its own text where it is UTF-8; where it
# is not, the text with each byte that is not part of a well-formed sequence
# shown as one U+FFFD, and those bytes, `at` in this text (the file's own
# offsets, which `placed` moves into the compilation's).
record Text
    text: str
    faults: [source.Fault]

# The file at `path`, or the failure `read_file` gives where nothing is there
# (`file_not_found`) or it would not read (`read_failed`). A file that is not
# UTF-8 is not a failure here: what to tell about it is `not_text.hero`'s.
function source_text(path: str) -> Text?
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_file_read_shown(path: path.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_NOT_FOUND
        return fail(code: "file_not_found", msg: "no file at " + path)

    if status != HERO_OS_OK && status != HERO_OS_NOT_TEXT
        return fail(code: "read_failed", msg: "could not read " + path)

    # A file of text has no marks, and comes back as it was read, uncopied.
    if marks == 0
        none: [source.Fault] = []
        return ok(Text(text: got, faults: none))
    shown = got.slice(from: marks, to: got.len())
    return ok(Text(text: shown, faults: not_text.faults_of(marks: got.slice(from: 0, to: marks), text: shown)))

# A file read for a cache's key: the text a reader of it scans, which is its
# own where it is UTF-8 and the shown text where it is not, and its key.
record Keyed
    text: str
    key: str

# One file's key, or the failure `source_text` gives: sixteen characters, the
# same for the same bytes and different for different ones. A header and the
# runtime's own sources are C, which may hold a byte that is not UTF-8, and
# their keys are made here (panel 189); no fault is recorded, so a large file
# costs no more than its text.
#
# **The two kinds of file cannot share a key** (panel 189's R6). A file of
# text keys as its text's digest, as it always did. A file that is not UTF-8
# keys as the digest of the runtime's whole answer, whose marks name every
# byte its text shows as U+FFFD, so the two together are its bytes, with the
# first character `n`, which `digest` never writes. Keyed as a TEXT, a line
# saying so and that answer, a header of text spelling the line shared the
# key, and the ffi-pragmatist's case 5 linked the stale object at exit 0.
#
# **Made in C since defect 484**, where `keyed` makes it from a text: the key
# is asked of the file's bytes where they lie (`hero_file_key`), and the text
# the Heroes route built for it, the shown read and `cli/digest`'s loop over it
# at `-O0`, about 1,158 instructions a byte, is not built. The two make one key
# for one file, and the test *the key made in C is the key made in Heroes*
# holds them to it over files of every shape: a seal written by the one is
# read by the other whenever a `build/` outlives a compiler.
function key_of(path: str) -> str?
    status: i64 @ 0
    got = hero_file_key(path: path.cstr(), status: @status)

    if status == HERO_OS_NOT_FOUND
        return fail(code: "file_not_found", msg: "no file at " + path)

    if status != HERO_OS_OK && status != HERO_OS_NOT_TEXT
        return fail(code: "read_failed", msg: "could not read " + path)
    return ok(got)

function keyed(path: str) -> Keyed?
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_file_read_shown(path: path.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_NOT_FOUND
        return fail(code: "file_not_found", msg: "no file at " + path)

    if status == HERO_OS_OK
        return ok(Keyed(text: got, key: digest.digest(got)))

    if status != HERO_OS_NOT_TEXT
        return fail(code: "read_failed", msg: "could not read " + path)
    return ok(Keyed(text: got.slice(from: marks, to: got.len()), key: "n" + digest.digest(got).slice(from: 1, to: 16)))

# The files whose `use` lines discovery reads next, and this one with them
# where it is text: a file that is not UTF-8 is held to be told and never
# lexed, not even for its `use` lines, which in a binary cost minutes of
# refused characters (panel 189).
function followed(added: [i64], file: Text, at: i64) -> [i64]
    if file.faults.len() > 0
        return added
    return added.push(at)

# A compilation's modules' faults, each file's moved from its own offsets into
# the compilation's text: `modules[k]` holds file k + 1's, the root being
# `rooted`'s and the library, always last, holding none.
function placed(s: source.Source, modules: [[source.Fault]]) -> source.Source
    out: source.Source @ s
    index: i64 @ 1

    for faults in modules
        for one in faults
            add_fault(@out.faults, source.Fault(at: one.at + s.files[index].start, byte: one.byte))

        index @ index + 1

    return out

# The root's faults before the modules': the root begins the text, so its own
# offsets are the compilation's and every one of them comes first.
function rooted(s: source.Source, root: [source.Fault]) -> source.Source
    out: source.Source @ s
    out.faults @ root

    for one in s.faults
        add_fault(@out.faults, one)

    return out

# Lent, so the list grows in place (defect 409): pushed through `out.faults`,
# each fault copied every one before it, and a module holding 40,000 bytes
# that are not UTF-8 cost 800 million copies before it was told.
function add_fault(@faults: [source.Fault], one: source.Fault)
    faults @ faults.push(one)

# `ok()` where nothing is at `opened`, nor can be, which the loader takes for
# an absent module and `modules.errors` tells on the `use` line; where
# something is there and cannot be read, the failure the compilation stops
# on, `cannot read` and the file as the author names it, as an unreadable
# root's is (`cli/input.hero`), at exit 2.
function nothing_at(opened: str, named: str) -> ()?
    if absent(opened)
        return ok()
    return fail(code: "unreadable", msg: "cannot read `" + named + "`")

# Whether no entry is at `opened`, nor can be. The question that fails is
# asked again of the directory that would hold the path, until one answers:
# below a file there can be nothing (`use bin/geom` beside a program `bin`,
# which POSIX answers ENOTDIR and the runtime `unknown`, where Windows says
# absent), and below a directory there may be something nobody may reach (a
# directory with no search permission), which is not absence. A path whose
# every question fails is not called absent either.
function absent(opened: str) -> bool
    at: str @ opened

    while at.len() > 0
        match files.entry(at)
            .absent        => return true
            .file | .other => return at != opened
            .directory     => return false
            .link          => return at != opened && !process.is_directory(path: at)
            .unknown       => at @ holder(at)

    return false

# `path` without its last part and the separator before it: the directory
# that would hold it, or "" where there is none to ask.
function holder(path: str) -> str
    cut: i64 @ -1
    index: i64 @ 0

    while index < path.len()
        if path[index] == '/'
            cut @ index
        index @ index + 1

    if cut <= 0
        return ""
    return path.slice(from: 0, to: cut)

## Tests

# Every shape is made under `build/`, in a directory this test removes first.
test "what is at a module's path decides between absent and cannot read"
    dir = "build/selftest-module-reading"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir + "/adir.hero").is_err()
    assert !write_file(path: dir + "/plain", text: "a file, not a directory\n").is_err()
    assert !write_file(path: dir + "/here.hero", text: "function two() -> i64\n    return 2\n").is_err()

    # Nothing there, and nothing that can be: below a file.
    assert !nothing_at(opened: dir + "/gone.hero", named: "gone.hero").is_err()
    assert !nothing_at(opened: dir + "/plain/inner.hero", named: "plain/inner.hero").is_err()
    assert !nothing_at(opened: dir + "/plain/deeper/inner.hero", named: "plain/deeper/inner.hero").is_err()
    assert !nothing_at(opened: dir + "/none/inner.hero", named: "none/inner.hero").is_err()

    # Something there: a directory, a file, and a link to nothing where this
    # platform makes links.
    match nothing_at(opened: dir + "/adir.hero", named: "adir.hero")
        .ok => assert false
        .err e =>
            assert e.code == "unreadable"
            assert e.msg == "cannot read `adir.hero`"

    assert nothing_at(opened: dir + "/here.hero", named: "here.hero").is_err()
    linked = files.symbolic_link(target: "nowhere.hero", name: dir + "/dangling.hero")

    if !linked.is_err()
        assert nothing_at(opened: dir + "/dangling.hero", named: "dangling.hero").is_err()

test "the directory that would hold a path is the path without its last part"
    assert holder("a/b/c.hero") == "a/b"
    assert holder("c.hero") == ""
    assert holder("/c.hero") == ""
    assert holder("a/") == "a"

test "a compilation's faults stand in its text, the root's first"
    inputs: [source.InputFile] = [
        source.user_file(name: "main.hero", text: "# �\n")
        source.user_file(name: "geom.hero", text: "x�\n")
    ]
    s = source.from_files(inputs)
    in_geom: [[source.Fault]] = [[source.Fault(at: 1, byte: 233)]]
    in_main: [source.Fault] = [source.Fault(at: 2, byte: 232)]
    both = rooted(placed(s, modules: in_geom), root: in_main)
    assert both.faults.len() == 2
    assert both.faults[0].at == 2
    assert both.faults[1].at == s.files[1].start + 1
    assert both.faults[1].byte == 233

test "defect 409: a module's three hundred faults stand after the root's, each moved and in order"
    inputs: [source.InputFile] = [
        source.user_file(name: "main.hero", text: "# ab\n")
        source.user_file(name: "geom.hero", text: "x".repeat(300) + "\n")
    ]
    s = source.from_files(inputs)
    in_geom: [source.Fault] @ []
    k: i64 @ 0

    while k < 300
        in_geom @ in_geom.push(source.Fault(at: k, byte: 200 + k % 50))
        k @ k + 1

    both = rooted(placed(s, modules: [in_geom]), root: [source.Fault(at: 2, byte: 255)])
    assert both.faults.len() == 301
    assert both.faults[0].at == 2 && both.faults[0].byte == 255
    k @ 0

    while k < 300
        assert both.faults[k + 1].at == s.files[1].start + k
        assert both.faults[k + 1].byte == 200 + k % 50
        k @ k + 1

test "a file of text keys as its text's digest, and a missing file fails as read_file does"
    assert !write_file(path: "build/selftest-reading-key.h", text: "int x;\n").is_err()
    assert key_of("build/selftest-reading-key.h").must() == digest.digest("int x;\n")
    assert keyed("build/selftest-reading-key.h").must().text == "int x;\n"

    match key_of("build/selftest-reading-no-such-header.h")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

# Defect 484: the key made in C, over the bytes, is the key `keyed` makes from
# the text, for a file of every shape: none, text holding a U+FFFD, Latin-1, NUL
# among Latin-1, UTF-16 with no mark, a binary, and the compiler's own sources.
test "the key made in C is the key made in Heroes, for a file of every shape"
    made = ["build/selftest-reading-empty.h", "build/selftest-reading-held.h"]
    assert !write_file(path: made[0], text: "").is_err()
    assert !write_file(path: made[1], text: "a�b\n").is_err()
    fixtures = "tests/golden/surface-fixtures/"

    for path in [made[0], made[1], fixtures + "notext227/latin1.h", fixtures + "notext227/utf16le-e-acute.txt", fixtures + "notext227/utf16be-e-acute.txt", fixtures + "notext227/nul-and-latin1.txt", fixtures + "notext241/answer-latin1.txt", "site/public/favicon.ico", "runtime/heroes_runtime.h", "selfhost/module/reading.hero"]
        assert key_of(path).must() == keyed(path).must().key

# Panel 189's R6 at the key: a header holding the byte 0xE9, committed as
# bytes, keys apart from every file of text, the one spelling what the route
# keyed it by included (the ffi-pragmatist's case 5). `cli/deps.hero`'s test
# holds the same at the record a compile is reused by.
test "a file that is not UTF-8 has a key no file of text can have"
    latin = "tests/golden/surface-fixtures/notext227/latin1.h"
    held = keyed(latin).must()
    assert held.key.len() == 16
    assert held.key[0] == 'n'
    assert held.text.len() > 0
    status: i64 @ 0
    marks: i64 @ 0
    answer = hero_file_read_shown(path: latin.cstr(), status: @status, marks: @marks)
    assert status == HERO_OS_NOT_TEXT
    assert marks == 2

    for spelled in ["not UTF-8, 2 bytes of marks:\n" + answer, answer, held.text]
        assert !write_file(path: "build/selftest-reading-spelled.h", text: spelled).is_err()
        assert key_of("build/selftest-reading-spelled.h").must() != held.key

test "a file of text reads with no faults, and a missing one fails as read_file does"
    assert !write_file(path: "build/selftest-reading-text.hero", text: "# café\n").is_err()
    t = source_text("build/selftest-reading-text.hero").must()
    assert t.text == "# café\n"
    assert t.faults.len() == 0

    match source_text("build/selftest-reading-no-such-file.hero")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

# What `not_text` tells of a file read here, alone in its compilation, as
# `cli/input` holds a root that is not text.
function told_of(path: str) -> [diag.Diagnostic]
    read = source_text(path).must()
    return not_text.told(rooted(source.new_source(name: path, text: read.text), root: read.faults), 0)

# Panel 189's R4 on the bytes of committed files: NUL at every other byte is
# UTF-16 with no mark, little-endian or big-endian by which byte is NUL, and
# NUL elsewhere names no encoding.
test "NUL at every other byte is told as UTF-16 with no mark, in either order, and NUL elsewhere is not"
    fixtures = "tests/golden/surface-fixtures/notext227/"
    little = told_of(fixtures + "utf16le-e-acute.txt")
    assert little.len() == 1
    assert little[0].notes[0] == "every other byte of the file is NUL, which is how UTF-16 little-endian writes ASCII and Latin-1, so it was saved as UTF-16 with no byte-order mark: save it as UTF-8"
    big = told_of(fixtures + "utf16be-e-acute.txt")
    assert big[0].notes[0] == "every other byte of the file is NUL, which is how UTF-16 big-endian writes ASCII and Latin-1, so it was saved as UTF-16 with no byte-order mark: save it as UTF-8"
    elsewhere = told_of(fixtures + "nul-and-latin1.txt")
    assert elsewhere[0].notes[0] == "the file also holds NUL bytes, which no source text holds: it is likely not a text file at all"
    assert byte_evidence.utf16_order(source_text(fixtures + "nul-and-latin1.txt").must().text) == ""
