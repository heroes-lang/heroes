# What a build says of a package whose placed tree is missing, where `heroes
# fetch` would refuse the address it reads it from (M-package-manager step
# 5b; panel 235's R8 and R9, the coordinator's ruling of 2026-11-08 under the
# batch's recommended answer): a `file://` source outside the program's own
# repository, a program in no repository, a source reached through a link, a
# machine with no git. The build told *not placed: `heroes fetch` places it*,
# naming a fix that cannot work; it tells the verb's refusal now, with the
# verb's code and words: `fetch/address.hero`'s `judged`, over the root
# `fetch/transport.hero`'s `root_of` asks of git, the verb's own two calls.
#
# **Asked on that error path alone.** A build that reads every tree it needs
# runs no git, and neither does a package whose tree is placed, nor an
# `https://` source, nor a `path` entry: nothing is fetched (R8), and the one
# question, where the program stands in its repository, is asked after the
# build has already failed. Git writes its answer into a staging folder
# beside the placed trees, as it does for the verb (`fetch/staging.hero`),
# its lock beside it (defect 2453), removed at once, with `heroes.packages/`
# where this question made it and nothing else stands in it (defect 2434: an
# author's own empty one stays). What a killed run left there was undone
# before discovery asked any tree (`module/packages.hero`), never here.
#
# **Never for a folder in a placed package's tree** (defect 2576): `heroes
# fetch` refuses such a folder whatever the source (defects 2462 and 2479),
# so a build compiling a file there tells that, for every source, and asks
# no git. Until then the question's staging folder stood inside the tree for
# an instant, and a build of the program that placed the tree, reading it
# then, refused that program by its sum with advice to remove a whole tree.

use cli/placed_files
use cli/process
use cli/strings
use fetch/address
use fetch/index_source
use fetch/stage_home
use fetch/staging
use fetch/transport
use fetch/verb_place
use module/catalogue
use module/reached
use placed_use

# The refusal `heroes fetch` would give the entry `e`, whose tree `package`
# names, for the program read under `program` (the directory of the file you
# compile as files are opened, `named` as the author spelt it) with the
# catalogue's `index` line; ok where the tree is placed, the source needs no
# repository, or the verb would fetch it. Where no staging folder can be
# made, git cannot be asked, and the graph's own words stand.
function refusal(package: reached.Package, e: catalogue.Entry, index: str, program: str, named: str) -> ()?
    if package.unverified || process.is_directory(path: package.opened)
        return ok()

    # Defect 2576: a program's folder in a placed package's tree is one
    # `heroes fetch` refuses whatever the source (defects 2462 and 2479), so
    # that is told, and git is never asked: its staging folder stood in the
    # tree, and a build of the program that placed the tree, reading it at
    # that moment, refused that program by its sum.
    if stage_home.in_tree(program)
        return fail(code: "", msg: in_tree_said(package, e: e, program: program, named: named))
    written: str @= e.git

    if e.version.len() > 0
        written @ index_source.written_index(index)

    if !strings.starts_with(text: written, prefix: "file://")
        return ok()
    begun = staging.begun(program)

    if begun.is_err()
        return ok()
    scratch: staging.Ledger @= begun.must()
    root = transport.root_of(transport.path_tools(), folder: verb_place.dot_if_empty(program), scratch: scratch.folder)
    staging.ended(@scratch)

    match root
        .err asked => return fail(code: asked.code, msg: asked.msg)
        .ok at =>
            match address.judged(written, root: at)
                .err judged => return fail(code: judged.code, msg: judged.msg)
                .ok _       => return ok()

# What a package not placed is told where the folder of the file you compile
# stands in a placed package's tree (defect 2576), told with the graph's
# own code. `heroes fetch` places nothing for such a folder, and the tree's
# own packages are placed beside it by the program that placed it, so its
# modules compile there; until then the build promised that `heroes fetch`
# placed the package inside the tree, where the verb refuses to write.
function in_tree_said(package: reached.Package, e: catalogue.Entry, program: str, named: str) -> str
    folder: str @= named
    opened: str @= program

    if folder.len() == 0
        folder @ "./"

    if opened.len() == 0
        opened @ "./"
    return "the package `" + e.name + "` is not placed at `" + package.root + "`, and `heroes fetch` places nothing there: the folder of the file you compile, `" + folder + "`, names a place under `" + placed_use.FOLDER + "/`" + placed_files.shown(opened) + " in the placed packages' trees, and a placed package's modules are compiled by the program that placed them, whose catalogue holds every package of the build — check that program instead"

# A refusal's words and its code, "" where there is none.
function said(refused: ()?) -> str
    match refused
        .ok    => return ""
        .err e => return e.msg

function code(refused: ()?) -> str
    match refused
        .ok    => return ""
        .err e => return e.code

## Tests

# The questions nobody asks git for: a placed tree, a folder of the author's
# own, an `https://` source, the Heroes index. None makes a staging folder,
# so `build/` keeps no `heroes.packages/` after them.
test "a tree placed, a folder, or an address on the network asks no git"
    sum = "sha256-" + "a".repeat(64.to_u64().must())
    git = catalogue.Entry(
        name: "yaml",
        version: "",
        git: "https://git.example.org/ana/yaml",
        tag: "v1",
        commit: "b".repeat(40.to_u64().must()),
        path: "",
        sum: sum
    )
    index = catalogue.Entry(name: "json", version: "1.4.2", git: "", tag: "", commit: "", path: "", sum: sum)
    missing = reached.Package(
        alias: "yaml",
        root: "x/",
        opened: "build/selftest-unplaced/nowhere/",
        problem: "",
        code: "",
        unverified: false
    )
    folder = reached.Package(
        alias: "yaml",
        root: "x/",
        opened: "build/selftest-unplaced/nowhere/",
        problem: "",
        code: "",
        unverified: true
    )
    assert !refusal(missing, e: git, index: "", program: "build/selftest-unplaced/", named: "build/selftest-unplaced/").is_err()
    assert !refusal(missing, e: index, index: "", program: "build/selftest-unplaced/", named: "build/selftest-unplaced/").is_err()
    assert !refusal(missing, e: index, index: "https://index.example.org/heroes", program: "build/selftest-unplaced/", named: "build/selftest-unplaced/").is_err()
    assert !refusal(folder, e: git, index: "", program: "build/selftest-unplaced/", named: "build/selftest-unplaced/").is_err()
    assert !process.is_directory(path: "build/selftest-unplaced/heroes.packages")

# Defect 2576: the folder of the file you compile in a placed package's tree
# is told what is true there, whatever the package's source, and nothing is
# written into the tree. Until then a `file://` source staged git inside it,
# and every source was told `heroes fetch` would place it there.
test "a package not placed for a folder in a placed tree is told so, and nothing is written there (defect 2576)"
    program = "build/selftest-unplaced-tree/"
    tree = program + "heroes.packages/json@1.0.0-k/"
    assert !process.remove_tree(program).is_err()
    assert !process.mkdir_all(tree).is_err()
    assert !write_file(path: tree + "parse.hero", text: "function x() -> i64\n    return 1\n").is_err()
    sum = "sha256-" + "a".repeat(64.to_u64().must())
    indexed = catalogue.Entry(name: "text", version: "2.0.0", git: "", tag: "", commit: "", path: "", sum: sum)
    git = catalogue.Entry(
        name: "text",
        version: "",
        git: "file://../text",
        tag: "v1",
        commit: "b".repeat(40.to_u64().must()),
        path: "",
        sum: sum
    )
    missing = reached.Package(
        alias: "text",
        root: tree + "heroes.packages/text@2.0.0-k/",
        opened: tree + "heroes.packages/text@2.0.0-k/",
        problem: "",
        code: "",
        unverified: false
    )
    told = "the package `text` is not placed at `" + tree + "heroes.packages/text@2.0.0-k/`, and `heroes fetch` places nothing there: the folder of the file you compile, `" + tree + "`, names a place under `heroes.packages/`, in the placed packages' trees, and a placed package's modules are compiled by the program that placed them, whose catalogue holds every package of the build — check that program instead"

    for one in [refusal(missing, e: indexed, index: "file://../idx", program: tree, named: tree), refusal(missing, e: git, index: "", program: tree, named: tree), refusal(missing, e: indexed, index: "https://index.example.org/heroes", program: tree, named: tree)]
        assert said(one) == told && code(one) == ""

    assert process.walk(program + "heroes.packages").must().files == [tree + "parse.hero"]
    assert !process.remove_tree(program).is_err()
