# The modules of a package a `use` is offered where its line names the
# package and no module of it (spec § 1, `use <json>/parse` reaches the module
# `parse` of the package `json`; panel 235's R16 and R18, ratified
# 2026-11-07): the modules at the root of the package's tree that a `use` of
# the file can write, read from the tree and never invented.
#
# Asked by two lines' messages, one rule in one place: `use rebel`, an entry
# named whole with no brackets (`module/package_told.whole_entry`, defect
# 2394), and `use <rebel>` alone, which the parser refuses before any
# catalogue is read (`package_mark.hero`, `package_wants_a_module`). The
# parser said `parse` was a file of the package, whatever the package held
# (defect 2438), so the parse stage now hands its reports here, where the
# file's catalogue and the package's tree can be read, and a line whose tree
# cannot be listed keeps the parser's words, which name no module.
#
# A leaf of the parse stage: nothing here reaches the parser, which
# `module/paths.hero` does, so the directory is `module/folders.hero`'s.
#
# **A module named like a built-in is offered with an alias** (defect 2549):
# no `use` line binds a built-in's name (feature 2299), so `use <tools>/sort`
# was offered and then refused `builtin_name_taken`. It is offered as the
# refusal's own `guess` would write it, `use <tools>/sort as tools_sort`
# (`module/use_alias.hero`), as `heroes new` names a face (`cli/stub.hero`).
# The built-in names are the inventory's and the library's declarations,
# read from the parse in hand, since the parser reaches this and no parser
# can be reached from here (`resolve/builtin_names.hero`).

use ast
use cli/strings
use diag
use module/folders
use module/packages
use module/placed
use module/private
use module/spelling
use module/use_alias
use module_text
use package_mark
use resolve/builtin_names
use source

# How many of a package's modules a message names.
constant SHOWN: i64
    3

# The parse stage's reports, each `package_wants_a_module` told the modules
# its package offers where its tree can be listed; every other report as it
# was. `decls` is the parse's, whose library declarations name the
# built-ins, read only where a report asks.
function wants_a_module(s: source.Source, said: [diag.Diagnostic], decls: [ast.Decl]) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= []
    library: {str: bool} @= {}
    asked: bool @= false

    for d in said
        if d.code == "package_wants_a_module"
            if !asked
                library @ builtin_names.of_library(s, decls)
                asked @ true
            out @ out.push(listed(s, d: d, library: library))
        else
            out @ out.push(d)

    return out

# `use <rebel>` told the modules at the root of the package the file's own
# catalogue names `rebel` (a package's file reads its own, R3), as that file
# writes them; `d` as the parser said it where none can be listed.
function listed(s: source.Source, d: diag.Diagnostic, library: {str: bool}) -> diag.Diagnostic
    written = placed.entry_of(source.span_text(s, d.span) + "/")
    from = source.module_at(s, d.span.start)
    meant = placed.entry_of(placed.identity(s.reached.aliases, from: from, named: "<" + written + ">/" + "x"))

    if written.len() == 0 || meant.len() == 0
        return d
    found = root_modules(base: folders.directory_text(s.name), from: from, meant: meant)
    said = phrase(written: written, found: found, library: library)

    if said.len() == 0
        return d
    out: diag.Diagnostic @= d
    out.message @ package_mark.MODULE_WANTED + said
    return out

# `use <rebel>/strconv`, the one module at its root; `use <rebel>/a` or
# `use <rebel>/b`, the modules at its root; three and `or another`, past
# three; "" where `found` offers no line. A module named like a built-in of
# `library` takes its alias (`offered_line`).
function phrase(written: str, found: [str], library: {str: bool}) -> str
    offered: [str] @= []

    for module in found
        line = offered_line(written: written, module: module, library: library)

        if line.len() > 0
            offered @ offered.push(line)

    lines: [str] @= []

    for line in offered
        if lines.len() < SHOWN
            lines @ lines.push("`" + line + "`")

    if lines.len() == 0
        return ""

    if offered.len() > SHOWN
        return lines.join(", ") + " or another of the modules at its root"

    if lines.len() == 1
        return lines[0] + ", the one module at its root"
    return listed_or(lines) + ", the modules at its root"

# The line a `use` writes to reach `module` of the package it calls
# `written`: the plain line, or for a module named like a built-in, which no
# `use` line may bind, the line with the alias the refusal's fix writes; ""
# where that alias is none (`use_alias.alias_for`).
function offered_line(written: str, module: str, library: {str: bool}) -> str
    path = "<" + written + ">/" + module

    if !builtin_names.taken(library, module)
        return "use " + path
    alias = use_alias.alias_for(written: path, binding: module, library: library)

    if alias.len() == 0
        return ""
    return "use " + path + " as " + alias

# The modules at the root of the tree of the package the program calls
# `meant` that a `use` of the module `from` can name, in their names' byte
# order: each `.hero` file whose stem is a path the parser reads, and none
# private to the package's root (R16). None where the package's tree is not
# there to list.
function root_modules(base: str, from: str, meant: str) -> [str]
    book: packages.Book @= packages.book(named: base, opened: base)
    at = packages.reach(@book, alias: meant)
    found: [str] @= []

    if at < 0 || book.reached[at].problem.len() > 0
        return found

    for file in sort(spelling.scan(folder: book.reached[at].opened, kind: 0))
        if strings.ends_with(text: file, suffix: ".hero")
            stem = file.slice(from: 0, to: file.len() - 5)

            if module_text.is_use_path(stem) && private.reaches(from: from, name: "<" + meant + ">/" + stem)
                found @ found.push(stem)

    return found

# `a`, `a or b`, `a, b or c`.
function listed_or(lines: [str]) -> str
    if lines.len() < 2
        return lines.join("")
    return lines.slice(from: 0, to: lines.len() - 1).join(", ") + " or " + lines[lines.len() - 1]

test "the lines an entry is offered are listed with an `or` before the last"
    assert listed_or(["`a`"]) == "`a`"
    assert listed_or(["`a`", "`b`"]) == "`a` or `b`"
    assert listed_or(["`a`", "`b`", "`c`"]) == "`a`, `b` or `c`"
    none: {str: bool} = {}
    assert phrase(written: "rebel", found: ["strconv"], library: none) == "`use <rebel>/strconv`, the one module at its root"
    assert phrase(written: "rebel", found: ["a", "b"], library: none) == "`use <rebel>/a` or `use <rebel>/b`, the modules at its root"
    assert phrase(written: "rebel", found: ["a", "b", "c", "d"], library: none) == "`use <rebel>/a`, `use <rebel>/b`, `use <rebel>/c` or another of the modules at its root"

# Defect 2549: `sort` is the inventory's, `validated` the library's alone;
# each is offered by the line the built-in rule's own fix writes, and a
# module of another name as it was.
test "a module named like a built-in is offered with the alias its line's refusal would offer (defect 2549)"
    library: {str: bool} = {"validated": true}
    assert offered_line(written: "tools", module: "sort", library: library) == "use <tools>/sort as tools_sort"
    assert offered_line(written: "tools", module: "validated", library: library) == "use <tools>/validated as tools_validated"
    assert offered_line(written: "tools", module: "twice", library: library) == "use <tools>/twice"
    assert phrase(written: "tools", found: ["sort"], library: library) == "`use <tools>/sort as tools_sort`, the one module at its root"
