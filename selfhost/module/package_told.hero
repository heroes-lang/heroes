# What a `use` reaching a package is told where its module is not in the
# compilation (spec § 1; panel 235's R1, R3, R5, R7 and R18, ratified
# 2026-11-07). Asked by `modules.unknown_modules` alone, on the error path, so
# a program whose every module is found asks nothing here.
#
# Discovery records what it found of each package it reached
# (`reached.Package`, its `problem`), and this file tells it on the `use` line
# that reached it, once a package; the program's catalogue is read again here
# only to say which entry it lacks or which line of it does not read, once a
# compilation (R5: told with its line and never applied, the catalogue being
# no file of the compilation, which a `Fix` edits).
#
# Each answer names the file the program must change and what to write
# (design.md §4.17). **A repair that moves a `use` across the mark is
# `certain` only where nothing on the other side answers the same path**
# (R18, the compiler-engineer's rule): taking the brackets off `use
# <roman>/numeral` because the program has its own `roman/numeral.hero` would
# compile that module in the package's place where the entry was deleted or
# mistyped, so that repair is a `guess`; putting brackets on `use
# roman/numeral` where `roman` is an entry, its tree holds `numeral.hero` and
# the program has no `roman/numeral.hero` is `certain`.

use ast
use cli/files
use cli/strings
use diag
use module/catalogue
use module/packages
use module/paths
use module/placed
use module/reached
use module/spelling
use module_text
use placed_use
use source
use token

# What `used` is told, `name` its module in the compilation ("" where no
# package of the build answers it), none where an earlier `use` already told
# its cause: `told` holds what the graph said before.
function unknown(s: source.Source, used: ast.Use, name: str, told: [diag.Diagnostic]) -> [diag.Diagnostic]
    span = used.name
    from = source.module_at(s, used.span.start)
    written = source.span_text(s, span)
    none: [diag.Diagnostic] = []

    if placed.is_package(from) && name.len() == 0
        owner = placed.entry_of(from)
        return [
            diag.new_diagnostic(code: "unknown_entry", message: "`<" + placed.entry_of(written) + ">` is no entry of the catalogue of the package `" + owner + "`, `" + root_of(s, alias: owner) + catalogue.FILE + "`: the package names a package its catalogue does not hold, and a package is fetched whole — `heroes fetch` places it again", span: span)
        ]
    entry = placed.entry_of(name)

    for p in s.reached.packages
        if p.alias == entry && p.problem.len() > 0
            if said(told, code: told_code(p), entry: entry)
                return none
            return [
                diag.new_diagnostic(code: told_code(p), message: "`<" + entry + ">` cannot be read: " + p.problem, span: span)
            ]

        if p.alias == entry
            return [
                diag.new_diagnostic(code: "unknown_package_module", message: "the package `" + entry + "` has no module `" + placed.inside_of(name) + "`: `use " + written + "` reads `" + p.root + placed.inside_of(name) + ".hero`, and that file is not there", span: span)
            ]

    base = paths.directory_text(s.name)
    listed = catalogue.read(opened: base, named: base)

    if listed.problem.len() > 0
        if said(told, code: listed.code, entry: "")
            return none
        return [
            diag.new_diagnostic(code: listed.code, message: "`use " + written + "` reaches a package through the catalogue, and it does not read: " + listed.problem + " — a catalogue that does not read names no package, the lines above that one included", span: span)
        ]
    return [no_entry(s, listed: listed, entry: entry, inside: placed.inside_of(name), span: span)]

# `<json>` is no entry: of no catalogue, there being none, or of the program's.
# A `guess` takes the brackets off where the program's own module of that
# path is there (R18).
function no_entry(s: source.Source, listed: catalogue.Catalogue, entry: str, inside: str, span: token.Span) -> diag.Diagnostic
    base = paths.directory_text(s.name)
    message: str @= "`<" + entry + ">` names no entry: there is no catalogue `" + base + catalogue.FILE + "` beside `" + s.name + "`, the file you compile, and a package's module is read only through its entry there — `heroes add " + entry + "` writes one"

    if listed.file.len() > 0
        message @ "`<" + entry + ">` is no entry of the catalogue `" + listed.file + "`" + entries_said(listed) + " — `heroes add " + entry + "` writes one"
    d: diag.Diagnostic @= diag.new_diagnostic(code: "unknown_entry", message: message, span: span)

    # A GUESS, never certain: where the catalogue or its entry was deleted,
    # the program's own module of that path is another module, and applying
    # the repair would compile it in the package's place.
    if present(base + entry + "/" + inside + ".hero")
        d.fixes @ d.fixes.push(
            diag.Fix(title: "write `use " + entry + "/" + inside + "`", replacement: entry + "/" + inside, span: span, certainty: .guess)
        )
    return d

function entries_said(listed: catalogue.Catalogue) -> str
    if listed.entries.len() == 0
        return ", which holds none"
    names: [str] @= []

    for e in listed.entries
        names @ names.push("`" + e.name + "`")

    return ", whose entries are " + names.join(", ")

# A bare `use` no own module answers: told with its mark where its first part
# is an entry of the catalogue and the package holds the module, the brackets
# forgotten (R18), the repair certain where the package's placed tree holds
# the file, since nothing of the program's own answers that path, and a
# `guess` where the tree is not there to ask; else as a module the directory
# does not hold (`spelling.unknown`, defect 2290).
function own_unknown(s: source.Source, uses: [ast.Use], used: ast.Use, name: str) -> diag.Diagnostic
    base = paths.directory_text(s.name)
    entry = head_of(name)
    listed = catalogue.read(opened: base, named: base)

    if catalogue.entry(listed, name: entry).is_err()
        return spelling.unknown(s, uses, used: used, base: base, name: name)

    if entry == name
        return whole_entry(s, uses, used: used, listed: listed, entry: entry)
    marked = "<" + entry + ">/" + name.slice(from: entry.len() + 1, to: name.len())
    book: packages.Book @= packages.book(named: base, opened: base)
    at = packages.file_of(@book, marked)
    certainty: diag.Certainty @= .guess

    if !at.is_err()
        if !present(at.must().opened)
            return spelling.unknown(s, uses, used: used, base: base, name: name)
        certainty @ .certain
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "package_unmarked",
        message: "there is no module `" + name + "` of this program, and `" + entry + "` is an entry of its catalogue: a package's module is written in angle brackets — `use " + marked + "`",
        span: used.name
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `use " + marked + "`", replacement: marked, span: used.name, certainty: certainty)
    )
    return d

# A bare `use` naming an entry of the catalogue whole, `use core` with no
# `core.hero` beside the file (defect 2394): told as the module the directory
# does not hold, as `spelling.unknown` tells it, and that `core` is an entry,
# reached through one of its modules in angle brackets. It was told the first
# half alone, the entry's word given to `use core/strconv` and kept from this
# line, which `import core`'s certain fix writes. No repair: which module is
# meant is the author's.
function whole_entry(s: source.Source, uses: [ast.Use], used: ast.Use, listed: catalogue.Catalogue, entry: str) -> diag.Diagnostic
    base = paths.directory_text(s.name)
    d: diag.Diagnostic @= spelling.unknown(s, uses, used: used, base: base, name: entry)
    found = root_modules(base: base, from: source.module_at(s, used.span.start), entry: entry)
    lines: [str] @= []

    for module in found
        if lines.len() < SHOWN
            lines @ lines.push("`use <" + entry + ">/" + module + "`")

    offered: str @= "`use <" + entry + ">/parse`, `parse` standing for one of its modules"

    if found.len() > SHOWN
        offered @ lines.join(", ") + " or another of the modules at its root"
    else if lines.len() == 1
        offered @ lines[0] + ", the one module at its root"
    else if lines.len() > 1
        offered @ listed_or(lines) + ", the modules at its root"
    d.message @ d.message + "; `" + entry + "` is an entry of the catalogue `" + listed.file + "`, and a package is reached through one of its modules, written in angle brackets — " + offered
    return d

# How many of a package's modules a message names.
constant SHOWN: i64
    3

# The modules at the root of the package `entry`'s tree that a `use` of the
# module `from` can name, in their names' byte order: each `.hero` file whose
# stem is a path the parser reads, and none private to the package's root
# (R16). None where the package's tree is not there to list.
function root_modules(base: str, from: str, entry: str) -> [str]
    book: packages.Book @= packages.book(named: base, opened: base)
    at = packages.reach(@book, alias: entry)
    found: [str] @= []

    if at < 0 || book.reached[at].problem.len() > 0
        return found

    for file in sort(spelling.scan(folder: book.reached[at].opened, kind: 0))
        if strings.ends_with(text: file, suffix: ".hero")
            stem = file.slice(from: 0, to: file.len() - 5)

            if module_text.is_use_path(stem) && reaches(from: from, name: "<" + entry + ">/" + stem)
                found @ found.push(stem)

    return found

# `a`, `a or b`, `a, b or c`.
function listed_or(lines: [str]) -> str
    if lines.len() < 2
        return lines.join("")
    return lines.slice(from: 0, to: lines.len() - 1).join(", ") + " or " + lines[lines.len() - 1]

# The code a package's problem is told with: the verb's, where the build
# tells the refusal `heroes fetch` would give (`module/unplaced.hero`), else
# the graph's own.
function told_code(p: reached.Package) -> str
    if p.code.len() > 0
        return p.code
    return "package_unread"

function head_of(name: str) -> str
    at: i64 @= 0

    while at < name.len() && name[at] != '/'
        at @ at + 1

    return name.slice(from: 0, to: at)

function root_of(s: source.Source, alias: str) -> str
    for p in s.reached.packages
        if p.alias == alias
            return p.root

    return ""

# Whether a diagnostic of `code` naming `<entry>` (any, for "") was told, its
# message asked of its bytes: a message quotes what the author wrote, and a
# cut at the entry's length split a character standing there (defect 2410's
# shape).
function said(told: [diag.Diagnostic], code: str, entry: str) -> bool
    for d in told
        if d.code == code && (entry.len() == 0 || strings.starts_with(text: d.message, prefix: "`<" + entry + ">"))
            return true

    return false

# Whether anything stands at `path`, a link to a file included.
function present(path: str) -> bool
    match files.entry(path)
        .absent                                        => return false
        .file | .directory | .link | .other | .unknown => return true

## Private modules

# Every `use` naming a private module from outside its owner (panel 235's
# R16, ratified 2026-11-07, the program's own folders as well as a
# package's): `<core>/strings/internal/scan` is `<core>/strings`'s, the
# module before the LAST `internal` part, and only that module and the
# modules under it name it, Go's rule for `internal` since Go 1.4.
function private_reaches(s: source.Source, uses: [ast.Use], found: [diag.Diagnostic]) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= found

    for used in uses
        from = source.module_at(s, used.span.start)
        name = placed.identity(s.reached.aliases, from: from, named: source.span_text(s, used.name))

        if !reaches(from: from, name: name)
            owner = owner_of(name)
            out @ out.push(
                diag.new_diagnostic(code: "private_module", message: "`" + name + "` is private to `" + owner + "`: a module under an `internal` folder is named only by the module that folder belongs to and by the modules under it; name what `" + owner + "` offers instead", span: used.name)
            )

    return out

# Whether the module `from` may name `name` (R16): `name` stands under no
# `internal` folder, or `from` is the module that folder belongs to or a
# module under it. Asked by the `use` lines above and by what a missing
# `use` is offered (`module/answering.hero`), one rule in one place.
function reaches(from: str, name: str) -> bool
    owner = owner_of(name)
    return owner.len() == 0 || from == owner || strings.starts_with(text: from, prefix: owner + "/")

# The module a private module belongs to, "" for one under no `internal`:
# `placed_use.internal_owner`, which the parser asks too of a `use` naming a
# placed tree (defect 2390), one rule in one place.
function owner_of(name: str) -> str
    return placed_use.internal_owner(name)

test "a private module is its owner's and its owner's modules' alone"
    assert owner_of("<core>/strings/internal/scan") == "<core>/strings"
    assert owner_of("<core>/strings") == ""
    assert owner_of("a/internal/b/internal/c") == "a/internal/b"
    assert owner_of("internalx/y") == ""
    assert owner_of("a/internals/b") == ""
    assert reaches(from: "<core>/strings", name: "<core>/strings/internal/scan")
    assert reaches(from: "<core>/strings/split", name: "<core>/strings/internal/scan")
    assert !reaches(from: "<core>/stringsx", name: "<core>/strings/internal/scan")
    assert !reaches(from: "main", name: "lib/internal/strs")
    assert reaches(from: "main", name: "lib/strs")

test "the lines an entry is offered are listed with an `or` before the last"
    assert listed_or(["`a`"]) == "`a`"
    assert listed_or(["`a`", "`b`"]) == "`a` or `b`"
    assert listed_or(["`a`", "`b`", "`c`"]) == "`a`, `b` or `c`"
