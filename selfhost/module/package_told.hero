# What a `use` reaching a package is told where its module is not in the
# compilation (spec § 1; panel 235's R1, R3, R5, R7 and R18, ratified
# 2026-11-07). Asked by `modules.unknown_modules` alone, on the error path, so
# a program whose every module is found asks nothing here.
#
# Discovery records what it found of each package it reached
# (`reached.Package`, its `problem`), and this file tells it on the `use` line
# that reached it, once a package; the program's catalogue is read again here
# only to say which entry it lacks or which line of it does not read, once a
# compilation (R5: told with its line and never applied, the catalogue being
# no file of the compilation, which a `Fix` edits). A bare `use` whose first
# part is an entry is asked of the catalogue its own file reads, a package's
# through the aliases discovery mapped from it, never the program's (defect
# 2431).
#
# Each answer names the file the program must change and what to write
# (design.md §4.17). **A repair that moves a `use` across the mark is
# `certain` only where nothing on the other side answers the same path**
# (R18, the compiler-engineer's rule): taking the brackets off `use
# <roman>/numeral` because the program has its own `roman/numeral.hero` would
# compile that module in the package's place where the entry was deleted or
# mistyped, so that repair is a `guess`; putting brackets on `use
# roman/numeral` where `roman` is an entry, its tree holds `numeral.hero` and
# the program has no `roman/numeral.hero` is `certain`.

use ast
use cli/files
use cli/strings
use diag
use module/catalogue
use module/offered_modules
use module/packages
use module/paths
use module/placed
use module/private
use module/reached
use module/spelling
use source
use token

# What `used` is told, `name` its module in the compilation ("" where no
# package of the build answers it), none where an earlier `use` already told
# its cause: `told` holds what the graph said before.
function unknown(s: source.Source, used: ast.Use, name: str, told: [diag.Diagnostic]) -> [diag.Diagnostic]
    span = used.name
    from = source.module_at(s, used.span.start)
    written = source.span_text(s, span)
    none: [diag.Diagnostic] = []

    if placed.is_package(from) && name.len() == 0
        owner = placed.entry_of(from)
        return [
            diag.new_diagnostic(code: "unknown_entry", message: "`<" + placed.entry_of(written) + ">` is no entry of the catalogue of the package `" + owner + "`, `" + root_of(s, alias: owner) + catalogue.FILE + "`: the package names a package its catalogue does not hold, and a package is fetched whole — `heroes fetch` places it again", span: span)
        ]
    entry = placed.entry_of(name)

    for p in s.reached.packages
        if p.alias == entry && p.problem.len() > 0
            if said(told, code: told_code(p), entry: entry)
                return none
            return [
                diag.new_diagnostic(code: told_code(p), message: "`<" + entry + ">` cannot be read: " + p.problem, span: span)
            ]

        if p.alias == entry
            return [in_package(s, used, package: p, inside: placed.inside_of(name), written: written)]

    base = paths.directory_text(s.name)
    listed = catalogue.read(opened: base, named: base)

    if listed.problem.len() > 0
        if said(told, code: listed.code, entry: "")
            return none
        return [
            diag.new_diagnostic(code: listed.code, message: "`use " + written + "` reaches a package through the catalogue, and it does not read: " + listed.problem + " — a catalogue that does not read names no package, the lines above that one included", span: span)
        ]
    return [no_entry(s, listed: listed, entry: entry, inside: placed.inside_of(name), span: span)]

# `<json>` is no entry: of no catalogue, there being none, or of the program's.
# A `guess` takes the brackets off where the program's own module of that
# path is there (R18).
function no_entry(s: source.Source, listed: catalogue.Catalogue, entry: str, inside: str, span: token.Span) -> diag.Diagnostic
    base = paths.directory_text(s.name)
    message: str @= "`<" + entry + ">` names no entry: there is no catalogue `" + base + catalogue.FILE + "` beside `" + s.name + "`, the file you compile, and a package's module is read only through its entry there — `heroes add " + entry + "` writes one"

    if listed.file.len() > 0
        message @ "`<" + entry + ">` is no entry of the catalogue `" + listed.file + "`" + entries_said(listed) + " — `heroes add " + entry + "` writes one"
    d: diag.Diagnostic @= diag.new_diagnostic(code: "unknown_entry", message: message, span: span)

    # A GUESS, never certain: where the catalogue or its entry was deleted,
    # the program's own module of that path is another module, and applying
    # the repair would compile it in the package's place.
    if present(base + entry + "/" + inside + ".hero")
        d.fixes @ d.fixes.push(
            diag.Fix(title: "write `use " + entry + "/" + inside + "`", replacement: entry + "/" + inside, span: span, certainty: .guess)
        )
    return d

function entries_said(listed: catalogue.Catalogue) -> str
    if listed.entries.len() == 0
        return ", which holds none"
    names: [str] @= []

    for e in listed.entries
        names @ names.push("`" + e.name + "`")

    return ", whose entries are " + names.join(", ")

## A bare `use` whose first part is an entry

# The entry a bare `use`'s first part names, in the catalogue its file reads:
# the program's own for a file of the program, the package's own for a file
# of a package, never the other (defect 2431; spec § 1, *its brackets name
# entries of the package's own catalogue*). `written` is the entry as that
# file's `use` writes it between the brackets, `meant` the program's alias
# for the same package, which names its tree (`packages.reach`; R3); `whose`
# says whose file it is, `file` the catalogue, and `said` how the mark's
# message names it, "" for the program's, the one beside the file you
# compile; `editable` whether a certain repair may be written into the file,
# never one in a placed tree (`in_package`).
record Named
    written: str
    meant: str
    whose: str
    file: str
    said: str
    editable: bool

# A bare `use` no own module answers: told with its mark where its first part
# is an entry of the program's catalogue, else as a module the directory does
# not hold (`spelling.unknown`, defect 2290).
function own_unknown(s: source.Source, uses: [ast.Use], used: ast.Use, name: str) -> diag.Diagnostic
    base = paths.directory_text(s.name)
    head = head_of(name)
    listed = catalogue.read(opened: base, named: base)
    plain = spelling.unknown(s, uses, used: used, base: base, name: name)

    if catalogue.entry(listed, name: head).is_err()
        return plain
    return unmarked(
        s,
        used,
        plain: plain,
        entry: Named(written: head, meant: head, whose: "this program", file: listed.file, said: "", editable: true),
        name: name
    )

# A `use` of a package's file that no module of the package answers: told as
# the module its tree does not hold, and with its mark where the line is bare
# and its first part an entry of the package's own catalogue, read through the
# aliases discovery mapped from that catalogue (defect 2431: it was told the
# plain message alone, R18 being asked in the program's own files only).
# `inside` is the module's path in the package, `written` the line's text.
function in_package(s: source.Source, used: ast.Use, package: reached.Package, inside: str, written: str) -> diag.Diagnostic
    plain = diag.new_diagnostic(
        code: "unknown_package_module",
        message: "the package `" + package.alias + "` has no module `" + inside + "`: `use " + written + "` reads `" + package.root + inside + ".hero`, and that file is not there",
        span: used.name
    )
    head = head_of(inside)

    if placed.is_package(written)
        return plain

    for one in s.reached.aliases
        if one.package == package.alias && one.written == head
            # A placed tree is held to its fingerprint (R7), so a repair
            # written into one makes the next build refuse the tree: it is
            # shown there, and written only into a `path` entry's folder,
            # the author's own.
            file = package.root + catalogue.FILE
            entry = Named(
                written: head,
                meant: one.meant,
                whose: "the package `" + package.alias + "`",
                file: file,
                said: " `" + file + "`",
                editable: package.unverified
            )
            return unmarked(s, used, plain: plain, entry: entry, name: inside)

    return plain

# A bare `use` of `name`, its first part `entry`: the line naming the entry
# whole, or with its mark, the brackets forgotten (R18), the repair certain
# where the package's tree holds the file, since nothing on the file's own
# side answers that path, and a `guess` where the tree is not there to ask or
# the file may not be written; `plain`, what the file's own side says, where
# the tree does not hold it.
function unmarked(s: source.Source, used: ast.Use, plain: diag.Diagnostic, entry: Named, name: str) -> diag.Diagnostic
    if entry.written == name
        return whole_entry(s, used: used, plain: plain, entry: entry)
    rest = name.slice(from: entry.written.len() + 1, to: name.len())
    marked = "<" + entry.written + ">/" + rest
    base = paths.directory_text(s.name)
    book: packages.Book @= packages.book(named: base, opened: base)
    at = packages.file_of(@book, "<" + entry.meant + ">/" + rest)
    certainty: diag.Certainty @= .guess

    if !at.is_err()
        if !present(at.must().opened)
            return plain

        if entry.editable
            certainty @ .certain
    opening = "there is no module `" + name + "` of " + entry.whose + ", and `" + entry.written + "` is an entry of its catalogue" + entry.said + ": a package's module is written in angle brackets"

    # A line the private rule refuses is offered by no message (defect
    # 2452): this one says so in the line's place, the one message for the
    # brackets forgotten on a module of a package's own `internal` folder.
    private_said = private.offered_said(
        from: source.module_at(s, used.span.start),
        meant: "<" + entry.meant + ">/" + rest,
        marked: marked
    )

    if private_said.len() > 0
        return diag.new_diagnostic(
            code: "package_unmarked",
            message: opening + ", and " + private_said,
            span: used.name
        )
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "package_unmarked",
        message: opening + " — `use " + marked + "`",
        span: used.name
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `use " + marked + "`", replacement: marked, span: used.name, certainty: certainty)
    )
    return d

# A bare `use` naming an entry of the catalogue whole, `use core` with no
# `core.hero` where the file's `use` lines start (defect 2394): told as
# `plain` tells it, and that `core` is an entry, reached through one of its
# modules in angle brackets. It was told the first half alone, the entry's
# word given to `use core/strconv` and kept from this line, which `import
# core`'s certain fix writes. No repair: which module is meant is the
# author's.
function whole_entry(s: source.Source, used: ast.Use, plain: diag.Diagnostic, entry: Named) -> diag.Diagnostic
    d: diag.Diagnostic @= plain
    found = offered_modules.root_modules(
        base: paths.directory_text(s.name),
        from: source.module_at(s, used.span.start),
        meant: entry.meant
    )
    offered: str @= "`use <" + entry.written + ">/parse`, `parse` standing for one of its modules"

    if found.len() > 0
        offered @ offered_modules.phrase(written: entry.written, found: found)
    d.message @ d.message + "; `" + entry.written + "` is an entry of the catalogue `" + entry.file + "`, and a package is reached through one of its modules, written in angle brackets — " + offered
    return d

# The code a package's problem is told with: the verb's, where the build
# tells the refusal `heroes fetch` would give (`module/unplaced.hero`), else
# the graph's own.
function told_code(p: reached.Package) -> str
    if p.code.len() > 0
        return p.code
    return "package_unread"

function head_of(name: str) -> str
    at: i64 @= 0

    while at < name.len() && name[at] != '/'
        at @ at + 1

    return name.slice(from: 0, to: at)

function root_of(s: source.Source, alias: str) -> str
    for p in s.reached.packages
        if p.alias == alias
            return p.root

    return ""

# Whether a diagnostic of `code` naming `<entry>` (any, for "") was told, its
# message asked of its bytes: a message quotes what the author wrote, and a
# cut at the entry's length split a character standing there (defect 2410's
# shape).
function said(told: [diag.Diagnostic], code: str, entry: str) -> bool
    for d in told
        if d.code == code && (entry.len() == 0 || strings.starts_with(text: d.message, prefix: "`<" + entry + ">"))
            return true

    return false

# Whether anything stands at `path`, a link to a file included.
function present(path: str) -> bool
    match files.entry(path)
        .absent                                        => return false
        .file | .directory | .link | .other | .unknown => return true
