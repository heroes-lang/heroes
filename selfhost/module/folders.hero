# The directory a path starts at, as the author spelt it and as files are
# opened (spec § 1, *a `use` starts at the directory of the file you
# compile*; panel 099's R1): a path's text, read before any file opens.
#
# A leaf, moved here from `module/paths.hero` by defect 2438's repair: the
# parse stage asks it where it names the modules a package's mark may be
# followed by (`module/offered_modules.hero`), and `module/paths.hero` reads
# every `use` line through the parser, so the parser could not ask that
# module. `paths.directory_text` and `paths.open_directory` forward here.

# The root's own directory TEXT: everything up to and including the last
# separator the author wrote, or "" for a bare name. This names sibling
# files the way the author spelled the root; it never opens one (the
# premise panel 057 refused everywhere else is kept here, alone, and scope
# is what makes it survivable). Moved here from `modules.hero` at panel 211,
# whose ceiling it paid: a path's text, read before any file opens.
function directory_text(path: str) -> str
    cs = path.chars()
    cut: i64 @= -1
    index: i64 @= 0

    for ch in cs
        if ch == "/" || ch == "\\"
            cut @ index
        index @ index + 1

    if cut == -1
        return ""
    kept: [str] @= []
    index @ 0

    while index <= cut
        kept @ kept.push(cs[index])
        index @ index + 1

    return kept.join("")

# The directory files are OPENED through — the "/" rule alone, which
# is PathBuf::parent's answer on every machine the fixpoint runs on.
function open_directory(path: str) -> str
    cs = path.chars()
    cut: i64 @= -1
    index: i64 @= 0

    for ch in cs
        if ch == "/"
            cut @ index
        index @ index + 1

    if cut == -1
        return ""
    kept: [str] @= []
    index @ 0

    while index <= cut
        kept @ kept.push(cs[index])
        index @ index + 1

    return kept.join("")
