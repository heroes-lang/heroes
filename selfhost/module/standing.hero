# What stands at a placed tree's key, `heroes.packages/<name>@<version>-<key>`,
# asked of the name itself and never only of what a link there names
# (defect 2506; panel 235's R7, panel 246's R2). `heroes fetch` places a
# tree only where nothing stands, keeps one that sums to its entry's `sum`
# and replaces nothing else (defect 2493, `fetch/staging.hero`); a build's
# check reads the key the same way (`module/packages.hero`), so the advice
# one gives is what the other does. Until then the build asked whether a
# folder was there, following a link, and told a link to nothing, a link to
# a file or a file at the key as *not placed: `heroes fetch` places it*,
# which `heroes fetch` then refused to do.
#
# A link that names a folder is read through, as every reader of the tree
# reads it: where that folder sums to the entry's `sum` it is the tree, and
# where it does not it is told as the link it is.
#
# **And `heroes.packages` itself is asked the same way** (defect 2538), by
# the verbs before they make it and by a build before it asks a key under
# it: a file there was told as the system's number 17 at exit 2 by both
# verbs, and through it every key read as a name of no kind to the build.
#
# **And the catalogue's own name is read here** (defect 2572), through the
# compiler's door, which opens a regular file alone and never waits: a FIFO
# at `heroes.toml` hung every verb and every build that read it.

use cli/files
use cli/path_room
use cli/process
use cli/stands
use module/reading
use module/spelling

# What stands at a key: no name; a folder; a link naming a folder; a link
# naming nothing; a link naming something that is not a folder; a file; or a
# name that is neither a folder, a file nor a link, or one the system cannot
# answer for.
variant Standing
    nothing
    tree
    linked_tree
    dangling
    linked_file
    file
    other

# What stands at `path`, given without a trailing `/`, which would have a
# link followed before its own name is asked.
function at(path: str) -> Standing
    match files.entry(path)
        .absent    => return .nothing
        .directory => return .tree
        .file      => return .file
        .other     => return .other
        .unknown   => return .other
        .link =>
            if process.is_directory(path)
                return .linked_tree

            if process.path_exists(path)
                return .linked_file
            return .dangling

# Whether a tree's files are read there: a folder, or a link naming one.
function read_through(s: Standing) -> bool
    match s
        .tree | .linked_tree                                 => return true
        .nothing | .dangling | .linked_file | .file | .other => return false

# What stands, `stood` as the caller asked it at `path`, as a message names
# it: a FIFO, a socket and a device for what each is, and a link to a name
# that is no folder with what its chain names (defect 2572,
# `cli/stands.hero`), the name asked again for those alone. Until then all
# three were *a name that is neither a folder, a file nor a link*, and a link
# to one *a link to a file*, which a link to `/dev/zero` at `heroes.packages`
# was told as. A link whose name is not followed to a folder or a file is
# told by what its chain names: one that loops was *a link to nothing*
# (defect d-lane-blocking-small2-1's class, `add` with `heroes.toml` a link
# to itself).
function said(stood: Standing, path: str) -> str
    match stood
        .nothing     => return "nothing"
        .tree        => return "a folder"
        .linked_tree => return "a link to a folder"
        .dangling    => return "a link to " + stands.landed(path)
        .file        => return "a file"
        .linked_file => return "a link to " + stands.landed(path)
        .other       => return stands.special(path)

# What stands at `heroes.packages` that no tree can be placed under (defect
# 2538): a file, a link to a file or to nothing, or a name the system says is
# none of a folder, a file or a link; `.nothing` where a folder or a link to
# one stands, where nothing does, which a verb makes a folder, and where the
# system cannot answer for the name, whose own failure is then the one told.
function home_blocked(path: str) -> Standing
    stood = at(path)

    if read_through(stood) || stood == .other && files.entry(path) == .unknown
        return .nothing
    return stood

# What a catalogue that did not read is told, `path` as it is opened, `named`
# as a message names it and `code` the read's failure (defect 2544): by what
# stands there where that is no file, a folder above all; by the bytes where
# they are not text; else as the file the system refused to read, named once.
# Until then a folder was told *`app/heroes.toml` cannot be read: could not
# read app/heroes.toml*, the file named twice and the folder never.
function unread_said(path: str, named: str, code: str) -> str
    stood = at(path)

    if stood == .tree || stood == .linked_tree || stood == .other && files.entry(path) == .other
        return "`" + named + "` is " + said(stood, path: path) + ", where a catalogue is a file: rename it to keep it, or remove it"

    # A link to nothing (defect 2573): told as the link it is. Until then
    # every reader took it for no catalogue, and `heroes add` wrote the
    # catalogue at the place the link names, at exit 0.
    if stood == .dangling
        return "`" + named + "` is " + said(stood, path: path) + ", where a catalogue is a file: make it name one, or remove it and `heroes add` writes one"

    # A link to a FIFO, a device or a socket (defect 2572): what it names is
    # asked, since the link itself reads as one to a file.
    if stood == .linked_file && named_kind(path) == .other
        return "`" + named + "` is " + said(stood, path: path) + ", where a catalogue is a file: rename it to keep it, or remove it"

    if code == "not_text"
        return "`" + named + "` is not UTF-8, and a catalogue is text: write it again in UTF-8"
    return "`" + named + "` cannot be read: the system refused to read it, as it does a file this user may not read"

# What the chain of links at `path` finally names, `.unknown` where the
# system cannot follow it.
function named_kind(path: str) -> files.Entry
    landed = files.landing(path)

    if landed.is_err()
        return .unknown
    return files.entry(landed.must())

# The catalogue at `path`, read through the compiler's own door
# (`module/reading.hero`), which opens a regular file alone and never waits
# to open one (defect 2572: a FIFO at `heroes.toml` hung every verb and
# every build reading it, `read_file` waiting for a writer); a failure is
# `file_not_found` where nothing stands there, else `unread_said`'s words,
# a link to nothing among them (defect 2573). A path the system will not
# open for its length is none it can call absent (step 212g): Windows answered
# one as not found, and a program with a catalogue was read as one with none.
function catalogue_text(path: str, named: str) -> str?
    match reading.source_text(path)
        .ok got =>
            if got.faults.len() == 0
                return ok(got.text)
            return fail(code: "not_text", msg: unread_said(path: path, named: named, code: "not_text"))
        .err e =>
            unopened = path_room.beyond(path)

            # Its folder's listing says whether one is there: a catalogue is
            # optional, and a package with none is read without one, whatever
            # the read answered (this Mac: ENAMETOOLONG, never `not found`).
            if unopened.len() > 0
                if spelling.unlisted_file(path)
                    return fail(code: "file_not_found", msg: "no file at " + path)
                return fail(
                    code: "unread",
                    msg: "`" + named + "` cannot be read: the system will not open that path: " + unopened
                )

            if e.code == "file_not_found" && at(path) != .dangling
                return fail(code: e.code, msg: e.msg)
            return fail(code: "unread", msg: unread_said(path: path, named: named, code: e.code))

# A placed tree's path as a build holds it, `heroes.packages/<key>/`, with its
# last `/` taken off for `at`.
function unslashed(path: str) -> str
    if path.len() > 1 && path[path.len() - 1] == '/'
        return path.slice(from: 0, to: path.len() - 1)
    return path

## Tests

constant SCRATCH: str
    "build/selftest-standing"

# Defect 2506: each shape the coordinator named, read by the name at the key.
# Where this machine makes no link (Windows without the privilege), the links'
# rows have nothing to hold.
test "what stands at a key is asked of its own name, a link's kind told apart (defect 2506)"
    assert !process.remove_tree(SCRATCH).is_err()
    assert !process.mkdir_all(SCRATCH + "/tree").is_err()
    assert !process.mkdir_all(SCRATCH + "/elsewhere").is_err()
    assert !write_file(path: SCRATCH + "/afile", text: "a file\n").is_err()
    assert at(SCRATCH + "/none") == .nothing
    assert at(SCRATCH + "/tree") == .tree
    assert at(SCRATCH + "/afile") == .file
    assert unslashed(SCRATCH + "/tree/") == SCRATCH + "/tree" && unslashed("/") == "/"
    linked: i64 @= 0

    for row in [["to-tree", "elsewhere"], ["to-nothing", "nowhere"], ["to-file", "afile"]]
        if !files.symbolic_link(target: row[1], name: SCRATCH + "/" + row[0]).is_err()
            linked @ linked + 1

    assert linked == 0 || linked == 3

    if linked > 0
        assert at(SCRATCH + "/to-tree") == .linked_tree
        assert at(SCRATCH + "/to-nothing") == .dangling
        assert at(SCRATCH + "/to-file") == .linked_file
        assert read_through(at(SCRATCH + "/to-tree")) && !read_through(at(SCRATCH + "/to-nothing"))
        assert said(at(SCRATCH + "/to-nothing"), path: SCRATCH + "/to-nothing") == "a link to nothing"
        assert home_blocked(SCRATCH + "/to-nothing") == .dangling
        assert home_blocked(SCRATCH + "/to-file") == .linked_file
        assert home_blocked(SCRATCH + "/to-tree") == .nothing

    # Defect 2538: where the placed trees go, only a folder, a link to one or
    # nothing lets a tree be placed.
    assert home_blocked(SCRATCH + "/afile") == .file
    assert home_blocked(SCRATCH + "/tree") == .nothing
    assert home_blocked(SCRATCH + "/none") == .nothing

    # Defect 2544: a catalogue that did not read is told by what stands
    # there, a folder named once and as the folder it is.
    assert unread_said(path: SCRATCH + "/tree", named: "app/heroes.toml", code: "read_failed") == "`app/heroes.toml` is a folder, where a catalogue is a file: rename it to keep it, or remove it"
    assert unread_said(path: SCRATCH + "/afile", named: "app/heroes.toml", code: "not_text") == "`app/heroes.toml` is not UTF-8, and a catalogue is text: write it again in UTF-8"
    assert unread_said(path: SCRATCH + "/afile", named: "app/heroes.toml", code: "read_failed") == "`app/heroes.toml` cannot be read: the system refused to read it, as it does a file this user may not read"
    assert !process.remove_tree(SCRATCH).is_err()

# Defect 2572: a FIFO at the catalogue's name, or a link to one, is told
# what it is, and no reader of the compiler waits on it: the catalogue's,
# a source's and a key's read through the compiler's door all answer at
# once. A FIFO is made by the system's `mkfifo`, and what it made is asked of
# the name, never of the command's exit: Windows has no FIFO in its file
# system, and on the CI's Windows leg Git's `mkfifo` ended at exit 0 with
# nothing a reader opens at the name (run 43769808533, read 2026-11-19: this
# test's FIFO arm read `no file at` it). So where no FIFO stands the test
# holds the one reason it may, that this is Windows, and that the
# catalogue's read there answers at once as none; on any other platform a
# FIFO not made fails it.
test "a FIFO at the catalogue's name is told what it is, and no reader waits on it (defect 2572)"
    dir = SCRATCH + "-2572"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    made = process.run(
        program: "mkfifo",
        words: ["mkfifo", dir + "/heroes.toml"],
        out: process.discard(),
        err: process.discard()
    )

    if !made.started || made.code != 0 || !files.is_special(dir + "/heroes.toml")
        assert process.exe_suffix() == ".exe"

        match catalogue_text(path: dir + "/heroes.toml", named: "app/heroes.toml")
            .ok _  => assert false
            .err e => assert e.code == "file_not_found"
    else
        match catalogue_text(path: dir + "/heroes.toml", named: "app/heroes.toml")
            .ok _  => assert false
            .err e => assert e.msg == "`app/heroes.toml` is a FIFO, where a catalogue is a file: rename it to keep it, or remove it"

        assert reading.source_text(dir + "/heroes.toml").is_err()
        assert reading.key_of(dir + "/heroes.toml").is_err()

        if !files.symbolic_link(target: "heroes.toml", name: dir + "/linked.toml").is_err()
            match catalogue_text(path: dir + "/linked.toml", named: "app/heroes.toml")
                .ok _  => assert false
                .err e => assert e.msg == "`app/heroes.toml` is a link to a FIFO, where a catalogue is a file: rename it to keep it, or remove it"

    # A file of text reads as it is, and a name where nothing stands is
    # absent, as the build reads a program with no catalogue.
    assert !write_file(path: dir + "/kept.toml", text: "index = \"file://../idx\"\n").is_err()
    assert catalogue_text(path: dir + "/kept.toml", named: "kept.toml").must() == "index = \"file://../idx\"\n"

    match catalogue_text(path: dir + "/none.toml", named: "none.toml")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

    assert !process.remove_tree(dir).is_err()

# Defect 2573: a link to nothing at the catalogue's name is told as what it
# is, never as no catalogue, and nothing reads or writes through it; a link
# to a file is read through, the author's own. Where this machine makes links.
test "a link to nothing at the catalogue's name is told so, and a link to a file is read (defect 2573)"
    dir = SCRATCH + "-2573"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()

    if !files.symbolic_link(target: "nowhere", name: dir + "/heroes.toml").is_err()
        match catalogue_text(path: dir + "/heroes.toml", named: "app/heroes.toml")
            .ok _  => assert false
            .err e => assert e.code != "file_not_found" && e.msg == "`app/heroes.toml` is a link to nothing, where a catalogue is a file: make it name one, or remove it and `heroes add` writes one"

        assert !process.path_exists(dir + "/nowhere")
        assert !write_file(path: dir + "/real.toml", text: "index = \"file://../idx\"\n").is_err()
        assert !files.symbolic_link(target: "real.toml", name: dir + "/linked.toml").is_err()
        assert catalogue_text(path: dir + "/linked.toml", named: "linked.toml").must() == "index = \"file://../idx\"\n"
    assert !process.remove_tree(dir).is_err()

# A link to itself at the catalogue's name or at `heroes.packages` is told
# by what its chain names: the questions that follow a link fail on a loop,
# and were read as *a link to nothing* (found beside defect
# d-lane-blocking-small2-1, `heroes add` with either a link to itself).
test "a link that loops is told as one, never as a link to nothing"
    dir = SCRATCH + "-loop"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()

    if !files.symbolic_link(target: "heroes.toml", name: dir + "/heroes.toml").is_err()
        loop = "a link to a chain of links the system cannot follow"
        assert at(dir + "/heroes.toml") == .dangling && said(.dangling, path: dir + "/heroes.toml") == loop

        match catalogue_text(path: dir + "/heroes.toml", named: "app/heroes.toml")
            .ok _  => assert false
            .err e => assert e.msg == "`app/heroes.toml` is " + loop + ", where a catalogue is a file: make it name one, or remove it and `heroes add` writes one"

        assert !files.symbolic_link(target: "nowhere", name: dir + "/gone").is_err()
        assert said(at(dir + "/gone"), path: dir + "/gone") == "a link to nothing"
    assert !process.remove_tree(dir).is_err()

# Defect d-lane-win-longname-1's catalogue: a catalogue whose path the system
# will not open for its length is told where its folder may hold one, a folder
# that cannot be listed among them, and is none where its folder lists none,
# since a catalogue is optional: refused there, a package with no catalogue of
# its own was refused on the Windows box, its catalogue's path 261 characters.
test "a catalogue past the system's limit is told where its folder may hold one, and none where its folder lists none (d-lane-win-longname-1)"
    dir = SCRATCH + "-limit"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()

    match catalogue_text(path: dir + "/" + "n".repeat(256) + ".toml", named: "n.toml")
        .ok _  => assert false
        .err e => assert e.code == "file_not_found"

    match catalogue_text(path: dir + "/" + "n".repeat(256) + "/heroes.toml", named: "app/heroes.toml")
        .ok _ => assert false
        .err e =>
            head = "`app/heroes.toml` cannot be read: the system will not open that path: "
            assert e.code == "unread" && e.msg.slice(from: 0, to: head.len()) == head

    assert !process.remove_tree(dir).is_err()
