# `f"line {n}: {word}"` — the lexer's half of string interpolation (spec
# § 2 Literals; design.md Part 7 item 7; panel 121 R1 to R4, ratified 2026-09-09).
#
# ONE TOKEN KIND, `str_piece`, AND THE TEXT SAYS WHICH PIECE IT IS. The head
# starts with `f"`; every later piece starts with the `}` that closed a hole; a
# piece that ends with `{` opens a hole and one that ends with `"` closes the
# literal. So `f"a {n} b"` is three tokens, `f"a {`, `n`, `} b"`, and the hole's
# own tokens are lexed by `scan.line_body` exactly as they would be anywhere
# else. That is what makes R1's *skipping scan* free: a nested literal inside a
# hole is a `str_lit` because `"` starts one; a map literal or a call is
# brackets, and `state.emit` already counts them — so a `}` closes the hole only
# when the depth is back to what it was when the hole opened.
#
# `{{` and `}}` each write one brace and open or close nothing, and a lone
# `}` in the text is an error (panel 184 R1, ratified 2026-10-01): the hole's
# closer is read in code mode, by `closes_a_hole`, so a `}` a piece meets in
# text mode closes nothing. Until that ruling only `{{` was an escape and a
# `}` was content, so `f"{{x}}"` printed `{x}}` and `f"a}b"` printed `a}b`,
# both at exit 0 (defect 173).
#
# WHY A MODULE OF ITS OWN. `literals.hero` lexes one token and returns; this is
# a state machine that spans several tokens and the ordinary tokens between
# them, and it borrows `literals.hero`'s escape step rather than copying it.
#
# THE TEXT OF A PIECE is decoded here too, for the lowering: the delimiters
# come off, `{{` becomes `{` and `}}` becomes `}`, and the six escapes decode
# through the same `unescape` a plain literal uses, so a form that looks like
# a string escapes like one.

use token
use diag
use state
use layout
use literals
use escape

# `f"` at the cursor: the head piece.
function head(@l: state.LexState, text: str)
    start = l.pos
    l.pos @ l.pos + 2
    scan_piece(@l, text, start: start)

# A `}` at the cursor that closes a hole: the piece that follows it.
function piece(@l: state.LexState, text: str)
    start = l.pos
    l.pos @ l.pos + 1
    l.holes @ l.holes.slice(from: 0, to: l.holes.len() - 1)
    scan_piece(@l, text, start: start)

# Whether a `}` here closes a hole rather than a map literal: a hole is open,
# and every bracket opened since it has been closed again.
function closes_a_hole(l: state.LexState) -> bool
    if l.holes.len() == 0
        return false
    return l.open_brackets.len() == l.holes[l.holes.len() - 1]

# A line ended with a hole still open: the literal never closed, and the next
# line must not inherit the hole.
function line_ends(@l: state.LexState, at: i64)
    if l.holes.len() == 0
        return
    l.holes @ []
    span = token.Span(start: at, end: at)
    state.error_token(
        @l,
        diag.new_diagnostic(code: "unterminated_string", message: "this string never closes — a hole opened with `{` and the line ended before its `}` and the closing `\"`", span: span)
    )

# A piece runs to its quote or its hole's `{` on its own line, and the line
# ends where a plain literal's does, at a line feed or the carriage return
# that begins a CRLF line end (`literals.ends_line`; defect 135's L2): read
# as content, that carriage return took `raw_carriage_return`, whose certain
# `\r` wrote the line end into a literal that stayed open (lane recovery-b7).
function scan_piece(@l: state.LexState, text: str, start: i64)
    while true
        if l.pos >= text.len() || literals.ends_line(text, at: l.pos)
            break
        b = text[l.pos]

        if b == '"'
            l.pos @ l.pos + 1
            state.emit(@l, .str_piece, start)
            return

        if b == '{'
            if l.pos + 1 < text.len() && text[l.pos + 1] == '{'
                l.pos @ l.pos + 2
            else
                l.pos @ l.pos + 1
                state.emit(@l, .str_piece, start)
                l.holes @ l.holes.push(l.open_brackets.len())
                return
        else if b == '}'
            if l.pos + 1 < text.len() && text[l.pos + 1] == '}'
                l.pos @ l.pos + 2
            else
                lone_brace(@l, at: l.pos)
                l.pos @ l.pos + 1
        else if b == '\\'
            if !literals.escape_step(@l, text, .in_str, literal: start)
                break
        else
            if b == layout.CR
                literals.raw_carriage_return(@l, l.pos, .in_str)
            l.pos @ l.pos + 1

    span = token.Span(start: start, end: l.pos)
    state.error_token(
        @l,
        diag.new_diagnostic(code: "unterminated_string", message: "this string never closes — strings are single-line, `\"` to `\"`", span: span)
    )
    literals.swallow(@l, text, start: start)

# A `}` alone in a piece's text closes nothing (panel 184 R1): a hole's closer
# is read in code mode, so this one is a brace the author wrote. It has two
# readings and so two guesses, the list design.md §4.10 makes of a fix with
# two: the brace meant as text, which `}}` writes and which is what the
# literal printed before the ruling (`f"{{x}"` was this language's own
# spelling of `{x}` until then), and a brace typed once too often, which the
# deletion repairs. The token keeps its kind, so one brace is one diagnostic.
function lone_brace(@l: state.LexState, at: i64)
    span = token.Span(start: at, end: at + 1)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "lone_brace",
        message: "a `}` alone in an `f\"…\"` literal is an error — `}}` writes one brace, as `{{` does, and a `}` closes only the hole a `{` opened",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write the brace as text: `}}`", replacement: "}}", span: span, certainty: .guess)
    )
    d.fixes @ d.fixes.push(diag.Fix(title: "delete the brace", replacement: "", span: span, certainty: .guess))
    state.push_diagnostic(@l.diagnostics, d)

# Whether a piece's text closes the literal: its last byte is the quote.
function ends_closed(text: str) -> bool
    return text.len() > 0 && text[text.len() - 1] == '"'

# The text a piece contributes, decoded: delimiters off, `{{` to `{` and `}}`
# to `}`, and the six escapes as a plain literal decodes them.
#
# **The text is cut only beside a brace** (defect 110). This walked the piece
# byte by byte and sliced each byte out as a string of its own, so the first
# byte of `é` was a slice that splits a character and `print(f"é {x}")`,
# which the checker accepts, aborted the compiler at `build`. `{` and `}` are
# one byte each and never inside another character's encoding (UTF-8
# continuation bytes are 128 to 191, and every lead byte above ASCII is 192 or
# more), so a run between two doubled braces starts and ends on character
# boundaries whatever the characters are, and it is copied whole rather than
# one byte at a time.
#
# **The pairs are read as the lexer read them.** A piece that reaches this
# function lexed clean, so every brace of its text is one of a pair and no
# escape's second byte is a brace (the six are `n` `t` `r` `\` `"` `'`): a
# scan from the left meets the pairs `scan_piece` met.
function piece_text(text: str) -> str
    from: i64 @ 1

    if text.len() >= 2 && text[0] == 'f' && text[1] == '"'
        from @ 2

    if text.len() <= from
        return ""
    inner = text.slice(from: from, to: text.len() - 1)
    undoubled: [str] @ []
    run: i64 @ 0
    at: i64 @ 0

    while at < inner.len()
        if (inner[at] == '{' || inner[at] == '}') && at + 1 < inner.len() && inner[at + 1] == inner[at]
            undoubled @ undoubled.push(inner.slice(from: run, to: at + 1))
            at @ at + 2
            run @ at
        else
            at @ at + 1

    undoubled @ undoubled.push(inner.slice(from: run, to: inner.len()))
    return escape.unescape("\"" + undoubled.join("") + "\"")

## Tests

test "a piece's text loses its delimiters, whichever pair it has"
    assert piece_text("f\"line \"") == "line "
    assert piece_text("f\"line {") == "line "
    assert piece_text("}: {") == ": "
    assert piece_text("} end\"") == " end"
    assert piece_text("f\"{") == ""
    assert piece_text("}\"") == ""

test "a doubled brace is one brace, and an escape decodes as in a plain literal"
    # Panel 184 R1 (defect 173): this read `{x}}` until 2026-10-02, the
    # closing brace written twice because only `{{` was an escape.
    assert piece_text("f\"{{x}}\"") == "{x}"
    assert piece_text("f\"}}\"") == "}"
    assert piece_text("}}} and {") == "} and "
    assert piece_text("f\"a{{b}}c {") == "a{b}c "
    assert piece_text("f\"a\\tb {") == "a\tb "
    assert piece_text("}\\\"q\\\"\"") == "\"q\""
    assert piece_text("f\"\\\\}}\"") == "\\}"

test "a character above ASCII is copied whole before, after and between holes"
    # Defect 110: the first byte of `é` was sliced out alone and the build aborted.
    assert piece_text("f\"é {") == "é "
    assert piece_text("} é\"") == " é"
    assert piece_text("} → {") == " → "
    assert piece_text("f\"😀\"") == "😀"
    assert piece_text("f\"aé€😀z {") == "aé€😀z "

test "a character above ASCII survives beside a doubled brace and an escape"
    assert piece_text("f\"é{{€}}😀 {") == "é{€}😀 "
    assert piece_text("}}}é\"") == "}é"
    assert piece_text("}é}}\"") == "é}"
    assert piece_text("f\"{{é\"") == "{é"
    assert piece_text("f\"é{{\"") == "é{"
    assert piece_text("}\\té\\n€\\\\😀\"") == "\té\n€\\😀"
    assert piece_text("f\"\\\"é\\\" {") == "\"é\" "

test "the closing piece is the one that ends with the quote"
    assert ends_closed("} b\"")
    assert ends_closed("f\"plain\"")
    assert !ends_closed("f\"a {")
    assert !ends_closed("} {")
