# How a character the language refuses is named in its diagnostic (defect
# 102). A diagnostic carries everything needed to fix the program without
# opening another file (design.md §4.17), and a character written between two
# backquotes is only that when it can be seen: a stray 0x01 was printed raw,
# and the reader of *`` is not part of the language's syntax* had nothing to
# look for.
#
# Three kinds, and the line between them is the code point, a fact about the
# character in hand. A visible ASCII character is shown as itself, as it
# always was. A control character, below 0x20 or 0x7f, is named by its code
# alone, because showing it would send the raw byte to the reader's terminal.
# A character above ASCII is shown as itself AND by its code, because some of
# those cannot be seen either (a zero-width space, a no-break space, a
# bidirectional override that reorders what the terminal shows) and a code is
# what an editor's search finds.

# The name, ready to open the diagnostic's sentence.
function named(ch: str) -> str
    code = code_point(ch)

    if code < 32 || code >= 127 && code < 160
        return "the control character " + u_plus(code)

    if code < 128
        return "`" + ch + "`"

    if unseen(code)
        return "the invisible character " + u_plus(code)
    return "`" + ch + "` (" + u_plus(code) + ")"

# A text as a diagnostic writes it to a terminal (defect 244): each control
# character but a line end and a tab, C0's, DEL and C1's, by its code between
# angle brackets, `<U+001B>`, the form `cli/shell_split.shown` gives
# pkg-config's answer (defect 237). Written raw, a source line's bytes reached
# the terminal that shows the message: an ESC began a sequence that coloured
# or cleared it, a lone carriage return sent the cursor back over the line, and
# a file in UTF-16 filled it with NULs. A line end stays, since a message
# breaks its own lines; a tab stays, since the caret under an excerpt copies
# the line's tabs (`diag_render.caret`).
function visible(text: str) -> str
    if !holds_control(text)
        return text
    kept: [str] @ []

    for ch in text.chars()
        if is_control(ch)
            kept @ kept.push(written(ch))
        else
            kept @ kept.push(ch)

    return kept.join("")

# How many columns `ch` takes once `visible` has written it: its code's
# width for a control character, one for any other.
function width(ch: str) -> i64
    if is_control(ch)
        return written(ch).len()
    return 1

function written(ch: str) -> str
    return "<" + u_plus(code_point(ch)) + ">"

# A character `visible` writes by its code: below 0x20 but a line end and a
# tab, 0x7f, and 0x80 to 0x9f.
function is_control(ch: str) -> bool
    code = code_point(ch)
    return code < 32 && code != 10 && code != 9 || code >= 127 && code < 160

# Whether any byte of `text` begins such a character, asked of the bytes, so
# that a text holding none, every line of nearly every program, is handed back
# as it is. C1's characters are 0xC2 0x80 to 0xC2 0x9F in UTF-8.
function holds_control(text: str) -> bool
    at: i64 @ 0

    while at < text.len()
        b = text[at]

        if b < 32 && b != '\n' && b != '\t' || b == 127
            return true

        if b == 194 && at + 1 < text.len() && text[at + 1] >= 128 && text[at + 1] < 160
            return true
        at @ at + 1

    return false

# The characters above ASCII a terminal shows as nothing, or that change how
# it shows what follows, so writing one between backquotes shows the reader an
# empty pair or reorders the rest of the diagnostic's line: the spaces other
# than the space, the zero-width characters, the bidirectional marks,
# embeddings, overrides and isolates, the invisible operators, the
# variation selectors, the byte order mark and the tag characters. Unicode's
# own lists of default-ignorable and bidirectional control code points, as
# ranges, first and last included.
constant UNSEEN: [i64]
    [
        160
        160
        173
        173
        847
        847
        1564
        1564
        4447
        4448
        6068
        6069
        6155
        6158
        8192
        8207
        8232
        8239
        8287
        8303
        12288
        12288
        12644
        12644
        65024
        65039
        65279
        65279
        65440
        65440
        65520
        65531
        119155
        119162
        917504
        917631
        917760
        917999
    ]

# **The table is named once a call** (defect 282): a `constant` of an array
# is built where it is named, so each `UNSEEN` in the loop built all 38
# entries again, three times an entry walked, and a file of 8 KB of no-break
# spaces cost 5 billion instructions for its 7,900 messages.
function unseen(code: i64) -> bool
    ranges = UNSEEN
    at: i64 @ 0

    while at + 1 < ranges.len()
        if code >= ranges[at] && code <= ranges[at + 1]
            return true
        at @ at + 2

    return false

# The code point of the first character of `ch`, read from its UTF-8 bytes. A
# `str` is well-formed UTF-8 (spec § 3), so a lead byte is always followed by
# its continuation bytes; a continuation byte in the lead position cannot
# arrive, and it is answered as itself rather than trusted to be absent.
function code_point(ch: str) -> i64
    if ch.len() == 0
        return 0
    lead = to_i64(ch[0]).must()

    # ASCII is itself, and 0x80 to 0xbf is a continuation byte, which cannot
    # lead: both answer the byte.
    if lead < 192
        return lead

    if lead >= 240 && ch.len() >= 4
        return (lead - 240) * 262144 + continued(ch, at: 1) * 4096 + continued(ch, at: 2) * 64 + continued(ch, at: 3)

    if lead >= 224 && ch.len() >= 3
        return (lead - 224) * 4096 + continued(ch, at: 1) * 64 + continued(ch, at: 2)

    if ch.len() >= 2
        return (lead - 192) * 64 + continued(ch, at: 1)
    return lead

# The six bits a continuation byte carries.
function continued(ch: str, at: i64) -> i64
    return to_i64(ch[at]).must() - 128

# `U+` and the code in upper-case hexadecimal, at least four digits, which is
# how Unicode itself writes one.
function u_plus(code: i64) -> str
    digits = "0123456789ABCDEF"
    out: str @ ""
    left: i64 @ code

    while left > 0
        out @ digits.slice(from: left % 16, to: left % 16 + 1) + out
        left @ left / 16

    while out.len() < 4
        out @ "0" + out

    return "U+" + out

# **Unicode's Default_Ignorable_Code_Point**, as ranges, first and last
# included: the property Unicode gives the characters a renderer shows as
# nothing when it does not support them (DerivedCoreProperties.txt). Read
# for panel 188 from Unicode 15.0.0, as the Linux arm64 image's perl 5.40.1
# carries it (this Mac's perl, at 13.0.0, lacks U+180F): 17 ranges, 4,174 code
# points, every Bidi_Control code point among them. `UNSEEN` is the wider list
# for NAMING a character; this one is the property a group head's name is
# refused by (`head_names`), and a renderer's own reason, not this compiler's.
constant DEFAULT_IGNORABLE: [i64]
    [
        173
        173
        847
        847
        1564
        1564
        4447
        4448
        6068
        6069
        6155
        6159
        8203
        8207
        8234
        8238
        8288
        8303
        12644
        12644
        65024
        65039
        65279
        65279
        65440
        65440
        65520
        65528
        113824
        113827
        119155
        119162
        917504
        921599
    ]

# Named once a call, as `unseen`'s table is (defect 282).
function default_ignorable(code: i64) -> bool
    ranges = DEFAULT_IGNORABLE
    at: i64 @ 0

    while at + 1 < ranges.len()
        if code >= ranges[at] && code <= ranges[at + 1]
            return true
        at @ at + 2

    return false

## Tests

test "a visible ASCII character is itself, as the message always showed it"
    assert named(";") == "`;`"
    assert named("&") == "`&`"

test "a character above ASCII is itself and its code, since some cannot be seen"
    assert named("€") == "`€` (U+20AC)"
    assert named("é") == "`é` (U+00E9)"
    assert named("😀") == "`😀` (U+1F600)"

test "a character a terminal shows as nothing, or that reorders the line, is its code alone"
    assert unseen(8203)
    assert unseen(8238)
    assert unseen(65279)
    assert unseen(160)
    assert unseen(917505)
    assert !unseen(8364)
    assert !unseen(233)
    assert !unseen(8191)
    assert !unseen(8208)
    assert UNSEEN.len() % 2 == 0

# One character from its UTF-8 bytes, since the language writes no character
# by its code (spec § 2 Literals).
function of(bytes: [u8]) -> str
    return bytes.validated_bytes().must()

test "a control character is written by its code, a line end and a tab are kept, and a text holding none is itself (defect 244)"
    esc = of([27])
    assert visible("x = 1 " + esc + "[31mred") == "x = 1 <U+001B>[31mred"
    assert visible("a\rb") == "a<U+000D>b"
    assert visible("del" + of([127])) == "del<U+007F>"
    assert visible("c1 " + of([194, 155]) + "31m") == "c1 <U+009B>31m"
    assert visible("bell" + of([7])) == "bell<U+0007>"
    assert visible("two\nlines\tand a tab") == "two\nlines\tand a tab"
    nbsp = of([194, 160])
    assert visible("café, € and " + nbsp) == "café, € and " + nbsp
    assert width(esc) == 8
    assert width("\t") == 1
    assert width("é") == 1
    assert !holds_control("plain")
    assert holds_control(of([194, 133]))
    assert !holds_control(nbsp)

test "the code is read from every length of UTF-8"
    assert code_point("A") == 65
    assert code_point("é") == 233
    assert code_point("€") == 8364
    assert code_point("😀") == 128512
    assert u_plus(1) == "U+0001"
    assert u_plus(127) == "U+007F"
    assert u_plus(128512) == "U+1F600"

test "Unicode's default-ignorable code points, Bidi_Control's twelve among them, and not a visible space (panel 188)"
    assert DEFAULT_IGNORABLE.len() == 34
    assert default_ignorable(173)
    assert default_ignorable(8203)
    assert default_ignorable(65279)
    assert default_ignorable(6159)
    assert default_ignorable(921599)

    for bidi in [1564, 8206, 8207, 8234, 8235, 8236, 8237, 8238, 8294, 8295, 8296, 8297]
        assert default_ignorable(bidi)

    assert !default_ignorable(160)
    assert !default_ignorable(8232)
    assert !default_ignorable(8233)
    assert !default_ignorable(8364)
    assert !default_ignorable(921600)
