# The type grammar (design.md §4.3 the type table, §4.6 `T?`, §4.13 function
# types).
# Port of archive/bootstrap-rs/heroes/src/syntax/types.rs — **the port's first real grammar**:
# everything before it was a table, a record or a cursor, and this is the first
# file that consumes tokens and produces tree nodes.
#
# Six shapes and no ambiguity, because each one is decided by its first token: a
# name, `[`, `{`, or `(`. The last is the interesting one — `()` is "no value"
# and `(function(A) -> B)` is a function type, so one lookahead separates them.
#
# Only `?` is postfix, and it is applied exactly once: `T??` is the level
# ambiguity §4.6 refuses to have in the language, so the parser refuses it in
# the surface.
#
# Port note: the Rust file takes `&mut Cursor, &mut Ast, &Source`. Here that is
# three `@`/plain parameters, and the call sites say so — `parse_type(@c, @a,
# text)` announces on the line that both the cursor and the tree will change.
# The source is a `str` rather than a `Source` for the reason cursor.hero gives:
# the parser needs the text and not the file table, and deferring the `Source`
# record keeps the port honest about what it has actually ported.

use token
use ast
use diag
use cursor
use data_errors
use parse/line_end
use parse/fixed_length
use parse/swap_reading

## The entry point

# Read one type. Always returns a node index: on failure it is `.error`, so the
# tree keeps its shape and the errors after this one still get found.
function parse_type(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    start = cursor.current_span(c)
    inner: i64 @ prefix(@c, @a, text)

    # **`i32[4]` — the bracket AFTER the type, which is what tells it from
    # `[i32]`** (panel 062). `[T]`'s bracket opens the type; this one follows a
    # complete one, so no token has two meanings and the parser needs no
    # lookahead.
    while cursor.at(c, .lbracket)
        open = cursor.bump(@c).span
        length = fixed_length.read(@c, text, open)
        inner @ ast.push_type(
            @a.types,
            ast.TypeNode(kind: .fixed(element: inner, length: length), span: token.Span(start: start.start, end: cursor.previous_significant_span(c).end))
        )

    if !cursor.at(c, .question)
        return inner
    question = cursor.bump(@c).span

    while cursor.at(c, .question)
        extra = cursor.bump(@c).span
        cursor.error(
            @c,
            code: "nested_fallible",
            message: "a fallible type cannot be fallible twice — `T?` already carries the error case (§4.6)",
            span: extra
        )

    return ast.push_type(
        @a.types,
        ast.TypeNode(kind: .fallible(inner: inner), span: token.Span(start: start.start, end: question.end))
    )

## The six shapes, each decided by its first token

# `int` reads as the named type its certain swap writes (defect 133).
function prefix(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    k = cursor.current_kind(c)

    if k == .ident || swap_reading.reads_as_name(c, text)
        return named(@c, @a, text)

    if k == .lbracket
        return array_type(@c, @a, text)

    if k == .lbrace
        return map_type(@c, @a, text)

    if k == .lparen
        return unit_or_function(@c, @a, text)

    if swap_reading.reads_as_function(c, text) && cursor.peek(c, 1) == .lparen
        return bare_function(@c, @a, text)

    if !cursor.at_reported_error(c)
        cursor.error(
            @c,
            code: "expected_type",
            message: "expected a type, found " + cursor.found(c, text) + " — a type is `i64`, `f64`, `bool`, `str`, `[T]`, `{K: V}`, `T?`, `()`, or the name of a `record` or `variant`",
            span: cursor.current_span(c)
        )

    # Not consumed: the caller's recovery decides where the line ends.
    return ast.push_type(@a.types, ast.TypeNode(kind: .error, span: cursor.current_span(c)))

# A name, and `geom.Point` — a type from another module. The node keeps one span
# covering both halves and the resolver splits it: a module name and a type name
# are both plain identifiers, so the dot between them is the only one there can
# be, and a second node kind would buy nothing but a match arm in every pass.
function named(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    s = cursor.bump(@c).span

    if cursor.at(c, .dot)
        _ = cursor.bump(@c)

        if cursor.at(c, .ident)
            name = cursor.bump(@c).span
            return ast.push_type(@a.types, ast.TypeNode(kind: .named, span: token.Span(start: s.start, end: name.end)))
        cursor.error(
            @c,
            code: "expected_qualified_type",
            message: "expected a type after `" + cursor.slice_of(text, s) + ".`, — a qualified type is `module.Type`, as in `geom.Point`",
            span: cursor.current_span(c)
        )
    return ast.push_type(@a.types, ast.TypeNode(kind: .named, span: s))

# `[T]` — the dynamic array, and Heroes' only indirection (§4.10).
function array_type(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    open = cursor.bump(@c).span
    element = parse_type(@c, @a, text)
    cursor.skip_terminators(@c)
    close = cursor.current_span(c)
    _ = line_end.expect_closer(
        @c,
        text: text,
        holds: .one_type,
        kind: .rbracket,
        code: "expected_array_close",
        what: "`]` to close the array type"
    )
    return ast.push_type(
        @a.types,
        ast.TypeNode(kind: .array_of(element: element), span: token.Span(start: open.start, end: close.end))
    )

# `{K: V}` — the map. Access returns `V?`, always (§4.9).
function map_type(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    open = cursor.bump(@c).span
    key = parse_type(@c, @a, text)
    _ = line_end.expect_after(
        @c,
        text: text,
        kind: .colon,
        code: "expected_map_colon",
        what: "`:` between the map's key and value types"
    )
    value = parse_type(@c, @a, text)
    cursor.skip_terminators(@c)
    close = cursor.current_span(c)
    _ = line_end.expect_closer(
        @c,
        text: text,
        holds: .one_type,
        kind: .rbrace,
        code: "expected_map_close",
        what: "`}` to close the map type"
    )
    return ast.push_type(
        @a.types,
        ast.TypeNode(kind: .map_of(key: key, value: value), span: token.Span(start: open.start, end: close.end))
    )

# `()` or `(function(A, B) -> C)`.
#
# The marker is the same word that declares a function — one word, one meaning,
# everywhere (panel 013). The parentheses are mandatory because declarations
# dropped theirs: `f: function A -> B -> [B]` would be ambiguous (§4.13).
function unit_or_function(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    open = cursor.bump(@c).span

    if cursor.at(c, .rparen)
        close = cursor.bump(@c).span
        return ast.push_type(@a.types, ast.TypeNode(kind: .unit, span: token.Span(start: open.start, end: close.end)))

    if !swap_reading.eat_as(@c, text, .kw_function) && !cursor.expect(@c, text: text, kind: .kw_function, code: "expected_function_type", what: "`function` — in a type, `(` opens either `()` or a function type, `(function(A) -> B)`")
        # This `(` was consumed here, so its `)` is this function's to find:
        # leaving it for the caller made a signature containing one bad type
        # report the mistake three times.
        cursor.recover_past_closer(@c, opener: .lparen, closer: .rparen)
        return ast.push_type(@a.types, ast.TypeNode(kind: .error, span: open))
    parts = function_parts(@c, @a, text)
    cursor.skip_terminators(@c)
    close = cursor.current_span(c)
    _ = line_end.expect_closer(
        @c,
        text: text,
        holds: .one_type,
        kind: .rparen,
        code: "expected_function_type_close",
        what: "`)` to close the function type"
    )
    return ast.push_type(
        @a.types,
        ast.TypeNode(kind: .function_type(params: parts.params, labels: parts.labels, result: parts.result), span: token.Span(start: open.start, end: close.end))
    )

# What follows a function type's `function`: its parameters, `->` and its
# result, shared by the parenthesised type and the bare one.
record FunctionParts
    params: [i64]
    labels: [token.Span]
    result: i64

function function_parts(@c: cursor.Cursor, @a: ast.Ast, text: str) -> FunctionParts
    labels: [token.Span] @ []
    params = function_params(@c, @a, text, @labels)
    _ = line_end.expect_after(
        @c,
        text: text,
        kind: .arrow,
        code: "expected_function_type_arrow",
        what: "`->` and the result type — a function type always states what it returns, `()` when nothing"
    )
    return FunctionParts(params: params, labels: labels, result: parse_type(@c, @a, text))

# `function(i64) -> i64` where a type goes, its parentheses left out: read
# as the type it means, so the signature goes on to its body (defect 133's
# second round), and refused once, over the whole type, with the parentheses
# as its certain fix. `fn(i64) -> i64` is read the same way and says nothing
# more: the lexer's `reserved_word` names the word and the parentheses both,
# and a second message at one token would be the first one's debris.
function bare_function(@c: cursor.Cursor, @a: ast.Ast, text: str) -> i64
    start = cursor.current_span(c)
    swapped = cursor.at(c, .error)
    _ = cursor.bump(@c)
    parts = function_parts(@c, @a, text)
    span = token.Span(start: start.start, end: cursor.previous_significant_span(c).end)

    if !swapped
        written = cursor.slice_of(text, span)
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "expected_type",
            message: "expected a type, found `function` without its parentheses — a function type is written in them, `(function(i64) -> i64)`",
            span: span
        )
        d.fixes @ d.fixes.push(
            diag.Fix(title: "write the parentheses", replacement: "(" + written + ")", span: span, certainty: .certain)
        )
        c.diagnostics @ c.diagnostics.push(d)
    return ast.push_type(
        @a.types,
        ast.TypeNode(kind: .function_type(params: parts.params, labels: parts.labels, result: parts.result), span: span)
    )

# The parameter types of a function type, and since defect 026 their NAMES:
# `(i64, i64)`, `(from: str, to: str)`, `(ptr, n: u64, size: u64)`, or `()` for
# a function of no arguments. A name is written exactly where the position
# shares its type with another, so a call made through a value of the type is
# named the way §4.9 names a declaration's — and at a position nothing can be
# confused with, no name is written at all. WHICH positions those are is a
# question about lowered types, so this file reads what was written and judges
# none of it; `check/type_labels.hero` owns both halves of the rule.
#
# `x: i64` arrives as a TYPE followed by a colon, since a bare name is a legal
# type — so the name is recognised by what follows it rather than by a
# lookahead, and a name that is not a plain name is refused where it stands.
function function_params(@c: cursor.Cursor, @a: ast.Ast, text: str, @labels: [token.Span]) -> [i64]
    params: [i64] @ []

    if !cursor.expect(@c, text: text, kind: .lparen, code: "expected_function_type_params", what: "`(` and the parameter types")
        return params

    if cursor.eat(@c, .rparen)
        return params
    reading: bool @ true

    while reading
        ty = parse_type(@c, @a, text)

        if cursor.at(c, .colon)
            _ = cursor.bump(@c)
            labels @ labels.push(named_parameter(@c, a, ty))
            params @ params.push(parse_type(@c, @a, text))
        else

            # One entry per position either way, so a reader of the node never
            # has to ask which name belongs to which parameter.
            labels @ labels.push(token.Span(start: 0, end: 0))
            params @ params.push(ty)
        cursor.skip_terminators(@c)

        if !cursor.eat(@c, .comma)
            reading @ false

    if !line_end.expect_closer(@c, text: text, holds: .type_list, kind: .rparen, code: "expected_function_type_params_close", what: "`)`, or `,` and another parameter type")
        cursor.recover_past_closer(@c, opener: .lparen, closer: .rparen)
    return params

# The name in `(function(x: i64) -> i64)`, which the loop above read as a type
# because a bare name is one. Anything else there is not a name at all, and the
# span is returned either way so the run keeps its positions.
function named_parameter(@c: cursor.Cursor, a: ast.Ast, name: i64) -> token.Span
    span = a.types[name].span

    match a.types[name].kind
        .named => return span
        .unit | .array_of | .fixed | .map_of | .fallible | .function_type | .error =>
            c.diagnostics @ c.diagnostics.push(data_errors.parameter_name_not_a_name(span))
            return span

    return span

## Tests — the parser reading real token streams

# A tiny helper: the token stream for a type, built by hand the way the lexer
# would have. Spans are made to match `text` so that `found` and the slices in
# the messages read as they would in a real file.
function tok(kind: token.TokenKind, start: i64, end: i64) -> token.Token
    return token.Token(kind: kind, span: token.Span(start: start, end: end))

test "a bare name is one node and the span is the name"
    stream: [token.Token] = [tok(.ident, start: 0, end: 3), tok(.eof, start: 3, end: 3)]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "i64")
    assert a.types[at].kind == .named
    assert a.types[at].span == token.Span(start: 0, end: 3)
    assert c.diagnostics.len() == 0

test "the six shapes are told apart by their first token"
    # [i64]
    arr: [token.Token] = [
        tok(.lbracket, start: 0, end: 1)
        tok(.ident, start: 1, end: 4)
        tok(.rbracket, start: 4, end: 5)
        tok(.eof, start: 5, end: 5)
    ]
    c1: cursor.Cursor @ cursor.new_cursor(arr)
    a1: ast.Ast @ ast.new_ast()
    at1 = parse_type(@c1, @a1, "[i64]")

    match a1.types[at1].kind
        .array_of e                                                             => assert a1.types[e.element].kind == .named
        .named | .unit | .fixed | .map_of | .fallible | .function_type | .error => assert false

    assert c1.diagnostics.len() == 0

    # {str: i64}
    m: [token.Token] = [
        tok(.lbrace, start: 0, end: 1)
        tok(.ident, start: 1, end: 4)
        tok(.colon, start: 4, end: 5)
        tok(.ident, start: 6, end: 9)
        tok(.rbrace, start: 9, end: 10)
        tok(.eof, start: 10, end: 10)
    ]
    c2: cursor.Cursor @ cursor.new_cursor(m)
    a2: ast.Ast @ ast.new_ast()
    at2 = parse_type(@c2, @a2, "{str: i64}")

    match a2.types[at2].kind
        .map_of _                                                                 => assert true
        .named | .unit | .array_of | .fixed | .fallible | .function_type | .error => assert false

    assert c2.diagnostics.len() == 0

    # ()
    u: [token.Token] = [tok(.lparen, start: 0, end: 1), tok(.rparen, start: 1, end: 2), tok(.eof, start: 2, end: 2)]
    c3: cursor.Cursor @ cursor.new_cursor(u)
    a3: ast.Ast @ ast.new_ast()
    at3 = parse_type(@c3, @a3, "()")
    assert a3.types[at3].kind == .unit

test "T? is applied once, and T?? is refused where it is written"
    once: [token.Token] = [tok(.ident, start: 0, end: 3), tok(.question, start: 3, end: 4), tok(.eof, start: 4, end: 4)]
    c: cursor.Cursor @ cursor.new_cursor(once)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "i64?")

    match a.types[at].kind
        .fallible f                                                             => assert a.types[f.inner].kind == .named
        .named | .unit | .array_of | .fixed | .map_of | .function_type | .error => assert false

    assert c.diagnostics.len() == 0
    twice: [token.Token] = [
        tok(.ident, start: 0, end: 3)
        tok(.question, start: 3, end: 4)
        tok(.question, start: 4, end: 5)
        tok(.eof, start: 5, end: 5)
    ]
    d: cursor.Cursor @ cursor.new_cursor(twice)
    b: ast.Ast @ ast.new_ast()
    _ = parse_type(@d, @b, "i64??")
    assert d.diagnostics.len() == 1
    assert d.diagnostics[0].code == "nested_fallible"

test "a fixed array reads its length, and zero is refused"
    four: [token.Token] = [
        tok(.ident, start: 0, end: 3)
        tok(.lbracket, start: 3, end: 4)
        tok(.int_lit, start: 4, end: 5)
        tok(.rbracket, start: 5, end: 6)
        tok(.eof, start: 6, end: 6)
    ]
    c: cursor.Cursor @ cursor.new_cursor(four)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "i32[4]")

    match a.types[at].kind
        .fixed f                                                                   => assert f.length == 4
        .named | .unit | .array_of | .map_of | .fallible | .function_type | .error => assert false

    assert c.diagnostics.len() == 0
    zero: [token.Token] = [
        tok(.ident, start: 0, end: 3)
        tok(.lbracket, start: 3, end: 4)
        tok(.int_lit, start: 4, end: 5)
        tok(.rbracket, start: 5, end: 6)
        tok(.eof, start: 6, end: 6)
    ]
    d: cursor.Cursor @ cursor.new_cursor(zero)
    b: ast.Ast @ ast.new_ast()
    _ = parse_type(@d, @b, "i32[0]")
    assert d.diagnostics.len() == 1
    assert d.diagnostics[0].code == "empty_fixed_array"

test "a function type states what it returns"
    # (function(i64) -> i64)
    stream: [token.Token] = [
        tok(.lparen, start: 0, end: 1)
        tok(.kw_function, start: 1, end: 9)
        tok(.lparen, start: 9, end: 10)
        tok(.ident, start: 10, end: 13)
        tok(.rparen, start: 13, end: 14)
        tok(.arrow, start: 15, end: 17)
        tok(.ident, start: 18, end: 21)
        tok(.rparen, start: 21, end: 22)
        tok(.eof, start: 22, end: 22)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "(function(i64) -> i64)")

    match a.types[at].kind
        .function_type f =>
            assert f.params.len() == 1
            assert a.types[f.result].kind == .named
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

    assert c.diagnostics.len() == 0

# Defect 026 moved this rule. The parser KEEPS the name now — whether one is
# owed is a question about the lowered types, which `check/type_labels.hero`
# asks — and the parser judges only that it is a name and that the run is whole.
test "a parameter name is kept, with its position, and nothing is reported"
    # (function(x: i64) -> i64)
    stream: [token.Token] = [
        tok(.lparen, start: 0, end: 1)
        tok(.kw_function, start: 1, end: 9)
        tok(.lparen, start: 9, end: 10)
        tok(.ident, start: 10, end: 11)
        tok(.colon, start: 11, end: 12)
        tok(.ident, start: 13, end: 16)
        tok(.rparen, start: 16, end: 17)
        tok(.arrow, start: 18, end: 20)
        tok(.ident, start: 21, end: 24)
        tok(.rparen, start: 24, end: 25)
        tok(.eof, start: 25, end: 25)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "(function(x: i64) -> i64)")
    assert c.diagnostics.len() == 0

    match a.types[at].kind
        .function_type f =>
            assert f.params.len() == 1
            assert f.labels.len() == 1
            assert f.labels[0].start == 10
            assert f.labels[0].end == 11
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

test "a run may name some positions and not others, and the parser judges none of it"
    # (function(a: i64, i64) -> i64) — legal since panel 129: a function type
    # names the positions that can be confused and no others, so WHICH ones is a
    # question about lowered types and `check/type_labels.hero` owns it.
    stream: [token.Token] = [
        tok(.lparen, start: 0, end: 1)
        tok(.kw_function, start: 1, end: 9)
        tok(.lparen, start: 9, end: 10)
        tok(.ident, start: 10, end: 11)
        tok(.colon, start: 11, end: 12)
        tok(.ident, start: 13, end: 16)
        tok(.comma, start: 16, end: 17)
        tok(.ident, start: 18, end: 21)
        tok(.rparen, start: 21, end: 22)
        tok(.arrow, start: 23, end: 25)
        tok(.ident, start: 26, end: 29)
        tok(.rparen, start: 29, end: 30)
        tok(.eof, start: 30, end: 30)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "(function(a: i64, i64) -> i64)")
    assert c.diagnostics.len() == 0

    match a.types[at].kind
        .function_type f =>

            # One label entry per parameter either way, so a reader of the node
            # never has to ask which name belongs to which position.
            assert f.params.len() == 2
            assert f.labels.len() == 2
            assert f.labels[0].start == 10
            assert f.labels[1].start == f.labels[1].end
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

test "a type that cannot be read is a node, so the errors after it are found"
    stream: [token.Token] = [tok(.plus, start: 0, end: 1), tok(.eof, start: 1, end: 1)]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "+")
    assert a.types[at].kind == .error
    assert c.diagnostics[0].code == "expected_type"

    # Not consumed: the caller's recovery decides where the line ends.
    assert cursor.current_kind(c) == .plus

# Defect 133: a foreign word whose certain swap the type grammar can read is
# read as written by the swap, and consumed, so the signature goes on. The
# texts put the type where a type goes, after `x: `, since a swap is certain
# only where the word it writes is right (defect 133's second round).
test "a foreign word in a type reads as its certain swap and is consumed"
    # x: (fn(i64) -> i64), the lexer having refused `fn`
    stream: [token.Token] = [
        tok(.lparen, start: 3, end: 4)
        tok(.error, start: 4, end: 6)
        tok(.lparen, start: 6, end: 7)
        tok(.ident, start: 7, end: 10)
        tok(.rparen, start: 10, end: 11)
        tok(.arrow, start: 12, end: 14)
        tok(.ident, start: 15, end: 18)
        tok(.rparen, start: 18, end: 19)
        tok(.eof, start: 19, end: 19)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    at = parse_type(@c, @a, "x: (fn(i64) -> i64)")

    match a.types[at].kind
        .function_type f                                                   => assert f.params.len() == 1
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

    assert c.diagnostics.len() == 0
    assert cursor.at(c, .eof)

    # `int` reads as the NAMED type the swap writes, over the span written.
    named_stream: [token.Token] = [
        tok(.error, start: 3, end: 6)
        tok(.terminator, start: 6, end: 6)
        tok(.eof, start: 6, end: 6)
    ]
    n: cursor.Cursor @ cursor.new_cursor(named_stream)
    na: ast.Ast @ ast.new_ast()
    nat = parse_type(@n, @na, "x: int")
    assert na.types[nat].kind == .named
    assert na.types[nat].span == token.Span(start: 3, end: 6)
    assert n.diagnostics.len() == 0
    assert cursor.at(n, .terminator)

    # A word with no certain swap is left where it stands, and said nothing of:
    # the lexer spoke, and the caller's recovery decides where the line ends.
    guided: [token.Token] = [tok(.error, start: 3, end: 7), tok(.eof, start: 7, end: 7)]
    g: cursor.Cursor @ cursor.new_cursor(guided)
    ga: ast.Ast @ ast.new_ast()
    gat = parse_type(@g, @ga, "x: None")
    assert ga.types[gat].kind == .error
    assert g.diagnostics.len() == 0
    assert cursor.at(g, .error)

# Defect 133's second round: a function type written without its parentheses
# is the type it means, refused once over the whole type.
test "a bare function type is read, and refused once with its parentheses as the fix"
    # x: function(i64) -> i64
    written: [token.Token] = [
        tok(.kw_function, start: 3, end: 11)
        tok(.lparen, start: 11, end: 12)
        tok(.ident, start: 12, end: 15)
        tok(.rparen, start: 15, end: 16)
        tok(.arrow, start: 17, end: 19)
        tok(.ident, start: 20, end: 23)
        tok(.eof, start: 23, end: 23)
    ]
    w: cursor.Cursor @ cursor.new_cursor(written)
    wa: ast.Ast @ ast.new_ast()
    wat = parse_type(@w, @wa, "x: function(i64) -> i64")

    match wa.types[wat].kind
        .function_type f                                                   => assert f.params.len() == 1
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

    assert w.diagnostics.len() == 1
    assert w.diagnostics[0].code == "expected_type"
    assert w.diagnostics[0].fixes[0].replacement == "(function(i64) -> i64)"
    assert w.diagnostics[0].fixes[0].certainty == .certain

    # x: fn(i64) -> i64: the lexer's `reserved_word` says it all.
    swapped: [token.Token] = [
        tok(.error, start: 3, end: 5)
        tok(.lparen, start: 5, end: 6)
        tok(.ident, start: 6, end: 9)
        tok(.rparen, start: 9, end: 10)
        tok(.arrow, start: 11, end: 13)
        tok(.ident, start: 14, end: 17)
        tok(.eof, start: 17, end: 17)
    ]
    s: cursor.Cursor @ cursor.new_cursor(swapped)
    sa: ast.Ast @ ast.new_ast()
    sat = parse_type(@s, @sa, "x: fn(i64) -> i64")

    match sa.types[sat].kind
        .function_type f                                                   => assert f.params.len() == 1
        .named | .unit | .array_of | .fixed | .map_of | .fallible | .error => assert false

    assert s.diagnostics.len() == 0
    assert cursor.at(s, .eof)
