# An arm broken before its `=>` (design.md §4.7, §4.17; defect 131's class,
# 2026-09-29).
#
# `0` over `=> 5` is one arm the author broke before its arrow. A line that
# begins with `=>` is not one the lexer joins to the line above (panel 181's
# list names what cannot begin a line, and widening it is a language change),
# so the parser meets the arm's line end where the `=>` is owed and says so,
# `expected_arm_arrow`, found end of line, and those words are true there.
# It then read the line below as an arm of its own and refused it too,
# `expected_pattern` at the `=>`: one mistake, two messages, and the arm's
# value never read.
#
# Now the arm goes on at the `=>` below, on the next line or at the head of a
# block the lexer opened for it, and is read as it would stand written on one
# line: its value says its own mistakes, the next line is the next arm, and
# whatever else a block opened for the `=>` holds stands below that one-line
# arm, deeper, the orphan `grammar_expr.arms_of` names below a whole arm.
# Three shapes beside it go the same way (lane X3, 2026-09-29):
#
# - junk before the line end, `0 7` over `=> 5`: the junk is what the
#   `expected_arm_arrow` names, and the arm goes on at the `=>` below;
# - the `=>` line past the arms' own dedent, at the `match`'s margin: the
#   arms end with that arm, whose line closed their block
#   (`crossed_its_dedent`), so no line of the block around them is read as
#   one; only one dedent, and only where the arms have a block of their own;
# - a `=>` alone at its line's end, which the lexer joins to the line below
#   and refuses there, `continuation_outside_brackets`: the break before the
#   `=>` and the break after it are one arm's, and the missing `=>` is held
#   back against the lexer's refusal (`diag.Held`), said where it is not,
#   in the control arm, `check --permissive`, which drops it.
#
# | entry | called by |
# |---|---|
# | `arrow`, `close_its_block`, `crossed_its_dedent` | `grammar_expr.arm`, `grammar_expr.arms_of` |
# | `arrow_below` | `parse/margin_arms` |
# | `told_above` | `grammar_expr.statement_kind` |

use token
use diag
use cursor
use text_lines
use lexer

# The arm's `=>`, owed at the cursor: taken where it stands; named missing
# otherwise, and the arm goes on at a `=>` the line below begins with, past
# what stands before the line's end (`own_block`: past the arms' own dedent
# too). Whether the arm goes on is the answer.
function arrow(@c: cursor.Cursor, text: str, own_block: bool) -> bool
    if cursor.eat(@c, .fat_arrow)
        return true
    at = arrow_below(c, end: line_end(c), past_a_dedent: own_block)

    if !cursor.at_reported_error(c)
        d = diag.new_diagnostic(
            code: "expected_arm_arrow",
            message: "expected `=>` and the arm's value, found " + cursor.found(c, text),
            span: cursor.current_span(c)
        )
        seam = joined_after(c, text, at: at)

        if !seam.is_err()
            cursor.push_held(
                @c.held,
                diag.Held(at: c.diagnostics.len(), cause: seam.must(), diagnostic: d, apart: false)
            )
        else
            cursor.push_diagnostic(@c.diagnostics, d)

    while at >= 0 && c.pos <= at
        _ = cursor.bump(@c)

    return at >= 0

# The index of the line end at the cursor's line's end, outside brackets, or
# -1 where a block's edge or the stream's end comes first.
function line_end(c: cursor.Cursor) -> i64
    depth: i64 @ 0
    i: i64 @ c.pos

    while c.tokens[i].kind != .eof && c.tokens[i].kind != .indent && c.tokens[i].kind != .dedent
        k = c.tokens[i].kind

        if k == .terminator && depth == 0
            return i

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth - 1
        i @ i + 1

    return -1

# The index of the `=>` the line below the line end at token `end` begins
# with, past comment lines and an indent, or one dedent where
# `past_a_dedent`; or -1. `parse/margin_arms` asks it too: a line broken
# before its arrow is an arm.
function arrow_below(c: cursor.Cursor, end: i64, past_a_dedent: bool) -> i64
    if end < 0 || c.tokens[end].kind != .terminator
        return -1
    i: i64 @ end

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    if c.tokens[i].kind == .indent || past_a_dedent && c.tokens[i].kind == .dedent
        i @ i + 1

    while c.tokens[i].kind == .comment
        i @ i + 1

    if c.tokens[i].kind == .fat_arrow
        return i
    return -1

# Where the `=>` at token `at` ends its line of the text and the lexer joined
# the line below to it, with no line end between: the span from the `=>` to
# the joined token, where the lexer's refusal of the join stands.
function joined_after(c: cursor.Cursor, text: str, at: i64) -> token.Span?
    if at < 0
        return fail(code: "no_arrow", msg: "no `=>` below")
    next: i64 @ at + 1

    while c.tokens[next].kind == .comment
        next @ next + 1

    k = c.tokens[next].kind

    if k == .terminator || k == .indent || k == .dedent || k == .eof
        return fail(code: "ended", msg: "the `=>` line ends with a line end")

    if text_lines.newlines_between(text, from: c.tokens[at].span.end, to: c.tokens[next].span.start) == 0
        return fail(code: "same_line", msg: "the arm's value is on the `=>`'s line")
    return ok(token.Span(start: c.tokens[at].span.start, end: c.tokens[next].span.end))

# Whether the `=>` under the cursor begins a line below one whose end an arm
# was told `expected_arm_arrow` at, past more dedents than the arm may cross:
# that arm's arrow, its mistake told there, which the statement reader passes
# to read the arm's value for its own, where it told the line a second time
# (defect 195).
function told_above(c: cursor.Cursor) -> bool
    i: i64 @ c.pos - 1

    while i > 0 && (c.tokens[i].kind == .dedent || c.tokens[i].kind == .comment)
        i @ i - 1

    if !cursor.at(c, .fat_arrow) || c.tokens[i].kind != .terminator || c.tokens[i + 1].kind != .dedent
        return false

    for d in c.diagnostics
        if d.code == "expected_arm_arrow" && d.span.start == c.tokens[i].span.start
            return true

    return false

# Whether the arm begun at token `from` read its `=>` past a dedent: the
# arms' block ended before it, and the arms end with it.
function crossed_its_dedent(c: cursor.Cursor, from: i64) -> bool
    i: i64 @ from

    while i < c.pos && c.tokens[i].kind != .fat_arrow
        if c.tokens[i].kind == .dedent
            return true
        i @ i + 1

    return false

# After the value of the arm begun at token `from`, the block the lexer opened
# for its `=>`, if it opened one: closed at its dedent, and what else it holds
# named once and gone whole, as an orphan below a whole arm is.
function close_its_block(@c: cursor.Cursor, from: i64)
    if !opened_for_the_arrow(c, from)
        return

    if !cursor.at(c, .dedent) && !cursor.at(c, .eof) && !cursor.at_reported_error(c)
        cursor.error(
            @c,
            code: "unexpected_block",
            message: "this block is indented deeper than anything that opens one",
            span: cursor.current_span(c)
        )

    while !cursor.at(c, .dedent) && !cursor.at(c, .eof)
        if cursor.at(c, .indent)
            _ = cursor.balanced_block(@c)
        else
            _ = cursor.bump(@c)

    _ = cursor.eat(@c, .dedent)

# Whether an indent stands between the arm's first token and its `=>`: the
# lexer opened a block for the line the `=>` begins.
function opened_for_the_arrow(c: cursor.Cursor, from: i64) -> bool
    i: i64 @ from

    while i < c.pos && c.tokens[i].kind != .fat_arrow
        if c.tokens[i].kind == .indent
            return true
        i @ i + 1

    return false

## Tests

# The cursor past an arm's first token, in the lexer's own stream of `text`.
function past_the_pattern(text: str) -> cursor.Cursor
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
    _ = cursor.bump(@c)
    return c

test "an arm broken before its `=>` goes on at the `=>` below, and nowhere else"
    # Junk before the line end is what the report names; the arm goes on.
    for text in ["0\n=> 5\n", "0\n# a note\n=> 5\n", "0\n\n=> 5\n", "0\n    => 5\n", "0 7\n=> 5\n"]
        c: cursor.Cursor @ past_the_pattern(text)
        assert arrow(@c, text, own_block: false)
        assert c.diagnostics.len() == 1
        assert c.diagnostics[0].code == "expected_arm_arrow"
        assert cursor.at(c, .int_lit)

    # No `=>` below, and no line below at all.
    for text in ["0\n5\n", "0\n"]
        c: cursor.Cursor @ past_the_pattern(text)
        stood = c.pos
        assert !arrow(@c, text, own_block: false)
        assert c.pos == stood

test "a `=>` past the arms' dedent is taken where they have a block of their own"
    text = "match n\n    0\n=> 5\n"
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)

    while !cursor.at(c, .int_lit)
        _ = cursor.bump(@c)

    from = c.pos
    _ = cursor.bump(@c)
    arms: cursor.Cursor @ c
    assert arrow(@arms, text, own_block: true)
    assert crossed_its_dedent(arms, from: from)
    assert !arrow(@c, text, own_block: false)

test "a `=>` alone at its line's end, joined to the next, holds the missing one back"
    text = "0\n=>\n_ => 20\n"
    c: cursor.Cursor @ past_the_pattern(text)
    assert arrow(@c, text, own_block: false)
    assert c.diagnostics.len() == 0
    assert c.held.len() == 1
    assert c.held[0].diagnostic.code == "expected_arm_arrow"
