# A literal the lexer refused, which is still a literal (design.md §4.17;
# defect 130's class, lane Y's finding, 2026-09-29).
#
# The lexer refuses a number or a quoted literal by its spelling, `0X10`,
# `0b102`, `'ab'`, and hands the parser an `error` token for it, its report
# already made. The spelling is the literal's one mistake, and its place is
# a value's: where a line's end is owed after it, the end is still owed,
# since the line its certain fix writes is refused there, `x = 1 0X10` and
# `dark 0X10` after a case's name alike; and where an operand goes it is
# the operand, so an expression goes on past it, in brackets too. So the
# parser asks whether the token under the cursor is one, reads it as the
# literal it stands for, and names it as that literal.
#
# Moved out of `parse/statement_end.hero` on 2026-09-30 (lane recovery-b1),
# when a member's line came to ask the same question
# (`parse/member_lines.hero`), a module that one cannot reach without a
# cycle through `parse/headless.hero`; the expression reader's operand
# (`grammar_expr.primary`) asks it too since the same day. A leaf: it reads
# the cursor and the text.

use token
use cursor
use describe
use lexer
use literals

# Whether the cursor stands on a literal the lexer refused, a number or a
# quoted literal: an `error` token whose first byte is a digit or a quote.
function here(c: cursor.Cursor, text: str) -> bool
    if !cursor.at(c, .error)
        return false
    first = text[cursor.current_span(c).start]
    return first >= '0' && first <= '9' || first == '"' || first == '\''

# The kind of the token under the cursor as the grammar reads it: a refused
# literal whose end the lexer found (`closed`) as the literal it stands for,
# and any other token as itself. The expression reader builds its operand
# from this, so the expression goes on past a refused literal as past any
# value.
function read_as(c: cursor.Cursor, text: str) -> token.TokenKind
    if !here(c, text) || !closed(c, text)
        return cursor.current_kind(c)
    return literal_kind(text[cursor.current_span(c).start])

# Whether the refused literal under the cursor ends where its own spelling
# ends it: a number always, a quoted literal where its own quote closes it,
# unescaped. One the lexer found never closed, `"abc + )` or `'a + )`, ran to
# its line's end and took any closer on the line with it, so no operand of
# its line is left past it, and read as a value it had a call look for the
# `)` it holds (lane recovery-b1, 2026-09-30).
function closed(c: cursor.Cursor, text: str) -> bool
    s = cursor.current_span(c)
    quote = text[s.start]

    if quote != '"' && quote != '\''
        return true

    # The classic `'\'`, its backslash before the quote that should close it,
    # ends there, the rest of its line lexed, and is the character its certain
    # fix writes, `'\\'` (`literals.unterminated_char`, lane recovery-b2).
    if quote == '\'' && s.end - s.start == 3 && literals.classic_backslash(text, at: s.start)
        return true

    if s.end - s.start < 2 || text[s.end - 1] != quote
        return false
    slashes: i64 @= 0
    i: i64 @= s.end - 2

    while i > s.start && text[i] == '\\'
        slashes @ slashes + 1
        i @ i - 1

    return slashes % 2 == 0

# The literal a refused token stands for, by its first byte.
function literal_kind(first: u8) -> token.TokenKind
    if first == '"'
        return .str_lit

    if first == '\''
        return .char_lit
    return .int_lit

# The token under the cursor as "expected X, found Y" names it: a refused
# literal as the literal it is, in the words the line its certain fix writes
# is told in, where the lexer's word for it is an unreadable token.
function found(c: cursor.Cursor, text: str) -> str
    if !here(c, text)
        return cursor.found(c, text)
    return describe.describe(literal_kind(text[cursor.current_span(c).start])) + " (`" + cursor.slice_of(text, cursor.current_span(c)) + "`)"

## Tests

test "a refused literal is read as its literal where its own spelling ends it"
    # `0X10` and `'ab'` end where they are spelled, and so does the classic
    # `'\'` since lane recovery-b2 (U3), at its third byte, read as the `'\\'`
    # its certain fix writes; `"abc` and `'a` never closed, and took the rest
    # of their line with them.
    for text in ["0X10 + )", "'ab' + )", "'a\\\\' + )", "'\\' + )"]
        c = cursor.new_cursor(lexer.lex_one(text).tokens)
        assert here(c, text)
        assert read_as(c, text) != .error

    for text in ["\"abc + )", "'a + )"]
        c = cursor.new_cursor(lexer.lex_one(text).tokens)
        assert here(c, text)
        assert read_as(c, text) == .error

    # Named as the literal it is, where the lexer's word is an unreadable token.
    assert found(cursor.new_cursor(lexer.lex_one("0X10").tokens), "0X10") == "a number (`0X10`)"
