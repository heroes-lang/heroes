# Where a block's body begins, asked once for every head that opens one
# (design.md §4.17; defects 130 and 131, 2026-09-28).
#
# A HEAD is the line that opens a block: `if c`, `else if c`, `else`,
# `while c`, `for x in xs`, `match e`, an arm's `=>`, a declaration's
# signature. Its body begins at an indent on the line below. Every head used
# to ask that of the token under the cursor, and a head that had FAILED left
# the cursor on the token it could not read: `if n > )` over its body cost
# `expected_expression` and then `missing_body` at the same column, for a
# body that was there one level down, and the body, never parsed, hid every
# mistake inside it.
#
# What is owed now depends on what the head already said, and "said" means a
# refusal: a thesis rule is not one (`cursor.refused_since`).
#
# | the head | the rest of its line | an indented body | no body |
# |---|---|---|---|
# | refused nothing, and its line ends | none | parsed | named missing at the next line |
# | refused nothing, and its line goes on | named as junk, then dropped | parsed | the body named missing, found the junk |
# | refused something | dropped, as debris | parsed | named missing at the next line, unless the head crossed a line inside brackets or refused that very token |
# | any, over a line the lexer joined | as above | parsed | held back (`diag.Held`) |
# | any, its line ending with `{` or over a `{` alone | as above, up to the `{` | the `{` named missing, the braces parsed | — |
#
# **A body in braces is read as the body** (defect 131's class, 2026-09-29;
# `parse/brace_habit`): the `{` is the one report of the habit, in this
# table's words, and the drop stops at it, since the lexer puts no line end
# after it and dropping to one took the body's first line. A `match`'s arms
# are not read in braces: `missing_arms` says so (`Missing.braces`).
#
# A body whose margin holds a tab is read as the body too (`Body.tabbed`):
# the lexer refuses the margin and opens no block, so the line reaches the
# parser at the head's own level, and naming the body missing named the tab
# a second time. The missing body is held back against that refusal.
#
# **A line crossed silences an absent body**, because the head's own recovery
# can run past its line: `if (n > 0` over `y = 3 )` is a group the body's `)`
# closes, and the body's absence is then the recovery's doing, not the
# author's. The line is read in the text, since inside brackets a line break
# carries no line end token. **Not a line the lexer joined outside brackets**:
# `if` over `print(1 +)` failed on the joined line, and the `if` still has no
# body, which was never said (lane Y's finding, 2026-09-29); it is held back
# as over any join. **So does the head's own refusal at the same token**:
# `for` alone at a file's end, refused as found at the end of the block, is
# not refused there again as a `for` with no body.
#
# **A joined line holds back an absent body rather than naming it.** The
# lexer joins a line that cannot end over the deeper one below it
# (`continuation_outside_brackets`), so `if n >` over `print(1)` reaches the
# parser as `if n > print(1)`, and the body the author wrote IS the joined
# line: naming it missing names the first mistake a second time. It is held
# back and not dropped because the control arm, `check --permissive`, drops
# that refusal, a thesis rule, and reads the join as the program, which for it
# has no body; without the report the arm would pass a bodiless `if` on to
# the resolver. `parse` asks which refusal stands at the break and places
# the held diagnostic accordingly (`parse.ParseOutput.control`). The join is
# read off the head's own text, two of its tokens on two lines with no line
# end between them, never off a list of which lexer codes join. What the text
# says of a head's lines is `parse/head_lines`; and what a block that no head
# opens is told is `parse/orphans`.

use token
use diag
use cursor
use parse/swap_reading
use parse/head_lines
use parse/brace_habit
use parse/unclosed

# Where a head began: how many diagnostics the parser had said, and the
# token its first word stands on.
record Mark
    said: i64
    pos: i64

function mark(c: cursor.Cursor) -> Mark
    return Mark(said: c.diagnostics.len(), pos: c.pos)

# Whether the head refused something. Asked before the `:` habit is eaten,
# whose own report is not the head failing.
function refused(c: cursor.Cursor, head: Mark) -> bool
    return cursor.refused_since(c, head.said)

# How an absent body is named: its code, and the words around what was found;
# whose body it is and what it holds, for `junk`, which alone makes the
# sentence of them, so that no head of a program that compiles pays for it;
# and whether a body in braces is read as the body, which a block of
# statements is and a `match`'s arms are not, their reader being the block's.
record Missing
    code: str
    lead: str
    tail: str
    owner: str
    members: str
    braces: bool

function missing_body(owner: str) -> Missing
    return Missing(
        code: "missing_body",
        lead: owner + " needs an indented body — one level deeper, exactly 4 spaces (found ",
        tail: ")",
        owner: owner,
        members: "body goes",
        braces: true
    )

function missing_arms() -> Missing
    return Missing(
        code: "missing_match_arms",
        lead: "a `match` needs its arms indented one level below it, found ",
        tail: "",
        owner: "a `match`",
        members: "arms go",
        braces: false
    )

# What stands where a head's body begins.
variant Body
    # An indent: the block the lexer opened.
    indented
    # A line whose margin holds a tab. The lexer refuses the margin
    # (`tab_in_indentation`) and opens no block for it, so the line reaches
    # the parser at the head's own level; it is where the author wrote the
    # body, and it is read as the body (point 3 of defect 131's second round).
    tabbed
    # A `{` that opens the body in braces, the brace habit: the cursor stands
    # on it, and `close` is the index of the `}` that closes it.
    braced
        close: i64
    # Nothing that opens one.
    none

# What stands where the body begins after the head that began at `head`, the
# table above applied; the cursor stands on the body's first token, or on its
# indent, when the answer is not `.none`.
function body_follows(@c: cursor.Cursor, text: str, head: Mark, failed: bool, missing: Missing) -> Body
    crossed = head_lines.crossed_a_line(c, text, from: head.pos)
    brace: i64 @ -1

    if missing.braces
        brace @ brace_habit.ending(c, text)

    if brace >= 0
        return braced(@c, text, head: head, failed: failed, brace: brace, missing: missing)

    if failed
        cursor.drop_rest_of_line(@c, from: head.pos)
    cursor.skip_terminators(@c)
    found = opening_at(@c, text, missing)

    if found != .none
        return found

    # The head refused nothing and its line goes on over a body that is there
    # (`function f() )` over `x = 3`): what goes on is the one mistake, named
    # as the junk it is, and the body is read and never called absent, as
    # `record Point )` over its fields is (defect 131's class, 2026-09-29).
    goes_on = !failed && !cursor.at_fresh_line(c)

    if goes_on && body_below(c, text)
        junk(@c, text, missing: missing)
    else
        # A line crossed, or lines inside a bracket the head left open.
        silent = failed && crossed && !head_lines.joined_outside_brackets(c, text, from: head.pos)
        absent(
            @c,
            text,
            head: head,
            silent: silent || unclosed.swallows_the_body(c, text, from: head.pos),
            missing: missing
        )

    if !goes_on
        return .none
    cursor.drop_rest_of_line(@c, from: head.pos)
    cursor.skip_terminators(@c)
    return opening_at(@c, text, missing)

# A body in braces, whose `{` is at `brace` (`parse/brace_habit`): what stands
# before the `{` on the head's line is dropped, and named as the head's junk
# where the head refused nothing, as over an indented body; the `{` is named
# as the missing body it stands for, unless the head refused that very token
# (`for {`). The cursor is left on the `{`.
function braced(@c: cursor.Cursor, text: str, head: Mark, failed: bool, brace: i64, missing: Missing) -> Body
    if !failed && !is_line_end(cursor.current_kind(c)) && c.pos < brace
        junk(@c, text, missing: missing)

    while c.pos < brace
        _ = cursor.bump(@c)

    if !refused_here(c, head)
        cursor.push_diagnostic(@c.diagnostics, missing_here(c, text, missing))
    return .braced(close: brace_habit.closer(c, open: brace))

# What goes on past a head over its body, named, unless the lexer spoke there.
function junk(@c: cursor.Cursor, text: str, missing: Missing)
    if swap_reading.at_reported_error(c, text)
        return
    cursor.push_diagnostic(
        @c.diagnostics,
        diag.new_diagnostic(code: "expected_end_of_line", message: "expected the end of the line, found " + swap_reading.found(c, text) + " — " + missing.owner + "'s " + missing.members + " on the lines below its head, one level deeper", span: cursor.current_span(c))
    )

# Whether a body stands below the line under the cursor: where dropping the
# rest of that line leaves the cursor, an indent or a line whose margin holds
# a tab, read ahead in the tokens without moving.
function body_below(c: cursor.Cursor, text: str) -> bool
    i: i64 @ c.pos

    while c.tokens[i].kind != .eof && c.tokens[i].kind != .indent && c.tokens[i].kind != .dedent && c.tokens[i].kind != .terminator
        i @ i + 1

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    k = c.tokens[i].kind
    return k == .indent || !is_line_end(k) && k != .eof && head_lines.margin_has_tab(text, at: c.tokens[i].span.start)

# An indent, or a line with a tab in its margin, under the cursor. The second
# holds back the report of a missing body, placed by `parse` against the
# lexer's refusal of the margin: that refusal says it in both arms, and were
# it not there the missing body would be said, the loud direction.
function opening_at(@c: cursor.Cursor, text: str, missing: Missing) -> Body
    if cursor.at(c, .indent)
        return .indented

    if !tabbed_line(c, text)
        return .none
    here = cursor.current_span(c)
    margin = token.Span(start: here.start - head_lines.margin_width(text, at: here.start), end: here.start)
    cursor.push_held(
        @c.held,
        diag.Held(at: c.diagnostics.len(), cause: margin, diagnostic: missing_here(c, text, missing), apart: false)
    )
    return .tabbed

# No body where one is owed: named at the cursor, as it always was, unless the
# lexer already spoke there, the head's recovery ran past its line (`silent`),
# the head's own refusal stands on this very token, or the head's line was
# joined. A foreign word the parser reads as its swap where it opens its line
# is the keyword it writes to this guard, so `fn g()` below a bodiless head
# names that body missing, as `function g()` does (defect 133).
function absent(@c: cursor.Cursor, text: str, head: Mark, silent: bool, missing: Missing)
    if swap_reading.at_reported_error(c, text) || silent || refused_here(c, head)
        return
    d = missing_here(c, text, missing)
    seam = head_lines.joined_at(c, text, from: head.pos)

    if !seam.is_err()
        cursor.push_held(@c.held, diag.Held(at: c.diagnostics.len(), cause: seam.must(), diagnostic: d, apart: false))
        return
    cursor.push_diagnostic(@c.diagnostics, d)

function missing_here(c: cursor.Cursor, text: str, missing: Missing) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: missing.code,
        message: missing.lead + swap_reading.found(c, text) + missing.tail,
        span: cursor.current_span(c)
    )

# Whether the head already refused the token under the cursor: `for` alone at
# a file's end is refused as found at the end of the block, and a missing body
# named there is the same mistake at the same column.
function refused_here(c: cursor.Cursor, head: Mark) -> bool
    here = cursor.current_span(c).start
    i: i64 @ head.said

    while i < c.diagnostics.len()
        if c.diagnostics[i].span.start == here
            return true
        i @ i + 1

    return false

# Whether the token under the cursor begins its line of the text and that
# line's margin holds a tab.
function tabbed_line(c: cursor.Cursor, text: str) -> bool
    k = cursor.current_kind(c)

    if k == .eof || is_line_end(k)
        return false
    return head_lines.margin_has_tab(text, at: cursor.current_span(c).start)

# What a failed construct begun at token `from` drops, as
# `cursor.drop_rest_of_line` does, but never into the next line of the text:
# after an `=>` or an `else` over a line whose margin holds a tab the lexer
# puts no line end, and dropping to the next one took that line too.
function drop_line(@c: cursor.Cursor, text: str, from: i64)
    if c.pos != from && cursor.at_fresh_line(c)
        return

    while !cursor.at(c, .eof) && !cursor.at(c, .indent) && !cursor.at(c, .dedent)
        if c.pos != from && head_lines.margin_width(text, at: cursor.current_span(c).start) >= 0
            return

        if cursor.bump(@c).kind == .terminator
            return

# Whether a token can begin an expression, spec § 7's `Unary` and
# `Primary`: what `while` needs after it to be a loop, so what a `certain`
# *use `while`* for a `for` over a condition needs (defect 131's third
# round). Enumerated, so a new token kind is answered for, not defaulted.
function begins_an_expression(kind: token.TokenKind) -> bool
    return match kind
        .minus | .bang | .tilde | .ident | .int_lit | .float_lit | .str_lit | .str_piece => true
        .char_lit | .kw_true | .kw_false | .kw_nullptr | .hole | .kw_fail | .kw_if       => true
        .kw_match | .lparen | .lbracket | .lbrace | .dot                                 => true
        .kw_constant | .kw_function | .kw_record | .kw_variant | .kw_else | .kw_for      => false
        .kw_while | .kw_in | .kw_break | .kw_continue | .kw_return | .kw_test            => false
        .kw_assert | .kw_extern | .kw_use | .eq | .at | .colon | .colon_colon | .comma   => false
        .question | .arrow | .fat_arrow | .pipe | .rparen | .rbracket | .rbrace | .plus  => false
        .star | .slash | .percent | .eq_eq | .bang_eq | .lt | .le | .gt | .ge            => false
        .and_and | .or_or | .amp | .caret | .shl | .shr | .comment | .terminator         => false
        .indent | .dedent | .eof | .error                                                => false

# Whether the token under the cursor is `elif` opening its line, whose certain
# swap, the one the lexer wrote as for every swap, writes the `else if` an
# `if`'s chain reads it as (defect 133's class; `parse/swap_reading`).
function at_elif(c: cursor.Cursor, text: str) -> bool
    if !cursor.at(c, .error) || !cursor.at_fresh_line(c)
        return false
    swap = swap_reading.swap_at(c, text, cursor.current_span(c))
    return !swap.is_err() && swap.must() == "else if"

function is_line_end(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent
