# Where a body in braces stands: the brace habit's shape, read where a head's
# body begins (design.md §4.17; defect 131's class, 2026-09-29).
#
# `function main() {` over its body over `}` is the habit of the languages a
# model has read most, and so are `if x == 1 {` inside it, `} else {`, and a
# `{` alone on the line below its head, Allman's style. It is ONE mistake per
# `{`, and the parser met it badly twice. Inside braces the lexer makes no
# indent, so the body the author wrote is no block the grammar can find; and
# the lexer puts no line end after a `{` that ends its line, so a head that
# dropped the rest of its line took the body's first line with it, which is
# how a nested `if x == 1 {` lost its first statement and a `{` on the line
# below its head cost three messages.
#
# The questions here are the habit's shape, asked of the tokens and the text
# and never of what the parser decided:
#
# - `ending`: the `{` that opens a head's body in braces, the first on the
#   rest of the head's line of the text that ends it, or one alone on the
#   line below a line that ended;
# - `closer`: the `}` that closes it, by depth, or where the lexer named it
#   never closed;
# - `ends_line` and `opens_here`: whether a `{` is the last thing on its
#   line, a comment aside.
#
# And the moves the habit needs where a line is dropped. **A line that
# failed, a word the lexer refused at a line's head, a top-level word no
# declaration opens: each drops the rest of its line, and a `{` that ends it
# is where the drop stops** (`skip_line`, `drop_rest_of_line`), since past it
# the lexer puts no line end until the braces' first line has gone by, or,
# with its members separated by `,`, until the `}`. The braces are then the
# block under that line, and read as one is (`grammar_expr.hanging`,
# `parse/headless.read_below`), through the view `parse/braced_lines` lays
# out; `pass` moves past them. A closer one too many on what a failed line
# drops is told before it goes (`drop_told`).
#
# A `{` that is not the last thing on its line opens a map or a map type, or
# a habit written on one line (`function f() { return 1 }`), and is never a
# body read in braces. What is said and read at one is `parse/opening.hero`'s
# (`body_follows`) and `grammar_expr.indented_block`'s.
#
# A leaf: nothing here reads the parser.

use token
use text_lines
use cursor
use word_place
use state
use line_above
use brace_layout
use laid_braces
use pairing
use parse/line_end

## The habit

# The index of the `{` that opens a body in braces for the head whose line
# the cursor stands on, or -1: the first `{` on the rest of that line of the
# text that ends it (`if x == 1 {`, and past the junk a head's recovery
# drops), or, where the line has ended, a `{` alone on the line below it.
# The rest of the line is read in the tokens up to its line end, which a `{`
# that ends its line never has after it, so the `{` is met first.
function ending(c: cursor.Cursor, text: str) -> i64
    i: i64 @ c.pos

    while !token.ends_a_line(c.tokens[i].kind)
        if c.tokens[i].kind == .lbrace && ends_line(text, c.tokens[i].span) && !opens_a_value(c, at: i)
            return i
        i @ i + 1

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    if c.tokens[i].kind == .lbrace && alone(text, c.tokens[i].span) && !opens_a_value(c, at: i)
        return i
    return -1

# Whether a `{` at `span` is the last thing on its line of the text: nothing
# after it but blanks, or a comment.
function ends_line(text: str, span: token.Span) -> bool
    i: i64 @ span.end

    while i < text.len() && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r')
        i @ i + 1

    return i >= text.len() || text[i] == '\n' || text[i] == '#'

# Whether the cursor stands on a `{` that ends its line.
function opens_here(c: cursor.Cursor, text: str) -> bool
    return cursor.at(c, .lbrace) && ends_line(text, cursor.current_span(c)) && !opens_a_value(c, at: c.pos)

# Whether the `{` at token `at` stands where a value goes: after `=` or `@`,
# an operator, an opening bracket or a `,`, `return`, `assert` or `in`. It
# opens a map there, never a body in braces: `let m = {` over its entries
# was read as a body, each entry's `:` a second mistake (lane X4,
# 2026-09-29). A `>` that closes a record's or a variant's type parameters
# is no operator, `record Pair<T> {` (`line_above.closes_type_parameters`,
# asked of the same tokens; defect 135's class, lane recovery-b3). The list
# is the lexer's, `brace_layout.value_follows`, but `:`, `->` and `=>`, which
# that one counts for a type or an arm's value and this one leaves to the
# body a `{` may open there; kept as a copy here until defect 196.
function opens_a_value(c: cursor.Cursor, at: i64) -> bool
    # One the lexer laid out opens a body, past what it read before it: the
    # `{` that ends C's `for` header, `i++ {` (defect 302).
    if laid_braces.laid_out_by_lexer(c, open: at)
        return false
    i: i64 @ at - 1

    while i > 0 && c.tokens[i].kind == .comment
        i @ i - 1

    if i < 0
        return false
    none: [state.Break] = []
    k = c.tokens[i].kind

    if k == .gt && line_above.closes_type_parameters(c.tokens, breaks: none, at: i)
        return false
    return brace_layout.value_follows(k) && k != .colon && k != .arrow && k != .fat_arrow

# Whether a `{` at `span` stands alone on its line: only a margin before it,
# and it ends the line.
function alone(text: str, span: token.Span) -> bool
    return ends_line(text, span) && word_place.only_margin(text, from: word_place.line_start(text, at: span.start), to: span.start)

# The index of the token that closes the `{` at `open`, or, where nothing
# does, of where the lexer named it never closed: the line a declaration
# opens at column 0 (`pairing.close_after`), past which the braces read
# the next declarations as their own members, or the end of the file. For a
# `{` the lexer laid out, the index past the block below it, its `}` being
# no token.
function closer(c: cursor.Cursor, open: i64) -> i64
    if laid_braces.laid_out_by_lexer(c, open: open)
        return laid_braces.laid_block(c, open: open).past
    depth: i64 @ 0
    i: i64 @ open
    named = pairing.close_after(c, at: c.tokens[open].span.start)

    while i < c.tokens.len()
        kind = c.tokens[i].kind

        if kind == .eof || named >= 0 && c.tokens[i].span.start >= named
            return i

        if kind == .lbrace
            depth @ depth + 1
        else if kind == .rbrace
            depth @ depth - 1

            if depth == 0
                return i
        i @ i + 1

    return c.tokens.len() - 1

## Dropping a line, and passing braces

# Drop the rest of a broken line, as `cursor.skip_line` does, stopping on a
# `{` that ends it, which is left under the cursor. A bracket the line opens
# and the lexer closes is passed whole, to its closer: a line end inside it,
# `record = {` over `x: i64` over `}`, separates its items and ends no line
# (the recovery batches' C5, 2026-10-01; it left the `}` to be refused as a
# declaration of its own).
function skip_line(@c: cursor.Cursor, text: str)
    while !cursor.at(c, .eof) && !cursor.at(c, .indent) && !cursor.at(c, .dedent) && !opens_here(c, text)
        if cursor.at(c, .lparen) || cursor.at(c, .lbracket) || cursor.at(c, .lbrace) && !laid_braces.laid_out_by_lexer(c, open: c.pos)
            pair = pairing.paired_closer(c, text, open: c.pos)

            while pair > c.pos && !cursor.at(c, .eof)
                _ = cursor.bump(@c)

        if cursor.bump(@c).kind == .terminator
            return

# What a failed construct begun at token `from` drops, as
# `cursor.drop_rest_of_line` does, stopping on a `{` that ends its line.
function drop_rest_of_line(@c: cursor.Cursor, text: str, from: i64)
    if c.pos == from || !cursor.at_fresh_line(c)
        skip_line(@c, text)

# The same, a closer one too many on what it drops told first: what a failed
# statement drops (`parse/statement_end.close`), and what a head drops past
# its refusal or its junk (`parse/opening.body_follows`,
# `parse/members_below.no_members_below`; defects 199 and 198).
function drop_told(@c: cursor.Cursor, text: str, from: i64)
    a_closer_too_many(@c, text, from: from)
    drop_rest_of_line(@c, text, from: from)

# A closer one too many on the rest of the failed line begun at token `from`,
# `x = f(0X10 + ) )`: past where the statement stopped, the first closer on
# its line that closes no opener of its kind the line opened, with no report
# standing on it, is a mistake of its own, told as past a statement that did
# not fail (the audit's row 130-28, lane recovery-b8): until 2026-10-02 it
# went with the debris, told only once the first mistake was repaired. A
# closer of another kind inside an opener is that list's junk, its own
# report's or none, so `[0X20, )]` keeps its `]`. **Only a closer the drop
# takes** (the round's gate of 2026-10-02, redoing `ce5caf89`): past a
# statement that ended with its own block, `k = match n` over a failed arm,
# the drop takes nothing and the line under the cursor is the next
# statement's, which tells its own `)`; read to its line end, the scan told
# that `)` a second time at the same column. A head's line is asked the same
# since defect 199, `if f(1 +) )` over its body, and moved here from
# `parse/statement_end` for it, a module the head's reader cannot read.
function a_closer_too_many(@c: cursor.Cursor, text: str, from: i64)
    dropped: cursor.Cursor @ c
    drop_rest_of_line(@dropped, text, from: from)
    open: [token.TokenKind] @ []
    i: i64 @ from

    while i < dropped.pos
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            open @ open.push(k)
        else if k == .rparen || k == .rbracket || k == .rbrace
            at: i64 @ open.len() - 1

            while at >= 0 && token.closer_of(open[at]) != k
                at @ at - 1

            run = stray_run(c, text, at: i)

            if at >= 0
                open @ open.slice(from: 0, to: at)
            else if open.len() == 0 && i >= c.pos && !line_end.said_at(c, at: i, said: 0)
                cursor.error(
                    @c,
                    code: "expected_end_of_line",
                    message: "expected the end of the line, found `" + cursor.slice_of(text, run) + "` — one statement per line, no semicolons",
                    span: run
                )
                return
            else if open.len() == 0 && i >= c.pos && told_to(c, at: i) >= run.end
                while c.tokens[i + 1].span.end <= run.end
                    i @ i + 1
        i @ i + 1

# The closers from token `at` on, one after another on its line: a run of
# strays told at once, since past the first, which closes nothing the line
# opened, none does (defect 306); any other token alone.
function stray_run(c: cursor.Cursor, text: str, at: i64) -> token.Span
    last: i64 @ at

    while token.is_closer(c.tokens[at].kind) && token.is_closer(c.tokens[last + 1].kind) && text_lines.newlines_between(text, from: c.tokens[last].span.end, to: c.tokens[last + 1].span.start) == 0
        last @ last + 1

    return token.Span(start: c.tokens[at].span.start, end: c.tokens[last].span.end)

# What a line's reader names at the token under the cursor, `found` where it
# stands alone, or the run of strays it begins (`stray_run`).
function found_run(c: cursor.Cursor, text: str, found: str) -> str
    run = stray_run(c, text, at: c.pos)

    if run.end == cursor.current_span(c).end
        return found
    return "`" + cursor.slice_of(text, run) + "`"

# Where the last report said that begins at the token `at` ends, or -1: a
# walk back from the last, which finds one said on the line in hand at once.
function told_to(c: cursor.Cursor, at: i64) -> i64
    i: i64 @ c.diagnostics.len() - 1

    while i >= 0 && c.diagnostics[i].span.start != c.tokens[at].span.start
        i @ i - 1

    if i < 0
        return -1
    return c.diagnostics[i].span.end

# Move past the braces the `{` under the cursor opens, and past their `}` and
# its line end, which goes with it as a dedent's does; or, where the lexer
# laid them out, past the block below the `{` and the `}` after it on a line
# that goes on past it, the one the lexer kept a token of. A `}` alone on its
# line after the block is none of theirs.
function pass(@c: cursor.Cursor)
    laid = laid_braces.laid_out_by_lexer(c, open: c.pos)
    close = closer(c, open: c.pos)

    while c.pos < close && !cursor.at(c, .eof)
        _ = cursor.bump(@c)

    if c.pos == close && cursor.at(c, .rbrace) && (!laid || !token.ends_a_line(cursor.peek(c, 1)))
        _ = cursor.bump(@c)

        if !laid
            _ = cursor.eat(@c, .terminator)

# Whether the token before the cursor is a `}` that begins its line of the
# text: the close of braces opened on a line above, so that what follows it on
# its line is no part of the line the braces were opened on.
function after_a_close(c: cursor.Cursor, text: str) -> bool
    if c.pos == 0 || c.tokens[c.pos - 1].kind != .rbrace
        return false
    at = c.tokens[c.pos - 1].span.start
    return word_place.only_margin(text, from: word_place.line_start(text, at: at), to: at)

## Tests

test "a brace that ends the head's line opens its body, and the one it closes with is found by depth"
    # if x {  /  y = {1: 2}  /  }
    text = "if x {\n    y = {1: 2}\n}\n"
    tokens = [
        token.made(.kw_if, start: 0, end: 2)
        token.made(.ident, start: 3, end: 4)
        token.made(.lbrace, start: 5, end: 6)
        token.made(.ident, start: 11, end: 12)
        token.made(.eq, start: 13, end: 14)
        token.made(.lbrace, start: 15, end: 16)
        token.made(.int_lit, start: 16, end: 17)
        token.made(.colon, start: 17, end: 18)
        token.made(.int_lit, start: 19, end: 20)
        token.made(.rbrace, start: 20, end: 21)
        token.made(.terminator, start: 21, end: 21)
        token.made(.rbrace, start: 22, end: 23)
        token.made(.terminator, start: 23, end: 23)
        token.made(.eof, start: 24, end: 24)
    ]
    c: cursor.Cursor @ cursor.new_cursor(tokens)
    c.pos @ 2
    assert ending(c, text) == 2
    assert closer(c, open: 2) == 11

    # The map's `{` does not end its line and opens no body.
    c.pos @ 3
    assert ending(c, text) == -1

test "a brace alone on the line below a head that ended opens its body, and one after a statement does not"
    # f()  /  {  /  }   and   f()  /  { g()
    text = "f()\n{\n}\n"
    tokens = [
        token.made(.ident, start: 0, end: 1)
        token.made(.lparen, start: 1, end: 2)
        token.made(.rparen, start: 2, end: 3)
        token.made(.terminator, start: 3, end: 3)
        token.made(.lbrace, start: 4, end: 5)
        token.made(.rbrace, start: 6, end: 7)
        token.made(.terminator, start: 7, end: 7)
        token.made(.eof, start: 8, end: 8)
    ]
    c: cursor.Cursor @ cursor.new_cursor(tokens)
    c.pos @ 3
    assert ending(c, text) == 4

    shared = "f()\n{ g()\n"
    more = [
        token.made(.ident, start: 0, end: 1)
        token.made(.lparen, start: 1, end: 2)
        token.made(.rparen, start: 2, end: 3)
        token.made(.terminator, start: 3, end: 3)
        token.made(.lbrace, start: 4, end: 5)
        token.made(.ident, start: 6, end: 7)
        token.made(.eof, start: 10, end: 10)
    ]
    d: cursor.Cursor @ cursor.new_cursor(more)
    d.pos @ 3
    assert ending(d, shared) == -1

    # And an indented body is no habit.
    assert !alone("  x {\n", token.Span(start: 4, end: 5))
    assert ends_line("  x { # a note\n", token.Span(start: 4, end: 5))
