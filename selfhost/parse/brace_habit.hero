# Where a body in braces stands: the brace habit's shape, read where a head's
# body begins (design.md §4.17; defect 131's class, 2026-09-29).
#
# `function main() {` over its body over `}` is the habit of the languages a
# model has read most, and so are `if x == 1 {` inside it, `} else {`, and a
# `{` alone on the line below its head, Allman's style. It is ONE mistake per
# `{`, and the parser met it badly twice. Inside braces the lexer makes no
# indent, so the body the author wrote is no block the grammar can find; and
# the lexer puts no line end after a `{` that ends its line, so a head that
# dropped the rest of its line took the body's first line with it, which is
# how a nested `if x == 1 {` lost its first statement and a `{` on the line
# below its head cost three messages.
#
# The questions here are the habit's shape, asked of the tokens and the text
# and never of what the parser decided:
#
# - `ending`: the `{` that opens a head's body in braces, the first on the
#   rest of the head's line of the text that ends it, or one alone on the
#   line below a line that ended;
# - `closer`: the `}` that closes it, by depth, or where the lexer named it
#   never closed;
# - `ends_line` and `opens_here`: whether a `{` is the last thing on its
#   line, a comment aside.
#
# And the moves the habit needs where a line is dropped. **A line that
# failed, a word the lexer refused at a line's head, a top-level word no
# declaration opens: each drops the rest of its line, and a `{` that ends it
# is where the drop stops** (`skip_line`, `drop_rest_of_line`), since past it
# the lexer puts no line end until the braces' first line has gone by, or,
# with its members separated by `,`, until the `}`. The braces are then the
# block under that line, and read as one is (`grammar_expr.hanging`,
# `parse/headless.read_below`), through the view `parse/braced_lines` lays
# out; `pass` moves past them.
#
# A `{` that is not the last thing on its line opens a map or a map type, or
# a habit written on one line (`function f() { return 1 }`), and is never a
# body read in braces. What is said and read at one is `parse/opening.hero`'s
# (`body_follows`) and `grammar_expr.indented_block`'s.
#
# A leaf: nothing here reads the parser.

use token
use cursor
use word_place
use state
use line_above
use parse/unclosed

## The habit

# The index of the `{` that opens a body in braces for the head whose line
# the cursor stands on, or -1: the first `{` on the rest of that line of the
# text that ends it (`if x == 1 {`, and past the junk a head's recovery
# drops), or, where the line has ended, a `{` alone on the line below it.
# The rest of the line is read in the tokens up to its line end, which a `{`
# that ends its line never has after it, so the `{` is met first.
function ending(c: cursor.Cursor, text: str) -> i64
    i: i64 @ c.pos

    while !ends_a_line(c.tokens[i].kind)
        if c.tokens[i].kind == .lbrace && ends_line(text, c.tokens[i].span) && !opens_a_value(c, at: i)
            return i
        i @ i + 1

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    if c.tokens[i].kind == .lbrace && alone(text, c.tokens[i].span) && !opens_a_value(c, at: i)
        return i
    return -1

# Whether a `{` at `span` is the last thing on its line of the text: nothing
# after it but blanks, or a comment.
function ends_line(text: str, span: token.Span) -> bool
    i: i64 @ span.end

    while i < text.len() && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r')
        i @ i + 1

    return i >= text.len() || text[i] == '\n' || text[i] == '#'

# Whether the cursor stands on a `{` that ends its line.
function opens_here(c: cursor.Cursor, text: str) -> bool
    return cursor.at(c, .lbrace) && ends_line(text, cursor.current_span(c)) && !opens_a_value(c, at: c.pos)

# Whether the `{` at token `at` stands where a value goes: after `=` or `@`,
# an operator, an opening bracket or a `,`, `return`, `assert` or `in`. It
# opens a map there, never a body in braces: `let m = {` over its entries
# was read as a body, each entry's `:` a second mistake (lane X4,
# 2026-09-29). A `>` that closes a record's or a variant's type parameters
# is no operator, `record Pair<T> {` (`line_above.closes_type_parameters`,
# asked of the same tokens; defect 135's class, lane recovery-b3).
function opens_a_value(c: cursor.Cursor, at: i64) -> bool
    i: i64 @ at - 1

    while i > 0 && c.tokens[i].kind == .comment
        i @ i - 1

    if i < 0
        return false
    none: [state.Break] = []

    if c.tokens[i].kind == .gt && line_above.closes_type_parameters(c.tokens, breaks: none, at: i)
        return false

    return match c.tokens[i].kind
        .eq | .at | .lparen | .lbracket | .lbrace | .comma | .kw_return | .kw_assert | .kw_in => true
        .plus | .minus | .star | .slash | .percent | .eq_eq | .bang_eq | .lt | .le | .gt      => true
        .ge | .and_and | .or_or | .amp | .pipe | .caret | .shl | .shr | .bang | .tilde        => true
        .ident | .int_lit | .float_lit | .str_lit | .str_piece | .char_lit | .kw_true         => false
        .kw_false | .kw_nullptr | .hole | .kw_fail | .kw_if | .kw_match | .dot | .rparen      => false
        .rbracket | .rbrace | .kw_constant | .kw_function | .kw_record | .kw_variant          => false
        .kw_else | .kw_for | .kw_while | .kw_break | .kw_continue | .kw_test | .kw_extern     => false
        .kw_use | .colon | .colon_colon | .question | .arrow | .fat_arrow | .comment          => false
        .terminator | .indent | .dedent | .eof | .error                                       => false

# Whether a `{` at `span` stands alone on its line: only a margin before it,
# and it ends the line.
function alone(text: str, span: token.Span) -> bool
    return ends_line(text, span) && word_place.only_margin(text, from: word_place.line_start(text, at: span.start), to: span.start)

# The index of the token that closes the `{` at `open`, or, where nothing
# does, of where the lexer named it never closed: the line a declaration
# opens at column 0 (`parse/unclosed.close_after`), past which the braces read
# the next declarations as their own members, or the end of the file.
function closer(c: cursor.Cursor, open: i64) -> i64
    depth: i64 @ 0
    i: i64 @ open
    named = unclosed.close_after(c, at: c.tokens[open].span.start)

    while i < c.tokens.len()
        kind = c.tokens[i].kind

        if kind == .eof || named >= 0 && c.tokens[i].span.start >= named
            return i

        if kind == .lbrace
            depth @ depth + 1
        else if kind == .rbrace
            depth @ depth - 1

            if depth == 0
                return i
        i @ i + 1

    return c.tokens.len() - 1

## Dropping a line, and passing braces

# Drop the rest of a broken line, as `cursor.skip_line` does, stopping on a
# `{` that ends it, which is left under the cursor.
function skip_line(@c: cursor.Cursor, text: str)
    while !cursor.at(c, .eof) && !cursor.at(c, .indent) && !cursor.at(c, .dedent) && !opens_here(c, text)
        if cursor.bump(@c).kind == .terminator
            return

# What a failed construct begun at token `from` drops, as
# `cursor.drop_rest_of_line` does, stopping on a `{` that ends its line.
function drop_rest_of_line(@c: cursor.Cursor, text: str, from: i64)
    if c.pos == from || !cursor.at_fresh_line(c)
        skip_line(@c, text)

# Move past the braces whose `}` is at `close`, from inside them or from
# their `{`, and past the `}` and its line end, which goes with it as a
# dedent's does.
function pass(@c: cursor.Cursor, close: i64)
    while c.pos < close && !cursor.at(c, .eof)
        _ = cursor.bump(@c)

    if c.pos == close && cursor.at(c, .rbrace)
        _ = cursor.bump(@c)
        _ = cursor.eat(@c, .terminator)

# Whether the token before the cursor is a `}` that begins its line of the
# text: the close of braces opened on a line above, so that what follows it on
# its line is no part of the line the braces were opened on.
function after_a_close(c: cursor.Cursor, text: str) -> bool
    if c.pos == 0 || c.tokens[c.pos - 1].kind != .rbrace
        return false
    at = c.tokens[c.pos - 1].span.start
    return word_place.only_margin(text, from: word_place.line_start(text, at: at), to: at)

function ends_a_line(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent || kind == .eof

## Tests

function tok(kind: token.TokenKind, start: i64, end: i64) -> token.Token
    return token.Token(kind: kind, span: token.Span(start: start, end: end))

test "a brace that ends the head's line opens its body, and the one it closes with is found by depth"
    # if x {  /  y = {1: 2}  /  }
    text = "if x {\n    y = {1: 2}\n}\n"
    tokens = [
        tok(.kw_if, start: 0, end: 2)
        tok(.ident, start: 3, end: 4)
        tok(.lbrace, start: 5, end: 6)
        tok(.ident, start: 11, end: 12)
        tok(.eq, start: 13, end: 14)
        tok(.lbrace, start: 15, end: 16)
        tok(.int_lit, start: 16, end: 17)
        tok(.colon, start: 17, end: 18)
        tok(.int_lit, start: 19, end: 20)
        tok(.rbrace, start: 20, end: 21)
        tok(.terminator, start: 21, end: 21)
        tok(.rbrace, start: 22, end: 23)
        tok(.terminator, start: 23, end: 23)
        tok(.eof, start: 24, end: 24)
    ]
    c: cursor.Cursor @ cursor.new_cursor(tokens)
    c.pos @ 2
    assert ending(c, text) == 2
    assert closer(c, open: 2) == 11

    # The map's `{` does not end its line and opens no body.
    c.pos @ 3
    assert ending(c, text) == -1

test "a brace alone on the line below a head that ended opens its body, and one after a statement does not"
    # f()  /  {  /  }   and   f()  /  { g()
    text = "f()\n{\n}\n"
    tokens = [
        tok(.ident, start: 0, end: 1)
        tok(.lparen, start: 1, end: 2)
        tok(.rparen, start: 2, end: 3)
        tok(.terminator, start: 3, end: 3)
        tok(.lbrace, start: 4, end: 5)
        tok(.rbrace, start: 6, end: 7)
        tok(.terminator, start: 7, end: 7)
        tok(.eof, start: 8, end: 8)
    ]
    c: cursor.Cursor @ cursor.new_cursor(tokens)
    c.pos @ 3
    assert ending(c, text) == 4

    shared = "f()\n{ g()\n"
    more = [
        tok(.ident, start: 0, end: 1)
        tok(.lparen, start: 1, end: 2)
        tok(.rparen, start: 2, end: 3)
        tok(.terminator, start: 3, end: 3)
        tok(.lbrace, start: 4, end: 5)
        tok(.ident, start: 6, end: 7)
        tok(.eof, start: 10, end: 10)
    ]
    d: cursor.Cursor @ cursor.new_cursor(more)
    d.pos @ 3
    assert ending(d, shared) == -1

    # And an indented body is no habit.
    assert !alone("  x {\n", token.Span(start: 4, end: 5))
    assert ends_line("  x { # a note\n", token.Span(start: 4, end: 5))
