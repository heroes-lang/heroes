# The block under a line whose head nothing reads (design.md §4.17; defect
# 130's class, given to defect 133's lane and then lane X1's on 2026-09-29).
#
# Two lines have such a head. At the top level, a line no declaration opens:
# `recrod Point` over its fields, `fucntion f()` over its body and `varaint
# T` over its cases each cost `expected_declaration`, the one report of the
# head. In a body, a line whose first word the lexer refused: `elif x == 2`
# with no `if` above it, `fn inner()` or `struct P` inside a function, `const
# B: i64` over its value, each the lexer's `reserved_word`. Until 2026-09-29
# the block under the first was dropped with it, and the block under the
# second was named `unexpected_block`, a second message for a block that is
# the line's body; either way its own mistakes waited for the word to be
# fixed, the second turn §4.17 exists to save. The head's word has no
# certain swap there (one that has is read as its swap,
# `parse/swap_reading.hero`), so nothing says what the block IS but the
# block itself. It is read by the shape its lines have, before any of them
# is parsed:
#
# - a FIELD is `name: type`, and a block with one such line is a record's
#   fields, read by `member_lines.field_block`;
# - a CASE is a name alone on its line, and a block whose first line is one
#   is a variant's cases, read by `member_lines.case_block`;
# - a line opened by a declaration's keyword makes it a block of
#   declarations, `class Q` over its methods, which the caller reads as the
#   declarations it holds (`grammar_expr.declarations`, `parse/heads`); it
#   went whole until 2026-09-29, every mistake in it unsaid (lane X1's
#   finding 9);
# - anything else is a statement, and the block is a body, which the caller
#   reads with `grammar_expr.hanging`, as the body under any head that failed.
#
# **Only where the head can open a block** (`parse/refused_heads`): under
# `let x = 5` or `import geom` a deeper block is a mistake of its own, named
# `unexpected_block` and read as statements (lane X1's finding 7).
#
# **A field line wins over a first line that looks like a case**, because a
# record's first field can be the broken one (`y i64` over `x: i64`), and a
# broken field reads as a statement too. And **`x: i64 @ 0` is a
# statement**, a mutable binding: a field has no `@` and no `=`.
#
# What each reader reports is what it reports under the head it belongs to,
# so no message here is new: a block the head can open is read, never named,
# and one it cannot is named as any orphan is. The trees it builds belong to
# no declaration and are left in the arena, as a failed statement's are.
#
# A leaf below the knot: the statement reader is `grammar_expr`'s, which
# reads this module, so a body is left to the caller (`read_below`, `Left`).
# Its caller is `grammar_expr.under`, which `grammar_expr.finish` and
# `parse/decl.unexpected_top_level` call; and `grammar_expr.hanging` asks
# `arms_below` whether a block is arms.

use token
use ast
use cursor
use word_place
use lexer
use parse/member_lines
use parse/brace_habit
use parse/braced_lines
use parse/refused_heads
use parse/orphans

## Reading

variant Shape
    fields
    cases
    members
    statements

# What the caller still reads below a line whose head nothing reads: nothing,
# a block of declarations (`grammar_expr.declarations`), or a body of
# statements (`grammar_expr.hanging`).
variant Left
    nothing
    declarations
    statements

# Read the block below the line whose head, the token at `word`, nothing
# reads, as far as its shape lets this module: fields and cases here, a
# group's members and a body left to the caller. A block in braces, `class
# Point {` over its fields, is read the same way (`braced`); a body whose
# margin holds a tab, which has no `indent` to read shapes under, is the
# caller's (lane 130's third round). **Where the head opens no block**
# (`parse/refused_heads`), `let x = 5` or `import geom` over a deeper block,
# the block is a mistake of its own, named (`parse/orphans`) and read as
# statements (lane X1's finding 7).
function read_below(@c: cursor.Cursor, @a: ast.Ast, text: str, word: i64) -> Left
    if !refused_heads.opens_a_block(c, text, at: word)
        if cursor.at(c, .indent)
            orphans.read(@c)
        return .statements

    if brace_habit.opens_here(c, text)
        return braced(@c, @a, text)

    if !cursor.at(c, .indent)
        return .statements
    return read_shaped(@c, @a, text, shape: shape_below(c))

# Read the block under the cursor's indent as the fields or cases its shape
# names, and say what is left for the caller.
function read_shaped(@c: cursor.Cursor, @a: ast.Ast, text: str, shape: Shape) -> Left
    if shape == .fields
        _ = member_lines.field_block(@c, @a, text)
    else if shape == .cases
        _ = member_lines.case_block(@c, @a, text)
    else if shape == .members
        return .declarations
    else
        return .statements
    return .nothing

## A block in braces

# The block in braces the cursor's `{` opens, read as fields or cases where
# its lines are, through the view `parse/braced_lines` lays out, their own
# mistakes reported where they stand, and the cursor then past the `}`. A
# body or a block of declarations is the caller's, and the cursor is left on
# the `{`.
function braced(@c: cursor.Cursor, @a: ast.Ast, text: str) -> Left
    lines: cursor.Cursor @ braced_lines.laid_out(c, text)
    shape = shape_below(lines)

    if shape == .members
        return .declarations

    if shape == .statements
        return .statements
    _ = read_shaped(@lines, @a, text, shape: shape)
    braced_lines.took(c: @c, view: lines)
    return .nothing

# Whether the statement begun at token `at` opens its line of the text with a
# token the lexer refused: a word from another language, or a character that
# is not this one's. Such a line has said what is wrong with it, and the
# block under it is its body.
function refused_head(c: cursor.Cursor, text: str, at: i64) -> bool
    here = c.tokens[at].span.start
    return c.tokens[at].kind == .error && word_place.only_margin(text, from: word_place.line_start(text, at: here), to: here)

## The shape, read from the tokens

# The shape of the block whose `indent` the cursor stands on: its own lines
# only, since a deeper block belongs to the line above it.
function shape_below(c: cursor.Cursor) -> Shape
    starts = line_starts(c)

    for start in starts
        if field_shaped(c.tokens, start)
            return .fields

    if starts.len() > 0 && case_shaped(c.tokens, starts[0])
        return .cases

    for start in starts
        if opens_a_declaration(c.tokens[start].kind)
            return .members

    return .statements

# Whether the line under the indent the cursor stands on holds a `=>` outside
# brackets: the block is arms, and a block below a failed line is read as what
# it is, so that `mach n` over its arms costs one diagnostic and not one per arm
# (`grammar_expr.hanging`).
function arms_below(c: cursor.Cursor) -> bool
    i: i64 @ c.pos + 1
    depth: i64 @ 0

    while i < c.tokens.len()
        k = c.tokens[i].kind

        if depth == 0 && ends_a_line(k)
            return false

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth - 1
        else if k == .fat_arrow && depth == 0
            return true
        i @ i + 1

    return false

function opens_a_declaration(kind: token.TokenKind) -> bool
    return kind == .kw_function || kind == .kw_constant || kind == .kw_record || kind == .kw_variant

# Where each line of the block begins, at the block's own depth.
function line_starts(c: cursor.Cursor) -> [i64]
    starts: [i64] @ []
    depth: i64 @ 0
    fresh: bool @ true
    i: i64 @ c.pos + 1

    while i < c.tokens.len()
        kind = c.tokens[i].kind

        if kind == .eof
            return starts

        if kind == .indent
            depth @ depth + 1
        else if kind == .dedent
            if depth == 0
                return starts
            depth @ depth - 1
            fresh @ depth == 0
        else if kind == .terminator
            fresh @ fresh || depth == 0
        else if kind != .comment
            if fresh && depth == 0
                starts @ starts.push(i)
            fresh @ false
        i @ i + 1

    return starts

# `name: type`, and nothing a binding writes: no `@` and no `=`.
function field_shaped(tokens: [token.Token], start: i64) -> bool
    if tokens[start].kind != .ident || next_kind(tokens, start) != .colon
        return false
    i: i64 @ start

    while i < tokens.len() && !ends_a_line(tokens[i].kind)
        if tokens[i].kind == .at || tokens[i].kind == .eq
            return false
        i @ i + 1

    return true

# A name alone on its line: what follows it ends the line.
function case_shaped(tokens: [token.Token], start: i64) -> bool
    return tokens[start].kind == .ident && ends_a_line(next_kind(tokens, start))

# The kind of the first token after `at` that is not a comment.
function next_kind(tokens: [token.Token], at: i64) -> token.TokenKind
    i: i64 @ at + 1

    while i < tokens.len() && tokens[i].kind == .comment
        i @ i + 1

    if i >= tokens.len()
        return .eof
    return tokens[i].kind

function ends_a_line(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent || kind == .eof

## Tests

function tok(kind: token.TokenKind, start: i64) -> token.Token
    return token.Token(kind: kind, span: token.Span(start: start, end: start + 1))

function shape_of(kinds: [token.TokenKind]) -> Shape
    tokens: [token.Token] @ []
    i: i64 @ 0

    for kind in kinds
        tokens @ tokens.push(tok(kind, i))
        i @ i + 1

    return shape_below(cursor.new_cursor(tokens))

test "a block is read as fields, cases or a body by the shape of its lines"
    # x: i64 / y i64 (the broken field second)
    assert shape_of([.indent, .ident, .colon, .ident, .terminator, .ident, .ident, .terminator, .dedent, .eof]) == .fields

    # y i64 / x: i64 (the broken field first): a field line anywhere wins
    assert shape_of([.indent, .ident, .ident, .terminator, .ident, .colon, .ident, .terminator, .dedent, .eof]) == .fields

    # a / b: two cases
    assert shape_of([.indent, .ident, .terminator, .ident, .terminator, .dedent, .eof]) == .cases

    # circle over its own field, then square: the deeper line is the case's,
    # so the block's own lines are two cases
    assert shape_of([.indent, .ident, .terminator, .indent, .ident, .colon, .ident, .terminator, .dedent, .ident, .terminator, .dedent, .eof]) == .cases

    # x = 3 / print(x): a body
    assert shape_of([.indent, .ident, .eq, .int_lit, .terminator, .ident, .lparen, .ident, .rparen, .terminator, .dedent, .eof]) == .statements

    # v: i64 @ 0 is a binding, not a field
    assert shape_of([.indent, .ident, .colon, .ident, .at, .int_lit, .terminator, .dedent, .eof]) == .statements

    # function q() -> i64: a group's member, whose head is not here to read it
    assert shape_of([.indent, .kw_function, .ident, .lparen, .rparen, .arrow, .ident, .terminator, .dedent, .eof]) == .members

function lexed(text: str) -> cursor.Cursor
    return cursor.new_cursor(lexer.lex_one(text).tokens)

test "a block in braces is read as the fields or cases its lines are, its commas the habit's debris"
    # class P {  /  x: i64,  /  y i64,  /  }: the broken field is told, and
    # the cursor is past the braces and their line end.
    fields = "class P {\n    x: i64,\n    y i64,\n}\n"
    c: cursor.Cursor @ at_brace(fields)
    a: ast.Ast @ ast.new_ast()
    assert read_below(@c, @a, fields, word: 0) == .nothing
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "expected_field_type"
    assert cursor.at(c, .eof)

    # class C {  /  red, green,  /  blue  /  }: three cases, one of them on a
    # line of its own, and nothing to tell.
    cases = "class C {\n    red, green,\n    blue\n}\n"
    d: cursor.Cursor @ at_brace(cases)
    assert read_below(@d, @a, cases, word: 0) == .nothing
    assert d.diagnostics.len() == 0
    assert cursor.at(d, .eof)

    # class B {  /  x = 1  /  }: a body, left to the caller on its `{`.
    body = "class B {\n    x = 1\n}\n"
    e: cursor.Cursor @ at_brace(body)
    assert read_below(@e, @a, body, word: 0) == .statements
    assert cursor.at(e, .lbrace)

test "a block under a head that opens none is named and read"
    # let x = 5  /      print(1): the block is a mistake of its own.
    text = "let x = 5\n    print(1)\n"
    c: cursor.Cursor @ lexed(text)
    a: ast.Ast @ ast.new_ast()

    while !cursor.at(c, .indent)
        _ = cursor.bump(@c)

    assert read_below(@c, @a, text, word: 0) == .statements
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "unexpected_block"

# The cursor on the `{` of a line headed by a word the lexer refused.
function at_brace(text: str) -> cursor.Cursor
    c: cursor.Cursor @ lexed(text)

    while !cursor.at(c, .lbrace)
        _ = cursor.bump(@c)

    return c

test "a line's head the lexer refused is told from one it read"
    text = "elif x\nx = 1\n"
    c: cursor.Cursor @ lexed(text)
    assert refused_head(c, text, at: 0)
    assert !refused_head(c, text, at: 3)
