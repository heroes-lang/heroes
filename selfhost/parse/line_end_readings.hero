# How sure the fix of a line end refused inside brackets is (design.md §4.15,
# §4.17; panel 180 R3; defect 135). `parse/line_end` refuses a line end that
# stands before a token which would have gone on with the line above, and its
# fix moves the token up, which is the program on one line. That fix is
# `certain` only where going on is the only reading, so this module answers
# the two questions a `certain` fix owes: what else the token below may have
# been, and whether a closer closes the bracket at all.
#
# A leaf: it reads the cursor, the text and the closers a literal left open
# took, and nothing of the parser.

use token
use diag
use cursor
use lexer
use pairing
use laid_braces

# What else the line end refused before a token may have been, beside going on
# with the line above, which is what the fix writes:
#
# | case | the other reading | where |
# |---|---|---|
# | `nothing` | none | |
# | `argument` | a `,` left out, the second fix | a call's arguments, before a token that also begins one |
# | `operand` | an operator left out before a bracketed operand | a group or an index, before `(` or `[` |
#
# Going on with a `(` or a `[` calls or indexes what the line above ended
# with, which only a function or a value with elements can take, and the
# parser cannot see which it is: `(a` over `(b))` was a certain `a(`, refused
# anew as `not_callable` where `a` was a number, and so were a literal above and
# an index's own `xs[i` over `(j)]` (the certain-fix audit's P6).
variant Other
    nothing
    argument
    operand

# What a reading adds to the message, the fix's title, and how sure the fix is.
record Said
    tail: str
    title: str
    certainty: diag.Certainty

# The words for the token `written`, of kind `kind`, read as `other`, where
# `alone` says the line below could stand on its own after a closer left out
# above it: it begins with what also begins a value, and no closer closes the
# bracket (`closed_below`). There the closer left out is the other reading:
# moving the `.` of `.ok v` up to `scores[name`, the arm under a `match` whose
# `]` was left out, wrote `scores[name.` over `ok v`, its bracket still open
# (lane recovery-b4, on panel 183's critic's plan: one program refused anew,
# nine leaving `unclosed_bracket` standing). A line that can only go on, `[1`
# over `+ 2` (defect 130's case), cannot stand alone: its closer is owed after
# it, and going on stays the only reading.
function said(other: Other, written: str, kind: token.TokenKind, alone: bool) -> Said
    title = "end the line above with `" + written + "`"

    if other == .argument
        return Said(
            tail: "; to go on with the argument, end the line above with `" + written + "`, and for a new argument, write the `,` there",
            title: "go on with the argument: " + title,
            certainty: .guess
        )

    if other == .operand
        act = operand_act(kind)
        return Said(
            tail: "; to " + act + " what the line above ends with, end that line with `" + written + "`, and where an operator was left out before the `" + written + "`, write the operator there",
            title: act + " it: " + title,
            certainty: .guess
        )
    certainty: diag.Certainty @= .certain

    if alone
        certainty @ .guess
    return Said(
        tail: "; to break the line here, end the line above with `" + written + "`",
        title: title,
        certainty: certainty
    )

# What going on with a `(` or a `[` does to what the line above ended with.
function operand_act(kind: token.TokenKind) -> str
    if kind == .lparen
        return "call"
    return "index"

# Whether a closer closes the bracket the cursor stands in, by the lexer's own
# stack: the innermost opener before the cursor whose closer, if it has one,
# stands past it, paired as `pairing.paired_closer` pairs it, a closer of
# another kind included that the lexer paired with an opener of its own kind
# below the innermost (`closers.hero`, the recovery batches' C3, 2026-10-01).
# Until that day this was the pairing's walk begun inside the bracket, since
# `parse/unclosed` reads `parse/line_end` and could not be read from it; the
# walk now lives apart in `pairing`, which reads neither, so the two
# answer alike by being one.
function closed_below(c: cursor.Cursor, text: str) -> bool
    here = cursor.current_span(c).start
    i: i64 @= c.pos - 1

    while i >= 0
        k = c.tokens[i].kind

        if (k == .lparen || k == .lbracket || k == .lbrace) && !laid_braces.laid_out_by_lexer(c, open: i)
            pair = pairing.paired_closer(c, text, open: i)

            if pair >= c.pos
                return true

            if pair < 0
                named = pairing.close_after(c, at: c.tokens[i].span.start)

                if named < 0 || named > here
                    return false
        i @ i - 1

    return false

## Tests

# The cursor over `text` as the parser gets it, standing on the first token
# spelled `word`.
function standing_on(text: str, word: str) -> cursor.Cursor
    out = lexer.lex_one(text)
    c: cursor.Cursor @= cursor.new_cursor(out.tokens)
    c.closes @ out.closes

    while c.tokens[c.pos].kind != .eof && cursor.slice_of(text, c.tokens[c.pos].span) != word
        c.pos @ c.pos + 1

    return c

# Whether the bracket around the first token spelled `word` in `text` closes.
function closed_at(text: str, word: str) -> bool
    return closed_below(standing_on(text: text, word: word), text)

test "a bracket is closed below the cursor as the lexer's stack pairs it"
    # Closed, by its own closer and by a stray of another kind the stack pairs
    # with the innermost, `]` after `(` with no `[` open.
    assert closed_at(text: "function main()\n    x = (total\n        - fee)\n", word: "-")
    assert closed_at(text: "function main()\n    print(f(i\n        + 1]\n", word: "+")

    # Never closed where a closer of another kind closes the opener of its own
    # kind below, `print(xs[i` over `+ 1)` naming the `[` (2026-10-01).
    assert !closed_at(text: "function main()\n    print(xs[i\n        + 1)\n", word: "+")

    # Never closed: the file ends, or a declaration opens its line at column 0.
    assert !closed_at(text: "function f(m: {str: i64}) -> i64\n    return match m[\"a\"\n        .ok v => v\n        .err e => 0\n", word: ".")
    assert !closed_at(text: "function main()\n    xs = [a\n        * b\n\nfunction g()\n    print(1)\n", word: "*")

test "a token that also begins an operand keeps its fix a guess, and so does a line that could stand alone"
    assert said(.nothing, written: ".", kind: .dot, alone: false).certainty == .certain
    assert said(.nothing, written: ".", kind: .dot, alone: true).certainty == .guess
    assert said(.operand, written: "(", kind: .lparen, alone: false).certainty == .guess
    assert said(.operand, written: "[", kind: .lbracket, alone: false).title == "index it: end the line above with `[`"
    assert said(.argument, written: ".", kind: .dot, alone: false).certainty == .guess
