# The brace habit under a declaration's head: a `{` that ends the head's
# line, its body or its members inside braces, and a `}` alone on the line
# after them (design.md §4.17; defect 131's class, 2026-09-29).
#
# `fn main() {` over `print(1)` over `}` is the habit of the languages a model
# has read most, and it is ONE mistake. Until 2026-09-29 it cost the `{`'s
# report and then `expected_declaration` again at the `}`, and a body inside
# the braces lost its first line to the head's recovery and sent the rest to
# the top level, each line a declaration it is not. So the habit is read
# whole, from the `{` to the `}` that closes it:
#
# - under a head that owes a BODY (a `function`, a `constant`, a `test`), the
#   body in braces is read by the block reader, as it is under every head
#   that owes one, a nested `if x == 1 {` too, and a `{` alone on the line
#   below its head (`parse/brace_habit`, `parse/opening.body_follows`): the
#   `{` is refused as the missing body it stands for, the statements inside
#   are read as the body they are, their own mistakes too, and the `}` goes
#   silently;
# - under a head that owes MEMBERS (a `record`, a `variant`, an `extern`
#   group), the caller refuses the `{` as its head's junk, and the members
#   inside are read through the view of them `parse/braced_lines` lays out,
#   the `,` between them the habit's debris (`parse/members_below`; they went
#   whole until 2026-09-29, lane X1's finding 1).
#
# A `{` that is not the last thing on its line opens a map or a map type,
# and is never the habit, but right after a record's, a variant's or a
# group's head, where no map stands: `record P { x: i64 }` is the habit on
# one line.

use ast
use cursor
use grammar_expr
use parse/opening
use parse/brace_habit
use parse/unclosed
use parse/swap_reading
use parse/head_kind

## The habit

# Whether the cursor stands on a `{` that ends its line: nothing after it on
# the text's line, or nothing but a comment.
function opens(c: cursor.Cursor, text: str) -> bool
    return brace_habit.opens_here(c, text)

# A head that owes a body: the body, indented or in braces, as the block
# reader reads it under every head. Where the head's line left a bracket open
# that the lexer named, the lines below were read inside it and laid out as
# no body, which is left unsaid (`opening.body_follows`): they are passed
# over to where the lexer named it (lane recovery-b2, U5).
function body_or_block(@c: cursor.Cursor, @a: ast.Ast, text: str, owner: str, head: opening.Mark) -> ast.Block?
    b = grammar_expr.block(@c, @a, text: text, owner: owner, head: head)

    if b.is_err()
        unclosed.past_what_was_swallowed(@c, text, from: head.pos)
        at_the_margin(@c, @a, text, head: head)
    return b

# A body written at its head's own margin, `function main()` over `print(1)`
# at column 0, told missing at its first line: that line and those below it,
# to the next that opens a declaration, read as the body they are, their own
# mistakes told, where each was told again as no declaration (defect 202).
function at_the_margin(@c: cursor.Cursor, @a: ast.Ast, text: str, head: opening.Mark)
    if !opening.refused_here(c, head)
        return

    while !cursor.at(c, .eof) && !cursor.at(c, .indent) && !cursor.at(c, .dedent) && !opens_a_declaration(c, text)
        _ = grammar_expr.statement(@c, @a, text)
        cursor.skip_terminators(@c)

# Whether the line under the cursor opens a top-level declaration or a `use`,
# as the file's reader takes it (`parse/decl.file`).
function opens_a_declaration(c: cursor.Cursor, text: str) -> bool
    k = swap_reading.opens_line_as(c, text)
    return head_kind.declares(k) || k == .kw_use

# Braces below a head that failed past a line of its own, `extern "m.h" )`
# over them, which go whole with that head, `{` to `}`, after the caller's
# one report; where members stand in braces they are read instead
# (`parse/members_below`).
function skip(@c: cursor.Cursor)
    close = brace_habit.closer(c, open: c.pos)

    while c.pos < close && !cursor.at(c, .eof)
        _ = cursor.bump(@c)

    if cursor.at(c, .rbrace)
        _ = cursor.bump(@c)
