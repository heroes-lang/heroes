# A record's tail: what follows its name, after an ordinary head and after an
# `extern` group's member alike (design.md §4.2, §4.19; panels 060, 074, 145).
#
# Moved out of `parse/tails.hero` on 2026-09-29 (defect 133) along the seam
# that file's own doc names: a record's two contextual markers, `tag` and
# `partial`, and its fields. The move is the price of the one guard defect
# 133 changed here, `empty_record`'s, which reads the next line's head as its
# certain swap (`parse/swap_reading.hero`); `parse/tails.hero` stood at §11's
# 300 and the record half is the concern that could stand alone. Nothing
# here calls back: `parse/decl.hero` and `parse/group.hero` call in, and this
# module reads `Linkage` and the clamp from `parse/tails.hero`, which reads
# nothing here. What a head owes where its fields are not indented right
# below it, junk, braces or nothing, is `parse/members_below.hero` since the
# same day (lane X4), shared with a variant, a group and a record nested in a
# block of declarations.

use token
use cursor
use ast
use handles
use keywords
use parse/tails
use parse/members_below
use parse/heads
use parse/brace_habit
use grammar_expr
use lexer

# The same declaration when the caller has **already taken the doc comment** —
# which is what a group member needs, because a group's own doc documents its
# first member and `head` would take the run a second time (§4.1's adjacency
# rule, applied to a block).
function record_with_doc(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, doc: [token.Span], linkage: tails.Linkage)
    keyword = cursor.current_span(c)
    _ = cursor.bump(@c)

    if !cursor.at(c, .ident)
        if !cursor.at_reported_error(c)
            cursor.error(
                @c,
                code: "expected_name",
                message: "expected the C struct's name after `record`, found " + cursor.found(c, text) + " — `record Color`" + heads.in_braces(c, block: heads.below_of(.kw_record)),
                span: cursor.current_span(c)
            )

        # The fields below it, indented or in braces, are the record's, read
        # as a top-level record's are when its name is missing (`decl`).
        brace_habit.drop_rest_of_line(@c, text, from: c.pos - 1)
        _ = members_below.fields_below(@c, @a, text, below: members_below.here(c, text))
        return
    name = cursor.bump(@c).span
    record_tail(@c, @a, @decls, text, keyword: keyword, doc: doc, name: name, linkage: linkage)

# `tag stat` after a group `record`'s name, if it is there (panel 074).
#
# **Contextual exactly like `partial`, and for the same reason**: it is
# consumed only in this position, so `tag` stays an ordinary identifier
# everywhere in the language and a field named `tag` goes on compiling. What
# follows it must be an identifier — C's tag — and a missing one is reported
# here rather than left to the field block, which would say something about
# indentation.
#
# **Order is `tag <name>` then `partial`**, and the other order is a parse
# error on purpose: one order that parses is one order to learn.
function tag_marker(@c: cursor.Cursor, text: str, in_group: bool) -> token.Span?
    if !in_group || !cursor.at(c, .ident) || cursor.slice_of(text, cursor.current_span(c)) != keywords.WORD_TAG
        return fail(code: "absent", msg: "no tag clause")
    keyword = cursor.bump(@c).span

    if !cursor.at(c, .ident)
        cursor.error(
            @c,
            code: "expected_declaration",
            message: "`tag` names the struct tag C uses for this type: `record FileStat tag stat`",
            span: tails.here_or(c, keyword)
        )
        return fail(code: "absent", msg: "the tag's name is missing")
    return ok(cursor.bump(@c).span)

# `partial` after a group `record`'s name, if it is there.
#
# **A contextual keyword and not a reserved word** (panel 061). It is consumed
# only here, in the one position where a declaration can carry it, so
# `partial` stays an ordinary identifier everywhere in the language.
# **Only inside a group**: an ordinary `record` has no header behind it, so
# there is no struct for its field list to be a subset OF.
function partial_marker(@c: cursor.Cursor, text: str, in_group: bool) -> bool
    if !in_group || !cursor.at(c, .ident) || cursor.slice_of(text, cursor.current_span(c)) != keywords.WORD_PARTIAL
        return false
    _ = cursor.bump(@c)
    return true

# A group `record` with a `tag` and NO fields is a HANDLE: a pointer to a type
# the header names and leaves opaque (panel 145, ratified 2026-09-13).
# `handles.is_handle_parts` is the one place that says which three facts make
# one, and this is one of its four callers.
#
# **The caret no longer asks the cursor where it is.** By the time the refusal
# below runs, `skip_terminators` has crossed the record's own line end and the
# current token is the NEXT declaration's first, so `empty_record` underlined a
# line the author had done nothing wrong on — measured 2026-09-13, and it is the
# repair panel 145 owed this step. It underlines `record <Name> tag <tag>`
# instead, which is the text to change.
function record_tail(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, keyword: token.Span, doc: [token.Span], name: token.Span, linkage: tails.Linkage)
    in_group = tails.is_from_c(linkage)
    tag = tag_marker(@c, text, in_group: in_group)
    partial = partial_marker(@c, text, in_group: in_group)
    head_end: token.Span @ name

    if !tag.is_err()
        head_end @ tag.must()
    is_handle = handles.is_handle_parts(in_group: in_group, tagged: !tag.is_err(), partial: partial, field_count: 0)
    grammar_expr.eat_python_colon(@c)
    cursor.skip_terminators(@c)
    below: members_below.Below @ .indented

    if !cursor.at(c, .indent) && !is_handle
        # What goes on past the head is dropped and fields below it are read
        # (defect 131's second round, lane 130). **And they are never called
        # absent** (defect 131's class, 2026-09-29): over fields that are
        # there, the report is the head's own junk, as `record Point )` over
        # `x: i64` is; `empty_record` is the report where there are none.
        head = token.Span(start: keyword.start, end: head_end.end)
        below @ members_below.no_members_below(
            @c,
            text: text,
            head: head,
            members: "fields",
            empty: members_below.empty_record(head, in_group: in_group, partial: partial)
        )
    finish: token.Span @ head_end

    if cursor.at(c, .indent)
        finish @ cursor.current_span(c)
    fields = members_below.fields_below(@c, @a, text, below: below)

    if fields.len() > 0
        finish @ fields[fields.len() - 1].name
    decls @ decls.push(
        ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: finish.end), kind: .record_decl(fields: fields, header: tails.linkage_header(linkage), library: tails.linkage_library(linkage), partial: partial, tag: tag))
    )

## Tests

# The junk after a record's head, as the lexer's own stream hands it over:
# `record` alone at a line's end is joined to the line below, the control
# arm reads the join as the program, and it is that reading's message whose
# quote is at issue (defect 131's class, 2026-09-29).
function junk_said(text: str) -> str
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    no_doc: [token.Span] = []
    record_with_doc(@c, @a, @decls, text, doc: no_doc, linkage: .heroes)

    for d in c.diagnostics
        if d.code == "expected_end_of_line"
            return d.message

    return ""

# Whether `said` begins with `prefix`, and is long enough to.
function opens_with(said: str, prefix: str) -> bool
    return said.len() >= prefix.len() && said.slice(from: 0, to: prefix.len()) == prefix

test "a head the lexer joined across a line break is quoted as it stands on one line"
    # Found `:`, the first token past the quoted head, since lane X3 left a
    # mid-line `:` to its head's own report (the batch of lanes X3 and X4,
    # 2026-09-29); it said found `i64` before. The quote is what this holds.
    after = "expected the end of the line after `record x`, found `:`"
    assert opens_with(said: junk_said("record\n    x: i64\n    y: i64\n"), prefix: after)

    # A comment before the break, and a CRLF file: neither reaches the quote.
    assert opens_with(said: junk_said("record  # a point\n    x: i64\n    y: i64\n"), prefix: after)
    assert opens_with(said: junk_said("record\r\n    x: i64\r\n    y: i64\r\n"), prefix: after)

    # On one line the text's own spelling stands, two spaces and all.
    assert opens_with(
        said: junk_said("record  Point )\n    x: i64\n"),
        prefix: "expected the end of the line after `record  Point`, found `)`"
    )
