# A block where a statement should start that no head opens, an orphan:
# what it is told and what of its first line is read (design.md §4.17;
# defect 130's class, 2026-09-29).
#
# Moved out of `parse/opening.hero` on 2026-09-29 (lane X4), when an orphan
# came to be read rather than dropped and that module passed §11's 300. An
# orphan is `unexpected_block`, once, at its indent (`named`); its lines are
# read by the caller, the grammar, which is why this module only names it
# and passes over the token of its first line that continues the line above
# (`read`). Its callers are `grammar_expr.indented_block`, `grammar_expr`'s
# arms, `parse/headless.read_below`, under a refused word that opens no
# block, and `parse/statement_end.close`, below a line the lexer refused
# past its head, whose block is the rest of that line and goes whole.

use token
use cursor
use lexer

# A block where a statement should start, which no head opens: named, once,
# and read by the caller, its own mistakes told, where until 2026-09-29 it
# went whole with every mistake in it (lane Y's finding, defect 130's class).
# **Its first line may be the line above going on**: one that begins with a
# token that only ever goes on with a line, `+ b` or `else` below `x = a`, or
# with a word and then a value no suffix and no operator of the word's joins
# to it, `and b`, the shape of an operator another language spells as a word.
# That leading token is the one mistake the block's name says, and it is
# passed over (`passed`); what follows it is read, as the rest of the block
# is. Until 2026-09-30 such a block went whole, since read as lines `and b`
# cost two, and so `foo bar )`'s `)` and every later line's own mistakes went
# unsaid (lane X4's report). The caller reads the block, from its indent.
function read(@c: cursor.Cursor)
    named(@c)
    first = cursor.peek(c, 1)
    then = cursor.peek(c, 2)
    worded = first == .ident && token.begins_an_expression(then) && then != .lparen && then != .lbracket && then != .dot && then != .minus

    if token.continues_a_line(first) || worded
        passed(@c)

# The first token of the block under the cursor's indent passed over as a line
# end, in place, so no index another reader holds into the stream moves:
# `and` in `and b )`, and the block's first line is `b )`. An `else` alone on
# that line opens the block below it, its body, whose lines are then the
# orphan's own, read and not named twice, as a dangling `else`'s body at a
# statement's own margin is (`flattened`).
function passed(@c: cursor.Cursor)
    i: i64 @ c.pos + 1

    while c.tokens[i].kind == .comment
        i @ i + 1

    was = c.tokens[i].kind
    c.tokens[i] @ token.Token(kind: .terminator, span: c.tokens[i].span)

    if was == .kw_else
        flattened(@c, from: i + 1)

# The block that begins at the first indent from token `from`, past line ends
# and comments, with its indent and its matching dedent made line ends; none
# where a token of the line stands first.
function flattened(@c: cursor.Cursor, from: i64)
    i: i64 @ from

    while c.tokens[i].kind == .comment || c.tokens[i].kind == .terminator
        i @ i + 1

    if c.tokens[i].kind != .indent
        return
    depth: i64 @ 0
    j: i64 @ i

    while c.tokens[j].kind != .eof
        if c.tokens[j].kind == .indent
            depth @ depth + 1
        else if c.tokens[j].kind == .dedent
            depth @ depth - 1

            if depth == 0
                c.tokens[i] @ token.Token(kind: .terminator, span: c.tokens[i].span)
                c.tokens[j] @ token.Token(kind: .terminator, span: c.tokens[j].span)
                return
        j @ j + 1

# What an orphan is told, at its indent.
function named(@c: cursor.Cursor)
    if !cursor.at_reported_error(c)
        cursor.error(
            @c,
            code: "unexpected_block",
            message: "this block is indented deeper than anything that opens one",
            span: cursor.current_span(c)
        )

## Tests

# The cursor at the first indent of `text`, as the lexer cuts it.
function at_indent(text: str) -> cursor.Cursor
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)

    while !cursor.at(c, .indent) && !cursor.at(c, .eof)
        _ = cursor.bump(@c)

    return c

test "an orphan that goes on with the line above is named once, and its lines are read"
    # `and` is passed over, and the line `b )` is left to the caller.
    c: cursor.Cursor @ at_indent("x = 1\n    and b )\n")
    read(@c)
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "unexpected_block"
    assert cursor.at(c, .indent)
    assert cursor.peek(c, 1) == .terminator
    assert cursor.peek(c, 2) == .ident

    # A lone `else` opens its body, which is the orphan's own: no indent is
    # left below the orphan's for the caller to name a second time.
    d: cursor.Cursor @ at_indent("x = 1\n    else\n        y = 3\n")
    read(@d)
    i: i64 @ d.pos + 1

    while d.tokens[i].kind != .eof
        assert d.tokens[i].kind != .indent
        i @ i + 1

    # A line that begins a statement is not passed over.
    e: cursor.Cursor @ at_indent("x = 1\n    y = 3 )\n")
    read(@e)
    assert cursor.peek(e, 1) == .ident
