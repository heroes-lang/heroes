# A body's braces the lexer laid out, as the parser finds them (design.md
# §4.15, §4.17; ruling 1 of the recovery batches, defect 130's class,
# 2026-10-01).
#
# The lexer reads a `{` that ends its head's line outside every bracket as
# that line's end (`brace_layout.hero`): no bracket opens, a line end follows
# it, the lines below are an indented block like any other, and the `}` that
# closes it is a token only where its line goes on past it. The parser tells
# the `{` once, as it always has (`parse/brace_habit`), and reads what is
# below it as the program the braces' fix leaves: through the view
# `parse/braced_lines` makes, or, for a case's fields, as the block below the
# case (`parse/member_lines`). Such a `{` is no opener, and is never closed
# (`parse/unclosed`).
#
# A leaf: it reads the tokens and nothing that reads the parser.
#
# | entry | called by |
# |---|---|
# | `laid_out_by_lexer` | `parse/unclosed.never_closed`, `parse/brace_habit`, `parse/braced_lines`, `parse/member_lines` |
# | `laid_block` | `parse/brace_habit.closer`, `parse/braced_lines.lexer_laid` |

use cursor
use lexer

# Whether the `{` at `open` is one the lexer read as its head's line end
# (`brace_layout.hero`, ruling 1): a line end follows it, past a comment, and
# the lexer plants none after a `{` it took for a bracket, whose lines are
# inside it. Its lines are laid out below it as an indented block, and the
# `}` that closes it is a token only where its line goes on past it.
function laid_out_by_lexer(c: cursor.Cursor, open: i64) -> bool
    i: i64 @ open + 1

    while i < c.tokens.len() && c.tokens[i].kind == .comment
        i @ i + 1

    return c.tokens[open].kind == .lbrace && i < c.tokens.len() && c.tokens[i].kind == .terminator

# Where the block the lexer laid out below the `{` at `open` begins, its
# indent, and the index past its dedent; for a `{` with no line deeper below
# it, the index past its line end, twice.
record LaidBlock
    indent: i64
    past: i64

function laid_block(c: cursor.Cursor, open: i64) -> LaidBlock
    i: i64 @ open + 1

    while i < c.tokens.len() && (c.tokens[i].kind == .comment || c.tokens[i].kind == .terminator)
        i @ i + 1

    if i >= c.tokens.len() || c.tokens[i].kind != .indent
        return LaidBlock(indent: i, past: i)
    depth: i64 @ 0
    j: i64 @ i

    while j < c.tokens.len() && c.tokens[j].kind != .eof
        if c.tokens[j].kind == .indent
            depth @ depth + 1
        else if c.tokens[j].kind == .dedent
            depth @ depth - 1

            if depth == 0
                return LaidBlock(indent: i, past: j + 1)
        j @ j + 1

    return LaidBlock(indent: i, past: j)

## Tests

# A cursor on the first `{` of `text`, as the lexer cuts it.
function first_brace(text: str) -> cursor.Cursor
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)

    while !cursor.at(c, .lbrace)
        _ = cursor.bump(@c)

    return c

test "a body's brace that ends its line is the lexer's, laid out, and a map's is a bracket"
    body = "function f() {  # a note\n    print(1)\n}\n"
    b = first_brace(body)
    assert laid_out_by_lexer(b, open: b.pos)
    laid = laid_block(b, open: b.pos)
    assert b.tokens[laid.indent].kind == .indent
    assert b.tokens[laid.past - 1].kind == .dedent

    for bracket in ["function f()\n    m = {\n        \"a\": 1\n    }\n", "function f()\n    m = { \"a\": 1 }\n"]
        m = first_brace(bracket)
        assert !laid_out_by_lexer(m, open: m.pos)
