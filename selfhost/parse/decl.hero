# The top level: the dispatcher and the seven declaration heads (design.md
# §4.1, §4.2, §4.18; panels 018, 055, 060, 061, 074).
# Port of the dispatch half of `archive/bootstrap-rs/heroes/src/syntax/decl.rs`
# and `archive/bootstrap-rs/heroes/src/syntax/data.rs`.
#
# **The entry point is `file`**, and it is the whole public surface for a
# caller that wants a program parsed: it reads declarations until `eof`, and
# every path either builds a declaration or recovers past one, so the loop
# always makes progress. That closed keyword set — every top-level line
# starts with its kind — is also recovery's anchor: one broken declaration
# can never swallow the next one (panel 018).
#
# **What is here and what is next door.** A declaration is a HEAD — the
# keyword, the doc comment above it, the name — and then a TAIL, which is
# everything after the name and differs per kind. The heads are here, and
# the shared `head` reader is `parse/heads.hero` since 2026-09-29, where a
# block of declarations under a refused head reads it too. The tails are
# `parse/tails.hero`, because an `extern` group's member has the same tails
# and a different head, and the `extern` group itself is `parse/group.hero`.
#
# **That split is what opened a ring this module's doc called unsplittable**
# (M-declared-freer step 1). The doc said the four Rust files were "one
# module or nothing" because `file` reaches `extern_group`, whose `members`
# calls back into `constant_tail` and `function_tail` — and that is true of
# THAT cut and of no other. The ring is a fact about where the shared tails
# live, not about the grammar: moved into a third module neither of the
# other two is used by, the edges run one way and `module_cycle` never
# fires. The compiler's own diagnostic had been printing the answer all
# along — *"move what both modules need into a third one that neither
# uses"*.
#
# The edges that leave this module and stay other modules: `parse/heads` (the
# shared head), `parse/records` (fields and cases, indented or in braces),
# `grammar_expr` (bodies), `parse_use` (the one declaration that names a
# file), and `parse/top_level` (a line that opens no declaration, since
# 2026-10-02).

use token
use cursor
use doc_comments
use ast
use diag
use lexer
use source
use parse/use_line
use parse/tails
use parse/records
use parse/members_below
use parse/group
use parse/swap_reading
use parse/heads
use parse/braces
use grammar_expr
use parse/opening
use parse/top_level

## The dispatcher

# Read declarations until end of file. Every path either builds a declaration
# or recovers past one, so this loop always makes progress.
#
# **A foreign word whose certain swap is a declaration's keyword opens that
# declaration** (defect 133): `fn main() {` is read as `function main() {`,
# so the brace is reported in the same run as the `fn`. Every declaration
# below consumes its keyword without asking its kind, which is what lets the
# `error` token the lexer left there stand for the keyword the swap writes.
function file(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], @uses: [ast.Use], text: str)
    done: bool @ false

    while !done
        cursor.skip_terminators(@c)
        k = swap_reading.opens_line_as(c, text)

        if k == .eof
            done @ true
        else if k == .kw_constant
            constant_declaration(@c, @a, @decls, text)
        else if k == .kw_function
            function_declaration(@c, @a, @decls, text)
        else if k == .kw_record
            record_declaration(@c, @a, @decls, text, .heroes)
        else if k == .kw_variant
            variant_declaration(@c, @a, @decls, text)
        else if k == .kw_extern
            group.extern_group(@c, @a, @decls, text)
        else if k == .kw_test
            test_declaration(@c, @a, @decls, text)
        else if k == .kw_use
            use_line.declaration(@c, @uses, text)
            top_level.past_a_use(@c, text)
        else
            top_level.unexpected(@c, @a, text)

## constant

# `constant MAX_DEPTH: i64` + the value, indented (§4.2). Constants use
# SCREAMING_CASE by convention; the parser does not police it.
function constant_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    began = opening.mark(c)
    h = heads.head(@c, text: text, kind: .kw_constant)

    if h.is_err()
        tails.owed_body(@c, @a, text: text, owner: "a `constant`", head: began)
        return
    hd = h.must()
    tails.constant_tail(
        @c,
        @a,
        @decls,
        text,
        keyword: hd.keyword,
        doc: hd.doc,
        name: hd.name,
        linkage: .heroes,
        head: opening.mark(c)
    )

## function

# `function dist2(a: Point, b: Point) -> i64` + body (§4.2). The parameter
# list attaches to the name, as at the call site.
function function_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    began = opening.mark(c)
    h = heads.head(@c, text: text, kind: .kw_function)

    if h.is_err()
        tails.owed_body(@c, @a, text: text, owner: "a `function`", head: began)
        return
    hd = h.must()
    tails.function_tail(
        @c,
        @a,
        @decls,
        text,
        keyword: hd.keyword,
        doc: hd.doc,
        name: hd.name,
        linkage: .heroes,
        head: opening.mark(c)
    )

## test

# `test "3-4-5 triangle"` + body (§4.18). The name is a string, not an
# identifier: it is a title, and it is printed when the test fails.
function test_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    began = opening.mark(c)
    keyword = cursor.current_span(c)
    doc = doc_comments.take_docs(@c, text, keyword)
    _ = cursor.bump(@c)
    named = heads.test_name(@c, text)

    if named.is_err()
        tails.owed_body(@c, @a, text: text, owner: "a `test`", head: began)
        return
    name = named.must()
    b = braces.body_or_block(@c, @a, text: text, owner: "a `test`", head: began)

    if b.is_err()
        cursor.recover_to_next_decl(@c)
        return
    body = b.must()
    decls @ decls.push(
        ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: body.span.end), kind: .test_decl(body: body))
    )

## record

# `record Point` + one field per line (§4.2) — and, since panel 060, the same
# shape inside an `extern` group, where the fields describe a struct the
# header already declares (§4.19). One entry point for both, because the
# SYNTAX is identical: what differs is the linkage handed in, and every
# question a later pass asks reads `header` rather than re-deriving it from
# where the declaration was parsed.
function record_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, linkage: tails.Linkage)
    keyword = cursor.current_span(c)
    from = c.pos
    h = heads.head(@c, text: text, kind: .kw_record)

    if h.is_err()
        empty = members_below.empty_record(keyword, in_group: tails.is_from_c(linkage), partial: false)
        _ = members_below.fields_below(
            @c,
            @a,
            text,
            below: members_below.here_or_told(@c, text, from: from, empty: empty)
        )
        return
    hd = h.must()
    records.record_tail(@c, @a, @decls, text, keyword: hd.keyword, doc: hd.doc, name: hd.name, linkage: linkage)

## variant

# `variant Token` + one case per line, each case optionally carrying fields —
# a case with fields IS a small record (§4.2).
function variant_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    keyword = cursor.current_span(c)
    from = c.pos
    h = heads.head(@c, text: text, kind: .kw_variant)

    if h.is_err()
        empty = members_below.empty_variant(keyword)
        _ = members_below.cases_below(
            @c,
            @a,
            text,
            below: members_below.here_or_told(@c, text, from: from, empty: empty)
        )
        return
    hd = h.must()
    grammar_expr.eat_python_colon(@c)
    cursor.skip_terminators(@c)

    # Past the line end, the next head is read as its swap (defect 133). What
    # goes on past the head is dropped and cases below it are read, as a
    # record's fields are (defect 131's second round, lane 130), and over
    # cases that are there the report is the head's own junk, never
    # `empty_variant` (defect 131's class, 2026-09-29; `records.record_tail`).
    # `empty_variant` points at its own head, `variant Token`, as
    # `empty_record` does: it pointed at the next line's first token, a line
    # the author did nothing wrong on, until 2026-09-29 (defect 131's class).
    below: members_below.Below @ .indented

    if !cursor.at(c, .indent)
        written = token.Span(start: hd.keyword.start, end: hd.name.end)
        below @ members_below.no_members_below(
            @c,
            text: text,
            head: written,
            members: "cases",
            empty: members_below.empty_variant(written)
        )

        if below == .none
            return
    start = cursor.current_span(c)
    cases = members_below.cases_below(@c, @a, text, below: below)
    finish: token.Span @ start

    if cases.len() > 0
        finish @ cases[cases.len() - 1].name
    decls @ decls.push(
        ast.Decl(name: hd.name, doc: hd.doc, span: token.Span(start: hd.keyword.start, end: finish.end), kind: .variant_decl(cases: cases))
    )

## Tests

# The tests lex REAL source with the ported lexer rather than hand-building
# token streams: a declaration's stream carries indents, dedents and
# terminators whose placement is the lexer's judgment, and hand-placing them
# would test this parser against my guess instead of against the language.
record Parsed
    decls: [ast.Decl]
    uses: [ast.Use]
    diagnostics: [diag.Diagnostic]
    tree: ast.Ast

function parse_source(text: str) -> Parsed
    out = lexer.lex_one(text)
    c: cursor.Cursor @ cursor.lexed_cursor(tokens: out.tokens, root_end: -1, closes: out.closes, swaps: out.swaps)
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    file(@c, @a, @decls, @uses, text)
    return Parsed(decls: decls, uses: uses, diagnostics: c.diagnostics, tree: a)

test "a constant is a name, a type and an indented value"
    text = "constant MAX: i64\n    64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    assert cursor.slice_of(text, p.decls[0].name) == "MAX"

    match p.decls[0].kind
        .constant_decl k =>
            assert !k.body.is_err()
            assert k.header.is_err()
            assert k.library.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => assert false

test "a signature without an arrow gets a unit result, synthesised"
    text = "function f()\n    return\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1

    match p.decls[0].kind
        .function_decl fd =>
            assert !fd.value.is_extern
            assert fd.value.params.len() == 0
            assert p.tree.types[fd.value.result].kind == .unit
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

test "record and variant own their members directly"
    text = "record Point\n    x: i64\n    y: i64\n\nvariant Token\n    num\n        v: i64\n    plus\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 2

    match p.decls[0].kind
        .record_decl r =>
            assert r.fields.len() == 2
            assert !r.partial
            assert r.tag.is_err()
        .constant_decl | .function_decl | .variant_decl | .test_decl => assert false

    match p.decls[1].kind
        .variant_decl v =>
            assert v.cases.len() == 2
            assert v.cases[0].fields.len() == 1
            assert v.cases[1].fields.len() == 0
        .constant_decl | .function_decl | .record_decl | .test_decl => assert false

test "a use line and a doc comment land where they belong"
    text = "use geom\n\n# the ceiling\nconstant MAX: i64\n    64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.uses.len() == 1
    assert cursor.slice_of(text, p.uses[0].name) == "geom"
    assert p.decls.len() == 1
    assert p.decls[0].doc.len() == 1
    assert cursor.slice_of(text, p.decls[0].doc[0]) == "# the ceiling"

test "the group is flattened here and only here"
    text = "extern \"m.h\" link \"m\"\n    function q(x: f64) -> f64\n    constant K: i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 2

    match p.decls[0].kind
        .function_decl fd =>
            assert fd.value.is_extern
            assert fd.value.body.is_err()
            assert cursor.slice_of(text, fd.value.header.must()) == "\"m.h\""

            match fd.value.library.must()
                .link l  => assert cursor.slice_of(text, l.name) == "\"m\""
                .package => assert false
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

    match p.decls[1].kind
        .constant_decl k =>
            assert k.body.is_err()
            assert !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => assert false

test "tag then partial, both contextual, both only in a group"
    text = "extern \"s.h\"\n    record FileStat tag stat partial\n        size: i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1

    match p.decls[0].kind
        .record_decl r =>
            assert r.partial
            assert cursor.slice_of(text, r.tag.must()) == "stat"
            assert !r.header.is_err()
        .constant_decl | .function_decl | .variant_decl | .test_decl => assert false

test "one bad declaration costs one diagnostic and never the next"
    text = "junk\nfunction f()\n    return\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "expected_declaration"
    assert p.decls.len() == 1
    assert cursor.slice_of(text, p.decls[0].name) == "f"

test "an extern body is named for what it is, and the member survives"
    text = "extern \"m.h\"\n    function q() -> i64\n        return 1\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "extern_has_body"
    assert p.decls.len() == 1

test "an absolute path in a group head is the machine's, not the program's"
    text = "extern \"/opt/x.h\"\n    function q() -> i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "machine_locked_path"
    assert p.decls.len() == 1

# Defect 146: the parser reads a foreign word as the swap the lexer wrote for
# the word's own file. It placed the word again itself, over the WHOLE
# compilation's text from its first byte, so a bracket the root left open,
# which the module's lexer never saw, made the module's `fn` no function to
# the parser: its brace habit went untold until the root's bracket was closed
# (measured on the trunk's compiler at `9d1c209d`).
test "a module's foreign head is read as its own lexer swapped it, past a bracket the root left open"
    inputs: [source.InputFile] = [
        source.user_file(name: "main.hero", text: "use b\n\nfunction main()\n    x = (1 + 2\n")
        source.user_file(name: "b.hero", text: "fn g() -> i64 {\n    return 1\n}\n")
    ]
    s = source.from_files(inputs)
    module = lexer.lex_files(s)[1]
    assert module.swaps.len() == 1
    c: cursor.Cursor @ cursor.lexed_cursor(
        tokens: module.tokens,
        root_end: -1,
        closes: module.closes,
        swaps: module.swaps
    )
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    file(@c, @a, @decls, @uses, s.text)
    assert decls.len() == 1
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "missing_body"

# Defect 146: a file of foreign heads has each word decided once, by its
# lexer, one swap per head, and the parser reads every head as the function
# the swap writes.
test "every foreign head is swapped once by the lexer and read as written by the parser"
    text = repeat("fn f() {\n}\n", 40)
    out = lexer.lex_one(text)
    assert out.swaps.len() == 40
    p = parse_source(text)
    assert p.decls.len() == 40
    assert p.diagnostics.len() == 40

    for d in p.diagnostics
        assert d.code == "missing_body"

# Defect 133. `parse_source` returns the PARSER's diagnostics, so each case
# counts what the construct itself costs beside the lexer's `reserved_word`.
test "a foreign word whose certain swap is a declaration's keyword opens that declaration"
    braced = parse_source("fn main() {\n    print(1)\n}\n")
    assert braced.diagnostics.len() >= 1
    assert braced.diagnostics[0].code == "missing_body"

    untyped = parse_source("const MAX = 5\n")
    assert untyped.diagnostics.len() == 1
    assert untyped.diagnostics[0].code == "expected_constant_type"

    # A correct rest is a whole declaration, and the one after it is untouched.
    text = "struct Point\n    x: i64\nenum Color\n    red\nimport geom\nfunction f()\n    return\n"
    whole = parse_source(text)
    assert whole.diagnostics.len() == 0
    assert whole.decls.len() == 3
    assert whole.uses.len() == 1
    assert cursor.slice_of(text, whole.decls[0].name) == "Point"
    assert cursor.slice_of(text, whole.decls[2].name) == "f"

    # And a group member reads the same way.
    member = parse_source("extern \"m.h\"\n    fn q(x: f64) -> f64\n    const K: i64\n")
    assert member.diagnostics.len() == 0
    assert member.decls.len() == 2

test "a swap is read only where its keyword is what the grammar expects"
    # `fn` as a NAME: the swap writes `function function(`, a new error of
    # the fix's own (defect 015's class), so it is not read and the lexer's
    # diagnostic stands alone.
    named = parse_source("function fn(x: i64)\n    return\n")
    assert named.diagnostics.len() == 0

    # Guidance is never read: `class` might be a record, and the parser does
    # not guess.
    guided = parse_source("class Point\n    x: i64\n")
    assert guided.diagnostics.len() == 0
    assert guided.decls.len() == 0

    # `enum` writes `variant`, which no group holds.
    grouped = parse_source("extern \"m.h\"\n    enum E\n")
    assert grouped.diagnostics.len() == 0

    # And a keyword with no name after it heads nothing, so `const` alone is
    # not read as a `constant` (defect 133's second round): the lexer's
    # message names the word and the name it owes, and the parser the value
    # the declaration its swap names owes below it (defect 133's last rows,
    # lane recovery-b7), with nothing standing there.
    bare = parse_source("const\n")
    assert bare.diagnostics.len() == 1
    assert bare.diagnostics[0].code == "missing_body"
    assert bare.decls.len() == 0
    valued = parse_source("const\n    5\n")
    assert valued.diagnostics.len() == 0

# Lane Y's finding, 2026-09-29 (defect 130's class): a head the lexer joined
# to a line at its margin that fails still owes its body, held back for the
# control arm, which reads the join as the program; a crossed line silences
# an absent body only inside brackets, where a head's recovery ran past it.
test "a head joined to a line that fails holds its missing body back"
    for text in ["function main()\n    if\n    print(1 +)\n", "function main()\n    for\n    x in )\n", "function main()\n    y = match\n    print(1 +)\n"]
        c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
        a: ast.Ast @ ast.new_ast()
        decls: [ast.Decl] @ []
        uses: [ast.Use] @ []
        file(@c, @a, @decls, @uses, text)
        assert c.held.len() == 1
        assert c.held[0].diagnostic.code == "missing_body" || c.held[0].diagnostic.code == "missing_match_arms"

    crossed = "function main()\n    if (1 > 0\n    y = 3 )\n"
    d: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(crossed).tokens)
    b: ast.Ast @ ast.new_ast()
    none: [ast.Decl] @ []
    nothing: [ast.Use] @ []
    file(@d, @b, @none, @nothing, crossed)
    assert d.held.len() == 0
