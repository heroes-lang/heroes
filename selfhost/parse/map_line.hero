# A map whose `{` the lexer closed with a closer of another kind further
# down, over a binding on a line below it (design.md §4.17; defect 304, the
# map's twin of defect 204's list). `x = {1: 2` over `print(x)` over `y = 3 )`
# read `print(x)` as a key with no `:` and `y` as one more, two messages that
# named no `{`, and the lines were never read as the statements they are. The
# list's reading is `parse/list_line.ended_at_a_binding`'s; a map's line
# holds its entry's `:`, so a line with none is no entry, and where a
# binding stands below it the map ended above it.
#
# | entry | called by |
# |---|---|
# | `ended_at_a_binding` | `grammar_expr.map_literal` |

use diag
use cursor
use text_lines
use pairing
use parse/unclosed
use parse/list_line
use parse/bracket_head

# Whether the map whose `{` is at `open` ends above its entry begun at token
# `first`, asked after the key where its `:` goes (`keyed`), else after the
# value: a binding or a mutation, `y = 3 )`, a declaration, `z: i64 @= 3 )`,
# or a line with no `:` over one of them further down. Told once, at the
# binding's `=` or `@`, naming the `{` and the openers it stands in on its
# line, and where their closers go; the cursor at the entry's line, which the
# statement reader reads with its own mistakes, the binding's stray closer
# among them. A map inside its entry that ended so is ended with it, its
# report naming this `{` (`list_line.ended_inside`).
function ended_at_a_binding(@c: cursor.Cursor, text: str, open: i64, first: i64, keyed: bool) -> bool
    if list_line.ended_inside(c, open: open, first: first)
        return true
    marked = cursor.at(c, .eq) || cursor.at(c, .at)

    if !marked && (!keyed || !cursor.at(c, .terminator))
        return false
    pair = pairing.paired_closer(c, text, open: open)

    if pair < 0 || c.tokens[pair].kind == .rbrace || !unclosed.a_line_below(c, text, open: open, at: first)
        return false
    mark: i64 @= c.pos

    if !marked
        mark @ binding_below(c, text, to: pair)

    if mark < 0
        return false
    told(@c, text, open: open, mark: mark)
    c.pos @ first
    return true

# The `=` or `@` of the first binding, mutation or declaration on a line below
# the cursor's, before the token `to`, or -1.
function binding_below(c: cursor.Cursor, text: str, to: i64) -> i64
    i: i64 @= c.pos

    while i < to
        if c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
            i @ i + 1
            continue
        mark = mark_on(c, text, from: i, to: to)

        if mark >= 0
            return mark

        while i < to && c.tokens[i].kind != .terminator
            i @ past_a_bracket(c, text, at: i, to: to)

    return -1

# The `=` or `@` of the line whose first token is at `from`, a name's binding
# or mutation, or a declaration's past its type, or -1.
function mark_on(c: cursor.Cursor, text: str, from: i64, to: i64) -> i64
    if c.tokens[from].kind != .ident
        return -1

    if c.tokens[from + 1].kind == .eq || c.tokens[from + 1].kind == .at || c.tokens[from + 1].kind == .at_eq
        return from + 1

    if c.tokens[from + 1].kind != .colon
        return -1
    i: i64 @= from + 2

    while i < to && c.tokens[i].kind != .terminator
        if c.tokens[i].kind == .eq || c.tokens[i].kind == .at || c.tokens[i].kind == .at_eq
            return i
        i @ past_a_bracket(c, text, at: i, to: to)

    return -1

# Past the token at `at`, or past the bracket it opens, to its closer.
function past_a_bracket(c: cursor.Cursor, text: str, at: i64, to: i64) -> i64
    k = c.tokens[at].kind

    if k != .lparen && k != .lbracket && k != .lbrace
        return at + 1
    pair = pairing.paired_closer(c, text, open: at)

    if pair < 0 || pair >= to
        return to
    return pair + 1

# The report at the binding's mark `mark`: where a key's `:` goes, where the
# name opens its line, else where the next entry's separator goes.
function told(@c: cursor.Cursor, text: str, open: i64, mark: i64)
    moved: cursor.Cursor @= c
    moved.pos @ mark
    named = text_lines.margin_width(text, at: c.tokens[mark - 1].span.start) >= 0
    code: str @= "expected_separator"
    what: str @= "`,` or a new line between one entry and the next"

    if named
        code @ "expected_map_entry_colon"
        what @ "`:` between a map's key and its value"
    report: diag.Diagnostic @= diag.new_diagnostic(
        code: code,
        message: "expected " + what + ", found " + cursor.found(moved, text) + " — a binding is no entry: the `{` still open " + text_lines.place_above(text, at: c.tokens[open].span.start, from: c.tokens[mark].span.start) + ", " + list_line.closing_above(c, text: text, open: open, own: "}"),
        span: c.tokens[mark].span
    )
    report.carries @ bracket_head.openers_around(c, text: text, open: open, own: "}", also_unclosed: true).carries
    cursor.say(@c, report)
