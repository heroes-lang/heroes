# What a statement's end owes the rest of its line and the block below it
# (design.md §4.17; defects 130 and 131, 2026-09-28 and -29).
#
# Every statement ends at its line end, consumed in one place,
# `grammar_expr.finish`, which asks this module what the end owes. The
# questions moved here out of `finish` on 2026-09-29 (lane X4), when
# `grammar_expr.hero` stood at its ceiling: none of them reads the grammar,
# and what hangs below the line is handed back for the grammar to read
# (`Below`).
#
# **A statement that failed has said what is wrong**: the rest of its line is
# debris, not a second mistake; the continuation that once cost three
# diagnostics for one is joined by the lexer since panel 181. **A block
# hanging below it is read, and named where the line can open none**
# (`orphan_below`, the recovery cluster's C4, 2026-10-02): `x = 3 )` over a
# deeper `y = 4` is two mistakes, and until then the second was told only
# once the `)` went, where after `x = 3` the same block is `unexpected_block`
# at once. A line that may be a misspelled head, a name and then a value,
# `iff x > 1` or `x = mtch n`, may open the block, which is read as its body
# and never named, as today. **Only its line** (defect 130):
# a statement that ended with its own block or line end has none left, and
# the line under the cursor, which the drop took, was the next statement's.
# **And not past braces closed on a line of their own** (lane X1's finding
# 4): in `}` over `x` the body in braces ended the statement, and `x` is
# where its line should end, where the `{`'s own report, the habit's, made
# the statement a failed one and `x` was dropped unsaid.
#
# A statement that did not fail ends where its line does, or the rest is
# `expected_end_of_line` unless the lexer spoke at that token, and the rest
# goes, a `{` that ends the line staying for the block below. What hangs
# below: under a line that said what is wrong, `iff x > 1` over its body or
# braces that end it, `loop {`, read and never named; under one only the
# lexer refused, the block is the rest of it (`f"a {` over `x}`), named and
# gone whole, unless it refused the line's first word, `elif x` or `fn
# inner()`: that block is the line's own, `grammar_expr.under`'s.
#
# **Past a refused word that heads a binding**, `let x = 5 )`, `const k =
# 7` in a body or `var y = {` over a map, the rest of the line is a
# statement, and it is handed back to be read as one (`rest`): until
# 2026-09-29 it went with the word, its own mistakes unsaid, and a map's
# entries were read as a body's lines.
#
# **A literal the lexer refused is still a value** (lane Y's finding,
# 2026-09-29). Its spelling is its one mistake, `0X10`, and its place is a
# value's: where the line's end goes, `x = 1 0X10`, the end is still owed
# (`parse/refused_literal`, whose question a member's line asks too). The
# line its certain fix writes, `0x10`, is refused for that `0x10`, which the
# first run hid, so a certain fix wrote a program with a mistake no run had
# told. Where an operand goes, `x = 0X10 + f(1) )`, the line was read past
# the literal here until 2026-09-30, when the expression reader came to read
# it as the literal it stands for, in brackets too (`grammar_expr.primary`);
# what is left here is one that never closed, taken as the line's last
# operand (`refused_operand`).

use cursor
use ast
use parse/brace_habit
use parse/headless
use parse/orphans
use parse/refused_heads
use parse/refused_literal
use parse/opening
use token

# What hangs below the line a statement ended on, for the grammar to read.
variant Below
    nothing
    # A block or braces below a line that said what is wrong: read
    # (`grammar_expr.hanging`), a block the line can open none of named first.
    read
    # The block below a line whose first word the lexer refused
    # (`grammar_expr.under`).
    refused
    # The rest of a line a refused word heads that binds, a statement past
    # the word, under the cursor (`grammar_expr.statement`).
    rest

# The end of the statement begun at token `from`, which refused something if
# `failed`: the rest of its line consumed, told where it is a mistake, and what
# hangs below it.
function close(@c: cursor.Cursor, text: str, from: i64, failed: bool) -> Below
    if failed && !brace_habit.after_a_close(c, text)
        a_closer_too_many(@c, text, from: from)
        brace_habit.drop_rest_of_line(@c, text, from: from)
        return hangs_below(@c, text, from: from)
    ended = c.pos > from && cursor.at_fresh_line(c)

    if ended || cursor.at(c, .dedent) || cursor.at(c, .eof) || cursor.eat(@c, .terminator)
        return .nothing
    said = !cursor.at_reported_error(c) || refused_literal.here(c, text)

    # A line a refused word heads that binds, `let x = 5 )` or `let m = {`
    # over a map's entries: past the word the rest is a statement, read as
    # one, its own mistakes told, where it was dropped with the word.
    if !said && c.pos == from && headless.refused_head(c, text, at: from) && refused_heads.binds(c, from: from)
        _ = cursor.bump(@c)
        return .rest

    if said
        cursor.error(
            @c,
            code: "expected_end_of_line",
            message: "expected the end of the line, found " + refused_literal.found(c, text) + " — one statement per line, no semicolons",
            span: cursor.current_span(c)
        )
    brace_habit.skip_line(@c, text)

    if !said && headless.refused_head(c, text, at: from)
        return .refused

    if said
        return hangs_below(@c, text, from: from)

    if brace_habit.opens_here(c, text)
        return .read

    # A block below a line the lexer refused past its head is the rest of
    # that line, `f"a {` over `x} b"`: named, and gone whole, its lines no
    # statements of their own.
    if cursor.at(c, .indent)
        orphans.named(@c)
        _ = cursor.balanced_block(@c)
    return .nothing

# A closer one too many on the rest of the failed line begun at token `from`,
# `x = f(0X10 + ) )`: past where the statement stopped, the first closer on
# its line that closes no opener of its kind the line opened, with no report
# standing on it, is a mistake of its own, told as past a statement that did
# not fail (the audit's row 130-28, lane recovery-b8): until 2026-10-02 it
# went with the debris, told only once the first mistake was repaired. A
# closer of another kind inside an opener is that list's junk, its own
# report's or none, so `[0X20, )]` keeps its `]`. **Only a closer the drop
# takes** (the round's gate of 2026-10-02, redoing `ce5caf89`): past a
# statement that ended with its own block, `k = match n` over a failed arm,
# the drop takes nothing and the line under the cursor is the next
# statement's, which tells its own `)`; read to its line end, the scan told
# that `)` a second time at the same column.
function a_closer_too_many(@c: cursor.Cursor, text: str, from: i64)
    dropped: cursor.Cursor @ c
    brace_habit.drop_rest_of_line(@dropped, text, from: from)
    open: [token.TokenKind] @ []
    i: i64 @ from

    while i < dropped.pos
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            open @ open.push(k)
        else if k == .rparen || k == .rbracket || k == .rbrace
            at: i64 @ open.len() - 1

            while at >= 0 && !pairs(opener: open[at], closer: k)
                at @ at - 1

            if at >= 0
                open @ open.slice(from: 0, to: at)
            else if open.len() == 0 && i >= c.pos && !told_at(c, at: i)
                cursor.error(
                    @c,
                    code: "expected_end_of_line",
                    message: "expected the end of the line, found `" + cursor.slice_of(text, c.tokens[i].span) + "` — one statement per line, no semicolons",
                    span: c.tokens[i].span
                )
                return
        i @ i + 1

# Whether the opener `opener` is closed by the closer `closer`.
function pairs(opener: token.TokenKind, closer: token.TokenKind) -> bool
    return opener == .lparen && closer == .rparen || opener == .lbracket && closer == .rbracket || opener == .lbrace && closer == .rbrace

# Whether a report stands on the token at `at`.
function told_at(c: cursor.Cursor, at: i64) -> bool
    for d in c.diagnostics
        if d.span.start == c.tokens[at].span.start
            return true

    return false

# What hangs below the line begun at token `from`, which said what is wrong:
# a block it can open none of is an orphan, named here (`parse/orphans`),
# and either is read by the grammar.
function hangs_below(@c: cursor.Cursor, text: str, from: i64) -> Below
    if cursor.at(c, .indent) && orphan_below(c, text, from: from) && !told_at_the_block(c, from: from)
        orphans.read(@c)

    if cursor.at(c, .indent) || brace_habit.opens_here(c, text)
        return .read
    return .nothing

# Whether the block under the cursor's indent, below the line begun at token
# `from`, is one that line can open none of. A line whose first word the
# lexer refused opens one where its word heads one (`parse/refused_heads`).
# A line that holds, at its own depth, a name and then a value no suffix of
# the name's joins to it may be a misspelled head, `iff x > 1`, `whlie x`,
# `x = mtch n`, and may open the block, as one with a keyword that heads a
# block does (`heads_a_block`). Any other line opens none: a binding, a
# mutation, a call, a `return` or an `assert` is one line.
function orphan_below(c: cursor.Cursor, text: str, from: i64) -> bool
    if c.tokens[from].kind == .error
        return !refused_heads.opens_a_block(c, text, at: from)
    depth: i64 @ 0
    i: i64 @ from

    while i < c.pos
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if depth == 0 && (heads_a_block(k) || k == .ident && worded(c, at: i))
            return false
        i @ i + 1

    return true

# Whether a keyword heads a block: a declaration's, `function inner()` in a
# body, which is told as a declaration in a body is, its body below it; or a
# control form's, whose own reader takes its block, here where its head failed.
function heads_a_block(kind: token.TokenKind) -> bool
    return match kind
        .kw_function | .kw_record | .kw_variant | .kw_constant | .kw_test | .kw_extern => true
        .kw_if | .kw_else | .kw_for | .kw_while | .kw_match                            => true
        .kw_use | .kw_in | .kw_return | .kw_break | .kw_continue | .kw_assert          => false
        .kw_true | .kw_false | .kw_nullptr | .kw_fail | .ident | .int_lit              => false
        .float_lit | .str_lit | .str_piece | .char_lit | .hole | .question             => false
        .eq | .at | .colon | .colon_colon | .comma | .dot | .arrow | .fat_arrow        => false
        .pipe | .lparen | .rparen | .lbracket | .rbracket | .lbrace | .rbrace          => false
        .plus | .minus | .star | .slash | .percent | .eq_eq | .bang_eq | .lt | .le     => false
        .gt | .ge | .and_and | .or_or | .bang | .amp | .caret | .tilde | .shl | .shr   => false
        .comment | .terminator | .indent | .dedent | .eof | .error                     => false

# Whether the statement begun at token `from` failed at the block under the
# cursor, `{` alone on its line over it: what it said is the block's report.
function told_at_the_block(c: cursor.Cursor, from: i64) -> bool
    at = cursor.current_span(c).start
    first = c.tokens[from].span.start
    i: i64 @ c.diagnostics.len() - 1

    while i >= 0 && c.diagnostics[i].span.start >= first
        if c.diagnostics[i].span.start == at
            return true
        i @ i - 1

    return false

# Whether the name at token `at` is followed, past comments, by a token that
# begins a value no suffix of the name's begins: not `(`, `[`, `.` or `-`.
function worded(c: cursor.Cursor, at: i64) -> bool
    j: i64 @ at + 1

    while j < c.pos && c.tokens[j].kind == .comment
        j @ j + 1

    if j >= c.pos
        return false
    then = c.tokens[j].kind
    return opening.begins_an_expression(then) && then != .lparen && then != .lbracket && then != .dot && then != .minus

# Whether the cursor stands on a refused literal the grammar asked an operand
# of and left there: an `error` expression at its span, built since the
# statement's first, `exprs`. Only one the lexer found never closed is left
# (`parse/refused_literal.closed`): it ran to its line's end, so it is the
# line's last operand and `grammar_expr.finish` takes it, where the line's end
# asked of it would be refused at the statement's own value.
function refused_operand(c: cursor.Cursor, a: ast.Ast, text: str, exprs: i64) -> bool
    if !refused_literal.here(c, text)
        return false
    here = cursor.current_span(c)
    i: i64 @ exprs

    while i < a.exprs.len()
        if a.exprs[i].kind == .error && a.exprs[i].span == here
            return true
        i @ i + 1

    return false
