# A function's signature: what follows its name up to its body (design.md
# §4.2, §4.12, §4.19; panels 109, 177).
#
# Moved out of `parse/tails.function_tail` on 2026-09-29 (lane X4, defect
# 130's class), when a second reader needed it: a block of declarations under
# a line whose head the lexer refused, `class Q` over `function f()`, is read
# as the declarations it holds (`parse/member_heads`), and a nested function's
# head is read as a top-level one is. The body is the caller's, which is what
# lets this be a leaf: it reads types, parameters and marks, and nothing that
# reads the grammar. A result written after `:` or `=>` is told here since
# 2026-09-30 (`arrow_habit`), where what follows the parameters is decided,
# its fix `certain` only where the head has a body below it or none is owed.

use token
use diag
use lexer
use cursor
use ast
use parse/type
use parse/line_end
use parse/brace_habit
use parse/opening
use parse/colon_habit
use parse/members as parse_members
use parse/marks as parse_marks

record Signature
    generics: [token.Span]
    params: [ast.Param]
    result: i64
    marks: parse_members.Marks
    # The signature's last token, `)` or the result's type or its last word,
    # kept for `fmt`: comments never reach the grammar, so one written between
    # two parameters is indistinguishable from the body's first comment unless
    # the tree says where the signature stops. Without this the printer
    # expelled it after the declaration, where it became the next member's doc
    # (defect 095) or, with nothing following, a file-level remark at exit 0.
    end: token.Span

# Generics, the parameters and the result after a function's name, or a
# failure where no `(` follows it, which `params` has reported.
function read(@c: cursor.Cursor, @a: ast.Ast, text: str, in_group: bool) -> Signature?
    generic_names = parse_members.generics(@c, text)

    if !cursor.at(c, .lparen)
        _ = parse_members.params(@c, @a, text, in_group: in_group)
        return fail(code: "expected_params", msg: "no `(` after the name")
    parameters = parse_members.params(@c, @a, text, in_group: in_group)

    # No `->` means no value. The `unit` node is synthesised at the end of the
    # header so later passes never have to ask whether the arrow was written
    # (§4.3: `()` is a type like any other).
    result: i64 @= 0

    # `-> cstr owned sqlite3_free`: the freer rides the RESULT and is read
    # right after its type, which is the only place it can be — a signature
    # with no arrow hands nothing back for anybody to free (§4.19, panel 109).
    # The five words come in any order (panel 177's landing, finding 1), and
    # `when` with no arrow before it is named as such (finding 2).
    marks: parse_members.Marks @= parse_members.no_marks()

    if cursor.eat(@c, .arrow) || arrow_habit(@c, @a, text, in_group: in_group)
        result @ type.parse_type(@c, @a, text)
        marks @ parse_members.read_marks(@c, text: text, in_group: in_group, on_result: true, holder: "the result")
    else
        here = cursor.current_span(c)
        result @ ast.push_type(
            @a.types,
            ast.TypeNode(kind: .unit, span: token.Span(start: here.start, end: here.start))
        )
        parse_marks.success_needs_result(@c, text, in_group: in_group)
    return ok(
        Signature(generics: generic_names, params: parameters, result: result, marks: marks, end: cursor.previous_significant_span(@c))
    )

# A result type written after `:`, the habit of TypeScript and Kotlin, or
# after `=>`, where this language writes `->` (defect 131's class, lane X3's
# report): `function f(): i64` was told only that its line should end at the
# `:`, never how a result is written. Where what follows reads as a result to
# the line's end, its marks, a body's `{` and a Python `:` aside, which a copy of the cursor
# and the tree tries (value semantics), the token is told once, with the
# certain fix that writes `->`, and passed, and the caller reads the result as
# after `->`. A Python one-line suite, `function f(): print(1)`, reads as no
# result and is left to its head, and so is a `:` that ends the line.
function arrow_habit(@c: cursor.Cursor, @a: ast.Ast, text: str, in_group: bool) -> bool
    if !cursor.at(c, .colon) && !cursor.at(c, .fat_arrow) || line_end.said_here(c)
        return false
    probe: cursor.Cursor @= c
    scratch: ast.Ast @= a
    said = probe.diagnostics.len()
    _ = cursor.bump(@probe)
    first = cursor.current_span(probe)

    if cursor.at(probe, .terminator) || cursor.at(probe, .indent) || brace_habit.opens_here(probe, text)
        return false
    _ = type.parse_type(@probe, @scratch, text)
    _ = parse_members.read_marks(@probe, text: text, in_group: in_group, on_result: true, holder: "the result")
    k = cursor.current_kind(probe)
    ends = k == .terminator || k == .indent || k == .dedent || k == .eof || brace_habit.opens_here(probe, text) || k == .colon && colon_habit.ends_its_line(probe)

    if probe.diagnostics.len() != said || !ends
        return false

    # The reading is `certain` only where it is the line's one: in an `extern`
    # group, where no signature has a body, or over a body below the head,
    # indented, tabbed or in braces. Over none, what follows is as likely the
    # body written on the head's line, Python's `pass` or an expression body,
    # `=> value` (defect 135's P8, lane recovery-b7): applied, `function
    # stub(): pass` became `-> pass`, refused anew for its missing body.
    certainty: diag.Certainty @= .guess
    tail: str @= ", and the body goes on the lines below the head, one level deeper"

    if in_group || brace_habit.ending(probe, text) >= 0 || opening.body_below(probe, text)
        certainty @ .certain
        tail @ ""
    written = cursor.current_span(c)
    shown = text.slice(from: first.start, to: cursor.previous_significant_span(@probe).end)
    fix: str @= "->"

    if written.start > 0 && text[written.start - 1] != ' '
        fix @ " " + fix

    if written.end < text.len() && text[written.end] != ' '
        fix @ fix + " "
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "expected_end_of_line",
        message: "expected `->` or the end of the line, found `" + cursor.slice_of(text, written) + "` — a `function`'s result type is written after `->`: `-> " + shown + "`" + tail,
        span: written
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write the result type after `->`", replacement: fix, span: written, certainty: certainty)
    )
    cursor.say(@c, d)
    _ = cursor.bump(@c)
    return true

## Tests

# A signature read from `text`, whose first two tokens are `function` and the
# name, and the cursor it leaves.
function read_of(text: str) -> cursor.Cursor
    c: cursor.Cursor @= cursor.new_cursor(lexer.lex_one(text).tokens)
    a: ast.Ast @= ast.new_ast()
    _ = cursor.bump(@c)
    _ = cursor.bump(@c)
    assert !read(@c, @a, text, in_group: false).is_err()
    return c

test "a result written after a colon or a fat arrow is told once, with the fix that writes the arrow"
    c = read_of("function f(): i64\n    return 1\n")
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "expected_end_of_line"
    assert c.diagnostics[0].fixes[0].certainty == .certain
    assert c.diagnostics[0].fixes[0].replacement == " ->"
    assert cursor.at(c, .terminator)
    assert read_of("function f() => [i64]\n").diagnostics[0].fixes[0].replacement == "->"

    # Certain only over a body, or in a group, where no signature has one
    # (defect 135's P8): over none, the word after the `:` may be the body.
    for text in ["function f(): i64 {\n", "function f(): i64\n{\n", "function f(): i64\n\treturn 1\n"]
        assert read_of(text).diagnostics[0].fixes[0].certainty == .certain

    for text in ["function stub(): pass\n", "function answer(value: i64) => value\n\nfunction main()\n", "function f(): i64\n"]
        assert read_of(text).diagnostics[0].fixes[0].certainty == .guess

    # A one-line suite reads as no result: the `:` is left to the head.
    d = read_of("function f(): print(1)\n")
    assert d.diagnostics.len() == 0
    assert cursor.at(d, .colon)
