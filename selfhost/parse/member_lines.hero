# A record's fields and a variant's cases, one member to a line (design.md
# §4.2, §4.15, §4.17).
#
# Moved out of `parse/members.hero` on 2026-09-30 (lane recovery-b1), when a
# member's line came to be judged at its end and that module stood at §11's
# 300. The two halves never met: a signature's generics, parameters and
# marks are `parse/signature.hero`'s, through `parse/members`, and the
# members below a head are `parse/members_below.hero`'s and
# `parse/headless.hero`'s, through this module.
#
# **A member's line ends after it** (defect 130's class, lane X4's finding
# n1). Until 2026-09-30 nothing asked, so a name after a member began the
# next one, and a wrong program compiled at exit 0: `dark grey` was two
# cases, `circle f64` a case named `f64` beside `circle`, `square side` over
# its fields gave them to `side`, and `x: i64 y: i64` was two fields. The
# junk after a case's name was refused as a missing name, *expected a case
# name, found `(`* for `circle(r: f64)`, whose name is there. What stands
# past a case's name or a field's type is now `expected_end_of_line`, once,
# unless a report stands on it already, a literal the lexer refused still
# owing it as a statement's line does (`parse/refused_literal`); the rest of
# the line goes, and a case's fields indented below it are still its own. A
# `:` that ends a case's line is the Python habit, `trailing_colon`, as it
# is after a record's head (`parse/colon_habit`).
#
# A leaf below the grammar: it reads the cursor, the types and the habits'
# leaves, and nothing that reads the parser.

use token
use cursor
use doc_comments
use ast
use lexer
use parse/type
use parse/line_end
use parse/colon_habit
use parse/refused_literal
use parse/brace_habit
use parse/braced_lines
use parse/unclosed

## Fields and cases

# One `name: type` per line: a record's fields, and a variant case's payload.
# Consumes the whole indent … dedent block.
function field_block(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Field]
    fields: [ast.Field] @ []
    _ = cursor.bump(@c)
    reading: bool @ true

    while reading
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)

        if k == .dedent
            _ = cursor.bump(@c)
            reading @ false
        else if k == .eof
            reading @ false
        else if k == .ident
            name = cursor.current_span(c)
            doc = doc_comments.take_docs(@c, text, name)
            _ = cursor.bump(@c)

            if !cursor.expect(@c, text: text, kind: .colon, code: "expected_field_type", what: "`:` and the field's type")
                cursor.skip_line(@c)
            else
                ty = type.parse_type(@c, @a, text)
                fields @ fields.push(ast.Field(name: name, ty: ty, doc: doc))
                line_ends(
                    @c,
                    text: text,
                    member: "the field `" + cursor.slice_of(text, name) + "`",
                    rule: "one field per line, `name: type`"
                )
        else if k == .indent
            if !cursor.at_reported_error(c)
                cursor.error(
                    @c,
                    code: "unexpected_block",
                    message: "a field takes no indented block — a field is one line, `name: type`",
                    span: cursor.current_span(c)
                )
            _ = cursor.balanced_block(@c)
        else
            if !cursor.at_reported_error(c) && !line_end.said_here(c)
                cursor.error(
                    @c,
                    code: "expected_field",
                    message: "expected a field name, found " + cursor.found(c, text) + " — one field per line, `name: type`",
                    span: cursor.current_span(c)
                )
            cursor.skip_line(@c)

    return fields

# The cases of a `variant`: a name on its own line, optionally followed by an
# indented field block, or by its fields in braces, on its line or alone on
# the line below it (`braced_fields`).
function case_block(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Case]
    cases: [ast.Case] @ []
    _ = cursor.bump(@c)
    reading: bool @ true

    while reading
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)

        if k == .dedent
            _ = cursor.bump(@c)
            reading @ false
        else if k == .eof
            reading @ false
        else if k == .ident
            name = cursor.current_span(c)
            doc = doc_comments.take_docs(@c, text, name)
            _ = cursor.bump(@c)
            colon_habit.eat(@c)
            which = "the case `" + cursor.slice_of(text, name) + "`"
            fields: [ast.Field] @ []

            if braces_close(c, text)
                told(@c, text: text, member: which, rule: CASE_RULE)
                fields @ braced_fields(@c, @a, text)
            line_ends(@c, text: text, member: which, rule: CASE_RULE)
            cursor.skip_terminators(@c)

            if cursor.at(c, .indent)
                for field in field_block(@c, @a, text)
                    fields @ fields.push(field)
            cases @ cases.push(ast.Case(name: name, fields: fields, doc: doc))
        else if k == .lbrace && cases.len() > 0 && brace_habit.alone(text, cursor.current_span(c)) && braces_close(c, text)
            # Allman's braces, alone on the line below a case: its fields,
            # told where the next case's name was owed and read as the case's.
            refused_case(@c, text)
            last = cases.len() - 1

            for field in braced_fields(@c, @a, text)
                cases[last].fields @ cases[last].fields.push(field)

            line_ends(
                @c,
                text: text,
                member: "the case `" + cursor.slice_of(text, cases[last].name) + "`",
                rule: CASE_RULE
            )
        else if k == .indent
            # The payload of a case whose NAME was refused on the line above.
            # The ident arm is the only one that consumes a payload block, so
            # when the name is not an identifier its block is still here — and
            # `skip_line` deliberately stops BEFORE an indent, which left this
            # loop spinning on the same token forever (fixedbugs, 2026-08-13).
            # Dropping it silently is recovery's own rule: one bad declaration
            # costs one diagnostic, and the case name already spent it.
            _ = cursor.balanced_block(@c)
        else
            refused_case(@c, text)
            cursor.skip_line(@c)

    return cases

# What a case's line is told where its name was owed and something else
# stands, where no report stands on it already.
function refused_case(@c: cursor.Cursor, text: str)
    if !cursor.at_reported_error(c) && !line_end.said_here(c)
        cursor.error(
            @c,
            code: "expected_case",
            message: "expected a case name, found " + cursor.found(c, text) + " — a variant case is a name on its own line, with its fields indented below it",
            span: cursor.current_span(c)
        )

## Members in braces

# A case's fields in braces, `circle {` over `r: f64` over `}` or `dot { x:
# f64 }` on one line (defect 130's class, lane X4's finding n2): until
# 2026-09-30 the `{` was refused as a missing case name and the fields went
# unread, their own mistakes unsaid, and the `}` below was refused again.
# The `{` is told once, as any junk past a case's name is, and the fields are
# read through the view `parse/braced_lines` lays out, as a record's in
# braces are; what stands past the `}` on its line is junk past the case.
# Braces the lexer found never closed are not read, since the view would
# reach the file's end (`parse/unclosed`).
function braces_close(c: cursor.Cursor, text: str) -> bool
    return cursor.at(c, .lbrace) && !unclosed.never_closed(c, text, open: c.pos)

# The fields in the braces the cursor's `{` opens, and the cursor past them.
function braced_fields(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Field]
    lines: cursor.Cursor @ braced_lines.laid_out(c, text)
    fields = field_block(@lines, @a, text)
    braced_lines.took(c: @c, view: lines)
    return fields

# The cases in the braces the cursor's `{` opens, a variant's written in
# braces, and the cursor past them.
function braced_cases(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Case]
    lines: cursor.Cursor @ braced_lines.laid_out(c, text)
    cases = case_block(@lines, @a, text)
    braced_lines.took(c: @c, view: lines)
    return cases

## A member's line ends after it

constant CASE_RULE: str
    "one case per line, its fields on the lines below it, one level deeper"

# The end of the line after `member`, a case's name or a field's type, or a
# case's braces: at a line end, a block below, the block's end or a fresh
# line past the braces, nothing; else the one report, and the rest of the
# line dropped, stopping before a block below it.
function line_ends(@c: cursor.Cursor, text: str, member: str, rule: str)
    k = cursor.current_kind(c)

    if k == .terminator || k == .indent || k == .dedent || k == .eof || cursor.at_fresh_line(c)
        return
    told(@c, text: text, member: member, rule: rule)
    cursor.skip_line(@c)

# `expected_end_of_line` at what stands past `member`, in `rule`'s words,
# where no report stands on it already: a literal the lexer refused still
# owes the line's end, as a statement's does.
function told(@c: cursor.Cursor, text: str, member: str, rule: str)
    if (!cursor.at_reported_error(c) || refused_literal.here(c, text)) && !line_end.said_here(c)
        cursor.error(
            @c,
            code: "expected_end_of_line",
            message: "expected the end of the line after " + member + ", found " + refused_literal.found(c, text) + " — " + rule,
            span: cursor.current_span(c)
        )

## Tests

function tok(kind: token.TokenKind, start: i64, end: i64) -> token.Token
    return token.Token(kind: kind, span: token.Span(start: start, end: end))

# The cursor at the indent that opens the block below a head's line, as the
# lexer cuts the text: the head's two words, then its line end.
function below_head(text: str) -> cursor.Cursor
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
    _ = cursor.bump(@c)
    _ = cursor.bump(@c)
    cursor.skip_terminators(@c)
    return c

test "a field is one line, and its doc comment is the run above it"
    # indent, "# doc", x: i64, dedent
    text = "# doc\nx: i64\n"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.comment, start: 0, end: 5)
        tok(.ident, start: 6, end: 7)
        tok(.colon, start: 7, end: 8)
        tok(.ident, start: 9, end: 12)
        tok(.terminator, start: 12, end: 12)
        tok(.dedent, start: 13, end: 13)
        tok(.eof, start: 13, end: 13)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    fields = field_block(@c, @a, text)
    assert fields.len() == 1
    assert fields[0].doc.len() == 1
    assert cursor.slice_of(text, fields[0].doc[0]) == "# doc"
    assert c.diagnostics.len() == 0

test "a field takes no indented block, and says so"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.ident, start: 0, end: 1)
        tok(.colon, start: 1, end: 2)
        tok(.ident, start: 3, end: 6)
        tok(.terminator, start: 6, end: 6)
        tok(.indent, start: 7, end: 7)
        tok(.ident, start: 7, end: 8)
        tok(.dedent, start: 9, end: 9)
        tok(.dedent, start: 9, end: 9)
        tok(.eof, start: 9, end: 9)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    fields = field_block(@c, @a, "x: i64\n    y\n")
    assert fields.len() == 1
    assert c.diagnostics[0].code == "unexpected_block"

test "a case is a name, and its fields are the block under it"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.ident, start: 0, end: 3)
        tok(.terminator, start: 3, end: 3)
        tok(.indent, start: 4, end: 4)
        tok(.ident, start: 4, end: 5)
        tok(.colon, start: 5, end: 6)
        tok(.ident, start: 7, end: 10)
        tok(.terminator, start: 10, end: 10)
        tok(.dedent, start: 11, end: 11)
        tok(.ident, start: 11, end: 15)
        tok(.terminator, start: 15, end: 15)
        tok(.dedent, start: 16, end: 16)
        tok(.eof, start: 16, end: 16)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, "num\n    v: i64\nplus\n")
    assert cases.len() == 2
    assert cases[0].fields.len() == 1
    assert cases[1].fields.len() == 0
    assert c.diagnostics.len() == 0

test "a refused case name does not spin the loop on its own payload"
    # This is the fixedbugs case of 2026-08-13, ported with it: `skip_line`
    # stops BEFORE an indent, so a payload block under a refused name used to
    # leave the loop reading the same token forever.
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.int_lit, start: 0, end: 1)
        tok(.terminator, start: 1, end: 1)
        tok(.indent, start: 2, end: 2)
        tok(.ident, start: 2, end: 3)
        tok(.dedent, start: 4, end: 4)
        tok(.dedent, start: 4, end: 4)
        tok(.eof, start: 4, end: 4)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, "1\n    x\n")
    assert cases.len() == 0
    assert c.diagnostics[0].code == "expected_case"
    assert c.diagnostics.len() == 1

test "a case's line ends after its name, and one report says what stands past it"
    # `dark grey` compiled as two cases until 2026-09-30, and `circle f64` as a
    # case named `f64`: the second name is the line's one mistake.
    for text in ["variant S\n    light\n    dark grey\n", "variant S\n    light\n    dark grey  # a note\n", "variant S\r\n    light\r\n    dark grey\r\n", "variant S\n    light\n    dark grey"]
        c: cursor.Cursor @ below_head(text)
        a: ast.Ast @ ast.new_ast()
        cases = case_block(@c, @a, text)
        assert cases.len() == 2
        assert c.diagnostics.len() == 1
        assert c.diagnostics[0].code == "expected_end_of_line"
        assert cursor.slice_of(text, c.diagnostics[0].span) == "grey"

    # The fields below a case whose line went on are still that case's.
    square = "variant S\n    square side\n        s: f64\n    dot\n"
    d: cursor.Cursor @ below_head(square)
    b: ast.Ast @ ast.new_ast()
    shapes = case_block(@d, @b, square)
    assert shapes.len() == 2
    assert cursor.slice_of(square, shapes[0].name) == "square"
    assert shapes[0].fields.len() == 1
    assert d.diagnostics.len() == 1

test "a field's line ends after its type, a report standing there already being the one"
    text = "record P\n    x: i64 y: i64\n    z: )\n    w: i64\n"
    c: cursor.Cursor @ below_head(text)
    a: ast.Ast @ ast.new_ast()
    fields = field_block(@c, @a, text)
    assert fields.len() == 3
    assert c.diagnostics.len() == 2
    assert c.diagnostics[0].code == "expected_end_of_line"
    assert cursor.slice_of(text, c.diagnostics[0].span) == "y"
    assert c.diagnostics[1].code == "expected_type"

test "a refused literal past a case still owes the line's end, and a colon ending it is the habit"
    # The lexer's own report on `0X10` is its spelling's; `dark 0x10`, what
    # its certain fix writes, is refused for the line end, so that is said now.
    text = "variant S\n    dark 0X10\n    grey:\n        r: i64\n"
    c: cursor.Cursor @ below_head(text)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, text)
    assert cases.len() == 2
    assert cases[1].fields.len() == 1
    assert c.diagnostics.len() == 2
    assert c.diagnostics[0].code == "expected_end_of_line"
    assert c.diagnostics[0].message == "expected the end of the line after the case `dark`, found a number (`0X10`) — one case per line, its fields on the lines below it, one level deeper"
    assert c.diagnostics[1].code == "trailing_colon"

test "a case's fields in braces are its own, and each brace is told once"
    # On the case's line or alone below it, Allman's style: the `{` is one
    # report, a field's mistake inside is its own, and no `}` is refused.
    text = "variant S\n    circle { r: f64, d f64 }\n    ring\n    {\n        w: f64\n    }\n    dot\n"
    c: cursor.Cursor @ below_head(text)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, text)
    assert cases.len() == 3
    assert cases[0].fields.len() == 1
    assert cases[1].fields.len() == 1
    assert cursor.slice_of(text, cases[1].fields[0].name) == "w"
    assert c.diagnostics.len() == 3
    assert c.diagnostics[0].code == "expected_end_of_line"
    assert c.diagnostics[1].code == "expected_field_type"
    assert c.diagnostics[2].code == "expected_case"
