# A value, then `@`, in an argument list: `f(a @n)` or `h(x: nullptr @n)`
# (design.md §4.8, §4.9, §4.17; defect 135's class, lane recovery-b3).
#
# The two rules compose one way round: `:` names the parameter, `@` marks the
# argument, `,` separates two, so a named mutable argument is `f(a: @n)`. A
# value and then `@` was met with `misplaced_mutable_marker` and the certain
# fix `: @`, which is the repair only where the value can be the name a `:`
# follows. Measured, it was right in no shape: `hints: nullptr @res` became
# `hints: nullptr : @res`, `g(1 @b)` became `g(1 : @b)`, both refused anew,
# and `g(a @b)` became `g(a: @b)` where the author had left the `,` out of
# `g(a, @b)` and meant `a` as a value, refused anew as `unused_binding`.
#
# | before the `@` | the readings | what is said |
# |---|---|---|
# | a bare name, unlabelled and unmarked | a misplaced marker, `a: @n`, or a `,` left out, `a, @n` | `misplaced_mutable_marker`, both fixes, each a guess (`misplaced`) |
# | anything else: a label before it, a literal, a call, a field, `@c` | a `,` left out | `expected_args_close`, the `,` a guess, the `@n` read as the next argument (`comma_missing`) |
#
# The comma is a guess even alone: the argument after it goes unlabelled,
# and where two parameters share a type every one is named, so `g(1, @b)`
# is refused anew as `needs_label`. Called by `grammar_expr.call_args`; a
# leaf that reads the tree and never parses.

use token
use diag
use ast
use cursor

# Whether the value before the `@` can be the name a `:` follows: a bare name,
# with no label of its own and no `@` of its own.
function a_name_before(a: ast.Ast, value: i64, labelled: bool, marked: bool) -> bool
    return !labelled && !marked && a.exprs[value].kind == .name

# `f(a @n)`, the `@` at the cursor: both readings said and offered, and the
# `@` passed over, the caller reading `n` as the argument `a` names.
function misplaced(@c: cursor.Cursor, value_end: i64)
    between = token.Span(start: value_end, end: cursor.current_span(c).end)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "misplaced_mutable_marker",
        message: "a value before `@` is a named mutable argument's name, `name: @value`, or an argument whose `,` was left out, `value, @name` — `:` names the parameter, `@` marks the argument",
        span: cursor.current_span(c)
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `: @` instead of `@`", replacement: ": @", span: between, certainty: .guess)
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `, @` instead of `@`", replacement: ", @", span: between, certainty: .guess)
    )
    cursor.say(@c, d)
    _ = cursor.bump(@c)

# `h(x: nullptr @n)`, the `@` at the cursor: the `,` left out said, and the
# `@` left where it stands, so the caller reads `@n` as the next argument.
function comma_missing(@c: cursor.Cursor, text: str, value_end: i64)
    between = token.Span(start: value_end, end: cursor.current_span(c).end)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "expected_args_close",
        message: "expected `)`, or `,` and another argument, found " + cursor.found(c, text),
        span: cursor.current_span(c)
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `, @` instead of `@`", replacement: ", @", span: between, certainty: .guess)
    )
    cursor.say(@c, d)
