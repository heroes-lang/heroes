# A bracket the lexer found never closed (design.md §4.17; defect 131's
# class, 2026-09-29).
#
# The lexer keeps every opener on one stack, any closer popping the last one,
# and at a file's end names each opener still on it: `unclosed_bracket`, `[`
# opened here is never closed. The parser, reading the same brackets, then
# met the place where the closer was owed and named it too: `n: [i64 @ [3]`
# cost `unclosed_bracket` and `expected_array_close`, one missing `]` and two
# messages, and `x = [1, 2` over `print(x)` read the lines below as elements
# and refused them, since past an opener that never closes the lexer reads
# every line inside it. So the parser asks the tokens the lexer's own
# question, by the lexer's own stack, and where no closer closes the opener it
# names no closer, recovers past none, and a literal ends at the line end
# where no `,` asks for more: the lexer's report is the mistake's one message.
# The lexer also names what is open where a declaration opens its line at
# column 0 (defect 130's class, 2026-09-30), and the parser asks the offsets
# it did so at, since a stray closer further down pops the same stack.
#
# A leaf: it reads the tokens and nothing that reads the parser.
#
# | entry | called by |
# |---|---|
# | `never_closed` | `grammar_expr.array_literal`, `grammar_expr.map_literal` |
# | `recover_past_pair` | the `end_` functions here, `parse/members.params`, `parse/type`'s function types |
# | `end_literal` | the same two |
# | `end_group`, `end_arguments`, `end_index` | `grammar_expr.group`, `grammar_expr.call_args`, `grammar_expr.postfix` |
# | `swallows_the_body`, `past_what_was_swallowed` | `parse/opening.body_follows`, `parse/braces.body_or_block` |
# | `withdrawn` | `parse.parse_source`, `parse.parse_bounded` |
# | `type_closer` | `parse/type`'s array, map and function types |

use token
use diag
use cursor
use parse/line_end
use literals
use lexer

# The index of the closer that closes the opener at token `open`, as the
# lexer's stack pairs them, whatever its kind, or -1 where none does: every
# opener pushed, every closer popping the last one, within the file the
# opener stands in. The author's text ends at `root_end`, where the lexer
# ended its file and named what was left open; and the lexer named every
# opener still open at a declaration opening its line at column 0
# (`cursor.Cursor.closes`), so a closer past one closes nothing before it. A
# literal that never closed took the closers on the rest of its line
# (`literals.closers_taken`), popped as the lexer popped them: an opener one
# of those closed has no closer the parser can take.
function paired_closer(c: cursor.Cursor, text: str, open: i64) -> i64
    depth: i64 @ 0
    i: i64 @ open
    bounded = c.root_end >= 0 && c.tokens[open].span.start < c.root_end
    closed = close_after(c, at: c.tokens[open].span.start)

    while c.tokens[i].kind != .eof && !(bounded && c.tokens[i].span.start >= c.root_end)
        if closed >= 0 && c.tokens[i].span.start >= closed
            return -1
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth - 1

            if depth == 0
                return i
        else if k == .error
            depth @ depth - literals.closers_taken(text, c.tokens[i].span)

            if depth <= 0
                return -1
        i @ i + 1

    return -1

# Whether no closer closes the opener at token `open` (`paired_closer`): one
# asked as never closed, which the parser names none of.
function never_closed(c: cursor.Cursor, text: str, open: i64) -> bool
    return paired_closer(c, text, open: open) < 0

# Past the closer the lexer's stack pairs with the opener at `open`, whatever
# its kind, where a construct's own closer was not met. Brackets are the one
# place where recovery has a landmark it cannot misread, and using it is what
# keeps a single misplaced separator in a signature from turning the rest of
# the line into declarations, four diagnostics for one mistake. The landmark
# is the lexer's: `print(2]`'s `]` is the one that closed its `(`, and a
# search for a `)` of the opener's own kind (`cursor.recover_past_closer`,
# gone with this) took the lines below into the bracket, the next statement
# and the next declaration, their own mistakes unsaid (defect 130's class,
# lane recovery-b3). Where none pairs with it, nothing is passed.
function recover_past_pair(@c: cursor.Cursor, text: str, open: i64)
    pair = paired_closer(c, text, open: open)

    while pair >= 0 && c.pos <= pair && !cursor.at(c, .eof)
        _ = cursor.bump(@c)

# The first offset past `at` where the lexer named the brackets still open,
# or -1 where it named none there.
function close_after(c: cursor.Cursor, at: i64) -> i64
    for close in c.closes
        if close > at
            return close

    return -1

## Where a construct the lexer named ends

# The index of the first token past the line ends and comments at the cursor.
function past_line_ends(c: cursor.Cursor) -> i64
    i: i64 @ c.pos

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    return i

# Whether a list the lexer named never closed ends at the line end the cursor
# stands on: no `,` goes on from it, a line end and the `,` after it being one
# separator in any list (panel 180 R1). The line end is left where it stands.
function ends_at_the_line(c: cursor.Cursor) -> bool
    return cursor.at(c, .terminator) && c.tokens[past_line_ends(c)].kind != .comma

# Where the lexer named the opener never closed, a construct ends at its line
# end, which it leaves for the statement, so nothing on the lines below glues
# to it; but a line below that begins with what would have gone on with it,
# `(total` over `+ fee`, is inside the same brackets, and that line end is
# refused as it is above a closer (`line_end.continued`, panel 180 R3), its
# line passed over. `holds` is the list the construct is, as
# `line_end.expect_closer` asks it.
function past_what_goes_on(@c: cursor.Cursor, text: str, holds: line_end.Holds)
    while cursor.at(c, .terminator)
        before = line_end.significant_before(c, at: c.pos)
        below: cursor.Cursor @ c
        below.pos @ past_line_ends(c)

        if !line_end.goes_on(below, text: text, holds: holds, before: before)
            return
        cursor.skip_terminators(@c)
        other = holds == .arguments && line_end.begins_a_value(cursor.current_kind(c))
        line_end.continued(@c, text: text, before: before, other: other)

        while !cursor.at(c, .terminator) && !cursor.at(c, .eof) && !cursor.at(c, .dedent)
            _ = cursor.bump(@c)

# Whether a head's line, from token `from` to the cursor, holds an opener the
# lexer named never closed, and the cursor stands on a line below still in
# that opener's reach: the lines the head's body would be, read inside the
# bracket and laid out as none, so their absence as a body is the opener's,
# which the lexer named (lane recovery-b2, U5). Where nothing is left in the
# reach, the body is missing as any is.
function swallows_the_body(c: cursor.Cursor, text: str, from: i64) -> bool
    open = head_opener(c, text, from: from)
    return open >= 0 && in_reach(c, open: open)

# The lines a declaration's head swallowed so (`swallows_the_body`), passed
# over to where the lexer named the opener, the next declaration's line or
# the file's end: they are no body, and read as the top level they would be
# each a declaration it is not.
function past_what_was_swallowed(@c: cursor.Cursor, text: str, from: i64)
    open = head_opener(c, text, from: from)

    if open < 0
        return

    while in_reach(c, open: open)
        _ = cursor.bump(@c)

# The first opener on a head's line, from token `from` to the cursor, that
# the lexer named never closed, or -1.
function head_opener(c: cursor.Cursor, text: str, from: i64) -> i64
    i: i64 @ from

    while i < c.pos
        k = c.tokens[i].kind

        if (k == .lparen || k == .lbracket || k == .lbrace) && never_closed(c, text, open: i)
            return i
        i @ i + 1

    return -1

# Whether the cursor stands inside the reach of the opener at `open`: before
# where the lexer named it, and inside the author's text.
function in_reach(c: cursor.Cursor, open: i64) -> bool
    ends = close_after(c, at: c.tokens[open].span.start)
    here = cursor.current_span(c).start
    return !cursor.at(c, .eof) && (ends < 0 || here < ends) && (c.root_end < 0 || here < c.root_end)

## Where a closer is owed

# A literal's closer at the cursor, the one its opener at `open` owes: taken,
# or named missing and the rest of the literal passed over to it; and nothing
# at all where the opener is never closed, whose closer the lexer named and
# which has none.
function end_literal(@c: cursor.Cursor, text: str, open: i64)
    if never_closed(c, text, open: open)
        past_what_goes_on(@c, text: text, holds: .elements)
        return
    what: str @ "`}` to close the map"
    code: str @ "expected_map_close"

    if c.tokens[open].kind == .lbracket
        what @ "`]` to close the list"
        code @ "expected_array_close"
    closer = closer_of(c.tokens[open].kind)

    if line_end.said_here(c) || !cursor.expect(@c, text: text, kind: closer, code: code, what: what)
        recover_past_pair(@c, text, open: open)

# A group's `)` at the cursor, after the line ends before it: taken, or named
# missing and recovered past; and where the lexer found its `(` never closed
# and named it, none is sought, and the group ends where its expression does.
function end_group(@c: cursor.Cursor, text: str, open: i64)
    if never_closed(c, text, open: open)
        past_what_goes_on(@c, text: text, holds: .one_value)
        return
    cursor.skip_terminators(@c)

    if !line_end.expect_closer(@c, text: text, holds: .one_value, kind: .rparen, code: "expected_group_close", what: "`)` to close the group")
        recover_past_pair(@c, text, open: open)

# The same for an argument list's `)`, which ends where the lexer named its
# `(` at the line end no `,` goes on from (`ends_at_the_line`), as a literal.
function end_arguments(@c: cursor.Cursor, text: str, open: i64)
    if never_closed(c, text, open: open)
        past_what_goes_on(@c, text: text, holds: .arguments)
        return
    cursor.skip_terminators(@c)

    if !line_end.expect_closer(@c, text: text, holds: .arguments, kind: .rparen, code: "expected_args_close", what: "`)`, or `,` and another argument")
        recover_past_pair(@c, text, open: open)

# The same for an index's `]`; the span the index ends at is returned, its
# last token's where the `[` is never closed.
function end_index(@c: cursor.Cursor, text: str, open: i64) -> token.Span
    if never_closed(c, text, open: open)
        close = cursor.previous_significant_span(c)
        past_what_goes_on(@c, text: text, holds: .one_value)
        return close
    cursor.skip_terminators(@c)
    close = cursor.current_span(c)
    _ = line_end.expect_closer(
        @c,
        text: text,
        holds: .one_value,
        kind: .rbracket,
        code: "expected_index_close",
        what: "`]` to close the index"
    )
    return close

# A type's closer at the cursor, after the line ends before it, the one its
# opener at `open` owes, taken as `line_end.expect_closer` takes it; the span
# the type ends at is returned. Where the opener is never closed nothing is
# named and no line end is crossed: the type ends at its last token.
function type_closer(@c: cursor.Cursor, text: str, open: i64) -> token.Span
    if never_closed(c, text, open: open)
        return cursor.previous_significant_span(c)
    kind = closer_of(c.tokens[open].kind)
    what: str @ "`)` to close the function type"
    code: str @ "expected_function_type_close"

    if kind == .rbracket
        what @ "`]` to close the array type"
        code @ "expected_array_close"
    else if kind == .rbrace
        what @ "`}` to close the map type"
        code @ "expected_map_close"
    cursor.skip_terminators(@c)
    close = cursor.current_span(c)
    _ = line_end.expect_closer(@c, text: text, holds: .one_type, kind: kind, code: code, what: what)
    return close

## Two reports at one `{`

# The lexer's reports without each `unclosed_bracket` at a `{` that a parser
# diagnostic in `said` stands on. The language writes a `{` only to open a map
# or a map type, so a `{` the parser speaks at is the brace habit,
# `record P {` or `function main() {`, whose one message says the braces go,
# and the `}` they are owed is no second mistake: `record P {` over its
# fields and nothing more cost `unclosed_bracket` and the habit's message at
# one token (defect 131's class, 2026-09-30). At a `(` or a `[` the parser's
# message may be another mistake, `function (a: i64` missing its name, and
# both stand.
function withdrawn(lexed: [diag.Diagnostic], said: [diag.Diagnostic], text: str) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @ []

    for d in lexed
        if !(d.code == "unclosed_bracket" && cursor.slice_of(text, d.span) == "{" && spoken_at(said, at: d.span.start))
            out @ out.push(d)

    return out

function spoken_at(said: [diag.Diagnostic], at: i64) -> bool
    for d in said
        if d.span.start == at
            return true

    return false

# The closer an opener owes.
function closer_of(opener: token.TokenKind) -> token.TokenKind
    if opener == .lbracket
        return .rbracket

    if opener == .lbrace
        return .rbrace
    return .rparen

## Tests

test "an opener is never closed where the lexer's stack leaves it open"
    text = "n: [i64 @ [3]\nm = (1 + [2, 3])\n"

    # `[` at 2 is left open, the one at 5 is closed by the `]` at 7, and the
    # `(` at 11 by its `)`, a `[` and its `]` between them.
    c = cursor.new_cursor(lexer.lex_one(text).tokens)
    assert never_closed(c, text, open: 2)
    assert !never_closed(c, text, open: 5)
    assert !never_closed(c, text, open: 11)

    # A stray closer of another kind pops the opener, as the lexer's does.
    stray = "x = [1, 2)\n"
    d = cursor.new_cursor(lexer.lex_one(stray).tokens)
    assert !never_closed(d, stray, open: 2)

test "an opener is never closed past the declaration the lexer named it at"
    text = "function f()\n    x = [1, 2\n\nfunction main()\n    print(1) )\n"
    out = lexer.lex_one(text)
    assert out.closes == [28]

    # The `[` at 8, and the stray `)` of `print(1) )` that the stack pairs
    # with it: past the close at 28 it closes nothing before it.
    told = cursor.lexed_cursor(tokens: out.tokens, root_end: -1, closes: out.closes)
    assert never_closed(told, text, open: 8)
    untold = cursor.new_cursor(out.tokens)
    assert !never_closed(untold, text, open: 8)

# Lane recovery-b2, U3: a literal that never closed took the closers on the
# rest of its line, and the lexer popped what they close; so does this, and
# a stray closer on the next line pairs with nothing before the literal.
test "an opener whose closer a literal that never closed took has no closer to take"
    text = "x = f(\"abc)\nprint(1) )\n"
    out = lexer.lex_one(text)
    assert out.diagnostics.len() == 1
    assert out.diagnostics[0].code == "unterminated_string"
    c = cursor.new_cursor(out.tokens)
    assert never_closed(c, text, open: 3)
    kept = "x = f(\"abc\n, 2)\n"
    k = cursor.new_cursor(lexer.lex_one(kept).tokens)
    assert !never_closed(k, kept, open: 3)

# Lane recovery-b3: the opener is recovered past the closer the lexer popped
# it at, `]` for `f(a b]`, and not past a `)` further down.
test "a closer of another kind is the one an opener is recovered past"
    text = "f(a b]\ny = 3 )\n"
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
    assert paired_closer(c, text, open: 1) == 4
    c.pos @ 3
    recover_past_pair(@c, text, open: 1)
    assert c.tokens[c.pos].kind == .terminator
    assert c.pos == 5
