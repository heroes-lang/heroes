# What sits *inside* a declaration: type parameters, value parameters, record
# fields, variant cases (design.md §4.2, §4.8, §4.12), and since 2026-09-25 the
# words after a parameter's or a result's type, read in one loop (`read_marks`).
# Port of archive/bootstrap-rs/heroes/src/syntax/members.rs.
#
# One rule explains most of this file: **the lexer keeps planting terminators
# inside brackets** (panel 007 — a line ending in a name can always be over,
# brackets or not), so every list here skips terminators where a separator may
# appear. That is what lets a long signature break across lines while `,` stays
# the separator.
#
# **This file is not in either knot** and ports as its own module: it calls
# `parse_type` and the cursor, and the declaration grammar calls it — one way,
# no ring (measurement 009 § the structural finding). `tails` reads a result's
# marks through it for the same one-way reason: it already uses this module.

use token
use cursor
use ast
use keywords
use lexer
use parse/marks as parse_marks
use parse/type
use parse/line_end

## Type parameters

# `function map<A, B>(…)` — type parameter names after the declared name, no
# constraints, never written at the call site (§4.12). Absent `<` means a
# non-generic function.
function generics(@c: cursor.Cursor, text: str) -> [token.Span]
    names: [token.Span] @ []

    if !cursor.eat(@c, .lt)
        return names
    reading: bool @ true

    while reading
        if !cursor.at(c, .ident)
            if !cursor.at_reported_error(c)
                cursor.error(
                    @c,
                    code: "expected_type_parameter",
                    message: "expected a type parameter name, found " + cursor.found(c, text) + " — generics carry no constraints, only names",
                    span: cursor.current_span(c)
                )
            reading @ false
        else
            names @ names.push(cursor.bump(@c).span)

            if !cursor.eat(@c, .comma)
                reading @ false

    _ = cursor.expect(
        @c,
        text: text,
        kind: .gt,
        code: "expected_generics_close",
        what: "`>` to close the type parameters"
    )
    return names

## Value parameters

# `(a: i64, @l: Lex)` — always parenthesised, `()` when empty. `in_group` is
# what lets `owned` be read after a parameter's type and nowhere else.
function params(@c: cursor.Cursor, @a: ast.Ast, text: str, in_group: bool) -> [ast.Param]
    out: [ast.Param] @ []

    if !cursor.expect(@c, text: text, kind: .lparen, code: "expected_params", what: "`(` — a signature always has a parameter list, `()` when it takes nothing")
        return out
    cursor.skip_terminators(@c)

    if cursor.eat(@c, .rparen)
        return out
    reading: bool @ true

    while reading
        cursor.skip_terminators(@c)
        mutable = cursor.eat(@c, .at)

        if !cursor.at(c, .ident)
            if !cursor.at_reported_error(c)
                cursor.error(
                    @c,
                    code: "expected_parameter",
                    message: "expected a parameter name, found " + cursor.found(c, text) + " — a parameter is `name: type`, or `@name: type` when the callee may change it",
                    span: cursor.current_span(c)
                )
            reading @ false
        else
            name = cursor.bump(@c).span

            if !line_end.expect_after(@c, text: text, kind: .colon, code: "expected_parameter_type", what: "`:` and the parameter's type — signatures are always explicit")
                reading @ false
            else
                ty = type.parse_type(@c, @a, text)

                # The words after the type, in whatever order they were
                # written: `buf: ptr counted_by n owned free` reads as the
                # header does, the extent beside the type and the ownership
                # after it, and that order is the PRINTER's (`spec § 13`'s
                # `CParam`), not the reader's.
                m = read_marks(
                    @c,
                    text: text,
                    in_group: in_group,
                    on_result: false,
                    holder: "`" + cursor.slice_of(text, name) + "`"
                )
                out @ out.push(
                    ast.Param(name: name, ty: ty, mutable: mutable, owned: m.owned, consumes: m.consumes, acquires: m.acquires, transfers: m.transfers, retains: m.retains, borrows: m.borrows, counted_by: m.counted_by, lent: m.lent)
                )
                cursor.skip_terminators(@c)

                if !cursor.eat(@c, .comma)
                    reading @ false

    cursor.skip_terminators(@c)

    if !line_end.expect_closer(@c, text: text, holds: .parameters, kind: .rparen, code: "expected_params_close", what: "`)`, or `,` and another parameter")
        # The signature's own closer is the landmark: resume just past it, so
        # the result type and the body are still read (one mistake, one
        # diagnostic).
        cursor.recover_past_closer(@c, opener: .lparen, closer: .rparen)
    return out

## The words after a type

# Every word one position can carry, as `read_marks` hands it back: a
# parameter's eight, or a result's five, in one record the callers copy into
# the tree. A `Span?` is the payload's span where the word carries one (the
# freer, the extent, the releaser set, the success value) and a `bool` where
# it is bare, exactly as `ast.Param` and `ast.FunctionDecl` keep them.
record Marks
    counted_by: token.Span?
    lent: bool
    owned: token.Span?
    consumes: bool
    transfers: token.Span?
    acquires: token.Span?
    retains: token.Span?
    borrows: bool
    when: token.Span?

function no_marks() -> Marks
    absent: token.Span? = fail(code: "absent", msg: "no mark")
    return Marks(
        counted_by: absent,
        lent: false,
        owned: absent,
        consumes: false,
        transfers: absent,
        acquires: absent,
        retains: absent,
        borrows: false,
        when: absent
    )

# The slot as it was if a first writing filled it, else what was read now: the
# FIRST writing of a word is the one kept, and the second is `repeated`.
function first_of(slot: token.Span?, got: token.Span?) -> token.Span?
    if slot.is_err()
        return got
    return slot

# The words after a parameter (`on_result` false) or after a result, whichever
# matches next until none does, each through its own reader in `parse/marks`.
# Until 2026-09-25 both callers read their words once each in the grammar's
# order, so `retains ob_put consumes` was a generic `)` error that named no
# rule while `consumes retains ob_put`, the same two words the other way
# round, reached the checker (panel 177's landing, finding 1). A word written
# twice is `repeated_mark`, at the second one, and the second's payload is
# consumed with it so no `)` or member error follows; two DIFFERENT words on
# one position both land in the record, and which of them to keep is the
# checker's `one_mark_per_position`. `holder` names the position in the
# message, the parameter or the result.
function read_marks(@c: cursor.Cursor, text: str, in_group: bool, on_result: bool, holder: str) -> Marks
    m: Marks @ no_marks()
    reading: bool @ in_group

    while reading
        if !cursor.at(c, .ident)
            reading @ false
            continue
        keyword = cursor.current_span(c)
        word = cursor.slice_of(text, keyword)
        again: bool @ false

        if word == keywords.WORD_COUNTED_BY && !on_result
            again @ !m.counted_by.is_err()
            m.counted_by @ first_of(slot: m.counted_by, got: parse_marks.counted_by_marker(@c, text, in_group: true))
        else if word == keywords.WORD_LENT && !on_result
            again @ m.lent
            m.lent @ parse_marks.bare_marker(@c, text: text, in_group: true, word: word)
        else if word == keywords.WORD_OWNED
            again @ !m.owned.is_err()
            m.owned @ first_of(slot: m.owned, got: parse_marks.owned_marker(@c, text, in_group: true))
        else if word == keywords.WORD_CONSUMES && !on_result
            again @ m.consumes
            m.consumes @ parse_marks.bare_marker(@c, text: text, in_group: true, word: word)
        else if word == keywords.WORD_TRANSFERS && !on_result
            again @ !m.transfers.is_err()
            m.transfers @ first_of(
                slot: m.transfers,
                got: parse_marks.named_marker(@c, text: text, in_group: true, word: word, example: "`val: Json transfers json_object_put`")
            )
        else if word == keywords.WORD_ACQUIRES
            again @ !m.acquires.is_err()
            m.acquires @ first_of(
                slot: m.acquires,
                got: parse_marks.named_marker(@c, text: text, in_group: true, word: word, example: "`-> Curl acquires curl_easy_cleanup`")
            )
        else if word == keywords.WORD_RETAINS
            again @ !m.retains.is_err()
            m.retains @ first_of(
                slot: m.retains,
                got: parse_marks.named_marker(@c, text: text, in_group: true, word: word, example: "`-> Json retains json_object_put`")
            )
        else if word == keywords.WORD_BORROWS
            again @ m.borrows
            m.borrows @ parse_marks.bare_marker(@c, text: text, in_group: true, word: word)
        else if word == keywords.WORD_WHEN && on_result
            again @ !m.when.is_err()
            m.when @ first_of(slot: m.when, got: parse_marks.when_marker(@c, text, in_group: true))
        else if word == keywords.WORD_WHEN
            parse_marks.success_on_parameter(@c)
        else
            reading @ false
            continue

        if again
            parse_marks.repeated(@c, word: word, holder: holder, at: keyword)

    return m

## Fields and cases

# One `name: type` per line: a record's fields, and a variant case's payload.
# Consumes the whole indent … dedent block.
function field_block(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Field]
    fields: [ast.Field] @ []
    _ = cursor.bump(@c)
    reading: bool @ true

    while reading
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)

        if k == .dedent
            _ = cursor.bump(@c)
            reading @ false
        else if k == .eof
            reading @ false
        else if k == .ident
            name = cursor.current_span(c)
            doc = cursor.take_docs(@c, text, name)
            _ = cursor.bump(@c)

            if !cursor.expect(@c, text: text, kind: .colon, code: "expected_field_type", what: "`:` and the field's type")
                cursor.skip_line(@c)
            else
                ty = type.parse_type(@c, @a, text)
                fields @ fields.push(ast.Field(name: name, ty: ty, doc: doc))
        else if k == .indent
            if !cursor.at_reported_error(c)
                cursor.error(
                    @c,
                    code: "unexpected_block",
                    message: "a field takes no indented block — a field is one line, `name: type`",
                    span: cursor.current_span(c)
                )
            _ = cursor.balanced_block(@c)
        else
            if !cursor.at_reported_error(c) && !line_end.said_here(c)
                cursor.error(
                    @c,
                    code: "expected_field",
                    message: "expected a field name, found " + cursor.found(c, text) + " — one field per line, `name: type`",
                    span: cursor.current_span(c)
                )
            cursor.skip_line(@c)

    return fields

# The cases of a `variant`: a name on its own line, optionally followed by an
# indented field block.
function case_block(@c: cursor.Cursor, @a: ast.Ast, text: str) -> [ast.Case]
    cases: [ast.Case] @ []
    _ = cursor.bump(@c)
    reading: bool @ true

    while reading
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)

        if k == .dedent
            _ = cursor.bump(@c)
            reading @ false
        else if k == .eof
            reading @ false
        else if k == .ident
            name = cursor.current_span(c)
            doc = cursor.take_docs(@c, text, name)
            _ = cursor.bump(@c)
            cursor.skip_terminators(@c)
            fields: [ast.Field] @ []

            if cursor.at(c, .indent)
                fields @ field_block(@c, @a, text)
            cases @ cases.push(ast.Case(name: name, fields: fields, doc: doc))
        else if k == .indent
            # The payload of a case whose NAME was refused on the line above.
            # The ident arm is the only one that consumes a payload block, so
            # when the name is not an identifier its block is still here — and
            # `skip_line` deliberately stops BEFORE an indent, which left this
            # loop spinning on the same token forever (fixedbugs, 2026-08-13).
            # Dropping it silently is recovery's own rule: one bad declaration
            # costs one diagnostic, and the case name already spent it.
            _ = cursor.balanced_block(@c)
        else
            if !cursor.at_reported_error(c) && !line_end.said_here(c)
                cursor.error(
                    @c,
                    code: "expected_case",
                    message: "expected a case name, found " + cursor.found(c, text) + " — a variant case is a name on its own line, with its fields indented below it",
                    span: cursor.current_span(c)
                )
            cursor.skip_line(@c)

    return cases

## Tests

function tok(kind: token.TokenKind, start: i64, end: i64) -> token.Token
    return token.Token(kind: kind, span: token.Span(start: start, end: end))

# The tokens of one line, as the lexer cuts them, for the mark tests: what is
# at issue there is which WORD comes next, and the lexer's cut is the fact.
function tokens_of(text: str) -> cursor.Cursor
    return cursor.new_cursor(lexer.lex_one(text).tokens)

test "generics are names and nothing else"
    stream: [token.Token] = [
        tok(.lt, start: 0, end: 1)
        tok(.ident, start: 1, end: 2)
        tok(.comma, start: 2, end: 3)
        tok(.ident, start: 4, end: 5)
        tok(.gt, start: 5, end: 6)
        tok(.eof, start: 6, end: 6)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    names = generics(@c, "<A, B>")
    assert names.len() == 2
    assert c.diagnostics.len() == 0

    # No `<` means no generics, and nothing is consumed.
    plain: [token.Token] = [tok(.lparen, start: 0, end: 1), tok(.eof, start: 1, end: 1)]
    d: cursor.Cursor @ cursor.new_cursor(plain)
    assert generics(@d, "(").len() == 0
    assert cursor.current_kind(d) == .lparen

test "a signature is always parenthesised, and @ marks in-out"
    # (a: i64, @l: Lex)
    stream: [token.Token] = [
        tok(.lparen, start: 0, end: 1)
        tok(.ident, start: 1, end: 2)
        tok(.colon, start: 2, end: 3)
        tok(.ident, start: 4, end: 7)
        tok(.comma, start: 7, end: 8)
        tok(.at, start: 9, end: 10)
        tok(.ident, start: 10, end: 11)
        tok(.colon, start: 11, end: 12)
        tok(.ident, start: 13, end: 16)
        tok(.rparen, start: 16, end: 17)
        tok(.eof, start: 17, end: 17)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    out = params(@c, @a, "(a: i64, @l: Lex)", in_group: false)
    assert out.len() == 2
    assert !out[0].mutable
    assert out[1].mutable
    assert c.diagnostics.len() == 0

test "an empty parameter list is () and not nothing"
    empty: [token.Token] = [tok(.lparen, start: 0, end: 1), tok(.rparen, start: 1, end: 2), tok(.eof, start: 2, end: 2)]
    c: cursor.Cursor @ cursor.new_cursor(empty)
    a: ast.Ast @ ast.new_ast()
    assert params(@c, @a, "()", in_group: false).len() == 0
    assert c.diagnostics.len() == 0

    # A missing `(` says so rather than guessing.
    missing: [token.Token] = [tok(.arrow, start: 0, end: 2), tok(.eof, start: 2, end: 2)]
    d: cursor.Cursor @ cursor.new_cursor(missing)
    b: ast.Ast @ ast.new_ast()
    _ = params(@d, @b, "->", in_group: false)
    assert d.diagnostics[0].code == "expected_params"

test "a signature may break across lines because the separator stays the comma"
    # (a: i64,
    #  b: i64)   — the lexer plants a terminator after the comma
    stream: [token.Token] = [
        tok(.lparen, start: 0, end: 1)
        tok(.ident, start: 1, end: 2)
        tok(.colon, start: 2, end: 3)
        tok(.ident, start: 4, end: 7)
        tok(.comma, start: 7, end: 8)
        tok(.terminator, start: 8, end: 8)
        tok(.ident, start: 9, end: 10)
        tok(.colon, start: 10, end: 11)
        tok(.ident, start: 12, end: 15)
        tok(.rparen, start: 15, end: 16)
        tok(.eof, start: 16, end: 16)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    assert params(@c, @a, "(a: i64,\nb: i64)", in_group: false).len() == 2
    assert c.diagnostics.len() == 0

test "the words are read in the order the author wrote them"
    # `retains ob_put consumes` was a generic `)` error until 2026-09-25 while
    # `consumes retains ob_put` reached the checker: the order is not a rule.
    text = "retains ob_put consumes"
    c: cursor.Cursor @ tokens_of(text)
    m = read_marks(@c, text: text, in_group: true, on_result: false, holder: "`o`")
    assert m.consumes
    assert cursor.slice_of(text, m.retains.must()) == "ob_put"
    assert c.diagnostics.len() == 0
    assert cursor.at(c, .terminator)

    # On a result, the clause before the mark it governs.
    result = "when 0 acquires ob_put"
    d: cursor.Cursor @ tokens_of(result)
    r = read_marks(@d, text: result, in_group: true, on_result: true, holder: "the result")
    assert cursor.slice_of(result, r.when.must()) == "0"
    assert cursor.slice_of(result, r.acquires.must()) == "ob_put"
    assert d.diagnostics.len() == 0

    # A parameter's word on a result is not read, and the loop stops there.
    stray = keywords.WORD_CONSUMES
    e: cursor.Cursor @ tokens_of(stray)
    n = read_marks(@e, text: stray, in_group: true, on_result: true, holder: "the result")
    assert !n.consumes
    assert cursor.at(e, .ident)

    # Outside a group nothing is read, and the words stay names.
    f: cursor.Cursor @ tokens_of(text)
    o = read_marks(@f, text: text, in_group: false, on_result: false, holder: "`o`")
    assert !o.consumes && o.retains.is_err()
    assert cursor.at(f, .ident)

test "a word written twice is repeated_mark at the second, and the first is kept"
    # Every word the position has, because the provoking case (`consumes
    # consumes`) is a witness and not the class: bare, named, freer, extent.
    for text in ["consumes consumes", "acquires a acquires b", "transfers a transfers b", "retains a retains b", "counted_by n counted_by m", "lent lent", "owned free owned free", "borrows borrows"]
        c: cursor.Cursor @ tokens_of(text)
        _ = read_marks(@c, text: text, in_group: true, on_result: false, holder: "`o`")
        assert c.diagnostics.len() == 1
        assert c.diagnostics[0].code == "repeated_mark"
        assert cursor.at(c, .terminator)

    text = "acquires a acquires b"
    c: cursor.Cursor @ tokens_of(text)
    m = read_marks(@c, text: text, in_group: true, on_result: false, holder: "`o`")
    assert cursor.slice_of(text, m.acquires.must()) == "a"
    assert c.diagnostics[0].span.start == 11

    # On a result: the clause twice, and two DIFFERENT words with no
    # diagnostic here, since that pair is the checker's.
    twice = "when 0 when 1"
    d: cursor.Cursor @ tokens_of(twice)
    r = read_marks(@d, text: twice, in_group: true, on_result: true, holder: "the result")
    assert cursor.slice_of(twice, r.when.must()) == "0"
    assert d.diagnostics[0].code == "repeated_mark"
    pair = "borrows acquires a"
    e: cursor.Cursor @ tokens_of(pair)
    p = read_marks(@e, text: pair, in_group: true, on_result: true, holder: "the result")
    assert p.borrows && !p.acquires.is_err()
    assert e.diagnostics.len() == 0

test "the success clause after a parameter is refused and the `)` survives"
    # Finding 5 through the loop: `consumes` is kept, the clause is refused at
    # its word, and the reader stands on the `)` afterwards.
    text = "consumes when 0)"
    c: cursor.Cursor @ tokens_of(text)
    m = read_marks(@c, text: text, in_group: true, on_result: false, holder: "`o`")
    assert m.consumes
    assert c.diagnostics.len() == 1
    assert c.diagnostics[0].code == "success_on_parameter"
    assert cursor.at(c, .rparen)

test "a field is one line, and its doc comment is the run above it"
    # indent, "# doc", x: i64, dedent
    text = "# doc\nx: i64\n"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.comment, start: 0, end: 5)
        tok(.ident, start: 6, end: 7)
        tok(.colon, start: 7, end: 8)
        tok(.ident, start: 9, end: 12)
        tok(.terminator, start: 12, end: 12)
        tok(.dedent, start: 13, end: 13)
        tok(.eof, start: 13, end: 13)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    fields = field_block(@c, @a, text)
    assert fields.len() == 1
    assert fields[0].doc.len() == 1
    assert cursor.slice_of(text, fields[0].doc[0]) == "# doc"
    assert c.diagnostics.len() == 0

test "a field takes no indented block, and says so"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.ident, start: 0, end: 1)
        tok(.colon, start: 1, end: 2)
        tok(.ident, start: 3, end: 6)
        tok(.terminator, start: 6, end: 6)
        tok(.indent, start: 7, end: 7)
        tok(.ident, start: 7, end: 8)
        tok(.dedent, start: 9, end: 9)
        tok(.dedent, start: 9, end: 9)
        tok(.eof, start: 9, end: 9)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    fields = field_block(@c, @a, "x: i64\n    y\n")
    assert fields.len() == 1
    assert c.diagnostics[0].code == "unexpected_block"

test "a case is a name, and its fields are the block under it"
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.ident, start: 0, end: 3)
        tok(.terminator, start: 3, end: 3)
        tok(.indent, start: 4, end: 4)
        tok(.ident, start: 4, end: 5)
        tok(.colon, start: 5, end: 6)
        tok(.ident, start: 7, end: 10)
        tok(.terminator, start: 10, end: 10)
        tok(.dedent, start: 11, end: 11)
        tok(.ident, start: 11, end: 15)
        tok(.terminator, start: 15, end: 15)
        tok(.dedent, start: 16, end: 16)
        tok(.eof, start: 16, end: 16)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, "num\n    v: i64\nplus\n")
    assert cases.len() == 2
    assert cases[0].fields.len() == 1
    assert cases[1].fields.len() == 0
    assert c.diagnostics.len() == 0

test "a refused case name does not spin the loop on its own payload"
    # This is the fixedbugs case of 2026-08-13, ported with it: `skip_line`
    # stops BEFORE an indent, so a payload block under a refused name used to
    # leave the loop reading the same token forever.
    stream: [token.Token] = [
        tok(.indent, start: 0, end: 0)
        tok(.int_lit, start: 0, end: 1)
        tok(.terminator, start: 1, end: 1)
        tok(.indent, start: 2, end: 2)
        tok(.ident, start: 2, end: 3)
        tok(.dedent, start: 4, end: 4)
        tok(.dedent, start: 4, end: 4)
        tok(.eof, start: 4, end: 4)
    ]
    c: cursor.Cursor @ cursor.new_cursor(stream)
    a: ast.Ast @ ast.new_ast()
    cases = case_block(@c, @a, "1\n    x\n")
    assert cases.len() == 0
    assert c.diagnostics[0].code == "expected_case"
    assert c.diagnostics.len() == 1
