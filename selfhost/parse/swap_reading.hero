# What a foreign word READS AS where the parser stands: the word of the
# language its certain swap writes (defect 133, design.md §4.17).
#
# `fn main() {`, `struct Point {` and `const MAX = 5` are each two mistakes, a
# word from another language and a shape this one refuses. Until 2026-09-29
# the parser met the refused word at the head of the line and dropped the
# declaration whole, so the second mistake was reported only after `check
# --apply` had written `function`, `record` or `constant`: two turns for one
# habit, where §4.17 asks for one. The parser now reads the construct as the
# swap writes it, and the `reserved_word` diagnostic and its `certain` fix are
# the lexer's, unchanged.
#
# **Only a CERTAIN swap is read, and only where the parser dispatches on the
# kind it writes.** A hint or guidance (`int(`, `let`, `class`) is never
# applied, so nothing may read it as written. And a caller asks for the one
# kind its position can hold: the top level asks for a declaration's keyword,
# an `extern` group for a member's, a type for `function` or a name. So a
# swap is read exactly where the word it writes is what the grammar expects,
# and a swap that would be wrong where it stands (`function fn(`, `record
# struct`, `const x = 5` in a body) is read nowhere and costs no second
# diagnostic. Those three are a certain fix that writes a new error, which is
# defect 015's class and not this one.
#
# **Since the second round, 2026-09-29, the swap is not even certain there**:
# `foreign_at` offers it as certain only where the word it writes is right
# in the place the word stands, and this module reads what `foreign_at`
# calls certain, so the reading and the fix cannot part. One reading goes
# past certainty, on purpose: a bare function type where a type goes,
# `g: fn(i64) -> i64`, is read as the type it means (`reads_as_function`),
# because its swap is withheld only for the parentheses it still wants.
#
# **The token stays `error`, and that is the design rather than a shortcut.**
# The other way, the lexer emitting the keyword's token for the word, was
# built and measured on 2026-09-29 and refused: every reader of the stream
# then saw a keyword in positions where the swap is wrong, and the three
# shapes above cost `expected_expression`, `expected_name`, and
# `continuation_outside_brackets` with `expected_name`, each quoting a word
# the author never wrote (`found \`constant\``). Here the layout that decides
# where a line ends, `fmt`, `probe` and the dumps see exactly the stream they
# saw before, and so does every `cursor.at_reported_error` guard but the four
# that stand past a declaration's line end, at the next line's first token:
# an empty `record`, `variant` or `extern` group and an absent body. Those
# ask `at_reported_error` below, which keeps its silence only on the head's
# own line, since the lexer's report on the next line's first token says
# nothing of the declaration above it.
#
# A leaf: it reads the cursor and the word tables, and nothing it calls reads
# the parser. Its callers: `parse/decl.hero` (`file`, `variant_declaration`),
# `parse/group.hero` (`extern_group`, `members`), `parse/records.hero`
# (`record_tail`), `parse/type.hero` (`prefix`, `unit_or_function`) and
# `parse/opening.hero` (`absent`).

use token
use bytes
use cursor
use keywords
use foreign_at
use word_place
use text_outline
use lexer

## Reading

# What the foreign word at `span` reads as: the certain swap the lexer wrote
# for it where it stands (`cursor.certain_swap`, `swap_words.hero`), and a
# failure for every token the tables do not refuse as foreign. Read from what
# the lexer kept rather than placed again (defect 146): the place was read
# from the text's first byte, and over the whole compilation's text, where
# the lexer reads one file's.
function swap_at(c: cursor.Cursor, text: str, span: token.Span) -> str?
    if !foreign_at.is_foreign(text, span)
        return fail(code: keywords.ERR_NOT_FOREIGN, msg: cursor.slice_of(text, span))

    if c.lexed
        return cursor.certain_swap(c, span)

    # A stream no lexer made (`cursor.Cursor.lexed`), a test's: the word is
    # placed in the text as the lexer places it, its outline read for the one
    # question.
    outline: text_outline.Outline @= text_outline.unread()
    return foreign_at.certain_swap(text, span, @outline)

# The kind the current token reads as: its own, or, for a foreign word whose
# certain swap is ONE keyword, that keyword's. `int` -> `i64` is a name and
# `elif` -> `else if` is two words, so both read as the `error` they are.
function reads_as(c: cursor.Cursor, text: str) -> token.TokenKind
    k = cursor.current_kind(c)

    if k != .error
        return k
    word = swap_at(c, text, cursor.current_span(c))

    if word.is_err()
        return k
    swapped = keywords.keyword(word.must())

    if swapped.is_err()
        return k
    return swapped.must()

# The kind a token that OPENS ITS LINE reads as: `reads_as` where the cursor
# stands at a line's start, and the token's own kind anywhere else. A
# declaration's keyword opens its line, so a dispatcher that lands in the
# middle of one, past a construct that failed and left its line, is looking
# at junk, which a swap would turn into a second declaration: `extern "m.h"
# fn` read `fn` as a function with no name (defect 133).
function opens_line_as(c: cursor.Cursor, text: str) -> token.TokenKind
    if !cursor.at_fresh_line(c)
        return cursor.current_kind(c)
    return reads_as(c, text)

# `cursor.at_reported_error`, for a guard that has crossed its declaration's
# line end. There the cursor stands on the NEXT line's first token, and the
# lexer's report on that token is about that token: it says nothing of the
# record with no fields, the variant with no cases, the group with no
# members or the head with no body above it, which are mistakes of their
# own. So such a guard keeps its silence only on the head's own line, where
# the refused word is junk the lexer has reported (`function f() fn`). Until
# 2026-09-29 it kept it at every `error` token: `record P` over `class Q`,
# `let x` or `€` was never told it was empty, before or after `--apply`
# (defect 130's class), and a swap the parser reads as its keyword spoke
# only because the swap made it a keyword (defect 133).
#
# "The head's own line" is the text's: the token stands in the middle of the
# line it is on, which a line the lexer joined onto the head's still is.
function at_reported_error(c: cursor.Cursor, text: str) -> bool
    if !cursor.at(c, .error)
        return false
    here = cursor.current_span(c).start
    return !word_place.only_margin(text, from: word_place.line_start(text, at: here), to: here)

# `cursor.found`, for a word or a character the lexer refused: as WRITTEN,
# `fn`, `class` or `€`, which the author can find, rather than *an
# unreadable token*, which it is not: the lexer read it, and said what it
# is. A longer refusal, a literal the lexer could not decode, keeps the
# cursor's words.
function found(c: cursor.Cursor, text: str) -> str
    if !cursor.at(c, .error)
        return cursor.found(c, text)
    span = cursor.current_span(c)
    one_character = bytes.char_at(text, span.start).len() == span.end - span.start

    if one_character || foreign_at.is_foreign(text, span)
        return "`" + cursor.slice_of(text, span) + "`"
    return cursor.found(c, text)

# Whether the current token opens a function type as its author meant it:
# `function`, or a foreign word whose swap is `function` in the table, where
# it stands or not. Asked only where a type goes (`type.prefix`), so that
# `g: fn(i64) -> i64`, whose swap is not certain there because the type
# still wants its parentheses, is read as the type it means and the
# signature goes on (defect 133's second round).
function reads_as_function(c: cursor.Cursor, text: str) -> bool
    if cursor.at(c, .kw_function)
        return true

    if !cursor.at(c, .error)
        return false
    span = cursor.current_span(c)
    called = span.end < text.len() && text[span.end] == '('
    entry = keywords.foreign_word(text: cursor.slice_of(text, span), called: called)

    if entry.is_err()
        return false

    return match entry.must().repair
        .swap fix => fix.word == "function"
        .hint _   => false
        .drop     => false
        .guidance => false

# Consume the current token when it reads as `kind`, as `cursor.eat` does
# when it IS that kind.
function eat_as(@c: cursor.Cursor, text: str, kind: token.TokenKind) -> bool
    if reads_as(c, text) != kind
        return false
    _ = cursor.bump(@c)
    return true

# Whether the current token is a foreign word whose certain swap is a NAME,
# `int` -> `i64` today: in a type's place it reads as the named type the
# swap writes, so a signature's result and a constant's type go on to their
# body. The node keeps the span of what was written, so a stage that read
# its text would read `int` and refuse it aloud; none does, because the
# `reserved_word` stops the compilation after the parse.
function reads_as_name(c: cursor.Cursor, text: str) -> bool
    if !cursor.at(c, .error)
        return false
    word = swap_at(c, text, cursor.current_span(c))

    if word.is_err()
        return false

    if !keywords.keyword(word.must()).is_err()
        return false
    return is_identifier(word.must())

# A word the lexer would read as one identifier: `else if` is not one.
function is_identifier(word: str) -> bool
    if word.len() == 0
        return false

    if !bytes.is_alpha(word[0]) && word[0] != '_'
        return false
    i: i64 @= 1

    while i < word.len()
        if !bytes.is_alnum(word[i]) && word[i] != '_'
            return false
        i @ i + 1

    return true

## Tests

# A cursor over `tokens`, told the swaps the lexer writes for `text`, which is
# what a stream the lexer made carries (`lexer.LexOutput.swaps`).
function told(tokens: [token.Token], text: str) -> cursor.Cursor
    none: [i64] = []
    return cursor.lexed_cursor(tokens: tokens, root_end: -1, closes: none, swaps: lexer.lex_one(text).swaps)

test "a certain swap to a keyword reads as that keyword, and nothing else does"
    text = "fn f\nrecord P struct\nlet\nx: int\nelif\nmain\n"
    tokens = [
        token.made(.error, start: 0, end: 2)
        token.made(.ident, start: 3, end: 4)
        token.made(.terminator, start: 4, end: 4)
        token.made(.kw_record, start: 5, end: 11)
        token.made(.ident, start: 12, end: 13)
        token.made(.error, start: 14, end: 20)
        token.made(.terminator, start: 20, end: 20)
        token.made(.error, start: 21, end: 24)
        token.made(.terminator, start: 24, end: 24)
        token.made(.ident, start: 25, end: 26)
        token.made(.colon, start: 26, end: 27)
        token.made(.error, start: 28, end: 31)
        token.made(.terminator, start: 31, end: 31)
        token.made(.error, start: 32, end: 36)
        token.made(.terminator, start: 36, end: 36)
        token.made(.ident, start: 37, end: 41)
        token.made(.terminator, start: 41, end: 41)
        token.made(.eof, start: 42, end: 42)
    ]
    c: cursor.Cursor @= told(tokens, text)

    # `fn` opens its line at the margin, where `function` is right.
    assert reads_as(c, text) == .kw_function
    assert opens_line_as(c, text) == .kw_function
    assert !reads_as_name(c, text)
    assert !at_reported_error(c, text)
    assert found(c, text) == "`fn`"

    # In the middle of a line `struct` is junk the lexer reported: `record`
    # is not right there, no dispatcher opens a declaration on it, and no
    # guard speaks over it.
    c.pos @ 5
    assert reads_as(c, text) == .error
    assert opens_line_as(c, text) == .error
    assert at_reported_error(c, text)

    # `let` is guidance and reads as the `error` it is, and a guard past a
    # line end speaks over it all the same, quoting it as written.
    c.pos @ 7
    assert reads_as(c, text) == .error
    assert !reads_as_name(c, text)
    assert !at_reported_error(c, text)
    assert found(c, text) == "`let`"

    # `int` in a type's place reads as a name and never as a keyword.
    c.pos @ 11
    assert reads_as(c, text) == .error
    assert reads_as_name(c, text)

    # `elif` at the margin continues no `if`, and it writes two words.
    c.pos @ 13
    assert reads_as(c, text) == .error
    assert !reads_as_name(c, text)

    # A plain name is its own kind.
    c.pos @ 15
    assert reads_as(c, text) == .ident
    assert !reads_as_name(c, text)

test "a bare function type reads as the type it means, certain or not"
    text = "g: fn(i64) -> i64"
    tokens = [
        token.made(.ident, start: 0, end: 1)
        token.made(.colon, start: 1, end: 2)
        token.made(.error, start: 3, end: 5)
        token.made(.eof, start: 17, end: 17)
    ]
    c: cursor.Cursor @= told(tokens, text)
    c.pos @ 2
    assert reads_as(c, text) == .error
    assert reads_as_function(c, text)

test "eat_as consumes only what reads as the kind asked for"
    text = "x: (fn(i64)"
    tokens = [
        token.made(.error, start: 4, end: 6)
        token.made(.lparen, start: 6, end: 7)
        token.made(.eof, start: 11, end: 11)
    ]
    c: cursor.Cursor @= told(tokens, text)
    assert !eat_as(@c, text, .kw_record)
    assert eat_as(@c, text, .kw_function)
    assert cursor.at(c, .lparen)

test "an identifier is one word"
    assert is_identifier("i64")
    assert is_identifier("_x1")
    assert !is_identifier("else if")
    assert !is_identifier("1x")
    assert !is_identifier("")
