# Arms written at their `match`'s own margin (design.md §4.7, §4.17; defect
# 131's class, 2026-09-29).
#
# A `match` owes its arms one level below it. Written at its own margin they
# cost `missing_match_arms` at the first, and then each was read as a
# statement and refused at its `=>`, `expected_end_of_line`: one mistake, one
# message more per arm, and every mistake inside the arms unreported. The
# lines below a `match` with no arms under it that begin at its margin and
# hold a `=>` outside brackets, or are an arm broken before its `=>`, or
# patterns alone over such a line, an arm broken inside its patterns, are its
# arms, misplaced: `missing_match_arms` is their one report, and they are
# read as arms (`grammar_expr.arms_of`).
#
# Two kinds of line are not taken, since they can be another `match`'s arms:
# the lines below a `match` that is an arm's value on that arm's line,
# `0 => match m`, and the lines past a dedent in a block that is a `match`'s
# arms. Nor are the lines below a `match` inside brackets, which have no margin.
#
# **Arms past the block the `match` ends** are its arms too, dedented a level
# too far, where the block they stand in is no `match`'s arms (lane X3,
# 2026-09-29): `if n > 0` over `match n` over `_ => print(1)` at the `if`'s
# margin cost `missing_match_arms` and then `expected_end_of_line` at the `=>`
# of each arm, read by the block around them as its statements. They are read
# as arms, on a copy of the cursor, since the dedents before them are the
# blocks' own, and to the block around them their lines are then the blank
# lines they are to it: their tokens become line ends (`taken`), no index
# moving, the blocks balanced, as a block's indent and dedent go together.
#
# | entry | called by |
# |---|---|
# | `below`, `past_the_block`, `taken` | `grammar_expr.match_expr` |
# | `end_here` | `grammar_expr.arms_of` |

use token
use cursor
use parse/broken_arm
use parse/swap_reading
use lexer

# Whether the line under the cursor begins at the margin of the `match` whose
# keyword is token `head`, holds an arm, and can be that `match`'s.
function below(c: cursor.Cursor, head: i64) -> bool
    return after_a_line_end(c) && holds_an_arm(c) && !an_arms_value(c, head) && !inside_a_bracket(c, head)

# Whether the arms read at a margin end at the cursor: at a dedent, which is
# the enclosing block's, or at a line that holds no arm. An indent below an
# arm and the stream's end are the arms loop's own to answer. `run` is the
# caller's, the line a run of patterns alone was last found to end at
# (`arm_at`), so that the lines of one run are walked once for the whole
# loop and not once for each of them.
function end_here(c: cursor.Cursor, @run: i64) -> bool
    k = cursor.current_kind(c)

    if k == .indent || k == .eof
        return false

    if k == .dedent
        return true

    if c.pos < run
        return false
    at = arm_at(c, from: c.pos)

    if at < 0
        return true
    run @ at
    return false

# Whether the token behind the cursor, past any comment line, is a line end
# that keeps the margin: a terminator, not an indent or a dedent.
function after_a_line_end(c: cursor.Cursor) -> bool
    i: i64 @ c.pos - 1

    while i > 0 && c.tokens[i].kind == .comment
        i @ i - 1

    return i >= 0 && c.tokens[i].kind == .terminator

# Whether the line under the cursor holds a `=>` outside brackets, or is an
# arm broken before its `=>`, whose next line begins with one
# (`parse/broken_arm`), or is an arm broken inside its patterns: patterns
# alone, over a line at its margin that holds an arm. `0` over `1 => 10` is
# the arm `0 | 1 => 10` with its `|` left out, the line the lexer reads apart
# where the author broke it before the `|` (`parse/apart`): read as a
# statement, the `0` cost the next line its `=>` too, a second message for
# the break the lexer had told (defect 132's class, lane recovery-b7).
function holds_an_arm(c: cursor.Cursor) -> bool
    return arm_at(c, from: c.pos) >= 0

# The first token of the line that holds an arm, the line whose first token
# is `from` or the one a run of lines of patterns alone from it ends at; -1
# where there is none. The run is walked in one loop, each line once: a file
# of such lines is no deeper a recursion than one.
function arm_at(c: cursor.Cursor, from: i64) -> i64
    at: i64 @ from

    while true
        one = read_line(c, from: at)

        if one.holds
            return at

        if !one.patterns || one.next < 0
            return -1
        at @ one.next

    return -1

# What the line whose first token is `from` is to the arms at a margin:
# whether it holds an arm by its own tokens, a `=>` outside brackets or one
# the next line begins with; whether it is patterns alone; and where the next
# line begins, past its line end and comment lines, or -1 where a block's
# edge or the stream's end ends it.
record ArmRead
    holds: bool
    patterns: bool
    next: i64

function read_line(c: cursor.Cursor, from: i64) -> ArmRead
    depth: i64 @ 0
    i: i64 @ from
    patterns: bool @ true

    while c.tokens[i].kind != .eof && !(depth == 0 && is_line_end(c.tokens[i].kind))
        k = c.tokens[i].kind
        patterns @ patterns && of_a_pattern(k)

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if k == .fat_arrow && depth == 0
            return ArmRead(holds: true, patterns: false, next: -1)
        i @ i + 1

    if broken_arm.arrow_below(c, end: i, past_a_dedent: false) >= 0
        return ArmRead(holds: true, patterns: false, next: -1)
    next: i64 @ -1

    if c.tokens[i].kind == .terminator
        next @ past_line_ends(c, from: i)
    return ArmRead(holds: false, patterns: patterns && i > from, next: next)

# A token spec § 8's `Pattern` is written with, or the `|` that joins two.
# ENUMERATED, so that a new kind is answered for here.
function of_a_pattern(k: token.TokenKind) -> bool
    return match k
        .dot | .ident | .minus | .int_lit | .str_lit | .char_lit | .pipe | .comment             => true
        .float_lit | .str_piece | .kw_constant | .kw_function | .kw_record | .kw_variant        => false
        .kw_match | .kw_if | .kw_else | .kw_for | .kw_while | .kw_in | .kw_break | .kw_continue => false
        .kw_return | .kw_test | .kw_assert | .kw_extern | .kw_nullptr | .kw_use | .kw_true      => false
        .kw_false | .kw_fail | .eq | .at | .colon | .colon_colon | .comma | .question | .arrow  => false
        .fat_arrow | .lparen | .rparen | .lbracket | .rbracket | .lbrace | .rbrace | .plus      => false
        .star | .slash | .percent | .eq_eq | .bang_eq | .lt | .le | .gt | .ge | .and_and        => false
        .or_or | .amp | .caret | .shl | .shr | .bang | .tilde | .hole | .terminator | .indent   => false
        .dedent | .eof | .error                                                                 => false

# The index of the first token past the line ends and comment lines at `from`.
function past_line_ends(c: cursor.Cursor, from: i64) -> i64
    i: i64 @ from

    while c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    return i

# Whether the `match` at token `head` is an arm's value: a `=>` stands before
# it on its line.
function an_arms_value(c: cursor.Cursor, head: i64) -> bool
    i: i64 @ head - 1

    while i >= 0 && !is_line_end(c.tokens[i].kind)
        if c.tokens[i].kind == .fat_arrow
            return true
        i @ i - 1

    return false

# Whether the `match` at token `head` stands inside a bracket not closed
# before it. The lexer plants line ends inside brackets and no margin, so no
# line below is at the `match`'s margin there: `f(match t` over its arms is
# refused as it stands (panel 180 R5's shape 74). The bracket may have opened
# on a line above, so the walk goes back to the block's edge, an indent or a
# dedent, which no bracket spans; it runs only where a `match` has no arms.
function inside_a_bracket(c: cursor.Cursor, head: i64) -> bool
    depth: i64 @ 0
    i: i64 @ head - 1

    while i >= 0 && c.tokens[i].kind != .indent && c.tokens[i].kind != .dedent
        k = c.tokens[i].kind

        if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth + 1
        else if (k == .lparen || k == .lbracket || k == .lbrace) && depth == 0
            return true
        else if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth - 1
        i @ i - 1

    return false

function is_line_end(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent

## Past the block

# Where the cursor stands on the dedent that ends the block whose last line is
# a `match` with no arms, and the line past it and past any more dedents holds
# an arm in a block that is no `match`'s arms: the index of that line's first
# token, where its arms are read; else -1.
function past_the_block(c: cursor.Cursor, text: str) -> i64
    if !cursor.at(c, .dedent)
        return -1
    i: i64 @ c.pos

    while c.tokens[i].kind == .dedent || c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment
        i @ i + 1

    if c.tokens[i].kind == .eof || in_arms(c, text, at: i) || !holds_an_arm(on(c, at: i))
        return -1
    return i

# The cursor `c`, standing on token `at`.
function on(c: cursor.Cursor, at: i64) -> cursor.Cursor
    moved: cursor.Cursor @ c
    moved.pos @ at
    return moved

# Whether the line whose first token is `at` stands in a block that is a
# `match`'s arms: the line that opens its block, found by walking back over
# the blocks closed before it, holds a `match` outside brackets, or a word
# whose certain swap is `match` (`switch`). At the top level it is none.
function in_arms(c: cursor.Cursor, text: str, at: i64) -> bool
    depth: i64 @ 0
    i: i64 @ at - 1

    while i >= 0
        k = c.tokens[i].kind

        if k == .dedent
            depth @ depth + 1
        else if k == .indent && depth == 0
            return opens_arms(c, text, indent: i)
        else if k == .indent
            depth @ depth - 1
        i @ i - 1

    return false

# Whether the line before the indent at `indent` holds a `match` outside
# brackets.
function opens_arms(c: cursor.Cursor, text: str, indent: i64) -> bool
    i: i64 @ indent - 1

    while i >= 0 && (c.tokens[i].kind == .terminator || c.tokens[i].kind == .comment)
        i @ i - 1

    while i >= 0 && !is_line_end(c.tokens[i].kind)
        if swap_reading.reads_as(on(c, at: i), text) == .kw_match
            return true
        i @ i - 1

    return false

# The arms read past the block by `lines`, a copy of `c` put on the token at
# `from`: their reports are `c`'s, and their lines, to the block around them,
# are blank, every token from `from` to where `lines` stopped a line end.
function taken(@c: cursor.Cursor, lines: cursor.Cursor, from: i64)
    c.diagnostics @ lines.diagnostics
    c.held @ lines.held
    i: i64 @ from

    while i < lines.pos && c.tokens[i].kind != .eof
        c.tokens[i] @ token.Token(kind: .terminator, span: c.tokens[i].span)
        i @ i + 1

## Tests

# The cursor on the first token of `text`'s second line, in the lexer's own
# stream, with the `match` keyword's index beside it.
record Placed
    c: cursor.Cursor
    head: i64

function on_the_second_line(text: str) -> Placed
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)
    head: i64 @ -1

    while !cursor.at(c, .terminator)
        if cursor.at(c, .kw_match)
            head @ c.pos
        _ = cursor.bump(@c)

    cursor.skip_terminators(@c)
    return Placed(c: c, head: head)

test "a line at a match's margin is its arm where it holds one and the match owns it"
    for text in ["match n\n_ => 1\n", "match n\n# the arms\n0 | 1 => 1\n", "match n\n0\n=> 1\n"]
        p = on_the_second_line(text)
        assert below(p.c, head: p.head)

    # No arm on the line, a `=>` inside brackets, a `match` that is an arm's
    # value, whose margin holds the enclosing `match`'s arms, and a `match`
    # inside a bracket, below which no line has a margin.
    for text in ["match n\nprint(1)\n", "match n\nf([x => 1])\n", "0 => match m\n_ => 5\n", "f(match t\n.a => 1)\n"]
        p = on_the_second_line(text)
        assert !below(p.c, head: p.head)

# Defect 132's last row: the line a break before a `|` leaves apart, `0` over
# `1 => 10`, is an arm broken inside its patterns, and so is a run of them;
# a run that ends at no arm, or at a line deeper than the margin, is none.
test "a line of patterns alone over an arm at the margin is an arm"
    for text in ["match n\n0\n1 => 1\n", "match n\n0\n# a note\n1\n.red r\n2 => 1\n", "match n\n-1\n_ => 1\n"]
        p = on_the_second_line(text)
        assert below(p.c, head: p.head)

    for text in ["match n\n0\n1\nprint(2)\n", "match n\n0\n    1 => 1\n", "match n\n0 + 1\n2 => 1\n", "match n\n1.5\n2 => 1\n"]
        p = on_the_second_line(text)
        assert !below(p.c, head: p.head)

test "the arms at a margin walk a run of patterns alone once, and end where it ends at no arm"
    text = "match n\n0\n1\n2 => 1\nprint(3)\n"
    p = on_the_second_line(text)
    run: i64 @ -1
    assert !end_here(p.c, @run)
    assert run > p.c.pos
    kept = run
    second = on(p.c, at: p.c.pos + 2)
    assert !end_here(second, @run)
    assert run == kept
    past = on(p.c, at: run + 4)
    assert cursor.at(past, .ident)
    assert end_here(past, @run)

# The cursor on the first dedent of `text`, in the lexer's own stream.
function on_the_dedent(text: str) -> cursor.Cursor
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)

    while !cursor.at(c, .dedent)
        _ = cursor.bump(@c)

    return c

test "arms past the block a match ends are its own where no match's arms hold them"
    # Past the `if`'s body, at the function's margin: the `match`'s arms.
    taken_text = "function f()\n    if c\n        match n\n    _ => 1\n"
    t = on_the_dedent(taken_text)
    assert past_the_block(t, taken_text) >= 0

    # Past an arm's block, at the enclosing `match`'s arms, and a line past
    # the block that holds no arm: not taken.
    for text in ["k = match m\n    0 =>\n        match n\n    1 => 5\n", "function f()\n    if c\n        match n\n    print(1)\n"]
        kept = on_the_dedent(text)
        assert past_the_block(kept, text) < 0
