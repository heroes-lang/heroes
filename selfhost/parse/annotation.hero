# An annotated binding, `v: i64 @ 0` or `xs: [i64] = []`, whose type failed
# (design.md §4.4, §4.5, §4.17; defect 131's class, 2026-09-29).
#
# `parse_type` leaves the token it could not read under the cursor, and the
# `@` or `=` owed after the type was then looked for at that same token and
# named missing too: `n: 2 @ 3` cost `expected_type` and
# `expected_binding_symbol` at the `2`, one mistake and two messages, and the
# value after the `@` was never read. Two rules now, each asked of what the
# type's parse left behind:
#
# - a type that refused leaves the annotation to resume at the `@` or `=`
#   its line holds after it, outside the brackets the type opened, so the
#   value is read and says its own mistakes;
# - the `@` or `=` is named missing only at a token no refusal of the type
#   stands on: `n: [2] 3` is `expected_type`, and `n: (2) 3`, whose type
#   read past its `)`, is `expected_function_type` and then the missing
#   symbol at the `3`, a second mistake.
#
# | entry | called by |
# |---|---|
# | `past_a_refused_type`, `no_binding_symbol` | `grammar_expr.annotated` |

use token
use cursor
use parse/opening
use lexer

# Where the type begun at `typed` refused, the cursor moves to the `@` or `=`
# its line holds after the type, if one stands there: what it passes is the
# type's, and the type's refusal already spoke of it.
function past_a_refused_type(@c: cursor.Cursor, typed: opening.Mark)
    if !opening.refused(c, typed)
        return
    at = symbol_after(c, from: typed.pos)

    while at >= 0 && c.pos < at
        _ = cursor.bump(@c)

# The index of the first `@` or `=` at or after the cursor that stands outside
# every bracket opened since token `from`, before that line ends; or -1. A
# type holds neither outside its brackets, so the first one is the
# annotation's.
function symbol_after(c: cursor.Cursor, from: i64) -> i64
    depth: i64 @ 0
    i: i64 @ from

    while !ends_the_line(c.tokens[i].kind, depth: depth)
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if depth == 0 && i >= c.pos && (k == .at || k == .eq)
            return i
        i @ i + 1

    return -1

# A line end outside brackets, the stream's end, or a block's edge, which no
# bracket spans.
function ends_the_line(kind: token.TokenKind, depth: i64) -> bool
    return kind == .eof || kind == .indent || kind == .dedent || kind == .terminator && depth == 0

# The `@` or `=` an annotation owes, named missing at the cursor, unless the
# lexer spoke there or the type begun at `typed` refused this very token.
function no_binding_symbol(@c: cursor.Cursor, text: str, typed: opening.Mark)
    if cursor.at_reported_error(c) || opening.refused_here(c, typed)
        return
    cursor.error(
        @c,
        code: "expected_binding_symbol",
        message: "expected `@` to declare a mutable, or `=` to bind, found " + cursor.found(c, text) + " — `v: i64 @ 0` declares a cell, `xs: [i64] = []` binds once",
        span: cursor.current_span(c)
    )

## Tests

# The `@` or `=` a refused type's annotation resumes at, in `text`'s own
# stream: the type begins at token 2, and the type's parse stopped at `stop`.
function resumes_at(text: str, stop: i64) -> i64
    c: cursor.Cursor @ cursor.new_cursor(lexer.lex_one(text).tokens)

    while c.pos < stop
        _ = cursor.bump(@c)

    return symbol_after(c, from: 2)

test "a refused type's annotation resumes at the symbol outside the type's brackets"
    # `n`, `:`, `[`, `2`: the type stopped at its refused `2`.
    assert resumes_at("n: [2] @ [3]\n", stop: 3) == 5
    assert resumes_at("n: {2: i64} = {}\n", stop: 3) == 7
    assert resumes_at("n: 2 = 3\n", stop: 2) == 3

    # None on the line, one inside the type's brackets, and one on the next line.
    assert resumes_at("n: [2] 3\n", stop: 3) == -1
    assert resumes_at("n: [2 = 3] 4\n", stop: 3) == -1
    assert resumes_at("n: 2\nm = 3\n", stop: 2) == -1
