# `@v = e`, a name written with a sigil (design.md §4.17: `@name` in prefix
# position is a syntax error, always; lane recovery-b4, the recovery
# instrument's `at-prefix`).
#
# Ruby writes a variable `@v`, and a Python decorator stands `@name` at a
# line's start. Here `@` follows the place a mutation writes, `v @ e`, and
# marks an argument lent to a mutable parameter, `f(@v)`: before a name
# anywhere else it is neither. At a statement's start it cost two messages at
# the one `@`, `expected_expression` and `not_a_place`, a value missing and a
# place refused; and where a block had just closed above it, the `@` was
# taken for the mutation of the statement that block ended, the message
# landing on that statement's `if` or `match`, off the line the mistake is on
# (`grammar_expr.expression_or_mutation` leaves such an `@` to the next
# statement now).
#
# **One message, at the `@`, and the line read as the statement it is with
# the sigil gone** (`Reading`), so that the rest of the line has its own
# mistakes told. The place after the `@`, a name with its fields and elements
# (spec § 5 Place), is walked on a copy of the cursor, and the token after it
# decides:
#
# | the line | read as | the fix: the `@` deleted, and |
# |---|---|---|
# | `@v = e`, `@p.x = e`, `@v @ e` | the mutation `v @ e` | `@` written for the `=`, `certain`: the one statement that writes a value into a name |
# | `@_ = e` | the discard `_ = e` | nothing more, `certain`: `_` is never a place |
# | `@v: T @ e` | the declaration | nothing more, `certain` |
# | `@v: T = e` | the declaration | nothing more, a `guess`: `v: T @ e` is as likely |
# | anything else: `@v`, `@v += 1`, `@f(x)` | the line as it stands | none: what the rest computes is the checker's to judge |
# | `@return 1`, `@for x in xs`: a statement's word | that statement | nothing more, `certain` (defect 179) |
#
# Before a statement's word the `@` was read as a value missing and then as a
# mutation's `@`, the word refused as its value: two messages, neither naming
# the sigil.
#
# **In a value the same habit reads as the name**, `x = @v` or Ruby's
# `@count = @count + 1`: the `@` is one more certain deletion of the report of
# the sigil before it on the same line, or told once where there is none.
#
# | entry | called by |
# |---|---|
# | `opens_a_line` | `grammar_expr.expression_or_mutation` |
# | `told` | `grammar_expr.prefixed` |
# | `in_value` | `grammar_expr.primary` |

use token
use diag
use ast
use cursor
use bytes
use text_lines
use parse/type

# How a line that a sigil before a name opens reads with the sigil gone: the
# words it is told with, its fix, and what `grammar_expr.prefixed` parses.
variant Reading
    mutation
    discard
    declaration
    value
    statement

# Does the token under the cursor, an `@`, stand before a name, alone or
# doubled, Ruby's class variable `@@v`?
function before_a_place(c: cursor.Cursor) -> bool
    n = sigils(c)
    return n > 0 && cursor.peek(c, n) == .ident

# Or, at a statement's start, before a statement's word, `@return 1`.
function opens_a_line(c: cursor.Cursor) -> bool
    return sigils(c) > 0

# How many `@` stand under the cursor before a name or a word that begins a
# statement, 0 where they stand before anything else.
function sigils(c: cursor.Cursor) -> i64
    n: i64 @ 0

    while cursor.peek(c, n) == .at
        n @ n + 1

    if n > 0 && (cursor.peek(c, n) == .ident || begins_a_statement(cursor.peek(c, n)))
        return n
    return 0

# The words a statement begins with that a sigil can stand before: no value
# begins with one but `if` and `match`, whose line is the statement too.
function begins_a_statement(k: token.TokenKind) -> bool
    return k == .kw_return || k == .kw_break || k == .kw_continue || k == .kw_assert || k == .kw_for || k == .kw_while || k == .kw_if || k == .kw_match

# The sigil under the cursor passed over, every `@` of it, and its span.
function passed(@c: cursor.Cursor) -> token.Span
    n = sigils(c)
    first = cursor.bump(@c).span
    last: token.Span @ first
    i: i64 @ 1

    while i < n
        last @ cursor.bump(@c).span
        i @ i + 1

    return token.Span(start: first.start, end: last.end)

# At the sigil under the cursor, before a name at a statement's start: the one
# message and its fixes, chosen by the line's reading, the sigil passed over,
# and the reading, which the caller parses the line by.
function told(@c: cursor.Cursor, text: str) -> Reading
    at = passed(@c)
    name = cursor.slice_of(text, cursor.current_span(c))
    after: cursor.Cursor @ cursor.trial(c)
    reading: Reading @ .statement

    if cursor.at(c, .ident)
        _ = cursor.bump(@after)
        reading @ past_the_place(@after, discarding: name == "_")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "expected_expression",
        message: "expected an expression, found `@` before `" + name + "` — " + words(reading, name),
        span: at
    )
    d.fixes @ fixes(reading, text, at: at, after: after)
    cursor.push_diagnostic(@c.diagnostics, d)
    return reading

# At the token after a sigil's name, on a copy of the cursor: the line's
# reading, the copy left at the token after the place. A `[` walks to its
# `]` on the same line, and an index broken across lines reads as `value`,
# the reading that offers nothing.
function past_the_place(@c: cursor.Cursor, discarding: bool) -> Reading
    if cursor.at(c, .colon)
        return .declaration
    walked: bool @ false
    walking: bool @ true

    while walking
        if cursor.at(c, .dot) && cursor.peek(c, 1) == .ident
            _ = cursor.bump(@c)
            _ = cursor.bump(@c)
            walked @ true
        else if cursor.at(c, .lbracket)
            past_the_index(@c)
            walked @ true
        else
            walking @ false

    if discarding && !walked && cursor.at(c, .eq)
        return .discard

    if !discarding && (cursor.at(c, .eq) || cursor.at(c, .at))
        return .mutation
    return .value

# At a `[`, the copy passed over its index to the `]` that closes it, stopping
# at the line's end where none does.
function past_the_index(@c: cursor.Cursor)
    depth: i64 @ 0
    going: bool @ true

    while going && !cursor.at(c, .eof) && !cursor.at(c, .terminator)
        k = cursor.bump(@c).kind

        if k == .lbracket || k == .lparen || k == .lbrace
            depth @ depth + 1
        else if k == .rbracket || k == .rparen || k == .rbrace
            depth @ depth - 1
        going @ depth > 0

# What a sigil's report says after the `@` it found, by its line's reading.
function words(reading: Reading, name: str) -> str
    return match reading
        .mutation => "a name is written bare, and a mutation writes it first and `@` after it: `" + name + " @ e`"
        .discard  => "`_` is written bare: `_ = e` discards a value on purpose"
        .declaration => "a name is declared bare, and `@` after its type makes the cell mutable: `" + name + ": <type> @ <value>`"
        .value => read_bare(name)
        .statement => "a statement begins with its word bare, `" + name + "`, and `@` before a name marks only an argument lent to a mutable parameter, `f(@x)`"

# The words of a sigil read as the name it stands before.
function read_bare(name: str) -> str
    return "a name is read bare, `" + name + "`, and `@` before one marks only an argument lent to a mutable parameter, `f(@" + name + ")`"

# The fixes of a sigil's report, by its line's reading; `after` stands at the
# token after the place, the `=` a mutation's second fix writes over.
function fixes(reading: Reading, text: str, at: token.Span, after: cursor.Cursor) -> [diag.Fix]
    found: [diag.Fix] @ []

    if reading == .value
        return found
    gone: diag.Fix @ deletion(text, at: at)

    if reading == .declaration && !a_cell(after, text)
        gone.certainty @ .guess
    found @ found.push(gone)

    if reading == .mutation && cursor.at(after, .eq)
        found @ found.push(
            diag.Fix(title: "write `@` for the `=`", replacement: "@", span: cursor.current_span(after), certainty: .certain)
        )
    return found

# Does the declaration at the `:` under the cursor write `@` after its type?
# The type is read on a copy, so its own mistakes are told once, by the
# declaration's parse.
function a_cell(c: cursor.Cursor, text: str) -> bool
    ahead: cursor.Cursor @ c
    scratch: ast.Ast @ ast.new_ast()
    _ = cursor.bump(@ahead)
    _ = type.parse_type(@ahead, @scratch, text)
    return cursor.at(ahead, .at)

# At an `@` before a name in a value: the `@` passed over, for the caller to
# read the name, and its deletion one more certain fix of the sigil's report
# before it on the same line, the statement's own or an earlier one in the
# value, or of its own where there is none. False, and nothing moved, before
# anything but a name.
function in_value(@c: cursor.Cursor, text: str) -> bool
    if !before_a_place(c)
        return false
    at = passed(@c)
    gone = deletion(text, at: at)
    last = c.diagnostics.len() - 1

    if last >= 0 && sigil(c.diagnostics[last], text) && text_lines.newlines_between(text, from: c.diagnostics[last].span.end, to: at.start) == 0
        c.diagnostics[last].fixes @ c.diagnostics[last].fixes.push(gone)
        return true
    name = cursor.slice_of(text, cursor.current_span(c))
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "expected_expression",
        message: "expected an expression, found `@` before `" + name + "` — " + read_bare(name),
        span: at
    )
    d.fixes @ d.fixes.push(gone)
    cursor.push_diagnostic(@c.diagnostics, d)
    return true

# Is `d` a sigil's report: its span `@` and nothing else, a name after it?
function sigil(d: diag.Diagnostic, text: str) -> bool
    s = d.span

    if d.code != "expected_expression" || s.end <= s.start
        return false
    i: i64 @ s.start

    while i < s.end
        if text[i] != '@'
            return false
        i @ i + 1

    while i < text.len() && text[i] == ' '
        i @ i + 1

    return i < text.len() && (bytes.is_alpha(text[i]) || text[i] == '_')

# The sigil at `at` deleted, and the spaces between it and the name.
function deletion(text: str, at: token.Span) -> diag.Fix
    end: i64 @ at.end

    while end < text.len() && text[end] == ' '
        end @ end + 1

    return diag.Fix(
        title: "delete the `@` before the name",
        replacement: "",
        span: token.Span(start: at.start, end: end),
        certainty: .certain
    )
