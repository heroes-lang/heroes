# Whether a line headed by a token the lexer refused opens a block (design.md
# §4.17; defect 130's class, 2026-09-29, lane X4).
#
# A block under a line whose first word the lexer refused is that line's body
# where the word opens one where it comes from: `elif x == 2` over its branch,
# `fn inner()` over its body, `struct P` over its fields, `const B: i64` over
# its value. It is read by the shape of its lines and never named
# (`parse/headless.read_below`). Where the word opens none, `let x = 5` or
# `import geom`, the block below is indented deeper than anything that opens
# one, a mistake of its own, and until 2026-09-29 it was read in silence: it
# is `unexpected_block`, and its lines are read (lane X1's finding 7).
#
# Two facts decide it, both about the line in hand:
#
# - **the word**, in the languages it comes from: a table of the words
#   `keywords.foreign_word` knows, since what `class` or `let` heads is a fact
#   about those languages and no token here says it;
# - **whether the line binds**: `const x = 5` and `int x = 5` bind a value
#   and open nothing, where `const B: i64` and `int main()` head a block. A
#   `=` at the line's own depth says so; `==` is another token.
#
# **The table is a premise about the world**, written as a claim: every word
# the registry refuses is in one of the two lists below. The test fails when
# a listed word leaves the registry; a word that joins it and is listed
# nowhere falls to the loud direction, its block named, which the first golden
# of the new word shows. A token the lexer refused that is no word, `€` or
# `0X10`, opens nothing. A head the PARSER refused, an identifier no
# declaration opens (`recrod Point`), may be a misspelling of anything, and
# opens a block.
#
# And what such a word declares, the declaration its swap names (`declares`),
# so that a word alone with nothing below it is told what it lacks there.

use token
use cursor
use keywords
use lexer

## The answer

# Whether the line whose head is the token at `at` opens the block below it.
function opens_a_block(c: cursor.Cursor, text: str, at: i64) -> bool
    t = c.tokens[at]

    if t.kind != .error
        return true
    return heads_a_block(text.slice(from: t.span.start, to: t.span.end)) && !binds(c, from: at)

# Whether a word the lexer refuses heads a block where it comes from.
function heads_a_block(word: str) -> bool
    return match word
        "struct" | "enum" | "union" | "class" | "fn" | "func" | "def"  => true
        "const" | "int" | "elif" | "switch" | "case" | "try" | "catch" => true
        "let" | "var" | "import" | "include" | "throw" | "raise"       => false
        "null" | "nil" | "None"                                        => false
        _                                                              => false

# Whether the line begun at token `from` holds a `=` outside its brackets.
function binds(c: cursor.Cursor, from: i64) -> bool
    depth: i64 @ 0
    i: i64 @ from + 1

    while i < c.tokens.len() && !ends_a_line(c.tokens[i].kind)
        k = c.tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if k == .eq && depth == 0
            return true
        i @ i + 1

    return false

function ends_a_line(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent || kind == .eof

## What a refused word declares

# The declaration's keyword the refused word `word` swaps for in the
# registry, `function` for `fn`, `constant` for `const`, `record` for
# `struct`, or a failure where it swaps for none of the four that owe a
# block. Asked of a word alone at the top of its line, whose swap is no
# certain one there, no name following it (`foreign_at.right_at`): what it
# owes below it is still the declaration's, a body, a value, fields or
# cases, and none standing there is a mistake of its own (defect 133's
# class, lane recovery-b7). The registry answers, so this keeps no table.
function declares(word: str) -> str?
    found = keywords.foreign_word(text: word, called: false)

    if found.is_err()
        return fail(code: "not_foreign", msg: word)

    return match found.must().repair
        .swap fix => if fix.word == "function" || fix.word == "constant" || fix.word == "record" || fix.word == "variant"
            ok(fix.word)
        else
            fail(code: "owes_no_block", msg: fix.word)
        .hint _   => fail(code: "owes_no_block", msg: word)
        .drop     => fail(code: "owes_no_block", msg: word)
        .guidance => fail(code: "owes_no_block", msg: word)

## Tests

function first_opens(text: str) -> bool
    return opens_a_block(cursor.new_cursor(lexer.lex_one(text).tokens), text, at: 0)

test "every word in the table is one the registry refuses"
    for word in ["struct", "enum", "union", "class", "fn", "func", "def", "const", "int", "elif", "switch", "case", "try", "catch", "let", "var", "import", "include", "throw", "raise", "null", "nil", "None"]
        assert !keywords.foreign_word(text: word, called: false).is_err()

test "a refused head opens a block where its word heads one and its line binds nothing"
    assert first_opens("fn inner()\n")
    assert first_opens("const B: i64\n")
    assert first_opens("int main()\n")
    assert first_opens("elif x == 2\n")
    assert !first_opens("let x = 5\n")
    assert !first_opens("import geom\n")
    assert !first_opens("const x = 5\n")

    # `==` is no binding, and a `=` inside brackets is a named argument's.
    assert first_opens("case f(x = 1)\n")

    # A head the parser refused may be a misspelling of anything.
    assert first_opens("recrod Point\n")

test "a refused word declares what its swap declares, where that owes a block"
    assert declares("fn").must() == "function"
    assert declares("def").must() == "function"
    assert declares("const").must() == "constant"
    assert declares("struct").must() == "record"
    assert declares("enum").must() == "variant"
    assert declares("import").is_err()
    assert declares("class").is_err()
    assert declares("let").is_err()
    assert declares("main").is_err()
