# The `extern` group: one head line, N members, and no trace of it
# afterwards (design.md §4.19, spec § 13 FFI; panels 036, 060, 061, 074).
# Port of `archive/bootstrap-rs/heroes/src/syntax/externs.rs` and
# `archive/bootstrap-rs/heroes/src/syntax/extern_members.rs`.
#
# **The group is flattened here and only here** (§4.19, panel 036). One
# `Decl` per signature, each carrying the head line's spans, because a
# declaration's index is identity for every later pass. Nothing after the
# parser knows the word "group".
#
# What the head line carries is a header name and, optionally, where the
# library lives — `link "sqlite3"` or `package "raylib"`, one of the two
# and never both. An absolute path in either is the machine's answer and
# not the program's, so it is refused with the span that wrote it; the head
# line's two strings are read in `parse/group_head.hero` (`machine_locked`).
#
# The members' tails are `parse/tails.hero`, shared with the ordinary
# declarations `parse/decl.hero` dispatches: a member differs from an
# ordinary declaration in its HEAD — no `function` keyword of its own to
# recover on, a group doc above it — and not in what follows its name.
# That shared module is also what lets this be a module at all: with the
# tails next door to the dispatcher, `file -> extern_group -> members ->
# function_tail` was a ring, and Heroes refuses module cycles.

use token
use diag
use cursor
use doc_comments
use ast
use parse/tails
use parse/records
use parse/swap_reading
use parse/opening
use parse/braced_lines
use parse/members_below
use parse/group_head
use parse/line_end

## The extern group

# ```
# extern "sqlite3.h" link "sqlite3"
#     function sqlite3_open(path: cstr, out: ptr) -> i64
# ```
#
# The head line names the header and, optionally, the library; the members
# are signatures with no bodies, because C provides the code (§4.19, panel
# 036).
#
# **The header is not optional, and that is the point of the form.** §4.19's
# whole mechanism is the `#include` — clang checking a signature against the
# real declaration — so a headerless `extern` would emit a prototype that is
# self-consistent by construction and verified by nothing. Panel 030 measured
# what that costs: `void *fopen(const char *, const char *)` links by
# accident on arm64, silently.
#
# `link` is matched as a word, not lexed as a keyword: reserving it would put
# it in the foreign-word registry, where §4.19's own open question already
# records that C headers use ordinary words as identifiers 571 times over.
function extern_group(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    keyword = cursor.current_span(c)
    doc = doc_comments.take_docs(@c, text, keyword)
    _ = cursor.bump(@c)
    h = group_head.header(@c, text)

    if h.is_err()
        return
    header = h.must()
    library = group_head.library_clause(@c, text)
    head = token.Span(start: keyword.start, end: cursor.previous_significant_span(@c).end)
    cursor.skip_terminators(@c)

    linkage: tails.Linkage = .from_c(header: header, library: library)

    # Past the line end, the next head is read as its swap (defect 133). Junk
    # on the head's own line over the signatures below is the one report, and
    # the signatures are read (defect 131's class, 2026-09-29): `extern "m.h"
    # )` cost `expected_extern_block` and `expected_declaration` at one `)`.
    # **So are signatures in braces**, through the view `parse/braced_lines`
    # lays out, where until that day they went whole, every mistake in them
    # unsaid (lane X1's finding 1).
    if !cursor.at(c, .indent)
        # At the head where its line goes on, as `empty_record` stands at its
        # head: what goes on is told on its own, the junk (defect 198) or a
        # word the lexer refused (defect 133's class, lane recovery-b7),
        # `extern "m.h" )` or `extern "m.h" fn` over nothing.
        at: token.Span @= cursor.current_span(c)

        if !cursor.at_fresh_line(c)
            at @ head
        empty = diag.new_diagnostic(
            code: "expected_extern_block",
            message: "an `extern` group's signatures are indented under it — `extern \"math.h\"` then `    function sqrt(x: f64) -> f64` (§4.19)",
            span: at
        )
        close = members_below.close_of(
            members_below.no_members_below(@c, text: text, head: head, members: "signatures", empty: empty)
        )

        if close >= 0
            lines: cursor.Cursor @= braced_lines.laid_out(c, text)
            members(@lines, @a, @decls, text, group_doc: doc, linkage: linkage)
            braced_lines.took(c: @c, view: lines)
            return

        if !cursor.at(c, .indent)
            return
    members(@c, @a, @decls, text, group_doc: doc, linkage: linkage)

## Inside the group

# The indented signatures. Every one becomes its own declaration carrying the
# group's header and link — the flattening panel 036 made a condition.
#
# Recovery here is `skip_line`, never `recover_to_next_decl`: inside a block,
# dropping "the rest of the declaration" would eat the members that follow,
# and `field_block` and `case_block` skip a line for the same reason.
#
# A member opened by `fn`, `struct` or `const` is read as the certain swap
# writes it, as at the top level (defect 133); `enum` writes `variant`, which
# no group holds, so it reads as nothing here and costs no second message.
function members(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, group_doc: [token.Span], linkage: tails.Linkage)
    _ = cursor.bump(@c)
    first: bool @= true
    done: bool @= false
    habit: i64 @= -1

    while !done
        cursor.skip_terminators(@c)
        k = swap_reading.opens_line_as(c, text)

        if k == .dedent
            _ = cursor.bump(@c)
            done @ true
        else if k == .eof
            done @ true
        else if k == .kw_record
            # **A `record` is a member like the other two** (panel 060). It
            # takes the group's doc on the first line exactly as they do.
            keyword = cursor.current_span(c)
            doc: [token.Span] @= group_doc

            if !first
                doc @ doc_comments.take_docs(@c, text, keyword)
            first @ false
            records.record_with_doc(@c, @a, @decls, text, doc: doc, linkage: linkage)
        else if k == .kw_function || k == .kw_constant
            is_constant = k == .kw_constant
            keyword = cursor.current_span(c)

            # The group's own doc comment documents its first signature; after
            # that each line takes its own, exactly as a record's fields do.
            doc: [token.Span] @= group_doc

            if !first
                doc @ doc_comments.take_docs(@c, text, keyword)
            first @ false
            _ = cursor.bump(@c)

            if !cursor.at(c, .ident)
                if !cursor.at_reported_error(c)
                    message: str @= "expected the C function's name, found " + cursor.found(c, text) + " — `function sqrt(x: f64) -> f64`"

                    if is_constant
                        message @ "expected the C constant's name, found " + cursor.found(c, text) + " — `constant SQLITE_OK: i64`"
                    cursor.error(@c, code: "expected_name", message: message, span: cursor.current_span(c))
                cursor.skip_line(@c)
                continue
            name = cursor.bump(@c).span

            if is_constant
                tails.constant_tail(
                    @c,
                    @a,
                    @decls,
                    text,
                    keyword: keyword,
                    doc: doc,
                    name: name,
                    linkage: linkage,
                    head: opening.mark(c)
                )
            else
                tails.function_tail(
                    @c,
                    @a,
                    @decls,
                    text,
                    keyword: keyword,
                    doc: doc,
                    name: name,
                    linkage: linkage,
                    head: opening.mark(c)
                )
        else if k == .comma && trailing(c)
            comma(@c, @habit)
        else
            member = member_of_the_line(c)

            if !cursor.at_reported_error(c)
                cursor.error(
                    @c,
                    code: "expected_extern_signature",
                    message: "expected a `function`, a `constant` or a `record`, found " + cursor.found(c, text) + " — an `extern` group holds what the header declares, one per line",
                    span: cursor.current_span(c)
                )

            # A block under the refused line is that line's, `enum Mode` over
            # its cases: it goes with it, and is never a member of its own
            # (defect 130's class, 2026-09-29). **Past a signature read whole
            # on the line, `function f() -> i64 )`, it is that member's body**,
            # named as under the same signature with nothing after it (lane
            # recovery-b8): until 2026-10-02 it went with the junk, unsaid.
            if cursor.at(c, .indent)
                _ = cursor.balanced_block(@c)
            else
                cursor.skip_line(@c)

                if cursor.at(c, .indent) && member != ""
                    tails.body_check(@c, member)
                else if cursor.at(c, .indent)
                    _ = cursor.balanced_block(@c)

# The member a line was read as before the cursor, which stands past its
# first token: `function` or `constant` where the line opens with that
# keyword or a word whose certain swap writes it, `fn q() -> i64 )`; and ""
# where the cursor opens its line or the line opens with anything else.
function member_of_the_line(c: cursor.Cursor) -> str
    i: i64 @= c.pos - 1

    while i >= 0 && !token.is_line_end(c.tokens[i].kind)
        i @ i - 1

    first: i64 @= i + 1

    while first < c.pos && c.tokens[first].kind == .comment
        first @ first + 1

    if first >= c.pos
        return ""
    t = c.tokens[first]

    if t.kind == .kw_function
        return "function"

    if t.kind == .kw_constant
        return "constant"
    swap = cursor.certain_swap(c, t.span)

    if t.kind == .error && !swap.is_err() && (swap.must() == "function" || swap.must() == "constant")
        return swap.must()
    return ""

# Is the `,` under the cursor the last token of its line?
function trailing(c: cursor.Cursor) -> bool
    k = cursor.peek(c, 1)
    return k == .terminator || k == .indent || k == .dedent || k == .eof

# A `,` that ends a member's line, the habit of a separator after every
# member: told at the group's first, `habit` then that report's index, and its
# deletion one more certain fix of it either way, as a record's fields are
# (defect 132's class, `parse/member_lines`); the `,` passed over. A report
# standing on it already is the signature's own, which it is left to.
function comma(@c: cursor.Cursor, @habit: i64)
    if line_end.said_here(c)
        _ = cursor.bump(@c)
        return
    at = cursor.current_span(c)
    gone = diag.Fix(
        title: "delete the `,`",
        replacement: "",
        span: token.Span(start: cursor.previous_significant_span(@c).end, end: at.end),
        certainty: .certain
    )

    if habit < 0
        cursor.error(
            @c,
            code: "expected_extern_signature",
            message: "expected a `function`, a `constant` or a `record`, found `,` — an `extern` group holds what the header declares, one per line, and no `,` ends a member's line",
            span: at
        )
        habit @ c.diagnostics.len() - 1
    c.diagnostics[habit].fixes @ c.diagnostics[habit].fixes.push(gone)
    _ = cursor.bump(@c)
