# `for` over what is not an iteration, and how sure its *use `while`* is
# (design.md §4.7, §4.17, CLAUDE.md § 8; defect 131's class, 2026-09-29).
#
# `for x in xs` iterates and `while c` loops on a condition (§4.7), so a
# condition after `for` is met with `for_missing_in` and the fix *use
# `while`*. A `certain` fix repairs what it names and writes a program whose
# parser says nothing new, and *use `while`* was certain wherever the token
# after `for` could begin an expression: C's `for (i = 0; i < 3; i++) {` got
# `while (i = 0; ...`, refused at its `=` as a group left open, and `for {`
# got `while {`, a map literal that refused the body inside it. The fix is
# certain now only where the `while` it writes is a loop, and that is asked
# of the `while` itself: the rest of the line is read as its condition, on a
# copy of the cursor without its reports, by `grammar_expr.for_stmt`, so the
# head's own report is said in place (defect 184), and the fix is certain where
# that reading refused nothing, held nothing back, and ended where the head's
# line ends or at a `{` that ends it, where a body begins; and where what it
# read is a `bool` by its shape (`a_condition`, defect 135), since a list, a
# string or a call is as likely the `for`'s own iterable, its `x in` left out.
#
# A name after `for` keeps the fix a guess whatever the reading says: `for x
# of xs`, a mangled iteration, reads as the condition `x`, and `while x`
# would not be what its author meant.
#
# **C's `do { ... } while (c)`** is one habit too, and its tail cost a second
# message: the braces after `do` are read as the block they stand for, their
# `{` named once (`parse/brace_habit`), and then `while (c)` after the `}` was
# a loop of its own with no body, `missing_body` found what came next. A
# `while` on the line of the `}` that closes such braces is their tail: its
# condition is read for its own mistakes, and where no body follows it, none
# is asked for (`do_tail`). Only where that `{` was named: no other `while`
# stands after a `}` on its line and reaches a statement's reader.
#
# A leaf: it reads the cursors and the text, and nothing of the parser.
#
# | entry | called by |
# |---|---|
# | `refuse` | `grammar_expr.for_stmt` |
# | `do_tail`, `passed_clauses` | `grammar_expr.while_stmt` |
# | `past_a_statement`, `under_a_do` | `parse/statement_end.close` |

use token
use diag
use cursor
use parse/brace_habit
use parse/opening
use parse/line_end
use laid_braces
use pairing
use text_lines
use operators
use lex_interp

# `for_missing_in` at the cursor, which stands where the loop variable
# should, with *use `while`* over `keyword`; `read` is the cursor after the
# rest was read as the `while`'s condition.
function refuse(@c: cursor.Cursor, text: str, keyword: token.Span, read: cursor.Cursor)
    certainty: diag.Certainty @= .guess

    if !cursor.at(c, .ident) && a_loop(c: c, text: text, read: read) && a_condition(c: c, text: text, read: read)
        certainty @ .certain
    header = c_header(c, text)
    rule: str @= "a loop over a condition is `while`"

    found: str @= cursor.found(c, text)

    if header
        rule @ "C's three-clause header is no loop here: count with `for i in range(from: a, to: b)`, and loop on a condition with `while`"

    # The bare header's `;`, which the lexer took with the rest of its line.
    if cursor.at(c, .error) && cursor.slice_of(text, cursor.current_span(c))[0] == ';'
        found @ "`;`"
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "for_missing_in",
        message: "`for` iterates — `for x in xs`; found " + found + " — " + rule,
        span: cursor.current_span(c)
    )

    if !header
        d.fixes @ d.fixes.push(
            diag.Fix(title: "use `while`", replacement: "while", span: keyword, certainty: certainty)
        )
    cursor.say(@c, d)

# Whether what stands at the cursor, to its line's end, is C's three-clause
# header, which no `while` writes: a `(` holding, in no bracket or hole of
# its own, a `;` the lexer left to this report, `(i = 0; i < n; i++)`, its
# every `;` once a message (defect 194); or the header written bare, whose
# first `;` the lexer took with the rest of its line (defect 301;
# `loop_headers.header_semicolon`); and one the lexer left in a bracket the `(`
# holds, a call or a list left open there (defect 366), never past an `in`,
# which makes the `(` an iteration's. Inside a `(` the lexer ends no line,
# so one never closed holds what stands before the first line end past it. A piece
# that ends no literal opens a hole, and one after a hole closes it: a `;` in
# a hole is the hole's, told by the lexer (defect 312).
function c_header(c: cursor.Cursor, text: str) -> bool
    depth: i64 @= 0
    holes: i64 @= 0
    inside: i64 @= 0
    i: i64 @= c.pos

    if cursor.at(c, .lparen)
        inside @ 1

    while !token.ends_a_line(c.tokens[i].kind)
        k = c.tokens[i].kind
        piece = cursor.slice_of(text, c.tokens[i].span)

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if token.is_closer(k)
            depth @ depth - 1

            if depth == 0 && inside == 1
                return false
        else if k == .str_piece
            if piece[0] == '}'
                holes @ holes - 1

            if !lex_interp.ends_closed(piece)
                holes @ holes + 1
        else if k == .kw_in && depth == inside
            return false
        else if (depth == inside || inside == 1 && depth > 1) && holes == 0 && k == .error && piece[0] == ';'
            return true
        i @ i + 1

    return false

# Past C's clauses in a `while`'s `(`, which the lexer told at their first
# `;` (`loop_headers.in_a_while`), to the line's end; false, the cursor unmoved,
# where the `(` holds none. Read as a condition, the init clause's `=` was a
# second message for the one habit (defect 365).
function passed_clauses(@c: cursor.Cursor, text: str) -> bool
    if !cursor.at(c, .lparen) || !c_header(c, text)
        return false

    while !token.ends_a_line(cursor.current_kind(c))
        _ = cursor.bump(@c)

    return true

# Whether `read`, the cursor `c` after the condition a `while` would read,
# read one: it moved, refused nothing, held nothing back, and stands where
# the head's line ends or on a `{` that ends it. `read` is a `cursor.trial`,
# so every report it holds is its own.
function a_loop(c: cursor.Cursor, text: str, read: cursor.Cursor) -> bool
    if read.pos == c.pos || cursor.refused_since(read, 0) || read.held.len() != c.held.len()
        return false
    k = cursor.current_kind(read)
    return k == .terminator || k == .indent || k == .dedent || k == .eof || brace_habit.opens_here(read, text)

# Whether what a `while` would read as its condition, the tokens from the
# cursor to `read`, is a `bool` by its shape: a comparison, `&&` or `||`
# outside every bracket of it, a `!` that begins it, or `true` or `false`
# alone, the parentheses around the whole of it set aside first. Any other
# shape is as likely what the `for` meant to iterate, its `x in` left out:
# `for [1, 2, 3]`, `for (xs)` and `for "abc".chars()` took a certain `while`
# that was refused anew as `not_bool` (the certain-fix audit's P4), and so did
# `for 3`, `for ("abc")` and `for {"a": 1}` beside them.
function a_condition(c: cursor.Cursor, text: str, read: cursor.Cursor) -> bool
    from: i64 @= c.pos
    to: i64 @= read.pos

    while to > from && (c.tokens[to - 1].kind == .comment || c.tokens[to - 1].kind == .terminator)
        to @ to - 1

    while to - from >= 2 && c.tokens[from].kind == .lparen && pairing.paired_closer(c, text, open: from) == to - 1
        from @ from + 1
        to @ to - 1

    if to - from == 1 && (c.tokens[from].kind == .kw_true || c.tokens[from].kind == .kw_false)
        return true
    depth: i64 @= 0

    for at in range(from: from, to: to)
        k = c.tokens[at].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth - 1
        else if depth == 0 && gives_a_bool(k)
            return true

    return to > from && c.tokens[from].kind == .bang

# The binary operators whose value is a `bool` (spec § 7): the six comparisons,
# `&&` and `||`, the eight loosest the language has (the test below).
function gives_a_bool(kind: token.TokenKind) -> bool
    return kind == .or_or || kind == .and_and || kind == .eq_eq || kind == .bang_eq || kind == .lt || kind == .le || kind == .gt || kind == .ge

## The tail of `do { ... } while (c)`

# How what stands past the statement begun at token `from` is told, its
# line's rule; but where the statement is `do` and the `{` under the cursor
# opens braces that close on a line a `while` goes on with, C's do-while,
# which no word here writes: told at that `{` for what it is, its one report,
# the tail then read by `do_tail`. It was told as a brace past a name, and
# its loop only once the braces went, `unexpected_block` and `missing_body`
# beside it (defect 201). And the same where the `while` begins the line
# below a `}` alone on its line, which is no token: past the block the
# lexer laid out below the `{` stands the `while` (defect 303).
function past_a_statement(c: cursor.Cursor, text: str, from: i64) -> str
    if c.pos == from + 1 && cursor.slice_of(text, c.tokens[from].span) == "do" && brace_habit.opens_here(c, text)
        close = brace_habit.closer(c, open: c.pos)

        if c.tokens[close].kind == .rbrace && c.tokens[close + 1].kind == .kw_while || c.tokens[close].kind == .kw_while
            return do_while()
    return "one statement per line, no semicolons"

# C's do-while, which no word here writes, and what to write for it.
function do_while() -> str
    return "C's `do { … } while (c)`, which runs its body before asking `c`, is no loop here: write the body under `while true`, ending it with `if !(c)` over `break`"

# Whether the statement begun at token `from`, whose line end the cursor
# stands past, is the name `do` alone on its line over a block: braces the
# lexer laid out, their `{` on a line of its own, or an indented block, C's
# do-while with its `{` below the `do` or none. Told once at the block, for
# what it is, where it was a map refused for its block, or a block nothing
# opens, and the `while` below it a loop with no body (defect 367); the
# caller reads the block, and `do_tail` the `while`.
function under_a_do(@c: cursor.Cursor, text: str, from: i64) -> bool
    i: i64 @= c.pos - 1

    while i > from && (c.tokens[i].kind == .comment || token.is_line_end(c.tokens[i].kind))
        i @ i - 1

    if i != from || !alone_do(c, text, at: from) || !cursor.at(c, .indent) && !(brace_habit.opens_here(c, text) && laid_braces.laid_out_by_lexer(c, open: c.pos))
        return false
    cursor.error(
        @c,
        code: "unexpected_block",
        message: "this block is opened by nothing, `do` opening none — " + do_while(),
        span: cursor.current_span(c)
    )
    return true

# Whether the token at `at` is the name `do`, the first on its line.
function alone_do(c: cursor.Cursor, text: str, at: i64) -> bool
    i: i64 @= at - 1

    while i >= 0 && c.tokens[i].kind == .comment
        i @ i - 1

    return c.tokens[at].kind == .ident && cursor.slice_of(text, c.tokens[at].span) == "do" && (i < 0 || token.is_line_end(c.tokens[i].kind))

# Whether the `while` at token `head`, whose condition the cursor stands
# after, is the tail of braces whose `{` a report names, with no body after
# it, past its line's end: braces whose `}` stands before it on its line, or,
# alone on the line above, closes the block the lexer laid out below the `{`
# (defect 303). A body below makes it a loop, read as one.
function do_tail(c: cursor.Cursor, text: str, head: i64) -> bool
    close: i64 @= head - 1
    opener: i64 @= -1
    below: i64 @= c.pos

    while close > 0 && c.tokens[close].kind == .comment
        close @ close - 1

    while c.tokens[below].kind == .terminator || c.tokens[below].kind == .comment
        below @ below + 1

    if close >= 0 && c.tokens[close].kind == .rbrace && text_lines.newlines_between(text, from: c.tokens[close].span.end, to: c.tokens[head].span.start) == 0
        opener @ opener_of(c, close: close)
    else
        opener @ laid_opener(c, text, head: head)

    if opener < 0 || c.tokens[below].kind == .indent || opening.tabbed_line(c, text) || brace_habit.ending(c, text) >= 0
        return false
    return line_end.said_here(on(c, at: opener))

# The `{` the lexer laid out whose block ends right before the token `head`,
# its `}` alone on the line above and no token (`laid_braces.laid_block`), or
# -1: past the indent the block's last dedent closes, by depth, where it has
# a block, the `{`.
function laid_opener(c: cursor.Cursor, text: str, head: i64) -> i64
    i: i64 @= head - 1
    depth: i64 @= 0

    while i > 0 && c.tokens[i].kind == .comment
        i @ i - 1

    if i >= 0 && c.tokens[i].kind == .dedent
        while i >= 0 && !(c.tokens[i].kind == .indent && depth == 1)
            if c.tokens[i].kind == .dedent
                depth @ depth + 1
            else if c.tokens[i].kind == .indent
                depth @ depth - 1
            i @ i - 1

        i @ i - 1
    indent = i + 1

    while i > 0 && (c.tokens[i].kind == .comment || c.tokens[i].kind == .terminator)
        i @ i - 1

    # Or the block with no braces below `do` alone, told at its indent
    # (`under_a_do`, defect 367).
    if indent < head && c.tokens[indent].kind == .indent && i >= 0 && alone_do(c, text, at: i)
        return indent

    if i < 0 || !laid_braces.laid_out_by_lexer(c, open: i) || laid_braces.laid_block(c, open: i).past != head
        return -1
    return i

# The index of the `{` the `}` at `close` closes, by depth, or `close` itself
# where none does.
function opener_of(c: cursor.Cursor, close: i64) -> i64
    depth: i64 @= 0
    i: i64 @= close

    while i >= 0
        k = c.tokens[i].kind

        if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth + 1
        else if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth - 1

            if depth == 0
                return i
        i @ i - 1

    return close

function on(c: cursor.Cursor, at: i64) -> cursor.Cursor
    moved: cursor.Cursor @= c
    moved.pos @ at
    return moved

## Tests

# The premise `gives_a_bool` rests on: the operators that give a `bool` are
# the eight loosest of the language's one list of them. A new comparison lands
# in `operators.binary_tokens`, and this names the list `gives_a_bool` must
# learn it in.
test "the binary operators a while's condition stands on are the eight loosest"
    tokens = operators.binary_tokens()

    for at in range(from: 0, to: tokens.len())
        assert gives_a_bool(tokens[at]) == (at < 8)
