# The lines apart: what a line break the lexer refused makes the parser say
# (design.md §4.15, §4.17; panel 181 item 2; defect 132).
#
# Outside brackets a line ends its statement. Where the author broke one, the
# lexer refuses the break, `continuation_outside_brackets`, and hands the
# parser the line joined (`open_line.hero`), so that the break costs one
# diagnostic. The parser, reading the join, can still say a second one that
# the join alone causes: `0 => 5 -` over `1 => 10` is read as
# `0 => 5 - 1 => 10`, whose second `=>` ends no line, and `for` alone over a
# deeper `print(1)` as `for print(1)`, which names no loop variable. **A
# message the join alone causes is the join's, and it is held; a message the
# lines would earn apart is the author's, and it is said.**
#
# The test is a measurement of the program in hand, never a list of shapes.
# Where the lexer refused a break, the file is read a second time with its
# lines APART (`lexer.lex_apart`: a line end at each refused break, the next
# line's margin read, and a head that could only go on left out, being the
# break itself), and the two readings' parser diagnostics are compared by
# code and by the offset they stand at, over each joined line and the first
# word after it, where a head that took its body into its line looks for one:
#
# - one the joined reading says and the apart one says too is the author's,
#   and it is said; unless the apart reading says it INSIDE the break, at the
#   line end it plants or on the token the refusal names, where it is the
#   break told in the parser's words (`match >` over its arms);
# - one the apart reading does not say, where that reading had refused
#   nothing on its own line before it, is the join's, and it is held;
# - one the apart reading could not have said, because it refused something
#   earlier on that line and its recovery dropped the rest, is said;
# - and one the apart reading says after the break, on a line it had refused
#   nothing of before it, where the joined reading refused something earlier
#   or said something else on that token, is said as well: `0 => 5 -` over
#   `1 => 10 )` still reports the `)`. A refusal there is the parser's or the
#   lexer's, whose `error` token the parser reads as said, so `x = 0X10 +`
#   over `print(1) )` reports the `)` too;
# - a head's missing body that both readings say, the apart one at the first
#   word of the line below the break and the joined one farther along, is the
#   author's, and it is said once; and the line below it is read as what it
#   is, the head's body or a line beside it (`parse/below_a_head`): `if`
#   alone over a same-margin `print(1) )` reports its missing body and the `)`.
#
# The second reading costs one lex and one parse of the one file, and only
# where its lexer refused a break, which no program that compiles has; the
# third, the lines read as bodies, only below a bodiless head.
#
# A held diagnostic is said where the refusal at its break is not: the
# control arm, `check --permissive`, drops the refusal, a thesis rule, and
# reads the join as the program, whose report the held one is. One the apart
# reading adds is said where the refusal is (`parse/which_arm`).
#
# | entry | called by |
# |---|---|
# | `weigh` | `parse.parse_source` and `parse.parse_bounded`, for a file whose lexer refused a break |
#
# The readings and their offsets are `parse/readings`, the line below a
# bodiless head `parse/below_a_head`, the joined lines `joined_lines`.

use token
use diag
use ast
use lexer
use cursor
use parse/decl
use parse/which_arm
use parse/readings
use parse/below_a_head as below
use joined_lines as seams
use join_fix

# One diagnostic of the joined reading in the order it is said, the held ones
# where `placed` puts them: said as the parser said it, or held back
# (`entry`, whose place is counted again once the order is whole).
record Item
    said: bool
    entry: diag.Held

# The joined reading's diagnostics, in `c`, weighed against the apart
# reading's: what is the join's is held, and what the apart reading says that
# the joined one never reached is held to be said where the refusal is, each
# in the order the parser said the rest, and the second by its offset.
function weigh(@c: cursor.Cursor, @lexed: lexer.LexOutput, apart: lexer.LexOutput, text: str)
    lines = seams.lines_of(c.tokens, lexed: lexed)
    froms: [i64] @ []

    for line in lines
        froms @ froms.push(line.from)

    r = readings.readings(c, lines: lines, froms: froms, apart: apart, text: text)
    low = below.lines_below(lines, froms: froms, r: r, apart: apart, text: text, root_end: c.root_end)
    items: [Item] @ []
    next: i64 @ 0
    i: i64 @ 0

    while i <= c.diagnostics.len()
        while next < c.held.len() && c.held[next].at == i
            items @ items.push(Item(said: false, entry: c.held[next]))
            next @ next + 1

        if i < c.diagnostics.len()
            d = c.diagnostics[i]
            at = seams.line_at(lines, froms: froms, at: d.span.start)
            alone = at >= 0 && join_alone(lines[at], d: d, r: r, low: low)
            cause: token.Span @ d.span

            if alone
                cause @ seams.cause_of(lines[at], at: d.span.start)
            items @ items.push(Item(said: !alone, entry: diag.Held(at: 0, cause: cause, diagnostic: d, apart: false)))
        i @ i + 1

    added = apart_items(lines, froms: froms, r: r, low: low)
    kept: [diag.Diagnostic] @ []
    held: [diag.Held] @ []

    for item in merged(items: items, added: added)
        if item.said
            kept @ kept.push(item.entry.diagnostic)
        else
            held @ held.push(
                diag.Held(at: kept.len(), cause: item.entry.cause, diagnostic: item.entry.diagnostic, apart: item.entry.apart)
            )

    c.diagnostics @ kept
    c.held @ held
    joins_guessed(@lexed, lines: lines, froms: froms, held: held)

# What the apart reading says that the joined one never reached, to be said
# where the refusal is, in the order of the text.
#
# **A line below a bodiless head both readings name (`agreed`) is read as
# what it is** (`parse/below_a_head`): as the head's body, one level deeper
# (`lexer.lex_bodies`), as a line beside the head, or as the rest of the
# head's own line, whichever reads it furthest; what that reading refuses
# there is the line's own mistake, and what the others refuse may be only
# their debris: `0 => 1` read as a statement below `match` costs its `=>`,
# and `print(1)` read as an arm costs its first word. `for` over a
# same-margin `print(1) )` still reports the `)`, read either way; `match`
# over a same-margin `0 => 1` does not report the `=>`, nor over `print(1)`
# the `print`.
function apart_items(lines: [seams.Line], froms: [i64], r: readings.Readings, low: below.Below) -> [Item]
    chosen = low.chosen
    found: [diag.Diagnostic] @ []

    for d in r.other.diagnostics
        at = seams.line_at(lines, froms: froms, at: d.span.start)
        region = below.region_at(chosen, at: d.span.start)

        if at >= 0 && (below.agreed(lines[at], d: d, r: r) || region < 0 && unreached(lines[at], d: d, r: r) || region >= 0 && chosen.read_as[region] == .beside && below.own(lines[at], d: d, r: r))
            found @ found.push(d)

    for d in low.bodies.diagnostics
        at = seams.line_at(lines, froms: froms, at: d.span.start)
        region = below.region_at(chosen, at: d.span.start)

        if region >= 0 && chosen.read_as[region] == .body && below.own(lines[at], d: d, r: r)
            found @ found.push(d)

    items: [Item] @ []

    for d in readings.sorted(found).diagnostics
        line = lines[seams.line_at(lines, froms: froms, at: d.span.start)]
        items @ items.push(
            Item(said: false, entry: diag.Held(at: 0, cause: seams.cause_of(line, at: d.span.start), diagnostic: d, apart: true))
        )

    return items

# A line whose joined reading the parser refuses for the join alone is one no
# join repairs: applied, it is that refusal (`0 =>` over `_ => 2` joined to
# `0 => _ => 2`). So every join of its statement is a `guess`, as
# `line_joins` makes the joins of one statement one certainty (panel 181 item
# 3, `.claude/rules/diagnostics-and-goldens.md`: a `certain` fix repairs the
# defect it names).
function joins_guessed(@lexed: lexer.LexOutput, lines: [seams.Line], froms: [i64], held: [diag.Held])
    refused: [bool] @ []

    for line in lines
        _ = line
        refused @ refused.push(false)

    # A report at the first word after one line, which begins the next, may be
    # either's, a head's missing body or the next head's own; both are marked.
    for h in held
        where = h.diagnostic.span.start
        at = seams.line_at(lines, froms: froms, at: where)

        if !h.apart && at >= 0
            refused[at] @ true

            if at > 0 && where >= lines[at - 1].to && where <= lines[at - 1].after
                refused[at - 1] @ true

    statements: [i64] @ []
    i: i64 @ 0

    for line in lines
        if refused[i]
            for one in line.statements
                if statements.len() == 0 || statements[statements.len() - 1] != one
                    statements @ statements.push(one)
        i @ i + 1

    next: i64 @ 0

    for b in lexed.breaks
        while next < statements.len() && statements[next] < b.statement
            next @ next + 1

        # The break's join, by its title (`join_fix`): a deletion offered
        # beside it or in its place is no join, and a line the lexer ended
        # rather than refused (`diagnostic` -1) has neither.
        at: i64 @ -1

        if b.diagnostic >= 0
            at @ join_fix.index(lexed.diagnostics[b.diagnostic])

        if next < statements.len() && statements[next] == b.statement && at >= 0
            lexed.diagnostics[b.diagnostic].fixes[at].certainty @ .guess

# `items` with each of `added`, which ascend, before the first item that stands
# after it in the text.
function merged(items: [Item], added: [Item]) -> [Item]
    out: [Item] @ []
    next: i64 @ 0

    for item in items
        while next < added.len() && added[next].entry.diagnostic.span.start < item.entry.diagnostic.span.start
            out @ out.push(added[next])
            next @ next + 1

        out @ out.push(item)

    while next < added.len()
        out @ out.push(added[next])
        next @ next + 1

    return out

# Is the joined reading's `d` the join's? Said apart inside the break, it is
# the break in the parser's words; said apart elsewhere, it is the author's;
# not said apart, it is the join's where the apart reading reached it. On a
# line below a bodiless head, the reading that reads that line as what it is
# is asked in place of the apart one (`parse/below_a_head`): `if` over `) x`
# is refused joined at the `)` and read as its body there too, while apart the
# `)` is refused under another code, and it is the author's.
function join_alone(line: seams.Line, d: diag.Diagnostic, r: readings.Readings, low: below.Below) -> bool
    if readings.says(r.inside, d)
        return true
    region = below.region_at(low.chosen, at: d.span.start)

    if region >= 0
        return match low.chosen.read_as[region]
            .body   => !readings.says(low.bodies, d)
            .beside => !readings.says(r.other, d)
            .joined => false

    if readings.says(r.other, d)
        return false
    at = d.span.start
    from = seams.apart_line_start(line, at: at)
    return !readings.any_in(r.other, from: from, to: at) && !readings.starts_in(r.apart_errors, from: from, to: at)

# Did the apart reading say `d` after a break, on a line it had refused
# nothing of before `d`, where the joined reading never reached it, having
# refused something earlier on the joined line or said something else on that
# very token (`if` over a deeper `print(1) )`, whose joined reading names its
# body missing at the `)`)? A refusal is the parser's or the lexer's, whose
# `error` token the parser reads as said. A line the apart reading had
# refused something of is its own recovery's to read, whose next report may
# be that refusal's debris.
function unreached(line: seams.Line, d: diag.Diagnostic, r: readings.Readings) -> bool
    at = d.span.start

    if at < line.belows[0] || at >= line.to || readings.says(r.joined, d)
        return false
    from = seams.apart_line_start(line, at: at)

    if readings.any_in(r.other, from: from, to: at) || readings.starts_in(r.apart_errors, from: from, to: at)
        return false
    return readings.any_in(r.joined, from: line.from, to: at + 1) || readings.starts_in(r.joined_errors, from: line.from, to: at + 1)

# Defect 132's class: a bodiless head over a line at its margin is told its
# missing body once, whichever head, and the line's own mistake with it, read
# as what the line is; an arm below `match` read as a statement costs no `=>`;
# and a line below one that holds a refused token still tells its own.
test "a head alone over a line at its margin is told its body once, and the line its own mistake"
    body = "function main(n: i64, a: i64)\n    "
    shapes = [
        [body + "if\n    print(1) )\n", "missing_body expected_end_of_line"]
        [body + "while\n    print(1) )\n", "missing_body expected_end_of_line"]
        [body + "for\n    print(1) )\n", "missing_body expected_end_of_line"]
        [body + "if a >\n    print(1) )\n", "missing_body expected_end_of_line"]
        [body + "if n > 0\n        print(0)\n    else if\n    print(1) )\n", "missing_body expected_end_of_line"]
        [body + "x = match\n    print(1) )\n", "missing_match_arms expected_end_of_line"]
        [body + "k = match n\n        0 => if\n        print(1) )\n        _ => 2\n", "missing_body expected_end_of_line"]
        [body + "if\n    print(1)\n", "missing_body"]
        [body + "k = match\n    0 => 1\n", "missing_match_arms"]
        [body + "k = match\n    0 => 1 )\n", "missing_match_arms expected_end_of_line"]
        [body + "x = 0X10 +\n    print(1) )\n", "expected_end_of_line"]
        [body + "if\n        print(1) )\n", "expected_end_of_line"]
        [body + "if\n    ) x\n", "expected_expression missing_body"]
        ["fn two() ->\ni64\n    return 2\n", ""]
    ]

    for shape in shapes
        text = shape[0]
        lexed: lexer.LexOutput @ lexer.lex_one(text)
        c: cursor.Cursor @ cursor.lexed_cursor(
            tokens: lexed.tokens,
            root_end: -1,
            closes: lexed.closes,
            swaps: lexed.swaps
        )
        a: ast.Ast @ ast.new_ast()
        decls: [ast.Decl] @ []
        uses: [ast.Use] @ []
        decl.file(@c, @a, @decls, @uses, text)
        weigh(@c, lexed: @lexed, apart: lexer.lex_apart(text), text: text)
        codes: [str] @ []

        for d in which_arm.placed(c, lexed: lexed.diagnostics).normal
            codes @ codes.push(d.code)

        assert codes.join(" ") == shape[1]
