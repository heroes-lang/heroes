# The scanner's reading of one word (design.md §4.17, §4.15; spec § 2): a
# keyword of Heroes, a word another language spells, which is refused with
# its repair written (the thesis, executable), a keyword standing where a
# group names a C symbol, or a plain name. Moved out of `scan.hero` on
# 2026-11-10, when defect 2417's repair took that file past §11's 300 lines:
# `scan.line_body` hands every word here, and this module calls nothing of
# the scanner's back, so the word is one concern apart from a line's shape.

use bytes
use c_names
use diag
use foreign_at
use keywords
use lost_quote
use state
use text_lines
use token
use word_beside

# A keyword naming a C type, a tag or a field, its error token pushed (defect
# 2238): apart from `ident`, which every word takes, and asked past `may_name`.
function keyword_named(@l: state.LexState, text: str, start: i64) -> bool
    named = c_names.keyword_named(text, token.Span(start: start, end: l.pos), @l.outline)

    if named.is_err()
        return false
    state.error_token(@l, named.must())
    return true

# A word: Heroes keyword, foreign reserved word (loud failure with the repair
# pre-written — the thesis, executable), or plain identifier.
function ident(@l: state.LexState, text: str)
    start = l.pos

    while l.pos < text.len() && (bytes.is_alnum(text[l.pos]) || text[l.pos] == '_')
        l.pos @ l.pos + 1

    word = text.slice(from: start, to: l.pos)

    # A word touching a letter above ASCII is part of a name the author wrote,
    # never the keyword or the refused word its ASCII bytes spell: the letter
    # alone is told (`word_beside.hero`, defect 2417).
    if word_beside.touches_letter(text, start: start, end: l.pos)
        state.emit(@l, .ident, start)
        return
    kw = keywords.keyword(word)

    if !kw.is_err()
        if !c_names.may_name(text, start: start, end: l.pos) || !keyword_named(@l, text, start: start)
            state.emit(@l, kw.must(), start)
        return

    # **The character after the word decides the repair** (defect 015). A
    # word-for-word swap that is right where the word DECLARES something is
    # wrong where it is CALLED — `int(3)` repaired to `i64(3)` is
    # `error[unknown_name]`, and `--apply` wrote it. The lexer cannot know a
    # position, but it can read the next byte, and that is a fact about the text
    # in hand rather than a premise about the program around it (CLAUDE.md §11).
    # `foreign_at.repair_at` reads that byte, and the parser asks the same
    # function when it reads a construct as the swap writes it (defect 133).
    #
    # **The token stays `error` even where the swap is certain** (defect 133):
    # the parser reads the swap only where it dispatches on the keyword the
    # swap writes (`parse/swap_reading.hero`), and every other reader of the
    # stream goes on seeing a word the lexer refused. What it reads is the
    # swap written here, kept where the word begins (`LexState.swaps`, defect
    # 146), so the parser reads the word as `--apply` writes it.
    span = token.Span(start: start, end: l.pos)
    entry = foreign_at.foreign_word_at(text, span)

    # A foreign word a lost quote left outside every string is that quote's
    # (`lost_quote.hero`): no report and no swap. One in a hole is code.
    if !entry.is_err() && l.holes.len() == 0 && lost_quote.lost_in(@l, text, at: start)
        state.error_token_at(@l, start)
        return

    if !entry.is_err()
        found = foreign_at.repair_of(text, span, entry.must(), @l.outline)
        d: diag.Diagnostic @= diag.new_diagnostic(code: "reserved_word", message: found.message, span: span)
        swap = foreign_at.swap_of(found.repair)

        if !swap.is_err()
            state.push_swap(@l.swaps, at: start, word: swap.must())

        d.fixes @ match found.repair
            .swap fix => d.fixes.push(
                diag.Fix(title: "replace `" + word + "` with `" + fix.word + "`", replacement: fix.word, span: span, certainty: .certain)
            )
            .hint fix => d.fixes.push(diag.Fix(title: fix.title, replacement: fix.word, span: span, certainty: .guess))
            .drop => d.fixes.push(
                diag.Fix(title: "drop `" + word + "`", replacement: "", span: token.Span(start: start, end: text_lines.past_spaces(text, at: l.pos)), certainty: .guess)
            )
            .guidance => d.fixes

        state.error_token(@l, d)
        return
    state.emit(@l, .ident, start)
