# Scanning: the part of the lexer that reads *words* instead of shape.
# Port of archive/bootstrap-rs/heroes/src/lexer/scan.rs.
#
# `line_body` walks one physical line and dispatches on the first byte of
# each token: `#` comment, `"` string, `'` char, digit, letter, or
# punctuation. Every scanner follows the same contract: it advances `l.pos`
# past exactly what it consumed; on success it calls `state.emit` (which also
# tracks bracket depth); on failure it calls `state.error_token` and KEEPS
# LEXING — one bad literal must not hide every error after it.
#
# Port note: Rust's punct matches a (b0, Option<b1>, Option<b2>) tuple in one
# `match`; Heroes has no tuple patterns, so the longest-match rule is an
# if/else ladder in the same order — three-byte forms, then two, then one.
# The order IS the rule, so the ladder keeps Rust's exact sequence. It lives
# in `punctuation.hero` since panel 181, because the layout asks it too.

use token
use diag
use state
use layout
use keywords
use foreign_at
use number
use literals
use lex_interp
use bytes
use shown_char
use punctuation
use open_line
use backslash
use brace_layout
use closers
use loop_headers
use arrow_inside
use bracket_reach
use lost_quote
use comment_habit
use word_place
use separator_runs
use text_lines
use comment_refusal
use refused_stretch

## One line of words

# Lex tokens until the end of the physical line (inclusive).
function line_body(@l: state.LexState, text: str)
    while true
        if l.pos >= text.len()
            return
        b = text[l.pos]

        if b == ' '
            l.pos @ l.pos + 1
        else if b == '\t'
            # A tab between tokens is as illegal as one in the margin.
            span = token.Span(start: l.pos, end: l.pos + 1)
            state.push_diagnostic(
                @l.diagnostics,
                diag.new_diagnostic(code: "tab_in_line", message: "a tab is a compile error — use spaces", span: span)
            )
            l.pos @ l.pos + 1
        else if b == layout.CR
            # A carriage return is tolerated ONLY as part of `\r\n`: a lone
            # one merged two statements onto one reported line, and a terminal
            # eats the CR too (2026-08-12, sweep 001 audit S6).
            if number.byte_at(text, l.pos + 1) != '\n'
                span = token.Span(start: l.pos, end: l.pos + 1)
                state.push_diagnostic(
                    @l.diagnostics,
                    diag.new_diagnostic(code: "stray_carriage_return", message: "a carriage return that is not part of a line ending — delete it, or end the line", span: span)
                )
            l.pos @ l.pos + 1
        else if b == '\n'
            lex_interp.line_ends(@l, at: l.pos)
            layout.maybe_terminator(@l, text)
            l.pos @ l.pos + 1
            l.last_significant @ fail(code: state.ERR_NO_SIGNIFICANT, msg: "line ended")
            return
        else if b == '#'
            comment_refusal.comment(@l, text)
        else if b == '"'
            literals.string(@l, text)
        else if b == 'f' && number.byte_at(text, l.pos + 1) == '"'
            # `f"…"` — an interpolated literal, lexed as pieces with the holes'
            # own tokens between them (panel 121; `lex_interp.hero`).
            lex_interp.head(@l, text)
        else if b == '\''
            literals.char_lit(@l, text)
        else if bytes.is_digit(b)
            number.number(@l, text)
        else if bytes.is_alpha(b) || b == '_'
            ident(@l, text)
        else if b == '}' && lex_interp.closes_a_hole(l)
            # This `}` closes a hole and not a map: the piece after it is text.
            lex_interp.piece(@l, text)
        else if b == '\\' && backslash.asks_to_go_on(l, text, at: l.pos)
            # A `\` at a line's end asks it to go on, one message and no token.
            backslash.asked(@l, text)
        else if b == '/' && comment_habit.opens_at(text, at: l.pos) && (l.holes.len() == 0 || comment_habit.divides_at(text, at: l.pos, inside: true))
            # `//` or `/* … */`, another language's comment, told once; in an
            # interpolation hole only the division `//` can be.
            foreign_comment(@l, text)
        else
            punct(@l, text)

## The comment

# A `# …` comment and its token are `comment_refusal`'s, which finds its end
# and refuses there what a reader cannot see (panel 192's R3).

# `//` or `/* … */` at `l.pos`, a comment another language writes
# (`comment_habit.hero`): told once, `unexpected_character`, and read as the
# comment it is, nothing in it lexed; or, inside a bracket whose closer stands
# later on its line, Python's integer division, read as the `/` it is here.
# Its fix writes `#` where it stands: `certain` where the comment opens its
# line, or where a block comment ends it, a `guess` after code, where the
# division is a reading too.
function foreign_comment(@l: state.LexState, text: str)
    start = l.pos
    block = text[start + 1] == '*'
    after_code = !word_place.only_margin(text, from: word_place.line_start(text, at: start), to: start)

    if !block && comment_habit.divides_at(text, at: start, inside: l.open_brackets.len() + l.holes.len() > 0)
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "unexpected_character",
            message: "`//` is not part of the language's syntax — an integer is divided by `/`, and a comment begins with `#`",
            span: token.Span(start: start, end: start + 2)
        )
        d.fixes @ d.fixes.push(
            diag.Fix(title: "divide with `/`", replacement: "/", span: token.Span(start: start, end: start + 2), certainty: .guess)
        )
        state.push_diagnostic(@l.diagnostics, d)
        finish(@l, text, .slash, start: start, width: 2)
        return

    if block
        end = comment_habit.comment_end(text, at: start)
        lines: str @ ""

        # Over several lines, one comment, each of its lines owing its own `#`.
        if comment_habit.block_end(text, from: start + 2) < 0
            lines @ ", so each line of this one begins with its own"
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "unexpected_character",
            message: "`/*` is not part of the language's syntax — a comment begins with `#` and runs to its line's end" + lines,
            span: token.Span(start: start, end: start + 2)
        )

        if comment_habit.holds_the_line(text, at: start)
            d.fixes @ d.fixes.push(
                diag.Fix(title: "write the comment with `#`", replacement: comment_habit.written_with_hashes(text, at: start, end: end), span: token.Span(start: start, end: end), certainty: .certain)
            )
        state.push_diagnostic(@l.diagnostics, d)
        comment_refusal.comment_token(@l, start: start, end: end)
        l.pos @ end
        return
    width = comment_habit.slashes(text, at: start)
    message: str @ "`" + text.slice(from: start, to: start + width) + "` is not part of the language's syntax — a comment begins with `#`"
    certainty: diag.Certainty @ .certain

    if after_code
        message @ message + ", and an integer is divided by `/`"
        certainty @ .guess
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "unexpected_character",
        message: message,
        span: token.Span(start: start, end: start + width)
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "begin the comment with `#`", replacement: "#", span: token.Span(start: start, end: start + width), certainty: certainty)
    )
    state.push_diagnostic(@l.diagnostics, d)
    comment_refusal.comment(@l, text)

## The word

# A word: Heroes keyword, foreign reserved word (loud failure with the repair
# pre-written — the thesis, executable), or plain identifier.
function ident(@l: state.LexState, text: str)
    start = l.pos

    while l.pos < text.len() && (bytes.is_alnum(text[l.pos]) || text[l.pos] == '_')
        l.pos @ l.pos + 1

    word = text.slice(from: start, to: l.pos)
    kw = keywords.keyword(word)

    if !kw.is_err()
        state.emit(@l, kw.must(), start)
        return

    # **The character after the word decides the repair** (defect 015). A
    # word-for-word swap that is right where the word DECLARES something is
    # wrong where it is CALLED — `int(3)` repaired to `i64(3)` is
    # `error[unknown_name]`, and `--apply` wrote it. The lexer cannot know a
    # position, but it can read the next byte, and that is a fact about the text
    # in hand rather than a premise about the program around it (CLAUDE.md §11).
    # `foreign_at.repair_at` reads that byte, and the parser asks the same
    # function when it reads a construct as the swap writes it (defect 133).
    #
    # **The token stays `error` even where the swap is certain** (defect 133):
    # the parser reads the swap only where it dispatches on the keyword the
    # swap writes (`parse/swap_reading.hero`), and every other reader of the
    # stream goes on seeing a word the lexer refused. What it reads is the
    # swap written here, kept where the word begins (`LexState.swaps`, defect
    # 146), so the parser reads the word as `--apply` writes it.
    span = token.Span(start: start, end: l.pos)
    entry = foreign_at.foreign_word_at(text, span)

    # A foreign word a lost quote left outside every string is that quote's
    # (`lost_quote.hero`): no report and no swap. One in a hole is code.
    if !entry.is_err() && l.holes.len() == 0 && lost_quote.lost_in(text, at: start)
        state.error_token_at(@l, start)
        return

    if !entry.is_err()
        found = foreign_at.repair_of(text, span, entry.must(), @l.outline)
        d: diag.Diagnostic @ diag.new_diagnostic(code: "reserved_word", message: found.message, span: span)
        swap = foreign_at.swap_of(found.repair)

        if !swap.is_err()
            state.push_swap(@l.swaps, at: start, word: swap.must())

        d.fixes @ match found.repair
            .swap fix => d.fixes.push(
                diag.Fix(title: "replace `" + word + "` with `" + fix.word + "`", replacement: fix.word, span: span, certainty: .certain)
            )
            .hint fix => d.fixes.push(diag.Fix(title: fix.title, replacement: fix.word, span: span, certainty: .guess))
            .drop => d.fixes.push(
                diag.Fix(title: "drop `" + word + "`", replacement: "", span: token.Span(start: start, end: text_lines.past_spaces(text, at: l.pos)), certainty: .guess)
            )
            .guidance => d.fixes

        state.error_token(@l, d)
        return
    state.emit(@l, .ident, start)

## The punctuation

# Punctuation and operators, longest match first, from the one table
# (`punctuation.hero`, which the layout reads too). Anything unmatched is
# skipped one whole character at a time (UTF-8-safe) with a diagnostic.
function punct(@l: state.LexState, text: str)
    start = l.pos
    found = punctuation.punct_at(text, at: start)

    if found.width > 0
        finish(@l, text, found.kind, start: start, width: found.width)
        return

    # Not in the language. Skip one whole character, UTF-8-safe.
    ch = bytes.char_at(text, start)
    l.pos @ l.pos + ch.len()
    span = token.Span(start: start, end: l.pos)

    # A character a lost quote left outside every string, a `\` or a `§`
    # its string held, is that quote's, which the literal its line ends in
    # reports (`lost_quote.hero`). One in a hole is code, the literal's own
    # closing quote after it on the line no lost one (defect 312).
    if l.holes.len() == 0 && lost_quote.lost_in(text, at: start)
        state.error_token_at(@l, start)
        return

    # One of C's `for (i = 0; i < n; i++)`, or of the header written bare, is
    # that header's, which the parser tells once (defects 194 and 301).
    if ch == ";" && loop_headers.header_semicolon(@l, text, at: start)
        return

    # C's `;` that ends its line outside brackets is a habit told once a run,
    # its deletion certain (`separator_runs`, defect 178).
    if ch == ";" && l.open_brackets.len() == 0 && separator_runs.ends_its_line(text, at: l.pos)
        separator_runs.semicolon(@l.diagnostics, text, at: span)
        state.error_token_at(@l, start)
        return

    # A stretch of them is one mistake, told once: a string in backticks,
    # JavaScript's template literal among them, whole, and a run that can be
    # seen, through its spaces (defect 391, `refused_stretch.hero`).
    if refused_stretch.told(@l, text, at: start)
        return

    # Not "(ASCII-only)": that read as an encoding fault for `&`, which is
    # ASCII, and sent the reader hunting for one (panel 036). The syntax is
    # ASCII-only, and this character is not in it — two different claims, and
    # only the second is the error.
    state.error_token(
        @l,
        diag.new_diagnostic(code: "unexpected_character", message: shown_char.named(ch) + " is not part of the language's syntax", span: span)
    )

function finish(@l: state.LexState, text: str, kind: token.TokenKind, start: i64, width: i64)
    l.pos @ start + width

    # A `{` that ends its head's line is read as the line's end, a `}` that
    # closes it as nothing where its line ends (`brace_layout.hero`, ruling 1);
    # and one that ends C's `for` header, whose `)` was left out (defect 302).
    if kind == .lbrace && (bracket_reach.ended_by_a_brace(@l, text, at: start) || brace_layout.opens_a_body(l.tokens, open: l.open_brackets.len() + l.holes.len(), text, at: start))
        brace_layout.opened(@l)
        state.emit_open_body(@l, start)
        return

    if kind == .rbrace && brace_layout.closes(braced: l.braced.len(), brackets: l.open_brackets, holes: l.holes.len(), text, at: start)
        if l.open_brackets.len() > 0
            layout.close_brackets(@l, text)
            state.push_offset(@l.closes, at: start)
        brace_layout.closed(@l)
        l.pos @ brace_layout.past_the_closer(text, from: l.pos)

        # Where its line goes on, `} else {` or junk, the `}` is a token, so
        # that what follows it is read as what follows the braces it closes.
        if !brace_layout.ends_its_line(text, from: l.pos)
            state.emit_close_body(@l, start)
        return

    # What the token owes the brackets open: a closer of another kind than
    # the innermost closes its own (`closers.before`), and a function type's
    # `->` the `(` whose `)` was left out before it (`arrow_inside`).
    closers.before(@l, text, kind, start: start)
    arrow_inside.close(@l, text, kind, start: start)
    state.emit(@l, kind, start)

# A line that ends with a value owes its terminator until the next line with
# words or the file's end (panel 181, `open_line.owe`), so a test that lexes
# one line alone ends the file itself, as `lexer.lex_one` does.
test "a line of words dispatches on first bytes"
    l: state.LexState @ state.new_state()
    line_body(@l, "x = f(12, \"s\")\n")
    open_line.settle(@l)
    kinds: [token.TokenKind] = [.ident, .eq, .ident, .lparen, .int_lit, .comma, .str_lit, .rparen, .terminator]
    assert l.tokens.len() == kinds.len()
    i: i64 @ 0

    while i < kinds.len()
        assert l.tokens[i].kind == kinds[i]
        i @ i + 1

    assert l.diagnostics.len() == 0

test "longest match wins and the hole beats the question mark"
    l: state.LexState @ state.new_state()
    line_body(@l, "??? -> => == != <= >= && || << >> ?")
    kinds: [token.TokenKind] = [
        .hole
        .arrow
        .fat_arrow
        .eq_eq
        .bang_eq
        .le
        .ge
        .and_and
        .or_or
        .shl
        .shr
        .question
    ]
    assert l.tokens.len() == kinds.len()
    i: i64 @ 0

    while i < kinds.len()
        assert l.tokens[i].kind == kinds[i]
        i @ i + 1

test "a keyword is not an identifier and a foreign word repairs itself"
    l: state.LexState @ state.new_state()
    line_body(@l, "fn main()")
    assert l.tokens[0].kind == .error
    assert l.diagnostics[0].code == "reserved_word"
    assert l.diagnostics[0].fixes[0].replacement == "function"
    assert l.diagnostics[0].fixes[0].certainty == .certain
    assert l.tokens[1].kind == .ident

    # Where the word it writes is wrong, the swap is not offered as certain
    # (defect 133's second round): `while function x` is no program.
    w: state.LexState @ state.new_state()
    line_body(@w, "while fn x")
    assert w.tokens[0].kind == .kw_while
    assert w.tokens[1].kind == .error
    assert w.diagnostics[0].code == "reserved_word"
    assert w.diagnostics[0].fixes.len() == 0
    assert w.tokens[2].kind == .ident

test "a comment is retained and plants no terminator"
    l: state.LexState @ state.new_state()
    line_body(@l, "# a heading\n")
    assert l.tokens.len() == 1
    assert l.tokens[0].kind == .comment
    v: state.LexState @ state.new_state()
    line_body(@v, "x # trailing\n")
    open_line.settle(@v)
    assert v.tokens[0].kind == .ident
    assert v.tokens[1].kind == .comment
    assert v.tokens[2].kind == .terminator

test "what is not in the language is skipped whole with its name"
    l: state.LexState @ state.new_state()
    line_body(@l, "x € y\n")
    open_line.settle(@l)
    assert l.tokens[1].kind == .error
    assert l.diagnostics[0].code == "unexpected_character"
    assert l.tokens[3].kind == .terminator
    assert l.tokens[2].kind == .ident

test "a tab between tokens is named"
    l: state.LexState @ state.new_state()
    line_body(@l, "x\ty\n")
    assert l.diagnostics[0].code == "tab_in_line"
    assert l.tokens[0].kind == .ident
    assert l.tokens[1].kind == .ident

# This test could not be written until panel 066, and the note that said so
# stood right here: provoking the path needs a CR inside a test string, and
# byte 13 had no spelling. It has one now, so the port tests BOTH directions —
# the stray one, which is a diagnostic, and the tolerated `\r\n`, which was
# untested on either side of the port (the compiler-engineer's finding).
test "a stray carriage return is named and a crlf line ending is tolerated"
    l: state.LexState @ state.new_state()
    line_body(@l, "print(1)\rprint(2)\n")
    assert l.diagnostics.len() == 1
    assert l.diagnostics[0].code == "stray_carriage_return"
    crlf: state.LexState @ state.new_state()
    line_body(@crlf, "x = 1\r\n")
    open_line.settle(@crlf)
    assert crlf.diagnostics.len() == 0
    assert crlf.tokens[crlf.tokens.len() - 1].kind == .terminator

test "a raw carriage return inside a literal is refused with the escape as its repair"
    l: state.LexState @ state.new_state()
    line_body(@l, "s = \"a\rb\"\n")
    assert l.diagnostics.len() == 1
    assert l.diagnostics[0].code == "raw_carriage_return"
    assert l.diagnostics[0].fixes[0].replacement == "\\r"
    assert l.diagnostics[0].fixes[0].certainty == .certain

    # The token keeps its kind — one mistake, one diagnostic (panel 007).
    assert l.tokens[2].kind == .str_lit

    # And the escape spelling is clean, which is the whole point.
    clean: state.LexState @ state.new_state()
    line_body(@clean, "s = \"a\\rb\"\n")
    assert clean.diagnostics.len() == 0
