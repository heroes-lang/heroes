# THE ONE COMMAND (CLAUDE.md §10, design.md §3.5): every capability is
# a subcommand of `heroes`, never a second binary, script, or Makefile.
# Port of archive/bootstrap-rs/heroes-cli/src/main.rs — and the selfhost compiler's
# own entry point, which is what makes this file the finish line's
# front door.
#
# This file does three things and nothing else: parse argv against the
# table, dispatch on the Tag, and turn the result into the exit code
# the contract promises. The dispatch is an EXHAUSTIVE MATCH, so a
# command added to the table without an arm here does not compile —
# panel 016's condition, and the reason this file is boring.
#
# Port notes, each a parked DECIDE question answered provisionally
# here: the compiler fingerprint is the version string alone (no
# current_exe), and the word width is 64 (the platforms the fixpoint
# runs on). Each is one line, and each is where the author's verdict
# lands.
#
# TWO OF THOSE NOTES ARE GONE, and both were false rather than merely
# provisional (panel 085). The library's text is EMBEDDED — see
# library_source.hero — because panel 028 R3 ruled it embedded and
# reading it from disk made every program outside the repository root
# fail on the AUTHOR'S line; and the runtime hint comes from the real
# environment, because "the language has no getenv" was a fact about
# nobody having tried, not about the language: it is one extern.

use source
use cli/table as cli_table
use cli/argv
use cli/io
use cli/toolchain
use cli/process
use cli/input
use library_source
use cli/lex
use cli/syntax_cmds
use cli/check
use cli/verbs
use cli/doctor
use cli/help
use cli/measure
use cli/mutate

# The version, and the one place it lives (CLAUDE.md §14, release tags):
# `heroes --version` prints it, `heroes build --emit-c` writes it as the
# first line of every generated file (`Generated by heroes <this>`), and
# the build cache keys on it (cli/deps.hero). It moves ONLY in the commit
# that carries the release tag `v<this>`, and the CI asserts that the tag
# and this constant agree on every leg. Moving it costs a seed regenerated
# one generation further than usual, because the stamp is the EMITTING
# compiler's and the first generation after a move still carries the old
# number, and the first line rewritten in every blessed file under
# tests/emission/ and every `.expected` under tests/golden/emit/.
constant VERSION: str
    "0.2.0"

function main()
    # `args_checked()` and not `args()`, and this is the compiler refusing
    # to die on input it was only asked to carry.
    #
    # `args()` ABORTS on an argument that is not UTF-8 (spec:184-186), and
    # the abort names a runtime function: `panic: hero_str_from_bytes: not
    # well-formed UTF-8`, exit 134. Measured, and the shape of it is the
    # problem — the COMPILER dying, not the program, on an argument the
    # shell chose and `heroes run` was only passing along.
    #
    # It cannot be carried instead of refused: a Heroes `str` IS UTF-8
    # (spec:52), so there is no value the compiler could hold that
    # argument in. Refusing with the position named is the most `run` can
    # honestly do, and it is exit 2 because the tool could not run rather
    # than because the program is wrong (§10's contract). A program that
    # needs such an argument reaches it through `args_checked()` itself,
    # from a binary built with `heroes build`.
    #
    # `/decide` answer `6a`, 2026-08-28. The same shape one department
    # over is panels 089 and 090: the compiler could be killed by an
    # environment variable.
    raw = args_checked()
    given: [str] @ []
    at: i64 @ 0

    for one in raw
        if one.is_err()
            io.eprint(
                text: "error: argument " + (at + 1).to_str() + " is not UTF-8, and a Heroes `str` cannot hold it (spec:52)"
            )
            io.eprint(text: "note: build the program with `heroes build` and read it with `args_checked()`")
            exit(code: 2)
        given @ given.push(one.must())
        at @ at + 1

    parsed = argv.parse(given, dir_probe: process.is_directory)

    if parsed.is_err()
        io.eprint(text: "error: " + message_of(parsed))
        exit(code: 2)
    inv = parsed.must()
    reading: bool @ false

    # `fmt` reads THE FILE IT WAS NAMED and nothing else, where the other
    # six read the whole compilation. It is the one command that provably
    # needs no graph: `fmt.format_file` keeps root-file
    # declarations and root-file comments only, and its own comment says
    # why — with `--in-place`, a formatter that walked the whole Source
    # would append the library to the author's file once per run (§1.11).
    #
    # Measured 2026-08-28, and the reason this stopped being free: `fmt`
    # over all 165 `selfhost` modules cost **188 s**, against **6 s** for
    # the 206 files outside it, which have no graph to pull. Each one was
    # reading and lexing 48000 lines plus the library to print one file.
    # `lex main.hero` and `parse main.hero` both cost 4 s, so the price
    # was never the parse — it was upstream, which is why this is a
    # dispatch change and not a formatter one.
    #
    # It also closes a second thing: a syntax error in a SIBLING module
    # used to refuse to format the file you named.
    root_only: bool @ false

    # The ones that answer without reading a program.
    match inv.tag
        .version_cmd =>
            print("heroes " + VERSION)
            exit(code: 0)
        .help_cmd =>
            print(help.help())
            exit(code: 0)
        .this_cmd => exit(code: cli_table.exit_code(doctor.run_this()))
        .doctor_cmd => exit(
            code: cli_table.exit_code(doctor.run_doctor(build_dir: "build", runtime_hint: runtime_hint()))
        )
        .measure_cmd => exit(code: cli_table.exit_code(measure.run(inv)))
        .mutate_cmd  => exit(code: cli_table.exit_code(mutate.run(inv)))
        # The seven that read a program fall through to the walk
        # below. The arm is a no-op MUTATION and not a print: a
        # `print("")` here put a blank line above every diagnostic and
        # every dump — caught by the differential against the
        # bootstrap on 2026-08-17, four inputs out of 257.

        .lex_cmd | .parse_cmd | .check_cmd | .build_cmd | .run_cmd | .test_cmd => reading @ true
        .fmt_cmd =>
            reading @ true
            root_only @ true

    # Everything left reads a file.
    _ = reading
    path = inv.file.default("")
    library = library_source.text()
    read: source.Source? @ fail("unset", "no read yet")

    if root_only
        read @ input.read_root_only(path: path)
    else
        read @ input.read_compilation(path: path, library: library)

    if read.is_err()
        io.eprint(text: "error: " + message_of_source(read))
        exit(code: 2)
    s: source.Source @ read.must()
    verdict: cli_table.Exit @ .ok_exit

    match inv.tag
        .lex_cmd                                                                        => verdict @ lex.run(s, inv)
        .parse_cmd                                                                      => verdict @ syntax_cmds.run_parse(
            s,
            inv
        )
        .fmt_cmd                                                                        => verdict @ syntax_cmds.run_fmt(
            path: path,
            s: s,
            inv: inv
        )
        .check_cmd                                                                      => verdict @ check.run(
            s,
            inv
        )
        .build_cmd | .run_cmd | .test_cmd                                               => verdict @ compiling(
            path: path,
            s: s,
            inv: inv
        )
        .doctor_cmd | .mutate_cmd | .measure_cmd | .this_cmd | .version_cmd | .help_cmd => verdict @ verdict

    exit(code: cli_table.exit_code(verdict))

# The three verbs that need the toolchain, and the one place it is
# located: a missing runtime is the tool being unable to run, which is
# exit 2 whatever the verb.
function compiling(path: str, s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    found = toolchain.locate_toolchain(hint: runtime_hint(), fingerprint: VERSION)

    if found.is_err()
        io.eprint(text: "error: " + message_of_toolchain(found))
        return .failed_exit
    t = found.must()

    match inv.tag
        .build_cmd => return verbs.run_build(path: path, s: s, inv: inv, t: t, version: VERSION)
        .run_cmd => return verbs.run_run(path: path, s: s, inv: inv, t: t, version: VERSION)
        .test_cmd => return verbs.run_test(path: path, s: s, inv: inv, t: t, version: VERSION)
        .lex_cmd | .parse_cmd | .check_cmd | .fmt_cmd | .doctor_cmd => return .ok_exit
        .mutate_cmd | .measure_cmd | .this_cmd | .version_cmd | .help_cmd => return .ok_exit

    return .ok_exit

# Where the runtime is, when it is not ./runtime — the REAL environment
# variable, the same channel the bootstrap reads and the same one
# --help names.
#
# It used to read a one-line FILE called HEROES_RUNTIME, on the note
# "the language has no getenv". That note was false: getenv is one
# `extern "stdlib.h"` away, exactly like the `system` this compiler
# already calls, and §1.11 says so — everything comes from C. What the
# file spelling cost was a DIAGNOSTIC THAT LIED: `locate_toolchain`
# says "set HEROES_RUNTIME=<dir>", which every reader takes for an
# environment variable, and under the port that route did nothing
# (panel 085 R8, measured both ways).
function runtime_hint() -> str
    return process.env(name: "HEROES_RUNTIME")

function message_of(failed: argv.Invocation?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

function message_of_source(failed: source.Source?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

function message_of_toolchain(failed: toolchain.Toolchain?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg
