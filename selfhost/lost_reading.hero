# Whether a line ends inside a literal that never closes, read on from a
# character the scanner refuses, answered from readings of its line kept
# for every question after it (defect 293, design.md §4.17; the question is
# `lost_quote.lost_in`'s).
#
# The scanner asks it of every character it refuses and of every foreign
# word, and until 2026-10-07 each asking was a walk: back to the line's
# start for a quote before the character, and on to the line's end reading
# the strings after it. A line of 4,000 refused characters walked it 4,000
# times, and `check` retired about a million instructions a character there
# (4.3 billion at 4,000 against 0.39 at 1,000), its square.
#
# So each half is read once a line and kept, and no further than the walks
# read. A line's quotes are read back from the character asked about, to
# the line's start or to where the last question on it read to
# (`quoted_before`). The walk's answers are read for the whole line asked
# about, from its end back, each offset's from the offsets after it
# (`answers`), so a line of questions reads its line once where each read
# the rest of it. A walk goes on past its line's end only inside a string,
# a `\` before the line end taking it, and the answers from the starts of
# the run of lines it is carried onto are read once and kept (`carried`),
# so such a run is read once too. A text with no refused character past a
# quote on its line is never read for the walk at all.
#
# **The answer is the walk's, kept exactly**, since the repair moves no
# message: read on from the character after the one asked about, outside
# every string, a `"` opens one, inside one a `\` takes the byte after it,
# a line end included, and a `"` closes it, and a `#` outside every string
# ends the reading as a comment. Its test holds the reading to that walk at
# every offset of texts that reach each of its turns, asked in order and
# out of it.
#
# | entry | called by |
# |---|---|
# | `unread` | `text_outline.unread`, `text_outline.outline_of` |
# | `lost` | `lost_quote.lost_in` |

## The reading

record Reading
    # The length of the text the reading belongs to, -1 before the first
    # question: the text itself is never a field (the Cyclone rule), so this
    # is what tells a reading asked about another text, which `lost` refuses
    # aloud, as `text_outline.read` does.
    length: i64
    # The line last asked about: its start, how far it has been read for
    # quotes, and the first of them, `"` or `'`, or -1.
    line: i64
    seen: i64
    quote: i64
    # The line whose walk's answers are read, from `start` to `end`, its
    # line end or the text's length, -1 before any: the answer from offset
    # `i`, outside every string, at `end - i`.
    start: i64
    end: i64
    outside: [bool]
    # The last run of lines a walk is carried onto, a `\` before the end of
    # each but the last: their starts, ascending, and the walk's answer from
    # each begun inside a string, at the same place.
    run: [i64]
    run_inside: [bool]

# The answers from one line: from each offset outside every string, at
# `end - i`, and from its start inside one.
record Answers
    outside: [bool]
    inside: bool

# A reading nothing has asked for yet.
function unread() -> Reading
    none: [bool] = []
    starts: [i64] = []
    return Reading(
        length: -1,
        line: 0,
        seen: 0,
        quote: -1,
        start: -1,
        end: -1,
        outside: none,
        run: starts,
        run_inside: none
    )

# Whether the character at `at` stands past a quote on its line, and its
# line ends inside a literal that never closes, read on from it as the lexer
# reads (`lost_quote.lost_in`).
function lost(@r: Reading, text: str, at: i64) -> bool
    if r.length < 0
        r.length @ text.len()

    # One reading belongs to one text, and nothing but a mistake in this
    # compiler hands it another: aloud, rather than answers about the wrong
    # lines.
    assert r.length == text.len()

    if !quoted_before(@r, text, at: at) || at + 1 >= text.len()
        return false

    # The walk reads from the byte after `at`, on the line `quoted_before`
    # has found, or on the next where `at` is a line's end: the scanner asks
    # of no line end, and the walk is answered there too.
    from = at + 1
    line: i64 @ r.line

    if text[at] == '\n'
        line @ from

    if r.start != line
        end: i64 @ from

        while end < text.len() && text[end] != '\n'
            end @ end + 1

        got = answers(text, start: line, end: end, beyond: below(@r, text, start: line, end: end), kept: true)
        r.start @ line
        r.end @ end
        r.outside @ got.outside
    return r.outside[r.end - from]

## Reading it

# Whether a quote, `"` or `'`, stands on the line of `at` before it. The
# line read last is kept with how far it was read and its first quote, so a
# question past that reads back only to there, and a question on another
# line reads back to that line's start.
function quoted_before(@r: Reading, text: str, at: i64) -> bool
    if at >= r.line && at <= r.seen
        return r.quote >= 0 && r.quote < at
    floor: i64 @ 0

    if at > r.seen
        floor @ r.seen
    i: i64 @ at
    first: i64 @ -1

    while i > floor && text[i - 1] != '\n'
        i @ i - 1

        if text[i] == '"' || text[i] == '\''
            first @ i

    # Back to where the line was read to, which holds no line end: the same
    # line, its first quote the one read before or the first read now.
    if at > r.seen && i == floor
        if r.quote < 0
            r.quote @ first
    else
        r.line @ i
        r.quote @ first
    r.seen @ at
    return r.quote >= 0 && r.quote < at

# The walk's answer from every offset of the line from `start` to `end`,
# from its end back: outside a string, the line's end or a `#` ends it
# outside one and a `"` goes on inside one from the next byte; inside one,
# the line's end ends it inside, a `\` goes on two bytes on, `beyond` past
# the line's end, and a `"` goes on outside from the next byte; any other
# byte goes on from the next one as it was. The answers outside a string
# are kept where `kept` asks, and a line read for its start alone keeps
# none.
function answers(text: str, start: i64, end: i64, beyond: bool, kept: bool) -> Answers
    out: [bool] @ [false]
    next: bool @ false
    inside: bool @ true
    after: bool @ beyond
    i: i64 @ end

    while i > start
        i @ i - 1
        b = text[i]
        outside: bool @ next
        within: bool @ inside

        if b == '\\'
            within @ after
        else if b == '"'
            outside @ inside
            within @ next
        else if b == '#'
            outside @ false

        if kept
            out @ out.push(outside)
        next @ outside
        after @ inside
        inside @ within

    return Answers(outside: out, inside: inside)

# The walk's answer begun inside a string past the end of the line from
# `start` to `end`, where a `\` before its line end carries a walk there,
# and `true` where nothing can: the text's end ends it inside a string.
function below(@r: Reading, text: str, start: i64, end: i64) -> bool
    if end >= text.len() || end == start || text[end - 1] != '\\'
        return true
    return carried(@r, text, at: end + 1)

# The walk's answer begun inside a string from the start of the line at
# `at`, from the last run read where it holds that line, and otherwise from
# a run read from it: the lines below it that a `\` before each one's end
# carries a walk onto, found first, and their answers read from the last
# back, each from the one below it, so no line of a run is read twice.
function carried(@r: Reading, text: str, at: i64) -> bool
    if at >= text.len()
        return true
    held = at_most(r.run, at: at)

    if held >= 0 && r.run[held] == at
        return r.run_inside[held]
    starts: [i64] @ []
    ends: [i64] @ []
    s: i64 @ at

    while true
        e: i64 @ s

        while e < text.len() && text[e] != '\n'
            e @ e + 1

        starts @ starts.push(s)
        ends @ ends.push(e)

        if e >= text.len() - 1 || e == s || text[e - 1] != '\\'
            break
        s @ e + 1

    # The last line's walk ends on it or at the text's end, which ends it
    # inside a string; each line above goes on from the one below it.
    backward: [bool] @ []
    beyond: bool @ true
    k: i64 @ starts.len() - 1

    while k >= 0
        beyond @ answers(text, start: starts[k], end: ends[k], beyond: beyond, kept: false).inside
        backward @ backward.push(beyond)
        k @ k - 1

    inside: [bool] @ []
    k @ backward.len() - 1

    while k >= 0
        inside @ inside.push(backward[k])
        k @ k - 1

    r.run @ starts
    r.run_inside @ inside
    return inside[0]

# The index of the last of `ascending` that is at most `at`, or -1.
function at_most(ascending: [i64], at: i64) -> i64
    low: i64 @ 0
    high: i64 @ ascending.len()

    while low < high
        middle = (low + high) / 2

        if ascending[middle] <= at
            low @ middle + 1
        else
            high @ middle

    return low - 1

## Tests

# The walk this module replaces, kept as the definition its answers are held
# to: a quote before `at` on its line, and the reading on from the byte
# after it.
function walked(text: str, at: i64) -> bool
    start: i64 @ at

    while start > 0 && text[start - 1] != '\n'
        start @ start - 1

    quoted: bool @ false
    q: i64 @ start

    while q < at
        if text[q] == '"' || text[q] == '\''
            quoted @ true
        q @ q + 1

    if !quoted
        return false
    inside: bool @ false
    i: i64 @ at + 1

    while i < text.len() && text[i] != '\n'
        b = text[i]

        if inside && b == '\\'
            i @ i + 1
        else if b == '"'
            inside @ !inside
        else if !inside && b == '#'
            return false
        i @ i + 1

    return inside

test "the reading answers as the walk does at every offset, in order and out of it"
    texts: [str] = [
        "x == \"  || x == \"\\t\" || y\n"
        "x = a \\ b + \"c\n"
        "x == \"a\" \\ \"b\"\n"
        "x == \"a\" \\ # \"b\n"
        "g(\"a, \"b\") $ $\nh('c') \"d $ \"e\\\nf\" $ \"g\n"
        "s = \"a\" € \"b\\\n\"c\" € \"d\n€ \"e\" # \"f\n"
        "\"\"\"\"$\"$\"$\n\n$\"\\\\\"$\"\\\"$"
        "a \"$ \"b\\\nc \"d\\\ne\\\nf\" $ \"g\\\n"
        "\"$\\\n\\\n\\\n\"\n$\"\\"
    ]

    for text in texts
        forward: Reading @ unread()
        at: i64 @ 0

        while at < text.len()
            assert lost(@forward, text, at: at) == walked(text, at: at)
            at @ at + 1

        # Asked from the end back, each line is read again, and a line a
        # walk is carried onto is read once.
        backward: Reading @ unread()
        at @ text.len() - 1

        while at >= 0
            assert lost(@backward, text, at: at) == walked(text, at: at)
            at @ at - 1

        # And every other offset, then the ones between, from the end back.
        skipping: Reading @ unread()
        at @ 0

        while at < text.len()
            assert lost(@skipping, text, at: at) == walked(text, at: at)
            at @ at + 2

        at @ text.len() - 1

        while at >= 0
            assert lost(@skipping, text, at: at) == walked(text, at: at)
            at @ at - 2

test "no more is read than the questions ask"
    r: Reading @ unread()
    assert !lost(@r, "$ $ $\n", at: 2)
    assert r.start == -1
    assert r.seen == 2

    # The walk's answers are read for the line asked about and no other.
    text = "x \"a\" $ \"b\nc \"d\" $\n"
    t: Reading @ unread()
    assert lost(@t, text, at: 6)
    assert t.start == 0
    assert t.end == 10
    assert t.outside.len() == 11
    assert t.run.len() == 0

    # A line a `\` inside a string carries the walk past is read for that.
    u: Reading @ unread()
    assert !lost(@u, "a \"b\" $ \"c\\\nd\" e\n", at: 6)
    assert u.run == [12]
