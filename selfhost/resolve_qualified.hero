# Qualified names: `geom.dist2(a: p, b: q)` and `geom.Point(x: 3, y: 4)`
# (M-module-namespace, panel 031).
# Port of crates/heroes/src/resolve/qualified.rs.
#
# Three tokens with two meanings. `x.f(y)` is UFCS — sugar for `f(x, y)` —
# and `geom.f(y)` is a name from another module, and the surface syntax is
# identical. This file is where the two are told apart, and the answer is
# cheap for one reason: **`use` binds** (panel 031 R3), so the resolver
# already knows `geom` is a module and does not have to guess.
#
# The decision is made BEFORE the receiver is resolved as a value, which is
# the whole trick: a module has no type and is in no scope, so anything
# that types the receiver first reports `geom` as an unknown name and never
# reaches the point. It is recorded on the receiver as the module case,
# once, because Part 5 erases UFCS in the frontend and a later pass
# re-deciding it would give the erased call the other meaning.
#
# The other half is `elsewhere`, which is what the spec bought instead of a
# sentence about qualification: an unqualified name that exists in another
# module is an error carrying the repair, at the call site (panel 031 R5).

use token
use diag
use ast
use source
use resolved
use resolve_state
use resolve_errors
use module_errors
use resolve_binding

# `geom.f(...)` — the receiver is a module this file names. Returns whether
# it handled the expression; everything it does not handle falls through to
# UFCS, which is the ordinary meaning of a dot.
function qualified(@r: resolve_state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], at: i64, receiver: i64, called: token.Span) -> bool
    found_module = module_at(r, a, s, receiver)

    if found_module.is_err()
        return false
    module = found_module.must()
    resolve_state.keyed_add(@r.module_reads, module: r.module, name: module)
    resolve_state.record_use(@r, at: receiver, to: .module)
    text = source.span_text(s, called)
    found = resolved.top_in(r.out, module: module, name: text)

    if !found.is_err()
        decl = found.must()

        match decls[decl].kind
            .variant_decl => resolve_state.push_diagnostic(
                @r,
                resolve_errors.variant_in_value_position(text, span: called)
            )
            .function_decl fd =>
                # Panel 033 R5, M-separate-compilation row 1: an extern is
                # never callable across a module boundary. The gate sits on
                # the REFERENCE, not the call, because this one point sees
                # every qualified mention — a call, and the function taken
                # as a value, whose address needs the header all the same.
                # A group's records and constants stay reachable: their C
                # is compiler-written on both sides, so the header is only
                # needed where they are declared.
                if fd.value.is_extern
                    resolve_state.push_diagnostic(
                        @r,
                        module_errors.extern_across_modules(name: text, module: module, is_library: false, span: called)
                    )
                else
                    resolve_state.record_use(@r, at: at, to: .top(at: decl))
            .record_decl | .constant_decl | .test_decl => resolve_state.record_use(@r, at: at, to: .top(at: decl))

        return true
    names = resolved.names_in(r.out, module)
    near = resolve_state.near_names(@r, text, names)

    # The qualifier is read off the RECEIVER, which is the name the author
    # actually wrote — their `as` name where they gave one. Deriving it from
    # the module instead is how this diagnostic offered `sqlite.open_db` to a
    # file that calls the module `s`, and offered it as a **certain** fix
    # (panel 101's ffi-pragmatist, measured on the working tree: applying it
    # verbatim gave exit 1 and two new errors). §8 says only `certain` is
    # machine-applicable, so a certain fix that does not compile is the one
    # thing a fix may never be.
    wrote = source.span_text(s, a.exprs[receiver].span)
    resolve_state.push_diagnostic(
        @r,
        module_errors.not_in_module(module: module, qualifier: wrote, name: text, near: near, span: called)
    )
    return true

# The module this expression names, if it names one.
#
# Three conditions and they are all about THIS expression: it is a bare
# name, no local of that name is in scope, and this file `use`s it. The
# second is not an ambiguity to resolve — a local named after a module is
# the shadowing error, reported where the local is bound — it simply means
# the dot beside it is UFCS.
#
# One function because three walks ask the same question: a qualified call,
# a qualified constant, and a write to one.
function module_at(r: resolve_state.Resolver, a: ast.Ast, s: source.Source, id: i64) -> str?
    if !is_bare_name(a, id)
        return fail("absent", "only a bare name can name a module")
    name = source.span_text(s, a.exprs[id].span)

    if !resolve_state.lookup_local(r, name).is_err()
        return fail("absent", "a local of this name is in scope, so the dot is UFCS")

    # The name written at the call site is a BINDING, which for a path is
    # its last part — `use syntax/decl` then `decl.foo()`. What leaves here
    # is the module's whole name, because that is the identity every later
    # lookup uses: `top_in`'s key and the mangler's component are both built
    # from it (panel 099 R3, and `module_paths.last_parts_collide` is what
    # makes the answer unique).
    return resolved.used_module_named(r.out, from: r.module, binding: name)

# `_` is forbidden on a variant, so the twenty other cases are named — the
# price §4.7 charges so that a twenty-second ExprKind stops this function
# from compiling instead of quietly answering false.
function is_bare_name(a: ast.Ast, id: i64) -> bool
    return match a.exprs[id].kind
        .name                                                    => true
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => false
        .null_ptr | .hole | .unary | .binary | .field            => false
        .index | .call | .method | .variant_case | .array        => false
        .map | .try_expr | .if_expr | .match_expr | .error       => false

# The name is real and lives somewhere else. Panel 031 R5's diagnostic,
# which is what the spec buys instead of a sentence about qualification.
function name_declared_elsewhere(@r: resolve_state.Resolver, text: str, span: token.Span) -> diag.Diagnostic?
    found = resolved.module_declaring(r.out, from: r.module, name: text)

    if found.is_err()
        return fail("absent", "no other module declares this name")
    module = found.must()

    if module == r.module || module == source.LIBRARY_MODULE
        return fail("absent", "its home is already visible from here")

    local = resolved.binding_in(r.out, from: r.module, module: module)

    if !local.is_err()
        resolve_state.keyed_add(@r.module_reads, module: r.module, name: module)

        # The qualifier is what THIS FILE calls the module, which is its `as`
        # name where it has one (panel 100). Getting this from the module's
        # own name is how panel 100's engineer produced a diagnostic that
        # said *"`use main` binds `main`"* about a line reading
        # `use shapes/other as main` — a message describing a line the author
        # never wrote.
        return ok(module_errors.needs_qualifying(name: text, qualifier: local.must(), module: module, span: span))
    return ok(module_errors.needs_a_use(name: text, module: module, span: span))

## Tests

# The text is the name table: `geom` at 0, `dist2` at 5, `x` at 11.
function fixture() -> source.Source
    return source.new_source(name: "t.hero", text: "geom dist2 x\n")

function name_expr(@a: ast.Ast, start: i64, end: i64) -> i64
    return ast.push_expr(@a.exprs, ast.Expr(kind: .name, span: token.Span(start: start, end: end)))

function a_function_decl(name_start: i64, name_end: i64) -> ast.Decl
    doc: [token.Span] = []
    ps: [ast.Param] = []
    gs: [token.Span] = []
    f = ast.FunctionDecl(
        generics: gs,
        params: ps,
        result: 0,
        body: fail("absent", "unused"),
        is_extern: false,
        header: fail("absent", "none"),
        library: fail("absent", "none")
    )
    span = token.Span(start: name_start, end: name_end)
    return ast.Decl(name: span, doc: doc, span: span, kind: .function_decl(value: f))

function an_extern_decl(name_start: i64, name_end: i64) -> ast.Decl
    doc: [token.Span] = []
    ps: [ast.Param] = []
    gs: [token.Span] = []
    f = ast.FunctionDecl(
        generics: gs,
        params: ps,
        result: 0,
        body: fail("absent", "unused"),
        is_extern: true,
        header: ok(token.Span(start: 0, end: 4)),
        library: fail("absent", "none")
    )
    span = token.Span(start: name_start, end: name_end)
    return ast.Decl(name: span, doc: doc, span: span, kind: .function_decl(value: f))

test "a module in receiver position is decided before values are"
    s = fixture()
    a: ast.Ast @ ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 5, end: 10)
    decls: [ast.Decl] @ [a_function_decl(name_start: 5, name_end: 10)]
    r: resolve_state.Resolver @ resolve_state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert handled
    assert r.out.diagnostics.len() == 0
    assert r.out.uses[receiver] == .module
    assert r.out.uses[call_node] == .top(at: 0)

test "a qualified extern is refused — the reference, so call and value alike"
    s = fixture()
    a: ast.Ast @ ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 5, end: 10)
    decls: [ast.Decl] @ [an_extern_decl(name_start: 5, name_end: 10)]
    r: resolve_state.Resolver @ resolve_state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert handled
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "extern_across_modules"

test "a local wearing the module's name turns the dot back into UFCS"
    s = fixture()
    a: ast.Ast @ ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    decls: [ast.Decl] = []
    r: resolve_state.Resolver @ resolve_state.new_resolver(expr_count: 1, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolve_state.open_scope(@r)
    _ = resolve_state.declare(
        @r,
        s,
        decls,
        token.Span(start: 0, end: 4),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    handled = qualified(@r, a, s, decls, at: 0, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert !handled

test "a name the module does not declare earns the module's own list"
    s = fixture()
    a: ast.Ast @ ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 11, end: 12)
    decls: [ast.Decl] @ [a_function_decl(name_start: 5, name_end: 10)]
    r: resolve_state.Resolver @ resolve_state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 11, end: 12))
    assert handled
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_in_module"

test "elsewhere splits on the use line, certain against guess"
    r: resolve_state.Resolver @ resolve_state.new_resolver(expr_count: 0, type_count: 0)
    r.module @ "t"
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    span = token.Span(start: 5, end: 10)

    # No use line yet: the fix is a guess, the file still needs the use.
    missing = name_declared_elsewhere(@r, "dist2", span)
    assert missing.must().fixes[0].certainty == .guess

    # With the use written, the same name earns the certain rewrite.
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    have = name_declared_elsewhere(@r, "dist2", span)
    assert have.must().fixes[0].certainty == .certain
    assert have.must().fixes[0].replacement == "geom.dist2"

    # A name only the library declares is not "elsewhere".
    resolved.declare_top(@r.out, module: "library", name: "range", decl: 1)
    quiet = name_declared_elsewhere(@r, "range", span)
    assert quiet.is_err()
