# Whether the constants' bodies are circular (design.md §4.2, §4.16; panel
# 039). Port of archive/bootstrap-rs/heroes/src/resolve/cycles.rs; what a
# body may contain, constbody.rs, is `resolve/constant_body.hero`, out of this
# module on 2026-10-05 (defect 363) with the helpers both ask, which is what
# had held the two in one knot.
#
# ## Why a cycle is an error only where a constant is on it
#
# `constant A` defined as `B` and `B` as `A` used to pass every gate and
# died by SIGSEGV at -O0 and a hang at -O2 — one program, two failure
# modes, chosen by a flag nobody typed. Functions may recur freely (§4.2):
# a recursive function has arguments and a base case; a constant's
# accessor takes nothing, so nothing about the second call can differ from
# the first. The walk is ITERATIVE like the Rust side's, and not by
# coincidence: the check that prevents a hang is the one that historically
# hangs (rustc #84611, Nim #13715, Zig #21436).
#
# The two checks stay coupled through one value — the constants whose bodies
# were already refused, a flag per declaration — because a cycle through a
# refused body is a consequence, not a finding, and reporting both is the
# two-diagnostics-for-one-mistake defect.

use diag
use ast
use source
use resolved
use parse
use resolve/state
use resolve/top
use resolve/decls as resolve_decls
use resolve/constant_body

## Both checks, in the order a reader wants them

function report(@out: resolved.Resolved, a: ast.Ast, s: source.Source, decls: [ast.Decl])
    extent = constant_body.extents(decls)
    refused = constant_body.bodies(@out, a, s, decls, extent)
    adjacent = edges(out, a, decls, extent)

    for cycle in walk(decls, adjacent)
        # A cycle through a body that was already refused is a consequence:
        # the body rule is the primary one — it names the line the author
        # wrote.
        tainted: bool @= false

        for member in cycle
            if refused[member]
                tainted @ true

        if !tainted
            state.append_diagnostic(@out.diagnostics, diagnose(a, s, decls, cycle))

## The edges, and the walk over them

# Every "the body of `from` reads `to`" edge, deduplicated — the dedup is
# what keeps a constant read fifty times from being fifty edges. Each edge
# is asked once of a set keyed by both ends and grown in place on its lent
# list, where each read scanned its declaration's list and copied it to
# push, the square of what one body reads (defect 374).
# ORDER: each adjacency list ascending — adjacency order drives the DFS,
# which decides the rotation the diagnostic names (the Rust BTreeSet gave
# this for free; the port pays with one sort per list, §4.9's sentence).
function edges(out: resolved.Resolved, a: ast.Ast, decls: [ast.Decl], extent: [constant_body.Extent]) -> [[i64]]
    adjacent: [[i64]] @= []
    i: i64 @= 0

    while i < decls.len()
        empty: [i64] = []
        adjacent @ adjacent.push(empty)
        i @ i + 1

    count = a.exprs.len()
    idx: i64 @= 0
    seen: {i64: bool} @= {}

    while idx < count
        here = idx
        idx @ idx + 1

        to = match out.uses[here]
            .top t                                    => t.at
            .unresolved | .local | .builtin | .module => continue

        from = constant_body.owner(extent, a.exprs[here].span.start)

        if !from.is_err()
            home = from.must()
            key = home * decls.len() + to

            if seen[key].is_err()
                seen[key] @ true
                add_edge(@adjacent[home], to: to)

    sorted: [[i64]] @= []

    for list in adjacent
        sorted @ sorted.push(sort(list))

    return sorted

function add_edge(@list: [i64], to: i64)
    list @ list.push(to)

record PathStep
    node: i64
    taken: i64

# Iterative depth-first search; one cycle per distinct set of declarations.
# Colours rather than a visited flag: grey means "on the current path",
# and that is what tells a back edge from a diamond — two constants that
# both read a third are not a cycle.
function walk(decls: [ast.Decl], adjacent: [[i64]]) -> [[i64]]
    colour: [i64] @= []
    i: i64 @= 0

    while i < decls.len()
        colour @ colour.push(0)
        i @ i + 1

    found: [[i64]] @= []
    seen: {str: bool} @= {}
    root: i64 @= 0

    # The path is a stack and its height, its steps written over as it grows
    # again: popped by a slice, it was copied whole at every step, the
    # square of a chain's length (defect 374).
    path: [PathStep] @= []
    height: i64 @= 0

    while root < decls.len()
        if colour[root] != 0
            root @ root + 1
            continue
        height @ put_step(@path, at: 0, step: PathStep(node: root, taken: 0))
        colour[root] @ 1

        while height > 0
            frame = path[height - 1]

            if frame.taken >= adjacent[frame.node].len()
                colour[frame.node] @ 2
                height @ height - 1
                continue
            next = adjacent[frame.node][frame.taken]
            path[height - 1] @ PathStep(node: frame.node, taken: frame.taken + 1)

            if colour[next] == 1
                # The cycle is the suffix of the path from `next` on — no
                # second search, because the path IS the reconstruction.
                at: i64 @= 0
                j: i64 @= 0

                while j < height
                    if path[j].node == next
                        at @ j
                    j @ j + 1

                cycle: [i64] @= []
                k: i64 @= at

                while k < height
                    node = path[k].node
                    cycle @ cycle.push(node)
                    k @ k + 1

                constant_on_it: bool @= false

                for member in cycle
                    if constant_body.is_valued_constant(decls, member)
                        constant_on_it @ true

                if constant_on_it
                    key = cycle_key(cycle)

                    if seen[key].is_err()
                        seen[key] @ true
                        found @ found.push(cycle)
            else if colour[next] == 0
                colour[next] @ 1
                height @ put_step(@path, at: height, step: PathStep(node: next, taken: 0))

        root @ root + 1

    return found

# The step `step` at `at` of the path, over a step a pop left or past them
# all, and the path's new height.
function put_step(@path: [PathStep], at: i64, step: PathStep) -> i64
    if at < path.len()
        path[at] @ step
    else
        path @ path.push(step)
    return at + 1

# One cycle per SET: the key sorts the members, so two rotations of one
# cycle collapse. `/` cannot occur in a rendered index.
function cycle_key(cycle: [i64]) -> str
    rendered: [str] @= []

    for member in sort(cycle)
        rendered @ rendered.push(member.to_str())

    return rendered.join("/")

## The message, anchored at the constant nearest the top of the file

# Deterministic on purpose: the traversal decides which ROTATION of a
# cycle it finds, and a diagnostic that moved between runs would move a
# `#~ constant_cycle` annotation with it. The set is what the traversal
# cannot change, so the anchor is chosen from the set.
function diagnose(a: ast.Ast, s: source.Source, decls: [ast.Decl], cycle: [i64]) -> diag.Diagnostic
    _ = a
    anchor: i64 @= cycle[0]
    best: i64 @= -1

    for member in cycle
        if constant_body.is_valued_constant(decls, member)
            start = decls[member].name.start

            if best < 0 || start < best
                best @ start
                anchor @ member

    span = decls[anchor].name
    holder = source.span_text(s, span)
    direct = cycle.len() == 1
    message: str @= "`constant " + holder + "` is defined as itself, so it has no value"

    if !direct
        through: [str] @= []

        for member in cycle
            if member != anchor
                through @ through.push(source.span_text(s, decls[member].name))

        message @ "`constant " + holder + "` is defined in terms of itself through `" + through.join("`, `") + "`, so it has no value"
    d: diag.Diagnostic @= diag.new_diagnostic(code: "constant_cycle", message: message, span: span)

    if !direct
        # Printed from the anchor round to the anchor, whatever rotation
        # the walk found it in, so the note reads as the reader's own file
        # does.
        at: i64 @= 0
        j: i64 @= 0

        for member in cycle
            if member == anchor
                at @ j
            j @ j + 1

        steps: [str] @= []
        k: i64 @= at

        while k < cycle.len()
            steps @ steps.push(source.span_text(s, decls[cycle[k]].name))
            k @ k + 1

        m: i64 @= 0

        while m < at
            steps @ steps.push(source.span_text(s, decls[cycle[m]].name))
            m @ m + 1

        steps @ steps.push(holder)
        d.notes @ d.notes.push("the cycle is: " + steps.join(" reads "))
    d.notes @ d.notes.push(
        "a `constant`'s value is computed by reading it, and its accessor takes no arguments — so nothing about the second call could differ from the first"
    )
    d.notes @ d.notes.push("functions may recur freely (§4.2); a cycle is an error only where a `constant` is on it")
    d.fixes @ d.fixes.push(
        diag.Fix(title: "give `" + holder + "` a value that does not read the others", replacement: "", span: span, certainty: .guess)
    )
    return d

## Tests

function checked_file(text: str) -> state.Resolver
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    r: state.Resolver @= state.new_resolver(
        expr_count: p.tree.exprs.len(),
        type_count: p.tree.types.len()
    )
    r.module @ "t"
    top.collect(@r, s, p.decls, p.uses)
    index: i64 @= 0

    for d in p.decls
        _ = d
        resolve_decls.declaration(@r, p.tree, s, p.decls, index)
        index @ index + 1

    report(@r.out, p.tree, s, p.decls)
    return r

test "a call in a constant's body is refused once, at the outermost"
    r = checked_file("constant ARGC: i64\n    len(args())\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "constant_body"
    assert r.out.diagnostics[0].message == "`constant ARGC`'s body may not contain a call — it may only read literals and other constants"
    dotted = checked_file("constant N: i64\n    \"abc\".len()\n")
    assert dotted.out.diagnostics.len() == 1
    assert dotted.out.diagnostics[0].message == "`constant N`'s body may not contain a call written with `.` — it may only read literals and other constants"

# Defect 363: two constants, one with two offenders side by side, three
# refusals through the report, the sweep in `resolve/constant_body`.
test "each outermost offender of each body is refused, side by side included"
    twice = checked_file("constant A: i64\n    len(args())\n\nconstant B: i64\n    len(args()) + len(args())\n")
    assert twice.out.diagnostics.len() == 3

    for d in twice.out.diagnostics
        assert d.code == "constant_body"

test "a constant defined as itself has no value"
    r = checked_file("constant A: i64\n    A\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "constant_cycle"
    assert r.out.diagnostics[0].message == "`constant A` is defined as itself, so it has no value"

test "a mutual cycle is one finding, anchored at the first constant"
    r = checked_file("constant A: i64\n    B\n\nconstant B: i64\n    A\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].message == "`constant A` is defined in terms of itself through `B`, so it has no value"
    assert r.out.diagnostics[0].notes[0] == "the cycle is: A reads B reads A"
    assert r.out.diagnostics[0].fixes[0].certainty == .guess

test "a cycle may leave the constants and come back"
    # `A` reads `f` as a VALUE (no call, so constbody stays quiet), and
    # `f`'s body reads `A`: the same defect wearing a function.
    r = checked_file("constant A: i64\n    f\n\nfunction f() -> i64\n    return A\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "constant_cycle"

test "functions recur freely, and a diamond is not a cycle"
    free = checked_file("function f(n: i64) -> i64\n    return g(n)\n\nfunction g(n: i64) -> i64\n    return f(n)\n")
    assert free.out.diagnostics.len() == 0
    diamond = checked_file("constant C: i64\n    1\n\nconstant A: i64\n    C\n\nconstant B: i64\n    C\n")
    assert diamond.out.diagnostics.len() == 0

test "a cycle through a refused body is a consequence, not a finding"
    r = checked_file("constant T: i64\n    depends()\n\nfunction depends() -> i64\n    return T\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "constant_body"
