# One declaration at a time: its generics, its signature, its body (§4.2
# the entities, §4.12 generics, §4.18 `test`, §4.19 `extern`).
# Port of archive/bootstrap-rs/heroes/src/resolve/decls.rs.
#
# Every declaration starts from an empty scope stack. That is the point of
# the top-level table: nothing a function binds can be seen by another
# function, so a file's declarations can be resolved in any order — which
# is what "declaration order never matters" means once you are the
# compiler.
#
# **An `extern`'s parameters are not bindings.** Its body is in C (§4.19),
# so its parameter names can never be read, and declaring them would make
# every FFI declaration in the file an unused-binding error. Their TYPES
# are resolved: `extern function sqrt(x: f64) -> f64` must still name
# types that exist, because clang is going to be handed those names.

use ast
use source
use resolved
use resolve/vocab
use inventory
use parse
use resolve/state
use resolve/types
use resolve/errors
use resolve/walk
use resolve/binding as resolve_binding

function declaration(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], index: i64)
    r.generics @ r.generics.slice(from: 0, to: 0)

    match decls[index].kind
        .constant_decl k =>
            types.resolve_type(@r, a, s, decls, k.ty)

            # No body, no scope: an `extern constant` has nothing to resolve
            # below its own type, exactly as an `extern function` has
            # nothing below its signature (§4.19).
            if !k.body.is_err()
                state.open_scope(@r)
                walk.block(@r, a, s, decls, k.body.must())
                state.close_scope(@r)
        .function_decl fd => function_declaration(@r, a, s, decls, fd.value)
        .record_decl rec =>
            for field in rec.fields
                types.resolve_type(@r, a, s, decls, field.ty)
        .variant_decl v =>
            for one_case in v.cases
                for field in one_case.fields
                    types.resolve_type(@r, a, s, decls, field.ty)
        .test_decl t =>
            state.open_scope(@r)
            walk.block(@r, a, s, decls, t.body)
            state.close_scope(@r)

function function_declaration(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], f: ast.FunctionDecl)
    collect_generics(@r, s, decls, f)

    # The signature is resolved before the parameters are bound, so a
    # parameter's type can never accidentally see a parameter's name: types
    # and values are separate namespaces, and this is where that is
    # enforced.
    for param in f.params
        types.resolve_type(@r, a, s, decls, param.ty)

    types.resolve_type(@r, a, s, decls, f.result)

    if f.body.is_err()
        # `extern`: the code is in C, so nothing here binds.
        return
    state.open_scope(@r)

    for param in f.params
        _ = state.declare(
            @r,
            s,
            decls,
            param.name,
            resolve_binding.param_binding(ty: param.ty, mutable: param.mutable)
        )

    walk.block(@r, a, s, decls, f.body.must())
    state.close_scope(@r)

# `function map<A, B>` — the type parameters, in their own namespace
# (§4.12: on functions only, no constraints, always inferred).
#
# They are checked against the same two things a type name is checked
# against — the primitives and the file's own type declarations — because
# `function<i64>` and `function<Point>` are both a name whose meaning is
# already taken, and a type parameter that shadows a record makes every
# type in the signature ambiguous to a reader.
function collect_generics(@r: state.Resolver, s: source.Source, decls: [ast.Decl], f: ast.FunctionDecl)
    position: i64 @ 0

    for span in f.generics
        name = source.span_text(s, span)
        previous = generic_position(r, name)

        if !previous.is_err()
            at = source.elsewhere(s, here: span.start, there: f.generics[previous.must()].start)
            state.push_diagnostic(@r, errors.shadowed(name: name, bound_at: at, span: span))
            position @ position + 1
            continue

        if !vocab.primitive(name).is_err() || !inventory.index_of(name).is_err()
            state.push_diagnostic(@r, errors.builtin_name_taken(name, span: span))
            position @ position + 1
            continue
        top = state.top_visible(r, name)

        if !top.is_err()
            # The library and the author's file share one Source and cannot
            # shadow each other (the whole rule lives in resolve_state):
            # the library's `map<A, B>` must not collide with a user's
            # `record A`.
            declared_at = decls[top.must()].name.start

            if source.is_library(s, span.start) == source.is_library(s, declared_at)
                at = source.elsewhere(s, here: span.start, there: declared_at)
                state.push_diagnostic(
                    @r,
                    errors.shadows_top_level(name: name, declared_at: at, span: span)
                )
                position @ position + 1
                continue
        r.generics @ r.generics.push(state.GenericParam(name: name, position: position))
        position @ position + 1

function generic_position(r: state.Resolver, name: str) -> i64?
    for g in r.generics
        if g.name == name
            return ok(g.position)

    return fail("absent", "no generic of this name yet")

## Tests

# Parse real source, declare the tops, resolve every declaration — the
# shape the driver will take, minus uses and cycles, which land with it.
function resolved_program(text: str) -> state.Resolver
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    r: state.Resolver @ state.new_resolver(
        expr_count: p.tree.exprs.len(),
        type_count: p.tree.types.len()
    )
    r.module @ "t"
    i: i64 @ 0

    for d in p.decls
        resolved.declare_top(@r.out, module: "t", name: source.span_text(s, d.name), decl: i)
        i @ i + 1

    j: i64 @ 0

    for d in p.decls
        _ = d
        declaration(@r, p.tree, s, p.decls, j)
        j @ j + 1

    state.report_unused(@r, s)
    return r

test "a generic is its own namespace, resolved by position"
    r = resolved_program("function id<A>(x: A) -> A\n    return x\n")
    assert r.out.diagnostics.len() == 0

    # Both `A` mentions in the signature resolve to position 0.
    generic_uses: i64 @ 0

    for u in r.out.type_uses
        if u == .generic(at: 0)
            generic_uses @ generic_uses + 1

    assert generic_uses == 2

test "a duplicated generic is shadowing, a reserved one is taken"
    twice = resolved_program("function f<A, A>(x: A) -> A\n    return x\n")
    assert twice.out.diagnostics.len() == 1
    assert twice.out.diagnostics[0].code == "shadowed_binding"
    taken = resolved_program("function f<i64>(x: i64) -> i64\n    return x\n")
    assert taken.out.diagnostics.len() == 1
    assert taken.out.diagnostics[0].code == "builtin_name_taken"
    reserved = resolved_program("function f<sort>(x: i64) -> i64\n    return x\n")
    assert reserved.out.diagnostics.len() == 1
    assert reserved.out.diagnostics[0].code == "builtin_name_taken"

test "an extern's parameters are types to check, never bindings"
    r = resolved_program("extern \"math.h\"\n    function sqrt(x: f64) -> f64\n")

    # No unused-parameter diagnostic: `x` was never bound. Its type WAS
    # resolved, and it is the prim table's f64.
    assert r.out.diagnostics.len() == 0
    prim_uses: i64 @ 0

    for u in r.out.type_uses
        if u == .prim(value: .float_prim(kind: .f64))
            prim_uses @ prim_uses + 1

    assert prim_uses == 2

test "a record's field types are resolved, and a typo is named"
    r = resolved_program("record P\n    x: i64\n    y: Qoint\n\nrecord Point\n    n: i64\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_type"
    assert r.out.diagnostics[0].message == "no type named `Qoint` — did you mean `Point`?"

test "an unused parameter is the sweep's finding, not the walk's"
    r = resolved_program("function f(x: i64)\n    return\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unused_binding"
    assert r.out.diagnostics[0].message == "the parameter `x` is never read — remove it from the signature, or write `???` in the body while the function is unfinished"

test "a constant's body is walked in a scope of its own"
    r = resolved_program("constant M: i64\n    40 + 2\n")
    assert r.out.diagnostics.len() == 0
