# What a call's marks say the author MEANT to write (design.md §4.4 the
# three line shapes, §4.8 `@` parameters, §4.17 one mistake one message;
# spec § 5; panel 209's R1b). A cell nothing re-binds is refused by
# `resolve/unused_sweep.hero`'s sweep, and the sweep must not fire on a cell
# whose write is there in intent and refused or still owed in form:
#
# - `bump(k)` for `function bump(@c: Counter)`: the checker marks `k` with
#   a certain `@` (`marker_mismatch`), so the cell is written once the fix
#   lands, and telling it never re-bound beside that would hand `check
#   --apply` two certain fixes that undo each other (the compiler's own
#   test *a certain fix enclosing another* found it in panel 209's
#   prototype);
# - `g(@n)` for a parameter taking none, `One(x: @n)` for a construction,
#   `f(@n)` for a function value: the `@` is refused, by `built_marks.hero`
#   here or by the checker, and the cell was meant to be written.
#
# A leaf out of `resolve/writes.hero`, which crossed its ceiling the day
# this landed (CLAUDE.md §11): it reads the locals and writes one count, and
# calls nothing in the walker's ring. Only a cell's count moves: a `=`
# binding behind a refused `@` is not written, and its one message is the
# marker's. The name is looked up by its text, as `write_root` does, because
# the marks are read where the callee has just been resolved and the
# arguments not yet.

use ast
use token
use diag
use source
use resolve/state
use resolve/errors
use resolve/binding as resolve_binding

# A field lent to C through `.ptr()` is a place C may write: spec § 13, *C
# writes back through the lend only where the binding is a `@` name*. So
# the cell or `@` parameter at the lend's root counts as written, by C, and
# is not one nothing re-binds (panel 210). `s.cstr()` and `s.lease()` lend
# bytes C only reads, and
# a lease's cell is written by `end_lease(@x)`, an `@` argument.
function lent_for_writing(@r: state.Resolver, a: ast.Ast, s: source.Source, name: token.Span, receiver: i64)
    if source.span_text(s, name) == "ptr"
        meant_write(@r, a, s, receiver)

# The cell or `@` parameter at the root of `id`, a name or a field or index
# path over one, counted as written once: a mutable local, never a `=`
# binding, whose one message is the marker's (panel 210).
function meant_write(@r: state.Resolver, a: ast.Ast, s: source.Source, id: i64)
    match a.exprs[id].kind
        .name =>
            local = state.lookup_local(r, source.span_text(s, a.exprs[id].span))

            if !local.is_err() && r.out.locals[local.must()].mutable
                r.out.locals[local.must()].writes @ r.out.locals[local.must()].writes + 1
        .field f => meant_write(@r, a, s, f.base)
        .index i => meant_write(@r, a, s, i.base)

        .field_name | .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => return
        .hole | .unary | .binary | .call | .method | .variant_case                                   => return
        .array | .map | .try_expr | .if_expr | .match_expr | .error                                  => return

# The arguments `given` read against the parameters from `first` (1 where a
# UFCS receiver is the first parameter), `writes` saying which parameter
# takes an `@`: a cell handed bare where the parameter takes `@`, and a cell
# handed `@` where the parameter takes none or none stands, are each the
# cell the author meant to write.
function meant_by_signature(@r: state.Resolver, a: ast.Ast, s: source.Source, writes: [bool], first: i64, given: [ast.Arg])
    k: i64 @= first

    for arg in given
        takes = k < writes.len() && writes[k]

        if arg.mutable != takes
            meant_write(@r, a, s, arg.value)
        k @ k + 1

# The arguments `given` handed to a parameter that ends or hands on its
# handle (`params`, by position from `first`, 1 behind a UFCS receiver):
# each root that is an `@` parameter is written by the call, spec § 13's
# *mark the parameter `@` and the value does not survive the call* (panel
# 210). A cell's is not: a `=` binding is ended the same way, so a cell only
# ended is still one nothing re-binds.
function ended_by_signature(@r: state.Resolver, a: ast.Ast, s: source.Source, params: [ast.Param], first: i64, given: [ast.Arg])
    if params.len() == 0
        return
    k: i64 @= first

    for arg in given
        if k < params.len() && ends(params[k])
            ended_write(@r, a, s, arg.value)
        k @ k + 1

function ends(p: ast.Param) -> bool
    return p.consumes || !p.transfers.is_err()

# The `@` parameter at the root of `id`, counted as written once.
function ended_write(@r: state.Resolver, a: ast.Ast, s: source.Source, id: i64)
    match a.exprs[id].kind
        .name =>
            local = state.lookup_local(r, source.span_text(s, a.exprs[id].span))

            if !local.is_err() && r.out.locals[local.must()].kind == .param && r.out.locals[local.must()].mutable
                r.out.locals[local.must()].writes @ r.out.locals[local.must()].writes + 1
        .field f => ended_write(@r, a, s, f.base)
        .index i => ended_write(@r, a, s, i.base)

        .field_name | .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => return
        .hole | .unary | .binary | .call | .method | .variant_case                                   => return
        .array | .map | .try_expr | .if_expr | .match_expr | .error                                  => return

# A `@=` that declares no cell, told once: the wildcard's at any type, or a
# re-binding where no type is written (`typed` false). True where told, and
# the walk then declares nothing.
function declares_no_cell(@r: state.Resolver, s: source.Source, name: token.Span, symbol: token.Span, typed: bool) -> bool
    if wildcard_cell(@r, s, name: name, symbol: symbol)
        return true
    return !typed && meant_rebinding(@r, s, name: name, symbol: symbol)

# `v @= e` where `v` is already a mutable local in scope, a cell or an `@`
# parameter: the cell's symbol where its re-binding was meant, a second
# declaration being refused as shadowing anyway (spec § 5). Told once at the
# symbol with the certain fix that writes `@`, the write counted on the local
# it re-binds and the local kept for the checker (defect 625), and nothing
# declared, so the lines below read the one `v`.
# False, and nothing said, where no such local stands.
function meant_rebinding(@r: state.Resolver, s: source.Source, name: token.Span, symbol: token.Span) -> bool
    previous = state.lookup_local(r, source.span_text(s, name))

    if previous.is_err() || !r.out.locals[previous.must()].mutable
        return false
    at = previous.must()
    bound_at = source.elsewhere(s, here: name.start, there: r.out.locals[at].name.start)
    state.push_diagnostic(@r, cell_redeclared(name: source.span_text(s, name), bound_at: bound_at, span: symbol))
    r.out.locals[at].writes @ r.out.locals[at].writes + 1
    r.out.rebinds[name.start] @ at
    return true

# `v = e` binds `v`, unless `v` is already mutable here (below).
function bind(@r: state.Resolver, s: source.Source, decls: [ast.Decl], name: token.Span, ty: i64?, value: i64)
    if !shadows_a_mutable(@r, s, name: name, typed: !ty.is_err())
        _ = state.declare(@r, s, decls, name, resolve_binding.bind_binding(ty: ty, value: value)).is_err()

# `v = e` where `v` is already a mutable local in scope, a cell or an `@`
# parameter (defect 662): refused as any shadow is (spec § 5), and what it was
# meant to be is the local's write, `v @ e`. So the write is counted on the
# local, and the sweep's *nothing writes it* does not tell the one mistake a
# second time, and the refusal offers `@` at the `=` where no type is written:
# a `guess`, since a shadow inside a block meant a name the block alone sees,
# and `@` writes the local past it. Nothing declared, as `state.declare`
# declares nothing for a shadow. False, and nothing said, where no such local
# stands.
function shadows_a_mutable(@r: state.Resolver, s: source.Source, name: token.Span, typed: bool) -> bool
    text = source.span_text(s, name)
    previous = state.lookup_local(r, text)

    if previous.is_err() || !r.out.locals[previous.must()].mutable
        return false
    at = previous.must()
    bound_at = source.elsewhere(s, here: name.start, there: r.out.locals[at].name.start)
    d: diag.Diagnostic @= errors.shadowed(name: text, bound_at: bound_at, span: name)
    k: i64 @= name.end

    while k < s.text.len() && (s.text[k] == ' ' || s.text[k] == '\t')
        k @ k + 1

    if !typed && k < s.text.len() && s.text[k] == '='
        title = "write `@`: change the `" + text + "` bound at " + bound_at + " rather than declare a second"
        d.fixes @ d.fixes.push(
            diag.Fix(title: title, replacement: "@", span: token.Span(start: k, end: k + 1), certainty: .guess)
        )
    state.push_diagnostic(@r, d)
    r.out.locals[at].writes @ r.out.locals[at].writes + 1
    r.out.rebinds[name.start] @ at
    return true

# `_ @= e` or `_: T @= e` (the old `_: T @ e` is the parser's to tell,
# `cell_errors.old_symbol`): a discard written with the cell's symbol, a cell
# nothing can re-bind since `_` binds nothing (spec § 5; defect 608). Told once at the `_` with the certain fix that writes `=`, and
# nothing declared, as `state.declare` declares nothing for `_`. False, and
# nothing said, for any other name.
function wildcard_cell(@r: state.Resolver, s: source.Source, name: token.Span, symbol: token.Span) -> bool
    if name.end - name.start != 1 || source.span_text(s, name) != "_"
        return false
    state.push_diagnostic(@r, errors.never_rebound_wildcard(source.span_text(s, symbol), span: name, symbol: symbol))
    return true

function cell_redeclared(name: str, bound_at: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "cell_redeclared",
        message: "`" + name + "` is already mutable here, declared at " + bound_at + " — `@=` would declare a second `" + name + "`, and a cell is re-bound with `@`: write `" + name + " @ …`",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `@`: re-bind `" + name + "`", replacement: "@", span: span, certainty: .certain)
    )
    return d
