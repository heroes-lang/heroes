# Qualified names: `geom.dist2(a: p, b: q)` and `geom.Point(x: 3, y: 4)`
# (M-module-namespace, panel 031).
# Port of heroes/src/resolve/qualified.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# Three tokens with two meanings. `x.f(y)` is UFCS — sugar for `f(x, y)` —
# and `geom.f(y)` is a name from another module, and the surface syntax is
# identical. This file is where the two are told apart, and the answer is
# cheap for one reason: **`use` binds** (panel 031 R3), so the resolver
# already knows `geom` is a module and does not have to guess.
#
# The decision is made BEFORE the receiver is resolved as a value, which is
# the whole trick: a module has no type and is in no scope, so anything
# that types the receiver first reports `geom` as an unknown name and never
# reaches the point. It is recorded on the receiver as the module case,
# once, because Part 5 erases UFCS in the frontend and a later pass
# re-deciding it would give the erased call the other meaning.
#
# The other half is `elsewhere`, which is what the spec bought instead of a
# sentence about qualification: an unqualified name that exists in another
# module is an error carrying the repair, at the call site (panel 031 R5).

use ast
use diag
use module/diagnostics
use module/package_told
use module/placed
use resolve/binding as resolve_binding
use resolve/did_you_mean
use resolve/errors
use resolve/missing_use
use resolve/offered
use resolve/state
use resolved
use source
use token

# `geom.f(...)` — the receiver is a module this file names. Returns whether
# it handled the expression; everything it does not handle falls through to
# UFCS, which is the ordinary meaning of a dot.
function qualified(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], at: i64, receiver: i64, called: token.Span) -> bool
    found_module = module_at(r, a, s, receiver)

    if found_module.is_err()
        # `strs.holds(…)` beside `strs.hero` and no `use strs`: one message on
        # the qualifier, naming the line the file lacks, and the name after
        # the dot left to the module (defect 2292).
        missing = missing_use.told(r, a, s, receiver, bare: is_bare_name(a, receiver))

        if !missing.is_err()
            state.push_diagnostic(@r, missing.must())
        return !missing.is_err()
    module = found_module.must()
    state.keyed_add(@r.module_reads, module: r.module, name: module)
    state.record_use(@r, at: receiver, to: .module)
    text = source.span_text(s, called)
    found = resolved.top_in(r.out, module: module, name: text)

    if !found.is_err()
        decl = found.must()

        match decls[decl].kind
            .variant_decl => state.push_diagnostic(
                @r,
                errors.variant_in_value_position(text, span: called)
            )
            .function_decl fd =>
                # Panel 033 R5, M-separate-compilation row 1: an extern is
                # never callable across a module boundary. The gate sits on
                # the REFERENCE, not the call, because this one point sees
                # every qualified mention — a call, and the function taken
                # as a value, whose address needs the header all the same.
                # A group's records and constants stay reachable: their C
                # is compiler-written on both sides, so the header is only
                # needed where they are declared.
                if fd.value.is_extern
                    state.push_diagnostic(
                        @r,
                        diagnostics.extern_across_modules(name: text, module: module, is_library: false, span: called)
                    )
                else
                    state.record_use(@r, at: at, to: .top(at: decl))
            .record_decl | .constant_decl | .test_decl => state.record_use(@r, at: at, to: .top(at: decl))

        return true
    names = offered.named(@r.offered, r.out, module: module).names
    near = did_you_mean.near_names(@r, text, [names])

    # The qualifier is read off the RECEIVER, which is the name the author
    # actually wrote — their `as` name where they gave one. Deriving it from
    # the module instead is how this diagnostic offered `sqlite.open_db` to a
    # file that calls the module `s`, and offered it as a **certain** fix
    # (panel 101's ffi-pragmatist, measured on the working tree: applying it
    # verbatim gave exit 1 and two new errors). §8 says only `certain` is
    # machine-applicable, so a certain fix that does not compile is the one
    # thing a fix may never be.
    wrote = source.span_text(s, a.exprs[receiver].span)
    state.push_diagnostic(
        @r,
        diagnostics.not_in_module(module: module, qualifier: wrote, name: text, near: near, span: called)
    )
    return true

# The module this expression names, if it names one.
#
# Three conditions and they are all about THIS expression: it is a bare
# name, no local of that name is in scope, and this file `use`s it. The
# second is not an ambiguity to resolve — a local named after a module is
# the shadowing error, reported where the local is bound — it simply means
# the dot beside it is UFCS.
#
# One function because three walks ask the same question: a qualified call,
# a qualified constant, and a write to one.
function module_at(r: state.Resolver, a: ast.Ast, s: source.Source, id: i64) -> str?
    if !is_bare_name(a, id)
        return fail(code: "absent", msg: "only a bare name can name a module")
    name = source.span_text(s, a.exprs[id].span)

    if !state.lookup_local(r, name).is_err()
        return fail(code: "absent", msg: "a local of this name is in scope, so the dot is UFCS")

    # The name written at the call site is a BINDING, which for a path is
    # its last part — `use syntax/decl` then `decl.foo()`. What leaves here
    # is the module's whole name, because that is the identity every later
    # lookup uses: `top_in`'s key and the mangler's component are both built
    # from it (panel 099 R3, and `paths.last_parts_collide` is what
    # makes the answer unique).
    return resolved.used_module_named(r.out, from: r.module, binding: name)

# `_` is forbidden on a variant, so the twenty other cases are named — the
# price §4.7 charges so that a twenty-second ExprKind stops this function
# from compiling instead of quietly answering false.
function is_bare_name(a: ast.Ast, id: i64) -> bool
    return match a.exprs[id].kind
        .name                                                              => true
        .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit => false
        .null_ptr | .hole | .unary | .binary | .field | .field_name        => false
        .index | .call | .method | .variant_case | .array                  => false
        .map | .try_expr | .if_expr | .match_expr | .error                 => false

# The name is real and lives somewhere else. Panel 031 R5's diagnostic,
# which is what the spec buys instead of a sentence about qualification.
function name_declared_elsewhere(@r: state.Resolver, s: source.Source, text: str, span: token.Span) -> diag.Diagnostic?
    found = resolved.module_declaring(r.out, from: r.module, name: text)

    if found.is_err()
        return fail(code: "absent", msg: "no other module declares this name")
    module = found.must()

    if module == r.module || module == source.LIBRARY_MODULE
        return fail(code: "absent", msg: "its home is already visible from here")

    local = resolved.binding_in(r.out, from: r.module, module: module)

    if !local.is_err()
        state.keyed_add(@r.module_reads, module: r.module, name: module)

        # The qualifier is what THIS FILE calls the module, which is its `as`
        # name where it has one (panel 100). Getting this from the module's
        # own name is how panel 100's engineer produced a diagnostic that
        # said *"`use main` binds `main`"* about a line reading
        # `use shapes/other as main` — a message describing a line the author
        # never wrote.
        return ok(diagnostics.needs_qualifying(name: text, qualifier: local.must(), module: module, span: span))

    # No `use` of this file names a module declaring it. The line to add is
    # the first such module's, in ascending order, that a `use` of this file
    # can name, as this file writes it (defect 2373): in a package's own file
    # its module is bare. Every declaring module is asked (defect 2379):
    # until then only the first was, so `<alpha>/a`, which `core`'s files
    # cannot name, hid `<core>/util`, which `use util` names, and the name
    # was told as unknown with a near name's rename.
    beyond: [str] @= []

    for one in sort(resolved.modules_declaring(r.out))
        if one != r.module && one != source.LIBRARY_MODULE && !resolved.top_in(r.out, module: one, name: text).is_err()
            written = placed.written_in(s.reached.aliases, from: r.module, module: one)

            if written != "" && package_told.reaches(from: r.module, name: one)
                return ok(diagnostics.needs_a_use(name: text, module: one, written: written, span: span))
            beyond @ beyond.push(one)

    # Only modules no `use` of this file can name declare it: a program's,
    # from a package's file; a package's that this one's catalogue does not
    # list; or one private to another (R16). Told with each and why, never
    # a near name's rename, which points away from the cause.
    if beyond.len() == 0
        return fail(code: "absent", msg: "no other module declares this name")
    return ok(diagnostics.out_of_reach(name: text, modules: beyond, s: s, from: r.module, span: span))

## Tests

# The text is the name table: `geom` at 0, `dist2` at 5, `x` at 11.
function fixture() -> source.Source
    return source.new_source(name: "t.hero", text: "geom dist2 x\n")

function name_expr(@a: ast.Ast, start: i64, end: i64) -> i64
    return ast.push_expr(@a.exprs, ast.Expr(kind: .name, span: token.Span(start: start, end: end)))

function a_function_decl(name_start: i64, name_end: i64) -> ast.Decl
    doc: [token.Span] = []
    ps: [ast.Param] = []
    gs: [token.Span] = []
    f = ast.FunctionDecl(
        generics: gs,
        params: ps,
        result: 0,
        body: fail(code: "absent", msg: "unused"),
        is_extern: false,
        header: fail(code: "absent", msg: "none"),
        library: fail(code: "absent", msg: "none"),
        owned_result: fail(code: "none", msg: "nothing to free"),
        acquires_result: fail(code: "none", msg: "nothing to give back"),
        retains_result: fail(code: "none", msg: "nothing to give back"),
        borrows_result: false,
        when_result: fail(code: "none", msg: "no success value"),
        signature_end: token.Span(start: name_start, end: name_end)
    )
    span = token.Span(start: name_start, end: name_end)
    return ast.Decl(name: span, doc: doc, span: span, kind: .function_decl(value: f))

function an_extern_decl(name_start: i64, name_end: i64) -> ast.Decl
    doc: [token.Span] = []
    ps: [ast.Param] = []
    gs: [token.Span] = []
    f = ast.FunctionDecl(
        generics: gs,
        params: ps,
        result: 0,
        body: fail(code: "absent", msg: "unused"),
        is_extern: true,
        header: ok(token.Span(start: 0, end: 4)),
        library: fail(code: "absent", msg: "none"),
        owned_result: fail(code: "none", msg: "nothing to free"),
        acquires_result: fail(code: "none", msg: "nothing to give back"),
        retains_result: fail(code: "none", msg: "nothing to give back"),
        borrows_result: false,
        when_result: fail(code: "none", msg: "no success value"),
        signature_end: token.Span(start: name_start, end: name_end)
    )
    span = token.Span(start: name_start, end: name_end)
    return ast.Decl(name: span, doc: doc, span: span, kind: .function_decl(value: f))

test "a module in receiver position is decided before values are"
    s = fixture()
    a: ast.Ast @= ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 5, end: 10)
    decls: [ast.Decl] = [a_function_decl(name_start: 5, name_end: 10)]
    r: state.Resolver @= state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert handled
    assert r.out.diagnostics.len() == 0
    assert r.out.uses[receiver] == .module
    assert r.out.uses[call_node] == .top(at: 0)

test "a qualified extern is refused — the reference, so call and value alike"
    s = fixture()
    a: ast.Ast @= ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 5, end: 10)
    decls: [ast.Decl] = [an_extern_decl(name_start: 5, name_end: 10)]
    r: state.Resolver @= state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert handled
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "extern_across_modules"

test "a local wearing the module's name turns the dot back into UFCS — in a program already refused"
    # **THIS TEST ASSERTED A DEFECT** until 2026-09-02, under the first half
    # of the name above and no second half. Its assertions are untouched and
    # still hold; what was wrong was the silence around them. It builds the
    # shape by hand — a `use` binding `geom` beside a local `geom` — throws
    # away the answer `declare` gives it, and pins the fallback as correct.
    # It IS correct, and it is now only ever reached in a program the
    # compiler has already refused at the binding, which is the sentence
    # this case was missing (panel 102).
    #
    # Read with the comment at :93-97 above, which asserted the missing
    # refusal as an accomplished fact while nothing reported it: the rule
    # was designed, written down, and never given an executor.
    s = fixture()
    a: ast.Ast @= ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    decls: [ast.Decl] = []
    r: state.Resolver @= state.new_resolver(expr_count: 1, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    state.open_scope(@r)
    assert !state.declare(@r, s, decls, token.Span(start: 0, end: 4), resolve_binding.bind_binding(ty: fail(code: "absent", msg: "inferred"), value: 0)).is_err()
    handled = qualified(@r, a, s, decls, at: 0, receiver: receiver, called: token.Span(start: 5, end: 10))
    assert !handled

test "a name the module does not declare earns the module's own list"
    s = fixture()
    a: ast.Ast @= ast.new_ast()
    receiver = name_expr(@a, start: 0, end: 4)
    call_node = name_expr(@a, start: 11, end: 12)
    decls: [ast.Decl] = [a_function_decl(name_start: 5, name_end: 10)]
    r: state.Resolver @= state.new_resolver(expr_count: 2, type_count: 0)
    r.module @ "t"
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    handled = qualified(@r, a, s, decls, at: call_node, receiver: receiver, called: token.Span(start: 11, end: 12))
    assert handled
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_in_module"

test "elsewhere splits on the use line, and neither repair is certain"
    r: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    r.module @ "t"
    resolved.declare_top(@r.out, module: "geom", name: "dist2", decl: 0)
    span = token.Span(start: 5, end: 10)

    # No use line yet: the fix is a guess, the file still needs the use.
    s = fixture()
    missing = name_declared_elsewhere(@r, s, "dist2", span)
    assert missing.must().fixes[0].certainty == .guess

    # With the use written, the same name earns the rewrite — and since
    # 2026-09-03 that rewrite is a guess too: on `window: ptr` beside
    # `use window` it prepended a qualifier the line already had, and a
    # fix that reproduces itself is no fix (module/diagnostics.hero says
    # the rest; M-robustness-guards step 2).
    resolved.declare_use(@r.out, from: "t", binding: "geom", module: "geom")
    have = name_declared_elsewhere(@r, s, "dist2", span)
    assert have.must().fixes[0].certainty == .guess
    assert have.must().fixes[0].replacement == "geom.dist2"

    # A name only the library declares is not "elsewhere".
    resolved.declare_top(@r.out, module: "library", name: "range", decl: 1)
    quiet = name_declared_elsewhere(@r, s, "range", span)
    assert quiet.is_err()

# Defect 2379: every module declaring the name is asked, and the first a
# `use` of this file can name gets its line; where none can, the name is told
# with each module and why, and no near name is offered.
test "a name only out-of-reach modules declare is told with them, and a nameable one wins"
    s = fixture()
    r: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    r.module @ "<core>/strings"
    span = token.Span(start: 5, end: 10)
    resolved.declare_top(@r.out, module: "other/strings", name: "dist2", decl: 0)
    program = name_declared_elsewhere(@r, s, "dist2", span).must()
    assert program.code == "unknown_name"
    assert program.message == "nothing named `dist2` is in scope, and no `use` of this file can name a module declaring it: `other/strings` is a module of the program, and no file of the package `core` names a module of the program that uses it"
    assert program.fixes.len() == 0
    assert program.notes.len() == 1

    # A package the file's own catalogue does not list sorts first, and the
    # file's own package's module after it is still the answer.
    resolved.declare_top(@r.out, module: "<alpha>/a", name: "dist2", decl: 1)
    resolved.declare_top(@r.out, module: "<core>/util", name: "dist2", decl: 2)
    own = name_declared_elsewhere(@r, s, "dist2", span).must()
    assert own.code == "needs_qualifying"
    assert own.fixes[0].title == "write `util.dist2` (and add `use util`)"

    # A module under another's `internal` folder is no answer either.
    q: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    q.module @ "main"
    resolved.declare_top(@q.out, module: "lib/internal/x", name: "dist2", decl: 0)
    private = name_declared_elsewhere(@q, s, "dist2", span).must()
    assert private.code == "unknown_name"
    assert private.message == "nothing named `dist2` is in scope, and no `use` of this file can name a module declaring it: `lib/internal/x` is private to `lib`"
    q.module @ "lib/words"
    assert name_declared_elsewhere(@q, s, "dist2", span).must().code == "needs_qualifying"
