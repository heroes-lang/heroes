# Every name error the resolver can produce, in one file — because they are
# one diagnostic class and design.md §4.17 judges them together: the error
# carries what is needed to fix the program without opening another file.
# Port of archive/bootstrap-rs/heroes/src/resolve/errors.rs. (errors_modules.rs — the
# module-shaped half — is a later file: it needs nothing here and nothing
# here needs it.)
#
# Two shapes of repair, and the line between them is §4.17's:
#
# - **certain**, machine-applicable: renaming an unread loop variable or
#   payload to `_`, which changes nothing but the name.
# - **guess**, prose for the reader: everything whose repair depends on
#   intent — removing a parameter (its call sites are elsewhere), deleting a
#   binding, or writing the type on a cell the resolver cannot infer. The
#   rename to the one candidate in scope is OFFERED here as a guess too:
#   whether it repairs the mistake is a question about types this pass
#   cannot ask (defect 220: `sqrt` to `sort`, which takes `[T]`), so
#   `rename_fit.hero` makes it certain where the name's letters allow the
#   candidate alone and the program it writes says nothing new.
#
# Wording follows the lexer's house style: what is wrong, then an em-dash
# clause that teaches the rule, then the repair. The message TEXT is the
# Rust side's, byte for byte: two compilers that disagree about a message
# would turn the fixpoint diff into a prose review.

use token
use diag
use resolved

## Names that resolve to nothing

function unknown_name(name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unknown_name",
        message: "nothing named `" + name + "` is in scope",
        span: span
    )
    suggest(@d, near, span)
    return d

# A name nothing binds, on the left of `@` (panel 209's R9): `totl @ total +
# x` with no `totl` declared. The rename stays the fix where a near name
# exists; what the message adds is the shape of the line the author may
# have meant, since a bare `name @ value` never declares (spec § 5), and
# today's message said only that nothing of that name was in scope.
function unknown_place(name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= unknown_name(name, near, span)
    d.notes @ d.notes.push(
        "`" + name + " @ …` changes a cell that already exists; a new cell is declared `" + name + " @= <value>`, and a value bound once with `" + name + " = <value>`"
    )
    return d

# The wildcard on the left of `@`, `_ @ e` or `_.x @ e`: `_` binds nothing
# (spec § 5), so no cell stands under it, `_ @= …` declares none (defect
# 608), and the names one letter from it are no typo it was, so none is
# offered, nor kept from its own `unused_binding` (defect 613).
function wildcard_place(span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "unknown_name",
        message: "`_` binds nothing, so there is no cell for `@` to re-bind there — a value dropped on purpose is written `_ = …`",
        span: span
    )

test "a mutation of a name nothing binds says how a cell is declared"
    d = unknown_place("totl", ["total"], token.Span(start: 0, end: 4))
    assert d.code == "unknown_name"
    assert d.notes.len() == 1
    wildcard = wildcard_place(token.Span(start: 0, end: 1))
    assert wildcard.code == "unknown_name"
    assert wildcard.notes.len() == 0
    assert wildcard.fixes.len() == 0
    assert d.fixes.len() == 1

# A name nothing binds, called (defect 270): `print(sqrt(2.0))` with no
# `extern` was offered `sort` alone, a guess that is true and points away
# from the repair, since a function of C is bound in an `extern` group. The
# note says how, in words true whatever the name is: whether `sqrt` is C's
# is a standard library's knowledge, which this compiler does not hold
# (CLAUDE.md § 13), so the note says *if*, and the rename stays a guess.
function unknown_called(name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= unknown_name(name, near, span)
    d.notes @ d.notes.push(binding_note(name))
    return d

# How a function of C is called: bound in a group of this file, since an
# extern is never reached across a module (panel 033 R5).
function binding_note(name: str) -> str
    return "if `" + name + "` is a function of C, an `extern` group in this file binds it: the group's line names the header, `extern \"<header>.h\"`, and the signature is indented below it, `function " + name + "(…) -> …` (§4.19)"

# `x.f(y)` is `f(x, y)` and nothing else (§4.11: there are no methods), so
# an unknown name after the dot is answerable now — before types exist. It
# is called, so a function of C is offered its binding as a bare name is.
function unknown_function(name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unknown_function",
        message: "no function named `" + name + "` — `x." + name + "(…)` means `" + name + "(x, …)`, so `" + name + "` has to be a top-level function or a built-in",
        span: span
    )
    suggest(@d, near, span)
    d.notes @ d.notes.push(binding_note(name))
    return d

function unknown_type(name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(code: "unknown_type", message: "no type named `" + name + "`", span: span)
    suggest(@d, near, span)
    return d

function not_a_type(name: str, what: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "not_a_type", message: "`" + name + "` is " + what + ", not a type", span: span)

# The name exists and is not a function, so "unknown" would be a lie and a
# did-you-mean would be noise: say what it is instead.
function not_a_function(name: str, what: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "not_a_function",
        message: "`" + name + "` is " + what + ", so `x." + name + "(…)` cannot call it",
        span: span
    )

# A variant name in value position. The cases are the values (§4.5's ⇐
# mode), which is exactly what a model carrying a Rust prior forgets — and
# this port tripped it writing its own tests, which is the diagnostic
# working on the person it was written for.
function variant_in_value_position(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "variant_in_value_position",
        message: "`" + name + "` is a variant, so it names a type and not a value — write one of its cases, `.case` or `.case(field: value)`",
        span: span
    )

## Names declared more than once

function declared_twice(name: str, first: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "declared_twice",
        message: "`" + name + "` is already declared at " + first + " — one file is one module, and a name means one thing in it",
        span: span
    )

function shadowed(name: str, bound_at: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "shadowed_binding",
        message: "`" + name + "` is already in scope, bound at " + bound_at + " — shadowing is an error here: a name means one thing for as long as it is visible",
        span: span
    )

function shadows_top_level(name: str, declared_at: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "shadowed_binding",
        message: "`" + name + "` is the name of the declaration at " + declared_at + ", which is in scope everywhere — pick another name",
        span: span
    )

function builtin_name_taken(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "builtin_name_taken",
        message: "`" + name + "` is a built-in of the language, so the name is taken everywhere — pick another name",
        span: span
    )

function duplicate_pattern_binding(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "duplicate_pattern_binding",
        message: "`" + name + "` is bound by two patterns of the same arm — one arm binds each name once",
        span: span
    )

## Bindings nobody reads

# §4.4's unused rule, and the escape valve is the wildcard: where renaming
# to `_` is legal it is also CERTAIN, because it changes nothing but the
# name.
function unused(name: str, kind: resolved.LocalKind, writes: i64, span: token.Span) -> diag.Diagnostic
    message = match kind
        .param => "the parameter `" + name + "` is never read — remove it from the signature, or write `???` in the body while the function is unfinished"
        .bind => "`" + name + "` is bound and never read — remove the binding, or read it"
        .cell =>
            if writes > 0
                "`" + name + "` is written and never read — a cell nothing reads is a value nobody uses"
            else
                "`" + name + "` is declared and never read — remove it, or read it"
        .loop_var => "the loop variable `" + name + "` is never read — write `for _ in …` when the element is not needed"
        .payload => "the payload `" + name + "` is never read — write `_` in the pattern when the value is not needed"

    d: diag.Diagnostic @= diag.new_diagnostic(code: "unused_binding", message: message, span: span)

    if kind == .loop_var || kind == .payload
        d.fixes @ d.fixes.push(
            diag.Fix(title: "rename `" + name + "` to `_`", replacement: "_", span: span, certainty: .certain)
        )
    return d

## Writes to something that is not a cell

# The `.bind | .cell` arm carries the `=` message. A cell never reaches
# this function — a cell IS mutable — so the pair exists only because `_`
# is forbidden on variants: the Rust side hid the same fact under `_ =>`,
# and here the unreachable case is at least named where a reader can ask
# about it.
function not_mutable(name: str, kind: resolved.LocalKind, span: token.Span) -> diag.Diagnostic
    message = match kind
        .param => "`" + name + "` is a parameter without `@`, so it cannot be written — mark it `@" + name + "` in the signature and at every call site (copy in, copy out)"
        .loop_var => "`" + name + "` is the loop variable, and it is bound afresh for each element — write to a cell declared outside the loop"
        .payload => "`" + name + "` is bound by the pattern, and a pattern binding is not a cell — bind what you need with `@` outside the `match`"
        .bind | .cell => "`" + name + "` was bound with `=`, which binds once, forever — a cell is declared `" + name + " @= <value>`"

    d: diag.Diagnostic @= diag.new_diagnostic(code: "not_mutable", message: message, span: span)

    if kind == .bind
        # The type is the missing half and no type exists yet at this stage:
        # prose, not a fix a tool may apply (§4.17).
        d.fixes @ d.fixes.push(
            diag.Fix(title: "declare `" + name + "` as a cell: `" + name + " @= <value>`", replacement: "", span: span, certainty: .guess)
        )
    return d

function no_mutable_globals(name: str, what: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "no_mutable_globals",
        message: "`" + name + "` is a " + what + ", and there are no mutable globals — pass what changes as an `@` parameter",
        span: span
    )

## Did you mean

# One candidate → the rename, OFFERED as a guess (§4.17 names the rename to
# the one in-scope candidate as a certain fix, and it becomes one only where
# `rename_fit.hero` proves it): the letters alone once decided, and `True`
# two edits from `run`, `p` one from `s` (defect 135, lane recovery-b3), and
# `sqrt` one from `sort` (defect 220) were each written into a program
# refused anew or reading another binding. Several → the names, in prose,
# and no fix: a tool that picks one of three is guessing, and only certain
# fixes may be applied.
function suggest(@d: diag.Diagnostic, near: [str], span: token.Span)
    if near.len() == 1
        d.message @ d.message + " — did you mean `" + near[0] + "`?"
        d.fixes @ d.fixes.push(
            diag.Fix(title: "rename to `" + near[0] + "`", replacement: near[0], span: span, certainty: .guess)
        )
        return

    if near.len() > 1
        quoted: [str] @= []

        for c in near
            quoted @ quoted.push("`" + c + "`")

        d.message @ d.message + " — the closest names in scope are " + quoted.join(", ")

## Tests

test "one candidate is a rename offered, three are prose"
    span = token.Span(start: 0, end: 5)
    one: [str] = ["total"]
    d = unknown_name("totl", one, span)
    assert d.message == "nothing named `totl` is in scope — did you mean `total`?"
    assert d.fixes.len() == 1
    assert d.fixes[0].replacement == "total"
    many: [str] = ["tot", "toll", "tall"]
    e = unknown_name("totl", many, span)
    assert e.fixes.len() == 0
    assert e.message == "nothing named `totl` is in scope — the closest names in scope are `tot`, `toll`, `tall`"

# Defect 270: a name called is told how a function of C is bound, whatever
# the name, and the rename beside it stays the guess it is; a name read is
# told nothing of C.
test "a name nothing binds, called, is told how a function of C is bound"
    span = token.Span(start: 0, end: 4)
    near: [str] = ["sort"]
    called = unknown_called("sqrt", near, span)
    assert called.code == "unknown_name"
    assert called.message == "nothing named `sqrt` is in scope — did you mean `sort`?"
    assert called.fixes[0].certainty == .guess
    assert called.notes == ["if `sqrt` is a function of C, an `extern` group in this file binds it: the group's line names the header, `extern \"<header>.h\"`, and the signature is indented below it, `function sqrt(…) -> …` (§4.19)"]
    assert unknown_name("sqrt", near, span).notes.len() == 0
    assert unknown_function("sqrt", near, span).notes == called.notes

# Defect 220: what makes a rename certain is not this pass's to know, so every
# one it offers is a guess, the letters' best case included; `rename_fit.hero`
# proves the ones that are certain.
test "every rename this pass offers is a guess, whatever its letters"
    span = token.Span(start: 0, end: 4)
    run: [str] = ["run"]
    far = unknown_name("True", run, span)
    assert far.message == "nothing named `True` is in scope — did you mean `run`?"
    assert far.fixes[0].certainty == .guess
    literal: [str] = ["true"]
    assert unknown_name("TRUE", literal, span).fixes[0].certainty == .guess
    sorted: [str] = ["sort"]
    assert unknown_function("sqrt", sorted, span).fixes[0].certainty == .guess
    point: [str] = ["Point"]
    assert unknown_type("Poimt", point, span).fixes[0].certainty == .guess

test "the unused wording follows the kind, and the valve is certain"
    span = token.Span(start: 0, end: 3)
    p = unused("xs", .param, 0, span)
    assert p.fixes.len() == 0
    assert p.message == "the parameter `xs` is never read — remove it from the signature, or write `???` in the body while the function is unfinished"
    l = unused("x", .loop_var, 0, span)
    assert l.fixes.len() == 1
    assert l.fixes[0].replacement == "_"
    assert l.fixes[0].certainty == .certain
    written = unused("n", .cell, 2, span)
    assert written.message == "`n` is written and never read — a cell nothing reads is a value nobody uses"
    fresh = unused("n", .cell, 0, span)
    assert fresh.message == "`n` is declared and never read — remove it, or read it"

test "a write to a plain binding earns the guess, not a certain fix"
    span = token.Span(start: 0, end: 1)
    d = not_mutable("x", .bind, span)
    assert d.fixes.len() == 1
    assert d.fixes[0].certainty == .guess
    loop_write = not_mutable("x", .loop_var, span)
    assert loop_write.fixes.len() == 0

# `v: i64 @= 5` and no `v @ …` after it, nor an `@v` handed to a call: a cell
# nothing re-binds is a binding written with the wrong symbol (spec § 5,
# panel 209's R1b, the rule Zig 0.12 ships as an error). The fix is certain:
# the `@` that declared it, whose span the `Local` carries, becomes `=`, the
# annotation stays, and the program means what it meant, since nothing ever
# wrote the cell.
function never_rebound(name: str, span: token.Span, symbol: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "never_rebound",
        message: "`" + name + "` is declared a mutable cell and nothing re-binds it — a value written once is a binding: write `=` where the `@=` is",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `=`: `" + name + "` is a binding", replacement: "=", span: symbol, certainty: .certain)
    )
    return d

# `_ @= e`, or `_: T @= e`: the wildcard binds nothing (spec § 5), so the cell
# its symbol would declare is one nothing can ever re-bind, R1b's rule at the
# one name no write reaches, a hole in its module or not (defect 608). The
# same code and the same certain fix at the symbol `written` (the old `@` on
# `_` is the parser's, `cell_errors.old_symbol`): the line runs as the
# discard `_ = e`, so writing `=` changes nothing it does.
function never_rebound_wildcard(written: str, span: token.Span, symbol: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "never_rebound",
        message: "`_` binds nothing, so a cell declared on it is one nothing can re-bind — a value dropped on purpose is written `_ = …`: write `=` where the `" + written + "` is",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "write `=`: `_` drops the value", replacement: "=", span: symbol, certainty: .certain)
    )
    return d

test "a cell nothing re-binds is told once, with a certain fix at its @"
    d = never_rebound("v", span: token.Span(start: 4, end: 5), symbol: token.Span(start: 11, end: 12))
    assert d.code == "never_rebound"
    assert d.fixes.len() == 1
    assert d.fixes[0].certainty == .certain
    assert d.fixes[0].replacement == "="
    assert d.fixes[0].span.start == 11

test "the wildcard's cell is told at the _, its fix writing = over the symbol written"
    d = never_rebound_wildcard("@=", span: token.Span(start: 4, end: 5), symbol: token.Span(start: 6, end: 8))
    assert d.code == "never_rebound"
    assert d.span.start == 4
    assert d.message == "`_` binds nothing, so a cell declared on it is one nothing can re-bind — a value dropped on purpose is written `_ = …`: write `=` where the `@=` is"
    assert d.fixes.len() == 1
    assert d.fixes[0].certainty == .certain
    assert d.fixes[0].replacement == "="
    assert d.fixes[0].span.end == 8
