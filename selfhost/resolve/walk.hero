# The resolver's walk: statements, expressions, patterns, and the left of
# `@` (design.md §4.4 the three line shapes, §4.7 loops and match, §4.9
# calls, §4.11 UFCS, §4.16 holes; panels 015, 031).
# Port of archive/bootstrap-rs/heroes/src/resolve/{stmts,exprs,places}.rs — three files,
# 434 lines, one module here.
#
# ## The map this file owes its reader (CLAUDE.md §11)
#
# **This is one module because the language leaves no choice.** The three
# Rust files call each other in a ring: a statement holds expressions
# (`x = e`), an expression holds blocks of statements (`if`, `match`), and
# a mutation's place holds index expressions read on the way to the root —
# `statement` → `expr` → `block`/`arm` → `statement`, with `place` →
# `expr` closing the third arc. The edges that LEAVE the knot and stay
# other modules: `resolve_state` (the stack and the counters),
# `resolve_qualified` (the module-vs-UFCS decision), `resolve_names` (how
# a bare or dotted mention finds its declaration — split out at
# M-separate-compilation step 5, when the extern gates took this file
# past its frozen ceiling and the lookup was the seam that names a
# concern), `resolve_errors` (the wording), `resolved` (the table), and
# `resolve/writes` (the root a write reaches and the rule it answers to —
# `write_root` for the left of `@`, `inout_root` for an `@` argument; a
# leaf of the ring, moved out 2026-09-03 when the second caller took this
# file past the ceiling).
#
# **The entry points**: `block` for a body in its own scope, `statements`
# for a body in a scope the caller opened (a loop's, an arm's), `expr` for
# one expression, `place` for the left of `@`. `resolve_decls` will drive
# all four; nothing here reads a declaration.
#
# ## The two rules that decide every branch
#
# **The value is resolved before the name is bound** — `x = x + 1` must
# say the right `x` is not defined, not resolve it to the binding being
# created on the same line. And **a write is not a read**: in `v @ v + 1`
# the root on the left is written, the indexes on the way are read, and
# the unused rule counts only reads (§4.8's copy-out is the one exception,
# handled in the sweep).

use token
use ast
use source
use resolved
use parse
use resolve/state
use resolve/types
use resolve/errors
use resolve/qualified
use resolve/names
use resolve/writes
use resolve/binding as resolve_binding

## Statements

# A block, in its own scope.
function block(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], body: ast.Block)
    state.open_scope(@r)
    statements(@r, a, s, decls, body.stmts)
    state.close_scope(@r)

# The statements of a block, in a scope the caller has already opened —
# which is how a loop variable and an arm's payload end up in the same
# scope as the body they belong to.
function statements(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], stmts: [i64])
    for id in stmts
        statement(@r, a, s, decls, id)

function statement(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], id: i64)
    match a.stmts[id].kind
        .bind b =>
            expr(@r, a, s, decls, b.value)

            if !b.ty.is_err()
                types.resolve_type(@r, a, s, decls, b.ty.must())
            _ = state.declare(@r, s, decls, b.name, resolve_binding.bind_binding(ty: b.ty, value: b.value)).is_err()
        .declare d =>
            expr(@r, a, s, decls, d.value)
            types.resolve_type(@r, a, s, decls, d.ty)
            _ = state.declare(@r, s, decls, d.name, resolve_binding.cell_binding(ty: d.ty, value: d.value)).is_err()
        # The initialiser above is not counted as a write: a cell that is
        # only ever initialised has been written once by definition, and
        # counting it would blind the unused rule to every cell.

        .mutate m =>
            expr(@r, a, s, decls, m.value)
            place(@r, a, s, decls, m.place)
        .return_stmt rv =>
            if !rv.value.is_err()
                expr(@r, a, s, decls, rv.value.must())
        .assert_stmt v                        => expr(@r, a, s, decls, v.value)
        .expr_stmt v                          => expr(@r, a, s, decls, v.value)
        .break_stmt | .continue_stmt | .error => return
        .while_stmt w =>
            expr(@r, a, s, decls, w.cond)
            block(@r, a, s, decls, w.block)
        .for_in f =>
            # The iterable is resolved outside the loop's scope: `for x in
            # x` must not find its own binding.
            expr(@r, a, s, decls, f.iterable)
            state.open_scope(@r)
            _ = state.declare(@r, s, decls, f.name, resolve_binding.loop_binding(iterable: f.iterable)).is_err()
            statements(@r, a, s, decls, f.block.stmts)
            state.close_scope(@r)

## Expressions

function expr(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], id: i64)
    match a.exprs[id].kind
        .name => names.bare_name(@r, a, s, decls, id)
        # The module, not a flag: §4.16's suppression is file-wide, so a
        # hole here must not quiet the unused rule in a module nobody is
        # editing.

        .hole                                                    => resolved.note_hole(@r.out, r.module)
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => return
        .null_ptr | .error                                       => return
        .unary u                                                 => expr(@r, a, s, decls, u.operand)
        .binary b =>
            expr(@r, a, s, decls, b.left)
            expr(@r, a, s, decls, b.right)
        # `p.x` — the base is a value, the field name is not a name in any
        # scope; which record it belongs to is the checker's question.
        # UNLESS the base is a module: then the three tokens are one
        # qualified name and not a field at all — `grid.WALL` reads a
        # constant next door.

        .field f =>
            if qualified.qualified(@r, a, s, decls, at: id, receiver: f.base, called: f.name)
                return
            expr(@r, a, s, decls, f.base)
        .index i =>
            expr(@r, a, s, decls, i.base)
            expr(@r, a, s, decls, i.index)
        .call c =>
            expr(@r, a, s, decls, c.callee)
            arguments(@r, a, s, decls, c.args)
        .method m =>
            # A module in receiver position is not a value, so it is
            # decided before the receiver is resolved as one (panel 031 Q2).
            if qualified.qualified(@r, a, s, decls, at: id, receiver: m.receiver, called: m.name)
                arguments(@r, a, s, decls, m.args)
                return
            expr(@r, a, s, decls, m.receiver)
            arguments(@r, a, s, decls, m.args)
            names.method_name(@r, s, decls, at: id, called: m.name)
        .variant_case v => arguments(@r, a, s, decls, v.args)
        .array elements =>
            for element in elements.elements
                expr(@r, a, s, decls, element)
        .map entries =>
            for entry in entries.entries
                expr(@r, a, s, decls, entry.key)
                expr(@r, a, s, decls, entry.value)
        .try_expr t => expr(@r, a, s, decls, t.value)
        .if_expr branches =>
            for branch in branches.branches
                expr(@r, a, s, decls, branch.cond)
                block(@r, a, s, decls, branch.block)

            if !branches.otherwise.is_err()
                block(@r, a, s, decls, branches.otherwise.must())
        .match_expr m =>
            expr(@r, a, s, decls, m.scrutinee)

            for arm in m.arms
                # One scope per arm: the payload bindings and the body live
                # together, and two arms may bind the same name.
                state.open_scope(@r)

                for pattern in arm.patterns
                    match pattern.kind
                        .variant_case c =>
                            if !c.binding.is_err()
                                bind_payload(@r, s, decls, c.binding.must())
                        .literal l         => expr(@r, a, s, decls, l.value)
                        .wildcard | .error => continue

                match arm.body
                    .one_stmt one => statement(@r, a, s, decls, one.at)
                    .block bb     => statements(@r, a, s, decls, bb.block.stmts)

                state.close_scope(@r)

# Port note: Rust calls this parameter `args`, and Heroes refuses it —
# `args` is the builtin that reads the command line, and a built-in's name
# is taken everywhere. The reservation reviewed its own port.
function arguments(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], given: [ast.Arg])
    for arg in given
        expr(@r, a, s, decls, arg.value)

        # `f(@x)` reads x (copy in) AND writes it (copy out, §4.8), so its
        # root answers to the rule of the left of `@`.
        if arg.mutable
            writes.inout_root(@r, a, s, arg.value)

    # Panel 010: two `@` arguments of one call may not share a root. Asked
    # after the loop, because it compares the roots the loop just resolved.
    writes.refuse_aliased_places(@r, a, s, given)

# A payload binding. Two patterns of one arm may not bind the same name:
# under `|` the two cases carry different payloads, so one name would mean
# two things depending on which case matched.
function bind_payload(@r: state.Resolver, s: source.Source, decls: [ast.Decl], binding: token.Span)
    text = source.span_text(s, binding)

    if text != "_" && state.bound_in_current_scope(r, text)
        state.push_diagnostic(@r, errors.duplicate_pattern_binding(text, span: binding))
        return
    _ = state.declare(@r, s, decls, binding, resolve_binding.payload_binding()).is_err()

## The left of `@`

# Resolving a place is not the same as reading it: the root is WRITTEN,
# and any index on the way (`xs[i] @ …`) is read. Keeping the two rules in
# one walk is what makes "a read is a use and a write is not"
# implementable at all.
function place(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], id: i64)
    match a.exprs[id].kind
        .name => writes.write_root(@r, a, s, id)
        # `grid.WALL @ 1` — a qualified constant, which is a top-level
        # declaration and so not a place at all (§4.2: there are no mutable
        # globals). Descending to the base would report `grid` as a name
        # that is not in scope, which is wrong twice: the module IS in
        # scope, and the mistake the author made was about `WALL`.

        .field f =>
            if !qualified.module_at(r, a, s, f.base).is_err()
                state.push_diagnostic(
                    @r,
                    errors.no_mutable_globals(name: source.span_text(s, f.name), what: "top-level declaration", span: f.name)
                )
                return
            place(@r, a, s, decls, f.base)
        .index i =>
            expr(@r, a, s, decls, i.index)
            place(@r, a, s, decls, i.base)
        # Not a place at all — the parser already said so (`not_a_place`).

        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => expr(@r, a, s, decls, id)
        .null_ptr | .hole | .unary | .binary | .call             => expr(@r, a, s, decls, id)
        .method | .variant_case | .array | .map | .try_expr      => expr(@r, a, s, decls, id)
        .if_expr | .match_expr | .error                          => expr(@r, a, s, decls, id)

## Tests

# The tests parse REAL source and drive one function's body by hand — the
# open-scope/declare-params/walk sequence is resolve_decls' job and lands
# with it; duplicating four lines here beats depending on a file that does
# not exist yet.
function walked(text: str) -> state.Resolver
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    r: state.Resolver @ state.new_resolver(
        expr_count: p.tree.exprs.len(),
        type_count: p.tree.types.len()
    )
    r.module @ "t"
    i: i64 @ 0

    for d in p.decls
        resolved.declare_top(@r.out, module: "t", name: source.span_text(s, d.name), decl: i)
        i @ i + 1

    for d in p.decls
        match d.kind
            .function_decl fd =>
                state.open_scope(@r)

                for param in fd.value.params
                    _ = state.declare(@r, s, p.decls, param.name, resolve_binding.param_binding(ty: param.ty, mutable: param.mutable)).is_err(
                    )

                if !fd.value.body.is_err()
                    statements(@r, p.tree, s, p.decls, fd.value.body.must().stmts)
                state.close_scope(@r)
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

    state.report_unused(@r, s)
    return r

test "the value is resolved before the name is bound"
    r = walked("function f()\n    x = x + 1\n    print(x)\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_name"

    # `f` is one edit from `x`? No — one edit REPLACES the whole name, and
    # a one-letter name affords exactly one edit, so the function's own
    # name is a legitimate candidate. The suggestion is the rule working,
    # not noise: the test pins it so a "better" filter is caught.
    assert r.out.diagnostics[0].message == "nothing named `x` is in scope — did you mean `f`?"

test "for x in x does not find its own binding"
    r = walked("function f()\n    for x in x\n        print(x)\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_name"

test "a write is not a read, and the sweep says written-never-read"
    r = walked("function f()\n    v: i64 @ 0\n    v @ 1\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unused_binding"
    assert r.out.diagnostics[0].message == "`v` is written and never read — a cell nothing reads is a value nobody uses"

test "a plain binding refuses the write with the = wording"
    r = walked("function f()\n    x = 1\n    x @ 2\n    print(x)\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "not_mutable"
    assert r.out.diagnostics[0].fixes.len() == 1
    assert r.out.diagnostics[0].fixes[0].certainty == .guess

test "two patterns of one arm may not bind the same payload name"
    r = walked("function f(t: i64) -> i64\n    return match t\n        .a x | .b x => 1\n")

    # Two diagnostics, and both are right: the duplicate, and then the
    # sweep on the FIRST binding — the body `1` never reads it, and one
    # mistake in a pattern does not exempt the arm from the unused rule.
    assert r.out.diagnostics.len() == 2
    assert r.out.diagnostics[0].code == "duplicate_pattern_binding"
    assert r.out.diagnostics[1].code == "unused_binding"

test "sibling arms may bind the same name, and payloads count as reads"
    r = walked("function f(t: i64) -> i64\n    return match t\n        .a x => x\n        .b x => x\n")
    assert r.out.diagnostics.len() == 0

test "an unknown method name is answered without a type in hand"
    r = walked("function f(x: i64) -> i64\n    return x.dubble()\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unknown_function"

test "an index on the way to the root is read, the root is written"
    r = walked("function f()\n    xs: [i64] @ [1, 2]\n    i = 0\n    xs[i] @ 9\n    print(xs[i])\n")
    assert r.out.diagnostics.len() == 0

test "an @ argument is held to the rule of the left of @"
    r = walked("function f(@n: i64)\n    n @ n + 1\n\nfunction g(x: i64)\n    f(@x)\n")
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "not_mutable"
    assert r.out.diagnostics[0].message == "`x` is a parameter without `@`, so it cannot be written — mark it `@x` in the signature and at every call site (copy in, copy out)"

test "an @ argument through an index writes the root, reads the index, and is clean on a cell"
    r = walked(
        "function f(@n: i64)\n    n @ n + 1\n\nfunction g()\n    xs: [i64] @ [1]\n    i = 0\n    f(@xs[i])\n    print(xs[i])\n"
    )
    assert r.out.diagnostics.len() == 0

test "an @ argument on a plain binding and on a loop variable each say why"
    r = walked(
        "function f(@n: i64)\n    n @ n + 1\n\nfunction g(xs: [i64])\n    y = 1\n    f(@y)\n    print(y)\n    for e in xs\n        f(@e)\n        print(e)\n"
    )
    assert r.out.diagnostics.len() == 2
    assert r.out.diagnostics[0].code == "not_mutable"
    assert r.out.diagnostics[0].message == "`y` was bound with `=`, which binds once, forever — a cell is declared with its type: `y: <type> @ <value>`"
    assert r.out.diagnostics[1].message == "`e` is the loop variable, and it is bound afresh for each element — write to a cell declared outside the loop"

## Panel 010's alias refusal (defect 011)

# The shape design.md has named as a compile error since 2026-08-04, and the
# one nothing tested: BOTH labels written, which is what it takes to get past
# `needs_label` to the alias question at all.
test "two @ arguments of one call may not name one cell"
    r = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    n: i64 @ 0\n    shift(a: @n, b: @n)\n    print(n)\n"
    )
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "aliased_mutable_arguments"
    assert r.out.diagnostics[0].message == "`n` overlaps this call's `a` argument — two `@` arguments may not reach one value: each of them copies out, and nothing says which copy-out lands last"
    assert r.out.diagnostics[0].fixes.len() == 2
    assert r.out.diagnostics[0].fixes[0].certainty == .guess
    assert r.out.diagnostics[0].fixes[1].certainty == .guess

test "one field twice and one literal index twice are the same refusal"
    field = walked(
        "record P\n    x: i64\n\nfunction shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    p: P @ P(x: 0)\n    shift(a: @p.x, b: @p.x)\n    print(p.x)\n"
    )
    assert field.out.diagnostics.len() == 1
    assert field.out.diagnostics[0].code == "aliased_mutable_arguments"
    assert field.out.diagnostics[0].message == "`p.x` overlaps this call's `a` argument — two `@` arguments may not reach one value: each of them copies out, and nothing says which copy-out lands last"
    index = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    xs: [i64] @ [0, 0]\n    shift(a: @xs[0], b: @xs[0])\n    print(xs[0])\n"
    )
    assert index.out.diagnostics.len() == 1
    assert index.out.diagnostics[0].code == "aliased_mutable_arguments"

# The over-rejection design.md:1299 authorises, and the one it does not.
test "variable indices are refused and distinct literal indices are not"
    variable = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g(i: i64, j: i64)\n    xs: [i64] @ [0, 0]\n    shift(a: @xs[i], b: @xs[j])\n    print(xs[0])\n"
    )
    assert variable.out.diagnostics.len() == 1
    assert variable.out.diagnostics[0].code == "aliased_mutable_arguments"
    literal = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    xs: [i64] @ [0, 0]\n    shift(a: @xs[0], b: @xs[1])\n    print(xs[0])\n"
    )
    assert literal.out.diagnostics.len() == 0

# Panel 110's two witnesses: both print the right answers today and both are
# clean under `--sanitize` with the value SHARED, so a root test would have
# made two working programs wrong.
test "distinct fields of one record are two places"
    r = walked(
        "record P\n    x: i64\n    y: i64\n\nfunction shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    p: P @ P(x: 0, y: 0)\n    shift(a: @p.x, b: @p.y)\n    print(p.x)\n"
    )
    assert r.out.diagnostics.len() == 0

# A prefix is an overlap: writing `p` and writing `p.x` land on one record.
test "a place and a place inside it overlap"
    r = walked(
        "record P\n    x: i64\n\nfunction shift(@a: P, @b: i64)\n    a.x @ a.x + 1\n    b @ b + 10\n\nfunction g()\n    p: P @ P(x: 0)\n    shift(a: @p, b: @p.x)\n    print(p.x)\n"
    )
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "aliased_mutable_arguments"

# A spelling this pass does not decode is undecided, not distinct: the AST
# keeps a literal's TEXT (`ast.hero:109`) and `0x0` is `0`.
test "a literal index in another base is not proof of a different element"
    r = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    xs: [i64] @ [0, 0]\n    shift(a: @xs[0], b: @xs[0x0])\n    print(xs[0])\n"
    )
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "aliased_mutable_arguments"

# Three `@` arguments of one cell: every later one is reported against the
# FIRST, so the count is the number of arguments that have to change.
test "three @ arguments of one cell are two findings"
    r = walked(
        "function bump(@a: i64, @b: i64, @c: i64)\n    a @ a + 1\n    b @ b + 10\n    c @ c + 100\n\nfunction g()\n    n: i64 @ 0\n    bump(a: @n, b: @n, c: @n)\n    print(n)\n"
    )
    assert r.out.diagnostics.len() == 2
    assert r.out.diagnostics[0].message == "`n` overlaps this call's `a` argument — two `@` arguments may not reach one value: each of them copies out, and nothing says which copy-out lands last"
    assert r.out.diagnostics[1].message == "`n` overlaps this call's `a` argument — two `@` arguments may not reach one value: each of them copies out, and nothing says which copy-out lands last"

# Two cells are two places, and an unlabelled call says so without a label.
test "distinct cells are clean and an unlabelled pair names no label"
    clean = walked(
        "function shift(@a: i64, @b: i64)\n    a @ a + 1\n    b @ b + 10\n\nfunction g()\n    n: i64 @ 0\n    m: i64 @ 0\n    shift(a: @n, b: @m)\n    print(n + m)\n"
    )
    assert clean.out.diagnostics.len() == 0
    bare = walked(
        "function shift(@a: i64, @b: str)\n    a @ a + 1\n    b @ b + \"x\"\n\nfunction g()\n    n: i64 @ 0\n    shift(@n, @n)\n    print(n)\n"
    )
    assert bare.out.diagnostics.len() == 1
    assert bare.out.diagnostics[0].message == "`n` overlaps an earlier `@` argument of this call — two `@` arguments may not reach one value: each of them copies out, and nothing says which copy-out lands last"

# A nested call is NOT this rule: `outer(@n, k: bump(@n))` keeps both
# mutations, measured at three shapes, because a call's copy-in happens after
# its arguments are evaluated. One `@` argument per call, two calls.
test "an @ argument inside another call's arguments is a different call"
    r = walked(
        "function bump(@n: i64) -> str\n    n @ n + 1\n    return \"x\"\n\nfunction outer(@n: i64, k: str)\n    n @ n + 1000\n    _ = k\n\nfunction g()\n    n: i64 @ 0\n    outer(@n, k: bump(@n))\n    print(n)\n"
    )
    assert r.out.diagnostics.len() == 0
