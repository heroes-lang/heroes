# An `@` before an argument of a construction (design.md §4.8, §4.9; spec
# § 9; defect 412). `@` at a call site repeats an `@` parameter: the call
# copies the argument in and writes it back. A construction has no `@`
# parameter and writes nothing back, it keeps a copy of each value it is
# handed, so an `@` there claims what never happens, and no later stage has
# a meaning for it: the emitter would hand the field an address.
#
# Which call is a construction is a question of what the callee names, so it
# is asked here, where the walk has just resolved the callee:
#
# - a `record`, a Heroes one or a group's, named or qualified
#   (`geom.Point(x: @n)`);
# - a case of a variant, `.circle(r: @n)`, whatever its type turns out to be;
# - `ok` and `fail`, the two constructors of a `T?`.
#
# Each such `@` is told once, `marker_mismatch`, the code a function's
# argument marked `@` against a parameter without it already has, and the
# argument is handed on unmarked: its value is still read, and the rule of the
# left of `@` (`resolve/writes`) is not asked of a place nothing writes, so a
# name bound with `=` is not told it should be a cell. A handle's construction
# is unmarked and not told: it is refused whole, `@` and all, by
# `check/handle_built.hero` (defect 397).
#
# **The same holds of a call that takes no `@` where one is written** (defect
# 431): a function whose parameter at the argument's position has none, a
# built-in but `end_lease`, a function value, which no `@` reaches. The `@`
# is set aside unmarked and not told here: the checker tells it,
# `marker_mismatch`, where the arguments meet the parameters, and the left of
# `@` is asked only of an argument a call does write back. Asked of every
# `@`, it told `f(x: @p)` that `p` bound with `=` should be a cell, which was
# never the repair, and the `@` only once that was done.
#
# **And of every call not known to write the argument back** (defect 439):
# an argument past the last parameter, which the checker tells as the
# arity's mistake; a name that resolved to nothing, told already; and a
# callee that is no function, a module, a constant or a variant, told as
# what it is. Each kept its mark, so a name bound with `=` was told
# `not_mutable` beside that mistake, or, where the checker tells it, in its
# place. So the mark stays on one argument only: one whose parameter, at its
# position, takes an `@`.

use token
use ast
use source
use diag
use handles
use inventory
use label_errors
use resolve/state
use resolve/meant

# The arguments of a call whose callee, the node at `callee` (the method node
# itself for a qualified name or UFCS), the walk has just resolved, each `@`
# the callee takes none for set aside: told here for a construction, left to
# the checker's `marker_mismatch` for anything else. `receiver` says a UFCS
# receiver is the first parameter, so the arguments begin at the second.
function of_a_call(@r: state.Resolver, a: ast.Ast, s: source.Source, decls: [ast.Decl], callee: i64, receiver: bool, given: [ast.Arg]) -> [ast.Arg]
    # What the callee's signature says the author meant to write is read
    # before the marks are, marked or not (panel 209's R1b,
    # `resolve/meant.hero`): a cell handed bare to an `@` parameter is one
    # the checker will mark with a certain fix, and a cell handed `@` where
    # none is taken is one the checker, or `unmarked` below, will refuse;
    # neither is told a second time as a cell nothing re-binds.
    meant.meant_by_signature(@r, a, s, takes_at(r, decls, callee), first: first_position(receiver), given: given)

    if !any_marked(given)
        return given

    match r.out.uses[callee]
        .top t =>
            match decls[t.at].kind
                .record_decl =>
                    # `x.Point(…)` is refused as no function already.
                    if receiver
                        return set_aside(given)
                    built = source.span_text(s, decls[t.at].name)
                    tell = !handles.is_handle(decls[t.at])
                    return unmarked(@r, a, s, built: built, what: "a `record`", tell: tell, given: given)
                .function_decl fd =>
                    return beside(param_writes(fd.value.params), first: first_position(receiver), given: given)
                # No function: told as what it is, a constant or a variant
                # called; a test has no name a call can write.
                .constant_decl | .variant_decl | .test_decl => return set_aside(given)
        .builtin b =>
            if a.exprs[callee].kind == .name && is_a_constructor(source.span_text(s, a.exprs[callee].span))
                built = source.span_text(s, a.exprs[callee].span)
                return unmarked(@r, a, s, built: built, what: "a `T?`", tell: true, given: given)

            # One built-in takes an `@`, `end_lease(@x)`, which empties the
            # cell it frees (panel 125), and it takes that one argument alone
            # (`check/lend_types.hero`); no other changes an argument.
            if inventory.name_of(b.at) == "end_lease"
                return beside(END_LEASE_WRITES, first: first_position(receiver), given: given)
            return set_aside(given)
        # A function value: no function type carries an `@` (defect 398).
        # A name that resolved to nothing is told already, and any other
        # callee unresolved is a value called, `pick()(x)` or a field; a
        # module called is told as no value. None is known to write back.
        .local | .unresolved | .module => return set_aside(given)

# Which parameter of the callee takes an `@`, in order: a function's own
# marks, `end_lease`'s one, and none for every other callee (a construction,
# a constant called, a function value, a built-in that changes nothing).
function takes_at(r: state.Resolver, decls: [ast.Decl], callee: i64) -> [bool]
    match r.out.uses[callee]
        .top t =>
            match decls[t.at].kind
                .function_decl fd                                          => return param_writes(fd.value.params)
                .record_decl | .constant_decl | .variant_decl | .test_decl => return NO_WRITES
        .builtin b =>
            if inventory.name_of(b.at) == "end_lease"
                return END_LEASE_WRITES
            return NO_WRITES
        .local | .unresolved | .module => return NO_WRITES

function param_writes(params: [ast.Param]) -> [bool]
    writes: [bool] @= []

    for p in params
        writes @ writes.push(p.mutable)

    return writes

# The arguments of a variant case, `name` its case: all of them, since a case
# is always built.
function of_a_case(@r: state.Resolver, a: ast.Ast, s: source.Source, name: token.Span, given: [ast.Arg]) -> [ast.Arg]
    # A case takes no `@`, so every one given names a cell the author meant
    # to write (panel 209's R1b, as `of_a_call` reads a callee's marks).
    meant.meant_by_signature(@r, a, s, NO_WRITES, first: 0, given: given)
    built = "." + source.span_text(s, name)
    return unmarked(@r, a, s, built: built, what: "a case of a `variant`", tell: true, given: given)

function is_a_constructor(name: str) -> bool
    return name == "ok" || name == "fail"

function any_marked(given: [ast.Arg]) -> bool
    for arg in given
        if arg.mutable
            return true

    return false

# `end_lease`'s one parameter, the cell it frees, which takes an `@`.
constant END_LEASE_WRITES: [bool]
    [true]

# A callee no parameter of which takes an `@`: a value called, a built-in
# other than `end_lease`.
constant NO_WRITES: [bool]
    []

# Where the written arguments begin among the parameters: at the second
# where a UFCS receiver is the first.
function first_position(receiver: bool) -> i64
    if receiver
        return 1
    return 0

# `given` with every `@` taken off, untold: no parameter of the callee
# takes one.
function set_aside(given: [ast.Arg]) -> [ast.Arg]
    none: [bool] = []
    return beside(none, first: 0, given: given)

# `given` against the parameters from `first`, `writes` saying which takes an
# `@`: an `@` is kept only where the parameter at its position takes one, and
# taken off, untold, where it takes none or where no parameter stands, past
# the last, whose arity the checker tells (defect 439).
function beside(writes: [bool], first: i64, given: [ast.Arg]) -> [ast.Arg]
    kept: [ast.Arg] @= []
    k: i64 @= first

    for arg in given
        if arg.mutable && (k >= writes.len() || !writes[k])
            kept @ kept.push(ast.Arg(name: arg.name, mutable: false, value: arg.value))
        else
            kept @ kept.push(arg)
        k @ k + 1

    return kept

# `given` with every `@` told, where `tell`, and taken off; `built` is what
# the construction names and `what` the kind of value it builds. A list
# without one is handed back as it came, since every construction passes here.
function unmarked(@r: state.Resolver, a: ast.Ast, s: source.Source, built: str, what: str, tell: bool, given: [ast.Arg]) -> [ast.Arg]
    marked: bool @= false

    for arg in given
        if arg.mutable
            marked @ true

    if !marked
        return given
    kept: [ast.Arg] @= []

    for arg in given
        if arg.mutable
            if tell
                state.push_diagnostic(@r, told(a, s, built: built, what: what, arg: arg))
            kept @ kept.push(ast.Arg(name: arg.name, mutable: false, value: arg.value))
        else
            kept @ kept.push(arg)

    return kept

function told(a: ast.Ast, s: source.Source, built: str, what: str, arg: ast.Arg) -> diag.Diagnostic
    value_span = a.exprs[arg.value].span
    at = label_errors.argument_front(s.text, value_start: value_span.start, mutable: true)
    value = source.span_text(s, value_span)
    written: str @= "@" + value

    if !arg.name.is_err()
        written @ source.span_text(s, arg.name.must()) + ": @" + value
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "marker_mismatch",
        message: "`" + built + "(…)` builds " + what + ", which keeps a copy of each value: the `@` in `" + written + "` says `" + value + "` is changed and written back, and only a function's `@` parameter does that (§4.8)",
        span: token.Span(start: at, end: value_span.end)
    )

    if !arg.name.is_err() && source.span_text(s, arg.name.must()) == "rest" && value == "zero"
        d.notes @ d.notes.push(
            "`rest: zero`, the words that end a construction of a group's `record`, every field it does not name zero, take no `@`"
        )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "drop the `@`", replacement: "", span: token.Span(start: at, end: value_span.start), certainty: .guess)
    )
    return d
