# The unused sweep (design.md §4.4, "An unused variable is a compile
# error"; §4.16's hole exemption; panel 015): after the walk, every local
# never read is told, spared where its file holds a hole, where it is an
# `@` parameter written, or where it was offered as a repair. Out of
# `resolve/state.hero` on 2026-10-05 (defect 364), when that module's index
# of the open bindings took it past its decided 330 lines: the sweep reads
# the locals the walk recorded, never the scope stack, which is the concern
# the module kept.
#
# §4.16's exemption is checked here, once, after the whole file has been
# walked: a hole at the bottom of the file suspends the rule at the top of
# it, so this cannot be decided while walking. It is asked PER MODULE,
# against the binding's own file, because §4.16 makes the suppression
# file-wide.

use ast
use source
use resolved
use resolve/builtin_names
use diag
use resolve/state
use resolve/did_you_mean
use resolve/errors
use resolve/binding as resolve_binding

function report(@r: state.Resolver, s: source.Source)
    gathered: [diag.Diagnostic] @= []

    for local in r.out.locals
        if local.reads > 0
            if rebound_nowhere(r, s, local)
                gathered @ gathered.push(
                    errors.never_rebound(source.span_text(s, local.name), span: local.name, symbol: local.symbol)
                )
            continue
        module = source.module_at(s, local.name.start)

        if resolved.hole_covers(r.out, module)
            continue

        # The copy-out of an `@` parameter is observable by the caller
        # (§4.8), so writing one is using it.
        if local.kind == .param && local.mutable && local.writes > 0
            continue
        name = source.span_text(s, local.name)

        # Already told, at its binding: a name a built-in or a top-level
        # declaration of its module holds is refused there and bound only so
        # that what follows is the binding's (defect 422). Whether it is read
        # is asked once it is renamed, so the one mistake is one message.
        if builtin_names.taken(r.library, name) || !resolved.top_in(r.out, module: module, name: name).is_err()
            continue

        # Already spoken for: the compiler offered this name as the repair
        # for a name that resolved to nothing, and applying that repair
        # reads it. One typo, one diagnostic.
        if state.keyed_has(r.suggested, module: module, name: name)
            continue
        gathered @ gathered.push(errors.unused(name, local.kind, local.writes, local.name))

    for d in gathered
        state.push_diagnostic(@r, d)

# R1b (panel 209): a cell with no write after its birth, a write through an
# `@` argument counted (`writes.inout_root`), outside a hole's module, and
# not offered as the repair for a name that resolved to nothing, where the
# one message is the `unknown_name`'s (`totl @ total + x`).
function rebound_nowhere(r: state.Resolver, s: source.Source, local: resolved.Local) -> bool
    if local.kind != .cell || local.writes > 0
        return false
    module = source.module_at(s, local.name.start)

    if resolved.hole_covers(r.out, module)
        return false
    return !state.keyed_has(r.suggested, module: module, name: source.span_text(s, local.name))

## Tests

test "the unused sweep spares the hole's module, the @ write, the suggestion"
    s = state.tiny()
    decls: [ast.Decl] = []
    r: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    state.open_scope(@r)
    assert !state.declare(@r, s, decls, state.span_at(start: 0, end: 1), resolve_binding.bind_binding(ty: fail(code: "absent", msg: "inferred"), value: 0)).is_err()
    assert !state.declare(@r, s, decls, state.span_at(start: 2, end: 3), resolve_binding.param_binding(ty: 0, mutable: true)).is_err()
    r.out.locals[1].writes @ 1
    report(@r, s)

    # x is unused; y is an @ parameter that was written, so it is spared.
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unused_binding"

    # A hole in the module suspends the rule file-wide.
    quiet: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    state.open_scope(@quiet)
    assert !state.declare(@quiet, s, decls, state.span_at(start: 0, end: 1), resolve_binding.bind_binding(ty: fail(code: "absent", msg: "inferred"), value: 0)).is_err()
    resolved.note_hole(@quiet.out, "t")
    report(@quiet, s)
    assert quiet.out.diagnostics.len() == 0

    # A suggested name is already spoken for.
    offered: state.Resolver @= state.new_resolver(expr_count: 0, type_count: 0)
    state.open_scope(@offered)
    assert !state.declare(@offered, s, decls, state.span_at(start: 0, end: 1), resolve_binding.bind_binding(ty: fail(code: "absent", msg: "inferred"), value: 0)).is_err()
    candidates: [[str]] = [["x"]]
    offered.module @ "t"
    _ = did_you_mean.near_names(@offered, "z", candidates)
    report(@offered, s)
    assert offered.out.diagnostics.len() == 0
