# A module written as a qualifier and named by no `use` line of the file
# (spec § 1, *every module you name needs its own `use`*; defect 2292, found
# by panel 234's compiler-engineer): `strs.holds(s: "abc", part: "b")` with
# `strs.hero` beside the file you compile and no `use strs`. It was told
# `unknown_name`, nothing named `strs`, with the closest names in scope, and
# then `unknown_function` for `holds`, *did you mean `fold`?*, a `guess`
# pointing away from the cause, and the missing line was named nowhere. It is
# now one message on the qualifier, naming the `use` the file lacks; the call
# after the dot is not walked, its name being the module's to answer once the
# `use` is written.
#
# Asked only where nothing else answers the qualifier: no local, no
# declaration of the file and no built-in by that name, and no module the file
# names. The module is looked for where a bare `use` reads it, the directory
# of the file you compile, `<name>.hero` (the compiler-engineer's pricing: the
# error path, one look), or among the modules of the compilation whose path
# ends in it, which another file names.

use token
use ast
use diag
use source
use resolve/state
use resolved
use inventory
use module/names as module_names
use module/placed
use module/paths
use cli/files

# The diagnostic owed where the receiver `id` is a module named by no `use`
# of this file, or a failure where it is not one.
function told(r: state.Resolver, a: ast.Ast, s: source.Source, id: i64, bare: bool) -> diag.Diagnostic?
    if !bare
        return fail(code: "absent", msg: "only a bare name can name a module")
    span = a.exprs[id].span
    name = source.span_text(s, span)

    if !state.lookup_local(r, name).is_err() || !state.top_visible(r, name).is_err() || !inventory.index_of(name).is_err()
        return fail(code: "absent", msg: "the name is in scope")
    return named(r, s, name: name, span: span)

# The same for a qualifier however it is written, a value's or a type's
# (`p: strs.Point`): the diagnostic where `name` is a module no `use` of this
# file names, or a failure where it is not one.
function named(r: state.Resolver, s: source.Source, name: str, span: token.Span) -> diag.Diagnostic?
    if name == module_names.binding_of(r.module) || !resolved.used_module_named(r.out, from: r.module, binding: name).is_err()
        return fail(code: "absent", msg: "a `use` of this file names it, or the file is that module")
    module = module_answering(s, name: name)

    if module.len() == 0
        return fail(code: "absent", msg: "no module answers the name")
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "unknown_name",
        message: "nothing named `" + name + "` is in scope, and the module `" + module + "` answers it, which this file names in no `use` line: every module a file names needs its own `use` — `use " + module + "`",
        span: span
    )

    # A GUESS: the line is written at the top of the file, and whether the
    # module is the one meant, its declarations say once the line is there.
    first = s.files[source.file_of(s, span.start)].start
    d.fixes @ d.fixes.push(
        diag.Fix(title: "add `use " + module + "` at the top of the file", replacement: "use " + module + "\n", span: token.Span(start: first, end: first), certainty: .guess)
    )
    return ok(d)

# The module a `use` would name for `name`: one of the compilation whose path
# ends in it, else `<name>.hero` beside the file you compile; "" for none.
function module_answering(s: source.Source, name: str) -> str
    for f in s.files
        if !f.is_library && !placed.is_package(f.module) && module_names.binding_of(f.module) == name
            return f.module

    match files.entry(paths.directory_text(s.name) + name + ".hero")
        .file | .link                            => return name
        .absent | .directory | .other | .unknown => return ""
