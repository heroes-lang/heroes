# The scope stack and the resolver's working state (design.md §4.4 —
# "Shadowing is a compile error", "An unused variable is a compile error";
# §4.16's hole exemption; panel 015).
# Port of crates/heroes/src/resolve/scope.rs plus the state half of
# resolve/mod.rs. In Rust they are two files held together by `impl
# Resolver` blocks; there is no such spelling here, and they are one concern
# — every function below reads or grows the same record — so they are one
# module WITHOUT a cycle forcing it.
#
# One flat array of (name, local) plus an array of marks saying where each
# open scope begins. Closing a scope truncates. That is the whole structure
# — no tree, no parent pointers.
#
# Four rules are decided here rather than in the walk, because all four are
# about the STACK and not about any one statement:
#
# - **`_` never binds.** It declares nothing, so it can neither shadow nor
#   be unused — the escape valve for the unused rule (six languages for six,
#   panel 015's historian).
# - **Shadowing looks at every open scope**, parameters, top level and
#   built-ins included, because "already in scope" is what §4.4 says and all
#   three are. Two SIBLING blocks may each bind `x`: neither is in scope
#   inside the other, because close truncated the first away.
# - **The check is sequential.** Only a binding already in scope conflicts,
#   so a line below can never change whether the line above compiles — a
#   deliberate departure from Java and C#: §1.3 says locality is the
#   currency, and a legality rule that reads downwards spends it.
# - **A write through an `@` parameter is a use.** §4.8's copy-out always
#   happens. Every other write is not a use: only a read is.

use token
use ast
use diag
use source
use resolved
use resolve/vocab
use resolve/binding as resolve_binding
use inventory
use resolve/errors
use module/diagnostics

## The stack

# Port note: Rust's `Vec<(String, u32)>` has no tuple here, so the pair is
# a record — the same move Head made in decl.
record ScopeEntry
    name: str
    local: i64

record Scopes
    entries: [ScopeEntry]
    # Where each open scope begins in `entries`.
    marks: [i64]

function new_scopes() -> Scopes
    entries: [ScopeEntry] = []
    marks: [i64] = []
    return Scopes(entries: entries, marks: marks)

function open_scope(@r: Resolver)
    r.scopes.marks @ r.scopes.marks.push(r.scopes.entries.len())

function close_scope(@r: Resolver)
    mark: i64 @ 0

    if r.scopes.marks.len() > 0
        mark @ r.scopes.marks[r.scopes.marks.len() - 1]
        r.scopes.marks @ r.scopes.marks.slice(from: 0, to: r.scopes.marks.len() - 1)
    r.scopes.entries @ r.scopes.entries.slice(from: 0, to: mark)

function scope_depth(r: Resolver) -> i64
    if r.scopes.marks.len() == 0
        return 0
    return r.scopes.marks.len() - 1

# Innermost first — the answer to "which binding does this name mean", and
# the reason a sibling scope's `x` is invisible: it was truncated when its
# block closed.
function lookup_local(r: Resolver, name: str) -> i64?
    i: i64 @ r.scopes.entries.len() - 1

    while i >= 0
        if r.scopes.entries[i].name == name
            return ok(r.scopes.entries[i].local)
        i @ i - 1

    return fail("free", "no open scope binds this name")

# Whether the INNERMOST scope already binds this name. One caller: two
# patterns of one arm may not bind the same payload name.
function bound_in_current_scope(r: Resolver, name: str) -> bool
    mark: i64 @ 0

    if r.scopes.marks.len() > 0
        mark @ r.scopes.marks[r.scopes.marks.len() - 1]
    i: i64 @ mark

    while i < r.scopes.entries.len()
        if r.scopes.entries[i].name == name
            return true
        i @ i + 1

    return false

# Every name currently visible, innermost first — the did-you-mean's first
# and best candidates.
function visible_locals(r: Resolver) -> [str]
    out: [str] @ []
    i: i64 @ r.scopes.entries.len() - 1

    while i >= 0
        out @ out.push(r.scopes.entries[i].name)
        i @ i - 1

    return out

## The working state

# One type parameter of the function being resolved: its name, and its
# position in the angle list — `position` is what `TypeRef.generic` carries.
record GenericParam
    name: str
    position: i64

# The pass's working state. It owns everything and takes the tree and the
# source as parameters — the Cyclone rule kept by a language that never had
# the alternative.
record Resolver
    out: resolved.Resolved
    scopes: Scopes
    # Type parameters of the function being resolved, IN POSITION ORDER —
    # an array and not a map, because the did-you-mean ranks candidates in
    # the order supplied and Rust's Vec order is positional, which a sorted
    # map walk would silently replace with alphabetical. Cleared at every
    # declaration: generics are on functions only (§4.12).
    generics: [GenericParam]
    # Every field name declared anywhere in the program, keyed module ->
    # name. One narrow purpose: keep the unknown-function error off
    # `h.cb(n)` where `cb` is a field holding a function value (§4.13).
    fields: {str: {str: bool}}
    # Names the compiler has offered as the repair for an unknown name,
    # keyed module -> name. Exempt from the unused sweep: applying the fix
    # would read them, and two diagnostics for one typo is a defect.
    suggested: {str: {str: bool}}
    owner: i64
    # The module whose declaration is being resolved. Every unqualified
    # name is looked up in it and in nothing else (panel 031).
    module: str
    # `use` lines that were READ, keyed as module_uses is. What is left
    # over is what the unused rule reports.
    module_reads: {str: {str: bool}}

# The two arenas start full of `.unresolved`, one slot per expression and
# one per written type in the whole program.
#
# **THE TWO LOCALS ARE THE POINT, NOT A STYLE CHOICE** (§4.10). Written as
# `out.uses @ out.uses.push(…)` the target is a FIELD place, and the
# in-place store fires on a BARE place only — so every push copied the
# whole arena and filling it was quadratic in the program's expression
# count. Built in a bare local and moved in once: one copy at the end
# instead of one per slot.
function new_resolver(expr_count: i64, type_count: i64) -> Resolver
    out: resolved.Resolved @ resolved.new_resolved()
    uses: [resolved.Ref] @ []
    i: i64 @ 0

    while i < expr_count
        uses @ uses.push(.unresolved)
        i @ i + 1

    out.uses @ uses
    type_uses: [vocab.TypeRef] @ []
    j: i64 @ 0

    while j < type_count
        type_uses @ type_uses.push(.unresolved)
        j @ j + 1

    out.type_uses @ type_uses
    generics: [GenericParam] = []
    fields: {str: {str: bool}} = {}
    suggested: {str: {str: bool}} = {}
    module_reads: {str: {str: bool}} = {}
    return Resolver(
        out: out,
        scopes: new_scopes(),
        generics: generics,
        fields: fields,
        suggested: suggested,
        owner: 0,
        module: "",
        module_reads: module_reads
    )

function push_diagnostic(@r: Resolver, d: diag.Diagnostic)
    r.out.diagnostics @ r.out.diagnostics.push(d)

# Membership in a module -> name table, shared by fields/suggested/reads.
function keyed_has(table: {str: {str: bool}}, module: str, name: str) -> bool
    inner = table[module]

    if inner.is_err()
        return false
    return !inner.must()[name].is_err()

function keyed_add(@table: {str: {str: bool}}, module: str, name: str)
    inner: {str: bool} @ {}
    found = table[module]

    if !found.is_err()
        inner @ found.must()
    inner[name] @ true
    table[module] @ inner

# A top-level name an UNQUALIFIED mention can reach: this module's own
# declarations, then the library's. The library is the one module every
# file sees without naming it, and that is not an exception to "always
# qualified" — its names are reserved built-ins (§1.11 Tier 2), spent by
# the language rather than imported by the file.
function top_visible(r: Resolver, name: str) -> i64?
    own = resolved.top_in(r.out, module: r.module, name: name)

    if !own.is_err()
        return own
    return resolved.top_in(r.out, module: source.LIBRARY_MODULE, name: name)

# The names this file calls the modules it `use`s, for a did-you-mean over
# them.
#
# **The local names, not the module names** (panel 100): they appear beside a
# qualifier the author wrote, so a candidate must be writable there.
#
# ORDER: ascending, because `not_a_module` prints it and a golden reads it.
function used_modules(r: Resolver) -> [str]
    named = r.out.module_uses[r.module]

    if named.is_err()
        return []
    return sort(keys(named.must()))

# Is `text` a field name this file could legitimately be reaching? Its own
# module's fields, the library's, and every module it `use`s — this file may
# hold a `geom.Point` and write `p.x`. (Keyed by module since 2026-08-12:
# bare names let another module delete a certain fix.)
# ORDER: none — the walk answers a bool, so no order reaches anything.
function field_in_reach(r: Resolver, text: str) -> bool
    for module in keys(r.fields)
        if keyed_has(r.fields, module: module, name: text)
            if module == r.module || module == source.LIBRARY_MODULE || resolved.is_used_module(r.out, from: r.module, module: module)
                return true

    return false

# The candidates for a name that resolved to nothing, remembered so the
# unused sweep can stay quiet about them — keyed by the module that was
# offered the repair, so a did-you-mean in geom.hero cannot exempt a name
# in main.hero (a dropped error, 2026-08-12).
function near_names(@r: Resolver, name: str, candidates: [str]) -> [str]
    near = errors.nearest(name, candidates)

    for candidate in near
        keyed_add(@r.suggested, module: r.module, name: candidate)

    return near

# Records what an occurrence resolved to, and counts the read.
function record_use(@r: Resolver, at: i64, to: resolved.Ref)
    r.out.uses[at] @ to

    match to
        .local l                                => r.out.locals[l.at].reads @ r.out.locals[l.at].reads + 1
        .unresolved | .top | .builtin | .module => return

## Declaring

# Binds `name` in the innermost scope and hands back its local index.
# Absence means nothing was bound — the wildcard, or a name that was
# refused — and in both cases the walk carries on: a refused binding is one
# diagnostic, not a cascade.
function declare(@r: Resolver, s: source.Source, decls: [ast.Decl], name: token.Span, binding: resolve_binding.Binding) -> i64?
    text = source.span_text(s, name)

    if text == "_"
        return fail("wildcard", "`_` never binds")
    previous = lookup_local(r, text)

    if !previous.is_err()
        at = r.out.locals[previous.must()].name
        bound_at = source.elsewhere(s, here: name.start, there: at.start)
        push_diagnostic(@r, errors.shadowed(name: text, bound_at: bound_at, span: name))
        return fail("refused", "shadowing is a compile error")

    # **A `use` binds its name for the whole file, so a local may not take it
    # either** — the mirror of `use_shadows_a_declaration` and the same rule,
    # because `use` BINDS (panel 031 R3, ratified at `DESIGN-LOG:185`, which
    # chose that verb for exactly this coverage). FIRST of the four, because a
    # `use` line is always in this file. **It reports and then BINDS**, unlike
    # the three below: returning here leaves the name meaning the MODULE,
    # which is not a value, and one mistake became five diagnostics — measured
    # on `examples/json/parse.hero` (panel 102, the whole argument).
    used = resolved.used_module_named(r.out, from: source.module_at(s, name.start), binding: text)

    if !used.is_err()
        push_diagnostic(@r, diagnostics.local_shadows_a_use(name: text, module: used.must(), span: name))

    # A built-in's name is taken everywhere, not only at the top level: a
    # local `ok` makes `ok(x)` on the next line mean the local, which is
    # precisely the bug the shadow ban exists to kill. BEFORE the top-level
    # check, and the order is the message: reported the other way, a local
    # named `range` would say "the declaration at line 30", naming a line
    # in a file the author cannot open (§1.11).
    if !inventory.index_of(text).is_err()
        push_diagnostic(@r, errors.builtin_name_taken(text, span: name))
        return fail("refused", "a built-in's name is taken everywhere")
    top = top_visible(r, text)

    if !top.is_err()
        # The library and the author's file cannot shadow each other: they
        # share one Source and therefore one table, but they are two
        # programs. Only this direction needs the guard — a user local
        # shadowing a library DECLARATION is caught above, because every
        # name the library declares is a reserved built-in.
        declared_at = decls[top.must()].name.start

        if source.is_library(s, name.start) == source.is_library(s, declared_at)
            at = source.elsewhere(s, here: name.start, there: declared_at)
            push_diagnostic(@r, errors.shadows_top_level(name: text, declared_at: at, span: name))
            return fail("refused", "the declaration is in scope everywhere")
    index = r.out.locals.len()

    # Through the array rather than through the field, for `new_resolver`'s
    # reason one department over: a field place copies the whole array on
    # every append, and this one runs once per binding in the program.
    push_local(
        @r.out.locals,
        resolved.Local(name: name, kind: binding.kind, mutable: binding.mutable, owner: r.owner, depth: scope_depth(r), ty: binding.ty, value: binding.value, reads: 0, writes: 0)
    )
    push_entry(@r.scopes.entries, ScopeEntry(name: text, local: index))
    return ok(index)

function push_local(@locals: [resolved.Local], one: resolved.Local)
    locals @ locals.push(one)

function push_entry(@entries: [ScopeEntry], one: ScopeEntry)
    entries @ entries.push(one)

## The unused sweep

# §4.16's exemption is checked here, once, after the whole file has been
# walked: a hole at the bottom of the file suspends the rule at the top of
# it, so this cannot be decided while walking. It is asked PER MODULE,
# against the binding's own file, because §4.16 makes the suppression
# file-wide.
function report_unused(@r: Resolver, s: source.Source)
    gathered: [diag.Diagnostic] @ []

    for local in r.out.locals
        if local.reads > 0
            continue
        module = source.module_at(s, local.name.start)

        if resolved.hole_covers(r.out, module)
            continue

        # The copy-out of an `@` parameter is observable by the caller
        # (§4.8), so writing one is using it.
        if local.kind == .param && local.mutable && local.writes > 0
            continue
        name = source.span_text(s, local.name)

        # Already spoken for: the compiler offered this name as the repair
        # for a name that resolved to nothing, and applying that repair
        # reads it. One typo, one diagnostic.
        if keyed_has(r.suggested, module: module, name: name)
            continue
        gathered @ gathered.push(errors.unused(name, local.kind, local.writes, local.name))

    for d in gathered
        push_diagnostic(@r, d)

## Tests

function span_at(start: i64, end: i64) -> token.Span
    return token.Span(start: start, end: end)

# A tiny source whose offsets the tests below hand out as names. The text
# is the name table: `x` at 0, `y` at 2, `x` again at 4, `_` at 6, `ok` at
# 8, `range` at 11.
function tiny() -> source.Source
    return source.new_source(name: "t.hero", text: "x y x _ ok range\n")

test "a sibling scope's binding is invisible, a parent's shadows"
    s = tiny()
    decls: [ast.Decl] = []
    r: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    open_scope(@r)
    first = declare(
        @r,
        s,
        decls,
        span_at(start: 0, end: 1),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    assert first.must() == 0

    # A sibling block: open, bind y, close — then a second block binds y again.
    open_scope(@r)
    _ = declare(
        @r,
        s,
        decls,
        span_at(start: 2, end: 3),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    close_scope(@r)
    open_scope(@r)
    again = declare(
        @r,
        s,
        decls,
        span_at(start: 2, end: 3),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    assert !again.is_err()

    # The parent's x IS in scope: shadowing refused, one diagnostic.
    inner_x = declare(
        @r,
        s,
        decls,
        span_at(start: 4, end: 5),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    assert inner_x.is_err()
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "shadowed_binding"
    assert r.out.diagnostics[0].message == "`x` is already in scope, bound at line 1 — shadowing is an error here: a name means one thing for as long as it is visible"

test "the wildcard never binds and a built-in is taken everywhere"
    s = tiny()
    decls: [ast.Decl] = []
    r: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    open_scope(@r)
    wild = declare(@r, s, decls, span_at(start: 6, end: 7), resolve_binding.payload_binding())
    assert wild.is_err()
    assert r.out.diagnostics.len() == 0
    assert r.out.locals.len() == 0
    taken = declare(
        @r,
        s,
        decls,
        span_at(start: 8, end: 10),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    assert taken.is_err()
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "builtin_name_taken"
    reserved = declare(@r, s, decls, span_at(start: 11, end: 16), resolve_binding.cell_binding(ty: 0, value: 0))
    assert reserved.is_err()
    assert r.out.diagnostics.len() == 2

test "the unused sweep spares the hole's module, the @ write, the suggestion"
    s = tiny()
    decls: [ast.Decl] = []
    r: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    open_scope(@r)
    _ = declare(
        @r,
        s,
        decls,
        span_at(start: 0, end: 1),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    _ = declare(@r, s, decls, span_at(start: 2, end: 3), resolve_binding.param_binding(ty: 0, mutable: true))
    r.out.locals[1].writes @ 1
    report_unused(@r, s)

    # x is unused; y is an @ parameter that was written, so it is spared.
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "unused_binding"

    # A hole in the module suspends the rule file-wide.
    quiet: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    open_scope(@quiet)
    _ = declare(
        @quiet,
        s,
        decls,
        span_at(start: 0, end: 1),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    resolved.note_hole(@quiet.out, "t")
    report_unused(@quiet, s)
    assert quiet.out.diagnostics.len() == 0

    # A suggested name is already spoken for.
    offered: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    open_scope(@offered)
    _ = declare(
        @offered,
        s,
        decls,
        span_at(start: 0, end: 1),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    candidates: [str] = ["x"]
    offered.module @ "t"
    _ = near_names(@offered, "z", candidates)
    report_unused(@offered, s)
    assert offered.out.diagnostics.len() == 0

test "a read through record_use counts, and only a local's"
    r: Resolver @ new_resolver(expr_count: 2, type_count: 0)
    r.out.locals @ r.out.locals.push(
        resolved.Local(name: span_at(start: 0, end: 1), kind: .bind, mutable: false, owner: 0, depth: 0, ty: fail("absent", "inferred"), value: fail("absent", "none"), reads: 0, writes: 0)
    )
    record_use(@r, at: 0, to: .local(at: 0))
    record_use(@r, at: 1, to: .builtin(at: 18))
    assert r.out.locals[0].reads == 1
    assert r.out.uses[0] == .local(at: 0)
    assert r.out.uses[1] == .builtin(at: 18)

test "what the library declares and what the file declares stay two programs"
    # A two-file source: the root declares `helper` at its offset 9; the
    # library declares `range` at ITS offset. A root local named `helper`
    # is refused (same file); the fields/suggested tables key by module.
    s = source.with_library(
        name: "main.hero",
        user: "function helper()\n    return\n",
        library: "function range()\n    return\n"
    )
    d: [ast.Decl] @ []
    doc: [token.Span] = []
    ps: [ast.Param] = []
    generics: [token.Span] = []
    f = ast.FunctionDecl(
        generics: generics,
        params: ps,
        result: 0,
        body: fail("absent", "unused in this test"),
        is_extern: false,
        header: fail("absent", "none"),
        library: fail("absent", "none")
    )
    d @ d.push(
        ast.Decl(name: span_at(start: 9, end: 15), doc: doc, span: span_at(start: 0, end: 15), kind: .function_decl(value: f))
    )
    r: Resolver @ new_resolver(expr_count: 0, type_count: 0)
    r.module @ "main"
    resolved.declare_top(@r.out, module: "main", name: "helper", decl: 0)
    open_scope(@r)
    clash = declare(
        @r,
        s,
        d,
        span_at(start: 9, end: 15),
        resolve_binding.bind_binding(ty: fail("absent", "inferred"), value: 0)
    )
    assert clash.is_err()
    assert r.out.diagnostics.len() == 1
    assert r.out.diagnostics[0].code == "shadowed_binding"
    assert r.out.diagnostics[0].message == "`helper` is the name of the declaration at line 1, which is in scope everywhere — pick another name"
