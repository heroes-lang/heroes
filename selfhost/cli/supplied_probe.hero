# The links asked beside a program's own, which see what its own link cannot
# (design.md §4.19, §1.12; defect 2363; panel 239's R1.2, the ffi-pragmatist's
# v6), out of `cli/supplied.hero` at the landing along its seam: this runs the
# probes, that module decides when.
#
# **Why another link, and never a reader of each library's symbols**: no
# linker names an object of an archive it did not load (the sitting's § 1,
# GNU ld, lld and ld64 alike), and a reader of every library's symbols is a
# tool the compiler never starts (`nm`, a third on Windows). So:
#
# - **the libraries in the other order**, where the program names two or
#   more: a name two of them define reaches the other in one of the orders,
#   every word but the `-l` words standing where it stood, a Linux group's
#   included;
# - **every library file loaded whole**, where the probe in the other order
#   read a library file of objects the program names, or was refused: a
#   definition no order loads, because the name was satisfied by another
#   object of the same file (`ab`: Apple's linker takes `libab`'s `pick` in
#   both orders while `libbs`'s own call reaches it), is a duplicate there,
#   both files named; unresolved names allowed;
# - **the platform alone**, the program's objects with no library of its own,
#   asked only where a binding of a group naming no library was refused.
#
# Every probe lists the files it opened (`-t`, and Apple's map), which is what
# its answer is kept by (`cli/supplied_kept.hero`), and writes only private
# names under `build/`, removed before it answers.

use cli/clang_asked
use cli/link_flags
use cli/process
use cli/publish
use cli/strings
use cli/supplied_names
use cli/supplied_read
use cli/toolchain
use emit/ffi_build
use emit/ffi_lookup

# What one probe link said: whether it linked, its words (both streams where
# it linked, its refusal's where it did not), what it printed, and its map.
record Probe
    linked: bool
    said: str
    printed: str
    listing: str

# What the probes said, the linker's answers and never a verdict, so a kept
# answer is judged again against the program as it stands: whether the
# probe in the other order ran and linked, each traced name's supplier there
# or the duplicates it was refused on; whether the whole probe ran and
# linked and the duplicates it was refused on; the platform's supplier of
# each name it was asked; and every library file of the program's any of them
# opened.
record Probes
    reversed: bool
    reversed_linked: bool
    taken: {str: str}
    refused: [supplied_read.Duplicate]
    whole: bool
    whole_linked: bool
    dups: [supplied_read.Duplicate]
    platform: {str: str}
    files: [str]

function none() -> Probes
    no_dups: [supplied_read.Duplicate] = []
    no_files: [str] = []
    no_map: {str: str} = {}
    return Probes(
        reversed: false,
        reversed_linked: false,
        taken: no_map,
        refused: no_dups,
        whole: false,
        whole_linked: false,
        dups: no_dups,
        platform: no_map,
        files: no_files
    )

# The probes of `line`, whose library names are `named`, tracing `names`.
function probed(t: toolchain.Toolchain, line: [str], names: [str], named: [str]) -> Probes
    out: Probes @= none()

    if named.len() < 2
        return out
    apple = link_flags.apple(t.target)
    second = probe(t, line: reversed(line), names: names, tag: "reversed", trace: true)
    out.reversed @ true
    out.reversed_linked @ second.linked
    out.files @ supplied_read.opened(said: second.printed, listing: second.listing, named: named)
    seen: bool @= true

    if second.linked
        out.taken @ supplied_read.taken(said: second.said, listing: second.listing, apple: apple, names: names)
        seen @ supplied_read.files_seen(said: second.said, listing: second.listing, apple: apple, named: named)
    else
        out.refused @ supplied_read.duplicates(second.said)

    if !seen
        return out
    none_traced: [str] = []
    whole = probe(t, line: whole_line(line, apple: apple), names: none_traced, tag: "whole", trace: false)
    out.whole @ true
    out.whole_linked @ whole.linked
    out.files @ with_new(list: out.files, more: supplied_read.opened(said: whole.printed, listing: "", named: named))

    if !whole.linked
        out.dups @ supplied_read.duplicates(whole.said)
    return out

function with_new(list: [str], more: [str]) -> [str]
    out: [str] @= list

    for one in more
        if !supplied_names.named_in(out, name: one)
            out @ out.push(one)

    return out

# The platform's supplier of each of `names`, the program's objects linked
# with no library of its own and unresolved names allowed, "" for a name it
# did not answer; an error where that link was refused, so nothing is taken
# from it.
function platform(t: toolchain.Toolchain, line: [str], names: [str]) -> {str: str}?
    apple = link_flags.apple(t.target)
    alone = probe(t, line: platform_only(line, apple: apple), names: names, tag: "platform", trace: true)

    if !alone.linked
        return fail(code: "refused", msg: alone.said)
    answered = supplied_read.taken(said: alone.said, listing: alone.listing, apple: apple, names: names)
    out: {str: str} @= {}

    for name in names
        out[name] @ answered[name].default("")

    return ok(out)

# The line with its `-l` words in the other order, every other word where it
# stood, the group words of GNU ld included.
function reversed(line: [str]) -> [str]
    at: [i64] @= []

    for index in range(from: 0, to: line.len())
        if strings.starts_with(text: line[index], prefix: "-l")
            at @ at.push(index)

    out: [str] @= line
    k: i64 @= 0

    while k < at.len()
        out[at[k]] @ line[at[at.len() - 1 - k]]
        k @ k + 1

    return out

# The line with every library file of objects loaded whole and unresolved
# names allowed: GNU ld's and lld's `--whole-archive` around the `-l` words,
# which leaves a shared library as it was, and Apple's `-all_load`.
function whole_line(line: [str], apple: bool) -> [str]
    out: [str] @= []
    first: i64 @= -1
    last: i64 @= -1

    for index in range(from: 0, to: line.len())
        if strings.starts_with(text: line[index], prefix: "-l")
            if first < 0
                first @ index
            last @ index

    for index in range(from: 0, to: line.len())
        if index == first && !apple
            out @ out.push("-Wl,--whole-archive")
        out @ out.push(line[index])

        if index == last && !apple
            out @ out.push("-Wl,--no-whole-archive")

    if apple
        return out.push("-Wl,-all_load").push("-Wl,-undefined,dynamic_lookup")
    return out.push("-Wl,--unresolved-symbols=ignore-all")

# The line with no library of the program's and its unresolved names allowed.
function platform_only(line: [str], apple: bool) -> [str]
    out: [str] @= []
    skip: bool @= false

    for word in line
        if skip
            skip @ false
            continue

        if word == "-framework"
            skip @ true
            continue

        if !strings.starts_with(text: word, prefix: "-l")
            out @ out.push(word)

    if apple
        return out.push("-Wl,-undefined,dynamic_lookup")
    return out.push("-Wl,--unresolved-symbols=ignore-all")

# The words that ask a link who supplied each of `names`, GNU ld's and lld's
# trace or Apple's map written to `map_path`, and where `listed`, which files
# it opened, every linker's `-t`, which each of the three writes on its
# standard output (measured): what the probes' answers are kept by, asked
# only where there are probes.
function asking_words(target: str, names: [str], map_path: str, listed: bool) -> [str]
    out: [str] @= []

    if link_flags.apple(target)
        out @ ["-Wl,-map," + map_path]
    else
        for name in names
            out @ out.push("-Wl,--trace-symbol=" + name)

    if listed
        return out.push("-Wl,-t")
    return out

# One probe link of `line`, into private names it removes; with `trace`, each
# name traced; every file it opened listed.
function probe(t: toolchain.Toolchain, line: [str], names: [str], tag: str, trace: bool) -> Probe
    base = publish.private_name(t.build + "/supplied-" + tag)
    binary = base + process.exe_suffix()
    map_path = base + ".map"
    err_path = base + ".err.txt"
    out_path = base + ".out.txt"
    words: [str] @= line

    if trace
        words @ strings.with_all(
            list: words,
            more: asking_words(target: t.target, names: names, map_path: map_path, listed: true)
        )
    else
        words @ words.push("-Wl,-t")
    words @ strings.with_all(list: words, more: ["-o", binary])
    printed: str @= ""
    asked = clang_asked.asked_apart(
        program: "env",
        words: strings.with_all(list: ["env", "LC_ALL=C"], more: words),
        what: "asking the link which library supplies each name",
        err_path: err_path,
        out_path: out_path,
        printed: @printed
    )
    map_read = read_file(map_path).default("")

    for path in [binary, map_path, err_path, out_path]
        publish.discard(path)

    _ = process.remove_tree(binary + ".dSYM").is_err()

    match asked
        .ok said => return Probe(linked: true, said: printed + said, printed: printed, listing: map_read)
        .err e   => return Probe(linked: false, said: e.msg, printed: printed, listing: "")

# The names the runtime's object needs from outside it, asked once per object:
# the object linked alone with no library, every name the link calls
# undefined read back (`ffi_build.undefined_symbol`), kept beside it under
# `build/`. Measured by the sitting on this Mac: 142 names, `nm -u`'s, and
# `main`, which is the program's.
function runtime_needs(t: toolchain.Toolchain, objects: [str]) -> [str]
    nothing: [str] = []
    runtime: str @= ""

    for object in objects
        if strings.starts_with(text: supplied_names.base_of(object), prefix: "runtime-")
            runtime @ object

    if runtime == ""
        return nothing
    kept = t.build + "/supplied-needs-" + supplied_names.base_of(runtime) + ".txt"
    cached = read_file(kept)

    if !cached.is_err()
        return supplied_read.byte_lines(text: cached.must(), needles: [], stops: [])
    base = publish.private_name(t.build + "/supplied-needs")
    err_path = base + ".err.txt"
    asked = clang_asked.asked(
        program: "env",
        words: ["env", "LC_ALL=C", "clang", "-nostdlib", runtime, "-o", base + process.exe_suffix()],
        what: "asking which names the runtime needs",
        err_path: err_path,
        out_path: ""
    )
    publish.discard(base + process.exe_suffix())
    publish.discard(err_path)
    said: str @= ""

    match asked
        .ok    => return nothing
        .err e => said @ e.msg

    out: [str] @= []
    seen: {str: bool} @= {}

    for line in ffi_lookup.lines(text: said)
        name = ffi_build.undefined_symbol(line)

        if name.is_err() || name.must() == "main" || !seen[name.must()].is_err()
            continue
        seen[name.must()] @ true
        out @ out.push(name.must())

    if out.len() > 0
        _ = publish.rewrite(path: kept, text: out.join("\n") + "\n").is_err()
    return out

## Tests

test "the reversed, the whole and the platform's lines move the -l words alone (panel 239)"
    line = ["clang", "-L", "d", "x.o", "-Wl,--start-group", "-la", "-lb", "-lc", "-Wl,--end-group"]
    assert reversed(line) == ["clang", "-L", "d", "x.o", "-Wl,--start-group", "-lc", "-lb", "-la", "-Wl,--end-group"]
    assert whole_line(["clang", "x.o", "-la", "-lb"], apple: false) == ["clang", "x.o", "-Wl,--whole-archive", "-la", "-lb", "-Wl,--no-whole-archive", "-Wl,--unresolved-symbols=ignore-all"]
    assert whole_line(["clang", "x.o", "-la"], apple: true) == ["clang", "x.o", "-la", "-Wl,-all_load", "-Wl,-undefined,dynamic_lookup"]
    assert platform_only(["clang", "x.o", "-lm", "-framework", "Cocoa"], apple: true) == ["clang", "x.o", "-Wl,-undefined,dynamic_lookup"]
    assert asking_words(target: "arm64-apple-darwin25.0.0", names: ["pick"], map_path: "m.map", listed: true) == ["-Wl,-map,m.map", "-Wl,-t"]
    assert asking_words(target: "aarch64-unknown-linux-gnu", names: ["pick", "puts"], map_path: "", listed: false) == ["-Wl,--trace-symbol=pick", "-Wl,--trace-symbol=puts"]
