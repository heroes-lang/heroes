# A line of the runtime's own headers that declares, before any group's
# header, the very name a header of the program's own declares again
# (design.md §4.19, §4.17; CLAUDE.md §7's named exception; defect 2045,
# 2026-10-13). Every unit opens with `heroes_unit.h` and `hero_os.h`
# (`emit/externs.hero`'s `SEEDS`), which declare the Heroes runtime's
# functions, types and macros before any group's header. So a header of the
# program's own that declares one of those names another way, `static inline
# int hero_str_len(int x)`, is refused by clang at the header's own line, and
# clang's note lands on the runtime's declaration; defect 360's rule kept a
# note in the runtime's files the compiler's, and it was told *internal
# error: compiling the generated C failed* at exit 2. The unit holds both
# names, so the program is refused before and after; what moves is who is
# told (defects 060 and 360).
#
# **Asked of the two lines, never of a list of names.** The name is the
# identifier clang's caret stands on under the error, in the header's own
# line, read from its bytes where a second clang run says clang read it
# (`cli/caret_bytes.hero`, defect 2117: clang's excerpt of it was read until
# then, which a line past 4,096 bytes has none of); and the runtime's line,
# read from the runtime's own file at the row clang's note names, holds that
# same identifier at the note's column, where clang says the earlier
# declaration stands. Any other note in
# the runtime's files is not this reading's, and neither is a note in the file
# clang compiled, whose names the emitter writes after the groups
# (`cli/declared_after.hero`).
#
# **Two more of the runtime's names the header's line meets** (defect 2049,
# 2026-10-13), each asked of the two lines the same way. A function of the
# runtime's the line calls, `hero_str_len(8)`: clang's note stands at the
# runtime's parameter, and the runtime's line declares the very function
# whose call's parentheses hold clang's caret (`called`). A name of the
# runtime's clang suggests for one the line misspells, `HeroSt`: the note
# stands at that name in the runtime's line, and clang's message ends `did
# you mean 'HeroStr'?` (`suggested`).

use emit/clang_place
use emit/ffi_lookup
use cli/standard_name
use cli/caret_bytes

constant NOTE: str
    ": note: "

# The name a header declares again where the runtime declared it first: the
# identifier clang's caret stands on under the error at row `error` of
# `rows`, where the note at row `note`, at line `row` of `path`, one of
# `runtime`'s files (`runtime_key.made_of`), points at that same identifier
# in the runtime's own line; absent for any other note. The runtime's line
# is asked first, so the unit is compiled again (`again`) only for a note
# that stands on a name.
function declared(rows: [str], error: i64, note: i64, path: str, row: i64, runtime: [str], @again: caret_bytes.Again) -> str?
    column = column_of(rows[note])?
    line = standard_name.line_of(path: path, row: row, runtime: runtime)?
    said = caret_bytes.name_at(text: line, at: column - 1)?
    name = caret_bytes.name(rows, after: error, @again)?

    if said != name
        return fail(code: "none", msg: "the note is no declaration of the error's name")
    return ok(name)

# The function of the runtime's own that the line under the error at row
# `error` of `rows` calls, where the note at line `row` of `path`, one of
# `runtime`'s files, stands in that function's declaration: the name before
# the runtime's line's first `(` is the one before the `(` whose parentheses
# hold clang's caret, `hero_str_len(8)` under *passing 'int' to parameter of
# incompatible type 'HeroStr'*; absent for any other note.
function called(rows: [str], error: i64, path: str, row: i64, runtime: [str], @again: caret_bytes.Again) -> str?
    line = standard_name.line_of(path: path, row: row, runtime: runtime)?
    opening = clang_place.offset_of(text: line, needle: "(")?
    name = name_before(text: line, at: opening, from: 0)?
    caret = caret_bytes.caret(rows, after: error, @again)?
    callee = callee_at(text: caret.line, at: caret.at, from: 0)?

    if callee != name
        return fail(code: "none", msg: "the caret stands in no call of the note's function")
    return ok(name)

# The name of the runtime's own clang suggests in the line it quoted, where
# the note at row `note` of `rows`, at line `row` of `path`, one of
# `runtime`'s files, stands on that name in the runtime's own line, and one of
# `said`, what clang wrote of the error at the error's own place, says `did
# you mean '<name>'?`; absent for any other note. clang writes the
# suggestion in the error's message for a type, `unknown type name 'HeroSt';
# did you mean 'HeroStr'?`, and for a call to a function nobody declared in
# a note of its own at the call, before the note at the declaration
# (defect 2052): so `said` is the error's message and the text of each note
# at the error's file and line.
function suggested(rows: [str], said: [str], note: i64, path: str, row: i64, runtime: [str]) -> str?
    column = column_of(rows[note])?
    line = standard_name.line_of(path: path, row: row, runtime: runtime)?
    name = caret_bytes.name_at(text: line, at: column - 1)?

    for text in said
        if !clang_place.offset_of(text: text, needle: SUGGESTION + name + "'?").is_err()
            return ok(name)

    return fail(code: "none", msg: "clang suggests no name of the runtime's at the error")

constant SUGGESTION: str
    "did you mean '"

# The function whose call's parentheses hold byte `at` of `text`, read no
# further back than byte `from`: the nearest `(` before it that no `)`
# between closes, and the name just before that `(`.
function callee_at(text: str, at: i64, from: i64) -> str?
    depth: i64 @= 0
    index: i64 @= at - 1

    while index >= from
        if text[index] == ')'
            depth @ depth + 1
        else if text[index] == '('
            if depth == 0
                return name_before(text: text, at: index, from: from)
            depth @ depth - 1
        index @ index - 1

    return fail(code: "none", msg: "the caret stands in no call")

# The C identifier that ends just before byte `at` of `text`, spaces between
# passed over, read no further back than byte `from`.
function name_before(text: str, at: i64, from: i64) -> str?
    stop: i64 @= at

    while stop > from && text[stop - 1] == ' '
        stop @ stop - 1

    start: i64 @= stop

    while start > from && caret_bytes.in_name(text[start - 1])
        start @ start - 1

    if start == stop
        return fail(code: "none", msg: "no name before it")
    return caret_bytes.name_at(text: text, at: start)

# The column a note line names, `path:row:col: note: ...`.
function column_of(line: str) -> i64?
    text = clang_place.without_return(line)
    at = clang_place.offset_of(text: text, needle: NOTE)?
    tail = clang_place.last_number(text.slice(from: 0, to: at))?
    return ok(tail.number)

## Tests

# Clang's words as Apple clang 21 wrote them on 2026-10-13 for the cases of
# `tests/golden/unsupported/fixedbugs-2045-*`, each line of the runtime's
# found by its text and never by its number.
test "a note at the runtime's own declaration of the name the error's caret stands on names it (defect 2045)"
    runtime = ["runtime/runtime.c", "runtime/heroes_runtime.h", "runtime/hero_os.h"]
    length = row_of(path: "runtime/heroes_runtime.h", line: "int64_t hero_str_len(HeroStr s);")
    str_type = row_of(path: "runtime/heroes_runtime.h", line: "} HeroStr;")
    pid = row_of(path: "runtime/hero_os.h", line: "int64_t hero_os_pid(void);")
    static = clang_rows(
        at: "1:19",
        line: "static inline int hero_str_len(int x) { return x; }",
        caret: "                  ^",
        note: "runtime/heroes_runtime.h:" + length.to_str() + ":9"
    )
    again: caret_bytes.Again @= caret_bytes.none()
    assert declared(rows: static, error: 0, note: 3, path: "runtime/heroes_runtime.h", row: length, runtime: runtime, @again).must() == "hero_str_len"
    typed = clang_rows(
        at: "1:13",
        line: "typedef int HeroStr;",
        caret: "            ^",
        note: "runtime/heroes_runtime.h:" + str_type.to_str() + ":3"
    )
    assert declared(rows: typed, error: 0, note: 3, path: "runtime/heroes_runtime.h", row: str_type, runtime: runtime, @again).must() == "HeroStr"
    os = clang_rows(
        at: "1:5",
        line: "int hero_os_pid(int x);",
        caret: "    ^",
        note: "runtime\\hero_os.h:" + pid.to_str() + ":9"
    )
    assert declared(rows: os, error: 0, note: 3, path: "runtime\\hero_os.h", row: pid, runtime: runtime, @again).must() == "hero_os_pid"

    # A tab in the header's line, one byte where clang's column counts it,
    # however its excerpt draws it; and the Windows box's line endings.
    tabbed = [
        "./bad.h:1:5: error: conflicting types for 'hero_str_len'\r"
        "    1 | int     hero_str_len(int x);\r"
        "      |         ^\r"
        "runtime/heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here\r"
    ]
    again @ caret_bytes.given(said: tabbed.join("\n"), files: {"./bad.h": "int\thero_str_len(int x);\r\n"})
    assert declared(rows: tabbed, error: 0, note: 3, path: "runtime/heroes_runtime.h", row: length, runtime: runtime, @again).must() == "hero_str_len"

    # DEFECT 2117: the header's line read where clang quoted none of it, a
    # line past 4,096 bytes, and past a character of two bytes, which its
    # excerpt drew one column wide.
    long = "/* éé */ " + " ".repeat(4096) + "static inline int hero_str_len(int x);"
    unquoted = [
        "./bad.h:1:4126: error: static declaration of 'hero_str_len' follows non-static declaration"
        "runtime/heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here"
    ]
    again @ caret_bytes.given(said: unquoted.join("\n"), files: {"./bad.h": long + "\n"})
    assert declared(rows: unquoted, error: 0, note: 1, path: "runtime/heroes_runtime.h", row: length, runtime: runtime, @again).must() == "hero_str_len"

# What is no such note: a parameter a call passed a wrong value to, a name a
# misspelling resembles, a column off the name, a file that is not the
# runtime's, and a header's line no file holds.
test "a note at another place of the runtime's line, or under no excerpt, names nothing (defect 2045)"
    runtime = ["runtime/runtime.c", "runtime/heroes_runtime.h"]
    length = row_of(path: "runtime/heroes_runtime.h", line: "int64_t hero_str_len(HeroStr s);")
    str_type = row_of(path: "runtime/heroes_runtime.h", line: "} HeroStr;")
    call = clang_rows(
        at: "1:53",
        line: "static inline int eight(void) { return hero_str_len(8); }",
        caret: "                                                    ^",
        note: "runtime/heroes_runtime.h:" + length.to_str() + ":30"
    )
    again: caret_bytes.Again @= caret_bytes.none()
    assert declared(
        rows: call,
        error: 0,
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: length,
        runtime: runtime,
        @again
    ).is_err()
    typo = clang_rows(
        at: "1:33",
        line: "static inline int eight(void) { HeroSt s; (void)s; return 8; }",
        caret: "                                ^~~~~~",
        note: "runtime/heroes_runtime.h:" + str_type.to_str() + ":3"
    )
    assert declared(
        rows: typo,
        error: 0,
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: str_type,
        runtime: runtime,
        @again
    ).is_err()
    off = clang_rows(
        at: "1:19",
        line: "static inline int hero_str_len(int x) { return x; }",
        caret: "                  ^",
        note: "runtime/heroes_runtime.h:" + length.to_str() + ":10"
    )
    assert declared(
        rows: off,
        error: 0,
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: length,
        runtime: runtime,
        @again
    ).is_err()
    static = clang_rows(
        at: "1:19",
        line: "static inline int hero_str_len(int x) { return x; }",
        caret: "                  ^",
        note: "build/tu-1/t.c:" + length.to_str() + ":9"
    )
    assert declared(
        rows: static,
        error: 0,
        note: 3,
        path: "build/tu-1/t.c",
        row: length,
        runtime: runtime,
        @again
    ).is_err()
    bare = [
        "./bad.h:1:19: error: static declaration of 'hero_str_len' follows non-static declaration"
        "runtime/heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here"
    ]
    assert declared(
        rows: bare,
        error: 0,
        note: 1,
        path: "runtime/heroes_runtime.h",
        row: length,
        runtime: runtime,
        @again
    ).is_err()

# Clang's rows for an error at `at` of `./bad.h`, the line it quoted and its
# caret, and a note at `note`.
function clang_rows(at: str, line: str, caret: str, note: str) -> [str]
    return [
        "./bad.h:" + at + ": error: the header's own error"
        "    1 | " + line
        "      | " + caret
        note + ": note: previous declaration is here"
    ]

# The row of a runtime file that reads `line`, found by its text.
function row_of(path: str, line: str) -> i64
    rows = ffi_lookup.lines(text: read_file(path).must())

    for at in range(from: 0, to: rows.len())
        if rows[at] == line
            return at + 1

    assert false
    return 0

# DEFECT 2049: the function a call's parentheses hold the caret in, read back
# from the caret to the `(` no `)` closes, nested calls passed over; and the
# runtime's own function or suggested name, each asked of the runtime's line
# found by its text.
test "the function whose call holds the caret, and a name clang suggests, are read off the lines (defect 2049)"
    assert callee_at(text: "f(g(1), 8)", at: 8, from: 0).must() == "f"
    assert callee_at(text: "hero_print_int(hero_str_len(8))", at: 28, from: 0).must() == "hero_str_len"
    assert callee_at(text: "x = hero_str_len (8);", at: 18, from: 0).must() == "hero_str_len"
    assert callee_at(text: "    1 | (8)", at: 9, from: 8).is_err()
    assert callee_at(text: "return 8;", at: 7, from: 0).is_err()
    assert name_before(text: "(int)(8)", at: 5, from: 0).is_err()
    runtime = ["runtime/runtime.c", "runtime/heroes_runtime.h"]
    length = row_of(path: "runtime/heroes_runtime.h", line: "int64_t hero_str_len(HeroStr s);")
    str_type = row_of(path: "runtime/heroes_runtime.h", line: "} HeroStr;")
    call = clang_rows(
        at: "1:53",
        line: "static inline int eight(void) { return hero_str_len(8); }",
        caret: "                                                    ^",
        note: "runtime/heroes_runtime.h:" + length.to_str() + ":30"
    )
    again: caret_bytes.Again @= caret_bytes.none()
    assert called(rows: call, error: 0, path: "runtime/heroes_runtime.h", row: length, runtime: runtime, @again).must() == "hero_str_len"
    assert called(
        rows: call,
        error: 0,
        path: "runtime/heroes_runtime.h",
        row: str_type,
        runtime: runtime,
        @again
    ).is_err()
    typo = clang_rows(
        at: "1:33",
        line: "static inline int eight(void) { HeroSt s; (void)s; return 8; }",
        caret: "                                ^~~~~~",
        note: "runtime/heroes_runtime.h:" + str_type.to_str() + ":3"
    )
    asked = ["unknown type name 'HeroSt'; did you mean 'HeroStr'?"]
    assert suggested(rows: typo, said: asked, note: 3, path: "runtime/heroes_runtime.h", row: str_type, runtime: runtime).must() == "HeroStr"
    assert suggested(
        rows: typo,
        said: ["unknown type name 'HeroSt'"],
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: str_type,
        runtime: runtime
    ).is_err()
    assert suggested(
        rows: typo,
        said: asked,
        note: 3,
        path: "build/tu-1/t.c",
        row: str_type,
        runtime: runtime
    ).is_err()

    # DEFECT 2052: a call to a function nobody declared, clang's suggestion
    # in a note of its own at the call, as Apple clang 21 and Debian clang
    # 22.1.8 wrote it on 2026-10-13; the runtime's note at the function's
    # name in its declaration. A suggestion of another name names nothing.
    undeclared = clang_rows(
        at: "1:45",
        line: "static inline int eight(void) { return (int)hero_str_le(8); }",
        caret: "                                            ^",
        note: "runtime/heroes_runtime.h:" + length.to_str() + ":9"
    )
    message = "call to undeclared function 'hero_str_le'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]"
    assert suggested(rows: undeclared, said: [message, "did you mean 'hero_str_len'?"], note: 3, path: "runtime/heroes_runtime.h", row: length, runtime: runtime).must() == "hero_str_len"
    assert suggested(
        rows: undeclared,
        said: [message],
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: length,
        runtime: runtime
    ).is_err()
    assert suggested(
        rows: undeclared,
        said: [message, "did you mean 'hero_str_cmp'?"],
        note: 3,
        path: "runtime/heroes_runtime.h",
        row: length,
        runtime: runtime
    ).is_err()
