# Where the runtime is looked for beside the running compiler (design.md
# §3.1; panel 020; defect 277): every directory above the executable, nearest
# first, the third place after `$HEROES_RUNTIME` and `runtime/` under the
# working directory, which until 2026-10-04 was never looked in, so an
# installed compiler found no runtime without the variable while its own
# help said *beside the compiler*; and the message naming the places looked
# in. Its own module, out of `toolchain.hero`, for the ceiling and along a
# seam: where things are, against what is built from them. And what is
# missing at a place, which is what a `HEROES_RUNTIME` naming no runtime is
# told (defect 276). And whether the runtime found is the one this compiler is
# built for, asked of its header before any unit is written (defect 2259).

use cli/process
use module/reading
use emit/runtime_abi

# `runtime/parts/fs.c` is the C, and names each platform's call.
extern "hero_os.h"
    function hero_exe_path_shown(@status: i64, @marks: i64) -> str
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_TEXT: i64

# Every directory above the running compiler, nearest first, each a place
# for `runtime/`; or, where there are none, why: this machine gave no path,
# or one that is not UTF-8, which no `str` can open.
record Beside
    above: [str]
    why: str

function beside_the_compiler() -> Beside
    status: i64 @= 0
    marks: i64 @= 0
    got = hero_exe_path_shown(status: @status, marks: @marks)
    none: [str] = []

    if status == HERO_OS_OK
        return Beside(above: ancestors(got, either: process.exe_suffix() == ".exe"), why: "")

    if status == HERO_OS_NOT_TEXT
        return Beside(
            above: none,
            why: "the compiler's own path, `" + process.written_value(answer: got, marks: marks) + "`, is not UTF-8"
        )
    return Beside(above: none, why: "this machine did not say where the compiler is")

# The directories holding `path`, nearest first, to the root: `/a/b/heroes`
# gives `/a/b`, `/a` and "", whose `runtime/` is `/runtime`. `either` reads a
# `\` as a separator too, as Windows writes its paths and only there, `\`
# being a byte of a name elsewhere (`deps.under`'s rule). Cut at a separator,
# a byte of ASCII, so never inside a character.
function ancestors(path: str, either: bool) -> [str]
    out: [str] @= []
    at: i64 @= path.len() - 1

    while at >= 0
        if path[at] == '/' || either && path[at] == '\\'
            out @ out.push(path.slice(from: 0, to: at))
        at @ at - 1

    return out

# What is missing of a runtime at `dir`, one reason a file, or none where
# both of its files read. Present is what is asked, and a C source that is
# not UTF-8 is present (panel 189): `reading.source_text` reads one.
function missing_at(dir: str) -> [str]
    out: [str] @= []

    for name in ["heroes_runtime.h", "runtime.c"]
        path = dir + "/" + name

        match reading.source_text(path)
            .ok _ => continue
            .err e =>
                if e.code == "file_not_found"
                    out @ out.push("no file at `" + path + "`")
                else
                    out @ out.push("`" + path + "` cannot be read")

    return out

# The refusal of a `HEROES_RUNTIME` naming no runtime, `missing` what is not
# there (defect 276), in the words defect 243 refuses one that is not UTF-8.
function unheld(hint: str, missing: [str]) -> str
    return "`HEROES_RUNTIME` is set to `" + hint + "`, and no Heroes runtime is there: " + missing.join("; ") + "\n  set HEROES_RUNTIME to the directory holding heroes_runtime.h and runtime.c, or unset it to look in ./runtime and beside the compiler"

# Whether the runtime at `dir`, both of whose files are there, is the one this
# compiler is built for: its `heroes_runtime.h` states the interface every unit
# this compiler writes asserts (`emit/runtime_abi.hero`). Refused, code `abi`,
# with which runtime was found, what its header states, what this compiler
# needs and what to do (defect 2259): it was clang's static assertion in every
# unit, told as *internal error* at exit 2, and `heroes doctor` called the
# runtime ok. `named` says `HEROES_RUNTIME` named it; a runtime the search
# found stops the search too, since it is the one the build would compile
# against, and passing over it builds against a runtime nobody named.
function of_this_release(dir: str, named: bool) -> ()?
    read = reading.source_text(dir + "/heroes_runtime.h")

    if read.is_err()
        return fail(code: "abi", msg: unread_text(read))
    said: str @= ""

    match runtime_abi.stated(read.must().text)
        .ok n =>
            if n == runtime_abi.NEEDED
                return ok()
            said @ "states HERO_RUNTIME_ABI " + n.to_str()
        .err e => said @ e.msg

    return fail(code: "abi", msg: other_release(dir: dir, named: named, said: said))

# The refusal of a runtime this compiler is not built for, `said` what its
# header states, in the words defect 276 refuses a `HEROES_RUNTIME` naming no
# runtime: which runtime, then what to do, either way round.
function other_release(dir: str, named: bool, said: str) -> str
    what = " is not the one this compiler is built for: its heroes_runtime.h " + said + ", and this compiler needs " + runtime_abi.NEEDED.to_str()
    again = "build the compiler again from the sources this runtime came with"

    if named
        return "`HEROES_RUNTIME` is set to `" + dir + "`, and the Heroes runtime there" + what + "\n  set HEROES_RUNTIME to the runtime this compiler came with, or unset it to look in ./runtime and beside the compiler; or " + again
    return "the Heroes runtime found at `" + dir + "`" + what + "\n  set HEROES_RUNTIME=<dir> to the runtime this compiler came with, or " + again

function unread_text(failed: reading.Text?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# The places named, as they were looked in, and the way to name another:
# where no `HEROES_RUNTIME` is set, since one that is set is the only place.
function not_found(beside: Beside) -> str
    places: [str] @= ["./runtime"]

    if beside.above.len() > 0
        places @ places.push("runtime/ in `" + beside.above[0] + "` and every directory above it")
    else
        places @ places.push("nothing beside the compiler, since " + beside.why)
    return "cannot find the Heroes runtime (heroes_runtime.h and runtime.c).\n  looked in: " + places.join(", ") + "\n  set HEROES_RUNTIME=<dir> to say where it is"

## Tests

# Defect 277: the third place, under an ancestor of the executable, each
# platform's path cut where it separates, and a message naming the places.
test "the runtime is looked for under every directory above the compiler, nearest first"
    assert ancestors("/a/b/heroes", either: false) == ["/a/b", "/a", ""]
    assert ancestors("C:\\x\\bin\\heroes.exe", either: true) == ["C:\\x\\bin", "C:\\x", "C:"]
    assert ancestors("C:\\x\\heroes.exe", either: false).len() == 0
    assert ancestors("heroes", either: false).len() == 0
    here = beside_the_compiler()
    assert here.why == ""
    assert here.above.len() > 0
    assert process.is_directory(path: here.above[0])
    told = not_found(Beside(above: ["/opt/heroes/bin", "/opt/heroes"], why: ""))
    assert told == "cannot find the Heroes runtime (heroes_runtime.h and runtime.c).\n  looked in: ./runtime, runtime/ in `/opt/heroes/bin` and every directory above it\n  set HEROES_RUNTIME=<dir> to say where it is"
    none: [str] = []
    unsaid = not_found(Beside(above: none, why: "this machine did not say where the compiler is"))
    assert unsaid == "cannot find the Heroes runtime (heroes_runtime.h and runtime.c).\n  looked in: ./runtime, nothing beside the compiler, since this machine did not say where the compiler is\n  set HEROES_RUNTIME=<dir> to say where it is"

# Defect 276: what is missing of a runtime, file by file, where nothing is,
# where a file stands in the directory's place, and where one of the two is.
test "what a place lacks of a runtime is said file by file"
    dir = "build/selftest-runtime-places-276"
    assert !process.mkdir_all(dir).is_err()
    assert missing_at("runtime").len() == 0
    assert missing_at(dir + "/nowhere") == ["no file at `" + dir + "/nowhere/heroes_runtime.h`", "no file at `" + dir + "/nowhere/runtime.c`"]
    assert missing_at("runtime/runtime.c") == ["no file at `runtime/runtime.c/heroes_runtime.h`", "no file at `runtime/runtime.c/runtime.c`"]
    assert !write_file(path: dir + "/heroes_runtime.h", text: "/* a header and no runtime.c */\n").is_err()
    assert missing_at(dir) == ["no file at `" + dir + "/runtime.c`"]
    assert unheld(hint: dir, missing: missing_at(dir)) == "`HEROES_RUNTIME` is set to `" + dir + "`, and no Heroes runtime is there: no file at `" + dir + "/runtime.c`\n  set HEROES_RUNTIME to the directory holding heroes_runtime.h and runtime.c, or unset it to look in ./runtime and beside the compiler"

# Defect 2259: a runtime whose header states another interface, or none, is
# refused saying which runtime, what it states, what this compiler needs and
# what to do, named or found by the search; the tree's own is this compiler's.
test "a runtime of another release is told before clang, named or found (defect 2259)"
    assert !of_this_release(dir: "runtime", named: true).is_err()
    dir = "build/selftest-runtime-abi-2259"
    assert !process.mkdir_all(dir).is_err()
    other = (runtime_abi.NEEDED + 1).to_str()
    needs = runtime_abi.NEEDED.to_str()
    assert !write_file(path: dir + "/heroes_runtime.h", text: "/* another release */\n#define HERO_RUNTIME_ABI " + other + "\n").is_err()
    assert !write_file(path: dir + "/runtime.c", text: "/* its parts */\n").is_err()
    again = "build the compiler again from the sources this runtime came with"

    match of_this_release(dir: dir, named: true)
        .ok _ => assert false
        .err e =>
            assert e.code == "abi"
            assert e.msg == "`HEROES_RUNTIME` is set to `" + dir + "`, and the Heroes runtime there is not the one this compiler is built for: its heroes_runtime.h states HERO_RUNTIME_ABI " + other + ", and this compiler needs " + needs + "\n  set HEROES_RUNTIME to the runtime this compiler came with, or unset it to look in ./runtime and beside the compiler; or " + again

    match of_this_release(dir: dir, named: false)
        .ok _  => assert false
        .err e => assert e.msg == "the Heroes runtime found at `" + dir + "` is not the one this compiler is built for: its heroes_runtime.h states HERO_RUNTIME_ABI " + other + ", and this compiler needs " + needs + "\n  set HEROES_RUNTIME=<dir> to the runtime this compiler came with, or " + again

    assert !write_file(path: dir + "/heroes_runtime.h", text: "/* a header with no stamp */\n").is_err()

    match of_this_release(dir: dir, named: false)
        .ok _  => assert false
        .err e => assert e.msg == "the Heroes runtime found at `" + dir + "` is not the one this compiler is built for: its heroes_runtime.h defines no HERO_RUNTIME_ABI, and this compiler needs " + needs + "\n  set HEROES_RUNTIME=<dir> to the runtime this compiler came with, or " + again
