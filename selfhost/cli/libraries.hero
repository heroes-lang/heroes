# What a group's link and package become on clang's command line
# (design.md §4.19; panels 048, 049, 050, 055). Port of
# archive/bootstrap-rs/heroes-cli/src/commands/libraries.rs.
#
# THE ALLOW-LIST IS THE WHOLE SECURITY OF package, and the precedent
# is not hypothetical: Go shipped the same idea without a filter and
# it became CVE-2018-6574 — attack.so beside `#cgo CFLAGS:
# -fplugin=attack.so`, loaded into the host compiler by `go get`.
# Heroes arrives second: the list is here on the first day. A .pc
# file is INPUT THIS PROGRAM DID NOT WRITE, so it is treated as input
# and not as configuration. The property the list asks of a word:
# does it name a file, load anything, or write anything at build
# time? What a library does AT RUN TIME the list cannot see
# (-lSDL2main replaces main and opens a window; the corpus timeout is
# the instrument for that class — DECIDE.md holds the pair).
#
# pkg-config's answer comes back through two files under build/, and the
# package name reaches it as one argument word, never a second command.
# **The two files were `build/pkg-config-out.txt` and `-err.txt` for every
# build in the tree** until 2026-09-30 (defect 134): two programs naming
# `libzstd` and `liblz4`, built together, read each other's answers, and the
# author was told at exit 1 that `liblz4` *answered with `td`* (a torn read of
# the other's `-I`) or that `lz4.h` is not on the include path. They are
# private names now (`cli/publish.hero`), removed once read.

use cli/process
use cli/publish
use cli/strings
use cli/shell_split
use cli/package_answer
use cli/package_words

# Whether this platform's C runtime already contains a library, so
# naming it is correct and passing it on would be an error (Zig's
# isLibCLibName precedent; the case that forced it is MSVC's LNK1181
# for -lm).
#
# **THIS WAS A STUB THAT NAMED ITS OWN DEFECT.** It answered `false` for
# everything, under a comment saying *"the port runs on POSIX until the
# fixpoint"* — a premise that expired the day Windows became a leg, while
# the sentence went on reading as correct. CLAUDE.md §11's exact shape,
# and the failure it predicted is the one that arrived, measured on the
# Windows leg 2026-08-31 (run 33386236619):
#
#     LNK1104: cannot open file 'm.lib'
#
# On POSIX the maths functions live in a separate `libm`, so a program
# that calls `sqrt` must say `link "m"` and the flag must reach clang. On
# MSVC there is no `m.lib` at all — the maths is inside the C runtime —
# so the same correct program cannot link. The `link` group in the
# `.hero` file is right on both; what differs is the machine.
#
# **`c` and `m` only, because those are the two that were measured.**
# Zig's list is longer (`pthread`, `dl`, `rt`, `util`, `resolv`), and a
# name added here is a name silently DROPPED from a link line — the
# loudest possible failure mode if it is wrong. So this grows one
# measurement at a time, and the platform is read off `exe_suffix()`,
# the runtime answering about the machine it is on (issues/2026-08/14/2026-08-14-0005-is-not-a-fact-about-the-program-so-the-driver.md's
# rule) rather than a `#if` this language does not have.
function in_the_c_runtime(library: str) -> bool
    if process.exe_suffix() != ".exe"
        return false

    return library == "m" || library == "c"

# The words a package may hand back, and nothing else. -D and -U are here
# on Go's own precedent, measured to unlock 28 of 285 .pc files (SDL2 was
# bindable through NEITHER clause without them). The two -Wl forms are
# spellings of things already on the list, checked WHOLE — three
# comma-parts, the middle one named — which is a fact about the value, not
# a premise about what packages tend to send.
#
# **EVERY FLAG IN BOTH ITS SPELLINGS** (defect 160, 2026-10-02): clang reads
# `-D -U -I -L -l -F` with their value joined or as the next word, and
# pkg-config prints some of each, measured on this Mac's pkg-config 3.0.7
# over one `.pc` written both ways: `-F <dir>`, `-I <dir>`, `-D X`,
# `-L <dir>` and `-l m` come back joined, `-U X`, `-framework X` and
# `-Wl,-rpath -Wl,<dir>` as two words. Only `-F` as a pair was read until
# then, so a framework's package was refused with a note listing `-F` as
# accepted. A value in the next word is a value only when it is not itself a
# flag, so a refused flag stays refused in that slot too, and every value is
# handed on JOINED, one word per flag: `compile_flags` below keeps a
# package's compile words by their prefix, and a separate `-I` would have
# reached a compile without its directory.
#
# **The words judged by their whole spelling**, `-pthread`, `-isystem` and
# the two the compiler's own link line already says, are `cli/package_words`'
# (panel 198, defect 444): Debian 13 refused 23 correct packages for them.
function filter_words(package: str, said: str) -> [str]?
    flags: [str] @ []
    parts = shell_split.words(package: package, said: said)?
    index: i64 @ 0

    while index < parts.len()
        word = parts[index]
        next: str @ ""

        if index + 1 < parts.len()
            next @ parts[index + 1]

        if package_words.separate(word) || package_words.valued(word)
            if index + 1 >= parts.len()
                return fail(
                    code: "failed",
                    msg: "heroes-ffi-package `" + package + "` answered with `" + shell_split.shown(word, keep_lines: false) + "` and nothing after it"
                )

            if !package_words.is_value(flag: word, value: next)
                return refused(
                    package: package,
                    said: word + " " + next,
                    told: package_words.told(flag: word, value: next)
                )

            if package_words.separate(word)
                flags @ flags.push(word)
                flags @ flags.push(next)
            else
                flags @ flags.push(package_words.spelled(word) + next)
            index @ index + 2
            continue

        if package_words.restates(word)
            index @ index + 1
            continue
        one = package_words.one_word(word)

        if !one.is_err()
            flags @ flags.push(one.must())
            index @ index + 1
            continue
        link = package_words.linked(word: word, next: next)

        if !link.is_err()
            flags @ strings.with_all(list: flags, more: package_words.linked_words(link.must()))
            index @ index + link.must().words
            continue
        told = shell_split.no_flag(said: said, parts: parts, at: index) + package_words.told_word(word: word, next: next)
        return refused(package: package, said: package_words.named(word: word, next: next), told: told)

    return ok(flags)

# The words of a package's answer a COMPILE needs, `-I -D -U -F` and
# `-pthread` (panel 198), in the order the package gave them: the one rule
# for every step that compiles the program's headers, the units
# (`cli/units.hero`), the pointee and layout probes and the header's
# questions (`compiling.search_words`), so no step keeps a different subset.
# A link word at a compile warns `'linker' input unused`, and the link takes
# `link_words` below.
#
# **Every step kept `-I` alone until defect 161** (2026-10-02): a `.pc`'s
# `-D` never reached clang, so a header using it stopped `build` at exit 2
# with clang's text, and its `-F` never reached a compile, so a framework's
# header was told missing. The rule reads `filter_words`' own output, whose
# contract is that a value is joined to its flag and that `-framework`'s
# name, the one value in a word of its own, never begins with `-` or `@`
# (`package_words.is_value`).
function compile_flags(package_flags: [str]) -> [str]
    out: [str] @ []

    for flag in package_flags
        if flag == "-pthread" || valued_by(flag, prefixes: ["-I", "-D", "-U", "-F"])
            out @ out.push(flag)

    return out

# Whether `flag` is one of `prefixes` with its value joined to it.
function valued_by(flag: str, prefixes: [str]) -> bool
    for prefix in prefixes
        rest = tail_after(word: flag, prefix: prefix)

        if !rest.is_err() && rest.must().len() > 0
            return true

    return false

# The words of a package's answer a LINK reads, in the order the package
# gave them: `-L`, `-l`, `-Wl,-rpath,`, the `-framework` pair, `-pthread`
# but on Windows (`package_words.link_passes`), and `-F` where the answer
# links a framework, since a link reads `-F` only to find one; `-I -D -U` are no link's. The link took the whole answer until defect
# 206, and clang on Linux calls a `-F` at a link *argument unused during
# compilation*, the one compile word it warns about there (Debian clang
# 22.1.8 and 18.1.8, measured 2026-10-03; `-framework` is no Linux link's).
function link_words(package_flags: [str]) -> [str]
    framework: bool @ false

    for flag in package_flags
        if flag == "-framework"
            framework @ true

    out: [str] @ []
    index: i64 @ 0

    while index < package_flags.len()
        flag = package_flags[index]

        if flag == "-framework" && index + 1 < package_flags.len()
            out @ out.push(flag)
            out @ out.push(package_flags[index + 1])
            index @ index + 2
            continue

        if package_words.link_passes(flag) || valued_by(flag, prefixes: ["-L", "-l", "-Wl,"]) || framework && valued_by(flag, prefixes: ["-F"])
            out @ out.push(flag)
        index @ index + 1

    return out

# The refusal, naming what the package said and what is accepted, `told`
# after it where a word is no flag (`shell_split.no_flag`, defect 183) or a
# value no value (`package_words.told`). The list in it is
# `cli/package_words`' five tables, word for word, and the test *the
# refusal's note names the list word for word* holds it to them (panel 198's
# R3: the note is the rule's only statement a reader meets).
function refused(package: str, said: str, told: str) -> [str]?
    return fail(
        code: "failed",
        msg: "heroes-ffi-package `" + package + "` answered with `" + shell_split.shown(said, keep_lines: false) + "`, which this compiler does not pass on" + told + "\n  only `-D`, `-U`, `-I`, `-L`, `-l`, `-F` and `-isystem`, each with its value joined or as the next word (`-isystem <dir>` handed on as `-I<dir>`), `-pthread`, `-framework <name>`, and `-Wl,-framework,<name>` and `-Wl,-rpath,<dir>`, in one word or split as `-Wl,-rpath -Wl,<dir>`, are accepted, as are `-Wl,--enable-new-dtags` and `-Wl,--export-dynamic`, which are not sent to the linker because this compiler's own link line says both already: everything else is refused, because a word the list does not name could be one that runs code during the build (Go's CVE-2018-6574)\n  name the library directly with `link` if you need it"
    )

function tail_after(word: str, prefix: str) -> str?
    ws = word.chars()
    ps = prefix.chars()

    if ps.len() > ws.len()
        return fail(code: "none", msg: "shorter than the prefix")
    index: i64 @ 0

    for p in ps
        if ws[index] != p
            return fail(code: "none", msg: "not this prefix")
        index @ index + 1

    return ok(ws.slice(from: ps.len(), to: ws.len()).join(""))

# Words as a key names them, each by its length, a colon and itself, so a
# word holding a space is never read as two: the shape `cli/link.hero`'s
# `binary_home` keys the link line with.
function key_text(words: [str]) -> str
    parts: [str] @ []

    for word in words
        parts @ parts.push(word.len().to_str() + ":" + word)

    return parts.join("|")

# Each package's own words, asked one package at a time as `resolve_packages`
# asks them, so a module's unit can be handed the words of the packages its
# own groups name and no other module's (panel 205's R3, defect 572); the
# first package that cannot answer stops the build as it would there.
function resolve_each(packages: [str], build_dir: str) -> {str: [str]}?
    out: {str: [str]} @ {}

    for package in packages
        out[package] @ resolve_packages(packages: [package], build_dir: build_dir)?

    return ok(out)

# The words of `packages`, in their order, from what `resolve_each` answered.
function words_of(each: {str: [str]}, packages: [str]) -> [str]
    out: [str] @ []

    for package in packages
        for word in each[package].default([])
            out @ out.push(word)

    return out

# Ask the machine about each package, and let nothing through that is
# not on the list. The failure is deliberately not silent and not a
# fallback: a package that cannot be resolved must stop the build,
# because the alternative is a link error naming C symbols. The
# message opens with the PACKAGE marker, which is emit_ffi_lookup's
# contract: the one class whose text this compiler writes itself.
function resolve_packages(packages: [str], build_dir: str) -> [str]?
    flags: [str] @ []

    for package in packages
        process.mkdir_all(build_dir)?
        answer_path = publish.private_name(build_dir + "/pkg-config-out.txt")
        err_path = publish.private_name(build_dir + "/pkg-config-err.txt")
        ran = process.run(
            program: "pkg-config",
            words: ["pkg-config", "--cflags", "--libs", "--", package],
            out: answer_path,
            err: err_path
        )

        # Read as text where they are text, and never taken for nothing where
        # they are not (defect 241, `cli/package_answer.hero`).
        answered = package_answer.answer(path: answer_path, package: package)
        complained = package_answer.complaint(err_path)
        publish.discard(answer_path)
        publish.discard(err_path)

        # A package name reaches `pkg-config` as one word whatever is in
        # it, and after `--`, so it is read as a name and never as an
        # option: until panel 188 `package "--atleast-pkgconfig-version=0"`
        # was answered with nothing at exit 0 and the group accepted.
        if !ran.started
            return fail(code: "no_pkg_config", msg: package_answer.unasked(package: package, why: ran.why))

        # Installed or not is asked of `pkg-config`, never assumed (defect 292).
        if ran.code != 0
            return fail(
                code: "failed",
                msg: package_answer.refused(package: package, complained: complained, build_dir: build_dir)
            )
        filtered = filter_words(package: package, said: answered?)

        if filtered.is_err()
            _ = filtered?

        for flag in filtered.must()
            flags @ flags.push(flag)

    return ok(flags)

## Tests

test "the allow-list: the safe words pass, the plugin is refused whole"
    good = filter_words(
        package: "sdl2",
        said: "-I/opt/include -D_THREAD_SAFE -L/opt/lib -lSDL2 -framework Cocoa -Wl,-framework,CoreAudio -Wl,-rpath,/opt/homebrew/lib\n"
    )
    assert !good.is_err()
    flags = good.must()

    # A Windows link takes no rpath (`package_words.rpath_words`).
    assert flags.len() == 8 + package_words.rpath_words("/opt/homebrew/lib").len()
    assert flags[0] == "-I/opt/include"
    assert flags[1] == "-D_THREAD_SAFE"
    assert flags[4] == "-framework"
    assert flags[5] == "Cocoa"
    assert flags[6] == "-framework"
    assert flags[7] == "CoreAudio"

    if process.exe_suffix() != ".exe"
        assert flags[8] == "-Wl,-rpath,/opt/homebrew/lib"

    # The vector itself: a plugin flag stops the build and names the
    # precedent.
    evil = filter_words(package: "trap", said: "-I/x -fplugin=attack.so")

    match evil
        .ok    => assert false
        .err e => assert has_text(text: e.msg, needle: "CVE-2018-6574")

    # A bare -Wl, is NOT a spelling of anything on the list.
    blanket = filter_words(package: "trap", said: "-Wl,-e,evil_entry")
    assert blanket.is_err()

    # -framework at the end with nothing after it is named, not read.
    hanging = filter_words(package: "trap", said: "-framework")
    assert hanging.is_err()

    # A bare -D with no name is not a flag, it is two characters.
    assert filter_words(package: "trap", said: "-D").is_err()

# What this Mac's pkg-config 3.0.7 printed, 2026-10-02, for one `.pc` whose
# `Cflags` and `Libs` wrote every accepted flag both ways (lane h158, defect
# 160): some come back joined and some as two words, and every one reaches
# clang joined.
test "every accepted flag in both its spellings, and a refused one refused in either"
    said = "-F/fw/a -I/inc/a -DNAME_A -U NAME_B -I/inc/b -F/fw/b -DNAME_C=1 -L/lib/a -lm -framework Cocoa -Wl,-rpath -Wl,/rp/a -Wl,-rpath,/rp/b -Wl,-framework -Wl,Metal\n"
    flags = filter_words(package: "spell", said: said).must()
    rpaths = strings.with_all(list: package_words.rpath_words("/rp/a"), more: package_words.rpath_words("/rp/b"))
    head = [
        "-F/fw/a"
        "-I/inc/a"
        "-DNAME_A"
        "-UNAME_B"
        "-I/inc/b"
        "-F/fw/b"
        "-DNAME_C=1"
        "-L/lib/a"
        "-lm"
        "-framework"
        "Cocoa"
    ]
    assert flags == strings.with_all(list: strings.with_all(list: head, more: rpaths), more: ["-framework", "Metal"])

    # The separate spelling of each, as a pkg-config that prints what the
    # file says, or a compiler's own command line, writes it.
    apart = filter_words(package: "spell", said: "-F /fw -I /inc -D X -U Y -L /lib -l z").must()
    assert apart == ["-F/fw", "-I/inc", "-DX", "-UY", "-L/lib", "-lz"]

    # A flag in the value's place is a flag: the plugin stays refused, and the
    # refusal names both words.
    slotted = filter_words(package: "trap", said: "-I -fplugin=attack.so")

    match slotted
        .ok => assert false
        .err e =>
            assert has_text(text: e.msg, needle: "answered with `-I -fplugin=attack.so`")
            assert has_text(text: e.msg, needle: "each with its value joined or as the next word")

    assert filter_words(package: "trap", said: "-framework -fplugin=attack.so").is_err()
    assert filter_words(package: "trap", said: "-Wl,-rpath -Wl,-e,evil").is_err()
    assert filter_words(package: "trap", said: "-Wl,-rpath").is_err()
    assert filter_words(package: "trap", said: "-Wl,-framework -L/lib").is_err()
    assert filter_words(package: "trap", said: "-F").is_err()

    # A word the list does not hold stays refused in either spelling.
    assert filter_words(package: "trap", said: "-iquote /sys/a").is_err()
    assert filter_words(package: "trap", said: "-iquote/sys/a").is_err()
    assert filter_words(package: "trap", said: "-Xlinker -rpath -Xlinker /rp/c").is_err()

# Panel 198: the answers three machines gave and the frozen list refused (Debian
# 13's `libcurl` and `glib-2.0`, `gmodule-2.0` beside them, and an SDL 3.2.10 built
# from its source with `SDL_RPATH` at its default, defect 444), each handed on as
# the words it reached clang as, and the words beside each admitted one refused.
test "a package's -pthread, -isystem and its own link line's words (panel 198)"
    curl = filter_words(
        package: "libcurl",
        said: "-I/usr/include/aarch64-linux-gnu -isystem /usr/include/mit-krb5 -I/usr/include/p11-kit-1 -lcurl\n"
    ).must()
    assert curl == ["-I/usr/include/aarch64-linux-gnu", "-I/usr/include/mit-krb5", "-I/usr/include/p11-kit-1", "-lcurl"]
    assert compile_flags(curl) == ["-I/usr/include/aarch64-linux-gnu", "-I/usr/include/mit-krb5", "-I/usr/include/p11-kit-1"]
    assert link_words(curl) == ["-lcurl"]

    # The directory joined, as clang reads it too.
    assert filter_words(package: "j", said: "-isystem/usr/include/mit-krb5 -lcurl").must() == ["-I/usr/include/mit-krb5", "-lcurl"]
    glib = filter_words(package: "glib-2.0", said: "-I/usr/include/glib-2.0 -pthread -lglib-2.0\n").must()
    assert glib == ["-I/usr/include/glib-2.0", "-pthread", "-lglib-2.0"]
    assert compile_flags(glib) == ["-I/usr/include/glib-2.0", "-pthread"]
    windows = process.exe_suffix() == ".exe"

    # Where clang calls `-pthread` at a link unused (Windows, measured), the link
    # does not take it, and every other leg does.
    if windows
        assert link_words(glib) == ["-lglib-2.0"]

    if !windows
        assert link_words(glib) == ["-pthread", "-lglib-2.0"]

    # The source-built SDL3's answer and gmodule's: the two words the compiler's
    # own link line already says are left out, and nothing else moves.
    sdl = filter_words(
        package: "sdl3",
        said: "-I/usr/local/include -L/usr/local/lib -Wl,-rpath,/usr/local/lib -Wl,--enable-new-dtags -lSDL3\n"
    ).must()

    if !windows
        assert sdl == ["-I/usr/local/include", "-L/usr/local/lib", "-Wl,-rpath,/usr/local/lib", "-lSDL3"]

    if windows
        assert sdl == ["-I/usr/local/include", "-L/usr/local/lib", "-lSDL3"]
    gmodule = filter_words(
        package: "gmodule-2.0",
        said: "-pthread -Wl,--export-dynamic -lgmodule-2.0 -pthread -lglib-2.0 -lglib-2.0\n"
    ).must()
    assert gmodule == ["-pthread", "-lgmodule-2.0", "-pthread", "-lglib-2.0", "-lglib-2.0"]

    # Still refused, each by its whole spelling: the word that moves a tag, the
    # comma that carries a second option past the list, the position-dependent
    # words (libpsx's whole answer, its first word named), a `-isystem` with no
    # directory or a flag in its place, the near spellings, a warning flag, the
    # other spelling of a linker option.
    assert filter_words(package: "t", said: "-Wl,--disable-new-dtags").is_err()
    assert filter_words(package: "t", said: "-Wl,--enable-new-dtags,--plugin,x.so").is_err()
    assert filter_words(package: "t", said: "-Wl,--export-dynamic,-e,evil").is_err()
    assert filter_words(package: "t", said: "-isystem").is_err()
    assert filter_words(package: "t", said: "-isystem -fplugin=attack.so").is_err()
    assert filter_words(package: "t", said: "-isystem-after /sys/a").is_err()
    assert filter_words(package: "t", said: "-pthreads").is_err()
    assert filter_words(package: "t", said: "-Wno-deprecated-declarations").is_err()
    assert filter_words(package: "t", said: "-Xlinker --enable-new-dtags").is_err()
    psx = filter_words(
        package: "libpsx",
        said: "-Wl,--no-as-needed -Wl,--whole-archive -lpsx -Wl,--no-whole-archive -Wl,--as-needed -lpthread\n"
    )

    match psx
        .ok => assert false
        .err e =>
            assert has_text(
                text: e.msg,
                needle: "answered with `-Wl,--no-as-needed`, which this compiler does not pass on"
            )
            assert has_text(
                text: e.msg,
                needle: "`-F` and `-isystem`, each with its value joined or as the next word (`-isystem <dir>` handed on as `-I<dir>`), `-pthread`"
            )
            assert has_text(text: e.msg, needle: "CVE-2018-6574")

    tunnel = filter_words(package: "t", said: "-Wl,--enable-new-dtags,--plugin,x.so")

    match tunnel
        .ok    => assert false
        .err e => assert has_text(text: e.msg, needle: "answered with `-Wl,--enable-new-dtags,--plugin,x.so`")

# PANEL 198's R3, the spec-warden's finding: the refusal's note is the list's only
# statement a reader meets, and nothing held it to the code. So both ways: every
# word the note names is accepted, its placeholder filled and a valued flag in
# both its spellings; and every word of `cli/package_words`' tables is named in
# it. A word added to a table and not to the note, or named in the note and not
# admitted, fires here.
test "the refusal's note names the list word for word, and the list admits every word it names (panel 198)"
    refusal = filter_words(package: "n", said: "-fplugin=x.so")
    note: str @ ""
    empty: [str] = []

    match refusal
        .ok => assert false
        .err e =>
            row: [str] @ []

            for ch in e.msg.chars()
                if ch != "\n"
                    row @ row.push(ch)
                    continue

                if strings.starts_with(text: row.join(""), prefix: "  only ")
                    note @ row.join("")
                row @ empty

    # The reason clause, true of every word refused (the spec-warden's finding:
    # it said *a flag a package file could use to run code*, false of
    # `--disable-new-dtags`), and the list before it.
    reason = "everything else is refused, because a word the list does not name could be one that runs code during the build (Go's CVE-2018-6574)"
    assert strings.starts_with(text: note, prefix: "  only `-D`")
    assert strings.ends_with(text: note, suffix: ": " + reason)
    listed = note.slice(from: 0, to: note.len() - reason.len())
    spans: [str] @ []
    open: bool @ false
    span: [str] @ []

    for ch in listed.chars()
        if ch == "`" && open
            spans @ spans.push(span.join(""))
            span @ empty
            open @ false
            continue

        if ch == "`"
            open @ true
            continue

        if open
            span @ span.push(ch)

    # Sixteen spans on the day (2026-10-09): a read finding another number is
    # not reading the note, or the note gained a word this test must be shown.
    assert !open
    assert spans.len() == 16

    for named in spans
        if package_words.valued(named)
            assert !filter_words(package: "n", said: named + " v").is_err()
            assert !filter_words(package: "n", said: named + "v").is_err()
            continue
        filled: str @ named

        if strings.ends_with(text: named, suffix: "<dir>")
            filled @ named.slice(from: 0, to: named.len() - 5) + "/d"

        if strings.ends_with(text: named, suffix: "<name>")
            filled @ named.slice(from: 0, to: named.len() - 6) + "N"
        assert !filter_words(package: "n", said: filled).is_err()

    for flag in package_words.VALUED
        assert has_text(text: listed, needle: "`" + flag + "`")

    for flag in package_words.SEPARATE
        assert has_text(text: listed, needle: "`" + flag + " <")

    for word in strings.with_all(list: package_words.PASSED, more: package_words.RESTATED)
        assert has_text(text: listed, needle: "`" + word + "`")

    for option in package_words.LINKED
        assert has_text(text: listed, needle: "`-Wl," + option + ",<")

# Route V (panel 198, its completeness critic's second pass; defect 527): a
# value is a name in every slot, joined or as the next word, never `@<file>`,
# which clang and the linkers read as more words, and `-l` never GNU ld's
# `:<file>` (defect 528's `libuv-static`); the refusal names the words it read
# and why.
test "a value beginning with @ is refused in every slot, and -l:<file> with it (panel 198, route V)"
    for answer in ["-framework @r", "-I @r", "-I@r", "-D @r", "-D@r", "-U @r", "-U@r", "-L @r", "-L@r", "-l @r", "-l@r", "-F @r", "-F@r", "-isystem @r", "-isystem@r", "-Wl,-rpath,@r", "-Wl,-rpath -Wl,@r", "-Wl,-framework,@r", "-Wl,-framework -Wl,@r"]
        match filter_words(package: "v", said: answer)
            .ok => assert false
            .err e =>
                assert has_text(
                    text: e.msg,
                    needle: "answered with `" + answer + "`, which this compiler does not pass on: a value beginning with `@` names a file"
                )

    for answer in ["-l:libuv.a", "-l :libuv.a"]
        match filter_words(package: "v", said: answer)
            .ok    => assert false
            .err e => assert has_text(
                text: e.msg,
                needle: "answered with `" + answer + "`, which this compiler does not pass on: `-l:<file>` names a file"
            )

    # A flag in a joined value's place is refused as it is in the next word's.
    assert filter_words(package: "v", said: "-I-fplugin=attack.so").is_err()
    assert filter_words(package: "v", said: "-isystem-after").is_err()

    # An `@` inside a path is a letter of the path, as in Homebrew's `openssl@4`.
    kept = filter_words(
        package: "openssl",
        said: "-I/opt/homebrew/Cellar/openssl@4/4.0.3/include -L/opt/homebrew/Cellar/openssl@4/4.0.3/lib -lssl\n"
    ).must()
    assert kept == ["-I/opt/homebrew/Cellar/openssl@4/4.0.3/include", "-L/opt/homebrew/Cellar/openssl@4/4.0.3/lib", "-lssl"]

# Over the same measured answer: a compile is handed every compile word and
# no link word, in the package's order (defect 161).
test "a compile takes a package's -I -D -U -F, and only those, in their order"
    said = "-F/fw/a -I/inc/a -DNAME_A -U NAME_B -I/inc/b -F/fw/b -DNAME_C=1 -L/lib/a -lm -framework Cocoa -Wl,-rpath -Wl,/rp/a -Wl,-rpath,/rp/b -Wl,-framework -Wl,Metal\n"
    flags = filter_words(package: "spell", said: said).must()
    assert compile_flags(flags) == ["-F/fw/a", "-I/inc/a", "-DNAME_A", "-UNAME_B", "-I/inc/b", "-F/fw/b", "-DNAME_C=1"]

    # The framework's name and the libraries stay off a compile.
    linked = filter_words(package: "sdl", said: "-framework Cocoa -lSDL3 -L/opt/lib -Wl,-framework,Metal").must()
    assert linked.len() == 6
    assert compile_flags(linked).len() == 0

# Over the same measured answer: a link is handed every link word and no
# compile word, in the package's order, and `-F` only where a framework is
# linked (defect 206); every word reaches a compile or a link.
test "a link takes a package's link words, and its -F only beside a framework (defect 206)"
    said = "-F/fw/a -I/inc/a -DNAME_A -U NAME_B -I/inc/b -F/fw/b -DNAME_C=1 -L/lib/a -lm -framework Cocoa -Wl,-rpath -Wl,/rp/a -Wl,-rpath,/rp/b -Wl,-framework -Wl,Metal\n"
    flags = filter_words(package: "spell", said: said).must()
    rpaths = strings.with_all(list: package_words.rpath_words("/rp/a"), more: package_words.rpath_words("/rp/b"))
    head = ["-F/fw/a", "-F/fw/b", "-L/lib/a", "-lm", "-framework", "Cocoa"]
    assert link_words(flags) == strings.with_all(list: strings.with_all(list: head, more: rpaths), more: ["-framework", "Metal"])
    both = strings.with_all(list: compile_flags(flags), more: link_words(flags))

    for word in flags
        found: bool @ false

        for one in both
            if one == word
                found @ true

        assert found

    # The defect's own `.pc`: a framework's headers, and nothing linked.
    headers_only = filter_words(package: "fakefw", said: "-F /fw/pc/../frameworks\n").must()
    assert compile_flags(headers_only) == ["-F/fw/pc/../frameworks"]
    assert link_words(headers_only).len() == 0

    # One package's `-F` finds the framework another package links.
    two = strings.with_all(list: headers_only, more: filter_words(package: "fw", said: "-framework Fake\n").must())
    assert link_words(two) == ["-F/fw/pc/../frameworks", "-framework", "Fake"]

# pkgconf 3.0.7's answers on this Mac, 2026-10-02 (lane h158, defect 162),
# read into the words the list judges: each one word whatever it holds.
test "a word pkg-config escaped is judged whole, and a key keeps it one"
    said = "-I/inc/with\\ space -DNAME=a\\ b -DVERSION=\\\"1.0\\\" -L/lib/with\\ space -lz\n"
    assert filter_words(package: "spaced", said: said).must() == ["-I/inc/with space", "-DNAME=a b", "-DVERSION=\"1.0\"", "-L/lib/with space", "-lz"]

    # A refused flag stays refused whatever escapes it, named whole, and a
    # quoted space never makes two flags of one word.
    escaped = filter_words(package: "trap", said: "\\-fplugin=a\\ b.so")

    match escaped
        .ok    => assert false
        .err e => assert has_text(text: e.msg, needle: "answered with `-fplugin=a b.so`")

    assert filter_words(package: "trap", said: "-I'/a -fplugin=attack.so'").must() == ["-I/a -fplugin=attack.so"]
    assert filter_words(package: "trap", said: "-I ''").is_err()

    # A word with a space is one word in a key.
    assert key_text(["-I/a b"]) != key_text(["-I/a", "b"])
    assert key_text(["-Ia"]) == "3:-Ia"
    none: [str] = []
    assert compile_flags(none).len() == 0

# Lane h158's `s7.pc` (2026-10-02, defect 183): the refusal of the path's
# tail names the line `pkg-config` printed and the word before it, and a
# refused flag keeps its words.
test "a word that is no flag is refused with the line it came from (defect 183)"
    split = filter_words(package: "s7", said: "-I/opt/with space/include -L/opt/with space/lib\n")

    match split
        .ok => assert false
        .err e =>
            assert has_text(
                text: e.msg,
                needle: "answered with `space/include`, which this compiler does not pass on: it is no flag, and `pkg-config` printed `-I/opt/with space/include -L/opt/with space/lib`, where whitespace nothing escapes stands between `-I/opt/with` and it"
            )
            assert has_text(text: e.msg, needle: "CVE-2018-6574")

    flag = filter_words(package: "trap", said: "-I/x -fplugin=attack.so")

    match flag
        .ok    => assert false
        .err e => assert !has_text(text: e.msg, needle: "no flag")

# A word holding a line end, as a quoted word in a `.pc` can (defect 237):
# the message holds it by its code, so its first line, the one the marker's
# reader reads, is whole.
test "a line end in pkg-config's answer is written by its code, and the message's first line stays one (defect 237)"
    split = filter_words(package: "q", said: "'x\ny' -lz")

    match split
        .ok => assert false
        .err e =>
            assert has_text(
                text: e.msg,
                needle: "answered with `x<U+000A>y`, which this compiler does not pass on: it is no flag, and `pkg-config` printed `'x<U+000A>y' -lz`\n"
            )
            assert !has_text(text: e.msg, needle: "x\ny")

# **The fold-in is asked of the machine, so the case asks the same question.**
# `-lm` is REQUIRED on POSIX and impossible on MSVC (`LNK1104: cannot open
# file 'm.lib'`, measured on the Windows leg 2026-08-31), and a program that
# says `link "m"` is correct on both — so this asserts the rule rather than a
# platform's answer, and asserts that a name nobody measured still passes
# through, which is the direction that cannot silently drop a library.
test "the C runtime's own libraries are folded in where the machine folds them"
    windows = process.exe_suffix() == ".exe"
    assert in_the_c_runtime(library: "m") == windows
    assert in_the_c_runtime(library: "c") == windows

    # Never folded anywhere: a real third-party library must always reach the
    # link line, and an unmeasured name is not on this list by design.
    assert !in_the_c_runtime(library: "sqlite3")
    assert !in_the_c_runtime(library: "curl")
    assert !in_the_c_runtime(library: "pthread")
    assert !in_the_c_runtime(library: "")

# Defect 292, asked of this machine's own `pkg-config`: a `.pc` written here,
# named by its path, which `pkg-config` reads as that file, its `Requires:`
# naming a package no machine has, is installed and refused; a path holding no
# `.pc` is not installed. Every `pkg-config` measured reads such a file by one
# of `package_answer.installed`'s two spellings (pkgconf 3.0.7 and 1.8.1 and
# pkg-config 0.29.2, 2026-10-04), so this fires where one no longer does.
test "a package pkg-config reads and refuses is told installed, and one it cannot find not installed (defect 292)"
    dir = "build/selftest-package-292"
    assert !process.mkdir_all(dir).is_err()
    pc = dir + "/r292.pc"
    assert !write_file(path: pc, text: "Name: r292\nDescription: requires a package no machine has\nVersion: 1\nRequires: heroes-package-no-machine-has-292\nCflags: -I/nowhere\nLibs:\n").is_err()
    tool = process.run(
        program: "pkg-config",
        words: ["pkg-config", "--version"],
        out: process.discard(),
        err: process.discard()
    )

    # Where none starts, as on the Windows box, the package is defect 249's,
    # told by the reason the machine gave (defect 323).
    if !tool.started
        match resolve_packages(packages: [pc], build_dir: dir)
            .ok => assert false
            .err e =>
                assert e.code == "no_pkg_config"
                assert e.msg == package_answer.unasked(package: pc, why: tool.why)

    if tool.started
        match resolve_packages(packages: [pc], build_dir: dir)
            .ok => assert false
            .err e =>
                assert strings.starts_with(
                    text: e.msg,
                    prefix: "heroes-ffi-package `" + pc + "` is installed, and pkg-config cannot give its flags\n  pkg-config said: "
                )
                assert has_text(text: e.msg, needle: "heroes-package-no-machine-has-292")
                assert strings.ends_with(
                    text: e.msg,
                    suffix: "\n  install what pkg-config says it lacks, or name the library directly with `link`"
                )

        match resolve_packages(packages: [dir + "/absent292.pc"], build_dir: dir)
            .ok => assert false
            .err e =>
                assert strings.starts_with(
                    text: e.msg,
                    prefix: "heroes-ffi-package `" + dir + "/absent292.pc` is not installed on this machine\n  pkg-config said: "
                )
                assert strings.ends_with(
                    text: e.msg,
                    suffix: "\n  install its development files, or name the library directly with `link`"
                )

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
