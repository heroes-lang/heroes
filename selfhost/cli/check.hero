# heroes check <file.hero> [flags] — names and types (design.md
# §4.16, §4.17; CLAUDE.md §8, §10). Port of
# archive/bootstrap-rs/heroes-cli/src/commands/check.rs.
#
# The stages are ordered, not interleaved: EACH RUNS ONLY IF THE ONE
# BEFORE IT SAID NOTHING. After a parse error the tree is recovery
# guesses; after a name error the checker would be typing expressions
# whose meaning is unknown. Five flags, each a different question
# about the same input — and a file with ??? in it is NOT wrong: it
# type-checks everything else, the holes go to stdout, exit 0.

use source
use source_extent
use diag
use diag_render
use parse
use modules
use resolve
use rename_fit
use checker
use not_text
use check/state
use check/holes
use print/scopes
use cli/table as cli_table
use cli/argv
use cli/io
use cli/check_json
use cli/certain
use cli/apply_answer
use library_source

function run(s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    parsed = parse.parse_source(s)

    # The control arm reads the parse as a language without the thesis rules
    # does: what a refusal of theirs held back is said there (defect 131).
    said: [diag.Diagnostic] @= parsed.diagnostics

    if argv.has(inv, spelling: "--permissive")
        said @ parsed.control
    stop = report(said, s, inv, stage: 1)

    if !stop.is_err()
        return stop.must()

    # The module graph before any name is resolved: a missing module
    # makes every qualified name into it an unknown name, and the
    # cause once beats the consequence nine times (§4.17).
    stop_g = report(modules.errors(s, parsed.uses), s, inv, stage: 2)

    if !stop_g.is_err()
        return stop_g.must()
    out = rename_fit.judged(resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses), s, parsed)
    stop_r = report(out.diagnostics, s, inv, stage: 3)

    if !stop_r.is_err()
        return stop_r.must()
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    stop_c = report(c.diagnostics, s, inv, stage: 4)

    if !stop_c.is_err()
        return stop_c.must()

    # `--apply`'s artifact is the program with every certain fix applied, and a
    # file no stage speaks of has none to apply: it is handed back as it is
    # (`cli/apply_answer.hero`, defects 141 and 371).
    if argv.has(inv, spelling: "--apply")
        return apply_answer.hand_back_clean(s, inv: inv)

    # A clean program's answer is a document too (panel 193's R3), where it
    # was no bytes at all, which no JSON reader takes.
    if argv.has(inv, spelling: "--json")
        none: [diag.Diagnostic] = []
        io.eprint_raw(text: check_json.json(none, s))

    if argv.has(inv, spelling: "--dump-scopes")
        io.print_artifact(text: scopes.dump_scopes(out, s, parsed.decls))

    # §4.16: holes are output, not diagnostics. The program is fine;
    # it is unfinished, and the compiler says what belongs in the gaps.
    if c.holes.len() > 0
        io.print_artifact(text: holes.report(parsed.tree, out, c, s, parsed.decls))
    return .ok_exit

# Print a stage's diagnostics in the form the flags asked for, and say
# whether to stop. Absent means "nothing to report, carry on". `stage` is
# `run`'s number for it, 1 to 4, which `--apply` asks again (`settle`).
function report(diagnostics: [diag.Diagnostic], s: source.Source, inv: argv.Invocation, stage: i64) -> cli_table.Exit?
    # A diagnostic pointing into the library is the COMPILER being
    # wrong, not the program: the line it names is in a file the
    # author cannot open, so the message is unactionable however good
    # it is (panel 028 R5).
    for d in diagnostics
        if source.is_library(s, d.span.start)
            io.eprint(
                text: "internal error: a diagnostic landed inside the Heroes library, at its line " + source.file_line_of(s, d.span.start).to_str() + ": [" + d.code + "] " + d.message
            )
            return ok(.failed_exit)

    kept = kept_of(diagnostics, inv)

    if kept.len() == 0
        return fail(code: "none", msg: "nothing to report, carry on")

    # A root that is not UTF-8 is never handed back, by stdout or in place: its
    # text is what the compiler can show, not what its author wrote (panel 189).
    if argv.has(inv, spelling: "--apply") && !not_text.in_root(s)
        # The repair is the artifact here, so the diagnostics stay
        # quiet: a caller that wants both runs the command twice. A round
        # that cannot read the program it judges writes nothing, and says
        # so in the words the first reading would have (defect 236).
        settled = settle(first: kept, s: s, inv: inv, stage: stage)

        match settled
            .err e =>
                io.eprint(text: "error: " + e.msg)
                return ok(.failed_exit)
            .ok _ => _ = 0

        return ok(apply_answer.hand_back(s, settled: settled.must(), inv: inv, told: kept.len()))

    if argv.has(inv, spelling: "--json")
        io.eprint_raw(text: check_json.json(kept, s))
    else
        if argv.has(inv, spelling: "--brief")
            for d in kept
                io.eprint(text: diag.render_line(d, s))
        else
            io.eprint_raw(text: rich(kept, s))
    return ok(.diagnostics_exit)

# §4.17's form for the filtered list, blank line between entries.
function rich(diagnostics: [diag.Diagnostic], s: source.Source) -> str
    rendered: [str] @= []

    for d in diagnostics
        rendered @ rendered.push(diag_render.render(d, s))

    return rendered.join("\n")

# Every certain fix of the stage that spoke, each written into the text it
# was made from (defect 137; `cli/certain.hero` has the measurement). Only
# certain: CLAUDE.md §8 rather than caution, since a guess is prose for the
# reader and a tool that applied one would write the program's meaning on
# the author's behalf.
#
# A ROUND writes the fixes that touch no other, and the stage is then asked
# again of the text the round left, until it has no certain fix to give.
# Two shapes need the second asking, measured on the same day: a fix
# withheld because it enclosed another is made again from the text the inner
# one left; and a chain, `one().must().must()`, is reported by the checker at
# its first link alone, so one round removed one `.must()` and left a certain
# fix for the next `--apply`, which is what the fixes suite holds no case to.
# A round that writes nothing, or leaves the text as it was, is the last;
# ROUNDS stops a fix that keeps making others, and a text seen before stops
# two that undo each other, both said out loud.
#
# Fixes outside the file being written are said out loud rather than
# dropped: a certain fix in a used module once indexed past the end of the
# root's text and panicked at exit 101, a code §10 does not have, and this
# flag's contract is EVERY certain fix.
#
# Each round reads the program again from disk, because a round can write a
# `use` line the first reading never followed (`use "geom"` to `use geom`),
# and a module a round cannot read fails the whole `--apply` (defect 236).
# So a later round can meet a module the first never read, and its certain
# fixes are said with the first round's, once each: until 2026-10-06 only
# the first round's were, and `geom.hero`'s `fn` behind `use "geom"` was
# neither written nor told (`surface-fixtures/applylater/`).
#
# What it settles on is the text, the rounds that wrote, those fixes in
# another module, and each later reading, which `--apply --json` answers
# (panel 193's R4 and R5).
function settle(first: [diag.Diagnostic], s: source.Source, inv: argv.Invocation, stage: i64) -> apply_answer.Settled?
    round = certain.applied(first, s)
    elsewhere: [str] @= round.elsewhere
    readings: [source.Source] @= []
    text: str @= round.text
    seen: [str] @= [source_extent.user_text(s)]
    malformed: i64 @= round.malformed
    wrote: i64 @= round.applied
    count: i64 @= 1

    while wrote > 0 && count < ROUNDS
        again = modules.load_text(path: s.name, root_text: text, library: library_source.text())?
        readings @ readings.push(again)
        next = certain.applied(said_at(again, inv, stage: stage), again)
        malformed @ malformed + next.malformed

        for at in next.elsewhere
            if !certain.listed(names: elsewhere, name: at)
                elsewhere @ elsewhere.push(at)

        if next.applied == 0 || next.text == text
            wrote @ 0
            break

        if certain.listed(names: seen, name: next.text)
            io.eprint(
                text: "internal error: two certain fixes for " + s.name + " undo each other; `--apply` stopped at the text before them"
            )
            wrote @ 0
            break
        seen @ seen.push(text)
        text @ next.text
        wrote @ next.applied
        count @ count + 1

    if elsewhere.len() > 0
        io.eprint(
            text: "note: " + elsewhere.len().to_str() + " certain fix(es) are in another module and were not applied: " + elsewhere.join(", ")
        )

    if wrote > 0
        io.eprint(
            text: "note: certain fixes for " + s.name + " were still being found after " + ROUNDS.to_str() + " rounds; `check --apply` again writes the rest"
        )

    if malformed > 0
        io.eprint(
            text: "internal error: " + malformed.to_str() + " certain fix(es) had a span that ends before it starts, and were not applied"
        )
    rounds: i64 @= count

    if round.applied == 0
        rounds @ 0
    return ok(apply_answer.Settled(text: text, rounds: rounds, elsewhere: elsewhere, readings: readings))

# How many times `settle` asks one stage: far past any chain an author writes,
# and short of a certain fix that reproduces itself, as `needs_qualifying`'s
# did once (`window.destroy()` to `window.window.destroy()`, panel 102).
constant ROUNDS: i64
    64

# What `report` acts on for `s` at `stage`, `run`'s number for it: that
# stage's diagnostics with `--permissive`'s filter, or none where that stage
# says nothing or one before it speaks, since `run` would stop there. The
# stages and their order are `run`'s, and the round cases below hold them.
function said_at(s: source.Source, inv: argv.Invocation, stage: i64) -> [diag.Diagnostic]
    parsed = parse.parse_source(s)
    said: [diag.Diagnostic] @= parsed.diagnostics

    if argv.has(inv, spelling: "--permissive")
        said @ parsed.control
    syntax = kept_of(said, inv)

    if syntax.len() > 0 || stage == 1
        return at_stage(said: syntax, found: 1, stage: stage)
    graph = kept_of(modules.errors(s, parsed.uses), inv)

    if graph.len() > 0 || stage == 2
        return at_stage(said: graph, found: 2, stage: stage)
    out = rename_fit.judged(resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses), s, parsed)
    names = kept_of(out.diagnostics, inv)

    if names.len() > 0 || stage == 3
        return at_stage(said: names, found: 3, stage: stage)
    types = kept_of(checker.check(parsed.tree, out, s, parsed.decls).diagnostics, inv)
    return at_stage(said: types, found: 4, stage: stage)

function at_stage(said: [diag.Diagnostic], found: i64, stage: i64) -> [diag.Diagnostic]
    if found == stage
        return said
    none: [diag.Diagnostic] = []
    return none

# A stage's diagnostics as `--permissive` keeps them: without the ones that
# exist for the thesis, the control arm of Part 11's measurement.
function kept_of(diagnostics: [diag.Diagnostic], inv: argv.Invocation) -> [diag.Diagnostic]
    kept: [diag.Diagnostic] @= []

    for d in diagnostics
        if argv.has(inv, spelling: "--permissive") && diag.is_thesis_rule(d)
            continue
        kept @ kept.push(d)

    return kept

## Tests

test "stages stop on the first noise, apply repairs, holes stay exit 0"
    # A clean file with a hole: exit 0, the report is stdout's.
    holey = "function main()\n    n: i64 @= ???\n    print(n)\n"
    hs = source.new_source(name: "t.hero", text: holey)
    quiet = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: [])
    assert run(hs, quiet) == .ok_exit

    # A thesis rule vanishes under --permissive and stays without it.
    unused = "function main()\n    n = 3\n    print(1)\n"
    us = source.new_source(name: "t.hero", text: unused)
    brief: [argv.FlagHit] = [argv.FlagHit(spelling: "--brief", value: fail(code: "none", msg: "no value"))]
    binv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: brief)
    assert run(us, binv) == .diagnostics_exit
    perm: [argv.FlagHit] = [argv.FlagHit(spelling: "--permissive", value: fail(code: "none", msg: "no value"))]
    pinv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: perm)
    assert run(us, pinv) == .ok_exit

    # apply: the reserved-word fix is certain where the word it writes is
    # right, and the repaired text is the artifact.
    fixable = "fn main()\n    print(1)\n"
    fs = source.new_source(name: "t.hero", text: fixable)
    parsed = parse.parse(fs.text)
    repaired = certain.applied(parsed.diagnostics, fs).text
    assert has_text(text: repaired, needle: "function main()")

    # And nowhere else (defect 133's second round): `fn = 3` in a body was
    # repaired to `function = 3`, a program the parser refuses, and this test
    # asserted it until 2026-09-29. A name's place takes no swap.
    named = "function main()\n    fn = 3\n    print(fn)\n"
    ns = source.new_source(name: "t.hero", text: named)
    assert certain.applied(parse.parse(ns.text).diagnostics, ns).text == named

# DEFECT 137's reproducers, the certain-fix audit's (2026-09-30), through the
# rounds: fixes whose spans enclose others, each written into the text it was
# made for. Before the rounds the first aborted `check --apply` at exit 134,
# `string slice out of range`; the second wrote `print(total(xs.must())rint(0)`;
# the third and fourth lost the inner fix under the enclosing one and landed
# shifted, `print(bump(k)))` and `print(copy_text("a", "b")lt("none"))`; the
# fifth left `4)` behind the enclosing parentheses; the sixth undid both inner
# swaps. And the chain the checker reports at its first link only, which one
# round cut by one `.must()` and left a certain fix behind for the next.
# `stage` is the stage that speaks, 4 the checker's and 1 the parser's.
test "a certain fix enclosing another is made again from the text the inner one left"
    head = "function total(n: i64) -> i64\n    return n + 1\n\nfunction main()\n    xs = 4\n"
    assert settled_text(text: head + "    print(total(xs.must()).must())\n", stage: 4) == head + "    print(total(xs))\n"
    assert settled_text(text: head + "    print(total(xs.must()).must())\n    print(0)\n", stage: 4) == head + "    print(total(xs))\n    print(0)\n"
    counter = "record Counter\n    n: i64\n\nfunction bump(@c: Counter) -> i64\n    c.n @ c.n + 1\n    return c.n\n\nfunction main()\n    k: Counter @= Counter(n: 0)\n"
    assert settled_text(text: counter + "    print(bump(k).must())\n", stage: 4) == counter + "    print(bump(@k))\n"

    # `to:` is written because between two `str` parameters a label is certain
    # only for the argument left alone once the other is named (defect 135).
    labels = "function copy_text(from: str, to: str) -> str\n    return from + \" -> \" + to\n\nfunction main()\n"
    assert settled_text(text: labels + "    print(copy_text(\"a\", to: \"b\").default(\"none\"))\n", stage: 4) == labels + "    print(copy_text(from: \"a\", to: \"b\"))\n"
    body = "\n    return n\n\nfunction main()\n    print(1)\n"
    assert settled_text(text: "function adder(n: i64) -> function(i64) -> function(i64) -> i64" + body, stage: 1) == "function adder(n: i64) -> (function(i64) -> (function(i64) -> i64))" + body
    assert settled_text(text: "function apply(f: function(int) -> int, x: i64) -> i64\n    return f(x)\n", stage: 1) == "function apply(f: (function(i64) -> i64), x: i64) -> i64\n    return f(x)\n"
    one = "function one() -> i64\n    return 1\n\nfunction main()\n"
    assert settled_text(text: one + "    print(one().must().must().must())\n", stage: 4) == one + "    print(one())\n"
    assert settled_text(text: one + "    x = one().must().default(2)\n    print(x)\n", stage: 4) == one + "    x = one()\n    print(x)\n"

# The text `check --apply` writes for `text`, asked of `stage` as `run` asks
# it, the library joined as the verb joins it.
function settled_text(text: str, stage: i64) -> str
    return settled_of(text: text, stage: stage).text

function settled_of(text: str, stage: i64) -> apply_answer.Settled
    s = modules.load_text(path: "build/selftest-certain.hero", root_text: text, library: library_source.text()).must()
    hits: [argv.FlagHit] = [argv.FlagHit(spelling: "--apply", value: fail(code: "none", msg: "no value"))]
    inv = argv.Invocation(tag: .check_cmd, file: ok("build/selftest-certain.hero"), program_args: [], flags: hits)
    return settle(first: said_at(s, inv, stage: stage), s: s, inv: inv, stage: stage).must()

# Panel 193's R4: `rounds` counts the rounds that wrote, so a chain the
# checker reports one link at a time takes a round a link, and a program
# with no certain fix to write takes none.
test "the applied answer counts the rounds that wrote"
    one = "function one() -> i64\n    return 1\n\nfunction main()\n"
    assert settled_of(text: one + "    print(one().must().must().must())\n", stage: 4).rounds == 3
    assert settled_of(text: one + "    print(one())\n", stage: 4).rounds == 0

# Defects 130 and 131: the control arm is never left with nothing to say about
# a program the parser could not read. It drops the thesis rules, so it reads
# what a thesis refusal held back, the joined head's missing body, and what a
# recovery keyed on a thesis rule used to drop, the line after the arm.
test "the control arm still refuses what a thesis rule stood in front of"
    perm: [argv.FlagHit] = [argv.FlagHit(spelling: "--permissive", value: fail(code: "none", msg: "no value"))]
    pinv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: perm)
    joined = source.new_source(name: "t.hero", text: "function main()\n    n = 1\n    if n >\n        print(1)\n")
    assert run(joined, pinv) == .diagnostics_exit
    after_the_arm = "function main()\n    match 1\n        0 => x = 5\n        _ => print(2)\n    z = 4 )\n"
    assert run(source.new_source(name: "t.hero", text: after_the_arm), pinv) == .diagnostics_exit

test "the json schema leads with its version and escapes its strings"
    text = "function main()\n    n = 3\n    print(1)\n"
    s = source.new_source(name: "t.hero", text: text)
    parsed = parse.parse_source(s)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    got = check_json.json(out.diagnostics, s)
    assert has_text(text: got, needle: "{\n  \"schema\": 2,\n  \"kind\": \"diagnostics\",\n  \"read\": [\n")
    assert has_text(text: got, needle: "\"code\": \"unused_binding\"")
    assert has_text(text: got, needle: "\"file\": \"t.hero\"")
    assert has_text(text: got, needle: "  ]\n}\n")

# Panel 193's R8: the help says the schema the writer writes and the stream
# it writes to, held to `check_json.SCHEMA` so the two cannot part: stderr
# for the diagnostics, stdout for the program `--apply` prints (R4).
test "the help names the answer's schema and its stream"
    said: str @= ""

    for c in cli_table.commands()
        if c.name == "check"
            for f in c.flags
                if f.spelling == "--json"
                    said @ f.what

    assert has_text(text: said, needle: "schema " + check_json.SCHEMA.to_str())
    assert has_text(text: said, needle: "stderr")
    assert has_text(
        text: said,
        needle: "with --apply, print the program inside a JSON document of the same schema, on stdout"
    )

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
