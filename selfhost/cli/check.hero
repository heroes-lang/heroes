# heroes check <file.hero> [flags] — names and types (design.md
# §4.16, §4.17; CLAUDE.md §8, §10). Port of
# archive/bootstrap-rs/heroes-cli/src/commands/check.rs.
#
# The stages are ordered, not interleaved: EACH RUNS ONLY IF THE ONE
# BEFORE IT SAID NOTHING. After a parse error the tree is recovery
# guesses; after a name error the checker would be typing expressions
# whose meaning is unknown. Five flags, each a different question
# about the same input — and a file with ??? in it is NOT wrong: it
# type-checks everything else, the holes go to stdout, exit 0.

use source
use source_extent
use diag
use diag_render
use parse
use modules
use resolve
use checker
use check/state
use check/holes
use print/scopes
use cli/table as cli_table
use cli/argv
use cli/io
use cli/json_text
use cli/publish
use stable

function run(s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    parsed = parse.parse_source(s)

    # The control arm reads the parse as a language without the thesis rules
    # does: what a refusal of theirs held back is said there (defect 131).
    said: [diag.Diagnostic] @ parsed.diagnostics

    if argv.has(inv, spelling: "--permissive")
        said @ parsed.control
    stop = report(said, s, inv)

    if !stop.is_err()
        return stop.must()

    # The module graph before any name is resolved: a missing module
    # makes every qualified name into it an unknown name, and the
    # cause once beats the consequence nine times (§4.17).
    stop_g = report(modules.errors(s, parsed.uses), s, inv)

    if !stop_g.is_err()
        return stop_g.must()
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    stop_r = report(out.diagnostics, s, inv)

    if !stop_r.is_err()
        return stop_r.must()
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    stop_c = report(c.diagnostics, s, inv)

    if !stop_c.is_err()
        return stop_c.must()

    if argv.has(inv, spelling: "--dump-scopes")
        io.print_artifact(text: scopes.dump_scopes(out, s, parsed.decls))

    # §4.16: holes are output, not diagnostics. The program is fine;
    # it is unfinished, and the compiler says what belongs in the gaps.
    if c.holes.len() > 0
        io.print_artifact(text: holes.report(parsed.tree, out, c, s, parsed.decls))
    return .ok_exit

# Print a stage's diagnostics in the form the flags asked for, and say
# whether to stop. Absent means "nothing to report, carry on".
function report(diagnostics: [diag.Diagnostic], s: source.Source, inv: argv.Invocation) -> cli_table.Exit?
    # A diagnostic pointing into the library is the COMPILER being
    # wrong, not the program: the line it names is in a file the
    # author cannot open, so the message is unactionable however good
    # it is (panel 028 R5).
    for d in diagnostics
        if source.is_library(s, d.span.start)
            io.eprint(
                text: "internal error: a diagnostic landed inside the Heroes library, at its line " + source.file_line_of(s, d.span.start).to_str() + ": [" + d.code + "] " + d.message
            )
            return ok(.failed_exit)

    kept: [diag.Diagnostic] @ []

    for d in diagnostics
        if argv.has(inv, spelling: "--permissive") && diag.is_thesis_rule(d)
            continue
        kept @ kept.push(d)

    if kept.len() == 0
        return fail(code: "none", msg: "nothing to report, carry on")

    if argv.has(inv, spelling: "--apply")
        # The repair is the artifact here, so the diagnostics stay
        # quiet: a caller that wants both runs the command twice.
        repaired = apply(kept, s)

        if argv.has(inv, spelling: "--in-place")
            # The write goes through s.name because that is the file
            # the text came from — apply returns user_text with the
            # edits, deliberately excluding the library §1.11 appends.
            # THE REPORT IS THE DIFFERENCE, not the diagnostic count
            # (panel 071): a file can have diagnostics and no
            # applicable repair, and "applied 1 fix" over an untouched
            # file is the surface lying about itself.
            changed = repaired != source_extent.user_text(s)

            # Whole or not at all, as `fmt --in-place` writes (defect 136):
            # `write_file` here emptied the file first, and a full disk left
            # it cut mid-token.
            if changed
                written = publish.rewrite(path: s.name, text: repaired)

                if written.is_err()
                    io.eprint(text: "error: " + publish.message_of(written))
                    return ok(.failed_exit)
                io.eprint(text: "rewrote " + s.name)
            else
                io.eprint(
                    text: s.name + " unchanged: no `certain` fix applies to its " + kept.len().to_str() + " diagnostic(s)"
                )
            return ok(.ok_exit)
        io.print_artifact(text: repaired)
        return ok(.ok_exit)

    if argv.has(inv, spelling: "--json")
        io.eprint_raw(text: json(kept, s))
    else
        if argv.has(inv, spelling: "--brief")
            for d in kept
                io.eprint(text: diag.render_line(d, s))
        else
            io.eprint_raw(text: rich(kept, s))
    return ok(.diagnostics_exit)

# §4.17's form for the filtered list, blank line between entries.
function rich(diagnostics: [diag.Diagnostic], s: source.Source) -> str
    rendered: [str] @ []

    for d in diagnostics
        rendered @ rendered.push(diag_render.render(d, s))

    return rendered.join("\n")

# Schema 1. Versioned because a schema is a promise: a consumer that
# reads `schema` can refuse a version it does not know, which is the
# whole reason the field is first.
function json(diagnostics: [diag.Diagnostic], s: source.Source) -> str
    rows: [str] @ ["{\n  \"schema\": 1,\n  \"diagnostics\": [\n"]
    index: i64 @ 0

    for d in diagnostics
        found = source.locate(s, d.span.start)
        rows @ rows.push("    {\n")
        rows @ rows.push("      \"code\": \"" + d.code + "\",\n")
        rows @ rows.push("      \"message\": " + quote(d.message) + ",\n")
        rows @ rows.push("      \"file\": " + quote(found.file) + ",\n")
        rows @ rows.push("      \"line\": " + found.line.to_str() + ",\n      \"col\": " + found.col.to_str() + ",\n")
        notes: [str] @ []

        for note in d.notes
            notes @ notes.push(quote(note))

        rows @ rows.push("      \"notes\": [" + notes.join(", ") + "],\n")
        fixes: [str] @ []

        for fix in d.fixes
            tag: str @ "guess"

            if fix.certainty == .certain
                tag @ "certain"
            fixes @ fixes.push(
                "{\"title\": " + quote(fix.title) + ", \"replacement\": " + quote(fix.replacement) + ", \"certainty\": \"" + tag + "\"}"
            )

        rows @ rows.push("      \"fixes\": [" + fixes.join(", ") + "]\n")

        if index == diagnostics.len() - 1
            rows @ rows.push("    }\n")
        else
            rows @ rows.push("    },\n")
        index @ index + 1

    rows @ rows.push("  ]\n}\n")
    return rows.join("")

# A JSON string, quoted, through the one escape every JSON writer here shares
# (defect 102: this one escaped three characters of the thirty-four JSON
# forbids raw, and a stray control byte in a message made schema 1 unreadable).
function quote(text: str) -> str
    return "\"" + json_text.json_string(text) + "\""

# Applies every certain fix, back to front so the earlier spans stay
# valid. Only certain — CLAUDE.md §8 rather than caution: a guess is
# prose for the reader, and a tool that applied one would be writing
# the program's meaning on the author's behalf. Fixes outside the file
# being written are skipped AND SAID OUT LOUD: a certain fix in a used
# module once indexed past the end of the root's text and panicked at
# exit 101, a code §10 does not have; dropping them silently would be
# worse, because this flag's contract is EVERY certain fix.
function apply(diagnostics: [diag.Diagnostic], s: source.Source) -> str
    edits: [diag.Fix] @ []
    elsewhere: [str] @ []
    limit = source_extent.root_end(s)

    for d in diagnostics
        for fix in d.fixes
            if fix.certainty != .certain
                continue

            if fix.span.end > limit
                found = source.locate(s, fix.span.start)
                at = found.file + ":" + found.line.to_str()
                already: bool @ false

                for one in elsewhere
                    if one == at
                        already @ true

                if !already
                    elsewhere @ elsewhere.push(at)
                continue
            edits @ edits.push(fix)

    if elsewhere.len() > 0
        io.eprint(
            text: "note: " + elsewhere.len().to_str() + " certain fix(es) are in another module and were not applied: " + elsewhere.join(", ")
        )

    # Ascending by start, a tie in the order found (`stable.order`; defect
    # 105: the insertion this was copied the list at every fix), then
    # applied back to front.
    starts: [i64] @ []

    for fix in edits
        starts @ starts.push(fix.span.start)

    ordered: [diag.Fix] @ []

    for at in stable.order(by: starts)
        taken = edits[at]
        ordered @ ordered.push(taken)

    # Fixes apart, each ending where or before the next begins, give the
    # same text back to front as front to back, and front to back copies
    # the file once: the piece before each fix, then the fix, joined. Back
    # to front copied the whole file at every fix. Fixes that overlap are
    # applied back to front as ever, each on the text the later ones left.
    apart: bool @ true
    next: i64 @ 0

    while next < ordered.len()
        if ordered[next].span.end < ordered[next].span.start
            apart @ false

        if next > 0 && ordered[next - 1].span.end > ordered[next].span.start
            apart @ false
        next @ next + 1

    if apart
        pieces: [str] @ []
        cut: i64 @ 0
        whole = source_extent.user_text(s)

        for fix in ordered
            stretch = whole.slice(from: cut, to: fix.span.start)
            pieces @ pieces.push(stretch)
            pieces @ pieces.push(fix.replacement)
            cut @ fix.span.end

        rest = whole.slice(from: cut, to: whole.len())
        pieces @ pieces.push(rest)
        return pieces.join("")
    text: str @ source_extent.user_text(s)
    index: i64 @ ordered.len() - 1

    while index >= 0
        fix = ordered[index]
        text @ text.slice(from: 0, to: fix.span.start) + fix.replacement + text.slice(from: fix.span.end, to: text.len())
        index @ index - 1

    return text

## Tests

# Schema 1 goes through the one escape (defect 102): the tab and the carriage
# return this writer used to pass raw.
test "a JSON string here escapes what JSON forbids raw"
    assert quote("a\tb\rc\n\"d\\e") == "\"a\\tb\\rc\\n\\\"d\\\\e\""

test "stages stop on the first noise, apply repairs, holes stay exit 0"
    # A clean file with a hole: exit 0, the report is stdout's.
    holey = "function main()\n    n: i64 @ ???\n    print(n)\n"
    hs = source.new_source(name: "t.hero", text: holey)
    quiet = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: [])
    assert run(hs, quiet) == .ok_exit

    # A thesis rule vanishes under --permissive and stays without it.
    unused = "function main()\n    n = 3\n    print(1)\n"
    us = source.new_source(name: "t.hero", text: unused)
    brief: [argv.FlagHit] = [argv.FlagHit(spelling: "--brief", value: fail(code: "none", msg: "no value"))]
    binv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: brief)
    assert run(us, binv) == .diagnostics_exit
    perm: [argv.FlagHit] = [argv.FlagHit(spelling: "--permissive", value: fail(code: "none", msg: "no value"))]
    pinv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: perm)
    assert run(us, pinv) == .ok_exit

    # apply: the reserved-word fix is certain where the word it writes is
    # right, and the repaired text is the artifact.
    fixable = "fn main()\n    print(1)\n"
    fs = source.new_source(name: "t.hero", text: fixable)
    parsed = parse.parse(fs.text)
    repaired = apply(parsed.diagnostics, fs)
    assert has_text(text: repaired, needle: "function main()")

    # And nowhere else (defect 133's second round): `fn = 3` in a body was
    # repaired to `function = 3`, a program the parser refuses, and this test
    # asserted it until 2026-09-29. A name's place takes no swap.
    named = "function main()\n    fn = 3\n    print(fn)\n"
    ns = source.new_source(name: "t.hero", text: named)
    assert apply(parse.parse(ns.text).diagnostics, ns) == named

# Defects 130 and 131: the control arm is never left with nothing to say about
# a program the parser could not read. It drops the thesis rules, so it reads
# what a thesis refusal held back, the joined head's missing body, and what a
# recovery keyed on a thesis rule used to drop, the line after the arm.
test "the control arm still refuses what a thesis rule stood in front of"
    perm: [argv.FlagHit] = [argv.FlagHit(spelling: "--permissive", value: fail(code: "none", msg: "no value"))]
    pinv = argv.Invocation(tag: .check_cmd, file: ok("t.hero"), program_args: [], flags: perm)
    joined = source.new_source(name: "t.hero", text: "function main()\n    n = 1\n    if n >\n        print(1)\n")
    assert run(joined, pinv) == .diagnostics_exit
    after_the_arm = "function main()\n    match 1\n        0 => x = 5\n        _ => print(2)\n    z = 4 )\n"
    assert run(source.new_source(name: "t.hero", text: after_the_arm), pinv) == .diagnostics_exit

test "the json schema leads with its version and escapes its strings"
    text = "function main()\n    n = 3\n    print(1)\n"
    s = source.new_source(name: "t.hero", text: text)
    parsed = parse.parse_source(s)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    got = json(out.diagnostics, s)
    assert has_text(text: got, needle: "{\n  \"schema\": 1,\n  \"diagnostics\": [\n")
    assert has_text(text: got, needle: "\"code\": \"unused_binding\"")
    assert has_text(text: got, needle: "\"file\": \"t.hero\"")
    assert has_text(text: got, needle: "  ]\n}\n")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
