# A name the text of a group's header puts in the program's own object, and
# nothing on the link line defines, told as the author's (design.md §4.19,
# §4.17; CLAUDE.md §7's named exception; defect 2372, 2026-11-09): a group
# binding `top_fast` from a header whose `static inline int top_fast(void) {
# return base_helper() + 1; }` calls a `base_helper` no linked library
# defines, or whose `#define top_fast base_helper` makes the call the
# compiler writes one to `base_helper`. Until then it was *internal error:
# linking failed* at exit 2 on every platform: the reference stands in the
# program's own object, where defect 2365's reader
# (`cli/library_needs.hero`) rightly leaves a name the compiler's.
#
# **The linker's words cannot say whose the reference is**: the function
# they name as referring is the header's `top_fast` at `-O0`, the compiler's
# own `h_<module>_main` beside it once `-O2` inlines it, and the compiler's
# `hero_extern_refs` for a macro (measured 2026-11-09, ld64-27106.1 and GNU
# ld 2.44). So clang is asked, as panel 214's R3 asks it, and a name the link
# reports is this reader's only where (`cli/link_needs.hero` tells the link
# where every name is this reader's or `cli/library_needs.hero`'s, defect
# 2381):
#
# - every reference is placed in the object of one of the program's modules,
#   `<module>-<digest>.o` (`cli/units.hero`), or in a library the program
#   names, one at least in a module's object (`cli/needs_placed.hero`), and
#   each module whose object holds one answers the questions below through
#   its own header list and its own groups, told at its own binding, as
#   defect 2208 tells a refused header at each module's group: two modules
#   reading `stopflag.h` through different header lists each held a
#   reference to `stop_requested`, and while one list had to answer for
#   every object neither did, *internal error: linking failed* at exit 2
#   (defect 2495, 2026-11-13);
# - no group binds the name and it has none of the forms the C this
#   compiler writes keeps to itself (`own_names.reserved`): that C names
#   those, the bound names and what its own opening declares, nothing else;
# - the unit's opening read alone, `emit/externs.hero`'s `SEEDS` and
#   `heroes_standard.h`, declares no such name, so no line the compiler
#   writes can name it, `<math.h>`'s functions among them;
# - the header list's own text names it: a body it defines calls or reads
#   it (`cli/header_bodies.hero`), or a bound name's object-like macros end
#   at it (`reach_ask.walk`).
#
# Anything else stays the compiler's, exit 2. It is told `ffi_missing_link`,
# panel 048's class for a symbol the linker cannot find because no group
# says which library has it, in `cli/needs_told.hero`'s words: at the
# binding whose header's text reaches the name, else at the group naming
# the file whose body names it. **No fix is offered**: the compiler does not
# know which library defines the name.

use ast
use cli/bound_names
use cli/bound_said
use cli/compiling
use cli/defined_twice
use cli/dump_tops
use cli/group_file
use cli/header_bodies
use cli/link_report
use cli/needs_placed
use cli/needs_told
use cli/own_names
use cli/probing
use cli/reach_ask
use cli/strings
use cli/toolchain
use diag
use emit/externs as emit_externs
use emit/ffi_lookup
use parse
use source

# The header the unit reads after its groups (`emit/macro_guard.hero`'s
# `STANDARD_LINE`), the end of the opening the compiler writes.
constant STANDARD: str
    "heroes_standard.h"

# What one header list was asked: the bodies it defines, every name its
# unit's opening declares read alone, the names its own modules' groups
# bind, its macro table, whether the dumps were answered, and the modules
# that read it, their C components (none: every module, for a list asked
# by hand). A list answers with its own modules' bindings and groups, never
# another module's that binds the same name (defect 2495, as defect 2208
# for a refused header).
record Asked
    bodies: [header_bodies.Body]
    opening: {str: bool}
    bindings: [str]
    defines: {str: bound_said.Define}
    answered: bool
    modules: [str]

# The diagnostics for `names`, undefined names `refs` reports (the link's
# references, `link_report.references`), one per binding or group whose
# header's text names them; absent unless every one of `names` is such a
# name, so `cli/link_needs.hero` leaves the link the compiler's (defect
# 2381). `libraries` are the libraries the program's words link
# (`library_needs.names_of`), which may refer to a name beside its object.
function told_of(refs: [link_report.Reference], names: [str], s: source.Source, decls: [ast.Decl], t: toolchain.Toolchain, asking: [probing.Probing], libraries: [str]) -> [diag.Diagnostic]?
    for name in names
        if name == "" || !ffi_lookup.declaration(s, decls, name: name).is_err() || own_names.reserved(name)
            return fail(code: "none", msg: "a name the compiler's own C may name")

    asked: [Asked] @= []

    for one in asking
        if needs_placed.holds_any(refs, modules: one.modules)
            asked @ asked.push(ask(t, one: one, s: s, decls: decls))
        else
            asked @ asked.push(
                Asked(bodies: [], opening: {}, bindings: [], defines: {}, answered: false, modules: one.modules)
            )

    findings: [needs_told.Finding] @= []
    lists: [[str]] @= []

    for one in asking
        lists @ lists.push(one.modules)

    for name in names
        holders = needs_placed.holding(refs, symbol: name, lists: lists, libraries: libraries)

        if holders.is_err()
            return fail(code: "none", msg: "a reference to `" + name + "` no header list holds")

        # Each module whose object holds a reference is told at its own
        # binding, its list answering with that module's groups alone, or
        # the name stays the compiler's: an object whose reference no header
        # text explains is no mistake of the author's this can name.
        for module in holders.must()
            i = needs_placed.list_of(lists, module: module)

            if i < 0 || !asked[i].answered
                return fail(code: "none", msg: "a header list holding `" + name + "` was not answered")
            own: Asked @= asked[i]
            own.modules @ [module]
            found = explained(
                own,
                name: name,
                s: s,
                decls: decls,
                headers: bound_names.groups_of(asking[i].headers)
            )

            if found.is_err()
                return fail(code: "none", msg: "no header explains `" + name + "`")
            findings @ merged(findings, one: found.must())

    out: [diag.Diagnostic] @= []

    for one in findings
        out @ out.push(needs_told.diagnostic(one, linking: needs_told.group_links(s, decls: decls, at: one)))

    return ok(out)

# What `one`'s header list answers: clang's dump of the list and of the
# unit's opening alone (`defined_twice.dump_of`), and its macro table.
function ask(t: toolchain.Toolchain, one: probing.Probing, s: source.Source, decls: [ast.Decl]) -> Asked
    unanswered = Asked(bodies: [], opening: {}, bindings: [], defines: {}, answered: false, modules: one.modules)

    if one.probe.is_err() || one.probe.must().read.is_err()
        return unanswered
    probe = one.probe.must()
    dumped = defined_twice.dump_of(t, probe)
    alone = compiling.Probe(
        words: probe.words,
        headers: strings.with_all(list: emit_externs.SEEDS, more: [STANDARD]),
        read: probe.read,
        digests: probe.digests
    )
    opened = defined_twice.dump_of(t, alone)

    if dumped.is_err() || opened.is_err()
        return unanswered
    opening: {str: bool} @= {}

    for top in dump_tops.tops_of(opened.must())
        if top.name.len() > 0
            opening[top.name] @ true

    table = reach_ask.table_of(t, one: one, s: s, decls: decls)
    defines: {str: bound_said.Define} @= {}

    if !table.is_err()
        defines @ table.must().defines
    bindings: [str] @= []

    for name in reach_ask.names_of(s, decls, headers: bound_names.groups_of(one.headers))
        if !own_declaration(s, decls, name: name, modules: one.modules).is_err()
            bindings @ bindings.push(name)

    return Asked(
        bodies: header_bodies.of_dump(dumped.must()),
        opening: opening,
        bindings: bindings,
        defines: defines,
        answered: true,
        modules: one.modules
    )

# Where `asked`'s header list names `name`, or absent: at a binding whose
# macros end at it or reach a body naming it, else at the group of a file
# whose body names it, that body reached by no binding.
function explained(asked: Asked, name: str, s: source.Source, decls: [ast.Decl], headers: [str]) -> needs_told.Finding?
    if !asked.opening[name].is_err()
        return fail(code: "none", msg: "the compiler's own opening declares it")

    for binding in asked.bindings
        bound = own_declaration(s, decls, name: binding, modules: asked.modules)

        if bound.is_err()
            continue
        start: str @= binding
        macro: str @= ""
        walked = reach_ask.walk(asked.defines, from: binding)

        # A macro stands for the name wherever C reads it, before a function
        # of the same name the header defines.
        if !walked.is_err()
            macro @ walked.must().name
            start @ macro

            if macro == name
                return ok(
                    needs_told.Finding(span: bound.must().span, header: bound.must().header, binding: binding, macro: macro, body: fail(code: "none", msg: "a macro"), file: "", names: [name])
                )
        body = reaching(asked.bodies, from: start, name: name)

        if !body.is_err()
            return ok(
                needs_told.Finding(span: bound.must().span, header: bound.must().header, binding: binding, macro: macro, body: body, file: shown(s, decls, file: body.must().file), names: [name])
            )

    for body in asked.bodies
        if header_bodies.refers(body, name: name)
            group = own_group(s, decls, path: body.file, modules: asked.modules)

            if !group.is_err()
                return ok(
                    needs_told.Finding(span: group.must().span, header: group.must().header, binding: "", macro: "", body: ok(body), file: group.must().header, names: [name])
                )

            for header in headers
                first = own_group(s, decls, path: header, modules: asked.modules)

                if !first.is_err()
                    return ok(
                        needs_told.Finding(span: first.must().span, header: first.must().header, binding: "", macro: "", body: ok(body), file: shown(s, decls, file: body.file), names: [name])
                    )

    return fail(code: "none", msg: "no text of the headers names it")

# The declaration binding `name` in one of `modules`, the first such;
# the program's first where `modules` is empty.
function own_declaration(s: source.Source, decls: [ast.Decl], name: str, modules: [str]) -> ffi_lookup.Declared?
    if modules.len() == 0
        return ffi_lookup.declaration(s, decls, name: name)

    for index in range(from: 0, to: decls.len())
        if ffi_lookup.bound_as(s, decl: decls[index], name: name) && listed(modules, one: source.component_at(s, decls[index].span.start))
            found = ffi_lookup.declared_at(s, decls, index: index)

            if !found.is_err()
                return found

    return fail(code: "none", msg: "no group of these modules binds it")

# The group naming the file at `path` among `modules`' declarations, the
# first module's first; the program's first where `modules` is empty.
function own_group(s: source.Source, decls: [ast.Decl], path: str, modules: [str]) -> group_file.Group?
    if modules.len() == 0
        return group_file.group_of(s, decls, path: path)

    for module in modules
        found = group_file.group_among(s, decls, path: path, component: module)

        if !found.is_err()
            return found

    return fail(code: "none", msg: "no group of these modules names the file")

function listed(names: [str], one: str) -> bool
    for name in names
        if name == one
            return true

    return false

# A file of the dump as the program names it: the header of the group
# naming it, else as clang printed it.
function shown(s: source.Source, decls: [ast.Decl], file: str) -> str
    group = group_file.group_of(s, decls, path: file)

    if !group.is_err()
        return group.must().header
    return group_file.plain(file)

# The body `from` reaches through the bodies the header list defines, itself
# first, that names `name`, breadth first; absent where none does.
function reaching(bodies: [header_bodies.Body], from: str, name: str) -> header_bodies.Body?
    queue: [str] @= [from]
    seen: {str: bool} @= {}
    seen[from] @ true
    at: i64 @= 0

    while at < queue.len()
        body = header_bodies.body_of(bodies, name: queue[at])
        at @ at + 1

        if body.is_err()
            continue

        if header_bodies.refers(body.must(), name: name)
            return body

        for callee in body.must().calls
            if seen[callee].is_err()
                seen[callee] @ true
                queue @ queue.push(callee)

    return fail(code: "none", msg: "no body it reaches names it")

# `findings` with `one` added: its names joined to a finding told at the same
# place through the same text.
function merged(findings: [needs_told.Finding], one: needs_told.Finding) -> [needs_told.Finding]
    out: [needs_told.Finding] @= findings

    for i in range(from: 0, to: out.len())
        if out[i].span.start == one.span.start && out[i].macro == one.macro && body_name(out[i]) == body_name(one)
            out[i].names @ strings.with_all(list: out[i].names, more: one.names)
            return out

    return out.push(one)

function body_name(one: needs_told.Finding) -> str
    if one.body.is_err()
        return ""
    return one.body.must().name

## Tests

test "the body a binding reaches through the header's functions names the missing name (defect 2372)"
    mid = header_bodies.Body(
        name: "mid",
        file: "./inner.h",
        line: 2,
        inline: true,
        calls: ["base_two"],
        objects: [],
        reads: [],
        writes: []
    )
    top = header_bodies.Body(
        name: "top_fast",
        file: "./fast.h",
        line: 5,
        inline: true,
        calls: ["base_helper", "mid"],
        objects: ["base_count"],
        reads: ["base_count"],
        writes: []
    )
    loop = header_bodies.Body(
        name: "loop",
        file: "./fast.h",
        line: 9,
        inline: false,
        calls: ["loop"],
        objects: [],
        reads: [],
        writes: []
    )
    bodies = [mid, top, loop]
    assert reaching(bodies, from: "top_fast", name: "base_helper").must().name == "top_fast"
    assert reaching(bodies, from: "top_fast", name: "base_count").must().name == "top_fast"
    assert reaching(bodies, from: "top_fast", name: "base_two").must().name == "mid"
    assert reaching(bodies, from: "mid", name: "base_helper").is_err()
    assert reaching(bodies, from: "loop", name: "base_two").is_err()
    assert reaching(bodies, from: "nothing", name: "base_two").is_err()

constant TEXT: str
    "extern \"fast.h\" link \"top\"\n    function top_fast() -> i32\n\nfunction main()\n    print(top_fast())\n"

# The header's text names the missing name, or the name stays the
# compiler's: one the unit's own opening declares, and one no body and no
# macro of the list names, are never told, whatever the link says.
test "a name is the header's only where its text names it and the compiler's own opening does not declare it (defect 2372)"
    s = source.new_source(name: "inline_ref.hero", text: TEXT)
    decls = parse.parse(TEXT).decls
    top = header_bodies.Body(
        name: "top_fast",
        file: "./fast.h",
        line: 2,
        inline: true,
        calls: ["base_helper"],
        objects: [],
        reads: [],
        writes: []
    )
    asked = Asked(bodies: [top], opening: {}, bindings: ["top_fast"], defines: {}, answered: true, modules: [])
    found = explained(asked, name: "base_helper", s: s, decls: decls, headers: ["fast.h"]).must()
    assert found.binding == "top_fast" && found.file == "fast.h" && found.macro == ""
    assert found.body.must().name == "top_fast"
    opening: {str: bool} @= {}
    opening["base_helper"] @ true
    assert explained(
        Asked(bodies: [top], opening: opening, bindings: ["top_fast"], defines: {}, answered: true, modules: []),
        name: "base_helper",
        s: s,
        decls: decls,
        headers: ["fast.h"]
    ).is_err()
    assert explained(asked, name: "base_other", s: s, decls: decls, headers: ["fast.h"]).is_err()

    # A binding a macro makes the name, and a body no binding reaches, told
    # at the group that names its file.
    defines: {str: bound_said.Define} @= {}
    defines["top_fast"] @ bound_said.Define(params: {}, body: "base_helper", line: "#define top_fast base_helper")
    alias = explained(
        Asked(bodies: [], opening: {}, bindings: ["top_fast"], defines: defines, answered: true, modules: []),
        name: "base_helper",
        s: s,
        decls: decls,
        headers: ["fast.h"]
    ).must()
    assert alias.macro == "base_helper" && alias.body.is_err() && alias.binding == "top_fast"
    helper = header_bodies.Body(
        name: "helper",
        file: "./fast.h",
        line: 4,
        inline: false,
        calls: ["base_two"],
        objects: [],
        reads: [],
        writes: []
    )
    unreached = explained(
        Asked(bodies: [top, helper], opening: {}, bindings: ["top_fast"], defines: {}, answered: true, modules: []),
        name: "base_two",
        s: s,
        decls: decls,
        headers: ["fast.h"]
    ).must()
    assert unreached.binding == "" && unreached.header == "fast.h" && unreached.body.must().name == "helper"
