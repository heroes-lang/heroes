# The clang this build compiles with: which one answers, whether it is
# enough, and what to say when it is not. The floor is the oldest clang this
# compiler is measured on, asked of the machine once per build and by
# `heroes doctor` (panel 103, author instruction 2026-09-03: *"if you need to,
# you can require a recent minimum clang version, whichever you like"*;
# M-robustness-guards step 3c). Its own module because `cli/toolchain.hero`
# was at the ceiling and the floor is a concern with a name.
#
# **WHICH CLANG ANSWERS IS ALSO WHAT EVERY CACHED OBJECT IS KEYED ON** (defect
# 122, panel 182's item 4). The keys under `build/` held the Heroes version,
# the level, the text, the runtime and the search paths, and not the C
# compiler: a program printing `__clang_major__` built warm under Homebrew
# clang 22.1.8 printed 21, the object Apple clang 21 had left, and a compiler
# with one more flag and the same `VERSION` reused every object (the sitting's
# critic, and the coordinator's reproducer). `identity` is the answer the keys
# now carry, asked once per build where `--version` was asked before, so a
# build runs no more clang processes than it did.

use bytes
use cli/process
use cli/publish
use cli/strings
use cli/read_back

# THE CLANG FLOOR: 18 (author instruction 2026-09-03, panel 103 — *"if you
# need to, you can require a recent minimum clang version, whichever you
# like"*).
# Chosen from measured versions and not from a preference: 18.1.3 is the
# CI's Ubuntu leg, the oldest clang this project builds on; 18.1.8, 21.0.0
# and 22.1.8 (Debian, Apple, the Windows box) give the same `-ast-dump=json`
# shape the pointee check reads (`cli/header_types.hero`), and the
# `-Wincompatible-pointer-types` default flips only at 22, so the floor
# does not make the 14th flag redundant and the flag does not make the
# floor redundant. A higher floor today would break the CI's Linux leg for
# nothing; a lower one would promise a dump shape nobody measured.
constant FLOOR: i64
    18

# The major version in clang's first `--version` line, whatever vendor
# prefix it wears: `Apple clang version 21.0.0 (clang-2100.1.1.101)`,
# `Debian clang version 22.1.8 (++2026…)`, `clang version 22.1.8
# (https://github.com/llvm/llvm-project …)`, `Debian clang version 18.1.8`.
# The first integer after the word `version` is the major; anything else
# on the line is the vendor's.
function major_of(first_line: str) -> i64?
    after = text_after(text: first_line, marker: "version ")

    if after.is_err()
        return fail(code: "none", msg: "no `version` on the line")
    rest = after.must()
    value: i64 @ 0
    seen: i64 @ 0
    index: i64 @ 0

    while index < rest.len()
        b = rest[index]

        if b < '0' || b > '9'
            break
        value @ value * 10 + (b - '0').to_i64().must()
        seen @ seen + 1
        index @ index + 1

    if seen == 0
        return fail(code: "none", msg: "no number after `version`")
    return ok(value)

# What follows the first `marker` on the line. Each offset is asked by its
# bytes: sliced, a vendor string with a character above ASCII before the
# marker, `Clàng version 21.0.0`, put a cut inside it, and every `build` and
# `doctor` aborted before clang was asked anything (found beside defect 110,
# 2026-09-27). A match starts and ends on a character boundary, so the rest is
# sliced whole.
function text_after(text: str, marker: str) -> str?
    index: i64 @ 0

    while index + marker.len() <= text.len()
        if bytes.bytes_at(text: text, at: index, needle: marker)
            return ok(text.slice(from: index + marker.len(), to: text.len()))
        index @ index + 1

    return fail(code: "none", msg: "marker absent")

# WHAT THIS MACHINE'S CLANG SAYS IT WILL RUN for `words`, the flags every
# object is compiled under: `clang -###`, which prints the banner `--version`
# prints (its first four lines: the version, the target, the thread model and
# the directory the binary lives in) and then, without running it, the
# compiler invocation those flags resolve to on this machine, sysroot, SDK,
# target and include directories included. So the answer changes when the
# binary on the PATH does, when a flag does, and when an input clang takes
# from the environment rather than the command line does (`SDKROOT`, `CPATH`),
# where `--version` and the flag list alone would change for the first two.
# Measured 2026-09-28 on this Mac: the same answer twice from one clang, and
# a different one from Apple clang 21 and Homebrew clang 22.1.8.
#
# The input is the runtime's own `runtime.c`, because the driver refuses an
# input that is not there and that one is wherever a build can run; `-###`
# compiles nothing and writes no object. The answer goes to a private file
# (`cli/publish.hero`), since two builds in one tree under two clangs would
# otherwise each read the other's (defect 057's shape: a path nobody else
# writes cannot be substituted), and the file is removed once read. Absent,
# with what was said, when clang cannot be started or refuses the words; the
# build's own compile then says why in clang's words.
function identity(build_dir: str, runtime: str, words: [str]) -> str?
    process.mkdir_all(build_dir)?
    said_path = publish.private_name(build_dir + "/clang-identity.txt")
    line: [str] @ strings.with_all(list: ["clang", "-###"], more: words)
    line @ strings.with_all(list: line, more: ["-c", runtime + "/runtime.c", "-o", "identity.o"])
    ran = process.run(program: "clang", words: line, out: process.discard(), err: said_path)

    # **Read back with every word kept** (`cli/read_back.hero`, defect 337).
    # The answer names the working directory (`-fdebug-compilation-dir`), and
    # one byte there that is not UTF-8 made it no answer: the floor went
    # unchecked and every clang keyed its objects alike, `unanswered`, defect
    # 122's hazard. A byte is written by its value, so two answers keep apart
    # unless one spells the six characters `<0xE9>` where the other holds the
    # byte and they agree on every other byte. clang on Windows ends its lines
    # `\r\n` (`toolchain.asked_of_clang` has the measurement); the answer is
    # read as lines ended `\n` where it enters, so the same compiler keys the
    # same objects whichever way its stream was opened.
    said = read_back.words(said_path)
    publish.discard(said_path)

    if !ran.started
        return fail(code: "none", msg: "clang could not be started")

    if said.is_err()
        return fail(code: "none", msg: "what clang said could not be read back")
    text = said.must()

    if ran.code != 0
        return fail(code: "none", msg: text)
    return ok(text)

# The first line of what clang said, its version banner.
function banner(said: str) -> str
    first: [str] @ []

    for ch in said.chars()
        if ch == "\n"
            break
        first @ first.push(ch)

    return first.join("")

# The floor, enforced on the banner `identity` read: absent when clang is at
# or above it, a message the CLI prints at exit 2 otherwise — the tool could
# not run, which is what exit 2 means (CLAUDE.md §10). A clang that did not
# answer, or a banner with no version in it, is left to `run_clang`, which
# already says *not on this machine's PATH*.
function check(banner_line: str) -> ()?
    if banner_line.len() == 0
        return ok()
    major = major_of(banner_line)

    if major.is_err()
        return ok()

    if major.must() < FLOOR
        return fail(
            code: "clang",
            msg: "clang " + FLOOR.to_str() + " or newer is required, and this machine's clang is `" + banner_line + "` — the flags this compiler passes and the way it reads a header's parameter types were measured on clang 18, 21 and 22; an older clang answers differently, and a guess would be silent. `heroes doctor` says what this machine has"
        )
    return ok()

## Tests

test "the clang floor reads the major from every vendor's first line, and holds at 18"
    assert major_of("Apple clang version 21.0.0 (clang-2100.1.1.101)").must() == 21
    assert major_of("Debian clang version 22.1.8 (++20260613092233+e80beda6e255-1~exp1~20260613092250.77)").must() == 22
    assert major_of("clang version 22.1.8 (https://github.com/llvm/llvm-project ca7933e47d3a3451d81e72ac174dcb5aa28b59d1)").must() == 22
    assert major_of("Debian clang version 18.1.8 (++20240731024826+3b5b5c1ec4a3-1~exp1~20240731144843.145)").must() == 18
    assert major_of("Ubuntu clang version 18.1.3 (1ubuntu1)").must() == 18
    assert major_of("gcc (GCC) 14.1.0").is_err()
    assert FLOOR == 18

    # A vendor's name above ASCII, before the marker and after it.
    assert major_of("Clàng version 21.0.0").must() == 21
    assert major_of("😀 clang version 19.1.0 (€)").must() == 19
    assert major_of("clang versión 20").is_err()

    # This machine's own clang is at or above the floor, or nothing here would build.
    here = identity(build_dir: "build", runtime: "runtime", words: ["-std=gnu11"])
    assert !here.is_err()
    assert !check(banner(here.must())).is_err()
    assert check(banner_line: "Ubuntu clang version 17.0.6").is_err()
    assert !check(banner_line: "").is_err()

test "the identity is what this clang says it will run, and a flag moves it"
    # Asked of the real clang: the banner is its first line, as `--version`
    # prints it, and one more flag is another answer. The flag is a macro
    # definition, the kind the driver hands to the compiler it runs; that
    # it appears in the answer is what makes a changed flag list a changed
    # key (defect 122), asserted of the world rather than of this file.
    one = identity(build_dir: "build", runtime: "runtime", words: ["-std=gnu11", "-O0"]).must()
    same = identity(build_dir: "build", runtime: "runtime", words: ["-std=gnu11", "-O0"]).must()
    other = identity(build_dir: "build", runtime: "runtime", words: ["-std=gnu11", "-O0", "-DHEROES_KEY_PROBE=1"]).must(
    )
    assert !major_of(banner(one)).is_err()
    assert one == same
    assert one != other

    # A word clang refuses is an absent identity carrying what it said.
    refused = identity(build_dir: "build", runtime: "runtime", words: ["--heroes-no-such-flag"])
    assert refused.is_err()
