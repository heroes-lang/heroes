# What the pointee check asks of a header (design.md §4.19, §1.12; panel
# 103; defect 083): every `@` parameter of an extern whose pointee has a
# width and a sign to be held to, or a depth. `cli/pointee.hero` asks the
# header and keeps the answers; this file only decides what is asked, from
# the declaration in hand. Split out of that file on 2026-09-30, when defect
# 134's publishing passed it over §11's 300 lines, along the seam its own
# two headings drew: what is asked, and the check itself. Since panel 194's
# R7 it also asks what a LEND needs (`lend_ask`): the unit of every counted
# parameter, and the pointee of every record lent whole with no count.

use ast
use source
use widths
use check/table
use check/state
use ir/containers
use emit/externs as emit_externs
use handles
use cli/pointee_ask
use parse
use resolve
use checker
use ir/lower

# Every extern function of the program with a numeric `@` parameter. The
# narrowing is a fact about the declaration in hand: mutable, and an
# integer or a float. A `ptr` points at what the header says and nothing
# can be asked of it; a `cstr` is the writability check's (panel 058); a
# record is the header's own struct.
function pointees(p: containers.Program, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> [pointee_ask.Pointee]
    out: [pointee_ask.Pointee] @= []

    for f in p.functions
        if emit_externs.extern_spans(decls, f).header.is_err()
            continue
        name = source.span_text(s, decls[f.decl].name)
        found = source.locate(s, decls[f.decl].name.start)
        index: i64 @= 0

        for slot_id in f.params
            slot = f.slots[slot_id]
            declared = numeric_out(c, slot)

            if !declared.is_err()
                out @ out.push(
                    pointee_ask.Pointee(name: name, param: slot.name, index: index, declared: declared.must(), file: found.file, line: found.line, depth: false)
                )
            opaque = opaque_out(c, slot, decls)

            if !opaque.is_err()
                out @ out.push(
                    pointee_ask.Pointee(name: name, param: slot.name, index: index, declared: opaque.must(), file: found.file, line: found.line, depth: true)
                )
            lent = lend_ask(c, slot, decls, f: f, index: index)

            if !lent.is_err()
                out @ out.push(
                    pointee_ask.Pointee(name: name, param: slot.name, index: index, declared: lent.must(), file: found.file, line: found.line, depth: false)
                )

            if read_only(c, slot)
                out @ out.push(
                    pointee_ask.Pointee(name: name, param: slot.name, index: index, declared: pointee_ask.READ, file: found.file, line: found.line, depth: false)
                )
            index @ index + 1

        # The count a read-only lend's question is asked under (defect 411),
        # and whether the header gives a prototype at all (defect 426).
        if f.params.len() > 0
            out @ out.push(
                pointee_ask.Pointee(name: name, param: "", index: f.params.len(), declared: pointee_ask.ARITY, file: found.file, line: found.line, depth: false)
            )

    return out

# A `cstr` parameter that is not `@` (defect 411): whatever reaches it, a
# `.cstr()` of a `str` the program may share, a lease or a literal, is bytes
# the program does not hand C to write, so the header is asked whether its
# pointer points at `const` ones. Asked of every such parameter, `lent` or
# not, as the probe's own `const char *` always held them all. A `@cstr` is a
# cell C writes a pointer into, and that question is the probe's.
function read_only(c: state.Checked, slot: containers.Slot) -> bool
    match slot.kind
        .param_slot ps =>
            if ps.mutable
                return false
        .local_slot | .synthetic_slot | .return_slot => return false

    return match table.get(c.types, slot.ty)
        .cstr                                                      => true
        .int_ty | .float_ty | .bool | .str | .ptr | .unit          => false
        .array | .fixed | .map | .fallible | .function_ty | .named => false
        .case_ty | .failure | .generic | .error                    => false

# What a LEND asks of the header at this parameter (panel 194's R7, defects
# 092 and 395), or absent. A parameter declared `counted_by` asks the UNIT
# its count is in, whatever it is declared as — a `ptr` a field is lent to,
# or a group's record lent whole through `@` — because the count is C's and
# C counts in what its pointer points at. A group's record lent whole through
# `@` with no count asks whether the header takes it as `void *`, where any
# record crosses in silence and nothing bounds what C reaches. A handle is a
# pointer already, and its depth is `opaque_out`'s question.
function lend_ask(c: state.Checked, slot: containers.Slot, decls: [ast.Decl], f: containers.Function, index: i64) -> str?
    match decls[f.decl].kind
        .function_decl fd =>
            if index < fd.value.params.len() && !fd.value.params[index].counted_by.is_err()
                return ok(pointee_ask.UNIT)
        .constant_decl | .record_decl | .variant_decl | .test_decl => return fail(code: "none", msg: "not a function")

    if !whole_record(c, slot, decls)
        return fail(code: "none", msg: "neither counted nor a record lent whole")
    return ok(pointee_ask.WHOLE)

# An `@` parameter whose type is a group's record and not a handle: the
# program's own cell, lent whole, its address handed to C.
function whole_record(c: state.Checked, slot: containers.Slot, decls: [ast.Decl]) -> bool
    mutable = match slot.kind
        .param_slot ps                               => ps.mutable
        .local_slot | .synthetic_slot | .return_slot => false

    if !mutable
        return false

    match table.get(c.types, slot.ty)
        .named n =>
            match decls[n.decl].kind
                .record_decl r => return !r.header.is_err() && !handles.is_handle(decls[n.decl])
                .constant_decl | .function_decl | .variant_decl | .test_decl => return false
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .array | .fixed | .map | .fallible | .function_ty         => return false
        .case_ty | .failure | .generic | .error                   => return false

    return false

# The C spelling of a numeric `@` parameter's declared type, or absent for
# any other kind of slot.
function numeric_out(c: state.Checked, slot: containers.Slot) -> str?
    mutable: bool @= false

    match slot.kind
        .param_slot ps =>
            if ps.mutable
                mutable @ true
        .local_slot | .synthetic_slot | .return_slot => mutable @ mutable

    if !mutable
        return fail(code: "none", msg: "not an @ parameter")

    match table.get(c.types, slot.ty)
        .int_ty ik                                                 => return ok(widths.int_c_type(ik.kind))
        .float_ty fk                                               => return ok(widths.float_c_type(fk.kind))
        .bool | .str | .ptr | .cstr | .unit                        => return fail(code: "none", msg: "not numeric")
        .array | .fixed | .map | .fallible | .function_ty | .named => return fail(code: "none", msg: "not numeric")
        .case_ty | .failure | .generic | .error                    => return fail(code: "none", msg: "not numeric")

    return fail(code: "none", msg: "unreached")

# An OPAQUE `@` parameter — a `ptr`, or a handle, which is a pointer already —
# asks a different question of the header: not the pointee's width but its
# DEPTH (defect 083, panel 176's llm-ergonomist, reading the specification
# alone). `@p: Mem` over `record Mem tag void` hands C the address of the
# program's cell, `void **`, and a header that takes `void *p` accepts it in
# silence, because C converts any object pointer to `void *`; `@p: ptr` is
# cast to `(void *)` at the call for panel 103's reason and lands the same
# way. Measured: `eat(void *p)` freed the cell's address, 134, three of three,
# and `wipe(void *p)` wrote eight zero bytes into the cell at exit 0. So the
# header's parameter must point at a POINTER — `T **`, `void **`, a typedef of
# one — and `check_unit` asks that in C11 with `__builtin_classify_type`,
# which reads 5 for every pointer type on clang 18, 21 and 22 (measured on
# Darwin and both Linux legs). A `record` by value stays out: `@rec: Point`
# over `Point *p` is the correct out-parameter for a struct, and depth one is
# right there. What is returned is a word for the marker, not a C type: the
# depth line needs none.
function opaque_out(c: state.Checked, slot: containers.Slot, decls: [ast.Decl]) -> str?
    mutable: bool @= false

    match slot.kind
        .param_slot ps =>
            if ps.mutable
                mutable @ true
        .local_slot | .synthetic_slot | .return_slot => mutable @ mutable

    if !mutable
        return fail(code: "none", msg: "not an @ parameter")

    match table.get(c.types, slot.ty)
        .ptr => return ok("ptr")
        .named n =>
            if handles.is_handle(decls[n.decl])
                return ok("handle")
            return fail(code: "none", msg: "a record by value")
        .int_ty | .float_ty | .bool | .str | .cstr | .unit => return fail(code: "none", msg: "not opaque")
        .array | .fixed | .map | .fallible | .function_ty  => return fail(code: "none", msg: "not opaque")
        .case_ty | .failure | .generic | .error            => return fail(code: "none", msg: "not opaque")

    return fail(code: "none", msg: "unreached")

## Tests

test "a numeric @ parameter is asked its width, an opaque one its depth, and each ask carries its line"
    text = "extern \"stdio.h\"\n    function getline(@line: ptr, @n: i32, stream: ptr) -> i64\n    function frexp(x: f64, @e: i32) -> f64\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    wanted = pointees(low.program, c, s, parsed.decls)
    named: [str] @= []

    for one in wanted
        if one.file == "t.hero"
            kind: str @= "width"

            if one.depth
                kind @ "depth"
            named @ named.push(
                one.name + "." + one.param + "@" + one.index.to_str() + ":" + one.declared + ":" + one.line.to_str() + ":" + kind
            )

    # `@line: ptr` is opaque and asks for depth (defect 083); `@n: i32` and `@e: i32`
    # are numeric and ask for width; `stream: ptr` and `x: f64` are not `@` and ask
    # nothing.
    assert named == ["getline.line@0:ptr:2:depth", "getline.n@1:int32_t:2:width", "getline.@3:arity:2:width", "frexp.e@1:int32_t:3:width", "frexp.@2:arity:3:width"]

# Panel 194's R7: a counted parameter asks its unit, a `ptr` and a record lent
# whole alike; a record lent whole with no count asks whether C takes it as
# `void *`; a handle asks only its depth, and a record by value nothing.
test "a lend asks the unit of a counted parameter, and a record lent whole with no count asks its pointee"
    text = "extern \"s.h\"\n    record One tag one\n        a: i32\n    record Op tag opaque\n    function fill(p: ptr counted_by n lent, n: u64) -> i64\n    function read_into(@buf: One counted_by n, n: u64) -> i64\n    function plain(@buf: One, n: u64) -> i64\n    function eat(@h: Op)\n    function show(o: One) -> i64\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    named: [str] @= []

    for one in pointees(low.program, c, s, parsed.decls)
        if one.file == "t.hero"
            named @ named.push(one.name + "." + one.param + "@" + one.index.to_str() + ":" + one.declared)

    assert sort(named) == ["eat.@1:arity", "eat.h@0:handle", "fill.@2:arity", "fill.p@0:unit", "plain.@2:arity", "plain.buf@0:whole", "read_into.@2:arity", "read_into.buf@0:unit", "show.@1:arity"]

# Defect 411: a `cstr` that is not `@` asks whether the header's pointer points
# at `const` bytes, `lent` or not, under the declaration's count of parameters;
# a `@cstr` cell and a `ptr` ask nothing of it.
test "a cstr parameter asks whether its pointer points at const bytes, and a cstr cell does not"
    text = "extern \"s.h\"\n    function free(p: ptr)\n    function digest(md: cstr lent, n: u64, key: cstr) -> i32\n    function name_of(@out: cstr owned free, p: ptr) -> i32\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    named: [str] @= []

    for one in pointees(low.program, c, s, parsed.decls)
        if one.file == "t.hero"
            named @ named.push(one.name + "." + one.param + "@" + one.index.to_str() + ":" + one.declared)

    assert sort(named) == ["digest.@3:arity", "digest.key@2:read", "digest.md@0:read", "free.@1:arity", "name_of.@2:arity"]
