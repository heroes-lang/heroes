# What a build knows of the platform layer that `check` cannot: a header of
# the program's own reaching the layer's, a group saying `layer` whose header
# reaches none of it and whose library calls none of it, and a binding of the
# layer's function through a declaration of the program's own (design.md
# §1.11, §4.19; panel 260, provisional, author ratification pending): bound
# by its own name here, and through a macro or a body by
# `cli/layer_declared.hero`, which also asks a word said of none of the layer
# whether such a binding stands behind it (defect 2856).
#
# **A group binds the layer where its header is the layer's or reaches it, or
# its library calls it** (R2, R3). The first two are read here from the walk
# every build already makes before its first clang (`cli/include_stands.hero`),
# which follows each group's header and every file it includes, to any depth,
# as clang's search finds them, every `#if` but `#if 0` read as true; the
# third from a link of the program's libraries asked before any unit compiles
# (`cli/layer_libraries.hero`). One reading decides both refusals, so no
# program is refused both with the word and without it: a group that binds
# says `layer`, and a group that says `layer` binds.
#
# **A file is the layer's by its path in the runtime's folder, never by its
# name**: the runtime's own list (`runtime_key.layer_files`), the members, the
# headers each is named after and the files under `platform/`; never what
# lies under `vendor/`, nor a header of the program's own named like the
# layer's. A header clang found in the runtime's folder under a name that is
# a layer file's but for its case is judged by nothing here: clang refuses
# that spelling itself (`ffi_header_refused`, a path that is not portable).
#
# **What the walk cannot see is the link's to say** (`cli/layer_link.hero`).

use ast
use bytes
use check/layer_header
use cli/include_told
use cli/layer_libraries
use cli/own_names
use cli/package_reads
use cli/runtime_bound
use cli/runtime_key
use cli/toolchain
use diag
use emit/c_words
use emit/externs as emit_externs
use module/reading
use parse
use source
use token

# What one group's header reaches of the layer, as the walk found it: the
# layer's file met first (its path in the runtime's folder, "" where none
# is), whether that file is the header itself, whether the header is a
# runtime file named like one of the layer's but for its case, and, where it
# reaches none of the layer, whether the header is the runtime's own, a file
# of the runtime's folder outside `vendor/` (`hero_os.h`, `hero_compiler.h`),
# which a refusal names as what it is.
record Reach
    file: str
    is: bool
    folded: bool
    runtime_own: bool

# Each group of `decls` whose header is one of `headers`, or one of the
# compiler's own the unit's opening reads before them (`hero_os.h`), its
# reach read from the walk's `edges` and `roots` (the file each line of the
# opening was found at, by its name) into `reaches`, by its string's first
# byte. A group over the compiler's own header was judged by nothing here
# until panel 260's amendment after its blind reading (provisional, the
# author's reading pending): `extern "hero_os.h" layer` built and ran, the
# word binding nothing of the layer, while the specification says no group
# but the layer's may say it. A header the walk found as no file is judged by
# nothing here: what it binds is unread, and the build tells the header
# missing (`Hero_Time.h` on a file system that keeps case, where it was told
# a binding through a file that is not there, lane land260's Linux arm64
# run).
function reach_each(s: source.Source, decls: [ast.Decl], headers: [str], edges: {str: [str]}, roots: {str: str}, runtime: str, files: [str], @reaches: {i64: Reach})
    for decl in decls
        head = layer_header.head_of(decl)

        if head.header.is_err() || !reaches[head.header.must().start].is_err()
            continue
        name = emit_externs.unquoted(s, span: head.header.must())
        root = roots[name].default("")

        if root.len() > 0 && (index_of(headers, name: name) >= 0 || emit_externs.is_own(name))
            reaches[head.header.must().start] @ reach_of(edges: edges, root: root, runtime: runtime, files: files)

# Each group judged once, in the order the declarations stand, against the
# word its head line says: a group that binds and does not say it is refused
# at its string, `certain` to take the word, since the file the refusal names
# is the runtime's; one saying it that binds nothing, at its word. A group
# with no reach read is not judged here.
function told(s: source.Source, decls: [ast.Decl], reaches: {i64: Reach}, t: toolchain.Toolchain, linking: layer_libraries.Linking) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= []
    files = runtime_key.layer_files(t.runtime).default([])

    if files.len() == 0
        return out
    declared = layer_header.declared(decls)
    needs = layer_libraries.asked(
        t,
        s,
        decls,
        linking: linking,
        names: declared_names(t.runtime),
        wanted: wanted(decls, reaches: reaches, declared: declared)
    )
    seen: {i64: bool} @= {}
    names: {str: str} @= {}
    read: bool @= false

    for decl in decls
        head = layer_header.head_of(decl)

        if head.header.is_err()
            continue
        span = head.header.must()
        r = reaches[span.start]

        if r.is_err() || !seen[span.start].is_err() || r.must().folded
            continue
        seen[span.start] @ true
        spelled = source.span_text(s, span)
        called = layer_libraries.called(s, decls, needs: needs, group: span)

        if head.layer.is_err() && r.must().file.len() > 0
            through: str @= "`" + r.must().file + "`"

            if r.must().is
                through @ ""
            out @ out.push(
                layer_header.undeclared(header: spelled, span: span, through: through, library: layer_header.written_library(s, head.library))
            )
            continue

        if head.layer.is_err() && called.symbols.len() > 0
            out @ out.push(layer_libraries.undeclared(s, decls, spelled: spelled, span: span, call: called))
            continue

        if r.must().file.len() > 0 || !head.layer.is_err() && (called.symbols.len() > 0 || called.unread)
            continue

        # Neither reached nor said by its library: what it binds is asked of
        # the layer's own headers, for the word's group and, where another
        # group says it and the layer is on the link, for one without it.
        if head.layer.is_err() && !declared
            continue

        if !read
            names @ declared_names(t.runtime)
            read @ true
        bound = bound_in_group(s, decls, header: span, names: names)

        if !bound.is_err()
            out @ out.push(
                redeclared(name: bound.must().name, header: names[bound.must().name].default(""), own: spelled, span: bound.must().span, runtime_own: r.must().runtime_own)
            )
        else if !head.layer.is_err()
            out @ out.push(
                layer_header.unreached(header: spelled, word: head.layer.must(), from: span.end, library: layer_libraries.said_of(s, head.library), runtime_own: r.must().runtime_own)
            )

    return out

# Whether a library of the program is to be asked what it calls of the layer:
# where a group says `layer`, and a group naming a library either does not
# say it or says it over a header that reaches none of the layer. A program
# none of whose groups says it asks nothing (R5): a library of its calling
# the layer leaves its link short, told there (`cli/layer_link.hero`).
function wanted(decls: [ast.Decl], reaches: {i64: Reach}, declared: bool) -> bool
    if !declared
        return false

    for decl in decls
        head = layer_header.head_of(decl)

        if head.header.is_err() || head.library.is_err()
            continue
        r = reaches[head.header.must().start]

        if head.layer.is_err() || !r.is_err() && r.must().file.len() == 0
            return true

    return false

# The reach of the header the walk found at `root`: the first file of the
# layer's, breadth first, that `edges` reach from it, itself included; none
# where `root` is "".
function reach_of(edges: {str: [str]}, root: str, runtime: str, files: [str]) -> Reach
    none = Reach(file: "", is: false, folded: false, runtime_own: false)

    if root.len() == 0
        return none

    if folded_path(runtime: runtime, path: root, files: files)
        return Reach(file: "", is: false, folded: true, runtime_own: false)
    queue: [str] @= [root]
    seen: {str: bool} @= {}
    seen[root] @ true
    at: i64 @= 0

    while at < queue.len()
        path = queue[at]
        at @ at + 1
        inside = layer_path(runtime: runtime, path: path, files: files)

        if inside.len() > 0
            return Reach(file: inside, is: path == root, folded: false, runtime_own: false)

        for next in edges[path].default([])
            if seen[next].is_err()
                seen[next] @ true
                queue @ queue.push(next)

    own = runtime_inside(runtime: runtime, path: root)
    return Reach(
        file: "",
        is: false,
        folded: false,
        runtime_own: own.len() > 0 && !bytes.bytes_at(text: own, at: 0, needle: runtime_key.VENDOR)
    )

# The path of `path` in the runtime's folder `runtime` where it is one of the
# layer's files `files`, read lexically as `include_told.file_said` reads a
# file of the runtime's; "" where it is not.
function layer_path(runtime: str, path: str, files: [str]) -> str
    inside = runtime_inside(runtime: runtime, path: path)

    if inside.len() > 0 && has(files, name: inside)
        return inside
    return ""

# Whether `path` is a file of the runtime's folder whose path there is one of
# the layer's files but for the case of its letters.
function folded_path(runtime: str, path: str, files: [str]) -> bool
    inside = runtime_inside(runtime: runtime, path: path)

    if inside.len() == 0 || has(files, name: inside)
        return false

    for one in files
        if same_folded(a: one, b: inside)
            return true

    return false

function runtime_inside(runtime: str, path: str) -> str
    at = package_reads.lexical(path)
    home = package_reads.lexical(runtime)

    if !include_told.within(place: at, folders: [home])
        return ""
    return at.slice(from: home.len() + 1, to: at.len())

function same_folded(a: str, b: str) -> bool
    if a.len() != b.len()
        return false

    for at in range(from: 0, to: a.len())
        if bytes.lower(a[at]) != bytes.lower(b[at])
            return false

    return true

# A name of the group whose header string is `header` that a header of the
# layer declares (`names`), with where it is bound: the first, in the order
# the declarations stand.
record Bound
    name: str
    span: token.Span

function bound_in_group(s: source.Source, decls: [ast.Decl], header: token.Span, names: {str: str}) -> Bound?
    for decl in decls
        head = layer_header.head_of(decl)
        bound = runtime_bound.bound(decl)

        if head.header.is_err() || bound.is_err() || head.header.must().start != header.start
            continue
        name = source.span_text(s, bound.must())

        if !names[name].is_err()
            return ok(Bound(name: name, span: bound.must()))

    return fail(code: "none", msg: "binds no name of the layer's")

# A group that binds a function of the layer through a header of its own,
# which declares it and includes none of the layer's: told at the binding.
# Through the runtime's own header (`runtime_own`), which no program edits,
# the one repair named is the group's header.
function redeclared(name: str, header: str, own: str, span: token.Span, runtime_own: bool) -> diag.Diagnostic
    through: str @= "`" + layer_header.bare(own) + "`, which includes none of the layer's headers: name `" + header + "` in the group, or include it in `" + layer_header.bare(own) + "`"

    if runtime_own
        through @ "`" + layer_header.bare(own) + "`, the runtime's own header, which includes none of the layer's: name `" + header + "` in the group"
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: layer_header.REDECLARED,
        message: "`" + name + "` is the platform layer's, declared by its `" + header + "`, and this group binds it through " + through,
        span: span
    )
    d.notes @ d.notes.push(REDECLARED)
    return d

# Why a binding of the layer's own function through a declaration of the
# program's is refused, which every refusal of that shape says.
constant REDECLARED: str
    "clang checks a binding against the header its group names, so a function of the layer's declared by the program itself is checked against nothing the layer wrote: a parameter or a result of another width there is a call the layer reads otherwise"

function index_of(list: [str], name: str) -> i64
    for at in range(from: 0, to: list.len())
        if list[at] == name
            return at

    return -1

function has(list: [str], name: str) -> bool
    for one in list
        if one == name
            return true

    return false

# Each name in the runtime's own forms a header of the layer declares, with
# the first such header's path in the runtime's folder, in the order the
# runtime's list names the headers.
function declared_names(runtime: str) -> {str: str}
    out: {str: str} @= {}
    files = runtime_key.layer_files(runtime)

    if files.is_err()
        return out

    for inside in files.must()
        if inside.len() < 3 || inside.slice(from: inside.len() - 2, to: inside.len()) != ".h"
            continue
        text = reading.text_of(runtime + "/" + inside)

        if text.is_err()
            continue
        words = c_words.used(text.must())

        # ORDER: none — each name keeps the first header in the list's order,
        # the order `runtime.c` writes, whatever order `keys` gives.
        for word in keys(words)
            if own_names.reserved(word) && out[word].is_err()
                out[word] @ inside

    return out

## Tests

# **The layer's files are the runtime's list, by path** (panel 260's R2):
# every file of it is the layer's in the runtime's folder and nowhere else; a
# vendored file, the runtime's own headers and a file elsewhere named like a
# header of the layer's are none of it; and a spelling that differs from one
# of its files by case alone is told apart.
test "a file is the layer's by its path in the runtime's folder, the runtime's own list (panel 260)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    files = runtime_key.layer_files(t.runtime).must()
    assert files.len() > 0

    for name in files
        assert layer_path(runtime: t.runtime, path: t.runtime + "/" + name, files: files) == name
        assert layer_path(runtime: t.runtime, path: "elsewhere/" + name, files: files) == ""

    for own in ["hero_os.h", "hero_compiler.h", "heroes_runtime.h", "vendor/monocypher/monocypher.h", "vendor/monocypher/monocypher.c"]
        assert layer_path(runtime: t.runtime, path: t.runtime + "/" + own, files: files) == ""
        assert !folded_path(runtime: t.runtime, path: t.runtime + "/" + own, files: files)

    assert folded_path(runtime: t.runtime, path: t.runtime + "/Hero_Time.h", files: files)
    assert !folded_path(runtime: t.runtime, path: t.runtime + "/hero_time.h", files: files)

test "a reach is the first layer file met, the header itself or one it includes (panel 260)"
    files = ["hero_time.h", "platform/hero_time.c"]
    edges: {str: [str]} @= {}
    edges["own.h"] @ ["rt/hero_time.h"]
    edges["mid.h"] @ ["own.h"]
    edges["vend.h"] @ ["rt/vendor/m.h"]
    through = reach_of(edges: edges, root: "mid.h", runtime: "rt", files: files)
    assert through.file == "hero_time.h" && !through.is && !through.folded
    itself = reach_of(edges: edges, root: "rt/hero_time.h", runtime: "rt", files: files)
    assert itself.file == "hero_time.h" && itself.is
    assert reach_of(edges: edges, root: "vend.h", runtime: "rt", files: files).file == ""
    assert reach_of(edges: edges, root: "rt/HERO_TIME.h", runtime: "rt", files: files).folded
    assert reach_of(edges: edges, root: "", runtime: "rt", files: files).file == ""

    # Where none of the layer is reached, a header of the runtime's own is
    # told apart from one of the program's and from the runtime's vendored C.
    edges["rt/hero_os.h"] @ ["rt/heroes_runtime.h"]
    own = reach_of(edges: edges, root: "rt/hero_os.h", runtime: "rt", files: files)
    assert own.file == "" && own.runtime_own && !own.folded
    assert !through.runtime_own && !itself.runtime_own
    assert !reach_of(edges: edges, root: "vend.h", runtime: "rt", files: files).runtime_own
    vendored = reach_of(edges: edges, root: "rt/vendor/m.h", runtime: "rt", files: files)
    assert vendored.file == "" && !vendored.runtime_own

# A header the walk found as no file leaves its group unjudged, so the build
# tells it missing rather than a binding through it (lane land260).
test "a group whose header the walk found nowhere has no reach to be judged by (panel 260)"
    text = "extern \"Hero_Time.h\" layer\n    function hero_time_monotonic_ns() -> i64\n"
    s = source.new_source(name: "main.hero", text: text)
    decls = parse.parse(text).decls
    reaches: {i64: Reach} @= {}
    edges: {str: [str]} = {}
    unfound: {str: str} = {}
    reach_each(
        s,
        decls,
        headers: ["Hero_Time.h"],
        edges: edges,
        roots: unfound,
        runtime: "rt",
        files: ["hero_time.h"],
        reaches: @reaches
    )
    assert keys(reaches).len() == 0
    found: {str: str} @= {}
    found["Hero_Time.h"] @ "rt/hero_time.h"
    reach_each(
        s,
        decls,
        headers: ["Hero_Time.h"],
        edges: edges,
        roots: found,
        runtime: "rt",
        files: ["hero_time.h"],
        reaches: @reaches
    )
    assert keys(reaches).len() == 1

# **A group over the compiler's own header is judged too** (panel 260's
# amendment after its blind reading, provisional, the author's reading
# pending): the unit's opening reads `hero_os.h` before the groups' headers
# and no group's walk enters it, so its group is judged by what the file the
# opening found reaches, the runtime's own and none of the layer's; a header
# the opening names that is no compiler's own is its group walk's to judge.
test "a group over the compiler's own header is judged by the file the opening found (panel 260's amendment)"
    text = "extern \"hero_os.h\" layer\n    function hero_os_pid() -> i64\n\nextern \"x.h\" layer\n    function x_one() -> i64\n"
    s = source.new_source(name: "main.hero", text: text)
    decls = parse.parse(text).decls
    reaches: {i64: Reach} @= {}
    edges: {str: [str]} @= {}
    edges["rt/hero_os.h"] @ ["rt/heroes_runtime.h"]
    roots: {str: str} @= {}
    roots["hero_os.h"] @ "rt/hero_os.h"
    roots["x.h"] @ "x.h"
    reach_each(
        s,
        decls,
        headers: [],
        edges: edges,
        roots: roots,
        runtime: "rt",
        files: ["hero_time.h"],
        reaches: @reaches
    )
    assert keys(reaches).len() == 1
    r = reaches[keys(reaches)[0]].must()
    assert r.file == "" && r.runtime_own && !r.is && !r.folded

# **No name a group binds through the runtime's own headers is one of the
# layer's** (panel 260's amendment): since a group over `hero_os.h` is judged
# as every group is, a name it declares that a header of the layer's code
# writes too would refuse a correct binding as the layer's made through the
# runtime's header. A premise about the runtime's files, so held here: this
# test fails, naming each name and both headers, the day one is shared. The
# names `heroes_runtime.h` writes are left out, every binding of one being
# refused as the runtime's own (`check/runtime_header.hero`).
test "no name the runtime's own headers write is one of the layer's (panel 260's amendment)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    names = declared_names(t.runtime)
    runtime_words = c_words.used(reading.text_of(t.runtime + "/heroes_runtime.h").must())
    shared: [str] @= []

    for own in ["hero_os.h", "hero_compiler.h", "heroes_unit.h"]
        words = c_words.used(reading.text_of(t.runtime + "/" + own).must())

        for word in sort(keys(words))
            if own_names.reserved(word) && runtime_words[word].is_err() && !names[word].is_err()
                shared @ shared.push(own + " and " + names[word].must() + ": " + word)

    assert shared == []

test "a name the layer's headers declare is found with its header, and one of the runtime's own is not (panel 260)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    names = declared_names(t.runtime)
    assert names["hero_time_monotonic_ns"].must() == "hero_time.h"
    assert names["hero_net_stop_asked"].must() == "hero_net.h"
    assert names["hero_args_set"].is_err()
    assert names["printf"].is_err()
