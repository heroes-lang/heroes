# heroes doctor and heroes this — the two commands with no file
# (panels 016, 080). Port of archive/bootstrap-rs/heroes-cli/src/commands/
# {doctor,this}.rs, one module because each is a page and both answer
# without reading a program.
#
# doctor verifies the toolchain the compiler depends on, and it is the
# only place $HEROES_RUNTIME is visible — an input channel outside the
# argv table, and a channel nobody can discover is one that will be
# discovered by reading the source. this prints the Zen, the surface's
# one author-ratified exception to §10's stopping rule, admitted in
# the class --version occupies: zero input, constant output, exit 0.

use cli/table as cli_table
use cli/io
use cli/toolchain
use cli/process
use cli/publish
use cli/clang_floor
use cli/read_back

record Check
    name: str
    ok: bool
    detail: str

# The first line of what a program said, or absent when it could not
# run.
#
# **It took a command LINE until M-argv-execution and takes a word list
# now**, which is what lets it answer a question it could not answer
# before: `system()` said 127 both for a program that is not installed
# and for one that ran and exited 127, so "no clang on this machine"
# and "clang is angry" were the same reply. `started` separates them,
# and the caller is the one command whose whole job is to tell an
# author which of the two they are looking at.
#
# stderr is discarded rather than shown: a `--version` probe that
# complains is a probe that failed, and its complaint is noise on a
# report about the machine. The answer lands under a private name
# (`cli/publish.hero`), removed once read: it was `build/doctor-out.txt`
# for every doctor in the tree until 2026-09-30 (defect 134), so two at once
# could read each other's `uname` as a clang version.
function capture(program: str, words: [str], build_dir: str) -> str?
    out_path = publish.private_name(build_dir + "/doctor-out.txt")
    process.mkdir_all(build_dir)?
    ran = process.run(program: program, words: words, out: out_path, err: process.discard())
    said = read_back.words(out_path)
    publish.discard(out_path)

    if !ran.started
        return fail(code: "none", msg: "the program is not on this machine")

    if ran.code != 0
        return fail(code: "none", msg: "the command could not run")

    if said.is_err()
        return fail(code: "none", msg: "nothing was said")
    return ok(first_line(said.must()))

function first_line(text: str) -> str
    run: [str] @= []

    for ch in text.chars()
        if ch == "\n"
            break
        run @ run.push(ch)

    return trim_ends(run.join(""))

function trim_ends(text: str) -> str
    cs = text.chars()
    head: i64 @= 0

    while head < cs.len() && (cs[head] == " " || cs[head] == "\t")
        head @ head + 1

    tail: i64 @= cs.len()

    while tail > head && (cs[tail - 1] == " " || cs[tail - 1] == "\t")
        tail @ tail - 1

    return cs.slice(from: head, to: tail).join("")

# clang, the linker's home, the architecture, the runtime, and a
# writable cache. The linker check is named after WHAT IT IS FOR and
# asked in the platform's own words (`linker_home` below): it used to ask
# xcode-select everywhere, which made doctor exit 1 on Linux — found the
# day CI first ran on two platforms, which is the whole reason that CI
# exists.
function checks(build_dir: str, runtime_hint: str?) -> [Check]
    out: [Check] @= []
    clang = capture(program: "clang", words: ["clang", "--version"], build_dir: build_dir)
    out @ out.push(
        Check(name: "clang", ok: !clang.is_err(), detail: clang.default("not found — install a C toolchain"))
    )

    # The floor (panel 103): the same first line, read for its major.
    if !clang.is_err()
        major = clang_floor.major_of(clang.must())
        floor_ok = !major.is_err() && major.must() >= clang_floor.FLOOR
        found: str @= "a version this compiler cannot read"

        if !major.is_err()
            found @ "clang " + major.must().to_str()
        out @ out.push(
            Check(name: "clang floor", ok: floor_ok, detail: found + " against a floor of " + clang_floor.FLOOR.to_str() + " — the oldest clang this compiler is measured on")
        )
    out @ out.push(linker_home(build_dir: build_dir))
    arch = capture(program: "uname", words: ["uname", "-m"], build_dir: build_dir).default("unknown")
    out @ out.push(Check(name: "arch", ok: true, detail: arch))

    # The runtime — found by searching, so doctor is the place that
    # says which candidate won. A hint that cannot be read is named, never
    # passed over for the next place (defect 243).
    match runtime_hint
        .err e => out @ out.push(Check(name: "runtime", ok: false, detail: e.msg))
        .ok hint =>
            match toolchain.locate_toolchain(hint: hint, fingerprint: "doctor")
                .ok t  => out @ out.push(Check(name: "runtime", ok: true, detail: t.runtime))
                .err e => out @ out.push(Check(name: "runtime", ok: false, detail: unfound(code: e.code, msg: e.msg)))

    # build/ must be creatable and writable, probed by writing.
    made = process.mkdir_all(build_dir)
    cache_ok: bool @= false

    if !made.is_err()
        probe = publish.private_name(build_dir + "/.doctor-probe")

        if !write_file(path: probe, text: "ok").is_err() && !read_file(probe).is_err()
            cache_ok @ true
        publish.discard(probe)
    detail: str @= "cannot write to " + build_dir + "/"

    if cache_ok
        detail @ build_dir + "/ writable"
    out @ out.push(Check(name: "build cache", ok: cache_ok, detail: detail))
    return out

# Where the linker and the C libraries live, asked as each platform's
# toolchain answers it (defect 336). **Windows is asked first, and by the
# runtime** (`exe_suffix()`, the question `link_flags.link_flags` asks): its shell
# may have no `uname` at all, and Git's answers `MINGW64_NT-…`, which read as
# Linux and drew Linux's `cc` row and advice, FAIL on the Windows box where
# `heroes build` built and ran programs (panel 191's compiler-engineer). The
# other two keep the words they had: `uname -s` asked, a fact about the
# machine in hand rather than a premise about which platforms exist.
function linker_home(build_dir: str) -> Check
    if process.exe_suffix() == ".exe"
        return msvc_row(links_here(build_dir: build_dir, source: LINK_PROBE))
    system_name = capture(program: "uname", words: ["uname", "-s"], build_dir: build_dir).default("unknown")

    if system_name == "Darwin"
        clt = capture(program: "xcode-select", words: ["xcode-select", "-p"], build_dir: build_dir)
        return Check(
            name: "xcode CLT",
            ok: !clt.is_err(),
            detail: clt.default("not found — run `xcode-select --install`")
        )
    cc = capture(program: "cc", words: ["cc", "--version"], build_dir: build_dir)
    return Check(
        name: "cc",
        ok: !cc.is_err(),
        detail: cc.default("not found — install a C toolchain (build-essential, base-devel, …)")
    )

# Windows' question. There is no `cc` there to ask, and the CI's leg read it
# green only because its image carries MinGW's gcc under that name, a compiler
# this one does not use there. clang targets `x86_64-pc-windows-msvc`, links
# against MSVC's libraries and a Windows SDK it finds by itself, and without
# them every link fails, `lld-link: error: could not open 'libcmt.lib'`: so the
# question is a C program compiled, linked and run, the check the box's own
# record calls the one that matters
# (`docs/platforms/windows/WINDOWS-MACHINE.md`).
function msvc_row(linked: str?) -> Check
    match linked
        .ok said => return Check(name: "MSVC", ok: true, detail: said)
        .err e   => return Check(name: "MSVC", ok: false, detail: e.msg + " — " + MSVC_ADVICE)

constant MSVC_ADVICE: str
    "install Visual Studio's Build Tools with their C++ tools (`Microsoft.VisualStudio.Component.VC.Tools.x86.x64`), which bring the MSVC libraries and a Windows SDK that clang finds by itself"

# What the probe compiles: a header from the Windows SDK's C runtime, a call
# into it, and an answer the program itself gives.
constant LINK_PROBE: str
    "#include <stdio.h>\nint main(void) { return fputs(\"linked\", stdout) < 0 ? 1 : 0; }\n"

# `source` compiled, linked and run by this machine's clang, in a directory
# of its own under `build_dir` that goes whole afterwards; ok with what was
# done, or what stopped it in clang's own words, its first line.
function links_here(build_dir: str, source: str) -> str?
    dir = publish.private_name(build_dir + "/doctor-link")
    process.mkdir_all(dir)?
    answer = linked_and_ran(dir: dir, source: source)
    _ = process.remove_tree(dir).is_err()
    return answer

function linked_and_ran(dir: str, source: str) -> str?
    unit = dir + "/probe.c"
    binary = dir + "/probe" + process.exe_suffix()
    said = dir + "/said.txt"

    if write_file(path: unit, text: source).is_err()
        return fail(code: "none", msg: "cannot write " + unit + process.because())
    built = process.run(program: "clang", words: ["clang", unit, "-o", binary], out: process.discard(), err: said)

    if !built.started
        return fail(code: "none", msg: "clang is not on this machine, so nothing was linked")

    if built.code != 0
        return fail(code: "none", msg: "clang could not link a C program: " + first_said(path: said, code: built.code))
    ran = process.run(program: binary, words: [binary], out: said, err: process.discard())
    answered = read_file(said)

    if !ran.started || ran.code != 0 || answered.is_err() || answered.must() != "linked"
        return fail(code: "none", msg: "clang linked a C program, and it did not run to its end")
    return ok("clang compiled, linked and ran a C program")

# The first line clang wrote, or its exit code where it wrote none. Read as
# `read_back.words` reads, so a linker's words in its own code page are quoted with
# each byte that is not UTF-8 written by its value, never dropped (defect 337),
# and a line clang on Windows ends `\r\n` carries no `\r` inside the quotes.
function first_said(path: str, code: i64) -> str
    said = read_back.words(path)

    if said.is_err()
        return "it exited " + code.to_str() + " and wrote nothing that could be read back"
    line = first_line(said.must())

    if line.len() == 0
        return "it exited " + code.to_str() + " and said nothing"
    return "`" + line + "`"

function run_doctor(build_dir: str, runtime_hint: str?) -> cli_table.Exit
    all_ok: bool @= true

    for c in checks(build_dir: build_dir, runtime_hint: runtime_hint)
        mark: str @= "FAIL"

        if c.ok
            mark @ "ok "
        print(mark + "  " + pad_to(c.name, width: 12) + " " + c.detail)

        if !c.ok
            all_ok @ false

    if all_ok
        return .ok_exit
    return .failed_exit

# What the runtime row says when none is found: a `HEROES_RUNTIME` that names
# none is told by its own refusal's first line (defect 276), where the row
# told an author who had set it to set it; with none set, the row's own words.
function unfound(code: str, msg: str) -> str
    if code == "hint"
        return first_line(msg)
    return "not found — set HEROES_RUNTIME=<dir>"

function pad_to(text: str, width: i64) -> str
    count = text.chars().len()

    if count >= width
        return text
    return text + " ".repeat((width - count).to_u64().must())

# The twenty laws, byte-exact — the test below pins this text verbatim,
# so a change is deliberate in two places (CLAUDE.md §9's redundancy
# rule, and law 14's). Python stores its
# Zen ROT13-encoded; this one is plain text, because law 4 says what
# the eye can see is all there is.
#
# Law 19 is the author's ruling of 2026-09-20, in the words they asked for:
# robustness is a principle of the language and belongs here. It is design.md
# §1.12 at the one place the language's own guarantees stop, the C boundary,
# and panel 171 is where its rule was priced. The two laws about the hole
# became one that day so the count stayed twenty, and the laws stay of a
# length, which was the author's condition on the wording.
function zen() -> str
    return "The Zen of Heroes\n\n 1. This language begins with a tribute to David Bowie.\n 2. It is made for language models; people can read it too.\n 3. A model may have read everything; each page must still explain itself.\n 4. What the eye can see is all there is: sound and vision.\n 5. There is one way to say each thing; every program sings in the same voice.\n 6. That way may not be obvious at first; the Starman already knows it.\n 7. The semantics are familiar; the syntax is new.\n 8. Turn and face the strange: every strange choice here is deliberate.\n 9. Nothing changes behind your back; every change signs its name.\n10. Every plausible mistake must become a compile error before the program runs.\n11. Unless you mark the gap with ???: an honest hole beats a confident guess.\n12. A compile-time error is an answer; a runtime error is an ambush.\n13. An error should tell you how to fix the program. Anything less is a complaint.\n14. Repeating a word is cheap; forgetting one can cost the whole program.\n15. The specification stays small under pressure; every word must earn its place.\n16. Crashes and leaks are bugs. Ashes to ashes: what Heroes takes, it returns.\n17. When pretty code and safe code disagree, safe code wins.\n18. There is no standard library; C is the man who sold the world.\n19. Never crashing in the same car: what C might keep, Heroes assumes it keeps.\n20. We can be heroes, just for one day.\n"

function run_this() -> cli_table.Exit
    io.print_artifact(text: zen())
    return .ok_exit

## Tests

test "doctor finds this machine's toolchain, and the Zen is byte-exact"
    got = checks(build_dir: "build", runtime_hint: ok(""))

    # Six since panel 103: the clang floor row follows the clang row.
    assert got.len() == 6
    assert got[1].name == "clang floor"
    assert got[0].name == "clang"
    assert got[0].ok

    # The linker's home, on a machine whose toolchain builds every program
    # these tests build (defect 336: FAIL on the Windows box, which builds and
    # runs them, asked Linux's question).
    assert got[2].ok

    # The runtime and the cache are both real here.
    assert got[4].name == "runtime"
    assert got[4].ok
    assert got[4].detail == "runtime"
    assert got[5].ok
    assert got[5].detail == "build/ writable"

    # The Zen: twenty laws, pinned byte for byte.
    expected = "The Zen of Heroes\n\n 1. This language begins with a tribute to David Bowie.\n 2. It is made for language models; people can read it too.\n 3. A model may have read everything; each page must still explain itself.\n 4. What the eye can see is all there is: sound and vision.\n 5. There is one way to say each thing; every program sings in the same voice.\n 6. That way may not be obvious at first; the Starman already knows it.\n 7. The semantics are familiar; the syntax is new.\n 8. Turn and face the strange: every strange choice here is deliberate.\n 9. Nothing changes behind your back; every change signs its name.\n10. Every plausible mistake must become a compile error before the program runs.\n11. Unless you mark the gap with ???: an honest hole beats a confident guess.\n12. A compile-time error is an answer; a runtime error is an ambush.\n13. An error should tell you how to fix the program. Anything less is a complaint.\n14. Repeating a word is cheap; forgetting one can cost the whole program.\n15. The specification stays small under pressure; every word must earn its place.\n16. Crashes and leaks are bugs. Ashes to ashes: what Heroes takes, it returns.\n17. When pretty code and safe code disagree, safe code wins.\n18. There is no standard library; C is the man who sold the world.\n19. Never crashing in the same car: what C might keep, Heroes assumes it keeps.\n20. We can be heroes, just for one day.\n"
    assert zen() == expected
    assert run_this() == .ok_exit

# Defect 336: Windows is asked its own question, a C program compiled, linked
# and run. The probe is asked here of this machine's clang, which links on all
# three platforms these tests run on, and of a program no linker can link:
# a refusal is told in clang's own words and carries Windows' advice, never
# Linux's. Which row this machine gets is asked of the runtime, as the row is.
test "Windows' toolchain is asked a C program linked and run, and a refusal is told in the linker's own words (defect 336)"
    assert links_here(build_dir: "build", source: LINK_PROBE).must() == "clang compiled, linked and ran a C program"
    unlinkable = "int heroes_no_such_symbol_336(void);\nint main(void) { return heroes_no_such_symbol_336(); }\n"
    refused = links_here(build_dir: "build", source: unlinkable)

    match refused
        .ok _ => assert false
        .err e =>
            assert has_text(text: e.msg, needle: "clang could not link a C program: `")
            assert !has_text(text: e.msg, needle: "\r")

    row = msvc_row(refused)
    assert !row.ok
    assert has_text(text: row.detail, needle: "Microsoft.VisualStudio.Component.VC.Tools.x86.x64")
    assert !has_text(text: row.detail, needle: "build-essential")
    mine = linker_home(build_dir: "build")
    assert mine.ok

    if process.exe_suffix() == ".exe"
        assert mine.name == "MSVC"
        assert mine.detail == "clang compiled, linked and ran a C program"
    else
        assert mine.name == "xcode CLT" || mine.name == "cc"

# Defect 337 at doctor's own read: a toolchain's answer holding a byte that
# is not UTF-8 is read whole, that byte written by its value, never taken for
# silence. Two programs of a few lines answer `--version` as such a clang
# would, on every platform: the byte on a later line, then on the first. A
# `\n` they write is Windows' `\r\n` there, and reads as one line end.
test "a version answer holding a byte that is not UTF-8 is read, never taken for silence (defect 337)"
    dir = "build/selftest-doctor-337"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    answers = [
        ["later", "clang version 99.0.0\\nInstalledDir: /opt/caf\\xe9/bin\\n", "clang version 99.0.0"]
        ["first", "clang version 99.0.0 (caf\\xe9)\\nInstalledDir: /opt/bin\\n", "clang version 99.0.0 (caf<0xE9>)"]
    ]

    for answer in answers
        unit = dir + "/" + answer[0] + ".c"
        program = dir + "/" + answer[0] + process.exe_suffix()
        assert !write_file(path: unit, text: "#include <stdio.h>\nint main(void) { return fputs(\"" + answer[1] + "\", stdout) < 0; }\n").is_err()
        built = process.run(
            program: "clang",
            words: ["clang", unit, "-o", program],
            out: process.discard(),
            err: process.discard()
        )
        assert built.started && built.code == 0
        assert capture(program: program, words: [program, "--version"], build_dir: dir).must() == answer[2]

    assert !process.remove_tree(dir).is_err()

# Defect 276: a hint naming no runtime is a failed row saying what it names.
test "doctor's runtime row tells a HEROES_RUNTIME that names no runtime by what it names (defect 276)"
    got = checks(build_dir: "build", runtime_hint: ok("build/selftest-doctor-no-runtime-276"))
    assert got[4].name == "runtime"
    assert !got[4].ok
    assert got[4].detail == "`HEROES_RUNTIME` is set to `build/selftest-doctor-no-runtime-276`, and no Heroes runtime is there: no file at `build/selftest-doctor-no-runtime-276/heroes_runtime.h`; no file at `build/selftest-doctor-no-runtime-276/runtime.c`"

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
