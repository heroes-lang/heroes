# Whose mistake one of clang's refusals is (design.md §4.19, §4.17; CLAUDE.md
# §7's named exception; panel 036 rider 3). Split out of `cli/produce.hero`
# on 2026-10-05 (defect 360), when the header clang refuses on its own joined
# the readers and took that file past §11's 300 lines: `produce` decides how a
# program is produced, and this decides, once a round or the artifact was
# refused, whether the author is told on their own line at exit 1 or the
# compiler blames itself at exit 2. `build` and `--emit-c` ask it the same
# question in the same order, which stood written twice there.

use source
use token
use emit/ffi
use emit/ffi_asked
use cli/io
use cli/compile
use cli/toolchain
use cli/compiling
use cli/pointee_ask
use cli/header_ask
use cli/reach_ask
use cli/member_ask
use cli/system_paths
use cli/probing
use cli/header_refused
use cli/header_alone
use cli/macro_twice
use cli/header_order
use cli/name_order
use cli/inline_only
use cli/renamed
use cli/group_file
use cli/opening_told
use cli/caret_bytes
use cli/units
use diag
use cli/deep_types
use cli/link
use cli/package_missing

# What one refusal is read as, printing nothing (defect 2143, so a round's
# every refused unit can be read before any is told): what tells it where it
# is the author's, its verdict, and where it is the compiler's, the words
# printed as `internal error`, else "".
record Reading
    told: [diag.Diagnostic]
    verdict: ()?
    internal: str

# The verdict on a refused round or artifact, always a failure: `diagnostics`
# where the author was told, `failed` where the refusal is the compiler's, and
# then clang's words are printed as `internal error` and `refused` says what
# could not be done. Only clang's own words are read for it: a path the author
# wrote after `-o` could spell a marker, and a publish that failed there is not
# the header disagreeing with anybody. `asked` is the header's answer where the
# rounds asked it already, under these very `struct_tags`
# (`cli/tag_spelling.hero`, defect 400), so it is not asked twice; `asking`
# are the headers of the units the refusal is (`cli/probing.hero`), each
# asked its own modules' questions where it is asked.
#
# `unit_headers` are the headers the refused unit includes, in its order: a
# header clang refused there that compiles alone is told after the earlier
# one it does not compile after (`cli/header_alone.hero`, defect 557).
function of_refusal(failed: ()?, art: compile.Artifact, s: source.Source, t: toolchain.Toolchain, under: compiling.Compiling, answered: [pointee_ask.Answered], struct_tags: {str: bool}, asked: ffi_asked.Asked?, asking: [probing.Probing], unit_headers: [str], refused: str, beside: [diag.Diagnostic]) -> ()?
    read = reading(
        failed,
        art,
        s,
        t,
        under: under,
        answered: answered,
        struct_tags: struct_tags,
        asked: asked,
        asking: asking,
        unit_headers: unit_headers,
        refused: refused
    )
    return tell(read, s: s, beside: beside)

# A reading told: what it tells, then what was found beside it, staged once;
# then the compiler's own words, where the refusal is the compiler's.
function tell(read: Reading, s: source.Source, beside: [diag.Diagnostic]) -> ()?
    if read.told.len() > 0
        _ = compile.stage(with_beside(told: read.told, beside: beside), s, permissive: false).is_err()

    if read.internal != ""
        io.eprint(text: "internal error: " + read.internal)
    return read.verdict

# `of_refusal`'s reading, each class asked in its order.
function reading(failed: ()?, art: compile.Artifact, s: source.Source, t: toolchain.Toolchain, under: compiling.Compiling, answered: [pointee_ask.Answered], struct_tags: {str: bool}, asked: ffi_asked.Asked?, asking: [probing.Probing], unit_headers: [str], refused: str) -> Reading
    code = failure_code(failed)
    message = failure_message(failed) + deep_types.note(code, art.decls, art.checked, s)
    none: [diag.Diagnostic] = []

    if code != "clang" && code != link.REFUSED
        return Reading(told: none, verdict: fail(code: "failed", msg: message), internal: "")

    # A bound header clang refused on its own is the author's (defect 360),
    # told before any question is asked of the header after it. The unit's
    # headers are asked under the unit's own words (defect 572).
    words = unit_words(under, asking: asking, unit_headers: unit_headers)
    header = header_told(message, art, s, t, under: words, unit_headers: unit_headers)

    if header.len() > 0
        return authors(header, msg: "a header this program binds does not compile")

    # A function the linker found no definition of whose header defines it
    # only `inline` (defect 562, `cli/inline_only.hero`), told before the
    # reading of a missing `link` would tell it as one.
    if code == link.REFUSED
        inline = inline_only.told(message, s, art.decls, t, asking: asking)

        if inline.len() > 0
            return authors(inline, msg: "a header defines a called function only inline")

        # A symbol a header's label gave a C name (defects 591, 592,
        # `cli/renamed.hero`), which no group declares by that symbol.
        relabelled = renamed.told(message, s, art.decls, t, asking: asking)

        if relabelled.len() > 0
            return authors(relabelled, msg: "a header gives a C name a linker name nothing defines")

    # Asked only now, of a round clang refused (defect 152), unless the rounds
    # asked it already.
    answer: ffi_asked.Asked @= ffi_asked.nothing()

    if asked.is_err()
        answer @ header_ask.ask(t, art, s, struct_tags: struct_tags, asking: asking)
    else
        answer @ asked.must()

    # What each bound name's object-like macros reach, where clang found a
    # name undeclared (`cli/reach_ask.hero`, defect 2061).
    answer.reached @ reach_ask.reached(t, asking: asking, s: s, decls: art.decls, message: message)

    # Where the header has a field a record names only inside another
    # member, where clang found no such member (`cli/member_ask.hero`,
    # defect 2062).
    answer.nested @ member_ask.nested(t, asking: asking, s: s, decls: art.decls, message: message)

    # A name told absent from a header that declares it read alone is retold
    # with the move of a group that reads it so (panel 204's R3,
    # `cli/name_order.hero`).
    theirs: [diag.Diagnostic] @= []

    for d in explained(message, art, s, answered, struct_tags: struct_tags, asked: answer)
        theirs @ theirs.push(name_order.unknown(d, s, art.decls, t, under: words, unit_headers: unit_headers))

    if theirs.len() > 0
        return authors(theirs, msg: "the author's extern disagrees with the header")

    # A package's `-l` the linker found no library for, asked after every
    # `link` group was (`cli/package_missing.hero`, defect 528).
    if code == link.REFUSED
        lacked = package_missing.missing(
            message: message,
            s: s,
            decls: art.decls,
            build: t.build,
            linked: under.package_flags
        )

        if lacked.len() > 0
            return authors(lacked, msg: "a package names a library this machine does not have")

    # What no reader of clang's words named is the headers' where the unit's
    # opening is refused with them and compiles without them, told on the
    # first group whose header the opening refuses in their order
    # (`cli/opening_told.hero`, panel 214's R2): asked last, so every class
    # above keeps its words.
    if code != link.REFUSED
        late = opening_told.told(art, s, t, under: words, unit_headers: unit_headers)

        if late.len() > 0
            return authors(
                system_paths.shown(t, under: words, told: late),
                msg: "a header this program binds does not compile"
            )

    # A unit clang refused carries its own path inside the message
    # (`units.tu_object`), the fused test unit's included. A link the linker
    # refused is not C clang refused (defect 443).
    if code == link.REFUSED
        return Reading(
            told: none,
            verdict: fail(code: "failed", msg: "the linker refused the objects clang compiled"),
            internal: message
        )
    return Reading(told: none, verdict: fail(code: "failed", msg: refused), internal: message)

# A refusal that is the author's, told by `tell`.
function authors(told: [diag.Diagnostic], msg: str) -> Reading
    return Reading(told: told, verdict: fail(code: "diagnostics", msg: msg), internal: "")

# Whether a clang failure is the AUTHOR's: `emit/ffi.hero` reads its marker
# lines back into diagnostics on the `.hero` line, prints them, and the answer
# is yes (CLAUDE.md §7's named exception). One door for the package that could
# not answer and the unit clang refused — the same eleven lines twice, before.
function blamed(message: str, art: compile.Artifact, s: source.Source, answered: [pointee_ask.Answered], struct_tags: {str: bool}, asked: ffi_asked.Asked) -> bool
    theirs = explained(message, art, s, answered, struct_tags: struct_tags, asked: asked)

    if theirs.len() == 0
        return false
    _ = compile.stage(theirs, s, permissive: false).is_err()
    return true

# What `emit/ffi.hero` reads back from clang's words, on the `.hero` lines.
function explained(message: str, art: compile.Artifact, s: source.Source, answered: [pointee_ask.Answered], struct_tags: {str: bool}, asked: ffi_asked.Asked) -> [diag.Diagnostic]
    return ffi.explain(
        message,
        s,
        art.tree,
        art.decls,
        art.checked,
        art.program,
        word_bits: io.word_bits(),
        answered: answered,
        struct_tags: struct_tags,
        asked: asked
    )

# The words the refused unit compiled under: the probing's whose headers are
# the unit's, its packages those of the groups naming its headers (defect
# 572), else the build's.
function unit_words(under: compiling.Compiling, asking: [probing.Probing], unit_headers: [str]) -> compiling.Compiling
    for one in asking
        if one.headers == unit_headers
            return one.under

    return under

# What tells clang's refusal as a header a group binds that does not compile
# (`cli/header_refused.hero`, defect 360), on the group's string; nothing
# where the refusal is not that.
function header_told(message: str, art: compile.Artifact, s: source.Source, t: toolchain.Toolchain, under: compiling.Compiling, unit_headers: [str]) -> [diag.Diagnostic]
    # The refused unit, compiled again once where a reader asks the name
    # under one of clang's carets (`cli/caret_bytes.hero`, defect 2117).
    again: caret_bytes.Again @= caret_bytes.of(
        words: compiling.unit_words(under),
        unit: units.generated_at(message),
        dir: t.build + "/order"
    )

    # A macro two groups' headers define two ways (panel 204's R2).
    macro = macro_twice.told(message, s, art.decls, t, under: under, unit_headers: unit_headers, @again)

    if macro.len() > 0
        return macro
    refusal: [diag.Diagnostic] @= header_refused.refused(
        stderr: message,
        s: s,
        decls: art.decls,
        runtime: t.runtime,
        @again
    )

    if refusal.len() == 0
        return refusal

    # A header refused on its own that compiles alone is two headers'
    # refusal, the earlier named (defect 557).
    alone = header_refused.refused_alone(stderr: message, s: s, decls: art.decls, runtime: t.runtime, @again)

    if !alone.is_err()
        before = header_alone.earlier(t, under: under, header: alone.must().header, headers: unit_headers)

        if !before.is_err()
            other = group_file.group_of(s, art.decls, path: before.must())

            if !other.is_err()
                refusal @ header_refused.refused_after(
                    stderr: message,
                    s: s,
                    decls: art.decls,
                    runtime: t.runtime,
                    earlier: other.must(),
                    @again
                )

    # What the program needs instead of a repair, where clang says an order
    # of its groups or a header before it compiles (panel 204's R3).
    told: [diag.Diagnostic] @= []

    for d in refusal
        told @ told.push(header_order.refused(d, s, art.decls, t, under: under, unit_headers: unit_headers))

    # A file of the C library or the toolchain named as an include names it
    # (`cli/system_paths.hero`, defect 2047).
    return system_paths.shown(t, under: under, told: told)

# What a refusal is told with, then what the value probe found beside it
# (`cli/value_beside.hero`, defect 2128), as one list: one staging, so a
# blank line stands between every two of them as between any two. A finding
# at a span the refusal already tells is dropped, so one constant is told
# once (panel 225, the ffi-pragmatist's): a constant clang refused at a place
# `value_beside.holding` does not locate stays in the probe's copy.
function with_beside(told: [diag.Diagnostic], beside: [diag.Diagnostic]) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= told

    for d in beside
        if !tells(told, d: d)
            out @ out.push(d)

    return out

# Whether `told` holds a diagnostic at `d`'s own span.
function tells(told: [diag.Diagnostic], d: diag.Diagnostic) -> bool
    for one in told
        if one.span.start == d.span.start && one.span.end == d.span.end
            return true

    return false

# The message of a failed `()?`.
function failure_message(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# Which verdict a failure is: `clang` for clang's refusal and nothing else
# (`toolchain.run_clang`), so the words below it are chosen by the code.
function failure_code(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

## Tests

test "a probe's finding at a span the refusal tells is dropped, and one elsewhere follows the refusal"
    at_k = token.Span(start: 40, end: 59)
    elsewhere = token.Span(start: 80, end: 99)
    told = [diag.new_diagnostic(code: "ffi_constant_type", message: "the refusal's words", span: at_k)]
    beside = [
        diag.new_diagnostic(code: "ffi_constant_type", message: "the probe's words", span: at_k)
        diag.new_diagnostic(code: "ffi_constant_type", message: "another constant", span: elsewhere)
    ]
    out = with_beside(told: told, beside: beside)
    assert out.len() == 2
    assert out[0].message == "the refusal's words"
    assert out[1].message == "another constant"
