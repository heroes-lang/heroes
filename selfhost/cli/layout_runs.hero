# The clang runs the layout check makes, and what each keeps (design.md
# §4.19, §1.12; panel 186): the record-layout dump, the check unit's verdict,
# and the line every run is given. What is asked and why is
# `cli/layout.hero`; the lock question that reads the same dump is
# `cli/locks.hero` (panel 215's R2). Split out of `cli/layout.hero` on
# 2026-10-16, when panel 215's landing took that file past CLAUDE.md §11's
# ceiling: deciding what to ask stayed there, running clang came here.
#
# **What is kept is clang's answers, never this compiler's reading of them**,
# each under the digest of the unit that asked: a compiler that writes a unit
# differently never reads another's answer. **A dump over `KEPT_DUMP` bytes is
# not kept at all**, and is asked of clang again on the next build: over a
# deep by-value nest it is cubic in the depth (panel 186's critic, 348 MB at
# a thousand), and keeping only its asked rows was measured to be a stale
# reading, a changed reader taking another's kept rows for its own
# (2026-10-02).

use ast
use source
use check/state
use emit/extern_union
use cli/toolchain
use cli/process
use cli/publish
use cli/response_file
use cli/digest
use cli/pointee
use cli/strings
use cli/read_back
use cli/kept

# The largest dump kept under `build/`, in bytes: every real header measured
# for panel 186 dumps far below it (`SDL3/SDL.h`, whole, 30 KB), and a
# synthetic nest of three hundred structs passes it (10 MB).
constant KEPT_DUMP: i64
    4194304

# Everything one check asks with.
record Asking
    t: toolchain.Toolchain
    dir: str
    headers: [str]
    s: source.Source
    decls: [ast.Decl]
    c: state.Checked
    u: extern_union.Used
    # Every word the three runs compile under but each run's own
    # (`compiling.probe_words`), the list the key names.
    words: [str]

# clang's record-layout dump for the unit, or absent when it did not compile.
function dump(a: Asking, dump_text: str) -> str?
    dump_c = pointee.unit_path(dir: a.dir, stem: "dump", text: dump_text)
    publish.write_whole(path: dump_c, text: dump_text, keyed: true)?
    out_path = publish.private_name(a.dir + "/dump.txt")
    err_path = publish.private_name(a.dir + "/dump-stderr.txt")
    line: [str] @= ["clang", "-fsyntax-only", "-Xclang", "-fdump-record-layouts"]
    line @ searched(a, line: line)
    line @ line.push(dump_c)
    ran = process.run(program: "clang", words: line, out: out_path, err: err_path)

    # The dump names an anonymous member by where it stands, `(anonymous at
    # <file>:5:32)`, the file as clang was given it: read back as the screen
    # is (defect 337), the same byte written the same way at every mention.
    dumped_text = read_back.words(out_path)
    publish.discard(out_path)
    publish.discard(err_path)

    if !ran.started || ran.code != 0 || dumped_text.is_err()
        return fail(code: "unread", msg: "the dump did not compile")
    return ok(dumped_text.must())

# The dump of `dump_text`'s records: read from where it was kept, under the
# screen's `sum` and the unit's digest, or asked of clang and kept there when
# it is no larger than `KEPT_DUMP`; absent when it did not compile. The one
# place a dump is kept: the layout check and the lock question
# (`cli/locks.hero`) ask the same unit of the same records first, and the
# second reads the first's answer rather than running clang again.
function kept_dump(a: Asking, sum: str, dump_text: str) -> str?
    kept_path = a.dir + "/clang-dump-" + sum + "-" + digest.digest(dump_text) + ".txt"
    known = kept.read(kept_path)

    if !known.is_err()
        return known
    made = dump(a, dump_text: dump_text)

    if !made.is_err() && made.must().len() <= KEPT_DUMP
        kept.write(path: kept_path, text: made.must())?
    return made

# The check unit's verdict, kept under the digest of its own text: a compiler
# that writes the assertions differently never reads another's answer.
function judged(a: Asking, sum: str, text: str) -> ()?
    if text.len() == 0
        return ok()
    verdict = a.dir + "/verdict-" + sum + "-" + digest.digest(text) + ".txt"
    known = kept.read(verdict)

    if !known.is_err()
        if known.must() == "ok\n"
            return ok()
        return fail(code: "clang", msg: known.must())
    check_c = pointee.unit_path(dir: a.dir, stem: "check", text: text)
    publish.write_whole(path: check_c, text: text, keyed: true)?
    err_path = publish.private_name(a.dir + "/check-stderr.txt")
    line: [str] @= ["clang", "-fsyntax-only", "-ferror-limit=0"]
    line @ searched(a, line: line)
    line @ line.push(check_c)

    # A header's warning in what clang says is the program's own compile's to
    # tell, as the pointee check's is (defect 248).
    checked = toolchain.asked_of_clang(
        line: line,
        what: "checking the header's layout of the group records",
        err_path: err_path
    )
    publish.discard(err_path)
    said: str @= "ok\n"

    match checked
        .ok _ => said @ "ok\n"
        .err e =>
            if e.code != "clang"
                return fail(code: e.code, msg: e.msg)
            said @ e.msg

    kept.write(path: verdict, text: said)?

    if checked.is_err()
        return fail(code: "clang", msg: said)
    return ok()

# The line with the probe's words after it, carried in a file (defect 586,
# `response_file.carried`): a package's compile words are among them.
function searched(a: Asking, line: [str]) -> [str]
    return response_file.carried(line: strings.with_all(list: line, more: a.words), dir: a.dir)
