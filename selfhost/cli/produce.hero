# How a program becomes a binary: the whole pipeline from a parsed
# source to a linked executable, and the record that carries what came
# out of it.
#
# Split out of `cli_verbs` at M-argv-execution, along a seam that names
# a concern rather than at a line count. `cli_verbs` answers *what the
# author typed* — build, run, test — and this answers *how a program is
# produced*, which all three of those verbs ask for and none of them
# owns. The arrows already pointed one way, which is the only condition
# under which a seam exists here: Heroes refuses module cycles whatever
# the edge carries.

use source
use module/names as module_names
use modules
use emit/ffi
use cli/io
use cli/compile
use cli/toolchain
use cli/process
use cli/units
use cli/pointee
use emit/unit
use emit/members
use cli/libraries

record Produced
    binary: str
    tests: [str]
    stopped: bool

# The glue from a translation unit to a binary on disk: the cache
# directory, the C written beside its object, the runtime object, the
# link — and on a link failure, THE ONE DECISION §7 names: emit_ffi
# explains the stderr, and a verdict about the author's extern exits 1
# on their line where everything else stays internal error at 2.
# Whether this failure would otherwise reach the reader as nothing at
# all. The two codes below carry their own printed output; anything else
# is a stage failing without naming itself, which cost four rounds of CI
# to locate on a platform where it happens.
function silent_code(art: compile.Artifact?) -> bool
    match art
        .ok    => return false
        .err e => return e.code != "diagnostics" && e.code != "unsupported"

function failure_of(art: compile.Artifact?) -> str
    match art
        .ok    => return ""
        .err e => return e.code + " — " + e.msg

function produce(path: str, s: source.Source, options: compile.Options, t: toolchain.Toolchain, version: str) -> Produced?
    art = compile.to_unit(s, options, version: version)

    # **A failure here used to be propagated without a word.** `_ = art?`
    # hands the error up and `exit_of` prints nothing when its code is
    # `diagnostics`, on the grounds that those were printed where they
    # were found — which is true of the frontend's and not of a failure
    # in the emission. On Darwin and Linux this path does not fail, so
    # the silence was invisible; on Windows `heroes build --emit-c`
    # exited 1 with an empty log, and four rounds of CI went into
    # finding out which of five stages it died in.
    #
    # A message that repeats a diagnostic the reader has already seen
    # costs one line. A stage that fails without naming itself costs an
    # afternoon.
    # Only for a code nobody has printed. `diagnostics` and `unsupported`
    # were both reported where they were found, with their source lines
    # and their `#~` annotations, and repeating them here would put a
    # second copy in front of the reader — measured: eight golden cases
    # in `unsupported/` compare the whole of stderr, and they caught it.
    if art.is_err()
        if silent_code(art)
            io.eprint(text: "error while emitting " + s.name + ": " + failure_of(art))
        _ = art?

    if art.must().stopped
        none_t: [str] = []
        return ok(Produced(binary: "", tests: none_t, stopped: true))
    module = module_names.module_of(s.name)
    level_key: str @ options.level
    is_tests: bool @ false

    match options.target
        .tests_build =>
            level_key @ options.level + "+tests"
            is_tests @ true
        .program_build => is_tests @ is_tests

    dir = toolchain.dir_for(
        t,
        source_name: s.name,
        text: s.text,
        level_key: level_key,
        sanitize: options.sanitize,
        search: compile.search_key(headers_from: options.headers_from, library: options.library)
    )

    if dir.is_err()
        io.eprint(text: "error: cannot create the build directory")
        return fail("failed", "no build directory")
    c_file = dir.must() + "/" + module + ".c"

    # Written only where it is compiled: the fused unit is the test
    # binary's, and a program build writes one .c per module instead
    # (units.tu_object). It used to be written on both paths, which
    # put 785,323 dead lines on disk for every build of the compiler.
    if is_tests
        written = write_file(path: c_file, text: art.must().c)

        if written.is_err()
            io.eprint(text: "error: cannot write " + c_file)
            return fail("failed", "cannot write the unit")
    object = toolchain.runtime_object(t, level: options.level, sanitize: options.sanitize)

    if object.is_err()
        io.eprint(text: "internal error: the runtime did not compile")
        return fail("failed", "no runtime object")
    binary: str @ dir.must() + "/" + module + process.exe_suffix()

    if !options.output.is_err()
        binary @ options.output.must()

    # Asked before clang runs, so a package that is not installed is
    # reported as itself rather than as a header clang could not find.
    package_flags = libraries.resolve_packages(art.must().packages, build_dir: t.build)

    if package_flags.is_err()
        # **A package failure is the AUTHOR's, so it goes through the same
        # ffi mapping a clang failure does.** The bootstrap asks
        # `resolve_packages` from INSIDE toolchain::link, so its marker
        # text arrives at `explain` with everything else; the port asks it
        # here, one call earlier, and the message used to be printed raw.
        # Measured 2026-08-18 by tests/harness on
        # `unsupported/ffi-records-only-group-cannot-claim-its-package`:
        # the terminal got `heroes-ffi-package ...` and four bare lines —
        # no code, no `at file:line:col`, no source snippet, no notes,
        # which is every part of §4.17 at once, in the one class where the
        # compiler is allowed to blame the author's own `extern` (§7).
        message = failure_text(package_flags)
        theirs = ffi.explain(
            message,
            s,
            art.must().tree,
            art.must().decls,
            art.must().checked,
            art.must().program,
            word_bits: io.word_bits()
        )

        if theirs.len() > 0
            _ = compile.stage(theirs, s)
            return fail("diagnostics", "the package could not answer")
        io.eprint(text: message)
        return fail("diagnostics", "the package could not answer")
    names: [str] @ []

    for name in art.must().link
        if !libraries.in_the_c_runtime(library: name)
            names @ names.push(name)

    # The source's own directory, so extern "mylib.h" finds a header
    # beside the .hero file — the unit lives under build/<hash>/ and
    # an angled include never searches the source's directory. An
    # empty parent is the current directory, not the absence of one.
    source_dir: str @ modules.open_directory(path)

    if source_dir.len() == 0
        source_dir @ "."

    # What the extern out-parameters point at, asked of the header before
    # any unit compiles (panel 103): the width and sign of a numeric `@`
    # against the header's own type. A failure here is the AUTHOR's, and it
    # rides the same mapping a clang failure does, below — `emit/ffi.hero`
    # reads the assertion's marker back into the parameter's diagnostic.
    linked: ()? @ pointee.check(
        t,
        art.must().program,
        art.must().checked,
        s,
        art.must().decls,
        search_include: options.headers_from,
        package_flags: package_flags.must(),
        source_dir: source_dir
    )

    if !linked.is_err()
        if is_tests
            # A test binary keeps the fused unit: `heroes test` compiles
            # once and runs per block, and the fused path is the artifact
            # path the blessed emissions pin.
            linked @ toolchain.link(
                t,
                c_file: c_file,
                object: object.must(),
                binary: binary,
                level: options.level,
                sanitize: options.sanitize,
                source_dir: source_dir,
                search_include: options.headers_from,
                search_library: options.library,
                package_flags: package_flags.must(),
                link_names: names
            )
        else

            # One .c per module (panel 093): each TU compiled to its own
            # cached object, every dirty TU before any verdict (R5), one
            # link over all of them re-run every build.
            root = module_names.module_of(s.name)
            objects: [str] @ [object.must()]
            stopped: ()? @ ok()

            # The whole-program tables, built once for the whole build
            # rather than once per TU. They are functions of the program,
            # so 157 modules used to buy 157 identical answers — and the
            # arena walk and the content hashing behind them is what made
            # the per-module self-build take longer than the fused one.
            whole = members.whole_of(art.must().program, c: art.must().checked, s: s, decls: art.must().decls)

            # One build's answers about files on disk. Every TU asks whether
            # the headers it read still say the same thing, and 157 of them
            # share almost all of those headers — so the map is threaded
            # through the loop rather than rebuilt per unit.
            memo: {str: str} @ {}

            for component in units.components(s)
                tu_text = unit.unit(
                    module: component,
                    p: art.must().program,
                    c: art.must().checked,
                    s: s,
                    decls: art.must().decls,
                    version: version,
                    is_root: component == root,
                    whole: whole
                )
                made = units.tu_object(
                    t,
                    module: component,
                    tu_text: tu_text,
                    level: options.level,
                    sanitize: options.sanitize,
                    search: compile.search_key(headers_from: options.headers_from, library: options.library),
                    package_flags: package_flags.must(),
                    source_dir: source_dir,
                    search_include: options.headers_from,
                    @memo
                )

                if made.is_err()
                    if stopped.is_err()
                        stopped @ stopped
                    else
                        stopped @ carry_failure(made)
                else
                    objects @ objects.push(made.must())

            if stopped.is_err()
                linked @ stopped
            else
                linked @ units.link_objects(
                    t,
                    objects: objects,
                    binary: binary,
                    level: options.level,
                    sanitize: options.sanitize,
                    search_include: options.headers_from,
                    search_library: options.library,
                    package_flags: package_flags.must(),
                    link_names: names
                )

    if linked.is_err()
        # Some clang failures are the AUTHOR's, and the ffi mapping is
        # the only place that decides which (panel 036 rider 3). The
        # pipeline pieces ride in the Artifact for exactly this call.
        message = unit_failure_text(linked)
        theirs = ffi.explain(
            message,
            s,
            art.must().tree,
            art.must().decls,
            art.must().checked,
            art.must().program,
            word_bits: io.word_bits()
        )

        if theirs.len() > 0
            _ = compile.stage(theirs, s)
            return fail("diagnostics", "the author's extern disagrees with the header")
        io.eprint(text: "internal error: " + message)

        if is_tests
            # The per-module branch carries the failing TU's own path
            # inside the message; only the fused test build still needs
            # this line, and pointing at the fused unit after a TU
            # failure would name a file clang never refused.
            io.eprint(text: "the generated C is at " + c_file)
        return fail("failed", "clang refused the generated C")
    return ok(Produced(binary: binary, tests: art.must().tests, stopped: false))

# The failure's message, out of a fallible that is known to be err.
function failure_text(failed: [str]?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

function unit_failure_text(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# A TU object's failure, re-shaped for the link result the caller
# reads: same code (the exit), same message (clang's words, which the
# ffi mapping reads).
function carry_failure(failed: str?) -> ()?
    match failed
        .ok    => return ok()
        .err e => return fail(e.code, e.msg)
