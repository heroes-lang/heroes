# How a program becomes a binary: the whole pipeline from a parsed
# source to a linked executable, and the record that carries what came
# out of it.
#
# Split out of `cli_verbs` at M-argv-execution, along a seam that names
# a concern rather than at a line count. `cli_verbs` answers *what the
# author typed* — build, run, test — and this answers *how a program is
# produced*, which all three of those verbs ask for and none of them
# owns. The arrows already pointed one way, which is the only condition
# under which a seam exists here: Heroes refuses module cycles whatever
# the edge carries.
#
# Split again on 2026-09-15 (defect 037): the compile-and-link half is
# `cli/assemble.hero`, one ROUND, because this file now asks for a round
# twice when clang's refusal of a handle's tag says the header needs
# `struct` in front of it. What stays here is what decides: the cache
# directory, the runtime object, the package question and the rounds. Whose
# mistake a refused round is went to `cli/whose.hero` on 2026-10-05 (defect
# 360), the question both verbs that compile ask once it fails; the rounds
# themselves to `cli/rounds.hero` on 2026-10-10 (panel 202), once each asked
# every module's headers apart.

use source
use modules
use emit/ffi_asked
use emit/externs as emit_externs
use cli/io
use cli/compile
use cli/toolchain
use cli/pointee_ask
use cli/clang_floor
use cli/artifact
use cli/assemble
use cli/rounds
use cli/probing
use cli/units
use cli/libraries
use cli/input
use cli/process
use cli/whose
use library_source
use cli/kept
use cli/publish
use bytes

record Produced
    binary: str
    tests: [str]
    stopped: bool

# The glue from a translation unit to a binary on disk: the cache
# directory, the C written beside its object, the runtime object, the
# link — and on a link failure, THE ONE DECISION §7 names: emit_ffi
# explains the stderr, and a verdict about the author's extern exits 1
# on their line where everything else stays internal error at 2.
# Whether this failure would otherwise reach the reader as nothing at
# all. The two codes below carry their own printed output; anything else
# is a stage failing without naming itself, which cost four rounds of CI
# to locate on a platform where it happens.
function silent_code(art: compile.Artifact?) -> bool
    match art
        .ok    => return false
        .err e => return e.code != "diagnostics" && e.code != "unsupported"

function failure_of(art: compile.Artifact?) -> str
    match art
        .ok    => return ""
        .err e => return e.code + " — " + e.msg

function produce(path: str, s: source.Source, options: compile.Options, t: toolchain.Toolchain, version: str) -> Produced?
    # The clang floor, once per build and before anything is emitted
    # (panel 103, author instruction): an older clang is exit 2 with the
    # version found and the floor, not a wrong verdict later. Checked on the
    # banner of the one answer `toolchain.locate_toolchain` asked clang for,
    # the answer every cache key carries (defect 122), so the floor and the
    # keys are one clang's word and not two processes'.
    floor = clang_floor.check(t.compiler_banner)

    if floor.is_err()
        io.eprint(text: "error: " + whose.failure_message(floor))
        return fail(code: "failed", msg: "clang is below the floor")
    art = compile.to_unit(s, options, version: version)

    # **A failure here used to be propagated without a word.** `_ = art?`
    # hands the error up and `exit_of` prints nothing when its code is
    # `diagnostics`, on the grounds that those were printed where they
    # were found — which is true of the frontend's and not of a failure
    # in the emission. On Darwin and Linux this path does not fail, so
    # the silence was invisible; on Windows `heroes build --emit-c`
    # exited 1 with an empty log, and four rounds of CI went into
    # finding out which of five stages it died in.
    #
    # A message that repeats a diagnostic the reader has already seen
    # costs one line. A stage that fails without naming itself costs an
    # afternoon.
    # Only for a code nobody has printed. `diagnostics` and `unsupported`
    # were both reported where they were found, with their source lines
    # and their `#~` annotations, and repeating them here would put a
    # second copy in front of the reader — measured: eight golden cases
    # in `unsupported/` compare the whole of stderr, and they caught it.
    if art.is_err()
        if silent_code(art)
            io.eprint(text: "error while emitting " + s.name + ": " + failure_of(art))
        _ = art?

    if art.must().stopped
        none_t: [str] = []
        return ok(Produced(binary: "", tests: none_t, stopped: true))

    # Panel 188's guard: a group head's name no tool carries is the compiler's.
    unjudged = emit_externs.unjudged(art.must().program, s, art.must().decls)

    if unjudged.len() > 0
        io.eprint(text: "internal error: a group head's name was never judged\n  " + unjudged)
        return fail(code: "failed", msg: "a group head's name reached the tools unjudged")

    # Where the binary lands is the round's to learn, from the link line it
    # runs (`link.link_objects`), and the C of every unit is written where
    # it is compiled (`units.tu_object`). Both used to live under
    # `build/<hash>/`, a hash of the source alone, computed here.
    object = toolchain.runtime_object(t, level: options.level, sanitize: options.sanitize)

    # **The runtime did not compile only where clang said so** (defect 134):
    # this line was printed for every failure, a publish that met another
    # build's object included, five builds in six started together on a cold
    # `build/`, and clang's own words were never printed at all. Any other
    # failure is the machine's, said as itself: the path and the reason.
    if object.is_err()
        if path_code(object) == "clang"
            io.eprint(text: "internal error: the runtime did not compile\n" + failure_note(object))
            return fail(code: "failed", msg: "no runtime object")
        return fail(code: "failed", msg: failure_note(object))

    # What the header said each `@` parameter points at (defect 010): filled
    # by the pointee check inside the round, empty for the package failure
    # explained first, since no pointee has been asked about yet.
    answered: [pointee_ask.Answered] @ []

    # Asked before clang runs, so a package that is not installed is
    # reported as itself rather than as a header clang could not find.
    package_flags = libraries.resolve_packages(art.must().packages, build_dir: t.build)
    no_tags: {str: bool} = {}

    if package_flags.is_err()
        # **A package failure is the AUTHOR's, so it goes through the same
        # ffi mapping a clang failure does.** The bootstrap asks
        # `resolve_packages` from INSIDE toolchain::link, so its marker
        # text arrives at `explain` with everything else; the port asks it
        # here, one call earlier, and the message used to be printed raw.
        # Measured 2026-08-18 by tests/harness on
        # `unsupported/ffi-records-only-group-cannot-claim-its-package`:
        # the terminal got `heroes-ffi-package ...` and four bare lines —
        # no code, no `at file:line:col`, no source snippet, no notes,
        # which is every part of §4.17 at once, in the one class where the
        # compiler is allowed to blame the author's own `extern` (§7).
        message = failure_text(package_flags)

        if whose.blamed(message, art.must(), s, answered, struct_tags: no_tags, asked: ffi_asked.nothing())
            return fail(code: "diagnostics", msg: "the package could not answer")
        io.eprint(text: message)
        return fail(code: "diagnostics", msg: "the package could not answer")
    names: [str] @ []

    for name in art.must().link
        if !libraries.in_the_c_runtime(library: name)
            names @ names.push(name)

    # The source's own directory, so extern "mylib.h" finds a header
    # beside the .hero file — the unit lives under build/<hash>/ and
    # an angled include never searches the source's directory. An
    # empty parent is the current directory, not the absence of one.
    source_dir: str @ modules.open_directory(path)

    if source_dir.len() == 0
        source_dir @ "."
    site = assemble.Site(
        object: object.must(),
        output: options.output,
        link: !art.must().emit_c,
        source_dir: source_dir,
        link_names: names,
        package_flags: package_flags.must(),
        version: version
    )
    under = assemble.compiled_under(t, options, site)

    # THE ROUNDS (`cli/rounds.hero`; defect 037, panel 152 R1): each asks every
    # module's headers its questions, then compiles and links, and runs again
    # where clang asked `struct` for a handle's tag. What a build settles
    # before any of them, each module's plan and the probes of their headers,
    # is planned once (panel 202's C0, `cli/probing.hero`).
    planned = probing.planned(
        t,
        under: under,
        art.must().program,
        art.must().checked,
        s,
        art.must().decls,
        components: units.components(s),
        target: options.target
    )
    went = rounds.run(t, options, art.must(), s, site, under: under, planned: planned, answered: @answered)

    if went.verdict.is_err()
        return fail(code: whose.failure_code(went.verdict), msg: whose.failure_message(went.verdict))

    # **`--emit-c` WRITES AFTER THE ROUNDS, WHICH COMPILE AND DO NOT LINK FOR
    # IT** (panel 157 R1; defect 049, 2026-09-17). It sat above them until then,
    # so the artifact was the bare spelling clang had just refused, and a program
    # this machine cannot build got yesterday's C at exit 0 where `build` said
    # `ffi_missing_header` at exit 1. Now one refusal above answers both verbs.
    if art.must().emit_c
        wrote = artifact.write_c(
            t,
            options,
            art.must(),
            s,
            answered: @answered,
            probings: planned.probings,
            struct_tags: went.struct_tags,
            version: version
        )

        if wrote.is_err()
            refused = whose.of_refusal(
                wrote,
                art.must(),
                s,
                t,
                under: under,
                answered: answered,
                struct_tags: went.struct_tags,
                asked: went.asked,
                asking: planned.probings,
                unit_headers: emit_externs.headers(art.must().program, s, art.must().decls),
                refused: "the artifact was not written"
            )
            return fail(code: whose.failure_code(refused), msg: whose.failure_message(refused))
        none_e: [str] = []
        return ok(Produced(binary: "", tests: none_e, stopped: true))
    return ok(Produced(binary: went.binary, tests: art.must().tests, stopped: false))

# The failure's message, out of a fallible that is known to be err.
function failure_text(failed: [str]?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# The message of a failed `()?` and its code, the clang floor's and the
# round's alike, are `cli/whose.hero`'s, which reads both of a refusal.

function path_code(failed: str?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

function failure_note(failed: str?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

## Tests

# A build that cannot put its binary or its C where the author asked,
# with every other step fine: the failure names the path and says why, and
# is not worded as clang refusing anything (defect 134). Before, a publish
# that failed was `internal error: cannot publish` and then `error: clang
# refused the generated C`, where clang had refused nothing.
test "a failure that is not clang's refusal is not worded as one (defect 134)"
    library = library_source.text()
    assert !write_file(path: "build/selftest_words.hero", text: "function main()\n    print(1)\n").is_err()
    s = input.read_compilation(path: "build/selftest_words.hero", library: library).must()
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-words").must()
    none: [str] = []
    assert !process.remove_tree("build/selftest-no-such-directory").is_err()

    for emit_c in [false, true]
        options = compile.Options(
            level: "-O0",
            dump_ir: false,
            emit_c: emit_c,
            output: ok("build/selftest-no-such-directory/out"),
            sanitize: false,
            target: .program_build,
            headers_from: none,
            library: none
        )
        made = produce(path: "build/selftest_words.hero", s: s, options: options, t: t, version: "0.0.0-port")
        said = produced_failure(made)

        # `failed` is exit 2 at the verb (`verbs.exit_of`): the tool could
        # not do its work, which is what cli-surface.md gives that number.
        assert produced_code(made) == "failed"
        assert said != "clang refused the generated C"

        # One sentence for the author's file whichever verb writes it (defect
        # 136, `publish.landing_for`), where the C said the operating
        # system's number for a missing directory and the link said this.
        # The binary's path takes the platform's suffix where the C's does
        # not (defect 359): `out.exe` on Windows, the file that would be.
        landed: str @ "build/selftest-no-such-directory/out"

        if !emit_c
            landed @ landed + process.exe_suffix()
        assert said == "cannot write " + landed + ": its directory is not there; " + landed + " was not created"

function produced_failure(made: Produced?) -> str
    match made
        .ok    => return ""
        .err e => return e.msg

function produced_code(made: Produced?) -> str
    match made
        .ok    => return ""
        .err e => return e.code

# DEFECT 357's CASE: what a power cut left under `build/`, each kept text of a
# program's checks zeroed at its length as the Windows box's crash left eleven
# (one NUL is `surface-fixtures/notext357/one-nul.txt`, since no literal holds
# one), the records that name them left whole. Before the repair the pointee
# check's verdict said `internal error` over NULs at exit 2, and the layout
# check's screen built at exit 0 a construction leaving out a field; a unit's
# warnings replayed as NULs. Each kept text is now asked again and kept whole.
test "kept texts a power cut zeroed are asked again, and the author's mistake is told as before (defect 357)"
    library = library_source.text()
    dir = "build/selftest-zeroed-357"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    assert !write_file(path: dir + "/p.h", text: "#include <stdint.h>\n#warning \"a header warning\"\nvoid fill(int64_t *out);\ntypedef struct { int32_t kind; int32_t x; } SA;\nstatic inline int32_t sa_x(SA s) { return s.x; }\nstatic inline int64_t six(void) { return 6; }\n").is_err()
    pointee_wrong = "extern \"p.h\"\n    function fill(@out: i32)\n\nfunction main()\n    n: i32 @ 0\n    fill(@n)\n    print(n)\n"
    field_left_out = "extern \"p.h\"\n    record SA\n        kind: i32\n        x: i32\n    function sa_x(s: SA) -> i32\n\nfunction main()\n    b = SA(kind: 2)\n    print(sa_x(b))\n"
    warned = "extern \"p.h\"\n    function six() -> i64\n\nfunction main()\n    print(six())\n"
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-zeroed").must()
    each: i64 @ 0
    nul = read_file("tests/golden/surface-fixtures/notext357/one-nul.txt").must()
    none: [str] = []
    options = compile.Options(
        level: "-O0",
        dump_ir: false,
        emit_c: false,
        output: ok(dir + "/out"),
        sanitize: false,
        target: .program_build,
        headers_from: none,
        library: none
    )

    # Each program its own `build/`, so what one zeroes the next does not.
    for program in [pointee_wrong, field_left_out, warned]
        each @ each + 1
        t.build @ dir + "/build-" + each.to_str()
        path = dir + "/p.hero"
        assert !write_file(path: path, text: program).is_err()
        s = input.read_compilation(path: path, library: library).must()
        first = produced_code(produce(path: path, s: s, options: options, t: t, version: "0.0.0-port"))
        zeroed: i64 @ 0

        for file in process.files_under(t.build).must()
            if zeroable(file)
                size = read_file(file).must().len()
                assert !write_file(path: file, text: nul.repeat(size.to_u64().must())).is_err()
                zeroed @ zeroed + 1

        assert zeroed > 0
        assert produced_code(produce(path: path, s: s, options: options, t: t, version: "0.0.0-port")) == first

        # Asked again, and kept whole again.
        for file in process.files_under(t.build).must()
            if zeroable(file)
                assert !kept.read(file).is_err()

    assert !process.remove_tree(dir).is_err()

# A kept text, by the name its writer gives it: a check's verdict, the layout
# check's screen and its record-layout dump, the pointee check's dump, a
# unit's warnings. A record, `.deps.txt`, is not one: it is left whole so the
# kept texts it names are the ones read.
function zeroable(file: str) -> bool
    base = publish.base_of(file)

    for start in ["verdict-", "screen-", "clang-dump-", "dump-", "warnings-"]
        if bytes.bytes_at(text: base, at: 0, needle: start) && (bytes.bytes_at(text: base, at: base.len() - 4, needle: ".txt") || bytes.bytes_at(text: base, at: base.len() - 5, needle: ".json"))
            return true

    return false
