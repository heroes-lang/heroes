# Which library the program names a file a link opened is, and the small
# readings of a linker's words the readers share (design.md §4.19; defect
# 2363; panel 239), out of `cli/supplied_read.hero` at the landing past §11's
# 300 lines. Each name the program wrote is asked of a file, the file never
# parsed for one (panel 188's rule for a library's name), as
# `cli/library_needs.hero` asks it.

use cli/process
use cli/strings
use emit/ffi_lookup
use module/reading as file_reading

# The library names among `named` that name `file`, as the link found it;
# asked of the file's bytes first, so the platform's files a link names for
# every name the runtime calls cost no character list each.
function naming(file: str, named: [str]) -> [str]
    out: [str] @= []

    for n in named
        if (strings.holds(text: file, needle: "lib" + n + ".") || strings.holds(text: file, needle: n + ".lib")) && names_file(base: base_of(file), name: n)
            out @ out.push(n)

    return out

# Whether `base`, a file's last component, is the library `-l<name>` reads:
# `lib<name>.a`, `.so`, `.so.<version>`, `.dylib`, `.<version>.dylib`, `.tbd`,
# and on Windows `<name>.lib`, a file of objects or a DLL's import library
# (defect 2376).
function names_file(base: str, name: str) -> bool
    stem = "lib" + name + "."

    if base == name + ".lib"
        return true

    if !strings.starts_with(text: base, prefix: stem)
        return false
    rest = base.slice(from: stem.len(), to: base.len())
    return rest == "a" || rest == "so" || rest == "dylib" || rest == "tbd" || strings.starts_with(text: rest, prefix: "so.") || strings.ends_with(text: rest, suffix: ".dylib") || strings.ends_with(text: rest, suffix: ".tbd")

# A file's last component, its object `(x.o)` and Apple's index `[2]` taken off.
function base_of(file: str) -> str
    cs = archive_of(file).chars()
    start: i64 @= 0

    for i in range(from: 0, to: cs.len())
        if cs[i] == "/" || cs[i] == "\\"
            start @ i + 1

    return cs.slice(from: start, to: cs.len()).join("")

# A file as the link names it with its object `(x.o)` and Apple's index
# `[2]` taken off: the archive an object was loaded from, or the file itself.
function archive_of(file: str) -> str
    cs = file.chars()
    end: i64 @= cs.len()

    if end > 0 && cs[end - 1] == ")"
        open = ffi_lookup.char_index_of(text: file, needle: "(")

        if !open.is_err()
            end @ open.must()

    if end > 0 && cs[end - 1] == "]"
        k: i64 @= end - 1

        while k > 0 && cs[k] != "["
            k @ k - 1

        if cs[k] == "["
            end @ k
    return cs.slice(from: 0, to: end).join("")

# An object of a library file, or an object, as against a shared library.
function is_regular(file: str) -> bool
    return strings.ends_with(text: file, suffix: ")") || strings.ends_with(text: file, suffix: ".o") || strings.ends_with(text: file, suffix: ".obj")

# A file as Apple's linker names a duplicate's, `libab.a[2](ab.o)`, as its map
# names it, `libab.a(ab.o)`: the index taken off.
function without_index(file: str) -> str
    open = ffi_lookup.char_index_of(text: file, needle: ".a[")

    if open.is_err()
        return file
    cs = file.chars()
    k: i64 @= open.must() + 2

    while k < cs.len() && cs[k] != "]"
        k @ k + 1

    if k >= cs.len()
        return file
    return cs.slice(from: 0, to: open.must() + 2).join("") + cs.slice(from: k + 1, to: cs.len()).join("")

# The text after the last `: `, the whole where there is none: GNU ld puts its
# own path before the file it names, lld does not.
function last_field(text: str) -> str
    cs = text.chars()
    start: i64 @= 0

    for i in range(from: 0, to: cs.len() - 1)
        if cs[i] == ":" && cs[i + 1] == " "
            start @ i + 2

    return cs.slice(from: start, to: cs.len()).join("")

function until(text: str, stop: str) -> str
    kept: [str] @= []

    for ch in text.chars()
        if ch == stop
            break
        kept @ kept.push(ch)

    return kept.join("")

# The text before the first `stop`, the whole where there is none.
function until_text(text: str, stop: str) -> str
    at = ffi_lookup.char_index_of(text: text, needle: stop)

    if at.is_err()
        return text
    return text.chars().slice(from: 0, to: at.must()).join("")

# `field`'s parts between each `separator`, a byte such as a tab or `|`,
# cut a byte at a time.
function split_on(field: str, separator: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < field.len()
        if field[at] == separator[0]
            out @ out.push(field.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    return out.push(field.slice(from: start, to: field.len()))

function named_in(list: [str], name: str) -> bool
    for one in list
        if one == name
            return true

    return false

function shares(a: [str], b: [str]) -> bool
    for one in a
        if named_in(b, name: one)
            return true

    return false

# The lines of `text` up to the first that is one of `stops`, those holding
# one of `needles` (every line for none), cut at its line ends a byte
# at a time: a long trace or map costs no character list of a line it does
# not hold (a character list of each line cost a build 0.43G instructions per
# probe, measured by the sitting on 1,252 lines; Apple's `-t` writes 330 for
# a program of one library, the landing's measure).
function byte_lines(text: str, needles: [str], stops: [str]) -> [str]
    out: [str] @= []
    start: i64 @= 0

    while start < text.len()
        end: i64 @= start

        while end < text.len() && text[end] != 10
            end @ end + 1

        line = text.slice(from: start, to: end)
        start @ end + 1

        if named_in(stops, name: line)
            return out

        if needles.len() == 0 || holds_one(text: line, needles: needles)
            out @ out.push(line)

    return out

function holds_one(text: str, needles: [str]) -> bool
    for needle in needles
        if strings.holds(text: text, needle: needle)
            return true

    return false

function byte_at(text: str, byte: u8) -> i64
    at: i64 @= 0

    while at < text.len()
        if text[at] == byte
            return at
        at @ at + 1

    return -1

# The folders a link line names with `-L`, in its order, as its words wrote
# them: the program's `--library` folders and its packages' `-L` words.
function dirs_of(line: [str]) -> [str]
    dirs: [str] @= []

    for index in range(from: 0, to: line.len())
        if line[index] == "-L" && index + 1 < line.len()
            dirs @ dirs.push(line[index + 1])
        else if strings.starts_with(text: line[index], prefix: "-L") && line[index].len() > 2
            dirs @ dirs.push(line[index].slice(from: 2, to: line[index].len()))

    return dirs

# The one name a note gives the definition in `file`, whichever answer named
# it (defect 2384: Apple's linker writes a duplicate's file by its absolute
# path and its map by the path the line gave, and a definition was told
# twice): the library file as the program's own words reach it, a `-L`
# folder of its line as written and the file's name, where that folder holds
# this very file, the same bytes, or, the link naming a file by its name
# alone as Windows' maps do, a file of that name; else the path as the link
# gave it; the object after it, Apple's `[n]` taken off.
function shown(file: str, dirs: [str]) -> str
    plain = without_index(file)
    archive = archive_of(plain)
    member = plain.slice(from: archive.len(), to: plain.len())
    base = base_of(archive)
    key = file_reading.key_of(archive).default("")

    for dir in dirs
        candidate = dir + "/" + base

        if candidate == archive
            return plain

        if archive == base && process.path_exists(candidate)
            return candidate + member

        if key != "" && file_reading.key_of(candidate).default("") == key
            return candidate + member

    return plain

# What tells two names of one definition apart from two definitions: the
# library file's bytes (its key) and the object in it, or the name where the
# file cannot be read.
function identity(name: str) -> str
    archive = archive_of(name)
    key = file_reading.key_of(archive)

    if key.is_err()
        return name
    return key.must() + name.slice(from: archive.len(), to: name.len())

# A note for each definition among `files`, one whichever answers named it
# and however they spelled it, each by the one name `shown`
# gives, in the order of those names (defect 2384).
function with_files(notes: [str], files: [str], dirs: [str]) -> [str]
    seen: [str] @= []
    names: [str] @= []

    for file in files
        for one in each_file(file)
            named = shown(file: one, dirs: dirs)
            same = identity(named)

            if !named_in(seen, name: same)
                seen @ seen.push(same)
                names @ names.push(named)

    out: [str] @= notes

    for named in sort(names)
        out @ out.push("a definition is in `" + named + "`")

    return out

function each_file(field: str) -> [str]
    out: [str] @= []

    for one in split_on(field: field, separator: "|")
        if one.len() > 0
            out @ out.push(one)

    return out

## Tests

# Defect 2384's shapes, the files made under `build/`: a relative folder
# holding the file, the absolute path Apple's duplicate writes for it, and a
# Windows map's bare name; a file no folder of the line holds keeps its path.
test "a definition's file is named by the folder the line gave, whichever answer named it (defect 2384)"
    dir = "build/selftest-shown-2384"
    assert !process.mkdir_all(dir + "/lib").is_err()
    assert !write_file(path: dir + "/lib/liba.a", text: "!<arch>\n2384\n").is_err()
    assert !write_file(path: dir + "/lib/a.lib", text: "2384 lib\n").is_err()
    dirs = [dir + "/other", dir + "/lib"]
    assert shown(file: dir + "/lib/liba.a(pick_a.o)", dirs: dirs) == dir + "/lib/liba.a(pick_a.o)"
    assert shown(file: dir + "/./lib/liba.a[2](pick_a.o)", dirs: dirs) == dir + "/lib/liba.a(pick_a.o)"
    assert shown(file: "a.lib(pick_a.obj)", dirs: dirs) == dir + "/lib/a.lib(pick_a.obj)"
    assert shown(file: "/usr/lib/libz.a(deflate.o)", dirs: dirs) == "/usr/lib/libz.a(deflate.o)"
    assert identity(dir + "/lib/liba.a(pick_a.o)") == identity(dir + "/./lib/liba.a(pick_a.o)")
    assert identity(dir + "/lib/liba.a(pick_a.o)") != identity(dir + "/lib/liba.a(a_only.o)")
    assert dirs_of(["clang", "-L", "lib", "-L/opt/lib", "x.o", "-la"]) == ["lib", "/opt/lib"]
    assert !process.remove_tree(dir).is_err()

test "a field is cut at each of its separator's bytes, an empty part kept (panel 239)"
    assert split_on(field: "a\tb\t\tc", separator: "\t") == ["a", "b", "", "c"]
    assert split_on(field: "", separator: "|") == [""]
    assert split_on(field: "/w/é.a|/w/b.a", separator: "|") == ["/w/é.a", "/w/b.a"]

test "a library file is the one its -l name reads, and no other (panel 239)"
    assert names_file(base: "liba.a", name: "a")
    assert names_file(base: "libm.so.6", name: "m")
    assert names_file(base: "libb.dylib", name: "b")
    assert !names_file(base: "libsystem_m.tbd", name: "m")
    assert !names_file(base: "libab.a", name: "a")
    assert names_file(base: "a.lib", name: "a")
    assert !names_file(base: "ab.lib", name: "a")
    assert base_of("a.lib(pick_a.obj)") == "a.lib"
    assert base_of("/w/out/lib/liba.a(pick_a.o)") == "liba.a"
    assert base_of("/w/out/libab.a[2](ab.o)") == "libab.a"
    assert base_of("/lib/aarch64-linux-gnu/libc.so.6") == "libc.so.6"
    assert without_index("/w/libab.a[2](ab.o)") == "/w/libab.a(ab.o)"
    assert without_index("/w/libab.a(ab.o)") == "/w/libab.a(ab.o)"
