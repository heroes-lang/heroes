# What a command line the table refuses is told (CLAUDE.md §10; panels 016,
# 020): every refusal names what was wrong and the form that is accepted, the
# operand and the flag written as the help writes them, so one round trip is
# enough. Out of `cli/argv.hero` since defect 2536, whose repair took that
# module past its ceiling: this file is what the parser says, `argv.hero` how
# it reads a line against the table.

use cli/table as cli_table

# The operand as a usage line shows it, the help's form: `<file.hero>` where
# one is needed, `[file]` where it may be left out, `[package]` for what `add`
# adds, `<name>` for the folder `new` makes, `<module>` for what `doc` prints,
# and nothing for a command that takes none, whose usage line would otherwise
# name a file it refuses.
function operand_said(command: cli_table.Command) -> str
    match command.operand
        .file_operand     => return " <file.hero>"
        .optional_operand => return " [file]"
        .package_operand  => return " [package]"
        .name_operand     => return " <name>"
        .module_operand   => return " <module>"
        .no_operand       => return ""

# What an empty operand is told, in the form the help gives the operand:
# `<file.hero>` where one is needed, `[file]` where it may be left out.
function empty_operand(command: cli_table.Command) -> str
    match command.operand
        .file_operand => return "`" + command.name + "` needs a file, and was given an empty one: `heroes " + command.name + " <file.hero>`"
        .optional_operand | .no_operand =>
            return "`" + command.name + "` was given an empty file, which names none: `heroes " + command.name + " [file]`, or no file for its default"
        .package_operand => return "`" + command.name + "` was given an empty package, which names none: `heroes " + command.name + " json`, or `--path` and a folder"
        .name_operand => return "`" + command.name + "` was given an empty name, which names no folder: `heroes " + command.name + " <name>`"
        .module_operand => return "`" + command.name + "` was given an empty module, which names none: " + module_forms(command)

# What a missing operand is told, in the help's form of it.
function missing_operand(command: cli_table.Command) -> str
    match command.operand
        .name_operand => return "`" + command.name + "` needs the name of the folder it makes: `heroes " + command.name + " <name>`, or `heroes " + command.name + " <name> --package` for a package"
        .module_operand => return "`" + command.name + "` needs a module: " + module_forms(command)
        .file_operand | .optional_operand | .package_operand | .no_operand => return "`" + command.name + "` needs a file: `heroes " + command.name + " <file.hero>`"

# A second operand, told as the package or the folder it is, not *one file*.
function second_operand(command: cli_table.Command, first: str, second: str) -> str
    match command.operand
        .name_operand => return "`" + command.name + "` makes one folder, and was given two names, `" + first + "` and `" + second + "`: `heroes " + command.name + " <name>`"
        .package_operand => return "`" + command.name + "` adds one package at a time, and was given two, `" + first + "` and `" + second + "`: run `heroes " + command.name + "` once for each"
        .module_operand => return "`" + command.name + "` reads one module, and was given two, `" + first + "` and `" + second + "`: run `heroes " + command.name + "` once for each"
        .file_operand | .optional_operand | .no_operand => return "`" + command.name + "` takes one file, and two were given"

# The two forms of a module the help's `<module>` stands for.
function module_forms(command: cli_table.Command) -> str
    return "`heroes " + command.name + " <file.hero>`, or `heroes " + command.name + " '<name>/<module>'` for a package's module"

# A word given to a command that takes none (defect 2542), told as the word it
# is and never as a file: `heroes fetch json` was told *`fetch` takes no
# file*, naming the wrong kind of operand. `fetch`, whose word is most often a
# package meant for `add`, is told what it places and the verb that adds one.
function no_operand(command: cli_table.Command, given: str) -> str
    word: str @= "`" + given + "`"

    if given.len() == 0
        word @ "an empty word"
    takes: str @= "takes nothing after its name"

    if command.flags.len() > 0
        takes @ "takes nothing but its flags"
    opening = "`" + command.name + "` " + takes + ", and was given " + word

    if command.tag == .fetch_cmd
        return opening + ": `heroes fetch` places every package the program's `heroes.toml` names, and `heroes add <package>` adds one"
    return opening + ": `heroes " + command.name + "`"

# The enumerating error the llm-ergonomist asked for: every wrong flag
# is one round trip, because the message carries the list.
function unknown_flag(command: cli_table.Command, arg: str) -> str
    if command.flags.len() == 0
        return "`" + command.name + "` takes no flags, and `" + arg + "` was given"
    accepted: [str] @= []

    for f in command.flags
        accepted @ accepted.push(f.spelling)

    return "`" + command.name + "` does not accept `" + arg + "` — it accepts " + accepted.join(", ")

# A flag the table does not let repeat, given a second time (defect 2536): the
# second was dropped in silence, so `-o a1 -o a2` wrote `a1` alone and `add
# --path a --path b` added `a`, a file written from half of what was asked.
# Both values are named, `first` and `second`, for a flag that takes one; a
# flag that takes none is told it was given twice.
function repeated(command: cli_table.Command, flag: cli_table.Flag, first: str?, second: str?) -> str
    if !flag.value
        return "`" + flag.spelling + "` was given twice: give it once, " + usage_of(command, flag: flag)
    return "`" + flag.spelling + "` takes one " + flag.placeholder + ", and was given two, `" + first.default("") + "` and `" + second.default("") + "`: give it once, " + usage_of(command, flag: flag)

# A flag that takes a value, given none: the next word is missing or is
# another flag (defect 349's shape for an empty one, below).
function value_missing(command: cli_table.Command, flag: cli_table.Flag) -> str
    return "`" + flag.spelling + "` needs " + with_article(flag.placeholder) + ": " + usage_of(command, flag: flag)

# A flag that takes a value, given an empty one, which names nothing (defect
# 349): `-o ""` reached the writer, which told it as a link that cannot be
# followed.
function value_empty(command: cli_table.Command, flag: cli_table.Flag) -> str
    return "`" + flag.spelling + "` needs " + with_article(flag.placeholder) + ", and was given an empty one: " + usage_of(command, flag: flag)

# A flag as the usage line writes it, `heroes build <file.hero> -o <path>`.
function usage_of(command: cli_table.Command, flag: cli_table.Flag) -> str
    said = "`heroes " + command.name + operand_said(command) + " " + flag.spelling

    if flag.value
        return said + " <" + flag.placeholder + ">`"
    return said + "`"

# A placeholder with the article it takes, `a path`, `an address` (defect
# 2541): the article was a fixed `a`, so `--index` was told it *needs a
# address*. Read from the first letter, a vowel taking `an`, which is what the
# sound of every placeholder of the table gives today; a word whose sound is
# not its letter (`an hour`, `a unit`) would be wrong, so a test holds the
# table's placeholders to the words this rule was read against, and a new one
# fails it until its article is read here.
function with_article(placeholder: str) -> str
    if placeholder.len() > 0
        first = placeholder[0]

        if first == 'a' || first == 'e' || first == 'i' || first == 'o' || first == 'u'
            return "an " + placeholder
    return "a " + placeholder

## Tests

test "a flag given twice names both values, and the form that gives it once (defect 2536)"
    none: str? = fail(code: "none", msg: "no value")
    asked: i64 @= 0

    for c in cli_table.commands()
        for f in c.flags
            if c.name == "build" && f.spelling == "-o"
                assert repeated(c, flag: f, first: ok("a1"), second: ok("a2")) == "`-o` takes one path, and was given two, `a1` and `a2`: give it once, `heroes build <file.hero> -o <path>`"
                asked @ asked + 1

            if c.name == "build" && f.spelling == "--emit-c"
                assert repeated(c, flag: f, first: none, second: none) == "`--emit-c` was given twice: give it once, `heroes build <file.hero> --emit-c`"
                asked @ asked + 1

            if c.name == "fetch" && f.spelling == "-C"
                assert repeated(c, flag: f, first: ok("a"), second: ok("b")) == "`-C` takes one folder, and was given two, `a` and `b`: give it once, `heroes fetch -C <folder>`"
                asked @ asked + 1

    assert asked == 3

# The placeholders whose sound `with_article` was read against: every one the
# table writes, so a flag added with another placeholder fails here until its
# article is read.
constant READ_PLACEHOLDERS: [str]
    ["path", "address", "tag", "folder", "name", "text", "count"]

test "a placeholder takes the article its sound does, and a missing address is told an address (defect 2541)"
    assert with_article("address") == "an address"
    assert with_article("path") == "a path"
    asked: i64 @= 0

    for c in cli_table.commands()
        for f in c.flags
            if f.value
                known: bool @= false

                for one in READ_PLACEHOLDERS
                    if one == f.placeholder
                        known @ true

                assert known
                asked @ asked + 1

            if c.name == "add" && f.spelling == "--index"
                assert value_missing(c, flag: f) == "`--index` needs an address: `heroes add [package] --index <address>`"
                assert value_empty(c, flag: f) == "`--index` needs an address, and was given an empty one: `heroes add [package] --index <address>`"

    assert asked > 20

test "a word given to a command that takes none is named as the word it is (defect 2542)"
    asked: i64 @= 0

    for c in cli_table.commands()
        if c.name == "fetch"
            assert no_operand(c, given: "json") == "`fetch` takes nothing but its flags, and was given `json`: `heroes fetch` places every package the program's `heroes.toml` names, and `heroes add <package>` adds one"
            asked @ asked + 1

        if c.name == "doctor"
            assert no_operand(c, given: "x.hero") == "`doctor` takes nothing after its name, and was given `x.hero`: `heroes doctor`"
            assert no_operand(c, given: "") == "`doctor` takes nothing after its name, and was given an empty word: `heroes doctor`"
            asked @ asked + 1

    assert asked == 2
