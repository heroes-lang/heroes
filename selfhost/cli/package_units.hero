# Which units of a build are a fetched package's, the words each compiles
# under, and what its headers may read (panel 235's R9, its C1 and C2,
# ratified 2026-11-07; defect 2351, 2026-11-08; design.md §4.19, §1.12).
#
# **A fetched package's unit searches the runtime's directory, then the
# folders its own `package` groups' answer names, then its own root, and
# nothing of the program's** (`compiling.of_package`): every probe of its
# headers and its compile alike, since the probes are planned per header list
# and root (`cli/probing.hero`) and the units take their words here
# (`cli/assemble.hero`, `cli/settled.hero`). Until defect 2351 no build asked
# which units were a package's, and every unit compiled under the program's
# words: a package placed by `heroes fetch` whose module binds a header it
# ships beside it was refused `ffi_missing_header` at exit 1, and with
# `--include` naming the placed folder it built, the program's folders
# standing ahead of the package's root for every header it named. Measured
# 2026-11-08 by lane pm-close and the coordinator on batch 24's compiler.
#
# **And everything such a unit reads lies where a package may read**
# (`compiling.within_root`, C2): judged on clang's `-M` listing of the lines
# its probes open with and of its unit's opening, before anything of it
# compiles, so a header reaching the build machine's files by a relative
# climb, `#embed` or `__has_include` stops the build with the path named and
# no compile having read it. A listing clang could not make vouches for
# nothing and stops the build too: a header not found from the package's
# own places is told `ffi_missing_header`, naming where it was looked for,
# and clang's own words are never printed, since a header may have read a
# file of the machine's before it stopped.
#
# **A `path` entry is the author's own code** (panel 235's R6, *the author's
# own source while a package is developed*; its C1, C2 and C5 *tell a
# fetched unit apart*): its units keep the program's words, the program's
# folders and `--include` among them, and panel 216's probe, as the program's
# own modules and the library do, and **search its own folder after them**
# (defect 2357): until then a `path` package binding the header beside its
# modules was refused `ffi_missing_header` unless `--include` named its folder.
#
# **A unit that reaches another package's group record searches that
# package's folder after its own route** (defect 2357, the coordinator's
# ruling): it spells the record's C type, so it includes the header the
# package's group names, which no folder of its own holds. Until then a
# program holding `pt.Point` by value was refused `ffi_missing_header` at the
# package's line unless `--include` named the package's folder. A file of the
# unit's own folders standing in for that header, found first, is refused
# before anything compiles (`cli/package_stand_in.hero`), as is a file of a
# package's folder standing in for a header of the C library or the runtime.

use ast
use bytes
use cli/compiling
use cli/deps
use cli/digest
use cli/order_trial
use cli/process
use cli/publish
use cli/read_back
use cli/response_file
use cli/strings
use diag
use emit/externs as emit_externs
use emit/unit_plan
use module/placed
use source
use token

# Where a module's package lives: the folder its files are opened from, with
# no `/` at its end, `""` for a module of the program's own or of the
# library; the program's alias for the package; and whether a fetch placed
# it, `false` for a `path` entry's folder, the author's own.
record Place
    folder: str
    alias: str
    fetched: bool

# A header a unit reaches through another package's group record, and that
# package's place: the file must be the one in its folder.
record Reach
    place: Place
    header: str

function place_of(s: source.Source, component: str) -> Place
    for entry in s.files
        if entry.component == component && !entry.is_library && placed.is_package(entry.module)
            alias = placed.entry_of(entry.module)

            for p in s.reached.packages
                if p.alias == alias
                    return Place(folder: without_slash(p.opened), alias: alias, fetched: !p.unverified)

            return Place(folder: "", alias: alias, fetched: false)

    return Place(folder: "", alias: "", fetched: false)

# The root a fetched package's module compiled to `component` searches;
# absent for a module of the program's own, of the library and of a `path`
# entry, which keep the program's words and its probe.
function root_of(s: source.Source, component: str) -> str?
    place = place_of(s, component)

    if !place.fetched
        return fail(code: "own", msg: "a module of the program's own or of a `path` entry")
    return ok(place.folder)

# Each header `plan`'s unit reads for a group record of another package's,
# with that package's place, once each and in the declarations' order: the
# records it spells (`unit_plan.Plan.records`) whose module is a package's
# other than its own.
function reached_of(s: source.Source, decls: [ast.Decl], plan: unit_plan.Plan) -> [Reach]
    own = place_of(s, plan.module)
    out: [Reach] @= []

    # ORDER: by declaration index, the order the program wrote them.
    for decl in sort(keys(plan.records))
        p = place_of(s, source.component_at(s, decls[decl].name.start))
        header: token.Span? @= fail(code: "none", msg: "no header")

        match decls[decl].kind
            .record_decl rec                                             => header @ rec.header
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

        if p.folder.len() > 0 && p.folder != own.folder && !header.is_err()
            one = Reach(place: p, header: emit_externs.unquoted(s, span: header.must()))

            if !holds(out, one)
                out @ out.push(one)

    return out

function holds(found: [Reach], one: Reach) -> bool
    for other in found
        if other.place.folder == one.place.folder && other.header == one.header
            return true

    return false

# What the unit of `plan` compiles under, `under` being the program's for its
# headers' packages: a fetched package's own (C1); and after its own route, a
# `path` entry's folder where it is one's, then the folder of each package
# whose group record it reaches (defect 2357).
function unit_under(under: compiling.Compiling, s: source.Source, decls: [ast.Decl], plan: unit_plan.Plan) -> compiling.Compiling
    own = place_of(s, plan.module)
    base: compiling.Compiling @= under
    after: [str] @= []

    if own.fetched
        base @ compiling.of_package(under, root: own.folder)
    else if own.folder.len() > 0
        after @ after.push(own.folder)

    for one in reached_of(s, decls, plan)
        if !strings_hold(after, one: one.place.folder)
            after @ after.push(one.place.folder)

    return searching_after(base, folders: after)

function strings_hold(list: [str], one: str) -> bool
    for item in list
        if item == one
            return true

    return false

# `under` with `folders` searched after its own route, in their order: its
# own folder, which a search names last (`compiling.search_words`), becomes
# an `-I` word before them, so each is searched after it and before the
# system's places.
function searching_after(under: compiling.Compiling, folders: [str]) -> compiling.Compiling
    if folders.len() == 0
        return under
    words: [str] @= under.package_flags

    if under.source_dir.len() > 0
        words @ words.push("-I" + under.source_dir)

    for folder in folders
        words @ words.push("-I" + folder)

    return compiling.Compiling(
        level: under.level,
        sanitize: under.sanitize,
        search_include: under.search_include,
        package_flags: words,
        runtime: under.runtime,
        source_dir: ""
    )

# What the one file `--emit-c` writes is asked under (`cli/one_file.hero`):
# the program's words, then the folder of every package the program reaches,
# fetched or a `path` entry's, each after the program's own places, so a
# package's header the one file reads is found where its unit finds it and
# none stands ahead of one of the program's.
function with_roots(under: compiling.Compiling, s: source.Source) -> compiling.Compiling
    folders: [str] @= []

    for p in s.reached.packages
        if p.problem.len() == 0
            folders @ folders.push(without_slash(p.opened))

    return searching_after(under, folders: folders)

# C2's verdict on a fetched package's unit whose headers are `headers`, under
# `under`, its own (`unit_under`), `root` the package's: the lines its probes
# open with and its unit's opening, each listed by `clang -M` and judged,
# before any of them compiles; a folder its words search, another package's
# whose record it reaches among them, is one it may read. A listing clang
# could not make fails `unread`, its message the header clang did not find
# there, or `""`.
function read_within(build: str, under: compiling.Compiling, root: str, headers: [str], @memo: {str: str}) -> ()?
    words = compiling.probe_words(under)

    for text in [compiling.include_lines(headers), order_trial.opening(headers, question: "")]
        listing = compiling.reads_text(build: build, words: words, text: text, @memo)

        if listing.is_err()
            return fail(code: "unread", msg: missing(build: build, words: words, text: text))
        compiling.within_root(build: build, under: under, root: root, listing: listing)?

    return ok()

# The first header `clang -M` over `text` under `words` says it did not find,
# `""` where it says none: what clang said is read for that name alone and
# never printed, since a header may have opened a file of the machine's
# before it stopped.
function missing(build: str, words: [str], text: str) -> str
    dir = build + "/package-reads"

    if process.mkdir_all(dir).is_err()
        return ""
    unit = dir + "/listed-" + digest.digest(text) + ".c"

    if publish.write_whole(path: unit, text: text, keyed: true).is_err()
        return ""
    err = publish.private_name(dir + "/missing.txt")
    line = response_file.carried(line: strings.with_all(list: ["clang"], more: words), dir: dir)
    _ = process.run(
        program: "clang",
        words: strings.with_all(list: line, more: ["-M", unit]),
        out: process.discard(),
        err: err
    )
    said = read_back.words(err).default("")
    publish.discard(err)
    return not_found(said)

# The name a line of clang's says it did not find, `fatal error: 'X' file not
# found`, the first such line's; `""` where none says it.
function not_found(said: str) -> str
    opener = "fatal error: '"
    closer = "' file not found"

    for line in deps.lines(said)
        at = bytes.locate(text: line, needle: opener, from: 0)

        if !at.is_err()
            rest = line.slice(from: at.must() + opener.len(), to: line.len())
            end = bytes.locate(text: rest, needle: closer, from: 0)

            if !end.is_err() && end.must() > 0
                return rest.slice(from: 0, to: end.must())

    return ""

# The refusal C2's verdict `failed` is, for the fetched package at `root`
# whose modules' unit is `modules`: told on the first binding of theirs a
# group names a header for, which is where the build tells a header it could
# not open (`ffi_missing_header`). Never absent: a refusal nobody tells would
# let the unit compile and read what was refused.
function refusal(s: source.Source, decls: [ast.Decl], modules: [str], root: str, failed: ()?) -> diag.Diagnostic
    at = first_binding(s, decls, modules: modules)
    code = code_of(failed)
    said = message_of(failed)
    d: diag.Diagnostic @= diag.new_diagnostic(code: "package_reads_outside", message: said, span: at)

    if code == "unread" && said.len() > 0
        d @ diag.new_diagnostic(
            code: "ffi_missing_header",
            message: "`" + said + "` is not found where a unit of the fetched package at `" + root + "` looks for a header: the package's own root, the runtime's directory, the toolchain's own and the folders its `package` groups' answer names",
            span: at
        )
    else if code == "unread"
        d @ diag.new_diagnostic(
            code: "package_reads_outside",
            message: "the headers a unit of the fetched package at `" + root + "` names do not preprocess from its own places, so nothing vouches for the files they read, and no compile of it runs",
            span: at
        )
    else if code != "package_reads_outside"
        # The toolchain's own folders could not be asked of clang, so the
        # listing could not be judged: still a refusal, never a pass.
        d @ diag.new_diagnostic(
            code: "package_reads_outside",
            message: "the files a unit of the fetched package at `" + root + "` reads cannot be judged, since " + said + ", and no compile of it runs",
            span: at
        )
    d.notes @ d.notes.push(NOTE)
    return d

# What every refusal of C2's says under it.
constant NOTE: str
    "a fetched package's unit searches the runtime's directory, the folders its own `package` groups' answer names and its own root, and reads nothing else: never the program's folders, an `--include` directory or another package's files (panel 235's R9, its C1 and C2). A header it needs ships inside the package, or is a library's that a `package` group names, installed with its development files"

# The span of the first declaration of `modules` a group names a header for;
# of their first declaration where none is one, a unit reading a header of
# another module's group record alone; and of the program's first where they
# declare nothing.
function first_binding(s: source.Source, decls: [ast.Decl], modules: [str]) -> token.Span
    first: token.Span? @= fail(code: "none", msg: "no declaration of these modules")

    for decl in decls
        named: token.Span? @= fail(code: "none", msg: "no header")

        match decl.kind
            .function_decl fd          => named @ fd.value.header
            .constant_decl k           => named @ k.header
            .record_decl rec           => named @ rec.header
            .variant_decl | .test_decl => continue

        component = source.component_at(s, decl.span.start)

        for module in modules
            if module == component
                if !named.is_err()
                    return decl.span

                if first.is_err()
                    first @ ok(decl.span)

    if first.is_err() && decls.len() > 0
        return decls[0].span
    return first.default(token.Span(start: 0, end: 0))

function without_slash(path: str) -> str
    if path.len() > 1 && path[path.len() - 1] == '/'
        return path.slice(from: 0, to: path.len() - 1)
    return path

function code_of(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

function message_of(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

## Tests

test "clang's line naming a header it did not find is read for the name alone"
    said = "In file included from build/package-reads/listed-1.c:2:\nheroes.packages/pk/pk.h:1:10: fatal error: 'secret.h' file not found\n    1 | #include \"secret.h\"\n"
    assert not_found(said) == "secret.h"
    assert not_found("x.h:1:2: error: something else\n") == ""
    assert not_found("") == ""
    assert without_slash("heroes.packages/pk@1.0.0-0123456789abcdef/") == "heroes.packages/pk@1.0.0-0123456789abcdef"
    assert without_slash("/") == "/"
