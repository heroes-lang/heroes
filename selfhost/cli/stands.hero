# What stands at a name, as a message names it: nothing, a file, a folder,
# a FIFO, a socket, a device, or a link and what its chain of links names
# (design.md §1.12, §4.17; defect 2572, 2026-11-24).
#
# **Every reader of the compiler opens a file through its door alone**
# (`module/reading.hero`), which opens a regular file and nothing else and
# never waits to open one, so a read that fails where something stands is
# told by what stands there, and *could not read* is left for a file the
# system refused. Until then the doors' callers said a FIFO, a socket and a
# device alike were *a name that is neither a folder, a file nor a link*, and
# a link to one *a link to a file*, which no author could look for.
#
# Its own module, below `cli/process` and `cli/files`, because the first is
# what makes a folder and says why it could not (`process.mkdir_all`), and
# both are below every reader: it asks the runtime itself and uses only the
# words of a reason (`cli/os_reason`).
#
# **A name the system will not look at is told as that, with its reason**
# (defect d-lane-blocking-small2-1's class): a path too long, under a file
# or through a folder that cannot be searched was told *a name the system
# cannot say what it is stands there*, to be renamed or removed, where
# nothing may stand at all; and it is never what blocks a folder, whose
# own `mkdir` gave the reason.

use cli/os_reason

# `lent` on every path: each call reads it while it runs and keeps nothing.
extern "hero_os.h"
    function hero_fs_kind(path: cstr lent) -> i64
    function hero_fs_landing(path: cstr lent) -> str
    constant HERO_FS_ABSENT: i64
    constant HERO_FS_FILE: i64
    constant HERO_FS_DIRECTORY: i64
    constant HERO_FS_LINK: i64
    constant HERO_FS_OTHER: i64
    constant HERO_FS_UNKNOWN: i64

# The compiler's own question (`runtime/parts/replace.c`): what a name that
# is neither a file, a folder nor a link is, asked of the name itself.
extern "hero_compiler.h"
    function hero_fs_special(path: cstr lent) -> i64
    constant HERO_FS_FIFO: i64
    constant HERO_FS_SOCKET: i64
    constant HERO_FS_DEVICE: i64

# What stands at `path`, the name itself asked, a link told with what its
# chain finally names.
function said(path: str) -> str
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_LINK
        return "a link to " + landed(path)
    return kind_said(path: path, kind: kind)

# What the chain of links at `path` finally names; `path` itself where it is
# no link.
function landed(path: str) -> str
    target = hero_fs_landing(path: path.cstr())

    if target.len() == 0
        return "a chain of links the system cannot follow"
    kind = hero_fs_kind(path: target.cstr())

    if kind == HERO_FS_LINK
        return "a chain of links the system cannot follow"
    return kind_said(path: target, kind: kind)

# Whether a read of `path` reads a file: a file stands there, or a link
# whose chain names one. Nothing there, a folder, a FIFO, a socket, a device
# or a link to one of those is no file to read.
function is_file(path: str) -> bool
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_FILE
        return true

    if kind != HERO_FS_LINK
        return false
    target = hero_fs_landing(path: path.cstr())
    return target.len() > 0 && hero_fs_kind(path: target.cstr()) == HERO_FS_FILE

# Whether what stands at `path` would be opened as a file and is none: a
# FIFO, whose open waits for a writer, a socket, a device, which is read
# without end or answers nothing, or a link whose chain names one of them.
# Nothing, a file, a folder and a link to nothing or to a folder are not.
function is_special(path: str) -> bool
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_OTHER
        return true

    if kind != HERO_FS_LINK
        return false
    target = hero_fs_landing(path: path.cstr())
    return target.len() > 0 && hero_fs_kind(path: target.cstr()) == HERO_FS_OTHER

# What `kind`, `hero_fs_kind`'s answer for `path`, names, `path` asked again
# where it is neither a file, a folder nor a link.
function kind_said(path: str, kind: i64) -> str
    if kind == HERO_FS_ABSENT
        return "nothing"

    if kind == HERO_FS_FILE
        return "a file"

    if kind == HERO_FS_DIRECTORY
        return "a folder"

    if kind == HERO_FS_OTHER
        return special(path)
    return "a name the system will not look at, " + os_reason.told(os_reason.last())

# The first part of `path`, from its root down, where something stands that
# is no folder and no link to one, so no folder can be made below it; ""
# where none is. A part the system will not look at is none: nothing is
# known to stand there, and the failed `mkdir`'s reason says why.
function blocker(path: str) -> str
    at: i64 @= 1

    while at <= path.len()
        if at == path.len() || path[at] == '/'
            part = path.slice(from: 0, to: at)

            if in_the_way(part)
                return part
        at @ at + 1

    return ""

# Whether what stands at `path` keeps a folder from being made there or
# below it: a file, a FIFO, a socket, a device, or a link whose chain names
# none of a folder.
function in_the_way(path: str) -> bool
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_FILE || kind == HERO_FS_OTHER
        return true

    if kind != HERO_FS_LINK
        return false
    target = hero_fs_landing(path: path.cstr())
    return target.len() == 0 || hero_fs_kind(path: target.cstr()) != HERO_FS_DIRECTORY

# What a name that is neither a file, a folder nor a link is.
function special(path: str) -> str
    kind = hero_fs_special(path: path.cstr())

    if kind == HERO_FS_FIFO
        return "a FIFO"

    if kind == HERO_FS_SOCKET
        return "a socket"

    if kind == HERO_FS_DEVICE
        return "a device"
    return "a name that is neither a folder, a file nor a link"

# Why the file at `path` would not read: what stands there where that is
# something other than a file, else the system's refusal.
function refused(path: str) -> str
    if hero_fs_kind(path: path.cstr()) == HERO_FS_UNKNOWN
        return "could not read " + path + ": the system will not look at it" + os_reason.because()
    stood = said(path)

    if is_file(path) || stood == "nothing"
        return "could not read " + path
    return "`" + path + "` is " + stood + ", where a file is read"

# What a source that is there and does not read is told (defect 2572),
# `opened` as it is opened and `named` as the author names it: `cannot read`
# and the name, and what stands there where that is no file, so a FIFO, a
# socket, a device, a folder or a link to nothing is named for what it is.
function unread_said(opened: str, named: str) -> str
    if hero_fs_kind(path: opened.cstr()) == HERO_FS_UNKNOWN
        return "cannot read `" + named + "`: the system will not look at it" + os_reason.because()

    if is_file(opened)
        return "cannot read `" + named + "`"
    return "cannot read `" + named + "`: " + said(opened) + " stands there, where a source is a file: rename it to keep it, or remove it and put the file there"

## Tests

# Defect d-lane-blocking-small2-1's class: a name past a name's length is one
# the system will not look at, told with the reason it gave, never as a name
# that stands there to be renamed, and never what blocks a folder (`fmt
# --in-place` under such a folder was told *a name the system cannot say
# what it is stands there*). The number is the system's own, 63 on this Mac
# and 36 on Linux, so its words are asked and not its digits.
test "a name the system will not look at is told with its reason, and stands nowhere (defect d-lane-blocking-small2-1)"
    long = "build/" + "x".repeat(300) + "/x.hero"

    # Windows may answer such a name as no path at all (unrun there).
    if hero_fs_kind(path: long.cstr()) != HERO_FS_UNKNOWN
        return
    told = unread_said(opened: long, named: "x.hero")
    opening = "cannot read `x.hero`: the system will not look at it: the operating system's own reason is "
    assert told.slice(from: 0, to: opening.len()) == opening && told.len() > opening.len()
    refusal = refused(long)
    head = "could not read " + long + ": the system will not look at it: the operating system's own reason is "
    assert refusal.slice(from: 0, to: head.len()) == head
    assert blocker(long) == "" && !in_the_way("build/" + "x".repeat(300))
    looked = said("build/" + "x".repeat(300))
    asked = "a name the system will not look at, the operating system's own reason is "
    assert looked.slice(from: 0, to: asked.len()) == asked
