# How a command line's text is split into its words, as a POSIX shell
# splits it and with nothing expanded (design.md §4.19; defect 162). It reads
# pkg-config's answer for `cli/libraries.hero`, which judges each word
# against its list: pkg-config writes that answer for a shell, so it is read
# the way a shell would read it, and every word it gives is one argument to
# clang, whatever it holds.

use cli/strings
use shown_char

# The words of pkg-config's answer, read as a POSIX shell reads a command
# line, with nothing expanded (defect 162, 2026-10-02). pkg-config writes its
# answer for a shell: this Mac's pkgconf 3.0.7, measured over one `.pc` per
# shape, gives `-I"/inc/with space"` back as `-I/inc/with\ space`,
# `-DNAME="a b"` as `-DNAME=a\ b`, a quoted backslash as `\\`, an `&` as
# `\&` and a tab after a backslash, and keeps `-DVERSION=\"1.0\"` as it
# is. A word was everything between two spaces until then, so a path with a
# space was refused, a fragment of it named as the flag. So: outside quotes
# a backslash makes the next character a letter of the word, and before a
# newline it is nothing; single quotes keep every character to the next
# one; double quotes keep every character to the next unescaped one, a
# backslash in them escaping only `$`, a backtick, `"`, `\` and a newline; a
# space, a tab or a newline outside quotes ends a word. Nothing is expanded,
# so a `$` or a backtick in a `.pc` runs nothing, and a word reaches clang
# whole, as one argument, whatever it holds.
function words(package: str, said: str) -> [str]?
    out: [str] @ []
    run: [str] @ []
    in_word: bool @ false
    quote: str @ ""
    cs = said.chars()
    index: i64 @ 0

    while index < cs.len()
        ch = cs[index]
        next: str @ ""

        if index + 1 < cs.len()
            next @ cs[index + 1]

        if quote == "'"
            if ch == "'"
                quote @ ""
            else
                run @ run.push(ch)
        else if quote == "\""
            if ch == "\""
                quote @ ""
            else if ch == "\\" && escaped_in_double_quotes(next)
                if next != "\n"
                    run @ run.push(next)
                index @ index + 1
            else
                run @ run.push(ch)
        else if ch == " " || ch == "\t" || ch == "\n"
            if in_word
                out @ out.push(run.join(""))
                run @ []
                in_word @ false
        else if ch == "\\"
            if next == "\n"
                index @ index + 1
            else if next.len() > 0
                run @ run.push(next)
                in_word @ true
                index @ index + 1
            else
                run @ run.push(ch)
                in_word @ true
        else
            if ch == "'" || ch == "\""
                quote @ ch
            else
                run @ run.push(ch)
            in_word @ true
        index @ index + 1

    if quote.len() > 0
        return fail(
            code: "failed",
            msg: "heroes-ffi-package `" + package + "` answered with a `" + quote + "` that nothing closes, which this compiler does not read: `" + one_line(said) + "`"
        )

    if in_word
        out @ out.push(run.join(""))
    return ok(out)

function escaped_in_double_quotes(ch: str) -> bool
    return ch == "$" || ch == "`" || ch == "\"" || ch == "\\" || ch == "\n"

# What the refusal of `parts[at]` owes its reader when it is no flag, or ""
# when it begins with `-` (defect 183). A word not beginning with `-` is the
# rest of a path a space nothing escapes split, as a `.pc` whose `prefix`
# holds one gives (`-I/opt/with space/include`, pkgconf 3.0.7), or a file
# named alone; the line `pkg-config` printed and the word before it show
# which, where the word alone, `space/include`, showed neither.
function no_flag(said: str, parts: [str], at: i64) -> str
    word = parts[at]

    if word.len() > 0 && word[0] == '-'
        return ""
    where: str @ ""

    if at > 0
        where @ ", where whitespace nothing escapes stands between `" + shown(parts[at - 1], keep_lines: false) + "` and it, and ends a word"
    return ": it is no flag, and `pkg-config` printed `" + one_line(said) + "`" + where + "\n  a path holding a space is one word only where `pkg-config` prints the space escaped, `\\ `, or inside quotes"

# The answer as one line: its ends trimmed, and a line end in it written by
# its code, as every control character is (`shown`).
function one_line(text: str) -> str
    return shown(strings.trimmed(text), keep_lines: false)

# `pkg-config`'s text as a message may carry it (defect 237). `pkg-config`
# prints what a `.pc` holds, a file this program did not write, and pkgconf
# 3.0.7 passed a raw ESC from one into its answer (measured, 2026-10-03), so a
# control character on its way to the author's terminal inside a message is
# written by its code, `<U+001B>`, as clang writes one it will not show; a
# line end among them, which split the message the marker's reader reads,
# unless `keep_lines` keeps the lines of `pkg-config`'s own report, `\r\n`
# read as one line end there.
function shown(text: str, keep_lines: bool) -> str
    kept: [str] @ []
    read: str @ text

    if keep_lines
        read @ strings.without_returns(text)

    for ch in read.chars()
        code = shown_char.code_point(ch)

        if keep_lines && ch == "\n"
            kept @ kept.push(ch)
        else if code < 32 || code >= 127 && code < 160
            kept @ kept.push("<" + shown_char.u_plus(code) + ">")
        else
            kept @ kept.push(ch)

    return kept.join("")

## Tests

# pkgconf 3.0.7's answers on this Mac, 2026-10-02, one `.pc` per shape (lane
# h158, defect 162): a path with spaces and a tab, a `-D` with a space and
# one with quotes, a backslash, an `&` and a `$`, and a library directory
# with a space, each one word, nothing expanded.
test "pkg-config's answer is read as a shell reads it, and nothing in it is expanded"
    said = "-I/inc/with\\ space -I/inc/two\\ \\ spaces -I/inc/tab\\\there -DNAME=a\\ b -DVERSION=\\\"1.0\\\" -I/inc/back\\\\slash -I/inc/amp\\&x -I/inc/dollar$x -L/lib/with\\ space -lz\n"
    read = words(package: "spaced", said: said).must()
    assert read == ["-I/inc/with space", "-I/inc/two  spaces", "-I/inc/tab\there", "-DNAME=a b", "-DVERSION=\"1.0\"", "-I/inc/back\\slash", "-I/inc/amp&x", "-I/inc/dollar$x", "-L/lib/with space", "-lz"]

    # The quotes another pkg-config may keep, an empty word, a backslash
    # before a newline and one ending the answer.
    quoted = words(
        package: "q",
        said: "-I'/inc/single quoted' -I\"/inc/double \\\"quoted\\\"\" '' -DX=\"$HOME\" -I/a\\\n/b -I/c\\"
    ).must()
    assert quoted == ["-I/inc/single quoted", "-I/inc/double \"quoted\"", "", "-DX=$HOME", "-I/a/b", "-I/c\\"]

    # A quote left open is refused, naming it.
    open_quote = words(package: "q", said: "-I'/inc/open")

    match open_quote
        .ok    => assert false
        .err e => assert e.msg == "heroes-ffi-package `q` answered with a `'` that nothing closes, which this compiler does not read: `-I'/inc/open`"

# pkgconf 3.0.7's answer for lane h158's `s7.pc`, `prefix=/opt/with space`
# (2026-10-02, defect 183): the path comes back as two words.
test "a word that is no flag is told with the line pkg-config printed and the word before it (defect 183)"
    said = "-I/opt/with space/include -L/opt/with space/lib\n"
    read = words(package: "s7", said: said).must()
    assert no_flag(said: said, parts: read, at: 1) == ": it is no flag, and `pkg-config` printed `-I/opt/with space/include -L/opt/with space/lib`, where whitespace nothing escapes stands between `-I/opt/with` and it, and ends a word\n  a path holding a space is one word only where `pkg-config` prints the space escaped, `\\ `, or inside quotes"
    assert no_flag(said: said, parts: read, at: 0) == ""
    alone = words(package: "f", said: "/opt/x/libfoo.a -lz").must()
    assert no_flag(said: "/opt/x/libfoo.a -lz", parts: alone, at: 0) == ": it is no flag, and `pkg-config` printed `/opt/x/libfoo.a -lz`\n  a path holding a space is one word only where `pkg-config` prints the space escaped, `\\ `, or inside quotes"
    assert one_line("-Ia\r\n-Lb\n") == "-Ia<U+000D><U+000A>-Lb"

# What a `.pc` can put in `pkg-config`'s answer reaches a message by its code
# (defect 237): a line end in a quoted word, which split the message's first
# line, a tab and a return; `pkg-config`'s own report keeps its lines.
test "a control character in pkg-config's text is written by its code, a line end among them (defect 237)"
    assert shown("a\tb\rc\nd", keep_lines: false) == "a<U+0009>b<U+000D>c<U+000A>d"
    assert shown("one\r\ntwo\rthree\n", keep_lines: true) == "one\ntwo<U+000D>three\n"
    assert shown("plain é ok", keep_lines: false) == "plain é ok"
    quoted = words(package: "q", said: "'x\ny' -lz").must()
    assert quoted[0] == "x\ny"
    assert no_flag(said: "'x\ny' -lz", parts: quoted, at: 0) == ": it is no flag, and `pkg-config` printed `'x<U+000A>y' -lz`\n  a path holding a space is one word only where `pkg-config` prints the space escaped, `\\ `, or inside quotes"
    open_line = words(package: "q", said: "-I'/a\nb")

    match open_line
        .ok    => assert false
        .err e => assert e.msg == "heroes-ffi-package `q` answered with a `'` that nothing closes, which this compiler does not read: `-I'/a<U+000A>b`"
