# The per-module build pipeline (panel 093 R1/R4; M-separate-compilation
# step 6): each module's translation unit compiled to its own cached
# object, then one link over all of them. The fused single unit stays
# the artifact path (--emit-c, the seed, the blessed emissions); this
# file is what `heroes build` and `heroes run` walk instead.
#
# THE KEY, per TU (panel 093 R4): the compiler fingerprint, the level,
# the sanitizer bit, the module name, the TU's own emitted text, the
# runtime's whole contents, the search paths, and the RESOLVED package
# cflags — machine state that changes with no source edit, so the name
# is not enough. **And, since defect 122, the C compiler and its flags**
# (`Toolchain.compiler_key`, what this machine's clang says it runs for the
# flag list), with the sanitizer flags themselves in place of the bit. The
# fingerprint is the Heroes `VERSION`, so until then an object compiled by
# Apple clang 21 was a warm hit for Homebrew clang 22.1.8, and one compiled
# without a flag for a compiler that passes it (panel 182's critic). Link names deliberately do NOT enter it: the link line
# is re-run on every build (it is one clang call over cached objects),
# so a `link` edit takes effect without a recompile — which is the
# 093 ffi-pragmatist's falsifier answered by construction.
#
# THE HEADERS ARE THE OTHER HALF, and they are checked rather than
# named (acceptance row 2's second half; `deps.hero` carries the
# reasoning). A `constant` an `extern` group takes from a header emits
# as `return CONF_LIMIT;` whatever the header says, so the key cannot
# see a header edit by construction — measured 2026-08-26 as a program
# printing `1` at exit 0 with the header on disk saying `2`. So every
# TU compile asks clang for its dependency listing and records what it
# read; a warm object is served only when every one of those files
# still hashes the same.
#
# **The comment that stood here said the fused path had the same gap
# and it was FALSE, measured both ways on the same witness**: the fused
# path cached no unit object then, recompiling its `.c` on every call,
# so it caught the edit and only this path missed it; since defect 134 it
# is compiled here, records and all. An untested "nothing regresses here"
# is CLAUDE.md §1's inference presented as a measurement.
#
# THE VERDICT ORDER (panel 093 R5): every dirty TU is compiled before
# any verdict is rendered, so a failure in the declaring module's TU is
# reported wherever the cache happens to be warm, and a cache hit can
# never convert a failing build into a passing one.

use source
use cli/io
use cli/clang_floor
use cli/deps
use cli/digest
use cli/flags
use cli/process
use cli/publish
use cli/toolchain
use cli/libraries
use cli/compiling
use cli/strings

# The distinct components of a compilation, in file-table order: the
# root first, then each `use`d module, then the library. The order is
# a function of the source table, so the link line is deterministic.
# ORDER: file-table order — s.files is built in load order, which is
# itself a function of the program's `use` graph.
function components(s: source.Source) -> [str]
    out: [str] @ []

    for entry in s.files
        already: bool @ false

        for one in out
            if one == entry.component
                already @ true

        if !already
            out @ out.push(entry.component)

    return out

# One TU compiled to its cached object. Everything lives under
# build/tu-<key>/, so a text or configuration change is a different
# directory; inside it the record `<m>.deps.txt` names the object
# `<m>-<digest>.o` and the warnings `warnings-<digest>.txt` of the compile
# whose headers it lists (`cli/deps.hero`), and a hit is that record still
# vouching for its files, with both artifacts there.
#
# `@memo` is one build's answers about files on disk, threaded through
# the whole loop: the 39 headers a trivial program reaches are 797 KB,
# and asking 157 translation units separately would be 125 MB of
# hashing — about 104 s at this compiler's measured 1.2 MB/s. Read
# once, hashed once, answered once per TU.
#
# **The key names every word the compile RECEIVES, from the list its line is
# built from** (`compiling.unit_words`, defect 167), each by its length
# (`libraries.key_text`), so a word that holds a space (defect 162) is never
# two. It named a package's whole answer until defect 161: a compile kept a
# package's `-I` alone under a key naming all of it, so the compiler that
# passes the rest replayed the object compiled without them, measured
# 2026-10-02 on one `build/`: a header returning 8 under its `.pc`'s `-D`
# printed 7. Until defect 167 it named the level, the sanitizers, the
# `--include` and `--library` directories and a package's compile words, and
# not the runtime's directory or the source's own, which its line searches:
# a unit's text names its root source in its first line, so no two
# directories met under one key, and that was a sentence of the text, not a
# fact the key asked. The words come after `words:`, so no key written before
# names the same text.
function tu_object(t: toolchain.Toolchain, module: str, tu_text: str, level: str, sanitize: bool, search: str, package_flags: [str], source_dir: str, search_include: [str], @memo: {str: str}) -> str?
    words = compiling.unit_words(
        compiling.Compiling(level: level, sanitize: sanitize, search_include: search_include, package_flags: package_flags, runtime: t.runtime, source_dir: source_dir)
    )
    key = digest.digest(
        t.fingerprint + "|tu|" + t.compiler_key + "|" + module + "|" + tu_text + "|" + t.runtime_key + "|" + search + "|words:" + libraries.key_text(words)
    )
    dir = t.build + "/tu-" + key
    process.mkdir_all(dir)?
    listed = dir + "/" + module + ".deps.txt"
    known = deps.vouched(listed, @memo)

    if !known.is_err()
        # A warm object REPLAYS the warnings its compile produced: the
        # flag set exists so a warning can falsify something (§7), and
        # a cache that swallows one on every hit after the first makes
        # the `ptr` lends-a-pointer warning — kept deliberately as the
        # type's declared limit — visible exactly once per edit.
        # Measured: suite_warnings went red on a warm cache before this
        # existed, on the program whose warnings are the expectation.
        kept = read_file(warnings_of(dir: dir, sum: known.must()))
        object = object_of(dir: dir, module: module, sum: known.must())

        if process.path_exists(object) && !kept.is_err()
            if kept.must().len() > 0
                io.eprint_raw(text: kept.must())
            return ok(object)

    # THE C IS PUBLISHED BEFORE CLANG READS IT, and it is keyed: the
    # directory is named by this very text, so a copy another build put
    # there is these bytes. It was written in place until defect 134, and
    # a clang could read it while another build truncated it.
    c_file = dir + "/" + module + ".c"
    publish.write_whole(path: c_file, text: tu_text, keyed: true)?

    # **Clang's three outputs are this compile's alone** (defects 057 and
    # 134). They were one name per directory, `<m>.o.tmp`, `<m>.d` and
    # `clang-stderr.txt`: six builds of one key started together failed five
    # of six, the first rename taking the object the others were about to
    # publish, and a build could read another's stderr torn, NUL bytes and
    # half a warning, and bake it into the replay below.
    err_path = publish.private_name(dir + "/clang-stderr.txt")
    staged = publish.private_name(dir + "/" + module + ".o")
    depfile = publish.private_name(dir + "/" + module + ".d")

    # `-MT dep` names the listing's target a word rather than a path,
    # so the reader cuts at the first `:` on a fact it chose. The
    # listing rides this compile; no second clang invocation exists.
    line: [str] @ strings.with_all(list: ["clang"], more: words)

    # `-fno-crash-diagnostics` (defect 170): a clang that dies writes no copy of
    # the unit and no script into the system's temporary folder (8,270,409
    # bytes of preprocessed C for 3,000 nested variants, measured 2026-10-03),
    # since the build says what died in its own words.
    line @ strings.with_all(
        list: line,
        more: ["-c", "-MD", "-MT", "dep", "-MF", depfile, "-fno-crash-diagnostics", c_file, "-o", staged]
    )

    # **What clang said is read once, and the words printed are the words
    # replayed** (defect 337): the replay below read the stream a second time
    # with `read_file`, so a warning holding a byte that is not UTF-8 replayed
    # as nothing on every warm build after the first.
    compiled = toolchain.asked_of_clang(line: line, what: "compiling the generated C", err_path: err_path)
    publish.discard(err_path)

    if compiled.is_err()
        publish.discard(staged)
        publish.discard(depfile)

        # The failing TU's path rides INSIDE the message: emit_ffi's
        # matchers read it line by line and ignore this one, so an
        # author-error still maps to their .hero line with no build/
        # path on screen — printing the path here unconditionally sent
        # `build/tu-…` into diagnostics the surface rows pin as
        # `err_lacks("build/")`, measured on the fixedbugs corpus.
        return fail(code: said_code(compiled), msg: failure_text(compiled) + "\nthe generated C is at " + c_file)
    said: str @ ""

    if strings.trimmed(compiled.must()).len() > 0
        said @ compiled.must()
        io.eprint_raw(text: said)
    rows = deps.rows_of(depfile: depfile, skip: dir + "/", @memo)
    publish.discard(depfile)

    if rows.is_err()
        publish.discard(staged)
        return fail(
            code: "failed",
            msg: "cannot record what " + module + "'s translation unit read: " + failure_text(rows)
        )
    listing = deps.pointer_text(rows.must())
    sum = listing.slice(from: 0, to: 16)

    # WRITTEN UNCONDITIONALLY, the empty case included (2026-09-14,
    # M-handle-verdict step 8): a clean recompile that left its
    # predecessor's file replayed warnings, with the line numbers of a
    # header that had been repaired, on every warm build after it. That is
    # the mirror of the swallowed warning the replay exists for, and the
    # same instrument, `suite_warnings`, catches both. Stderr that could not
    # be read back writes EMPTY: a compile whose warnings are unknown
    # replays none rather than somebody else's.
    #
    # THE RECORD IS PUBLISHED LAST, so whichever record a reader finds names
    # an object and warnings already in place, compiled from exactly the
    # files it lists. Both are keyed: the directory names the text and the
    # configuration, the digest every file the compile read.
    object = object_of(dir: dir, module: module, sum: sum)
    publish.publish(staged: staged, path: object, keyed: true)?
    publish.write_whole(path: warnings_of(dir: dir, sum: sum), text: said, keyed: true)?

    # Keyed in the one sense a record can be: any record another build
    # published names artifacts of its own compile, and they are there.
    publish.write_whole(path: listed, text: listing, keyed: true)?
    return ok(object)

# The object a record's digest names, and the warnings its compile said.
function object_of(dir: str, module: str, sum: str) -> str
    return dir + "/" + module + "-" + sum + ".o"

function warnings_of(dir: str, sum: str) -> str
    return dir + "/warnings-" + sum + ".txt"

function failure_note(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# The failure's own code, carried rather than restated: clang's refusal and
# a clang that could not start are two verdicts (`toolchain.run_clang`).
function failure_code(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

function failure_text(failed: str?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# The same code of a run that handed back what clang said
# (`toolchain.asked_of_clang`).
function said_code(failed: str?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

## Tests

test "a unit compiled under one clang answer is compiled again under another (defect 122)"
    here = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()

    # clang's own answer under one more flag, asked of the real compiler.
    more = strings.with_all(list: flags.flags(), more: ["-DHEROES_KEY_PROBE=1"])
    said = clang_floor.identity(build_dir: "build", runtime: here.runtime, words: more)
    other: toolchain.Toolchain @ here
    other.compiler_key @ digest.digest(more.join(" ") + "|" + toolchain.answer_text(said))
    text = "#include <stdint.h>\nint64_t heroes_key_probe(void);\nint64_t heroes_key_probe(void) { return 1; }\n"
    none: [str] = []
    memo: {str: str} @ {}
    first = tu_object(here, module: "keyprobe", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: none, @memo).must(
    )
    second = tu_object(other, module: "keyprobe", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: none, @memo).must(
    )

    # Another directory, compiled there, and the first still the first's.
    assert first != second
    assert process.path_exists(path: first)
    assert process.path_exists(path: second)
    again = tu_object(here, module: "keyprobe", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: none, @memo).must(
    )
    assert again == first

# **A record vouches for the object its own compile made, and for no other**
# (defect 134). The record of a newer compile used to stand beside the
# older object between two renames, and a build killed there, or two
# builds of one key taking turns, left a program printing 7 at exit 0 with
# its header saying 8. Now each header is another object's name, and a
# record whose object is gone is a recompile.
test "a record vouches only for the object its own compile made, and one whose object is gone is a recompile (defect 134)"
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-vouch"
    headers_at = "build/selftest-vouch-include"
    assert !process.remove_tree(t.build).is_err()
    assert !process.mkdir_all(headers_at).is_err()
    text = "#include \"vouch.h\"\nint64_t heroes_vouch(void);\nint64_t heroes_vouch(void) { return VOUCH; }\n"
    none: [str] = []
    assert !write_file(path: headers_at + "/vouch.h", text: "#include <stdint.h>\n#define VOUCH 1\n").is_err()
    one: {str: str} @ {}
    first = tu_object(t, module: "vouch", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: [headers_at], @one).must(
    )
    assert !write_file(path: headers_at + "/vouch.h", text: "#include <stdint.h>\n#define VOUCH 2\n").is_err()
    two: {str: str} @ {}
    second = tu_object(t, module: "vouch", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: [headers_at], @two).must(
    )
    assert second != first
    assert process.path_exists(first)
    assert !process.remove_file(second).is_err()
    three: {str: str} @ {}
    third = tu_object(t, module: "vouch", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: [headers_at], @three).must(
    )
    assert third == second
    assert process.path_exists(third)

    # And nothing private is left: every name in the directory is one a
    # reader asks for.
    for path in process.files_under(t.build).must()
        assert !strings.ends_with(text: path, suffix: ".tmp")

# **A package's compile words reach the unit, and its object is theirs**
# (defect 161). A `.pc`'s `-D` never reached clang, and the object compiled
# without it was keyed as if it had been, so the compiler that passed it
# replayed the old one (measured 2026-10-02: a header returning 8 under the
# package's `-D` printed 7).
test "a package's -D reaches the unit's compile, and an object is keyed by the words it was compiled with (defect 161)"
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-package-words"
    assert !process.remove_tree(t.build).is_err()
    text = "#include <stdint.h>\nint64_t heroes_package_value(void);\nint64_t heroes_package_value(void) { return HEROES_PACKAGE_VALUE; }\n"
    none: [str] = []
    memo: {str: str} @ {}

    # Without the package's word the unit does not compile, and nothing is
    # kept for the compile that has it to find.
    assert tu_object(t, module: "pkgwords", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: "", search_include: none, @memo).is_err(
    )
    seven = tu_object(t, module: "pkgwords", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: ["-DHEROES_PACKAGE_VALUE=7"], source_dir: "", search_include: none, @memo).must(
    )
    eight = tu_object(t, module: "pkgwords", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: ["-DHEROES_PACKAGE_VALUE=8"], source_dir: "", search_include: none, @memo).must(
    )
    assert eight != seven

    # A link word is no compile's: the same words, the same object.
    linked = tu_object(t, module: "pkgwords", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: ["-DHEROES_PACKAGE_VALUE=7", "-lz", "-framework", "Cocoa"], source_dir: "", search_include: none, @memo).must(
    )
    assert linked == seven

# **A unit's object is keyed by every word its line compiles under, the
# source's own directory among them** (defect 167, `compiling.unit_words`). One
# text compiled from two source directories, each with its own `beside.h`,
# is two objects. The key named no source directory until then; a unit's
# text kept two directories apart only because its first line names its root
# source, which this text does not.
test "a unit compiled beside two same-named headers is two objects, keyed by the source's own directory (defect 167)"
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    root = "build/selftest-units-dirs"
    t.build @ root + "/build"
    assert !process.remove_tree(root).is_err()
    one = root + "/one"
    two = root + "/two"

    for dir in [one, two]
        assert !process.mkdir_all(dir).is_err()

    assert !write_file(path: one + "/beside.h", text: "#define HERO_BESIDE 1\n").is_err()
    assert !write_file(path: two + "/beside.h", text: "#define HERO_BESIDE 2\n").is_err()
    text = "#include <stdint.h>\n#include <beside.h>\nint64_t heroes_beside(void);\nint64_t heroes_beside(void) { return HERO_BESIDE; }\n"
    none: [str] = []
    memo: {str: str} @ {}
    first = tu_object(t, module: "beside", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: one, search_include: none, @memo).must(
    )
    second = tu_object(t, module: "beside", tu_text: text, level: "-O0", sanitize: false, search: "", package_flags: none, source_dir: two, search_include: none, @memo).must(
    )
    assert first != second
    assert process.path_exists(path: first)
    assert process.path_exists(path: second)
