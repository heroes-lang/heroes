# The header's own type text for what an `@` parameter points at, and the
# two translation units the pointee check is made of (design.md §4.19;
# panel 103; M-robustness-guards step 3). `cli/pointee.hero` asks the
# question and runs clang; this file knows only how to write the two units
# and how to read clang's answer back.
#
# **Where the type text comes from.** One unit includes the program's
# headers and declares `extern __typeof__(*getline) hero_ty_getline;` per
# extern asked about; `clang -fsyntax-only -Xclang -ast-dump=json -Xclang
# -ast-dump-filter=hero_ty_` prints, for each, a `FunctionDecl` whose
# `ParmVarDecl` children carry the parameter types as the header spelled
# them — `size_t *restrict`, `int *`, `time_t *`. Measured identical on
# clang 18.1.8, 21.0.0 and 22.1.8, on the Mac, in the Linux image and on
# the Windows box; `desugaredQualType` is absent on parameters everywhere,
# which is why the JSON is only where the TEXT comes from and never the
# verdict.
#
# **Read by its shape, not by a JSON parser.** Three facts, all measured:
# the declaration is a `FunctionDecl` named `hero_ty_<name>`; its
# parameters follow as `ParmVarDecl`s, each with a `"qualType"`; the next
# `FunctionDecl` ends the list. A general JSON parser would be a second
# way to read a file this compiler writes the question for, and the shape
# is the contract — a fourth fact would be a fourth line here.
#
# **The verdict unit.** The same headers, then two `_Static_assert`s per
# parameter at the author's own `#line`: `sizeof` against the declared C
# type, and the sign of `(T)-1` — C11 arithmetic on the header's own type,
# never a width table this compiler carries. Its failure line carries
# `emit/ffi_pointee.hero`'s marker, which is how the answer finds the
# parameter.

use bytes
use emit/ffi_pointee
use emit/width_line
use emit/ffi_unit
use emit/ffi_read_only
use emit/lend_type
use cli/pointee_ask
use emit/c_text

constant PREFIX: str
    "hero_ty_"

## The two units

# The dump unit: the program's headers, then one `__typeof__` declaration
# per extern asked about — one per NAME, because two parameters of one
# function are read from one declaration.
function dump_unit(headers: [str], wanted: [pointee_ask.Pointee]) -> str
    lines: [str] @= c_text.includes(headers)

    named: [str] @= []

    for one in wanted
        already: bool @= false

        for seen in named
            if seen == one.name
                already @ true

        if !already
            named @ named.push(one.name)

            # Through `*` (defect 411, 2026-10-07): a function pointer the header
            # declares as a variable is read as the function it points at; at
            # the declaration's line, where clang tells it (defect 559).
            lines @ lines.push(c_text.line_directive(at: one.line, file: one.file))
            lines @ lines.push("extern __typeof__(*" + one.name + ") " + PREFIX + one.name + ";")

    return lines.join("\n") + "\n"

# The check unit: the same headers, then two assertions per parameter at
# the author's own line. `(T)-1 > 0` is the sign of an integer type in
# C11 arithmetic; for a float pointee the two sides agree and only
# `sizeof` decides, which is the right question for a float.
function check_unit(headers: [str], wanted: [pointee_ask.Pointee], types: {str: [str]}, sugar: {str: [str]}) -> str
    lines: [str] @= c_text.includes(headers)

    for one in answered(wanted, types: types, sugar: sugar)
        header_type = one.header_type
        asked = one.asked
        lines @ lines.push(c_text.line_directive(at: asked.line, file: asked.file))

        # **A lend's two asks** (panel 194's R7). Both name the pointee as
        # `*(P)0`, P the parameter's own type, so a pointer the header spells
        # through a typedef (`LPVOID`) or to an array (`int (*)[4]`) is read
        # as C reads it. The unit's line holds for every complete pointee and
        # for `void`, whose size is one byte under `-std=gnu11`, the dialect
        # `cli/flags.hero` names; an incomplete one is a hard error naming the
        # type, which `emit/ffi_unit.hero` reads back onto the parameter, so a
        # count C keeps in a type only it can size never reaches the main
        # unit. The whole record's line fails where the pointee is `void`,
        # through qualifiers and typedefs, which is defect 010's guard.
        if asked.declared == pointee_ask.UNIT
            lines @ lines.push(
                "_Static_assert(sizeof(*(" + header_type + ")0) > 0, \"" + ffi_unit.UNIT_MARKER + asked.name + " " + asked.param + " " + header_type + "\");"
            )
            continue

        if asked.declared == pointee_ask.WHOLE
            lines @ lines.push(
                "_Static_assert(!__builtin_types_compatible_p(__typeof__(*(" + header_type + ")0), void), \"" + ffi_unit.WHOLE_MARKER + asked.name + " " + asked.param + " " + header_type + "\");"
            )
            continue

        # A read-only lend's question and answer are `emit/ffi_read_only.hero`'s.
        if asked.declared == pointee_ask.READ || asked.declared == pointee_ask.ARITY
            lines @ lines.push(ffi_read_only.question(asked, header_type: header_type))
            continue

        # **A depth ask is one line and its own marker** (defect 083). The
        # guard against `void` is folded in, because `*(void *)0` is only a
        # warning on clang and the guard fails first as the marker line; the
        # second operand is C11 arithmetic on the header's own pointee —
        # `__builtin_classify_type` reads 5 for a pointer, 1 for an integer,
        # 8 for a real, 12 for a struct, measured on clang 21 and 22 — so a
        # header that takes one pointer where the program hands the address
        # of its cell fails here, at the author's line, and never reaches C.
        if asked.depth
            lines @ lines.push(
                "_Static_assert(!__builtin_types_compatible_p(" + header_type + ", void) && __builtin_classify_type(*(" + header_type + " *)0) == 5, \"" + ffi_pointee.DEPTH_MARKER + asked.name + " " + asked.param + " " + asked.declared + " " + header_type + "\");"
            )
            continue

        # **The guard comes first, and it exists because `sizeof(void)` is not
        # an assertion failure** (defect 010, 2026-09-04). `@value: i32`
        # against `void *optval` made the width line below a hard error —
        # `invalid operands to binary expression ('void' and 'int')` — a line
        # no reader knows, so the compiler called it its own internal error
        # at exit 2 where §7 owes exit 1 on the author's line. This line
        # fails as a `static assertion failed` carrying its own marker, and
        # `__builtin_types_compatible_p` rather than the type's spelling,
        # because it ignores qualifiers and sees through typedefs: `const
        # void` and Win32's `VOID` are both caught, measured. The width line
        # still hard-errors after it, on the same `#line`; the reader takes
        # the first diagnostic per span and the second line matches nothing.
        lines @ lines.push(
            "_Static_assert(!__builtin_types_compatible_p(" + header_type + ", void), \"" + ffi_pointee.VOID_MARKER + asked.name + " " + asked.param + " " + asked.declared + " " + header_type + "\");"
        )
        lines @ lines.push(width_line.width_assertions(asked, header_type: header_type))

    return lines.join("\n") + "\n"

# Every ask the dump could answer, with the header's own pointee text. Shared
# between the unit above and the reader of its failures (`emit/ffi.hero`),
# because an incomplete type fails as a hard error naming only the TYPE —
# `invalid application of 'sizeof' to an incomplete type 'struct opaque'` —
# and the parameter has to be found from it. An ask the dump did not serve
# (a macro name, a by-value parameter) is left out, exactly as before.
function answered(wanted: [pointee_ask.Pointee], types: {str: [str]}, sugar: {str: [str]}) -> [pointee_ask.Answered]
    out: [pointee_ask.Answered] @= []

    for one in wanted
        params = types[one.name]

        if params.is_err() || one.declared == pointee_ask.READ || one.declared == pointee_ask.ARITY
            continue

        if one.index >= params.must().len()
            continue
        written = params.must()[one.index]

        # A lend's asks keep the parameter's type whole, and only where it is
        # a pointer as clang reads it through every typedef: one the header
        # takes by value is the call's own refusal, at the call.
        if one.declared == pointee_ask.UNIT || one.declared == pointee_ask.WHOLE
            through: str @= desugared_at(sugar, name: one.name, index: one.index)

            if through.len() == 0
                through @ written

            if !last_star(through).is_err()
                out @ out.push(
                    pointee_ask.Answered(asked: one, header_type: written, pointee: pointee_of(through).default(""))
                )
            continue
        pointed = pointee_of(written)

        if pointed.is_err()
            continue
        out @ out.push(pointee_ask.Answered(asked: one, header_type: pointed.must(), pointee: ""))

    return ffi_read_only.lend_answers(out, wanted, types: types, sugar: sugar)

# What clang read a parameter's type as through every typedef, or empty where
# the dump gave no `desugaredQualType`, which it leaves out when the two agree.
function desugared_at(sugar: {str: [str]}, name: str, index: i64) -> str
    found = sugar[name]

    if found.is_err() || index >= found.must().len()
        return ""
    return found.must()[index]

# The unit each counted parameter's count is compared in, as the header
# spells the parameter, keyed `<C name> <position>`: what `emit/ctype.Names`
# carries to `emit/lend_extent.hero` (panel 194's R7, defects 092 and 395).
function lend_units(answers: [pointee_ask.Answered]) -> {str: str}
    out: {str: str} @= {}

    for one in answers
        if one.asked.declared == pointee_ask.UNIT
            out[one.asked.name + " " + one.asked.index.to_str()] @ one.header_type

    return lend_type.with_read_casts(out, answers)

# What a header's parameter type points at: the text before its last `*`,
# with `restrict` and `__restrict` gone. Absent when the header takes the
# parameter by value — then the declaration is wrong in a way the probe
# already reports.
function pointee_of(qual_type: str) -> str?
    star = last_star(qual_type)

    if star.is_err()
        return fail(code: "none", msg: "not a pointer")
    before = trimmed(qual_type.slice(from: 0, to: star.must()))
    without = trimmed(strip_word(text: strip_word(text: before, word: "__restrict"), word: "restrict"))

    if without.len() == 0
        return fail(code: "none", msg: "nothing pointed at")
    return ok(without)

function last_star(text: str) -> i64?
    index: i64 @= text.len() - 1

    while index >= 0
        if text[index] == '*'
            return ok(index)
        index @ index - 1

    return fail(code: "none", msg: "no star")

# `text` without `word` at its end. Asked of the bytes: a pointee named above
# ASCII, `aébbbbbbb`, put the cut for `restrict` inside its `é` (found beside
# defect 110, 2026-09-27).
function strip_word(text: str, word: str) -> str
    if bytes.bytes_at(text: text, at: text.len() - word.len(), needle: word)
        return text.slice(from: 0, to: text.len() - word.len())
    return text

## Reading the dump

# The parameter types clang reports for `hero_ty_<name>`, in order. The
# JSON is scanned as text, on three facts about the dump's shape measured
# on clang 18, 21 and 22: the declaration is a `FunctionDecl` named
# `hero_ty_<name>`; its parameters follow as `ParmVarDecl`s, each with a
# `"qualType"` in its `"type"`; and the next `FunctionDecl` ends the list.
# A general JSON parser would be a second way to read a file this compiler
# writes the question for, and the shape is the contract.
function parameter_types(json: str, name: str) -> [str]
    out: [str] @= []
    opened = locate_text(text: json, needle: "\"name\": \"" + PREFIX + name + "\"", from: 0)

    if opened.is_err()
        return out
    at: i64 @= opened.must()
    stop = locate_text(text: json, needle: "\"kind\": \"FunctionDecl\"", from: at)
    limit: i64 @= json.len()

    if !stop.is_err()
        limit @ stop.must()

    while true
        param = locate_text(text: json, needle: "\"kind\": \"ParmVarDecl\"", from: at)

        if param.is_err() || param.must() >= limit
            break
        typed = locate_text(text: json, needle: "\"qualType\": \"", from: param.must())

        if typed.is_err() || typed.must() >= limit
            break
        start = typed.must() + 13
        close = locate_text(text: json, needle: "\"", from: start)

        if close.is_err()
            break
        out @ out.push(json.slice(from: start, to: close.must()))
        at @ close.must()

    return out

# The parameter types for every asked-about extern, keyed by name.
function types_of(json: str, wanted: [pointee_ask.Pointee]) -> {str: [str]}
    out: {str: [str]} @= {}

    for one in wanted
        if out[one.name].is_err()
            out[one.name] @ parameter_types(json: json, name: one.name)

    return out

# The same parameters through every typedef: each `ParmVarDecl`'s
# `desugaredQualType`, which the dump writes before its `qualType` inside one
# `"type"` and leaves out where the two agree (then empty here). A fourth fact
# of the dump's shape, measured on Apple clang 21.0.0 for `LPVOID`, `size_t`
# and a function's own `typeof`; read for a lend's asks alone (panel 194's R7).
function parameter_sugar(json: str, name: str) -> [str]
    out: [str] @= []
    opened = locate_text(text: json, needle: "\"name\": \"" + PREFIX + name + "\"", from: 0)

    if opened.is_err()
        return out
    at: i64 @= opened.must()
    stop = locate_text(text: json, needle: "\"kind\": \"FunctionDecl\"", from: at)
    limit: i64 @= json.len()

    if !stop.is_err()
        limit @ stop.must()

    while true
        param = locate_text(text: json, needle: "\"kind\": \"ParmVarDecl\"", from: at)

        if param.is_err() || param.must() >= limit
            break
        typed = locate_text(text: json, needle: "\"qualType\": \"", from: param.must())

        if typed.is_err() || typed.must() >= limit
            break
        plain = locate_text(text: json, needle: "\"desugaredQualType\": \"", from: param.must())
        found: str @= ""

        if !plain.is_err() && plain.must() < typed.must()
            start = plain.must() + 22
            close = locate_text(text: json, needle: "\"", from: start)

            if !close.is_err()
                found @ json.slice(from: start, to: close.must())
        out @ out.push(found)
        at @ typed.must() + 13

    return out

function sugar_of(json: str, wanted: [pointee_ask.Pointee]) -> {str: [str]}
    out: {str: [str]} @= {}

    for one in wanted
        if out[one.name].is_err()
            out[one.name] @ parameter_sugar(json: json, name: one.name)

    return out

# Byte offset of `needle` in `text` at or after `from`, over bytes. **The
# dump is not ASCII where the author's header is not** (found beside defect
# 110, 2026-09-27): this asked the first byte and then sliced, and a type
# named above ASCII, `typedef int 漢;`, put the end of a candidate inside a
# character, so `build` aborted on a binding `check` accepts. Every byte is
# asked now, and nothing is cut until a match says where.
function locate_text(text: str, needle: str, from: i64) -> i64?
    if needle.len() == 0 || from < 0
        return fail(code: "none", msg: "nothing to find")
    index: i64 @= from

    while index + needle.len() <= text.len()
        if bytes.bytes_at(text: text, at: index, needle: needle)
            return ok(index)
        index @ index + 1

    return fail(code: "none", msg: "not found")

function trimmed(text: str) -> str
    start: i64 @= 0
    stop: i64 @= text.len()

    while start < stop && text[start] == ' '
        start @ start + 1

    while stop > start && text[stop - 1] == ' '
        stop @ stop - 1

    return text.slice(from: start, to: stop)

## Tests

test "the dump is read by its shape: the k-th ParmVarDecl's qualType, and the next FunctionDecl ends the list"
    json = "{\"kind\": \"FunctionDecl\", \"name\": \"hero_ty_getline\", \"inner\": [{\"kind\": \"ParmVarDecl\", \"type\": {\"qualType\": \"char **restrict\"}}, {\"kind\": \"ParmVarDecl\", \"type\": {\"desugaredQualType\": \"unsigned long *\", \"qualType\": \"size_t *restrict\"}}, {\"kind\": \"ParmVarDecl\", \"type\": {\"qualType\": \"FILE *restrict\"}}]}\n{\"kind\": \"FunctionDecl\", \"name\": \"hero_ty_frexp\", \"inner\": [{\"kind\": \"ParmVarDecl\", \"type\": {\"qualType\": \"double\"}}, {\"kind\": \"ParmVarDecl\", \"type\": {\"qualType\": \"int *\"}}]}\n"
    got = parameter_types(json: json, name: "getline")
    assert got.len() == 3
    assert got[1] == "size_t *restrict"
    assert parameter_types(json: json, name: "frexp") == ["double", "int *"]
    assert parameter_types(json: json, name: "absent").len() == 0

test "what is pointed at: the text before the last star, restrict gone, by-value absent"
    assert pointee_of("size_t *restrict").must() == "size_t"
    assert pointee_of("unsigned long *").must() == "unsigned long"
    assert pointee_of("const int *").must() == "const int"
    assert pointee_of("char **restrict").must() == "char *"
    assert pointee_of("double").is_err()

    # Names above ASCII, where the cut for `restrict` and a search's end fall
    # inside a character.
    assert pointee_of("aébbbbbbb *").must() == "aébbbbbbb"
    assert pointee_of("漢 *restrict").must() == "漢"
    assert pointee_of("€€€ *__restrict").must() == "€€€"
    assert strip_word(text: "é", word: "restrict") == "é"

test "the dump is searched by its bytes, and a type named above ASCII is read whole"
    json = "{\"kind\": \"FunctionDecl\", \"name\": \"hero_ty_takes\", \"inner\": [{\"kind\": \"ParmVarDecl\", \"type\": {\"desugaredQualType\": \"int *\", \"qualType\": \"漢éé *\"}}]}\n{\"kind\": \"FunctionDecl\", \"name\": \"hero_ty_hero_file_read\", \"inner\": []}\n"
    assert parameter_types(json: json, name: "takes") == ["漢éé *"]
    assert parameter_types(json: json, name: "hero_file_read").len() == 0
    assert locate_text(text: "é漢😀x", needle: "x", from: 0).must() == 9
    assert locate_text(text: "é漢😀x", needle: "漢", from: 1).must() == 2
    assert locate_text(text: "é漢😀x", needle: "\"", from: 0).is_err()

test "the check unit asserts width and sign at the author's line, with the marker"
    wanted: [pointee_ask.Pointee] = [
        pointee_ask.Pointee(name: "getline", param: "n", index: 1, declared: "int32_t", file: "t.hero", line: 2, depth: false)
        pointee_ask.Pointee(name: "frexp", param: "e", index: 1, declared: "int32_t", file: "t.hero", line: 3, depth: false)
        pointee_ask.Pointee(name: "eat", param: "p", index: 0, declared: "handle", file: "t.hero", line: 4, depth: true)
    ]
    types: {str: [str]} @= {}
    types["getline"] @ ["char **restrict", "size_t *restrict", "FILE *restrict"]
    types["frexp"] @ ["double", "int *"]
    types["eat"] @ ["void *"]
    headers: [str] = ["stdio.h", "math.h"]
    none: {str: [str]} = {}
    unit = check_unit(headers, wanted, types: types, sugar: none)
    assert unit.slice(from: 0, to: 18) == "#include <stdio.h>"
    assert locate_text(text: unit, needle: "#line 2 \"t.hero\"", from: 0).must() > 0
    assert locate_text(text: unit, needle: "_Static_assert(!(!(sizeof(size_t) == sizeof(int32_t) && (((size_t)-1 > 0) == ((int32_t)-1 > 0))) && sizeof(size_t) * 8 == 64), \"heroes-ffi-pointee-bits getline n int32_t 64 size_t\");", from: 0).must() > 0
    assert locate_text(text: unit, needle: "sizeof(size_t) * 8 == 128, \"heroes-ffi-pointee getline n int32_t size_t\");", from: 0).must() > 0
    assert locate_text(text: unit, needle: "heroes-ffi-pointee frexp e int32_t int\"", from: 0).must() > 0
    assert locate_text(text: unit, needle: "_Static_assert(!__builtin_types_compatible_p(void, void) && __builtin_classify_type(*(void *)0) == 5, \"heroes-ffi-pointee-depth eat p handle void\");", from: 0).must() > 0
    assert locate_text(text: unit, needle: "sizeof(handle)", from: 0).is_err()
    dumped = dump_unit(headers, wanted)
    assert locate_text(text: dumped, needle: "extern __typeof__(*getline) hero_ty_getline;", from: 0).must() > 0
