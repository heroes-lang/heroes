# What clang's words say of a refused unit's first error: its row, its
# place and its message, the includes above it, the notes under it, the group
# whose header it lies in and another group a note names (design.md §4.19,
# §4.17; defects 360, 538, 550 and 557). Split out of
# `cli/header_refused.hero` on 2026-10-10, past §11's 300 lines once a
# header refused in a unit was also asked whether it compiles alone: that
# file tells what this one reads.

use source
use ast
use emit/clang_place
use emit/ffi_lookup
use cli/group_file
use cli/runtime_key
use cli/standard_name
use cli/runtime_name

# clang's first error, read: its row in the text, its place, and its message.
record First
    row: i64
    place: clang_place.Place
    message: str

constant ERROR: str
    ": error: "

constant FATAL: str
    ": fatal error: "

constant NOTE: str
    ": note: "

constant NOT_FOUND: str
    "' file not found"

# The two notes clang writes for a macro's expansion, word for word
# (`DiagnosticRenderer`'s backtrace): where a macro the error's tokens came
# from was defined, and where an argument of one was written.
constant FROM_MACRO: str
    "expanded from macro '"

constant FROM_HERE: str
    "expanded from here"

# Whether a note is one of a macro's expansion, by clang's words for it.
function expansion(text: str) -> bool
    at = clang_place.offset_of(text: text, needle: FROM_MACRO)
    return !at.is_err() && at.must() == 0 || text == FROM_HERE

# What clang's words say of a header: its first error, the includes above
# it, the group whose header the error lies in, its notes, and the other
# group a note names, where one does. Absent where the first error is no
# group's header's, is a missing file, or lies in or is explained by a file
# of the compiler's own, the one clang compiled or the runtime's
# (`group_file.compilers`), save a note at the runtime's line declaring a
# name of C's `<stdint.h>` again as C does, which is C's own and told so
# (`cli/standard_name.hero`, defect 2044), and one at the runtime's own
# declaration of the very name the header declares again, which is the
# header's to rename and told so (`cli/runtime_name.hero`, defect 2045).
record Reading
    rows: [str]
    first: First
    steps: [clang_place.Place]
    at: i64
    group: group_file.Group
    notes: [Attached]
    beside: group_file.Reached?
    note: Attached

function reading(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str) -> Reading?
    rows = ffi_lookup.lines(text: stderr)
    first = first_error(rows)?

    if !clang_place.offset_of(text: first.message, needle: NOT_FOUND).is_err()
        return fail(code: "none", msg: "a missing header")
    steps = clang_place.stack(stderr: stderr, line: rows[first.row])

    # The compiler's own files, by what they are and never by a folder
    # (defect 2035): the file clang compiled heads the stack, which clang
    # prints for every diagnostic in a file the compiled one includes, and
    # the runtime's are those `runtime.c` names. So the search never names a
    # group in either, wherever the program's own files stand.
    compiled = steps[0].path
    own = runtime_key.made_of(runtime)?
    at: i64 @= steps.len() - 1
    group: group_file.Group? @= fail(code: "none", msg: "no group's header is in the stack")

    while at >= 0 && group.is_err()
        if !group_file.compilers(path: steps[at].path, compiled: compiled, runtime: own)
            group @ group_file.group_of(s, decls, path: steps[at].path)

        if group.is_err()
            at @ at - 1

    if group.is_err()
        return fail(code: "none", msg: "no group's header is in the stack")
    hop: i64 @= at

    while hop < steps.len()
        if group_file.compilers(path: steps[hop].path, compiled: compiled, runtime: own)
            return fail(code: "none", msg: "a file of the compiler's own")
        hop @ hop + 1

    no_name: str? = fail(code: "none", msg: "no name of C's")
    no_note = Attached(
        path: "",
        row: 0,
        text: "",
        index: 0,
        standard: no_name,
        runtime: no_name,
        called: no_name,
        suggested: no_name
    )
    notes: [Attached] @= []

    # A note in a file of the compiler's own makes the refusal the compiler's,
    # save one the header's own line explains (`explaining`).
    for note in attached(rows, after: first.row)
        if group_file.compilers(path: note.path, compiled: compiled, runtime: own)
            explained = explaining(rows: rows, first: first, note: note, runtime: own)

            if explained.is_err()
                return fail(code: "none", msg: "a note in a file of the compiler's own")
            notes @ notes.push(explained.must())
        else
            notes @ notes.push(note)

    # A note in ANOTHER group's header, or in a file one includes: the two
    # are refused together, and neither alone (defect 538,
    # `cli/headers_together.hero`). The group is the innermost of the note's
    # own includes that is one, which clang prints since panel 202's (g)
    # (defect 550): until then a note in a file another group's header
    # includes named no group, and one order was told as one header.
    #
    # **A macro's expansion is where the error's own tokens were written,
    # never a second header** (defect 2040): `NULL` passed to a `nonnull`
    # parameter is noted *expanded from macro 'NULL'* at its definition, and
    # a macro of another group's header the refused one includes was told as
    # the two refused together, though the refused one fails alone. A header
    # that compiles alone and fails after another's macro is still told as
    # two, by compiling it alone (`cli/header_alone.hero`, defect 557).
    for note in notes
        if expansion(note.text)
            continue
        reached = group_file.arriving(
            stderr: stderr,
            row: rows[note.index],
            s: s,
            decls: decls,
            compiled: compiled,
            runtime: own
        )

        if !reached.is_err() && reached.must().group.header != group.must().header
            return ok(
                Reading(rows: rows, first: first, steps: steps, at: at, group: group.must(), notes: notes, beside: reached, note: note)
            )

    nobody: group_file.Reached? = fail(code: "none", msg: "no other group")
    return ok(
        Reading(rows: rows, first: first, steps: steps, at: at, group: group.must(), notes: notes, beside: nobody, note: no_note)
    )

# A note at a line of the runtime's own files that the header's line,
# clang's first error, explains, read as the first of four readings that
# names it; absent for any other note, which leaves the refusal the
# compiler's. The runtime's re-declaration of a name of `<stdint.h>`
# (defect 2044): the header declares, or misspells, a type C itself
# declares, and is refused beside any `<stdint.h>` as it is beside the
# runtime, which declares it identically before the groups. The runtime's
# own declaration of the very name the error's caret stands on (defect
# 2045): the header declares again a name the Heroes runtime declares in
# every unit before any group's header. And a function of the runtime's the
# line calls, or a name of the runtime's clang suggests for one the line
# misspells (defect 2049): the line uses a name of the runtime's that every
# unit declares before any group's header (`cli/runtime_name.hero`).
function explaining(rows: [str], first: First, note: Attached, runtime: [str]) -> Attached?
    out: Attached @= note
    out.standard @ standard_name.declared(path: note.path, row: note.row, runtime: runtime)

    if !out.standard.is_err()
        return ok(out)
    out.runtime @ runtime_name.declared(
        rows: rows,
        error: first.row,
        note: note.index,
        path: note.path,
        row: note.row,
        runtime: runtime
    )

    if !out.runtime.is_err()
        return ok(out)
    out.called @ runtime_name.called(rows: rows, error: first.row, path: note.path, row: note.row, runtime: runtime)

    if !out.called.is_err()
        return ok(out)
    out.suggested @ runtime_name.suggested(
        rows: rows,
        message: first.message,
        note: note.index,
        path: note.path,
        row: note.row,
        runtime: runtime
    )

    if !out.suggested.is_err()
        return ok(out)
    return fail(code: "none", msg: "a note no reading of the header's line explains")

# The first row clang wrote as an error with a place, `path:row:col: error:`
# or `fatal error:`. A row its excerpt quotes begins with a space, and a
# warning or a note before it is passed over.
function first_error(rows: [str]) -> First?
    index: i64 @= 0

    for row in rows
        line = clang_place.without_return(row)
        severity = severity_of(line)

        if line.len() > 0 && line[0] != ' ' && (severity == ERROR || severity == FATAL)
            place = clang_place.place(line)

            if !place.is_err()
                at = clang_place.offset_of(text: line, needle: severity).must()
                return ok(
                    First(row: index, place: place.must(), message: line.slice(from: at + severity.len(), to: line.len()))
                )
        index @ index + 1

    return fail(code: "none", msg: "clang reported no error with a place")

# The severity a diagnostic line is written with: the first of clang's
# markers on it, so a message that quotes another is still its own.
function severity_of(line: str) -> str
    first: i64 @= line.len()
    which: str @= ""

    for marker in [FATAL, ERROR, ": warning: ", NOTE]
        at = clang_place.offset_of(text: line, needle: marker)

        if !at.is_err() && at.must() < first
            first @ at.must()
            which @ marker

    return which

# A note clang attached to the error: where it points and what it says, and
# the name of C's `<stdint.h>` the runtime's line it points at declares
# again, where it points at one (`cli/standard_name.hero`, defect 2044), or
# the name of the Heroes runtime's own it points at, which the header
# declares again (`cli/runtime_name.hero`, defect 2045), calls, or misspells
# as clang suggests (defect 2049).
record Attached
    path: str
    row: i64
    text: str
    index: i64
    standard: str?
    runtime: str?
    called: str?
    suggested: str?

# The notes clang wrote under the error, up to the next diagnostic that is
# not a note or clang's count of what it reported. A note's own includes
# stand above it (`-fdiagnostics-show-note-include-stack`, panel 202's (g)),
# so an include line is passed over, and the next diagnostic decides.
function attached(rows: [str], after: i64) -> [Attached]
    out: [Attached] @= []
    index: i64 @= after + 1
    no_name: str? = fail(code: "none", msg: "no name of C's")

    while index < rows.len()
        line = clang_place.without_return(rows[index])

        if line.len() > 0 && line[0] != ' ' && clang_place.included(line).is_err()
            if severity_of(line) != NOTE
                return out
            place = clang_place.place(line)

            if !place.is_err()
                at = clang_place.offset_of(text: line, needle: NOTE).must()
                out @ out.push(
                    Attached(path: place.must().path, row: place.must().row, text: line.slice(from: at + NOTE.len(), to: line.len()), index: index, standard: no_name, runtime: no_name, called: no_name, suggested: no_name)
                )
        index @ index + 1

    return out
