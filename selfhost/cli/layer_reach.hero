# Which of the platform layer's members written in Swift a program reaches,
# so a build compiles those and no other (design.md §4.19, §1.11; panel 253's
# R3; defect 2625). A Swift member is compiled with `swiftc`, which costs a
# fresh folder's first build about as much again as the rest of it
# (`cli/layer_swift.hero`), and the linker takes its object only into a
# program that takes the C member calling it, so a program that reaches no
# such C member pays for an object it never links.
#
# **The reach is read from the runtime's own text, never assumed of it.** A
# Swift member is called through its C header, `platform/<member>.h`, which
# its callers include. A program reaches the layer through the headers its
# groups name (`extern "hero_crypto.h"`), and a header reaches every file it
# includes; a C member of the layer, `platform/<name>.c`, is reached where
# its own header `<name>.h` is, and reaches every file it includes. So the
# headers reached are closed over those includes, each file of the runtime
# read once, and a Swift member is compiled where its C header is among
# them. Every include counts, under whatever condition it stands, so the
# reach errs only toward compiling a member no link takes.
#
# **What it cannot see**: a program binding a function of the layer through a
# header of its own that declares it and includes none of the layer's. That
# link leaves the Swift member's names undefined and does not link, so no
# program is ever built with a member left out.

use ast
use check/layer_header
use cli/flags
use cli/io
use cli/layer
use cli/layer_swift
use cli/libraries
use cli/link
use cli/link_flags
use cli/process
use cli/runtime_key
use cli/strings
use cli/supplied
use cli/toolchain
use emit/externs as emit_externs
use module/reading
use parse
use source
use token

# The platform layer's archive for a build of the program whose declarations
# are `decls`, holding the Swift members its groups reach; its failure told as
# the runtime object's is (`cli/produce.hero`, defect 134): a member clang
# refused is the compiler's, *internal error* with clang's words; any other
# failure is the machine's, said as itself by the caller.
#
# **None where no group of the program says `layer`** (panel 260; design.md
# §1.11): the layer is linked into a program that says it needs it, by a group
# whose header is or reaches the layer's (`check/layer_header.hero`,
# `cli/layer_bound.hero`), and into no other, so a program that says it
# nowhere asks no member what it reaches, compiles none and links none. **And
# none where the build `links` nothing** (`--emit-c`): the archive is a
# word of the link line alone (`assemble.linked_round`), so a build that
# writes C and links nothing asks the layer nothing. Measured on this Mac on
# 2026-11-25 (load 8 to 9): asking the 43 members what they reach, one clang
# each, cost every warm build 2.4 s, and every emission paid it for a link it
# never makes.
function for_build(t: toolchain.Toolchain, level: str, sanitize: bool, s: source.Source, decls: [ast.Decl], links: bool) -> [str]?
    unlinked: [str] = []

    if !links || !layer_header.declared(decls)
        return ok(unlinked)
    swift = reached(t, named: headers_of(s, decls))?
    made = layer.archive(t, level: level, sanitize: sanitize, swift: swift)

    match made
        .ok words => return ok(words)
        .err e =>
            if e.code == "clang"
                io.eprint(text: "internal error: the platform layer did not compile\n" + e.msg)
                return fail(code: "failed", msg: "no platform layer")
            return fail(code: "failed", msg: e.msg)

# The Swift members a program reaching none of them compiles.
function no_members() -> [str]
    nothing: [str] = []
    return nothing

# The headers the groups of `decls` name, each once, as written between the
# quotes.
function headers_of(s: source.Source, decls: [ast.Decl]) -> [str]
    out: [str] @= []

    for d in decls
        header = header_of(d)

        if !header.is_err()
            out @ once(out, name: emit_externs.unquoted(s, span: header.must()))

    return out

# The header of the group `d` is a member of; none outside a group.
function header_of(d: ast.Decl) -> token.Span?
    none: token.Span? = fail(code: "none", msg: "no group")

    match d.kind
        .function_decl fd          => return fd.value.header
        .constant_decl k           => return k.header
        .record_decl rec           => return rec.header
        .variant_decl | .test_decl => return none

    return none

# The Swift members of `t`'s layer the headers `named` reach, in the layer's
# order; none off an Apple target, where no member is Swift.
function reached(t: toolchain.Toolchain, named: [str]) -> [str]?
    members = layer_swift.members(t)?
    none: [str] = []

    if members.len() == 0
        return ok(none)
    files = runtime_key.made_of(t.runtime)?
    reach: [str] @= []

    for name in named
        reach @ once(reach, name: base_of(name))

    read: [bool] @= []

    for _ in files
        read @ read.push(false)

    grew: bool @= true

    while grew
        grew @ false
        at: i64 @= 0

        for file in files
            if !read[at] && opens_into(file: file, reach: reach)
                read[at] @ true
                grew @ true

                for name in includes(reading.text_of(file)?)
                    reach @ once(reach, name: base_of(name))
            at @ at + 1

    out: [str] @= []

    for member in members
        if has(reach, name: layer_swift.name_of(member) + ".h")
            out @ out.push(member)

    return ok(out)

# Whether the runtime's `file` is reached: a header that is, or a C member of
# the layer whose own header is.
function opens_into(file: str, reach: [str]) -> bool
    base = base_of(file)

    if ends_with(text: base, suffix: ".h")
        return has(reach, name: base)

    if ends_with(text: base, suffix: ".c") && has_part(text: file, part: "/platform/")
        return has(reach, name: base.slice(from: 0, to: base.len() - 2) + ".h")
    return false

# Every include of a C text, quoted or angled, `# include "x.h"` and an
# indented one among them, in the order written: the runtime's members write
# their own headers quoted, and a program's unit writes a group's header
# angled (`emit/c_text.hero`).
function includes(text: str) -> [str]
    out: [str] @= []
    at: i64 @= 0

    while at < text.len()
        stop: i64 @= at

        while stop < text.len() && text[stop] != '\n'
            stop @ stop + 1

        i: i64 @= blanks(text, from: at, to: stop)

        if i < stop && text[i] == '#'
            i @ blanks(text, from: i + 1, to: stop)
            word = "include"

            if i + word.len() <= stop && text.slice(from: i, to: i + word.len()) == word
                i @ blanks(text, from: i + word.len(), to: stop)

                if i < stop && (text[i] == '"' || text[i] == '<')
                    close: u8 @= '"'

                    if text[i] == '<'
                        close @ '>'
                    shut: i64 @= i + 1

                    while shut < stop && text[shut] != close
                        shut @ shut + 1

                    if shut < stop
                        out @ out.push(text.slice(from: i + 1, to: shut))
        at @ stop + 1

    return out

# The first offset from `from` before `to` that is no space or tab.
function blanks(text: str, from: i64, to: i64) -> i64
    i: i64 @= from

    while i < to && (text[i] == ' ' || text[i] == '\t')
        i @ i + 1

    return i

# A path's last part.
function base_of(path: str) -> str
    cut: i64 @= path.len()

    while cut > 0 && path[cut - 1] != '/'
        cut @ cut - 1

    return path.slice(from: cut, to: path.len())

function once(names: [str], name: str) -> [str]
    if has(names, name: name)
        return names
    return names.push(name)

function has(names: [str], name: str) -> bool
    for one in names
        if one == name
            return true

    return false

function ends_with(text: str, suffix: str) -> bool
    return text.len() >= suffix.len() && text.slice(from: text.len() - suffix.len(), to: text.len()) == suffix

function has_part(text: str, part: str) -> bool
    at: i64 @= 0

    while at + part.len() <= text.len()
        if text.slice(from: at, to: at + part.len()) == part
            return true
        at @ at + 1

    return false

# `t` with the platform layer on every link a build of `decls` makes, its
# own and the value probe's (`cli/value_run.hero`), exactly where a group of
# the program says `layer` (panel 260; `for_build` asks the same of it).
function linked_toolchain(t: toolchain.Toolchain, decls: [ast.Decl]) -> toolchain.Toolchain
    out: toolchain.Toolchain @= t
    out.layered @ layer_header.declared(decls)
    return out

## Tests

# The words that load the archive `path` whole on `target`'s linker, every
# member taken whether a program calls it or not: GNU ld's and lld's
# `--whole-archive` around it, Apple's `-force_load`, and on an MSVC target
# the archive beside `/WHOLEARCHIVE:` of it, as the supplied probes hand a
# library to both linkers there (`cli/supplied_probe.hero`, measured on the
# Windows box by its name; by its path, unrun there until the CI's leg).
function whole_words(target: str, path: str) -> [str]
    if link_flags.apple(target)
        return ["-Wl,-force_load," + path]

    if link_flags.msvc(target)
        return [path, "-Wl,/WHOLEARCHIVE:" + path]
    return ["-Wl,--whole-archive", path, "-Wl,--no-whole-archive"]

# A `main` of nothing linked with the runtime's object and every member of the
# layer, the C ones and on an Apple target the Swift ones, by the link every
# build runs (`link.link_objects`), at `level`, sanitised or not, and then run:
# "" where it linked and ran at exit 0, else what stopped it, its level named.
function whole_layer_linked(t: toolchain.Toolchain, dir: str, level: str, sanitize: bool) -> str
    words = flags.level_words(level: level, sanitize: sanitize)
    kind: str @= "whole"

    if sanitize
        kind @ "sanitized"
    name = kind + level.slice(from: 1, to: level.len())
    unit = dir + "/" + name + ".c"
    object = dir + "/" + name + ".o"
    said = "the layer whole at " + words.join(" ") + ": "
    assert !write_file(path: unit, text: "int main(void) { return 0; }\n").is_err()
    line = strings.with_all(
        list: strings.with_all(list: ["clang"], more: words),
        more: ["-c", unit, "-I", t.runtime, "-o", object]
    )
    assert !toolchain.run_clang(line: line, what: "a test's unit", err_path: dir + "/" + name + ".err.txt").is_err()
    runtime = toolchain.runtime_object(t, level: level, sanitize: sanitize).must()
    archived = layer.archive(t, level: level, sanitize: sanitize, swift: layer_swift.members(t).must()).must()
    assert archived.len() == 1
    none: [str] = []
    no_output: str? = fail(code: "none", msg: "no -o")
    binary = link.link_objects(
        t,
        objects: strings.with_all(list: [runtime, object], more: whole_words(target: t.target, path: archived[0])),
        module: name,
        output: no_output,
        level: level,
        sanitize: sanitize,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        layer: [],
        judging: supplied.nothing()
    )

    match binary
        .err e => return said + e.msg
        .ok path =>
            ran = process.run(program: path, words: [path], out: process.discard(), err: process.discard())

            if !ran.started || ran.code != 0
                return said + "linked, and " + path + " did not run at exit 0"

    return ""

# **The reach at its limit: every member of the platform layer links with the
# runtime, every name it needs found on the link a build runs, at every level**
# (the coordinator's defect draft `d-lane-layer-speed-2`, 2026-11-25). The
# link carries the C library and the libraries a program names, and a member
# can name none (panel 234's R6): on Windows it names its own by `#pragma
# comment(lib)`, on macOS by the `.linker_option` its object carries, and on
# Linux a library it needs is opened by `dlopen`, so a member that calls a name
# the C library lacks links nowhere a program takes it. Measured in the Linux
# arm64 image that day: `hero_ui_parts_gtk` called `nextafter`, `hero_audio`
# and `hero_audio_pulse` `sin`, all three libm's, and a program binding
# `hero_ui_native_here` was `internal error: linking failed` at `-O0` and `-O2`
# and linked under `--sanitize` alone, whose runtime brings libm; now they call
# `platform/hero_layer_maths.h`. Every member is taken here, whether a program
# calls it or not, so a CI leg whose link lacks a name any member needs is red
# on that name, the linker's words printed.
test "the runtime and every member of the platform layer, linked whole, find every name they need at -O0, -O2 and sanitised at each"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    dir = "build/selftest-layer-whole"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()

    for level in ["-O0", "-O2"]
        for sanitize in [false, true]
            said = whole_layer_linked(t, dir: dir, level: level, sanitize: sanitize)

            if said != ""
                io.eprint(text: said)
            assert said == ""

    assert !process.remove_tree(dir).is_err()

# What `platform/hero_layer_maths.h` gives the members, held to the C library
# of this machine: `floor`, `ceil` and `nextafter` bit for bit over numbers of
# every kind (both zeros, halves, the least subnormal and the least normal,
# 2^52 either side, the largest finite, the infinities, a NaN), and the sine of
# a turn within 1e-14 of `sin` of its angle over a sweep of (-1, 1) and every
# turn PulseAudio's tone gives it; at -O0 and -O2, the probe naming libm where
# the platform keeps it apart, as a program writes `link "m"`.
test "the layer's own maths give the C library's floor, ceil and nextafter bit for bit, and its sine within 1e-14"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    dir = "build/selftest-layer-maths"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    unit = dir + "/maths.c"
    probe = "#include <float.h>\n#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n#include \"platform/hero_layer_maths.h\"\n\nstatic int same(double a, double b) {\n    uint64_t x;\n    uint64_t y;\n    memcpy(&x, &a, sizeof x);\n    memcpy(&y, &b, sizeof y);\n    return x == y || (a != a && b != b);\n}\n\nint main(void) {\n    const double v[] = { 0.0, -0.0, 0.25, -0.25, 0.5, -0.5, 0.75, -0.75, 1.0, -1.0, 1.5, -1.5, 2.5, -2.5, 123456.789, -123456.789, 1e-300, -1e-300, 4.9406564584124654e-324, -4.9406564584124654e-324, 2.2250738585072014e-308, -2.2250738585072014e-308, 4503599627370495.5, -4503599627370495.5, 4503599627370496.0, -4503599627370496.0, 9007199254740992.0, DBL_MAX, -DBL_MAX, INFINITY, -INFINITY, NAN };\n    size_t n = sizeof v / sizeof v[0];\n    int wrong = 0;\n    double worst = 0.0;\n    for (size_t i = 0; i < n; i += 1) {\n        wrong += !same(hero_layer_floor(v[i]), floor(v[i]));\n        wrong += !same(hero_layer_ceil(v[i]), ceil(v[i]));\n        for (size_t j = 0; j < n; j += 1) {\n            wrong += !same(hero_layer_next_toward(v[i], v[j]), nextafter(v[i], v[j]));\n        }\n    }\n    for (int k = -100000; k <= 100000; k += 1) {\n        double turn = (double)k / 100000.0;\n        double gap = fabs(hero_layer_sin_of_turn(turn) - sin(6.283185307179586 * turn));\n        worst = gap > worst ? gap : worst;\n    }\n    for (int k = 0; k < 44100; k += 1) {\n        double turn = (double)((880 * k) % 44100) / 44100.0;\n        double gap = fabs(hero_layer_sin_of_turn(turn) - sin(6.283185307179586 * turn));\n        worst = gap > worst ? gap : worst;\n    }\n    printf(\"%d wrong, the sine within %.3g\\n\", wrong, worst);\n    return wrong == 0 && worst <= 1e-14 ? 0 : 1;\n}\n"
    assert !write_file(path: unit, text: probe).is_err()
    libm: [str] @= []

    if !libraries.in_the_c_runtime(library: "m")
        libm @ ["-lm"]

    for level in ["-O0", "-O2"]
        binary = dir + "/maths" + level + process.exe_suffix()
        words = strings.with_all(list: ["clang"], more: flags.level_words(level: level, sanitize: false))
        line = strings.with_all(
            list: words,
            more: strings.with_all(list: [unit, "-I", t.runtime, "-o", binary], more: libm)
        )
        assert !toolchain.run_clang(line: line, what: "the layer's maths probe", err_path: dir + "/maths.err.txt").is_err()
        said = dir + "/maths" + level + ".txt"
        ran = process.run(program: binary, words: [binary], out: said, err: process.discard())

        if !ran.started || ran.code != 0
            io.eprint(text: "the layer's maths at " + level + ": " + read_file(said).default("no answer"))
        assert ran.started && ran.code == 0

    assert !process.remove_tree(dir).is_err()

# **A float's `%` is the runtime's own, C's `fmod` bit for bit** (defect
# d-lane-macro-members4-2, 2026-11-25): `runtime/parts/f64.c`'s
# `hero_f64_rem`, which the unit calls since glibc keeps `fmod` in libm and a
# program's link does not carry it, held to this machine's C library over every
# pair of 32 numbers of every kind with both signs (both zeros, subnormals,
# the least normal, 1 and 2^52 either side, the largest finite, the
# infinities, quiet and signalling NaNs with payloads) and 1.2 million more:
# any bits, close exponents with quotients up to 2^2046, and subnormals. A NaN
# where C's answer is one, and on Darwin's arm64 the same NaN bit for bit,
# the one the unit's `fmod` gave there until then. At -O0 and -O2, linked
# with the runtime's object as a program is, libm named where the platform
# keeps it apart, as a program calling `fmod` itself writes `link "m"`.
test "a float's % is the runtime's own, the C library's fmod bit for bit over numbers of every kind"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    dir = "build/selftest-float-rem"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    unit = dir + "/rem.c"
    assert !write_file(path: unit, text: "#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\ndouble hero_f64_rem(double x, double y);\n\nstatic uint64_t bits_of(double x) {\n    uint64_t b;\n    memcpy(&b, &x, sizeof b);\n    return b;\n}\n\nstatic double of_bits(uint64_t b) {\n    double x;\n    memcpy(&x, &b, sizeof x);\n    return x;\n}\n\nstatic uint64_t state = UINT64_C(0x2545f4914f6cdd1d);\n\nstatic uint64_t next(void) {\n    state ^= state << 13;\n    state ^= state >> 7;\n    state ^= state << 17;\n    return state;\n}\n\nstatic long pairs = 0;\nstatic long wrong = 0;\n\nstatic void one(double x, double y) {\n    volatile double vx = x;\n    volatile double vy = y;\n    double ours = hero_f64_rem(vx, vy);\n    double theirs = fmod(vx, vy);\n    pairs += 1;\n#if defined(__APPLE__) && defined(__aarch64__)\n    wrong += bits_of(ours) != bits_of(theirs);\n#else\n    wrong += bits_of(ours) != bits_of(theirs) && !(ours != ours && theirs != theirs);\n#endif\n}\n\nint main(void) {\n    const uint64_t edge[] = { 0, 1, 2, 3, UINT64_C(0x000fffffffffffff), UINT64_C(0x0010000000000000), UINT64_C(0x0010000000000001), UINT64_C(0x001fffffffffffff), UINT64_C(0x3fe0000000000000), UINT64_C(0x3ff0000000000000), UINT64_C(0x3ff0000000000001), UINT64_C(0x3fefffffffffffff), UINT64_C(0x4000000000000000), UINT64_C(0x401e000000000000), UINT64_C(0x4330000000000000), UINT64_C(0x4340000000000000), UINT64_C(0x433fffffffffffff), UINT64_C(0x7fefffffffffffff), UINT64_C(0x7fe0000000000000), UINT64_C(0x7ff0000000000000), UINT64_C(0x7ff8000000000000), UINT64_C(0x7ff8000000000123), UINT64_C(0x7ff0000000000789), UINT64_C(0x7ff4000000000000), UINT64_C(0x7fffffffffffffff), UINT64_C(0x3fb999999999999a), UINT64_C(0x400921fb54442d18), UINT64_C(0x401921fb54442d18), UINT64_C(0x3cb0000000000000), UINT64_C(0x0008000000000000), UINT64_C(0x0000000080000000), UINT64_C(0x7fe1ccf385ebc8a0) };\n    const size_t n = sizeof edge / sizeof edge[0];\n    const uint64_t sign = UINT64_C(0x8000000000000000);\n    for (size_t i = 0; i < n; i += 1) {\n        for (size_t j = 0; j < n; j += 1) {\n            for (int k = 0; k < 4; k += 1) {\n                one(of_bits(edge[i] | ((k & 1) ? sign : 0)), of_bits(edge[j] | ((k & 2) ? sign : 0)));\n            }\n        }\n    }\n    for (long k = 0; k < 400000; k += 1) {\n        uint64_t a = next();\n        uint64_t b = next();\n        uint64_t ea = next() % 2047;\n        uint64_t eb = ea - (next() % 64 > ea ? ea : next() % 64);\n        one(of_bits(a), of_bits(b));\n        one(of_bits((a & UINT64_C(0x800fffffffffffff)) | (ea << 52)), of_bits((b & UINT64_C(0x800fffffffffffff)) | (eb << 52)));\n        one(of_bits(a >> (next() % 64)), of_bits(b >> (next() % 64)));\n    }\n    printf(\"%ld pairs, %ld not the C library's\\n\", pairs, wrong);\n    return wrong == 0 ? 0 : 1;\n}\n").is_err()
    libm: [str] @= []

    if !libraries.in_the_c_runtime(library: "m")
        libm @ ["m"]
    none: [str] = []
    no_output: str? = fail(code: "none", msg: "no -o")

    for level in ["-O0", "-O2"]
        object = dir + "/rem" + level + ".o"
        line = strings.with_all(
            list: strings.with_all(list: ["clang"], more: flags.level_words(level: level, sanitize: false)),
            more: ["-c", unit, "-I", t.runtime, "-o", object]
        )
        assert !toolchain.run_clang(line: line, what: "the float remainder's probe", err_path: dir + "/rem.err.txt").is_err()
        runtime = toolchain.runtime_object(t, level: level, sanitize: false).must()
        binary = link.link_objects(
            t,
            objects: [runtime, object],
            module: "rem" + level.slice(from: 1, to: level.len()),
            output: no_output,
            level: level,
            sanitize: false,
            search_library: none,
            pkgconfig_flags: none,
            link_names: libm,
            layer: [],
            judging: supplied.nothing()
        ).must()
        said = dir + "/rem" + level + ".txt"
        ran = process.run(program: binary, words: [binary], out: said, err: process.discard())

        if !ran.started || ran.code != 0
            io.eprint(text: "the float remainder at " + level + ": " + read_file(said).default("no answer"))
        assert ran.started && ran.code == 0

    assert !process.remove_tree(dir).is_err()

# **A build that links nothing asks the layer nothing** (`--emit-c`): no
# word for a link it never makes, and no member asked or compiled, so its
# `build/` is never even made; a build that links is every other test's.
test "a build that links nothing asks the platform layer nothing"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-layer-unlinked"
    assert !process.remove_tree(t.build).is_err()
    none: [ast.Decl] = []
    s = source.new_source(
        name: "main.hero",
        text: "extern \"hero_time.h\"\n    function hero_time_monotonic_ns() -> i64\n"
    )
    assert for_build(t, level: "-O0", sanitize: false, s: s, decls: none, links: false).must().len() == 0
    assert !process.path_exists(t.build)

# **A program none of whose groups says `layer` asks the layer nothing**
# (panel 260): a build that links, with no group saying the word, gets no word
# for the link line, asks no member what it reaches and makes no `build/`; one
# group saying it, and the archive is the link's. What replaces the first half
# of `cli/layer.hero`'s *every link carries the layer*: a declared link does.
test "a program none of whose groups says layer asks the platform layer nothing, and one that says it links the archive (panel 260)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-layer-undeclared"
    assert !process.remove_tree(t.build).is_err()
    plain = "extern \"hero_os.h\"\n    function hero_os_pid() -> i64\n"
    s = source.new_source(name: "main.hero", text: plain)
    assert for_build(t, level: "-O0", sanitize: false, s: s, decls: parse.parse(plain).decls, links: true).must().len() == 0
    assert !process.path_exists(t.build)
    said = "extern \"hero_time.h\" layer\n    function hero_time_monotonic_ns() -> i64\n"
    d = source.new_source(name: "main.hero", text: said)
    assert for_build(t, level: "-O0", sanitize: false, s: d, decls: parse.parse(said).decls, links: true).must().len() == 1
    assert !process.remove_tree(t.build).is_err()

test "a program reaches a member written in Swift only through the C member that includes its header (defect 2625)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.target @ "aarch64-unknown-linux-gnu"
    assert reached(t, named: ["hero_crypto.h", "hero_ui.h"]).must().len() == 0
    t.target @ "arm64-apple-darwin27.2.0"
    none: [str] = []
    assert reached(t, named: none).must().len() == 0
    assert reached(t, named: ["hero_net.h", "hero_time.h", "stdio.h"]).must().len() == 0
    assert reached(t, named: ["hero_crypto.h"]).must() == [t.runtime + "/platform/hero_crypto_cryptokit.swift"]

    # `hero_ui.c` includes the five AppKit members' headers (the print and
    # page-setup dialogs since step 105v17, the app's window code, its
    # dialogs, its system services and the rest), so the C member that
    # `hero_ui.h` opens into reaches each of the five, in the order
    # `runtime/runtime.c` includes them (`runtime_key.swift_members`): the
    # print member stands with the printing capability's, before `hero_ui.c`.
    appkit = [
        t.runtime + "/platform/hero_ui_appkit_print.swift"
        t.runtime + "/platform/hero_ui_appkit.swift"
        t.runtime + "/platform/hero_ui_appkit_windows.swift"
        t.runtime + "/platform/hero_ui_appkit_dialogs.swift"
        t.runtime + "/platform/hero_ui_appkit_system.swift"
    ]
    assert reached(t, named: ["hero_ui.h"]).must() == appkit
    assert reached(t, named: ["hero_ui.h", "hero_crypto.h"]).must() == layer_swift.members(t).must()

    # Read from a unit's text, a group's header angled as the emitter writes it.
    assert reached(t, named: includes("#include <stdint.h>\n#include <hero_crypto.h>\n")).must().len() == 1

test "an include is read quoted or angled, indented or spaced, and nothing else is one"
    text = "#include \"a.h\"\n  #  include <b.h>\n#include\t\"c/d.h\"\n// #include \"no.h\"\n#define include \"no.h\"\n#include \"open\n"
    assert includes(text) == ["a.h", "b.h", "c/d.h"]
    assert base_of("c/d.h") == "d.h"
    assert opens_into(file: "runtime/platform/hero_net.c", reach: ["hero_net.h"])
    assert !opens_into(file: "runtime/vendor/x/hero_net.c", reach: ["hero_net.h"])
    assert opens_into(file: "runtime/hero_net.h", reach: ["hero_net.h"])
