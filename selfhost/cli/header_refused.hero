# A bound header clang refuses on its own, told as the author's (design.md
# §4.19, §4.17; CLAUDE.md §7's named exception; defect 360, 2026-10-05). The
# program's unit includes every group's header before a line of its own, so
# where the FIRST error clang reports lies in one of them, or in a file one of
# them includes, the header did not compile as this program's unit reads it,
# before any declaration of the group was checked against it. That reached the
# author as `internal error: compiling the generated C failed` at exit 2, the
# compiler blamed for a file the author chose to bind: measured on this Mac
# with a header holding `int broken = ;`, and on the Windows box for defect
# 337's fixture, whose `#line` clang 23.1.1 refuses.
#
# **The narrowing is the include stack**, as `emit/header_reach.hero` reads it
# for a missing header: the error's file and the files that reached it, and
# the group whose header is the innermost of them is the one told. It stays
# the compiler's, exit 2 as before, where:
# - clang's first error is in no header a group names or reaches: the
#   generated C, the unit's own lines, a header only the runtime includes;
# - it is a missing header, `'x.h' file not found`, which is
#   `ffi_missing_header`'s (`emit/ffi_build.hero`), told there or not at all;
# - a file of its stack, or a file one of its notes names, is the runtime's or
#   the build's: a group naming `hero_os.h`, as this compiler's own source
#   does, or a header a macro of the runtime broke, is the runtime's to answer
#   for.
#
# **Only the first error is read.** clang reads on past an error, and what it
# says after one, about a header it could not read whole or about the
# program's declarations checked against it, is no verdict: so a header that
# does not compile is told alone, and the declarations are checked once it
# does (the case `fixedbugs-360-a-header-that-does-not-compile-is-told-before-
# what-it-refutes`).
#
# What is told carries clang's words without its paths, which differ by
# platform: the header as the group spells it, the line, clang's message, the
# line as clang quoted it, the includes clang followed, the notes clang
# attached, and, where clang names `-Werror`, that the warning is one this
# compiler's flags make an error in a header's own code too
# (`cli/flags.hero`), which since panel 205 passes over `-Wall`'s warnings and
# sign conversions alone in a header, wherever it was found
# (`emit/header_region.hero`, defect 569).

use source
use ast
use diag
use emit/clang_place
use emit/ffi_lookup
use cli/read_back
use cli/headers_together
use cli/group_file
use cli/clang_first
use cli/clang_excerpt
use emit/ffi_build
use parse
use resolve
use checker

constant AS_ERROR: str
    "[-Werror"

# The refusal's last note, which `cli/header_order.hero` replaces where a
# move of a group, a header of C's own before it or a header of the
# program's own is what the program needs instead (panel 204's R3).
constant REPAIR: str
    "a group's header is compiled as this program's own C includes it, before any declaration of the group is checked against it: repair the header, or name the one that declares this group's C"

# The diagnostic for a header clang refused, or none where clang's first error
# is not this class. `runtime` and `build` are the directories whose files are
# the compiler's, as clang was given them.
function refused(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str, build: str) -> [diag.Diagnostic]
    none: [diag.Diagnostic] = []
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime, build: build)

    if read.is_err()
        return none
    one = read.must()

    two = sides(one)

    if !two.is_err()
        return [
            headers_together.told(s, one: two.must().one, other: two.must().other, message: one.first.message, added: two.must().added)
        ]
    return [told(one.rows, first: one.first, steps: one.steps, at: one.at, group: one.group, notes: one.notes)]

# The group whose header clang refused on its own, where it refused one group's
# header and no note names another's: the header `cli/header_alone.hero` asks
# whether it compiles alone (defect 557).
function refused_alone(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str, build: str) -> group_file.Group?
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime, build: build)?

    if !read.beside.is_err()
        return fail(code: "none", msg: "two headers are told")
    return ok(read.group)

# A header clang refused in a unit that compiles alone, and the earlier
# header of the unit it does not compile after (defect 557,
# `cli/header_alone.hero`): told as two headers refused together, the words
# the same whichever is written first.
function refused_after(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str, build: str, earlier: group_file.Group) -> [diag.Diagnostic]
    none: [diag.Diagnostic] = []
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime, build: build)

    if read.is_err()
        return none
    one = read.must()
    directory = clang_place.found_in(path: one.steps[one.at].path, spelled: one.group.header)
    refused_file: str @ one.group.header

    if one.at < one.steps.len() - 1
        refused_file @ clang_place.shown(path: one.first.place.path, directory: directory)
    side = headers_together.Side(
        span: one.group.span,
        header: one.group.header,
        file: refused_file,
        row: one.first.place.row,
        quoted: clang_excerpt.of(one.rows, after: one.first.row)
    )
    added: [str] @ []

    for note in one.notes
        added @ added.push(
            "clang adds, at `" + clang_place.shown(path: note.path, directory: directory) + "` line " + note.row.to_str() + ": " + note.text
        )

    return [
        headers_together.after(s, refused: side, earlier: earlier.span, earlier_header: earlier.header, message: one.first.message, added: added)
    ]

# The diagnostic, on the group's string: the file clang refused, as the group
# would name it, its line and clang's message, then what clang quoted and
# attached, the includes it followed, and what a `-Werror` means here.
function told(rows: [str], first: clang_first.First, steps: [clang_place.Place], at: i64, group: group_file.Group, notes: [clang_first.Attached]) -> diag.Diagnostic
    directory = clang_place.found_in(path: steps[at].path, spelled: group.header)
    refused_file: str @ group.header
    head: str @ "`" + group.header + "`, the header this group names, does not compile: clang refuses it"

    if at < steps.len() - 1
        refused_file @ clang_place.shown(path: first.place.path, directory: directory)
        head @ "`" + group.header + "`, the header this group names, does not compile: clang refuses `" + refused_file + "`, which it includes,"
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_header_refused",
        message: head + " at line " + first.place.row.to_str() + ": " + first.message,
        span: group.span
    )
    quoted = clang_excerpt.of(rows, after: first.row)

    if !quoted.is_err()
        d.notes @ d.notes.push(
            "`" + refused_file + "` line " + first.place.row.to_str() + " reads `" + quoted.must() + "`"
        )

    if at < steps.len() - 1
        hops: [str] @ []
        hop: i64 @ at

        while hop < steps.len() - 1
            hops @ hops.push(
                "`" + clang_place.shown(path: steps[hop].path, directory: directory) + "` line " + steps[hop].row.to_str() + " includes `" + clang_place.shown(path: steps[hop + 1].path, directory: directory) + "`"
            )
            hop @ hop + 1

        d.notes @ d.notes.push("the includes clang followed: " + hops.join(", then "))

    for note in notes
        d.notes @ d.notes.push(
            "clang adds, at `" + clang_place.shown(path: note.path, directory: directory) + "` line " + note.row.to_str() + ": " + note.text
        )

    if !clang_place.offset_of(text: first.message, needle: AS_ERROR).is_err()
        d.notes @ d.notes.push(
            "clang's `-Werror` says the warning is one this compiler makes an error in a header's own code too, wherever the header was found: a header's code is passed over for `-Wall`'s warnings and sign conversions alone, never for a missing return, an uninitialised read, a value narrowed to 32 bits or a pointer of another type"
        )
    d.notes @ d.notes.push(REPAIR)
    return d

# The two headers clang refused together, the group's where its first error
# lies and the other's where its note points (defect 538), with clang's other
# notes worded: told in the headers' own order, never the `use` lines', by
# `headers_together.told`, or as one macro two headers define two ways
# (`cli/macro_twice.hero`, panel 204's R2). Absent where no note names
# another group's header.
record Sides
    one: headers_together.Side
    other: headers_together.Side
    added: [str]

function sides(read: clang_first.Reading) -> Sides?
    if read.beside.is_err()
        return fail(code: "none", msg: "no note names another group's header")
    beside = read.beside.must()
    directory = clang_place.found_in(path: read.steps[read.at].path, spelled: read.group.header)
    refused_file: str @ read.group.header

    if read.at < read.steps.len() - 1
        refused_file @ clang_place.shown(path: read.first.place.path, directory: directory)
    one = headers_together.Side(
        span: read.group.span,
        header: read.group.header,
        file: refused_file,
        row: read.first.place.row,
        quoted: clang_excerpt.of(read.rows, after: read.first.row)
    )
    other = headers_together.Side(
        span: beside.group.span,
        header: beside.group.header,
        file: clang_place.shown(path: read.note.path, directory: beside.directory),
        row: read.note.row,
        quoted: clang_excerpt.of(read.rows, after: read.note.index)
    )
    added: [str] @ []

    for each in read.notes
        if each.index != read.note.index
            added @ added.push(
                "clang adds, at `" + clang_place.shown(path: each.path, directory: directory) + "` line " + each.row.to_str() + ": " + each.text
            )

    return ok(Sides(one: one, other: other, added: added))

## Tests

# A program of three groups, read as the build reads it.
function program() -> source.Source
    return source.new_source(name: "t.hero", text: TEXT)

constant TEXT: str
    "extern \"fine.h\"\n    function six() -> i64\n\nextern \"bad.h\"\n    function twice(x: i64) -> i64\n\nextern \"lib/outer.h\"\n    function four() -> i64\n\nfunction main()\n    print(twice(x: six() + four()))\n"

function decls_of() -> [ast.Decl]
    parsed = parse.parse(TEXT)
    s = program()
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    return parsed.decls

# clang's words as this Mac's Apple clang 21 wrote them for the cases of
# `tests/golden/unsupported/fixedbugs-360-*`, and the Windows box's form of
# the first, its separator a backslash and its lines ended `\r\n`.
test "a header clang refuses on its own is told on its group's string, in clang's words without its paths (defect 360)"
    s = program()
    decls = decls_of()
    mac = "In file included from build/tu-1/t.c:7:\n./bad.h:3:14: error: expected expression\n    3 | int broken = ;\n      |              ^\n1 error generated.\n"
    said = refused(stderr: mac, s: s, decls: decls, runtime: "runtime", build: "build")
    assert said.len() == 1
    assert said[0].code == "ffi_header_refused"
    assert source.span_text(s, said[0].span) == "\"bad.h\""
    assert said[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 3: expected expression"
    assert said[0].notes[0] == "`bad.h` line 3 reads `int broken = ;`"
    assert said[0].notes.len() == 2
    windows = "In file included from build\\tu-1\\t.c:7:\r\ntests/golden/run\\bad.h:3:14: error: expected expression\r\n    3 | int broken = ;\r\n"
    assert refused(stderr: windows, s: s, decls: decls, runtime: "runtime", build: "build")[0].message == said[0].message

    # Through the group's header, every include clang followed named.
    through = "In file included from build/tu-1/t.c:8:\nIn file included from d/lib/outer.h:2:\nd/lib/inner.h:3:20: error: expected expression\n    3 | int inner_broken = ;\n"
    inner = refused(stderr: through, s: s, decls: decls, runtime: "runtime", build: "build")
    assert source.span_text(s, inner[0].span) == "\"lib/outer.h\""
    assert inner[0].message == "`lib/outer.h`, the header this group names, does not compile: clang refuses `lib/inner.h`, which it includes, at line 3: expected expression"
    assert inner[0].notes[1] == "the includes clang followed: `lib/outer.h` line 2 includes `lib/inner.h`"

    # A warning before it is passed over; a `-Werror` is said; clang's note is
    # carried, shown as the group's directory would name its file.
    warned = "In file included from build/tu-1/t.c:7:\n./bad.h:2:2: warning: \"careful\" [-W#warnings]\n./bad.h:5:48: error: implicit conversion loses integer precision: 'long long' to 'int' [-Werror,-Wshorten-64-to-32]\n./bad.h:4:9: note: expanded from macro 'NARROW'\n1 warning and 1 error generated.\n"
    flagged = refused(stderr: warned, s: s, decls: decls, runtime: "runtime", build: "build")
    assert flagged[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 5: implicit conversion loses integer precision: 'long long' to 'int' [-Werror,-Wshorten-64-to-32]"
    assert flagged[0].notes[0] == "clang adds, at `bad.h` line 4: expanded from macro 'NARROW'"
    assert has(flagged[0].notes, needle: "clang's `-Werror` says the warning is one this compiler makes an error")

test "a refusal that is not a bound header's own stays the compiler's (defect 360)"
    s = program()
    decls = decls_of()
    none: [str] = [
        # The generated C, and a first error there before one in a header.
        "build/tu-1/t.c:9:1: error: use of undeclared identifier 'h_x'\n"
        "build/tu-1/t.c:9:1: error: use of undeclared identifier 'h_x'\nIn file included from build/tu-1/t.c:7:\n./bad.h:3:14: error: expected expression\n"
        # A missing header, which is `ffi_missing_header`'s.
        "In file included from build/tu-1/t.c:7:\n./bad.h:2:10: fatal error: 'gone.h' file not found\n"
        # The runtime's own header, a header no group reaches, and a group's
        # error a note of the runtime's explains.
        "In file included from build/tu-1/t.c:4:\nruntime/hero_os.h:4:1: error: expected expression\n"
        "In file included from build/tu-1/t.c:9:\n./other.h:1:1: error: expected expression\n"
        "In file included from build/tu-1/t.c:7:\n./bad.h:3:1: error: expected expression\nruntime/heroes_runtime.h:10:9: note: expanded from macro 'HERO_X'\n"
        # A place written only inside clang's quotation of a line.
        "    3 | ./bad.h:3:14: error: expected expression\n"
        "clang: error: no input files\n"
    ]

    for text in none
        assert refused(stderr: text, s: s, decls: decls, runtime: "runtime", build: "build").len() == 0

    # A group binding the runtime's own header, as this compiler's source does.
    bound = source.new_source(
        name: "r.hero",
        text: "extern \"hero_os.h\"\n    function hero_os_pid() -> i64\n\nfunction main()\n    print(hero_os_pid())\n"
    )
    parsed = parse.parse(bound.text)
    in_runtime = "In file included from build/tu-1/r.c:4:\n/abs/runtime/hero_os.h:4:1: error: expected expression\n"
    assert refused(stderr: in_runtime, s: bound, decls: parsed.decls, runtime: "/abs/runtime", build: "build").len() == 0

# DEFECT 284's measurement, held: a group's header found under a directory
# whose name holds the byte 0xE9, which only Linux makes, reached through
# `CPATH` since a `.hero` file and argv are UTF-8. Debian clang 22.1.8 in the
# Linux arm64 image printed the path with the byte as it is, and its words are
# committed as it wrote them (`surface-fixtures/notext284/`). Read back as the
# build reads them, the byte written by its value, the missing include and the
# header clang refuses are each told on the program's own group, the path as
# clang gave it in the message's notes; measured on the trunk's compiler in the
# image the same day, the missing include at exit 1, a header's `#warning`
# forwarded with the path so written at exit 0, and an extern the header
# refutes told at exit 1.
test "clang's words naming a header under a directory that is not UTF-8 are read back and told on the group (defect 284)"
    text = "extern \"m.h\"\n    function six() -> i64\n\nextern \"b.h\"\n    function twice(x: i64) -> i64\n\nfunction main()\n    print(twice(x: six()))\n"
    s = source.new_source(name: "u.hero", text: text)
    parsed = parse.parse(text)
    fixtures = "tests/golden/surface-fixtures/notext284/"
    missing = read_back.words(fixtures + "missing-under-latin1-directory.txt").must()
    line = ffi_lookup.lines(text: missing)[1]
    assert line == "/t/caf<0xE9>/m.h:2:10: fatal error: 'gone.h' file not found"
    lacked = ffi_build.missing_header(s, parsed.decls, line: line, stderr: missing).must()
    assert lacked.code == "ffi_missing_header"
    assert lacked.message == "`gone.h` is not on this machine's include path, and `m.h`, the header this group names, includes it at line 2"
    refused_words = read_back.words(fixtures + "refused-under-latin1-directory.txt").must()
    said = refused(stderr: refused_words, s: s, decls: parsed.decls, runtime: "runtime", build: "build")
    assert source.span_text(s, said[0].span) == "\"b.h\""
    assert said[0].message == "`b.h`, the header this group names, does not compile: clang refuses it at line 3: expected expression"
    assert said[0].notes[0] == "`b.h` line 3 reads `int broken = ;`"

function has(notes: [str], needle: str) -> bool
    for note in notes
        if !clang_place.offset_of(text: note, needle: needle).is_err()
            return true

    return false

# Two groups whose headers each declare `twice` another way, as clang 21 on
# this Mac refused them in one unit in both orders (defect 538): told the same
# words whichever is included first, on the group whose header sorts first.
test "two headers clang refuses together are both told, whichever the program includes first (defect 538)"
    text = "extern \"a.h\"\n    function twice(x: i64) -> i64\n\nextern \"b.h\"\n    function twice2(x: i32) -> i32\n\nfunction main()\n    print(twice(x: 3))\n"
    s = source.new_source(name: "p.hero", text: text)
    parsed = parse.parse(text)
    a_first = "In file included from build/tu-1/p.c:8:\n./b.h:1:19: error: conflicting types for 'twice'\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n./a.h:1:20: note: previous definition is here\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n1 error generated.\n"
    b_first = "In file included from build/tu-1/p.c:8:\n./a.h:1:20: error: conflicting types for 'twice'\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n./b.h:1:19: note: previous definition is here\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n1 error generated.\n"
    one = refused(stderr: a_first, s: s, decls: parsed.decls, runtime: "runtime", build: "build")
    two = refused(stderr: b_first, s: s, decls: parsed.decls, runtime: "runtime", build: "build")
    assert one.len() == 1
    assert one[0].code == "ffi_header_refused"
    assert source.span_text(s, one[0].span) == "\"a.h\""
    assert one[0].message == "`a.h` and `b.h`, the headers two groups name, cannot be compiled in one unit: clang refuses them together, at `a.h` line 1 and `b.h` line 1: conflicting types for 'twice'"
    assert one[0].notes[0] == "`a.h` line 1 reads `static inline long twice(long x) { return 2 * x; }`"
    assert one[0].notes[1] == "`b.h` line 1 reads `static inline int twice(int x) { return x + x; }`"
    assert one[0].notes[2] == "the other group names `b.h` at line 4"
    assert one[0].notes.len() == 4
    assert two.len() == 1
    assert two[0].message == one[0].message
    assert two[0].notes == one[0].notes
    assert two[0].span.start == one[0].span.start

# Defect 550: the earlier declaration sits in a file `a.h` includes, which no
# group names, and clang prints that note's own includes since panel 202's
# (g) (`cli/flags.hero`), as Apple clang 21 wrote them for lane b17-emit's
# `inc1` and `inc2`: both orders are told the same words, the file named with
# the header it arrives through.
test "a note in a file another group's header includes is told through that header, whichever is included first (defect 550)"
    text = "extern \"a.h\"\n    function twice(x: i64) -> i64\n\nextern \"b.h\"\n    function thrice(x: i32) -> i32\n\nfunction main()\n    print(twice(x: 3))\n"
    s = source.new_source(name: "p.hero", text: text)
    parsed = parse.parse(text)
    a_first = "In file included from build/tu-1/p.c:3:\n./b.h:1:19: error: conflicting types for 'twice'\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\nIn file included from build/tu-1/p.c:2:\nIn file included from ./a.h:1:\n./a_impl.h:1:20: note: previous definition is here\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n1 error generated.\n"
    b_first = "In file included from build/tu-1/p.c:3:\nIn file included from ./a.h:1:\n./a_impl.h:1:20: error: conflicting types for 'twice'\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\nIn file included from build/tu-1/p.c:2:\n./b.h:1:19: note: previous definition is here\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n1 error generated.\n"
    one = refused(stderr: a_first, s: s, decls: parsed.decls, runtime: "runtime", build: "build")
    two = refused(stderr: b_first, s: s, decls: parsed.decls, runtime: "runtime", build: "build")
    assert one.len() == 1
    assert one[0].message == "`a.h` and `b.h`, the headers two groups name, cannot be compiled in one unit: clang refuses them together, at `a_impl.h` line 1, which `a.h` includes, and `b.h` line 1: conflicting types for 'twice'"
    assert two[0].message == one[0].message
    assert two[0].notes == one[0].notes
    assert source.span_text(s, one[0].span) == "\"a.h\""
