# A bound header clang refuses on its own, told as the author's (design.md
# §4.19, §4.17; CLAUDE.md §7's named exception; defect 360, 2026-10-05). The
# program's unit includes every group's header before a line of its own, so
# where the FIRST error clang reports lies in one of them, or in a file one of
# them includes, the header did not compile as this program's unit reads it,
# before any declaration of the group was checked against it. That reached the
# author as `internal error: compiling the generated C failed` at exit 2, the
# compiler blamed for a file the author chose to bind: measured on this Mac
# with a header holding `int broken = ;`, and on the Windows box for defect
# 337's fixture, whose `#line` clang 23.1.1 refuses.
#
# **The narrowing is the include stack**, as `emit/header_reach.hero` reads it
# for a missing header: the error's file and the files that reached it, and
# the group whose header is the innermost of them is the one told. It stays
# the compiler's, exit 2 as before, where:
# - clang's first error is in no header a group names or reaches: the
#   generated C, the unit's own lines, a header only the runtime includes;
# - it is a missing header, `'x.h' file not found`, which is
#   `ffi_missing_header`'s (`emit/ffi_build.hero`), told there or not at all;
# - a file of its stack, or a file one of its notes names, is the runtime's or
#   the build's: a group naming `hero_os.h`, as this compiler's own source
#   does, or a header a macro of the runtime broke, is the runtime's to answer
#   for; save a note at the runtime's line declaring a name of C's
#   `<stdint.h>` again as C does, `typedef __INT64_TYPE__ int64_t;`, which is
#   C's own and told so (`cli/standard_name.hero`, defect 2044): a header
#   declaring `int64_t` another way is refused beside any `<stdint.h>`; and
#   save a note at the runtime's own declaration of the very name the header
#   declares again, `int64_t hero_str_len(HeroStr s);` under `static inline
#   int hero_str_len(int x)`, told as a name the Heroes runtime declares in
#   every unit before any group's header, with a `guess` fix that renames it
#   in the header (`cli/runtime_name.hero`, defect 2045); and save a note at
#   a function of the runtime's the header's line calls, with the same fix,
#   or at a name of the runtime's clang suggests for one the line misspells
#   (defect 2049); any other note at a line of the Heroes library's own
#   stays here.
#
# **A first error in no group's header is a header's own in two places**
# (`cli/declared_after.hero`, defect 2049): in a header of C's own the
# runtime includes after the groups, or in the C this compiler writes, at the
# name the header's line declared first.
#
# **Only the first error is read.** clang reads on past an error, and what it
# says after one, about a header it could not read whole or about the
# program's declarations checked against it, is no verdict: so a header that
# does not compile is told alone, and the declarations are checked once it
# does (the case `fixedbugs-360-a-header-that-does-not-compile-is-told-before-
# what-it-refutes`).
#
# What is told carries clang's words without its paths, which differ by
# platform: the header as the group spells it, the line, clang's message, the
# line as clang quoted it, the includes clang followed, the notes clang
# attached, and, where clang names `-Werror`, that the warning is one this
# compiler's flags make an error in a header's own code too
# (`cli/flags.hero`), which since panel 205 passes over `-Wall`'s warnings and
# sign conversions alone in a header, wherever it was found
# (`emit/header_region.hero`, defect 569).

use source
use ast
use diag
use emit/clang_place
use emit/ffi_lookup
use cli/read_back
use cli/process
use cli/headers_together
use cli/group_file
use cli/clang_first
use cli/clang_excerpt
use cli/declared_after
use emit/ffi_build
use parse
use resolve
use checker

constant AS_ERROR: str
    "[-Werror"

# How a note at the runtime's own declaration of a name the header declares
# again opens (defect 2045), which `runtime_named` reads back.
constant RUNTIME_OWN: str
    "clang adds, at the Heroes runtime's own `"

# The refusal's last note, which `cli/header_order.hero` replaces where a
# move of a group, a header of C's own before it or a header of the
# program's own is what the program needs instead (panel 204's R3).
constant REPAIR: str
    "a group's header is compiled as this program's own C includes it, before any declaration of the group is checked against it: repair the header, or name the one that declares this group's C"

# The diagnostic for a header clang refused, or none where clang's first error
# is not this class. `runtime` is the runtime's directory as clang was given
# it, whose files are the compiler's with the one clang compiled
# (`group_file.compilers`).
function refused(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str) -> [diag.Diagnostic]
    none: [diag.Diagnostic] = []
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime)

    # A first error in no group's header may still be a header's own, where
    # C declares after the groups the name its line declared (defect 2049).
    if read.is_err()
        later = declared_after.told(stderr: stderr, s: s, decls: decls, runtime: runtime)

        if later.is_err()
            return none
        d: diag.Diagnostic @= later.must()
        d.notes @ d.notes.push(REPAIR)
        return [d]
    one = read.must()

    two = sides(one)

    if !two.is_err()
        return [
            headers_together.told(s, one: two.must().one, other: two.must().other, message: one.first.message, added: two.must().added)
        ]
    return [told(s, rows: one.rows, first: one.first, steps: one.steps, at: one.at, group: one.group, notes: one.notes)]

# The group whose header clang refused on its own, where it refused one group's
# header and no note names another's: the header `cli/header_alone.hero` asks
# whether it compiles alone (defect 557).
function refused_alone(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str) -> group_file.Group?
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime)?

    if !read.beside.is_err()
        return fail(code: "none", msg: "two headers are told")
    return ok(read.group)

# A header clang refused in a unit that compiles alone, and the earlier
# header of the unit it does not compile after (defect 557,
# `cli/header_alone.hero`): told as two headers refused together, the words
# the same whichever is written first.
function refused_after(stderr: str, s: source.Source, decls: [ast.Decl], runtime: str, earlier: group_file.Group) -> [diag.Diagnostic]
    none: [diag.Diagnostic] = []
    read = clang_first.reading(stderr: stderr, s: s, decls: decls, runtime: runtime)

    if read.is_err()
        return none
    one = read.must()
    directory = clang_place.found_in(path: one.steps[one.at].path, spelled: one.group.header)
    refused_file: str @= one.group.header

    if one.at < one.steps.len() - 1
        refused_file @ clang_place.shown(path: one.first.place.path, directory: directory)
    side = headers_together.Side(
        span: one.group.span,
        header: one.group.header,
        file: refused_file,
        row: one.first.place.row,
        quoted: clang_excerpt.of(one.rows, after: one.first.row)
    )
    added: [str] @= []

    for note in one.notes
        added @ added.push(adds(note, directory: directory))

    return [
        headers_together.after(s, refused: side, earlier: earlier.span, earlier_header: earlier.header, message: one.first.message, added: added)
    ]

# The diagnostic, on the group's string: the file clang refused, as the group
# would name it, its line and clang's message, then what clang quoted and
# attached, the includes it followed, and what a `-Werror` means here; and
# where a note is the runtime's own declaration of the name the header
# declares again (defect 2045), a `guess` fix that renames it there, its
# replacement the group's string as written, since the rename is the
# header's.
function told(s: source.Source, rows: [str], first: clang_first.First, steps: [clang_place.Place], at: i64, group: group_file.Group, notes: [clang_first.Attached]) -> diag.Diagnostic
    directory = clang_place.found_in(path: steps[at].path, spelled: group.header)
    refused_file: str @= group.header
    head: str @= "`" + group.header + "`, the header this group names, does not compile: clang refuses it"

    if at < steps.len() - 1
        refused_file @ clang_place.shown(path: first.place.path, directory: directory)
        head @ "`" + group.header + "`, the header this group names, does not compile: clang refuses `" + refused_file + "`, which it includes,"
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_header_refused",
        message: head + " at line " + first.place.row.to_str() + ": " + first.message,
        span: group.span
    )
    quoted = clang_excerpt.of(rows, after: first.row)

    if !quoted.is_err()
        d.notes @ d.notes.push(
            "`" + refused_file + "` line " + first.place.row.to_str() + " reads `" + quoted.must() + "`"
        )

    if at < steps.len() - 1
        hops: [str] @= []
        hop: i64 @= at

        while hop < steps.len() - 1
            hops @ hops.push(
                "`" + clang_place.shown(path: steps[hop].path, directory: directory) + "` line " + steps[hop].row.to_str() + " includes `" + clang_place.shown(path: steps[hop + 1].path, directory: directory) + "`"
            )
            hop @ hop + 1

        d.notes @ d.notes.push("the includes clang followed: " + hops.join(", then "))

    for note in notes
        d.notes @ d.notes.push(adds(note, directory: directory))
        named = note.runtime.default(note.called.default(""))

        if named != "" && d.fixes.len() == 0
            d.fixes @ d.fixes.push(
                diag.Fix(title: "rename `" + named + "` in `" + refused_file + "`, a name the Heroes runtime declares first in every unit", replacement: source.span_text(s, group.span), span: group.span, certainty: .guess)
            )

    if !clang_place.offset_of(text: first.message, needle: AS_ERROR).is_err()
        d.notes @ d.notes.push(
            "clang's `-Werror` says the warning is one this compiler makes an error in a header's own code too, wherever the header was found: a header's code is passed over for `-Wall`'s warnings and sign conversions alone, never for a missing return, an uninitialised read, a format reading an argument it was not given or one of another type, a value narrowed to 32 bits or a pointer of another type"
        )
    d.notes @ d.notes.push(REPAIR)
    return d

# The two headers clang refused together, the group's where its first error
# lies and the other's where its note points (defect 538), with clang's other
# notes worded: told in the headers' own order, never the `use` lines', by
# `headers_together.told`, or as one macro two headers define two ways
# (`cli/macro_twice.hero`, panel 204's R2). Absent where no note names
# another group's header.
record Sides
    one: headers_together.Side
    other: headers_together.Side
    added: [str]

function sides(read: clang_first.Reading) -> Sides?
    if read.beside.is_err()
        return fail(code: "none", msg: "no note names another group's header")
    beside = read.beside.must()
    directory = clang_place.found_in(path: read.steps[read.at].path, spelled: read.group.header)
    refused_file: str @= read.group.header

    if read.at < read.steps.len() - 1
        refused_file @ clang_place.shown(path: read.first.place.path, directory: directory)
    one = headers_together.Side(
        span: read.group.span,
        header: read.group.header,
        file: refused_file,
        row: read.first.place.row,
        quoted: clang_excerpt.of(read.rows, after: read.first.row)
    )
    other = headers_together.Side(
        span: beside.group.span,
        header: beside.group.header,
        file: clang_place.shown(path: read.note.path, directory: beside.directory),
        row: read.note.row,
        quoted: clang_excerpt.of(read.rows, after: read.note.index)
    )
    added: [str] @= []

    for each in read.notes
        if each.index != read.note.index
            added @ added.push(adds(each, directory: directory))

    return ok(Sides(one: one, other: other, added: added))

# A note clang attached, as it is told: its file shown as the group's
# directory would name it, and its line; or, at the runtime's line declaring
# a name of C's `<stdint.h>` again (defect 2044), as C's own declaration of
# that name, and at the runtime's own declaration of a name the header
# declares again (defect 2045), as the Heroes runtime's, each of which every
# unit reads before any group's header, never as a file of the compiler's;
# and so at a function of the runtime's the refused line calls, or a name of
# the runtime's clang suggests in it (defect 2049).
function adds(note: clang_first.Attached, directory: str) -> str
    if !note.standard.is_err()
        return "clang adds, at C's own `" + note.standard.must() + "`, which every unit of this program declares as `<stdint.h>` does, before any group's header: " + note.text

    if !note.runtime.is_err()
        return RUNTIME_OWN + note.runtime.must() + "`, which every unit of this program declares before any group's header: " + note.text
    every = ", which every unit of this program declares before any group's header"

    if !note.called.is_err()
        return "clang adds, at `" + note.called.must() + "`, a function of the Heroes runtime's own" + every + ", and the refused line calls: " + note.text

    if !note.suggested.is_err()
        return "clang adds, at `" + note.suggested.must() + "`, a name of the Heroes runtime's own" + every + ", and clang suggests in the refused line: " + note.text
    return "clang adds, at `" + clang_place.shown(path: note.path, directory: directory) + "` line " + note.row.to_str() + ": " + note.text

# The name of the Heroes runtime's own that a refusal's note says the header
# declares again (defect 2045), none where no note says so: read by
# `cli/header_order.hero`, which tries no header before such a one and tells
# one not beside the program to be declared anew.
function runtime_named(d: diag.Diagnostic) -> str?
    for note in d.notes
        if clang_place.same_bytes(text: note, from: 0, part: RUNTIME_OWN)
            rest = note.slice(from: RUNTIME_OWN.len(), to: note.len())
            stop = clang_place.offset_of(text: rest, needle: "`")?
            return ok(rest.slice(from: 0, to: stop))

    return fail(code: "none", msg: "no note names a name of the runtime's")

## Tests

# A program of three groups, read as the build reads it.
function program() -> source.Source
    return source.new_source(name: "t.hero", text: TEXT)

constant TEXT: str
    "extern \"fine.h\"\n    function six() -> i64\n\nextern \"bad.h\"\n    function twice(x: i64) -> i64\n\nextern \"lib/outer.h\"\n    function four() -> i64\n\nfunction main()\n    print(twice(x: six() + four()))\n"

function decls_of() -> [ast.Decl]
    parsed = parse.parse(TEXT)
    s = program()
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    return parsed.decls

# clang's words as this Mac's Apple clang 21 wrote them for the cases of
# `tests/golden/unsupported/fixedbugs-360-*`, and the Windows box's form of
# the first, its separator a backslash and its lines ended `\r\n`.
test "a header clang refuses on its own is told on its group's string, in clang's words without its paths (defect 360)"
    s = program()
    decls = decls_of()
    mac = "In file included from build/tu-1/t.c:7:\n./bad.h:3:14: error: expected expression\n    3 | int broken = ;\n      |              ^\n1 error generated.\n"
    said = refused(stderr: mac, s: s, decls: decls, runtime: "runtime")
    assert said.len() == 1
    assert said[0].code == "ffi_header_refused"
    assert source.span_text(s, said[0].span) == "\"bad.h\""
    assert said[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 3: expected expression"
    assert said[0].notes[0] == "`bad.h` line 3 reads `int broken = ;`"
    assert said[0].notes.len() == 2
    windows = "In file included from build\\tu-1\\t.c:7:\r\ntests/golden/run\\bad.h:3:14: error: expected expression\r\n    3 | int broken = ;\r\n"
    assert refused(stderr: windows, s: s, decls: decls, runtime: "runtime")[0].message == said[0].message

    # Through the group's header, every include clang followed named.
    through = "In file included from build/tu-1/t.c:8:\nIn file included from d/lib/outer.h:2:\nd/lib/inner.h:3:20: error: expected expression\n    3 | int inner_broken = ;\n"
    inner = refused(stderr: through, s: s, decls: decls, runtime: "runtime")
    assert source.span_text(s, inner[0].span) == "\"lib/outer.h\""
    assert inner[0].message == "`lib/outer.h`, the header this group names, does not compile: clang refuses `lib/inner.h`, which it includes, at line 3: expected expression"
    assert inner[0].notes[1] == "the includes clang followed: `lib/outer.h` line 2 includes `lib/inner.h`"

    # A warning before it is passed over; a `-Werror` is said; clang's note is
    # carried, shown as the group's directory would name its file.
    warned = "In file included from build/tu-1/t.c:7:\n./bad.h:2:2: warning: \"careful\" [-W#warnings]\n./bad.h:5:48: error: implicit conversion loses integer precision: 'long long' to 'int' [-Werror,-Wshorten-64-to-32]\n./bad.h:4:9: note: expanded from macro 'NARROW'\n1 warning and 1 error generated.\n"
    flagged = refused(stderr: warned, s: s, decls: decls, runtime: "runtime")
    assert flagged[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 5: implicit conversion loses integer precision: 'long long' to 'int' [-Werror,-Wshorten-64-to-32]"
    assert flagged[0].notes[0] == "clang adds, at `bad.h` line 4: expanded from macro 'NARROW'"
    assert has(flagged[0].notes, needle: "clang's `-Werror` says the warning is one this compiler makes an error")

test "a refusal that is not a bound header's own stays the compiler's (defect 360)"
    s = program()
    decls = decls_of()
    none: [str] = [
        # The generated C, and a first error there before one in a header.
        "build/tu-1/t.c:9:1: error: use of undeclared identifier 'h_x'\n"
        "build/tu-1/t.c:9:1: error: use of undeclared identifier 'h_x'\nIn file included from build/tu-1/t.c:7:\n./bad.h:3:14: error: expected expression\n"
        # A missing header, which is `ffi_missing_header`'s.
        "In file included from build/tu-1/t.c:7:\n./bad.h:2:10: fatal error: 'gone.h' file not found\n"
        # The runtime's own header, a header no group reaches, and a group's
        # error a note of the runtime's explains.
        "In file included from build/tu-1/t.c:4:\nruntime/hero_os.h:4:1: error: expected expression\n"
        "In file included from build/tu-1/t.c:9:\n./other.h:1:1: error: expected expression\n"
        "In file included from build/tu-1/t.c:7:\n./bad.h:3:1: error: expected expression\nruntime/heroes_runtime.h:10:9: note: expanded from macro 'HERO_X'\n"
        # A place written only inside clang's quotation of a line.
        "    3 | ./bad.h:3:14: error: expected expression\n"
        "clang: error: no input files\n"
    ]

    for text in none
        assert refused(stderr: text, s: s, decls: decls, runtime: "runtime").len() == 0

    # A group binding the runtime's own header, as this compiler's source does:
    # the runtime's file, by what `runtime.c` names, wherever it stands, even
    # under a directory named `build` (defect 2035).
    bound = source.new_source(
        name: "r.hero",
        text: "extern \"hero_os.h\"\n    function hero_os_pid() -> i64\n\nfunction main()\n    print(hero_os_pid())\n"
    )
    parsed = parse.parse(bound.text)
    elsewhere = "build/selftest-runtime-2035"
    assert !process.remove_tree(elsewhere).is_err()
    assert !process.mkdir_all(elsewhere).is_err()
    assert !write_file(path: elsewhere + "/runtime.c", text: "#include \"hero_os.h\"\n").is_err()
    assert !write_file(path: elsewhere + "/hero_os.h", text: "int hero_os_pid(void);\n").is_err()
    in_runtime = "In file included from build/tu-1/r.c:4:\n./" + elsewhere + "/hero_os.h:4:1: error: expected expression\n"
    assert refused(stderr: in_runtime, s: bound, decls: parsed.decls, runtime: elsewhere).len() == 0

    # And a runtime `runtime.c` cannot be read from is no reading at all: the
    # refusal stays the compiler's.
    assert refused(stderr: in_runtime, s: bound, decls: parsed.decls, runtime: elsewhere + "/gone").len() == 0

# DEFECT 2035: a program kept under a relative `build/`, or under the
# `runtime/` the compiler found in the working directory, is the program's,
# its header told as anywhere else, since a file of the compiler's own is the
# one clang compiled or one `runtime.c` names, never one a folder holds. Until
# then each was *internal error* at exit 2. The words are Apple clang 21's
# for `fixedbugs-2034-...-too-few-arguments-is-refused` copied to
# `build/rep/a/`, its header renamed `bad.h`, measured 2026-10-13.
test "a program kept under a folder named build or runtime is told its header's refusal (defect 2035)"
    s = program()
    decls = decls_of()

    for under in ["build/rep/a/", "./build/rep/a/", "build/", "runtime/rep/", "x/build/"]
        said = "In file included from build/tu-28e6b6e97091d848/t.c:15:\n" + under + "bad.h:4:56: error: more '%' conversions than data arguments [-Werror,-Wformat-insufficient-args]\n    4 | static inline int fmt_shout(void) { return printf(\"%d %d\\n\", 7); }\n1 error generated.\n"
        got = refused(stderr: said, s: s, decls: decls, runtime: "runtime")
        assert got.len() == 1
        assert got[0].code == "ffi_header_refused"
        assert source.span_text(s, got[0].span) == "\"bad.h\""

    # The file clang compiled stays the compiler's whatever its folder: a first
    # error in it, and a note in it under a header's error.
    compiled = "build/rep/a/t.c"
    in_unit = compiled + ":9:1: error: use of undeclared identifier 'h_x'\n"
    assert refused(stderr: in_unit, s: s, decls: decls, runtime: "runtime").len() == 0
    noted = "In file included from " + compiled + ":7:\nbuild/rep/a/bad.h:3:1: error: redefinition of 'h_x'\n" + compiled + ":5:9: note: previous definition is here\n"
    assert refused(stderr: noted, s: s, decls: decls, runtime: "runtime").len() == 0

# DEFECT 284's measurement, held: a group's header found under a directory
# whose name holds the byte 0xE9, which only Linux makes, reached through
# `CPATH` since a `.hero` file and argv are UTF-8. Debian clang 22.1.8 in the
# Linux arm64 image printed the path with the byte as it is, and its words are
# committed as it wrote them (`surface-fixtures/notext284/`). Read back as the
# build reads them, the byte written by its value, the missing include and the
# header clang refuses are each told on the program's own group, the path as
# clang gave it in the message's notes; measured on the trunk's compiler in the
# image the same day, the missing include at exit 1, a header's `#warning`
# forwarded with the path so written at exit 0, and an extern the header
# refutes told at exit 1.
test "clang's words naming a header under a directory that is not UTF-8 are read back and told on the group (defect 284)"
    text = "extern \"m.h\"\n    function six() -> i64\n\nextern \"b.h\"\n    function twice(x: i64) -> i64\n\nfunction main()\n    print(twice(x: six()))\n"
    s = source.new_source(name: "u.hero", text: text)
    parsed = parse.parse(text)
    fixtures = "tests/golden/surface-fixtures/notext284/"
    missing = read_back.words(fixtures + "missing-under-latin1-directory.txt").must()
    line = ffi_lookup.lines(text: missing)[1]
    assert line == "/t/caf<0xE9>/m.h:2:10: fatal error: 'gone.h' file not found"
    lacked = ffi_build.missing_header(s, parsed.decls, line: line, stderr: missing).must()
    assert lacked.code == "ffi_missing_header"
    assert lacked.message == "`gone.h` is not on this machine's include path, and `m.h`, the header this group names, includes it at line 2"
    refused_words = read_back.words(fixtures + "refused-under-latin1-directory.txt").must()
    said = refused(stderr: refused_words, s: s, decls: parsed.decls, runtime: "runtime")
    assert source.span_text(s, said[0].span) == "\"b.h\""
    assert said[0].message == "`b.h`, the header this group names, does not compile: clang refuses it at line 3: expected expression"
    assert said[0].notes[0] == "`b.h` line 3 reads `int broken = ;`"

# DEFECT 2040: a note that is no second header leaves the refusal the
# header's own. Clang's words as Apple clang 21 wrote them on 2026-10-13, the
# runtime's paths written relative and the toolchain's shortened: `NULL`
# passed to a `nonnull` parameter, noted at its definition in a file the
# runtime entered first; `size_t` typedef'd again, noted at C's own; and a
# macro of another group's header the refused one includes. The program names
# `heroes_runtime.h` as the Heroes library does, which the first two read as
# a second header refused, and the third named `a2.h` beside it.
test "a macro's expansion, or a file the runtime entered first, is no second header (defect 2040)"
    text = "extern \"heroes_runtime.h\"\n    function hero_exit(code: i64)\n\nextern \"a2.h\"\n    constant A2_ONE: i32\n\nextern \"nn.h\"\n    function call_need() -> i32\n\nfunction main()\n    print(call_need() + A2_ONE)\n"
    s = source.new_source(name: "n.hero", text: text)
    parsed = parse.parse(text)
    through = "In file included from build/tu-1/n.c:2:\nIn file included from runtime/heroes_unit.h:26:\nIn file included from runtime/heroes_runtime.h:55:\n"
    nulled = "In file included from build/tu-1/n.c:20:\n./nn.h:4:49: error: null passed to a callee that requires a non-null argument [-Werror,-Wnonnull]\n    4 | static inline int call_need(void) { return need(NULL); }\n      |                                                 ^~~~\n" + through + "In file included from /clang/include/stddef.h:113:\n/clang/include/__stddef_null.h:26:14: note: expanded from macro 'NULL'\n   26 | #define NULL ((void*)0)\n      |              ^~~~~~~~~~\n1 error generated.\n"
    sized = "In file included from build/tu-1/n.c:20:\n./nn.h:6:13: error: typedef redefinition with different types ('int' vs 'unsigned long')\n" + through + "In file included from /clang/include/stddef.h:98:\n/clang/include/__stddef_size_t.h:18:23: note: previous definition is here\n1 error generated.\n"
    included = "In file included from build/tu-1/n.c:21:\n./nn.h:5:45: error: null passed to a callee that requires a non-null argument [-Werror,-Wnonnull]\nIn file included from build/tu-1/n.c:21:\nIn file included from ./nn.h:2:\n./a2.h:1:18: note: expanded from macro 'NOTHING2'\n1 error generated.\n"

    for said in [nulled, sized, included]
        got = refused(stderr: said, s: s, decls: parsed.decls, runtime: "runtime")
        assert got.len() == 1
        assert got[0].code == "ffi_header_refused"
        assert source.span_text(s, got[0].span) == "\"nn.h\""
        opening = clang_place.offset_of(
            text: got[0].message,
            needle: "`nn.h`, the header this group names, does not compile: clang refuses it at line "
        )
        assert !opening.is_err() && opening.must() == 0

    noted = refused(stderr: nulled, s: s, decls: parsed.decls, runtime: "runtime")[0]
    assert has(noted.notes, needle: "expanded from macro 'NULL'")

# DEFECT 2044: a note at the runtime's line declaring a name of `<stdint.h>`
# again, as C does, is C's own, and the header's refusal stays its own. Clang's
# words as Apple clang 21 wrote them on 2026-10-13 for `typedef long int64_t;`
# and for `int46_t` misspelled, each line of the runtime's found by its text
# and never by its number; a note at a line of the Heroes library's own stays
# the compiler's where no caret of clang's names the name it declares
# (`hero_str_len` declared again under clang's excerpt is defect 2045's,
# below).
test "a note at the runtime's re-declaration of a name of stdint.h is C's own (defect 2044)"
    s = program()
    decls = decls_of()
    int64 = runtime_row("typedef __INT64_TYPE__ int64_t;")
    int16 = runtime_row("typedef __INT16_TYPE__ int16_t;")
    length = runtime_row("int64_t hero_str_len(HeroStr s);")
    through = "In file included from build/tu-1/t.c:2:\nIn file included from runtime/heroes_unit.h:26:\n"
    head = "In file included from build/tu-1/t.c:7:\n./bad.h:1:14: error: typedef redefinition with different types ('long' vs 'long long')\n    1 | typedef long int64_t;\n      |              ^\n"
    redefined = head + through + "runtime/heroes_runtime.h:" + int64.to_str() + ":24: note: previous definition is here\n1 error generated.\n"
    said = refused(stderr: redefined, s: s, decls: decls, runtime: "runtime")
    assert said.len() == 1
    assert said[0].code == "ffi_header_refused"
    assert source.span_text(s, said[0].span) == "\"bad.h\""
    assert said[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 1: typedef redefinition with different types ('long' vs 'long long')"
    assert said[0].notes[1] == "clang adds, at C's own `int64_t`, which every unit of this program declares as `<stdint.h>` does, before any group's header: previous definition is here"
    assert runtime_named(said[0]).is_err() && said[0].fixes.len() == 0
    windows = head + through + "runtime\\heroes_runtime.h:" + int64.to_str() + ":24: note: previous definition is here\n"
    assert refused(stderr: windows, s: s, decls: decls, runtime: "runtime")[0].notes == said[0].notes
    misspelled = "In file included from build/tu-1/t.c:7:\n./bad.h:1:15: error: unknown type name 'int46_t'; did you mean 'int16_t'?\n" + through + "runtime/heroes_runtime.h:" + int16.to_str() + ":24: note: 'int16_t' declared here\n"
    typo = refused(stderr: misspelled, s: s, decls: decls, runtime: "runtime")
    assert typo.len() == 1
    assert typo[0].notes[0] == "clang adds, at C's own `int16_t`, which every unit of this program declares as `<stdint.h>` does, before any group's header: 'int16_t' declared here"

    # The compiler's: a line of the Heroes library's own under an error clang
    # quoted no line for, a line beside the type's, a second note in the
    # runtime that is no such line, and the type's row in the file clang
    # compiled.
    static = "In file included from build/tu-1/t.c:7:\n./bad.h:2:19: error: static declaration of 'hero_str_len' follows non-static declaration\n" + through + "runtime/heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here\n"
    beside = head + through + "runtime/heroes_runtime.h:" + (runtime_row("typedef __INT8_TYPE__ int8_t;") - 1).to_str() + ":1: note: previous definition is here\n"
    second = head + through + "runtime/heroes_runtime.h:" + int64.to_str() + ":24: note: previous definition is here\nruntime/heroes_runtime.h:10:9: note: expanded from macro 'HERO_X'\n"
    compiled = head + "build/tu-1/t.c:" + int64.to_str() + ":24: note: previous definition is here\n"

    for text in [static, beside, second, compiled]
        assert refused(stderr: text, s: s, decls: decls, runtime: "runtime").len() == 0

# DEFECT 2045: a note at the runtime's own declaration of the name the error's
# caret stands on in the header is the Heroes runtime's, and the header's
# refusal its own, with a `guess` fix renaming the name there. Clang's words as
# Apple clang 21 wrote them on 2026-10-13 for the reproducer, `static inline
# int hero_str_len(int x)`, each line of the runtime's found by its text; a
# second note in the runtime that is no such declaration stays the
# compiler's, and a note at a parameter a call passed a wrong value to is the
# header's since defect 2049 (below).
test "a note at the runtime's own declaration of the name a header declares again is the runtime's (defect 2045)"
    s = program()
    decls = decls_of()
    length = runtime_row("int64_t hero_str_len(HeroStr s);")
    through = "In file included from build/tu-1/t.c:2:\nIn file included from runtime/heroes_unit.h:26:\n"
    head = "In file included from build/tu-1/t.c:7:\n./bad.h:2:19: error: static declaration of 'hero_str_len' follows non-static declaration\n    2 | static inline int hero_str_len(int x) { return x; }\n      |                   ^\n"
    note = "runtime/heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here\n  " + length.to_str() + " | int64_t hero_str_len(HeroStr s);\n      |         ^\n"
    said = refused(stderr: head + through + note + "1 error generated.\n", s: s, decls: decls, runtime: "runtime")
    assert said.len() == 1
    assert said[0].code == "ffi_header_refused"
    assert source.span_text(s, said[0].span) == "\"bad.h\""
    assert said[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 2: static declaration of 'hero_str_len' follows non-static declaration"
    assert said[0].notes[1] == "clang adds, at the Heroes runtime's own `hero_str_len`, which every unit of this program declares before any group's header: previous declaration is here"
    assert said[0].fixes.len() == 1
    assert said[0].fixes[0].certainty == .guess
    assert said[0].fixes[0].title == "rename `hero_str_len` in `bad.h`, a name the Heroes runtime declares first in every unit"
    assert source.span_text(s, said[0].fixes[0].span) == "\"bad.h\"" && said[0].fixes[0].replacement == "\"bad.h\""
    assert runtime_named(said[0]).must() == "hero_str_len"
    windows = head + through + "runtime\\heroes_runtime.h:" + length.to_str() + ":9: note: previous declaration is here\n"
    assert refused(stderr: windows, s: s, decls: decls, runtime: "runtime")[0].notes == said[0].notes

    # The compiler's: a second note in the runtime that is no declaration of
    # the caret's name.
    second = head + through + note + "runtime/heroes_runtime.h:10:9: note: expanded from macro 'HERO_X'\n"
    assert refused(stderr: second, s: s, decls: decls, runtime: "runtime").len() == 0

# DEFECT 2049: a note at a function of the runtime's the header's line calls,
# or at a name of the runtime's clang suggests for one the line misspells, is
# the Heroes runtime's, and the header's refusal its own. Clang's words as
# Apple clang 21 and Debian clang 22.1.8 wrote them alike on 2026-10-13 for
# the reproducers, `hero_str_len(8)` and `HeroSt`, each line of the runtime's
# found by its text.
test "a note at a runtime name the header's line calls or misspells is the runtime's (defect 2049)"
    s = program()
    decls = decls_of()
    length = runtime_row("int64_t hero_str_len(HeroStr s);")
    str_type = runtime_row("} HeroStr;")
    through = "In file included from build/tu-1/t.c:2:\nIn file included from runtime/heroes_unit.h:26:\n"
    call = "In file included from build/tu-1/t.c:7:\n./bad.h:3:53: error: passing 'int' to parameter of incompatible type 'HeroStr'\n    3 | static inline int eight(void) { return hero_str_len(8); }\n      |                                                     ^\n"
    at_parameter = through + "runtime/heroes_runtime.h:" + length.to_str() + ":30: note: passing argument to parameter 's' here\n"
    called = refused(stderr: call + at_parameter, s: s, decls: decls, runtime: "runtime")
    assert called.len() == 1 && called[0].code == "ffi_header_refused"
    assert called[0].message == "`bad.h`, the header this group names, does not compile: clang refuses it at line 3: passing 'int' to parameter of incompatible type 'HeroStr'"
    assert called[0].notes[1] == "clang adds, at `hero_str_len`, a function of the Heroes runtime's own, which every unit of this program declares before any group's header, and the refused line calls: passing argument to parameter 's' here"
    assert called[0].fixes.len() == 1 && called[0].fixes[0].certainty == .guess
    assert runtime_named(called[0]).is_err()
    typo = "In file included from build/tu-1/t.c:7:\n./bad.h:1:33: error: unknown type name 'HeroSt'; did you mean 'HeroStr'?\n    1 | static inline int eight(void) { HeroSt s; (void)s; return 8; }\n      |                                 ^~~~~~\n      |                                 HeroStr\n"
    at_type = through + "runtime/heroes_runtime.h:" + str_type.to_str() + ":3: note: 'HeroStr' declared here\n"
    suggested = refused(stderr: typo + at_type, s: s, decls: decls, runtime: "runtime")
    assert suggested.len() == 1
    assert suggested[0].notes[1] == "clang adds, at `HeroStr`, a name of the Heroes runtime's own, which every unit of this program declares before any group's header, and clang suggests in the refused line: 'HeroStr' declared here"
    assert suggested[0].fixes.len() == 0 && runtime_named(suggested[0]).is_err()

    # The compiler's: a call of another function under the note at the
    # runtime's parameter, and a suggestion of another name than the note's.
    other = "In file included from build/tu-1/t.c:7:\n./bad.h:3:53: error: passing 'int' to parameter of incompatible type 'HeroStr'\n    3 | static inline int eight(void) { return hero_str_lex(8); }\n      |                                                     ^\n"
    unlike = "In file included from build/tu-1/t.c:7:\n./bad.h:1:33: error: unknown type name 'HeroSt'; did you mean 'HeroStx'?\n    1 | static inline int eight(void) { HeroSt s; (void)s; return 8; }\n      |                                 ^~~~~~\n"

    for text in [other + at_parameter, unlike + at_type]
        assert refused(stderr: text, s: s, decls: decls, runtime: "runtime").len() == 0

# The row of the runtime's header that reads `line`, found by its text.
function runtime_row(line: str) -> i64
    rows = ffi_lookup.lines(text: read_file("runtime/heroes_runtime.h").must())

    for at in range(from: 0, to: rows.len())
        if rows[at] == line
            return at + 1

    assert false
    return 0

function has(notes: [str], needle: str) -> bool
    for note in notes
        if !clang_place.offset_of(text: note, needle: needle).is_err()
            return true

    return false

# Two groups whose headers each declare `twice` another way, as clang 21 on
# this Mac refused them in one unit in both orders (defect 538): told the same
# words whichever is included first, on the group whose header sorts first.
test "two headers clang refuses together are both told, whichever the program includes first (defect 538)"
    text = "extern \"a.h\"\n    function twice(x: i64) -> i64\n\nextern \"b.h\"\n    function twice2(x: i32) -> i32\n\nfunction main()\n    print(twice(x: 3))\n"
    s = source.new_source(name: "p.hero", text: text)
    parsed = parse.parse(text)
    a_first = "In file included from build/tu-1/p.c:8:\n./b.h:1:19: error: conflicting types for 'twice'\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n./a.h:1:20: note: previous definition is here\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n1 error generated.\n"
    b_first = "In file included from build/tu-1/p.c:8:\n./a.h:1:20: error: conflicting types for 'twice'\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n./b.h:1:19: note: previous definition is here\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n1 error generated.\n"
    one = refused(stderr: a_first, s: s, decls: parsed.decls, runtime: "runtime")
    two = refused(stderr: b_first, s: s, decls: parsed.decls, runtime: "runtime")
    assert one.len() == 1
    assert one[0].code == "ffi_header_refused"
    assert source.span_text(s, one[0].span) == "\"a.h\""
    assert one[0].message == "`a.h` and `b.h`, the headers two groups name, cannot be compiled in one unit: clang refuses them together, at `a.h` line 1 and `b.h` line 1: conflicting types for 'twice'"
    assert one[0].notes[0] == "`a.h` line 1 reads `static inline long twice(long x) { return 2 * x; }`"
    assert one[0].notes[1] == "`b.h` line 1 reads `static inline int twice(int x) { return x + x; }`"
    assert one[0].notes[2] == "the other group names `b.h` at line 4"
    assert one[0].notes.len() == 4
    assert two.len() == 1
    assert two[0].message == one[0].message
    assert two[0].notes == one[0].notes
    assert two[0].span.start == one[0].span.start

# Defect 550: the earlier declaration sits in a file `a.h` includes, which no
# group names, and clang prints that note's own includes since panel 202's
# (g) (`cli/flags.hero`), as Apple clang 21 wrote them for lane b17-emit's
# `inc1` and `inc2`: both orders are told the same words, the file named with
# the header it arrives through.
test "a note in a file another group's header includes is told through that header, whichever is included first (defect 550)"
    text = "extern \"a.h\"\n    function twice(x: i64) -> i64\n\nextern \"b.h\"\n    function thrice(x: i32) -> i32\n\nfunction main()\n    print(twice(x: 3))\n"
    s = source.new_source(name: "p.hero", text: text)
    parsed = parse.parse(text)
    a_first = "In file included from build/tu-1/p.c:3:\n./b.h:1:19: error: conflicting types for 'twice'\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\nIn file included from build/tu-1/p.c:2:\nIn file included from ./a.h:1:\n./a_impl.h:1:20: note: previous definition is here\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\n1 error generated.\n"
    b_first = "In file included from build/tu-1/p.c:3:\nIn file included from ./a.h:1:\n./a_impl.h:1:20: error: conflicting types for 'twice'\n    1 | static inline long twice(long x) { return 2 * x; }\n      |                    ^\nIn file included from build/tu-1/p.c:2:\n./b.h:1:19: note: previous definition is here\n    1 | static inline int twice(int x) { return x + x; }\n      |                   ^\n1 error generated.\n"
    one = refused(stderr: a_first, s: s, decls: parsed.decls, runtime: "runtime")
    two = refused(stderr: b_first, s: s, decls: parsed.decls, runtime: "runtime")
    assert one.len() == 1
    assert one[0].message == "`a.h` and `b.h`, the headers two groups name, cannot be compiled in one unit: clang refuses them together, at `a_impl.h` line 1, which `a.h` includes, and `b.h` line 1: conflicting types for 'twice'"
    assert two[0].message == one[0].message
    assert two[0].notes == one[0].notes
    assert source.span_text(s, one[0].span) == "\"a.h\""
