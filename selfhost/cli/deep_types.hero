# What a build adds when the C compiler died on its C (defect 170,
# 2026-10-03; design.md §4.17, the message carries what fixes the program):
# how deep the program's own types nest by value, the one kind of a source's
# depth that reaches the C compiler. Every other kind is flat in the emitted
# C, measured: each shape of panel 184's table, at 90, emits C whose brackets
# nest 4 deep. A struct holding a struct is converted by the C compiler with a
# recursion as deep as the chain, on a stack of the C compiler's own, which
# this compiler does not choose: Apple clang 21 on arm64 macOS died at 3,000
# variants nested by value (at 2,500 in defect 140's record) until
# `emit/typeorder.hero` handed it the chain from its bottom, and its debug
# information still died between 3,000 and 5,000 (measured 2026-10-03) until
# the same order reached the debug-information writer (defect 219, panel
# 197's R1; the last test below).
#
# So the note names the deepest chain where it is past the depth `typeorder`
# starts helping at, and says nothing of depth where it is not: the C
# compiler died of something else then, and a sentence about depth would be a
# guess. The program is not refused (panel 184's R6: no source is refused for
# its depth), and the build stays the tool unable to finish, exit 2.

use ast
use source
use check/state
use check/table
use emit/types
use emit/typeorder
use parse
use resolve
use checker
use bytes
use cli/compile
use cli/compiling
use cli/process
use cli/strings

# The deepest chain: how many declared types it holds by value, the one at
# its top counted, and that type's declaration (-1 when there is none).
record Deepest
    depth: i64
    top: i64

# Where the walk below stands in one declaration, as `typeorder.visit`'s
# frames do: the declaration, what it holds, how many of those it has gone
# into.
record Frame
    decl: i64
    holds: [i64]
    next: i64

# The note, or "" for a failure that is not the C compiler dying, or a
# program whose types are not deep.
function note(code: str, decls: [ast.Decl], c: state.Checked, s: source.Source) -> str
    if code != "crashed"
        return ""
    found = deepest(c, decls)

    if found.top < 0 || found.depth <= typeorder.IN_ORDER_FROM
        return ""
    name = source.span_text(s, decls[found.top].name)
    return "\n  note: this program's types nest " + found.depth.to_str() + " deep by value, `" + name + "` holding a type that holds another, and so on down: a C compiler walks such a type with a recursion as deep as the chain, on a stack of its own, and where that stack ends is the C compiler's limit, not this language's\n  note: one level held through an array, `[T]` where a field says `T`, ends the chain there"

# The deepest chain of declared types held by value, through any options and
# fixed arrays between them: what each declaration holds, found first
# (`held_graph`), then walked as data (`deepest_of`).
function deepest(c: state.Checked, decls: [ast.Decl]) -> Deepest
    roots = types.aggregates(c, decls)
    return deepest_of(roots, graph: held_graph(c, decls, roots: roots))

# What each declaration reachable from `roots` holds by value, found by a
# queue, so no stack grows with the chain.
function held_graph(c: state.Checked, decls: [ast.Decl], roots: [i64]) -> {i64: [i64]}
    found: {i64: [i64]} @= {}
    queue: [i64] @= roots
    next: i64 @= 0

    while next < queue.len()
        decl = queue[next]
        next @ next + 1

        if found[decl].is_err()
            held = holds(c, decls, decl: decl)
            found[decl] @ held

            for one in held
                if found[one].is_err()
                    queue @ queue.push(one)

    return found

# The deepest chain `graph` holds from any of `roots`, each declaration's
# depth the deepest it holds plus one. A stack of its own and not the
# machine's, since the chain is exactly what it measures (defect 140's
# lesson): a recursion here would die where the C compiler did. Taken as data
# so that a chain no program reaches holds it to that, which a recursion
# survives no more than a C compiler (defect 490, as 189 held `typeorder`).
function deepest_of(roots: [i64], graph: {i64: [i64]}) -> Deepest
    none: [i64] = []
    depth: {i64: i64} @= {}
    best: Deepest @= Deepest(depth: 0, top: -1)

    for root in roots
        if !depth[root].is_err()
            continue
        frames: [Frame] @= [Frame(decl: root, holds: graph[root].default(none), next: 0)]
        live: i64 @= 1

        while live > 0
            top = frames[live - 1]

            if top.next < top.holds.len()
                held = top.holds[top.next]
                frames[live - 1].next @ top.next + 1

                if depth[held].is_err()
                    entered = Frame(decl: held, holds: graph[held].default(none), next: 0)

                    if live < frames.len()
                        frames[live] @ entered
                    else
                        frames @ frames.push(entered)
                    live @ live + 1
            else
                # Each held declaration is measured by now: the checker
                # refuses a by-value cycle, so the walk is over a DAG.
                below: i64 @= 0

                for held in top.holds
                    d = depth[held].default(0)

                    if d > below
                        below @ d

                depth[top.decl] @ below + 1

                if below + 1 > best.depth
                    best @ Deepest(depth: below + 1, top: top.decl)
                live @ live - 1

    return best

# The declared types one declaration holds by value: its fields' and its
# cases' fields', seen through an option or a fixed array to what they hold.
function holds(c: state.Checked, decls: [ast.Decl], decl: i64) -> [i64]
    out: [i64] @= []
    fields: [ast.Field] @= types.fields_of(decls, decl: decl)

    for one_case in types.cases_of(decls, decl: decl)
        for field in one_case.fields
            fields @ fields.push(field)

    for field in fields
        found = state.written_type(c, field.ty)

        if !found.is_err()
            held = held_decl(c, ty: found.must())

            if held >= 0
                out @ out.push(held)

    return out

# The declaration a field's type holds by value, or -1: an option and a
# fixed array hold what they wrap; an array, a map and a function hold a
# pointer.
function held_decl(c: state.Checked, ty: i64) -> i64
    at: i64 @= ty

    while true
        match table.get(c.types, at)
            .named n                                                  => return n.decl
            .case_ty ct                                               => return ct.decl
            .fallible o                                               => at @ o.payload
            .fixed f                                                  => at @ f.element
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return -1
            .array | .map | .function_ty                              => return -1
            .failure | .generic | .error                              => return -1

## Tests

# `n` records, each holding the one before by value, checked.
function chained(n: i64) -> Checked
    parts: [str] @= ["record R0\n    v: i64\n"]

    for i in range(from: 1, to: n)
        parts @ parts.push("record R" + i.to_str() + "\n    inner: R" + (i - 1).to_str() + "\n")

    parts @ parts.push("function main()\n    xs: [R" + (n - 1).to_str() + "] = []\n    print(xs.len())\n")
    text = parts.join("\n")
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    return Checked(c: checker.check(parsed.tree, out, s, parsed.decls), decls: parsed.decls, s: s)

record Checked
    c: state.Checked
    decls: [ast.Decl]
    s: source.Source

test "the note names the deepest chain past the depth the emitter helps from, and says nothing else (defect 170)"
    deep = chained(n: 40)
    assert deep.c.diagnostics.len() == 0
    found = deepest(deep.c, deep.decls)
    assert found.depth == 40
    assert source.span_text(deep.s, deep.decls[found.top].name) == "R39"
    assert note(code: "crashed", decls: deep.decls, c: deep.c, s: deep.s).len() > 0
    assert note(code: "clang", decls: deep.decls, c: deep.c, s: deep.s) == ""
    shallow = chained(n: 32)
    assert note(code: "crashed", decls: shallow.decls, c: shallow.c, s: shallow.s) == ""

# Defect 490: the walk is held to a chain a hundred thousand deep given as
# data, which no program reaches (the front end costs the square of a chain
# of records, 17 billion instructions at 5,000, defect 189's reading) and no
# recursion of the walk survives: one dies between 6,000 and 7,000 deep on
# this Mac's 8 MiB stack at `-O0` (`panic: stack exhausted`, defect 189's
# probe). The mutant restoring the recursion fails here and passes the test
# above.
test "the deepest chain is walked with a stack of its own, a hundred thousand deep (defect 490)"
    n: i64 = 100000
    graph: {i64: [i64]} @= {}
    graph[0] @ []

    for i in range(from: 1, to: n)
        graph[i] @ [i - 1]

    found = deepest_of([n - 1, 3], graph: graph)
    assert found.depth == n
    assert found.top == n - 1

    # Two chains below one: the deeper counts, and each is measured once.
    fork: {i64: [i64]} @= {}
    fork[0] @ []
    fork[1] @ [0]
    fork[2] @ [1]
    fork[3] @ [0, 2]
    assert deepest_of([3], graph: fork).depth == 4
    assert deepest_of([], graph: fork).top == -1

# **The debug information is handed a chain from its bottom** (defect 219,
# panel 197's R1). Clang keeps the type of every explicit cast in a list
# LLVM's debug-information writer builds before any function
# (`retainedTypes`), and a writer that meets a chain's top first recurses as
# deep as the chain: 5,000 variants died in clang's backend under `-g` on
# this Mac, and 10,000 under the CI's Linux clang 18.1.3. Past
# `typeorder.IN_ORDER_FROM` the unit's touch casts each of its structs from
# the bottom, ahead of the element descriptor that casts to the top. This
# asks the platform's own clang, under a unit's words at `-O0`, which of the
# chain's types that list holds first, of the whole unit `--emit-c` writes:
# a type outside the chain may stand before it (the unit retains a `void *`
# and a `uint64_t` of its own, measured), and none recurses. No golden can be
# the witness: the 32- and 100-deep cases build without the cast on every
# clang measured, and a revert puts the chain's top first here (`h_t_R39`,
# measured 2026-10-07 with the touch written as a declaration again).
test "the debug information meets a type chain past the emitter's depth from its bottom (defect 219)"
    n: i64 = typeorder.IN_ORDER_FROM + 8
    parts: [str] @= ["variant R0\n    a\n        v: i64\n    b\n"]

    for i in range(from: 1, to: n)
        parts @ parts.push("variant R" + i.to_str() + "\n    a\n        inner: R" + (i - 1).to_str() + "\n    b\n")

    parts @ parts.push(
        "function main()\n    xs: [R" + (n - 1).to_str() + "] = []\n    print(xs.len())\n    print(xs == xs)\n"
    )
    none: [str] = []
    options = compile.Options(
        level: "-O0",
        dump_ir: false,
        emit_c: true,
        output: fail(code: "none", msg: "stdout"),
        sanitize: false,
        target: .program_build,
        headers_from: none,
        library: none
    )
    unit = compile.to_unit(
        source.new_source(name: "t.hero", text: parts.join("\n")),
        options,
        version: "0.0.0-test"
    ).must()
    root = "build/selftest-retained-219"
    assert !process.mkdir_all(root).is_err()
    assert !write_file(path: root + "/unit.c", text: unit.c).is_err()
    under = compiling.Compiling(
        level: "-O0",
        sanitize: false,
        search_include: none,
        package_flags: none,
        runtime: "runtime",
        source_dir: ""
    )
    words: [str] @= strings.with_all(list: ["clang"], more: compiling.unit_words(under))
    words @ strings.with_all(list: words, more: ["-emit-llvm", "-S", root + "/unit.c", "-o", root + "/unit.ll"])
    assert process.run(program: "clang", words: words, out: process.discard(), err: process.discard()).code == 0
    assert first_retained(ir: read_file(root + "/unit.ll").must(), prefix: "h_t_R") == "h_t_R0"

# The name of the first type a unit's debug information retains whose name
# opens with `prefix`, read from clang's textual IR: the compile unit's
# `retainedTypes: !N`, that list's members in order, each named through at
# most four pointer or qualifier types to a named one; "" where none is.
function first_retained(ir: str, prefix: str) -> str
    members = metadata_line(ir, id: number_after(text: ir, needle: "retainedTypes: !"))
    opened = bytes.rfind(text: members, needle: "!{")

    if opened.is_err()
        return ""
    at: i64 @= opened.must() + 2

    while at < members.len()
        if members[at] == '!'
            name = named(ir, id: digits_at(text: members, at: at + 1))

            if strings.starts_with(text: name, prefix: prefix)
                return name
        at @ at + 1

    return ""

# The name metadata `!id` carries, through at most four types it is a pointer
# to or a qualifier of; "" where none is named.
function named(ir: str, id: i64) -> str
    member: i64 @= id
    hops: i64 @= 0

    while member >= 0 && hops < 5
        line = metadata_line(ir, id: member)
        found = bytes.rfind(text: line, needle: "name: \"")

        if !found.is_err()
            from = found.must() + 7
            to: i64 @= from

            while to < line.len() && line[to] != '"'
                to @ to + 1

            return line.slice(from: from, to: to)
        member @ number_after(text: line, needle: "baseType: !")
        hops @ hops + 1

    return ""

# The decimal number right after the last `needle` in `text`, or -1.
function number_after(text: str, needle: str) -> i64
    found = bytes.rfind(text: text, needle: needle)

    if found.is_err()
        return -1
    return digits_at(text: text, at: found.must() + needle.len())

# The decimal number whose digits start at `at` in `text`, or -1.
function digits_at(text: str, at: i64) -> i64
    number: i64 @= -1
    next: i64 @= at

    while next < text.len() && bytes.is_digit(text[next])
        if number < 0
            number @ 0
        number @ number * 10 + (text[next] - '0').to_i64().must()
        next @ next + 1

    return number

# The line of metadata `!id` in clang's textual IR, or "".
function metadata_line(ir: str, id: i64) -> str
    found = bytes.rfind(text: ir, needle: "\n!" + id.to_str() + " = ")

    if id < 0 || found.is_err()
        return ""
    end: i64 @= found.must() + 1

    while end < ir.len() && ir[end] != '\n'
        end @ end + 1

    return ir.slice(from: found.must() + 1, to: end)
