# Which order of a module's headers compiles, asked of clang on a refused
# header's path (design.md §4.19, §4.17; panel 204's R3, ratified
# 2026-10-10; defect 563): the three searches `cli/header_order.hero` and
# `cli/name_order.hero` tell their notes from, a move of one of the module's
# groups across the refused header (`search`), the module's own groups
# written above it (`above`) and a header of C's own read just before it
# (`standard`), each compiling the unit's whole opening
# (`cli/order_trial.hero`) under the unit's own words.
#
# **Every search is first asked the order as written** (panel 245's R1,
# provisional, author ratification pending; defect 2469; the sitting's
# critic, items 7 and 8): a trial that compiles the unit's own order cannot
# see what refused it, so no other order it compiles may be told. Clang's
# syntax pass is asked first (`sees`); where it compiles the written order,
# the unit was refused for what only code generation says, a call to a
# function its header marks `warning` first among them, and every trial
# generates code (`order_trial.generated`); where that compiles too, no
# trial reproduces the refusal, no order is told and the refusal keeps its
# own notes. Until then a header's `static implicit_x = 3;`, refused by the
# unit, compiled in the syntax trials, whose words left `-Wimplicit-int`
# off, and the two notes sent the author to each other's order; and curl's
# checker of `curl_easy_setopt`'s argument, said only while clang generates
# code, was told *compiles after `stdio.h`*. Split out of
# `cli/header_order.hero` at the landing, which took it past §11's 300
# lines: these ask clang which order compiles, and that module tells it.

use ast
use cli/compiling
use cli/order_groups
use cli/order_trial
use cli/process
use cli/toolchain
use source

# The C11 headers (C11 7.1.2) but the four every unit reads already, the
# likeliest a header leans on first.
constant STANDARD: [str]
    [
        "stdio.h"
        "stdlib.h"
        "string.h"
        "stdarg.h"
        "time.h"
        "limits.h"
        "inttypes.h"
        "errno.h"
        "ctype.h"
        "signal.h"
        "setjmp.h"
        "locale.h"
        "wchar.h"
        "wctype.h"
        "float.h"
        "assert.h"
        "complex.h"
        "fenv.h"
        "iso646.h"
        "stdalign.h"
        "stdatomic.h"
        "stdnoreturn.h"
        "tgmath.h"
        "threads.h"
        "uchar.h"
    ]

# A move that compiles: the other group's header, whether it goes before the
# refused one (else the refused one goes before it), and both orders.
record Move
    other: str
    before: bool
    written: [str]
    order: [str]

# The first move of a group of `module` across the refused header, in the
# unit's order, after which the unit's opening and `question` compile.
function search(s: source.Source, decls: [ast.Decl], t: toolchain.Toolchain, under: compiling.Compiling, written: [str], target: str, module: str, question: str, generating: bool) -> Move?
    here = order_groups.index_of(written, one: target)

    if here < 0
        return fail(code: "none", msg: "the unit does not read the header")
    words = compiling.unit_words(under)
    other: i64 @= 0

    while other < written.len()
        if other != here && !order_groups.group_in(s, decls, header: written[other], module: module).is_err()
            order: [str] @= []

            if other > here
                order @ order_groups.moved(written, from: other, to: here)
            else
                order @ order_groups.moved(written, from: here, to: other)

            if asks(t, words: words, order: order, target: target, question: question, generating: generating)
                return ok(Move(other: written[other], before: other > here, written: written, order: order))
        other @ other + 1

    return fail(code: "none", msg: "no move compiles")

# The headers `missing`, this module's groups' written above the refused one
# that the unit does not read, read just before it, joined where the unit
# then compiles.
function above(t: toolchain.Toolchain, under: compiling.Compiling, written: [str], target: str, missing: [str], generating: bool) -> str?
    here = order_groups.index_of(written, one: target)

    if here < 0 || missing.len() == 0
        return fail(code: "none", msg: "nothing written above is missing")
    order: [str] @= []

    for one in written.slice(from: 0, to: here)
        order @ order.push(one)

    for one in missing
        order @ order.push(one)

    for one in written.slice(from: here, to: written.len())
        order @ order.push(one)

    if !compiles(t, words: compiling.unit_words(under), text: order_trial.opening(order, question: ""), generating: generating)
        return fail(code: "none", msg: "the module's own order does not compile here")
    return ok(missing.join("`, `"))

# The first C11 header the unit does not read after which the refused one
# compiles where it stands, with `question` after it.
function standard(t: toolchain.Toolchain, under: compiling.Compiling, written: [str], target: str, question: str, generating: bool) -> str?
    here = order_groups.index_of(written, one: target)

    if here < 0
        return fail(code: "none", msg: "the unit does not read the header")
    words = compiling.unit_words(under)

    for candidate in STANDARD
        if order_groups.index_of(written, one: candidate) < 0
            order: [str] @= []

            for one in written.slice(from: 0, to: here)
                order @ order.push(one)

            order @ order.push(candidate)

            for one in written.slice(from: here, to: written.len())
                order @ order.push(one)

            if asks(t, words: words, order: order, target: target, question: question, generating: generating)
                return ok(candidate)

    return fail(code: "none", msg: "no header of C's own is what it needs")

# Whether `order` answers a search: with no `question`, the unit's opening in
# that order compiles; with one, `target` declares what it asks there.
function asks(t: toolchain.Toolchain, words: [str], order: [str], target: str, question: str, generating: bool) -> bool
    if question == ""
        return compiles(t, words: words, text: order_trial.opening(order, question: ""), generating: generating)
    return declares(t, words: words, order: order, target: target, question: question, generating: generating)

# **Whether `target`, read where `order` puts it, declares what `question`
# asks** (defect 2445, 2026-11-11), the question `cli/declared_ladder.hero`
# asks at a header's rung: asked right after it, so no header read after it
# answers, `heroes_standard.h`'s `<math.h>` among them; and not answered by
# the headers before it, which compile without the question and refuse it.
# Asked after the whole order until then, a header another one declares the
# name for was told it declares it: `t.h` read alone after `d.h`, which
# declares the name where it stands first, was told it declares it *only in
# another order of this module's headers*, and a `<math.h>` read as a
# prerequisite was told what `stdio.h` needs for `sqrt`.
function declares(t: toolchain.Toolchain, words: [str], order: [str], target: str, question: str, generating: bool) -> bool
    here = order_groups.index_of(order, one: target)

    if here < 0
        return false
    through = order.slice(from: 0, to: here + 1)
    before = order.slice(from: 0, to: here)

    if !compiles(t, words: words, text: order_trial.opening(through, question: question), generating: generating)
        return false

    if !compiles(t, words: words, text: order_trial.opening(before, question: ""), generating: generating)
        return false
    return !compiles(t, words: words, text: order_trial.opening(before, question: question), generating: generating)

# How a trial sees the unit's refusal: by clang's syntax pass (`false`), by
# generating code (`true`), or not at all, where the order as written
# compiles both ways and no other order's compiling says anything.
function sees(t: toolchain.Toolchain, under: compiling.Compiling, written: [str]) -> bool?
    words = compiling.unit_words(under)
    text = order_trial.opening(written, question: "")

    if !order_trial.compiled(t, words: words, text: text).compiles
        return ok(false)

    if !order_trial.generated(t, words: words, text: text).compiles
        return ok(true)
    return fail(code: "none", msg: "no trial reproduces the refusal")

# Whether `text` compiles under `words`, generated where the refusal is code
# generation's.
function compiles(t: toolchain.Toolchain, words: [str], text: str, generating: bool) -> bool
    if generating
        return order_trial.generated(t, words: words, text: text).compiles
    return order_trial.compiled(t, words: words, text: text).compiles

## Tests

# DEFECT 2445: the question is the header's own, asked where it stands. Run
# against this machine's C library: `stdio.h` declares no `sqrt` on any of
# the three, and `heroes_standard.h` reads `<math.h>` after the groups.
test "a header is told it declares a name only where the name is its own, never another header's (defect 2445)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    root = "build/selftest-order-search-2445"
    _ = process.remove_tree(root).is_err()
    assert !process.mkdir_all(root).is_err()
    assert !write_file(path: root + "/t2445.h", text: "#define T2445_READ 1\n").is_err()
    assert !write_file(path: root + "/d2445.h", text: "#ifndef T2445_READ\nint x2445(void);\n#endif\n").is_err()
    under = compiling.Compiling(
        level: "-O0",
        sanitize: false,
        search_include: [root],
        pkgconfig_flags: [],
        runtime: t.runtime,
        source_dir: root
    )
    words = compiling.unit_words(under)
    sqrt = "__attribute__((unused)) static void hero_order_q(void) { (void)(sqrt); }"
    x = "__attribute__((unused)) static void hero_order_q(void) { (void)(x2445); }"

    # Read alone, `stdio.h` declares no `sqrt`, which `<math.h>` declares
    # alone and after it, and not after itself read first.
    assert !declares(t, words: words, order: ["stdio.h"], target: "stdio.h", question: sqrt, generating: false)
    assert declares(t, words: words, order: ["math.h"], target: "math.h", question: sqrt, generating: false)
    assert declares(t, words: words, order: ["stdio.h", "math.h"], target: "math.h", question: sqrt, generating: false)
    assert !declares(t, words: words, order: ["math.h", "stdio.h"], target: "stdio.h", question: sqrt, generating: false)

    # A header of the program's that declares `x2445` only read before
    # `t2445.h`: its own where it stands first, never `t2445.h`'s.
    assert declares(t, words: words, order: ["d2445.h", "t2445.h"], target: "d2445.h", question: x, generating: false)
    assert !declares(t, words: words, order: ["d2445.h", "t2445.h"], target: "t2445.h", question: x, generating: false)
    assert !declares(t, words: words, order: ["t2445.h", "d2445.h"], target: "d2445.h", question: x, generating: false)
    assert !declares(t, words: words, order: ["t2445.h"], target: "missing2445.h", question: x, generating: false)

    # No header of C's own is what `stdio.h` needs for `sqrt`: `<tgmath.h>`
    # read before it declares the name itself.
    assert standard(
        t,
        under: under,
        written: ["stdio.h"],
        target: "stdio.h",
        question: sqrt,
        generating: false
    ).is_err()

    # With no question a search asks the order whole, as before.
    assert asks(t, words: words, order: ["stdio.h", "math.h"], target: "stdio.h", question: "", generating: false)
    assert !process.remove_tree(root).is_err()
