# A clang line's words handed to clang in a file, `clang @<file>`, so that no
# line is held to how long one command may be (design.md §3.1, §1.12; defect
# 583).
#
# WHY. Windows has no argv: `CreateProcess` takes the whole line as one string
# of at most 32,767 UTF-16 characters and refuses a longer one before anything
# runs (`hero_run_win_command_line` in `runtime/parts/run.c` builds it). The
# link names every object of a program, and the compiler's own per-module
# build had 558 of them, 32,243 characters of paths: on the Windows box (clang
# 23.1.1) clang could not be started, the system's reason 87 (lane b18-guard,
# 2026-10-10). This tree's build had 578 the same day, 33,385 characters with
# their separators, measured on this Mac. POSIX holds a line to `ARG_MAX`,
# 1,048,576 bytes on Darwin and 2,097,152 in the Linux arm64 container
# (`getconf`, 2026-10-10), which no build here comes near.
#
# ONE RULE READS THE FILE BACK, ON EVERY PLATFORM. clang splits a response
# file by its host's rule unless the line names one: GNU's on POSIX, where a
# backslash escapes the byte after it, and Windows' on Windows, where a
# backslash is a byte unless a quote follows it. No spelling of `a\b` reads
# back the same under both, so the line says `--rsp-quoting=posix` (`QUOTING`)
# and every word is written by GNU's rule (`quoted`): in double quotes, a
# backslash before each backslash and each quote, one word a line. Measured
# 2026-10-10 under Apple clang 21.0.0 on this Mac and Debian clang 22.1.8 in
# the Linux arm64 container: fourteen objects named with a space, a tab, a
# line end, `'`, `"`, `\`, `\\`, a last `\`, `$`, `;`, `&`, `*`, `#`,
# `<CFGDIR>` and a two-byte `e` with its accent linked through such a file,
# each found at its own name, and clang said nothing under `-Weverything`;
# under `--rsp-quoting=windows` the two names holding a backslash were not
# found. **On Windows this is unrun**: the cases below and `cli/link.hero`'s
# run there on the CI's Windows leg, which is handed only the names a Windows
# file may have (`hard_names`, defect 602).
#
# A file holds bytes, and clang reads them as UTF-8 (a byte-order mark it
# would strip is never written), which is what a `str` holds and what the
# runtime's manifest makes every narrow name on Windows (`runtime/parts/
# codepage.c`). A word that opens with `@` inside the file is read as a
# file's name, as it is on a line: no word this compiler writes opens so.

use cli/digest
use cli/process
use cli/publish

# The rule clang reads the file by, named on the line so that no host's
# default is asked.
constant QUOTING: str
    "--rsp-quoting=posix"

# The line that runs `line` with its words after the first written at `at`:
# `clang --rsp-quoting=posix @<at>`. What a caller adds after it is read after
# them, as it was on the line. Whether `at` is keyed is the caller's to say
# (`publish.write_whole`).
function through(line: [str], at: str, keyed: bool) -> [str]?
    publish.write_whole(path: at, text: text_of(line), keyed: keyed)?
    return ok(["clang", QUOTING, "@" + at])

# **A link's words, in a file in the binary's home** (`link.binary_home`,
# defect 583). The home is named by every one of those words, so the file's
# path and its bytes are the line's alone, it is keyed, and six builds of one
# program publish one file; it is never a word of a key, so a warm build
# stays warm. Always, and not past a length: one path, which every
# platform's build runs, its price one file of the line's size per link.
function for_link(line: [str], home: str) -> [str]?
    process.mkdir_all(publish.beside(path: home, name: "."))?
    return through(line: line, at: publish.beside(path: home, name: LINK_WORDS), keyed: true)

# The file's name in the home. What the linker writes is published under
# the binary's own name (`link.published_as`), the binary, a `.pdb`, a
# `.dSYM`, and a linker writes no `.rsp`, so none of it is published as this.
constant LINK_WORDS: str
    "link-words.rsp"

# **A compile's words, a unit's or a probe's, in a file named by them**
# (defect 586). Every package a program's groups name reaches every unit's
# compile line and every probe's whole (`compiling.search_words`), so the
# line grows with the packages as the link grew with the objects: the fifty
# largest `pkg-config --cflags` answers of this Mac's 505 packages are 34,670
# characters, past the 32,767 Windows takes (measured 2026-10-10). So the line
# a caller builds, `clang` and the words its run shares with every other run
# of the build, goes through a file, and the caller adds its own after it,
# its input, its output and its listing. Always, and not past a length: one
# path on every platform.
#
# **The file is named by its bytes**, `words-<digest>.rsp` in `dir`, so any
# directory under `build/` serves, every run of the same words reads one file,
# and no key moves: a key names the words, never the line that carries them.
# It is read back before it is trusted and written whole where it says
# anything else (`publish.write_whole`, keyed: another build's copy is these
# bytes), so a file a power cut zeroed is written again, never read as words.
# Measured on this Mac: a unit compiled from such a file and from the line
# gave one object, byte for byte, and one dependency listing, which names no
# `.rsp`. **Where the file cannot be written the line is run as it stands**:
# the same words, so no answer can differ, and the build's own writes into
# the same `build/` say why it refuses.
function carried(line: [str], dir: str) -> [str]
    text = text_of(line)
    at = dir + "/words-" + digest.digest(text) + ".rsp"
    held = read_file(at)

    if !held.is_err() && held.must() == text
        return ["clang", QUOTING, "@" + at]

    if process.mkdir_all(dir).is_err()
        return line
    written = through(line: line, at: at, keyed: true)

    if written.is_err()
        return line
    return written.must()

# The words of `line` but its first, one a line, each by `quoted`.
function text_of(line: [str]) -> str
    out: [str] @= []
    at: i64 @= 1

    while at < line.len()
        out @ out.push(quoted(line[at]))
        at @ at + 1

    return out.join("\n") + "\n"

# One word in double quotes, a backslash before each backslash and each
# quote: GNU's rule reads any other byte inside quotes as itself, a space, a
# tab and a line end among them. Cut only beside those two ASCII bytes, which
# no UTF-8 character holds, so no slice splits one.
function quoted(word: str) -> str
    parts: [str] @= ["\""]
    start: i64 @= 0
    at: i64 @= 0

    while at < word.len()
        if word[at] == 92 || word[at] == 34
            parts @ parts.push(word.slice(from: start, to: at))
            parts @ parts.push("\\")
            start @ at

        at @ at + 1

    parts @ parts.push(word.slice(from: start, to: word.len()))
    parts @ parts.push("\"")
    return parts.join("")

## Tests

use cli/strings
use cli/toolchain

test "a word is written in double quotes with a backslash before each backslash and each quote (defect 583)"
    assert quoted("build/tu-0/a.o") == "\"build/tu-0/a.o\""
    assert quoted("a b\tc") == "\"a b\tc\""
    assert quoted("a\\b") == "\"a\\\\b\""
    assert quoted("q\"x") == "\"q\\\"x\""
    assert quoted("end\\") == "\"end\\\\\""
    assert quoted("") == "\"\""
    assert text_of(["clang", "x.o", "-l", "m"]) == "\"x.o\"\n\"-l\"\n\"m\"\n"
    assert text_of(["clang"]) == "\n"

test "a compile's words are carried in a file named by them, read back before it is trusted (defect 586)"
    dir = "build/selftest-response-carried"
    assert !process.remove_tree(dir).is_err()
    line = ["clang", "-DA=1", "-I", "a b"]
    first = carried(line: line, dir: dir)
    assert first.len() == 3
    assert first[0] == "clang"
    assert first[1] == QUOTING
    at = first[2].slice(from: 1, to: first[2].len())
    assert at == dir + "/words-" + digest.digest(text_of(line)) + ".rsp"
    assert read_file(at).must() == text_of(line)

    # The same words are the same file, and other words another.
    assert carried(line: line, dir: dir) == first
    assert carried(line: ["clang", "-DA=2"], dir: dir) != first

    # A file that says anything else, as a power cut can leave one, is
    # written again before clang is pointed at it.
    assert !write_file(path: at, text: "\"-DA=0\"\n").is_err()
    assert carried(line: line, dir: dir) == first
    assert read_file(at).must() == text_of(line)

    # Where no file can be made, the line runs as it stands.
    blocked = dir + "/blocked"
    assert !write_file(path: blocked, text: "a file, not a directory\n").is_err()
    assert carried(line: line, dir: blocked + "/inner") == line
    assert !process.remove_tree(dir).is_err()

test "the line names the file and the one rule it is read by (defect 583)"
    dir = "build/selftest-response-line"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    at = dir + "/words.rsp"
    assert through(line: ["clang", "-g", "a b.o"], at: at, keyed: false).must() == ["clang", "--rsp-quoting=posix", "@" + at]
    assert read_file(at).must() == "\"-g\"\n\"a b.o\"\n"
    assert !process.remove_tree(dir).is_err()

# Every name a platform lets a file have that a rule could misread. Both are
# handed a space, a quote, a two-byte character and the shell's own bytes; on
# Windows the backslash is the separator, and a name under it. **POSIX alone
# is handed every byte Windows refuses in a name** (`windows_refuses`, defect
# 602): the double quote, `<CFGDIR>`'s angles, `:`, `|`, `?` and `*`, the tab
# and the line end, and the backslash inside a name, doubled and last, which
# Windows reads as a separator. `<CFGDIR>x.o` was on both lists until defect
# 602: the CI's Windows leg (clang 20.1.8) could not compile an object under
# it, and the assertion named no name.
function hard_names(windows: bool) -> [str]
    accent: [u8] = [195, 169]
    names: [str] = [
        "sp ace.o"
        "apo'st.o"
        "caf" + accent.validated_bytes().must() + ".o"
        "dollar$HOME.o"
        "semi;amp&.o"
        "hash#pct%.o"
        "paren(1).o"
    ]

    if windows
        return names.push("sub\\inner.o")
    return strings.with_all(
        list: names,
        more: ["quo\"te.o", "<CFGDIR>x.o", "colon:x.o", "pipe|ask?.o", "star*.o", "back\\slash.o", "dbl\\\\back.o", "trail\\", "tab\tx.o", "line\nend.o"]
    )

# Why Windows refuses `name` as a file's, or "" where it holds it. Each part
# between two `\` is read by Microsoft's rules (*Naming Files, Paths, and
# Namespaces*, learn.microsoft.com, read 2026-10-11): none of `< > : " / | ?
# *` and no byte below 32, no part ending in a space or a dot, and no device's
# name, `NUL.o` being `NUL` as `NUL.tar.gz` is. Asked of the list Windows is
# handed on every platform, so a name no Windows file may have is refused on
# this Mac before a Windows leg is asked (defect 602).
function windows_refuses(name: str) -> str
    start: i64 @= 0
    at: i64 @= 0

    while at <= name.len()
        if at == name.len() || name[at] == '\\'
            why = part_refused(name.slice(from: start, to: at))

            if why.len() > 0
                return "`" + name + "`: " + why
            start @ at + 1

        at @ at + 1

    return ""

# One part of a Windows path, by the rules above.
function part_refused(part: str) -> str
    for i in range(from: 0, to: part.len())
        b = part[i]

        if b < 32 || b == '<' || b == '>' || b == ':' || b == '"' || b == '/' || b == '|' || b == '?' || b == '*'
            return "byte " + b.to_str() + " is reserved in a Windows name"

    if part.len() > 0 && (part[part.len() - 1] == ' ' || part[part.len() - 1] == '.')
        return "a Windows name does not end in a space or a dot"
    stem: i64 @= 0

    while stem < part.len() && part[stem] != '.'
        stem @ stem + 1

    for device in devices()
        if same_letters(name: part.slice(from: 0, to: stem), as: device)
            return "`" + device + "` is a device's name on Windows"

    return ""

# The names Windows keeps for its devices, the superscripts `¹ ² ³` read as
# digits after `COM` and `LPT`.
function devices() -> [str]
    out: [str] @= ["CON", "PRN", "AUX", "NUL"]
    digits: [str] @= []

    for d in range(from: 1, to: 10)
        digits @ digits.push(d.to_str())

    for last in [185, 178, 179]
        two: [u8] = [194, last.to_u8().must()]
        digits @ digits.push(two.validated_bytes().must())

    for digit in digits
        out @ strings.with_all(list: out, more: ["COM" + digit, "LPT" + digit])

    return out

# Two names the same but for the case of their ASCII letters, as Windows
# compares a device's.
function same_letters(name: str, as: str) -> bool
    if name.len() != as.len()
        return false

    for i in range(from: 0, to: name.len())
        if folded(name[i]) != folded(as[i])
            return false

    return true

function folded(b: u8) -> u8
    if b >= 'a' && b <= 'z'
        return b - 32
    return b

test "Windows is handed no name a Windows file may not have, and POSIX every byte Windows refuses (defect 602)"
    refused: [str] @= []

    for name in hard_names(windows: true)
        why = windows_refuses(name)

        if why.len() > 0
            refused @ refused.push(why)

    assert refused.join("; ") == ""

    for name in ["<CFGDIR>x.o", "quo\"te.o", "colon:x.o", "pipe|ask?.o", "star*.o", "tab\tx.o", "line\nend.o", "trail.", "trail ", "nul.o", "Com1", "LPT9.tar.gz", "a\\con"]
        assert windows_refuses(name) != ""

    for name in ["sub\\inner.o", "console.o", "com10.o", "lpt.o", ".hidden", "a.b.o"]
        assert windows_refuses(name) == ""

    superscript: [u8] = [76, 80, 84, 194, 185, 46, 111]
    assert windows_refuses(superscript.validated_bytes().must()) != ""

# What a run that failed said, or "" for one that did not: a failure is
# asserted by its words, so a red names what clang refused.
function failure_of(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

test "every hard name an object can have is read back from the file as written, and linked (defect 583)"
    root = "build/selftest-response-names"
    assert !process.remove_tree(root).is_err()
    assert !process.mkdir_all(root + "/sub").is_err()
    windows = process.exe_suffix() == ".exe"
    names = hard_names(windows)
    one = root + "/one.c"
    assert !publish.write_whole(path: one, text: "int NAME(void) { return 1; }\n", keyed: false).is_err()
    line: [str] @= ["clang"]
    calls: [str] @= []
    declared: [str] @= []

    # Every name is tried before one is asserted, and the assertion shows each
    # that failed, so one red says every name a platform refused (defect 602).
    unmade: [str] @= []

    for i in range(from: 0, to: names.len())
        object = root + "/" + names[i]
        made = process.run(
            program: "clang",
            words: ["clang", "-DNAME=f" + i.to_str(), "-c", one, "-o", object],
            out: process.discard(),
            err: process.discard()
        )

        if !made.started || made.code != 0
            unmade @ unmade.push(names[i])
        line @ line.push(object)
        calls @ calls.push("f" + i.to_str() + "()")
        declared @ declared.push("int f" + i.to_str() + "(void);\n")

    assert unmade.join(" | ") == ""
    main_c = root + "/main.c"
    main_text = declared.join("") + "int main(void) { return " + calls.join(" + ") + " == " + names.len().to_str() + " ? 0 : 1; }\n"
    assert !publish.write_whole(path: main_c, text: main_text, keyed: false).is_err()
    main_o = root + "/main.o"
    assert process.run(program: "clang", words: ["clang", "-c", main_c, "-o", main_o], out: process.discard(), err: process.discard()).code == 0
    line @ line.push(main_o)
    binary = root + "/hard" + process.exe_suffix()
    run = strings.with_all(list: through(line: line, at: root + "/hard.rsp", keyed: false).must(), more: ["-o", binary])
    said = root + "/said.txt"

    # The linker's own words, which name an object it could not find.
    assert failure_of(toolchain.run_clang(line: run, what: "linking", err_path: said)) == ""
    assert read_file(said).must() == ""
    ran = process.run(program: binary, words: [binary], out: process.discard(), err: process.discard())
    assert ran.started && ran.code == 0
    assert !process.remove_tree(root).is_err()
