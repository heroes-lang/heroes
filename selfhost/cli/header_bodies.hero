# What the functions a header list defines name in their bodies, as clang's
# `-ast-dump` writes them (design.md §4.19; defect 2372, 2026-11-09).
# `cli/header_needs.hero` asks it where a link found no definition of a name
# the program's own object refers to: the body of a function a group's
# header defines is compiled into every unit that calls it, so each name
# that body calls or reads is the program's to link.
#
# **A reference is read off its `DeclRefExpr` row**, at any depth under the
# top-level `FunctionDecl` whose body holds it: `Function 0x… 'name'` for a
# function, `Var 0x… 'name'` for an object, as this Mac's clang 21 and the
# Linux image's clang 22 write them. An object is counted only where the
# declaration it names has linkage, a top-level `VarDecl` or one inside a
# body marked `extern`, so a local that shares an external's name is no
# reference to it; C declares a name before its use, so the declaration's
# row is always read before the reference's. A body's references are read
# after the preprocessor, so a macro the body expands is read as what it
# expands to.
#
# **Each location is read in the dump's order** (`label_dump.located`),
# since clang prints one relative to the last printed, a macro's spelling
# among them; a function's place is its name's, the last location of its
# row.

use cli/dump_tops
use cli/label_dump

# A function the dump defines with a body: its name, where clang places it,
# whether it is written `inline`, and each function it calls and each object
# with linkage it reads, once, in the order the body names them.
record Body
    name: str
    file: str
    line: i64
    inline: bool
    calls: [str]
    reads: [str]

# Every top-level function the dump defines with a body, in its order.
function of_dump(dumped: str) -> [Body]
    found: [Body] @= []
    bodied: [bool] @= []
    linked: {str: bool} @= {}
    place: label_dump.Located @= label_dump.Located(file: "", line: 0)
    current: i64 @= -1
    start: i64 @= 0
    at: i64 @= 0

    while at <= dumped.len()
        if at == dumped.len() || dumped[at] == 10
            row = dumped.slice(from: start, to: at)
            place @ label_dump.located(row, at: place)

            if is_top(row)
                current @ -1
                top = dump_tops.top_of(row)

                if top.kind == "VarDecl"
                    linked[id_after(row, from: 2)] @ true

                if top.kind == "FunctionDecl" && !top.implicit && top.name.len() > 0
                    found @ found.push(
                        Body(name: top.name, file: place.file, line: place.line, inline: dump_tops.holds(top.flags, word: "inline"), calls: [], reads: [])
                    )
                    bodied @ bodied.push(false)
                    current @ found.len() - 1
            else if current >= 0
                if dump_tops.child(row) && dump_tops.found_at(text: row, needle: "-CompoundStmt ") == 3
                    bodied[current] @ true
                declared = dump_tops.found_at(text: row, needle: "-VarDecl 0x")

                if declared >= 0 && dump_tops.holds(dump_tops.top_of("|" + row.slice(from: declared, to: row.len())).flags, word: "extern")
                    linked[id_after(row, from: declared + 1)] @ true

                if dump_tops.found_at(text: row, needle: "-DeclRefExpr ") >= 0
                    called = referred(row: row, marker: " Function 0x")

                    if !called.is_err()
                        found[current].calls @ once(found[current].calls, name: called.must().name)
                    read = referred(row: row, marker: " Var 0x")

                    if !read.is_err() && !linked[read.must().id].is_err()
                        found[current].reads @ once(found[current].reads, name: read.must().name)
            start @ at + 1
        at @ at + 1

    out: [Body] @= []

    for i in range(from: 0, to: found.len())
        if bodied[i]
            out @ out.push(found[i])

    return out

# The first of `bodies` named `name`, absent where none is.
function body_of(bodies: [Body], name: str) -> Body?
    for one in bodies
        if one.name == name
            return ok(one)

    return fail(code: "none", msg: "no body of that name")

# Whether `body` calls or reads `name`.
function refers(body: Body, name: str) -> bool
    for one in body.calls
        if one == name
            return true

    for one in body.reads
        if one == name
            return true

    return false

function is_top(row: str) -> bool
    return row.len() >= 2 && (row[0] == '|' || row[0] == '`') && row[1] == '-'

# A declaration a reference names: its `0x` address and its name.
record Referred
    id: str
    name: str

# What a `DeclRefExpr` row names after `marker`, ` Function 0x` or
# ` Var 0x`: the address, then the name in single quotes.
function referred(row: str, marker: str) -> Referred?
    at = dump_tops.found_at(text: row, needle: marker)

    if at < 0
        return fail(code: "none", msg: "no such reference")
    id = id_after(row, from: at + 1)
    open: i64 @= at + marker.len()

    while open < row.len() && row[open] != ' '
        open @ open + 1

    if open + 1 >= row.len() || row[open + 1] != '\''
        return fail(code: "none", msg: "no quoted name")
    close: i64 @= open + 2

    while close < row.len() && row[close] != '\''
        close @ close + 1

    if close >= row.len()
        return fail(code: "none", msg: "no quoted name")
    return ok(Referred(id: id, name: row.slice(from: open + 2, to: close)))

# The `0x` address after the word that begins at `from`, `""` where none.
function id_after(row: str, from: i64) -> str
    at: i64 @= from

    while at < row.len() && row[at] != ' '
        at @ at + 1

    begin = at + 1

    if begin + 2 > row.len() || row[begin] != '0' || row[begin + 1] != 'x'
        return ""
    end: i64 @= begin

    while end < row.len() && row[end] != ' '
        end @ end + 1

    return row.slice(from: begin, to: end)

function once(names: [str], name: str) -> [str]
    for one in names
        if one == name
            return names

    return names.push(name)

## Tests

# The dump of a header of each shape, as this Mac's clang 21 wrote it on
# 2026-11-09: an inline function calling a function and reading an object
# through a macro and through a block's `extern`, a local sharing an
# external's name, a function defined without `inline`, a prototype, and a
# function of an included file.
test "a header's bodies are read with what they call and the objects with linkage they read (defect 2372)"
    rows: [str] = [
        "TranslationUnitDecl 0x1 <<invalid sloc>> <invalid sloc>"
        "|-FunctionDecl 0x2 <./inner.h:1:1, col:18> col:5 used base_two 'int (void)'"
        "|-FunctionDecl 0x3 <line:2:1, col:54> col:19 used mid 'int (void)' static inline"
        "| `-CompoundStmt 0x4 <col:29, col:54>"
        "|   `-ReturnStmt 0x5 <col:31, col:51>"
        "|     `-CallExpr 0x6 <col:38, col:47> 'int'"
        "|       `-ImplicitCastExpr 0x7 <col:38> 'int (*)(void)' <FunctionToPointerDecay>"
        "|         `-DeclRefExpr 0x8 <col:38> 'int (void)' Function 0x2 'base_two' 'int (void)'"
        "|-VarDecl 0x9 <./shapes.h:2:1, col:12> col:12 used base_count 'int' extern"
        "|-FunctionDecl 0xa <line:3:1, col:21> col:5 used base_helper 'int (void)'"
        "|-FunctionDecl 0xb <line:5:1, line:9:1> line:5:19 top_fast 'int (void)' static inline"
        "| `-CompoundStmt 0xc <col:34, line:9:1>"
        "|   |-DeclStmt 0xd <line:6:5, col:24>"
        "|   | `-VarDecl 0xe <col:5, col:23> col:9 used base_count2 'int' cinit"
        "|   |-DeclStmt 0xf <line:7:5, col:25>"
        "|   | `-VarDecl 0x10 parent 0x1 <col:5, col:16> col:16 used base_deep 'int' extern"
        "|   `-ReturnStmt 0x11 <line:8:5, col:54>"
        "|     `-BinaryOperator 0x12 <line:4:16, line:8:54> 'int' '+'"
        "|       |-DeclRefExpr 0x13 <col:16> 'int (void)' Function 0xa 'base_helper' 'int (void)'"
        "|       |-DeclRefExpr 0x14 <line:8:21> 'int' lvalue Var 0x9 'base_count' 'int'"
        "|       |-DeclRefExpr 0x15 <col:34> 'int' lvalue Var 0x10 'base_deep' 'int'"
        "|       |-DeclRefExpr 0x16 <col:46> 'int (void)' Function 0x3 'mid' 'int (void)'"
        "|       `-DeclRefExpr 0x17 <col:54> 'int' lvalue Var 0xe 'base_count2' 'int'"
        "|-FunctionDecl 0x18 <line:10:1, col:66> col:12 shadow 'int (void)' static"
        "| `-CompoundStmt 0x19 <col:25, col:66>"
        "|   |-DeclStmt 0x1a <col:27, col:45>"
        "|   | `-VarDecl 0x1b <col:27, col:44> col:31 used base_count 'int' cinit"
        "|   `-DeclRefExpr 0x1c <col:54> 'int' lvalue Var 0x1b 'base_count' 'int'"
        "`-FunctionDecl 0x1d <line:11:1, col:47> col:5 defined_out 'int (void)'"
        "  `-CompoundStmt 0x1e <col:23, col:47>"
        "    `-DeclRefExpr 0x1f <col:32> 'int (void)' Function 0xa 'base_helper' 'int (void)'"
    ]
    got = of_dump(rows.join("\n") + "\n")
    assert got.len() == 4
    assert got[0].name == "mid" && got[0].file == "./inner.h" && got[0].line == 2 && got[0].inline
    assert got[0].calls == ["base_two"] && got[0].reads.len() == 0
    assert got[1].name == "top_fast" && got[1].file == "./shapes.h" && got[1].line == 5
    assert got[1].calls == ["base_helper", "mid"]
    assert got[1].reads == ["base_count", "base_deep"]
    assert got[2].name == "shadow" && !got[2].inline && got[2].reads.len() == 0
    assert got[3].name == "defined_out" && got[3].line == 11 && got[3].calls == ["base_helper"]
    assert refers(got[1], name: "base_deep") && !refers(got[1], name: "base_count2")
    assert body_of(got, name: "base_helper").is_err()
    assert body_of(got, name: "mid").must().line == 2
    assert referred(row: "| `-DeclRefExpr 0x8 <col:38> 'int' Function 0x2", marker: " Function 0x").is_err()
    assert id_after("|-VarDecl", from: 2) == ""
