# Where a byte of the probe's preprocessed text stands in the file it came
# from (panel 218's R1, provisional 2026-10-17; defect 2109; design.md
# §4.19): the last line marker `clang -E` wrote above it, read by
# `cli/bound_said.hero`'s reader of them, never from clang's dump, whose
# `line` and `presumedFile` are written only where they change.

use cli/bound_said

record Place
    file: str
    line: i64

# The last line marker before byte `at`, `# <line> "<file>"`, naming the line
# after it, plus the lines between.
function presumed(text: str, at: i64) -> Place?
    start: i64 @= at
    below: i64 @= 0

    while start > 0 && text[start - 1] != '\n'
        start @ start - 1

    while start > 0
        above: i64 @= start - 1

        while above > 0 && text[above - 1] != '\n'
            above @ above - 1

        line = text.slice(from: above, to: start - 1)

        if bound_said.marker(line)
            return ok(Place(file: bound_said.marker_file(line), line: bound_said.marker_row(line) + below))
        below @ below + 1
        start @ above

    return fail(code: "none", msg: "no line marker before it")

## Tests

test "a byte's place is read from the line marker above it, a Windows path's backslash read as one"
    text = "# 1 \"main.c\"\nint a;\n# 2 \"./f.h\" 1\nenum { EA = 1 << 31 };\n\nenum { EB = 2 };\n"
    place = presumed(text, at: 66).must()
    assert place.file == "./f.h"
    assert place.line == 4
    assert presumed("enum { X };\n", at: 3).is_err()
    windows = presumed("# 7 \"C:\\\\h\\\\f.h\" 1\nenum { EB = 2 };\n", at: 26).must()
    assert windows.file == "C:\\h\\f.h"
    assert windows.line == 7
