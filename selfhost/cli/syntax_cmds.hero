# heroes parse and heroes fmt — the two commands whose whole input is
# the tree (design.md §3.5, §4.15). Port of
# heroes-cli/src/commands/{parse,fmt}.rs in the Rust bootstrap at `m-bootstrap-archive`, one module because
# each is a page and they share the refusal that matters.
#
# BOTH REFUSE A FILE WITH DIAGNOSTICS before doing their work: a tree
# built out of recovery guesses reads like a fact and is not one, and
# a formatter that proceeds rewrites the author's program into the
# parser's guess about it — the one thing a formatter must never do.

use cli/argv
use cli/io
use cli/placed_files
use cli/process
use cli/publish
use cli/strings
use cli/table as cli_table
use diag
use parse
use print/dump
use print/fmt
use print/guard
use source
use source_extent

# heroes parse <file.hero> [--dump-ast]: without the flag a syntax
# check, silent on success; with it the tree — but only when the file
# is clean.
function run_parse(s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    out = parse.parse_source(s)

    for d in out.diagnostics
        io.eprint(text: diag.render_line(d, s))

    if out.diagnostics.len() > 0
        return .diagnostics_exit

    if argv.has(inv, spelling: "--dump-ast")
        io.print_artifact(text: dump.shown_ast(out.tree, s, out.uses, out.decls))
    return .ok_exit

# heroes fmt <file.hero> [--in-place]: stdout by default like gofmt;
# --in-place rewrites the file and prints nothing — and an
# already-canonical file is NOT rewritten, so its mtime does not move.
# What `fmt` makes of the file, and the guard's word on it, is
# `print/guard.hero`'s `checked`, which `heroes probe` asks of every
# variant it makes (panel 179).
function run_fmt(path: str, s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    done = guard.checked(path: path, s: s)

    if done.input.diagnostics.len() > 0
        for d in done.input.diagnostics
            io.eprint(text: diag.render_line(d, s))

        io.eprint(text: "error: refusing to format a file with diagnostics")
        return .diagnostics_exit

    if !done.refusal.is_err()
        io.eprint(text: "error: " + done.refusal.must())
        io.eprint(text: "error: this is a compiler bug — `" + path + "` was NOT changed")
        return .failed_exit
    formatted = done.formatted

    if !argv.has(inv, spelling: "--in-place")
        io.print_artifact(text: formatted)
        return .ok_exit

    if formatted == source_extent.user_text(s)
        return .ok_exit

    # A placed package's file is written by no `--in-place` (defect 2457,
    # `cli/placed_files`): the build holds its tree to its `sum`.
    if placed_files.within(path)
        io.eprint(text: "error: " + placed_files.refused(path))
        return .failed_exit

    # Whole or not at all, and the file stays what it was but its bytes
    # (`cli/publish.hero`, defect 136): this was `write_file` on the author's
    # own path, which emptied it first, so a full disk left 0 bytes.
    written = publish.rewrite(path: path, text: formatted)

    if written.is_err()
        io.eprint(text: "error: " + publish.message_of(written))
        return .failed_exit
    return .ok_exit

## Tests

test "parse checks silently, dumps only a clean tree, and fmt round-trips"
    text = "function main()\n    print(2 + (3 * 4))\n"
    s = source.new_source(name: "t.hero", text: text)
    inv = argv.Invocation(tag: .parse_cmd, file: ok("t.hero"), program_args: [], flags: [])
    assert run_parse(s, inv) == .ok_exit

    # A broken file exits 1 through the same door.
    bad = source.new_source(name: "t.hero", text: "function main(\n    print(1)\n")
    assert run_parse(bad, inv) == .diagnostics_exit

    # fmt to a real file: --in-place canonicalises once, then leaves
    # the canonical file alone.
    messy = "function main()\n    print(2 + (3 * 4))\n"
    assert !write_file(path: "build/selftest_fmt.hero", text: messy).is_err()
    fs = source.new_source(name: "build/selftest_fmt.hero", text: messy)
    in_place: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    finv = argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt.hero"), program_args: [], flags: in_place)
    assert run_fmt(path: "build/selftest_fmt.hero", s: fs, inv: finv) == .ok_exit
    canon = read_file("build/selftest_fmt.hero").must()
    assert canon == "function main()\n    print(2 + 3 * 4)\n"

    # And the refusal: a file with diagnostics is not touched.
    assert !write_file(path: "build/selftest_fmt.hero", text: "function main(\n").is_err()
    bs = source.new_source(name: "build/selftest_fmt.hero", text: "function main(\n")
    assert run_fmt(path: "build/selftest_fmt.hero", s: bs, inv: finv) == .diagnostics_exit
    assert read_file("build/selftest_fmt.hero").must() == "function main(\n"

# Defect 2457: `fmt --in-place` writes no file of a placed package's tree,
# which the build holds to its `sum`, and refuses saying so; the same text
# in a folder whose name only holds the word is the author's, and written.
test "fmt --in-place leaves a placed package's file as it was placed, and formats the author's (defect 2457)"
    messy = "function main()\n    print(2 + (3 * 4))\n"
    in_place: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    placed = "build/selftest-fmt-placed/heroes.packages/json@1.0.0-0123456789abcdef/m.hero"
    mine = "build/selftest-fmt-placed/my.heroes.packages/m.hero"

    for path in [placed, mine]
        assert !process.mkdir_all(path.slice(from: 0, to: path.len() - 7)).is_err()
        assert !write_file(path: path, text: messy).is_err()

    pinv = argv.Invocation(tag: .fmt_cmd, file: ok(placed), program_args: [], flags: in_place)
    assert run_fmt(path: placed, s: source.new_source(name: placed, text: messy), inv: pinv) == .failed_exit
    assert read_file(placed).must() == messy
    minv = argv.Invocation(tag: .fmt_cmd, file: ok(mine), program_args: [], flags: in_place)
    assert run_fmt(path: mine, s: source.new_source(name: mine, text: messy), inv: minv) == .ok_exit
    assert read_file(mine).must() == "function main()\n    print(2 + 3 * 4)\n"
    assert !process.remove_tree("build/selftest-fmt-placed").is_err()

# §9: a verifier check gets a test that makes it FIRE, and this one
# fires on a shape the printer still cannot spell — a `match` as the
# LEFT operand with the expression continuing after its block. That
# program is legal Heroes (`heroes check` exits 0 on it), so this is the
# printer's hole and not the author's mistake. Before the guard, `fmt`
# wrote the header alone at exit 0 and destroyed the file. When the
# printer learns the shape, the expectation here becomes `.ok_exit` and
# the guard keeps its job over everything else.
# §9, and it is the case the other two guards cannot make fire. SYMPTOM:
# `heroes fmt` deleted the blank line under a remark inside a `record`,
# and `--dump-ast` showed a `doc` appear on the field below it — an
# ordinary remark promoted to that field's DOCUMENTATION, which the
# compiler reuses in `???` output, error messages and `outline`. CAUSE:
# design.md §4.1 makes that blank line the discriminator
# (`selfhost/cursor.hero:194-220`, `take_docs`, where `above != wanted`
# ends the run) and `comments_before` did not know it. DATE: 2026-08-26,
# found by panel 095's compiler-engineer.
#
# The point of the case is what it proves about the OTHER guards: this
# output PARSES and IS a fixpoint. Only the tree comparison sees it.
test "the tree check fires on output that parses and is a fixpoint and means something else"
    # THE GUARD IS TESTED AS A PREDICATE, not through `run_fmt`, and the
    # reason is worth writing down. This case used to hand `fmt` a
    # `record` with a remark in it and assert the REFUSAL, because
    # `comments_before` deleted the blank line below the comment and §4.1
    # makes that blank the difference between a remark and the next
    # field's documentation. That defect is fixed (`/decide` answer `4a`,
    # `fmt.hero`'s `field_line`), so the shape no longer trips the
    # guard — and a firing test that depends on a live defect stops firing
    # the day the defect is repaired, which is the day it stops being a
    # test (§9 asks for a check that FIRES, permanently).
    #
    # So the pair is built by hand: the same program with the blank line
    # and without it. Both parse, both are fixpoints, and their trees
    # differ by one `doc` — which is exactly what the third check exists
    # to see and what the first two cannot.
    remark = "record Point\n    x: i64\n    # a remark, not documentation for y\n\n    y: i64\n"
    squashed = "record Point\n    x: i64\n    # a remark, not documentation for y\n    y: i64\n"
    caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: remark, formatted: squashed)
    assert !caught.is_err()

    # The two weaker properties really do hold on that output, which is
    # what makes this case the only kind the third check can catch.
    reparsed = parse.parse(squashed)
    assert reparsed.diagnostics.len() == 0
    ss = source.new_source(name: "t.hero", text: squashed)
    assert fmt.format_file(reparsed.tree, ss, reparsed.comments, reparsed.uses, reparsed.decls) == squashed

    # And it does NOT fire when the tree is the same: the formatter is
    # allowed to change text, only not meaning. `0xFF` -> `0xff` is the
    # one literal rewrite `fmt` makes, and `bodies.hero`'s
    # `canonical_int` is why both dump identically.
    upper = "constant MASK: i64\n    0xFF\n"
    lower = "constant MASK: i64\n    0xff\n"
    quiet = guard.refuse_output_the_formatter_broke(path: "t.hero", original: upper, formatted: lower)
    assert quiet.is_err()

    # And the real command formats that record now instead of refusing it.
    assert !write_file(path: "build/selftest_fmt_tree.hero", text: remark).is_err()
    rs = source.new_source(name: "build/selftest_fmt_tree.hero", text: remark)
    marks: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    rinv = argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt_tree.hero"), program_args: [], flags: marks)
    assert run_fmt(path: "build/selftest_fmt_tree.hero", s: rs, inv: rinv) == .ok_exit
    assert read_file("build/selftest_fmt_tree.hero").must() == remark

test "the parse and fixpoint checks fire, and the input's own errors are not blamed on the compiler"
    # A PREDICATE TEST, for the same reason as the one above. This case
    # used to hand `fmt` a `match` as the LEFT operand with the expression
    # continuing after its block — a form the printer could not spell —
    # and assert exit 2. `/decide` answer `5a` settled which artifact was
    # wrong: panel 007's Amendment B and design.md:1794 both say a long
    # expression is broken inside brackets or not at all, so the PARSER
    # was accepting a continuation the language does not have, and
    # `grammar_expr.hero`'s `ends_the_expression` now refuses it. The
    # printer owed nothing all along.
    #
    # So the two checks get hand-built inputs instead of a live defect.
    good = "function f() -> i64\n    return 1\n"
    torn = "function f() -> i64\n    return\n        1 +\n"
    broken = guard.refuse_output_the_formatter_broke(path: "t.hero", original: good, formatted: torn)
    assert !broken.is_err()

    # Not a fixpoint: text that parses, and that `fmt` would print
    # differently — the parentheses come off.
    parens = "function f() -> i64\n    return (1 + 2)\n"
    unstable = guard.refuse_output_the_formatter_broke(path: "t.hero", original: good, formatted: parens)
    assert !unstable.is_err()

    # And the honest attribution, which is what `5a` bought: the file the
    # PARSER refuses is exit 1 with the diagnostic on the author's line,
    # not exit 2 with the compiler accusing itself.
    refused_input = "function f(c: str) -> str\n    return match c\n        \"a\" => \"b\"\n        _ => c\n    + \"x\"\n"
    assert !write_file(path: "build/selftest_fmt_guard.hero", text: refused_input).is_err()
    gs = source.new_source(name: "build/selftest_fmt_guard.hero", text: refused_input)
    hits: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    ginv = argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt_guard.hero"), program_args: [], flags: hits)
    assert run_fmt(path: "build/selftest_fmt_guard.hero", s: gs, inv: ginv) == .diagnostics_exit

    # The whole point either way: the author's file is byte-for-byte
    # untouched.
    assert read_file("build/selftest_fmt_guard.hero").must() == refused_input

test "the tree guard sees an alias, and it was blind to one for a day"
    # **THE GUARD WAS BLIND IN EXACTLY THE PLACE OF THE BUG** (2026-09-02).
    # `fmt` dropped `as near_scale` when it printed a `use` line, and this
    # guard compares the two trees by DUMPING them — with `print_dump`, which
    # dropped the alias too. Both renderings therefore agreed and the guard
    # reported *"the same tree"* while the formatter was deleting a word.
    #
    # One omission, two consumers, and the second is the instrument watching
    # the first: a self-check that compares two RENDERINGS can only see what
    # the renderer carries. That is the general shape, and it is why
    # CLAUDE.md §9's rule about a new form reaching every tool names the
    # printers explicitly.
    #
    # This test hands the guard the exact pair the defect produced — the
    # original with the alias, the "formatted" output without it — and asserts
    # it REFUSES. It fails the day the dump stops carrying the alias, which is
    # the day the guard would go blind again.
    original = "use render/scale as near_scale\n\nfunction main()\n    print(0)\n"
    stripped = "use render/scale\n\nfunction main()\n    print(0)\n"
    caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: stripped)
    assert !caught.is_err()
    assert strings.holds(text: caught.must(), needle: "changed the TREE")

    # And it stays quiet on the real thing: the formatter's own output for a
    # file that already carries an alias.
    parsed = parse.parse(original)
    s = source.new_source(name: "t.hero", text: original)
    formatted = fmt.format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
    assert formatted == original
    quiet = guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: formatted)
    assert quiet.is_err()

test "the tree guard sees `owned`, and this is the alias test's own lesson applied before the fact"
    # **The same shape as the alias above, pinned BEFORE it could ship.** On
    # 2026-09-06, with `owned <freer>` parsing correctly, `heroes fmt` printed
    # `function strdup(s: cstr) -> cstr` — the mark silently deleted — and
    # `--dump-ast` dropped it too. Both renderings would have agreed, so this
    # guard would have reported *"the same tree"* while `fmt --in-place` wrote
    # a program whose C-allocated string is never freed, at exit 0, with
    # nothing on either stream.
    #
    # For this form a dropped word is not a lost word, it is a LEAK: measured
    # the day it landed, the same program with and without the mark differs by
    # **12.8 MB** of peak resident size over 200,000 strings.
    #
    # The pair below is the one the defect produced. It fails the day the dump
    # stops carrying `owned`, which is the day the guard goes blind again.
    original = "extern \"stdlib.h\"\n    function free(p: ptr)\n\nextern \"string.h\"\n    function strdup(s: cstr) -> cstr owned free\n\nfunction main()\n    print(0)\n"
    stripped = "extern \"stdlib.h\"\n    function free(p: ptr)\n\nextern \"string.h\"\n    function strdup(s: cstr) -> cstr\n\nfunction main()\n    print(0)\n"
    caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: stripped)
    assert !caught.is_err()
    assert strings.holds(text: caught.must(), needle: "changed the TREE")

    # The `@` position too, because the mark rides two places and a guard that
    # sees one of them is the same blindness one position over.
    at_original = "extern \"x.h\"\n    function run(@e: cstr owned drop) -> i32\n    function drop(p: ptr)\n\nfunction main()\n    print(0)\n"
    at_stripped = "extern \"x.h\"\n    function run(@e: cstr) -> i32\n    function drop(p: ptr)\n\nfunction main()\n    print(0)\n"
    at_caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: at_original, formatted: at_stripped)
    assert !at_caught.is_err()

    # And it stays quiet on the real thing, in both positions.
    for text in [original, at_original]
        parsed = parse.parse(text)
        s = source.new_source(name: "t.hero", text: text)
        formatted = fmt.format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
        assert formatted == text
        quiet = guard.refuse_output_the_formatter_broke(path: "t.hero", original: text, formatted: formatted)
        assert quiet.is_err()

# Panel 235's mark, pinned before it could ship as `as` shipped: a printer
# that wrote the path and not the `<json>/` before it would make a package's
# module the program's own, the change the bracket exists to refuse, and the
# dump carries the mark (`dump.hero`), so the guard sees the two trees apart.
test "the tree guard sees a package's mark taken off"
    original = "use <json>/parse\n\nfunction main()\n    print(0)\n"
    stripped = "use parse\n\nfunction main()\n    print(0)\n"
    caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: stripped)
    assert !caught.is_err()
    assert strings.holds(text: caught.must(), needle: "changed the TREE")
    parsed = parse.parse(original)
    s = source.new_source(name: "t.hero", text: original)
    formatted = fmt.format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
    assert formatted == original
    assert guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: formatted).is_err()

# Defect 101's last silent move, and the guard that makes the class loud
# whatever printer moves one: the trunk's `fmt` joined a signature with a
# comment on its `(` line and moved the comment to the joined line's end, at
# exit 0, and neither the tree nor the second pass could see it. The pair
# below is that move; the anchors of the two files differ, so the guard
# refuses it. A PREDICATE TEST, as the tree check's is: the real printer no
# longer makes the move, which the second half measures.
test "a comment moved off the code it was written beside is refused, whichever printer moved it"
    original = "function f(a: i64,  # about a\n    b: i64) -> i64\n    return a + b\n"
    moved = "function f(a: i64, b: i64) -> i64  # about a\n    return a + b\n"
    caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: original, formatted: moved)
    assert !caught.is_err()
    assert strings.holds(text: caught.must(), needle: "would move the comment on line 1")

    # Off the line it trails, with nothing crossed: an opener's comment
    # printed as its block's first line.
    trailed = "function f(n: i64)\n    if n > 0  # the positive case\n        print(n)\n"
    dropped = "function f(n: i64)\n    if n > 0\n        # the positive case\n        print(n)\n"
    assert !guard.refuse_output_the_formatter_broke(path: "t.hero", original: trailed, formatted: dropped).is_err()

    # And the real printer keeps both, which the guard passes.
    for text in [original, trailed]
        parsed = parse.parse(text)
        s = source.new_source(name: "t.hero", text: text)
        formatted = fmt.format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
        assert guard.refuse_output_the_formatter_broke(path: "t.hero", original: text, formatted: formatted).is_err()

    assert !write_file(path: "build/selftest_fmt_moved.hero", text: original).is_err()
    ls = source.new_source(name: "build/selftest_fmt_moved.hero", text: original)
    hits: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    linv = argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt_moved.hero"), program_args: [], flags: hits)
    assert run_fmt(path: "build/selftest_fmt_moved.hero", s: ls, inv: linv) == .ok_exit
    kept = "function f(\n            a: i64,  # about a\n            b: i64\n        ) -> i64\n    return a + b\n"
    assert read_file("build/selftest_fmt_moved.hero").must() == kept

# Panel 238: `fmt` writes a file's `use` lines as one block in one order, the
# reorder a pass over the text before the printer, and the guard judges the
# two steps apart. PREDICATE TESTS, as the tree check's is, one per step. The
# printer's side is the pair: a block out of order, or the two groups with no
# blank line between them (what a stage 2 from before the sitting writes), is
# not a fixpoint of `fmt`, since the second pass would order it, and the same
# block in order passes. The reorder's side is its own judge, which fires on a
# pass that lost a line, on one that made a remark a declaration's doc and on
# one whose text does not parse, and passes the pass `fmt` makes.
test "a block out of order is refused, the same block in order passes, and the reorder has its own judge"
    in_order = "use <core>/strings\n\nuse alpha\nuse zeta\n\nfunction main()\n    print(alpha.one() + zeta.two())\n"
    printed_wrong = [
        "use zeta\nuse alpha\nuse <core>/strings\n\nfunction main()\n    print(alpha.one() + zeta.two())\n"
        "use <core>/strings\nuse alpha\nuse zeta\n\nfunction main()\n    print(alpha.one() + zeta.two())\n"
    ]

    for out_of_order in printed_wrong
        caught = guard.refuse_output_the_formatter_broke(path: "t.hero", original: in_order, formatted: out_of_order)
        assert !caught.is_err()
        assert strings.holds(text: caught.must(), needle: "not a fixpoint")

    assert guard.refuse_output_the_formatter_broke(path: "t.hero", original: in_order, formatted: in_order).is_err()

    text = "use zeta\n# a remark\n\nuse alpha\n\nfunction main()\n    print(1)\n"
    lost = "use alpha\nuse zeta\n\nfunction main()\n    print(1)\n"
    lost_said = guard.reorder_refused(path: "t.hero", text: text, order: lost, order_parse: parse.parse(lost))
    assert strings.holds(text: lost_said.must(), needle: "lost or added a line")
    made_doc = "use alpha\nuse zeta\n\n# a remark\nfunction main()\n    print(1)\n"
    doc_said = guard.reorder_refused(path: "t.hero", text: text, order: made_doc, order_parse: parse.parse(made_doc))
    assert strings.holds(text: doc_said.must(), needle: "changed the TREE")
    torn = "use alpha\nuse zeta\n# a remark\n\nfunction main(\n    print(1)\n"
    torn_said = guard.reorder_refused(path: "t.hero", text: text, order: torn, order_parse: parse.parse(torn))
    assert strings.holds(text: torn_said.must(), needle: "does not parse")
    done = guard.checked(path: "t.hero", s: source.new_source(name: "t.hero", text: text))
    assert done.ordered == "# a remark\n\nuse alpha\nuse zeta\n\nfunction main()\n    print(1)\n"
    assert guard.reorder_refused(
        path: "t.hero",
        text: text,
        order: done.ordered,
        order_parse: done.ordered_input
    ).is_err()
    assert done.refusal.is_err()

    # And the real command writes the block in its order once, then leaves
    # the file alone.
    assert !write_file(path: "build/selftest_fmt_uses.hero", text: text).is_err()
    us = source.new_source(name: "build/selftest_fmt_uses.hero", text: text)
    hits: [argv.FlagHit] = [argv.FlagHit(spelling: "--in-place", value: fail(code: "none", msg: "no value"))]
    uinv = argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt_uses.hero"), program_args: [], flags: hits)
    assert run_fmt(path: "build/selftest_fmt_uses.hero", s: us, inv: uinv) == .ok_exit
    assert read_file("build/selftest_fmt_uses.hero").must() == done.ordered
    again = source.new_source(name: "build/selftest_fmt_uses.hero", text: done.ordered)
    assert run_fmt(path: "build/selftest_fmt_uses.hero", s: again, inv: uinv) == .ok_exit
    assert read_file("build/selftest_fmt_uses.hero").must() == done.ordered

## The `use` block in its one order (panel 238)

# What `fmt` writes of `text`, every check of the guard holding.
function written_by_fmt(text: str) -> str
    done = guard.checked(path: "t.hero", s: source.new_source(name: "t.hero", text: text))
    assert done.input.diagnostics.len() == 0
    assert done.refusal.is_err()
    return done.formatted

# The shapes beside the rule, depth one, measured at the sitting (the
# compiler-engineer's item 7 and its glued header, the spec-warden's eight
# comment shapes): each written as `fmt` writes it, and that text a fixpoint.
# Every expectation is the rule read off its text: a glued run travels with
# its line, a remark rises above the block, the file's header stays on top, a
# late line joins the block and leaves a blank behind, and no doc moves.
test "the shapes beside the rule are written by it, and each is a fixpoint"
    main = "\nfunction main()\n    print(zeta.two() + alpha.one())\n"
    holed = "\nfunction main()\n    x: i64 = ???\n    print(x + zeta.two() + alpha.one())\n"
    helper = "function helper() -> i64\n    return 0\n"
    given = [
        "use zeta\nuse alpha\n"
        "use zeta  # the last letter\nuse alpha  # the first\n" + main
        "use zeta as a_first\nuse alpha as z_last\n\nfunction main()\n    print(a_first.two() + z_last.one())\n"
        "use zeta\n\n# the package group, written second\nuse <core>/strings\n\nfunction main()\n    print(zeta.two())\n"
        "use zeta\n" + main + "\n# a remark above the late line\nuse alpha\nfunction helper() -> i64\n    return 1\n"
        "use zeta\n" + main + "\n# a remark, then a blank\n\nuse alpha\n# the doc of helper\nfunction helper() -> i64\n    return 1\n"
        "# header\nuse zeta\n# about alpha\nuse alpha\n\nfunction main()\n    print(1)\n"
        "use zeta\n" + holed + "\n# what helper does\nuse alpha\n" + helper
        "use zeta\n" + holed + "\nuse alpha\n# what helper does\n" + helper
        "use zeta\n" + holed + "\n## Tests\n\nuse alpha\n\n# what helper does\n" + helper
        "use zeta\n## The rest\nuse alpha\n\n# what main does" + holed + "\n# what helper does\n" + helper
        "# header\n# why beta\nuse lib/beta\nuse alpha\n\n# what helper does\nfunction helper() -> i64\n    return beta.three()\n\nfunction main()\n    x: i64 = ???\n    print(x + alpha.one())\n"
        "use zeta\nuse alpha\n# what helper does\n" + helper + holed
        "# what helper does\nfunction helper() -> i64\n    return alpha.one()\n\nfunction main()\n    x: i64 = ???\n    print(x)\n\nuse alpha\n"
        "use zeta\n# why alpha\nuse alpha\n\n# what helper does\n" + helper + holed
    ]
    wanted = [
        "use alpha\nuse zeta\n"
        "use alpha  # the first\nuse zeta  # the last letter\n" + main
        "use alpha as z_last\nuse zeta as a_first\n\nfunction main()\n    print(a_first.two() + z_last.one())\n"
        "# the package group, written second\nuse <core>/strings\n\nuse zeta\n\nfunction main()\n    print(zeta.two())\n"
        "# a remark above the late line\nuse alpha\nuse zeta\n" + main + "\nfunction helper() -> i64\n    return 1\n"
        "use alpha\nuse zeta\n" + main + "\n# a remark, then a blank\n\n# the doc of helper\nfunction helper() -> i64\n    return 1\n"
        "# header\n\n# about alpha\nuse alpha\nuse zeta\n\nfunction main()\n    print(1)\n"
        "# what helper does\nuse alpha\nuse zeta\n" + holed + "\n" + helper
        "use alpha\nuse zeta\n" + holed + "\n# what helper does\n" + helper
        "use alpha\nuse zeta\n" + holed + "\n## Tests\n\n# what helper does\n" + helper
        "## The rest\n\nuse alpha\nuse zeta\n\n# what main does" + holed + "\n# what helper does\n" + helper
        "# header\n# why beta\nuse alpha\nuse lib/beta\n\n# what helper does\nfunction helper() -> i64\n    return beta.three()\n\nfunction main()\n    x: i64 = ???\n    print(x + alpha.one())\n"
        "use alpha\nuse zeta\n\n# what helper does\n" + helper + holed
        "use alpha\n\n# what helper does\nfunction helper() -> i64\n    return alpha.one()\n\nfunction main()\n    x: i64 = ???\n    print(x)\n"
        "# why alpha\nuse alpha\nuse zeta\n\n# what helper does\n" + helper + holed
    ]
    assert given.len() == wanted.len()

    for at in range(from: 0, to: given.len())
        assert written_by_fmt(given[at]) == wanted[at]
        assert written_by_fmt(wanted[at]) == wanted[at]

        # And no declaration's documentation moved: the docs `fmt` read are
        # the docs its output holds, in the same order.
        assert docs_of(given[at]) == docs_of(wanted[at])

# Every declaration's doc in `text`, in its order, as the parser reads it.
function docs_of(text: str) -> [str]
    parsed = parse.parse(text)
    out: [str] @= []

    for decl in parsed.decls
        for one in decl.doc
            out @ out.push(text.slice(from: one.start, to: one.end))

    return out

# The orders of `count` things, each a list of the indices 0 to `count - 1`.
function orders(count: i64) -> [[i64]]
    total: i64 @= 1

    for _ in range(from: 0, to: count)
        total @ total * count

    out: [[i64]] @= []

    for code in range(from: 0, to: total)
        picked: [i64] @= []
        seen: [bool] @= []

        for _ in range(from: 0, to: count)
            seen @ seen.push(false)

        left: i64 @= code
        distinct: bool @= true

        for _ in range(from: 0, to: count)
            digit = left % count
            left @ left / count

            if seen[digit]
                distinct @ false
            seen[digit] @ true
            picked @ picked.push(digit)

        if distinct
            out @ out.push(picked)

    return out

# One text per layout, measured at the sitting over 361 files: five lines,
# one with a comment glued above it, in all 120 orders and three layouts (a
# blank line under the header and none between the lines; a blank between
# every two; the header glued to the first line), and one with a line written
# after `main`. The first two layouts and the late one give one text; the
# glued layout two, by whether the commented line is written first, where the
# header and that line's comment are one run, read as the header, the one
# reading the text cannot settle otherwise. Each text is a fixpoint.
test "every order of one set of lines gives one text per layout"
    lines = ["use <core>/strings", "use <core2>/x", "# why beta\nuse lib/beta as b2", "use alpha", "use Zeta"]
    tail = "\n\nfunction main()\n    print(1)\n"
    block = "use <core>/strings\nuse <core2>/x\n\nuse Zeta\nuse alpha\n\n# why beta\nuse lib/beta as b2" + tail
    apart = "# header\n\n" + block
    glued = "# header\n" + block
    read_as_header = "# header\n# why beta\nuse <core>/strings\nuse <core2>/x\n\nuse Zeta\nuse alpha\nuse lib/beta as b2" + tail
    seen: i64 @= 0

    for order in orders(count: 5)
        picked: [str] @= []

        for at in order
            picked @ picked.push(lines[at])

        assert written_by_fmt("# header\n\n" + picked.join("\n") + tail) == apart
        assert written_by_fmt("# header\n\n" + picked.join("\n\n") + tail) == apart

        if order[0] == 2
            assert written_by_fmt("# header\n" + picked.join("\n") + tail) == read_as_header
        else
            assert written_by_fmt("# header\n" + picked.join("\n") + tail) == glued
        seen @ seen + 1

    assert seen == 120
    late = "# header\n\nuse <core>/strings\nuse <core2>/x\n# why beta\nuse lib/beta as b2\nuse Zeta" + tail + "\nuse alpha\n"
    assert written_by_fmt(late) == apart

    for text in [apart, glued, read_as_header]
        assert written_by_fmt(text) == text
