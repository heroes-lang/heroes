# What the generated C is compiled UNDER: the dialect, the diagnostics
# that are errors, what a binary is LINKED with, and what --sanitize
# adds (panels 020, 047, 058).
# Port of archive/bootstrap-rs/heroes-cli/src/commands/flags.rs.
#
# THIS IS THE LIST'S ONLY STATEMENT in the port, exactly as flags.rs
# is the bootstrap's: CLAUDE.md §7 cites it instead of copying it,
# because the copy it used to carry died 3h16m after it was last
# corrected — a count in prose is the premise §11 says expires in
# silence. The reasons ride each flag below; the array is the fact.

# The eighteen — the bootstrap's thirteen in their order but `-g`, then
# panel 103's, then panel 154's, then panel 161's, then panel 199's two, then
# panel 202's; the debug word is the level's since panel 197 (`debug_words`
# below):
# - gnu11 not c11: one predefined macro apart (__STRICT_ANSI__), whose
#   only effect on glibc is to hide M_PI, strdup, fileno and most of
#   what §1.11 says a program binds (panel 047, ratified).
# - the two Windows macros: MSVC hides M_PI behind _USE_MATH_DEFINES
#   and deprecates getenv/fopen/strcpy without _CRT_SECURE_NO_WARNINGS.
# - -Werror=conditional-uninitialized is -Werror because the corpus
#   said so (panel 020's falsifiable disposition, zero fires).
# - the qualifier discard is panel 058's cstr-write refusal at the
#   C level.
# - -Werror=incompatible-pointer-types is panel 103's (2026-09-03): clang
#   22.1.0 made it an error by default and clang 18 and 21 warn, so
#   without the flag the SAME program is refused on two of the three
#   platforms this project measures on and accepted on the third — and
#   the third accepted `int32_t *` where the header said `size_t *`, 8
#   bytes into 4, with a warning nobody read. The emitter earns the
#   flag by passing `(void *)&x` for an `@` argument it has checked
#   itself (ops.hero, extern_probe.hero), so a correct binding compiles
#   clean under it on every clang. Never a -Wno- flag (author
#   instruction, the same day), **but one since 2026-10-09**: panel 199's R3
#   below, which the author ratified by name.
# - -fno-delete-null-pointer-checks is panel 154's (2026-09-15, defect 045):
#   the standard lets clang assume a pointer it dereferences is non-null and
#   delete every check downstream, so a program that handed a null handle to a
#   C function printed a fabricated integer and exited 0 — measured, `8372224`,
#   five runs of five identical, which is a wrong answer a golden would have
#   recorded and passed on forever. With the flag the dereference happens, the
#   fault reaches `runtime/parts/stack.c`'s handler, and the program says what
#   it did. It guards the DEREFERENCE and not the argument, which is why it
#   refuses nothing: `free(NULL)`, `sqlite3_close(NULL)` and the shipped
#   `getaddrinfo(hints: nullptr)` golden all stay legal, where five seats spent
#   a sitting legislating the argument. Measured on this Mac with the machine
#   still: twenty `--emit-c` runs of `examples/ledger/`, median real 2.87 s with
#   the flag and 2.87 s without; 10^9 iterations of a chain walk carrying three
#   redundant null checks the optimiser would otherwise delete, real 1.04 s
#   both; the seed binary +16,528 bytes, 0.38%; the emitted C byte-identical.
#   It landed in clang 7 and the floor here is 18 (`cli/clang_floor.hero`).
# - **-fsigned-char is panel 161's** (2026-09-18, defects 058 and 059): C has
#   three `char` types and the sign of the plain one belongs to the PLATFORM —
#   unsigned under the generic AAPCS, which Debian arm64 follows, and signed on
#   x86-64, on Darwin arm64 (Apple overrides the AAPCS default against Arm's own
#   stated advice) and on Windows. So a header's `char name[65]` is a signed
#   array on three legs and an unsigned one on the fourth, while `spec § 13`
#   tells the author to declare a field at *the header's own width and sign* —
#   which that header does not have. Measured 2026-09-17 on two containers one
#   axis apart, same Debian and same clang: `i8[4]` against `char[4]` is
#   accepted on x86-64 and refused on arm64 Linux, `u8[4]` the reverse, and a
#   scalar, a parameter and a result all invert the same way.
#   `tests/golden/run/ffi-a-char-array-member.hero` has shipped since
#   2026-08-16 and did not compile on the fourth leg.
#
#   **The flag removes the divergence instead of describing it**, which is why
#   it beat a ninth integer type, a new spelling inside `extern`, accepting
#   either spelling, and refusing the type outright. § 13's sentence stays true
#   to the letter: the header's own sign, as the translation unit compiling it
#   sees it, is signed everywhere. No spec token is spent and no guard is
#   relaxed — `signed char`, `unsigned char`, a wrong width and a wrong length
#   all stay refused, because what moved is what clang thinks `char` is and not
#   what `emit/extern_field.hero` asks about it. `unsignedness_of` there is a
#   `_Generic` evaluated INSIDE this same translation unit, so it answers
#   consistently with this flag by construction, and that is why defect 059
#   closes here with no edit to `emit/c_spellings.hero`: its `char -> i8` row
#   was never wrong code, only a sentence that was false on one leg.
#
#   **The one hazard was run rather than argued.** The only leg where this
#   disagrees with the platform default is Debian arm64, and `clang -O2 -S` says
#   an aarch64-linux callee re-narrows a one-byte argument in both directions
#   (`and w0, w0, #0xff`), so the sign is not observable across a
#   translation-unit boundary there; a Darwin callee does trust its caller, but
#   on Darwin this flag AGREES with the default. What remained was a bound
#   header's `static inline` code whose behaviour depends on the sign —
#   Microsoft documents that shape for its own `/J` and ATL/MFC — and the corpus
#   was rebuilt under this flag on that leg to settle it. The Linux kernel took
#   the mirror flag, `-funsigned-char`, in 6.2 for the reason Torvalds gave:
#   making the language rules stricter to avoid differences is a good thing.
# - **-fno-optimize-sibling-calls is panel 199's R2** (defect 508, ratified
#   2026-10-09 with *unbounded recursion is an abort*): at `-O2` clang made a
#   call in tail position a jump, so `ping` and `pong` calling each other or
#   a self-call through a function value ran until `timeout` stopped them,
#   where spec `:280` promises the abort `-O0` gave. Every level's word: at
#   `-O0` the objects are byte-identical with it (Apple clang 21), so the
#   promise rests on no reading of clang there. The price: a tail recursion
#   ten million deep aborts at `-O2` too, and a hundred thousand still
#   returns (`surface-fixtures/deeptail`). The key names this list, so every
#   unit's and the runtime's key moved once.
# - **-Wno-infinite-recursion is panel 199's R3** (defect 507, ratified
#   2026-10-09): clang's *all paths through this function will call itself*
#   was false on correct programs ending on an `exit` inside a callee that
#   otherwise returns, or inside a function handed to `map`. The checker
#   refuses the true case in the program's words since R1
#   (`check/self_call.hero`); what this drops is where clang cannot tell
#   true from false, or is silent. Last, after `-Wall`, since a later word
#   wins (`tests/golden/run/fixedbugs-507-*`).
# - **-fdiagnostics-show-note-include-stack is panel 202's (g)** (defect 550,
#   ratified 2026-10-10): clang prints the includes that reach an error's file
#   and, by default, not those that reach a note's. So where two groups'
#   headers declared one name two ways and the earlier declaration sat in a
#   file another group's header includes, the note named a file no group
#   names, and the refusal was told as one header not compiling in one order
#   of the `use` lines and as the two headers in the other. With the flag the
#   same clang run prints the note's includes from the unit's own line, on
#   clang 21 and 22 (the ffi-pragmatist's measurement), and
#   `cli/header_refused.hero` reads the group's header the file arrives
#   through. Words, never a type's meaning, so it reaches every probe too;
#   the key names this list, so every key moved once.
use cli/process

function flags() -> [str]
    return [
        "-std=gnu11"
        "-D_USE_MATH_DEFINES"
        "-D_CRT_SECURE_NO_WARNINGS"
        "-Wall"
        "-Werror=return-type"
        "-Werror=uninitialized"
        "-Werror=format"
        "-Werror=conditional-uninitialized"
        "-fno-strict-aliasing"
        "-fno-delete-null-pointer-checks"
        "-Werror=shorten-64-to-32"
        "-Werror=sign-conversion"
        "-Werror=incompatible-pointer-types-discards-qualifiers"
        "-Werror=incompatible-pointer-types"
        "-fsigned-char"
        "-fno-optimize-sibling-calls"
        "-Wno-infinite-recursion"
        "-fdiagnostics-show-note-include-stack"
    ]

# **THE DEBUG WORD IS THE LEVEL'S** (panel 197, defects 219 and 322,
# ratified 2026-10-07). Every build carries line tables, so lldb breaks on and
# steps through `.hero` lines and a sanitiser names a file and a line at every
# level (design.md §3.1); the unoptimised build, where `heroes build` and
# `heroes test` compile and an author debugs, carries the variables and their
# types too (design.md Part 2). Until then `-g` was the list's second word on
# every build, since 2026-08-16, when the DWARF had existed only under
# `--sanitize`. At `-O2`, where `heroes run` compiles, the variable DWARF
# bought the parameters' values and nothing else on the sitting's probe (the
# locals were optimised out under `-g` as well), and it cost clang 2.3 times
# the memory on a function of 400 ways out: 2,041,923,528 bytes of peak
# footprint under `-g` against 881,263,672 under line tables and 882,328,656
# under `-g0` (Apple clang 21); `-fno-standalone-debug`, `-gno-column-info` and
# `-gdwarf-4` moved nothing. `-g0` is refused: ASan loses the file and line it
# names everywhere and Linux names a false file, and a breakpoint on a `.hero`
# line never resolves. A level that is not `-O0` takes the line tables.
function debug_words(level: str) -> [str]
    if level == "-O0"
        return ["-g"]
    return ["-gline-tables-only"]

# Every word a compile or a link at `level` takes from this file, in the order
# each line takes them: the list, the level, its debug word, the sanitizers.
# A unit's compile (`compiling.unit_words`), the runtime's
# (`toolchain.runtime_object`) and the link (`link.link_line`) read this one
# list, so no word reaches one of them and not the others, and each key that
# names these words (`toolchain.build_words`, a unit's words) names the debug
# word with them. The link carries it because clang's driver for Windows
# writes the `.pdb` only when the link line carries a `-g` word (`clang -###`
# on the box, panel 197).
function level_words(level: str, sanitize: bool) -> [str]
    out: [str] @ flags()
    out @ out.push(level)

    for word in debug_words(level)
        out @ out.push(word)

    for word in sanitizers(sanitize: sanitize)
        out @ out.push(word)

    return out

# **WHAT A BINARY IS LINKED WITH, and it exists for one platform.**
#
# Windows gives a process's main thread **1 MB** of stack where POSIX gives 8,
# and that is not a tuning knob: it is the difference between this compiler
# running and being killed. Measured on the CI's Windows leg 2026-08-31, with
# two seeds built from the same `seed/heroes.c` minutes apart:
#
#     1 MB   build selfhost/lexer.hero --dump-ir    exit 127, both streams empty
#     1 MB   build selfhost/lexer.hero --emit-c     exit 127, both streams empty
#    64 MB   build selfhost/lexer.hero --dump-ir    exit 0
#    64 MB   build selfhost/lexer.hero --emit-c     exit 0
#    64 MB   build selfhost/main.hero  --emit-c     exit 0  — the whole compiler
#
# A recursive-descent grammar and a recursive lowering pass are what spend it,
# so the shape that dies is a real module rather than a big one:
# `process.hero` at 193 lines builds under 1 MB and `lexer.hero` does not.
# There is no message because the process is not panicking — it is killed, and
# `hero_panic`'s `fprintf` is never reached. Four rounds of CI went into that
# silence.
#
# **64 MB is the number that was RUN.** 8 MB (POSIX parity) and 16 were not
# measured, and this list states measurements rather than preferences.
#
# **AND IT DOES NOT COST NOTHING — this comment said it did, and panel 107
# measured that false.** The sentence deleted here read *"the reserve is address
# space on a 64-bit target and not committed memory, so a large one costs
# nothing real"*, and it is true for a program that stays inside its stack (max
# RSS 2,768,896 bytes large against 2,752,512 small, binary 525,312 both) and
# **false for the case this flag exists for**: a program that runs away takes max
# RSS **9,814,016 → 68,534,272**. That is CLAUDE.md §11's expiring premise in
# its usual shape — the argument still reads as valid, and only the premise
# died. Three more things the sitting ran, none of them known when the number
# was chosen: the flag **overrides the operator** (`pthread_get_stacksize_np`
# reports 67,108,864 under `ulimit -s 1024`), Darwin grants it **above the hard
# rlimit** (67,108,864 > 67,092,480), and 64 MB is exactly Apple's documented
# ceiling, so there is no margin above it. Bringing it down still owes its own
# measurement; the number argued from this compiler's own frames would be
# **16 MB** (`docs/panel/107`, the compiler seat's condition 2).
#
# **AND IT IS WINDOWS' AND STAYS WINDOWS', by ruling.** Panel 107 was convened
# to pass the same number on all three platforms and **refused all three
# mechanisms**, each on a measurement: `-Wl,-z,stacksize=` is ignored by GNU ld
# and rejected by lld, leaving `PT_GNU_STACK` `p_memsz` at 0x0 and the depth
# unchanged, while printing a warning on every Linux build forever through
# `toolchain.hero`'s stderr forwarding; running `main` on a created thread with
# a chosen size breaks `examples/sdl/` (`SDL_Init(VIDEO)` needs the process's
# real main thread); and stating a depth in the spec would be false on the day
# it landed. What the sitting adopted instead is the **per-thread guard**: the
# uniformity a program can be given is a named abort on every thread, not a
# number, because the number cannot be made uniform on any of these platforms.
#
# **It is a LINK flag and it is asked of the machine, not of a `#if`.** Passing
# `-Wl,` to a compile step is an unused argument, and passing `/STACK:` to `ld`
# is an error — so it goes into the two link lines only, and the platform is read
# off `exe_suffix()`, which is the runtime answering about the machine it is on
# (issues/2026-08/14/2026-08-14-0005-is-not-a-fact-about-the-program-so-the-driver.md's rule, `in_the_c_runtime`'s shape). `selfhost/` gains no
# platform axis: it asks a question and gets a fact.
function link_flags() -> [str]
    # **`-rdynamic` on every POSIX link line** (panel 104, 2026-09-03). The stack
    # guard names the function that ran out of stack through `dladdr`, and glibc's
    # `dladdr` reads only `.dynsym` — measured in the Linux image: without the
    # flag the message is `panic: stack exhausted` and nothing more; with it,
    # `… in d100000.down`, and the binary grows 134,640 → 142,832 bytes. Darwin
    # names the symbol either way, from its symbol table under every debug word
    # (`in deep.down` under `-g`, line tables and `-g0` alike, panel 197; this
    # said *`-g` on every build*, which was never the cause), nothing strips,
    # and it accepts the flag (measured: exit 0, no diagnostic), so the flag is
    # POSIX's rather than Linux's — `selfhost/` still asks the machine one question,
    # `exe_suffix()`, and gains no second platform axis.
    if process.exe_suffix() != ".exe"
        return ["-rdynamic"]

    # **`/INCREMENTAL:NO` because this compiler stages and renames.** Every
    # binary is linked to `<name>.tmp` and then published with a rename, so
    # MSVC's incremental linker never finds the previous output it is looking
    # for and says so ON STDOUT:
    #
    #     LINK : build\7163f9e162a1ca14\prog.exe.tmp not found or not built
    #            by the last incremental link; performing full link
    #
    # Measured on the Windows leg 2026-08-31 (run 33386236619) inside
    # `cache/a header edit is not invisible`, where it arrived in the middle of
    # a program's output and the harness compares that byte for byte. The link
    # is always full here by construction, so saying so costs nothing and buys
    # a clean stream.
    return ["-Wl,/STACK:67108864", "-Wl,/INCREMENTAL:NO"]

# What --sanitize adds — NOT a leak detector: ASan's is missing on
# Darwin arm64, and leaks are hero_runtime_check_leaks()'s job in the
# generated main. What these catch is use-after-free and double-free.
function sanitizers(sanitize: bool) -> [str]
    if sanitize
        return ["-fsanitize=address,undefined"]
    empty: [str] = []
    return empty

## Tests

test "the array is the fact: eighteen flags, gnu11 named first and panel 202's last"
    got = flags()
    assert got.len() == 18
    assert got[0] == "-std=gnu11"
    assert got[9] == "-fno-delete-null-pointer-checks"
    assert got[12] == "-Werror=incompatible-pointer-types-discards-qualifiers"
    assert got[13] == "-Werror=incompatible-pointer-types"

    # Panel 161's. It is asserted by NAME and not only by the count,
    # because the count alone would go green on any fifteenth string and
    # this one is the difference between a plain `char` meaning the same
    # thing on four legs and meaning two things on four legs.
    assert got[14] == "-fsigned-char"

    # Panel 199's, by name for the same reason: spec `:280`'s abort at `-O2`
    # is this word (defect 508).
    assert got[15] == "-fno-optimize-sibling-calls"

    # And its R3, after `-Wall`, which would turn the warning back on were it
    # later in the list (defect 507).
    assert got[16] == "-Wno-infinite-recursion"

    # And panel 202's (g): a note's includes, read by the header's refusal.
    assert got[17] == "-fdiagnostics-show-note-include-stack"
    assert got[3] == "-Wall"
    assert sanitizers(sanitize: true).len() == 1
    assert sanitizers(sanitize: false).len() == 0

    # No debug word is the list's: it is the level's (panel 197).
    for flag in got
        assert flag.len() < 2 || flag[0] != '-' || flag[1] != 'g'

    assert debug_words("-O0") == ["-g"]
    assert debug_words("-O2") == ["-gline-tables-only"]
    o2 = level_words(level: "-O2", sanitize: true)
    assert o2.len() == 21
    assert o2[18] == "-O2"
    assert o2[19] == "-gline-tables-only"
    assert o2[20] == "-fsanitize=address,undefined"
    assert level_words(level: "-O0", sanitize: false) == flags().push("-O0").push("-g")

    # A call stays a call at every level (panel 199's R2), the words each
    # level hands a unit, the runtime and the link.
    for level in ["-O0", "-O2"]
        kept: i64 @ 0

        for word in level_words(level: level, sanitize: false)
            if word == "-fno-optimize-sibling-calls"
                kept @ kept + 1

        assert kept == 1

# **What the optimised build does with a call in tail position, asked of the
# platform's own clang** (panel 199's R2, defect 508): a function that calls
# itself last, compiled under the optimised build's words, still names
# itself in its assembly as the callee of a call; under the same words less
# panel 199's, the call becomes a jump to a label inside the function, and
# the name stands fewer times. Counted rather than matched, so no one
# platform's spelling of a call (`bl`, `call`, `callq`) is assumed; the
# program-level witness is `tests/golden/run/fixedbugs-508-*`, which abort
# at both levels where `-O2` ran until `timeout` stopped it.
test "the optimised build keeps a call in tail position a call (panel 199's R2)"
    assert !process.mkdir_all("build/selftest-sibling-calls").is_err()
    unit = "build/selftest-sibling-calls/unit.c"
    text = "void heroes_sibling_sink(int seen);\nint heroes_sibling_probe(int n);\nint heroes_sibling_probe(int n) {\n    if (n == 0) {\n        return 0;\n    }\n    heroes_sibling_sink(n);\n    return heroes_sibling_probe(n - 1);\n}\n"
    assert !write_file(path: unit, text: text).is_err()
    counts: [i64] @ []

    for keep in [true, false]
        said = "build/selftest-sibling-calls/unit-" + keep.to_str() + ".s"
        words: [str] @ ["clang"]

        for word in level_words(level: "-O2", sanitize: false)
            if keep || word != "-fno-optimize-sibling-calls"
                words @ words.push(word)

        for word in ["-S", unit, "-o", said]
            words @ words.push(word)

        assert process.run(program: "clang", words: words, out: process.discard(), err: process.discard()).code == 0
        counts @ counts.push(times(text: read_file(said).must(), needle: "heroes_sibling_probe"))

    assert counts[0] > counts[1]

# **What clang says of a function that only calls itself, asked of the
# platform's own clang** (panel 199's R3, defect 507): under the words a unit
# compiles with, nothing; under the same words less panel 199's R3, its
# `-Winfinite-recursion`, so the case is not blind. The checker says it
# instead, in the program's words (`tests/golden/check/fixedbugs-457-*`).
test "clang's word on a function that can only call itself is not passed on (panel 199's R3)"
    assert !process.mkdir_all("build/selftest-endless").is_err()
    unit = "build/selftest-endless/unit.c"
    said = "build/selftest-endless/said.txt"
    text = "int heroes_endless_probe(int n);\nint heroes_endless_probe(int n) {\n    return heroes_endless_probe(n);\n}\n"
    assert !write_file(path: unit, text: text).is_err()

    for keep in [true, false]
        words: [str] @ ["clang"]

        for word in level_words(level: "-O0", sanitize: false)
            if keep || word != "-Wno-infinite-recursion"
                words @ words.push(word)

        for word in ["-fsyntax-only", unit]
            words @ words.push(word)

        assert process.run(program: "clang", words: words, out: process.discard(), err: said).code == 0
        assert first_at(text: read_file(said).must(), needle: "-Winfinite-recursion") >= 0 == !keep

# **What a debugger is handed, asked of the platform's own clang** (panel
# 197's R2): a unit compiled under the unoptimised build's words describes its
# locals, by the name the C gives them, and one under the optimised build's
# describes none, its lines alone. Read from clang's assembly, where a local's
# name stands only in the debug information (DWARF's string table, or the
# `.pdb`'s CodeView records on Windows), so no other tool is asked for. The
# unoptimised half is what `-g` buys over line tables: under line tables
# lldb's `frame variable` says *no variable information is available* (the
# sitting's probe); and the optimised half is the memory the sitting measured.
# The lines themselves are the location a sanitiser names at `-O2`,
# `tests/golden/run/fixedbugs-322-a-sanitiser-names-the-hero-line-at-every-level.hero`.
test "an unoptimised unit describes its locals to a debugger, and an optimised one only its lines (panel 197)"
    assert !process.mkdir_all("build/selftest-debug-words").is_err()
    unit = "build/selftest-debug-words/unit.c"
    text = "int heroes_debug_probe(int seen);\nint heroes_debug_probe(int seen) {\n    int heroes_seen_local = seen + 1;\n    return heroes_seen_local;\n}\n"
    assert !write_file(path: unit, text: text).is_err()

    for level in ["-O0", "-O2"]
        said = "build/selftest-debug-words/unit" + level + ".s"
        words: [str] @ ["clang"]

        for word in level_words(level: level, sanitize: false)
            words @ words.push(word)

        for word in ["-S", unit, "-o", said]
            words @ words.push(word)

        assert process.run(program: "clang", words: words, out: process.discard(), err: process.discard()).code == 0
        assembly = read_file(said).must()
        assert first_at(text: assembly, needle: "heroes_debug_probe") >= 0
        assert first_at(text: assembly, needle: "heroes_seen_local") >= 0 == (level == "-O0")

# **THE COLUMN IS KEPT, A MEASURED REFUSAL** (defect 471, panel 197's R7,
# route (K) `-gno-column-info`; measured 2026-10-09 by lane b16-compiler, a
# compiler with the word added to both levels' debug words against one
# without, on this Mac, Linux arm64 (Debian clang 22.1.8) and the Windows box
# (clang 23.1.1)). A statement under `#line N "x.hero"` carries the column of
# the C file's own text, never a `.hero` one: lldb stops at `dbg.hero:2:8` and
# draws its caret under the eighth character of `    total: i64 @ 0`, and
# Linux's AddressSanitizer names `uaf.hero:9:10`. With the word those columns
# go and nothing else a tool shows about a file and a line moves: lldb's
# breakpoints, stops and backtraces read the same functions, offsets, files
# and lines, ASan's three stacks the same frames and lines on both POSIX
# platforms (macOS's prints no column either way), and on Windows the word
# changes no line of the assembly but the object's own name and no row of
# the `.pdb`'s line tables, CodeView writing column 0 with it and without.
#
# **What goes with the false column is a TRUE one**, which is why the word is
# refused: code the program did not write stands outside every `#line`, and
# under the word its column goes too: a binding's header (`bind.h:15:24` in
# lldb, `bind.h:15:12` in ASan's report and its SUMMARY line), the runtime
# (`panic.c:49:60`) and the emitted C (`uaf.c:78:5`, `dbg.c:63:23`). UBSan's
# column is the front end's and stays (`bind.h:19:14` under both), so one
# `--sanitize` run would name a column in one report and none in the other.
# The gain on a function of 100, 200 and 400 `return`s at `-O0`: objects of
# 68,984, 132,616 and 260,616 bytes 9.4% to 9.5% smaller, and clang's compile
# 3.0%, 3.8% and 4.6% fewer instructions retired (the median of three).
#
# The test asks the platform's own clang, under each level's words, for the
# column of one statement written twice, in the file and under a `#line`: the
# two are the same column, the C file's, and where the debug format has
# columns it is not 0. It goes red the day the word joins the level's words.
test "the level's words keep a unit's columns, and a `#line` carries the C file's (defect 471)"
    assert !process.mkdir_all("build/selftest-columns").is_err()
    unit = "build/selftest-columns/probe.c"
    text = "#include <stdint.h>\n\nint64_t outside(int64_t a, int64_t b) {\n    return a * b + 1;\n}\n\nint64_t inside(int64_t a, int64_t b) {\n#line 7 \"probe.hero\"\n    return a * b + 1;\n}\n"
    assert !write_file(path: unit, text: text).is_err()

    for level in ["-O0", "-O2"]
        said = "build/selftest-columns/probe" + level + ".s"
        words: [str] @ ["clang"]

        for word in level_words(level: level, sanitize: false)
            words @ words.push(word)

        for word in ["-fverbose-asm", "-S", unit, "-o", said]
            words @ words.push(word)

        assert process.run(program: "clang", words: words, out: process.discard(), err: process.discard()).code == 0
        assembly = read_file(said).must()
        columns: [i64] @ []

        # clang's comment on a location directive: `probe.c:4:12`, the column
        # left out where it is 0 (DWARF) or written as 0 (CodeView).
        for place in ["probe.c:4:", "probe.hero:7:"]
            at = first_at(text: assembly, needle: place)
            a_column_is_written = at >= 0
            assert a_column_is_written
            column: i64 @ 0
            next: i64 @ at + place.len()

            while next < assembly.len() && assembly[next] >= '0' && assembly[next] <= '9'
                column @ column * 10 + (assembly[next] - '0').to_i64().must()
                next @ next + 1

            columns @ columns.push(column)

        assert columns[0] == columns[1]
        assert columns[0] == 0 == (process.exe_suffix() == ".exe")

test "the link flags are one platform's, and the platform is asked not assumed"
    # On this machine the answer is whatever `exe_suffix()` says, so the case
    # asserts the RULE rather than a number it cannot know: exactly one flag on
    # Windows, none anywhere else, and never a `-Wl,` on a compile line.
    got = link_flags()

    if process.exe_suffix() == ".exe"
        assert got.len() == 2
        assert got[0] == "-Wl,/STACK:67108864"
        assert got[1] == "-Wl,/INCREMENTAL:NO"
    else
        assert got == ["-rdynamic"]

    # And a link flag never reaches a compile line. `flags()` is pinned at
    # fifteen above, so the way this could break is somebody pasting the
    # stack reserve into the wrong list — which this names exactly.
    for flag in flags()
        assert flag != "-Wl,/STACK:67108864"

# **A unit compiled by hand for Windows is compiled as `heroes build`
# compiles it** (defect 192): every macro `flags()` defines is the runtime
# header's own there, defined before the first system header a unit reads,
# since `heroes_runtime.h` is every emitted unit's first include. The seed
# built by its own documented command got three `getenv` deprecations on the
# Windows box (2026-10-02) for want of one of them. Asked of clang
# preprocessing for the Windows target, which any clang answers from its own
# headers, so the case reads alike on every leg.
test "every macro flags() defines is the runtime header's own on Windows, before any system header (defect 192)"
    assert !process.mkdir_all("build").is_err()
    unit = "build/selftest-windows-macros.c"
    said = "build/selftest-windows-macros.i"
    assert !write_file(path: unit, text: "#include \"heroes_runtime.h\"\n").is_err()
    words = ["clang", "--target=x86_64-pc-windows-msvc", "-E", "-dD", "-I", "runtime", unit]
    assert process.run(program: "clang", words: words, out: said, err: process.discard()).code == 0
    text = read_file(said).must()

    # The first line marker entering a system header: `# 1 "<path>" 1 3`.
    system = first_at(text: text, needle: "\" 1 3")
    assert system > 0
    defined: i64 @ 0

    for flag in flags()
        if flag.len() > 2 && flag[0] == '-' && flag[1] == 'D'
            name: str @ flag.slice(from: 2, to: flag.len())
            value = first_at(text: flag, needle: "=")

            if value > 0
                name @ flag.slice(from: 2, to: value)
            at = first_at(text: text, needle: "#define " + name + " ")
            assert at >= 0
            assert at < system
            defined @ defined + 1

    assert defined > 0

# How many times `needle` stands in `text`, none overlapping, compared byte
# by byte as `first_at` compares.
function times(text: str, needle: str) -> i64
    count: i64 @ 0
    at: i64 @ 0

    while at + needle.len() <= text.len()
        same: bool @ true
        k: i64 @ 0

        while same && k < needle.len()
            same @ text[at + k] == needle[k]
            k @ k + 1

        if same
            count @ count + 1
            at @ at + needle.len()
        else
            at @ at + 1

    return count

# Where `needle` first stands in `text`, compared byte by byte, so a text
# holding a longer character is never sliced through one; or -1.
function first_at(text: str, needle: str) -> i64
    at: i64 @ 0

    while at + needle.len() <= text.len()
        same: bool @ true
        k: i64 @ 0

        while same && k < needle.len()
            same @ text[at + k] == needle[k]
            k @ k + 1

        if same
            return at
        at @ at + 1

    return -1
