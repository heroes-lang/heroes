# What the runtime is made of, as the keys its cache key is taken from.
#
# Split out of `cli_toolchain` at M-argv-execution, along a seam that
# names a concern rather than at a line count: the toolchain owns WHAT
# to run and WHERE the artifacts live, and this owns the one question
# *what exactly is the runtime this build is about to link*. That
# question grew its own answer when the shell went away — the old one
# was a `cat` glob and a single line, the new one reads `runtime.c` and
# follows what it includes — and a concern that grows a body of its own
# is a concern that wants a file.
#
# It depends on nothing in `cli_toolchain`, which is why the split is
# possible at all: Heroes refuses module cycles whatever the edge
# carries, so a seam only exists where the arrows already point one way.

use bytes
use cli/files
use cli/process
use module/reading

# The runtime's whole contents — EVERY file, not the two entry points:
# runtime.c is assembled from parts/, so hashing only the file clang
# is handed would let a part be edited with the cached object still
# used.
#
# **THE FILE LIST COMES FROM `runtime.c` ITSELF, NOT FROM A GLOB**
# (panel 098 condition 4). It used to be `cat runtime/*.c … 2>/dev/null`
# through a shell, which has three problems and only one of them is
# Windows. There is no glob without a shell; the redirect swallowed the
# status and the caller discarded it with `_ =`, so an unreadable
# runtime produced `digest("")` in silence — and CLAUDE.md §7 names
# that digest as the only guard against a decoy runtime, since the ABI
# stamp cannot see one. Reading `runtime.c` and following its
# `#include "…"` lines answers all three: no shell, no `readdir` order
# to depend on, and a failure that is a failure.
#
# It is also exact rather than approximate. `runtime.c` names every other
# file the runtime is made of, its headers and each part, so the set it
# yields IS the set the old glob collected, and a part that stops being
# included stops being compiled, which is the property the key is
# supposed to track. **This said how many, sixteen** (two headers and
# fourteen parts), **until 2026-10-08**, when the runtime held four headers
# and twenty-four parts (defect 464): a count in prose is a premise nobody
# re-counts, so the claim it stood for is a test now, the last one below,
# which names the directory and the entry point and fires when they differ.
#
# **Each file is keyed alone, and the keys joined** (panel 189's R6). The
# answer was the files' texts joined, so a part read as text and a part that
# is not UTF-8 could spell one answer between them (the ffi-pragmatist's case
# 5, at a header), and two runtimes whose texts are cut apart at another place
# joined to one; sixteen characters a file, each of `module/reading.key_of`'s
# two kinds, are one answer for one set of bytes. A part that is not UTF-8 is
# C all the same and no longer refuses the runtime.
function each_file(runtime: str) -> str?
    entry = runtime + "/runtime.c"
    root = reading.keyed(entry)?
    each: [str] @= [root.key]

    for name in included_names(text: root.text)
        each @ each.push(reading.key_of(runtime + "/" + name)?)

    return ok(each.join(""))

# The runtime's files by their paths, the ones `each_file` keys: `runtime.c`
# and every file it includes by a quoted name. What the runtime IS, wherever
# its directory stands, so a file a program keeps under that directory is not
# taken for one of the compiler's (defect 2035, `cli/group_file.hero`).
function made_of(runtime: str) -> [str]?
    entry = runtime + "/runtime.c"
    root = reading.keyed(entry)?
    out: [str] @= [entry]

    for name in included_names(text: root.text)
        out @ out.push(runtime + "/" + name)

    return ok(out)

# **THE PLATFORM LAYER'S MEMBERS ARE NAMED BY `runtime.c` TOO** (panel 234's
# R6; feature 2295; `cli/layer.hero`): one C file per capability under
# `platform/`, each archived alone, so `runtime.c` names them in a block its
# preprocessor never reads, each after its header, and they are among the
# files `each_file` keys by the rule every compiler since panel 098's
# condition 4 reads, the seed's among them. The members are its names under
# `platform/` that end in `.c`, in the order written; a `runtime.c` that
# names none has no layer.
function layer_members(runtime: str) -> [str]?
    root = reading.keyed(runtime + "/runtime.c")?
    out: [str] @= []

    for name in included_names(text: root.text)
        if is_member(name)
            out @ out.push(runtime + "/" + name)

    return ok(out)

# The folder of the runtime the layer's members stand in.
constant LAYER: str
    "platform/"

function is_member(name: str) -> bool
    return name.len() > LAYER.len() + 2 && bytes.bytes_at(text: name, at: 0, needle: LAYER) && bytes.bytes_at(text: name, at: name.len() - 2, needle: ".c")

# Every `#include "…"` target in the text, in the order written. The
# quoted form only: `<stdio.h>` is the platform's and is not ours to
# hash.
#
# Scanned by hand rather than through a split-and-search helper,
# because this module is the toolchain's and may not `use` a text
# module that would `use` it back — the language refuses module cycles
# whatever the edge carries. `bytes` uses nothing, so it cannot.
#
# **Every question is asked of the bytes** (found beside defect 110,
# 2026-09-27). The scan split the text into characters, counted a line in
# characters against the head's length in bytes, and then sliced bytes:
# a line of `runtime.c` whose tenth byte fell inside a character above
# ASCII, an em dash in a comment at the wrong column, aborted every build
# of every program, and so did a `#include` naming a file above ASCII.
# The head and the quote are ASCII, so every cut made here is beside one.
function included_names(text: str) -> [str]
    found: [str] @= []
    head = "#include \""
    at: i64 @= 0

    while at < text.len()
        stop: i64 @= at

        while stop < text.len() && text[stop] != '\n'
            stop @ stop + 1

        if bytes.bytes_at(text: text, at: at, needle: head)
            shut: i64 @= at + head.len()

            while shut < stop && text[shut] != '"'
                shut @ shut + 1

            if shut < stop
                found @ found.push(text.slice(from: at + head.len(), to: shut))

        at @ stop + 1

    return found

## Tests

test "the includes are read by their bytes, whatever a line holds above ASCII"
    # The first line's tenth byte is inside an `é`, which aborted every build.
    text = "// éééééééé\n#include \"parts/a.c\"\n  #include \"indented.c\"\n#include \"café.h\"\n#include <stdio.h>\n— one — two —\n#include \"never closed\n#include \"parts/b.c\""
    assert included_names(text: text) == ["parts/a.c", "café.h", "parts/b.c"]
    assert included_names(text: "").len() == 0
    assert included_names(text: "#include \"").len() == 0

# Panel 189's R6 at the runtime's key: two runtimes holding one text cut at
# another place between their parts key apart, and a part that is not UTF-8
# keys apart from a part of text spelling the runtime's answer for it.
test "every file of the runtime is keyed alone, so a text cut apart elsewhere, or a part that is not UTF-8, keys apart"
    dir = "build/selftest-runtime-keys"
    assert !process.remove_tree(dir).is_err()
    root = "#include \"a.c\"\n#include \"b.c\"\n"

    for side in ["one", "two", "three", "four"]
        assert !process.mkdir_all(dir + "/" + side).is_err()
        assert !write_file(path: dir + "/" + side + "/runtime.c", text: root).is_err()
        assert !write_file(path: dir + "/" + side + "/b.c", text: "int b;\n").is_err()

    assert !write_file(path: dir + "/one/a.c", text: "int a;\nint").is_err()
    assert !write_file(path: dir + "/one/b.c", text: " b;\n").is_err()
    assert !write_file(path: dir + "/two/a.c", text: "int a;\n").is_err()
    one = each_file(dir + "/one").must()
    assert one.len() == 48
    assert one != each_file(dir + "/two").must()

    # A part holding 0xE9, a second name for the committed header (nothing is
    # written through it), against a part of text spelling the runtime's
    # answer for it after a line, what the route keyed it by.
    assert !files.second_name(existing: "tests/golden/surface-fixtures/notext227/latin1.h", name: dir + "/three/a.c").is_err()
    shown = reading.keyed(dir + "/three/a.c").must().text
    assert !write_file(path: dir + "/four/a.c", text: "not UTF-8, 2 bytes of marks:\nE9" + shown).is_err()
    three = each_file(dir + "/three").must()
    assert three[16] == 'n'
    assert three != each_file(dir + "/four").must()

test "the repository's own runtime names every part it includes"
    names = included_names(text: read_file("runtime/runtime.c").must())
    assert names.len() > 10

    for name in names
        assert !read_file("runtime/" + name).is_err()

# The directory and the entry point say the same files (defect 464): a part
# nothing includes is never compiled, nor keyed, and one included and gone is a
# build that fails. The parts are what a listing of `runtime/parts` holds that
# is a C file and not a hidden one (`._name`, an archive's AppleDouble, is not
# a part).
function has(list: [str], one: str) -> bool
    for item in list
        if item == one
            return true

    return false

function is_part(name: str) -> bool
    return name.len() > 8 && name[6] != '.' && bytes.bytes_at(text: name, at: name.len() - 2, needle: ".c")

test "every file under the runtime's parts is included by runtime.c, and every part it includes is there"
    included = included_names(text: read_file("runtime/runtime.c").must())
    found = process.files_under("runtime/parts").must()
    parts: [str] @= []

    for path in found
        name = path.slice(from: "runtime/".len(), to: path.len())

        if is_part(name)
            parts @ parts.push(name)

    assert parts.len() > 10

    for name in parts
        assert has(included, name)

    for name in included
        if name.len() > 6 && name.slice(from: 0, to: 6) == "parts/"
            assert has(parts, name)

# The platform layer's members are `runtime.c`'s names under `platform/`, in
# its order, each beside its header, among the files the runtime is made of
# (feature 2295).
test "the platform layer's members are the names runtime.c gives under platform/, among the runtime's files (feature 2295)"
    assert layer_members("runtime").must() == ["runtime/platform/hero_net.c", "runtime/platform/hero_time.c"]
    made = made_of("runtime").must()

    for path in ["runtime/hero_net.h", "runtime/platform/hero_net.c", "runtime/hero_time.h", "runtime/platform/hero_time.c"]
        assert has(made, path)

    for name in ["platform/hero_net.c", "platform/x.c"]
        assert is_member(name)

    for name in ["parts/os.c", "hero_net.h", "platform/.c", "platform/hero_net.h", "platformx/hero_net.c"]
        assert !is_member(name)

# The folder and `runtime.c` say the same members, defect 464's question for
# `parts/` asked of `platform/`: a member nothing names is never archived nor
# keyed, and one named and gone is a build that fails.
test "every C file under the runtime's platform folder is a member runtime.c names, and every member it names is there (feature 2295)"
    named = layer_members("runtime").must()
    found: [str] @= []

    for path in process.files_under("runtime/platform").must()
        name = path.slice(from: "runtime/".len(), to: path.len())

        if is_member(name) && name[LAYER.len()] != '.'
            found @ found.push(path)

    assert named.len() >= 2

    for path in found
        assert has(named, path)

    for path in named
        assert has(found, path)

# A member edited moves the runtime's key; a C file of the folder that
# `runtime.c` does not name does not, since nothing compiles it.
test "an edited member moves the runtime's key, and a file of the folder runtime.c does not name does not (feature 2295)"
    dir = "build/selftest-layer-keys"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir + "/platform").is_err()
    assert !write_file(path: dir + "/runtime.c", text: "#include \"a.h\"\n#if 0\n#include \"hero_x.h\"\n#include \"platform/hero_x.c\"\n#endif\n").is_err()
    assert !write_file(path: dir + "/a.h", text: "int a;\n").is_err()
    assert !write_file(path: dir + "/hero_x.h", text: "int x(void);\n").is_err()
    assert !write_file(path: dir + "/platform/hero_x.c", text: "#include \"hero_x.h\"\nint x(void) { return 1; }\n").is_err()
    first = each_file(dir).must()
    assert first.len() == 64
    assert layer_members(dir).must() == [dir + "/platform/hero_x.c"]
    assert !write_file(path: dir + "/platform/hero_y.c", text: "int y;\n").is_err()
    assert each_file(dir).must() == first
    assert !write_file(path: dir + "/platform/hero_x.c", text: "#include \"hero_x.h\"\nint x(void) { return 2; }\n").is_err()
    assert each_file(dir).must() != first
    assert !process.remove_tree(dir).is_err()
