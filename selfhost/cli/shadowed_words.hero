# What the refusals of a file or a word standing in for what the C this
# compiler writes reads say (design.md §4.19, §4.17: everything needed to fix
# the mistake without opening another file; defect 2333, panel 237's R2 and
# R3). No `Fix`: the repair is a file renamed or moved or a variable edited,
# which no edit of the program's text writes. Each is told at the program's
# first byte, since no line of it reads the file or the word. Moved out of
# `cli/shadowed.hero` when panel 237's R2 widened that refusal past §11's 300
# lines.

use cli/clang_added
use cli/pkgconfig_macros
use cli/stand_in
use cli/strings
use diag
use emit/clang_place
use token

constant CODE: str
    "shadowed_header"

# A `-D` or `-U` of a name the guard keeps that the environment hands every
# clang: neither a package's answer nor a file, a word the build did not write
# (panel 237's R3).
constant MACRO_CODE: str
    "shadowed_macro"

# **Who named a folder** (panel 237's R3): the program, its own folder;
# `--include`; a package, by its name; a variable of the environment, by its
# name; clang's own configuration, Apple clang's `-I/usr/local/include` or a
# configuration file; a package of the catalogue, fetched or a `path`
# entry's, by its alias, whose folder its own units and every unit reading
# its group records search (defect 2357); "" where none is known, which no
# build reaches.
record Origin
    kind: str
    name: str

constant PROGRAM: str
    "program"

constant INCLUDE: str
    "include"

constant PKGCONFIG: str
    "pkgconfig"

constant VARIABLE: str
    "variable"

constant CLANG: str
    "clang"

constant FETCHED: str
    "fetched"

constant PATH: str
    "path"

# The refusal, at the program's first byte, since no line of it reads the
# file: the file named, the folder, and the library's header it stands in for;
# `origin` the variable that named the folder, "" for one the build names.
# **A runtime's header is told as the runtime's** (`runtime`): only a folder
# the environment searches before the runtime's, an `-iquote` or a prepended
# `-I` of `CCC_OVERRIDE_OPTIONS`, can hold one read in its place, the unit
# naming it in quotes (measured on this Mac, 2026-11-08: a
# `heroes_standard.h` there was refused as the C library's `<heroes_standard.h>`).
function header(one: stand_in.Shadow, origin: Origin, runtime: bool) -> diag.Diagnostic
    whose_header: str @= "the C library's `<" + one.named + ">`"
    place: str @= "the system's"
    whose_place: str @= "the library's"
    spelled: str @= "<" + one.named + ">"

    if runtime
        whose_header @ "the runtime's `" + one.named + "`"
        place @ "the runtime's"
        whose_place @ "the runtime's"
        spelled @ "\"" + one.named + "\""
    reads: str @= "which the C this compiler writes reads"
    read_in: str @= "its file is read"

    if one.reader.len() > 0
        reads @ "which " + one.reader + " includes"

    # A file a header only asks after (defect 2356): nothing reads it, and the
    # question is what it answers.
    if one.asked
        reads @ "which a header of this build asks after and never includes"
        read_in @ "the question finds its file"
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: CODE,
        message: "`" + clang_place.slashed(one.path) + "` stands in for " + whose_header + ", " + reads + ": a folder this build names is searched before " + place + ", so " + read_in + " in " + whose_place + " place",
        span: token.Span(start: 0, end: 0)
    )
    moved = "rename the file, or move it out of `" + one.folder + "`: " + named_by(origin, folder: one.folder)

    if one.asked
        d.notes @ d.notes.push(
            "a header asks only whether `" + one.named + "` exists, with `__has_include`, and the file standing in `" + one.folder + "` answers yes in " + whose_place + " place: " + moved + ", and every `__has_include(" + spelled + ")` and `#include " + spelled + "` of the build finds it there"
        )
    else
        d.notes @ d.notes.push(moved + ", and every `#include " + spelled + "` of the build reads what it holds")

    # The angle form found a name the platform holds beside the header that
    # asked for it (panel 237's ruling on `sibutil-angled`).
    if one.beside
        d.notes @ d.notes.push(
            "or, where " + one.reader + " means its own `" + one.named + "` beside it, include it as `#include \"" + one.named + "\"`: C reads a quoted name from the including header's own folder first, where `<" + one.named + ">` asks the system's places, which hold a `" + one.named + "` of their own"
        )
    return d

# **Who named the folder, in words** (panel 237's R3): the one origin the
# reader changes, never the three it might be, which the note said until then.
function named_by(origin: Origin, folder: str) -> str
    if origin.kind == PROGRAM
        return "the folder is this program's own, which every unit searches before the system's"

    if origin.kind == INCLUDE
        return "`--include` names that folder"

    if origin.kind == PKGCONFIG
        return "`pkg-config`'s answer for the library `" + origin.name + "` names that folder"

    if origin.kind == CLANG
        return "clang's own configuration searches that folder in every compile"

    if origin.kind == FETCHED
        return "the package `" + origin.name + "` is placed in that folder, which its own units and every unit reading one of its group records search before the system's"

    if origin.kind == PATH
        return "the `path` entry `" + origin.name + "` of the catalogue names that folder, which its own units and every unit reading one of its group records search before the system's"

    if origin.kind == VARIABLE
        told: str @= "`" + origin.name + "` names that folder for every clang this build runs"

        if folder == "."
            told @ told + ", an empty element of it naming `.`, the folder clang runs in"
        return told
    return "the folder is this program's own, one `--include` names, or one `pkg-config` answers for a library"

# **A file read for a header a package's group names, from a folder searched
# before that package's own** (defect 2357): a unit reading another
# package's group record searches the package's folder after its own route,
# so a file of the same name in one of its own folders is read in the
# package's place, and C's record is laid out from another header than the
# package's own unit reads.
function package_header(path: str, folder: str, wanted: str, package: str, origin: Origin) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: CODE,
        message: "`" + clang_place.slashed(path) + "` stands in for the package `" + package + "`'s `" + wanted + "`, which a unit reads for that package's group record: a folder this build names is searched before the package's own folder, so its file is read in the package's place",
        span: token.Span(start: 0, end: 0)
    )
    d.notes @ d.notes.push(
        "rename the file, or move it out of `" + folder + "`: " + named_by(origin, folder: folder) + ", and every unit reading the package's record reads what it holds"
    )
    return d

# A file the environment has every clang read before a unit's first line.
# Its path is told with `/` in the message and in the note alike, as every
# path a message tells from clang's words is (defect 2382).
function forced(one: clang_added.Added) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: CODE,
        message: "`" + clang_place.slashed(one.value) + "` is read before the first line of the C the clang jobs it reaches compile, through " + source_of(one) + "'s `" + one.flag + "`: what it defines stands before the C library's headers and every guard, so nothing undoes it",
        span: token.Span(start: 0, end: 0)
    )
    d.notes @ d.notes.push(remedy(one, word: one.flag + " " + clang_place.slashed(one.value)))
    return d

# A folder an edit of the environment adds to some of the clang jobs this
# build runs and not to every one (defect 2355).
function unlisted(one: clang_added.Added) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: CODE,
        message: "`" + clang_place.slashed(one.value) + "` is searched before the system's by some of the clang jobs this compiler starts and not by the others, through " + source_of(one) + "'s `" + one.flag + "`: a header of one name would be read from it by some jobs and from the system by the rest, and no listing of what a unit reads can say which",
        span: token.Span(start: 0, end: 0)
    )
    d.notes @ d.notes.push(remedy(one, word: one.flag + " " + clang_place.slashed(one.value)))
    return d

# A `-D` or `-U` of a name the guard keeps that the environment hands every
# clang.
function macro(one: clang_added.Added) -> diag.Diagnostic
    name = pkgconfig_macros.macro_of(one.value)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: MACRO_CODE,
        message: "`" + one.flag + one.value + "` reaches clang jobs this compiler starts, through " + source_of(one) + ", and `" + name + "` is a name the C this compiler writes: a `" + one.flag + "` stands before every header and every guard, so nothing undoes it",
        span: token.Span(start: 0, end: 0)
    )
    d.notes @ d.notes.push(remedy(one, word: one.flag + one.value))
    return d

function source_of(one: clang_added.Added) -> str
    if one.variable == clang_added.OWN
        return one.variable
    return "`" + one.variable + "`"

# What takes the word out: the variable without it, or the variable unset.
function remedy(one: clang_added.Added, word: str) -> str
    if one.variable == clang_added.OWN
        return "take `" + word + "` out of clang's configuration file, which adds it to every compile"
    return "take the edit that writes `" + word + "` out of `" + one.variable + "`, or build with `" + one.variable + "` unset"

## Tests

# **A file a header only asks after is told as asked, never as read**
# (defect 2356): the header's question, the file's answer and who named its
# folder; a file the unit reads keeps the sentence of what reads it.
test "a file a header only asks after is told as answering the question, and a file read as read (defect 2356)"
    asked = header(
        stand_in.Shadow(path: "./stdio.h", folder: ".", named: "stdio.h", reader: "", beside: false, asked: true),
        origin: Origin(kind: PROGRAM, name: ""),
        runtime: false
    )
    assert asked.code == CODE
    assert asked.message == "`./stdio.h` stands in for the C library's `<stdio.h>`, which a header of this build asks after and never includes: a folder this build names is searched before the system's, so the question finds its file in the library's place"
    assert asked.notes == ["a header asks only whether `stdio.h` exists, with `__has_include`, and the file standing in `.` answers yes in the library's place: rename the file, or move it out of `.`: the folder is this program's own, which every unit searches before the system's, and every `__has_include(<stdio.h>)` and `#include <stdio.h>` of the build finds it there"]
    read = header(
        stand_in.Shadow(path: "inc/stdio.h", folder: "inc", named: "stdio.h", reader: "", beside: false, asked: false),
        origin: Origin(kind: INCLUDE, name: ""),
        runtime: false
    )
    assert read.message == "`inc/stdio.h` stands in for the C library's `<stdio.h>`, which the C this compiler writes reads: a folder this build names is searched before the system's, so its file is read in the library's place"
    assert read.notes == ["rename the file, or move it out of `inc`: `--include` names that folder, and every `#include <stdio.h>` of the build reads what it holds"]

# **A file or a folder clang's job names is told one way in the message and
# its note** (defect 2382): the message told it with `/` and the note as
# clang wrote it, `\` on the Windows box, one file in two spellings.
test "a forced file and a folder some jobs search are told with `/` in the message and the note alike (defect 2382)"
    file = forced(clang_added.Added(flag: "-include", value: "C:\\inc\\evil.h", variable: "CCC_OVERRIDE_OPTIONS"))
    assert strings.holds(text: file.message, needle: "`C:/inc/evil.h` is read before")
    assert file.notes == ["take the edit that writes `-include C:/inc/evil.h` out of `CCC_OVERRIDE_OPTIONS`, or build with `CCC_OVERRIDE_OPTIONS` unset"]
    folder = unlisted(clang_added.Added(flag: "-I", value: "build\\evil", variable: clang_added.OWN))
    assert strings.holds(text: folder.message, needle: "`build/evil` is searched before")
    assert folder.notes == ["take `-I build/evil` out of clang's configuration file, which adds it to every compile"]
