# The platform layer's archive, on every program's link line (design.md §4.19,
# §1.11, §3.1; panel 234's R6, ratified by the author's reading, decision 2304;
# feature 2295).
#
# **WHAT IT IS.** The capabilities whose C differs by platform, sockets and a
# monotonic clock first, are C files of the project's own beside the runtime,
# one per capability under its `platform/` folder, each including its own
# header first, and named by `runtime.c` in a block its preprocessor never
# reads, since the runtime's file list is that file's (panel 098's condition
# 4; `runtime_key.layer_members`). This file compiles them under the
# runtime's own words, archives them as ONE static library, and puts the
# archive on every link, after the program's objects; **the linker, not the
# compiler, then takes only the members a program references**: `print(1)`
# takes none, a program that calls the clock alone takes the clock alone (the
# critic's G2, measured on both machines with `-rdynamic` on, which exports
# what is linked and pulls in nothing). So no predicate decides here which
# program needs which member, no package spells `link` or a flag for it, and
# no package ships platform C of its own (the ffi-pragmatist's veto of panel
# 114 R3). A group binds a layer function by naming its header,
# `extern "hero_net.h"`, which stands on the runtime's include path and is not
# a seed (the ffi-pragmatist's condition (5)). What stays in the runtime,
# `hero_os.h`'s process, files, directories, spawning and threads, stays
# there because every `main` calls `hero_args_set` (the critic's G3).
#
# **KEYED AS THE RUNTIME'S OBJECT IS** (`toolchain.runtime_object`): the
# fingerprint, clang's answer for the words, the level's words and the
# runtime's key, which holds every member's and header's bytes beside
# `runtime.c`'s files (`runtime_key.each_file`); and what each member's
# includes reach NOW (defect 2289's question, asked of every member at every
# build by one clang run, `cli/reached_each.hero`; until 2026-11-25 one run a
# member, `opening.reached`). Served only where its record still vouches for
# every file the members' compiles read (`deps.vouched`) and its bytes are the
# ones the archiver wrote (`served`, defect 443).
#
# **PUBLISHED AS THE RUNTIME'S OBJECT IS** (`cli/publish.hero`, defect 134):
# the members are compiled into a private folder under their own names, which
# the archive keeps as its members' names, the archive written there, sealed,
# renamed into place, and the record naming it written last; so a build
# reading `build/` sees a whole archive or none, and a build killed half-way
# leaves a private folder nobody reads.
#
# **THE ARCHIVER** is `cli/archiver.hero`'s: asked of clang, never assumed,
# and not in the key, since any of them archives the same members and the
# linker takes members.

use cli/archiver
use cli/deps
use cli/digest
use cli/files
use cli/flags
use cli/layer_reach
use cli/layer_swift
use cli/link
use cli/link_flags
use cli/opening
use cli/process
use cli/publish
use cli/reached_each
use cli/read_back
use cli/runtime_key
use cli/served
use cli/strings
use cli/supplied
use cli/supplied_kept
use cli/toolchain

# The words the link line carries for the layer at `level`: the archive of its
# C members and of the members written in Swift `swift` names, or none where
# the runtime has no layer. Compiled once per key, which names those Swift
# members, then served. A build asks it through `layer_reach.for_build`.
function archive(t: toolchain.Toolchain, level: str, sanitize: bool, swift: [str]) -> [str]?
    members = runtime_key.layer_members(t.runtime)?
    none: [str] = []

    if members.len() == 0
        return ok(none)
    memo: {str: str} @= {}
    words = flags.level_words(level: level, sanitize: sanitize)

    # `build/` first, where the reach's listings are written: Debian clang
    # 22.1.8 refuses an `-MF` into a folder that is not there (exit 1, *error
    # opening*), where Apple clang 21 makes it, measured 2026-11-12; a fresh
    # `build/` keyed its first archive as unread there, and archived again.
    process.mkdir_all(t.build)?
    reach = reaches(t, members: members, words: words, @memo)
    key = digest.digest(
        t.fingerprint + "|" + t.compiler_key + "|" + toolchain.build_words(level: level, sanitize: sanitize) + "|" + t.runtime_key + "|layer|reaches:" + opening.key_text(reach) + layer_swift.key_text(swift, level: level, sanitize: sanitize)
    )
    stem = t.build + "/layer-" + key
    listed = stem + ".deps.txt"
    suffix = archiver.suffix_of(t.target)
    known = deps.vouched(listed, @memo)

    if !reach.is_err() && !known.is_err() && served.serves(stem + "-" + known.must() + suffix) && process.path_exists(supplied_kept.layer_needs_path(stem + "-" + known.must() + suffix))
        return ok([stem + "-" + known.must() + suffix])
    folder = publish.private_name(stem)
    made = compiled(
        t,
        members: members,
        swift: swift,
        words: words,
        stem: stem,
        folder: folder,
        suffix: suffix,
        level: level,
        sanitize: sanitize,
        @memo
    )
    _ = process.remove_tree(folder).is_err()
    built = made?

    # Recorded only where the reach holds every file the C compiles read.
    if opening.covers(reach, listed: built.covered)
        publish.write_whole(path: listed, text: built.listing, keyed: true)?
    return ok([built.path])

# What a cold archive came to: where it was published, the record naming it,
# and the C members' rows, which the reach covers (`cli/layer_swift.hero`).
record Archived
    path: str
    listing: str
    covered: str

# Every member compiled into `folder` under its own name, the archive written
# there, sealed and published beside `stem`; the folder is the caller's to
# remove.
function compiled(t: toolchain.Toolchain, members: [str], swift: [str], words: [str], stem: str, folder: str, suffix: str, level: str, sanitize: bool, @memo: {str: str}) -> Archived?
    process.mkdir_all(folder)?
    objects: [str] @= []
    rows: [str] @= []
    needs: [str] @= []

    for member in members
        name = base_of(member)
        object = folder + "/" + name + ".o"
        depfile = folder + "/" + name + ".d"
        line: [str] @= strings.with_all(list: ["clang"], more: words)
        line @ strings.with_all(
            list: line,
            more: ["-c", "-MD", "-MT", "dep", "-MF", depfile, member, "-I", t.runtime, "-o", object]
        )
        line @ strings.with_all(list: line, more: toolchain.object_words(t, named: stem + "-" + name + ".o"))
        toolchain.run_clang(line: line, what: "compiling the platform layer's " + name, err_path: folder + "/" + name + ".err.txt")?
        read = deps.rows_of(depfile: depfile, skip: t.runtime + "/", @memo)

        if read.is_err()
            return fail(code: "failed", msg: "cannot record what the platform layer's " + name + " read")
        rows @ rows.push(read.must())
        objects @ objects.push(object)

        # What the member needs from outside it, asked while its object
        # stands, so the names it calls are judged as the runtime's are
        # (defect 2489, `cli/supplied.hero`).
        for name_needed in supplied_kept.alone_needs(t, object: object, what: "asking which names the platform layer's " + name + " needs")
            needs @ needs.push(name + "\t" + name_needed)

    # The members in Swift the program reaches, on an Apple target: archived,
    # asked, vouched for by the record as a C member is, and kept out of what
    # the reach covers.
    covered = rows.join("\n")
    in_swift = layer_swift.compiled(t, named: swift, stem: stem, folder: folder, level: level, sanitize: sanitize, @memo)?
    objects @ strings.with_all(list: objects, more: in_swift.objects)
    rows @ strings.with_all(list: rows, more: in_swift.rows)
    needs @ strings.with_all(list: needs, more: in_swift.needs)

    staged = folder + "/layer" + suffix
    archiver.archived(t, staged: staged, objects: objects, err_path: folder + "/archiver.err.txt")?
    listing = deps.pointer_text(rows.join("\n"))
    path = stem + "-" + listing.slice(from: 0, to: 16) + suffix
    served.seal(staged: staged, object: path)?

    # The record first: an archive that stands has its members' needs.
    publish.write_whole(path: supplied_kept.layer_needs_path(path), text: needs.join("\n") + "\n", keyed: true)?
    publish.publish(staged: staged, path: path, keyed: true)?
    return ok(Archived(path: path, listing: listing, covered: covered))

# What every member's includes reach under `words` now, every member asked
# of ONE clang run (`cli/reached_each.hero`: one process for the 43 members
# where one each cost every warm build 2.4 s on this Mac, each rule the
# listing its member's own run writes), as one record whose first line
# digests every member's rows, so the key moves with any of them: absent
# where any member's did not preprocess, so nothing is served warm under it.
function reaches(t: toolchain.Toolchain, members: [str], words: [str], @memo: {str: str}) -> str?
    none: [str] = []
    keyed = runtime_key.made_of(t.runtime).default(none)
    line = strings.with_all(list: strings.with_all(list: ["clang"], more: words), more: ["-I", t.runtime])
    listing = publish.private_name(t.build + "/layer-reached.d")
    rows = reached_each.reached_each(line: line, inputs: members, listing: listing, skip: "", keyed: keyed, @memo)?
    return ok(deps.pointer_text(rows.join("\n")))

# A member's name without its folder or `.c`: `hero_net`.
function base_of(member: str) -> str
    cut: i64 @= member.len()

    while cut > 0 && member[cut - 1] != '/'
        cut @ cut - 1

    return member.slice(from: cut, to: member.len() - 2)

## Tests

# A C unit's `main` written in `dir`, compiled under the runtime's words and
# linked beside the runtime's object and the archive by the link every build
# runs (`link.link_objects`), the archive after the objects; the binary. The
# runtime's object and the archive are `t.build`'s, keyed and served warm.
function linked_program(t: toolchain.Toolchain, dir: str, name: str, body: str) -> str
    source = dir + "/" + name + ".c"
    object = dir + "/" + name + ".o"
    assert !write_file(path: source, text: body).is_err()
    line = strings.with_all(
        list: strings.with_all(list: ["clang"], more: flags.level_words(level: "-O0", sanitize: false)),
        more: ["-c", source, "-I", t.runtime, "-o", object]
    )
    assert !toolchain.run_clang(line: line, what: "a test's unit", err_path: dir + "/" + name + ".err.txt").is_err()
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
    words = archive(
        t,
        level: "-O0",
        sanitize: false,
        swift: layer_reach.reached(t, named: layer_reach.includes(body)).must()
    ).must()
    assert words.len() == 1
    none: [str] = []
    no_output: str? = fail(code: "none", msg: "no -o")
    binary = link.link_objects(
        t,
        objects: strings.with_all(list: [runtime, object], more: words),
        module: name,
        output: no_output,
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    ).must()
    ran = process.run(program: binary, words: [binary], out: process.discard(), err: process.discard())
    assert ran.started && ran.code == 0
    return binary

# A function a file defines and exports, and the member of an archive that
# holds it, `hero_time` for `hero_time.o`; "" where the file is no archive.
record Defined
    member: str
    name: str

# The functions `path` defines, read with the platform's `nm`, Darwin's names
# without the `_` its symbols open with: those of type `T`, a function the
# file defines and exports, a member's own `static` helpers being `t`. For an
# archive `nm` opens each member's lines with its name and a `:`, as
# `lib.a(hero_time.o):` on Darwin and `hero_time.o:` in GNU's, and each
# function is that member's: the layer as the archiver wrote it, so no name
# of the layer is copied into a test (the round's base, 2026-11-20, found the
# clock's member defining five functions where this read named one).
function defined_by(t: toolchain.Toolchain, path: str) -> [Defined]
    out_path = path + ".nm.txt"
    ran = process.run(program: "nm", words: ["nm", path], out: out_path, err: process.discard())
    assert ran.started && ran.code == 0
    found: [Defined] @= []
    member: str @= ""

    for line in deps.lines(read_back.words(out_path).must())
        if member_of(line) != ""
            member @ member_of(line)
            continue
        cut = name_at(line)
        name: str @= line.slice(from: cut, to: line.len())

        if link_flags.apple(t.target) && strings.starts_with(text: name, prefix: "_")
            name @ name.slice(from: 1, to: name.len())

        if cut >= 2 && line[cut - 2] == 'T'
            found @ found.push(Defined(member: member, name: name))

    return found

# The member an `nm` line of an archive opens, `hero_time` for
# `lib.a(hero_time.o):` and for `hero_time.o:`; "" for a symbol's line.
function member_of(line: str) -> str
    if !strings.ends_with(text: line, suffix: ".o):") && !strings.ends_with(text: line, suffix: ".o:")
        return ""
    open: i64 @= line.len() - 1

    while open > 0 && line[open - 1] != '(' && line[open - 1] != '/'
        open @ open - 1

    close: i64 @= line.len() - 1

    if strings.ends_with(text: line, suffix: ".o):")
        close @ close - 1
    return base_of(line.slice(from: open, to: close))

# Where the symbol's name starts on an `nm` line, its type two bytes before.
function name_at(line: str) -> i64
    cut: i64 @= line.len()

    while cut > 0 && line[cut - 1] != ' '
        cut @ cut - 1

    return cut

# The members of `members`, an archive's functions, of which `by` defines a
# function, in the archive's order, each once: the linker takes a member
# whole, so one of its functions defined is the member taken.
function taken(members: [Defined], by: [Defined]) -> [str]
    out: [str] @= []

    for one in members
        if one.member != "" && !layer_reach.has(out, name: one.member)
            for own in by
                if own.name == one.name && !layer_reach.has(out, name: one.member)
                    out @ out.push(one.member)

    return out

# A toolchain over this tree's runtime whose `build/` is `build`, emptied.
function fresh_toolchain(build: str) -> toolchain.Toolchain
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ build
    assert !process.remove_tree(build).is_err()
    return t

# **The linker takes only the members a program calls** (panel 234's R6, the
# critic's G2, built): a link that carries the archive, a program's one of
# whose groups says `layer` since panel 260 (a program that says it nowhere
# carries none, `cli/layer_reach.hero`'s test), and `print(1)`'s shape takes no
# member, a program calling the clock takes the clock alone, one
# that names both headers and calls nothing of them takes none, and one calling
# a socket function takes the sockets and not the clock. On an MSVC target a
# binary holds no symbol table, so the links are run and their symbols unread
# here; what they import is the Windows box's to read.
test "a link carrying the layer takes only the members a program calls (feature 2295, panel 260)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    dir = "build/selftest-layer-links"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    none = linked_program(t, dir: dir, name: "none", body: "int main(void) { return 0; }\n")
    clock = linked_program(
        t,
        dir: dir,
        name: "clock",
        body: "#include \"hero_time.h\"\nint main(void) { return hero_time_monotonic_ns() >= 0 ? 0 : 1; }\n"
    )
    named = linked_program(
        t,
        dir: dir,
        name: "named",
        body: "#include \"hero_net.h\"\n#include \"hero_time.h\"\nint main(void) { return HERO_NET_OK; }\n"
    )
    net = linked_program(
        t,
        dir: dir,
        name: "net",
        body: "#include \"hero_net.h\"\nint main(void) { return hero_net_close(0) == -1 && hero_net_last_error() == HERO_NET_NOT_OPEN ? 0 : 1; }\n"
    )
    both = linked_program(
        t,
        dir: dir,
        name: "both",
        body: "#include \"hero_net.h\"\n#include \"hero_time.h\"\nint main(void) { return hero_time_monotonic_ns() >= 0 && hero_net_last_error() == HERO_NET_OK ? 0 : 1; }\n"
    )

    if !link_flags.msvc(t.target)
        archived = archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0]
        members = defined_by(t, path: archived)

        # Every member of the layer stands in the archive, and each either
        # defines a function, so a member no binary below takes is still read
        # here, or defines no global symbol at all and can be taken into no
        # link: an arm of another platform, whose whole text stands under that
        # platform's condition (on macOS, eight on 2026-11-24: the GTK and
        # Win32 arms, PulseAudio's and WASAPI's). A member defining data
        # alone, or one the archive lost, fails here. None of the programs
        # below reaches a member written in Swift, so the archive holds the C
        # members alone (defect 2625).
        listing = archived + ".members.txt"
        ran = process.run(program: "nm", words: ["nm", archived], out: listing, err: process.discard())
        assert ran.started && ran.code == 0
        names: [str] @= []
        globals: [i64] @= []

        # A global symbol defined: a type that is a capital letter but `U`,
        # a name the member needs from elsewhere.
        for line in deps.lines(read_back.words(listing).must())
            if member_of(line) != ""
                names @ names.push(member_of(line))
                globals @ globals.push(0)
            else
                cut = name_at(line)

                if names.len() > 0 && cut >= 2 && line[cut - 2] >= 'A' && line[cut - 2] <= 'Z' && line[cut - 2] != 'U'
                    globals[globals.len() - 1] @ globals[globals.len() - 1] + 1

        bare: i64 @= 0

        for count in globals
            if count == 0
                bare @ bare + 1

        layered: [str] @= []

        for member in runtime_key.layer_members(t.runtime).must()
            layered @ layered.push(base_of(member))

        assert sort(names) == sort(layered)
        assert taken(members: members, by: defined_by(t, path: archived)).len() + bare == layered.len()
        assert taken(members: members, by: defined_by(t, path: none)).len() == 0
        assert taken(members: members, by: defined_by(t, path: clock)) == ["hero_time"]
        assert taken(members: members, by: defined_by(t, path: named)).len() == 0
        net_took = taken(members: members, by: defined_by(t, path: net))
        assert layer_reach.has(net_took, name: "hero_net")
        assert !layer_reach.has(net_took, name: "hero_time")
        both_took = taken(members: members, by: defined_by(t, path: both))
        assert layer_reach.has(both_took, name: "hero_net")
        assert layer_reach.has(both_took, name: "hero_time")
    assert !process.remove_tree(dir).is_err()

# **On an Apple target the archive of a program reaching `hero_crypto.h`
# holds the member written in Swift** (panel 253's R3, M-rebel-library's
# steps 69; defect 2625 for the reach): a program sealing Wycheproof's
# AES-256-GCM case 92 through the layer gets its tag, opens it and has a
# forged tag refused, and takes `hero_crypto` and the CryptoKit member; on
# any other target the layer compiles no Swift.
test "an Apple target's layer seals by its CryptoKit member, which only a program calling hero_crypto takes (panel 253's R3)"
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()

    if !link_flags.apple(t.target)
        assert layer_swift.members(t).must().len() == 0
        return
    dir = "build/selftest-layer-cryptokit"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    sealing = linked_program(
        t,
        dir: dir,
        name: "sealing",
        body: "#include \"hero_crypto.h\"\n#include <string.h>\nint main(void) {\n    static const unsigned char key[32] = { 0x29, 0xd3, 0xa4, 0x4f, 0x87, 0x23, 0xdc, 0x64, 0x02, 0x39, 0x10, 0x0c, 0x36, 0x54, 0x23, 0xa3, 0x12, 0x93, 0x4a, 0xc8, 0x02, 0x39, 0x21, 0x2a, 0xc3, 0xdf, 0x34, 0x21, 0xa2, 0x09, 0x81, 0x23 };\n    static const unsigned char nonce[12] = { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb };\n    static const unsigned char ad[6] = { 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff };\n    static const unsigned char tag[16] = { 0x2a, 0x7d, 0x77, 0xfa, 0x52, 0x6b, 0x82, 0x50, 0xcb, 0x29, 0x60, 0x78, 0x92, 0x6b, 0x50, 0x20 };\n    unsigned char sealed[28];\n    unsigned char none[1];\n    hero_crypto_key *k = hero_crypto_from_secret(HERO_CRYPTO_AES_256_GCM, key, 32);\n    if (k == NULL || hero_crypto_seal_nonce_for_tests(k, nonce, 12, NULL, 0, ad, 6, sealed, 28) != 28 || memcmp(sealed + 12, tag, 16) != 0 || hero_crypto_open(k, sealed, 28, ad, 6, none, 0) != 0) {\n        return 1;\n    }\n    sealed[27] ^= 1;\n    return hero_crypto_open(k, sealed, 28, ad, 6, none, 0) == -1 && hero_crypto_last_error() == HERO_CRYPTO_FORGED && hero_crypto_close(k) == 0 ? 0 : 1;\n}\n"
    )
    archived = archive(t, level: "-O0", sanitize: false, swift: layer_reach.reached(t, named: ["hero_crypto.h"]).must()).must()[0]
    took = taken(members: defined_by(t, path: archived), by: defined_by(t, path: sealing))
    assert layer_reach.has(took, name: "hero_crypto")
    assert layer_reach.has(took, name: "hero_crypto_cryptokit")

    # Its needs recorded under the name the archive gives it, the one a
    # link's map names (defect 2489's record).
    assert strings.holds(
        text: read_file(supplied_kept.layer_needs_path(archived)).must(),
        needle: "\nhero_crypto_cryptokit\t"
    )
    assert !process.remove_tree(dir).is_err()

# **Two cold builds in one `build/` write one archive, and the cache serves
# only the one its archiver wrote.** The key and the listing name one archive
# in every `build/`; within one, every archive of the members is one set of
# bytes (no time, owner or mode; Apple's `ar` under `ZERO_AR_DATE`), which a
# keyed file another build published must be to stand (defect 2142). **Not
# across two folders, and this test said so until the Windows box's run of
# 2026-11-12**: a member's debug information names the object by its own path
# under `build/` (`toolchain.object_words`, as the runtime's object's does),
# and a COFF object's CodeView holds that name, so two folders were two sets
# of bytes there (an object cross-compiled on this Mac for
# `x86_64-pc-windows-msvc` under two such names differed in 5 bytes, and
# under one in none). Warm, the same path; and wiped mid-way, the archive gone
# under its record, its bytes changed after they were written (the seal,
# defect 443), the record gone, or a private folder a killed build left
# beside it, each is archived again, the first archive's bytes.
test "an archive is one archive byte for byte, and a cache wiped mid-way archives it again (feature 2295)"
    t = fresh_toolchain("build/selftest-layer-twice-a")
    u = fresh_toolchain("build/selftest-layer-twice-b")
    a = archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0]
    b = archive(u, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0]
    assert a.slice(from: t.build.len(), to: a.len()) == b.slice(from: u.build.len(), to: b.len())
    assert !process.remove_tree(u.build).is_err()
    assert archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a

    # The first archive's bytes under a second name, which every archive this
    # folder holds later is held to.
    first = t.build + "/the-first-archive"
    assert !files.second_name(existing: a, name: first).is_err()

    # Warm, nothing compiles (defect 435's shape): asked from a copy of the
    # runtime whose sockets member would not compile, under the same key,
    # the archive is served; a compile would have refused it.
    copy = t.build + "/runtime-copy"
    assert !runtime_key.copy_made(runtime: t.runtime, copy: copy).is_err()
    assert !write_file(path: copy + "/platform/hero_net.c", text: read_file(t.runtime + "/platform/hero_net.c").must() + "int heroes_2295_not_compiled = ;\n").is_err()

    gone: toolchain.Toolchain @= t
    gone.runtime @ copy
    assert archive(gone, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a

    # A header written into the members' search after the archive, ahead of
    # the one they read, moves the reach the one run that asks every member
    # answers (defect 2289, `cli/reached_each.hero`): the archive is asked of
    # clang again, which refuses it as a build with no `build/` would; gone
    # again, the archive is served again.
    assert !write_file(path: copy + "/stdint.h", text: "#error a stdint.h written after the archive\n").is_err()
    assert archive(gone, level: "-O0", sanitize: false, swift: layer_reach.no_members()).is_err()
    assert !process.remove_file(copy + "/stdint.h").is_err()
    assert archive(gone, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a
    assert !process.remove_tree(copy).is_err()

    # Only the archive, its seal, its record and the second name stand:
    # nothing private.
    for path in process.files_under(t.build).must()
        assert !strings.holds(text: path, needle: ".tmp")

    assert !process.remove_file(a).is_err()
    assert archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a
    assert publish.same_bytes(one: a, other: first)
    assert !write_file(path: a, text: "not an archive\n").is_err()
    assert archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a
    assert publish.same_bytes(one: a, other: first)

    for path in process.files_under(t.build).must()
        if strings.ends_with(text: path, suffix: ".deps.txt")
            assert !process.remove_file(path).is_err()

    # A killed build's private folder beside the archive's stem, the name
    # `publish.private_name` gives: `<stem>.<pid>-<n>.tmp`.
    stem = a.slice(from: 0, to: a.len() - 17 - archiver.suffix_of(t.target).len())
    left = stem + ".4242-1.tmp"
    assert !process.mkdir_all(left).is_err()
    assert !write_file(path: left + "/hero_net.o", text: "a killed build's half\n").is_err()
    assert archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a
    assert publish.same_bytes(one: a, other: first)
    assert !process.remove_tree(t.build).is_err()

# A runtime whose `runtime.c` names no member has no layer and puts nothing
# on the line; one whose member clang refuses is clang's refusal, which a
# build tells as the compiler's (`for_build`), never an archive with a member
# left out.
test "a runtime with no layer adds nothing to the link, and a member clang refuses is its refusal (feature 2295)"
    t = fresh_toolchain("build/selftest-layer-runtimes")
    copy = t.build + "/runtime"
    assert !runtime_key.copy_made(runtime: t.runtime, copy: copy).is_err()

    # `runtime.c` with the lines naming the members left out: no layer.
    named: [str] @= []
    unnamed: [str] @= []

    for line in deps.lines(read_file(t.runtime + "/runtime.c").must())
        named @ named.push(line)

        if !strings.starts_with(text: line, prefix: "#include \"platform/")
            unnamed @ unnamed.push(line)

    assert named.len() > unnamed.len()
    assert !write_file(path: copy + "/runtime.c", text: unnamed.join("\n") + "\n").is_err()
    bare: toolchain.Toolchain @= t
    bare.runtime @ copy
    assert archive(bare, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must().len() == 0

    # Named again, with a member whose arm disagrees with its header.
    assert !write_file(path: copy + "/runtime.c", text: read_file(t.runtime + "/runtime.c").must()).is_err()
    assert !write_file(path: copy + "/platform/hero_time.c", text: "#include \"hero_time.h\"\nint hero_time_monotonic_ns(void) { return 0; }\n").is_err()

    match archive(bare, level: "-O0", sanitize: false, swift: layer_reach.no_members())
        .ok => assert false
        .err e =>
            assert e.code == "clang"
            assert strings.holds(text: e.msg, needle: "conflicting types for 'hero_time_monotonic_ns'")

    assert !process.remove_tree(t.build).is_err()

# A member's name, cut where its bytes say.
test "a member is named by its file (feature 2295)"
    assert base_of("runtime/platform/hero_net.c") == "hero_net"
    assert base_of("hero_time.c") == "hero_time"

# Defect 2489: an archive stands beside the record of what each member
# needs, asked while its object stood, `hero_net` the C library's `socket`
# among them; one whose record is gone is archived again, the same bytes and
# the same record. **`socket` on every target since defect 2510**: on the
# CI's MSVC leg the record named no need of the member, link.exe's words
# having gone to a stdout nobody read, and the member's own `ws2_32.lib`
# supplied `socket` to its lone link on link.exe and lld-link alike.
test "an archive stands with the record of what its members need, and is archived again without it (defect 2489)"
    t = fresh_toolchain("build/selftest-layer-needs-2489")
    a = archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0]
    listed_needs = read_file(supplied_kept.layer_needs_path(a)).must()
    assert strings.holds(text: listed_needs, needle: "hero_net\tsocket\n")
    first = t.build + "/the-first-archive"
    assert !files.second_name(existing: a, name: first).is_err()
    assert !process.remove_file(supplied_kept.layer_needs_path(a)).is_err()
    assert archive(t, level: "-O0", sanitize: false, swift: layer_reach.no_members()).must()[0] == a
    assert publish.same_bytes(one: a, other: first)
    assert read_file(supplied_kept.layer_needs_path(a)).must() == listed_needs
    assert !process.remove_tree(t.build).is_err()
