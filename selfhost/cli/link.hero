# One link over every object a build made, and where the binary it makes
# lands (design.md §3.1, §1.12; panel 093; defect 134). Split out of
# `cli/units.hero` on 2026-09-30, when publishing the link passed that file
# over §11's 300 lines: `units` answers what one translation unit compiles
# to, and this answers what the objects of a program become, a question
# with its own key.

use cli/files
use cli/flags
use cli/libraries
use cli/link_flags
use cli/link_output
use cli/link_warning
use cli/process
use cli/publish
use cli/response_file
use cli/strings
use cli/supplied
use cli/toolchain
use cli/units
use module/reading as file_reading

# One link over every object. Re-run on every build, deliberately: it
# is one clang call, and it is what lets a `link` name change take
# effect on a fully warm cache. Answers where the binary landed.
#
# **THE BINARY LANDS WHERE ITS OWN LINK LINE SAYS** (defect 134): under
# `build/`, a directory named by every word of the line but the output, so
# a binary already there was linked from the same objects, and each object
# is named by its text and by the headers it read. It was
# `build/<hash>/<m>`, a hash of the source alone, so two builds of one
# program shared it whatever their headers said; on Windows a binary
# another process is running cannot be replaced, and the one there could
# not be told from this one. The author's `-o` names a place and not a
# content, so a failure to publish there is reported.
#
# **The linker writes into a private directory**, `<binary>.<pid>-<n>.tmp/`,
# and everything it wrote is published beside the binary: all six builds
# of one program used to link `<m>.tmp`, and the macOS linker refuses an
# output another is writing (`ld: open() failed, errno=17`). A directory
# and not a name, because on Windows the linker names the PDB after its
# output, so a private file name would leave a new `.pdb` on every build.
# Inside it the output is the module's own name, never a part of the path
# asked for: an author's `-o` is not split to find one (`link_output.published_as`).
#
# **Its words reach clang in a file in the binary's home** (defect 583,
# `response_file.for_link`): they name every object, and Windows refuses a
# line past 32,767 characters, which the compiler's own build passed.
function link_objects(t: toolchain.Toolchain, objects: [str], module: str, output: str?, level: str, sanitize: bool, search_library: [str], pkgconfig_flags: [str], link_names: [str], judging: supplied.Judging) -> str?
    line: [str] @= link_line(
        objects: objects,
        level: level,
        sanitize: sanitize,
        target: t.target,
        search_library: search_library,
        pkgconfig_flags: pkgconfig_flags,
        link_names: link_names
    )
    home = link_output.binary_home(t, line: line, name: module + process.exe_suffix())
    binary: str @= home

    # Where the binary lands, which is `binary` itself but for an author's
    # `-o` that is a link: that one is written through to the file it names
    # and stays a link (defect 136), where the rename used to replace it.
    at: str @= binary
    keyed: bool @= true

    if !output.is_err()
        binary @ output.must()

        # An author's name with no suffix takes the platform's (defect 359),
        # but where it names a device, `-o NUL`, which is written into.
        if !files.is_special(binary)
            binary @ link_output.with_suffix(path: binary, suffix: process.exe_suffix())

        # Refused before a byte is linked where nothing may be written: a
        # file that could not be opened for writing, a directory, and a
        # directory that is not there, which is the author's to make, since
        # the stage below would make it and the linker never did.
        at @ publish.landing_for(binary)?
        keyed @ false

        # Something that is not a file, `-o /dev/null`, cannot be renamed
        # over and holds nothing to lose: the linker writes into it, as
        # `clang -o /dev/null` does (measured), where a private name beside
        # it could not be made and the build was refused.
        if files.is_special(at)
            return linked_into(line: response_file.for_link(line: line, home: home)?, t: t, at: at, binary: binary)

    # Who supplies each bound name and each name the runtime calls, asked of
    # this link itself, judged before anything is published (panel 239).
    line @ strings.with_all(list: line, more: supplied.real_words(t, j: judging))
    line @ response_file.for_link(line: line, home: home)?
    stage = publish.private_name(at)
    stage_made = process.mkdir_all(stage)

    # Said of the author's file, which is untouched, and not of the private
    # directory, whose name they never gave (measured: `could not create the
    # directory ro/out.3932-27.tmp`, for an `-o ro/out` in a read-only one).
    if stage_made.is_err() && !keyed
        return publish.refused(
            path: binary,
            what: "no directory could be made beside it for the linker's output" + process.because()
        )
    stage_made?
    err_path = publish.private_name(t.build + "/link-clang-stderr.txt")
    inner = module + process.exe_suffix()
    line @ strings.with_all(
        list: line,
        more: link_output.pdb_words(suffix: process.exe_suffix(), at: at, inner: inner, module: module)
    )
    line @ strings.with_all(list: line, more: ["-o", stage + "/" + inner])
    linked = supplied.linked(t, j: judging, line: line, err_path: err_path)
    publish.discard(err_path)

    if linked.is_err()
        _ = process.remove_tree(stage).is_err()
        return fail(code: link_code(linked), msg: units.failure_note(linked))
    wrote = process.files_under(stage)

    if wrote.is_err()
        _ = process.remove_tree(stage).is_err()
        return fail(code: "not_written", msg: "cannot read what the linker wrote in " + stage)

    for made in wrote.must()
        # Where the linker made a directory, a `.dSYM` being a tree, it is
        # made beside the binary as well.
        relative = made.slice(from: stage.len() + 1, to: made.len())
        target = link_output.published_as(binary: at, inner: inner, module: module, relative: relative)

        if publish.base_of(relative) != relative
            process.mkdir_all(publish.beside(path: target, name: "."))?
        published = publish.publish(staged: made, path: target, keyed: keyed)

        if published.is_err()
            _ = process.remove_tree(stage).is_err()
            return fail(code: units.failure_code(published), msg: units.failure_note(published))

    _ = process.remove_tree(stage).is_err()
    return ok(binary)

# The words of the link but its output. The compiler's flags ride it whole:
# Debian clang 22.1.8 and Apple clang 21.0.0 link under the whole list
# without a word (measured 2026-10-03), and the `warnings` suite reads every
# program's link, so it fires the day a clang does not. Then the level, its
# debug word (`flags.level_words`: clang's driver for Windows writes the
# `.pdb` only when the link line carries a `-g` word), the sanitizers, the
# link's own flags (`link_flags.link_flags`, which carries the
# measurements: `-rdynamic` on POSIX, the stack reserve and a full link on
# Windows), the target's (`link_flags.target_words`: a reproducible output
# from Apple's linker, defect 593), the `--library` directories, the
# objects, a package's link words (`libraries.link_words`) and the `link`
# names, these two in one group on a Linux target (panel 238's R3). No
# include directory: a link reads none, and until defect 206 the link took
# the `--include` directories and a package's whole answer, whose `-F` clang
# on Linux called *argument unused during compilation*.
function link_line(objects: [str], level: str, sanitize: bool, target: str, search_library: [str], pkgconfig_flags: [str], link_names: [str]) -> [str]
    line: [str] @= strings.with_all(list: ["clang"], more: flags.level_words(level: level, sanitize: sanitize))
    line @ strings.with_all(list: line, more: link_flags.link_flags())
    line @ strings.with_all(list: line, more: link_flags.target_words(target))

    for dir in search_library
        line @ strings.with_all(list: line, more: ["-L", dir])

    for object in objects
        line @ line.push(object)

    library: [str] @= []

    for flag in libraries.link_words(pkgconfig_flags)
        library @ library.push(flag)

    for name in link_names
        library @ library.push("-l" + name)

    # **One group around every library word**, a package's and a `link`
    # name's together, where the target's linker reads an archive once, where
    # it stands (`link_flags.groups_libraries`; defects 2365 and 2366): the
    # written order is the module walk's, and an archive needing one named
    # before it was *undefined reference* on GNU ld in that order, or in every
    # order where a package's words stood first. One group and never two,
    # since two groups side by side do not resolve across (GNU ld 2.44 in the
    # `heroes-linux-arm64` container, measured by panel 238's critic and again
    # by lane b26-link). A package cannot answer a group of its own: an
    # answer holding `-Wl,--start-group` is refused `ffi_pkgconfig` at the
    # package's string (measured, lane b26-link), no such word being on the
    # list `libraries.refused` names.
    if library.len() > 0 && link_flags.groups_libraries(target)
        line @ line.push("-Wl,--start-group")
        line @ strings.with_all(list: line, more: library)
        line @ line.push("-Wl,--end-group")
        return line

    return strings.with_all(list: line, more: library)

# The link written straight into `at`, which is not a file. Answers the
# author's own spelling, as a link published under `build/` does.
function linked_into(line: [str], t: toolchain.Toolchain, at: str, binary: str) -> str?
    err_path = publish.private_name(t.build + "/link-clang-stderr.txt")
    linked = link_warning.run_link(
        line: strings.with_all(list: line, more: ["-o", at]),
        what: "linking",
        err_path: err_path
    )
    publish.discard(err_path)

    if linked.is_err()
        return fail(code: link_code(linked), msg: units.failure_note(linked))
    return ok(binary)

# A refused link's code (defect 443): `clang` is a compile clang refused, and a
# link whose objects the linker refused is this, so the sentence said after it
# names the linker and never *clang refused the generated C*, which was said
# of a zeroed object. To `cli/whose.hero` it is clang's refusal all the same,
# read for the author's missing `link` as a refused compile is read for the
# author's extern.
constant REFUSED: str
    "clang_link"

function link_code(failed: ()?) -> str
    code = units.failure_code(failed)

    if code == "clang"
        return REFUSED
    return code

## Tests

# THE CONCURRENT CASE's body, run on six threads at once by the test of that
# name below: its own toolchain, one scratch `build/` for all six, and a
# whole build, the runtime's object, one unit and the link. One `i64`
# crosses a thread (`examples/threads/main.hero`), so the answer is 1 for a
# binary that is there and runs, and 0 for anything else, with a note of
# where and why (`failed_at`).
extern "hero_os.h"
    function hero_thread_spawn(body: (function(i64) -> i64), arg: i64) -> i64
    function hero_thread_join(handle: i64) -> i64

constant TOGETHER_BUILD: str
    "build/selftest-together"

# A failed build's place and the words clang or the system gave there, left
# in `dir` for the test to read (defect 2142): the CI's Windows leg read five
# of six at 7b97b9438, and a 0 alone named none of the five places a build
# can fail, its private names, its run's words and its objects' seals each
# read and none the cause.
function failed_at(dir: str, index: i64, step: str, words: str) -> i64
    _ = process.mkdir_all(dir).is_err()
    _ = write_file(
        path: dir + "/failed-" + index.to_str() + ".txt",
        text: "build " + index.to_str() + ", " + step + ": " + words
    ).is_err()
    return 0

# Every note `failed_at` left in `dir`, none where it holds none or is not
# there.
function notes_in(dir: str) -> [str]
    listed = process.files_under(dir)
    notes: [str] @= []

    if listed.is_err()
        return notes

    for path in listed.must()
        if strings.holds(text: path, needle: "failed-")
            notes @ notes.push(read_file(path).default("a note that cannot be read: " + path))

    return notes

function build_beside(index: i64) -> i64
    dir = TOGETHER_BUILD + "-" + process.pid().to_str()
    found = toolchain.locate_toolchain(hint: "", fingerprint: "port-test")

    if found.is_err()
        return failed_at(dir: dir, index: index, step: "the toolchain", words: "not found")
    t: toolchain.Toolchain @= found.must()
    t.build @ dir
    none: [str] = []
    memo: {str: str} @= {}
    opened: {str: str} @= {}
    told: {str: bool} @= {}
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false)
    made = units.tu_object(
        t,
        module: "together",
        tu_text: "int main(void) { return 0; }\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    )

    if runtime.is_err()
        return failed_at(dir: dir, index: index, step: "the runtime's object", words: units.failure_text(runtime))

    if made.is_err()
        return failed_at(dir: dir, index: index, step: "the unit's object", words: units.failure_text(made))
    no_output: str? = fail(code: "none", msg: "no -o")
    binary = link_objects(
        t,
        objects: [runtime.must(), made.must()],
        module: "together",
        output: no_output,
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    )

    if binary.is_err()
        return failed_at(dir: dir, index: index, step: "the link", words: units.failure_text(binary))
    ran = process.run(program: binary.must(), words: [binary.must()], out: process.discard(), err: process.discard())

    if !ran.started
        return failed_at(
            dir: dir,
            index: index,
            step: "the run",
            words: "it did not start, the system's reason " + ran.why.to_str()
        )

    if ran.code != 0
        return failed_at(
            dir: dir,
            index: index,
            step: "the run",
            words: "it exited " + ran.code.to_str() + ", signal or exception " + ran.signal.to_str()
        )
    return 1

test "six builds of one cold program started at once all succeed, and publish one object and one binary (defect 134)"
    dir = TOGETHER_BUILD + "-" + process.pid().to_str()
    assert !process.remove_tree(dir).is_err()
    handles: [i64] @= []

    for i in range(from: 0, to: 6)
        handles @ handles.push(hero_thread_spawn(body: build_beside, arg: i))

    done: i64 @= 0

    for h in handles
        done @ done + hero_thread_join(handle: h)

    # Every failed build's note, so a red names its place and its words.
    assert notes_in(dir).join("\n") == ""
    assert done == 6
    objects: i64 @= 0
    binaries: i64 @= 0

    for path in process.files_under(dir).must()
        assert !strings.ends_with(text: path, suffix: ".tmp")

        if strings.ends_with(text: path, suffix: ".o")
            objects @ objects + 1

        if strings.ends_with(text: path, suffix: "/together" + process.exe_suffix())
            binaries @ binaries + 1

    # The runtime's object and the unit's; one binary.
    assert objects == 2
    assert binaries == 1
    assert !process.remove_tree(dir).is_err()

# **Two cold compiles of one unit, and of the runtime, write one object**
# (defect 2142): clang names its output in a Windows object's debug
# information, so an object named by its private name differed from another
# build's, and a keyed object it published over a linker's read was refused,
# `LNK1104`. Named by its unit, it is these bytes on every platform.
test "two cold compiles of one unit, and of the runtime, each write one object byte for byte (defect 2142)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-one-object-" + process.pid().to_str()
    digests: [str] @= []
    objects: [str] @= []

    for again in range(from: 0, to: 2)
        assert !process.remove_tree(t.build).is_err()
        none: [str] = []
        memo: {str: str} @= {}
        opened: {str: str} @= {}
        told: {str: bool} @= {}
        unit = units.tu_object(
            t,
            module: "same",
            tu_text: "int main(void) { return 0; }\n",
            level: "-O0",
            sanitize: false,
            search: "",
            pkgconfig_flags: none,
            source_dir: "",
            search_include: none,
            memo: @memo,
            opened: @opened,
            @told
        ).must()
        runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
        objects @ objects.push(unit).push(runtime)
        digests @ digests.push(file_reading.key_of(unit).must()).push(file_reading.key_of(runtime).must())
        _ = again

    assert objects[0] == objects[2] && objects[1] == objects[3]
    assert digests[0] == digests[2]
    assert digests[1] == digests[3]
    assert !process.remove_tree(t.build).is_err()

# The concurrent case's own instrument, witnessed: a failed build's note is
# read back whole, and a directory with none, or none at all, reads nothing
# (defect 2142).
test "a failed build's note names its place and its words, and a build with none leaves none"
    dir = "build/selftest-notes-" + process.pid().to_str()
    assert !process.remove_tree(dir).is_err()
    assert notes_in(dir).len() == 0
    assert failed_at(dir: dir, index: 4, step: "the link", words: "clang said no") == 0
    assert failed_at(dir: dir, index: 5, step: "the run", words: "it exited 1, signal or exception 0") == 0
    notes = notes_in(dir)
    assert notes.len() == 2
    told = notes.join("\n")
    assert strings.holds(text: told, needle: "build 4, the link: clang said no")
    assert strings.holds(text: told, needle: "build 5, the run: it exited 1, signal or exception 0")
    assert !process.remove_tree(dir).is_err()

test "a binary's home is named by every word of its link line, and an author's -o is theirs (defect 134)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-link"
    assert !process.remove_tree(t.build).is_err()
    assert link_output.binary_home(t, line: ["clang", "a.o"], name: "p") == link_output.binary_home(t, line: ["clang", "a.o"], name: "p")
    assert link_output.binary_home(t, line: ["clang", "a.o"], name: "p") != link_output.binary_home(t, line: ["clang", "b.o"], name: "p")

    # Two words are never one: each is counted by its length.
    assert link_output.binary_home(t, line: ["a b"], name: "p") != link_output.binary_home(t, line: ["a", "b"], name: "p")
    none: [str] = []
    memo: {str: str} @= {}
    opened: {str: str} @= {}
    told: {str: bool} @= {}
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
    made = units.tu_object(
        t,
        module: "linkprobe",
        tu_text: "int main(void) { return 0; }\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    ).must()
    wanted = t.build + "/app" + process.exe_suffix()
    binary = link_objects(
        t,
        objects: [runtime, made],
        module: "linkprobe",
        output: ok(wanted),
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    ).must()
    assert binary == wanted
    assert process.path_exists(wanted)

    # The author's path as written: on Windows `\` is its separator and
    # elsewhere a byte of a name, and neither is split to name the output.
    assert !process.mkdir_all(t.build + "/sub").is_err()
    slashed = t.build + "/sub\\app" + process.exe_suffix()
    assert link_objects(t, objects: [runtime, made], module: "linkprobe", output: ok(slashed), level: "-O0", sanitize: false, search_library: none, pkgconfig_flags: none, link_names: none, judging: supplied.nothing()).must() == slashed
    assert process.path_exists(slashed)
    missing = link_objects(
        t,
        objects: [runtime, made],
        module: "linkprobe",
        output: ok(t.build + "/no-such-directory/app"),
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    )

    # The name the binary would have had, the platform's suffix with it
    # (defect 359; measured on the Windows box, where this said `app`).
    lost = t.build + "/no-such-directory/app" + process.exe_suffix()
    assert units.failure_text(missing) == "cannot write " + lost + ": its directory is not there; " + lost + " was not created"

    # An `-o` with no suffix lands under the platform's (defect 359): `.exe`
    # on Windows, the path as given elsewhere, and the answer names it.
    bare = link_objects(
        t,
        objects: [runtime, made],
        module: "linkprobe",
        output: ok(t.build + "/bare"),
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    ).must()
    assert bare == t.build + "/bare" + process.exe_suffix()
    assert process.path_exists(bare)

    for path in process.files_under(t.build).must()
        assert !strings.ends_with(text: path, suffix: ".tmp")

# **A link over a package's compile words prints nothing** (defect 206). On
# Linux a `-F` at a link is *argument unused during compilation*, so a
# framework's headers found through a `.pc` warned on every build; the line
# `link_objects` runs carries none of a package's `-F -I -D -U` when no
# framework is linked, and clang, run over it, says nothing.
test "a link over a package's compile words carries none of them and prints nothing (defect 206)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-link-words"
    assert !process.remove_tree(t.build).is_err()
    none: [str] = []
    memo: {str: str} @= {}
    opened: {str: str} @= {}
    told: {str: bool} @= {}
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
    made = units.tu_object(
        t,
        module: "linkwords",
        tu_text: "int main(void) { return 0; }\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    ).must()
    words = ["-F" + t.build, "-I" + t.build, "-DHERO_LINK_WORDS=1", "-UHERO_LINK_WORDS"]
    line = link_line(
        objects: [runtime, made],
        level: "-O0",
        sanitize: false,
        target: t.target,
        search_library: none,
        pkgconfig_flags: words,
        link_names: none
    )

    for word in words
        for one in line
            assert one != word

    said = t.build + "/said.txt"
    out = t.build + "/linkwords" + process.exe_suffix()
    assert !toolchain.run_clang(line: strings.with_all(list: line, more: ["-o", out]), what: "linking", err_path: said).is_err()
    assert read_file(said).must() == ""

# **A link past what one Windows line holds** (defect 583): one object named
# over and over until the paths alone pass 32,767 characters, as the
# compiler's own 558 did on the Windows box. It links on every platform, the
# words it ran with are the file's, and the file holds every one of them but
# `clang`, each object among them.
test "a link whose objects pass what one Windows command line holds reads every word from its file (defect 583)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-link-long"
    assert !process.remove_tree(t.build).is_err()
    none: [str] = []
    memo: {str: str} @= {}
    opened: {str: str} @= {}
    told: {str: bool} @= {}
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
    made = units.tu_object(
        t,
        module: "linklong",
        tu_text: "int main(void) { return 0; }\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    ).must()
    filler = units.tu_object(
        t,
        module: "filler",
        tu_text: "typedef int hero_filler;\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    ).must()
    objects: [str] @= [runtime, made]
    length: i64 @= runtime.len() + made.len() + 2

    while length <= 32767
        objects @ objects.push(filler)
        length @ length + filler.len() + 1

    no_output: str? = fail(code: "none", msg: "no -o")
    binary = link_objects(
        t,
        objects: objects,
        module: "linklong",
        output: no_output,
        level: "-O0",
        sanitize: false,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none,
        judging: supplied.nothing()
    ).must()
    ran = process.run(program: binary, words: [binary], out: process.discard(), err: process.discard())
    assert ran.started && ran.code == 0
    line = link_line(
        objects: objects,
        level: "-O0",
        sanitize: false,
        target: t.target,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none
    )
    home = link_output.binary_home(t, line: line, name: "linklong" + process.exe_suffix())
    assert binary == home
    words = publish.beside(path: home, name: "link-words.rsp")
    assert response_file.for_link(line: line, home: home).must() == ["clang", "--rsp-quoting=posix", "@" + words]
    held = read_file(words).must()
    assert held == response_file.text_of(line)
    ends: i64 @= 0

    for i in range(from: 0, to: held.len())
        if held[i] == 10
            ends @ ends + 1

    assert ends == line.len() - 1
    assert strings.holds(text: held, needle: "\n\"" + filler + "\"\n")
    assert !process.remove_tree(t.build).is_err()

# **Two links of the same objects into one path are one binary** (defect 593):
# on this Mac the second differed from the first in its `LC_UUID`, which
# Apple's linker drew at random under the `-O0` clang's driver hands it, and
# the line now asks it for a reproducible output (`link_flags.target_words`).
# Asserted on POSIX, where Linux's two generations were already one binary
# (defect 583's measurement); on Windows unmeasured, its box being off.
test "two links of the same objects into one path are one binary (defect 593)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-link-same"
    assert !process.remove_tree(t.build).is_err()
    none: [str] = []
    memo: {str: str} @= {}
    opened: {str: str} @= {}
    told: {str: bool} @= {}
    runtime = toolchain.runtime_object(t, level: "-O0", sanitize: false).must()
    made = units.tu_object(
        t,
        module: "linksame",
        tu_text: "int main(void) { return 0; }\n",
        level: "-O0",
        sanitize: false,
        search: "",
        pkgconfig_flags: none,
        source_dir: "",
        search_include: none,
        memo: @memo,
        opened: @opened,
        @told
    ).must()
    wanted = t.build + "/same" + process.exe_suffix()
    bytes_of: [str] @= []

    for _ in range(from: 0, to: 2)
        linked = link_objects(
            t,
            objects: [runtime, made],
            module: "linksame",
            output: ok(wanted),
            level: "-O0",
            sanitize: false,
            search_library: none,
            pkgconfig_flags: none,
            link_names: none,
            judging: supplied.nothing()
        ).must()
        bytes_of @ bytes_of.push(file_reading.key_of(linked).must())

    if process.exe_suffix() != ".exe"
        assert bytes_of[0] == bytes_of[1]

    # The word is on the line where clang names an Apple target, and only there.
    line = link_line(
        objects: [runtime, made],
        level: "-O0",
        sanitize: false,
        target: t.target,
        search_library: none,
        pkgconfig_flags: none,
        link_names: none
    )
    said: bool @= false

    for word in line
        if word == "-Wl,-reproducible"
            said @ true

    assert said == link_flags.apple(t.target)
    assert !process.remove_tree(t.build).is_err()

test "a Linux link holds its libraries in one group, and an Apple link holds none (panel 238)"
    none: [str] = []
    linux = link_line(
        objects: ["a.o"],
        level: "-O0",
        sanitize: false,
        target: "aarch64-unknown-linux-gnu",
        search_library: none,
        pkgconfig_flags: ["-lp"],
        link_names: ["top", "base"]
    )
    assert linux.slice(from: linux.len() - 5, to: linux.len()) == ["-Wl,--start-group", "-lp", "-ltop", "-lbase", "-Wl,--end-group"]
    apple = link_line(
        objects: ["a.o"],
        level: "-O0",
        sanitize: false,
        target: "arm64-apple-darwin25.6.0",
        search_library: none,
        pkgconfig_flags: ["-lp"],
        link_names: ["top", "base"]
    )
    assert apple.slice(from: apple.len() - 4, to: apple.len()) == ["a.o", "-lp", "-ltop", "-lbase"]

    # A link with no library holds no group.
    bare = link_line(
        objects: ["a.o"],
        level: "-O0",
        sanitize: false,
        target: "aarch64-unknown-linux-gnu",
        search_library: none,
        pkgconfig_flags: none,
        link_names: none
    )

    for word in bare
        assert word != "-Wl,--start-group"

# **A library that needs another links in every order the program's words
# give it** (panel 238's R3; defects 2365 and 2366): `libtop.a`, whose
# `top_value` calls `base_helper`, and `libbase.a`, which defines it and
# `base_other` in two objects, archived by the machine's own `ar` and linked
# in five shapes: two `link` names in both orders (panel 238's `dep_written`
# and `dep_sorted`, and one module's two groups), a package's words before a
# `link` name (its `lp_*`, where the package's words stand first whatever
# the order written), and two packages' words in both orders (its `pp_*`). On
# GNU ld three of the five were *undefined reference to `base_helper'* until
# the group (the `heroes-linux-arm64` container, 2026-11-08); ld64 links all
# five bare. **Two objects, as panel 238's `libbase.a` was**: a link that
# takes `base_other`'s member leaves `base_helper`'s to a later search, which
# GNU ld makes only in a group; with the two in one object every shape linked
# without the words, and this test passed on a compiler that wrote none (lane
# b26-link's falsifier, `groups_libraries` answering false, in the
# container). **And a sixth, beside defect 2366**: a package's whole answer,
# `-pthread` and `-Wl,-rpath,<dir>` among the words `libraries.link_words`
# passes on, standing in the group before a `link` name, which GNU ld 2.44
# links (lane b26-link, the container: `lp_pthread` built and printed `41 2`,
# and an `lp_*` program did under `run`, `test` and `--sanitize`). Not asked
# on Windows, where no group stands and an archive made by `ar` is unrun.
test "a library that needs another links in every order its words are written in (panel 238; defects 2365 and 2366)"
    if process.exe_suffix() == ".exe"
        return
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-link-groups-" + process.pid().to_str()
    dir = t.build
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    said = dir + "/said.txt"
    sources = [
        ["top", "int base_helper(void);\nint top_value(void);\nint top_value(void) { return base_helper() + 1; }\n"]
        ["base_helper", "int base_helper(void);\nint base_helper(void) { return 40; }\n"]
        ["base_other", "int base_other(void);\nint base_other(void) { return 2; }\n"]
        ["main", "int top_value(void);\nint base_other(void);\nint main(void) { return top_value() == 41 && base_other() == 2 ? 0 : 1; }\n"]
    ]

    for one in sources
        assert !write_file(path: dir + "/" + one[0] + ".c", text: one[1]).is_err()
        made = process.run(
            program: "clang",
            words: ["clang", "-c", "-fPIC", dir + "/" + one[0] + ".c", "-o", dir + "/" + one[0] + ".o"],
            out: process.discard(),
            err: said
        )
        assert made.started && made.code == 0

    for members in [["top", "top"], ["base", "base_helper", "base_other"]]
        words: [str] @= ["ar", "rcs", dir + "/lib" + members[0] + ".a"]

        for member in members.slice(from: 1, to: members.len())
            words @ words.push(dir + "/" + member + ".o")

        archived = process.run(program: "ar", words: words, out: process.discard(), err: said)
        assert archived.started && archived.code == 0

    lib = "-L" + dir
    none: [str] = []
    names = [["top", "base"], ["base", "top"], ["top"], none, none, ["top"]]
    pkgconfigs = [
        none
        none
        [lib, "-lbase"]
        [lib, "-ltop", lib, "-lbase"]
        [lib, "-lbase", lib, "-ltop"]
        [lib, "-pthread", "-Wl,-rpath," + dir, "-lbase"]
    ]

    for at in range(from: 0, to: names.len())
        binary = link_objects(
            t,
            objects: [dir + "/main.o"],
            module: "groups" + at.to_str(),
            output: ok(dir + "/shape-" + at.to_str()),
            level: "-O0",
            sanitize: false,
            search_library: [dir],
            pkgconfig_flags: pkgconfigs[at],
            link_names: names[at],
            judging: supplied.nothing()
        )

        # The linker's words where a shape does not link, read in the failure.
        assert units.failure_text(binary) == ""
        ran = process.run(
            program: binary.must(),
            words: [binary.must()],
            out: process.discard(),
            err: process.discard()
        )
        assert ran.started && ran.code == 0

    assert !process.remove_tree(dir).is_err()
