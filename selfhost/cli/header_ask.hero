# The one clang run a refused round makes to ask the header about the names
# the program declared (design.md §4.19; defect 152, 2026-10-02):
# `emit/ffi_asked.hero` writes the unit and reads clang's answer, and this
# file is the run between them, beside the pointee check's and under the
# same include search, so the questions are asked of the headers the round
# compiled.
#
# Three things it does not do. It never fails a build: a unit it could not
# write or a clang it could not start answers nothing, and the round's own
# verdict stands as it would have. It caches nothing, since only a build that
# has already failed asks. And it prints nothing: what clang said reaches the
# author only as a diagnostic `emit/ffi.hero` makes of it.

use source
use cli/compile
use cli/toolchain
use cli/process
use cli/publish
use cli/compiling
use cli/strings
use emit/ffi_asked
use emit/ffi_lookup
use cli/input
use library_source

# Ask, once, under the words every probe compiles under
# (`compiling.probe_words`). `-ferror-limit=0` because every question that
# answers is an error line, and clang stops at twenty by default;
# `-fno-caret-diagnostics` because a line of the unit echoed under its answer
# is nothing a reader should be handed. `struct_tags` is what the rounds
# learned, so a call the unit makes spells a handle as theirs did.
function ask(t: toolchain.Toolchain, art: compile.Artifact, s: source.Source, under: compiling.Compiling, struct_tags: {str: bool}) -> ffi_asked.Asked
    unit = publish.private_name(t.build + "/header-ask") + ".c"
    err = publish.private_name(t.build + "/header-ask-stderr.txt")

    if write_file(path: unit, text: ffi_asked.unit(art.program, s, art.decls, art.checked, struct_tags: struct_tags)).is_err()
        return ffi_asked.nothing()
    line = strings.with_all(
        list: ["clang", "-fsyntax-only", "-ferror-limit=0", "-fno-caret-diagnostics"],
        more: compiling.probe_words(under)
    )
    ran = process.run(program: "clang", words: line.push(unit), out: process.discard(), err: err)
    said = read_file(err)
    publish.discard(unit)
    publish.discard(err)

    if !ran.started || said.is_err()
        return ffi_asked.nothing()
    return ffi_asked.read(said.must())

## Tests

# The defect's own declaration, asked of the real `errno.h`: what is said
# again lands on the declaration's line, and `errno` is no value. `BUFSIZ`,
# `#define`d to a number in `stdio.h` on every libc, is one.
test "a refused round's question is asked of the real header (defect 152)"
    library = library_source.text()
    text = "extern \"errno.h\"\n    function errno() -> i32\n\nextern \"stdio.h\"\n    function BUFSIZ() -> i64\n\nfunction main()\n    print(errno())\n"
    assert !write_file(path: "build/selftest_header_ask.hero", text: text).is_err()
    s = input.read_compilation(path: "build/selftest_header_ask.hero", library: library).must()
    none: [str] = []
    options = compile.Options(
        level: "-O0",
        dump_ir: false,
        emit_c: true,
        output: fail(code: "none", msg: "no output"),
        sanitize: false,
        target: .program_build,
        headers_from: none,
        library: none
    )
    art = compile.to_unit(s, options, version: "0.0.0-port").must()
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-header-ask").must()
    no_tags: {str: bool} = {}
    got = ask(
        t,
        art,
        s,
        under: compiling.Compiling(level: "-O0", sanitize: false, search_include: none, package_flags: none, runtime: t.runtime, source_dir: "build"),
        struct_tags: no_tags
    )
    assert ffi_lookup.has(text: got.said, needle: "build/selftest_header_ask.hero:2:")
    assert ffi_lookup.has(text: got.said, needle: "called object type")
    assert !got.values["BUFSIZ"].is_err()
    assert got.values["errno"].is_err()

    # `errno` is a macro over an object on every libc this compiler targets.
    assert !got.macros["errno"].is_err()

# **A refused round's questions are asked under the build's level and
# sanitizers** (defect 167). The header makes `thing` a value macro when
# optimised and when sanitised, and a function otherwise: asked as `-O0`
# reads it, neither a macro nor a value; asked as `-O2` and as `--sanitize`
# read it, both, which is what the program's own compile meets. Measured
# before this repair: at `-O2` the round's refusal of `thing()` had no
# answer to be told by and the build stopped at exit 2, clang's text.
test "a refused round's questions are asked under the build's level and sanitizers (defect 167)"
    library = library_source.text()
    dir = "build/selftest-header-ask-level"
    assert !process.mkdir_all(dir).is_err()
    header = "#if defined(__OPTIMIZE__) || __has_feature(address_sanitizer)\n#define thing 5\n#else\nint thing(void);\n#endif\n"
    assert !write_file(path: dir + "/lvl.h", text: header).is_err()
    text = "extern \"lvl.h\"\n    function thing() -> i32\n\nfunction main()\n    print(thing())\n"
    assert !write_file(path: dir + "/p.hero", text: text).is_err()
    s = input.read_compilation(path: dir + "/p.hero", library: library).must()
    none: [str] = []
    options = compile.Options(
        level: "-O0",
        dump_ir: false,
        emit_c: true,
        output: fail(code: "none", msg: "no output"),
        sanitize: false,
        target: .program_build,
        headers_from: none,
        library: none
    )
    art = compile.to_unit(s, options, version: "0.0.0-port").must()
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-header-ask").must()
    no_tags: {str: bool} = {}
    plain = ask(
        t,
        art,
        s,
        under: compiling.Compiling(level: "-O0", sanitize: false, search_include: none, package_flags: none, runtime: t.runtime, source_dir: dir),
        struct_tags: no_tags
    )
    assert plain.macros["thing"].is_err()
    assert plain.values["thing"].is_err()

    for sanitize in [false, true]
        level: str @ "-O2"

        if sanitize
            level @ "-O0"
        under = compiling.Compiling(
            level: level,
            sanitize: sanitize,
            search_include: none,
            package_flags: none,
            runtime: t.runtime,
            source_dir: dir
        )
        read_so = ask(t, art, s, under: under, struct_tags: no_tags)
        assert !read_so.macros["thing"].is_err()
        assert !read_so.values["thing"].is_err()

# **A refused round asks the type of each result and each constant**
# (defect 186): `hero_wide` declared `-> i32` is refused by its return
# assertion, and the question names `hero_wide_t`, as the header spells it,
# and `long long` after it; `HERO_SMALL`, `#define`d to a number, is an
# `int`. A header of the test's own, because a library function clang
# knows as a builtin, `strlen`, comes back as its canonical type alone,
# `unsigned long` and not `size_t`, measured on this Mac's clang 21.
test "a refused round's question names the type the header gives a result and a constant (defect 186)"
    library = library_source.text()
    dir = "build/selftest-header-ask-result"
    assert !process.mkdir_all(dir).is_err()
    header = "typedef long long hero_wide_t;\nstatic inline hero_wide_t hero_wide(void) { return 1; }\n#define HERO_SMALL 2\n"
    assert !write_file(path: dir + "/wide.h", text: header).is_err()
    text = "extern \"wide.h\"\n    function hero_wide() -> i32\n    constant HERO_SMALL: i64\n\nfunction main()\n    print(hero_wide())\n    print(HERO_SMALL)\n"
    assert !write_file(path: dir + "/p.hero", text: text).is_err()
    s = input.read_compilation(path: dir + "/p.hero", library: library).must()
    none: [str] = []
    options = compile.Options(
        level: "-O0",
        dump_ir: false,
        emit_c: true,
        output: fail(code: "none", msg: "no output"),
        sanitize: false,
        target: .program_build,
        headers_from: none,
        library: none
    )
    art = compile.to_unit(s, options, version: "0.0.0-port").must()
    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-header-ask").must()
    no_tags: {str: bool} = {}
    got = ask(
        t,
        art,
        s,
        under: compiling.Compiling(level: "-O0", sanitize: false, search_include: none, package_flags: none, runtime: t.runtime, source_dir: dir),
        struct_tags: no_tags
    )
    assert got.results["hero_wide"].must() == ffi_asked.Typed(spelled: "hero_wide_t", canonical: "long long")
    assert got.results["HERO_SMALL"].must().spelled == "int"
