# heroes measure [file] — the spec budget, measured (design.md §1.6).
#
# Port of archive/bootstrap-rs/heroes-cli/src/commands/measure.rs, and the reason it is in
# the port at all: design.md §1.6 names `archive/bootstrap-rs/heroes/src/measure/gate.rs`
# as the budget's live enforcer, so archiving the bootstrap without this
# would make a Part 1 sentence false and leave the ceiling defended by
# nothing (panel 085, the spec-warden's veto).
#
# §1.6 sets a MEASURED budget, and Part 10 has instructed since the first
# draft: *"count it with a real tokeniser, not by estimation — the BPE
# vocabulary contains arbitrary choices nobody predicts."* For two days the
# repository defended the ceiling with a words × 1.33 heuristic, because the
# count was assumed to need an API key. It does not (panel 011): two
# published tables, vendored and offline, do the job, and the first real
# count found the spec 33% larger than the heuristic claimed.
#
# TWO INSTRUMENTS, AND THE MAXIMUM BINDS. Neither is the tokeniser of the
# model that actually reads the spec — that one is unpublished. Two tables
# disagreeing is the honest error bar, so the report prints both and the
# verdict uses the larger.
#
# WHERE THE TABLES COME FROM, and it is the one thing the port had to decide
# for itself. The Rust resolves the repository root at COMPILE time
# (`CARGO_MANIFEST_DIR`), which a Heroes program cannot do and should not
# want to: panel 085 R5 measured what that class of trick costs when it
# fails — the port read its standard library from `archive/bootstrap-rs/` at run time,
# and outside the repository every program was refused on the AUTHOR's line.
# So the tables are read relative to the working directory, and their
# absence is exit 2 in the tool's own name, never a silent empty table. That
# is honest here in a way it would not be elsewhere: what this command
# measures by default is `spec/heroes-spec.md`, a file in this repository,
# so a run outside the repository has no question to answer.

use cli/io
use cli/argv
use cli/digest
use measure/pinned
use cli/table as cli_table
use measure/vendored
use measure/judged as budgets

function run(inv: argv.Invocation) -> cli_table.Exit
    path = inv.file.default(budgets.SPEC)
    text = read_file(path)

    if text.is_err()
        io.eprint(text: "error: cannot read `" + path + "`")
        return .failed_exit

    # **The vendored reading is taken BEFORE the refresh branch, since
    # 2026-09-12, and the order is the feature.** `--refresh` records the
    # contract's vendored count beside its real one (panel 134's replacement for
    # a digest it refused), so the offline tables must already have been read
    # when that branch is reached. It costs the spec's refresh two table reads it
    # does not use, which is milliseconds against a network round trip.
    readings = vendored.readings_of(text.must())

    if readings.is_err()
        io.eprint(text: "error: " + vendored.why(readings))
        return .failed_exit

    if argv.has(inv, spelling: "--refresh")
        return pinned.run_refresh(
            path: path,
            text: text.must(),
            spec: budgets.SPEC,
            contract: budgets.CONTRACT,
            vendored: vendored.highest(readings.must())
        )
    return reported(path: path, here: digest.digest(text.must()), readings: readings.must())

# The report, byte for byte the bootstrap's: two readings, the binding
# number, the spread, and the verdict against the ceiling. A breach is
# exit 1 — the input has something wrong with it — while an unreadable file
# is exit 2, the tool unable to run (panel 016's contract).
function reported(path: str, here: str, readings: [vendored.Reading]) -> cli_table.Exit
    print(path)
    highest: i64 @ 0
    lowest: i64 @ -1

    for one in readings
        print(
            "  " + padded(text: one.instrument, width: 16) + " " + aligned(number: one.tokens, width: 6) + "   (" + one.vocabulary.to_str() + " ranks)"
        )

        if one.tokens > highest
            highest @ one.tokens

        if lowest == -1 || one.tokens < lowest
            lowest @ one.tokens

    if lowest == -1
        lowest @ 0
    spread = highest - lowest
    percent: i64 @ 0

    if highest > 0
        percent @ spread * 100 / highest
    print(
        "  " + padded(text: "maximum", width: 16) + " " + aligned(number: highest, width: 6) + "   a lower bound, not the reader's tokeniser"
    )
    print(
        "  " + padded(text: "spread", width: 16) + " " + aligned(number: spread, width: 6) + "   between the two vendored tables (" + percent.to_str() + "%) — the gap between two REAL tokeniser generations was 967"
    )

    if path == budgets.SPEC
        if here != pinned.SPEC_DIGEST
            print("")
            print("STALE: the recorded count is for " + pinned.SPEC_DIGEST + " and this file is " + here + ".")
            print("Run `heroes measure " + path + " --refresh` and paste what it prints.")
            print("No verdict is given against a stale count: that is the sentence that")
            print("spent 998 tokens nobody had (docs/measurements/023).")
            return .diagnostics_exit
        print(
            "  " + padded(text: "real", width: 16) + " " + aligned(number: pinned.SPEC_REAL_TOKENS, width: 6) + "   " + pinned.SPEC_REAL_MODEL + ", " + pinned.SPEC_REAL_TAKEN + " — the binding number"
        )

    # **The contract's staleness is answered by DRIFT and not by a digest**, and
    # the difference is measured rather than stylistic (panel 134). A digest
    # withholds the verdict whenever a byte changes, which costs the spec nothing
    # — an edit there already needs a panel and a ledger row — but `CLAUDE.md`
    # took 34 commits in seven days against the spec's 17, so a digest here would
    # withhold the verdict about thirty-four times a week, each time clearable
    # only by a network refresh and NOT clearable at all on a fork PR. The
    # vendored count moves with the document, costs no key and no socket, and a
    # drift past the gate's own width is exactly the condition under which the
    # recorded real number stops being about this document.
    if path == budgets.CONTRACT
        drift = highest - pinned.CONTRACT_TOKENS

        moved = if drift < 0
            0 - drift
        else
            drift

        if moved > budgets.DELTA_GATE
            print("")
            print("STALE: the recorded real count was taken when the vendored reading was")
            print(
                pinned.CONTRACT_TOKENS.to_str() + " and it is " + highest.to_str() + " now, " + moved.to_str() + " away against a window of " + budgets.DELTA_GATE.to_str() + "."
            )
            print("Run `heroes measure " + path + " --refresh` and paste what it prints,")
            print("and say in the commit body what was added and what paid for it — a rule")
            print("moved into .claude/rules/, into the case law, or into a skill.")
            print("The ceiling watches the LEVEL and this watches the MOVEMENT: it bounds")
            print("attribution rather than size, so every increase carries a name (panel 134).")
            return .diagnostics_exit
        print(
            "  " + padded(text: "real", width: 16) + " " + aligned(number: pinned.CONTRACT_REAL_TOKENS, width: 6) + "   " + pinned.CONTRACT_REAL_MODEL + ", " + pinned.CONTRACT_REAL_TAKEN + " — the binding number"
        )
    print("")

    # A PATH WITH NO REGISTERED CEILING IS NOT JUDGED, and saying so is the
    # repair panel 133 filed (2026-09-12). Until that day this branch weighed
    # the VENDORED maximum against `CEILING`, which has been a `claude-opus-5`
    # REAL number since 2026-09-09 — the wrong ceiling and the wrong scale at
    # once, the scale error being the 26% gap the spec itself shows (5716 real
    # against 4521 vendored). So `heroes measure design.md` answered **"BREACH:
    # 64490 over the 6144-token ceiling (design.md §1.6)"** and exited 1, while
    # §1.6 says in its own words that *"The spec has a budget; the compiler does
    # not"*. A false verdict, citing the section that refutes it. The other half
    # was quieter and worse: a draft measured here printed "Headroom: 3241", a
    # number a later session could quote as permission to spend it.
    #
    # The sentence printed instead is the one `run_refresh` below already gives
    # for the same reason, and the two now agree.
    if path != budgets.SPEC && path != budgets.CONTRACT
        print("No ceiling judges `" + path + "` and no check keeps it honest")
        print("(panel 123 R5), so this is a count and not a verdict.")
        print("The two documents that are judged are `" + budgets.SPEC + "` and `" + budgets.CONTRACT + "`.")
        return .ok_exit

    # **BOTH judged documents are judged on the READER's count, since
    # 2026-09-12.** `weighed` opened at the vendored `highest` and only the spec
    # overwrote it, so the contract was weighed on OpenAI's larger table against
    # a ceiling nobody had set on that scale — 5491 against 5500 while the real
    # number was 7306. There is no vendored branch left here on purpose: a
    # fallback to `highest` is how the old answer would come back for whichever
    # document somebody forgot.
    ceiling: i64 @ budgets.CEILING
    weighed: i64 @ pinned.SPEC_REAL_TOKENS

    if path == budgets.CONTRACT
        ceiling @ budgets.CONTRACT_CEILING
        weighed @ pinned.CONTRACT_REAL_TOKENS

    if weighed > ceiling
        print("BREACH: " + weighed.to_str() + " over the " + ceiling.to_str() + "-token ceiling (design.md §1.6).")
        print("An amendment must be net-negative, or the ceiling moves — with a")
        print("measurement, a panel, and a named alternative (panel 012).")
        return .diagnostics_exit

    print("An addition needs a named removal or a pre-registered falsifiable")
    print("prediction (panel 012). " + budgets.room(path: path, highest: weighed))
    return .ok_exit

# Left-aligned in `width` columns, counted in characters.
function padded(text: str, width: i64) -> str
    out: str @ text
    count: i64 @ text.chars().len()

    while count < width
        out @ out + " "
        count @ count + 1

    return out

# Right-aligned in `width` columns.
function aligned(number: i64, width: i64) -> str
    shown = number.to_str()
    out: str @ ""
    count: i64 @ shown.chars().len()

    while count < width
        out @ out + " "
        count @ count + 1

    return out + shown

test "a reading is laid out in the bootstrap's own columns"
    readings: [vendored.Reading] = [
        vendored.Reading(instrument: "claude-legacy", vocabulary: 64995, tokens: 3440)
        vendored.Reading(instrument: "cl100k_base", vocabulary: 100256, tokens: 3512)
    ]

    # The verdict is printed, not returned as text — what this pins is the
    # arithmetic and the branch, which is where a port goes wrong.
    verdict = reported(path: "spec/heroes-spec.md", here: pinned.SPEC_DIGEST, readings: readings)
    assert cli_table.exit_code(verdict) == 0

    # And the staleness gate WITHHOLDS rather than computes: a digest that
    # does not match the record is exit 1 with no headroom sentence, which
    # is the whole point of recording one.
    stale = reported(path: "spec/heroes-spec.md", here: "beefbeefbeefbeef", readings: readings)
    assert cli_table.exit_code(stale) == 1

test "the columns are the bootstrap's widths"
    assert padded(text: "claude-legacy", width: 16) == "claude-legacy   "
    assert padded(text: "a name past the width", width: 4) == "a name past the width"
    assert aligned(number: 3440, width: 6) == "  3440"
    assert aligned(number: 0, width: 6) == "     0"
    assert aligned(number: 1234567, width: 6) == "1234567"

test "a breach is exit 1, a clean measurement is exit 0, and an unjudged path is neither"
    # **The contract is judged on its RECORDED real count, not on the readings
    # it is handed**, since 2026-09-12 — so a synthetic reading no longer moves
    # the verdict, and the drift check decides whether a verdict is given at all.
    # A reading at the pin is fresh, and the verdict is then the one the record
    # earns: `CONTRACT_REAL_TOKENS` against `CONTRACT_CEILING`, which is clean
    # today and is asserted as such rather than assumed.
    fresh: [vendored.Reading] = [vendored.Reading(instrument: "one", vocabulary: 1, tokens: pinned.CONTRACT_TOKENS)]
    assert pinned.CONTRACT_REAL_TOKENS < budgets.CONTRACT_CEILING
    assert cli_table.exit_code(reported(path: budgets.CONTRACT, here: "unused", readings: fresh)) == 0

    # **And a document that has MOVED gets no verdict, which is the digest's job
    # done by the vendored count** (panel 134). One token inside the window is
    # still a verdict; one past it withholds, exit 1, with the two numbers in the
    # message. This is the case that proves the window is read, and it is written
    # as a pair because a check that only ever sees one side of its own threshold
    # is a check nobody has tested.
    edge: [vendored.Reading] = [
        vendored.Reading(instrument: "one", vocabulary: 1, tokens: pinned.CONTRACT_TOKENS + budgets.DELTA_GATE)
    ]
    assert cli_table.exit_code(reported(path: budgets.CONTRACT, here: "unused", readings: edge)) == 0
    drifted: [vendored.Reading] = [
        vendored.Reading(instrument: "one", vocabulary: 1, tokens: pinned.CONTRACT_TOKENS + budgets.DELTA_GATE + 1)
    ]
    assert cli_table.exit_code(reported(path: budgets.CONTRACT, here: "unused", readings: drifted)) == 1

    # It drifts in BOTH directions: a contract that shrank past the window is as
    # unmeasured as one that grew, and an unsigned subtraction would have missed
    # exactly this half.
    shrunk: [vendored.Reading] = [
        vendored.Reading(instrument: "one", vocabulary: 1, tokens: pinned.CONTRACT_TOKENS - budgets.DELTA_GATE - 1)
    ]
    assert cli_table.exit_code(reported(path: budgets.CONTRACT, here: "unused", readings: shrunk)) == 1

    # **The repair of 2026-09-12, and this pair is the defect itself.** Both
    # lines above read `path: "x"` until that day, which is why nobody noticed
    # that an arbitrary path was being judged at all: the test asserted the
    # broken behaviour and passed. A path no ceiling covers is COUNTED and never
    # judged, however large — `design.md` measured 64490 and was told it had
    # breached §1.6, the section that says the compiler has no budget.
    huge: [vendored.Reading] = [vendored.Reading(instrument: "one", vocabulary: 1, tokens: budgets.CEILING * 10)]
    assert cli_table.exit_code(reported(path: "design.md", here: "unused", readings: huge)) == 0
    assert cli_table.exit_code(reported(path: "x", here: "unused", readings: huge)) == 0

test "no operand measures the spec, and an unreadable file is the tool failing"
    # The whole pipeline, on the real tables and the real spec: this is the
    # one test here that costs a second, and it is the one that would have
    # caught every mistake in the two modules under it.
    none: str? = fail(code: "no_operand", msg: "measure was given no file")
    assert cli_table.exit_code(run(asked(none))) == 0
    named: str? = ok("no/such/file.md")
    assert cli_table.exit_code(run(asked(named))) == 2

    # And a file that is not the spec is refused BEFORE the network, which is
    # the half of `--refresh` a test can reach without a key: `.env` is not
    # here, and the refusal above happens on the path rather than on the key.
    other: str? = ok(budgets.CONTRACT)
    refused: [argv.FlagHit] = [argv.FlagHit(spelling: "--refresh", value: fail(code: "none", msg: "plain"))]
    asking = argv.Invocation(tag: .measure_cmd, file: other, program_args: [], flags: refused)
    assert cli_table.exit_code(run(asking)) == 2

# An invocation with no flags, which is what `measure` was until `--refresh`.
function asked(file: str?) -> argv.Invocation
    return argv.Invocation(tag: .measure_cmd, file: file, program_args: [], flags: [])

# The recorded model and the pinned model are two different facts and they
# must agree: `PINNED_MODEL` is who `--refresh` asks, `pinned.REAL_MODEL` is who
# answered the number in the record. A drift between them is a record
# attributed to the wrong tokeniser, which is the whole class this machinery
# exists to close.
