# What is at a path, and a file replaced whole: the machine's half of
# rewriting a file whose name the author gave (design.md §1.12, §3.1; defect
# 136). Where a write lands once its links are followed, the place a path
# names as the filesystem resolves it (defect 2474), what is there, whether
# it may be written, and a new file staged with the old one's identity and
# then put in its place. The C is `runtime/parts/replace.c`,
# which carries why each call exists and what was measured; the policy that
# asks these questions, and the words said when one refuses, are
# `cli/publish.hero`'s.
#
# Split out of `cli/process.hero` on 2026-09-30, the day these calls took it
# past §11's 300 lines: `process` is how the compiler reaches the machine in
# general, and this is the one question with a part of the runtime of its own.

use cli/process

# `lent` on every path: each call reads it while it runs and keeps nothing
# of it (panel 171).
extern "hero_os.h"
    function hero_fs_landing(path: cstr lent) -> str
    function hero_fs_resolved_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_kind(path: cstr lent) -> i64
    function hero_fs_links(path: cstr lent) -> i64
    function hero_fs_writable(path: cstr lent) -> i64
    function hero_file_stage(staged: cstr lent, text: str, like: cstr lent) -> i64
    function hero_fs_replace(staged: cstr lent, path: cstr lent) -> i64
    function hero_fs_flush(path: cstr lent) -> i64
    function hero_file_unstage(staged: cstr lent) -> i64
    function hero_fs_mode(path: cstr lent) -> i64
    function hero_fs_set_mode(path: cstr lent, mode: i64) -> i64
    function hero_fs_link(existing: cstr lent, name: cstr lent) -> i64
    function hero_fs_symlink(target: cstr lent, name: cstr lent) -> i64
    function hero_fs_deny_delete(path: cstr lent) -> i64
    function hero_fs_flagged(path: cstr lent) -> i64
    function hero_fs_set_flag(path: cstr lent) -> i64
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_TEXT: i64
    constant HERO_OS_UNSUPPORTED: i64
    constant HERO_FS_ABSENT: i64
    constant HERO_FS_FILE: i64
    constant HERO_FS_DIRECTORY: i64
    constant HERO_FS_LINK: i64
    constant HERO_FS_OTHER: i64
    constant HERO_STAGE_DONE: i64
    constant HERO_STAGE_CREATE: i64
    constant HERO_STAGE_WRITE: i64
    constant HERO_STAGE_OWNER: i64
    constant HERO_STAGE_MODE: i64
    constant HERO_STAGE_ATTRIBUTES: i64
    constant HERO_STAGE_FLUSH: i64
    constant HERO_STAGE_FLAGS: i64

# What is at a path, the link itself where it is one: `other` is what is
# neither a file, a directory nor a link (a device, a FIFO, `NUL`), and
# `unknown` a path the question itself failed on, `process.because()` saying
# why.
variant Entry
    absent
    file
    directory
    link
    other
    unknown

function entry(path: str) -> Entry
    kind = hero_fs_kind(path: path.cstr())

    if kind == HERO_FS_ABSENT
        return .absent

    if kind == HERO_FS_FILE
        return .file

    if kind == HERO_FS_DIRECTORY
        return .directory

    if kind == HERO_FS_LINK
        return .link

    if kind == HERO_FS_OTHER
        return .other
    return .unknown

# Whether what is at `path` is a file, its links followed by the caller.
function is_file(path: str) -> bool
    match entry(path)
        .file                                            => return true
        .absent | .directory | .link | .other | .unknown => return false

# Whether what is at `path` is neither a file, a directory nor a link: a
# device, a FIFO, a socket, `NUL`. Nothing there is renamed over.
function is_special(path: str) -> bool
    match entry(path)
        .other                                          => return true
        .absent | .file | .directory | .link | .unknown => return false

# The file a write to `path` lands in: `path` itself, or the file its chain
# of symbolic links finally names, which need not exist yet. The failure's
# message is the operating system's reason alone, for the caller's sentence.
function landing(path: str) -> str?
    found = hero_fs_landing(path: path.cstr())

    if found.len() == 0
        return fail(code: "no_landing", msg: process.because())
    return ok(found)

# The place `path` names as the filesystem resolves it (defect 2474): whole,
# every symbolic link on the way followed, a folder's and the last part's
# alike, and the parts not there yet written as `path` writes them. A byte
# that is not UTF-8, which a link's target may hold, is written by its value,
# as a walk names such a file, so the answer is a place to ask about and to
# tell, never one to open. The failure's message is the reason alone: a loop
# of links, a folder that cannot be searched, a path too long.
function resolved(path: str) -> str?
    status: i64 @= 0
    marks: i64 @= 0
    found = hero_fs_resolved_shown(path: path.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_OK
        return ok(found)

    if status == HERO_OS_NOT_TEXT
        return ok(process.written_value(answer: found, marks: marks))
    return fail(code: "unresolved", msg: process.because())

# How many names the file at `path` has, following a link; -1 where it
# cannot be asked.
function names_of(path: str) -> i64
    return hero_fs_links(path: path.cstr())

# Whether `path` could be opened for writing, the question `fopen` asked of
# it, without emptying it. The failure's message is the reason alone.
function writable(path: str) -> ()?
    if hero_fs_writable(path: path.cstr()) != 1
        return fail(code: "not_writable", msg: process.because())
    return ok()

# `text` into a NEW file at `staged`, flushed to the device, and given the
# owner, group, permission bits, flags, ACL and extended attributes `like`
# has, unless `like` is "". A failure leaves no file at `staged`, and its code
# names the step that failed: `create`, `write`, `owner`, `mode`, `flags`,
# `attributes` or `flush`; its message is the reason alone.
function stage(staged: str, text: str, like: str) -> ()?
    step = hero_file_stage(staged: staged.cstr(), text: text, like: like.cstr())

    if step == HERO_STAGE_DONE
        return ok()
    why = process.because()

    # A step the header names and this does not is said by its number, never
    # passed off as one of these.
    name: str @= "step " + step.to_str()

    if step == HERO_STAGE_FLUSH
        name @ "flush"

    if step == HERO_STAGE_CREATE
        name @ "create"

    if step == HERO_STAGE_WRITE
        name @ "write"

    if step == HERO_STAGE_OWNER
        name @ "owner"

    if step == HERO_STAGE_MODE
        name @ "mode"

    if step == HERO_STAGE_FLAGS
        name @ "flags"

    if step == HERO_STAGE_ATTRIBUTES
        name @ "attributes"
    return fail(code: name, msg: why)

# `staged` put in place of `path` by one rename, and their directory flushed.
# The failure's message is the reason alone.
function replace(staged: str, path: str) -> ()?
    if hero_fs_replace(staged: staged.cstr(), path: path.cstr()) != HERO_OS_OK
        return fail(code: "not_replaced", msg: process.because())
    return ok()

# A file another process wrote, flushed to the device before it is renamed
# into place (defect 357's object row; `runtime/parts/replace.c`'s
# `hero_fs_flush`). The failure's message is the reason alone.
function flush(path: str) -> ()?
    if hero_fs_flush(path: path.cstr()) != HERO_OS_OK
        return fail(code: "not_flushed", msg: process.because())
    return ok()

# A staged file that could not take its place, removed even where it carries
# the ACL that refused the rename (measured: a plain removal left it beside
# the author's file). The failure's message is the reason alone.
function unstage(staged: str) -> ()?
    if hero_file_unstage(staged: staged.cstr()) != HERO_OS_OK
        return fail(code: "not_removed", msg: process.because())
    return ok()

# The permission bits of the file at `path`, following a link, -1 where there
# is none; Windows keeps read-only alone, 0444 or 0666. With `set_mode`, a
# second name and a symbolic link, what a case makes its files with.
function mode_of(path: str) -> i64
    return hero_fs_mode(path: path.cstr())

function set_mode(path: str, mode: i64) -> ()?
    if hero_fs_set_mode(path: path.cstr(), mode: mode) != HERO_OS_OK
        return fail(code: "chmod_failed", msg: "could not change the mode of " + path + process.because())
    return ok()

function second_name(existing: str, name: str) -> ()?
    if hero_fs_link(existing: existing.cstr(), name: name.cstr()) != HERO_OS_OK
        return fail(code: "link_failed", msg: "could not name " + existing + " also " + name + process.because())
    return ok()

function symbolic_link(target: str, name: str) -> ()?
    if hero_fs_symlink(target: target.cstr(), name: name.cstr()) != HERO_OS_OK
        return fail(code: "link_failed", msg: "could not make " + name + " a link to " + target + process.because())
    return ok()

# Two shapes only some platforms have, for the cases, each `ok(false)` where
# this platform or filesystem has no such thing, which a case reads as nothing
# to hold rather than as a failure: an ACL entry denying this user the file's
# deletion (Darwin), and the one flag a rewrite carries that a case can set,
# `nodump` (hidden on Windows), which `flagged` reads back as 1 or 0, or -1
# where it cannot be asked.
function deny_delete(path: str) -> bool?
    return made(answer: hero_fs_deny_delete(path: path.cstr()), what: "deny deleting " + path)

function set_flag(path: str) -> bool?
    return made(answer: hero_fs_set_flag(path: path.cstr()), what: "flag " + path)

function flagged(path: str) -> i64
    return hero_fs_flagged(path: path.cstr())

function made(answer: i64, what: str) -> bool?
    if answer == HERO_OS_UNSUPPORTED
        return ok(false)

    if answer != HERO_OS_OK
        return fail(code: "not_made", msg: "could not " + what + process.because())
    return ok(true)

# Defect 2350: a read-only entry goes with its tree, as `rm -rf` removes it on
# POSIX, where the directory holding a name decides its removal. Windows
# refuses to delete a file or a directory carrying the read-only attribute,
# and git writes every object file 0444, so on the CI's Windows leg 14 of the
# compiler's own tests failed at the removal of a scratch folder holding a
# repository. The modes are set by the runtime's own setter, the attribute on
# Windows: a file deep in a tree and one at its root, an empty directory (one
# holding a name is refused on POSIX, as `rm -rf` refuses it, so only an
# empty one is the same everywhere), a path that is itself a read-only file,
# by `remove_tree` and by `remove_file`, and a link to a read-only file,
# removed as the link while the file it names keeps its text and its mode
# (defect 345), where this machine makes a link (Windows grants one to an
# administrator or in developer mode). POSIX passes it with no repair; the
# Windows leg is the one that judges it.
test "a read-only file or directory is removed with its tree as `rm -rf` removes it, and a link's file keeps its mode (defect 2350)"
    dir = "build/selftest-remove-readonly"
    windows = process.exe_suffix() == ".exe"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir + "/tree/objects/ab").is_err()
    assert !process.mkdir_all(dir + "/tree/empty").is_err()
    assert !write_file(path: dir + "/tree/objects/ab/cdef", text: "blob").is_err()
    assert !write_file(path: dir + "/tree/HEAD", text: "head").is_err()
    assert !write_file(path: dir + "/alone", text: "alone").is_err()
    assert !write_file(path: dir + "/single", text: "single").is_err()
    assert !write_file(path: dir + "/kept", text: "kept").is_err()

    for file in [dir + "/tree/objects/ab/cdef", dir + "/tree/HEAD", dir + "/alone", dir + "/single", dir + "/kept"]
        assert !set_mode(path: file, mode: 0o444).is_err()
        assert mode_of(file) == 0o444

    assert !set_mode(path: dir + "/tree/empty", mode: 0o555).is_err()
    assert mode_of(dir + "/tree/empty") & 0o222 == 0

    # The link's text is the platform's: a Windows link reads `\`.
    up: str @= "../kept"

    if windows
        up @ "..\\kept"
    in_tree = !symbolic_link(target: up, name: dir + "/tree/link").is_err()
    beside = !symbolic_link(target: "kept", name: dir + "/link").is_err()

    # The link itself read-only where the setter reaches it, Windows's
    # attribute; POSIX's `chmod` follows it to `kept`, already 0444.
    if in_tree
        _ = set_mode(path: dir + "/tree/link", mode: 0o444).is_err()

    if beside
        _ = set_mode(path: dir + "/link", mode: 0o444).is_err()
    assert !process.remove_tree(dir + "/tree").is_err()
    assert !process.path_exists(dir + "/tree")
    assert !process.remove_tree(dir + "/alone").is_err()
    assert !process.path_exists(dir + "/alone")
    assert !process.remove_file(dir + "/single").is_err()
    assert !process.path_exists(dir + "/single")
    assert !process.remove_tree(dir + "/link").is_err()
    assert !process.path_exists(dir + "/link")
    assert read_file(dir + "/kept").must() == "kept"
    assert mode_of(dir + "/kept") == 0o444
    assert !process.remove_tree(dir).is_err()
    assert !process.path_exists(dir)

# Defect 2488: a link to a directory reads as one, and is read through, on
# every platform: POSIX's link has no kind of its own, and Windows's is made
# a directory's where its target is one (`runtime/parts/replace.c`). A
# target beside the link, one through `..`, one written with `/` and an
# absolute one; a link to a file and one to nothing are no directory; and a
# tree holding a link to a directory outside it is removed with the link
# alone. Where this machine makes no link (Windows without the privilege)
# there is nothing to hold; the CI's Windows leg is the one that judges it.
test "a link to a directory reads as one and is read through, whatever its target's shape (defect 2488)"
    dir = "build/selftest-link-kind-2488"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir + "/one/inner").is_err()
    assert !process.mkdir_all(dir + "/tree").is_err()
    assert !write_file(path: dir + "/one/inner/x.hero", text: "inside").is_err()
    assert !write_file(path: dir + "/one/f.hero", text: "file").is_err()
    targets = ["inner", "../one/inner", "one/inner", resolved(dir).must() + "/one/inner", "../one/inner"]
    names = [dir + "/one/beside", dir + "/one/up", dir + "/slashed", dir + "/whole", dir + "/tree/out"]

    for at in range(from: 0, to: names.len())
        if !symbolic_link(target: targets[at], name: names[at]).is_err()
            assert entry(names[at]) == .link
            assert process.is_directory(names[at])
            assert read_file(names[at] + "/x.hero").must() == "inside"

    if !symbolic_link(target: "f.hero", name: dir + "/one/file").is_err()
        assert !process.is_directory(dir + "/one/file")
        assert read_file(dir + "/one/file").must() == "file"

    if !symbolic_link(target: "nowhere", name: dir + "/one/dangling").is_err()
        assert !process.is_directory(dir + "/one/dangling")
    assert !process.remove_tree(dir + "/tree").is_err()
    assert !process.path_exists(dir + "/tree")
    assert read_file(dir + "/one/inner/x.hero").must() == "inside"
    assert !process.remove_tree(dir).is_err()
    assert !process.path_exists(dir)
