# The units of one round and their link: one translation unit per module,
# then the link, for `build`, `run` and, since defect 560 (2026-10-10),
# `heroes test`, whose fused unit computed or refused another program than
# `build`. The round that asks the headers before them is
# `cli/rounds.hero`'s, since panel 202 asks each module's apart.
#
# Split out of `cli/produce.hero` on 2026-09-15 (defect 037, panel 152 R1)
# because a round can now be asked for TWICE. The emitter writes a handle's tag
# as the author wrote it — `record AI tag addrinfo` is `addrinfo *` — and
# `netdb.h` declares `struct addrinfo` with no typedef, so clang refuses that
# word with *must use 'struct' tag to refer to type 'addrinfo'*. That message is
# clang's own statement that the word names a struct tag of exactly that
# spelling, and it is the one place the qualifier can be learned without the
# compiler guessing: `produce` reads it off the round's refusals
# (`emit/ffi_tag.hero`'s `needs_struct`), adds the tag to `struct_tags`, and
# asks for the round again. Everything a round needs and does not decide rides
# in `Site`, so two rounds cannot differ in anything but that set.
#
# **Why a second clang run and not a probe or a header dump.** Panel 151
# measured that a spelling read FROM the header can no longer disagree with it:
# `record Db tag sqlite3_stmt` gives two `error[ffi_parameter_type]` today and
# zero under that route. Panel 152 measured that one bit — does this word
# compile with `struct` in front? — is answered yes for a misspelled tag too,
# because `struct nosuchtype *p;` is legal C. So the author's word is compiled
# first, every refusal clang would make of it stands, and only clang's own
# request for `struct` is obeyed. A program whose tags need no qualifier never
# reaches the second round and pays nothing.

use source
use module/names as module_names
use cli/compile
use cli/toolchain
use cli/units
use cli/link
use cli/probing
use cli/compiling
use emit/unit
use emit/members
use emit/lend_local

# What one build has settled before any round runs. Where the binary lands
# is not among it: under `build/` that is named by the link line, which a
# round learns (`link.link_objects`); `output` is the author's `-o`.
record Site
    object: str
    output: str?
    # Whether the round LINKS after it compiles. `--emit-c` says no (defect
    # 049, 2026-09-17): a tag's spelling is learned at the compile, where clang
    # says *must use 'struct' tag*, and a module with no `main` — every
    # `tests/golden/ir/` fixture — has C worth handing out and no binary to
    # link. With the link on, eighteen of them died at exit 2, *Undefined
    # symbols: _main*, the compiler blaming itself for a legal program.
    link: bool
    source_dir: str
    link_names: [str]
    package_flags: [str]
    version: str

# What a round came back with: the verdict, and EVERY clang refusal it met and
# not only the first. A program of several modules may need `struct` on a tag in
# each, and every dirty TU is compiled before any verdict (panel 093 R5), so one
# round can learn them all and the second is the last. `modules` are those
# whose check or unit the verdict is (`cli/header_ask.hero` asks their headers).
record Round
    verdict: ()?
    refusals: [str]
    binary: str
    modules: [str]

# What the checks hand the units: each counted parameter's unit, the probes'
# digests of what they read (each round's memo starts from them, defect 416),
# and a pointee dump that did not compile, refused once the units compile and
# before anything links (`cli/pointee.hero`).
record Lent
    units: {str: str}
    digests: {str: str}
    unread: ()?
    unread_modules: [str]

# The verdict of a round whose units compiled, before its link: a pointee dump
# that did not compile is its refusal, told as clang's words, which `#line`
# put on the declaration each question is asked of.
function unread_round(lent: Lent) -> Round?
    if !lent.unread.is_err()
        return fail(code: "none", msg: "every dump compiled")
    refused: ()? = fail(code: "clang", msg: failure_message(lent.unread))
    return ok(Round(verdict: refused, refusals: messages_of(refused), binary: "", modules: lent.unread_modules))

# What every probe of this build compiles the program's headers under
# (`cli/compiling`): the level, the sanitizers, the `--include`
# directories, the package's answer, the runtime and the source's own
# directory, the ones its units are compiled with (defect 167). One place
# builds it, so the round's two checks, the artifact's and a refused round's
# questions ask under the same words.
function compiled_under(t: toolchain.Toolchain, options: compile.Options, site: Site) -> compiling.Compiling
    return compiling.Compiling(
        level: options.level,
        sanitize: options.sanitize,
        search_include: options.headers_from,
        package_flags: site.package_flags,
        runtime: t.runtime,
        source_dir: site.source_dir
    )

# One .c per module (panel 093): each TU compiled to its own cached object,
# every dirty TU before any verdict (R5), one link over all of them re-run
# every build.
function per_module(t: toolchain.Toolchain, options: compile.Options, art: compile.Artifact, s: source.Source, site: Site, planned: probing.Planned, struct_tags: {str: bool}, lent: Lent, @told: {str: bool}) -> Round
    root = module_names.module_of(s.name)
    objects: [str] @ [site.object]
    stopped: ()? @ ok()
    stopped_in: [str] @ []
    refusals: [str] @ []

    # The whole-program tables, built once for the whole BUILD rather than
    # once per TU (`cli/probing.hero`); a round renames only what it learned,
    # a tag and each counted parameter's unit. 157 modules used to buy 157
    # identical answers — and the arena walk and the content hashing behind
    # them is what made the per-module self-build take longer than the fused
    # one.
    whole = members.retold(
        planned.whole,
        art.program,
        c: art.checked,
        s: s,
        decls: art.decls,
        struct_tags: struct_tags,
        lend_units: lend_local.with_flows(lent.units, art.program, art.checked)
    )

    # One build's answers about files on disk. Every TU asks whether the
    # headers it read still say the same thing, and 157 of them share
    # almost all of those headers — so the map is threaded through the loop
    # rather than rebuilt per unit. It starts from the probes' own digests
    # (defect 416), the same build's answers about the same headers.
    memo: {str: str} @ lent.digests

    for plan in planned.plans
        component = plan.module
        tu_text = unit.unit(
            plan: plan,
            p: art.program,
            c: art.checked,
            s: s,
            decls: art.decls,
            version: site.version,
            is_root: component == root,
            whole: whole
        )
        made = units.tu_object(
            t,
            module: component,
            tu_text: tu_text,
            level: options.level,
            sanitize: options.sanitize,
            search: compile.search_key(headers_from: options.headers_from, library: options.library),
            package_flags: site.package_flags,
            source_dir: site.source_dir,
            search_include: options.headers_from,
            @memo,
            @told
        )

        if made.is_err()
            refusals @ refusals.push(failure_of(made))

            # The FIRST failure is the verdict, as before; the rest are kept
            # for what they may teach about a tag.
            if !stopped.is_err()
                stopped @ carry_failure(made)
                stopped_in @ [component]
        else
            objects @ objects.push(made.must())

    if stopped.is_err()
        return Round(verdict: stopped, refusals: refusals, binary: "", modules: stopped_in)
    unread = unread_round(lent)

    if !unread.is_err()
        return unread.must()

    # Every TU compiled and none refused: for a build that does not link, that
    # IS the verdict, and the refusals it met are what a tag round reads.
    if !site.link
        return Round(verdict: ok(), refusals: refusals, binary: "", modules: [])
    return linked_round(
        t,
        options,
        site,
        objects: objects,
        module: root,
        modules: probing.every_module(planned.probings)
    )

# The link over a round's objects, and the round it makes: its verdict, the
# refusal that verdict is, and where the binary landed. A link's refusal is
# no one unit's, so `modules` are every one.
function linked_round(t: toolchain.Toolchain, options: compile.Options, site: Site, objects: [str], module: str, modules: [str]) -> Round
    linked = link.link_objects(
        t,
        objects: objects,
        module: module,
        output: site.output,
        level: options.level,
        sanitize: options.sanitize,
        search_library: options.library,
        package_flags: site.package_flags,
        link_names: site.link_names
    )
    return Round(
        verdict: carry_failure(linked),
        refusals: refusals_of(linked),
        binary: linked.default(""),
        modules: modules
    )

# The message of a failed `()?`, as the one-element list a round's refusals
# are; empty for a verdict that is not a failure.
function messages_of(verdict: ()?) -> [str]
    match verdict
        .ok    => return []
        .err e => return [e.msg]

function failure_message(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# A fallible path's refusal as the one-element list a round's refusals are;
# empty for a path that came back.
function refusals_of(made: str?) -> [str]
    match made
        .ok    => return []
        .err e => return [e.msg]

# A TU object's failure, re-shaped for the link result the caller reads:
# same code (the exit), same message (clang's words, which the ffi mapping
# reads).
function carry_failure(failed: str?) -> ()?
    match failed
        .ok    => return ok()
        .err e => return fail(code: e.code, msg: e.msg)

function failure_of(failed: str?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

## Tests

test "a round's refusals are its failures' words, and a clean verdict has none"
    clean: ()? = ok()
    assert messages_of(clean).len() == 0
    refused: ()? = fail(code: "clang", msg: "main.c:8:1: error: must use 'struct' tag to refer to type 'addrinfo'")
    assert messages_of(refused) == ["main.c:8:1: error: must use 'struct' tag to refer to type 'addrinfo'"]
    made: str? = fail(code: "clang", msg: "refused")
    assert failure_of(made) == "refused"
    assert carry_failure(made).is_err()
    fine: str? = ok("a.o")
    assert failure_of(fine) == ""
    assert !carry_failure(fine).is_err()
