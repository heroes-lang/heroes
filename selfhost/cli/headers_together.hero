# Two headers two groups name, which clang refuses together (design.md §4.17,
# §4.19; defect 538, panel 200's R1). A unit includes every header its
# groups name before a line of its own, a module's unit as `build` and, since
# defect 560, `heroes test` compile it, so two headers each declaring
# one C name another way, a `static inline twice` of `long` in one and of
# `int` in the other, are read together there, and clang's first error lands
# in whichever came second, its note in the other. Until 2026-10-09 that was
# told as the second header's own refusal, *`b.h` ... does not compile*, where
# each compiles alone, and the header blamed was chosen by the order of the
# program's `use` lines, or of its groups in one module.
#
# So both headers are told, and both groups, in an order that is the headers'
# own (by bytes, as `sort` orders a `str`), never the program's: the same
# words whichever is included first. It stays `ffi_header_refused`'s, exit 1,
# a header the author bound that this unit cannot compile; what `check`,
# `build` and `test` should say of two groups binding one C name with
# different types is a diagnostic class, panel 200 R1's question for a full
# sitting, and this says only what is true of the unit clang refused.

use source
use diag
use token

# One of the two: the group's string, the header as the group wrote it, the
# file clang names as that group's directory shows it, the line, and the line
# as clang quoted it, where it did.
record Side
    span: token.Span
    header: str
    file: str
    row: i64
    quoted: str?

# The diagnostic, on the string of the group whose header sorts first; `added`
# are clang's other notes, already worded.
function told(s: source.Source, one: Side, other: Side, message: str, added: [str]) -> diag.Diagnostic
    first: Side @= one
    second: Side @= other

    if sort([one.header, other.header])[0] != one.header
        first @ other
        second @ one
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_header_refused",
        message: "`" + first.header + "` and `" + second.header + "`, the headers two groups name, cannot be compiled in one unit: clang refuses them together, at " + at_line(first) + between(first) + " and " + at_line(second) + ": " + message,
        span: first.span
    )

    for side in [first, second]
        if !side.quoted.is_err()
            d.notes @ d.notes.push(
                "`" + side.file + "` line " + side.row.to_str() + " reads `" + side.quoted.must() + "`"
            )

    d.notes @ d.notes.push(
        "the other group names `" + second.header + "` at " + source.elsewhere(s, here: first.span.start, there: second.span.start)
    )

    for note in added
        d.notes @ d.notes.push(note)

    d.notes @ d.notes.push(remedy(s, one: first.span, other: second.span))
    return d

# A header clang refused in a unit that compiles alone, and the earlier
# header of the unit whose presence makes it fail, found by compiling the two
# alone (defect 557, `cli/header_alone.hero`): a macro one header defines
# rewrites a name the other declares, in one order. Told on the refused
# group's string.
function after(s: source.Source, refused: Side, earlier: token.Span, earlier_header: str, message: str, added: [str]) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_header_refused",
        message: "`" + refused.header + "`, the header this group names, compiles alone and not after `" + earlier_header + "`, the header another group names, where clang refuses it at " + at_line(refused) + ": " + message,
        span: refused.span
    )

    if !refused.quoted.is_err()
        d.notes @ d.notes.push(
            "`" + refused.file + "` line " + refused.row.to_str() + " reads `" + refused.quoted.must() + "`"
        )
    d.notes @ d.notes.push(
        "the other group names `" + earlier_header + "` at " + source.elsewhere(s, here: refused.span.start, there: earlier.start)
    )

    for note in added
        d.notes @ d.notes.push(note)

    d.notes @ d.notes.push(remedy(s, one: refused.span, other: earlier))
    return d

# What two groups whose headers one unit cannot read together are told to
# do (panel 202's R2, defect 561): bind them from two modules, which is true
# of every shape the sitting measured. Until 2026-10-10 the note said *these
# cannot be compiled in one unit whichever comes first*, false where the
# other order compiles (raymath and raylib, libtasn1 and OpenSSL), and
# offered *a header of your own that declares only what that group binds*,
# which two readers of two could not make work where the other header
# defines the name. Where the groups are two modules' already, the unit is
# `heroes test`'s, or a module's that spells the other's record.
function remedy(s: source.Source, one: token.Span, other: token.Span) -> str
    if source.component_at(s, one.start) == source.component_at(s, other.start)
        return ONE_MODULE
    return TWO_MODULES

# The two remedies, which `cli/header_order.hero` replaces where another
# order of the groups compiles (panel 204's R3).
constant ONE_MODULE: str
    "each group's header is included in the unit clang compiled before a line of its own, so these two are read together there: bind the two groups from two modules, whose units each read their own groups' headers"

constant TWO_MODULES: str
    "the two groups are two modules', and a unit reads both headers where a module's unit spells a record the other group declares"

# Where a side's line is: the file and its line, and the group's header it
# arrives through where the file is another (defect 550), so the words are
# the same whichever header is included first.
function at_line(side: Side) -> str
    if side.file == side.header
        return "`" + side.file + "` line " + side.row.to_str()
    return "`" + side.file + "` line " + side.row.to_str() + ", which `" + side.header + "` includes"

# The comma that closes a side's `which ... includes` before the next.
function between(side: Side) -> str
    if side.file == side.header
        return ""
    return ","
