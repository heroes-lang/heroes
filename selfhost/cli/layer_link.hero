# A refused link missing a name the platform layer's headers declare, told as
# what it is (design.md §1.11, §4.19, §4.17; panel 260's R2 to R4,
# provisional, author ratification pending), asked before every other reader
# of a refused link (`cli/whose.hero`), for every program.
#
# **A program none of whose groups says `layer` links none of the layer**, so
# its link misses the name wherever something it links calls the layer
# without a group saying so: told at the groups linking the library the
# linker says refers to it (R3: a library of the program's compiled against
# the layer, `extern "libnow.h" link "now"`, says `layer` before `link`), at
# the binding that names it, or at the group whose header is the program's
# own and puts the call in its code. Never as `internal error: linking
# failed`, and never as a name no group says which library has.
#
# **A program one of whose groups says `layer` links the archive**, inside
# GNU ld's group of the libraries (`link.link_line`), so a layer name
# its link misses is one no member built for this target defines (R4): told
# at its binding, or at the first group saying `layer`, with the member that
# defines it and why this build holds none, a member written in Swift that
# the layer compiles for an Apple target alone the measured case (the
# critic's `swiftentry` in Linux arm64).

use ast
use check/layer_header
use cli/layer_bound
use cli/layer_libraries
use cli/library_needs
use cli/link_flags
use cli/link_report
use cli/runtime_bound
use cli/runtime_key
use cli/toolchain
use diag
use emit/c_words
use emit/externs as emit_externs
use module/reading
use source
use token

# The diagnostics for a refused link's `message`: one per name it reports that
# a header of the layer declares, each told once; none where it reports none,
# the other readers' then. `linked` are the packages' answers' words.
function told(message: str, s: source.Source, decls: [ast.Decl], t: toolchain.Toolchain, linked: [str]) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= []
    refs = link_report.references(message)

    if refs.len() == 0
        return out
    names = layer_bound.declared_names(t.runtime)
    declared = layer_header.declared(decls)
    libs = library_needs.names_of(s, decls, linked: linked)
    calls: {str: [str]} @= {}
    told_names: {str: bool} @= {}

    for one in refs
        header = names[one.symbol]

        if header.is_err() || !told_names[one.symbol].is_err()
            continue
        told_names[one.symbol] @ true

        if declared
            out @ out.push(
                unbuilt(name: one.symbol, header: header.must(), span: told_span(s, decls, name: one.symbol), t: t)
            )
            continue
        lib = library_needs.library_named(file: one.file, names: libs)

        if lib.len() > 0
            calls[lib] @ calls[lib].default([]).push(one.symbol)
            continue
        at = binding_of(s, decls, name: one.symbol)

        if !at.is_err()
            out @ out.push(missing(name: one.symbol, header: header.must(), span: at.must(), bound: true))
            continue
        own = first_group(decls, said: false)

        if !own.is_err()
            out @ out.push(missing(name: one.symbol, header: header.must(), span: own.must(), bound: false))

    # ORDER: by library name, as `sort` orders a `str`, so two machines tell
    # one link in one order; each group linking it, in the order they stand.
    for lib in sort(keys(calls))
        call = layer_libraries.Called(symbols: calls[lib].must(), library: lib, unread: false)
        seen: {i64: bool} @= {}

        for decl in decls
            head = layer_header.head_of(decl)
            named = library_needs.group_span(decl, want_pkgconfig: false)

            if head.header.is_err() || named.is_err() || !seen[head.header.must().start].is_err()
                continue

            if emit_externs.unquoted(s, span: named.must()) == lib
                seen[head.header.must().start] @ true
                out @ out.push(
                    layer_libraries.undeclared(s, decls, spelled: source.span_text(s, head.header.must()), span: head.header.must(), call: call)
                )

    return out

function missing(name: str, header: str, span: token.Span, bound: bool) -> diag.Diagnostic
    how: str @= "this group binds it"

    if !bound
        how @ "this group's header puts a call to it in the program's own code"
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: layer_header.UNDECLARED,
        message: "`" + name + "` is the platform layer's, declared by its `" + header + "`, and " + how + " through a header that includes none of the layer's, so no group of this program says `layer` and its link carries none of the layer: name `" + header + "` in this group, or include it in the group's header, and say `layer` after the header",
        span: span
    )
    d.notes @ d.notes.push(layer_header.WHY)
    d.notes @ d.notes.push(layer_bound.REDECLARED)
    d.fixes @ d.fixes.push(
        diag.Fix(title: "name the layer's header and say `layer`", replacement: "\"" + header + "\" layer", span: span, certainty: .guess)
    )
    return d

# A name of the layer's that the link of a program saying `layer` misses: the
# member that defines it and why this build's archive holds no definition.
function unbuilt(name: str, header: str, span: token.Span, t: toolchain.Toolchain) -> diag.Diagnostic
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: layer_header.UNBUILT,
        message: "`" + name + "` is the platform layer's, declared by its `" + header + "`, and " + why_unbuilt(name: name, t: t),
        span: span
    )
    d.notes @ d.notes.push(
        "a program one of whose groups says `layer` links the layer's archive, which holds the members this target builds; a name only a member of another target defines leaves its link short on this one"
    )
    return d

# Why the archive this build linked holds no definition of `name`: the member
# written in Swift that defines it, compiled for an Apple target alone, or for
# one only where a group's header reaches its own; a C member naming it, whose
# object for this target defines it nowhere; or no member naming it at all.
function why_unbuilt(name: str, t: toolchain.Toolchain) -> str
    swift = runtime_key.swift_members(t.runtime).default([])

    for member in swift
        text = reading.text_of(member).default("")

        if c_words.used(text)[name].default(false) || holds_text(text: text, needle: "@_cdecl(\"" + name + "\")")
            where = inside(runtime: t.runtime, path: member)

            if !link_flags.apple(t.target)
                return "the member that defines it, `" + where + "`, is written in Swift, which the layer compiles for an Apple target alone, and this build's target is `" + t.target + "`"
            return "the member that defines it, `" + where + "`, is written in Swift, which a build compiles only where a group's header reaches that member's own header, and none of this program's does"

    for member in runtime_key.layer_members(t.runtime).default([])
        if c_words.used(reading.text_of(member).default(""))[name].default(false)
            return "of the layer's members `" + inside(runtime: t.runtime, path: member) + "` names it, and the object this target builds of it, `" + t.target + "`, defines it nowhere"

    return "no member of the layer's names it, so no target's archive defines it"

function inside(runtime: str, path: str) -> str
    if path.len() > runtime.len() + 1 && path.slice(from: 0, to: runtime.len() + 1) == runtime + "/"
        return path.slice(from: runtime.len() + 1, to: path.len())
    return path

function holds_text(text: str, needle: str) -> bool
    if needle.len() > text.len()
        return false

    for at in range(from: 0, to: text.len() - needle.len() + 1)
        if text.slice(from: at, to: at + needle.len()) == needle
            return true

    return false

# Where an unbuilt name is told: its binding's header string, or the first
# group saying `layer`.
function told_span(s: source.Source, decls: [ast.Decl], name: str) -> token.Span
    at = binding_of(s, decls, name: name)

    if !at.is_err()
        return at.must()
    said = first_group(decls, said: true)

    if !said.is_err()
        return said.must()
    return token.Span(start: 0, end: 0)

# The header string of the group binding the C name `name`, where one does.
function binding_of(s: source.Source, decls: [ast.Decl], name: str) -> token.Span?
    for decl in decls
        bound = runtime_bound.bound(decl)
        head = layer_header.head_of(decl)

        if !bound.is_err() && !head.header.is_err() && source.span_text(s, bound.must()) == name
            return head.header

    return fail(code: "none", msg: "no group binds it")

# The header string of the first group saying `layer` where `said`, or of the
# first group at all where not.
function first_group(decls: [ast.Decl], said: bool) -> token.Span?
    for decl in decls
        head = layer_header.head_of(decl)

        if !head.header.is_err() && (!said || !head.layer.is_err())
            return head.header

    return fail(code: "none", msg: "no group")

## Tests

test "a layer name no member of this target defines is told by the member that does (panel 260's R4)"
    t: toolchain.Toolchain @= toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.target @ "aarch64-unknown-linux-gnu"
    assert why_unbuilt(name: "hero_ui_appkit_here", t: t) == "the member that defines it, `platform/hero_ui_appkit.swift`, is written in Swift, which the layer compiles for an Apple target alone, and this build's target is `aarch64-unknown-linux-gnu`"
    assert why_unbuilt(name: "hero_no_such_name_anywhere", t: t) == "no member of the layer's names it, so no target's archive defines it"
    assert inside(runtime: "rt", path: "rt/platform/x.c") == "platform/x.c"
    assert holds_text(text: "@_cdecl(\"a\")", needle: "@_cdecl(\"a\")")
    assert !holds_text(text: "ab", needle: "abc")
