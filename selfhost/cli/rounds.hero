# The rounds of one build (design.md §4.19; defect 037, panel 152 R1; panel
# 202's C0, ratified 2026-10-10). A round asks each module's headers its
# questions (`cli/probing.hero`), then compiles the program's units and links
# them (`cli/assemble.hero`); a round clang refused for a handle's bare tag
# runs again with what it learned (`cli/tag_spelling.hero`), and a refusal
# that ends them is read for whose it is (`cli/whose.hero`). Split out of
# `cli/produce.hero` and `cli/assemble.hero` on 2026-10-10, when the probes
# became one per module's headers and both files passed §11's 300 lines:
# `produce` decides what a build is, and this how its rounds go.
#
# **A handle's tag is spelled as the author wrote it**, and where clang says
# *must use 'struct' tag to refer to type 'X'*, which it says only when X
# names a struct tag of that spelling, in the round or of the record's own
# declaration (`cli/tag_spelling.hero`, defect 400), the round runs again
# with `struct X *`. A round that learns nothing ends the loop, so it is
# bounded by the program's tagged handles; a round costs one failing compile
# (2026-09-15), the probes asked once per build.

use source
use emit/ffi_asked
use cli/compile
use cli/toolchain
use cli/compiling
use cli/assemble
use cli/settled
use cli/probing
use cli/pointee_ask
use cli/tag_spelling
use cli/whose
use cli/refused_units
use cli/two_ways
use cli/defined_twice
use cli/pragma_ask
use cli/bound_macro
use diag
use emit/lock_screen
use check/lock_copies
use cli/locks
use emit/lend_type
use cli/value_run
use cli/value_beside
use cli/value_early

# What the rounds came back with: the verdict, the failure already told where
# it is the author's (`cli/refused_units.hero`); where the binary landed; the
# tags they learned; the header's answer where the last one asked it; and the
# names a bound macro reaches the guard keeps (defect 2059).
record Rounds
    verdict: ()?
    binary: str
    struct_tags: {str: bool}
    asked: ffi_asked.Asked?
    kept: {str: bool}

function run(t: toolchain.Toolchain, options: compile.Options, art: compile.Artifact, s: source.Source, site: settled.Site, under: compiling.Compiling, planned: probing.Planned, @answered: [pointee_ask.Answered]) -> Rounds
    struct_tags: {str: bool} @= {}
    told: {str: bool} @= {}
    linked: ()? @= ok()
    binary: str @= ""
    asked: ffi_asked.Asked? @= fail(code: "none", msg: "the header was not asked")
    refused_in: [str] @= []
    units_refused: [assemble.Refused] @= []

    # What the value probe asks beside the last round's refusal (defect
    # 2128, panel 225): the round's units that compiled, and every one it
    # refused, or each module's before any unit (`cli/value_beside.hero`,
    # `cli/value_early.hero`).
    beside: [value_run.Unit] @= []

    # A name a group binds whose meaning another group's header gives it, a
    # macro read before or after the group's own (`cli/bound_macro.hero`,
    # defect 2056), or the guard's close changes under a bound macro
    # (`cli/bound_kept.hero`, defect 2059), told before any unit compiles:
    # the author's, and no round after it. Asked once, of the build.
    taken = bound_macro.told(t, planned.probings, s: s, decls: art.decls)
    kept = taken.kept

    if taken.diagnostics.len() > 0
        _ = compile.stage(taken.diagnostics, s, permissive: false).is_err()
        over: ()? = fail(
            code: "diagnostics",
            msg: "a name this program binds would mean what its header does not make it"
        )
        return Rounds(verdict: over, binary: "", struct_tags: struct_tags, asked: asked, kept: kept)

    while true
        went = round(
            t,
            options,
            art,
            s,
            site,
            @answered,
            planned: planned,
            struct_tags: struct_tags,
            kept: kept,
            told: @told,
            beside: @beside
        )
        linked @ went.verdict
        binary @ went.binary
        refused_in @ went.modules
        units_refused @ went.units

        if !linked.is_err()
            break

        # A refusal already told is the author's and ends the rounds.
        if whose.failure_code(linked) == "diagnostics"
            return Rounds(verdict: linked, binary: "", struct_tags: struct_tags, asked: asked, kept: kept)
        lesson = tag_spelling.learn(
            t,
            art,
            s,
            refusals: went.refusals,
            probings: planned.probings,
            struct_tags: @struct_tags
        )

        if lesson.learned == 0
            asked @ lesson.asked
            break

    if linked.is_err()
        # Some clang failures are the AUTHOR's, and the ffi mapping is
        # the only place that decides which (panel 036 rider 3); the
        # pipeline pieces ride in the Artifact for exactly this call. The
        # questions are asked of the headers of the units that refused, every
        # unit read (defect 2143). A value only the probe sees is asked
        # beside it and told with it.
        found = value_beside.told(
            t,
            units: beside,
            level: options.level,
            p: art.program,
            c: art.checked,
            s: s,
            decls: art.decls
        )
        refused = refused_units.tell(
            linked,
            art,
            s,
            t,
            under: under,
            answered: answered,
            struct_tags: struct_tags,
            asked: asked,
            planned: planned,
            modules: refused_in,
            units: units_refused,
            beside: found
        )
        return Rounds(verdict: refused, binary: "", struct_tags: struct_tags, asked: asked, kept: kept)
    return Rounds(verdict: ok(), binary: binary, struct_tags: struct_tags, asked: asked, kept: kept)

# `told` is what clang said that this build has printed, across its rounds
# (defect 327, `cli/clang_told.hero`): the second round compiles again what
# the first did, and replays it where it is warm. `planned` is the build's
# (`cli/probing.hero`), the same for every round: each module's plan and the
# probes of their headers.
function round(t: toolchain.Toolchain, options: compile.Options, art: compile.Artifact, s: source.Source, site: settled.Site, @answered: [pointee_ask.Answered], planned: probing.Planned, struct_tags: {str: bool}, kept: {str: bool}, @told: {str: bool}, @beside: [value_run.Unit]) -> assemble.Round
    beside @ []

    # What the extern out-parameters point at, asked of each module's headers
    # before any unit compiles (panel 103; panel 202's C0): the width and sign
    # of a numeric `@` against the header's own type. Then the header's
    # layout of every group record (panel 186): a field left out, and a field
    # that lies in a union where the program builds or compares the record.
    # A failure here is the AUTHOR's, and it rides the same mapping a clang
    # failure does — `emit/ffi.hero` reads the assertion's marker back into
    # the parameter's diagnostic.
    # A name the compiler writes that a group's header defines as a macro
    # holding a `_Pragma`, told before anything reads a header through it
    # (`cli/pragma_ask.hero`, defect 570): the author's, and no round after.
    pragmas = pragma_ask.told(t, planned.probings, s: s, decls: art.decls)

    if pragmas.len() > 0
        _ = compile.stage(pragmas, s, permissive: false).is_err()
        held: ()? = fail(
            code: "diagnostics",
            msg: "a group's header defines a name this program's C writes as a macro holding a pragma"
        )
        return assemble.Round(verdict: held, refusals: [], binary: "", modules: [], units: [])
    checked = probing.check_all(t, art.program, art.checked, s, art.decls, planned.probings, answered: @answered)

    if checked.verdict.is_err()
        # A value only the probe sees, asked beside it (panel 225,
        # `cli/value_early.hero`) and told with it by `run`.
        beside @ value_early.units(
            t,
            options,
            art,
            s,
            site,
            planned: planned,
            struct_tags: struct_tags,
            kept: kept,
            answered: answered
        )
        return assemble.Round(
            verdict: checked.verdict,
            refusals: assemble.messages_of(checked.verdict),
            binary: "",
            modules: checked.modules,
            units: []
        )

    # A copy of a group record whose C struct holds a lock, told before any
    # unit compiles (panel 215's R2, `cli/locks.hero`): the author's, said
    # here, and no round after it.
    copied = lock_told(t, art, s, planned.probings)

    if copied.len() > 0
        _ = compile.stage(
            joined(first: copied, more: early(t, options, art, s, site, planned: planned, struct_tags: struct_tags, kept: kept, answered: answered)),
            s,
            permissive: false
        ).is_err()
        locked: ()? = fail(code: "diagnostics", msg: "a group record whose C struct holds a lock is copied")
        return assemble.Round(verdict: locked, refusals: [], binary: "", modules: [], units: [])

    # One C function two modules' groups bind and their headers declare two
    # ways, told before any unit compiles (panel 202's C1,
    # `cli/two_ways.hero`): the author's, said here, and no round after it.
    # And a name the units of two modules would each define (panel 202's C2,
    # `cli/defined_twice.hero`), but those told already.
    two = two_ways.told(t, planned.probings, s: s, decls: art.decls)
    disagreeing = joined(
        first: two.diagnostics,
        more: defined_twice.told(t, planned.probings, s: s, decls: art.decls, skip: two.names)
    )

    if disagreeing.len() > 0
        _ = compile.stage(
            joined(first: disagreeing, more: early(t, options, art, s, site, planned: planned, struct_tags: struct_tags, kept: kept, answered: answered)),
            s,
            permissive: false
        ).is_err()
        refused: ()? = fail(code: "diagnostics", msg: "two modules' headers disagree about a C name")
        return assemble.Round(verdict: refused, refusals: [], binary: "", modules: [], units: [])

    # The unit each counted parameter's count is compared in, read from the
    # header by the check above (panel 194's R7): every unit is emitted with
    # it, so the comparison is in what C counts and never in bytes alone.
    counted = lend_type.lend_units(answered)
    lent = assemble.Lent(
        units: counted,
        digests: probing.digests_of(planned.probings),
        unread: checked.unread,
        unread_modules: checked.unread_modules,
        kept: kept
    )

    # `heroes test` too: one unit per module, as `build` cuts the program
    # (defect 560), the root's carrying the test runner.
    return assemble.per_module(
        t,
        options,
        art,
        s,
        site,
        planned: planned,
        struct_tags: struct_tags,
        lent: lent,
        told: @told,
        beside: @beside
    )

# What the probe finds beside a refusal made before any unit compiles
# (`cli/value_early.hero`, panel 225).
function early(t: toolchain.Toolchain, options: compile.Options, art: compile.Artifact, s: source.Source, site: settled.Site, planned: probing.Planned, struct_tags: {str: bool}, kept: {str: bool}, answered: [pointee_ask.Answered]) -> [diag.Diagnostic]
    return value_early.told(
        t,
        options,
        art,
        s,
        site,
        planned: planned,
        struct_tags: struct_tags,
        kept: kept,
        answered: answered
    )

# Two lists of diagnostics as one.
function joined(first: [diag.Diagnostic], more: [diag.Diagnostic]) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @= first

    for d in more
        out @ out.push(d)

    return out

# Every probe's records asked which hold a lock, then the program's copies of
# them (panel 215's R2).
function lock_told(t: toolchain.Toolchain, art: compile.Artifact, s: source.Source, probings: [probing.Probing]) -> [diag.Diagnostic]
    found: {i64: lock_screen.Found} @= {}

    for one in probings
        if !one.probe.is_err() && probing.laid_out(art.decls, records: one.records)
            asked = locks.found(
                t,
                art.program,
                art.checked,
                s,
                art.decls,
                probe: one.probe.must(),
                records: one.records
            )

            # ORDER: none — a union of answers by declaration.
            for decl in keys(asked)
                found[decl] @ asked[decl].must()

    return lock_copies.copies(art.tree, art.resolved, s, art.decls, art.checked, found: found)
