# Reading the file, once (CLAUDE.md §10's exit contract). Port of
# archive/bootstrap-rs/heroes-cli/src/input.rs.
#
# Five bootstrap commands used to carry their own copy of "cannot
# read", their own USAGE string and their own idea of what to exit
# with. The path is validated by the argv reader, the read happens
# here, and every failure to RUN (rather than to check) leaves as this
# module's failure — the driver maps it to exit 2.
#
# A module named by a `use` and missing from disk is NOT an error
# here: modules.errors reports it against this Source, caret on the
# use line. Failing to read the ROOT is a different thing — the tool
# could not run at all — and so is failing to read a module whose file
# is there (defect 236: a mode of 000, a directory, a link to nothing
# were each told *that file is not there*); `modules.load_text` fails
# for it as this file does for the root, in the same words. The
# library's text arrives as a parameter, same as modules.load_text takes
# it: where the compiled selfhost binary keeps its copy is the driver's
# parked DECIDE question.

use source
use modules
use module/reading
use cli/process
use cli/files

# The whole compilation as one Source: the file named, every module it
# reaches through use, and the library last (§1.11). Doing it here is
# what keeps lex, parse, check, build, run, test and fmt looking at
# the same text.
#
# A file of it that is not UTF-8 is read all the same, as `reading.source_text`
# holds one, and its faults are the Source's: what is told about it is the
# lexer's first word (`not_text.hero`), at exit 1, for every verb (panel 189).
function read_compilation(path: str, library: str) -> source.Source?
    root = reading.source_text(path)

    if root.is_err()
        return fail(code: "unreadable", msg: "cannot read `" + path + "`")

    # Never lexed, not even for its `use` lines: a binary named on the command
    # line took ten minutes of discovery's lexing to be told (panel 189).
    if root.must().faults.len() > 0
        return ok(reading.rooted(source.new_source(name: path, text: root.must().text), root: root.must().faults))
    return modules.load_text(path: path, root_text: root.must().text, library: library)

# THE ROOT FILE ALONE, for `fmt` and only for `fmt`.
#
# The doc above says reading the whole compilation here "keeps lex,
# parse, check, build, run, test and fmt looking at the same text", and
# `fmt` is now off that list on purpose. It is the one command whose
# answer cannot depend on another file: `fmt.format_file` keeps
# root-file declarations and root-file comments and discards the rest, so
# every line the graph contributed was read, lexed and then thrown away.
#
# Measured 2026-08-28: formatting all 165 `selfhost` modules cost 188 s
# through `read_compilation` against 6 s for the 206 files outside
# `selfhost/`, which have no graph to pull.
#
# The library is NOT appended, which is the whole point, and it is also
# why the refusal narrows: a syntax error in a sibling module no longer
# stops `fmt` from formatting the file you named.
function read_root_only(path: str) -> source.Source?
    root = reading.source_text(path)

    if root.is_err()
        return fail(code: "unreadable", msg: "cannot read `" + path + "`")
    return ok(reading.rooted(source.new_source(name: path, text: root.must().text), root: root.must().faults))

## Tests

test "the root read fails loud, a missing module stays the graph's"
    ghost = read_compilation(path: "build/selftest_no_such_file.hero", library: "")

    match ghost
        .ok => assert false
        .err e =>
            assert e.code == "unreadable"
            assert e.msg == "cannot read `build/selftest_no_such_file.hero`"

    text = "use selftest_absent_module\n\nfunction main()\n    print(1)\n"
    assert !write_file(path: "build/selftest_input_root.hero", text: text).is_err()
    s = read_compilation(path: "build/selftest_input_root.hero", library: "")
    assert !s.is_err()
    assert s.must().files.len() == 2

# DEFECT 236: a module whose file is there and cannot be read fails the read
# as an unreadable root does, in the root's words, and never reads as absent;
# one that cannot be there, below a file, is still the graph's to tell.
test "a module that is there and cannot be read fails loud, as the root does"
    dir = "build/selftest-input-modules"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir + "/geom.hero").is_err()
    assert !write_file(path: dir + "/bin", text: "a program, not a directory\n").is_err()
    uses_geom = "use geom\n\nfunction main()\n    print(geom.two())\n"
    assert !write_file(path: dir + "/main.hero", text: uses_geom).is_err()

    match read_compilation(path: dir + "/main.hero", library: "")
        .ok => assert false
        .err e =>
            assert e.code == "unreadable"
            assert e.msg == "cannot read `" + dir + "/geom.hero`"

    assert !write_file(path: dir + "/below.hero", text: "use bin/geom\n\nfunction main()\n    print(geom.two())\n").is_err()
    below = read_compilation(path: dir + "/below.hero", library: "")
    assert !below.is_err()
    assert below.must().files.len() == 2
    assert !write_file(path: dir + "/linked.hero", text: "use dangling\n\nfunction main()\n    print(dangling.two())\n").is_err()

    if !files.symbolic_link(target: "nowhere.hero", name: dir + "/dangling.hero").is_err()
        assert read_compilation(path: dir + "/linked.hero", library: "").is_err()

# DEFECT 274: a file that is there is never `file_not_found`. A mode of 000
# makes one an ordinary user may not read, on this Mac and on Linux; as root,
# and on Windows, where a mode keeps read-only alone, the file still reads, and
# then it must read whole. The mode is given back before anything is asserted,
# so the next run can remove the file on every platform.
test "a file that is there and may not be read is read_failed, never file_not_found"
    dir = "build/selftest-read-locked"
    path = dir + "/locked.txt"
    assert !process.remove_tree(dir).is_err()
    assert !process.mkdir_all(dir).is_err()
    assert !write_file(path: path, text: "secret\n").is_err()
    assert !files.set_mode(path: path, mode: 0).is_err()
    got = read_file(path)
    assert !files.set_mode(path: path, mode: 420).is_err()

    match got
        .ok text => assert text == "secret\n"
        .err e   => assert e.code == "read_failed"
