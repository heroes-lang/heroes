# heroes --help: the table, plus the contract (panel 016). Port of
# heroes-cli/src/cli/help.rs in the Rust bootstrap at `m-bootstrap-archive`. And heroes --version, the
# other answer the compiler gives without reading a program.
#
# The exit codes are printed because a wrapper script has nowhere else
# to read them, and HEROES_RUNTIME is printed because it is the one
# input channel outside the argv table — a channel nobody can discover
# is a channel that will be discovered by reading the source.
#
# NO MILESTONE IDENTIFIER APPEARS HERE — and this comment does not
# spell one either, which is the rule catching its own explanation:
# `no_living_file_names_a_numbered_milestone` fired on the first draft
# of this paragraph, where the example was quoted verbatim. The footer
# once advertised verbs §10's stopping rule had refused, tagged with
# legacy numbered ids §4.17 forbids — a reader given one grepped the
# repository for it and concluded the toolchain was broken. What is
# left is the commands a row of the chain genuinely schedules, with no
# date attached: `add` and `fetch`, and `lsp`. It said `lsp · cc` until
# 2026-10-25, when no row scheduled a `cc` and `add` and `fetch` stood on
# one (M-rechecked-issues, `grep 'heroes cc'` over the ROADMAP and the
# milestones' pages empty).

use cli/table as cli_table

# What this compiler was compiled from (panel 222's R1): its modules, its
# library and its runtime, keyed by the compiler that built it and defined
# beside its `main` (`emit/provenance.hero`).
extern "heroes_runtime.h"
    function hero_program_sources() -> str

# `heroes --version`: the release this compiler is, then what it was compiled
# from. The first line is the release's alone, the one a tag is checked
# against (`.github/workflows/ci.yml`); the second moves with every byte of a
# source, the library or the runtime, so a gate asks a compiler whether it was
# built from the tree it judges (panel 222's R2).
function version(number: str) -> str
    return "heroes " + number + "\nsources " + hero_program_sources()

function help() -> str
    rows: [str] @= ["heroes — the Heroes compiler\n\nusage: heroes <command> [file] [flags]\n\n"]

    for command in cli_table.commands()
        operand: str @= ""

        match command.operand
            .file_operand     => operand @ " <file.hero>"
            .optional_operand => operand @ " [file]"
            .no_operand       => operand @ operand

        rows @ rows.push("  " + command.name + operand + "\n      " + command.summary + "\n")

        for flag in command.flags
            spelling: str @= flag.spelling

            if flag.value
                spelling @ flag.spelling + " <" + flag.placeholder + ">"
            rows @ rows.push("      " + spelling + "  " + flag.what + "\n")

    rows @ rows.push("\n  --version · --help\n\n")
    rows @ rows.push("streams: the artifact on stdout, diagnostics and progress on stderr.\n")
    rows @ rows.push("exit:    0 nothing to report · 1 diagnostics were reported, no artifact was produced\n")
    rows @ rows.push("         2 the tool could not run. `run` forwards the program's own status.\n")
    rows @ rows.push("env:     HEROES_RUNTIME  where heroes_runtime.h and runtime.c live, if not\n")
    rows @ rows.push("         under the working directory or beside the compiler.\n\n")
    rows @ rows.push("Commands not built yet: add · fetch · lsp\n")
    return rows.join("")

## Tests

function has(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false

test "the version is the release's line, then the sixteen characters this binary was compiled from"
    head = "heroes 9.8.7\nsources "
    said = version(number: "9.8.7")
    assert said.len() == head.len() + 16
    assert said.slice(from: 0, to: head.len()) == head
    assert said.slice(from: head.len(), to: said.len()) == hero_program_sources()

test "the help is the table spoken, contract and env channel included"
    text = help()
    assert has(
        text: text,
        needle: "heroes — the Heroes compiler\n\nusage: heroes <command> [file] [flags]\n\n  lex <file.hero>\n      check the token stream\n      --dump-tokens  print the token stream\n      --json  print it as JSON instead of text\n  parse <file.hero>\n      check the syntax\n      --dump-ast  print the syntax tree\n"
    )

    # A valued flag shows its <path>; an optional operand its [file].
    assert has(text: text, needle: "      -o <path>  write the artifact here instead of under build/\n")
    assert has(text: text, needle: "  measure [file]\n")
    assert has(text: text, needle: "  doctor\n      check the toolchain (clang, CLT, arch, runtime, cache)\n")

    # The contract and the one channel outside argv.
    assert has(
        text: text,
        needle: "exit:    0 nothing to report · 1 diagnostics were reported, no artifact was produced\n         2 the tool could not run. `run` forwards the program's own status.\n"
    )
    assert has(
        text: text,
        needle: "env:     HEROES_RUNTIME  where heroes_runtime.h and runtime.c live, if not\n         under the working directory or beside the compiler.\n\nCommands not built yet: add · fetch · lsp\n"
    )
