# The names a link's output takes (design.md §3.1, §1.12; defects 134, 359
# and 509): where a binary built from a line lives under `build/`, the suffix
# an author's `-o` takes, the name of the PDB a Windows binary records, and
# where each file the linker wrote is published. Split out of `cli/link.hero`
# on 2026-10-18, when defect 2142's note of where a concurrent build failed
# passed that file over §11's 300 lines: `link` runs the link, and this
# answers what its outputs are called.

use cli/digest
use cli/strings
use cli/toolchain

# **The author's `-o` takes the platform's suffix where its last part has
# none** (defect 359, 2026-10-05): on Windows `build -o name` wrote `name`,
# which Git Bash starts and `cmd.exe` and PowerShell do not, by that path or
# any. GCC's driver does this for its MinGW and Cygwin targets (`gcc.cc`'s
# `convert_filename`, the `.exe` of `config/i386/cygming.h`, read
# 2026-10-05), and clang 23.1.1 there writes `name` as given (measured on
# the box), so the rule is gcc's: a last part holding a `.` is the author's
# suffix and is kept, `app.bin` and `name.` alike. The last part ends at `/`
# or `\`, Windows' two separators, which is the only place a suffix is
# asked for: elsewhere it is "" and the path is the author's whole.
function with_suffix(path: str, suffix: str) -> str
    if suffix.len() == 0
        return path
    at: i64 @= path.len()

    while at > 0 && path[at - 1] != '/' && path[at - 1] != '\\'
        if path[at - 1] == '.'
            return path
        at @ at - 1

    if at == path.len()
        return path
    return path + suffix

# Where a binary built from `line` lives under `build/`: one directory per
# link line, every word counted by its length so no two lines share one,
# and the layout word and the compiler that links in the key as well.
function binary_home(t: toolchain.Toolchain, line: [str], name: str) -> str
    words: [str] @= [t.fingerprint, t.compiler_key, name]

    for word in line
        words @ words.push(word.len().to_str() + ":" + word)

    return t.build + "/" + digest.digest(words.join("|")) + "/" + name

# **The PDB's name as the binary records it, on Windows** (defect 509,
# 2026-10-09). The linker writes the PDB into the private directory, as
# `<module>.pdb`, and records that absolute path in the binary; the PDB is
# then published beside the binary as `<binary>.pdb` (`published_as`) and the
# directory removed, so the path the binary carried named nothing, and the
# name a symbolizer looks for beside the binary when the path fails was not
# the published one either. Measured on the box (clang 23.1.1, lld-link):
# AddressSanitizer's report at `--sanitize` and at `--sanitize -O0` named no
# frame, every one an address alone, as on the CI's Windows leg (clang 20.1.8)
# where defect 322's case went red; `/PDBALTPATH` naming the published PDB's
# own last part, and the frames carry their files and lines. The last part
# alone and not a path: a symbolizer and a debugger look for that name beside
# the binary, so the pair can be moved together, and no directory of this
# machine is written into the binary. `-Xlinker` and not `-Wl,`, which would
# cut a name holding a comma. POSIX writes no PDB, and gets no word.
function pdb_words(suffix: str, at: str, inner: str, module: str) -> [str]
    if suffix != ".exe"
        empty: [str] = []
        return empty
    pdb = published_as(binary: at, inner: inner, module: module, relative: module + ".pdb")
    return ["-Xlinker", "/PDBALTPATH:" + last_part(pdb)]

# The last part of a path, cut at Windows' two separators, `/` and `\`, the
# one platform `pdb_words` asks it for.
function last_part(path: str) -> str
    at: i64 @= path.len()

    while at > 0 && path[at - 1] != '/' && path[at - 1] != '\\'
        at @ at - 1

    return path.slice(from: at, to: path.len())

# Where a file the linker wrote is published: the binary at the path asked
# for, verbatim, and anything else under the binary's name and what followed
# the module's own, `app.exe.pdb` for `p.pdb`, the name it had when the
# linker wrote `app.exe.tmp`. **The author's path is never split to find a
# name**: `-o C:\x\app.exe` is Windows' own separator, and a name cut at `/`
# alone from it put the linker's output in a directory that is not there.
function published_as(binary: str, inner: str, module: str, relative: str) -> str
    if relative == inner
        return binary

    if strings.starts_with(text: relative, prefix: module)
        return binary + relative.slice(from: module.len(), to: relative.len())
    return binary + "." + relative

## Tests

# gcc's rule, asked with Windows' suffix on every platform (defect 359).
test "an -o whose last part has no suffix takes the platform's, and one that has one keeps it (defect 359)"
    assert with_suffix(path: "p231/astar800", suffix: ".exe") == "p231/astar800.exe"
    assert with_suffix(path: "name", suffix: ".exe") == "name.exe"
    assert with_suffix(path: "dir.d/name", suffix: ".exe") == "dir.d/name.exe"
    assert with_suffix(path: "C:\\w\\dir.d\\name", suffix: ".exe") == "C:\\w\\dir.d\\name.exe"
    assert with_suffix(path: "app.bin", suffix: ".exe") == "app.bin"
    assert with_suffix(path: "app.exe", suffix: ".exe") == "app.exe"
    assert with_suffix(path: "name.", suffix: ".exe") == "name."
    assert with_suffix(path: ".hidden", suffix: ".exe") == ".hidden"
    assert with_suffix(path: "dir/", suffix: ".exe") == "dir/"
    assert with_suffix(path: "p231/astar800", suffix: "") == "p231/astar800"

test "a Windows link records the published PDB's own name, and a POSIX link records none (defect 509)"
    assert pdb_words(suffix: ".exe", at: "build/0123456789abcdef/prog.exe", inner: "prog.exe", module: "prog") == ["-Xlinker", "/PDBALTPATH:prog.exe.pdb"]
    assert pdb_words(suffix: ".exe", at: "C:\\out\\app.exe", inner: "m.exe", module: "m") == ["-Xlinker", "/PDBALTPATH:app.exe.pdb"]
    assert pdb_words(suffix: ".exe", at: "dir/a,b.exe", inner: "a.exe", module: "a") == ["-Xlinker", "/PDBALTPATH:a,b.exe.pdb"]
    assert pdb_words(suffix: "", at: "build/0123456789abcdef/prog", inner: "prog", module: "prog").len() == 0
    assert last_part("a/b\\c.pdb") == "c.pdb"
    assert last_part("plain.pdb") == "plain.pdb"
