# The process boundary: how the compiler reaches the machine.
#
# **This module was `cli_shell.hero` until M-argv-execution, and the
# rename is the point.** It used to build a command LINE as a string
# and hand it to C's `system()`, quoting every filename on the way
# with `sq()` — single quotes, POSIX rules, maintained by hand across
# 189 call sites in this repository. There is no shell here any more.
# A program is named, its arguments are pushed one at a time, and the
# runtime hands them to the operating system as a list.
#
# WHY THE PUSH IS ONE WORD AT A TIME, and it is not a style choice.
# `function hero_run(program: cstr, argv: [str])` cannot be declared:
# `[str]` is `error[ffi_type]`, and packing the words into one
# NUL-separated string is `error[unknown_escape]`. There is no Heroes
# value that can carry an argument list across the C boundary, which
# panel 098 measured with a compiler rather than argued. So the list is
# built in the runtime, one call per word, and `run` below is the
# Heroes-side wrapper that makes that invisible to every caller — a
# `[str]` is perfectly ordinary between two Heroes functions.
#
# WHAT IT BOUGHT, measured at panel 098. The argument `a b 'c' $HOME`
# arrives as **14 bytes, untouched**, where a shell without `sq()`
# delivered **20** — `a b c /Users/joseph`, three words, the quotes
# eaten and the variable expanded. That class is deleted rather than
# defended.
#
# AND THE ANSWER GAINED A CHANNEL. `system()` says 127 both for a
# program that does not exist and for one that ran and exited 127, and
# a program killed by a signal decodes to zero, reading as success.
# `Ran.started` is that distinction, and every caller must ask it
# before reading `code` (panel 098 condition 3).
#
# Panel 033 R5 is still why the wrappers exist: an extern is never
# callable across a module boundary, so these are the route every other
# module takes.

use not_text

extern "hero_os.h"
    function hero_run_discard_path() -> str
    function hero_run_exe_suffix() -> str
    function hero_run_reset()
    function hero_run_arg(word: str)
    # `lent`: each call reads the path while it runs and keeps nothing of it
    # (panel 171). Without the word a lend is refused, because a C parameter
    # is assumed to keep what it is handed. `runtime/parts/os.c` is the C.
    function hero_run_go(program: cstr lent, in_path: cstr lent, out_path: cstr lent, err_path: cstr lent, @status: i64) -> i64
    function hero_run_why() -> i64
    function hero_run_signal() -> i64
    function hero_fs_exists(path: cstr lent) -> i64
    function hero_fs_is_directory(path: cstr lent) -> i64
    function hero_fs_mkdir_all(path: cstr lent) -> i64
    function hero_fs_remove(path: cstr lent) -> i64
    function hero_fs_rename(from: cstr lent, to: cstr lent) -> i64
    function hero_fs_why() -> i64
    function hero_dir_remove_tree(path: cstr lent) -> i64
    function hero_os_pid() -> i64
    function hero_run_serial() -> i64
    # `lent`, as every name handed to it above: read while it runs, kept never.
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64

extern "stdlib.h"
    function hero_dir_scan(root: cstr lent, want: i64, recursive: i64) -> i64
    function hero_dir_at(index: i64) -> str
    function hero_dir_release()

# What a finished program answered.
#
# `started` first, `code` second — the order is the rule. A program
# that never ran has no exit code, and `-1` is not one either: reading
# `code` without asking `started` is how `system()`'s 127 used to be
# mistaken for a program's own answer.
record Ran
    code: i64
    started: bool
    why: i64
    # What ended the program when it did not end itself: the signal, or on
    # Windows the exception code a crashed program exits with; 0 otherwise
    # (defect 170). A code of 128 plus a signal is also an exit a program may
    # choose, and this is what tells the two apart.
    signal: i64

# The runtime's status words. `0` is OK; `1` is "could not be started".
constant RUN_OK: i64
    0

# Run `program` with `words`, which must include the program's own name
# as its first word — argv[0] is a word like any other.
#
# **An empty `out` or `err` INHERITS that stream**, so the child writes
# where this process writes. To throw a stream away, pass `discard()`
# below — the spelling of `/dev/null` lives in the runtime, because it is
# a platform word and this file is not allowed to know what platform it
# is on.
#
# **This paragraph said `discards` until 2026-09-21**, twenty-five lines
# above a second one that said the opposite and was right
# (`hero_run_inherits` in `runtime/parts/run.c` treats the empty path as
# inherit). `run_clang` passed `out: ""` for it, so clang inherited the
# TEST HARNESS's own capture handle whenever the compiler ran under the
# net — and a clang that outlived its parent then held that file, which
# is defect 074 and which `tests/harness/shell.hero` had recorded as an
# orphan `clang.exe` a month earlier without anybody connecting the two
# (panel 174, route F).
function run(program: str, words: [str], out: str, err: str) -> Ran
    hero_run_reset()

    for word in words
        hero_run_arg(word: word)

    status: i64 @ 0
    code = hero_run_go(
        program: program.cstr(),
        in_path: "".cstr(),
        out_path: out.cstr(),
        err_path: err.cstr(),
        @status
    )
    hero_run_reset()

    return Ran(code: code, started: status == RUN_OK, why: hero_run_why(), signal: hero_run_signal())

# Where a stream goes to be thrown away, spelled the way this machine
# spells it. Asked of the runtime rather than written here, because
# `/dev/null` is a platform word and panel 097 keeps those out of the
# compiler. An empty path is the other thing entirely: it INHERITS, so
# the program writes where this process writes.
function discard() -> str
    return hero_run_discard_path()

# What an executable is called here: `.exe` on Windows, "" elsewhere.
# Asked of the runtime rather than known, because this file is not
# allowed to know what platform it is on — and a binary built without it
# is created successfully and then cannot be started.
function exe_suffix() -> str
    return hero_run_exe_suffix()

# The filesystem questions, each carrying the shell utility's meaning
# rather than the C call's: an existing directory is a successful
# `mkdir_all`, and a file that is not there is a successful `remove`. The
# runtime's C explains why `mkdir` cannot be trusted to say which of those
# it is looking at. **A refusal carries the operating system's own number**
# (defect 134): `could not move` alone was one silence for a full disk, a
# read-only directory and a file another process holds open.
function mkdir_all(path: str) -> ()?
    if hero_fs_mkdir_all(path: path.cstr()) != RUN_OK
        return fail(code: "mkdir_failed", msg: "could not create the directory " + path + because())
    return ok()

# What the operating system said about the last filesystem call on this
# thread that failed, as the clause every refusal here ends with.
function because() -> str
    return ": the operating system's own reason is " + fs_why().to_str()

# That number itself: `errno`, or `GetLastError()` on Windows, 0 after a
# call that succeeded (`hero_os.h`, `hero_fs_why`).
function fs_why() -> i64
    return hero_fs_why()

function path_exists(path: str) -> bool
    return hero_fs_exists(path: path.cstr()) == 1

function is_directory(path: str) -> bool
    return hero_fs_is_directory(path: path.cstr()) == 1

function remove_file(path: str) -> ()?
    if hero_fs_remove(path: path.cstr()) != RUN_OK
        return fail(code: "remove_failed", msg: "could not remove " + path + because())
    return ok()

# A directory and everything under it, and one that is not there is
# success, as `remove_file` says of a file.
function remove_tree(path: str) -> ()?
    if hero_dir_remove_tree(path: path.cstr()) != RUN_OK
        return fail(code: "remove_failed", msg: "could not remove " + path)
    return ok()

# Replace `to` with `from`, atomically where the platform allows it.
# The cache depends on that: every file under `build/` that another
# process reads is published by renaming it into place, so a reader sees
# the whole of one or the whole of the other (`cli/publish.hero`).
function rename_over(from: str, to: str) -> ()?
    if hero_fs_rename(from: from.cstr(), to: to.cstr()) != RUN_OK
        return fail(code: "rename_failed", msg: "could not move " + from + " to " + to + because())
    return ok()

# Every FILE under `dir`, recursively, relative paths joined with `/` on
# every platform. The runtime holds the listing until it is read, and this
# releases it on the way out — the leak gate panics at exit otherwise.
function files_under(dir: str) -> [str]?
    found = hero_dir_scan(root: dir.cstr(), want: 0, recursive: 1)

    if found < 0
        return fail(code: "cannot_walk", msg: "cannot read " + dir)
    out: [str] @ []
    at: i64 @ 0

    while at < found
        out @ out.push(dir + "/" + hero_dir_at(index: at))
        at @ at + 1

    hero_dir_release()
    return ok(out)

# One environment variable: "" where it is unset, its value where that is
# UTF-8, and a failure naming the variable where it is set and not UTF-8,
# which the caller tells, at its place. The failure does not quote the
# value: a variable may hold a secret (the key `measure --refresh` reads),
# and a variable that names a place is quoted by its caller through
# `env_written`.
#
# **This killed the compiler until 2026-08-24**: `getenv` answers a pointer
# to whatever bytes the environment holds, and `to_str` aborts on bytes that
# are not UTF-8, so `HEROES_RUNTIME=$'\xff\xfe' heroes doctor` was exit 134
# (panel 089). **And then it read such a value as unset** (defect 243), ""
# for both: a `HEROES_RUNTIME` naming a real runtime was answered *looked in:
# the given hint* and told to set what was set, and with a `./runtime` beside
# the program the build went on against that one, no word said. The runtime
# reads the value as the shown read reads a file (`hero_env_shown`), so a
# value that is not text is held, and named.
function env(name: str) -> str?
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_env_shown(name: name.cstr(), status: @status, marks: @marks)

    if status == HERO_OS_NOT_FOUND
        return ok("")

    if status == HERO_OS_OK
        return ok(got)
    return fail(
        code: "not_text",
        msg: "`" + name + "` is set, and its value is not UTF-8, which a value this compiler reads must be"
    )

# A variable's value as a message may quote it, each byte that is not UTF-8
# written by its value, `<0xE9>`; "" where it is unset. For a variable that
# names a place, never for one that may hold a secret.
function env_written(name: str) -> str
    status: i64 @ 0
    marks: i64 @ 0
    got = hero_env_shown(name: name.cstr(), status: @status, marks: @marks)
    return written_value(answer: got, marks: marks)

# The runtime's answer for a value, its marks before its shown text, as the
# value with each byte that is not UTF-8 written by its value.
function written_value(answer: str, marks: i64) -> str
    shown = answer.slice(from: marks, to: answer.len())
    return not_text.bytes_written(
        shown,
        faults: not_text.faults_of(marks: answer.slice(from: 0, to: marks), text: shown)
    )

# This process's own id, as the operating system numbers it: what makes a
# file under `build/` one that no other `heroes` process in the same tree
# writes (defect 057's rule; `cli/publish.hero` names every private file by it).
function pid() -> i64
    return hero_os_pid()

# A number no earlier call in this process has answered: what makes the
# same private file, asked for twice by one process, two names (defect
# 134). It is the runtime's because the language has no mutable global
# (spec § 2), and `_Atomic` there because two threads must not share one.
function serial() -> i64
    return hero_run_serial()

## Tests

# Whether `text` holds `needle` anywhere. **Written here rather than imported,
# and the reason is the language.** `strings.has_text` is the same
# predicate, and `cli_toolchain` imports THIS module — so `use cli_toolchain`
# here is `module_cycle`, whatever the edge carries (CLAUDE.md §11's knot
# clause). Six lines in a test section is the cheaper half of that trade.
function holds(text: str, needle: str) -> bool
    if needle.len() > text.len()
        return false
    at: i64 @ 0

    while at + needle.len() <= text.len()
        if text.slice(from: at, to: at + needle.len()) == needle
            return true
        at @ at + 1

    return false

# **`clang` is the witness on all three platforms, and it is not a shell.**
# These two cases used to name `/bin/echo` and `/bin/sh`, which is 2 of 520
# red on the Windows leg (measured 2026-08-31, run 33381701823) for a reason
# that has nothing to do with what they were testing: those paths do not
# exist there, and `echo` on Windows is a `cmd` builtin rather than a program.
#
# Replacing them with `cmd /c echo` would have thrown the case away — the
# claim is that a word survives WITHOUT a shell, so proving it through one
# proves nothing. `clang` reprints an argument it cannot use, verbatim, and
# exits 1; it is present wherever these tests run at all, because `heroes
# doctor` refuses a machine without it.
test "an argument survives what a shell would have eaten"
    # The three characters `sq()` existed to defend against. Through an
    # argument list they need no defending: the word arrives whole.
    tricky = "a b 'c' $HOME"
    ran = run(program: "clang", words: ["clang", tricky], out: "", err: "build/argv-probe.txt")

    assert ran.started

    back = read_file("build/argv-probe.txt")
    assert !back.is_err()

    # clang says `no such file or directory: '<the argument>'`, so the word
    # comes back through a second process's own diagnostic — spaces, quotes,
    # dollar sign and all. A shell would have split it into four words and
    # expanded the last one.
    assert holds(text: back.must(), needle: tricky)

test "a program that never started is not a program that failed"
    absent = run(program: "heroes-no-such-program", words: ["heroes-no-such-program"], out: "", err: "")
    assert !absent.started

    # And one that ran and failed says so the other way round. The number is
    # not the point and never was — `started` against `code` is.
    failed = run(program: "clang", words: ["clang", "--heroes-no-such-flag"], out: "", err: "build/argv-refused.txt")
    assert failed.started
    assert failed.code != 0

test "the filesystem answers the shell utility's question, not C's"
    root = "build/argv-fs"
    assert !remove_file(root + "/deep/here").is_err()
    assert !mkdir_all(root + "/deep/here").is_err()

    # Twice is success, which is what `mkdir -p` meant.
    assert !mkdir_all(root + "/deep/here").is_err()
    assert is_directory(root + "/deep/here")
    assert path_exists(root + "/deep/here")
    assert !path_exists(root + "/deep/nowhere")

    # Removing what is not there is success, which is what `rm -f` meant.
    assert !remove_file(root + "/deep/nowhere").is_err()

    assert !write_file(path: root + "/from", text: "NEW").is_err()
    assert !write_file(path: root + "/to", text: "OLD").is_err()
    assert !rename_over(from: root + "/from", to: root + "/to").is_err()

    landed = read_file(root + "/to")
    assert !landed.is_err()
    assert landed.must() == "NEW"

test "an unset variable is empty, and a set one is its value"
    assert env(name: "HEROES_NO_SUCH_VARIABLE_EXISTS").must() == ""
    assert env_written(name: "HEROES_NO_SUCH_VARIABLE_EXISTS") == ""
    assert env(name: "PATH").must().len() > 0

# Defect 243: a value that is not UTF-8 is held and named, never read as
# unset. No test can set one, so how it is quoted is asked of the runtime's
# answer for `/nowhere/rt` and the byte 0xE9, its marks first.
test "a value that is not UTF-8 is quoted with each such byte written by its value"
    assert written_value(answer: "E9/nowhere/rt�", marks: 2) == "/nowhere/rt<0xE9>"
    assert written_value(answer: "/plain", marks: 0) == "/plain"
