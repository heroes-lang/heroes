# The header's layout of every group record, asked of clang before any unit
# compiles (design.md §4.19, §1.12; panel 186, defects 150, 151 and 156).
# What is asked and how the answers are read is `emit/layout_screen.hero`
# and `emit/layout_text.hero`; this file runs clang and keeps the answer, as
# `cli/pointee.hero` does.
#
# **One process on a warm build, two on a cold one, four at most.** The screen
# runs once per (compiler, records and what the program does with them, the
# words a probe compiles under, what the headers resolve to and hold), under
# `build/layout-<key>/`, with the headers it read recorded by digest
# (`cli/deps`), so a header that changes asks again and an unchanged one
# costs a read and the one preprocessing run that says what the headers
# resolve to (`compiling.reads`). Only a record the screen cannot vouch for
# is dumped, and the check unit runs only when it holds an assertion.
#
# **The key names every word the three clang runs compile under, from the
# list their lines are built from** (`compiling.probe_words`), each word by
# its length (`libraries.key_text`), **and what the headers resolve to under
# them** (`compiling.reads`; defect 168, 2026-10-02). Until the round of
# 2026-10-02's third gate the key held a package's whole answer joined by
# spaces, so a word holding a space (defect 162) and the two words it spells
# read one verdict (the first test below); until defect 168 it held the
# screen's text, the `--include` directories, a package's compile words and
# the probe's flags, and not the source's own directory, so a program beside
# a same-named header replayed another directory's verdict, both ways on one
# `build/`: a record leaving a member out built at exit 0 and printed a wrong
# value, and the correct program stopped at exit 2, *no member named 'y'*.
# The words come after `words:` and the files after `reads:`, so no key
# written before names the same text.
#
# **What is kept is clang's answers, never this compiler's reading of them**:
# the screen's stderr and the dump, from which the flagged set, the rows this
# compiler asks for (`emit/layout_rows.hero`) and the check unit are
# re-derived on every build, and the verdict keyed by the check unit's own
# text. **A dump over `KEPT_DUMP` bytes is not kept at all**, and is asked of
# clang again on the next build: over a deep by-value nest it is cubic in the
# depth (panel 186's critic, 348 MB at a thousand), and keeping only its
# asked rows was measured to be the stale-reading class above, the lane's own
# reader changed and its kept rows read as the new one's (2026-10-02). A compiler that reads the dump differently therefore asks
# clang again where it must, which is the lesson `cli/pointee.hero` paid for
# on 2026-09-04: the key's fingerprint is the release's `VERSION`, a constant
# between releases, and a kept reading outlives the reader that made it.
#
# **A screen that fails on no record is not this check's to report**: the
# headers did not compile alone, and the build's own compile says so on the
# author's line, exactly as the pointee check leaves it. Nor is a dump that
# does not compile: its wrappers name only the records' own types, which the
# build's field assertions name too.

use ast
use source
use check/state
use ir/containers
use emit/externs as emit_externs
use emit/extern_union
use emit/layout_text
use emit/layout_rows
use emit/layout_screen
use emit/layout_check
use cli/toolchain
use cli/process
use cli/publish
use cli/digest
use cli/deps
use cli/pointee
use cli/compiling
use cli/libraries
use cli/strings
use parse
use resolve
use checker
use ir/lower

# The largest dump kept under `build/`, in bytes: every real header measured
# for panel 186 dumps far below it (`SDL3/SDL.h`, whole, 30 KB), and a
# synthetic nest of three hundred structs passes it (10 MB).
constant KEPT_DUMP: i64
    4194304

# Everything one check asks with.
record Asking
    t: toolchain.Toolchain
    dir: str
    headers: [str]
    s: source.Source
    decls: [ast.Decl]
    c: state.Checked
    u: extern_union.Used
    # Every word the three runs compile under but each run's own
    # (`compiling.probe_words`), the list the key names.
    words: [str]

function check(t: toolchain.Toolchain, p: containers.Program, c: state.Checked, s: source.Source, decls: [ast.Decl], probe: compiling.Probe) -> ()?
    wanted = layout_text.asked(s, decls)

    if wanted.len() == 0
        return ok()

    # Headers that do not preprocess make a screen that fails on no record,
    # which is the build's own compile's to report (below).
    if probe.read.is_err()
        return ok()
    headers = probe.headers
    u = extern_union.used(p, c, decls)
    screen_text = layout_screen.screen_unit(headers, wanted, s, decls, c, u)
    key = digest.digest(
        t.fingerprint + "|layout|" + t.compiler_key + "|" + screen_text + "|words:" + libraries.key_text(probe.words) + "|reads:" + probe.read.must() + "|" + t.runtime_key
    )
    dir = t.build + "/layout-" + key
    listed = dir + "/screen.deps.txt"
    memo: {str: str} @ probe.digests
    known = deps.vouched(listed, @memo)
    a = Asking(t: t, dir: dir, headers: headers, s: s, decls: decls, c: c, u: u, words: probe.words)

    if !known.is_err()
        kept = read_file(dir + "/screen-" + known.must() + ".txt")

        if !kept.is_err()
            return answered(a, wanted: wanted, sum: known.must(), said: kept.must())
    process.mkdir_all(dir)?
    screen_c = pointee.unit_path(dir: dir, stem: "screen", text: screen_text)
    publish.write_whole(path: screen_c, text: screen_text, keyed: true)?
    depfile = publish.private_name(dir + "/screen.d")
    err_path = publish.private_name(dir + "/screen-stderr.txt")
    line: [str] @ ["clang", "-fsyntax-only", "-ferror-limit=0", "-MD", "-MT", "dep", "-MF", depfile]
    line @ searched(a, line: line)
    line @ line.push(screen_c)
    ran = process.run(program: "clang", words: line, out: process.discard(), err: err_path)
    said = read_file(err_path)
    publish.discard(err_path)
    rows = deps.rows_of(depfile: depfile, skip: dir + "/", @memo)
    publish.discard(depfile)

    if !ran.started || said.is_err()
        return ok()

    if ran.code != 0 && layout_screen.flagged(said.must()).len() == 0
        return ok()

    if rows.is_err()
        return fail(code: "failed", msg: "cannot record what the layout check read: " + pointee.failure_note(rows))
    listing = deps.pointer_text(rows.must())
    sum = listing.slice(from: 0, to: 16)
    publish.write_whole(path: dir + "/screen-" + sum + ".txt", text: said.must(), keyed: true)?
    verdict = answered(a, wanted: wanted, sum: sum, said: said.must())
    publish.write_whole(path: listed, text: listing, keyed: true)?
    return verdict

# From what the screen said: the records it could not vouch for, their
# layout (kept under the digest of the unit that asked for it), and the
# check unit that layout gives. A record named after a typedef whose type
# has no layout is refused first, by the screen's own two answers, unless
# clang erred outside the screen too: then the headers did not compile
# alone, and the program's own compile says so on the author's line.
function answered(a: Asking, wanted: [layout_text.Asked], sum: str, said: str) -> ()?
    opaque = layout_screen.no_layout(said, wanted: wanted)

    if opaque.len() > 0 && !layout_screen.strays(said)
        return refused_opaque(a, opaque: opaque)
    flagged = layout_screen.flagged(said)
    dumped: [layout_text.Asked] @ []

    for one in wanted
        if !flagged[one.decl].is_err()
            dumped @ dumped.push(one)

    if dumped.len() == 0
        return ok()
    dump_text = layout_text.dump_unit(a.headers, wanted: dumped)
    kept_path = a.dir + "/clang-dump-" + sum + "-" + digest.digest(dump_text) + ".txt"
    kept = read_file(kept_path)
    rows: str @ ""

    if !kept.is_err()
        rows @ layout_rows.wrapper_rows(kept.must()).join("\n") + "\n"
    else
        made = dump(a, dump_text: dump_text)

        # A dump that did not compile names a record the build's own
        # compile refuses on the author's line (every group record's type is
        # in its field assertions), so nothing is said or kept here.
        if made.is_err()
            return ok()
        rows @ layout_rows.wrapper_rows(made.must()).join("\n") + "\n"

        if made.must().len() <= KEPT_DUMP
            publish.write_whole(path: kept_path, text: made.must(), keyed: true)?
    text = layout_check.check_unit(a.headers, dump: rows, wanted: dumped, s: a.s, decls: a.decls, u: a.u, c: a.c)?
    return judged(a, sum: sum, text: text)

# **A record named after a typedef whose type has no layout, refused here,
# before any unit compiles** (defect 191, 2026-10-02): the screen's two
# questions said where clang erred, which is the verdict, and the type behind
# the name is read from clang's JSON over `layout_screen.type_unit`, which is
# only its text. Until then such a record met clang first at the unit's field
# assertions, and the reader of that refusal found the record only by the
# typedef's name in clang's words, written by clang 21 and not by clang 18:
# the public CI's Linux leg stopped at exit 2. Each line is the marker
# `emit/ffi_incomplete.hero` reads into `ffi_unknown_tag`; a JSON that names
# no type leaves the type unsaid, never the refusal.
function refused_opaque(a: Asking, opaque: [layout_text.Asked]) -> ()?
    text = layout_screen.type_unit(a.headers, wanted: opaque)
    process.mkdir_all(a.dir)?
    unit = pointee.unit_path(dir: a.dir, stem: "type", text: text)
    publish.write_whole(path: unit, text: text, keyed: true)?
    out_path = publish.private_name(a.dir + "/type.json")
    line: [str] @ [
        "clang"
        "-fsyntax-only"
        "-Xclang"
        "-ast-dump=json"
        "-Xclang"
        "-ast-dump-filter=" + layout_screen.TYPED
    ]
    line @ searched(a, line: line)
    line @ line.push(unit)
    ran = process.run(program: "clang", words: line, out: out_path, err: process.discard())
    json = read_file(out_path)
    publish.discard(out_path)
    said: [str] @ []

    for one in opaque
        behind: str @ ""

        if ran.started && ran.code == 0 && !json.is_err()
            behind @ layout_screen.behind_of(json.must(), decl: one.decl).default("")
        said @ said.push(layout_screen.NO_LAYOUT + " " + source.span_text(a.s, a.decls[one.decl].name) + " " + behind)

    return fail(code: "clang", msg: said.join("\n") + "\n")

# clang's record-layout dump for the unit, or absent when it did not compile.
function dump(a: Asking, dump_text: str) -> str?
    dump_c = pointee.unit_path(dir: a.dir, stem: "dump", text: dump_text)
    publish.write_whole(path: dump_c, text: dump_text, keyed: true)?
    out_path = publish.private_name(a.dir + "/dump.txt")
    err_path = publish.private_name(a.dir + "/dump-stderr.txt")
    line: [str] @ ["clang", "-fsyntax-only", "-Xclang", "-fdump-record-layouts"]
    line @ searched(a, line: line)
    line @ line.push(dump_c)
    ran = process.run(program: "clang", words: line, out: out_path, err: err_path)
    dumped_text = read_file(out_path)
    publish.discard(out_path)
    publish.discard(err_path)

    if !ran.started || ran.code != 0 || dumped_text.is_err()
        return fail(code: "unread", msg: "the dump did not compile")
    return ok(dumped_text.must())

# The check unit's verdict, kept under the digest of its own text: a compiler
# that writes the assertions differently never reads another's answer.
function judged(a: Asking, sum: str, text: str) -> ()?
    if text.len() == 0
        return ok()
    verdict = a.dir + "/verdict-" + sum + "-" + digest.digest(text) + ".txt"
    kept = read_file(verdict)

    if !kept.is_err()
        if kept.must() == "ok\n"
            return ok()
        return fail(code: "clang", msg: kept.must())
    check_c = pointee.unit_path(dir: a.dir, stem: "check", text: text)
    publish.write_whole(path: check_c, text: text, keyed: true)?
    err_path = publish.private_name(a.dir + "/check-stderr.txt")
    line: [str] @ ["clang", "-fsyntax-only", "-ferror-limit=0"]
    line @ searched(a, line: line)
    line @ line.push(check_c)
    checked = toolchain.run_clang(
        line: line,
        what: "checking the header's layout of the group records",
        err_path: err_path
    )
    publish.discard(err_path)

    if checked.is_err() && code_of(checked) != "clang"
        return checked
    said: str @ "ok\n"

    if checked.is_err()
        said @ pointee.failure_text(checked)
    publish.write_whole(path: verdict, text: said, keyed: true)?

    if checked.is_err()
        return fail(code: "clang", msg: said)
    return ok()

function searched(a: Asking, line: [str]) -> [str]
    return strings.with_all(list: line, more: a.words)

function code_of(failed: ()?) -> str
    match failed
        .ok    => return ""
        .err e => return e.code

## Tests

# The probe a round would hand the check for this program: its words under
# `under`, its headers, and what they resolve to now (`compiling.probe`).
function probing(t: toolchain.Toolchain, p: containers.Program, s: source.Source, decls: [ast.Decl], under: compiling.Compiling) -> compiling.Probe
    return compiling.probe(t.build, under: under, headers: emit_externs.headers(p, s, decls))

# **A package's compile words reach the layout check, each one whole, and
# its verdict is keyed by them** (defects 161 and 162 at the layout check,
# reconciled at the round of 2026-10-02's third gate). The header gives its
# record a second member under a macro a package defines. One word holding
# a space defines another macro and not that one, and the two words it
# spells define both, so the record is whole under the first answer and
# leaves a member with bytes out under the second; joined by a space the
# two answers are one text, and a key made of that text replayed the first's
# verdict for the second, a record that leaves four bytes out read as
# complete.
test "a package's words reach the layout check each one whole, and its verdict is keyed by them (defects 161 and 162)"
    text = "extern \"extra.h\"\n    record EXTRA\n        x: i32\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-layout-package"
    headers_at = "build/selftest-layout-package-include"
    assert !process.remove_tree(t.build).is_err()
    assert !process.mkdir_all(headers_at).is_err()
    header = "#include <stdint.h>\ntypedef struct {\n    int32_t x;\n#ifdef HERO_EXTRA\n    int32_t y;\n#endif\n} EXTRA;\n"
    assert !write_file(path: headers_at + "/extra.h", text: header).is_err()

    # One word: `HERO_A` means `1 -DHERO_EXTRA`, `HERO_EXTRA` is not
    # defined, and the record is whole.
    one_word = check(
        t,
        low.program,
        c,
        s,
        parsed.decls,
        probe: probing(t, low.program, s, parsed.decls, under: compiling.Compiling(search_include: [headers_at], package_flags: ["-DHERO_A=1 -DHERO_EXTRA"], runtime: t.runtime, source_dir: ""))
    )
    assert !one_word.is_err()

    # The two words it spells, in the same `build/`: `y` is left out with
    # its four bytes, and clang is asked again and says so.
    two_words = check(
        t,
        low.program,
        c,
        s,
        parsed.decls,
        probe: probing(t, low.program, s, parsed.decls, under: compiling.Compiling(search_include: [headers_at], package_flags: ["-DHERO_A=1", "-DHERO_EXTRA"], runtime: t.runtime, source_dir: ""))
    )
    assert two_words.is_err()
    assert layout_rows.byte_index(text: pointee.failure_text(two_words), needle: "heroes-ffi-missing EXTRA y") > 0

    # A link word is no probe's: the same compile words read the verdict
    # already published, and nothing new is written.
    held = process.files_under(t.build).must().len()
    linked = check(
        t,
        low.program,
        c,
        s,
        parsed.decls,
        probe: probing(t, low.program, s, parsed.decls, under: compiling.Compiling(search_include: [headers_at], package_flags: ["-DHERO_A=1", "-DHERO_EXTRA", "-lz"], runtime: t.runtime, source_dir: ""))
    )
    assert pointee.failure_text(linked) == pointee.failure_text(two_words)
    assert process.files_under(t.build).must().len() == held

# **The verdict is keyed by the source's own directory and by what the
# header resolves to** (defect 168, `scratchpad/file-queue/source-dir-key/`'s
# shape). One program of one declaring file name beside two headers of one
# name: in one the struct is the record's whole, in the other it has a `y`
# the record leaves out. In one `build/`, in both orders, each is asked of
# its own header; and a header of that name that appears in an `--include`
# directory, searched before the source's, is asked again rather than
# answered by the record of the one it shadows. Measured before this
# repair: the second directory replayed the first's verdict, a record that
# leaves `y` out read as complete, and the whole one refused.
test "the layout check asks each directory's own header, and one that appears earlier in the search, in one build (defect 168)"
    text = "extern \"xy.h\"\n    record XY\n        x: i32\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    root = "build/selftest-layout-dirs"
    assert !process.remove_tree(root).is_err()
    whole = root + "/whole"
    wider = root + "/wider"
    inc = root + "/inc"

    for dir in [whole, wider, inc]
        assert !process.mkdir_all(dir).is_err()

    assert !write_file(path: whole + "/xy.h", text: "#include <stdint.h>\ntypedef struct { int32_t x; } XY;\n").is_err()
    assert !write_file(path: wider + "/xy.h", text: "#include <stdint.h>\ntypedef struct { int32_t x; int32_t y; } XY;\n").is_err()
    none: [str] = []

    for first in [whole, wider]
        t.build @ first + "-first"
        assert !process.remove_tree(t.build).is_err()
        second: str @ wider

        if first == wider
            second @ whole

        for dir in [first, second]
            asked = check(
                t,
                low.program,
                c,
                s,
                parsed.decls,
                probe: probing(t, low.program, s, parsed.decls, under: compiling.Compiling(search_include: none, package_flags: none, runtime: t.runtime, source_dir: dir))
            )

            if dir == wider
                assert layout_rows.byte_index(text: pointee.failure_text(asked), needle: "heroes-ffi-missing XY y") > 0
            else
                assert !asked.is_err()

    # The source's `xy.h` is the whole one; then the one with `y` appears in
    # the `--include` directory, which a unit's compile searches first.
    t.build @ root + "/build-shadow"
    assert !process.remove_tree(t.build).is_err()
    under = compiling.Compiling(search_include: [inc], package_flags: none, runtime: t.runtime, source_dir: whole)
    assert !check(t, low.program, c, s, parsed.decls, probe: probing(t, low.program, s, parsed.decls, under: under)).is_err()
    assert !write_file(path: inc + "/xy.h", text: "#include <stdint.h>\ntypedef struct { int32_t x; int32_t y; } XY;\n").is_err()
    shadowed = check(t, low.program, c, s, parsed.decls, probe: probing(t, low.program, s, parsed.decls, under: under))
    assert layout_rows.byte_index(text: pointee.failure_text(shadowed), needle: "heroes-ffi-missing XY y") > 0

# **A record named after a typedef whose type has no layout is refused by
# the layout check itself, on the screen's two positions** (defect 191). A
# typedef of an opaque struct and one of `void` are refused naming the type
# behind them, which clang's JSON gave; a typedef of a whole struct is not;
# and a record with a tag over the opaque struct is left to the unit's
# readers, which read what the header spells. Measured before this repair:
# the check said nothing of the first two, and the unit's field assertions
# met them, worded apart by clang 18 and 21.
test "the layout check refuses a record named after a typedef with no layout, naming the type behind it (defect 191)"
    t: toolchain.Toolchain @ toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-layout-opaque"
    headers_at = "build/selftest-layout-opaque-include"
    assert !process.remove_tree(t.build).is_err()
    assert !process.mkdir_all(headers_at).is_err()
    header = "#include <stdint.h>\ntypedef struct opaque_s opaque_t;\ntypedef void void_t;\ntypedef struct { int32_t a; } whole_t;\n"
    assert !write_file(path: headers_at + "/op.h", text: header).is_err()
    none: [str] = []

    for named in ["opaque_t", "void_t", "whole_t", "Tagged tag opaque_s"]
        text = "extern \"op.h\"\n    record " + named + "\n        a: i32\n\nfunction main()\n    print(1)\n"
        parsed = parse.parse(text)
        s = source.new_source(name: "t.hero", text: text)
        out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
        c = checker.check(parsed.tree, out, s, parsed.decls)
        assert c.diagnostics.len() == 0
        low = lower.lower(parsed.tree, out, c, s, parsed.decls)
        under = compiling.Compiling(
            search_include: [headers_at],
            package_flags: none,
            runtime: t.runtime,
            source_dir: ""
        )
        said = pointee.failure_text(
            check(t, low.program, c, s, parsed.decls, probe: probing(t, low.program, s, parsed.decls, under: under))
        )

        if named == "opaque_t"
            assert said == layout_screen.NO_LAYOUT + " opaque_t struct opaque_s\n"
        else if named == "void_t"
            assert said == layout_screen.NO_LAYOUT + " void_t void\n"
        else
            assert layout_rows.byte_index(text: said, needle: layout_screen.NO_LAYOUT) < 0

# **A member with no bytes is complete only where C says it has none**
# (panel 186 R4; defect 151, the Windows box's pre-push leg, 2026-10-02). An
# empty struct is a GNU extension whose size is the target's: 0 for a GNU
# target and 4 for MSVC's, measured on the box with its clang 23.1.1 and
# here by asking this machine's clang for both. So a record that leaves one
# out is complete on one and refused on the other, both verdicts C's, from
# the one assertion `emit/layout_check.hero` writes; the zero-length array
# beside it has no bytes on both, which is all
# `run/fixedbugs-151-members-with-no-bytes-left-out` may hold. clang answers
# for a foreign target with no header, so the case reads the same on every
# leg, the box included.
test "a left-out empty struct is missing for MSVC's target and complete for a GNU one, a zero-length array complete for both"
    text = "extern \"ze.h\"\n    record ZE\n        x: i32\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    u = extern_union.used(low.program, c, parsed.decls)

    # The record's block as clang dumps it for a GNU target, which proposes
    # the names; every verdict below is C's arithmetic for the target asked.
    gnu_dump = "         0 | struct hero_ly_0\n         0 |   ZE v\n         0 |     struct hero_empty e\n         0 |     int[0] z\n         0 |     int x\n           | [sizeof=4, align=4]\n"
    rows = layout_rows.rows_of(gnu_dump)
    tree = layout_text.members(rows: rows, from: layout_text.heads(rows)[0].must()).must()
    no_sizes: {str: i64} @ {}
    asked = layout_check.record_lines(
        layout_text.asked(s, parsed.decls)[0],
        hero_name: "ZE",
        tree: tree,
        decls: parsed.decls,
        u: u,
        s: s,
        c: c,
        sizes: no_sizes
    )
    assert asked.len() == 2
    assert !process.mkdir_all("build").is_err()
    unit = "build/selftest-layout-empty.c"
    said = "build/selftest-layout-empty.txt"
    header = "struct hero_empty { };\ntypedef struct { struct hero_empty e; int z[0]; int x; } ZE;\n"
    assert !write_file(path: unit, text: header + asked.join("\n") + "\n").is_err()
    msvc = process.run(
        program: "clang",
        words: ["clang", "--target=x86_64-pc-windows-msvc", "-std=gnu11", "-fsyntax-only", "-ferror-limit=0", unit],
        out: process.discard(),
        err: said
    )
    assert msvc.started
    assert msvc.code != 0
    refused = read_file(said).must()
    assert layout_rows.byte_index(text: refused, needle: "heroes-ffi-missing ZE e") > 0
    assert layout_rows.byte_index(text: refused, needle: "heroes-ffi-missing ZE z") < 0
    gnu = process.run(
        program: "clang",
        words: ["clang", "--target=x86_64-linux-gnu", "-std=gnu11", "-fsyntax-only", "-ferror-limit=0", unit],
        out: process.discard(),
        err: process.discard()
    )
    assert gnu.started
    assert gnu.code == 0
