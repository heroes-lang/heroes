# heroes mutate [dir] — metric 3, offline (design.md Part 11).
#
# Port of archive/bootstrap-rs/heroes-cli/src/commands/mutate.rs. Takes every program in the
# corpus that checks clean, makes **one plausible mistake per site**, and counts
# how many the compiler catches — in two arms, so the number means something. A
# language that rejects everything would score 100% and prove nothing, which is
# why the control arm (`--permissive`, the same compiler with the thesis rules
# dropped) is printed beside it.
#
# THE CORPUS IS THE CLEAN PROGRAMS. Mutating a program that is already wrong
# measures nothing, because the compiler would reject the mutant for the mistake
# that was already there — so a corpus that does not compile is **refused at
# exit 2** rather than quietly narrowed (author decision 2026-08-12, after
# `heroes mutate` reported 77 sites and 100% killed over a directory `heroes
# check` refuses).
#
# THE DIRECTORY WALK IS `find -print0`, AND THAT IS MEASURED RATHER THAN
# PREFERRED. Heroes has no directory API (§1.11 — everything comes from C), and
# the cheap route is unsound: `ls > file` plus `read_file` **splits a filename
# containing a newline into two entries at exit 0**, which CLAUDE.md §12's
# robustness rule forbids. NUL is the one byte a filename cannot hold, a Heroes
# `str` carries it through `read_file` and byte indexing without trouble, and
# `tests/harness/shell.hero` measured the same route on both compilers
# (DESIGN-LOG:389).

use bytes
use cli/argv
use cli/io
use cli/table as cli_table
use cli/process
use library_source
use modules
use mutate/ops
use mutate/score

constant DEFAULT_DIR: str
    "examples"

function run(inv: argv.Invocation) -> cli_table.Exit
    only: str @ argv.value_of(inv, spelling: "--operator").default("")

    if only.len() > 0 && !ops.known(only)
        io.eprint(
            text: "error: no operator `" + only + "`\n  the " + ops.ids().len().to_str() + " are: " + ops.ids().join(", ")
        )
        return .failed_exit
    dir = inv.file.default(DEFAULT_DIR)
    found = corpus(dir)

    if found.is_err()
        io.eprint(text: "error: " + why(found))
        return .failed_exit
    sources = found.must()

    if sources.len() == 0
        io.eprint(text: "error: no `.hero` files under " + dir)
        return .failed_exit
    library = library_source.text()
    refusal = refuse_a_corpus_that_does_not_compile(sources: sources, library: library)

    if !refusal.is_err()
        io.eprint(text: "error: " + refusal.must())
        return .failed_exit
    print("corpus: " + sources.len().to_str() + " programs under " + dir + "\n")
    run_out = score.scored(sources: sources, only: only, library: library)
    io.print_artifact(text: score.report(run_out.scores))

    if argv.has(inv, spelling: "--survivors")
        io.print_artifact(text: score.survivor_report(run_out.survivors))
    return .ok_exit

# Every `.hero` file under `dir`, sorted, with its text.
#
# **This was the last `find` in `selfhost/`, and Windows is why it is gone.**
# `FIND.EXE` there is a text-search tool that happens to share the name — the
# same two-meanings shape as `TIMEOUT.EXE`, measured the same day — so
# `heroes mutate` answered `cannot read examples/gallery` on a directory it
# was standing in. The runtime's own walk answers on every platform, needs no
# `-print0` (a name never becomes text on its way here, so there is no
# separator to be confused by), and the listing file under `build/` goes with
# it.
function corpus(dir: str) -> [score.Program]?
    walked = process.files_under(dir: dir)

    if walked.is_err()
        return fail(code: "no_corpus", msg: unread_corpus(dir))
    paths: [str] @ []

    for path in walked.must()
        if ends_hero(path)
            paths @ paths.push(path)

    out: [score.Program] @ []

    for path in paths.sort()
        text = read_file(path)

        if text.is_err()
            return fail(code: "no_corpus", msg: "cannot read " + path)
        out @ out.push(score.Program(name: path, checked_as: checked_name(dir: dir, path: path), text: text.must()))

    return ok(out)

# Why `dir` gave no corpus, named by what the path is. Every cause read
# `cannot read <path>` until defect 117, a file the command reads perfectly
# well included, which sent the reader looking for a permission or a missing
# file that was not there (design.md §4.17). The walk fails on a file
# because it walks a directory; the message says so, and says what to name.
function unread_corpus(dir: str) -> str
    if !process.path_exists(path: dir)
        return "no file or directory is named " + dir

    if !process.is_directory(path: dir)
        return dir + " is a file, and `heroes mutate` reads a directory of programs: name the directory that holds it"
    return "cannot read the directory " + dir

# The name a corpus file is COMPILED under: itself, unless it sits below a
# program's root — then the root directory plus its own file name, with its
# own text. `use geom/point` in `examples/shapes/geom/area.hero` is read from
# `examples/shapes/`, because that is where the compiler reads it when the
# program is compiled from `main.hero` (panel 099 R1); checked from its own
# directory the same line is `unknown_module`, which is R5's stated hazard
# and what `heroes check` on the leaf alone says. The root is the nearest
# directory at or above the file, no higher than `dir`, that holds a
# `main.hero` — `dir` included, so `mutate examples/shapes` finds it too.
#
# Found by M-corpus-depth step 0: this walk checked every file under its own
# directory, two of `examples/shapes/`'s modules were refused, and the whole
# corpus with them — for a day, because nothing ran `mutate` over `examples/`
# (measurement 014). The survivor listing keeps the real path: a site is
# reported where the author can open it.
function checked_name(dir: str, path: str) -> str
    own = modules.open_directory(path)
    file = path.slice(from: own.len(), to: path.len())
    floor = with_slash(dir)
    at: str @ own

    while at.len() >= floor.len()
        if !read_file(at + "main.hero").is_err()
            return at + file

        if at.len() == floor.len()
            return path
        at @ parent_of(at)

    return path

# `dir` as a directory prefix: one trailing `/`, added if the caller did not.
# The last BYTE is compared, so a name ending in a multibyte character is
# neither split nor aborted on.
function with_slash(dir: str) -> str
    if dir.len() == 0
        return ""

    if dir[dir.len() - 1] == '/'
        return dir
    return dir + "/"

# The directory above `directory` (which ends with `/`), ending with `/` too
# — "" above a top-level one. Strictly shorter than its input, which is what
# makes `checked_name`'s walk end.
function parent_of(directory: str) -> str
    return modules.open_directory(directory.slice(from: 0, to: directory.len() - 1))

# `.hero` at the end, asked of the bytes so a multibyte name neither matches
# nor aborts. **This comment said so while the code sliced** (found beside
# defect 110, 2026-09-27): a file named `cafés.md` in the corpus put the cut
# inside its `é`, and `heroes mutate` aborted before reading a program.
function ends_hero(path: str) -> bool
    tail = ".hero"
    return bytes.bytes_at(text: path, at: path.len() - tail.len(), needle: tail)

# Every program in the corpus must compile BEFORE anything is mutated. Every
# offending file is listed rather than the first, because a corpus is usually
# wrong in one way and fixing it one error per run is the slowest possible loop.
function refuse_a_corpus_that_does_not_compile(sources: [score.Program], library: str) -> str?
    refused: [str] @ []

    for one in sources
        if !score.base_checks_clean(name: one.checked_as, text: one.text, library: library)
            refused @ refused.push(one.name)

    if refused.len() == 0
        return fail(code: "clean", msg: "every program compiles")
    lines: [str] @ [
        "this corpus does not compile, so its kill rate would be meaningless\n  " + refused.len().to_str() + " of " + sources.len().to_str() + " programs are already refused by `heroes check`:\n"
    ]

    for name in refused
        lines @ lines.push("    " + name + "\n")

    return ok(
        lines.join("") + "  every mutant of a program that is already wrong is killed by the\n  diagnostic that was already there — run `heroes check` on each"
    )

function why(got: [score.Program]?) -> str
    return match got
        .ok _  => ""
        .err e => e.msg

test "a corpus that is not a directory says what it is, where every cause read `cannot read` (defect 117)"
    assert unread_corpus("no/such/place") == "no file or directory is named no/such/place"
    assert unread_corpus("runtime/runtime.c") == "runtime/runtime.c is a file, and `heroes mutate` reads a directory of programs: name the directory that holds it"
    walked = process.files_under(dir: "runtime")
    assert !walked.is_err()

test "an unknown operator names the ones there are"
    # The count is read off the table, never written: it said "twelve" in the
    # bootstrap's help while there were thirteen (CLAUDE.md §11).
    # 13 -> 14 on 2026-09-04, `local-takes-a-module`. **Two places pinned
    # this number and only one of them was in `ops.hero`** — the file whose
    # own comment says the count is read and never written. This assert is
    # the second, and it is kept rather than deleted for the reason the help
    # text needs it: the message below quotes the count to the author, so a
    # table that grew without it would print a lie in a diagnostic.
    # 14 -> 15 on 2026-09-12, `typo-key` (panel 132).
    # 15 -> 16 on 2026-09-13, `swap-ptr` (panel 145), the operator that lands
    # before the handle form it measures.
    assert ops.ids().len() == 16
    assert !ops.known("swapargs")

test "a module below a nested program's root is checked from the root, the nearest one no higher than the corpus"
    # Panel 099 R5's own fixture: a root, a leaf under lib/, and a decoy
    # program inside it with a main.hero of its own.
    nested = "tests/golden/surface-fixtures/nested"

    # The leaf's stand-in sits beside main.hero; the root's own files are themselves.
    assert checked_name(dir: nested, path: nested + "/lib/leaf.hero") == nested + "/leaf.hero"
    assert checked_name(dir: nested, path: nested + "/main.hero") == nested + "/main.hero"
    assert checked_name(dir: nested, path: nested + "/util.hero") == nested + "/util.hero"

    # The NEAREST root wins: the decoy has its own main.hero.
    assert checked_name(dir: nested, path: nested + "/decoy/lib/leaf.hero") == nested + "/decoy/leaf.hero"

    # The walk never climbs above the corpus directory: pointed at lib/ alone,
    # the leaf has no root and is itself — which `heroes check` then refuses,
    # and the corpus with it, as it should.
    assert checked_name(dir: nested + "/lib", path: nested + "/lib/leaf.hero") == nested + "/lib/leaf.hero"

    # A trailing slash on the corpus directory changes nothing.
    assert checked_name(dir: nested + "/", path: nested + "/lib/leaf.hero") == nested + "/leaf.hero"

    # No main.hero anywhere above it inside the corpus: the gallery's shape.
    assert checked_name(dir: "examples", path: "examples/gallery/00-first.hero") == "examples/gallery/00-first.hero"

test "parent_of climbs one directory and ends above the top"
    assert parent_of("examples/shapes/geom/") == "examples/shapes/"
    assert parent_of("examples/") == ""
    assert with_slash("examples") == "examples/"
    assert with_slash("examples/") == "examples/"
    assert with_slash("") == ""

test "a corpus file is a program by its last five bytes, whatever comes before them"
    assert ends_hero("examples/a.hero")
    assert ends_hero("café/é.hero")
    assert !ends_hero("cafés.md")
    assert !ends_hero("é.txt")
    assert !ends_hero("😀")
    assert !ends_hero(".her")
    assert !ends_hero("")
