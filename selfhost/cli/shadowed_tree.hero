# Who included each file a unit reads, for the refusal of a file standing in
# for a header of the C library that only a group's header reaches (design.md
# §4.19, §1.12; panel 237's R2, defect 2343, 2026-11-08).
#
# **What it closes, measured on this Mac.** The refusal listed the runtime's
# opening alone (`cli/shadowed.hero`), so a library header that only a
# group's header reaches was read from a folder the build names unrefused: a
# program binding `stdio.h`'s `BUFSIZ` beside its own `_stdio.h`, which the
# SDK's `stdio.h` includes, printed 7 where the SDK says 1024; and a program's
# own `lib.h` including `<stdio.h>`, beside the program's own `stdio.h`,
# printed 7 and 14.
#
# **The refusal's one clang run lists the runtime's opening and then the
# program's groups inside the guard** (`text`), with `-H`, which prints each
# file clang enters with its depth in dots, and `-MG`, so a group's missing
# header costs the listing nothing. The opening comes first, so a library
# header the runtime reads is entered beneath the runtime, and one only a
# group reaches beneath that group. A file of a folder the build names is
# then (`shadows`, the compiler-engineer's route):
#
# - **the program's own where the unit includes it for a group**: the header a
#   group names is the program's choice, read from where the program put it,
#   even one named like the library's (a `stdio.h` beside a group naming
#   `stdio.h`, the sitting's ruling); every other file the unit includes is
#   the runtime's, and one found in a named folder stands in for it;
# - **refused where a header that is no named folder's includes it**, the
#   platform's or the runtime's: `_stdio.h` beneath the SDK's `stdio.h`;
# - **refused where a platform folder holds a file of its name**, whoever
#   includes it: `stdio.h` beneath the program's `lib.h`; unless the includer
#   names it in quotes and it stands beside the includer, C's own rule for a
#   header's sibling. The angle form asks the system's places for a name the
#   platform holds, so a program's `money.h` writing `#include <util.h>` for
#   its own `util.h` is refused, its note naming the quoted form (panel 237's
#   ruling; CERT C's PRE04-C);
# - and a file `-M` lists and `-H` does not, found by `__has_include` alone, is
#   refused wherever a named folder found it, the landed rule, and told as a
#   file a header only asks after (`asked`, defect 2356): its words said the
#   C this compiler writes reads it, where nothing does.

use cli/deps
use cli/order_trial
use cli/package_reads
use cli/process
use cli/stand_in
use cli/strings
use emit/c_text
use emit/clang_place
use emit/macro_guard
use module/reading as file_reading

# The words the refusal's run adds where it lists a group's headers.
constant WORDS: [str]
    ["-H", "-MG"]

# The runtime's opening, then every group's header inside the guard, as a
# unit reads them, the opening first.
function text(headers: [str]) -> str
    no_names: {str: bool} = {}
    lines: [str] @= [order_trial.opening([], question: "")]

    for line in macro_guard.around(c_text.includes(headers), bound: no_names)
        lines @ lines.push(line)

    return lines.join("\n") + "\n"

# One line of clang's `-H`: how deep the file was included, and its path as
# clang wrote it.
record Entry
    depth: i64
    path: str

# The `-H` lines of what clang said: one or more dots, a space, a path,
# written as a C string literal's text (`unwritten`).
function entries(said: str) -> [Entry]
    out: [Entry] @= []

    for row in deps.lines(said)
        line = clang_place.without_return(row)
        dots: i64 @= 0

        while dots < line.len() && line[dots] == '.'
            dots @ dots + 1

        if dots > 0 && dots + 1 < line.len() && line[dots] == ' '
            out @ out.push(Entry(depth: dots, path: unwritten(line.slice(from: dots + 1, to: line.len()))))

    return out

# **A path as `-H` writes it, read back**: clang writes each path as a C
# string literal's text (`Lexer::Stringify`), a `\` before a `\` or a `"`, so
# on Windows `build\\evil\\lib.h` is `build\evil\lib.h`, which the refusal
# named `build/evil//lib.h` and could not open to read its includes until
# then (defect 2359, measured on the Windows box with clang 23.1.1).
function unwritten(path: str) -> str
    pieces: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < path.len()
        if path[at] == '\\' && at + 1 < path.len() && (path[at + 1] == '\\' || path[at + 1] == '"')
            pieces @ pieces.push(path.slice(from: start, to: at))
            start @ at + 1
            at @ at + 2
        else
            at @ at + 1

    return pieces.push(path.slice(from: start, to: path.len())).join("")

# **Each file of a named folder the tree reads in another header's place**,
# by the rule above; `groups` the headers the groups name, `named` and
# `others` as `stand_in.finder` reads them, `others[0]` the runtime's.
function shadows(said: str, paths: [str], groups: [str], named: [str], others: [str]) -> [stand_in.Shadow]
    out: [stand_in.Shadow] @= []
    seen: {str: bool} @= {}

    # The file each depth's last entry is, the unit's own at depth 0, so a
    # file's includer is the entry one level up.
    chain: [str] @= [""]

    for one in entries(said)
        while chain.len() > one.depth
            chain @ chain.slice(from: 0, to: chain.len() - 1)

        reader = chain[chain.len() - 1]
        chain @ chain.push(one.path)
        path = package_reads.lexical(one.path)
        folder = stand_in.finder(path: path, named: named, others: others)

        if folder.len() > 0 && seen[path].is_err()
            seen[path] @ true
            name = stand_in.relative(path: path, dir: folder)
            told = refused(one, reader: reader, name: name, groups: groups, named: named, others: others)

            if !told.is_err()
                out @ out.push(
                    stand_in.Shadow(path: one.path, folder: folder, named: name, reader: told.must().reader, beside: told.must().beside, asked: false)
                )

    for written in paths
        path = package_reads.lexical(written)
        folder = stand_in.finder(path: path, named: named, others: others)

        if folder.len() > 0 && seen[path].is_err() && process.path_exists(written)
            seen[path] @ true
            out @ out.push(
                stand_in.Shadow(path: written, folder: folder, named: stand_in.relative(path: path, dir: folder), reader: "", beside: false, asked: true)
            )

    return out

# What a refusal says of a file's includer: who it is, "" for the C this
# compiler writes, and whether the file stands beside it, found by the angle
# form where the quoted one would mean it.
record Reader
    reader: str
    beside: bool

# Why a file `name` of a named folder, included by `reader`, is refused, or
# none where it is the program's own.
function refused(one: Entry, reader: str, name: str, groups: [str], named: [str], others: [str]) -> Reader?
    if one.depth == 1
        if of_group(path: one.path, groups: groups)
            return fail(code: "own", msg: "the header a group names")
        return ok(Reader(reader: "", beside: false))
    from = package_reads.lexical(reader)
    by_named = stand_in.finder(path: from, named: named, others: others).len() > 0

    if !by_named
        return ok(Reader(reader: told_reader(from, others: others), beside: false))

    if !twin(others, name: name)
        return fail(code: "own", msg: "a name the platform does not hold")
    path = package_reads.lexical(one.path)
    beside = folder_of(from) == folder_of(path)

    if beside && quoted(reader: reader, path: path, name: name)
        return fail(code: "own", msg: "the includer's own sibling, named in quotes")
    return ok(Reader(reader: "`" + clang_place.slashed(reader) + "`", beside: beside))

# **Whether a file the unit includes is a group's header**, by the path clang
# printed: the folder that found it, as written, then `/` and the header as
# the group wrote it, so `<./x.h>` and `<sub/x.h>` are their groups' as `<x.h>`
# is (defect 158's `./fixedbugs-158-angle.h` was refused as the runtime's when
# its name was read from its folder).
function of_group(path: str, groups: [str]) -> bool
    written = clang_place.slashed(path)

    for header in groups
        if written == header || strings.ends_with(text: written, suffix: "/" + header)
            return true

    return false

# An includer as a refusal names it: "" for the runtime's, which the landed
# sentence tells, a platform header by the name it has there, `<stdio.h>`.
function told_reader(from: str, others: [str]) -> str
    if package_reads.holds(dir: others[0], path: from)
        return ""

    for dir in others
        if package_reads.holds(dir: dir, path: from)
            return "the C library's `<" + stand_in.relative(path: from, dir: dir) + ">`"

    return "`" + from + "`"

# Whether a platform folder, any of `others` but the runtime's, holds a file
# `name` names.
function twin(others: [str], name: str) -> bool
    at: i64 @= 1

    while at < others.len()
        if process.path_exists(others[at] + "/" + name)
            return true
        at @ at + 1

    return false

# **Whether `reader` includes the file at `path` in quotes**: what clang's
# `-H` cannot say, so the includer's text is read. A quoted spelling names the
# file where, read from the includer's own folder, it is `path`, which is
# where C looks first (`curl/curl.h`'s `#include "curlver.h"` for its
# `curl/curlver.h`, refused until defect 2420, since the spelling was asked to
# be the name the folder that found it gives the file); or where it is that
# name, `name`, which the search finds in the folder (`"curl/curlver.h"`).
# `path` is lexical.
function quoted(reader: str, path: str, name: str) -> bool
    read = file_reading.source_text(reader)

    if read.is_err()
        return false
    from = folder_of(package_reads.lexical(reader))

    for spelled in quoted_spellings(read.must().text)
        if spelled == name || package_reads.lexical(from_folder(folder: from, spelled: spelled)) == path
            return true

    return false

# What each `#include "..."` of a header's text spells between its quotes,
# any spaces around the `#` and before the quote; `#include_next`, which
# skips the includer's own folder, and the angle form are none.
function quoted_spellings(header: str) -> [str]
    out: [str] @= []
    word = "include"

    for line in deps.lines(header)
        written = strings.trimmed(line)

        if strings.starts_with(text: written, prefix: "#")
            rest = strings.trimmed(written.slice(from: 1, to: written.len()))
            spaced = rest.len() > word.len() && (rest[word.len()] == ' ' || rest[word.len()] == '\t' || rest[word.len()] == '"')

            if strings.starts_with(text: rest, prefix: word) && spaced
                after = strings.trimmed(rest.slice(from: word.len(), to: rest.len()))
                close: i64 @= 1

                while close < after.len() && after[close] != '"'
                    close @ close + 1

                if after.len() > 0 && after[0] == '"' && close > 1 && close < after.len()
                    out @ out.push(after.slice(from: 1, to: close))

    return out

# A quoted spelling read from the folder `folder`: itself where it is rooted.
function from_folder(folder: str, spelled: str) -> str
    if strings.starts_with(text: clang_place.slashed(spelled), prefix: "/")
        return spelled
    return folder + "/" + spelled

# The folder a lexical path stands in: `.` for a bare name.
function folder_of(path: str) -> str
    at: i64 @= path.len() - 1

    while at >= 0 && path[at] != '/'
        at @ at - 1

    if at < 0
        return "."

    if at == 0
        return "/"
    return path.slice(from: 0, to: at)

## Tests

# **A file of a named folder is told by who included it**: beneath a platform
# header, as the library's header that includes it; beneath a group's header
# of the program's, where the platform holds its name, as that header's, its
# note to offer the quoted form; never the header a group names, nor a
# sibling its includer names in quotes; and a file the unit includes for no
# group, from a named folder, as the runtime's.
test "a file of a named folder is told by who included it, and a group's own header and a quoted sibling are not"
    root = "build/selftest-shadowed-tree"
    assert !process.remove_tree(root).is_err()

    for dir in ["/rt", "/sdk", "/src"]
        assert !process.mkdir_all(root + dir).is_err()

    for pair in [["/sdk/stdio.h", ""], ["/sdk/time.h", ""], ["/sdk/string.h", ""], ["/src/_stdio.h", ""], ["/src/time.h", ""], ["/src/string.h", ""], ["/src/heroes_unit.h", ""], ["/src/money.h", "#include <time.h>\n"], ["/src/quoted.h", "#  include \"string.h\"\n"], ["/src/locale.h", ""]]
        assert !write_file(path: root + pair[0], text: pair[1]).is_err()

    said = [". " + root + "/src/heroes_unit.h", ". " + root + "/src/money.h", ".. " + root + "/src/time.h", ". " + root + "/sdk/stdio.h", ".. " + root + "/src/_stdio.h", ". " + root + "/src/quoted.h", ".. " + root + "/src/string.h"].join("\n") + "\n"
    got = shadows(
        said: said,
        paths: [root + "/src/time.h", root + "/src/locale.h", root + "/src/absent.h"],
        groups: ["money.h", "stdio.h", "quoted.h"],
        named: [root + "/src"],
        others: [root + "/rt", root + "/sdk"]
    )
    assert got.len() == 4
    assert got[0].named == "heroes_unit.h" && got[0].reader == "" && !got[0].asked
    assert got[1].named == "time.h" && got[1].reader == "`" + root + "/src/money.h`" && got[1].beside && !got[1].asked
    assert got[2].named == "_stdio.h" && got[2].reader == "the C library's `<stdio.h>`" && !got[2].beside

    # A file `-M` lists and `-H` shows entered nowhere is one a header only
    # asks after (defect 2356); one `-MG` lists and no folder holds is none.
    assert got[3].named == "locale.h" && got[3].asked && got[3].reader == ""
    assert entries("x\n.. a/b.h\n.\n...c\n")[0].depth == 2 && entries("x\n.. a/b.h\n").len() == 1

    # Windows' paths come back as clang wrote them, each `\` once (defect 2359).
    windows = entries(". build\\\\evil\\\\lib.h\r\n.. C:\\\\Program Files\\\\Kits\\\\stdio.h\r\n.. a\\\"b.h\n")
    assert windows[0].path == "build\\evil\\lib.h" && windows[1].path == "C:\\Program Files\\Kits\\stdio.h" && windows[2].path == "a\"b.h"
    assert clang_place.slashed(windows[0].path) == "build/evil/lib.h"
    assert of_group(path: "inc/./x.h", groups: ["./x.h"]) && of_group(path: "inc/sub/x.h", groups: ["sub/x.h"]) && !of_group(path: "inc/ax.h", groups: ["x.h"])
    assert !process.remove_tree(root).is_err()

# **A nested header's sibling named in quotes from its own folder is its own**
# (defect 2420): `curl/curl.h`'s `#include "curlver.h"` read Homebrew's
# `curl/curlver.h` beside it and was refused as standing in for the SDK's,
# since the spelling was asked to be `curl/curlver.h`. Here `sys/clock.h`
# beside its own `sys/timeb.h`, a name the platform holds: `"timeb.h"` and
# `"./timeb.h"` are its own, and so is `"sys/timeb.h"`, which the search finds
# in the folder; `<sys/timeb.h>` stays refused (panel 237's ruling), and so
# does a quoted spelling that names another file than the one C read, and a
# file outside the includer's folder (`"../sys/timeb.h"`, which the sentence
# of design.md §4.19 does not reach).
test "a nested header's sibling named in quotes from its own folder is its own, and the angle form is refused (defect 2420)"
    root = "build/selftest-shadowed-nested"
    assert !process.remove_tree(root).is_err()

    for dir in ["/rt", "/sdk/sys", "/src/sys", "/src/lib"]
        assert !process.mkdir_all(root + dir).is_err()

    assert !write_file(path: root + "/sdk/sys/timeb.h", text: "").is_err()
    assert !write_file(path: root + "/src/sys/timeb.h", text: "#define TIMEB_OWN 21\n").is_err()
    named = [root + "/src"]
    others = [root + "/rt", root + "/sdk"]
    file = Entry(depth: 2, path: root + "/src/sys/timeb.h")
    verdicts = [
        ["sys/clock.h", "#include \"timeb.h\"\n", "own"]
        ["sys/dot.h", "#  include \"./timeb.h\"\n", "own"]
        ["sys/up.h", "#include \"../sys/timeb.h\"\n", "own"]
        ["sys/found.h", "#include \"sys/timeb.h\"\n", "own"]
        ["sys/angle.h", "#include <sys/timeb.h>\n", "beside"]
        ["sys/next.h", "#include_next \"timeb.h\"\n", "beside"]
        ["sys/other.h", "#include \"clock.h\"\n", "beside"]
        ["lib/clock.h", "#include \"../sys/timeb.h\"\n", "apart"]
    ]

    for row in verdicts
        reader = root + "/src/" + row[0]
        assert !write_file(path: reader, text: row[1]).is_err()
        got = refused(file, reader: reader, name: "sys/timeb.h", groups: [row[0]], named: named, others: others)

        if row[2] == "own"
            assert got.is_err()
        else
            assert !got.is_err() && got.must().beside == (row[2] == "beside")

    assert quoted_spellings("#include\"a.h\"\n# include  \"b c.h\" // x\n#include \"\"\n#include \"open\n#includex \"d.h\"\n") == ["a.h", "b c.h"]
    assert from_folder(folder: "inc/curl", spelled: "/abs/x.h") == "/abs/x.h" && from_folder(folder: ".", spelled: "x.h") == "./x.h"
    assert !process.remove_tree(root).is_err()
