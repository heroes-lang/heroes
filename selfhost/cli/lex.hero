# heroes lex <file.hero> [--dump-tokens] [--json] — the token stream
# (design.md §3.5). Port of archive/bootstrap-rs/heroes-cli/src/commands/lex.rs.
#
# Without a flag it is a lexical check: silent on success, diagnostics
# on stderr. --dump-tokens prints the stream, --json says HOW — the
# two flags are deliberately not one (panel 016). The dump shows THE
# FILE THE READER NAMED, at that file's own lines: unfiltered, an
# eight-line program printed 470 lines, the library's included, at
# concatenated numbers with no file marker.

use token
use source
use char_column
use lexer
use diag
use shown_char
use cli/table as cli_table
use cli/argv
use cli/io
use cli/json_text

function run(s: source.Source, inv: argv.Invocation) -> cli_table.Exit
    out = lexer.lex(s)

    if argv.has(inv, spelling: "--dump-tokens")
        if argv.has(inv, spelling: "--json")
            io.print_artifact(text: json(out.tokens, s))
        else
            io.print_artifact(text: text_dump(out.tokens, s))

    for d in out.diagnostics
        io.eprint(text: diag.render_line(d, s))

    if out.diagnostics.len() == 0
        return .ok_exit
    return .diagnostics_exit

# Both dumps push one row per token onto a local and join once (defect
# 105): `out @ out + …` copied the whole dump at every token, and the JSON
# dump of walk.hero four times over took 53 s.
function json(tokens: [token.Token], s: source.Source) -> str
    shown_tokens: [token.Token] @ []

    for t in tokens
        if source.is_root(s, t.span.start)
            shown_tokens @ shown_tokens.push(t)

    rows: [str] @ ["[\n"]
    index: i64 @ 0
    w: Walk @ started()

    for t in shown_tokens
        w @ moved(s, w: w, offset: t.span.start)
        found = placed(s, w: w)
        comma: str @ ","

        if index == shown_tokens.len() - 1
            comma @ ""
        row = "  {\"kind\": \"" + token.kind_name(t.kind) + "\", \"text\": \"" + json_text.json_string(shown(t, s)) + "\", \"line\": " + found.line.to_str() + ", \"col\": " + found.col.to_str() + "}" + comma + "\n"
        rows @ rows.push(row)
        index @ index + 1

    rows @ rows.push("]\n")
    return rows.join("")

# **The text dump is read on a terminal, so a token's control characters are
# written by their code** (defect 290), each but a line end and a tab as a
# diagnostic writes them, `<U+001B>` (`shown_char.visible`, defect 244): a
# string literal may hold an ESC raw, and the dump handed it to the terminal
# that shows the dump, where `[2J` cleared the screen. The JSON form is the
# exact one, its escapes `json_text`'s. Asked of each token's text, the one
# part of a row the file wrote, so the bytes asked are the file's and not the
# dump's, four times as many (defect 256's measure).
function text_dump(tokens: [token.Token], s: source.Source) -> str
    rows: [str] @ []
    w: Walk @ started()

    for t in tokens
        if !source.is_root(s, t.span.start)
            continue
        w @ moved(s, w: w, offset: t.span.start)
        found = placed(s, w: w)
        word = shown_char.visible(shown(t, s))
        at = found.line.to_str() + ":" + found.col.to_str() + " " + token.kind_name(t.kind)
        row: str @ at + "\n"

        if word.len() > 0
            row @ at + " " + word + "\n"
        rows @ rows.push(row)

    return rows.join("")

# **Where each token stands, `source.locate`'s line and column, found in one
# walk of the text** (defect 256). `locate` counts a column's characters from
# the start of its line, so a dump asking it once per token walked each line
# once per token on it: `lex --dump-tokens` over one line of 2,000 joined
# strings retired 30.3 billion instructions against 99.5 million for `lex`
# alone (this Mac, 2026-10-04; a count, not a duration). The walk goes
# forward from the last token placed, a line at a time, and counts the
# characters between two tokens once. A token before the last, which the
# lexer never writes, is placed by `source.line_col` itself.
record Walk
    # The index in `line_starts` of the line holding `at`.
    line: i64
    # The offset of the last token placed, and its column.
    at: i64
    col: i64

function started() -> Walk
    return Walk(line: 0, at: 0, col: 1)

function moved(s: source.Source, w: Walk, offset: i64) -> Walk
    if offset < w.at
        p = source.line_col(s, offset)
        return Walk(line: p.line - 1, at: offset, col: p.col)
    line: i64 @ w.line

    while line + 1 < s.line_starts.len() && s.line_starts[line + 1] <= offset
        line @ line + 1

    if line != w.line
        return Walk(line: line, at: offset, col: 1 + characters(s.text, from: s.line_starts[line], to: offset))
    return Walk(line: line, at: offset, col: w.col + characters(s.text, from: w.at, to: offset))

# The place `locate` gives a token of the root file, the one file a dump
# shows, whose lines are its own from the first; a `\r\n`'s line feed at the
# carriage return's column, as `source.line_col` gives it (defect 373).
function placed(s: source.Source, w: Walk) -> source.Location
    col: i64 @ w.col

    if char_column.ends_crlf(text: s.text, start: s.line_starts[w.line], offset: w.at)
        col @ col - 1
    return source.Location(file: s.files[0].name, line: w.line + 1 - s.files[0].lines_before, col: col)

# How many characters begin in the bytes `from` to `to`: every byte but a
# continuation byte, which is what `chars().len()` counts of a `str`.
function characters(text: str, from: i64, to: i64) -> i64
    count: i64 @ 0
    at: i64 @ from

    while at < to
        if text[at] < 128 || text[at] >= 192
            count @ count + 1
        at @ at + 1

    return count

# Layout tokens carry no text, so printing their (empty) slice would
# be noise.
function shown(t: token.Token, s: source.Source) -> str
    if t.kind == .indent || t.kind == .dedent || t.kind == .terminator || t.kind == .eof
        return ""
    return source.span_text(s, t.span)

## Tests

test "the dump is root-only, layout tokens stay wordless, json escapes"
    text = "constant A: i64\n    1\n"
    s = source.with_library(name: "t.hero", user: text, library: "constant HIDDEN: i64\n    9\n")
    out = lexer.lex(s)
    dumped = text_dump(out.tokens, s)
    assert has_text(text: dumped, needle: "1:1 kw_constant constant\n")
    assert has_text(text: dumped, needle: "1:11 colon :\n")
    assert has_text(text: dumped, needle: "2:5 int 1\n")

    # The library's tokens never appear.
    assert !has_text(text: dumped, needle: "HIDDEN")

    # Layout rows carry the kind alone.
    assert has_text(text: dumped, needle: " indent\n")
    j = json(out.tokens, s)
    assert has_text(text: j, needle: "{\"kind\": \"kw_constant\", \"text\": \"constant\", \"line\": 1, \"col\": 1},")
    assert json_text.json_string("a\"b\\c\nd\te") == "a\\\"b\\\\c\\nd\\te"

# Defect 290's string, an ESC and a clear-screen, and the two kinds beside it
# a terminal also acts on, DEL and C1's CSI: none reaches the text dump raw,
# and the JSON dump escapes each, so neither hands a terminal a sequence.
test "a token's control characters are written by their code in the text dump, and escaped in the JSON one (defect 290)"
    esc = bytes_of([27])
    del = bytes_of([127])
    csi = bytes_of([194, 155])
    text = "function main()\n    x = \"" + esc + "[2Jboom\"\n    print(x + \"" + del + csi + "31m\")\n"
    s = source.new_source(name: "t.hero", text: text)
    out = lexer.lex(s)
    dumped = text_dump(out.tokens, s)
    assert has_text(text: dumped, needle: "2:9 str \"<U+001B>[2Jboom\"\n")
    assert has_text(text: dumped, needle: "\"<U+007F><U+009B>31m\"")
    assert !shown_char.holds_control(dumped)
    j = json(out.tokens, s)
    assert has_text(text: j, needle: "\\u001b[2Jboom")
    assert has_text(text: j, needle: "\\u007f\\u009b31m")
    assert !shown_char.holds_control(j)

# Defect 256: the walk places every token of the root where `source.locate`
# does, over lines of several widths, characters of one to four bytes and a
# tab, with the library after the root, and a token before the last as well.
test "one walk places every token where locate does (defect 256)"
    text = "function main()\n\ts = \"é€😀\" + \"x\"\n    print(s)  # ünïcode ✓\n\nconstant A: i64\n    1\n"
    s = source.with_library(name: "t.hero", user: text, library: "constant HIDDEN: i64\n    9\n")
    out = lexer.lex(s)
    w: Walk @ started()
    count: i64 @ 0

    for t in out.tokens
        if !source.is_root(s, t.span.start)
            continue
        w @ moved(s, w: w, offset: t.span.start)
        got = placed(s, w: w)
        want = source.locate(s, t.span.start)
        assert got.file == want.file
        assert got.line == want.line
        assert got.col == want.col
        count @ count + 1

    assert count > 20
    back = moved(s, w: w, offset: 2)
    assert placed(s, w: back).line == 1
    assert placed(s, w: back).col == source.locate(s, 2).col

    # And the same text with CRLF line ends, whose line feeds take the
    # carriage return's column (defect 373).
    crlf = source.with_library(name: "t.hero", user: crlf_of(text), library: "constant HIDDEN: i64\n    9\n")
    walked: Walk @ started()
    placed_count: i64 @ 0

    for t in lexer.lex(crlf).tokens
        if !source.is_root(crlf, t.span.start)
            continue
        walked @ moved(crlf, w: walked, offset: t.span.start)
        assert placed(crlf, w: walked).col == source.locate(crlf, t.span.start).col
        assert placed(crlf, w: walked).line == source.locate(crlf, t.span.start).line
        placed_count @ placed_count + 1

    assert placed_count > 20

# `text` with every line feed after a carriage return.
function crlf_of(text: str) -> str
    pieces: [str] @ []

    for ch in text.chars()
        if ch == "\n"
            pieces @ pieces.push("\r\n")
        else
            pieces @ pieces.push(ch)

    return pieces.join("")

# A text from its UTF-8 bytes, since a string literal names no control
# character by its code (spec § 2 Literals).
function bytes_of(bytes: [u8]) -> str
    return bytes.validated_bytes().must()

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
