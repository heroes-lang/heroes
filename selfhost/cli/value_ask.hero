# A header constant's value asked of the program's own unit, run in trap mode,
# once a build's units compile and before anything links (panel 216's R1,
# ratified 2026-10-17; panel 218's R1 and R2; defects 2075, 2104 and 2109;
# design.md §4.19, §1.12; spec § 13). Two probes per unit: panel 216's, its
# accessors called at the program's level, since the program computes a
# macro's value there; and panel 218's C2 (`cli/value_c2.hero`), the
# initialisers those values read, at `-O0`. What a probe is, is
# `emit/value_probe.hero`; how one runs, `cli/value_run.hero`; what it tells,
# `cli/value_told.hero`. This file asks both and keeps panel 216's verdict.
#
# **Three clangs and a few runs on a cold build, none on a warm one**, per
# unit that defines an asked accessor: the verdict is kept under
# `build/value-<key>/`, the key naming the compiler, the unit's own text, its
# words, its level, the runtime and what the probe appends and compiles it
# with, so a header that changes is asked again with its unit, and a probe of
# another shape never reads this one's. Measured by panel 216: about 0.3 s real
# cold on this Mac, 0.07 s on Linux arm64, nothing warm.

use ast
use source
use diag
use check/state
use emit/value_probe
use emit/ffi_lookup
use ir/containers
use cli/toolchain
use cli/publish
use cli/digest
use cli/kept as kept_answers
use cli/libraries
use cli/value_run
use cli/value_c2
use cli/value_told

# What the probes said: a diagnostic per constant a probe refuses, and the
# compiler's own failure, present where a probe of the compiler's own making
# did not preprocess, compile or link but for a symbol the header's code
# reaches, or a canary did not answer as it must; absent otherwise. A probe
# that tells nothing is never counted judged (panel 218's R2: one that did not
# link passed in silence).
record Told
    found: [diag.Diagnostic]
    broken: str?

# Every unit's verdicts, their refusals as diagnostics on each constant's
# line: panel 216's first, then C2's for a constant panel 216's did not
# refuse, so one constant is told once.
function told(t: toolchain.Toolchain, units: [value_run.Unit], level: str, p: containers.Program, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> Told
    out: [diag.Diagnostic] @= []

    for one in units
        accessors = value_probe.asked(p, c, s, decls, defined: one.defined)

        if accessors.len() == 0
            continue
        plain: str? @= fail(code: "unread", msg: "not preprocessed")
        verdict = asked(t, one: one, accessors: accessors, level: level, @plain)

        if verdict.is_err()
            return Told(found: out, broken: ok(failure_of(verdict)))
        initialisers = value_c2.asked(t, one: one, accessors: accessors, level: level, @plain)

        if initialisers.is_err()
            return Told(found: out, broken: ok(value_told.message_of(initialisers)))
        said = verdict.must().said
        dd: str? @= verdict.must().preprocessed

        if dd.is_err() && value_told.refusing(initialisers.must())
            dd @ value_run.preprocessed(dir: t.build + "/value-" + verdict.must().key, one: one, defines: true)

        for line in ffi_lookup.lines(text: said)
            for d in value_told.refusals(line: line, accessors: accessors, preprocessed: dd, c: c, s: s, decls: decls)
                out @ out.push(d)

        for line in ffi_lookup.lines(text: initialisers.must())
            if !value_told.repeats(line: line, said: said)
                for d in value_told.refusals(line: line, accessors: accessors, preprocessed: dd, c: c, s: s, decls: decls)
                    out @ out.push(d)

    none: str? = fail(code: "none", msg: "every probe's checks fired")
    return Told(found: out, broken: none)

# A verdict's failure, always the compiler's own: every failure of the
# author's header is a verdict that refuses.
function failure_of(failed: Verdict?) -> str
    match failed
        .ok    => return ""
        .err e => return e.msg

# What one unit's probe said, one line per finding, `trap <index>`,
# `death <words>` or `unlinked <name>`; where it refuses, the unit
# preprocessed with its `#define`s kept, which the header's lines are read
# from; and the key it is kept under.
record Verdict
    said: str
    preprocessed: str?
    key: str

# The verdict kept under its key, or asked: the unit preprocessed (into
# `plain`, which C2 reads too), compiled in trap mode at the program's level
# with what the probe appends, linked with the runtime alone and run.
function asked(t: toolchain.Toolchain, one: value_run.Unit, accessors: [value_probe.Accessor], level: str, @plain: str?) -> Verdict?
    key = digest.digest(
        t.fingerprint + "|value|" + t.compiler_key + "|" + one.module + "|" + one.text + "|words:" + libraries.key_text(one.words) + "|" + level + "|" + t.runtime_key + "|" + t.target + "|probe:" + value_probe.appended(accessors) + "|" + value_run.checks().join(" ")
    )
    dir = t.build + "/value-" + key
    known = kept_answers.read(dir + "/verdict.txt")

    if !known.is_err()
        return ok(
            Verdict(said: known.must(), preprocessed: defined_text(dir: dir, one: one, said: known.must()), key: key)
        )
    plain @ ok(value_run.preprocessed(dir: dir, one: one, defines: false)?)
    object = value_run.compiled(dir: dir, one: one, text: plain.must() + value_probe.appended(accessors), level: level)?
    said = value_run.linked_and_run(
        t,
        dir: dir,
        object: object,
        total: value_probe.called(accessors).len(),
        level: level
    )
    publish.discard(object)
    kept_answers.write(path: dir + "/verdict.txt", text: said?)?
    return ok(Verdict(said: said.must(), preprocessed: defined_text(dir: dir, one: one, said: said.must()), key: key))

# The unit preprocessed with its `#define`s kept, where a verdict refuses:
# what the header's lines are quoted from, read by a run of its own since the
# probe compiles the text without them. A verdict that refuses nothing reads
# nothing.
function defined_text(dir: str, one: value_run.Unit, said: str) -> str?
    if !value_told.refusing(said)
        return fail(code: "none", msg: "refusing nothing")
    return value_run.preprocessed(dir: dir, one: one, defines: true)
