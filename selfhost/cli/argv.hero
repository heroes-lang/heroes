# How one argv line is read against the table — cli_argv, so the
# parse VERB keeps its own name (CLAUDE.md §10; panels
# 016, 020, 055, 056). Port of the parse half of
# archive/bootstrap-rs/heroes-cli/src/cli.rs.
#
# Three properties this file exists to guarantee: STRICT (an unknown
# flag, a flag on the wrong command, a second operand — each an error
# that NAMES WHAT IS ACCEPTED, the llm-ergonomist's condition, because
# a model reading "unknown flag" learns nothing); ONE EXIT CONTRACT (0
# clean, 1 diagnostics, 2 the tool could not run — the caller's, keyed
# on the fail code this parser uses); and TAG, NOT A NAME STRING
# (dispatch is an exhaustive match, so a table entry with no arm is a
# compile error).
#
# Port notes: the error is the fallible's own message (e.msg), read by
# the driver — the language's e.code/e.msg is exactly Rust's
# Result<_, String> here. And the one place the parser looks at the
# machine — does this directory exist — arrives as a FUNCTION VALUE
# (§4.13), because the language has no is_dir builtin: the driver
# passes the real probe, a test passes its own.

use cli/table as cli_table

record FlagHit
    spelling: str
    value: str?

# What a command line turned out to mean. program_args is everything
# after `--`, handed to the program verbatim (run only): a SEPARATOR
# rather than a trailing operand, because otherwise a program taking
# -o could never be run (author instruction 2026-08-12).
record Invocation
    tag: cli_table.Tag
    file: str?
    program_args: [str]
    flags: [FlagHit]

function has(inv: Invocation, spelling: str) -> bool
    for f in inv.flags
        if f.spelling == spelling
            return true

    return false

function value_of(inv: Invocation, spelling: str) -> str?
    for f in inv.flags
        if f.spelling == spelling
            return f.value

    return fail(code: "none", msg: "the flag was not given")

# Every value a repeatable flag was given, in the order written —
# which is the order clang will search, so the order the author chose.
function values_of(inv: Invocation, spelling: str) -> [str]
    out: [str] @= []

    for f in inv.flags
        if f.spelling == spelling && !f.value.is_err()
            out @ out.push(f.value.must())

    return out

function bare(tag: cli_table.Tag) -> Invocation
    none_file: str? = fail(code: "none", msg: "no file")
    return Invocation(tag: tag, file: none_file, program_args: [], flags: [])

function starts_with_dash(text: str) -> bool
    cs = text.chars()
    return cs.len() > 0 && cs[0] == "-"

# Parse argv against the table. The failure's msg is ready to print:
# it names what was wrong AND what would have been accepted.
function parse(given: [str], dir_probe: (function(str) -> bool)) -> Invocation?
    if given.len() == 0
        return ok(bare(tag: .help_cmd))
    word = given[0]

    if word == "--version" || word == "-V"
        return ok(bare(tag: .version_cmd))

    if word == "--help" || word == "-h" || word == "help"
        return ok(bare(tag: .help_cmd))
    table = cli_table.commands()
    found: i64 @= -1
    index: i64 @= 0

    for c in table
        if c.name == word && found == -1
            found @ index
        index @ index + 1

    if found == -1
        retired = cli_table.retired(word: word)

        if !retired.is_err()
            return fail(code: "bad_usage", msg: "`" + word + "` is no longer a command — use `" + retired.must() + "`")
        names: [str] @= []

        for c in table
            names @ names.push(c.name)

        return fail(code: "bad_usage", msg: "unknown command `" + word + "` — the commands are " + names.join(", "))
    command = table[found]
    file: str? @= fail(code: "none", msg: "no file")
    flags: [FlagHit] @= []
    program_args: [str] @= []
    at: i64 @= 1

    while at < given.len()
        arg = given[at]

        if arg == "--"
            # Only run executes anything, so only run has a program to
            # forward to. Anywhere else the separator is a mistake
            # worth naming rather than a no-op that silently drops
            # what follows it.
            take: bool @= false

            match command.tag
                .run_cmd                                                        => take @ true
                .lex_cmd | .parse_cmd | .check_cmd | .build_cmd | .test_cmd     => take @ take
                .fmt_cmd | .doctor_cmd | .mutate_cmd | .measure_cmd | .this_cmd => take @ take
                .grammar_cmd | .probe_cmd                                       => take @ take
                .version_cmd | .help_cmd                                        => take @ take

            if !take
                return fail(
                    code: "bad_usage",
                    msg: "`--` passes arguments to the program, and `" + command.name + "` does not run one — only `heroes run` does"
                )
            follow: i64 @= at + 1

            while follow < given.len()
                program_args @ program_args.push(given[follow])
                follow @ follow + 1

            break

        if starts_with_dash(arg)
            known: i64 @= -1
            probe: i64 @= 0

            for f in command.flags
                if f.spelling == arg && known == -1
                    known @ probe
                probe @ probe + 1

            if known == -1
                retired_f = cli_table.retired_flag(command: command.name, arg: arg)

                if !retired_f.is_err()
                    return fail(
                        code: "bad_usage",
                        msg: "`" + arg + "` is no longer a flag of `" + command.name + "` — use `" + retired_f.must() + "`"
                    )
                return fail(code: "bad_usage", msg: unknown_flag(command: command, arg: arg))
            wanted = command.flags[known]
            value: str? @= fail(code: "none", msg: "no value")

            if wanted.value
                if at + 1 >= given.len() || starts_with_dash(given[at + 1])
                    return fail(
                        code: "bad_usage",
                        msg: "`" + arg + "` needs a " + wanted.placeholder + ": `heroes " + command.name + " <file.hero> " + arg + " <" + wanted.placeholder + ">`"
                    )

                # An empty value names nothing, and is refused as a missing one
                # is (defect 349): `-o ""` reached the writer, which told it as
                # a link that cannot be followed.
                if given[at + 1].len() == 0
                    return fail(
                        code: "bad_usage",
                        msg: "`" + arg + "` needs a " + wanted.placeholder + ", and was given an empty one: `heroes " + command.name + " <file.hero> " + arg + " <" + wanted.placeholder + ">`"
                    )
                value @ ok(given[at + 1])
                at @ at + 1

            # The one place this parser looks at the machine: a search
            # path that names nothing is the failure clang is SILENT
            # about (panel 056), and silence is what makes it survive
            # being committed to a script. A missing directory is a
            # BAD FLAG — exit 2, the tool could not run — not a
            # diagnostic about the program, which keeps §7's exit-1
            # narrowing intact.
            if wanted.directory && !value.is_err()
                if !dir_probe(value.must())
                    return fail(
                        code: "bad_usage",
                        msg: "`" + arg + " " + value.must() + "` names no directory on this machine — clang searches it in silence and builds against whatever header it finds elsewhere, so this is refused here rather than discovered as a wrong answer"
                    )

            # A second -o is dropped in favour of the first — a second
            # output path is a mistake and the first is what the
            # reader meant — where a second --include is ONE MORE
            # search entry: dropping it silently was a wrong build
            # rather than a failed one (panel 055, §1.12).
            if wanted.repeatable || !has(Invocation(tag: command.tag, file: file, program_args: program_args, flags: flags), spelling: wanted.spelling)
                flags @ flags.push(FlagHit(spelling: wanted.spelling, value: value))
            at @ at + 1
            continue
        no_operand: bool @= false

        match command.operand
            .no_operand                       => no_operand @ true
            .file_operand | .optional_operand => no_operand @ no_operand

        if no_operand
            return fail(code: "bad_usage", msg: "`" + command.name + "` takes no file")

        # An empty word names no file, and is refused as an empty value is
        # (defect 347, as defect 349 for `-o ""`): it reached the reader, which
        # said *cannot read ``* as if a file had been named.
        if arg.len() == 0
            return fail(code: "bad_usage", msg: empty_operand(command))

        if !file.is_err()
            return fail(code: "bad_usage", msg: "`" + command.name + "` takes one file, and two were given")
        file @ ok(arg)
        at @ at + 1

    needs_file: bool @= false

    match command.operand
        .file_operand                   => needs_file @ true
        .no_operand | .optional_operand => needs_file @ needs_file

    if needs_file && file.is_err()
        return fail(
            code: "bad_usage",
            msg: "`" + command.name + "` needs a file: `heroes " + command.name + " <file.hero>`"
        )
    return ok(Invocation(tag: command.tag, file: file, program_args: program_args, flags: flags))

# What an empty operand is told, in the form the help gives the operand:
# `<file.hero>` where one is needed, `[file]` where it may be left out.
function empty_operand(command: cli_table.Command) -> str
    match command.operand
        .file_operand => return "`" + command.name + "` needs a file, and was given an empty one: `heroes " + command.name + " <file.hero>`"
        .optional_operand | .no_operand =>
            return "`" + command.name + "` was given an empty file, which names none: `heroes " + command.name + " [file]`, or no file for its default"

# The enumerating error the llm-ergonomist asked for: every wrong flag
# is one round trip, because the message carries the list.
function unknown_flag(command: cli_table.Command, arg: str) -> str
    if command.flags.len() == 0
        return "`" + command.name + "` takes no flags, and `" + arg + "` was given"
    accepted: [str] @= []

    for f in command.flags
        accepted @ accepted.push(f.spelling)

    return "`" + command.name + "` does not accept `" + arg + "` — it accepts " + accepted.join(", ")

# A command line holding an argument that is not UTF-8, told by what that
# argument is to the command (defect 281): the lines of the refusal. `given`
# holds every argument, the one at `at` as its bytes written by their value
# (`caf<0xE9>.hero`, which no command, flag or `--` is spelled as), and the
# line is read against the table with no question asked of the machine:
#
# - what is no command and no flag is refused in this parser's own words,
#   which name it;
# - an argument after `run`'s `--` is the program's, which `heroes run` passes
#   on as a `str`, and the program's author reaches it by building the
#   program and reading `args_checked()`;
# - any other is the compiler's own, a file or a flag's value: a file is told
#   as defect 239's walk tells one, and a value is asked again in UTF-8.
#
# Until that day every one of them was told *build the program with `heroes
# build` and read it with `args_checked()`*, a program author's repair handed
# to the compiler's user, a misspelled flag and an `-o` included.
function unheld(given: [str], at: i64) -> [str]
    match parse(given, dir_probe: unasked)
        .err e => return ["error: " + e.msg]
        .ok inv =>
            dash: i64 @= -1
            index: i64 @= 1

            while index < given.len() && dash < 0
                if given[index] == "--"
                    dash @ index
                index @ index + 1

            if inv.tag == .run_cmd && dash > 0 && at > dash
                return [
                    "error: argument " + (at + 1).to_str() + ", `" + given[at] + "`, is for the program and is not UTF-8, and `heroes run` passes a program's arguments as Heroes `str`s, which are UTF-8 (spec § 3 Types)"
                    "note: build the program with `heroes build`, run it with this argument, and read it with `args_checked()`"
                ]

            if at > 0 && !value_of(inv, spelling: given[at - 1]).is_err()
                return [
                    "error: the value of `" + given[at - 1] + "`, `" + given[at] + "`, is not UTF-8, and this compiler holds each word it is given as a Heroes `str`, which is UTF-8 (spec § 3 Types): give it in UTF-8"
                ]
            return [
                "error: the name of `" + given[at] + "` is not UTF-8, and this compiler opens a file by a name it can hold: rename it"
            ]

# No question asked of the machine: a line read for a refusal is read for
# what its words are, never for whether a directory a flag names is there,
# which its value written by its bytes is not.
function unasked(path: str) -> bool
    _ = path
    return true

## Tests

function yes_dir(path: str) -> bool
    _ = path
    return true

function no_dir(path: str) -> bool
    _ = path
    return false

test "strict against the table, and every refusal names what is accepted"
    empty: [str] = []
    top = parse(empty, dir_probe: yes_dir)
    assert top.must().tag == .help_cmd
    v: [str] = ["--version"]
    assert parse(v, dir_probe: yes_dir).must().tag == .version_cmd
    good: [str] = ["build", "main.hero", "--emit-c", "-o", "out.c"]
    inv = parse(good, dir_probe: yes_dir).must()
    assert inv.tag == .build_cmd
    assert inv.file.must() == "main.hero"
    assert has(inv, spelling: "--emit-c")
    assert value_of(inv, spelling: "-o").must() == "out.c"

    # An unknown command enumerates; a retired flag names its heir.
    ghost: [str] = ["explode", "main.hero"]
    bad = parse(ghost, dir_probe: yes_dir)

    match bad
        .ok    => assert false
        .err e => assert e.msg == "unknown command `explode` — the commands are lex, parse, check, build, run, test, fmt, doctor, mutate, probe, measure, grammar, this"

    old: [str] = ["fmt", "main.hero", "--write"]

    match parse(old, dir_probe: yes_dir)
        .ok    => assert false
        .err e => assert e.msg == "`--write` is no longer a flag of `fmt` — use `--in-place`"

    wrong: [str] = ["parse", "main.hero", "--emit-c"]

    match parse(wrong, dir_probe: yes_dir)
        .ok    => assert false
        .err e => assert e.msg == "`parse` does not accept `--emit-c` — it accepts --dump-ast"

    two: [str] = ["check", "a.hero", "b.hero"]
    assert parse(two, dir_probe: yes_dir).is_err()
    missing: [str] = ["build"]
    assert parse(missing, dir_probe: yes_dir).is_err()

test "repeatable flags accumulate, -o keeps the first, -- feeds run only"
    paths: [str] = ["build", "m.hero", "--include", "/a", "--include", "/b", "-o", "x", "-o", "y"]
    inv = parse(paths, dir_probe: yes_dir).must()
    got = values_of(inv, spelling: "--include")
    assert got.len() == 2
    assert got[0] == "/a"
    assert got[1] == "/b"

    # The second -o is dropped in favour of the first.
    assert value_of(inv, spelling: "-o").must() == "x"

    # The machine probe fires only for a directory-valued flag.
    nodir: [str] = ["build", "m.hero", "--include", "/ghost"]
    assert parse(nodir, dir_probe: no_dir).is_err()
    fine: [str] = ["build", "m.hero", "-o", "/ghost/out"]
    assert !parse(fine, dir_probe: no_dir).is_err()

    # `--` forwards to the program for run, and is refused elsewhere.
    fwd: [str] = ["run", "m.hero", "--", "-o", "--weird"]
    ran = parse(fwd, dir_probe: yes_dir).must()
    assert ran.program_args.len() == 2
    assert ran.program_args[0] == "-o"
    sep: [str] = ["check", "m.hero", "--"]
    assert parse(sep, dir_probe: yes_dir).is_err()

# Defect 281: an argument that is not UTF-8 is told by what it is to the
# command, as `main` hands it over, its bytes written by their value; only an
# argument after `run`'s `--` is the program's and draws the program author's
# advice. The table is the one the compiler reads, so a flag or a command it
# does not know is told by the parser's own refusal.
test "an argument that is not UTF-8 is told by what it is to the command (defect 281)"
    file: [str] = ["check", "caf<0xE9>.hero"]
    assert unheld(file, at: 1) == ["error: the name of `caf<0xE9>.hero` is not UTF-8, and this compiler opens a file by a name it can hold: rename it"]
    out: [str] = ["build", "x.hero", "-o", "caf<0xE9>"]
    assert unheld(out, at: 3) == ["error: the value of `-o`, `caf<0xE9>`, is not UTF-8, and this compiler holds each word it is given as a Heroes `str`, which is UTF-8 (spec § 3 Types): give it in UTF-8"]

    # A directory's value is never asked of the machine, which holds no
    # directory by the written name and would refuse it as absent.
    searched: [str] = ["build", "x.hero", "--include", "inc<0xE9>"]
    assert unheld(searched, at: 3)[0] == "error: the value of `--include`, `inc<0xE9>`, is not UTF-8, and this compiler holds each word it is given as a Heroes `str`, which is UTF-8 (spec § 3 Types): give it in UTF-8"
    command: [str] = ["<0xE9>"]
    assert unheld(command, at: 0) == ["error: unknown command `<0xE9>` — the commands are lex, parse, check, build, run, test, fmt, doctor, mutate, probe, measure, grammar, this"]
    flag: [str] = ["check", "x.hero", "--<0xE9>"]
    assert unheld(flag, at: 2) == ["error: `check` does not accept `--<0xE9>` — it accepts " + flag_list(name: "check")]
    program: [str] = ["run", "x.hero", "--", "-o", "<0xE9>"]
    assert unheld(program, at: 4) == ["error: argument 5, `<0xE9>`, is for the program and is not UTF-8, and `heroes run` passes a program's arguments as Heroes `str`s, which are UTF-8 (spec § 3 Types)", "note: build the program with `heroes build`, run it with this argument, and read it with `args_checked()`"]

    # The file `run` runs is the compiler's own, and `--` anywhere else is the
    # parser's refusal.
    ran: [str] = ["run", "caf<0xE9>.hero", "--", "a"]
    assert unheld(ran, at: 1)[0] == "error: the name of `caf<0xE9>.hero` is not UTF-8, and this compiler opens a file by a name it can hold: rename it"
    misplaced: [str] = ["check", "x.hero", "--", "<0xE9>"]
    assert unheld(misplaced, at: 3) == ["error: `--` passes arguments to the program, and `check` does not run one — only `heroes run` does"]

# Defect 349: an empty value names nothing, so a flag that takes one refuses
# it, naming the flag, as it refuses a missing one: `-o ""` reached the
# writer, which read the empty landing as a link that cannot be followed, for
# *the operating system's own reason is 0*. Asked of every flag of the table
# that takes a value, so a flag added to it is asked too.
test "an empty value for a flag that takes one is refused, naming the flag (defect 349)"
    out: [str] = ["build", "x.hero", "-o", ""]

    match parse(out, dir_probe: yes_dir)
        .ok _  => assert false
        .err e => assert e.msg == "`-o` needs a path, and was given an empty one: `heroes build <file.hero> -o <path>`"

    asked: i64 @= 0

    for c in cli_table.commands()
        for f in c.flags
            if f.value
                given: [str] = [c.name, "x.hero", f.spelling, ""]
                asked @ asked + 1

                match parse(given, dir_probe: yes_dir)
                    .ok _  => assert false
                    .err e => assert e.msg == "`" + f.spelling + "` needs a " + f.placeholder + ", and was given an empty one: `heroes " + c.name + " <file.hero> " + f.spelling + " <" + f.placeholder + ">`"

    assert asked > 0

    # After `run`'s `--` an empty word is the program's, and passes on.
    passed: [str] = ["run", "x.hero", "--", ""]
    assert parse(passed, dir_probe: yes_dir).must().program_args == [""]

# Defect 347: an empty operand names no file, so every command that takes
# one refuses it as `-o ""` is refused, before anything is read; asked of
# every such command of the table, a second operand after it included.
test "an empty operand is refused, naming the command, before anything is read (defect 347)"
    check_empty: [str] = ["check", ""]

    match parse(check_empty, dir_probe: yes_dir)
        .ok _  => assert false
        .err e => assert e.msg == "`check` needs a file, and was given an empty one: `heroes check <file.hero>`"

    mutate_empty: [str] = ["mutate", ""]

    match parse(mutate_empty, dir_probe: yes_dir)
        .ok _  => assert false
        .err e => assert e.msg == "`mutate` was given an empty file, which names none: `heroes mutate [file]`, or no file for its default"

    asked: i64 @= 0

    for c in cli_table.commands()
        taken: bool @= true

        match c.operand
            .no_operand                       => taken @ false
            .file_operand | .optional_operand => taken @ true

        if taken
            asked @ asked + 1

            for given in [[c.name, ""], [c.name, "", "x.hero"], [c.name, "x.hero", ""]]
                match parse(given, dir_probe: yes_dir)
                    .ok _  => assert false
                    .err e => assert e.code == "bad_usage"

    assert asked >= 10

# The flags the table gives a command, as `unknown_flag` lists them.
function flag_list(name: str) -> str
    spellings: [str] @= []

    for c in cli_table.commands()
        if c.name == name
            for f in c.flags
                spellings @ spellings.push(f.spelling)

    return spellings.join(", ")
