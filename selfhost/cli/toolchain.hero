# Everything between the generated C and a running binary: where the
# runtime is, what clang is invoked with, and what is cached where
# (design.md §3.1; panels 020, 036, 055). Port of the toolchain half
# of archive/bootstrap-rs/heroes-cli/src/commands/toolchain.rs.
#
# THE CACHE KEY IS THE WHOLE CONFIGURATION, not the source. Measured
# in the bootstrap: hero_print_int changed with runtime.o not
# recompiled relinked silently and printed the old bytes; the compiler
# itself joined the key after two debugging detours on stale output —
# the most expensive shape a build system has, a correct fix that
# appears not to work.
#
# Port decisions, each recorded here and in DECIDE.md's CLI entry:
# - clang and the filesystem verbs arrive through C's own system()
#   (§1.11 eating its own cooking), with stderr redirected to a file
#   under build/ and read back — which is what keeps the ffi error
#   mapping working.
# - the digest is `digest.digest` — two polynomial hashes rather
#   than FNV-64, with the reason in that file. It left this one on
#   2026-08-26 because the runtime object's freshness check needs
#   `cli_deps`, `cli_deps` needs to hash a file, and Heroes refuses
#   module cycles.
# - the compiler fingerprint and the runtime hint arrive as PARAMETERS
#   from the driver; where the compiler itself stands is the runtime's
#   answer (`hero_exe_path_shown`, defect 277), the one file that knows
#   what machine it is on.
# - the runtime's contents are gathered by one shell glob (`cat` in
#   the shell's sorted order) because the language has no readdir;
#   same fact, same key, different plumbing.

use cli/io
use cli/clang_floor
use cli/deps
use cli/digest
use cli/flags
use cli/process
use cli/publish
use cli/runtime_key
use cli/strings
use cli/clang_died
use cli/runtime_places
use cli/read_back
use cli/served

# WHAT A BUILD LEAVES UNDER `build/` HAS A SHAPE, AND EVERY KEY NAMES IT.
# `fingerprint` is the Heroes `VERSION`, which moves at a release, so a
# compiler that changes what it writes there between releases would read
# what an older one left: before defect 134 records, replays and C were
# written in place, and a build killed half-way left files no later build
# can trust (an empty pointee verdict failed every build after it). A new
# word here is a new directory for every key; the old ones are never read:
# `sealed` since every kept text carries its seal (`cli/kept.hero`, 357).
constant LAYOUT: str
    "sealed"

record Toolchain
    runtime: str
    build: str
    fingerprint: str
    # The runtime's whole contents, already hashed. It is a FIELD and
    # not a call because the per-module path asks for it once per
    # translation unit: on the compiler's own source that was 157 shell
    # `cat` invocations and 25 MB of hashing (162 KB × 157) for one
    # answer that cannot change during a build. Located once, here.
    runtime_key: str
    # THE C COMPILER AND THE FLAGS EVERY OBJECT IS COMPILED UNDER, hashed
    # (defect 122, panel 182's item 4): what `clang_floor.identity` says this
    # machine's clang will run for the unoptimised build's words
    # (`flags.level_words`), and those words themselves. Every
    # key under `build/` that names an object or an answer clang gave carries
    # it, so another clang, another flag or another sysroot is another
    # directory and never a warm hit. Asked once, here, for the reason
    # `runtime_key` is.
    compiler_key: str
    # That answer's first line, the version banner the floor is checked on;
    # empty when clang did not answer.
    compiler_banner: str
    # The triple that answer says the driver compiles and links for
    # (`clang_floor.target`), empty when clang did not answer: whose linker
    # the link runs, which `link_flags.target_words` asks (defect 593).
    target: str

# Locate the runtime, or say the places it looked. The search is why
# the ABI stamp exists: a decoy runtime/ compiled with zero warnings
# under -Weverything and printed 0x1e where 30 was expected; the stamp
# turns that silence into `use of undeclared identifier`.
#
# Three places, in the order design.md §3.1 and panel 020 rule them:
# `$HEROES_RUNTIME`, `runtime/` under the working directory, and `runtime/`
# under an ancestor of the executable, nearest first, which until defect 277
# was never looked in, so an installed compiler found none without the
# variable while its help said *beside the compiler*.
#
# **A hint the author set is the one place looked in, and one naming no
# runtime is refused, saying so** (defect 276), as defect 243 refuses one that
# is not UTF-8: it was passed over in silence for the next place, so a
# `runtime/` beside the program, or above the compiler, built the program
# against a runtime the author did not name. What `HEROES_RUNTIME` is for is
# saying which runtime; a search that goes on past it decides otherwise, the
# decoy panel 020's ABI stamp was written against.
function locate_toolchain(hint: str, fingerprint: str) -> Toolchain?
    if hint.len() > 0
        missing = runtime_places.missing_at(hint)

        if missing.len() > 0
            return fail(code: "hint", msg: runtime_places.unheld(hint: hint, missing: missing))
        return toolchain_at(runtime: hint, fingerprint: fingerprint)
    candidates: [str] @= ["runtime"]
    beside = runtime_places.beside_the_compiler()

    for above in beside.above
        candidates @ candidates.push(above + "/runtime")

    for candidate in candidates
        if runtime_places.missing_at(candidate).len() == 0
            return toolchain_at(runtime: candidate, fingerprint: fingerprint)

    return fail(code: "failed", msg: runtime_places.not_found(beside))

# The toolchain over the runtime at `runtime`, whose two files read.
function toolchain_at(runtime: str, fingerprint: str) -> Toolchain?
    gathered = runtime_key.each_file(runtime)?

    # Asked with the unoptimised build's words, its `-g` among them, so the kind
    # `-g` means to this clang (`standalone` on this Mac, `constructor` on
    # Linux, `constructor` in CodeView on Windows, panel 197's critic) is in
    # the key as it was while the word was the list's; `build_words` names
    # each level's word.
    asked = flags.level_words(level: "-O0", sanitize: false)
    said = clang_floor.identity(build_dir: "build", runtime: runtime, words: asked)

    return ok(
        Toolchain(runtime: runtime, build: "build", fingerprint: fingerprint + "|" + LAYOUT, runtime_key: digest.digest(gathered), compiler_key: digest.digest(asked.join(" ") + "|" + answer_text(said)), compiler_banner: clang_floor.banner(said.default("")), target: clang_floor.target(said.default("")))
    )

# What the key is given for clang's answer: the answer, or what was said
# instead. A clang that did not answer keys apart from one that did, and the
# build's own compile then says why.
function answer_text(said: str?) -> str
    match said
        .ok text => return "answered|" + text
        .err e   => return "unanswered|" + e.msg

# The words a key carries for the level, its debug word and the sanitizers:
# the flags themselves, so a sanitizer list that grows is another key, where
# one bit said only whether there was any, and an object compiled under one
# debug word is never served to a build under another (panel 197).
function build_words(level: str, sanitize: bool) -> str
    return level + "|" + flags.debug_words(level).join(" ") + "|" + flags.sanitizers(sanitize: sanitize).join(" ")

# Run one clang line, stderr captured to a file and read back. clang's
# own words are kept verbatim: a failure here says THE COMPILER is
# wrong — the generated C is not the author's text — so the caller
# exits 2. A WARNING is forwarded rather than swallowed, and that is
# the whole point of the flag set: a warning nobody sees cannot
# falsify anything.
function run_clang(line: [str], what: str, err_path: str) -> ()?
    said = asked_of_clang(line: line, what: what, err_path: err_path)?

    if strings.trimmed(said).len() > 0
        io.eprint_raw(text: said)
    return ok()

# **One clang line run as `run_clang` runs it, what clang said on success
# handed back rather than printed** (defect 248): the question a probe asks
# (`cli/pointee.hero`, `cli/layout.hero`), whose unit includes the program's
# headers and compiles under a unit's words but their diagnostics
# (`compiling.probe_words`, defect 163). A header's warning reached the
# terminal from each probe's check unit, `build/pointee-<key>/check-<key>.c`,
# a file the author never wrote, and again from the program's own unit, which
# compiles the same headers under the flags that say what a warning is and is
# where the author is told it: one warning, up to four copies. The probes'
# dump and screen runs never printed theirs. A failure is `run_clang`'s, and
# carries clang's whole text, warnings included, as a verdict always did.
function asked_of_clang(line: [str], what: str, err_path: str) -> str?
    return asked_through(program: "clang", words: line, what: what, err_path: err_path)

# One program's line, its first word the program's own name as a line's is
# (`hero_run_go`), asked as `asked_of_clang` asks clang.
function asked_through(program: str, words: [str], what: str, err_path: str) -> str?
    # **`discard()` and not `""`, because the empty path INHERITS.** Under the
    # net this compiler is a child whose stdout is a capture file, and a clang
    # that outlives it goes on holding that file: `docs/panel/174` route F, and
    # defect 074 is what it cost.
    ran = process.run(program: program, words: words, out: process.discard(), err: err_path)
    noise: str @= ""

    # **clang's words are read back where the bytes enter**, by
    # `read_back.words`, so every reader after it has the two repairs it
    # makes. A byte that is not UTF-8 is written by its value (defect 337):
    # clang prints a location's file name as it was given, and `read_file`
    # refused the whole stream for one such byte, so an author's extern
    # disagreement was `internal error` over an empty line at exit 2. And a
    # line ended `\r\n` is read as ended `\n`, because **clang on Windows ends
    # its lines `\r\n`, and the `\r` is poison downstream**: the MSVC-built
    # clang.exe writes text-mode line endings, so every line of its stderr
    # carried a trailing `\r` into `emit_ffi`'s parsing: the last word of
    # `heroes-ffi-return sqrt i64` became `i64\r`, the diagnostic quoted
    # `` `i64\r` `` (measured 2026-08-31, `od` on the captured file: `i 6 4 \r`
    # inside the message), and `heroes-ffi-const`'s marker stopped matching at
    # all, which demoted the author's own error to exit 2.
    captured = read_back.words(err_path)

    if !captured.is_err()
        noise @ captured.must()

    # **Never started is not the same as ran and failed**, and until
    # M-argv-execution this line could not tell them apart: `system()`
    # answers 127 for a missing program and for one that exits 127
    # alike, so a machine with no clang was reported as the compiler's
    # own bug — *"internal error: the runtime did not compile"*.
    # **AND "NOT STARTED" IS NOT THE SAME AS "NOT THERE."** This line named the
    # PATH for every refusal the operating system makes, including one about a
    # file a descendant held, on a machine whose clang had never moved. The
    # number separates them (`docs/panel/174` route G).
    # **Its own code, too** (defect 134): it said `clang`, the code of a
    # refusal, so the caller worded a clang that never ran as clang refusing
    # the generated C. `clang` below means clang ran and exited non-zero.
    if !ran.started
        return fail(
            code: "not_started",
            msg: "clang could not be started, so " + what + " did not run; the operating system's own reason is " + ran.why.to_str() + ".\n  If it is 2 the program is not on this machine's PATH and `heroes doctor` says what is; any other number is the machine refusing for its own reason"
        )

    if ran.code == 0
        return ok(noise)
    died: str @= clang_died.died_by(noise)

    # **A C COMPILER THAT DIED REFUSED NOTHING** (defect 170, 2026-10-03), and
    # it says so in one of two ways: Apple clang 21 catches its own compiler's
    # death and its driver says *failed due to signal*; Debian clang 22.1.8 on
    # Linux arm64 died whole, by the signal itself, and wrote nothing. Either
    # way the C was never judged, which is neither this compiler's mistake nor
    # the author's, so it is neither `internal error` nor clang's crash report,
    # whose files and backtrace speak to clang's own developers. Said here,
    # once, in this compiler's words.
    if died.len() == 0 && ran.signal != 0
        died @ clang_died.ending(ran.signal)

    if died.len() > 0
        return fail(
            code: "crashed",
            msg: what + " stopped: clang died on the C instead of judging it (" + died + "), so nothing in it was refused"
        )
    return fail(code: "clang", msg: refusal(what: what, code: ran.code, noise: noise))

# What clang's refusal says: its own words under what failed, or where it
# wrote none, that it said nothing and how it exited (defect 326's shape),
# where `linking failed:` stood over an empty line.
function refusal(what: str, code: i64, noise: str) -> str
    if strings.trimmed(noise).len() == 0
        return what + " failed: clang exited " + code.to_str() + " and said nothing"
    return what + " failed:\n" + noise

# Compile the runtime once and cache it, keyed on its own contents,
# the level and the compiler. A stale relink is silent, so the key is
# the only thing standing between a golden test and passing for the
# wrong reason. It is published the way a translation unit's object is
# (`units.tu_object`, `cli/publish.hero`): clang writes a private name,
# the object lands as `runtime-<key>-<digest>.o`, named by the headers it
# read, and the record `runtime-<key>.deps.txt` that names it lands last.
# **"Whoever wins the race published byte-for-byte our object" was true of
# the bytes and false of the race** (defect 134): every build in the tree
# staged it as `runtime-<key>.o.tmp`, and on a cold `build/` five of six
# started together failed, the first rename taking the others' object.
#
# **"The compiler" was the HEROES compiler's version, and "everything" was
# false** (defect 122, measured by panel 182's critic): the key held no C
# compiler and no flag, so a runtime object Apple clang 21 compiled was served
# to a build under Homebrew clang 22.1.8, and one compiled without a flag to a
# compiler that passes it. The key now carries `compiler_key`, clang's own
# account of what it runs for the flag list, and the sanitizer flags
# themselves rather than one bit.
#
# **The key covers the runtime's own sources and nothing else, so the
# C HEADERS `runtime.c` includes were outside it** — the same hole the
# per-module cache had, one level over, and this one is worse when it
# fires: every translation unit rebuilds against the new headers while
# this object does not, which is a libc ABI mismatch inside a single
# binary and needs nobody to have touched a line of Heroes. So it
# records what clang opened, exactly as `units.tu_object` does, and
# `skip` is the runtime's own directory because `runtime_key` already
# hashes every byte of it (CLAUDE.md §1: a repair is attacked at the
# shapes next to the one that provoked it, before the commit).
function runtime_object(t: Toolchain, level: str, sanitize: bool) -> str?
    key = digest.digest(
        t.fingerprint + "|" + t.compiler_key + "|" + build_words(level: level, sanitize: sanitize) + "|" + t.runtime_key
    )
    process.mkdir_all(t.build)?
    stem = t.build + "/runtime-" + key
    listed = stem + ".deps.txt"
    memo: {str: str} @= {}
    known = deps.vouched(listed, @memo)

    # Served only as its compile wrote it (defect 443, `cli/served.hero`).
    if !known.is_err() && served.serves(stem + "-" + known.must() + ".o")
        return ok(stem + "-" + known.must() + ".o")
    depfile = publish.private_name(stem + ".d")
    staged = publish.private_name(stem + ".o")
    err_path = publish.private_name(stem + ".clang-stderr.txt")
    line: [str] @= strings.with_all(list: ["clang"], more: flags.level_words(level: level, sanitize: sanitize))
    line @ strings.with_all(
        list: line,
        more: ["-c", "-MD", "-MT", "dep", "-MF", depfile, t.runtime + "/runtime.c", "-I", t.runtime, "-o", staged]
    )
    ran = run_clang(line: line, what: "compiling the runtime", err_path: err_path)
    publish.discard(err_path)

    if ran.is_err()
        publish.discard(staged)
        publish.discard(depfile)
        ran?
    rows = deps.rows_of(depfile: depfile, skip: t.runtime + "/", @memo)
    publish.discard(depfile)

    if rows.is_err()
        publish.discard(staged)
        return fail(code: "failed", msg: "cannot record what the runtime's translation unit read")
    listing = deps.pointer_text(rows.must())
    object = stem + "-" + listing.slice(from: 0, to: 16) + ".o"
    served.seal(staged: staged, object: object)?
    publish.publish(staged: staged, path: object, keyed: true)?
    publish.write_whole(path: listed, text: listing, keyed: true)?
    return ok(object)

## Tests

test "digesting and probing — the shell spoken safely"
    assert process.is_directory(path: "runtime")
    assert !process.is_directory(path: "runtime/runtime.c")
    assert process.path_exists(path: "runtime/heroes_runtime.h")
    assert !process.path_exists(path: "runtime/no_such_file.h")

# Defect 276: a hint naming no runtime is refused with what it names, where
# a `./runtime` the search would have reached next stands in this directory;
# a hint naming one is the runtime used.
test "a HEROES_RUNTIME that names no runtime is refused, never passed over (defect 276)"
    match locate_toolchain(hint: "build/selftest-no-runtime-276", fingerprint: "port-test")
        .ok _ => assert false
        .err e =>
            assert e.code == "hint"
            assert e.msg == "`HEROES_RUNTIME` is set to `build/selftest-no-runtime-276`, and no Heroes runtime is there: no file at `build/selftest-no-runtime-276/heroes_runtime.h`; no file at `build/selftest-no-runtime-276/runtime.c`\n  set HEROES_RUNTIME to the directory holding heroes_runtime.h and runtime.c, or unset it to look in ./runtime and beside the compiler"

    assert process.is_directory(path: "runtime")
    assert locate_toolchain(hint: "runtime", fingerprint: "port-test").must().runtime == "runtime"

# Defect 248: what clang says when it compiles a probe's unit is handed back
# to the probe, a header's `#warning` in it; `run_clang` is the one that
# prints, and no probe calls it.
test "a probe's question hands back what clang said, a header's warning in it (defect 248)"
    dir = "build/selftest-asked-248"
    assert !process.mkdir_all(dir).is_err()
    assert !write_file(path: dir + "/warns.h", text: "#warning \"a header warning\"\n#define SEVEN 7\n").is_err()
    assert !write_file(path: dir + "/unit.c", text: "#include \"warns.h\"\nint seven(void) { return SEVEN; }\n").is_err()
    said = asked_of_clang(
        line: ["clang", "-fsyntax-only", dir + "/unit.c"],
        what: "a probe",
        err_path: dir + "/unit-stderr.txt"
    ).must()
    assert strings.holds(text: said, needle: "a header warning")

# Defect 337: clang prints a location's file name as it was given, and the
# fixture header's `#line` gives it `caf` and the byte 0xE9. **The byte stands
# raw in the committed header**, `unsupported/fixedbugs-337-located.h`, since
# 2026-10-05: this test wrote the escape `\351` until then, which clang 23.1.1
# refuses (*invalid escape sequence in an unevaluated string literal*) and so
# never reached clang's words on the Windows box, where the test failed; a
# `str` cannot hold the byte, so no test writes it. Measured the same day on
# Apple clang 21, Debian clang 18.1.8, 20.1.8 and 22.1.8 and clang 23.1.1: the
# raw byte is taken with a warning, and the location comes out with it. What
# clang said comes back whole, the byte written by its value, on success and
# on a refusal alike, and the refusal's marker with it.
test "clang's words holding a byte that is not UTF-8 are kept whole, a refusal's marker with them (defect 337)"
    dir = "build/selftest-said-337"
    assert !process.mkdir_all(dir).is_err()
    fixtures = "tests/golden/unsupported"
    assert !write_file(path: dir + "/fine.c", text: "#include \"fixedbugs-337-located.h\"\nint seven(void) { return 7; }\n").is_err()
    said = asked_of_clang(
        line: ["clang", "-fsyntax-only", "-I", fixtures, dir + "/fine.c"],
        what: "a probe",
        err_path: dir + "/fine-stderr.txt"
    ).must()
    assert strings.holds(text: said, needle: "caf<0xE9>.h:1:2: warning: \"a warning the header carries\"")
    assert !write_file(path: dir + "/refused.c", text: "#include \"fixedbugs-337-located.h\"\n_Static_assert(0, \"heroes-ffi-return wide_count i32\");\n").is_err()

    match asked_of_clang(line: ["clang", "-fsyntax-only", "-I", fixtures, dir + "/refused.c"], what: "compiling the generated C", err_path: dir + "/refused-stderr.txt")
        .ok => assert false
        .err e =>
            assert e.code == "clang"
            assert strings.holds(text: e.msg, needle: "caf<0xE9>.h:1:2: warning:")
            assert strings.holds(text: e.msg, needle: "heroes-ffi-return wide_count i32")

# Defect 326's shape at clang: a refusal with no word in it, or only line ends,
# says so and how clang exited, where `linking failed:` stood over an empty
# line; one with words carries them under what failed, as it did.
test "a clang that refused and said nothing is told so, never as an empty line (defect 326)"
    assert refusal(what: "linking", code: 1, noise: "") == "linking failed: clang exited 1 and said nothing"
    assert refusal(what: "linking", code: 1, noise: "\n\n") == "linking failed: clang exited 1 and said nothing"
    assert refusal(what: "linking", code: 1, noise: "ld: symbol(s) not found\n") == "linking failed:\nld: symbol(s) not found\n"

test "the toolchain finds the real runtime and compiles it through system()"
    found = locate_toolchain(hint: "", fingerprint: "port-test")
    assert !found.is_err()
    t = found.must()
    assert t.runtime == "runtime"

    # The real thing: clang compiles the real runtime once, and the
    # second ask is the cache.
    object = runtime_object(t, level: "-O0", sanitize: false)
    assert !object.is_err()
    assert process.path_exists(path: object.must())
    again = runtime_object(t, level: "-O0", sanitize: false)
    assert again.must() == object.must()

    # A broken unit fails with clang's own words carried back.
    assert !write_file(path: "build/selftest_broken.c", text: "int main(void) { return undeclared_name; }\n").is_err()
    bad = run_clang(
        line: ["clang", "-c", "build/selftest_broken.c", "-o", "build/selftest_broken.o"],
        what: "compiling the generated C",
        err_path: "build/selftest_err.txt"
    )

    match bad
        .ok => assert false
        .err e =>
            assert e.code == "clang"
            assert strings.holds(text: e.msg, needle: "undeclared_name")

test "the runtime's object is named by what it read, beside the record that names it, and nothing private is left (defect 134)"
    t: Toolchain @= locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-runtime-object"
    assert !process.remove_tree(t.build).is_err()
    object = runtime_object(t, level: "-O0", sanitize: false).must()
    listed = process.files_under(t.build).must()

    # The object, its seal (defect 443) and the record, and no fourth name:
    # clang's stderr, its dependency listing and the staged object were
    # private and are gone.
    assert listed.len() == 3

    for path in listed
        assert !strings.ends_with(text: path, suffix: ".tmp")
        assert path == object || path == served.seal_of(object) || strings.ends_with(text: path, suffix: ".deps.txt")

    assert runtime_object(t, level: "-O0", sanitize: false).must() == object

# DEFECT 435's finding, pinned (2026-10-07): a warm build does not compile
# the runtime. The clang line naming `runtime/runtime.c` that every build's
# log shows is `clang_floor.identity`'s `-###`, which prints what clang would
# run and compiles nothing; measured by logging every clang call, a warm
# `build`, `run` or `test` of `print(1)` makes three, that one, the headers'
# `-M` and the link. The object is `runtime_object`'s, served by its record:
# asked again under the same key from a runtime directory that is not there,
# it answers the same object, where a compile would have no `runtime.c` to
# read. The key holds the runtime's contents, never its path, which is what
# this test rests on; one that keyed the path would fail here first.
test "a warm ask for the runtime's object compiles nothing and reads no runtime (defect 435)"
    t: Toolchain @= locate_toolchain(hint: "", fingerprint: "port-test").must()
    t.build @ "build/selftest-runtime-warm-435"
    assert !process.remove_tree(t.build).is_err()
    object = runtime_object(t, level: "-O0", sanitize: false).must()
    gone: Toolchain @= t
    gone.runtime @ "build/selftest-runtime-warm-435-no-runtime"
    assert !process.path_exists(path: gone.runtime)
    assert runtime_object(gone, level: "-O0", sanitize: false).must() == object

    # The same directory at another level is another key, and that one does
    # compile, so it fails where there is nothing to compile.
    assert runtime_object(gone, level: "-O2", sanitize: false).is_err()
    assert !process.remove_tree(t.build).is_err()

test "an object compiled under one clang answer is never served under another (defect 122)"
    found = locate_toolchain(hint: "", fingerprint: "port-test")
    assert !found.is_err()
    here = found.must()

    # The banner is what this machine's clang said first, and the floor
    # reads it.
    assert here.compiler_banner.len() > 0
    assert !clang_floor.check(here.compiler_banner).is_err()

    # The same toolchain as clang describes it under one more flag: the
    # answer is clang's own, asked of the real compiler, so what moves the
    # key is what the world said and not a string this test made up.
    more = strings.with_all(list: flags.level_words(level: "-O0", sanitize: false), more: ["-DHEROES_KEY_PROBE=1"])
    said = clang_floor.identity(build_dir: "build", runtime: here.runtime, words: more)
    assert !said.is_err()
    other: Toolchain @= here
    other.compiler_key @ digest.digest(more.join(" ") + "|" + answer_text(said))
    assert other.compiler_key != here.compiler_key

    # Warm under one, then the other: a second object is COMPILED rather
    # than the first served, and the first is still the first one's.
    first = runtime_object(here, level: "-O0", sanitize: false).must()
    second = runtime_object(other, level: "-O0", sanitize: false).must()
    assert first != second
    assert process.path_exists(path: second)
    assert runtime_object(here, level: "-O0", sanitize: false).must() == first

    # And so do the sanitizer's flags, which were one bit.
    assert build_words(level: "-O0", sanitize: true) == "-O0|-g|-fsanitize=address,undefined"
    assert build_words(level: "-O2", sanitize: false) == "-O2|-gline-tables-only|"
