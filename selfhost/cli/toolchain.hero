# Everything between the generated C and a running binary: where the
# runtime is, what clang is invoked with, and what is cached where
# (design.md §3.1; panels 020, 036, 055). Port of the toolchain half
# of archive/bootstrap-rs/heroes-cli/src/commands/toolchain.rs.
#
# THE CACHE KEY IS THE WHOLE CONFIGURATION, not the source. Measured
# in the bootstrap: hero_print_int changed with runtime.o not
# recompiled relinked silently and printed the old bytes; the compiler
# itself joined the key after two debugging detours on stale output —
# the most expensive shape a build system has, a correct fix that
# appears not to work.
#
# Port decisions, each recorded here and in DECIDE.md's CLI entry:
# - clang and the filesystem verbs arrive through C's own system()
#   (§1.11 eating its own cooking), with stderr redirected to a file
#   under build/ and read back — which is what keeps the ffi error
#   mapping working.
# - the digest is `digest.digest` — two polynomial hashes rather
#   than FNV-64, with the reason in that file. It left this one on
#   2026-08-26 because the runtime object's freshness check needs
#   `cli_deps`, `cli_deps` needs to hash a file, and Heroes refuses
#   module cycles.
# - the compiler fingerprint and the runtime hint arrive as PARAMETERS
#   from the driver: the language has no current_exe and no getenv
#   (yet — the DECIDE entry owns the question).
# - the runtime's contents are gathered by one shell glob (`cat` in
#   the shell's sorted order) because the language has no readdir;
#   same fact, same key, different plumbing.

use cli/io
use cli/deps
use cli/digest
use cli/flags
use cli/process
use cli/runtime_key
use cli/strings

record Toolchain
    runtime: str
    build: str
    fingerprint: str
    # The runtime's whole contents, already hashed. It is a FIELD and
    # not a call because the per-module path asks for it once per
    # translation unit: on the compiler's own source that was 157 shell
    # `cat` invocations and 25 MB of hashing (162 KB × 157) for one
    # answer that cannot change during a build. Located once, here.
    runtime_key: str

# Locate the runtime, or say the places it looked. The search is why
# the ABI stamp exists: a decoy runtime/ compiled with zero warnings
# under -Weverything and printed 0x1e where 30 was expected; the stamp
# turns that silence into `use of undeclared identifier`.
function locate_toolchain(hint: str, fingerprint: str) -> Toolchain?
    candidates: [str] @ []

    if hint.len() > 0
        candidates @ candidates.push(hint)
    candidates @ candidates.push("runtime")

    for candidate in candidates
        if !read_file(candidate + "/heroes_runtime.h").is_err() && !read_file(candidate + "/runtime.c").is_err()
            gathered = runtime_key.runtime_text(candidate)?

            return ok(
                Toolchain(runtime: candidate, build: "build", fingerprint: fingerprint, runtime_key: digest.digest(gathered))
            )

    return fail(
        code: "failed",
        msg: "cannot find the Heroes runtime (heroes_runtime.h and runtime.c).\n  looked in: the given hint and ./runtime\n  set HEROES_RUNTIME=<dir> to say where it is"
    )

# Run one clang line, stderr captured to a file and read back. clang's
# own words are kept verbatim: a failure here says THE COMPILER is
# wrong — the generated C is not the author's text — so the caller
# exits 2. A WARNING is forwarded rather than swallowed, and that is
# the whole point of the flag set: a warning nobody sees cannot
# falsify anything.
function run_clang(line: [str], what: str, err_path: str) -> ()?
    # **`discard()` and not `""`, because the empty path INHERITS.** Under the
    # net this compiler is a child whose stdout is a capture file, and a clang
    # that outlives it goes on holding that file: `docs/panel/174` route F, and
    # defect 074 is what it cost.
    ran = process.run(program: "clang", words: line, out: process.discard(), err: err_path)
    noise: str @ ""
    captured = read_file(err_path)

    if !captured.is_err()
        # **clang on Windows ends its lines `\r\n`, and the `\r` is poison
        # downstream.** The MSVC-built clang.exe writes text-mode line
        # endings, so every line of its stderr carried a trailing `\r` into
        # `emit_ffi`'s parsing: the last word of `heroes-ffi-return sqrt i64`
        # became `i64\r`, the diagnostic quoted `` `i64\r` `` (measured
        # 2026-08-31, `od` on the captured file: `i 6 4 \r` inside the
        # message), and `heroes-ffi-const`'s marker stopped matching at all,
        # which demoted the author's own error to exit 2. One normalisation
        # here, where the bytes enter, covers every reader after it.
        noise @ strings.without_returns(captured.must())

    # **Never started is not the same as ran and failed**, and until
    # M-argv-execution this line could not tell them apart: `system()`
    # answers 127 for a missing program and for one that exits 127
    # alike, so a machine with no clang was reported as the compiler's
    # own bug — *"internal error: the runtime did not compile"*.
    # **AND "NOT STARTED" IS NOT THE SAME AS "NOT THERE."** This line named the
    # PATH for every refusal the operating system makes, including one about a
    # file a descendant held, on a machine whose clang had never moved. The
    # number separates them (`docs/panel/174` route G).
    if !ran.started
        return fail(
            code: "clang",
            msg: "clang could not be started, so " + what + " did not run; the operating system's own reason is " + ran.why.to_str() + ".\n  If it is 2 the program is not on this machine's PATH and `heroes doctor` says what is; any other number is the machine refusing for its own reason"
        )

    if ran.code == 0
        if strings.trimmed(noise).len() > 0
            io.eprint_raw(text: noise)
        return ok()
    return fail(code: "clang", msg: what + " failed:\n" + noise)

function dir_for(t: Toolchain, source_name: str, text: str, level_key: str, sanitize: bool, search: str) -> str?
    san: str @ ""

    if sanitize
        san @ "+san"
    key = digest.digest(
        t.fingerprint + "|" + level_key + san + "|" + source_name + "|" + text + "|" + t.runtime_key + search
    )
    dir = t.build + "/" + key
    made = process.mkdir_all(dir)

    if made.is_err()
        return fail(code: "failed", msg: "cannot create " + dir)
    return ok(dir)

# Compile the runtime once and cache it, keyed on its own contents,
# the level and the compiler. A stale relink is silent, so the key is
# the only thing standing between a golden test and passing for the
# wrong reason. Staged beside and moved into place: mv inside one
# directory is atomic on POSIX, and whoever wins the race published
# byte-for-byte our object, because the key covers everything.
#
# **The key covers the runtime's own sources and nothing else, so the
# C HEADERS `runtime.c` includes were outside it** — the same hole the
# per-module cache had, one level over, and this one is worse when it
# fires: every translation unit rebuilds against the new headers while
# this object does not, which is a libc ABI mismatch inside a single
# binary and needs nobody to have touched a line of Heroes. So it
# records what clang opened, exactly as `units.tu_object` does, and
# `skip` is the runtime's own directory because `runtime_key` already
# hashes every byte of it (CLAUDE.md §1: a repair is attacked at the
# shapes next to the one that provoked it, before the commit).
function runtime_object(t: Toolchain, level: str, sanitize: bool) -> str?
    key = digest.digest(t.fingerprint + "|" + level + "|" + strings.bool_text(sanitize) + "|" + t.runtime_key)
    made = process.mkdir_all(t.build)

    if made.is_err()
        return fail(code: "failed", msg: "cannot create " + t.build)
    object = t.build + "/runtime-" + key + ".o"
    memo: {str: str} @ {}

    if process.path_exists(object) && deps.fresh(deps.record_for(object), @memo)
        return ok(object)
    depfile = object + ".d"
    staged = object + ".tmp"
    line: [str] @ strings.with_all(list: ["clang"], more: flags.flags())
    line @ line.push(level)
    line @ strings.with_all(list: line, more: flags.sanitizers(sanitize: sanitize))
    line @ strings.with_all(
        list: line,
        more: ["-c", "-MD", "-MT", "dep", "-MF", depfile, t.runtime + "/runtime.c", "-I", t.runtime, "-o", staged]
    )

    # Beside its object, one file per clang invocation: `units.tu_object` (057).
    ran = run_clang(line: line, what: "compiling the runtime", err_path: object + ".clang-stderr.txt")

    if ran.is_err()
        ran?

    # Recorded before the object is published, so an object on disk is
    # never one this cache cannot justify serving.
    recorded = deps.record_deps(
        record_path: deps.record_for(object),
        depfile: depfile,
        skip: t.runtime + "/",
        @memo
    )

    if recorded.is_err()
        return fail(code: "failed", msg: "cannot record what the runtime's translation unit read")

    if process.rename_over(from: staged, to: object).is_err()
        return fail(code: "failed", msg: "cannot publish " + object)
    return ok(object)

function link(t: Toolchain, c_file: str, object: str, binary: str, level: str, sanitize: bool, source_dir: str, search_include: [str], search_library: [str], package_flags: [str], link_names: [str]) -> ()?
    # Beside the C it compiles: `units.tu_object` (057). The two invocations
    # below share it and are sequential; no other build in the tree writes it.
    err_path = c_file + ".clang-stderr.txt"
    unit_object = c_file + ".o"
    staged_object = unit_object + ".tmp"
    compile_line: [str] @ strings.with_all(list: ["clang"], more: flags.flags())
    compile_line @ compile_line.push(level)
    compile_line @ strings.with_all(list: compile_line, more: flags.sanitizers(sanitize: sanitize))
    compile_line @ compile_line.push("-c")

    for dir in search_include
        compile_line @ strings.with_all(list: compile_line, more: ["-I", dir])

    for flag in package_flags
        if strings.starts_with(text: flag, prefix: "-I")
            compile_line @ compile_line.push(flag)

    compile_line @ strings.with_all(list: compile_line, more: [c_file, "-I", t.runtime])

    if source_dir.len() > 0
        compile_line @ strings.with_all(list: compile_line, more: ["-I", source_dir])
    compile_line @ strings.with_all(list: compile_line, more: ["-o", staged_object])
    compiled = run_clang(line: compile_line, what: "compiling the generated C", err_path: err_path)

    if compiled.is_err()
        compiled?

    if process.rename_over(from: staged_object, to: unit_object).is_err()
        return fail(code: "failed", msg: "cannot publish " + unit_object)
    link_line: [str] @ strings.with_all(list: ["clang"], more: flags.flags())
    link_line @ link_line.push(level)
    link_line @ strings.with_all(list: link_line, more: flags.sanitizers(sanitize: sanitize))
    link_line @ strings.with_all(list: link_line, more: flags.link_flags())

    for dir in search_include
        link_line @ strings.with_all(list: link_line, more: ["-I", dir])

    for dir in search_library
        link_line @ strings.with_all(list: link_line, more: ["-L", dir])

    link_line @ strings.with_all(list: link_line, more: [unit_object, object])

    for flag in package_flags
        link_line @ link_line.push(flag)

    for name in link_names
        link_line @ link_line.push("-l" + name)

    staged = binary + ".tmp"
    link_line @ strings.with_all(list: link_line, more: ["-o", staged])
    linked = run_clang(line: link_line, what: "linking", err_path: err_path)

    if linked.is_err()
        linked?

    if process.rename_over(from: staged, to: binary).is_err()
        return fail(code: "failed", msg: "cannot publish " + binary)
    return ok()

## Tests

test "digesting and probing — the shell spoken safely"
    assert process.is_directory(path: "runtime")
    assert !process.is_directory(path: "runtime/runtime.c")
    assert process.path_exists(path: "runtime/heroes_runtime.h")
    assert !process.path_exists(path: "runtime/no_such_file.h")

test "the toolchain finds the real runtime and compiles it through system()"
    found = locate_toolchain(hint: "", fingerprint: "port-test")
    assert !found.is_err()
    t = found.must()
    assert t.runtime == "runtime"

    # The runtime's contents reach the key: a different fingerprint is
    # a different directory.
    d1 = dir_for(t, source_name: "x.hero", text: "a", level_key: "-O0", sanitize: false, search: "")
    d2 = dir_for(t, source_name: "x.hero", text: "b", level_key: "-O0", sanitize: false, search: "")
    assert !d1.is_err()
    assert d1.must() != d2.must()
    assert process.is_directory(path: d1.must())

    # The real thing: clang compiles the real runtime once, and the
    # second ask is the cache.
    object = runtime_object(t, level: "-O0", sanitize: false)
    assert !object.is_err()
    assert process.path_exists(path: object.must())
    again = runtime_object(t, level: "-O0", sanitize: false)
    assert again.must() == object.must()

    # A broken unit fails with clang's own words carried back.
    assert !write_file(path: "build/selftest_broken.c", text: "int main(void) { return undeclared_name; }\n").is_err()
    bad = run_clang(
        line: ["clang", "-c", "build/selftest_broken.c", "-o", "build/selftest_broken.o"],
        what: "compiling the generated C",
        err_path: "build/selftest_err.txt"
    )

    match bad
        .ok => assert false
        .err e =>
            assert e.code == "clang"
            assert has_text(text: e.msg, needle: "undeclared_name")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
