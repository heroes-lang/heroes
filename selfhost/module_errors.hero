# The module diagnostics (M-module-namespace, panel 031).
# Port of crates/heroes/src/resolve/errors_modules.rs — in Rust a submodule
# re-exported through errors.rs; here its own file, because the §11
# threshold is a reason to split where Rust's namespacing was a reason not
# to bother.
#
# Four of them exist only because **`use` binds**: naming a module twice,
# naming one the file also declares, never reading one, and writing a
# module where a value belongs. The other three are the qualification rules
# themselves — and two of those are what the spec bought instead of a
# sentence (panel 031 R5), so the wording carries the whole rule and the
# fix carries the repair.
#
# The line between certain and guess is resolve_errors' own, applied once
# more: `geom.f` is certain because it repairs the line and leaves a
# program that checks clean; `f` from a module with no `use` is a GUESS
# because applying it leaves a file that still needs the `use`.

use token
use diag

# One module named twice in one file. Not a shadowing error and not a
# duplicate declaration — it is a line that does nothing, and saying which
# of the three it is costs nothing here and a guess to the reader otherwise.
function used_twice(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "used_twice", message: "`" + name + "` is already named by a `use` in this file — one `use` per module is all there is to say", span: span)

# `use geom` in a file that also declares `geom`. Spec's shadowing rule,
# reached because `use` BINDS (panel 031 R3): the module name and the
# declaration are one name meaning two things.
function use_shadows_a_declaration(name: str, declared_at: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "shadowed_binding", message: "`use " + name + "` binds `" + name + "`, and this file already declares `" + name + "` at " + declared_at + " — shadowing is an error here, so one of the two has to be renamed", span: span)

# A `use` nothing read. The unused rule, reached the same way.
function unused_use(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(code: "unused_binding", message: "`use " + name + "` is never used — nothing in this file names anything from `" + name + "`", span: span)
    d.notes @ d.notes.push("delete the line: an import that is not read is a dependency that is not real")
    return d

# `geom.f` where `geom` is a module this file `use`s and `f` is not in it.
function not_in_module(module: str, name: str, near: [str], span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(code: "unknown_in_module", message: "module `" + module + "` declares nothing called `" + name + "`", span: span)
    if near.len() == 1
        d.message @ "module `" + module + "` declares nothing called `" + name + "` — it has `" + near[0] + "`"
        d.fixes @ d.fixes.push(diag.Fix(title: "write `" + module + "." + near[0] + "`", replacement: near[0], span: span, certainty: .certain))
    else if near.len() > 1
        d.message @ "module `" + module + "` declares nothing called `" + name + "` — it has " + listed(near)
    return d

# The one panel 031 R5 bought instead of a spec sentence: an unqualified
# name that exists, in a module this file already `use`s. It carries a
# CERTAIN fix, and that is the whole trade — the spec says nothing about
# UFCS across a module boundary because the error says everything, at the
# call site, with the repair pre-written (CLAUDE.md §8).
function needs_qualifying(name: str, module: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(code: "needs_qualifying", message: "`" + name + "` is declared in module `" + module + "`, and a name from another module is always written qualified — `" + module + "." + name + "`", span: span)
    d.fixes @ d.fixes.push(diag.Fix(title: "write `" + module + "." + name + "`", replacement: module + "." + name, span: span, certainty: .certain))
    return d

# The same, for a module the file has not named yet. The fix is NOT
# certain: it repairs this line and leaves the file needing a `use`, and a
# machine-applicable fix has to leave a program that checks clean.
function needs_a_use(name: str, module: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(code: "needs_qualifying", message: "`" + name + "` is declared in module `" + module + "`, which this file does not name — add `use " + module + "` at the top and write `" + module + "." + name + "`", span: span)
    d.fixes @ d.fixes.push(diag.Fix(title: "write `" + module + "." + name + "` (and add `use " + module + "`)", replacement: module + "." + name, span: span, certainty: .guess))
    return d

# A module name standing on its own. It is not a value in any position —
# only a dot may follow it — and "unknown name" would be a lie about a name
# the file's own `use` line put there.
function module_is_not_a_value(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "module_is_not_a_value", message: "`" + name + "` names a module, not a value — a module can only be followed by a dot, as in `" + name + ".something`", span: span)

# `geom.f` where `geom` is not a module this file names.
function not_a_module(name: str, known: [str], span: token.Span) -> diag.Diagnostic
    message: str @ "`" + name + "` is not a module this file names, and not a value either"
    if known.len() > 0
        message @ message + " — it names " + listed(known)
    return diag.new_diagnostic(code: "not_a_module", message: message, span: span)

# `a, b and c`, which is how every list in this file's messages is written.
function listed(items: [str]) -> str
    if items.len() == 0
        return ""
    if items.len() == 1
        return "`" + items[0] + "`"
    head: [str] @ []
    i: i64 @ 0
    while i < items.len() - 1
        head @ head.push("`" + items[i] + "`")
        i @ i + 1
    return head.join(", ") + " and `" + items[items.len() - 1] + "`"

## Tests

test "one candidate rewrites the line, several stay prose"
    span = token.Span(start: 0, end: 4)
    one: [str] = ["dist2"]
    d = not_in_module(module: "geom", name: "dist", near: one, span: span)
    assert d.message == "module `geom` declares nothing called `dist` — it has `dist2`"
    assert d.fixes.len() == 1
    assert d.fixes[0].certainty == .certain
    three: [str] = ["a", "b", "c"]
    e = not_in_module(module: "geom", name: "dist", near: three, span: span)
    assert e.fixes.len() == 0
    assert e.message == "module `geom` declares nothing called `dist` — it has `a`, `b` and `c`"

test "the qualification pair splits exactly at the missing use"
    span = token.Span(start: 0, end: 5)
    have = needs_qualifying(name: "dist2", module: "geom", span: span)
    assert have.fixes[0].certainty == .certain
    assert have.fixes[0].replacement == "geom.dist2"
    missing = needs_a_use(name: "dist2", module: "geom", span: span)
    assert missing.fixes[0].certainty == .guess
    assert missing.code == "needs_qualifying"

test "the list reads as prose, whatever its length"
    zero: [str] = []
    assert listed(zero) == ""
    one: [str] = ["x"]
    assert listed(one) == "`x`"
    two: [str] = ["x", "y"]
    assert listed(two) == "`x` and `y`"
    three: [str] = ["x", "y", "z"]
    assert listed(three) == "`x`, `y` and `z`"

test "an unused use carries its note, not a fix"
    d = unused_use(name: "geom", span: token.Span(start: 0, end: 8))
    assert d.fixes.len() == 0
    assert d.notes.len() == 1
    assert d.notes[0] == "delete the line: an import that is not read is a dependency that is not real"
