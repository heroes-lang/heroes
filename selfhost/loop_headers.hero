# C's loop headers as the lexer reads them (design.md §4.7, §4.17; defects
# 194, 301, 312, 365 and 366): `for (i = 0; i < n; i++)`, `for i = 0; i <
# n; i++` written bare, and a step written in a `while`, `while i < 3; i++`.
# Their `;` are no strays of the program's: in a `for` they are the
# header's, left to the parser's one report of it (`parse/loop_habit`), and
# in a `while` they are told here once, the clauses past the first taken
# with it. Out of `closers.hero` on 2026-10-06 (defect 365), a concern of
# its own: which opener a closer closes is that module's, and these read the
# words before an opener and the clauses inside it.
#
# | entry | called by |
# |---|---|
# | `header_semicolon` | `scan.punct`, a `;` of C's header, in its `(` or bare |
# | `for_header` | `bracket_reach.a_header_open`, where the header's reach ends |

use token
use diag
use state
use closers
use separator_runs
use word_place
use lex_asked

# The index in `l.open_brackets` of the `(` right after a `for`, C's
# three-clause header `for (i = 0; i < n; i++)`, whose `;` are its own and
# no strays of the program's, or -1: the parser tells the header once, at
# that `(` (`parse/loop_habit.refuse`, defect 194), where each `;` cost a
# message. The innermost open above the innermost hole whose line has `for`
# the word before it: a bracket the header holds stands in it, a call or a
# list left open there, `for (i = 0; i < f(3; i++` (defect 366), and one in
# a hole opened inside it is the hole's, `for (f"{a; b}")` (defect 312). An
# `in` past it makes it an iteration written in parentheses, `for (x in
# xs)`, and no C header.
function for_header(@l: state.LexState, text: str) -> i64
    return opened_by(@l, text: text, word: "for")

# The index in `l.open_brackets` of the innermost `(` above the innermost
# hole whose line has `word` the word before it, or -1; for `for`, -1 where
# an `in` stands past it (`for_header`). That no `(` stands after the word
# is remembered until an opener is pushed (`lex_asked.hero`), since a stack
# with no push since is a prefix of the one read: 4,000 `(` over 4,000
# lines read the stack at every line (defect 495).
function opened_by(@l: state.LexState, text: str, word: str) -> i64
    floor: i64 @ 0

    if l.holes.len() > 0
        floor @ l.holes[l.holes.len() - 1]
    slot: i64 @ -1

    if word == "for"
        slot @ 0
    else if word == "while"
        slot @ 1

    if slot >= 0 && l.asked[lex_asked.OPENED_AT + slot] == l.asked[lex_asked.PUSHES] && floor >= l.asked[lex_asked.OPENED_FLOOR + slot]
        return -1
    k: i64 @ l.open_brackets.len() - 1

    while k >= floor
        open = l.open_brackets[k].start

        if text[open] == '(' && word_place.word_ending(text, at: word_place.significant_before(text, at: open, floor: 0) + 1) == word
            if word == "for" && in_past(@l, open: open)
                return -1
            return k
        k @ k - 1

    if slot >= 0
        l.asked[lex_asked.OPENED_AT + slot] @ l.asked[lex_asked.PUSHES]
        l.asked[lex_asked.OPENED_FLOOR + slot] @ floor
    return -1

# A `;` of C's `for` header at `at`, left to the parser's one report of it:
# one in the header's `(` a token of its own (defect 194), and so is one in
# a bracket the header holds where the header holds two at most, C's three
# clauses, the bracket's `)` left out (defect 366): past two, it is the
# bracket's own, `f(1; 2)`, told as a stray. And one of a header written
# bare, `for i = 0; i < 3; i++`, with the rest of its line, every clause
# past it, which no line of the language holds (defect 301): its `++` then
# asks no line below to go on, and the body below is read as one. True
# where the `;` was taken so.
function header_semicolon(@l: state.LexState, text: str, at: i64) -> bool
    header = for_header(@l, text)

    if header >= 0 && (header == l.open_brackets.len() - 1 || semicolons_of(@l, text, from: l.open_brackets[header].start, at: at) <= 2)
        state.error_token_at(@l, at)
        return true

    # C's step written in a `while`, `while (i < 3; i++)` or bare, told once
    # at its first `;`, its clauses taken with it (defect 365).
    if opened_by(@l, text: text, word: "while") >= 0
        l.pos @ clauses_end(text, from: l.pos)
        in_a_while(@l, at: at)
        return true

    if l.open_brackets.len() > 0 || l.holes.len() > 0
        return false

    if begun_by(@l, text, at: at, keyword: .kw_while) && !separator_runs.ends_its_line(text, at: l.pos)
        l.pos @ header_end(text, from: l.pos)
        in_a_while(@l, at: at)
        return true

    if !begun_by(@l, text, at: at, keyword: .kw_for)
        return false
    l.pos @ header_end(text, from: l.pos)
    state.error_token_at(@l, at)
    return true

# The `;` at `at` of C's step in a `while`, which holds its condition alone,
# told, and the clauses past it to `l.pos` an `error` token, which the
# parser passes as told: one message where each `;` and the step's `++`
# cost one (defect 365).
function in_a_while(@l: state.LexState, at: i64)
    state.push_diagnostic(
        @l.diagnostics,
        diag.new_diagnostic(code: "unexpected_character", message: "`;` is not part of the language's syntax — a `while` holds its condition alone, `while i < 3`, and a step goes last in its body, `i @ i + 1`", span: token.Span(start: at, end: at + 1))
    )
    state.error_token_at(@l, at)

# Past the clauses from `from` in a `while`'s `(`, to the `)` that closes
# it, a comment or the line's end, the spaces before any of them left out.
function clauses_end(text: str, from: i64) -> i64
    i: i64 @ from
    last: i64 @ from
    depth: i64 @ 0

    while i < text.len() && text[i] != '\n' && text[i] != '\r' && text[i] != '#'
        b = text[i]

        if b == '"' || b == '\''
            i @ closers.past_literal(text, from: i)
            last @ i
            continue

        if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if b == ')' || b == ']' || b == '}'
            if depth == 0
                return last
            depth @ depth - 1

        if b != ' ' && b != '\t'
            last @ i + 1
        i @ i + 1

    return last

# `semicolons`, remembered for the line it was asked on: asked again for the
# same `(` on the same line, the count is the same, where it read the
# header from its `(` again for every `;` (defect 495).
function semicolons_of(@l: state.LexState, text: str, from: i64, at: i64) -> i64
    last = l.asked[lex_asked.SEMI_AT]

    if l.asked[lex_asked.SEMI_FROM] == from && last >= 0 && last <= at && !line_end_in(text, from: last, to: at)
        l.asked[lex_asked.SEMI_AT] @ at
        return l.asked[lex_asked.SEMI_COUNT]
    count = semicolons(text, from: from, at: at)
    l.asked[lex_asked.SEMI_FROM] @ from
    l.asked[lex_asked.SEMI_AT] @ at
    l.asked[lex_asked.SEMI_COUNT] @ count
    return count

# Whether a line end stands from `from` up to `to`.
function line_end_in(text: str, from: i64, to: i64) -> bool
    i: i64 @ from

    while i < to
        if text[i] == '\n'
            return true
        i @ i + 1

    return false

# How many `;` stand from the header's `(` at `from` to the end of the line
# that holds the offset `at`, strings and comments left out.
function semicolons(text: str, from: i64, at: i64) -> i64
    count: i64 @ 0
    i: i64 @ from

    while i < text.len() && (i < at || text[i] != '\n')
        b = text[i]

        if b == '"' || b == '\''
            i @ closers.past_literal(text, from: i)
        else if b == '#'
            while i < text.len() && text[i] != '\n'
                i @ i + 1
        else
            if b == ';'
                count @ count + 1
            i @ i + 1

    return count

# Whether the line of offset `at` begins with `keyword`, `for` or `while`,
# and holds no `in` before it, the iteration's own word, which C's header
# never writes. The line's tokens are read once and read on as they come
# (`lex_asked.hero`), where a line of `x; ` a thousand times read them again
# for every `;` (defect 495). Read as the walk it replaces read them: back
# from the last token to the first standing before the line, its first word
# the earliest that is no comment and no line end.
function begun_by(@l: state.LexState, text: str, at: i64, keyword: token.TokenKind) -> bool
    start = line_from(@l, text, at: at)
    seen = l.asked[lex_asked.LINE_SEEN]

    if l.asked[lex_asked.LINE] != start || seen < 0 || seen > l.tokens.len()
        head: i64 @ -1
        held: bool @ false
        i: i64 @ l.tokens.len() - 1

        while i >= 0 && l.tokens[i].span.start >= start
            if l.tokens[i].kind == .kw_in
                held @ true

            if l.tokens[i].kind != .comment && !token.is_line_end(l.tokens[i].kind)
                head @ i
            i @ i - 1

        l.asked[lex_asked.LINE] @ start
        l.asked[lex_asked.LINE_FIRST] @ head
        l.asked[lex_asked.LINE_IN] @ 0

        if held
            l.asked[lex_asked.LINE_IN] @ 1
    else
        j: i64 @ seen

        while j < l.tokens.len()
            if l.tokens[j].span.start < start
                l.asked[lex_asked.LINE_FIRST] @ -1
                l.asked[lex_asked.LINE_IN] @ 0
            else
                if l.tokens[j].kind == .kw_in
                    l.asked[lex_asked.LINE_IN] @ 1

                if l.asked[lex_asked.LINE_FIRST] < 0 && l.tokens[j].kind != .comment && !token.is_line_end(l.tokens[j].kind)
                    l.asked[lex_asked.LINE_FIRST] @ j
            j @ j + 1
    l.asked[lex_asked.LINE_SEEN] @ l.tokens.len()
    first = l.asked[lex_asked.LINE_FIRST]
    return l.asked[lex_asked.LINE_IN] == 0 && first >= 0 && l.tokens[first].kind == keyword

# The first byte of the line holding `at`: found from the last question's
# line where that question stood before `at`, the bytes between read once,
# else read back from `at`.
function line_from(@l: state.LexState, text: str, at: i64) -> i64
    from: i64 @ l.asked[lex_asked.LINE_AT]
    start: i64 @ at

    if from >= 0 && from <= at
        start @ l.asked[lex_asked.LINE_FROM]

        while from < at
            if text[from] == '\n'
                start @ from + 1
            from @ from + 1
    else
        while start > 0 && text[start - 1] != '\n'
            start @ start - 1
    l.asked[lex_asked.LINE_AT] @ at
    l.asked[lex_asked.LINE_FROM] @ start
    return start

# Whether an `in` stands among the tokens past the offset `open`, a `for`
# header's `(`: read once as the walk it replaces read them, back from the
# last token to the first standing at or before `open` (the stream's first
# never asked), and read on as the header's tokens come.
function in_past(@l: state.LexState, open: i64) -> bool
    seen = l.asked[lex_asked.FOR_SEEN]

    if l.asked[lex_asked.FOR_OPEN] != open || seen < 0 || seen > l.tokens.len()
        held: bool @ false
        i: i64 @ l.tokens.len() - 1

        while i > 0 && l.tokens[i].span.start > open
            if l.tokens[i].kind == .kw_in
                held @ true
            i @ i - 1

        l.asked[lex_asked.FOR_OPEN] @ open
        l.asked[lex_asked.FOR_IN] @ 0

        if held
            l.asked[lex_asked.FOR_IN] @ 1
    else
        j: i64 @ seen

        while j < l.tokens.len()
            if l.tokens[j].span.start <= open
                l.asked[lex_asked.FOR_IN] @ 0
            else if l.tokens[j].kind == .kw_in
                l.asked[lex_asked.FOR_IN] @ 1
            j @ j + 1
    l.asked[lex_asked.FOR_SEEN] @ l.tokens.len()
    return l.asked[lex_asked.FOR_IN] == 1

# Past the rest of a line's code from `from`, its strings whole, before a
# comment, the line's end, or a `{` that ends the line, a body's, which the
# brace layout reads; the spaces before any of them left out.
function header_end(text: str, from: i64) -> i64
    i: i64 @ from
    last: i64 @ from

    while i < text.len() && text[i] != '\n' && text[i] != '\r' && text[i] != '#' && !(text[i] == '{' && separator_runs.ends_its_line(text, at: i + 1))
        if text[i] == '"' || text[i] == '\''
            i @ closers.past_literal(text, from: i)
            last @ i
        else
            if text[i] != ' ' && text[i] != '\t'
                last @ i + 1
            i @ i + 1

    return last

## Tests

# Defect 366: a `;` in a bracket C's header holds is the header's while the
# header holds two at most, its lines to the `;`'s own counted, strings left
# out; past two it is the bracket's own, `f(1; 2)`.
test "a header holds two semicolons, its brackets' among them"
    assert semicolons("for (i = 0; i < f(3; i++\n", from: 4, at: 19) == 2
    assert semicolons("for (i = f(1; 2); i < 3; i++)\n", from: 4, at: 12) == 3
    assert semicolons("for (i = 0;\n     i < 3; i++)\n", from: 4, at: 22) == 2
    assert semicolons("for (s = \";\"; s < 3)\n", from: 4, at: 12) == 1

# Defect 495: what a line's `;` ask of its tokens is read once and read on,
# and read again where the tokens were rewritten (`lex_asked.forget`), the
# premise `lex_asked.hero` rests on, which this asks.
test "a line's first word and its `in` are read once, read on, and read again past a rewrite"
    text = "x = 1\nfor i; j; k\n"
    l: state.LexState @ state.new_state()

    for t in [token.made(.ident, start: 0, end: 1), token.made(.eq, start: 2, end: 3), token.made(.int_lit, start: 4, end: 5), token.made(.terminator, start: 5, end: 5), token.made(.kw_for, start: 6, end: 9), token.made(.ident, start: 10, end: 11)]
        state.push_token(@l.tokens, t)

    assert begun_by(@l, text, at: 11, keyword: .kw_for)
    assert !begun_by(@l, text, at: 11, keyword: .kw_while)
    state.push_token(@l.tokens, token.made(.error, start: 11, end: 12))
    state.push_token(@l.tokens, token.made(.ident, start: 13, end: 14))
    assert begun_by(@l, text, at: 14, keyword: .kw_for)

    # An `in` comes: no header; the same count of tokens rewritten without
    # it is read again only where it is forgotten.
    state.push_token(@l.tokens, token.made(.kw_in, start: 15, end: 16))
    assert !begun_by(@l, text, at: 16, keyword: .kw_for)
    l.tokens @ l.tokens.slice(from: 0, to: 8)
    state.push_token(@l.tokens, token.made(.ident, start: 15, end: 16))
    lex_asked.forget(@l.asked)
    assert begun_by(@l, text, at: 16, keyword: .kw_for)

    # The `;` a header holds, asked again on its line, and on the next.
    two = "for (i = f(1; 2; 3\n; 4)\n"
    assert semicolons_of(@l, two, from: 4, at: 12) == 2
    assert semicolons_of(@l, two, from: 4, at: 15) == 2
    assert semicolons_of(@l, two, from: 4, at: 19) == 3
