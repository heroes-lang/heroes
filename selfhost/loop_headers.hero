# C's loop headers as the lexer reads them (design.md §4.7, §4.17; defects
# 194, 301, 312, 365 and 366): `for (i = 0; i < n; i++)`, `for i = 0; i <
# n; i++` written bare, and a step written in a `while`, `while i < 3; i++`.
# Their `;` are no strays of the program's: in a `for` they are the
# header's, left to the parser's one report of it (`parse/loop_habit`), and
# in a `while` they are told here once, the clauses past the first taken
# with it. Out of `closers.hero` on 2026-10-06 (defect 365), a concern of
# its own: which opener a closer closes is that module's, and these read the
# words before an opener and the clauses inside it.
#
# | entry | called by |
# |---|---|
# | `header_semicolon` | `scan.punct`, a `;` of C's header, in its `(` or bare |
# | `for_header` | `bracket_reach.a_header_open`, where the header's reach ends |

use token
use diag
use state
use closers
use separator_runs
use word_place

# The index in `l.open_brackets` of the `(` right after a `for`, C's
# three-clause header `for (i = 0; i < n; i++)`, whose `;` are its own and
# no strays of the program's, or -1: the parser tells the header once, at
# that `(` (`parse/loop_habit.refuse`, defect 194), where each `;` cost a
# message. The innermost open above the innermost hole whose line has `for`
# the word before it: a bracket the header holds stands in it, a call or a
# list left open there, `for (i = 0; i < f(3; i++` (defect 366), and one in
# a hole opened inside it is the hole's, `for (f"{a; b}")` (defect 312). An
# `in` past it makes it an iteration written in parentheses, `for (x in
# xs)`, and no C header.
function for_header(l: state.LexState, text: str) -> i64
    return opened_by(l, text: text, word: "for")

# The index in `l.open_brackets` of the innermost `(` above the innermost
# hole whose line has `word` the word before it, or -1; for `for`, -1 where
# an `in` stands past it (`for_header`).
function opened_by(l: state.LexState, text: str, word: str) -> i64
    floor: i64 @ 0

    if l.holes.len() > 0
        floor @ l.holes[l.holes.len() - 1]
    k: i64 @ l.open_brackets.len() - 1

    while k >= floor
        open = l.open_brackets[k].start

        if text[open] == '(' && word_place.word_ending(text, at: word_place.significant_before(text, at: open, floor: 0) + 1) == word
            i: i64 @ l.tokens.len() - 1

            while word == "for" && i > 0 && l.tokens[i].span.start > open
                if l.tokens[i].kind == .kw_in
                    return -1
                i @ i - 1

            return k
        k @ k - 1

    return -1

# A `;` of C's `for` header at `at`, left to the parser's one report of it:
# one in the header's `(` a token of its own (defect 194), and so is one in
# a bracket the header holds where the header holds two at most, C's three
# clauses, the bracket's `)` left out (defect 366): past two, it is the
# bracket's own, `f(1; 2)`, told as a stray. And one of a header written
# bare, `for i = 0; i < 3; i++`, with the rest of its line, every clause
# past it, which no line of the language holds (defect 301): its `++` then
# asks no line below to go on, and the body below is read as one. True
# where the `;` was taken so.
function header_semicolon(@l: state.LexState, text: str, at: i64) -> bool
    header = for_header(l, text)

    if header >= 0 && (header == l.open_brackets.len() - 1 || semicolons(text, from: l.open_brackets[header].start, at: at) <= 2)
        state.error_token_at(@l, at)
        return true

    # C's step written in a `while`, `while (i < 3; i++)` or bare, told once
    # at its first `;`, its clauses taken with it (defect 365).
    if opened_by(l, text: text, word: "while") >= 0
        l.pos @ clauses_end(text, from: l.pos)
        in_a_while(@l, at: at)
        return true

    if l.open_brackets.len() > 0 || l.holes.len() > 0
        return false

    if begun_by(l, text, at: at, keyword: .kw_while) && !separator_runs.ends_its_line(text, at: l.pos)
        l.pos @ header_end(text, from: l.pos)
        in_a_while(@l, at: at)
        return true

    if !begun_by(l, text, at: at, keyword: .kw_for)
        return false
    l.pos @ header_end(text, from: l.pos)
    state.error_token_at(@l, at)
    return true

# The `;` at `at` of C's step in a `while`, which holds its condition alone,
# told, and the clauses past it to `l.pos` an `error` token, which the
# parser passes as told: one message where each `;` and the step's `++`
# cost one (defect 365).
function in_a_while(@l: state.LexState, at: i64)
    state.push_diagnostic(
        @l.diagnostics,
        diag.new_diagnostic(code: "unexpected_character", message: "`;` is not part of the language's syntax — a `while` holds its condition alone, `while i < 3`, and a step goes last in its body, `i @ i + 1`", span: token.Span(start: at, end: at + 1))
    )
    state.error_token_at(@l, at)

# Past the clauses from `from` in a `while`'s `(`, to the `)` that closes
# it, a comment or the line's end, the spaces before any of them left out.
function clauses_end(text: str, from: i64) -> i64
    i: i64 @ from
    last: i64 @ from
    depth: i64 @ 0

    while i < text.len() && text[i] != '\n' && text[i] != '\r' && text[i] != '#'
        b = text[i]

        if b == '"' || b == '\''
            i @ closers.past_literal(text, from: i)
            last @ i
            continue

        if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if b == ')' || b == ']' || b == '}'
            if depth == 0
                return last
            depth @ depth - 1

        if b != ' ' && b != '\t'
            last @ i + 1
        i @ i + 1

    return last

# How many `;` stand from the header's `(` at `from` to the end of the line
# that holds the offset `at`, strings and comments left out.
function semicolons(text: str, from: i64, at: i64) -> i64
    count: i64 @ 0
    i: i64 @ from

    while i < text.len() && (i < at || text[i] != '\n')
        b = text[i]

        if b == '"' || b == '\''
            i @ closers.past_literal(text, from: i)
        else if b == '#'
            while i < text.len() && text[i] != '\n'
                i @ i + 1
        else
            if b == ';'
                count @ count + 1
            i @ i + 1

    return count

# Whether the line of offset `at` begins with `keyword`, `for` or `while`,
# and holds no `in` before it, the iteration's own word, which C's header
# never writes.
function begun_by(l: state.LexState, text: str, at: i64, keyword: token.TokenKind) -> bool
    start: i64 @ at
    first: i64 @ -1
    i: i64 @ l.tokens.len() - 1

    while start > 0 && text[start - 1] != '\n'
        start @ start - 1

    while i >= 0 && l.tokens[i].span.start >= start
        if l.tokens[i].kind == .kw_in
            return false

        if l.tokens[i].kind != .comment && !token.is_line_end(l.tokens[i].kind)
            first @ i
        i @ i - 1

    return first >= 0 && l.tokens[first].kind == keyword

# Past the rest of a line's code from `from`, its strings whole, before a
# comment, the line's end, or a `{` that ends the line, a body's, which the
# brace layout reads; the spaces before any of them left out.
function header_end(text: str, from: i64) -> i64
    i: i64 @ from
    last: i64 @ from

    while i < text.len() && text[i] != '\n' && text[i] != '\r' && text[i] != '#' && !(text[i] == '{' && separator_runs.ends_its_line(text, at: i + 1))
        if text[i] == '"' || text[i] == '\''
            i @ closers.past_literal(text, from: i)
            last @ i
        else
            if text[i] != ' ' && text[i] != '\t'
                last @ i + 1
            i @ i + 1

    return last

## Tests

# Defect 366: a `;` in a bracket C's header holds is the header's while the
# header holds two at most, its lines to the `;`'s own counted, strings left
# out; past two it is the bracket's own, `f(1; 2)`.
test "a header holds two semicolons, its brackets' among them"
    assert semicolons("for (i = 0; i < f(3; i++\n", from: 4, at: 19) == 2
    assert semicolons("for (i = f(1; 2); i < 3; i++)\n", from: 4, at: 12) == 3
    assert semicolons("for (i = 0;\n     i < 3; i++)\n", from: 4, at: 22) == 2
    assert semicolons("for (s = \";\"; s < 3)\n", from: 4, at: 12) == 1
