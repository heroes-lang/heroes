# Which opener a closer closes (design.md §4.17; defect 131's class, the
# recovery batches' C3, 2026-10-01).
#
# The lexer keeps every opener on one stack. Until 2026-10-01 any closer
# popped the last one, whatever its kind, so a `]` left out inside a call,
# `run(words: ["a", "b"` over `)`, had its `[` closed by the call's `)`, the
# call's `(` named never closed lines below, the wrong opener, and the parser
# met the `)` among the list's elements and refused it: two messages for one
# `]`, the first naming the wrong bracket (the audit's row 131-42, 35 single
# missing closers at two messages each). So a closer of another kind than
# the innermost opener, where an opener of its own kind is open below it, is
# that opener's: each opener above it is named never closed there, its
# closer the one left out, and the closer's offset is kept with the others
# the lexer named openers at (`LexState.closes`), where the parser's pairing
# reads the same (`pairing.paired_closer`). A closer whose kind no
# opener open shares closes the innermost, as before, `print(2]`'s `]` its
# `(`; and so does one that reads better as the innermost's closer written
# in the wrong kind, `[0.5, 0.7)` over the call's `)` (`closes_its_own`, the
# recovery instrument's `wrong-closer`). Inside an interpolation hole a
# closer is matched among the hole's own openers alone, the ones below being
# the string's outside it.
#
# | entry | called by |
# |---|---|
# | `before`, `opener_of` | `scan.finish` |
# | `never_closed` | `close_to_its_kind`, `layout.close_brackets` |
# | `past_literal` | `loop_headers`, `bracket_reach` |
# | `said_of`, `run_of` | `unclosed_runs` |

use token
use diag
use state

# Before the token `kind` at `start` is emitted: a closer of another kind
# than the innermost closes the opener of its own kind where one is open
# below it (`close_to_its_kind`); a closer of the innermost's own kind, every
# one of a program that compiles, asks nothing more.
function before(@l: state.LexState, text: str, kind: token.TokenKind, start: i64)
    n = l.open_brackets.len()

    if n > 0 && (kind == .rparen || kind == .rbracket || kind == .rbrace) && text[l.open_brackets[n - 1].start] != opener_of(kind)
        close_to_its_kind(@l, text, kind, start: start)

# Before the closer `kind` at `start` closes the innermost opener: where that
# opener is of another kind and one of its own is open below it, inside the
# innermost hole, the openers above that one are named never closed and
# taken off the stack, so the closer closes its own.
function close_to_its_kind(@l: state.LexState, text: str, kind: token.TokenKind, start: i64)
    n = l.open_brackets.len()
    want = opener_of(kind)

    if n == 0 || text[l.open_brackets[n - 1].start] == want
        return
    floor: i64 @ 0

    if l.holes.len() > 0
        floor @ l.holes[l.holes.len() - 1]
    at: i64 @ n - 2

    while at >= floor && text[l.open_brackets[at].start] != want
        at @ at - 1

    if at < floor || !closes_its_own(text, brackets: l.open_brackets, at: at, from: start + 1)
        return

    for span in l.open_brackets.slice(from: at + 1, to: n)
        state.push_diagnostic(@l.diagnostics, never_closed(text, span))

    l.open_brackets @ l.open_brackets.slice(from: 0, to: at + 1)
    state.push_offset(@l.closes, at: start)

# Whether the closer before `from` reads better as the closer of the opener
# of its own kind at `at` in `brackets`, the ones above it left without
# theirs, than as the innermost's closer written in the wrong kind: over the
# rest of its line, and each line after it that begins with a closer, the
# stack that reading leaves holds fewer openers and meets fewer closers it
# cannot pair. `run(words: ["a", "b"` over `)` over a statement leaves the
# wrong-kind reading the call's `(` open; `[0.5, 0.7)` over a `)` leaves the
# own-kind reading that `)` to pair with nothing. A tie keeps the innermost's.
function closes_its_own(text: str, brackets: [token.Span], at: i64, from: i64) -> bool
    own: [u8] @ []
    wrong: [u8] @ []

    for k in range(from: 0, to: brackets.len() - 1)
        if k < at
            own @ own.push(text[brackets[k].start])
        wrong @ wrong.push(text[brackets[k].start])

    strays: i64 @ 0
    i: i64 @ from

    while i < text.len()
        b = text[i]

        if b == '\n'
            j: i64 @ i + 1

            while j < text.len() && (text[j] == ' ' || text[j] == '\t')
                j @ j + 1

            if j >= text.len() || text[j] != ')' && text[j] != ']' && text[j] != '}'
                return own.len() < wrong.len() + strays
            i @ j
        else if b == '#'
            while i < text.len() && text[i] != '\n'
                i @ i + 1
        else if b == '"' || b == '\''
            i @ past_literal(text, from: i)
        else if b == '(' || b == '[' || b == '{'
            own @ own.push(b)
            wrong @ wrong.push(b)
            i @ i + 1
        else if b == ')' || b == ']' || b == '}'
            strays @ strays + popped(@wrong, closer: b) - popped(@own, closer: b)
            i @ i + 1
        else
            i @ i + 1

    return own.len() < wrong.len() + strays

# The top of `stack` taken for `closer`: 0 where it is the closer's own
# opener, 1 where it is another or none is open, a closer paired with nothing.
function popped(@stack: [u8], closer: u8) -> i64
    if stack.len() == 0
        return 1
    top = stack[stack.len() - 1]
    stack @ stack.slice(from: 0, to: stack.len() - 1)

    if top == '(' && closer == ')' || top == '[' && closer == ']' || top == '{' && closer == '}'
        return 0
    return 1

# Past the string or character literal that opens at `from`, on its line.
function past_literal(text: str, from: i64) -> i64
    quote = text[from]
    i: i64 @ from + 1

    while i < text.len() && text[i] != '\n'
        if text[i] == '\\'
            i @ i + 2
        else if text[i] == quote
            return i + 1
        else
            i @ i + 1

    return i

# The byte of the opener the closer `kind` closes.
function opener_of(kind: token.TokenKind) -> u8
    if kind == .rparen
        return '('

    if kind == .rbracket
        return '['
    return '{'

# The report of the opener at `span`, never closed: at the file's end, and
# at a closer that closes what the opener stands in (`close_to_its_kind`, a
# body's `}`), past which no closer can be its own.
function never_closed(text: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "unclosed_bracket", message: opened(text, span) + "is never closed", span: span)

# The report of the opener at `span`, still open at the line `line`, whose
# first word `word` ended its reach (`bracket_reach.end_the_reach`): a word no
# bracket can hold there (panel 183 R1), or, where `name`, a name after a
# line that kept its end inside a `(` (R2); or, where `header`, where C's
# `for` header it stands in is over, the header's `(` or a bracket it holds
# (defects 302 and 366). Not *never closed*: nothing closed what the opener
# stands in, and a closer further down may be the one the author wrote for
# it, a statement inside the bracket (R3, the author's route (b),
# 2026-10-01).
function still_open(text: str, span: token.Span, line: i64, word: str, name: bool, header: bool) -> diag.Diagnostic
    why: str @ "`" + word + "` begins a line no bracket can hold"

    if header
        why @ "C's `for` header it stands in is over"
    else if name
        why @ "the name `" + word + "` begins a line after one that ended without a `,`"
    return diag.new_diagnostic(
        code: "unclosed_bracket",
        message: opened(text, span) + "is still open at line " + line.to_str() + ", where " + why,
        span: span
    )

# How a report of an opener left open begins: the opener, and that it stands
# where the caret is.
function opened(text: str, span: token.Span) -> str
    return "`" + text.slice(from: span.start, to: span.end) + "` opened here "

# What a report of one opener left open, `never_closed`'s or `still_open`'s,
# says of it, "never closed" or "still open at line 4, where ...", or nothing
# for any other report.
function said_of(report: diag.Diagnostic, text: str) -> str
    if report.code != "unclosed_bracket" || report.fixes.len() > 0 || report.notes.len() > 0 || report.span.end != report.span.start + 1
        return ""
    head = opened(text, report.span) + "is "
    whole = report.message

    if whole.len() <= head.len() || whole.slice(from: 0, to: head.len()) != head
        return ""
    return whole.slice(from: head.len(), to: whole.len())

# The report of `first`, an opener left open, told for it and the `more`
# openers after it on its line the lexer named at the same place in the same
# words (`unclosed_runs`, defect 410): at the first, saying how many.
function run_of(first: diag.Diagnostic, text: str, more: i64) -> diag.Diagnostic
    told: diag.Diagnostic @ first
    told.message @ opened(text, first.span) + "and " + more.to_str() + " more after it on its line are " + said_of(first, text)
    return told

## Tests

test "a closer of another kind closes the opener of its own kind below, and names the ones above"
    text = "f(a, [b, c)"
    l: state.LexState @ state.new_state()
    l.open_brackets @ [token.Span(start: 1, end: 2), token.Span(start: 5, end: 6)]
    close_to_its_kind(@l, text, .rparen, start: 10)
    assert l.open_brackets.len() == 1
    assert l.diagnostics.len() == 1
    assert l.diagnostics[0].code == "unclosed_bracket"
    assert l.diagnostics[0].span.start == 5
    assert l.closes == [10]

    # `[0.5, 0.7)` over the call's `)`: the `)` is the `[`'s, written in the
    # wrong kind, since the line below closes the call.
    typo = "f(a, [b, c)\n)\n"
    t: state.LexState @ state.new_state()
    t.open_brackets @ [token.Span(start: 1, end: 2), token.Span(start: 5, end: 6)]
    close_to_its_kind(@t, typo, .rparen, start: 10)
    assert t.open_brackets.len() == 2
    assert t.diagnostics.len() == 0

    # `print(2]`: no `[` is open, so the `]` closes the `(` as the innermost.
    stray: state.LexState @ state.new_state()
    stray.open_brackets @ [token.Span(start: 5, end: 6)]
    close_to_its_kind(@stray, "print(2]", .rbracket, start: 7)
    assert stray.open_brackets.len() == 1
    assert stray.diagnostics.len() == 0

    # Inside a hole, the openers below the hole's are the string's outside it.
    hole: state.LexState @ state.new_state()
    hole.open_brackets @ [token.Span(start: 0, end: 1), token.Span(start: 5, end: 6)]
    hole.holes @ [1]
    close_to_its_kind(@hole, "(f\"${[x)}\"", .rparen, start: 7)
    assert hole.open_brackets.len() == 2
    assert hole.diagnostics.len() == 0
