# What the next line holds, read from its text before it is lexed (design.md
# §4.15; panel 181).
#
# `open_line` decides at a line break, and some of what it decides rests on
# the line below, which the lexer has not reached: whether it binds, whether
# it could stand alone as a statement, whether it holds an arm's `=>`. These
# are the scans that answer, and they read the text and nothing else, which
# is the seam: no lexer state, no tokens.
#
# **None of them decides whether a program compiles.** Each answer picks a
# diagnostic, a fix's certainty, or whether a `-` is an arm's sign, and
# every branch it picks refuses the program or leaves it as the parser reads
# it. That is what makes a scan a quote could fool acceptable here, and each
# one answers the cautious way on a doubt: a `guess` rather than a `certain`
# fix, an interpolated literal read as a line that may stand alone.

use token
use keywords
use bytes

# Does the line from `from` bind or mutate: a lone `=` or an `@` outside
# brackets?
function holds_a_binding(text: str, from: i64) -> bool
    depth: i64 @ 0
    i: i64 @ from
    quote: u8 @ 0

    while i < text.len() && text[i] != '\n'
        b = text[i]

        if quote != 0
            if b == '\\'
                i @ i + 1
            else if b == quote
                quote @ 0
        else if b == '#'
            return false
        else if b == '"' || b == '\''
            quote @ b
        else if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if (b == ')' || b == ']' || b == '}') && depth > 0
            depth @ depth - 1
        else if depth == 0 && (b == '@' || b == '=' && lone_eq(text, at: i))
            return true
        i @ i + 1

    return false

# Does the line from `from` hold an arm's `=>` outside brackets?
function holds_an_arrow(text: str, from: i64) -> bool
    depth: i64 @ 0
    i: i64 @ from
    quote: u8 @ 0

    while i + 1 < text.len() && text[i] != '\n'
        b = text[i]

        if quote != 0
            if b == '\\'
                i @ i + 1
            else if b == quote
                quote @ 0
        else if b == '#'
            return false
        else if b == '"' || b == '\''
            quote @ b
        else if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if (b == ')' || b == ']' || b == '}') && depth > 0
            depth @ depth - 1
        else if depth == 0 && b == '=' && text[i + 1] == '>'
            return true
        i @ i + 1

    return false

# Could the line from `from`, read alone, be a statement of its own: a call,
# a control form, a binding, a hole? Then the join may be the wrong repair.
# Yes on any doubt, an interpolated literal included, whose holes hold quotes
# this scan cannot follow.
function stands_alone(text: str, from: i64) -> bool
    first = keywords.keyword(word_at(text, at: from))

    if !first.is_err() && (first.must() == .kw_if || first.must() == .kw_match)
        return true
    depth: i64 @ 0
    i: i64 @ from
    quote: u8 @ 0
    last: u8 @ 0
    called: bool @ false

    while i < text.len() && text[i] != '\n' && (quote != 0 || text[i] != '#')
        b = text[i]

        if quote != 0
            if b == '\\'
                i @ i + 1
            else if b == quote
                quote @ 0
        else if b == 'f' && i + 1 < text.len() && text[i + 1] == '"'
            return true
        else if b == '"' || b == '\''
            quote @ b
        else if b == '('
            if depth == 0
                called @ last != 0 && (bytes.is_alnum(last) || last == '_' || last == ')' || last == ']' || last == '?')
            depth @ depth + 1
        else if b == '[' || b == '{'
            depth @ depth + 1
        else if (b == ')' || b == ']' || b == '}') && depth > 0
            depth @ depth - 1
        else if depth == 0 && (b == '@' || b == '=' && lone_eq(text, at: i))
            return true

        if b != ' ' && b != '\r'
            last @ b
        i @ i + 1

    return quote != 0 || (last == ')' || last == '?') && called || only_a_hole(text.slice(from: from, to: i))

# `???` and nothing else but spaces.
function only_a_hole(line: str) -> bool
    start: i64 @ 0
    end: i64 @ line.len()

    while start < end && line[start] == ' '
        start @ start + 1

    while end > start && (line[end - 1] == ' ' || line[end - 1] == '\r')
        end @ end - 1

    return line.slice(from: start, to: end) == "???"

# `=` alone, not a byte of `==`, `!=`, `<=`, `>=` or `=>`.
function lone_eq(text: str, at: i64) -> bool
    before: u8 @ 0

    if at > 0
        before @ text[at - 1]
    after: u8 @ 0

    if at + 1 < text.len()
        after @ text[at + 1]
    return before != '=' && before != '!' && before != '<' && before != '>' && after != '=' && after != '>'

function word_at(text: str, at: i64) -> str
    end: i64 @ at

    while end < text.len() && (bytes.is_alnum(text[end]) || text[end] == '_')
        end @ end + 1

    return text.slice(from: at, to: end)

# A word that begins a declaration or a statement and can continue nothing:
# a line that begins with one is never the rest of the line above it.
function starts_afresh(kind: token.TokenKind) -> bool
    return match kind
        .kw_constant | .kw_function | .kw_record | .kw_variant | .kw_test | .kw_extern | .kw_use => true
        .kw_return | .kw_break | .kw_continue | .kw_assert | .kw_for | .kw_while | .kw_else      => true
        .kw_match | .kw_if | .kw_in | .kw_nullptr | .kw_true | .kw_false | .kw_fail              => false
        .ident | .int_lit | .float_lit | .str_lit | .str_piece | .char_lit                       => false
        .eq | .at | .colon | .colon_colon | .comma | .dot | .arrow | .fat_arrow | .pipe          => false
        .hole | .question | .lparen | .rparen | .lbracket | .rbracket | .lbrace | .rbrace        => false
        .plus | .minus | .star | .slash | .percent                                               => false
        .eq_eq | .bang_eq | .lt | .le | .gt | .ge                                                => false
        .and_and | .or_or | .bang | .amp | .caret | .tilde | .shl | .shr                         => false
        .comment | .terminator | .indent | .dedent | .eof | .error                               => false

test "the next line may stand alone when it calls, binds, holds a control form or a hole"
    assert stands_alone("show(n: a)\n", from: 0)
    assert stands_alone("xs.len()\n", from: 0)
    assert stands_alone("show (n: a)  # note\n", from: 0)
    assert stands_alone("f(x)?\n", from: 0)
    assert stands_alone("if c\n", from: 0)
    assert stands_alone("x = 1\n", from: 0)
    assert stands_alone("???\n", from: 0)
    assert stands_alone("f\"{a}\"\n", from: 0)
    assert !stands_alone("1\n", from: 0)
    assert !stands_alone("b && c\n", from: 0)
    assert !stands_alone("(1 + 2)\n", from: 0)
    assert !stands_alone("x == \")\"\n", from: 0)
    assert !stands_alone("5  # (a note)\n", from: 0)

test "an arm's arrow is found outside brackets and strings only"
    assert holds_an_arrow("- 1 => \"one\"\n", from: 0)
    assert !holds_an_arrow("- f(a => b)\n", from: 0)
    assert !holds_an_arrow("- \"=>\"\n", from: 0)
    assert !holds_an_arrow("- fee  # => note\n", from: 0)
