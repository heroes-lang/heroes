# A string in backticks, JavaScript's template literal among them, read to
# its close (defect 391, design.md §4.17: one mistake, one message), on its
# line or over several (defect 407). Split from `refused_stretch.hero`, which
# tells the stretches the scanner refuses, along the seam between reading
# another language's string and telling a run of characters; how one is told,
# and the literal that writes it, are `backtick_told.hero`'s.
#
# A backtick opening a string is read to its close as JavaScript reads one, a
# hole's code holding its own braces, strings and templates.
#
# **A template is read only where this language's own reading agrees on its
# close**: a `"` in its text opening a string that runs past the closing
# backtick or past its own line, a `#` after a space or at a line's start
# beginning a comment, or the closing backtick written as a character,
# `'`'`, leaves the backtick alone, as a stray one before a comment quoting
# code `` `x` `` must be; and two backticks with nothing between are no
# template, so a line of 4,000 is one run (`refused_stretch`), where reading
# each pair as an empty string told 2,000.
#
# **Over lines it is read only where the lines it holds are no program's**
# (defect 407): no line in it opens a declaration at column 0
# (`next_line.opens_a_declaration`), and the line it closes on goes on as
# JavaScript reads one, every backtick after its close opening a template
# that closes on that line. So a stray backtick, or one never closed, does
# not take the lines below it to the next backtick it meets, which opens a
# template of its own: `` x = `oops `` above `` print(`y`) `` stays two
# messages, each true, where one template would take the line between and
# leave `` `) `` behind it. In a hole of an `f"…"` literal (`hole`) the line
# goes on as that literal, whose text no reading here follows, so there no
# backtick may stand after the close. The lexer reads a line at a time, and
# no state carries a template from one line to the next: one read over lines
# moves the cursor past them, as a block comment `/* … */` over lines does
# (`comment_habit.comment_end`), their margins its text, and a hole open on
# the line it opens on stays open on the line it closes on.
#
# **A backtick its line leaves open holds the rest of its line** (defect
# 414): where JavaScript's reading of its line closes nothing it opens, what
# follows it on that line is its string's, as what follows a `"` its line
# does not close is that string's (`unterminated_string`), so a `${` in it,
# a run of characters and a quote are no messages of their own. It ends
# before a comment begun after a space, and before the first closer that
# closes nothing opened after the backtick, which is the line's: the `)` of
# `` print(`a ${x}) ``, the `}` closing a hole of an `f"…"` literal it stands
# in (`open_end`). One closed on its line in a way this language reads
# otherwise, or with nothing after it, stays the scanner's alone.
#
# **Its cost stays linear**: a template is read for `READ` bytes from its
# backtick and no further, the rest of the line it closes on included, a
# falsifiable claim that one written in a program is shorter, past which the
# backtick is told alone, as the scanner told it before; read to the line's
# end from every backtick, a line of 10,000 `` `${ `` retired 447 billion
# instructions to `check`, where the base retired 188.
#
# | entry | called by |
# |---|---|
# | `template_close` | `refused_stretch.told`, `refused_stretch.refused_and_seen` |
# | `open_end` | `refused_stretch.told` |
# | `is_template` | `refused_runs.gathered` |
# | `quote_end`, `line_end`, `TEMPLATE_SAID`, `BACKTICKS_SAID` | `backtick_told` |

use diag
use bytes
use literals
use next_line

# How a template's message goes on from its quoted text, the one place both
# are written and read (`backtick_told.template`, `is_template`).
constant TEMPLATE_SAID: str
    " is JavaScript's template literal, and backticks are not part of the language's syntax"

constant BACKTICKS_SAID: str
    " is a string in backticks, which are not part of the language's syntax"

# How far from its backtick a template is read for its close, in bytes.
constant READ: i64
    512

# Past the backtick closing a template that opens at `at`, where it holds
# something and both readings agree on its close, or -1. One that closes on a
# line below its own is read only where `over_lines` holds, `hole` saying
# whether it opens in a hole of an `f"…"` literal.
function template_close(text: str, at: i64, hole: bool) -> i64
    if text[at] != '`'
        return -1
    limit = bound(text, at: at)
    close = template_end(text, at: at, limit: limit)

    if close <= at + 2 || !agreed(text, from: at + 1, to: close - 1)
        return -1

    if !spans_lines(text, from: at, to: close)
        return close

    if !over_lines(text, from: at, to: close, limit: limit, hole: hole)
        return -1
    return close

# Whether `d` tells a template, as `backtick_told.template` writes one.
function is_template(d: diag.Diagnostic) -> bool
    if d.code != "unexpected_character"
        return false
    return !bytes.rfind(text: d.message, needle: TEMPLATE_SAID).is_err() || !bytes.rfind(text: d.message, needle: BACKTICKS_SAID).is_err()

# Where the reading of a template from `at` stops: `READ` bytes on, or the
# text's end.
function bound(text: str, at: i64) -> i64
    if at + READ > text.len()
        return text.len()
    return at + READ

# Past the backtick that closes the one opening at `at`, read as JavaScript
# reads a template, or -1 where `limit` comes first: in its text a `\` takes
# the character after it and `${` opens a hole; in a hole's code a `{` opens
# and a `}` closes, the last closing the hole, a `"` or a `'` opens a string
# to its own quote on its line, and a backtick a template of its own. A line
# end is text, and space in a hole's code. `top` is where the reading stands,
# 0 in a template's text and the braces open plus one in a hole's code, and
# `open` what encloses it, innermost last, so that a byte read asks a local
# and not the array: read over lines, a template is read for up to `READ`
# bytes from every backtick that opens none.
function template_end(text: str, at: i64, limit: i64) -> i64
    open: [i64] @= []
    top: i64 @= 0
    i: i64 @= at + 1

    while i < limit
        b = text[i]

        if top == 0 && b == '\\'
            i @ i + 2
        else if top == 0 && b == '`'
            if open.len() == 0
                return i + 1
            top @ open[open.len() - 1]
            open @ open.slice(from: 0, to: open.len() - 1)
            i @ i + 1
        else if top == 0 && b == '$' && i + 1 < text.len() && text[i + 1] == '{'
            open @ open.push(0)
            top @ 1
            i @ i + 2
        else if top == 0
            i @ i + 1
        else if b == '{'
            top @ top + 1
            i @ i + 1
        else if b == '}' && top == 1
            top @ open[open.len() - 1]
            open @ open.slice(from: 0, to: open.len() - 1)
            i @ i + 1
        else if b == '}'
            top @ top - 1
            i @ i + 1
        else if b == '`'
            open @ open.push(top)
            top @ 0
            i @ i + 1
        else if b == '"' || b == '\''
            i @ quote_end(text, at: i, limit: limit)

            if i < 0
                return -1
        else
            i @ i + 1

    return -1

# Past the quote closing the string opening at `at` on its line, before
# `limit`, a `\` taking the character after it, or -1.
function quote_end(text: str, at: i64, limit: i64) -> i64
    quote = text[at]
    i: i64 @= at + 1

    while i < limit && i < text.len() && !literals.ends_line(text, at: i)
        if text[i] == '\\'
            i @ i + 2
        else if text[i] == quote
            return i + 1
        else
            i @ i + 1

    return -1

# Whether this language reads the text between a template's backticks, from
# `from` up to the closing one at `to`, as ending where JavaScript does: no
# `"` in it opens a string running past `to` or its own line, no `#` after a
# space, a tab or a line end begins a comment, and the closing backtick is
# not a character, `'`'`. A `"` closing before `to` is a string both read.
function agreed(text: str, from: i64, to: i64) -> bool
    if text[to - 1] == '\'' && to + 1 < text.len() && text[to + 1] == '\''
        return false
    i: i64 @= from

    while i < to
        b = text[i]

        if b == '"'
            close = quote_end(text, at: i, limit: to)

            if close < 0
                return false
            i @ close
        else if b == '#' && i > from && (text[i - 1] == ' ' || text[i - 1] == '\t' || text[i - 1] == '\n')
            return false
        else
            i @ i + 1

    return true

# Whether a line end stands between `from` and `to`.
function spans_lines(text: str, from: i64, to: i64) -> bool
    i: i64 @= from

    while i < to
        if text[i] == '\n'
            return true
        i @ i + 1

    return false

# Whether a template over lines, from its backtick at `from` to past its close
# at `to`, holds no line a declaration opens at column 0, and the line it
# closes on goes on as JavaScript reads one (`goes_on`).
function over_lines(text: str, from: i64, to: i64, limit: i64, hole: bool) -> bool
    i: i64 @= from

    while i < to
        if text[i] == '\n' && next_line.opens_a_declaration(text, at: i + 1)
            return false
        i @ i + 1

    return goes_on(text, from: to, limit: limit, hole: hole)

# Whether the line a template closes on goes on from `from`, past its close,
# to its end or a comment before `limit`, as JavaScript reads it: a backtick
# opening a template that closes on the line, a `"` or a `'` a string that
# closes on it, and anything else as itself. In a hole of an `f"…"` literal
# it goes on as that literal, and holds no backtick to its end.
function goes_on(text: str, from: i64, limit: i64, hole: bool) -> bool
    i: i64 @= from

    while i < limit
        b = text[i]

        if literals.ends_line(text, at: i) || !hole && b == '#' && (text[i - 1] == ' ' || text[i - 1] == '\t')
            return true

        if b == '`' && hole
            return false

        if hole
            i @ i + 1
        else if b == '`'
            close = template_end(text, at: i, limit: limit)

            if close < 0 || spans_lines(text, from: i, to: close)
                return false
            i @ close
        else if b == '"' || b == '\''
            i @ quote_end(text, at: i, limit: limit)

            if i < 0
                return false
        else
            i @ i + 1

    return limit == text.len()

# Past the rest of the line after the backtick at `at` where JavaScript's
# reading of that line closes no template it opens: up to the line's end, a
# comment begun after a space, or the first closer that closes nothing
# opened after the backtick, the spaces before it left out; -1 where its
# line closes one, runs past `READ` bytes, or holds nothing after it. In a
# hole of an `f"…"` literal (`hole`) the line is that literal's text, which
# holds no comment.
function open_end(text: str, at: i64, hole: bool) -> i64
    if text[at] != '`'
        return -1
    line = line_end(text, from: at)

    if line > at + READ || template_end(text, at: at, limit: line) > 0
        return -1
    depth: i64 @= 0
    last: i64 @= at + 1
    i: i64 @= at + 1

    while i < line
        b = text[i]

        if !hole && b == '#' && (text[i - 1] == ' ' || text[i - 1] == '\t')
            break

        if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if b == ')' || b == ']' || b == '}'
            if depth == 0
                break
            depth @ depth - 1

        if b != ' ' && b != '\t'
            last @ i + 1
        i @ i + 1

    if last == at + 1
        return -1
    return last

# Where the line holding `from` ends, before its `\r\n` or its `\n`, or the
# text's end.
function line_end(text: str, from: i64) -> i64
    i: i64 @= from

    while i < text.len() && text[i] != '\n'
        i @ i + 1

    if i > from && text[i - 1] == '\r'
        return i - 1
    return i

## Tests

test "a backtick this language reads as a stray one opens no template"
    # No close, a comment after a space, a string past the close, nothing
    # between two, and a close written as a character.
    for text in ["` x", "` # see `x`", "` \"a`b\"", "``x", "` c = '`'"]
        assert template_close(text, at: 0, hole: false) == -1

    # A `#` with no space before it is the template's own.
    assert template_close("`#${id}`", at: 0, hole: false) == 8

test "a template over lines is read where its lines are no program's"
    assert template_close("`a\nb` + 1\n", at: 0, hole: false) == 5
    assert template_close("`a\r\n    b`)\n", at: 0, hole: false) == 10
    assert template_close("`a ${\n    x\n} b`\n", at: 0, hole: false) == 16

    # In a hole of an `f"…"` literal its line goes on as that literal, a
    # backtick after the close refused there.
    assert template_close("`a\nb`}\" # `\n", at: 0, hole: true) == -1
    assert template_close("`a\nb`}\" # \n", at: 0, hole: true) == 5
    assert template_close("`a\nb`}\" # \n", at: 0, hole: false) == -1

    # Not over a comment's line, a string's or a declaration's at column 0,
    # nor where the line it closes on leaves a backtick open.
    stray = [
        "`a\n# see `x`\n"
        "`a\n    # see `x`\n"
        "`a\ns = \"`\"\n"
        "`a\nfunction b()\n    `c\n"
        "`a\n    print(`y`)\n"
    ]

    for text in stray
        assert template_close(text, at: 0, hole: false) == -1

    # A template, a string and a comment on the line it closes on are read.
    assert template_close("`a\nb`, `c`, \"`\") # `\n", at: 0, hole: false) == 5

test "a backtick its line leaves open holds the rest of its line, to a comment or a closer of the line's"
    assert open_end("`a ${x}\nb", at: 0, hole: false) == 7
    assert open_end("`a ${x})\n", at: 0, hole: false) == 7
    assert open_end("`a ${x}  # c\r\n", at: 0, hole: false) == 7
    assert open_end("`a (b) ${x}", at: 0, hole: false) == 11

    # In a hole of an `f"…"` literal, to the brace that closes it, and a `#`
    # is that literal's text.
    assert open_end("`a ${x}}\")\n", at: 0, hole: true) == 7
    assert open_end("`a # c\n", at: 0, hole: true) == 6

    # Closed on its line, nothing after it, or past the bound: told alone.
    for text in ["`a` b\n", "` # `x`\n", "`\nb`\n", "`  # c\n", "`)\n", "x"]
        assert open_end(text, at: 0, hole: false) == -1

    assert open_end("`" + "a".repeat(READ.to_u64().must()) + "\n", at: 0, hole: false) == -1

test "a template is read for its bound and no further, the line it closes on included"
    inside = "`" + "a".repeat(READ.to_u64().must() - 2) + "`"
    assert template_close(inside, at: 0, hole: false) == READ
    past = "`" + "a".repeat(READ.to_u64().must() - 1) + "`"
    assert template_close(past, at: 0, hole: false) == -1
    cut = "`a\nb`" + " ".repeat(READ.to_u64().must()) + "x\n"
    assert template_close(cut, at: 0, hole: false) == -1
