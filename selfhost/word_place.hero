# Where a word stands in a text, read from the text alone (design.md §4.17;
# defect 133, 2026-09-29).
#
# A foreign word's swap is `certain` only where the word it writes is right
# in that position (`foreign_at.hero`), and the lexer, which writes the fix,
# has the text and nothing else: no tree, and no token after the word. So the
# position is read the way defect 015 read the byte after the word, from the
# characters around it, one step further:
#
# - a word that OPENS its line stands at the margin (`top`), one level under
#   an `extern` group's head (`member`), or anywhere else a line begins
#   (`statement`: a body, a block of fields or cases);
# - in the middle of a line it stands where a name goes (`named`, right
#   after a declaration's keyword), where a type goes (`typed`: after `:`,
#   `->`, a type's `[` or `{`, or inside a function type's parameters),
#   where a parenthesised function type opens (`function_type`: the `(` of
#   `(fn(i64) -> i64)`), where a value goes (`valued`: after `=`, `@`, `=>`
#   or `return`), or anywhere else (`other`).
#
# A premise about the world, written as a claim so that it can fail: these
# positions are the language's own, spec § 5's productions read from their
# first characters, and a new production that puts a declaration's keyword,
# a type or a value somewhere else is a place this reading calls `other`,
# which only ever withholds a `certain` fix. That is the loud direction: a
# fix withheld costs a turn, a fix wrongly certain writes a broken program.
#
# Two answers reach past the word's own line, a bracket a line above left
# open and the nearest line at the margin, and those are read from the text's
# outline, read once for the whole text (`text_outline.hero`, defect 146):
# read by a walk for every word, a file of foreign heads cost its square.

use token
use bytes
use text_outline

## The places

variant Place
    top
    member
    statement
    named
    typed
    function_type
    valued
    other

# Where the word at `span` stands in `text`, whose outline `outline` holds
# or is read into, the first time a word that opens its line asks.
function place_of(text: str, span: token.Span, @outline: text_outline.Outline) -> Place
    begins = text_outline.line_start(@outline, text, at: span.start)

    if only_margin(text, from: begins, to: span.start)
        text_outline.read(@outline, text)

        # A line that begins inside a bracket left open above it goes on with
        # that bracket's list, and nothing heads it.
        if text_outline.inside(outline, at: begins)
            return .other
        margin = span.start - begins

        if margin == 0
            return .top

        if margin == 4 && under_a_group(text, outline, line: begins)
            return .member
        return .statement
    before = significant_before(text, at: span.start, floor: begins)
    ch = text[before]

    if bytes.is_alnum(ch) || ch == '_'
        word = word_ending(text, at: before + 1)

        if is_declaring(word)
            return .named

        if word == "return"
            return .valued
        return .other

    if ch == ':' && !(before > 0 && text[before - 1] == ':')
        return .typed

    if ch == '>' && before > 0 && text[before - 1] == '-'
        return .typed

    if ch == '>' && before > 0 && text[before - 1] == '='
        return .valued

    if ch == '=' || ch == '@'
        return .valued

    if ch == '[' || ch == '{'
        return type_bracket(text, at: before, floor: begins)

    if ch == '('
        return after_paren(text, at: before, floor: begins)

    if ch == ','
        return after_comma(text, at: before, floor: begins)
    return .other

## Reading the text

# The offset where the line holding `at` begins.
function line_start(text: str, at: i64) -> i64
    i: i64 @= at

    while i > 0 && text[i - 1] != '\n'
        i @ i - 1

    return i

function only_margin(text: str, from: i64, to: i64) -> bool
    i: i64 @= from

    while i < to
        if text[i] != ' ' && text[i] != '\t'
            return false
        i @ i + 1

    return true

# The last character before `at` on its line that is not a space, or `floor`
# minus one where there is none.
function significant_before(text: str, at: i64, floor: i64) -> i64
    i: i64 @= at - 1

    while i >= floor && (text[i] == ' ' || text[i] == '\t')
        i @ i - 1

    return i

# The identifier that ends just before `at`.
function word_ending(text: str, at: i64) -> str
    i: i64 @= at

    while i > 0 && (bytes.is_alnum(text[i - 1]) || text[i - 1] == '_')
        i @ i - 1

    return text.slice(from: i, to: at)

# A word after which a name is written: a declaration's keyword, the
# language's or the foreign one it was mistaken for.
function is_declaring(word: str) -> bool
    for one in ["function", "record", "variant", "constant", "use", "fn", "func", "def", "struct", "enum", "union", "const", "class", "import", "include"]
        if word == one
            return true

    return false

# A `[` or `{` is a type's when what stands before it is not a value it
# could index or a statement it could open: `[i64]` after `:`, never
# `xs[i]`.
function type_bracket(text: str, at: i64, floor: i64) -> Place
    before = significant_before(text, at: at, floor: floor)

    if before < floor
        return .other
    ch = text[before]

    if ch == ':' || ch == '[' || ch == '(' || ch == ',' || ch == '>' && before > 0 && text[before - 1] == '-'
        return .typed
    return .other

# After a `(`: the opening of a parenthesised function type where a type
# goes, a function type's own parameter list after `function`, or a call's
# or a signature's list.
function after_paren(text: str, at: i64, floor: i64) -> Place
    before = significant_before(text, at: at, floor: floor)

    if before < floor
        return .other
    ch = text[before]

    if bytes.is_alnum(ch) || ch == '_'
        if names_a_function_type(word_ending(text, at: before + 1))
            return .typed
        return .other

    if ch == ':' || ch == '[' || ch == '(' || ch == ',' || ch == '>' && before > 0 && text[before - 1] == '-'
        return .function_type
    return .other

# After a `,`: inside a function type's parameter list, a type's place.
function after_comma(text: str, at: i64, floor: i64) -> Place
    depth: i64 @= 0
    i: i64 @= at - 1

    while i >= floor
        ch = text[i]

        if ch == ')' || ch == ']' || ch == '}'
            depth @ depth + 1
        else if ch == '(' || ch == '[' || ch == '{'
            if depth == 0
                return after_paren(text, at: i, floor: floor)
            depth @ depth - 1
        i @ i - 1

    return .other

function names_a_function_type(word: str) -> bool
    return word == "function" || word == "fn" || word == "func" || word == "def"

# Whether the line at `line` is one level under an `extern` group's head:
# the nearest line above it that opens at the margin, past blank lines and
# comments, begins with `extern`.
function under_a_group(text: str, outline: text_outline.Outline, line: i64) -> bool
    top = text_outline.top_above(outline, line: line)
    return top >= 0 && text.slice(from: top, to: word_end(text, from: top)) == "extern"

# Whether the word at `span` stands inside an `extern` group, at any depth
# under its head: its line does not open at the margin, and the nearest line
# above it that does begins with `extern`. A group names C's own types, so a
# type written there is the header's (spec § 13; defect 135's L6). The
# outline is read here once for the text, as for a word that opens its line.
function in_a_group(text: str, span: token.Span, @outline: text_outline.Outline) -> bool
    begins = line_start(text, at: span.start)

    if begins < text.len() && text[begins] != ' ' && text[begins] != '\t'
        return false
    text_outline.read(@outline, text)
    return under_a_group(text, outline, line: begins)

# Whether the word at `span`, where a type goes in an `extern` group, types
# a value that may be wider than the header's (spec § 13; defect 172): a
# constant's, on a line that opens with `constant` or the `const` a swap
# writes as it; or a member's result, after `->`. A function type's result
# is never one, being the header's own, and it is told apart by the `)` that
# closes the type after it, which a member's result never has: a claim about
# the productions of § 4 and § 13, falsified by a production that puts a
# member's result before a `)`, and the test below is its witness.
function may_be_wider(text: str, span: token.Span) -> bool
    begins = line_start(text, at: span.start)
    first = first_mark(text, from: begins)
    opener = text.slice(from: first, to: word_end(text, from: first))

    if opener == "constant" || opener == "const"
        return true
    before = significant_before(text, at: span.start, floor: begins)

    if before <= begins || text[before] != '>' || text[before - 1] != '-'
        return false
    after: i64 @= span.end

    while after < text.len() && text[after] == ' '
        after @ after + 1

    return after >= text.len() || text[after] != ')'

# The first character on the line at `from` that is not a space or a tab.
function first_mark(text: str, from: i64) -> i64
    i: i64 @= from

    while i < text.len() && (text[i] == ' ' || text[i] == '\t')
        i @ i + 1

    return i

function word_end(text: str, from: i64) -> i64
    i: i64 @= from

    while i < text.len() && (bytes.is_alnum(text[i]) || text[i] == '_')
        i @ i + 1

    return i

# The offset of the quote that closes the one at `from`, or of the line's
# end where none does: a string never runs past its line.
function past_quoted(text: str, from: i64, quote: u8, limit: i64) -> i64
    i: i64 @= from + 1

    while i < limit && text[i] != quote && text[i] != '\n'
        if text[i] == '\\'
            i @ i + 1
        i @ i + 1

    return i

## Tests

function at_word(text: str, word: str) -> token.Span
    i: i64 @= 0

    while i + word.len() <= text.len()
        if bytes.bytes_at(text: text, at: i, needle: word) && (i == 0 || !bytes.is_alnum(text[i - 1]))
            return token.Span(start: i, end: i + word.len())
        i @ i + 1

    return token.Span(start: 0, end: 0)

# Where `word`, its first whole occurrence, stands in `text`, the text's
# outline read for the one question.
function place_in(text: str, word: str) -> Place
    outline: text_outline.Outline @= text_outline.unread()
    return place_of(text, at_word(text: text, word: word), @outline)

test "a word that opens its line stands at the margin, in a group or in a block"
    assert place_in(text: "fn main()\n", word: "fn") == .top
    group = "extern \"m.h\"\n    fn q() -> f64\n"
    assert place_in(text: group, word: "fn") == .member
    body = "function main()\n    const x = 5\n"
    assert place_in(text: body, word: "const") == .statement
    fields = "extern \"m.h\"\n    record P\n        struct Q\n"
    assert place_in(text: fields, word: "struct") == .statement

test "in the middle of a line a word stands where a name, a type or a value goes"
    named = "function fn(x: i64)\n"
    assert place_in(text: named, word: "fn") == .named
    assert place_in(text: "f(x: int)", word: "int") == .typed
    assert place_in(text: "f() -> int", word: "int") == .typed
    assert place_in(text: "f(xs: [int])", word: "int") == .typed
    assert place_in(text: "g: (fn(i64) -> i64)", word: "fn") == .function_type
    assert place_in(text: "g: fn(i64) -> i64", word: "fn") == .typed
    assert place_in(text: "(function(int, int) -> i64)", word: "int") == .typed
    assert place_in(text: "y = switch x", word: "switch") == .valued
    assert place_in(text: "return switch x", word: "switch") == .valued
    assert place_in(text: "print(int)", word: "int") == .other
    assert place_in(text: "record P fn", word: "fn") == .other

# Defect 172: where a group's value may be wider than the header's type.
test "a group's result and constant may be wider, and a function type's result may not"
    member = "extern \"m.h\"\n    function q(n: int) -> int\n"
    parameter = at_word(text: member, word: "int")
    result = token.Span(start: parameter.end + 5, end: parameter.end + 8)
    assert member.slice(from: result.start, to: result.end) == "int"
    assert may_be_wider(member, result)
    assert !may_be_wider(member, parameter)
    callback = "extern \"s.h\"\n    function on(f: (function(i32) -> int)) -> i64\n"
    assert !may_be_wider(callback, at_word(text: callback, word: "int"))
    valued = "extern \"m.h\"\n    constant LIMIT: int\n"
    assert may_be_wider(valued, at_word(text: valued, word: "int"))
    field = "extern \"m.h\"\n    record P\n        x: int\n"
    assert !may_be_wider(field, at_word(text: field, word: "int"))

test "a line inside an open bracket heads nothing"
    params = "function f(x: i64\nfn g()\n"
    assert place_in(text: params, word: "fn") == .other
    shut = "function f(x: i64)\nfn g()\n"
    assert place_in(text: shut, word: "fn") == .top
    quoted = "x = \"(\"\nfn g()\n"
    assert place_in(text: quoted, word: "fn") == .top

# Defect 146: a word that opens its line takes what stands above it from the
# text's outline and from nothing else, so placing every word of a file reads
# the file once. Witnessed with two texts of one length that the outline
# tells apart and the word's own line does not: placed in the second with
# the first's outline, the word is where the first says, which a walk over
# the second text would have contradicted.
test "a word's place takes the lines above it from the outline alone"
    shut = "f(x)\nfn g()\n"
    open = "f(x \nfn g()\n"
    at = at_word(text: open, word: "fn")
    read_shut: text_outline.Outline @= text_outline.unread()
    text_outline.read(@read_shut, shut)
    assert place_of(open, at, @read_shut) == .top
    read_open: text_outline.Outline @= text_outline.unread()
    assert place_of(open, at, @read_open) == .other

    # The nearest line at the margin, which says whether a word one level in
    # is a group's member, comes from the outline too: here a line between
    # stands at the margin in one text and one level in in the other.
    group = "extern \"m.h\"\n    fn p()\n    fn q()\n"
    other = "extern \"m.h\"\nfn     p()\n    fn q()\n"
    member = at_word(text: other, word: "fn q")
    read_group: text_outline.Outline @= text_outline.unread()
    text_outline.read(@read_group, group)
    assert place_of(other, token.Span(start: member.start, end: member.start + 2), @read_group) == .member
    read_other: text_outline.Outline @= text_outline.unread()
    assert place_of(other, token.Span(start: member.start, end: member.start + 2), @read_other) == .statement

# Defect 452's case: the helper finds a word past characters above ASCII,
# asking each offset of its bytes where it sliced the text at every byte.
test "a word is found past characters above ASCII (defect 452)"
    found = at_word(text: "é€ fn x", word: "fn")
    assert found.start == 6
    assert found.end == 8
    absent = at_word(text: "é€😀", word: "fn")
    assert absent.start == 0 && absent.end == 0
