# heroes check --dump-scopes: what the resolver decided, seen
# (design.md §3.5, §4.4). Port of crates/heroes/src/printer/scopes.rs.
#
# A pass whose output nobody can look at is a pass nobody can debug.
# Two things the resolver knows that no earlier stage did: the
# top-level table, SORTED (declaration order carries no meaning, §4.2,
# and here that stops being a claim), and every binding nested by
# scope with its read and write counts — the indentation IS the scope
# structure, so §4.4's unused rule becomes readable: the bindings with
# reads 0 are exactly the ones a hole-free file would be rejected for.
# Output surface, like every other dump.

use ast
use source
use resolved
use parse
use resolve

# The library is part of every compilation and part of no dump: a
# --dump-<stage> answers "what does the compiler know about THE FILE I
# NAMED" (CLAUDE.md §10).
function dump_scopes(r: resolved.Resolved, s: source.Source, decls: [ast.Decl]) -> str
    out: str @ "file " + s.name + "\n"
    here = source.module_at(s, 0)
    out @ out + "module " + here + "\n"
    # What this file may write qualified, and what each module offers
    # it — the half of the question the symbol table cannot show,
    # because those names are not in it.
    #
    # ORDER: ascending module name, then `names_in`'s own sort — the
    # `uses` block of --dump-scopes prints in exactly this order, so a
    # golden reads it (design.md §4.9, paid here with one sort).
    named = r.module_uses[here]
    if !named.is_err() && named.must().len() > 0
        out @ out + "uses\n"
        for module in sort(named.must())
            out @ out + "  " + module + "\n"
            for name in resolved.names_in(r, module: module)
                decl = resolved.top_in(r, module: module, name: name)
                if decl.is_err()
                    continue
                # locate, not line_col: the second is the line in the
                # concatenated text, which is a real file and a line
                # nobody can find in it.
                found = source.locate(s, decls[decl.must()].name.start)
                out @ out + "    " + entity(decls, decl: decl.must()) + " " + module + "." + name + " (" + found.file + ":" + found.line.to_str() + ")\n"
    out @ out + "symbols\n"
    for name in resolved.names_in(r, module: here)
        decl = resolved.top_in(r, module: here, name: name)
        if decl.is_err()
            continue
        if !source.is_root(s, decls[decl.must()].name.start)
            continue
        line = source.line_of(s, decls[decl.must()].name.start)
        out @ out + "  " + entity(decls, decl: decl.must()) + " " + name + " (line " + line.to_str() + ")\n"
    out @ out + "scopes\n"
    index: i64 @ 0
    for decl in decls
        if !source.is_root(s, decl.name.start)
            index @ index + 1
            continue
        section: str @ ""
        for local in r.locals
            if local.owner != index
                continue
            # Two spaces per scope, like every other dump here.
            indent = "  ".repeat((1 + local.depth).to_u64().must())
            marker: str @ ""
            if local.mutable
                marker @ " @"
            section @ section + "  " + indent + kind_word(local.kind) + " " + source.span_text(s, local.name) + marker + " (reads " + local.reads.to_str() + ", writes " + local.writes.to_str() + ")\n"
        if section.len() > 0
            out @ out + "  " + entity(decls, decl: index) + " " + source.span_text(s, decl.name) + "\n" + section
        index @ index + 1
    # Named rather than counted: the suppression is file-wide (§4.16),
    # so "holes present" without saying where would describe a rule
    # the compiler no longer has.
    # ORDER: ascending module name — one trailer line per module, read
    # by a golden, so the sort is the golden's stability (§4.9).
    for module in sort(r.holes_in)
        out @ out + "holes in `" + module + "`: unused bindings are not reported there\n"
    return out

function entity(decls: [ast.Decl], decl: i64) -> str
    match decls[decl].kind
        # `extern constant`, never plain `constant`: the two are
        # different entities to a reader — one's value is in this file
        # and the other's is in a header — and this walk is the one
        # place the widened constant_decl could have said nothing.
        .constant_decl k =>
            if !k.header.is_err()
                return "extern constant"
            return "constant"
        .function_decl fd =>
            if fd.value.is_extern
                return "extern"
            return "function"
        .record_decl => return "record"
        .variant_decl => return "variant"
        .test_decl => return "test"
    return "declaration"

function kind_word(kind: resolved.LocalKind) -> str
    return match kind
        .param => "param"
        .bind => "bind"
        .cell => "cell"
        .loop_var => "loop"
        .payload => "payload"

## Tests

test "the table is alphabetical, the indentation is the scope structure"
    text = "function zeta() -> i64\n    return 1\n\nfunction alpha(n: i64) -> i64\n    total: i64 @ 0\n    for k in range(from: 0, to: n)\n        total @ total + k\n    return total\n\nfunction main()\n    print(alpha(n: zeta()))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    got = dump_scopes(out, s, parsed.decls)
    expected = "file t.hero\nmodule t\nsymbols\n  function alpha (line 4)\n  function main (line 10)\n  function zeta (line 1)\nscopes\n  function alpha\n    param n (reads 1, writes 0)\n      cell total @ (reads 2, writes 1)\n        loop k (reads 1, writes 0)\n"
    assert got == expected
