# The same one-character slip, in three places the compiler has different
# authority over (design.md Part 11; `harness/mutations/operators.md`).
#
# Port of crates/heroes/src/mutate/edits_typo.rs. The three belong together
# because **the mutation is identical and only the target changes** — which is
# what turns them from three operators into one measurement:
#
# - an **identifier**: the resolver catches it, every time, with a `certain`
#   fix;
# - an error **code**: nothing catches it. §4.6 fixes the error's payload at
#   two `str`s and says to assert on the code, so the two ends of that contract
#   are a pair of string literals in different files, checked by nothing. This
#   is the one operator that points at no rule which kills it, and that is the
#   finding rather than an oversight;
# - a **constant's digit**: the site is narrow on purpose, and the narrowing is
#   a fact about the value rather than a premise about the program (CLAUDE.md
#   §11). A number inside an expression is a choice the program is making; a
#   `constant` exists to NAME a number, and where that number was copied from
#   somewhere else, the somewhere else is an authority the compiler could have
#   consulted and did not.

use ast
use source
use token
use mutate_sites

# THE ONE-CHARACTER SLIP ITSELF LIVES IN `mutate_sites`, with the text edit and
# the questions about one node, and the reason is the language rather than
# taste: `mutate-undeclared` needs the same slip, and Heroes refuses module
# cycles (`module_cycle` fires on the `use` edge, whatever it carries). Two
# modules that each need one function from the other cannot both exist, so the
# shared half is a module of its own that both use.

# **A one-character edit** in an identifier, wherever a bare name is read.
function typo_ident(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []

    for e in a.exprs
        if !mutate_sites.is_name(e)
            continue
        name = source.span_text(s, e.span)

        if name.len() < 3
            continue
        out @ out.push(mutate_sites.edit(s: s, span: e.span, replacement: mutate_sites.slipped(name)))

    return out

# The same slip inside an error **code**: `fail("unknown_char", …)`, and the
# `e.code == "unknown_char"` that reads it back.
function typo_code(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []

    for e in a.exprs
        literal = code_literal(a: a, s: s, e: e)

        if literal.is_err()
            continue
        span = a.exprs[literal.must()].span
        code = code_text(s: s, span: span)

        if code.is_err()
            continue
        out @ out.push(
            mutate_sites.edit(s: s, span: span, replacement: "\"" + mutate_sites.slipped(code.must()) + "\"")
        )

    return out

# Which expression holds a code literal: the first argument of a `fail` call,
# or the `str` side of an `e.code == "…"` comparison.
function code_literal(a: ast.Ast, s: source.Source, e: ast.Expr) -> i64?
    return match e.kind
        .call c =>
            if !is_written(a: a, s: s, id: c.callee, name: "fail") || c.args.len() == 0
                fail("no_code", "not a `fail` call")
            else
                ok(c.args[0].value)
        .binary b =>
            if is_equality(b.op)
                code_side(a: a, s: s, left: b.left, right: b.right)
            else
                fail("no_code", "not an equality")
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => fail("no_code", "a literal holds no code")
        .null_ptr | .name | .hole | .error                       => fail("no_code", "nothing to read here")
        .unary | .field | .index                                 => fail("no_code", "nothing to read here")
        .method | .variant_case                                  => fail("no_code", "nothing to read here")
        .array | .map | .try_expr | .if_expr | .match_expr       => fail("no_code", "nothing to read here")

function is_equality(op: ast.BinaryOp) -> bool
    return match op
        .eq | .ne                                   => true
        .add | .sub | .mul | .div | .rem            => false
        .lt | .le | .gt | .ge                       => false
        .and | .or                                  => false
        .bit_and | .bit_or | .bit_xor | .shl | .shr => false

# True when `id` is written as the bare name `name` — the only spelling a
# built-in call has, since none of them may be redeclared.
function is_written(a: ast.Ast, s: source.Source, id: i64, name: str) -> bool
    e = a.exprs[id]
    return mutate_sites.is_name(e) && source.span_text(s, e.span) == name

# The `str` side of `e.code == "…"`, whichever side it was written on.
function code_side(a: ast.Ast, s: source.Source, left: i64, right: i64) -> i64?
    if is_str(a.exprs[left]) && reads_code(a: a, s: s, id: right)
        return ok(left)

    if is_str(a.exprs[right]) && reads_code(a: a, s: s, id: left)
        return ok(right)
    return fail("no_code", "neither side is a code comparison")

function is_str(e: ast.Expr) -> bool
    return match e.kind
        .str_lit                                           => true
        .int_lit | .float_lit | .char_lit | .bool_lit      => false
        .null_ptr | .name | .hole | .error                 => false
        .unary | .binary | .field | .index                 => false
        .call | .method | .variant_case                    => false
        .array | .map | .try_expr | .if_expr | .match_expr => false

# Whether this expression is `<something>.code`.
function reads_code(a: ast.Ast, s: source.Source, id: i64) -> bool
    return match a.exprs[id].kind
        .field f                                                 => source.span_text(s, f.name) == "code"
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => false
        .null_ptr | .name | .hole | .error                       => false
        .unary | .binary | .index                                => false
        .call | .method | .variant_case                          => false
        .array | .map | .try_expr | .if_expr | .match_expr       => false

# A code literal's text, without its quotes. Skipped when it carries a
# backslash — dropping the middle character of an escape measures the lexer,
# which rule 2 excludes — and when it is too short for a slip to leave a name
# anybody would have typed.
function code_text(s: source.Source, span: token.Span) -> str?
    written = source.span_text(s, span)

    if written.len() < 2 || written[0] != 34 || written[written.len() - 1] != 34
        return fail("not_a_code", "not a quoted literal")
    inner = written.slice(from: 1, to: written.len() - 1)

    if inner.len() < 3
        return fail("not_a_code", "too short for a slip")
    i: i64 @ 0

    while i < inner.len()
        if inner[i] == 92
            return fail("not_a_code", "an escape measures the lexer")
        i @ i + 1

    return ok(inner)

# A `constant`'s value, off by one digit.
function typo_digit(a: ast.Ast, s: source.Source, decls: [ast.Decl]) -> [str]
    out: [str] @ []

    for d in decls
        literal = constant_number(a: a, decl: d)

        if literal.is_err()
            continue
        span = a.exprs[literal.must()].span
        slip = neighbouring_digit(source.span_text(s, span))

        if !slip.is_err()
            out @ out.push(mutate_sites.edit(s: s, span: span, replacement: slip.must()))

    return out

# The single integer literal a `constant` is, or absent.
#
# A constant with no body is an `extern constant`: its value is the header's,
# so there is no digit in this file to move — which is the whole point of the
# form (§4.19, panel 038). One statement, and it must be an expression: a
# constant computed from several has no single number to be wrong about.
function constant_number(a: ast.Ast, decl: ast.Decl) -> i64?
    return match decl.kind
        .constant_decl c =>
            match c.body
                .ok body => single_int(a: a, body: body)
                .err _   => fail("no_digit", "an extern constant has no body")
        .function_decl | .record_decl | .variant_decl | .test_decl => fail("no_digit", "not a constant")

function single_int(a: ast.Ast, body: ast.Block) -> i64?
    if body.stmts.len() != 1
        return fail("no_digit", "more than one statement")

    return match a.stmts[body.stmts[0]].kind
        .expr_stmt only =>
            if is_int_literal(a.exprs[only.value])
                ok(only.value)
            else
                fail("no_digit", "not an integer literal")
        .bind | .declare | .mutate | .return_stmt | .break_stmt        => fail("no_digit", "not an expression")
        .continue_stmt | .while_stmt | .for_in | .assert_stmt | .error => fail("no_digit", "not an expression")

function is_int_literal(e: ast.Expr) -> bool
    return match e.kind
        .int_lit                                           => true
        .float_lit | .str_lit | .char_lit | .bool_lit      => false
        .null_ptr | .name | .hole | .error                 => false
        .unary | .binary | .field | .index                 => false
        .call | .method | .variant_case                    => false
        .array | .map | .try_expr | .if_expr | .match_expr => false

# The last digit, moved by one — and the TOP digit of the base goes *down*
# rather than carrying, because a carry changes how many digits the number has
# and that is a different mistake.
#
# The base has to be read, not assumed. Before M-literal-bases this tested
# "is it 0-9" and would have gone silently wrong the day hexadecimal arrived:
# `0x10` mutated and `0xff` skipped, so the operator's coverage would have
# depended on which characters a mask happened to end in — and its site count
# is the number panel 038 made the deliverable. A separator is stepped over,
# and absent where the literal does not end in a digit of its own base.
function neighbouring_digit(text: str) -> str?
    cs = text.chars()
    prefix: i64 @ 0
    radix: i64 @ 10

    if cs.len() > 2 && cs[0] == "0"
        if cs[1] == "x"
            prefix @ 2
            radix @ 16
        else if cs[1] == "o"
            prefix @ 2
            radix @ 8
        else if cs[1] == "b"
            prefix @ 2
            radix @ 2
    at: i64 @ cs.len() - 1

    while at >= 0 && cs[at] == "_"
        at @ at - 1

    if at < prefix
        return fail("no_digit", "nothing but a prefix and separators")
    value = digit_value(ch: cs[at], radix: radix)

    if value.is_err()
        return fail("no_digit", "the last character is not a digit of this base")
    moved: i64 @ value.must() + 1

    if value.must() + 1 == radix
        moved @ value.must() - 1
    out: [str] @ []
    i: i64 @ 0

    while i < cs.len()
        if i == at
            out @ out.push(digit_char(value: moved))
        else
            out @ out.push(cs[i])
        i @ i + 1

    return ok(out.join(""))

function digit_value(ch: str, radix: i64) -> i64?
    if ch.len() != 1
        return fail("not_a_digit", "not one character")
    b = ch[0].to_i64().must()
    value: i64 @ -1

    if b >= 48 && b <= 57
        value @ b - 48
    else if b >= 97 && b <= 102
        # Lowercase only: that is the spelling the lexer accepts, so a mutant built
        # here is a program the lexer would also accept.
        value @ b - 97 + 10

    if value == -1 || value >= radix
        return fail("not_a_digit", "not a digit of this base")
    return ok(value)

constant DIGITS: str
    "0123456789abcdef"

function digit_char(value: i64) -> str
    return DIGITS.chars()[value]

test "the slip drops the middle character"
    # `total` → `toal`, and the number is the point: `len / 2` is index 2 of
    # `t o t a l`, so the `t` goes. The bootstrap's own doc comment for this
    # function says `totl`, which is the character AFTER the one its code
    # drops — measured against `heroes mutate --survivors` on both compilers,
    # which agree on `toal`. The code is the definition; the comment was
    # never executed by anything.
    assert mutate_sites.slipped("total") == "toal"
    assert mutate_sites.slipped("abc") == "ac"
    assert mutate_sites.slipped("ab") == "a"
    assert mutate_sites.slipped("a") == ""

test "a digit moves by one, and the top digit of the base goes down"
    assert neighbouring_digit("41").default("") == "42"
    assert neighbouring_digit("49").default("") == "48"
    assert neighbouring_digit("0x1f").default("") == "0x1e"
    assert neighbouring_digit("0x10").default("") == "0x11"
    assert neighbouring_digit("0o37").default("") == "0o36"
    assert neighbouring_digit("0b1011").default("") == "0b1010"
    assert neighbouring_digit("0b1010").default("") == "0b1011"

    # A separator is stepped over rather than mutated.
    assert neighbouring_digit("1_000").default("") == "1_001"

    # A prefix with nothing after it has no digit to move.
    assert neighbouring_digit("0x").is_err()
    assert neighbouring_digit("").is_err()

test "a code literal is read without its quotes, and an escape is skipped"
    s: source.Source @ source.new_source(name: "x.hero", text: "\"unknown_char\"")
    whole = token.Span(start: 0, end: 14)
    assert code_text(s: s, span: whole).default("") == "unknown_char"
    escaped: source.Source @ source.new_source(name: "x.hero", text: "\"a\\nb\"")
    assert code_text(s: escaped, span: token.Span(start: 0, end: 6)).is_err()
    short: source.Source @ source.new_source(name: "x.hero", text: "\"ab\"")
    assert code_text(s: short, span: token.Span(start: 0, end: 4)).is_err()
