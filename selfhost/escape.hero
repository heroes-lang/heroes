# Escape sequences — the table and the decoder (panel 008).
# Port of archive/bootstrap-rs/heroes/src/lexer/escape.rs, the pure half: the validator
# (`LexState.escape`) lives with the lexer state it advances, in scan.
#
# Six escapes, split by context (Go's rule), so every character has exactly
# one spelling and §4.15's "exactly one correct way" survives:
#
#   in "…"   in '…'   value
#   \n       \n       10
#   \t       \t       9
#   \r       \r       13
#   \\       \\       92
#   \"       —        34 — a " needs no escape inside a char literal
#   —        \'       39 — a ' needs no escape inside a string
#
# The set is frozen: \0, \xNN and octal escapes reconvene the panel. The
# seventh, `\u{1b}` (panel 192's R5, which opened the freeze for it alone),
# writes in a string only a character a line cannot show (`raw_chars`), in
# lowercase hexadecimal with no leading zero, never a NUL, and is judged
# where it stands (`code_escape`); this decodes it.
#
# Port notes:
# - Rust's table returns the byte (`Option<u8>`); this port returns the decoded
#   one-character string, because Heroes has no byte-to-str conversion — and
#   the decoder is the only caller that wants the value rather than the fact.
#   It is still ONE table: the validator asks `.is_err()`, the decoder reads
#   the value, so the two cannot drift apart (the Rust file's own rule).
# - Rust walks `chars()` with a clonable iterator to peek; Heroes indexes the
#   `[str]` that `chars()` returns, so the peek is `cs[i + 1]` behind a bounds
#   test — the same shape, with the cursor visible.

## Error codes

constant ERR_NOT_AN_ESCAPE: str
    "not_an_escape"

## The context

# Which literal the escape appears in. The legal set differs between them.
variant Quoted
    in_str
    in_char

# The escapes legal here, for the diagnostic that lists them.
function legal(ctx: Quoted) -> str
    return match ctx
        .in_str  => "\\n \\t \\r \\\\ \\\""
        .in_char => "\\n \\t \\r \\\\ \\'"

# The character that needs no escape here because it is not the delimiter — the
# other context's escape, which the validator must reject.
#
# **One function, and there used to be two.** The port also carried a
# `bare_here(ctx) -> u8` returning the same character as a byte, because Rust's
# `bare_here` returns a `char` and formats it into the message directly, which
# Heroes cannot do. Two tables over one variant answering **one question** in two
# types — panel 067's shape exactly, found by the sweep its compiler-engineer
# asked for (condition 3). This one was the weak form: the byte version was
# reachable only from this file's own test, so the tables could have drifted with
# nothing but a test to notice. Deleted rather than kept in sync.
function bare_text(ctx: Quoted) -> str
    return match ctx
        .in_str  => "'"
        .in_char => "\""

# The context, named the way the diagnostic says it.
function ctx_word(ctx: Quoted) -> str
    return match ctx
        .in_str  => "a string"
        .in_char => "a character literal"

## The one table

# What one escape denotes, as the one-character string it decodes to. A miss
# means "not an escape here" — the validator's question and the decoder's
# fallback, off one table so they cannot drift apart.
function escape_text(after_backslash: str, ctx: Quoted) -> str?
    if after_backslash == "n"
        return ok("\n")

    if after_backslash == "t"
        return ok("\t")

    if after_backslash == "r"
        return ok("\r")

    if after_backslash == "\\"
        return ok("\\")

    if after_backslash == "\"" && ctx == .in_str
        return ok("\"")

    if after_backslash == "'" && ctx == .in_char
        return ok("'")
    return fail(code: ERR_NOT_AN_ESCAPE, msg: after_backslash)

# The letter escape that writes the character `value` names in a string, the
# table above read the other way, or "" where none does: the one spelling an
# escape by code is refused for (`code_escape`, `escape_report`).
function letter_of(value: i64) -> str
    if value == 10
        return "\\n"

    if value == 9
        return "\\t"

    if value == 13
        return "\\r"

    if value == 34
        return "\\\""

    if value == 92
        return "\\\\"
    return ""

## The escape by code

# Where the `}` of the `\u{…}` whose backslash is `cs[at]` stands, or -1: one
# to six hexadecimal digits between its braces. `code_escape` refuses every
# spelling but the one `raw_chars.escaped` writes, which has at most six, so
# six bound the sum and no longer spelling reaches here in a program that
# checked.
function brace_close(cs: [str], at: i64) -> i64
    if at + 3 >= cs.len() || cs[at + 1] != "u" || cs[at + 2] != "{"
        return -1
    i: i64 @ at + 3

    while i < cs.len() && i - at - 3 <= 6 && digit(cs[i]) >= 0
        i @ i + 1

    if i == at + 3 || i - at - 3 > 6 || i >= cs.len() || cs[i] != "}"
        return -1
    return i

# The code the hexadecimal digits `cs[from]` to `cs[to]` name.
function code_of(cs: [str], from: i64, to: i64) -> i64
    value: i64 @ 0

    for at in range(from: from, to: to)
        value @ value * 16 + digit(cs[at])

    return value

# One hexadecimal digit's value, in either case, or -1.
function digit(c: str) -> i64
    if c.len() != 1
        return -1
    b = c[0]

    if b >= '0' && b <= '9'
        return to_i64(b - '0').must()

    if b >= 'a' && b <= 'f'
        return to_i64(b - 'a').must() + 10

    if b >= 'A' && b <= 'F'
        return to_i64(b - 'A').must() + 10
    return -1

# The character `code` names, as UTF-8; "" for a NUL, a surrogate or a code
# past Unicode's last, none of which is a character a `str` holds.
function encoded(code: i64) -> str
    if code <= 0 || code > 1114111 || code >= 55296 && code <= 57343
        return ""
    out: [u8] @ []

    if code < 128
        out @ out.push(to_u8(code).must())
    else if code < 2048
        out @ out.push(to_u8(192 + (code >> 6)).must())
        out @ out.push(to_u8(128 + (code & 63)).must())
    else if code < 65536
        out @ out.push(to_u8(224 + (code >> 12)).must())
        out @ out.push(to_u8(128 + (code >> 6 & 63)).must())
        out @ out.push(to_u8(128 + (code & 63)).must())
    else
        out @ out.push(to_u8(240 + (code >> 18)).must())
        out @ out.push(to_u8(128 + (code >> 12 & 63)).must())
        out @ out.push(to_u8(128 + (code >> 6 & 63)).must())
        out @ out.push(to_u8(128 + (code & 63)).must())
    return out.validated_bytes().must()

# Past the escape whose backslash is at `at`: past the `}` of a `\u{…}` that
# closes on its line, else past the one character after the backslash, so a
# reader of a literal's braces never takes an escape's for its own.
function end_of(text: str, at: i64) -> i64
    if at + 2 < text.len() && text[at + 1] == 'u' && text[at + 2] == '{'
        i: i64 @ at + 3

        while i < text.len() && text[i] != '}' && text[i] != '"' && text[i] != '\n' && text[i] != '\\'
            i @ i + 1

        if i < text.len() && text[i] == '}'
            return i + 1
    return at + 2

## The decoder

# Decode a str or char token's text into the string it denotes. `text` is the
# token's own text, delimiters included.
#
# Total by construction: an invalid escape (already reported by the lexer)
# decodes to the backslash itself, so a broken literal never panics a later
# pass.
function unescape(text: str) -> str
    ctx: Quoted @ .in_str

    if text.len() > 0 && text[0] == '\''
        ctx @ .in_char

    if text.len() <= 1
        return ""
    inner = text.slice(from: 1, to: text.len() - 1)
    cs = inner.chars()
    parts: [str] @ []
    i: i64 @ 0

    while i < cs.len()
        c = cs[i]

        if c != "\\"
            parts @ parts.push(c)
            i @ i + 1
            continue

        if i + 1 >= cs.len()
            parts @ parts.push("\\")
            i @ i + 1
            continue
        close = brace_close(cs, at: i)

        if close > 0 && ctx == .in_str && encoded(code_of(cs, from: i + 3, to: close)).len() > 0
            parts @ parts.push(encoded(code_of(cs, from: i + 3, to: close)))
            i @ close + 1
            continue
        decoded = escape_text(cs[i + 1], ctx)

        if decoded.is_err()
            parts @ parts.push("\\")
            i @ i + 1
            continue
        one = decoded.must()
        parts @ parts.push(one)
        i @ i + 2

    return parts.join("")

test "the six escapes decode and the split is by context"
    assert unescape("\"a\\nb\"") == "a\nb"
    assert unescape("\"a\\tb\"") == "a\tb"
    assert unescape("\"a\\\\b\"") == "a\\b"
    assert unescape("\"a\\\"b\"") == "a\"b"
    assert unescape("'\\''") == "'"
    assert unescape("\"a\\rb\"") == "a\rb"
    assert unescape("'\\r'") == "\r"

test "an invalid escape decodes to the backslash itself"
    assert unescape("\"a\\db\"") == "a\\db"
    assert unescape("\"a\\'b\"") == "a\\'b"
    assert unescape("'\\\"'") == "\\\""

test "the edges do not abort"
    assert unescape("\"\"") == ""
    assert unescape("\"") == ""
    assert unescape("\"a\\\"") == "a\\"

test "the table serves the validator's question too"
    assert escape_text("n", .in_str).is_err() == false
    assert escape_text("\"", .in_char).is_err()
    assert escape_text("'", .in_str).is_err()
    assert bare_text(.in_str) == "'"
    assert legal(.in_char) == "\\n \\t \\r \\\\ \\'"
    assert escape_text("r", .in_str).must() == "\r"

test "the escape by code decodes in a string, and is the backslash elsewhere"
    assert unescape("\"a\\u{1b}b\"") == "a" + encoded(27) + "b"
    assert unescape("\"\\u{202E}\"") == encoded(8238)
    assert unescape("\"\\u{}\"") == "\\u{}"
    assert unescape("\"\\u{1234567}\"") == "\\u{1234567}"
    assert unescape("'\\u{1b}'") == "\\u{1b}"
    assert end_of("\\u{1b}x", at: 0) == 6
    assert end_of("\\u{1b", at: 0) == 2
    assert end_of("\\n{", at: 0) == 2

test "a code is the character it names, as UTF-8, and nothing past Unicode"
    assert encoded(65) == "A"
    assert encoded(233) == "é"
    assert encoded(8364) == "€"
    assert encoded(128512) == "😀"
    assert encoded(0) == ""
    assert encoded(55296) == ""
    assert encoded(1114112) == ""
