# A foreign word where it STANDS in a text: the repair `keywords.foreign_word`
# gives it once told whether the byte after it is `(` (defect 015), kept
# `certain` only where the word it writes is right in that place, and the word
# a certain swap writes over it (defect 133; design.md §4.17).
#
# **One module for a question two stages ask.** The lexer asks it to write
# the `reserved_word` diagnostic and its fix (`scan.ident`); the parser asks
# it to read a construct as the certain swap writes it
# (`parse/swap_reading.hero`). Read in one place, the byte and the place that
# decide whether a swap is certain cannot be read two ways, so the parser
# never reads a swap `check --apply` would not write. `keywords.hero` keeps
# the tables and the answer; this module keeps where in a text they are
# asked.
#
# **A swap is certain only where the word it writes is right where it
# stands** (defect 133's second round, 2026-09-29): defect 015's rule, the
# byte after the word, carried one step to the place the word stands in
# (`word_place.hero`). Measured the day it landed, over every swap in every
# place: `function fn(` wrote `function function(`, `record struct` wrote
# `record record`, `const x = 5` in a body wrote `constant x = 5`, `enum` in
# an `extern` group wrote a `variant` no group holds, and `include "stdio.h"`
# wrote `use "stdio.h"`, each a program `check` refused with a code the
# first run had not reported. Where the word is wrong, the message says what
# is right there, and the fix is a `guess` or none.
#
# **The lexer asks; the parser reads its answer** (defect 146, 2026-10-01).
# The place is read from the text's outline, read once per text
# (`text_outline.hero`), which the caller holds: the lexer's state, one per
# file. The parser no longer asks here: the lexer keeps every certain swap it
# writes (`swap_words.hero`), and the parser reads that, so the byte and the
# place are read once, by the stage that writes the fix.

use token
use keywords
use word_place
use word_neighbours
use text_outline

## Error codes

constant ERR_NO_SWAP: str
    "no_swap"

## Where the word stands

# The repair the word at `span` gets where it stands in `text`, whose outline
# `outline` holds or is read into.
function repair_at(text: str, span: token.Span, @outline: text_outline.Outline) -> keywords.ForeignWord?
    found = foreign_word_at(text, span)

    if found.is_err()
        return found
    return ok(repair_of(text, span, found.must(), @outline))

# The repair the foreign word at `span`, whose table entry is `one`, gets
# where it stands. Asked apart from the table, so the lexer, which asks the
# table of every word it reads, hands the outline over only for a word the
# table refuses.
function repair_of(text: str, span: token.Span, one: keywords.ForeignWord, @outline: text_outline.Outline) -> keywords.ForeignWord
    writes = swap_of(one.repair)
    word = text.slice(from: span.start, to: span.end)

    if writes.is_err() && word == "class"
        return a_class(text: text, span: span, one: one, @outline)

    if writes.is_err()
        return one
    return placed(
        text: text,
        span,
        one,
        word: text.slice(from: span.start, to: span.end),
        writes: writes.must(),
        @outline
    )

# `class`, whose guidance is a `record` (the audit's row 130-23, 2026-10-02):
# where it stands in a body, and where functions stand in its block, the one
# message says so too, a record being declared at the top level and holding
# only its fields. Until then `class Q` in a body over `function f()` said
# *use `record`*, and the program that followed it was refused twice anew,
# at the `record` in a body and at the function inside it.
function a_class(text: str, span: token.Span, one: keywords.ForeignWord, @outline: text_outline.Outline) -> keywords.ForeignWord
    place = word_place.place_of(text, span, @outline)
    methods = functions_below(text, span: span)

    if place != .statement && !methods
        return one
    message: str @ "`class` is not a word in this language — use `record` (there is no inheritance)"

    if place == .statement
        message @ "`class` is not a word in this language — a `record` is declared at the top level of a file, never inside a body or another declaration (there is no inheritance)"

    if methods
        message @ message + ", and a `record` holds only its fields: each function in this block is declared at the top level, taking the record as a parameter"
    return keywords.ForeignWord(message: message, repair: one.repair)

# Whether a line of the block below the word at `span`, deeper than the
# word's line, opens with a function's word, `function` or another
# language's.
function functions_below(text: str, span: token.Span) -> bool
    begins = word_place.line_start(text, at: span.start)
    margin = span.start - begins
    i: i64 @ span.end

    while i < text.len() && text[i] != '\n'
        i @ i + 1

    while i < text.len()
        i @ i + 1
        col: i64 @ 0

        while i + col < text.len() && text[i + col] == ' '
            col @ col + 1

        at = i + col
        blank = at >= text.len() || text[at] == '\n' || text[at] == '\r' || text[at] == '#'

        if !blank && col <= margin
            return false

        if !blank
            first = text.slice(from: at, to: word_place.word_end(text, from: at))

            if first == "function" || first == "fn" || first == "def" || first == "func"
                return true

        while i < text.len() && text[i] != '\n'
            i @ i + 1

    return false

# The table's entry for the word at `span`, told whether the byte after it is
# `(` (defect 015), before any place is read.
function foreign_word_at(text: str, span: token.Span) -> keywords.ForeignWord?
    called = span.end < text.len() && text[span.end] == '('
    return keywords.foreign_word(text: text.slice(from: span.start, to: span.end), called: called)

# Whether the word at `span` is one the lexer refuses as foreign: the table
# alone answers, since every foreign word has a repair wherever it stands.
function is_foreign(text: str, span: token.Span) -> bool
    return !foreign_word_at(text, span).is_err()

# The word a repair swaps in, or a failure where it is no swap.
function swap_of(repair: keywords.Repair) -> str?
    return match repair
        .swap fix => ok(fix.word)
        .hint _   => fail(code: ERR_NO_SWAP, msg: "a hint is shown, never applied")
        .drop     => fail(code: ERR_NO_SWAP, msg: "a drop is shown, never applied")
        .guidance => fail(code: ERR_NO_SWAP, msg: "guidance names no replacement")

# The swap, where the word it writes is right in the place the word stands;
# otherwise what is right there.
function placed(text: str, span: token.Span, one: keywords.ForeignWord, word: str, writes: str, @outline: text_outline.Outline) -> keywords.ForeignWord
    place = word_place.place_of(text, span, @outline)

    if writes == "use" && word_neighbours.header_after(text, end: span.end)
        return keywords.ForeignWord(
            message: "`" + word + "` is not a word in this language — a C header is named by an `extern` group, with the signatures it declares indented below it: `extern \"stdio.h\"`",
            repair: .hint(word: "extern")
        )

    # In an `extern` group a parameter and a field are at the header's own
    # width and sign, and the spec's word is *`i32` where C says int* (§ 13),
    # so `int` there is C's: `i64`, the language's integer, checked clean and
    # `build` refused it at the header (defect 135's L6, lane recovery-b7). A
    # result may be wider, and `i32` is right there too.
    if writes == "i64" && place == .typed && word_place.in_a_group(text, span, @outline)
        return keywords.ForeignWord(
            message: "`" + word + "` is not a word in this language — in an `extern` group a type is the header's own width and sign, and C's `" + word + "` is `i32`",
            repair: .swap(word: "i32")
        )

    if right_at(text: text, span, writes: writes, place: place)
        return one

    if writes == "else if" && place == .statement && word_neighbours.continues_an_if(text, span)
        return keywords.ForeignWord(
            message: "`" + word + "` is not a word in this language — `else if` continues the `if` above it with a condition of its own: `else if x == 2`",
            repair: .guidance
        )
    return keywords.ForeignWord(
        message: misplaced(word: word, writes: writes, place: place) + in_braces(text: text, span, writes: writes, place: place),
        repair: repair_there(writes, place: place)
    )

# Where a `{` follows a declaring word with no name after it, `struct {`, the
# words that say where the declaration's block goes, as the parser's own
# report says them for `record {` (`parse/heads.in_braces`; ruling 2 of the
# recovery batches, 2026-10-01); nothing elsewhere.
function in_braces(text: str, span: token.Span, writes: str, place: word_place.Place) -> str
    i: i64 @ span.end

    while i < text.len() && text[i] == ' '
        i @ i + 1

    named_there = place == .top && declares(writes) || place == .member && (writes == "record" || writes == "function" || writes == "constant")

    if i >= text.len() || text[i] != '{' || !named_there || writes == "use"
        return ""
    held: str @ "its cases on the lines below it"

    if writes == "record"
        held @ "its fields on the lines below it"
    else if writes == "function"
        held @ "its body on the lines below it"
    else if writes == "constant"
        held @ "its value on the line below it"
    return ", " + held + ", one level deeper, and never in braces"

# Where each word a swap writes is right: a declaration's keyword where a
# declaration opens, a group's three members one level under its head,
# `function` also where a parenthesised function type opens, `i64` where a
# type goes, `match` where a statement or a value goes, and `else if` where
# an `if` above it continues.
function right_at(text: str, span: token.Span, writes: str, place: word_place.Place) -> bool
    named = word_neighbours.name_after(text, end: span.end)

    if writes == "record" || writes == "constant"
        return (place == .top || place == .member) && named

    if writes == "function"
        return (place == .top || place == .member) && named || place == .function_type

    if writes == "variant" || writes == "use"
        return place == .top && named

    if writes == "i64"
        return place == .typed

    if writes == "match"
        return (place == .statement || place == .valued) && word_neighbours.arms_below(text, span)

    if writes == "else if"
        return place == .statement && word_neighbours.continues_an_if(text, span) && word_neighbours.value_after(text, end: span.end)
    return false

# What is right where the word stands, when the swap is not.
function misplaced(word: str, writes: str, place: word_place.Place) -> str
    lead = "`" + word + "` is not a word in this language"

    if place == .named
        return lead + ", and a name cannot be one: choose another name"

    if writes == "use" && place == .top
        return lead + " — use `use`, followed by the module it names: `use geom`"

    if place == .top && declares(writes) || place == .member && (writes == "record" || writes == "function" || writes == "constant")
        return lead + " — use `" + writes + "`, followed by the name it declares: `" + declared_example(writes) + "`"

    if writes == "constant" && place == .statement
        return lead + " — inside a body a value is bound with `=`: `x = 5`, and a `constant` is declared at the top level of a file"

    if (writes == "function" || writes == "record" || writes == "variant" || writes == "constant") && place == .statement
        return lead + " — a `" + writes + "` is declared at the top level of a file, never inside a body or another declaration"

    if writes == "variant" && place == .member
        return lead + " — an `extern` group holds no `variant`: a C enumeration's values are the group's `constant`s, one per line: `constant MODE_A: i32`"

    if writes == "use"
        return lead + " — a module is named by `use`, on a line of its own at the top level of a file: `use geom`"

    if writes == "function" && place == .typed
        return lead + " — a function type is `function`, written in parentheses: `(function(i64) -> i64)`"

    if (writes == "record" || writes == "variant") && place == .typed
        return lead + " — a type names the `" + writes + "` itself: `p: Point`"

    if writes == "i64"
        return lead + " — an integer type says its width, `i64`, and a type is written where a type goes: after a name and `:`, or after `->`"

    if writes == "match"
        return lead + " — `match` is an expression, written inside a body over the value it matches, with its arms below: `y = match x`"

    if writes == "else if"
        return lead + " — `else if` continues an `if` at the same margin above it, and there is none here"
    return lead + " — and `" + writes + "` cannot stand here either: nothing of the word belongs on this line"

function declares(writes: str) -> bool
    return writes == "record" || writes == "variant" || writes == "function" || writes == "constant" || writes == "use"

function declared_example(writes: str) -> str
    return match writes
        "record"   => "record Point"
        "variant"  => "variant Token"
        "function" => "function f(x: i64) -> i64"
        "constant" => "constant MAX: i64"
        _          => "use geom"

# The repair where the swap is not right: `const x = 5` in a body loses its
# word, a guess; everything else is the message's to say.
function repair_there(writes: str, place: word_place.Place) -> keywords.Repair
    if writes == "constant" && place == .statement
        return .drop
    return .guidance

# The word a CERTAIN swap writes over the foreign word at `span`: exactly the
# replacement `check --apply` machine-applies, and a failure where the repair
# is a hint or guidance, which nothing applies and so nothing may read as
# written.
function certain_swap(text: str, span: token.Span, @outline: text_outline.Outline) -> str?
    found = repair_at(text, span, @outline)

    if found.is_err()
        return fail(code: keywords.ERR_NOT_FOREIGN, msg: text.slice(from: span.start, to: span.end))
    return swap_of(found.must().repair)

## Tests

# The certain swap at `span`, the text's outline read for the one question.
function swap_in(text: str, span: token.Span) -> str?
    outline: text_outline.Outline @ text_outline.unread()
    return certain_swap(text, span, @outline)

# The repair at `span`, the same way.
function repair_in(text: str, span: token.Span) -> keywords.ForeignWord?
    outline: text_outline.Outline @ text_outline.unread()
    return repair_at(text, span, @outline)

# The parser reads a construct as the certain swap writes it, so the swap it
# reads must be the one `--apply` writes, decided by the same byte and place.
test "a certain swap is read where the word stands, and a hint or guidance never is"
    text = "fn main() int(x) let y  fn(z)"
    assert swap_in(text, token.Span(start: 0, end: 2)).must() == "function"
    assert swap_in(text, token.Span(start: 3, end: 7)).is_err()

    # `int(` is a hint and `let` is guidance: neither is applied, so neither
    # is read as written.
    assert swap_in(text, token.Span(start: 10, end: 13)).is_err()
    assert swap_in(text, token.Span(start: 17, end: 20)).is_err()

    # A word at the text's very end has no byte after it, so it is not called.
    assert swap_in("struct Point", token.Span(start: 0, end: 6)).must() == "record"

    # And a declaration's keyword owes the name it declares: `struct` alone
    # heads nothing.
    assert swap_in("struct", token.Span(start: 0, end: 6)).is_err()

test "a swap is certain only where the word it writes is right"
    typed = "g: (fn(i64) -> i64)"
    assert swap_in(typed, token.Span(start: 4, end: 6)).must() == "function"
    bare = "g: fn(i64) -> i64"
    assert swap_in(bare, token.Span(start: 3, end: 5)).is_err()
    assert swap_in("x: int", token.Span(start: 3, end: 6)).must() == "i64"
    assert swap_in("int x", token.Span(start: 0, end: 3)).is_err()

    # In an `extern` group `int` is C's, `i32`, at any depth under the head;
    # past the group it is the language's integer again (defect 135's L6).
    member = "extern \"stdlib.h\"\n    function abs(n: int) -> int\n"
    assert swap_in(member, word_place.at_word(text: member, word: "int")).must() == "i32"
    field = "extern \"time.h\"\n    record Tm tag tm partial\n        tm_sec: int\n"
    callback = "extern \"signal.h\"\n    function signal(sig: i32, f: (function(int) -> ())) -> ptr\n"
    assert swap_in(callback, word_place.at_word(text: callback, word: "int")).must() == "i32"
    assert swap_in(field, word_place.at_word(text: field, word: "int")).must() == "i32"
    after = "extern \"m.h\"\n    function q() -> f64\n\nfunction f(n: int)\n"
    assert swap_in(after, word_place.at_word(text: after, word: "int")).must() == "i64"
    local = "function main()\n    x: int @ 0\n"
    assert swap_in(local, word_place.at_word(text: local, word: "int")).must() == "i64"
    named = "function fn(x: i64)"
    assert swap_in(named, token.Span(start: 9, end: 11)).is_err()
    body = "function main()\n    const x = 5\n"
    assert swap_in(body, token.Span(start: 20, end: 25)).is_err()
    assert repair_in(body, token.Span(start: 20, end: 25)).must().repair == .drop
    group = "extern \"m.h\"\n    enum Mode\n"
    assert swap_in(group, token.Span(start: 17, end: 21)).is_err()
    header = "include \"stdio.h\"\n"
    assert repair_in(header, token.Span(start: 0, end: 7)).must().repair == .hint(word: "extern")
    assert swap_in("import geom", token.Span(start: 0, end: 6)).must() == "use"
    chain = "function f()\n    if x\n        print(1)\n    elif y\n"
    assert swap_in(chain, token.Span(start: 43, end: 47)).must() == "else if"
    assert swap_in("elif", token.Span(start: 0, end: 4)).is_err()

test "the repair where the word stands is the table's answer where that answer is right"
    assert repair_in("int(", token.Span(start: 0, end: 3)).must() == keywords.foreign_word(text: "int", called: true).must()
    assert repair_in("x: int", token.Span(start: 3, end: 6)).must() == keywords.foreign_word(text: "int", called: false).must()
    assert repair_in("main", token.Span(start: 0, end: 4)).is_err()
    assert is_foreign("int(", token.Span(start: 0, end: 3))
    assert !is_foreign("main", token.Span(start: 0, end: 4))

# Defect 146: a word in the middle of its line is placed from that line, and
# a text's outline is read only for a word that opens its line, once.
test "the outline is read once, and only for a word that opens its line"
    outline: text_outline.Outline @ text_outline.unread()
    mid = "x: int\n"
    assert certain_swap(mid, token.Span(start: 3, end: 6), @outline).must() == "i64"
    assert !outline.read
    heads = "fn f()\nfn g()\n"
    assert certain_swap(heads, token.Span(start: 0, end: 2), @outline).must() == "function"
    assert outline.read
    kept = outline
    assert certain_swap(heads, token.Span(start: 7, end: 9), @outline).must() == "function"
    assert outline == kept
