# What this backend cannot emit yet, said in a way that ends the
# reader's loop (panels 020 R1/R2, 029 R4b, 067, 068, 081 R3, 082 R1).
# Port of crates/heroes/src/emit/{gate,gate_types,gate_ops}.rs — one
# module, because the two tables and the list that collects them call
# each other: the tenth knot, and the last one emit/ draws.
#
# The gate walks the IR, not the surface: Part 5's sugar is erased on
# the way in, so the IR is the smaller closed vocabulary — one row here
# covers every spelling that lowers to it, and the rows die one
# milestone at a time. THE MESSAGE NAMES THE CAPABILITY, NEVER THE
# MILESTONE: a milestone id resolves only in the ROADMAP, which the
# reader does not have — the llm-ergonomist read one as an internal
# tracker id and reported the toolchain broken.
#
# The type table is EMPTY OF REFUSALS today; what is left is descent
# into what a container holds, and the descent is a filed defect rather
# than tidiness: [()], [ptr] and {str: ptr} all checked clean at exit 0
# and aborted at 134 with "this is a compiler bug" (panels 029, 067).
#
# The kind is unsupported_kind — panel 020's second word: the program
# is fine and this compiler is unfinished. The debt the port note here
# used to carry was discharged when diag grew Kind with the
# diagnostics department.

use ast
use source
use check_table
use check_state
use ir
use ir_state
use builtins
use emit_types
use emit_builtins
use emit_decls
use diag
use token
use parse
use resolve
use checker
use ir_lower

record GateNote
    code: str
    what: str
    span: token.Span

# One capability, at its earliest span. The dedup is on the MESSAGE: a
# program with forty strings in it has one string problem.
function note(@found: [GateNote], code: str, what: str, span: token.Span)
    at: i64 @ 0
    for existing in found
        if existing.what == what
            if span.start < existing.span.start
                found[at].span @ span
            return
        at @ at + 1
    found @ found.push(GateNote(code: code, what: what, span: span))

# What the backend does emit. DERIVED, not maintained: the built-in
# list is EMITTED, which entry is also exhaustive over — a hand-written
# enumeration beside a machine-readable table is a sentence that
# becomes a lie one milestone later. The second clause is load-bearing:
# without it, the rewrite the message invites is itself a coin flip.
function subset() -> str
    quoted: [str] @ []
    for name in emit_builtins.EMITTED
        quoted @ quoted.push("`" + name + "`")
    return "the backend emits every type in the language, `if`, `while`, `for`, `match`, functions, and the built-ins " + quoted.join(", ") + " — no other built-in is emitted yet"

# Every capability this program needs and this backend lacks, sorted by
# where it first appears.
function refuse(target: emit_decls.BuildTarget, p: ir_state.Program, c: check_state.Checked, s: source.Source, decls: [ast.Decl]) -> [diag.Diagnostic]
    found: [GateNote] @ []
    unit_fields(@found, c, s, decls)
    for f in p.functions
        # heroes test enters these and ordinary builds ignore them;
        # under heroes test they ARE the program.
        skip: bool @ false
        match f.kind
            .test_kind =>
                match target
                    .program_build => skip @ true
                    .tests_build => skip @ skip
            # The extern row died at the ladder: the group form supplies
            # the header, so the call is checked against the real one.
            .extern_kind => skip @ true
            .function_kind | .constant_kind => skip @ skip
        if skip
            continue
        for slot_id in f.params
            check_type(@found, c, s, decls, ty: f.slots[slot_id].ty, span: f.span)
        check_type(@found, c, s, decls, ty: f.result, span: f.span)
        for blk in f.blocks
            for inst in blk.insts
                check_type(@found, c, s, decls, ty: inst.ty, span: inst.span)
                check_op(@found, op: inst.op, span: inst.span)
                check_fixed_flow(@found, c, f, op: inst.op, span: inst.span)
    # Sorted by first appearance: an insertion sort over spans, the
    # resolver's own idiom.
    ordered: [GateNote] @ []
    for one in found
        at: i64 @ 0
        while at < ordered.len() && ordered[at].span.start <= one.span.start
            at @ at + 1
        before: [GateNote] @ ordered.slice(from: 0, to: at)
        before @ before.push(one)
        rest = ordered.slice(from: at, to: ordered.len())
        for r in rest
            before @ before.push(r)
        ordered @ before
    out: [diag.Diagnostic] @ []
    for one in ordered
        d: diag.Diagnostic @ diag.new_unsupported(code: one.code, message: one.what + " is not emitted yet", span: one.span)
        d.notes @ d.notes.push(what_the_author_can_do(one.code))
        d.notes @ d.notes.push(subset())
        out @ out.push(d)
    return out

# What this row leaves the author able to do — per row (panel 082 R1),
# because the blanket note was one string for every row and false on
# most. The test is what the refusal is KEYED ON: a row keyed on a
# capability the backend lacks whatever the author writes is honestly
# "no change to this file will fix this" — that is missing, and it is
# the only one. Each route below was RUN before it was written here.
function what_the_author_can_do(code: str) -> str
    if code == "missing"
        return "no change to this file will fix this"
    if code == "pointer_element"
        return "hold the pointer in a `record` and make an array of that instead"
    if code == "unit_element" || code == "unit_field"
        return "give it a type that carries a value"
    if code == "fixed_flow" || code == "fixed_element"
        return "write a fixed array out where its record is built — C has no array assignment"
    if code == "builtin"
        return "call it at a type the built-in accepts"
    return "this is refused for what is on this line, so something else compiles"

## The type table (gate_types.rs)

# A type the runtime has no representation for. Every arm returns
# today; what is left is descent, because () as an ELEMENT is still
# refused (a descriptor that does not exist) while () as a type in its
# own right is fine.
function check_type(@found: [GateNote], c: check_state.Checked, s: source.Source, decls: [ast.Decl], ty: i64, span: token.Span)
    match check_table.get(c.types, ty)
        .array arr => check_element(@found, c, s, decls, element: arr.element, span: span, container: "an array")
        .map m =>
            check_element(@found, c, s, decls, element: m.key, span: span, container: "a map key")
            check_element(@found, c, s, decls, element: m.value, span: span, container: "a map value")
        # A ()? is representable and the other containers are not: a
        # union whose ok side carries nothing is just a tag.
        .fallible o =>
            if o.payload != check_table.unit_ty(c.types)
                check_element(@found, c, s, decls, element: o.payload, span: span, container: "a `T?`")
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return
        .fixed | .function_ty | .named | .case_ty => return
        .failure | .generic | .error => return

# () as the type of a DECLARED FIELD, which the IR walk cannot see:
# record Box { u: () } walked straight past the gate and reached clang
# as `void f_u;` — field has incomplete type, exit 2, the compiler
# blaming itself (2026-08-12).
function unit_fields(@found: [GateNote], c: check_state.Checked, s: source.Source, decls: [ast.Decl])
    for decl in emit_types.aggregates(c, decls)
        owner = source.span_text(s, decls[decl].name)
        all_fields: [ast.Field] @ emit_types.fields_of(decls, decl: decl)
        for one_case in emit_types.cases_of(decls, decl: decl)
            for field in one_case.fields
                all_fields @ all_fields.push(field)
        for field in all_fields
            written = check_state.written_type(c, field.ty)
            if written.is_err()
                continue
            if written.must() == check_table.unit_ty(c.types)
                note(@found, code: "unit_field", what: "`()` as the type of `" + owner + "." + source.span_text(s, field.name) + "`", span: field.name)

# What a container holds — a narrower question than what a type is.
# Three types are no kind of element, each for its own reason: () has
# no C declaration; ptr and cstr have one and still no descriptor (the
# runtime ships no row for an address the program does not own — a
# refusal, not a feature: growing descriptors is a panel question with
# an ABI bump in it). A fixed array is the fourth (panel 081 R3): no
# storage of its own, storageless.rs' fact seen from the container's
# side. And a map KEY must not REACH a pointer either (panel 068, the
# seventh shape): Slot { p: ptr } as a key gets hero_unreachable in its
# generated hash — key position ONLY, measured, because hash is called
# only for a key.
function check_element(@found: [GateNote], c: check_state.Checked, s: source.Source, decls: [ast.Decl], element: i64, span: token.Span, container: str)
    fall: bool @ false
    match check_table.get(c.types, element)
        .unit =>
            note(@found, code: "unit_element", what: "`()` as the element of " + container, span: span)
            return
        .ptr =>
            note(@found, code: "pointer_element", what: "`ptr` as the element of " + container, span: span)
            return
        .cstr =>
            note(@found, code: "pointer_element", what: "`cstr` as the element of " + container, span: span)
            return
        .fixed =>
            note(@found, code: "fixed_element", what: "a fixed array as the element of " + container, span: span)
            return
        .int_ty | .float_ty | .bool | .str => fall @ fall
        .array | .map | .fallible | .function_ty | .named => fall @ fall
        .case_ty | .failure | .generic | .error => fall @ fall
    if container == "a map key"
        reached = reaches_pointer(c, decls, ty: element, depth: 0)
        if !reached.is_err()
            note(@found, code: "pointer_element", what: "a map key that reaches " + reached.must() + " — it has no hash", span: span)
            return
    check_type(@found, c, s, decls, ty: element, span: span)

# Does this type REACH a ptr or a cstr, through fields, payloads or
# containers? Depth-bounded as the checker's own partial walk is.
# Returns what was found, for the message: a reader told "reaches
# `ptr`" can look for the pointer; one told "not a valid key" cannot.
function reaches_pointer(c: check_state.Checked, decls: [ast.Decl], ty: i64, depth: i64) -> str?
    if depth > 16
        return fail("none", "past any nesting worth naming")
    match check_table.get(c.types, ty)
        .ptr => return ok("`ptr`")
        .cstr => return ok("`cstr`")
        .array arr => return reaches_pointer(c, decls, ty: arr.element, depth: depth + 1)
        .fallible o => return reaches_pointer(c, decls, ty: o.payload, depth: depth + 1)
        .map m =>
            in_key = reaches_pointer(c, decls, ty: m.key, depth: depth + 1)
            if !in_key.is_err()
                return in_key
            return reaches_pointer(c, decls, ty: m.value, depth: depth + 1)
        .named n =>
            all_fields: [ast.Field] @ []
            match decls[n.decl].kind
                .record_decl rec => all_fields @ rec.fields
                .variant_decl v =>
                    for one_case in v.cases
                        for field in one_case.fields
                            all_fields @ all_fields.push(field)
                .constant_decl | .function_decl | .test_decl => return fail("none", "not a data declaration")
            for field in all_fields
                written = check_state.written_type(c, field.ty)
                if written.is_err()
                    continue
                found = reaches_pointer(c, decls, ty: written.must(), depth: depth + 1)
                if !found.is_err()
                    return found
            return fail("none", "no pointer inside")
        .int_ty | .float_ty | .bool | .str | .unit | .fixed => return fail("none", "no pointer here")
        .function_ty | .case_ty | .failure | .generic | .error => return fail("none", "no pointer here")
    return fail("none", "unreached")

## The op table (gate_ops.rs)

# The half that gates by NAME as well as by op: xs.len() lowers to
# call builtin len while for lowers to the len op, so gating the op
# alone leaves an undefined symbol at link time — the exact class the
# gate exists to prevent. Every arm holds no rows rather than being
# deleted, so adding an op is a compile error here.
function check_op(@found: [GateNote], op: ir.OpKind, span: token.Span)
    match op
        .call cl => callee_note(@found, callee: cl.callee, span: span)
        # §4.16 says a holed file produces no binary; the build path
        # reports the holes and stops before here, so this row is the
        # belt to those braces.
        .hole => note(@found, code: "hole", what: "a hole (`???`)", span: span)
        # The verifier rejects this before the emitter is asked.
        .missing => note(@found, code: "missing", what: "a form the compiler cannot lower", span: span)
        .lit | .load | .store | .unary | .binary | .cast | .construct => return
        .field | .index | .map_get | .len_of | .tag_of | .payload => return
        .func_ref | .copy_out | .abort_op | .incref | .decref => return

# Where a fixed array is allowed to FLOW (panel 081 R3) — C's rule:
# a T[N] has no storage of its own, so it works in exactly the two
# positions that consume fixed_text (a subscript base, a construction
# argument). Four other shapes went to clang unrefused and clang blamed
# the compiler, every one heroes check exit 0, measured 2026-08-16.
# The refusal is a row and not a repair, because Principle 0 puts the
# widening behind a need that does not exist: selfhost/ declares zero
# fixed-array fields, measured by two panel seats.
function check_fixed_flow(@found: [GateNote], c: check_state.Checked, f: ir_state.Function, op: ir.OpKind, span: token.Span)
    match op
        .store st =>
            if is_fixed_value(c, f, value: st.value)
                note(@found, code: "fixed_flow", what: "a fixed array given a name or stored into a place", span: span)
        .construct con =>
            skip: bool @ false
            match con.shape
                .array_shape | .map_shape => skip @ true
                .record_shape | .case_shape | .ok_shape | .fail_shape | .err_shape => skip @ skip
            if !skip
                for arg in ir_state.args_of(f, con.arguments)
                    match arg
                        .value_arg v =>
                            if is_fixed_value(c, f, value: v.value) && !is_a_written_literal(f, value: v.value)
                                note(@found, code: "fixed_flow", what: "a fixed array copied from another value", span: span)
                        .inout_arg => continue
        .lit | .load | .unary | .binary | .cast | .call => return
        .field | .index | .map_get | .len_of | .tag_of | .payload => return
        .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => return

function is_fixed_value(c: check_state.Checked, f: ir_state.Function, value: i64) -> bool
    return match check_table.get(c.types, ir_state.value_type(f, value))
        .fixed => true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => false
        .array | .map | .fallible | .function_ty | .named => false
        .case_ty | .failure | .generic | .error => false

# Whether this value is the [a, b, c] an author wrote, as opposed to a
# field read with the same type: a literal renders as {a, b, c}, which
# C accepts as an initialiser, and a field read renders as v.member,
# which it does not.
function is_a_written_literal(f: ir_state.Function, value: i64) -> bool
    for blk in f.blocks
        for inst in blk.insts
            if !inst.dest.is_err() && inst.dest.must() == value
                match inst.op
                    .construct con =>
                        match con.shape
                            .array_shape => return true
                            .record_shape | .case_shape | .map_shape => return false
                            .ok_shape | .fail_shape | .err_shape => return false
                    .lit | .load | .store | .unary | .binary | .cast | .call => return false
                    .field | .index | .map_get | .len_of | .tag_of | .payload => return false
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => return false
    return false

function callee_note(@found: [GateNote], callee: ir.Callee, span: token.Span)
    match callee
        # A call to C emits from the ladder: the group's header is in
        # the prelude, so the name is declared by the real header.
        .heroes_fn | .extern_fn | .indirect => return
        .builtin_fn bt =>
            builtin_name = builtins.table()[bt.at].name
            in_emitted: bool @ false
            for one in emit_builtins.EMITTED
                if one == builtin_name
                    in_emitted @ true
            if !in_emitted
                note(@found, code: "builtin", what: "the built-in `" + builtin_name + "`", span: span)

## Tests

test "a hole is refused with its two notes, and forty holes are one problem"
    text = "function f() -> i64\n    _ = ???\n    _ = ???\n    return 1\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: check_state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    low = ir_lower.lower(parsed.tree, out, c, s, parsed.decls)
    got = refuse(target: .program_build, p: low.program, c: c, s: s, decls: parsed.decls)
    assert got.len() == 1
    assert got[0].code == "hole"
    assert got[0].message == "a hole (`???`) is not emitted yet"
    assert got[0].notes.len() == 2
    assert got[0].notes[0] == "this is refused for what is on this line, so something else compiles"

test "a pointer element is refused with the record route, at its first appearance"
    text = "extern \"m.h\"\n    function make() -> ptr\n\nfunction main()\n    xs: [ptr] @ []\n    _ = xs\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: check_state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = ir_lower.lower(parsed.tree, out, c, s, parsed.decls)
    got = refuse(target: .program_build, p: low.program, c: c, s: s, decls: parsed.decls)
    assert got.len() == 1
    assert got[0].code == "pointer_element"
    assert got[0].message == "`ptr` as the element of an array is not emitted yet"
    assert got[0].notes[0] == "hold the pointer in a `record` and make an array of that instead"
