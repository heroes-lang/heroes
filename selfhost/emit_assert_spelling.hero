# How a type is spelled inside an assertion that is NEVER EVALUATED
# (design.md §4.19; panels 042, 058, 060, 062, 063, 083). Port of
# crates/heroes/src/emit/assert_spelling.rs.
#
# _Generic's controlling expression is unevaluated (C11 6.5.1.1p3),
# which is what makes the whole mechanism free — and why nothing here
# may have a side effect or a cost. This is the half that gets subtly
# wrong answers, and every comment records a repair that was BUILT and
# measured rather than reasoned.
#
# The two marker strings live here in the port (the Rust keeps them in
# ffi.rs): they are the contract between the assertion writer and the
# error mapper — the message carries marker + C name + declared type,
# so a clang failure maps back to the author's line.

use check_table
use check_state
use widths
use emit_ctype
use source
use parse
use resolve
use checker

# THE SIX SPELLINGS OF A C STRING, AND THEIR ONE HOME.
#
# A `cstr` is a pointer to characters and only that (panel 083): C's `char` is a
# distinct type from both `signed char` and `unsigned char`, real headers return
# all three, and each may be `const` — six associations, and `const void *` is
# refused, which was that sitting's whole repair.
#
# **They live here because two places ask the question and a list written twice
# dies in silence** (CLAUDE.md §11). `emit_extern_assert` folds them into
# `HERO_RET_CSTR` for a RETURN; `emit_extern_field` writes them inline for a
# FIELD, and cannot use the macro — field assertions are emitted at
# `emit_decls.hero:84` and the macros at `:86`, so the `#define` has not been
# written yet when a field assertion needs it. Same set, two syntaxes, one source.
constant CSTR_SPELLINGS: str
    "char *:1, const char *:1, signed char *:1, const signed char *:1, unsigned char *:1, const unsigned char *:1"

constant ASSERTION: str
    "heroes-ffi-return "

constant CONSTANCY: str
    "heroes-ffi-const "

# Which assertion a declared result type asks for. HERO_RET_INT's set
# is a fact about i64's range and nothing else — a second width reusing
# it would accept a C long for an i32 and truncate in silence (panel
# 042). cstr asks for a STRING: sharing ptr's row let a const void *
# blob pass and to_str() read six bytes past the object with every
# instrument silent (panel 083). A struct result took a panel to get an
# assertion at all (063): 113 of raylib's 600 entry points return one
# by value, and the class was misattributed exit 2 — worse than a
# silent wrong answer, because it defeats §7's named exception.
function return_check(c: check_state.Checked, ty: i64) -> str?
    match check_table.get(c.types, ty)
        .int_ty ik =>
            match ik.kind
                .i64 => return ok("HERO_RET_INT")
                .i8 => return ok("HERO_RET_I8")
                .i16 => return ok("HERO_RET_I16")
                .i32 => return ok("HERO_RET_I32")
                .u8 => return ok("HERO_RET_U8")
                .u16 => return ok("HERO_RET_U16")
                .u32 => return ok("HERO_RET_U32")
                .u64 => return ok("HERO_RET_U64")
        .float_ty fk =>
            match fk.kind
                .f32 => return ok("HERO_RET_F32")
                .f64 => return ok("HERO_RET_F64")
        .bool => return ok("HERO_RET_BOOL")
        .str => return ok("HERO_RET_STR")
        .unit => return ok("HERO_RET_UNIT")
        .ptr => return ok("HERO_RET_PTR")
        .cstr => return ok("HERO_RET_CSTR")
        .named => return ok("HERO_RET_RECORD")
        # The loud direction: everything else is refused by the
        # checker's boundary rule before a program can reach the
        # emitter, so a new FFI type arrives as a decision here instead
        # of silently getting no assertion.
        .array | .fixed | .map | .fallible | .function_ty => return fail("bug", "this type does not cross the FFI boundary")
        .case_ty | .failure | .generic | .error => return fail("bug", "this type does not cross the FFI boundary")
    return fail("bug", "unreached")

# The SECOND argument a return check takes, or "" for the eight that
# take one (panel 063): a struct cannot name its type in the macro, so
# the type travels as an argument — HERO_RET_RECORD(f(...), Color).
# The name is the C TYPE table, never the satellite: what goes inside a
# _Static_assert about a header's own function is the header's own
# spelling.
function return_argument(names: emit_ctype.Names, c: check_state.Checked, ty: i64) -> str
    match check_table.get(c.types, ty)
        .named n => return ", " + emit_ctype.of(names, decl: n.decl)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return ""
        .array | .fixed | .map | .fallible | .function_ty => return ""
        .case_ty | .failure | .generic | .error => return ""
    return ""

# Whether a result type can be asked __builtin_constant_p — FALSE for a
# struct, and the hole that leaves is written down rather than absorbed
# (panel 063 condition 1): the builtin answers 0 for every struct on
# this toolchain, compound literal included, so asking would newly
# refuse raylib's 26 CLITERAL(Color) macros that bind and run today.
# The cost: §4.2's back door (a struct accessor over a mutable global)
# stays open, and an auditor sees a type assertion where there were
# none — the test that fires when the premise dies is named in the
# bootstrap's suite.
function asks_for_a_value(c: check_state.Checked, ty: i64) -> bool
    return match check_table.get(c.types, ty)
        .named => false
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => true
        .array | .fixed | .map | .fallible | .function_ty => true
        .case_ty | .failure | .generic | .error => true

# A zero of the declared parameter type, cast so the call type-checks —
# never evaluated, it exists only to make the expression well-formed.
#
# A cstr's zero is the BARE 0, the one type that must not be cast
# (panel 058 condition 1): C11 6.3.2.3p3 makes integer 0 a null pointer
# constant assignable to any pointer at any qualification, so 0
# type-checks against char *, const char *, char ** and const char **
# alike. A cast cannot do that, and both wrong casts were built and
# reproduced: (const char *)0 warns on every char * parameter in any
# header (strtok, getcwd, 157 more); (char *)0 discards qualifiers on a
# correct const char ** out-parameter (sqlite3_prepare_v2's pzTail).
#
# A struct's zero is a compound literal of the header's own type
# (panel 060) — (void *)0 was refused by clang correctly, at exit 2,
# blaming the compiler. And () as a parameter reaches here because the
# boundary rule is shared with results, where () is legal: the spelling
# stays (void *)0 because no C spelling of a () argument exists; the
# repair is a frontend refusal, a diagnostic class and therefore a
# panel. The arm buys the mistake being NAMED rather than carried by
# a catch-all.
function zero_of(names: emit_ctype.Names, c: check_state.Checked, ty: i64, mutable: bool) -> str
    is_cstr: bool @ false
    match check_table.get(c.types, ty)
        .cstr => is_cstr @ true
        .int_ty | .float_ty | .bool | .str | .ptr | .unit => is_cstr @ is_cstr
        .array | .fixed | .map | .fallible | .function_ty | .named => is_cstr @ is_cstr
        .case_ty | .failure | .generic | .error => is_cstr @ is_cstr
    if is_cstr
        return "0"
    match check_table.get(c.types, ty)
        .named n =>
            c_type = emit_ctype.of(names, decl: n.decl)
            if mutable
                return "(" + c_type + " *)0"
            return "(" + c_type + "){0}"
        .str =>
            if mutable
                return "(HeroStr *)0"
            return "(HeroStr){0}"
        .int_ty ik =>
            if mutable
                return "(" + widths.int_c_type(ik.kind) + " *)0"
            return "(" + widths.int_c_type(ik.kind) + ")0"
        .float_ty fk =>
            if mutable
                return "(" + widths.float_c_type(fk.kind) + " *)0"
            return "(" + widths.float_c_type(fk.kind) + ")0"
        .bool =>
            if mutable
                return "(bool *)0"
            return "(bool)0"
        .ptr =>
            if mutable
                return "(void * *)0"
            return "(void *)0"
        .unit => return "(void *)0"
        .cstr => return "0"
        .array | .fixed | .map | .fallible | .function_ty => return "(void *)0"
        .case_ty | .failure | .generic | .error => return "(void *)0"
    return "(void *)0"

## Tests

test "the spelling table: widths, the bare cstr zero, the struct pair"
    text = "extern \"m.h\"\n    record Color\n        r: i64\n\nfunction touch(col: Color)\n    _ = col\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: check_state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = emit_ctype.new_names(s, parsed.decls)
    int_id = check_table.int_ty_id(c.types)
    str_id = check_table.str_ty(c.types)
    unit_id = check_table.unit_ty(c.types)
    assert return_check(c, ty: int_id).must() == "HERO_RET_INT"
    assert return_check(c, ty: unit_id).must() == "HERO_RET_UNIT"
    color = check_table.lookup(c.types, .named(decl: 0)).must()
    assert return_check(c, ty: color).must() == "HERO_RET_RECORD"
    assert return_argument(names, c, ty: color) == ", Color"
    assert return_argument(names, c, ty: int_id) == ""
    assert !asks_for_a_value(c, ty: color)
    assert asks_for_a_value(c, ty: int_id)
    cstr_id = check_table.lookup(c.types, .cstr)
    if !cstr_id.is_err()
        assert zero_of(names, c, ty: cstr_id.must(), mutable: false) == "0"
    assert zero_of(names, c, ty: int_id, mutable: false) == "(int64_t)0"
    assert zero_of(names, c, ty: int_id, mutable: true) == "(int64_t *)0"
    assert zero_of(names, c, ty: str_id, mutable: false) == "(HeroStr){0}"
    assert zero_of(names, c, ty: color, mutable: false) == "(Color){0}"
    assert zero_of(names, c, ty: color, mutable: true) == "(Color *)0"
