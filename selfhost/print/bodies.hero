# Blocks, statements and expressions, written back out for --dump-ast
# (design.md §4.15). Port of archive/bootstrap-rs/heroes/src/printer/bodies.rs.
#
# One decision shapes this file: EVERY binary and unary expression is
# printed with its parentheses, whether the source had them or not —
# `2 + 3 * 4` comes out as `(2 + (3 * 4))`. Not pretty (fmt prints it
# the way it was written), but it makes the dump PROVE the precedence
# table instead of describing it, which is the whole reason a tree
# dump exists. Statements are one per line, each opening with what it
# is; the exception is a statement that IS an if or a match, which
# keeps its keyword and carries its blocks indented below.

use token
use ast
use source
use digits
use print/types
use parse

function write_block(tree: ast.Ast, s: source.Source, block: ast.Block, indent: i64) -> str
    out: str @ ""

    for id in block.stmts
        out @ out + write_stmt(tree, s, id: id, indent: indent, head: "")

    return out

function pad(indent: i64) -> str
    return " ".repeat(indent.to_u64().must())

# One statement, optionally behind a HEAD — which is how a match arm
# is printed: the arm's patterns are the head, and the body is a
# statement like any other (panel 014). Before that, an inline arm
# body had its own rendering path, and that path could not print a
# block under a control head: fmt silently deleted the branches of an
# if inside an arm.
function write_stmt(tree: ast.Ast, s: source.Source, id: i64, indent: i64, head: str) -> str
    match tree.stmts[id].kind
        .bind b =>
            annotation: str @ ""

            if !b.ty.is_err()
                annotation @ ": " + types.render_type(tree, b.ty.must(), s)
            return write_valued(
                tree,
                s,
                head: head + "bind " + source.span_text(s, b.name) + annotation + " = ",
                value: b.value,
                indent: indent
            )
        .declare dc =>
            return write_valued(
                tree,
                s,
                head: head + "declare " + source.span_text(s, dc.name) + ": " + types.render_type(tree, dc.ty, s) + " @ ",
                value: dc.value,
                indent: indent
            )
        .mutate m =>
            return write_valued(
                tree,
                s,
                head: head + "mutate " + render_expr(tree, m.place, s) + " @ ",
                value: m.value,
                indent: indent
            )
        .return_stmt r =>
            if r.value.is_err()
                return pad(indent) + head + "return\n"
            return write_valued(tree, s, head: head + "return ", value: r.value.must(), indent: indent)
        .break_stmt    => return pad(indent) + head + "break\n"
        .continue_stmt => return pad(indent) + head + "continue\n"
        .assert_stmt a =>
            return write_valued(tree, s, head: head + "assert ", value: a.value, indent: indent)
        .while_stmt w =>
            return pad(indent) + head + "while " + render_expr(tree, w.cond, s) + "\n" + write_block(tree, s, block: w.block, indent: indent + 2)
        .for_in f =>
            return pad(indent) + head + "for " + source.span_text(s, f.name) + " in " + render_expr(tree, f.iterable, s) + "\n" + write_block(tree, s, block: f.block, indent: indent + 2)
        # An if or a match in statement position keeps its own shape;
        # any other expression is labelled, because a bare line of
        # expression reads like a statement kind that does not exist.

        .expr_stmt e =>
            is_control: bool @ false

            match tree.exprs[e.value].kind
                .if_expr | .match_expr                                                         => is_control @ true
                .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => is_control @ is_control
                .name | .hole | .unary | .binary | .field | .index                             => is_control @ is_control
                .call | .method | .variant_case | .array | .map | .try_expr | .error           => is_control @ is_control

            if is_control
                return write_valued(tree, s, head: head, value: e.value, indent: indent)
            return write_valued(tree, s, head: head + "expr ", value: e.value, indent: indent)
        .error => return pad(indent) + head + "error\n"

    return ""

# A statement's head plus its value. Control-flow values carry blocks,
# so they continue on the lines below; everything else fits on this one.
function write_valued(tree: ast.Ast, s: source.Source, head: str, value: i64, indent: i64) -> str
    match tree.exprs[value].kind
        .if_expr ie =>
            out: str @ ""
            index: i64 @ 0

            for branch in ie.branches
                keyword: str @ "else if"
                prefix: str @ ""

                if index == 0
                    keyword @ "if"
                    prefix @ head
                out @ out + pad(indent) + prefix + keyword + " " + render_expr(tree, branch.cond, s) + "\n"
                out @ out + write_block(tree, s, block: branch.block, indent: indent + 2)
                index @ index + 1

            if !ie.otherwise.is_err()
                out @ out + pad(indent) + "else\n"
                out @ out + write_block(tree, s, block: ie.otherwise.must(), indent: indent + 2)
            return out
        .match_expr me =>
            out: str @ pad(indent) + head + "match " + render_expr(tree, me.scrutinee, s) + "\n"

            for arm in me.arms
                patterns: [str] @ []

                for pattern in arm.patterns
                    patterns @ patterns.push(render_pattern(tree, s, pattern: pattern))

                left = patterns.join(" | ")

                match arm.body
                    .one_stmt one =>
                        out @ out + write_stmt(tree, s, id: one.at, indent: indent + 2, head: left + " => ")
                    .block blk =>
                        out @ out + pad(indent + 2) + left + " =>\n"
                        out @ out + write_block(tree, s, block: blk.block, indent: indent + 4)

            return out
        .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => return pad(indent) + head + render_expr(tree, value, s) + "\n"
        .name | .hole | .unary | .binary | .field | .index => return pad(indent) + head + render_expr(tree, value, s) + "\n"
        .call | .method | .variant_case | .array | .map | .try_expr | .error => return pad(indent) + head + render_expr(tree, value, s) + "\n"

    return pad(indent) + head + render_expr(tree, value, s) + "\n"

function render_pattern(tree: ast.Ast, s: source.Source, pattern: ast.Pattern) -> str
    match pattern.kind
        .variant_case vc =>
            if !vc.binding.is_err()
                return "." + source.span_text(s, vc.name) + " " + source.span_text(s, vc.binding.must())
            return "." + source.span_text(s, vc.name)
        .wildcard  => return "_"
        .literal l => return render_expr(tree, l.value, s)
        .error     => return "<?>"

    return "<?>"

function render_expr(tree: ast.Ast, id: i64, s: source.Source) -> str
    node = tree.exprs[id]

    match node.kind
        # Literals and names are their own text: the source is the
        # only place that stores it. An int goes through the same
        # canonicalisation the goldens pin (0xFF -> 0xff).
        .int_lit => return digits.canonical_int(source.span_text(s, node.span))
        .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr | .name => return source.span_text(
            s,
            node.span
        )
        .hole => return "???"
        .unary u =>
            op: str @ "-"

            match u.op
                .neg     => op @ "-"
                .not     => op @ "!"
                .bit_not => op @ "~"

            return "(" + op + render_expr(tree, u.operand, s) + ")"
        .binary b => return "(" + render_expr(tree, b.left, s) + " " + binary_op(b.op) + " " + render_expr(tree, b.right, s) + ")"
        .field f  => return render_expr(tree, f.base, s) + "." + source.span_text(s, f.name)
        .index ix => return render_expr(tree, ix.base, s) + "[" + render_expr(tree, ix.index, s) + "]"
        .call cl  => return render_expr(tree, cl.callee, s) + "(" + render_args(tree, s, given: cl.args) + ")"
        .method m => return render_expr(tree, m.receiver, s) + "." + source.span_text(s, m.name) + "(" + render_args(tree, s, given: m.args) + ")"
        .variant_case vc =>
            if vc.args.len() == 0
                return "." + source.span_text(s, vc.name)
            return "." + source.span_text(s, vc.name) + "(" + render_args(tree, s, given: vc.args) + ")"
        .array arr =>
            rendered: [str] @ []

            for item in arr.elements
                rendered @ rendered.push(render_expr(tree, item, s))

            return "[" + rendered.join(", ") + "]"
        .map mp =>
            rendered: [str] @ []

            for entry in mp.entries
                rendered @ rendered.push(render_expr(tree, entry.key, s) + ": " + render_expr(tree, entry.value, s))

            return "{" + rendered.join(", ") + "}"
        .try_expr t => return render_expr(tree, t.value, s) + "?"
        # Reached only when a control form is nested inside a larger
        # expression; a statement-level one is written by write_valued.

        .if_expr    => return "if …"
        .match_expr => return "match …"
        .error      => return "<?>"

    return "<?>"

function render_args(tree: ast.Ast, s: source.Source, given: [ast.Arg]) -> str
    rendered: [str] @ []

    for arg in given
        name: str @ ""

        if !arg.name.is_err()
            name @ source.span_text(s, arg.name.must()) + ": "
        marker: str @ ""

        if arg.mutable
            marker @ "@"
        rendered @ rendered.push(name + marker + render_expr(tree, arg.value, s))

    return rendered.join(", ")

function binary_op(op: ast.BinaryOp) -> str
    return match op
        .bit_and => "&"
        .bit_or  => "|"
        .bit_xor => "^"
        .shl     => "<<"
        .shr     => ">>"
        .add     => "+"
        .sub     => "-"
        .mul     => "*"
        .div     => "/"
        .rem     => "%"
        .eq      => "=="
        .ne      => "!="
        .lt      => "<"
        .le      => "<="
        .gt      => ">"
        .ge      => ">="
        .and     => "&&"
        .or      => "||"

## Tests

test "the dump proves precedence, labels statements, and keeps control shapes"
    text = "function main()\n    x = 2 + 3 * 4\n    v: i64 @ 0\n    v @ x\n    if v > 10\n        print(v)\n    else\n        print(0)\n    match v\n        11 => print(1)\n        _ =>\n            print(2)\n            print(3)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    body: ast.Block @ ast.Block(span: token.Span(start: 0, end: 0), stmts: [])

    match parsed.decls[0].kind
        .function_decl fd                                          => body @ fd.value.body.must()
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

    got = write_block(parsed.tree, s, block: body, indent: 0)
    expected = "bind x = (2 + (3 * 4))\ndeclare v: i64 @ 0\nmutate v @ x\nif (v > 10)\n  expr print(v)\nelse\n  expr print(0)\nmatch v\n  11 => expr print(1)\n  _ =>\n    expr print(2)\n    expr print(3)\n"
    assert got == expected

test "arguments carry their labels and markers, patterns their bindings"
    text = "variant Shape\n    dot\n    box\n        w: i64\n\nfunction grow(@target: i64, by: i64)\n    target @ target + by\n\nfunction main()\n    v: i64 @ 0\n    grow(target: @v, by: 2)\n    sh: Shape @ .box(w: 3)\n    match sh\n        .dot => print(0)\n        .box b => print(b.w)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    body: ast.Block @ ast.Block(span: token.Span(start: 0, end: 0), stmts: [])

    match parsed.decls[2].kind
        .function_decl fd                                          => body @ fd.value.body.must()
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

    got = write_block(parsed.tree, s, block: body, indent: 0)
    expected = "declare v: i64 @ 0\nexpr grow(target: @v, by: 2)\ndeclare sh: Shape @ .box(w: 3)\nmatch sh\n  .dot => expr print(0)\n  .box b => expr print(b.w)\n"
    assert got == expected
