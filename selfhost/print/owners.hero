# The source's structure that the tree does not keep, read from its tokens
# (design.md §4.15): which lines open a logical line, where each one ends,
# which bracket closes which, and which block owns each comment. `fmt`
# places a comment by it and the output guard checks the placement by it
# (`print/anchors.hero`), so the printer and the guard read one rule.
# Written 2026-09-26 for the last round of defects 099 and 101, where the
# printer asked the page and a line fmt does not track (a `)` alone on its
# line) made a block's last comment leave the block at exit 0.
#
# THE RULE. A logical line starts at a token at bracket depth 0 that is the
# first on its line; a line inside a bracket continues the logical line it
# is in, and never closes a block. A comment with code before it on its line
# TRAILS that code; one inside a bracket is BRACKETED. Any other comment
# sits between two logical lines, the one before it P and the one after N,
# and belongs to a block: of the blocks open there, from N's up to P's
# innermost, the deepest whose indent is at most the comment's column, and
# never one shallower than N's. A run of such comments is read from its
# last one up, so no comment belongs to a shallower block than one after
# it: printed in order, a later comment cannot sit in a deeper block.

use token
use source
use lexer

# A comment with code before it on its line.
constant TRAILS: i64
    -1

# A comment on a line of its own inside a bracket.
constant BRACKETED: i64
    -2

# `code[l]`: line `l` opens a logical line, at `column[l]`, which ends on
# line `last[l]`. `owner[k]` is the depth of the block comment `k` belongs
# to, or TRAILS or BRACKETED, and `prior[k]` the logical line before it, 0
# for none. `tokens` are the file's tokens but its layout and its end, and
# `pair[i]` is the bracket closing or opening token `i`, -1 for none.
record Lines
    tokens: [token.Token]
    pair: [i64]
    code: [bool]
    column: [i64]
    last: [i64]
    owner: [i64]
    prior: [i64]

function none() -> Lines
    return Lines(tokens: [], pair: [], code: [], column: [], last: [], owner: [], prior: [])

# The structure of `text`, whose lines `s` numbers from offset 0. The lines
# in `ignored` are not code: the second head of two groups `fmt` merges,
# which its output does not have.
function read(s: source.Source, text: str, ignored: [i64]) -> Lines
    return shape(s, lexed: lexer.lex_one(text).tokens, ignored: ignored, end: text.len())

# The same, from the tokens the parser was given, those before `end` only:
# the root file's, when the rest of the compilation follows it.
function shape(s: source.Source, lexed: [token.Token], ignored: [i64], end: i64) -> Lines
    # Every array is a local until the end: a push onto a record's field
    # copies the field, and read that way a file of fifty thousand tokens
    # took `fmt` from a third of a second to eight (measured 2026-09-26).
    tokens: [token.Token] @ []
    pair: [i64] @ []

    for t in lexed
        if t.span.start >= end
            break

        if t.kind != .indent && t.kind != .dedent && t.kind != .terminator && t.kind != .eof
            tokens @ tokens.push(t)
            pair @ pair.push(-1)

    code: [bool] @ []
    columns: [i64] @ []
    last: [i64] @ []

    for _ in range(from: 0, to: s.line_starts.len() + 2)
        code @ code.push(false)
        columns @ columns.push(0)
        last @ last.push(0)

    owner: [i64] @ []
    prior: [i64] @ []
    marks: [i64] @ []
    depth: i64 @ 0
    current: i64 @ 0
    previous: i64 @ 0
    pending: [i64] @ []
    open: [i64] @ []
    top: i64 @ 0
    index: i64 @ 0

    for t in tokens
        line = source.floor_start(s.line_starts, t.span.start) + 1
        column = t.span.start - s.line_starts[line - 1]

        if t.kind == .comment
            prior @ prior.push(current)
            marks @ marks.push(column)

            if previous == line
                owner @ owner.push(TRAILS)
            else if depth > 0
                owner @ owner.push(BRACKETED)
            else
                pending @ pending.push(owner.len())
                owner @ owner.push(0)
        else if !listed(ignored, value: line)
            if depth == 0 && line != previous
                settle(
                    owner: @owner,
                    marks: marks,
                    pending: pending,
                    above: columns_of(columns, line: current),
                    below: column
                )
                pending @ []
                code[line] @ true
                columns[line] @ column
                current @ line

            if current > 0
                last[current] @ line
            previous @ line

            if t.kind == .lparen || t.kind == .lbracket || t.kind == .lbrace
                if top < open.len()
                    open[top] @ index
                else
                    open @ open.push(index)
                top @ top + 1
                depth @ depth + 1
            else if (t.kind == .rparen || t.kind == .rbracket || t.kind == .rbrace) && top > 0
                top @ top - 1
                partner = open[top]
                pair[partner] @ index
                pair[index] @ partner
                depth @ depth - 1
        index @ index + 1

    settle(owner: @owner, marks: marks, pending: pending, above: columns_of(columns, line: current), below: -1)
    return Lines(tokens: tokens, pair: pair, code: code, column: columns, last: last, owner: owner, prior: prior)

# The column of code line `line`, -1 for none.
function columns_of(columns: [i64], line: i64) -> i64
    if line <= 0
        return -1
    return columns[line]

# The owners of a run of comments, at the columns in `marks`, between a
# logical line at column `above` and the next, at column `below` (-1 for
# none either side), read from the run's last comment up.
function settle(@owner: [i64], marks: [i64], pending: [i64], above: i64, below: i64)
    low: i64 @ 0
    high: i64 @ 0

    if below >= 0
        low @ below / 4

    if above >= 0
        high @ above / 4

    if high < low
        high @ low
    later: i64 @ 0
    at: i64 @ pending.len() - 1

    while at >= 0
        k = pending[at]
        own: i64 @ marks[k] / 4

        if own > high
            own @ high

        if own < low
            own @ low

        if at < pending.len() - 1 && own < later
            own @ later
        owner[k] @ own
        later @ own
        at @ at - 1

## Questions the printer and the guard ask

# The logical line holding source line `line`: the nearest code line at or
# above it.
function start_of(lines: Lines, line: i64) -> i64
    at: i64 @ line

    while at > 0 && (at >= lines.code.len() || !lines.code[at])
        at @ at - 1

    return at

# The last source line of the logical line holding `line`.
function end_of(lines: Lines, line: i64) -> i64
    at = start_of(lines, line: line)

    if at <= 0 || lines.last[at] < line
        return line
    return lines.last[at]

# The index of the token holding byte `offset`, or of the last one before
# it, -1 when none is.
function index_at(lines: Lines, offset: i64) -> i64
    low: i64 @ 0
    high: i64 @ lines.tokens.len()

    while low < high
        middle = (low + high) / 2

        if lines.tokens[middle].span.start <= offset
            low @ middle + 1
        else
            high @ middle

    return low - 1

# The token before or after token `index` that is not a comment, or -1.
function code_before(lines: Lines, index: i64) -> i64
    at: i64 @ index - 1

    while at >= 0 && lines.tokens[at].kind == .comment
        at @ at - 1

    return at

function code_after(lines: Lines, index: i64) -> i64
    at: i64 @ index + 1

    while at < lines.tokens.len() && lines.tokens[at].kind == .comment
        at @ at + 1

    if at >= lines.tokens.len()
        return -1
    return at

# The author's grouping parentheses around the value at `span`, as the
# token index of each `(`, the innermost first. The tree keeps none, and
# the value's own span holds neither: it can start inside a group of its
# first operand and end inside one of its last, so the innermost pair is
# the first `(` before it, not a call's, whose `)` is past it with only
# other groups' brackets between, and each outer one closes right after the
# one inside it. Read from the lexer's tokens, a literal's brackets are its
# text, a hole's `f"{")"}"` included.
function levels(lines: Lines, span: token.Span) -> [i64]
    out: [i64] @ []
    first = index_at(lines, offset: span.start)
    last = index_at(lines, offset: span.end - 1)

    if first < 0 || last < first
        return out
    open: i64 @ code_before(lines, index: first)

    while open >= 0 && lines.tokens[open].kind == .lparen && !calls(lines, index: open)
        shut = lines.pair[open]

        if shut > last
            at: i64 @ code_after(lines, index: last)

            while at >= 0 && at < shut && lines.tokens[at].kind == .rparen
                at @ code_after(lines, index: at)

            if at != shut
                return out
            out @ out.push(open)

            # The pairs around this one, each closing right after it.
            outer: i64 @ code_before(lines, index: open)

            while outer >= 0 && lines.tokens[outer].kind == .lparen && !calls(lines, index: outer) && lines.pair[outer] == code_after(lines, index: lines.pair[out[out.len() - 1]])
                out @ out.push(outer)
                outer @ code_before(lines, index: outer)

            return out
        open @ code_before(lines, index: open)

    return out

# The offsets of the `(` at token `open` and of its `)`.
function around(lines: Lines, open: i64) -> token.Span
    return token.Span(start: lines.tokens[open].span.start, end: lines.tokens[lines.pair[open]].span.start)

# Does the `(` at token `index` open a call's arguments, a signature's
# parameters or a function type's, which follow a name or a value?
# ENUMERATED, never a catch-all: a kind added later answers here or does
# not compile, and a `_ => false` would take its `(` for a group.
function calls(lines: Lines, index: i64) -> bool
    before = code_before(lines, index: index)

    if before < 0
        return false

    return match lines.tokens[before].kind
        .ident | .int_lit | .float_lit | .str_lit | .str_piece | .char_lit           => true
        .rparen | .rbracket | .rbrace | .question | .hole                            => true
        .kw_true | .kw_false | .kw_nullptr | .kw_function | .kw_fail                 => true
        .kw_constant | .kw_record | .kw_variant | .kw_match | .kw_if | .kw_else      => false
        .kw_for | .kw_while | .kw_in | .kw_break | .kw_continue | .kw_return         => false
        .kw_test | .kw_assert | .kw_extern | .kw_use | .eq | .at | .colon            => false
        .colon_colon | .comma | .dot | .arrow | .fat_arrow | .pipe | .lparen         => false
        .lbracket | .lbrace | .plus | .minus | .star | .slash | .percent | .eq_eq    => false
        .bang_eq | .lt | .le | .gt | .ge | .and_and | .or_or | .bang | .amp | .caret => false
        .tilde | .shl | .shr | .comment | .terminator | .indent | .dedent | .eof     => false
        .error                                                                       => false

function listed(values: [i64], value: i64) -> bool
    for one in values
        if one == value
            return true

    return false

## Tests

# The skeptic seat's `m1` and `s8`: a `)` alone on its line is part of the
# statement it closes, and a run is read from its last comment up.
test "a logical line reaches its closing parenthesis, and a run's owner is no shallower than the comment after it"
    text = "function f(c: bool) -> i64\n    if c\n        print(1)\n#        print(2)\n        # the if block's last word\n    return (1\n    )\n    # the last word of f\n"
    s = source.new_source(name: "t.hero", text: text)
    lines = read(s, text: text, ignored: [])
    assert lines.code[6]
    assert !lines.code[7]
    assert lines.last[6] == 7
    assert end_of(lines, line: 7) == 7
    assert lines.owner[0] == 2
    assert lines.owner[1] == 2
    assert lines.owner[2] == 1
    assert lines.prior[2] == 6

    # The same with CRLF line ends: a `\r` is no code and no column.
    crlf = "function f(c: bool) -> i64\r\n    if c\r\n        print(1)\r\n#        print(2)\r\n        # the if block's last word\r\n    return (1\r\n    )\r\n    # the last word of f\r\n"
    t = source.new_source(name: "t.hero", text: crlf)
    other = read(t, text: crlf, ignored: [])
    assert other.owner == lines.owner
    assert other.prior == lines.prior
    assert other.last[6] == 7

# A comment inside a bracket, one trailing code, and the parentheses of a
# call against a group's, a literal's own brackets being text.
test "a comment's owner says bracket or trails, and a group's parentheses are told from a call's"
    text = "function f(a: i64) -> str\n    x = g(  # trails\n        # in the call\n        a)\n    return (f\"{\")\"}\" +\n        \"b\")\n"
    s = source.new_source(name: "t.hero", text: text)
    lines = read(s, text: text, ignored: [])
    assert lines.owner[0] == TRAILS
    assert lines.owner[1] == BRACKETED
    call = index_at(lines, offset: 35)
    assert lines.tokens[call].kind == .lparen
    assert calls(lines, index: call)
    open = index_at(lines, offset: 91)
    assert lines.tokens[open].kind == .lparen
    assert !calls(lines, index: open)
