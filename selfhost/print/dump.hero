# heroes parse --dump-ast: the tree as text (design.md §3.5, §4.15).
# Port of crates/heroes/src/printer/dump.rs.
#
# Not the formatter — this is the tree SEEN, one node per line, so
# "what the parser understood" is readable without a debugger. Two
# deliberate differences from Heroes source keep the two apart at a
# glance: the dump indents by 2, and it names node kinds (field, case,
# body) no program contains. The format is output surface: goldens
# contain it, so a change to a word here churns them all.
#
# EVERY FIELD OF A DECLKIND IS DESTRUCTURED AND USED HERE (panels 060,
# 061, 062). This module is half of a guard, and the other half lives in
# `syntax_cmds.hero::refuse_output_the_formatter_broke`: it asserts
# dump(text) == dump(fmt(text)) — "fmt changed the tree" — so a field the
# formatter can print and this dump elides is a CANCELLING PAIR, and the
# pair reports GREEN.
#
# **This paragraph described that guard for a week while it did not
# exist** (the port dropped it; restored 2026-08-26, panel 095's
# condition 2). Its first catch was a remark inside a `record` promoted
# to the next field's documentation — output that parses, is a fixpoint,
# and is a different program. If the citation above ever stops naming a
# live function, this comment is a claim about the world that has expired
# (CLAUDE.md §11) and the guard is gone again.
#
# It happened twice in the bootstrap: header/library on a record, then
# partial, both swallowed by a `..`. Heroes has no `..` in patterns —
# the whole payload is bound by name — so the rule the bootstrap needs
# rustc to enforce is this language's default.

use token
use ast
use source
use print/types
use print/bodies
use parse

# The library is part of every compilation and part of no dump: a
# --dump-<stage> answers "what does the compiler know about THE FILE I
# NAMED" (CLAUDE.md §10), and the library is the same in every
# program, so it carries no information about this one.
function dump_ast(tree: ast.Ast, s: source.Source, uses: [ast.Use], decls: [ast.Decl]) -> str
    out: str @ "file " + s.name + "\n"

    for used in uses
        if !source.is_root(s, used.span.start)
            continue

        # The alias too, and it was missing here for the same reason it was
        # missing from the formatter: a `use` line was printed as its NAME.
        # `--dump-ast` is a window onto the tree, so a field the tree carries
        # and the window does not is a window that lies — measured 2026-09-02,
        # `use render/scale as near_scale` dumped as `use render/scale`.
        out @ out + "  use " + source.span_text(s, used.name) + alias_of(s, used: used) + "\n"

    for decl in decls
        if !source.is_root(s, decl.name.start)
            continue
        out @ out + declaration(tree, s, decl: decl)

    return out

function declaration(tree: ast.Ast, s: source.Source, decl: ast.Decl) -> str
    name = source.span_text(s, decl.name)

    match decl.kind
        .constant_decl k =>
            # The group's head line, exactly as a signature carries it:
            # a reader must tell a constant whose value is in a header
            # from one whose value is in this file.
            out: str @ "  " + extern_prefix(s, header: k.header, library: k.library) + "constant " + name + ": " + types.render_type(tree, k.ty, s) + "\n"
            out @ out + docs(s, doc: decl.doc)

            # An extern constant has no body: the value is in the
            # header (§4.19), exactly as an extern function's code is.
            if !k.body.is_err()
                out @ out + bodies.write_block(tree, s, block: k.body.must(), indent: 4)
            return out
        .function_decl fd =>
            out: str @ "  " + signature(tree, s, name: name, f: fd.value) + "\n"
            out @ out + docs(s, doc: decl.doc)

            if !fd.value.body.is_err()
                out @ out + bodies.write_block(tree, s, block: fd.value.body.must(), indent: 4)
            return out
        # partial and the group head appear here because fmt prints
        # them — this arm is where the bootstrap's rule was broken
        # twice: with `..` restored, the dump of a grouped Font and a
        # top-level Font were the same string, and the canonical guard
        # was blind exactly where it was needed.

        .record_decl rec =>
            tag_text: str @ ""

            if !rec.tag.is_err()
                tag_text @ " tag " + source.span_text(s, rec.tag.must())
            marker: str @ ""

            if rec.partial
                marker @ " partial"
            out: str @ "  " + extern_prefix(s, header: rec.header, library: rec.library) + "record " + name + tag_text + marker + "\n"
            out @ out + docs(s, doc: decl.doc)

            for field in rec.fields
                out @ out + field_line(tree, s, field: field, indent: "    ")

            return out
        .variant_decl v =>
            out: str @ "  variant " + name + "\n"
            out @ out + docs(s, doc: decl.doc)

            for one_case in v.cases
                out @ out + case_lines(tree, s, one_case: one_case)

            return out
        .test_decl t =>
            # name is the string literal, quotes included: a title.
            out: str @ "  test " + name + "\n"
            out @ out + docs(s, doc: decl.doc)
            out @ out + bodies.write_block(tree, s, block: t.body, indent: 4)
            return out

    return ""

# `function map<A, B>(xs: [A], f: (function(A) -> B)) -> [B]` — the
# header in one line, which is how a signature is read. It takes the
# FUNCTION, not the declaration's index (panel 062's audit): the old
# index form carried a catch-all arm no caller could reach — a second
# answer to a question nobody asks — and the way to make an
# unreachable case loud is to make it unrepresentable.
function render_signature(tree: ast.Ast, s: source.Source, name: str, f: ast.FunctionDecl) -> str
    return signature(tree, s, name: name, f: f)

# The head line a group's member carries, or nothing. THE GROUP IS NOT
# IN THE TREE, so the dump does not re-group (the parser flattens
# extern into one declaration per signature, each carrying the header
# — §4.19, panel 036); fmt re-groups, because it hands the author
# their own program back. One writer for both member kinds, so a
# constant and a function in one group cannot print it two ways.
function extern_prefix(s: source.Source, header: token.Span?, library: ast.Library?) -> str
    if header.is_err()
        return ""
    out: str @ "extern " + source.span_text(s, header.must())

    if !library.is_err()
        match library.must()
            .link l     => out @ out + " link " + source.span_text(s, l.name)
            .package pk => out @ out + " package " + source.span_text(s, pk.name)
    return out + " "

function signature(tree: ast.Ast, s: source.Source, name: str, f: ast.FunctionDecl) -> str
    out: str @ extern_prefix(s, header: f.header, library: f.library) + "function " + name

    if f.generics.len() > 0
        parts: [str] @ []

        for generic in f.generics
            parts @ parts.push(source.span_text(s, generic))

        out @ out + "<" + parts.join(", ") + ">"
    rendered: [str] @ []

    for param in f.params
        marker: str @ ""

        if param.mutable
            marker @ "@"
        rendered @ rendered.push(
            marker + source.span_text(s, param.name) + ": " + types.render_type(tree, param.ty, s)
        )

    return out + "(" + rendered.join(", ") + ") -> " + types.render_type(tree, f.result, s)

function case_lines(tree: ast.Ast, s: source.Source, one_case: ast.Case) -> str
    out: str @ "    case " + source.span_text(s, one_case.name) + "\n"
    out @ out + docs_at(s, doc: one_case.doc, indent: "      ")

    for field in one_case.fields
        out @ out + field_line(tree, s, field: field, indent: "      ")

    return out

function field_line(tree: ast.Ast, s: source.Source, field: ast.Field, indent: str) -> str
    out: str @ indent + "field " + source.span_text(s, field.name) + ": " + types.render_type(tree, field.ty, s) + "\n"
    out @ out + docs_at(s, doc: field.doc, indent: indent + "  ")
    return out

function docs(s: source.Source, doc: [token.Span]) -> str
    return docs_at(s, doc: doc, indent: "    ")

# Doc comments are printed verbatim, # included: they are markdown,
# and the compiler reuses them in ??? output and outline (§4.1).
function docs_at(s: source.Source, doc: [token.Span], indent: str) -> str
    out: str @ ""

    for span in doc
        out @ out + indent + "doc " + source.span_text(s, span) + "\n"

    return out

# ` as near_scale`, or nothing where the file wrote no alias. The test is the
# one the resolver and the formatter both use: the binding is the path's own
# tail exactly when nobody wrote `as`.
function alias_of(s: source.Source, used: ast.Use) -> str
    if used.binding.end == used.name.end
        return ""
    return " as " + source.span_text(s, used.binding)

## Tests

test "the dump names every field the formatter can print"
    text = "use geom\n\n# A point in the plane.\nrecord Point\n    x: i64\n    y: i64\n\nextern \"raylib.h\" package \"raylib\"\n    record Font tag FontT partial\n        size: i64\n    constant FLAG: i64\n    function draw(f: Font, n: i64)\n\nvariant Shape\n    dot\n    box\n        w: i64\n\nfunction dist<T>(a: T, @b: i64) -> i64\n    b @ b + 1\n    return b\n\ntest \"a title\"\n    assert 1 == 1\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    got = dump_ast(parsed.tree, s, parsed.uses, parsed.decls)
    expected = "file t.hero\n  use geom\n  record Point\n    doc # A point in the plane.\n    field x: i64\n    field y: i64\n  extern \"raylib.h\" package \"raylib\" record Font tag FontT partial\n    field size: i64\n  extern \"raylib.h\" package \"raylib\" constant FLAG: i64\n  extern \"raylib.h\" package \"raylib\" function draw(f: Font, n: i64) -> ()\n  variant Shape\n    case dot\n    case box\n      field w: i64\n  function dist<T>(a: T, @b: i64) -> i64\n    mutate b @ (b + 1)\n    return b\n  test \"a title\"\n    assert (1 == 1)\n"
    assert got == expected
