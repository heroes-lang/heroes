# heroes fmt: the canonical formatter (design.md §4.15; panels 007,
# 014, 018, 036, 038, 040, 060, 061, 062). Port of the fmt knot —
# crates/heroes/src/printer/{fmt,fmt_decl,fmt_extern,fmt_comments,
# fmt_stmt,fmt_expr,fmt_arms,fmt_break,fmt_fits}.rs, nine files as one
# module, because the walk is mutually recursive by construction:
# declaration -> block -> statement -> valued -> block (an if carries
# blocks), valued -> statement (a match arm is a head on a statement),
# and the measurements ask the renderer what a line costs.
#
# THE MAP (CLAUDE.md §11's due for a knot). State: Fmt{out,
# next_comment, last_line}, threaded as the one @ parameter.
# - format_file: item order, top-level blank lines, group runs;
#   entry point, calls declaration.
# - declaration/field_line/case_line + extern_head_once + signature:
#   one item's shape (fmt_decl + fmt_extern).
# - comments_before/trailing_comment: the comment stream (the one
#   thing the tree does not keep — a mistake here is MISSING output).
# - block/statement: the statement walk (fmt_stmt).
# - valued/broken/broken_args: a head plus its value, the WIDTH-column
#   break, match arm layout (fmt_break).
# - block_shape/value_block_shape/comment_waits_before: where the air
#   goes (panel 095). block_shape is a SECOND dispatch over statement
#   and expression kinds and it must agree with statement() and
#   valued() arm for arm — see its own comment.
# - arm_heads/arm_alignment/close_run: where => goes (fmt_arms).
# - fits_on_one_line/spans_lines/literal_end_line: the three
#   measurements (fmt_fits).
# - render/wrapped/power/args_line/arg_text/render_pattern/binary_op:
#   minimum parentheses (fmt_expr).
#
# Three policies, stated because they are choices. Parentheses are
# MINIMAL (2 + (3 * 4) loses them, (2 + 3) * 4 keeps them). Lines break
# at WIDTH and only inside brackets (panel 007 allows no other
# continuation); WIDTH is 120 since 2026-08-28, 88 before that.
#
# And BLANK LINES ARE STRUCTURE AS WELL AS CONTENT, which reverses half
# of what this paragraph said until panel 095. A single blank the author
# wrote inside a body still survives, and one always separates top-level
# declarations — that is the content half, unchanged. What is new is that
# the formatter INSERTS them: before a for/while/if/match, after a loop
# or match block closes (never an `if` — the narrowing is the panel's,
# and its reason is at the call site), and above a comment run inside a
# statement body. Never two in a row, which blank_line() has always
# enforced at the primitive rather than at the call sites, so the
# insertions cannot double up on each other or on the author's own.
#
# The rule that did NOT land is worth recording because no seat defended
# it: a blank before the `return` that closes a function. Rule 2 already
# owes that blank whenever a block just closed, so it would have taught a
# reading it does not support.
#
# Port note: the bootstrap keys a group run on (header text, library
# NAME text), losing the link/package word its own comment says makes
# two groups two; the port keys on the whole head line's text, which
# is the comment's claim implemented.

use token
use ast
use source
use digits
use print/types
use print/bodies
use parse

# Where a line stops being one line. Not a language rule — one
# constant, and the only thing that decides single- versus multi-line
# literals (§4.9 leaves the choice to the formatter on purpose).
#
# 88 until 2026-08-28, then 120 by author instruction. The 88 was never
# adjudicated either — `DESIGN-LOG:46` fixed it with `—` in the panel
# column, and panel 007 ruled on WHERE a line may break (inside brackets
# only), never on how wide. What the number buys is measured in the
# commit that moved it: at 88 the canonical form of `selfhost/` was
# +19.7% longer than the source, and the breaking is what made a run of
# match arms stop being a run — every non-fixpoint in defect 004 (docs/work/DONE.md)
# began with a line this constant decided to break.
constant WIDTH: i64
    120

## The state

record Fmt
    out: str
    next_comment: i64
    last_line: i64

function put_line(@f: Fmt, indent: i64, text: str)
    if text.len() > 0
        f.out @ f.out + " ".repeat(indent.to_u64().must()) + text
    f.out @ f.out + "\n"

function blank_line(@f: Fmt)
    if f.out.len() == 0
        return
    n = f.out.len()

    if n >= 2 && f.out.slice(from: n - 2, to: n) == "\n\n"
        return
    f.out @ f.out + "\n"

## Comments — the one thing the tree does not keep

# Print every comment above source line `line`, at indent, preserving
# a single blank line wherever the source had one.
function comments_before(@f: Fmt, s: source.Source, comments: [token.Span], line: i64, indent: i64)
    while f.next_comment < comments.len()
        span = comments[f.next_comment]
        comment_line = source.line_of(s, span.start)

        if comment_line >= line
            return

        if f.last_line > 0 && comment_line > f.last_line + 1
            blank_line(@f)
        put_line(@f, indent: indent, text: trim_end(source.span_text(s, span)))
        f.last_line @ comment_line
        f.next_comment @ f.next_comment + 1

# A comment on the same line as what was just printed goes at the end
# of that line, two spaces out.
function trailing_comment(@f: Fmt, s: source.Source, comments: [token.Span], line: i64)
    if f.next_comment >= comments.len()
        return
    span = comments[f.next_comment]

    if source.line_of(s, span.start) != line
        return
    text = trim_end(source.span_text(s, span))
    n = f.out.len()

    if n > 0 && f.out.slice(from: n - 1, to: n) == "\n"
        f.out @ f.out.slice(from: 0, to: n - 1)
    f.out @ f.out + "  " + text + "\n"
    f.next_comment @ f.next_comment + 1

function trim_end(text: str) -> str
    cs = text.chars()
    end: i64 @ cs.len()

    while end > 0 && (cs[end - 1] == " " || cs[end - 1] == "\t")
        end @ end - 1

    return cs.slice(from: 0, to: end).join("")

function pad_right(text: str, width: i64) -> str
    grown: str @ text
    count: i64 @ text.chars().len()

    while count < width
        grown @ grown + " "
        count @ count + 1

    return grown

## The file as a whole

record Item
    start: i64
    is_use: bool
    at: i64

# Canonical Heroes source for a parsed file. Callers must check that
# the file had no diagnostics first: formatting a tree built out of
# recovery guesses would rewrite the author's file into the parser's
# guess. SOURCE ORDER, never a canonical order: reordering is where a
# formatter starts deleting the author's remarks — gofmt sorts imports
# and can afford to, it has a comment model this one does not.
function format_file(tree: ast.Ast, s: source.Source, all_comments: [token.Span], uses: [ast.Use], decls: [ast.Decl]) -> str
    f: Fmt @ Fmt(out: "", next_comment: 0, last_line: 0)

    # The library's comments go with its declarations, and the
    # author's declarations, never the library's: with --in-place a
    # formatter that walked the whole Source would append the library
    # to their file, once per run (§1.11).
    comments: [token.Span] @ []

    for c in all_comments
        if source.is_root(s, c.start)
            comments @ comments.push(c)

    items: [Item] @ []
    index: i64 @ 0

    for used in uses
        if source.is_root(s, used.span.start)
            items @ items.push(Item(start: used.span.start, is_use: true, at: index))
        index @ index + 1

    index @ 0

    for decl in decls
        start = decl_start(decl)

        if source.is_root(s, start)
            items @ items.push(Item(start: start, is_use: false, at: index))
        index @ index + 1

    items @ sorted_items(items)

    # The extern group, rebuilt: the parser flattened it (§4.19, panel
    # 036), so the canonical form is a run of consecutive members
    # sharing a head line — the only rule that survives fmt(fmt(x)) ==
    # fmt(x).
    open_group: str @ ""
    have_previous: bool @ false
    previous_was_use: bool @ false

    for item in items
        line: i64 @ source.line_of(s, item.start)
        group: str @ ""

        if !item.is_use
            group @ group_key(s, decl: decls[item.at])
        continues = group.len() > 0 && group == open_group
        open_group @ group

        # A group's first member prints under a head line the member's
        # own span does not contain, so the line every comment and
        # blank-line rule keys on is the HEAD's (§4.1: without this,
        # fmt inserted a blank line the author had not written).
        if !item.is_use && !continues
            head_span = extern_header_span(decls[item.at])

            if !head_span.is_err()
                line @ source.line_of(s, head_span.must().start)

        # One blank line between top-level declarations — but not
        # between two use lines, which are a block the way a run of
        # fields is.
        after_use = previous_was_use

        if have_previous
            run = previous_was_use && item.is_use || continues

            if !run
                blank_line(@f)
        have_previous @ true
        previous_was_use @ item.is_use
        indent_for_comments: i64 @ 0

        if continues
            indent_for_comments @ 4
        comments_before(@f, s, comments, line: line, indent: indent_for_comments)

        if item.is_use
            # §4.1 and it is the file header that needs it: a blank
            # line between a comment and the first use is what makes
            # that comment a remark about the file instead of
            # documentation for the line under it.
            if !after_use && f.last_line > 0 && line > f.last_line + 1
                blank_line(@f)
            put_line(@f, indent: 0, text: use_line(s, used: uses[item.at]))
            f.last_line @ line
            trailing_comment(@f, s, comments, line: line)
        else

            # A blank line between the comment group and this
            # declaration is preserved exactly: it makes those
            # comments ordinary remarks rather than documentation
            # (§4.1) — for the first declaration too, where a file's
            # header block lives.
            if f.last_line > 0 && line > f.last_line + 1 && !continues
                blank_line(@f)
            declaration(@f, tree, s, comments, decl: decls[item.at], continues: continues)

    # Comments after the last declaration still belong to the file.
    comments_before(@f, s, comments, line: 4611686018427387904, indent: 0)
    return f.out

function sorted_items(items: [Item]) -> [Item]
    out: [Item] @ []

    for item in items
        at: i64 @ out.len()
        probe: i64 @ 0
        placed: bool @ false

        for old in out
            if !placed && old.start > item.start
                at @ probe
                placed @ true
            probe @ probe + 1

        head: [Item] @ out.slice(from: 0, to: at)
        head @ head.push(item)

        for one in out.slice(from: at, to: out.len())
            head @ head.push(one)

        out @ head

    return out

# The offset a declaration starts at: its kind keyword, which sits
# before the name the tree carries (panel 018).
function decl_start(decl: ast.Decl) -> i64
    if decl.span.start < decl.name.start
        return decl.span.start
    return decl.name.start

# `use geom` and `use render/scale as near_scale` — the whole line, alias and
# all.
#
# **THE ALIAS WAS DROPPED HERE FOR ONE COMMIT AND IT CHANGED A PROGRAM'S
# MEANING** (found 2026-09-02 by the corpus, hours after `as` landed). This
# printed `"use " + name`, so `heroes fmt --in-place` deleted `as near_scale`
# from `examples/shapes/main.hero` and the next build could not find the
# module. design.md §4.15 is what makes that the worst possible defect in this
# file: the canonical formatter exists so that *"any textual difference between
# two versions is SEMANTIC"*, and this one silently made a semantic difference
# of its own.
#
# The test for an alias is the same fact-about-the-value the resolver uses: the
# binding is the path's own tail exactly when nobody wrote `as`, so its `end`
# is the path's `end`.
function use_line(s: source.Source, used: ast.Use) -> str
    named = source.span_text(s, used.name)

    if used.binding.end == used.name.end
        return "use " + named
    return "use " + named + " as " + source.span_text(s, used.binding)

## The extern group, rebuilt (fmt_extern)

# `extern "sqlite3.h" link "sqlite3"` — the head line, rebuilt from
# any one member, since every member carries both spans (§4.19). The
# word is chosen by the kind, so a package group cannot be printed
# back as a link one — which would be fmt changing what the program
# asks the machine.
function extern_head(s: source.Source, header: token.Span, library: ast.Library?) -> str
    out: str @ "extern " + source.span_text(s, header)

    if !library.is_err()
        match library.must()
            .link l     => out @ out + " link " + source.span_text(s, l.name)
            .package pk => out @ out + " package " + source.span_text(s, pk.name)
    return out

# The two spans a group's members all carry, whatever kind of member
# they are. ENUMERATED, NEVER a catch-all (panel 060, measured before
# reasoned): a `_ => none` arm answered "not in a group" the moment
# record became a member, and fmt HOISTED IT TO THE TOP LEVEL — a
# different program that still parses, the worst shape a formatter's
# bug can take.
record ExternSpans
    header: token.Span?
    library: ast.Library?

function extern_spans(decl: ast.Decl) -> ExternSpans
    none_h: token.Span? = fail("none", "no header")
    none_l: ast.Library? = fail("none", "no library")

    match decl.kind
        .function_decl fd => return ExternSpans(header: fd.value.header, library: fd.value.library)
        .constant_decl k  => return ExternSpans(header: k.header, library: k.library)
        .record_decl rec  => return ExternSpans(header: rec.header, library: rec.library)
        # A variant is not a C type and a test is not a declaration a
        # header can make — refused in the parser, stated here.

        .variant_decl | .test_decl => return ExternSpans(header: none_h, library: none_l)

    return ExternSpans(header: none_h, library: none_l)

# The group key: the whole head line's text, so two groups that differ
# only in link versus package are two groups — which they are. "" for
# a declaration outside any group.
function group_key(s: source.Source, decl: ast.Decl) -> str
    spans = extern_spans(decl)

    if spans.header.is_err()
        return ""
    return extern_head(s, header: spans.header.must(), library: spans.library)

function extern_header_span(decl: ast.Decl) -> token.Span?
    return extern_spans(decl).header

# The group's head line, printed by its FIRST member only, and the
# indent every member takes. The first member's own comments are
# flushed here, after the head: the caller keys every comment rule on
# the head's line, so a comment between the head and the first member
# would otherwise belong to neither (panel 038's compiler-engineer).
function extern_head_once(@f: Fmt, s: source.Source, comments: [token.Span], decl: ast.Decl, header: token.Span?, library: ast.Library?, continues: bool) -> i64
    if header.is_err()
        return 0

    if !continues
        put_line(@f, indent: 0, text: extern_head(s, header: header.must(), library: library))
        f.last_line @ source.line_of(s, header.must().start)
        comments_before(@f, s, comments, line: source.line_of(s, decl.name.start), indent: 4)
    return 4

## One declaration (fmt_decl)

function declaration(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], decl: ast.Decl, continues: bool)
    name = source.span_text(s, decl.name)
    line = source.line_of(s, decl.name.start)

    match decl.kind
        .constant_decl k =>
            indent = extern_head_once(
                @f,
                s,
                comments,
                decl: decl,
                header: k.header,
                library: k.library,
                continues: continues
            )
            put_line(@f, indent: indent, text: "constant " + name + ": " + types.render_type(tree, k.ty, s))
            f.last_line @ line
            trailing_comment(@f, s, comments, line: line)

            if !k.body.is_err()
                fmt_block(@f, tree, s, comments, block: k.body.must(), indent: 4)
        .function_decl fd =>
            indent = extern_head_once(
                @f,
                s,
                comments,
                decl: decl,
                header: fd.value.header,
                library: fd.value.library,
                continues: continues
            )
            put_line(@f, indent: indent, text: signature(tree, s, name: name, fd: fd.value))
            f.last_line @ line
            trailing_comment(@f, s, comments, line: line)

            if !fd.value.body.is_err()
                fmt_block(@f, tree, s, comments, block: fd.value.body.must(), indent: 4)
        # A record prints exactly like the other two group members;
        # printing it at 0 unconditionally is what hoisted it out of
        # its group (panel 060 condition 1). partial IS printed (panel
        # 061: without it fmt emitted a DIFFERENT PROGRAM that still
        # parses and now constructs), and tag one marker later, for
        # the same reason.

        .record_decl rec =>
            indent = extern_head_once(
                @f,
                s,
                comments,
                decl: decl,
                header: rec.header,
                library: rec.library,
                continues: continues
            )
            tag_text: str @ ""

            if !rec.tag.is_err()
                tag_text @ " tag " + source.span_text(s, rec.tag.must())
            marker: str @ ""

            if rec.partial
                marker @ " partial"
            put_line(@f, indent: indent, text: "record " + name + tag_text + marker)
            f.last_line @ line
            trailing_comment(@f, s, comments, line: line)

            for field in rec.fields
                field_line(@f, tree, s, comments, field: field, indent: indent + 4)
        .variant_decl v =>
            put_line(@f, indent: 0, text: "variant " + name)
            f.last_line @ line

            for one_case in v.cases
                case_line(@f, tree, s, comments, one_case: one_case)
        .test_decl t =>
            # The name is the string literal, quotes included.
            put_line(@f, indent: 0, text: "test " + name)
            f.last_line @ line
            trailing_comment(@f, s, comments, line: line)
            fmt_block(@f, tree, s, comments, block: t.body, indent: 4)

function field_line(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], field: ast.Field, indent: i64)
    line = source.line_of(s, field.name.start)
    comments_before(@f, s, comments, line: line, indent: indent)

    # §4.1's DISCRIMINATOR, and this is the one blank line in the language
    # that carries MEANING rather than layout: a comment directly above a
    # field IS that field's documentation, and a blank line between them
    # makes it an ordinary remark. `cursor.hero:194-220`'s `take_docs`
    # implements it — `above != wanted` ends the run — and the compiler
    # reuses doc comments in `???` output, error messages and `outline`.
    #
    # Deleting that blank PROMOTED a remark to documentation: a different
    # program that parses and is a fixpoint, which is why only the tree
    # guard saw it (defect 004 (docs/work/DONE.md) § What is still owed, found by panel
    # 095's compiler-engineer). The same test as `fmt_block` uses between
    # two statements, for the same reason — the layout the author chose is
    # content — and here it is content the CHECKER reads.
    if f.last_line > 0 && line > f.last_line + 1
        blank_line(@f)
    put_line(
        @f,
        indent: indent,
        text: source.span_text(s, field.name) + ": " + types.render_type(tree, field.ty, s)
    )
    f.last_line @ line
    trailing_comment(@f, s, comments, line: line)

function case_line(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], one_case: ast.Case)
    line = source.line_of(s, one_case.name.start)
    comments_before(@f, s, comments, line: line, indent: 4)

    # The same §4.1 discriminator `field_line` carries, and here because a
    # variant case takes a doc comment too (`dump.hero`'s
    # `case_lines` prints one). This is the ADJACENT SHAPE of
    # defect 004 (docs/work/DONE.md)'s repair, fixed with it rather than after it —
    # CLAUDE.md §1's fourth rule: the provoking case is a witness and a
    # `record` field and a `variant` case are the same witness twice.
    if f.last_line > 0 && line > f.last_line + 1
        blank_line(@f)
    put_line(@f, indent: 4, text: source.span_text(s, one_case.name))
    f.last_line @ line
    trailing_comment(@f, s, comments, line: line)

    for field in one_case.fields
        field_line(@f, tree, s, comments, field: field, indent: 8)

# `-> ()` is never printed: a function that returns nothing writes no
# arrow (§4.2's function main()), so the canonical form has one
# spelling.
function signature(tree: ast.Ast, s: source.Source, name: str, fd: ast.FunctionDecl) -> str
    out: str @ "function " + name

    if fd.generics.len() > 0
        parts: [str] @ []

        for generic in fd.generics
            parts @ parts.push(source.span_text(s, generic))

        out @ out + "<" + parts.join(", ") + ">"
    rendered: [str] @ []

    for param in fd.params
        marker: str @ ""

        if param.mutable
            marker @ "@"
        rendered @ rendered.push(
            marker + source.span_text(s, param.name) + ": " + types.render_type(tree, param.ty, s)
        )

    out @ out + "(" + rendered.join(", ") + ")"
    result = types.render_type(tree, fd.result, s)

    if result != "()"
        out @ out + " -> " + result
    return out

## The statement walk (fmt_stmt)

## Structure as air (panel 095)

# What kind of block a statement opens, or NO_BLOCK. The three rules that
# insert vertical space all read this one dispatch.
constant NO_BLOCK: i64
    0

constant LOOP_BLOCK: i64
    1

constant MATCH_BLOCK: i64
    2

constant IF_BLOCK: i64
    3

# THIS MUST AGREE WITH `statement()` AND `valued()` ARM FOR ARM, and that
# obligation is the whole risk of this function. It is a SECOND dispatch
# over the same two kinds, and defect 003 (docs/work/DONE.md) is what a second dispatch
# that disagrees costs: `valued` knew a control form can sit at a
# binary's right edge, `render` did not, and seven arms were deleted at
# exit 0. `a_block_opener_is_what_valued_prints_a_block_for` is the test
# that fires when the two drift.
function block_shape(tree: ast.Ast, id: i64) -> i64
    match tree.stmts[id].kind
        .while_stmt | .for_in => return LOOP_BLOCK
        .bind b               => return value_block_shape(tree, id: b.value)
        .declare dc           => return value_block_shape(tree, id: dc.value)
        .mutate m             => return value_block_shape(tree, id: m.value)
        .assert_stmt a        => return value_block_shape(tree, id: a.value)
        .expr_stmt e          => return value_block_shape(tree, id: e.value)
        .return_stmt r =>
            if r.value.is_err()
                return NO_BLOCK
            return value_block_shape(tree, id: r.value.must())
        .break_stmt | .continue_stmt | .error => return NO_BLOCK

    return NO_BLOCK

# The value half, and it is `valued()`'s own dispatch: a control form, or
# a binary whose right edge is one.
function value_block_shape(tree: ast.Ast, id: i64) -> i64
    match tree.exprs[id].kind
        .if_expr    => return IF_BLOCK
        .match_expr => return MATCH_BLOCK
        .binary =>
            tail = binary_control_tail(tree, id: id)

            if tail.is_err()
                return NO_BLOCK
            return value_block_shape(tree, id: tail.must())
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return NO_BLOCK
        .name | .hole | .unary | .field | .index                             => return NO_BLOCK
        .call | .method | .variant_case | .array | .map | .try_expr | .error => return NO_BLOCK

    return NO_BLOCK

# Is a comment waiting to be printed above `line`? RULE 4 puts its blank
# ABOVE the comment, and `comments_before` has already printed the
# comment by the time it could say so — hence the peek.
function comment_waits_before(f: Fmt, s: source.Source, comments: [token.Span], line: i64) -> bool
    if f.next_comment >= comments.len()
        return false
    return source.line_of(s, comments[f.next_comment].start) < line

function fmt_block(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], block: ast.Block, indent: i64)
    first: bool @ true

    # RULE 2's state, and it is the only new state the air rules need: a
    # loop or match block just closed, so the next statement resumes at
    # the outer level and takes air above it. Nothing to thread through
    # the knot — the transition is observable right here, in the parent's
    # own loop.
    closed_a_loop: bool @ false

    for id in block.stmts
        stmt = tree.stmts[id]
        line = source.line_of(s, stmt.span.start)
        shape = block_shape(tree, id: id)

        # RULE 2, NARROWED to a loop or a match and never an `if` (panel
        # 095, the llm-ergonomist, measured): 7 of the 8 block-close
        # blanks in its sample were an `if`'s dedent that STAYS inside
        # the loop and the 8th was the one that leaves it, so thirteen
        # readings out of fourteen taught "back one level" and the
        # fourteenth — the only one whose wrong answer compiles — was the
        # exception. Fewer marks, each carrying more.
        if closed_a_loop
            blank_line(@f)

        # RULE 1: air before a form that opens a block, `if` included.
        # Never before the FIRST statement, which `first` already carries
        # below for the author's own blank and for the same reason: a
        # block does not open on an empty line.
        if !first && shape != NO_BLOCK
            blank_line(@f)

        # RULE 4: air above a comment run, and nothing between the
        # comment and what it documents. Statement bodies only — a
        # `record`, `variant` or `extern` body is reached by other
        # callers of comments_before, and design.md §4.1 makes the blank
        # BELOW a comment there the difference between a remark and that
        # field's documentation (defect 004 (docs/work/DONE.md) § What is still owed).
        if !first && comment_waits_before(f, s, comments, line: line)
            blank_line(@f)
        comments_before(@f, s, comments, line: line, indent: indent)

        # A blank line the author left between two statements survives
        # — never before the FIRST statement: a block does not open on
        # an empty line.
        if !first && f.last_line > 0 && line > f.last_line + 1
            blank_line(@f)
        first @ false
        statement(@f, tree, s, comments, id: id, indent: indent, head: "")

        # A statement that carried a block has already moved last_line
        # past its own body; one that did not ends where it started —
        # UNLESS its value is a literal written down the page. The
        # statement's own span must not answer this: it ends at a
        # Dedent on the NEXT line, and trusting it made
        # trailing_comment steal the following declaration's doc.
        end = literal_end_line(tree, s, id: id)
        stop: i64 @ line

        if !end.is_err()
            stop @ end.must()

        if f.last_line < stop
            f.last_line @ stop
        trailing_comment(@f, s, comments, line: f.last_line)
        closed_a_loop @ shape == LOOP_BLOCK || shape == MATCH_BLOCK

# One statement, optionally behind a head. A match arm passes its
# patterns as the head, which routes an arm whose body is an if
# through valued() — the path that knows how to print a block under a
# control head (panel 014: the separate path printed `.a => if c` and
# DROPPED THE BRANCHES).
function statement(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], id: i64, indent: i64, head: str)
    match tree.stmts[id].kind
        .bind b =>
            annotation: str @ ""

            if !b.ty.is_err()
                annotation @ ": " + types.render_type(tree, b.ty.must(), s)
            valued(
                @f,
                tree,
                s,
                comments,
                head: head + source.span_text(s, b.name) + annotation + " = ",
                value: b.value,
                indent: indent
            )
        .declare dc =>
            valued(
                @f,
                tree,
                s,
                comments,
                head: head + source.span_text(s, dc.name) + ": " + types.render_type(tree, dc.ty, s) + " @ ",
                value: dc.value,
                indent: indent
            )
        .mutate m =>
            valued(
                @f,
                tree,
                s,
                comments,
                head: head + render(tree, s, id: m.place) + " @ ",
                value: m.value,
                indent: indent
            )
        .return_stmt r =>
            if r.value.is_err()
                put_line(@f, indent: indent, text: head + "return")
            else
                valued(@f, tree, s, comments, head: head + "return ", value: r.value.must(), indent: indent)
        .break_stmt    => put_line(@f, indent: indent, text: head + "break")
        .continue_stmt => put_line(@f, indent: indent, text: head + "continue")
        .assert_stmt a =>
            valued(@f, tree, s, comments, head: head + "assert ", value: a.value, indent: indent)
        .while_stmt w =>
            put_line(@f, indent: indent, text: head + "while " + render(tree, s, id: w.cond))
            f.last_line @ source.line_of(s, tree.exprs[w.cond].span.end)
            fmt_block(@f, tree, s, comments, block: w.block, indent: indent + 4)
        .for_in fo =>
            put_line(
                @f,
                indent: indent,
                text: head + "for " + source.span_text(s, fo.name) + " in " + render(tree, s, id: fo.iterable)
            )
            f.last_line @ source.line_of(s, tree.exprs[fo.iterable].span.end)
            fmt_block(@f, tree, s, comments, block: fo.block, indent: indent + 4)
        .expr_stmt e =>
            valued(@f, tree, s, comments, head: head, value: e.value, indent: indent)
        # Unreachable: fmt refuses a file with diagnostics.

        .error => put_line(@f, indent: indent, text: "???")

## A head plus its value (fmt_break)

# On one line when it fits, broken inside its outermost bracket when
# it does not, continued below when the value is an if or a match.
function valued(@f: Fmt, tree: ast.Ast, s: source.Source, comments: [token.Span], head: str, value: i64, indent: i64)
    match tree.exprs[value].kind
        .if_expr ie =>
            index: i64 @ 0

            for branch in ie.branches
                keyword: str @ "else "

                if index == 0
                    keyword @ head
                put_line(@f, indent: indent, text: keyword + "if " + render(tree, s, id: branch.cond))
                f.last_line @ source.line_of(s, tree.exprs[branch.cond].span.end)
                fmt_block(@f, tree, s, comments, block: branch.block, indent: indent + 4)
                index @ index + 1

            if !ie.otherwise.is_err()
                put_line(@f, indent: indent, text: "else")
                fmt_block(@f, tree, s, comments, block: ie.otherwise.must(), indent: indent + 4)
        .match_expr me =>
            put_line(@f, indent: indent, text: head + "match " + render(tree, s, id: me.scrutinee))
            f.last_line @ source.line_of(s, tree.exprs[me.scrutinee].span.end)
            lefts = arm_heads(tree, s, arms: me.arms)
            pads = arm_alignment(tree, s, arms: me.arms, lefts: lefts, indent: indent + 4)

            # A blank line between arms is content, exactly as between
            # statements — it stops the alignment run, so deleting it
            # would contradict the padding computed above. Tracked
            # against where the previous arm ENDED: an inline arm body
            # can be an if with two blocks under it, five lines long
            # while its head is one.
            previous_end: i64 @ -1
            index: i64 @ 0

            for arm in me.arms
                left = lefts[index]
                line = source.line_of(s, arm.span.start)
                comments_before(@f, s, comments, line: line, indent: indent + 4)

                if previous_end >= 0 && line > previous_end + 1
                    blank_line(@f)
                arm_end: i64 @ arm.span.end - 1

                if arm_end < 0
                    arm_end @ 0
                previous_end @ source.line_of(s, arm_end)

                match arm.body
                    .one_stmt one =>
                        statement(
                            @f,
                            tree,
                            s,
                            comments,
                            id: one.at,
                            indent: indent + 4,
                            head: pad_right(left, width: pads[index]) + " => "
                        )

                        # Not `arm.span.end`: it reaches the terminator,
                        # and one line too far made trailing_comment
                        # steal the next declaration's doc comment. Not
                        # `line` alone either — a value THIS FORMATTER
                        # broke across lines occupies them, and stopping
                        # short grew a blank line on every re-format
                        # (defect 004, `docs/work/DONE.md`). The value's own extent is
                        # the question, and fmt_block already asks it.
                        f.last_line @ line
                        spread = literal_end_line(tree, s, id: one.at)

                        if !spread.is_err() && spread.must() > f.last_line
                            f.last_line @ spread.must()
                        trailing_comment(@f, s, comments, line: f.last_line)
                    .block blk =>
                        # A block arm never pads: its => ends the
                        # line, so there is nothing to line up with.
                        put_line(@f, indent: indent + 4, text: left + " =>")
                        f.last_line @ line
                        fmt_block(@f, tree, s, comments, block: blk.block, indent: indent + 8)

                index @ index + 1
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => plain_valued(
            @f,
            tree,
            s,
            head: head,
            value: value,
            indent: indent
        )
        # A binary whose RIGHT EDGE is a control form is a head plus a
        # block, not a line. Routed on through plain_valued it reached
        # render(), which returns a control form's header alone — and the
        # body was gone. See binary_control_tail for the defect.

        .binary =>
            tail = binary_control_tail(tree, id: value)

            if tail.is_err()
                plain_valued(@f, tree, s, head: head, value: value, indent: indent)
            else
                valued(
                    @f,
                    tree,
                    s,
                    comments,
                    head: head + binary_prefix(tree, s, id: value),
                    value: tail.must(),
                    indent: indent
                )
        .name | .hole | .unary | .field | .index => plain_valued(@f, tree, s, head: head, value: value, indent: indent)
        .call | .method | .variant_case | .array | .map | .try_expr | .error => plain_valued(
            @f,
            tree,
            s,
            head: head,
            value: value,
            indent: indent
        )

function plain_valued(@f: Fmt, tree: ast.Ast, s: source.Source, head: str, value: i64, indent: i64)
    text = head + render(tree, s, id: value)

    if indent + text.chars().len() <= WIDTH && !spans_lines(tree, s, value: value)
        put_line(@f, indent: indent, text: text)
        return
    broken(@f, tree, s, head: head, value: value, indent: indent)

# The too-long case. Only the OUTERMOST bracket of the value is opened
# up; if the value has none, the line stays long — panel 007 leaves
# nowhere else to break it, and a formatter that invents a
# continuation invents one the language does not have.
function broken(@f: Fmt, tree: ast.Ast, s: source.Source, head: str, value: i64, indent: i64)
    match tree.exprs[value].kind
        # §4.9: a multi-line list separates by newline, not by comma.
        .array arr =>
            put_line(@f, indent: indent, text: head + "[")

            for item in arr.elements
                put_line(@f, indent: indent + 4, text: render(tree, s, id: item))

            put_line(@f, indent: indent, text: "]")
        .map mp =>
            put_line(@f, indent: indent, text: head + "{")

            for entry in mp.entries
                put_line(
                    @f,
                    indent: indent + 4,
                    text: render(tree, s, id: entry.key) + ": " + render(tree, s, id: entry.value)
                )

            put_line(@f, indent: indent, text: "}")
        # A call keeps its commas: §4.9's newline rule is about
        # literals, and a call written across lines is still a
        # comma-separated list (the parser requires it).

        .call cl =>
            broken_args(@f, tree, s, open: head + render(tree, s, id: cl.callee) + "(", given: cl.args, indent: indent)
        .method m =>
            broken_args(
                @f,
                tree,
                s,
                open: head + render(tree, s, id: m.receiver) + "." + source.span_text(s, m.name) + "(",
                given: m.args,
                indent: indent
            )
        .variant_case vc =>
            if vc.args.len() > 0
                broken_args(
                    @f,
                    tree,
                    s,
                    open: head + "." + source.span_text(s, vc.name) + "(",
                    given: vc.args,
                    indent: indent
                )
            else
                put_line(@f, indent: indent, text: head + render(tree, s, id: value))
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => put_line(
            @f,
            indent: indent,
            text: head + render(tree, s, id: value)
        )
        # A binary reaching here is control-free: valued() intercepts one
        # whose right edge is a control form before this path is taken.

        .name | .hole | .unary | .binary | .field | .index => put_line(
            @f,
            indent: indent,
            text: head + render(tree, s, id: value)
        )
        .if_expr | .match_expr | .try_expr | .error => put_line(
            @f,
            indent: indent,
            text: head + render(tree, s, id: value)
        )

# The control form at the right edge of a chain of binary operators, if
# there is one.
#
# THE INVARIANT: render() returns a control form's HEADER ONLY, and owes
# the blocks to valued(). That obligation held for a value that IS a
# control form and not for one that CONTAINS it — which deleted seven
# arms out of digits.hero at exit 0 (defect 003, `docs/work/DONE.md`). A control form
# runs to the end of its line and carries its block indented below, so
# it can only ever be the RIGHTMOST operand: that is what makes the rest
# of the expression printable as a head.
function binary_control_tail(tree: ast.Ast, id: i64) -> i64?
    match tree.exprs[id].kind
        .if_expr | .match_expr => return ok(id)
        .binary b              => return binary_control_tail(tree, id: b.right)
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return fail(
            "none",
            "not a control form"
        )
        .name | .hole | .unary | .field | .index => return fail("none", "not a control form")
        .call | .method | .variant_case | .array | .map | .try_expr | .error => return fail(
            "none",
            "not a control form"
        )

    return fail("none", "not a control form")

# Everything to the LEFT of that control form, rendered as the head it
# is printed under. Parenthesised exactly as render() would, so the
# minimum-parentheses table holds on this path too.
function binary_prefix(tree: ast.Ast, s: source.Source, id: i64) -> str
    match tree.exprs[id].kind
        .binary b =>
            mine = power(tree, id)
            return wrapped(tree, s, id: b.left, needed: mine) + " " + bodies.binary_op(b.op) + " " + binary_prefix(tree, s, id: b.right)
        .if_expr | .match_expr                                               => return ""
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return ""
        .name | .hole | .unary | .field | .index                             => return ""
        .call | .method | .variant_case | .array | .map | .try_expr | .error => return ""

    return ""

function broken_args(@f: Fmt, tree: ast.Ast, s: source.Source, open: str, given: [ast.Arg], indent: i64)
    put_line(@f, indent: indent, text: open)
    index: i64 @ 0

    for arg in given
        comma: str @ ","

        if index == given.len() - 1
            comma @ ""
        put_line(@f, indent: indent + 4, text: arg_text(tree, s, arg: arg) + comma)
        index @ index + 1

    put_line(@f, indent: indent, text: ")")

## Where => goes (fmt_arms)

# The left side of every arm — its patterns, joined by |.
function arm_heads(tree: ast.Ast, s: source.Source, arms: [ast.Arm]) -> [str]
    out: [str] @ []

    for arm in arms
        patterns: [str] @ []

        for pattern in arm.patterns
            patterns @ patterns.push(bodies.render_pattern(tree, s, pattern: pattern))

        out @ out.push(patterns.join(" | "))

    return out

# One column per RUN of arms, never one per match: a run ends at a
# blank line or a block-bodied arm, so one very long pattern widens
# its immediate neighbours and nothing further. Whether an arm prints
# on one line is the PRINTER's question, asked with the printer's own
# test — deciding from source adjacency made fmt(fmt(x)) != fmt(x)
# (sweep 001 audit S3).
function arm_alignment(tree: ast.Ast, s: source.Source, arms: [ast.Arm], lefts: [str], indent: i64) -> [i64]
    pads: [i64] @ []

    for _ in arms
        pads @ pads.push(0)

    run_index: [i64] @ []
    run_len: [i64] @ []
    previous_end: i64 @ 0
    index: i64 @ 0

    for arm in arms
        line = source.line_of(s, arm.span.start)
        arm_end: i64 @ arm.span.end - 1

        if arm_end < 0
            arm_end @ 0
        end = source.line_of(s, arm_end)
        inline: bool @ false

        match arm.body
            .one_stmt => inline @ true
            .block    => inline @ false

        width: i64? @ fail("none", "not inline")

        if inline
            width @ fits_on_one_line(tree, s, arm: arm, left: lefts[index].chars().len(), indent: indent)
        joined = run_index.len() > 0 && line == previous_end + 1

        if width.is_err() || !joined
            pads @ close_run(run_index: run_index, run_len: run_len, lefts: lefts, indent: indent, pads: pads)
            run_index @ []
            run_len @ []

        if !width.is_err()
            run_index @ run_index.push(index)
            run_len @ run_len.push(width.must())
        previous_end @ end
        index @ index + 1

    pads @ close_run(run_index: run_index, run_len: run_len, lefts: lefts, indent: indent, pads: pads)
    return pads

# Pad every member to the widest left side — UNLESS doing so pushes
# one past the margin, in which case the run gets no padding at all
# (the alignment would break the very line it widens, and the next
# format would drop that arm from the run: non-idempotence one door
# down).
function close_run(run_index: [i64], run_len: [i64], lefts: [str], indent: i64, pads: [i64]) -> [i64]
    widest: i64 @ 0

    for i in run_index
        if lefts[i].chars().len() > widest
            widest @ lefts[i].chars().len()

    at: i64 @ 0

    for i in run_index
        grown = widest - lefts[i].chars().len()

        if indent + run_len[at] + grown > WIDTH
            return pads
        at @ at + 1

    out: [i64] @ pads

    for i in run_index
        out[i] @ widest

    return out

## The three measurements (fmt_fits)

# The printer's one-line test for an arm — and, when it passes, the
# length that test measured.
function fits_on_one_line(tree: ast.Ast, s: source.Source, arm: ast.Arm, left: i64, indent: i64) -> i64?
    stmt_at: i64 @ -1

    match arm.body
        .one_stmt one => stmt_at @ one.at
        .block        => return fail("none", "a block arm has no one-line form")

    value: i64 @ -1

    # THE HEAD THE PRINTER WILL PUT BEFORE THE VALUE. It must be the same
    # string `statement()` puts there, and its width comes from the
    # literal rather than typed, so the two cannot drift in characters.
    # `return ` was missing here: the arm measured short, joined the run,
    # was padded past the margin and then broken (defect 004, `docs/work/DONE.md`).
    head: i64 @ 0

    match tree.stmts[stmt_at].kind
        .expr_stmt e => value @ e.value
        .return_stmt r =>
            if !r.value.is_err()
                value @ r.value.must()
                head @ "return ".chars().len()
        .bind | .declare | .mutate | .break_stmt | .continue_stmt => value @ value
        .assert_stmt | .while_stmt | .for_in | .error             => value @ value

    if value == -1
        # Any other statement shape prints on its own line by
        # construction, so it is in the run and its length is its
        # head's. NO `indent`: `close_run` adds it, and this path added
        # it twice (defect 004, `docs/work/DONE.md`).
        return ok(left + 4)

    if spans_lines(tree, s, value: value)
        return fail("none", "the author spread this value")
    measured = left + 4 + head + render(tree, s, id: value).chars().len()

    if indent + measured <= WIDTH
        return ok(measured)
    return fail("none", "past the margin")

# True where the author wrote a value across more than one line. Such
# a value keeps its shape even when it would fit on one — layout is
# content, and §4.9 gives the two forms different separators, so an
# array written down the page is the OTHER SPELLING, not a wrapped
# array. if and match carry blocks whose spans reach a Dedent on the
# next line, so they answer false here; everything else is answered
# by its own extent. It used to be Array and Map alone — true of
# source a person writes and false of source THIS FORMATTER writes,
# because the 88-column rule breaks a long call across lines
# (fixedbugs: formatting twice grew a blank line after every one).
function spans_lines(tree: ast.Ast, s: source.Source, value: i64) -> bool
    node = tree.exprs[value]
    is_control: bool @ false

    match node.kind
        .if_expr | .match_expr                                               => is_control @ true
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => is_control @ is_control
        .name | .hole | .unary | .binary | .field | .index                   => is_control @ is_control
        .call | .method | .variant_case | .array | .map | .try_expr | .error => is_control @ is_control

    if is_control
        return false
    first = source.line_of(s, node.span.start)
    last_at: i64 @ node.span.end - 1

    if last_at < 0
        last_at @ 0
    return source.line_of(s, last_at) > first

# The last source line a statement's own text occupies, when its VALUE
# crosses lines — absent otherwise. The answer is the value
# expression's extent, never the statement's own span: a statement
# ending in a block ends at a Dedent on the next line, and asking it
# made trailing_comment steal the following declaration's doc comment.
function literal_end_line(tree: ast.Ast, s: source.Source, id: i64) -> i64?
    value: i64 @ -1

    match tree.stmts[id].kind
        .bind b     => value @ b.value
        .declare dc => value @ dc.value
        .mutate m   => value @ m.value
        .return_stmt r =>
            if !r.value.is_err()
                value @ r.value.must()
        .assert_stmt a                                                => value @ a.value
        .expr_stmt e                                                  => value @ e.value
        .break_stmt | .continue_stmt | .while_stmt | .for_in | .error => value @ value

    if value == -1
        return fail("none", "no value expression")

    if !spans_lines(tree, s, value: value)
        return fail("none", "ends where it started")
    last_at: i64 @ tree.exprs[value].span.end - 1

    if last_at < 0
        last_at @ 0
    return ok(source.line_of(s, last_at))

## Minimum parentheses (fmt_expr)

# Binding power, on the same scale as the parser's table: higher binds
# tighter. THE NUMBERS HAVE TO MATCH THE PARSER'S — and the two
# strongest rows are NAMED rather than written at each site, because
# five literal 7s survived panel 040's five new bitwise levels and fmt
# printed (at / WORDS).to_str() as at / WORDS.to_str(), a different
# program that does not even type-check (fixedbugs 2026-08-13).
constant UNARY_POWER: i64
    10

constant POSTFIX_POWER: i64
    11

function power(tree: ast.Ast, id: i64) -> i64
    match tree.exprs[id].kind
        .binary b =>
            return match b.op
                .or                               => 1
                .and                              => 2
                .eq | .ne | .lt | .le | .gt | .ge => 3
                .bit_or                           => 4
                .bit_xor                          => 5
                .bit_and                          => 6
                .shl | .shr                       => 7
                .add | .sub                       => 8
                .mul | .div | .rem                => 9
        .unary => return UNARY_POWER
        # A control form spans lines; the loosest thing there is, so a
        # parenthesis is never printed around it.

        .if_expr | .match_expr                                               => return 0
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return POSTFIX_POWER
        .name | .hole | .field | .index | .call | .method                    => return POSTFIX_POWER
        .variant_case | .array | .map | .try_expr | .error                   => return POSTFIX_POWER

    return POSTFIX_POWER

function render(tree: ast.Ast, s: source.Source, id: i64) -> str
    node = tree.exprs[id]

    match node.kind
        # The one literal fmt rewrites, and only in its digits' case:
        # a mask copied from a C header arrives as 0xFF, and §4.15's
        # one-spelling rule is settled here rather than by refusing
        # the paste.
        .int_lit => return digits.canonical_int(source.span_text(s, node.span))
        .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr | .name => return source.span_text(s, node.span)
        .hole => return "???"
        .unary u =>
            op: str @ "-"

            match u.op
                .neg     => op @ "-"
                .not     => op @ "!"
                .bit_not => op @ "~"

            return op + wrapped(tree, s, id: u.operand, needed: UNARY_POWER)
        .binary b =>
            mine = power(tree, id)

            # Left-associative everywhere, so an equally-binding
            # operator on the right DOES need its parentheses:
            # a - (b - c).
            return wrapped(tree, s, id: b.left, needed: mine) + " " + bodies.binary_op(b.op) + " " + wrapped(tree, s, id: b.right, needed: mine + 1)
        .field fl => return wrapped(tree, s, id: fl.base, needed: POSTFIX_POWER) + "." + source.span_text(s, fl.name)
        .index ix => return wrapped(tree, s, id: ix.base, needed: POSTFIX_POWER) + "[" + render(tree, s, id: ix.index) + "]"
        .call cl => return wrapped(tree, s, id: cl.callee, needed: POSTFIX_POWER) + "(" + args_line(tree, s, given: cl.args) + ")"
        .method m => return wrapped(tree, s, id: m.receiver, needed: POSTFIX_POWER) + "." + source.span_text(s, m.name) + "(" + args_line(tree, s, given: m.args) + ")"
        .variant_case vc =>
            if vc.args.len() == 0
                return "." + source.span_text(s, vc.name)
            return "." + source.span_text(s, vc.name) + "(" + args_line(tree, s, given: vc.args) + ")"
        .array arr =>
            rendered: [str] @ []

            for item in arr.elements
                rendered @ rendered.push(render(tree, s, id: item))

            return "[" + rendered.join(", ") + "]"
        .map mp =>
            rendered: [str] @ []

            for entry in mp.entries
                rendered @ rendered.push(render(tree, s, id: entry.key) + ": " + render(tree, s, id: entry.value))

            return "{" + rendered.join(", ") + "}"
        .try_expr t => return wrapped(tree, s, id: t.value, needed: POSTFIX_POWER) + "?"
        # Headers only: valued() prints the blocks under them.

        .if_expr ie =>
            if ie.branches.len() > 0
                return "if " + render(tree, s, id: ie.branches[0].cond)
            return "if"
        .match_expr me => return "match " + render(tree, s, id: me.scrutinee)
        # A file with an unreadable expression is not formatted at all
        # (the command refuses on any diagnostic).

        .error => return "???"

    return "???"

# id rendered, in parentheses only if it binds looser than needed.
function wrapped(tree: ast.Ast, s: source.Source, id: i64, needed: i64) -> str
    text = render(tree, s, id: id)
    is_control: bool @ false

    match tree.exprs[id].kind
        .if_expr | .match_expr                                               => is_control @ true
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => is_control @ is_control
        .name | .hole | .unary | .binary | .field | .index                   => is_control @ is_control
        .call | .method | .variant_case | .array | .map | .try_expr | .error => is_control @ is_control

    if power(tree, id) < needed && !is_control
        return "(" + text + ")"
    return text

function args_line(tree: ast.Ast, s: source.Source, given: [ast.Arg]) -> str
    rendered: [str] @ []

    for arg in given
        rendered @ rendered.push(arg_text(tree, s, arg: arg))

    return rendered.join(", ")

function arg_text(tree: ast.Ast, s: source.Source, arg: ast.Arg) -> str
    name: str @ ""

    if !arg.name.is_err()
        name @ source.span_text(s, arg.name.must()) + ": "
    marker: str @ ""

    if arg.mutable
        marker @ "@"
    return name + marker + render(tree, s, id: arg.value)

## Tests

test "minimal parentheses: the table is proved in both directions"
    text = "function main()\n    a = 2 + (3 * 4)\n    b = (2 + 3) * 4\n    c = (a - b) - (a - (a - b))\n    d = (a / b).to_str()\n    print(a + b + c + d.len())\n"
    parsed = parse.parse(text)
    assert parsed.diagnostics.len() == 0
    s = source.new_source(name: "t.hero", text: text)
    got = format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
    expected = "function main()\n    a = 2 + 3 * 4\n    b = (2 + 3) * 4\n    c = a - b - (a - (a - b))\n    d = (a / b).to_str()\n    print(a + b + c + d.len())\n"
    assert got == expected

test "fmt is idempotent on a program with groups, comments and a match"
    text = "# A file header remark.\n\nuse geom\n\nextern \"m.h\" link \"m\"\n    function sqrtish(x: f64) -> f64\n    constant K: i64\n\n# Documentation for pick.\nfunction pick(n: i64) -> i64\n    match n\n        0 => return 10\n        1 => return 20\n        _ =>\n            v = n * 2\n            return v\n\nfunction main()\n    print(pick(n: 1))\n"
    parsed = parse.parse(text)
    assert parsed.diagnostics.len() == 0
    s = source.new_source(name: "t.hero", text: text)
    once = format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
    again = parse.parse(once)
    assert again.diagnostics.len() == 0
    s2 = source.new_source(name: "t.hero", text: once)
    twice = format_file(again.tree, s2, again.comments, again.uses, again.decls)
    assert once == twice

    # The group survives as one head line, the arms line up.
    assert once == "# A file header remark.\n\nuse geom\n\nextern \"m.h\" link \"m\"\n    function sqrtish(x: f64) -> f64\n    constant K: i64\n\n# Documentation for pick.\nfunction pick(n: i64) -> i64\n    match n\n        0 => return 10\n        1 => return 20\n        _ =>\n            v = n * 2\n            return v\n\nfunction main()\n    print(pick(n: 1))\n"

# defect 004 (docs/work/DONE.md) § What is still owed, closed 2026-08-28 (`/decide` answer
# `4a`). §4.1 makes the blank line below a comment the difference between
# an ordinary remark and the next member's DOCUMENTATION, and deleting it
# promoted one — a different program that parses, is a fixpoint, and was
# caught only by the tree guard. Both members that take a doc comment are
# asserted here, a `record` field and a `variant` case, because they are
# the same witness twice (CLAUDE.md §1).
test "the blank line that decides remark from documentation survives"
    fields = "record Point\n    x: i64\n    # a remark, not documentation for y\n\n    y: i64\n"
    pf = parse.parse(fields)
    assert pf.diagnostics.len() == 0
    sf = source.new_source(name: "t.hero", text: fields)
    assert format_file(pf.tree, sf, pf.comments, pf.uses, pf.decls) == fields

    # And with NO blank line it is documentation, and stays attached.
    docs = "record Point\n    x: i64\n    # documentation for y\n    y: i64\n"
    pd = parse.parse(docs)
    assert pd.diagnostics.len() == 0
    sd = source.new_source(name: "t.hero", text: docs)
    assert format_file(pd.tree, sd, pd.comments, pd.uses, pd.decls) == docs

    # The adjacent shape: a variant case takes a doc comment too.
    cases = "variant Shape\n    dot\n    # a remark, not documentation for box\n\n    box\n"
    pc = parse.parse(cases)
    assert pc.diagnostics.len() == 0
    sc = source.new_source(name: "t.hero", text: cases)
    assert format_file(pc.tree, sc, pc.comments, pc.uses, pc.decls) == cases

# defect 003 (docs/work/DONE.md): fmt deleted seven arms out of digits.hero at exit 0.
# Four shapes, because the provoking case is a witness and not the class
# (CLAUDE.md §1): the plain binary tail, a chain of two operators, a
# match nested inside an arm of the outer one, and an `if` rather than a
# `match` in the same position.
test "a control form at a binary's right edge keeps its body"
    plain = "function f(c: str) -> str\n    out: str @ \"\"\n    out @ out + match c\n        \"a\" => \"b\"\n        _ => c\n    return out\n"
    parsed = parse.parse(plain)
    assert parsed.diagnostics.len() == 0
    s = source.new_source(name: "t.hero", text: plain)
    got = format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls)
    assert got == "function f(c: str) -> str\n    out: str @ \"\"\n\n    out @ out + match c\n        \"a\" => \"b\"\n        _   => c\n\n    return out\n"

    # Two operators before the control form, and the prefix keeps its
    # minimum parentheses.
    chain = "function f(c: str, p: str) -> str\n    out: str @ \"\"\n    out @ out + p + match c\n        \"a\" => \"b\"\n        _ => c\n    return out\n"
    pc = parse.parse(chain)
    assert pc.diagnostics.len() == 0
    sc = source.new_source(name: "t.hero", text: chain)
    gc = format_file(pc.tree, sc, pc.comments, pc.uses, pc.decls)
    assert gc == "function f(c: str, p: str) -> str\n    out: str @ \"\"\n\n    out @ out + p + match c\n        \"a\" => \"b\"\n        _   => c\n\n    return out\n"

    # A match inside an arm of the match at the right edge: all four arms.
    nested = "function f(c: str, e: str) -> str\n    out: str @ \"\"\n    out @ out + match c\n        \"a\" => match e\n            \"z\" => \"Z\"\n            _ => e\n        _ => c\n    return out\n"
    pn = parse.parse(nested)
    assert pn.diagnostics.len() == 0
    sn = source.new_source(name: "t.hero", text: nested)
    gn = format_file(pn.tree, sn, pn.comments, pn.uses, pn.decls)
    assert gn == "function f(c: str, e: str) -> str\n    out: str @ \"\"\n\n    out @ out + match c\n        \"a\" => match e\n            \"z\" => \"Z\"\n            _   => e\n        _   => c\n\n    return out\n"

    # The same position, an `if` instead: the else branch used to go.
    # AND it is the control case for panel 095's narrowing of rule 2:
    # `if` takes air BEFORE it, like the match above, and none AFTER,
    # where the match gets one. Same position, different air, on purpose.
    branchy = "function f(c: str) -> str\n    out: str @ \"\"\n    out @ out + if c == \"a\"\n        \"b\"\n    else\n        c\n    return out\n"
    pb = parse.parse(branchy)
    assert pb.diagnostics.len() == 0
    sb = source.new_source(name: "t.hero", text: branchy)
    gb = format_file(pb.tree, sb, pb.comments, pb.uses, pb.decls)
    assert gb == "function f(c: str) -> str\n    out: str @ \"\"\n\n    out @ out + if c == \"a\"\n        \"b\"\n    else\n        c\n    return out\n"

test "fmt keeps an alias, and this is a fixed defect"
    # **The formatter deleted `as` for one commit** (2026-09-02): it printed
    # `"use " + name`, so `heroes fmt --in-place` silently changed what a
    # program means — the worst thing this file can do, since §4.15's whole
    # claim is that a textual difference is a semantic one. Found by the corpus
    # rather than by a unit test, which is why one lives here now.
    for text in ["use geom\n\nfunction main()\n    print(0)\n", "use render/scale\n\nfunction main()\n    print(0)\n", "use render/scale as near_scale\n\nfunction main()\n    print(0)\n"]
        parsed = parse.parse(text)
        assert parsed.diagnostics.len() == 0
        s = source.new_source(name: "t.hero", text: text)
        assert format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls) == text

test "fmt keeps a callback in an extern group, at every position the checker judges"
    # CLAUDE.md §9: a new surface form lands in every tool that reads the
    # language, and this is the one that lies quietest — a form it has not
    # learned is not an error, it is a DELETION, and `fmt --in-place` writes it
    # to disk. Panel 111 R4 let a function type into an `extern` group, so the
    # round trip is asserted here rather than read off a diff.
    #
    # Four shapes, because the provoking case is a witness and not the class:
    # the parameter the permission is FOR, the result and the `@` parameter the
    # checker refuses (the formatter must still print what it was given — it
    # runs before the checker and on programs that do not check), and the same
    # type in an ordinary signature beside them, which is the shape next door.
    for text in ["extern \"stdlib.h\"\n    function atexit(f: (function() -> ())) -> i32\n\nfunction main()\n    print(0)\n", "extern \"signal.h\"\n    function installer(h: (function(i32) -> ())) -> (function(i32) -> ())\n\nfunction main()\n    print(0)\n", "extern \"x.h\"\n    function grab(@slot: (function() -> ())) -> i32\n\nfunction main()\n    print(0)\n", "function twice(f: (function(i64) -> i64), x: i64) -> i64\n    return f(f(x))\n\nfunction main()\n    print(0)\n"]
        parsed = parse.parse(text)
        assert parsed.diagnostics.len() == 0
        s = source.new_source(name: "t.hero", text: text)
        assert format_file(parsed.tree, s, parsed.comments, parsed.uses, parsed.decls) == text
