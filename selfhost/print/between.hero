# The bytes between two tokens, which the tree does not keep: whitespace,
# comments, and the grouping parentheses the parser folds away (design.md
# §4.15). `print/elements.hero` asks them where a value's `(` and `)` are
# and whether a comment sits between them and the value. Split out of it on
# 2026-09-25, defect 101's last round: these read bytes and know no tree.

use token
use source

# Is every byte of code from `from` up to `to` a `)`?
function closers_only(s: source.Source, from: i64, to: i64) -> bool
    at: i64 @ code_after(s, offset: from)

    while at >= 0 && at < to
        if s.text[at] != ')'
            return false
        at @ code_after(s, offset: at + 1)

    return at == to

# The offset of the first byte at or after `offset` that is not a space or
# a tab: the bracket that follows a callee on its line.
function next_mark(s: source.Source, offset: i64) -> i64
    i: i64 @ offset

    while i < s.text.len() && (s.text[i] == ' ' || s.text[i] == '\t')
        i @ i + 1

    return i

# The offset of the last byte of code before `offset`, past whitespace and
# comments, or -1: what a value's `(` would be, the tree keeping none.
function code_before(s: source.Source, comments: [token.Span], offset: i64) -> i64
    i: i64 @ offset - 1

    while i >= 0
        b = s.text[i]

        if b != ' ' && b != '\t' && b != '\r' && b != '\n'
            holder = comment_at(comments, offset: i)

            if holder < 0
                return i
            i @ holder
        i @ i - 1

    return -1

# The offset of the first byte of code at or after `offset`, past
# whitespace and comments, or -1. Between two tokens a `#` opens a comment.
function code_after(s: source.Source, offset: i64) -> i64
    i: i64 @ offset

    while i < s.text.len()
        b = s.text[i]

        if b == '#'
            while i < s.text.len() && s.text[i] != '\n'
                i @ i + 1
        else if b != ' ' && b != '\t' && b != '\r' && b != '\n'
            return i
        i @ i + 1

    return -1

# The offset of the `)` that closes the `(` at `open`, or -1, past string
# and character literals and comments, whose brackets are text.
function matching(s: source.Source, open: i64) -> i64
    depth: i64 @ 0
    i: i64 @ open

    while i < s.text.len()
        b = s.text[i]

        if b == '"' || b == '\''
            i @ i + 1

            while i < s.text.len() && s.text[i] != b
                if s.text[i] == '\\'
                    i @ i + 1
                i @ i + 1
        else if b == '#'
            while i < s.text.len() && s.text[i] != '\n'
                i @ i + 1
        else if b == '('
            depth @ depth + 1
        else if b == ')'
            depth @ depth - 1

            if depth == 0
                return i
        i @ i + 1

    return -1

# The start of the comment holding byte `offset`, or -1: the stream is in
# source order, so the search halves it.
function comment_at(comments: [token.Span], offset: i64) -> i64
    low: i64 @ 0
    high: i64 @ comments.len()

    while low < high
        middle = (low + high) / 2

        if comments[middle].start <= offset
            low @ middle + 1
        else
            high @ middle

    if low > 0 && offset < comments[low - 1].end
        return comments[low - 1].start
    return -1
