# What a value's brackets hold, read from the tree and from the source's
# tokens around it, for `print/brackets.hero` to print (design.md §4.9,
# §4.15). The tree keeps no comments and no parentheses, so where one sits
# beside the other is asked of the tokens here (`print/owners.hero`): the
# comments between a value's parts, the bracket after a callee. Split out of
# `print/brackets.hero` on 2026-09-25 with defect 101, along the seam
# between what is read and what is printed; none of this prints.

use token
use ast
use source
use print/bodies
use print/page
use print/parens
use print/owners
use print/groups

# The four things every question here reads.
record Code
    tree: ast.Ast
    s: source.Source
    comments: [token.Span]
    lines: owners.Lines

# What an opened bracket prints: the value before it (a callee, a receiver,
# or -1), its opening text, the source lines of its opening and closing
# brackets, the elements, and its closing text. `from` and `to` are the
# offsets of the two brackets, -1 for parentheses `fmt` adds, and `seam`
# where the stretch before the opening one starts, the end of the callee or
# receiver or a case's `.`: a comment there is between them. `keeps` says
# the author's parentheses printed for a comment, inside which every pair of
# theirs around the element is printed too.
record Bracket
    before: i64
    open: str
    at: i64
    items: [Element]
    shut: i64
    close: str
    from: i64
    to: i64
    seam: i64
    keeps: bool

# One element of an opened bracket: a map's `key` (or -1), then `lead` (an
# argument's name and `@`, a unary operator, a key's `: `), the value,
# parenthesised below `needed`, and `after` (a call's comma, a chain's
# operator). The lead's tokens are written from `from` up to the value: a
# comment there sits between the name, the `@` or the key and the value.
# `first` is the source line the element starts on.
record Element
    key: i64
    lead: str
    from: i64
    value: i64
    needed: i64
    after: str
    first: i64

# The bracket at the top of a value, or none. A call keeps its commas:
# §4.9's newline rule is about literals, and a call written across lines is
# still a comma-separated list (the parser requires it).
function bracket(c: Code, value: i64) -> Bracket?
    span = c.tree.exprs[value].span
    b: Bracket @ Bracket(
        before: -1,
        open: "",
        at: first_line(c, id: value),
        items: [],
        shut: end_line(c, id: value),
        close: ")",
        from: span.start,
        to: span.end - 1,
        seam: span.start,
        keeps: false
    )

    # **The elements grow in a name of their own and are stored once**
    # (defect 393). Grown as `b.items @ b.items.push(...)`, each push copied
    # every element before it, a field being no plain name (spec § 10), and
    # `fmt` retired 24.8 billion instructions for 8,000 elements, four times
    # as many for each doubling.
    match c.tree.exprs[value].kind
        # §4.9: a multi-line list separates by newline, not by comma.
        .array arr =>
            b.open @ "["
            b.close @ "]"
            listed: [Element] @ []

            for item in arr.elements
                listed @ listed.push(plain(c, value: item, needed: 0, after: ""))

            b.items @ listed
        .map mp =>
            b.open @ "{"
            b.close @ "}"
            entries: [Element] @ []

            for entry in mp.entries
                item: Element @ plain(c, value: entry.value, needed: 0, after: "")
                item.key @ entry.key
                item.lead @ ": "
                item.from @ extent(c, id: entry.key).end
                item.first @ source.line_of(c.s, extent(c, id: entry.key).start)
                entries @ entries.push(item)

            b.items @ entries
        .call cl =>
            b.before @ cl.callee
            b.open @ "("
            b.from @ opener(c, after: cl.callee)
            b.seam @ extent(c, id: cl.callee).end
            b.items @ arguments(c, given: bodies.written(c.tree, cl.args, rest: cl.rest))
        .method m =>
            b.before @ m.receiver
            b.open @ "." + source.span_text(c.s, m.name) + "("
            b.from @ opener_at(c, at: m.name)
            b.seam @ extent(c, id: m.receiver).end
            b.items @ arguments(c, given: bodies.written(c.tree, m.args, rest: m.rest))
        .variant_case vc =>
            if vc.args.len() > 0
                b.open @ "." + source.span_text(c.s, vc.name) + "("
                b.from @ opener_at(c, at: vc.name)
                b.items @ arguments(c, given: vc.args)
        .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => b.open @ ""
        .name | .hole | .unary | .binary | .field | .field_name | .index               => b.open @ ""
        .try_expr | .if_expr | .match_expr | .error                                    => b.open @ ""

    if b.open.len() == 0
        return fail(code: "none", msg: "no bracket at the top of this value")
    b.at @ source.line_of(c.s, b.from)
    return ok(b)

# Parentheses around a value: `fmt`'s own around a binary whose operators
# have a comment after them or whose operands hold more than one, or the
# author's where a comment sits just inside them. Where `split`, the
# operands of one operator's chain are one element each, so a comment after
# any operator stays after it; otherwise the value is the one element.
function group(c: Code, value: i64, paren: token.Span?, split: bool) -> Bracket
    b: Bracket @ Bracket(
        before: -1,
        open: "(",
        at: first_line(c, id: value),
        items: [],
        shut: end_line(c, id: value),
        close: ")",
        from: -1,
        to: -1,
        seam: -1,
        keeps: false
    )

    if !paren.is_err()
        b.from @ paren.must().start
        b.to @ paren.must().end
        b.at @ source.line_of(c.s, b.from)
        b.shut @ source.line_of(c.s, b.to)
    mine = parens.power(c.tree, value)
    rest: [Element] @ []
    left: i64 @ value
    chained: bool @ split

    while chained
        chained @ false

        match c.tree.exprs[left].kind
            .binary bin =>
                if parens.power(c.tree, left) == mine
                    rest @ rest.push(
                        plain(c, value: bin.right, needed: mine + 1, after: " " + bodies.binary_op(bin.op))
                    )
                    left @ bin.left
                    chained @ true
            .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => chained @ false
            .name | .hole | .unary | .field | .field_name | .index | .call | .method       => chained @ false
            .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error    => chained @ false

    needed: i64 @ 0

    if rest.len() > 0
        needed @ mine
    operands: [Element] @ [plain(c, value: left, needed: needed, after: "")]
    at: i64 @ rest.len() - 1

    # The chain was walked from its right end, and each operator goes after
    # the operand to its left. The operands grow in a name of their own, as
    # a bracket's elements do (defect 393).
    while at >= 0
        operands[operands.len() - 1].after @ rest[at].after
        rest[at].after @ ""
        operands @ operands.push(rest[at])
        at @ at - 1

    b.items @ operands
    return b

# The author's `pair` around a value, kept for a comment and printed as a
# group of one element, inside which every pair of theirs around the value
# is kept too (`keeps`); `innermost` where no pair of theirs is inside it,
# so a binary's operands may be the elements instead.
function kept(f: page.Fmt, c: Code, value: i64, pair: token.Span, innermost: bool) -> Bracket
    b: Bracket @ group(c, value: value, paren: ok(pair), split: splits(f, c, value: value) && innermost)
    b.keeps @ true
    return b

# An element whose `lead`, written from `from`, is printed before its
# value, with a comment between them: a unary operator and its operand.
function led(c: Code, value: i64, lead: str, from: i64) -> Element
    item: Element @ plain(c, value: value, needed: parens.UNARY_POWER, after: "")
    item.lead @ lead
    item.from @ from
    item.first @ source.line_of(c.s, from)
    return item

function plain(c: Code, value: i64, needed: i64, after: str) -> Element
    start = extent(c, id: value).start
    return Element(
        key: -1,
        lead: "",
        from: start,
        value: value,
        needed: needed,
        after: after,
        first: source.line_of(c.s, start)
    )

function arguments(c: Code, given: [ast.Arg]) -> [Element]
    items: [Element] @ []

    for arg in given
        comma: str @ ","

        if items.len() == given.len() - 1
            comma @ ""
        item: Element @ plain(c, value: arg.value, needed: 0, after: comma)
        item.lead @ parens.arg_lead(c.s, arg: arg)
        mark = owners.code_before(c.lines, index: owners.index_at(c.lines, offset: c.tree.exprs[arg.value].span.start))

        # A mutable one's `@` is its lead, after the name where there is
        # one, and a comment on either side of it stays there.
        if arg.mutable && mark >= 0 && c.lines.tokens[mark].kind == .at
            item.from @ c.lines.tokens[mark].span.start
            item.first @ source.line_of(c.s, c.lines.tokens[mark].span.start)

        if !arg.name.is_err()
            item.from @ arg.name.must().start
            item.first @ source.line_of(c.s, arg.name.must().start)
        items @ items.push(item)

    return items

# Is the next comment to print written from `from` up to `to`?
function holds(f: page.Fmt, c: Code, from: i64, to: i64) -> bool
    if f.next_comment >= c.comments.len()
        return false
    at = c.comments[f.next_comment].start
    return at >= from && at < to

# Is every comment written inside `value` inside its operand `within` too?
# Both are asked of their extents, the parentheses at their edges included,
# and the operand's with the author's parentheses around it inside `value`:
# in `(a + b) * 2` a comment after the `(` is the left operand's.
function alone(f: page.Fmt, c: Code, value: i64, within: i64) -> bool
    outer = extent(c, id: value)
    operand = inner(c, value: value, within: within)
    i: i64 @ f.next_comment

    while i < c.comments.len() && c.comments[i].start < outer.end
        if c.comments[i].start >= outer.start && (c.comments[i].start < operand.start || c.comments[i].start >= operand.end)
            return false
        i @ i + 1

    return true

# An operand's tokens inside `value`: its extent, and the author's
# parentheses around it that are inside `value`'s.
function inner(c: Code, value: i64, within: i64) -> token.Span
    outer = extent(c, id: value)
    operand: token.Span @ extent(c, id: within)

    for open in groups.levels(c.lines, span: c.tree.exprs[within].span)
        pair = groups.around(c.lines, open: open)

        if pair.start >= outer.start && pair.end < outer.end && pair.start < operand.start
            operand @ token.Span(start: pair.start, end: pair.end + 1)

    return operand

# Is a comment not printed yet written inside `span`? Not only the next
# one: a comment just inside the author's `(` before a value is printed
# with the group, after the value's own are asked about.
function waits(f: page.Fmt, c: Code, span: token.Span) -> bool
    i: i64 @ f.next_comment

    while i < c.comments.len() && c.comments[i].start < span.end
        if c.comments[i].start >= span.start
            return true
        i @ i + 1

    return false

# Does a binary hold a comment after an operator, or comments in both its
# operands, which only a break after each operator keeps?
function splits(f: page.Fmt, c: Code, value: i64) -> bool
    if !waits(f, c, span: extent(c, id: value))
        return false

    match c.tree.exprs[value].kind
        .binary b => return !alone(f, c, value: value, within: b.left) && !alone(f, c, value: value, within: b.right)
        .int_lit | .float_lit | .str_lit | .interp | .char_lit | .bool_lit | .null_ptr => return false
        .name | .hole | .unary | .field | .field_name | .index | .call | .method => return false
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error => return false

    return false

# The offset of the `(` after a callee's last token or after a name.
function opener(c: Code, after: i64) -> i64
    last = owners.index_at(c.lines, offset: c.tree.exprs[after].span.end - 1)
    return c.lines.tokens[owners.code_after(c.lines, index: last)].span.start

function opener_at(c: Code, at: token.Span) -> i64
    return c.lines.tokens[owners.code_after(c.lines, index: owners.index_at(c.lines, offset: at.start))].span.start

# A value's tokens, with the author's parentheses at its edges around a
# part of it (`groups.extent`).
function extent(c: Code, id: i64) -> token.Span
    return groups.extent(c.lines, span: c.tree.exprs[id].span)

function first_line(c: Code, id: i64) -> i64
    return source.line_of(c.s, c.tree.exprs[id].span.start)

# The last source line an expression occupies: its span ends one past its
# last byte.
function end_line(c: Code, id: i64) -> i64
    last: i64 @ c.tree.exprs[id].span.end - 1

    if last < 0
        last @ 0
    return source.line_of(c.s, last)
