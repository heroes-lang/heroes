# An operator alone on its line above an arm, and what refusing it offers
# (design.md §4.15, and §4.8's *two readings make two guesses*; panel 185
# R6; defects 159, 165 and 166). `open_line.refuse_the_end` refuses the line
# as one that cannot end with its operator, and asks here for the fixes.
#
# A `-` signs the pattern below it, or it is a stray, a bullet or a slip, and
# the arm is the author's without it. Where the pattern is an integer or a
# character, both readings are programs and they mean two things: `-` over
# `1 => "one"`, with 1 matched, prints `one` with the `-` deleted and `many`
# joined, so both fixes are guesses, R6's rule for the same `-` set apart on
# the arm's own line. Anywhere else the join writes no pattern a `-` signs, a
# string, `_`, a case, a name, a float or a signed literal, and no pattern
# begins with any other operator (`parse/operator_arm`), so the deletion is
# the one repair, `certain`, and no join is offered. It was the join, with
# certainty, until defect 159, and `check --apply` wrote `-1 => "one"`, which
# checks clean and prints `many`; over a `+` the join was a `guess` writing
# `+1`, and the deletion was not offered (defect 165).
#
# **Where the deletion is the one repair, the operator is left out of the
# stream the parser is handed**, so the arm is read as the deletion writes it
# and only its own mistakes are told. Joined, `+` over `1 => 1` was told
# `expected_pattern` at the `+` the refusal already names (defect 165); and
# `-` over `x => 1`, read as `-x`, was told `expected_pattern` twice at the
# name (defect 166), because a failed arm's recovery dropped no further
# than its line of the text (`opening.drop_line`, gone since panel 187) and
# read the part below the break again as an arm. Where both readings stand,
# the stream is the join, as for every refused break (`open_line`).
#
# **The operator's line goes with it, its margin too** (defect 182). Deeper
# than the arms, its margin opened a block the arm below was joined into, and
# the parser named it `unexpected_block`, a second message for the one line
# the deletion removes; shallower, it closed the arms. The indent or dedents
# that line laid out and the reports its margin said are taken back, the
# level is what it was above it, and the arm's line is laid out on its own
# margin, as the deletion writes the text: an arm over-indented there is
# told as itself. A margin laid out under braces or an indentation habit,
# which keep their own count of the lines, stays, and the arm is joined.
#
# The deletion takes the operator's whole line, so the arm keeps its own
# margin. A comment after the operator on its line stays where the operator
# stood, and no join is offered across a comment, which it would carry into
# the arm.
#
# **Operators alone are a run, and an arm is not the only line below them**
# (defects 369 and 370). `- -` on one line went on as a block of its own,
# `unexpected_block` beside its refusal, since only a line one operator held
# was asked; and operators alone above a statement, `k = n` over a deeper
# `-` over `return k`, were joined or ended for the parser to read as a sign
# with no operand, each line two messages or three. Operators alone on a
# line, above an arm or above what no operator goes on into, a word that
# begins afresh, a statement of its own or the text's end
# (`next_line.nothing_joins_below`), are a stray, told once and left out
# with their margin (`stray`). Above a statement the deletion is a `guess`:
# the operand may be what was left out, and a certain deletion would write a
# program meaning less than the one meant.

use token
use state
use lex_asked
use diag
use bytes
use join_fix
use word_place
use next_line

# Whether the line that ends with the token at `at`, which no `\` asked to
# go on, holds operators alone above an arm or above what no operator goes
# on into, the next line with words at `l.pos`: a stray (defect 370).
function stray(l: state.LexState, text: str, at: i64) -> bool
    return l.backslash < 0 && alone_from(l, at: at) >= 0 && next_line.nothing_joins_below(text, at: l.pos)

# The first of the operators alone on the line that ends with the token at
# `at`, or -1: walked back over the tokens no statement begins with, and the
# comments of the lines above, to the line end before them (one operator
# until defect 369, `- -` a run of two).
function alone_from(l: state.LexState, at: i64) -> i64
    i: i64 @ at

    while i >= 0 && token.can_only_go_on(l.tokens[i].kind)
        i @ i - 1

    first = i + 1

    while i >= 0 && l.tokens[i].kind == .comment
        i @ i - 1

    if first > at || i >= 0 && !token.is_line_end(l.tokens[i].kind)
        return -1
    return first

# The refusal `d` of the stray line that ends with the token at `at`, above
# the line whose first byte is `l.pos`, said with its fixes, and the stream
# the parser is handed: whether it is the join, false where the operators'
# line is left out with its margin and the next line is the caller's to lay
# out. A break is recorded only over a join (`state.Break`): its `after` is
# the first word of the line joined below it, and a line laid out on its own
# is none (`joined_lines` and `line_above` read the breaks as joins).
function offer(@l: state.LexState, d: diag.Diagnostic, text: str, at: i64) -> bool
    first = alone_from(l, at: at)
    operator = l.tokens[at]
    run = token.Span(start: l.tokens[first].span.start, end: operator.span.end)
    commented = l.tokens.len() > at + 1 || l.held.len() > 0
    readings = first == at && two_readings(text, operator: operator, below: l.pos)
    told: diag.Diagnostic @ d
    told.fixes @ fixes(
        text,
        run: run,
        readings: readings,
        arm: next_line.an_arm_below(text, at: l.pos),
        below: l.pos,
        commented: commented
    )

    if readings
        signed_below(@l, text, at: at)
    joined = readings || !leave_out(@l, text, first: first, at: at)
    state.push_diagnostic(@l.diagnostics, told)

    if joined
        state.push_break(@l.breaks, diagnostic: l.diagnostics.len() - 1, after: l.tokens.len(), head: false)
    return joined

# Whether the arm has two readings: the operator a `-` and the arm's line
# beginning with a literal it signs, so that joined and deleted are two
# programs. Anywhere else the deletion is the one repair.
function two_readings(text: str, operator: token.Token, below: i64) -> bool
    return operator.kind == .minus && signs_a_literal(text, at: below)

# The join and the deletion of the operators at `run` where the arm has two
# `readings`, both guesses; the deletion alone, certain, over any other arm,
# and a guess over a line that is no arm, whose operand may be what was left
# out (defect 370).
function fixes(text: str, run: token.Span, readings: bool, arm: bool, below: i64, commented: bool) -> [diag.Fix]
    out: [diag.Fix] @ []
    certainty: diag.Certainty @ .certain

    if !arm
        certainty @ .guess

    if readings
        certainty @ .guess

        # The join writes the sign against its literal, as `fmt` spells it,
        # on the arm's line and at its margin, the operator's line gone: at
        # another margin the arm joined there was a block of its own (268).
        if !commented
            line = word_place.line_start(text, at: below)
            sign = text.slice(from: line, to: below) + text.slice(from: run.start, to: run.end)
            out @ out.push(
                join_fix.made(glue: sign, from: word_place.line_start(text, at: run.start), to: below, certainty: .guess)
            )
    written = text.slice(from: run.start, to: run.end)
    out @ out.push(
        diag.Fix(title: "delete the `" + written + "`", replacement: "", span: deleted(text, operator: run), certainty: certainty)
    )
    return out

# Whether the arm's line begins with a literal a `-` signs, an integer or a
# character (spec § 8's `Pattern`; a string's sign is refused by its type). A
# run of digits is an integer unless a `.` and a digit follow it, the lexer's
# own rule for a float (`number.hero`).
function signs_a_literal(text: str, at: i64) -> bool
    if at >= text.len()
        return false

    if text[at] == '\''
        return true

    if !bytes.is_digit(text[at])
        return false
    i: i64 @ at

    while i < text.len() && (bytes.is_alnum(text[i]) || text[i] == '_')
        i @ i + 1

    return !(i + 1 < text.len() && text[i] == '.' && bytes.is_digit(text[i + 1]))

# What deleting the operator removes: its whole line, from the line's first
# byte through its line end; or, where a comment follows the operator, the
# operator and the spaces after it, the comment staying in its place.
function deleted(text: str, operator: token.Span) -> token.Span
    end: i64 @ operator.end

    while end < text.len() && (text[end] == ' ' || text[end] == '\t')
        end @ end + 1

    if end < text.len() && text[end] == '#'
        return token.Span(start: operator.start, end: end)
    start: i64 @ operator.start

    while start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\t')
        start @ start - 1

    if end < text.len() && text[end] == '\r'
        end @ end + 1

    if end < text.len() && text[end] == '\n'
        end @ end + 1
    return token.Span(start: start, end: end)

# The operators from `first` to `at` taken out of the stream, the comments
# after them kept, and the margin their line laid out taken back where it is
# plain: spaces
# alone, under no braces and no indentation habit. Its indent or dedents are
# the tokens just before the operator spanning the line's margin, and its
# reports, `indentation_jump` and `indentation_not_multiple_of_4` over that
# span, are the last said; the level goes back to the line above's. True
# where it was taken back. The operator is the last word lexed, so only its
# comments are moved, and only on this refusal's path, which no program that
# compiles reaches. Every index recorded so far stands before the margin: each
# break's `after`, and `open_line`, cleared before the refusal.
function leave_out(@l: state.LexState, text: str, first: i64, at: i64) -> bool
    plain = plain_margin(l, text, at: first)
    from: i64 @ first

    if plain
        from @ taken_back(@l, text, at: first)
    after: [token.Token] = l.tokens.slice(from: at + 1, to: l.tokens.len())
    l.tokens @ l.tokens.slice(from: 0, to: from)
    lex_asked.forget(@l.asked)

    for t in after
        state.push_token(@l.tokens, t)

    return plain

# Where both readings stand, the join is the stream, its sign read on the
# arm's line (defect 268): the margin the operator's line laid out, and the
# reports it said, are taken back and the arm's margin laid out in their
# place, before the operator, so the parser reads `-1 => …` where the arm
# stands. Deeper than the arms, the arm was joined at the operator's margin,
# a block deeper than anything that opens one, told `unexpected_block` beside
# the refusal, and two levels deeper `indentation_jump` too. Only over a plain
# margin and an arm at a plain one, the arm's level one at most past the
# level above, as `layout.line_start` would lay it out; elsewhere as before.
function signed_below(@l: state.LexState, text: str, at: i64)
    arm = word_place.line_start(text, at: l.pos)
    spaces = l.pos - arm
    line = word_place.line_start(text, at: l.tokens[at].span.start)

    if !plain_margin(l, text, at: at) || !spaces_alone(text, from: arm, to: l.pos) || spaces % 4 != 0 || spaces == l.tokens[at].span.start - line
        return
    above = level_above(l, text, at: at)

    if spaces / 4 > above + 1
        return
    operator: [token.Token] = l.tokens.slice(from: at, to: l.tokens.len())
    l.tokens @ l.tokens.slice(from: 0, to: taken_back(@l, text, at: at))
    lex_asked.forget(@l.asked)
    margin = token.Span(start: arm, end: l.pos)

    while l.level < spaces / 4
        state.push_token(@l.tokens, token.Token(kind: .indent, span: margin))
        l.level @ l.level + 1

    while l.level > spaces / 4
        state.push_token(@l.tokens, token.Token(kind: .dedent, span: margin))
        l.level @ l.level - 1

    for t in operator
        state.push_token(@l.tokens, t)

# Whether the margin of the line holding the token at `at` is plain: spaces
# alone, under no braces and no indentation habit, which keep their own count.
function plain_margin(l: state.LexState, text: str, at: i64) -> bool
    begins = l.tokens[at].span.start
    return l.braced.len() == 0 && l.run[0].kind == .none && spaces_alone(text, from: word_place.line_start(text, at: begins), to: begins)

# The level before the margin tokens the line holding the token at `at` laid
# out: the level of the line above it.
function level_above(l: state.LexState, text: str, at: i64) -> i64
    begins = l.tokens[at].span.start
    line = word_place.line_start(text, at: begins)
    from: i64 @ at
    level: i64 @ l.level

    while from > 0 && laid_out(l.tokens[from - 1], line: line, ends: begins)
        if l.tokens[from - 1].kind == .indent
            level @ level - 1
        else
            level @ level + 1
        from @ from - 1

    return level

# The margin the line holding the token at `at` laid out taken back: its
# reports unsaid, the level the line above's, and the index its tokens began
# at returned, the tokens themselves the caller's to cut.
function taken_back(@l: state.LexState, text: str, at: i64) -> i64
    begins = l.tokens[at].span.start
    line = word_place.line_start(text, at: begins)
    from: i64 @ at

    while from > 0 && laid_out(l.tokens[from - 1], line: line, ends: begins)
        from @ from - 1

    l.level @ level_above(l, text, at: at)

    while l.diagnostics.len() > 0 && said_of_margin(l.diagnostics[l.diagnostics.len() - 1], line: line, ends: begins)
        l.diagnostics @ l.diagnostics.slice(from: 0, to: l.diagnostics.len() - 1)

    return from

# Whether `t` is a margin token the line beginning at `line` laid out, its
# span that line's margin, to `ends`.
function laid_out(t: token.Token, line: i64, ends: i64) -> bool
    return (t.kind == .indent || t.kind == .dedent) && t.span.start == line && t.span.end == ends

# Whether `d` is a report the layout said of that margin.
function said_of_margin(d: diag.Diagnostic, line: i64, ends: i64) -> bool
    return (d.code == "indentation_jump" || d.code == "indentation_not_multiple_of_4") && d.span.start == line && d.span.end == ends

function spaces_alone(text: str, from: i64, to: i64) -> bool
    i: i64 @ from

    while i < to
        if text[i] != ' '
            return false
        i @ i + 1

    return true

## Tests

# The fixes over an arm, as before defect 369, one operator its own run.
function arm_fixes(text: str, operator: token.Token, below: i64, commented: bool) -> [diag.Fix]
    readings = two_readings(text, operator: operator, below: below)
    return fixes(text, run: operator.span, readings: readings, arm: true, below: below, commented: commented)

test "a literal a minus signs is an integer or a character, and nothing else"
    for text in ["1 => x", "'a' => x", "0x1f => x", "1_000 => x", "7"]
        assert signs_a_literal(text, at: 0)

    for text in ["\"a\" => x", "_ => x", ".red => x", "x => x", "1.5 => x", "-1 => x", ""]
        assert !signs_a_literal(text, at: 0)

test "an arm has two readings only below a minus, over a literal it signs"
    minus = token.Token(kind: .minus, span: token.Span(start: 0, end: 1))
    assert two_readings("-\n1 => x", operator: minus, below: 2)
    assert two_readings("-\n'a' => x", operator: minus, below: 2)
    assert !two_readings("-\nx => x", operator: minus, below: 2)

    others: [token.TokenKind] = [.plus, .star, .pipe, .and_and, .colon_colon]

    for kind in others
        operator = token.Token(kind: kind, span: token.Span(start: 0, end: 1))
        assert !two_readings("+\n1 => x", operator: operator, below: 2)

test "over an integer the join and the deletion are both guesses; over anything else the deletion is certain"
    minus = token.Token(kind: .minus, span: token.Span(start: 4, end: 5))
    text = "    -\n    1 => 10\n"
    both = arm_fixes(text, operator: minus, below: 10, commented: false)
    assert both.len() == 2
    assert both[0].title == join_fix.TITLE
    assert both[0].certainty == .guess
    assert both[1].certainty == .guess
    joined = text.slice(from: 0, to: both[0].span.start) + both[0].replacement + text.slice(from: both[0].span.end, to: text.len())
    assert joined == "    -1 => 10\n"
    gone = text.slice(from: 0, to: both[1].span.start) + both[1].replacement + text.slice(from: both[1].span.end, to: text.len())
    assert gone == "    1 => 10\n"

    # A string, so the deletion alone, and certain.
    quoted = "    -\n    \"a\" => 10\n"
    alone = arm_fixes(quoted, operator: minus, below: 10, commented: false)
    assert alone.len() == 1
    assert alone[0].certainty == .certain
    refusal: diag.Diagnostic @ diag.new_diagnostic(
        code: "continuation_outside_brackets",
        message: "m",
        span: token.Span(start: 4, end: 5)
    )
    refusal.fixes @ alone
    assert join_fix.index(refusal) == -1

    # Another operator signs nothing, even an integer: the deletion alone.
    added = "    +\n    1 => 10\n"
    plus = arm_fixes(
        added,
        operator: token.Token(kind: .plus, span: token.Span(start: 4, end: 5)),
        below: 10,
        commented: false
    )
    assert plus.len() == 1
    assert plus[0].title == "delete the `+`"
    assert plus[0].certainty == .certain
    assert added.slice(from: 0, to: plus[0].span.start) + added.slice(from: plus[0].span.end, to: added.len()) == "    1 => 10\n"

    # A comment after the `-`: no join across it, and the comment stays.
    noted = "    -  # a note\n    1 => 10\n"
    kept = arm_fixes(noted, operator: minus, below: 20, commented: true)
    assert kept.len() == 1
    assert kept[0].certainty == .guess
    assert noted.slice(from: 0, to: kept[0].span.start) + noted.slice(from: kept[0].span.end, to: noted.len()) == "    # a note\n    1 => 10\n"

    # CRLF: the line's two-byte end goes with it.
    crlf = "    -\r\n    1 => 10\r\n"
    ended = arm_fixes(crlf, operator: minus, below: 11, commented: false)
    assert crlf.slice(from: 0, to: ended[1].span.start) + crlf.slice(from: ended[1].span.end, to: crlf.len()) == "    1 => 10\r\n"

    # Deeper than the arm, the join writes the sign at the arm's margin, its
    # line gone (defect 268).
    deeper = "    0 => 5\n        -\n    1 => 10\n"
    sign = token.Token(kind: .minus, span: token.Span(start: 19, end: 20))
    moved = arm_fixes(deeper, operator: sign, below: 25, commented: false)[0]
    assert deeper.slice(from: 0, to: moved.span.start) + moved.replacement + deeper.slice(from: moved.span.end, to: deeper.len()) == "    0 => 5\n    -1 => 10\n"
    assert crlf.slice(from: 0, to: ended[0].span.start) + ended[0].replacement + crlf.slice(from: ended[0].span.end, to: crlf.len()) == "    -1 => 10\r\n"

# Defects 369 and 370: a run's deletion takes its whole line, certain over an
# arm, where no pattern begins with two operators, and a guess over a line
# that is no arm, whose operand may be what was left out.
test "operators alone are deleted as one run, a guess above what is no arm"
    run = token.Span(start: 4, end: 7)
    text = "    - -\n    1 => 10\n"
    over_an_arm = fixes(text, run: run, readings: false, arm: true, below: 12, commented: false)
    assert over_an_arm.len() == 1
    assert over_an_arm[0].title == "delete the `- -`"
    assert over_an_arm[0].certainty == .certain
    assert text.slice(from: 0, to: over_an_arm[0].span.start) + text.slice(from: over_an_arm[0].span.end, to: text.len()) == "    1 => 10\n"
    statement = "    - -\n    return k\n"
    over_a_statement = fixes(statement, run: run, readings: false, arm: false, below: 12, commented: false)
    assert over_a_statement[0].certainty == .guess
