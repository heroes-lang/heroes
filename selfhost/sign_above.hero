# A `-` alone on its line above an arm, and what refusing it offers
# (design.md §4.15, and §4.10's *two readings make two guesses*; panel 185
# R6; defect 159). `open_line.refuse_the_end` refuses the line as one that
# cannot end with `-`, and asks here for the fixes.
#
# The `-` signs the pattern below it, or it is a stray, a bullet or a slip,
# and the arm is the author's without it. Where the pattern is an integer or
# a character, both readings are programs and they mean two things: `-` over
# `1 => "one"`, with 1 matched, prints `one` with the `-` deleted and `many`
# joined, so both fixes are guesses, R6's rule for the same `-` set apart on
# the arm's own line. Anywhere else the join writes no pattern a `-` signs, a
# string, `_`, a case, a name, a float or a signed literal, so the deletion is
# the one repair, `certain`, and no join is offered. It was the join, with
# certainty, until defect 159, and `check --apply` wrote `-1 => "one"`, which
# checks clean and prints `many`.
#
# The deletion takes the `-`'s whole line, so the arm keeps its own margin. A
# comment after the `-` on its line stays where the `-` stood, and no join is
# offered across a comment, which it would carry into the arm.

use token
use diag
use bytes
use join_fix

# The fixes of the line that holds `sign` alone, above the arm whose first
# byte is `below`; `commented` where a comment stands between the two.
function fixes(text: str, sign: token.Span, below: i64, commented: bool) -> [diag.Fix]
    out: [diag.Fix] @ []
    certainty: diag.Certainty @ .certain

    if signs_a_literal(text, at: below)
        certainty @ .guess

        # The join writes the sign against its literal, as `fmt` spells it.
        if !commented
            out @ out.push(join_fix.made(glue: "", from: sign.end, to: below, certainty: .guess))
    out @ out.push(
        diag.Fix(title: "delete the `-`", replacement: "", span: deleted(text, sign: sign), certainty: certainty)
    )
    return out

# Whether the arm's line begins with a literal a `-` signs, an integer or a
# character (spec § 8's `Pattern`; a string's sign is refused by its type). A
# run of digits is an integer unless a `.` and a digit follow it, the lexer's
# own rule for a float (`number.hero`).
function signs_a_literal(text: str, at: i64) -> bool
    if at >= text.len()
        return false

    if text[at] == '\''
        return true

    if !bytes.is_digit(text[at])
        return false
    i: i64 @ at

    while i < text.len() && (bytes.is_alnum(text[i]) || text[i] == '_')
        i @ i + 1

    return !(i + 1 < text.len() && text[i] == '.' && bytes.is_digit(text[i + 1]))

# What deleting the `-` removes: its whole line, from the line's first byte
# through its line end; or, where a comment follows the `-`, the `-` and the
# spaces after it, the comment staying in its place.
function deleted(text: str, sign: token.Span) -> token.Span
    end: i64 @ sign.end

    while end < text.len() && (text[end] == ' ' || text[end] == '\t')
        end @ end + 1

    if end < text.len() && text[end] == '#'
        return token.Span(start: sign.start, end: end)
    start: i64 @ sign.start

    while start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\t')
        start @ start - 1

    if end < text.len() && text[end] == '\r'
        end @ end + 1

    if end < text.len() && text[end] == '\n'
        end @ end + 1
    return token.Span(start: start, end: end)

## Tests

test "a literal a minus signs is an integer or a character, and nothing else"
    for text in ["1 => x", "'a' => x", "0x1f => x", "1_000 => x", "7"]
        assert signs_a_literal(text, at: 0)

    for text in ["\"a\" => x", "_ => x", ".red => x", "x => x", "1.5 => x", "-1 => x", ""]
        assert !signs_a_literal(text, at: 0)

test "over an integer the join and the deletion are both guesses; over anything else the deletion is certain"
    text = "    -\n    1 => 10\n"
    both = fixes(text, sign: token.Span(start: 4, end: 5), below: 10, commented: false)
    assert both.len() == 2
    assert both[0].title == join_fix.TITLE
    assert both[0].certainty == .guess
    assert both[1].certainty == .guess
    joined = text.slice(from: 0, to: both[0].span.start) + both[0].replacement + text.slice(from: both[0].span.end, to: text.len())
    assert joined == "    -1 => 10\n"
    gone = text.slice(from: 0, to: both[1].span.start) + both[1].replacement + text.slice(from: both[1].span.end, to: text.len())
    assert gone == "    1 => 10\n"

    # A string, so the deletion alone, and certain.
    quoted = "    -\n    \"a\" => 10\n"
    alone = fixes(quoted, sign: token.Span(start: 4, end: 5), below: 10, commented: false)
    assert alone.len() == 1
    assert alone[0].certainty == .certain
    refusal: diag.Diagnostic @ diag.new_diagnostic(
        code: "continuation_outside_brackets",
        message: "m",
        span: token.Span(start: 4, end: 5)
    )
    refusal.fixes @ alone
    assert join_fix.index(refusal) == -1

    # A comment after the `-`: no join across it, and the comment stays.
    noted = "    -  # a note\n    1 => 10\n"
    kept = fixes(noted, sign: token.Span(start: 4, end: 5), below: 20, commented: true)
    assert kept.len() == 1
    assert kept[0].certainty == .guess
    assert noted.slice(from: 0, to: kept[0].span.start) + noted.slice(from: kept[0].span.end, to: noted.len()) == "    # a note\n    1 => 10\n"

    # CRLF: the line's two-byte end goes with it.
    crlf = "    -\r\n    1 => 10\r\n"
    ended = fixes(crlf, sign: token.Span(start: 4, end: 5), below: 11, commented: false)
    assert crlf.slice(from: 0, to: ended[1].span.start) + crlf.slice(from: ended[1].span.end, to: crlf.len()) == "    1 => 10\r\n"
    assert crlf.slice(from: 0, to: ended[0].span.start) + crlf.slice(from: ended[0].span.end, to: crlf.len()) == "    -1 => 10\r\n"
