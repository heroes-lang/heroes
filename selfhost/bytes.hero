# Byte classification — what Rust takes from std (`is_ascii_digit`,
# `is_ascii_alphanumeric`, `to_ascii_lowercase`), written out once for the
# port. A gap entry in measurement 009: the language has no character-class
# built-ins, and fifteen lines answer every question the lexer asks.

function is_digit(b: u8) -> bool
    return b >= '0' && b <= '9'

function is_alpha(b: u8) -> bool
    return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z'

function is_alnum(b: u8) -> bool
    return is_digit(b) || is_alpha(b)

# Lowercase one ASCII byte; everything else passes through.
function lower(b: u8) -> u8
    if b >= 'A' && b <= 'Z'
        return b + 32
    return b

test "the classes answer the scanner's questions"
    assert is_digit('7')
    assert !is_digit('a')
    assert is_alpha('z')
    assert is_alpha('Q')
    assert !is_alpha('_')
    assert is_alnum('0')
    assert lower('X') == 'x'
    assert lower('x') == 'x'
    assert lower('1') == '1'

# The one character that starts at `at`, read by the width its first byte
# gives (defect 103). `text.slice(from: at, to: text.len()).chars()[0]` is
# the same answer and copies the rest of the file to get it, once per escape
# and once per character of a character literal, which made lexing quadratic
# in the file. A `str` is well-formed UTF-8 (spec § 3), so the lead byte says
# how many follow; the end of the text bounds it either way.
function char_at(text: str, at: i64) -> str
    width: i64 @ 1
    lead = text[at]

    if lead >= 240
        width @ 4
    else if lead >= 224
        width @ 3
    else if lead >= 192
        width @ 2

    last: i64 @ at + width

    if last > text.len()
        last @ text.len()
    return text.slice(from: at, to: last)

## Tests

test "a character is read by the width its first byte gives, and no further"
    assert char_at("abc", 1) == "b"
    assert char_at("aéb", 1) == "é"
    assert char_at("x€", 1) == "€"
    assert char_at("😀!", 0) == "😀"
    assert char_at("a\\tb", 1) == "\\"
    assert char_at("a\tb", 1) == "\t"
