# One function per operator: every mutant it makes from one source, as text
# edits guided by the tree (design.md Part 11, `harness/mutations/operators.md`).
#
# Port of crates/heroes/src/mutate/edits.rs. Each operator imitates a
# *plausible* mistake — a habit carried from another language, a one-character
# slip, a forgotten piece — and is applied to every applicable site, one mutant
# per site, in arena order, so a run is reproducible from the compiler alone.
#
# EVERY MUTATION IS A TEXT EDIT GUIDED BY THE TREE: the parser finds the site,
# the edit rewrites those bytes, and the mutant goes back through the real
# frontend. Nothing here builds a tree by hand, which is what keeps the mutants
# plausible — they are programs somebody could have typed.
#
# The primitives these operators are written in — the text edit, the span
# arithmetic, the four questions about one node — live in `mutate_sites.hero`,
# split out when this file passed §11's 300 lines.
#
# One thing the port does that the Rust cannot: every `match` over `ExprKind`
# and `StmtKind` here NAMES every case, because `_` is forbidden on a variant
# (§4.7). So the day a new expression form arrives, these operators stop
# compiling instead of quietly skipping it — which is the difference between an
# instrument that grows with the language and one that silently stops measuring
# part of it.

use ast
use source
use token
use mutate_sites

# **The classic argument inversion** — the whole reason §4.9's same-typed
# argument rule exists. Label and value travel together, so a named call stays
# named and an inversion of `from:`/`to:` is a real swap.
function swap_args(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        given = mutate_sites.args_of(e)
        if given.len() < 2
            continue
        out @ out.push(mutate_sites.swapped(s: s, first: mutate_sites.whole_arg(a: a, arg: given[0]), second: mutate_sites.whole_arg(a: a, arg: given[1])))
    return out

# **A forgotten variant case.** The LAST arm, with the newline before it:
# deleting a middle arm would leave the indentation the parser reads, which is
# a different mutation.
function drop_case(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        arms = mutate_sites.arms_of(e)
        if arms.len() < 2
            continue
        last = arms[arms.len() - 1]
        out @ out.push(mutate_sites.edit(s: s, span: token.Span(start: mutate_sites.line_start(s: s, at: last.span.start), end: last.span.end), replacement: ""))
    return out

# **Mutability confusion**: `v: i64 @ 0` becomes `v = 0`. The annotation and
# the marker go, and the later `v @ …` lines are left alone — which is the
# mistake.
function forget_at_decl(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for st in a.stmts
        match st.kind
            .declare d =>
                value = a.exprs[d.value].span
                span = token.Span(start: d.name.start, end: value.start)
                out @ out.push(mutate_sites.edit(s: s, span: span, replacement: source.span_text(s, d.name) + " = "))
            .bind | .mutate | .return_stmt | .break_stmt | .continue_stmt => out @ out
            .while_stmt | .for_in | .assert_stmt | .expr_stmt | .error => out @ out
    return out

# **A silent new variable, the habit other languages leave behind**: the
# mutated name is misspelled, so `v @ v + 1` writes to something nobody
# declared.
function mutate_undeclared(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for st in a.stmts
        match st.kind
            .mutate m =>
                target = a.exprs[m.place]
                if mutate_sites.is_name(target)
                    out @ out.push(mutate_sites.edit(s: s, span: target.span, replacement: mutate_sites.slipped(source.span_text(s, target.span))))
            .bind | .declare | .return_stmt | .break_stmt | .continue_stmt => out @ out
            .while_stmt | .for_in | .assert_stmt | .expr_stmt | .error => out @ out
    return out

# **A lazy catch-all**: a variant arm's patterns replaced by `_`, which §4.7
# forbids on a variant.
function wildcard_variant(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        for arm in mutate_sites.arms_of(e)
            if arm.patterns.len() == 0
                continue
            if !mutate_sites.is_case(arm.patterns[0])
                continue
            last = arm.patterns[arm.patterns.len() - 1].span
            out @ out.push(mutate_sites.edit(s: s, span: token.Span(start: arm.patterns[0].span.start, end: last.end), replacement: "_"))
    return out

# **Style transfer from Python**: every label dropped at once, because the
# habit is not to write half of them.
function positional_named(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        given = mutate_sites.args_of(e)
        labelled: bool @ false
        for arg in given
            if !arg.name.is_err()
                labelled @ true
        if !labelled
            continue
        # Back to front, so each edit leaves the earlier offsets valid. The
        # text is rebuilt from the source every time rather than carried, so
        # one site's mutant never sees another's.
        text: str @ s.text
        i: i64 @ given.len() - 1
        while i >= 0
            match given[i].name
                .ok label =>
                    value = a.exprs[given[i].value].span
                    text @ text.slice(from: 0, to: label.start) + text.slice(from: value.start, to: text.len())
                .err _ => text @ text
            i @ i - 1
        out @ out.push(text)
    return out

# **An implicit-conversion prior**: `2` becomes `2.0` beside an `i64`.
#
# A DECIMAL `i64` only. Appending `.0` to `0xff` produces `0xff.0`, which dies
# in the lexer — so an operator named for an implicit-conversion prior would
# have been measuring the scanner instead, and scoring a kill it did not earn
# (panel 041). The narrowing is a fact about the characters in hand rather than
# a premise about the corpus (CLAUDE.md §11).
function mix_int_float(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        match e.kind
            .binary b =>
                for side in [b.left, b.right]
                    operand = a.exprs[side]
                    text = source.span_text(s, operand.span)
                    based = text.len() > 1 && text[0] == 48
                    if mutate_sites.is_int(operand) && !based
                        out @ out.push(mutate_sites.edit(s: s, span: operand.span, replacement: text + ".0"))
            .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => out @ out
            .null_ptr | .name | .hole | .error => out @ out
            .unary | .field | .index => out @ out
            .call | .method | .variant_case => out @ out
            .array | .map | .try_expr | .if_expr | .match_expr => out @ out
    return out

# **An inner-scope habit**: the same binding written again, immediately after,
# without an inner scope to make it legal.
function shadow(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for st in a.stmts
        match st.kind
            .bind _ =>
                start = mutate_sites.line_start(s: s, at: st.span.start)
                line = s.text.slice(from: start, to: st.span.end)
                if st.span.end <= s.text.len()
                    out @ out.push(mutate_sites.inserted(s: s, at: st.span.end, addition: "\n" + mutate_sites.trim_end(line)))
            .declare | .mutate | .return_stmt | .break_stmt | .continue_stmt => out @ out
            .while_stmt | .for_in | .assert_stmt | .expr_stmt | .error => out @ out
    return out

# **Forgotten error propagation**: the `?` dropped. It is the last byte of the
# expression, checked rather than assumed.
function drop_question(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        match e.kind
            .try_expr _ =>
                span = token.Span(start: e.span.end - 1, end: e.span.end)
                if source.span_text(s, span) == "?"
                    out @ out.push(mutate_sites.edit(s: s, span: span, replacement: ""))
            .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => out @ out
            .null_ptr | .name | .hole | .error => out @ out
            .unary | .binary | .field | .index => out @ out
            .call | .method | .variant_case => out @ out
            .array | .map | .if_expr | .match_expr => out @ out
    return out

# **`&&` written `&`, and `||` written `|`** — the boolean operator mistaken
# for its bitwise twin (§4.14; panel 040's own falsifier, added by author
# decision 2026-08-14).
#
# Panel 040 bought the bitwise set with a prediction that no survivor would
# ever be one of these, and `docs/measurements/007` scored it *held* over 892
# survivors — **vacuously**, because none of the twelve operators made the
# substitution. This is the arm.
#
# The mutation is a real mistake rather than a synthetic one: in C, Java, Go
# and Python-with-numpy the two spellings differ by short-circuiting and by
# nothing a reader sees on the line. In Heroes they should not both work —
# §4.14 makes `&&`/`||` take `bool` only and the bitwise set `i64` only, so the
# two vocabularies do not overlap and every one of these mutants should die.
#
# The span is the OPERATOR's own, which the tree does not carry, so it is found
# between the two operand spans — a fact about the two expressions in hand
# rather than a search of the line.
function boolean_twin(a: ast.Ast, s: source.Source) -> [str]
    out: [str] @ []
    for e in a.exprs
        match e.kind
            .binary b =>
                written = twin_of(b.op)
                if written.len() > 0
                    between = token.Span(start: a.exprs[b.left].span.end, end: a.exprs[b.right].span.start)
                    at = mutate_sites.index_of(text: source.span_text(s, between), needle: written)
                    if !at.is_err()
                        operator = token.Span(start: between.start + at.must(), end: between.start + at.must() + written.len())
                        out @ out.push(mutate_sites.edit(s: s, span: operator, replacement: written.slice(from: 0, to: 1)))
            .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit => out @ out
            .null_ptr | .name | .hole | .error => out @ out
            .unary | .field | .index => out @ out
            .call | .method | .variant_case => out @ out
            .array | .map | .try_expr | .if_expr | .match_expr => out @ out
    return out

# What is written for a short-circuiting operator, or "" for anything else.
function twin_of(op: ast.BinaryOp) -> str
    return match op
        .and => "&&"
        .or => "||"
        .add | .sub | .mul | .div | .rem => ""
        .eq | .ne | .lt | .le | .gt | .ge => ""
        .bit_and | .bit_or | .bit_xor | .shl | .shr => ""
