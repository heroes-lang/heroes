# The lowering walk: declarations, statements, places and expressions
# become instructions (design.md Part 10 step 6, §4.4, §4.7, §4.8, §4.9).
# Port of crates/heroes/src/ir/{decls,stmts,places,exprs}.rs, with
# {control,fallible,calls,ufcs,asserts,matches}.rs arriving in the next
# steps — the SIXTH knot the cycle rule has drawn, and the largest.
#
# THE KNOT'S MAP (CLAUDE.md §11's due for a module the language refuses
# to split): statements and expressions are mutually recursive by
# construction — a statement lowers its expressions, an if-expression
# lowers its blocks, a block lowers its statements. Entry points, top to
# bottom: lower() walks declarations; declaration() begins/ends one
# function; block() runs statements in order; statement() dispatches;
# expr() flattens one expression to a temporary; place() walks the left
# side of a mutation to a root and steps. Who calls whom: declaration ->
# block -> statement -> {expr, place, block (loops)}; expr -> {expr,
# block (if/match arms), place (@ arguments)}.
#
# Flattening is the whole job: `2 + 3 * 4` is a tree in the syntax and
# three instructions here, each naming temporaries and nothing nested.
# That is what makes the C emitter a printer rather than a second
# compiler, and what lets the ownership pass point at a single
# instruction and say "this one produced a value somebody owns".
#
# PORT SCAFFOLDING, the same trick the Rust uses on itself: a form whose
# lowering has not been ported yet emits `.missing`, which the verifier
# rejects — so an unfinished lowering can never reach a golden or a
# backend, and every stub is findable by grepping PORT-STUB.

use token
use ast
use source
use resolved
use check_table
use check_state
use check_contextual
use contextless_errors
use escape
use ir
use ir_state
use ir_build
use ir_layout
use parse
use resolve
use checker
use builtins

# Lower one checked file. Runs only on a tree that checked clean: after
# a type error the checker's answers are guesses, and expr_types would
# be error in places this pass reads as fact. It is the caller that
# declines to ask.
function lower(a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl]) -> ir_state.Lowered
    b: ir_build.Lowering @ ir_build.new_lowering(r, unit: check_table.unit_ty(c.types))
    index: i64 @ 0
    while index < decls.len()
        declaration(@b, a, r, c, s, decls, index)
        index @ index + 1
    # The resolver's stable sort, called across the module boundary
    # rather than copied: two sorts that could disagree are two answers
    # to one question.
    b.out.diagnostics @ resolve.by_position(b.out.diagnostics)
    return b.out

## One declaration at a time

# Four of the five declaration kinds produce a function in the IR:
# a function's body runs for effect and returns; a constant's body IS
# its value (a zero-argument function — no mutable globals exist); an
# extern contributes a signature and no blocks; a test is a
# zero-argument function entered only by `heroes test`. record and
# variant declare types — the descriptor pass is what turns them into
# copy/drop/eq/hash.
function declaration(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], index: i64)
    name = source.span_text(s, decls[index].name)
    match decls[index].kind
        .function_decl fd => lower_function(@b, a, r, c, s, decls, f: fd.value, index: index, name: name)
        .constant_decl k =>
            if !k.body.is_err()
                # The declared type is what the checker already checked
                # the body against.
                body = k.body.must()
                result = block_value_type(a, c, body)
                ir_build.begin(@b, name: name, decl: index, kind: .constant_kind, result: result, generics: [], span: decls[index].span)
                ir_build.entry(@b)
                value = block(@b, a, r, c, s, decls, body: body, wants_value: true)
                if !ir_build.is_terminated(b)
                    ir_build.terminate(@b, .return_term(value: value))
                ir_build.end_fn(@b)
            else
                # An extern constant: no body, so no blocks — the same
                # shape an extern function has. The result type comes
                # from the checker's table rather than from a body that
                # does not exist (§4.19, panel 038).
                result: i64 @ check_table.unit_ty(c.types)
                found = c.results[index]
                if !found.is_err()
                    result @ found.must()
                ir_build.begin(@b, name: name, decl: index, kind: .constant_kind, result: result, generics: [], span: decls[index].span)
                ir_build.end_fn(@b)
        .test_decl t =>
            # The name is the title, quotes included: it is a string
            # literal, not an identifier, and the dump prints what the
            # author wrote.
            ir_build.begin(@b, name: name, decl: index, kind: .test_kind, result: check_table.unit_ty(c.types), generics: [], span: decls[index].span)
            ir_build.entry(@b)
            _ = block(@b, a, r, c, s, decls, body: t.body, wants_value: false)
            if !ir_build.is_terminated(b)
                ir_build.terminate(@b, .return_term(value: fail("none", "a test returns nothing")))
            ir_build.end_fn(@b)
        .record_decl | .variant_decl => return

function lower_function(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], f: ast.FunctionDecl, index: i64, name: str)
    result: i64 @ check_table.unit_ty(c.types)
    found = c.results[index]
    if !found.is_err()
        result @ found.must()
    generics: [str] @ []
    for g in f.generics
        generics @ generics.push(source.span_text(s, g))
    kind: ir_state.FnKind @ .function_kind
    if f.is_extern
        kind @ .extern_kind
    ir_build.begin(@b, name: name, decl: index, kind: kind, result: result, generics: generics, span: decls[index].span)
    # Parameters are slots before anything else happens, so a
    # body's first instruction can already load one. The WRITTEN
    # type, not the local's: an extern has no locals (§4.19 — no
    # body to use them in) and its parameter types are exactly
    # what the emitter writes a C prototype from.
    for param in f.params
        ty: i64 @ check_table.error_ty(c.types)
        written = check_state.written_type(c, param.ty)
        if !written.is_err()
            ty @ written.must()
        slot = ir_build.param(@b, name: source.span_text(s, param.name), ty: ty, mutable: param.mutable)
        local = ir_build.local_at(b, param.name)
        if !local.is_err()
            ir_build.bind_local(@b, local: local.must(), slot_id: slot)
    if f.body.is_err()
        # An extern keeps its signature and gets no blocks
        # (§4.19): the implementation is in C, and clang
        # type-checks the call against the real header.
        ir_build.end_fn(@b)
    else
        ir_build.entry(@b)
        _ = block(@b, a, r, c, s, decls, body: f.body.must(), wants_value: false)
        close(@b, c)
        ir_build.end_fn(@b)

# The fall-through edge out of a function body. A body that runs off
# its end returns nothing — right for a () result, a program error
# otherwise, and the frontend already held that back as missing_return.
# Lowering does not invent a value: it emits the copy-out chain and
# return.
function close(@b: ir_build.Lowering, c: check_state.Checked)
    if ir_build.is_terminated(b)
        return
    copy_out(@b, c)
    ir_build.terminate(@b, .return_term(value: fail("none", "fell off the end")))

# §4.8's second half, on one exit edge: every @ parameter is written
# back before control leaves. Copy-out happens ALWAYS — including on
# early return and on `?` — so this is called from three places, and the
# dump shows the instructions rather than leaving them to the emitter's
# good intentions.
function copy_out(@b: ir_build.Lowering, c: check_state.Checked)
    unit = check_table.unit_ty(c.types)
    for param in ir_build.mutable_params(b)
        span = ir_build.declaration_span(b)
        ir_build.emit_void(@b, op: .copy_out(param: param), ty: unit, span: span)

## Statements

# Lowers a block's statements in order. A block is a straight line until
# something branches. wants_value is the constant-and-arm case: a
# block's value is its last statement when that statement is an
# expression (§4.7). A function body wants nothing — it hands its value
# back through return.
function block(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], body: ast.Block, wants_value: bool) -> i64?
    value: i64? @ fail("none", "no value yet")
    index: i64 @ 0
    for id in body.stmts
        if ir_build.is_terminated(b)
            break
        produced = statement(@b, a, r, c, s, decls, id)
        if wants_value && index == body.stmts.len() - 1
            value @ produced
        index @ index + 1
    return value

# The type a block produces: its last statement's, when that statement
# is an expression. Read straight out of the checker's dense table —
# lowering never re-derives a type it was given.
function block_value_type(a: ast.Ast, c: check_state.Checked, body: ast.Block) -> i64
    if body.stmts.len() == 0
        return check_table.unit_ty(c.types)
    last = a.stmts[body.stmts[body.stmts.len() - 1]]
    return match last.kind
        .expr_stmt e => c.expr_types[e.value]
        .bind | .declare | .mutate | .return_stmt | .break_stmt => check_table.unit_ty(c.types)
        .continue_stmt | .assert_stmt | .while_stmt | .for_in | .error => check_table.unit_ty(c.types)

# Lowers one statement. The fallible is its value, which only an
# expression statement has.
function statement(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], id: i64) -> i64?
    span = a.stmts[id].span
    match a.stmts[id].kind
        .bind bd =>
            bind_stmt(@b, a, r, c, s, decls, name: bd.name, value: bd.value, span: span)
            return fail("none", "a bind produces nothing")
        .declare dc =>
            bind_stmt(@b, a, r, c, s, decls, name: dc.name, value: dc.value, span: span)
            return fail("none", "a declare produces nothing")
        .mutate m =>
            target = place(@b, a, r, c, s, decls, id: m.place)
            produced = expr(@b, a, r, c, s, decls, id: m.value)
            ty = ir_build.value_ty(b, produced)
            ir_build.emit_void(@b, op: .store(place: target, value: produced), ty: ty, span: span)
            return fail("none", "a mutation produces nothing")
        .return_stmt ret =>
            if ret.value.is_err()
                copy_out(@b, c)
                ir_build.terminate(@b, .return_term(value: fail("none", "bare return")))
            else
                produced = expr(@b, a, r, c, s, decls, id: ret.value.must())
                # The copy-out chain goes AFTER the value is computed and
                # before control leaves: the returned value was read from
                # the pre-copy-out state, which is what "copy in, copy
                # out" means.
                copy_out(@b, c)
                ir_build.terminate(@b, .return_term(value: ok(produced)))
            return fail("none", "a return produces nothing")
        .break_stmt =>
            if b.loops.len() > 0
                ir_build.terminate(@b, .jump(to: b.loops[b.loops.len() - 1].break_to))
            return fail("none", "a break produces nothing")
        .continue_stmt =>
            if b.loops.len() > 0
                ir_build.terminate(@b, .jump(to: b.loops[b.loops.len() - 1].continue_to))
            return fail("none", "a continue produces nothing")
        .assert_stmt =>
            # PORT-STUB (asserts.rs): the assert lowering with both sides
            # carried arrives with the next step.
            ir_build.emit_void(@b, op: .missing, ty: check_table.unit_ty(c.types), span: span)
            return fail("none", "an assert produces nothing")
        .while_stmt w =>
            while_loop(@b, a, r, c, s, decls, cond: w.cond, body: w.block)
            return fail("none", "a loop produces nothing")
        .for_in fi =>
            for_loop(@b, a, r, c, s, decls, name: fi.name, iterable: fi.iterable, body: fi.block)
            return fail("none", "a loop produces nothing")
        .expr_stmt e =>
            # A statement's type must be () (panel 003), with one
            # exception the checker allows and this pass honours: a
            # match or if in statement position. Both lower the same way
            # in either position — the value is simply not used.
            return ok(expr(@b, a, r, c, s, decls, id: e.value))
        .error => return fail("none", "an error lowers to nothing")
    return fail("none", "unreached")

# `x = 5` and `v: i64 @ 0` are both slots by here: §4.4's mutation rule
# was enforced by the resolver, and the IR does not re-litigate it.
function bind_stmt(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], name: token.Span, value: i64, span: token.Span)
    produced = expr(@b, a, r, c, s, decls, id: value)
    # `_ = f(x)` binds nothing (§4.7): the resolver made no local for
    # it, so the call happens and the value is dropped.
    local = ir_build.local_at(b, name)
    if local.is_err()
        return
    ty = c.local_types[local.must()]
    slot = ir_build.slot(@b, name: source.span_text(s, name), ty: ty, kind: .local_slot)
    ir_build.bind_local(@b, local: local.must(), slot_id: slot)
    ir_build.store_slot(@b, slot_id: slot, value: produced, span: span)

## Places

# §4.8 wrote the specification in one sentence — "every place has
# exactly one root" — so a place is a slot plus a path of steps, never
# an expression. Evaluation order is left to right: the path's index
# expressions are lowered before the value being stored, because
# `xs[f()] @ g()` calls f first.
function place(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], id: i64) -> ir.Place
    steps: [ir.PathStep] @ []
    root = walk_place(@b, a, r, c, s, decls, id: id, steps: @steps)
    path = ir_build.steps_run(@b, steps)
    return ir.Place(root: root, path: path)

# Descends to the root, pushing steps on the way back out, so the path
# reads root-first — the order the emitter needs to spell `l.pos` and
# the order a reader expects.
function walk_place(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], id: i64, @steps: [ir.PathStep]) -> i64
    match a.exprs[id].kind
        .name =>
            match r.uses[id]
                .local l =>
                    slot = ir_build.slot_of_local(b, l.at)
                    if slot.is_err()
                        return orphan(@b, c, id)
                    return slot.must()
                .top | .builtin | .module | .unresolved => return orphan(@b, c, id)
        .field f =>
            owner = c.expr_types[f.base]
            root = walk_place(@b, a, r, c, s, decls, id: f.base, steps: @steps)
            found = ir_layout.field_index(decls, c, s, owner: owner, name: f.name)
            if !found.is_err()
                steps @ steps.push(.field_step(at: found.must()))
            return root
        .index ix =>
            root = walk_place(@b, a, r, c, s, decls, id: ix.base, steps: @steps)
            key = expr(@b, a, r, c, s, decls, id: ix.index)
            steps @ steps.push(.index_step(value: key))
            return root
        # Unreachable on a tree that checked clean: the parser only
        # accepts a name, a field path or an index path on the left of @
        # (§4.4), and the resolver rejected a root that is not a
        # binding. A slot is invented rather than aborting, because a
        # pass that aborts on a shape it did not expect is a pass that
        # cannot be trusted with the next one.
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return orphan(@b, c, id)
        .hole | .unary | .binary | .call | .method | .variant_case => return orphan(@b, c, id)
        .array | .map | .try_expr | .if_expr | .match_expr | .error => return orphan(@b, c, id)
    return orphan(@b, c, id)

function orphan(@b: ir_build.Lowering, c: check_state.Checked, id: i64) -> i64
    return ir_build.slot(@b, name: "$orphan", ty: c.expr_types[id], kind: .synthetic_slot)

## Control flow — three rows of Part 5's table erased

# The IR has no `if`, no `for` and no `&&`. It has blocks and two-way
# branches, and each surface form is a shape built out of them:
# while = test/body/exit; for = test/body/STEP/exit; if = one test and
# one arm per branch, then a join; && = the right side, then a join.
# A branching expression's value is a SLOT: each arm stores into $r and
# the join loads it — what replaces a phi node, and why a join needs no
# argument list.

# `while cond` — the condition loop (§4.7; panel 018 gave it its own
# keyword). continue targets the test: a while has nothing to step.
function while_loop(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], cond: i64, body: ast.Block)
    head = ir_build.block(@b, note: "while: test")
    inside = ir_build.block(@b, note: "while: body")
    leave = ir_build.block(@b, note: "while: exit")
    ir_build.terminate(@b, .jump(to: head))
    ir_build.switch_to(@b, target: head)
    value = expr(@b, a, r, c, s, decls, id: cond)
    ir_build.terminate(@b, .branch(cond: value, then_to: inside, else_to: leave))
    b.loops @ b.loops.push(ir_build.LoopEdges(break_to: leave, continue_to: head))
    ir_build.switch_to(@b, target: inside)
    _ = block(@b, a, r, c, s, decls, body: body, wants_value: false)
    ir_build.terminate(@b, .jump(to: head))
    b.loops @ b.loops.slice(from: 0, to: b.loops.len() - 1)
    ir_build.switch_to(@b, target: leave)

# `for x in xs` — Part 5's row, erased: a while with an index. The
# iterable is evaluated ONCE, into a slot, because `for x in f()` must
# not call f per iteration. The index is $i<n>: a name the author
# cannot have written, so it cannot shadow anything and cannot be
# reported unused (§4.4 twice).
function for_loop(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], name: token.Span, iterable: i64, body: ast.Block)
    int_id = check_table.int_ty_id(c.types)
    bool_id = check_table.bool_ty(c.types)
    sequence_ty = c.expr_types[iterable]
    sequence = expr(@b, a, r, c, s, decls, id: iterable)
    holder = ir_build.synthetic(@b, prefix: "xs", ty: sequence_ty)
    ir_build.store_slot(@b, slot_id: holder, value: sequence, span: name)
    index = ir_build.synthetic(@b, prefix: "i", ty: int_id)
    zero = ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: false, magnitude: 0))), ty: int_id, span: name)
    ir_build.store_slot(@b, slot_id: index, value: zero, span: name)
    # The loop variable is a real local: the resolver made it and the
    # body reads it by name. `for _ in xs` names nothing (§4.7), so it
    # gets no slot and the body never reads an element — the loop is
    # being run for its count.
    element: i64? @ fail("none", "no loop variable")
    element_ty: i64 @ int_id
    local = ir_build.local_at(b, name)
    if !local.is_err()
        element_ty @ c.local_types[local.must()]
        slot = ir_build.slot(@b, name: source.span_text(s, name), ty: element_ty, kind: .local_slot)
        ir_build.bind_local(@b, local: local.must(), slot_id: slot)
        element @ ok(slot)
    head = ir_build.block(@b, note: "for: test")
    inside = ir_build.block(@b, note: "for: body")
    step = ir_build.block(@b, note: "for: step")
    leave = ir_build.block(@b, note: "for: exit")
    ir_build.terminate(@b, .jump(to: head))
    ir_build.switch_to(@b, target: head)
    i = ir_build.load_slot(@b, slot_id: index, span: name)
    xs = ir_build.load_slot(@b, slot_id: holder, span: name)
    length = ir_build.emit(@b, op: .len_of(value: xs), ty: int_id, span: name)
    more = ir_build.emit(@b, op: .binary(op: .lt, left: i, right: length), ty: bool_id, span: name)
    ir_build.terminate(@b, .branch(cond: more, then_to: inside, else_to: leave))
    ir_build.switch_to(@b, target: inside)
    if !element.is_err()
        xs_again = ir_build.load_slot(@b, slot_id: holder, span: name)
        i_again = ir_build.load_slot(@b, slot_id: index, span: name)
        item = ir_build.emit(@b, op: .index(base: xs_again, at: i_again), ty: element_ty, span: name)
        ir_build.store_slot(@b, slot_id: element.must(), value: item, span: name)
    # continue lands on the STEP, not the test: the increment owes
    # itself to that path as much as to the fall-through.
    b.loops @ b.loops.push(ir_build.LoopEdges(break_to: leave, continue_to: step))
    _ = block(@b, a, r, c, s, decls, body: body, wants_value: false)
    ir_build.terminate(@b, .jump(to: step))
    b.loops @ b.loops.slice(from: 0, to: b.loops.len() - 1)
    ir_build.switch_to(@b, target: step)
    i_step = ir_build.load_slot(@b, slot_id: index, span: name)
    one = ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: false, magnitude: 1))), ty: int_id, span: name)
    next = ir_build.emit(@b, op: .binary(op: .add, left: i_step, right: one), ty: int_id, span: name)
    ir_build.store_slot(@b, slot_id: index, value: next, span: name)
    ir_build.terminate(@b, .jump(to: head))
    ir_build.switch_to(@b, target: leave)

# `if c` / `else if c` / `else` — an expression like everything else
# (§4.7), so one routine serves both positions. In statement position
# the join slot is simply never loaded.
function if_expr(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], branches: [ast.Branch], otherwise: ast.Block?, ty: i64, span: token.Span) -> i64
    wants_value = ty != ir_build.unit_ty(b) && ty != check_table.error_ty(c.types)
    result: i64? @ fail("none", "statement position")
    if wants_value
        result @ ok(ir_build.synthetic(@b, prefix: "r", ty: ty))
    meet = ir_build.block(@b, note: "if: join")
    for branch in branches
        cond = expr(@b, a, r, c, s, decls, id: branch.cond)
        then_block = ir_build.block(@b, note: "if: then")
        next = ir_build.block(@b, note: "if: else")
        ir_build.terminate(@b, .branch(cond: cond, then_to: then_block, else_to: next))
        ir_build.switch_to(@b, target: then_block)
        value = block(@b, a, r, c, s, decls, body: branch.block, wants_value: wants_value)
        store_arm(@b, result: result, value: value, span: span)
        ir_build.terminate(@b, .jump(to: meet))
        ir_build.switch_to(@b, target: next)
    # No else means the fall-through IS the missing arm. An if used as a
    # value always has one (§4.7), so that only happens in statement
    # position.
    if !otherwise.is_err()
        value = block(@b, a, r, c, s, decls, body: otherwise.must(), wants_value: wants_value)
        store_arm(@b, result: result, value: value, span: span)
    ir_build.terminate(@b, .jump(to: meet))
    ir_build.switch_to(@b, target: meet)
    return seal_join(@b, meet: meet, result: result, span: span)

# `a && b` and `a || b` — not instructions. §4.14 makes them
# short-circuit, so the right side is evaluated on one edge only, and
# that is a branch. The asymmetry IS the operator: && evaluates the
# right side when the left is true, || when it is false.
function short_circuit(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], op: ast.BinaryOp, left: i64, right: i64, ty: i64, span: token.Span) -> i64
    result = ir_build.synthetic(@b, prefix: "b", ty: ty)
    first = expr(@b, a, r, c, s, decls, id: left)
    ir_build.store_slot(@b, slot_id: result, value: first, span: span)
    is_and: bool @ false
    match op
        .and => is_and @ true
        .add | .sub | .mul | .div | .rem | .eq | .ne | .lt | .le | .gt | .ge => is_and @ is_and
        .or | .bit_and | .bit_or | .bit_xor | .shl | .shr => is_and @ is_and
    rest: i64 @ 0
    meet: i64 @ 0
    if is_and
        rest @ ir_build.block(@b, note: "&&: right")
        meet @ ir_build.block(@b, note: "&&: join")
        ir_build.terminate(@b, .branch(cond: first, then_to: rest, else_to: meet))
    else
        rest @ ir_build.block(@b, note: "||: right")
        meet @ ir_build.block(@b, note: "||: join")
        ir_build.terminate(@b, .branch(cond: first, then_to: meet, else_to: rest))
    ir_build.switch_to(@b, target: rest)
    second = expr(@b, a, r, c, s, decls, id: right)
    ir_build.store_slot(@b, slot_id: result, value: second, span: span)
    ir_build.terminate(@b, .jump(to: meet))
    ir_build.switch_to(@b, target: meet)
    return ir_build.load_slot(@b, slot_id: result, span: span)

# Writes an arm's value into the join slot, when there is one of each.
function store_arm(@b: ir_build.Lowering, result: i64?, value: i64?, span: token.Span)
    if result.is_err() || value.is_err()
        return
    ir_build.store_slot(@b, slot_id: result.must(), value: value.must(), span: span)

# Closes a join: load the value if there is one, and say unreachable
# when nothing reaches here — which happens when every arm jumped or
# returned. A match all of whose arms diverge is legal in statement
# position (panel 017 A), so this is a real shape and not a defensive
# branch.
function seal_join(@b: ir_build.Lowering, meet: i64, result: i64?, span: token.Span) -> i64
    if !ir_build.has_preds(b, target: meet)
        ir_build.terminate(@b, .unreachable)
        return ir_build.unit_value()
    if result.is_err()
        return ir_build.unit_value()
    return ir_build.load_slot(@b, slot_id: result.must(), span: span)

## T? — the four rows of Part 5's table that read a tag (§4.6)

# A T? is a built-in variant with two cases, ok at tag 0 and err at tag
# 1. Everything below is that one fact, applied: ok/fail are
# constructions; .is_err() is a tag read and one comparison, NO branch;
# .must() is a branch to the payload or an abort; .default(v) is a
# branch and a join slot; e? is a branch and an EARLY RETURN THAT
# COPIES OUT — §4.8's own sentence names ? beside return, so the error
# edge owes the same chain.

# ok and fail are built-ins so that the names resolve; here they are
# constructions, because that is what they do (panel 002: they are
# check-only, so which T? is being built was decided by the checker).
function fallible_constructor(name: str) -> ir.Shape?
    if name == "ok"
        return ok(.ok_shape)
    if name == "fail"
        return ok(.fail_shape)
    return fail("absent", "not a fallible constructor")

function is_fallible_operation(name: str) -> bool
    return name == "must" || name == "default" || name == "is_err"

# .must(), .default(v), .is_err() — Part 5 calls all three "match", and
# only two of them need an edge.
function fallible_operation(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], name: str, receiver: i64, given: [ast.Arg], ty: i64, span: token.Span) -> i64
    subject = hold(@b, a, r, c, s, decls, held_expr: receiver, span: span)
    int_id = check_table.int_ty_id(c.types)
    if name == "is_err"
        # A tag read and a comparison: no control flow at all, which is
        # why this row of the table is the cheap one.
        tag = read_tag(@b, c, subject: subject, span: span)
        one = ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: false, magnitude: 1))), ty: int_id, span: span)
        return ir_build.emit(@b, op: .binary(op: .eq, left: tag, right: one), ty: ty, span: span)
    if name == "must"
        good = ir_build.block(@b, note: "must: ok")
        bad = ir_build.block(@b, note: "must: abort")
        branch_on_ok(@b, c, subject: subject, good: good, bad: bad, span: span)
        ir_build.switch_to(@b, target: bad)
        # THE FAILURE TRAVELS WITH THE ABORT. Without it the panic can
        # only say that a .must() failed, which is the one thing the
        # reader already knows; with it, it says the code and msg the
        # author wrote (§4.6). The read happens INSIDE the abort block,
        # so nothing counted crosses a block edge.
        failure = payload_of(@b, subject: subject, at: 1, ty: check_table.failure_ty(c.types), span: span)
        carried = ir_build.args_run(@b, [.value_arg(value: failure)])
        ir_build.emit_void(@b, op: .abort_op(why: .must_abort, arguments: carried), ty: ir_build.unit_ty(b), span: span)
        ir_build.terminate(@b, .unreachable)
        ir_build.switch_to(@b, target: good)
        return payload_of(@b, subject: subject, at: 0, ty: ty, span: span)
    # .default(v): two edges into one slot, the same shape an if with a
    # value has.
    result = ir_build.synthetic(@b, prefix: "r", ty: ty)
    good = ir_build.block(@b, note: "default: ok")
    fallback = ir_build.block(@b, note: "default: else")
    meet = ir_build.block(@b, note: "default: join")
    branch_on_ok(@b, c, subject: subject, good: good, bad: fallback, span: span)
    ir_build.switch_to(@b, target: good)
    value = payload_of(@b, subject: subject, at: 0, ty: ty, span: span)
    ir_build.store_slot(@b, slot_id: result, value: value, span: span)
    ir_build.terminate(@b, .jump(to: meet))
    ir_build.switch_to(@b, target: fallback)
    fallback_value: i64 @ 0
    if given.len() > 0
        fallback_value @ expr(@b, a, r, c, s, decls, id: given[0].value)
    else
        fallback_value @ ir_build.emit(@b, op: .missing, ty: ty, span: span)
    ir_build.store_slot(@b, slot_id: result, value: fallback_value, span: span)
    ir_build.terminate(@b, .jump(to: meet))
    ir_build.switch_to(@b, target: meet)
    return ir_build.load_slot(@b, slot_id: result, span: span)

# e? — propagate (§4.6). The error edge is an exit edge, so it copies
# out. The error itself propagates UNCHANGED — err_shape wraps the
# failure that already exists rather than re-reading its code and msg,
# because a ? that rebuilt the error would lose whatever the callee put
# there.
function try_expr(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], inner: i64, ty: i64, span: token.Span) -> i64
    subject = hold(@b, a, r, c, s, decls, held_expr: inner, span: span)
    good = ir_build.block(@b, note: "?: ok")
    bad = ir_build.block(@b, note: "?: propagate")
    branch_on_ok(@b, c, subject: subject, good: good, bad: bad, span: span)
    ir_build.switch_to(@b, target: bad)
    failure = payload_of(@b, subject: subject, at: 1, ty: check_table.failure_ty(c.types), span: span)
    # The caller's T?, carrying the callee's failure unchanged. The
    # result type is the enclosing function's, which ? already required
    # to be fallible.
    run = ir_build.args_run(@b, [.value_arg(value: failure)])
    wrapped = ir_build.emit(@b, op: .construct(shape: .err_shape, arguments: run), ty: ir_build.result_type(b), span: span)
    copy_out(@b, c)
    ir_build.terminate(@b, .return_term(value: ok(wrapped)))
    ir_build.switch_to(@b, target: good)
    return payload_of(@b, subject: subject, at: 0, ty: ty, span: span)

# Puts the subject in a slot. Every one of these forms reads it twice —
# once for the tag, once for the payload — and f()? must not call f
# twice.
function hold(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], held_expr: i64, span: token.Span) -> i64
    ty = c.expr_types[held_expr]
    value = expr(@b, a, r, c, s, decls, id: held_expr)
    slot = ir_build.synthetic(@b, prefix: "f", ty: ty)
    ir_build.store_slot(@b, slot_id: slot, value: value, span: span)
    return slot

function read_tag(@b: ir_build.Lowering, c: check_state.Checked, subject: i64, span: token.Span) -> i64
    held = ir_build.load_slot(@b, slot_id: subject, span: span)
    return ir_build.emit(@b, op: .tag_of(value: held), ty: check_table.int_ty_id(c.types), span: span)

# The branch all three operations share: tag 0 is ok.
function branch_on_ok(@b: ir_build.Lowering, c: check_state.Checked, subject: i64, good: i64, bad: i64, span: token.Span)
    tag = read_tag(@b, c, subject: subject, span: span)
    zero = ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: false, magnitude: 0))), ty: check_table.int_ty_id(c.types), span: span)
    fine = ir_build.emit(@b, op: .binary(op: .eq, left: tag, right: zero), ty: check_table.bool_ty(c.types), span: span)
    ir_build.terminate(@b, .branch(cond: fine, then_to: good, else_to: bad))

function payload_of(@b: ir_build.Lowering, subject: i64, at: i64, ty: i64, span: token.Span) -> i64
    held = ir_build.load_slot(@b, slot_id: subject, span: span)
    return ir_build.emit(@b, op: .payload(base: held, at: at), ty: ty, span: span)

## Calls, construction, and UFCS erased (§4.9, §4.11, §4.13, §4.19)

# Two of Part 5's rows cost nothing here, and the reason is a surface
# rule: a label in Heroes does not REORDER an argument — the checker
# verified the label at a position against the parameter AT that
# position, so "named -> positional" is erased by simply not carrying
# the label. Callee is where this file earns its keep (panel 019's most
# expensive finding): a Heroes `function open` reaching C unmangled
# replaces libc's, clang says nothing, and the program prints 7 instead
# of a file descriptor. Recording the linkage here is what stops the
# emitter from re-deriving it and getting it wrong.

# `f(x)`, `Point(x: 3, y: 4)`, `ok(v)`, `fail(c, m)`, `h.cb(n)` — one
# syntax, and what it IS depends on what the callee resolved to.
function call(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], callee: i64, given: [ast.Arg], ty: i64, span: token.Span) -> i64
    is_name: bool @ false
    match a.exprs[callee].kind
        .name => is_name @ true
        .int_lit | .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => is_name @ is_name
        .hole | .unary | .binary | .field | .index | .call | .method => is_name @ is_name
        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error => is_name @ is_name
    if is_name
        match r.uses[callee]
            .top t =>
                # Record construction IS a call with named arguments
                # (§4.9), so the surface needs no node of its own — but
                # the IR does, because the layout decision belongs to the
                # descriptor pass.
                if is_record(decls, t.at)
                    run = lower_args(@b, a, r, c, s, decls, given: given)
                    return ir_build.emit(@b, op: .construct(shape: .record_shape(decl: t.at), arguments: run), ty: ty, span: span)
                run = lower_args(@b, a, r, c, s, decls, given: given)
                return emit_call(@b, target: callee_of(decls, t.at), run: run, variadic: false, ty: ty, span: span)
            .builtin bt =>
                builtin_name = builtins.table()[bt.at].name
                # `.cstr()` is a CAST, not a call: §4.3's no-implicit-
                # conversions rule would be invisible in the dump if the
                # conversion were hidden inside a call.
                if builtin_name == "cstr"
                    operand = expr(@b, a, r, c, s, decls, id: given[0].value)
                    return ir_build.emit(@b, op: .cast(kind: .str_to_cstr, operand: operand), ty: ty, span: span)
                # ok/fail build the two sides of a T? (§4.6, panel 002).
                shape = fallible_constructor(builtin_name)
                if !shape.is_err()
                    run = lower_args(@b, a, r, c, s, decls, given: given)
                    return ir_build.emit(@b, op: .construct(shape: shape.must(), arguments: run), ty: ty, span: span)
                run = lower_args(@b, a, r, c, s, decls, given: given)
                return emit_call(@b, target: .builtin_fn(at: bt.at), run: run, variadic: is_variadic(builtin_name), ty: ty, span: span)
            # A local holding a function value (§4.13) — and geom(...),
            # which the checker refused, since lowering only runs on a
            # clean program.
            .module | .local | .unresolved => is_name @ is_name
    target = expr(@b, a, r, c, s, decls, id: callee)
    run = lower_args(@b, a, r, c, s, decls, given: given)
    return emit_call(@b, target: .indirect(value: target), run: run, variadic: false, ty: ty, span: span)

function is_record(decls: [ast.Decl], decl: i64) -> bool
    return match decls[decl].kind
        .record_decl => true
        .constant_decl | .function_decl | .variant_decl | .test_decl => false

# `.num(v: 12)` — a case construction: the type is the VARIANT, the
# name picks the case, and both were the checker's decisions.
function case_construct(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], name: token.Span, given: [ast.Arg], ty: i64, span: token.Span) -> i64
    match check_table.get(c.types, ty)
        .named n =>
            found = ir_layout.case_index(decls, s, decl: n.decl, name: name)
            if found.is_err()
                return ir_build.emit(@b, op: .missing, ty: ty, span: span)
            run = lower_args(@b, a, r, c, s, decls, given: given)
            return ir_build.emit(@b, op: .construct(shape: .case_shape(decl: n.decl, at: found.must()), arguments: run), ty: ty, span: span)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
        .array | .fixed | .map | .fallible | .function_ty => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
        .case_ty | .failure | .generic | .error => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
    return ir_build.emit(@b, op: .missing, ty: ty, span: span)

# A call, with the one thing the C proved: AT MOST ONE DESTINATION.
# `dst = call print(x)` is a hard clang error and raylib is almost
# entirely void-returning, so a () result produces no destination at
# all — the value handed back is the function-wide unit, which no
# instruction defines.
function emit_call(@b: ir_build.Lowering, target: ir.Callee, run: ir.Run, variadic: bool, ty: i64, span: token.Span) -> i64
    if ty == ir_build.unit_ty(b)
        ir_build.emit_void(@b, op: .call(callee: target, arguments: run, variadic: variadic), ty: ty, span: span)
        return ir_build.unit_value()
    return ir_build.emit(@b, op: .call(callee: target, arguments: run, variadic: variadic), ty: ty, span: span)

# Lowers the written arguments, left to right. `@x` at the call site
# becomes a PLACE, not a value: the callee copies in and copies out, so
# it needs to know where to write back (§4.8). The label is dropped
# here — it was checked against the parameter at this position and
# carries no further meaning.
function lower_args(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], given: [ast.Arg]) -> ir.Run
    lowered_args: [ir.Arg] @ []
    for arg in given
        if arg.mutable
            spot = place(@b, a, r, c, s, decls, id: arg.value)
            lowered_args @ lowered_args.push(.inout_arg(place: spot))
        else
            value = expr(@b, a, r, c, s, decls, id: arg.value)
            lowered_args @ lowered_args.push(.value_arg(value: value))
    return ir_build.args_run(@b, lowered_args)

# The UFCS shape: the receiver becomes argument zero. §4.11 forbids
# this where the first parameter is @, so the receiver is always a
# value.
function with_receiver(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], receiver: i64, given: [ast.Arg]) -> ir.Run
    first = expr(@b, a, r, c, s, decls, id: receiver)
    lowered_args: [ir.Arg] @ [.value_arg(value: first)]
    for arg in given
        if arg.mutable
            spot = place(@b, a, r, c, s, decls, id: arg.value)
            lowered_args @ lowered_args.push(.inout_arg(place: spot))
        else
            value = expr(@b, a, r, c, s, decls, id: arg.value)
            lowered_args @ lowered_args.push(.value_arg(value: value))
    return ir_build.args_run(@b, lowered_args)

# The one call shape clang verifies nothing about (§4.19): print today,
# TextFormat and sqlite3_mprintf at the boundary, where a wrong argument
# count compiles, runs, and prints garbage.
function is_variadic(name: str) -> bool
    return name == "print"

## `x.f(y)` — the three tokens with two meanings (§4.11, §4.13; panel 079)

# The same three tokens are either a call to a free function with the
# receiver first, or a read of a FIELD that holds a function value —
# and only the receiver's type settles which. The two halves live in
# one place on purpose: they used to disagree (the resolver answers
# top whenever a free function of that name exists, whether or not the
# receiver has the field), and the disagreement printed 50007 against
# 100 at exit 0, then a clang type confusion at exit 2. One rule, asked
# once: THE FIELD FIRST, then whatever the resolver said.
function method(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], at: i64, receiver: i64, name: token.Span, given: [ast.Arg], ty: i64, span: token.Span) -> i64
    # The resolver filed the method name's meaning at the method node
    # itself: the name after the dot has no expression id of its own.
    # The qualified form first: the receiver names a module, erased here
    # exactly as it is erased in the C.
    is_qualified: bool @ false
    match r.uses[receiver]
        .module => is_qualified @ true
        .local | .top | .builtin | .unresolved => is_qualified @ is_qualified
    if is_qualified
        match r.uses[at]
            .top t =>
                run = lower_args(@b, a, r, c, s, decls, given: given)
                # A record is constructed, not called — the same split
                # call makes.
                if is_record(decls, t.at)
                    return ir_build.emit(@b, op: .construct(shape: .record_shape(decl: t.at), arguments: run), ty: ty, span: span)
                return emit_call(@b, target: callee_of(decls, t.at), run: run, variadic: false, ty: ty, span: span)
            .local | .builtin | .module | .unresolved => is_qualified @ is_qualified
    # .must(), .default(v) and .is_err() are branches, not calls
    # (Part 5): they read a tag and choose an edge.
    match r.uses[at]
        .builtin bt =>
            if is_fallible_operation(builtins.table()[bt.at].name)
                return fallible_operation(@b, a, r, c, s, decls, name: builtins.table()[bt.at].name, receiver: receiver, given: given, ty: ty, span: span)
        .local | .top | .module | .unresolved => is_qualified @ is_qualified
    # §4.11's order, asked HERE too, because this pass used to answer it
    # differently from the checker (panel 079): the field first, and
    # only a field whose type is a function value.
    field_ty = ir_layout.field_type(decls, c, s, owner: c.expr_types[receiver], name: name)
    if !field_ty.is_err()
        is_function: bool @ false
        match check_table.get(c.types, field_ty.must())
            .function_ty => is_function @ true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_function @ is_function
            .array | .fixed | .map | .fallible | .named => is_function @ is_function
            .case_ty | .failure | .generic | .error => is_function @ is_function
        if is_function
            return field_call(@b, a, r, c, s, decls, receiver: receiver, name: name, given: given, ty: ty, span: span)
    match r.uses[at]
        .builtin bt =>
            builtin_name = builtins.table()[bt.at].name
            # `s.cstr()` — the same cast the plain-call form makes, and
            # the shape every program actually writes. Taken before the
            # arguments are lowered, because a cast has exactly one
            # operand and it is the receiver.
            if builtin_name == "cstr"
                operand = expr(@b, a, r, c, s, decls, id: receiver)
                return ir_build.emit(@b, op: .cast(kind: .str_to_cstr, operand: operand), ty: ty, span: span)
            run = with_receiver(@b, a, r, c, s, decls, receiver: receiver, given: given)
            return emit_call(@b, target: .builtin_fn(at: bt.at), run: run, variadic: is_variadic(builtin_name), ty: ty, span: span)
        .top t =>
            run = with_receiver(@b, a, r, c, s, decls, receiver: receiver, given: given)
            return emit_call(@b, target: callee_of(decls, t.at), run: run, variadic: false, ty: ty, span: span)
        # h.cb(n) where cb is a field holding a function value: the dot
        # is a FIELD READ, not a receiver (§4.11's first lookup, §4.13).
        # A module receiver never reaches here — the branch above
        # returned.
        .module | .local | .unresolved =>
            return field_call(@b, a, r, c, s, decls, receiver: receiver, name: name, given: given, ty: ty, span: span)
    return ir_build.emit(@b, op: .missing, ty: ty, span: span)

# h.cb(n): the dot is a field read. Split out (panel 079) so the two
# callers cannot drift: the resolver's fallback reaches it, and so does
# §4.11's field-first order above.
function field_call(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], receiver: i64, name: token.Span, given: [ast.Arg], ty: i64, span: token.Span) -> i64
    owner = c.expr_types[receiver]
    base = expr(@b, a, r, c, s, decls, id: receiver)
    # The field's OWN type, read from the declaration that wrote it —
    # this used to be the call's result under an expired premise, and
    # the emitted C blamed itself for a correct program (panel 068 F8).
    # The fallback is deliberate: a field the checker could not resolve
    # has already been reported, and lowering stays quiet.
    function_ty: i64 @ ty
    written = ir_layout.field_type(decls, c, s, owner: owner, name: name)
    if !written.is_err()
        function_ty @ written.must()
    found = ir_layout.field_index(decls, c, s, owner: owner, name: name)
    target: i64 @ 0
    if found.is_err()
        target @ ir_build.emit(@b, op: .missing, ty: function_ty, span: span)
    else
        target @ ir_build.emit(@b, op: .field(base: base, at: found.must()), ty: function_ty, span: span)
    run = lower_args(@b, a, r, c, s, decls, given: given)
    return emit_call(@b, target: .indirect(value: target), run: run, variadic: false, ty: ty, span: span)

## Expressions

function expr(@b: ir_build.Lowering, a: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], id: i64) -> i64
    span = a.exprs[id].span
    ty = c.expr_types[id]
    match a.exprs[id].kind
        .int_lit => return emit_int(@b, a, s, id: id, ty: ty, span: span)
        .float_lit => return ir_build.emit(@b, op: .lit(value: .float_const(text: source.span_text(s, span))), ty: ty, span: span)
        .bool_lit => return ir_build.emit(@b, op: .lit(value: .bool_const(value: source.span_text(s, span) == "true")), ty: ty, span: span)
        .null_ptr => return ir_build.emit(@b, op: .lit(value: .null_ptr), ty: ty, span: span)
        .str_lit =>
            decoded = escape.unescape(source.span_text(s, span))
            at = ir_build.intern(@b, decoded)
            return ir_build.emit(@b, op: .lit(value: .str_const(at: at)), ty: ty, span: span)
        # §4.3: a character literal IS a number — the same decoder the
        # checker used answers for both (panel 008's escapes included).
        .char_lit => return emit_int(@b, a, s, id: id, ty: ty, span: span)
        .name => return name_expr(@b, r, decls, id: id, ty: ty, span: span)
        .hole => return ir_build.emit(@b, op: .hole, ty: ty, span: span)
        .unary u =>
            # A negative literal is a literal, and it is folded HERE.
            # Left as a negation of a positive, -128 against an i8 puts
            # 128 in an int8_t before the minus reaches it — and the
            # frontend already range-checked the value WITH the sign
            # applied, so folding is what makes the two passes agree.
            folded = fold_negative(@b, a, s, op: u.op, operand: u.operand, ty: ty, span: span)
            if !folded.is_err()
                return folded.must()
            operand = expr(@b, a, r, c, s, decls, id: u.operand)
            un: ir.UnaryOp @ .neg
            match u.op
                .neg => un @ .neg
                .not => un @ .not_op
                .bit_not => un @ .bit_not
            return ir_build.emit(@b, op: .unary(op: un, operand: operand), ty: ty, span: span)
        .binary bin =>
            match bin.op
                .and | .or =>
                    return short_circuit(@b, a, r, c, s, decls, op: bin.op, left: bin.left, right: bin.right, ty: ty, span: span)
                .add | .sub | .mul | .div | .rem | .eq | .ne | .lt | .le | .gt | .ge | .bit_and | .bit_or | .bit_xor | .shl | .shr =>
                    left = expr(@b, a, r, c, s, decls, id: bin.left)
                    right = expr(@b, a, r, c, s, decls, id: bin.right)
                    return ir_build.emit(@b, op: .binary(op: binary_op(bin.op), left: left, right: right), ty: ty, span: span)
        .field f =>
            # `grid.WALL` is one qualified name, not a field of a value —
            # decided by the resolver and read back here rather than
            # re-decided.
            qualified: bool @ false
            match r.uses[f.base]
                .module => qualified @ true
                .local | .top | .builtin | .unresolved => qualified @ false
            if qualified
                return name_expr(@b, r, decls, id: id, ty: ty, span: span)
            owner = c.expr_types[f.base]
            base = expr(@b, a, r, c, s, decls, id: f.base)
            found = ir_layout.field_index(decls, c, s, owner: owner, name: f.name)
            if found.is_err()
                return ir_build.emit(@b, op: .missing, ty: ty, span: span)
            return ir_build.emit(@b, op: .field(base: base, at: found.must()), ty: ty, span: span)
        .index ix =>
            owner = c.expr_types[ix.base]
            base = expr(@b, a, r, c, s, decls, id: ix.base)
            key = expr(@b, a, r, c, s, decls, id: ix.index)
            # A map access yields V? and cannot abort; an array index can
            # (§4.9). Same syntax, two instructions.
            is_map: bool @ false
            match check_table.get(c.types, owner)
                .map => is_map @ true
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_map @ is_map
                .array | .fixed | .fallible | .function_ty | .named => is_map @ is_map
                .case_ty | .failure | .generic | .error => is_map @ is_map
            if is_map
                return ir_build.emit(@b, op: .map_get(map: base, key: key), ty: ty, span: span)
            return ir_build.emit(@b, op: .index(base: base, at: key), ty: ty, span: span)
        .array elements =>
            values: [i64] @ []
            for e in elements.elements
                values @ values.push(expr(@b, a, r, c, s, decls, id: e))
            run = value_args(@b, values)
            return ir_build.emit(@b, op: .construct(shape: .array_shape, arguments: run), ty: ty, span: span)
        .map entries =>
            # Key and value alternate in the run: a map literal is
            # n-ary, and the pairing is positional rather than a second
            # arena.
            values: [i64] @ []
            for entry in entries.entries
                values @ values.push(expr(@b, a, r, c, s, decls, id: entry.key))
                values @ values.push(expr(@b, a, r, c, s, decls, id: entry.value))
            run = value_args(@b, values)
            return ir_build.emit(@b, op: .construct(shape: .map_shape, arguments: run), ty: ty, span: span)
        .call cl =>
            return call(@b, a, r, c, s, decls, callee: cl.callee, given: cl.args, ty: ty, span: span)
        .method m =>
            return method(@b, a, r, c, s, decls, at: id, receiver: m.receiver, name: m.name, given: m.args, ty: ty, span: span)
        .variant_case vc =>
            return case_construct(@b, a, r, c, s, decls, name: vc.name, given: vc.args, ty: ty, span: span)
        .try_expr t =>
            return try_expr(@b, a, r, c, s, decls, inner: t.value, ty: ty, span: span)
        .if_expr ie =>
            return if_expr(@b, a, r, c, s, decls, branches: ie.branches, otherwise: ie.otherwise, ty: ty, span: span)
        .match_expr =>
            # PORT-STUB (matches.rs).
            return ir_build.emit(@b, op: .missing, ty: ty, span: span)
        .error => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
    return ir_build.emit(@b, op: .missing, ty: ty, span: span)

# The value-argument run a construct needs.
function value_args(@b: ir_build.Lowering, values: [i64]) -> ir.Run
    list: [ir.Arg] @ []
    for v in values
        list @ list.push(.value_arg(value: v))
    return ir_build.args_run(@b, list)

# A bare name: a local, a top-level declaration, or a built-in. The
# three lower to three different things, and the resolver decided which
# one this is — after UFCS erasure a re-resolution could legitimately
# give the OTHER answer.
function name_expr(@b: ir_build.Lowering, r: resolved.Resolved, decls: [ast.Decl], id: i64, ty: i64, span: token.Span) -> i64
    match r.uses[id]
        # A module name standing alone is a resolver error, so a clean
        # program never lowers one. It is a real Ref, though, so the arm
        # is written rather than folded.
        .module => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
        .local l =>
            slot = ir_build.slot_of_local(b, l.at)
            if slot.is_err()
                return ir_build.emit(@b, op: .missing, ty: ty, span: span)
            return ir_build.load_slot(@b, slot_id: slot.must(), span: span)
        .top t =>
            if is_constant(decls, t.at)
                # A constant is a zero-argument function, so reading its
                # name is a call (§4.2: there are no mutable globals to
                # read instead).
                run = ir_build.args_run(@b, [])
                return ir_build.emit(@b, op: .call(callee: .heroes_fn(decl: t.at), arguments: run, variadic: false), ty: ty, span: span)
            # A function used as a value (§4.13): a pointer, no
            # environment.
            return ir_build.emit(@b, op: .func_ref(callee: callee_of(decls, t.at)), ty: ty, span: span)
        .builtin bt => return ir_build.emit(@b, op: .func_ref(callee: .builtin_fn(at: bt.at)), ty: ty, span: span)
        .unresolved => return ir_build.emit(@b, op: .missing, ty: ty, span: span)
    return ir_build.emit(@b, op: .missing, ty: ty, span: span)

function is_constant(decls: [ast.Decl], decl: i64) -> bool
    return match decls[decl].kind
        .constant_decl => true
        .function_decl | .record_decl | .variant_decl | .test_decl => false

# Which callee a declaration is: an extern's name must not be mangled,
# so the two cannot share a case.
function callee_of(decls: [ast.Decl], decl: i64) -> ir.Callee
    match decls[decl].kind
        .function_decl fd =>
            if fd.value.is_extern
                return .extern_fn(decl: decl)
            return .heroes_fn(decl: decl)
        .constant_decl | .record_decl | .variant_decl | .test_decl => return .heroes_fn(decl: decl)
    return .heroes_fn(decl: decl)

# An i64 literal, decoded by the same sign-and-magnitude carrier the
# checker used. The checker reports the range first, so this is the net
# rather than the gate — a literal reaching here out of range is a
# frontend bug, and the diagnostic stays because a net that has never
# fired is indistinguishable from no net.
function emit_int(@b: ir_build.Lowering, a: ast.Ast, s: source.Source, id: i64, ty: i64, span: token.Span) -> i64
    decoded = check_contextual.literal_value(a, s, id)
    if decoded.is_err()
        ir_build.push_diagnostic(@b, contextless_errors.int_out_of_range(source.span_text(s, span), span))
        return ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: false, magnitude: 0))), ty: ty, span: span)
    return ir_build.emit(@b, op: .lit(value: .int_const(value: decoded.must())), ty: ty, span: span)

# The negative-literal fold: `-` directly on an int literal becomes one
# constant with the sign inside.
function fold_negative(@b: ir_build.Lowering, a: ast.Ast, s: source.Source, op: ast.UnaryOp, operand: i64, ty: i64, span: token.Span) -> i64?
    is_neg: bool @ false
    match op
        .neg => is_neg @ true
        .not | .bit_not => is_neg @ false
    if !is_neg
        return fail("no", "not a negation")
    match a.exprs[operand].kind
        .int_lit =>
            inner = check_contextual.literal_value(a, s, operand)
            if inner.is_err()
                return fail("no", "not a plain literal")
            lit = inner.must()
            return ok(ir_build.emit(@b, op: .lit(value: .int_const(value: check_contextual.LitValue(negative: true, magnitude: lit.magnitude))), ty: ty, span: span))
        .float_lit | .str_lit | .char_lit | .bool_lit | .null_ptr => return fail("no", "not an int literal")
        .name | .hole | .unary | .binary | .field | .index => return fail("no", "not an int literal")
        .call | .method | .variant_case | .array | .map => return fail("no", "not an int literal")
        .try_expr | .if_expr | .match_expr | .error => return fail("no", "not an int literal")
    return fail("no", "unreached")

function binary_op(op: ast.BinaryOp) -> ir.BinaryOp
    return match op
        .add => .add
        .sub => .sub
        .mul => .mul
        .div => .div
        .rem => .rem
        .eq => .eq
        .ne => .ne
        .lt => .lt
        .le => .le
        .gt => .gt
        .ge => .ge
        .bit_and => .bit_and
        .bit_or => .bit_or
        .bit_xor => .bit_xor
        .shl => .shl
        .shr => .shr
        # Handled one level up: they branch.
        .and | .or => .eq

## Tests

function lowered(text: str) -> ir_state.Lowered
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c = checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    return lower(p.tree, out, c, s, p.decls)

test "a function body flattens: loads, one add, and a return with a value"
    got = lowered("function add(a: i64, b: i64) -> i64\n    return a + b\n")
    assert got.program.functions.len() == 1
    f = got.program.functions[0]
    assert f.name == "add"
    assert f.blocks.len() == 1
    # load a, load b, add — three instructions, nothing nested.
    assert f.blocks[0].insts.len() == 3
    match f.blocks[0].insts[2].op
        .binary bin =>
            assert bin.left == 1
            assert bin.right == 2
        .lit | .load | .store | .unary | .cast | .call | .construct => assert false
        .field | .index | .map_get | .len_of | .tag_of | .payload => assert false
        .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => assert false
    match f.blocks[0].term
        .return_term ret => assert ret.value.must() == 3
        .jump | .branch | .switch_term | .unreachable | .open => assert false

test "a constant IS a value, an extern has no blocks, a test returns nothing"
    got = lowered("constant M: i64\n    40 + 2\n\nextern \"m.h\"\n    function f() -> i64\n\ntest \"t\"\n    _ = M\n")
    assert got.program.functions.len() == 3
    match got.program.functions[0].kind
        .constant_kind => assert got.program.functions[0].blocks.len() == 1
        .function_kind | .extern_kind | .test_kind => assert false
    match got.program.functions[1].kind
        .extern_kind => assert got.program.functions[1].blocks.len() == 0
        .function_kind | .constant_kind | .test_kind => assert false
    match got.program.functions[2].blocks[0].term
        .return_term ret => assert ret.value.is_err()
        .jump | .branch | .switch_term | .unreachable | .open => assert false

test "a negative literal folds, a mutation stores through a place"
    got = lowered("record P\n    x: i64\n\nfunction f() -> i64\n    v: i64 @ -128\n    p: P @ P(x: 1)\n    v @ v + 1\n    return v\n")
    f = got.program.functions[0]
    # The first instruction is the folded constant: negative inside.
    match f.blocks[0].insts[0].op
        .lit l =>
            match l.value
                .int_const ic =>
                    assert ic.value.negative
                    wanted: u64 = 128
                    assert ic.value.magnitude == wanted
                .float_const | .bool_const | .str_const | .null_ptr => assert false
        .load | .store | .unary | .binary | .cast | .call | .construct => assert false
        .field | .index | .map_get | .len_of | .tag_of | .payload => assert false
        .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => assert false

test "string literals intern decoded, and twice is once"
    got = lowered("function f() -> str\n    a = \"he\\nllo\"\n    b = \"he\\nllo\"\n    return a + b\n")
    assert got.program.strings.len() == 1
    assert got.program.strings[0] == "he\nllo"

test "a while is three blocks and a for is four, continue landing on the step"
    got = lowered("function g(xs: [i64]) -> i64\n    total: i64 @ 0\n    for x in xs\n        if x == 0\n            continue\n        total @ total + x\n    return total\n")
    f = got.program.functions[0]
    step_at: i64 @ 0 - 1
    at: i64 @ 0
    for blk in f.blocks
        if blk.note == "for: step"
            step_at @ at
        at @ at + 1
    assert step_at >= 0
    # The continue arm jumps to the STEP block, not the test: the
    # increment owes itself to that path too.
    jumped: bool @ false
    walk: i64 @ 0
    for blk in f.blocks
        if blk.note == "if: then"
            match blk.term
                .jump j =>
                    if j.to == step_at
                        jumped @ true
                .branch | .switch_term | .return_term | .unreachable | .open => continue
        walk @ walk + 1
    assert jumped

test "an if in value position stores into $r and the join loads it"
    got = lowered("function h(c: bool) -> i64\n    v = if c\n        1\n    else\n        2\n    return v\n")
    f = got.program.functions[0]
    named: bool @ false
    for slot in f.slots
        if slot.name == "$r0"
            named @ true
    assert named

test "&& branches with its own polarity and || with the opposite"
    got = lowered("function s(p: bool, q: bool) -> bool\n    return p && q\n")
    f = got.program.functions[0]
    rest_at: i64 @ 0 - 1
    meet_at: i64 @ 0 - 1
    at: i64 @ 0
    for blk in f.blocks
        if blk.note == "&&: right"
            rest_at @ at
        if blk.note == "&&: join"
            meet_at @ at
        at @ at + 1
    match f.blocks[0].term
        .branch br =>
            # && evaluates the right side when the left is TRUE.
            assert br.then_to == rest_at
            assert br.else_to == meet_at
        .jump | .switch_term | .return_term | .unreachable | .open => assert false

test "a join every arm returned past is sealed unreachable"
    got = lowered("function d(c: bool) -> i64\n    if c\n        return 1\n    else\n        return 2\n")
    f = got.program.functions[0]
    sealed: bool @ false
    for blk in f.blocks
        if blk.note == "if: join"
            match blk.term
                .unreachable => sealed @ true
                .jump | .branch | .switch_term | .return_term | .open => continue
    assert sealed

test "? branches on the tag, and the error edge is a real exit edge"
    got = lowered("function pick(ready: bool) -> i64?\n    if ready\n        return ok(3)\n    return fail(\"empty\", \"nothing here\")\n\nfunction outer(ready: bool) -> i64?\n    v = pick(ready)?\n    return ok(v + 1)\n")
    f = got.program.functions[1]
    assert f.name == "outer"
    propagate_at: i64 @ 0 - 1
    at: i64 @ 0
    for blk in f.blocks
        if blk.note == "?: propagate"
            propagate_at @ at
        at @ at + 1
    assert propagate_at >= 0
    # The propagate block reads the failure payload, wraps it UNCHANGED
    # as err, and returns — an exit edge like any return.
    match f.blocks[propagate_at].term
        .return_term ret => assert !ret.value.is_err()
        .jump | .branch | .switch_term | .unreachable | .open => assert false
    wrapped: bool @ false
    for inst in f.blocks[propagate_at].insts
        match inst.op
            .construct con =>
                match con.shape
                    .err_shape => wrapped @ true
                    .record_shape | .case_shape | .array_shape => continue
                    .map_shape | .ok_shape | .fail_shape => continue
            .lit | .load | .store | .unary | .binary | .cast | .call => continue
            .field | .index | .map_get | .len_of | .tag_of | .payload => continue
            .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => continue
    assert wrapped

test "an @ argument is a place, and a record construction is not a call"
    got = lowered("record Pt\n    x: i64\n\nfunction bump(@n: i64)\n    n @ n + 1\n\nfunction f() -> i64\n    v: i64 @ 0\n    bump(@v)\n    _ = Pt(x: 2)\n    return v\n")
    f = got.program.functions[1]
    assert f.name == "f"
    passed_place: bool @ false
    built: bool @ false
    for blk in f.blocks
        for inst in blk.insts
            match inst.op
                .call cl =>
                    for arg in ir_state.args_of(f, cl.arguments)
                        match arg
                            .inout_arg => passed_place @ true
                            .value_arg => continue
                .construct con =>
                    match con.shape
                        .record_shape => built @ true
                        .case_shape | .array_shape | .map_shape => continue
                        .ok_shape | .fail_shape | .err_shape => continue
                .lit | .load | .store | .unary | .binary | .cast => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => continue
    assert passed_place
    assert built

test "UFCS puts the receiver first, and print is variadic with no destination"
    got = lowered("function double(n: i64) -> i64\n    return n * 2\n\nfunction g()\n    print(5.double())\n")
    f = got.program.functions[1]
    ufcs_two: bool @ false
    printed: bool @ false
    for blk in f.blocks
        for inst in blk.insts
            match inst.op
                .call cl =>
                    match cl.callee
                        .heroes_fn =>
                            assert cl.arguments.length == 1
                            ufcs_two @ true
                        .builtin_fn =>
                            assert cl.variadic
                            assert inst.dest.is_err()
                            printed @ true
                        .extern_fn | .indirect => continue
                .lit | .load | .store | .unary | .binary | .cast | .construct => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => continue
    assert ufcs_two
    assert printed

test "must branches to the payload or an abort that carries the failure"
    got = lowered("function h(m: {str: i64}) -> i64\n    return m[\"a\"].must()\n")
    f = got.program.functions[0]
    aborted: bool @ false
    for blk in f.blocks
        if blk.note == "must: abort"
            for inst in blk.insts
                match inst.op
                    .abort_op ab =>
                        assert ab.arguments.length == 1
                        aborted @ true
                    .lit | .load | .store | .unary | .binary | .cast | .call | .construct => continue
                    .field | .index | .map_get | .len_of | .tag_of | .payload => continue
                    .func_ref | .copy_out | .incref | .decref | .hole | .missing => continue
            match blk.term
                .unreachable => continue
                .jump | .branch | .switch_term | .return_term | .open => assert false
    assert aborted
