# §4.12's inference: on functions only, no constraints, never written at
# the call site.
# Port of crates/heroes/src/types/generics.rs.
#
# Two functions, and between them they are the whole of it. `bind` walks
# a parameter's written type beside the argument's actual type; the first
# time a type parameter meets something, it takes it, and every later
# meeting must agree. `substitute` then rewrites the result type with
# what was bound.
#
# There are NO unification variables and NO constraint set — which is
# what keeps §4.5's promise that errors stay local: a mismatch is
# reported at the argument that disagreed, not at the end of a solve.
#
# Port note: Rust's bindings are Vec<Option<TyId>>; here [i64?], mutated
# per element — the store shape this very session's emitter fix made
# writable.

use token
use ast
use source
use resolved
use check_table
use check_state
use value_errors

# §4.12's inference, in one direction: a type parameter meets an argument
# and takes its type; meeting a second one, it must agree.
function bind(@c: check_state.Checker, s: source.Source, decls: [ast.Decl], @bindings: [i64?], param: i64, got: i64, span: token.Span)
    match check_table.get(c.out.types, param)
        .generic g =>
            if g.at >= bindings.len()
                return

            if bindings[g.at].is_err()
                bindings[g.at] @ ok(got)
                return
            bound = bindings[g.at].must()

            if bound == got
                return

            if !check_table.poisoned(c.out.types, got)
                a = check_state.show(c, s, decls, bound)
                b = check_state.show(c, s, decls, got)
                check_state.push_diagnostic(@c, value_errors.mismatch(expected: a, got: b, span: span))
        .array wanted =>
            match check_table.get(c.out.types, got)
                .array actual =>
                    bind(@c, s, decls, @bindings, param: wanted.element, got: actual.element, span: span)
                    return
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
                .fixed | .map | .fallible | .function_ty | .named =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
                .case_ty | .failure | .generic | .error =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
        # A fallible parameter meeting a non-fallible argument stays
        # silent HERE, exactly as Rust's arm does: the caller's own
        # argument check owns that message, and two would be the defect.

        .fallible wanted =>
            match check_table.get(c.out.types, got)
                .fallible actual => bind(
                    @c,
                    s,
                    decls,
                    @bindings,
                    param: wanted.payload,
                    got: actual.payload,
                    span: span
                )
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return
                .fixed | .map | .array | .function_ty | .named            => return
                .case_ty | .failure | .generic | .error                   => return
        .map wanted =>
            match check_table.get(c.out.types, got)
                .map actual =>
                    bind(@c, s, decls, @bindings, param: wanted.key, got: actual.key, span: span)
                    bind(@c, s, decls, @bindings, param: wanted.value, got: actual.value, span: span)
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return
                .fixed | .array | .fallible | .function_ty | .named       => return
                .case_ty | .failure | .generic | .error                   => return
        .function_ty wanted =>
            match check_table.get(c.out.types, got)
                .function_ty actual =>
                    ws = check_table.params_of(c.out.types, wanted.params)
                    gs = check_table.params_of(c.out.types, actual.params)

                    if ws.len() == gs.len()
                        i: i64 @ 0

                        while i < ws.len()
                            bind(@c, s, decls, @bindings, param: ws[i], got: gs[i], span: span)
                            i @ i + 1

                        bind(@c, s, decls, @bindings, param: wanted.result, got: actual.result, span: span)
                        return
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
                .fixed | .map | .fallible | .array | .named =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
                .case_ty | .failure | .generic | .error =>
                    mismatch_shape(@c, s, decls, param: param, got: got, span: span)
                    return
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit =>
            if param != got && !check_table.poisoned(c.out.types, param) && !check_table.poisoned(c.out.types, got)
                mismatch_shape(@c, s, decls, param: param, got: got, span: span)
        .fixed | .named | .case_ty | .failure | .error =>
            if param != got && !check_table.poisoned(c.out.types, param) && !check_table.poisoned(c.out.types, got)
                mismatch_shape(@c, s, decls, param: param, got: got, span: span)

function mismatch_shape(@c: check_state.Checker, s: source.Source, decls: [ast.Decl], param: i64, got: i64, span: token.Span)
    if check_table.poisoned(c.out.types, got)
        return
    a = check_state.show(c, s, decls, param)
    b = check_state.show(c, s, decls, got)
    check_state.push_diagnostic(@c, value_errors.mismatch(expected: a, got: b, span: span))

# Replace every generic with what the call bound it to.
function substitute(@c: check_state.Checker, ty: i64, bindings: [i64?]) -> i64
    if bindings.len() == 0
        return ty

    match check_table.get(c.out.types, ty)
        .generic g =>
            if g.at < bindings.len() && !bindings[g.at].is_err()
                return bindings[g.at].must()
            return check_state.error_ty_of(c)
        .array a =>
            element = substitute(@c, a.element, bindings)
            return check_table.intern(@c.out.types, .array(element: element))
        .fallible o =>
            payload = substitute(@c, o.payload, bindings)
            return check_table.intern(@c.out.types, .fallible(payload: payload))
        .map m =>
            key = substitute(@c, m.key, bindings)
            value = substitute(@c, m.value, bindings)
            return check_table.intern(@c.out.types, .map(key: key, value: value))
        .function_ty f =>
            rebuilt: [i64] @ []

            for p in check_table.params_of(c.out.types, f.params)
                rebuilt @ rebuilt.push(substitute(@c, p, bindings))

            result = substitute(@c, f.result, bindings)
            return check_table.intern_function(@c.out.types, rebuilt, result: result)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return ty
        .fixed | .named | .case_ty | .failure | .error            => return ty

    return ty

## Tests

test "a type parameter takes the first type it meets and holds it"
    r: resolved.Resolved @ resolved.new_resolved()
    c: check_state.Checker @ check_state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "x\n")
    d: [ast.Decl] = []
    a_param = check_table.intern(@c.out.types, .generic(at: 0))
    int_id = check_table.int_ty_id(c.out.types)
    str_id = check_table.str_ty(c.out.types)
    bindings: [i64?] @ [fail("unbound", "A")]
    bind(@c, s, d, @bindings, param: a_param, got: int_id, span: token.Span(start: 0, end: 1))
    assert bindings[0].must() == int_id

    # A second agreeing meeting is silent; a disagreeing one is blamed
    # at the argument.
    bind(@c, s, d, @bindings, param: a_param, got: int_id, span: token.Span(start: 2, end: 3))
    assert c.out.diagnostics.len() == 0
    bind(@c, s, d, @bindings, param: a_param, got: str_id, span: token.Span(start: 4, end: 5))
    assert c.out.diagnostics.len() == 1
    assert c.out.diagnostics[0].message == "expected `i64`, found `str`"

test "binding descends the shapes: array, map, and a function type"
    r: resolved.Resolved @ resolved.new_resolved()
    c: check_state.Checker @ check_state.new_checker(out_of: r, expr_count: 0)
    s = source.new_source(name: "t.hero", text: "x\n")
    d: [ast.Decl] = []
    a_param = check_table.intern(@c.out.types, .generic(at: 0))
    b_param = check_table.intern(@c.out.types, .generic(at: 1))
    int_id = check_table.int_ty_id(c.out.types)
    str_id = check_table.str_ty(c.out.types)

    # map<A, B>(xs: [A], f: (function(A) -> B)) meeting ([i64], f: i64->str)
    xs_param = check_table.intern(@c.out.types, .array(element: a_param))
    xs_got = check_table.intern(@c.out.types, .array(element: int_id))
    one: [i64] = [a_param]
    fn_param = check_table.intern_function(@c.out.types, one, result: b_param)
    one_got: [i64] = [int_id]
    fn_got = check_table.intern_function(@c.out.types, one_got, result: str_id)
    bindings: [i64?] @ [fail("unbound", "A"), fail("unbound", "B")]
    bind(@c, s, d, @bindings, param: xs_param, got: xs_got, span: token.Span(start: 0, end: 1))
    bind(@c, s, d, @bindings, param: fn_param, got: fn_got, span: token.Span(start: 2, end: 3))
    assert c.out.diagnostics.len() == 0
    assert bindings[0].must() == int_id
    assert bindings[1].must() == str_id

    # substitute rebuilds [B] as [str] through the interner.
    out_param = check_table.intern(@c.out.types, .array(element: b_param))
    rebuilt = substitute(@c, out_param, bindings)
    assert check_table.get(c.out.types, rebuilt) == .array(element: str_id)

test "an unbound generic substitutes to the silent error id"
    r: resolved.Resolved @ resolved.new_resolved()
    c: check_state.Checker @ check_state.new_checker(out_of: r, expr_count: 0)
    a_param = check_table.intern(@c.out.types, .generic(at: 0))
    bindings: [i64?] @ [fail("unbound", "A")]
    assert substitute(@c, a_param, bindings) == 0

    # With no bindings at all, substitution is the identity.
    empty: [i64?] = []
    assert substitute(@c, a_param, empty) == a_param
