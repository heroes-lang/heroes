# What an instruction reads (design.md Part 5's ownership pass; panel
# 019). Port of archive/bootstrap-rs/heroes/src/ir/uses.rs.
#
# One function per question — the values an operation reads, the values
# a terminator reads, the slots an operation names — and each is an
# exhaustive match, so an op added without listing its operands is a
# COMPILE error rather than a verifier that quietly stops checking it.
#
# Not only the verifier's question: the ownership pass inserts
# incref/decref by walking definitions and uses, and two tables that
# disagree about which is which would be a refcount bug that reproduces
# once a week. There is one table, and it is this module.

use token
use ir
use ir/containers

# Every value an operation reads. One function, so a new op that
# forgets to list its operands fails the exhaustiveness check.
function operands(f: containers.Function, op: ir.OpKind) -> [i64]
    out: [i64] @ []

    match op
        .lit | .hole | .missing | .copy_out | .func_ref => return out
        .load ld                                        => return path_values(f, ld.place)
        .store st =>
            out @ path_values(f, st.place)
            out @ out.push(st.value)
            return out
        .push_owned pg =>
            out @ path_values(f, pg.place)
            out @ out.push(pg.value)
            return out
        .unary u => out @ out.push(u.operand)
        .cast ca => out @ out.push(ca.operand)
        # A refcount operation reads the value it adjusts. Saying so
        # here is what makes the dominance check cover the ownership
        # pass's own output.

        .incref rc => out @ out.push(rc.value)
        .decref rc => out @ out.push(rc.value)
        # And `decref_slot` reads no VALUE at all, which is the whole
        # point of it: it names a slot, and a slot is not an SSA value
        # with a definition to dominate. `slots_of` below is where it is
        # reported, and that is the report `emit/body.hero` reads when it
        # decides whether a slot is written and never read.

        .decref_slot => return out
        .binary bin =>
            out @ out.push(bin.left)
            out @ out.push(bin.right)
        .call cl =>
            match cl.callee
                .indirect ind                         => out @ out.push(ind.value)
                .heroes_fn | .extern_fn | .builtin_fn => out @ out

            for v in arg_values(f, cl.arguments)
                out @ out.push(v)
        .construct con =>
            for v in arg_values(f, con.arguments)
                out @ out.push(v)
        .abort_op ab =>
            for v in arg_values(f, ab.arguments)
                out @ out.push(v)
        .field fl   => out @ out.push(fl.base)
        .payload pl => out @ out.push(pl.base)
        .index ix =>
            out @ out.push(ix.base)
            out @ out.push(ix.at)
        .map_get mg =>
            out @ out.push(mg.map)
            out @ out.push(mg.key)
        .len_of ln => out @ out.push(ln.value)
        .tag_of tg => out @ out.push(tg.value)

    return out

function terminator_operands(term: ir.Term) -> [i64]
    out: [i64] @ []

    match term
        .branch br      => out @ out.push(br.cond)
        .switch_term sw => out @ out.push(sw.tag)
        .return_term ret =>
            if !ret.value.is_err()
                out @ out.push(ret.value.must())
        .jump | .unreachable | .open => return out

    return out

function arg_values(f: containers.Function, run: ir.Run) -> [i64]
    out: [i64] @ []

    if run.start + run.length > f.arguments.len()
        return out

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v => out @ out.push(v.value)
            .inout_arg io =>
                for v in path_values(f, io.place)
                    out @ out.push(v)

    return out

function path_values(f: containers.Function, place: ir.Place) -> [i64]
    out: [i64] @ []

    if place.path.start + place.path.length > f.steps.len()
        return out

    for step in containers.steps_of(f, place.path)
        match step
            .index_step ix => out @ out.push(ix.value)
            .field_step    => continue

    return out

# The slots an operation names. The Rust version carries the function
# for signature stability and ignores it; Heroes refuses an unread
# parameter, so the honest signature is the one without it.
function slots_of(op: ir.OpKind) -> [i64]
    out: [i64] @ []

    match op
        .load ld       => out @ out.push(ld.place.root)
        .store st      => out @ out.push(st.place.root)
        .push_owned pg => out @ out.push(pg.place.root)
        .copy_out co   => out @ out.push(co.param)
        # **The one line the whole of panel 106's repair rests on.** A
        # swept slot used to be reported here through the `.load` above,
        # because releasing it was a load; naming it directly means this
        # arm is what keeps it counted as read. Without it every swept
        # slot would gain `__attribute__((unused))` in the prologue
        # (`emit/body.hero`), which is a lie clang would not catch.

        .decref_slot ds                                              => out @ out.push(ds.slot)
        .lit | .unary | .binary | .cast | .call | .construct         => return out
        .field | .index | .map_get | .len_of | .tag_of | .payload    => return out
        .func_ref | .abort_op | .incref | .decref | .hole | .missing => return out

    return out

## Tests

function scaffold() -> containers.Function
    return containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [0, 1, 2, 3, 4],
        arguments: [.value_arg(value: 3), .inout_arg(place: ir.Place(root: 0, path: ir.Run(start: 0, length: 1)))],
        steps: [.index_step(value: 4)],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )

test "a store reads its path and its value, a call reads its pointer first"
    f = scaffold()
    st = operands(f, .store(place: ir.Place(root: 7, path: ir.Run(start: 0, length: 1)), value: 2))
    assert st.len() == 2
    assert st[0] == 4
    assert st[1] == 2
    cl = operands(f, .call(callee: .indirect(value: 1), arguments: ir.Run(start: 0, length: 2), variadic: false))

    # The pointer, the value argument, then the @ place's index value.
    assert cl.len() == 3
    assert cl[0] == 1
    assert cl[1] == 3
    assert cl[2] == 4
    assert operands(f, .lit(value: .null_ptr)).len() == 0

test "a run past the arena answers empty instead of aborting"
    f = scaffold()
    over = operands(f, .construct(shape: .array_shape, arguments: ir.Run(start: 0, length: 9)))
    assert over.len() == 0
    branch_reads = terminator_operands(.branch(cond: 2, then_to: 0, else_to: 1))
    assert branch_reads.len() == 1
    assert branch_reads[0] == 2
    named = slots_of(.copy_out(param: 5))
    assert named.len() == 1
    assert named[0] == 5
