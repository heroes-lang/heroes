# What the verifier asks of the ownership pass's output (design.md Part 5,
# §4.10; panels 021, 106): a returning block releases every slot it owns, and
# every owning temporary moves into a slot in the block that defines it.
# Split out of `ir/phases.hero` on 2026-10-03, when defect 218's repair gave
# both questions a reading linear in the block and the file passed design.md
# §11's ~300 lines; `phases.check` asks them at the Owned phase.

use token
use ir
use ir/containers
use ir/layout
use ir/owning
use check/state
use check/table
use source
use parse
use resolve
use checker

# The slots every returning block owes a release, in slot order: a local or
# synthetic slot of a counted type. Rules 1 and 2 of `ir/own.hero`, read
# back: a plain parameter is borrowed and an `@` parameter is copied out, so
# neither is owed, and the return slot borrows (panel 190). Asked once per
# function since defect 218, where it was asked again by every returning
# block, with a walk of the parameters for every slot.
function owed_slots(f: containers.Function, c: state.Checked) -> [i64]
    is_param: [bool] @ []

    while is_param.len() < f.slots.len()
        is_param @ is_param.push(false)

    for p in f.params
        if p >= 0 && p < is_param.len()
            is_param[p] @ true

    owed: [i64] @ []
    index: i64 @ 0

    for slot in f.slots
        counted: bool @ false

        match slot.kind
            .local_slot | .synthetic_slot => counted @ layout.is_refcounted(c, slot.ty)
            .param_slot | .return_slot    => counted @ counted

        if counted && !is_param[index]
            owed @ owed.push(index)
        index @ index + 1

    return owed

# A returning block releases every local and synthetic slot it owns.
# Parameters are BORROWED and @ parameters are COPIED OUT, so neither
# is counted here — the calling convention, asserted rather than
# trusted: taking the other reading was the first program panel 021's
# ffi-pragmatist compiled, and ASan failed it on the first run.
#
# "Released" means a decref of a load taken AFTER the slot's last
# write. Counting decrefs was a proxy; matching decref to load could
# not tell a sweep from a store either, because a store to a counted
# slot also loads the old value and decrefs it, byte-identical to a
# sweep pair. What separates them is POSITION — the store's load
# precedes the store, the sweep's follows it. Found by removing a sweep
# decref by hand and watching the check stay silent.
function released_on_return(f: containers.Function, blk: containers.Block, owed: [i64], label: str, @problems: [str])
    is_return: bool @ false

    match blk.term
        .return_term                                          => is_return @ true
        .jump | .branch | .switch_term | .unreachable | .open => is_return @ is_return

    if !is_return
        return
    released = releases(blk).released

    for at in owed
        if released[at].is_err()
            problems @ problems.push(label + "returns without releasing `" + f.slots[at].name + "`, a slot it owns")

# Which slots this block releases, each read as above: a `decref_slot` of the
# slot at or after its floor, the position just past its last whole-slot
# store (0 when it is never written); or a `decref` of a value that a
# whole-slot load of the slot produced at or after the floor, and before the
# decref.
#
# **Two walks of the block, whatever its size** (defect 218, 2026-10-03). The
# same question was asked by walking the block once per slot for the floor,
# again for the release, and once more for every decref met on the way, to
# find its load: slots times decrefs times instructions, the cube of a
# straight function's length, and a `+` chain 2,000 long stopped after 13
# minutes of CPU unbuilt. The first walk keeps each slot's floor and last
# `decref_slot` and each value's last `decref`; the second asks each
# whole-slot load whether its value is released after it. Keyed by slot and
# by value rather than sized to the function, so a block costs its own
# length and nothing for the slots it never names. The test below holds the
# two readings to each other on generated blocks, the old one kept there
# word for word.
record Releases
    # The slots this block releases; a slot absent is not released.
    released: {i64: bool}
    # Every instruction both walks visited and every slot released by name,
    # for the test that holds the reading to its bound.
    visits: i64

function releases(blk: containers.Block) -> Releases
    floor: {i64: i64} @ {}
    named: {i64: i64} @ {}
    freed: {i64: i64} @ {}
    visits: i64 @ 0
    at: i64 @ 0

    for inst in blk.insts
        visits @ visits + 1

        # The no-op arms MUST NOT say continue: the counter at the bottom is
        # the position, and continue skips it — found the day the ownership
        # pass first exercised this check, as twelve false "returns without
        # releasing".
        match inst.op
            .store st =>
                if st.place.path.length == 0
                    floor[st.place.root] @ at + 1
            .decref_slot ds                                                            => named[ds.slot] @ at
            .decref rc                                                                 => freed[rc.value] @ at
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                  => at @ at
            .func_ref | .copy_out | .abort_op | .incref | .hole | .missing             => at @ at

        at @ at + 1

    released: {i64: bool} @ {}

    # ORDER: none, since each slot's answer is set on its own and no order
    # reaches anything.
    for slot in keys(named)
        visits @ visits + 1

        if named[slot].must() >= floor[slot].default(0)
            released[slot] @ true

    at @ 0

    for inst in blk.insts
        visits @ visits + 1

        match inst.op
            .load ld =>
                root = ld.place.root

                if !inst.dest.is_err() && ld.place.path.length == 0 && at >= floor[root].default(0)
                    if freed[inst.dest.must()].default(0 - 1) > at
                        released[root] @ true
            .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at

        at @ at + 1

    return Releases(released: released, visits: visits)

# EVERY OWNING TEMPORARY IS MOVED INTO A SLOT IN THE BLOCK THAT DEFINES
# IT. This is the invariant that replaces liveness: the ownership pass
# never releases a temporary — it moves the reference into a synthetic
# slot the instruction after it appears — so nothing owned crosses a
# block edge. Two earlier wordings were refuted, BOTH too strong: "a
# counted temporary is read only in its block" fired on assert's
# operands crossing into the abort block (harmless — a literal is
# static), and "a released temporary never crosses" fired on
# `... + got.must().to_str()`, where .must() opens a block mid-
# expression — not a corner case, but what any expression containing a
# fallible call looks like.
#
# The values the block's stores take are gathered in one walk (defect 218):
# the question was asked by walking the whole block again for every owning
# temporary in it, the square of a block's length.
function owning_temporaries_move_into_slots(blk: containers.Block, c: state.Checked, label: str, @problems: [str])
    stored: {i64: bool} @ {}

    for one in blk.insts
        match one.op
            .store st                                                                               => stored[st.value] @ true
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => continue
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => continue
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

    for inst in blk.insts
        if inst.dest.is_err()
            continue
        dest = inst.dest.must()

        if !owning.allocates(inst.op) || !layout.is_refcounted(c, inst.ty)
            continue

        if stored[dest].is_err()
            problems @ problems.push(
                label + "$" + dest.to_str() + " owns a reference and no store in this block takes it — a temporary never carries ownership across an edge"
            )

## Tests

# The reading this file replaced, word for word as `ir/phases.hero` held it at
# b7edbc35: the oracle the generated blocks below hold `releases` to.
# The index just past this slot's last whole-slot store, 0 when it was
# never written: the sweep's load must come after it.
function last_write(blk: containers.Block, slot_at: i64) -> i64
    floor: i64 @ 0
    at: i64 @ 0

    for inst in blk.insts
        # The no-op arms MUST NOT say continue: the counter at the
        # bottom is the position, and continue skips it — found the day
        # the ownership pass first exercised this check, as twelve
        # false "returns without releasing".
        match inst.op
            .store st =>
                if st.place.root == slot_at && st.place.path.length == 0
                    floor @ at + 1
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at

        at @ at + 1

    return floor

function released_after(blk: containers.Block, slot_at: i64, floor: i64) -> bool
    at: i64 @ 0

    for inst in blk.insts
        if at >= floor
            match inst.op
                # The direct form, since panel 106: the release names the
                # slot, so the question this function asks is answered by
                # reading the instruction rather than by tracing a
                # temporary back to its load.
                .decref_slot ds =>
                    if ds.slot == slot_at
                        return true
                .decref rc =>
                    if loaded_from(blk, value: rc.value, slot_at: slot_at, floor: floor, before: at)
                        return true
                .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
                .field | .index | .map_get | .len_of | .tag_of | .payload                           => at @ at
                .func_ref | .copy_out | .abort_op | .incref | .hole | .missing                      => at @ at
        at @ at + 1

    return false

# Was `value` produced by a whole-slot load of this slot, between the
# floor and the decref?
function loaded_from(blk: containers.Block, value: i64, slot_at: i64, floor: i64, before: i64) -> bool
    at: i64 @ 0

    for inst in blk.insts
        if at >= floor && at < before
            if !inst.dest.is_err() && inst.dest.must() == value
                match inst.op
                    .load ld =>
                        if ld.place.root == slot_at && ld.place.path.length == 0
                            return true
                    .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => at @ at
                    .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at
        at @ at + 1

    return false

# A generator, so the blocks are many and the same on every run: C's own
# `rand` example's constants, every product inside an i64.
function step(@seed: i64) -> i64
    seed @ (seed * 1103515245 + 12345) % 2147483648
    return seed / 65536

# A returning block of up to 40 loads, stores, releases and others over
# `slots` slots and a dozen values, drawn so that values collide, a slot is
# written twice, a store or a load runs through a path, and a release or a
# place names a slot that does not exist: the ill-formed IR the verifier is
# for, beside the well-formed.
function generated(@seed: i64, slots: i64) -> containers.Block
    span = token.Span(start: 0, end: 1)
    void: i64? = fail(code: "none", msg: "void")
    insts: [ir.Inst] @ []
    wanted = step(@seed) % 41

    while insts.len() < wanted
        kind = step(@seed) % 6
        root = step(@seed) % (slots + 2) - 1
        value = step(@seed) % 12
        place = ir.Place(root: root, path: ir.Run(start: 0, length: step(@seed) % 4 / 3))

        if kind == 0
            insts @ insts.push(ir.Inst(dest: void, op: .store(place: place, value: value), ty: 0, span: span))
        else if kind == 1
            insts @ insts.push(ir.Inst(dest: ok(value), op: .load(place: place), ty: 0, span: span))
        else if kind == 2
            insts @ insts.push(ir.Inst(dest: void, op: .decref(value: value), ty: 0, span: span))
        else if kind == 3
            insts @ insts.push(ir.Inst(dest: void, op: .decref_slot(slot: root), ty: 0, span: span))
        else if kind == 4
            insts @ insts.push(ir.Inst(dest: ok(value), op: .lit(value: .bool_const(value: true)), ty: 0, span: span))
        else
            insts @ insts.push(ir.Inst(dest: void, op: .incref(value: value), ty: 0, span: span))

    return containers.Block(
        preds: [],
        insts: insts,
        term: .return_term(value: fail(code: "none", msg: "no value")),
        note: "g"
    )

function one_slot(insts: [ir.Inst], term: ir.Term) -> containers.Function
    blk = containers.Block(preds: [], insts: insts, term: term, note: "t")
    return containers.Function(
        name: "f",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [containers.Slot(name: "s", ty: 0, kind: .local_slot(mutable: true))],
        blocks: [blk],
        values: [0, 1, 2],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )

function checked(text: str) -> state.Checked
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    return checker.check(p.tree, out, s, p.decls)

test "two walks answer what the nested walks answered, on every slot of every generated block"
    seed: i64 @ 106
    blocks: i64 @ 0
    first: str @ ""

    while blocks < 1500 && first == ""
        slots = 1 + blocks % 6
        blk = generated(seed: @seed, slots: slots)
        got = releases(blk).released
        at: i64 @ 0

        while at < slots
            if !got[at].is_err() != released_after(blk, slot_at: at, floor: last_write(blk, slot_at: at))
                first @ "slot " + at.to_str() + " of generated block " + blocks.to_str()
            at @ at + 1

        blocks @ blocks + 1

    assert first == ""

test "a returning block that leaves a slot it owns unreleased is named, however a release is spelled"
    span = token.Span(start: 0, end: 1)
    void: i64? = fail(code: "none", msg: "void")
    whole = ir.Place(root: 0, path: ir.Run(start: 0, length: 0))
    store = ir.Inst(dest: void, op: .store(place: whole, value: 1), ty: 0, span: span)
    load = ir.Inst(dest: ok(2), op: .load(place: whole), ty: 0, span: span)
    decref = ir.Inst(dest: void, op: .decref(value: 2), ty: 0, span: span)
    sweep = ir.Inst(dest: void, op: .decref_slot(slot: 0), ty: 0, span: span)
    returns: ir.Term = .return_term(value: fail(code: "none", msg: "no value"))
    owed: [i64] = [0]
    said = "f: returns without releasing `s`, a slot it owns"

    # Written, and never released.
    bare = one_slot([store], term: returns)
    named: [str] @ []
    released_on_return(bare, bare.blocks[0], owed: owed, label: "f: ", problems: @named)
    assert named == [said]

    # Released by name, or by a decref of a load taken after the write.
    by_name = one_slot([store, sweep], term: returns)
    quiet: [str] @ []
    released_on_return(by_name, by_name.blocks[0], owed: owed, label: "f: ", problems: @quiet)
    by_load = one_slot([store, load, decref], term: returns)
    released_on_return(by_load, by_load.blocks[0], owed: owed, label: "f: ", problems: @quiet)
    assert quiet.len() == 0

    # A store's own load and decref come BEFORE the write it makes: the pair
    # a sweep was taken for until position told them apart.
    early = one_slot([load, store, decref], term: returns)
    mistaken: [str] @ []
    released_on_return(early, early.blocks[0], owed: owed, label: "f: ", problems: @mistaken)
    assert mistaken == [said]

    # A block that does not return owes nothing, and neither does a slot not owed.
    jumps = one_slot([store], term: .jump(to: 0))
    none: [str] @ []
    released_on_return(jumps, jumps.blocks[0], owed: owed, label: "f: ", problems: @none)
    released_on_return(bare, bare.blocks[0], owed: [], label: "f: ", problems: @none)
    assert none.len() == 0

test "an owning temporary no store in its block takes is named, and one a store takes is not"
    c = checked("function f()\n    return\n")
    span = token.Span(start: 0, end: 1)
    concat = ir.Inst(dest: ok(3), op: .binary(op: .add, left: 1, right: 2), ty: table.str_ty(c.types), span: span)
    store = ir.Inst(
        dest: fail(code: "none", msg: "void"),
        op: .store(place: ir.Place(root: 0, path: ir.Run(start: 0, length: 0)), value: 3),
        ty: 0,
        span: span
    )
    returns: ir.Term = .return_term(value: fail(code: "none", msg: "no value"))
    lone: [str] @ []
    owning_temporaries_move_into_slots(
        containers.Block(preds: [], insts: [concat], term: returns, note: "t"),
        c,
        label: "f: ",
        problems: @lone
    )
    assert lone == ["f: $3 owns a reference and no store in this block takes it — a temporary never carries ownership across an edge"]

    # Moved, in either order: the store is looked for anywhere in the block.
    moved: [str] @ []
    owning_temporaries_move_into_slots(
        containers.Block(preds: [], insts: [concat, store], term: returns, note: "t"),
        c,
        label: "f: ",
        problems: @moved
    )
    owning_temporaries_move_into_slots(
        containers.Block(preds: [], insts: [store, concat], term: returns, note: "t"),
        c,
        label: "f: ",
        problems: @moved
    )

    # An `i64` sum allocates nothing, so nothing is owed.
    sum = ir.Inst(dest: ok(4), op: .binary(op: .add, left: 1, right: 2), ty: table.int_ty_id(c.types), span: span)
    owning_temporaries_move_into_slots(
        containers.Block(preds: [], insts: [sum], term: returns, note: "t"),
        c,
        label: "f: ",
        problems: @moved
    )
    assert moved.len() == 0

test "a local or synthetic slot of a counted type is owed, a parameter or a number is not"
    c = checked("function f()\n    return\n")
    text_ty = table.str_ty(c.types)
    f: containers.Function @ one_slot([], term: .return_term(value: fail(code: "none", msg: "no value")))
    f.slots @ [
        containers.Slot(name: "a", ty: text_ty, kind: .local_slot(mutable: false))
        containers.Slot(name: "p", ty: text_ty, kind: .param_slot(mutable: false))
        containers.Slot(name: "$own2", ty: text_ty, kind: .synthetic_slot)
        containers.Slot(name: "n", ty: table.int_ty_id(c.types), kind: .local_slot(mutable: true))
        containers.Slot(name: "q", ty: text_ty, kind: .local_slot(mutable: true))
    ]

    # `q` is a local listed among the parameters, so it is borrowed as they are.
    f.params @ [1, 4, 99]
    assert owed_slots(f, c) == [0, 2]

test "the two walks visit each instruction twice and each released slot once, on a sweep of 2,000 slots"
    span = token.Span(start: 0, end: 1)
    void: i64? = fail(code: "none", msg: "void")
    insts: [ir.Inst] @ []
    slots = 2000
    value: i64 @ 1

    # Each slot moved once, the ownership pass's shape: load the old value,
    # store the new, release the old. Then the sweep, one release per slot.
    while value < 2 * slots
        whole = ir.Place(root: value / 2, path: ir.Run(start: 0, length: 0))
        insts @ insts.push(ir.Inst(dest: ok(value), op: .load(place: whole), ty: 0, span: span))
        insts @ insts.push(ir.Inst(dest: void, op: .store(place: whole, value: value + 1), ty: 0, span: span))
        insts @ insts.push(ir.Inst(dest: void, op: .decref(value: value), ty: 0, span: span))
        value @ value + 2

    while value < 4 * slots
        insts @ insts.push(ir.Inst(dest: void, op: .decref_slot(slot: value / 2 - slots), ty: 0, span: span))
        value @ value + 2

    blk = containers.Block(
        preds: [],
        insts: insts,
        term: .return_term(value: fail(code: "none", msg: "no value")),
        note: "t"
    )
    got = releases(blk)

    # The old reading met every later decref on its way to each slot's
    # release and walked the whole block for each: about slots x slots x
    # instructions / 2, 1.6e10 here (derived, not run).
    assert got.visits <= 2 * insts.len() + slots
    assert keys(got.released).len() == slots
