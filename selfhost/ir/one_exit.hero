# What the verifier asks of a function's one exit (design.md Part 5; panel
# 190, defect 231). `ir/exits.hero` gives a function with two or more ways
# out one exit block: each way out stores what it returns into the return
# slot and jumps there, and the exit copies out every `@` parameter, loads
# the slot, retains what it loaded and sweeps.
#
# **The return slot borrows**: a store into it retains nothing and no sweep
# releases it (`ir/own.hero`), so the value it holds is alive only while its
# real owner is, a slot the exit sweeps, a parameter, or nobody (a literal).
# That is sound only while nothing between a return site's store and the
# exit's retain can release the owner. A copy-out releases nothing; anything
# else placed there is the one thing that would make the borrow wrong (the
# sitting's compiler-engineer). So the return slot may be named by two
# instructions and no others: a return site's whole store, the last thing
# its block does before it jumps to the exit, and the exit's whole load,
# after its copy-outs and, once the ownership pass has run, right before the
# retain of what it loaded. Asked of the value in hand, never of how the
# pass builds it, so a lowering or a pass that one day puts an instruction
# there is refused here instead of releasing a value early in silence.
#
# **And the merge is total or loud** (panel 190's R3): a function still
# leaving by two or more blocks is one the pass left with the product, and
# that is a compiler bug named here, never a function silently left so. One
# shape is exempt, and only in a program with holes: a function with a
# result that falls off its end, which a hole lets past the checker (§4.16,
# `checker.hero`'s held-back missing_return) and of which no binary is made.
#
# Linear in the function: the exits are found in one walk, and each
# instruction is asked once.

use token
use ir
use ir/containers
use ir/layout
use ir/uses
use ir/survival
use check/state
use check/table
use ir/agree
use source
use parse
use resolve
use checker

function check(p: containers.Program, f: containers.Function, c: state.Checked, label: str, @problems: [str])
    ways_out(f, c, label: label, problems: @problems)

    if !has_return_slot(f)
        return
    exits = exit_blocks(f)
    index: i64 @ 0

    for blk in f.blocks
        position: i64 @ 0

        for inst in blk.insts
            for root in roots_named(f, inst.op)
                if containers.is_return_root(f, root: root)
                    said = judged(p, f, blk, c, exits: exits, position: position, root: root)

                    if said != ""
                        problems @ problems.push(label + "bb" + index.to_str() + ": " + said)

            position @ position + 1

        index @ index + 1

# Two or more returning blocks, refused, but for the hole's shape above.
function ways_out(f: containers.Function, c: state.Checked, label: str, @problems: [str])
    returning: [str] @ []
    valueless: bool @ false
    index: i64 @ 0

    for blk in f.blocks
        match blk.term
            .return_term ret =>
                returning @ returning.push("bb" + index.to_str())
                valueless @ valueless || ret.value.is_err()
            .jump | .branch | .switch_term | .unreachable | .open => valueless @ valueless

        index @ index + 1

    if returning.len() < 2
        return

    if c.holes.len() > 0 && valueless && f.result != table.unit_ty(c.types)
        return
    problems @ problems.push(
        label + "leaves by " + returning.len().to_str() + " returning blocks, " + returning[0] + " and " + returning[1] + " first: a function with two or more ways out leaves by one exit, and `ir/exits.hero` did not merge these"
    )

function has_return_slot(f: containers.Function) -> bool
    for slot in f.slots
        if containers.is_return_slot(slot)
            return true

    return false

# The blocks that return the value of their own whole load of a return
# slot: the exits a return site may jump to.
function exit_blocks(f: containers.Function) -> {i64: bool}
    exits: {i64: bool} @ {}
    index: i64 @ 0

    for blk in f.blocks
        returned: i64 @ 0 - 1

        match blk.term
            .return_term ret =>
                if !ret.value.is_err()
                    returned @ ret.value.must()
            .jump | .branch | .switch_term | .unreachable | .open => returned @ returned

        for inst in blk.insts
            match inst.op
                .load ld =>
                    if containers.is_return_root(f, root: ld.place.root) && ld.place.path.length == 0
                        if !inst.dest.is_err() && inst.dest.must() == returned
                            exits[index] @ true
                .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload                               => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

        index @ index + 1

    return exits

# Every slot an instruction names: a place's root, an `@` argument's, a
# copy-out's parameter, a released slot.
function roots_named(f: containers.Function, op: ir.OpKind) -> [i64]
    return match op
        .call cl                                               => survival.inout_roots(f, over: cl.arguments)
        .construct con                                         => survival.inout_roots(f, over: con.arguments)
        .abort_op ab                                           => survival.inout_roots(f, over: ab.arguments)
        .lit | .load | .store | .push_owned | .unary | .binary => uses.slots_of(op)
        .cast | .field | .index | .map_get | .len_of | .tag_of => uses.slots_of(op)
        .payload | .func_ref | .copy_out | .incref | .decref   => uses.slots_of(op)
        .decref_slot | .hole | .missing                        => uses.slots_of(op)

# Why the instruction at `position` may not name this return slot, or ""
# where it may: a return site's store, or the exit's load.
function judged(p: containers.Program, f: containers.Function, blk: containers.Block, c: state.Checked, exits: {i64: bool}, position: i64, root: i64) -> str
    slot = "the return slot `" + f.slots[root].name + "`"
    inst = blk.insts[position]

    match inst.op
        .store st =>
            if st.place.path.length != 0
                return "stores into a part of " + slot + ", which is only ever written whole"

            if position + 1 != blk.insts.len()
                return "runs an instruction after its store into " + slot + ", where only copy-outs may run before the exit's retain"

            match blk.term
                .jump j =>
                    if !exits[j.to].is_err()
                        return ""
                .branch | .switch_term | .return_term | .unreachable | .open => return "stores into " + slot + " and does not jump to the exit"

            return "stores into " + slot + " and jumps to a block that does not return it"
        .load ld =>
            if ld.place.path.length != 0
                return "reads a part of " + slot + ", which only the exit reads, whole"
            return exit_load(p, blk, c, position: position, slot: slot)
        .lit | .push_owned | .unary | .binary | .cast | .call | .construct           => return named(slot)
        .field | .index | .map_get | .len_of | .tag_of | .payload                    => return named(slot)
        .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole => return named(slot)
        .missing                                                                     => return named(slot)

    return ""

function named(slot: str) -> str
    return "names " + slot + ", which only a return site's store and the exit's load may name"

# The exit's load: the value its block returns, after nothing but copy-outs,
# and retained at once once counts are honest.
function exit_load(p: containers.Program, blk: containers.Block, c: state.Checked, position: i64, slot: str) -> str
    inst = blk.insts[position]
    loaded = inst.dest.default(0 - 1)
    returns_it: bool @ false

    match blk.term
        .return_term ret                                      => returns_it @ !ret.value.is_err() && ret.value.must() == loaded
        .jump | .branch | .switch_term | .unreachable | .open => returns_it @ false

    if !returns_it
        return "reads " + slot + " and does not return what it read: only the exit reads it"
    at: i64 @ 0

    while at < position
        match blk.insts[at].op
            .copy_out                                                                   => at @ at
            .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call      => return before(slot)
            .construct | .field | .index | .map_get | .len_of | .tag_of | .payload      => return before(slot)
            .func_ref | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => return before(slot)

        at @ at + 1

    owned: bool @ false

    match p.phase
        .owned           => owned @ true
        .lowered | .mono => owned @ false

    if !owned || !layout.is_refcounted(c, inst.ty)
        return ""

    if position + 1 < blk.insts.len()
        match blk.insts[position + 1].op
            .incref rc =>
                if rc.value == loaded
                    return ""
            .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => return unretained(
                slot
            )
            .field | .index | .map_get | .len_of | .tag_of | .payload                     => return unretained(slot)
            .func_ref | .copy_out | .abort_op | .decref | .decref_slot | .hole | .missing => return unretained(slot)

    return unretained(slot)

function before(slot: str) -> str
    return "runs an instruction other than a copy-out before it loads " + slot + ", between the return sites' stores and the exit's retain"

function unretained(slot: str) -> str
    return "does not retain what it loads from " + slot + " right after loading it: the slot only borrows, so the caller's reference is owed before anything else runs"

# Panel 190's R4: the exit returns its load of the return slot, which is of
# the result's type by construction, so `verify.check_return_type` would read
# nothing on a merged function. What each way out stored there is read
# instead, once, from the exit: a store of another type is the wrong return.
function stored_types(f: containers.Function, blk: containers.Block, c: state.Checked, value: i64, at: str, @problems: [str])
    root: i64 @ 0 - 1

    for inst in blk.insts
        if !inst.dest.is_err() && inst.dest.must() == value
            match inst.op
                .load ld =>
                    if containers.is_return_root(f, root: ld.place.root) && ld.place.path.length == 0
                        root @ ld.place.root
                .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => root @ root
                .field | .index | .map_get | .len_of | .tag_of | .payload                               => root @ root
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => root @ root

    if root < 0
        return
    slot = "the return slot `" + f.slots[root].name + "`"

    if f.slots[root].ty != f.result
        problems @ problems.push(at + "returns " + slot + ", which is not of the function's result type")
    index: i64 @ 0

    for site in f.blocks
        for inst in site.insts
            match inst.op
                .store st =>
                    if st.place.root == root && st.value < f.values.len()
                        got = containers.value_type(f, st.value)

                        if !agree.agree(c.types, value: got, lands: f.result) && got != table.error_ty(c.types)
                            problems @ problems.push(
                                at + "returns " + slot + ", and bb" + index.to_str() + " stores a value of the wrong type into it"
                            )
                .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload                               => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

        index @ index + 1

## Tests

# A merged function of two ways out, by hand: bb0 and bb1 each load `s` and
# store it into `$ret0`, and bb2 is the exit. Each test bends one part.
function merged(c: state.Checked, first: [ir.Inst], second: ir.Term, closing: [ir.Inst]) -> containers.Function
    text_ty = table.str_ty(c.types)
    span = token.Span(start: 0, end: 1)
    store = ir.Inst(
        dest: fail(code: "none", msg: "void"),
        op: .store(place: whole(1), value: 1),
        ty: text_ty,
        span: span
    )
    load = ir.Inst(dest: ok(1), op: .load(place: whole(0)), ty: text_ty, span: span)
    slots: [containers.Slot] = [
        containers.Slot(name: "s", ty: text_ty, kind: .local_slot(mutable: false))
        containers.Slot(name: "$ret0", ty: text_ty, kind: .return_slot)
        containers.Slot(name: "p", ty: text_ty, kind: .param_slot(mutable: true))
    ]
    blocks: [containers.Block] = [
        containers.Block(preds: [], insts: first, term: .jump(to: 2), note: "a")
        containers.Block(preds: [], insts: [load, store], term: second, note: "b")
        containers.Block(preds: [0, 1], insts: closing, term: .return_term(value: ok(2)), note: "exit")
    ]
    return containers.Function(
        name: "f",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [2],
        result: text_ty,
        slots: slots,
        blocks: blocks,
        values: [text_ty, text_ty, text_ty],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: span
    )

# Two blocks and nothing in them, each leaving as its terminator says.
function two_ways(result: i64, first: ir.Term, second: ir.Term) -> containers.Function
    none: [ir.Inst] = []
    blocks: [containers.Block] = [
        containers.Block(preds: [], insts: none, term: first, note: "a")
        containers.Block(preds: [], insts: none, term: second, note: "b")
    ]
    return containers.Function(
        name: "f",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: result,
        slots: [],
        blocks: blocks,
        values: [result, result],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )

function whole(root: i64) -> ir.Place
    return ir.Place(root: root, path: ir.Run(start: 0, length: 0))

function asked(f: containers.Function, phase: containers.Phase, c: state.Checked) -> [str]
    problems: [str] @ []
    check(containers.Program(phase: phase, functions: [f], strings: []), f, c, label: "f: ", problems: @problems)
    return problems

function checked(text: str) -> state.Checked
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    return checker.check(p.tree, out, s, p.decls)

test "the return slot is named by the return sites' stores and the exit's load alone, and each other naming is refused"
    c = checked("function f()\n    return\n")
    text_ty = table.str_ty(c.types)
    span = token.Span(start: 0, end: 1)
    void: i64? = fail(code: "none", msg: "void")
    load_s = ir.Inst(dest: ok(0), op: .load(place: whole(0)), ty: text_ty, span: span)
    store_ret = ir.Inst(dest: void, op: .store(place: whole(1), value: 0), ty: text_ty, span: span)
    copy_p = ir.Inst(dest: void, op: .copy_out(param: 2), ty: text_ty, span: span)
    load_ret = ir.Inst(dest: ok(2), op: .load(place: whole(1)), ty: text_ty, span: span)
    retain = ir.Inst(dest: void, op: .incref(value: 2), ty: text_ty, span: span)
    sweep = ir.Inst(dest: void, op: .decref_slot(slot: 0), ty: text_ty, span: span)
    site: [ir.Inst] = [load_s, store_ret]
    to_exit: ir.Term = .jump(to: 2)
    closing: [ir.Inst] = [copy_p, load_ret, retain, sweep]
    said = "f: bb"

    # The shape the pass makes, at every phase: quiet.
    assert asked(merged(c, first: site, second: to_exit, closing: closing), phase: .owned, c) == []
    assert asked(merged(c, first: site, second: to_exit, closing: [copy_p, load_ret]), phase: .lowered, c) == []

    # A release between a return site's store and its jump to the exit.
    assert asked(merged(c, first: [load_s, store_ret, sweep], second: to_exit, closing: closing), phase: .owned, c) == [said + "0: runs an instruction after its store into the return slot `$ret0`, where only copy-outs may run before the exit's retain"]

    # A return site that returns where it should jump, and one whose jump
    # reaches a block that does not return the slot.
    assert asked(merged(c, first: site, second: .return_term(value: ok(1)), closing: closing), phase: .owned, c) == ["f: leaves by 2 returning blocks, bb1 and bb2 first: a function with two or more ways out leaves by one exit, and `ir/exits.hero` did not merge these", said + "1: stores into the return slot `$ret0` and does not jump to the exit"]
    assert asked(merged(c, first: site, second: .jump(to: 0), closing: closing), phase: .owned, c) == [said + "1: stores into the return slot `$ret0` and jumps to a block that does not return it"]

    # The exit releasing before its load, and, once counts are honest, not
    # retaining right after it; before the ownership pass no retain is owed.
    assert asked(merged(c, first: site, second: to_exit, closing: [copy_p, sweep, load_ret, retain]), phase: .owned, c) == [said + "2: runs an instruction other than a copy-out before it loads the return slot `$ret0`, between the return sites' stores and the exit's retain"]
    assert asked(merged(c, first: site, second: to_exit, closing: [copy_p, load_ret, sweep, retain]), phase: .owned, c) == [said + "2: does not retain what it loads from the return slot `$ret0` right after loading it: the slot only borrows, so the caller's reference is owed before anything else runs"]

    # Read by a block that does not return it, released by name, written
    # through a path.
    peek = ir.Inst(dest: ok(0), op: .load(place: whole(1)), ty: text_ty, span: span)
    assert asked(merged(c, first: [peek, store_ret], second: to_exit, closing: closing), phase: .owned, c) == [said + "0: reads the return slot `$ret0` and does not return what it read: only the exit reads it"]
    freed = ir.Inst(dest: void, op: .decref_slot(slot: 1), ty: text_ty, span: span)
    assert asked(merged(c, first: site, second: to_exit, closing: [copy_p, load_ret, retain, freed]), phase: .owned, c) == [said + "2: names the return slot `$ret0`, which only a return site's store and the exit's load may name"]
    part = ir.Inst(
        dest: void,
        op: .store(place: ir.Place(root: 1, path: ir.Run(start: 0, length: 1)), value: 0),
        ty: text_ty,
        span: span
    )
    assert asked(merged(c, first: [load_s, part], second: to_exit, closing: closing), phase: .owned, c) == [said + "0: stores into a part of the return slot `$ret0`, which is only ever written whole"]

test "a function leaving by two or more blocks is refused, but for the hole's shape, a result falling off its end"
    c = checked("function f()\n    return\n")
    holed = checked("function g() -> i64\n    return ???\n")
    assert holed.holes.len() == 1
    valued: ir.Term = .return_term(value: ok(0))
    fell: ir.Term = .return_term(value: fail(code: "none", msg: "fell off the end"))
    said = [
        "f: leaves by 2 returning blocks, bb0 and bb1 first: a function with two or more ways out leaves by one exit, and `ir/exits.hero` did not merge these"
    ]
    number = table.int_ty_id(c.types)
    assert asked(two_ways(number, first: valued, second: valued), phase: .lowered, c) == said
    assert asked(two_ways(number, first: valued, second: fell), phase: .owned, c) == said

    # With a hole in the program the checker held `missing_return` back, so
    # lowering wrote the edge that falls off the end, valueless, and the
    # merge left the function; no binary is made of it. Its siblings are not
    # exempt: two valued ways out, or a `()` function's two.
    held = table.int_ty_id(holed.types)
    assert asked(two_ways(held, first: valued, second: fell), phase: .lowered, holed) == []
    assert asked(two_ways(held, first: valued, second: valued), phase: .lowered, holed) == said
    assert asked(two_ways(table.unit_ty(holed.types), first: fell, second: fell), phase: .lowered, holed) == said

    # One way out, or none: nothing to merge.
    assert asked(two_ways(number, first: valued, second: .unreachable), phase: .owned, c) == []
    assert asked(two_ways(number, first: .unreachable, second: .jump(to: 0)), phase: .owned, c) == []
