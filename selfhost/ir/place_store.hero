# The place store (design.md §4.10; panels 037 and 088; landed by author
# decision 2026-08-24): `p @ p.push(v)` on a BARE place becomes one growing
# instruction, `push_owned(place, value)`, in place of load-call-store —
# the shape that copied every element on every push and cost the compiler
# most of its own build (docs/measurements/012).
#
# An IR-to-IR pass between mono and own, NOT a lowering case, for two
# reasons. First, ir_lower is at its frozen ceiling and this decision
# deserves its own module. Second — the real one — on the IR the safety
# argument is a fact about the value in hand (CLAUDE.md §11): the rewrite
# fires only where nothing can write p's root on any path from `load p` to
# `store p` (`ir/between.hero`), so anything that could mutate p while the
# pushed value is computed (`f(@p)` in an argument, a store into p) keeps
# the classic shape. Reads between the two are safe unrewritten AND
# rewritten: the value is computed before the grow either way, so it sees
# the pre-push array in both shapes.
#
# **The two need not share a block** (defect 381, 2026-10-06). Until then
# the rewrite asked for ONE block, which stood in for the reason above:
# `.must()`, `.default()`, `?`, `&&` and `||` in the pushed value branch,
# so the load sat in the block before the branch, and spec § 10's *grows in
# place when `xs` is a plain name* was false there: 40,000 such pushes
# retired 48.1 billion instructions where the same value named on the line
# above retired 45 million. A branch to an abort or a short circuit writes
# nothing, and the walk over the blocks between is what says so.
#
# Why the pass runs BEFORE the ownership pass: rule 5 gives a call's
# result a synthetic owning slot, so after own every accumulator push
# reads refcount 2 and uniqueness is invisible — panel 037 measured the
# in-place gate firing on 0 of 100,000 pushes for exactly this reason.
# push_owned takes the place itself (`**` in the runtime), the count it
# sees is the true one, and the ownership pass adds NOTHING around it:
# the runtime copies the value in (borrowed, like hero_array_push) and
# owns the old header's release.
#
# What ir_verify holds (via verify below, panel 088 R4 condition 4): the
# path is empty — uniqueness comes from the place, and a path step would
# put a container between the slot and the header, which is the exact
# corruption panel 037 measured — and the place is an array.

use token
use ir
use ir/containers
use ir/uses
use ir/graph
use ir/between
use inventory
use check/state
use check/table

function run(@p: containers.Program)
    rewritten: [containers.Function] @= []

    for f in p.functions
        rewritten @ rewritten.push(rewrite(f))

    p.functions @ rewritten

function rewrite(f: containers.Function) -> containers.Function
    worked: containers.Function @= f
    reads = counts(worked)
    where = definitions(worked)
    into = graph.jumps_into(worked.blocks)

    # Keyed by VALUE, which names one instruction in the whole function: the
    # load and the call a rewrite deletes by their results, and the store it
    # turns into `push_owned` by the result it stores, read by it alone.
    drop: {i64: bool} @= {}
    grow: {i64: i64} @= {}
    bi: i64 @= 0

    for blk in worked.blocks
        si: i64 @= 0

        for one in blk.insts
            match one.op
                .store st =>
                    found = pattern(
                        worked,
                        where: where,
                        reads: reads,
                        into: into,
                        block: bi,
                        store_at: si,
                        place: st.place,
                        value: st.value
                    )

                    if !found.is_err()
                        drop[found.must().receiver] @ true
                        drop[st.value] @ true
                        grow[st.value] @ found.must().pushed
                .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => si @ si
                .field | .index | .map_get | .len_of | .tag_of | .payload                               => si @ si
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => si @ si

            si @ si + 1

        bi @ bi + 1

    bi @ 0

    while bi < worked.blocks.len()
        worked.blocks[bi].insts @ kept(worked.blocks[bi].insts, drop: drop, grow: grow)
        bi @ bi + 1

    return worked

# How many instructions or terminators read each value. The pattern
# requires the load and the call to be read EXACTLY once — by the call
# and the store being rewritten — or some third reader would observe a
# value the rewrite deletes.
function counts(f: containers.Function) -> {i64: i64}
    reads: {i64: i64} @= {}

    for blk in f.blocks
        for one in blk.insts
            for v in uses.operands(f, one.op)
                reads[v] @ reads[v].default(0) + 1

        for v in uses.terminator_operands(blk.term)
            reads[v] @ reads[v].default(0) + 1

    return reads

# Where each value is defined: its block, and its position there.
record Def
    block: i64
    at: i64

function definitions(f: containers.Function) -> {i64: Def}
    where: {i64: Def} @= {}
    bi: i64 @= 0

    for blk in f.blocks
        at: i64 @= 0

        for one in blk.insts
            match one.dest
                .ok d => where[d] @ Def(block: bi, at: at)
                .err  => at @ at

            at @ at + 1

        bi @ bi + 1

    return where

# One block's instructions with the rewrites applied: the dropped loads and
# calls left out, each rewritten store a `push_owned` of the pushed value.
function kept(insts: [ir.Inst], drop: {i64: bool}, grow: {i64: i64}) -> [ir.Inst]
    out: [ir.Inst] @= []

    for one in insts
        if !one.dest.is_err() && drop[one.dest.must()].default(false)
            continue
        rewritten: ir.Inst @= one

        match one.op
            .store st =>
                pushed = grow[st.value]

                if !pushed.is_err()
                    rewritten @ ir.Inst(
                        dest: one.dest,
                        op: .push_owned(place: st.place, value: pushed.must()),
                        ty: one.ty,
                        span: one.span
                    )
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => rewritten @ rewritten
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => rewritten @ rewritten
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => rewritten @ rewritten

        out @ out.push(rewritten)

    return out

record Match
    receiver: i64
    pushed: i64

# The whole recognition, as facts about THIS function: the stored value is a
# push call read once, in the store's own block and before it; its receiver
# is a load of the SAME bare place read once, anywhere before it; nothing on
# any path from the load to the store writes the root.
function pattern(f: containers.Function, where: {i64: Def}, reads: {i64: i64}, into: graph.Edges, block: i64, store_at: i64, place: ir.Place, value: i64) -> Match?
    if place.path.length != 0
        return fail(code: "not_bare", msg: "the place has a path")
    call = where[value]?

    if call.block != block || call.at >= store_at
        return fail(code: "order", msg: "the push is not before its store in its block")

    if reads[value].default(0) != 1
        return fail(code: "shared", msg: "the pushed result has another reader")
    given: [ir.Arg] @= []

    match f.blocks[block].insts[call.at].op
        .call cl =>
            match cl.callee
                .builtin_fn bt =>
                    if inventory.name_of(bt.at) != "push"
                        return fail(code: "not_push", msg: "another builtin")
                .heroes_fn | .extern_fn | .indirect => return fail(code: "not_push", msg: "not a builtin")

            given @ containers.args_of(f, cl.arguments)
        .lit | .load | .store | .push_owned | .unary | .binary | .cast | .construct => return fail(
            code: "not_push",
            msg: "not a call"
        )
        .field | .index | .map_get | .len_of | .tag_of | .payload => return fail(code: "not_push", msg: "not a call")
        .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => return fail(
            code: "not_push",
            msg: "not a call"
        )

    if given.len() != 2
        return fail(code: "not_push", msg: "wrong arity")
    receiver: i64 @= 0
    pushed: i64 @= 0

    match given[0]
        .value_arg v => receiver @ v.value
        .inout_arg   => return fail(code: "not_push", msg: "an inout receiver")

    match given[1]
        .value_arg v => pushed @ v.value
        .inout_arg   => return fail(code: "not_push", msg: "an inout element")

    load = where[receiver]?

    if reads[receiver].default(0) != 1
        return fail(code: "shared", msg: "the receiver has another reader")

    match f.blocks[load.block].insts[load.at].op
        .load ld =>
            if ld.place.root != place.root || ld.place.path.length != 0
                return fail(code: "other_place", msg: "the load reads another place")
        .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct => return fail(
            code: "not_load",
            msg: "the receiver is not a load"
        )
        .field | .index | .map_get | .len_of | .tag_of | .payload => return fail(
            code: "not_load",
            msg: "the receiver is not a load"
        )
        .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => return fail(
            code: "not_load",
            msg: "the receiver is not a load"
        )

    if load.block == block && load.at >= call.at
        return fail(code: "order", msg: "the load is not before the push")

    if between.written(f, into, root: place.root, from_block: load.block, from_at: load.at, to_block: block, to_at: store_at)
        return fail(code: "written", msg: "the root may be written while the value is computed")

    return ok(Match(receiver: receiver, pushed: pushed))

# The verifier's half (panel 088 R4 condition 4), called from ir_verify:
# a push_owned whose path is not empty, or whose place is not an array,
# is the pass being wrong, loudly.
function verify(blk: containers.Block, f: containers.Function, c: state.Checked, label: str, @problems: [str])
    for one in blk.insts
        match one.op
            .push_owned pg =>
                path_problem(pg.place, label: label, problems: @problems)
                is_array: bool @= false

                match table.get(c.types, f.slots[pg.place.root].ty)
                    .array                                                    => is_array @ true
                    .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_array @ is_array
                    .fixed | .map | .fallible | .function_ty | .named         => is_array @ is_array
                    .case_ty | .failure | .generic | .error                   => is_array @ is_array

                if !is_array
                    problems @ problems.push(label + "a push_owned into a place that is not an array")
            .lit | .load | .store | .unary | .binary | .cast | .call | .construct                   => continue
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => continue
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

# The path half, on its own so the test below can fire it without a
# Checked in hand; the array half above is defensive — from source the
# pattern can only arise from a `push` the checker typed `[T]` — and is
# exercised by every real build through phases.
function path_problem(place: ir.Place, label: str, @problems: [str])
    if place.path.length != 0
        problems @ problems.push(label + "a push_owned with a path — uniqueness comes from a bare place")

## Tests

test "the canonical accumulator is rewritten to one growing instruction"
    f = accumulator()
    done = rewrite(f)
    ops = op_names(done)
    assert ops == ["lit", "push_owned"]

test "a receiver with a second reader keeps the classic shape"
    f: containers.Function @= accumulator()

    # A second use of the loaded receiver: len_of reads it too.
    f.blocks[0].insts @ f.blocks[0].insts.push(inst(dest: ok(4), op: .len_of(value: 1), ty: 0))
    done = rewrite(f)
    assert op_names(done) == ["lit", "load", "call", "store", "len_of"]

test "the verifier fires on a push_owned with a path"
    problems: [str] @= []
    path_problem(ir.Place(root: 0, path: ir.Run(start: 0, length: 1)), label: "t: ", problems: @problems)
    assert problems.len() == 1

    # And stays quiet on the bare place the pass is allowed to emit.
    path_problem(bare(0), label: "t: ", problems: @problems)
    assert problems.len() == 1

test "a write to the root between load and store keeps the classic shape"
    f: containers.Function @= accumulator()

    # Insert a store to the same root between the call and the store.
    grown: [ir.Inst] @= []
    at: i64 @= 0

    for one in f.blocks[0].insts
        if at == 2
            grown @ grown.push(inst(dest: fail(code: "none", msg: "void"), op: .store(place: bare(0), value: 0), ty: 0))
        grown @ grown.push(one)
        at @ at + 1

    f.blocks[0].insts @ grown
    done = rewrite(f)
    assert op_names(done) == ["lit", "load", "store", "call", "store"]

test "defect 381: a branch between the load and the push still grows in place, a write on the way does not"
    # The accumulator split where `.must()` splits it: the load and a branch
    # in bb0, the push and its store in bb1, an abort's block in bb2.
    f: containers.Function @= accumulator()
    whole = f.blocks[0].insts
    head: [ir.Inst] = [whole[0], whole[1]]
    tail: [ir.Inst] = [whole[2], whole[3]]
    f.blocks @ [
        containers.Block(preds: [], insts: head, term: .branch(cond: 0, then_to: 1, else_to: 2), note: "test")
        containers.Block(preds: [0], insts: tail, term: .return_term(value: fail(code: "none", msg: "bare")), note: "test")
        containers.Block(preds: [0], insts: [], term: .unreachable, note: "test")
    ]
    assert op_names(rewrite(f)) == ["lit", "push_owned"]

    # A store into the root in the block between keeps the classic shape: the
    # receiver was read before it, and growing the place would push onto what
    # the store wrote.
    g: containers.Function @= f
    g.blocks[0].term @ .jump(to: 3)
    g.blocks[2].preds @ [3]
    g.blocks @ g.blocks.push(
        containers.Block(preds: [0], insts: [inst(dest: fail(code: "none", msg: "void"), op: .store(place: bare(0), value: 0), ty: 0)], term: .branch(cond: 0, then_to: 1, else_to: 2), note: "test")
    )
    g.blocks[1].preds @ [3]
    assert op_names(rewrite(g)) == ["lit", "load", "call", "store", "store"]

    # The push and its store must share a block: a store whose value was
    # pushed in another block is left as it is.
    h: containers.Function @= f
    h.blocks[0].insts @ [whole[0], whole[1], whole[2]]
    h.blocks[1].insts @ [whole[3]]
    assert op_names(rewrite(h)) == ["lit", "load", "call", "store"]

function bare(root: i64) -> ir.Place
    return ir.Place(root: root, path: ir.Run(start: 0, length: 0))

function inst(dest: i64?, op: ir.OpKind, ty: i64) -> ir.Inst
    return ir.Inst(dest: dest, op: op, ty: ty, span: token.Span(start: 0, end: 1))

# One block: t0 = lit; t1 = load xs; t2 = call push(t1, t0); store xs <- t2.
function accumulator() -> containers.Function
    f: containers.Function @= uses.scaffold()
    f.slots @ [containers.Slot(name: "xs", ty: 0, kind: .local_slot(mutable: true))]
    f.values @ [0, 0, 0, 0, 0]
    f.arguments @ [.value_arg(value: 1), .value_arg(value: 0)]
    body: [ir.Inst] = [
        inst(dest: ok(0), op: .lit(value: .bool_const(value: false)), ty: 0)
        inst(dest: ok(1), op: .load(place: bare(0)), ty: 0)
        inst(dest: ok(2), op: .call(callee: .builtin_fn(at: push_index()), arguments: ir.Run(start: 0, length: 2), variadic: false), ty: 0)
        inst(dest: fail(code: "none", msg: "void"), op: .store(place: bare(0), value: 2), ty: 0)
    ]
    f.blocks @ [
        containers.Block(preds: [], insts: body, term: .return_term(value: fail(code: "none", msg: "bare")), note: "test")
    ]
    return f

function push_index() -> i64
    return inventory.index_of("push").must()

function op_names(f: containers.Function) -> [str]
    out: [str] @= []

    for blk in f.blocks
        for one in blk.insts
            out @ out.push(op_name(one.op))

    return out

function op_name(op: ir.OpKind) -> str
    return match op
        .lit                                                            => "lit"
        .load                                                           => "load"
        .store                                                          => "store"
        .push_owned                                                     => "push_owned"
        .call                                                           => "call"
        .len_of                                                         => "len_of"
        .unary | .binary | .cast | .construct | .field | .index         => "other"
        .map_get | .tag_of | .payload | .func_ref | .copy_out           => "other"
        .abort_op | .incref | .decref | .decref_slot | .hole | .missing => "other"
