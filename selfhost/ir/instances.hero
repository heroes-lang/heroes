# Which function a call or a function value names, once monomorphisation
# has run (design.md §4.12; spec § 9, generics and function values).
#
# Two questions, asked by the emitter wherever it names a callee and by the
# verifier before the emitter runs: the TYPE ARGUMENTS an instruction names,
# and the FUNCTION the program holds at them. Until defect 418 (2026-10-07)
# the first was written out three times, in `emit/inst.hero`,
# `emit/members.hero` and `emit/func_ref.hero`, and the second three times as
# well, in `emit/ops.hero`, `emit/func_ref.hero` and `emit/members.hero`, the
# first copy keeping the last match and the other two the first. They agreed
# because `ir/mono.hero` makes one function per declaration and type
# arguments, its `instance_key`; one copy each is what keeps them agreeing,
# and what lets the verifier ask the emitter's own question.

use ir/containers
use check/state
use source
use parse
use resolve
use checker
use ir/lower

# The type arguments the instruction at span end `at` names, as a call's are
# read: this copy's own table first, since monomorphisation substituted it per
# copy, then what the checker recorded; empty where nothing generic is named.
function named_at(f: containers.Function, c: state.Checked, at: i64) -> [i64]
    on_copy = f.call_instances[at]

    if !on_copy.is_err()
        return on_copy.must()
    recorded = c.instantiations[at]

    if !recorded.is_err()
        return recorded.must()
    none: [i64] = []
    return none

# The index of the function of declaration `decl` at exactly these type
# arguments, empty for an ordinary function: the copy monomorphisation made,
# one per declaration and type arguments, or an error where the program holds
# none, which is the emitter's loud fallback and the verifier's refusal.
function index_of(p: containers.Program, decl: i64, instance: [i64]) -> i64?
    index: i64 @ 0

    for f in p.functions
        if f.decl == decl && f.instance == instance
            return ok(index)
        index @ index + 1

    return fail(code: "none", msg: "no function of this declaration at these type arguments")

## Tests

test "a call names its callee at the type arguments the checker recorded"
    text = "function ident<A>(x: A) -> A\n    return x\n\nfunction twice(x: i64) -> i64\n    return x * 2\n\nfunction main()\n    print(ident(twice(1)))\n"
    parsed = parse.parse(text)
    s = source_of(text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    p = low.program
    none: [i64] = []
    main_at = index_of(p, decl: 2, instance: none)
    twice_at = index_of(p, decl: 1, instance: none)
    assert !main_at.is_err()
    assert !twice_at.is_err()
    assert p.functions[twice_at.must()].name == "twice"

    # Lowered, the generic is still its template: no function holds it at
    # any type arguments yet, and `ident` at none is the template itself.
    named: [[i64]] @ []

    for blk in p.functions[main_at.must()].blocks
        for inst in blk.insts
            match inst.op
                .call cl =>
                    match cl.callee
                        .heroes_fn h =>
                            if h.decl == 0
                                named @ named.push(named_at(p.functions[main_at.must()], c, at: inst.span.end))
                        .extern_fn | .builtin_fn | .indirect => continue
                .lit | .load | .store | .push_owned | .unary | .binary | .cast | .construct => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload                   => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot        => continue
                .hole | .missing                                                            => continue

    assert named.len() == 1
    assert named[0].len() == 1
    assert index_of(p, decl: 0, instance: named[0]).is_err()
    assert !index_of(p, decl: 0, instance: none).is_err()

function source_of(text: str) -> source.Source
    return source.new_source(name: "t.hero", text: text)
