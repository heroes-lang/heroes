# The lowering pass's state, and the only thing that may add a block, a
# slot or a temporary (design.md Part 10 step 6; panel 019 points 2, 3).
# Port of archive/bootstrap-rs/heroes/src/ir/{build,slots}.rs — one module, because
# Rust split one state by concern across two files of methods, and
# Heroes has no method files: this record IS both halves.
#
# Every invariant the verifier checks is one this module makes hard to
# break:
# - A temporary is assigned once: fresh_value hands out a new id and
#   records its type; nothing can name one twice.
# - A block ends exactly once: terminate refuses a block that already
#   ended, and it is the ONLY place edges are recorded — so preds cannot
#   disagree with the terminators.
# - Nothing is emitted after a terminator: push drops it, so statements
#   after a return cannot leave unreachable instructions in the dump.
#
# A synthetic name cannot collide: it starts with `$`, and `$` is not in
# the language — not an identifier character, not an operator. Without
# the sigil the dump would be ambiguous on input the author may legally
# write, because `t0: i64 @ 0` is legal Heroes.

use token
use resolved
use ir
use ir/containers
use ir/flow

# Where break and continue go. A stack, because loops nest — and for a
# `for` loop continue must land on the STEP block rather than the head:
# the increment has to happen on that path too. That single fact is why
# a for needs four blocks and a while three.
record LoopEdges
    break_to: i64
    continue_to: i64

record Lowering
    out: containers.Lowered
    # The function being built. One at a time: begin resets it, end_fn
    # files it.
    building: containers.Function
    current: i64
    loops: [LoopEdges]
    # A resolver local index -> the slot that holds it. The resolver
    # already answered "which binding is this name"; this map is the
    # only translation, and no pass here ever looks a name up again.
    slots_by_local: {i64: i64}
    # Where a local's name starts -> its index in the resolver's locals.
    # Built once, so lowering does not depend on walking the tree in the
    # resolver's order — the checker keys the same way, for the same
    # reason.
    locals_by_span: {i64: i64}
    # One counter per synthetic prefix, so two loops in a row are $i0
    # and $i1 rather than $i0 and $i4.
    counters: {str: i64}
    # (), interned once. Every function reserves value id 0 for it.
    unit: i64
    # The library's `validated`, found once for the program by
    # `ir/lower.lower` (defect 112): `ir/owned_release` asked for it at every
    # call by walking every declaration, the library's included, so lowering
    # grew with calls times declarations. Absent until it is set, and where
    # the library carries none, which the checker has already refused.
    validated: i64?
    # Each interned string's id, by its text (defect 112): `intern` walked
    # every string interned so far, which the compiler's own thousands of
    # literals made quadratic. Ids are still given in the order of first
    # appearance, so the table in the program is the one it was.
    string_ids: {str: i64}

function empty_function() -> containers.Function
    return containers.Function(
        name: "",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 0)
    )

function new_lowering(r: resolved.Resolved, unit: i64) -> Lowering
    by_span: {i64: i64} @ {}
    index: i64 @ 0

    for local in r.locals
        by_span[local.name.start] @ index
        index @ index + 1

    program = containers.Program(phase: .lowered, functions: [], strings: [])
    out = containers.Lowered(program: program, diagnostics: [])
    return Lowering(
        out: out,
        building: empty_function(),
        current: 0,
        loops: [],
        slots_by_local: {},
        locals_by_span: by_span,
        counters: {},
        unit: unit,
        validated: fail(code: "absent", msg: "the library's `validated` is found when the program is lowered"),
        string_ids: {}
    )

## One function at a time

function begin(@b: Lowering, name: str, decl: i64, kind: containers.FnKind, result: i64, generics: [str], span: token.Span)
    b.building @ empty_function()
    b.building.name @ name
    b.building.decl @ decl
    b.building.kind @ kind
    b.building.result @ result
    b.building.generics @ generics
    b.building.span @ span
    b.current @ 0
    empty_loops: [LoopEdges] = []
    b.loops @ empty_loops
    b.slots_by_local @ {}
    b.counters @ {}

    # Value id 0 is (), in every function: the value of everything that
    # produces none. Defined by the function rather than by an
    # instruction, which is what lets a call to a ()-returning function
    # have NO destination — `dst = call print(x)` is a hard clang error,
    # and raylib is almost entirely void-returning.
    b.building.values @ b.building.values.push(b.unit)

# The one value no instruction produces. It takes no state on purpose:
# id 0 is the same in every function, by construction.
function unit_value() -> i64
    return 0

function unit_ty(b: Lowering) -> i64
    return b.unit

# Opens bb0. Called for a declaration that HAS a body: an extern has no
# blocks at all, and a function with zero blocks is how the dump and the
# emitter tell the two apart without consulting the tree.
function entry(@b: Lowering)
    b.current @ block(@b, note: "entry")

function end_fn(@b: Lowering)
    append_function(@b.out.program.functions, b.building)
    b.building @ empty_function()

# The result type the enclosing function promised. `?` needs it: the
# error it propagates is wrapped into THIS function's T?.
function result_type(b: Lowering) -> i64
    return b.building.result

## Blocks

function block(@b: Lowering, note: str) -> i64
    append_block(@b.building.blocks, containers.Block(preds: [], insts: [], term: .open, note: note))
    return b.building.blocks.len() - 1

function switch_to(@b: Lowering, target: i64)
    b.current @ target

# Whether anything jumps here. A join with no predecessors is a join
# every arm diverged past, and lowering says unreachable rather than
# leaving a load nothing can reach.
function has_preds(b: Lowering, target: i64) -> bool
    return b.building.blocks[target].preds.len() > 0

function is_terminated(b: Lowering) -> bool
    return match b.building.blocks[b.current].term
        .open                                                        => false
        .jump | .branch | .switch_term | .return_term | .unreachable => true

# Ends the current block, and records the edges it creates. Silently
# declining to end an already-ended block is deliberate: the alternative
# is every caller asking is_terminated first, and the one that forgets
# produces a block with two exits.
function terminate(@b: Lowering, term: ir.Term)
    if is_terminated(b)
        return

    # A target named twice by one terminator gets one edge. Its last
    # predecessor is the only place a twin can be: edges are recorded here
    # alone and this block ends once, so it was not one before this call. The
    # list is hoisted as `push_inst`'s is (defect 261): walked and copied at
    # every edge into it, a join of N arms cost N squared.
    for target in flow.successors(term)
        preds: [i64] @ b.building.blocks[target].preds

        if preds.len() == 0 || preds[preds.len() - 1] != b.current
            b.building.blocks[target].preds @ []
            preds @ preds.push(b.current)
            b.building.blocks[target].preds @ preds

    b.building.blocks[b.current].term @ term

## Instructions

# An instruction with a destination: the temporary it produces is
# returned, so a lowering rule reads `v = emit(@b, ...)`.
function emit(@b: Lowering, op: ir.OpKind, ty: i64, span: token.Span) -> i64
    dest = fresh_value(@b, ty)
    push_inst(@b, ir.Inst(dest: ok(dest), op: op, ty: ty, span: span))
    return dest

# An instruction with no destination: a store, a copy-out, a call to a
# function that returns nothing.
function emit_void(@b: Lowering, op: ir.OpKind, ty: i64, span: token.Span)
    push_inst(@b, ir.Inst(dest: fail(code: "none", msg: "no destination"), op: op, ty: ty, span: span))

function push_inst(@b: Lowering, inst: ir.Inst)
    if is_terminated(b)
        return

    # Hoisted, emptied, pushed and stored back: lending this place with an
    # index in it copies the list into a temporary the callee shares, so
    # the push copied it anyway (measured in the emitted C, 2026-09-27).
    # With the block's own reference dropped first, `held` is the list's
    # one owner and grows in place: the hoisting design.md Part 8 wart 8
    # names beside the lend (defect 112).
    held: [ir.Inst] @ b.building.blocks[b.current].insts
    none: [ir.Inst] = []
    b.building.blocks[b.current].insts @ none
    held @ held.push(inst)
    b.building.blocks[b.current].insts @ held

function fresh_value(@b: Lowering, ty: i64) -> i64
    append_id(@b.building.values, ty)
    return b.building.values.len() - 1

# **Lent, so each push grows its array in place** (defect 112). Through the
# field, `b.building.values @ …push(ty)` copied the whole list at every value,
# as did the functions, the strings, and until defects 261 and 394 the slots,
# parameters, blocks, steps and arguments: lowering grew with the square of a
# function's size or an array literal's length. The helpers are design.md Part
# 8 wart 8's spelling (panel 144), the one defect 103 used for the lexer; a
# place with an index in it is hoisted instead (`push_inst`, `terminate`).
function append_id(@ids: [i64], id: i64)
    ids @ ids.push(id)

function append_function(@functions: [containers.Function], f: containers.Function)
    functions @ functions.push(f)

function append_slot(@slots: [containers.Slot], s: containers.Slot)
    slots @ slots.push(s)

function append_block(@blocks: [containers.Block], blk: containers.Block)
    blocks @ blocks.push(blk)

function append_step(@steps: [ir.PathStep], s: ir.PathStep)
    steps @ steps.push(s)

function append_arg(@arguments: [ir.Arg], a: ir.Arg)
    arguments @ arguments.push(a)

## Slots — the half of the state that holds a value

function param(@b: Lowering, name: str, ty: i64, mutable: bool) -> i64
    added = slot(@b, name: name, ty: ty, kind: .param_slot(mutable: mutable))
    append_id(@b.building.params, added)
    return added

function slot(@b: Lowering, name: str, ty: i64, kind: containers.SlotKind) -> i64
    append_slot(@b.building.slots, containers.Slot(name: name, ty: ty, kind: kind))
    return b.building.slots.len() - 1

# The kind of a slot the author wrote. Whether they may write it is the
# resolver's fact, carried into the IR because the emitter's `ptr` lend
# chooses its C cast from the root slot (panel 166, defect 065). A name the
# resolver made no local for gets the immutable kind, which is the loud
# direction: a lend rooted there can only be refused, never written through
# in silence.
function local_kind(r: resolved.Resolved, local: i64?) -> containers.SlotKind
    if local.is_err()
        return .local_slot(mutable: false)
    return .local_slot(mutable: r.locals[local.must()].mutable)

# A slot the author did not write: $i0 for a loop index, $r0 for a
# branch's value, $s0 for a scrutinee held across arms.
function synthetic(@b: Lowering, prefix: str, ty: i64) -> i64
    count: i64 @ 0
    found = b.counters[prefix]

    if !found.is_err()
        count @ found.must()
    b.counters[prefix] @ count + 1
    return slot(@b, name: "$" + prefix + count.to_str(), ty: ty, kind: .synthetic_slot)

# Binds a resolver local to a slot, so every later use of that name
# loads from the same place.
function bind_local(@b: Lowering, local: i64, slot_id: i64)
    b.slots_by_local[local] @ slot_id

function slot_of_local(b: Lowering, local: i64) -> i64?
    return b.slots_by_local[local]

# The local index a binding name belongs to, by where the name starts.
function local_at(b: Lowering, name: token.Span) -> i64?
    return b.locals_by_span[name.start]

function slot_type(b: Lowering, slot_id: i64) -> i64
    return b.building.slots[slot_id].ty

function value_ty(b: Lowering, value: i64) -> i64
    return b.building.values[value]

# The @ parameters, in declaration order — what every exit edge owes a
# copy_out to (§4.8).
function mutable_params(b: Lowering) -> [i64]
    out: [i64] @ []

    for slot_id in b.building.params
        match b.building.slots[slot_id].kind
            .param_slot p =>
                if p.mutable
                    out @ out.push(slot_id)
            .local_slot | .synthetic_slot | .return_slot => continue

    return out

## Runs

function args_run(@b: Lowering, list: [ir.Arg]) -> ir.Run
    start = b.building.arguments.len()

    for a in list
        append_arg(@b.building.arguments, a)

    return ir.Run(start: start, length: list.len())

function steps_run(@b: Lowering, list: [ir.PathStep]) -> ir.Run
    start = b.building.steps.len()

    for s in list
        append_step(@b.building.steps, s)

    return ir.Run(start: start, length: list.len())

# The place that is just a slot — by far the commonest, and it allocates
# no steps.
function whole(root: i64) -> ir.Place
    return ir.Place(root: root, path: ir.Run(start: 0, length: 0))

function load_slot(@b: Lowering, slot_id: i64, span: token.Span) -> i64
    ty = slot_type(b, slot_id)
    return emit(@b, op: .load(place: whole(slot_id)), ty: ty, span: span)

function store_slot(@b: Lowering, slot_id: i64, value: i64, span: token.Span)
    ty = slot_type(b, slot_id)
    emit_void(@b, op: .store(place: whole(slot_id), value: value), ty: ty, span: span)

## Tests

function fresh() -> Lowering
    return new_lowering(resolved.new_resolved(), unit: 0)

test "a block ends once, and nothing lands after the terminator"
    b: Lowering @ fresh()
    begin(@b, name: "f", decl: 0, kind: .function_kind, result: 0, generics: [], span: token.Span(start: 0, end: 1))
    entry(@b)
    exit_block = block(@b, note: "exit")
    v = emit(@b, op: .lit(value: .bool_const(value: true)), ty: 0, span: token.Span(start: 0, end: 1))
    terminate(@b, .jump(to: exit_block))

    # Both of these must bounce off the ended block.
    terminate(@b, .return_term(value: fail(code: "none", msg: "no value")))
    _ = emit(@b, op: .lit(value: .bool_const(value: false)), ty: 0, span: token.Span(start: 0, end: 1))

    match b.building.blocks[0].term
        .jump j                                                      => assert j.to == exit_block
        .branch | .switch_term | .return_term | .unreachable | .open => assert false

    assert b.building.blocks[0].insts.len() == 1
    assert b.building.blocks[exit_block].preds.len() == 1
    assert has_preds(b, exit_block)
    assert v == 1

test "defect 261: one edge per target a terminator names, every arm a predecessor of its join in order"
    b: Lowering @ fresh()
    begin(@b, name: "j", decl: 0, kind: .function_kind, result: 0, generics: [], span: token.Span(start: 0, end: 1))
    entry(@b)
    twice = block(@b, note: "twice")
    other = block(@b, note: "other")
    meet = block(@b, note: "meet")

    # A switch naming one target twice, around another: one edge each.
    terminate(@b, .switch_term(tag: 0, cases: [twice, other, twice]))
    assert b.building.blocks[twice].preds == [0]
    assert b.building.blocks[other].preds == [0]

    # A branch whose two sides are one block: one edge.
    switch_to(@b, target: twice)
    terminate(@b, .branch(cond: 0, then_to: meet, else_to: meet))
    arms: [i64] @ [twice]

    # Forty arms into one join, each recorded once and in the order they ended.
    while arms.len() <= 40
        arm = block(@b, note: "arm")
        switch_to(@b, target: arm)
        terminate(@b, .jump(to: meet))
        arms @ arms.push(arm)

    assert b.building.blocks[meet].preds == arms
    assert b.building.blocks[other].preds == [0]

    # The tables grown in place hold what each call added, at the index it said.
    p = param(@b, name: "p", ty: 3, mutable: true)
    q = slot(@b, name: "q", ty: 4, kind: .synthetic_slot)
    assert b.building.params == [p]
    assert b.building.slots[p].name == "p" && b.building.slots[q].ty == 4
    assert b.building.blocks.len() == arms.len() + 3

test "value 0 is unit, temporaries count up, synthetics never collide"
    b: Lowering @ fresh()
    begin(@b, name: "g", decl: 0, kind: .function_kind, result: 0, generics: [], span: token.Span(start: 0, end: 1))
    entry(@b)
    assert unit_value() == 0
    first = emit(@b, op: .lit(value: .bool_const(value: true)), ty: 3, span: token.Span(start: 0, end: 1))
    assert first == 1
    assert value_ty(b, first) == 3
    a = synthetic(@b, prefix: "i", ty: 3)
    c = synthetic(@b, prefix: "i", ty: 3)
    assert b.building.slots[a].name == "$i0"
    assert b.building.slots[c].name == "$i1"

test "a run slices back out"
    b: Lowering @ fresh()
    begin(@b, name: "h", decl: 0, kind: .function_kind, result: 0, generics: [], span: token.Span(start: 0, end: 1))
    entry(@b)
    run = args_run(@b, [.value_arg(value: 4), .value_arg(value: 5)])
    got = containers.args_of(b.building, run)
    assert got.len() == 2

    match got[1]
        .value_arg v => assert v.value == 5
        .inout_arg   => assert false
