# What must be true AFTER WHICH PASS (panel 021 R8).
# Port of crates/heroes/src/ir/phases.rs.
#
# Before the ownership pass there is no reference counting; after it,
# every exit edge releases what it owns. Naming the phase is what makes
# the second half assertable at all: a missing decref in a Lowered
# program is correct, and the same absence in an Owned one is a leak.
# rustc bakes the attribution in, LLVM has --verify-each, Go runs
# checkFunc between phases — all three audited verbatim (panel 021).
#
# The Owned half is also what makes the ownership pass's cheap
# classification SAFE: that pass releases an owning temporary at the
# end of its defining block rather than computing liveness, so what
# must be true is that a counted temporary is never read anywhere else
# — checked here rather than argued there. Buy the check, not the
# machinery.

use token
use source
use parse
use resolve
use checker
use check/table
use check/state
use ir
use ir/containers
use ir/layout
use ir/owning
use ir/place_store

function check(p: containers.Program, f: containers.Function, blk: containers.Block, c: state.Checked, label: str, @problems: [str])
    match p.phase
        .lowered =>
            has_rc: bool @ false

            for inst in blk.insts
                match inst.op
                    .incref | .decref                                                                   => has_rc @ true
                    .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => continue
                    .field | .index | .map_get | .len_of | .tag_of | .payload                           => continue
                    .func_ref | .copy_out | .abort_op | .hole | .missing                                => continue

            if has_rc
                problems @ problems.push(label + "a refcount operation before the ownership pass")
        # NO GENERIC SURVIVES MONOMORPHISATION, asserted rather than
        # hoped for. One that did would reach is_refcounted, which
        # answers false for it — right for T = i64, a leak for T = str
        # (panel 029 R1).

        .mono => no_generic_survives(f, blk, c, label: label, problems: @problems)
        .owned =>
            no_generic_survives(f, blk, c, label: label, problems: @problems)
            released_on_return(f, blk, c, label: label, problems: @problems)
            owning_temporaries_move_into_slots(blk, c, label: label, problems: @problems)
            place_store.verify(blk, f, c, label: label, problems: @problems)

# Every type in this block is concrete. Checked at mono AND at owned,
# because the second is where a survivor would do its damage.
function no_generic_survives(f: containers.Function, blk: containers.Block, c: state.Checked, label: str, @problems: [str])
    for inst in blk.insts
        if mentions_generic(c, ty: inst.ty)
            problems @ problems.push(label + "an instruction still has a type parameter in it")

    for slot in f.slots
        if mentions_generic(c, ty: slot.ty)
            problems @ problems.push(label + "a slot still has a type parameter in it")

    if mentions_generic(c, ty: f.result)
        problems @ problems.push(label + "the result still has a type parameter in it")

# Does this type mention a type parameter anywhere inside it?
function mentions_generic(c: state.Checked, ty: i64) -> bool
    match table.get(c.types, ty)
        .generic    => return true
        .array arr  => return mentions_generic(c, ty: arr.element)
        .fallible o => return mentions_generic(c, ty: o.payload)
        .fixed x    => return mentions_generic(c, ty: x.element)
        .map m      => return mentions_generic(c, ty: m.key) || mentions_generic(c, ty: m.value)
        .function_ty fn_ty =>
            for p in table.params_of(c.types, fn_ty.params)
                if mentions_generic(c, ty: p)
                    return true

            return mentions_generic(c, ty: fn_ty.result)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .named | .case_ty | .failure | .error                     => return false

    return false

# A returning block releases every local and synthetic slot it owns.
# Parameters are BORROWED and @ parameters are COPIED OUT, so neither
# is counted here — the calling convention, asserted rather than
# trusted: taking the other reading was the first program panel 021's
# ffi-pragmatist compiled, and ASan failed it on the first run.
#
# "Released" means a decref of a load taken AFTER the slot's last
# write. Counting decrefs was a proxy; matching decref to load could
# not tell a sweep from a store either, because a store to a counted
# slot also loads the old value and decrefs it, byte-identical to a
# sweep pair. What separates them is POSITION — the store's load
# precedes the store, the sweep's follows it. Found by removing a sweep
# decref by hand and watching the check stay silent.
function released_on_return(f: containers.Function, blk: containers.Block, c: state.Checked, label: str, @problems: [str])
    is_return: bool @ false

    match blk.term
        .return_term                                          => is_return @ true
        .jump | .branch | .switch_term | .unreachable | .open => is_return @ is_return

    if !is_return
        return
    index: i64 @ 0

    for slot in f.slots
        owed: bool @ false

        match slot.kind
            .local_slot | .synthetic_slot => owed @ true
            .param_slot                   => owed @ owed

        if owed && !layout.is_refcounted(c, slot.ty)
            owed @ false

        if owed
            for p in f.params
                if p == index
                    owed @ false

        if owed && !released_after(blk, slot_at: index, floor: last_write(blk, slot_at: index))
            problems @ problems.push(label + "returns without releasing `" + slot.name + "`, a slot it owns")
        index @ index + 1

# The index just past this slot's last whole-slot store, 0 when it was
# never written: the sweep's load must come after it.
function last_write(blk: containers.Block, slot_at: i64) -> i64
    floor: i64 @ 0
    at: i64 @ 0

    for inst in blk.insts
        # The no-op arms MUST NOT say continue: the counter at the
        # bottom is the position, and continue skips it — found the day
        # the ownership pass first exercised this check, as twelve
        # false "returns without releasing".
        match inst.op
            .store st =>
                if st.place.root == slot_at && st.place.path.length == 0
                    floor @ at + 1
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                  => at @ at
            .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing   => at @ at

        at @ at + 1

    return floor

function released_after(blk: containers.Block, slot_at: i64, floor: i64) -> bool
    at: i64 @ 0

    for inst in blk.insts
        if at >= floor
            match inst.op
                .decref rc =>
                    if loaded_from(blk, value: rc.value, slot_at: slot_at, floor: floor, before: at)
                        return true
                .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
                .field | .index | .map_get | .len_of | .tag_of | .payload                           => at @ at
                .func_ref | .copy_out | .abort_op | .incref | .hole | .missing                      => at @ at
        at @ at + 1

    return false

# Was `value` produced by a whole-slot load of this slot, between the
# floor and the decref?
function loaded_from(blk: containers.Block, value: i64, slot_at: i64, floor: i64, before: i64) -> bool
    at: i64 @ 0

    for inst in blk.insts
        if at >= floor && at < before
            if !inst.dest.is_err() && inst.dest.must() == value
                match inst.op
                    .load ld =>
                        if ld.place.root == slot_at && ld.place.path.length == 0
                            return true
                    .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
                    .field | .index | .map_get | .len_of | .tag_of | .payload                   => at @ at
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing    => at @ at
        at @ at + 1

    return false

# EVERY OWNING TEMPORARY IS MOVED INTO A SLOT IN THE BLOCK THAT DEFINES
# IT. This is the invariant that replaces liveness: the ownership pass
# never releases a temporary — it moves the reference into a synthetic
# slot the instruction after it appears — so nothing owned crosses a
# block edge. Two earlier wordings were refuted, BOTH too strong: "a
# counted temporary is read only in its block" fired on assert's
# operands crossing into the abort block (harmless — a literal is
# static), and "a released temporary never crosses" fired on
# `... + got.must().to_str()`, where .must() opens a block mid-
# expression — not a corner case, but what any expression containing a
# fallible call looks like.
function owning_temporaries_move_into_slots(blk: containers.Block, c: state.Checked, label: str, @problems: [str])
    for inst in blk.insts
        if inst.dest.is_err()
            continue
        dest = inst.dest.must()

        if !owning.allocates(inst.op) || !layout.is_refcounted(c, inst.ty)
            continue
        moved: bool @ false

        for one in blk.insts
            match one.op
                .store st =>
                    if st.value == dest
                        moved @ true
                .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload                  => continue
                .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing   => continue

        if !moved
            problems @ problems.push(
                label + "$" + dest.to_str() + " owns a reference and no store in this block takes it — a temporary never carries ownership across an edge"
            )

## Tests

function phase_scaffold(phase: containers.Phase, blk: containers.Block) -> containers.Program
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 1,
        slots: [],
        blocks: [blk],
        values: [0, 1, 2],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        span: token.Span(start: 0, end: 1)
    )
    return containers.Program(phase: phase, functions: [f], strings: [])

test "a refcount op before the ownership pass is named, after it is legal"
    span = token.Span(start: 0, end: 1)
    insts: [ir.Inst] = [ir.Inst(dest: fail("none", "void"), op: .incref(value: 1), ty: 0, span: span)]
    preds: [i64] = []
    blk = containers.Block(preds: preds, insts: insts, term: .return_term(value: fail("none", "no value")), note: "t")
    p = phase_scaffold(.lowered, blk)
    text = "record R\n    n: i64\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    problems: [str] @ []
    check(p, p.functions[0], blk, c, label: "", problems: @problems)
    assert problems.len() == 1
    assert problems[0] == "a refcount operation before the ownership pass"
