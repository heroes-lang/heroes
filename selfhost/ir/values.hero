# What a value must satisfy: assigned once, and DEFINED ON EVERY PATH
# THAT READS IT (design.md Part 10 step 6; panel 020 R4.10).
# Port of crates/heroes/src/ir/values.rs.
#
# Why the emitter needs dominance: every temporary is hoisted to the C
# function's prologue and nothing is initialised there, so a value read
# in a block its definition does not dominate is a read of an
# uninitialised C local. clang catches it — measured — but what it
# prints is `variable 't3' is used uninitialized`, #line-mapped into
# the author's .hero file: a compiler bug wearing a user diagnostic.
# Failing here instead means the message says the compiler is wrong, in
# the IR's own words.
#
# The FIRST version of the invariant was "a temporary is read only in
# the block that defines it", and the assert lowering falsified it
# immediately and correctly: it computes both sides in the test block
# and reads them in the abort block, which the test block dominates.
# The weaker, true statement is the one worth asserting.
#
# The algorithm is the textbook fixpoint, unadorned: dom(entry) =
# {entry}, dom(b) = {b} ∪ ⋂ dom(p) over b's predecessors, iterated to
# stability. O(blocks²) on a bool row per block — the largest recorded
# block count is 226, not worth a Lengauer-Tarjan.
#
# Port note: Rust threads a `where_` closure for message prefixes;
# Heroes stores no closures (the Cyclone rule's mirror), so the callers
# pass the finished prefix string instead.

use token
use ir
use ir/containers
use ir/uses

# Both value invariants, on one function. `label` prefixes every
# message: "name (after lowering): ".
function check(f: containers.Function, label: str, @problems: [str])
    homes = definitions(f, label: label, problems: @problems)
    dominance(f, homes: homes, label: label, problems: @problems)

# Every value a function names must be produced by some instruction in
# it — or be value 0, the unit, which the function itself defines.
# Returns each value's home block, -1 for unproduced: block indices are
# never negative, and the sentinel is read exactly once, in dominance.
function definitions(f: containers.Function, label: str, @problems: [str]) -> [i64]
    home: [i64] @ []
    defined: [bool] @ []
    i: i64 @ 0

    while i < f.values.len()
        home @ home.push(0 - 1)
        defined @ defined.push(i == 0)
        i @ i + 1

    index: i64 @ 0

    for blk in f.blocks
        for inst in blk.insts
            if !inst.dest.is_err()
                dest = inst.dest.must()

                if dest < defined.len()
                    if defined[dest]
                        problems @ problems.push(label + "$" + dest.to_str() + " is assigned twice")
                    defined[dest] @ true
                    home[dest] @ index

        index @ index + 1

    for blk in f.blocks
        for inst in blk.insts
            for value in uses.operands(f, inst.op)
                if value < defined.len() && !defined[value]
                    problems @ problems.push(label + "$" + value.to_str() + " is used and never produced")

        for value in uses.terminator_operands(blk.term)
            if value < defined.len() && !defined[value]
                problems @ problems.push(label + "$" + value.to_str() + " is used and never produced")

    return home

# A DEFINITION DOMINATES EVERY USE OF IT (panel 020 R4.10). The
# definitions walk says a value is produced somewhere; this says it is
# produced on EVERY path that reads it.
function dominance(f: containers.Function, homes: [i64], label: str, @problems: [str])
    dom = dominators(f.blocks)
    index: i64 @ 0

    for blk in f.blocks
        read: [i64] @ []

        for inst in blk.insts
            for v in uses.operands(f, inst.op)
                read @ read.push(v)

        for v in uses.terminator_operands(blk.term)
            read @ read.push(v)

        for value in read
            # Value 0 is the unit, defined by the function rather than
            # by a block.
            if value == 0
                continue

            if value >= homes.len()
                continue

            if homes[value] < 0
                continue

            if !dom[index][homes[value]]
                problems @ problems.push(
                    label + "bb" + index.to_str() + " reads $" + value.to_str() + ", defined in bb" + homes[value].to_str() + ", which does not dominate it"
                )

        index @ index + 1

# dominators[b][d] — whether block d dominates block b. The entry is
# dominated by itself alone; everything else starts maximal and
# shrinks, which is what makes the fixpoint a greatest one.
function dominators(blocks: [containers.Block]) -> [[bool]]
    count = blocks.len()
    dom: [[bool]] @ []
    i: i64 @ 0

    while i < count
        row: [bool] @ []
        j: i64 @ 0

        while j < count
            if i == 0
                row @ row.push(j == 0)
            else
                row @ row.push(true)
            j @ j + 1

        dom @ dom.push(row)
        i @ i + 1

    changed: bool @ true

    while changed
        changed @ false
        index: i64 @ 1

        while index < count
            next: [bool] @ []
            k: i64 @ 0

            while k < count
                next @ next.push(blocks[index].preds.len() == 0)
                k @ k + 1

            position: i64 @ 0

            for pred in blocks[index].preds
                if position == 0
                    next @ dom[pred]
                else
                    m: i64 @ 0

                    while m < count
                        next[m] @ next[m] && dom[pred][m]
                        m @ m + 1
                position @ position + 1

            next[index] @ true

            if next != dom[index]
                dom[index] @ next
                changed @ true
            index @ index + 1

    return dom

## Tests

function empty_block(term: ir.Term) -> containers.Block
    insts: [ir.Inst] = []
    preds: [i64] = []
    return containers.Block(preds: preds, insts: insts, term: term, note: "t")

test "assigned twice and never produced are both named"
    span = token.Span(start: 0, end: 1)
    twice = ir.Inst(dest: ok(1), op: .lit(value: .bool_const(value: true)), ty: 0, span: span)
    reads_ghost = ir.Inst(dest: ok(2), op: .unary(op: .not_op, operand: 3), ty: 0, span: span)
    blk: containers.Block @ empty_block(.return_term(value: fail("none", "no value")))
    blk.insts @ [twice, twice, reads_ghost]
    f = containers.Function(
        name: "bad",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [blk],
        values: [0, 1, 2, 3],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: span
    )
    problems: [str] @ []
    check(f, label: "bad: ", problems: @problems)
    assert problems.len() == 2
    assert problems[0] == "bad: $1 is assigned twice"
    assert problems[1] == "bad: $3 is used and never produced"

test "a sibling block's definition does not dominate, the entry's does"
    span = token.Span(start: 0, end: 1)
    define = ir.Inst(dest: ok(1), op: .lit(value: .bool_const(value: true)), ty: 0, span: span)
    read = ir.Inst(dest: ok(2), op: .unary(op: .not_op, operand: 1), ty: 0, span: span)
    entry_blk: containers.Block @ empty_block(.branch(cond: 1, then_to: 1, else_to: 2))
    entry_blk.insts @ [define]
    left: containers.Block @ empty_block(.return_term(value: fail("none", "no value")))
    left.preds @ [0]
    right: containers.Block @ empty_block(.return_term(value: fail("none", "no value")))
    right.preds @ [0]
    right.insts @ [read]
    f: containers.Function @ containers.Function(
        name: "ok_fn",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [entry_blk, left, right],
        values: [0, 1, 2],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: span
    )
    problems: [str] @ []
    check(f, label: "", problems: @problems)

    # The entry defines $1; both arms read nothing undominated.
    assert problems.len() == 0

    # Now move the definition into the LEFT arm: the right arm's read
    # is no longer dominated — the exact shape the C prologue makes
    # dangerous.
    empty_insts: [ir.Inst] = []
    f.blocks[0].insts @ empty_insts
    f.blocks[1].insts @ [define]
    f.blocks[2].insts @ [read]
    f.blocks[0].term @ .branch(cond: 0, then_to: 1, else_to: 2)
    again: [str] @ []
    check(f, label: "", problems: @again)
    assert again.len() == 1
    assert again[0] == "bb2 reads $1, defined in bb1, which does not dominate it"
