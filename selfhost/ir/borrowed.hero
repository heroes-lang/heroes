# Which loads lend their header to a read that a write to their root may
# precede (design.md Part 5, §4.10; defect 387, 2026-10-06).
#
# A load BORROWS what its root holds: the ownership pass gives it no
# reference, and where the root is written before the value is read, the
# write may free the header under it, or grow it in place, and the read sees
# freed memory or a value that changed under its name. The ownership pass
# gives such a load a reference of its own (`ir/own.hero`), and until this
# module it asked one question to find them, `survival.survivors`: is the
# load's own value read, IN ITS BLOCK, after a write to its root. Two
# readings fell outside it, each a correct program printing a wrong number
# and `--sanitize` reporting `heap-use-after-free`:
#
# - a read in a LATER block: `total(out, half(4).must() + bump(@out))` loads
#   `out`, branches at the `.must()`, writes `out` through `@` in the block
#   the branch opens, and reads the load there; `.default()`, `?`, `&&` and
#   `||` open blocks the same way;
# - a read of a value borrowed FROM the load: a field (`b.xs`), an element
#   (`g[0]`), a payload or a cast is copied bitwise out of the header the load
#   names, so `total(b.xs, bump(@b.xs))` reads freed memory in one block,
#   while the load itself was last read by the field.
#
# So the question is asked of the value in hand: a load lends its header to
# every value read through a chain of fields, elements, payloads and casts
# from it, and it is a lender where any of those is read at a point some
# write to its root may run before. In the load's own block that is the
# nearest write after it, which a walk from the block's end finds for every
# load at once; in a later block it is `between.written`, the walk over the
# blocks between that the place store asks too, and a write left in the
# load's own block answers for every later block without it.

use token
use ir
use ir/containers
use ir/uses
use ir/graph
use ir/between
use ir/survival

# What a function's values borrow. `lender` is dense over the value ids, so
# no question below hashes: for each value the index of the load whose
# header it reads in the five lists after it, negative for none. For each such load
# the lists hold its value, block, position and root, and the position of the
# nearest instruction after it in its block that may write that root, -1 for
# none.
record Borrows
    lender: [i64]
    value: [i64]
    block: [i64]
    at: [i64]
    root: [i64]
    nearest: [i64]

# The values of the loads that lend their header to such a read. `counted`
# is the checker's table by type: a load of a type nothing counts holds no
# header to lose.
function lenders(f: containers.Function, counted: [bool]) -> {i64: bool}
    return lenders_of(f, borrows(f, counted: counted))

# The same, over the borrows already read: the ownership pass reads them once
# and asks this and `ir/held.hero`'s holds of them (panel 196's R1).
function lenders_of(f: containers.Function, b: Borrows) -> {i64: bool}
    lent: {i64: bool} @= {}

    if b.value.len() == 0
        return lent

    # The edges are drawn once, and only for a function that needs a walk.
    into: graph.Edges @= graph.Edges(first: [], targets: [], visits: 0)
    drawn: bool @= false
    bi: i64 @= 0

    for blk in f.blocks
        at: i64 @= 0

        while at <= blk.insts.len()
            reads: [i64] @= []

            if at < blk.insts.len()
                reads @ uses.operands(f, blk.insts[at].op)
            else
                reads @ uses.terminator_operands(blk.term)

            for v in reads
                if v >= 0 && v < b.lender.len() && b.lender[v] >= 0
                    k = b.lender[v]
                    load = b.value[k]

                    if !lent[load].default(false)
                        if bi == b.block[k]
                            if at > b.at[k] && b.nearest[k] >= 0 && at > b.nearest[k]
                                lent[load] @ true
                        else if b.nearest[k] >= 0
                            # Every path from the load runs the rest of its
                            # block, and the write is there.
                            lent[load] @ true
                        else
                            if !drawn
                                into @ graph.jumps_into(f.blocks)
                                drawn @ true

                            if between.written(f, into, root: b.root[k], from_block: b.block[k], from_at: b.at[k], to_block: bi, to_at: at)
                                lent[load] @ true

            at @ at + 1

        bi @ bi + 1

    return lent

# Every value a counted load lends its header to: the load's own, and each
# field, element, payload or cast read through a chain of them from it. A
# load is kept only where a write to its root can follow it: after it in its
# own block, or in another block, since the blocks a path from it reaches
# before running it again are other blocks or the rest of its own.
function borrows(f: containers.Function, counted: [bool]) -> Borrows
    n = f.values.len()
    none: [i64] = []

    # -2 for a value no instruction has defined yet in the walk, -1 for one
    # that borrows from no counted load.
    lender: [i64] @= graph.filled(size: n, value: 0 - 2)
    value: [i64] @= []
    block: [i64] @= []
    at_of: [i64] @= []
    root: [i64] @= []
    nearest: [i64] @= []

    # A view whose base a later block defines: block order is not the order
    # of definitions, so it is settled after the walk, once its base is.
    waiting: [i64] @= []
    waiting_base: [i64] @= []

    # Which blocks write each root, gathered in the same walk: the first block
    # found and whether a second one does, and whether some instruction
    # writes every root at once.
    first_writer: {i64: i64} @= {}
    twice: {i64: bool} @= {}
    anywhere: bool @= false
    bi: i64 @= 0

    for blk in f.blocks
        first = value.len()
        at: i64 @= 0

        for one in blk.insts
            if !survival.writes_nothing(f, one.op)
                written = survival.roots_written(f, one.op)

                if written.every
                    anywhere @ true

                for r in written.roots
                    known = first_writer[r]

                    if known.is_err()
                        first_writer[r] @ bi
                    else if known.must() != bi
                        twice[r] @ true

            if !one.dest.is_err() && one.dest.must() >= 0 && one.dest.must() < n
                d = one.dest.must()
                lender[d] @ 0 - 1
                base: i64 @= 0 - 1

                match one.op
                    .load ld =>
                        if counted[one.ty]
                            lender[d] @ value.len()
                            value @ value.push(d)
                            block @ block.push(bi)
                            at_of @ at_of.push(at)
                            root @ root.push(ld.place.root)
                            nearest @ nearest.push(0 - 1)
                    .field fl                                                           => base @ fl.base
                    .index ix                                                           => base @ ix.base
                    .payload pl                                                         => base @ pl.base
                    .cast ca                                                            => base @ ca.operand
                    .lit | .store | .push_owned | .unary | .binary | .call | .construct => base @ base
                    .map_get | .len_of | .tag_of | .func_ref | .copy_out | .abort_op    => base @ base
                    .incref | .decref | .decref_slot | .hole | .missing                 => base @ base

                if base >= 0 && base < n
                    if lender[base] >= 0 - 1
                        lender[d] @ lender[base]
                    else
                        waiting @ waiting.push(d)
                        waiting_base @ waiting_base.push(base)

            at @ at + 1

        if value.len() > first
            nearest_writes(f, insts: blk.insts, first: first, at_of: at_of, root: root, nearest: @nearest)
        bi @ bi + 1

    moved: bool @= true

    while moved && waiting.len() > 0
        moved @ false
        still: [i64] @= []
        still_base: [i64] @= []
        k: i64 @= 0

        while k < waiting.len()
            from = lender[waiting_base[k]]

            if from >= 0
                lender[waiting[k]] @ from
                moved @ true
            else
                still @ still.push(waiting[k])
                still_base @ still_base.push(waiting_base[k])
            k @ k + 1

        waiting @ still
        waiting_base @ still_base

    # A load no write can follow lends nothing: its family is forgotten, and
    # a function where every load is forgotten has nothing to read.
    if value.len() == 0
        return Borrows(lender: lender, value: none, block: none, at: none, root: none, nearest: none)
    kept: [bool] @= []
    some: bool @= false

    while kept.len() < value.len()
        k = kept.len()
        follows = nearest[k] >= 0 || anywhere || written_elsewhere(first_writer, twice, root: root[k], block: block[k])
        kept @ kept.push(follows)

        if follows
            some @ true

    if !some
        return Borrows(lender: lender, value: none, block: none, at: none, root: none, nearest: none)
    v: i64 @= 0

    while v < n
        if lender[v] >= 0 && !kept[lender[v]]
            lender[v] @ 0 - 1
        v @ v + 1

    return Borrows(lender: lender, value: value, block: block, at: at_of, root: root, nearest: nearest)

# Whether a block other than `block` writes the root.
function written_elsewhere(first_writer: {i64: i64}, twice: {i64: bool}, root: i64, block: i64) -> bool
    known = first_writer[root]

    if known.is_err()
        return false
    return known.must() != block || twice[root].default(false)

# For the loads of one block, from index `first` of the lists on, the
# position of the nearest instruction after each that may write its root:
# one walk from the block's end, the writes read from `survival`'s table.
function nearest_writes(f: containers.Function, insts: [ir.Inst], first: i64, at_of: [i64], root: [i64], @nearest: [i64])
    below: {i64: i64} @= {}
    every: i64 @= 0 - 1
    k: i64 @= nearest.len() - 1
    at: i64 @= insts.len() - 1

    while at >= 0
        while k >= first && at_of[k] == at
            write: i64 @= below[root[k]].default(0 - 1)

            if every >= 0 && (write < 0 || every < write)
                write @ every
            nearest[k] @ write
            k @ k - 1

        one = insts[at]

        if !survival.writes_nothing(f, one.op)
            written = survival.roots_written(f, one.op)

            if written.every
                every @ at

            for r in written.roots
                below[r] @ at

        at @ at - 1

## Tests

function inst(dest: i64, op: ir.OpKind) -> ir.Inst
    return ir.Inst(dest: ok(dest), op: op, ty: 1, span: token.Span(start: 0, end: 1))

# `@` slot 0 through the scaffold's one argument, a call that writes it.
function bump() -> ir.Inst
    return ir.Inst(
        dest: fail(code: "none", msg: "void"),
        op: .call(callee: .builtin_fn(at: 0), arguments: ir.Run(start: 0, length: 1), variadic: false),
        ty: 0,
        span: token.Span(start: 0, end: 1)
    )

# `between.blocks_of`'s function, its value table wide enough for the five
# values the cases name.
function made(terms: [ir.Term], bodies: [[ir.Inst]]) -> containers.Function
    f: containers.Function @= between.blocks_of(terms: terms, bodies: bodies)
    f.values @ [0, 1, 1, 1, 1]
    return f

function bare() -> ir.Place
    return ir.Place(root: 0, path: ir.Run(start: 0, length: 0))

test "a load read in the block a branch opens, after a write there, lends its header; before the write it does not"
    # bb0 loads slot 0 and branches as `.must()` does; bb1 writes the slot
    # through `@` and then reads the load; bb2 is the abort.
    head: [ir.Inst] = [
        inst(dest: 1, op: .load(place: bare()))
        inst(dest: 2, op: .lit(value: .bool_const(value: true)))
    ]
    late: [ir.Inst] = [bump(), inst(dest: 3, op: .len_of(value: 1))]
    terms: [ir.Term] = [
        .branch(cond: 2, then_to: 1, else_to: 2)
        .return_term(value: fail(code: "none", msg: "bare"))
        .unreachable
    ]
    f = made(terms: terms, bodies: [head, late, []])
    assert lenders(f, counted: [false, true])[1].default(false)

    # The read before the write, and the same program over a type nothing
    # counts, lend nothing.
    early: [ir.Inst] = [inst(dest: 3, op: .len_of(value: 1)), bump()]
    assert !lenders(made(terms: terms, bodies: [head, early, []]), counted: [false, true])[1].default(false)
    assert !lenders(f, counted: [false, false])[1].default(false)

test "a field read from a load lends the load's header in one block, where the load's own last read is before the write"
    one: [ir.Inst] = [
        inst(dest: 1, op: .load(place: bare()))
        inst(dest: 2, op: .field(base: 1, at: 0))
        inst(dest: 3, op: .index(base: 2, at: 0))
        bump()
        inst(dest: 4, op: .len_of(value: 3))
    ]
    terms: [ir.Term] = [.return_term(value: fail(code: "none", msg: "bare"))]
    f = made(terms: terms, bodies: [one])
    assert lenders(f, counted: [false, true])[1].default(false)

    # The block-local reading sees only the load's own value, last read by
    # the field before the write: this is the case it could not answer.
    assert !survival.survivors(f, f.blocks[0].insts, f.blocks[0].term).survive[0]

test "a view in a block numbered before its load's block is settled once the load is known"
    # bb0 jumps to bb2, which loads and jumps to bb1, where a field of the load
    # is read after the write: bb1 comes first in block order.
    terms: [ir.Term] = [.jump(to: 2), .return_term(value: fail(code: "none", msg: "bare")), .jump(to: 1)]
    viewed: [ir.Inst] = [inst(dest: 2, op: .field(base: 1, at: 0)), bump(), inst(dest: 3, op: .len_of(value: 2))]
    loaded: [ir.Inst] = [inst(dest: 1, op: .load(place: bare()))]
    f = made(terms: terms, bodies: [[], viewed, loaded])
    assert lenders(f, counted: [false, true])[1].default(false)
    held = borrows(f, counted: [false, true])
    assert held.value[held.lender[2]] == 1
