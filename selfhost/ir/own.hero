# The ownership pass: values acquire lifetimes (design.md Part 5,
# §4.10; panels 021, 022). Port of archive/bootstrap-rs/heroes/src/own.rs.
#
# The FIRST IR-to-IR pass — a separate pass is what makes the dump show
# the result and keeps the emitter a printer. Swift's SIL is the
# precedent (strong_retain/strong_release are instructions); LLVM
# D92808 records the failure mode of the alternative, where ARC's
# pairing lived only in the backend.
#
# Six rules, and every one has a compiled counterexample:
# 1. A plain parameter is BORROWED — excluded from the exit sweep.
#    Taking the other reading was the first program panel 021's judge
#    compiled, and ASan failed it on the first run.
# 2. An @ parameter is moved in and moved out: the copy-in consumes the
#    caller's reference, the copy-out hands one back.
# 3. A store increfs the new value BEFORE decrefing the old — `s @ s`
#    otherwise frees the buffer and increfs a dead one; without the
#    decref a string-building loop leaked 999 blocks, measured. A field
#    path is the same store, read at the STORED VALUE's type (the root
#    slot's answered a question nobody asked). An INDEXED store hands
#    the value over — the runtime releases the old element — so it
#    increfs and does not decref, and the incref precedes the store
#    because the value may live inside the container being copied.
# 4. A returned value is increfed BEFORE the sweep, or
#    `return prefix + name` is a use-after-free.
# 5. An owning temporary is MOVED into a synthetic slot, in the block
#    that defines it. Nothing is ever owned by a temporary past its own
#    instruction, so nothing is released at a block boundary: ownership
#    lives in slots, and cleanup is a walk over a table. First written
#    as "decref at end of defining block" and refuted within the hour —
#    .must(), ?, && and if-as-value all open a block in the MIDDLE of
#    an expression. The consequence is a uniform reading: every value
#    that reaches a store is borrowed, so a store always increfs, a
#    return always increfs, a call argument does neither, and every
#    release is a slot's.
# 6. An aggregate constructor retains every counted field it captures —
#    Pair(one: p, two: q) copies the str handle inside p, and the new
#    value is a second owner. Found by running it: printed correctly,
#    double-freed at exit.
#
# The cost is over-retention rather than a leak: a string is held by
# its synthetic slot until the function returns. Performance is a
# non-goal (Part 2) and correctness is not; a loop does not accumulate,
# because the synthetic slot is overwritten each iteration and the
# overwrite releases.

use token
use ast
use source
use check/state
use ir
use ir/containers
use ir/layout
use ir/owning
use parse
use resolve
use checker
use ir/lower
use ir/mono
use ir/verify
use ir/place_store
use ir/survival
use ir/uses
use ir/released

# Insert the reference counting. Idempotent by construction: advance_to
# refuses a second run.
function run(@p: containers.Program, c: state.Checked)
    rewritten: [containers.Function] @ []

    for f in p.functions
        rewritten @ rewritten.push(rewrite(f, c))

    p.functions @ rewritten
    containers.advance_to(@p, .owned)

# Two walks, and the order is the whole correctness argument: the first
# inserts the increfs and the moves, which is what CREATES the
# synthetic slots; the second appends the exit sweeps, which need the
# slot list to be complete. Done in one walk, a block that returns
# early sweeps only the slots invented before it — caught immediately
# as `returns without releasing $own7`.
#
# **Linear in a block, since defect 230 (2026-10-03).** Three costs made
# this pass the square of a block's length, counted on one function of 800
# strings: a walk to the block's end for every counted load (now
# `survival.survivors`, two walks of the block for all its loads); a
# `.must()` inside a pushed instruction, which opens a block between the
# load of `out` and its store, so the place store could not grow `out` in
# place and the push copied it whole, and its result's synthetic slot made
# the next push copy it again, 2,240,146 instructions copied twice over
# (now the value is named first); and a slot or a value added through
# `worked`'s fields, a path the place store does not grow, so each one
# copied the whole table (now `slots` and `values`, grown in place and put
# back before the sweep reads them).
function rewrite(f: containers.Function, c: state.Checked) -> containers.Function
    worked: containers.Function @ f
    slots: [containers.Slot] @ worked.slots
    values: [i64] @ worked.values
    index: i64 @ 0

    while index < worked.blocks.len()
        out: [ir.Inst] @ []
        pos: i64 @ 0
        lives = survival.survivors(worked, worked.blocks[index].insts, worked.blocks[index].term).survive

        for inst in worked.blocks[index].insts
            here = pos
            pos @ pos + 1
            handled: bool @ false

            match inst.op
                # A borrowed load whose value outlives a write to its own
                # root loses its header the moment counts are honest
                # (place_store.load_survives_write says why). Give it a
                # reference of its own, and rule 5's slot machinery does
                # the rest.
                .load =>
                    if !inst.dest.is_err() && layout.is_refcounted(c, inst.ty) && lives[here]
                        moved = inst.dest.must()
                        out @ out.push(inst)
                        out @ out.push(
                            ir.Inst(dest: fail(code: "none", msg: "void"), op: .incref(value: moved), ty: inst.ty, span: inst.span)
                        )
                        slot = own_slot(@slots, ty: inst.ty)
                        place = ir.Place(root: slot, path: ir.Run(start: 0, length: 0))
                        old = fresh(@values, ty: inst.ty)
                        out @ out.push(ir.Inst(dest: ok(old), op: .load(place: place), ty: inst.ty, span: inst.span))
                        out @ out.push(
                            ir.Inst(dest: fail(code: "none", msg: "void"), op: .store(place: place, value: moved), ty: inst.ty, span: inst.span)
                        )
                        out @ out.push(
                            ir.Inst(dest: fail(code: "none", msg: "void"), op: .decref(value: old), ty: inst.ty, span: inst.span)
                        )
                        handled @ true
                # Rule 3: the old value dies when the slot is
                # overwritten, and the new one must be alive before it
                # does.

                .store st =>
                    ty = containers.value_type(worked, st.value)

                    if layout.is_refcounted(c, ty)
                        indexed: bool @ false

                        for step in containers.steps_of(worked, st.place.path)
                            match step
                                .index_step => indexed @ true
                                .field_step => continue

                        if indexed
                            out @ out.push(
                                ir.Inst(dest: fail(code: "none", msg: "void"), op: .incref(value: st.value), ty: ty, span: inst.span)
                            )
                            out @ out.push(inst)
                        else
                            old = fresh(@values, ty: ty)
                            out @ out.push(ir.Inst(dest: ok(old), op: .load(place: st.place), ty: ty, span: inst.span))
                            out @ out.push(
                                ir.Inst(dest: fail(code: "none", msg: "void"), op: .incref(value: st.value), ty: ty, span: inst.span)
                            )
                            out @ out.push(inst)
                            out @ out.push(
                                ir.Inst(dest: fail(code: "none", msg: "void"), op: .decref(value: old), ty: ty, span: inst.span)
                            )
                        handled @ true
                # Rule 6: an aggregate constructor retains every counted
                # field it captures — nothing else in the pass adds that
                # reference.

                .construct con =>
                    if owning.retains_fields(con.shape)
                        for arg in containers.args_of(worked, con.arguments)
                            match arg
                                .value_arg v =>
                                    arg_ty = containers.value_type(worked, v.value)

                                    if layout.is_refcounted(c, arg_ty)
                                        out @ out.push(
                                            ir.Inst(dest: fail(code: "none", msg: "void"), op: .incref(value: v.value), ty: arg_ty, span: inst.span)
                                        )
                                .inout_arg => continue
                .lit | .push_owned | .unary | .binary | .cast | .call                                   => handled @ handled
                .field | .index | .map_get | .len_of | .tag_of | .payload                               => handled @ handled
                .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => handled @ handled

            if handled
                continue
            out @ out.push(inst)

            # Rule 5: move an owning result into a slot, NOW, in this
            # block. The reference is MOVED — no incref, no decref of
            # the temporary — which is what makes every later value
            # borrowed.
            if !inst.dest.is_err() && owning.allocates(inst.op) && layout.is_refcounted(c, inst.ty)
                moved = inst.dest.must()
                slot = own_slot(@slots, ty: inst.ty)
                place = ir.Place(root: slot, path: ir.Run(start: 0, length: 0))
                old = fresh(@values, ty: inst.ty)
                out @ out.push(ir.Inst(dest: ok(old), op: .load(place: place), ty: inst.ty, span: inst.span))
                out @ out.push(
                    ir.Inst(dest: fail(code: "none", msg: "void"), op: .store(place: place, value: moved), ty: inst.ty, span: inst.span)
                )
                out @ out.push(
                    ir.Inst(dest: fail(code: "none", msg: "void"), op: .decref(value: old), ty: inst.ty, span: inst.span)
                )

        worked.blocks[index].insts @ out
        index @ index + 1

    worked.slots @ slots
    worked.values @ values

    # The second walk. Rules 1 and 2 decide the list: local and
    # synthetic slots only, because a plain parameter is borrowed and an
    # @ parameter is copied out. Which slots are parameters is read once,
    # where every slot walked the parameters (defect 230), and this reading
    # stays its own: `released.owed_slots` is the verifier's of the same rules.
    is_param: [bool] @ []

    while is_param.len() < worked.slots.len()
        is_param @ is_param.push(false)

    for param in worked.params
        if param >= 0 && param < is_param.len()
            is_param[param] @ true

    sweep: [i64] @ []
    slot_at: i64 @ 0

    for slot in worked.slots
        owed: bool @ false

        match slot.kind
            .local_slot | .synthetic_slot => owed @ true
            .param_slot                   => owed @ owed

        if owed && layout.is_refcounted(c, slot.ty) && !is_param[slot_at]
            sweep @ sweep.push(slot_at)
        slot_at @ slot_at + 1

    index @ 0

    while index < worked.blocks.len()
        returns: bool @ false
        returned: i64? @ fail(code: "none", msg: "no value")

        match worked.blocks[index].term
            .return_term ret =>
                returns @ true
                returned @ ret.value
            .jump | .branch | .switch_term | .unreachable | .open => returns @ returns

        if returns
            span: token.Span @ worked.span

            if worked.blocks[index].insts.len() > 0
                span @ worked.blocks[index].insts[worked.blocks[index].insts.len() - 1].span
            out: [ir.Inst] @ worked.blocks[index].insts

            # Rule 4, before the sweep: the returned value is borrowed
            # by here — it lives in a slot — so the caller's reference
            # has to be a new one.
            if !returned.is_err()
                back = returned.must()
                ret_ty = containers.value_type(worked, back)

                if layout.is_refcounted(c, ret_ty)
                    out @ out.push(
                        ir.Inst(dest: fail(code: "none", msg: "void"), op: .incref(value: back), ty: ret_ty, span: span)
                    )

            # **One instruction per swept slot, since panel 106.** This was
            # a load into a fresh temporary followed by a decref of it, on
            # the reasoning — written into `ir.hero` beside the op — that
            # releasing a slot IS a load plus a decref, so the IR keeps one
            # form and the dominance check covers it for free. Both halves
            # were true; the sitting measured the price. The temporary is
            # address-taken by the release it feeds, so clang can never
            # promote it out of the frame, and one per swept slot per
            # returning block came to **58.5% of all declared frame bytes**
            # — measured over `examples/interpreter/`, whose recursion
            # ceiling that cost 191 levels at `-O0` where the same program
            # reaches 311 without them.
            for slot_id in sweep
                ty = worked.slots[slot_id].ty
                out @ out.push(
                    ir.Inst(dest: fail(code: "none", msg: "void"), op: .decref_slot(slot: slot_id), ty: ty, span: span)
                )

            worked.blocks[index].insts @ out
        index @ index + 1

    return worked

# A synthetic slot for one owning temporary. Its name starts with $,
# which no Heroes program contains.
function own_slot(@slots: [containers.Slot], ty: i64) -> i64
    index = slots.len()
    slots @ slots.push(containers.Slot(name: "$own" + index.to_str(), ty: ty, kind: .synthetic_slot))
    return index

# A value the pass invented. It extends the values table, which is
# dense over the ids, so the type table stays complete.
function fresh(@values: [i64], ty: i64) -> i64
    id = values.len()
    values @ values.push(ty)
    return id

## Tests

record OwnedOut
    program: containers.Program
    checked: state.Checked
    decls: [ast.Decl]

function owned(text: str) -> OwnedOut
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    resolved_out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, resolved_out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, resolved_out, c, s, parsed.decls)
    p: containers.Program @ low.program
    mono_problems = mono.run(@p, @c, s, parsed.decls)
    assert mono_problems.len() == 0
    run(@p, c)
    return OwnedOut(program: p, checked: c, decls: parsed.decls)

test "the whole chain verifies at owned: strings, loops, records, a generic"
    got = owned(
        "record Pair\n    one: str\n    two: str\n\nfunction id<T>(x: T) -> T\n    return x\n\nfunction shout(name: str) -> str\n    prefix = \"hi \"\n    return prefix + name\n\nfunction main()\n    p = Pair(one: id(\"a\"), two: \"b\")\n    total: str @ \"\"\n    parts = [p.one, p.two]\n    for part in parts\n        total @ total + part\n    print(shout(total))\n"
    )
    problems = verify.verify(got.program, got.checked, got.decls)
    assert problems.len() == 0
    assert containers.phase_rank(got.program.phase) == 2

test "a store expands to load-incref-store-decref, and the sweep closes returns"
    got = owned("function shout(name: str) -> str\n    prefix = \"hi \"\n    return prefix + name\n")
    f = got.program.functions[0]

    # The concatenation's result was moved into an $own slot.
    moved: bool @ false

    for slot in f.slots
        if slot.name == "$own2"
            moved @ true

    assert moved

    # The returning block increfs the result and then decrefs every
    # owned slot — rule 4 before the sweep.
    last = f.blocks[f.blocks.len() - 1]
    incref_at: i64 @ 0 - 1
    last_decref: i64 @ 0 - 1
    at: i64 @ 0

    for inst in last.insts
        match inst.op
            .incref                                                                             => incref_at @ at
            .decref | .decref_slot                                                              => last_decref @ at
            .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                           => at @ at
            .func_ref | .copy_out | .abort_op | .hole | .missing                                => at @ at

        at @ at + 1

    assert incref_at >= 0
    assert last_decref > incref_at

test "a straight function of 400 chained strings verifies at owned, its sweep read in two walks"
    # Each line reads the one before, so no expression nests and every
    # binding is used; the ownership pass moves two results a line into
    # slots and sweeps all of them at the one return. Defect 218's shape: the
    # release check read that sweep in about slots x decrefs x instructions
    # / 2, 3e9 steps here (derived, not run), and now reads it in two walks.
    lines: [str] @ ["function f(x: i64) -> str", "    s0 = x.to_str()"]

    while lines.len() < 402
        lines @ lines.push("    s" + (lines.len() - 1).to_str() + " = s" + (lines.len() - 2).to_str() + " + x.to_str()")

    lines @ lines.push("    return s400")
    got = owned(lines.join("\n") + "\n\nfunction main()\n    print(f(x: 3).len())\n")
    assert verify.verify(got.program, got.checked, got.decls).len() == 0
    checked_one: bool @ false

    for f in got.program.functions
        if f.name == "f"
            owed = released.owed_slots(f, got.checked)
            assert owed.len() > 1000

            for blk in f.blocks
                match blk.term
                    .return_term =>
                        read = released.releases(blk)
                        assert read.visits <= 3 * blk.insts.len()

                        for slot in owed
                            assert !read.released[slot].is_err()

                        checked_one @ true
                    .jump | .branch | .switch_term | .unreachable | .open => continue

    assert checked_one

test "a block's survivors are the per-load walk's, the writer table is the per-root reading, and both walks stay linear"
    # Defect 230's oracle, over the IR the ownership pass is handed (after
    # the place store). `place_store.load_survives_write` is the walk per
    # load this replaced and answers every load here; the per-root reading
    # of what an operation writes is written out below as it stood, and
    # answers every instruction and every root. The programs hold loads that
    # survive an `@` call (`place-store-c5`'s case 5) and a copy-out, a
    # self-store whose load is read only by the store that writes it, and
    # straight functions of many counted loads, which made the old walk the
    # square of a block.
    many: [str] @ ["function f(x: i64) -> i64", "    s0 = \"a\" + x.to_str()"]

    while many.len() < 42
        many @ many.push("    s" + (many.len() - 1).to_str() + " = s" + (many.len() - 2).to_str() + " + x.to_str()")

    many @ many.push("    return s40.len()")
    params: [str] @ []
    grows: [str] @ []
    calls: [str] @ []
    decls: [str] @ []

    while params.len() < 12
        n = params.len().to_str()
        params @ params.push("@p" + n + ": str")
        grows @ grows.push("    p" + n + " @ p" + n + " + \"!\"")
        calls @ calls.push("p" + n + ": @a" + n)
        decls @ decls.push("    a" + n + ": str @ \"x\"")

    texts: [str] = [
        "function bump(@v: [i64]) -> i64\n    v @ v.push(99)\n    return v.len()\n\nfunction echo(@s: str) -> str\n    s @ s + \"!\"\n    return s\n\nfunction shout(@s: str, t: str) -> str\n    return s + echo(@s) + t\n\nfunction main()\n    qs: [i64] @ []\n    qs @ qs.push(1)\n    qs @ qs.push(bump(@qs))\n    ys = qs\n    qs @ qs.push(3)\n    s: str @ \"a\"\n    s @ s\n    t = shout(s: @s, t: \"b\")\n    print(qs.len(), \" \", ys.len(), \" \", t, \" \", s)\n"
        many.join("\n") + "\n\nfunction main()\n    print(f(x: 3))\n"
        "function g(" + params.join(", ") + ")\n" + grows.join("\n") + "\n\nfunction main()\n" + decls.join("\n") + "\n    g(" + calls.join(", ") + ")\n    print(a0.len())\n"
    ]
    survived: i64 @ 0

    for text in texts
        parsed = parse.parse(text)
        s = source.new_source(name: "t.hero", text: text)
        resolved_out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
        c: state.Checked @ checker.check(parsed.tree, resolved_out, s, parsed.decls)
        assert c.diagnostics.len() == 0
        low = lower.lower(parsed.tree, resolved_out, c, s, parsed.decls)
        p: containers.Program @ low.program
        assert mono.run(@p, @c, s, parsed.decls).len() == 0
        place_store.run(@p)

        for f in p.functions
            for blk in f.blocks
                got = survival.survivors(f, blk.insts, blk.term)
                operands: i64 @ uses.terminator_operands(blk.term).len()
                at: i64 @ 0

                for one in blk.insts
                    operands @ operands + uses.operands(f, one.op).len()

                    match one.op
                        .load ld =>
                            if !one.dest.is_err()
                                old = place_store.load_survives_write(
                                    f,
                                    blk.insts,
                                    blk.term,
                                    load_at: at,
                                    root: ld.place.root,
                                    value: one.dest.must()
                                )
                                assert got.survive[at] == old

                                if old
                                    survived @ survived + 1
                        .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => at @ at
                        .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
                        .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at

                    written = survival.roots_written(f, one.op)
                    root: i64 @ 0

                    while root < f.slots.len()
                        before: bool @ false

                        match one.op
                            .store st      => before @ st.place.root == root
                            .push_owned pg => before @ pg.place.root == root
                            .copy_out      => before @ true
                            .call cl =>
                                for arg in containers.args_of(f, cl.arguments)
                                    match arg
                                        .inout_arg io =>
                                            if io.place.root == root
                                                before @ true
                                        .value_arg => continue
                            .construct con =>
                                for arg in containers.args_of(f, con.arguments)
                                    match arg
                                        .inout_arg io =>
                                            if io.place.root == root
                                                before @ true
                                        .value_arg => continue
                            .abort_op ab =>
                                for arg in containers.args_of(f, ab.arguments)
                                    match arg
                                        .inout_arg io =>
                                            if io.place.root == root
                                                before @ true
                                        .value_arg => continue
                            .lit | .load | .unary | .binary | .cast                         => before @ false
                            .field | .index | .map_get | .len_of | .tag_of | .payload       => before @ false
                            .func_ref | .incref | .decref | .decref_slot | .hole | .missing => before @ false

                        now: bool @ written.every

                        for r in written.roots
                            if r == root
                                now @ true

                        assert now == before
                        assert place_store.writes_root(f, one.op, root: root) == before
                        root @ root + 1

                    at @ at + 1

                # Two walks of the block: each operand once, each
                # instruction once, whatever the number of loads.
                assert got.visits <= blk.insts.len() + operands

    # Case 5's receiver read after `bump(@qs)`, `echo`'s `s` returned after
    # its copy-out, and `shout`'s `s` read after `echo(@s)` survive: the
    # oracle saw each kind answer true, and `g`'s twelve answer false.
    assert survived >= 3
