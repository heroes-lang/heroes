# Where a field lives, and which case a name is (design.md §4.2, §4.6,
# §4.9). Port of archive/bootstrap-rs/heroes/src/ir/layout.rs.
#
# By here a field is an INDEX, not a name. The checker already matched
# the name against the declaration to give the expression its type;
# comparing strings again would be a second answer to a question that
# was already answered, and the two could disagree. This module is the
# one place the translation happens, and it is deliberately small.
#
# Three shapes carry fields, and the third is the one that surprises: a
# T?'s error side is a BUILT-IN record of two str fields, code and msg
# (§4.6). The spec states those two fields and nothing else, so their
# indices are fixed here rather than read from a declaration that does
# not exist.
#
# Nothing here reorders anything, and that is a finding rather than an
# omission: Part 5's "named arguments -> positional" row costs zero
# lines because a label in Heroes never reorders an argument — the
# checker verified the label written at a position against the parameter
# AT that position, so the arguments were already in declaration order
# before lowering saw them.

use token
use ast
use source
use check/table
use check/state
use parse
use resolve
use checker

# The two fields of the built-in failure record, in order.
constant FAILURE_FIELDS: [str]
    ["code", "msg"]

# The TYPE of a field within the type that holds it — the sibling of
# field_index, walking the same declaration for the other half of the
# answer. It exists because one caller cannot get it from expr_types:
# `h.f(n)` where f holds a function value has NO expression node for the
# field read — the parser saw a method call, and the field is
# synthesised during lowering. The type is written in the record's own
# declaration, and written_type has it (panel 068 F8).
function field_type(decls: [ast.Decl], c: state.Checked, s: source.Source, owner: i64, name: token.Span) -> i64?
    wanted = source.span_text(s, name)

    match table.get(c.types, owner)
        .named n =>
            match decls[n.decl].kind
                .record_decl rec =>
                    for field in rec.fields
                        if source.span_text(s, field.name) == wanted
                            return state.written_type(c, field.ty)

                    return fail("absent", "no such field")
                .constant_decl | .function_decl | .variant_decl | .test_decl => return fail("absent", "not a record")
        .case_ty vc =>
            match decls[vc.decl].kind
                .variant_decl v =>
                    for field in v.cases[vc.at].fields
                        if source.span_text(s, field.name) == wanted
                            return state.written_type(c, field.ty)

                    return fail("absent", "no such payload field")
                .constant_decl | .function_decl | .record_decl | .test_decl => return fail("absent", "not a variant")
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return fail("absent", "no fields")
        .array | .fixed | .map | .fallible | .function_ty         => return fail("absent", "no fields")
        .failure | .generic | .error                              => return fail("absent", "no fields")

    return fail("absent", "unreached")

# The index of a field within the type that holds it, or absent if that
# type holds no such field — which by here means the checker reported
# something and lowering should stay quiet.
function field_index(decls: [ast.Decl], c: state.Checked, s: source.Source, owner: i64, name: token.Span) -> i64?
    wanted = source.span_text(s, name)

    match table.get(c.types, owner)
        .named n =>
            match decls[n.decl].kind
                .record_decl rec =>
                    names: [str] @ []

                    for field in rec.fields
                        names @ names.push(source.span_text(s, field.name))

                    return position(names, wanted)
                .constant_decl | .function_decl | .variant_decl | .test_decl => return fail("absent", "not a record")
        .case_ty vc =>
            match decls[vc.decl].kind
                .variant_decl v =>
                    names: [str] @ []

                    for field in v.cases[vc.at].fields
                        names @ names.push(source.span_text(s, field.name))

                    return position(names, wanted)
                .constant_decl | .function_decl | .record_decl | .test_decl => return fail("absent", "not a variant")
        .failure                                                  => return position(FAILURE_FIELDS, wanted)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return fail("absent", "no fields")
        .array | .fixed | .map | .fallible | .function_ty         => return fail("absent", "no fields")
        .generic | .error                                         => return fail("absent", "no fields")

    return fail("absent", "unreached")

# The index of a variant's case by name: what a switch arm and a `.case`
# construction both need.
function case_index(decls: [ast.Decl], s: source.Source, decl: i64, name: token.Span) -> i64?
    wanted = source.span_text(s, name)

    match decls[decl].kind
        .variant_decl v =>
            names: [str] @ []

            for one_case in v.cases
                names @ names.push(source.span_text(s, one_case.name))

            return position(names, wanted)
        .constant_decl | .function_decl | .record_decl | .test_decl => return fail("absent", "not a variant")

    return fail("absent", "unreached")

function position(names: [str], wanted: str) -> i64?
    at: i64 @ 0

    for name in names
        if name == wanted
            return ok(at)
        at @ at + 1

    return fail("absent", "no such name")

# Whether a value of this type carries a reference the compiler must
# count (panels 021, 022). ONE HOME for this question: the ownership
# pass, the prologue's zero-initialisation, the exit sweep and the
# descriptor pass all ask it, and two answers that disagree about which
# types are counted is a refcount bug that reproduces once a week.
# It is a LOOKUP: the answer is transitive, so it was computed once by
# check_counted, where the declarations were in hand. An out-of-range id
# aborts on the array bound — a missing entry reading as "not counted"
# would be a silent leak.
function is_refcounted(c: state.Checked, ty: i64) -> bool
    return c.counted[ty]

## Tests

function checked_text() -> str
    return "record Point\n    x: i64\n    y: str\n\nvariant Tok\n    word\n        text: str\n    plus\n\nfunction f() -> i64\n    msg = 1\n    return msg\n"

test "a field, a payload field and a failure field all become indices"
    text = checked_text()
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c = checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0

    # The test program checks clean but never SPEAKS these types in an
    # expression, so their ids may be fresh: every query goes through a
    # Checked carrying the extended table — an id must never be asked of
    # a table that did not issue it.
    tbl: table.Types @ c.types
    point = table.intern(@tbl, .named(decl: 0))
    word_case = table.intern(@tbl, .case_ty(decl: 1, at: 0))
    failure = table.intern(@tbl, .failure)
    widened: state.Checked @ c
    widened.types @ tbl

    # The span arithmetic is guarded: the test first proves the span
    # says what it thinks it says.
    y_span = token.Span(start: 28, end: 29)
    assert source.span_text(s, y_span) == "y"
    assert field_index(p.decls, widened, s, owner: point, name: y_span).must() == 1
    ty_of_y = field_type(p.decls, widened, s, owner: point, name: y_span).must()
    assert ty_of_y == table.str_ty(c.types)

    # The variant case: text's payload inside word.
    text_span = token.Span(start: 65, end: 69)
    assert source.span_text(s, text_span) == "text"
    assert field_index(p.decls, widened, s, owner: word_case, name: text_span).must() == 0

    # The built-in failure record: msg is field 1, with no declaration
    # anywhere.
    msg_span = token.Span(start: 109, end: 112)
    assert source.span_text(s, msg_span) == "msg"
    assert field_index(p.decls, widened, s, owner: failure, name: msg_span).must() == 1
    assert field_index(p.decls, widened, s, owner: point, name: msg_span).is_err()

test "a case name becomes its index, and counted is a lookup"
    text = checked_text()
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c = checker.check(p.tree, out, s, p.decls)
    plus_span = token.Span(start: 79, end: 83)
    assert source.span_text(s, plus_span) == "plus"
    assert case_index(p.decls, s, decl: 1, name: plus_span).must() == 1
    assert is_refcounted(c, table.str_ty(c.types))
    assert !is_refcounted(c, table.int_ty_id(c.types))
