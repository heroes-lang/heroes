# The reading `ir/released.hero`'s `releases` replaced, kept as the oracle its
# test holds it to (design.md Part 5; panel 106; defect 218). Split out of that
# file on 2026-10-07, when panel 196's R1 gave both readings a call's hold to
# skip and the file passed §11's 300 lines: what the verifier asks is there,
# and what it is checked against is here, a seam the file already drew with
# its `## Tests` heading.

use token
use ir
use ir/containers

# The reading this file replaced, word for word as `ir/phases.hero` held it at
# b7edbc35: the oracle the generated blocks below hold `releases` to.
# The index just past this slot's last whole-slot store, 0 when it was
# never written: the sweep's load must come after it.
function last_write(blk: containers.Block, slot_at: i64) -> i64
    floor: i64 @= 0
    at: i64 @= 0

    for inst in blk.insts
        # The no-op arms MUST NOT say continue: the counter at the
        # bottom is the position, and continue skips it — found the day
        # the ownership pass first exercised this check, as twelve
        # false "returns without releasing".
        match inst.op
            .store st =>
                if st.place.root == slot_at && st.place.path.length == 0
                    floor @ at + 1
            .lit | .load | .push_owned | .unary | .binary | .cast | .call | .construct              => at @ at
            .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
            .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at

        at @ at + 1

    return floor

function released_after(blk: containers.Block, slot_at: i64, floor: i64) -> bool
    at: i64 @= 0

    for inst in blk.insts
        if at >= floor
            match inst.op
                # The direct form, since panel 106: the release names the
                # slot, so the question this function asks is answered by
                # reading the instruction rather than by tracing a
                # temporary back to its load.
                .decref_slot ds =>
                    if ds.slot == slot_at
                        return true
                .decref rc =>
                    if loaded_from(blk, value: rc.value, slot_at: slot_at, floor: floor, before: at) && !balanced(blk, value: rc.value, at: at)
                        return true
                .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => at @ at
                .field | .index | .map_get | .len_of | .tag_of | .payload                           => at @ at
                .func_ref | .copy_out | .abort_op | .incref | .hole | .missing                      => at @ at
        at @ at + 1

    return false

# Was `value` produced by a whole-slot load of this slot, between the
# floor and the decref?
function loaded_from(blk: containers.Block, value: i64, slot_at: i64, floor: i64, before: i64) -> bool
    at: i64 @= 0

    for inst in blk.insts
        if at >= floor && at < before
            if !inst.dest.is_err() && inst.dest.must() == value
                match inst.op
                    .load ld =>
                        if ld.place.root == slot_at && ld.place.path.length == 0
                            return true
                    .lit | .store | .push_owned | .unary | .binary | .cast | .call | .construct             => at @ at
                    .field | .index | .map_get | .len_of | .tag_of | .payload                               => at @ at
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => at @ at
        at @ at + 1

    return false

# Does the decref of `value` at `at` balance an incref of it earlier in the
# block? Each incref is balanced by the first decref after it that no earlier
# incref took: a call's hold (`ir/held.hero`), added to the reading above on
# 2026-10-07 by panel 196's R1, and to `releases` in the same words.
function balanced(blk: containers.Block, value: i64, at: i64) -> bool
    retained: i64 @= 0
    position: i64 @= 0

    for inst in blk.insts
        if position == at
            return retained > 0

        match inst.op
            .incref rc =>
                if rc.value == value
                    retained @ retained + 1
            .decref rc =>
                if rc.value == value && retained > 0
                    retained @ retained - 1
            .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct => position @ position
            .field | .index | .map_get | .len_of | .tag_of | .payload                           => position @ position
            .func_ref | .copy_out | .abort_op | .decref_slot | .hole | .missing                 => position @ position

        position @ position + 1

    return false

# A generator, so the blocks are many and the same on every run: C's own
# `rand` example's constants, every product inside an i64.
function step(@seed: i64) -> i64
    seed @ (seed * 1103515245 + 12345) % 2147483648
    return seed / 65536

# A returning block of up to 40 loads, stores, releases and others over
# `slots` slots and a dozen values, drawn so that values collide, a slot is
# written twice, a store or a load runs through a path, and a release or a
# place names a slot that does not exist: the ill-formed IR the verifier is
# for, beside the well-formed.
function generated(@seed: i64, slots: i64) -> containers.Block
    span = token.Span(start: 0, end: 1)
    void: i64? = fail(code: "none", msg: "void")
    insts: [ir.Inst] @= []
    wanted = step(@seed) % 41

    while insts.len() < wanted
        kind = step(@seed) % 6
        root = step(@seed) % (slots + 2) - 1
        value = step(@seed) % 12
        place = ir.Place(root: root, path: ir.Run(start: 0, length: step(@seed) % 4 / 3))

        if kind == 0
            insts @ insts.push(ir.Inst(dest: void, op: .store(place: place, value: value), ty: 0, span: span))
        else if kind == 1
            insts @ insts.push(ir.Inst(dest: ok(value), op: .load(place: place), ty: 0, span: span))
        else if kind == 2
            insts @ insts.push(ir.Inst(dest: void, op: .decref(value: value), ty: 0, span: span))
        else if kind == 3
            insts @ insts.push(ir.Inst(dest: void, op: .decref_slot(slot: root), ty: 0, span: span))
        else if kind == 4
            insts @ insts.push(ir.Inst(dest: ok(value), op: .lit(value: .bool_const(value: true)), ty: 0, span: span))
        else
            insts @ insts.push(ir.Inst(dest: void, op: .incref(value: value), ty: 0, span: span))

    return containers.Block(
        preds: [],
        insts: insts,
        term: .return_term(value: fail(code: "none", msg: "no value")),
        note: "g"
    )
