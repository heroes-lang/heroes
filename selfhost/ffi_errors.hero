# The diagnostics about what may cross the FFI boundary (design.md §4.19;
# panels 036, 038, 060, 061, 062, 069).
# Port of archive/bootstrap-rs/heroes/src/types/errors/ffi.rs.
#
# Three codes and not one, because the reader's mistake differs in each: a
# signature names a type C cannot spell; a `constant` names a type that is
# a Heroes VALUE rather than something a header holds; a FIELD is inside a
# struct whose layout is the header's, where the repair depends on which
# Heroes type was written and is carried in the note rather than guessed.

use token
use diag

# A type in an extern's signature that no C header can declare (§4.19).
# The message names what the boundary DOES carry, because the repair is
# almost always a different signature rather than a different design.
# The list gained `(function(A) -> B)` with panel 111 R4's permission and
# in the same commit: a list of what crosses that omits something that
# does is the document and the compiler disagreeing on day one, and the
# reader believes the compiler.
function ffi_type(name: str, what: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "ffi_type",
        message: "`" + name + "` cannot cross the FFI boundary, and it is " + what + " — a C header can declare a number, `bool`, `str`, `ptr`, `cstr`, a function type as a parameter, and a `record` declared in this same group (§4.19)",
        span: span
    )

# A callback whose OWN parameter or result cannot cross (panel 113 R2,
# defect 014, 2026-09-06).
#
# It reuses the `ffi_type` code for `ffi_result_position`'s reason — the
# class already means "this extern's declared type is wrong" — and it may
# not reuse the `ffi_type` MESSAGE, for that function's reason turned
# around. That message ends by listing what a header can declare, and the
# list includes *a function type as a parameter*: true, and here it reads
# as a contradiction, because a function type as a parameter is exactly
# what the reader wrote. The refusal is one level down, so the message
# has to say which level.
function ffi_callback_carries(callback: str, carried: str, what: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_type",
        message: "`" + callback + "` cannot cross the FFI boundary, and it is " + what + " — the callback may stand there, but `" + carried + "` inside it cannot (§4.19)",
        span: span
    )
    d.notes @ d.notes.push(
        "a callback's parameters and result follow the same rule as any other extern type (spec, § FFI), so `" + carried + "` is refused inside one for the reason it is refused outside one: a C header cannot declare it, and a value C holds is a value this compiler stopped tracking"
    )
    d.notes @ d.notes.push(
        "where C has to see the elements, hand it what C already understands — a `ptr` and a length, or one scalar at a time — and keep the container on the Heroes side of the call"
    )
    return d

# A function type written as an extern's RESULT (§4.19, panel 111 R4).
# It reuses `ffi_type` for the same reason ffi_parameter_position reuses
# ffi_parameter_type: the class already means "this extern's declared
# type is wrong", and it is the code the reader is already looking at.
# What it may not reuse is the ffi_type MESSAGE, which now says a
# function type crosses — true of a parameter, and the sentence a reader
# would take as permission here.
function ffi_result_position(function_name: str, name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_type",
        message: "`" + function_name + "` cannot return `" + name + "` — a function type crosses the FFI boundary as a *parameter* only (§4.19)",
        span: span
    )
    d.notes @ d.notes.push(
        "the address a Heroes program passes OUT is one this compiler emitted, so C calls a body this compiler type-checked. An address C hands BACK is a body nothing here has seen, and calling it through a Heroes call site would convert the arguments and hold the result the way this language does, against a signature no probe compared to the header"
    )
    d.notes @ d.notes.push(
        "declare the result `ptr` if the program only stores it and hands it back to C"
    )
    return d

# A type that CAN cross the boundary but cannot be a value a header holds
# (§4.19, panel 038). Separate from ffi_type because the reader did not
# reach for a type C has never heard of — they reached for one that works
# perfectly in a signature — so the message carries the reason rather
# than the list: the list would say the type is allowed.
function ffi_constant_type(name: str, why: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "ffi_constant_type",
        message: "an `extern constant` cannot be declared `" + name + "` — " + why,
        span: span
    )

# A type that can cross in a RESULT and cannot be an ARGUMENT (§4.19,
# panel 062's follow-up). It reuses ffi_parameter_type deliberately
# rather than opening a code: that class already means "this parameter's
# declared type is wrong", it is where a reader will already be looking,
# and a new diagnostic CLASS is a panel path which a second name for one
# question would be.
function ffi_parameter_position(parameter: str, function_name: str, name: str, why: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "ffi_parameter_type",
        message: "`" + parameter + "` of `" + function_name + "` cannot be declared `" + name + "` — " + why,
        span: span
    )

# A field of a group's record whose type no C header can hold (§4.19,
# panel 060). The author has written a Heroes type inside what is really
# a C struct, and the repair depends on which one — carried in the note.
function ffi_field_type(name: str, why: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_field_type",
        message: "`" + name + "` cannot be a field of a `record` in an `extern` group — the header owns the layout, and it can hold a number, `bool`, `ptr`, `cstr`, or another record of the group (§4.19)",
        span: span
    )
    d.notes @ d.notes.push(why)
    return d

# A record its group marked `partial`, reached by an operation that reads
# the fields nobody named (panel 061). The message names the record
# REACHED and the type in hand, because they are often not the same:
# "`[Font]` names only some members" is false — an array has no C struct
# — and it sends the reader looking at the array.
# Port note: Rust calls this parameter `record`; Heroes reserves the
# word, so the port says `holder`.
function partial_operation(holder: str, shown: str, what: str, span: token.Span) -> diag.Diagnostic
    through: str @ ""

    if holder != shown
        through @ " — reached through `" + shown + "`"
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_partial_operation",
        message: "`" + holder + "` is `partial`, so it cannot be " + what + through + ": the fields it does not name are part of the answer, and this program cannot see them",
        span: span
    )
    d.notes @ d.notes.push(
        "a `partial` record may be read, copied, passed to C and returned from it — what it gives up is `==`, `hash` and being a map key. Name every field of the header's struct to get them back, and drop `partial` from `" + holder + "`"
    )
    return d

# A literal built for a fixed array whose length it does not match (panel
# 062). BOTH numbers are in the message, because the reader's mistake is
# a count and a count is invisible in a type name.
function fixed_array_length(want: str, expected: i64, got: i64, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "fixed_array_length",
        message: "`" + want + "` holds exactly " + expected.to_str() + ", and this literal has " + got.to_str() + " — a fixed array's length is part of its type, so the two must agree (§4.19)",
        span: span
    )

# A literal index past the end of a fixed array (panel 062). A compile
# error and not an abort — the one place a fixed array is SAFER than [T]
# rather than merely different: the length is in the type, so the mistake
# is visible without running the program.
function fixed_index_out_of_range(shown: str, length: i64, got_text: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "fixed_index_out_of_range",
        message: "`" + shown + "` holds " + length.to_str() + ", so its last index is " + (length - 1).to_str() + ", and this is " + got_text + " — a fixed array's length is part of its type, so the index is checked here rather than at run time",
        span: span
    )

# `i32[4]` in an ordinary record (panel 062).
function fixed_outside_a_group(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "fixed_outside_a_group",
        message: "`" + name + "` is a C array member, so it belongs to a `record` inside an `extern` group — this record's layout is this language's, and a fixed array exists to match one a C compiler chose (§4.19)",
        span: span
    )
    d.notes @ d.notes.push(
        "use `[T]` here: it grows, it is compared and hashed like any other value, and it is what every Heroes record holds"
    )
    return d

# A map key that reaches a float (panel 069 R4). A compile error where
# `==` on a float is not, because key-eligibility is a property of the
# map's DECLARED type rather than of a value flowing through it — the
# error points at the annotation the author wrote. The note answers the
# generic case, a condition of the sitting: inside `count<K>`, `{K: i64}`
# cannot be judged here, so the runtime guard stays behind this rule and
# the message says so rather than implying a guarantee the type system
# does not give.
#
# `reached` empty means the key type IS a float; otherwise it names the
# member that is one — the reader's next act differs.
function float_map_key(key: str, reached: str, span: token.Span) -> diag.Diagnostic
    because: str @ "it is a float"

    if reached.len() > 0
        because @ "`" + reached + "` is a float"
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "float_map_key",
        message: "`" + key + "` cannot be a map key, because " + because,
        span: span
    )
    d.notes @ d.notes.push(
        "a `nan` is not equal to itself, so it can be stored and never found again. Key the map on something exact — an `i64` of the value scaled to the precision you need, or a `str` — and keep the float in the value. Reached through a type parameter this cannot be checked, and the runtime aborts instead"
    )
    return d

## Tests

test "the partial refusal names what was reached, only when it differs"
    span = token.Span(start: 0, end: 4)
    direct = partial_operation(holder: "Font", shown: "Font", what: "compared with `==`", span: span)
    assert direct.message == "`Font` is `partial`, so it cannot be compared with `==`: the fields it does not name are part of the answer, and this program cannot see them"
    inside = partial_operation(holder: "Font", shown: "[Font]", what: "compared with `==`", span: span)
    assert inside.message == "`Font` is `partial`, so it cannot be compared with `==` — reached through `[Font]`: the fields it does not name are part of the answer, and this program cannot see them"

test "the fixed-array messages carry both numbers and the last index"
    span = token.Span(start: 0, end: 4)
    short = fixed_array_length(want: "f32[4]", expected: 4, got: 3, span: span)
    assert short.message == "`f32[4]` holds exactly 4, and this literal has 3 — a fixed array's length is part of its type, so the two must agree (§4.19)"
    past = fixed_index_out_of_range(shown: "i32[4]", length: 4, got_text: "7", span: span)
    assert past.message == "`i32[4]` holds 4, so its last index is 3, and this is 7 — a fixed array's length is part of its type, so the index is checked here rather than at run time"

test "a float key splits on is-a-float versus reaches-one"
    span = token.Span(start: 0, end: 4)
    bare = float_map_key(key: "f64", reached: "", span: span)
    assert bare.message == "`f64` cannot be a map key, because it is a float"
    inside = float_map_key(key: "Reading", reached: "Reading.value", span: span)
    assert inside.message == "`Reading` cannot be a map key, because `Reading.value` is a float"
    assert inside.notes.len() == 1

# A lent C pointer standing anywhere but in the call that reads it
# (defect 022, found by the ffi-pragmatist at panel 121; author decision
# 2026-09-09 for the strict rule over the escape-only one).
#
# ONE CODE AND NOT TWO, though the reader arrives by two roads. A lend
# built from an expression is a use-after-free and a lend built from a
# literal is sound, because a literal has static storage; the message
# does not split them, because the two spellings are one brace apart and
# a rule that held only for one of them would teach the difference
# instead of the rule. The note carries the repair, which is a different
# shape of program rather than a different expression, so there is no
# `Fix` here: nothing mechanical turns an escaping pointer into a
# correct one.
#
# THREE SENTENCES OF THIS DIAGNOSTIC WERE WRONG UNTIL PANEL 122, and the
# spec-warden and the ffi seat caught them separately. It said "not an
# argument of an EXTERN call", from a rule the sitting dropped. It said
# the bytes are "released when the function that built it returns",
# which is false in general — the slot is released on re-execution too,
# so a loop frees the previous iteration — and false of every site where
# it then fired, which were literals. And its note prescribed writing
# `.cstr()` inside the extern call, which `extern_across_modules`
# refuses: the two diagnostics pointed at each other, and a reader
# following either arrived at the other.
function cstr_escapes(span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "cstr_escapes",
        message: "`.cstr()` lends this string to C for the length of one call (§4.19), and a lend may stand only as an argument of a call — here it stands somewhere the pointer outlives the bytes it points into",
        span: span
    )
    d.notes @ d.notes.push(
        "pass it directly as an argument of the call that reads it. The bytes belong to the `str`, and the slot holding one is released when its function returns OR when the same expression runs again, whichever comes first — so a lend kept past its call is reading freed memory by the next iteration. A wrapper that reaches C from another module takes a `str` and lends inside itself"
    )
    return d

# A Heroes function whose result is `cstr` (panel 122 R3, defect 022).
#
# WHY A SIGNATURE AND NOT A FLOW ANALYSIS. `return pass(c: s.cstr())` puts the
# lend in an argument position, which the position rule blesses, and returns a
# call RESULT, which no rule about lends can see; both compiling seats built it
# and it is heap-use-after-free under the sanitizer. Refusing the SIGNATURE
# closes the whole route, and it was measured free: every `-> cstr` in this
# tree is already inside an `extern` group.
#
# The repair is the one the corpus already ships, so the note names it rather
# than guessing: answer the `str` and let the caller lend it. That is what
# `tests/golden/surface-fixtures/externroute/bind.hero` does.
function cstr_out_of_heroes(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "cstr_out_of_heroes",
        message: "`" + name + "` answers `cstr`, and a `cstr` is C's pointer rather than this language's string (§4.19) — only a function inside an `extern` group may answer one",
        span: span
    )
    d.notes @ d.notes.push(
        "answer `str` and let the caller lend it with `.cstr()` at the call that reads it. A `cstr` handed out of a Heroes function points into bytes this function stops owning when it returns"
    )
    return d

# A `cstr` field on a record that is not the header's (panel 122 R4).
#
# The reader's mistake differs from `cstr_out_of_heroes`, which is why this is
# its own code: there the pointer leaves through a result, here it is PARKED,
# and the repair is a different field type rather than a different signature.
# Measured at the sitting: no such field exists in this tree, and the emitter's
# `pointer_element` note used to send people here.
function cstr_in_a_record(holder: str, field: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "cstr_in_a_record",
        message: "`" + holder + "." + field + "` holds a `cstr`, and `" + holder + "` is not a record of an `extern` group — a C pointer parked in a Heroes record outlives the bytes it points into (§4.19)",
        span: span
    )
    d.notes @ d.notes.push(
        "hold a `str` in the field and lend it with `.cstr()` at the call that reads it. A group's `record` may hold a `cstr`, because there the fields are the header's and C owns the bytes"
    )
    return d

# A lease cell's name where it may not stand (M-held-bytes, panel 124 R2 to R4
# and panel 125's soundness lane).
#
# A lease is `x: cstr @ s.lease()`: a COPY of the bytes that the program owns
# and C may read until `end_lease(@x)` frees it. What makes a second release
# impossible is that the release nulls the CELL, so the pointer may live only
# in that one cell: a copy of it — `g = x`, `g: cstr @ x`, a field, a return —
# would go on pointing at the bytes after the cell was nulled, and reading it
# through C is a use-after-free `check` could not see. So the name of a lease
# cell may stand only as an argument of a call, exactly where a lend may.
function lease_escapes(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "lease_escapes",
        message: "`" + name + "` is a lease — a copy of the bytes that C may read until `end_lease(@" + name + ")` — and its name may stand only as an argument of a call; here it is copied, and the copy would outlive the release",
        span: span
    )
    d.notes @ d.notes.push(
        "pass `" + name + "` directly to the call that reads it. The release nulls this one cell, so a pointer that lives anywhere else keeps pointing at freed bytes"
    )
    return d

# A write to a lease cell that is not its own `end_lease`.
function lease_written(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "lease_written",
        message: "`" + name + "` is a lease, and the only write a lease cell takes after its declaration is `end_lease(@" + name + ")` — a value stored over it would leak the bytes it held, or free bytes nobody leased",
        span: span
    )
    d.notes @ d.notes.push(
        "declare a second cell for the second lease. One cell, one `.lease()`, one `end_lease`"
    )
    return d

# `end_lease` on something that is not a lease cell.
function end_lease_of_no_lease(span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "end_lease_of_no_lease",
        message: "`end_lease` frees what `.lease()` made, and it takes the cell that holds it: `end_lease(@x)` where `x: cstr @ s.lease()` — this argument is not such a cell",
        span: span
    )
    d.notes @ d.notes.push(
        "a lend (`.cstr()`), a pointer from C and a literal are freed by whoever owns them, and this program does not; a lease copied into another cell cannot be released from there, because the release must null the one cell the pointer lives in"
    )
    return d
