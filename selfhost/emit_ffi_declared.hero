# The classes where THE HEADER CONTRADICTS THE DECLARATION (design.md
# §4.19; panels 036, 038, 042, 048). Port of
# crates/heroes/src/emit/ffi_declared.rs.
#
# Three readers, one seam: whose statement the verdict is about. Two
# read a _Static_assert this emitter wrote — a result type the header
# refutes, a constant that is not one — so the message text is a
# contract with emit_extern_assert rather than a guess about clang's
# wording. The exception is unknown_name, which matches clang's own
# "call to undeclared function": what makes it safe is not whose text
# it reads but declaration() — the gate in emit_ffi_lookup.

use ast
use source
use diag
use emit_assert_spelling
use emit_ffi_lookup
use parse
use resolve
use checker

# _Static_assert(HERO_RET_INT(sqrt(…)), "heroes-ffi-return sqrt int")
# failed: the header disagrees with the declared type. Two codes from
# one assertion, because the same _Generic asks the same question of a
# call and of a constant, and the reader's mistake is not the same: a
# function RETURNS the wrong type, a constant IS one.
function wrong_type(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !emit_ffi_lookup.has(text: line, needle: emit_ffi_lookup.FAILED)
        return fail("none", "not an assertion failure")
    rest = emit_ffi_lookup.after(text: line, marker: emit_assert_spelling.ASSERTION)

    if rest.is_err()
        return fail("none", "not a return assertion")

    # `<name> <type>` — written by the emitter, so the split is on its
    # own format rather than on a guess about clang's.
    parts = emit_ffi_lookup.words(text: rest.must())

    if parts.len() < 2
        return fail("none", "the marker's tail is not ours")
    name = parts[0]
    declared = parts[1]
    found = emit_ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail("none", "no group declares this name")

    if found.must().is_constant
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "ffi_constant_type",
            message: "`" + name + "` is not `" + declared + "` in `" + found.must().header + "` — clang read the header and the types disagree",
            span: found.must().span
        )
        d.notes @ d.notes.push(
            "an `extern constant` takes its value from the header (§4.19), so its type is the header's too: correct the declared type, or name the header that spells `" + name + "` as `" + declared + "`"
        )
        return ok(d)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_return_type",
        message: "`" + name + "` does not return `" + declared + "` — that is what `" + found.must().header + "` says, and clang read it",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "an `extern` is checked against the real header (§4.19): correct the result type, or name the header that declares this `" + name + "`"
    )
    return ok(d)

# _Static_assert(__builtin_constant_p(stdout), "heroes-ffi-const
# stdout") failed: the header has the name, and it is an OBJECT rather
# than a value. The one refusal no other language makes as a rule
# (panel 038's historian) — §4.2's reason: a zero-argument accessor
# over errno returns a different value on two calls, a mutable global
# through the back door.
function not_constant(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !emit_ffi_lookup.has(text: line, needle: emit_ffi_lookup.FAILED)
        return fail("none", "not an assertion failure")
    rest = emit_ffi_lookup.after(text: line, marker: emit_assert_spelling.CONSTANCY)

    if rest.is_err()
        return fail("none", "not a constancy assertion")
    parts = emit_ffi_lookup.words(text: rest.must())

    if parts.len() == 0
        return fail("none", "the marker's tail is empty")
    name = trim_trailing(parts[0])
    found = emit_ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail("none", "no group declares this name")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_not_constant",
        message: "`" + found.must().header + "` has `" + name + "`, but not as a constant — clang cannot read its value while compiling",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "a `constant` names one value forever (§4.4), and `" + name + "` is an object or a macro that expands to one — reading it twice could give two answers, which is the mutable global §4.2 forbids. A C object is reached through an `extern function` that returns it"
    )
    return ok(d)

# The header has no such name at all. A different mistake from the one
# above and it was being reported as that one — "`sqlite3_openn` does
# not return `i64`", whose remedy cannot fix a name that does not
# exist (§4.17). Two spellings, because C has two: a name used as a
# call is an undeclared FUNCTION, a name used as a value is an
# undeclared IDENTIFIER — which is what a misspelled constant produces.
function unknown_name(s: source.Source, decls: [ast.Decl], line: str, stderr: str) -> diag.Diagnostic?
    quoted: str @ ""
    caught: bool @ false
    call_form = emit_ffi_lookup.after(text: line, marker: "call to undeclared function '")

    if !call_form.is_err()
        quoted @ call_form.must()
        caught @ true

    # A THIRD MARKER, because clang has three words for one mistake and we
    # knew two (found 2026-08-25, by a test that declared `strstr` under
    # `stdlib.h` by accident). For a function clang recognises as a C library
    # name it says `call to undeclared LIBRARY function 'strstr' with type
    # ...` — a different string, so the two markers above missed it and the
    # whole compile came back `internal error ... exit 2`. That is §7's line
    # exactly inverted: a failure the author's own `extern` caused, blamed on
    # the compiler. Measured before and after: a name NO header declares was
    # already `ffi_unknown_name` at exit 1; a REAL name under the WRONG header
    # was exit 2. Same author mistake, two verdicts, and the difference was
    # one word in clang's output.
    if !caught
        library_form = emit_ffi_lookup.after(text: line, marker: "call to undeclared library function '")

        if !library_form.is_err()
            quoted @ library_form.must()
            caught @ true

    if !caught
        value_form = emit_ffi_lookup.after(text: line, marker: "use of undeclared identifier '")

        if !value_form.is_err()
            quoted @ value_form.must()
            caught @ true

    if !caught
        return fail("none", "not an undeclared-name line")
    name = emit_ffi_lookup.up_to_quote(quoted)

    # A tag-only struct is not an ABSENT one, and clang says both
    # things about it (panel 074): "must use 'struct' tag" AND "use of
    # undeclared identifier", at two different spans — so the
    # one-per-span rule does not choose, and this message would tell
    # the author the header declares no such type, which is false: it
    # declares it in C's other namespace. The narrowing is a fact
    # about the text in hand: if the tag line is present for THIS
    # name, ffi_missing_tag owns it.
    if emit_ffi_lookup.has(text: stderr, needle: "must use 'struct' tag to refer to type '" + name + "'")
        return fail("none", "the tag class owns this name")
    found = emit_ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail("none", "no group declares this name")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_unknown_name",
        message: "`" + found.must().header + "` declares no `" + name + "` — clang read the header and could not find it",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "an `extern` names what the header already has (§4.19): check the spelling, or name the header that does declare `" + name + "`"
    )

    # clang's own typo correction, when it offered one. A GUESS: it is
    # a suggestion from a search over the header's names, not a fact
    # about this program, so --apply must not take it (CLAUDE.md §8).
    meant = did_you_mean(stderr: stderr, name: name)

    if !meant.is_err()
        at = emit_ffi_lookup.name_span(s, decls, name: name)

        if !at.is_err()
            d.fixes @ d.fixes.push(
                diag.Fix(title: "the header declares `" + meant.must() + "`", replacement: meant.must(), span: at.must(), certainty: .guess)
            )
    return ok(d)

# The name clang suggested instead. Read from the whole of stderr
# rather than from one line, because the note sits on a line of its
# own under the error.
function did_you_mean(stderr: str, name: str) -> str?
    for one in emit_ffi_lookup.lines(text: stderr)
        if !emit_ffi_lookup.has(text: one, needle: "'" + name + "'") && !emit_ffi_lookup.has(text: one, needle: "did you mean")
            continue
        rest = emit_ffi_lookup.after(text: one, marker: "did you mean '")

        if rest.is_err()
            continue
        meant = emit_ffi_lookup.up_to_quote(rest.must())

        if meant != name
            return ok(meant)

    return fail("none", "clang offered no correction")

# What clang's echo can leave stuck to a token: quotes and the
# assertion's own closing punctuation.
function trim_trailing(name: str) -> str
    cs = name.chars()
    end: i64 @ cs.len()
    fall: bool @ false

    while end > 0 && !fall
        last = cs[end - 1]

        if last == "\"" || last == "," || last == ")" || last == "'"
            end @ end - 1
        else
            fall @ true

    kept: [str] @ []
    index: i64 @ 0

    while index < end
        kept @ kept.push(cs[index])
        index @ index + 1

    return kept.join("")

## Tests

test "wrong_type splits the emitter's own tail into the two codes"
    text = "extern \"math.h\"\n    function sqrt(x: f64) -> f64\n    constant M_PI: f64\n\nfunction main()\n    print(sqrt(M_PI))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:12:1: error: static assertion failed due to requirement 'x': heroes-ffi-return sqrt f64"
    d = wrong_type(s, parsed.decls, line: line)
    assert d.must().code == "ffi_return_type"
    assert d.must().message == "`sqrt` does not return `f64` — that is what `math.h` says, and clang read it"
    k = wrong_type(s, parsed.decls, line: "e: static assertion failed: heroes-ffi-return M_PI f64")
    assert k.must().code == "ffi_constant_type"

    # The echo line carries the marker without FAILED, and is refused.
    echo = "_Static_assert(HERO_RET_F64(sqrt((double)0)), \"heroes-ffi-return sqrt f64\");"
    assert wrong_type(s, parsed.decls, line: echo).is_err()

    # A name no group declares stays the compiler's problem.
    assert wrong_type(s, parsed.decls, line: "e: static assertion failed: heroes-ffi-return puts i64").is_err()

test "not_constant trims the echo's punctuation and names the object"
    text = "extern \"stdio.h\"\n    constant BUFSIZ: i64\n\nfunction main()\n    print(BUFSIZ)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:9:1: error: static assertion failed due to requirement '__builtin_constant_p(BUFSIZ)': heroes-ffi-const BUFSIZ\")"
    d = not_constant(s, parsed.decls, line: line)
    assert d.must().code == "ffi_not_constant"
    assert d.must().message == "`stdio.h` has `BUFSIZ`, but not as a constant — clang cannot read its value while compiling"

test "unknown_name reads both clang spellings and takes the guess"
    text = "extern \"math.h\"\n    function sqrtt(x: f64) -> f64\n\nfunction main()\n    print(sqrtt(x: 2.0))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    stderr = "main.c:5:9: error: call to undeclared function 'sqrtt'; ISO C99 and later do not support implicit function declarations\nmain.c:5:9: note: did you mean 'sqrt'?\n"
    line = "main.c:5:9: error: call to undeclared function 'sqrtt'; ISO C99 and later do not support implicit function declarations"
    d = unknown_name(s, parsed.decls, line: line, stderr: stderr)
    assert d.must().code == "ffi_unknown_name"
    assert d.must().message == "`math.h` declares no `sqrtt` — clang read the header and could not find it"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "sqrt"
    assert d.must().fixes[0].certainty == .guess

    # A name this program never declared is refused: clang's line
    # stays a statement about the compiler.
    other = "m.c:1:1: error: use of undeclared identifier 'h_t_ghost'"
    assert unknown_name(s, parsed.decls, line: other, stderr: other).is_err()

test "a tag-only struct is not an absent one — the tag class owns it"
    text = "extern \"sys/stat.h\"\n    record TagOnly\n        n: i64\n\nfunction touch(v: TagOnly)\n    _ = v\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    stderr = "m.c:2:1: error: must use 'struct' tag to refer to type 'TagOnly'\nm.c:3:1: error: use of undeclared identifier 'TagOnly'\n"
    line = "m.c:3:1: error: use of undeclared identifier 'TagOnly'"
    assert unknown_name(s, parsed.decls, line: line, stderr: stderr).is_err()
