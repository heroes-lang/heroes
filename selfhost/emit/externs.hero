# What an extern group puts in the translation unit (design.md §4.19;
# panels 036, 038, 061). Port of archive/bootstrap-rs/heroes/src/emit/externs.rs.
#
# Four walks over the same declarations, together because each answers
# a question the group's head line asked: which HEADERS the unit
# includes, which LIBRARIES the link line names, which PACKAGES are a
# question for the machine, and the spans behind them.
#
# THE WALKS ASK THE DECLARATION, NEVER THE KIND: an extern constant
# lowers to constant_kind, so a filter written as kind == extern
# encodes the premise "only a function comes from a header" — falsified
# at M-header-constants, and its failure is silent: the #include
# disappears and clang blames the compiler for a name it was never
# given.
#
# AND EVERY GROUP THAT DECLARES A RECORD, whether or not it declares a
# function (panel 061): a record lowers to no function, so no walk of
# the emitted program can see one — the premise that died was the SHAPE
# OF THE LOOP, written down nowhere. One defect, two walks: headers
# gained its arm and named() did not, so the #include was emitted and
# the -I that finds the header was not.

use token
use ast
use source
use escape
use head_names
use ir/containers
use check/state
use parse
use resolve
use checker
use ir/lower
use cli/strings

record ExternSpans
    header: token.Span?
    library: ast.Library?

# The header and library spans a declaration carries, whatever kind it
# is (§4.19, panel 038).
function extern_spans(decls: [ast.Decl], f: containers.Function) -> ExternSpans
    match decls[f.decl].kind
        .function_decl fd => return ExternSpans(header: fd.value.header, library: fd.value.library)
        .constant_decl k  => return ExternSpans(header: k.header, library: k.library)
        .record_decl | .variant_decl | .test_decl =>
            none_h: token.Span? = fail(code: "none", msg: "no header")
            none_l: ast.Library? = fail(code: "none", msg: "no library")
            return ExternSpans(header: none_h, library: none_l)

    none_h2: token.Span? = fail(code: "none", msg: "no header")
    none_l2: ast.Library? = fail(code: "none", msg: "no library")
    return ExternSpans(header: none_h2, library: none_l2)

# A constant whose value a header holds — as opposed to an extern
# function, which is called, or an ordinary constant, which has a body.
function is_extern_constant(decls: [ast.Decl], f: containers.Function) -> bool
    match decls[f.decl].kind
        .constant_decl k                                           => return k.body.is_err() && !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => return false

    return false

# A group head's string as its VALUE, its escapes decoded as spec § 2
# defines them (`escape.unescape`), since the value is what reaches C: the
# `#include <...>` line, the linker's `-l`, the word `pkg-config` is asked
# about, and the names read back from what clang says. Until panel 188 the
# quotes were cut and the spelling kept, so `extern "a\\b.h"` asked clang
# for two backslashes, and a missing header was reported where it stood.
function unquoted(s: source.Source, span: token.Span) -> str
    text = source.span_text(s, span)

    if text.len() >= 2 && text[0] == '"' && text[text.len() - 1] == '"'
        return escape.unescape(text)
    return text

# The two headers every unit includes whatever the program binds: math.h
# for HUGE_VAL, hero_os.h because the generated main calls hero_args_set
# whether or not the program asks for args().
constant SEEDS: [str]
    ["math.h", "hero_os.h"]

# Whether `header` is the compiler's own: a seed, or the runtime's header,
# which the library binds and every unit has already included. The prelude
# writes these above the groups' guard (`emit/macro_guard.hero`), so a
# program that binds nothing else has no guard at all.
function is_own(header: str) -> bool
    if header == "heroes_runtime.h"
        return true

    for one in SEEDS
        if one == header
            return true

    return false

# Every header a group named, without its quotes, deduplicated and in
# declaration order — deterministic, so the double-emit test holds.
# The two seeds first, unconditional, seeded here so a program that also
# BINDS one does not include it twice.
function headers(p: containers.Program, s: source.Source, decls: [ast.Decl]) -> [str]
    seen: [str] @ SEEDS

    for f in p.functions
        spans = extern_spans(decls, f)

        if spans.header.is_err()
            continue
        header = unquoted(s, span: spans.header.must())
        already: bool @ false

        for one in seen
            if one == header
                already @ true

        if !already
            seen @ seen.push(header)

    # The record-only group (panel 061): walked over the DECLARATIONS,
    # because that is where the answer is.
    for decl in decls
        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err()
                    header = unquoted(s, span: rec.header.must())
                    already: bool @ false

                    for one in seen
                        if one == header
                            already @ true

                    if !already
                        seen @ seen.push(header)
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return seen

# Every library a group named directly, and every package it asked for
# — kept apart all the way to the toolchain, because a library name is
# handed to the linker as written and a package name is a QUESTION
# whose answer must be validated when it arrives.
function libraries(p: containers.Program, s: source.Source, decls: [ast.Decl]) -> [str]
    return named(p, s, decls, want_package: false)

function packages(p: containers.Program, s: source.Source, decls: [ast.Decl]) -> [str]
    return named(p, s, decls, want_package: true)

function named(p: containers.Program, s: source.Source, decls: [ast.Decl], want_package: bool) -> [str]
    seen: [str] @ []

    for f in p.functions
        spans = extern_spans(decls, f)

        if spans.library.is_err()
            continue
        wanted = library_span(spans.library.must(), want_package: want_package)

        if wanted.is_err()
            continue
        name = unquoted(s, span: wanted.must())
        already: bool @ false

        for one in seen
            if one == name
                already @ true

        if !already
            seen @ seen.push(name)

    # The record-only group again, one level further on (panel 061):
    # one defect, two walks, and the second was invisible until the
    # first was fixed.
    for decl in decls
        match decl.kind
            .record_decl rec =>
                if !rec.library.is_err()
                    wanted = library_span(rec.library.must(), want_package: want_package)

                    if wanted.is_err()
                        continue
                    name = unquoted(s, span: wanted.must())
                    already: bool @ false

                    for one in seen
                        if one == name
                            already @ true

                    if !already
                        seen @ seen.push(name)
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return seen

# **What no tool can carry, asked once more before any tool is handed a name**
# (panel 188's guard): every header, library and package this program names,
# as its value, put to the half of `head_names.judged` that `check` refuses
# because nothing carries it. A program reaches here through those refusals,
# so this answers "" unless a name came another way; then `cli/produce.hero`
# stops at exit 2, the compiler's own error, before any tool reads one.
function unjudged(p: containers.Program, s: source.Source, decls: [ast.Decl]) -> str
    said: [str] @ refused(said: [], names: headers(p, s, decls), what: "header")
    said @ refused(said: said, names: libraries(p, s, decls), what: "link")
    return refused(said: said, names: packages(p, s, decls), what: "package").join("\n  ")

function refused(said: [str], names: [str], what: str) -> [str]
    out: [str] @ said

    for name in names
        verdict = head_names.cannot_carry(
            spelled: "\"" + name + "\"",
            value: name,
            span: token.Span(start: 0, end: 0),
            what: what
        )

        if !verdict.is_err()
            out @ out.push(verdict.must().message)

    return out

function library_span(library: ast.Library, want_package: bool) -> token.Span?
    match library
        .link l =>
            if want_package
                return fail(code: "none", msg: "a link, not a package")
            return ok(l.name)
        .package pk =>
            if !want_package
                return fail(code: "none", msg: "a package, not a link")
            return ok(pk.name)

    return fail(code: "none", msg: "unreached")

## Tests

test "headers seed math and os, dedupe, and see a record-only group"
    text = "extern \"sqlite3.h\" link \"sqlite3\"\n    function sqlite3_libversion() -> cstr\n\nextern \"raylib.h\" package \"raylib\"\n    record Color\n        r: i64\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    got = headers(low.program, s, parsed.decls)
    assert got.len() == 4
    assert got[0] == "math.h"
    assert got[1] == "hero_os.h"
    assert got[2] == "sqlite3.h"
    assert got[3] == "raylib.h"
    libs = libraries(low.program, s, parsed.decls)
    assert libs.len() == 1
    assert libs[0] == "sqlite3"
    pkgs = packages(low.program, s, parsed.decls)
    assert pkgs.len() == 1
    assert pkgs[0] == "raylib"
    assert unjudged(low.program, s, parsed.decls) == ""

test "a group head's string reaches C as its value, its escapes decoded (panel 188)"
    s = source.new_source(name: "t.hero", text: "\"a\\tb.h\" \"q\\\\r\" plain")
    assert unquoted(s, span: token.Span(start: 0, end: 8)) == "a\tb.h"
    assert unquoted(s, span: token.Span(start: 9, end: 15)) == "q\\r"
    assert unquoted(s, span: token.Span(start: 16, end: 21)) == "plain"

test "a name no tool carries is found again before any tool is handed it (panel 188)"
    text = "extern \"a>b.h\" link \"\"\n    function seven() -> i32\n\nextern \"stdio.h\" package \"zlib zlib\"\n    function puts(s: cstr lent) -> i32\n\nfunction main()\n    print(seven())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    said = unjudged(low.program, s, parsed.decls)
    assert strings.holds(text: said, needle: "holds `>`")
    assert strings.holds(text: said, needle: "library's name is empty")
    assert strings.holds(text: said, needle: "package's name holds a space")
