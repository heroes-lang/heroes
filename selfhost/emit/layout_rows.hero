# The bytes of clang's record-layout dump, before any of it is read as a
# layout (design.md §4.19, §1.12; panel 186). `emit/layout_text.hero` reads
# the rows this file hands it; this file only finds them.
#
# **Why the dump is never cut into rows whole.** clang prints one block for
# every record it lays out and expands every named record member inline at
# every level, so a record holding a by-value nest is CUBIC in the nest's
# depth: one flagged record over a thousand structs nested by value dumped
# 348,378,433 bytes (panel 186's completeness critic, a synthetic header in
# the shape of defect 140's tracked case), and the route's first reader,
# which cut every line into a row, sat at 1.5 GB on the 693 MB dump of the
# unflagged case. Only the blocks this compiler asked for are needed, its
# wrappers and its control, and each of those is one block of a few rows per
# member. So `wrapper_rows` walks the text once, a byte at a time, and keeps
# the rows of those blocks alone: what a build holds is the text clang wrote
# and the rows it asked for, never a row per line of the rest.

use bytes

constant PREFIX: str
    "hero_ly_"

# The rows of every block whose head is one of this compiler's wrappers,
# `0 | struct hero_ly_<n>` or `0 | struct hero_ly_control`, in the dump's
# order, each from its head to its `| [sizeof=` row; and of each block an
# ANONYMOUS union heads, `0 | union T::(anonymous at <place>)`, the head and
# that closing row alone, which is where clang states the union's width (an
# anonymous union has no name C can take `sizeof` of). A `\r` before a
# newline is dropped (clang on Windows writes text mode). Every other row is
# stepped over without a slice.
function wrapper_rows(text: str) -> [str]
    out: [str] @ []
    at: i64 @ 0

    # 0 between blocks, 1 inside a wrapper's, 2 inside an anonymous union's.
    inside: i64 @ 0

    while at < text.len()
        stop: i64 @ at

        while stop < text.len() && text[stop] != '\n'
            stop @ stop + 1

        cut: i64 @ stop

        if cut > at && text[cut - 1] == '\r'
            cut @ cut - 1

        if inside > 0
            closes = has_from(text: text, from: at, to: cut, needle: "| [sizeof=")

            if inside == 1 || closes
                out @ out.push(text.slice(from: at, to: cut))

            if closes
                inside @ 0
        else if opens(text, from: at, to: cut)
            out @ out.push(text.slice(from: at, to: cut))
            inside @ 1
        else if opens_union(text, from: at, to: cut)
            out @ out.push(text.slice(from: at, to: cut))
            inside @ 2
        at @ stop + 1

    return out

# Whether the row from `from` to `to` is the head of an anonymous union's own
# block: the offset column, then `| union ` with no level of indentation, and
# a place, ` at `, in the rest of the row.
function opens_union(text: str, from: i64, to: i64) -> bool
    at = past_offsets(text, from: from, to: to)
    head = "| union "

    if at + head.len() > to || !bytes.bytes_at(text: text, at: at, needle: head)
        return false
    return has_from(text: text, from: at, to: to, needle: " at ")

# Whether `needle` sits between `from` and `to`, read in place.
function has_from(text: str, from: i64, to: i64, needle: str) -> bool
    at: i64 @ from

    while at + needle.len() <= to
        if bytes.bytes_at(text: text, at: at, needle: needle)
            return true
        at @ at + 1

    return false

# The first byte past a row's offset column: spaces, digits, `:` and `-`.
function past_offsets(text: str, from: i64, to: i64) -> i64
    at: i64 @ from

    while at < to && (text[at] == ' ' || text[at] == ':' || text[at] == '-' || text[at] >= '0' && text[at] <= '9')
        at @ at + 1

    return at

# Whether the row from `from` to `to` is a wrapper's head: an offset column
# (spaces, digits, `:` and `-`), then `| struct hero_ly_` and the rest of the
# row a declaration's number or `control`. It reads at most the offset column
# and the head's own bytes, so a long row of another block costs nothing here.
function opens(text: str, from: i64, to: i64) -> bool
    at = past_offsets(text, from: from, to: to)
    head = "| struct " + PREFIX

    if at + head.len() > to || !bytes.bytes_at(text: text, at: at, needle: head)
        return false
    rest = text.slice(from: at + head.len(), to: to)

    if rest == "control"
        return true

    if rest.len() == 0
        return false
    k: i64 @ 0

    while k < rest.len()
        if rest[k] < '0' || rest[k] > '9'
            return false
        k @ k + 1

    return true

# The rows of a short text, a `\r` before a newline dropped: a cached block
# list and the compiler's own tests read their rows through this.
function rows_of(text: str) -> [str]
    out: [str] @ []
    start: i64 @ 0
    at: i64 @ 0

    while at <= text.len()
        if at == text.len() || text[at] == '\n'
            stop: i64 @ at

            if stop > start && text[stop - 1] == '\r'
                stop @ stop - 1

            if at > start || at < text.len()
                out @ out.push(text.slice(from: start, to: stop))
            start @ at + 1
        at @ at + 1

    return out

# The first byte offset of an ASCII `needle`, or -1.
function byte_index(text: str, needle: str) -> i64
    at: i64 @ 0

    while at + needle.len() <= text.len()
        k: i64 @ 0

        while k < needle.len() && text[at + k] == needle[k]
            k @ k + 1

        if k == needle.len()
            return at
        at @ at + 1

    return -1

# The decimal at the start of an offset column, spaces skipped: `8` of
# `    8:0-3`; -1 when there is none.
function leading_number(text: str) -> i64
    at: i64 @ 0

    while at < text.len() && text[at] == ' '
        at @ at + 1

    value: i64 @ 0
    seen: bool @ false

    while at < text.len() && text[at] >= '0' && text[at] <= '9'
        value @ value * 10 + (text[at] - '0').to_i64().must()
        seen @ true
        at @ at + 1

    if !seen
        return -1
    return value

function last_space(text: str) -> i64
    at: i64 @ text.len() - 1

    while at >= 0
        if text[at] == ' '
            return at
        at @ at - 1

    return -1

function starts(text: str, prefix: str) -> bool
    return byte_index(text: text, needle: prefix) == 0

## Tests

test "only the blocks this compiler asked for become rows"
    dump = "\n*** Dumping AST Record Layout\n         0 | G0\n         0 |   int64_t v\n           | [sizeof=8, align=8]\n\n*** Dumping AST Record Layout\n         0 | struct hero_ly_3\n         0 |   G1 v\r\n         0 |     G0 inner\n           | [sizeof=8, align=8]\n\n*** Dumping AST Record Layout\n         0 | struct hero_ly_3x\n           | [sizeof=8, align=8]\n         0 | struct hero_ly_control\n         0 |   struct (unnamed) v\n           | [sizeof=4, align=4]\n         0 | union SA::(anonymous at ./u.h:8:32)\n         0 |   int32_t i\n         0 |   float f\n           | [sizeof=4, align=4]\n         0 | union __sigaction_u\n         0 |   void * h\n           | [sizeof=8, align=8]\n"
    rows = wrapper_rows(dump)
    assert rows.len() == 9

    # An anonymous union's own block gives its head and its width, no more;
    # a named union's block is C's to classify, and is not kept.
    assert rows[7] == "         0 | union SA::(anonymous at ./u.h:8:32)"
    assert rows[8] == "           | [sizeof=4, align=4]"
    assert rows[0] == "         0 | struct hero_ly_3"
    assert rows[1] == "         0 |   G1 v"
    assert rows[3] == "           | [sizeof=8, align=8]"
    assert rows[4] == "         0 | struct hero_ly_control"
    assert wrapper_rows("").len() == 0
    assert rows_of("a\r\nb\n").len() == 2 && rows_of("a\r\nb\n")[0] == "a"
