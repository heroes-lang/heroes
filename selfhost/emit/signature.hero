# A function's C signature: the prototype, and the name a monomorphised
# instance gets (design.md §3.1, §4.12; panel 029 R5).
# Port of heroes/src/emit/signature.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# A prototype IS a signature and a semicolon, and a definition is the
# same signature and a body — writing it in one place is what keeps a
# declaration and its definition from disagreeing, which C answers with
# `conflicting types` and the emitter must never provoke.
#
# Port note: the Rust prototype() asks decls::emitted first; here the
# caller filters and prototype writes unconditionally — the filter
# lives with the target logic, which is decls' concern.

use ast
use check/render
use check/state
use check/table
use checker
use emit/ctype
use emit/large_value
use emit/mangle
use emit/nodebug
use emit/stop_place
use emit/synth
use emit/writer
use ir/containers
use parse
use resolve
use source
use token

# The C name of one function: its mangled name, plus the hash of what
# it was instantiated at when it is a monomorphised instance. What is
# hashed is the CANONICAL rendering, render_instance's, plus the declared
# types it contains, module-qualified (`synth.instance_key`), so the same
# symbol comes from the same public spelling, the fixpoint does not
# depend on two implementations interning in the same order, and two
# modules' `Held` are two instances (defect 2030: the rendering alone
# named them alike, and clang refused the program).
function instance_name(f: containers.Function, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> str
    module = source.component_at(s, f.span.start)
    is_test: bool @= false

    match f.kind
        .test_kind                                     => is_test @ true
        .function_kind | .constant_kind | .extern_kind => is_test @ is_test

    if is_test
        return mangle.test_name(module: module, index: f.decl)

    if f.instance.len() == 0
        return mangle.function_name(module: module, name: f.name)
    rendered = render_instance(c, s, decls, bound: f.instance)
    keyed = synth.instance_key(c, s, decls, bound: f.instance, rendered: rendered)
    return mangle.instance_of(module: module, name: f.name, rendered: keyed)

# The type arguments as one string — what the comment above an instance
# shows, and the half of its key that a reader can spell. Independent of
# the interner ids and of the file's name; the module of a declared type
# it names is the other half's (`synth.instance_key`).
function render_instance(c: state.Checked, s: source.Source, decls: [ast.Decl], bound: [i64]) -> str
    rendered: [str] @= []
    none: [str] = []

    for t in bound
        rendered @ rendered.push(render.render_ty(c.types, s, decls, t, none))

    return rendered.join(", ")

# int64_t h_mod_dist(int64_t h0_a, int64_t *ph1_b) — a mutable
# parameter is a POINTER parameter: §4.8's copy-in/copy-out has no
# other shape in C, because copy_out writes the CALLER's place and the
# callee cannot otherwise reach it.
function signature(f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl]) -> str
    name = instance_name(f, c, s, decls)
    result: str @= ctype.c_result(names, c: c, ty: f.result)
    params: [str] @= []

    # A large result is written into the caller's slot, handed first
    # (`emit/large_value.hero`, defect 2278).
    if large_value.is_large(names, ty: f.result)
        params @ params.push(result + " *" + large_value.OUT)
        result @ "void"

    for one in direct_params(f, c, names)
        params @ params.push(one)

    # A function of the library's own Heroes is handed its caller's place last
    # (panel 230's R1, `emit/stop_place.hero`'s `CALLER`).
    if stop_place.in_library(s, f)
        params @ params.push("const HeroPlace *" + stop_place.CALLER)
    return local_of(f) + result + " " + name + "(" + listed(params) + ")"

# The parameters as a direct call hands them: a large plain one as a pointer to
# its caller's copy, which the body names through `large_value.defined`.
function direct_params(f: containers.Function, c: state.Checked, names: ctype.Names) -> [str]
    return params_as(f, c, names, value: false)

# The parameters as a call by name (`value` false) or through a value (`value`
# true) hands them: the two differ at a group's large record, which a value
# takes by C's convention (`large_value.value_large`, panel 236).
function params_as(f: containers.Function, c: state.Checked, names: ctype.Names, value: bool) -> [str]
    params: [str] @= []

    for slot_id in f.params
        in_place: bool @= large_value.in_pointer_param(f, names, slot_id: slot_id)

        if value
            in_place @ large_value.value_pointer_param(f, names, slot_id: slot_id)

        if in_place
            spelled = ctype.c_type(names, c: c, ty: f.slots[slot_id].ty)
            name = mangle.slot(index: slot_id, name: f.slots[slot_id].name)

            if !spelled.is_err()
                params @ params.push("const " + spelled.must() + " *" + large_value.in_pointer(name))
        else
            params @ params.push(one_param(f, c, names, slot_id: slot_id))

    return params

function plain_params(f: containers.Function, c: state.Checked, names: ctype.Names) -> [str]
    params: [str] @= []

    for slot_id in f.params
        params @ params.push(one_param(f, c, names, slot_id: slot_id))

    return params

function listed(params: [str]) -> str
    if params.len() == 0
        return "void"
    return params.join(", ")

# An INSTANCE is TU-local (panel 093 R2): under one .c per module a copy is
# emitted static in every unit that uses it, and the fused unit defines the
# macro empty — one printer for both paths.
function local_of(f: containers.Function) -> str
    if f.instance.len() > 0
        return "HERO_TU_LOCAL "
    return ""

# **A function of the library standing as a value** (`emit/func_ref.hero`) or
# handed to C (`emit/callback_thunk.hero`) is reached through this twin, whose
# parameters are the function's own, so its address has the function type the
# program wrote; it hands on the place of the function's own declaration, the
# one place a call through a value has (panel 230's R1). Written beside every
# function of the library a unit defines and marked `unused`, an unused static
# being a warning.
function value_name(f: containers.Function, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> str
    return "hero_value_" + instance_name(f, c, s, decls)

# Whether `f` is handed its caller's place, the question a writer of its
# prototype, its body or its address asks here.
function takes_caller(s: source.Source, f: containers.Function) -> bool
    return stop_place.in_library(s, f)

# Whether `f` stands as a value through its twin: a function of the library,
# which hands on its declaration's place, and one whose value takes a group's
# large record by C's convention where its call by name takes it in place
# (`large_value.converts`, panel 236).
function has_twin(s: source.Source, names: ctype.Names, f: containers.Function) -> bool
    return stop_place.in_library(s, f) || large_value.converts(names, f)

# The name a function's address is taken by: its twin's where it has one.
function as_value(f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl]) -> str
    if has_twin(s, names, f)
        return value_name(f, c, s, decls)
    return instance_name(f, c, s, decls)

# The twin's signature: the convention of a value of its function type, a large
# program record through the caller's slot or as a pointer and a group's record
# by value, which is what the typedef of that type spells (`emit/types.hero`),
# so its address assigns to a value of that type.
function value_header(f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl]) -> str
    result: str @= ctype.c_result(names, c: c, ty: f.result)
    params: [str] @= []

    if large_value.value_large(names, ty: f.result)
        params @ params.push(result + " *" + large_value.OUT)
        result @ "void"

    for one in params_as(f, c, names, value: true)
        params @ params.push(one)

    return local_of(f) + "__attribute__((unused)) " + result + " " + value_name(f, c, s, decls) + "(" + listed(params) + ")"

function value_prototype(@w: writer.Writer, f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    writer.at_generated(@w)
    writer.line(@w, text: value_header(f, c, names, s, decls) + ";")

function value_twin(@w: writer.Writer, f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    writer.at_generated(@w)
    writer.line(@w, text: value_header(f, c, names, s, decls) + " {")
    library = takes_caller(s, f)

    if library
        writer.line(
            @w,
            text: "    " + nodebug.MARK + "static const HeroPlace " + stop_place.HERE + " = {" + stop_place.literals(s, f, offset: f.span.start) + "};"
        )
    forwarded: [str] @= []
    result = ctype.c_result(names, c: c, ty: f.result)
    large = large_value.is_large(names, ty: f.result)

    # A group's large result, which the value returns by C's convention, is
    # written by the function into the twin's own `hero_result` (panel 236).
    held = large && !large_value.value_large(names, ty: f.result)

    if held
        writer.line(@w, text: "    " + nodebug.MARK + result + " " + HELD + ";")
        forwarded @ forwarded.push("&" + HELD)
    else if large
        forwarded @ forwarded.push(large_value.OUT)

    # Handed on as the call by name takes them: a large parameter's pointer as
    # it arrived, a group's record that arrived by value by its address, an
    # `@` one's pointer, the rest by value (`emit/large_value.hero`).
    for slot_id in f.params
        name = mangle.slot(index: slot_id, name: f.slots[slot_id].name)

        if large_value.value_pointer_param(f, names, slot_id: slot_id)
            forwarded @ forwarded.push(large_value.in_pointer(name))
        else if large_value.in_pointer_param(f, names, slot_id: slot_id)
            forwarded @ forwarded.push("&" + name)
        else
            forwarded @ forwarded.push(argument_of(f, slot_id: slot_id))

    if library
        forwarded @ forwarded.push("&" + stop_place.HERE)
    call = instance_name(f, c, s, decls) + "(" + forwarded.join(", ") + ")"

    if held
        writer.line(@w, text: "    " + call + ";")
        writer.line(@w, text: "    return " + HELD + ";")
    else if large || result == "void"
        writer.line(@w, text: "    " + call + ";")
    else
        writer.line(@w, text: "    return " + call + ";")
    writer.line(@w, text: "}")

# The twin's local for a result its function writes in place and its value
# returns by C's convention.
constant HELD: str
    "hero_result"

# A parameter as the twin hands it on: a `@` one is the pointer it arrived as.
function argument_of(f: containers.Function, slot_id: i64) -> str
    declared = f.slots[slot_id]
    by_pointer: bool @= false

    match declared.kind
        .param_slot ps                               => by_pointer @ ps.mutable
        .local_slot | .synthetic_slot | .return_slot => by_pointer @ false

    if by_pointer
        return mangle.out_param(index: slot_id, name: declared.name)
    return mangle.slot(index: slot_id, name: declared.name)

function one_param(f: containers.Function, c: state.Checked, names: ctype.Names, slot_id: i64) -> str
    declared = f.slots[slot_id]
    ty: str @= "void"
    found = ctype.c_type(names, c: c, ty: declared.ty)

    if !found.is_err()
        ty @ found.must()
    is_mutable: bool @= false

    match declared.kind
        .param_slot ps =>
            if ps.mutable
                is_mutable @ true
        .local_slot | .synthetic_slot | .return_slot => is_mutable @ is_mutable

    if is_mutable
        return ty + " *" + mangle.out_param(index: slot_id, name: declared.name)
    return ty + " " + mangle.slot(index: slot_id, name: declared.name)

# The prototype: the signature and a semicolon. The caller has already
# decided this function is emitted for the current target.
function prototype(@w: writer.Writer, f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    writer.at_generated(@w)
    writer.line(@w, text: signature(f, c, names, s, decls) + ";")

## Tests

test "the signature spells the pair rule, and an instance carries its hash"
    text = "function dist(a: i64, @b: i64) -> i64\n    b @ b + a\n    return a\n\nfunction main()\n    v: i64 @= 0\n    print(dist(a: 1, b: @v))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    int_id = table.int_ty_id(c.types)
    slots: [containers.Slot] = [
        containers.Slot(name: "a", ty: int_id, kind: .param_slot(mutable: false, read_only: false))
        containers.Slot(name: "b", ty: int_id, kind: .param_slot(mutable: true, read_only: false))
    ]
    f = containers.Function(
        name: "dist",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [0, 1],
        result: int_id,
        slots: slots,
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    assert signature(f, c, names, s, parsed.decls) == "int64_t h_t_dist(int64_t h0_a, int64_t *ph1_b)"

    # An instance: the same function at [i64] carries the hash of the
    # canonical rendering — the same polynomial the witness golden pins.
    monod: containers.Function @= f
    monod.instance @ [int_id]
    named = instance_name(monod, c, s, parsed.decls)
    assert named == "h_t_0dist_" + mangle.instance(render_instance(c, s, parsed.decls, bound: [int_id]))

    # A function of the library is handed its caller's place last, and its twin,
    # the address a value takes, hands on its declaration's own (panel 230's R1).
    ls = source.with_library(
        name: "t.hero",
        user: text,
        library: "function dist(a: i64, @b: i64) -> i64\n    return a\n"
    )
    library: containers.Function @= f
    library.span @ token.Span(start: ls.files[1].start, end: ls.files[1].start + 1)
    assert takes_caller(ls, library)
    assert !takes_caller(s, f)
    assert signature(library, c, names, ls, parsed.decls) == "int64_t h_library_dist(int64_t h0_a, int64_t *ph1_b, const HeroPlace *hero_caller)"
    assert as_value(library, c, names, ls, parsed.decls) == "hero_value_h_library_dist"
    assert as_value(f, c, names, s, parsed.decls) == "h_t_dist"
    twin: writer.Writer @= writer.new_writer("t")
    value_twin(@twin, library, c, names, ls, parsed.decls)
    assert writer.finish(twin) == "#line 2 \"t.c\"\n__attribute__((unused)) int64_t hero_value_h_library_dist(int64_t h0_a, int64_t *ph1_b) {\n    HERO_NODEBUG static const HeroPlace hero_here = {\"<heroes library>\", \"library.dist\", 1, 1};\n    return h_library_dist(h0_a, ph1_b, &hero_here);\n}\n"

    # A test block is named by index, never by title.
    tester: containers.Function @= f
    tester.kind @ .test_kind
    tester.decl @ 3
    empty_params: [i64] = []
    tester.params @ empty_params
    assert instance_name(tester, c, s, parsed.decls) == "h_t_0test3"
