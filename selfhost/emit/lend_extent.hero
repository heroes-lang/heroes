# The count a lend crosses with, held before the call to what is lent, in the
# unit C counts it in (design.md §4.19, §1.12; panel 166's route C, ratified
# 2026-09-19; panel 194's R7, ratified by delegation 2026-10-06; defects 063,
# 092 and 395).
#
# WHAT IS LENT. A field of a binding, `f.ptr()` to a `ptr` declared
# `counted_by n`; or a group's record whole, `@h` to an `@` parameter declared
# `counted_by n`. Either way C is handed an address and reaches as far as `n`
# says, and `n` is another argument.
#
# THE UNIT IS C'S, AND SO IS EVERY NUMBER. C counts in what its pointer points
# at — `read` in bytes through `void *`, `poll` in `struct pollfd`s,
# `mbstowcs` in `wchar_t`s — so `n` of them fit in a lent object of S bytes
# when `n <= S / sizeof(*(P)0)`, P the header's own type for the parameter,
# which only the pointee check reads (`cli/header_types.hero`) and
# `emit/ctype.Names.lend_units` carries here. `sizeof` of the object is C's
# too, which is what makes it right on a `partial` record whose size Heroes
# does not know. Under `-std=gnu11`, the dialect `cli/flags.hero` names,
# `sizeof` of `void` is one, so a `void *` counts bytes, panel 194's ruling in
# C's own arithmetic. Until that sitting the comparison was in bytes for every
# pointer, and `fill_ints(int *a, n)` over a 16-byte field took `n: 16`,
# overwrote the next field and exited 0 (defect 395).
#
# WHERE THE COUNT IS A CONSTANT — a literal, a group `constant`, arithmetic
# over those (`emit/lend_count.hero`) — the check is a `_Static_assert` and
# costs nothing at run time; its marker carries what `emit/ffi_extent.hero`
# needs to put the refusal on the number the author wrote. Two assertions per
# lend, of which C itself picks the one that can fail: the unit of one byte,
# whose message says bytes and offers the field's length, and every wider
# unit, whose message names the header's type. A count read at run time, or
# read through an `@` cell C writes back (`getsockopt`'s length), is one
# compare before the call and a named abort.
#
# AND WHERE NOTHING READ THE UNIT the build stops, loud: an assertion that
# always fails, which no reader claims, so it is exit 2 and the compiler's
# fault. The pointee check asks every counted parameter, so that line is
# reached only where the check could not run, and there the build's own
# compile has already told the author why (a header that does not
# preprocess, a name the header spells as a macro).
#
# WHY IN THE BODY AND NOT AT FILE SCOPE. The object is named through the place
# it is lent from — `h0_s.name`, `h0_o.inner` — which is a local, and `sizeof`
# an lvalue of a complete, non-variable type is an integer constant expression
# in C11 wherever it stands. A `_Static_assert` is a declaration with no
# initialiser, so the prologue's rule about `goto` never reaches it.

use ast
use token
use source
use check/state
use ir
use ir/containers
use emit/writer
use emit/ctype
use emit/aggregate
use emit/field_lend
use emit/lend_count

# The contract between this writer and `emit/ffi_extent.hero`'s reader: one
# string each, one home (CLAUDE.md §11). None is a prefix of another.
constant MARKER: str
    "heroes-ffi-extent "

constant UNIT_MARKER: str
    "heroes-ffi-extent-unit "

constant RECORD_MARKER: str
    "heroes-ffi-extent-record "

constant UNASKED_MARKER: str
    "heroes-ffi-extent-unasked "

# An extent the DECLARATION states (panel 196's R5), a field's and a record's:
# `counted_by 32` or `counted_by SHA256_DIGEST_LENGTH`. Apart from the three
# above because what is wrong differs: the declaration says what C writes, so
# the place lent is what is short, and the message lands on the lend.
constant STATED_MARKER: str
    "heroes-ffi-extent-stated "

constant STATED_RECORD_MARKER: str
    "heroes-ffi-extent-stated-record "

# What a counted argument lends: the C lvalue of the object, the bytes of it
# Heroes knows (a field's length; 0 for a record, whose size is C's alone),
# whether it is a record lent whole, and the span a message about it names.
record Lent
    place: str
    length: i64
    whole: bool
    span: token.Span

# The checks before one extern call, one per lend at a counted parameter: the
# count a sibling carries, or the extent the declaration states (panel 196's
# R5), which `lend_count.stated_text` reads and which never names a sibling.
function assertions(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, run: ir.Run, decl: i64)
    counted = lend_count.counted_siblings(s, decls, decl: decl)
    given = containers.args_of(f, run)
    index: i64 @ 0

    for arg in given
        # A buffer (panel 196's R4) is the emitter's own and exactly its
        # extent, `emit/lend_buffer.hero`; nothing of the program's is lent.
        buffer = !lend_count.buffer_element(c, decls, decl: decl, index: index).is_err()

        if buffer
            _ = 0
        else if index < counted.len() && counted[index] >= 0 && counted[index] < given.len()
            lent = lent_by(c, s, decls, f, arg: arg, run: run)

            if !lent.is_err()
                for text in checks(c, names, s, decls, f, lent: lent.must(), count: given[counted[index]], decl: decl, pointer: index, at: counted[index])
                    writer.line(@w, text: "    " + text)
        else if index < counted.len()
            stated = lend_count.stated_text(s, decls, decl: decl, index: index)
            lent = lent_by(c, s, decls, f, arg: arg, run: run)

            if !stated.is_err() && !lent.is_err()
                for text in stated_checks(names, s, decls, lent: lent.must(), decl: decl, pointer: index, stated: stated.must())
                    writer.line(@w, text: "    " + text)
        index @ index + 1

# The two assertions for an extent the declaration states, in C's unit, of
# which C picks the one that can fail, as `asserted` does for a count the call
# states. The number is the declaration's: a constant's macro by name, a
# literal as its decimal value. The marker carries the lend's span, so the
# message lands on the place that is too short.
function stated_checks(names: ctype.Names, s: source.Source, decls: [ast.Decl], lent: Lent, decl: i64, pointer: i64, stated: lend_count.Stated) -> [str]
    params = lend_count.param_names(s, decls, decl: decl)
    callee = source.span_text(s, decls[decl].name)

    if pointer >= params.len()
        return []
    header = names.lend_units[callee + " " + pointer.to_str()]

    if header.is_err()
        return [
            "_Static_assert(0, \"" + UNASKED_MARKER + callee + " " + params[pointer] + ": the pointee check read no unit for this counted parameter\");"
        ]
    unit = "sizeof(*(" + header.must() + ")0)"
    extent = "(uint64_t)(" + stated.c_text + ")"
    fits_bytes = extent + " <= (uint64_t)sizeof(" + lent.place + ")"
    fits_units = extent + " <= (uint64_t)(sizeof(" + lent.place + ") / " + unit + ")"
    at_lend = lent.span.start.to_str() + " " + lent.span.end.to_str()
    marker: str @ STATED_MARKER

    if lent.whole
        marker @ STATED_RECORD_MARKER
    tail = callee + " " + params[pointer] + " " + stated.written + " " + at_lend + " " + lent.length.to_str()
    return [
        "_Static_assert(" + unit + " != 1 || (" + fits_bytes + "), \"" + marker + tail + " bytes " + header.must() + "\");"
        "_Static_assert(" + unit + " == 1 || (" + fits_units + "), \"" + marker + tail + " unit " + header.must() + "\");"
    ]

# What an argument lends, if it lends anything a count can be held to: the
# field a `ptr()` takes the address of, or the record an `@` names. A `ptr`
# value that is not a lend — `nullptr`, an address C gave — is the program's
# word and nothing here can measure it.
function lent_by(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, arg: ir.Arg, run: ir.Run) -> Lent?
    match arg
        .value_arg v =>
            lend = field_lend.lend_of(f, value: v.value)?
            place = field_lend.lent_place(c, s, decls, f, value: lend.operand)?
            length = lend_count.fixed_length(c, f, value: lend.operand)?
            return ok(Lent(place: place, length: length, whole: false, span: lend.span))
        .inout_arg io =>
            at = lend_count.call_span(f, run: run)?
            return ok(Lent(place: aggregate.place(c, s, decls, f, at: io.place), length: 0, whole: true, span: at))

    return fail(code: "none", msg: "unreached")

# The lines for one lend: two assertions where the count is a constant, one
# compare where it is not, and the loud line where no unit was read.
function checks(c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, lent: Lent, count: ir.Arg, decl: i64, pointer: i64, at: i64) -> [str]
    params = lend_count.param_names(s, decls, decl: decl)
    callee = source.span_text(s, decls[decl].name)

    if pointer >= params.len() || at >= params.len()
        return []
    header = names.lend_units[callee + " " + pointer.to_str()]

    if header.is_err()
        return [
            "_Static_assert(0, \"" + UNASKED_MARKER + callee + " " + params[pointer] + ": the pointee check read no unit for this counted parameter\");"
        ]
    unit = "sizeof(*(" + header.must() + ")0)"
    n = lend_count.count_of(c, s, decls, f, arg: count)
    spelled = ctype.c_type(names, c: c, ty: n.ty)
    folded = constant_count(c, s, decls, f, n: n)

    if !folded.is_err() && !spelled.is_err()
        stated = lend_count.producer(f, value: n.value)

        if !stated.is_err()
            return asserted(
                c,
                lent: lent,
                n: n,
                text: folded.must(),
                spelled: spelled.must(),
                unit: unit,
                marker_tail: callee + " " + params[pointer] + " " + params[at],
                stated: stated.must().span,
                header: header.must()
            )
    return [
        compared(c, s, lent: lent, n: n, unit: unit, callee: callee, pointer: params[pointer], count: params[at], header: header.must())
    ]

# The constant text of a count, or absent: a cell is never one.
function constant_count(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, n: lend_count.Count) -> str?
    if n.value < 0
        return fail(code: "none", msg: "an @ cell is read at the call")
    return lend_count.constant_text(c, s, decls, f, value: n.value)

# The two assertions, of which C picks the one that can fail: the first holds
# for every unit wider than a byte, the second for a byte.
function asserted(c: state.Checked, lent: Lent, n: lend_count.Count, text: str, spelled: str, unit: str, marker_tail: str, stated: token.Span, header: str) -> [str]
    low: str @ ""

    if lend_count.signed_int(c, n.ty)
        low @ "0 <= (" + spelled + ")(" + text + ") && "
    fits_bytes = low + "(" + spelled + ")(" + text + ") <= (" + spelled + ")sizeof(" + lent.place + ")"
    fits_units = low + "(" + spelled + ")(" + text + ") <= (" + spelled + ")(sizeof(" + lent.place + ") / " + unit + ")"
    at_count = stated.start.to_str() + " " + stated.end.to_str()

    if lent.whole
        return [
            "_Static_assert(" + unit + " != 1 || (" + fits_bytes + "), \"" + RECORD_MARKER + marker_tail + " " + at_count + " bytes " + header + "\");"
            "_Static_assert(" + unit + " == 1 || (" + fits_units + "), \"" + RECORD_MARKER + marker_tail + " " + at_count + " unit " + header + "\");"
        ]
    at_lend = lent.span.start.to_str() + " " + lent.span.end.to_str()
    tail = marker_tail + " " + at_lend + " " + at_count + " " + lent.length.to_str()
    return [
        "_Static_assert(" + unit + " != 1 || (" + fits_bytes + "), \"" + MARKER + tail + "\");"
        "_Static_assert(" + unit + " == 1 || (" + fits_units + "), \"" + UNIT_MARKER + tail + " " + header + "\");"
    ]

# **THE HALF NO ASSERTION CAN REACH: a count read at run time**, or through an
# `@` cell. One compare before the call, in the unit, and a named abort if the
# count is past what is lent; C picks the sentence by the unit's size.
#
# WHY IT IS HERE RATHER THAN LEFT TO THE PROGRAM. Panel 166's compiler-engineer
# approved its route on the condition that *a variable extent must be refused,
# not admitted; admitting it silently is the defect wearing a mark*, and
# refusing every count a program computes would refuse correct programs, which
# §4.19's completeness clause forbids. Its cost, priced before it was written:
# one compare, about 2 instructions a call at `-O2` (lane b12-ffi13's
# measurement for panel 194), the shape `guard_arguments`' null-`cstr` panic
# takes one boundary over.
function compared(c: state.Checked, s: source.Source, lent: Lent, n: lend_count.Count, unit: str, callee: str, pointer: str, count: str, header: str) -> str
    where = source.source_line(s, lent.span.start)
    at = where.file + ":" + where.line.to_str() + ": `" + callee + "` was given "
    from = "read from `" + count + "` at run time"
    bytes: str @ at + "an extent past the " + lent.length.to_str() + " bytes of the field lent to it, " + from
    units: str @ bytes + " and counted in what the header's `" + header + "` points at"

    if lent.whole
        bytes @ at + "a count past the record lent whole to `" + pointer + "`, " + from + " and counted in bytes"
        units @ at + "a count past the record lent whole to `" + pointer + "`, " + from + " and counted in what the header's `" + header + "` points at"
    low: str @ ""

    if lend_count.signed_int(c, n.ty)
        low @ n.text + " < 0 || "
    return "if (" + low + "(uint64_t)(" + n.text + ") > (uint64_t)(sizeof(" + lent.place + ") / " + unit + ")) hero_panic(" + unit + " == 1 ? " + lend_count.quoted(bytes) + " : " + lend_count.quoted(units) + ");"
