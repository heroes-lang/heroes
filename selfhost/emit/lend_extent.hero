# The extent a lend crosses with, asserted in C where the call states it as a
# constant (design.md §4.19, §1.12; panel 166's route C in its C-emitted form,
# ratified 2026-09-19; defect 063).
#
# THE CHECK IS C'S, AND SO IS THE NUMBER. Before an extern call whose argument
# is a lend at a `counted_by` parameter, with an extent the call states as a
# compile-time constant, the emitter writes
#
#     _Static_assert(0 <= (int64_t)(INT64_C(64)) && (int64_t)(INT64_C(64)) <= (int64_t)sizeof(h0_s.name),
#                    "heroes-ffi-extent sl_fill p n 812 824 830 832 8");
#
# `sizeof` of the FIELD, in the emitted C, against the real header. That is what
# makes it right where a Heroes-side check is wrong twice over (panel 166's
# critic): a `partial` record's size is C's and not the field list's, and a
# group `constant` — a macro, `SL_NAME_LEN` — lowers to a CALL of its accessor,
# so a check that wanted a literal would refuse the careful reader and accept
# the careless one. Here the macro's NAME is written into the assertion and C
# compares its own value. Zero runtime cost, and the call's own line is
# byte-identical to before. `emit/ffi_extent.hero` reads the marker back into
# `field_lend_extent`, on the number the author wrote.
#
# WHAT COUNTS AS CONSTANT: a literal, a group `constant`, and arithmetic over
# those. A name read at run time is not, and no assertion is written — the
# sitting adopted the C99 `[static N]` discipline, *the declaration without the
# inference*, and a variable extent is the shape it leaves to the author. A
# Heroes `constant` lowers to a call of its accessor and is not folded here
# either: a route nobody priced, recorded rather than assumed.
#
# WHY IN THE BODY AND NOT AT FILE SCOPE. The field is named through the place
# the lend renders — `h0_s.name`, `h0_o.inner.nsap` — which is a local, and
# `sizeof` an lvalue of a complete, non-variable type is an integer constant
# expression in C11 wherever it stands. A `_Static_assert` is a declaration with
# no initialiser, so the prologue's rule about `goto` never reaches it.

use ast
use source
use check/state
use check/table
use ir
use ir/containers
use emit/writer
use emit/mangle
use emit/ctype
use emit/field_lend
use emit/literal
use widths

# The contract between this writer and `emit/ffi_extent.hero`'s reader: one
# string, one home (CLAUDE.md §11).
constant MARKER: str
    "heroes-ffi-extent "

# One assertion per lend at a counted parameter with a constant extent, written
# before the call that carries them.
function assertions(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, run: ir.Run, decl: i64)
    counted = counted_siblings(s, decls, decl: decl)
    given = containers.args_of(f, run)
    index: i64 @ 0

    for arg in given
        match arg
            .value_arg v =>
                lent = field_lend.lend_of(f, value: v.value)

                if !lent.is_err() && index < counted.len() && counted[index] >= 0 && counted[index] < given.len()
                    one = assertion(
                        c,
                        names,
                        s,
                        decls,
                        f,
                        lend: lent.must(),
                        extent: given[counted[index]],
                        decl: decl,
                        pointer: index,
                        count: counted[index]
                    )

                    if !one.is_err()
                        writer.line(@w, text: "    " + one.must())
                    else
                        guard = runtime_guard(
                            c,
                            s,
                            decls,
                            f,
                            lend: lent.must(),
                            extent: given[counted[index]],
                            decl: decl,
                            count: counted[index]
                        )

                        if !guard.is_err()
                            writer.line(@w, text: "    " + guard.must())
            .inout_arg =>
                _ = 0

        index @ index + 1

# For each parameter of the extern, the position of the sibling its
# `counted_by` names, or -1: the pointer at position k is counted by the
# integer at position `counted[k]`.
function counted_siblings(s: source.Source, decls: [ast.Decl], decl: i64) -> [i64]
    out: [i64] @ []

    match decls[decl].kind
        .function_decl fd =>
            for param in fd.value.params
                at: i64 @ 0 - 1

                if !param.counted_by.is_err()
                    wanted = source.span_text(s, param.counted_by.must())
                    i: i64 @ 0

                    for other in fd.value.params
                        if source.span_text(s, other.name) == wanted
                            at @ i
                        i @ i + 1
                out @ out.push(at)
        .constant_decl | .record_decl | .variant_decl | .test_decl =>
            _ = 0

    return out

# The assertion for one lend, or absent where the extent is not a constant the
# emitter can spell.
function assertion(c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, lend: field_lend.Lend, extent: ir.Arg, decl: i64, pointer: i64, count: i64) -> str?
    extent_value = match extent
        .value_arg e => e.value
        .inout_arg   => 0 - 1

    if extent_value < 0
        return fail(code: "none", msg: "an @ argument carries no count in")
    text = constant_text(c, s, decls, f, value: extent_value)?
    place = field_lend.lent_place(c, s, decls, f, value: lend.operand)?
    length = fixed_length(c, f, value: lend.operand)?
    ty = containers.value_type(f, extent_value)
    spelled = ctype.c_type(names, c: c, ty: ty)?
    stated = producer(f, value: extent_value)?
    guard: str @ ""

    if signed_int(c, ty)
        guard @ "0 <= (" + spelled + ")(" + text + ") && "
    params = param_names(s, decls, decl: decl)

    if pointer >= params.len() || count >= params.len()
        return fail(code: "none", msg: "a position past the signature")
    marker = MARKER + source.span_text(s, decls[decl].name) + " " + params[pointer] + " " + params[count] + " " + lend.span.start.to_str() + " " + lend.span.end.to_str() + " " + stated.span.start.to_str() + " " + stated.span.end.to_str() + " " + length.to_str()
    return ok(
        "_Static_assert(" + guard + "(" + spelled + ")(" + text + ") <= (" + spelled + ")sizeof(" + place + "), \"" + marker + "\");"
    )

# **THE HALF NO ASSERTION CAN REACH: an extent read at run time.** One compare
# before the call, against the same `sizeof` the assertion uses, and a named
# abort if the number is past the field.
#
# WHY IT IS HERE RATHER THAN LEFT TO THE PROGRAM. Panel 166 adopted route C's
# C-emitted form, whose check is *only where the extent is a compile-time
# constant* — and the compiler-engineer's own condition for approving the route
# was that *a variable extent must be refused, not admitted; admitting it
# silently is the defect wearing a mark*. Measured on the day this landed:
# `sum_n(p: s.name.ptr(), n: k)` with `k` a parameter read 4096 bytes of the
# stack at exit 0 with the mark in place, and so did `to_u64(64).must()`, which
# is a constant no folding here can see. design.md §1.12 makes no-corruption a
# goal of the LANGUAGE and CLAUDE.md § Precedence puts it above speed, so the
# compare lands rather than the hole.
#
# WHAT IT COSTS, and a seat priced it before it was written: the ffi-pragmatist
# measured one compare at **1% over 200 million lends**, `-O2`, `noinline`
# callee, `volatile` extent so the loop is not folded, ratio clean. The shape is
# `guard_arguments`' null-`cstr` panic one boundary over.
#
# WHAT CONSERVATIVE WOULD HAVE BEEN: refusing a non-constant extent at check
# time, which is the engineer's condition read literally. It refuses
# `wrap(s: Sl, k: i64)` — a count computed by the program and correct — so it
# trades a corruption for an over-refusal, and §4.19's completeness clause is
# the other half of the same §1.12 this discharges.
function runtime_guard(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, lend: field_lend.Lend, extent: ir.Arg, decl: i64, count: i64) -> str?
    extent_value = match extent
        .value_arg e => e.value
        .inout_arg   => 0 - 1

    if extent_value < 0
        return fail(code: "none", msg: "an @ argument carries no count in")
    place = field_lend.lent_place(c, s, decls, f, value: lend.operand)?
    length = fixed_length(c, f, value: lend.operand)?
    ty = containers.value_type(f, extent_value)
    params = param_names(s, decls, decl: decl)

    if count >= params.len()
        return fail(code: "none", msg: "a position past the signature")
    at = source.locate(s, lend.span.start)
    said = at.file + ":" + at.line.to_str() + ": `" + source.span_text(s, decls[decl].name) + "` was given an extent past the " + length.to_str() + " bytes of the field lent to it, read from `" + params[count] + "` at run time"
    low: str @ ""

    if signed_int(c, ty)
        low @ mangle.value(extent_value) + " < 0 || "
    return ok(
        "if (" + low + "(uint64_t)(" + mangle.value(extent_value) + ") > (uint64_t)sizeof(" + place + ")) hero_panic(" + quoted(said) + ");"
    )

# The C spelling of a message: this compiler's own text, so the only characters
# it can hold are the ones a path and a name can, and a quote or a backslash in
# a file name is escaped rather than assumed away.
function quoted(text: str) -> str
    out: str @ "\""

    for ch in text.chars()
        if ch == "\"" || ch == "\\"
            out @ out + "\\" + ch
        else
            out @ out + ch

    return out + "\""

function param_names(s: source.Source, decls: [ast.Decl], decl: i64) -> [str]
    out: [str] @ []

    match decls[decl].kind
        .function_decl fd =>
            for param in fd.value.params
                out @ out.push(source.span_text(s, param.name))
        .constant_decl | .record_decl | .variant_decl | .test_decl =>
            _ = 0

    return out

# The instruction that produced a value.
function producer(f: containers.Function, value: i64) -> ir.Inst?
    for blk in f.blocks
        for inst in blk.insts
            if !inst.dest.is_err() && inst.dest.must() == value
                return ok(inst)

    return fail(code: "none", msg: "no producer")

# The C text of a value the emitter can prove constant: a literal in the width
# the checker gave it, a group constant by its C name, and arithmetic over
# those. Anything else is not written, which is the honest answer rather than
# the loud one: the assertion is a check the compiler ADDS where it can, and
# where it cannot the program's word stands, as the resolution says.
function constant_text(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, value: i64) -> str?
    inst = producer(f, value: value)?

    match inst.op
        .lit l =>
            match l.value
                .int_const =>
                    kind = int_kind(c, f, value: value)
                    none: [str] = []
                    return ok(literal.constant_text(l.value, kind, none))
                .float_const | .bool_const | .str_const | .null_ptr => return fail(code: "none", msg: "not an integer")
        .call cl =>
            match cl.callee
                .heroes_fn h =>
                    match decls[h.decl].kind
                        .constant_decl k =>
                            if !k.header.is_err()
                                return ok(source.span_text(s, decls[h.decl].name))
                            return fail(code: "none", msg: "a Heroes constant is not folded here")
                        .function_decl | .record_decl | .variant_decl | .test_decl => return fail(
                            code: "none",
                            msg: "a call"
                        )
                .extern_fn | .builtin_fn | .indirect => return fail(code: "none", msg: "a call")
        .binary b =>
            op = c_operator(b.op)?
            left = constant_text(c, s, decls, f, value: b.left)?
            right = constant_text(c, s, decls, f, value: b.right)?
            return ok("(" + left + " " + op + " " + right + ")")
        .load | .store | .push_owned | .unary | .cast | .construct | .field | .index => return fail(
            code: "none",
            msg: "not a constant"
        )
        .map_get | .len_of | .tag_of | .payload | .func_ref | .copy_out | .abort_op => return fail(
            code: "none",
            msg: "not a constant"
        )
        .incref | .decref | .decref_slot | .hole | .missing => return fail(code: "none", msg: "not a constant")

    return fail(code: "none", msg: "unreached")

# The arithmetic C shares with Heroes, spelled the same. A comparison answers a
# `bool` and is not an extent.
function c_operator(op: ir.BinaryOp) -> str?
    return match op
        .add                              => ok("+")
        .sub                              => ok("-")
        .mul                              => ok("*")
        .div                              => ok("/")
        .rem                              => ok("%")
        .bit_and                          => ok("&")
        .bit_or                           => ok("|")
        .bit_xor                          => ok("^")
        .shl                              => ok("<<")
        .shr                              => ok(">>")
        .eq | .ne | .lt | .le | .gt | .ge => fail(code: "none", msg: "a comparison is not an extent")

function int_kind(c: state.Checked, f: containers.Function, value: i64) -> widths.IntKind?
    match table.get(c.types, containers.value_type(f, value))
        .int_ty ik                                                 => return ok(ik.kind)
        .float_ty | .bool | .str | .ptr | .cstr | .unit            => return fail(code: "none", msg: "not an integer")
        .array | .fixed | .map | .fallible | .function_ty | .named => return fail(code: "none", msg: "not an integer")
        .case_ty | .failure | .generic | .error                    => return fail(code: "none", msg: "not an integer")

    return fail(code: "none", msg: "unreached")

function signed_int(c: state.Checked, ty: i64) -> bool
    match table.get(c.types, ty)
        .int_ty ik =>
            return match ik.kind
                .i8 | .i16 | .i32 | .i64 => true
                .u8 | .u16 | .u32 | .u64 => false
        .float_ty | .bool | .str | .ptr | .cstr | .unit            => return false
        .array | .fixed | .map | .fallible | .function_ty | .named => return false
        .case_ty | .failure | .generic | .error                    => return false

    return false

# The length of the fixed array a lend hands over — the Heroes-side number, for
# the message; the assertion itself compares against C's `sizeof`.
function fixed_length(c: state.Checked, f: containers.Function, value: i64) -> i64?
    match table.get(c.types, containers.value_type(f, value))
        .fixed x                                                  => return ok(x.length)
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return fail(code: "none", msg: "not a fixed array")
        .array | .map | .fallible | .function_ty | .named         => return fail(code: "none", msg: "not a fixed array")
        .case_ty | .failure | .generic | .error                   => return fail(code: "none", msg: "not a fixed array")

    return fail(code: "none", msg: "unreached")
