# `xs[i] @ v`, and every deeper spelling of it, as C: one unshare per array
# step, each writing back at its own level, and the last step's bound checked
# in the program's own C (design.md §4.9, §4.10; panels 022, 062; panel 230's
# R1). Split out of `emit/container.hero` on 2026-10-26, which stood at §11's
# 300 lines when the store's check had to land in it, along the seam it had:
# what a container is and how it is read, and how an element is written.
#
# **The last step's bound is the program's C's since panel 230's R1.**
# `hero_array_set` checked it inside the runtime, which cannot know where the
# program stood, so an out-of-range write said `array index out of range` and
# nothing else, on the commonest write a program makes (17,163,158 calls in one
# self-emission, the sitting's census). The check is now written before the
# call, the read's own test (`emit/array_read.hero`), its failing branch naming
# the place (`emit/stop_place.hero`); the runtime's check stays behind it as an
# invariant, and no program the emitter wrote reaches it. The slot is taken by
# its address once, in a block, so a place that holds a call is not read
# twice.

use ast
use source
use check/table
use check/state
use ir
use ir/containers
use ir/layout
use emit/mangle
use emit/ctype
use emit/aggregate
use emit/container
use emit/places
use emit/array_read
use emit/nodebug
use emit/stop_place
use parse
use resolve
use checker
use token

# What replaces the value at a C lvalue the walk reached in place, a field or a
# fixed-array element: release the old value where it is counted, then assign.
# hero_array_set releases the old ELEMENT of a [T]; an in-place slot has no
# runtime entry to do it, so releasing is this line's own job, and without it
# one heap block stays live at exit, measured.
function replaced(c: state.Checked, names: ctype.Names, lines: [str], lvalue: str, ty: i64, value: i64) -> [str]?
    out: [str] @= lines

    if layout.is_refcounted(c, ty)
        release: str @= ""

        match table.get(c.types, ty)
            .str     => release @ "hero_str_decref(" + lvalue + ");"
            .array   => release @ "hero_array_decref(" + lvalue + ");"
            .map     => release @ "hero_map_decref(" + lvalue + ");"
            .failure => release @ "hero_failure_release(&(" + lvalue + "));"
            .named | .case_ty | .fallible =>
                sat = ctype.satellite_name(names, c, ty: ty)

                if sat.is_err()
                    return fail(code: "none", msg: "a counted field with no release")
                release @ sat.must() + "_release(&(" + lvalue + "));"
            .int_ty | .float_ty | .bool | .ptr | .cstr | .unit => release @ release
            .fixed | .function_ty | .generic | .error          => release @ release

        out @ out.push(release)
    out @ out.push(lvalue + " = " + mangle.value(value) + ";")
    return ok(out)

# xs[i] @ v, and every deeper spelling of it: one unshare per array
# step, each writing back at its own level. The walk keeps a C LVALUE
# for the place reached so far rather than an address. The last step's
# set unshares a third time and that is deliberate: it is a refcount
# test, it is idempotent, and one entry point that cannot be reached
# without it beats an emitter that has to remember. `site` is where the
# store stands, the place an element's bound names.
function write(c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, at: ir.Place, value: i64, site: i64) -> [str]?
    slot = f.slots[at.root]
    lvalue: str @= places.slot_lvalue(f, at.root)
    ty: i64 @= slot.ty
    steps = containers.steps_of(f, at.path)
    lines: [str] @= []
    position: i64 @= 0
    where = stop_place.of(s, f, offset: site)

    # Whether the place so far is a slot and fields alone, which holds no call
    # (defect 491): see `places.reached`, whose walk this one is.
    pure: bool @= true

    for step in steps
        last = position + 1 == steps.len()

        match step
            .field_step fs =>
                found = aggregate.field(c, s, decls, owner: ty, index: fs.at)

                if found.is_err()
                    return fail(code: "none", msg: "not a field of this type")
                lvalue @ lvalue + "." + found.must().member
                ty @ found.must().ty

                # A field is not an indirection: nothing to unshare. A
                # trailing field store is a plain assignment — done HERE
                # when the path holds an index, because the array levels
                # above were unshared on the way down. (Until 2026-08-17
                # this arm returned None on last, and xs[i].f @ v — first
                # written by the ported resolver — emitted
                # hero_unreachable: a runtime abort on a legal program.
                # THIS session's own fixedbugs case.)
                if last
                    return replaced(c, names, lines, lvalue, ty: ty, value: value)
            .index_step ix =>
                # A map step ends the walk: m[k] @ v inserts, so there
                # is no element to descend into.
                is_map: bool @= false
                element: i64 @= 0 - 1
                fixed_len: i64 @= 0 - 1

                match table.get(c.types, ty)
                    .map       => is_map @ true
                    .array arr => element @ arr.element
                    .fixed x =>
                        element @ x.element
                        fixed_len @ x.length
                    .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_map @ is_map
                    .fallible | .function_ty | .named                         => is_map @ is_map
                    .case_ty | .failure | .generic | .error                   => is_map @ is_map

                if is_map
                    if !last
                        return fail(code: "none", msg: "a map step must end the walk")
                    lines @ lines.push(
                        stop_place.around(s, f, offset: site, statement: "hero_map_set_at(&(" + lvalue + "), &" + mangle.value(ix.value) + ", &" + mangle.value(value) + ", &" + stop_place.HERE + ");")
                    )
                    return ok(lines)

                if element < 0
                    return fail(code: "none", msg: "not a container step")

                # A fixed array is the elements themselves, inline in the
                # record that holds it, so like a field it is no
                # indirection: nothing to unshare, and the element is
                # written where it lies. Until defect 097 this arm read
                # `.fixed` as "not a container step", and `n.a[0] @ 9`,
                # `check` 0, died at run time as a compiler bug.
                if fixed_len >= 0
                    lvalue @ places.subscript(
                        base: lvalue,
                        index: mangle.value(ix.value),
                        length: fixed_len,
                        where: where
                    )
                    ty @ element
                    pure @ false

                    if last
                        return replaced(c, names, lines, lvalue, ty: ty, value: value)
                else
                    if last
                        for one in set(lvalue: lvalue, index: mangle.value(ix.value), value: mangle.value(value), where: where)
                            lines @ lines.push(one)

                        return ok(lines)
                    lines @ lines.push("hero_array_unshare(&(" + lvalue + "));")
                    spelling = ctype.c_type(names, c: c, ty: element)

                    if spelling.is_err()
                        return fail(code: "none", msg: "an element with no C type")
                    lvalue @ array_read.place(
                        spelling: spelling.must(),
                        base: lvalue,
                        index: mangle.value(ix.value),
                        pure: pure,
                        where: where
                    )
                    ty @ element
                    pure @ false

        position @ position + 1

    return fail(code: "none", msg: "not an element write")

# The last step: the slot by its address, once, its bound asked in the
# program's C with the place, then the runtime's set. `index` and `value` are
# temporaries' names, so naming them twice evaluates nothing twice.
function set(lvalue: str, index: str, value: str, where: str) -> [str]
    return [
        "{"
        "  " + nodebug.MARK + "HeroArrayHeader **hero_slot = &(" + lvalue + ");"
        "  if (*hero_slot == NULL || " + index + " < 0 || " + index + " >= (*hero_slot)->len) hero_panic_index_at(*hero_slot, " + index + ", " + where + ");"
        "  hero_array_set(hero_slot, " + index + ", &" + value + ");"
        "}"
    ]

## Tests

record Setup
    c: state.Checked
    s: source.Source
    decls: [ast.Decl]
    names: ctype.Names

function ready(text: str) -> Setup
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked = checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, p.decls)
    return Setup(c: c, s: s, decls: p.decls, names: names)

test "the session's own fixedbug: a trailing field behind an index releases then assigns"
    got = ready(
        "record Row\n    label: str\n\nfunction main()\n    rows = [Row(label: \"a\")]\n    rows[0].label @ \"b\"\n    print(rows[0].label)\n"
    )
    row = table.lookup(got.c.types, .named(decl: 0)).must()
    arr = table.lookup(got.c.types, .array(element: row)).must()
    int_id = table.int_ty_id(got.c.types)
    slots: [containers.Slot] = [containers.Slot(name: "rows", ty: arr, kind: .local_slot(mutable: false))]
    steps: [ir.PathStep] = [.index_step(value: 1), .field_step(at: 0)]
    f = containers.Function(
        name: "t",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: slots,
        blocks: [],
        values: [arr, int_id, table.str_ty(got.c.types)],
        arguments: [],
        steps: steps,
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    lines = write(
        got.c,
        got.names,
        got.s,
        got.decls,
        f,
        at: ir.Place(root: 0, path: ir.Run(start: 0, length: 2)),
        value: 2,
        site: 0
    )

    # Unshare the array level, release the old str, assign — the three
    # lines the bootstrap fix of 2026-08-17 settled on.
    assert lines.must().len() == 3
    assert lines.must()[0] == "hero_array_unshare(&(h0_rows));"

    # The element step's base is a slot, which holds no call, so the place is
    # read in place, its failing branch naming the store's place (defect 491,
    # `emit/array_read.hero`; panel 230's R1).
    place = "(*((void)((h0_rows == NULL || t1 < 0 || t1 >= h0_rows->len) ? hero_panic_index_at(h0_rows, t1, \"t.hero\", \"t.t\", 1, 1) : (void)0), (void)(h0_rows->elem->size != sizeof(h_t_Row) ? hero_unreachable() : (void)0), (h_t_Row *)(void *)(h0_rows + 1) + t1))"
    assert lines.must()[1] == "hero_str_decref(" + place + ".f_label);"
    assert lines.must()[2] == place + ".f_label = t2;"

# Defect 491's other half: the walk carries whether the place so far is a
# slot and fields alone. The first descent is over a slot, and the second is
# over the first's own place, which holds a call, so only the first is read in
# place and the second is the runtime's call, as it was. The last step's slot
# is taken by its address once, its bound asked with the place (panel 230's R1).
test "a place three array steps deep reads its first step in place and asks the last step's bound with its place"
    got = ready("function main()\n    g: [[[i64]]] @= []\n    print(g.len())\n")
    int_id = table.int_ty_id(got.c.types)
    a1 = table.lookup(got.c.types, .array(element: int_id)).must()
    a2 = table.lookup(got.c.types, .array(element: a1)).must()
    a3 = table.lookup(got.c.types, .array(element: a2)).must()
    slots: [containers.Slot] = [containers.Slot(name: "g", ty: a3, kind: .local_slot(mutable: true))]
    steps: [ir.PathStep] = [.index_step(value: 1), .index_step(value: 2), .index_step(value: 3)]
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: slots,
        blocks: [],
        values: [a3, int_id, int_id, int_id, int_id],
        arguments: [],
        steps: steps,
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )

    # The store stands at `g`, the second line's fifth column.
    lines = write(
        got.c,
        got.names,
        got.s,
        got.decls,
        f,
        at: ir.Place(root: 0, path: ir.Run(start: 0, length: 3)),
        value: 4,
        site: 20
    )
    at = "\"t.hero\", \"t.t\", 2, 5"
    first = "(*((void)((h0_g == NULL || t1 < 0 || t1 >= h0_g->len) ? hero_panic_index_at(h0_g, t1, " + at + ") : (void)0), (void)(h0_g->elem->size != sizeof(HeroArrayHeader *) ? hero_unreachable() : (void)0), (HeroArrayHeader * *)(void *)(h0_g + 1) + t1))"
    second = "(*(HeroArrayHeader * *)hero_array_at_mut_at(" + first + ", t2, " + at + "))"
    assert lines.must() == ["hero_array_unshare(&(h0_g));", "hero_array_unshare(&(" + first + "));", "{", "  HERO_NODEBUG HeroArrayHeader **hero_slot = &(" + second + ");", "  if (*hero_slot == NULL || t3 < 0 || t3 >= (*hero_slot)->len) hero_panic_index_at(*hero_slot, t3, " + at + ");", "  hero_array_set(hero_slot, t3, &t4);", "}"]

test "defect 097: a fixed-array element is written in place, through the read's own guard"
    got = ready(
        "extern \"m.h\"\n    record Cell tag cell\n        v: i64\n    record Holder tag holder\n        xs: Cell[3]\n\nfunction touch(h: Holder) -> i64\n    return h.xs[0].v\n\nfunction main()\n    print(1)\n"
    )
    cell = table.lookup(got.c.types, .named(decl: 0)).must()
    holder = table.lookup(got.c.types, .named(decl: 1)).must()
    fixed = table.lookup(got.c.types, .fixed(element: cell, length: 3)).must()
    int_id = table.int_ty_id(got.c.types)
    slots: [containers.Slot] = [containers.Slot(name: "h", ty: holder, kind: .local_slot(mutable: true))]
    steps: [ir.PathStep] = [.field_step(at: 0), .index_step(value: 1), .field_step(at: 0)]
    f = containers.Function(
        name: "t",
        decl: 2,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: slots,
        blocks: [],
        values: [fixed, int_id, int_id, cell],
        arguments: [],
        steps: steps,
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )

    # The read of `t0[t1]`, with no instruction behind `t0`, keeps the plain
    # temporary as its base; everything after it is the guard, and the write
    # must carry that same text, so the two cannot disagree on a bound.
    at = stop_place.of(got.s, f, offset: 0)
    read = container.read_element(got.c, got.s, got.decls, got.names, f, base: 0, index: 1, where: at)
    guard = read.must().slice(from: 2, to: read.must().len())
    assert read.must() == "t0" + guard
    assert guard == "[((uint64_t)(t1) >= UINT64_C(3) ? (hero_panic_at(\"index out of range for a fixed array\", \"t.hero\", \"t.t\", 1, 1), (int64_t)0) : (t1))]"

    # `h.xs[i].v @ t2`: no unshare, because an inline array is no indirection,
    # and one assignment where the element lies.
    deep = write(
        got.c,
        got.names,
        got.s,
        got.decls,
        f,
        at: ir.Place(root: 0, path: ir.Run(start: 0, length: 3)),
        value: 2,
        site: 0
    )
    assert deep.must().len() == 1
    assert deep.must()[0] == "h0_h.xs" + guard + ".v = t2;"

    # `h.xs[i] @ t3`: the whole element, the same subscript, and the walk ends.
    whole = write(
        got.c,
        got.names,
        got.s,
        got.decls,
        f,
        at: ir.Place(root: 0, path: ir.Run(start: 0, length: 2)),
        value: 3,
        site: 0
    )
    assert whole.must().len() == 1
    assert whole.must()[0] == "h0_h.xs" + guard + " = t3;"
