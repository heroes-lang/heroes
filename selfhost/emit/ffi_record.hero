# The classes where the header contradicts a RECORD (design.md §4.19;
# panels 060, 061, 073, 077, 079). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_record.rs.
#
# The reader of the union assertions `emit/extern_union.hero` writes into
# the program's own unit, which fault the DECLARATION of a record over a C
# union TYPE, and the lookups every record class shares: the declaration by
# its name and a field's span. Each match is a contract
# read from this compiler's own marker. What the header's LAYOUT says against
# a record over a struct, from `cli/layout.hero`'s check unit, is
# `emit/ffi_layout.hero`'s (panel 186); the positional completeness reader
# that lived here until then read clang's prose through the #line mapping and
# named a declared field when the one left out was in the middle.

use token
use ast
use source
use diag
use emit/externs as emit_externs
use emit/extern_union
use emit/ffi_lookup
use parse
use resolve
use checker

# A group's record over a C UNION, at the two operations that would
# answer wrongly: constructing one, and comparing or hashing one
# (panel 073). The route back is the finding: reading is untouched,
# and a record naming ONE member binds it soundly.
function union_record(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: extern_union.UNION_ASSERTION)

    if rest.is_err()
        return fail(code: "none", msg: "not a union assertion")
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() == 0
        return fail(code: "none", msg: "the marker's tail is empty")
    type_name = parts[0]
    members: [str] @ []
    index: i64 @ 1
    fall: bool @ false

    while index < parts.len() && !fall
        if ffi_lookup.has(text: parts[index], needle: "\"")
            fall @ true
        else
            members @ members.push(parts[index])
            index @ index + 1

    found = record_of(s, decls, type_name: type_name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this record")

    # The two cases read differently because they ARE different (panel
    # 077): with one declared member the record is buildable and
    # readable and it is ==/hash that has no answer; with two or more,
    # building it is already wrong, because C keeps the last written.
    d: diag.Diagnostic @ diag.new_diagnostic(code: "ffi_union_field", message: "", span: found.must().span)

    if members.len() <= 1
        one: str @ "its member"

        if members.len() == 1
            one @ members[0]
        d.message @ "`" + type_name + "` is a `union` in `" + found.must().header + "`, so comparing or hashing one asks about bytes that may hold another member — `" + one + "` is only what was written last"
        d.notes @ d.notes.push(
            "reading `" + one + "` and building one that names it are both sound and stay legal; what has no answer is `==`, `hash` and being a map key, because two values holding different members are equal whenever the bytes match. Mark the `record` `partial` if you want that refusal stated at the declaration"
        )
    else
        named: str @ ""

        if members.len() == 2
            named @ "`" + members[0] + "` and `" + members[1] + "`"
        else
            heads: [str] @ []
            at: i64 @ 0

            while at < members.len() - 1
                heads @ heads.push(members[at])
                at @ at + 1

            named @ "`" + heads.join("`, `") + "` and `" + members[members.len() - 1] + "`"
        d.message @ "`" + type_name + "` is a `union` in `" + found.must().header + "`, so " + named + " are the same bytes — building one or comparing it would answer about whichever was written last"
        d.notes @ d.notes.push(
            "a `record` over a union may name ONE member, and that binds it soundly: reading through it is correct and construction sets the member it names. Two or more is what has no answer — C keeps the last one written, so `==` and `hash` walk the same bytes twice"
        )
    return ok(d)

# The span of `field` in the group record `type_name`, or `otherwise`.
function field_span(s: source.Source, decls: [ast.Decl], type_name: str, field: str, otherwise: token.Span) -> token.Span
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                for one in rec.fields
                    if source.span_text(s, one.name) == field
                        return one.name
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return otherwise

# The declaration's own name span, for a class whose fault is the
# declaration rather than any one field.
record RecordOf
    header: str
    span: token.Span

function record_of(s: source.Source, decls: [ast.Decl], type_name: str) -> RecordOf?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err()
                    return ok(RecordOf(header: emit_externs.unquoted(s, span: rec.header.must()), span: decl.name))
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail(code: "none", msg: "no group record has this name")

## Tests

test "union_record reads its own marker, one member and many apart"
    text = "extern \"m.h\"\n    record UDef\n        i: i64\n        f: i64\n    record One\n        v: i64\n\nfunction touch(u: UDef, o: One)\n    _ = u\n    _ = o\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    two = "m.c:9:1: error: static assertion failed due to requirement 'x': heroes-ffi-union UDef i f"
    d = union_record(s, parsed.decls, line: two)
    assert d.must().code == "ffi_union_field"
    assert d.must().message == "`UDef` is a `union` in `m.h`, so `i` and `f` are the same bytes — building one or comparing it would answer about whichever was written last"
    one = "m.c:9:1: error: static assertion failed due to requirement 'x': heroes-ffi-union One v"
    k = union_record(s, parsed.decls, line: one)
    assert k.must().message == "`One` is a `union` in `m.h`, so comparing or hashing one asks about bytes that may hold another member — `v` is only what was written last"

    # The interpolated note names the member — the bootstrap shipped
    # this note with a literal {one} inside it, fixed by this crossing.
    assert k.must().notes[0] == "reading `v` and building one that names it are both sound and stay legal; what has no answer is `==`, `hash` and being a map key, because two values holding different members are equal whenever the bytes match. Mark the `record` `partial` if you want that refusal stated at the declaration"

    # The premise-death control's own message contains no marker tail
    # that parses: 'a union must classify as 13…' has no record name.
    control = "m.c:9:1: error: static assertion failed due to requirement 'y': a union must classify as 13, or every heroes-ffi-union assertion above is vacuous"
    assert union_record(s, parsed.decls, line: control).is_err()
