# The classes where the header contradicts a RECORD (design.md §4.19;
# panels 060, 061, 073, 077, 079). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_record.rs.
#
# The reader of the union assertions `emit/extern_union.hero` writes into
# the program's own unit, which fault the DECLARATION of a record over a C
# union TYPE, and the lookups every record class shares: the declaration by
# its name, a field's span and its written type. Each match is a contract
# read from this compiler's own marker. What the header's LAYOUT says against
# a record over a struct, from `cli/layout.hero`'s check unit, is
# `emit/ffi_layout.hero`'s (panel 186); the positional completeness reader
# that lived here until then read clang's prose through the #line mapping and
# named a declared field when the one left out was in the middle.

use token
use ast
use source
use diag
use emit/externs as emit_externs
use emit/extern_union
use emit/ffi_lookup
use parse
use resolve
use checker

# A group's record over a C UNION TYPE, at the operations that would answer
# wrongly (panels 073, 077, 186): comparing one, hashing it or keying a map by
# it through a field that is not compared bit for bit or is narrower than the
# union. Reading is untouched, and so is a construction naming one member, or
# a comparison through an integer as wide as the union. A construction naming
# two or more members is told where it was written, by
# `emit/ffi_built.hero` (panel 186 R7), so this reader leaves that marker.
function union_record(s: source.Source, tree: ast.Ast, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    kind: str @ ""
    rest: str @ ""

    for marker in [extern_union.UNION_KIND, extern_union.UNION_NARROW, extern_union.UNION_ASSERTION]
        tail = ffi_lookup.after(text: line, marker: marker + " ")

        if !tail.is_err() && kind.len() == 0
            kind @ marker
            rest @ tail.must()

    if kind.len() == 0
        return fail(code: "none", msg: "not a union assertion")
    parts = ffi_lookup.words(text: rest)

    if parts.len() == 0
        return fail(code: "none", msg: "the marker's tail is empty")
    type_name = parts[0]
    members: [str] @ []
    index: i64 @ 1
    fall: bool @ false

    while index < parts.len() && !fall
        if ffi_lookup.has(text: parts[index], needle: "\"")
            fall @ true
        else
            members @ members.push(parts[index])
            index @ index + 1

    found = record_of(s, decls, type_name: type_name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this record")
    h = found.must().header
    d: diag.Diagnostic @ diag.new_diagnostic(code: "ffi_union_field", message: "", span: found.must().span)
    wrong = ", so comparing a `" + type_name + "` or using one as a map key can call two different values equal"
    compare_note = "only an integer, a pointer or an array of them as wide as the union compares a union's bytes; reading through any member, and building one that names one member, stay legal"

    if kind != extern_union.UNION_ASSERTION && members.len() == 1
        m = members[0]

        if kind == extern_union.UNION_KIND
            d.message @ "`" + type_name + "` is a `union` in `" + h + "`, and `" + m + "` is a `" + field_type_text(s, tree, decls, type_name: type_name, field: m) + "`, which is not compared bit for bit" + wrong
        else
            d.message @ "`" + type_name + "` is a `union` in `" + h + "`, and `" + m + "` is narrower than it, so comparing a `" + type_name + "` or using one as a map key would compare only part of its bytes"
        d.notes @ d.notes.push(compare_note)
        return ok(d)

    if members.len() >= 2
        return fail(code: "none", msg: "a construction naming two members, told at the construction")

    # A record with no field, compared: nothing names the union's bytes.
    d.message @ "`" + type_name + "` is a `union` in `" + h + "`, and no field names its bytes" + wrong
    d.notes @ d.notes.push(compare_note)
    return ok(d)

# The type a field of the group record `type_name` is written with, as the
# author wrote it: `f32`, `u8[4]`.
function field_type_text(s: source.Source, tree: ast.Ast, decls: [ast.Decl], type_name: str, field: str) -> str
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                for one in rec.fields
                    if source.span_text(s, one.name) == field
                        return source.span_text(s, tree.types[one.ty].span)
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return field

# The span of `field` in the group record `type_name`, or `otherwise`.
function field_span(s: source.Source, decls: [ast.Decl], type_name: str, field: str, otherwise: token.Span) -> token.Span
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                for one in rec.fields
                    if source.span_text(s, one.name) == field
                        return one.name
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return otherwise

# The declaration's own name span, for a class whose fault is the
# declaration rather than any one field.
record RecordOf
    header: str
    span: token.Span

function record_of(s: source.Source, decls: [ast.Decl], type_name: str) -> RecordOf?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err()
                    return ok(RecordOf(header: emit_externs.unquoted(s, span: rec.header.must()), span: decl.name))
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail(code: "none", msg: "no group record has this name")

## Tests

test "union_record reads a union compared by kind and by width, and leaves a construction to ffi_built"
    text = "extern \"m.h\"\n    record UDef\n        i: i64\n        f: i64\n    record One\n        v: f32\n\nfunction touch(u: UDef, o: One)\n    _ = u\n    _ = o\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    head = "m.c:9:1: error: static assertion failed due to requirement 'x': "

    # Built from two members: told at the construction (`emit/ffi_built.hero`).
    assert union_record(s, parsed.tree, parsed.decls, line: head + "heroes-ffi-union UDef i f").is_err()
    k = union_record(s, parsed.tree, parsed.decls, line: head + "heroes-ffi-union-kind One v")
    assert k.must().message == "`One` is a `union` in `m.h`, and `v` is a `f32`, which is not compared bit for bit, so comparing a `One` or using one as a map key can call two different values equal"
    w = union_record(s, parsed.tree, parsed.decls, line: head + "heroes-ffi-union-narrow UDef i")
    assert w.must().message == "`UDef` is a `union` in `m.h`, and `i` is narrower than it, so comparing a `UDef` or using one as a map key would compare only part of its bytes"

    # The premise-death control's own message contains no marker tail
    # that parses: 'a union must classify as 13…' has no record name.
    control = "m.c:9:1: error: static assertion failed due to requirement 'y': a union must classify as 13, or every heroes-ffi-union assertion above is vacuous"
    assert union_record(s, parsed.tree, parsed.decls, line: control).is_err()
