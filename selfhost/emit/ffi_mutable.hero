# The class where C WOULD WRITE THROUGH A CSTR (design.md §1.12,
# §4.19; panel 058, ratified 2026-08-15). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_mutable.rs.
#
# .cstr() is zero-copy (§4.20): it hands C the interior pointer of a
# refcounted, copy-on-write buffer. A C function whose parameter is a
# plain char * writes into values the program never handed it —
# measured, b = a then strtok(a.cstr(), …) changes both at exit 0 —
# and on a literal the same write is SIGBUS. The refusal deletes a
# SPELLING, not a function: 186 plain char * parameters across 17
# headers, 159 of them genuinely write, and the correct spelling —
# ptr with a buffer C owns — compiles today.
#
# Sibling of emit_ffi_narrowed and gated the same way: the message
# carries no C name, so the question is asked of the LOCATION. The
# DISCARDS phrase itself lives in emit_ffi_lookup, because narrowed
# names it to step aside — the one Rust cycle in this family, cut by
# giving the shared string the shared home.

use ast
use source
use diag
use check/state
use check/render
use ir/containers
use emit/ctype
use emit/extern_probe
use emit/ffi_lookup
use emit/ffi_site
use parse
use resolve
use checker
use ir/lower

# A parameter the header declares WRITABLE, which .cstr() cannot
# supply.
function writable_parameter(s: source.Source, decls: [ast.Decl], p: containers.Program, c: state.Checked, names: ctype.Names, line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.DISCARDS)
        return fail("none", "not a qualifier line")
    at = ffi_site.location(s, line: line)

    if at.is_err()
        return fail("none", "no usable location")

    # 'const char *' to parameter of type 'char *' — the header's type
    # is the last quoted name, the same shape ffi_narrowed reads.
    c_type = ffi_site.last_quoted(at.must().rest)

    if c_type.is_err()
        return fail("none", "no header type on the line")
    found = ffi_site.extern_at_line(p, s, decls, file: at.must().file, at_line: at.must().line)

    if found.is_err()
        return fail("none", "no extern is declared at that line")
    f = found.must().f
    name = found.must().name
    parameters = extern_probe.parameter_list(names, c, f)

    if parameters.is_err()
        return fail("none", "a parameter with no C spelling")
    arguments = extern_probe.probe_arguments(f, c)
    module = source.component_at(s, decls[f.decl].span.start)
    probe = extern_probe.probe_name(module: module, name: name)
    columns = extern_probe.argument_columns(
        probe: probe,
        name: name,
        parameters: parameters.must(),
        arguments: arguments
    )

    # The parameter's own declared type, READ FROM THE VALUE rather
    # than asserted to be cstr (CLAUDE.md §11 — a narrowing asks the
    # value): a future Heroes type that also lowers to a pointer would
    # otherwise be described wrong.
    which: str @ "a parameter"
    declared: str @ "cstr"
    index: i64 @ 0

    for column in columns
        if column == at.must().col && index < f.params.len()
            which @ "`" + f.slots[f.params[index]].name + "`"
            none: [str] = []
            declared @ render.render_ty(c.types, s, decls, f.slots[f.params[index]].ty, none)
        index @ index + 1

    span = decls[f.decl].span

    # "does not promise to leave it alone", not "would write through
    # it" (author decision 2026-08-15, from panel 059): free(void *)
    # does not WRITE through its argument, it deallocates it — both
    # are the same defect for this program and neither is "writing",
    # so the message states what the header actually declares.
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_writable_parameter",
        message: which + " of `" + name + "` is declared `" + declared + "`, and the header says `" + c_type.must() + "` — C does not promise to leave it alone",
        span: span
    )
    d.notes @ d.notes.push(
        "§4.20: `s.cstr()` lends the string's own bytes, and they may be shared with other values — a C write through them changes values this program never passed to C, and on a literal it aborts"
    )

    # The repair is not "add const", which is the header's to choose
    # and not this program's. It is to stop lending and start owning.
    d.notes @ d.notes.push("declare it `ptr` and give `" + name + "` a buffer C owns, then read the result back")
    d.fixes @ d.fixes.push(diag.Fix(title: "declare it `ptr`", replacement: "ptr", span: span, certainty: .guess))
    return ok(d)

## Tests

test "a writable char * names the lent parameter and the owning repair"
    text = "extern \"string.h\"\n    function strtok(target: cstr, sep: cstr) -> cstr\n\nfunction main()\n    _ = strtok(target: \"a,b\".cstr(), sep: \",\".cstr())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names = ctype.new_names(s, parsed.decls)
    fs = low.program.functions
    f0: containers.Function @ fs[0]
    picked: bool @ false

    for f in fs
        if f.name == "strtok" && !picked
            f0 @ f
            picked @ true

    parameters = extern_probe.parameter_list(names, c, f0).must()
    arguments = extern_probe.argument_names(count: 2)
    probe = extern_probe.probe_name(module: "t", name: "strtok")
    columns = extern_probe.argument_columns(
        probe: probe,
        name: "strtok",
        parameters: parameters,
        arguments: arguments
    )
    line = "t.hero:2:" + columns[0].to_str() + ": warning: passing 'const char *' to parameter of type 'char *' discards qualifiers"
    d = writable_parameter(s, parsed.decls, low.program, c, names, line: line)
    assert d.must().code == "ffi_writable_parameter"
    assert d.must().message == "`target` of `strtok` is declared `cstr`, and the header says `char *` — C does not promise to leave it alone"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "ptr"
    assert d.must().fixes[0].certainty == .guess

    # A line without the qualifier phrase is not this class.
    plain = "t.hero:2:9: error: implicit conversion loses integer precision: 'int64_t' to 'int'"
    assert writable_parameter(s, parsed.decls, low.program, c, names, line: plain).is_err()

    # A caret that misses every argument column still lands, with the
    # parameter unnamed — the rule is the rule, only the name is lost.
    off = "t.hero:2:1: warning: passing 'const char *' to parameter of type 'char *' discards qualifiers"
    k = writable_parameter(s, parsed.decls, low.program, c, names, line: off)
    assert k.must().message == "a parameter of `strtok` is declared `cstr`, and the header says `char *` — C does not promise to leave it alone"
