# The class where C WOULD WRITE THROUGH A CSTR (design.md §1.12,
# §4.19; panel 058, ratified 2026-08-15). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_mutable.rs.
#
# .cstr() is zero-copy (§4.20): it hands C the interior pointer of a
# refcounted, copy-on-write buffer. A C function whose parameter is a
# plain char * writes into values the program never handed it —
# measured, b = a then strtok(a.cstr(), …) changes both at exit 0 —
# and on a literal the same write is SIGBUS. The refusal deletes a
# SPELLING, not a function: 186 plain char * parameters across 17
# headers, 159 of them genuinely write, and the correct spelling —
# ptr with a buffer C owns — compiles today.
#
# **The verdict is the header's answer to one question, asked directly**
# (defect 411, 2026-10-06): does the parameter's pointer point at `const`
# bytes? It was clang's word *discards qualifiers* about the probe's call,
# and clang tells a `const char *` handed to an `unsigned char *` another
# way, `-Wpointer-sign`, a warning: `SHA256_Final(md: cstr lent)` built at
# exit 0, wrote SHA-256's 32 bytes through a `str` the program shared, and
# a literal lent the same way was SIGBUS. So every `cstr` parameter that is
# not `@` is asked in the pointee check's unit (`cli/header_types.hero`),
# at the author's own line, as C11 arithmetic on the header's own type `P`:
#     __builtin_types_compatible_p(P, __typeof__(*(P)0) const *)
# which holds exactly when what `P` points at is already `const`, whatever
# typedef, sign, `restrict` or array spelling the header uses. Its failure
# carries `WRITABLE_MARKER`, and `writable_pointee` reads it back here.
#
# The phrase is kept as a second route, sibling of emit_ffi_narrowed and
# gated the same way: the message carries no C name, so the question is
# asked of the LOCATION. It answers only where the pointee check could not
# ask (a header the dump could not read alone). The DISCARDS phrase itself
# lives in emit_ffi_lookup, because narrowed names it to step aside — the
# one Rust cycle in this family, cut by giving the shared string the
# shared home.

use ast
use bytes
use source
use token
use diag
use check/state
use check/freer as freer
use check/freer_marks
use check/render
use ir/containers
use emit/ctype
use emit/extern_probe
use emit/probe_reply as probe_reply
use emit/ffi_lookup
use emit/ffi_site
use emit/ffi_pointee
use cli/pointee_ask
use parse
use resolve
use checker
use ir/lower

# The contract between the check unit that asks the question and the reader
# below: one string, one home (CLAUDE.md §11). No other `heroes-ffi-` marker
# is a prefix of it, nor it of one.
constant WRITABLE_MARKER: str
    "heroes-ffi-writable "

# A parameter the header declares WRITABLE, which .cstr() cannot
# supply: the pointee check's answer first, then clang's phrase.
function writable_parameter(s: source.Source, decls: [ast.Decl], p: containers.Program, c: state.Checked, names: ctype.Names, line: str) -> diag.Diagnostic?
    asked = writable_pointee(s, decls, p, c, line: line)

    if !asked.is_err()
        return asked

    if !ffi_lookup.has(text: line, needle: ffi_lookup.DISCARDS)
        return fail(code: "none", msg: "not a qualifier line")
    at = ffi_site.location(s, line: line)

    if at.is_err()
        return fail(code: "none", msg: "no usable location")

    # 'const char *' to parameter of type 'char *' — the header's type
    # is the last quoted name, the same shape ffi_narrowed reads.
    c_type = ffi_site.last_quoted(at.must().rest)

    if c_type.is_err()
        return fail(code: "none", msg: "no header type on the line")
    found = ffi_site.extern_at_line(p, s, decls, file: at.must().file, at_line: at.must().line)

    if found.is_err()
        return fail(code: "none", msg: "no extern is declared at that line")
    f = found.must().f
    name = found.must().name

    # The reader must compute the SAME probe line the emitter wrote, or its
    # column matching lands on the wrong parameter (panel 116).
    parameters = extern_probe.parameter_list(
        names,
        c,
        decls,
        f,
        frees: !freer_marks.marked_as_freer(c.freers, name: name).is_err()
    )

    if parameters.is_err()
        return fail(code: "none", msg: "a parameter with no C spelling")
    arguments = extern_probe.probe_arguments(f, c)
    module = source.component_at(s, decls[f.decl].span.start)
    probe = extern_probe.probe_name(module: module, name: name)
    columns = probe_reply.argument_columns(
        probe: probe,
        name: name,
        parameters: parameters.must(),
        arguments: arguments
    )

    # The parameter's own declared type, READ FROM THE VALUE rather
    # than asserted to be cstr (CLAUDE.md §11 — a narrowing asks the
    # value): a future Heroes type that also lowers to a pointer would
    # otherwise be described wrong.
    which: str @ "a parameter"
    declared: str @ "cstr"
    index: i64 @ 0

    # **The `char **` carve-out** (§4.19; panel 109's condition 5, spelled in the
    # spec since M-declared-freer step 2). Panel 058's rule is right in general:
    # lending a string's own bytes to a C that may write through them changes
    # values this program never passed to C. A MARKED `@cstr` is the one case
    # where C writes a pointer the program will OWN — the compiler frees it by
    # the name the declaration gives — so the rule steps aside there and only
    # there. Without this the spec describes a program the compiler refuses,
    # which is the worse of the two ways to be wrong.
    for column in columns
        if column == at.must().col && index < f.params.len()
            if freer.owned_parameter(decls, at: f.decl, index: index)
                if c_type.must() != "const char **"
                    return fail(code: "none", msg: "a marked `@cstr` owns what C writes there")
                return ok(owned_const(name: name, param: f.slots[f.params[index]].name, span: decls[f.decl].span))
            which @ "`" + f.slots[f.params[index]].name + "`"
            none: [str] = []
            declared @ render.render_ty(c.types, s, decls, f.slots[f.params[index]].ty, none)
        index @ index + 1

    return ok(refusal(name: name, which: which, declared: declared, c_type: c_type.must(), span: decls[f.decl].span))

# The one diagnostic both routes give, so the header's answer and clang's
# phrase tell the author the same thing.
function refusal(name: str, which: str, declared: str, c_type: str, span: token.Span) -> diag.Diagnostic
    # "does not promise to leave it alone", not "would write through
    # it" (author decision 2026-08-15, from panel 059): free(void *)
    # does not WRITE through its argument, it deallocates it — both
    # are the same defect for this program and neither is "writing",
    # so the message states what the header actually declares.
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_writable_parameter",
        message: which + " of `" + name + "` is declared `" + declared + "`, and the header says `" + c_type + "` — C does not promise to leave it alone",
        span: span
    )
    d.notes @ d.notes.push(
        "§4.20: `s.cstr()` lends the string's own bytes, and they may be shared with other values — a C write through them changes values this program never passed to C, and on a literal it aborts"
    )

    # The repair is not "add const", which is the header's to choose
    # and not this program's. It is to stop lending and start owning.
    d.notes @ d.notes.push("declare it `ptr` and give `" + name + "` a buffer C owns, then read the result back")
    d.fixes @ d.fixes.push(diag.Fix(title: "declare it `ptr`", replacement: "ptr", span: span, certainty: .guess))
    return d

## The header's answer

# `heroes-ffi-writable <name> <param> <header type…>` failed: the pointer the
# header takes for a `cstr` parameter points at bytes it does not promise to
# leave alone. Gated on the LOCATION like the route above, since the check
# unit `#line`s the question at the author's declaration: a line in a file
# this compilation does not own, the library's among them, is not the
# author's to be told.
function writable_pointee(s: source.Source, decls: [ast.Decl], p: containers.Program, c: state.Checked, line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: WRITABLE_MARKER)

    if rest.is_err()
        return fail(code: "none", msg: "not a read-only lend's assertion")
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() < 3
        return fail(code: "none", msg: "the marker's tail is not ours")
    at = ffi_site.location(s, line: line)

    if at.is_err()
        return fail(code: "none", msg: "no usable location")
    found = ffi_site.extern_at_line(p, s, decls, file: at.must().file, at_line: at.must().line)

    if found.is_err() || found.must().name != parts[0]
        return fail(code: "none", msg: "no extern of that name is declared at that line")
    f = found.must().f
    tail: [str] @ []
    index: i64 @ 2

    while index < parts.len()
        tail @ tail.push(parts[index])
        index @ index + 1

    header_type = unqualified(ffi_pointee.trim_quote(tail.join(" ")))

    for slot_id in f.params
        if f.slots[slot_id].name == parts[1]
            none: [str] = []
            declared = render.render_ty(c.types, s, decls, f.slots[slot_id].ty, none)
            return ok(
                refusal(name: parts[0], which: "`" + parts[1] + "`", declared: declared, c_type: header_type, span: decls[f.decl].span)
            )

    return fail(code: "none", msg: "no parameter of that name")

# The question, as the line the check unit writes for one parameter whose
# header type is `header_type`. `*(P)0` names the pointee as C reads it, so a
# typedef (`LPSTR`, `uint8_t *`), an array parameter (adjusted to a pointer)
# and a `void *` are asked alike; `__builtin_types_compatible_p` ignores the
# qualifiers on the pointer itself, `char *const` and `restrict`, which bind
# the callee's own copy. On a function pointer `const` has no effect, so the
# question holds and the probe's call says what is wrong with the binding.
function read_only_assertion(asked: pointee_ask.Pointee, header_type: str) -> str
    return "_Static_assert(__builtin_types_compatible_p(" + header_type + ", __typeof__(*(" + header_type + ")0) const *), \"" + WRITABLE_MARKER + asked.name + " " + asked.param + " " + header_type + "\");"

# `out` with the read-only ask's answer, where the header takes a pointer.
function with_read_answer(out: [pointee_ask.Answered], one: pointee_ask.Pointee, written: str, through: str) -> [pointee_ask.Answered]
    pointer = asked_type(written: written, through: through)

    if pointer.is_err()
        return out
    return out.push(pointee_ask.Answered(asked: one, header_type: pointer.must(), pointee: ""))

# The type a `cstr` parameter's question is asked of, from the two spellings
# the pointee check's dump gives it, the header's own (`written`) and the one
# through its typedefs (`through`, empty where they agree); or absent where
# the header takes the parameter by value, where the probe's call is the
# verdict. The header's own spelling is asked, as a lend's other questions
# ask it, since a type spelled through its typedefs can name a struct with
# no name C can write. An ATOMIC pointer (`_Atomic(char *)`) is the one
# exception: C cannot apply `*` to it, so the pointer inside is asked, which
# is what the call converts the argument to.
function asked_type(written: str, through: str) -> str?
    plain: str @ through

    if plain.len() == 0
        plain @ written
    bare = without_leading_qualifiers(plain)

    if bytes.bytes_at(text: bare, at: 0, needle: "_Atomic(") && bytes.bytes_at(text: bare, at: bare.len() - 1, needle: ")")
        inner = ffi_lookup.trimmed(bare.slice(from: 8, to: bare.len() - 1))

        if !ffi_lookup.has(text: inner, needle: "*")
            return fail(code: "none", msg: "an atomic value or a pointer only its typedef spells")
        return ok(inner)

    if !ffi_lookup.has(text: plain, needle: "*")
        return fail(code: "none", msg: "the header takes it by value")
    return ok(written)

# The type without the qualifiers written before it, `const _Atomic(char *)`
# being an atomic pointer that is itself `const`.
function without_leading_qualifiers(text: str) -> str
    kept: str @ ffi_lookup.trimmed(text)
    cut: bool @ true

    while cut
        cut @ false

        for word in ["const ", "volatile "]
            if !cut && bytes.bytes_at(text: kept, at: 0, needle: word)
                kept @ ffi_lookup.trimmed(kept.slice(from: word.len(), to: kept.len()))
                cut @ true

    return kept

# A qualifier written after a pointer's last `*` binds the parameter itself,
# which only the callee sees: the type the call hands its argument to is the
# type without it. So the message names that, as clang's own word for the
# call always did, and reads the same on a libc that writes glibc's `char
# *restrict` as on one that writes `char *`. Asked of the bytes: the text after
# the last `*` is cut only where every word of it is such a qualifier, so `int
# (*)[4]` and a type with no `*` are left whole.
constant TOP_QUALIFIERS: [str]
    [
        "const"
        "volatile"
        "restrict"
        "__restrict"
        "__restrict__"
        "_Nonnull"
        "_Nullable"
        "_Null_unspecified"
        "_Nullable_result"
    ]

function unqualified(text: str) -> str
    kept = ffi_lookup.trimmed(text)
    star: i64 @ kept.len() - 1

    while star >= 0 && !bytes.bytes_at(text: kept, at: star, needle: "*")
        star @ star - 1

    if star < 0
        return kept

    for word in ffi_lookup.words(text: kept.slice(from: star + 1, to: kept.len()))
        qualifier: bool @ false

        for one in TOP_QUALIFIERS
            if one == word
                qualifier @ true

        if !qualifier
            return kept

    return kept.slice(from: 0, to: star + 1)

# DEFECT 078 (panel 176, question 4; landed 2026-09-24 on the sitting's
# provisional resolution, item 8). `owned` on an `@cstr` cell is emitted as
# `char **`, the carve-out above, because the mark says the bytes C writes are
# the program's to free. A header that spells the cell `const char **` says the
# opposite: C hands back bytes it asks the caller not to change, which is how C
# lends (`sqlite3_prepare_v2`'s `pzTail`, and 589 such parameters across the
# headers the ffi seat counted, one of which documents that the caller frees).
# The author's word and the header's disagree, and that is
# `.claude/rules/c-boundary.md`'s class: exit 1, on the declaration, never
# `internal error` at exit 2, which is what clang's `discards qualifiers in
# nested pointer types` became before this. The comparison is on the type text
# clang prints, which is the canonical spelling — a typedef such as
# `cstring_t *` or `const gchar **` arrives here as `const char **`, measured
# on the three spellings panel 176's critic wrote.
function owned_const(name: str, param: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_owned_const_cell",
        message: "`" + param + "` of `" + name + "` is marked `owned`, and the header says `const char **` — C hands back bytes it asks the caller not to change, which is how a C function lends a string, not how it gives one",
        span: span
    )
    d.notes @ d.notes.push(
        "if the library keeps the string, drop `owned` and read the `cstr` while it is valid; if its documentation says the caller frees it anyway, drop `owned` and call the freer yourself on the `cstr` the cell holds"
    )
    return d

## Tests

test "a writable char * names the lent parameter and the owning repair"
    text = "extern \"string.h\"\n    function strtok(target: cstr lent, sep: cstr lent) -> cstr\n\nfunction main()\n    _ = strtok(target: \"a,b\".cstr(), sep: \",\".cstr())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names = ctype.new_names(s, parsed.decls)
    fs = low.program.functions
    f0: containers.Function @ fs[0]
    picked: bool @ false

    for f in fs
        if f.name == "strtok" && !picked
            f0 @ f
            picked @ true

    parameters = extern_probe.parameter_list(names, c, parsed.decls, f0, frees: false).must()
    arguments = extern_probe.argument_names(count: 2)
    probe = extern_probe.probe_name(module: "t", name: "strtok")
    columns = probe_reply.argument_columns(
        probe: probe,
        name: "strtok",
        parameters: parameters,
        arguments: arguments
    )
    line = "t.hero:2:" + columns[0].to_str() + ": warning: passing 'const char *' to parameter of type 'char *' discards qualifiers"
    d = writable_parameter(s, parsed.decls, low.program, c, names, line: line)
    assert d.must().code == "ffi_writable_parameter"
    assert d.must().message == "`target` of `strtok` is declared `cstr`, and the header says `char *` — C does not promise to leave it alone"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "ptr"
    assert d.must().fixes[0].certainty == .guess

    # A line without the qualifier phrase is not this class.
    plain = "t.hero:2:9: error: implicit conversion loses integer precision: 'int64_t' to 'int'"
    assert writable_parameter(s, parsed.decls, low.program, c, names, line: plain).is_err()

    # A caret that misses every argument column still lands, with the
    # parameter unnamed — the rule is the rule, only the name is lost.
    off = "t.hero:2:1: warning: passing 'const char *' to parameter of type 'char *' discards qualifiers"
    k = writable_parameter(s, parsed.decls, low.program, c, names, line: off)
    assert k.must().message == "a parameter of `strtok` is declared `cstr`, and the header says `char *` — C does not promise to leave it alone"

# Defect 411: the pointee check's answer, read off its marker at the author's
# line, names the parameter and the header's type as the call sees it.
test "the header's answer names the parameter and the type the call hands it to (defect 411)"
    text = "extern \"sha.h\"\n    function SHA256_Final(md: cstr lent, n: u64) -> i32\n\nfunction main()\n    print(SHA256_Final(md: \"a\".cstr(), n: 1))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names = ctype.new_names(s, parsed.decls)
    line = "t.hero:2:1: error: static assertion failed due to requirement '__builtin_types_compatible_p(unsigned char *, const unsigned char *)': heroes-ffi-writable SHA256_Final md unsigned char *restrict"
    d = writable_parameter(s, parsed.decls, low.program, c, names, line: line)
    assert d.must().code == "ffi_writable_parameter"
    assert d.must().message == "`md` of `SHA256_Final` is declared `cstr`, and the header says `unsigned char *` — C does not promise to leave it alone"
    assert d.must().fixes[0].replacement == "ptr"
    assert d.must().fixes[0].certainty == .guess

    # clang's echo of the unit's line carries the marker and is no failure; a
    # line at a file this compilation does not own, the library's among them,
    # and a parameter the extern does not have are not the author's.
    echo = "_Static_assert(__builtin_types_compatible_p(unsigned char *, __typeof__(*(unsigned char *)0) const *), \"heroes-ffi-writable SHA256_Final md unsigned char *\");"
    assert writable_parameter(s, parsed.decls, low.program, c, names, line: echo).is_err()
    elsewhere = "<heroes library>:2:1: error: static assertion failed: heroes-ffi-writable SHA256_Final md unsigned char *"
    assert writable_pointee(s, parsed.decls, low.program, c, line: elsewhere).is_err()
    other = "t.hero:2:1: error: static assertion failed: heroes-ffi-writable SHA256_Final key unsigned char *"
    assert writable_pointee(s, parsed.decls, low.program, c, line: other).is_err()

test "the question is asked of the header's own pointer, an atomic one's inner pointer, and nothing by value"
    asked = pointee_ask.Pointee(
        name: "SHA256_Final",
        param: "md",
        index: 0,
        declared: pointee_ask.READ,
        file: "t.hero",
        line: 2,
        depth: false
    )
    assert read_only_assertion(asked, header_type: "unsigned char *") == "_Static_assert(__builtin_types_compatible_p(unsigned char *, __typeof__(*(unsigned char *)0) const *), \"heroes-ffi-writable SHA256_Final md unsigned char *\");"
    assert asked_type(written: "unsigned char *", through: "").must() == "unsigned char *"
    assert asked_type(written: "LPSTR", through: "char *").must() == "LPSTR"
    assert asked_type(written: "cb_t", through: "void (*)(int)").must() == "cb_t"
    assert asked_type(written: "_Atomic(char *)", through: "").must() == "char *"
    assert asked_type(written: "const _Atomic(unsigned char *)", through: "").must() == "unsigned char *"
    assert asked_type(written: "ap", through: "_Atomic(const char *)").must() == "const char *"
    assert asked_type(written: "int", through: "").is_err()
    assert asked_type(written: "struct sv", through: "").is_err()
    assert asked_type(written: "_Atomic(ubuf)", through: "").is_err()
    none: [pointee_ask.Answered] = []
    assert with_read_answer(none, asked, written: "int", through: "").len() == 0
    assert with_read_answer(none, asked, written: "ap", through: "_Atomic(char *)")[0].header_type == "char *"

test "a qualifier after the pointer's last star is the callee's, and nothing else is cut"
    assert unqualified("char *restrict") == "char *"
    assert unqualified("unsigned char *const") == "unsigned char *"
    assert unqualified("char *const restrict") == "char *"
    assert unqualified("char * _Nonnull") == "char *"
    assert unqualified("int (*)[4]") == "int (*)[4]"
    assert unqualified("foo_const") == "foo_const"
    assert unqualified("const LPSTR") == "const LPSTR"
    assert unqualified("漢 *restrict") == "漢 *"
    assert unqualified("restrict") == "restrict"
