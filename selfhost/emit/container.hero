# [T] and {K: V} as C: built through the runtime, read through a
# descriptor, written with ONE UNSHARE PER STEP (design.md §4.9, §4.10;
# panels 022, 062). Port of heroes/src/emit/container.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# One file because they are the same mechanism wearing two names:
# neither is a C aggregate, both are a pointer to a runtime header, and
# every element or pair crosses that boundary BY ADDRESS, copied
# through its HeroDesc — which is what lets one runtime function insert
# a str key and a Point value.
#
# The two rules worth reading before changing anything:
# - Copy-on-write is one unshare per step of a mutated place (panel
#   022, measured). Not one at the primitive — that lets a nested store
#   alias, and every instrument in this project reported success while
#   it did.
# - A map step ends a place walk and an array step does not: m[k] @ v
#   inserts, so there is no element to descend into; xs[i] @ v has one,
#   and descending means unsharing this level first.
#
# What is NOT here: hero_map_find's NULL is the runtime's, and so is
# every abort of an array read, whose words and exit code `hero_array_at`
# and `hero_array_len` keep (`emit/array_read.hero`, defect 389), now with
# the place the program read at (panel 230's R1). A fixed array's bound is
# the compiler's, in `places.subscript` (defect 097). And `xs[i] @ v`, the
# write, is `emit/element_store.hero`'s since 2026-10-26, when its bound
# moved into the program's C and this file stood at §11's 300 lines.

use ast
use source
use check/table
use check/state
use ir/containers
use emit/mangle
use emit/ctype
use emit/descriptors
use emit/storageless
use emit/array_read
use emit/nodebug
use parse
use resolve
use checker
use token

# t4 = hero_array_new(&hero_desc_int, 3); plus one push per element, into
# the array in place. Built by pushing rather than writing the elements
# directly, because the push is where the element's copy runs, and that
# copy is what takes the array's own reference to a counted element.
#
# **One block, sized to the literal, since defect 382** (2026-10-06). The
# pushes were `hero_array_push`, which hands back a NEW array: n+1 blocks for
# n elements, n of them freed, and n(n+1)/2 element copies. A `constant` of an
# array is built at every read, so `K[at % 32]` a million times retired 56.9
# billion instructions. `hero_array_push_owned` is the place store's growth
# (`ir/place_store.hero`): on an array whose count is 1 and whose capacity
# has room it copies the element in where it lies. The array here was made
# one line above with capacity n, and nothing else holds it, so each of the n
# pushes is one copy and the block is never replaced: 4.6 billion
# instructions for the same million reads. The runtime still asks the count
# and the room at each push rather than this line assuming them.
function build_array(c: state.Checked, names: ctype.Names, result: i64, arguments: [str], into: str) -> [str]?
    element: i64 @= 0 - 1

    match table.get(c.types, result)
        .array arr                                                => element @ arr.element
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => element @ element
        .fixed | .map | .fallible | .function_ty | .named         => element @ element
        .case_ty | .failure | .generic | .error                   => element @ element

    if element < 0
        return fail(code: "none", msg: "not an array")
    desc = descriptors.pointer(c, names, ty: element)

    if desc.is_err()
        return fail(code: "none", msg: "no descriptor for the element")
    hint: i64 @= arguments.len()

    if hint < 1
        hint @ 1
    lines: [str] @= [into + " = hero_array_new(" + desc.must() + ", " + hint.to_str() + ");"]

    for value in arguments
        lines @ lines.push("hero_array_push_owned(&" + into + ", &" + value + ");")

    return ok(lines)

# `xs[i]`: a fixed array is subscripted where it lies, and a `[T]` is read
# in place by `emit/array_read.hero`, every failing read handed to the
# runtime with `where`, the place the program read at (defect 389; panel
# 230's R1). The cast is on the RESULT's type, so the element type is stated
# at every read and clang checks the assignment.
function read_element(c: state.Checked, s: source.Source, decls: [ast.Decl], names: ctype.Names, f: containers.Function, base: i64, index: i64, where: str) -> str?
    # A fixed array is no runtime container: it is subscripted directly and
    # guarded by the compiler, and `storageless.element` owns that read.
    fixed = storageless.element(c, s, decls, f, base: base, index: index, where: where)

    if !fixed.is_err()
        return fixed
    element: i64 @= 0 - 1

    match table.get(c.types, containers.value_type(f, base))
        .array arr                                                => element @ arr.element
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => element @ element
        .fixed | .map | .fallible | .function_ty | .named         => element @ element
        .case_ty | .failure | .generic | .error                   => element @ element

    if element < 0
        return fail(code: "none", msg: "not an array")
    spelling = ctype.c_type(names, c: c, ty: element)

    if spelling.is_err()
        return fail(code: "none", msg: "an element with no C type")
    return ok(
        array_read.element(spelling: spelling.must(), base: mangle.value(base), index: mangle.value(index), where: where)
    )

# t5 = hero_map_new(&hero_desc_str, &hero_desc_int, 2); plus one put per
# pair — the arguments alternate key, value, both in by address.
function build_map(c: state.Checked, names: ctype.Names, result: i64, arguments: [str], into: str) -> [str]?
    key: i64 @= 0 - 1
    value_ty: i64 @= 0 - 1

    match table.get(c.types, result)
        .map m =>
            key @ m.key
            value_ty @ m.value
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => key @ key
        .array | .fixed | .fallible | .function_ty | .named       => key @ key
        .case_ty | .failure | .generic | .error                   => key @ key

    if key < 0
        return fail(code: "none", msg: "not a map")
    key_desc = descriptors.pointer(c, names, ty: key)
    value_desc = descriptors.pointer(c, names, ty: value_ty)

    if key_desc.is_err() || value_desc.is_err()
        return fail(code: "none", msg: "a side with no descriptor")
    pairs = arguments.len() / 2
    lines: [str] @= [
        into + " = hero_map_new(" + key_desc.must() + ", " + value_desc.must() + ", " + pairs.to_str() + ");"
    ]
    walk: i64 @= 0

    while walk + 1 < arguments.len()
        lines @ lines.push("hero_map_put(" + into + ", &" + arguments[walk] + ", &" + arguments[walk + 1] + ");")
        walk @ walk + 2

    return ok(lines)

# m[k], which is NOT xs[i]: it yields a V? and cannot abort. The
# runtime hands back the value's address or NULL — it cannot build the
# option, that struct is generated per payload type — so the wrapping
# is here, and the found value is COPIED through its descriptor: the
# map still owns its copy, and the V? needs one of its own.
#
# **THE FOUND PATH WRITES THE OPTION WHOLE BEFORE IT COPIES THE PAYLOAD IN**
# (panel 182's item 3). It wrote `t.tag = INT64_C(0);` and then copied into
# `t.as.ok`, so the option's other bytes (the rest of the union, and the
# padding) kept whatever the prologue left there; with a temporary no longer
# zeroed (`emit/body.hero`) that is indeterminate memory inside a value the IR
# shows as defined whole, and no instrument here sees a part left unwritten.
# The compound literal is the whole write: C zeroes every member it does not
# name. This was the one such site in the emitter, 132 in the seed and 83 in
# the blessed corpus at `ee547b62`; `tests/harness/suite_wholes.hero` pins
# zero.
function map_get(c: state.Checked, names: ctype.Names, f: containers.Function, map_value: i64, key: i64, result: i64, into: str) -> [str]?
    value_ty: i64 @= 0 - 1

    match table.get(c.types, containers.value_type(f, map_value))
        .map m                                                    => value_ty @ m.value
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => value_ty @ value_ty
        .array | .fixed | .fallible | .function_ty | .named       => value_ty @ value_ty
        .case_ty | .failure | .generic | .error                   => value_ty @ value_ty

    if value_ty < 0
        return fail(code: "none", msg: "not a map")
    option = ctype.option_of(names, ty: result)
    lines: [str] @= ["{"]
    lines @ lines.push(
        "  " + nodebug.MARK + "const void *found = hero_map_find(" + mangle.value(map_value) + ", &" + mangle.value(key) + ");"
    )
    lines @ lines.push("  if (found == NULL) {")
    lines @ lines.push("    " + into + " = (" + option + "){.tag = INT64_C(1), .as.err = hero_failure_missing_key()};")
    lines @ lines.push("  } else {")
    lines @ lines.push("    " + into + " = (" + option + "){.tag = INT64_C(0)};")

    # A unit value type has no ok member at all, so the tag is the
    # whole answer.
    if !ctype.c_type(names, c: c, ty: value_ty).is_err()
        desc = descriptors.pointer(c, names, ty: value_ty)

        if desc.is_err()
            return fail(code: "none", msg: "a value with no descriptor")
        lines @ lines.push("    (" + desc.must() + ")->copy(&" + into + ".as.ok, found);")
    lines @ lines.push("  }")
    lines @ lines.push("}")
    return ok(lines)

## Tests

record Setup
    c: state.Checked
    s: source.Source
    decls: [ast.Decl]
    names: ctype.Names

function ready(text: str) -> Setup
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked = checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, p.decls)
    return Setup(c: c, s: s, decls: p.decls, names: names)

test "an array literal is one block and a push in place per element, a read is a cast"
    got = ready("function main()\n    xs = [1, 2]\n    print(xs[0])\n")
    arr = table.lookup(got.c.types, .array(element: table.int_ty_id(got.c.types))).must()
    lines = build_array(got.c, got.names, result: arr, arguments: ["t1", "t2"], into: "t3")
    assert lines.must() == ["t3 = hero_array_new(&hero_desc_int, 2);", "hero_array_push_owned(&t3, &t1);", "hero_array_push_owned(&t3, &t2);"]
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [arr, table.int_ty_id(got.c.types)],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    read = read_element(got.c, got.s, got.decls, got.names, f, base: 0, index: 1, where: "P")
    assert read.must() == "((void)((t0 == NULL || t1 < 0 || t1 >= t0->len) ? hero_panic_index_at(t0, t1, P) : (void)0), (void)(t0->elem->size != sizeof(int64_t) ? hero_unreachable() : (void)0), ((int64_t const *)(const void *)(t0 + 1))[t1])"
