# A value the C type system gives NO STORAGE — today, a fixed array
# (design.md §3.1; panel 062). Port of crates/heroes/src/emit/storageless.rs.
#
# The unit rule's second instance: () is never declared because
# `void t0;` is a hard error; a T[N] is never declared because C has no
# assignable array. Both are real values with no storage, and both are
# rendered where they are used rather than assigned. A third would want
# this module rather than another arm.
#
# The field read keeps the subscript ON AN ARRAY-TYPED LVALUE, and that
# is load-bearing: ASan cannot see an intra-object overflow in a C
# struct at all, so --sanitize's only arm on v.params[i] is UBSan's
# array-bounds — which sees it ONLY while the subscript sits on
# something whose C type is still T[N]. Lower it to pointer arithmetic
# and the sanitiser reports clean while the next field is corrupted.

use ast
use source
use check/table
use check/state
use ir
use ir/containers
use emit/mangle
use emit/aggregate
use token
use parse
use resolve
use checker

# The TEXT of a fixed-array value: the braced literal, or the field
# read, rendered at the use site. Two producers, both here rather than
# at their use sites; a third would be an index into an array of
# arrays, which the checker refuses today.
function fixed_text(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, value: i64) -> str?
    is_fixed: bool @ false

    match table.get(c.types, containers.value_type(f, value))
        .fixed                                                    => is_fixed @ true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_fixed @ is_fixed
        .array | .map | .fallible | .function_ty | .named         => is_fixed @ is_fixed
        .case_ty | .failure | .generic | .error                   => is_fixed @ is_fixed

    if !is_fixed
        return fail("none", "has storage")

    for blk in f.blocks
        for inst in blk.insts
            if !inst.dest.is_err() && inst.dest.must() == value
                match inst.op
                    .construct con =>
                        is_array_shape: bool @ false

                        match con.shape
                            .array_shape                             => is_array_shape @ true
                            .record_shape | .case_shape | .map_shape => is_array_shape @ is_array_shape
                            .ok_shape | .fail_shape | .err_shape     => is_array_shape @ is_array_shape

                        if !is_array_shape
                            return fail("none", "not a producer of a fixed value")
                        parts: [str] @ []

                        for arg in containers.args_of(f, con.arguments)
                            match arg
                                .value_arg v =>
                                    inner = fixed_text(c, s, decls, f, value: v.value)

                                    if inner.is_err()
                                        parts @ parts.push(mangle.value(v.value))
                                    else
                                        parts @ parts.push(inner.must())
                                .inout_arg => continue

                        return ok("{" + parts.join(", ") + "}")
                    .field fl =>
                        owner = containers.value_type(f, fl.base)
                        found = aggregate.field(c, s, decls, owner: owner, index: fl.at)

                        if found.is_err()
                            return fail("none", "not a field of this type")
                        base_text: str @ mangle.value(fl.base)
                        inner = fixed_text(c, s, decls, f, value: fl.base)

                        if !inner.is_err()
                            base_text @ inner.must()
                        return ok(base_text + "." + found.must().member)
                    .lit | .load | .store | .push_owned | .unary | .binary | .cast | .call => return fail(
                        "none",
                        "not a producer of a fixed value"
                    )
                    .index | .map_get | .len_of | .tag_of | .payload => return fail(
                        "none",
                        "not a producer of a fixed value"
                    )
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .hole | .missing => return fail(
                        "none",
                        "not a producer of a fixed value"
                    )

    return fail("none", "no instruction produces this value")

## Tests

test "a fixed literal renders braced at the use site, a field read stays an lvalue"
    text = "extern \"m.h\"\n    record Vec2\n        cells: f32[2]\n\nfunction touch(v: Vec2)\n    _ = v\n\nfunction main()\n    print(1)\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    f32_id = table.lookup(c.types, .float_ty(kind: .f32)).must()
    fixed = table.lookup(c.types, .fixed(element: f32_id, length: 2)).must()
    vec = table.lookup(c.types, .named(decl: 0)).must()
    span = token.Span(start: 0, end: 1)
    run0 = ir.Run(start: 0, length: 2)
    insts: [ir.Inst] = [
        ir.Inst(dest: ok(3), op: .construct(shape: .array_shape, arguments: run0), ty: fixed, span: span)
        ir.Inst(dest: ok(4), op: .field(base: 5, at: 0), ty: fixed, span: span)
    ]
    preds: [i64] = []
    blk = containers.Block(preds: preds, insts: insts, term: .return_term(value: fail("none", "bare")), note: "t")
    f = containers.Function(
        name: "t",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [blk],
        values: [f32_id, f32_id, f32_id, fixed, fixed, vec],
        arguments: [.value_arg(value: 1), .value_arg(value: 2)],
        steps: [],
        instance: [],
        call_instances: {},
        span: span
    )
    braced = fixed_text(c, s, p.decls, f, value: 3)
    assert braced.must() == "{t1, t2}"
    member = fixed_text(c, s, p.decls, f, value: 4)
    assert member.must() == "t5.cells"
    plain = fixed_text(c, s, p.decls, f, value: 0)
    assert plain.is_err()
