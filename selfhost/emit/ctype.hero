# A Heroes type as a C type, and what every declared type is CALLED
# (design.md §3.1; panels 020, 031 R10, 060, 062, 074).
# Port of archive/bootstrap-rs/heroes/src/emit/{ctype,typedefs,typedefs_generated,
# aggregate_name}.rs — one module, because what a type IS and what it
# is NAMED reference each other in Rust and the cycle rule folds them:
# the ninth knot.
#
# THE UNIT RULE. () is a real type in the IR: value 0 is the unit of
# every function, the values table is dense, and the natural way to
# hoist temporaries is to walk that table. Walk it naively and the
# emitter writes `void t0;` — a hard clang error on the first program.
# So a unit-typed temporary is NEVER declared and never named, and the
# fixed array is the rule's second instance (C has no assignable
# array, so a T[N] temporary cannot exist; what exists is the braced
# list at its use site).
#
# THE LEADING DIGIT. The option and function typedefs belong to no
# declaration, so they are named h_0opt_<hash> / h_0fn_<hash> — content
# first (panel 093 R6), and the digit for the same reason as ever:
# until 2026-08-12 they were h_<module>_opt<N>, which a `record opt0`
# in the same module spells exactly — redefinition, exit 2, on a legal
# program. A leading digit closes the collision by construction: 0foo
# is expected_name in the lexer, so there is nothing to collide with
# and no diagnostic to write.
#
# TWO NAMES PER AGGREGATE, and the jobs part inside single format
# strings: `bool {name}_eq(const {name} *a, ...)` needs the first to be
# OURS and the second to be the header's. Unsplit, a record Color in an
# extern group wrote a global unmangled Color_eq beside the library
# that declared Color (panel 060, condition 3).

use ast
use source
use check/table
use check/state
use widths
use ir/containers
use ir/phases
use emit/synth
use emit/mangle
use parse
use resolve
use checker
use ir/lower

# Both names of one aggregate, for the emitters that write a definition
# rather than a mention.
record Aggregate
    # This compiler's mangled name — what _eq, _hash, _desc, _retain
    # and _release are spelled with. Never the header's.
    prefix: str
    # The C type — the header's own spelling for a group's record.
    c_type: str
    # Whether the struct is the HEADER's rather than this compiler's,
    # which decides how its members are spelled as well as what it is
    # called.
    foreign: bool
    # Whether the field list names only SOME of that struct.
    partial: bool

# The C typedef name of every declared aggregate, by declaration index.
# A table rather than a lookup on demand, because a name needs the
# MODULE and the source text, and Checked carries neither. Built once
# per translation unit.
record Names
    aggregates: {i64: str}
    # The prefix the GENERATED functions carry — always mangled,
    # whatever aggregates says.
    satellites: {i64: str}
    foreign_decls: {i64: bool}
    partial_decls: {i64: bool}
    # The C type of each distinct T?, by the id of the whole T?. Named
    # by CONTENT since panel 093 R6 — `h_0opt_<hash of the rendering>` —
    # so the name is a function of the type alone: the same in every
    # translation unit, every build, and every program, which is what a
    # dependency's interface text needs to spell it and what a cached
    # TU must match byte for byte on a clean re-emit.
    options: {i64: str}
    # The C type of one case's payload, keyed "decl:case".
    cases: {str: str}
    # The C typedef of each distinct function type. A typedef and not
    # an inline spelling, because C puts the declarator's name INSIDE
    # the type: int64_t (*f)(int64_t). One typedef keeps the
    # <type> <name> rule everywhere else.
    funcs: {i64: str}

# What separates a name the EMITTER invents from a name an author could
# write: a leading digit.
constant SYNTHETIC: str
    "0"

function case_key(decl: i64, at: i64) -> str
    return decl.to_str() + ":" + at.to_str()

function new_names(s: source.Source, decls: [ast.Decl]) -> Names
    aggregates: {i64: str} @ {}
    satellites: {i64: str} @ {}
    foreign_decls: {i64: bool} @ {}
    partial_decls: {i64: bool} @ {}
    cases: {str: str} @ {}
    index: i64 @ 0

    for decl in decls
        # Each type is named in its OWN module, never the root's: two
        # modules may each declare Point, and they are two C structs.
        name = mangle.ty_name(
            module: source.component_at(s, decl.name.start),
            name: source.span_text(s, decl.name)
        )

        match decl.kind
            .record_decl rec =>
                if rec.partial
                    partial_decls[index] @ true
                satellites[index] @ name

                # A group's record IS the header's struct, so its C type
                # name is the one the author wrote, unmangled — and with
                # `tag` it is two words (panel 074): C keeps struct tags
                # in a namespace of their own, so `struct stat` travels
                # whole through this string and no site has to ask.
                if !rec.header.is_err()
                    foreign_decls[index] @ true

                    if !rec.tag.is_err()
                        aggregates[index] @ "struct " + source.span_text(s, rec.tag.must())
                    else
                        aggregates[index] @ source.span_text(s, decl.name)
                else
                    aggregates[index] @ name
            .variant_decl v =>
                satellites[index] @ name
                at: i64 @ 0

                for one_case in v.cases
                    cases[case_key(decl: index, at: at)] @ mangle.case_type(
                        ty: name,
                        case_name: source.span_text(s, one_case.name)
                    )
                    at @ at + 1

                aggregates[index] @ name
            # NOT `continue`: this loop keeps the declaration index
            # itself, and a `continue` in a match arm jumps to the next
            # iteration — skipping the increment below and shifting
            # every later declaration by one. The class was found
            # 2026-08-17 when the selfhost compiler refused its own
            # parse.hero with a `no_size` cycle that does not exist
            # (check_sized carried the same shape); the self-mutation is
            # this language's no-op.

            .constant_decl | .function_decl | .test_decl => index @ index

        index @ index + 1

    empty_options: {i64: str} = {}
    empty_funcs: {i64: str} = {}
    return Names(
        aggregates: aggregates,
        satellites: satellites,
        foreign_decls: foreign_decls,
        partial_decls: partial_decls,
        options: empty_options,
        cases: cases,
        funcs: empty_funcs
    )

# Assigns a C name to every T? the program interned. Walked over the
# INTERNED ARENA, because a T? reached only through a declared record's
# field is invisible to a walk over the emitted functions — a missing
# name is a hard error, found by the mutant corpus rather than by any
# case somebody wrote. A type that still mentions a parameter has no C
# declaration: the arena keeps the templates' A? after monomorphisation
# deletes the functions that used them.
function with_options(names: Names, c: state.Checked, s: source.Source, decls: [ast.Decl]) -> Names
    out: Names @ names
    count = table.len_of(c.types)
    id: i64 @ 0

    while id < count
        if !phases.mentions_generic(c, ty: id)
            is_fallible: bool @ false

            match table.get(c.types, id)
                .fallible                                                 => is_fallible @ true
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_fallible @ is_fallible
                .array | .fixed | .map | .function_ty | .named            => is_fallible @ is_fallible
                .case_ty | .failure | .generic | .error                   => is_fallible @ is_fallible

            if is_fallible
                # CONTENT-NAMED, not walk-numbered (panel 093 R6): the
                # name is a hash of the type's public rendering, so it is
                # the same in every TU and every build — which is what
                # lets a dependency's interface text name it, and what an
                # index cannot survive (an unrelated edit renumbered
                # `h_toy_0opt1` to `0opt2` on a signature nothing about
                # had changed, measured by the 093 engineer). The module
                # component is dropped for the same reason: `i64?` is the
                # same type whoever mentions it. A hash collision is two
                # C definitions of one name in one TU — loud.
                out.options[id] @ "h_" + SYNTHETIC + "opt_" + mangle.instance(synth.content_key(c, s, decls, ty: id))
        id @ id + 1

    return out

# Assigns a typedef to every function type the program USES AS A TYPE —
# a slot, a temporary, a parameter. Derived from the program, not the
# arena: the checker interns a function type for every top-level
# declaration, so an arena walk would emit a typedef per function in
# the file, almost all named by nothing and none able to fall out of
# --emit-c. CONTENT-NAMED like the options above (panel 093 R6): the
# hash of the type's public rendering, identical in every TU and every
# build, so a dependency's interface can spell it and a clean re-emit
# matches a cached one byte for byte.
function with_functions(names: Names, c: state.Checked, s: source.Source, decls: [ast.Decl], p: containers.Program) -> Names
    out: Names @ names
    used: {i64: bool} @ {}

    for f in p.functions
        for slot in f.slots
            synth.collect(c, ty: slot.ty, into: @used)

        for value in f.values
            synth.collect(c, ty: value, into: @used)

    # ORDER: none — the name is a function of the TYPE's rendering, not
    # of the walk position, since panel 093 R6; the map insertion order
    # no longer reaches the emitted C.
    for id in keys(used)
        out.funcs[id] @ "h_" + SYNTHETIC + "fn_" + mangle.instance(synth.content_key(c, s, decls, ty: id))

    return out

## Reading the table

function func_of(names: Names, ty: i64) -> str
    found = names.funcs[ty]

    # Every function type is named before anything can mention one.
    assert !found.is_err()
    return found.must()

function option_of(names: Names, ty: i64) -> str
    found = names.options[ty]

    # Every T? is named before anything can mention one.
    assert !found.is_err()
    return found.must()

# Every T?, as name plus payload type, in ascending-id order — the
# per-option generated functions walk this, and the key walk IS the
# sort.
record OptionEntry
    name: str
    payload: i64
    # The option's OWN type id — what a per-TU filter asks about
    # (synth.Wanted, panel 093 R2 as tightened by measurement).
    at: i64

function option_entries(names: Names, c: state.Checked) -> [OptionEntry]
    out: [OptionEntry] @ []

    # ORDER: ascending TyId — the per-option generated functions are
    # emitted in this order, so the order is IN the emitted C.
    #
    # sort(keys(…)), NOT keys(…): `keys` gives the keys in NO ORDER and
    # measurably does not — a map with 50, 3, 97, 12 put in answers
    # `97 50 3 12`. Unpaid, this sort put the port's four functions per
    # option in the runtime's bucket order: 20.8 MB of C whose LINES
    # matched the bootstrap's exactly and whose SEQUENCE did not, on
    # 3,330 of 724,197 lines. Measured 2026-08-17, and it was the last
    # thing between the port and the fixpoint — which is why a mark is
    # now checked by an instrument rather than remembered (§4.9).
    for id in sort(keys(names.options))
        match table.get(c.types, id)
            .fallible o                                               => out @ out.push(
                OptionEntry(name: names.options[id].must(), payload: o.payload, at: id)
            )
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => continue
            .array | .fixed | .map | .function_ty | .named            => continue
            .case_ty | .failure | .generic | .error                   => continue

    return out

function case_of(names: Names, decl: i64, at: i64) -> str
    found = names.cases[case_key(decl: decl, at: at)]

    # A case type always names a case of a declared variant.
    assert !found.is_err()
    return found.must()

# The C TYPE name of an aggregate — what a declaration, a parameter or
# a cast writes.
function of(names: Names, decl: i64) -> str
    found = names.aggregates[decl]

    # A named type always names a record or a variant.
    assert !found.is_err()
    return found.must()

# The prefix this aggregate's GENERATED functions carry — always this
# compiler's mangled name, never the header's. Use it wherever the
# string is followed by _eq, _hash, _desc, _retain or _release; use
# `of` wherever it stands as a type. The two differ for exactly one
# kind of declaration, which is what makes picking the wrong one
# silent until a header is involved.
function satellite(names: Names, decl: i64) -> str
    found = names.satellites[decl]
    assert !found.is_err()
    return found.must()

function aggregate(names: Names, decl: i64) -> Aggregate
    return Aggregate(
        prefix: satellite(names, decl: decl),
        c_type: of(names, decl: decl),
        foreign: !names.foreign_decls[decl].is_err(),
        partial: !names.partial_decls[decl].is_err()
    )

# A generated payload type is this compiler's own invention, so both
# names are the same one — stated rather than left implicit, because
# the pair exists precisely where that is false.
function generated(name: str) -> Aggregate
    return Aggregate(prefix: name, c_type: name, foreign: false, partial: false)

# The prefix whose _eq/_retain/_release/_hash serve this TYPE — the
# satellite for a declared aggregate, the option's own name for a T?,
# the runtime's for a failure. Absent where no generated function
# exists, which the gate has already refused.
function satellite_name(names: Names, c: state.Checked, ty: i64) -> str?
    match table.get(c.types, ty)
        .named n                                                  => return ok(satellite(names, decl: n.decl))
        .case_ty vc                                               => return ok(case_of(names, decl: vc.decl, at: vc.at))
        .fallible                                                 => return ok(option_of(names, ty: ty))
        .failure                                                  => return ok("hero_failure")
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return fail("none", "no generated functions")
        .array | .fixed | .map | .function_ty | .generic | .error => return fail("none", "no generated functions")

    return fail("none", "unreached")

## What a type IS in C

# The C type, or absent for () — which has no declaration — and for a
# fixed array, the unit rule's second instance.
function c_type(names: Names, c: state.Checked, ty: i64) -> str?
    match table.get(c.types, ty)
        .unit        => return fail("none", "a unit-typed temporary is never declared")
        .fixed       => return fail("none", "C has no assignable array")
        .int_ty ik   => return ok(widths.int_c_type(ik.kind))
        .float_ty fk => return ok(widths.float_c_type(fk.kind))
        .bool        => return ok("bool")
        # A fat pointer, passed BY VALUE (§4.20): written as a pointer,
        # the wrong str->cstr conversion compiles clean with an explicit
        # cast and hands a refcount word to sqlite3_open; written by
        # value it is inexpressible rather than wrong.

        .str  => return ok("HeroStr")
        .ptr  => return ok("void *")
        .cstr => return ok("const char *")
        # A record is a C struct BY VALUE and a variant a tagged union
        # by value. A case is not a type of its own at runtime — it is
        # the whole variant with a known tag — but its PAYLOAD is,
        # because the IR puts one in a temporary.

        .named n    => return ok(of(names, decl: n.decl))
        .case_ty vc => return ok(case_of(names, decl: vc.decl, at: vc.at))
        # One pointer, whatever it holds — which is what gives a
        # recursive type a finite size and makes an array field impose
        # no ordering constraint on C.

        .array    => return ok("HeroArrayHeader *")
        .fallible => return ok(option_of(names, ty: ty))
        .failure  => return ok("HeroFailure")
        .map      => return ok("HeroMapHeader *")
        # A C function pointer and nothing more — no captured
        # environment, because v1 has no closures. A Heroes function
        # value and a C callback are the same eight bytes, which is
        # what makes qsort and every raylib callback expressible.

        .function_ty => return ok(func_of(names, ty: ty))
        # The two the checker keeps for its own bookkeeping: a generic
        # here means monomorphisation left a parameter behind; an error
        # means a checker path answered error_ty WITHOUT a diagnostic
        # (§4.5's poison). Both were a bare `assert false` — defect 006 —
        # and ir/phases.hero refuses both first, at exit 2, with names.

        .generic => return ok(compiler_bug("a type parameter survived monomorphisation"))
        .error   => return ok(compiler_bug("a type the checker never resolved reached the emitter"))

    return fail("none", "unreached")

# `.must()` on a failure is the one worded stop this module can reach, and
# it must happen HERE: `c_result` maps any returned failure to `void`.
function compiler_bug(what: str) -> str
    bug: str? = fail("compiler bug", what + " — ir/phases.hero should have refused this program first")
    return bug.must()

# The type a FUNCTION returns, in C. Unit is void — the one place the
# absence of a type has a spelling.
function c_result(names: Names, c: state.Checked, ty: i64) -> str
    found = c_type(names, c: c, ty: ty)

    if found.is_err()
        return "void"
    return found.must()

function is_unit(c: state.Checked, ty: i64) -> bool
    return ty == table.unit_ty(c.types)

## Tests

function named_up(text: str) -> Names
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(p.tree, out, c, s, p.decls)
    names = new_names(s, p.decls)
    names2 = with_options(names, c: c, s: s, decls: p.decls)
    return with_functions(names2, c: c, s: s, decls: p.decls, p: low.program)

test "a group's record keeps the header's spelling, satellites stay ours"
    text = "extern \"m.h\"\n    record Color\n        r: i64\n\nrecord Point\n    x: i64\n\nfunction f(p: Point, c: Color) -> i64\n    return p.x + c.r\n"
    names = named_up(text)
    assert of(names, decl: 0) == "Color"
    assert satellite(names, decl: 0) == "h_t_Color"
    assert of(names, decl: 1) == "h_t_Point"
    both = aggregate(names, decl: 0)
    assert both.foreign
    assert !both.partial

test "options and function typedefs carry the leading digit"
    text = "function pick(ready: bool) -> i64?\n    if ready\n        return ok(1)\n    return fail(\"e\", \"m\")\n\nfunction apply_twice(f: (function(i64) -> i64), x: i64) -> i64\n    return f(f(x))\n\nfunction main()\n    print(pick(true).default(0))\n    print(apply_twice(double_it, 3))\n\nfunction double_it(n: i64) -> i64\n    return n * 2\n"
    names = named_up(text)
    found_opt: bool @ false

    for id in keys(names.options)
        if names.options[id].must() == "h_0opt_e201354"
            found_opt @ true

    assert found_opt
    found_fn: bool @ false

    for id in keys(names.funcs)
        if names.funcs[id].must() == "h_0fn_48ac9712"
            found_fn @ true

    assert found_fn

test "the unit rule: no C type for unit or fixed, void only as a result"
    text = "function f()\n    print(1)\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    names = new_names(s, p.decls)
    unit_id = table.unit_ty(c.types)
    assert c_type(names, c: c, ty: unit_id).is_err()
    assert c_result(names, c: c, ty: unit_id) == "void"
    assert c_type(names, c: c, ty: table.int_ty_id(c.types)).must() == "int64_t"
    assert c_type(names, c: c, ty: table.str_ty(c.types)).must() == "HeroStr"

# A fixed defect gets a case named after it (CLAUDE.md §9). Symptom:
# in any file declaring a function BEFORE a record, every later
# declaration's C type landed in the table under the previous
# declaration's index — so `of(names, decl:)` answered with the wrong
# name and a record could be emitted under a neighbour's typedef.
# Cause: `.function_decl => continue` skipped the walk's own index
# increment. Found 2026-08-17, one file over from check_sized's twin.
test "fixedbugs: a function before the records does not shift the table"
    text = "function first() -> i64\n    return 1\n\nrecord Point\n    x: i64\n\nrecord Size\n    w: i64\n\nfunction touch(p: Point, z: Size)\n    _ = p\n    _ = z\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    names = new_names(s, parsed.decls)

    # Point is declaration 1 and Size is 2 — each named for itself.
    assert of(names, decl: 1) == "h_t_Point"
    assert of(names, decl: 2) == "h_t_Size"
