# The half of §4.19 that asks whether a header's type is a UNION, and
# stops the two operations that would answer wrongly (panels 073, 077).
# Port of archive/bootstrap-rs/heroes/src/emit/extern_union.rs.
#
# A C union gives every member the same address. Bound as a record,
# construction writes every field into one place and C's last
# initialiser wins — UDef(i: 1, f: 1.0) printed 1065353216, the bits of
# 1.0f, at exit 0 — and the generated eq and hash read the same bytes
# twice under two types. READING IS NOT ONE OF THEM and this file must
# not touch it: panel 073 compiled three SDL3 programs that read a
# union's members, all correct, and the four-arm event loop is what a
# binding to SDL_Event actually looks like.
#
# The predicate asks C what the type IS: __builtin_classify_type
# answers 13 for a union and 12 for a struct, in an unevaluated
# operand, against the real header. Panel 073 shipped sizeof(T) >= the
# fields' sum and panel 077 refuted it three hours later on the case
# the sitting was about: a PADDED union has room, and SDL_Event is a
# padded union. The sum form is also blind at one declared field —
# the shape a binding to a single arm actually has.
#
# A premise-death control ships with it (CLAUDE.md §11): clang
# answered 12 for unions before 2019, so two assertions state the
# 13/12 split directly and a toolchain regression becomes a build
# failure rather than a silence.
#
# **Comparing one is panel 186's R3 since 2026-10-02**, one rule for a union
# wherever it sits: `==`, `hash` and a map key are refused for a record whose
# declared field lies in a union, unless that field is an integer, a pointer
# or an array of them as wide as the union. For a union TYPE the union is T
# itself, so the width is `sizeof(T)` and the rule is one assertion per
# field; a union inside a struct is `emit/layout_compare.hero`'s, from the
# header's layout. Until that day a union type was refused at any arity
# (panel 077), which refused `U { int32_t i; float f; }` compared by `i`:
# every value of `U` is a value of `i`, bit for bit.

use ast
use token
use source
use check/table
use check/state
use ir/containers
use emit/ctype
use emit/writer
use emit/layout_compare
use parse
use resolve
use checker
use ir/lower

# The marker the assertion carries, so the error mapper recognises one
# of ours in clang's output without matching prose. One writer, one
# reader — the contract FIELD_ASSERTION already keeps.
constant UNION_ASSERTION: str
    "heroes-ffi-union"

# A compared union type's field that is not compared bit for bit, and one
# that is but is narrower than the union (R3).
constant UNION_KIND: str
    "heroes-ffi-union-kind"

constant UNION_NARROW: str
    "heroes-ffi-union-narrow"

# What the program does to each extern record, split the way the rule
# splits: a construction is asked where it names two or more fields (one
# named field is the SOUND binding to one arm, and C zeroes the rest);
# ==, hash and a map key are asked at ANY arity (R3), because one
# declared member still reads one arm's bytes out of a value that may
# hold another.
record Used
    operated: {i64: bool}
    # Each construction of a group's record, with the fields it names: a
    # record over a C union is built naming exactly one member of each union
    # (panel 186 R7, spec § 13), and which fields a construction may leave
    # out is asked of C at its own line (`emit/layout_sites.hero`).
    sites: [Site]

# One construction: the record, the declared indices of the fields it
# names in the order written, and where it was written.
record Site
    decl: i64
    given: [i64]
    span: token.Span

# One assertion per extern record the program constructs or compares.
#
# ORDER: ascending declaration index, three times — the assertions land in
# the emitted C in this order, so an unsorted walk is a different program's
# bytes for the same source. The Rust BTreeMap gave it free; the port pays
# with one `sort` per walk (design.md §4.9).
function union_assertions(@w: writer.Writer, p: containers.Program, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    u = used(p, c, decls)
    wanted: {i64: bool} @ {}

    for site in u.sites
        if site.given.len() >= 2
            wanted[site.decl] @ true

    for decl in sort(keys(u.operated))
        wanted[decl] @ true

    wrote: bool @ false

    for decl in sort(keys(wanted))
        match decls[decl].kind
            .record_decl rec =>
                if rec.header.is_err()
                    continue
                c_type = ctype.of(names, decl: decl)
                not_union = "__builtin_classify_type(*(" + c_type + " *)0) != 13"

                # The marker carries the DECLARATION's name, never
                # c_type — panel 072 rider 1, which the bootstrap file
                # broke on the day it was written, one file over from
                # where that defect was fixed. With tag, c_type is two
                # words, and the mapper reads token 1 as the name.
                hero_name = source.span_text(s, decls[decl].name)
                parts: [str] @ []

                for field in rec.fields
                    parts @ parts.push(source.span_text(s, field.name))

                # #line at the declaration's own name: unlike a field
                # assertion, no one field is at fault — what the author
                # must change is the declaration or the expression that
                # builds it.
                found = source.source_line(s, decls[decl].name.start)
                writer.at_file(@w, file: found.file, at: found.line)

                # Built from two or more fields: C keeps the last one written.
                if built_from_two(u, decl: decl)
                    writer.line(
                        @w,
                        text: "_Static_assert(" + not_union + ", \"" + UNION_ASSERTION + " " + hero_name + " " + parts.join(" ") + "\");"
                    )
                    wrote @ true

                # Compared, hashed or a map key (R3): each declared field
                # compares bit for bit and is as wide as the union, or the
                # walk reads bytes that may hold another member. A handle
                # has no field and is C's pointer, which is never a union.
                if !u.operated[decl].is_err() && rec.fields.len() == 0
                    writer.line(
                        @w,
                        text: "_Static_assert(" + not_union + ", \"" + UNION_ASSERTION + " " + hero_name + " \");"
                    )
                    wrote @ true

                if !u.operated[decl].is_err()
                    for field in rec.fields
                        name = source.span_text(s, field.name)
                        written = state.written_type(c, field.ty)
                        holds: str @ not_union
                        marker: str @ UNION_KIND

                        if !written.is_err() && layout_compare.compares_bitwise(c, decls, ty: written.must())
                            holds @ not_union + " || sizeof(((" + c_type + " *)0)->" + name + ") == sizeof(" + c_type + ")"
                            marker @ UNION_NARROW
                        writer.line(
                            @w,
                            text: "_Static_assert(" + holds + ", \"" + marker + " " + hero_name + " " + name + "\");"
                        )
                        wrote @ true
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    if wrote
        writer.at_generated(@w)

        # The control that fires when the premise dies: without these
        # two lines a toolchain that stops separating 12 from 13 turns
        # every union check above into one that silently passes; with
        # them it is a build failure that names what depends on it.
        writer.line(
            @w,
            text: "_Static_assert(__builtin_classify_type(*(union { int a; float b; } *)0) == 13, \"a union must classify as 13, or every heroes-ffi-union assertion above is vacuous\");"
        )
        writer.line(
            @w,
            text: "_Static_assert(__builtin_classify_type(*(struct { int a; float b; } *)0) == 12, \"a struct must classify as 12, or every heroes-ffi-union assertion above refuses every record\");"
        )
        writer.blank(@w)

# Whether a construction names two or more fields of record `decl`.
function built_from_two(u: Used, decl: i64) -> bool
    for site in u.sites
        if site.decl == decl && site.given.len() >= 2
            return true

    return false

# Whether a construction of record `decl`, of `count` declared fields, leaves
# one out (panel 186 R7): `emit/layout_screen.hero` sends the record to the
# header's layout, and `emit/layout_sites.hero` asks C, per construction,
# whether each field left out shares a byte with one it names.
function omits(u: Used, decl: i64, count: i64) -> bool
    for site in u.sites
        if site.decl == decl && site.given.len() < count
            return true

    return false

# Every extern record the program constructs or compares, directly or
# through a type that contains one. The reach is not decoration: == on
# a Heroes record calls its generated eq, which calls its fields', so
# a union one level down is compared by the same wrong walk. Panel 061
# established the same transitivity for partial; this is that rule one
# type over. And a map key hashes: refusing == while hash stays
# reachable is WORSE than refusing neither, because the wrong answer
# moves from a comparison the author wrote to a bucket they never see.
function used(p: containers.Program, c: state.Checked, decls: [ast.Decl]) -> Used
    operated: {i64: bool} @ {}
    sites: [Site] @ []

    # One set of walked types for every `reach` below (defect 229).
    seen: {i64: bool} @ {}

    for f in p.functions
        for blk in f.blocks
            for inst in blk.insts
                match inst.op
                    .construct co =>
                        match co.shape
                            .record_shape r =>
                                if group_record(decls, decl: r.decl)
                                    sites @ sites.push(Site(decl: r.decl, given: r.given, span: inst.span))
                            .map_shape => reach(out: @operated, seen: @seen, c, decls, ty: inst.ty)
                            .case_shape | .array_shape | .ok_shape | .fail_shape | .err_shape => continue
                    .binary b =>
                        if b.op == .eq || b.op == .ne
                            reach(out: @operated, seen: @seen, c, decls, ty: containers.value_type(f, b.left))
                    .map_get mg =>
                        reach(out: @operated, seen: @seen, c, decls, ty: containers.value_type(f, mg.map))
                        reach(out: @operated, seen: @seen, c, decls, ty: containers.value_type(f, mg.key))
                    .lit | .load | .store | .push_owned | .unary | .cast | .call | .func_ref    => continue
                    .field | .index | .len_of | .tag_of | .payload                              => continue
                    .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

    return Used(operated: operated, sites: sites)

# Whether `decl` is a record of an `extern` group, the only kind a
# construction may build naming some of its fields.
function group_record(decls: [ast.Decl], decl: i64) -> bool
    match decls[decl].kind
        .record_decl rec                                             => return !rec.header.is_err()
        .constant_decl | .function_decl | .variant_decl | .test_decl => return false

    return false

# The extern records a type reaches by value: a SET, which the caller
# reads sorted, so the order the queue drains in reaches nothing.
#
# **TOTAL SINCE DEFECT 140 (2026-10-01).** It stopped at `depth > 16`,
# saying it was bounded like the checker's partial walk and that a nest of
# extern records sixteen deep does not exist. The partial walk lost its
# bound to defect 046 on 2026-09-16, and the nest needs no extern record
# but the last: `==` over a value holding a union sixteen PLAIN records
# down was built, measured, and printed `true`, the generated eq reading
# the union's bytes under two types, where fifteen down was refused. A set
# of the type ids walked makes it total, and a cyclic generic the old
# comment feared ends there too, since every id is entered once.
#
# `seen` is the CALLER's, one for all its calls (defect 229, 2026-10-03):
# each call drains its queue, so a type walked before has already put every
# record it reaches in `out`, and walking it again for each of 2,000 nested
# map literals cost 4 million steps.
function reach(@out: {i64: bool}, @seen: {i64: bool}, c: state.Checked, decls: [ast.Decl], ty: i64)
    queue: [i64] @ [ty]
    next: i64 @ 0

    while next < queue.len()
        at = queue[next]
        next @ next + 1

        if !seen[at].is_err()
            continue
        seen[at] @ true

        match table.get(c.types, at)
            .named n =>
                out[n.decl] @ true

                match decls[n.decl].kind
                    .record_decl rec =>
                        for field in rec.fields
                            written = state.written_type(c, field.ty)

                            if !written.is_err()
                                queue @ queue.push(written.must())
                    # **A VARIANT'S CASES ARE A ROUTE TOO** (2026-10-01,
                    # found beside defect 140). This arm stopped at a variant,
                    # so `==` over a variant whose case holds a union was
                    # built and printed `true`, and a map keyed by one was
                    # built, the generated eq and hash calling the payload's:
                    # the transitivity this file's `used` states, missed at
                    # the one kind `check/partial.hero` names as what a list
                    # of container kinds would miss.
                    .variant_decl v =>
                        for one_case in v.cases
                            for field in one_case.fields
                                written = state.written_type(c, field.ty)

                                if !written.is_err()
                                    queue @ queue.push(written.must())
                    .constant_decl | .function_decl | .test_decl => continue
            .array a     => queue @ queue.push(a.element)
            .fixed x     => queue @ queue.push(x.element)
            .fallible fl => queue @ queue.push(fl.payload)
            .map m =>
                queue @ queue.push(m.key)
                queue @ queue.push(m.value)
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => continue
            .function_ty | .case_ty | .failure | .generic | .error    => continue

## Tests

function has(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false

test "constructed and compared records are asked, read-only ones are not"
    text = "extern \"m.h\"\n    record UDef\n        i: i64\n        f: i64\n    record Cmp\n        a: i64\n    record ReadOnly\n        x: i64\n\nfunction touch(r: ReadOnly) -> i64\n    return r.x\n\nfunction main()\n    u = UDef(i: 1, f: 2)\n    print(u.i)\n    c1 = Cmp(a: 1)\n    c2 = Cmp(a: 2)\n    if c1 == c2\n        print(0)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names = ctype.new_names(s, parsed.decls)
    w: writer.Writer @ writer.new_writer("t")
    union_assertions(@w, low.program, c, names, s, parsed.decls)
    got = writer.finish(w)

    # Two-field construction is asked, on the declaration's own line.
    assert has(
        text: got,
        needle: "_Static_assert(__builtin_classify_type(*(UDef *)0) != 13, \"heroes-ffi-union UDef i f\");"
    )
    assert has(text: got, needle: "#line 2 \"t.hero\"")

    # == reaches Cmp at arity one, asked whether its integer is as wide as
    # the union (R3); a read-only record is left alone.
    assert has(
        text: got,
        needle: "_Static_assert(__builtin_classify_type(*(Cmp *)0) != 13 || sizeof(((Cmp *)0)->a) == sizeof(Cmp), \"heroes-ffi-union-narrow Cmp a\");"
    )
    assert !has(text: got, needle: "ReadOnly")

    # The premise-death pair rides along whenever anything was asked.
    assert has(text: got, needle: "a union must classify as 13")
    assert has(text: got, needle: "a struct must classify as 12")
