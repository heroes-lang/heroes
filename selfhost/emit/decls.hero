# One translation unit's skeleton: the prelude, which functions reach
# C, live strings, and the two int main shims (design.md §3.1, §4.18;
# panels 020, 034, 038). Port of crates/heroes/src/emit/{decls,main}.rs.
#
# DECLARATION ORDERING is the emitter's first obligation: Heroes' top
# level is order-free with free mutual recursion, C's is not — so every
# prototype is emitted before every definition, in source order.
#
# The _Static_assert is not decoration: a decoy runtime/ compiled with
# zero warnings under -Weverything and printed 0x1e where 30 was
# expected; with the stamp the same C is `use of undeclared identifier`.
# What the stamp catches is version skew — a decoy that copies the
# number passes, and the CACHE KEY is what guards contents (CLAUDE.md §7).
#
# A SHIM, NOT A MANGLER EXCEPTION: Heroes' main becomes h_<module>_main
# like every other function, and a separate int main calls it (Vala
# does exactly this; Zig's C backend once emitted void main, which
# clang rejects). The only two functions whose name C chose, which is
# why the runtime's bookkeeping lives there: hero_args_set on the way
# in, hero_runtime_check_leaks on the way out — ASan's leak detector
# does not exist on this platform, measured, a 999-block leak exiting 0
# in silence.
#
# The prelude's extern block landed with the FFI crossing: headers
# (angled, never quoted — panel 036's decoy measurement), the record
# field assertions before the signatures that pass one, the union
# predicate, then the return assertions. The PROBE was the fourth of
# them until panel 111 R4 and now follows the typedefs instead, in the
# two emitters — the reason is at its call below.

use ast
use source
use check/state
use ir/containers
use emit/mangle
use emit/ctype
use emit/builtins
use emit/externs as emit_externs
use emit/extern_record
use emit/extern_union
use emit/extern_assert
use emit/writer
use parse
use resolve
use checker
use ir/lower

# Whether this function reaches C at all. A test block does not:
# ordinary builds ignore it, and `heroes test` is what enters it.
variant BuildTarget
    program_build
    tests_build

function emitted(f: containers.Function, target: BuildTarget) -> bool
    match f.kind
        .function_kind | .constant_kind => return true
        .test_kind =>
            match target
                .tests_build   => return true
                .program_build => return false
        .extern_kind => return false

    return false

# The header every generated file opens with.
function prelude(@w: writer.Writer, p: containers.Program, target: BuildTarget, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], version: str, tu_local: str)
    writer.line(@w, text: "/* Generated by heroes " + version + " from " + s.name + ". Do not edit. */")
    writer.line(@w, text: "#include \"heroes_runtime.h\"")

    # §4.19: every header a group named, in declaration order. ANGLED,
    # NEVER QUOTED — panel 036 measured what the quoted form costs: a
    # decoy sqlite3.h beside the generated unit is read with zero
    # diagnostics under -Weverything, and no _Static_assert can be
    # written against a header this compiler does not own.
    for header in emit_externs.headers(p, s, decls)
        writer.line(@w, text: "#include <" + header + ">")

    writer.line(@w, text: "")
    writer.line(@w, text: "_Static_assert(HERO_RUNTIME_ABI == 21, \"heroes_runtime.h is from another compiler\");")

    # What a per-type function and a monomorphised instance are LINKED
    # as. One fused unit needs no linkage word; a per-module unit
    # (panel 093 R2) defines its own copies of both, so there the same
    # sections are compiled under `static` — the macro is the one knob,
    # and the fused unit defining it empty keeps the two paths one
    # printer (HERO_STR_STATIC's own precedent).
    macro_line: str @ "#define HERO_TU_LOCAL"

    if tu_local.len() > 0
        macro_line @ macro_line + " " + tu_local
    writer.line(@w, text: macro_line)

    # The quiet knob rides the same mode: a per-module unit defines
    # every descriptor whether its own code points at one (the option
    # satellites are whole-program text, so their references must
    # always resolve), and the attribute is what keeps the unused
    # copies out of -Wunused-const-variable's mouth. The fused unit
    # keeps its reach trim and defines this empty.
    quiet_line: str @ "#define HERO_TU_QUIET"

    if tu_local.len() > 0
        quiet_line @ quiet_line + " __attribute__((unused))"
    writer.line(@w, text: quiet_line)
    writer.line(@w, text: "")

    # The struct's fields before the signatures that pass one, so a
    # reader of the emitted unit meets the layout claim before the
    # call that depends on it — then the union predicate and the return
    # assertions. All three are _Static_asserts over the header's own
    # names, so they need the #includes above and nothing this file
    # writes later.
    #
    # The PROBE used to be the fourth line here and is not one any more
    # (panel 111 R4). It is a static FUNCTION whose parameters are the
    # declared types, so unlike the three above it can name a typedef
    # this compiler invents — and the typedefs are emitted after the
    # prelude, under emit.hero's own invariant "types before anything
    # that can mention one". A function-typed parameter is the first
    # boundary type that reaches for one, and it arrived as `unknown
    # type name 'h_0fn_294870dd'` at exit 2 on a correct binding. Both
    # emitters now call extern_probes after typeorder.definitions, which
    # is the rule already written down rather than a new one.
    extern_record.extern_record_assertions(@w, c, names, s, decls)
    extern_union.union_assertions(@w, p, c, names, s, decls)
    extern_assert.extern_assertions(@w, p, c, names, s, decls)

    # Every decoded literal an EMITTED function actually reads —
    # reachability, not the whole table: program.strings holds every
    # literal in the file, including ones only a test block mentions,
    # and emitting those is -Wunused-const-variable noise on every
    # build. The NAME is a function of the literal alone — its content
    # hash — so --emit-c stays stable when a test block is added, and a
    # TU's text stays stable when another module's literals move.

    live = live_strings(p, target: target, s: s, prune_library: tu_local.len() == 0)
    any_live: bool @ false
    defined: {str: bool} @ {}
    index: i64 @ 0

    for text in p.strings
        if !live[index].is_err()
            # CONTENT-NAMED (panel 093 R6), and deduplicated by that
            # name: two mentions of one text are one static, where the
            # old program-wide index shifted whenever an earlier module
            # gained a literal.
            name = "hero_str_" + mangle.instance(text)

            if defined[name].is_err()
                defined[name] @ true
                writer.line(@w, text: "HERO_STR_STATIC(" + name + ", \"" + escape_c(text) + "\");")
                any_live @ true
        index @ index + 1

    if any_live
        writer.line(@w, text: "")

# Which string literals an emitted function reads — the SAME set the
# definitions walk emits, and it has to be: a library function the
# program never reaches is dropped there, so counting its literals
# here left them defined and unreferenced (invisible until the first
# library functions with strings in them arrived).
# `prune_library` is the fused unit's rule — drop the library functions
# the program never reaches. A per-module unit passes false: its
# function list is already exactly the TU's members, and the fused
# prune read against that slice answered "nothing is used" and left
# every library string undefined under the bodies that read them
# (the first per-module build of the library TU, 2026-08-25).
function live_strings(p: containers.Program, target: BuildTarget, s: source.Source, prune_library: bool) -> {i64: bool}
    used = builtins.reachable(p, s)
    live: {i64: bool} @ {}

    for f in p.functions
        if !emitted(f, target: target)
            continue

        if prune_library && source.is_library(s, f.span.start) && used[f.decl].is_err()
            continue

        for blk in f.blocks
            for inst in blk.insts
                match inst.op
                    .lit lt =>
                        match lt.value
                            .str_const sc                                       => live[sc.at] @ true
                            .int_const | .float_const | .bool_const | .null_ptr => continue
                    .load | .store | .push_owned | .unary | .binary | .cast | .call | .construct            => continue
                    .field | .index | .map_get | .len_of | .tag_of | .payload                               => continue
                    .func_ref | .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

    return live

# A decoded Heroes string, as a C string literal. Octal escapes for
# everything non-printable, because \xNN in C has no length limit and
# would swallow a following hex digit.
function escape_c(text: str) -> str
    out: str @ ""
    i: i64 @ 0

    while i < text.len()
        byte = text[i]

        if byte == '"'
            out @ out + "\\\""
        else if byte == '\\'
            out @ out + "\\\\"
        else if byte == '\n'
            out @ out + "\\n"
        else if byte == '\t'
            out @ out + "\\t"
        else if byte >= ' ' && byte <= '~'
            out @ out + text.slice(from: i, to: i + 1)
        else
            out @ out + "\\" + octal3(byte.to_i64().must())
        i @ i + 1

    return out

function octal3(code: i64) -> str
    digits = "01234567"
    first = code / 64
    second = code / 8 % 8
    third = code % 8
    return digits.slice(from: first, to: first + 1) + digits.slice(from: second, to: second + 1) + digits.slice(from: third, to: third + 1)

## The two int main shims

# One process per test: an assert is a panic, so a runner that called
# tests in sequence would stop at the first failure and hide every
# test after it. heroes test compiles once and executes once per test.
# No title reaches the C: the index is the whole protocol. The switch
# is the one place the test's POSITION (the protocol) and its
# DECLARATION index (the unique name) meet.
function test_shim(@w: writer.Writer, p: containers.Program, s: source.Source)
    writer.blank(@w)
    writer.at_generated(@w)
    writer.line(@w, text: "int main(int argc, char **argv) {")
    writer.line(@w, text: "    hero_args_set(argc, argv);")
    writer.line(@w, text: "    int64_t which = hero_test_index(argc, argv);")
    writer.line(@w, text: "    switch (which) {")
    position: i64 @ 0

    for f in p.functions
        is_test: bool @ false

        match f.kind
            .test_kind                                     => is_test @ true
            .function_kind | .constant_kind | .extern_kind => is_test @ is_test

        if is_test && !source.is_library(s, f.span.start)
            writer.line(@w, text: "    case " + position.to_str() + ":")
            writer.line(
                @w,
                text: "        " + mangle.test_name(module: source.component_at(s, f.span.start), index: f.decl) + "();"
            )
            writer.line(@w, text: "        break;")
            position @ position + 1

    writer.line(@w, text: "    default:")
    writer.line(@w, text: "        hero_panic(\"no test with that index — this is a compiler bug\");")
    writer.line(@w, text: "    }")
    writer.line(@w, text: "    hero_runtime_check_leaks();")
    writer.line(@w, text: "    return 0;")
    writer.line(@w, text: "}")

# The program's shim. argc/argv ALWAYS, whether or not the program
# calls args(): two shims chosen by reachability would be a condition
# that can be wrong, and the parameters cost nothing.
function shim(@w: writer.Writer, f: containers.Function, s: source.Source)
    writer.blank(@w)
    writer.at_generated(@w)
    writer.line(@w, text: "int main(int argc, char **argv) {")
    writer.line(@w, text: "    hero_args_set(argc, argv);")
    writer.line(
        @w,
        text: "    " + mangle.function_name(module: source.component_at(s, f.span.start), name: f.name) + "();"
    )
    writer.line(@w, text: "    hero_runtime_check_leaks();")
    writer.line(@w, text: "    return 0;")
    writer.line(@w, text: "}")

## Tests

# By CHARACTERS, not bytes: the emitted C carries an em-dash in one
# panic message, and a byte-offset slice mid-character is a refused
# split.
function has(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false

test "the prelude stamps the ABI and emits only the strings a build reads"
    text = "function main()\n    print(\"run me\")\n\ntest \"quiet\"\n    assert \"only tests\" != \"\"\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    w: writer.Writer @ writer.new_writer("t")
    names = ctype.new_names(s, parsed.decls)
    prelude(
        @w,
        low.program,
        target: .program_build,
        c: c,
        names: names,
        s: s,
        decls: parsed.decls,
        version: "0.1.0",
        tu_local: ""
    )
    got = writer.finish(w)
    assert has(text: got, needle: "_Static_assert(HERO_RUNTIME_ABI == 21")
    assert has(text: got, needle: "run me")

    # The test block's literal is invisible to a program build — and
    # the surviving index is the literal's own, not a renumbering.
    assert !has(text: got, needle: "only tests")
    tw: writer.Writer @ writer.new_writer("t")
    prelude(
        @tw,
        low.program,
        target: .tests_build,
        c: c,
        names: names,
        s: s,
        decls: parsed.decls,
        version: "0.1.0",
        tu_local: ""
    )
    test_text = writer.finish(tw)
    assert has(text: test_text, needle: "only tests")

test "the shim calls the mangled main and gates leaks on the way out"
    text = "function main()\n    print(1)\n\ntest \"one\"\n    assert 1 == 1\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    w: writer.Writer @ writer.new_writer("t")
    shim(@w, low.program.functions[0], s)
    got = writer.finish(w)
    assert has(text: got, needle: "int main(int argc, char **argv) {")
    assert has(text: got, needle: "    hero_args_set(argc, argv);")
    assert has(text: got, needle: "    h_t_main();")
    assert has(text: got, needle: "    hero_runtime_check_leaks();")
    tw: writer.Writer @ writer.new_writer("t")
    test_shim(@tw, low.program, s)
    runner = writer.finish(tw)
    assert has(text: runner, needle: "    case 0:")
    assert has(text: runner, needle: "        h_t_test1();")
    assert has(text: runner, needle: "        hero_panic(\"no test with that index — this is a compiler bug\");")
