# Which built-ins reach C, and the entry point each one becomes.
# Port of archive/bootstrap-rs/heroes/src/emit/builtins.rs.
#
# One module for one question, because the list and the table are the
# same knowledge and drifting apart is the failure this project keeps
# meeting: the gate refuses by NAME, ops emits by NAME AND OPERAND
# TYPE, and a name in one and not the other is either a refusal nobody
# can lift or generated C clang rejects with the compiler blaming
# itself (panel 025 found exactly that for slice).
#
# THE RUNTIME IS MONOMORPHIC AND THE EMITTER COMPOSES IT (panel 006):
# one Heroes name can stand over several C functions — len over three,
# to_str over five, slice over two — and the choice is always made from
# the type of the first argument, never from anything the runtime
# inspects at run time.

use check/table
use check/state
use ir
use ir/containers
use token
use source
use parse
use resolve
use checker

# The built-ins the backend emits. The gate reads this list, and entry
# below is exhaustive over it — so the two cannot disagree. Tier 2 is
# absent by construction: map/filter/fold/find/any/all/range are
# written in Heroes and arrive as source, in the prelude. The width
# conversions are on the list and NOT in entry, because entry answers
# with a C entry point and a to_<width> has none: it builds a T?, a
# union generated for that result type — ops writes it inline.
constant EMITTED: [str]
    [
        "chars"
        "join"
        "keys"
        "len"
        "print"
        "push"
        "repeat"
        "slice"
        "sort"
        "to_f32"
        "to_f64"
        "to_i64"
        "to_str"
        "to_i8"
        "to_i16"
        "to_i32"
        "to_u8"
        "to_u16"
        "to_u32"
        "to_u64"
    ]

# The type of a call's first argument, where there is one and it is a
# value. Absent covers a zero-argument call and an @ argument — neither
# of which any built-in above has, and both fall to the default arm
# rather than to an abort, because the gate has already refused
# anything else.
function first_type(f: containers.Function, c: state.Checked, run: ir.Run) -> table.Ty?
    given = containers.args_of(f, run)

    if given.len() == 0
        return fail("none", "no arguments")

    match given[0]
        .value_arg v => return ok(table.get(c.types, containers.value_type(f, v.value)))
        .inout_arg   => return fail("none", "an @ argument")

    return fail("none", "unreached")

# The C function this call becomes. Exhaustive over EMITTED minus
# print, which is not a call at all but a sequence of one printer per
# argument. A name that reaches here without a row is a gate that let
# something through, so the fallback is hero_unreachable rather than a
# guess.
function entry(name: str, f: containers.Function, c: state.Checked, run: ir.Run) -> str
    first = first_type(f, c, run: run)

    if name == "len"
        if !first.is_err()
            match first.must()
                .map                                                      => return "hero_map_len"
                .array                                                    => return "hero_array_len"
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return "hero_str_len"
                .fixed | .fallible | .function_ty | .named                => return "hero_str_len"
                .case_ty | .failure | .generic | .error                   => return "hero_str_len"
        return "hero_str_len"

    # keys(m) hands back a fresh array whose keys are copied through
    # the key descriptor, so it owns them and may outlive the map.
    if name == "keys"
        return "hero_map_keys"

    # The two halves that did not land together (panel 025): slice on
    # an array type-checked and emitted hero_str_slice, which clang
    # rejected at exit 2. Both halves are here now.
    if name == "slice"
        if !first.is_err()
            match first.must()
                .array                                                    => return "hero_array_slice"
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return "hero_str_slice"
                .fixed | .map | .fallible | .function_ty | .named         => return "hero_str_slice"
                .case_ty | .failure | .generic | .error                   => return "hero_str_slice"
        return "hero_str_slice"

    # push hands back a NEW array, always: value semantics has no
    # reading in which the argument is consumed. sort is the same shape
    # for the same reason; its comparison is chosen inside the runtime
    # by pointer identity against the static descriptors — panel 027
    # vetoed a cmp in HeroDesc, because C11 zero-fills a short
    # initialiser and every descriptor that forgot the field would
    # carry a NULL and SEGV with no type name.
    if name == "push"
        return "hero_array_push"

    if name == "sort"
        return "hero_array_sort"

    if name == "chars"
        return "hero_str_chars"

    if name == "join"
        return "hero_str_join"

    if name == "repeat"
        return "hero_str_repeat"

    if name == "to_i64"
        return "hero_f64_to_int"

    # Dispatched on the SOURCE, like to_str below: one Heroes name
    # covers two C conversions once there are two float widths. An f32
    # source reaching hero_int_to_f64 would be C converting a float to
    # an int64_t and back — the silent wrong answer this dispatch
    # exists to stop.
    if name == "to_f64"
        if !first.is_err()
            match first.must()
                .float_ty                                                  => return "hero_f32_to_f64"
                .int_ty | .bool | .str | .ptr | .cstr | .unit              => return "hero_int_to_f64"
                .array | .fixed | .map | .fallible | .function_ty | .named => return "hero_int_to_f64"
                .case_ty | .failure | .generic | .error                    => return "hero_int_to_f64"
        return "hero_int_to_f64"

    if name == "to_f32"
        if !first.is_err()
            match first.must()
                .float_ty                                                  => return "hero_f64_to_f32"
                .int_ty | .bool | .str | .ptr | .cstr | .unit              => return "hero_int_to_f32"
                .array | .fixed | .map | .fallible | .function_ty | .named => return "hero_int_to_f32"
                .case_ty | .failure | .generic | .error                    => return "hero_int_to_f32"
        return "hero_int_to_f32"

    # to_str is one Heroes name over five C entry points. cstr is the
    # fifth, and it is the boundary's return path (§4.19): .cstr()
    # lends a str to C; this copies one back — predicted by panel 036's
    # ffi-pragmatist before the ladder reached a library that returns
    # one.
    if name == "to_str"
        if first.is_err()
            return "hero_unreachable"

        # The `cstr` branch was HERE and is gone (panel 090). The checker
        # refuses a `cstr` before lowering reaches this line, so a branch
        # for one would be unreachable code claiming to be a route.
        # `hero_str_from_cstr` stays in the runtime — `os.c:62`'s
        # `hero_args_at` is its other caller — but nothing the emitter
        # writes reaches it any more.
        found = to_str_entry(first.must())

        if found.is_err()
            return "hero_unreachable"
        return found.must()
    return "hero_unreachable"

# Which library functions this program actually reaches. The library is
# compiled with every program, but --emit-c is an artifact the author
# reads, and seven unused definitions would be seven pieces of noise
# about a library they cannot change. A worklist rather than one pass,
# because a library function may call another.
function reachable(p: containers.Program, s: source.Source) -> {i64: bool}
    seen: {i64: bool} @ {}
    work: [i64] @ []

    for f in p.functions
        if !source.is_library(s, f.span.start)
            for callee in calls_of(f)
                work @ work.push(callee)

    while work.len() > 0
        decl = work[work.len() - 1]
        work @ work.slice(from: 0, to: work.len() - 1)

        if !seen[decl].is_err()
            continue
        seen[decl] @ true

        for f in p.functions
            if f.decl == decl
                for callee in calls_of(f)
                    work @ work.push(callee)

    return seen

# Every Heroes function this one NAMES — not calls. FuncRef is the
# other way a function's symbol reaches the C (§4.13), and until
# 2026-08-12 this walk matched only calls, so a library function passed
# as a value was referenced and never defined: undeclared identifier at
# exit 2 on a legal program, root-dependent as well as wrong.
function calls_of(f: containers.Function) -> [i64]
    found: [i64] @ []

    for blk in f.blocks
        for inst in blk.insts
            match inst.op
                .call cl =>
                    match cl.callee
                        .heroes_fn h                         => found @ found.push(h.decl)
                        .extern_fn | .builtin_fn | .indirect => continue
                .func_ref fr =>
                    match fr.callee
                        .heroes_fn h                         => found @ found.push(h.decl)
                        .extern_fn | .builtin_fn | .indirect => continue
                .lit | .load | .store | .push_owned | .unary | .binary | .cast | .construct => continue
                .field | .index | .map_get | .len_of | .tag_of | .payload                   => continue
                .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

    return found

# Which runtime entry point turns a value of this type into a str.
# ONE READER, BECAUSE TWO DISAGREED (panel 052): print(x) reaches this
# through the abort path and x.to_str() through the table above, and
# the second was a catch-all sending u64 to the signed entry point — so
# print(n) for 2^64-1 printed 18446744073709551615 and
# print(n.to_str()) printed -1, fixed on one path and not the other,
# for two milestones. Exhaustive over the widths on purpose: six of the
# seven narrow widths widen into an int64_t without losing a value;
# u64 does not, because 2^64-1 read as signed is -1.
function to_str_entry(ty: table.Ty) -> str?
    match ty
        .int_ty ik =>
            match ik.kind
                .u64                                         => return ok("hero_uint_to_str")
                .i8 | .i16 | .i32 | .i64 | .u8 | .u16 | .u32 => return ok("hero_int_to_str")
        .float_ty fk =>
            match fk.kind
                .f32 => return ok("hero_f32_to_str")
                .f64 => return ok("hero_f64_to_str")
        .bool                                         => return ok("hero_bool_to_str")
        .str                                          => return ok("hero_str_identity")
        .ptr | .cstr | .unit | .array | .fixed | .map => return fail("none", "no rendering")
        .fallible | .function_ty | .named | .case_ty  => return fail("none", "no rendering")
        .failure | .generic | .error                  => return fail("none", "no rendering")

    return fail("none", "unreached")

## Tests

test "one name, many entry points, always chosen by the first argument's type"
    text = "function main()\n    xs = [1, 2]\n    m = {\"a\": 1}\n    print(len(xs) + len(m) + len(\"ab\"))\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    int_id = table.int_ty_id(c.types)
    str_id = table.str_ty(c.types)
    arr = table.lookup(c.types, .array(element: int_id)).must()
    mp = table.lookup(c.types, .map(key: str_id, value: int_id)).must()
    f: containers.Function @ containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [arr, mp, str_id],
        arguments: [.value_arg(value: 0), .value_arg(value: 1), .value_arg(value: 2)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    assert entry(name: "len", f: f, c: c, run: ir.Run(start: 0, length: 1)) == "hero_array_len"
    assert entry(name: "len", f: f, c: c, run: ir.Run(start: 1, length: 1)) == "hero_map_len"
    assert entry(name: "len", f: f, c: c, run: ir.Run(start: 2, length: 1)) == "hero_str_len"
    assert entry(name: "slice", f: f, c: c, run: ir.Run(start: 0, length: 1)) == "hero_array_slice"
    assert entry(name: "slice", f: f, c: c, run: ir.Run(start: 2, length: 1)) == "hero_str_slice"

test "the panel-052 pair: u64 to its own entry point, on BOTH paths"
    u64_entry = to_str_entry(.int_ty(kind: .u64))
    assert u64_entry.must() == "hero_uint_to_str"
    i64_entry = to_str_entry(.int_ty(kind: .i64))
    assert i64_entry.must() == "hero_int_to_str"
    assert to_str_entry(.bool).must() == "hero_bool_to_str"
    assert to_str_entry(.str).must() == "hero_str_identity"
    assert to_str_entry(.unit).is_err()
