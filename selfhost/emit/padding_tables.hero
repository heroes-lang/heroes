# The padding tables a unit writes once, at file scope before the bodies
# that read them (panel 215's R1, issue 1334): one per group record the
# unit's functions lend through `@`, whole, in a fixed array, or as the
# elements of an array's buffer, and one per record an array among their
# members holds. What a table holds and how a lend reads it is
# `emit/padding.hero`; this walks the bodies for the records, reading each
# call's arguments as the lend itself reads them. Split out of
# `emit/padding.hero` on 2026-10-16, at panel 215's landing.

use ast
use check/state
use emit/ctype
use emit/lend_count
use emit/membership
use emit/padding
use emit/writer
use ir
use ir/containers
use source

# The tables of every group record the functions `at` lend, written once at
# file scope before their bodies (`table_of`): each record's spans, its own
# member names guarded from the header's macros there and nowhere else, so a
# lend is one call (`passes`). A record with no span gets no table and no
# call: zero spans would make every byte padding, and the safe direction is
# to write nothing.
function tables(@w: writer.Writer, p: containers.Program, at: [i64], c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    lent: {i64: bool} @= {}

    for one in at
        f = p.functions[one]

        for blk in f.blocks
            for inst in blk.insts
                match inst.op
                    .call cl =>
                        match cl.callee
                            .extern_fn e =>
                                for decl in lent_by(c, s, decls, f, run: cl.arguments, decl: e.decl)
                                    reached(c, names, s, decls, decl: decl, @lent)
                            .heroes_fn | .builtin_fn | .indirect => continue

                    # A group record written whole is zeroed after the store
                    # (defect 2112), so its table stands here too.
                    .store st =>
                        stored = padding.record_of(
                            c,
                            decls,
                            ty: padding.innermost(c, ty: containers.value_type(f, st.value))
                        )

                        if stored >= 0
                            reached(c, names, s, decls, decl: stored, @lent)
                    .lit | .load | .push_owned | .unary | .binary | .cast | .func_ref           => continue
                    .field | .index | .map_get | .len_of | .tag_of | .payload | .construct      => continue
                    .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue

    if lent.len() == 0
        return
    writer.at_generated(@w)
    writer.line(@w, text: "void *" + padding.NOWHERE + "(void);")

    gapped: [i64] @= []
    masked: [str] @= []

    # ORDER: by declaration, so the unit's text is a function of the program.
    for decl in sort(keys(lent))
        held = padding.members(c, names, s, decls, decl: decl, t: ctype.of(names, decl: decl), prefix: "")

        if !held.is_err()
            spans_at = padding.table_of(decl)
            line = "__attribute__((unused)) static const size_t " + spans_at + "[] = {" + held.must().spans.join(", ") + "};"

            for text in membership.guarded(names: held.must().bare, line: line)
                writer.line(@w, text: text)

            # Room for one more gap than the table has spans, the most
            # `hero_pad_gaps` can find (`runtime/parts/lend.c` says why), and
            # where named bit-fields set bytes, a span more for each run of
            # them, `room` at most (`hero_pad_bits`).
            more: str @= "2"

            if held.must().bits.len() > 0
                more @ (2 + 2 * held.must().room).to_str()
            writer.line(
                @w,
                text: "__attribute__((unused)) static size_t " + padding.gaps_of(decl) + "[sizeof " + spans_at + " / sizeof(size_t) + " + more + "];"
            )
            writer.line(@w, text: "__attribute__((unused)) static size_t " + padding.count_of(decl) + ";")

            if held.must().bits.len() > 0
                for step in bit_tables(@w, decl: decl, held: held.must(), t: ctype.of(names, decl: decl))
                    masked @ masked.push(step)
            else
                gapped @ gapped.push(decl)

    # A type's gaps never change, so they are found once, before `main` and
    # before any thread, and a lend only writes.
    if gapped.len() + masked.len() > 0
        writer.line(@w, text: "__attribute__((constructor)) static void hero_pad_init(void) {")

        for decl in gapped
            spans_at = padding.table_of(decl)
            writer.line(
                @w,
                text: "    " + padding.count_of(decl) + " = hero_pad_gaps(sizeof(" + ctype.of(names, decl: decl) + "), " + spans_at + ", sizeof " + spans_at + " / (2 * sizeof(size_t)), " + padding.gaps_of(decl) + ");"
            )

        for line in masked
            writer.line(@w, text: "    " + line)

        writer.line(@w, text: "}")

    writer.blank(@w)

# A record's bit-field tables (panel 223, defect 2099): room for a mask per
# byte its named bit-fields can reach and how many masks there are, at file
# scope; and the constructor's block that finds them and the record's gaps,
# the answer. C finds the bits itself, endianness and ABI alike: `--` on each
# named bit-field of a zeroed object sets exactly its bits, all of them,
# whatever its type, so every byte it reaches, and `hero_pad_bits` reads the
# object's bytes. Each name the block spells is guarded from the header's
# macros, as a member's is in the table.
#
# **NO BYTE OF A BIT-FIELD IS WRITTEN AS A NUMBER** (defect 2383): the table
# holds members alone, and the bytes each named bit-field reaches are the
# ones C set, so the text is the same on every target. `room` is the most
# bytes the named bit-fields can reach, from their declared widths
# (`membership.bytes_reached`), never from where this machine's layout put
# them.
#
# **THE OBJECT IS THE RUNTIME'S, NEVER THE CONSTRUCTOR'S FRAME** (defect 2354):
# the block declared it as a local, and a constructor runs before `main`, so
# before the stack guard exists; a record of 128 MiB with one named bit-field,
# stored whole, died at 139 with nothing said, at both levels. It is taken
# zeroed from `hero_pad_object` and given back by `hero_pad_object_give` once
# the masks are read (`runtime/parts/lend.c`), so no frame holds it at any size.
function bit_tables(@w: writer.Writer, decl: i64, held: padding.Held, t: str) -> [str]
    m = padding.bit_table("m", decl: decl)
    mn = padding.bit_table("mn", decl: decl)
    writer.line(@w, text: "__attribute__((unused)) static size_t " + m + "[" + (2 * held.room).to_str() + "];")
    writer.line(@w, text: "__attribute__((unused)) static size_t " + mn + ";")
    spelled: {str: bool} @= {}
    steps: [str] @= []

    for path in held.bits
        steps @ steps.push(OBJECT + "->" + path + "--;")

        for name in membership.names_in(path)
            spelled[name] @ true

    out: [str] @= ["{", "    " + t + " *const " + OBJECT + " = (" + t + " *)hero_pad_object(sizeof(" + t + "));"]

    for line in membership.guarded(names: spelled, line: "    " + steps.join(" "))
        out @ out.push(line)

    spans_at = padding.table_of(decl)
    out @ out.push(
        "    " + padding.count_of(decl) + " = hero_pad_bits(sizeof(" + t + "), " + spans_at + ", sizeof " + spans_at + " / (2 * sizeof(size_t)), " + OBJECT + ", " + padding.gaps_of(decl) + ", " + m + ", " + held.room.to_str() + ", &" + mn + ");"
    )
    out @ out.push("    hero_pad_object_give(" + OBJECT + ");")
    return out.push("}")

# The name of the zeroed record a bit-field block runs `--` on.
constant OBJECT: str
    "hero_pad_o"

# The group records one extern call lends: the record, or fixed array of
# records, each `@` argument is, and the element of each array whose buffer
# the call fills (`lend_count.buffer_element`), as `zero` and `buffer_lines`
# read them.
function lent_by(c: state.Checked, s: source.Source, decls: [ast.Decl], f: containers.Function, run: ir.Run, decl: i64) -> [i64]
    out: [i64] @= []
    index: i64 @= 0

    for arg in containers.args_of(f, run)
        match arg
            .inout_arg io =>
                whole = padding.record_of(
                    c,
                    decls,
                    ty: padding.innermost(c, ty: lend_count.place_type(c, s, decls, f, at: io.place))
                )

                if whole >= 0
                    out @ out.push(whole)
                element = lend_count.buffer_element(c, decls, decl: decl, index: index)

                if !element.is_err() && padding.record_of(c, decls, ty: element.must()) >= 0
                    out @ out.push(padding.record_of(c, decls, ty: element.must()))
            .value_arg => index @ index

        index @ index + 1

    return out

# `decl` and every record an array among its members holds, each with a
# span, into `lent`.
function reached(c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], decl: i64, @lent: {i64: bool})
    if !lent[decl].is_err()
        return
    held = padding.members(c, names, s, decls, decl: decl, t: ctype.of(names, decl: decl), prefix: "")

    if held.is_err() || held.must().spans.len() == 0
        return
    lent[decl] @ true

    for one in held.must().arrays
        reached(c, names, s, decls, decl: one.element, @lent)
