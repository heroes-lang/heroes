# A value larger than `LARGE` bytes, kept off the frame and written in place
# (defect 2278; panel 233, provisional, author ratification pending).
#
# **WHY.** clang's SROA splits every local struct it can see whole into one
# scalar per leaf, and a copy of a split struct into one leaf store each, so a
# record of records copied a few times in one body hands clang a copy for
# every leaf of every copy: 314 billion instructions and 12.3 GB for a 4 MiB
# record at `-O2` (panel 233's reproducer, depth 18), 1.9 trillion for a 2 MiB
# one built by calls eight to a level, and a 2 MiB one handed by value did not
# finish in 600 s. The same records at `-O0` held two and three copies in each
# frame, past the 8 MiB stack. Only a struct clang cannot see whole escapes
# the split, and only a value the frame does not hold escapes the stack.
#
# **WHAT, four parts and one threshold.** A slot or temporary of a type of the
# program's own (`byte_copy.own_struct`: a record that is no group's, a
# variant, a `T?`, a case's payload) larger than `LARGE`, or holding a group's
# `partial` record by value, whose bytes the count cannot know, lives in a room
# off the frame (`runtime/parts/frame.c`, a stack of its own on each thread,
# bounded once for the whole process), taken in the prologue and given back at
# the one exit, its name made the region's for the body, as
# `emit/lend_local.hero` makes a guarded local's; a Heroes function whose
# result is such a type returns it through its caller's slot, `OUT`; a plain
# parameter of such a type is handed as a pointer to the copy its caller's IR
# already made, which rule 1 of `ir/own.hero` (a plain parameter is borrowed)
# makes the same value; and a construction of such a record is written field
# by field into its destination. Each part was measured necessary on panel
# 233's shapes: the region alone left the call's hidden temporary on the frame
# and the run aborted at `-O2`. Below `LARGE` a program's C is what it was,
# byte for byte.
#
# **A FUNCTION VALUE OF SUCH A TYPE TAKES THE SAME CONVENTION**, its typedef
# spelled as a direct call's (`types.function_type`) and an indirect call passing
# its arguments the same way, so a large result called through a value lands in
# the caller's room too; until panel 233's critic's second pass it kept C's
# convention through a twin, and a 16 MiB result returned through a value was a
# 16 MiB object of the caller's frame. C never sees such a type: the checker
# refuses a program record inside an `extern`'s callback type, which the first
# test below holds, so such a function has no thunk (`crosses`).
#
# **A GROUP'S RECORD IS THE EXCEPTION, BY VALUE** (panel 236; panel 233's
# ffi-pragmatist's R7b). A call by name takes it in place as it takes a program
# record, so `make(n) -> Held` writes defect 2253's 128 MiB record into its
# caller's room; but a function type naming one may be an `extern`'s callback
# type, checked against the header by the probe, so its typedef, a call through
# a value and a thunk keep C's convention (`value_large`). A function whose two
# conventions differ (`converts`) stands as a value through its twin
# (`signature.value_twin`), which takes C's convention and calls the function
# in place, and is what its thunk calls.
#
# **HOW BIG A TYPE IS, AND WHICH ONES ARE LARGE, IS THE OTHER HALF'S**,
# `emit/large_size.hero`, whose answer arrives here on `ctype.Names.large` and
# is read through `is_large` and `off_frame` alone. This module never counts a
# byte; that one never spells any C.

use check/state
use checker
use emit/ctype
use emit/mangle
use ir
use ir/containers
use parse
use resolve
use source

# The parameter a function returning a large value is handed first.
constant OUT: str
    "hero_out"

# Whether a call by name takes `ty` in place: every type kept off the frame
# (panel 236; until then a group's record kept off the frame went by C's
# convention, and its call's hidden result was a temporary of the frame).
function is_large(names: ctype.Names, ty: i64) -> bool
    return off_frame(names, ty: ty)

# Whether a value of `ty` is kept off the frame, passed in place or not.
function off_frame(names: ctype.Names, ty: i64) -> bool
    return !names.large[ty].is_err()

# Whether a function VALUE takes `ty` in place: a large type of the program's
# own, never a group's record, which a value takes by C's convention.
function value_large(names: ctype.Names, ty: i64) -> bool
    return names.large[ty].default(false)

# Whether the slot is a plain parameter, the kind a call hands in place.
function plain_param(f: containers.Function, slot_id: i64) -> bool
    return match f.slots[slot_id].kind
        .param_slot ps                               => !ps.mutable
        .local_slot | .synthetic_slot | .return_slot => false

# A plain parameter a function value takes as a pointer.
function value_pointer_param(f: containers.Function, names: ctype.Names, slot_id: i64) -> bool
    return plain_param(f, slot_id: slot_id) && value_large(names, ty: f.slots[slot_id].ty)

# Whether `f`'s value takes a convention its call by name does not: a group's
# large record as its result or a plain parameter. Such a function stands as a
# value through its twin (`signature.value_twin`).
function converts(names: ctype.Names, f: containers.Function) -> bool
    if is_large(names, ty: f.result) && !value_large(names, ty: f.result)
        return true

    for slot_id in f.params
        if in_pointer_param(f, names, slot_id: slot_id) && !value_pointer_param(f, names, slot_id: slot_id)
            return true

    return false

# Whether C could be handed `f`: its value takes C's convention for every plain
# parameter and its result, which a large program record's never does, since no
# callback type can name one, the checker refusing a program record there (the
# first test below). A function that cannot cross gets no thunk and no table
# row (defect 2337): a thunk is written for every function whose address is
# taken once the program binds any callback (`emit/callback_guard.hero`, a
# superset on purpose), and it forwarded C's by-value arguments to a function
# taking them in place, which clang refused, exit 2.
function crosses(names: ctype.Names, f: containers.Function) -> bool
    if value_large(names, ty: f.result)
        return false

    for slot_id in f.params
        if value_pointer_param(f, names, slot_id: slot_id)
            return false

    return true

# A plain parameter of a large type, handed as a pointer by a call by name.
function in_pointer_param(f: containers.Function, names: ctype.Names, slot_id: i64) -> bool
    return plain_param(f, slot_id: slot_id) && is_large(names, ty: f.slots[slot_id].ty)

# A place rooted in a parameter its caller hands in place, spelled through that
# pointer as writable: the place is the caller's own copy behind `const T *`,
# and what is written through it is only what no member holds, the padding
# panel 215's R1 zeroes before a lend (`emit/padding.hero`), never the value.
# Refused at build, exit 2, for a program record holding a `partial` one since
# panel 233's route (defect 2338), and so would a group's record taken in place
# be since panel 236's.
function writable(f: containers.Function, c: state.Checked, names: ctype.Names, root: i64, place: str) -> str
    if root < 0 || root >= f.slots.len() || !in_pointer_param(f, names, slot_id: root)
        return place
    name = mangle.slot(index: root, name: f.slots[root].name)
    spelled = ctype.c_type(names, c: c, ty: f.slots[root].ty)

    if spelled.is_err() || place.len() < name.len() || place.slice(from: 0, to: name.len()) != name
        return place
    rest = place.slice(from: name.len(), to: place.len())

    if rest != "" && rest.slice(from: 0, to: 1) != "." && rest.slice(from: 0, to: 1) != "["
        return place
    return "(*(" + spelled.must() + " *)" + in_pointer(name) + ")" + rest

# The pointer a large slot or temporary is reached through, and the pointer a
# large parameter arrives as.
function pointer(name: str) -> str
    return "hero_big_" + name

function in_pointer(name: str) -> str
    return "hero_in_" + name

# The prologue's statement for a large slot or temporary: its region taken.
function taken(spelled: str, name: str) -> str
    return spelled + " *const " + pointer(name) + " = (" + spelled + " *)hero_frame_take(sizeof(" + spelled + "));"

# The name made the region's, or the pointer's, for the rest of the body.
function defined(name: str, through: str) -> str
    return "#define " + name + " (*" + through + ")"

function given_back(name: str) -> str
    return "    hero_frame_give(" + pointer(name) + ");"

# Whether a call takes `ty` in place: a call by name every large type, a call
# through a value all but a group's record, a built-in and an `extern` none.
function called_in_place(names: ctype.Names, callee: ir.Callee, ty: i64) -> bool
    return match callee
        .heroes_fn               => is_large(names, ty: ty)
        .indirect                => value_large(names, ty: ty)
        .builtin_fn | .extern_fn => false

# A call's arguments as its callee takes them. A Heroes function, called
# directly or through a value, takes the destination first where the result is
# large, `NULL` where the result is discarded, and the address of each large
# value handed by value; a built-in and an `extern` take C's convention, and
# their arguments as they are; a value, a group's record by C's.
function direct_arguments(f: containers.Function, names: ctype.Names, callee: ir.Callee, run: ir.Run, rendered: [str], result: i64, target: str?) -> [str]
    match callee
        .heroes_fn | .indirect   => _ = 0
        .builtin_fn | .extern_fn => return rendered

    out: [str] @= []

    if called_in_place(names, callee: callee, ty: result)
        if target.is_err()
            out @ out.push("NULL")
        else
            out @ out.push("&" + target.must())
    at: i64 @= 0

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v =>
                if called_in_place(names, callee: callee, ty: containers.value_type(f, v.value))
                    out @ out.push("&" + rendered[at])
                else
                    out @ out.push(rendered[at])
            .inout_arg => out @ out.push(rendered[at])

        at @ at + 1

    return out

# The target a call assigns: none where a direct call writes a large result
# into it as its first argument.
function direct_target(names: ctype.Names, callee: ir.Callee, result: i64, target: str?) -> str?
    if called_in_place(names, callee: callee, ty: result)
        return fail(code: "none", msg: "written through the callee's first argument")
    return target

## Tests

# THE RULE THE CONVENTION OF A FUNCTION VALUE RESTS ON: a function type that
# names a large value is spelled by a direct call's convention
# (`types.function_type`), and a thunk keeps C's (`callback_thunk.header`); both
# are right only while no such type reaches C. The checker refuses any program
# record inside an `extern`'s callback type, large or small, which is what
# keeps a function this module converts from ever standing where C calls it.
# If this test fails, a converted function can be thunked and handed to C with
# the wrong convention, silently, through the lookup table's casts.
test "a program record cannot stand in an extern's callback type, so no converted function reaches C (panel 233)"
    text = "extern \"cb.h\"\n    function apply(cb: (function(E0) -> i64), n: i64) -> i64\n\nrecord E0\n    x: i64\n\nfunction first(e: E0) -> i64\n    return e.x\n\nfunction main()\n    print(apply(cb: first, n: 1))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    refused: bool @= false

    for d in c.diagnostics
        if d.code == "ffi_type"
            refused @ true

    assert refused
