# What the layout round says a group record's members are, as one line of
# text (panel 215's R1): written by `cli/layout.hero` from the screen's
# answer or the layout dump, carried to the emitter in
# `ctype.Names.lend_units` under `KEY`, and read by `emit/padding.hero`.
# Split out of `emit/padding.hero` on 2026-10-16, at panel 215's landing:
# the zeroing stayed there, the text both ends agree on came here; and on
# 2026-10-17, at panel 223, the guard that spells a dump's names (`guarded`).
#
# `DECLARED` for a record the screen vouches for, whose declared fields are
# exactly the struct's members; for any other record the leaves of the
# header's layout dump, one entry each, joined by `;`: `p <path>` a member,
# `n <width> <path>` a named bit-field, its declared width and its C name,
# through which C finds its bits before `main` (panel 223); `c <width>
# <path>` a `const` one, which no line may write; `f <path>` a flexible array
# member, holding every byte from its offset to the end.
#
# **No entry carries a byte** (defect 2383): where a bit-field lies is the
# target's layout, `1:0-2` under the Itanium one and `4:0-2` under the MSVC
# one for `struct { int8_t a; unsigned b : 3; }`, and a byte read from this
# machine's dump and written into the C made one program two texts, and C
# compiled for another target zero a byte its bit-field holds. Its width is
# the declaration's, the same on every target.

use emit/layout_rows
use emit/layout_text

# The key a record's membership rides under in `ctype.Names.lend_units`,
# which no C name a counted parameter is keyed by can begin with.
constant KEY: str
    "%pad "

# A record whose declared fields are the struct's members.
constant DECLARED: str
    "="

# The membership of a record from the leaves of its layout dump, or absent
# where a bit-field's bytes could not be read: then nothing is written for it.
# A record or union member gives its leaves, an unnamed bit-field nothing,
# being padding (C11 6.7.2.1p12), and an empty anonymous member nothing.
function encoded(tree: [layout_text.Member]) -> str?
    out: [str] @= []

    for m in tree
        if m.nested
            continue

        if m.bitfield
            if m.name.len() == 0
                continue

            if m.width < 1
                return fail(code: "none", msg: "a bit-field whose width the dump does not give")
            told = m.width.to_str() + " " + m.path

            # The dump prints a `const` bit-field's qualifier first.
            if layout_rows.starts(text: m.type_text, prefix: "const ")
                out @ out.push("c " + told)
            else
                out @ out.push("n " + told)
        else if m.flexible
            out @ out.push("f " + m.path)
        else if m.path.len() > 0
            out @ out.push("p " + m.path)

    return ok(out.join(";"))

# The entries of a membership, split at each `;`.
function entries(text: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at <= text.len()
        if at == text.len() || text[at] == ';'
            if at > start + 1
                out @ out.push(text.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    return out

# Where a bit-field's width ends, at its entry's first space.
function space_in(text: str) -> i64
    at: i64 @= 0

    while at < text.len()
        if text[at] == ' '
            return at
        at @ at + 1

    return 0 - 1

# What a bit-field's entry gives (panel 223, defect 2099): its declared
# `width`, which bounds the bytes its bits can reach, and `path`, its C name.
# `emit/padding_tables.hero` has C find its bits before `main` by `--` on a
# zeroed object, through that name, and `hero_pad_clear` writes zero the bits
# beside them at each lend.
record Bits
    width: i64
    path: str

# A bit-field's entry, `<width> <path>`; absent where it has no space, no
# name or no width.
function bit_entry(rest: str) -> Bits?
    first = space_in(rest)

    if first < 1 || first + 1 >= rest.len()
        return fail(code: "none", msg: "a bit-field's entry is not a width and a name")
    width = layout_rows.leading_number(rest.slice(from: 0, to: first))

    if width < 1
        return fail(code: "none", msg: "a bit-field's entry has no width")
    return ok(Bits(width: width, path: rest.slice(from: first + 1, to: rest.len())))

# **The most bytes a bit-field `width` bits wide can reach**: its bits are
# one run in its storage unit, laid out in consecutive bytes, so from bit 7
# of a byte they reach `(width + 6) / 8 + 1`, on every target and in either
# byte order. The bound sizes the masks a record's named bit-fields can give
# and the runs of bytes they set, never a byte's place.
function bytes_reached(width: i64) -> i64
    return (width + 6) / 8 + 1

# **A member's own name is spelled where no header macro reaches it.** The
# dump names the members as C declares them, and a header may define a macro
# of a member's name: `#define fd via.fd` makes `s.fd` read `s.via.fd`, which
# a field the program declares relies on (defect 2062), and turns the dump's
# `via.fd` into `via.via.fd`, which clang refused, exit 2 on a correct program
# (`run/fixedbugs-2062-a-union-member-is-reached-through-a-macro-of-the-program-s-own`,
# found at panel 215's landing). So each such name is saved, undefined for
# the one line that spells it, and restored, whether or not it was a macro:
# `push_macro` of a name with no definition restores it as none.
#
# ORDER: by the name's bytes — the `#pragma` lines of the emitted C, which a
# second emission of the same input gives alike (the `determinism` suite).
function guarded(names: {str: bool}, line: str) -> [str]
    held = sort(keys(names))
    out: [str] @= []

    for name in held
        out @ out.push("#pragma push_macro(\"" + name + "\")")
        out @ out.push("#undef " + name)

    out @ out.push(line)

    for name in held
        out @ out.push("#pragma pop_macro(\"" + name + "\")")

    return out

# The names a dump's path spells, one per level: `via.fd` gives `via` and
# `fd`.
function names_in(path: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at <= path.len()
        if at == path.len() || path[at] == '.'
            if at > start
                out @ out.push(path.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    return out

## Tests

test "a membership is read entry by entry, and a dump's leaves are its entries"
    assert entries("p a;p inner.d;n 3 c") == ["p a", "p inner.d", "n 3 c"]
    assert bit_entry(rest: "3 c").must().width == 3 && bit_entry(rest: "3 c").must().path == "c"
    assert bit_entry(rest: "10 o.c").must().path == "o.c" && bit_entry(rest: "10 o.c").must().width == 10
    assert bit_entry(rest: "1").is_err() && bit_entry(rest: "0 c").is_err() && bit_entry(rest: "3 ").is_err()
    assert entries("") == []
    assert space_in("1 2") == 1
    assert names_in("via.fd") == ["via", "fd"]
    assert names_in("kind") == ["kind"]

test "a named bit-field gives its width and its C name, a const one the same, never a byte (defect 2383)"
    b = member(name: "b", byte: 1, width: 3, type_text: "unsigned int")
    c = member(name: "c", byte: 1, width: 10, type_text: "unsigned int")
    k = member(name: "k", byte: 0, width: 2, type_text: "const unsigned int")
    pad = member(name: "", byte: 1, width: 2, type_text: "unsigned int")
    assert encoded([k, b, pad, c]).must() == "c 2 k;n 3 b;n 10 c"

    # The same declaration under the MSVC layout, its bit-fields at byte 4:
    # one text, since no entry carries a byte.
    moved = member(name: "b", byte: 4, width: 3, type_text: "unsigned int")
    assert encoded([moved]).must() == encoded([b]).must()
    assert encoded([member(name: "b", byte: 1, width: -1, type_text: "unsigned int")]).is_err()

test "a bit-field reaches at most the bytes its width can straddle"
    assert bytes_reached(1) == 1
    assert bytes_reached(2) == 2 && bytes_reached(8) == 2 && bytes_reached(9) == 2
    assert bytes_reached(10) == 3 && bytes_reached(64) == 9

# A bit-field leaf of a dump, for the tests.
function member(name: str, byte: i64, width: i64, type_text: str) -> layout_text.Member
    return layout_text.Member(
        depth: 1,
        name: name,
        nested: false,
        bitfield: true,
        flexible: false,
        byte: byte,
        width: width,
        union_kw: false,
        place: "",
        path: name,
        type_text: type_text
    )

test "a name the dump spelled is undefined for the one line that spells it, and restored"
    named: {str: bool} @= {}
    named["fd"] @ true
    named["via"] @ true
    got = guarded(names: named, line: "x;")
    assert got[0] == "#pragma push_macro(\"fd\")" && got[1] == "#undef fd"
    assert got[4] == "x;"
    assert got[5] == "#pragma pop_macro(\"fd\")" && got[6] == "#pragma pop_macro(\"via\")"
    none: {str: bool} = {}
    assert guarded(names: none, line: "x;") == ["x;"]
