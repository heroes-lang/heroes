# A composite value coming into existence (design.md §4.20, §4.6;
# panels 021, 022, 023). Port of archive/bootstrap-rs/heroes/src/emit/construct.rs.
#
# One question asked five times — WHERE DO THE ARGUMENTS GO — and the
# five answers divide into two kinds, which is the whole content: a
# record, a variant case and a T? are ONE C expression (a compound
# literal, built by value, assigned once); an array and a map are
# SEVERAL statements, because each element crosses into the container
# through its descriptor and each step releases the container it grew
# from. An expression that allocated twice would leak the first with
# nothing to report it.

use ast
use source
use check/state
use ir
use ir/containers
use emit/mangle
use emit/ctype
use emit/aggregate
use emit/container
use emit/fallible
use emit/storageless
use emit/writer
use token
use check/table
use parse
use resolve
use checker

# Every argument as a C name. An @ place arrives by address (§4.8).
function argument_names(f: containers.Function, run: ir.Run) -> [str]
    out: [str] @ []

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v => out @ out.push(mangle.value(v.value))
            .inout_arg   => continue

    return out

# Point(x: 1, y: 2) and .num(v: 7) — one compound literal either way,
# and the only difference is whether a case tag comes with it. A
# fixed-array argument is rendered as its braced list HERE, because C
# gives it nowhere else to live: the value has no temporary, and the
# only legal place for the elements is inside the enclosing
# initialiser.
function record_or_case(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, shape: ir.Shape, run: ir.Run, target: str?)
    if target.is_err()
        return
    rendered: [str] @ []

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v =>
                inner = storageless.fixed_text(c, s, decls, f, value: v.value)

                if inner.is_err()
                    rendered @ rendered.push(mangle.value(v.value))
                else
                    rendered @ rendered.push(inner.must())
            .inout_arg io => rendered @ rendered.push("&" + aggregate.place(c, s, decls, f, at: io.place))

    literal: str? @ fail("none", "not an aggregate")

    match shape
        .case_shape cs                                                   => literal @ aggregate.construct_case(
            names,
            s,
            decls,
            decl: cs.decl,
            at: cs.at,
            arguments: rendered
        )
        .record_shape rs                                                 => literal @ aggregate.construct(
            names,
            s,
            decls,
            decl: rs.decl,
            arguments: rendered
        )
        .array_shape | .map_shape | .ok_shape | .fail_shape | .err_shape => literal @ literal

    if literal.is_err()
        writer.line(@w, text: "    hero_unreachable(); /* not an aggregate */")
    else
        writer.line(@w, text: "    " + target.must() + " = " + literal.must() + ";")

# An array literal is several statements, because each push releases
# the array it grew from.
function array(@w: writer.Writer, c: state.Checked, names: ctype.Names, f: containers.Function, ty: i64, run: ir.Run, target: str?)
    if target.is_err()
        return
    lines = container.build_array(
        c,
        names,
        result: ty,
        arguments: argument_names(f, run: run),
        into: target.must()
    )

    if lines.is_err()
        writer.line(@w, text: "    hero_unreachable(); /* not an array */")
        return

    for line in lines.must()
        writer.line(@w, text: "    " + line)

# A map literal, for the same reason: one statement per entry.
function map_literal(@w: writer.Writer, c: state.Checked, names: ctype.Names, f: containers.Function, ty: i64, run: ir.Run, target: str?)
    if target.is_err()
        return
    lines = container.build_map(c, names, result: ty, arguments: argument_names(f, run: run), into: target.must())

    if lines.is_err()
        writer.line(@w, text: "    hero_unreachable(); /* not a map */")
        return

    for line in lines.must()
        writer.line(@w, text: "    " + line)

# ok(x), fail(c, m), and the err that ? produces — §4.6's three ways
# into a T?, all one compound literal with a tag.
function option(@w: writer.Writer, names: ctype.Names, f: containers.Function, ty: i64, shape: ir.Shape, run: ir.Run, target: str?)
    if target.is_err()
        return
    text = fallible.construct_option(names, result: ty, shape: shape, arguments: argument_names(f, run: run))

    if text.is_err()
        writer.line(@w, text: "    hero_unreachable(); /* not a T? */")
        return
    writer.line(@w, text: "    " + target.must() + " = " + text.must() + ";")

## Tests

test "one expression for the by-value shapes, statements for the containers"
    text = "record Point\n    x: i64\n\nfunction main()\n    p = Point(x: 1)\n    xs = [1]\n    print(p.x + xs[0])\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    int_id = table.int_ty_id(c.types)
    arr = table.lookup(c.types, .array(element: int_id)).must()
    f = containers.Function(
        name: "t",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [int_id, int_id],
        arguments: [.value_arg(value: 1)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    w: writer.Writer @ writer.new_writer("t")
    record_or_case(
        @w,
        c,
        names,
        s,
        parsed.decls,
        f,
        shape: .record_shape(decl: 0),
        run: ir.Run(start: 0, length: 1),
        target: ok("t5")
    )
    array(@w, c, names, f, ty: arr, run: ir.Run(start: 0, length: 1), target: ok("t6"))
    got = writer.finish(w)
    assert got == "    t5 = (h_t_Point){.f_x = t1};\n    t6 = hero_array_new(&hero_desc_int, 1);\n    { HeroArrayHeader *grown = hero_array_push(t6, &t1);\n      hero_array_decref(t6); t6 = grown; }\n"
