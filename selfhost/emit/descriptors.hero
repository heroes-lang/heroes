# Which types need a HeroDesc, what to call it, and the C that defines
# one (design.md §4.20; panels 022, 061). Port of
# archive/bootstrap-rs/heroes/src/emit/descriptors.rs.
#
# The runtime works on an array through a descriptor because C has no
# generic copy, drop, comparison or hash — and it must be a DESCRIPTOR
# rather than a type-erased runtime that inspects values, because
# inspection would void the property this backend rests on: that clang
# type-checks every call.
#
# Five come from the runtime and are shared. The scalars, and — the one
# worth stating — a single descriptor for EVERY [T], whatever T is:
# copy, drop, eq and hash on an array all reach the element type
# through the header's own elem, so [[i64]] and [[str]] need one
# descriptor between them rather than one each.

use check/table
use check/state
use emit/ctype
use emit/writer
use emit/descriptor_set
use emit/synth
use ir/layout
use ast
use source
use parse
use resolve
use checker

# The C expression for a pointer to this type's descriptor, or absent
# where the backend has no representation — which the gate has already
# refused. Exhaustive on the WIDTH, not on "an int": a descriptor is a
# runtime object with a size in it, and sort.c dispatches on the
# pointer's identity — a second width silently sharing this one would
# compare and sort the wrong number of bytes (panel 042).
function pointer(c: state.Checked, names: ctype.Names, ty: i64) -> str?
    match table.get(c.types, ty)
        .int_ty ik =>
            match ik.kind
                .i64 => return ok("&hero_desc_int")
                .i8  => return ok("&hero_desc_i8")
                .i16 => return ok("&hero_desc_i16")
                .i32 => return ok("&hero_desc_i32")
                .u8  => return ok("&hero_desc_u8")
                .u16 => return ok("&hero_desc_u16")
                .u32 => return ok("&hero_desc_u32")
                .u64 => return ok("&hero_desc_u64")
        .float_ty fk =>
            match fk.kind
                .f32 => return ok("&hero_desc_f32")
                .f64 => return ok("&hero_desc_f64")
        .bool => return ok("&hero_desc_bool")
        .str  => return ok("&hero_desc_str")
        # One for all of them: see the module doc.

        .array => return ok("&hero_desc_array")
        .map   => return ok("&hero_desc_map")
        # One for every function type, like the array's: a function
        # value owns nothing, so the four operations do not depend on
        # the signature.

        .function_ty => return ok("&hero_desc_func")
        # Every T? needs its own, because its payload is by value — and
        # so does the failure side, which the runtime ships.

        .fallible   => return ok("&" + ctype.option_of(names, ty: ty) + "_desc")
        .failure    => return ok("&hero_desc_failure")
        .named n    => return ok("&" + ctype.satellite(names, decl: n.decl) + "_desc")
        .case_ty vc => return ok("&" + ctype.case_of(names, decl: vc.decl, at: vc.at) + "_desc")
        .ptr | .cstr | .unit | .fixed | .generic | .error => return fail(
            code: "none",
            msg: "no descriptor for this type"
        )

    return fail(code: "none", msg: "unreached")

# The C expression that hashes one value at `place`. NOT
# descriptor->hash for an aggregate, and the difference is real: a
# descriptor exists only for a type used as an array ELEMENT, while
# hash is generated for every aggregate. record Rect { corner: Point }
# hashes a Point no array holds, and going through a descriptor there
# is `use of undeclared identifier 'h_m_Point_desc'` — measured on the
# gallery's own second program.
function hash_call(c: state.Checked, names: ctype.Names, ty: i64, place: str) -> str?
    match table.get(c.types, ty)
        .named n    => return ok(ctype.satellite(names, decl: n.decl) + "_hash(" + place + ")")
        .case_ty vc => return ok(ctype.case_of(names, decl: vc.decl, at: vc.at) + "_hash(" + place + ")")
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return through_pointer(
            c,
            names,
            ty: ty,
            place: place
        )
        .array | .fixed | .map | .fallible | .function_ty => return through_pointer(c, names, ty: ty, place: place)
        .failure | .generic | .error                      => return through_pointer(c, names, ty: ty, place: place)

    return fail(code: "none", msg: "unreached")

function through_pointer(c: state.Checked, names: ctype.Names, ty: i64, place: str) -> str?
    desc = pointer(c, names, ty: ty)

    if desc.is_err()
        return fail(code: "none", msg: "no descriptor for this type")
    return ok("(" + desc.must() + ")->hash(" + place + ")")

# One static const HeroDesc per element type the program actually uses.
# Emitted BEFORE the function definitions: an array literal names its
# element descriptor, so hero_array_new(&h_m_Point_desc, 2) in main
# needs the object to exist by then — measured the other way first,
# three undeclared-identifier errors on the first program with an array
# of records. static, so a descriptor nothing points at is
# -Wunused-const-variable, which is exactly why the set is a worklist.
#
# BOTH names, because this loop writes both kinds of string:
# sizeof({c_type}) and the casts are the type; {prefix}_desc and
# {prefix}_eq are functions this compiler generated. One variable did
# the job until a header was involved — and then emitted a global
# unmangled Color_desc beside the library that declared Color (panel
# 061). The four function pointers are cast to the descriptor's own
# signatures: the price of a generic runtime in C, paid once per type
# here rather than at every call site.
#
# `constructed` narrows one of the worklist's three sources and nothing
# else — see `descriptor_set.generated`, which is where the two sets
# meet.
function definitions(@w: writer.Writer, c: state.Checked, names: ctype.Names, decls: [ast.Decl], reachable: {i64: bool}, constructed: {i64: bool}, want: synth.Wanted)
    wanted = descriptor_set.generated(c, decls, reachable: reachable, constructed: constructed, want: want)

    for ty in wanted
        prefix: str @ ""
        c_type: str @ ""
        skip: bool @ false

        match table.get(c.types, ty)
            .named n =>
                prefix @ ctype.satellite(names, decl: n.decl)
                c_type @ ctype.of(names, decl: n.decl)
            .case_ty vc =>
                prefix @ ctype.case_of(names, decl: vc.decl, at: vc.at)
                c_type @ prefix
            # A T? used as an element needs one too, and its four
            # functions already exist — option_bodies writes them for
            # every T? in the program.

            .fallible =>
                prefix @ ctype.option_of(names, ty: ty)
                c_type @ prefix
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => skip @ true
            .array | .fixed | .map | .function_ty                     => skip @ true
            .failure | .generic | .error                              => skip @ true

        if skip
            continue
        counted = layout.is_refcounted(c, ty)
        writer.at_generated(@w)
        writer.line(@w, text: "static void " + prefix + "_desc_copy(void *dst, const void *src) {")
        writer.line(@w, text: "    *(" + c_type + " *)dst = *(const " + c_type + " *)src;")

        if counted
            # Shallow plus incref, never deep (panel 022): copy-on-write
            # is what makes a deep copy unnecessary, because sharing is
            # unobservable until somebody mutates.
            writer.line(@w, text: "    " + prefix + "_retain((const " + c_type + " *)dst);")
        writer.line(@w, text: "}")
        writer.line(@w, text: "static void " + prefix + "_desc_drop(void *elem) {")

        if counted
            writer.line(@w, text: "    " + prefix + "_release((" + c_type + " *)elem);")
        else
            writer.line(@w, text: "    (void)elem;")
        writer.line(@w, text: "}")
        writer.line(@w, text: "static bool " + prefix + "_desc_eq(const void *a, const void *b) {")
        writer.line(
            @w,
            text: "    return " + prefix + "_eq((const " + c_type + " *)a, (const " + c_type + " *)b);"
        )
        writer.line(@w, text: "}")
        writer.line(@w, text: "HERO_TU_QUIET static const HeroDesc " + prefix + "_desc = {")
        writer.line(@w, text: "    sizeof(" + c_type + "),")
        writer.line(@w, text: "    " + prefix + "_desc_copy,")
        writer.line(@w, text: "    " + prefix + "_desc_drop,")
        writer.line(@w, text: "    " + prefix + "_desc_eq,")
        writer.line(@w, text: "    " + prefix + "_hash,")
        writer.line(@w, text: "};")
        writer.blank(@w)

## Tests

test "widths get their own descriptors, and an aggregate hashes by its function"
    text = "record Point\n    x: i64\n\nfunction main()\n    _ = Point(x: 1)\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    names = ctype.new_names(s, p.decls)
    assert pointer(c, names, ty: table.int_ty_id(c.types)).must() == "&hero_desc_int"
    assert pointer(c, names, ty: table.str_ty(c.types)).must() == "&hero_desc_str"
    assert pointer(c, names, ty: table.unit_ty(c.types)).is_err()
    point = table.lookup(c.types, .named(decl: 0)).must()
    assert pointer(c, names, ty: point).must() == "&h_t_Point_desc"
    assert hash_call(c, names, ty: point, place: "&v->f_p").must() == "h_t_Point_hash(&v->f_p)"
    assert hash_call(c, names, ty: table.int_ty_id(c.types), place: "&v->f_n").must() == "(&hero_desc_int)->hash(&v->f_n)"
