# THE ORDER every typedef comes out in — one order over two kinds
# (design.md §4.2, §4.6, §4.20; panel 023 R3). Port of
# archive/bootstrap-rs/heroes/src/emit/typeorder.rs.
#
# emit_types is the SHAPE a declaration takes in C; this file is the
# sequence. C needs every struct complete before it is used by value,
# and a forward typedef does not rescue a by-value field — measured,
# the same two clang errors with and without it. The sequence spans
# both kinds at once, because each can contain the other: record Box
# { v: i64? } needs the option first and function grab() -> P? needs
# the record first; the two-pass version answered the first with
# "unknown type name" at exit 2.
#
# Port note: the Rust recurses carrying three &mut sets beside the
# writer; here the ORDER is computed first as a pure walk (one record
# of state, threaded functionally) and a second loop writes. An item
# is one i64 — decl*2 for a declared aggregate, ty*2+1 for a generated
# typedef — because the two index different tables. Pre-marking done
# before the children is safe where the bootstrap's post-marking
# needed an `open` belt: the checker refuses a by-value cycle (panel
# 023), so the graph is a DAG either way.

use ast
use source
use check/table
use check/state
use ir/phases
use emit/ctype
use emit/types
use emit/synth
use emit/writer
use parse
use resolve
use checker
use ir/lower
use emit/ffi_lookup

# Every typedef the program needs, each after everything it contains
# by value. The seed order is the two old orders concatenated —
# aggregates (panel 023's walk) then ascending type id — so a program
# with no cross-kind containment emits byte-identically to the
# two-pass form, and the double-emit determinism test still covers it.
#
# `kinds` is `phases.type_kinds` of the program, found ONCE for the whole
# build and handed to every translation unit (defect 229, 2026-10-03):
# this loop asked `mentions_generic` of every type id, a walk as deep as
# the type, in each of the 394 units of the compiler's own build, 8.9
# million calls with its other per-unit loop, and the square of a type's
# depth for one written 2,000 deep.
function definitions(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], want: synth.Wanted, kinds: [i64])
    seeds: [i64] @ []

    for decl in types.aggregates(c, decls)
        if synth.wants_decl(w: want, decl: decl)
            seeds @ seeds.push(decl * 2)

    id: i64 @ 0

    while id < kinds.len()
        if !phases.names_generic(kinds, ty: id)
            wanted: bool @ false

            match table.get(c.types, id)
                .fallible => wanted @ true
                .function_ty =>
                    if !names.funcs[id].is_err()
                        wanted @ true
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => wanted @ wanted
                .array | .fixed | .map | .named                           => wanted @ wanted
                .case_ty | .failure | .generic | .error                   => wanted @ wanted

            if wanted && synth.wants_type(w: want, ty: id)
                seeds @ seeds.push(id * 2 + 1)
        id @ id + 1

    order: Ordered @ Ordered(done: {}, out: [], depth: {}, deepest: 0)

    for seed in seeds
        order @ visit(order, c, names, decls, item: seed)

    # A struct typedef ends with its own blank line and a
    # function-pointer typedef does not, so the group owes one exactly
    # when the last thing written was the latter.
    owed_blank: bool @ false

    for item in order.out
        if item % 2 == 0
            types.declared(@w, c, names, s, decls, decl: item / 2)
            owed_blank @ false
        else
            ty = item / 2

            match table.get(c.types, ty)
                .fallible o =>
                    types.option(@w, c, names, name: ctype.option_of(names, ty: ty), payload: o.payload)
                    owed_blank @ false
                .function_ty fn_ty =>
                    types.function_type(
                        @w,
                        c,
                        names,
                        name: names.funcs[ty].must(),
                        params: fn_ty.params,
                        result: fn_ty.result
                    )
                    owed_blank @ true
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => continue
                .array | .fixed | .map | .named                           => continue
                .case_ty | .failure | .generic | .error                   => continue

    if owed_blank
        writer.blank(@w)

    if order.deepest > IN_ORDER_FROM
        in_order(@w, c, names, decls, out: order.out)

# HOW DEEP A CHAIN OF STRUCTS CLANG IS LEFT TO CONVERT BY ITSELF (defect 170,
# 2026-10-03). Clang turns a struct type into its own the first time a
# function needs it, and recurses into every struct the type holds by value,
# so a chain met from its top is converted by a recursion as deep as the
# chain, and clang's own stack ends it: 3,000 variants, each holding the one
# before, stopped `build` at exit 2 with *Illegal instruction: 4* (Apple clang
# 21 on arm64 macOS; `-fsyntax-only` passes, `-emit-llvm` dies, and the same
# clang under `ulimit -s 65520` compiles it in 2 s), and the CI's Apple clang
# died at 1,000 (defect 155). Past this depth `in_order` below hands clang the
# chain from its bottom, one level at a time, and no clang recurses deeper
# than a type's own fields.
#
# The number is a premise about clang and is written as one: a chain of 32 of
# this unit's structs met from its top, three C structs a level for a variant,
# is converted within the stack of every clang this compiler runs on; the
# least of those measured died at 1,000 variants (the CI's Apple clang). Its
# witness is `tests/golden/run/fixedbugs-170-variants-32-deep-build.hero`,
# which builds such a chain WITHOUT this help on every platform the net runs
# on and goes red on the first that cannot. Below the number a program's C is
# what it was, byte for byte.
constant IN_ORDER_FROM: i64
    32

# Every struct this unit defines, touched in the order the typedefs above were
# written, inside one function nothing calls: `p + 1` makes clang convert the
# struct to step over it, and each one's fields are already converted when it
# comes. `used` keeps clang from dropping a function no line calls before it
# converts anything, and it is static, so each unit carries its own. A group's
# record is the header's and is left to it. The function costs the binary its
# few instructions and is never run.
function in_order(@w: writer.Writer, c: state.Checked, names: ctype.Names, decls: [ast.Decl], out: [i64])
    writer.at_generated(@w)
    writer.line(@w, text: "__attribute__((used)) static void hero_tu_type_order(void *at) {")

    for item in out
        spelled = struct_named(c, names, decls, item: item)

        if spelled.len() > 0
            writer.line(@w, text: "    { " + spelled + " *p = at; (void)(p + 1); }")

    writer.line(@w, text: "}")
    writer.blank(@w)

# The C struct an item's typedef defines, or "" where this unit defines none:
# a function type's typedef is a pointer, and a group's record is the header's.
function struct_named(c: state.Checked, names: ctype.Names, decls: [ast.Decl], item: i64) -> str
    if item % 2 == 1
        ty = item / 2

        match table.get(c.types, ty)
            .fallible                                                 => return ctype.option_of(names, ty: ty)
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return ""
            .array | .fixed | .map | .named | .function_ty            => return ""
            .case_ty | .failure | .generic | .error                   => return ""
    decl = item / 2

    match decls[decl].kind
        .record_decl rec =>
            if rec.header.is_err()
                return ctype.of(names, decl: decl)
            return ""
        .variant_decl                                => return ctype.of(names, decl: decl)
        .constant_decl | .function_decl | .test_decl => return ""

record Ordered
    done: {i64: bool}
    out: [i64]
    # How many of this unit's own structs each item holds by value, itself
    # included, and the most of any (defect 170). A function type's typedef
    # and a group's record count none: C keeps a pointer to the one, and the
    # header lays out the other.
    depth: {i64: i64}
    deepest: i64

# Where the walk below stands in one item: the item, what it needs, and
# how many of those it has already gone into. A recursion keeps the same
# three in its frame.
record Frame
    item: i64
    needs: [i64]
    next: i64

# One item, after everything it needs. Post-order, so a dependency
# reached from two places is written once.
#
# **ITS FRAMES ARE A STACK OF ITS OWN, NOT THE MACHINE'S** (defect 140,
# 2026-10-01): a record holds the one before it by value, so the walk goes
# as deep as the records nest, and a recursion here would die where
# `synth.collect`'s did, a thousand records down. The stack keeps what a
# recursion's frames keep and in the same order, item marked done on the
# way in and written on the way out, so `out` is the recursion's sequence
# item for item, and the emitted C is unchanged with it.
function visit(order: Ordered, c: state.Checked, names: ctype.Names, decls: [ast.Decl], item: i64) -> Ordered
    if !order.done[item].is_err()
        return order
    st: Ordered @ order
    st.done[item] @ true
    frames: [Frame] @ [Frame(item: item, needs: needs(c, names, decls, item: item), next: 0)]
    live: i64 @ 1

    while live > 0
        top = frames[live - 1]

        if top.next < top.needs.len()
            need = top.needs[top.next]
            frames[live - 1].next @ top.next + 1

            if st.done[need].is_err()
                st.done[need] @ true
                entered = Frame(item: need, needs: needs(c, names, decls, item: need), next: 0)

                if live < frames.len()
                    frames[live] @ entered
                else
                    frames @ frames.push(entered)
                live @ live + 1
        else
            st.out @ st.out.push(top.item)

            # Every need is written by now (post-order over a DAG, the
            # checker refusing a by-value cycle), so its depth is known.
            held: i64 @ 0

            if struct_named(c, names, decls, item: top.item).len() > 0
                for need in top.needs
                    below = st.depth[need].default(0)

                    if below > held
                        held @ below

                held @ held + 1
            st.depth[top.item] @ held

            if held > st.deepest
                st.deepest @ held
            live @ live - 1

    return st

# What an item must be declared AFTER: by-value containment only,
# which is exactly what C needs a complete type for.
function needs(c: state.Checked, names: ctype.Names, decls: [ast.Decl], item: i64) -> [i64]
    written: [i64] @ []

    if item % 2 == 0
        for field in types.fields_of(decls, decl: item / 2)
            found = state.written_type(c, field.ty)

            if !found.is_err()
                written @ written.push(found.must())

        for one_case in types.cases_of(decls, decl: item / 2)
            for field in one_case.fields
                found = state.written_type(c, field.ty)

                if !found.is_err()
                    written @ written.push(found.must())
    else
        match table.get(c.types, item / 2)
            .fallible o => written @ written.push(o.payload)
            .function_ty fn_ty =>
                for p in table.params_of(c.types, fn_ty.params)
                    written @ written.push(p)

                written @ written.push(fn_ty.result)
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => written @ written
            .array | .fixed | .map | .named                           => written @ written
            .case_ty | .failure | .generic | .error                   => written @ written
    out: [i64] @ []

    for ty in written
        match table.get(c.types, ty)
            .named n    => out @ out.push(n.decl * 2)
            .case_ty ct => out @ out.push(ct.decl * 2)
            .fallible   => out @ out.push(ty * 2 + 1)
            .function_ty =>
                if !names.funcs[ty].is_err()
                    out @ out.push(ty * 2 + 1)
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => continue
            .array | .fixed | .map | .failure | .generic | .error     => continue

    return out

## Tests

test "cross-kind containment lands each typedef after what it holds"
    text = "record Box\n    v: i64?\n\nfunction grab(b: Box) -> Box?\n    if b.v.is_err()\n        return fail(code: \"empty\", msg: \"no value\")\n    return ok(b)\n\nfunction main()\n    got = grab(b: Box(v: ok(3)))\n    if !got.is_err()\n        print(got.must().v.must())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names: ctype.Names @ ctype.new_names(s, parsed.decls)
    names @ ctype.with_options(names, c: c, s: s, decls: parsed.decls)
    names @ ctype.with_functions(names, c: c, s: s, decls: parsed.decls, p: low.program)
    w: writer.Writer @ writer.new_writer("t")
    definitions(@w, c, names, s, parsed.decls, want: synth.everything(), kinds: phases.type_kinds(c))
    got = writer.finish(w)

    # Box holds an i64? by value, so the option's typedef must come
    # first; grab returns Box?, so that option must follow Box.
    i64_opt = ffi_lookup.char_index_of(text: got, needle: "0opt")
    box_at = ffi_lookup.char_index_of(text: got, needle: "typedef struct h_t_Box")
    assert !i64_opt.is_err()
    assert !box_at.is_err()
    assert i64_opt.must() < box_at.must()

# The typedefs of `n` records, each holding the one before by value.
function chain_text(n: i64) -> str
    parts: [str] @ ["record R0\n    v: i64\n"]

    for i in range(from: 1, to: n)
        parts @ parts.push("record R" + i.to_str() + "\n    inner: R" + (i - 1).to_str() + "\n")

    parts @ parts.push("function main()\n    xs: [R" + (n - 1).to_str() + "] = []\n    print(xs.len())\n")
    text = parts.join("\n")
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names: ctype.Names @ ctype.new_names(s, parsed.decls)
    names @ ctype.with_options(names, c: c, s: s, decls: parsed.decls)
    names @ ctype.with_functions(names, c: c, s: s, decls: parsed.decls, p: low.program)
    w: writer.Writer @ writer.new_writer("t")
    definitions(@w, c, names, s, parsed.decls, want: synth.everything(), kinds: phases.type_kinds(c))
    return writer.finish(w)

test "past 32 structs held by value clang is handed the chain from its bottom, and at 32 it is not (defect 170)"
    at_the_number = chain_text(n: 32)
    assert ffi_lookup.char_index_of(text: at_the_number, needle: "hero_tu_type_order").is_err()
    past = chain_text(n: 33)
    order_at = ffi_lookup.char_index_of(text: past, needle: "hero_tu_type_order")
    bottom = ffi_lookup.char_index_of(text: past, needle: "{ h_t_R0 *p = at; (void)(p + 1); }")
    top = ffi_lookup.char_index_of(text: past, needle: "{ h_t_R32 *p = at; (void)(p + 1); }")
    last_typedef = ffi_lookup.char_index_of(text: past, needle: "} h_t_R32;")
    assert !order_at.is_err()
    assert !bottom.is_err()
    assert !top.is_err()
    assert last_typedef.must() < order_at.must()
    assert bottom.must() < top.must()
