# What the header says about ONE FIELD — its type, its absence, and
# the one case where it has no size at all (design.md §4.19; panels
# 060, 071, 079). Port of archive/bootstrap-rs/heroes/src/emit/ffi_field.rs.
#
# The seam with emit_ffi_record is the one the two halves already had:
# that file answers "is this declaration the header's struct", this
# one "is this field the header's field". They fail at different spans
# and name different repairs: a field mistake is fixed on a field
# line, a declaration mistake by changing or marking the declaration.
# All three keep §7's narrowing: the name is recovered and then asked
# whether THIS PROGRAM declared it inside an extern group.

use token
use ast
use source
use diag
use emit/externs as emit_externs
use emit/extern_field
use emit/ffi_lookup
use parse
use resolve
use checker

# _Static_assert(_Generic(&((Color *)0)->r, …), "heroes-ffi-field
# Color r") failed: the header's struct does not have that field at
# that type. The diagnostic points at the FIELD, not at the record,
# because that is the token the author must change — and it is why
# extern_record puts its #line on the field rather than the
# declaration.
function field_type(s: source.Source, tree: ast.Ast, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: extern_field.FIELD_ASSERTION)

    if rest.is_err()
        return fail(code: "none", msg: "not a field assertion")
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() < 2
        return fail(code: "none", msg: "the marker's tail is not ours")
    type_name = parts[0]
    member = parts[1]
    found = record_field(s, tree, decls, type_name: type_name, member: member)

    if found.is_err()
        return fail(code: "none", msg: "no group record has this field")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_field_type",
        message: "`" + type_name + "." + member + "` is not `" + found.must().declared + "` in `" + found.must().header + "` — clang read the header's struct and the field disagrees",
        span: found.must().field_span
    )
    d.notes @ d.notes.push(
        "a group's `record` IS the header's struct (§4.19), so every field is at the header's own width and sign: correct `" + member + "`, or name the header that spells `" + type_name + "` this way"
    )
    return ok(d)

# The record a group declares under this C name, plus the span and the
# WRITTEN type of one of its fields — the text the author typed, which
# is what the message must quote back.
record RecordField
    header: str
    field_span: token.Span
    declared: str

function record_field(s: source.Source, tree: ast.Ast, decls: [ast.Decl], type_name: str, member: str) -> RecordField?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if rec.header.is_err()
                    continue

                for field in rec.fields
                    if source.span_text(s, field.name) == member
                        written = source.span_text(s, tree.types[field.ty].span)
                        return ok(
                            RecordField(header: emit_externs.unquoted(s, span: rec.header.must()), field_span: field.name, declared: written)
                        )
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail(code: "none", msg: "no group record has this field")

# clang's own "no member named 'red' in 'struct Color'": the header's
# struct exists and the field does not. It matches clang's wording
# rather than one of ours, and that is safe for the reason
# unknown_name is: the narrowing is record_group, not whose text this
# is. One mistake, THREE clang errors — the _Generic and the sizeof
# each name the member, and every construction site adds a designator
# error on top; add_once collapses them by span.
function unknown_field(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    tail = ffi_lookup.after(text: line, marker: "no member named '")

    if tail.is_err()
        return fail(code: "none", msg: "not a missing-member line")
    member = ffi_lookup.up_to_quote(tail.must())
    past = ffi_lookup.after(text: tail.must(), marker: "'")

    if past.is_err()
        return fail(code: "none", msg: "no closing quote")
    struct_part = ffi_lookup.after(text: past.must(), marker: "struct ")

    if struct_part.is_err()
        return fail(code: "none", msg: "no struct name on the line")
    type_name = ffi_lookup.trimmed(ffi_lookup.up_to_quote(struct_part.must()))
    group = record_group(s, decls, type_name: type_name)

    if group.is_err()
        return fail(code: "none", msg: "no group declares this record")
    field = field_span(s, decls, type_name: type_name, member: member)

    if field.is_err()
        return fail(code: "none", msg: "the record never names this field")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_unknown_field",
        message: "`" + group.must() + "` declares no `" + member + "` in `" + type_name + "` — clang read the header's struct and it has no such field",
        span: field.must()
    )
    d.notes @ d.notes.push(
        "a group's `record` IS the header's struct (§4.19), so a field is named exactly as the header names it — correct the spelling, or name the header that gives `" + type_name + "` a `" + member + "`"
    )
    return ok(d)

# The header a group's record was declared under.
function record_group(s: source.Source, decls: [ast.Decl], type_name: str) -> str?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err()
                    return ok(emit_externs.unquoted(s, span: rec.header.must()))
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail(code: "none", msg: "no group declares this record")

# Where the author wrote that field name, so the caret lands on the
# token they must change rather than on the record's own line.
function field_span(s: source.Source, decls: [ast.Decl], type_name: str, member: str) -> token.Span?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if rec.header.is_err()
                    continue

                for field in rec.fields
                    if source.span_text(s, field.name) == member
                        return ok(field.name)
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail(code: "none", msg: "the record never names this field")

# A field the header gives NO SIZE: a flexible array member (panel
# 079, discharging panel 071's condition). The old message was the
# generic ffi_field_type with a note saying to CORRECT the field — and
# for char data[] no length is correct, so a reader went hunting for a
# number the header does not have: §4.17 inverted. The emitter can
# tell the two apart because C makes the fact a constant — a flexible
# array member's tail is 0, measured {4, 4, 0} against {12, 4, 8} —
# and the route named is spec § 13 FFI's own: omit the field, mark the
# record partial, reach the bytes through the header's functions.
function flexible_array_member(s: source.Source, tree: ast.Ast, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: extern_field.FLEX_ASSERTION)

    if rest.is_err()
        return fail(code: "none", msg: "not a flex assertion")
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() < 2
        return fail(code: "none", msg: "the marker's tail is not ours")
    type_name = parts[0]
    member = parts[1]
    found = record_field(s, tree, decls, type_name: type_name, member: member)

    if found.is_err()
        return fail(code: "none", msg: "no group record has this field")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_flexible_array_member",
        message: "`" + found.must().header + "` gives `" + type_name + "." + member + "` no size — it is written there with empty brackets, so it is not a field this record can name at any length",
        span: found.must().field_span
    )
    d.notes @ d.notes.push(
        "leave `" + member + "` out and write the `record` `partial` (§4.19): what is left is the header's struct minus a member C itself does not size, and those bytes are reached through the functions the header declares for them"
    )
    return ok(d)

## Tests

test "field_type and flex read their markers and point at the field"
    text = "extern \"m.h\"\n    record Color\n        r: u8\n        data: i8[4]\n\nfunction touch(c: Color)\n    _ = c\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "t.hero:3:9: error: static assertion failed due to requirement 'x': heroes-ffi-field Color r"
    d = field_type(s, parsed.tree, parsed.decls, line: line)
    assert d.must().code == "ffi_field_type"
    assert d.must().message == "`Color.r` is not `u8` in `m.h` — clang read the header's struct and the field disagrees"
    flex = "t.hero:4:9: error: static assertion failed due to requirement 'y': heroes-ffi-flex Color data"
    f = flexible_array_member(s, parsed.tree, parsed.decls, line: flex)
    assert f.must().code == "ffi_flexible_array_member"
    assert f.must().message == "`m.h` gives `Color.data` no size — it is written there with empty brackets, so it is not a field this record can name at any length"

    # A record nobody declared in a group stays the compiler's.
    ghost = "e: static assertion failed: heroes-ffi-field Ghost r"
    assert field_type(s, parsed.tree, parsed.decls, line: ghost).is_err()

test "unknown_field reads clang's own wording and lands on the field token"
    text = "extern \"raylib.h\"\n    record Color\n        red: u8\n\nfunction touch(c: Color)\n    _ = c\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:44:60: error: no member named 'red' in 'struct Color'"
    d = unknown_field(s, parsed.decls, line: line)
    assert d.must().code == "ffi_unknown_field"
    assert d.must().message == "`raylib.h` declares no `red` in `Color` — clang read the header's struct and it has no such field"

    # The caret sits on the author's own field token.
    assert source.span_text(s, d.must().span) == "red"

    # A struct this program never declared is refused.
    other = "main.c:44:60: error: no member named 'x' in 'struct Ghost'"
    assert unknown_field(s, parsed.decls, line: other).is_err()
