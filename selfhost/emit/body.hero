# A function's C body: the prologue, the blocks, and what is left out
# (design.md §3.1; panels 020, 021, 029, 038). Port of
# crates/heroes/src/emit/body.rs.
#
# THE PROLOGUE EXISTS BECAUSE GOTO MAY NOT JUMP OVER AN INITIALISATION.
# Every slot and temporary is declared at the top, and nothing is given
# an initial value: a Heroes binding is always initialised, so a C
# local clang thinks may be read uninitialised is a LOWERING bug —
# exactly what -Werror=uninitialized is in the flag set to catch.
# Zero-initialising would hide it. The ONE exception (panel 021 R3): a
# refcounted slot is zeroed so the exit sweep is unconditional — decref
# of the null non-value is a no-op, and the alternative is a liveness
# pass. clang's ARC spec licenses exactly this for __strong locals.
#
# A BLOCK NOTHING JUMPS TO IS OMITTED ENTIRELY, not merely unlabelled:
# C is physical, and an unlabelled block would fall through from the
# one above. A CORRECT program produces one (an if whose both arms
# return leaves an unreachable join), and emitting its label costs
# -Wunused-label on every build.
#
# Port note: the Rust asks decls::emitted first (the caller filters
# here, as with prototypes) and externs::is_extern_constant — the
# latter is the eight lines below; externs.rs' remainder arrives with
# the FFI cluster.

use ast
use source
use check/state
use ir/containers
use ir/layout
use emit/mangle
use emit/ctype
use emit/signature
use emit/callback_guard
use emit/inst
use emit/term
use emit/unread
use emit/writer
use parse
use resolve
use checker
use ir/lower

# An extern constant has no blocks, so it takes none of the machinery:
# what it needs is one line — the C name, read where the preprocessor
# can see it (§4.19, panel 038: the accessor IS mangled, the body's
# name is not, so the macro cannot eat its own definition).
function is_extern_constant(decls: [ast.Decl], f: containers.Function) -> bool
    match decls[f.decl].kind
        .constant_decl k                                           => return !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => return false

    return false

function definition(@w: writer.Writer, p: containers.Program, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, guarded_decls: {i64: bool})
    writer.blank(@w)

    # The signature is pointed at the author's declaration: a clang
    # error about a parameter type lands on the line that wrote it.
    writer.at_span(@w, s, offset: f.span.start)

    # The instance's types, above it: the hash in the name does not
    # carry them and a reader of --emit-c needs them (panel 029 R5).
    if f.instance.len() > 0
        writer.line(
            @w,
            text: "/* " + f.name + "<" + signature.render_instance(c, s, decls, bound: f.instance) + "> */"
        )

    if is_extern_constant(decls, f)
        extern_name = source.span_text(s, decls[f.decl].name)
        writer.line(@w, text: signature.signature(f, c, names, s, decls) + " {")
        writer.at_generated(@w)
        writer.line(@w, text: "    return " + extern_name + ";")
        writer.line(@w, text: "}")
        return
    writer.line(@w, text: signature.signature(f, c, names, s, decls) + " {")
    writer.at_generated(@w)

    # Before the prologue, because the prologue already touches this
    # runtime's values and the whole point of the guard is that a
    # foreign thread must touch none of them (panel 111 R9).
    callback_guard.entry(@w, s, f, guarded_decls: guarded_decls)
    live = reachable(f)
    read = unread.emitted_reads(f, c)
    prologue(@w, c, names, f, live: live, read: read)
    writer.line(@w, text: "    goto " + mangle.block(0) + ";")
    index: i64 @ 0

    for blk in f.blocks
        if live[index]
            writer.line(@w, text: mangle.block(index) + ":")

            for one in blk.insts
                inst.emit(@w, p, c, names, s, decls, f, inst: one, live_values: read)

            term.emit(@w, f, c, term: blk.term)
        index @ index + 1

    writer.at_generated(@w)
    writer.line(@w, text: "}")

# Which blocks are reachable — a lookup, not an analysis: the IR
# already carries the answer in preds.
function reachable(f: containers.Function) -> [bool]
    live: [bool] @ []
    index: i64 @ 0

    for blk in f.blocks
        live @ live.push(index == 0 || blk.preds.len() > 0)
        index @ index + 1

    return live

function prologue(@w: writer.Writer, c: state.Checked, names: ctype.Names, f: containers.Function, live: [bool], read: {i64: bool})
    index: i64 @ 0

    for slot in f.slots
        # A parameter is already declared by the signature. A mutable
        # one is declared here instead: the pointer is the parameter,
        # and the slot is the local copy §4.8 says the callee works on.
        is_param: bool @ false

        for param in f.params
            if param == index
                is_param @ true

        mutable: bool @ false

        match slot.kind
            .param_slot ps =>
                if ps.mutable
                    mutable @ true
            .local_slot | .synthetic_slot => mutable @ mutable

        if is_param && !mutable
            index @ index + 1
            continue
        spelled = ctype.c_type(names, c: c, ty: slot.ty)

        if !spelled.is_err()
            initialiser: str @ ""

            if layout.is_refcounted(c, slot.ty)
                initialiser @ " = {0}"

            # A slot that is written and never read is told to C that the
            # silence is deliberate. **This comment said `_ = v` was the
            # only way to reach such a slot, and the premise was false**
            # (panel 108, 2026-09-04): a cell passed as an `@` argument and
            # never read afterwards reaches it too — `error: ptr @ nullptr`
            # handed to `sqlite3_exec` — because the resolver counts the
            # copy-in as a read and accepts the program. The attribute is
            # harmless there and buys nothing, measured: with the slot's
            # address taken, clang warns about neither form. A refcounted
            # slot never gets it, and that FALLS OUT: the exit sweep
            # decrefs it (`decref_slot`, panel 106), so it is read.
            deliberate: str @ ""

            if !unread.slot_is_read(f, live, read: read, slot: index)
                deliberate @ "__attribute__((unused)) "
            writer.line(
                @w,
                text: "    " + deliberate + spelled.must() + " " + mangle.slot(index: index, name: slot.name) + initialiser + ";"
            )
        index @ index + 1

    value_at: i64 @ 0

    for ty in f.values
        keep: bool @ true

        if ctype.is_unit(c, ty: ty)
            keep @ false

        if keep && !unread.assigned(f, live, value: value_at)
            keep @ false

        # A discarded result is never assigned either, so declaring it
        # would be the unused variable this rule exists to stop. The two
        # decisions agree by reading the same set.
        if keep && unread.discarded(f, live, value: value_at, read: read)
            keep @ false

        if keep
            spelled = ctype.c_type(names, c: c, ty: ty)

            if !spelled.is_err()
                initialiser: str @ ""

                if layout.is_refcounted(c, ty)
                    initialiser @ " = {0}"
                writer.line(
                    @w,
                    text: "    " + spelled.must() + " " + mangle.value(value_at) + initialiser + ";"
                )
        value_at @ value_at + 1

    # Copy-in, after every declaration: §4.8's first half.
    for param in f.params
        declared = f.slots[param]
        mutable: bool @ false

        match declared.kind
            .param_slot ps =>
                if ps.mutable
                    mutable @ true
            .local_slot | .synthetic_slot => mutable @ mutable

        if mutable
            writer.line(
                @w,
                text: "    " + mangle.slot(index: param, name: declared.name) + " = *" + mangle.out_param(index: param, name: declared.name) + ";"
            )

## Tests

function has(text: str, needle: str) -> bool
    if needle.len() == 0
        return true
    stop = text.len() - needle.len()
    at: i64 @ 0

    while at <= stop
        if text.slice(from: at, to: at + needle.len()) == needle
            return true
        at @ at + 1

    return false

test "a whole function prints: signature, prologue, goto bb0, blocks, close"
    text = "function add(a: i64, b: i64) -> i64\n    return a + b\n\nfunction main()\n    print(add(a: 1, b: 2))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names1 = ctype.with_options(names0, c: c, s: s, decls: parsed.decls)
    names = ctype.with_functions(names1, c: c, s: s, decls: parsed.decls, p: low.program)
    w: writer.Writer @ writer.new_writer("t")
    none: {i64: bool} = {}
    definition(@w, low.program, c, names, s, parsed.decls, low.program.functions[0], guarded_decls: none)
    got = writer.finish(w)
    assert has(text: got, needle: "int64_t h_t_add(int64_t h0_a, int64_t h1_b) {")
    assert has(text: got, needle: "    int64_t t1;")
    assert has(text: got, needle: "    int64_t t3;")
    assert has(text: got, needle: "    goto bb0;")
    assert has(text: got, needle: "bb0:")
    assert has(text: got, needle: "    if (__builtin_add_overflow(t1, t2, &t3)) hero_panic_overflow();")
    assert has(text: got, needle: "    return t3;")

    # Deterministic: the same input prints the same bytes.
    again: writer.Writer @ writer.new_writer("t")
    definition(@again, low.program, c, names, s, parsed.decls, low.program.functions[0], guarded_decls: none)
    assert writer.finish(again) == got

test "an unreachable join is omitted entirely, label and all"
    text = "function pick(flag: bool) -> i64\n    if flag\n        return 1\n    else\n        return 2\n\nfunction main()\n    print(pick(true))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names = ctype.with_functions(
        ctype.with_options(names0, c: c, s: s, decls: parsed.decls),
        c: c,
        s: s,
        decls: parsed.decls,
        p: low.program
    )
    w: writer.Writer @ writer.new_writer("t")
    none: {i64: bool} = {}
    definition(@w, low.program, c, names, s, parsed.decls, low.program.functions[0], guarded_decls: none)
    got = writer.finish(w)

    # The join block (bb1, created before the arms) has no preds: its
    # label must not appear.
    assert !has(text: got, needle: "bb1:")
    assert has(text: got, needle: "bb2:")
