# A function's C body: the prologue, the blocks, and what is left out
# (design.md §3.1; panels 020, 021, 029, 038). Port of
# heroes/src/emit/body.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# THE PROLOGUE, what it declares and what it zeroes, is `emit/prologue.hero`
# (moved out on 2026-10-10 with defect 472, which writes it as one line).
#
# A BLOCK NOTHING JUMPS TO IS OMITTED ENTIRELY, not merely unlabelled:
# C is physical, and an unlabelled block would fall through from the
# one above. A CORRECT program produces one (an if whose both arms
# return leaves an unreachable join), and emitting its label costs
# -Wunused-label on every build.
#
# Port note: the Rust asks decls::emitted first (the caller filters
# here, as with prototypes) and externs::is_extern_constant — the
# latter is the eight lines below; externs.rs' remainder arrives with
# the FFI cluster.

use ast
use source
use check/state
use ir/containers
use ir/instances
use emit/mangle
use emit/ctype
use emit/signature
use emit/static_constant
use emit/callback_guard
use emit/callback_thunk
use emit/inst
use emit/term
use emit/unread
use emit/constant_accessor
use emit/writer
use emit/lend_local
use emit/prologue
use emit/nodebug
use emit/entry_stop
use parse
use resolve
use checker
use ir/lower
use ir/mono
use ir/place_store
use ir/own
use cli/strings

# An extern constant has no blocks, so it takes none of the machinery:
# what it needs is one line — the C name, read where the preprocessor
# can see it (§4.19, panel 038: the accessor IS mangled, the body's
# name is not, so the macro cannot eat its own definition).
function is_extern_constant(decls: [ast.Decl], f: containers.Function) -> bool
    match decls[f.decl].kind
        .constant_decl k                                           => return !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => return false

    return false

# A constant of literals is written twice, its static block and the function
# that builds it, and the runtime's switch picks one (panel 195,
# `emit/static_constant.hero`); every other function once. `p` is the
# program held with its index, built once per program (defect 492).
function definition(@w: writer.Writer, p: instances.Held, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, guarded_decls: {i64: bool})
    laid = static_constant.laid_for(p.program, c, names, s, decls, f: f)

    if !laid.is_err()
        static_constant.open(@w, c, names, s, decls, f: f, laid: laid.must())
    built(@w, p, c, names, s, decls, f: f, guarded_decls: guarded_decls)

    if !laid.is_err()
        static_constant.close(@w)

function built(@w: writer.Writer, p: instances.Held, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, guarded_decls: {i64: bool})
    writer.blank(@w)

    # A constant whose value a header holds has an accessor of its own
    # (`emit/constant_accessor.hero`): no prologue, no blocks.
    if is_extern_constant(decls, f)
        constant_accessor.accessor(@w, f, c, names, s, decls)
        return

    # The signature is pointed at the author's declaration: a clang
    # error about a parameter type lands on the line that wrote it.
    writer.at_span(@w, s, offset: f.span.start)

    # The instance's types, above it: the hash in the name does not
    # carry them and a reader of --emit-c needs them (panel 029 R5).
    if f.instance.len() > 0
        writer.line(
            @w,
            text: "/* " + f.name + "<" + signature.render_instance(c, s, decls, bound: f.instance) + "> */"
        )
    writer.line(@w, text: signature.signature(f, c, names, s, decls) + " {")
    live = reachable(f)
    read = unread.emitted_reads(f, c)
    owner = source.component_at(s, decls[f.decl].span.start) + "." + f.name
    entry = prologue.written(c, names, f, live: live, read: read, owner: owner, copies_bytes: w.copies_bytes)

    for one in entry.defines
        writer.line(@w, text: one)

    # THE ENTRY IS ONE PHYSICAL LINE UNDER THE FUNCTION'S OWN LINE (defect
    # 472, panel 200's R4): the thread guard, the prologue and the jump to the
    # first block, so a `step` into the function and a breakpoint on it stop
    # on its `function` line and never on the generated C. Since panel 219's
    # R1 it is written on the signature's physical line, which the same
    # `.hero` line anchors (`emit/line_join.hero`). One line, because
    # `#line` anchors one line and C counts on from it: a second would claim
    # the author's next line for housekeeping (design.md §3.1), and a `#line`
    # before each grew the seed by 28% (the sitting's critic). The guard comes
    # first, because the prologue already touches this runtime's values and
    # the whole point of the guard is that a foreign thread must touch none of
    # them (panel 111 R9). The exit and the cleanup stay the generated file's
    # (defect 335). A group record's `deprecated` attribute needs no word
    # here: a header's deprecations are quiet over the whole unit after the
    # groups' close (`emit/deprecation.hero`, panel 208).
    statements: [str] @= []
    guard = callback_guard.entry(s, f, guarded_decls: guarded_decls)

    if guard != ""
        statements @ statements.push(guard)

    for one in entry.lines
        statements @ statements.push(one)

    # An instruction on the function's line for every architecture, which a
    # `step` into the function stops on: x86-64's clang drops the jump to the
    # block that follows (`emit/entry_stop.hero`, defect 2038).
    statements @ statements.push(entry_stop.WORD)
    statements @ statements.push("goto " + mangle.block(0) + ";")
    writer.line(@w, text: "    " + statements.join(" "))
    released = lend_local.releases(c, names, f)
    index: i64 @= 0

    for blk in f.blocks
        if live[index]
            writer.line(@w, text: mangle.block(index) + ":")

            for one in blk.insts
                inst.emit(@w, p, c, names, s, decls, f, inst: one, live_values: read, ends: blk.term)

            term.emit(@w, f, c, term: blk.term, released: released)
        index @ index + 1

    writer.at_generated(@w)
    writer.line(@w, text: "}")

    # A local lent in place has its name defined for this body alone (panel
    # 196's R7, `emit/lend_local.hero`).
    lend_local.undefine(@w, c, names, f)

    # The thunk C is handed instead of this function's own address (panel
    # 177's item 2), beside the definition it wraps, so the two are one
    # thing to read and the same translation unit links both.
    callback_thunk.definition(@w, c, names, s, decls, f, guarded_decls: guarded_decls)

# Which blocks are reachable — a lookup, not an analysis: the IR
# already carries the answer in preds.
function reachable(f: containers.Function) -> [bool]
    live: [bool] @= []
    index: i64 @= 0

    for blk in f.blocks
        live @ live.push(index == 0 || blk.preds.len() > 0)
        index @ index + 1

    return live

## Tests

# The names a prologue's statement declares, in order: the last word before
# each `,` or `;`, what follows an `=` left out.
function declared_names(line: str) -> [str]
    out: [str] @= []
    last: str @= ""
    from: i64 @= 0 - 1
    skipping: bool @= false
    at: i64 @= 0

    while at < line.len()
        b = line[at]
        letter = b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95

        if letter && !skipping
            if from < 0
                from @ at
        else
            if from >= 0
                last @ line.slice(from: from, to: at)
                from @ 0 - 1

            if b == 61
                skipping @ true

            if b == 44 || b == 59
                out @ out.push(last)
                skipping @ false
        at @ at + 1

    return out

test "a whole function prints: signature, prologue, goto bb0, blocks, close"
    text = "function add(a: i64, b: i64) -> i64\n    return a + b\n\nfunction main()\n    print(add(a: 1, b: 2))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names1 = ctype.with_options(names0, c: c, s: s, decls: parsed.decls)
    names = ctype.with_functions(names1, c: c, s: s, decls: parsed.decls, p: low.program)
    w: writer.Writer @= writer.new_writer("t")
    none: {i64: bool} = {}
    definition(
        @w,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    got = writer.finish(w)
    assert strings.holds(text: got, needle: "int64_t h_t_add(int64_t h0_a, int64_t h1_b) {")

    # The entry on the function's own line (defect 472), its temporaries
    # kept from the debugger (panel 213's R1), on its signature's physical
    # line and the first block's label with it, and the body's lines on the
    # next, each on the one before since panel 219's R1.
    assert strings.holds(
        text: got,
        needle: "#line 1 \"t.hero\"\nint64_t h_t_add(int64_t h0_a, int64_t h1_b) { HERO_NODEBUG int64_t t1, t2, t3; HERO_ENTRY_STOP; goto bb0; bb0:\n"
    )
    assert strings.holds(
        text: got,
        needle: "\n    t1 = h0_a; t2 = h1_b; if (__builtin_add_overflow(t1, t2, &t3)) hero_panic_overflow(); return t3;\n"
    )

    # Deterministic: the same input prints the same bytes.
    again: writer.Writer @= writer.new_writer("t")
    definition(
        @again,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    assert writer.finish(again) == got

test "an unreachable join is omitted entirely, label and all"
    text = "function pick(flag: bool) -> i64\n    if flag\n        return 1\n    else\n        return 2\n\nfunction main()\n    print(pick(true))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names = ctype.with_functions(
        ctype.with_options(names0, c: c, s: s, decls: parsed.decls),
        c: c,
        s: s,
        decls: parsed.decls,
        p: low.program
    )
    w: writer.Writer @= writer.new_writer("t")
    none: {i64: bool} = {}
    definition(
        @w,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    got = writer.finish(w)

    # The join block (bb1, created before the arms) has no preds: its
    # label must not appear.
    assert !strings.holds(text: got, needle: "bb1:")
    assert strings.holds(text: got, needle: "bb2:")

# Panel 213's R1: the debugger is shown what the author wrote and nothing the
# lowering invented. The witness is the program's own names, not the IR's
# kinds the prologue reads: a name the author wrote is shown, and a `$` name,
# which no Heroes program can spell, is hidden, of both kinds the lowering
# makes here, an `$own` slot and the `$ret0` two ways out return through.
test "the prologue hides every temporary and every slot the lowering invented, and nothing the author wrote"
    text = "function greet(name: str, loud: bool) -> str\n    width = name.len()\n\n    if loud\n        return name + \"!\"\n    return name + width.to_str()\n\nfunction main()\n    print(greet(name: \"ada\", loud: false))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)

    # The passes a build runs before it emits (`cli/compile.hero`): the
    # ownership pass is what invents the `$own` slots.
    p: containers.Program @= low.program
    cc: state.Checked @= c
    assert mono.run(@p, @cc, s, parsed.decls).len() == 0
    place_store.run(@p)
    own.run(@p, cc)
    names = ctype.with_functions(
        ctype.with_options(ctype.new_names(s, parsed.decls), c: cc, s: s, decls: parsed.decls),
        c: cc,
        s: s,
        decls: parsed.decls,
        p: p
    )
    f = p.functions[0]
    got = prologue.written(
        cc,
        names,
        f,
        live: reachable(f),
        read: unread.emitted_reads(f, cc),
        owner: "t.greet",
        copies_bytes: false
    )
    shown: [str] @= []
    hidden: [str] @= []
    temporaries: i64 @= 0

    # A marked declaration hides every name it declares, one spelling's
    # temporaries and invented slots sharing it (defect 2050); an unmarked one
    # declares one binding the author wrote.
    for line in got.lines
        named = declared_names(line)

        if strings.starts_with(text: line, prefix: nodebug.MARK)
            for one in named
                if strings.starts_with(text: one, prefix: "t")
                    temporaries @ temporaries + 1
                else
                    hidden @ hidden.push(one)
        else
            assert named.len() == 1
            shown @ shown.push(named[0])

    # `width`, the one binding; `name` and `loud` are the signature's.
    assert shown.len() == 1
    assert strings.ends_with(text: shown[0], suffix: "_width")
    assert temporaries > 0
    invented: [str] @= []
    index: i64 @= 0

    for slot in f.slots
        if strings.starts_with(text: slot.name, prefix: "$")
            invented @ invented.push(mangle.slot(index: index, name: slot.name))
        index @ index + 1

    assert hidden.len() == invented.len()

    for one in invented
        assert strings.holds(text: " " + hidden.join(" ") + " ", needle: " " + one + " ")

    assert strings.holds(text: hidden.join(" "), needle: "own")
    assert strings.holds(text: hidden.join(" "), needle: "ret0")
