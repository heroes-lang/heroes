# A function's C body: the prologue, the blocks, and what is left out
# (design.md §3.1; panels 020, 021, 029, 038). Port of
# archive/bootstrap-rs/heroes/src/emit/body.rs.
#
# EVERY SLOT AND TEMPORARY IS DECLARED IN THE PROLOGUE, as one place to
# read them, and not because C forbids the jump. This header said *goto
# may not jump over an initialisation*, and that is C++'s rule: C accepts
# it, compiled under this project's flags by panel 182's critic
# (`gotoinit.c`, exit 0), where clang++ refuses it.
#
# WHAT THE PROLOGUE INITIALISES, and why each class is what it is (panel
# 182, on panel 021 R3):
# - A VALUE, a temporary `t<N>`, is NEVER ZEROED. Its one definition
#   precedes every read of it on every path, which the verifier proves
#   (`ir/values.hero`: dominance between blocks, `in_order` within one),
#   and the C writes each definition whole (`emit/container.hero`'s map
#   lookup is where it did not). So a C local clang thinks may be read
#   uninitialised is a LOWERING bug, which is what -Werror=uninitialized
#   is in the flag set to catch, and a zero would hide it: the seed held
#   81,680 zeroed values at `0fc98107`, every one dead by four
#   instruments, each taken out of that check. clang sees a read BY
#   VALUE; a read through an address (`release(&t)`) it does not see,
#   and there the verifier stands alone.
# - A REFCOUNTED SLOT IS ZEROED (panel 021 R3), because rule 3's
#   old-value load reads every slot before its first store (`ir/own.hero`:
#   load old, store, release old), and the exit sweep releases every
#   local and synthetic slot whether the path that stored it ran or not.
#   decref of the null non-value is a no-op; the alternative is a
#   liveness pass. clang's ARC spec licenses exactly this for __strong
#   locals.
# - AN `@` PARAMETER HAS NO SLOT IN C AT ALL (panel 196's R1): it is the
#   caller's place, reached through the pointer the signature declares
#   (`places.slot_lvalue`), so the body reads and writes the caller's
#   place itself and C handed it from inside the body receives that place.
#   Until R1 the prologue declared a local and copied the place into it,
#   `h0_s = *ph0_s;`, and every exit copied it back: §4.8's copy in, copy
#   out lowered literally. Inside Heroes the two lowerings are one meaning,
#   because an `@` place is exclusive (defect 011's refusal of two `@`
#   arguments of one place; a by-value argument the call writes the root
#   of is held for the call, `ir/held.hero`); to C they were two addresses,
#   and a library that keeps one, zlib's stream or libuv's handle, was
#   handed a frame that died when the wrapper returned (defect 413).
# - Nothing else is initialised, for the value's reason: a Heroes
#   binding is always initialised, and clang checks the rest.
#
# A BLOCK NOTHING JUMPS TO IS OMITTED ENTIRELY, not merely unlabelled:
# C is physical, and an unlabelled block would fall through from the
# one above. A CORRECT program produces one (an if whose both arms
# return leaves an unreachable join), and emitting its label costs
# -Wunused-label on every build.
#
# Port note: the Rust asks decls::emitted first (the caller filters
# here, as with prototypes) and externs::is_extern_constant — the
# latter is the eight lines below; externs.rs' remainder arrives with
# the FFI cluster.

use ast
use source
use check/state
use ir/containers
use ir/instances
use ir/layout
use emit/mangle
use emit/ctype
use emit/signature
use emit/static_constant
use emit/callback_guard
use emit/callback_thunk
use emit/field_lend
use emit/inst
use emit/term
use emit/unread
use emit/constant_accessor
use emit/deprecation
use emit/writer
use emit/lend_local
use parse
use resolve
use checker
use ir/lower
use cli/strings

# An extern constant has no blocks, so it takes none of the machinery:
# what it needs is one line — the C name, read where the preprocessor
# can see it (§4.19, panel 038: the accessor IS mangled, the body's
# name is not, so the macro cannot eat its own definition).
function is_extern_constant(decls: [ast.Decl], f: containers.Function) -> bool
    match decls[f.decl].kind
        .constant_decl k                                           => return !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => return false

    return false

# A constant of literals is written twice, its static block and the function
# that builds it, and the runtime's switch picks one (panel 195,
# `emit/static_constant.hero`); every other function once. `p` is the
# program held with its index, built once per program (defect 492).
function definition(@w: writer.Writer, p: instances.Held, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, guarded_decls: {i64: bool})
    laid = static_constant.laid_for(p.program, c, names, s, decls, f: f)

    if !laid.is_err()
        static_constant.open(@w, c, names, s, decls, f: f, laid: laid.must())
    built(@w, p, c, names, s, decls, f: f, guarded_decls: guarded_decls)

    if !laid.is_err()
        static_constant.close(@w)

function built(@w: writer.Writer, p: instances.Held, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, guarded_decls: {i64: bool})
    writer.blank(@w)

    # A constant whose value a header holds has an accessor of its own
    # (`emit/constant_accessor.hero`): no prologue, no blocks.
    if is_extern_constant(decls, f)
        constant_accessor.accessor(@w, f, c, names, s, decls)
        return

    # The signature is pointed at the author's declaration: a clang
    # error about a parameter type lands on the line that wrote it.
    writer.at_span(@w, s, offset: f.span.start)

    # The instance's types, above it: the hash in the name does not
    # carry them and a reader of --emit-c needs them (panel 029 R5).
    if f.instance.len() > 0
        writer.line(
            @w,
            text: "/* " + f.name + "<" + signature.render_instance(c, s, decls, bound: f.instance) + "> */"
        )
    writer.line(@w, text: signature.signature(f, c, names, s, decls) + " {")
    writer.at_generated(@w)

    # Before the prologue, because the prologue already touches this
    # runtime's values and the whole point of the guard is that a
    # foreign thread must touch none of them (panel 111 R9).
    callback_guard.entry(@w, s, f, guarded_decls: guarded_decls)
    live = reachable(f)
    read = unread.emitted_reads(f, c)
    owner = source.component_at(s, decls[f.decl].span.start) + "." + f.name

    # The prologue is the compiler's line inside the program's definition, a
    # group record's `deprecated` attribute quiet over it (defect 571).
    typed = deprecation.before_prologue(@w, c, s, decls, f)
    prologue(@w, c, names, f, live: live, read: read, owner: owner)
    deprecation.after_prologue(@w, typed: typed)
    writer.line(@w, text: "    goto " + mangle.block(0) + ";")
    released = lend_local.releases(c, names, f)
    index: i64 @ 0

    for blk in f.blocks
        if live[index]
            writer.line(@w, text: mangle.block(index) + ":")

            for one in blk.insts
                inst.emit(@w, p, c, names, s, decls, f, inst: one, live_values: read)

            term.emit(@w, f, c, term: blk.term, released: released)
        index @ index + 1

    writer.at_generated(@w)
    writer.line(@w, text: "}")

    # A local lent in place has its name defined for this body alone (panel
    # 196's R7, `emit/lend_local.hero`).
    lend_local.undefine(@w, c, names, f)

    # The thunk C is handed instead of this function's own address (panel
    # 177's item 2), beside the definition it wraps, so the two are one
    # thing to read and the same translation unit links both.
    callback_thunk.definition(@w, c, names, s, decls, f, guarded_decls: guarded_decls)

# Which blocks are reachable — a lookup, not an analysis: the IR
# already carries the answer in preds.
function reachable(f: containers.Function) -> [bool]
    live: [bool] @ []
    index: i64 @ 0

    for blk in f.blocks
        live @ live.push(index == 0 || blk.preds.len() > 0)
        index @ index + 1

    return live

function prologue(@w: writer.Writer, c: state.Checked, names: ctype.Names, f: containers.Function, live: [bool], read: {i64: bool}, owner: str)
    # What every declaration below asks of the function, read once
    # (defect 112): the first live writer of each temporary, and which
    # slots the emitted C reads.
    d = unread.defs(f, live)
    slots_read = unread.slots_read(f, live, d, read)
    index: i64 @ 0

    # A local an `extern` call is lent whole through `@` lives in a guarded
    # region instead of this frame (panel 196's R7), declared where its slot
    # would be.
    in_place: {i64: bool} @ {}

    for at in lend_local.guarded(c, names, f)
        in_place[at] @ true

    # A parameter is already declared by the signature: a plain one as its
    # value, an `@` one as the pointer to the caller's place, which is the
    # slot (the header above says why it has no local). Asked of a set made
    # once, where each slot walked every parameter (defect 478, 2026-10-08):
    # defect 230's shape, the parameters times the slots.
    params: {i64: bool} @ {}

    for param in f.params
        params[param] @ true

    for slot in f.slots
        if !params[index].is_err()
            index @ index + 1
            continue

        if !in_place[index].is_err()
            lend_local.declare(@w, c, names, f, at: index, owner: owner)
            index @ index + 1
            continue
        spelled = ctype.c_type(names, c: c, ty: slot.ty)

        if !spelled.is_err()
            initialiser: str @ ""
            name = mangle.slot(index: index, name: slot.name)
            by_bytes: bool @ false

            # Refcounted (the header above says why). Past `typeorder`'s
            # depth the zero is written by bytes (defect 539): `{0}` sends
            # clang down the struct by brace elision, a recursion as deep as
            # the chain, which died between 750 and 875 records holding a
            # `str` (Apple clang 21, arm64 macOS), where the memset builds at
            # 1,000. Below it a unit's C is what it was, byte for byte.
            if layout.is_refcounted(c, slot.ty)
                if w.copies_bytes
                    by_bytes @ true
                else
                    initialiser @ " = {0}"

            # A slot that is written and never read is told to C that the
            # silence is deliberate. **This comment said `_ = v` was the
            # only way to reach such a slot, and the premise was false**
            # (panel 108, 2026-09-04): a cell passed as an `@` argument and
            # never read afterwards reaches it too — `error: ptr @ nullptr`
            # handed to `sqlite3_exec` — because the resolver counts the
            # copy-in as a read and accepts the program. The attribute is
            # harmless there and buys nothing, measured: with the slot's
            # address taken, clang warns about neither form. A refcounted
            # slot never gets it, and that FALLS OUT: the exit sweep
            # decrefs it (`decref_slot`, panel 106), so it is read.
            deliberate: str @ ""

            if !slots_read[index]
                deliberate @ "__attribute__((unused)) "
            writer.line(
                @w,
                text: "    " + deliberate + spelled.must() + " " + name + initialiser + ";"
            )

            if by_bytes
                writer.line(@w, text: "    __builtin_memset(&" + name + ", 0, sizeof " + name + ");")
        index @ index + 1

    value_at: i64 @ 0
    lends = field_lend.const_lends(f)

    for ty in f.values
        keep: bool @ true

        if ctype.is_unit(c, ty: ty)
            keep @ false

        if keep && !unread.assigned(d, value: value_at)
            keep @ false

        # A discarded result is never assigned either, so declaring it
        # would be the unused variable this rule exists to stop. The two
        # decisions agree by reading the same set.
        if keep && unread.discarded(f, d, value: value_at, read: read)
            keep @ false

        if keep
            spelled = ctype.c_type(names, c: c, ty: ty)

            # A temporary takes NO initialiser, refcounted or not (panel
            # 182; the header above says why). Until then this line zeroed a
            # refcounted one, carried from the Rust port with no comment
            # beside it (`body.rs:178`), where panel 021 R3 licensed slots.
            if !spelled.is_err()
                # The TEMPORARY half of the attribute above (panel 118).
                # An op that may NOT lose its destination still prints
                # its assignment, because the overflow guard, the nan
                # panic and an aggregate's generated `eq` are printed
                # WITH it — so a result nothing reads leaves both the
                # declaration and the assignment standing, and clang
                # says `set but not used`. Measured: every
                # `_ = f().is_err()`, and `_ = a == b` on a `str` and
                # on an array.
                #
                # The attribute rather than dropping the destination,
                # which is the narrower repair and was tried first: on
                # an AGGREGATE the assignment is a runtime call
                # carrying its own check — `hero_array_require`, and a
                # partial record's deliberate `hero_panic` in
                # `emit/structural.hero` — so dropping it would delete
                # a tripwire on exactly the lines nobody reads the
                # answer of. Saying the silence is deliberate keeps
                # every check and needs no per-operator list to stay
                # true.
                deliberate: str @ ""

                if read[value_at].is_err()
                    deliberate @ "__attribute__((unused)) "

                # A lend rooted at a name the author may not write is
                # `const void *`, and the temporary has to say so: declared by
                # its Heroes type alone it is `void *`, the qualifier dies on
                # the assignment one line before the call it exists to reach,
                # and clang refuses the honest READ instead of the write
                # (panel 166; measured on the route's first landing, which was
                # reverted for it, 2026-09-19).
                spelling: str @ spelled.must()

                if !lends[value_at].is_err()
                    spelling @ "const " + spelled.must()
                writer.line(
                    @w,
                    text: "    " + deliberate + spelling + " " + mangle.value(value_at) + ";"
                )
        value_at @ value_at + 1

## Tests

test "a whole function prints: signature, prologue, goto bb0, blocks, close"
    text = "function add(a: i64, b: i64) -> i64\n    return a + b\n\nfunction main()\n    print(add(a: 1, b: 2))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names1 = ctype.with_options(names0, c: c, s: s, decls: parsed.decls)
    names = ctype.with_functions(names1, c: c, s: s, decls: parsed.decls, p: low.program)
    w: writer.Writer @ writer.new_writer("t")
    none: {i64: bool} = {}
    definition(
        @w,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    got = writer.finish(w)
    assert strings.holds(text: got, needle: "int64_t h_t_add(int64_t h0_a, int64_t h1_b) {")
    assert strings.holds(text: got, needle: "    int64_t t1;")
    assert strings.holds(text: got, needle: "    int64_t t3;")
    assert strings.holds(text: got, needle: "    goto bb0;")
    assert strings.holds(text: got, needle: "bb0:")
    assert strings.holds(text: got, needle: "    if (__builtin_add_overflow(t1, t2, &t3)) hero_panic_overflow();")
    assert strings.holds(text: got, needle: "    return t3;")

    # Deterministic: the same input prints the same bytes.
    again: writer.Writer @ writer.new_writer("t")
    definition(
        @again,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    assert writer.finish(again) == got

test "an unreachable join is omitted entirely, label and all"
    text = "function pick(flag: bool) -> i64\n    if flag\n        return 1\n    else\n        return 2\n\nfunction main()\n    print(pick(true))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names0 = ctype.new_names(s, parsed.decls)
    names = ctype.with_functions(
        ctype.with_options(names0, c: c, s: s, decls: parsed.decls),
        c: c,
        s: s,
        decls: parsed.decls,
        p: low.program
    )
    w: writer.Writer @ writer.new_writer("t")
    none: {i64: bool} = {}
    definition(
        @w,
        instances.hold(low.program),
        c,
        names,
        s,
        parsed.decls,
        low.program.functions[0],
        guarded_decls: none
    )
    got = writer.finish(w)

    # The join block (bb1, created before the arms) has no preds: its
    # label must not appear.
    assert !strings.holds(text: got, needle: "bb1:")
    assert strings.holds(text: got, needle: "bb2:")
