# An extent the call states above what it lends, read back from the
# assertion `emit/lend_extent.hero` wrote (design.md §4.19, §1.12; panel 166's
# route C; defect 063; panel 194's R7, defects 092 and 395, the unit C counts
# in and the record lent whole).
#
# The assertion is `#line`d at the call, and its message carries everything
# this reader needs — the extern's name, the pointer's and the count's
# parameter names, the lend's span, the extent's span and the field's length —
# so nothing is read from clang's echo of the source and no column arithmetic
# is done (panel 038's trap). The diagnostic lands on the NUMBER the author
# wrote, because that is what is wrong; the lend is named in the sentence.

use token
use source
use diag
use emit/ffi_lookup
use emit/lend_extent
use emit/lend_buffer
use field_lend_errors

constant MARKER: str
    "heroes-ffi-extent "

# Whichever of the three a failed line is: a field in bytes, a field in a
# wider unit, a record lent whole.
function overstated_extent(s: source.Source, line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    buffer = ffi_lookup.after(text: line, marker: lend_buffer.MARKER)

    if !buffer.is_err()
        return buffer_pointee(rest: buffer.must())
    stated_record = ffi_lookup.after(text: line, marker: lend_extent.STATED_RECORD_MARKER)

    if !stated_record.is_err()
        return short_place(s, rest: stated_record.must(), whole: true)
    stated_field = ffi_lookup.after(text: line, marker: lend_extent.STATED_MARKER)

    if !stated_field.is_err()
        return short_place(s, rest: stated_field.must(), whole: false)
    record_rest = ffi_lookup.after(text: line, marker: lend_extent.RECORD_MARKER)

    if !record_rest.is_err()
        return overstated_record(s, rest: record_rest.must())
    unit_rest = ffi_lookup.after(text: line, marker: lend_extent.UNIT_MARKER)

    if !unit_rest.is_err()
        return overstated_field(s, rest: unit_rest.must(), unit: true)
    rest = ffi_lookup.after(text: line, marker: MARKER)

    if rest.is_err()
        return fail(code: "none", msg: "not an extent assertion")
    return overstated_field(s, rest: rest.must(), unit: false)

# `<name> <ptr param> <count param> <lend start> <lend end> <extent start>
# <extent end> <length>`, and the header's type after it in a wider unit:
# C's `sizeof` of the field, in that unit, is below the extent the call states.
function overstated_field(s: source.Source, rest: str, unit: bool) -> diag.Diagnostic?
    parts = ffi_lookup.words(text: rest)

    if parts.len() < 8 || unit && parts.len() < 9
        return fail(code: "none", msg: "the marker's tail is not ours")
    lend_start = ffi_lookup.number(parts[3])
    lend_end = ffi_lookup.number(parts[4])
    extent_start = ffi_lookup.number(parts[5])
    extent_end = ffi_lookup.number(parts[6])
    length = ffi_lookup.number(trim_quote(parts[7]))

    if lend_start.is_err() || lend_end.is_err() || extent_start.is_err() || extent_end.is_err() || length.is_err()
        return fail(code: "none", msg: "a position is not numeric")
    lend = token.Span(start: lend_start.must(), end: lend_end.must())
    extent = token.Span(start: extent_start.must(), end: extent_end.must())

    if unit
        return ok(
            field_lend_errors.field_lend_unit(lend: source.span_text(s, lend), callee: parts[0], parameter: parts[1], count: parts[2], stated: source.span_text(s, extent), length: length.must(), header_type: trim_quote(tail_from(parts, at: 8)), span: extent)
        )
    return ok(
        field_lend_errors.field_lend_extent(lend: source.span_text(s, lend), callee: parts[0], parameter: parts[1], count: parts[2], stated: source.span_text(s, extent), length: length.must(), span: extent)
    )

# `<name> <ptr param> <count param> <extent start> <extent end> <bytes|unit>
# <header type…>`: a group's record lent whole through `@`, and a count C's
# `sizeof` of it, in the unit the header's pointer counts, cannot hold. It
# lands on the number; the record has no span in the call's IR, and the
# parameter it was lent to names it.
function overstated_record(s: source.Source, rest: str) -> diag.Diagnostic?
    parts = ffi_lookup.words(text: rest)

    if parts.len() < 7
        return fail(code: "none", msg: "the marker's tail is not ours")
    extent_start = ffi_lookup.number(parts[3])
    extent_end = ffi_lookup.number(parts[4])

    if extent_start.is_err() || extent_end.is_err()
        return fail(code: "none", msg: "a position is not numeric")
    extent = token.Span(start: extent_start.must(), end: extent_end.must())
    header_type = trim_quote(tail_from(parts, at: 6))
    counted_in: str @ "in what it points at: C read both sizes from the header"

    if parts[5] == "bytes"
        counted_in @ "in bytes: C read the record's own size from the header"
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "record_lend_extent",
        message: "`" + parts[2] + "` states " + source.span_text(s, extent) + ", outside the record lent whole to `" + parts[1] + "` of `" + parts[0] + "` — `" + parts[1] + "` is declared `counted_by " + parts[2] + "`, and the header's `" + header_type + "` counts it " + counted_in,
        span: extent
    )
    d.notes @ d.notes.push(
        "a record lent whole is the one object at that address, so C reaching further writes over whatever the stack holds beside it, silently, at exit 0. State at most the record's own size in that unit"
    )
    return ok(d)

# `<name> <param> <stated> <lend start> <lend end> <length> <bytes|unit>
# <header type…>`: the DECLARATION states the extent (panel 196's R5), so the
# number is C's word about itself and what is short is the place the call
# lends, a field or a record whole. The message lands on the lend, and there
# is no `Fix`: a longer place is the program's to choose, and the declaration
# is the author's word about C, which no fix may rewrite (panel 196's R8).
function short_place(s: source.Source, rest: str, whole: bool) -> diag.Diagnostic?
    parts = ffi_lookup.words(text: rest)

    if parts.len() < 8
        return fail(code: "none", msg: "the marker's tail is not ours")
    lend_start = ffi_lookup.number(parts[3])
    lend_end = ffi_lookup.number(parts[4])
    length = ffi_lookup.number(parts[5])

    if lend_start.is_err() || lend_end.is_err() || length.is_err()
        return fail(code: "none", msg: "a position is not numeric")
    lend = token.Span(start: lend_start.must(), end: lend_end.must())
    header_type = trim_quote(tail_from(parts, at: 7))
    declared = "`" + parts[1] + "` of `" + parts[0] + "` is declared `counted_by " + parts[2] + "`, an extent the declaration states"
    unit: str @ "bytes"
    counted_in: str @ "bytes"
    measured: str @ "C read its size from the header"

    if parts[6] != "bytes"
        unit @ "of what the header's `" + header_type + "` points at"
        counted_in @ "what the header's `" + header_type + "` points at"
        measured @ "C read both sizes from the header"

    if whole
        r: diag.Diagnostic @ diag.new_diagnostic(
            code: "record_lend_extent",
            message: "the record lent whole here holds fewer than " + parts[2] + " " + unit + " — " + declared + ", so C reaches past the record: " + measured,
            span: lend
        )
        r.notes @ r.notes.push(
            "the declaration says how far C reaches, whatever the call hands it, so a record shorter than that is written past, over whatever the stack holds beside it. Lend a record that holds the extent; if C reaches less, the declaration is what is wrong"
        )
        return ok(r)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "field_lend_extent",
        message: "`" + source.span_text(s, lend) + "` lends a field of " + length.must().to_str() + " bytes, and " + declared + ", counted in " + counted_in + ", so C reaches past the field: " + measured,
        span: lend
    )
    d.notes @ d.notes.push(
        "the declaration says how far C reaches, whatever the call hands it, so a field shorter than that is written past, into whatever the header put beside it. Lend a field that holds the extent; if C reaches less, the declaration is what is wrong"
    )
    return ok(d)

# `<name> <param> <start> <end> <element> <header type…>`: a buffer C fills
# (panel 196's R4) whose element is not what the header's pointer points at.
# The call is right and the declaration is wrong about C, so the message lands
# on the parameter where it is declared.
function buffer_pointee(rest: str) -> diag.Diagnostic?
    parts = ffi_lookup.words(text: rest)

    if parts.len() < 6
        return fail(code: "none", msg: "the marker's tail is not ours")
    start = ffi_lookup.number(parts[2])
    end = ffi_lookup.number(parts[3])

    if start.is_err() || end.is_err()
        return fail(code: "none", msg: "a position is not numeric")
    header_type = trim_quote(tail_from(parts, at: 5))
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_parameter_type",
        message: "`" + parts[1] + "` of `" + parts[0] + "` is a buffer of `" + parts[4] + "`, and the header's `" + header_type + "` points at something else — C writes what its pointer points at, so the buffer's element is held to it",
        span: token.Span(start: start.must(), end: end.must())
    )
    d.notes @ d.notes.push(
        "§4.19: a buffer's element is a number of the width and sign the header's pointee has, as an `@` number is, or the group's record that is that struct; against a `void *` it is `u8`, the byte being the unit where the header gives none"
    )
    return ok(d)

# A marker's words from `at` on, joined back: a header's type may be several
# words (`struct pfd *`).
function tail_from(parts: [str], at: i64) -> str
    tail: [str] @ []
    index: i64 @ at

    while index < parts.len()
        tail @ tail.push(parts[index])
        index @ index + 1

    return tail.join(" ")

# clang ends the line with the message's closing quote on some platforms and
# not on others; a length never ends in one.
function trim_quote(text: str) -> str
    if text.len() > 0 && (text[text.len() - 1] == '"' || text[text.len() - 1] == '\'')
        return text.slice(from: 0, to: text.len() - 1)
    return text

## Tests

test "the marker's tail lands the diagnostic on the number the author wrote, with the field's length as the guess"
    text = "extern \"s.h\"\n    record S\n        b: u8[8]\n    function fill(p: ptr counted_by n, n: i64)\n\nfunction main()\n    t: S @ S(b: [1, 2, 3, 4, 5, 6, 7, 8])\n    fill(p: t.b.ptr(), n: 64)\n"
    s = source.new_source(name: "t.hero", text: text)
    lend = ffi_lookup.char_index_of(text: text, needle: "t.b.ptr()").must()
    stated = ffi_lookup.char_index_of(text: text, needle: "64)").must()
    line = "t.hero:8:5: error: static assertion failed due to requirement 'x': heroes-ffi-extent fill p n " + lend.to_str() + " " + (lend + 9).to_str() + " " + stated.to_str() + " " + (stated + 2).to_str() + " 8\""
    d = overstated_extent(s, line: line)
    assert !d.is_err()
    assert d.must().code == "field_lend_extent"
    assert source.span_text(s, d.must().span) == "64"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "8"
    assert d.must().fixes[0].certainty == .guess
    assert overstated_extent(s, line: "t.hero:8:5: error: static assertion failed: heroes-ffi-pointee fill n int64_t size_t").is_err(
    )
    assert overstated_extent(s, line: "t.hero:8:5: error: static assertion failed: heroes-ffi-extent fill p n").is_err()
