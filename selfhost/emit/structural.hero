# The two functions that must agree: generated eq and generated hash
# (design.md §4.3, §4.9; panels 022, 029, 061, 062). Port of
# archive/bootstrap-rs/heroes/src/emit/{structural,structural_fixed}.rs — one module,
# because they are ONE invariant: two values that compare equal must
# hash equal, and the moment the two walks disagree a map loses a key
# it contains. That failure is silent on insert and loud only much
# later, which is why the two live where one diff shows both.
#
# FIELDS, NEVER BYTES, for both: record Flag { n: i64, on: bool }
# carries 7 bytes of padding whose contents are whatever was there
# before, so memcmp reports two ==-equal records as different — no
# warning, no error, no sanitiser report. hash is generated for EVERY
# aggregate rather than only map-key types, because a descriptor's
# null hash is SEGV at address 0x0: no type name, no source line.
#
# The eq table went without three rows until 2026-08-12 — map,
# fallible, function — while hash routed through hash_call, which
# covered all three; the disagreement broke "eq and hash agree" in the
# loudest direction: {Box: i64} inserted fine and aborted on lookup.
#
# Port note: Rust's fixed_eq_expr string-replaces "[i]" per index;
# Heroes has no replace, so the element expressions are BUILT per
# index — same bytes out, one fewer string trick.

use ast
use source
use check/table
use check/state
use emit/mangle
use emit/ctype
use emit/types
use emit/descriptors
use emit/writer
use parse
use resolve
use checker

# Structural ==, field by field (§4.3).
function equality_body(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, at: ctype.Aggregate, fields: [ast.Field])
    writer.at_generated(@w)
    writer.line(
        @w,
        text: "HERO_TU_LOCAL bool " + at.prefix + "_eq(const " + at.c_type + " *a, const " + at.c_type + " *b) {"
    )

    # A partial record's _eq is emitted and ABORTS (panel 061): the
    # checker refuses == on one, so nothing should ever call this — and
    # "should never" is exactly the premise that goes in the loud
    # direction. Not emitting it at all is the tempting alternative and
    # the dangerous one: every HeroDesc carries _hash, and a null there
    # is a SEGV with no story. hero_panic is _Noreturn, so
    # -Werror=return-type is satisfied without a return.
    if at.partial
        writer.line(
            @w,
            text: "    hero_panic(\"" + at.prefix + "_eq: a partial record has no structural equality\");"
        )
        writer.line(@w, text: "}")
        writer.blank(@w)
        return

    if fields.len() == 0
        # record E is error[empty_record] in the checker, so this is
        # belt to those braces — and (void) keeps the parameters used,
        # because -Wall is on.
        writer.line(@w, text: "    (void)a;")
        writer.line(@w, text: "    (void)b;")
        writer.line(@w, text: "    return true;")

    for field in fields
        ty: i64 @ table.error_ty(c.types)
        written = state.written_type(c, field.ty)

        if !written.is_err()
            ty @ written.must()
        member = mangle.field_of(foreign: at.foreign, name: source.span_text(s, field.name))
        test_expr = field_eq_expr(c, names, ty: ty, member: member)

        # One early return per field rather than a chain of &&: the
        # same short circuit, and a clang diagnostic about a field
        # lands on that field's line.
        writer.line(@w, text: "    if (!(" + test_expr + ")) return false;")

    if fields.len() > 0
        writer.line(@w, text: "    return true;")
    writer.line(@w, text: "}")
    writer.blank(@w)

# The comparison of one field, as a C expression.
function field_eq_expr(c: state.Checked, names: ctype.Names, ty: i64, member: str) -> str
    match table.get(c.types, ty)
        # ptr and cstr compare as ADDRESSES — spec:72 since panel 053,
        # and the two rows the emitter once dropped to the loud arm:
        # == on a complete group record holding either was
        # hero_unreachable() at exit 134 on a correct program (panel
        # 062's spec-warden).
        .int_ty | .bool | .float_ty | .ptr | .cstr => return "a->" + member + " == b->" + member
        .str                                       => return "hero_str_eq(a->" + member + ", b->" + member + ")"
        .array                                     => return "hero_array_eq(a->" + member + ", b->" + member + ")"
        # A C array member is compared ELEMENTWISE: a->f == b->f
        # compiles with zero warnings and is a POINTER comparison — two
        # distinct structs always differ, so == would be false for two
        # identical values, silently. No memcmp shortcut is also
        # correct: padding inside an element would decide the answer.

        .fixed x => return "(" + fixed_eq_expr(c, names, member: member, element: x.element, count: x.length) + ")"
        # The three rows the table went without until 2026-08-12.

        .map      => return "hero_map_eq(a->" + member + ", b->" + member + ")"
        .fallible => return ctype.option_of(names, ty: ty) + "_eq(&a->" + member + ", &b->" + member + ")"
        # A function value is a bare C function pointer, and panel 029
        # made its equality pointer identity.

        .function_ty => return "a->" + member + " == b->" + member
        .named n     => return ctype.satellite(names, decl: n.decl) + "_eq(&a->" + member + ", &b->" + member + ")"
        .case_ty vc => return ctype.case_of(names, decl: vc.decl, at: vc.at) + "_eq(&a->" + member + ", &b->" + member + ")"
        # Still loud, and it must stay loud: a failure-typed field has
        # no surface spelling, so it is a compiler bug rather than a
        # program.

        .unit | .failure | .generic | .error => return "(hero_unreachable(), false)"

    return "(hero_unreachable(), false)"

# N comparisons folded into one expression, without a statement — the
# caller is building `if (!(...)) return false;` and a for there would
# restructure the whole shape. N is a compile-time constant and small
# (raylib's largest is 16), so the unrolled form is what a C compiler
# would produce from the loop anyway.
function fixed_eq_expr(c: state.Checked, names: ctype.Names, member: str, element: i64, count: i64) -> str
    parts: [str] @ []
    i: i64 @ 0

    while i < count
        a_place = "a->" + member + "[" + i.to_str() + "]"
        b_place = "b->" + member + "[" + i.to_str() + "]"
        parts @ parts.push(element_eq(c, names, a_place: a_place, b_place: b_place, element: element))
        i @ i + 1

    return parts.join(" && ")

# The comparison of one element of a fixed array field. The checker
# admits only boundary types as elements, so anything else is a type
# the frontend should have stopped — loud, not silent.
function element_eq(c: state.Checked, names: ctype.Names, a_place: str, b_place: str, element: i64) -> str
    match table.get(c.types, element)
        .int_ty | .bool | .float_ty | .ptr | .cstr => return a_place + " == " + b_place
        .named n => return ctype.satellite(names, decl: n.decl) + "_eq(&" + a_place + ", &" + b_place + ")"
        .str | .array | .fixed | .map | .fallible | .function_ty => return "(hero_unreachable(), false)"
        .unit | .case_ty | .failure | .generic | .error => return "(hero_unreachable(), false)"

    return "(hero_unreachable(), false)"

# A variant's ==: different tags are never equal, same tags compare
# payloads. Two payload-free cases with the same tag ARE the same
# value. Every enumerator is covered, so the fall-through is a claim:
# hero_unreachable() is _Noreturn, satisfying -Werror=return-type
# without inventing an answer.
function variant_equality_body(@w: writer.Writer, names: ctype.Names, s: source.Source, decls: [ast.Decl], decl: i64, at: ctype.Aggregate)
    writer.at_generated(@w)
    writer.line(
        @w,
        text: "HERO_TU_LOCAL bool " + at.prefix + "_eq(const " + at.c_type + " *a, const " + at.c_type + " *b) {"
    )
    writer.line(@w, text: "    if (a->tag != b->tag) return false;")
    writer.line(@w, text: "    switch (a->tag) {")
    case_at: i64 @ 0

    for one_case in types.cases_of(decls, decl: decl)
        case_name = source.span_text(s, one_case.name)
        tag = mangle.tag_of(ty: at.prefix, case_name: case_name)

        if one_case.fields.len() == 0
            writer.line(@w, text: "        case " + tag + ": return true;")
        else
            writer.line(
                @w,
                text: "        case " + tag + ": return " + ctype.case_of(names, decl: decl, at: case_at) + "_eq(&a->as." + mangle.case_member(case_name) + ", &b->as." + mangle.case_member(case_name) + ");"
            )
        case_at @ case_at + 1

    writer.line(@w, text: "    }")
    writer.line(@w, text: "    hero_unreachable();")
    writer.line(@w, text: "}")
    writer.blank(@w)

# hash, field by field, for EVERY aggregate — never null. FNV-1a over
# the field hashes, the same mix the runtime uses, so there is one hash
# function in this project rather than two that drift. A fixed array
# folds element by element: hashing the member's address would fold a
# pointer, which differs between two equal values.
function hash_body(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, at: ctype.Aggregate, fields: [ast.Field])
    writer.at_generated(@w)
    writer.line(@w, text: "HERO_TU_LOCAL uint64_t " + at.prefix + "_hash(const void *elem) {")

    if at.partial
        writer.line(
            @w,
            text: "    (void)elem; hero_panic(\"" + at.prefix + "_hash: a partial record has no structural hash\");"
        )
        writer.line(@w, text: "}")
        writer.blank(@w)
        return

    # **`v` is declared only where a line actually reads it**, decided from
    # the lines in hand rather than from a premise about which field kinds
    # produce one (CLAUDE.md §11). A record whose every field is unhashable
    # — one `ptr`, which is what a binding wraps a handle in — otherwise
    # declares it and reads nothing, and `suite_warnings` holds the corpus
    # to zero clang warnings. `(void)elem;` is the other way and is worse:
    # it says *somebody might have read this* where nothing can.
    #
    # **The first repair asked a predicate instead and was wrong** — a fixed
    # array answers no there while the loop below still writes `&v->…` for
    # it. Defect 009 in `docs/work/DONE.md` has the reproducer, the golden
    # that caught it and why the predicate could not have been right.
    lines: [str] @ []

    for field in fields
        ty: i64 @ table.error_ty(c.types)
        written = state.written_type(c, field.ty)

        if !written.is_err()
            ty @ written.must()
        member = mangle.field_of(foreign: at.foreign, name: source.span_text(s, field.name))
        is_fixed: bool @ false
        fixed_element: i64 @ 0
        fixed_count: i64 @ 0

        match table.get(c.types, ty)
            .fixed x =>
                is_fixed @ true
                fixed_element @ x.element
                fixed_count @ x.length
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => is_fixed @ is_fixed
            .array | .map | .fallible | .function_ty | .named         => is_fixed @ is_fixed
            .case_ty | .failure | .generic | .error                   => is_fixed @ is_fixed

        if is_fixed
            i: i64 @ 0

            while i < fixed_count
                place = "&v->" + member + "[" + i.to_str() + "]"
                lines @ lines.push(
                    "    h = (h ^ " + one_hash(c, names, ty: fixed_element, place: place) + ") * UINT64_C(0x100000001b3);"
                )
                i @ i + 1
        else
            lines @ lines.push(
                "    h = (h ^ " + one_hash(c, names, ty: ty, place: "&v->" + member) + ") * UINT64_C(0x100000001b3);"
            )

    reads_the_value: bool @ false

    for line in lines
        if mentions_v(line)
            reads_the_value @ true

    if reads_the_value
        writer.line(@w, text: "    const " + at.c_type + " *v = elem;")
    writer.line(@w, text: "    uint64_t h = UINT64_C(0xcbf29ce484222325);")

    for line in lines
        writer.line(@w, text: line)

    writer.line(@w, text: "    return h;")
    writer.line(@w, text: "}")
    writer.blank(@w)

# Whether a line the hash is about to write reads `v`. Every place this
# emitter builds spells it `&v->`, in both branches of the loop above and
# nowhere else, so the needle is that and not the bare letter — which would
# match the `v` inside a field named `value`.
function mentions_v(line: str) -> bool
    needle = "&v->"

    if needle.len() > line.len()
        return false
    at: i64 @ 0

    while at + needle.len() <= line.len()
        if line.slice(from: at, to: at + needle.len()) == needle
            return true
        at @ at + 1

    return false

function one_hash(c: state.Checked, names: ctype.Names, ty: i64, place: str) -> str
    found = descriptors.hash_call(c, names, ty: ty, place: place)

    if found.is_err()
        return "(hero_unreachable(), UINT64_C(0))"
    return found.must()

# A variant's hash: the tag mixed in, then the live case's payload. The
# tag is not decoration: two payload-free cases differ ONLY by their
# tag, so leaving it out gives .red and .green the same hash — legal
# but useless, exactly the degenerate hash that turns a map into a
# list.
function variant_hash_body(@w: writer.Writer, names: ctype.Names, s: source.Source, decls: [ast.Decl], decl: i64, at: ctype.Aggregate)
    writer.at_generated(@w)
    writer.line(@w, text: "HERO_TU_LOCAL uint64_t " + at.prefix + "_hash(const void *elem) {")
    writer.line(@w, text: "    const " + at.c_type + " *v = elem;")
    writer.line(@w, text: "    uint64_t h = (UINT64_C(0xcbf29ce484222325) ^ (uint64_t)v->tag)")
    writer.line(@w, text: "        * UINT64_C(0x100000001b3);")
    writer.line(@w, text: "    switch (v->tag) {")
    case_at: i64 @ 0

    for one_case in types.cases_of(decls, decl: decl)
        case_name = source.span_text(s, one_case.name)
        tag = mangle.tag_of(ty: at.prefix, case_name: case_name)

        if one_case.fields.len() == 0
            writer.line(@w, text: "        case " + tag + ": return h;")
        else
            writer.line(
                @w,
                text: "        case " + tag + ": return (h ^ " + ctype.case_of(names, decl: decl, at: case_at) + "_hash(&v->as." + mangle.case_member(case_name) + ")) * UINT64_C(0x100000001b3);"
            )
        case_at @ case_at + 1

    writer.line(@w, text: "    }")
    writer.line(@w, text: "    hero_unreachable();")
    writer.line(@w, text: "}")
    writer.blank(@w)

## Tests

record Setup
    c: state.Checked
    s: source.Source
    decls: [ast.Decl]
    names: ctype.Names

function ready(text: str) -> Setup
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, p.decls)
    return Setup(c: c, s: s, decls: p.decls, names: names)

test "eq short-circuits per field and hash mixes the same fields"
    got = ready(
        "record Person\n    name: str\n    age: i64\n\nfunction main()\n    p = Person(name: \"b\", age: 1)\n    _ = p\n"
    )
    at = ctype.aggregate(got.names, decl: 0)
    w: writer.Writer @ writer.new_writer("t")
    equality_body(@w, got.c, got.names, got.s, at: at, fields: types.fields_of(got.decls, decl: 0))
    eq_text = writer.finish(w)
    assert eq_text == "#line 2 \"t.c\"\nHERO_TU_LOCAL bool h_t_Person_eq(const h_t_Person *a, const h_t_Person *b) {\n    if (!(hero_str_eq(a->f_name, b->f_name))) return false;\n    if (!(a->f_age == b->f_age)) return false;\n    return true;\n}\n\n"
    hw: writer.Writer @ writer.new_writer("t")
    hash_body(@hw, got.c, got.names, got.s, at: at, fields: types.fields_of(got.decls, decl: 0))
    hash_text = writer.finish(hw)
    assert hash_text == "#line 2 \"t.c\"\nHERO_TU_LOCAL uint64_t h_t_Person_hash(const void *elem) {\n    const h_t_Person *v = elem;\n    uint64_t h = UINT64_C(0xcbf29ce484222325);\n    h = (h ^ (&hero_desc_str)->hash(&v->f_name)) * UINT64_C(0x100000001b3);\n    h = (h ^ (&hero_desc_int)->hash(&v->f_age)) * UINT64_C(0x100000001b3);\n    return h;\n}\n\n"

test "a variant compares tags first and mixes the tag into the hash"
    got = ready("variant Coin\n    heads\n    tails\n\nfunction main()\n    c: Coin = .heads\n    _ = c\n")
    at = ctype.aggregate(got.names, decl: 0)
    w: writer.Writer @ writer.new_writer("t")
    variant_equality_body(@w, got.names, got.s, got.decls, decl: 0, at: at)
    eq_text = writer.finish(w)
    assert eq_text == "#line 2 \"t.c\"\nHERO_TU_LOCAL bool h_t_Coin_eq(const h_t_Coin *a, const h_t_Coin *b) {\n    if (a->tag != b->tag) return false;\n    switch (a->tag) {\n        case h_t_Coin_tag_heads: return true;\n        case h_t_Coin_tag_tails: return true;\n    }\n    hero_unreachable();\n}\n\n"
    hw: writer.Writer @ writer.new_writer("t")
    variant_hash_body(@hw, got.names, got.s, got.decls, decl: 0, at: at)
    hash_text = writer.finish(hw)
    assert hash_text == "#line 2 \"t.c\"\nHERO_TU_LOCAL uint64_t h_t_Coin_hash(const void *elem) {\n    const h_t_Coin *v = elem;\n    uint64_t h = (UINT64_C(0xcbf29ce484222325) ^ (uint64_t)v->tag)\n        * UINT64_C(0x100000001b3);\n    switch (v->tag) {\n        case h_t_Coin_tag_heads: return h;\n        case h_t_Coin_tag_tails: return h;\n    }\n    hero_unreachable();\n}\n\n"

test "a fixed member unrolls elementwise, and a partial record aborts loudly"
    got = ready(
        "extern \"m.h\"\n    record Vec2\n        cells: f32[2]\n    record Font partial\n        size: f64\n\nfunction main()\n    print(1)\n"
    )
    vec = ctype.aggregate(got.names, decl: 0)
    w: writer.Writer @ writer.new_writer("t")
    equality_body(@w, got.c, got.names, got.s, at: vec, fields: types.fields_of(got.decls, decl: 0))
    text = writer.finish(w)
    assert text == "#line 2 \"t.c\"\nHERO_TU_LOCAL bool h_t_Vec2_eq(const Vec2 *a, const Vec2 *b) {\n    if (!((a->cells[0] == b->cells[0] && a->cells[1] == b->cells[1]))) return false;\n    return true;\n}\n\n"
    font = ctype.aggregate(got.names, decl: 1)
    fw: writer.Writer @ writer.new_writer("t")
    equality_body(@fw, got.c, got.names, got.s, at: font, fields: types.fields_of(got.decls, decl: 1))
    font_text = writer.finish(fw)
    assert font_text == "#line 2 \"t.c\"\nHERO_TU_LOCAL bool h_t_Font_eq(const Font *a, const Font *b) {\n    hero_panic(\"h_t_Font_eq: a partial record has no structural equality\");\n}\n\n"
