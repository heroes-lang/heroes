# An array's element and its length, READ IN PLACE (defect 389,
# 2026-10-07; design.md §4.9, §4.20, spec § 10). The emitted C reads the
# header and the block itself, where it called `hero_array_at` and
# `hero_array_len`: panel 195's loop of a million reads retired 116.1 to
# 117.0 million instructions with the call and 93.1 to 93.7 million read in
# place at -O0, 38.1 to 38.7 against 24.1 to 24.8 million at -O2 (three
# runs each), and a `for` over an array reads its length and an element at
# every step.
#
# THE ABORT IS STILL THE RUNTIME'S. A NULL slot, or an index outside
# [0, len), is handed to `hero_array_at` or `hero_array_len` itself, which
# aborts in its own words and with its own exit code, so a program reading
# out of range prints what it always printed. `hero_unreachable()` after
# that call is never reached; it is there so clang sees the branch end,
# rather than reasoning about the read after it from a premise about the
# call.
#
# THE ELEMENT IS READ AT `sizeof` OF ITS C TYPE, and the descriptor is
# asked to agree first: every write already copies `elem->size` bytes out
# of a value of that type (`hero_array_push`, `_set`, `_push_owned`), so the
# two are one fact, and a read that found them apart would read past its
# slot. It aborts instead, which `hero_array_at` never asked.
#
# Emitted and not a macro of `heroes_runtime.h`: the same C once
# preprocessed, measured so, and a word the header gains is owed to the
# guard list and to two of the runtime's files (`emit/guarded_names.hero`).
# Every argument is a temporary's name, so naming it more than once
# evaluates nothing twice.

# `xs[i]`: `spelling` is the element's C type, `base` and `index` the two
# temporaries. `{spelling} const *`, not `const {spelling} *`: the two
# differ exactly when the element is itself a pointer.
function element(spelling: str, base: str, index: str) -> str
    checked = "(" + base + " == NULL || " + index + " < 0 || " + index + " >= " + base + "->len)"
    sized = "(" + base + "->elem->size != sizeof(" + spelling + ") ? hero_unreachable() : (void)0)"
    read = "((" + spelling + " const *)(const void *)(" + base + " + 1))[" + index + "]"
    return "((void)(" + checked + " ? ((void)hero_array_at(" + base + ", " + index + "), hero_unreachable()) : (void)0), (void)" + sized + ", " + read + ")"

# `xs.len()`, `len(xs)` and the length a `for` reads at every step, where
# a value is wanted; `value` is a temporary.
function length(value: str) -> str
    return "((void)(" + value + " == NULL ? ((void)hero_array_len(" + value + "), hero_unreachable()) : (void)0), " + value + "->len)"

# An element's own PLACE after its array was unshared, the lvalue a step of
# a nested place descends through (panel 196's R1; defect 491, 2026-10-08):
# `hero_array_at_mut` returned its address, and a call per step is what this
# spells in place, by the reasoning above and with the same abort, handed to
# `hero_array_at_mut` itself for a NULL slot or an index outside [0, len).
# The comma is the operand of the dereference, so the checks are sequenced
# before the pointer arithmetic and the whole stays an lvalue.
#
# `base` is named five times here, and that is the whole difficulty: it is a
# place, not a temporary, and a place that holds a call, the previous step's
# own `hero_array_at_mut`, would write that call five times over, and each
# deeper step five times that. So `pure` says whether `base` is a slot and
# fields alone, which no call can be in, and is a fact the walk carries as it
# builds the place, never read back off the text. Where it is not, the
# runtime's call stays: the one spelling both walks had before, now written
# once (`emit/places.hero`, `emit/container.hero`).
function place(spelling: str, base: str, index: str, pure: bool) -> str
    if !pure
        return "(*(" + spelling + " *)hero_array_at_mut(" + base + ", " + index + "))"
    checked = "(" + base + " == NULL || " + index + " < 0 || " + index + " >= " + base + "->len)"
    sized = "(" + base + "->elem->size != sizeof(" + spelling + ") ? hero_unreachable() : (void)0)"
    return "(*((void)(" + checked + " ? ((void)hero_array_at_mut(" + base + ", " + index + "), hero_unreachable()) : (void)0), (void)" + sized + ", (" + spelling + " *)(void *)(" + base + " + 1) + " + index + "))"

## Tests

test "an element and a length are read in place, every failing read handed to the runtime"
    assert element(spelling: "int64_t", base: "t0", index: "t1") == "((void)((t0 == NULL || t1 < 0 || t1 >= t0->len) ? ((void)hero_array_at(t0, t1), hero_unreachable()) : (void)0), (void)(t0->elem->size != sizeof(int64_t) ? hero_unreachable() : (void)0), ((int64_t const *)(const void *)(t0 + 1))[t1])"
    assert element(spelling: "char *", base: "t2", index: "t3") == "((void)((t2 == NULL || t3 < 0 || t3 >= t2->len) ? ((void)hero_array_at(t2, t3), hero_unreachable()) : (void)0), (void)(t2->elem->size != sizeof(char *) ? hero_unreachable() : (void)0), ((char * const *)(const void *)(t2 + 1))[t3])"
    assert length("t4") == "((void)(t4 == NULL ? ((void)hero_array_len(t4), hero_unreachable()) : (void)0), t4->len)"

# Defect 491's spelling: an element's place in place where the base holds no
# call, the runtime's call, as it was, where it does.
test "an element's place is read in place over a call-free base, and by the runtime's call otherwise (defect 491)"
    assert place(spelling: "int64_t", base: "h0_xs", index: "t1", pure: true) == "(*((void)((h0_xs == NULL || t1 < 0 || t1 >= h0_xs->len) ? ((void)hero_array_at_mut(h0_xs, t1), hero_unreachable()) : (void)0), (void)(h0_xs->elem->size != sizeof(int64_t) ? hero_unreachable() : (void)0), (int64_t *)(void *)(h0_xs + 1) + t1))"
    assert place(spelling: "h_t_Row", base: "(*ph0_s).f_rows", index: "t2", pure: true) == "(*((void)(((*ph0_s).f_rows == NULL || t2 < 0 || t2 >= (*ph0_s).f_rows->len) ? ((void)hero_array_at_mut((*ph0_s).f_rows, t2), hero_unreachable()) : (void)0), (void)((*ph0_s).f_rows->elem->size != sizeof(h_t_Row) ? hero_unreachable() : (void)0), (h_t_Row *)(void *)((*ph0_s).f_rows + 1) + t2))"
    assert place(spelling: "h_t_Row", base: "h0_xs", index: "t3", pure: false) == "(*(h_t_Row *)hero_array_at_mut(h0_xs, t3))"
