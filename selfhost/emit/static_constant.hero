# A constant of an array whose body is literals, laid out by clang once
# instead of built at every read (panel 195, defect 382; design.md §1.12,
# §4.20). The read was `call heroes K()`, and the function built the array
# from its literal each time: `K[at % 32]` a million times retired 4.6
# billion instructions where a name bound once retired 117 million.
#
# NOTHING ABOVE THE EMITTER MOVES. The checker, the lowering, the ownership
# pass and the IR keep the constant a function of no arguments whose result
# its caller owns and releases. What changes is the function's C: a static
# block per array literal (`HERO_ARRAY_STATIC`, the runtime's own layout, as
# `HERO_STR_STATIC` is a literal's) whose count is -1, and a body returning its
# address. The caller's release reaches `hero_array_decref`, which returns on
# that count; a write copies first, because the count is not 1.
#
# BOTH ROUTES ARE WRITTEN, AND THE RUNTIME'S SWITCH PICKS ONE (panel 195's
# R2). The block and its reader stand under `#if HERO_STATIC_CONSTANTS`, and
# the function that builds the constant, exactly as `emit/body.hero` writes
# any function, under its `#else`. The header sets the switch to 0 under
# AddressSanitizer, so `--sanitize` builds the constant at every read and ASan
# names a release too many of its value, where on a block no count moves it
# would be silent; a plain build compiles the block alone. The C is one text
# whatever the build, so the emission, its blessing and its cache key do not
# ask which.
#
# EVERY `#if`, `#else` AND `#endif` IS WRITTEN UNDER A CLAIM ON THE GENERATED
# FILE. A `#line` in the branch clang skips is never read, so the writer's
# belief after a branch would be the taken branch's on one build and the
# skipped one's on the other; a claim on the generated file is the one belief
# both builds share at each of the three lines, because that file advances a
# line per line whether clang reads them or skips them.
#
# WHICH BODY IS LAID OUT is decided by the IR, never by a reading of the
# source: one block, whose instructions are literals, array and case
# constructions over them, and the ownership pass's own loads, stores and
# counts, and which returns an array. Anything else is built at every read, as
# before: a body naming another constant (a call), an `f"..."` (calls), an
# arithmetic or an index (each can abort, and an abort belongs at the read),
# an `if` or a `match` (more than one block), a map (its layout is the
# runtime's hash, which a second copy here could disagree with), and a
# function value (its `funcref` is what gives a callback its thread guard,
# `emit/callback_guard.hero`, and a C address in an initializer would drop it).
# A record cannot be a constant's body today (`constant_body` refuses its
# constructor as a call), so a record construction is built too: laid out it
# would be a route nothing runs.

use ast
use source
use check/table
use check/state
use widths
use ir
use ir/containers
use emit/ctype
use emit/literal
use emit/descriptors
use emit/aggregate
use emit/signature
use emit/mangle
use emit/writer
use parse
use resolve
use checker
use ir/lower
use ir/mono
use ir/own
use ir/place_store

# The runtime's switch, `heroes_runtime.h`: 1 in a plain build, 0 under
# AddressSanitizer.
constant SWITCH: str
    "HERO_STATIC_CONSTANTS"

# What one constant becomes: its static blocks, innermost first so each is
# defined before an outer one names it, and the C the function returns.
record Laid
    blocks: [str]
    returned: str

# One construction, as C a static initializer takes: `text` is the value and
# `block` the static block it names, empty where it names none.
record Built
    text: str
    block: str

# The constant `f` laid out, or why it is built at every read.
function laid_for(p: containers.Program, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function) -> Laid?
    return laid_out(p, c, names, s, decls, f, owner: signature.instance_name(f, c, s, decls))

# The first route and the switch around it: the blocks and the function that
# returns the outermost one's address, then `#else`, which the caller follows
# with the function that builds the constant and `close`.
function open(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, laid: Laid)
    writer.blank(@w)
    writer.at_generated(@w)
    writer.line(@w, text: "#if " + SWITCH)
    writer.at_span(@w, s, offset: f.span.start)

    for block in laid.blocks
        writer.line(@w, text: block)

    writer.at_span(@w, s, offset: f.span.start)
    writer.line(@w, text: signature.signature(f, c, names, s, decls) + " {")
    writer.at_generated(@w)
    writer.line(@w, text: "    return " + laid.returned + ";")
    writer.line(@w, text: "}")
    writer.at_generated(@w)
    writer.line(@w, text: "#else")

function close(@w: writer.Writer)
    writer.at_generated(@w)
    writer.line(@w, text: "#endif")

function laid_out(p: containers.Program, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, owner: str) -> Laid?
    is_constant: bool @= false

    match f.kind
        .constant_kind                             => is_constant @ true
        .function_kind | .extern_kind | .test_kind => is_constant @ false

    if !is_constant || f.blocks.len() != 1 || !is_array(c, ty: f.result)
        return fail(code: "none", msg: "not a constant array of one block")
    texts: {i64: str} @= {}
    blocks: [str] @= []

    for one in f.blocks[0].insts
        match one.op
            .lit lt =>
                if one.dest.is_err()
                    return fail(code: "none", msg: "a literal with no value")
                texts[one.dest.must()] @ literal.constant_text(
                    lt.value,
                    kind: int_kind(c, ty: one.ty),
                    strings: p.strings
                )
            .construct k =>
                if one.dest.is_err()
                    return fail(code: "none", msg: "a construction with no value")
                arguments: [str] @= []

                for arg in containers.args_of(f, k.arguments)
                    match arg
                        .value_arg v =>
                            found = texts[v.value]

                            if found.is_err()
                                return fail(code: "none", msg: "an element that is not a literal")
                            arguments @ arguments.push(found.must())
                        .inout_arg => return fail(code: "none", msg: "an element by address")

                built = constructed(
                    c,
                    names,
                    s,
                    decls,
                    shape: k.shape,
                    ty: one.ty,
                    arguments: arguments,
                    name: mangle.constant_block(owner: owner, held: one.dest.must())
                )

                if built.is_err()
                    return fail(code: "none", msg: "a construction built at every read")

                if built.must().block != ""
                    blocks @ blocks.push(built.must().block)
                texts[one.dest.must()] @ built.must().text
            # The ownership pass's own bookkeeping over the values above: on
            # a block no count moves, every one of them is the guard's no-op.
            .load | .store | .incref | .decref | .decref_slot => continue
            .push_owned | .unary | .binary | .cast | .call    => return fail(code: "none", msg: "a computed body")
            .field | .index | .map_get | .len_of | .tag_of    => return fail(code: "none", msg: "a computed body")
            .payload | .func_ref | .copy_out | .abort_op      => return fail(code: "none", msg: "a computed body")
            .hole | .missing                                  => return fail(code: "none", msg: "a computed body")

    match f.blocks[0].term
        .return_term rt =>
            if rt.value.is_err()
                return fail(code: "none", msg: "a constant that returns nothing")
            found = texts[rt.value.must()]

            if found.is_err()
                return fail(code: "none", msg: "a constant that returns a value it did not lay out")
            return ok(Laid(blocks: blocks, returned: found.must()))
        .jump | .branch | .switch_term | .unreachable | .open => return fail(code: "none", msg: "a body with a branch")

    return fail(code: "none", msg: "unreached")

# An array and a case over literals; every other shape is built at every
# read, a map and a record among them (the module doc says why).
function constructed(c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], shape: ir.Shape, ty: i64, arguments: [str], name: str) -> Built?
    match shape
        .array_shape =>
            element: i64 @= 0 - 1

            match table.get(c.types, ty)
                .array arr                                                => element @ arr.element
                .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => element @ element
                .fixed | .map | .fallible | .function_ty | .named         => element @ element
                .case_ty | .failure | .generic | .error                   => element @ element

            if element < 0
                return fail(code: "none", msg: "not a runtime array")
            desc = descriptors.pointer(c, names, ty: element)
            spelling = ctype.c_type(names, c: c, ty: element)

            if desc.is_err() || spelling.is_err()
                return fail(code: "none", msg: "an element with no descriptor or no C type")
            text = "HERO_ARRAY_LIT(" + name + ")"

            if arguments.len() == 0
                return ok(Built(text: text, block: "HERO_ARRAY_STATIC_EMPTY(" + name + ", " + desc.must() + ");"))
            head = name + ", " + spelling.must() + ", " + desc.must() + ", " + arguments.len().to_str()
            return ok(Built(text: text, block: "HERO_ARRAY_STATIC(" + head + ", " + arguments.join(", ") + ");"))
        .case_shape cs =>
            literal_text = aggregate.construct_case(c, names, s, decls, decl: cs.decl, at: cs.at, arguments: arguments)

            if literal_text.is_err()
                return fail(code: "none", msg: "a case the printer refused")
            return ok(Built(text: literal_text.must(), block: ""))
        .record_shape | .map_shape | .ok_shape | .fail_shape | .err_shape => return fail(
            code: "none",
            msg: "a shape built at every read"
        )

    return fail(code: "none", msg: "unreached")

function is_array(c: state.Checked, ty: i64) -> bool
    match table.get(c.types, ty)
        .array                                                    => return true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return false
        .fixed | .map | .fallible | .function_ty | .named         => return false
        .case_ty | .failure | .generic | .error                   => return false

    return false

# The width a literal is spelled at, from its own type: `inst.hero`'s reason.
function int_kind(c: state.Checked, ty: i64) -> widths.IntKind?
    match table.get(c.types, ty)
        .int_ty ik                                                 => return ok(ik.kind)
        .float_ty | .bool | .str | .ptr | .cstr | .unit            => return fail(code: "none", msg: "not an integer")
        .array | .fixed | .map | .fallible | .function_ty | .named => return fail(code: "none", msg: "not an integer")
        .case_ty | .failure | .generic | .error                    => return fail(code: "none", msg: "not an integer")

    return fail(code: "none", msg: "unreached")

## Tests

function lowered(text: str) -> containers.Program
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    p: containers.Program @= low.program
    cc: state.Checked @= c
    _ = mono.run(@p, @cc, s, parsed.decls).len()
    place_store.run(@p)
    own.run(@p, cc)
    return p

function laid_text(text: str) -> Laid?
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    p = lowered(text)
    names = ctype.new_names(s, parsed.decls)

    for f in p.functions
        if f.name == "K"
            return laid_out(p, c, names, s, parsed.decls, f: f, owner: "b")

    return fail(code: "none", msg: "no constant K")

test "literals are laid out, the inner block first, and the read is the address"
    got = laid_text("constant K: [[i64]]\n    [[1, 2], []]\n\nfunction main()\n    print(K[0][1])\n")
    assert !got.is_err()
    assert got.must().blocks.len() == 3
    assert got.must().blocks[0] == "HERO_ARRAY_STATIC(hero_constant_b_3, int64_t, &hero_desc_int, 2, INT64_C(1), INT64_C(2));"
    assert got.must().blocks[1] == "HERO_ARRAY_STATIC_EMPTY(hero_constant_b_4, &hero_desc_int);"
    assert got.must().returned == "HERO_ARRAY_LIT(hero_constant_b_5)"

test "a computed body, a branch and a function value are built at every read"
    computed = "constant BASE: i64\n    40\n\nconstant K: [i64]\n    [BASE + 2]\n\nfunction main()\n    print(K[0])\n"
    branch = "constant K: [i64]\n    if 1 > 0 [1] else [2]\n\nfunction main()\n    print(K[0])\n"
    called = "function twice(x: i64) -> i64\n    return x * 2\n\nconstant K: [(function(i64) -> i64)]\n    [twice]\n\nfunction main()\n    print(K[0](x: 1))\n"

    for text in [computed, branch, called]
        assert laid_text(text).is_err()

# Each of the switch's three lines is read where the generated file is
# believed at its own line, the one belief a build that skips either branch
# shares with one that reads it: asked of every line `open` and `close` write
# around a constant, a source line and a built body on either side.
test "the switch's three lines are each read where the generated file is believed"
    text = "constant K: [i64]\n    [1, 2]\n\nfunction main()\n    print(K[1])\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    p = lowered(text)
    names = ctype.new_names(s, parsed.decls)
    w: writer.Writer @= writer.new_writer("t")

    for f in p.functions
        if f.name == "K"
            writer.at_file(@w, file: "t.hero", at: 4)
            writer.line(@w, text: "before;")
            open(@w, c, names, s, parsed.decls, f: f, laid: laid_for(p, c, names, s, parsed.decls, f: f).must())
            writer.at_file(@w, file: "t.hero", at: 2)
            writer.line(@w, text: "built;")
            close(@w)

    got = writer.finish(w)
    believed: i64 @= 1
    physical: i64 @= 1
    start: i64 @= 0
    seen: i64 @= 0
    at: i64 @= 0

    while at < got.len()
        if got[at] == 10
            one = got.slice(from: start, to: at)

            if one == "#if " + SWITCH || one == "#else" || one == "#endif"
                assert believed == physical
                seen @ seen + 1

            if one == "#line " + (physical + 1).to_str() + " \"t.c\""
                believed @ physical + 1
            else if one.len() > 6 && one.slice(from: 0, to: 6) == "#line "
                believed @ 0 - 1
            else if believed > 0
                believed @ believed + 1
            physical @ physical + 1
            start @ at + 1
        at @ at + 1

    assert seen == 3
