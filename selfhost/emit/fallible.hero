# T? as C: two alternatives, a tag, and never a guess about which one
# is live (design.md §4.6, §4.8). Port of heroes/src/emit/fallible.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# Its own module because a T? is the one aggregate whose members are
# ALTERNATIVES: a record's fields all exist at once, and reading the
# wrong one of these is reading a union member that was never written.
# Every function here writes the tag explicitly — C would zero it for
# ok — so a reader of the generated C sees which side this is without
# knowing C's initialiser rules.
#
# ? propagates a failure UNCHANGED (§4.6): nothing re-reads its code or
# msg on the way out, which is why the err shape is one struct
# assignment and not a rebuild.

use check/state
use check/table
use checker
use emit/ctype
use emit/mangle
use ir
use ir/containers
use parse
use resolve
use source
use token

# ok(x), fail(code, msg) and the err that ? produces — one compound
# literal each.
function construct_option(names: ctype.Names, result: i64, shape: ir.Shape, arguments: [str]) -> str?
    name = ctype.option_of(names, ty: result)

    match shape
        .ok_shape =>
            if arguments.len() > 0
                return ok("(" + name + "){.hero_tag = INT64_C(0), .hero_as.hero_ok = " + arguments[0] + "}")

            # ok(()) — a unit payload has no member at all, so the tag
            # is the whole value.
            return ok("(" + name + "){.hero_tag = INT64_C(0)}")
        .fail_shape =>
            if arguments.len() < 2
                return fail(code: "none", msg: "a fail without both sides")
            return ok(
                "(" + name + "){.hero_tag = INT64_C(1), .hero_as.hero_err = {.code = " + arguments[0] + ", .msg = " + arguments[1] + "}}"
            )
        .err_shape =>
            if arguments.len() < 1
                return fail(code: "none", msg: "an err without its failure")
            return ok("(" + name + "){.hero_tag = INT64_C(1), .hero_as.hero_err = " + arguments[0] + "}")
        .record_shape | .case_shape | .array_shape | .map_shape => return fail(code: "none", msg: "not an option shape")

    return fail(code: "none", msg: "unreached")

# The arguments of an option's construction that carry a value, as C names. A
# unit-typed value has no temporary (the unit rule, `emit/ctype.hero`), so an
# `ok` handed one is built as `ok()` is, the tag alone: a generic instance at
# `()` hands one over, since `ok(v)` with `v: T` is checked once for every `T`
# (defect 2682). Only an option leaves an argument out: an array's or a map's
# would lose an element, and `()` as either is refused before emission
# (`unit_element`).
function carried_arguments(c: state.Checked, f: containers.Function, run: ir.Run) -> [str]
    out: [str] @= []

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v =>
                if !ctype.is_unit(c, ty: containers.value_type(f, v.value))
                    out @ out.push(mangle.value(v.value))
            .inout_arg => continue

    return out

# t16 = t15.hero_tag; for a T?, the same member a variant uses.
function option_tag(base: i64) -> str
    return mangle.value(base) + ".hero_tag"

# .hero_as.hero_ok for case 0 and .hero_as.hero_err for case 1 — the IR's
# own numbering; the members `emit/types.hero` names.
function option_payload(base: i64, at: i64) -> str
    member: str @= "hero_err"

    if at == 0
        member @ "hero_ok"
    return mangle.value(base) + ".hero_as." + member

## Tests

test "the tag is written even where C would zero it, and err is one assignment"
    text = "record Holder\n    maybe: i64?\n\nfunction main()\n    h = Holder(maybe: ok(3))\n    _ = h\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked = checker.check(p.tree, out, s, p.decls)
    names0 = ctype.new_names(s, p.decls)
    names = ctype.with_options(names0, c: c, s: s, decls: p.decls)
    opt: i64 @= 0 - 1

    for id in keys(names.options)
        opt @ id

    assert opt >= 0
    built = construct_option(names, result: opt, shape: .ok_shape, arguments: ["t3"])
    assert built.must() == "(h_0opt_e201354){.hero_tag = INT64_C(0), .hero_as.hero_ok = t3}"
    failed = construct_option(names, result: opt, shape: .fail_shape, arguments: ["t1", "t2"])
    assert failed.must() == "(h_0opt_e201354){.hero_tag = INT64_C(1), .hero_as.hero_err = {.code = t1, .msg = t2}}"
    wrapped = construct_option(names, result: opt, shape: .err_shape, arguments: ["t9"])
    assert wrapped.must() == "(h_0opt_e201354){.hero_tag = INT64_C(1), .hero_as.hero_err = t9}"
    assert option_tag(base: 15) == "t15.hero_tag"
    assert option_payload(base: 15, at: 0) == "t15.hero_as.hero_ok"
    assert option_payload(base: 15, at: 1) == "t15.hero_as.hero_err"

test "carried_arguments: a unit-typed argument has no temporary, so ok of one is the tag alone"
    text = "function main()\n    x: ()? = ok()\n    print(x.is_err())\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked = checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names = ctype.with_options(ctype.new_names(s, p.decls), c: c, s: s, decls: p.decls)
    unit_id = table.unit_ty(c.types)
    int_id = table.int_ty_id(c.types)
    f = containers.Function(
        name: "t",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [unit_id, int_id, unit_id],
        arguments: [.value_arg(value: 2), .value_arg(value: 1)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    unit_only = carried_arguments(c, f, run: ir.Run(start: 0, length: 1))
    assert unit_only.len() == 0
    assert carried_arguments(c, f, run: ir.Run(start: 1, length: 1)) == ["t1"]
    assert carried_arguments(c, f, run: ir.Run(start: 0, length: 2)) == ["t1"]
    unit_opt = table.lookup(c.types, .fallible(payload: unit_id)).must()
    built = construct_option(names, result: unit_opt, shape: .ok_shape, arguments: unit_only)
    assert built.must() == "(" + ctype.option_of(names, ty: unit_opt) + "){.hero_tag = INT64_C(0)}"
