# The half of §4.19's guarantee that asks what an extern ACCEPTS
# (design.md §4.19; panels 036, 042, 051, 052, 053). Port of
# archive/bootstrap-rs/heroes/src/emit/extern_probe.rs.
#
# extern_assert asks what a header RETURNS, with a _Generic whose
# controlling expression C11 does not evaluate — and that mechanism is
# exactly why it cannot ask about parameters: an unevaluated expression
# gets no conversion diagnostics, measured silent under
# -Wshorten-64-to-32 in both forms. So the check is BUILT: one
# never-called function per extern with a parameter, whose parameters
# are the declared types and whose body is the call. A parameter
# cannot be folded the way f((int64_t)0) is, so the conversion is the
# one the real call would make; #line at the declaration puts clang's
# verdict on the author's own extern line; unused static keeps the
# binary and -Wunused-function quiet. Silent on a correct binding
# (measured on all eleven ladder bindings) and on f64/cstr/ptr/str,
# which convert exactly or not at all.

use ast
use source
use check/table
use check/state
use check/freer_marks
use ir/containers
use emit/mangle
use emit/ctype
use emit/externs as emit_externs
use emit/ffi_lookup as ffi_lookup
use emit/lend_type
use emit/probe_params
use emit/writer
use emit/checks_raised
use parse
use resolve
use checker
use ir/lower

# The probe's name goes THROUGH the mangler — the mirror of §4.19's own
# exception. An extern's C name passes unmangled because it must
# survive to the linker; a probe is a static this compiler invented,
# which no linker ever sees. Panel 053's spec-warden found the cost of
# forgetting: two modules binding one C function gave "redefinition of
# 'hero_ffi_probe_getenv'" at exit 2, the compiler blaming itself for
# two declarations the author was entitled to write.
constant PREFIX: str
    "hero_ffi_probe_"

# What is an ERROR inside the probe block and nowhere else (panel 092's
# queued float half, landed with its adjacent shapes). A probe's
# arguments are exactly the declared types, so any implicit conversion
# at its call IS a declaration that disagrees with the header — there
# is no benign fire to scope around. The pragma is the scope: ordinary
# generated code converts deliberately (casts, which no implicit-
# conversion warning reads) and stays outside it.
#
# Four names, each with a measured witness, because no one flag covers
# the family:
# - double-promotion: f32 where the header says double or long double.
#   The value converts EXACTLY, which is why -Wconversion cannot see
#   it (measured silent) — the defect is upstream, every digit past
#   f32's precision already rounded away before the call.
# - implicit-float-conversion: f64 where the header says float — and
#   its subgroup implicit-int-float-conversion, an integer declared
#   where the header holds a float (i64 against double rounds large
#   values).
# - float-conversion: a float declared where the header takes an
#   integer. C drops the fraction; measured NOT covered by either flag
#   above, and the one direction that changes 0.75 into 0.
# - implicit-int-conversion: integer narrowing below the global
#   -Werror=shorten-64-to-32 window — i64 against short, i32 against
#   short, i16 against char, all measured silent without it.
#
# What stays silent after these four is exactly what C converts
# without changing any value (i32 where the header says double, i16
# where it says int) plus what a pointer points at — the two holes the
# spec names, at their final size (panel 092's verdict).
constant PROBE_ERRORS: [str]
    [
        "-Wdouble-promotion"
        "-Wimplicit-float-conversion"
        "-Wfloat-conversion"
        "-Wimplicit-int-conversion"
    ]

# A probe, computed before anything is written: the pragma block that
# wraps the probes may only exist when at least one probe does, and
# the writer cannot take a line back.
record Probe
    file: str
    line: i64
    text: str

function probe_name(module: str, name: str) -> str
    return PREFIX + mangle.function_name(module: module, name: name)

# One probe per extern that has at least one parameter. The narrowing
# is HAS A PARAMETER — a fact about the declaration in hand: a
# signature with none has nothing to check, and a constant is not a
# call. Nothing asks what KIND of extern it is; that premise is the one
# M-header-constants falsified for the sibling walks.
function extern_probes(@w: writer.Writer, p: containers.Program, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl])
    probes: [Probe] @= []

    for f in p.functions
        if emit_externs.extern_spans(decls, f).header.is_err()
            continue

        if f.params.len() == 0
            continue
        name = source.span_text(s, decls[f.decl].name)

        # A function some `owned` mark names is probed as a FREER: its
        # pointer parameter is typed `char *`, which is where a wrong
        # freer becomes a compile error rather than a SIGSEGV.
        frees = !freer_marks.marked_as_freer(c.freers, name: name).is_err()
        parameters = probe_params.parameter_list(names, c, decls, f, frees: frees)

        if parameters.is_err()
            continue
        arguments = probe_arguments(f, c, names, callee: name)

        # The declaration's own file and line, so clang's verdict lands
        # where the author can act on it — and a probe for a library's
        # extern claims the library.
        found = source.source_line(s, decls[f.decl].name.start)
        module = source.component_at(s, decls[f.decl].span.start)
        probes @ probes.push(
            Probe(file: found.file, line: found.line, text: probe_line(probe: probe_name(module: module, name: name), name: name, parameters: parameters.must(), arguments: arguments))
        )

    # Every check raised again at the region's opening, outside its push so
    # that what follows it keeps them too: a group constant's macro expanded
    # by an assertion above can have turned one off with a `_Pragma`
    # (`emit/checks_raised.hero`, defect 570). Wherever the unit binds a
    # group, with or without a probe.
    grouped = binds_a_group(p, s, decls)

    if probes.len() == 0 && !grouped
        return
    writer.at_generated(@w)

    if grouped
        for raised in checks_raised.lines()
            writer.line(@w, text: raised)

    if probes.len() == 0
        writer.blank(@w)
        return
    writer.line(@w, text: "#pragma clang diagnostic push")

    for flag in PROBE_ERRORS
        writer.line(@w, text: "#pragma clang diagnostic error \"" + flag + "\"")

    for probe in probes
        writer.at_file(@w, file: probe.file, at: probe.line)
        writer.line(@w, text: probe.text)

    writer.at_generated(@w)
    writer.line(@w, text: "#pragma clang diagnostic pop")
    writer.blank(@w)

# Whether the unit binds a function or a constant of a group's header, a
# header other than the compiler's own (`emit/externs.hero`'s `is_own`).
function binds_a_group(p: containers.Program, s: source.Source, decls: [ast.Decl]) -> bool
    for f in p.functions
        header = emit_externs.extern_spans(decls, f).header

        if !header.is_err() && !emit_externs.is_own(emit_externs.unquoted(s, span: header.must()))
            return true

    return false

# A probe's parameters as C, spelled by `emit/probe_params.hero` and named here
# as well, since every reader of a probe asks this module for its parts.
function parameter_list(names: ctype.Names, c: state.Checked, decls: [ast.Decl], f: containers.Function, frees: bool) -> [str]?
    return probe_params.parameter_list(names, c, decls, f, frees: frees)

# The probe, as one line of C. ONE FORMATTER, TWO READERS — the error
# mapper rebuilds this string from the declaration to find WHICH
# argument clang's column points at. Rebuilding is exact because the
# line is a pure function of the declaration; reading clang's echoed
# source line instead is the trap panel 038 paid for.
#
# THE CALLEE IS PARENTHESISED, AND THAT IS THE WHOLE CHECK FOR HALF OF
# libc (panel 092). `(void)memset(a0, a1, a2)` does not reach `memset`:
# on a fortified SDK the name is a MACRO, and `clang -E` shows what the
# probe really compiles —
#     (void)__builtin___memset_chk (a0, a1, a2, __builtin_object_size (a0, 0))
# — a rewrite that discards the conversion diagnostics this probe exists
# to provoke. `memset(n: i32)` against `size_t` was exit 0 for it, while
# `strncmp`, `malloc`, `calloc`, `abs` and `fwrite` — all clang builtins,
# none of them fortified — were caught all along. So the cause was never
# builtins and `-fno-builtin` never helped: a MACRO was doing the
# redirect, and `(memset)(…)` is not a function-like macro invocation.
# Two lines, and `memset(n: i32)` goes exit 0 -> exit 1.
#
# What it costs is §4.19's macro promise for a MACRO-ONLY name:
# `(htonl)(a0)` is `use of undeclared identifier`, and so is `(&htonl)`.
# Measured: 44 distinct C functions are probed by the corpus and none is
# macro-only, so nothing fires today — but the promise is in the document
# and the golden case is owed (docs/panel/092 § Where the seats disagreed).
function probe_line(probe: str, name: str, parameters: [str], arguments: [str]) -> str
    return "__attribute__((unused)) static void " + probe + "(" + parameters.join(", ") + ") { (void)(" + name + ")(" + arguments.join(", ") + "); }"

# The arguments the probe's body hands to the header's function: the
# positional names, and `(void *)aN` for an `@` parameter that is opaque
# or numeric (panel 103, 2026-09-03). C converts `void *` to any object
# pointer and `void **` to none, so `void ** a1` handed to `sqlite3 **` is
# `-Wincompatible-pointer-types` — an ERROR by default on clang 22 and,
# since the same day, under this compiler's own flags on every clang. A
# numeric `@` is cast for the other half of the same fact: `uint64_t *`
# against `size_t *` is two types and one width on macOS. What the cast
# gives up — clang checking the pointee — the compiler does itself, by
# width and sign, in `cli/pointee.hero`. A `cstr` `@` stays TYPED: its
# `const char **` against a header's `char **` is panel 058's
# `discards qualifiers`, the writability check, and a cast would
# silence it. So would a `record`'s: the header's own struct is exact. A
# `cstr` lent to a pointer the check read crosses cast, as at the call
# (`emit/lend_type.hero`, defect 427), so every reader rebuilds it alike.
function probe_arguments(f: containers.Function, c: state.Checked, names: ctype.Names, callee: str) -> [str]
    out: [str] @= []
    index: i64 @= 0

    for slot_id in f.params
        name = "a" + index.to_str()

        if is_cast_out(c, f.slots[slot_id])
            out @ out.push("(void *)" + name)
        else
            out @ out.push(name)
        index @ index + 1

    return lend_type.cast_lends(names.lend_units, name: callee, arguments: out)

# An `@` parameter whose declared type is opaque or numeric — the two
# the emitter hands to C as `(void *)`, at the call and in the probe.
function is_cast_out(c: state.Checked, slot: containers.Slot) -> bool
    mutable: bool @= false

    match slot.kind
        .param_slot ps =>
            if ps.mutable
                mutable @ true
        .local_slot | .synthetic_slot | .return_slot => mutable @ mutable

    if !mutable
        return false

    # An array is the buffer C fills, its pointee asked by `emit/lend_buffer.hero` (panel 196's R4).
    return match table.get(c.types, slot.ty)
        .ptr | .int_ty | .float_ty | .bool | .array                        => true
        .cstr | .str | .named | .unit | .fixed | .map                      => false
        .fallible | .function_ty | .case_ty | .failure | .generic | .error => false

# The names a probe gives its arguments: positional, so nothing about
# the author's own parameter names can change the generated line.
function argument_names(count: i64) -> [str]
    out: [str] @= []
    index: i64 @= 0

    while index < count
        out @ out.push("a" + index.to_str())
        index @ index + 1

    return out

test "a probe per extern with parameters, mutables as pointers, columns exact"
    text = "extern \"m.h\"\n    function narrow(x: i64) -> i64\n    function fill(@buf: i64, n: i64)\n    function version() -> i64\n\nfunction main()\n    print(narrow(x: 1))\n    v: i64 @= 0\n    fill(buf: @v, n: 1)\n    print(version())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = lower.lower(parsed.tree, out, c, s, parsed.decls)
    names = ctype.new_names(s, parsed.decls)
    w: writer.Writer @= writer.new_writer("t")
    extern_probes(@w, low.program, c, names, s, parsed.decls)
    got = writer.finish(w)

    # The probe's name goes through the mangler; the C name does not.
    assert ffi_lookup.has(
        text: got,
        needle: "__attribute__((unused)) static void hero_ffi_probe_h_t_narrow(int64_t a0) { (void)(narrow)(a0); }"
    )

    # An @ parameter is declared the way the call site passes it.
    assert ffi_lookup.has(
        text: got,
        needle: "hero_ffi_probe_h_t_fill(int64_t * a0, int64_t a1) { (void)(fill)((void *)a0, a1); }"
    )

    # A zero-parameter extern gets no probe at all.
    assert !ffi_lookup.has(text: got, needle: "hero_ffi_probe_h_t_version")

    # #line at the declaration's own line.
    assert ffi_lookup.has(text: got, needle: "#line 2 \"t.hero\"")

    # The pragma block: every PROBE_ERRORS flag is an error inside it,
    # the push precedes the first probe and the pop follows the last —
    # an error pragma leaking past the block would judge generated
    # code, whose conversions are deliberate casts.
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic push")
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic error \"-Wdouble-promotion\"")
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic error \"-Wimplicit-float-conversion\"")
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic error \"-Wfloat-conversion\"")
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic error \"-Wimplicit-int-conversion\"")
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic pop")
    assert find_text(line: got, needle: "diagnostic push").must() < find_text(line: got, needle: "hero_ffi_probe_h_t_narrow").must()

    # And every check raised again before the push, so it outlives the pop:
    # the unit binds a group (defect 570).
    assert find_text(line: got, needle: "diagnostic error \"-Wsign-conversion\"").must() < find_text(line: got, needle: "diagnostic push").must()
    assert ffi_lookup.has(text: got, needle: "#pragma clang diagnostic error \"-Wint-conversion\"")
    assert find_text(line: got, needle: "diagnostic pop").must() > find_text(line: got, needle: "hero_ffi_probe_h_t_fill").must()

# The probe block may only exist when a probe does; the checks are raised
# wherever a group is bound, a probe or none, and a program binding only the
# compiler's own headers gets neither.
test "no probes, no pragma block: the block may only exist when a probe does"
    for header in ["m.h", "hero_os.h"]
        text = "extern \"" + header + "\"\n    function version() -> i64\n\nfunction main()\n    print(version())\n"
        parsed = parse.parse(text)
        s = source.new_source(name: "t.hero", text: text)
        out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
        c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
        assert c.diagnostics.len() == 0
        low = lower.lower(parsed.tree, out, c, s, parsed.decls)
        names = ctype.new_names(s, parsed.decls)
        w: writer.Writer @= writer.new_writer("t")
        extern_probes(@w, low.program, c, names, s, parsed.decls)
        got = writer.finish(w)
        assert !ffi_lookup.has(text: got, needle: "diagnostic push")

        if header == "m.h"
            assert ffi_lookup.has(text: got, needle: checks_raised.lines()[0])
        else
            assert got == ""

# Byte offset of the first occurrence of needle, over chars so the scan
# never splits a character — the ASCII probe lines make the two counts
# agree.
function find_text(line: str, needle: str) -> i64?
    cs = line.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return ok(0)

    if needle_cs.len() > cs.len()
        return fail(code: "none", msg: "not found")
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return ok(start)
        start @ start + 1

    return fail(code: "none", msg: "not found")
