# What an instruction still means when NOBODY READS ITS RESULT.
# Port of archive/bootstrap-rs/heroes/src/emit/unread.rs.
#
# Nothing here emits anything: inst answers "what does this look like
# in C"; this answers "may it lose its destination, and may it
# disappear entirely" — the question the emitter asks BEFORE printing,
# and the one -Wunused-but-set-variable turns on. Together with the
# per-function half: one concern, what the emitted C reads.
#
# may_lose_its_destination is exhaustive ON PURPOSE, and that is the
# repair: it was a three-name list resting on the premise that nothing
# else could produce a value the C never reads. `_ = f(x)?` produces a
# Payload that does, and the premise died in silence with a clang
# warning as its only trace — found by a corpus program three
# milestones later (fixedbugs, 2026-08-13). A new op now has to answer
# here before the compiler builds.

use check/state
use ir
use ir/containers
use ir/uses
use emit/ctype
use token
use check/table
use source
use parse
use resolve
use checker

# Whether this instruction is still correct with its destination
# dropped. Two groups may lose it: a PURE READ simply vanishes, and a
# CALL is emitted for its effect and merely goes unassigned — which is
# what `_ = f(x)` means. Everything else keeps it: Index/Cast/Unary/
# Binary can ABORT and their emitters print the check WITH the
# assignment; Construct and MapGet build a value, which for a counted
# type is a retain; the effects have no destination to drop; Hole and
# Missing never reach a backend.
function may_lose_its_destination(op: ir.OpKind) -> bool
    return match op
        .lit | .load | .field | .payload | .tag_of | .len_of | .call             => true
        .func_ref | .store | .push_owned | .unary | .binary | .cast | .construct => false
        .index | .map_get | .copy_out | .abort_op                                => false
        .incref | .decref | .decref_slot | .hole | .missing                      => false

# Whether the instruction disappears ENTIRELY when its result is unread
# — the narrower half, and the one the fixpoint iterates over. A
# discarded call still prints its call, so it still reads its
# arguments; a discarded pure read prints nothing at all, so its
# operand loses a reader and may itself become unread. That chain is
# why emitted_reads is a loop.
function vanishes_when_unread(op: ir.OpKind) -> bool
    if !may_lose_its_destination(op)
        return false

    return match op
        .call                                                                    => false
        .lit | .load | .field | .payload | .tag_of | .len_of                     => true
        .func_ref | .store | .push_owned | .unary | .binary | .cast | .construct => true
        .index | .map_get | .copy_out | .abort_op                                => true
        .incref | .decref | .decref_slot | .hole | .missing                      => true

# Whether any EMITTED instruction assigns this temporary: value 0 (the
# unit) is assigned by nothing, and a temporary that only exists inside
# a block nobody reaches would be an unused variable.
function assigned(f: containers.Function, live: [bool], value: i64) -> bool
    index: i64 @ 0

    for blk in f.blocks
        if live[index]
            for one in blk.insts
                if !one.dest.is_err() && one.dest.must() == value
                    return true
        index @ index + 1

    return false

# A temporary that a safe op writes and nothing reads: `_ = f(x)`, and
# the load r.must() leaves behind when the payload is (). The pair of
# this and inst's own test is what keeps the declaration and the
# assignment in step — they ask the same question of the same set.
function discarded(f: containers.Function, live: [bool], value: i64, read: {i64: bool}) -> bool
    if !read[value].is_err()
        return false
    index: i64 @ 0

    for blk in f.blocks
        if live[index]
            for one in blk.insts
                if !one.dest.is_err() && one.dest.must() == value
                    return may_lose_its_destination(one.op)
        index @ index + 1

    return false

# What the EMITTED C reads, which is not what the IR references: an
# instruction whose result is unit emits nothing at all, so its
# operands are referenced by the IR and read by no C. A fixpoint, and
# the chain that made it one arrived on schedule: the limit was written
# down ("no such chain exists today; if one appears, the answer is a
# worklist") and `_ = f(x)?` was that chain, arriving with a corpus
# program on 2026-08-13. So the note is now the code. gone only grows
# and is bounded by the number of values, so the loop ends.
function emitted_reads(f: containers.Function, c: state.Checked) -> {i64: bool}
    gone: {i64: bool} @ {}

    while true
        read = reads_given(f, c, gone: gone)
        grew: bool @ false

        for blk in f.blocks
            for one in blk.insts
                if one.dest.is_err()
                    continue
                dest = one.dest.must()

                if !gone[dest].is_err() || !read[dest].is_err()
                    continue

                if vanishes_when_unread(one.op)
                    gone[dest] @ true
                    grew @ true

        if !grew
            return read

    empty: {i64: bool} = {}
    return empty

# One round: what the C reads, given the instructions already known to
# print nothing.
function reads_given(f: containers.Function, c: state.Checked, gone: {i64: bool}) -> {i64: bool}
    read: {i64: bool} @ {}

    for blk in f.blocks
        for one in blk.insts
            # A pure op with a unit result prints nothing, so it reads
            # nothing — the case that produced this rule is ()?.
            silent: bool @ false

            if !one.dest.is_err() && ctype.is_unit(c, ty: one.ty)
                is_effect: bool @ false

                match one.op
                    .call | .abort_op                                                           => is_effect @ true
                    .lit | .load | .store | .push_owned | .unary | .binary | .cast | .construct => is_effect @ is_effect
                    .field | .index | .map_get | .len_of | .tag_of | .payload                   => is_effect @ is_effect
                    .func_ref | .copy_out | .incref | .decref | .decref_slot | .hole | .missing => is_effect @ is_effect

                if !is_effect
                    silent @ true

            if !one.dest.is_err() && !gone[one.dest.must()].is_err()
                silent @ true

            if silent
                continue

            for value in uses.operands(f, one.op)
                read[value] @ true

        for value in uses.terminator_operands(blk.term)
            read[value] @ true

    return read

# Whether anything in this function READS the slot — the question
# -Wunused-but-set-variable turns on for a NAMED binding. `_ = v` is
# the only way to reach it: an unused binding is already a compile
# error, so a written-never-read slot exists exactly when the author
# wrote the discard. A refcounted slot never reaches here and the
# reason is structural: the exit sweep loads it to decref, so it is
# read by construction — the rule asks "does anything read it", a fact
# about this function, never "is it refcounted", a premise about the
# ownership pass. Conservative in the safe direction: the attribute
# means MAY be unused, so an over-count silences nothing.
function slot_is_read(f: containers.Function, live: [bool], read: {i64: bool}, slot: i64) -> bool
    index: i64 @ 0

    for blk in f.blocks
        if live[index]
            for inst in blk.insts
                match inst.op
                    # A load only counts if the load itself survives
                    # into C: `_ = v` lowers to a load whose destination
                    # is then discarded, so the slot is read in the IR
                    # and not in the emitted C.
                    .load ld =>
                        if ld.place.root == slot
                            if !inst.dest.is_err() && !discarded(f, live, value: inst.dest.must(), read: read)
                                return true
                    # A store THROUGH A PATH reads the root on the way
                    # (copy-on-write walks it); a store straight to the
                    # slot is the write this asks about.

                    .store st =>
                        if st.place.root == slot && st.place.path.length > 0
                            return true
                    # The place store reads the slot it grows: the old
                    # elements survive into the result.

                    .push_owned pg =>
                        if pg.place.root == slot
                            return true
                    # §4.8's copy-out reads the local and writes it back
                    # through the pointer.

                    .copy_out co =>
                        if co.param == slot
                            return true
                    .lit | .unary | .binary | .cast | .call | .construct                        => continue
                    .field | .index | .map_get | .len_of | .tag_of | .payload                   => continue
                    .func_ref | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue
        index @ index + 1

    return false

## Tests

test "the fixpoint: a unit payload silences its own feeding load"
    # `_ = f(x)?` in miniature: load(dest 1) feeds payload(dest 2) whose
    # type is unit. The extraction prints nothing, so the load loses its
    # reader, vanishes, and t1 must not be declared.
    text = "function f()\n    print(1)\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: state.Checked @ checker.check(p.tree, out, s, p.decls)
    unit_id = table.unit_ty(c.types)
    int_id = table.int_ty_id(c.types)
    span = token.Span(start: 0, end: 1)
    place = ir.Place(root: 0, path: ir.Run(start: 0, length: 0))
    insts: [ir.Inst] = [
        ir.Inst(dest: ok(1), op: .load(place: place), ty: int_id, span: span)
        ir.Inst(dest: ok(2), op: .payload(base: 1, at: 0), ty: unit_id, span: span)
    ]
    preds: [i64] = []
    blk = containers.Block(preds: preds, insts: insts, term: .return_term(value: fail("none", "bare")), note: "t")
    slots: [containers.Slot] = [containers.Slot(name: "r", ty: int_id, kind: .local_slot)]
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: unit_id,
        slots: slots,
        blocks: [blk],
        values: [unit_id, int_id, unit_id],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: span
    )
    read = emitted_reads(f, c)
    assert read[1].is_err()
    live: [bool] = [true]
    assert discarded(f, live, value: 2, read: read)
    assert discarded(f, live, value: 1, read: read)
    assert assigned(f, live, value: 1)
    assert !assigned(f, live, value: 0)

    # The slot is read in the IR and not in the C: `_ = v`'s shape.
    assert !slot_is_read(f, live, read: read, slot: 0)

test "the op table: pure reads and calls may lose, aborters may not"
    assert may_lose_its_destination(
        .call(callee: .builtin_fn(at: 0), arguments: ir.Run(start: 0, length: 0), variadic: false)
    )
    assert may_lose_its_destination(.load(place: ir.Place(root: 0, path: ir.Run(start: 0, length: 0))))
    assert may_lose_its_destination(.payload(base: 1, at: 0))
    assert !may_lose_its_destination(.binary(op: .add, left: 1, right: 2))
    assert !may_lose_its_destination(.index(base: 1, at: 2))
    assert !may_lose_its_destination(.construct(shape: .array_shape, arguments: ir.Run(start: 0, length: 0)))
    assert !vanishes_when_unread(.call(callee: .builtin_fn(at: 0), arguments: ir.Run(start: 0, length: 0), variadic: false))
    assert vanishes_when_unread(.lit(value: .null_ptr))
