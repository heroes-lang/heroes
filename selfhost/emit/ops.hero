# One call as C — a Heroes function, a built-in, a function value, a C
# function — and print (design.md §4.14, §4.19, §4.20; panels 006, 020,
# 029, 042, 052, 053). Port of heroes/src/emit/ops.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# inst answers WHICH operation an instruction is and where its result
# goes; this answers WHAT one operation is in C. The one rule with a
# measured reason: print is monomorphic, one runtime entry point per
# type (panel 006), which is what lets clang type-check every one.

use ast
use source
use check/table
use check/state
use ir
use ir/containers
use ir/instances
use inventory
use emit/mangle
use emit/ctype
use emit/heroes_call
use emit/builtins
use emit/convert
use emit/bytes_text
use emit/field_lend
use emit/lend_extent
use emit/lend_buffer
use emit/lend_local
use emit/padding
use emit/guarded_args
use emit/writer
use emit/handle_traffic
use emit/handle_before
use emit/handle_result
use emit/handle_place
use emit/handle_text
use emit/callback_thunk
use emit/printing
use emit/lend_type
use emit/nodebug
use emit/stop_place
use token
use parse
use resolve
use checker

# `p` is the program held with its index, built once per program
# (`instances.Held`, defect 492): every lookup below reads it. `site` is where
# the call stands, the place a check before it names (panel 230's R1).
function call(@w: writer.Writer, p: instances.Held, f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], callee: ir.Callee, run: ir.Run, arguments: [str], target: str?, instance: [i64], site: i64)
    assign: str @= ""

    if !target.is_err()
        assign @ target.must() + " = "

    match callee
        .heroes_fn h => heroes_call.emit(
            @w,
            p,
            c,
            s,
            decls,
            f,
            callee: h.decl,
            instance: instance,
            assign: assign,
            arguments: arguments,
            site: site
        )
        .builtin_fn bt =>
            builtin_name = inventory.name_of(bt.at)

            if builtin_name == "print"
                printing.print_call(@w, f, c, run: run, arguments: arguments)
                return

            # to_<width> is not a call: it builds a T? generated for
            # this result type, which no runtime function can return.
            if builtin_name.len() > 3 && builtin_name.slice(from: 0, to: 3) == "to_" && !target.is_err()
                if !convert.kind_named(builtin_name.slice(from: 3, to: builtin_name.len())).is_err()
                    convert.width(
                        @w,
                        c,
                        names,
                        f,
                        name: builtin_name,
                        run: run,
                        arguments: arguments,
                        into: target.must()
                    )
                    return

            # validated_bytes is not a call either: like to_<width> it builds
            # a T? generated for its result type, so the call and the union are
            # written together (panel 162).
            if builtin_name == "validated_bytes" && !target.is_err()
                bytes_text.emit(@w, c, s, decls, names, f, run: run, arguments: arguments, into: target.must())
                return

            # `ptr` is not a call either, and for the same reason one boundary
            # over: it is a cast rendered at the use site, because a fixed array
            # has no C storage for a temporary to live in (panel 164).
            if builtin_name == "ptr" && !target.is_err()
                field_lend.lent(@w, c, s, decls, f, run: run, into: target.must(), site: site)
                return

            in_emitted: bool @= false

            for one in builtins.EMITTED
                if one == builtin_name
                    in_emitted @ true

            if in_emitted
                entry = builtins.entry(name: builtin_name, f: f, c: c, run: run)

                # push's second argument is a PLACE, not a value: the
                # runtime copies through the element descriptor, the
                # only way one function can append an i64 and a Point.
                written: [str] @= []
                at: i64 @= 0

                for text in arguments
                    if builtin_name == "push" && at == 1
                        written @ written.push("&" + text)
                    else
                        written @ written.push(text)
                    at @ at + 1

                # A check the runtime makes inside the call is handed the
                # site's record, through the entry point's `_at` twin (panel
                # 230's R1, kind 2).
                if builtins.placed(entry)
                    at_site = builtins.called(
                        callee: entry + "_at",
                        arguments: written.push("&" + stop_place.HERE),
                        wanted: !target.is_err()
                    )
                    writer.line(
                        @w,
                        text: "    " + stop_place.around(s, f, offset: site, statement: assign + at_site + ";")
                    )
                    return
                called_as = builtins.called(callee: entry, arguments: written, wanted: !target.is_err())
                writer.line(@w, text: "    " + assign + called_as + ";")
                return

            # Refused by the gate; the arm exists so a new callee kind
            # breaks this module.
            writer.line(@w, text: "    hero_unreachable(); /* the gate refuses this callee */")
        # A call through a function value: C's own indirect call — no
        # dereference, no cast, and clang type-checks the arguments
        # against the typedef's parameter list.

        .indirect ind =>
            writer.line(
                @w,
                text: "    " + assign + mangle.value(ind.value) + "(" + arguments.join(", ") + ");"
            )
        # UNMANGLED, BY DESIGN (CLAUDE.md §7): the name in the .hero
        # file is the C function's own name, and the #include is what
        # declares it — the call is checked against the real header.

        .extern_fn e =>
            extern_name = source.span_text(s, decls[e.decl].name)

            # The call's place, declared once at the top of a block that holds
            # everything the call writes: each check the runtime makes for it
            # hands over `&hero_here`, the cstr guards inside its arguments
            # included (panel 230's R1, kind 2; `emit/stop_place.hero`).
            writer.line(@w, text: "    { " + stop_place.declared(s, f, offset: site))

            # **The extent a lend crosses with, asserted in C before the call**
            # (panel 166's route C; defect 063). The number compared is the
            # header's own `sizeof` of the field, so it is right on a `partial`
            # record whose size Heroes does not know, and on a group `constant`,
            # which reaches here as a macro NAME rather than as a literal.
            # Written before the call rather than folded into it because a
            # `_Static_assert` is a declaration and the call is a statement.
            lend_extent.assertions(@w, c, names, s, decls, f, run: run, decl: e.decl, site: site)
            lend_local.label(@w, c, s, decls, f, run: run, decl: e.decl)

            # The bytes no C member holds, in every group record the call lends,
            # written zero in place (panel 215's R1, `emit/padding.hero`).
            padding.zero(@w, c, names, s, decls, f, run: run, site: site)

            # An array lent through `@` crosses as a buffer the runtime places
            # against a page nothing may touch (panel 196's R4,
            # `emit/lend_buffer.hero`): taken here, given back after the call.
            held = lend_buffer.buffers(c, names, s, decls, f, run: run, decl: e.decl, site: site)
            buffered = lend_buffer.before(@w, held, arguments: arguments)

            # A `cstr` lent to a pointer the check read crosses cast (defect 427).
            guarded = lend_type.cast_lends(
                names.lend_units,
                name: extern_name,
                arguments: guarded_args.guard_arguments(p, c, decls, decl: e.decl, arguments: buffered, where: "&" + stop_place.HERE)
            )

            # Where each argument was read from, for the poison a consuming
            # call leaves there (panel 177's item 1); and a Heroes function
            # handed to C goes as its thunk (item 2), through the table
            # `emit/callback_thunk.hero` writes once per unit.
            places = handle_place.places_of(c, s, decls, f, run: run, site: site)
            crossed = callback_thunk.crossings(p, c, names, decl: e.decl, arguments: guarded)

            # The result half of the const cast: sqlite3_column_blob
            # returns const void *, and without the cast the assignment
            # violates C11 6.5.16.1 at exit 2 on ladder rung 3's own
            # "read a result". A cstr receives a character pointer
            # whose sign C distinguishes — const char * covers all six
            # spellings because they are all strings.
            #
            # ONLY WHERE THERE IS AN ASSIGNMENT (panel 092). The cast is
            # what makes `t3 = f(...)` legal; with the result discarded
            # there is nothing to assign and the line becomes a cast
            # expression whose value is unused — `warning: expression
            # result unused; should this cast be to 'void'?` on the
            # AUTHOR's own `.hero` line, for a correct program, at exit
            # 0. Two shapes carried it, `(void *)memset(...)` and
            # `(const char *)getenv(...)`; an integer result emitted a
            # bare call and was exempt, which is why no golden covers it.
            # §7 says the generated C compiles without a single warning,
            # and the compiler's own warning must never be routed to the
            # author, under any option this sitting weighed.
            cast: str @= ""

            if assign.len() == 0
                cast @ "(void)"

            # `consumes` is told BEFORE the call, because a handle given back
            # twice must be caught while the second call has not run yet —
            # defect 071. `handle_traffic.hero` carries why the other end
            # cannot move with it. A call that announces an end keeps the
            # lives the ends belong to in a block of its own (defect 098).
            lives = handle_text.announces(decls, decl: e.decl)

            if lives
                writer.line(@w, text: "    {")
            handle_before.before_call(@w, c, s, decls: decls, decl: e.decl, arguments: guarded)

            declared = instances.last_of(p, decl: e.decl)

            if !declared.is_err() && assign.len() > 0
                match table.get(c.types, p.program.functions[declared.must()].result)
                    .ptr                                                       => cast @ "(void *)"
                    .cstr                                                      => cast @ "(const char *)"
                    .int_ty | .float_ty | .bool | .str | .unit                 => cast @ cast
                    .array | .fixed | .map | .fallible | .function_ty | .named => cast @ cast
                    .case_ty | .failure | .generic | .error                    => cast @ cast

            # A `when` clause reads the result (panel 177's item 6). Where the
            # program discarded it, the value is kept in a block-local the
            # clause can read, evaluated once — `__typeof__` does not evaluate
            # its operand — so the call is emitted exactly once either way.
            when = handle_result.success_c(c, s, decls, decl: e.decl)
            keeps = !when.is_err() || handle_result.reads_result(decls, decl: e.decl)
            invocation = extern_name + "(" + crossed.join(", ") + ")"
            result_name: str? @= target

            if keeps && assign.len() == 0
                writer.line(@w, text: "    {")
                writer.line(
                    @w,
                    text: "    " + nodebug.MARK + "__typeof__(" + invocation + ") hero_when = " + invocation + ";"
                )
                result_name @ ok("hero_when")
            else
                writer.line(@w, text: "    " + assign + cast + invocation + ";")

            # The counter rides the call it belongs to, on the lines after it, so
            # the two are one instruction to read and cannot drift apart. The
            # compiler PLACES these and chooses neither end: `acquires` and
            # `consumes` are both the binding author's words (panel 147 R4).
            #
            # **ONE LINE PER MARK, and it was one line per CALL until 2026-09-14**
            # — defect 034, found by panel 149's spec-warden. A declaration
            # carrying two marks got one increment, which made the CORRECT program
            # abort and the leaking one pass. `selfhost/handles.hero` carries what
            # it cost and why `spec § 13` had already settled it.
            #
            # A `while` and not a `for` over `range`, because `range` builds an
            # array and this runs once per emitted call.
            handle_traffic.after_call(
                @w,
                c,
                s,
                decls: decls,
                decl: e.decl,
                arguments: guarded,
                places: places,
                target: result_name,
                when: when
            )

            if keeps && assign.len() == 0
                writer.line(@w, text: "    }")

            if lives
                writer.line(@w, text: "    }")
            lend_buffer.after(@w, held)
            writer.line(@w, text: "    }")

## Tests

test "a Heroes call names the copy, an extern stays bare with its cstr guarded"
    text = "extern \"string.h\"\n    function strstr(haystack: cstr, needle: cstr) -> cstr\n\nfunction double_it(n: i64) -> i64\n    return n * 2\n\nfunction main()\n    print(double_it(3))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    int_id = table.int_ty_id(c.types)
    cstr_id = table.lookup(c.types, .cstr).must()
    heroes_slots: [containers.Slot] = [
        containers.Slot(name: "n", ty: int_id, kind: .param_slot(mutable: false, read_only: false))
    ]
    heroes_f = containers.Function(
        name: "double_it",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [0],
        result: int_id,
        slots: heroes_slots,
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 40, end: 41)
    )
    extern_slots: [containers.Slot] = [
        containers.Slot(name: "haystack", ty: cstr_id, kind: .param_slot(mutable: false, read_only: false))
        containers.Slot(name: "needle", ty: cstr_id, kind: .param_slot(mutable: false, read_only: false))
    ]
    extern_f = containers.Function(
        name: "strstr",
        decl: 0,
        kind: .extern_kind,
        generics: [],
        params: [0, 1],
        result: cstr_id,
        slots: extern_slots,
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    p = containers.Program(phase: .lowered, functions: [extern_f, heroes_f], strings: [])
    caller = containers.Function(
        name: "main",
        decl: 2,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [int_id],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 60, end: 61)
    )
    empty_instance: [i64] = []
    w: writer.Writer @= writer.new_writer("t")
    call(
        @w,
        instances.hold(p),
        caller,
        c,
        names,
        s,
        parsed.decls,
        callee: .heroes_fn(decl: 1),
        run: ir.Run(start: 0, length: 0),
        arguments: ["t1"],
        target: ok("t2"),
        instance: empty_instance,
        site: 0
    )
    call(
        @w,
        instances.hold(p),
        caller,
        c,
        names,
        s,
        parsed.decls,
        callee: .extern_fn(decl: 0),
        run: ir.Run(start: 0, length: 0),
        arguments: ["t3", "t4"],
        target: ok("t5"),
        instance: empty_instance,
        site: 0
    )
    got = writer.finish(w)

    # The extern call stands in a block that declares its place, the site `0`
    # of `main` in `t.hero`, the first line's first column, and each `cstr`
    # crossing is guarded with it (panel 230's R1).
    place = "    { HERO_NODEBUG __attribute__((unused)) static const HeroPlace hero_here = {\"t.hero\", \"t.main\", 1, 1};\n"
    guarded = "    t5 = (const char *)strstr(hero_cstr_nonnull_at(t3, &hero_here), hero_cstr_nonnull_at(t4, &hero_here));\n"
    assert got == "    t2 = h_t_double_it(t1);\n" + place + guarded + "    }\n"
