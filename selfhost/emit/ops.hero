# One call as C — a Heroes function, a built-in, a function value, a C
# function — and print (design.md §4.14, §4.19, §4.20; panels 006, 020,
# 029, 042, 052, 053). Port of crates/heroes/src/emit/ops.rs.
#
# inst answers WHICH operation an instruction is and where its result
# goes; this answers WHAT one operation is in C. The one rule with a
# measured reason: print is monomorphic, one runtime entry point per
# type (panel 006), which is what lets clang type-check every one.

use ast
use source
use check/table
use check/state
use ir
use ir/containers
use inventory
use emit/mangle
use emit/ctype
use emit/signature
use emit/builtins
use emit/convert
use emit/extern_probe
use emit/writer
use token
use parse
use resolve
use checker

function call(@w: writer.Writer, p: containers.Program, f: containers.Function, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], callee: ir.Callee, run: ir.Run, arguments: [str], target: str?, instance: [i64])
    assign: str @ ""

    if !target.is_err()
        assign @ target.must() + " = "

    match callee
        .heroes_fn h =>
            # THE INSTANCE, NOT THE TEMPLATE: monomorphisation deleted
            # the generic function and left one copy per type tuple, so
            # a call names the copy — read from the same table the pass
            # read. The fallback is LOUD now, and the quiet one shipped
            # a defect: "hero_unreachable" as a NAME emitted arguments
            # handed to a zero-argument _Noreturn, exit 2, the compiler
            # blaming itself (panel 084's class).
            found: str? @ fail("none", "no instance")

            for candidate in p.functions
                if candidate.decl == h.decl && candidate.instance == instance
                    found @ ok(signature.instance_name(candidate, c, s, decls))

            if found.is_err()
                writer.line(@w, text: "    hero_unreachable(); /* no instance for this call — compiler bug */")
            else
                writer.line(@w, text: "    " + assign + found.must() + "(" + arguments.join(", ") + ");")
        .builtin_fn bt =>
            builtin_name = inventory.table()[bt.at].name

            if builtin_name == "print"
                print_call(@w, f, c, run: run, arguments: arguments)
                return

            # to_<width> is not a call: it builds a T? generated for
            # this result type, which no runtime function can return.
            if builtin_name.len() > 3 && builtin_name.slice(from: 0, to: 3) == "to_" && !target.is_err()
                if !convert.kind_named(builtin_name.slice(from: 3, to: builtin_name.len())).is_err()
                    convert.width(
                        @w,
                        c,
                        names,
                        f,
                        name: builtin_name,
                        run: run,
                        arguments: arguments,
                        into: target.must()
                    )
                    return
            in_emitted: bool @ false

            for one in builtins.EMITTED
                if one == builtin_name
                    in_emitted @ true

            if in_emitted
                entry = builtins.entry(name: builtin_name, f: f, c: c, run: run)

                # push's second argument is a PLACE, not a value: the
                # runtime copies through the element descriptor, the
                # only way one function can append an i64 and a Point.
                written: [str] @ []
                at: i64 @ 0

                for text in arguments
                    if builtin_name == "push" && at == 1
                        written @ written.push("&" + text)
                    else
                        written @ written.push(text)
                    at @ at + 1

                writer.line(@w, text: "    " + assign + entry + "(" + written.join(", ") + ");")
                return

            # Refused by the gate; the arm exists so a new callee kind
            # breaks this module.
            writer.line(@w, text: "    hero_unreachable(); /* the gate refuses this callee */")
        # A call through a function value: C's own indirect call — no
        # dereference, no cast, and clang type-checks the arguments
        # against the typedef's parameter list.

        .indirect ind =>
            writer.line(
                @w,
                text: "    " + assign + mangle.value(ind.value) + "(" + arguments.join(", ") + ");"
            )
        # UNMANGLED, BY DESIGN (CLAUDE.md §7): the name in the .hero
        # file is the C function's own name, and the #include is what
        # declares it — the call is checked against the real header.

        .extern_fn e =>
            extern_name = source.span_text(s, decls[e.decl].name)
            guarded = guard_arguments(p, c, decl: e.decl, arguments: arguments)

            # The result half of the const cast: sqlite3_column_blob
            # returns const void *, and without the cast the assignment
            # violates C11 6.5.16.1 at exit 2 on ladder rung 3's own
            # "read a result". A cstr receives a character pointer
            # whose sign C distinguishes — const char * covers all six
            # spellings because they are all strings.
            #
            # ONLY WHERE THERE IS AN ASSIGNMENT (panel 092). The cast is
            # what makes `t3 = f(...)` legal; with the result discarded
            # there is nothing to assign and the line becomes a cast
            # expression whose value is unused — `warning: expression
            # result unused; should this cast be to 'void'?` on the
            # AUTHOR's own `.hero` line, for a correct program, at exit
            # 0. Two shapes carried it, `(void *)memset(...)` and
            # `(const char *)getenv(...)`; an integer result emitted a
            # bare call and was exempt, which is why no golden covers it.
            # §7 says the generated C compiles without a single warning,
            # and the compiler's own warning must never be routed to the
            # author, under any option this sitting weighed.
            cast: str @ ""

            if assign.len() == 0
                cast @ "(void)"

            for candidate in p.functions
                if candidate.decl == e.decl && assign.len() > 0
                    match table.get(c.types, candidate.result)
                        .ptr                                                       => cast @ "(void *)"
                        .cstr                                                      => cast @ "(const char *)"
                        .int_ty | .float_ty | .bool | .str | .unit                 => cast @ cast
                        .array | .fixed | .map | .fallible | .function_ty | .named => cast @ cast
                        .case_ty | .failure | .generic | .error                    => cast @ cast

            writer.line(@w, text: "    " + assign + cast + extern_name + "(" + guarded.join(", ") + ");")

# print is a compiler form, not a function value (panel 006): one
# monomorphic printer per type, composed by the emitter. The contract
# is NO SEPARATOR, EXACTLY ONE TRAILING NEWLINE — Pascal's WriteLn.
# hero_print_end owns the newline: the emitter owning it needs putchar,
# which needs stdio.h in every generated unit — a header-collision
# surface on every FFI program.
function print_call(@w: writer.Writer, f: containers.Function, c: state.Checked, run: ir.Run, arguments: [str])
    at: i64 @ 0

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v =>
                printer: str @ ""

                match table.get(c.types, containers.value_type(f, v.value))
                    .bool => printer @ "hero_print_bool"
                    .str  => printer @ "hero_print_str"
                    .float_ty fk =>
                        match fk.kind
                            .f32 => printer @ "hero_print_f32"
                            .f64 => printer @ "hero_print_f64"
                    # u64 is the one width that needs its own printer:
                    # 2^64-1 read as signed is -1, which is precisely
                    # what print(SIZE_MAX) produced when panel 042
                    # measured it. The other seven widen losslessly.

                    .int_ty ik =>
                        match ik.kind
                            .u64                                         => printer @ "hero_print_uint"
                            .i8 | .i16 | .i32 | .i64 | .u8 | .u16 | .u32 => printer @ "hero_print_int"
                    # The loud direction: this was a catch-all to
                    # hero_print_int, covering nothing but a future
                    # mistake — the checker accepts exactly these.

                    .ptr | .cstr | .unit | .array | .fixed | .map => printer @ printer
                    .fallible | .function_ty | .named | .case_ty  => printer @ printer
                    .failure | .generic | .error                  => printer @ printer

                if printer == ""
                    writer.line(
                        @w,
                        text: "    hero_unreachable(); /* print accepts an integer, a float, bool or str */"
                    )
                else
                    writer.line(@w, text: "    " + printer + "(" + arguments[at] + ");")
            # print(@x) cannot be written: §4.8's marker is for declared
            # parameters, and print declares none.

            .inout_arg => writer.line(@w, text: "    hero_unreachable(); /* print declares no @ parameter */")

        at @ at + 1

    writer.line(@w, text: "    hero_print_end();")

# Every cstr argument of an extern call, wrapped in the runtime's null
# check (panel 053; §12's robustness rule) — and every opaque or numeric
# `@` argument cast to `(void *)` (panel 103; the reason and the two
# exclusions are `extern_probe.is_cast_out`'s, and the probe and the call
# spell the argument the same way or one of them is the thing clang
# refuses). Not a language change and
# not a type rule: hero_cstr_nonnull is to a null cstr what
# __builtin_mul_overflow is to signed overflow — one branch, a named
# abort, C's UB never reached. The hole was measured: a null cstr
# handed STRAIGHT to C (strstr on getenv(UNSET)) reached libsystem
# unexamined — SEGV at 0x0. The narrowing is the callee's DECLARED
# PARAMETER TYPE, a fact about this declaration; the cost is that a
# cstr from s.cstr(), which cannot be null, is checked too — one
# predictable branch, and safety outranks speed (§12). An @cstr is
# excluded: §4.8 makes it a pointer parameter, so the argument is the
# address of a local, never null — a guard that cannot fail is read as
# protection that is there (author decision 2026-08-15).
function guard_arguments(p: containers.Program, c: state.Checked, decl: i64, arguments: [str]) -> [str]
    callee: containers.Function? @ fail("none", "not lowered")

    for candidate in p.functions
        if candidate.decl == decl
            callee @ ok(candidate)

    if callee.is_err()
        return arguments
    out: [str] @ []
    index: i64 @ 0

    for argument in arguments
        is_cstr: bool @ false
        is_out: bool @ false
        cast: bool @ false

        if index < callee.must().params.len()
            slot = callee.must().slots[callee.must().params[index]]
            cast @ extern_probe.is_cast_out(c, slot)

            match table.get(c.types, slot.ty)
                .cstr                                                      => is_cstr @ true
                .int_ty | .float_ty | .bool | .str | .ptr | .unit          => is_cstr @ is_cstr
                .array | .fixed | .map | .fallible | .function_ty | .named => is_cstr @ is_cstr
                .case_ty | .failure | .generic | .error                    => is_cstr @ is_cstr

            match slot.kind
                .param_slot ps =>
                    if ps.mutable
                        is_out @ true
                .local_slot | .synthetic_slot => is_out @ is_out

        if is_cstr && !is_out
            out @ out.push("hero_cstr_nonnull(" + argument + ")")
        else if cast
            out @ out.push("(void *)" + argument)
        else
            out @ out.push(argument)
        index @ index + 1

    return out

## Tests

test "print composes monomorphic printers, and u64 gets its own"
    text = "function main()\n    big: u64 = 18446744073709551615\n    print(big)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    u64_id = table.lookup(c.types, .int_ty(kind: .u64)).must()
    str_id = table.str_ty(c.types)
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [u64_id, str_id],
        arguments: [.value_arg(value: 0), .value_arg(value: 1)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    w: writer.Writer @ writer.new_writer("t")
    print_call(@w, f, c, run: ir.Run(start: 0, length: 2), arguments: ["t0", "t1"])
    got = writer.finish(w)
    assert got == "    hero_print_uint(t0);\n    hero_print_str(t1);\n    hero_print_end();\n"

test "a Heroes call names the copy, an extern stays bare with its cstr guarded"
    text = "extern \"string.h\"\n    function strstr(haystack: cstr, needle: cstr) -> cstr\n\nfunction double_it(n: i64) -> i64\n    return n * 2\n\nfunction main()\n    print(double_it(3))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    int_id = table.int_ty_id(c.types)
    cstr_id = table.lookup(c.types, .cstr).must()
    heroes_slots: [containers.Slot] = [containers.Slot(name: "n", ty: int_id, kind: .param_slot(mutable: false))]
    heroes_f = containers.Function(
        name: "double_it",
        decl: 1,
        kind: .function_kind,
        generics: [],
        params: [0],
        result: int_id,
        slots: heroes_slots,
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 40, end: 41)
    )
    extern_slots: [containers.Slot] = [
        containers.Slot(name: "haystack", ty: cstr_id, kind: .param_slot(mutable: false))
        containers.Slot(name: "needle", ty: cstr_id, kind: .param_slot(mutable: false))
    ]
    extern_f = containers.Function(
        name: "strstr",
        decl: 0,
        kind: .extern_kind,
        generics: [],
        params: [0, 1],
        result: cstr_id,
        slots: extern_slots,
        blocks: [],
        values: [],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    p = containers.Program(phase: .lowered, functions: [extern_f, heroes_f], strings: [])
    caller = containers.Function(
        name: "main",
        decl: 2,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [int_id],
        arguments: [],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 60, end: 61)
    )
    empty_instance: [i64] = []
    w: writer.Writer @ writer.new_writer("t")
    call(
        @w,
        p,
        caller,
        c,
        names,
        s,
        parsed.decls,
        callee: .heroes_fn(decl: 1),
        run: ir.Run(start: 0, length: 0),
        arguments: ["t1"],
        target: ok("t2"),
        instance: empty_instance
    )
    call(
        @w,
        p,
        caller,
        c,
        names,
        s,
        parsed.decls,
        callee: .extern_fn(decl: 0),
        run: ir.Run(start: 0, length: 0),
        arguments: ["t3", "t4"],
        target: ok("t5"),
        instance: empty_instance
    )
    got = writer.finish(w)
    assert got == "    t2 = h_t_double_it(t1);\n    t5 = (const char *)strstr(hero_cstr_nonnull(t3), hero_cstr_nonnull(t4));\n"
