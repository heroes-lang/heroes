# The output, which has to count its own lines (design.md §3.1, panel
# 020). Port of heroes/src/emit/writer.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# `#line N` anchors the NEXT line, and C then auto-increments. That one
# sentence is why this is a record and not a str: "emit #line on
# source-line change" cannot be implemented by comparing spans, because
# a Heroes line that lowers to K lines of C drifts by K-1, silently.
# The comparison has to be against WHAT CLANG CURRENTLY BELIEVES — the
# effective line — which this writer tracks.
#
# And tracking the belief is half the job. The other half went missing
# for the backend's whole life, repaired 2026-08-16: the belief was
# honoured only at an at_file call, so an emitter that writes K lines
# under one request positioned once, and lines 2..K walked forward a
# source line each — measured as 550 C lines across 81 of 81 golden
# programs landing on a blank line, the next declaration, or past the
# end of the file. The repair is INTENT beside CLAIM: what was asked
# for, as against what clang believes, with line() restoring the first
# whenever the second has aged out from under it. Cost: +1.03%
# generated lines, no content line changed.
#
# The asymmetry that makes this cheap: auto-increment is CORRECT while
# the claim names the generated file (that file really does advance one
# line per output line) and WRONG while it names a source file (K lines
# of C belong to one Heroes line) — so a restore is emitted only
# against a .hero claim.
#
# **And a restore that would re-anchor the very line the last C line sits
# on is not written** (panel 219's R1, ratified 2026-10-17): the C line is
# written on that line instead (`emit/line_join.hero`), and a `#line` names
# its file only where the file clang presumes changes
# (`emit/line_name.hero`). The compiler's own C fell from 52,044,067 bytes
# to 25,897,631, its line table the same at every address (measured
# 2026-10-17; design.md §3.1 carries the numbers).
#
# The generated name is derived from the SOURCE stem, never from -o:
# the emitted C must not mention the output path, or the double-emit
# determinism diff would be a property of the invocation instead of
# the emitter.
#
# The accumulation is chunked (design.md §4.10's remedy, panel 088 R5).
# This module's first shape was `out @ out + text`, which copies the
# whole buffer once per emitted line (spec § 10 Strings, arrays, maps) — quadratic in output
# lines, and the compiler emits 764k of them for itself. A flat [str]
# joined once would only move the cost: `push` copies every element
# too (design.md §4.10, measured). So: lines land in `chunk`, every
# CHUNK_LINES of them are joined into one str pushed onto `chunks`,
# and finish joins once. Before/after: docs/measurements/012.
#
# That `push` copies every element is true through a field, and both
# arrays were grown through `w`'s: each line copied its chunk and each
# flush every chunk before it. Since defect 409 both are lent to
# `add_line`, which grows them in place (design.md Part 8 wart 8's
# spelling), so a line costs its own push and no other.

use source
use emit/line_join
use emit/line_name
use emit/probe_cut

# What clang believes the next output line is: which file, and which
# line in it. `none` — nothing claimed yet, the file is its own truth.
variant Claim
    no_claim
    at
        file: str
        line: i64

# What `at_file` or `at_generated` asked for that `line` has not written.
variant Pending
    none_pending
    source_line
        file: str
        line: i64
    generated_line

# One flush every this many lines. Chosen when both arrays were pushed
# through the field: the inner then cost n*K/2 element copies over n lines,
# the outer (n/K)^2/2, balanced at K = cuberoot(2n), 115 for the compiler's
# own 764k lines. Grown in place (defect 409), neither copies, and K says
# only how many lines' strs are alive before they are joined into one.
constant CHUNK_LINES: i64
    128

record Writer
    # The output. Neither a flat str (`+` copies both sides) nor a flat
    # [str] pushed through this field (`push` copies every element)
    # survives 764k lines; both are measured quadratic (design.md §4.10,
    # docs/measurements/012). `add_line` grows both arrays in place.
    chunk: [str]
    chunks: [str]
    # Lines pushed so far. The next line's number in the generated file
    # is pushed + 1.
    pushed: i64
    claim: Claim
    # What the emitter last ASKED for, as opposed to what clang
    # currently believes. The two are the same only until a second line
    # is written under one request; keeping just the belief is what let
    # every multi-line lowering walk off the end of the author's file.
    intent: Claim
    # A request no line has been written under yet (defect 263): written
    # by `line` when a line follows, and never if none does, so no `#line`
    # stands with no statement after it. `generated` asks for the
    # generated file's next line, which is known only when it is written.
    pending: Pending
    generated: str
    # What a `#line` says, each file's name spelled once (`emit/line_name`).
    names: line_name.Names
    # Whether this unit defines `HERO_COPY` and copies its own structs as
    # bytes (`emit/byte_copy.hero`, defect 522): set where the types are
    # written, before any body, and only past `typeorder`'s depth.
    copies_bytes: bool
    # The line written last, held out of the chunk until the next one says
    # whether it joins (`emit/line_join`).
    held: line_join.Held
    # Whether this is the value probe's copy of a unit, which marks what no
    # constant's accessor needs (`emit/probe_cut.hero`, panel 225): false
    # for every unit a build compiles, so their C carries no mark.
    cuts: bool

function new_writer(module: str) -> Writer
    generated = module + ".c"

    return Writer(
        chunk: [],
        chunks: [],
        pushed: 0,
        claim: .no_claim,
        intent: .no_claim,
        pending: .none_pending,
        generated: generated,
        names: line_name.new_names(generated),
        copies_bytes: false,
        held: line_join.nothing_held(),
        cuts: false
    )

# A stretch of the probe's copy no asked accessor needs, opened and closed
# (`emit/probe_cut.hero`): a line each, unkeyed until the copy is keyed,
# written only where the writer marks.
function cut_open(@w: Writer)
    if w.cuts
        line(@w, text: probe_cut.cut_mark(probe_cut.UNKEYED))

function cut_close(@w: Writer)
    if w.cuts
        line(@w, text: probe_cut.keep_mark(probe_cut.UNKEYED))

# One line of C. Everything goes through here, which is what keeps the
# count honest. A claim on the generated file stays true for free under
# auto-increment; a claim on a .hero file has to be re-asserted rather
# than allowed to drift.
function line(@w: Writer, text: str)
    flush(@w)
    needs_restore: bool @= false
    restore_file: str @= ""
    restore_line: i64 @= 1

    match w.intent
        .at intended =>
            if intended.file != w.generated && w.claim != w.intent
                needs_restore @ true
                restore_file @ intended.file
                restore_line @ intended.line
        .no_claim => needs_restore @ needs_restore

    if needs_restore
        if line_join.joins(w.held, text: text) && sits_on(w, file: restore_file, at: restore_line)
            line_join.write_beside(@w.held, text: text)
            return
        restore(@w, file: restore_file, at: restore_line)
    push_line(@w, text: text)

    # A directive inside the text moves the file clang presumes, after the
    # writer's own: the next one is named. A plain text holds none.
    if !w.held.plain
        line_name.forget(@w.names, text: text)

# Whether clang believes the held line is line `at` of `file`: then a C line
# whose restore would re-anchor that line is written on it instead.
function sits_on(w: Writer, file: str, at: i64) -> bool
    match w.claim
        .at believed => return w.held.held && believed.file == file && believed.line == at + 1
        .no_claim    => return false

    return false

# The unconditional half of line, and the one directive uses: writing
# the #line itself must not ask whether a #line is needed. (push is a
# builtin, hence the longer name.)
function push_line(@w: Writer, text: str)
    if w.held.held
        add_line(@w.chunk, text: w.held.text + "\n")

        if len(w.chunk) == CHUNK_LINES
            add_line(@w.chunks, text: join(w.chunk, ""))
            w.chunk @ []
    line_join.hold(@w.held, text: text)
    w.pushed @ w.pushed + 1

    match w.claim
        .at believed => w.claim @ .at(file: believed.file, line: believed.line + 1)
        .no_claim    => return

# Lent, so the push grows the array in place (defect 409): through the
# field, `w.chunk @ w.chunk.push(…)` copied the chunk at every line.
function add_line(@lines: [str], text: str)
    lines @ lines.push(text)

# Re-state a claim the auto-increment has aged out from under. Same
# bytes as directive, without touching intent — the intent is what is
# being honoured.
function restore(@w: Writer, file: str, at: i64)
    w.claim @ .no_claim
    push_line(@w, text: line_name.directive(@w.names, file: file, at: at))
    w.claim @ .at(file: file, line: at)

function blank(@w: Writer)
    line(@w, text: "")

# Point the next line at a file of the compilation, at that file's own
# line. One entry point, and it replaced two: at_source/at_library
# split wrongly with N modules — a #line for geom.hero claiming
# main.hero at a line past its end is the compiler blaming the author
# for a file they did not write in. The test is the INTENT, not the
# claim: an aged-out claim is restored by line() at the moment a line
# is actually written, so asking again for what is already intended
# emits nothing here, and nothing at all if no line follows.
function at_file(@w: Writer, file: str, at: i64)
    wanted: i64 @= at

    if wanted < 1
        wanted @ 1
    already: bool @= false

    match w.intent
        .at intended =>
            if intended.file == file && intended.line == wanted
                already @ true
        .no_claim => already @ already

    if already
        return
    w.pending @ .source_line(file: file, line: wanted)
    w.intent @ .at(file: file, line: wanted)

# Point the next line at the generated file — around a prologue, a
# copy-out, the shim: code no user line is responsible for.
function at_generated(@w: Writer)
    settled: bool @= false

    match w.pending
        .generated_line => settled @ true
        .source_line    => settled @ false
        .none_pending =>
            match w.claim
                .at believed =>
                    if believed.file == w.generated
                        settled @ true
                .no_claim => settled @ settled

    if settled
        return
    w.pending @ .generated_line
    w.intent @ .at(file: w.generated, line: 0)

# Write the pending request, now that a line follows it. A request the
# claim already holds needs no directive, the generated file's being held
# whenever the claim names it, since that file does advance a line per
# line; its directive occupies one line first, so the next content line is
# pushed + 2.
function flush(@w: Writer)
    match w.pending
        .none_pending => return
        .source_line asked =>
            w.pending @ .none_pending
            holds: bool @= false

            match w.claim
                .at believed =>
                    if believed.file == asked.file && believed.line == asked.line
                        holds @ true
                .no_claim => holds @ holds

            if holds
                w.intent @ w.claim
                return

            # The line the held line already sits on: `line` joins it there
            # or restores it, which writes what `directive` would.
            if asked.file != w.generated && sits_on(w, file: asked.file, at: asked.line)
                w.intent @ .at(file: asked.file, line: asked.line)
                return
            directive(@w, file: asked.file, at: asked.line)
        .generated_line =>
            w.pending @ .none_pending
            settled: bool @= false

            match w.claim
                .at believed =>
                    if believed.file == w.generated
                        settled @ true
                .no_claim => settled @ settled

            if settled
                w.intent @ w.claim
                return
            next = w.pushed + 2
            generated = w.generated
            directive(@w, file: generated, at: next)

function directive(@w: Writer, file: str, at: i64)
    # Cleared first, so the push does not increment a claim this
    # directive is about to replace. push, not line: writing a #line
    # must not ask whether one is needed.
    w.claim @ .no_claim
    push_line(@w, text: line_name.directive(@w.names, file: file, at: at))
    w.claim @ .at(file: file, line: at)
    w.intent @ w.claim

# One pass over the bytes: the ragged last chunk is joined and pushed
# onto a copy of `chunks` (finish takes w by value, so w is untouched
# and finishing twice gives the same str), then everything joins once.
function finish(w: Writer) -> str
    return join(w.chunks.push(join(w.chunk, "") + line_join.tail(w.held)), "")

# Point the next line at whichever source a span actually came from.
# Every caller that has a span and a Source goes through here rather
# than choosing for itself, so "is this the author's code or the
# library's" is answered in one place. The file and line only: a `#line`
# carries no column, and asking `locate` for one walked the line up to the
# offset for every instruction, the square of a long line (defect 228).
function at_span(@w: Writer, s: source.Source, offset: i64)
    found = source.source_line(s, offset)
    at_file(@w, file: found.file, at: found.line)

## Tests

test "a second line under a source claim is written on the first's line, which needs no restore (panel 219)"
    w: Writer @= new_writer("m")
    at_file(@w, file: "a.hero", at: 3)
    line(@w, text: "x;")
    line(@w, text: "y;")
    assert finish(w) == "#line 3 \"a.hero\"\nx; y;\n"

    # A line that may not stand beside another gets its restore, which names
    # no file, clang presuming the one it names (C11 6.10.4).
    alone: Writer @= new_writer("m")
    at_file(@alone, file: "a.hero", at: 3)
    line(@alone, text: "x; // a")
    line(@alone, text: "y;")
    line(@alone, text: "#if A")
    line(@alone, text: "z;")
    assert finish(alone) == "#line 3 \"a.hero\"\nx; // a\n#line 3\ny;\n#line 3\n#if A\n#line 3\nz;\n"

# Panel 219's R1 at a request: one for the line the held line sits on joins
# it, one for the next line rides C's count, and one for another line of
# the same file names no file.
test "a request for the held line's own line joins it, and the next line rides C's count (panel 219)"
    w: Writer @= new_writer("m")
    at_file(@w, file: "a.hero", at: 3)
    line(@w, text: "x;")
    at_generated(@w)
    at_file(@w, file: "a.hero", at: 3)
    line(@w, text: "y;")
    at_file(@w, file: "a.hero", at: 4)
    line(@w, text: "z;")
    at_file(@w, file: "a.hero", at: 9)
    line(@w, text: "q;")
    assert finish(w) == "#line 3 \"a.hero\"\nx; y;\nz;\n#line 9\nq;\n"

test "a claim on the generated file rides auto-increment for free"
    w: Writer @= new_writer("m")
    at_generated(@w)
    line(@w, text: "int a;")
    line(@w, text: "int b;")

    # One directive, no restores: m.c really does advance a line per line.
    assert finish(w) == "#line 2 \"m.c\"\nint a;\nint b;\n"

test "asking for what is already intended emits nothing"
    w: Writer @= new_writer("m")
    at_file(@w, file: "a.hero", at: 5)
    at_file(@w, file: "a.hero", at: 5)
    line(@w, text: "z;")
    assert finish(w) == "#line 5 \"a.hero\"\nz;\n"

    # A different line IS a new directive, and the one it replaces, which no
    # line followed, is never written (defect 263).
    again: Writer @= new_writer("m")
    at_file(@again, file: "a.hero", at: 5)
    at_file(@again, file: "a.hero", at: 6)
    line(@again, text: "z;")
    assert finish(again) == "#line 6 \"a.hero\"\nz;\n"

test "a file's #line spelling is kept across a restore, the generated file and a turn to another file (defect 262)"
    w: Writer @= new_writer("m")
    at_file(@w, file: "dé/a\"b.hero", at: 3)
    line(@w, text: "x; // a")
    line(@w, text: "y;")
    at_generated(@w)
    line(@w, text: "z;")
    at_file(@w, file: "dé/a\"b.hero", at: 4)
    line(@w, text: "u;")
    at_file(@w, file: "t??).hero", at: 1)
    line(@w, text: "v;")
    at_file(@w, file: "dé/a\"b.hero", at: 5)
    line(@w, text: "w;")

    # The second `#line 3` is the restore, which a `//` on the line before
    # owes and which names no file (panel 219); `m.c` names the line after
    # its own; the name spelled first is spelled again after another file's.
    assert finish(w) == "#line 3 \"dé/a\\\"b.hero\"\nx; // a\n#line 3\ny;\n#line 6 \"m.c\"\nz;\n#line 4 \"dé/a\\\"b.hero\"\nu;\n#line 1 \"t?\\?).hero\"\nv;\n#line 5 \"dé/a\\\"b.hero\"\nw;\n"

test "the chunk flush loses no line and adds none"
    w: Writer @= new_writer("m")
    n: i64 @= 0

    while n < CHUNK_LINES + 3
        line(@w, text: "x;")
        blank(@w)
        n @ n + 1

    # Crosses the flush boundary twice and ends on a ragged chunk; the
    # blank lines would expose a separator smuggled in by a join.
    assert finish(w) == repeat("x;\n\n", (CHUNK_LINES + 3).to_u64().must())

test "a writer that ends exactly on a chunk boundary adds nothing"
    w: Writer @= new_writer("m")
    n: i64 @= 0

    while n < CHUNK_LINES
        line(@w, text: "y;")
        n @ n + 1

    assert finish(w) == repeat("y;\n", CHUNK_LINES.to_u64().must())

test "defect 409: forty chunks and a ragged one keep every line once, in order"
    # Both arrays are lent to `add_line` now; a line out of place, lost or
    # written twice across forty flushes would show in the numbers.
    w: Writer @= new_writer("m")
    want: [str] @= []
    n: i64 @= 0

    while n < CHUNK_LINES * 40 + 5
        line(@w, text: n.to_str())
        want @ want.push(n.to_str() + "\n")
        n @ n + 1

    assert w.chunks.len() == 40
    assert finish(w) == want.join("")

test "a request no line follows writes no #line (defect 263)"
    # A retain or a release after a release asked for its instruction's
    # source line and then for the generated file's: two directives, the
    # first followed by nothing but the second.
    w: Writer @= new_writer("m")
    at_file(@w, file: "a.hero", at: 4)
    line(@w, text: "x;")
    at_file(@w, file: "a.hero", at: 9)
    at_generated(@w)
    line(@w, text: "hero_str_decref(h1);")
    at_file(@w, file: "a.hero", at: 9)
    at_generated(@w)
    line(@w, text: "hero_str_decref(h2);")
    assert finish(w) == "#line 4 \"a.hero\"\nx;\n#line 4 \"m.c\"\nhero_str_decref(h1);\nhero_str_decref(h2);\n"

    # And a request the output ends on is never written at all.
    tail: Writer @= new_writer("m")
    line(@tail, text: "a;")
    at_file(@tail, file: "a.hero", at: 2)
    at_generated(@tail)
    assert finish(tail) == "a;\n"

    # A source line the claim already holds is not stated twice.
    held: Writer @= new_writer("m")
    at_file(@held, file: "a.hero", at: 7)
    line(@held, text: "p;")
    at_generated(@held)
    at_file(@held, file: "a.hero", at: 8)
    line(@held, text: "q;")
    assert finish(held) == "#line 7 \"a.hero\"\np;\nq;\n"
