# The classes where THE HEADER CONTRADICTS THE DECLARATION (design.md
# §4.19; panels 036, 038, 042, 048). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_declared.rs.
#
# Three readers, one seam: whose statement the verdict is about. Two
# read a _Static_assert this emitter wrote — a result type the header
# refutes, a constant that is not one — so the message text is a
# contract with emit_extern_assert rather than a guess about clang's
# wording. The exception is unknown_name, which matches clang's own
# "call to undeclared function": what makes it safe is not whose text
# it reads but declaration() — the gate in ffi_lookup.

use ast
use source
use diag
use emit/assert_spelling
use emit/ffi_lookup
use emit/ffi_asked
use emit/ffi_result
use emit/ffi_held
use emit/ffi_switched
use parse
use resolve
use checker

# _Static_assert(HERO_RET_INT(sqrt(…)), "heroes-ffi-return sqrt int")
# failed: the header disagrees with the declared type. Two codes from
# one assertion, because the same _Generic asks the same question of a
# call and of a constant, and the reader's mistake is not the same: a
# function RETURNS the wrong type, a constant IS one. Where the refused
# round's question named the header's type (`results`, defect 186), the
# message names it and offers its word (`emit/ffi_result.hero`); the
# sentences below are for a round that could not ask.
function wrong_type(s: source.Source, decls: [ast.Decl], tree: ast.Ast, line: str, results: {str: ffi_asked.Typed}, word_bits: i64) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: assert_spelling.ASSERTION)

    if rest.is_err()
        return fail(code: "none", msg: "not a return assertion")

    # `<name> <type>` — written by the emitter, so the split is on its
    # own format rather than on a guess about clang's.
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() < 2
        return fail(code: "none", msg: "the marker's tail is not ours")
    name = parts[0]
    declared = parts[1]
    found = ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this name")
    given = results[name]

    if !given.is_err()
        return ok(
            ffi_result.told(s, decls, tree, name: name, declared: declared, found: found.must(), typed: given.must(), word_bits: word_bits)
        )

    if found.must().is_constant
        d: diag.Diagnostic @= diag.new_diagnostic(
            code: "ffi_constant_type",
            message: "`" + name + "` is not `" + declared + "` in `" + found.must().header + "` — clang read the header and the types disagree",
            span: found.must().span
        )
        d.notes @ d.notes.push(
            "an `extern constant` takes its value from the header (§4.19), so its type is the header's too: correct the declared type, or name the header that spells `" + name + "` as `" + declared + "`"
        )
        return ok(d)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_return_type",
        message: "`" + name + "` does not return `" + declared + "` — that is what `" + found.must().header + "` says, and clang read it",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "an `extern` is checked against the real header (§4.19): correct the result type, or name the header that declares this `" + name + "`"
    )
    return ok(d)

# _Static_assert(__builtin_constant_p(stdout), "heroes-ffi-const
# stdout") failed: the header has the name, and it is an OBJECT rather
# than a value. The one refusal no other language makes as a rule
# (panel 038's historian) — §4.2's reason: a zero-argument accessor
# over errno returns a different value on two calls, a mutable global
# through the back door.
function not_constant(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
        return fail(code: "none", msg: "not an assertion failure")
    rest = ffi_lookup.after(text: line, marker: assert_spelling.CONSTANCY)

    if rest.is_err()
        return fail(code: "none", msg: "not a constancy assertion")
    parts = ffi_lookup.words(text: rest.must())

    if parts.len() == 0
        return fail(code: "none", msg: "the marker's tail is empty")
    name = trim_trailing(parts[0])
    found = ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this name")
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_not_constant",
        message: "`" + found.must().header + "` has `" + name + "`, but not as a constant — clang cannot read its value while compiling",
        span: found.must().span
    )

    # The note's last sentence said *reached through an `extern function` that
    # returns it* until defect 152 (2026-10-02), which reads as `function
    # errno() -> i32`, the declaration that defect is about: what returns it is
    # a C function of the program's own, and the header's type is not one this
    # assertion learns, so the author writes it.
    d.notes @ d.notes.push(
        "a `constant` names one value forever (§4.4), and `" + name + "` is an object or a macro that expands to one — reading it twice could give two answers, which is the mutable global §4.2 forbids. A C object is reached through a function of the program's own that returns it, written in a header beside this file and bound by `extern` naming that header like any function: `static inline <its C type> hero_" + name + "(void) { return " + name + "; }`"
    )
    return ok(d)

# The note an absent name is told with, its name after it, which
# `cli/header_order.hero` replaces where the header declares the name read
# alone and not after another group's (panel 204's R3).
constant UNKNOWN: str
    "an `extern` names what the header already has (§4.19): check the spelling, or name the header that does declare `"

# The header has no such name at all. A different mistake from the one
# above and it was being reported as that one — "`sqlite3_openn` does
# not return `i64`", whose remedy cannot fix a name that does not
# exist (§4.17). Two spellings, because C has two: a name used as a
# call is an undeclared FUNCTION, a name used as a value is an
# undeclared IDENTIFIER — which is what a misspelled constant produces.
#
# **A name the header defines as a MACRO is not an absent one** (panel 185 R1,
# defect 143, 2026-10-02): the probe's parenthesised call reaches no macro, so
# clang calls `WEXITSTATUS` undeclared, and *`sys/wait.h` declares no
# `WEXITSTATUS`* was false. `macros` is what the refused round's question unit
# answered (`emit/ffi_asked.hero`), and a name in it is told as a macro.
#
# **A tag the header holds is not an absent one either** (defect 400,
# 2026-10-06): a handle's word spelled only inside an expression, the union
# question's `*(opaque * *)0`, draws *use of undeclared identifier* where the
# header declares `struct opaque`, and *`fwd.h` declares no `opaque`* was told.
# `types` is the header's answer to the record's own question, `typedef opaque
# hero_q;`, and where it says the word is a tag of any kind or a type
# (`emit/ffi_held.hero`), this reader says nothing.
function unknown_name(s: source.Source, tree: ast.Ast, decls: [ast.Decl], line: str, stderr: str, macros: {str: bool}, types: {str: str}, switched: {str: ffi_switched.Switch}) -> diag.Diagnostic?
    quoted: str @= ""
    caught: bool @= false
    call_form = ffi_lookup.after(text: line, marker: "call to undeclared function '")

    if !call_form.is_err()
        quoted @ call_form.must()
        caught @ true

    # A THIRD MARKER, because clang has three words for one mistake and we
    # knew two (found 2026-08-25, by a test that declared `strstr` under
    # `stdlib.h` by accident). For a function clang recognises as a C library
    # name it says `call to undeclared LIBRARY function 'strstr' with type
    # ...` — a different string, so the two markers above missed it and the
    # whole compile came back `internal error ... exit 2`. That is §7's line
    # exactly inverted: a failure the author's own `extern` caused, blamed on
    # the compiler. Measured before and after: a name NO header declares was
    # already `ffi_unknown_name` at exit 1; a REAL name under the WRONG header
    # was exit 2. Same author mistake, two verdicts, and the difference was
    # one word in clang's output.
    if !caught
        library_form = ffi_lookup.after(text: line, marker: "call to undeclared library function '")

        if !library_form.is_err()
            quoted @ library_form.must()
            caught @ true

    if !caught
        value_form = ffi_lookup.after(text: line, marker: "use of undeclared identifier '")

        if !value_form.is_err()
            quoted @ value_form.must()
            caught @ true

    if !caught
        return fail(code: "none", msg: "not an undeclared-name line")
    name = ffi_lookup.up_to_quote(quoted)

    # A tag-only struct is not an ABSENT one, and clang says both
    # things about it (panel 074): "must use 'struct' tag" AND "use of
    # undeclared identifier", at two different spans — so the
    # one-per-span rule does not choose, and this message would tell
    # the author the header declares no such type, which is false: it
    # declares it in C's other namespace. The narrowing is a fact
    # about the text in hand: if the tag line is present for THIS
    # name, ffi_missing_tag owns it.
    if ffi_lookup.has(text: stderr, needle: "must use 'struct' tag to refer to type '" + name + "'")
        return fail(code: "none", msg: "the tag class owns this name")

    # The same for a union's or an enum's tag (`ffi_tag.tag_of_another_kind`),
    # which this told *declares no `utag`* until 2026-10-02 (defect 157).
    if ffi_lookup.has(text: stderr, needle: "must use 'union' tag to refer to type '" + name + "'") || ffi_lookup.has(text: stderr, needle: "must use 'enum' tag to refer to type '" + name + "'")
        return fail(code: "none", msg: "the tag class owns this name")

    if !ffi_held.held_kind(s, decls, name: name, types: types).is_err()
        return fail(code: "none", msg: "the header holds this tag")
    found = ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this name")

    if !macros[name].is_err()
        return macro_name(s, tree, decls, name: name)

    # A name the header declares under a switch of the C library, or hides
    # under one a header defines, which a refused round asked
    # (`cli/switch_ask.hero`, defect 568; `cli/unswitch_ask.hero`, 585).
    if !switched[name].is_err()
        return ok(
            ffi_switched.told(header: found.must().header, name: name, decided: switched[name].must(), span: found.must().span)
        )
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_unknown_name",
        message: "`" + found.must().header + "` declares no `" + name + "` — clang read the header and could not find it",
        span: found.must().span
    )
    d.notes @ d.notes.push(UNKNOWN + name + "`")

    # clang's own typo correction, when it offered one. A GUESS: it is
    # a suggestion from a search over the header's names, not a fact
    # about this program, so --apply must not take it (CLAUDE.md §8).
    meant = did_you_mean(stderr: stderr, name: name)

    if !meant.is_err()
        at = ffi_lookup.name_span(s, decls, name: name)

        if !at.is_err()
            d.fixes @ d.fixes.push(
                diag.Fix(title: "the header declares `" + meant.must() + "`", replacement: meant.must(), span: at.must(), certainty: .guess)
            )
    return ok(d)

# The header defines the name as a macro: `ffi_macro_name`, its own code
# because the cause and the repair are not a misspelling's (panel 185 R1). A
# macro has no parameter types, so no declaration of it can be checked, and
# the repair is a function of the program's own that calls it, which clang
# holds the declaration to like any function's. **The note never writes the
# declared C types into that function**: a function drafted from a wrong
# declaration is the hole itself in the author's file (`status: u8` read four
# bytes of one through `WEXITSTATUS`, AddressSanitizer exit 134, measured by
# panel 185's ffi-pragmatist), so every type is a placeholder the author fills
# from the macro's documentation. What the declaration does settle is said:
# its parameters' names, and whether a value comes back.
function macro_name(s: source.Source, tree: ast.Ast, decls: [ast.Decl], name: str) -> diag.Diagnostic?
    found = ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this name")
    header = found.must().header
    message: str @= "`" + header + "` defines `" + name + "` as a macro, not a function: a macro has no parameter types for clang to hold this declaration to"

    if found.must().is_constant
        message @ "`" + header + "` defines `" + name + "` as a macro that takes arguments, not a value: it has none until it is called, and a macro has no parameter types for clang to hold a declaration to"
    d: diag.Diagnostic @= diag.new_diagnostic(code: "ffi_macro_name", message: message, span: found.must().span)
    d.notes @ d.notes.push(
        "bind a function of the program's own that calls it: in a header beside this file, `" + shim(s, tree, decls, name: name) + "`, with the C types the macro's documentation gives where the placeholders stand; then name that header in an `extern` group and declare `hero_" + name + "` there like any function, and clang holds that declaration to your function (§ 13)"
    )
    return ok(d)

# The function the note drafts: the declaration's parameter names, a
# placeholder for every type, and `void` only where the declaration takes no
# value back. With no parameters declared, the macro's are the author's to
# write, since a macro refused here takes some.
function shim(s: source.Source, tree: ast.Ast, decls: [ast.Decl], name: str) -> str
    names: [str] @= []
    typed: [str] @= []
    gives: bool @= true

    for decl in decls
        if source.span_text(s, decl.name) != name
            continue

        match decl.kind
            .function_decl fd =>
                if !fd.value.header.is_err()
                    for param in fd.value.params
                        names @ names.push(source.span_text(s, param.name))
                        typed @ typed.push("<C type> " + source.span_text(s, param.name))

                    match tree.types[fd.value.result].kind
                        .unit                                                                       => gives @ false
                        .named | .array_of | .fixed | .map_of | .fallible | .function_type | .error => gives @ true
            .constant_decl | .record_decl | .variant_decl | .test_decl => continue

    head: str @= "(<its parameters, in C>)"
    call: str @= name + "(<their names>)"

    if names.len() > 0
        head @ "(" + typed.join(", ") + ")"
        call @ name + "(" + names.join(", ") + ")"

    if gives
        return "static inline <C result> hero_" + name + head + " { return " + call + "; }"
    return "static inline void hero_" + name + head + " { " + call + "; }"

# The name clang suggested instead. Read from the whole of stderr
# rather than from one line, because the note sits on a line of its
# own under the error.
function did_you_mean(stderr: str, name: str) -> str?
    for one in ffi_lookup.lines(text: stderr)
        if !ffi_lookup.has(text: one, needle: "'" + name + "'") && !ffi_lookup.has(text: one, needle: "did you mean")
            continue
        rest = ffi_lookup.after(text: one, marker: "did you mean '")

        if rest.is_err()
            continue
        meant = ffi_lookup.up_to_quote(rest.must())

        if meant != name
            return ok(meant)

    return fail(code: "none", msg: "clang offered no correction")

# What clang's echo can leave stuck to a token: quotes and the
# assertion's own closing punctuation.
function trim_trailing(name: str) -> str
    cs = name.chars()
    end: i64 @= cs.len()
    fall: bool @= false

    while end > 0 && !fall
        last = cs[end - 1]

        if last == "\"" || last == "," || last == ")" || last == "'"
            end @ end - 1
        else
            fall @ true

    kept: [str] @= []
    index: i64 @= 0

    while index < end
        kept @ kept.push(cs[index])
        index @ index + 1

    return kept.join("")

## Tests

test "wrong_type splits the emitter's own tail into the two codes"
    text = "extern \"math.h\"\n    function sqrt(x: f64) -> f64\n    constant M_PI: f64\n\nfunction main()\n    print(sqrt(M_PI))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:12:1: error: static assertion failed due to requirement 'x': heroes-ffi-return sqrt f64"
    unasked: {str: ffi_asked.Typed} = {}
    d = wrong_type(s, parsed.decls, parsed.tree, line: line, results: unasked, word_bits: 64)
    assert d.must().code == "ffi_return_type"
    assert d.must().message == "`sqrt` does not return `f64` — that is what `math.h` says, and clang read it"
    k = wrong_type(
        s,
        parsed.decls,
        parsed.tree,
        line: "e: static assertion failed: heroes-ffi-return M_PI f64",
        results: unasked,
        word_bits: 64
    )
    assert k.must().code == "ffi_constant_type"

    # The echo line carries the marker without FAILED, and is refused.
    echo = "_Static_assert(HERO_RET_F64(sqrt((double)0)), \"heroes-ffi-return sqrt f64\");"
    assert wrong_type(s, parsed.decls, parsed.tree, line: echo, results: unasked, word_bits: 64).is_err()

    # A name no group declares stays the compiler's problem.
    assert wrong_type(
        s,
        parsed.decls,
        parsed.tree,
        line: "e: static assertion failed: heroes-ffi-return puts i64",
        results: unasked,
        word_bits: 64
    ).is_err()

    # With the refused round's answer the header's type is named and its
    # word offered (defect 186).
    asked: {str: ffi_asked.Typed} @= {}
    asked["sqrt"] @ ffi_asked.Typed(spelled: "double", canonical: "double")
    named = wrong_type(
        s,
        parsed.decls,
        parsed.tree,
        line: "e: static assertion failed: heroes-ffi-return sqrt f32",
        results: asked,
        word_bits: 64
    )
    assert named.must().message == "`sqrt` returns `double` in `math.h`, not `f32` — clang read the header"
    assert named.must().fixes[0].replacement == "f64"

test "not_constant trims the echo's punctuation and names the object"
    text = "extern \"stdio.h\"\n    constant BUFSIZ: i64\n\nfunction main()\n    print(BUFSIZ)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:9:1: error: static assertion failed due to requirement '__builtin_constant_p(BUFSIZ)': heroes-ffi-const BUFSIZ\")"
    d = not_constant(s, parsed.decls, line: line)
    assert d.must().code == "ffi_not_constant"
    assert d.must().message == "`stdio.h` has `BUFSIZ`, but not as a constant — clang cannot read its value while compiling"

test "unknown_name reads both clang spellings and takes the guess"
    text = "extern \"math.h\"\n    function sqrtt(x: f64) -> f64\n\nfunction main()\n    print(sqrtt(x: 2.0))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    stderr = "main.c:5:9: error: call to undeclared function 'sqrtt'; ISO C99 and later do not support implicit function declarations\nmain.c:5:9: note: did you mean 'sqrt'?\n"
    line = "main.c:5:9: error: call to undeclared function 'sqrtt'; ISO C99 and later do not support implicit function declarations"
    no_macros: {str: bool} = {}
    unasked: {str: str} = {}
    unswitched: {str: ffi_switched.Switch} = {}
    d = unknown_name(
        s,
        parsed.tree,
        parsed.decls,
        line: line,
        stderr: stderr,
        macros: no_macros,
        types: unasked,
        switched: unswitched
    )
    assert d.must().code == "ffi_unknown_name"
    assert d.must().message == "`math.h` declares no `sqrtt` — clang read the header and could not find it"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "sqrt"
    assert d.must().fixes[0].certainty == .guess

    # A name this program never declared is refused: clang's line
    # stays a statement about the compiler.
    other = "m.c:1:1: error: use of undeclared identifier 'h_t_ghost'"
    assert unknown_name(
        s,
        parsed.tree,
        parsed.decls,
        line: other,
        stderr: other,
        macros: no_macros,
        types: unasked,
        switched: {}
    ).is_err()

# DEFECT 400: `*(opaque * *)0`, the union question over a handle, is the only
# place a program build spelled the word, and clang called it undeclared where
# the header declares `struct opaque`. The header's answer to the record's own
# question holds the tag, so nothing says it is absent; a tag the header holds
# by no kind is still told missing, which is true.
test "a handle's tag the header holds is never told absent (defect 400)"
    text = "extern \"fwd.h\"\n    record Opaque tag opaque\n    record Typo tag opaqe\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    no_macros: {str: bool} = {}
    types: {str: str} @= {}
    types["opaque"] @ "tag"
    types["opaqe"] @ "neither"
    held = "m.c:14:42: error: use of undeclared identifier 'opaque'"
    assert unknown_name(
        s,
        parsed.tree,
        parsed.decls,
        line: held,
        stderr: held,
        macros: no_macros,
        types: types,
        switched: {}
    ).is_err()

    for kind in ["union", "enum", "type"]
        types["opaque"] @ kind
        assert unknown_name(
            s,
            parsed.tree,
            parsed.decls,
            line: held,
            stderr: held,
            macros: no_macros,
            types: types,
            switched: {}
        ).is_err()

    misspelt = "m.c:15:42: error: use of undeclared identifier 'opaqe'"
    d = unknown_name(
        s,
        parsed.tree,
        parsed.decls,
        line: misspelt,
        stderr: misspelt,
        macros: no_macros,
        types: types,
        switched: {}
    )
    assert d.must().message == "`fwd.h` declares no `opaqe` — clang read the header and could not find it"

    # Asked nothing, the reader says what it always said.
    unasked: {str: str} = {}
    assert unknown_name(s, parsed.tree, parsed.decls, line: held, stderr: held, macros: no_macros, types: unasked, switched: {}).must().code == "ffi_unknown_name"

test "a tag-only struct is not an absent one — the tag class owns it"
    text = "extern \"sys/stat.h\"\n    record TagOnly\n        n: i64\n\nfunction touch(v: TagOnly)\n    _ = v\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    stderr = "m.c:2:1: error: must use 'struct' tag to refer to type 'TagOnly'\nm.c:3:1: error: use of undeclared identifier 'TagOnly'\n"
    line = "m.c:3:1: error: use of undeclared identifier 'TagOnly'"
    no_macros: {str: bool} = {}
    unasked: {str: str} = {}
    assert unknown_name(
        s,
        parsed.tree,
        parsed.decls,
        line: line,
        stderr: stderr,
        macros: no_macros,
        types: unasked,
        switched: {}
    ).is_err()
