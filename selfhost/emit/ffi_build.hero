# The classes where THE MACHINE DOES NOT HAVE what the group named
# (design.md §4.19; panels 048, 049, 050, 055). Port of
# archive/bootstrap-rs/heroes/src/emit/ffi_build.rs.
#
# These four are not about the author's types at all — the declaration
# may be perfect and the header still absent, the symbol still
# unresolved, the package still unknown to pkg-config. Two read a
# LINKER's output rather than a compiler's, and one reads this
# compiler's own PACKAGE marker, so the file that groups them is the
# one that knows a build has more tools in it than clang.

use token
use ast
use source
use diag
use bytes
use emit/externs as emit_externs
use emit/clang_name
use emit/ffi_lookup
use emit/header_reach
use parse
use resolve
use checker

# A symbol the linker could not find, which this program declared
# extern — the author forgot `link`, and until panel 048 the compiler
# answered internal error at exit 2. The gate is declaration() and it
# is doing real work: an undefined symbol no extern group declares is
# a symbol the EMITTER failed to define — a generated hash prototyped
# and never written is a recorded instance — and that stays exit 2.
# NO FIX IS OFFERED, deliberately: the repair is `link "<name>"` and
# the compiler does not know the name — a table mapping math.h to m
# would be a premise about the world with an entry for every library
# anyone ever binds (panel 048 declined a spec clause on four judges'
# evidence).
function missing_link(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    name = undefined_symbol(line)

    if name.is_err()
        return fail(code: "none", msg: "not an undefined-symbol line")
    found = ffi_lookup.declaration(s, decls, name: name.must())

    if found.is_err()
        return fail(code: "none", msg: "no group declares this symbol")
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_missing_link",
        message: "the linker cannot find `" + name.must() + "`, and no group in this program says which library has it",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "`" + found.must().header + "` declares `" + name.must() + "`, and a header is not a library: write `extern \"" + found.must().header + "\" link \"<library>\"` — `math.h` needs `link \"m\"` on Linux and the BSDs, where it is a separate library"
    )
    return ok(d)

# A library the group DID name and the linker cannot find (panel 055).
# The third face of one mistake and the last of them: the group is
# right, the machine is short. The narrowing is link's own list — the
# analogue of declaration(): a library name this program wrote is the
# author's business, and one it did not write is the driver's own -l
# and stays exit 2.
#
# **The line is asked about each name the program wrote, never parsed for
# one** (panel 188): ld64 writes `ld: library 'X' not found`, GNU ld
# `cannot find -lX` then `:` or the line's end, and until then the name was
# cut at the first quote or space, so `link "a'b"` on ld64 and `link "a b"`
# on GNU ld were an internal error. The longest name the line holds wins.
# lld-link, the Windows linker, writes `could not open 'X.lib'` then `:`, and
# a missing library was exit 2 there (panel 188's Windows leg, § 22.2).
function missing_library(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: "library '") && !ffi_lookup.has(text: line, needle: "cannot find -l") && !ffi_lookup.has(text: line, needle: "could not open '")
        return fail(code: "none", msg: "not a missing-library line")
    name: str @= ""
    span: token.Span? @= fail(code: "none", msg: "no group names this library")

    for decl in decls
        library: ast.Library? @= fail(code: "none", msg: "no library")

        match decl.kind
            .function_decl fd          => library @ fd.value.library
            .constant_decl k           => library @ k.library
            .record_decl rec           => library @ rec.library
            .variant_decl | .test_decl => continue

        if library.is_err()
            continue

        match library.must()
            .link l =>
                written = emit_externs.unquoted(s, span: l.name)

                if written.len() > name.len() && names_library(line: line, name: written)
                    name @ written
                    span @ ok(l.name)
            .package => continue

    if span.is_err()
        return fail(code: "none", msg: "no group names this library")
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_missing_library",
        message: "this machine has no library called `" + name + "` — the group names it, and the linker looked",
        span: span.must()
    )
    d.notes @ d.notes.push(
        "install its development files, or pass `--library <dir>`; where the library ships a `.pc`, `package \"" + name + "\"` asks the machine for both its headers and its libraries"
    )
    return ok(d)

# Whether the linker's line is its report of `name` missing, in any of the
# three spellings, the name whole. lld-link opens `-lX` as `X.lib`, and a
# name already ending in `.lib` is asked as itself too, unrun on Windows.
function names_library(line: str, name: str) -> bool
    if ffi_lookup.has(text: line, needle: "library '" + name + "' not found")
        return true

    if ends_the_name(line: line, marker: "could not open '" + name + ".lib'") || ends_the_name(line: line, marker: "could not open '" + name + "'")
        return true
    return ends_the_name(line: line, marker: "cannot find -l" + name)

# Whether `marker` stands in the line followed by `:` or by its end.
function ends_the_name(line: str, marker: str) -> bool
    rest = ffi_lookup.after(text: line, marker: marker)
    return !rest.is_err() && (rest.must().len() == 0 || rest.must()[0] == ':')

# The symbol out of a linker's complaint, in the spellings the two
# platforms produce. GNU ld and lld write "undefined reference to
# `sqrt'"; Apple's ld64 writes '"_sqrt", referenced from:' on its own
# line. THE LEADING UNDERSCORE IS MACH-O'S, not the program's, and
# stripping it is what lets one declaration() lookup serve both.
function undefined_symbol(line: str) -> str?
    gnu = ffi_lookup.after(text: line, marker: "undefined reference to `")

    if !gnu.is_err()
        return ok(ffi_lookup.up_to_quote(gnu.must()))

    if ffi_lookup.has(text: line, needle: "referenced from:")
        opened = ffi_lookup.after(text: line, marker: "\"")

        if opened.is_err()
            return fail(code: "none", msg: "no quoted symbol")
        letters: [str] @= []

        for ch in opened.must().chars()
            if ch == "\""
                break
            letters @ letters.push(ch)

        quoted = letters.join("")
        cs = quoted.chars()

        if cs.len() > 0 && cs[0] == "_"
            return ok(quoted.slice(from: 1, to: quoted.len()))
        return ok(quoted)
    return fail(code: "none", msg: "not an undefined-symbol line")

# A header the preprocessor could not find, named by an extern group
# in this program — the class that stops §4.19's ladder one directory
# before the linker (panel 049: a real raylib binding died at exit 2
# for a missing -I on the author's own machine). The class does not
# repair the gap — the language still has no way to SAY where a header
# is — it repairs the BLAME.
#
# **And a header the group's own header reaches, directly or through
# others** (defect 158, 2026-10-02): the group's header was found and one it
# needs was not, the same machine's fact further in, told by
# `emit/header_reach.hero` from the line's place and the include stack clang
# printed in `stderr` above it. It was exit 2 and clang's text until then.
#
# The header's name is read after clang's `error: '`, so a quote in a
# directory's name cannot be taken for the header's (the first quote on the
# line was read until defect 158), and up to the line's LAST `' file not
# found`, so a quote in the name stays in it and the group is asked in
# clang's spelling (`emit/clang_name.hero`): until defect 232 the name was cut
# at its first quote, and a missing header named with `'` or with a code point
# clang writes `<U+XXXX>` was exit 2, or a nested one named falsely.
function missing_header(s: source.Source, decls: [ast.Decl], line: str, stderr: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: "file not found")
        return fail(code: "none", msg: "not a missing-header line")
    opened: str? @= ffi_lookup.after(text: line, marker: "error: '")

    if opened.is_err()
        opened @ ffi_lookup.after(text: line, marker: "'")

    if opened.is_err()
        return fail(code: "none", msg: "no quoted header")
    printed = clang_name.before_last(text: opened.must(), marker: "' file not found")

    if printed.is_err()
        return fail(code: "none", msg: "no quoted header")
    header = printed.must()
    span = ffi_lookup.group_head(s, decls, header: header)

    if span.is_err()
        return header_reach.reached_header(s, decls, line: line, stderr: stderr, missing: header)
    d: diag.Diagnostic @= diag.new_diagnostic(
        code: "ffi_missing_header",
        message: "`" + header + "` is not on this machine's include path — clang looked and did not find it",
        span: span.must()
    )
    d.notes @ d.notes.push(
        "the group names a header the preprocessor must be able to open: install the library's development files, or pass `--include <dir>` — `package` finds it for you where the library ships a `.pc`, and `CPATH` works too"
    )
    return ok(d)

# A package this program asked about, and the machine could not answer:
# not installed, or answering with a word the allow-list refuses. The only
# class whose text this compiler writes itself: `cli/libraries.hero` opens
# its message with the marker, matched here so one file holds every rule
# about whose mistake a build failure is. The message is already written for
# a reader and is carried whole, minus the marker, its later lines as notes,
# because they are the repair and §4.17 says an error carries what is needed
# to fix it.
#
# **The marker is read at the head of the text's first line and nowhere else**
# (defect 237, 2026-10-03). It was read anywhere on any line, the name cut at
# its first backtick and every marker on the line replaced, so `package "a`b"`
# matched no group and the driver's message reached the author raw, marker
# and all, at exit 1 with no code and no place, and an answer holding the
# marker's text was quoted with *the package* in its place; panel 188's stage
# A saw a line end leak the marker the same way. Only the driver writes that
# head, the group is the one whose own name stands there
# (`ffi_lookup.package_span`), and only that leading marker is replaced, so no
# byte of a name or of `pkg-config`'s answer moves the reading; the driver
# writes `pkg-config`'s control characters by their code
# (`cli/shell_split.shown`), a line end among them.
function package_problem(s: source.Source, decls: [ast.Decl], stderr: str, line: str) -> diag.Diagnostic?
    if !bytes.bytes_at(text: line, at: 0, needle: ffi_lookup.PACKAGE) || !first_line(text: stderr, line: line)
        return fail(code: "none", msg: "not the driver's package line")
    span = ffi_lookup.package_span(s, decls, line: line)

    if span.is_err()
        return fail(code: "none", msg: "no group asked for this package")
    headline = "the package " + line.slice(from: ffi_lookup.PACKAGE.len(), to: line.len())
    d: diag.Diagnostic @= diag.new_diagnostic(code: "ffi_package", message: headline, span: span.must())
    index: i64 @= 0

    for one in ffi_lookup.lines(text: stderr)
        note = ffi_lookup.trimmed(one)

        if index > 0 && note.len() > 0
            d.notes @ d.notes.push(note)
        index @ index + 1

    return ok(d)

# Whether `line` is the first line of `text`, asked by its bytes.
function first_line(text: str, line: str) -> bool
    return bytes.bytes_at(text: text, at: 0, needle: line) && (text.len() == line.len() || text[line.len()] == '\n')

## Tests

test "the linker's two spellings, the library, the header, the package"
    text = "extern \"math.h\"\n    function sqrt(x: f64) -> f64\n\nextern \"SDL.h\" link \"sdl2\"\n    function SDL_Init(flags: u32) -> i64\n\nextern \"raylib.h\" package \"raylib\"\n    record Color\n        r: i64\n\nfunction touch(c: Color)\n    _ = c\n\nfunction main()\n    print(sqrt(2.0) + SDL_Init(flags: 1).to_f64())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0

    # Mach-O: the underscore is the platform's, not the program's.
    mach = "  \"_sqrt\", referenced from:"
    d = missing_link(s, parsed.decls, line: mach)
    assert d.must().code == "ffi_missing_link"
    assert d.must().message == "the linker cannot find `sqrt`, and no group in this program says which library has it"

    # GNU spelling finds the same declaration.
    gnu = "main.o: in function `h_t_main': undefined reference to `sqrt'"
    assert !missing_link(s, parsed.decls, line: gnu).is_err()

    # A symbol nobody declared stays the compiler's own failure.
    ours = "  \"_h_t_Point_hash\", referenced from:"
    assert missing_link(s, parsed.decls, line: ours).is_err()

    # The library, in both linker spellings, lands on the quoted name.
    lib = missing_library(s, parsed.decls, line: "ld: library 'sdl2' not found")
    assert lib.must().code == "ffi_missing_library"
    assert source.span_text(s, lib.must().span) == "\"sdl2\""
    assert !missing_library(s, parsed.decls, line: "/usr/bin/ld: cannot find -lsdl2").is_err()
    assert missing_library(s, parsed.decls, line: "ld: library 'curl' not found").is_err()

    # The header the preprocessor could not open.
    raylib = "main.c:3:10: fatal error: 'raylib.h' file not found"
    hdr = missing_header(s, parsed.decls, line: raylib, stderr: raylib)
    assert hdr.must().code == "ffi_missing_header"
    ghost = "main.c:3:10: fatal error: 'ghost.h' file not found"
    assert missing_header(s, parsed.decls, line: ghost, stderr: ghost).is_err()

    # The package: headline keeps its sentence, later lines become
    # notes, the marker becomes plain words.
    stderr = "heroes-ffi-package `raylib` is not installed on this machine\n  install raylib with your package manager\n  or pass --library and --include yourself\n"
    line = "heroes-ffi-package `raylib` is not installed on this machine"
    pk = package_problem(s, parsed.decls, stderr: stderr, line: line)
    assert pk.must().code == "ffi_package"
    assert source.span_text(s, pk.must().span) == "\"raylib\""
    assert pk.must().message == "the package `raylib` is not installed on this machine"
    assert pk.must().notes.len() == 2
    assert pk.must().notes[0] == "install raylib with your package manager"
    assert package_problem(s, parsed.decls, stderr: stderr, line: "heroes-ffi-package `sdl3` missing").is_err()

# Lines as clang printed them in lane h158's first pass (2026-10-02, this Mac).
test "a header no group names is asked of the stack, and one a group names keeps its words"
    text = "extern \"outer.h\"\n    function seven() -> i32\n\nfunction main()\n    print(seven())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    said = "In file included from build/tu-1/main.c:5:\nIn file included from d2/outer.h:2:\nd2/mid.h:1:10: fatal error: 'gone.h' file not found\n"
    deep = missing_header(s, parsed.decls, line: "d2/mid.h:1:10: fatal error: 'gone.h' file not found", stderr: said)
    assert deep.must().message == "`gone.h` is not on this machine's include path, and `outer.h`, the header this group names, includes it through `mid.h`"

    # A quote in a directory's name is not the header's.
    quoted = "/Users/o'hara/outer.h:2:10: fatal error: 'gone.h' file not found"
    assert missing_header(s, parsed.decls, line: quoted, stderr: quoted).must().message == "`gone.h` is not on this machine's include path, and `outer.h`, the header this group names, includes it at line 2"

    # The line alone reaches no group at depth two.
    alone = "d2/mid.h:1:10: fatal error: 'gone.h' file not found"
    assert missing_header(s, parsed.decls, line: alone, stderr: alone).is_err()
    direct = "build/tu-1/main.c:5:10: fatal error: 'outer.h' file not found"
    assert missing_header(s, parsed.decls, line: direct, stderr: direct).must().message == "`outer.h` is not on this machine's include path — clang looked and did not find it"

test "a library's name is found in the linker's line whole, a quote or a space in it (panel 188)"
    text = "extern \"stdio.h\" link \"x'y\"\n    function f1() -> i32\n\nextern \"stdio.h\" link \"a b\"\n    function f2() -> i32\n\nextern \"stdio.h\" link \"a\"\n    function f3() -> i32\n\nextern \"stdio.h\" link \"ab\"\n    function f4() -> i32\n\nfunction main()\n    print(f1() + f2() + f3() + f4())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    quoted = missing_library(s, parsed.decls, line: "ld: library 'x'y' not found")
    assert source.span_text(s, quoted.must().span) == "\"x'y\""
    spaced = missing_library(s, parsed.decls, line: "/usr/bin/ld: cannot find -la b: No such file or directory")
    assert source.span_text(s, spaced.must().span) == "\"a b\""
    longer = missing_library(s, parsed.decls, line: "/usr/bin/ld: cannot find -lab")
    assert source.span_text(s, longer.must().span) == "\"ab\""
    assert missing_library(s, parsed.decls, line: "/usr/bin/ld: cannot find -labc").is_err()

# lld-link's wording as panel 188's Windows leg quotes it (the
# compiler-engineer's report, § 22.2), behind lld's usual prefix.
test "a library lld-link could not open is found whole, and only by its own name (panel 188, Windows)"
    text = "extern \"stdio.h\" link \"x'y\"\n    function f1() -> i32\n\nextern \"stdio.h\" link \"a b\"\n    function f2() -> i32\n\nextern \"stdio.h\" link \"a\"\n    function f3() -> i32\n\nextern \"stdio.h\" link \"ab\"\n    function f4() -> i32\n\nextern \"stdio.h\" link \"z.lib\"\n    function f5() -> i32\n\nfunction main()\n    print(f1() + f2() + f3() + f4() + f5())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    opened = "lld-link: error: could not open '"
    absent = ": no such file or directory"
    spaced = missing_library(s, parsed.decls, line: opened + "a b.lib'" + absent)
    assert source.span_text(s, spaced.must().span) == "\"a b\""
    quoted = missing_library(s, parsed.decls, line: opened + "x'y.lib'" + absent)
    assert source.span_text(s, quoted.must().span) == "\"x'y\""
    longer = missing_library(s, parsed.decls, line: opened + "ab.lib'" + absent)
    assert source.span_text(s, longer.must().span) == "\"ab\""
    suffixed = missing_library(s, parsed.decls, line: opened + "z.lib'" + absent)
    assert source.span_text(s, suffixed.must().span) == "\"z.lib\""
    assert missing_library(s, parsed.decls, line: opened + "abc.lib'" + absent).is_err()
    assert missing_library(s, parsed.decls, line: opened + "main.obj'" + absent).is_err()

# Defect 232's lines, as this Mac's clang printed them (2026-10-03): a quote
# in a header's name, a code point clang escapes, a header whose name another
# group's ends with, and a quote in a header a group's header includes.
test "a header clang could not find is read whole, a quote or an escaped code point in it (defect 232)"
    # The third group's header holds U+E000, a private-use code point, between
    # `x` and `.h`.
    text = "extern \"b.h\"\n    function six() -> i32\n\nextern \"a'b.h\"\n    function seven() -> i32\n\nextern \"x.h\"\n    function eight() -> i32\n\nfunction main()\n    print(six() + seven() + eight())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    quoted = "build/tu-1/p.c:6:10: fatal error: 'a'b.h' file not found"
    said = missing_header(s, parsed.decls, line: quoted, stderr: quoted).must()
    assert source.span_text(s, said.span) == "function seven() -> i32"
    assert said.message == "`a'b.h` is not on this machine's include path — clang looked and did not find it"
    plain = "build/tu-1/p.c:5:10: fatal error: 'b.h' file not found"
    assert source.span_text(s, missing_header(s, parsed.decls, line: plain, stderr: plain).must().span) == "function six() -> i32"
    escaped = "build/tu-1/p.c:7:10: fatal error: 'x<U+E000>.h' file not found"
    pua = missing_header(s, parsed.decls, line: escaped, stderr: escaped).must()
    assert source.span_text(s, pua.span) == "function eight() -> i32"
    assert pua.message == "`x<U+E000>.h` is not on this machine's include path — clang looked and did not find it"
    inner = "d/b.h:1:10: fatal error: 'gone'x.h' file not found"
    stack = "In file included from build/tu-1/p.c:5:\n" + inner + "\n"
    deep = missing_header(s, parsed.decls, line: inner, stderr: stack).must()
    assert deep.message == "`gone'x.h` is not on this machine's include path, and `b.h`, the header this group names, includes it at line 1"

# Defect 237's lines, in the driver's wordings: a name with a backtick or a
# quote, a name that is the marker's own text, an answer holding the marker,
# the marker on a later line, and on a line clang wrote.
test "the driver's package line is read at its head, whatever a name or an answer holds (defect 237)"
    text = "extern \"stdio.h\" package \"a`b\"\n    function f1() -> i32\n\nextern \"stdio.h\" package \"a\"\n    function f2() -> i32\n\nextern \"stdio.h\" package \"x'y\"\n    function f3() -> i32\n\nextern \"stdio.h\" package \"heroes-ffi-package\"\n    function f4() -> i32\n\nfunction main()\n    print(f1() + f2() + f3() + f4())\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    tick = "heroes-ffi-package `a`b` is not installed on this machine"
    said = package_problem(
        s,
        parsed.decls,
        stderr: tick + "\n  pkg-config said: Package a`b was not found\n",
        line: tick
    ).must()
    assert source.span_text(s, said.span) == "\"a`b\""
    assert said.message == "the package `a`b` is not installed on this machine"
    assert said.notes[0] == "pkg-config said: Package a`b was not found"
    quote = "heroes-ffi-package `x'y` is not installed on this machine"
    assert source.span_text(s, package_problem(s, parsed.decls, stderr: quote, line: quote).must().span) == "\"x'y\""
    marker = "heroes-ffi-package `heroes-ffi-package` is not installed on this machine"
    named = package_problem(s, parsed.decls, stderr: marker, line: marker).must()
    assert source.span_text(s, named.span) == "\"heroes-ffi-package\""
    assert named.message == "the package `heroes-ffi-package` is not installed on this machine"
    answer = "heroes-ffi-package `a` answered with `heroes-ffi-package `a`b` is`, which this compiler does not pass on"
    quoted = package_problem(s, parsed.decls, stderr: answer, line: answer).must()
    assert source.span_text(s, quoted.span) == "\"a\""
    assert quoted.message == "the package `a` answered with `heroes-ffi-package `a`b` is`, which this compiler does not pass on"
    later = "heroes-ffi-package `a` is not installed on this machine\nheroes-ffi-package `a`b` is not installed on this machine\n"
    assert package_problem(
        s,
        parsed.decls,
        stderr: later,
        line: "heroes-ffi-package `a`b` is not installed on this machine"
    ).is_err()
    clang = "p.c:3:1: error: heroes-ffi-package `a` is not installed"
    assert package_problem(s, parsed.decls, stderr: clang, line: clang).is_err()
