# `print` in C. A compiler form, not a function value (panel 006): one
# monomorphic printer per type, composed by the emitter. The contract is NO
# SEPARATOR, EXACTLY ONE TRAILING NEWLINE — Pascal's WriteLn. `hero_print_end`
# owns the newline: the emitter owning it would need `putchar`, which needs
# `stdio.h` in every generated unit — a header-collision surface on every FFI
# program.
#
# Cut out of `emit/ops.hero` on 2026-09-24 at the `layout` suite's ceiling:
# that file answers what a CALL is in C, and `print` is not a call.
use source
use token
use parse
use resolve
use checker
use check/table
use check/state
use ir
use ir/containers
use emit/writer

function print_call(@w: writer.Writer, f: containers.Function, c: state.Checked, run: ir.Run, arguments: [str])
    at: i64 @ 0

    for arg in containers.args_of(f, run)
        match arg
            .value_arg v =>
                printer: str @ ""

                match table.get(c.types, containers.value_type(f, v.value))
                    .bool => printer @ "hero_print_bool"
                    .str  => printer @ "hero_print_str"
                    .float_ty fk =>
                        match fk.kind
                            .f32 => printer @ "hero_print_f32"
                            .f64 => printer @ "hero_print_f64"
                    # u64 is the one width that needs its own printer:
                    # 2^64-1 read as signed is -1, which is precisely
                    # what print(SIZE_MAX) produced when panel 042
                    # measured it. The other seven widen losslessly.

                    .int_ty ik =>
                        match ik.kind
                            .u64                                         => printer @ "hero_print_uint"
                            .i8 | .i16 | .i32 | .i64 | .u8 | .u16 | .u32 => printer @ "hero_print_int"
                    # The loud direction: this was a catch-all to
                    # hero_print_int, covering nothing but a future
                    # mistake — the checker accepts exactly these.

                    .ptr | .cstr | .unit | .array | .fixed | .map => printer @ printer
                    .fallible | .function_ty | .named | .case_ty  => printer @ printer
                    .failure | .generic | .error                  => printer @ printer

                if printer == ""
                    writer.line(
                        @w,
                        text: "    hero_unreachable(); /* print accepts an integer, a float, bool or str */"
                    )
                else
                    writer.line(@w, text: "    " + printer + "(" + arguments[at] + ");")
            # print(@x) cannot be written: §4.8's marker is for declared
            # parameters, and print declares none.

            .inout_arg => writer.line(@w, text: "    hero_unreachable(); /* print declares no @ parameter */")

        at @ at + 1

    writer.line(@w, text: "    hero_print_end();")

test "print composes monomorphic printers, and u64 gets its own"
    text = "function main()\n    big: u64 = 18446744073709551615\n    print(big)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    u64_id = table.lookup(c.types, .int_ty(kind: .u64)).must()
    str_id = table.str_ty(c.types)
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [u64_id, str_id],
        arguments: [.value_arg(value: 0), .value_arg(value: 1)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    w: writer.Writer @ writer.new_writer("t")
    print_call(@w, f, c, run: ir.Run(start: 0, length: 2), arguments: ["t0", "t1"])
    got = writer.finish(w)
    assert got == "    hero_print_uint(t0);\n    hero_print_str(t1);\n    hero_print_end();\n"
