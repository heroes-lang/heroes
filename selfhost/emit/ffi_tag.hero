# What a header CALLS the type: the tag it keeps in C's other
# namespace, and the two ways naming it can go wrong (design.md §4.19;
# panels 074, 077). Port of archive/bootstrap-rs/heroes/src/emit/ffi_tag.rs.
#
# The seam with emit_ffi_record: that file answers "what are this
# struct's FIELDS", this one "what is this struct CALLED". A field
# mistake is fixed by changing a type on a field line; a naming
# mistake by adding or correcting the tag marker — and one of the two
# carries a CERTAIN fix that writes it for you. Both recognisers keep
# §7's narrowing: the name is recovered from clang's own text and then
# asked whether THIS PROGRAM declared it inside an extern group.

use token
use ast
use source
use diag
use handles
use emit/externs as emit_externs
use emit/ffi_lookup
use parse
use resolve
use checker

# What clang says when a bare word names a struct tag and nothing else: the
# one message this file reads for two purposes, so it is written once.
constant STRUCT_TAG: str
    "must use 'struct' tag to refer to type '"

# clang's "must use 'struct' tag to refer to type 'Plain'" — the
# header declares the struct ONLY as a tag, and the group's record did
# not say so (panel 074). The fix is CERTAIN: clang emits this only
# when the bare name resolves to a struct tag of that same spelling,
# so `tag <name>` is what the header says, not a guess. The author is
# free to rename afterwards — the whole point of the marker is that
# the Heroes name and C's need not agree — but they need not, and
# --apply gets them compiling first.
function missing_tag(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    quoted = ffi_lookup.after(text: line, marker: STRUCT_TAG)

    if quoted.is_err()
        return fail(code: "none", msg: "not a tag line")
    name = ffi_lookup.up_to_quote(quoted.must())
    found = ffi_lookup.declaration(s, decls, name: name)

    if found.is_err()
        return fail(code: "none", msg: "no group declares this name")
    at: token.Span @ found.must().span
    named = ffi_lookup.name_span(s, decls, name: name)

    if !named.is_err()
        at @ named.must()

    # **TWO SHAPES REACH THIS MESSAGE SINCE 2026-09-15, and only one of them is
    # missing a tag.** Until panel 152 this function was unreachable for a record
    # that HAD the tag, because `ffi_lookup.declaration` compared the Heroes name
    # and clang's message carries C's — so `record AI tag addrinfo` was looked up
    # under a name no declaration holds, found nothing, and the author got
    # `internal error: compiling the generated C failed` instead. With the lookup
    # repaired the message arrives, and on THIS shape it is not a mistake at all:
    # the tag is right and the header needs `struct` in front of it, which
    # `needs_struct` below reads and `cli/produce.hero` supplies. So a handle's
    # tag is left to the driver here, and the old text — which told an author
    # who wrote `tag addrinfo` to write `tag addrinfo` — is not written.
    if handle_tagged(s, decls, name: name)
        return fail(code: "none", msg: "the tag is right and the driver supplies the qualifier")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_missing_tag",
        message: "`" + found.must().header + "` declares `" + name + "` as a struct **tag** and gives it no typedef, so C reaches it only as `struct " + name + "`",
        span: at
    )
    d.notes @ d.notes.push(
        "C keeps struct tags in a namespace of their own: say which tag with `tag`, and the Heroes name stays yours — `record FileStat tag stat` binds `struct stat` beside the `function stat` that fills it"
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "name the header's tag: `tag " + name + "`", replacement: name + " tag " + name, span: at, certainty: .certain)
    )
    return ok(d)

# Whether some HANDLE of this program names this C tag. The question is asked of
# the tag and never of the Heroes name, because those are deliberately allowed to
# differ and clang's message carries C's. A record WITH fields is asked nothing:
# the emitter already writes it as `struct <tag>`, so clang's *must use 'struct'*
# can only ever be about a handle, whose tag is written bare.
function handle_tagged(s: source.Source, decls: [ast.Decl], name: str) -> bool
    for decl in decls
        match decl.kind
            .record_decl rec =>
                if !rec.tag.is_err() && handles.is_handle(decl)
                    if source.span_text(s, rec.tag.must()) == name
                        return true
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return false

# The handle tags clang said need `struct` in front of them, read off a failed
# round's stderr (panel 152 R1, defect 037; `cli/produce.hero` is the caller).
#
# **What is learned is the one qualifier the header itself demands, and never a
# name the author did not write.** Clang produces *must use 'struct' tag to refer
# to type 'addrinfo'* only when the bare word `addrinfo` names a struct tag of
# exactly that spelling; a misspelled tag gets *unknown type name* and a tag the
# header defines with a typedef gets silence, so the three cases stay three
# (panel 152's measurement, and the reason a generated probe was refused: a
# `struct nosuchtype *p;` compiles at exit 0 and one bit cannot tell them apart).
# The word is kept as the identity: the emitter writes `struct addrinfo *` on the
# next round, and every refusal clang would make of the author's own word
# survives, because the author's own word is still what it is asked about.
#
# Distinct, in order of first appearance, so the set is a function of the text.
function needs_struct(s: source.Source, decls: [ast.Decl], stderr: str) -> [str]
    out: [str] @ []

    for line in ffi_lookup.lines(text: stderr)
        quoted = ffi_lookup.after(text: line, marker: STRUCT_TAG)

        if quoted.is_err()
            continue
        name = ffi_lookup.up_to_quote(quoted.must())

        if !handle_tagged(s, decls, name: name)
            continue
        already: bool @ false

        for one in out
            if one == name
                already @ true

        if !already
            out @ out.push(name)

    return out

# clang's "incomplete definition of type 'struct NoSuchTag'", the group's
# record whose tag clang cannot lay out, is read in `emit/ffi_incomplete.hero`
# since defect 145 (2026-10-01): telling an opaque struct from one C made up
# takes the notes beside the line, and that reader is a file of its own.

# The declaration whose tag is this name, the header it was declared
# under, and the two words a note quotes back: the record's Heroes name and
# whether it is `partial`. The same declaration() narrowing one field over:
# a tag nobody wrote stays exit 2 and the compiler's.
record TaggedRecord
    span: token.Span
    header: str
    name: str
    partial: bool

# **IT ANSWERED WITH THE FIRST RECORD ON THE TAG UNTIL 2026-09-15, and that was
# safe only while one tag meant one record.** `handles.hero` gave this very
# lookup as a REASON for `one_tag_one_type`: *"a message about the second would
# carry the first's caret."* Panel 153 narrowed that rule to one of each KIND, so
# a tag may now carry a handle and a record with fields — and the two are two
# different C types, `struct s *` and `struct s`, which clang names differently.
#
# So the lookup is asked WHICH KIND the message is about, and it is the caller
# that knows: every message this file reads names `struct <tag>` and is therefore
# about the record with FIELDS, whose C type is exactly that. Panel 153's
# completeness critic measured the wrong caret before this parameter existed —
# `record DbValue tag sqlite3 partial` beside `record Db tag sqlite3` put
# `ffi_unknown_tag` on the HANDLE's line, and printed as its repair the very line
# it was pointing at.
#
# A tag with only one record answers the same either way, which is every binding
# in this tree today.
function record_by_tag(s: source.Source, decls: [ast.Decl], tag_name: str, want_handle: bool) -> TaggedRecord?
    fallback: TaggedRecord? @ fail(code: "none", msg: "no record names this tag")

    for decl in decls
        match decl.kind
            .record_decl rec =>
                if rec.header.is_err() || rec.tag.is_err()
                    continue

                if source.span_text(s, rec.tag.must()) != tag_name
                    continue
                here = TaggedRecord(
                    span: rec.tag.must(),
                    header: emit_externs.unquoted(s, span: rec.header.must()),
                    name: source.span_text(s, decl.name),
                    partial: rec.partial
                )

                if handles.is_handle(decl) == want_handle
                    return ok(here)

                if fallback.is_err()
                    fallback @ ok(here)
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fallback

# clang's "use of 'utag' with tag type that does not match previous
# declaration" — the tag names a UNION and the emitter spelled struct
# (panel 077, predicted by its historian from the standard before
# anyone ran it). C11 6.7.2.3#1a is a CONSTRAINT, so clang must refuse
# `struct utag` against a header's `union utag`: panel 074's marker
# closes every tagged union for free, and all that was missing was the
# wiring. It does not reach `typedef union { … } X;`, where there is
# no tag to mismatch — that shape is emit_extern_union's.
function tag_is_a_union(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !ffi_lookup.has(text: line, needle: "with tag type that does not match previous declaration")
        return fail(code: "none", msg: "not a tag-mismatch line")
    quoted = ffi_lookup.after(text: line, marker: "use of '")

    if quoted.is_err()
        return fail(code: "none", msg: "no tag on the line")
    tag_name = ffi_lookup.up_to_quote(quoted.must())
    found = record_by_tag(s, decls, tag_name: tag_name, want_handle: false)

    if found.is_err()
        return fail(code: "none", msg: "no record names this tag")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_tag_is_a_union",
        message: "`" + found.must().header + "` declares `" + tag_name + "` as a `union`, not a struct — C keeps the two in one namespace and will not let one stand for the other",
        span: found.must().span
    )

    # **The note says what is true, measured** (defect 157, 2026-10-02, lane
    # land186). It said *a union has no `record` spelling in this language*,
    # and `record W` over `typedef union { … } W;` builds and reads; what has
    # none is a union named ONLY by its tag, `record UI tag utag` here and
    # `record utag` refused as a name the header lacks. The refusal is panel
    # 186's R9 question and stays; the routes it names are each a case
    # (`run/fixedbugs-157-*`), and `ptr` through C functions is the other.
    h = found.must().header
    name = found.must().name
    d.notes @ d.notes.push(
        "a `tag` names a struct (§4.19), and a `record` binds a union only by a typedef's name, as `record W` over `typedef union { … } W;` does. If `" + h + "` gives `" + tag_name + "` a typedef, bind that name; if not, give it one in a header of the program's own, `typedef union " + tag_name + " " + name + ";`, and bind `record " + name + "`, or reach it as a `ptr` through C functions"
    )
    return ok(d)

## Tests

test "missing_tag carries the certain fix that writes the marker"
    text = "extern \"sys/stat.h\"\n    record Plain\n        n: i64\n\nfunction touch(v: Plain)\n    _ = v\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:12:1: error: must use 'struct' tag to refer to type 'Plain'"
    d = missing_tag(s, parsed.decls, line: line)
    assert d.must().code == "ffi_missing_tag"
    assert d.must().fixes.len() == 1
    assert d.must().fixes[0].replacement == "Plain tag Plain"
    assert d.must().fixes[0].certainty == .certain

    # The caret is the name's own token.
    assert source.span_text(s, d.must().span) == "Plain"

    # A name no group declares is refused.
    other = "main.c:12:1: error: must use 'struct' tag to refer to type 'Ghost'"
    assert missing_tag(s, parsed.decls, line: other).is_err()

    # And a record with fields is never a tag to learn: the emitter already
    # writes it as `struct Plain`.
    assert needs_struct(s, parsed.decls, stderr: line).len() == 0

test "a handle's tag that clang says needs `struct` is learned once, and is not a diagnostic"
    text = "extern \"netdb.h\"\n    record AI tag addrinfo\n    function freeaddrinfo(ai: AI consumes)\n\nfunction main()\n    print(0)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "main.c:8:1: error: must use 'struct' tag to refer to type 'addrinfo'"

    # Twice on two lines, plus a tag no record carries: one word learned.
    stderr = line + "\nmain.c:9:1: error: must use 'struct' tag to refer to type 'addrinfo'\nmain.c:10:1: error: must use 'struct' tag to refer to type 'ghost'\n"
    assert needs_struct(s, parsed.decls, stderr: stderr) == ["addrinfo"]

    # The message about a handle's tag is the driver's, not an error.
    assert missing_tag(s, parsed.decls, line: line).is_err()

test "tag_is_a_union lands the caret on the tag token, and record_by_tag answers with the record"
    text = "extern \"sys/stat.h\"\n    record FileStat tag statt partial\n        size: i64\n\nfunction touch(v: FileStat)\n    _ = v\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    u = "main.c:8:1: error: use of 'statt' with tag type that does not match previous declaration"
    k = tag_is_a_union(s, parsed.decls, line: u)
    assert k.must().code == "ffi_tag_is_a_union"
    assert source.span_text(s, k.must().span) == "statt"

    # The note names the typedef the program can write, with its own name
    # for the record (defect 157), and says nothing of a union having no
    # spelling at all.
    assert ffi_lookup.has(
        text: k.must().notes[0],
        needle: "`typedef union statt FileStat;`, and bind `record FileStat`"
    )
    assert !ffi_lookup.has(text: k.must().notes[0], needle: "no `record` spelling")
    found = record_by_tag(s, parsed.decls, tag_name: "statt", want_handle: false).must()
    assert found.name == "FileStat"
    assert found.partial
    assert found.header == "sys/stat.h"

    # A tag nobody wrote stays the compiler's.
    assert record_by_tag(s, parsed.decls, tag_name: "ghost", want_handle: false).is_err()
