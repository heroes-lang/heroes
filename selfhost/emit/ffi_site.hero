# Where clang's verdict points, and which `extern` is declared there
# (design.md §4.19; panels 052, 071, 096, 103).
#
# WHY THIS IS A MODULE. Every reader that turns a clang failure into a
# diagnostic on the author's own line asks the same two questions first: WHERE
# does this line point, and WHICH extern did the author declare there. Three of
# them do — `ffi_narrowed` for a width or a class, `ffi_call` for an arity or a
# format string, `ffi_mutable` for a writable parameter — and until 2026-09-05
# all three reached into `ffi_narrowed` for it, which is a module answering
# somebody else's question in two thirds of its body.
#
# The split is CLAUDE.md §11's own rule taken literally: split along a seam that
# names a concern, never at a line count. The seam was named by its callers
# before the ceiling ever fired — three importers of one half and one of the
# other is the strongest evidence a file can give about where it divides.
#
# THE GATE IS THE LOCATION, NOT THE TEXT. `extern_probe` writes one `#line` per
# probe at the author's own extern line, so a clang message about a probe lands
# in a file this compilation owns; a message about anything else does not, and
# `location` refuses it. cgo made the same choice for the same reason: reading
# message text ties the tool to compiler versions, a synthetic `#line` channel
# does not.
#
# NON-LIBRARY, and that word is load-bearing: the library is a registered
# `Source` entry whose name is deliberately unopenable, so a clang error against
# one of its lines must never look like an error in a file the author can edit
# (panel 052's compiler-engineer, in the emitted goldens).

use ast
use source
use ir/containers
use emit/ffi_lookup

record Located
    file: i64
    line: i64
    col: i64
    rest: str

# A clang report is `<file>:<line>:<col>: <severity>: <message>`, and the
# location is read FROM THE RIGHT because a path may hold colons of its own.
#
# **This took the first three colons until 2026-09-05 and was blind on Windows**
# (M-c-callbacks step 4, found by the three-platform rule against a real box).
# `C:/Users/…/note.hero:2:110: error: …` gave `C` as the file and the whole path
# as the line number, which is not numeric, so `location` refused and EVERY ffi
# classifier that gates on it fell through to exit 2 — the compiler blaming
# itself for the author's declaration, which is §4.19's own named failure. CI
# never saw it because CI compiles relative paths; an author compiling
# `C:\work\thing\main.hero` sees it on the first mistake they make.
#
# The seam is the `": "` that ends the column and opens the severity: a path may
# contain a colon, and it may not contain a colon followed by a space in the
# position clang puts one. Within that prefix the last two colons are the line
# and the column, whatever precedes them.
function location(s: source.Source, line: str) -> Located?
    cs = line.chars()
    head = ffi_lookup.char_index_of(text: line, needle: ": ")

    if head.is_err()
        return fail("none", "not a file:line:col report")
    end = head.must()
    stops: [i64] @ []
    index: i64 @ 0

    while index < end
        if cs[index] == ":"
            stops @ stops.push(index)
        index @ index + 1

    if stops.len() < 2
        return fail("none", "not a file:line:col report")
    at_col = stops[stops.len() - 1]
    at_row = stops[stops.len() - 2]
    file_name = slice_chars(cs, from: 0, to: at_row)
    row = ffi_lookup.number(slice_chars(cs, from: at_row + 1, to: at_col))
    col = ffi_lookup.number(slice_chars(cs, from: at_col + 1, to: end))

    if row.is_err() || col.is_err()
        return fail("none", "the position is not numeric")
    at: i64 @ -1
    counter: i64 @ 0

    for entry in s.files
        if entry.name == file_name && !entry.is_library && at == -1
            at @ counter
        counter @ counter + 1

    if at == -1
        return fail("none", "not one of this compilation's own files")
    return ok(
        Located(file: at, line: row.must(), col: col.must(), rest: slice_chars(cs, from: end + 1, to: cs.len()))
    )

function slice_chars(cs: [str], from: i64, to: i64) -> str
    kept: [str] @ []
    index: i64 @ from

    while index < to
        kept @ kept.push(cs[index])
        index @ index + 1

    return kept.join("")

# The extern declared at a file and line — the one the probe's #line
# claims.
record ExternAt
    f: containers.Function
    name: str

function extern_at_line(p: containers.Program, s: source.Source, decls: [ast.Decl], file: i64, at_line: i64) -> ExternAt?
    for f in p.functions
        start = decls[f.decl].name.start

        if source.file_of(s, start) != file || source.file_line_of(s, start) != at_line
            continue
        return ok(ExternAt(f: f, name: source.span_text(s, decls[f.decl].name)))

    return fail("none", "no extern is declared at that line")

# The content between the LAST two quotes on the line — the header's
# type, which is what the parameter should be declared as.
function last_quoted(text: str) -> str?
    cs = text.chars()
    close: i64 @ -1
    open: i64 @ -1
    index: i64 @ cs.len() - 1

    while index >= 0
        if cs[index] == "'"
            if close == -1
                close @ index
            else
                open @ index
                break
        index @ index - 1

    if close == -1 || open == -1
        return fail("none", "no quoted type on the line")
    return ok(slice_chars(cs, from: open + 1, to: close))

## Tests

# The shape every ffi classifier gates on, and the platform that broke it.
test "a location is read from the right, so a Windows drive letter survives"
    s = source.new_source(name: "C:/w/thing/main.hero", text: "function main()\n    print(0)\n")
    got = location(s, line: "C:/w/thing/main.hero:2:110: error: incompatible function pointer types")
    assert !got.is_err()
    assert got.must().line == 2
    assert got.must().col == 110

    # `rest` keeps the space after the colon, which is what it did before this
    # repair and what `last_quoted` has always been handed. The behaviour is
    # deliberately identical: this commit moves WHERE the location is cut, not
    # what the remainder is.
    assert got.must().rest == " error: incompatible function pointer types"

test "a relative path still reads, which is what CI compiles and why this hid"
    s = source.new_source(name: "tests/golden/x.hero", text: "function main()\n    print(0)\n")
    got = location(s, line: "tests/golden/x.hero:7:3: warning: something")
    assert !got.is_err()
    assert got.must().line == 7
    assert got.must().col == 3

# A line with no severity is not a location report, and neither is a path with
# no position after it — both must refuse rather than invent a number.
test "a line that is not a position report is refused"
    s = source.new_source(name: "a.hero", text: "function main()\n    print(0)\n")
    assert location(s, line: "2 errors generated.").is_err()
    assert location(s, line: "a.hero: error: no position here").is_err()

test "a file this compilation does not own is refused, drive letter or not"
    s = source.new_source(name: "a.hero", text: "function main()\n    print(0)\n")
    assert location(s, line: "C:/elsewhere/other.hero:1:1: error: x").is_err()
