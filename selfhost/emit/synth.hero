# What a synthetic type name is hashed FROM (panel 093 R6). Split out
# of emit_ctype at M-separate-compilation step 6, when the content keys
# took that file past its frozen ceiling — this is the half that walks
# TYPES and never touches the Names table, so the `use` edge points one
# way: emit_ctype reads this, never the reverse.
#
# The content key is the public rendering PLUS every declared type the
# type contains, module-qualified and sorted. The rendering alone is
# not canonical — two modules may each declare `Declared`, and
# `Declared?` then rendered identically for two different C structs:
# `redefinition of 'h_0opt_1c40b693'`, loud exactly as the collision
# comment promises, on the compiler's own tree the hour the content
# names landed.

use ast
use source
use check/table
use check/state
use check/render

function content_key(c: state.Checked, s: source.Source, decls: [ast.Decl], ty: i64) -> str
    no_generics: [str] = []
    rendered = render.render_ty(c.types, s, decls, ty, no_generics)
    named: {str: bool} @ {}
    seen: {i64: bool} @ {}
    frontier: [i64] @ [ty]

    while frontier.len() > 0
        id = frontier[frontier.len() - 1]
        frontier @ frontier.slice(from: 0, to: frontier.len() - 1)

        if !seen[id].is_err()
            continue
        seen[id] @ true

        match table.get(c.types, id)
            .named n                                                  => named[source.component_at(s, decls[n.decl].name.start) + "." + source.span_text(s, decls[n.decl].name)] @ true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => named @ named
            .array | .fixed | .map | .fallible | .function_ty         => named @ named
            .case_ty | .failure | .generic | .error                   => named @ named

        for inner in table.contained(c.types, id)
            frontier @ frontier.push(inner)

    # A type with no declared parts is already canonical, and keeping
    # its key equal to its rendering keeps `i64?`'s hash what every
    # pinned test spells.
    if len(named) == 0
        return rendered

    # ORDER: ascending qualified name — the key must not depend on the
    # walk, and sort(keys(…)) is what makes two mentions of one type
    # spell one name.
    return rendered + "|" + sort(keys(named)).join(",")

# Every function type reachable from ty, including ty itself. Closed
# under nesting, because [(function(A) -> B)] names the function type
# without being one, and so does (function(A) -> B)?.
function collect(c: state.Checked, decls: [ast.Decl], ty: i64, @into: {i64: bool}, @seen: {i64: bool})
    match table.get(c.types, ty)
        .function_ty fn_ty =>
            if !into[ty].is_err()
                return
            into[ty] @ true

            for p in table.params_of(c.types, fn_ty.params)
                collect(c, decls, ty: p, into: @into, seen: @seen)

            collect(c, decls, ty: fn_ty.result, into: @into, seen: @seen)
        .array arr  => collect(c, decls, ty: arr.element, into: @into, seen: @seen)
        .fallible o => collect(c, decls, ty: o.payload, into: @into, seen: @seen)
        .map m =>
            collect(c, decls, ty: m.key, into: @into, seen: @seen)
            collect(c, decls, ty: m.value, into: @into, seen: @seen)
        # **A RECORD OR VARIANT IS WALKED, and this arm returned at once until
        # 2026-09-12** (defect 028). A function type reachable only through a
        # field — `record S` holding `f: (function(v: i64) -> i64)`, never
        # called through — was therefore never named, and `ctype.func_of`'s
        # assertion *every function type is named before anything can mention
        # one* fired at emission: `heroes check` said the program was fine at
        # exit 0 and `heroes build` died at exit 134 with no file, no line and
        # no code.
        #
        # `seen` is a second set and not `into`, because `into` IS the list of
        # function typedefs to emit and a named type in it would emit one for a
        # record. It exists at all because a record may hold itself through
        # `[T]` or `{K: V}` (spec § 3), so this walk has a cycle in it.

        .named n =>
            if !seen[ty].is_err()
                return
            seen[ty] @ true

            match decls[n.decl].kind
                .record_decl rec =>
                    for field in rec.fields
                        written = state.written_type(c, field.ty)

                        if !written.is_err()
                            collect(c, decls, ty: written.must(), into: @into, seen: @seen)
                .variant_decl v =>
                    for one_case in v.cases
                        for field in one_case.fields
                            written = state.written_type(c, field.ty)

                            if !written.is_err()
                                collect(c, decls, ty: written.must(), into: @into, seen: @seen)
                .constant_decl | .function_decl | .test_decl => return
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return
        .fixed | .case_ty | .failure | .generic | .error          => return

## What one translation unit wants

# The filter a per-module unit applies to the whole-program sections
# (panel 093 R2, tightened after measurement): a TU carries only the
# typedefs, per-type functions and descriptors for the types its own
# code reaches. It lives HERE rather than in emit.hero because
# emit_typeorder and emit_perfn read it and emit.hero calls them —
# Heroes refuses module cycles, so the shared vocabulary goes to the
# leaf both sides already use.
#
# WHY IT MATTERS, measured 2026-08-25 on the compiler compiling itself:
# unfiltered, one TU of a 157-module program is 19,193 lines of C, and
# 16,712 of them (87%) are whole-program sections — 132 MB of text
# against the fused unit's 22 MB, and the self-build went 188 s -> 484 s.
# The trim is what makes one .c per module cheaper than one big .c
# rather than 2.5x dearer.
record Wanted
    types: {i64: bool}
    named: {i64: bool}
    # The fused unit wants everything: one printer, two modes.
    every: bool

function everything() -> Wanted
    no_types: {i64: bool} = {}
    no_named: {i64: bool} = {}
    return Wanted(types: no_types, named: no_named, every: true)

# The declared types a set of reached type ids mentions — a `.named`
# arm carries the declaration index the aggregate walks are keyed by.
function wanted_of(c: state.Checked, reached: {i64: bool}) -> Wanted
    named: {i64: bool} @ {}

    # ORDER: none — the walk fills a SET, and both readers below ask it
    # a membership question.
    for id in keys(reached)
        match table.get(c.types, id)
            .named n                                                  => named[n.decl] @ true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => named @ named
            .array | .fixed | .map | .fallible | .function_ty         => named @ named
            .case_ty | .failure | .generic | .error                   => named @ named

    return Wanted(types: reached, named: named, every: false)

function wants_type(w: Wanted, ty: i64) -> bool
    if w.every
        return true
    return !w.types[ty].is_err()

function wants_decl(w: Wanted, decl: i64) -> bool
    if w.every
        return true
    return !w.named[decl].is_err()
