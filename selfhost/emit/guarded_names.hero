        "exp2l expf expl expm1 expm1f expm1l fabs fabsf fabsl fdim fdimf fdiml"
        "floor floorf floorl fma fmaf fmal fmax fmaxf fmaxl fmin fminf fminl"
        "fmod fmodf fmodl frexp frexpf frexpl hypot hypotf hypotl ilogb ilogbf"
        "ilogbl ldexp ldexpf ldexpl lgamma lgammaf lgammal llrint llrintf"
        "llrintl llround llroundf llroundl log log10 log10f log10l log1p log1pf"
        "log1pl log2 log2f log2l logb logbf logbl logf logl lrint lrintf lrintl"
        "lround lroundf lroundl modf modff modfl nan nanf nanl nearbyint"
        "nearbyintf nearbyintl nextafter nextafterf nextafterl nexttoward"
        "nexttowardf nexttowardl pow powf powl remainder remainderf remainderl"
        "remquo remquof remquol rint rintf rintl round roundf roundl scalbln"
        "scalblnf scalblnl scalbn scalbnf scalbnl sin sinf sinh sinhf sinhl"
        "sinl sqrt sqrtf sqrtl tan tanf tanh tanhf tanhl tanl tgamma tgammaf"
        "tgammal trunc truncf truncl"
    ]

# **The names C reserves for the implementation that the C this compiler
# writes holds** (defect 2333, 2026-11-08): every `__x` and `_X` of an emitter
# module's text, the three overflow builtins `emit/operator.hero` composes,
# and every one of the runtime's four headers. `macro_guard` left them to the
# headers on purpose, as names a system header may define, and a header did:
# `#define __builtin_add_overflow(a, b, r) ((*(r) = (a) + (b)), 0)` in the
# header a group names turned an `i64` sum past the top into
# `-9223372036854775808` at exit 0, `#define _Static_assert(c, m)` let a
# `double` function bound `-> i64` build and print `1`, `#define
# __builtin_constant_p(x) 1` bound `stdout` as a constant, and `#define _Bool
# int` was an internal error at exit 2 (measured on this Mac the day the
# repair landed). No system header this Mac's SDK or clang ships defines one
# of them where clang compiles C: each definition found stands under
# `!defined(__GNUC__)`, `#ifndef __has_feature` or C++. So
# `runtime/heroes_reserved_open.h` saves each and
# `runtime/heroes_reserved_close.h` gives it back, around the groups' headers
# inside the guard, around the library's headers `heroes_standard.h` reads
# after them, and around the headers of every probe an emitter module writes
# (`reserved_around`); `macro_guard`'s tests hold the two files to this list
# and every emitter module and runtime header to it. Sorted by bytes.
#
# **And C's keywords, every one, and the reserved spellings of the
# attributes the unit writes** (2026-11-24): a header's `#define default 1`
# made every `switch` and `_Generic` of the unit an internal error at exit
# 2, and `#define unused 1` every `__attribute__((unused))`, the unit
# spelling the attribute in the plain form a header may define. So the unit
# writes `__unused__`, `__used__`, `__nodebug__`, `__constructor__` and
# `__no_sanitize__`, names no header has to define, and each is saved and
# given back with the rest; a keyword is saved whether or not the unit
# writes it today, since none is a header's to redefine.
constant RESERVED_LINES: [str]
    [
        "_Alignof _Atomic _Bool _CRT_SECURE_NO_WARNINGS _Generic _Noreturn"
        "_Static_assert _USE_MATH_DEFINES _WIN32 __DBL_MANT_DIG__"
        "__DBL_MAX_EXP__ __DBL_MIN_EXP__ __FLT_EVAL_METHOD__ __INT16_C_SUFFIX__"
        "__INT16_MAX__ __INT16_TYPE__ __INT32_C_SUFFIX__ __INT32_MAX__"
        "__INT32_TYPE__ __INT64_C_SUFFIX__ __INT64_MAX__ __INT64_TYPE__"
        "__INT8_C_SUFFIX__ __INT8_MAX__ __INT8_TYPE__ __INTPTR_TYPE__"
        "__LDBL_MANT_DIG__ __LDBL_MAX_EXP__ __LDBL_MIN_EXP__ __OPTIMIZE__"
        "__SANITIZE_ADDRESS__ __SIZE_TYPE__ __UINT16_TYPE__ __UINT32_TYPE__"
        "__UINT64_C_SUFFIX__ __UINT64_TYPE__ __UINT8_TYPE__ __UINTPTR_TYPE__"
        "__ATOMIC_RELAXED __always_inline__ __asm__ __atomic_always_lock_free __atomic_load_n __attribute__ __builtin_add_overflow"
        "__builtin_choose_expr __builtin_classify_type __builtin_constant_p __builtin_expect"
        "__builtin_fmod __builtin_frame_address __builtin_huge_val __builtin_memcpy"
        "__builtin_memmove __builtin_memset __builtin_mul_overflow"
        "__builtin_offsetof __builtin_return_address __builtin_strlen"
        "__builtin_sub_overflow __builtin_types_compatible_p __cleanup__"
        "__constructor__ __has_feature __no_sanitize__ __nodebug__ __noinline__"
        "__optnone__ __typeof__ __undefined_behavior_sanitizer__ __unused__ __used__ auto break case char const"
        "continue default do double else enum extern float for goto if inline"
        "int long register restrict return short signed sizeof static struct"
        "switch typedef union unsigned void volatile while"
    ]

# The line that saves the reserved names, and the one that gives them back.
constant RESERVED_OPEN_LINE: str
    "#include \"heroes_reserved_open.h\""

constant RESERVED_CLOSE_LINE: str
    "#include \"heroes_reserved_close.h\""

# The names, one each.
function names() -> [str]
    return split(NAMES)

# The reserved names, one each.
function reserved() -> [str]
    return split(RESERVED_LINES)

# A probe's lines of a group's headers between the two that save and give
# back the reserved names, so what the probe writes after them means what the
# compiler wrote; none where there are none.
function reserved_around(lines: [str]) -> [str]
    if lines.len() == 0
        return lines
    out: [str] @= [RESERVED_OPEN_LINE]

    for line in lines
        out @ out.push(line)

    return out.push(RESERVED_CLOSE_LINE)

# The macros left to the headers, one each.
function left() -> [str]
    return split(LEFT_LINES)

# The functions of `<math.h>` the list holds, one each.
function math() -> [str]
    return split(MATH_LINES)

function split(lines: [str]) -> [str]
    out: [str] @= []

    for line in lines
        start: i64 @= 0
        i: i64 @= 0

        while i <= line.len()
            if i == line.len() || line[i] == 32
                if i > start
                    out @ out.push(line.slice(from: start, to: i))
                start @ i + 1
            i @ i + 1

    return out
