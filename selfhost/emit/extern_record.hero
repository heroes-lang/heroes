# Where a group record's assertions GO (design.md §4.19; panels 060,
# 061, 062, 072, 077, 186). Port of
# archive/bootstrap-rs/heroes/src/emit/{extern_record,extern_complete}.rs.
#
# The field assertions ask, of every field the program NAMES, whether
# the header agrees — and say nothing about a field left out. record
# Color with three of raylib's four members compiled with every
# assertion green at exit 0 and returned a transparent colour where
# the program asked for an opaque one (panel 061). The missing half was
# a positional probe here until panel 186: one zero per DECLARED field,
# where C counts the STRUCT's members, so an anonymous union made it miss
# a field left out, warn on a correct record (defect 150) and name a
# declared field (defect 151). It is now asked from the header's own
# layout, before this unit compiles: `emit/layout_text.hero`.

use ast
use source
use check/state
use emit/ctype
use emit/extern_field
use emit/externs as emit_externs
use emit/writer
use parse
use resolve
use checker

# One assertion per field of every record a group declares whose header
# the unit reads (`records`, `emit_externs.held`: every one in the fused
# unit, a module's own and those it reaches in a module's, panel 202 R1).
# The narrowing is header-present — a fact about the declaration in hand.
# The marker carries the DECLARATION's name, never the C type's (panel
# 072 rider 1): with tag, the C type is two words — struct stat — and
# the error mapper splits on whitespace; the declaration's name is one
# token by construction.
function extern_record_assertions(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], records: {i64: bool}?)
    wrote: bool @= false

    for index in emit_externs.walked(decls, records: records)
        decl = decls[index]

        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err() && emit_externs.held(records, decl: index)
                    c_type = ctype.of(names, decl: index)
                    hero_name = source.span_text(s, decl.name)

                    for field in rec.fields
                        lines = extern_field.assertions(
                            c,
                            names,
                            s,
                            c_type: c_type,
                            hero_name: hero_name,
                            field: field
                        )

                        if lines.is_err()
                            continue

                        # #line at the FIELD, so a failure lands on the
                        # author's own line and the mapper can tell
                        # whose mistake it is from the file clang names.
                        # One `line` per assertion (defect 185): the
                        # writer counts each, and restores the field's
                        # line before the second of an array field's two.
                        found = source.source_line(s, field.name.start)
                        writer.at_file(@w, file: found.file, at: found.line)

                        for line in lines.must()
                            writer.line(@w, text: line)

                        wrote @ true
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    if wrote
        writer.at_generated(@w)
        writer.blank(@w)

## Tests

function has(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @= 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @= true
        offset: i64 @= 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false

test "assertions land on the field's line, the probe counts positionally"
    text = "extern \"m.h\"\n    record Color\n        r: i64\n        inner: Point\n    record Point\n        x: f64\n    record Font partial\n        size: f64\n\nfunction touch(a: Color, b: Point, f: Font)\n    _ = a\n    _ = b\n    _ = f\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    w: writer.Writer @= writer.new_writer("t")
    every: {i64: bool}? = fail(code: "every", msg: "every group record")
    extern_record_assertions(@w, c, names, s, parsed.decls, records: every)
    got = writer.finish(w)

    # The field assertion carries the declaration's name and lands
    # under a #line for t.hero.
    assert has(text: got, needle: "heroes-ffi-field Color r")
    assert has(text: got, needle: "#line 3 \"t.hero\"")

    # No positional probe since panel 186: completeness is the layout
    # check's (`emit/layout_text.hero`), asked before this unit compiles.
    assert !has(text: got, needle: "hero_ffi_complete_")
    assert !has(text: got, needle: "-Wmissing-field-initializers")

test "an array field's two assertions are two counted lines, each under the field's own line"
    # Defect 185: they were one string holding a newline, so the writer
    # counted one line where C read two. The restore of the generated file
    # below them then named a line one too low per array field, and the
    # second assertion rode C's auto-increment onto line 4, the next field.
    text = "extern \"m.h\"\n    record Probe\n        name: u8[4]\n        tail: f32[2]\n\nfunction touch(p: Probe)\n    _ = p\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    names = ctype.new_names(s, parsed.decls)
    w: writer.Writer @= writer.new_writer("t")
    every: {i64: bool}? = fail(code: "every", msg: "every group record")
    extern_record_assertions(@w, c, names, s, parsed.decls, records: every)
    rows = rows_of(writer.finish(w))

    # Each field's flex question, then its field question: both assertions
    # of `name` land on line 3, of `tail` on line 4, as C reads them. Read
    # off the directives rather than pinned to them, since a directive the
    # claim already holds is not written (defect 263): `tail`'s flex
    # question reaches line 4 by C's own count, one line after `name`'s.
    landed = landed_at(rows)
    assert has(text: rows[1], needle: "heroes-ffi-flex Probe name")
    assert landed[1] == "t.hero:3"
    assert has(text: rows[3], needle: "heroes-ffi-field Probe name")
    assert landed[3] == "t.hero:3"
    assert has(text: rows[4], needle: "heroes-ffi-flex Probe tail")
    assert landed[4] == "t.hero:4"
    assert has(text: rows[6], needle: "heroes-ffi-field Probe tail")
    assert landed[6] == "t.hero:4"

    # And the restore of the generated file names its own next line: row 8
    # of the output says the line after it is 9, which it is.
    assert rows[7] == "#line 9 \"t.c\""
    assert rows.len() == 9

# Where C places each row: `file:line` as the `#line`s before it say, C
# counting one a row after each, and "" for a directive or a row no
# directive placed.
function landed_at(rows: [str]) -> [str]
    out: [str] @= []
    file: str @= ""
    next: i64 @= 0

    for row in rows
        if row.len() > 6 && row.slice(from: 0, to: 6) == "#line "
            at: i64 @= 6
            number: i64 @= 0

            while row[at] >= '0' && row[at] <= '9'
                number @ number * 10 + (row[at] - '0').to_i64().must()
                at @ at + 1

            file @ row.slice(from: at + 2, to: row.len() - 1)
            next @ number
            out @ out.push("")
        else
            if file == ""
                out @ out.push("")
            else
                out @ out.push(file + ":" + next.to_str())
            next @ next + 1

    return out

# The output's lines, split at each newline the bytes hold, so a line
# carrying a newline of its own is two rows here, as it is two lines to C.
function rows_of(text: str) -> [str]
    rows: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < text.len()
        if text[at] == '\n'
            rows @ rows.push(text.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    if start < text.len()
        rows @ rows.push(text.slice(from: start, to: text.len()))
    return rows
