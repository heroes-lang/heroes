# What the author sees when the program stops (design.md §4.18; spec
# line 163; panels 020, 042, 052). Port of heroes/src/emit/abort.rs in the Rust bootstrap at `m-bootstrap-archive`.
#
# The concern is single and it is not "aborting": it is THE TEXT A
# PERSON READS AT THE MOMENT OF THE STOP. Everything here runs after
# the program has already failed, so nothing it emits can be checked by
# a later pass — a wrong entry point is a wrong message, at exit 1,
# with no diagnostic anywhere. Both bodies point at the GENERATED file:
# the panic call is housekeeping the author never wrote, and lldb must
# not blame their line for it.

use ast
use check/state
use ir
use ir/containers
use emit/ctype
use emit/mangle
use emit/builtins
use emit/writer
use emit/stop_place
use emit/sides
use token
use check/table
use source
use parse
use resolve
use checker

# Every stop an `.abort_op` names, by why the program stops.
function stop(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, why: ir.AbortWhy, run: ir.Run, site: i64)
    match why
        .must_abort            => must_stop(@w, s, f, run: run, site: site)
        .assert_abort          => assert_stop(@w, c, names, s, decls, f, run: run, site: site, equal: false)
        .assert_equal_abort    => assert_stop(@w, c, names, s, decls, f, run: run, site: site, equal: true)
        .unmatched_case_abort  => unmatched_case_stop(@w, s, f, run: run, site: site)
        .unmatched_value_abort => unmatched_value_stop(@w, c, s, f, run: run, site: site)

# .must() on an error. The failure travels with the abort, so the panic
# names the code and msg the author wrote rather than only that a
# .must() failed, and since panel 230's R1 the place it was called at:
# `site`, the start of the `.must()` expression (`emit/stop_place.hero`).
function must_stop(@w: writer.Writer, s: source.Source, f: containers.Function, run: ir.Run, site: i64)
    writer.at_generated(@w)
    given = containers.args_of(f, run)

    if given.len() > 0
        handled: bool @= false

        match given[0]
            .value_arg v =>
                writer.line(
                    @w,
                    text: "    hero_panic_must_at(" + mangle.value(v.value) + ", " + stop_place.of(s, f, offset: site) + ");"
                )
                handled @ true
            .inout_arg => handled @ handled

        if handled
            return
    writer.line(@w, text: "    hero_unreachable(); /* a must with no failure */")

# A `match` that reached a case no arm names, in a program built with
# `--permissive` (panel 226's R1): the tag and the cases' names, so the
# runtime says `panic: this match has no arm for .dot` and never
# `hero_unreachable`'s *this is a compiler bug*, which is false of a
# program's own mistake, at the `match`'s place (panel 230's R1).
function unmatched_case_stop(@w: writer.Writer, s: source.Source, f: containers.Function, run: ir.Run, site: i64)
    writer.at_generated(@w)
    given = containers.args_of(f, run)
    tag: str @= ""
    names: str @= ""

    if given.len() == 2
        match given[0]
            .value_arg v => tag @ mangle.value(v.value)
            .inout_arg   => tag @ tag

        match given[1]
            .value_arg v => names @ mangle.value(v.value)
            .inout_arg   => names @ names

    if tag == "" || names == ""
        writer.line(@w, text: "    hero_unreachable(); /* an unmatched case with no tag */")
        return
    writer.line(
        @w,
        text: "    hero_panic_unmatched_case_at(" + tag + ", " + names + ", " + stop_place.of(s, f, offset: site) + ");"
    )

# The same for a `match` on an integer or a string that no arm took: an
# integer rendered as `print` renders it, and a `str` handed over as it is,
# which the runtime writes quoted, so the program's text can never pass for a
# line of the report (panel 230's R3, defect 2226).
function unmatched_value_stop(@w: writer.Writer, c: state.Checked, s: source.Source, f: containers.Function, run: ir.Run, site: i64)
    writer.at_generated(@w)
    given = containers.args_of(f, run)
    shown: str @= ""

    if given.len() == 1
        text_value = str_value(c, f, given[0])

        if text_value != ""
            writer.line(
                @w,
                text: "    hero_panic_unmatched_str_at(" + text_value + ", " + stop_place.of(s, f, offset: site) + ");"
            )
            return

        match given[0]
            .value_arg v =>
                entry = builtins.to_str_entry(table.get(c.types, containers.value_type(f, v.value)))

                if !entry.is_err()
                    shown @ entry.must() + "(" + mangle.value(v.value) + ")"
            .inout_arg => shown @ shown

    if shown == ""
        writer.line(@w, text: "    hero_unreachable(); /* an unmatched value with no rendering */")
        return
    writer.line(
        @w,
        text: "    hero_panic_unmatched_value_at(" + shown + ", " + stop_place.of(s, f, offset: site) + ");"
    )

# The C name of an operand that is a `str` value, or "" where it is anything
# else: the one question the two stops above ask before handing a program's
# text to the runtime as a value rather than as a rendering.
function str_value(c: state.Checked, f: containers.Function, arg: ir.Arg) -> str
    match arg
        .value_arg v =>
            if containers.value_type(f, v.value) == table.str_ty(c.types)
                return mangle.value(v.value)
            return ""
        .inout_arg => return ""

# assert (§4.18, spec § 12 Tests and holes: "shows the source expression, and
# both sides of a comparison"). The IR carries three operands where the
# asserted expression is a comparison and one where it is not. Since panel
# 230's R2 every type `==` accepts has a renderer (`emit/sides.hero`), handed to
# the runtime with the two sides' addresses, never their texts, so the report's
# head line and place are written before a renderer runs: a `str` quoted, a
# record as its construction, a container within the lldb formatter's bounds,
# so no side's text can pass for a line of the report (panel 230's R3). `equal`
# is an `==`'s, owed a line where its two sides are written alike. `site` is
# the asserted expression's start, the place the report names (R1).
function assert_stop(@w: writer.Writer, c: state.Checked, names: ctype.Names, s: source.Source, decls: [ast.Decl], f: containers.Function, run: ir.Run, site: i64, equal: bool)
    writer.at_generated(@w)
    given = containers.args_of(f, run)

    if given.len() == 0
        writer.line(@w, text: "    hero_unreachable(); /* an assert with no text */")
        return
    text_name: str @= ""

    match given[0]
        .value_arg v => text_name @ mangle.value(v.value)
        .inout_arg   => text_name @ text_name

    if text_name == ""
        writer.line(@w, text: "    hero_unreachable(); /* an assert with no text */")
        return

    if given.len() == 3
        left = side_of(c, f, given[1])
        right = side_of(c, f, given[2])

        if left != "" && right != ""
            alike: str @= "0"

            if equal
                alike @ "1"
            show = sides.renderer(c, names, s, decls, ty: side_type(f, given[1]))
            writer.line(
                @w,
                text: "    hero_panic_assert_shown_at(" + text_name + ", " + show + ", " + left + ", " + right + ", " + alike + ", " + stop_place.of(s, f, offset: site) + ");"
            )
            return

    writer.line(@w, text: "    hero_panic_assert_at(" + text_name + ", " + stop_place.of(s, f, offset: site) + ");")

# A side's address, as a renderer takes it: `NULL` for a unit, which no C value
# holds, or "" where the side is no value.
function side_of(c: state.Checked, f: containers.Function, arg: ir.Arg) -> str
    match arg
        .value_arg v =>
            if containers.value_type(f, v.value) == table.unit_ty(c.types)
                return "NULL"
            return "&" + mangle.value(v.value)
        .inout_arg => return ""

function side_type(f: containers.Function, arg: ir.Arg) -> i64
    match arg
        .value_arg v => return containers.value_type(f, v.value)
        .inout_arg   => return 0

    return 0

## Tests

test "a comparison hands the runtime its type's renderer and both sides' addresses (panel 230's R2)"
    text = "function main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    str_id = table.str_ty(c.types)
    int_id = table.int_ty_id(c.types)
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [str_id, int_id, int_id, str_id],
        arguments: [.value_arg(value: 0), .value_arg(value: 1), .value_arg(value: 2)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    w: writer.Writer @= writer.new_writer("t")
    names = ctype.new_names(s, parsed.decls)
    assert_stop(@w, c, names, s, parsed.decls, f, run: ir.Run(start: 0, length: 3), site: 20, equal: true)
    must_stop(@w, s, f, run: ir.Run(start: 0, length: 1), site: 20)
    got = writer.finish(w)

    # Both name the site, `print` at the second line's fifth column.
    # An `==`: its `1` asks for the line two sides written alike owe.
    assert got == "#line 2 \"t.c\"\n    hero_panic_assert_shown_at(t0, hero_show_i64, &t1, &t2, 1, \"t.hero\", \"t.t\", 2, 5);\n    hero_panic_must_at(t0, \"t.hero\", \"t.t\", 2, 5);\n"

test "two str sides are handed over by address and quoted by the runtime, an unmatched str as a value (panel 230's R2 and R3)"
    text = "function main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: state.Checked = checker.check(parsed.tree, out, s, parsed.decls)
    str_id = table.str_ty(c.types)
    f = containers.Function(
        name: "t",
        decl: 0,
        kind: .function_kind,
        generics: [],
        params: [],
        result: 0,
        slots: [],
        blocks: [],
        values: [str_id, str_id, str_id],
        arguments: [.value_arg(value: 0), .value_arg(value: 1), .value_arg(value: 2)],
        steps: [],
        instance: [],
        call_instances: {},
        instantiated_at: token.Span(start: 0, end: 0),
        span: token.Span(start: 0, end: 1)
    )
    w: writer.Writer @= writer.new_writer("t")
    names = ctype.new_names(s, parsed.decls)
    assert_stop(@w, c, names, s, parsed.decls, f, run: ir.Run(start: 0, length: 3), site: 0, equal: false)
    unmatched_value_stop(@w, c, s, f, run: ir.Run(start: 1, length: 1), site: 0)
    got = writer.finish(w)
    assert got == "#line 2 \"t.c\"\n    hero_panic_assert_shown_at(t0, hero_show_str, &t1, &t2, 0, \"t.hero\", \"t.t\", 1, 1);\n    hero_panic_unmatched_str_at(t1, \"t.hero\", \"t.t\", 1, 1);\n"
