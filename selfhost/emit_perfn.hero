# The per-type functions C cannot write for itself: which ones exist,
# and in what order (design.md §4.3, §4.10, §4.20; panel 022).
# Port of crates/heroes/src/emit/perfn.rs.
#
# THIS MODULE IS THE ORDER, NOT THE C. Each function's body lives with
# the invariant it serves — emit_counted for the two reference walks,
# emit_structural for eq and hash which must agree, emit_descriptors
# for the HeroDesc objects. What is left here is what nothing else can
# own: the prototypes, the traversal order, and the four functions of
# a T?.
#
# A variant contributes its CASE PAYLOADS FIRST and then itself, in
# that order and for the same reason the typedefs are ordered: the
# outer function calls the inner ones, and a case with fields IS a
# small record (§4.2), so it gets exactly what a record gets.

use ast
use source
use check_state
use ir_layout
use emit_ctype
use emit_types
use emit_counted
use emit_structural
use emit_descriptors
use emit_writer
use parse
use resolve
use checker

record GeneratedType
    at: emit_ctype.Aggregate
    counted: bool

# Every C type this pass generates functions for, in emission order,
# with whether it owns a counted reference.
function every_generated_type(c: check_state.Checked, names: emit_ctype.Names, decls: [ast.Decl]) -> [GeneratedType]
    out: [GeneratedType] @ []
    for decl in emit_types.aggregates(c, decls)
        if emit_types.is_variant(decls, decl: decl)
            case_at: i64 @ 0
            for one_case in emit_types.cases_of(decls, decl: decl)
                if one_case.fields.len() > 0
                    payload = emit_ctype.generated(emit_ctype.case_of(names, decl: decl, at: case_at))
                    out @ out.push(GeneratedType(at: payload, counted: emit_counted.owns_case(c, decls, decl: decl, at: case_at)))
                case_at @ case_at + 1
        out @ out.push(GeneratedType(at: emit_ctype.aggregate(names, decl: decl), counted: emit_counted.owns(c, decls, decl: decl)))
    return out

# Prototypes for every per-type function, before any body. All of them
# first, because h_T_eq on a nested aggregate calls the inner one and a
# variant's calls its cases': the typedefs are ordered so the TYPES are
# complete in time, and this makes the FUNCTIONS visible in time
# without depending on that order twice. The prototype takes the pair
# exactly as the body does — a prototype spelled from c_type alone
# declared Color_eq while the body defined h_rec_Color_eq: two
# functions, one never defined, and the reader sees undefined symbol
# about a name they did not write.
function prototypes(@w: emit_writer.Writer, c: check_state.Checked, names: emit_ctype.Names, decls: [ast.Decl])
    wrote: bool @ false
    for one in every_generated_type(c, names, decls)
        emit_writer.at_generated(@w)
        if one.counted
            emit_writer.line(@w, text: "void " + one.at.prefix + "_retain(const " + one.at.c_type + " *v);")
            emit_writer.line(@w, text: "void " + one.at.prefix + "_release(" + one.at.c_type + " *v);")
        emit_writer.line(@w, text: "bool " + one.at.prefix + "_eq(const " + one.at.c_type + " *a, const " + one.at.c_type + " *b);")
        emit_writer.line(@w, text: "uint64_t " + one.at.prefix + "_hash(const void *elem);")
        wrote @ true
    for entry in emit_ctype.option_entries(names, c)
        emit_writer.at_generated(@w)
        emit_writer.line(@w, text: "void " + entry.name + "_retain(const " + entry.name + " *v);")
        emit_writer.line(@w, text: "void " + entry.name + "_release(" + entry.name + " *v);")
        emit_writer.line(@w, text: "bool " + entry.name + "_eq(const " + entry.name + " *a, const " + entry.name + " *b);")
        emit_writer.line(@w, text: "uint64_t " + entry.name + "_hash(const void *elem);")
        wrote @ true
    if wrote
        emit_writer.blank(@w)

# The bodies. The payloads first: a case is a small record, so it gets
# exactly what a record gets.
function bodies(@w: emit_writer.Writer, c: check_state.Checked, names: emit_ctype.Names, s: source.Source, decls: [ast.Decl])
    for decl in emit_types.aggregates(c, decls)
        at = emit_ctype.aggregate(names, decl: decl)
        if emit_types.is_variant(decls, decl: decl)
            case_at: i64 @ 0
            for one_case in emit_types.cases_of(decls, decl: decl)
                if one_case.fields.len() > 0
                    payload = emit_ctype.generated(emit_ctype.case_of(names, decl: decl, at: case_at))
                    if emit_counted.owns_case(c, decls, decl: decl, at: case_at)
                        emit_counted.reference_body(@w, c, names, s, at: payload, fields: one_case.fields, keep: true)
                        emit_counted.reference_body(@w, c, names, s, at: payload, fields: one_case.fields, keep: false)
                    emit_structural.equality_body(@w, c, names, s, at: payload, fields: one_case.fields)
                    emit_structural.hash_body(@w, c, names, s, at: payload, fields: one_case.fields)
                case_at @ case_at + 1
            if emit_counted.owns(c, decls, decl: decl)
                emit_counted.variant_reference_body(@w, c, names, s, decls, decl: decl, at: at, keep: true)
                emit_counted.variant_reference_body(@w, c, names, s, decls, decl: decl, at: at, keep: false)
            emit_structural.variant_equality_body(@w, names, s, decls, decl: decl, at: at)
            emit_structural.variant_hash_body(@w, names, s, decls, decl: decl, at: at)
            continue
        fields = emit_types.fields_of(decls, decl: decl)
        if emit_counted.owns(c, decls, decl: decl)
            emit_counted.reference_body(@w, c, names, s, at: at, fields: fields, keep: true)
            emit_counted.reference_body(@w, c, names, s, at: at, fields: fields, keep: false)
        emit_structural.equality_body(@w, c, names, s, at: at, fields: fields)
        emit_structural.hash_body(@w, c, names, s, at: at, fields: fields)
    option_bodies(@w, c, names)

# The four functions for each T?. Every one switches on the tag,
# because the two sides are alternatives and touching the wrong one is
# reading a union member that was never written. The error side is
# ALWAYS counted (two strs), which is why every T? is counted whatever
# T is — i64? included.
function option_bodies(@w: emit_writer.Writer, c: check_state.Checked, names: emit_ctype.Names)
    for entry in emit_ctype.option_entries(names, c)
        counted = ir_layout.is_refcounted(c, entry.payload)
        has_ok = !emit_ctype.c_type(names, c: c, ty: entry.payload).is_err()
        emit_writer.at_generated(@w)
        one_reference(@w, c, names, name: entry.name, payload: entry.payload, counted: counted, has_ok: has_ok, keep: true)
        one_reference(@w, c, names, name: entry.name, payload: entry.payload, counted: counted, has_ok: has_ok, keep: false)
        # equality: different tags are never equal.
        emit_writer.line(@w, text: "bool " + entry.name + "_eq(const " + entry.name + " *a, const " + entry.name + " *b) {")
        emit_writer.line(@w, text: "    if (a->tag != b->tag) return false;")
        emit_writer.line(@w, text: "    if (a->tag != INT64_C(0)) return hero_failure_eq(&a->as.err, &b->as.err);")
        if has_ok
            desc = emit_descriptors.pointer(c, names, ty: entry.payload)
            if desc.is_err()
                emit_writer.line(@w, text: "    hero_unreachable();")
            else
                emit_writer.line(@w, text: "    return (" + desc.must() + ")->eq(&a->as.ok, &b->as.ok);")
        else
            # Two ()? that are both ok carry nothing to compare.
            emit_writer.line(@w, text: "    return true;")
        emit_writer.line(@w, text: "}")
        emit_writer.blank(@w)
        emit_writer.line(@w, text: "uint64_t " + entry.name + "_hash(const void *elem) {")
        emit_writer.line(@w, text: "    const " + entry.name + " *v = elem;")
        emit_writer.line(@w, text: "    uint64_t h = (UINT64_C(0xcbf29ce484222325) ^ (uint64_t)v->tag)")
        emit_writer.line(@w, text: "        * UINT64_C(0x100000001b3);")
        emit_writer.line(@w, text: "    if (v->tag != INT64_C(0)) {")
        emit_writer.line(@w, text: "        return (h ^ hero_failure_hash(&v->as.err)) * UINT64_C(0x100000001b3);")
        emit_writer.line(@w, text: "    }")
        if has_ok
            desc = emit_descriptors.pointer(c, names, ty: entry.payload)
            if desc.is_err()
                emit_writer.line(@w, text: "    hero_unreachable();")
            else
                emit_writer.line(@w, text: "    return (h ^ (" + desc.must() + ")->hash(&v->as.ok)) * UINT64_C(0x100000001b3);")
        else
            emit_writer.line(@w, text: "    return h;")
        emit_writer.line(@w, text: "}")
        emit_writer.blank(@w)

# One retain or release for a T?. The ok side goes through the SAME
# dispatch a record field gets, and NOT the descriptor's copy: a
# descriptor has copy(dst, src) and no retain-in-place, so going
# through it would mean copying the payload onto itself and casting
# away the const. One helper, two call sites, no cast.
function one_reference(@w: emit_writer.Writer, c: check_state.Checked, names: emit_ctype.Names, name: str, payload: i64, counted: bool, has_ok: bool, keep: bool)
    verb: str @ "release"
    if keep
        verb @ "retain"
    if keep
        emit_writer.line(@w, text: "void " + name + "_retain(const " + name + " *v) {")
    else
        emit_writer.line(@w, text: "void " + name + "_release(" + name + " *v) {")
    emit_writer.line(@w, text: "    if (v->tag == INT64_C(0)) {")
    if counted && has_ok
        found = emit_counted.reference_line(c, names, ty: payload, place: "v->as.ok", keep: keep)
        if found.is_err()
            emit_writer.line(@w, text: "        hero_unreachable();")
        else
            emit_writer.line(@w, text: "    " + found.must())
    else
        emit_writer.line(@w, text: "        return;")
    emit_writer.line(@w, text: "    } else {")
    emit_writer.line(@w, text: "        hero_failure_" + verb + "(&v->as.err);")
    emit_writer.line(@w, text: "    }")
    emit_writer.line(@w, text: "}")
    emit_writer.blank(@w)

## Tests

function has(text: str, needle: str) -> bool
    if needle.len() == 0
        return true
    stop = text.len() - needle.len()
    at: i64 @ 0
    while at <= stop
        if text.slice(from: at, to: at + needle.len()) == needle
            return true
        at @ at + 1
    return false

test "payloads come before their variant, and every option gets four functions"
    text = "variant Tok\n    word\n        text: str\n    plus\n\nrecord Holder\n    maybe: i64?\n\nfunction main()\n    t: Tok = .word(text: \"hi\")\n    h = Holder(maybe: ok(3))\n    _ = t\n    _ = h\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: check_state.Checked @ checker.check(p.tree, out, s, p.decls)
    assert c.diagnostics.len() == 0
    names0 = emit_ctype.new_names(s, p.decls)
    names = emit_ctype.with_options(names0, c: c, s: s, decls: p.decls)
    w: emit_writer.Writer @ emit_writer.new_writer("t")
    prototypes(@w, c, names, p.decls)
    protos = emit_writer.finish(w)
    assert has(text: protos, needle: "bool h_t_Tok_c_word_eq(const h_t_Tok_c_word *a, const h_t_Tok_c_word *b);")
    assert has(text: protos, needle: "void h_0opt_e201354_retain(const h_0opt_e201354 *v);")
    bw: emit_writer.Writer @ emit_writer.new_writer("t")
    bodies(@bw, c, names, s, p.decls)
    body_text = emit_writer.finish(bw)
    # The payload's eq is defined before the variant's, which calls it.
    payload_at: i64 @ 0 - 1
    outer_at: i64 @ 0 - 1
    scan: i64 @ 0
    stop = body_text.len() - 30
    while scan <= stop
        if body_text.slice(from: scan, to: scan + 30) == "bool h_t_Tok_c_word_eq(const h"
            if payload_at < 0
                payload_at @ scan
        if body_text.slice(from: scan, to: scan + 21) == "bool h_t_Tok_eq(const"
            if outer_at < 0
                outer_at @ scan
        scan @ scan + 1
    assert payload_at >= 0
    assert outer_at > payload_at
    # The i64? four: retain returns on ok (i64 is not counted), eq
    # reaches the payload through its descriptor.
    assert has(text: body_text, needle: "void h_0opt_e201354_retain(const h_0opt_e201354 *v) {")
    assert has(text: body_text, needle: "    return (&hero_desc_int)->eq(&a->as.ok, &b->as.ok);")
    assert has(text: body_text, needle: "        return (h ^ hero_failure_hash(&v->as.err)) * UINT64_C(0x100000001b3);")
