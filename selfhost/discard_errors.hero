# The rule that a computed value is received or explicitly discarded, and
# the messages that refuse every way of losing one.
#
# Split out of `value_errors.hero` on 2026-09-16, at M-check-completeness
# step 3, when that file passed its DECIDED ceiling of 334. **The seam is
# the family and never the line count**, which is what that ceiling's own
# ratification asked for: it says the file is not split because "cutting
# it by line count would put two messages of one family in two files".
# These five are one family — panel 003 made a non-`()` expression alone
# on a line an error, panel 017 C made a `()` value in binding position
# its mirror, and panel 118 closed the hole the deliberate discard left —
# and they move together with the `has` helper their tests need.
#
# The pair worth reading together is still `discarded_value` and
# `bound_unit`. Between them, a value is either received or explicitly
# discarded, and nothing is silently dropped.
#
# The checker side of this rule is `selfhost/check/discard.hero`, and where
# on its line a repair goes is `selfhost/statement_front.hero` (split out
# 2026-09-30, defect 135's lane, along that concern's own seam).
# Message text byte for byte with the Rust side, as everywhere in the port.

use token
use diag
use statement_front as front

# What else a line whose value nothing receives may have meant, each one
# read off the value in hand by `check/discard.hero` (defect 135). Every
# one is a second reading of the line, so where any holds, `_ = ` is a
# guess beside it and never certain.
record Readings
    # A place the value was computed from that holds the value's own type,
    # through a call's receiver or arguments in any spelling or through an
    # operator's operands: `xs` in `push(xs, 4)`, `b.items` in
    # `b.items.push(4)`, `total` in `total + x`. Every value here is a copy,
    # so its author may have meant to keep the result there.
    place: str?
    # The value is a `bool`: a decision nothing reads.
    decides: bool
    # The line is inside a `test`, which checks only what it asserts.
    in_test: bool
    # The line ends a function that returns a value, outside any loop.
    tail: bool
    # And the value has the very type that function returns.
    returns: bool

# No second reading at all, for a value whose line is its own business.
function no_readings() -> Readings
    none: str? = fail(code: "absent", msg: "no place of the value's own type")
    return Readings(place: none, decides: false, in_test: false, tail: false, returns: false)

# A line computed a value and nothing received it (panel 003).
#
# **`_ = ` is certain only where the discard is the one reading of the
# line** (defect 135, the coordinator's audit): a line kept for what a call
# does, its value the call's by-product. Each reading below is a program
# the author may have meant instead, measured on `check --apply` and `run`:
#
# - a place of the value's own type (panel 071, and the audit widened it
#   to every spelling): `push` returns the new array and leaves its
#   receiver alone, so `_ = push(xs, 4)`, `_ = b.items.push(4)` and
#   `_ = total + x` compile at exit 0 and lose what was computed;
# - a `bool`: `x == 5` alone is C's `x = 5` or a lost `if`, and a lost
#   check of a status; `_ = ` compiles and decides nothing;
# - a line in a `test`: `add(a: 1, b: 2) == 3` there lost its `assert`,
#   and `_ = ` turned a failing test into `1 test, all passed`;
# - the last line of a function that returns a value: `n * 2` there is
#   the `return` habit of an expression-bodied language, and `_ = ` left
#   `missing_return` standing.
#
# Each reading offers its own repair as a guess, and `_ = ` beside it.
#
# `fallible` DE-CERTIFIES the `_ = …` fix, and it is the third half of
# panel 118 rather than a refinement: once `_ = e` on a `T?` is refused,
# a `certain` fix inserting `_ = ` is a machine that writes programs the
# next pass rejects, and `heroes check --apply --in-place` was run on a
# bare `write_file(…)` and wrote exactly that. The repair is not to
# downgrade the fix to a guess — a guess that cannot compile is still
# wrong — but to withdraw it and say what does answer a failure.
#
# **A line that may be the rest of the one above takes no `certain` `_ = `**
# (panel 181, item 5; defect 120). `total = base` over `-fee` is refused
# here, and `_ = -fee` compiles and drops the term the author meant to
# subtract: the fix keeps the bug, so it is a `guess`
# (`.claude/rules/diagnostics-and-goldens.md`). The line begins with one of
# the four tokens that begin a value AND go on with one (panel 180's
# `line_end.begins_a_value`): `-`, `.`, `(`, `[`. The same shape with the
# `-` set apart never arrives here, since the lexer refuses it
# (`open_line`), and neither does a `?` or a `::`.
#
# `text` is the compilation's, which `span` indexes: the line's first byte
# is read there, because a value's span leaves out the parentheses around
# it, and `(5)` alone took `_ = ` as `(_ = 5)`, which does not parse (found
# by the same audit). A value that does not begin its line is an arm's
# inline body, and there `_ = ` and `x @ ` are written in a block one level
# under the arm. Until panel 185's R3 that was the one form, either refused
# on the arm's line as `declaration_in_arm`; since R3 spec § 8 lets both
# stand there too (*inline one statement, where a declaration or an `=` may
# name only `_`*), and the block is the one of the two this fix writes.
function discarded_value(got: str, fallible: bool, readings: Readings, span: token.Span, text: str) -> diag.Diagnostic
    at = front.before(text, at: span.start)
    first = text.slice(from: at.opening, to: at.opening + 1)
    continues = at.begins_line && (first == "-" || first == "." || first == "(" || first == "[")
    reading: str @ main_reading(readings)

    # `-fee` under `total = base` is the rest of that line, and the `fee` it
    # holds is the continuation's operand rather than a place to keep it in.
    if continues && reading == "place"
        reading @ ""
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "discarded_value",
        message: "this line's value has type `" + got + "` and nothing receives it",
        span: span
    )

    if fallible
        # A `T?` offers no `_ = ` (panel 118), so only a place is worth naming.
        if !readings.place.is_err()
            name = readings.place.must()
            d.message @ d.message + " — every value here is a copy, so `" + name + "` is unchanged: write `" + name + " @ …` to keep the result"
            d.fixes @ d.fixes.push(
                front.written(at, title: "assign it back to `" + name + "`", words: name + " @ ", statement: true, certainty: .guess)
            )
        d.message @ d.message + ", and `_ = …` will not do either: a `T?` may not be discarded"
        d.notes @ d.notes.push(
            "answer the error instead: `?` sends it to your caller, `.must()` ends the program, `.default(v)` falls back, `.is_err()` drops it on purpose"
        )
        return d

    if reading == "return"
        d.message @ d.message + " — it ends a function that returns `" + got + "`: write `return …`, or `_ = …` to discard it on purpose"
        d.fixes @ d.fixes.push(
            front.written(at, title: "return it", words: "return ", statement: false, certainty: .guess)
        )
    else if reading == "assert"
        d.message @ d.message + " — a `test` checks only what it asserts: write `assert …`, or `_ = …` to discard it on purpose"
        d.fixes @ d.fixes.push(
            front.written(at, title: "assert it", words: "assert ", statement: false, certainty: .guess)
        )
    else if reading == "place"
        name = readings.place.must()
        d.message @ d.message + " — every value here is a copy, so `" + name + "` is unchanged: write `" + name + " @ …` to keep the result, or `_ = …` to discard it on purpose"
        d.fixes @ d.fixes.push(
            front.written(at, title: "assign it back to `" + name + "`", words: name + " @ ", statement: true, certainty: .guess)
        )
    else
        d.message @ d.message + " — write `_ = …` to discard it on purpose"

    for thought in second_thoughts(readings, reading: reading)
        d.notes @ d.notes.push(thought)

    certainty: diag.Certainty @ .certain

    if reading != "" || readings.decides || readings.in_test || readings.tail || continues
        certainty @ .guess

    if continues
        d.notes @ d.notes.push(the_rest_of_the_line_above(first))
    d.fixes @ d.fixes.push(
        front.written(at, title: "discard it explicitly", words: "_ = ", statement: true, certainty: certainty)
    )
    return d

# The reading the message leads with, most likely first: a value a function
# ends on is what it returns, a `bool` in a test is what it asserts, and a
# value of a place's own type is what the place was meant to keep.
function main_reading(readings: Readings) -> str
    if readings.returns
        return "return"

    if readings.in_test && readings.decides
        return "assert"

    if !readings.place.is_err()
        return "place"
    return ""

# Why `_ = ` is a guess where the message names no other repair.
function second_thoughts(readings: Readings, reading: str) -> [str]
    out: [str] @ []

    if reading != ""
        return out

    if readings.decides
        out @ out.push(
            "a `bool` computed and dropped decides nothing: `if` and `assert` read one, and `@` writes a cell"
        )
    else if readings.in_test
        out @ out.push(
            "a `test` checks only what it asserts, and a value computed there and dropped is one no assertion reads"
        )
    else if readings.tail
        out @ out.push("it ends a function that returns a value, and a function's value is what it returns")
    return out

function the_rest_of_the_line_above(first: str) -> str
    return "a line that begins with `" + first + "` may be the rest of the line above, which ended its statement: outside brackets a long expression breaks after an operator, inside parentheses"

# The ways a `T?`'s error can be answered, listed for a reader who has
# just been refused (§4.17: everything needed without opening another
# file). Two things are decided per site rather than printed blindly:
# `?` is named only where the enclosing function can fail, because
# offering it elsewhere sends the reader to `try_in_infallible`; and
# `.default(v)` is named only where the payload is a value, because a
# `()?` has none to write — `.default(())` is `expected_expression`,
# which panel 118's blind reader found by trying it.
function answers(propagates: bool, has_payload: bool) -> str
    out: str @ ""

    if propagates
        out @ out + "`?` sends the failure to your caller, "
    out @ out + "`.must()` ends the program here, "

    if has_payload
        out @ out + "`.default(v)` falls back, "
    out @ out + "`.is_err()` drops the failure on purpose"

    if !propagates
        out @ out + " — `?` would need this function to return a `T?` itself"

    return out

# `_ = e` where `e` is a `T?` (§4.4, panel 118). Panel 003 made a
# non-`()` statement an error and named `_ = e` the deliberate discard;
# this is the hole that discard left, and it is the ONE place a failure
# goes missing without the type system noticing.
#
# EVERY FIX IS A GUESS, and that is the ruling rather than an omission
# (panel 118 R3, measured): the same line's three repairs print 1, 9
# and a panic, so `?` is not meaning-preserving, `.is_err()` preserves
# the bug, and `.must()` ends the program. A rule that exists to make a
# decision visible must not ship a repair that takes the decision.
function discarded_failure(got: str, propagates: bool, has_payload: bool, span: token.Span, value: token.Span) -> diag.Diagnostic
    after = token.Span(start: value.end, end: value.end)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "discarded_failure",
        message: "`_ =` would drop the error in this `" + got + "`, and that is the one discard the type system cannot see through — " + answers(propagates: propagates, has_payload: has_payload),
        span: span
    )

    if propagates
        d.fixes @ d.fixes.push(
            diag.Fix(title: "send the failure to your caller", replacement: "?", span: after, certainty: .guess)
        )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "end the program if it fails", replacement: ".must()", span: after, certainty: .guess)
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "drop the failure on purpose", replacement: ".is_err()", span: after, certainty: .guess)
    )
    return d

# The same rule at the other position a `_` reaches, and it was found
# by running rather than reading (panel 118): `function swallow(_: i64?)`
# with `swallow(risky(0 - 1))` checks, runs, exits 0, and the error is
# gone. A parameter is the WORSE half, because the line has nothing
# available on it: the value arrives already bound to a name that binds
# nothing, so `.is_err()` cannot be reached from here at all.
#
# One fix and it is a GUESS, because a Fix carries one replacement and
# the repair is two edits: name the parameter, then answer the error in
# the body. The sitting's blind reader called this repair `certain`; it
# is behaviour-identical, which is what that seat measured, and still
# not expressible as one edit.
function discarded_failure_parameter(got: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "discarded_failure",
        message: "a `_` parameter written `" + got + "` drops its error where nothing can answer it — `_` binds nothing, so the body cannot reach the value at all",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "give it a name, and answer the error in the body", replacement: "", span: span, certainty: .guess)
    )
    return d

# Panel 017 C: the mirror of the rule above. A `()` value binds to
# nothing, and the repair is to keep the call and drop the binding.
function bound_unit(name: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "bound_unit",
        message: "`" + name + "` would hold `()`, which is no value — keep the call and drop the binding",
        span: span
    )
    d.fixes @ d.fixes.push(diag.Fix(title: "remove `" + name + " = `", replacement: "", span: span, certainty: .guess))
    return d

## Tests

test "a discarded value splits on the place it was computed from, and certainty follows"
    span = token.Span(start: 20, end: 30)
    text = "function main()\n    xs.push(4)\n"
    bare = discarded_value(got: "[i64]", fallible: false, readings: no_readings(), span: span, text: text)
    assert bare.fixes.len() == 1
    assert bare.fixes[0].certainty == .certain
    assert bare.fixes[0].span.start == 20 && bare.fixes[0].span.end == 20
    kept: Readings @ no_readings()
    kept.place @ ok("xs")
    named = discarded_value(got: "[i64]", fallible: false, readings: kept, span: span, text: text)
    assert named.fixes.len() == 2
    assert named.fixes[0].certainty == .guess
    assert named.fixes[1].certainty == .guess
    assert named.fixes[0].replacement == "xs @ "

# Defect 120 and panel 181's audit: a line that may be the rest of the one
# above is never discarded by a `certain` fix, and the fix lands before the
# parentheses a value's span leaves out.
test "a line that begins like the rest of the line above takes only a guessed discard, at its first byte"
    text = "function main()\n    y = 1\n    (5)\n    -y\n    x\n"
    paren = discarded_value(
        got: "i64",
        fallible: false,
        readings: no_readings(),
        span: token.Span(start: 31, end: 32),
        text: text
    )
    assert paren.fixes[0].certainty == .guess
    assert paren.fixes[0].span.start == 30
    assert paren.notes.len() == 1
    minus = discarded_value(
        got: "i64",
        fallible: false,
        readings: no_readings(),
        span: token.Span(start: 38, end: 40),
        text: text
    )
    assert minus.fixes[0].certainty == .guess

    # And the `y` it negates is the continuation's operand, not a place.
    operand: Readings @ no_readings()
    operand.place @ ok("y")
    continued = discarded_value(
        got: "i64",
        fallible: false,
        readings: operand,
        span: token.Span(start: 38, end: 40),
        text: text
    )
    assert continued.fixes.len() == 1
    assert continued.fixes[0].replacement == "_ = "
    assert continued.message == "this line's value has type `i64` and nothing receives it — write `_ = …` to discard it on purpose"
    alone = discarded_value(
        got: "i64",
        fallible: false,
        readings: no_readings(),
        span: token.Span(start: 45, end: 46),
        text: text
    )
    assert alone.fixes[0].certainty == .certain
    assert alone.fixes[0].span.start == 45
    assert alone.notes.len() == 0

# Defect 135: each second reading makes `_ = ` a guess, and the one the
# message leads with offers its own repair first.
test "a bool, a line in a test and a function's last line each take `_ = ` as a guess"
    span = token.Span(start: 20, end: 26)
    text = "function main()\n    x == 5\n"
    decides: Readings @ no_readings()
    decides.decides @ true
    comparison = discarded_value(got: "bool", fallible: false, readings: decides, span: span, text: text)
    assert comparison.fixes.len() == 1
    assert comparison.fixes[0].certainty == .guess
    assert comparison.notes.len() == 1
    asserted: Readings @ decides
    asserted.in_test @ true
    lost = discarded_value(got: "bool", fallible: false, readings: asserted, span: span, text: text)
    assert lost.fixes.len() == 2
    assert lost.fixes[0].replacement == "assert "
    assert lost.fixes[0].certainty == .guess
    assert lost.fixes[1].certainty == .guess
    ending: Readings @ no_readings()
    ending.tail @ true
    ending.returns @ true
    ended = discarded_value(got: "i64", fallible: false, readings: ending, span: span, text: text)
    assert ended.fixes[0].replacement == "return "
    assert ended.fixes[1].certainty == .guess
    assert has(text: ended.message, needle: "it ends a function that returns `i64`")

# Inside an arm the discard is written as a block under the arm, the one of
# the two forms spec § 8 allows that this fix writes; a `return` stays where
# it is.
test "an arm's value is discarded in a block under the arm, and returned where it stands"
    text = "function main()\n    match n\n        0 => f(0)\n"
    span = token.Span(start: 41, end: 45)
    in_arm = discarded_value(got: "i64", fallible: false, readings: no_readings(), span: span, text: text)
    assert in_arm.fixes[0].certainty == .certain
    assert in_arm.fixes[0].span.start == 40 && in_arm.fixes[0].span.end == 41
    assert in_arm.fixes[0].replacement == "\n            _ = "
    ending: Readings @ no_readings()
    ending.tail @ true
    ending.returns @ true
    returned = discarded_value(got: "i64", fallible: false, readings: ending, span: span, text: text)
    assert returned.fixes[0].span.start == 41 && returned.fixes[0].replacement == "return "

# Panel 118's third half: once `_ = e` on a fallible is refused, the
# `_ = ` fix must not be OFFERED, let alone offered as `certain`, or
# `heroes check --apply` writes a program the next pass rejects.
test "a discarded FALLIBLE offers no `_ = ` at all, and says what answers an error instead"
    span = token.Span(start: 20, end: 30)
    text = "function main()\n    xs.push(4)\n"
    bare = discarded_value(got: "()?", fallible: true, readings: no_readings(), span: span, text: text)
    assert bare.fixes.len() == 0
    assert bare.notes.len() == 1
    assert bare.message == "this line's value has type `()?` and nothing receives it, and `_ = …` will not do either: a `T?` may not be discarded"
    kept: Readings @ no_readings()
    kept.place @ ok("xs")
    named = discarded_value(got: "[i64]?", fallible: true, readings: kept, span: span, text: text)
    assert named.fixes.len() == 1
    assert named.fixes[0].replacement == "xs @ "
    assert named.notes.len() == 1

test "the refusal of a discarded failure names only the answers that are reachable"
    span = token.Span(start: 4, end: 24)
    value = token.Span(start: 8, end: 24)

    # Inside a fallible function, with a payload: all four are offered.
    rich = discarded_failure(got: "i64?", propagates: true, has_payload: true, span: span, value: value)
    assert rich.code == "discarded_failure"
    assert rich.fixes.len() == 3
    assert rich.fixes[0].replacement == "?"
    assert rich.fixes[0].span.start == 24 && rich.fixes[0].span.end == 24
    assert rich.fixes[0].certainty == .guess
    assert rich.fixes[1].certainty == .guess
    assert rich.fixes[2].certainty == .guess

    # In `main` or a test, on a `()?`: `?` is not offered, because it
    # would send the reader to `try_in_infallible`, and `.default(v)` is
    # not named, because there is no `()` to write.
    poor = discarded_failure(got: "()?", propagates: false, has_payload: false, span: span, value: value)
    assert poor.fixes.len() == 2
    assert poor.fixes[0].replacement == ".must()"
    assert !has(text: poor.message, needle: "`.default(v)`")
    assert has(text: poor.message, needle: "`?` would need this function to return a `T?` itself")
    assert has(text: poor.message, needle: "`.must()` ends the program here")

test "a wildcard parameter of fallible type is refused where nothing on the line can answer"
    d = discarded_failure_parameter(got: "i64?", span: token.Span(start: 9, end: 10))
    assert d.code == "discarded_failure"
    assert d.fixes.len() == 1
    assert d.fixes[0].certainty == .guess
    assert has(text: d.message, needle: "`_` binds nothing")

# Substring, so a message assertion can name the clause it cares about
# rather than pinning a whole sentence that a later wording moves.
#
# BYTE BY BYTE AND NEVER BY SLICE, which is the opposite of the ten
# other `has` helpers in this compiler, and the difference is a panic.
# A slice that splits a character aborts (§4.9), and a sliding window
# lands inside one the moment the text is not ASCII: every one of those
# helpers searches emitted C and is safe by a premise nobody wrote
# down, while a diagnostic MESSAGE carries `—` and `…`. Measured here,
# by writing the slice version first: `panic: string slice splits a
# character`, twice, in this file's own tests. It moved here with the
# tests that need it on 2026-09-16, and `value_errors.hero` kept none.
function has(text: str, needle: str) -> bool
    if needle.len() == 0
        return true

    if needle.len() > text.len()
        return false
    stop = text.len() - needle.len()
    at: i64 @ 0

    while at <= stop
        same: bool @ true
        k: i64 @ 0

        while k < needle.len()
            if text[at + k] != needle[k]
                same @ false
                break
            k @ k + 1

        if same
            return true
        at @ at + 1

    return false
