# Which types need a HeroDesc, and what to call it (design.md §4.20;
# panel 022). Port of crates/heroes/src/emit/descriptors.rs' naming
# half — pointer and hash_call. The definitions writer arrives with
# descriptor_set, whose worklist it walks.
#
# The runtime works on an array through a descriptor because C has no
# generic copy, drop, comparison or hash — and it must be a DESCRIPTOR
# rather than a type-erased runtime that inspects values, because
# inspection would void the property this backend rests on: that clang
# type-checks every call.
#
# Five come from the runtime and are shared. The scalars, and — the one
# worth stating — a single descriptor for EVERY [T], whatever T is:
# copy, drop, eq and hash on an array all reach the element type
# through the header's own elem, so [[i64]] and [[str]] need one
# descriptor between them rather than one each.

use check_table
use check_state
use emit_ctype
use source
use parse
use resolve
use checker

# The C expression for a pointer to this type's descriptor, or absent
# where the backend has no representation — which the gate has already
# refused. Exhaustive on the WIDTH, not on "an int": a descriptor is a
# runtime object with a size in it, and sort.c dispatches on the
# pointer's identity — a second width silently sharing this one would
# compare and sort the wrong number of bytes (panel 042).
function pointer(c: check_state.Checked, names: emit_ctype.Names, ty: i64) -> str?
    match check_table.get(c.types, ty)
        .int_ty ik =>
            match ik.kind
                .i64 => return ok("&hero_desc_int")
                .i8 => return ok("&hero_desc_i8")
                .i16 => return ok("&hero_desc_i16")
                .i32 => return ok("&hero_desc_i32")
                .u8 => return ok("&hero_desc_u8")
                .u16 => return ok("&hero_desc_u16")
                .u32 => return ok("&hero_desc_u32")
                .u64 => return ok("&hero_desc_u64")
        .float_ty fk =>
            match fk.kind
                .f32 => return ok("&hero_desc_f32")
                .f64 => return ok("&hero_desc_f64")
        .bool => return ok("&hero_desc_bool")
        .str => return ok("&hero_desc_str")
        # One for all of them: see the module doc.
        .array => return ok("&hero_desc_array")
        .map => return ok("&hero_desc_map")
        # One for every function type, like the array's: a function
        # value owns nothing, so the four operations do not depend on
        # the signature.
        .function_ty => return ok("&hero_desc_func")
        # Every T? needs its own, because its payload is by value — and
        # so does the failure side, which the runtime ships.
        .fallible => return ok("&" + emit_ctype.option_of(names, ty: ty) + "_desc")
        .failure => return ok("&hero_desc_failure")
        .named n => return ok("&" + emit_ctype.satellite(names, decl: n.decl) + "_desc")
        .case_ty vc => return ok("&" + emit_ctype.case_of(names, decl: vc.decl, at: vc.at) + "_desc")
        .ptr | .cstr | .unit | .fixed | .generic | .error => return fail("none", "no descriptor for this type")
    return fail("none", "unreached")

# The C expression that hashes one value at `place`. NOT
# descriptor->hash for an aggregate, and the difference is real: a
# descriptor exists only for a type used as an array ELEMENT, while
# hash is generated for every aggregate. record Rect { corner: Point }
# hashes a Point no array holds, and going through a descriptor there
# is `use of undeclared identifier 'h_m_Point_desc'` — measured on the
# gallery's own second program.
function hash_call(c: check_state.Checked, names: emit_ctype.Names, ty: i64, place: str) -> str?
    match check_table.get(c.types, ty)
        .named n => return ok(emit_ctype.satellite(names, decl: n.decl) + "_hash(" + place + ")")
        .case_ty vc => return ok(emit_ctype.case_of(names, decl: vc.decl, at: vc.at) + "_hash(" + place + ")")
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => return through_pointer(c, names, ty: ty, place: place)
        .array | .fixed | .map | .fallible | .function_ty => return through_pointer(c, names, ty: ty, place: place)
        .failure | .generic | .error => return through_pointer(c, names, ty: ty, place: place)
    return fail("none", "unreached")

function through_pointer(c: check_state.Checked, names: emit_ctype.Names, ty: i64, place: str) -> str?
    desc = pointer(c, names, ty: ty)
    if desc.is_err()
        return fail("none", "no descriptor for this type")
    return ok("(" + desc.must() + ")->hash(" + place + ")")

## Tests

test "widths get their own descriptors, and an aggregate hashes by its function"
    text = "record Point\n    x: i64\n\nfunction main()\n    _ = Point(x: 1)\n"
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: check_state.Checked @ checker.check(p.tree, out, s, p.decls)
    names = emit_ctype.new_names(s, p.decls)
    assert pointer(c, names, ty: check_table.int_ty_id(c.types)).must() == "&hero_desc_int"
    assert pointer(c, names, ty: check_table.str_ty(c.types)).must() == "&hero_desc_str"
    assert pointer(c, names, ty: check_table.unit_ty(c.types)).is_err()
    point = check_table.lookup(c.types, .named(decl: 0)).must()
    assert pointer(c, names, ty: point).must() == "&h_t_Point_desc"
    assert hash_call(c, names, ty: point, place: "&v->f_p").must() == "h_t_Point_hash(&v->f_p)"
    assert hash_call(c, names, ty: check_table.int_ty_id(c.types), place: "&v->f_n").must() == "(&hero_desc_int)->hash(&v->f_n)"
