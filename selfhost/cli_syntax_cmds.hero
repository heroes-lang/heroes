# heroes parse and heroes fmt — the two commands whose whole input is
# the tree (design.md §3.5, §4.15). Port of
# crates/heroes-cli/src/commands/{parse,fmt}.rs, one module because
# each is a page and they share the refusal that matters.
#
# BOTH REFUSE A FILE WITH DIAGNOSTICS before doing their work: a tree
# built out of recovery guesses reads like a fact and is not one, and
# a formatter that proceeds rewrites the author's program into the
# parser's guess about it — the one thing a formatter must never do.

use source
use source_extent
use diag
use parse
use print_dump
use print_fmt
use cli_table
use cli_argv
use cli_io

# heroes parse <file.hero> [--dump-ast]: without the flag a syntax
# check, silent on success; with it the tree — but only when the file
# is clean.
function run_parse(s: source.Source, inv: cli_argv.Invocation) -> cli_table.Exit
    out = parse.parse_source(s)
    for d in out.diagnostics
        cli_io.eprint(text: diag.render_line(d, s))
    if out.diagnostics.len() > 0
        return .diagnostics_exit
    if cli_argv.has(inv, spelling: "--dump-ast")
        cli_io.print_artifact(text: print_dump.dump_ast(out.tree, s, out.uses, out.decls))
    return .ok_exit

# heroes fmt <file.hero> [--in-place]: stdout by default like gofmt;
# --in-place rewrites the file and prints nothing — and an
# already-canonical file is NOT rewritten, so its mtime does not move.
function run_fmt(path: str, s: source.Source, inv: cli_argv.Invocation) -> cli_table.Exit
    out = parse.parse_source(s)
    if out.diagnostics.len() > 0
        for d in out.diagnostics
            cli_io.eprint(text: diag.render_line(d, s))
        cli_io.eprint(text: "error: refusing to format a file with diagnostics")
        return .diagnostics_exit
    formatted = print_fmt.format_file(out.tree, s, out.comments, out.uses, out.decls)
    refusal = refuse_output_the_formatter_broke(path: path, formatted: formatted)
    if !refusal.is_err()
        cli_io.eprint(text: "error: " + refusal.must())
        cli_io.eprint(text: "error: this is a compiler bug — `" + path + "` was NOT changed")
        return .failed_exit
    if !cli_argv.has(inv, spelling: "--in-place")
        cli_io.print_artifact(text: formatted)
        return .ok_exit
    if formatted == source_extent.user_text(s)
        return .ok_exit
    written = write_file(path: path, text: formatted)
    if written.is_err()
        cli_io.eprint(text: "error: cannot write `" + path + "`")
        return .failed_exit
    return .ok_exit

# THE OUTPUT GUARD. `fmt` checked that its INPUT parsed and never looked
# at what it wrote, so it deleted seven arms out of a compiler source
# file at exit 0 (docs/defects/003, the third instance of this class
# after panels 014 and 060/061 — every one found by a person).
#
# Two checks. The output must PARSE, because a formatter that emits
# source the parser refuses has produced a non-program. And formatting
# it again must give the same text, because a canonical form that is not
# a fixpoint is not canonical.
#
# WHAT THIS DOES NOT CATCH is output that parses and means something
# else — panel 061's deleted `partial`. That is `assert_canonical`,
# `dump(text) == dump(fmt(text))`, which the port never brought over,
# and it is still owed. The two are different properties and this one is
# the weaker: do not read a green guard here as the tree being safe.
#
# Every failure is the COMPILER's (§7): exit 2, author's file untouched.
function refuse_output_the_formatter_broke(path: str, formatted: str) -> str?
    reparsed = parse.parse(formatted)
    if reparsed.diagnostics.len() > 0
        out = source.new_source(name: path, text: formatted)
        return ok("`fmt` produced source that does not parse: " + diag.render_line(reparsed.diagnostics[0], out))
    twice = print_fmt.format_file(reparsed.tree, source.new_source(name: path, text: formatted), reparsed.comments, reparsed.uses, reparsed.decls)
    if twice != formatted
        return ok("`fmt` is not a fixpoint on its own output for `" + path + "`")
    return fail("clean", "the output parses and is a fixpoint")

## Tests

test "parse checks silently, dumps only a clean tree, and fmt round-trips"
    text = "function main()\n    print(2 + (3 * 4))\n"
    s = source.new_source(name: "t.hero", text: text)
    inv = cli_argv.Invocation(tag: .parse_cmd, file: ok("t.hero"), program_args: [], flags: [])
    assert run_parse(s, inv) == .ok_exit
    # A broken file exits 1 through the same door.
    bad = source.new_source(name: "t.hero", text: "function main(\n    print(1)\n")
    assert run_parse(bad, inv) == .diagnostics_exit
    # fmt to a real file: --in-place canonicalises once, then leaves
    # the canonical file alone.
    messy = "function main()\n    print(2 + (3 * 4))\n"
    _ = write_file(path: "build/selftest_fmt.hero", text: messy)
    fs = source.new_source(name: "build/selftest_fmt.hero", text: messy)
    in_place: [cli_argv.FlagHit] = [cli_argv.FlagHit(spelling: "--in-place", value: fail("none", "no value"))]
    finv = cli_argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt.hero"), program_args: [], flags: in_place)
    assert run_fmt(path: "build/selftest_fmt.hero", s: fs, inv: finv) == .ok_exit
    canon = read_file("build/selftest_fmt.hero").must()
    assert canon == "function main()\n    print(2 + 3 * 4)\n"
    # And the refusal: a file with diagnostics is not touched.
    _ = write_file(path: "build/selftest_fmt.hero", text: "function main(\n")
    bs = source.new_source(name: "build/selftest_fmt.hero", text: "function main(\n")
    assert run_fmt(path: "build/selftest_fmt.hero", s: bs, inv: finv) == .diagnostics_exit
    assert read_file("build/selftest_fmt.hero").must() == "function main(\n"

# §9: a verifier check gets a test that makes it FIRE, and this one
# fires on a shape the printer still cannot spell — a `match` as the
# LEFT operand with the expression continuing after its block. That
# program is legal Heroes (`heroes check` exits 0 on it), so this is the
# printer's hole and not the author's mistake. Before the guard, `fmt`
# wrote the header alone at exit 0 and destroyed the file. When the
# printer learns the shape, the expectation here becomes `.ok_exit` and
# the guard keeps its job over everything else.
test "fmt refuses to write output it cannot parse back, and leaves the file alone"
    unspellable = "function f(c: str) -> str\n    return match c\n        \"a\" => \"b\"\n        _ => c\n    + \"x\"\n"
    _ = write_file(path: "build/selftest_fmt_guard.hero", text: unspellable)
    gs = source.new_source(name: "build/selftest_fmt_guard.hero", text: unspellable)
    hits: [cli_argv.FlagHit] = [cli_argv.FlagHit(spelling: "--in-place", value: fail("none", "no value"))]
    ginv = cli_argv.Invocation(tag: .fmt_cmd, file: ok("build/selftest_fmt_guard.hero"), program_args: [], flags: hits)
    assert run_fmt(path: "build/selftest_fmt_guard.hero", s: gs, inv: ginv) == .failed_exit
    # The whole point: the author's file is byte-for-byte untouched.
    assert read_file("build/selftest_fmt_guard.hero").must() == unspellable
