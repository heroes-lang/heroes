# The names no file may declare — design.md §4.20's consolidated inventory,
# which is also Principle 0's library closure list (§1.0), split by §1.11's
# two tiers.
# Port of archive/bootstrap-rs/heroes/src/resolve/builtins.rs.
#
# **The tier says where the implementation comes from, not whether the name
# is taken.** Every name here is reserved everywhere: at the top level, as a
# parameter, as a local (panel 015 — one tier of reservation, one rule, zero
# spec tokens).
#
# Two names are deliberately ABSENT, and their absence is a rejection that
# can be relaxed later rather than an acceptance that cannot be withdrawn:
# `panic` (Part 5 desugars `assert` into it; the spec offers the user
# `assert`) and `Builder` (a runtime type behind `join`, not surface).
#
# `fail` is here because `fail("code", "msg")` has to resolve to something,
# but its RESERVATION is enforced one stage earlier: it is a lexer keyword,
# so a declaration named `fail` never reaches the resolver.
#
# ## Port finding: the order is identity, and the Rust comment lied twice
#
# `Ref`'s builtin case carries an INDEX into this table, so the order is
# meaning and the port copies it verbatim — including its two departures
# from alphabetical order (`args` before `any`, `keys` before `is_err`).
# The Rust doc said "sorted by name" above a table that is not, and
# "thirty-five entries" above thirty-seven: two counts in prose that expired
# in silence, which is CLAUDE.md §11's own class. The claims are deleted on
# both sides rather than corrected; `index_of` searches linearly, so nothing
# ever depended on the sorting.

## The two tiers

# Where a built-in's implementation lives (§1.11). Not a permission level:
# both tiers are equally reserved.
variant Tier
    # Tier 1 — the C runtime. The language cannot express these: `print`
    # takes any number of arguments and renders them canonically, and the
    # emitter recognises it by name.
    runtime
    # Tier 2 — written in Heroes itself, the payoff from generics (§4.12).
    # Real source in one prelude; a USER file still may not redeclare them.
    heroes

record Builtin
    name: str
    tier: Tier

## The inventory

function table() -> [Builtin]
    return [
        Builtin(name: "all", tier: .heroes)
        Builtin(name: "args", tier: .heroes)
        Builtin(name: "any", tier: .heroes)
        Builtin(name: "chars", tier: .runtime)
        Builtin(name: "cstr", tier: .runtime)
        Builtin(name: "default", tier: .heroes)
        Builtin(name: "exit", tier: .heroes)
        Builtin(name: "fail", tier: .runtime)
        Builtin(name: "filter", tier: .heroes)
        Builtin(name: "find", tier: .heroes)
        Builtin(name: "fold", tier: .heroes)
        Builtin(name: "keys", tier: .runtime)
        Builtin(name: "is_err", tier: .heroes)
        Builtin(name: "join", tier: .runtime)
        Builtin(name: "len", tier: .runtime)
        Builtin(name: "map", tier: .heroes)
        Builtin(name: "must", tier: .heroes)
        Builtin(name: "ok", tier: .runtime)
        Builtin(name: "print", tier: .runtime)
        Builtin(name: "push", tier: .runtime)
        Builtin(name: "range", tier: .heroes)
        Builtin(name: "read_file", tier: .heroes)
        Builtin(name: "repeat", tier: .runtime)
        Builtin(name: "slice", tier: .runtime)
        Builtin(name: "sort", tier: .runtime)
        Builtin(name: "to_f32", tier: .runtime)
        Builtin(name: "to_f64", tier: .runtime)
        Builtin(name: "to_i16", tier: .runtime)
        Builtin(name: "to_i32", tier: .runtime)
        Builtin(name: "to_i64", tier: .runtime)
        Builtin(name: "to_i8", tier: .runtime)
        Builtin(name: "to_str", tier: .runtime)
        Builtin(name: "to_u16", tier: .runtime)
        Builtin(name: "to_u32", tier: .runtime)
        Builtin(name: "to_u64", tier: .runtime)
        Builtin(name: "to_u8", tier: .runtime)
        Builtin(name: "write_file", tier: .heroes)
        Builtin(name: "lease", tier: .runtime)
        Builtin(name: "end_lease", tier: .runtime)
    ]

# The banner, and only the banner (panel 054): the one program
# measurement 007 found NO route to without it.

# Eight width conversions sharing the one scheme (panel 017's rule,
# author decision 2026-08-13): `to_<T>` is fallible exactly when
# converting TO `T` can fail, so `to_str`/`to_f32`/`to_f64` hand
# back a plain value and `to_i8` … `to_u64` hand back a `T?`.

# The table index a `Ref`'s builtin case carries, or absent when the name is
# free. Linear search: the table needs no index of its own, and every list
# the compiler shows stays in the table's one deterministic order.
function index_of(name: str) -> i64?
    entries = table()
    i: i64 @ 0

    while i < entries.len()
        if entries[i].name == name
            return ok(i)
        i @ i + 1

    return fail(code: "free", msg: "no built-in has this name")

## The two signatures whose labels are mandatory (§4.9)

# §4.9's same-typed-argument rule needs a parameter NAME per position, and a
# Tier-1 built-in has no declaration to read one from: `Builtin` above is a name
# and a tier, and `check/builtins.hero` states the type rules as hand-written
# code rather than as a signature table. So the built-ins whose signature has
# two parameters of ONE type carry their parameter names here, beside the table
# that already enumerates every name.
#
# **A premise about the world, written as a falsifiable claim**
# (`.claude/rules/module-shape.md`): these two are the ONLY entries of `table()`
# with two parameters of one type. `join`, `repeat` and `push` mix their types,
# `print` is variadic, every conversion and every lease form takes one argument.
# A built-in that grows a same-typed pair and no row here goes on being accepted
# positionally in silence, and the instrument that can catch it is `spec § 11`'s
# own signature table rather than anything in this file.
record Labelled
    name: str
    # One name per argument position, the receiver's included and empty:
    # `xs.slice(1, 3)`'s receiver IS its position (§4.11), so nothing is
    # written for it, and `slice(xs, 1, 3)` names the same two.
    params: [str]
    # The type those positions share, as the diagnostic pronounces it.
    shared: str

function labelled() -> [Labelled]
    return [
        Labelled(name: "fail", params: ["code", "msg"], shared: "str")
        Labelled(name: "slice", params: ["", "from", "to"], shared: "i64")
    ]

# The entry for a built-in, or absent when its arguments need no labels.
function labelled_of(name: str) -> Labelled?
    for entry in labelled()
        if entry.name == name
            return ok(entry)

    return fail(code: "free", msg: "this built-in has no two parameters of one type")

## Tests

test "a reserved name answers with its index, a free one with absence"
    assert index_of("print").must() == 18
    assert index_of("to_u8").must() == 35
    assert index_of("panic").is_err()
    assert index_of("Builder").is_err()
    assert index_of("banner").is_err()

test "the inventory is thirty-nine names and the order is identity"
    entries = table()

    # 37 -> 39 on 2026-09-09: `lease` and `end_lease`, §4.19's fourth case
    # (panel 124), appended at the END so that no existing index moved.
    assert entries.len() == 39
    assert entries[37].name == "lease"
    assert entries[38].name == "end_lease"

    # The two deliberate departures from alphabetical order, pinned so a
    # helpful future sort is caught: the index is meaning, not presentation.
    assert entries[1].name == "args"
    assert entries[2].name == "any"
    assert entries[11].name == "keys"
    assert entries[12].name == "is_err"

test "the tier says where the implementation lives"
    entries = table()
    assert entries[index_of("print").must()].tier == .runtime
    assert entries[index_of("map").must()].tier == .heroes
    assert entries[index_of("fail").must()].tier == .runtime

test "the two same-typed signatures carry their parameter names"
    assert labelled_of("fail").must().params[0] == "code"
    assert labelled_of("fail").must().params[1] == "msg"
    assert labelled_of("fail").must().shared == "str"

    # The receiver's position is empty, and the two bounds are named.
    assert labelled_of("slice").must().params[0] == ""
    assert labelled_of("slice").must().params[1] == "from"
    assert labelled_of("slice").must().params[2] == "to"

    # The claim above, asserted on the names it is about: a built-in that
    # mixes its types is not here.
    assert labelled_of("join").is_err()
    assert labelled_of("repeat").is_err()
    assert labelled_of("push").is_err()
    assert labelled_of("print").is_err()
    assert labelled_of("to_u8").is_err()
