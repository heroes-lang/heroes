# Owned lexing state — position, layout, output — and the two ways a token
# enters the stream. Port of the LexState half of archive/bootstrap-rs/heroes/src/lexer/mod.rs;
# the drive loop (`lex`, `lex_one`) arrives with the scanners that feed it.
#
# The source text is a parameter everywhere and never a field (the Cyclone
# rule, kept across the port: tokens point into the source by byte offset).
#
# Port notes:
# - Rust's `last_significant: Option<TokenKind>` is a `TokenKind?` field: the
#   "no significant token yet" state is the fail value, and the reader asks
#   `.is_err()` where Rust asked `.is_some()`.
# - Arrays have no `pop`: the saturating pop on a stray closer is a `slice`
#   to len-1 behind a length test — same recovery, the emptiness check now
#   visible at the site.
# - `push` is a built-in name and cannot be redeclared, so the token-emitting
#   half of Rust's `push` is `emit` here.

use token
use diag
use text_outline
use swap_words

## Error codes

constant ERR_NO_SIGNIFICANT: str
    "no_significant_token"

## The state

# A depth-zero line break `open_line` refused (panel 181): the index in
# `diagnostics` of its refusal, and the index in `tokens` of the first token
# after the break, which is the next one pushed because nothing is planted
# while the lexer joins. `head` when the line below began with the token that
# can only go on, so that token is the operator the join writes; else the
# line above ended with it, just before `after`. `line_joins` weighs the
# joins from these once the file is lexed (defect 129). `diagnostic` is -1 for
# a line left open that the lexer ends rather than refuses, before a fresh
# statement or at the file's end: the parser says what it lacks, no join
# repairs it, and it weighs as a break with no join. `statement` names the
# statement the break is one of, the `after` of its first break, set when
# `line_joins` groups them; `parse/apart` makes one statement's joins a
# `guess` together, as `line_joins` does (defect 132).
record Break
    diagnostic: i64
    after: i64
    head: bool
    statement: i64

# An indentation habit being read (`indent_runs.hero`, ruling 5): a run of
# lines whose margins hold a tab, or that indent two spaces a level, told as
# one mistake and laid out as its fix writes it.
variant RunKind
    none
    tabs
    two

record IndentRun
    kind: RunKind
    # `two`: the margin the run's lines stand deeper than, four times the
    # level of the line above its first.
    base: i64
    # `tabs`: the columns every margin of the run is read deeper by, and
    # whether its first line with words has decided them.
    shift: i64
    decided: bool
    # The start of the run's first line, and of the last line it holds.
    first: i64
    last: i64
    # The index in `diagnostics` of the run's one message.
    said: i64
    # Whether every line the run holds maps one to one onto a level.
    sure: bool
    # The margins its fix rewrites so far.
    fixes: [diag.Fix]

# A body in braces the lexer reads as laid out (`brace_layout.hero`, ruling
# 1): the level of its head's line, and whether a line of it has stood deeper,
# before which a line at that level is the body at its head's own margin.
record Braces
    level: i64
    deeper: bool

function no_run() -> IndentRun
    none: [diag.Fix] = []
    return IndentRun(
        kind: .none,
        base: 0,
        shift: 0,
        decided: false,
        first: -1,
        last: -1,
        said: -1,
        sure: true,
        fixes: none
    )

record LexState
    pos: i64
    # Current indentation level (one level == 4 spaces).
    level: i64
    # Spans of the openers ( [ { not yet closed; its length is the bracket
    # depth. Inside brackets, indentation is not structural (panel 007).
    open_brackets: [token.Span]
    # One entry per interpolation hole still open, holding `open_brackets`'s
    # length at the moment the hole opened: a `}` closes the hole only when the
    # depth is back to that number, which is how a map literal or a nested
    # call inside a hole costs the scan nothing (panel 121 R1; `lex_interp`).
    holes: [i64]
    tokens: [token.Token]
    diagnostics: [diag.Diagnostic]
    # Kind of the current line's last significant (non-comment) token — the
    # one datum terminator insertion needs (layout.hero).
    last_significant: token.TokenKind?
    # A depth-zero line whose end is not its statement's end (panel 181,
    # `open_line.hero`): the index in `tokens` of its last significant token,
    # and the offset of the line end after it. -1 when the last line with
    # words ended its statement.
    open_line: i64
    open_end: i64
    # A depth-zero line that ended with a value owes its terminator until the
    # next line with words says it begins a statement (`open_line`): the
    # offset of that line end, -1 when none is owed. The comment lines read
    # meanwhile are `held`, so they follow the terminator as they always did.
    owed: i64
    held: [token.Token]
    # Every break refused so far, in the order refused (`Break`).
    breaks: [Break]
    # The lines read APART (`lexer.lex_apart`, defect 132): where this lexer
    # would refuse a break and join it, it ends the line there instead and
    # reads the next one's margin. A head that can only go on is the break
    # itself, so its first byte is kept in `heads`, and the token that starts
    # there is left out of the stream.
    apart: bool
    heads: [i64]
    # Read apart and as BODIES (`lexer.lex_bodies`, defect 132): a line below a
    # break at the margin of the line above is read one level deeper, as the
    # body of the head that line may be. `deeper` is that request, from the
    # break to the margin of the line it stands before.
    bodies: bool
    deeper: bool
    # Where every bracket still open was named never closed before the file's
    # end: the offset of each line at column 0 that opens a declaration inside
    # brackets (`layout.close_brackets`), ascending. The parser is told them,
    # so it names no closer the lexer named and reads the declaration as one.
    closes: [i64]
    # A literal that never closed ran to this line's end (`literals.swallow`),
    # so the line end is a line end at any depth.
    swallowed: bool
    # A `\` that asks its line to go on (`backslash.hero`): the index in
    # `diagnostics` of its one message, whose fix the line below decides, and
    # -1 when the line holds none or that decision is taken.
    backslash: i64
    # The text's outline, read at the first foreign word that opens its line
    # and asks where it stands (`text_outline.hero`, defect 146): one pass for
    # the file, where a walk per word cost the file's square.
    outline: text_outline.Outline
    # Every certain swap written for a word this lexer refused, where the word
    # begins, ascending (`swap_words.hero`): what the parser reads the word as.
    swaps: [swap_words.Swap]
    # The indentation habit being read (`indent_runs.hero`), always one: held
    # in an array so that the state every lexing call copies in and out grows
    # by one pointer, which a line with no habit never reads past. Measured
    # 2026-10-01 on a busy machine, `heroes lex selfhost/main.hero`: held
    # inline the record cost 3 to 6% of the lexer's time, behind the pointer
    # nothing that six runs could tell from the noise.
    run: [IndentRun]
    # Each body in braces open, innermost last: a `{` the lexer reads as the
    # end of its head's line, no bracket (`brace_layout.hero`).
    braced: [Braces]
    # The line ends in the text before `counted_to`, `line_ends` of them, for
    # a message that names a line (`line_of`): counted forward from where the
    # last count stopped, so a file's lines are read once however many
    # messages name one, where a count from the first byte per message cost
    # a file of `print(x` lines its square.
    counted_to: i64
    line_ends: i64

function new_state() -> LexState
    brackets: [token.Span] = []
    holes: [i64] = []
    tokens: [token.Token] = []
    diagnostics: [diag.Diagnostic] = []
    held: [token.Token] = []
    breaks: [Break] = []
    heads: [i64] = []
    closes: [i64] = []
    swaps: [swap_words.Swap] = []
    runs: [IndentRun] = [no_run()]
    braced: [Braces] = []
    return LexState(
        pos: 0,
        level: 0,
        open_brackets: brackets,
        holes: holes,
        tokens: tokens,
        diagnostics: diagnostics,
        last_significant: fail(code: ERR_NO_SIGNIFICANT, msg: "no significant token yet"),
        open_line: -1,
        open_end: -1,
        owed: -1,
        held: held,
        breaks: breaks,
        apart: false,
        heads: heads,
        bodies: false,
        deeper: false,
        closes: closes,
        swallowed: false,
        backslash: -1,
        outline: text_outline.unread(),
        swaps: swaps,
        run: runs,
        braced: braced,
        counted_to: 0,
        line_ends: 0
    )

# The 1-based line of the text that holds the offset `at`. The lexer asks in
# reading order, so the count goes on from the last one; asked of an offset
# before it, the count starts again from the first byte, slower and as true.
function line_of(@l: LexState, text: str, at: i64) -> i64
    if at < l.counted_to
        l.counted_to @ 0
        l.line_ends @ 0
    i: i64 @ l.counted_to

    while i < at && i < text.len()
        if text[i] == '\n'
            l.line_ends @ l.line_ends + 1
        i @ i + 1

    l.counted_to @ i
    return l.line_ends + 1

## Emitting

# A body's `{` (`brace_layout.hero`): a token, and no bracket opened; and the
# `}` that closes it on a line that goes on past it, no bracket closed.
function emit_open_body(@l: LexState, start: i64)
    push_token(@l.tokens, token.Token(kind: .lbrace, span: token.Span(start: start, end: l.pos)))
    l.last_significant @ ok(.lbrace)

function emit_close_body(@l: LexState, start: i64)
    push_token(@l.tokens, token.Token(kind: .rbrace, span: token.Span(start: start, end: start + 1)))
    l.last_significant @ ok(.rbrace)

# Emit one token and remember it for terminator insertion. Bracket depth is
# tracked here, where the kind is known — so brackets inside string literals
# can never touch it.
function emit(@l: LexState, kind: token.TokenKind, start: i64)
    span = token.Span(start: start, end: l.pos)

    if kind == .lparen || kind == .lbracket || kind == .lbrace
        l.open_brackets @ l.open_brackets.push(span)

    if kind == .rparen || kind == .rbracket || kind == .rbrace
        # Saturating pop: a stray closer never corrupts the following layout;
        # the parser reports it.
        if l.open_brackets.len() > 0
            l.open_brackets @ l.open_brackets.slice(from: 0, to: l.open_brackets.len() - 1)
    push_token(@l.tokens, token.Token(kind: kind, span: span))
    l.last_significant @ ok(kind)

# **The array is the parameter, and that is the whole reason this
# function exists** (§4.10, measured 2026-08-26). Written inline as
# `l.tokens @ l.tokens.push(t)` this is a FIELD place, and the in-place
# store fires on a BARE place only — so every token appended copied the
# whole token array, and lexing was quadratic in the token count. Taking
# the array itself makes the parameter a bare place, which is the same
# repair `ast.push_expr` took the day before, and CLAUDE.md §1's fourth
# clause is why it is applied here rather than left for the profile to
# find twice.
function push_token(@tokens: [token.Token], t: token.Token)
    tokens @ tokens.push(t)

# The same spelling for the diagnostics (defect 103), and for the same reason:
# `l.diagnostics @ l.diagnostics.push(d)` is a field place and copies every
# diagnostic already recorded, so a file with many errors was quadratic in
# them. Every append to a growing array of the lexer's state goes through one
# of these three, and `tests/harness/suite_layout.hero`'s `SLOW_APPENDS` reads
# every module for the other spelling.
function push_diagnostic(@diagnostics: [diag.Diagnostic], d: diag.Diagnostic)
    diagnostics @ diagnostics.push(d)

# The same spelling for the refused breaks, a file of broken lines being a
# file of many of them: a break as the lexer records it, before `line_joins`
# names its statement.
function push_break(@breaks: [Break], diagnostic: i64, after: i64, head: bool)
    breaks @ breaks.push(Break(diagnostic: diagnostic, after: after, head: head, statement: -1))

# And for the heads a reading apart leaves out.
function push_offset(@offsets: [i64], at: i64)
    offsets @ offsets.push(at)

# And for the certain swaps written, a file of foreign heads being a file of
# many of them (defect 146).
function push_swap(@swaps: [swap_words.Swap], at: i64, word: str)
    swaps @ swaps.push(swap_words.Swap(at: at, word: word))

# And for the margins an indentation run's fix rewrites, a run being as many
# lines as a body.
function push_fix(@fixes: [diag.Fix], f: diag.Fix)
    fixes @ fixes.push(f)

# And for the bodies in braces, nested as deep as a program's blocks.
function push_braces(@braced: [Braces], level: i64)
    braced @ braced.push(Braces(level: level, deeper: false))

# Error recovery in one move: record why, emit an `error` token over the same
# span, keep lexing. The lexer never stops.
function error_token(@l: LexState, d: diag.Diagnostic)
    span = d.span
    push_diagnostic(@l.diagnostics, d)
    push_token(@l.tokens, token.Token(kind: .error, span: span))
    l.last_significant @ ok(.error)

# The same recovery for a scanner that has ALREADY pushed its diagnostic — a
# narrower span was reported, and the literal as a whole still has to become
# an `error` token so the parser is not handed a number nobody decoded.
function error_token_at(@l: LexState, start: i64)
    span = token.Span(start: start, end: l.pos)
    push_token(@l.tokens, token.Token(kind: .error, span: span))
    l.last_significant @ ok(.error)

test "emit tracks bracket depth and the last significant token"
    l: LexState @ new_state()
    assert l.last_significant.is_err()
    l.pos @ 1
    emit(@l, .lparen, 0)
    assert l.open_brackets.len() == 1
    l.pos @ 2
    emit(@l, .rparen, 1)
    assert l.open_brackets.len() == 0
    assert l.last_significant.must() == .rparen
    assert l.tokens.len() == 2

test "a stray closer saturates instead of corrupting"
    l: LexState @ new_state()
    l.pos @ 1
    emit(@l, .rbrace, 0)
    assert l.open_brackets.len() == 0
    assert l.tokens[0].kind == .rbrace

test "error recovery records why and keeps lexing"
    l: LexState @ new_state()
    l.pos @ 3
    error_token(
        @l,
        diag.new_diagnostic(code: "unexpected_character", message: "`€` is not part of the language's syntax", span: token.Span(start: 0, end: 3))
    )
    assert l.diagnostics.len() == 1
    assert l.tokens[0].kind == .error
    assert l.last_significant.must() == .error
