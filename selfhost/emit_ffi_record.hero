# The classes where the header contradicts a RECORD (design.md §4.19;
# panels 060, 061, 073, 077, 079). Port of
# crates/heroes/src/emit/ffi_record.rs.
#
# Two readers that fault the DECLARATION — a record naming too few of
# the header's fields, and one whose header type is a union — where a
# field mistake is repaired on a field line (those live in ffi_field).
# They differ in mechanism and that is worth seeing side by side:
# union_record reads an assertion this emitter wrote, so its match is
# a contract; incomplete_record reads clang's own wording for
# -Wmissing-field-initializers and finds the declaration through the
# #LINE MAPPING — the probe's name is echoed on a different line from
# the message, and holding state across clang's output is a premise
# about its layout (panel 038 paid for one of those).
#
# Port note, and a bootstrap defect fixed by this crossing: the
# bootstrap matched clang's row against the WHOLE-TEXT line and
# ignored the path — right for every single-file golden, wrong the
# moment a program has two files, because the row clang echoes is the
# #line mapping's, 1-based within its own file. Both sides now ask
# locate() and compare file and line together.

use token
use ast
use source
use diag
use emit_externs
use emit_extern_union
use emit_ffi_lookup
use parse
use resolve
use checker

# The header's struct has a field the record never names, and C fills
# it with zero (panel 061). The narrowing is still CLAUDE.md §7's: the
# record is looked up among THIS program's group declarations, so a
# "missing field" from anywhere else finds nothing and stays exit 2.
function incomplete_record(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    tail = emit_ffi_lookup.after(text: line, marker: "missing field '")

    if tail.is_err()
        return fail("none", "not a missing-field line")
    member = emit_ffi_lookup.up_to_quote(tail.must())
    place = caret_of(line)

    if place.is_err()
        return fail("none", "no position on the line")
    found = record_at_line(s, decls, path: place.must().path, row: place.must().row)

    if found.is_err()
        return fail("none", "no group record sits on that line")
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "ffi_incomplete_record",
        message: "`" + found.must().type_name + "` does not name `" + member + "`, and `" + found.must().header + "` says the struct has it — a group's `record` IS the header's struct, so a field left out is a field C fills with zero",
        span: found.must().span
    )
    d.notes @ d.notes.push(
        "the assertions above check every field you DO name and cannot see one you leave out: a `" + found.must().type_name + "` built here would carry a zero `" + member + "` into C, which is a value rather than a crash"
    )
    return ok(d)

# Where clang's caret sits: `path:row:col: error: …` read from the
# right, so a path may keep its own colons.
record Caret
    path: str
    row: i64

function caret_of(line: str) -> Caret?
    head = emit_ffi_lookup.char_index_of(text: line, needle: ": error:")

    if head.is_err()
        return fail("none", "not an error line")
    cs = line.chars()
    last: i64 @ -1
    second: i64 @ -1
    index: i64 @ head.must() - 1

    while index >= 0
        if cs[index] == ":"
            if last == -1
                last @ index
            else
                second @ index
                break
        index @ index - 1

    if last == -1 || second == -1
        return fail("none", "no row and column before the message")
    path: [str] @ []
    at: i64 @ 0

    while at < second
        path @ path.push(cs[at])
        at @ at + 1

    row_text: [str] @ []
    at @ second + 1

    while at < last
        row_text @ row_text.push(cs[at])
        at @ at + 1

    row = emit_ffi_lookup.number(row_text.join(""))

    if row.is_err()
        return fail("none", "the row is not a number")
    return ok(Caret(path: path.join(""), row: row.must()))

# The group record whose name sits on this .hero line — file and line
# TOGETHER, because the row is file-relative by construction.
record RecordAt
    type_name: str
    header: str
    span: token.Span

function record_at_line(s: source.Source, decls: [ast.Decl], path: str, row: i64) -> RecordAt?
    for decl in decls
        match decl.kind
            .record_decl rec =>
                if rec.header.is_err()
                    continue
                found = source.locate(s, decl.name.start)

                if found.file != path || found.line != row
                    continue
                return ok(
                    RecordAt(type_name: source.span_text(s, decl.name), header: emit_externs.unquoted(s, span: rec.header.must()), span: decl.name)
                )
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail("none", "no group record on that line")

# A group's record over a C UNION, at the two operations that would
# answer wrongly: constructing one, and comparing or hashing one
# (panel 073). The route back is the finding: reading is untouched,
# and a record naming ONE member binds it soundly.
function union_record(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
    if !emit_ffi_lookup.has(text: line, needle: emit_ffi_lookup.FAILED)
        return fail("none", "not an assertion failure")
    rest = emit_ffi_lookup.after(text: line, marker: emit_extern_union.UNION_ASSERTION)

    if rest.is_err()
        return fail("none", "not a union assertion")
    parts = emit_ffi_lookup.words(text: rest.must())

    if parts.len() == 0
        return fail("none", "the marker's tail is empty")
    type_name = parts[0]
    members: [str] @ []
    index: i64 @ 1
    fall: bool @ false

    while index < parts.len() && !fall
        if emit_ffi_lookup.has(text: parts[index], needle: "\"")
            fall @ true
        else
            members @ members.push(parts[index])
            index @ index + 1

    found = record_of(s, decls, type_name: type_name)

    if found.is_err()
        return fail("none", "no group declares this record")

    # The two cases read differently because they ARE different (panel
    # 077): with one declared member the record is buildable and
    # readable and it is ==/hash that has no answer; with two or more,
    # building it is already wrong, because C keeps the last written.
    d: diag.Diagnostic @ diag.new_diagnostic(code: "ffi_union_field", message: "", span: found.must().span)

    if members.len() <= 1
        one: str @ "its member"

        if members.len() == 1
            one @ members[0]
        d.message @ "`" + type_name + "` is a `union` in `" + found.must().header + "`, so comparing or hashing one asks about bytes that may hold another member — `" + one + "` is only what was written last"
        d.notes @ d.notes.push(
            "reading `" + one + "` and building one that names it are both sound and stay legal; what has no answer is `==`, `hash` and being a map key, because two values holding different members are equal whenever the bytes match. Mark the `record` `partial` if you want that refusal stated at the declaration"
        )
    else
        named: str @ ""

        if members.len() == 2
            named @ "`" + members[0] + "` and `" + members[1] + "`"
        else
            heads: [str] @ []
            at: i64 @ 0

            while at < members.len() - 1
                heads @ heads.push(members[at])
                at @ at + 1

            named @ "`" + heads.join("`, `") + "` and `" + members[members.len() - 1] + "`"
        d.message @ "`" + type_name + "` is a `union` in `" + found.must().header + "`, so " + named + " are the same bytes — building one or comparing it would answer about whichever was written last"
        d.notes @ d.notes.push(
            "a `record` over a union may name ONE member, and that binds it soundly: reading through it is correct and construction sets the member it names. Two or more is what has no answer — C keeps the last one written, so `==` and `hash` walk the same bytes twice"
        )
    return ok(d)

# The declaration's own name span, for a class whose fault is the
# declaration rather than any one field.
record RecordOf
    header: str
    span: token.Span

function record_of(s: source.Source, decls: [ast.Decl], type_name: str) -> RecordOf?
    for decl in decls
        if source.span_text(s, decl.name) != type_name
            continue

        match decl.kind
            .record_decl rec =>
                if !rec.header.is_err()
                    return ok(RecordOf(header: emit_externs.unquoted(s, span: rec.header.must()), span: decl.name))
            .constant_decl | .function_decl | .variant_decl | .test_decl => continue

    return fail("none", "no group record has this name")

## Tests

test "incomplete_record maps the probe's #line back to the declaration"
    text = "extern \"raylib.h\"\n    record Color\n        r: i64\n        g: i64\n\nfunction touch(c: Color)\n    _ = c\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    line = "t.hero:2:12: error: missing field 'b' initializer [-Wmissing-field-initializers]"
    d = incomplete_record(s, parsed.decls, line: line)
    assert d.must().code == "ffi_incomplete_record"
    assert d.must().message == "`Color` does not name `b`, and `raylib.h` says the struct has it — a group's `record` IS the header's struct, so a field left out is a field C fills with zero"

    # A row where no group record sits, or another file's row, stays
    # the compiler's problem.
    assert incomplete_record(s, parsed.decls, line: "t.hero:6:12: error: missing field 'b' initializer").is_err()
    assert incomplete_record(s, parsed.decls, line: "other.hero:2:12: error: missing field 'b' initializer").is_err()

test "union_record reads its own marker, one member and many apart"
    text = "extern \"m.h\"\n    record UDef\n        i: i64\n        f: i64\n    record One\n        v: i64\n\nfunction touch(u: UDef, o: One)\n    _ = u\n    _ = o\n\nfunction main()\n    print(1)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c = checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    two = "m.c:9:1: error: static assertion failed due to requirement 'x': heroes-ffi-union UDef i f"
    d = union_record(s, parsed.decls, line: two)
    assert d.must().code == "ffi_union_field"
    assert d.must().message == "`UDef` is a `union` in `m.h`, so `i` and `f` are the same bytes — building one or comparing it would answer about whichever was written last"
    one = "m.c:9:1: error: static assertion failed due to requirement 'x': heroes-ffi-union One v"
    k = union_record(s, parsed.decls, line: one)
    assert k.must().message == "`One` is a `union` in `m.h`, so comparing or hashing one asks about bytes that may hold another member — `v` is only what was written last"

    # The interpolated note names the member — the bootstrap shipped
    # this note with a literal {one} inside it, fixed by this crossing.
    assert k.must().notes[0] == "reading `v` and building one that names it are both sound and stay legal; what has no answer is `==`, `hash` and being a map key, because two values holding different members are equal whenever the bytes match. Mark the `record` `partial` if you want that refusal stated at the declaration"

    # The premise-death control's own message contains no marker tail
    # that parses: 'a union must classify as 13…' has no record name.
    control = "m.c:9:1: error: static assertion failed due to requirement 'y': a union must classify as 13, or every heroes-ffi-union assertion above is vacuous"
    assert union_record(s, parsed.decls, line: control).is_err()
