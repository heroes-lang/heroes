# An escape the language does not have, and what else it reads as (spec § 2
# Literals; design.md §4.17; defect 135's class, lane recovery-b3).
#
# The lexer refuses every backslash but the six escapes (`escape.hero`), and
# its repair was `\\`, certain: the author wrote a backslash, so write one.
# That is the repair only where the escape reads as nothing but a backslash,
# `\d` or `\.` in a pattern, `\u` in `"C:\users"`. Where the same bytes are
# another language's way of writing what this one writes otherwise, two
# readings are as likely, and `check --apply` wrote one into the program
# without a reader: `"n is \(n)"` checked clean and printed `\(n)`, and `'\('`
# became `'\\('`, two characters, refused anew. The readings, each asked of the
# escape's own bytes and the ones after it, never of the program around it:
#
# - `\(` before a bracketed expression, in a string, is a value written into
#   it, which this language writes `f"…{n}…"`;
# - `\x41`, `\u00e9`, `\0`, `\a` name a character by its code, and this
#   language writes the character itself and has no escape by its code
#   (`escape.hero`: the set is frozen);
# - `\$`, `\?`, `\/` and `` \` `` escape a character this language writes
#   bare, and so does every other escape in a character literal, where `\\`
#   before it would make two characters;
# - `\{` in an `f"…"` literal is a brace, which is `{{` there, where `\\{`
#   opens a hole.
#
# A reading makes every fix a `guess`, each repair shown and none applied;
# every escape no reading takes keeps the certain `\\`. This module asks the
# bytes and answers; the diagnostic and its fixes are `escape_report`'s.

use escape

## The readings

variant Reading
    # `\d`, `\.`, `\(` before no bracketed expression: `\\` is the repair.
    backslash
    # `\(n)` in a string, the expression closed by the `)` at `close`.
    hole
        close: i64
    # `\x41`, `\0`, `\a`: a character by its code, the escape ending at `end`.
    code
        end: i64
    # `\$`, and any other escape in a character literal: the character bare.
    bare
    # `\{` in an `f"…"` literal: a brace.
    brace

# What the escape whose backslash is at `backslash` reads as, in the literal
# that opened at `literal`: its `"`, its `'`, or the `f"` or `}` that began
# the piece of an `f"…"` literal the escape stands in.
function reading(text: str, backslash: i64, literal: i64, ctx: escape.Quoted) -> Reading
    after = backslash + 1
    ends = code_end(text, at: after)

    if ends > after
        return .code(end: ends)
    b = text[after]

    if ctx == .in_char || b == '$' || b == '?' || b == '/' || b == '`'
        return .bare
    in_piece = text[literal] != '"'

    if in_piece && b == '{'
        return .brace

    if in_piece && b == '}'
        return .bare

    if b == '('
        close = hole_close(text, from: after + 1, in_piece: in_piece)

        if close >= 0
            return .hole(close: close)
    return .backslash

# Where an escape that names a character by its code ends, from the byte after
# its backslash at `at`: past the digits of `\x41`, `\u00e9`, `\u{1F600}`,
# `\U0001F600` and `\101`, past the letter of `\a` `\b` `\e` `\f` `\v`; and
# `at` itself where the bytes name no code, `\u` in `"C:\users"` among them.
function code_end(text: str, at: i64) -> i64
    b = text[at]

    if b == 'x'
        return counted(text, from: at + 1, least: 1, most: 2, hex: true, none: at)

    if b == 'u' && at + 1 < text.len() && text[at + 1] == '{'
        inside = counted(text, from: at + 2, least: 1, most: 8, hex: true, none: at)

        if inside > at && inside < text.len() && text[inside] == '}'
            return inside + 1
        return at

    if b == 'u'
        return counted(text, from: at + 1, least: 4, most: 4, hex: true, none: at)

    if b == 'U'
        return counted(text, from: at + 1, least: 8, most: 8, hex: true, none: at)

    if b >= '0' && b <= '7'
        return counted(text, from: at, least: 1, most: 3, hex: false, none: at)

    if b == 'a' || b == 'b' || b == 'e' || b == 'f' || b == 'v'
        return at + 1
    return at

# Past the digits from `from`, at most `most` of them, hexadecimal or octal;
# `none` where there are fewer than `least`.
function counted(text: str, from: i64, least: i64, most: i64, hex: bool, none: i64) -> i64
    i: i64 @ from

    while i < text.len() && i - from < most && digit_of(text[i], hex: hex) >= 0
        i @ i + 1

    if i - from < least
        return none
    return i

# One digit's value, or -1 where the byte is none.
function digit_of(b: u8, hex: bool) -> i64
    if b >= '0' && b <= '7'
        return to_i64(b - '0').must()

    if hex && (b == '8' || b == '9')
        return to_i64(b - '0').must()

    if hex && b >= 'a' && b <= 'f'
        return to_i64(b - 'a').must() + 10

    if hex && b >= 'A' && b <= 'F'
        return to_i64(b - 'A').must() + 10
    return -1

# The `)` that closes the expression a `\(` opens at `from`, inside the one
# literal, or -1: a `"` ends the literal, a line end ends the line, and in the
# piece of an `f"…"` literal a `{` opens a hole the expression cannot reach
# over. An expression holds something other than spaces, and no backslash: a
# string inside it would need quotes, which end the literal, so `\( and \()`
# is two escapes and no expression.
function hole_close(text: str, from: i64, in_piece: bool) -> i64
    depth: i64 @ 1
    i: i64 @ from
    seen: bool @ false

    while i < text.len()
        b = text[i]

        if b == '\n' || b == '"' || b == '\\' || in_piece && b == '{'
            return -1

        if b == ')'
            depth @ depth - 1

            if depth == 0
                if seen
                    return i
                return -1
        else if b != ' '
            seen @ true

            if b == '('
                depth @ depth + 1
        i @ i + 1

    return -1

## The value of an escape by its code

# The code an escape names, from its first byte after the backslash at `at` to
# `end`, where `code_end` put it.
function code_value(text: str, at: i64, end: i64) -> i64
    b = text[at]

    if b == 'a'
        return 7

    if b == 'b'
        return 8

    if b == 'e'
        return 27

    if b == 'f'
        return 12

    if b == 'v'
        return 11
    from: i64 @ at + 1
    hex: bool @ true

    if b >= '0' && b <= '7'
        from @ at
        hex @ false
    else if b == 'u' && text[at + 1] == '{'
        from @ at + 2
    value: i64 @ 0
    i: i64 @ from

    while i < end && digit_of(text[i], hex: hex) >= 0
        if hex
            value @ value * 16 + digit_of(text[i], hex: hex)
        else
            value @ value * 8 + digit_of(text[i], hex: hex)
        i @ i + 1

    return value

# The visible ASCII characters, 32 to 126, for the one question a code can be
# answered with as text here: which of them it names.
constant VISIBLE: str
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# The character a code names, as it is written inside the literal `ctx` is, or
# nothing where the code names no visible ASCII character.
function written(value: i64, ctx: escape.Quoted) -> str?
    if value < 32 || value > 126
        return fail(code: "unseen", msg: "not a visible ASCII character")
    ch = VISIBLE.slice(from: value - 32, to: value - 31)

    if ch == "\\"
        return ok("\\\\")

    if ch == "\"" && ctx == .in_str
        return ok("\\\"")

    if ch == "'" && ctx == .in_char
        return ok("\\'")
    return ok(ch)

## Quoting and the literal it meant

# A text between backquotes, as a diagnostic quotes code; between two and a
# space where the text holds a backquote itself, so `` \` `` reads as written.
function quoted(text: str) -> str
    i: i64 @ 0

    while i < text.len()
        if text[i] == '`'
            return "`` " + text + " ``"
        i @ i + 1

    return "`" + text + "`"

# Past the `"` that closes the plain string opening at `literal`, or -1 where
# the line ends first.
function plain_end(text: str, literal: i64) -> i64
    i: i64 @ literal + 1

    while i < text.len() && text[i] != '\n'
        if text[i] == '\\'
            i @ i + 2
        else if text[i] == '"'
            return i + 1
        else
            i @ i + 1

    return -1

# The plain string from `from` to `to`, its quotes included, written as the
# `f"…"` literal its `\(…)` meant: each `\(` before a bracketed expression the
# hole `{…}`, each `{` of its text doubled, every other byte as written. A run
# is cut only beside an ASCII byte, so a character above ASCII is copied whole.
function interpolated(text: str, from: i64, to: i64) -> str
    out: [str] @ ["f\""]
    run: i64 @ from + 1
    i: i64 @ from + 1

    while i < to - 1
        b = text[i]

        if b == '{'
            out @ out.push(text.slice(from: run, to: i + 1) + "{")
            i @ i + 1
            run @ i
        else if b == '\\' && i + 1 < to - 1 && text[i + 1] == '('
            close = hole_close(text, from: i + 2, in_piece: false)

            if close >= 0
                out @ out.push(text.slice(from: run, to: i) + "{" + text.slice(from: i + 2, to: close) + "}")
                i @ close + 1
                run @ i
            else
                i @ i + 2
        else if b == '\\'
            i @ i + 2
        else
            i @ i + 1

    out @ out.push(text.slice(from: run, to: to))
    return out.join("")

## Tests

test "an escape that reads as nothing but a backslash keeps the certain repair"
    assert reading("\"\\d\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\(\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\()\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\( )\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\{\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"C:\\users\"", backslash: 3, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\xZ\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash

test "a bracketed expression after the backslash is a value written into the string"
    assert reading("\"n \\(n)\"", backslash: 3, literal: 0, ctx: .in_str) == .hole(close: 6)
    assert reading("\"\\(f(x))\"", backslash: 1, literal: 0, ctx: .in_str) == .hole(close: 7)
    assert reading("\"\\(n\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\( and \\()\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert interpolated("\"n \\(n) {x}\"", from: 0, to: 12) == "f\"n {n} {{x}\""
    assert interpolated("\"\\(a): \\(b + 1)\\d\"", from: 0, to: 18) == "f\"{a}: {b + 1}\\d\""

test "an escape by a character's code ends past its digits and names its value"
    assert code_end("x41Z", at: 0) == 3
    assert code_end("u00e9Z", at: 0) == 5
    assert code_end("u{1F600}Z", at: 0) == 8
    assert code_end("U0001F600Z", at: 0) == 9
    assert code_end("101Z", at: 0) == 3
    assert code_end("0Z", at: 0) == 1
    assert code_end("aZ", at: 0) == 1
    assert code_end("dZ", at: 0) == 0
    assert code_end("users", at: 0) == 0
    assert code_value("x41", at: 0, end: 3) == 65
    assert code_value("u{1F600}", at: 0, end: 8) == 128512
    assert code_value("101", at: 0, end: 3) == 65
    assert code_value("0", at: 0, end: 1) == 0
    assert written(65, .in_str).must() == "A"
    assert written(34, .in_str).must() == "\\\""
    assert written(39, .in_char).must() == "\\'"
    assert written(0, .in_char).is_err()

test "a brace in an f piece, and any escape in a character literal, reads bare"
    assert reading("f\"a \\{\"", backslash: 4, literal: 0, ctx: .in_str) == .brace
    assert reading("} \\}\"", backslash: 2, literal: 0, ctx: .in_str) == .bare
    assert reading("'\\('", backslash: 1, literal: 0, ctx: .in_char) == .bare
    assert reading("\"\\$\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert quoted("\\`") == "`` \\` ``"
    assert quoted("\\(") == "`\\(`"
    assert reading("'\\0'", backslash: 1, literal: 0, ctx: .in_char) == .code(end: 3)
