# An escape the language does not have, and what else it reads as (spec § 2
# Literals; design.md §4.17; defect 135's class, lane recovery-b3).
#
# The lexer refuses every backslash but the six escapes (`escape.hero`), and
# its repair was `\\`, certain: the author wrote a backslash, so write one.
# That is the repair only where the escape reads as nothing but a backslash,
# `\d` or `\.` in a pattern, `\u` in `"C:\users"`. Where the same bytes are
# another language's way of writing what this one writes otherwise, two
# readings are as likely, and `check --apply` wrote one into the program
# without a reader: `"n is \(n)"` checked clean and printed `\(n)`, and `'\('`
# became `'\\('`, two characters, refused anew. The readings, each asked of the
# escape's own bytes and the ones after it, never of the program around it:
#
# - `\(` before a bracketed expression, in a string, is a value written into
#   it, which this language writes `f"…{n}…"`;
# - `\x41`, `\u00e9`, `\0`, `\a` name a character by its code, and this
#   language writes the character itself and has no escape by its code
#   (`escape.hero`: the set is frozen); so do the same escapes braced, Perl's
#   `\x{41}` and `\o{101}`, one short of their digits, `\u41` and `\U41`,
#   and a control character by its letter, `\cA`, `\c[`, `\C-a`, `\M-A`, `\E`;
# - `\N{EM DASH}` names a character by its NAME, Python's and Perl's way;
# - `\$`, `\?`, `\/`, `` \` ``, `\%`, `\#`, `\@`, `\8` and `\9` escape a
#   character this language writes bare, and so does every other escape in a
#   character literal, where `\\` before it would make two characters;
# - `\{` and `\}` in an `f"…"` literal are a brace, which is `{{` and `}}`
#   there (panel 184 R1), where `\\{` opens a hole. `\}` read bare until
#   2026-10-02, and its bare `}` is a lone brace, refused, since that ruling.
#
# A reading makes every fix a `guess`, each repair shown and none applied;
# every escape no reading takes keeps the certain `\\`, which is a judgment
# where another language writes a character that way rarely: `\s` and `\d`
# read first as a pattern's class (defect 135's L4, lane literals). This
# module asks the bytes and answers, where an escape by its code ends being
# `escape_codes`'s; the diagnostic and its fixes are `escape_report`'s.

use escape
use escape_codes

## The readings

variant Reading
    # `\d`, `\.`, `\(` before no bracketed expression: `\\` is the repair.
    backslash
    # `\(n)` in a string, the expression closed by the `)` at `close`.
    hole
        close: i64
    # `\x41`, `\0`, `\a`, `\cA`: a character by its code, the escape ending
    # at `end`.
    code
        end: i64
    # `\N{EM DASH}`: a character by its name, the escape ending at `end`.
    name
        end: i64
    # `\$`, `\%`, `\8`, and any other escape in a character literal: the
    # character bare.
    bare
    # `\{` or `\}` in an `f"…"` literal: a brace, written doubled there.
    brace

# What the escape whose backslash is at `backslash` reads as, in the literal
# that opened at `literal`: its `"`, its `'`, or the `f"` or `}` that began
# the piece of an `f"…"` literal the escape stands in.
function reading(text: str, backslash: i64, literal: i64, ctx: escape.Quoted) -> Reading
    after = backslash + 1
    ends = escape_codes.code_end(text, at: after)

    if ends > after
        return .code(end: ends)

    if text[after] == 'N' && escape_codes.opens_brace(text, at: after)
        return .name(end: escape_codes.brace_end(text, from: after + 2))
    b = text[after]

    if ctx == .in_char || written_bare(b)
        return .bare
    in_piece = text[literal] != '"'

    if in_piece && (b == '{' || b == '}')
        return .brace

    if b == '('
        close = hole_close(text, from: after + 1, in_piece: in_piece)

        if close >= 0
            return .hole(close: close)
    return .backslash

# The characters an escape is written for where this language writes them
# bare: an interpolation's mark (`\$`, `\#`, `\@`), C's trigraph `\?`,
# JSON's `\/`, the shell's `` \` ``, the `\%` written for a percent sign,
# and JavaScript's `\8` and `\9`.
function written_bare(b: u8) -> bool
    return b == '$' || b == '?' || b == '/' || b == '`' || b == '%' || b == '#' || b == '@' || b == '8' || b == '9'

# The `)` that closes the expression a `\(` opens at `from`, inside the one
# literal, or -1: a `"` ends the literal, a line end ends the line, and in the
# piece of an `f"…"` literal a `{` opens a hole the expression cannot reach
# over. An expression holds something other than spaces, and no backslash: a
# string inside it would need quotes, which end the literal, so `\( and \()`
# is two escapes and no expression.
function hole_close(text: str, from: i64, in_piece: bool) -> i64
    depth: i64 @= 1
    i: i64 @= from
    seen: bool @= false

    while i < text.len()
        b = text[i]

        if b == '\n' || b == '"' || b == '\\' || in_piece && b == '{'
            return -1

        if b == ')'
            depth @ depth - 1

            if depth == 0
                if seen
                    return i
                return -1
        else if b != ' '
            seen @ true

            if b == '('
                depth @ depth + 1
        i @ i + 1

    return -1

## Quoting and the literal it meant

# A text between backquotes, as a diagnostic quotes code; between two and a
# space where the text holds a backquote itself, so `` \` `` reads as written.
function quoted(text: str) -> str
    i: i64 @= 0

    while i < text.len()
        if text[i] == '`'
            return "`` " + text + " ``"
        i @ i + 1

    return "`" + text + "`"

# Past the `"` that closes the plain string opening at `literal`, or -1 where
# the line ends first.
function plain_end(text: str, literal: i64) -> i64
    i: i64 @= literal + 1

    while i < text.len() && text[i] != '\n'
        if text[i] == '\\'
            i @ i + 2
        else if text[i] == '"'
            return i + 1
        else
            i @ i + 1

    return -1

# The plain string from `from` to `to`, its quotes included, written as the
# `f"…"` literal its `\(…)` meant: each `\(` before a bracketed expression the
# hole `{…}`, each brace of its text doubled, `}` as well as `{` since panel
# 184 R1 (a `}` alone is refused there), every other byte as written. A run
# is cut only beside an ASCII byte, so a character above ASCII is copied whole.
function interpolated(text: str, from: i64, to: i64) -> str
    out: [str] @= ["f\""]
    run: i64 @= from + 1
    i: i64 @= from + 1

    while i < to - 1
        b = text[i]

        if b == '{' || b == '}'
            out @ out.push(text.slice(from: run, to: i + 1) + text.slice(from: i, to: i + 1))
            i @ i + 1
            run @ i
        else if b == '\\' && i + 1 < to - 1 && text[i + 1] == '('
            close = hole_close(text, from: i + 2, in_piece: false)

            if close >= 0
                out @ out.push(text.slice(from: run, to: i) + "{" + text.slice(from: i + 2, to: close) + "}")
                i @ close + 1
                run @ i
            else
                i @ i + 2
        else if b == '\\'
            i @ escape.end_of(text, at: i)
        else
            i @ i + 1

    out @ out.push(text.slice(from: run, to: to))
    return out.join("")

## Tests

test "an escape that reads as nothing but a backslash keeps the certain repair"
    assert reading("\"\\d\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\(\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\()\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\( )\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\{\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"C:\\users\"", backslash: 3, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\xZ\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash

test "a bracketed expression after the backslash is a value written into the string"
    assert reading("\"n \\(n)\"", backslash: 3, literal: 0, ctx: .in_str) == .hole(close: 6)
    assert reading("\"\\(f(x))\"", backslash: 1, literal: 0, ctx: .in_str) == .hole(close: 7)
    assert reading("\"\\(n\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\( and \\()\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash

    # Panel 184 R1: the text's `}` doubles as its `{` does; this read
    # `f"n {n} {{x}"` until 2026-10-02, a lone `}` refused under the ruling.
    assert interpolated("\"n \\(n) {x}\"", from: 0, to: 12) == "f\"n {n} {{x}}\""
    assert interpolated("\"\\(a): \\(b + 1)\\d\"", from: 0, to: 18) == "f\"{a}: {b + 1}\\d\""
    assert interpolated("\"}\\(n)}\"", from: 0, to: 8) == "f\"}}{n}}}\""

test "a brace in an f piece reads as a brace, and any escape in a character literal bare"
    assert reading("f\"a \\{\"", backslash: 4, literal: 0, ctx: .in_str) == .brace

    # Panel 184 R1: `\}` read bare until 2026-10-02, and a bare `}` in the
    # text of an `f` literal is a lone brace, refused, since.
    assert reading("} \\}\"", backslash: 2, literal: 0, ctx: .in_str) == .brace
    assert reading("\"a \\}\"", backslash: 3, literal: 0, ctx: .in_str) == .backslash
    assert reading("'\\('", backslash: 1, literal: 0, ctx: .in_char) == .bare
    assert reading("\"\\$\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert quoted("\\`") == "`` \\` ``"
    assert quoted("\\(") == "`\\(`"
    assert reading("'\\0'", backslash: 1, literal: 0, ctx: .in_char) == .code(end: 3)

test "a code one short, braced or by a control letter, and a name, read as characters"
    # Defect 135's L4: each of these took a certain `\\` and printed its text.
    assert reading("\"\\u41\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 5)
    assert reading("\"\\U41\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 5)
    assert reading("\"\\x{41}\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 7)
    assert reading("\"\\x{41\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 4)
    assert reading("\"\\N{EM DASH}\"", backslash: 1, literal: 0, ctx: .in_str) == .name(end: 12)
    assert reading("'\\N{EM DASH}'", backslash: 1, literal: 0, ctx: .in_char) == .name(end: 12)
    assert reading("\"\\N{U+41}\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 9)
    assert reading("} \\x{41}\"", backslash: 2, literal: 0, ctx: .in_str) == .code(end: 8)
    assert reading("\"\\cA\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 4)
    assert reading("\"\\M-\\C-a\"", backslash: 1, literal: 0, ctx: .in_str) == .code(end: 8)

test "a character this language writes bare, and what keeps the certain backslash"
    assert reading("\"\\%\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert reading("\"\\#{n}\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert reading("\"\\@\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert reading("\"\\8\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert reading("\"\\9\"", backslash: 1, literal: 0, ctx: .in_str) == .bare
    assert reading("\"\\s\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\c1\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\&\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"ab\\c\"", backslash: 3, literal: 0, ctx: .in_str) == .backslash
    assert reading("\"\\N\"", backslash: 1, literal: 0, ctx: .in_str) == .backslash
