# A value written between quotes (design.md §4.1; spec § 2 Literals; panel 008).
# Port of archive/bootstrap-rs/heroes/src/lexer/literals.rs, plus the escape VALIDATOR from
# escape.rs — in Rust it is an impl on LexState living beside the table; here
# it lives beside its only two callers, and the table stays pure in escape.
#
# A bad escape does NOT poison the token: it is reported and the literal stays
# a str_lit, so one mistake inside a string costs one diagnostic. Both
# scanners stop at the end of the line — a string is not multi-line in this
# language, so an unterminated one is a mistake with a known extent.

use token
use diag
use state
use escape
use layout
use bytes
use escape_report

## The escape validator

# Validate one escape sequence, `l.pos` sitting on the backslash, and advance
# past it. Returns false when the backslash is the last thing on the line —
# the caller then reports the literal unterminated. `l.pos` is left ON the
# newline in that case: consuming it would swallow the line break and destroy
# every Indent/Dedent that follows (§4.15). `literal` is where the literal
# opened, or the piece of an `f"…"` literal the escape stands in, which is
# what an escape the language does not have is read beside
# (`escape_readings`).
function escape_step(@l: state.LexState, text: str, ctx: escape.Quoted, literal: i64) -> bool
    backslash = l.pos

    if backslash + 1 >= text.len()
        l.pos @ backslash + 1
        return false
    escaped = bytes.char_at(text, backslash + 1)

    if escaped == "\n"
        l.pos @ backslash + 1
        return false
    l.pos @ backslash + 1 + escaped.len()

    if !escape.escape_text(escaped, ctx).is_err()
        return true
    span = token.Span(start: backslash, end: l.pos)

    # Two different mistakes, two different repairs: the other context's
    # escape drops its backslash, certain; one the language does not have is
    # read for what else it could be, and its `\\` is certain only where it
    # reads as nothing else (`escape_readings`, defect 135's class).
    if escaped == escape.bare_text(ctx)
        d: diag.Diagnostic @ diag.new_diagnostic(
            code: "escape_not_needed",
            message: "`\\" + escaped + "` is not an escape here — `" + escaped + "` needs no escape inside " + escape.ctx_word(ctx) + ", write it bare",
            span: span
        )
        d.fixes @ d.fixes.push(
            diag.Fix(title: "drop the backslash: `" + escaped + "`", replacement: escaped, span: span, certainty: .certain)
        )
        state.push_diagnostic(@l.diagnostics, d)
    else
        l.pos @ escape_report.report(@l, text, backslash: backslash, literal: literal, ctx: ctx)

    # The token keeps its kind: poisoning it to `error` would delete the
    # line's Terminator (error is not an ender, panel 007) and turn one
    # mistake into two.
    return true

## The raw carriage return

# A raw carriage return inside a literal — refused, with `\r` as the repair
# (panel 066, the coherence condition).
#
# The escape is what makes this diagnostic possible: before it, byte 13 had NO
# spelling, so refusing the raw byte would have left the character unwritable.
# Now there is exactly one spelling, and the second — invisible — one is what
# §4.15 forbids everywhere else in the language.
#
# Measured on the compiler before this landed: a raw CR pasted mid-literal
# compiled at exit 0, survived `heroes fmt` byte-for-byte, and rendered
# identically to the same literal without it, so retyping what the screen shows
# changed the program's bytes and still compiled.
function raw_carriage_return(@l: state.LexState, at: i64, ctx: escape.Quoted)
    span = token.Span(start: at, end: at + 1)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "raw_carriage_return",
        message: "a carriage return written as itself inside " + escape.ctx_word(ctx) + " — it is invisible on screen, so the next reader deletes it by retyping the line",
        span: span
    )
    d.fixes @ d.fixes.push(diag.Fix(title: "write it as `\\r`", replacement: "\\r", span: span, certainty: .certain))
    state.push_diagnostic(@l.diagnostics, d)

## The string

# `"…"` to the closing quote on the same line, escapes validated as we go.
function string(@l: state.LexState, text: str)
    start = l.pos
    l.pos @ l.pos + 1

    while true
        if l.pos >= text.len() || text[l.pos] == '\n'
            break
        b = text[l.pos]

        if b == '"'
            l.pos @ l.pos + 1
            state.emit(@l, .str_lit, start)
            return

        if b == '\\'
            if !escape_step(@l, text, .in_str, literal: start)
                break
        else

            # Not a line ending here: a string is single-line, so this byte is
            # content — invisible content, which is why it is refused (066).
            if b == layout.CR
                raw_carriage_return(@l, l.pos, .in_str)
            l.pos @ l.pos + 1

    span = token.Span(start: start, end: l.pos)
    state.error_token(
        @l,
        diag.new_diagnostic(code: "unterminated_string", message: "this string never closes — strings are single-line, `\"` to `\"`", span: span)
    )
    swallow(@l, text, start: start)

## The character

# `'a'` — exactly ONE character: one ASCII byte, or one escape sequence. Its
# value is an i64 (design.md §4.3). `'\n'` is four source bytes and one
# character. Syntax is ASCII-only (§1.10), so a multi-byte character here is
# an error, not an interpretation.
function char_lit(@l: state.LexState, text: str)
    start = l.pos
    said = l.diagnostics.len()
    content_start = start + 1
    l.pos @ content_start

    # One pass to the closing quote, counting units: a unit is one character
    # or one whole escape sequence. Scanning past the closer in one go is what
    # keeps `'ab'` a single diagnostic instead of an unterminated literal
    # followed by debris.
    units: i64 @ 0
    closed: bool @ false
    scanning: bool @ true

    while scanning
        if l.pos >= text.len() || text[l.pos] == '\n'
            scanning @ false
        else if text[l.pos] == '\''
            closed @ true
            scanning @ false
        else if text[l.pos] == '\\'
            if escape_step(@l, text, .in_char, literal: start)
                units @ units + 1
            else
                scanning @ false
        else
            if text[l.pos] == layout.CR
                raw_carriage_return(@l, l.pos, .in_char)
            ch = bytes.char_at(text, l.pos)
            l.pos @ l.pos + ch.len()
            units @ units + 1

    if !closed
        # The classic `'\'` ends at its third byte, and what the scan said
        # past it is said again when the rest of the line is lexed.
        if classic_backslash(text, at: start)
            l.diagnostics @ l.diagnostics.slice(from: 0, to: said)
            l.pos @ start + 3
        unterminated_char(@l, text, start)
        return
    content = text.slice(from: content_start, to: l.pos)
    l.pos @ l.pos + 1

    if units == 1 && (starts_with_backslash(content) || all_ascii(content))
        state.emit(@l, .char_lit, start)
    else
        span = token.Span(start: start, end: l.pos)
        state.error_token(
            @l,
            diag.new_diagnostic(code: "char_literal", message: "a character literal holds exactly one character — one ASCII character ('a', '0', ' ') or one escape ('\\n', '\\t') — `'" + content + "'` does not", span: span)
        )

# No closing quote on this line. `l.pos` is already where the scan stopped
# (on the newline, never past it).
#
# `'\'` is the classic: the backslash escaped the closing quote. The literal
# is those three bytes, and the rest of the line is lexed after them, so the
# certain fix, `'\\'`, replaces the three and nothing else: over the whole
# rest of the line, `f('\' + )` was written `f('\\'`, the `+ )` gone and a
# report the first run never made in its place (lane recovery-b2, U3).
function unterminated_char(@l: state.LexState, text: str, start: i64)
    classic = l.pos == start + 3 && classic_backslash(text, at: start)
    span = token.Span(start: start, end: l.pos)
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "unterminated_char",
        message: "this character literal never closes — write one character between single quotes: 'a'",
        span: span
    )

    if classic
        d.fixes @ d.fixes.push(
            diag.Fix(title: "escape the backslash: `'\\\\'`", replacement: "'\\\\'", span: span, certainty: .certain)
        )
    state.error_token(@l, d)

    if !classic
        swallow(@l, text, start: start)

# Whether the character literal at `at` opens with `'\'`, its backslash
# before the quote that should have closed it.
function classic_backslash(text: str, at: i64) -> bool
    return at + 2 < text.len() && text[at + 1] == '\\' && text[at + 2] == '\''

## What a literal that never closed swallowed

# The closers in `swallowed`, the text an unterminated literal ran over to its
# line's end, that close no opener of its own: what they would have closed of
# the brackets open before the literal, had it closed where its author meant.
# The lexer pops that many (`swallow`) and the parser counts the same
# (`parse/unclosed.never_closed`), so the two agree on every bracket.
function unmatched_closers(swallowed: str) -> i64
    depth: i64 @ 0
    unmatched: i64 @ 0
    i: i64 @ 0

    while i < swallowed.len()
        b = swallowed[i]

        if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if b == ')' || b == ']' || b == '}'
            if depth > 0
                depth @ depth - 1
            else
                unmatched @ unmatched + 1
        i @ i + 1

    return unmatched

# How many of the brackets open before it the literal at `span` took the
# closers of, read from its `error` token as the lexer popped them: a quoted
# literal its own quote does not close, `"abc)`, took its unmatched closers;
# any other token took none. The classic `'\'` ends before anything it could
# take, so its answer is none either way.
function closers_taken(text: str, span: token.Span) -> i64
    quote = text[span.start]

    if quote != '"' && quote != '\''
        return 0

    if span.end - span.start >= 2 && text[span.end - 1] == quote
        slashes: i64 @ 0
        i: i64 @ span.end - 2

        while i > span.start && text[i] == '\\'
            slashes @ slashes + 1
            i @ i - 1

        if slashes % 2 == 0
            return 0
    return unmatched_closers(text.slice(from: span.start, to: span.end))

# A literal that never closed took every closer on the rest of its line: the
# brackets those close are popped, as `state.emit` pops for a closer, so none
# of them is named never closed, `f("abc)` costing `unterminated_string` and
# `unclosed_bracket` for one mistake; and the line end after it is a line end
# at any depth (`LexState.swallowed`), so the line below is its own and not
# the rest of a literal that ended its line (defect 131's class, lane
# recovery-b2, U3).
function swallow(@l: state.LexState, text: str, start: i64)
    left: i64 @ unmatched_closers(text.slice(from: start, to: l.pos))

    while left > 0 && l.open_brackets.len() > 0
        l.open_brackets @ l.open_brackets.slice(from: 0, to: l.open_brackets.len() - 1)
        left @ left - 1

    l.swallowed @ true

## Byte questions the scanners ask

function starts_with_backslash(s: str) -> bool
    return s.len() > 0 && s[0] == '\\'

function all_ascii(s: str) -> bool
    i: i64 @ 0

    while i < s.len()
        if s[i] > 127
            return false
        i @ i + 1

    return true

test "a string is one token and a bad escape does not poison it"
    l: state.LexState @ state.new_state()
    string(@l, "\"abc\"")
    assert l.tokens.len() == 1
    assert l.tokens[0].kind == .str_lit
    assert l.tokens[0].span == token.Span(start: 0, end: 5)
    b: state.LexState @ state.new_state()
    string(@b, "\"a\\db\"")
    assert b.tokens[0].kind == .str_lit
    assert b.diagnostics.len() == 1
    assert b.diagnostics[0].code == "unknown_escape"
    assert b.diagnostics[0].fixes[0].replacement == "\\\\d"

test "the other context's escape is refused with the bare repair"
    l: state.LexState @ state.new_state()
    string(@l, "\"a\\'b\"")
    assert l.diagnostics[0].code == "escape_not_needed"
    assert l.diagnostics[0].fixes[0].replacement == "'"
    assert l.tokens[0].kind == .str_lit

test "an unterminated string is an error with a known extent"
    l: state.LexState @ state.new_state()
    string(@l, "\"abc\nx = 1")
    assert l.tokens[0].kind == .error
    assert l.diagnostics[0].code == "unterminated_string"
    assert l.pos == 4

test "a character literal holds exactly one character"
    l: state.LexState @ state.new_state()
    char_lit(@l, "'a'")
    assert l.tokens[0].kind == .char_lit
    e: state.LexState @ state.new_state()
    char_lit(@e, "'\\n'")
    assert e.tokens[0].kind == .char_lit
    assert e.tokens[0].span == token.Span(start: 0, end: 4)
    two: state.LexState @ state.new_state()
    char_lit(@two, "'ab'")
    assert two.tokens[0].kind == .error
    assert two.diagnostics[0].code == "char_literal"
    wide: state.LexState @ state.new_state()
    char_lit(@wide, "'é'")
    assert wide.tokens[0].kind == .error
    assert wide.diagnostics[0].code == "char_literal"

test "the backslash that ate the closing quote gets the classic fix"
    l: state.LexState @ state.new_state()
    char_lit(@l, "'\\'")
    assert l.diagnostics[0].code == "unterminated_char"
    assert l.diagnostics[0].fixes.len() == 1
    assert l.diagnostics[0].fixes[0].replacement == "'\\\\'"
    plain: state.LexState @ state.new_state()
    char_lit(@plain, "'a")
    assert plain.diagnostics[0].code == "unterminated_char"
    assert plain.diagnostics[0].fixes.len() == 0
