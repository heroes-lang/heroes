# The rich form: an error written to be read by a model (design.md
# §4.17). Port of archive/bootstrap-rs/heroes/src/diagnostics/render.rs.
#
# §4.17's whole argument is that a human has the project open and a
# model does not, so "type mismatch at line 12" costs three
# conversational turns for a comma. Every error therefore carries what
# is needed to fix the program WITHOUT OPENING ANOTHER FILE: the line
# as written, what is wrong with it, where the other half is, and the
# repairs — with the one that preserves meaning marked as such. Every
# part of the shape is load-bearing: the code is stable and
# machine-readable; the caret is the SPAN, not the line; a note
# carries the other end — the file the model would otherwise open; a
# fix is tagged, because a model that cannot see which repair is safe
# will apply whichever one it read last.

use source
use diag
use token
use shown_char

# One diagnostic, in the rich form. No trailing blank line: the
# caller joins.
#
# **Every control character in it is written by its code** (defect 244),
# the excerpt's above all: the line as written went to the terminal raw, so a
# file's ESC sequences coloured or cleared the screen that showed the message,
# a lone carriage return wrote the rest of the line over its start, and a
# file in UTF-16 sent hundreds of NULs. `shown_char.visible` writes each as
# `<U+001B>`, and `caret` pads under it by that width.
function render(d: diag.Diagnostic, s: source.Source) -> str
    # Two line numbers, and they are not the same thing once a
    # compilation has more than one file: `line` is what the reader is
    # told, `absolute` is where the text actually is. Printing the
    # second is a message that names a real file and a line nobody can
    # find in it.
    found = source.locate(s, d.span.start)
    absolute = source.line_of(s, d.span.start)
    rows: [str] @ [
        diag.word(d.kind) + "[" + d.code + "]: " + d.message + "\n  at " + found.file + ":" + found.line.to_str() + ":" + found.col.to_str() + "\n"
    ]
    number = found.line.to_str()
    gutter = " ".repeat(number.chars().len().to_u64().must())
    rows @ rows.push("  " + gutter + " |\n")
    rows @ rows.push("  " + number + " | " + source_line(s, line: absolute) + "\n")
    rows @ rows.push("  " + gutter + " | " + caret(s, d, col: found.col) + "\n")

    for note in d.notes
        rows @ rows.push("  note: " + note + "\n")

    for fix in d.fixes
        tag: str @ "guess"

        if fix.certainty == .certain
            tag @ "certain"
        rows @ rows.push("  fix (" + tag + "): " + fix.title + "\n")

    return shown_char.visible(rows.join(""))

# Every diagnostic, in source order, separated by a blank line.
function render_all(diagnostics: [diag.Diagnostic], s: source.Source) -> str
    rendered: [str] @ []

    for d in diagnostics
        rendered @ rendered.push(render(d, s))

    return rendered.join("\n")

# The line as written, in the WHOLE text's numbering, trailing
# whitespace dropped. Sliced at the source's own line table (defect 105):
# splitting the whole compilation's text into characters to find one line
# made every diagnostic cost the size of the program, and 4000 of them took
# 49 s. A space and a tab are one byte each and no byte of a longer
# character, so trimming bytes trims what trimming characters did.
function source_line(s: source.Source, line: i64) -> str
    if line < 1 || line > s.line_starts.len()
        return ""
    start = s.line_starts[line - 1]
    end: i64 @ s.text.len()

    if line < s.line_starts.len()
        end @ s.line_starts[line] - 1

    # Rust's trim_end: spaces and tabs off the right.
    while end > start && (s.text[end - 1] == ' ' || s.text[end - 1] == '\t')
        end @ end - 1

    return s.text.slice(from: start, to: end)

# The span, underlined. One CHARACTER is one column — the underline
# was one ^ per byte of the span, so `return "ààà"` was underlined
# eight wide for five columns (sweep 001 audit S5) — and a span that
# runs past its line is clamped, because a declaration's span covers
# its whole body and forty lines of caret help nobody.
#
# THE PADDING COPIES THE LINE'S OWN TABS. Every line but one cannot
# hold a tab, and the one is the line the tab diagnostic is ABOUT:
# printed above the caret like any other, a terminal expands its tab
# in the source line and not in a caret padded with spaces. rustc's
# rule and rustc's reason: reuse the whitespace rather than guess a
# tab width, and the two lines agree at any setting.
#
# A control character is as wide as the code `render` writes for it
# (defect 244), before the caret and under it alike.
function caret(s: source.Source, d: diag.Diagnostic, col: i64) -> str
    end_pos = source.line_col(s, d.span.end)
    start_line = source.line_of(s, d.span.start)
    width: i64 @ 1

    if end_pos.line == start_line && end_pos.col > col
        width @ 0

        for ch in s.text.slice(from: d.span.start, to: d.span.end).chars()
            width @ width + shown_char.width(ch)
    start = source.line_start_of(s, d.span.start)
    before = s.text.slice(from: start, to: d.span.start)
    padding: [str] @ []

    for ch in before.chars()
        if ch == "\t"
            padding @ padding.push("\t")
        else
            padding @ padding.push(" ".repeat(shown_char.width(ch).to_u64().must()))

    return padding.join("") + "^".repeat(width.to_u64().must())

## Tests

test "the rich form: caret on the span, notes and tagged fixes below"
    text = "function half(x: i64) -> i64\n    return \"x\"\n"
    s = source.new_source(name: "t.hero", text: text)

    # The span of "x" including quotes: line 2, after `    return `.
    at = token.Span(start: 40, end: 43)
    d: diag.Diagnostic @ diag.new_diagnostic(code: "type_mismatch", message: "expected `i64`, found `str`", span: at)
    d.notes @ d.notes.push("`half` is declared `-> i64` at line 1")
    d.fixes @ d.fixes.push(diag.Fix(title: "rename to `total`", replacement: "total", span: at, certainty: .guess))
    got = render(d, s)
    assert got == "error[type_mismatch]: expected `i64`, found `str`\n  at t.hero:2:12\n    |\n  2 |     return \"x\"\n    |            ^^^\n  note: `half` is declared `-> i64` at line 1\n  fix (guess): rename to `total`\n"

    # render_line, the one-line form beside it.
    assert diag.render_line(d, s) == "t.hero:2:12: error[type_mismatch]: expected `i64`, found `str`"

    # An unsupported row keeps its own first word.
    u = diag.new_unsupported(code: "map_key", message: "a `{f64: T}` map key is not emitted yet", span: at)
    assert diag.render_line(u, s) == "t.hero:2:12: unsupported[map_key]: a `{f64: T}` map key is not emitted yet"

test "the caret counts characters, and a multi-line span is clamped to one"
    text = "function main()\n    print(\"ààà\")\n"
    s = source.new_source(name: "t.hero", text: text)

    # The literal spans five columns and eight bytes.
    lit_start = 26
    d = diag.new_diagnostic(code: "x", message: "m", span: token.Span(start: lit_start, end: lit_start + 8))
    got = render(d, s)
    assert diag_has(text: got, needle: "|           ^^^^^\n")

    # A span that crosses lines gets one caret, not forty.
    whole = diag.new_diagnostic(code: "y", message: "m", span: token.Span(start: 0, end: text.len()))
    assert diag_has(text: render(whole, s), needle: "| ^\n")

# Defect 244: a source line's control characters reached the terminal raw
# through the excerpt, and a message quoting one carried it too. Each is
# written by its code, the caret padded under it by that width, a tab kept.
test "the excerpt writes a control character by its code, and the caret stands under what it names"
    esc = control([27])
    text = "function main()\n    x = 1 " + esc + "[31mred\n"
    s = source.new_source(name: "t.hero", text: text)
    at = token.Span(start: 26, end: 27)
    d: diag.Diagnostic @ diag.new_diagnostic(code: "unexpected_character", message: "m", span: at)
    got = render(d, s)
    assert diag_has(text: got, needle: "  2 |     x = 1 <U+001B>[31mred\n")
    assert diag_has(text: got, needle: "    |           ^^^^^^^^\n")
    assert !shown_char.holds_control(got)

    # Past it, the caret moves by the code's width, not by one.
    after = render(diag.new_diagnostic(code: "x", message: "m", span: token.Span(start: 27, end: 28)), s)
    assert diag_has(text: after, needle: "    |                   ^\n")

    # A lone carriage return, which wrote the rest of the line over its start.
    cr = render(d, source.new_source(name: "t.hero", text: "function main()\n    x = 1 # one\rFAKE\n"))
    assert diag_has(text: cr, needle: "# one<U+000D>FAKE")

    # A message, a note and a fix that quote one, and the one-line form.
    quoted: diag.Diagnostic @ diag.new_diagnostic(
        code: "unknown_escape",
        message: "`\\" + esc + "` is not an escape",
        span: at
    )
    quoted.notes @ quoted.notes.push("note " + control([7]))
    quoted.fixes @ quoted.fixes.push(
        diag.Fix(title: "escape it: `\\\\" + esc + "`", replacement: "\\\\" + esc, span: at, certainty: .certain)
    )
    whole = render(quoted, s)
    assert diag_has(text: whole, needle: "error[unknown_escape]: `\\<U+001B>` is not an escape\n")
    assert diag_has(text: whole, needle: "  note: note <U+0007>\n")
    assert diag_has(text: whole, needle: "  fix (certain): escape it: `\\\\<U+001B>`\n")
    assert !shown_char.holds_control(whole)
    assert diag.render_line(quoted, s) == "t.hero:2:11: error[unknown_escape]: `\\<U+001B>` is not an escape"

    # A tab stays, in the line and in the caret's padding.
    tabbed = render(
        diag.new_diagnostic(code: "x", message: "m", span: token.Span(start: 17, end: 18)),
        source.new_source(name: "t.hero", text: "function main()\n\tx = 1\n")
    )
    assert diag_has(text: tabbed, needle: "  2 | \tx = 1\n    | \t^\n")

# One character from its UTF-8 bytes, since the language writes none by its
# code (spec § 2 Literals).
function control(bytes: [u8]) -> str
    return bytes.validated_bytes().must()

function diag_has(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
