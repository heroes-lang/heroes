# The parser's front door: text → tree in one call (design.md §3.3 — a
# library with a thin CLI on top; Part 10 step 2).
# Port of archive/bootstrap-rs/heroes/src/syntax/mod.rs::parse — the last piece of the
# syntax stage, and the one that makes the pipeline an implementation detail
# of the frontend rather than of its clients.

use token
use diag
use ast
use source
use source_extent
use cursor
use lexer
use parse/decl
use parse/wrap_break

record ParseOutput
    decls: [ast.Decl]
    uses: [ast.Use]
    # Every comment in the file, in source order. The tree keeps only the
    # ones that are DOCUMENTATION (§4.1); `heroes fmt` needs all of them,
    # because a formatter that drops a comment is a formatter nobody runs.
    comments: [token.Span]
    diagnostics: [diag.Diagnostic]
    tree: ast.Ast
    # Every token the lexer made, the root file's first: `heroes fmt` reads
    # from them what the tree does not keep, which line a statement ends on
    # and which block a comment is in (`print/owners.hero`), and lexing the
    # file again for it cost a third of `fmt`'s time.
    tokens: [token.Token]

# Lex and parse one file in a single call.
#
# Diagnostics come out lexer-first, then parser, which keeps them grouped by
# the stage that can explain them; within a stage they are in source order.
# Never sorted across stages: a shape error and the word error that caused it
# read better together than interleaved by column.
function parse(text: str) -> ParseOutput
    return parse_bounded(text: text, root_end: -1)

# The whole compilation parsed the way the CLI must: every file lexed as
# its own text (lexer.lex's rule — the indent level and the open
# brackets must not cross a file boundary), and the cursor told where
# the author's text stops so no diagnostic anchors inside the library.
#
# **And every file PARSED as its own stream**, one cursor each, over the
# tokens that end at that file's own eof (found beside defect 109,
# 2026-09-27). One cursor over the joined stream let a declaration that a
# file left open go on into the next file: its diagnostic landed in a file
# the mistake is not in, the library's included, and a bodiless function
# at a module's end took the next module's indented first lines as its
# body and ran. The tree, the declarations and the uses are still one, in
# load order, and the joined stream is still what every other reader gets.
function parse_source(s: source.Source) -> ParseOutput
    files = lexer.lex_files(s)
    lexed = lexer.joined(s, files: files)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    diagnostics: [diag.Diagnostic] @ lexed.diagnostics
    bound = source_extent.root_end(s)

    for one in files
        c: cursor.Cursor @ cursor.bounded_cursor(tokens: one.tokens, root_end: bound)
        decl.file(@c, @a, @decls, @uses, s.text)

        for d in c.diagnostics
            diagnostics @ diagnostics.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: wrap_break.offer(diagnostics, tokens: lexed.tokens, a: a, text: s.text),
        tree: a,
        tokens: lexed.tokens
    )

# The same parse, told where the author's own text stops — what the CLI
# uses, because a compilation is the author's file plus every module it
# reaches plus the library (§1.11), and a diagnostic must never point
# inside the last of those.
function parse_bounded(text: str, root_end: i64) -> ParseOutput
    lexed = lexer.lex_one(text)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    c: cursor.Cursor @ cursor.bounded_cursor(tokens: lexed.tokens, root_end: root_end)
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    decl.file(@c, @a, @decls, @uses, text)
    diagnostics: [diag.Diagnostic] @ lexed.diagnostics

    for d in c.diagnostics
        diagnostics @ diagnostics.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: wrap_break.offer(diagnostics, tokens: lexed.tokens, a: a, text: text),
        tree: a,
        tokens: lexed.tokens
    )

# Which file each diagnostic of a parse points into, in order.
function files_of(s: source.Source, p: ParseOutput) -> [i64]
    out: [i64] @ []

    for d in p.diagnostics
        out @ out.push(source.file_of(s, d.span.start))

    return out

test "a declaration a file leaves open is refused in that file, and the library's is not read"
    s = source.with_library(name: "main.hero", user: "function main()\n", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "missing_body"
    assert files_of(s, p) == [0]
    assert p.decls.len() == 1

test "a module's first indented lines are not the body of the module before it"
    # Two modules, each refused alone: before the repair the first one's
    # bodiless `two` took the second one's first lines and the program ran.
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "function two() -> i64\n")
        source.user_file(name: "b.hero", text: "    return 2\n\nfunction three() -> i64\n    return 3\n")
    ]
    s = source.from_files(inputs)
    p = parse_source(s)
    assert p.diagnostics.len() == 2
    assert p.diagnostics[0].code == "missing_body"
    assert p.diagnostics[1].code == "expected_declaration"
    assert files_of(s, p) == [0, 1]
    assert p.decls.len() == 1

test "an empty file parses to nothing, before the library and between two modules"
    s = source.with_library(name: "main.hero", user: "", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "constant A: i64\n    1\n")
        source.user_file(name: "b.hero", text: "")
        source.user_file(name: "c.hero", text: "constant C: i64\n    3")
    ]
    three = parse_source(source.from_files(inputs))
    assert three.diagnostics.len() == 0
    assert three.decls.len() == 2

test "text becomes a tree in one call, comments and all"
    text = "# a note\nconstant MAX: i64\n    64  # trailing\n"
    p = parse(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1

    # BOTH comments are kept for the formatter; the tree keeps only the doc.
    assert p.comments.len() == 2
    assert p.decls[0].doc.len() == 1

test "diagnostics come out lexer-first, then parser"
    # A tab (the lexer's mistake) on line 2, a stray name at top level (the
    # parser's) on line 3: the lexer's diagnostic must come out first even
    # though recovery means both are found.
    text = "constant MAX: i64\n\t64\njunk\n"
    p = parse(text)
    assert p.diagnostics.len() >= 2
    assert p.diagnostics[0].code == "tab_in_indentation"
    assert p.diagnostics[p.diagnostics.len() - 1].code == "expected_declaration"

# Whether `text`'s diagnostics are all `code`, at least one, and every fix
# they carry, applied alone, gives a program the parser accepts: the promise
# panel 180 made of its two refusals, `spaced_minus_element` (R2) and
# `line_end_before_continuation` (R3), where a `guess` fix is never applied by
# `check --apply` and so nothing else would ever run one.
function every_fix_parses(text: str, code: str) -> bool
    first = parse(text)
    applied: i64 @ 0

    for d in first.diagnostics
        if d.code != code
            return false

        for fix in d.fixes
            fixed = text.slice(from: 0, to: fix.span.start) + fix.replacement + text.slice(from: fix.span.end, to: text.len())

            if parse(fixed).diagnostics.len() > 0
                return false
            applied @ applied + 1

    return applied > 0

test "a minus set apart from its operand in a list is refused, and each reading parses"
    code = "spaced_minus_element"
    assert every_fix_parses(text: "function main()\n    xs = [a\n        - b]\n", code: code)
    assert every_fix_parses(
        text: "function main()\n    xs = [a\n        -  # the sign, then a comment\n        b]\n",
        code: code
    )
    assert every_fix_parses(text: "function main()\n    xs = [a\n        -\n        b]\n", code: code)
    assert every_fix_parses(text: "function main()\n    xs = [a  # trailing the line above\n        - b]\n", code: code)
    assert every_fix_parses(text: "function main()\n    xs = [[a\n        - b]]\n", code: code)
    assert every_fix_parses(text: "function main()\n    print([1.5\n        - 2.5].len())\n", code: code)
    assert every_fix_parses(text: "function main()\r\n    xs = [a\r\n        - b]\r\n", code: code)

    # A map's line says which reading parses, and only that one is offered.
    key = parse("function main()\n    m = {1: 10\n        - 2: 20}\n")
    assert key.diagnostics.len() == 1
    assert key.diagnostics[0].fixes.len() == 1
    assert every_fix_parses(text: "function main()\n    m = {1: 10\n        - 2: 20}\n", code: code)
    value = parse("function main()\n    m = {\"k\": a\n        - b}\n")
    assert value.diagnostics.len() == 1
    assert every_fix_parses(text: "function main()\n    m = {\"k\": a\n        - b}\n", code: code)

test "the first element, a written comma, and the unary spelling are not asked"
    for text in ["function main()\n    xs = [\n        - 1\n        2\n    ]\n", "function main()\n    xs = [a,\n        - b]\n", "function main()\n    xs = [a\n        , - b]\n", "function main()\n    xs = [a\n        -b\n        -1]\n"]
        assert parse(text).diagnostics.len() == 0

# Panel 181: every fix of a line broken outside brackets, the join and the
# parentheses the parser offers, applied alone, gives a program that parses.
test "a line broken outside brackets is refused once, and each of its repairs parses"
    code = "continuation_outside_brackets"

    for text in ["function main()\n    y = a +\n    1\n", "function main()\n    y = a +\n        1\n", "function main()\n    if a &&\n    b\n        print(1)\n", "function main()\n    y = xs.\n    len()\n", "function main()\n    y = a +  # a note\n    1\n", "function main()\n    total = base\n    - fee\n", "function main()\n    x = f()\n    ?\n", "function main()\n    if c\n        y = a +\n    b\n"]
        assert every_fix_parses(text: text, code: code)

    wrapped = parse("function main()\n    y = a +\n    1\n")
    assert wrapped.diagnostics[0].fixes.len() == 2
    assert wrapped.diagnostics[0].fixes[1].replacement == "(a +\n    1)"
    assert wrapped.diagnostics[0].fixes[1].certainty == .guess
    head = parse("function main()\n    total = base\n    - fee\n")
    assert head.diagnostics[0].fixes.len() == 1
    arrow = parse("function main()\n    y =\n    a\n")
    assert arrow.diagnostics[0].fixes.len() == 1

    # An `if` cannot stand inside brackets, so the `else` over `if` break,
    # whose only expression is the `if`, takes the join alone.
    block = parse("function main()\n    if c\n        return\n    else\n    if d\n        return\n")
    assert block.diagnostics[0].fixes.len() == 1
    assert every_fix_parses(
        text: "function main()\n    if c\n        return\n    else\n    if d\n        return\n",
        code: "continuation_outside_brackets"
    )

test "a line end before what goes on with the line above names itself, and its fix parses"
    code = "line_end_before_continuation"
    shapes = [
        "function main()\n    y = (1\n        + 2)\n"
        "function main()\n    y = (1  # trailing the line above\n        + 2)\n"
        "function main()\n    y = (1\n        +  # after the operator\n        2)\n"
        "function main()\n    y = (1\n        +\n        2)\n"
        "function main()\n    y = (xs\n        .len())\n"
        "function main()\n    y = (f\n        (1))\n"
        "function main()\n    y = (f()\n        ?)\n"
        "function main()\n    y = (Point\n        ::x)\n"
        "function main()\n    y = xs[i\n        + 1]\n"
        "function main()\n    f(a\n        + b)\n"
        "function main()\n    f(a\n        - b)\n"
        "function main()\n    f(a\n        : 1)\n"
        "function main()\n    xs = [1\n        + 2]\n"
        "function main()\n    xs = [f()\n        ?]\n"
        "function main()\n    m = {\"a\"\n        : 1}\n"
        "function main()\n    m = {\"a\": 1\n        * 2}\n"
        "function f(a\n        : i64)\n    print(a)\n"
        "function f(a: i64\n        ?)\n    print(1)\n"
        "function f(p: geom\n        .Point)\n    print(1)\n"
        "function f(m: {str\n        : i64})\n    print(1)\n"
        "function f(xs: [i64\n        ?])\n    print(1)\n"
        "function f(g: (function(i64) \n        -> i64))\n    print(1)\n"
        "function f(g: (function(a\n        : i64) -> i64))\n    print(1)\n"
        "extern \"m.h\"\n    record Db tag db\n    function g(@out: Db acquires a\n        | b)\n"
        "function main()\r\n    y = (1\r\n        + 2)\r\n"
    ]

    for text in shapes
        assert every_fix_parses(text: text, code: code)

    # Certain where going on is the only reading; in a call's arguments,
    # before a token that can also begin one, a guess, and the `,` beside it.
    group = parse("function main()\n    y = (a\n        - b)\n")
    assert group.diagnostics[0].fixes.len() == 1
    assert group.diagnostics[0].fixes[0].certainty == .certain
    call = parse("function main()\n    f(a\n        - b)\n")
    assert call.diagnostics[0].fixes.len() == 2
    assert call.diagnostics[0].fixes[0].certainty == .guess
    assert call.diagnostics[0].fixes[1].replacement == ","
    named = parse("function main()\n    f(a\n        + b)\n")
    assert named.diagnostics[0].fixes[0].certainty == .certain

test "a line end before every closer and every comma stands, and is one separator with the comma"
    for text in ["function main()\n    y = xs[0\n        ]\n", "function main()\n    xs = [1\n        , 2]\n", "function main()\n    m = {\"a\": 1\n        , \"b\": 2}\n", "function f(xs: [i64\n        ], m: {str: i64\n        }, a: i32[4\n        ])\n    print(1)\n", "function f(g: (function(a: i64\n        , b: i64\n        ) -> i64\n        ))\n    print(1)\n"]
        assert parse(text).diagnostics.len() == 0

    three = parse("function main()\n    xs = [1\n        2\n        , 3]\n")
    assert three.diagnostics.len() == 0

# Defect 123: an arm whose pattern opens with a `-` a space sets apart from
# its literal is refused once, where it compiled, and its one fix, `certain`,
# gives a program that parses: a first arm, a later one, one after a block
# arm, a joined pattern, two spaces, a character, CRLF. And the `-` alone on
# the line above an arm, the lexer's, joins without a space, to `-1`, where
# the join wrote `- 1`, which the rule refuses; the join is asked alone,
# since the parentheses offered beside it wrap a pattern (defect 126).
test "an arm opened by a minus set apart from its literal is refused, and its fix parses"
    code = "spaced_minus_element"
    shapes = [
        "function main()\n    k = match n\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        - 1 | 2 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        -  1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        - 'a' => 10\n        _ => 20\n"
        "function main()\r\n    k = match n\r\n        0 => 5\r\n        - 1 => 10\r\n        _ => 20\r\n"
    ]

    for text in shapes
        assert every_fix_parses(text: text, code: code)
        refused = parse(text)
        assert refused.diagnostics.len() == 1
        assert refused.diagnostics[0].fixes.len() == 1
        assert refused.diagnostics[0].fixes[0].certainty == .certain
        assert refused.diagnostics[0].fixes[0].replacement == "-"

    split = "function main()\n    k = match n\n        -\n        1 => 10\n        _ => 20\n"
    broken = parse(split)
    assert broken.diagnostics.len() == 1
    mend = broken.diagnostics[0].fixes[0]
    assert mend.replacement == ""
    assert mend.certainty == .certain
    joined = split.slice(from: 0, to: mend.span.start) + mend.replacement + split.slice(from: mend.span.end, to: split.len())
    assert parse(joined).diagnostics.len() == 0

test "the unary spelling, a minus after a join and a minus in an arm's body are not asked"
    for text in ["function main()\n    k = match n\n        -1 => 10\n        _ => 20\n", "function main()\n    k = match n\n        2 | - 1 => 10\n        _ => 20\n", "function main()\n    k = match n\n        0 => - 1\n        _ => 20\n"]
        assert parse(text).diagnostics.len() == 0

# Defect 126: an arm's `-` set apart from its literal by the line's end, or by
# a comment that ends it, is refused once, as a line that cannot end with
# `-`, after an inline arm and after a block arm as for the first, where the
# later ones cost three diagnostics and a `certain` join to the arm above
# that did not parse. The join writes `-1` and parses; with a comment there
# is none, and no parentheses are offered around a pattern, which takes none.
test "an arm broken after its sign is refused once, and no fix wraps a pattern"
    code = "continuation_outside_brackets"
    split = [
        "function main()\n    k = match n\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\r\n    k = match n\r\n        0 => 5\r\n        -\r\n        1 => 10\r\n        _ => 20\r\n"
    ]

    for text in split
        assert every_fix_parses(text: text, code: code)
        broken = parse(text)
        assert broken.diagnostics.len() == 1
        assert broken.diagnostics[0].fixes.len() == 1
        assert broken.diagnostics[0].fixes[0].replacement == ""

    commented = [
        "function main()\n    k = match n\n        -  # the sign\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        -  # the sign\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        -  # the sign\n        1 => 10\n        _ => 20\n"
    ]

    for text in commented
        broken = parse(text)
        assert broken.diagnostics.len() == 1
        assert broken.diagnostics[0].code == code
        assert broken.diagnostics[0].fixes.len() == 0
