# The parser's front door: text → tree in one call (design.md §3.3 — a
# library with a thin CLI on top; Part 10 step 2).
# Port of archive/bootstrap-rs/heroes/src/syntax/mod.rs::parse — the last piece of the
# syntax stage, and the one that makes the pipeline an implementation detail
# of the frontend rather than of its clients.

use token
use diag
use ast
use source
use source_extent
use cursor
use lexer
use parse/decl
use parse/apart
use parse/which_arm
use parse/quote_held
use parse/wrap_break
use parse/unclosed

record ParseOutput
    decls: [ast.Decl]
    uses: [ast.Use]
    # Every comment in the file, in source order. The tree keeps only the
    # ones that are DOCUMENTATION (§4.1); `heroes fmt` needs all of them,
    # because a formatter that drops a comment is a formatter nobody runs.
    comments: [token.Span]
    diagnostics: [diag.Diagnostic]
    # The same parse as the control arm reads it, `check --permissive`
    # (defect 131): with what a block's head held back over a line the lexer
    # joined (`parse/opening`) and what the join alone made the parser say
    # (`parse/apart`, defect 132), where the lexer's refusal of the join is a
    # thesis rule; and without what the lines say apart. That arm drops the
    # refusal and reads the join as the program, for which the held report is
    # the only one.
    control: [diag.Diagnostic]
    tree: ast.Ast
    # Every token the lexer made, the root file's first: `heroes fmt` reads
    # from them what the tree does not keep, which line a statement ends on
    # and which block a comment is in (`print/owners.hero`), and lexing the
    # file again for it cost a third of `fmt`'s time.
    tokens: [token.Token]

# Lex and parse one file in a single call.
#
# Diagnostics come out lexer-first, then parser, which keeps them grouped by
# the stage that can explain them; within a stage they are in source order.
# Never sorted across stages: a shape error and the word error that caused it
# read better together than interleaved by column.
function parse(text: str) -> ParseOutput
    return parse_bounded(text: text, root_end: -1)

# The whole compilation parsed the way the CLI must: every file lexed as
# its own text (lexer.lex's rule — the indent level and the open
# brackets must not cross a file boundary), and the cursor told where
# the author's text stops so no diagnostic anchors inside the library.
#
# **And every file PARSED as its own stream**, one cursor each, over the
# tokens that end at that file's own eof (found beside defect 109,
# 2026-09-27). One cursor over the joined stream let a declaration that a
# file left open go on into the next file: its diagnostic landed in a file
# the mistake is not in, the library's included, and a bodiless function
# at a module's end took the next module's indented first lines as its
# body and ran. The tree, the declarations and the uses are still one, in
# load order, and the joined stream is still what every other reader gets.
function parse_source(s: source.Source) -> ParseOutput
    files = lexer.lex_files(s)
    lexed = lexer.joined(s, files: files)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    lexer_said: [diag.Diagnostic] @ []
    normal: [diag.Diagnostic] @ []
    controlled: [diag.Diagnostic] @ []
    bound = source_extent.root_end(s)
    index: i64 @ 0

    for one in files
        lexed_file: lexer.LexOutput @ one
        c: cursor.Cursor @ cursor.lexed_cursor(
            tokens: lexed_file.tokens,
            root_end: bound,
            closes: lexed_file.closes,
            swaps: lexed_file.swaps
        )
        decl.file(@c, @a, @decls, @uses, s.text)

        # Where the lexer refused a break, the file is read apart too, and
        # what the join alone made the parser say is held (defect 132); the
        # joins it shows no repair are `guess`es, so the lexer's diagnostics
        # are taken after it.
        if lexed_file.breaks.len() > 0
            lines = lexer.moved(lexer.lex_apart(source_extent.text_of(s, index)), offset: s.files[index].start)
            apart.weigh(@c, lexed: @lexed_file, apart: lines, text: s.text)
        said = quote_held.held(
            which_arm.placed(c, lexed: lexed_file.diagnostics),
            lexed: lexed_file.diagnostics,
            text: s.text
        )

        for d in lexed_file.diagnostics
            lexer_said @ lexer_said.push(d)

        for d in said.normal
            normal @ normal.push(d)

        for d in said.control
            controlled @ controlled.push(d)

        index @ index + 1

    # A brace habit's `{` that never closed is told once, by the parser.
    diagnostics: [diag.Diagnostic] @ unclosed.withdrawn(lexed: lexer_said, said: normal, text: s.text)
    control: [diag.Diagnostic] @ unclosed.withdrawn(lexed: lexer_said, said: controlled, text: s.text)

    for d in normal
        diagnostics @ diagnostics.push(d)

    for d in controlled
        control @ control.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: wrap_break.offer(diagnostics, tokens: lexed.tokens, a: a, text: s.text),
        control: wrap_break.offer(control, tokens: lexed.tokens, a: a, text: s.text),
        tree: a,
        tokens: lexed.tokens
    )

# The same parse, told where the author's own text stops — what the CLI
# uses, because a compilation is the author's file plus every module it
# reaches plus the library (§1.11), and a diagnostic must never point
# inside the last of those.
function parse_bounded(text: str, root_end: i64) -> ParseOutput
    lexed: lexer.LexOutput @ lexer.lex_one(text)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    c: cursor.Cursor @ cursor.lexed_cursor(
        tokens: lexed.tokens,
        root_end: root_end,
        closes: lexed.closes,
        swaps: lexed.swaps
    )
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    decl.file(@c, @a, @decls, @uses, text)

    # As `parse_source` does, a text the lexer refused a break in is read apart.
    if lexed.breaks.len() > 0
        apart.weigh(@c, lexed: @lexed, apart: lexer.lex_apart(text), text: text)
    said = quote_held.held(which_arm.placed(c, lexed: lexed.diagnostics), lexed: lexed.diagnostics, text: text)
    diagnostics: [diag.Diagnostic] @ unclosed.withdrawn(lexed: lexed.diagnostics, said: said.normal, text: text)
    control: [diag.Diagnostic] @ unclosed.withdrawn(lexed: lexed.diagnostics, said: said.control, text: text)

    for d in said.normal
        diagnostics @ diagnostics.push(d)

    for d in said.control
        control @ control.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: wrap_break.offer(diagnostics, tokens: lexed.tokens, a: a, text: text),
        control: wrap_break.offer(control, tokens: lexed.tokens, a: a, text: text),
        tree: a,
        tokens: lexed.tokens
    )

# Which file each diagnostic of a parse points into, in order.
function files_of(s: source.Source, p: ParseOutput) -> [i64]
    out: [i64] @ []

    for d in p.diagnostics
        out @ out.push(source.file_of(s, d.span.start))

    return out

test "a declaration a file leaves open is refused in that file, and the library's is not read"
    s = source.with_library(name: "main.hero", user: "function main()\n", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "missing_body"
    assert files_of(s, p) == [0]
    assert p.decls.len() == 1

test "a module's first indented lines are not the body of the module before it"
    # Two modules, each refused alone: before the repair the first one's
    # bodiless `two` took the second one's first lines and the program ran.
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "function two() -> i64\n")
        source.user_file(name: "b.hero", text: "    return 2\n\nfunction three() -> i64\n    return 3\n")
    ]
    s = source.from_files(inputs)
    p = parse_source(s)
    assert p.diagnostics.len() == 2
    assert p.diagnostics[0].code == "missing_body"
    assert p.diagnostics[1].code == "expected_declaration"
    assert files_of(s, p) == [0, 1]
    assert p.decls.len() == 1

test "an empty file parses to nothing, before the library and between two modules"
    s = source.with_library(name: "main.hero", user: "", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "constant A: i64\n    1\n")
        source.user_file(name: "b.hero", text: "")
        source.user_file(name: "c.hero", text: "constant C: i64\n    3")
    ]
    three = parse_source(source.from_files(inputs))
    assert three.diagnostics.len() == 0
    assert three.decls.len() == 2

test "text becomes a tree in one call, comments and all"
    text = "# a note\nconstant MAX: i64\n    64  # trailing\n"
    p = parse(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1

    # BOTH comments are kept for the formatter; the tree keeps only the doc.
    assert p.comments.len() == 2
    assert p.decls[0].doc.len() == 1

test "diagnostics come out lexer-first, then parser"
    # A tab (the lexer's mistake) on line 2, a stray name at top level (the
    # parser's) on line 3: the lexer's diagnostic must come out first even
    # though recovery means both are found.
    text = "constant MAX: i64\n\t64\njunk\n"
    p = parse(text)
    assert p.diagnostics.len() >= 2
    assert p.diagnostics[0].code == "tab_in_indentation"
    assert p.diagnostics[p.diagnostics.len() - 1].code == "expected_declaration"

# Whether `text`'s diagnostics are all `code`, at least one, and every fix
# they carry, applied alone, gives a program the parser accepts: the promise
# panel 180 made of its two refusals, `spaced_minus_element` (R2) and
# `line_end_before_continuation` (R3), where a `guess` fix is never applied by
# `check --apply` and so nothing else would ever run one.
function every_fix_parses(text: str, code: str) -> bool
    first = parse(text)
    applied: i64 @ 0

    for d in first.diagnostics
        if d.code != code
            return false

        for fix in d.fixes
            fixed = text.slice(from: 0, to: fix.span.start) + fix.replacement + text.slice(from: fix.span.end, to: text.len())

            if parse(fixed).diagnostics.len() > 0
                return false
            applied @ applied + 1

    return applied > 0

test "a minus set apart from its operand in a list is refused, and each reading parses"
    code = "spaced_minus_element"
    assert every_fix_parses(text: "function main()\n    xs = [a\n        - b]\n", code: code)
    assert every_fix_parses(
        text: "function main()\n    xs = [a\n        -  # the sign, then a comment\n        b]\n",
        code: code
    )
    assert every_fix_parses(text: "function main()\n    xs = [a\n        -\n        b]\n", code: code)
    assert every_fix_parses(text: "function main()\n    xs = [a  # trailing the line above\n        - b]\n", code: code)
    assert every_fix_parses(text: "function main()\n    xs = [[a\n        - b]]\n", code: code)
    assert every_fix_parses(text: "function main()\n    print([1.5\n        - 2.5].len())\n", code: code)
    assert every_fix_parses(text: "function main()\r\n    xs = [a\r\n        - b]\r\n", code: code)

    # A map's line says which reading parses, and only that one is offered.
    key = parse("function main()\n    m = {1: 10\n        - 2: 20}\n")
    assert key.diagnostics.len() == 1
    assert key.diagnostics[0].fixes.len() == 1
    assert every_fix_parses(text: "function main()\n    m = {1: 10\n        - 2: 20}\n", code: code)
    value = parse("function main()\n    m = {\"k\": a\n        - b}\n")
    assert value.diagnostics.len() == 1
    assert every_fix_parses(text: "function main()\n    m = {\"k\": a\n        - b}\n", code: code)

test "the first element, a written comma, and the unary spelling are not asked"
    for text in ["function main()\n    xs = [\n        - 1\n        2\n    ]\n", "function main()\n    xs = [a,\n        - b]\n", "function main()\n    xs = [a\n        , - b]\n", "function main()\n    xs = [a\n        -b\n        -1]\n"]
        assert parse(text).diagnostics.len() == 0

# Panel 181: every fix of a line broken outside brackets, the join and the
# parentheses the parser offers, applied alone, gives a program that parses.
test "a line broken outside brackets is refused once, and each of its repairs parses"
    code = "continuation_outside_brackets"

    for text in ["function main()\n    y = a +\n    1\n", "function main()\n    y = a +\n        1\n", "function main()\n    if a &&\n    b\n        print(1)\n", "function main()\n    y = xs.\n    len()\n", "function main()\n    y = a +  # a note\n    1\n", "function main()\n    total = base\n    - fee\n", "function main()\n    x = f()\n    ?\n", "function main()\n    if c\n        y = a +\n    b\n"]
        assert every_fix_parses(text: text, code: code)

    wrapped = parse("function main()\n    y = a +\n    1\n")
    assert wrapped.diagnostics[0].fixes.len() == 2
    assert wrapped.diagnostics[0].fixes[1].replacement == "(a +\n    1)"
    assert wrapped.diagnostics[0].fixes[1].certainty == .guess
    head = parse("function main()\n    total = base\n    - fee\n")
    assert head.diagnostics[0].fixes.len() == 1
    arrow = parse("function main()\n    y =\n    a\n")
    assert arrow.diagnostics[0].fixes.len() == 1

    # An `if` cannot stand inside brackets, so the `else` over `if` break,
    # whose only expression is the `if`, takes the join alone.
    block = parse("function main()\n    if c\n        return\n    else\n    if d\n        return\n")
    assert block.diagnostics[0].fixes.len() == 1
    assert every_fix_parses(
        text: "function main()\n    if c\n        return\n    else\n    if d\n        return\n",
        code: "continuation_outside_brackets"
    )

test "a line end before what goes on with the line above names itself, and its fix parses"
    code = "line_end_before_continuation"
    shapes = [
        "function main()\n    y = (1\n        + 2)\n"
        "function main()\n    y = (1  # trailing the line above\n        + 2)\n"
        "function main()\n    y = (1\n        +  # after the operator\n        2)\n"
        "function main()\n    y = (1\n        +\n        2)\n"
        "function main()\n    y = (xs\n        .len())\n"
        "function main()\n    y = (f\n        (1))\n"
        "function main()\n    y = (f()\n        ?)\n"
        "function main()\n    y = (Point\n        ::x)\n"
        "function main()\n    y = xs[i\n        + 1]\n"
        "function main()\n    f(a\n        + b)\n"
        "function main()\n    f(a\n        - b)\n"
        "function main()\n    f(a\n        : 1)\n"
        "function main()\n    xs = [1\n        + 2]\n"
        "function main()\n    xs = [f()\n        ?]\n"
        "function main()\n    m = {\"a\"\n        : 1}\n"
        "function main()\n    m = {\"a\": 1\n        * 2}\n"
        "function f(a\n        : i64)\n    print(a)\n"
        "function f(a: i64\n        ?)\n    print(1)\n"
        "function f(p: geom\n        .Point)\n    print(1)\n"
        "function f(m: {str\n        : i64})\n    print(1)\n"
        "function f(xs: [i64\n        ?])\n    print(1)\n"
        "function f(g: (function(i64) \n        -> i64))\n    print(1)\n"
        "function f(g: (function(a\n        : i64) -> i64))\n    print(1)\n"
        "extern \"m.h\"\n    record Db tag db\n    function g(@out: Db acquires a\n        | b)\n"
        "function main()\r\n    y = (1\r\n        + 2)\r\n"
    ]

    for text in shapes
        assert every_fix_parses(text: text, code: code)

    # Certain where going on is the only reading; in a call's arguments,
    # before a token that can also begin one, a guess, and the `,` beside it.
    group = parse("function main()\n    y = (a\n        - b)\n")
    assert group.diagnostics[0].fixes.len() == 1
    assert group.diagnostics[0].fixes[0].certainty == .certain
    call = parse("function main()\n    f(a\n        - b)\n")
    assert call.diagnostics[0].fixes.len() == 2
    assert call.diagnostics[0].fixes[0].certainty == .guess
    assert call.diagnostics[0].fixes[1].replacement == ","
    named = parse("function main()\n    f(a\n        + b)\n")
    assert named.diagnostics[0].fixes[0].certainty == .certain

test "a line end before every closer and every comma stands, and is one separator with the comma"
    for text in ["function main()\n    y = xs[0\n        ]\n", "function main()\n    xs = [1\n        , 2]\n", "function main()\n    m = {\"a\": 1\n        , \"b\": 2}\n", "function f(xs: [i64\n        ], m: {str: i64\n        }, a: i32[4\n        ])\n    print(1)\n", "function f(g: (function(a: i64\n        , b: i64\n        ) -> i64\n        ))\n    print(1)\n"]
        assert parse(text).diagnostics.len() == 0

    three = parse("function main()\n    xs = [1\n        2\n        , 3]\n")
    assert three.diagnostics.len() == 0

# Defect 123: an arm whose pattern opens with a `-` a space sets apart from
# its literal is refused once, where it compiled, and every fix gives a
# program that parses: a first arm, a later one, one after a block arm, a
# joined pattern, two spaces, a character, CRLF. Panel 185 R6: before an
# integer or a character the sign and a bullet are both readings, so both
# fixes are guesses, where the sign was `certain` and a bulleted `- 1` beside
# `_` was applied into `-1` (the sitting's t7); before a string the `-` signs
# nothing, and its deletion is certain; and a tab setting the `-` apart goes
# with it, where the sign wrote the tab into the margin. And the `-` alone on
# the line above an arm, the lexer's, joins without a space, to `-1`, where
# the join wrote `- 1`, which the rule refuses; the join is asked alone,
# since the parentheses offered beside it wrap a pattern (defect 126).
test "an arm opened by a minus set apart from its literal is refused, and its fixes parse"
    code = "spaced_minus_element"
    shapes = [
        "function main()\n    k = match n\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        - 1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        - 1 | 2 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        -  1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        - 'a' => 10\n        _ => 20\n"
        "function main()\r\n    k = match n\r\n        0 => 5\r\n        - 1 => 10\r\n        _ => 20\r\n"
    ]

    for text in shapes
        assert every_fix_parses(text: text, code: code)
        refused = parse(text)
        assert refused.diagnostics.len() == 1
        assert refused.diagnostics[0].fixes.len() == 2
        assert refused.diagnostics[0].fixes[0].certainty == .guess
        assert refused.diagnostics[0].fixes[0].replacement == "-"
        assert refused.diagnostics[0].fixes[1].certainty == .guess
        assert refused.diagnostics[0].fixes[1].replacement == ""

    strings = [
        "function main()\n    k = match s\n        - \"a\" => 10\n        _ => 20\n"
        "function main()\n    k = match s\n        \"x\" => 5\n        -  \"a\" | \"b\" => 10\n        _ => 20\n"
    ]

    for text in strings
        assert every_fix_parses(text: text, code: code)
        deleted = parse(text)
        assert deleted.diagnostics.len() == 1
        assert deleted.diagnostics[0].fixes.len() == 1
        assert deleted.diagnostics[0].fixes[0].certainty == .certain
        assert deleted.diagnostics[0].fixes[0].replacement == ""

    tabbed = "function main()\n    k = match n\n        -\t1 => 10\n        _ => 20\n"
    mended: i64 @ 0

    for d in parse(tabbed).diagnostics
        if d.code == code
            for fix in d.fixes
                written = tabbed.slice(from: 0, to: fix.span.start) + fix.replacement + tabbed.slice(from: fix.span.end, to: tabbed.len())
                assert parse(written).diagnostics.len() == 0
                mended @ mended + 1

    assert mended == 2

    split = "function main()\n    k = match n\n        -\n        1 => 10\n        _ => 20\n"
    broken = parse(split)
    assert broken.diagnostics.len() == 1
    mend = broken.diagnostics[0].fixes[0]
    assert mend.replacement == ""
    assert mend.certainty == .certain
    joined = split.slice(from: 0, to: mend.span.start) + mend.replacement + split.slice(from: mend.span.end, to: split.len())
    assert parse(joined).diagnostics.len() == 0

test "the unary spelling, a minus after a join and a minus in an arm's body are not asked"
    for text in ["function main()\n    k = match n\n        -1 => 10\n        _ => 20\n", "function main()\n    k = match n\n        2 | - 1 => 10\n        _ => 20\n", "function main()\n    k = match n\n        0 => - 1\n        _ => 20\n"]
        assert parse(text).diagnostics.len() == 0

# Defect 126: an arm's `-` set apart from its literal by the line's end, or by
# a comment that ends it, is refused once, as a line that cannot end with
# `-`, after an inline arm and after a block arm as for the first, where the
# later ones cost three diagnostics and a `certain` join to the arm above
# that did not parse. The join writes `-1` and parses; with a comment there
# is none, and no parentheses are offered around a pattern, which takes none.
test "an arm broken after its sign is refused once, and no fix wraps a pattern"
    code = "continuation_outside_brackets"
    split = [
        "function main()\n    k = match n\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        -\n        1 => 10\n        _ => 20\n"
        "function main()\r\n    k = match n\r\n        0 => 5\r\n        -\r\n        1 => 10\r\n        _ => 20\r\n"
    ]

    for text in split
        assert every_fix_parses(text: text, code: code)
        broken = parse(text)
        assert broken.diagnostics.len() == 1
        assert broken.diagnostics[0].fixes.len() == 1
        assert broken.diagnostics[0].fixes[0].replacement == ""

    commented = [
        "function main()\n    k = match n\n        -  # the sign\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 => 5\n        -  # the sign\n        1 => 10\n        _ => 20\n"
        "function main()\n    k = match n\n        0 =>\n            print(0)\n            5\n        -  # the sign\n        1 => 10\n        _ => 20\n"
    ]

    for text in commented
        broken = parse(text)
        assert broken.diagnostics.len() == 1
        assert broken.diagnostics[0].code == code
        assert broken.diagnostics[0].fixes.len() == 0

# Defect 124: after at most one `-`, a pattern takes one literal token, an
# integer, a string or a character (spec § 8), and nothing goes on after it,
# where the pattern went through the expression parser's `unary` and took a
# name, a call, a group, an index, a float, a second sign and every suffix.
# Each is refused once, as no pattern, and the production's own spellings
# parse as before, `-"a"` included, which the checker refuses by its type.
test "a pattern takes one literal after its sign, and nothing after the literal"
    refused = [
        "-m"
        "- m"
        "-one()"
        "-(1)"
        "-xs[0]"
        "--1"
        "- -1"
        "-1.5"
        "1.5"
        "\"ab\".len()"
        "'a'.to_i64()"
        "-.a"
        "-true"
        "0 | -m"
    ]

    for shape in refused
        got = parse("function main()\n    k = match n\n        " + shape + " => 10\n        _ => 20\n")
        assert got.diagnostics.len() == 1
        assert got.diagnostics[0].code == "expected_pattern"

    for shape in ["-1", "-0", "-'a'", "-\"a\"", "-0x1f", "1 | -2", "-9223372036854775808", "\"ab\" | \"c\""]
        assert parse("function main()\n    k = match n\n        " + shape + " => 10\n        _ => 20\n").diagnostics.len() == 0

# The codes of a parse's diagnostics, in order: what the tests below compare.
function codes(diagnostics: [diag.Diagnostic]) -> [str]
    out: [str] @ []

    for d in diagnostics
        out @ out.push(d.code)

    return out

# Defect 130: a statement that failed drops only what is left of its own line,
# so the statement after a block holding a mistake is read, at every level a
# mistake closes; and a thesis rule is no failure, so nothing is dropped on
# its account, and the control arm, which drops the rule, is not left with
# nothing to say.
test "a failed statement drops only its own line, and a thesis rule drops none"
    eol = "expected_end_of_line"
    after_a_match = parse(
        "function main()\n    k = match n\n        + => 10\n        _ => 20\n    y = 3 )\n    z = 4 )\n"
    )
    assert codes(after_a_match.diagnostics) == ["expected_pattern", eol, eol]
    nested = parse(
        "function main()\n    for i in xs\n        if c\n            y = 3 )\n        z = 4 )\n    w = 5 )\n"
    )
    assert codes(nested.diagnostics) == [eol, eol, eol]
    past_a_comment = parse("function main()\n    while c\n    # a note\n    z = 4 )\n")
    assert codes(past_a_comment.diagnostics) == ["missing_body", eol]
    thesis = parse("function main()\n    match n\n        0 => x = 5\n        _ => print(2)\n    z = 4 )\n")
    assert codes(thesis.diagnostics) == ["declaration_in_arm", eol]
    assert codes(thesis.control) == ["declaration_in_arm", eol]

# Defect 131: a head that refused something drops the rest of its line and
# reads the body below it; with no body, it is named at the line below unless
# the head's recovery ran past its own line; and over a line the lexer joined
# to it, what it would say of the body is the control arm's alone.
test "a failed head reads its body, and a joined one leaves its report to the control arm"
    over_a_body = parse("function main()\n    if n > )\n        y = 3 )\n    print(2)\n")
    assert codes(over_a_body.diagnostics) == ["expected_expression", "expected_end_of_line"]
    match_head = parse("function main()\n    match )\n        + => print(1)\n        _ => print(2)\n")
    assert codes(match_head.diagnostics) == ["expected_expression", "expected_pattern"]
    no_body = parse("function main()\n    if n > )\n    print(2)\n")
    assert codes(no_body.diagnostics) == ["expected_expression", "missing_body"]
    crossed = parse("function main()\n    if (n > 0\n        y = 3 )\n    z = 4 )\n")
    assert codes(crossed.diagnostics) == ["expected_group_close", "expected_end_of_line"]
    joined = parse("function main()\n    if n >\n        print(1)\n    z = 4 )\n")
    assert codes(joined.diagnostics) == ["continuation_outside_brackets", "expected_end_of_line"]
    assert codes(joined.control) == ["continuation_outside_brackets", "missing_body", "expected_end_of_line"]
    assert joined.control[1].span.start == joined.control[2].span.start - 6

# Defect 130's second round: a block below a line that reported is read and
# not named, and one below a whole arm is named, where it was dropped from a
# program that ran. Since the recovery cluster's C4 (2026-10-02) a block below
# a line that can open none, `x = )`, is named once too, and read.
test "a hanging block is read, and an orphan under an arm is named"
    eol = "expected_end_of_line"
    hanging = parse("function main()\n    x = )\n        z = 4 )\n")
    assert codes(hanging.diagnostics) == ["expected_expression", "unexpected_block", eol]
    misspelled = parse("function main()\n    iff x > 1\n        z = 4 )\n")
    assert codes(misspelled.diagnostics) == [eol, eol]
    arms = parse("function main()\n    mach n\n        0 => print(0) )\n        _ => print(1)\n")
    assert codes(arms.diagnostics) == [eol, eol]
    orphan = parse(
        "function main()\n    match 0\n        0 => print(1)\n            print(99)\n        _ => print(2)\n"
    )
    assert codes(orphan.diagnostics) == ["unexpected_block"]
    kept = parse("function main()\n    x = a\n        and b\n")
    assert codes(kept.diagnostics) == ["unexpected_block"]

# Defect 131's second round: a head cut short and a list cut short each
# report once, and a body whose margin holds a tab is the body, the lexer's
# refusal of the tab its one report.
test "a head or a list cut short reports once, and a tabbed body is a body"
    eol = "expected_end_of_line"
    bare_for = parse("function main()\n    for\n        x = 1\n")
    assert codes(bare_for.diagnostics) == ["for_missing_in"]
    assert bare_for.diagnostics[0].fixes[0].certainty == .guess
    for_at_the_end = parse("function main()\n    for\n")
    assert codes(for_at_the_end.diagnostics) == ["for_missing_in"]
    open_list = parse("function f(\n    y = 3 )\n")
    assert codes(open_list.diagnostics) == ["expected_parameter_type"]
    literal = parse("function main()\n    xs = [1 2]\n    m = {1: 2, )}\n")
    assert codes(literal.diagnostics) == ["expected_separator", "expected_expression"]
    tabbed = parse("function main()\n    if true\n\ty = 3 )\n    z = 4 )\n")
    assert codes(tabbed.diagnostics) == ["tab_in_indentation", eol, eol]
    assert codes(tabbed.control) == ["tab_in_indentation", eol, eol]
    whole = parse("function main()\n\tprint(1)\n")
    assert codes(whole.diagnostics) == ["tab_in_indentation"]

# Defect 131's class, lane recovery-b2: a group, a call's arguments, an index
# or a literal inside one whose opener the lexer found never closed ends at
# its line end, which it leaves where it stands, and names no closer; a line
# below it that goes on with it is refused as it is above a closer.
test "a construct the lexer named never closed ends at its line, and a line going on is refused"
    for text in ["function main()\n    x = (1 + 2\n    print(x)\n", "function main()\n    print(1, 2\n    print(3)\n", "function main()\n    x = xs[1\n    print(x)\n", "function main()\n    x = f(1,\n        2\n    print(x)\n"]
        assert codes(parse(text).diagnostics) == ["unclosed_bracket"]

    nested = parse("function main()\n    xs = [[1], [2\n    print(xs)\n")
    assert codes(nested.diagnostics) == ["unclosed_bracket", "unclosed_bracket"]

    for text in ["function main()\n    x = (1\n    + 2\n    print(x)\n", "function main()\n    xs = [1\n    + 2\n    print(xs)\n"]
        assert codes(parse(text).diagnostics) == ["unclosed_bracket", "line_end_before_continuation"]

# Defect 131's class, lane recovery-b2: braces the lexer named never closed at
# a declaration's line end there, and a brace habit's `{` that never closed
# is told once, by the parser, in both arms; a `(` beside another report keeps
# the two, since its report may be another mistake.
test "a brace habit's never closed brace is told once, and its braces end at the next declaration"
    braced = parse("record P {\n    x: i64\n\nfunction main()\n    print(1) )\n")
    assert codes(braced.diagnostics) == ["expected_end_of_line", "expected_end_of_line"]
    assert codes(braced.control) == ["expected_end_of_line", "expected_end_of_line"]
    assert codes(parse("function main() {\n    print(1)\n").diagnostics) == ["missing_body"]

    # A head with no name over nothing lacks its body too, told as after
    # `function f(a: i64`, nothing being in the bracket's reach (defect 133's
    # class, lane recovery-b7).
    assert codes(parse("function (a: i64\n").diagnostics) == ["unclosed_bracket", "expected_name", "missing_body"]

# Defect 131's class, lane recovery-b2 (U5): a signature's `(` the lexer named
# never closed ends at its line and names no closer; the lines below, read
# inside the bracket, are no body, left unsaid and passed over; with nothing
# in the bracket's reach the body is named missing; and a statement head's
# lines are read as the block's own.
test "a head that left a bracket open is told once, and its swallowed body passed over"
    eol = "expected_end_of_line"
    swallowed = parse("function f(a: i64\n    print(a)\n\nfunction main()\n    print(1) )\n")
    assert codes(swallowed.diagnostics) == ["unclosed_bracket", eol]
    nothing = parse("function f(a: i64\n\nfunction main()\n    print(1)\n")
    assert codes(nothing.diagnostics) == ["unclosed_bracket", "missing_body"]
    statement = parse("function main()\n    if f(a\n        print(a)\n    print(2) +\n")
    assert codes(statement.diagnostics) == ["unclosed_bracket", "expected_expression"]

# Defect 131's third round: `while` is a `certain` repair of a `for` only
# before a token that begins an expression, and an operand that could not be
# read ends its expression, so `while >` is refused once.
test "a for over what begins no expression is a guess, and while > is refused once"
    over_an_operator = parse("function main()\n    for >\n        x = 1\n")
    assert codes(over_an_operator.diagnostics) == ["for_missing_in"]
    assert over_an_operator.diagnostics[0].fixes[0].certainty == .guess
    over_a_condition = parse("function main()\n    for !done\n        x = 1\n")
    assert over_a_condition.diagnostics[0].fixes[0].certainty == .certain
    assert codes(parse("function main()\n    while >\n        x = 1\n").diagnostics) == ["expected_expression"]
    assert codes(parse("function main()\n    while :\n        x = 1\n").diagnostics) == ["expected_expression"]
    assert codes(parse("function main()\n    x = 1 + >\n").diagnostics) == ["expected_expression"]

# Defect 132: a join into a line the parser refuses only because it is joined
# costs the break alone, and the control arm, which reads the join as the
# program, says what the join made the parser say; the test is the lines read
# apart (`parse/apart`), not a list of shapes.
test "a join the parser refuses only as joined costs the break alone"
    cob = "continuation_outside_brackets"
    eol = "expected_end_of_line"
    arm = "function main()\n    k = match n\n        "

    for shape in ["0 => 5 -\n        1 => 10\n", "0 =>\n        _ => 2\n", "0 => 5 -\n        # a note\n        1 => 10\n"]
        joined = parse(arm + shape + "        _ => 20\n")
        assert codes(joined.diagnostics) == [cob]
        assert codes(joined.control) == [cob, eol]

    # A line that holds an arm's `=>` below a whole arm is no break but an arm,
    # whose operator is its pattern's one mistake (defect 132's last row); an
    # arm's patterns broken before a `|` are a break, whose join is the arm.
    for shape in ["0 => 5\n        | 1 => 10\n", "0 => 1\n        * 2 => 3\n"]
        own = parse(arm + shape + "        _ => 20\n")
        assert codes(own.diagnostics) == ["expected_pattern"]
        assert codes(own.control) == ["expected_pattern"]

    alternation = parse(arm + "0\n        | 1 => 10\n        _ => 20\n")
    assert codes(alternation.diagnostics) == [cob]
    assert codes(alternation.control) == [cob]

    crlf = parse("function main()\r\n    k = match n\r\n        0 => 5 -\r\n        1 => 10\r\n")
    assert codes(crlf.diagnostics) == [cob]
    crlf_head = parse("function main()\r\n    for\r\n        print(1)\r\n")
    assert codes(crlf_head.diagnostics) == [cob]
    crlf_empty = parse("function main()\r\n    k = match n\r\n        0 =>\r\n        _ => 2\r\n")
    assert codes(crlf_empty.diagnostics) == [cob]
    assert crlf_empty.diagnostics[0].fixes[0].certainty == .guess
    heads = [
        "function main()\n    for\n        print(1)\n"
        "function main()\n    match >\n        _ => print(1)\n"
        "record\n    x: i64\n"
        "variant\n    a\n\nfunction main()\n    print(1)\n"
        "constant\n    3\n"
        "function\n    print(1)\n\nfunction main()\n    print(2)\n"
    ]

    for text in heads
        refused = parse(text)
        assert codes(refused.diagnostics) == [cob]
        assert refused.control.len() > 1

    # A body the lines lack apart as well is the author's to be told of.
    same = parse("function main()\n    for\n    print(1)\n")
    assert codes(same.diagnostics) == [cob, "missing_body"]
    assert codes(same.control) == [cob, "for_missing_in", "missing_body"]

# ... and a mistake the lines make apart is said as it would be apart, where
# the joined reading never reached it: the stray `)` of each line below.
test "a mistake the lines make apart is still said beside the break"
    cob = "continuation_outside_brackets"
    eol = "expected_end_of_line"
    shapes = [
        "function main()\n    k = match n\n        0 => 5 -\n        1 => 10 )\n        _ => 20\n"
        "function main()\n    k = match n\n        0\n        | 1 => 10 )\n        _ => 20\n"
        "function main()\n    for\n        print(1) )\n"
        "function main()\n    if\n        print(1) )\n"
        "function main()\n    x = n +\n    n )\n"
        "function main()\n    x = n +\n    n +\n    n )\n"
        "function main()\n    x = n\n    + n\n    + n )\n"
        "record\n    x: i64 )\n"
    ]

    for text in shapes
        got = parse(text)
        assert got.diagnostics[0].code == cob
        last = got.diagnostics[got.diagnostics.len() - 1]
        assert text.slice(from: last.span.start, to: last.span.end) == ")"

    # An arm whose pattern begins with an operator, below a whole arm, is
    # read past the operator, and its `)` is said beside its pattern's report.
    pipe = parse("function main()\n    k = match n\n        0 => 5\n        | 1 => 10 )\n        _ => 20\n")
    assert codes(pipe.diagnostics) == ["expected_pattern", eol]
    before = parse("function main()\n    x = ) +\n    n )\n")
    assert codes(before.diagnostics) == [cob, "expected_expression", eol]
    tabbed = parse("function\n\ty = 3 )\n")
    assert codes(tabbed.diagnostics) == ["tab_in_indentation", "expected_name", eol]

# ... and a join whose joined reading the parser refuses for the join alone
# repairs nothing, so it and every join of its statement are a `guess`, where
# `0 =>` over `_ => 2` was `certain` and `--apply` wrote `0 => _ => 2`; a join
# that leaves the author's own mistake standing keeps its certainty.
test "a join the parser refuses only as joined is a guess, with its statement's"
    for text in ["function main()\n    k = match n\n        0 =>\n        _ => 2\n", "record\n    x: i64\n", "constant\n    3\n", "variant\n    a\n\nfunction main()\n    print(1)\n"]
        refused = parse(text)
        assert refused.diagnostics[0].fixes[0].certainty == .guess

    chain = parse("function main()\n    k = match n\n        0 => a +\n        b +\n        _ => 2\n")
    assert codes(chain.diagnostics) == ["continuation_outside_brackets", "continuation_outside_brackets"]
    assert chain.diagnostics[0].fixes[0].certainty == .guess
    assert chain.diagnostics[1].fixes[0].certainty == .guess
    own = parse("function main()\n    x = n +\n    n )\n")
    assert own.diagnostics[0].fixes[0].certainty == .certain

# Defect 133's class, lane 133's finding: `elif` opening its line in an `if`'s
# chain is read as the `else if` its certain swap writes, and `switch` where
# an expression begins as its `match`, so the construct's own mistakes are
# told beside the lexer's `reserved_word` and nothing else is.
test "elif and switch are read as their certain swaps write them"
    rw = "reserved_word"
    chain = parse(
        "function main()\n    if x == 1\n        print(1)\n    elif x == 2\n        print(2)\n    else\n        print(3)\n"
    )
    assert codes(chain.diagnostics) == [rw]
    own = parse("function main()\n    if x == 1\n        print(1)\n    elif x == )\n        print(2)\n")
    assert codes(own.diagnostics) == [rw, "expected_expression"]
    stray = parse("function main()\n    elif x == 2\n        print(2)\n")
    assert codes(stray.diagnostics)[0] == rw
    switch_arms = parse("function main()\n    y = switch x\n        + => 2\n        _ => 3\n")
    assert codes(switch_arms.diagnostics) == [rw, "expected_pattern"]

# Defect 131's class, lane 133's finding: what goes on past a head over a body
# that is there is the one mistake, named as junk, and the body is read and
# never called absent; with no body below, the body is named missing, found
# the junk, as before.
test "junk past a head over its body is named as junk, and the body is read"
    eol = "expected_end_of_line"

    for text in ["function f() )\n    x = 3\n", "constant K: i64 )\n    5\n", "test \"t\" )\n    assert true\n", "function main()\n    while c )\n        print(1)\n", "function main()\n    match n )\n        _ => print(1)\n"]
        assert codes(parse(text).diagnostics) == [eol]

    inside = parse("function f() )\n    x = 3 )\n")
    assert codes(inside.diagnostics) == [eol, eol]
    assert codes(parse("function f() )\n\nfunction main()\n    print(1)\n").diagnostics) == ["missing_body"]
    assert codes(parse("function main()\n    if c )\n    print(1)\n").diagnostics) == ["missing_body"]
