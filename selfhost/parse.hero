# The parser's front door: text → tree in one call (design.md §3.3 — a
# library with a thin CLI on top; Part 10 step 2).
# Port of archive/bootstrap-rs/heroes/src/syntax/mod.rs::parse — the last piece of the
# syntax stage, and the one that makes the pipeline an implementation detail
# of the frontend rather than of its clients.

use token
use diag
use ast
use source
use source_extent
use cursor
use lexer
use parse/decl

record ParseOutput
    decls: [ast.Decl]
    uses: [ast.Use]
    # Every comment in the file, in source order. The tree keeps only the
    # ones that are DOCUMENTATION (§4.1); `heroes fmt` needs all of them,
    # because a formatter that drops a comment is a formatter nobody runs.
    comments: [token.Span]
    diagnostics: [diag.Diagnostic]
    tree: ast.Ast
    # Every token the lexer made, the root file's first: `heroes fmt` reads
    # from them what the tree does not keep, which line a statement ends on
    # and which block a comment is in (`print/owners.hero`), and lexing the
    # file again for it cost a third of `fmt`'s time.
    tokens: [token.Token]

# Lex and parse one file in a single call.
#
# Diagnostics come out lexer-first, then parser, which keeps them grouped by
# the stage that can explain them; within a stage they are in source order.
# Never sorted across stages: a shape error and the word error that caused it
# read better together than interleaved by column.
function parse(text: str) -> ParseOutput
    return parse_bounded(text: text, root_end: -1)

# The whole compilation parsed the way the CLI must: every file lexed as
# its own text (lexer.lex's rule — the indent level and the open
# brackets must not cross a file boundary), and the cursor told where
# the author's text stops so no diagnostic anchors inside the library.
#
# **And every file PARSED as its own stream**, one cursor each, over the
# tokens that end at that file's own eof (found beside defect 109,
# 2026-09-27). One cursor over the joined stream let a declaration that a
# file left open go on into the next file: its diagnostic landed in a file
# the mistake is not in, the library's included, and a bodiless function
# at a module's end took the next module's indented first lines as its
# body and ran. The tree, the declarations and the uses are still one, in
# load order, and the joined stream is still what every other reader gets.
function parse_source(s: source.Source) -> ParseOutput
    files = lexer.lex_files(s)
    lexed = lexer.joined(s, files: files)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    diagnostics: [diag.Diagnostic] @ lexed.diagnostics
    bound = source_extent.root_end(s)

    for one in files
        c: cursor.Cursor @ cursor.bounded_cursor(tokens: one.tokens, root_end: bound)
        decl.file(@c, @a, @decls, @uses, s.text)

        for d in c.diagnostics
            diagnostics @ diagnostics.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: diagnostics,
        tree: a,
        tokens: lexed.tokens
    )

# The same parse, told where the author's own text stops — what the CLI
# uses, because a compilation is the author's file plus every module it
# reaches plus the library (§1.11), and a diagnostic must never point
# inside the last of those.
function parse_bounded(text: str, root_end: i64) -> ParseOutput
    lexed = lexer.lex_one(text)
    comments: [token.Span] @ []

    for t in lexed.tokens
        if t.kind == .comment
            comments @ comments.push(t.span)

    c: cursor.Cursor @ cursor.bounded_cursor(tokens: lexed.tokens, root_end: root_end)
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    decl.file(@c, @a, @decls, @uses, text)
    diagnostics: [diag.Diagnostic] @ lexed.diagnostics

    for d in c.diagnostics
        diagnostics @ diagnostics.push(d)

    return ParseOutput(
        decls: decls,
        uses: uses,
        comments: comments,
        diagnostics: diagnostics,
        tree: a,
        tokens: lexed.tokens
    )

# Which file each diagnostic of a parse points into, in order.
function files_of(s: source.Source, p: ParseOutput) -> [i64]
    out: [i64] @ []

    for d in p.diagnostics
        out @ out.push(source.file_of(s, d.span.start))

    return out

test "a declaration a file leaves open is refused in that file, and the library's is not read"
    s = source.with_library(name: "main.hero", user: "function main()\n", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "missing_body"
    assert files_of(s, p) == [0]
    assert p.decls.len() == 1

test "a module's first indented lines are not the body of the module before it"
    # Two modules, each refused alone: before the repair the first one's
    # bodiless `two` took the second one's first lines and the program ran.
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "function two() -> i64\n")
        source.user_file(name: "b.hero", text: "    return 2\n\nfunction three() -> i64\n    return 3\n")
    ]
    s = source.from_files(inputs)
    p = parse_source(s)
    assert p.diagnostics.len() == 2
    assert p.diagnostics[0].code == "missing_body"
    assert p.diagnostics[1].code == "expected_declaration"
    assert files_of(s, p) == [0, 1]
    assert p.decls.len() == 1

test "an empty file parses to nothing, before the library and between two modules"
    s = source.with_library(name: "main.hero", user: "", library: "function range()\n    return\n")
    p = parse_source(s)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    inputs: [source.InputFile] = [
        source.user_file(name: "a.hero", text: "constant A: i64\n    1\n")
        source.user_file(name: "b.hero", text: "")
        source.user_file(name: "c.hero", text: "constant C: i64\n    3")
    ]
    three = parse_source(source.from_files(inputs))
    assert three.diagnostics.len() == 0
    assert three.decls.len() == 2

test "text becomes a tree in one call, comments and all"
    text = "# a note\nconstant MAX: i64\n    64  # trailing\n"
    p = parse(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1

    # BOTH comments are kept for the formatter; the tree keeps only the doc.
    assert p.comments.len() == 2
    assert p.decls[0].doc.len() == 1

test "diagnostics come out lexer-first, then parser"
    # A tab (the lexer's mistake) on line 2, a stray name at top level (the
    # parser's) on line 3: the lexer's diagnostic must come out first even
    # though recovery means both are found.
    text = "constant MAX: i64\n\t64\njunk\n"
    p = parse(text)
    assert p.diagnostics.len() >= 2
    assert p.diagnostics[0].code == "tab_in_indentation"
    assert p.diagnostics[p.diagnostics.len() - 1].code == "expected_declaration"
