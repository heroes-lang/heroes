# Where the reach of the brackets a mistake left open ends before the file's
# end, and what each opener is told there (design.md §4.15, §4.17; panel 183
# R1, R2 and R3, ratified 2026-09-30, R3's route (b) the author's of
# 2026-10-01).
#
# Inside brackets the margin is not structural (panel 007), so one missing
# `)` would take every line below it inside, to the file's end, and a stray
# closer further down would close it unnamed. Two facts about the line under
# the lexer end that reach: its first word is one no bracket holds in a
# program that compiles, no deeper than the statement the brackets opened in
# (`next_line.ends_a_reach`, R1); or, inside a `(`, it opens with a name
# after a line that kept its line end, which the specification lets stand
# only before a closer or a `,` (R2). Each opener still open is then named
# still open at that line and that word, not *never closed*, since a closer
# below may be the one the author wrote for it (`closers.still_open`); the
# line is laid out as what it begins.
#
# Out of `layout.hero` on 2026-10-02 (lane recovery-b6), when R3's message
# and R2's reading past a comment's line took that module past §11's 300:
# the margin is `layout`'s, the reach this module's.
#
# | entry | called by |
# |---|---|
# | `ends_at` | `layout.line_start` |
# | `ended_by_a_brace` | `scan.finish`, a `{` that ends the line of C's `for` header |

use token
use state
use next_line
use closers
use brace_layout

# Whether the line under `l.pos`, whose margin is `spaces`, ends the reach
# of every opener still open: where it does, each is named there and the
# stack emptied, the line's offset kept for the parser (`LexState.closes`),
# and the statement the brackets were opened in ends at the line end above.
function ends_at(@l: state.LexState, text: str, spaces: i64) -> bool
    margin = l.level * 4
    word = next_line.ends_a_reach(text, at: l.pos, spaces: spaces, margin: margin)
    header = !word && below_a_header(l, text)

    if !word && !header && !a_name_after_a_kept_end(l, text, spaces: spaces, margin: margin)
        return false
    end_the_reach(@l, text, name: !word, header: header)
    state.push_offset(@l.closes, at: l.pos)

    # The statement they were opened in is over at the line end above, one
    # that ended with an opener owing no terminator of its own; a comment's
    # line between is no line end of the grammar's.
    last = last_not_a_comment(l)

    if l.owed < 0 && last >= 0 && l.tokens[last].kind != .terminator
        at = l.tokens[l.tokens.len() - 1].span.end
        state.push_token(@l.tokens, token.Token(kind: .terminator, span: token.Span(start: at, end: at)))
    return true

# Inside a `(`, a line end the line above kept may stand only before a closer
# or a `,` (the specification's opening paragraph: only `[` and `{` take a
# line end as a separator), so a line at the statement's margin `margin` that
# opens with a name after one goes on inside no `(` of a program that compiles
# (panel 183 R2, the completeness critic's route). A comment on a line of
# its own between the two is no token of the grammar's: the line end asked
# of is the one before it, where until 2026-10-02 the comment hid it and the
# reach went on past the name, its line's own mistakes unsaid.
function a_name_after_a_kept_end(l: state.LexState, text: str, spaces: i64, margin: i64) -> bool
    if spaces > margin || l.pos >= text.len()
        return false
    last = last_not_a_comment(l)
    kept = last >= 0 && l.tokens[last].kind == .terminator
    inner = text[l.open_brackets[l.open_brackets.len() - 1].start]
    return kept && inner == '(' && next_line.opens_with_a_name(text, at: l.pos)

# Inside the `(` of C's `for` header, which holds a `;` the lexer left to
# the parser's one report of it, a line that holds no `;` and closes nothing
# it did not open is no clause of the header: the body below it, or the next
# statement, which the `)` left out took in (defect 302). A line that holds
# one is the header split over lines, as C allows, its `)` below.
function below_a_header(l: state.LexState, text: str) -> bool
    return a_header_open(l, text) && !a_clause(text, at: l.pos)

# The same `(` at a `{` at `at` that ends its line, the body's brace C's
# header opens, `for (i = 0; i < 3; i++ {`: its reach ends there, named, so
# the brace is read as a body's (`brace_layout.hero`) and the `(` withdrawn
# where the parser tells the header (`parse/unclosed.withdrawn`).
function ended_by_a_brace(@l: state.LexState, text: str, at: i64) -> bool
    if !a_header_open(l, text) || !brace_layout.ends_its_line(text, from: at + 1)
        return false
    end_the_reach(@l, text, name: false, header: true)
    state.push_offset(@l.closes, at: at)
    return true

# Whether the innermost opener is the `(` of C's `for` header
# (`closers.in_a_for_header`) holding, in no bracket of its own, a `;` the
# lexer left to the parser.
function a_header_open(l: state.LexState, text: str) -> bool
    if !closers.in_a_for_header(l)
        return false
    open = l.open_brackets[l.open_brackets.len() - 1].start
    i: i64 @ l.tokens.len() - 1
    depth: i64 @ 0

    while i >= 0 && l.tokens[i].span.start > open
        k = l.tokens[i].kind

        if token.is_closer(k)
            depth @ depth + 1
        else if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth - 1
        else if depth == 0 && k == .error && text.slice(from: l.tokens[i].span.start, to: l.tokens[i].span.end) == ";"
            return true
        i @ i - 1

    return false

# Whether the line from `at` holds a `;`, or a closer of no opener on it: a
# clause of a header split over lines, the `(` closing below.
function a_clause(text: str, at: i64) -> bool
    depth: i64 @ 0
    i: i64 @ at

    while i < text.len() && text[i] != '\n' && text[i] != '#'
        b = text[i]

        if b == '"' || b == '\''
            i @ closers.past_literal(text, from: i)
            continue

        if b == ';' || depth == 0 && (b == ')' || b == ']' || b == '}')
            return true

        if b == '(' || b == '[' || b == '{'
            depth @ depth + 1
        else if b == ')' || b == ']' || b == '}'
            depth @ depth - 1
        i @ i + 1

    return false

# The index of the last token laid out that is no comment, or -1.
function last_not_a_comment(l: state.LexState) -> i64
    last: i64 @ l.tokens.len() - 1

    while last >= 0 && l.tokens[last].kind == .comment
        last @ last - 1

    return last

# Every opener still open named still open at the line under `l.pos`, whose
# first word ended their reach (R1, or R2 where `name`), at that line and
# that word, and the stack emptied.
function end_the_reach(@l: state.LexState, text: str, name: bool, header: bool)
    line = state.line_of(@l, text, at: l.pos)
    word = next_line.word_at(text, at: l.pos)

    for span in l.open_brackets
        state.push_diagnostic(
            @l.diagnostics,
            closers.still_open(text: text, span: span, line: line, word: word, name: name, header: header)
        )

    none: [token.Span] = []
    l.open_brackets @ none
