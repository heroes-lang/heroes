# Turning clang's verdict on an extern back into a Heroes diagnostic
# (design.md §4.19; panel 036 rider 3; CLAUDE.md §7's named exception).
# Port of the driver half of crates/heroes/src/emit/ffi.rs — the
# lookups it shares with the readers live below them in
# emit_ffi_lookup, so the knot the Rust module tree hides never forms.
#
# THE ONE PLACE A CLANG FAILURE IS NOT THE COMPILER'S FAULT. §7 says a
# clang failure exits 2 and blames the compiler, and that was true
# while every line of the translation unit came from this emitter. The
# assertions break that: they are generated code whose whole purpose
# is to fail when the AUTHOR's declaration disagrees with the real
# header. Left as an internal error it would print C the author never
# wrote, name a file under build/<hash>/, and blame the compiler for a
# mistake in a .hero file — three of the four things §4.17 exists to
# prevent. Empty when clang failed for any other reason — the common
# case, and still the compiler's.

use ast
use source
use diag
use check_state
use ir_state
use emit_ctype
use emit_ffi_lookup
use emit_ffi_declared
use emit_ffi_record
use emit_ffi_field
use emit_ffi_tag
use emit_ffi_build
use emit_ffi_narrowed
use emit_ffi_mutable
use parse
use resolve
use checker
use ir_lower

# Every extern a failure blames the author for, as diagnostics
# pointing at the .hero line rather than at generated C. Names is
# built here rather than threaded in: the caller is the CLI and has no
# reason to own an emitter's name table (panel 061). Two orderings are
# load-bearing and each is the message: FLEX before field_type (a
# flexible array member fails both assertions, and the generic one
# would tell the author to correct a length that cannot exist), and
# the tag pair before unknown_name (a tag-only header makes clang say
# two things about one mistake, and only the tag line names the
# repair). add_once keeps one diagnostic per span, so whichever runs
# first wins.
function explain(stderr: str, s: source.Source, tree: ast.Ast, decls: [ast.Decl], c: check_state.Checked, p: ir_state.Program, word_bits: i64) -> [diag.Diagnostic]
    names = emit_ctype.new_names(s, decls)
    found: [diag.Diagnostic] @ []

    for line in emit_ffi_lookup.lines(text: stderr)
        wrong = emit_ffi_declared.wrong_type(s, decls, line: line)

        if !wrong.is_err()
            found @ emit_ffi_lookup.add_once(found, d: wrong.must())
        not_const = emit_ffi_declared.not_constant(s, decls, line: line)

        if !not_const.is_err()
            found @ emit_ffi_lookup.add_once(found, d: not_const.must())
        incomplete = emit_ffi_record.incomplete_record(s, decls, line: line)

        if !incomplete.is_err()
            found @ emit_ffi_lookup.add_once(found, d: incomplete.must())
        unknown_f = emit_ffi_field.unknown_field(s, decls, line: line)

        if !unknown_f.is_err()
            found @ emit_ffi_lookup.add_once(found, d: unknown_f.must())
        flex = emit_ffi_field.flexible_array_member(s, tree, decls, line: line)

        if !flex.is_err()
            found @ emit_ffi_lookup.add_once(found, d: flex.must())
        field = emit_ffi_field.field_type(s, tree, decls, line: line)

        if !field.is_err()
            found @ emit_ffi_lookup.add_once(found, d: field.must())
        union_r = emit_ffi_record.union_record(s, decls, line: line)

        if !union_r.is_err()
            found @ emit_ffi_lookup.add_once(found, d: union_r.must())
        m_tag = emit_ffi_tag.missing_tag(s, decls, line: line)

        if !m_tag.is_err()
            found @ emit_ffi_lookup.add_once(found, d: m_tag.must())
        u_tag = emit_ffi_tag.unknown_tag(s, decls, line: line)

        if !u_tag.is_err()
            found @ emit_ffi_lookup.add_once(found, d: u_tag.must())
        tag_u = emit_ffi_tag.tag_is_a_union(s, decls, line: line)

        if !tag_u.is_err()
            found @ emit_ffi_lookup.add_once(found, d: tag_u.must())
        unknown_n = emit_ffi_declared.unknown_name(s, decls, line: line, stderr: stderr)

        if !unknown_n.is_err()
            found @ emit_ffi_lookup.add_once(found, d: unknown_n.must())
        m_link = emit_ffi_build.missing_link(s, decls, line: line)

        if !m_link.is_err()
            found @ emit_ffi_lookup.add_once(found, d: m_link.must())
        m_lib = emit_ffi_build.missing_library(s, decls, line: line)

        if !m_lib.is_err()
            found @ emit_ffi_lookup.add_once(found, d: m_lib.must())
        m_hdr = emit_ffi_build.missing_header(s, decls, line: line)

        if !m_hdr.is_err()
            found @ emit_ffi_lookup.add_once(found, d: m_hdr.must())
        pkg = emit_ffi_build.package_problem(s, decls, stderr: stderr, line: line)

        if !pkg.is_err()
            found @ emit_ffi_lookup.add_once(found, d: pkg.must())
        width = emit_ffi_narrowed.parameter_width(s, decls, p, c, names, line: line, word_bits: word_bits)

        if !width.is_err()
            found @ emit_ffi_lookup.add_once(found, d: width.must())
        writable = emit_ffi_mutable.writable_parameter(s, decls, p, c, names, line: line)

        if !writable.is_err()
            found @ emit_ffi_lookup.add_once(found, d: writable.must())

    return found

## Tests

test "one mistake, several lines, one diagnostic — and the order is the message"
    text = "extern \"math.h\"\n    function sqrt(x: f64) -> f64\n\nextern \"m.h\"\n    record Packet\n        data: i8[4]\n\nfunction touch(k: Packet)\n    _ = k\n\nfunction main()\n    print(sqrt(2.0))\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: check_state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    low = ir_lower.lower(parsed.tree, out, c, s, parsed.decls)

    # The return assertion's message line, then clang's echo of the
    # same source line: one diagnostic survives, by matching rather
    # than by luck of ordering.
    two_lines = "m.c:9:1: error: static assertion failed due to requirement 'x': heroes-ffi-return sqrt i64\n_Static_assert(HERO_RET_INT(sqrt((double)0)), \"heroes-ffi-return sqrt i64\");\n"
    found = explain(two_lines, s, parsed.tree, parsed.decls, c, low.program, word_bits: 64)
    assert found.len() == 1
    assert found[0].code == "ffi_return_type"

    # A flexible array member fails BOTH field assertions; flex runs
    # first and add_once keeps it, so the author is not told to
    # correct a length that cannot exist.
    both = "m.c:2:1: error: static assertion failed due to requirement 'a': heroes-ffi-flex Packet data\nm.c:3:1: error: static assertion failed due to requirement 'b': heroes-ffi-field Packet data\n"
    kept = explain(both, s, parsed.tree, parsed.decls, c, low.program, word_bits: 64)
    assert kept.len() == 1
    assert kept[0].code == "ffi_flexible_array_member"

    # Any other clang failure explains nothing: still the compiler's.
    other = "m.c:1:1: error: expected ';' after top level declarator\n"
    assert explain(other, s, parsed.tree, parsed.decls, c, low.program, word_bits: 64).len() == 0
