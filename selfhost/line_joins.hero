# The joins a line left open is offered, weighed once the file is lexed
# (design.md §4.15, §4.17; panel 181 item 3; defect 129).
#
# `open_line` refuses a depth-zero line break and offers the join, *write the
# statement on one line*, `certain` or `guess` by what that break shows. Two
# things it cannot see there, and each made a `certain` join write a program
# `check` refuses, which is what `.claude/rules/diagnostics-and-goldens.md`
# calls a `guess` that lied:
#
# - **The statement's other breaks.** A statement broken at two line ends is
#   one mistake that two joins repair together, so applying the `certain` ones
#   alone writes a line the same rule refuses again: `x = y +` over `z +` over
#   `print(x)` became `x = y + z +` over `print(x)`. The joins of one
#   statement take ONE certainty, the weakest among them, and a break that
#   offers no join (a comment between) makes every other one a `guess`, since
#   applying them leaves it standing; so does a line left open that the
#   lexer ends rather than refuses, before a fresh statement or at the file's
#   end, which the parser refuses and no join repairs (`open_line.ended`).
#   Each break keeps its own diagnostic (panel 181 item 2): this moves
#   certainties, never the count.
# - **What the join writes beside its operator.** `0 => 5` over `-` over
#   `"=>"` joined to `5 - "=>"`, which no type admits. Where an operand is
#   made of literals alone, the join is `certain` only if the operator takes
#   that operand's family (`operand_families`, `literal_operands`), and two
#   such operands only if they are of one family. And since a join captures
#   the operand after it and re-associates the rest of that line, the whole
#   expression it writes is judged too, in its context: `x = v ==` over
#   `1 == 2` writes `(v == 1) == 2`, refused though each line alone is not.
#
# Both are read from the finished stream, where every token of the joined
# lines exists. **A statement ends where its own terminator is planted**: at
# depth zero and at the level its first break stood at, the lexer planting
# none while it joins. A block the statement opens does not end it, `x = a +`
# over `a + if c` over the block, `else` and its block, and `- a`: the
# terminator before the block's indent is its head's, the ones inside are its
# lines', and a line that goes on after the block is refused with no dedent,
# still inside it. A block of its own that closes where anything but `else`
# follows ends it, as the spec's opening paragraph says a statement whose last
# part is a block ends with that block; and so does the block around it
# closing. A name beside a literal takes the literal's family, both sides of
# an operator being of one type; where a family rests on names alone, on a
# declaration's annotation or on another line, the join keeps its certainty,
# since some typing of the names could make it compile.
#
# | entry | called by |
# |---|---|
# | `weigh` | `lexer.lex_one`, after the file's last token |

use token
use state
use operand_families as families
use literal_operands as operands

## The joins, weighed

# Every refused break's join, against what it writes and then against its
# statement's other breaks: a join ends `certain` only where both allow it.
function weigh(@l: state.LexState, text: str)
    breaks = l.breaks

    for b in breaks
        if joined(l, b) && !writes(l.tokens, text, o: operator_of(b))
            guessed(@l, b)

    first: i64 @ 0

    while first < breaks.len()
        last: i64 @ first

        while last + 1 < breaks.len() && one_statement(l.tokens, from: breaks[last].after, to: breaks[last + 1].after)
            last @ last + 1

        if any_weak(l, breaks: breaks.slice(from: first, to: last + 1))
            for b in breaks.slice(from: first, to: last + 1)
                guessed(@l, b)
        k: i64 @ first

        while k <= last
            l.breaks[k].statement @ breaks[first].after
            k @ k + 1

        first @ last + 1

# The index of the operator the join writes: the head of the line below, or
# the last token of the line above.
function operator_of(b: state.Break) -> i64
    if b.head
        return b.after
    return b.after - 1

# Does the refusal carry its join? It carries one fix, the join, or none;
# and a line ended rather than refused has neither.
function joined(l: state.LexState, b: state.Break) -> bool
    return b.diagnostic >= 0 && l.diagnostics[b.diagnostic].fixes.len() > 0

function guessed(@l: state.LexState, b: state.Break)
    if joined(l, b)
        l.diagnostics[b.diagnostic].fixes[0].certainty @ .guess

function any_weak(l: state.LexState, breaks: [state.Break]) -> bool
    for b in breaks
        if !joined(l, b) || l.diagnostics[b.diagnostic].fixes[0].certainty == .guess
            return true

    return false

# Are the breaks either side of `from` .. `to` one statement's? Not where a
# terminator is planted at depth zero and at the level of the first, but the
# one before a block's indent; nor where a block the statement opened closes
# and anything but `else` follows; nor where the level falls below the first's.
function one_statement(tokens: [token.Token], from: i64, to: i64) -> bool
    depth: i64 @ 0
    level: i64 @ 0
    i: i64 @ from

    while i < to
        k = tokens[i].kind
        next = tokens[operands.past_comments(tokens, from: i + 1)].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if depth == 0 && k == .indent
            level @ level + 1
        else if depth == 0 && k == .dedent
            level @ level - 1

            if level < 0 || level == 0 && next != .kw_else
                return false
        else if depth == 0 && k == .terminator && level == 0 && next != .indent
            return false
        i @ i + 1

    return true

## What a join writes

# Can the join at `o` be `certain` by what it writes: its operator's own
# operands, and the whole expression it makes? The second is asked only of an
# operator the first judges.
function writes(tokens: [token.Token], text: str, o: i64) -> bool
    if !writes_a_type(tokens, text, o: o)
        return false
    return families.takes(tokens[o].kind) == .unjudged || !refuses_the_whole(tokens, text, o: o)

# Can the operator at `o` take the operands the joined line gives it? False
# only where one is made of literals of a family it does not take, the two
# are of two families, or the operand after it stands before an arm's `=>`
# where no pattern takes an operator.
function writes_a_type(tokens: [token.Token], text: str, o: i64) -> bool
    kind = tokens[o].kind

    if families.takes(kind) == .unjudged
        return true
    prefix = kind == .bang || kind == .tilde || kind == .minus && operands.no_left_operand(tokens, at: o)
    level: i64 @ families.power(kind)

    if prefix
        level @ families.PREFIX
    read = operands.right_of(tokens, text, o: o, prefix: prefix, level: level)
    right: families.Family @ .none

    if read.next >= 0
        next = operands.past_comments(tokens, from: read.next)

        if ends_the_operand(tokens, at: next, level: level)
            right @ read.family

            if tokens[next].kind == .fat_arrow
                return writes_a_pattern(tokens, text, o: o, prefix: prefix, right: right)

            # A prefix operator's value is of its operand's family, and it is
            # the left operand of the binary operator after it: `-` over
            # `1.5 | 2`.
            if prefix && !families.admits(families.takes(tokens[next].kind), right)
                return false
    left: families.Family @ .none

    if !prefix && families.power(kind) > 0
        left @ operands.left_of(tokens, text, o: o, level: families.power(kind))
    wants = families.takes(kind)
    return families.admits(wants, left) && families.admits(wants, right) && one_type(left: left, right: right)

# Does what stands at `at` end an operand read at `level`: the line's or the
# block's edge, an arm's `=>`, or a binary operator that binds no tighter?
function ends_the_operand(tokens: [token.Token], at: i64, level: i64) -> bool
    if at >= tokens.len()
        return false
    k = tokens[at].kind

    if k == .terminator || k == .indent || k == .dedent || k == .eof || k == .fat_arrow
        return true
    binds = families.power(k)
    return binds > 0 && binds <= level

# The operand after the operator stands before an arm's `=>`, so it is a
# pattern (spec § 8's Pattern). Only a `-` that signs it and a `|` between two
# patterns write an operator there, a sign an integer's or a character's and
# a `|` either side of one type; and never inside an arm's body, where the
# join writes the next arm's pattern as an operand (`0 => 5 -` over
# `1 => 10`).
function writes_a_pattern(tokens: [token.Token], text: str, o: i64, prefix: bool, right: families.Family) -> bool
    if arrow_before(tokens, o: o)
        return false
    kind = tokens[o].kind

    if kind == .minus && prefix
        return families.admits(.integer, right)

    if kind != .pipe
        return false
    left = operands.left_of(tokens, text, o: o, level: families.power(kind))
    return families.admits(.pattern, left) && families.admits(.pattern, right) && one_type(left: left, right: right)

function one_type(left: families.Family, right: families.Family) -> bool
    return left == .none || right == .none || left == right

# Is there an arm's `=>` between the start of the operator's statement and
# the operator?
function arrow_before(tokens: [token.Token], o: i64) -> bool
    i: i64 @ o - 1

    while i >= 0 && tokens[i].kind != .terminator && tokens[i].kind != .indent && tokens[i].kind != .dedent
        if tokens[i].kind == .fat_arrow
            return true
        i @ i - 1

    return false

## The whole expression a join writes

# Does the join at `o` make its expression refused where neither side, read
# alone, is? A join captures the operand after it and so re-associates the
# rest of that line: `x = v ==` over `1 == 2` writes `(v == 1) == 2`, which no
# type admits though each line alone is fine; and its expression may now stand
# where its context wants a truth, `if a +` over `1`. The expression runs from
# where its statement's operand begins to where it ends at depth zero; where
# any part of it is not a run this module reads (a block, a case, a bracket
# but `(`), the answer is no.
function refuses_the_whole(tokens: [token.Token], text: str, o: i64) -> bool
    start = expression_start(tokens, o: o)
    end = expression_end(tokens, o: o)
    whole = operands.binary(tokens, text, at: start, least: 1, limit: end)

    if whole.next < 0 || operands.past_comments(tokens, from: whole.next) != end
        return false
    context: token.TokenKind @ .terminator

    if start > 0
        context @ tokens[start - 1].kind
    refused = whole.family == .refused || !families.admits(families.takes(context), whole.family)
    return refused && !refused_alone(tokens, text, from: start, to: o) && !refused_alone(tokens, text, from: o + 1, to: end)

# Is the run `from` .. `to` a run of this module's that no type admits, read as
# an expression of its own?
function refused_alone(tokens: [token.Token], text: str, from: i64, to: i64) -> bool
    if from >= to
        return false
    read = operands.binary(tokens, text, at: from, least: 1, limit: to)
    return read.next >= 0 && operands.past_comments(tokens, from: read.next) == to && read.family == .refused

# The first token of the expression the operator at `o` stands in: after the
# token its statement's operand begins after, at depth zero.
function expression_start(tokens: [token.Token], o: i64) -> i64
    depth: i64 @ 0
    i: i64 @ o - 1

    while i >= 0
        k = tokens[i].kind

        if k == .rparen || k == .rbracket || k == .rbrace
            depth @ depth + 1
        else if (k == .lparen || k == .lbracket || k == .lbrace) && depth > 0
            depth @ depth - 1
        else if depth == 0 && (families.begins_an_operand(k) || k == .kw_else)
            return i + 1
        i @ i - 1

    return 0

# The index where that expression ends: its line's or block's edge, or an
# arm's `=>`, at depth zero.
function expression_end(tokens: [token.Token], o: i64) -> i64
    depth: i64 @ 0
    i: i64 @ o + 1

    while i < tokens.len()
        k = tokens[i].kind

        if k == .lparen || k == .lbracket || k == .lbrace
            depth @ depth + 1
        else if (k == .rparen || k == .rbracket || k == .rbrace) && depth > 0
            depth @ depth - 1
        else if depth == 0 && (k == .terminator || k == .indent || k == .dedent || k == .eof || k == .fat_arrow)
            return i
        i @ i + 1

    return tokens.len()
