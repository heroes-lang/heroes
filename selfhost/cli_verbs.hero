# heroes build, run and test — the three verbs that compile (design.md
# §3.5, §4.18; panels 016, 020, 021, 070). Port of
# crates/heroes-cli/src/commands/{build,run,test}.rs plus the
# toolchain glue their shared pipeline ends in.
#
# build says `wrote build/<hash>/f` on STDERR because the measurement
# chose it: given silence the llm-ergonomist wrote ./f, guaranteed
# wrong under a hash it cannot predict. run's exit status is the
# program's — the program is the artifact, so its verdict is the
# answer — and a signal death is 128+signal, never a hardcoded 134
# (panel 070: SIGSEGV reported as an abort hid a crash from the very
# sitting convened about it). test runs ONE PROCESS PER TEST, so one
# abort cannot hide the tests after it, with the report on stdout
# because the verdicts are the artifact.

use source
use modules
use emit_ffi
use cli_table
use cli_argv
use cli_io
use cli_compile
use cli_toolchain
use cli_libraries
use cli_input
use library_source

record Produced
    binary: str
    tests: [str]
    stopped: bool

# The glue from a translation unit to a binary on disk: the cache
# directory, the C written beside its object, the runtime object, the
# link — and on a link failure, THE ONE DECISION §7 names: emit_ffi
# explains the stderr, and a verdict about the author's extern exits 1
# on their line where everything else stays internal error at 2.
function produce(path: str, s: source.Source, options: cli_compile.Options, t: cli_toolchain.Toolchain, version: str) -> Produced?
    art = cli_compile.to_unit(s, options, version: version)
    if art.is_err()
        _ = art?
    if art.must().stopped
        none_t: [str] = []
        return ok(Produced(binary: "", tests: none_t, stopped: true))
    module = source.module_of(s.name)
    level_key: str @ options.level
    is_tests: bool @ false
    match options.target
        .tests_build =>
            level_key @ options.level + "+tests"
            is_tests @ true
        .program_build => is_tests @ is_tests
    dir = cli_toolchain.dir_for(t, source_name: s.name, text: s.text, level_key: level_key, sanitize: options.sanitize, search: cli_compile.search_key(headers_from: options.headers_from, library: options.library))
    if dir.is_err()
        cli_io.eprint(text: "error: cannot create the build directory")
        return fail("failed", "no build directory")
    c_file = dir.must() + "/" + module + ".c"
    written = write_file(path: c_file, text: art.must().c)
    if written.is_err()
        cli_io.eprint(text: "error: cannot write " + c_file)
        return fail("failed", "cannot write the unit")
    object = cli_toolchain.runtime_object(t, level: options.level, sanitize: options.sanitize)
    if object.is_err()
        cli_io.eprint(text: "internal error: the runtime did not compile")
        return fail("failed", "no runtime object")
    binary: str @ dir.must() + "/" + module
    if !options.output.is_err()
        binary @ options.output.must()
    # Asked before clang runs, so a package that is not installed is
    # reported as itself rather than as a header clang could not find.
    package_flags = cli_libraries.resolve_packages(art.must().packages, build_dir: t.build)
    if package_flags.is_err()
        # **A package failure is the AUTHOR's, so it goes through the same
        # ffi mapping a clang failure does.** The bootstrap asks
        # `resolve_packages` from INSIDE toolchain::link, so its marker
        # text arrives at `explain` with everything else; the port asks it
        # here, one call earlier, and the message used to be printed raw.
        # Measured 2026-08-18 by tests/harness on
        # `unsupported/ffi-records-only-group-cannot-claim-its-package`:
        # the terminal got `heroes-ffi-package ...` and four bare lines —
        # no code, no `at file:line:col`, no source snippet, no notes,
        # which is every part of §4.17 at once, in the one class where the
        # compiler is allowed to blame the author's own `extern` (§7).
        message = failure_text(package_flags)
        theirs = emit_ffi.explain(message, s, art.must().tree, art.must().decls, art.must().checked, art.must().program, word_bits: 64)
        if theirs.len() > 0
            _ = cli_compile.stage(theirs, s)
            return fail("diagnostics", "the package could not answer")
        cli_io.eprint(text: message)
        return fail("diagnostics", "the package could not answer")
    names: [str] @ []
    for name in art.must().link
        if !cli_libraries.in_the_c_runtime(library: name)
            names @ names.push(name)
    # The source's own directory, so extern "mylib.h" finds a header
    # beside the .hero file — the unit lives under build/<hash>/ and
    # an angled include never searches the source's directory. An
    # empty parent is the current directory, not the absence of one.
    source_dir: str @ modules.open_directory(path)
    if source_dir.len() == 0
        source_dir @ "."
    linked = cli_toolchain.link(t, c_file: c_file, object: object.must(), binary: binary, level: options.level, sanitize: options.sanitize, source_dir: source_dir, search_include: options.headers_from, search_library: options.library, package_flags: package_flags.must(), link_names: names)
    if linked.is_err()
        # Some clang failures are the AUTHOR's, and the ffi mapping is
        # the only place that decides which (panel 036 rider 3). The
        # pipeline pieces ride in the Artifact for exactly this call.
        message = unit_failure_text(linked)
        theirs = emit_ffi.explain(message, s, art.must().tree, art.must().decls, art.must().checked, art.must().program, word_bits: 64)
        if theirs.len() > 0
            _ = cli_compile.stage(theirs, s)
            return fail("diagnostics", "the author's extern disagrees with the header")
        cli_io.eprint(text: "internal error: " + message)
        cli_io.eprint(text: "the generated C is at " + c_file)
        return fail("failed", "clang refused the generated C")
    return ok(Produced(binary: binary, tests: art.must().tests, stopped: false))

# The failure's message, out of a fallible that is known to be err.
function failure_text(failed: [str]?) -> str
    match failed
        .ok => return ""
        .err e => return e.msg

function unit_failure_text(failed: ()?) -> str
    match failed
        .ok => return ""
        .err e => return e.msg

function run_build(path: str, s: source.Source, inv: cli_argv.Invocation, t: cli_toolchain.Toolchain, version: str) -> cli_table.Exit
    if cli_argv.has(inv, spelling: "--dump-ir") && cli_argv.has(inv, spelling: "--emit-c")
        cli_io.eprint(text: "error: `--dump-ir` and `--emit-c` are both stops — ask for one artifact at a time")
        return .failed_exit
    level = cli_compile.level_from(inv, default_level: "-O0")
    if level.is_err()
        return .failed_exit
    options = cli_compile.Options(level: level.must(), dump_ir: cli_argv.has(inv, spelling: "--dump-ir"), emit_c: cli_argv.has(inv, spelling: "--emit-c"), output: cli_argv.value_of(inv, spelling: "-o"), sanitize: cli_argv.has(inv, spelling: "--sanitize"), target: .program_build, headers_from: cli_argv.values_of(inv, spelling: "--include"), library: cli_argv.values_of(inv, spelling: "--library"))
    made = produce(path: path, s: s, options: options, t: t, version: version)
    if made.is_err()
        return exit_of(made)
    if made.must().stopped
        return .ok_exit
    cli_io.eprint(text: "wrote " + made.must().binary)
    return .ok_exit

function run_run(path: str, s: source.Source, inv: cli_argv.Invocation, t: cli_toolchain.Toolchain, version: str) -> cli_table.Exit
    level = cli_compile.level_from(inv, default_level: "-O2")
    if level.is_err()
        return .failed_exit
    options = cli_compile.Options(level: level.must(), dump_ir: false, emit_c: false, output: cli_argv.value_of(inv, spelling: "-o"), sanitize: cli_argv.has(inv, spelling: "--sanitize"), target: .program_build, headers_from: cli_argv.values_of(inv, spelling: "--include"), library: cli_argv.values_of(inv, spelling: "--library"))
    made = produce(path: path, s: s, options: options, t: t, version: version)
    if made.is_err()
        return exit_of(made)
    if made.must().stopped
        return .ok_exit
    # No line of our own before the program's output: stdout is the
    # program's from here.
    line: str @ cli_toolchain.sq(made.must().binary)
    for arg in inv.program_args
        line @ line + " " + cli_toolchain.sq(arg)
    raw = cli_toolchain.system(command: line.cstr()).to_i64().must()
    if raw < 0
        cli_io.eprint(text: "error: cannot execute " + made.must().binary)
        return .failed_exit
    # system() answers in waitpid's format: the exit code rides the
    # high byte, a signal death the low seven bits. 128+signal is the
    # convention every shell prints (panel 070: the hardcoded 134
    # reported a SIGSEGV as an abort, and the instrument hid the
    # defect from the person holding it).
    sig = raw % 128
    if sig != 0 && raw % 256 != 0
        return .program_exit(status: 128 + sig)
    return .program_exit(status: raw / 256)

function run_test(path: str, s: source.Source, inv: cli_argv.Invocation, t: cli_toolchain.Toolchain, version: str) -> cli_table.Exit
    level = cli_compile.level_from(inv, default_level: "-O0")
    if level.is_err()
        return .failed_exit
    none_out: str? = fail("none", "no -o")
    options = cli_compile.Options(level: level.must(), dump_ir: false, emit_c: false, output: none_out, sanitize: cli_argv.has(inv, spelling: "--sanitize"), target: .tests_build, headers_from: cli_argv.values_of(inv, spelling: "--include"), library: cli_argv.values_of(inv, spelling: "--library"))
    made = produce(path: path, s: s, options: options, t: t, version: version)
    if made.is_err()
        return exit_of(made)
    if made.must().stopped
        return .ok_exit
    titles = made.must().tests
    if titles.len() == 0
        print("no tests in " + path)
        return .ok_exit
    failed: i64 @ 0
    index: i64 @ 0
    for title in titles
        raw = cli_toolchain.system(command: (cli_toolchain.sq(made.must().binary) + " " + index.to_str()).cstr()).to_i64().must()
        if raw == 0
            print("ok   " + title)
        else
            print("FAIL " + title)
            failed @ failed + 1
        index @ index + 1
    unit: str @ "tests"
    if titles.len() == 1
        unit @ "test"
    if failed == 0
        print(titles.len().to_str() + " " + unit + ", all passed")
        return .ok_exit
    print(titles.len().to_str() + " " + unit + ", " + failed.to_str() + " failed")
    # A failing test is the PROGRAM being wrong, which is exit 1 — the
    # same code a diagnostic gets, and for the same reason: the tool
    # worked.
    return .diagnostics_exit

function exit_of(failed: Produced?) -> cli_table.Exit
    match failed
        .ok => return .ok_exit
        .err e =>
            if e.code == "diagnostics"
                return .diagnostics_exit
            return .failed_exit

## Tests

test "end to end: the port compiles a Heroes program and runs it"
    library = library_source.text()
    program = "function double_it(n: i64) -> i64\n    return n * 2\n\ntest \"doubling\"\n    assert double_it(n: 21) == 42\n\nfunction main()\n    print(double_it(n: 21))\n"
    _ = write_file(path: "build/selftest_e2e.hero", text: program)
    s = cli_input.read_compilation(path: "build/selftest_e2e.hero", library: library).must()
    t = cli_toolchain.locate_toolchain(hint: "", fingerprint: "port-e2e").must()
    empty: [cli_argv.FlagHit] = []
    inv = cli_argv.Invocation(tag: .run_cmd, file: ok("build/selftest_e2e.hero"), program_args: [], flags: empty)
    # run: compiled by the port's own pipeline, linked by its own
    # toolchain, executed through system() — the program prints 42 and
    # exits 0, and that verdict is the command's.
    verdict = run_run(path: "build/selftest_e2e.hero", s: s, inv: inv, t: t, version: "0.0.0-port")
    assert verdict == .program_exit(status: 0)
    # test: one process per title, the report on stdout.
    tinv = cli_argv.Invocation(tag: .test_cmd, file: ok("build/selftest_e2e.hero"), program_args: [], flags: empty)
    assert run_test(path: "build/selftest_e2e.hero", s: s, inv: tinv, t: t, version: "0.0.0-port") == .ok_exit
    # build: the artifact line names the hash the reader cannot guess.
    binv = cli_argv.Invocation(tag: .build_cmd, file: ok("build/selftest_e2e.hero"), program_args: [], flags: empty)
    assert run_build(path: "build/selftest_e2e.hero", s: s, inv: binv, t: t, version: "0.0.0-port") == .ok_exit
