# What a `.` that no field or function name follows was written as, read off
# the text: the words its one `expected_field_name` adds, and where another
# language's range operator ends (design.md §4.17, §4.11; defects 180 and
# 181, 2026-10-03).
#
# Two notations stand where the parser reads a field. Rust's, Swift's and
# Kotlin's range, `1..2`, `0...5`, `0..=n`, `0..<n`, `..n`: two dots or more, told
# twice as field accesses, once at each `.`, and inside a bracket a third time
# at its closer. A version or an address written as a number, `1.5.2`: a
# decimal number's second point, told as a field access whose name is a
# number. Each keeps its code, whose words are true of it (a field or function
# name was expected after the `.`), and gains here what the author wrote
# instead; the range is told once, `grammar_expr.past_a_range` passing the
# rest of its operator to `range_end` and reading its right operand.
#
# A leaf: it reads the text and nothing of the parser.
#
# | entry | called by |
# |---|---|
# | `after`, `range_end` | `grammar_expr.after_dot`, `past_a_range` |
# | `after_a_case` | `grammar_expr.case_expr`, at `..n` |

use bytes

constant RANGE_WORDS: str
    " — `..` writes a range in other languages, and here a range is `range(from: a, to: b)`, which stops before `to`"

# The words after `expected_field_name`'s own, for the `.` at `dot` that no
# name follows: empty where neither notation stands there.
function after(text: str, dot: i64) -> str
    if range_end(text, dot: dot) >= 0
        return RANGE_WORDS
    number = number_before(text, dot: dot)

    if number.len() > 0 && dot + 1 < text.len() && bytes.is_digit(text[dot + 1])
        return " — a number holds one decimal point, and `" + number + "` already has its own"
    return ""

# The words after `expected_case_name`'s own, for the `.` at `dot` that opens
# a case no name follows: the range's where it is `..n`, a range with no
# start, else what a case is written as.
function after_a_case(text: str, dot: i64) -> str
    if range_end(text, dot: dot) >= 0
        return RANGE_WORDS
    return " — `.plus`, or `.num(v: 12)` with its fields"

# Where the range operator whose first `.` is at `dot` ends, past its dots
# and a `=` or `<` against the last, or -1 where no second `.` follows the
# first.
function range_end(text: str, dot: i64) -> i64
    if dot + 1 >= text.len() || text[dot + 1] != '.'
        return -1
    i: i64 @= dot + 1

    while i < text.len() && text[i] == '.'
        i @ i + 1

    if i < text.len() && (text[i] == '=' || text[i] == '<')
        i @ i + 1
    return i

# The decimal number that ends at `dot` and holds a point already, `1.5`
# before the `.` of `1.5.2`, or empty: digits, a point, digits, written
# against the `.`.
function number_before(text: str, dot: i64) -> str
    i: i64 @= dot

    while i > 0 && (bytes.is_digit(text[i - 1]) || text[i - 1] == '_')
        i @ i - 1

    if i == dot || i < 2 || text[i - 1] != '.' || !bytes.is_digit(text[i - 2])
        return ""
    start: i64 @= i - 1

    while start > 0 && (bytes.is_digit(text[start - 1]) || text[start - 1] == '_')
        start @ start - 1

    if start > 0 && (bytes.is_alpha(text[start - 1]) || text[start - 1] == '.')
        return ""
    return text.slice(from: start, to: dot)

## Tests

test "two dots or more are a range, with a `=` or a `<` against the last"
    assert range_end("1..2", dot: 1) == 3
    assert range_end("0...5", dot: 1) == 4
    assert range_end("0..=5", dot: 1) == 4
    assert range_end("0..<5", dot: 1) == 4
    assert range_end("1 .. 2", dot: 2) == 4
    assert range_end("xs.len()", dot: 2) == -1
    assert range_end("1.", dot: 1) == -1

test "a second point follows a decimal number written against it"
    assert number_before("1.5.2", dot: 3) == "1.5"
    assert number_before("x = 10.0.0.1", dot: 8) == "10.0"
    assert number_before("1_000.25.3", dot: 8) == "1_000.25"
    assert number_before("xs.0.1", dot: 4) == ""
    assert number_before("v1.5.2", dot: 4) == ""
    assert number_before("15.2", dot: 2) == ""
    assert after("1.5.2", dot: 3) == " — a number holds one decimal point, and `1.5` already has its own"
    assert after("1.5.x", dot: 3) == ""
