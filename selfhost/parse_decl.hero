# The top level: the six declaration heads, one shape (design.md §4.1, §4.2,
# §4.18, §4.19; panels 018, 036, 055, 060, 061, 074).
# Port of crates/heroes/src/syntax/{decl,data,externs,extern_members}.rs —
# four files, 765 lines, one module here.
#
# ## The map this file owes its reader (CLAUDE.md §11, 2026-08-16)
#
# **This is one module because the language leaves no choice.** Heroes refuses
# module cycles, and the four Rust files call each other in a ring held
# together by `super::`: `file` (decl) dispatches to `record` (data) and
# `extern_group` (externs), the group's `members` (extern_members) calls back
# into `constant_tail` and `function_tail` (decl), and `record_with_doc`
# (data) — so the knot is one file or nothing, exactly as the expression
# grammar before it.
#
# **The ring**: `file` → `extern_group` → `members` → {`constant_tail`,
# `function_tail`, `record_with_doc`} → back into the same tails `file`'s own
# dispatch reaches through `constant_declaration`, `function_declaration` and
# `record_declaration`. The edges that LEAVE the knot and stay other modules:
# `parse_type` (types), `parse_members` (params, fields, cases — leaf),
# `grammar_expr` (bodies), `parse_use` (the one declaration that names a
# file).
#
# **The entry point is `file`**, and it is the whole public surface for a
# caller that wants a program parsed: it reads declarations until `eof`, and
# every path either builds a declaration or recovers past one, so the loop
# always makes progress. That closed keyword set — every top-level line
# starts with its kind — is also recovery's anchor: one broken declaration
# can never swallow the next one (panel 018).
#
# **The group is flattened here and only here** (§4.19, panel 036). One
# `Decl` per signature, each carrying the head line's spans, because a
# declaration's index is identity for every later pass. Nothing after the
# parser knows the word "group".

use token
use cursor
use ast
use diag
use lexer
use parse_type
use parse_members
use parse_use
use grammar_expr

## Linkage — where a declaration's implementation comes from

# Where a signature's implementation comes from, and — when it comes from C —
# the two strings the group's head line carried (§4.19, panel 036). A copy
# per member rather than a shared index: the group exists only in the source
# text, and every later pass sees N ordinary declarations.
#
# Port note: Rust's `Linkage::Extern` cannot keep its name — `extern` is a
# Heroes keyword — so the case says what it means instead: `from_c`.
variant Linkage
    heroes
    from_c
        header: token.Span
        library: ast.Library?

function is_from_c(l: Linkage) -> bool
    return match l
        .heroes => false
        .from_c _ => true

function linkage_header(l: Linkage) -> token.Span?
    return match l
        .heroes => fail("absent", "an ordinary declaration has no header")
        .from_c x => ok(x.header)

function linkage_library(l: Linkage) -> ast.Library?
    return match l
        .heroes => fail("absent", "an ordinary declaration names no library")
        .from_c x => x.library

## The dispatcher

# Read declarations until end of file. Every path either builds a declaration
# or recovers past one, so this loop always makes progress.
function file(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], @uses: [ast.Use], text: str)
    done: bool @ false
    while !done
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)
        if k == .eof
            done @ true
        else if k == .kw_constant
            constant_declaration(@c, @a, @decls, text)
        else if k == .kw_function
            function_declaration(@c, @a, @decls, text)
        else if k == .kw_record
            record_declaration(@c, @a, @decls, text, .heroes)
        else if k == .kw_variant
            variant_declaration(@c, @a, @decls, text)
        else if k == .kw_extern
            extern_group(@c, @a, @decls, text)
        else if k == .kw_test
            test_declaration(@c, @a, @decls, text)
        else if k == .kw_use
            parse_use.declaration(@c, @uses, text)
        else
            unexpected_top_level(@c, text)

function unexpected_top_level(@c: cursor.Cursor, text: str)
    if !cursor.at_reported_error(c)
        cursor.error(@c, code: "expected_declaration", message: "expected a declaration, found " + cursor.found(c, text) + " — every top-level line starts with its kind: `use`, `constant`, `function`, `record`, `variant`, `test \"…\"`, or `extern`", span: cursor.current_span(c))
    # The one arm that has consumed nothing yet, so it consumes here: recovery
    # only drops the REST of a broken line, and the dispatcher must always
    # move. An indented block at top level belongs to no declaration, so it is
    # dropped whole — and nothing else is, because the next line is innocent.
    if cursor.at(c, .indent)
        _ = cursor.balanced_block(@c)
    else
        _ = cursor.bump(@c)
        cursor.recover_to_next_decl(@c)

## The shared head

# The shared head of every named declaration: the kind keyword —
# documentation attaches to it, since it opens the line — then the declared
# name. The error side is already recovered when this fails, so a failing
# head costs the caller one `return`.
#
# Port note: Rust returns `Option<(Span, Vec<Span>, Span)>`; Heroes has no
# tuples, so the three travel as a record and the `Option` is a fallible.
record Head
    keyword: token.Span
    doc: [token.Span]
    name: token.Span

function head(@c: cursor.Cursor, text: str, example: str) -> Head?
    keyword = cursor.current_span(c)
    doc = cursor.take_docs(@c, text, keyword)
    kind_text = cursor.found(c, text)
    _ = cursor.bump(@c)
    if !cursor.at(c, .ident)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "expected_name", message: "expected the declared name after " + kind_text + ", found " + cursor.found(c, text) + " — `" + example + "`", span: cursor.current_span(c))
        cursor.recover_to_next_decl(@c)
        return fail("expected_name", "recovered to the next declaration")
    return ok(Head(keyword: keyword, doc: doc, name: cursor.bump(@c).span))

# Rust's `here_or` falls back to the declaration's own keyword when the
# current token sits in the appended library text (§1.11), so a file ENDING
# in a bodyless declaration never points at a line the author cannot open.
# **This parser has no Source and no appended library yet**, so the fallback
# arm cannot fire and the current span is always the author's file — a
# premise that dies the day the Source port arrives, which is why the name
# and the call sites are kept one-to-one with Rust: only this body changes.
function here_or(c: cursor.Cursor, fallback: token.Span) -> token.Span
    _ = fallback
    return cursor.current_span(c)

## constant

# `constant MAX_DEPTH: i64` + the value, indented (§4.2). Constants use
# SCREAMING_CASE by convention; the parser does not police it.
function constant_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    h = head(@c, text: text, example: "constant MAX_DEPTH: i64")
    if h.is_err()
        return
    hd = h.must()
    constant_tail(@c, @a, @decls, text, keyword: hd.keyword, doc: hd.doc, name: hd.name, linkage: .heroes)

# Everything after a constant's name: its type, and — for a non-extern — the
# indented value. Shared by `constant` and a group's members, exactly as
# `function_tail` is (§4.2, §4.19).
#
# The symmetry is the whole rule this form rests on: **inside a group a
# declaration is a signature, not a definition**, so `constant` gives up its
# body for the same reason `function` gives up its own — C has the thing.
function constant_tail(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, keyword: token.Span, doc: [token.Span], name: token.Span, linkage: Linkage)
    if !cursor.expect(@c, text: text, kind: .colon, code: "expected_constant_type", what: "`:` and the constant's type — a `constant` declares a value, so it has one")
        cursor.recover_to_next_decl(@c)
        return
    ty = parse_type.parse_type(@c, @a, text)
    # An `extern` constant has no body, and an indented one under it is the
    # mistake `body_check` names. Everything else keeps the old shape.
    body: ast.Block? @ fail("absent", "an extern constant's value is the header's")
    if is_from_c(linkage)
        body_check(@c, "constant")
    else
        b = grammar_expr.block(@c, @a, text: text, owner: "a `constant`")
        if b.is_err()
            cursor.recover_to_next_decl(@c)
            return
        body @ b
    finish: token.Span @ cursor.previous_significant_span(c)
    if !body.is_err()
        finish @ body.must().span
    decls @ decls.push(ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: finish.end), kind: .constant_decl(ty: ty, body: body, header: linkage_header(linkage), library: linkage_library(linkage))))

## function

# `function dist2(a: Point, b: Point) -> i64` + body (§4.2). The parameter
# list attaches to the name, as at the call site.
function function_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    h = head(@c, text: text, example: "function dist2(a: Point, b: Point) -> i64")
    if h.is_err()
        return
    hd = h.must()
    function_tail(@c, @a, @decls, text, keyword: hd.keyword, doc: hd.doc, name: hd.name, linkage: .heroes)

# Everything after a function's name: generics, the signature, and — for a
# non-extern — the body. Shared by `function` and a group's members.
function function_tail(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, keyword: token.Span, doc: [token.Span], name: token.Span, linkage: Linkage)
    is_extern = is_from_c(linkage)
    generic_names = parse_members.generics(@c, text)
    if !cursor.at(c, .lparen)
        # `params` reports the missing `(` with its own message.
        _ = parse_members.params(@c, @a, text)
        cursor.recover_to_next_decl(@c)
        return
    parameters = parse_members.params(@c, @a, text)
    # No `->` means no value. The `unit` node is synthesised at the end of the
    # header so later passes never have to ask whether the arrow was written
    # (§4.3: `()` is a type like any other).
    result: i64 @ 0
    if cursor.eat(@c, .arrow)
        result @ parse_type.parse_type(@c, @a, text)
    else
        here = cursor.current_span(c)
        result @ ast.push_type(@a, ast.TypeNode(kind: .unit, span: token.Span(start: here.start, end: here.start)))
    body: ast.Block? @ fail("absent", "an extern function's code comes from C")
    if is_extern
        body_check(@c, "function")
    else
        b = grammar_expr.block(@c, @a, text: text, owner: "a `function`")
        if b.is_err()
            cursor.recover_to_next_decl(@c)
            return
        body @ b
    finish: token.Span @ cursor.previous_significant_span(c)
    if !body.is_err()
        finish @ body.must().span
    f = ast.FunctionDecl(generics: generic_names, params: parameters, result: result, body: body, is_extern: is_extern, header: linkage_header(linkage), library: linkage_library(linkage))
    decls @ decls.push(ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: finish.end), kind: .function_decl(value: f)))

## test

# `test "3-4-5 triangle"` + body (§4.18). The name is a string, not an
# identifier: it is a title, and it is printed when the test fails.
function test_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    keyword = cursor.current_span(c)
    doc = cursor.take_docs(@c, text, keyword)
    _ = cursor.bump(@c)
    if !cursor.at(c, .str_lit)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "expected_test_name", message: "expected the test's name as a string, found " + cursor.found(c, text) + " — `test \"3-4-5 triangle\"`", span: cursor.current_span(c))
        cursor.recover_to_next_decl(@c)
        return
    name = cursor.bump(@c).span
    b = grammar_expr.block(@c, @a, text: text, owner: "a `test`")
    if b.is_err()
        cursor.recover_to_next_decl(@c)
        return
    body = b.must()
    decls @ decls.push(ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: body.span.end), kind: .test_decl(body: body)))

## record

# `record Point` + one field per line (§4.2) — and, since panel 060, the same
# shape inside an `extern` group, where the fields describe a struct the
# header already declares (§4.19). One entry point for both, because the
# SYNTAX is identical: what differs is the linkage handed in, and every
# question a later pass asks reads `header` rather than re-deriving it from
# where the declaration was parsed.
function record_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, linkage: Linkage)
    h = head(@c, text: text, example: "record Point")
    if h.is_err()
        return
    hd = h.must()
    record_tail(@c, @a, @decls, text, keyword: hd.keyword, doc: hd.doc, name: hd.name, linkage: linkage)

# The same declaration when the caller has **already taken the doc comment** —
# which is what a group member needs, because a group's own doc documents its
# first member and `head` would take the run a second time (§4.1's adjacency
# rule, applied to a block).
function record_with_doc(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, doc: [token.Span], linkage: Linkage)
    keyword = cursor.current_span(c)
    _ = cursor.bump(@c)
    if !cursor.at(c, .ident)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "expected_name", message: "expected the C struct's name after `record`, found " + cursor.found(c, text) + " — `record Color`", span: cursor.current_span(c))
        cursor.skip_line(@c)
        return
    name = cursor.bump(@c).span
    record_tail(@c, @a, @decls, text, keyword: keyword, doc: doc, name: name, linkage: linkage)

# `tag stat` after a group `record`'s name, if it is there (panel 074).
#
# **Contextual exactly like `partial`, and for the same reason**: it is
# consumed only in this position, so `tag` stays an ordinary identifier
# everywhere in the language and a field named `tag` goes on compiling. What
# follows it must be an identifier — C's tag — and a missing one is reported
# here rather than left to the field block, which would say something about
# indentation.
#
# **Order is `tag <name>` then `partial`**, and the other order is a parse
# error on purpose: one order that parses is one order to learn.
function tag_marker(@c: cursor.Cursor, text: str, in_group: bool) -> token.Span?
    if !in_group || !cursor.at(c, .ident) || cursor.slice_of(text, cursor.current_span(c)) != "tag"
        return fail("absent", "no tag clause")
    keyword = cursor.bump(@c).span
    if !cursor.at(c, .ident)
        cursor.error(@c, code: "expected_declaration", message: "`tag` names the struct tag C uses for this type: `record FileStat tag stat`", span: here_or(c, keyword))
        return fail("absent", "the tag's name is missing")
    return ok(cursor.bump(@c).span)

# `partial` after a group `record`'s name, if it is there.
#
# **A contextual keyword and not a reserved word** (panel 061). It is consumed
# only here, in the one position where a declaration can carry it, so
# `partial` stays an ordinary identifier everywhere in the language.
# **Only inside a group**: an ordinary `record` has no header behind it, so
# there is no struct for its field list to be a subset OF.
function partial_marker(@c: cursor.Cursor, text: str, in_group: bool) -> bool
    if !in_group || !cursor.at(c, .ident) || cursor.slice_of(text, cursor.current_span(c)) != "partial"
        return false
    _ = cursor.bump(@c)
    return true

function record_tail(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, keyword: token.Span, doc: [token.Span], name: token.Span, linkage: Linkage)
    tag = tag_marker(@c, text, in_group: is_from_c(linkage))
    partial = partial_marker(@c, text, in_group: is_from_c(linkage))
    grammar_expr.eat_python_colon(@c)
    cursor.skip_terminators(@c)
    if !cursor.at(c, .indent)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "empty_record", message: "a `record` needs at least one field, indented one level below it", span: here_or(c, keyword))
        cursor.recover_to_next_decl(@c)
        return
    start = cursor.current_span(c)
    fields = parse_members.field_block(@c, @a, text)
    finish: token.Span @ start
    if fields.len() > 0
        finish @ fields[fields.len() - 1].name
    decls @ decls.push(ast.Decl(name: name, doc: doc, span: token.Span(start: keyword.start, end: finish.end), kind: .record_decl(fields: fields, header: linkage_header(linkage), library: linkage_library(linkage), partial: partial, tag: tag)))

## variant

# `variant Token` + one case per line, each case optionally carrying fields —
# a case with fields IS a small record (§4.2).
function variant_declaration(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    h = head(@c, text: text, example: "variant Token")
    if h.is_err()
        return
    hd = h.must()
    grammar_expr.eat_python_colon(@c)
    cursor.skip_terminators(@c)
    if !cursor.at(c, .indent)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "empty_variant", message: "a `variant` needs at least one case, indented one level below it", span: here_or(c, hd.keyword))
        cursor.recover_to_next_decl(@c)
        return
    start = cursor.current_span(c)
    cases = parse_members.case_block(@c, @a, text)
    finish: token.Span @ start
    if cases.len() > 0
        finish @ cases[cases.len() - 1].name
    decls @ decls.push(ast.Decl(name: hd.name, doc: hd.doc, span: token.Span(start: hd.keyword.start, end: finish.end), kind: .variant_decl(cases: cases)))

## The extern group

# ```
# extern "sqlite3.h" link "sqlite3"
#     function sqlite3_open(path: cstr, out: ptr) -> i64
# ```
#
# The head line names the header and, optionally, the library; the members
# are signatures with no bodies, because C provides the code (§4.19, panel
# 036).
#
# **The header is not optional, and that is the point of the form.** §4.19's
# whole mechanism is the `#include` — clang checking a signature against the
# real declaration — so a headerless `extern` would emit a prototype that is
# self-consistent by construction and verified by nothing. Panel 030 measured
# what that costs: `void *fopen(const char *, const char *)` links by
# accident on arm64, silently.
#
# `link` is matched as a word, not lexed as a keyword: reserving it would put
# it in the foreign-word registry, where §4.19's own open question already
# records that C headers use ordinary words as identifiers 571 times over.
function extern_group(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str)
    keyword = cursor.current_span(c)
    doc = cursor.take_docs(@c, text, keyword)
    _ = cursor.bump(@c)
    h = group_header(@c, text)
    if h.is_err()
        return
    header = h.must()
    library = library_clause(@c, text)
    cursor.skip_terminators(@c)
    if !cursor.at(c, .indent)
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "expected_extern_block", message: "an `extern` group's signatures are indented under it — `extern \"math.h\"` then `    function sqrt(x: f64) -> f64` (§4.19)", span: cursor.current_span(c))
        return
    members(@c, @a, @decls, text, group_doc: doc, linkage: .from_c(header: header, library: library))

# The head line's header string. A missing one is where the old headerless
# spelling lands, so the message repairs THAT program rather than describing
# the grammar.
function group_header(@c: cursor.Cursor, text: str) -> token.Span?
    if cursor.at(c, .str_lit)
        span = cursor.bump(@c).span
        machine_locked(@c, text: text, span: span, what: "header")
        return ok(span)
    if !cursor.at_reported_error(c)
        message: str @ "expected the header's name in quotes after `extern`, found " + cursor.found(c, text) + " — `extern \"sqlite3.h\"`"
        if cursor.at(c, .kw_function)
            message @ "an `extern` names the header its signatures come from — `extern \"math.h\"`, then the signatures indented under it. Without the header there is no `#include`, and nothing checks the declaration (§4.19)"
        cursor.error(@c, code: "expected_extern_header", message: message, span: cursor.current_span(c))
    cursor.recover_to_next_decl(@c)
    return fail("expected_extern_header", "recovered to the next declaration")

# **A string in a group head may not name an absolute path** (panel 055).
#
# Only the absolute form is refused, and the narrowing is the point:
# `extern "sub/bar.h"` resolves against the `.hero` file's own directory
# (panel 036's `-I <source dir>`), so a vendored header beside the program is
# portable and correct. *"This string begins with a filesystem root"* is a
# fact about the value; *"nobody needs a relative path"* would be a premise
# about the world (CLAUDE.md §11).
#
# The repair is not text, so there is no fix: the answer is `CPATH` or a
# `.pc` on `PKG_CONFIG_PATH`, and a certain fix that rewrote the string would
# be a lie.
function machine_locked(@c: cursor.Cursor, text: str, span: token.Span, what: str)
    value = parse_use.unquote(cursor.slice_of(text, span))
    # A leading root, a Windows drive letter, or — for a library only — GNU
    # `ld`'s `-l:filename` form, which is how a `link` string names a FILE
    # rather than a library: refused whatever follows the colon, because the
    # whole point of the form is that the rest is a filename.
    rooted: bool @ false
    if value.len() > 0
        first = value[0]
        rooted @ first == '/' || first == '\\' || first == ':'
    if !rooted && value.len() > 1
        rooted @ value[1] == ':'
    if !rooted
        return
    route: str @ "set `LIBRARY_PATH` to the directory holding it, or name a `package` and let `pkg-config` answer; `link` takes the library's **name**, as `link \"sqlite3\"`"
    if what == "header"
        route @ "set `CPATH` to the directory holding it, or name a `package` and let `pkg-config` answer; a header beside this file is written relative, as `sub/foo.h`"
    cursor.error(@c, code: "machine_locked_path", message: "`" + value + "` names a path, and a " + what + " in a group head says what the machine has, not where this machine keeps it — the next machine keeps it elsewhere\n  " + route, span: span)

# `link "sqlite3"` or `package "raylib"` — optional, one or the other, and
# both matched by text rather than lexed as keywords, for the reason above.
#
# **They are alternatives because they are different questions.** `link`
# tells the linker a name the program already knows; `package` asks the
# machine, and gets a different answer per platform from one spelling.
# Writing both would mean the program both knew and did not know, so the
# second is refused with the first one named.
function library_clause(@c: cursor.Cursor, text: str) -> ast.Library?
    first = one_library(@c, text)
    if first.is_err()
        return first
    taken = first.must()
    machine_locked(@c, text: text, span: library_name_span(taken), what: "library")
    # A second clause on the same head line. The message names what is
    # already there, because the repair is to delete one and the author must
    # be told which one they wrote first.
    extra = one_library(@c, text)
    if !extra.is_err()
        if !cursor.at_reported_error(c)
            cursor.error(@c, code: "one_library_per_group", message: "this group already says `" + library_word(taken) + "`, so `" + library_word(extra.must()) + "` is a second answer to the same question — a group names a library or asks for a package, never both", span: library_name_span(extra.must()))
    return ok(taken)

function library_word(l: ast.Library) -> str
    return match l
        .link => "link"
        .package => "package"

function library_name_span(l: ast.Library) -> token.Span
    return match l
        .link x => x.name
        .package x => x.name

function one_library(@c: cursor.Cursor, text: str) -> ast.Library?
    if !cursor.at(c, .ident)
        return fail("absent", "no library clause")
    word = cursor.slice_of(text, cursor.current_span(c))
    if word != "link" && word != "package"
        return fail("absent", "no library clause")
    is_package = word == "package"
    _ = cursor.bump(@c)
    if !cursor.at(c, .str_lit)
        if !cursor.at_reported_error(c)
            message: str @ "expected the library's name in quotes after `link`, found " + cursor.found(c, text) + " — `link \"sqlite3\"`, which is `-lsqlite3` to the linker"
            if is_package
                message @ "expected the package's name in quotes after `package`, found " + cursor.found(c, text) + " — `package \"raylib\"`, which is what the machine is asked about"
            cursor.error(@c, code: "expected_link_name", message: message, span: cursor.current_span(c))
        return fail("absent", "the clause's string is missing")
    span = cursor.bump(@c).span
    if is_package
        return ok(.package(name: span))
    return ok(.link(name: span))

## Inside the group

# The indented signatures. Every one becomes its own declaration carrying the
# group's header and link — the flattening panel 036 made a condition.
#
# Recovery here is `skip_line`, never `recover_to_next_decl`: inside a block,
# dropping "the rest of the declaration" would eat the members that follow,
# and `field_block` and `case_block` skip a line for the same reason.
function members(@c: cursor.Cursor, @a: ast.Ast, @decls: [ast.Decl], text: str, group_doc: [token.Span], linkage: Linkage)
    _ = cursor.bump(@c)
    first: bool @ true
    done: bool @ false
    while !done
        cursor.skip_terminators(@c)
        k = cursor.current_kind(c)
        if k == .dedent
            _ = cursor.bump(@c)
            done @ true
        else if k == .eof
            done @ true
        else if k == .kw_record
            # **A `record` is a member like the other two** (panel 060). It
            # takes the group's doc on the first line exactly as they do.
            keyword = cursor.current_span(c)
            doc: [token.Span] @ group_doc
            if !first
                doc @ cursor.take_docs(@c, text, keyword)
            first @ false
            record_with_doc(@c, @a, @decls, text, doc: doc, linkage: linkage)
        else if k == .kw_function || k == .kw_constant
            is_constant = k == .kw_constant
            keyword = cursor.current_span(c)
            # The group's own doc comment documents its first signature; after
            # that each line takes its own, exactly as a record's fields do.
            doc: [token.Span] @ group_doc
            if !first
                doc @ cursor.take_docs(@c, text, keyword)
            first @ false
            _ = cursor.bump(@c)
            if !cursor.at(c, .ident)
                if !cursor.at_reported_error(c)
                    message: str @ "expected the C function's name, found " + cursor.found(c, text) + " — `function sqrt(x: f64) -> f64`"
                    if is_constant
                        message @ "expected the C constant's name, found " + cursor.found(c, text) + " — `constant SQLITE_OK: i64`"
                    cursor.error(@c, code: "expected_name", message: message, span: cursor.current_span(c))
                cursor.skip_line(@c)
                continue
            name = cursor.bump(@c).span
            if is_constant
                constant_tail(@c, @a, @decls, text, keyword: keyword, doc: doc, name: name, linkage: linkage)
            else
                function_tail(@c, @a, @decls, text, keyword: keyword, doc: doc, name: name, linkage: linkage)
        else
            if !cursor.at_reported_error(c)
                cursor.error(@c, code: "expected_extern_signature", message: "expected a `function`, a `constant` or a `record`, found " + cursor.found(c, text) + " — an `extern` group holds what the header declares, one per line", span: cursor.current_span(c))
            if cursor.at(c, .indent)
                _ = cursor.balanced_block(@c)
            else
                cursor.skip_line(@c)

# An `extern` with a body is a mistake worth naming: the body would never be
# compiled, and silently ignoring it is the class of thing this language
# exists to make loud.
#
# `kind` is what the member is, because the repair differs: a `function`'s
# code comes from C, a `constant`'s VALUE does — and telling a reader who
# wrote `constant SQLITE_OK: i64` with `0` under it that "it names a C
# function" sends them looking for a function they never wrote (§4.17).
function body_check(@c: cursor.Cursor, kind: str)
    cursor.skip_terminators(@c)
    if !cursor.at(c, .indent)
        return
    span = cursor.current_span(c)
    what: str @ "an `extern` declaration has no body — it names a C function, and C provides the code"
    if kind == "constant"
        what @ "an `extern` declaration has no body — this `constant` names one the header already defines, so the value is the header's and never yours"
    cursor.error(@c, code: "extern_has_body", message: what, span: span)
    _ = cursor.balanced_block(@c)

## Tests

# The tests lex REAL source with the ported lexer rather than hand-building
# token streams: a declaration's stream carries indents, dedents and
# terminators whose placement is the lexer's judgment, and hand-placing them
# would test this parser against my guess instead of against the language.
record Parsed
    decls: [ast.Decl]
    uses: [ast.Use]
    diagnostics: [diag.Diagnostic]
    tree: ast.Ast

function parse_source(text: str) -> Parsed
    out = lexer.lex_one(text)
    c: cursor.Cursor @ cursor.new_cursor(out.tokens)
    a: ast.Ast @ ast.new_ast()
    decls: [ast.Decl] @ []
    uses: [ast.Use] @ []
    file(@c, @a, @decls, @uses, text)
    return Parsed(decls: decls, uses: uses, diagnostics: c.diagnostics, tree: a)

test "a constant is a name, a type and an indented value"
    text = "constant MAX: i64\n    64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    assert cursor.slice_of(text, p.decls[0].name) == "MAX"
    match p.decls[0].kind
        .constant_decl k =>
            assert !k.body.is_err()
            assert k.header.is_err()
            assert k.library.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => assert false

test "a signature without an arrow gets a unit result, synthesised"
    text = "function f()\n    return\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    match p.decls[0].kind
        .function_decl fd =>
            assert !fd.value.is_extern
            assert fd.value.params.len() == 0
            assert p.tree.types[fd.value.result].kind == .unit
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false

test "record and variant own their members directly"
    text = "record Point\n    x: i64\n    y: i64\n\nvariant Token\n    num\n        v: i64\n    plus\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 2
    match p.decls[0].kind
        .record_decl r =>
            assert r.fields.len() == 2
            assert !r.partial
            assert r.tag.is_err()
        .constant_decl | .function_decl | .variant_decl | .test_decl => assert false
    match p.decls[1].kind
        .variant_decl v =>
            assert v.cases.len() == 2
            assert v.cases[0].fields.len() == 1
            assert v.cases[1].fields.len() == 0
        .constant_decl | .function_decl | .record_decl | .test_decl => assert false

test "a use line and a doc comment land where they belong"
    text = "use geom\n\n# the ceiling\nconstant MAX: i64\n    64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.uses.len() == 1
    assert cursor.slice_of(text, p.uses[0].name) == "geom"
    assert p.decls.len() == 1
    assert p.decls[0].doc.len() == 1
    assert cursor.slice_of(text, p.decls[0].doc[0]) == "# the ceiling"

test "the group is flattened here and only here"
    text = "extern \"m.h\" link \"m\"\n    function q(x: f64) -> f64\n    constant K: i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 2
    match p.decls[0].kind
        .function_decl fd =>
            assert fd.value.is_extern
            assert fd.value.body.is_err()
            assert cursor.slice_of(text, fd.value.header.must()) == "\"m.h\""
            match fd.value.library.must()
                .link l => assert cursor.slice_of(text, l.name) == "\"m\""
                .package => assert false
        .constant_decl | .record_decl | .variant_decl | .test_decl => assert false
    match p.decls[1].kind
        .constant_decl k =>
            assert k.body.is_err()
            assert !k.header.is_err()
        .function_decl | .record_decl | .variant_decl | .test_decl => assert false

test "tag then partial, both contextual, both only in a group"
    text = "extern \"s.h\"\n    record FileStat tag stat partial\n        size: i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 0
    assert p.decls.len() == 1
    match p.decls[0].kind
        .record_decl r =>
            assert r.partial
            assert cursor.slice_of(text, r.tag.must()) == "stat"
            assert !r.header.is_err()
        .constant_decl | .function_decl | .variant_decl | .test_decl => assert false

test "one bad declaration costs one diagnostic and never the next"
    text = "junk\nfunction f()\n    return\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "expected_declaration"
    assert p.decls.len() == 1
    assert cursor.slice_of(text, p.decls[0].name) == "f"

test "an extern body is named for what it is, and the member survives"
    text = "extern \"m.h\"\n    function q() -> i64\n        return 1\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "extern_has_body"
    assert p.decls.len() == 1

test "an absolute path in a group head is the machine's, not the program's"
    text = "extern \"/opt/x.h\"\n    function q() -> i64\n"
    p = parse_source(text)
    assert p.diagnostics.len() == 1
    assert p.diagnostics[0].code == "machine_locked_path"
    assert p.decls.len() == 1
