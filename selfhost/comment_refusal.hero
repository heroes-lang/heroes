# A comment's characters a reader cannot see (panel 192's R3; defects 251 and
# 283): a comment refuses what a string refuses written as itself but the
# tab, which a comment holds, and writes such a character by its name,
# `<U+202E>`, the form a diagnostic shows it in. What is refused and what is
# said of it are `raw_refusal`'s; this finds the comment and walks it.
#
# **After the line, never inside the comment's own scan.** `lexer.lexed`
# asks `refuse_in_line` once a line, after `scan.line_body`: the comment's
# scan is `scan.comment`, which another lane held when this landed, and a
# `#` or `//` comment ends its line, so what is said of it follows what was
# said of the code before it, as inside the scan it would. A clean comment
# costs one scan of its bytes and no list (panel 192's R11, measured).

use token
use diag
use state
use raw_refusal

# What the comment the line from `from` made holds that a reader cannot see,
# told once a run into `diagnostics`; nothing where the line made none or its
# comment is clean, which is asked of its bytes before any list is made.
function refuse_in_line(@diagnostics: [diag.Diagnostic], tokens: [token.Token], held: [token.Token], text: str, from: i64)
    found = comment_span(tokens: tokens, held: held, text: text, from: from)

    if found.start < 0 || raw_refusal.clear(text, from: found.start) >= found.end
        return

    for d in in_comment(text, span: found)
        state.push_diagnostic(@diagnostics, d)

# The comment the scan of one line made, from `from` on, a `#` or `//` one,
# or a span starting at -1 where it made none: such a comment ends its line,
# so it is the last token the line pushed but the line end's own, in `tokens`
# or, held behind a terminator the line above owes, in `held`, and finding it
# walks back over those few and no further. A `/* … */` comment is refused
# whole already (`scan.foreign_comment`), its fix writing it with `#`, which
# this reads at the next check.
function comment_span(tokens: [token.Token], held: [token.Token], text: str, from: i64) -> token.Span
    found = last_comment(tokens, text: text, from: from)

    if found.start >= 0
        return found
    return last_comment(held, text: text, from: from)

# The comment that ends the line from `from` among `tokens`, past the tokens
# a line's end pushes after it: a terminator, an indent or a dedent, the
# end of the file, or the error a literal the line left open ends with.
function last_comment(tokens: [token.Token], text: str, from: i64) -> token.Span
    i: i64 @ tokens.len() - 1

    while i >= 0 && tokens[i].span.start >= from && after_a_comment(tokens[i].kind)
        i @ i - 1

    if i >= 0 && tokens[i].span.start >= from && tokens[i].kind == .comment && line_comment(text, at: tokens[i].span.start)
        return tokens[i].span
    return token.Span(start: -1, end: -1)

function after_a_comment(kind: token.TokenKind) -> bool
    return kind == .terminator || kind == .indent || kind == .dedent || kind == .eof || kind == .error

function line_comment(text: str, at: i64) -> bool
    return text[at] == '#' || at + 1 < text.len() && text[at] == '/' && text[at + 1] == '/'

# What the comment over `span` refuses (panel 192's R3): every refused
# character but a tab, a run told once, a carriage return before the line
# feed being the line's end. Pure: the lexer asks it only where `clear`
# stopped inside the comment.
function in_comment(text: str, span: token.Span) -> [diag.Diagnostic]
    out: [diag.Diagnostic] @ []
    at: i64 @ raw_refusal.clear(text, from: span.start)

    while at < span.end
        b = text[at]

        if b == 9 || b == 13 && at + 1 < text.len() && text[at + 1] == 10
            at @ raw_refusal.clear(text, from: at + 1)
            continue
        end = raw_refusal.run_end(text, at: at)

        if end == at
            at @ raw_refusal.clear(text, from: at + 1)
            continue
        out @ out.push(raw_refusal.told_as(text, from: at, to: end, holder: .comment))
        at @ raw_refusal.clear(text, from: end)

    return out

## Tests

function words(text: str) -> [token.Token]
    return [
        token.Token(kind: .ident, span: token.Span(start: 0, end: 1))
        token.Token(kind: .comment, span: token.Span(start: 2, end: text.len() - 1))
        token.Token(kind: .terminator, span: token.Span(start: text.len() - 1, end: text.len()))
    ]

test "a line's comment is found past the line end's own tokens, and a clean one says nothing"
    none: [token.Token] = []
    clean = "x # clean\n"
    said: [diag.Diagnostic] @ []
    assert comment_span(tokens: words(clean), held: none, text: clean, from: 0).start == 2
    refuse_in_line(@said, tokens: words(clean), held: none, text: clean, from: 0)
    assert said.len() == 0
    assert comment_span(tokens: words(clean), held: none, text: clean, from: 3).start == -1
    esc: [u8] = [27]
    dirty = "x # a" + esc.validated_bytes().must() + "b\n"
    refuse_in_line(@said, tokens: words(dirty), held: none, text: dirty, from: 0)
    assert said.len() == 1
    assert said[0].code == "invisible_character"
    assert said[0].fixes[0].replacement == "<U+001B>"
    tabbed = "x # a\tb\n"
    refuse_in_line(@said, tokens: words(tabbed), held: none, text: tabbed, from: 0)
    assert said.len() == 1
