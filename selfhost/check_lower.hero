# A written type becomes an interned id (design.md §4.3, §4.6, §4.12).
# Port of crates/heroes/src/types/lower.rs.
#
# The resolver already answered the hard half: which declaration or
# primitive each named node refers to (type_uses). This file only
# rebuilds the shape, interning as it goes, so `[Point?]` written twice
# in one file is one id both times.
#
# Nothing here reports a diagnostic. An unresolved type name was already
# reported by the resolver, and saying it twice is the one thing this
# compiler never does — it becomes the error id, which every rule
# downstream stays quiet about.
#
# Every answer is RECORDED in written_types, keyed by the arena node it
# came from — because an extern's parameters have no locals (§4.19: no
# body, so the resolver makes none) and the lowering still has to know
# their types: the emitter writes a C prototype from them. Asking the
# locals table gave `?`, which is how this was found on the Rust side.

use ast
use source
use parse
use resolved
use resolve
use check_table
use check_state

function lower_ty(@c: check_state.Checker, a: ast.Ast, r: resolved.Resolved, id: i64) -> i64
    answer = shape(@c, a, r, id)
    c.out.written_types[id] @ answer
    return answer

function shape(@c: check_state.Checker, a: ast.Ast, r: resolved.Resolved, id: i64) -> i64
    return match a.types[id].kind
        .named => named(@c, r, id)
        .unit => check_table.unit_ty(c.out.types)
        .error => check_state.error_ty_of(c)
        .array_of inner =>
            element = lower_ty(@c, a, r, inner.element)
            check_table.intern(@c.out.types, .array(element: element))
        .fixed x =>
            element = lower_ty(@c, a, r, x.element)
            check_table.intern(@c.out.types, .fixed(element: element, length: x.length))
        .fallible o =>
            payload = lower_ty(@c, a, r, o.inner)
            check_table.intern(@c.out.types, .fallible(payload: payload))
        .map_of m =>
            key = lower_ty(@c, a, r, m.key)
            value = lower_ty(@c, a, r, m.value)
            check_table.intern(@c.out.types, .map(key: key, value: value))
        .function_type f =>
            lowered: [i64] @ []
            for p in f.params
                lowered @ lowered.push(lower_ty(@c, a, r, p))
            result = lower_ty(@c, a, r, f.result)
            check_table.intern_function(@c.out.types, lowered, result: result)

function named(@c: check_state.Checker, r: resolved.Resolved, id: i64) -> i64
    return match r.type_uses[id]
        .prim p =>
            structure: check_table.Ty = match p.value
                .int_prim k => .int_ty(kind: k.kind)
                .float_prim k => .float_ty(kind: k.kind)
                .bool_prim => .bool
                .str_prim => .str
                .ptr_prim => .ptr
                .cstr_prim => .cstr
            check_table.intern(@c.out.types, structure)
        .top t => check_table.intern(@c.out.types, .named(decl: t.at))
        .generic g => check_table.intern(@c.out.types, .generic(at: g.at))
        # The resolver already reported it.
        .unresolved => check_state.error_ty_of(c)

## Tests

# Parse and resolve real source, then lower the written types.
function lowered_program(text: str) -> check_state.Checker
    p = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(p.tree, s, p.decls, p.uses)
    c: check_state.Checker @ check_state.new_checker(out_of: out, expr_count: p.tree.exprs.len())
    i: i64 @ 0
    while i < p.tree.types.len()
        _ = lower_ty(@c, p.tree, out, i)
        i @ i + 1
    return c

test "a type written twice is one id both times"
    c = lowered_program("function f(a: [i64?], b: [i64?]) -> i64\n    return len(a) + len(b)\n")
    # The two parameter nodes lowered to the SAME id: interning is the
    # equality. Find the two array ids among the written types.
    ids: [i64] @ []
    for id in keys(c.out.written_types)
        got = c.out.written_types[id].must()
        found = match check_table.get(c.out.types, got)
            .array => true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit => false
            .fixed | .map | .fallible | .function_ty | .named => false
            .case_ty | .failure | .generic | .error => false
        if found
            ids @ ids.push(got)
    assert ids.len() == 2
    assert ids[0] == ids[1]

test "an extern's parameter types are recorded with no local to hang on"
    c = lowered_program("extern \"math.h\"\n    function pow(base: f64, exponent: f64) -> f64\n")
    # No locals exist, and still every written node has an answer.
    lowered: i64 @ 0
    for id in keys(c.out.written_types)
        _ = id
        lowered @ lowered + 1
    assert lowered == 3
    assert c.out.local_types.len() == 0

test "the resolver's silence lowers to the silent error id"
    c = lowered_program("function f(x: Qoint) -> i64\n    _ = x\n    return 1\n")
    # Qoint was the resolver's diagnostic; the lowering says nothing and
    # hands back id 0, which every downstream rule stays quiet about.
    poisoned_count: i64 @ 0
    for id in keys(c.out.written_types)
        if c.out.written_types[id].must() == 0
            poisoned_count @ poisoned_count + 1
    assert poisoned_count == 1
