# Heroes' own word tables: the keywords, which can never be identifiers, and
# the contextual words, each read in one position and a name everywhere else.
# Port of archive/bootstrap-rs/heroes/src/lexer/keywords.rs (M-selfhost-probe).
#
# `keyword` is the closed list from spec/reserved-words.md § keywords. The
# registry's other half, the foreign words that fail loudly with the repair
# pre-written, is `selfhost/foreign_words.hero`: the two tables were one file
# until 2026-10-14, when `rest` and `zero` joined the contextual words and took
# this one past §11's 300 lines, and the two tables were the seam its own doc
# named. Three instruments read this file as text, by its path: the `grammar`
# suite (the keyword arms and the `WORD_` constants), `suite_spec`'s colouring
# check, and `site/src/lib/tables.ts`, which colours the site from it.
#
# Port note: Rust returns `Option<TokenKind>`; Heroes has `T?`, so "not in the
# table" is a `fail` with its own code — the miss is the common case at every
# call site, and both callers already match on it.

use token

## Error codes

constant ERR_NOT_A_KEYWORD: str
    "not_a_keyword"

## The keywords

# The closed list, as a LIST, for the one caller that must enumerate what
# `keyword` below can only be asked about one word at a time: `heroes grammar`,
# which prints the language's terminals from the compiler's own tables rather
# than from a document somebody kept up to date (panel 133 R1).
#
# **Two spellings of one fact, and what holds them together is not a comment.**
# Heroes has no reflection, so this list cannot be derived from the match below
# and a word added to one and not the other would be a silence. The test at the
# foot of this file asserts every entry here is a keyword; the `grammar` suite
# asserts the other direction, reading the ARMS of `keyword` out of this file as
# text and comparing them to what the command prints. A word added to the match
# alone turns that check red, which is the direction a comment could never hold.
function keywords() -> [str]
    return [
        "constant"
        "function"
        "record"
        "variant"
        "match"
        "if"
        "else"
        "for"
        "while"
        "in"
        "break"
        "continue"
        "return"
        "test"
        "assert"
        "extern"
        "nullptr"
        "use"
        "true"
        "false"
        "fail"
    ]

## The contextual words

# A word the parser reads in ONE position and nowhere else, so a program may
# still call anything `owned` or `tag`. There were eleven of them and `heroes
# grammar` printed six (defect 087, panel 176's compiler-engineer): the words
# were literals at eleven sites in four parser files, and the command had no
# table to print, so its sentence was a count somebody had kept up to date until
# the day they had not. Each word is a constant here and the parser reads the
# constant, never a literal, so this file is the one spelling; `contextual()`
# lists them in declaration order for the command to print, and the `grammar`
# suite reads these declarations as text, holds the printed list to them, and
# holds `selfhost/parse/` to reading each one — the direction a comment could
# never hold.
constant WORD_AS: str
    "as"

constant WORD_LINK: str
    "link"

constant WORD_PACKAGE: str
    "package"

constant WORD_TAG: str
    "tag"

constant WORD_PARTIAL: str
    "partial"

constant WORD_OWNED: str
    "owned"

constant WORD_COUNTED_BY: str
    "counted_by"

constant WORD_LENT: str
    "lent"

constant WORD_CONSUMES: str
    "consumes"

constant WORD_ACQUIRES: str
    "acquires"

constant WORD_BORROWS: str
    "borrows"

constant WORD_TRANSFERS: str
    "transfers"

constant WORD_RETAINS: str
    "retains"

constant WORD_WHEN: str
    "when"

# `rest` and `zero` are read together and in one place: a labelled argument
# whose label is `rest` and whose value is the bare name `zero`, ending a call's
# list, is the words that end a construction of a group's record (panel 194;
# spec § 13). `parse/rest_words` takes them off the list, the name stage sets
# them apart in a variant case, and anywhere else each is a name, `zero` a
# binding like any other (defect 401). They landed on 2026-10-06 spelled as
# literals in four modules, and `heroes grammar` printed fourteen words while
# the parser read sixteen, defect 087's shape again, found at the milestone's
# opening on 2026-10-14.
constant WORD_REST: str
    "rest"

constant WORD_ZERO: str
    "zero"

# In declaration order, which is the order the command prints and the suite
# compares as a sequence.
function contextual() -> [str]
    return [
        WORD_AS
        WORD_LINK
        WORD_PACKAGE
        WORD_TAG
        WORD_PARTIAL
        WORD_OWNED
        WORD_COUNTED_BY
        WORD_LENT
        WORD_CONSUMES
        WORD_ACQUIRES
        WORD_BORROWS
        WORD_TRANSFERS
        WORD_RETAINS
        WORD_WHEN
        WORD_REST
        WORD_ZERO
    ]

# The closed list. A miss means the word is an ordinary identifier.
function keyword(text: str) -> token.TokenKind?
    return match text
        "constant" => ok(.kw_constant)
        "function" => ok(.kw_function)
        "record"   => ok(.kw_record)
        "variant"  => ok(.kw_variant)
        "match"    => ok(.kw_match)
        "if"       => ok(.kw_if)
        "else"     => ok(.kw_else)
        "for"      => ok(.kw_for)
        "while"    => ok(.kw_while)
        "in"       => ok(.kw_in)
        "break"    => ok(.kw_break)
        "continue" => ok(.kw_continue)
        "return"   => ok(.kw_return)
        "test"     => ok(.kw_test)
        "assert"   => ok(.kw_assert)
        "extern"   => ok(.kw_extern)
        "nullptr"  => ok(.kw_nullptr)
        "use"      => ok(.kw_use)
        "true"     => ok(.kw_true)
        "false"    => ok(.kw_false)
        "fail"     => ok(.kw_fail)
        _          => fail(code: ERR_NOT_A_KEYWORD, msg: text)

test "every keyword resolves and an identifier does not"
    assert keyword("function").must() == .kw_function
    assert keyword("nullptr").must() == .kw_nullptr
    assert keyword("fail").must() == .kw_fail
    assert keyword("main").is_err()
    assert keyword("Function").is_err()

    # The list and the match, one direction. Every word the list offers IS a
    # keyword, so the list can never advertise one the lexer does not reserve.
    # The other direction is the `grammar` suite's, which reads the arms out of
    # this file as text: together they leave no silence.
    for word in keywords()
        assert !keyword(word).is_err()

    # And the count, pinned, because a word DELETED from the list would pass the
    # loop above in silence. Twenty-one since the language reached its fixpoint;
    # it moves in the commit that adds or removes a keyword, never on its own.
    assert keywords().len() == 21

test "a contextual word is never a keyword, and each is listed once"
    words = contextual()
    assert words.len() == 16

    for word in words
        assert keyword(word).is_err()

    i: i64 @= 0

    while i < words.len()
        j: i64 @= i + 1

        while j < words.len()
            assert words[i] != words[j]
            j @ j + 1

        i @ i + 1
