# A character the language refuses, told once a cause and with a bound
# (defect 282, design.md §4.17). The scanner tells each such character
# (`scan.hero`), and a text full of them was a flood: 32 KB of control bytes
# drew 31,600 messages, each carrying its line, 8.8 billion instructions
# retired to render them, and 4,000 on one line wrote that line 4,000 times,
# 16 MB. Here, after a text is scanned (`lexer.lexed`):
#
# - a run of one refused character that cannot be seen, a control character
#   or an invisible one (`shown_char` names each by its code), is told once,
#   at its first, a note counting the run, where each character of it was a
#   message; a run that can be seen the scanner tells once itself since
#   defect 391 (`refused_stretch`), and two `;` keep a message each, as panel
#   187 pinned `;;` in a C-style `for` header;
# - past `TOLD` such messages in one text the rest are counted in a note on
#   the last one told, as `not_text` counts the lines it does not tell, a
#   stretch counting the characters it holds.
#
# Only the scanner's plain refusal is gathered, `unexpected_character` with
# no fix and no note, its message ending as `scan.hero` writes it, and a
# stretch `refused_stretch` tells, a string in backticks among them, whose
# fix is a guess: a refusal a certain fix repairs (`separator_runs`, the
# comment habits) keeps every message, since a message dropped is a repair
# `--apply` would no longer make.
#
# **And three more refusals, each a kind of its own** (defect 494, where
# 4,000 carriage returns in a row were 4,000 messages, 4,000 tabs 4,000 and
# 1,333 foreign words 1,333): a tab between tokens and a carriage return
# outside a line ending, a run of each next to one another told once and
# each kind `TOLD` times a text, its own count in its own words; and a
# foreign word with no fix, a run of the same message through the spaces
# between them told once, each run told, a word being a place its author
# edits. Each kind keeps its own run and its own count, so a tab between
# two control characters ends neither's run, and a text's characters are
# counted as they were.
#
# **A refused break names its diagnostic by its place** among its text's
# (`state.Break`), which `parse/apart` reads; a message counted rather than
# told moves the places after it, so `told_once` says where each one went and
# `renumbered` moves the breaks with them.

use token
use diag
use state
use shown_char
use backtick_strings

# How many refused characters are told one by one in a text.
constant TOLD: i64
    8

# How the scanner's refusal of one character ends (`scan.hero`, its
# `unexpected_character` for a character the syntax does not have).
constant SAID: str
    " is not part of the language's syntax"

# The kinds of refusal gathered (`kind_of`), each with its own runs and its
# own count: a character the syntax does not have, a tab between tokens, a
# carriage return outside a line ending, a foreign word.
constant CHARACTER: i64
    0

constant TAB: i64
    1

constant RETURN: i64
    2

constant WORD: i64
    3

# What the note on a kind's last told says of those counted past `TOLD`, by
# kind; a word is never counted.
constant COUNTED: [str]
    [
        " more characters of this file are not part of the language's syntax either, not told one by one"
        " more tabs of this file are a compile error too, not told one by one"
        " more carriage returns of this file stand outside a line ending too, not told one by one"
        ""
    ]

# A text's diagnostics as told, and where each one given stands among them:
# its place, or -1 for one counted rather than told.
record Told
    diagnostics: [diag.Diagnostic]
    at: [i64]

# The diagnostics of one text, its refusals of each kind told once a run and
# at most `TOLD` times, a word's every run, everything else as it was, in the
# order it was.
function told_once(diagnostics: [diag.Diagnostic], text: str) -> Told
    out: [diag.Diagnostic] @= []
    at: [i64] @= []

    # By kind (`kind_of`): where its run's first stands in `out`, -1 for one
    # counted rather than told; the run's length, its end and its words, and
    # whether its character is unseen; how many of the kind were told, the
    # last of them, and how many characters were counted.
    first: [i64] @= [-1, -1, -1, -1]
    run: [i64] @= [0, 0, 0, 0]
    run_end: [i64] @= [-1, -1, -1, -1]
    run_said: [str] @= ["", "", "", ""]
    run_unseen: [bool] @= [false, false, false, false]
    kept: [i64] @= [0, 0, 0, 0]
    last_kept: [i64] @= [-1, -1, -1, -1]
    unsaid: [i64] @= [0, 0, 0, 0]

    for d in diagnostics
        if !gathered(d)
            out @ out.push(d)
            at @ at.push(out.len() - 1)
            continue
        k = kind_of(d)

        # One more of the run: the same words, right after the last (`goes_on`).
        # The same message is the same character, so whether it is unseen is
        # asked once a run, at its first.
        if run[k] > 0 && d.message == run_said[k] && goes_on(kind: k, hidden: run_unseen[k], text, from: run_end[k], to: d.span.start)
            run[k] @ run[k] + 1
            run_end[k] @ d.span.end
            at @ at.push(-1)

            if first[k] < 0
                unsaid[k] @ unsaid[k] + 1
            continue
        out @ noted(out, at: first[k], run: run[k])
        run[k] @ 1
        run_end[k] @ d.span.end
        run_said[k] @ d.message
        run_unseen[k] @ unseen(d, text: text)

        if kept[k] == TOLD && k != WORD
            first[k] @ -1
            unsaid[k] @ unsaid[k] + characters(d, text: text)
            at @ at.push(-1)
            continue
        out @ out.push(d)
        first[k] @ out.len() - 1
        at @ at.push(first[k])
        last_kept[k] @ first[k]
        kept[k] @ kept[k] + 1

    for k in range(from: CHARACTER, to: WORD + 1)
        out @ noted(out, at: first[k], run: run[k])

        if unsaid[k] > 0
            out[last_kept[k]].notes @ out[last_kept[k]].notes.push(unsaid[k].to_str() + COUNTED[k])

    return Told(diagnostics: out, at: at)

# The kind of refusal a gathered `d` is (`told_once`).
function kind_of(d: diag.Diagnostic) -> i64
    if d.code == "tab_in_line"
        return TAB

    if d.code == "stray_carriage_return"
        return RETURN

    if d.code == "reserved_word"
        return WORD
    return CHARACTER

# Whether a refusal of the kind `kind` that begins at `to` goes on a run that
# ends at `from`: right after it, for a character only where it is unseen,
# `hidden`; and for a word through the spaces between, on its line.
function goes_on(kind: i64, hidden: bool, text: str, from: i64, to: i64) -> bool
    if kind == CHARACTER
        return hidden && to == from

    if kind != WORD || to <= from
        return to == from
    i: i64 @= from

    while i < to && i < text.len()
        if text[i] != ' '
            return false
        i @ i + 1

    return true

# The diagnostics of one text but those `dropped` marks, a message another
# reader tells instead (`heads_told.told_by_heads`, defect 250), with where
# each one given went, as `told_once` says it.
function without(diagnostics: [diag.Diagnostic], dropped: [bool]) -> Told
    out: [diag.Diagnostic] @= []
    at: [i64] @= []
    k: i64 @= 0

    for d in diagnostics
        if dropped[k]
            at @ at.push(-1)
        else
            out @ out.push(d)
            at @ at.push(out.len() - 1)
        k @ k + 1

    return Told(diagnostics: out, at: at)

# Where each diagnostic went through two of the steps above, the first's
# places read through the second's.
function through(first: [i64], then: [i64]) -> [i64]
    out: [i64] @= []

    for one in first
        if one < 0
            out @ out.push(-1)
        else
            out @ out.push(then[one])

    return out

# The breaks a text's lexing refused, each naming its diagnostic by the place
# `told_once` gave it; a break whose diagnostic was counted names none, which
# cannot happen, a break's being a join's, with its fix.
function renumbered(breaks: [state.Break], at: [i64]) -> [state.Break]
    out: [state.Break] @= []

    for b in breaks
        moved: state.Break @= b

        if b.diagnostic >= 0
            moved.diagnostic @ at[b.diagnostic]
        out @ out.push(moved)

    return out

# Whether `d` is the scanner's plain refusal of one character, or of a
# stretch told once (`refused_stretch`, defect 391): a run, in the same
# words, or a string in backticks, whose fix is a guess `--apply` never
# writes, so that a flood of them is bounded as one of characters is; or a
# tab, a carriage return or a foreign word with no fix (defect 494).
function gathered(d: diag.Diagnostic) -> bool
    if backtick_strings.is_template(d)
        return true

    if d.fixes.len() > 0 || d.notes.len() > 0
        return false

    if d.code == "tab_in_line" || d.code == "stray_carriage_return" || d.code == "reserved_word"
        return true
    return d.code == "unexpected_character" && d.message.len() >= SAID.len() && d.message.slice(from: d.message.len() - SAID.len(), to: d.message.len()) == SAID

# How many characters a refusal counted rather than told stands for, so the
# note's count stays one of characters: one for the scanner's own, and a
# stretch's every character but the spaces a run is told through and the
# line ends a template over lines holds (defect 407), which are the
# language's. Counted by the bytes that begin a character, never by a
# slice, so no span can stop the count by splitting one.
function characters(d: diag.Diagnostic, text: str) -> i64
    n: i64 @= 0
    at: i64 @= d.span.start

    while at >= 0 && at < d.span.end && at < text.len()
        b = text[at]

        if b != ' ' && b != '\n' && b != '\r' && (b < 128 || b >= 192)
            n @ n + 1
        at @ at + 1

    if n == 0
        return 1
    return n

# Whether the character `d` refuses is one `shown_char` writes by its code,
# a control character or an invisible one, which a reader cannot count by
# looking; asked of the character itself.
function unseen(d: diag.Diagnostic, text: str) -> bool
    if d.span.end > text.len()
        return false
    ch = text.slice(from: d.span.start, to: d.span.end)
    return shown_char.is_control(ch) || shown_char.unseen(shown_char.code_point(ch))

# The run a message is told by, counted on it where it is more than one.
function noted(out: [diag.Diagnostic], at: i64, run: i64) -> [diag.Diagnostic]
    if at < 0 || run < 2
        return out
    done: [diag.Diagnostic] @= out
    done[at].notes @ done[at].notes.push("the first of " + run.to_str() + " in a row")
    return done

## Tests

function refused(start: i64, said: str) -> diag.Diagnostic
    return diag.new_diagnostic(code: "unexpected_character", message: said + SAID, span: token_at(start))

function token_at(start: i64) -> token.Span
    return token.Span(start: start, end: start + 1)

test "a run of one refused character that cannot be seen is told once, at its first, the run counted"
    one = "the control character U+0001"
    two = "the control character U+0002"
    controls: [u8] = [1, 1, 1, 2, 32, 1]
    told = told_once(
        [refused(start: 0, said: one), refused(start: 1, said: one), refused(start: 2, said: one), refused(start: 3, said: two), refused(start: 5, said: one)],
        text: controls.validated_bytes().must()
    )
    got = told.diagnostics
    assert told.at == [0, -1, -1, 1, 2]
    assert got.len() == 3
    assert got[0].span.start == 0
    assert got[0].notes == ["the first of 3 in a row"]
    assert got[1].notes.len() == 0
    assert got[2].span.start == 5

test "a stretch counted rather than told stands for its characters, its spaces aside"
    text = "ключ слово `a b`"
    run = diag.new_diagnostic(
        code: "unexpected_character",
        message: "`ключ слово`" + SAID,
        span: token.Span(start: 0, end: 19)
    )
    assert characters(run, text: text) == 9

    # A span splitting a character is counted, never sliced.
    assert characters(refused(start: 0, said: "`к`"), text: text) == 1
    shown = "`` `a b` ``" + backtick_strings.BACKTICKS_SAID + " — a string is written in double quotes"
    template: diag.Diagnostic @= diag.new_diagnostic(
        code: "unexpected_character",
        message: shown,
        span: token.Span(start: 20, end: 25)
    )
    template.fixes @ template.fixes.push(
        diag.Fix(title: "write it as `\"a b\"`", replacement: "\"a b\"", span: template.span, certainty: .guess)
    )
    assert gathered(template)
    assert characters(template, text: text) == 4

    # A template over lines counts its characters, not its line ends.
    over = diag.new_diagnostic(code: "unexpected_character", message: "m", span: token.Span(start: 0, end: 6))
    assert characters(over, text: "`a\r\nb`\n") == 4

test "past eight refused characters the rest are counted on the last told, and a refusal with a fix is never gathered"
    said: [diag.Diagnostic] @= []

    for k in range(from: 0, to: 12)
        said @ said.push(refused(start: k * 2, said: "`$`"))

    fixed: diag.Diagnostic @= refused(start: 40, said: "`;`")
    fixed.fixes @ fixed.fixes.push(
        diag.Fix(title: "delete the `;`", replacement: "", span: token_at(40), certainty: .certain)
    )
    said @ said.push(fixed)
    told = told_once(said, text: "$ ".repeat(21))
    got = told.diagnostics
    assert told.at[12] == 8
    assert told.at[9] == -1
    assert got.len() == 9
    assert got[7].notes == ["4 more characters of this file are not part of the language's syntax either, not told one by one"]
    assert got[8].fixes.len() == 1
    habit = diag.new_diagnostic(
        code: "unexpected_character",
        message: "`/*` is not part of the language's syntax — a comment begins with `#`",
        span: token_at(0)
    )
    assert told_once([habit], text: "/* x").diagnostics.len() == 1
    assert !gathered(habit)

    # A message another reader tells is left out, and the places compose.
    left = without([refused(start: 0, said: "`$`"), refused(start: 2, said: "`$`")], dropped: [true, false])
    assert left.at == [-1, 0]
    assert through(first: [-1, 0, 1], then: [5, 6]) == [-1, 5, 6]

    # Two `;` side by side are seen, and each keeps its message (panel 187).
    semis = told_once([refused(start: 0, said: "`;`"), refused(start: 1, said: "`;`")], text: ";;")
    assert semis.diagnostics.len() == 2

# Defect 494: a run of tabs, of carriage returns or of one foreign word is
# told once, each kind on its own count, and a tab between two control
# characters ends neither's run.
test "tabs, carriage returns and foreign words are told once a run, each kind on its own count"
    tab = "a tab is a compile error — use spaces"
    told: [diag.Diagnostic] @= []

    for k in range(from: 0, to: 3)
        told @ told.push(diag.new_diagnostic(code: "tab_in_line", message: tab, span: token_at(k)))

    got = told_once(told, text: "\t\t\t").diagnostics
    assert got.len() == 1
    assert got[0].notes == ["the first of 3 in a row"]

    # A word's run goes through the spaces between, and ends at another word.
    said = "`fn` is not a word in this language, and a name cannot be one: choose another name"
    words: [diag.Diagnostic] @= []

    for k in [0, 3, 7, 12]
        words @ words.push(
            diag.new_diagnostic(code: "reserved_word", message: said, span: token.Span(start: k, end: k + 2))
        )

    run = told_once(words, text: "fn fn  fn x fn")
    assert run.diagnostics.len() == 2
    assert run.diagnostics[0].notes == ["the first of 3 in a row"]
    assert run.at == [0, -1, -1, 1]

    # Twelve carriage returns apart: eight told and four counted, in their own
    # words; the control characters around a tab keep their run.
    returns: [diag.Diagnostic] @= []
    cr = "a carriage return that is not part of a line ending — delete it, or end the line"

    for k in range(from: 0, to: 12)
        returns @ returns.push(diag.new_diagnostic(code: "stray_carriage_return", message: cr, span: token_at(k * 2)))

    counted = told_once(returns, text: "\r ".repeat(12)).diagnostics
    assert counted.len() == 8
    assert counted[7].notes == ["4 more carriage returns of this file stand outside a line ending too, not told one by one"]
    one = "the control character U+0001"
    around: [u8] = [1, 1, 32, 32, 32, 9]
    mixed = told_once(
        [refused(start: 0, said: one), diag.new_diagnostic(code: "tab_in_line", message: tab, span: token_at(5)), refused(start: 1, said: one)],
        text: around.validated_bytes().must()
    )
    assert mixed.diagnostics.len() == 2
    assert mixed.diagnostics[0].notes == ["the first of 2 in a row"]
