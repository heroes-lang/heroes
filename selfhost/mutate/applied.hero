# What `check --apply` printed of a mutant, judged twice: as `replay.py`
# judged it, and as the instrument judged it before the reboot of
# 2026-10-05 (panel 187's R2, defect 210).
#
# **R2 names any APPLY flag a finding, and the replay the gate has run
# since that reboot computes one of four.** `judge.py`'s `flags_of` made
# APPLY-NEW (a code the mutant was never told stands in what `--apply`
# wrote), APPLY-SAME (a message of the mutant's stands there, at its line,
# or anywhere where the fix moved lines), APPLY-SAME-OWN (a message whose
# own certain fix was applied stands at its line) and APPLY-OTHER (what
# `--apply` wrote checks clean and is neither the program nor the program
# laid out another way, `fmt` comparing the two: a certain fix that compiles
# and means something else, defect 172's class, `blocking`). `replay.py`,
# rebuilt from batch 10's results, kept the second alone and widened it:
# APPLY-SAME wherever a code of the mutant's stands, whatever moved. Its
# `flags` are written as it wrote them, so the two instruments' records
# stay comparable; `judge.py`'s four are written beside them, as
# `apply_flags`, and a reading treats a move of either as a finding.

use mutate/child
use mutate/hunks
use mutate/json_fields
use mutate/json_read
use mutate/judged
use mutate/own

# What the two judgements found.
record Printed
    # `replay.py`'s `changed`, and the codes it found standing.
    changed: bool
    stands: [str]
    # `judge.py`'s flags, in its order.
    flags: [str]

# The unmutated program's own messages in the normal arm, from the run's
# `corpus.jsonl` (`mutate/own.hero`), and the name they were told under;
# the mutant's hunks, which carry their lines, and the mutant's own name.
record Program
    diags: [json_read.Json]
    used: str
    applied: hunks.Applied
    mutant_rel: str

# `answer` is `check --apply` on the mutant `text`, of the program
# `original`; `normal` is the mutant's normal arm. What `--apply` printed
# is planted under `applied_rel`, and the program, where `fmt` must compare
# the two, under `original_rel`.
function judged_apply(at: judged.Place, applied_rel: str, original_rel: str, text: str, original: str, normal: judged.Arm, program: Program, answer: child.Answer) -> Printed?
    printed = answer.out
    none: [str] = []
    changed = answer.exit == 0 && printed != text && printed != ""

    # `judge.py`'s `same_text`: `--apply` prints a final newline, so a text
    # with none that comes back with one is the same text.
    same = printed == text || !hunks.ends_newline(text) && printed == text + "\n"
    moved = answer.exit == 0 && !same

    if !changed && !moved
        return ok(Printed(changed: false, stands: none, flags: none))
    judged.plant(at, rel: applied_rel, text: printed)?
    told = judged.checked(at, rel: applied_rel, permissive: false)?
    delta = newlines(printed) - newlines(text)

    # The program's own messages leave both arms before a code is called
    # standing or new (defect 663): `--apply` repairs a mutant stopped at the
    # parser, and what it writes reaches the checks that tell the unmutated
    # program what it always carried, which the mutant was never told.
    after = less_own(told, used: applied_rel, program: program, delta: delta)
    own_normal = less_own(normal, used: program.mutant_rel, program: program, delta: 0)
    mine = judged.codes_of(own_normal)
    theirs = judged.codes_of(after)
    stands: {str: bool} @= {}
    fresh: {str: bool} @= {}

    # ORDER: none observed; each code only joins a set.
    for code in keys(theirs)
        if !mine[code].is_err()
            stands[code] @ true
        else
            fresh[code] @ true

    flags: [str] @= []

    if moved
        if fresh.len() > 0
            flags @ flags.push("APPLY-NEW")
        after_places = places(after)
        exact = shared_place(a: places(own_normal), b: after_places)

        if exact || delta != 0 && stands.len() > 0
            flags @ flags.push("APPLY-SAME")

            if shared_place(a: normal.certain, b: after_places)
                flags @ flags.push("APPLY-SAME-OWN")
        clean = told.exit == 0 && told.messages.len() == 0

        if clean && printed != original && another_program(at, applied_rel: applied_rel, original_rel: original_rel, original: original)?
            flags @ flags.push("APPLY-OTHER")
    judged.uproot(at, rel: applied_rel)?
    found: [str] @= none

    if changed
        # ORDER: codes ascending by bytes, Python's `sorted` over ASCII codes.
        found @ sort(keys(stands))
    return ok(Printed(changed: changed, stands: found, flags: flags))

# Whether the program `--apply` wrote, planted under `applied_rel`, is
# another program than `original`: `fmt` prints the two otherwise. Where
# `fmt` refuses either, nothing is known and nothing is said (`judge.py`'s
# `same_program` answered `None`, which flags nothing).
function another_program(at: judged.Place, applied_rel: str, original_rel: str, original: str) -> bool?
    judged.plant(at, rel: original_rel, text: original)?
    a = child.bounded(program: at.compiler, words: [at.compiler, "fmt", at.mirror + "/" + applied_rel], capture: at.capture)?
    b = child.bounded(program: at.compiler, words: [at.compiler, "fmt", at.mirror + "/" + original_rel], capture: at.capture)?
    judged.uproot(at, rel: original_rel)?

    if a.exit != 0 || b.exit != 0
        return ok(false)
    return ok(a.out != b.out)

# `<code>\t<line>` of every message of an arm.
function places(arm: judged.Arm) -> [str]
    out: [str] @= []

    for m in arm.messages
        out @ out.push(judged.code_of(m) + "\t" + judged.line_of(m).to_str())

    return out

function shared_place(a: [str], b: [str]) -> bool
    for x in a
        for y in b
            if x == y
                return true

    return false

function newlines(text: str) -> i64
    n: i64 @= 0
    at: i64 @= 0

    while at < text.len()
        if text[at] == 10
            n @ n + 1
        at @ at + 1

    return n

# `arm`, told under `used`, less the program's own messages, each taken
# out once where `mutate/own.hero`'s key agrees: its code, its words, and
# its line carried through the mutant's hunks and then, where the fix
# moved lines (`delta`), anywhere between there and `delta` further, since
# which side of the fix it stood on is not known. A message off that range
# stays the arm's, the loud direction.
function less_own(arm: judged.Arm, used: str, program: Program, delta: i64) -> judged.Arm
    taken: {i64: bool} @= {}
    kept: [judged.Message] @= []

    for m in arm.messages
        d = judged.message_json(m)
        line = judged.line_of(m)
        theirs: i64 @= -1

        for index in range(from: 0, to: program.diags.len())
            t = program.diags[index]
            was = hunks.mapped(program.applied, line: json_fields.whole_field(t, name: "line").default(-1))
            free = taken[index].is_err()

            if theirs < 0 && free && within(line: line, a: was, b: was + delta) && own.key(d, used: used, line: line) == own.key(t, used: program.used, line: line)
                theirs @ index

        if theirs < 0
            kept @ kept.push(m)
        else
            taken[theirs] @ true

    return judged.Arm(exit: arm.exit, messages: kept, other: arm.other, certain: arm.certain)

function within(line: i64, a: i64, b: i64) -> bool
    return a <= line && line <= b || b <= line && line <= a

## Tests

# A corpus record of `examples/ledger/db/sqlite.hero`, told `never_rebound`
# at line 322 under `zzb_3.hero`, and a mutant of it at line 140 with
# `lines` lines above it, as `planted.single` builds the two.
function sqlite_program(lines: [str]) -> Program
    row = "{\"file\": \"examples/ledger/db/sqlite.hero\", \"path_used\": \"examples/ledger/db/zzb_3.hero\", \"normal\": {\"exit\": 1, \"diags\": [{\"file\": \"examples/ledger/db/zzb_3.hero\", \"line\": 322, \"col\": 5, \"kind\": \"error\", \"code\": \"never_rebound\", \"msg\": \"`rows` in zzb_3.hero is never rebound\"}], \"other\": []}}\n"
    corpus: {str: json_read.Json} @= {}
    corpus["examples/ledger/db/sqlite.hero"] @ json_read.read_lines(row).must()[0]
    original: [str] @= []

    for _ in range(from: 0, to: 330)
        original @ original.push("x")

    applied = hunks.apply(
        original,
        sets: [hunks.Tagged(tag: "a", hunks: [hunks.Hunk(start: 139, end: 140, lines: lines, site: [139])])]
    ).must()
    return Program(
        diags: own.program_diags(corpus, file: "examples/ledger/db/sqlite.hero", arm: "normal"),
        used: own.program_used(corpus, file: "examples/ledger/db/sqlite.hero"),
        applied: applied,
        mutant_rel: "examples/ledger/db/zzm_k.hero"
    )

function said(code: str, line: i64, msg: str) -> judged.Message
    return judged.Message(
        file: .null_value,
        line: json_fields.whole(line),
        col: .null_value,
        code: .text(v: code),
        msg: .text(v: msg)
    )

function arm_of(messages: [judged.Message]) -> judged.Arm
    return judged.Arm(exit: 1, messages: messages, other: [], certain: [])

test "the program's own code leaves what --apply wrote, and a code of the fix's stays (defect 663)"
    program = sqlite_program(["union = 1"])
    carried = said(code: "never_rebound", line: 322, msg: "`rows` in zzm_k_applied.hero is never rebound")
    mine = said(code: "type_mismatch", line: 140, msg: "m")
    after = less_own(arm_of([carried, mine]), used: "examples/ledger/db/zzm_k_applied.hero", program: program, delta: 0)
    assert keys(judged.codes_of(after)) == ["type_mismatch"]

    # Told twice, it is taken out once; at another line, it is the mutant's.
    twice = less_own(
        arm_of([carried, carried]),
        used: "examples/ledger/db/zzm_k_applied.hero",
        program: program,
        delta: 0
    )
    assert twice.messages.len() == 1
    elsewhere = said(code: "never_rebound", line: 200, msg: "`rows` in zzm_k_applied.hero is never rebound")
    assert less_own(arm_of([elsewhere]), used: "examples/ledger/db/zzm_k_applied.hero", program: program, delta: 0).messages.len() == 1

    # The mutant's normal arm, told under its own name, loses it the same way.
    normal = said(code: "never_rebound", line: 322, msg: "`rows` in zzm_k.hero is never rebound")
    assert less_own(arm_of([normal]), used: "examples/ledger/db/zzm_k.hero", program: program, delta: 0).messages.len() == 0

test "a code the program carries at a line the mutant or the fix moved is still the program's"
    # The mutant wrote two lines for one, so the program's 322 is the mutant's 323.
    two = sqlite_program(["union = 1", "y"])
    moved = said(code: "never_rebound", line: 323, msg: "`rows` in zzm_k_applied.hero is never rebound")
    assert less_own(arm_of([moved]), used: "examples/ledger/db/zzm_k_applied.hero", program: two, delta: 0).messages.len() == 0

    # The fix took a line out above it: 322 in the mutant, 321 in what it wrote.
    one = sqlite_program(["union = 1"])
    fixed = said(code: "never_rebound", line: 321, msg: "`rows` in zzm_k_applied.hero is never rebound")
    assert less_own(arm_of([fixed]), used: "examples/ledger/db/zzm_k_applied.hero", program: one, delta: -1).messages.len() == 0

    # Read with no move, the same message is kept, the loud direction.
    assert less_own(arm_of([fixed]), used: "examples/ledger/db/zzm_k_applied.hero", program: one, delta: 0).messages.len() == 1
    assert within(line: 3, a: 4, b: 2)
    assert !within(line: 5, a: 2, b: 4)

test "a place is a code and a line, and two lists share one or not"
    assert shared_place(a: ["c\t3", "d\t4"], b: ["d\t4"])
    assert !shared_place(a: ["c\t3"], b: ["c\t4"])
    assert newlines("a\nb\n") == 2
    assert newlines("") == 0
