# The eight integer widths and the two float widths, and what a width
# implies (spec § Types; design.md §4.3; panel 042, ratified 2026-08-12).
# Port of crates/heroes/src/types/{widths,floats}.rs — the width halves
# only; the float payload rules stay with the checker port.
#
# **This variant exists so that a width cannot be forgotten**, measured on
# the Rust side: eight unit variants left 18 silent sites, one of which
# dropped the overflow guard for `u8` at exit 0. With the width inside one
# case, every site that dispatches on it is an exhaustive `match` and a new
# width is a compile error there (CLAUDE.md §11's loud-fallback rule).
#
# One array enumerates the widths, so the resolver's name table, the
# prelude and the did-you-mean list cannot disagree about what exists.
#
# The range tables landed when their consumer did (the checker's
# number-literal check): sign and u64 magnitude, tabulated per width
# rather than computed, because `<<` is i64-only in this language and a
# table a test pins cannot silently disagree with a shift.

## The integer widths

variant IntKind
    i8
    i16
    i32
    i64
    u8
    u16
    u32
    u64

# Every width, in declaration order, for the places that must enumerate them.
function int_kinds() -> [IntKind]
    return [.i8, .i16, .i32, .i64, .u8, .u16, .u32, .u64]

# The surface spelling, which is also what a diagnostic prints. There is no
# `int` (panel 042): one spelling per width, and `int` is a foreign word
# with a certain fix to `i64`.
function int_name(kind: IntKind) -> str
    return match kind
        .i8 => "i8"
        .i16 => "i16"
        .i32 => "i32"
        .i64 => "i64"
        .u8 => "u8"
        .u16 => "u16"
        .u32 => "u32"
        .u64 => "u64"

# How many bits, and whether the top one is a sign. Together they are the
# whole of what a width IS, and every question below is derived from them
# rather than tabulated again — a table per question is a table per chance
# to disagree.
function int_bits(kind: IntKind) -> i64
    return match kind
        .i8 | .u8 => 8
        .i16 | .u16 => 16
        .i32 | .u32 => 32
        .i64 | .u64 => 64

function int_signed(kind: IntKind) -> bool
    return match kind
        .i8 | .i16 | .i32 | .i64 => true
        .u8 | .u16 | .u32 | .u64 => false

# `an i64`, `a u8`. The article follows how the name is SAID — the signed
# ones begin with a vowel sound — and it is derived from `int_signed` rather
# than tabulated, so a ninth width gets it right without a second edit.
function int_article_name(kind: IntKind) -> str
    if int_signed(kind)
        return "an `" + int_name(kind) + "`"
    return "a `" + int_name(kind) + "`"

# Whether EVERY value of `source` is a value of `target` — i.e. whether a
# conversion from `source` into `target` can fail.
#
# The four cases are not symmetric and the asymmetry is the point: an
# unsigned source needs a STRICTLY wider signed target, because the target
# spends a bit on a sign it will never use; and a signed source never fits
# an unsigned target at all, however wide, because -1 is a value.
function int_contains(target: IntKind, source: IntKind) -> bool
    if int_signed(target) == int_signed(source)
        return int_bits(target) >= int_bits(source)
    if int_signed(target)
        return int_bits(target) > int_bits(source)
    return false

# The C type the emitter writes. Fixed-width by name, so the generated C
# says what the Heroes source says and clang checks the rest.
function int_c_type(kind: IntKind) -> str
    return match kind
        .i8 => "int8_t"
        .i16 => "int16_t"
        .i32 => "int32_t"
        .i64 => "int64_t"
        .u8 => "uint8_t"
        .u16 => "uint16_t"
        .u32 => "uint32_t"
        .u64 => "uint64_t"

# The largest magnitude a POSITIVE literal of this width may have.
function int_max_magnitude(kind: IntKind) -> u64
    return match kind
        .i8 => 127
        .i16 => 32767
        .i32 => 2147483647
        .i64 => 9223372036854775807
        .u8 => 255
        .u16 => 65535
        .u32 => 4294967295
        .u64 => 18446744073709551615

# The largest magnitude a NEGATIVE literal of this width may have — one
# more than the positive side for the signed widths (two's complement),
# zero for the unsigned ones, where only `-0` is writable.
function int_min_magnitude(kind: IntKind) -> u64
    return match kind
        .i8 => 128
        .i16 => 32768
        .i32 => 2147483648
        .i64 => 9223372036854775808
        .u8 | .u16 | .u32 | .u64 => 0

# Whether a literal of this sign and magnitude fits the width — the port
# of range(), asked the way the checker asks it: the sign travels with
# the digits, so `-128` fits an `i8` that `128` alone does not.
function int_fits(kind: IntKind, negative: bool, magnitude: u64) -> bool
    if negative
        return magnitude <= int_min_magnitude(kind)
    return magnitude <= int_max_magnitude(kind)

# The bounds as a reader is told them: `-128` or `0`, and the top.
function int_low_text(kind: IntKind) -> str
    if int_signed(kind)
        return "-" + int_min_magnitude(kind).to_str()
    return "0"

function int_high_text(kind: IntKind) -> str
    return int_max_magnitude(kind).to_str()

## The float widths

variant FloatKind
    f32
    f64

function float_kinds() -> [FloatKind]
    return [.f32, .f64]

function float_name(kind: FloatKind) -> str
    return match kind
        .f32 => "f32"
        .f64 => "f64"

function float_bits(kind: FloatKind) -> i64
    return match kind
        .f32 => 32
        .f64 => 64

function float_c_type(kind: FloatKind) -> str
    return match kind
        .f32 => "float"
        .f64 => "double"

## Tests

test "one array lists the widths and the names round-trip"
    kinds = int_kinds()
    assert kinds.len() == 8
    names: [str] @ []
    for k in kinds
        names @ names.push(int_name(k))
    assert names.join(" ") == "i8 i16 i32 i64 u8 u16 u32 u64"
    assert float_kinds().len() == 2

test "containment is asymmetric on purpose"
    # Same signedness: width decides.
    assert int_contains(target: .i64, source: .i32)
    assert !int_contains(target: .i16, source: .i32)
    # Unsigned into signed: strictly wider, the sign bit is spent.
    assert int_contains(target: .i64, source: .u32)
    assert !int_contains(target: .i16, source: .u16)
    # Signed into unsigned: never, -1 is a value.
    assert !int_contains(target: .u64, source: .i8)

test "the range tables hold at the corners the widths exist for"
    assert int_fits(.i8, negative: true, magnitude: 128)
    assert !int_fits(.i8, negative: false, magnitude: 128)
    assert int_fits(.i8, negative: false, magnitude: 127)
    assert int_fits(.u8, negative: false, magnitude: 255)
    assert !int_fits(.u8, negative: false, magnitude: 256)
    assert !int_fits(.u8, negative: true, magnitude: 1)
    assert int_fits(.u8, negative: true, magnitude: 0)
    assert int_fits(.u64, negative: false, magnitude: 18446744073709551615)
    assert !int_fits(.i64, negative: false, magnitude: 9223372036854775808)
    assert int_fits(.i64, negative: true, magnitude: 9223372036854775808)
    assert int_low_text(.i16) == "-32768"
    assert int_high_text(.i16) == "32767"
    assert int_low_text(.u32) == "0"

test "what a width tells the reader and what it tells clang"
    assert int_bits(.u16) == 16
    assert !int_signed(.u64)
    assert int_article_name(.i64) == "an `i64`"
    assert int_article_name(.u8) == "a `u8`"
    assert int_c_type(.u32) == "uint32_t"
    assert float_c_type(.f64) == "double"
    assert float_bits(.f32) == 32
