# What the bytes of a file that is not UTF-8 prove about how it was written,
# and nothing they do not (panel 189's R4, defect 227): the note under the
# first `not_text` of such a file (`not_text.told`), and the encoding of a file
# in UTF-16 with no mark over ASCII, which is UTF-8 (`file_start`, defect 247).
# A UTF-16 byte-order mark, NUL at every other byte, a UTF-8 character cut
# short or one UTF-8 forbids are proof, and each is named; a byte that begins
# no UTF-8 character names no encoding, since one byte is a different letter
# in each: `82` is `é` in the OEM code page 437 `cmd` writes and `‚` in
# Windows-1252 (the ffi-pragmatist's measurement), and a note naming either
# was false for the other.
#
# Its own module, out of `not_text.hero`, for the ceiling and along a seam:
# what a byte proves is asked of the bytes alone, where `not_text` places and
# counts the diagnostics.

use source
use shown_char

# A byte as the reader searches for it: `0xE9`.
function shown(byte: i64) -> str
    digits = "0123456789ABCDEF"
    return "0x" + digits.slice(from: byte / 16, to: byte / 16 + 1) + digits.slice(from: byte % 16, to: byte % 16 + 1)

# What the bytes prove, and what to do: a byte-order mark of UTF-16 first,
# then NUL at every other byte, UTF-16 with no mark, then NUL elsewhere, then
# a UTF-8 character written wrong; and where none of those, a byte of another
# encoding, the encoding unnamed, in a file with no character of UTF-8 above
# ASCII, saved whole in it, or in one that has some, where such bytes came in.
function reading(text: str, mine: [source.Fault], start: i64) -> str
    first = mine[0]

    if mine.len() >= 2 && first.at == start && mine[1].at == start + 3 && first.byte + mine[1].byte == 509 && first.byte >= 254
        return "the file opens with " + shown(first.byte) + " " + shown(mine[1].byte) + ", the byte-order mark of UTF-16, so it was saved as UTF-16: save it as UTF-8"
    order = utf16_order(text)

    if order.len() > 0
        return utf16_said(order)

    if holds_nul(text)
        return "the file also holds NUL bytes, which no source text holds: it is likely not a text file at all"
    shaped = sequence(text: text, mine: mine, start: start)

    if shaped.len() > 0
        return shaped
    other = shown(first.byte) + " here belongs to an encoding other than UTF-8, which one the bytes do not say"

    if only_replacements(text)
        return other + ", and no character of this file is UTF-8 above ASCII: save the file as UTF-8"
    return other + ", and the rest of this file is UTF-8: write in UTF-8 the character each such byte stands for, or delete it"

# What NUL at every other byte proves, said the same for a file that is not
# UTF-8 (`reading`) and for one that is, ASCII in UTF-16 with no mark
# (defect 247).
function utf16_said(order: str) -> str
    return "every other byte of the file is NUL, which is how UTF-16 " + order + " writes ASCII and Latin-1, so it was saved as UTF-16 with no byte-order mark: save it as UTF-8"

# The order of UTF-16 a text's bytes show where every other one is NUL: a
# character then NUL is little-endian, NUL then a character big-endian, as
# UTF-16 writes every character below U+0100; "" where they do not alternate
# so through the whole text, or there are fewer than two pairs to say it.
# Asked of characters, so a U+FFFD the shown text holds for one byte of the
# file counts as that byte.
function utf16_order(text: str) -> str
    nul_first: i64 @ 0
    nul_second: i64 @ 0
    at: i64 @ 0

    while at < text.len()
        then = at + character_length(text[at])

        if then >= text.len() || text[at] == 0 == (text[then] == 0)
            return ""

        if text[at] == 0
            nul_first @ nul_first + 1
        else
            nul_second @ nul_second + 1
        at @ then + character_length(text[then])

    if nul_first >= 2 && nul_second == 0
        return "big-endian"

    if nul_second >= 2 && nul_first == 0
        return "little-endian"
    return ""

# The bytes of the UTF-8 character `lead` begins: a `str` is well-formed, so a
# lead byte's shape says it (spec § 3).
function character_length(lead: u8) -> i64
    if lead < 192
        return 1

    if lead < 224
        return 2

    if lead < 240
        return 3
    return 4

# What the first such byte reads as where it leads a sequence of UTF-8's
# shape: whole and forbidden, or cut short by a byte that does not continue it
# or by the file's end; "" where no byte continues it and the file goes on,
# which a one-byte encoding writing one letter alone does far more often.
function sequence(text: str, mine: [source.Fault], start: i64) -> str
    lead = mine[0].byte
    need: i64 @ 4

    if lead < 192 || lead > 247
        return ""

    if lead < 224
        need @ 2
    else if lead < 240
        need @ 3
    given: i64 @ 1

    while given < need && given < mine.len() && mine[given].at == mine[0].at + 3 * given && mine[given].byte < 192
        given @ given + 1

    words: [str] @ []

    for k in range(from: 0, to: given)
        words @ words.push(shown(mine[k].byte))

    run = words.join(" ")

    if given == need
        return run + " have the shape of a UTF-8 character and encode " + forbidden(mine, need: need) + ", which UTF-8 forbids: write in UTF-8 the character meant"

    if given > 1
        return run + " begin a UTF-8 character of " + need.to_str() + " bytes and stop after " + given.to_str() + ", so the text was cut short: write the character whole"

    if mine[0].at + 3 == start + text.len()
        return run + " begins a UTF-8 character of " + need.to_str() + " bytes and the file ends after it, so it was cut short: write the character whole"
    return ""

# What a whole sequence of UTF-8's shape encodes that UTF-8 forbids, read
# from its bytes as UTF-8 reads them: a UTF-16 surrogate, a value past
# U+10FFFF, or an overlong form of a smaller one, the three ways the
# runtime's judge refuses a whole sequence (`hero_utf8_sequence`).
function forbidden(mine: [source.Fault], need: i64) -> str
    value: i64 @ mine[0].byte - 192

    if need == 3
        value @ mine[0].byte - 224
    else if need == 4
        value @ mine[0].byte - 240

    for k in range(from: 1, to: need)
        value @ value * 64 + mine[k].byte - 128

    if value >= 55296 && value <= 57343
        return "the UTF-16 surrogate " + shown_char.u_plus(value)

    if value > 1114111
        return shown_char.u_plus(value) + ", past U+10FFFF"
    return "an overlong form of " + shown_char.u_plus(value)

# Whether every character of the text above ASCII is a U+FFFD, as every byte
# that is not text is here: then no character of the file is UTF-8 above ASCII
# (a U+FFFD the file held is counted with them, so the rare file holding both
# is read as a one-byte encoding's). Asked of the text, which is whole, and not
# of the faults, which are bounded (`faults_of`).
function only_replacements(text: str) -> bool
    at: i64 @ 0

    while at < text.len()
        if text[at] < 128
            at @ at + 1
        else if at + 2 < text.len() && text[at] == 239 && text[at + 1] == 191 && text[at + 2] == 189
            at @ at + 3
        else
            return false

    return true

function holds_nul(text: str) -> bool
    at: i64 @ 0

    while at < text.len()
        if text[at] == 0
            return true
        at @ at + 1

    return false
