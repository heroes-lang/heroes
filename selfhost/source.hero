# Source text and byte-offset spans: every file of one compilation in ONE
# text (design.md §1.11, §4.1, §4.17; panels 031, 032).
# Port of archive/bootstrap-rs/heroes/src/source/{mod,files,locate,build}.rs — four files,
# 511 lines; one module here NOT because of a cycle but because the record
# and its questions are one concern.
#
# **What a path and a module NAME stand for left this file at
# M-package-layout** and is `module_names.hero`. It was here while it was
# three short answers about a stem; panel 099 R3 gave two of them rules (the
# C component is the whole path, the qualifier is the last part), this file
# measured 302 code lines against §11's 300, and the seam the check named is
# the honest one — nothing in that vocabulary knows what a `Source` is.
#
# **Why one text rather than a file id in every Span** (panel 031 R7,
# measured rather than preferred): concatenation changed none of the Rust
# compiler's 39 Span construction sites; a file id would have changed all 39.
# Everything downstream points into the text with byte offsets — indices,
# never references — so tokens and diagnostics stay plain values.
#
# **The root file is `files[0]`, and every offset the author can see is what
# it would have been if their file were alone.** Files are appended in load
# order, never sorted, and nothing is ever prepended. Nor is anything added
# inside a file: each file's own bytes are exactly what its author wrote
# (`from_files`, defect 141).
#
# The library (§1.11 Tier 2) is an ordinary module in every respect but one:
# a diagnostic pointing into it is a compiler bug, not a user error, and
# nothing that hands a program back may print it.

use token
use char_column
use module/names as module_names

## The two tables

# One file inside a Source. `module` is the RAW stem, `_` and all, because
# that is what the author typed and what a `use` line spells; `component` is
# the same module as a C identifier — two namespaces, and they are not the
# same namespace (panel 032: module `print` + name `inst_value_name` and
# module `print_inst` + name `value_name` are one linker symbol unless the
# component is sanitised).
record FileEntry
    name: str
    module: str
    component: str
    start: i64
    # How many lines of the concatenated text come before this file, so that
    # line_in_file = line_in_source - lines_before.
    lines_before: i64
    is_library: bool

# One file on its way into a Source: what a caller holds before any offset
# exists. `module` is separate from `name` because a `use`d module's name is
# declared, not derived — `stem_of` is only the default for a root file.
record InputFile
    name: str
    module: str
    text: str
    is_library: bool

record Source
    # The root file's name — what `--dump-<stage>` heads its output with.
    name: str
    # Every file, joined by one blank line each.
    text: str
    # Byte offset of the first byte of each line; line_starts[0] == 0.
    line_starts: [i64]
    # In load order, never empty, files[0] the root. Sorted by `start` by
    # construction, which is what lets `file_of` binary-search it.
    files: [FileEntry]
    # Every byte of a file that is not UTF-8, where its U+FFFD stands in
    # `text`, ascending; empty for a compilation of text (panel 189). Set by
    # the read (`module/reading.hero`) and told by `not_text.hero`; a file
    # holding one is never lexed (`lexer.lex_files`).
    faults: [Fault]
    # The offset of every byte of `text` continuing a character, ascending:
    # a column without a walk of its line (`char_column.at`, defect 372).
    continuations: [i64]

# A byte that is not part of a well-formed UTF-8 sequence: where the U+FFFD
# that stands for it begins, and its value (panel 189, defect 227).
record Fault
    at: i64
    byte: i64

# The module component the library's own functions get, whatever is being
# compiled: `range` is `h_library_range` in every program (panel 028 R3b —
# one definition, many prototypes, so the definition's name cannot vary).
constant LIBRARY_MODULE: str
    "library"

# What the library calls itself in a diagnostic and in a `#line`. Not a
# path, and deliberately unopenable: a clang error against one of its lines
# must not look like an error in a file the author can edit.
constant LIBRARY_FILE: str
    "<heroes library>"

## Building — everything here runs once, before any offset exists

# An ordinary Heroes file, its module taken from its path — the RAW stem.
function user_file(name: str, text: str) -> InputFile
    return InputFile(name: name, module: module_names.stem_of(name), text: text, is_library: false)

# One file on its own, with nothing else attached.
function new_source(name: str, text: str) -> Source
    inputs: [InputFile] = [user_file(name: name, text: text)]
    return from_files(inputs)

# The user's program with the library appended (§1.11).
function with_library(name: str, user: str, library: str) -> Source
    inputs: [InputFile] = [
        user_file(name: name, text: user)
        InputFile(name: LIBRARY_FILE, module: LIBRARY_MODULE, text: library, is_library: true)
    ]
    return from_files(inputs)

# The general constructor: N files, concatenated in the order given.
#
# **One newline joins each pair, and it belongs to neither file.** It is
# load-bearing twice: two declarations butted together would be one line to
# the parser, and the boundary offset has to fall on a line start for the
# file table to agree with the line numbering. After a file whose last line
# ends, it makes a blank line; after one whose last line is open, it ends
# that line. Either way it stands outside both files, so a file's own text
# (`source_extent.text_of`) is exactly its author's bytes, and the lexer
# reads a file in a compilation as it reads the file alone.
#
# **Until defect 141 an open last line was first closed with a newline of
# this function's own**, inside the file's text. The root then held a byte
# its author never typed: `check --apply` wrote it into the file (22 bytes
# came out 29 where the one certain fix makes 28), a CRLF file got a bare
# `\n`, and a stray `\r` ending a file became a line ending the lexer
# accepts, so `check` passed a file that `fmt`, which reads the root alone,
# refused at that `\r`. The same closer once read the last byte of a file of
# none (defect 109).
function from_files(inputs: [InputFile]) -> Source
    assert inputs.len() > 0
    name = inputs[0].name
    table: [FileEntry] @ []

    # `lines_before` is the newline count of the accumulated text, kept
    # incrementally: the first shape of this line re-ran starts_of over
    # the WHOLE concatenation once per file, which read every byte of an
    # N-file compilation ~N/2 times and grew the starts array by push
    # inside each pass — measured as most of the compiler's load time
    # (docs/measurements/012). Counting only what each step appends is
    # the same number read once.
    newlines: i64 @ 0

    # The pieces are joined once (defect 105: `text @ text + input.text`
    # copied the compilation so far at every file).
    pieces: [str] @ []
    size: i64 @ 0

    for input in inputs
        if table.len() > 0
            pieces @ pieces.push("\n")
            size @ size + 1
            newlines @ newlines + 1
        entry = FileEntry(
            name: input.name,
            module: input.module,
            component: module_names.component_of(input.module),
            start: size,
            lines_before: newlines,
            is_library: input.is_library
        )
        table @ table.push(entry)
        pieces @ pieces.push(input.text)
        size @ size + input.text.len()
        newlines @ newlines + newlines_in(input.text)

    whole = pieces.join("")
    none: [Fault] = []
    starts = starts_of(whole)
    more = char_column.continuations_of(whole)
    return Source(name: name, text: whole, line_starts: starts, files: table, faults: none, continuations: more)

# The '\n' count of one segment — what `starts_of(text).len() - 1` answers
# for a whole text, without building the array.
function newlines_in(text: str) -> i64
    count: i64 @ 0
    i: i64 @ 0

    while i < text.len()
        if text[i] == '\n'
            count @ count + 1
        i @ i + 1

    return count

# Byte offset of the first byte of each line. starts[0] == 0, and the length
# is the number of lines, which is what makes it double as a line count.
function starts_of(text: str) -> [i64]
    starts: [i64] @ [0]
    i: i64 @ 0

    while i < text.len()
        if text[i] == '\n'
            starts @ starts.push(i + 1)
        i @ i + 1

    return starts

## Which file — the index that makes concatenation reversible

# The greatest index whose start is <= offset. Both tables this file owns
# are sorted by construction, which is what makes the binary search honest.
function floor_start(starts: [i64], offset: i64) -> i64
    lo: i64 @ 0
    hi: i64 @ starts.len() - 1

    while lo < hi
        mid = (lo + hi + 1) / 2

        if starts[mid] <= offset
            lo @ mid
        else
            hi @ mid - 1

    return lo

# `floor_start` over the files' starts, read in place rather than copied
# into an array at every call.
function file_of(s: Source, offset: i64) -> i64
    lo: i64 @ 0
    hi: i64 @ s.files.len() - 1

    while lo < hi
        mid = (lo + hi + 1) / 2

        if s.files[mid].start <= offset
            lo @ mid
        else
            hi @ mid - 1

    return lo

function file_at(s: Source, offset: i64) -> FileEntry
    return s.files[file_of(s, offset)]

# Is this offset in the library rather than in something the author wrote?
# Every caller is answering one of three questions: may a diagnostic point
# here (no — compiler bug), may a `#line` claim the author's file for it
# (no), and which module does the mangler put it in (`library`).
function is_library(s: Source, offset: i64) -> bool
    return file_at(s, offset).is_library

# Is this offset in the file the reader actually named? `--dump-<stage>` and
# `fmt` ask this; emission and `heroes test` are about the whole program and
# ask `is_library` instead — a module's `test` blocks are its own.
function is_root(s: Source, offset: i64) -> bool
    return file_of(s, offset) == 0

function component_at(s: Source, offset: i64) -> str
    return file_at(s, offset).component

function module_at(s: Source, offset: i64) -> str
    return file_at(s, offset).module

## Where in the file — every caret and every #line ends up here

record Position
    line: i64
    col: i64

# 1-based line and column in the whole text; **the column counts
# characters**, not bytes — the consumer is the reader, and for a caret a
# byte is not a column (the byte-counting version disagreed with its own
# caret by three columns on one tabbed line, 2026-08-12). `char_column` counts
# it, a CRLF line's end at its carriage return (defect 373).
function line_col(s: Source, offset: i64) -> Position
    line = floor_start(s.line_starts, offset)
    start = s.line_starts[line]
    col = char_column.at(s.text, continuations: s.continuations, start: start, offset: offset)
    return Position(line: line + 1, col: col)

# The 1-based line in the whole text — the printer's question. `locate`
# answers the reader's; nobody assembles the triple by hand. The line alone,
# from the table: counting the column's characters to throw them away cost
# `fmt` a tenth of its time (defect 105).
function line_of(s: Source, offset: i64) -> i64
    return floor_start(s.line_starts, offset) + 1

# The 1-based line WITHIN ITS OWN FILE, for a diagnostic or a `#line` that
# names that file rather than the root.
function file_line_of(s: Source, offset: i64) -> i64
    line: i64 @ line_of(s, offset) - file_at(s, offset).lines_before

    if line < 1
        line @ 1
    return line

# Where an offset is, AS A READER HAS TO BE TOLD IT: the file that contains
# it, the line within that file, and the column. One function, no caller
# assembles the triple itself — before M-module-namespace two renderers each
# did, and both were wrong the moment a program had two files.
record Location
    file: str
    line: i64
    col: i64

function locate(s: Source, offset: i64) -> Location
    p = line_col(s, offset)
    entry = file_at(s, offset)

    # `file_line_of`'s number, from the position and the entry in hand.
    line: i64 @ p.line - entry.lines_before

    if line < 1
        line @ 1
    return Location(file: entry.name, line: line, col: p.col)

# Where an offset is AS A `#line` NAMES IT: the file that holds it and the
# line within that file, with no column (defect 228, 2026-10-03). `locate`
# counts the column's characters from the line's start, and the emitter asked
# it once for every instruction it placed, so a line N bytes long cost about
# N squared over 2: 24 million characters walked for one 2,000-piece
# concatenation, 80 million for 1,000 nested loops, where every instruction
# walked its line's indentation. A `#line` carries no column, so this asks
# two sorted tables and walks no line.
record SourceLine
    file: str
    line: i64

function source_line(s: Source, offset: i64) -> SourceLine
    entry = file_at(s, offset)
    line: i64 @ line_of(s, offset) - entry.lines_before

    if line < 1
        line @ 1
    return SourceLine(file: entry.name, line: line)

# How to name THE OTHER END of a mistake, from where the caret is: `line 12`
# when both ends are in one file, `geom.hero:12` when they are not. Every
# "already declared at …" goes through here. The short form is deliberate:
# §4.17 asks the note to carry the file the model would otherwise open, and
# when that is the file already on screen, naming it is noise.
function elsewhere(s: Source, here: i64, there: i64) -> str
    at = locate(s, there)

    if file_of(s, here) == file_of(s, there)
        return "line " + at.line.to_str()
    return at.file + ":" + at.line.to_str()

function span_text(s: Source, span: token.Span) -> str
    return s.text.slice(from: span.start, to: span.end)

# Byte offset of the first byte of the line containing `offset`. The one
# caller is the caret, which pads with the line's own leading whitespace.
function line_start_of(s: Source, offset: i64) -> i64
    return s.line_starts[floor_start(s.line_starts, offset)]

## Tests

test "two files, one text, and the table makes it reversible"
    inputs: [InputFile] = [
        user_file(name: "main.hero", text: "constant A: i64\n    1\n")
        user_file(name: "geom.hero", text: "constant B: i64\n    2\n")
    ]
    s = from_files(inputs)

    # The joiner is one blank line: file 2 starts one past it, on a line start.
    assert s.files.len() == 2
    assert s.files[1].start == 23
    assert is_root(s, 0)
    assert !is_root(s, s.files[1].start)

    # Offsets on the boundary belong to the file that starts there.
    assert file_of(s, s.files[1].start) == 1
    assert file_of(s, s.files[1].start - 1) == 0

    # The second file's first line is ITS line 1, not the text's line 4.
    assert line_of(s, s.files[1].start) == 4
    assert file_line_of(s, s.files[1].start) == 1
    assert locate(s, s.files[1].start).file == "geom.hero"

test "elsewhere names the file only when it is not already on screen"
    inputs: [InputFile] = [
        user_file(name: "main.hero", text: "constant A: i64\n    1\n")
        user_file(name: "geom.hero", text: "constant B: i64\n    2\n")
    ]
    s = from_files(inputs)

    # Both ends in the root: the short form.
    assert elsewhere(s, here: 0, there: 16) == "line 2"

    # The other end in geom.hero: the long form, with GEOM's own line number.
    assert elsewhere(s, here: 0, there: s.files[1].start) == "geom.hero:1"

test "the library is appended and unopenable"
    s = with_library(name: "main.hero", user: "constant A: i64\n    1\n", library: "function range()\n    return\n")
    assert !is_library(s, 0)
    assert is_library(s, s.files[1].start)
    assert s.files[1].name == "<heroes library>"
    assert s.files[1].module == "library"

test "a file whose last line is open is joined as written: the joiner ends that line"
    inputs: [InputFile] = [
        user_file(name: "a.hero", text: "constant A: i64\n    1")
        user_file(name: "b.hero", text: "constant B: i64\n    2\n")
    ]
    s = from_files(inputs)

    # a.hero's 21 bytes and the joiner, nothing between them: b starts at 22,
    # on a line start, and is its own line 1 (defect 141).
    assert s.files[1].start == 22
    assert s.text.slice(from: 0, to: 22) == "constant A: i64\n    1\n"
    assert line_of(s, s.files[1].start) == 3
    assert file_line_of(s, s.files[1].start) == 1

test "lines_before is the newline count of everything before the file"
    inputs: [InputFile] = [
        user_file(name: "a.hero", text: "constant A: i64\n    1\n")
        user_file(name: "b.hero", text: "constant B: i64\n    2")
        user_file(name: "c.hero", text: "constant C: i64\n    3\n")
    ]
    s = from_files(inputs)
    assert s.files[0].lines_before == 0

    # a.hero's two lines, then the blank joiner line.
    assert s.files[1].lines_before == 3

    # b.hero's own newline, then the joiner, which ends its open last line.
    assert s.files[2].lines_before == 5

    # And the numbers agree with what locate answers through them.
    assert file_line_of(s, s.files[2].start) == 1

test "a first file with no byte in it ends no line, so the joiner alone follows it"
    # Defect 109: an empty program panicked here in every verb that reads one.
    s = with_library(name: "main.hero", user: "", library: "function range()\n    return\n")
    assert s.files.len() == 2
    assert s.files[1].start == 1
    assert s.files[1].lines_before == 1
    assert file_line_of(s, s.files[1].start) == 1
    assert is_root(s, 0)
    assert is_library(s, 1)
    assert s.text == "\nfunction range()\n    return\n"

test "an empty file between two others is joined like any other, whatever came before it"
    inputs: [InputFile] = [
        user_file(name: "a.hero", text: "constant A: i64\n    1")
        user_file(name: "b.hero", text: "")
        user_file(name: "c.hero", text: "constant C: i64\n    3\n")
    ]
    s = from_files(inputs)

    # a.hero's 21 bytes and the joiner: b starts at 22 and holds nothing, so
    # c follows one joiner later.
    assert s.files[1].start == 22
    assert s.files[2].start == 23
    assert s.files[2].lines_before == 3
    assert file_line_of(s, s.files[2].start) == 1
    assert locate(s, s.files[2].start).file == "c.hero"

test "files that are all empty are only their joiners, and a lone empty file is nothing"
    inputs: [InputFile] = [
        user_file(name: "a.hero", text: "")
        user_file(name: "b.hero", text: "")
        user_file(name: "c.hero", text: "")
    ]
    s = from_files(inputs)
    assert s.text == "\n\n"
    assert s.files[1].start == 1
    assert s.files[2].start == 2
    assert s.line_starts.len() == 3

    alone = new_source(name: "x.hero", text: "")
    assert alone.text == ""
    assert alone.line_starts.len() == 1
    assert line_col(alone, 0).line == 1
    assert line_col(alone, 0).col == 1

test "a `#line`'s place is locate's file and line, whatever the column, in every file"
    # Defect 228: `source_line` answers what `locate` answers but the column,
    # which it never walks for. Held to `locate` at every offset of three
    # files, a long line, a character above ASCII, and the joiners included.
    inputs: [InputFile] = [
        user_file(name: "a.hero", text: "x = 1\n" + repeat("y", 300) + " = \"é\"\n")
        user_file(name: "b.hero", text: "")
        user_file(name: "c.hero", text: "z = 2\n    w = 3")
    ]
    s = from_files(inputs)
    at: i64 @ 0

    while at < s.text.len()
        # `locate` slices to the offset, so it is asked only where a
        # character starts: never at a continuation byte, 0x80 to 0xBF.
        if s.text[at] < 128 || s.text[at] >= 192
            one = source_line(s, at)
            two = locate(s, at)
            assert one.file == two.file
            assert one.line == two.line
        at @ at + 1

test "the column counts characters, not bytes"
    # `è` is two bytes; the caret after it must say column 3, not 4.
    s = new_source(name: "x.hero", text: "è = 1\n")
    assert line_col(s, 3).col == 3
    assert line_col(s, 3).line == 1

    # Position arithmetic across lines still holds.
    t = new_source(name: "y.hero", text: "a\nbc\n")
    assert line_col(t, 2).line == 2
    assert line_col(t, 2).col == 1
    assert line_start_of(t, 3) == 2
