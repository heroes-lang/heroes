# ??? output: what the compiler already knows (design.md §4.16).
# Port of crates/heroes/src/types/holes.rs.
#
# A hole is NOT an error. The compiler reaches it, finds it has
# nothing to compute, and prints what it was about to need instead:
# the expected type, and what is in scope to build one from. §4.16's
# claim is that this costs nothing — the checker holds all of it for
# its ordinary work and normally throws it away. This file is the
# throwing-away, undone. Two normative rules: CAPPED AT 5 in
# deterministic order (unbounded "nearby functions" would flood a
# model's context and vary with layout), and a file with holes
# type-checks everything else — the report is OUTPUT, exit 0.

use ast
use source
use resolved
use check_table
use check_state
use check_render
use print_types
use parse
use resolve
use checker

# §4.16's cap, and the reason it exists: identical holes must give
# identical guidance, whatever the file's size.
constant SUGGESTIONS: i64
    5

# The report for every hole in the file, in source order.
function report(tree: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl]) -> str
    out: str @ ""
    none: [str] = []

    for hole in c.holes
        # locate, never line_col plus s.name: the hole report is not a
        # Diagnostic, which is how it survived a sweep still naming
        # the root file at concatenated lines (panel 033 D2).
        found = source.locate(s, hole.span.start)
        out @ out + "hole at " + found.file + ":" + found.line.to_str() + ":" + found.col.to_str() + "\n"
        is_error: bool @ false

        match check_table.get(c.types, hole.expected)
            .error                                                     => is_error @ true
            .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => is_error @ is_error
            .array | .fixed | .map | .fallible | .function_ty | .named => is_error @ is_error
            .case_ty | .failure | .generic                             => is_error @ is_error

        if is_error
            # A hole in statement position: nothing is expected of it,
            # and "expected `?`" would be worse than saying nothing.
            # What the model needs is what the FUNCTION owes.
            out @ out + "  position: statement — any type, or none\n"
            owner = owner_of(decls, at: hole.span.start)

            if !owner.is_err()
                result = check_state.result_type(c, owner.must())

                if !result.is_err()
                    is_unit: bool @ false

                    match check_table.get(c.types, result.must())
                        .unit                                                      => is_unit @ true
                        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .error => is_unit @ is_unit
                        .array | .fixed | .map | .fallible | .function_ty | .named => is_unit @ is_unit
                        .case_ty | .failure | .generic                             => is_unit @ is_unit

                    if !is_unit
                        out @ out + "  this function returns: " + check_render.render_ty(c.types, s, decls, result.must(), none) + "\n"
        else
            out @ out + "  expected type: " + check_render.render_ty(c.types, s, decls, hole.expected, none) + "\n"
        out @ out + in_scope(r, c, s, decls, at: hole.span.start)
        out @ out + fields_of(tree, c, s, decls, expected: hole.expected)
        out @ out + nearby(tree, r, c, s, decls, expected: hole.expected, at: hole.span.start)

    return out

# The locals visible at the hole, with their types. "Visible" is
# approximated by THE DECLARATION THE HOLE IS IN, which the resolver
# recorded and is exact for every shape the language has: a local
# cannot be read outside the declaration that binds it.
function in_scope(r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], at: i64) -> str
    owner = owner_of(decls, at: at)

    if owner.is_err()
        return ""
    none: [str] = []
    shown: [str] @ []
    index: i64 @ 0

    for local in r.locals
        if local.owner == owner.must() && local.name.start <= at
            rendered = check_render.render_ty(c.types, s, decls, check_state.local_type(c, index), none)
            marker: str @ ""

            if local.mutable
                marker @ " (mutable)"
            shown @ shown.push(source.span_text(s, local.name) + ": " + rendered + marker)
        index @ index + 1

    if shown.len() == 0
        return ""
    out: str @ "  in scope:\n"
    kept: i64 @ 0

    for line in shown
        if kept < SUGGESTIONS
            out @ out + "    " + line + "\n"
        kept @ kept + 1

    if shown.len() > SUGGESTIONS
        out @ out + "    … and " + (shown.len() - SUGGESTIONS).to_str() + " more\n"
    return out

# The fields of the expected type, where it is a record — the hole is
# most often a value that has to be built, and the fields are what it
# is built from (§4.9: every field named, always).
function fields_of(tree: ast.Ast, c: check_state.Checked, s: source.Source, decls: [ast.Decl], expected: i64) -> str
    decl_at: i64 @ -1

    match check_table.get(c.types, expected)
        .named n                                                   => decl_at @ n.decl
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => decl_at @ decl_at
        .array | .fixed | .map | .fallible | .function_ty | .error => decl_at @ decl_at
        .case_ty | .failure | .generic                             => decl_at @ decl_at

    if decl_at == -1
        return ""

    match decls[decl_at].kind
        .record_decl rec =>
            shown: [str] @ []

            for f in rec.fields
                shown @ shown.push(source.span_text(s, f.name) + ": " + print_types.render_type(tree, f.ty, s))

            return "  fields of " + source.span_text(s, decls[decl_at].name) + ": " + shown.join(", ") + "\n"
        .variant_decl v =>
            shown: [str] @ []

            for one_case in v.cases
                shown @ shown.push("." + source.span_text(s, one_case.name))

            return "  cases of " + source.span_text(s, decls[decl_at].name) + ": " + shown.join(", ") + "\n"
        .constant_decl | .function_decl | .test_decl => return ""

    return ""

# Functions whose result is the expected type, with their
# documentation — ranked by type-relevance and capped, because on a
# file with forty functions the five that RETURN WHAT IS NEEDED HERE
# are the answer. A name from another module is offered the only way
# it can be written — qualified — AND ONLY from a module this file can
# name: a hole in geom.hero offered main.tally is three errors, and
# §4.16's promise is the answer handed over, not a guess to repair.
function nearby(tree: ast.Ast, r: resolved.Resolved, c: check_state.Checked, s: source.Source, decls: [ast.Decl], expected: i64, at: i64) -> str
    here = source.module_at(s, at)
    is_error: bool @ false

    match check_table.get(c.types, expected)
        .error                                                     => is_error @ true
        .int_ty | .float_ty | .bool | .str | .ptr | .cstr | .unit  => is_error @ is_error
        .array | .fixed | .map | .fallible | .function_ty | .named => is_error @ is_error
        .case_ty | .failure | .generic                             => is_error @ is_error

    if is_error
        return ""
    shown: [str] @ []

    # ORDER: ascending (module, name) — deterministic whatever the
    # layout, and the cap picks WHICH five; the port pays the sort the
    # bootstrap's BTreeMap gave for free (design.md §4.9).
    fall: bool @ false

    for module in sort(keys(r.top))
        if fall
            break

        for name in resolved.names_in(r, module: module)
            if fall
                continue
            found = resolved.top_in(r, module: module, name: name)

            if found.is_err()
                continue
            decl = found.must()
            params: [str] @ []
            is_function: bool @ false

            match decls[decl].kind
                .function_decl fd =>
                    is_function @ true

                    for p in fd.value.params
                        marker: str @ ""

                        if p.mutable
                            marker @ "@"
                        params @ params.push(
                            marker + source.span_text(s, p.name) + ": " + print_types.render_type(tree, p.ty, s)
                        )
                .constant_decl | .record_decl | .variant_decl | .test_decl => is_function @ is_function

            if !is_function
                continue
            result = check_state.result_type(c, decl)

            if result.is_err() || result.must() != expected
                continue
            reachable: bool @ module == here || module == source.LIBRARY_MODULE

            if !reachable
                used = r.module_uses[here]

                if !used.is_err()
                    for one in used.must()
                        if one == module
                            reachable @ true

            if !reachable
                continue
            written: str @ name

            if module != here
                written @ module + "." + name
            line: str @ written + "(" + params.join(", ") + ")"

            if decls[decl].doc.len() > 0
                line @ line + "\n      " + source.span_text(s, decls[decl].doc[0])
            shown @ shown.push(line)

            if shown.len() == SUGGESTIONS
                fall @ true

    if shown.len() == 0
        return ""
    out: str @ "  functions that return it:\n"

    for line in shown
        out @ out + "    " + line + "\n"

    return out

# Which declaration a byte offset falls inside.
function owner_of(decls: [ast.Decl], at: i64) -> i64?
    index: i64 @ 0

    for decl in decls
        if decl.span.start <= at && at < decl.span.end
            return ok(index)
        index @ index + 1

    return fail("none", "no declaration holds this offset")

## Tests

test "a hole reports the expected type, the scope, the fields and the makers"
    text = "record Point\n    x: i64\n    y: i64\n\n# Builds the origin.\nfunction origin() -> Point\n    return Point(x: 0, y: 0)\n\nfunction main()\n    n = 3\n    p: Point @ ???\n    print(p.x + n)\n"
    parsed = parse.parse(text)
    s = source.new_source(name: "t.hero", text: text)
    out = resolve.resolve(parsed.tree, s, parsed.decls, parsed.uses)
    c: check_state.Checked @ checker.check(parsed.tree, out, s, parsed.decls)
    assert c.diagnostics.len() == 0
    assert c.holes.len() == 1
    got = report(parsed.tree, out, c, s, parsed.decls)
    assert has_text(text: got, needle: "hole at t.hero:11:16\n")
    assert has_text(text: got, needle: "  expected type: Point\n")
    assert has_text(text: got, needle: "  in scope:\n    n: i64\n")
    assert has_text(text: got, needle: "  fields of Point: x: i64, y: i64\n")
    assert has_text(text: got, needle: "  functions that return it:\n    origin()\n      # Builds the origin.\n")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
