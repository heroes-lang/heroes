# Everything between the generated C and a running binary: where the
# runtime is, what clang is invoked with, and what is cached where
# (design.md §3.1; panels 020, 036, 055). Port of the toolchain half
# of archive/bootstrap-rs/heroes-cli/src/commands/toolchain.rs.
#
# THE CACHE KEY IS THE WHOLE CONFIGURATION, not the source. Measured
# in the bootstrap: hero_print_int changed with runtime.o not
# recompiled relinked silently and printed the old bytes; the compiler
# itself joined the key after two debugging detours on stale output —
# the most expensive shape a build system has, a correct fix that
# appears not to work.
#
# Port decisions, each recorded here and in DECIDE.md's CLI entry:
# - clang and the filesystem verbs arrive through C's own system()
#   (§1.11 eating its own cooking), with stderr redirected to a file
#   under build/ and read back — which is what keeps the ffi error
#   mapping working.
# - the digest is `cli_digest.digest` — two polynomial hashes rather
#   than FNV-64, with the reason in that file. It left this one on
#   2026-08-26 because the runtime object's freshness check needs
#   `cli_deps`, `cli_deps` needs to hash a file, and Heroes refuses
#   module cycles.
# - the compiler fingerprint and the runtime hint arrive as PARAMETERS
#   from the driver: the language has no current_exe and no getenv
#   (yet — the DECIDE entry owns the question).
# - the runtime's contents are gathered by one shell glob (`cat` in
#   the shell's sorted order) because the language has no readdir;
#   same fact, same key, different plumbing.

use cli_io
use cli_deps
use cli_digest
use cli_flags
use cli_shell

record Toolchain
    runtime: str
    build: str
    fingerprint: str
    # The runtime's whole contents, already hashed. It is a FIELD and
    # not a call because the per-module path asks for it once per
    # translation unit: on the compiler's own source that was 157 shell
    # `cat` invocations and 25 MB of hashing (162 KB × 157) for one
    # answer that cannot change during a build. Located once, here.
    runtime_key: str

# Locate the runtime, or say the places it looked. The search is why
# the ABI stamp exists: a decoy runtime/ compiled with zero warnings
# under -Weverything and printed 0x1e where 30 was expected; the stamp
# turns that silence into `use of undeclared identifier`.
function locate_toolchain(hint: str, fingerprint: str) -> Toolchain?
    candidates: [str] @ []

    if hint.len() > 0
        candidates @ candidates.push(hint)
    candidates @ candidates.push("runtime")

    for candidate in candidates
        if !read_file(candidate + "/heroes_runtime.h").is_err() && !read_file(candidate + "/runtime.c").is_err()
            return ok(
                Toolchain(runtime: candidate, build: "build", fingerprint: fingerprint, runtime_key: cli_digest.digest(runtime_text(runtime: candidate, build: "build")))
            )

    return fail(
        "failed",
        "cannot find the Heroes runtime (heroes_runtime.h and runtime.c).\n  looked in: the given hint and ./runtime\n  set HEROES_RUNTIME=<dir> to say where it is"
    )

# Run one clang line, stderr captured to a file and read back. clang's
# own words are kept verbatim: a failure here says THE COMPILER is
# wrong — the generated C is not the author's text — so the caller
# exits 2. A WARNING is forwarded rather than swallowed, and that is
# the whole point of the flag set: a warning nobody sees cannot
# falsify anything.
function run_clang(line: str, what: str, err_path: str) -> ()?
    status = cli_shell.shell(command: line + " 2> " + cli_shell.sq(err_path))
    noise: str @ ""
    captured = read_file(err_path)

    if !captured.is_err()
        noise @ captured.must()

    if status == 0
        if trimmed(noise).len() > 0
            cli_io.eprint_raw(text: noise)
        return ok()
    return fail("clang", what + " failed:\n" + noise)

function trimmed(text: str) -> str
    cs = text.chars()
    head: i64 @ 0

    while head < cs.len() && (cs[head] == " " || cs[head] == "\t" || cs[head] == "\n")
        head @ head + 1

    tail: i64 @ cs.len()

    while tail > head && (cs[tail - 1] == " " || cs[tail - 1] == "\t" || cs[tail - 1] == "\n")
        tail @ tail - 1

    return cs.slice(from: head, to: tail).join("")

# Whether a path names anything — through the shell, because read_file
# refuses a directory and chokes on a binary's bytes; `test -e` is the
# one honest probe the port has.
function exists(path: str) -> bool
    return cli_shell.shell(command: "test -e " + cli_shell.sq(path)) == 0

function is_directory(path: str) -> bool
    return cli_shell.shell(command: "test -d " + cli_shell.sq(path)) == 0

function mkdir_all(path: str) -> ()?
    if cli_shell.shell(command: "mkdir -p " + cli_shell.sq(path)) != 0
        return fail("failed", "cannot create " + path)
    return ok()

# The runtime's whole contents — EVERY file, not the two entry points:
# runtime.c is assembled from parts/, so hashing only the file clang
# is handed would let a part be edited with the cached object still
# used. The shell's glob order is sorted, so the key is a function of
# the contents and not of readdir order.
#
# It takes the two strings rather than the Toolchain because it is what
# BUILDS one: `locate_toolchain` calls it to fill `runtime_key`, and
# every other caller reads that field instead.
function runtime_text(runtime: str, build: str) -> str
    gathered = build + "/runtime-sources.txt"
    _ = mkdir_all(build)
    _ = cli_shell.shell(
        command: "cat " + cli_shell.sq(runtime) + "/*.c " + cli_shell.sq(runtime) + "/*.h " + cli_shell.sq(runtime) + "/parts/*.c " + cli_shell.sq(runtime) + "/parts/*.h > " + cli_shell.sq(gathered) + " 2>/dev/null"
    )
    found = read_file(gathered)

    if found.is_err()
        return ""
    return found.must()

# Where this program's artifacts live: build/<hash>/. The hash is what
# makes two files with the same stem, or the same file at two levels,
# different builds — and the search paths are in it (panel 055,
# measured: two configurations shared one artifact and the second
# silently reused the first).
function dir_for(t: Toolchain, source_name: str, text: str, level_key: str, sanitize: bool, search: str) -> str?
    san: str @ ""

    if sanitize
        san @ "+san"
    key = cli_digest.digest(
        t.fingerprint + "|" + level_key + san + "|" + source_name + "|" + text + "|" + t.runtime_key + search
    )
    dir = t.build + "/" + key
    made = mkdir_all(dir)

    if made.is_err()
        return fail("failed", "cannot create " + dir)
    return ok(dir)

# Compile the runtime once and cache it, keyed on its own contents,
# the level and the compiler. A stale relink is silent, so the key is
# the only thing standing between a golden test and passing for the
# wrong reason. Staged beside and moved into place: mv inside one
# directory is atomic on POSIX, and whoever wins the race published
# byte-for-byte our object, because the key covers everything.
#
# **The key covers the runtime's own sources and nothing else, so the
# C HEADERS `runtime.c` includes were outside it** — the same hole the
# per-module cache had, one level over, and this one is worse when it
# fires: every translation unit rebuilds against the new headers while
# this object does not, which is a libc ABI mismatch inside a single
# binary and needs nobody to have touched a line of Heroes. So it
# records what clang opened, exactly as `cli_units.tu_object` does, and
# `skip` is the runtime's own directory because `runtime_key` already
# hashes every byte of it (CLAUDE.md §1: a repair is attacked at the
# shapes next to the one that provoked it, before the commit).
function runtime_object(t: Toolchain, level: str, sanitize: bool) -> str?
    key = cli_digest.digest(t.fingerprint + "|" + level + "|" + bool_text(sanitize) + "|" + t.runtime_key)
    made = mkdir_all(t.build)

    if made.is_err()
        return fail("failed", "cannot create " + t.build)
    object = t.build + "/runtime-" + key + ".o"
    memo: {str: str} @ {}

    if exists(object) && cli_deps.fresh(cli_deps.record_for(object), @memo)
        return ok(object)
    depfile = object + ".d"
    staged = object + ".tmp"
    line: str @ "clang " + words(cli_flags.flags()) + " " + level + " " + words(cli_flags.sanitizers(sanitize: sanitize)) + " -c -MD -MT dep -MF " + cli_shell.sq(depfile) + " " + cli_shell.sq(t.runtime + "/runtime.c") + " -I " + cli_shell.sq(t.runtime) + " -o " + cli_shell.sq(staged)
    ran = run_clang(line: line, what: "compiling the runtime", err_path: t.build + "/clang-stderr.txt")

    if ran.is_err()
        ran?

    # Recorded before the object is published, so an object on disk is
    # never one this cache cannot justify serving.
    recorded = cli_deps.record_deps(
        record_path: cli_deps.record_for(object),
        depfile: depfile,
        skip: t.runtime + "/",
        @memo
    )

    if recorded.is_err()
        return fail("failed", "cannot record what the runtime's translation unit read")

    if cli_shell.shell(command: "mv -f " + cli_shell.sq(staged) + " " + cli_shell.sq(object)) != 0
        return fail("failed", "cannot publish " + object)
    return ok(object)

function bool_text(value: bool) -> str
    if value
        return "true"
    return "false"

function words(list: [str]) -> str
    quoted: [str] @ []

    for one in list
        quoted @ quoted.push(cli_shell.sq(one))

    return quoted.join(" ")

# Compile one generated unit and link it with the runtime. The unit is
# compiled to an object THAT SURVIVES (the Darwin N_OSO repair: the
# DWARF lives in the object, and one compile-and-link invocation left
# the debug info in clang's temporary directory). include ordering:
# the author's own search paths first, then the package flags, then
# the runtime's -I, then the source's directory — a source directory
# holding a stray heroes_runtime.h must not win over the real one.
# Libraries are NAMES, not flags: -l is prefixed here, so no .hero
# file can hand clang an arbitrary argument. Package resolution is the
# caller's (cli_libraries, the next crossing): what arrives here is
# already flags.
function link(t: Toolchain, c_file: str, object: str, binary: str, level: str, sanitize: bool, source_dir: str, search_include: [str], search_library: [str], package_flags: [str], link_names: [str]) -> ()?
    err_path = t.build + "/clang-stderr.txt"
    unit_object = c_file + ".o"
    staged_object = unit_object + ".tmp"
    compile_line: str @ "clang " + words(cli_flags.flags()) + " " + level + " " + words(cli_flags.sanitizers(sanitize: sanitize)) + " -c"

    for dir in search_include
        compile_line @ compile_line + " -I " + cli_shell.sq(dir)

    for flag in package_flags
        if starts_with(text: flag, prefix: "-I")
            compile_line @ compile_line + " " + cli_shell.sq(flag)

    compile_line @ compile_line + " " + cli_shell.sq(c_file) + " -I " + cli_shell.sq(t.runtime)

    if source_dir.len() > 0
        compile_line @ compile_line + " -I " + cli_shell.sq(source_dir)
    compile_line @ compile_line + " -o " + cli_shell.sq(staged_object)
    compiled = run_clang(line: compile_line, what: "compiling the generated C", err_path: err_path)

    if compiled.is_err()
        compiled?

    if cli_shell.shell(command: "mv -f " + cli_shell.sq(staged_object) + " " + cli_shell.sq(unit_object)) != 0
        return fail("failed", "cannot publish " + unit_object)
    link_line: str @ "clang " + words(cli_flags.flags()) + " " + level + " " + words(cli_flags.sanitizers(sanitize: sanitize))

    for dir in search_include
        link_line @ link_line + " -I " + cli_shell.sq(dir)

    for dir in search_library
        link_line @ link_line + " -L " + cli_shell.sq(dir)

    link_line @ link_line + " " + cli_shell.sq(unit_object) + " " + cli_shell.sq(object)

    for flag in package_flags
        link_line @ link_line + " " + cli_shell.sq(flag)

    for name in link_names
        link_line @ link_line + " " + cli_shell.sq("-l" + name)

    staged = binary + ".tmp"
    link_line @ link_line + " -o " + cli_shell.sq(staged)
    linked = run_clang(line: link_line, what: "linking", err_path: err_path)

    if linked.is_err()
        linked?

    if cli_shell.shell(command: "mv -f " + cli_shell.sq(staged) + " " + cli_shell.sq(binary)) != 0
        return fail("failed", "cannot publish " + binary)
    return ok()

function starts_with(text: str, prefix: str) -> bool
    cs = text.chars()
    ps = prefix.chars()

    if ps.len() > cs.len()
        return false
    index: i64 @ 0

    for p in ps
        if cs[index] != p
            return false
        index @ index + 1

    return true

## Tests

test "digesting and probing — the shell spoken safely"
    assert starts_with(text: "-I/opt", prefix: "-I")
    assert !starts_with(text: "-L/opt", prefix: "-I")
    assert is_directory(path: "runtime")
    assert !is_directory(path: "runtime/runtime.c")
    assert exists(path: "runtime/heroes_runtime.h")
    assert !exists(path: "runtime/no_such_file.h")

test "the toolchain finds the real runtime and compiles it through system()"
    found = locate_toolchain(hint: "", fingerprint: "port-test")
    assert !found.is_err()
    t = found.must()
    assert t.runtime == "runtime"

    # The runtime's contents reach the key: a different fingerprint is
    # a different directory.
    d1 = dir_for(t, source_name: "x.hero", text: "a", level_key: "-O0", sanitize: false, search: "")
    d2 = dir_for(t, source_name: "x.hero", text: "b", level_key: "-O0", sanitize: false, search: "")
    assert !d1.is_err()
    assert d1.must() != d2.must()
    assert is_directory(path: d1.must())

    # The real thing: clang compiles the real runtime once, and the
    # second ask is the cache.
    object = runtime_object(t, level: "-O0", sanitize: false)
    assert !object.is_err()
    assert exists(path: object.must())
    again = runtime_object(t, level: "-O0", sanitize: false)
    assert again.must() == object.must()

    # A broken unit fails with clang's own words carried back.
    _ = write_file(path: "build/selftest_broken.c", text: "int main(void) { return undeclared_name; }\n")
    bad = run_clang(
        line: "clang -c 'build/selftest_broken.c' -o 'build/selftest_broken.o'",
        what: "compiling the generated C",
        err_path: "build/selftest_err.txt"
    )

    match bad
        .ok => assert false
        .err e =>
            assert e.code == "clang"
            assert has_text(text: e.msg, needle: "undeclared_name")

function has_text(text: str, needle: str) -> bool
    cs = text.chars()
    needle_cs = needle.chars()

    if needle_cs.len() == 0
        return true

    if needle_cs.len() > cs.len()
        return false
    start: i64 @ 0

    while start <= cs.len() - needle_cs.len()
        matched: bool @ true
        offset: i64 @ 0

        while offset < needle_cs.len()
            if cs[start + offset] != needle_cs[offset]
                matched @ false
                break
            offset @ offset + 1

        if matched
            return true
        start @ start + 1

    return false
