# heroes mutate [dir] — metric 3, offline (design.md Part 11).
#
# Port of crates/heroes-cli/src/commands/mutate.rs. Takes every program in the
# corpus that checks clean, makes **one plausible mistake per site**, and counts
# how many the compiler catches — in two arms, so the number means something. A
# language that rejects everything would score 100% and prove nothing, which is
# why the control arm (`--permissive`, the same compiler with the thesis rules
# dropped) is printed beside it.
#
# THE CORPUS IS THE CLEAN PROGRAMS. Mutating a program that is already wrong
# measures nothing, because the compiler would reject the mutant for the mistake
# that was already there — so a corpus that does not compile is **refused at
# exit 2** rather than quietly narrowed (author decision 2026-08-12, after
# `heroes mutate` reported 77 sites and 100% killed over a directory `heroes
# check` refuses).
#
# THE DIRECTORY WALK IS `find -print0`, AND THAT IS MEASURED RATHER THAN
# PREFERRED. Heroes has no directory API (§1.11 — everything comes from C), and
# the cheap route is unsound: `ls > file` plus `read_file` **splits a filename
# containing a newline into two entries at exit 0**, which CLAUDE.md §12's
# robustness rule forbids. NUL is the one byte a filename cannot hold, a Heroes
# `str` carries it through `read_file` and byte indexing without trouble, and
# `tests/harness/shell.hero` measured the same route on both compilers
# (DESIGN-LOG:389).

use cli_argv
use cli_io
use cli_table
use cli_toolchain
use cli_shell
use library_source
use mutate_ops
use mutate_score

constant DEFAULT_DIR: str
    "examples"

# Under `build/`, which is the one directory this project already treats as
# disposable — the same place `doctor` writes what it captures.
constant LISTING: str
    "build/mutate-listing"

function run(inv: cli_argv.Invocation) -> cli_table.Exit
    only: str @ cli_argv.value_of(inv, spelling: "--operator").default("")
    if only.len() > 0 && !mutate_ops.known(only)
        cli_io.eprint(text: "error: no operator `" + only + "`\n  the " + mutate_ops.ids().len().to_str() + " are: " + mutate_ops.ids().join(", "))
        return .failed_exit
    dir = inv.file.default(DEFAULT_DIR)
    found = corpus(dir)
    if found.is_err()
        cli_io.eprint(text: "error: " + why(found))
        return .failed_exit
    sources = found.must()
    if sources.len() == 0
        cli_io.eprint(text: "error: no `.hero` files under " + dir)
        return .failed_exit
    library = library_source.text()
    refusal = refuse_a_corpus_that_does_not_compile(sources: sources, library: library)
    if !refusal.is_err()
        cli_io.eprint(text: "error: " + refusal.must())
        return .failed_exit
    print("corpus: " + sources.len().to_str() + " programs under " + dir + "\n")
    run_out = mutate_score.scored(sources: sources, only: only, library: library)
    cli_io.print_artifact(text: mutate_score.report(run_out.scores))
    if cli_argv.has(inv, spelling: "--survivors")
        cli_io.print_artifact(text: mutate_score.survivor_report(run_out.survivors))
    return .ok_exit

# Every `.hero` file under `dir`, sorted, with its text.
function corpus(dir: str) -> [mutate_score.Program]?
    _ = cli_toolchain.mkdir_all("build")
    line = "find " + cli_shell.sq(dir) + " -type f -name '*.hero' -print0 > " + cli_shell.sq(LISTING)
    if cli_shell.shell(command: line) != 0
        return fail("no_corpus", "cannot read " + dir)
    listing = read_file(LISTING)
    if listing.is_err()
        return fail("no_corpus", "cannot read the listing at " + LISTING)
    paths: [str] @ []
    for piece in split_on_nul(listing.must())
        if piece.len() > 0
            paths @ paths.push(piece)
    out: [mutate_score.Program] @ []
    for path in paths.sort()
        text = read_file(path)
        if text.is_err()
            return fail("no_corpus", "cannot read " + path)
        out @ out.push(mutate_score.Program(name: path, text: text.must()))
    return ok(out)

# Every program in the corpus must compile BEFORE anything is mutated. Every
# offending file is listed rather than the first, because a corpus is usually
# wrong in one way and fixing it one error per run is the slowest possible loop.
function refuse_a_corpus_that_does_not_compile(sources: [mutate_score.Program], library: str) -> str?
    refused: [str] @ []
    for one in sources
        if !mutate_score.base_checks_clean(name: one.name, text: one.text, library: library)
            refused @ refused.push(one.name)
    if refused.len() == 0
        return fail("clean", "every program compiles")
    message: str @ "this corpus does not compile, so its kill rate would be meaningless\n  " + refused.len().to_str() + " of " + sources.len().to_str() + " programs are already refused by `heroes check`:\n"
    for name in refused
        message @ message + "    " + name + "\n"
    return ok(message + "  every mutant of a program that is already wrong is killed by the\n  diagnostic that was already there — run `heroes check` on each")

function why(got: [mutate_score.Program]?) -> str
    return match got
        .ok _ => ""
        .err e => e.msg

# Split on the NUL byte `find -print0` writes. No Heroes literal can spell that
# byte — the language has six escapes and `\0` is not one (spec:68) — so the
# comparison is against the number.
function split_on_nul(text: str) -> [str]
    pieces: [str] @ []
    start: i64 @ 0
    i: i64 @ 0
    while i < text.len()
        if text[i] == 0
            pieces @ pieces.push(text.slice(from: start, to: i))
            start @ i + 1
        i @ i + 1
    if start < text.len()
        pieces @ pieces.push(text.slice(from: start, to: text.len()))
    return pieces

test "the NUL split keeps a name that holds a newline whole"
    # The falsifier panel 085 R4 measured, kept as a test: this is the case
    # `ls` splits in two at exit 0.
    joined = "a.hero" + one_nul() + "two\nlines.hero" + one_nul()
    pieces = split_on_nul(joined)
    assert pieces.len() == 2
    assert pieces[0] == "a.hero"
    assert pieces[1] == "two\nlines.hero"
    assert split_on_nul("").len() == 0

# One NUL byte, built through the only door the language leaves open: a `cstr`
# that C wrote. `read_file` carries the byte, and this makes one without a file.
function one_nul() -> str
    _ = cli_toolchain.mkdir_all("build")
    path = "build/mutate-nul-selftest"
    line = "printf 'x\\000y' > " + cli_shell.sq(path)
    _ = cli_shell.shell(command: line)
    got = read_file(path)
    if got.is_err()
        return ""
    return got.must().slice(from: 1, to: 2)

test "an unknown operator names the ones there are"
    # The count is read off the table, never written: it said "twelve" in the
    # bootstrap's help while there were thirteen (CLAUDE.md §11).
    assert mutate_ops.ids().len() == 13
    assert !mutate_ops.known("swapargs")
