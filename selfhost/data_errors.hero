# Fields, labels, cases and patterns — the messages about SHAPES.
# Port of archive/bootstrap-rs/heroes/src/types/errors/data.rs.
#
# The labels of a call, `needs_label`, `missing_label`, `wrong_label` and
# `label_on_function_value`, moved to `label_errors.hero` on 2026-09-30 (lane
# 135b), along §4.9's own seam; what stays here is about the shapes a call
# builds and a pattern reads, and the markers of §4.8.
#
# `no_field_and_no_function` is the message the compiler-engineer's
# panel-015 veto bought: with the receiver's type in hand, both halves of
# §4.11's lookup fit in one diagnostic instead of two passes each guessing
# one.

use token
use diag

function not_a_record(got: str, field: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "no_such_field",
        message: "`" + got + "` has no fields, so `." + field + "` cannot be read from it",
        span: span
    )

function no_such_field(holder: str, field: str, known: [str], span: token.Span) -> diag.Diagnostic
    tail: str @ ""

    if known.len() > 0
        quoted: [str] @ []

        for f in known
            quoted @ quoted.push("`" + f + "`")

        tail @ " — `" + holder + "` has " + quoted.join(", ")
    return diag.new_diagnostic(
        code: "no_such_field",
        message: "`" + holder + "` has no field `" + field + "`" + tail,
        span: span
    )

# The combined message the compiler-engineer's panel-015 veto asked for.
function no_field_and_no_function(holder: str, name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "unknown_function",
        message: "`" + holder + "` has no field `" + name + "`, and no function is named `" + name + "` — `x." + name + "(…)` means `" + name + "(x, …)`",
        span: span
    )

## Fields, labels and markers

function field_of_variant(holder: str, field: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "no_such_field",
        message: "`" + holder + "` is a variant, so `." + field + "` belongs to one of its cases — reach it through `match`",
        span: span
    )

function missing_fields(holder: str, fields: [str], declared_at: str, span: token.Span) -> diag.Diagnostic
    labelled: [str] @ []

    for f in fields
        labelled @ labelled.push(f + ":")

    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "missing_fields",
        message: "`" + holder + "` is built with every field, named: " + labelled.join(", ") + " — all of them, always",
        span: span
    )
    d.notes @ d.notes.push("`" + holder + "` is declared at " + declared_at)
    return d

# The three refusals a function type's parameter NAMES can earn (defect 026).
# §4.9 names the arguments of a call when two parameters share a type, and a
# function type had no names at any of its sites, so the same swap went through
# a value in silence. The names are written exactly where the rule needs them:
# mandatory on a same-typed pair, refused where none, and never on half a run.

# `(function(a: str, a: str) -> str)` — one name at two positions. The names are
# mandatory here so that the two CANNOT be confused, and a name used twice is
# the one spelling that leaves them exactly as confusable as no name at all:
# panel 129's compiler seat found it by attacking the shape beside the repair,
# and the swap inside such a type was accepted at exit 0.
function repeated_parameter_name(written: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "repeated_parameter_name",
        message: "this function type calls two of its parameters `" + written + "`, so a call through it still cannot say which is which",
        span: span
    )
    d.notes @ d.notes.push(
        "the names are what §4.9 checks a call against, so two positions of one type need two names a reader can tell apart"
    )
    return d

# `(function([i64]: str) -> ())` — whatever stands before the colon, it is not
# a name.
function parameter_name_not_a_name(span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "parameter_name_not_a_name",
        message: "a parameter name is a plain name, `from`, and this is a type",
        span: span
    )

# The mandatory half. The message shows the repair in full rather than
# describing it, because the reader has to invent two names and the shape is
# what tells them where they go.
function needs_parameter_names(shared: str, shown: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "needs_parameter_names",
        message: "two of `" + shown + "`'s parameters are `" + shared + "`, so this type names both of them — give each a name that says which is which",
        span: span
    )
    d.notes @ d.notes.push(
        "§4.9 names the arguments of a call when two parameters share a type; a value of a function type is called through the type, so the names live in the type and a call through it is checked against them"
    )
    return d

# The refused half, and the code a function type carrying a pointless name has
# earned since before defect 026 — what changed is the reason, from *a function
# type lists types* to *this one needs no names*. The fix stays `certain`: the
# positions cannot be confused, so dropping the name changes nothing a program
# can observe.
function named_parameter_in_function_type(written: str, span: token.Span) -> diag.Diagnostic
    d: diag.Diagnostic @ diag.new_diagnostic(
        code: "named_parameter_in_function_type",
        message: "no two parameters of this function type share a type, so `" + written + ":` names a position nothing can confuse",
        span: span
    )
    d.fixes @ d.fixes.push(
        diag.Fix(title: "drop the parameter name", replacement: "", span: span, certainty: .certain)
    )
    return d

# §4.8: the marker is on the parameter AND at the call site, so a
# mutating call cannot look like a reading one.
function marker_mismatch(name: str, wants: bool, span: token.Span) -> diag.Diagnostic
    message: str @ "`" + name + "` does not change this argument — the `@` says it does"

    if wants
        message @ "`" + name + "` changes this argument, so the call site writes `@` too"
    d: diag.Diagnostic @ diag.new_diagnostic(code: "marker_mismatch", message: message, span: span)

    if wants
        d.fixes @ d.fixes.push(
            diag.Fix(title: "mark the argument: `@x`", replacement: "@", span: token.Span(start: span.start, end: span.start), certainty: .certain)
        )
    return d

function ufcs_on_mutable(name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "ufcs_on_mutable",
        message: "`" + name + "` changes its first argument, so it is called `" + name + "(@x, …)` — the dotted form would hide the `@`",
        span: span
    )

## Patterns

function not_matchable(got: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(code: "not_matchable", message: "`" + got + "` has no cases to match on", span: span)

function case_on_non_variant(got: str, case_name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "not_matchable",
        message: "`." + case_name + "` is a variant case, and this value is a `" + got + "`",
        span: span
    )

function no_such_case(holder: str, case_name: str, known: [str], span: token.Span) -> diag.Diagnostic
    quoted: [str] @ []

    for c in known
        quoted @ quoted.push("`." + c + "`")

    return diag.new_diagnostic(
        code: "no_such_case",
        message: "`" + holder + "` has no case `." + case_name + "` — it has " + quoted.join(", "),
        span: span
    )

function duplicate_arm(case_name: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "duplicate_arm",
        message: "`." + case_name + "` is already covered by an earlier arm",
        span: span
    )

# §4.7's ban, with the reason attached: it is what keeps exhaustiveness
# from becoming theatre when a case is added later.
function wildcard_on_variant(got: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "wildcard_on_variant",
        message: "`_` is not allowed as an arm over `" + got + "` — name every case, so that adding one breaks this `match` instead of silently falling through",
        span: span
    )

function non_exhaustive(missing: [str], span: token.Span) -> diag.Diagnostic
    quoted: [str] @ []

    for c in missing
        quoted @ quoted.push("`" + c + "`")

    return diag.new_diagnostic(
        code: "non_exhaustive",
        message: "this `match` does not cover " + quoted.join(", "),
        span: span
    )

function needs_wildcard(span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "non_exhaustive",
        message: "matching on `i64` or `str` cannot be exhaustive, so it needs a `_` arm",
        span: span
    )

## Tests

test "the marker fix exists only in the direction that adds the @"
    wants = marker_mismatch(name: "advance", wants: true, span: token.Span(start: 5, end: 6))
    assert wants.fixes.len() == 1
    assert wants.fixes[0].replacement == "@"
    stray = marker_mismatch(name: "read", wants: false, span: token.Span(start: 5, end: 6))
    assert stray.fixes.len() == 0
    assert stray.message == "`read` does not change this argument — the `@` says it does"

test "the pattern messages name what is known and what is missing"
    span = token.Span(start: 0, end: 4)
    cases: [str] = ["num", "plus"]
    missing_case = no_such_case(holder: "Token", case_name: "minus", known: cases, span: span)
    assert missing_case.message == "`Token` has no case `.minus` — it has `.num`, `.plus`"
    left: [str] = ["lparen"]
    partial_match = non_exhaustive(missing: left, span: span)
    assert partial_match.message == "this `match` does not cover `lparen`"
    banned = wildcard_on_variant(got: "Token", span: span)
    assert banned.code == "wildcard_on_variant"

# A literal arm whose value an earlier literal arm took (defect 128). The
# earlier spelling is named where it differs, since `'a'` covering `97` is
# the whole of what the reader has to be told.
function covered_value(shown: str, earlier: str, span: token.Span) -> diag.Diagnostic
    tail: str @ ""

    if earlier != shown
        tail @ ", written `" + earlier + "`, the same value"
    return diag.new_diagnostic(
        code: "duplicate_arm",
        message: "`" + shown + "` is already covered by an earlier arm" + tail + ": no value reaches this one",
        span: span
    )

# A pattern after a `_`, which has taken every value (defect 128).
function after_a_wildcard(shown: str, span: token.Span) -> diag.Diagnostic
    return diag.new_diagnostic(
        code: "duplicate_arm",
        message: "`" + shown + "` is already covered by an earlier arm, whose `_` matches every value: no value reaches this one",
        span: span
    )
