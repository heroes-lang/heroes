# A version's listing as an index serves it, read back into the lines its sum
# was taken over (panel 235's R6 and R20, ratified 2026-11-07): `<64 hex>  <name>`
# and a line end each, the names in the order of their bytes, none twice.
# `heroes fetch` holds the listing to the catalogue's `sum` before it reads it
# here, so what this reads is the text the fingerprint names; it is read again
# because each name is a path the fetch then writes, so a name no package may
# hold is refused before a byte lands (`fetch/tree_names.hero`), and a listing
# in any other shape is refused rather than guessed at, since it is not the
# canonical one `module/fingerprint.hero` writes.
#
# Moved whole out of `fetch/index_source.hero` with defect 2525, so that the
# module asking an index for a version keeps room for what it says when the
# index serves none, under the ceiling `.claude/rules/module-shape.md` sets.

use fetch/tree_names
use module/sums

# One line of a listing: a file's SHA-256 and its name.
record Line
    sum: str
    path: str

# A listing read as the lines its sum was taken over: `<64 hex>  <name>` and a
# line end each, the names in the order of their bytes, none twice, every name
# one a package may hold, and no two one where case is ignored. A listing in
# any other shape is refused, since it is not the canonical one a tree's sum
# reads (`module/fingerprint.hero`).
function lines_of_listing(listing: str) -> [Line]?
    out: [Line] @= []
    paths: [str] @= []
    from: i64 @= 0

    if listing.len() > 0 && listing[listing.len() - 1] != '\n'
        return fail(
            code: "index_refused",
            msg: "the listing does not end with a line end, which its canonical form does"
        )

    for at in range(from: 0, to: listing.len())
        if listing[at] == '\n'
            line = listing.slice(from: from, to: at)

            if line.len() < 67 || !sums.sum_shape("sha256-" + line.slice(from: 0, to: 64)) || line[64] != ' ' || line[65] != ' '
                return fail(
                    code: "index_refused",
                    msg: "a line of the listing is not `<sha256>  <name>`: `" + line + "`"
                )
            path = line.slice(from: 66, to: line.len())
            said = tree_names.name_said(path)

            if said.len() > 0
                return fail(code: "name_refused", msg: said)

            if paths.len() > 0 && !before(first: paths[paths.len() - 1], then: path)
                return fail(
                    code: "index_refused",
                    msg: "the listing names `" + path + "` after `" + paths[paths.len() - 1] + "`, where its canonical form orders the names by their bytes, each once"
                )
            out @ out.push(Line(sum: line.slice(from: 0, to: 64), path: path))
            paths @ paths.push(path)
            from @ at + 1

    twice = tree_names.collision(paths)

    if twice.len() > 0
        return fail(code: "name_refused", msg: twice)
    return ok(out)

# Whether `first` comes before `then` in the order of their bytes, a name
# before every longer name it opens.
function before(first: str, then: str) -> bool
    at: i64 @= 0

    while at < first.len() && at < then.len()
        if first[at] != then[at]
            return first[at] < then[at]
        at @ at + 1

    return first.len() < then.len()

## Tests

test "a listing's names are in the order of their bytes, a name before every longer name it opens, each once"
    sum = "a".repeat(64.to_u64().must())
    read = lines_of_listing(sum + "  a.hero\n" + sum + "  a/b.hero\n").must()
    assert read.len() == 2 && read[1].path == "a/b.hero" && read[1].sum == sum
    assert before(first: "a", then: "a/b")
    assert !before(first: "b", then: "a")
    assert !before(first: "a", then: "a")
    assert lines_of_listing(sum + "  b.hero\n" + sum + "  a.hero\n").is_err()
    assert lines_of_listing(sum + "  a.hero\n" + sum + "  a.hero\n").is_err()
    assert lines_of_listing(sum + "  a.hero").is_err()
