# A git repository a test makes on the fly, under `build/`, so the verbs that
# fetch are tested against a source on this machine and never the network
# (panel 235's R19: the goldens need no network, a git source being a local
# repository the test makes). Nothing here is reached by a command; only the
# `test` blocks of `fetch/` call it.
#
# **A test's git asks nothing of the person running it.** Every command names
# its own identity, signs nothing and runs no hook, whatever the user's
# configuration says (`commit.gpgsign`, a global `core.hooksPath`), since a
# case that fails on one machine's settings tests the machine. The dates are
# fixed too, through the environment every git this process starts inherits,
# so a commit's name is the same on every run.

use cli/process
use cli/read_back
use cli/strings

# `runtime/hero_compiler.h`: this process's environment, which every program
# it starts inherits.
extern "hero_compiler.h"
    function hero_env_put(name: cstr lent, value: cstr lent) -> i64

# The date every commit a test makes carries.
constant DATE: str
    "2026-11-08T00:00:00Z"

# The settings every test's git command carries, before its own words.
function settings(dir: str) -> [str]
    return [
        "git"
        "-C"
        dir
        "-c"
        "user.name=heroes"
        "-c"
        "user.email=heroes@example.invalid"
        "-c"
        "commit.gpgsign=false"
        "-c"
        "tag.gpgsign=false"
        "-c"
        "core.hooksPath=" + dir + "/.git/no-hooks"
        "-c"
        "core.autocrlf=false"
        "-c"
        "init.defaultBranch=main"
    ]

# git run in `dir` with `words`, at exit 0 or the failure saying what it said.
function git(dir: str, words: [str]) -> ()?
    said = dir + "-git-said.txt"
    ran = process.run(
        program: "git",
        words: strings.with_all(list: settings(dir), more: words),
        out: process.discard(),
        err: said
    )

    if !ran.started || ran.code != 0
        return fail(
            code: "git",
            msg: "`git " + words.join(" ") + "` in " + dir + " failed: " + read_back.words(said).default("")
        )
    return ok()

# A new repository at `dir`, whatever stood there removed first.
function made(dir: str) -> ()?
    _ = hero_env_put(name: "GIT_AUTHOR_DATE".cstr(), value: DATE.cstr())
    _ = hero_env_put(name: "GIT_COMMITTER_DATE".cstr(), value: DATE.cstr())
    process.remove_tree(dir)?
    process.mkdir_all(dir)?
    git(dir, words: ["init", "-q"])?
    return ok()

# `files`, each a path and its text in turn, written and committed in `dir`
# at the fixed date; the commit's whole name.
function committed(dir: str, files: [str], message: str) -> str?
    paths: [str] @= []
    at: i64 @= 0

    while at + 1 < files.len()
        path = dir + "/" + files[at]
        parent = path.slice(from: 0, to: last_slash(path))
        process.mkdir_all(parent)?
        write_file(path: path, text: files[at + 1])?
        paths @ paths.push(files[at])
        at @ at + 2

    git(dir, words: strings.with_all(list: ["add", "--"], more: paths))?
    git(dir, words: strings.with_all(list: ["commit", "-q", "-m", message, "--"], more: paths))?
    return head(dir)

# `tag` set on `dir`'s HEAD: an annotated tag, an object of its own that
# names the commit, where `annotated`, else a name for the commit alone.
# `-f` moves a tag that is there, as a publisher who moves one does.
function tagged(dir: str, tag: str, annotated: bool) -> ()?
    if annotated
        return git(dir, words: ["tag", "-f", "-a", "-m", "the release " + tag, "--", tag])
    return git(dir, words: ["tag", "-f", "--", tag])

# The commit `dir`'s HEAD names.
function head(dir: str) -> str?
    out = dir + "-git-head.txt"
    ran = process.run(
        program: "git",
        words: strings.with_all(list: settings(dir), more: ["rev-parse", "HEAD"]),
        out: out,
        err: process.discard()
    )

    if !ran.started || ran.code != 0
        return fail(code: "git", msg: "`git rev-parse HEAD` in " + dir + " failed")
    return ok(strings.trimmed(read_back.words(out).default("")))

# The bytes `hex` writes into the file `path`: every byte a test needs that a
# `str` cannot hold, a name that is not UTF-8 inside a tree object, a file of
# a package that is not text. Written by a program of a few lines of C, as
# `cli/process.hero`'s tests make the shapes only C can, built once into
# `RAW`.
function raw_file(path: str, hex: str) -> ()?
    maker = RAW + "/rawfile" + process.exe_suffix()

    if !process.path_exists(maker)
        process.mkdir_all(RAW)?
        write_file(path: RAW + "/rawfile.c", text: RAW_C)?
        built = process.run(
            program: "clang",
            words: ["clang", RAW + "/rawfile.c", "-o", maker],
            out: process.discard(),
            err: RAW + "/clang-said.txt"
        )

        if !built.started || built.code != 0
            return fail(
                code: "clang",
                msg: "the byte writer did not build: " + read_back.words(RAW + "/clang-said.txt").default("")
            )
    ran = process.run(program: maker, words: [maker, path, hex], out: process.discard(), err: process.discard())

    if !ran.started || ran.code != 0
        return fail(code: "raw", msg: "the byte writer could not write " + path)
    return ok()

constant RAW: str
    "build/selftest-fetch-raw"

# The byte writer: its first argument the file, its second the bytes in small
# hexadecimal.
constant RAW_C: str
    "#include <stdio.h>\n#include <string.h>\nstatic int hex(int c) { return c >= 'a' ? c - 'a' + 10 : c - '0'; }\nint main(int argc, char **argv) {\n    if (argc != 3) return 2;\n    FILE *f = fopen(argv[1], \"wb\");\n    if (f == NULL) return 3;\n    size_t n = strlen(argv[2]);\n    for (size_t i = 0; i + 1 < n; i += 2) {\n        if (fputc(hex(argv[2][i]) * 16 + hex(argv[2][i + 1]), f) == EOF) return 4;\n    }\n    return fclose(f) == 0 ? 0 : 5;\n}\n"

# The object git stores `text` as in `dir`, written there: its whole name.
function blob(dir: str, text: str) -> str?
    file = dir + "-blob.txt"
    write_file(path: file, text: text)?
    return answered(dir, words: ["hash-object", "-w", "--", "../" + last_part(file)])

# A commit of the tree `listed` names, each a mode, an object and a path in
# turn, with no file written, so a test makes a tree no checkout could hold:
# two names one where case is ignored, a link, a submodule, a name holding
# `:`, `\\` or a line end. Tagged `tag`; its whole name.
#
# **The tree object is written byte for byte** (`raw_file`, then `hash-object
# --literally`), its entries in git's order, never through the index: git for
# Windows refuses `z:drive` into an index whatever `core.protectNTFS` says
# (measured on the Windows box 2026-11-08, git 2.55.0, defect 2361), and the
# test then died at its fixture where it means to judge that a repository
# made elsewhere holding such a name is refused before any file is written.
function tree_commit(dir: str, listed: [str], tag: str) -> str?
    names: [str] @= []
    at: i64 @= 0

    while at + 2 < listed.len()
        names @ names.push(listed[at + 2])
        at @ at + 3

    # Each entry by its name in git's order, a file's name compared as bytes:
    # its mode, a space, its name, a zero and its object's twenty bytes.
    hex: [str] @= []

    for name in names.sort()
        one: i64 @= 0

        while one + 2 < listed.len()
            if listed[one + 2] == name
                hex @ hex.push(hex_of(listed[one] + " " + name) + "00" + listed[one + 1])
            one @ one + 3

    file = dir + "-tree.bin"
    raw_file(path: file, hex: hex.join(""))?
    tree = answered(dir, words: ["hash-object", "-t", "tree", "-w", "--literally", "--", "../" + last_part(file)])?
    commit = answered(dir, words: ["commit-tree", "-m", "made", tree])?
    git(dir, words: ["tag", "-f", "--", tag, commit])?
    return ok(commit)

# Each byte of `text` as two small hexadecimal digits.
function hex_of(text: str) -> str
    digits = "0123456789abcdef"
    out: [str] @= []
    at: i64 @= 0

    while at < text.len()
        b = to_i64(text[at]).must()
        out @ out.push(digits.slice(from: b / 16, to: b / 16 + 1) + digits.slice(from: b % 16, to: b % 16 + 1))
        at @ at + 1

    return out.join("")

# What git answers in `dir`, its line end taken off.
function answered(dir: str, words: [str]) -> str?
    out = dir + "-git-answer.txt"
    ran = process.run(
        program: "git",
        words: strings.with_all(list: settings(dir), more: words),
        out: out,
        err: process.discard()
    )

    if !ran.started || ran.code != 0
        return fail(code: "git", msg: "`git " + words.join(" ") + "` in " + dir + " failed")
    return ok(strings.trimmed(read_back.words(out).default("")))

function last_part(path: str) -> str
    return path.slice(from: last_slash(path) + 1, to: path.len())

function last_slash(path: str) -> i64
    at: i64 @= path.len() - 1

    while at > 0 && path[at] != '/'
        at @ at - 1

    return at
