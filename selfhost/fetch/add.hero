# `heroes add` (panel 235's R11 and R2, ratified 2026-11-07; design.md §3.5):
# one package added to the program's catalogue, `heroes.toml` in the
# program's folder, with every package of the build that minimal version
# selection reaches, each placed and with its sum (`fetch/build_list.hero`):
#
#     heroes add json                     the highest version the index lists
#     heroes add json@1.4.2               that version
#     heroes add <git address> --tag v1   a git source at a tag, its commit read
#     heroes add --path ../json           a folder of the author's own
#
# `--as <name>` names a git or folder entry where its last part will not do;
# an index package keeps the index's name, which is its identity (R3).
# `--index <address>` names the index a name is read from, written as the
# catalogue's `index` line where it has none and refused where it names
# another (R9's C4, the coordinator's ruling: the command line gives the
# index to `add` alone). `-C <folder>` is the program's folder, the current
# one by default.
#
# **Whom it trusts, written as such** (R6, the ffi-pragmatist's § 5): a first
# `add` from git trusts its source on first use, recording the commit its tag
# names and the sum of the tree there; one from the index trusts the index's
# sum. Every later fetch is held to what was written.

use cli/argv
use cli/io
use cli/process
use cli/publish
use cli/table as cli_table
use module/catalogue
use module/fingerprint
use module/placed
use module_text
use fetch/address
use fetch/build_list
use fetch/catalogue_edit
use fetch/git_source
use fetch/index_source
use fetch/made_index
use fetch/made_repo
use fetch/placing
use fetch/staging
use fetch/told
use fetch/transport
use fetch/verb_place

# The command: what changed and the file written on stdout, or the refusal
# on stderr, its exit its code's (`fetch/told.hero`).
function run(inv: argv.Invocation) -> cli_table.Exit
    match added(inv, tools: transport.path_tools())
        .ok lines =>
            for line in lines
                print(line)

            return .ok_exit
        .err e =>
            io.eprint(text: told.line(at: "", code: e.code, said: e.msg))

            if told.exit_of(e.code) == 1
                return .diagnostics_exit
            return .failed_exit

# What the program's catalogue becomes once `inv`'s package is added: the
# lines the command prints, every change and then the file written.
function added(inv: argv.Invocation, tools: transport.Tools) -> [str]?
    program = verb_place.program_of(inv)?
    c = catalogue.read(opened: program, named: program)

    if c.problem.len() > 0
        return fail(code: "catalogue_refused", msg: c.problem)
    line = index_line(inv, c: c)?
    held = catalogue.Catalogue(file: c.file, index: line, entries: c.entries, problem: "")
    scratch = staging.opened(program)?
    root = transport.root_of(tools, folder: verb_place.dot_if_empty(program), scratch: scratch.folder)
    picks = chosen(inv, tools: tools, program: program, root: root, c: held, scratch: scratch)
    staging.dropped(scratch)
    verb_place.unused_dropped(program)
    built = picks?
    written: str @= ""

    if c.index.len() == 0
        written @ line
    file = program + catalogue.FILE
    text = catalogue_edit.edited(text: read_file(file).default(""), entries: entries_of(built), index: written)
    published = publish.rewrite(path: file, text: text)

    if published.is_err()
        return fail(code: "cannot_place", msg: verb_place.why(published))
    lines: [str] @= changes(c, picks: built)
    lines @ lines.push("wrote " + file)
    return ok(lines)

# The index line the catalogue will hold: its own, or the one `--index`
# gives where it has none; refused where the two differ.
function index_line(inv: argv.Invocation, c: catalogue.Catalogue) -> str?
    given = argv.value_of(inv, spelling: "--index")

    if given.is_err()
        return ok(c.index)

    if c.index.len() > 0 && c.index != given.must()
        return fail(
            code: "bad_usage",
            msg: "the catalogue reads the index `" + c.index + "`, and `--index` names `" + given.must() + "`: a program reads one index, which its catalogue's `index` line names"
        )
    return ok(given.must())

# The build list once the package `inv` names is added.
function chosen(inv: argv.Invocation, tools: transport.Tools, program: str, root: address.Root?, c: catalogue.Catalogue, scratch: staging.Staging) -> [build_list.Pick]?
    at = root?
    wanted = wanted_entry(inv, tools: tools, program: program, root: at, c: c, scratch: scratch)?
    return build_list.chosen(tools, program: program, root: at, c: c, wanted: wanted)

# The entry `inv` asks for, placed where it is fetched.
function wanted_entry(inv: argv.Invocation, tools: transport.Tools, program: str, root: address.Root, c: catalogue.Catalogue, scratch: staging.Staging) -> catalogue.Entry?
    folder = argv.value_of(inv, spelling: "--path")

    if !folder.is_err()
        return folder_entry(inv, program: program, folder: folder.must())

    if inv.file.is_err()
        return fail(
            code: "bad_usage",
            msg: "`add` needs a package: a name from the index, `heroes add json`; a git address at a tag, `heroes add https://git.example.org/ana/json --tag v1.0.0`; or a folder, `heroes add --path ../json`"
        )
    asked = inv.file.must()

    if looks_addressed(asked)
        return git_entry(inv, tools: tools, address_text: asked, program: program, root: root, c: c)
    return index_entry(inv, tools: tools, asked: asked, program: program, root: root, c: c, scratch: scratch)

# A folder of the author's own, read where it stands (R6).
function folder_entry(inv: argv.Invocation, program: str, folder: str) -> catalogue.Entry?
    if !inv.file.is_err() || argv.has(inv, spelling: "--tag") || argv.has(inv, spelling: "--index")
        return fail(
            code: "bad_usage",
            msg: "`--path` names the package's folder, so `add` takes no package, `--tag` or `--index` beside it"
        )
    name = argv.value_of(inv, spelling: "--as").default(last_part(folder))

    if !catalogue.entry_name(name)
        return fail(
            code: "bad_usage",
            msg: "`" + name + "` is no entry's name: a name is lowercase letters, digits and `_`, starting with a letter; give one with `--as`"
        )

    if !process.is_directory(program + folder)
        return fail(code: "absent", msg: "there is no folder `" + program + folder + "`")
    return ok(catalogue.Entry(name: name, version: "", git: "", tag: "", commit: "", path: folder, sum: ""))

# A git source at a tag: its commit asked, its tree fetched and placed, and
# its sum the tree's, trusted on first use.
function git_entry(inv: argv.Invocation, tools: transport.Tools, address_text: str, program: str, root: address.Root, c: catalogue.Catalogue) -> catalogue.Entry?
    tag = argv.value_of(inv, spelling: "--tag")

    if tag.is_err()
        return fail(
            code: "bad_usage",
            msg: "a git source is added at a tag: `heroes add " + address_text + " --tag v1.0.0`"
        )

    if argv.has(inv, spelling: "--index")
        return fail(
            code: "bad_usage",
            msg: "`--index` names where a package is read by its name, and a git address names its own source"
        )
    at = address.judged(address_text, root: root)?
    name = argv.value_of(inv, spelling: "--as").default(module_text.address_entry(address_text))

    if !catalogue.entry_name(name)
        return fail(
            code: "bad_usage",
            msg: "`" + address_text + "` ends in no entry's name: give one with `--as`, lowercase letters, digits and `_`, starting with a letter"
        )
    s = staging.opened(program)?
    commit = transport.tag_commit(tools, source: at, tag: tag.must(), scratch: s.folder)
    first = catalogue.Entry(
        name: name,
        version: "",
        git: address_text,
        tag: tag.must(),
        commit: commit.default(""),
        path: "",
        sum: ""
    )
    done: ()? @= verb_place.unit_of(commit)

    if !done.is_err()
        done @ git_source.written(tools, e: first, root: root, s: s)

    if done.is_err()
        staging.dropped(s)
        return fail(code: verb_place.code_of(done), msg: verb_place.why(done))
    sum = fingerprint.of(s.tree)

    if sum.is_err()
        staging.dropped(s)
        return fail(code: "cannot_place", msg: verb_place.reason(sum))
    e = catalogue.Entry(
        name: name,
        version: "",
        git: address_text,
        tag: tag.must(),
        commit: commit.must(),
        path: "",
        sum: sum.must()
    )
    _ = staging.placed(s, program: program, key: placed.key(e, index: c.index), sum: e.sum, what: "the tree of `" + name + "`")?
    return ok(e)

# A name from the index, at the version written or the highest it lists, its
# sum the index's.
function index_entry(inv: argv.Invocation, tools: transport.Tools, asked: str, program: str, root: address.Root, c: catalogue.Catalogue, scratch: staging.Staging) -> catalogue.Entry?
    if argv.has(inv, spelling: "--tag") || argv.has(inv, spelling: "--as")
        return fail(
            code: "bad_usage",
            msg: "a package from the index keeps the index's name and has no tag: `heroes add json` or `heroes add json@1.4.2`"
        )
    at_sign = verb_place.at_of(asked)
    name = asked.slice(from: 0, to: at_sign)

    if !catalogue.entry_name(name)
        return fail(
            code: "bad_usage",
            msg: "`" + name + "` is no package's name: a name is lowercase letters, digits and `_`, starting with a letter"
        )
    index = address.judged(index_source.written_index(c.index), root: root)?
    listed = index_source.versions(tools, index: index, name: name, scratch: scratch.folder)?
    pick = verb_place.version_picked(listed, asked: asked, at: at_sign, index: index.written)?
    e = catalogue.Entry(name: name, version: pick.version, git: "", tag: "", commit: "", path: "", sum: pick.sum)
    _ = index_source.fetched(tools, e: e, program: program, root: root, index: c.index)?
    return ok(e)

# Whether the operand is an address rather than a name: a scheme, git's
# `user@host:path`, or a path, each of which `fetch/address.hero` judges.
function looks_addressed(asked: str) -> bool
    for at in range(from: 0, to: asked.len())
        if asked[at] == ':' || asked[at] == '/' || asked[at] == '\\'
            return true

    return false

function last_part(folder: str) -> str
    end: i64 @= folder.len()

    while end > 0 && folder[end - 1] == '/'
        end @ end - 1

    at: i64 @= end

    while at > 0 && folder[at - 1] != '/'
        at @ at - 1

    return folder.slice(from: at, to: end)

function entries_of(picks: [build_list.Pick]) -> [catalogue.Entry]
    out: [catalogue.Entry] @= []

    for one in picks
        out @ out.push(one.entry)

    return out

# What moved, a line each in the order of the names: an entry added, or one
# whose version moved.
function changes(c: catalogue.Catalogue, picks: [build_list.Pick]) -> [str]
    out: [str] @= []

    for name in sort(names_of(picks))
        for one in picks
            if one.entry.name == name
                was = catalogue.entry(c, name: name)
                now = placing.at_said(one.entry)

                if was.is_err()
                    out @ out.push("added " + name + " " + now + for_said(one))
                else if placing.at_said(was.must()) != now || was.must().sum != one.entry.sum
                    out @ out.push("changed " + name + " " + placing.at_said(was.must()) + " -> " + now + for_said(one))

    return out

function for_said(one: build_list.Pick) -> str
    if one.for_whom.len() == 0
        return ""
    return " for " + one.for_whom

function names_of(picks: [build_list.Pick]) -> [str]
    out: [str] @= []

    for one in picks
        out @ out.push(one.entry.name)

    return out

## Tests

# The scratch these cases share: a repository standing for the program's
# own, `app/` its folder, an index `idx/` and a git source `src/` beside it.
constant SCRATCH: str
    "build/selftest-fetch-add"

# The sums an index publishes: `strings` 1.0.0 and 1.1.0, and `json` 1.0.0
# and 2.0.0, each `json` naming in its own catalogue the `strings` it needs.
record Index
    strings_1: str
    strings_2: str
    json_1: str
    json_2: str

function index_made() -> Index
    made_repo.made(SCRATCH).must()
    process.mkdir_all(SCRATCH + "/app").must()
    idx = SCRATCH + "/idx"
    s1 = made_index.published(
        idx: idx,
        name: "strings",
        version: "1.0.0",
        files: ["cut.hero", "function cut() -> i64\n    return 1\n"],
        raw: []
    ).must()
    s2 = made_index.published(
        idx: idx,
        name: "strings",
        version: "1.1.0",
        files: ["cut.hero", "function cut() -> i64\n    return 2\n"],
        raw: []
    ).must()
    j1 = made_index.published(
        idx: idx,
        name: "json",
        version: "1.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 1\n", "heroes.toml", needs(version: "1.0.0", sum: s1)],
        raw: []
    ).must()
    j2 = made_index.published(
        idx: idx,
        name: "json",
        version: "2.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 2\n", "heroes.toml", needs(version: "1.1.0", sum: s2)],
        raw: []
    ).must()
    return Index(strings_1: s1, strings_2: s2, json_1: j1, json_2: j2)

# A package's own catalogue needing `strings` at `version`.
function needs(version: str, sum: str) -> str
    return "index = \"file://../idx\"\n\n[dependencies.strings]\nversion = \"" + version + "\"\nsum = \"" + sum + "\"\n"

function invoked(words: [str]) -> argv.Invocation
    return argv.parse(words, dir_probe: process.is_directory).must()

test "a name from the index is added at its version with every package it needs, and the catalogue is written byte for byte"
    m = index_made()
    lines = added(
        invoked(["add", "json@1.0.0", "-C", SCRATCH + "/app", "--index", "file://../idx"]),
        tools: transport.path_tools()
    ).must()
    assert lines == ["added json 1.0.0", "added strings 1.0.0 for json", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert read_file(SCRATCH + "/app/heroes.toml").must() == "index = \"file://../idx\"\n\n[dependencies.json]\nversion = \"1.0.0\"\nsum = \"" + m.json_1 + "\"\n\n" + "[dependencies.strings]\nversion = \"1.0.0\"\nsum = \"" + m.strings_1 + "\"\n"
    json = catalogue.Entry(name: "json", version: "1.0.0", git: "", tag: "", commit: "", path: "", sum: m.json_1)
    assert fingerprint.of(SCRATCH + "/app/heroes.packages/" + placed.key(json, index: "file://../idx")).must() == m.json_1

    # The highest version, and the `strings` it needs raised with it (MVS).
    again = added(invoked(["add", "json", "-C", SCRATCH + "/app"]), tools: transport.path_tools()).must()
    assert again == ["changed json 1.0.0 -> 2.0.0", "changed strings 1.0.0 -> 1.1.0 for json", "wrote " + SCRATCH + "/app/heroes.toml"]

    # The program's own version lowered below what `json` needs stays where
    # `json` needs it: the program's is at least each dependency's.
    held = added(invoked(["add", "strings@1.0.0", "-C", SCRATCH + "/app"]), tools: transport.path_tools()).must()
    assert held == ["wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "strings").must().version == "1.1.0"
    assert !process.remove_tree(SCRATCH).is_err()

test "a version the program holds above a dependency's need stays, and a git source and a folder are added as entries"
    m = index_made()
    _ = added(
        invoked(["add", "strings@1.1.0", "-C", SCRATCH + "/app", "--index", "file://../idx"]),
        tools: transport.path_tools()
    ).must()
    assert added(invoked(["add", "json@1.0.0", "-C", SCRATCH + "/app"]), tools: transport.path_tools()).must() == ["added json 1.0.0", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "strings").must().sum == m.strings_2

    made_repo.made(SCRATCH + "/src").must()
    _ = made_repo.committed(
        dir: SCRATCH + "/src",
        files: ["lib.hero", "function y() -> i64\n    return 3\n"],
        message: "one"
    ).must()
    made_repo.tagged(dir: SCRATCH + "/src", tag: "v0.3.1", annotated: true).must()
    commit = made_repo.head(SCRATCH + "/src").must()
    assert added(invoked(["add", "file://../src", "--tag", "v0.3.1", "--as", "yaml", "-C", SCRATCH + "/app"]), tools: transport.path_tools()).must() == ["added yaml v0.3.1", "wrote " + SCRATCH + "/app/heroes.toml"]
    yaml = catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "yaml").must()
    assert yaml.commit == commit && yaml.git == "file://../src" && yaml.tag == "v0.3.1"
    assert yaml.sum == fingerprint.of(SCRATCH + "/app/heroes.packages/" + placed.key(yaml, index: "file://../idx")).must()

    assert !process.mkdir_all(SCRATCH + "/local").is_err()
    assert added(invoked(["add", "--path", "../local", "-C", SCRATCH + "/app"]), tools: transport.path_tools()).must() == ["added local ../local", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.read(opened: SCRATCH + "/app/", named: "").problem == ""
    assert !process.remove_tree(SCRATCH).is_err()

test "an add that cannot be is refused with its code, and the catalogue is left as it was"
    _ = index_made()
    refusals = [
        [["add", "-C", SCRATCH + "/app"], ["bad_usage"]]
        [["add", "json", "--tag", "v1", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["bad_usage"]]
        [["add", "Json", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["bad_usage"]]
        [["add", "yaml", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["absent"]]
        [["add", "json@9.9.9", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["absent"]]
        [["add", "file://../src", "-C", SCRATCH + "/app"], ["bad_usage"]]
        [["add", "http://git.example.org/x", "--tag", "v1", "-C", SCRATCH + "/app"], ["source_refused"]]
        [["add", "--path", "../none", "-C", SCRATCH + "/app"], ["absent"]]
    ]

    for one in refusals
        match added(invoked(one[0]), tools: transport.path_tools())
            .ok _  => assert false
            .err e => assert e.code == one[1][0]

    assert !process.path_exists(SCRATCH + "/app/heroes.toml")
    assert !process.path_exists(SCRATCH + "/app/heroes.packages")

    # A catalogue that does not read is told, and left as it was.
    assert !write_file(path: SCRATCH + "/app/heroes.toml", text: "version = 1\n").is_err()

    match added(invoked(["add", "json", "-C", SCRATCH + "/app", "--index", "file://../idx"]), tools: transport.path_tools())
        .ok _  => assert false
        .err e => assert e.code == "catalogue_refused"

    assert read_file(SCRATCH + "/app/heroes.toml").must() == "version = 1\n"
    assert !process.remove_tree(SCRATCH).is_err()
