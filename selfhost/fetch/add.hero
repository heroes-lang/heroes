# `heroes add` (panel 235's R11 and R2, ratified 2026-11-07; design.md §3.5):
# one package added to the program's catalogue, `heroes.toml` in the
# program's folder, with every package of the build that minimal version
# selection reaches, each placed and with its sum (`fetch/build_list.hero`):
#
#     heroes add json                     the highest version the index lists
#     heroes add json@1.4.2               that version
#     heroes add <git address> --tag v1   a git source at a tag, its commit read
#     heroes add --path ../json           a folder of the author's own
#
# `--as <name>` names a git or folder entry where its last part will not do;
# an index package keeps the index's name, which is its identity (R3).
# `--index <address>` names the index a name is read from, written as the
# catalogue's `index` line where it has none and refused where it names
# another (R9's C4, the coordinator's ruling: the command line gives the
# index to `add` alone). `-C <folder>` is the program's folder, the current
# one by default.
#
# **Whom it trusts, written as such** (R6, the ffi-pragmatist's § 5): a first
# `add` from git trusts its source on first use, recording the commit its tag
# names and the sum of the tree there; one from the index trusts the index's
# sum. Every later fetch is held to what was written.
#
# What the command line asks for is made an entry, and fetched, in
# `fetch/add_wanted.hero`; this module reads the program's catalogue, walks
# the build list from it and writes the catalogue back.

use cli/argv
use cli/files
use cli/process
use cli/publish
use cli/strings
use cli/table as cli_table
use fetch/add_wanted
use fetch/address_form
use fetch/build_list
use fetch/catalogue_edit
use fetch/git_source
use fetch/leftover
use fetch/made_index
use fetch/made_repo
use fetch/placing
use fetch/staging
use fetch/told
use fetch/transport
use fetch/verb_place
use module/catalogue
use module/fingerprint
use module/placed

# The command: what changed and the file written on stdout, or the refusal
# on stderr, its exit its code's (`fetch/told.hero`).
function run(inv: argv.Invocation) -> cli_table.Exit
    return told.spoken(outcome(inv, tools: transport.path_tools()))

# What `heroes add` says for `inv`: every change and then the file written,
# or the refusal that stopped it. The program's catalogue is read once, here,
# and one that does not read is told at its place, as `heroes fetch` tells it
# (defect 2433: its place stood inside its words).
function outcome(inv: argv.Invocation, tools: transport.Tools) -> [told.Said]
    program = verb_place.program_of(inv)

    if program.is_err()
        return [told.refused(failure: verb_place.unit_of(program), at: "")]
    c = catalogue.read(opened: program.must(), named: program.must())

    if c.problem.len() > 0
        return [told.of_catalogue(c)]
    out: [told.Said] @= []

    match added(inv, tools: tools, program: program.must(), c: c)
        .ok lines =>
            for line in lines
                out @ out.push(told.Said(code: "", at: "", said: line))
        .err e => out @ out.push(told.Said(code: e.code, at: "", said: e.msg))

    return out

# What the catalogue `c` of the program whose folder is `program` becomes
# once `inv`'s package is added: the lines the command prints, every change
# and then the file written.
#
# **All or nothing** (defect 2434): every tree the run places is written into
# its ledger, and a refusal at any step after one is placed, the catalogue's
# own write among them, takes back what the run placed (`fetch/staging.hero`),
# so a refused `add` leaves the program's folder as it found it; a tree it
# found placed is never replaced (defect 2493). Until then it left each tree
# it had placed, which no catalogue named. What a killed run left is undone
# first, before any placed tree is asked (defect 2453, `fetch/leftover.hero`).
function added(inv: argv.Invocation, tools: transport.Tools, program: str, c: catalogue.Catalogue) -> [str]?
    line = index_line(inv, c: c)?
    leftover.recovered(program)
    ledger: staging.Ledger @= staging.begun(program)?

    match placed_and_written(@ledger, inv, tools: tools, program: program, c: c, line: line)
        .ok lines =>
            staging.ended(@ledger)
            return ok(lines)
        .err e =>
            left = staging.undone(@ledger)

            if left.len() == 0
                return fail(code: e.code, msg: e.msg)
            return fail(code: e.code, msg: e.msg + "; and what this run placed could not all be taken back: " + left)

# The build list walked, each tree placed into the run's `ledger`, and the
# catalogue written: the lines the command prints.
function placed_and_written(@ledger: staging.Ledger, inv: argv.Invocation, tools: transport.Tools, program: str, c: catalogue.Catalogue, line: str) -> [str]?
    held = catalogue.Catalogue(file: c.file, index: line, entries: c.entries, problem: "", code: "", at: "", said: "")
    root = transport.root_of(tools, folder: verb_place.dot_if_empty(program), scratch: ledger.folder)?
    wanted = add_wanted.entry_of(@ledger, inv, tools: tools, program: program, root: root, c: held)?
    built = build_list.chosen(@ledger, tools, program: program, root: root, c: held, wanted: wanted)?
    written: str @= ""

    if c.index.len() == 0
        written @ line
    file = program + catalogue.FILE
    text = catalogue_edit.edited(text: read_file(file).default(""), entries: entries_of(built), index: written)
    published = publish.rewrite(path: file, text: text)

    if published.is_err()
        return fail(code: "cannot_place", msg: verb_place.why(published))
    lines: [str] @= changes(c, picks: built)
    lines @ lines.push("wrote " + file)
    return ok(lines)

# The index line the catalogue will hold: its own, or the one `--index`
# gives where it has none; refused where the two name two indexes, each read
# in its one form (defect 2455: `file://./../idx` beside a line reading
# `file://../idx` was refused as another index), the line kept as written.
function index_line(inv: argv.Invocation, c: catalogue.Catalogue) -> str?
    given = argv.value_of(inv, spelling: "--index")

    if given.is_err()
        return ok(c.index)

    if c.index.len() > 0 && address_form.canonical(c.index) == address_form.canonical(given.must())
        return ok(c.index)

    if c.index.len() > 0
        return fail(
            code: "bad_usage",
            msg: "the catalogue reads the index `" + c.index + "`, and `--index` names `" + given.must() + "`: a program reads one index, which its catalogue's `index` line names"
        )
    return ok(given.must())

function entries_of(picks: [build_list.Pick]) -> [catalogue.Entry]
    out: [catalogue.Entry] @= []

    for one in picks
        out @ out.push(one.entry)

    return out

# What moved, a line each in the order of the names: an entry added, or one
# whose version moved.
function changes(c: catalogue.Catalogue, picks: [build_list.Pick]) -> [str]
    out: [str] @= []

    for name in sort(names_of(picks))
        for one in picks
            if one.entry.name == name
                was = catalogue.entry(c, name: name)
                now = placing.at_said(one.entry)

                if was.is_err()
                    out @ out.push("added " + name + " " + now + for_said(one))
                else if placing.at_said(was.must()) != now || was.must().sum != one.entry.sum
                    out @ out.push("changed " + name + " " + placing.at_said(was.must()) + " -> " + now + for_said(one))

    return out

function for_said(one: build_list.Pick) -> str
    if one.for_whom.len() == 0
        return ""
    return " for " + one.for_whom

function names_of(picks: [build_list.Pick]) -> [str]
    out: [str] @= []

    for one in picks
        out @ out.push(one.entry.name)

    return out

## Tests

# The scratch these cases share: a repository standing for the program's
# own, `app/` its folder, an index `idx/` and a git source `src/` beside it.
constant SCRATCH: str
    "build/selftest-fetch-add"

# The sums an index publishes: `strings` 1.0.0 and 1.1.0, and `json` 1.0.0
# and 2.0.0, each `json` naming in its own catalogue the `strings` it needs.
record Index
    strings_1: str
    strings_2: str
    json_1: str
    json_2: str

function index_made() -> Index
    made_repo.made(SCRATCH).must()
    process.mkdir_all(SCRATCH + "/app").must()
    idx = SCRATCH + "/idx"
    s1 = made_index.published(
        idx: idx,
        name: "strings",
        version: "1.0.0",
        files: ["cut.hero", "function cut() -> i64\n    return 1\n"],
        raw: []
    ).must()
    s2 = made_index.published(
        idx: idx,
        name: "strings",
        version: "1.1.0",
        files: ["cut.hero", "function cut() -> i64\n    return 2\n"],
        raw: []
    ).must()
    j1 = made_index.published(
        idx: idx,
        name: "json",
        version: "1.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 1\n", "heroes.toml", needs(version: "1.0.0", sum: s1)],
        raw: []
    ).must()
    j2 = made_index.published(
        idx: idx,
        name: "json",
        version: "2.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 2\n", "heroes.toml", needs(version: "1.1.0", sum: s2)],
        raw: []
    ).must()
    return Index(strings_1: s1, strings_2: s2, json_1: j1, json_2: j2)

# A package's own catalogue needing `strings` at `version`.
function needs(version: str, sum: str) -> str
    return "index = \"file://../idx\"\n\n[dependencies.strings]\nversion = \"" + version + "\"\nsum = \"" + sum + "\"\n"

function invoked(words: [str]) -> argv.Invocation
    return argv.parse(words, dir_probe: process.is_directory).must()

# What `heroes add` with `words` says, a line each as the author reads it, a
# refusal's place first.
function said(words: [str], tools: transport.Tools) -> [str]
    out: [str] @= []

    for one in outcome(invoked(words), tools: tools)
        if one.code.len() == 0
            out @ out.push(one.said)
        else
            out @ out.push(told.line(at: one.at, code: one.code, said: one.said))

    return out

# The code of the one refusal `heroes add` with `words` gives, "" where it
# gives none or more than one.
function refused_code(words: [str], tools: transport.Tools) -> str
    got = outcome(invoked(words), tools: tools)

    if got.len() != 1
        return ""
    return got[0].code

test "a name from the index is added at its version with every package it needs, and the catalogue is written byte for byte"
    m = index_made()
    lines = said(
        ["add", "json@1.0.0", "-C", SCRATCH + "/app", "--index", "file://../idx"],
        tools: transport.path_tools()
    )
    assert lines == ["added json 1.0.0", "added strings 1.0.0 for json", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert read_file(SCRATCH + "/app/heroes.toml").must() == "index = \"file://../idx\"\n\n[dependencies.json]\nversion = \"1.0.0\"\nsum = \"" + m.json_1 + "\"\n\n" + "[dependencies.strings]\nversion = \"1.0.0\"\nsum = \"" + m.strings_1 + "\"\n"
    json = catalogue.Entry(name: "json", version: "1.0.0", git: "", tag: "", commit: "", path: "", sum: m.json_1)
    assert fingerprint.of(SCRATCH + "/app/heroes.packages/" + placed.key(json, index: "file://../idx")).must() == m.json_1

    # The highest version, and the `strings` it needs raised with it (MVS).
    again = said(["add", "json", "-C", SCRATCH + "/app"], tools: transport.path_tools())
    assert again == ["changed json 1.0.0 -> 2.0.0", "changed strings 1.0.0 -> 1.1.0 for json", "wrote " + SCRATCH + "/app/heroes.toml"]

    # The program's own version lowered below what `json` needs stays where
    # `json` needs it: the program's is at least each dependency's.
    held = said(["add", "strings@1.0.0", "-C", SCRATCH + "/app"], tools: transport.path_tools())
    assert held == ["wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "strings").must().version == "1.1.0"
    assert !process.remove_tree(SCRATCH).is_err()

test "a version the program holds above a dependency's need stays, and a git source and a folder are added as entries"
    m = index_made()
    assert said(["add", "strings@1.1.0", "-C", SCRATCH + "/app", "--index", "file://../idx"], tools: transport.path_tools()) == ["added strings 1.1.0", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert said(["add", "json@1.0.0", "-C", SCRATCH + "/app"], tools: transport.path_tools()) == ["added json 1.0.0", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "strings").must().sum == m.strings_2

    made_repo.made(SCRATCH + "/src").must()
    _ = made_repo.committed(
        dir: SCRATCH + "/src",
        files: ["lib.hero", "function y() -> i64\n    return 3\n"],
        message: "one"
    ).must()
    made_repo.tagged(dir: SCRATCH + "/src", tag: "v0.3.1", annotated: true).must()
    commit = made_repo.head(SCRATCH + "/src").must()
    assert said(["add", "file://../src", "--tag", "v0.3.1", "--as", "yaml", "-C", SCRATCH + "/app"], tools: transport.path_tools()) == ["added yaml v0.3.1", "wrote " + SCRATCH + "/app/heroes.toml"]
    yaml = catalogue.entry(catalogue.read(opened: SCRATCH + "/app/", named: ""), name: "yaml").must()
    assert yaml.commit == commit && yaml.git == "file://../src" && yaml.tag == "v0.3.1"
    assert yaml.sum == fingerprint.of(SCRATCH + "/app/heroes.packages/" + placed.key(yaml, index: "file://../idx")).must()

    assert !process.mkdir_all(SCRATCH + "/local").is_err()
    assert said(["add", "--path", "../local", "-C", SCRATCH + "/app"], tools: transport.path_tools()) == ["added local ../local", "wrote " + SCRATCH + "/app/heroes.toml"]
    assert catalogue.read(opened: SCRATCH + "/app/", named: "").problem == ""
    assert !process.remove_tree(SCRATCH).is_err()

test "an add that cannot be is refused with its code, and the catalogue is left as it was"
    _ = index_made()
    refusals = [
        [["add", "-C", SCRATCH + "/app"], ["bad_usage"]]
        [["add", "json", "--tag", "v1", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["bad_usage"]]
        [["add", "Json", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["bad_usage"]]
        [["add", "yaml", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["absent"]]
        [["add", "json@9.9.9", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["absent"]]
        [["add", "file://../src", "-C", SCRATCH + "/app"], ["bad_usage"]]
        [["add", "http://git.example.org/x", "--tag", "v1", "-C", SCRATCH + "/app"], ["source_refused"]]
        [["add", "--path", "../none", "-C", SCRATCH + "/app"], ["absent"]]
    ]

    for one in refusals
        assert refused_code(one[0], tools: transport.path_tools()) == one[1][0]

    assert !process.path_exists(SCRATCH + "/app/heroes.toml")
    assert !process.path_exists(SCRATCH + "/app/heroes.packages")

    # A catalogue that does not read is told at its line, first, as `heroes
    # fetch` tells it (defect 2433), and left as it was.
    assert !write_file(path: SCRATCH + "/app/heroes.toml", text: "version = 1\n").is_err()
    told_line = said(["add", "json", "-C", SCRATCH + "/app", "--index", "file://../idx"], tools: transport.path_tools())
    assert told_line == [SCRATCH + "/app/heroes.toml:1: error[catalogue_refused]: a value is a string between double quotes: `version = \"1.4.2\"`"]
    assert read_file(SCRATCH + "/app/heroes.toml").must() == "version = 1\n"

    # One that cannot be read at all has no place, and its words name it.
    assert !process.remove_tree(SCRATCH + "/app/heroes.toml").is_err()
    assert !process.mkdir_all(SCRATCH + "/app/heroes.toml").is_err()
    unread = outcome(invoked(["add", "json", "-C", SCRATCH + "/app"]), tools: transport.path_tools())
    assert unread.len() == 1 && unread[0].code == "catalogue_refused" && unread[0].at == ""
    assert strings.starts_with(text: unread[0].said, prefix: "`" + SCRATCH + "/app/heroes.toml` cannot be read: ")
    assert !process.remove_tree(SCRATCH).is_err()

# Defect 2392: the refusals a machine's state causes, each the tool's at exit
# 2 and none reaching the network: a curl this machine cannot start, a source
# on a closed port of this machine, a placement folder that is a file, and git
# failing on the staging folder's own repository, here one never made. Port 1
# of the loopback is closed on every machine the tests run on, tcpmux being
# served by none: were anything to answer there, the second refusal would not
# be `unreachable`, and this test fails naming it.
test "a refusal the machine causes is the tool's at exit 2, and the catalogue is left as it was"
    _ = index_made()
    no_curl = transport.Tools(git: "git", curl: "heroes-no-such-curl")
    shapes = [
        [["add", "json", "-C", SCRATCH + "/app", "--index", "file://../idx"], ["no_curl"]]
        [["add", "json", "-C", SCRATCH + "/app", "--index", "https://127.0.0.1:1/idx"], ["unreachable"]]
    ]

    for one in shapes
        tools: transport.Tools @= transport.path_tools()

        if one[1][0] == "no_curl"
            tools @ no_curl

        got = refused_code(one[0], tools: tools)
        assert got == one[1][0]
        assert told.exit_of(got) == 2

    assert !process.path_exists(SCRATCH + "/app/heroes.toml")
    s: staging.Staging @= staging.opened(SCRATCH + "/app/").must()

    match git_source.own(transport.path_tools(), words: ["--git-dir=" + s.folder + "/git", "rev-parse", "--verify", "-q", "refs/heroes/fetched^{commit}"], out: process.discard(), s: s)
        .ok _ => assert false
        .err e =>
            assert e.code == "git_failed"
            assert told.exit_of(e.code) == 2

    staging.dropped(@s)
    assert !process.remove_tree(SCRATCH + "/app/heroes.packages").is_err()

    # No tree can be staged under a placement folder that is a file.
    assert !write_file(path: SCRATCH + "/app/heroes.packages", text: "not a folder\n").is_err()

    filed = refused_code(
        ["add", "json", "-C", SCRATCH + "/app", "--index", "file://../idx"],
        tools: transport.path_tools()
    )
    assert filed == "cannot_place" && told.exit_of(filed) == 2

    assert read_file(SCRATCH + "/app/heroes.packages").must() == "not a folder\n"
    assert !process.path_exists(SCRATCH + "/app/heroes.toml")
    assert !process.remove_tree(SCRATCH).is_err()

# Defect 2434: a refused `add` takes back every tree it placed, whichever
# step refused it, and replaces none it found: a package's catalogue
# naming a folder, a second package refused once the first was placed, the
# catalogue's own write; and a `heroes.packages/` it found stays.
test "a refused add leaves the program's folder as it found it (defect 2434)"
    m = index_made()
    app = SCRATCH + "/app/"
    wrong = "sha256-" + "0".repeat(64.to_u64().must())
    _ = made_index.published(
        idx: SCRATCH + "/idx",
        name: "json",
        version: "3.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 3\n", "heroes.toml", "[dependencies.text]\npath = \"../text\"\n"],
        raw: []
    ).must()
    _ = made_index.published(
        idx: SCRATCH + "/idx",
        name: "json",
        version: "4.0.0",
        files: ["parse.hero", "function x() -> i64\n    return 4\n", "heroes.toml", needs(version: "1.0.0", sum: wrong)],
        raw: []
    ).must()
    _ = made_index.published(
        idx: SCRATCH + "/idx",
        name: "yaml",
        version: "1.0.0",
        files: ["y.hero", "function y() -> i64\n    return 1\n"],
        raw: []
    ).must()

    # Refused after `json` was placed: by its catalogue naming a folder, and
    # by the `strings` it needs, whose sum is not the index's.
    assert refused_code(["add", "json@3.0.0", "-C", app, "--index", "file://../idx"], tools: transport.path_tools()) == "requirement_refused"
    assert !process.path_exists(app + "heroes.packages") && !process.path_exists(app + "heroes.toml")
    assert refused_code(["add", "json@4.0.0", "-C", app, "--index", "file://../idx"], tools: transport.path_tools()) == "sum_mismatch"
    assert !process.path_exists(app + "heroes.packages") && !process.path_exists(app + "heroes.toml")

    # A `heroes.packages/` the run found, empty, is the author's and stays.
    assert !process.mkdir_all(app + "heroes.packages").is_err()
    assert refused_code(["add", "json@3.0.0", "-C", app, "--index", "file://../idx"], tools: transport.path_tools()) == "requirement_refused"
    assert process.is_directory(app + "heroes.packages")
    assert process.walk(app + "heroes.packages").must().files.len() == 0

    # The author's edit of a placed tree: walking the program's `json`, the
    # run is refused at that tree, which it never replaces (defect 2493), and
    # the edit stays; `yaml`, which it placed, goes, and the catalogue is as
    # it was.
    catalogue_text = "index = \"file://../idx\"\n\n[dependencies.strings]\nversion = \"1.0.0\"\nsum = \"" + wrong + "\"\n\n[dependencies.json]\nversion = \"1.0.0\"\nsum = \"" + m.json_1 + "\"\n"
    assert !write_file(path: app + "heroes.toml", text: catalogue_text).is_err()
    json = catalogue.Entry(name: "json", version: "1.0.0", git: "", tag: "", commit: "", path: "", sum: m.json_1)
    edited = app + "heroes.packages/" + placed.key(json, index: "file://../idx")
    assert !process.mkdir_all(edited).is_err()
    assert !write_file(path: edited + "/parse.hero", text: "edited by the author\n").is_err()
    assert refused_code(["add", "yaml@1.0.0", "-C", app], tools: transport.path_tools()) == "sum_mismatch"
    assert read_file(edited + "/parse.hero").must() == "edited by the author\n"
    assert process.walk(app + "heroes.packages").must().files == [edited + "/parse.hero"]
    assert read_file(app + "heroes.toml").must() == catalogue_text

    # The catalogue's own write refused, a second name standing for it, once
    # `json` and `strings` were placed: both go.
    assert !process.remove_tree(app + "heroes.packages").is_err()
    assert !write_file(path: app + "heroes.toml", text: "index = \"file://../idx\"\n").is_err()
    assert !files.second_name(existing: app + "heroes.toml", name: app + "also.toml").is_err()
    filed = refused_code(["add", "json@1.0.0", "-C", app], tools: transport.path_tools())
    assert filed == "cannot_place" && told.exit_of(filed) == 2
    assert !process.path_exists(app + "heroes.packages")
    assert read_file(app + "heroes.toml").must() == "index = \"file://../idx\"\n"
    assert !process.remove_tree(SCRATCH).is_err()
