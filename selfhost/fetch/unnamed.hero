# The trees `heroes add` leaves no entry of the catalogue naming (defect
# 2614): a version moved, `heroes add rebel` taking `rebel` from 0.1.0 to
# 0.1.1, a package raised with it by minimal version selection, a tag moved
# or an entry's source changed places the new tree under its own key
# (`module/placed.hero`), and the tree the old line named stayed beside it.
# It compiled nothing (`.claude/rules/cli-surface.md`'s falsifier: a fetched
# copy left behind after its entry is gone compiles nothing), and the
# program's folder kept every version it had ever held.
#
# **Once the catalogue is written, and only then**: each tree an entry of
# the catalogue as it was is placed under, at a key no entry of the
# catalogue as written names, is removed where it is the tree that was
# placed, a folder that sums to that entry's `sum` (the build's own test,
# `module/fingerprint.hero`, a part's through its kept listing), so what
# goes can be placed again from its source and nothing of the author's goes
# with it. It is moved into the run's own folder, one rename on one volume,
# and goes with that folder when the run ends (`staging.ended`); a run
# killed before then leaves it in a folder the next run removes
# (`fetch/leftover.hero`). A tree that no longer sums was changed since it
# was placed, and the change is the author's (panel 246's R2, defect 2493):
# it stays, and so does anything at the key that is not a folder, a link
# above all, which no verb places. The command says what went and what
# stayed, a line each, with how to keep or remove what stayed.
#
# **And what a hand edit left, at every run that placed its catalogue
# whole** (defect 2621): a `version` changed by hand in the catalogue, then
# `heroes fetch`, placed the new tree beside the old one, and no catalogue in
# hand named the old one, so it stood beside it for good. A run that placed
# every entry of its catalogue, `heroes fetch` refusing none or `heroes add`
# writing the catalogue, asks every name directly under `heroes.packages/`
# with a key's shape, `<name>@<version>-<sixteen digits>`, that no entry
# names (`swept`): a folder whose files sum to `S` is the index package its
# name writes, placed and unchanged, where the key of `<name>` at `<version>`
# from the catalogue's index at the sum `S` is its name again, and it goes,
# said as above. The key is the SHA-256 of every field that names the
# package, its sum among them (`placed.key`), so no name is taken on its
# word: one byte edited in the tree, or a name copied from another tree,
# gives another key. Every other name of that shape stays, said with why: a
# tree from git, whose key hashes a commit no name holds; one from an index
# the catalogue no longer reads; one changed since it was placed; anything
# that is not a folder. A name of no key's shape is no tree a verb placed (a
# run's own folder and its lock open with `.` and hold no `@`,
# `fetch/staging.hero`) and is not asked. **A run that refused an entry
# sweeps nothing**: a tree beside a key the catalogue names but nothing is
# placed under is what a build reads to say which line moved
# (`module/placed_beside.hero`), and the author is mid-edit; nor does `heroes
# add <entry>/<path>`, which places one entry and asks no other.

use cli/files
use cli/process
use fetch/placing
use fetch/staging
use module/catalogue
use module/entry_name
use module/fingerprint
use module/placed
use module/standing
use module/sums

# What a run says of the trees the entries of `before` were placed under
# and no entry of `after` names, the catalogue the run wrote: each removed,
# or kept with why, in the order of `before`'s entries. `program` is the
# program's folder ("" for the current one, or a path ending with `/`), and
# `run` the run's own folder (`staging.Ledger`'s), which takes what goes and
# is removed with it when the run ends. None where `after` does not read,
# which then names nothing a reader can trust.
function removed(program: str, run: str, before: catalogue.Catalogue, after: catalogue.Catalogue) -> [str]
    if after.problem.len() > 0 || after.file.len() == 0
        return []
    named: [str] @= []

    for e in after.entries
        if e.path.len() == 0
            named @ named.push(placed.key(e, index: after.index))

    out: [str] @= []

    for e in before.entries
        if e.path.len() == 0
            key = placed.key(e, index: before.index)

            if !held(named, key: key)
                told = said_of(program: program, run: run, e: e, key: key, serial: out.len())

                if told.len() > 0
                    out @ out.push(told)

    return out

# What is said of the tree the entry `e` was placed under, at `key`, which
# no entry names now: "" where nothing stands there; the `serial`th line the
# run says of such trees, which names its place in the run's folder.
function said_of(program: str, run: str, e: catalogue.Entry, key: str, serial: i64) -> str
    at = program + staging.PLACED + "/" + key
    stands = standing.at(at)

    if stands == .nothing
        return ""
    kept = "kept " + at + ", which no entry names now: "
    keep = "; move it out of `" + staging.PLACED + "/` to keep it, or remove it"

    if stands != .tree
        return kept + standing.said(stands, path: at) + " stands there, which no verb places, so it is yours" + keep

    if fingerprint.of(at).default("") != e.sum
        return kept + "it was changed since `" + e.name + "` " + placing.at_said(e) + " was placed there, and the change is yours" + keep
    moved = process.rename_over(from: at, to: run + "/unnamed-" + serial.to_str())

    if moved.is_err()
        return kept + "it cannot be moved away: " + staging.why(moved)
    return "removed " + e.name + " " + placing.at_said(e) + " " + at + ", which no entry names now"

function held(named: [str], key: str) -> bool
    for each in named
        if each == key
            return true

    return false

# The keys the entries of `c` are placed under, a `path` entry's none.
function keys_of(c: catalogue.Catalogue) -> [str]
    out: [str] @= []

    for e in c.entries
        if e.path.len() == 0
            out @ out.push(placed.key(e, index: c.index))

    return out

## What a hand edit left (defect 2621)

# What a run that placed every entry of `c`, the catalogue as it stands once
# the run is done, says of each name under `heroes.packages/` with a key's
# shape that no entry of `c` names and no key of `judged` is (those this run
# has already said of, `removed`'s): each tree removed, or kept with why, in
# the order of their names. `program` and `run` as `removed` takes them.
# None where `c` does not read.
function swept(program: str, run: str, c: catalogue.Catalogue, judged: [str]) -> [str]
    home = program + staging.PLACED

    if c.problem.len() > 0 || c.file.len() == 0 || !process.is_directory(home)
        return []
    named: [str] @= keys_of(c)

    for key in judged
        named @ named.push(key)

    out: [str] @= []

    for name in sort(files.every_name_in(home))
        if key_shaped(name) && !held(named, key: name)
            out @ out.push(swept_one(at: home + "/" + name, run: run, c: c, name: name, serial: out.len()))

    return out

# What is said of `name`, standing at `at`, which no entry names: removed
# where it is the index package its name writes, placed and unchanged, the
# `serial`th such line naming its place in the run's folder; else kept, with
# why.
function swept_one(at: str, run: str, c: catalogue.Catalogue, name: str, serial: i64) -> str
    stands = standing.at(at)
    kept = "kept " + at + ", which no entry names now: "
    keep = "; move it out of `" + staging.PLACED + "/` to keep it, or remove it"

    if stands != .tree
        return kept + standing.said(stands, path: at) + " stands there, which no verb places, so it is yours" + keep
    e = written_version(name: name, sum: fingerprint.of(at).default(""))

    if e.name.len() == 0
        return kept + "its name holds no version of the catalogue's index, and the key of a tree placed from git hashes a commit no name holds, so nothing says it can be placed again" + keep

    if placed.key(e, index: c.index) != name
        return kept + "its files do not sum to `" + e.name + "` " + e.version + " of the catalogue's index as its name says it was placed, so it was changed since or placed from another source, and nothing says it can be placed again" + keep
    moved = process.rename_over(from: at, to: run + "/swept-" + serial.to_str())

    if moved.is_err()
        return kept + "it cannot be moved away: " + staging.why(moved)
    return "removed " + e.name + " " + e.version + " " + at + ", which no entry names now"

# How many hexadecimal digits close a key (`placed.keyed`).
constant DIGITS: i64
    16

# The index package a key's name writes, `<name>@<version>-<digits>`, at the
# sum `sum`; an entry with no name where the part before `@` is no entry's
# name or the part after it no version, a git tree's tag among them.
function written_version(name: str, sum: str) -> catalogue.Entry
    none = catalogue.Entry(name: "", version: "", git: "", tag: "", commit: "", path: "", sum: "")
    head = name.slice(from: 0, to: name.len() - DIGITS - 1)
    at: i64 @= 0

    while at < head.len() && head[at] != '@'
        at @ at + 1

    if at >= head.len()
        return none
    written = head.slice(from: 0, to: at)
    version = head.slice(from: at + 1, to: head.len())

    if entry_name.refused(written).len() > 0 || !sums.version_shape(version)
        return none
    return catalogue.Entry(name: written, version: version, git: "", tag: "", commit: "", path: "", sum: sum)

# Whether `name` has a key's shape: a first part, `@`, a second, `-` and
# sixteen lowercase hexadecimal digits. A run's own folder and its lock open
# with `.` and hold no `@` (`fetch/staging.hero`), so neither has it.
function key_shaped(name: str) -> bool
    if name.len() < DIGITS + 4 || name[0] == '.' || name[name.len() - DIGITS - 1] != '-'
        return false

    for at in range(from: name.len() - DIGITS, to: name.len())
        b = name[at]

        if !(b >= '0' && b <= '9' || b >= 'a' && b <= 'f')
            return false

    for at in range(from: 1, to: name.len() - DIGITS - 2)
        if name[at] == '@'
            return true

    return false

## Tests

# A program's folder under `build/`, two versions of `kit` placed by hand as
# `heroes fetch` places them, and the catalogue moving from the first to the
# second: the first goes with the run's folder, the second stays; an edited
# tree and a link at a key no entry names stay, each said.
test "a tree no entry names after the catalogue is written goes, and one the author changed stays (defect 2614)"
    program = "build/selftest-fetch-unnamed/"
    assert !process.remove_tree(program).is_err()
    one_text = "function on() -> bool\n    return true\n"
    two_text = "function on() -> bool\n    return false\n"
    assert !process.mkdir_all(program + "v1").is_err()
    assert !write_file(path: program + "v1/flags.hero", text: one_text).is_err()
    assert !process.mkdir_all(program + "v2").is_err()
    assert !write_file(path: program + "v2/flags.hero", text: two_text).is_err()
    sum_1 = fingerprint.of(program + "v1").must()
    sum_2 = fingerprint.of(program + "v2").must()
    before = catalogue.parsed(file: program + "heroes.toml", text: kit(version: "1.0.0", sum: sum_1))
    after = catalogue.parsed(file: program + "heroes.toml", text: kit(version: "1.1.0", sum: sum_2))
    assert before.problem == "" && after.problem == ""
    old = program + "heroes.packages/" + placed.key(before.entries[0], index: before.index)
    new = program + "heroes.packages/" + placed.key(after.entries[0], index: after.index)
    assert !process.mkdir_all(old).is_err() && !process.mkdir_all(new).is_err()
    assert !write_file(path: old + "/flags.hero", text: one_text).is_err()
    assert !write_file(path: new + "/flags.hero", text: two_text).is_err()

    # The catalogue moved: the old tree goes, the new one stays.
    ledger: staging.Ledger @= staging.begun(program).must()
    assert removed(program: ledger.program, run: ledger.folder, before: before, after: after) == ["removed kit 1.0.0 " + old + ", which no entry names now"]
    assert !process.path_exists(old) && process.is_directory(new)
    staging.ended(@ledger)
    assert process.walk(program + "heroes.packages").must().files == [new + "/flags.hero"]

    # Nothing moved, or a catalogue that does not read: nothing goes.
    same: staging.Ledger @= staging.begun(program).must()
    assert removed(program: same.program, run: same.folder, before: after, after: after).len() == 0
    assert removed(program: same.program, run: same.folder, before: after, after: catalogue.parsed(file: program + "heroes.toml", text: "version = 1\n")).len() == 0
    staging.ended(@same)
    assert process.is_directory(new)

    # The author's edit of a tree no entry names now stays, and is said.
    assert !write_file(path: new + "/flags.hero", text: two_text + "# mine\n").is_err()
    edited: staging.Ledger @= staging.begun(program).must()
    assert removed(program: edited.program, run: edited.folder, before: after, after: before) == ["kept " + new + ", which no entry names now: it was changed since `kit` 1.1.0 was placed there, and the change is yours; move it out of `heroes.packages/` to keep it, or remove it"]
    staging.ended(@edited)
    assert read_file(new + "/flags.hero").must() == two_text + "# mine\n"

    # A link at a key no entry names is no tree a verb placed: it stays,
    # where this machine makes links, and so does what it names.
    assert !process.remove_tree(new).is_err()
    assert !process.mkdir_all(program + "mine").is_err()
    assert !write_file(path: program + "mine/flags.hero", text: two_text).is_err()

    if !files.symbolic_link(target: "../mine", name: new).is_err()
        linked: staging.Ledger @= staging.begun(program).must()
        assert removed(program: linked.program, run: linked.folder, before: after, after: before) == ["kept " + new + ", which no entry names now: a link to a folder stands there, which no verb places, so it is yours; move it out of `heroes.packages/` to keep it, or remove it"]
        staging.ended(@linked)
        assert files.entry(new) == .link
        assert read_file(program + "mine/flags.hero").must() == two_text

    assert !process.remove_tree(program).is_err()

function kit(version: str, sum: str) -> str
    return "index = \"file://../idx\"\n\n[dependencies.kit]\nversion = \"" + version + "\"\nsum = \"" + sum + "\"\n"

# The entry `kit` of an index at `version` and `sum`.
function kit_at(version: str, sum: str) -> catalogue.Entry
    return catalogue.Entry(name: "kit", version: version, git: "", tag: "", commit: "", path: "", sum: sum)

# A folder made at `dir` holding `flags.hero` as `text`.
function tree_at(dir: str, text: str)
    process.mkdir_all(dir).must()
    write_file(path: dir + "/flags.hero", text: text).must()

# Defect 2621: what a hand edit of the catalogue left, asked of every name
# under `heroes.packages/` once a run placed the catalogue whole. A version's
# tree and a part a `packages` line placed, each unchanged, go; a tree edited,
# one keyed for another index and one whose name holds a git tag stay, each
# said, and so does a link; the key the catalogue names, a key already
# judged, a run's own folder and a name of no key's shape are not asked; and
# a catalogue that does not read sweeps nothing.
test "a tree a hand edit left goes where its files sum to the key its name holds (defect 2621)"
    program = "build/selftest-fetch-swept/"
    home = program + "heroes.packages/"
    assert !process.remove_tree(program).is_err()
    one_text = "function on() -> bool\n    return true\n"
    two_text = "function on() -> bool\n    return false\n"
    tree_at(dir: program + "v1", text: one_text)
    tree_at(dir: program + "v2", text: two_text)
    tree_at(dir: program + "v3", text: one_text)
    write_file(path: program + "v3/text.hero", text: two_text).must()
    sum_1 = fingerprint.of(program + "v1").must()
    sum_2 = fingerprint.of(program + "v2").must()
    sum_3 = fingerprint.of(program + "v3").must()
    c = catalogue.parsed(file: program + "heroes.toml", text: kit(version: "1.1.0", sum: sum_2))
    assert c.problem == ""
    current = home + placed.key(c.entries[0], index: c.index)
    old = home + placed.key(kit_at(version: "1.0.0", sum: sum_1), index: c.index)
    part = home + placed.key(kit_at(version: "0.9.0", sum: sum_3), index: c.index)
    edited = home + placed.key(kit_at(version: "0.8.0", sum: sum_1), index: c.index)
    other = home + placed.key(kit_at(version: "0.7.0", sum: sum_1), index: "file://../other")
    git = home + "kit@v0.6.0-0123456789abcdef"
    judged_key = placed.key(kit_at(version: "0.5.0", sum: sum_1), index: c.index)
    tree_at(dir: current, text: two_text)
    tree_at(dir: old, text: one_text)
    tree_at(dir: part, text: one_text)
    write_file(path: part + "/" + fingerprint.LISTING, text: fingerprint.listing(program + "v3").must()).must()
    tree_at(dir: edited, text: one_text + "# mine\n")
    tree_at(dir: other, text: one_text)
    tree_at(dir: git, text: one_text)
    tree_at(dir: home + judged_key, text: one_text)
    tree_at(dir: home + ".fetching-1-1", text: one_text)
    tree_at(dir: home + "notes", text: one_text)
    assert fingerprint.of(part).must() == sum_3
    keep = "; move it out of `heroes.packages/` to keep it, or remove it"
    changed = ", which no entry names now: its files do not sum to `kit` "
    since = " of the catalogue's index as its name says it was placed, so it was changed since or placed from another source, and nothing says it can be placed again"
    tagged = "kept " + git + ", which no entry names now: its name holds no version of the catalogue's index, and the key of a tree placed from git hashes a commit no name holds, so nothing says it can be placed again" + keep
    ledger: staging.Ledger @= staging.begun(program).must()
    said = swept(program: ledger.program, run: ledger.folder, c: c, judged: [judged_key])
    assert said == ["kept " + other + changed + "0.7.0" + since + keep, "kept " + edited + changed + "0.8.0" + since + keep, "removed kit 0.9.0 " + part + ", which no entry names now", "removed kit 1.0.0 " + old + ", which no entry names now", tagged]
    staging.ended(@ledger)
    assert !process.path_exists(old) && !process.path_exists(part)

    for stays in [current, edited, other, git, home + judged_key, home + ".fetching-1-1", home + "notes"]
        assert process.is_directory(stays)

    assert read_file(edited + "/flags.hero").must() == one_text + "# mine\n"

    # A catalogue that does not read names nothing a reader can trust.
    unread: staging.Ledger @= staging.begun(program).must()
    assert swept(program: unread.program, run: unread.folder, c: catalogue.parsed(file: program + "heroes.toml", text: "version = 1\n"), judged: []).len() == 0
    staging.ended(@unread)

    # A link at a key's name is no tree a verb placed, where this machine
    # makes links.
    linked = home + "kit@1.2.0-0123456789abcdef"

    if !files.symbolic_link(target: "notes", name: linked).is_err()
        again: staging.Ledger @= staging.begun(program).must()
        told = swept(program: again.program, run: again.folder, c: c, judged: [judged_key])
        staging.ended(@again)
        assert told.len() == 4 && told[3] == tagged
        assert told[2] == "kept " + linked + ", which no entry names now: a link to a folder stands there, which no verb places, so it is yours" + keep
        assert files.entry(linked) == .link

    assert !process.remove_tree(program).is_err()
