# The package `heroes add` is asked for, made an entry (panel 235's R11 and
# R6, ratified 2026-11-07): a name from the index at the version written or
# the highest it lists, its sum the index's; a git address at a tag, its
# commit asked and its tree's sum trusted on first use; or a folder of the
# author's own, read where it stands. The first two are fetched and placed
# here, so `fetch/build_list.hero` reads the package's own catalogue from a
# tree held to its sum. Out of `fetch/add.hero` since defect 2433, whose
# repair took that module past its ceiling: this is the verb's operand, and
# `add.hero` what the verb does with it.

use cli/argv
use cli/process
use fetch/address
use fetch/closure
use fetch/git_source
use fetch/index_source
use fetch/staging
use fetch/tag_absent
use fetch/transport
use fetch/verb_place
use module/catalogue
use module/entry_name
use module/fingerprint
use module/listing
use module/placed
use module/sums
use module_text

# The entry `inv` asks for, placed where it is fetched and written into the
# run's `ledger`, whose folder the index's answers are written into.
function entry_of(@ledger: staging.Ledger, inv: argv.Invocation, tools: transport.Tools, program: str, root: address.Root, c: catalogue.Catalogue) -> catalogue.Entry?
    folder = argv.value_of(inv, spelling: "--path")

    if !folder.is_err()
        return folder_entry(inv, program: program, folder: folder.must(), c: c)

    if inv.file.is_err()
        return fail(
            code: "bad_usage",
            msg: "`add` needs a package: a name from the index, `heroes add json`; a git address at a tag, `heroes add https://git.example.org/ana/json --tag v1.0.0`; or a folder, `heroes add --path ../json`"
        )
    asked = inv.file.must()

    if looks_addressed(asked)
        return git_entry(@ledger, inv, tools: tools, address_text: asked, program: program, root: root, c: c)
    return index_entry(@ledger, inv, tools: tools, asked: asked, program: program, root: root, c: c)

# A folder of the author's own, read where it stands (R6).
function folder_entry(inv: argv.Invocation, program: str, folder: str, c: catalogue.Catalogue) -> catalogue.Entry?
    if !inv.file.is_err() || argv.has(inv, spelling: "--tag") || argv.has(inv, spelling: "--index")
        return fail(
            code: "bad_usage",
            msg: "`--path` names the package's folder, so `add` takes no package, `--tag` or `--index` beside it"
        )
    name = argv.value_of(inv, spelling: "--as").default(last_part(folder))

    if entry_name.refused(name).len() > 0
        return fail(
            code: "bad_usage",
            msg: "`" + name + "` is no entry's name: " + entry_name.refused(name) + "; give one with `--as`"
        )
    e = catalogue.Entry(name: name, version: "", git: "", tag: "", commit: "", path: folder, sum: "")
    held_under_another(inv, e: e, program: program, c: c)?
    name_held(inv, e: e, program: program, c: c)?

    if !process.is_directory(program + folder)
        return fail(code: "absent", msg: "there is no folder `" + program + folder + "`")
    return ok(e)

# A name `--as` gives a package an entry of the catalogue already holds under
# another name, refused (defect 2620): a program holds each package under one
# name (panel 235's R3, which the catalogue's reader holds,
# `catalogue.one_package_twice`), so the entry cannot be written beside the
# one that holds it. Until then the walk of the build list took the entry
# that held it for the one asked (`fetch/build_list.hero`, `chosen`), the
# name given was dropped, and `add` said `wrote` at exit 0 with no entry of
# that name written. Without `--as` that entry is the one `add` moves, under
# its own name, a line saying so where anything of it moved. Asked of the
# catalogue's text and the command line alone, before a folder is read or a
# source asked.
function held_under_another(inv: argv.Invocation, e: catalogue.Entry, program: str, c: catalogue.Catalogue) -> ()?
    if !argv.has(inv, spelling: "--as")
        return ok()
    asked = catalogue.source_of(e, index: c.index, folder: program)

    for one in c.entries
        if one.name != e.name && catalogue.source_of(one, index: c.index, folder: program) == asked
            return fail(
                code: "catalogue_refused",
                msg: "the catalogue's entry `" + one.name + "` already names " + catalogue.said_source(one) + ", and a program holds each package under one name, so `--as " + e.name + "` would name it twice: a `use <" + one.name + ">/` reaches it as it is, or rename it by hand, `[dependencies." + one.name + "]` to `[dependencies." + e.name + "]` in `" + program + catalogue.FILE + "` and each `use <" + one.name + ">/` to `use <" + e.name + ">/`"
            )

    return ok()

# The name a folder or a git source would be written under, held by an
# entry naming another package, refused as the catalogue's fact it is
# (defect 2624), `catalogue_refused` at exit 1: an entry names one package
# (panel 235's R3). Until then the walk of the build list found it
# (`fetch/build_list.hero`, `chosen`), after the source was asked, and told
# it `bad_usage` at exit 2, *name the new one with `--as`*, to a command that
# had named it with `--as` already, and to an index package, which takes no
# `--as`. Asked of the catalogue's text and the command line alone, before a
# folder is read or a source asked; `held_under_another` is asked first.
function name_held(inv: argv.Invocation, e: catalogue.Entry, program: str, c: catalogue.Catalogue) -> ()?
    held = catalogue.entry(c, name: e.name)

    if held.is_err()
        return ok()

    if catalogue.source_of(held.must(), index: c.index, folder: program) == catalogue.source_of(e, index: c.index, folder: program)
        return ok()
    return fail(
        code: "catalogue_refused",
        msg: name_taken(inv, held: held.must(), asked: catalogue.said_source(e), program: program, index_package: false)
    )

# The words of a name `held` holds for another package than `asked`, with
# the routes the command line leaves: another name with `--as` for a folder
# or a git source, the program's own entry renamed by hand for an index
# package, or `held` taken out by hand for the new package to take its place.
function name_taken(inv: argv.Invocation, held: catalogue.Entry, asked: str, program: str, index_package: bool) -> str
    file = program + catalogue.FILE
    fact = "the catalogue's entry `" + held.name + "` already names " + catalogue.said_source(held) + ", another package than " + asked + ", and an entry names one package: "
    in_place = "or, for the new one to take its place, take `[dependencies." + held.name + "]` out of `" + file + "` by hand and run this add again"

    if index_package
        return fact + "an index package keeps the index's name, so the program's own entry is the one to rename, by hand, `[dependencies." + held.name + "]` to `[dependencies.<name>]` in `" + file + "` and each `use <" + held.name + ">/` to `use <name>/`, " + in_place

    if argv.has(inv, spelling: "--as")
        return fact + "name the new one other than `" + held.name + "` with `--as`, " + in_place
    return fact + "name the new one with `--as`, " + in_place

# A git source at a tag: its commit asked, its tree fetched and placed, and
# its sum the tree's, trusted on first use.
function git_entry(@ledger: staging.Ledger, inv: argv.Invocation, tools: transport.Tools, address_text: str, program: str, root: address.Root, c: catalogue.Catalogue) -> catalogue.Entry?
    tag = argv.value_of(inv, spelling: "--tag")

    if tag.is_err()
        return fail(
            code: "bad_usage",
            msg: "a git source is added at a tag: `heroes add " + address_text + " --tag v1.0.0`"
        )

    if argv.has(inv, spelling: "--index")
        return fail(
            code: "bad_usage",
            msg: "`--index` names where a package is read by its name, and a git address names its own source"
        )
    at = address.judged(address_text, root: root)?
    name = argv.value_of(inv, spelling: "--as").default(module_text.address_entry(address_text))

    if entry_name.refused(name).len() > 0
        return fail(
            code: "bad_usage",
            msg: "the entry of `" + address_text + "` has no name a `use` writes: " + entry_name.refused(name) + "; give one with `--as`"
        )
    asked_entry = catalogue.Entry(
        name: name,
        version: "",
        git: address_text,
        tag: tag.must(),
        commit: "",
        path: "",
        sum: ""
    )
    held_under_another(inv, e: asked_entry, program: program, c: c)?
    name_held(inv, e: asked_entry, program: program, c: c)?
    s: staging.Staging @= staging.opened(program)?
    asked = transport.tag_commit(tools, source: at, tag: tag.must(), scratch: s.folder)
    commit = tag_absent.checked(tools, source: at, commit: asked, scratch: s.folder, entry: "")
    first = catalogue.Entry(
        name: name,
        version: "",
        git: address_text,
        tag: tag.must(),
        commit: commit.default(""),
        path: "",
        sum: ""
    )
    done: ()? @= verb_place.unit_of(commit)

    if !done.is_err()
        done @ git_source.written(tools, e: first, root: root, s: s)

    if done.is_err()
        staging.dropped(@s)
        return fail(code: verb_place.code_of(done), msg: verb_place.why(done))
    sum = fingerprint.of(s.tree)

    if sum.is_err()
        staging.dropped(@s)
        return fail(code: "cannot_place", msg: verb_place.reason(sum))

    # The whole tree's sum is the entry's; an entry of this name with a
    # `packages` line keeps that line, and the tree is narrowed to it (panel
    # 253's R6).
    listed = listing.of(c.listings, entry: name)

    if listed.len() > 0
        narrowed = closure.narrowed(tree: s.tree, scratch: s.folder, listed: listed, what: "the tree of `" + name + "`")

        if narrowed.is_err()
            staging.dropped(@s)
            return fail(code: verb_place.code_of(narrowed), msg: verb_place.why(narrowed))
    e = catalogue.Entry(
        name: name,
        version: "",
        git: address_text,
        tag: tag.must(),
        commit: commit.must(),
        path: "",
        sum: sum.must()
    )
    _ = staging.placed(@ledger, @s, key: placed.key(e, index: c.index), sum: e.sum, what: "the tree of `" + name + "`")?
    return ok(e)

# A name from the index, at the version written or the highest it lists, its
# sum the index's.
function index_entry(@ledger: staging.Ledger, inv: argv.Invocation, tools: transport.Tools, asked: str, program: str, root: address.Root, c: catalogue.Catalogue) -> catalogue.Entry?
    if argv.has(inv, spelling: "--tag") || argv.has(inv, spelling: "--as")
        return fail(
            code: "bad_usage",
            msg: "a package from the index keeps the index's name and has no tag: `heroes add json` or `heroes add json@1.4.2`"
        )
    at_sign = verb_place.at_of(asked)
    name = asked.slice(from: 0, to: at_sign)

    if entry_name.refused(name).len() > 0
        return fail(
            code: "bad_usage",
            msg: "`" + name + "` is no package's name: " + entry_name.refused(name)
        )

    # The version's shape is the text's alone, so it is asked before the
    # index is (defect 2540): `json@1.4` was told by the index, which with no
    # catalogue is the Heroes index over the network, and so `unreachable`
    # where the shape says what is wrong.
    if at_sign < asked.len()
        version = asked.slice(from: at_sign + 1, to: asked.len())

        if version.len() == 0
            return fail(
                code: "bad_usage",
                msg: "`" + asked + "` writes no version after its `@`: a version is exact, three numbers with no leading zero, `" + name + "@1.4.2`, or no `@` for the highest the index lists"
            )

        if !sums.version_shape(version)
            return fail(
                code: "bad_usage",
                msg: "`" + version + "` is no version: a version is exact, three numbers with no leading zero, `1.4.2`"
            )

    # Every index entry of the catalogue is read from the one index its
    # `index` line names, so an entry of this name is this package unless it
    # names a folder or a git source.
    held = catalogue.entry(c, name: name)

    if !held.is_err() && held.must().version.len() == 0
        return fail(
            code: "catalogue_refused",
            msg: name_taken(inv, held: held.must(), asked: "the index's `" + name + "`", program: program, index_package: true)
        )
    index = address.judged(index_source.written_index(c.index), root: root)?
    listed = index_source.versions(tools, index: index, name: name, scratch: ledger.folder)?
    pick = verb_place.version_picked(listed, asked: asked, at: at_sign, index: index.written)?
    e = catalogue.Entry(name: name, version: pick.version, git: "", tag: "", commit: "", path: "", sum: pick.sum)
    _ = index_source.fetched(@ledger, tools, e: e, program: program, root: root, index: c.index, listed: listing.of(c.listings, entry: name))?
    return ok(e)

# Whether the operand is an address rather than a name: a scheme, git's
# `user@host:path`, or a path, each of which `fetch/address.hero` judges.
function looks_addressed(asked: str) -> bool
    for at in range(from: 0, to: asked.len())
        if asked[at] == ':' || asked[at] == '/' || asked[at] == '\\'
            return true

    return false

function last_part(folder: str) -> str
    end: i64 @= folder.len()

    while end > 0 && folder[end - 1] == '/'
        end @ end - 1

    at: i64 @= end

    while at > 0 && folder[at - 1] != '/'
        at @ at - 1

    return folder.slice(from: at, to: end)
