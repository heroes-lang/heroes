# The git commands that throw away what a tree holds (defect 514) and those
# that write over the paths they name (defects 529 and 535): an abort or a
# skip, a hard or merge reset, a forced checkout or switch, an autostash, a
# restore of the index, a forced removal or move, the plumbing that does the
# same. The Python guard's `discards.py` and `overwrites.py` ask git what the
# tree holds before they answer; this holds the text half, which decides
# where git is asked at all, and answers `unwritten` where the Python guard
# asks (`answer.hero`). Where the folder is no folder, both guards answer
# nothing, every question of theirs needing a worktree.
#
# The overwrite rules read each verb's options by tables of git's own before
# they ask git, so `git rm x` without `-f` asks nothing (`overwrites.hero`).

use answer
use commits
use overwrites
use pystr
use runs

# The verbs read here, in the Python guard's order.
constant VERBS: [str]
    [
        "merge"
        "cherry-pick"
        "revert"
        "rebase"
        "am"
        "reset"
        "checkout"
        "switch"
        "pull"
        "restore"
        "rm"
        "mv"
        "read-tree"
        "update-index"
    ]

# Whether `word` is `option` or an abbreviation of it git may read, at least
# `shortest` characters long.
function prefix_of(word: str, option: str, shortest: i64) -> bool
    return word.len() >= shortest && pystr.opens(s: option, prefix: word)

# The words before a `--`.
function options_of(words: [str]) -> [str]
    out: [str] @= []

    for word in words
        if word == "--"
            break
        out @ out.push(word)

    return out

# Whether the words after `git <verb>` end what stands by `--abort` or
# `--skip`, read by every prefix from three characters; a merge has no skip.
function ends(verb: str, words: [str]) -> bool
    for word in options_of(words)
        if prefix_of(word: word, option: "--abort", shortest: 3)
            return true

        if verb != "merge" && prefix_of(word: word, option: "--skip", shortest: 3)
            return true

    return false

# A checkout's or a switch's words read for force: its long options, the
# letters of its clusters up to one that takes a value, its plain words and
# the words after its `--`, the Python guard's `forced`.
record Forced
    options: [str]
    short: str
    plain: [str]
    after: [str]

# `words` read as `forced` reads them.
function forced_words(words: [str]) -> Forced
    options: [str] @= []
    short: str @= ""
    plain: [str] @= []
    after: [str] @= []
    dashed: bool @= false
    skip: bool @= false

    for word in words
        if dashed
            after @ after.push(word)
        else if word == "--"
            dashed @ true
        else if skip
            skip @ false
        else if pystr.opens(s: word, prefix: "--")
            options @ options.push(word)
            skip @ runs.has(
                list: ["--orphan", "--conflict", "--create", "--force-create", "--pathspec-from-file"],
                word: word
            )
        else if pystr.opens(s: word, prefix: "-") && word != "-"
            at: i64 @= 1

            while at < word.len()
                width = pystr.width_at(word, at)
                letter = word[at]
                short @ short + word.slice(from: at, to: at + width)

                if letter == 'b' || letter == 'B' || letter == 'c' || letter == 'C'
                    skip @ at + width == word.len()
                    break
                at @ at + width
        else
            plain @ plain.push(word)

    return Forced(options: options, short: short, plain: plain, after: after)

# Whether a patch or a pathspec file keeps the words from forcing anything.
function patched(f: Forced) -> bool
    if pystr.holds(s: f.short, piece: "p")
        return true

    for option in f.options
        if pystr.opens(s: option, prefix: "--pathspec-from-file") || prefix_of(word: option, option: "--patch", shortest: 4)
            return true

    return false

# Whether a `git switch <words>` puts back every tracked file: `-f`,
# `--force` or `--discard-changes` by their abbreviations, a patch aside.
function switch_forced(words: [str]) -> bool
    f = forced_words(words)

    if patched(f)
        return false

    if pystr.holds(s: f.short, piece: "f")
        return true

    for option in f.options
        if prefix_of(word: option, option: "--force", shortest: 5) || prefix_of(word: option, option: "--discard-changes", shortest: 4)
            return true

    return false

# Whether the Python guard reads a `git checkout <words>` as forced over the
# whole tree, or asks git whether its one word names a commit: `-f` or
# `--force` from `--f`, no patch, no path after `--`, at most one word.
function checkout_forced(words: [str]) -> bool
    f = forced_words(words)

    if patched(f)
        return false
    forced: bool @= pystr.holds(s: f.short, piece: "f")

    for option in f.options
        if prefix_of(word: option, option: "--force", shortest: 3)
            forced @ true

    return forced && f.after.len() == 0 && f.plain.len() <= 1

# The mode of `git reset <words>`, the last one named, as git reads it:
# `--h` and longer for `--hard`, `--me` and longer for `--merge`.
function reset_mode(words: [str]) -> str
    mode: str @= ""

    for word in options_of(words)
        if prefix_of(word: word, option: "--hard", shortest: 3)
            mode @ "--hard"
        else if prefix_of(word: word, option: "--merge", shortest: 4)
            mode @ "--merge"
        else if prefix_of(word: word, option: "--keep", shortest: 3) || prefix_of(word: word, option: "--soft", shortest: 4) || prefix_of(word: word, option: "--mixed", shortest: 4)
            mode @ word

    return mode

# The answer to `git <verb> <words>` run in `where`, `appended` where
# `xargs` runs it and adds words the text does not hold.
function verdict(verb: str, words: [str], where: str, appended: bool) -> answer.Answer
    if !commits.asks_git(where)
        return .none
    thrown: answer.Answer = .unwritten(rule: "`git " + verb + "`, which throws away what the tree holds, asked of git")

    if verb == "cherry-pick" || verb == "revert" || verb == "am"
        if ends(verb: verb, words: words)
            return thrown
        return .none

    if verb == "merge" || verb == "rebase"
        if ends(verb: verb, words: words)
            return thrown

        stops = if verb == "merge"
            ["--continue", "--abort", "--quit"]
        else
            ["--continue", "--abort", "--skip", "--quit", "--edit-todo", "--show-current-patch"]

        for word in options_of(words)
            for stop in stops
                if prefix_of(word: word, option: stop, shortest: 4)
                    return .none

        return .unwritten(rule: "an autostash, which the Python guard reads from git's configuration")

    if verb == "switch"
        if switch_forced(words)
            return thrown
        return .none

    if verb == "reset"
        mode = reset_mode(words)

        if mode == "--hard" || mode == "--merge"
            return thrown
        return overwrites.verdict(verb: verb, words: words, appended: appended)

    if verb == "checkout"
        if checkout_forced(words)
            return thrown
        return overwrites.verdict(verb: verb, words: words, appended: appended)

    if verb == "restore" || verb == "rm" || verb == "mv"
        return overwrites.verdict(verb: verb, words: words, appended: appended)
    return .unwritten(rule: "`git " + verb + "`, the plumbing that writes over the paths it names, asked of git")

test "discards: the text half, and where git is asked"
    assert verdict(verb: "reset", words: ["--hard"], where: "", appended: false) == .none
    assert verdict(verb: "reset", words: ["--hard"], where: "/heroes-hooks-never-there", appended: false) == .none
    assert answer.stops(verdict(verb: "reset", words: ["--h"], where: "/", appended: false)) && answer.stops(verdict(verb: "pull", words: [], where: "/", appended: false))
    assert verdict(verb: "reset", words: ["--soft", "--", "x"], where: "/", appended: false) == .none
    assert verdict(verb: "cherry-pick", words: ["x"], where: "/", appended: false) == .none && answer.stops(verdict(verb: "am", words: ["--sk"], where: "/", appended: false))
    assert verdict(verb: "rebase", words: ["--cont"], where: "/", appended: false) == .none && answer.stops(verdict(verb: "rebase", words: ["main"], where: "/", appended: false))
    assert answer.stops(verdict(verb: "merge", words: ["--ab"], where: "/", appended: false)) && verdict(verb: "merge", words: ["--quit"], where: "/", appended: false) == .none
    assert verdict(verb: "switch", words: ["main"], where: "/", appended: false) == .none && answer.stops(verdict(verb: "switch", words: ["-f", "main"], where: "/", appended: false))
    assert verdict(verb: "checkout", words: ["main"], where: "/", appended: false) == .none && answer.stops(verdict(verb: "checkout", words: ["-f"], where: "/", appended: false))
    assert verdict(verb: "rm", words: ["x"], where: "/", appended: false) == .none && answer.stops(verdict(verb: "update-index", words: [], where: "/", appended: false))
    assert !switch_forced(["-bf"]) && switch_forced(["--disc"]) && !switch_forced(["-fp"]) && !switch_forced(["--", "-f"])
    assert checkout_forced(["--f", "main"]) && !checkout_forced(["-f", "a", "b"]) && !checkout_forced(["-f", "--", "x"]) && !checkout_forced(["main"])
    assert reset_mode(["--soft", "--me"]) == "--merge" && reset_mode(["--", "--hard"]) == ""
    assert forced_words(["-bx", "y", "--", "z"]) == Forced(options: [], short: "b", plain: ["y"], after: ["z"]) && patched(forced_words(["-p"]))
    assert prefix_of(word: "--ab", option: "--abort", shortest: 3) && options_of(["a", "--", "b"]) == ["a"]
    assert ends(verb: "rebase", words: ["--skip"]) && !ends(verb: "merge", words: ["--skip"])
