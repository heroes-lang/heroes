# The language's own edges of the process, `hero_os.h`, bound thin: one
# function per C function `os` reads, each answering what C answers, in the
# header's order. The floor of `os` (`examples/packages/README.md` § 4.1): a
# program reads these numbers itself only where it asks the floor; `os` turns
# every one of them into a `T?`.
#
# The header is the runtime's, spec § 13's *threads, processes and files from
# the language's `hero_os.h`*, so this group names it and no `link`, and binds
# nothing a program could not (panel 241's R7: no header of a package's own
# with a platform arm, and no door of `hero_compiler.h`). Where the platforms
# differ, the runtime's C answers, each platform's arm beneath it.

extern "hero_os.h"
    # What each call answers in its status: the same small numbers on every
    # platform, never the system's own.
    constant HERO_OS_OK: i64
    constant HERO_OS_NOT_FOUND: i64
    constant HERO_OS_FAILED: i64
    constant HERO_OS_NOT_TEXT: i64
    # What `hero_fs_kind` answers: the thing at a path, a link itself where it
    # is one, or -1 where the system could not be asked.
    constant HERO_FS_UNKNOWN: i64
    constant HERO_FS_ABSENT: i64
    constant HERO_FS_FILE: i64
    constant HERO_FS_DIRECTORY: i64
    constant HERO_FS_LINK: i64
    constant HERO_FS_OTHER: i64
    function hero_env_shown(name: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_why() -> i64
    function hero_fs_resolved_shown(path: cstr lent, @status: i64, @marks: i64) -> str
    function hero_fs_kind(path: cstr lent) -> i64
    function hero_fs_mode(path: cstr lent) -> i64
    function hero_run_exe_suffix() -> str

# The value of the environment variable `name`, `status` set to
# `HERO_OS_NOT_FOUND` and "" answered where it is unset, and to
# `HERO_OS_NOT_TEXT` where the value is not UTF-8, the answer then opening
# with `marks` bytes that name each byte replaced. It aborts where `name`
# holds a zero byte, which C cannot read.
function env_shown(name: str, @status: i64, @marks: i64) -> str
    return hero_env_shown(name: name.cstr(), status: @status, marks: @marks)

# The system's own number for why the last call on files failed on this
# thread, below zero where the runtime refused before asking it, 0 after one
# that did not fail.
function fs_why() -> i64
    return hero_fs_why()

# The absolute place `path` names, every link on the way followed and the
# parts not there yet as written, `status` set to `HERO_OS_FAILED` and ""
# answered where it cannot be resolved; read as `env_shown` reads a value
# that is not UTF-8. It aborts where `path` holds a zero byte.
function fs_resolved_shown(path: str, @status: i64, @marks: i64) -> str
    return hero_fs_resolved_shown(path: path.cstr(), status: @status, marks: @marks)

# What stands at `path`, the link itself where it is one: one of the
# `HERO_FS_` constants. It aborts where `path` holds a zero byte.
function fs_kind(path: str) -> i64
    return hero_fs_kind(path: path.cstr())

# The permission bits of what `path` names, a link followed, or -1 where it
# cannot be read; on Windows 0444 for a read-only file and 0666 for any
# other. It aborts where `path` holds a zero byte.
function fs_mode(path: str) -> i64
    return hero_fs_mode(path: path.cstr())

# `.exe` on Windows, where a program's file needs it to be started, and ""
# on every other system: the one answer by which a program written in Heroes
# tells Windows apart, as the compiler does.
function run_exe_suffix() -> str
    return hero_run_exe_suffix()

## Tests

test "env_shown reads a variable every process here has, and an unset one"
    status: i64 @= -1
    marks: i64 @= -1
    path = env_shown("PATH", status: @status, marks: @marks)
    assert status == HERO_OS_OK && marks == 0 && path.len() > 0
    absent = env_shown("HEROES_CORE_TEST_NEVER_SET_ANYWHERE", status: @status, marks: @marks)
    assert status == HERO_OS_NOT_FOUND && absent == ""

test "fs_resolved_shown makes a path absolute, fs_kind and fs_mode read what stands there"
    status: i64 @= -1
    marks: i64 @= -1
    here = fs_resolved_shown(".", status: @status, marks: @marks)
    assert status == HERO_OS_OK && marks == 0 && here.len() > 1
    assert fs_kind(here) == HERO_FS_DIRECTORY
    assert fs_kind(here + "/heroes-core-test-never-there") == HERO_FS_ABSENT
    assert fs_mode(here) >= 0 && fs_mode(here + "/heroes-core-test-never-there") == -1
    assert fs_why() != 0
    assert HERO_FS_UNKNOWN == -1 && HERO_FS_FILE != HERO_FS_LINK && HERO_FS_OTHER != HERO_OS_FAILED
    assert run_exe_suffix() == "" || run_exe_suffix() == ".exe"
