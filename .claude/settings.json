{
  "permissions": {
    "allow": [
      "Bash(clang *)",
      "Bash(./heroes *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git describe*)",
      "Bash(git tag --list*)",
      "Monitor",
      "Bash(echo \"push exit=$?\")",
      "Bash(echo \"push win exit=$?\")",
      "Bash(echo \"push=$?\")",
      "Bash(echo \"push win=$?\")",
      "Bash(echo \"push tag=$?\")",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge lane-*)",
      "Bash(git bisect *)",
      "Bash(docker run *)",
      "Bash(docker build *)",
      "Bash(/usr/bin/time -p ./heroes *)",
      "Bash(/usr/bin/time -p ./heroes-next *)",
      "Bash(xargs -P 8 ./heroes *)",
      "Bash(xargs -P 8 ./heroes-next *)",
      "Bash(caffeinate -i *)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add --update*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git stash)",
      "Bash(git stash push*)",
      "Bash(git stash save*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" guard_bash.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" fmt_check.py"
          }
        ]
      }
    ]
  }
}
