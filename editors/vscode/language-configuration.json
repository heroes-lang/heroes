{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((constant|function|record|variant|test|extern|if|else if|else|for|while|match)\\b.*$|.*=>\\s*$)",
    "decreaseIndentPattern": "^\\s*(else|else if)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*#.*$",
      "action": { "indent": "none" }
    }
  ]
}
