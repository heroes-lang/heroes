---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderRebelPage } from '../lib/rebel-page.ts';

// Rebel's page: its prose a fragment, its packages read from
// rebel/examples/README.md § A1, each opening its reference (`rebel-page.ts`).
const page = await renderRebelPage('en');
---
<BaseLayout url={page.url} title={page.title} description={page.description}>
<Fragment set:html={page.html} />
</BaseLayout>
