---
// The nav bar every page carries, so that no page is a dead end.
//
// This file exists because the hand-written site had FORTY-FOUR of these and
// no two were the same: measured, 44 pages and 44 distinct nav blocks. They
// differed by exactly three mechanical things, and nothing else:
//
//   1. `class="here"` on the entry for the page you are reading;
//   2. how many `../` the links needed to climb;
//   3. the link to the other edition, which points at this same page.
//
// Only the first and third are left. The second stopped existing when the links
// became absolute, and that is worth more than the lines it saved: with relative
// links the site had TWO different depths to keep straight, one for the
// stylesheet and one for the nav, because `/it/` is one directory down from the
// root and at the top of its own edition at the same time. An absolute path has
// no depth to get wrong.

interface Props {
  /** The URL this page answers at, always absolute, always ending in `/`. */
  url: string;
  /** Which nav entry is the page you are reading. `errors` is `docs`. */
  current?: string;
}

const { url, current } = Astro.props;

const lang = url.startsWith('/it/') || url === '/it/' ? 'it' : 'en';
const root = lang === 'it' ? '/it' : '';

// The other edition's copy of this same page.
const other = lang === 'en' ? `/it${url}` : url.slice(3);

// Seven entries, and each one answers a question a visitor actually has, in
// the order they ask it: why should I care, show me the code, teach it to me,
// how do I run it, is this alive, how is it built, who is behind it.
//
// It was eight, and the eight were the project's own shelves rather than the
// visitor's: Docs, Zen, Why, Self-hosted, Log, Panel, Thanks, Author. Three of
// those are one page now (`/project/`) and two are another (`/about/`), by
// author instruction 2026-09-06, which is what made room for Examples and
// Start without the row growing. Every surveyed language site has a learning
// entry and an install entry in its top nav; this one had neither.
const entries = [
  { key: 'why', slug: 'why', en: 'Why', it: 'Perché' },
  { key: 'examples', slug: 'examples', en: 'Examples', it: 'Esempi' },
  { key: 'docs', slug: 'docs', en: 'Docs', it: 'Docs' },
  { key: 'start', slug: 'start', en: 'Start', it: 'Inizia' },
  { key: 'log', slug: 'log', en: 'Log', it: 'Log' },
  { key: 'project', slug: 'project', en: 'Project', it: 'Progetto' },
  { key: 'about', slug: 'about', en: 'Author', it: 'Autore' },
];
---
<nav class="site">
  <div>
    <a class="mark" href={`${root}/`}>
      <svg viewBox="0 0 24 32" aria-hidden="true"><path fill="var(--red)" d="M 14 0 L2 18 h8 L7 32 L22 12 h-9 z"/></svg>
      <span>Heroes</span>
    </a>
    <ul>
      {entries.map((e) => (
        <li><a class={e.key === current ? 'here' : undefined} href={`${root}/${e.slug}/`}>{lang === 'it' ? e.it : e.en}</a></li>
      ))}
    </ul>
    {lang === 'en'
      ? <a class="lang" href={other} hreflang="it" lang="it" title="Questa pagina in italiano">IT</a>
      : <a class="lang" href={other} hreflang="en" lang="en" title="This page in English">EN</a>}
    <!-- The address stays, and the warning becomes visible.
         `site/README.md` § Launch order records the author's decision that
         these links stay clickable: the addresses are final, so a live link is
         a door that is not open rather than a wrong address, and the day the
         repository opens there is nothing to put back. What the marketing seat
         measured is the other half of it: the only warning here was a `title`,
         which does not exist on a phone and which nobody hovers before clicking
         a link they mean to click, so 171 of 180 pages carried this with no
         visible caveat at all. The word in the link says it now, and the day
         the repository opens the repair is deleting two words. Repointing the
         link is the seat's own proposal and it is the author's to take, because
         it is their decision it would reverse. -->
    <a class="out" href="https://github.com/heroes-lang/heroes"
       title={lang === 'it'
         ? 'Il repository è privato: si apre insieme al codice'
         : 'The repository is private: it opens with the code'}>{lang === 'it' ? 'GitHub · presto' : 'GitHub · soon'}</a>
  </div>
</nav>
