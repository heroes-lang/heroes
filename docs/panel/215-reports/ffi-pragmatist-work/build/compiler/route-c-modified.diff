diff --git a/selfhost/cli/layout.hero b/selfhost/cli/layout.hero
index 99fcc0277..3851994a1 100644
--- a/selfhost/cli/layout.hero
+++ b/selfhost/cli/layout.hero
@@ -313,6 +313,43 @@ function judged(a: Asking, sum: str, text: str) -> ()?
         return fail(code: "clang", msg: said)
     return ok()
 
+# What the screen said about the group records `records` holds, read from
+# the answer `check_records` kept under the same key (panel 215's build of
+# Q2's route C): the records it could not vouch for are the ones route C
+# reads the dump of. Absent where nothing was kept, a screen whose headers
+# did not compile alone, which the program's own compile tells.
+record Screened
+    wanted: [layout_text.Asked]
+    said: str
+    asking: Asking
+
+function screened(t: toolchain.Toolchain, p: containers.Program, c: state.Checked, s: source.Source, decls: [ast.Decl], probe: compiling.Probe, records: {i64: bool}) -> Screened?
+    wanted: [layout_text.Asked] @= []
+
+    for one in layout_text.asked(s, decls)
+        if emit_externs.held(ok(records), decl: one.decl)
+            wanted @ wanted.push(one)
+
+    if wanted.len() == 0 || probe.read.is_err()
+        return fail(code: "none", msg: "nothing to ask")
+    u = extern_union.used(p, c, decls)
+    screen_text = layout_screen.screen_unit(probe.headers, wanted, s, decls, c, u)
+    key = digest.digest(
+        t.fingerprint + "|layout|" + t.compiler_key + "|" + screen_text + "|words:" + libraries.key_text(probe.words) + "|reads:" + probe.read.must() + "|" + t.runtime_key
+    )
+    dir = t.build + "/layout-" + key
+    memo: {str: str} @= probe.digests
+    known = deps.vouched(dir + "/screen.deps.txt", @memo)
+
+    if known.is_err()
+        return fail(code: "none", msg: "no screen kept")
+    said = kept.read(dir + "/screen-" + known.must() + ".txt")
+
+    if said.is_err()
+        return fail(code: "none", msg: "no screen kept")
+    a = Asking(t: t, dir: dir, headers: probe.headers, s: s, decls: decls, c: c, u: u, words: probe.words)
+    return ok(Screened(wanted: wanted, said: said.must(), asking: a))
+
 # The line with the probe's words after it, carried in a file (defect 586,
 # `response_file.carried`): a package's compile words are among them.
 function searched(a: Asking, line: [str]) -> [str]
