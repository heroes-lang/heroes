+# How many array levels a type's text ends with: `struct c[2]` 1, `int[2][3]`
+# 2, `int[]` 1, `int *` 0.
+function rank_of(type_text: str) -> i64
+    n: i64 @= 0
+    at: i64 @= type_text.len() - 1
+
+    while at >= 0 && type_text[at] == ']'
+        while at >= 0 && type_text[at] != '['
+            at @ at - 1
+
+        n @ n + 1
+        at @ at - 1
+
+    return n
+
