extern "shapes.h"
    record S1 tag s1
        kind: i32
        fd: i32
        handle: ptr
    function dirty()
    function s1_nz(@t: S1 lent) -> i64
    function s1_fd(@t: S1 lent) -> i32

function zeroed() -> S1
    return S1(kind: 2, rest: zero)

function main()
    dirty()
    a: S1 @= zeroed()
    print(s1_fd(@a), " ", s1_nz(@a))
    b @= S1(kind: 2, fd: 7)
    print(s1_fd(@b), " ", b.fd)
