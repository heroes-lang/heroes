diff --git a/runtime/parts/lend.c b/runtime/parts/lend.c
index 6136eafdb..413c37460 100644
--- a/runtime/parts/lend.c
+++ b/runtime/parts/lend.c
@@ -487,6 +487,34 @@ void hero_lend_local_name(void *local, const char *callee, const char *param) {
     }
 }
 
+/* PANEL 215'S ROUTE G, RECURSIVE: the padding of `count` group records laid
+ * end to end from `p` zeroed in place before C reads them (issue 1334).
+ * `spans` holds `n` pairs, each a C member's offset and size in the header's
+ * own layout, written by the emitter as `__builtin_offsetof` and `sizeof` of a
+ * member the screen or the layout dump names, so clang computed every number;
+ * a union's arms each give a span, so a byte is written only where it is
+ * padding in every arm. Every byte of the `size` no pair covers is written
+ * zero; nothing a member holds is touched, so a mutex another thread is
+ * locking keeps its bytes. The gaps are found once, from the table, and the
+ * spans need no order: an arm of a union may start below the member before it
+ * in the table. */
+void hero_pad_zero(void *p, size_t size, size_t count, const size_t *spans, size_t n) {
+    unsigned char *b = p;
+    size_t at = 0;
+    while (at < size) {
+        size_t next = size;
+        int covered = 0;
+        for (size_t i = 0; i < n; i++) {
+            size_t off = spans[2 * i], len = spans[2 * i + 1];
+            if (off <= at && at < off + len) { covered = 1; at = off + len; break; }
+            if (off > at && off < next) next = off;
+        }
+        if (covered) continue;
+        for (size_t k = 0; k < count; k++) memset(b + k * size + at, 0, next - at);
+        at = next;
+    }
+}
+
 void hero_lend_local_give(void *local) {
     if (hero_lend_depth < 1) hero_panic("a local lent to C was given back twice — this is a compiler bug, please report it");
     HeroLendRegion *r = &hero_lend_regions[hero_lend_depth - 1];
