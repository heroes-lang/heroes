use core/database/sql

# Q1: every argument into an INTEGER column, then the count and the sum by one
# query. The arguments are bound as text, which the INTEGER column stores as
# the integers they read as.
function main()
    db: sql.Db @= nullptr
    assert sql.open(":memory:", @db) == sql.SQLITE_OK
    assert sql.exec(db, "create table numbers(n integer)") == sql.SQLITE_OK
    insert: sql.Stmt @= nullptr
    assert sql.prepare_v2(db, "insert into numbers(n) values (?)", @insert) == sql.SQLITE_OK

    for number in args()
        assert sql.bind_text(insert, 1, number) == sql.SQLITE_OK
        assert sql.step(insert) == sql.SQLITE_DONE
        assert sql.reset(insert) == sql.SQLITE_OK

    assert sql.finalize(@insert) == sql.SQLITE_OK
    query: sql.Stmt @= nullptr
    assert sql.prepare_v2(db, "select count(*), sum(n) from numbers", @query) == sql.SQLITE_OK
    assert sql.step(query) == sql.SQLITE_ROW
    print(f"count: {sql.column_int64(query, 0)}")

    # `sum` over no rows is NULL, which `column_int64` reads as 0.
    print(f"sum: {sql.column_int64(query, 1)}")
    assert sql.finalize(@query) == sql.SQLITE_OK
    assert sql.close(@db) == sql.SQLITE_OK
