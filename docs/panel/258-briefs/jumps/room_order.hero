extern "fixedbugs-2704-longjmp.h"
    function ab_try(cb: (function(i64) -> i64)) -> i64
    function ab_throw()

record E0
    x: i64

record E1
    a: E0
    b: E0
    c: E0
    d: E0
    e: E0
    f: E0
    g: E0
    h: E0

record E2
    a: E1
    b: E1
    c: E1
    d: E1
    e: E1
    f: E1
    g: E1
    h: E1

record E3
    a: E2
    b: E2
    c: E2
    d: E2
    e: E2
    f: E2
    g: E2
    h: E2

record E4
    a: E3
    b: E3
    c: E3
    d: E3
    e: E3
    f: E3
    g: E3
    h: E3

record E5
    a: E4
    b: E4
    c: E4
    d: E4
    e: E4
    f: E4
    g: E4
    h: E4

function body(n: i64) -> i64
    v0 = E0(x: n)
    v1 = E1(a: v0, b: v0, c: v0, d: v0, e: v0, f: v0, g: v0, h: v0)
    v2 = E2(a: v1, b: v1, c: v1, d: v1, e: v1, f: v1, g: v1, h: v1)
    v3 = E3(a: v2, b: v2, c: v2, d: v2, e: v2, f: v2, g: v2, h: v2)
    v4 = E4(a: v3, b: v3, c: v3, d: v3, e: v3, f: v3, g: v3, h: v3)
    v5 = E5(a: v4, b: v4, c: v4, d: v4, e: v4, f: v4, g: v4, h: v4)
    ab_throw()
    return v5.a.a.a.a.a.x

function main()
    w0 = E0(x: 2)
    w1 = E1(a: w0, b: w0, c: w0, d: w0, e: w0, f: w0, g: w0, h: w0)
    w2 = E2(a: w1, b: w1, c: w1, d: w1, e: w1, f: w1, g: w1, h: w1)
    w3 = E3(a: w2, b: w2, c: w2, d: w2, e: w2, f: w2, g: w2, h: w2)
    w4 = E4(a: w3, b: w3, c: w3, d: w3, e: w3, f: w3, g: w3, h: w3)
    total: i64 @= 0

    for _ in range(from: 0, to: 8)
        total @ total + ab_try(cb: body)

    print("jumped, sum ", total, " main holds ", w4.a.a.a.a.x)
