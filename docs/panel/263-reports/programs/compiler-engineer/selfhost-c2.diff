diff -ru 263-compiler-engineer/selfhost/emit/callback_guard.hero 263-compiler-engineer-scratch/sh-c2/emit/callback_guard.hero
--- 263-compiler-engineer/selfhost/emit/callback_guard.hero	2026-11-27 11:13:56
+++ 263-compiler-engineer-scratch/sh-c2/emit/callback_guard.hero	2026-11-27 11:35:21
@@ -74,13 +74,17 @@
     opened: bool
     decls: {i64: bool}
     functions: [i64]
+    # Every declaration a function C may call can reach by direct calls, the
+    # address-taken set closed under `.call` (panel 263's route (c2), the
+    # compiler-engineer's prototype): each gets a stack check at its entry.
+    checked: {i64: bool}
 
 function callbacks_of(p: containers.Program, c: state.Checked, decls: [ast.Decl]) -> Callbacks
     none: {i64: bool} = {}
     held: [i64] @= []
 
     if !takes_a_callback(p, c, decls)
-        return Callbacks(opened: false, decls: none, functions: held)
+        return Callbacks(opened: false, decls: none, functions: held, checked: none)
     taken = addresses_taken(p)
     index: i64 @= 0
 
@@ -89,8 +93,39 @@
             held @ held.push(index)
         index @ index + 1
 
-    return Callbacks(opened: true, decls: taken, functions: held)
+    return Callbacks(opened: true, decls: taken, functions: held, checked: reached(p, taken: taken))
 
+# The address-taken set closed under direct calls. A call through a function
+# value needs no edge: its target's address was taken, so it is a root. Keyed
+# by declaration as `decls` is, so every instance of a generic is checked: the
+# safe direction. A pass over the program per level of the call tree.
+function reached(p: containers.Program, taken: {i64: bool}) -> {i64: bool}
+    out: {i64: bool} @= taken
+    grew: bool @= true
+
+    while grew
+        grew @ false
+
+        for f in p.functions
+            if out[f.decl].is_err()
+                continue
+
+            for blk in f.blocks
+                for one in blk.insts
+                    match one.op
+                        .call cl =>
+                            match cl.callee
+                                .heroes_fn hf =>
+                                    if out[hf.decl].is_err()
+                                        out[hf.decl] @ true
+                                        grew @ true
+                                .extern_fn | .builtin_fn | .indirect => continue
+                        .func_ref | .lit | .load | .store | .push_owned | .unary | .binary | .cast  => continue
+                        .field | .index | .map_get | .len_of | .tag_of | .payload | .construct      => continue
+                        .copy_out | .abort_op | .incref | .decref | .decref_slot | .hole | .missing => continue
+
+    return out
+
 # Every declaration whose address an instruction of the program takes.
 function addresses_taken(p: containers.Program) -> {i64: bool}
     out: {i64: bool} @= {}
@@ -137,11 +172,18 @@
 # sentence because it has only a symbol to work from. Here the compiler knows.
 # Returned as a statement, "" for a function no thread can reach unguarded:
 # the prologue's line carries it first (`emit/body.hero`, defect 472).
-function entry(s: source.Source, f: containers.Function, guarded_decls: {i64: bool}) -> str
