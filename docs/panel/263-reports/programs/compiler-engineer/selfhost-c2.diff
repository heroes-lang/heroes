-        return ""
+function entry(s: source.Source, f: containers.Function, guarded_decls: {i64: bool}, checked_decls: {i64: bool}) -> str
     who = source.component_at(s, f.span.start) + "." + f.name
-    return "hero_thread_guard(\"" + who + "\");"
+    out: str @= ""
+
+    if !guarded_decls[f.decl].is_err()
+        out @ "hero_thread_guard(\"" + who + "\");"
+
+    if !checked_decls[f.decl].is_err()
+        if out != ""
+            out @ out + " "
+        out @ out + "hero_stack_check(\"" + who + "\");"
+    return out
 
