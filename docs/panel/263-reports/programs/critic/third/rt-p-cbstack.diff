+static void *hero_cb_on_r1(void *p, void *unused_ret, void *unused_frame) {
+    (void)unused_ret;
+    (void)unused_frame;
+    HeroCbEntry *e = (HeroCbEntry *)p;
+    e->c_sp = ((const uintptr_t *)e)[-2];
+    e->prev_current = hero_cb_current;
+    hero_cb_current = e;
+    if (e->under != NULL) e->under->occupant = e;
+    int64_t r = ((HeroCbRun1)(void *)e->run)((int64_t)(intptr_t)e->x, e->ret, e->frame);
+    hero_cb_current = e->prev_current;
+    if (e->under != NULL) {
+        if (e->under->occupant == e) e->under->occupant = NULL;
+    } else {
+        hero_cb_give(&hero_cb_thread, e->stack);
+    }
+    return (void *)(intptr_t)r;
 }
 
