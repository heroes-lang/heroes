+# A group naming the platform layer's header says so with `layer`, told where
+# it does not at its own string (design.md §1.11, §4.19; panel 260,
+# provisional, author ratification pending).
+#
+# **The layer is linked only into a program that says it needs it.** Its
+# members, C of the language's own beside the runtime (`cli/layer.hero`), are
+# compiled, asked and archived for a build only where a group of the program,
+# or of a package it reaches, says `layer` (`cli/layer_reach.hero`); a
+# program that says it nowhere links nothing of the layer and asks nothing of
+# it. So a group binding the layer without the word is refused, at the
+# package's own `check`, where its writer runs it, never left to a link that
+# cannot find the layer's names.
+#
+# **Asked of the group's own string, at `check`**, which reads no header, as
+# `check/runtime_header.hero` asks: the name as its escapes decode it, a
+# leading `./` passed over. The layer's headers obey a rule the name shows:
+# `hero_<word>.h`, written bare, but the runtime's own `hero_os.h` and
+# `hero_compiler.h`; and `platform/hero_<word>.h`, a header of the layer's
+# own folder. `cli/layer_bound.hero` holds the runtime to the rule by its test
+# and tells at `build` what only the header's includes show: a header of the
+# program's own reaching the layer's, and a group saying `layer` whose header
+# reaches none of it.
+
+use ast
+use check/state
+use diag
+use escape
+use keywords
+use source
+use token
+
+constant UNDECLARED: str
+    "ffi_layer_undeclared"
+
+constant UNREACHED: str
+    "ffi_layer_unreached"
+
+# A function of the layer's bound through a header of the program's own that
+# declares it and includes none of the layer's (`cli/layer_bound.hero`).
+constant REDECLARED: str
+    "ffi_layer_redeclared"
+
+# What a program that binds the layer pays and what one that does not is
+# spared, said by every refusal of this class: §4.17's fix, which names no
+# file the reader must open to find it.
+constant WHY: str
+    "the platform layer's members are compiled and linked only for a program whose groups say `layer`; a program none of whose groups says it links nothing of the layer, so its build asks nothing of it"
+
+# Each group naming a layer header without `layer`, told once, at its string.
+function refused(@c: state.Checker, s: source.Source, decls: [ast.Decl])
+    told: {i64: bool} @= {}
+
+    for decl in decls
+        head = head_of(decl)
+
+        if head.header.is_err() || !head.layer.is_err()
+            continue
+        span = head.header.must()
+
+        if !told[span.start].is_err() || !names_layer(escape.unescape(source.span_text(s, span)))
+            continue
+        told[span.start] @ true
+        state.push_diagnostic(@c, undeclared(header: source.span_text(s, span), span: span, through: ""))
+
+# The refusal of a group whose header is, or reaches through `through`, the
+# layer's, at the group's string, with the word inserted after it as its
+# certain fix: the word repairs exactly what is told, and the program it
+# writes builds with the layer on its link.
+function undeclared(header: str, span: token.Span, through: str) -> diag.Diagnostic
+    what: str @= "`" + bare(header) + "` is the platform layer's header"
+
+    if through.len() > 0
+        what @ "`" + bare(header) + "` reaches the platform layer's " + through
+    d: diag.Diagnostic @= diag.new_diagnostic(
+        code: UNDECLARED,
+        message: what + ", and this group does not say `" + keywords.WORD_LAYER + "`: write `extern " + header + " " + keywords.WORD_LAYER + "`",
+        span: span
+    )
+    d.notes @ d.notes.push(WHY)
+    d.fixes @ d.fixes.push(
+        diag.Fix(title: "say `" + keywords.WORD_LAYER + "` after the header", replacement: " " + keywords.WORD_LAYER, span: token.Span(start: span.end, end: span.end), certainty: .certain)
+    )
+    return d
+
+# The refusal of a group saying `layer` whose header is not the layer's and
+# reaches none of its headers, at the word, with the word taken out as its
+# certain fix.
+function unreached(header: str, word: token.Span, from: i64) -> diag.Diagnostic
+    d: diag.Diagnostic @= diag.new_diagnostic(
+        code: UNREACHED,
+        message: "this group says `" + keywords.WORD_LAYER + "`, and `" + bare(header) + "` is none of the platform layer's headers and includes none of them, so nothing it binds is the layer's: take the word out, or name the layer's header that declares what this group binds",
+        span: word
+    )
+    d.notes @ d.notes.push(
+        WHY + "; a word that binds nothing makes every program reaching this group pay for the layer"
+    )
+    d.fixes @ d.fixes.push(
+        diag.Fix(title: "take `" + keywords.WORD_LAYER + "` out", replacement: "", span: token.Span(start: from, end: word.end), certainty: .certain)
+    )
+    return d
+
+# A header's string as a message names it: its quotes taken off.
+function bare(spelled: str) -> str
+    if spelled.len() >= 2 && spelled[0] == '"' && spelled[spelled.len() - 1] == '"'
+        return spelled.slice(from: 1, to: spelled.len() - 1)
+    return spelled
+
+# Whether a group's header, as its escapes decode it, names a header of the
+# platform layer: `hero_<word>.h` written bare but `hero_os.h` and
+# `hero_compiler.h`, the runtime's own, or `platform/hero_<word>.h`; a
+# leading `./` passed over.
+function names_layer(header: str) -> bool
+    at: i64 @= 0
+
+    while at + 1 < header.len() && header[at] == '.' && header[at + 1] == '/'
+        at @ at + 2
+
+    name = header.slice(from: at, to: header.len())
+    folder = "platform/"
+
+    if name.len() > folder.len() && name.slice(from: 0, to: folder.len()) == folder
+        return layer_stem(name.slice(from: folder.len(), to: name.len()))
+    return layer_stem(name) && name != "hero_os.h" && name != "hero_compiler.h"
+
+# `hero_<word>.h` with no folder: a name past `hero_`, then `.h`.
+function layer_stem(name: str) -> bool
+    head = "hero_"
+
+    if name.len() <= head.len() + 2 || name.slice(from: 0, to: head.len()) != head || name.slice(from: name.len() - 2, to: name.len()) != ".h"
+        return false
+
+    for at in range(from: 0, to: name.len())
+        if name[at] == '/' || name[at] == '\\'
+            return false
+
+    return true
+
+# A group member's head line: the header it names and its `layer`, each
+# absent outside a group.
+record Head
+    header: token.Span?
+    layer: token.Span?
+
+function head_of(decl: ast.Decl) -> Head
+    none_h: token.Span? = fail(code: "none", msg: "no header")
+    none_w: token.Span? = fail(code: "none", msg: "no layer")
+
+    match decl.kind
+        .function_decl fd          => return Head(header: fd.value.header, layer: fd.value.layer)
+        .constant_decl k           => return Head(header: k.header, layer: k.layer)
+        .record_decl rec           => return Head(header: rec.header, layer: rec.layer)
+        .variant_decl | .test_decl => return Head(header: none_h, layer: none_w)
+
+    return Head(header: none_h, layer: none_w)
+
+# Whether any group of `decls` says `layer`: the program's link carries the
+# layer exactly then.
+function declared(decls: [ast.Decl]) -> bool
+    for decl in decls
+        if !head_of(decl).layer.is_err()
+            return true
+
+    return false
+
+## Tests
+
+test "the layer's headers are named by the rule the runtime obeys, the runtime's own two left out (panel 260)"
+    for name in ["hero_time.h", "hero_net.h", "./hero_ui.h", "hero_audio_coreaudio.h", "platform/hero_audio_arm.h", "./platform/hero_ui_appkit.h"]
+        assert names_layer(name)
+
+    for other in ["hero_os.h", "hero_compiler.h", "./hero_os.h", "heroes_runtime.h", "stdio.h", "my/hero_time.h", "hero_.h", "hero_time.hh", "xhero_time.h", "platform/my.h", "platform/sub/hero_x.h", "", ".", "./"]
+        assert !names_layer(other)
+
+test "a group's head says layer only where its line wrote the word (panel 260)"
+    zero = token.Span(start: 0, end: 1)
+    fields: [ast.Field] = []
+    said: ast.Decl = ast.Decl(
+        name: zero,
+        doc: [],
+        span: zero,
+        kind: .record_decl(fields: fields, header: ok(zero), library: fail(code: "absent", msg: "none"), layer: ok(zero), partial: false, tag: fail(code: "absent", msg: "none"))
+    )
+    unsaid: ast.Decl = ast.Decl(
+        name: zero,
+        doc: [],
+        span: zero,
+        kind: .record_decl(fields: fields, header: ok(zero), library: fail(code: "absent", msg: "none"), layer: fail(code: "absent", msg: "none"), partial: false, tag: fail(code: "absent", msg: "none"))
+    )
+    assert declared([unsaid, said])
+    assert !declared([unsaid])
+    none: [ast.Decl] = []
+    assert !declared(none)
diff --git a/selfhost/cli/layer_bound.hero b/selfhost/cli/layer_bound.hero
new file mode 100644
index 000000000..75ea0ee36
--- /dev/null
+++ b/selfhost/cli/layer_bound.hero
@@ -0,0 +1,365 @@
+# What a build knows of the platform layer that `check` cannot: a header of
+# the program's own reaching the layer's, a group saying `layer` whose header
+# reaches none of it, and a link missing a name the layer has (design.md
+# §1.11, §4.19; panel 260, provisional, author ratification pending).
+#
+# **A group binds the layer where its header is the layer's or reaches it.**
+# `check/layer_header.hero` reads the first half from the group's string;
+# the second is read here from the walk every build already makes before its
+# first clang (`cli/include_stands.hero`), which follows each group's header
+# and every file it includes, to any depth, as clang's search finds them,
+# every `#if` but `#if 0` read as true. One reading decides both refusals,
+# so no program is refused both with the word and without it: a group that
+# binds says `layer`, and a group that says `layer` binds.
+#
+# **A file is the layer's** where it stands in the runtime's folder and its
+# path there obeys the rule `check` reads names by, or lies under `vendor/`,
+# the C a member compiles inside itself; the runtime's own headers, which
+# every unit reads, include none of them (the test below holds both to the
+# runtime's own list, `runtime.c`'s block of the layer's files).
+#
+# **What the walk cannot see is the link's to say**: a header of the
+# program's own that declares a function of the layer itself, or calls one
+# from a body, and includes none of the layer's headers. A program none of
+# whose groups says `layer` links none of the layer, so such a link misses
+# the name; it is told here, before every other reader of a refused link
+# (`cli/whose.hero`), at the binding that names it or at the group whose
+# header is the program's own, never as `internal error: linking failed` and
+# never as a name no group says which library has.
+
+use ast
+use check/layer_header
+use cli/deps
+use cli/include_told
+use cli/link_report
+use cli/own_names
+use cli/package_reads
+use cli/runtime_bound
+use cli/runtime_key
+use cli/toolchain
+use diag
+use emit/c_words
+use emit/externs as emit_externs
+use module/reading
+use source
+use token
+
+# The path of `path` in the runtime's folder `runtime` where it is the
+# layer's, read lexically as `include_told.file_said` reads a file of the
+# runtime's; "" where it is not: a header whose name the rule calls the
+# layer's, and any file under `platform/`, the members and what they include,
+# or under `vendor/`, the C a member compiles inside itself.
+function layer_path(runtime: str, path: str) -> str
+    at = package_reads.lexical(path)
+    home = package_reads.lexical(runtime)
+
+    if !include_told.within(place: at, folders: [home])
+        return ""
+    inside = at.slice(from: home.len() + 1, to: at.len())
+
+    if layer_header.names_layer(inside) || opens(text: inside, head: "platform/") || opens(text: inside, head: "vendor/")
+        return inside
+    return ""
+
+# Each group of `decls` whose header is one of `headers`, judged by what the
+# walk found its header reaches: `reached[i]`, the layer's file the walk met
+# first below `headers[i]`, "" where it met none. A group that reaches one and
+# does not say `layer` is refused at its string; one that says `layer`, whose
+# header is not the layer's by its name and reaches none of its files, at its
+# word, or, where it binds a name a header of the layer declares, at that
+# binding (`redeclared`). Each group once, in the order the declarations
+# stand; the layer's headers are read only where a group says the word and its
+# header reaches none of them.
+function told(s: source.Source, decls: [ast.Decl], headers: [str], reached: [str], runtime: str) -> [diag.Diagnostic]
+    out: [diag.Diagnostic] @= []
+    seen: {i64: bool} @= {}
+    names: {str: str} @= {}
+    read: bool @= false
+    declared = layer_header.declared(decls)
+
+    for decl in decls
+        head = layer_header.head_of(decl)
+
+        if head.header.is_err()
+            continue
+        span = head.header.must()
+
+        if !seen[span.start].is_err()
+            continue
+        named = emit_externs.unquoted(s, span: span)
+        at = index_of(headers, name: named)
+
+        if at < 0
+            continue
+        seen[span.start] @ true
+        spelled = source.span_text(s, span)
+        by_name = layer_header.names_layer(named)
+
+        if head.layer.is_err() && !by_name && reached[at].len() > 0
+            out @ out.push(layer_header.undeclared(header: spelled, span: span, through: "`" + reached[at] + "`"))
+        else if !head.layer.is_err() && !by_name && reached[at].len() == 0
+            if !read
+                names @ declared_names(runtime)
+                read @ true
+            bound = bound_in_group(s, decls, header: span, names: names)
+
+            if bound.is_err()
+                out @ out.push(layer_header.unreached(header: spelled, word: head.layer.must(), from: span.end))
+            else
+                out @ out.push(
+                    redeclared(name: bound.must().name, header: names[bound.must().name].default(""), own: spelled, span: bound.must().span)
+                )
+        else if head.layer.is_err() && !by_name && reached[at].len() == 0 && declared
+            # Where another group says the word, the layer is on the link and
+            # a binding of its function through a declaration of the program's
+            # would link unseen: asked of the names, as the word's own group is.
+            if !read
+                names @ declared_names(runtime)
+                read @ true
+            bound = bound_in_group(s, decls, header: span, names: names)
+
+            if !bound.is_err()
+                out @ out.push(
+                    redeclared(name: bound.must().name, header: names[bound.must().name].default(""), own: spelled, span: bound.must().span)
+                )
+
+    return out
+
+# The first file of the layer's, its path in the runtime's folder, that the
+# walk's `edges` reach from `root`, itself included, breadth first; "" where
+# none is, or `root` is "".
+function first_reached(edges: {str: [str]}, root: str, runtime: str) -> str
+    if root.len() == 0
+        return ""
+    queue: [str] @= [root]
+    seen: {str: bool} @= {}
+    seen[root] @ true
+    at: i64 @= 0
+
+    while at < queue.len()
+        path = queue[at]
+        at @ at + 1
+        inside = layer_path(runtime: runtime, path: path)
+
+        if inside.len() > 0
+            return inside
+
+        for next in edges[path].default([])
+            if seen[next].is_err()
+                seen[next] @ true
+                queue @ queue.push(next)
+
+    return ""
+
+# A name of the group whose header string is `header` that a header of the
+# layer declares (`names`), with where it is bound: the first, in the order
+# the declarations stand.
+record Bound
+    name: str
+    span: token.Span
+
+function bound_in_group(s: source.Source, decls: [ast.Decl], header: token.Span, names: {str: str}) -> Bound?
+    for decl in decls
+        head = layer_header.head_of(decl)
+        bound = runtime_bound.bound(decl)
+
+        if head.header.is_err() || bound.is_err() || head.header.must().start != header.start
+            continue
+        name = source.span_text(s, bound.must())
+
+        if !names[name].is_err()
+            return ok(Bound(name: name, span: bound.must()))
+
+    return fail(code: "none", msg: "binds no name of the layer's")
+
+# A group saying `layer` that binds a function of the layer through a header
+# of its own, which declares it and includes none of the layer's: told at the
+# binding. Its fix names the layer's header, a guess, since the group may bind
+# more of its own header than that name.
+function redeclared(name: str, header: str, own: str, span: token.Span) -> diag.Diagnostic
+    d: diag.Diagnostic @= diag.new_diagnostic(
+        code: layer_header.REDECLARED,
+        message: "`" + name + "` is the platform layer's, declared by its `" + header + "`, and this group binds it through `" + layer_header.bare(own) + "`, which includes none of the layer's headers: name `" + header + "` in the group, or include it in `" + layer_header.bare(own) + "`",
+        span: span
+    )
+    d.notes @ d.notes.push(REDECLARED)
+    return d
+
+# Why a binding of the layer's own function through a declaration of the
+# program's is refused, which every refusal of that shape says.
+constant REDECLARED: str
+    "clang checks a binding against the header its group names, so a function of the layer's declared by the program itself is checked against nothing the layer wrote: a parameter or a result of another width there is a call the layer reads otherwise"
+
+function opens(text: str, head: str) -> bool
+    return text.len() > head.len() && text.slice(from: 0, to: head.len()) == head
+
+function index_of(list: [str], name: str) -> i64
+    for at in range(from: 0, to: list.len())
+        if list[at] == name
+            return at
+
+    return -1
+
+## A link that misses a name of the layer's
+
+# The diagnostics for a refused link's `message` where no group of the
+# program says `layer`, its link carrying none of the layer: one per name the
+# link reports that a header of the layer declares, in the runtime's own forms
+# (`own_names.reserved`), at the binding of that name, or else at the first
+# group whose header is the program's own, the layer's header named. None
+# where a group says `layer`, or no name reported is the layer's: the other
+# readers' then (`cli/whose.hero`).
+function told_at_link(message: str, s: source.Source, decls: [ast.Decl], t: toolchain.Toolchain) -> [diag.Diagnostic]
+    out: [diag.Diagnostic] @= []
+
+    if layer_header.declared(decls)
+        return out
+    refs = link_report.references(message)
+
+    if refs.len() == 0
+        return out
+    names = declared_names(t.runtime)
+    told_names: {str: bool} @= {}
+
+    for one in refs
+        header = names[one.symbol]
+
+        if header.is_err() || !told_names[one.symbol].is_err()
+            continue
+        told_names[one.symbol] @ true
+        at = binding_of(s, decls, name: one.symbol)
+
+        if !at.is_err()
+            out @ out.push(missing(name: one.symbol, header: header.must(), span: at.must(), bound: true))
+            continue
+        own = first_own_group(s, decls)
+
+        if !own.is_err()
+            out @ out.push(missing(name: one.symbol, header: header.must(), span: own.must(), bound: false))
+
+    return out
+
+function missing(name: str, header: str, span: token.Span, bound: bool) -> diag.Diagnostic
+    how: str @= "this group binds it"
+
+    if !bound
+        how @ "this group's header puts it in the program's own code"
+    d: diag.Diagnostic @= diag.new_diagnostic(
+        code: layer_header.UNDECLARED,
+        message: "`" + name + "` is the platform layer's, declared by its `" + header + "`, and " + how + " through a header that includes none of the layer's, so no group of this program says `layer` and its link carries none of the layer: name `" + header + "` in this group, or include it in the group's header, and say `layer` after the header",
+        span: span
+    )
+    d.notes @ d.notes.push(layer_header.WHY)
+    d.notes @ d.notes.push(REDECLARED)
+    d.fixes @ d.fixes.push(
+        diag.Fix(title: "name the layer's header and say `layer`", replacement: "\"" + header + "\" layer", span: span, certainty: .guess)
+    )
+    return d
+
+# The header string of the group binding the C name `name`, where one does.
+function binding_of(s: source.Source, decls: [ast.Decl], name: str) -> token.Span?
+    for decl in decls
+        bound = runtime_bound.bound(decl)
+        head = layer_header.head_of(decl)
+
+        if !bound.is_err() && !head.header.is_err() && source.span_text(s, bound.must()) == name
+            return head.header
+
+    return fail(code: "none", msg: "no group binds it")
+
+# The header string of the first group whose header is no layer's by its name.
+function first_own_group(s: source.Source, decls: [ast.Decl]) -> token.Span?
+    for decl in decls
+        head = layer_header.head_of(decl)
+
+        if !head.header.is_err() && !layer_header.names_layer(emit_externs.unquoted(s, span: head.header.must()))
+            return head.header
+
+    return fail(code: "none", msg: "no group of the program's own")
+
+# Each name in the runtime's own forms a header of the layer declares, with
+# the first such header's path in the runtime's folder: the layer's headers
+# are the files `runtime.c` names that `layer_path` calls the layer's.
+function declared_names(runtime: str) -> {str: str}
+    out: {str: str} @= {}
+    files = runtime_key.made_of(runtime)
+
+    if files.is_err()
+        return out
+
+    for path in files.must()
+        inside = layer_path(runtime: runtime, path: path)
+
+        if inside.len() < 3 || inside.slice(from: inside.len() - 2, to: inside.len()) != ".h"
+            continue
+        text = reading.text_of(path)
+
+        if text.is_err()
+            continue
+        words = c_words.used(text.must())
+
+        # ORDER: none — each name keeps the first header in `made_of`'s order,
+        # the order `runtime.c` writes, whatever order `keys` gives.
+        for word in keys(words)
+            if own_names.reserved(word) && out[word].is_err()
+                out[word] @ inside
+
+    return out
+
+## Tests
+
+# **The rule a group's string obeys is the runtime's own list**: every file
+# `runtime.c` names in the block its preprocessor never reads is the layer's
+# by `layer_path`, the members, their headers and what a member compiles
+# inside itself; and every header the runtime ships whose name the rule calls
+# the layer's is named in that block, but the five `platform/hero_layer_*.h`
+# the runtime's own unit includes as well, which the rule calls the layer's in
+# the loud direction. The runtime's own headers, `hero_os.h`, `hero_compiler.h`
+# and `heroes_*.h`, are none of it.
+test "the rule names the layer's files exactly as the runtime's never-read block does (panel 260)"
+    t = toolchain.locate_toolchain(hint: "", fingerprint: "port-test").must()
+    text = reading.text_of(t.runtime + "/runtime.c").must()
+    block: [str] @= []
+    inside: bool @= false
+
+    for line in deps.lines(text)
+        if line == "#if 0"
+            inside @ true
+        else if line == "#endif"
+            inside @ false
+        else if inside && line.len() > 11 && line.slice(from: 0, to: 10) == "#include \""
+            block @ block.push(line.slice(from: 10, to: line.len() - 1))
+
+    assert block.len() > 0
+
+    for name in block
+        assert layer_path(runtime: t.runtime, path: t.runtime + "/" + name) == name
+
+    for member in runtime_key.layer_members(t.runtime).must()
+        assert layer_path(runtime: t.runtime, path: member).len() > 0
+
