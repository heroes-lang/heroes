# Comma-separated values, quoted: the module `quote` of the package its
# authors call `csv`, https://git.example.org/ben/csv at tag v0.9.4
# (panel 235's reader test).

# `field` inside double quotes, each double quote in it doubled.
function quote_field(field: str) -> str
    out @= "\""

    for c in field.chars()
        if c == "\""
            out @ out + "\"\""
        else
            out @ out + c

    return out + "\""

test "a plain field and one holding a quote"
    assert quote_field("red") == "\"red\""
    assert quote_field("a\"b") == "\"a\"\"b\""
