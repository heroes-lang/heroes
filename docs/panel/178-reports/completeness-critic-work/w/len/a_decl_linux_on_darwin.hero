# Panel 178, compiler-engineer: route A on `uname`, `partial` plus `[0; 256]`.
extern "sys/utsname.h"
    record Utsname tag utsname partial
        sysname: i8[65]
    function uname(@u: Utsname) -> i32

function main()
    u: Utsname @ Utsname(sysname: [0; 256])
    _ = uname(@u).to_i64().must()
    print(u.sysname.validated_bytes().must())
