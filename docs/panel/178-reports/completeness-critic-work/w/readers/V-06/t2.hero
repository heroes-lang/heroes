extern "app.h"
    record sockaddr_un
        sun_len: u8
        sun_family: u8
        sun_path: u8[104]
    function app_connect(@addr: sockaddr_un) -> i32

function main()
    path = "/tmp/app.sock"
    if path.len() >= 104
        print("path too long")
        exit(code: 1)
    addr: sockaddr_un @ sockaddr_un(sun_family: 1, rest: zero)
    for i in range(from: 0, to: path.len())
        addr.sun_path[i] @ path[i]
    fd = app_connect(@addr)
    if fd == -1
        print("connect failed")
        exit(code: 1)
    print("connected, descriptor ", fd)
