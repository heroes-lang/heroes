# Critic, panel 178: glibc's pthread_mutex_t named by its typedef, no tag (the ffi seat wrote `tag pthread_mutex_t`).
extern "pthread.h"
    record pthread_mutex_t partial
        __align: i64
    function pthread_mutex_init(@m: pthread_mutex_t, attr: ptr) -> i32
    function pthread_mutex_lock(@m: pthread_mutex_t) -> i32
    function pthread_mutex_unlock(@m: pthread_mutex_t) -> i32

function main()
    m: pthread_mutex_t @ pthread_mutex_t(__align: 0)
    print(pthread_mutex_lock(@m))
    print(pthread_mutex_unlock(@m))
