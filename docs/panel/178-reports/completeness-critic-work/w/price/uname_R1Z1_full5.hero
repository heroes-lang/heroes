extern "sys/utsname.h"
    record Utsname tag utsname zero
        sysname: i8[256]
        nodename: i8[256]
        release: i8[256]
        version: i8[256]
        machine: i8[256]
    function uname(@u: Utsname) -> i32

function main()
    u: Utsname @ Utsname(rest: zero)
    _ = uname(@u).to_i64().must()
    print(u.sysname.validated_bytes().must())
