extern "sys/utsname.h"
    record Utsname tag utsname
        sysname: i8[256]
        nodename: i8[256]
        release: i8[256]
        version: i8[256]
        machine: i8[256]
    function uname(@u: Utsname) -> i32

function main()
    u: Utsname @ Utsname(
        sysname: [0; 256],
        nodename: [0; 256],
        release: [0; 256],
        version: [0; 256],
        machine: [0; 256]
    )
    _ = uname(@u).to_i64().must()
    print(u.sysname.validated_bytes().must())
