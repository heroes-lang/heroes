+# `rest: zero` at a construction (panel 178 R1): which declared field each
+# written argument names, asked of the declaration and the labels alone, so the
+# checker and the lowering read one answer rather than two.
+#
+# The rule is §4.9's with one clause removed and none added: every argument is
+# named, none is repeated, and they come in declared order; what `rest: zero`
+# lifts is only that ALL of them be there, and only for a record a header
+# declares, whose layout is C's and whose zero C already defines.
+
+use token
+use diag
+use ast
+use source
+use resolved
+use data_errors
+
+# One entry per written argument: the field it names, or -1 where it named
+# none in order (the diagnostic says which).
+record Plan
+    fields: [i64]
+    diagnostics: [diag.Diagnostic]
+
+# The words, read off the node that carries them.
+function rest_of(a: ast.Ast, at: i64) -> token.Span?
+    return match a.exprs[at].kind
+        .call cl  => cl.rest
+        .method m => m.rest
+        .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit | .null_ptr => fail(
+            code: "none",
+            msg: "no rest"
+        )
+        .name | .hole | .unary | .binary | .field | .field_name | .index => fail(code: "none", msg: "no rest")
+        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error => fail(
+            code: "none",
+            msg: "no rest"
+        )
+
+# Whether the callee names a record, which is the one call `rest: zero` closes.
+function names_a_record(a: ast.Ast, r: resolved.Resolved, decls: [ast.Decl], callee: i64) -> bool
+    match a.exprs[callee].kind
+        .name =>
+            match r.uses[callee]
+                .top t                                    => return is_record(decls[t.at].kind)
+                .local | .builtin | .module | .unresolved => return false
+        .int_lit | .char_lit | .float_lit | .str_lit | .interp | .bool_lit | .null_ptr => return false
+        .hole | .unary | .binary | .field | .field_name | .index | .call | .method     => return false
+        .variant_case | .array | .map | .try_expr | .if_expr | .match_expr | .error    => return false
+
+    return false
+
+# `geom.Point(...)`: the receiver names a module and the name after it a record.
+function qualified_record(r: resolved.Resolved, decls: [ast.Decl], receiver: i64, at: i64) -> bool
+    if r.uses[receiver] != .module
+        return false
+
+    match r.uses[at]
+        .top t                                    => return is_record(decls[t.at].kind)
+        .local | .builtin | .module | .unresolved => return false
+
+    return false
+
+function names_rest(names: [str]) -> bool
+    for n in names
+        if n == "rest"
+            return true
+
+    return false
+
+function is_record(kind: ast.DeclKind) -> bool
+    return match kind
+        .record_decl                                                 => true
+        .constant_decl | .function_decl | .variant_decl | .test_decl => false
+
+function plan(a: ast.Ast, s: source.Source, decls: [ast.Decl], decl: i64, given: [ast.Arg], rest: token.Span, declared_at: str) -> Plan
+    out: Plan @ Plan(fields: [], diagnostics: [])
+    holder = source.span_text(s, decls[decl].name)
+    fields: [ast.Field] @ []
+    in_group: bool @ false
+
+    match decls[decl].kind
+        .record_decl rec =>
+            fields @ rec.fields
+            in_group @ !rec.header.is_err()
+        .constant_decl | .function_decl | .variant_decl | .test_decl => in_group @ false
+
+    names: [str] @ []
+
+    for f in fields
+        names @ names.push(source.span_text(s, f.name))
+
+    if !in_group
+        out.diagnostics @ out.diagnostics.push(
+            data_errors.rest_outside_a_group(holder: holder, declared_at: declared_at, span: rest)
+        )
+    else if names_rest(names)
+        out.diagnostics @ out.diagnostics.push(data_errors.rest_is_a_field(holder: holder, span: rest))
+    next: i64 @ 0
+
+    for arg in given
+        found: i64 @ -1
+
+        if arg.name.is_err()
+            out.diagnostics @ out.diagnostics.push(
+                data_errors.field_unnamed(holder: holder, span: a.exprs[arg.value].span)
+            )
+        else
+            written = source.span_text(s, arg.name.must())
+            at: i64 @ next
+
+            while at < names.len() && found < 0
+                if names[at] == written
+                    found @ at
+                at @ at + 1
+
+            if found < 0
+                out.diagnostics @ out.diagnostics.push(
+                    data_errors.field_out_of_order(holder: holder, written: written, fields: names, span: arg.name.must())
+                )
+            else
+                next @ found + 1
+        out.fields @ out.fields.push(found)
+
+    return out
