+# The fields `rest: zero` leaves out, lowered to what they are (panel 178 R1).
+# Erased HERE, on the way into the IR (design.md §1.7): the construction that
+# leaves this module names every declared field in declared order, exactly as
+# Part 5's row says, and the fields the author left out are zero values of
+# their own types — so nothing after lowering knows the words were written.
+#
+# A group's field is a number, `bool`, `ptr`, `cstr`, another record of the
+# group or a fixed array of one (spec § 13), and each has a zero that is a
+# value of Heroes: 0, false, nullptr, a record of zeros, a handle's nullptr.
+# The fixed array is the one with no C value to spell, and it is an EMPTY
+# construction of its type, which `emit/storageless.hero` writes `{0}`; a
+# literal of a `T[N]` always has N elements, so an empty one means nothing else.
+
+use token
+use ast
+use source
+use check/table
+use check/state
+use check/contextual
+use ir
+use ir/build
+use ir/containers
+use handles
+
+# The declared-order run: each written argument where its label names the
+# field, a zero of the field's type everywhere else.
+function fill(@b: build.Lowering, c: state.Checked, s: source.Source, decls: [ast.Decl], decl: i64, given: [ast.Arg], lowered: ir.Run, span: token.Span) -> ir.Run
+    written = containers.args_of(b.building, lowered)
+    out: [ir.Arg] @ []
+    next: i64 @ 0
+
+    for f in fields_of(decls, decl)
+        name = source.span_text(s, f.name)
+
+        if next < given.len() && source.span_text(s, given[next].name.must()) == name
+            out @ out.push(written[next])
+            next @ next + 1
+        else
+            out @ out.push(.value_arg(value: zero_of(@b, c, s, decls, ty: field_type(c, f), span: span)))
+
+    return build.args_run(@b, out)
+
+function fields_of(decls: [ast.Decl], decl: i64) -> [ast.Field]
+    return match decls[decl].kind
+        .record_decl rec                                             => rec.fields
+        .constant_decl | .function_decl | .variant_decl | .test_decl => []
+
+function field_type(c: state.Checked, f: ast.Field) -> i64
+    return state.written_type(c, f.ty).must()
+
+function zero_of(@b: build.Lowering, c: state.Checked, s: source.Source, decls: [ast.Decl], ty: i64, span: token.Span) -> i64
+    nothing: [ir.Arg] = []
+
+    match table.get(c.types, ty)
+        .int_ty => return build.emit(
+            @b,
+            op: .lit(value: .int_const(value: contextual.LitValue(negative: false, magnitude: 0))),
+            ty: ty,
+            span: span
+        )
+        .float_ty    => return build.emit(@b, op: .lit(value: .float_const(text: "0.0")), ty: ty, span: span)
+        .bool        => return build.emit(@b, op: .lit(value: .bool_const(value: false)), ty: ty, span: span)
+        .ptr | .cstr => return build.emit(@b, op: .lit(value: .null_ptr), ty: ty, span: span)
+        .fixed => return build.emit(
+            @b,
+            op: .construct(shape: .array_shape, arguments: build.args_run(@b, nothing)),
+            ty: ty,
+            span: span
+        )
+        .named n =>
+            if handles.is_handle(decls[n.decl])
+                return build.emit(@b, op: .lit(value: .null_ptr), ty: ty, span: span)
+            parts: [ir.Arg] @ []
+
+            for f in fields_of(decls, n.decl)
+                parts @ parts.push(.value_arg(value: zero_of(@b, c, s, decls, ty: field_type(c, f), span: span)))
+
+            return build.emit(
+                @b,
+                op: .construct(shape: .record_shape(decl: n.decl), arguments: build.args_run(@b, parts)),
+                ty: ty,
+                span: span
+            )
+        .str | .unit | .array | .map | .fallible | .function_ty => return build.emit(
+            @b,
+            op: .missing,
+            ty: ty,
+            span: span
+        )
+        .case_ty | .failure | .generic | .error => return build.emit(@b, op: .missing, ty: ty, span: span)
+
+    return build.emit(@b, op: .missing, ty: ty, span: span)
