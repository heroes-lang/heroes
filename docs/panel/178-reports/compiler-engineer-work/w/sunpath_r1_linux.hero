# Panel 178, compiler-engineer: R1 plus the repaired element store, `sun_path`, Linux.
extern "sys/un.h"
    record SockaddrUn tag sockaddr_un partial
        sun_family: u16
        sun_path: i8[108]

function main()
    a: SockaddrUn @ SockaddrUn(sun_family: 1, rest: zero)
    path = "/tmp/heroes-178.sock"
    i: i64 @ 0

    while i < path.len()
        a.sun_path[i] @ path[i].to_i8().must()
        i @ i + 1

    print(a.sun_family, " ", a.sun_path.validated_bytes().must())
