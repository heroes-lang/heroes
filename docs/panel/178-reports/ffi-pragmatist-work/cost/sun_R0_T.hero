# Panel 178 ffi-pragmatist, route S + L: zero `sun_path`, write the path byte by byte, bind, connect.
extern "un_shim.h"
    constant AF_UNIX: i64
    constant SOCK_STREAM: i64
    record SockaddrUn tag sockaddr_un partial
        sun_family: u8
        sun_path: i8[104]
    record SockaddrStorage tag sockaddr_storage partial
        ss_family: u8
    function socket(domain: i32, kind: i32, protocol: i32) -> i32
    function listen(fd: i32, backlog: i32) -> i32
    function close(fd: i32) -> i32
    function unlink(path: cstr lent) -> i32
    function hero_bind_un(fd: i32, @a: SockaddrUn) -> i32
    function hero_connect_un(fd: i32, @a: SockaddrUn) -> i32
    function hero_getsockname_un(fd: i32, @a: SockaddrUn) -> i32
    function hero_getsockname_ss(fd: i32, @s: SockaddrStorage) -> i32

function main()
    path = "/tmp/heroes-178-s.sock"
    _ = unlink(path.cstr())
    a: SockaddrUn @ SockaddrUn.zero()
    a.sun_family @ AF_UNIX.to_u8().must()
    a.sun_path @ path.to_fixed().must()
    server = socket(domain: AF_UNIX.to_i32().must(), kind: SOCK_STREAM.to_i32().must(), protocol: 0)
    print(hero_bind_un(fd: server, @a))
    print(listen(fd: server, backlog: 1))
    client = socket(domain: AF_UNIX.to_i32().must(), kind: SOCK_STREAM.to_i32().must(), protocol: 0)
    print(hero_connect_un(fd: client, @a))
    back: SockaddrUn @ SockaddrUn.zero()
    print(hero_getsockname_un(fd: server, @back))
    print(back.sun_path.validated_bytes().must())
    ss: SockaddrStorage @ SockaddrStorage(ss_family: 0)
    print(hero_getsockname_ss(fd: server, @ss))
    print(ss.ss_family)
    _ = close(fd: client)
    _ = close(fd: server)
    _ = unlink(path.cstr())
