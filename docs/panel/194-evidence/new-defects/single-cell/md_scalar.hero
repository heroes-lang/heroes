# Today: the digest written through a ONE-byte cell lent to `unsigned char *md` (C writes 32).
extern "sha_shim.h" package "libcrypto"
    record Digest32 tag digest32
        b: u8[32]
    constant DIGEST32_ZERO: Digest32
    record Sha256Ctx tag SHA256state_st partial
        num: u32
    function SHA256_Init(@c: Sha256Ctx) -> i32
    function SHA256_Update(@c: Sha256Ctx, data: cstr lent, len: u64) -> i32
    function SHA256_Final(@md: u8, @c: Sha256Ctx) -> i32

function main()
    c: Sha256Ctx @ Sha256Ctx(num: 0)
    m: u8 @ 0
    print(SHA256_Init(@c))
    print(SHA256_Update(@c, data: "abc".cstr(), len: 3))
    print(SHA256_Final(md: @m, @c))
    print(m)
