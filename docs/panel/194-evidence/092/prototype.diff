+function record_void(s: source.Source, decls: [ast.Decl], line: str) -> diag.Diagnostic?
+    if !ffi_lookup.has(text: line, needle: ffi_lookup.FAILED)
+        return fail(code: "none", msg: "not an assertion failure")
+    rest = ffi_lookup.after(text: line, marker: RECORD_VOID_MARKER)
+
