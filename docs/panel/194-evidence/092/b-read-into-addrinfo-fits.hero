extern "netdb.h"
    record Hints tag addrinfo partial
        ai_family: i32
        ai_socktype: i32

extern "unistd.h"
    function read(fd: i32, buf: ptr counted_by n lent, n: u64) -> i64

function main()
    h: Hints @ Hints(ai_family: 0, ai_socktype: 1)
    n = read(fd: 0, buf: h.ptr(), n: 8)
    print(n)
    print(h.ai_family)
