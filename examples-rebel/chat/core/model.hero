# What the chat holds: a message posted in a room, a direct message between
# two people, a page of a room's history, and the rules a user's name, a
# room's name and a message's text are held to. The server checks every one
# of them on what a client or a bridge sends before it stores or routes
# anything, so a name in the database or on the wire is always one these
# rules accept.

use <rebel>/strings
use <rebel>/time

# The code of a name or a text these rules refuse.
constant INVALID: str
    "invalid"

# The most bytes of one message's text: a chat line, not a document, and a
# bound on what one frame of a client makes the server store.
constant MOST_TEXT_BYTES: i64
    4000

# The messages a page holds where the client asks for none in particular.
constant PAGE_SIZE: i64
    50

# The most messages one page holds, whatever the client asks.
constant MOST_PAGE_SIZE: i64
    200

# Where a message came from: a client of this server, or a broker a room is
# mirrored to.
variant Origin
    # A client signed in to this server.
    chat
    # An MQTT topic a room is mirrored to.
    mqtt
    # A NATS subject a room is mirrored to.
    nats

# A message posted in a room, as it is stored and sent.
record Message
    # Its identifier, a UUID of version 7 in its standard form.
    id: str
    # The room's name.
    room: str
    # Who wrote it: a user's name, or the name a bridged message carried.
    author: str
    # Where it came from.
    origin: Origin
    # The text, its shortcodes resolved.
    text: str
    # When the server took it.
    at: time.Instant
    # Whether its author has changed the text since.
    edited: bool

# A message from one user to another, outside every room.
record Direct
    # Its identifier, a UUID of version 7 in its standard form.
    id: str
    # Who sent it.
    sender: str
    # Who it is for.
    recipient: str
    # The text, its shortcodes resolved.
    text: str
    # When the server took it.
    at: time.Instant

# One page of a room's history, the newest messages before a place in it.
record Page
    # The room's name.
    room: str
    # The messages, the oldest first.
    messages: [Message]
    # Whether older messages stand before the first of them.
    more: bool

# The name `origin` is written as on the wire and in the database.
#
# - `origin`: the origin.
function origin_name(origin: Origin) -> str
    return match origin
        .chat => "chat"
        .mqtt => "mqtt"
        .nats => "nats"

# The origin `name` writes, as `origin_name` writes it.
#
# - `name`: the name read.
#
# Fails `invalid` where it names no origin.
function parse_origin(name: str) -> Origin?
    return match name
        "chat" => ok(.chat)
        "mqtt" => ok(.mqtt)
        "nats" => ok(.nats)
        _      => fail(code: INVALID, msg: f"no origin is named \"{name}\"")

# Whether `c`, one character, is a lower-case ASCII letter.
#
# - `c`: the character.
function is_lower(c: str) -> bool
    return c.len() == 1 && c[0] >= 'a' && c[0] <= 'z'

# Whether `c`, one character, may stand in a name after its first: a
# lower-case ASCII letter, a digit, `_` or `-`.
#
# - `c`: the character.
function is_name_character(c: str) -> bool
    return is_lower(c) || c.len() == 1 && (c[0] >= '0' && c[0] <= '9' || c[0] == '_' || c[0] == '-')

# Fails `invalid` where `name` is not a user's name: 2 to 24 characters, a
# lower-case ASCII letter first, then letters, digits, `_` and `-`. Names are
# lower case alone, so two people can never hold names that differ by case.
#
# - `name`: the name checked.
function check_user(name: str) -> ()?
    if name.len() < 2 || name.len() > 24
        return fail(
            code: INVALID,
            msg: f"a user's name holds 2 to 24 characters, and \"{name}\" holds {name.chars().len()}"
        )

    if !is_lower(name.slice(from: 0, to: 1))
        return fail(code: INVALID, msg: f"a user's name begins with a letter from a to z, and \"{name}\" does not")

    for c in name.chars()
        if !is_name_character(c)
            return fail(
                code: INVALID,
                msg: f"a user's name holds a to z, 0 to 9, `_` and `-`, and \"{name}\" holds \"{c}\""
            )

    return ok()

# Fails `invalid` where `name` is not a room's name: 1 to 32 characters, each
# a lower-case ASCII letter, a digit, `_` or `-`, as an MQTT topic level and a
# NATS subject token can hold it whole.
#
# - `name`: the name checked.
function check_room(name: str) -> ()?
    if name.len() < 1 || name.len() > 32
        return fail(
            code: INVALID,
            msg: f"a room's name holds 1 to 32 characters, and \"{name}\" holds {name.chars().len()}"
        )

    for c in name.chars()
        if !is_name_character(c)
            return fail(
                code: INVALID,
                msg: f"a room's name holds a to z, 0 to 9, `_` and `-`, and \"{name}\" holds \"{c}\""
            )

    return ok()

# The text of a message as it is stored: `text` with the white space at its
# ends taken off.
#
# - `text`: the text a client or a bridge sent.
#
# Fails `invalid` where nothing is left, where more than `MOST_TEXT_BYTES`
# bytes are, or where it holds a line break or another control character,
# since a chat line is one line on every screen it is drawn on.
function check_text(text: str) -> str?
    kept = strings.trim(text)

    if kept == ""
        return fail(code: INVALID, msg: "a message holds some text")

    if kept.len() > MOST_TEXT_BYTES
        return fail(
            code: INVALID,
            msg: f"a message holds at most {MOST_TEXT_BYTES} bytes, and this one holds {kept.len()}"
        )

    for c in kept.chars()
        if c.len() == 1 && (c[0] < ' ' || c[0] == 127)
            return fail(code: INVALID, msg: f"a message holds no control character, and this one holds the byte {c[0]}")

    return ok(kept)

# The size of a page `asked` names, held to 1 to `MOST_PAGE_SIZE`; 0 or less
# asks for `PAGE_SIZE`.
#
# - `asked`: the size the client asked for.
function page_size(asked: i64) -> i64
    if asked <= 0
        return PAGE_SIZE

    if asked > MOST_PAGE_SIZE
        return MOST_PAGE_SIZE

    return asked

test "check_user: a name, too short, an upper-case letter, a digit first, and a space"
    assert !check_user("alice").is_err() && !check_user("bo_b-2").is_err()
    assert check_user("a").is_err()
    assert check_user("Alice").is_err()
    assert check_user("2pac").is_err()
    assert check_user("al ice").is_err()
    assert check_user("zoë").is_err()

test "check_room: a name, the empty name, a dot, and a name of 33 characters"
    assert !check_room("general").is_err() && !check_room("7").is_err()
    assert check_room("").is_err()
    assert check_room("a.b").is_err()
    assert check_room(repeat("a", 33)).is_err()

test "check_text: trimmed, empty, a line break, past the bound, and an emoji kept"
    assert check_text("  hi  ").must() == "hi"
    assert check_text("   ").is_err()
    assert check_text("a\nb").is_err()
    assert check_text(repeat("x", 4001)).is_err()
    assert check_text("ciao 🇮🇹").must() == "ciao 🇮🇹"

test "parse_origin: every name read back, and a name of none"
    origins: [Origin] = [.chat, .mqtt, .nats]

    for o in origins
        assert parse_origin(origin_name(o)).must() == o

    assert parse_origin("kafka").is_err()

test "page_size: none asked, one, and past the most"
    assert page_size(0) == PAGE_SIZE && page_size(-3) == PAGE_SIZE
    assert page_size(1) == 1
    assert page_size(1000) == MOST_PAGE_SIZE
