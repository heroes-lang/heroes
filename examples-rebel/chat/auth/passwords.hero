# Passwords kept as PBKDF2-HMAC-SHA256 of a random salt, never as
# themselves: what `/register` stores and `/login` checks. The count of
# iterations is kept beside each hash, so a server that raises it keeps every
# account made before working, and the comparison is in constant time, so a
# wrong guess takes as long however much of it matched.

use <rebel>/bytes
use <rebel>/crypto
use <rebel>/os

# The iterations a server uses where its settings name none: the figure the
# OWASP Password Storage Cheat Sheet gives for PBKDF2-HMAC-SHA256, "600,000
# iterations (recommended)" (read 2026-11-21).
constant DEFAULT_ITERATIONS: i64
    600_000

# The bytes of a salt: 128 bits, the least NIST SP 800-132 § 5.1 allows for
# its random part, "at least 128 bits" (read 2026-11-21).
constant SALT_BYTES: i64
    16

# The bytes of a hash: one SHA-256 block of output.
constant HASH_BYTES: i64
    32

# The fewest characters a password holds.
constant LEAST_PASSWORD: i64
    8

# The code of a password refused.
constant INVALID: str
    "invalid"

# What is kept of a password: its salt, its hash and the iterations that made
# it. Made by `make`, read back from the store.
record Secret
    # The random salt, `SALT_BYTES` long.
    salt: [u8]
    # PBKDF2-HMAC-SHA256 of the password and the salt, `HASH_BYTES` long.
    hash: [u8]
    # The iterations the hash was made with, 1 or more.
    iterations: i64

# Fails `invalid` where `password` is too short to keep: fewer than
# `LEAST_PASSWORD` characters.
#
# - `password`: the password a person chose.
function check(password: str) -> ()?
    if password.chars().len() < LEAST_PASSWORD
        return fail(code: INVALID, msg: f"a password holds at least {LEAST_PASSWORD} characters")
    return ok()

# The hash of `password` with `salt` over `iterations`.
#
# - `password`: the password, its UTF-8 hashed.
# - `salt`: the salt.
# - `iterations`: 1 or more.
#
# Fails `invalid` where `iterations` is below 1.
function hash_of(password: str, salt: [u8], iterations: i64) -> [u8]?
    return crypto.pbkdf2(
        .sha256,
        password: bytes.from_text(password),
        salt: salt,
        iterations: iterations,
        length: HASH_BYTES
    )

# What to keep of `password`: a new random salt and the hash made with it.
#
# - `password`: the password, checked by `check`.
# - `iterations`: how many, 1 or more; `DEFAULT_ITERATIONS` for a server.
#
# Fails `invalid` where the password is too short or `iterations` below 1,
# and as `os.random_bytes` fails.
function make(password: str, iterations: i64) -> Secret?
    check(password)?
    salt = os.random_bytes(SALT_BYTES)?
    return ok(Secret(salt: salt, hash: hash_of(password, salt: salt, iterations: iterations)?, iterations: iterations))

# Whether `password` is the one `secret` was made from, compared in constant
# time.
#
# - `password`: the password given at sign-in.
# - `secret`: what was kept.
#
# False where the kept iterations are below 1, which no `make` writes.
function matches(password: str, secret: Secret) -> bool
    return match hash_of(password, salt: secret.salt, iterations: secret.iterations)
        .ok found => crypto.equals_constant_time(a: found, b: secret.hash)
        .err _    => false

test "matches: the password itself, another, and one differing in case"
    kept = make("correct horse", iterations: 10).must()
    assert kept.salt.len() == SALT_BYTES && kept.hash.len() == HASH_BYTES
    assert matches("correct horse", secret: kept)
    assert !matches("correct horsf", secret: kept)
    assert !matches("Correct horse", secret: kept)

test "make: two secrets of one password differ by their salts"
    one = make("battery staple", iterations: 2).must()
    two = make("battery staple", iterations: 2).must()
    assert one.salt != two.salt && one.hash != two.hash

test "check: a password too short, one of eight characters, and eight of two bytes each"
    assert check("1234567").is_err()
    assert !check("12345678").is_err()
    assert !check("éééééééé").is_err()

test "matches: a secret kept with no iterations matches nothing"
    kept = Secret(salt: [1], hash: [2], iterations: 0)
    assert !matches("anything at all", secret: kept)
