# Numbers as the model holds them, decimal text, read and made exactly with
# `big`'s decimals, and crossed to and from the binary numbers of the formats
# that have no decimal (an `f64`, an `i64`, a `u64`).
#
# A sum of a column is made here and is exact: `0.10` and `0.20` add to
# `0.30`, where two `f64` add to `0.30000000000000004`. A statistic that
# Python's `statistics` computes over floats (the mean, the median, the
# deviation) takes the floats `to_float` gives, as `query/aggregate` says.

use <rebel>/big
use <rebel>/numbers

use model/model

## Codes

# The code of a text that is not a number of the model.
constant INVALID: str
    "invalid"

# The code of a number past what this program writes out.
constant DOES_NOT_FIT: str
    "does_not_fit"

## Reading the text

# Whether `s` is a number as JSON writes one, the one syntax a `number`'s
# text may have: an optional `-`, `0` or digits not starting with `0`, an
# optional fraction of one digit or more, an optional exponent.
#
# - `s`: the text; empty is no number.
#
# It walks the bytes once and cuts no slice, so no text makes it abort.
function is_number_text(s: str) -> bool
    at: i64 @= 0

    if at < s.len() && s[at] == '-'
        at @ at + 1

    if at >= s.len()
        return false

    if s[at] == '0'
        at @ at + 1
    else if is_digit(s[at])
        at @ skip_digits(s, from: at)
    else
        return false

    if at < s.len() && s[at] == '.'
        after = skip_digits(s, from: at + 1)

        if after == at + 1
            return false
        at @ after

    if at < s.len() && (s[at] == 'e' || s[at] == 'E')
        at @ at + 1

        if at < s.len() && (s[at] == '+' || s[at] == '-')
            at @ at + 1
        after = skip_digits(s, from: at)

        if after == at
            return false
        at @ after

    return at == s.len()

# Whether the byte `b` is an ASCII digit.
#
# - `b`: the byte.
function is_digit(b: u8) -> bool
    return b >= '0' && b <= '9'

# The index of the first byte at or after `from` that is not a digit.
#
# - `s`: the text.
# - `from`: where to start, from 0 to `s.len()`.
function skip_digits(s: str, from: i64) -> i64
    at: i64 @= from

    while at < s.len() && is_digit(s[at])
        at @ at + 1

    return at

# Whether the number `text` is written as an integer: no fraction and no
# exponent.
#
# - `text`: a number's text, as `is_number_text` accepts.
function is_integer_text(text: str) -> bool
    for c in text.chars()
        if c == "." || c == "e" || c == "E"
            return false

    return true

# The exact decimal `text` writes.
#
# - `text`: a number's text.
#
# Fails `invalid` where `text` is no number of the model.
function parse(text: str) -> big.Decimal?
    if !is_number_text(text)
        return fail(code: INVALID, msg: f"\"{text}\" is not a number")
    return big.parse_decimal(text)

# The value of `text` as the nearest `f64`.
#
# - `text`: a number's text.
#
# Fails `invalid` where `text` is no number; a number past what an `f64`
# holds fails as `numbers.parse_float` fails.
function to_float(text: str) -> f64?
    if !is_number_text(text)
        return fail(code: INVALID, msg: f"\"{text}\" is not a number")
    return numbers.parse_float(text)

# The integer `text` writes, where it is one an `i64` holds.
#
# - `text`: a number's text.
#
# Fails `invalid` where `text` is not written as an integer, and
# `does_not_fit` where it is past an `i64`.
function to_int(text: str) -> i64?
    if !is_number_text(text) || !is_integer_text(text)
        return fail(code: INVALID, msg: f"\"{text}\" is not an integer")
    return numbers.parse_int(text)

## Making the text

# `d` as the model's text: its digits, no exponent, trailing zeros of the
# fraction kept, so `1.50` stays `1.50`.
#
# - `d`: the decimal.
function text_of(d: big.Decimal) -> str
    return big.format_decimal(d)

# The model's text of a decimal a binary format gave, where its digits are
# bounded as a text's are.
#
# - `d`: the decimal, from a CBOR decimal fraction or a BSON Decimal128.
#
# Fails `does_not_fit` where its scale is past `big.MAX_EXPONENT` either way:
# a CBOR item may carry any 64-bit exponent, and writing one out would fill
# the memory with zeros, so it is refused at the bound `big.parse_decimal`
# keeps for a text.
function text_of_bounded(d: big.Decimal) -> str?
    if d.scale > big.MAX_EXPONENT || d.scale < -big.MAX_EXPONENT
        return fail(
            code: DOES_NOT_FIT,
            msg: f"a decimal of scale {d.scale} is past the {big.MAX_EXPONENT} digits datakit writes out"
        )
    return ok(big.format_decimal(d))

# The canonical text of the number `text`: the trailing zeros of its fraction
# taken away and its exponent written out, so two texts of one number have one
# canonical text (`1.50` and `1.5`, `1e3` and `1000`).
#
# - `text`: a number's text.
#
# A text that is no number is answered as it is, since a value of the model
# holds only numbers `is_number_text` accepts.
function canonical(text: str) -> str
    return match parse(text)
        .ok d  => big.format_decimal(big.trim_zeros(d))
        .err _ => text

# The value of the integer `n`.
#
# - `n`: the integer.
function of_int(n: i64) -> model.Value
    return .number(text: f"{n}")

# The value of the unsigned integer `n`.
#
# - `n`: the integer.
function of_u64(n: u64) -> model.Value
    return .number(text: numbers.format_u64(n, base: 10))

# The value of a binary float, `x`, kept a float: a whole number ends in `.0`,
# so a writer that tells integers from floats by the text writes it back as a
# float.
#
# - `x`: the float.
#
# A NaN or an infinity, which no number of the model is, answers the text
# `NaN`, `Infinity` or `-Infinity`, as JSON5 and JavaScript name them.
function of_float(x: f64) -> model.Value
    if x != x
        return .text(v: "NaN")

    if x > 0.0 && x * 0.5 == x
        return .text(v: "Infinity")

    if x < 0.0 && x * 0.5 == x
        return .text(v: "-Infinity")
    return .number(text: numbers.format_float_shortest(x))

# The value of a number a format holds as an `f64` with no integers of its
# own (JSON, YAML, XLSX): a whole number within the integers an `f64` holds
# exactly is written as an integer, any other as `of_float` writes it.
#
# - `x`: the number.
function of_plain_float(x: f64) -> model.Value
    limit = 9007199254740991.0

    if x == x && x >= -limit && x <= limit
        match to_i64(x)
            .ok n =>
                if to_f64(n) == x
                    return of_int(n)
            .err _ => _ = 0
    return of_float(x)

## Arithmetic

# The exact sum of `texts`, numbers of the model.
#
# - `texts`: the numbers; empty for 0.
#
# Fails `invalid` where one is no number.
function sum(texts: [str]) -> big.Decimal?
    total @= big.parse_decimal("0")?

    for t in texts
        total @ big.add_decimal(a: total, b: parse(t)?)

    return ok(total)

# Whether the number `a` is below the number `b`, compared exactly.
#
# - `a`: a number's text.
# - `b`: a number's text.
#
# Fails `invalid` where either is no number.
function is_less(a: str, b: str) -> bool?
    return ok(big.compare_decimal(a: parse(a)?, b: parse(b)?) < 0)

## Tests

test "is_number_text: JSON's syntax, and its edges refused"
    assert is_number_text("0")
    assert is_number_text("-12")
    assert is_number_text("19.99")
    assert is_number_text("6.02e23")
    assert is_number_text("1E-7")
    assert !is_number_text("")
    assert !is_number_text("-")
    assert !is_number_text("007")
    assert !is_number_text("1.")
    assert !is_number_text(".5")
    assert !is_number_text("+3")
    assert !is_number_text("1e")
    assert !is_number_text("12 ")
    assert !is_number_text("NaN")

test "sum: decimals add exactly where floats would not"
    assert text_of(sum(["0.10", "0.20"]).must()) == "0.30"
    assert text_of(sum([]).must()) == "0"
    assert text_of(sum(["12345678901234567890", "1"]).must()) == "12345678901234567891"
    assert sum(["1", "x"]).is_err()

test "canonical: one text for one number"
    assert canonical("1.50") == "1.5"
    assert canonical("1e3") == "1000"
    assert canonical("-0") == "0"

test "of_float and of_plain_float: whole numbers, fractions, and the values that are no number"
    assert of_float(2.0) == .number(text: "2.0")
    assert of_plain_float(2.0) == .number(text: "2")
    assert of_plain_float(19.99) == .number(text: "19.99")
    nan = 0.0 / 0.0
    assert of_float(nan) == .text(v: "NaN")
    assert of_plain_float(1.0 / 0.0) == .text(v: "Infinity")

test "to_int: integers alone, and those past an i64 refused"
    assert to_int("-42").must() == -42
    assert to_int("1.0").is_err()
    assert to_int("9223372036854775808").is_err()
