      "name": "beta",
      "ip": "10.0.0.2"
    }
  ]
}

$ datakit convert settings.ini --to toml
[server]
host = "example.org"
port = 8080
secure = true

[paths]
data = "/var/lib/demo"
logs = "/var/log/demo"

$ datakit convert app.properties --to yaml
app.name: datakit
app.version: "0.1.0"
db.url: jdbc:sqlite:demo.db
greeting: Hello, world ☃
retries: 3

$ datakit convert catalog.xml --to csv
@id,title,author,year,price
b1,Dune,Frank Herbert,1965,9.99
b2,Emma,Jane Austen,1815,4.50
b3,Solaris,Stanisław Lem,1961,

$ datakit convert events.yaml --to xml
