$ datakit convert sales.cbor --path '$[?@.region == "east"]' --to json
[
  {
    "date": "2026-01-15",
    "region": "east",
    "city": "東京",
    "product": "gizmo",
    "units": 1,
    "price": 250.00,
    "amount": 250.00
  },
  {
    "date": "2026-02-14",
    "region": "east",
    "city": "Seoul",
    "product": "gadget",
    "units": 7,
    "price": 0.10,
    "amount": 0.70
  }
]

$ datakit query sales.xlsx --sort -amount --limit 3 --select 'date, city, amount'
date        city    amount
----------  ------  ------
2026-02-09  Oslo      1473
2026-02-21  Dublin     500
2026-01-15  東京       250
(3 rows)

$ datakit convert people.json --path '$.people[?@.age > 30]' --to yaml
- name: Ada
  age: 36
  email: ada@example.org
  tags:
    - admin
    - ops
  address:
    city: London
- name: Linus
  age: 54
  email: null
  tags:
    - kernel
  address:
    city: Portland

$ datakit query people.json --path '$.people[*]' --select 'name, age, address, len(tags) as tags' --to csv
name,age,address,tags
Ada,36,"{""city"":""London""}",2
Grace,29,"{""city"":""Arlington""}",0
Linus,54,"{""city"":""Portland""}",1

$ datakit convert config.toml --to json
{
  "title": "datakit demo",
  "released": "2026-03-01",
