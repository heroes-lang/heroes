# the session works in build/datakit-demo, holding sales.csv, regions.csv, people.json, events.yaml, config.toml, settings.ini, app.properties, catalog.xml

$ datakit formats
format      extensions       datakit        holds
----------  ---------------  -------------  ------------------------------------------
csv         .csv             read, written  comma-separated values, a header row first
tsv         .tsv .tab        read, written  tab-separated values, a header row first
json        .json            read, written  one JSON value
jsonl       .jsonl .ndjson   read, written  one JSON value on each line
yaml        .yaml .yml       read, written  a YAML document
toml        .toml            read, written  a TOML document
ini         .ini .cfg .conf  read, written  sections of keys and values
properties  .properties      read, written  Java properties: keys and values
xml         .xml             read, written  an XML document
xlsx        .xlsx            read, written  an Excel workbook, one sheet
msgpack     .msgpack .mpk    read, written  MessagePack values
cbor        .cbor            read, written  CBOR data items
bson        .bson            read, written  BSON documents, one after another
table       .txt             written        an aligned text table (written only)

$ datakit inspect sales.csv
format: csv
shape: a table of 10 rows and 7 columns
columns: date (moment), region (text), city (text), product (text), units (number), price (number), amount (number)
digest: 593898d3109c8048

$ datakit query sales.csv --where 'units >= 5 && region == "north"' --select 'date, city, units, price, units * price as total'
date        city    units  price   total
----------  ------  -----  ------  -------
2026-01-05  Zürich      5   19.99    99.95
2026-01-12  Kraków      8   19.99   159.92
2026-02-09  Oslo        6  245.50  1473.00
(3 rows)

$ datakit query sales.csv --group region --agg 'count() as orders, sum(units) as units, sum(amount) as revenue, mean(amount) as mean' --sort -revenue
region  orders  units  revenue  mean
------  ------  -----  -------  --------------------
north        3     19  1732.87  577.6233333333333333
west         2      5   559.97               279.985
east         2      8   250.70                125.35
south        3     18    87.60                  29.2
(4 rows)

$ datakit query sales.csv --select 'product, price' --where 'price < 1' --to json
[
  {
    "product": "gadget",
    "price": 0.10
  },
  {
    "product": "gadget",
    "price": 0.20
  },
  {
    "product": "gadget",
    "price": 0.10
  }
]

$ datakit stats sales.csv --columns city,units,price,amount --percentiles 10,90
stat      city    units               price              amount
