$ datakit convert sales.csv --path '$[0:2]' --to properties
sales[0].date=2026-01-05
sales[0].region=north
sales[0].city=Zürich
sales[0].product=widget
sales[0].units=5
sales[0].price=19.99
sales[0].amount=99.95
sales[1].date=2026-01-07
sales[1].region=south
sales[1].city=São Paulo
sales[1].product=gadget
sales[1].units=2
sales[1].price=0.10
sales[1].amount=0.20

$ datakit sql sales.csv regions.csv --db sales.db --query 'SELECT r.manager, COUNT(*) AS orders, SUM(s.units) AS units FROM sales AS s JOIN regions AS r ON r.region = s.region GROUP BY r.manager ORDER BY units DESC'
manager  orders  units
-------  ------  -----
Ingrid        3     19
Mateo         3     18
Yuki          2      8
Aoife         2      5
(4 rows)

