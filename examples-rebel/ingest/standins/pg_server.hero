# The PostgreSQL stand-in of the demo: a server of protocol 3.0 on
# loopback, on a thread of its own until the program is asked to stop,
# holding one database and one role that logs in by SCRAM-SHA-256, and
# serving every connection at once on one thread (`serve`), each message
# answered by its session (`pg_session`) in turn. Its account is each
# table and how many rows it holds, and how many logins it took and
# refused.

use <rebel>/numbers
use <rebel>/os
use <rebel>/strings
use <rebel>/time

use standins/pg_session
use standins/pg_state
use standins/pg_wire
use standins/scram_server
use standins/serve
use standins/sql_tree

## Codes

# The code of a thread argument that does not say how to start the server.
constant INVALID: str
    "invalid"

## Bounds

# How long the loop waits when nothing comes.
constant IDLE_MS: i64
    1_000

# PBKDF2's iterations for the role's verifier, PostgreSQL's
# `scram_iterations` default.
constant ITERATIONS: i64
    4_096

## Starting

# How the supervisor starts the server.
record Setup
    # The supervisor's control port.
    control_port: i64
    # The role.
    user: str
    # Its password.
    password: str
    # The database.
    database: str

# The thread argument that starts a server of `setup`, its fields one a
# line.
#
# - `setup`: what the server holds.
function format_setup(setup: Setup) -> str
    return [to_str(setup.control_port), setup.user, setup.password, setup.database].join("\n")

# The setup `text` writes.
#
# - `text`: the thread argument.
#
# Fails `invalid` where it is not four lines or the port is no number.
function parse_setup(text: str) -> Setup?
    lines = strings.split(s: text, sep: "\n")

    if lines.len() != 4
        return fail(code: INVALID, msg: f"the PostgreSQL server's setup is four lines, and {lines.len()} came")
    return ok(Setup(control_port: numbers.parse_int(lines[0])?, user: lines[1], password: lines[2], database: lines[3]))

# The server's thread: listens, tells the supervisor its port, and serves
# until stopped. Answers its account.
#
# - `arg`: the setup, as `format_setup` writes it.
function run(arg: str) -> str
    match served(arg)
        .err e     => return "postgres: " + e.msg
        .ok shared => return account(shared)

# The account: the logins, then each table and its rows, by name.
#
# - `shared`: the server's state as the stop left it.
function account(shared: pg_state.Shared) -> str
    tables: [str] @= []

    for t in shared.db.tables
        tables @ tables.push(f"{t.name} {t.rows.len()}")

    return f"postgres: {shared.logins} logins taken, {shared.refused_logins} refused; rows by table: {sort(tables).join(", ")}"

## Serving

# Every connection served until the program is asked to stop, and the
# state the stop left.
#
# - `arg`: the setup.
#
# Fails `invalid` where the setup is not one, and as `serve.open` and
# `scram_server.verifier_of` fail.
function served(arg: str) -> pg_state.Shared?
    setup = parse_setup(arg)?
    salt = os.random_bytes(16)?
    verifier = scram_server.verifier_of(setup.password, salt: salt, iterations: ITERATIONS)?
    loop @= serve.open("postgres", control_port: setup.control_port)?
    shared @= pg_state.Shared(
        db: sql_tree.empty_database(),
        user: setup.user,
        database: setup.database,
        verifier: verifier,
        locks: [],
        logins: 0,
        refused_logins: 0,
        next_pid: 1000
    )
    sessions: [pg_state.Session] @= []

    while true
        match serve.wait(@loop, limit: time.milliseconds(IDLE_MS).default(time.nanoseconds(0)))
            .err _ => break
            .ok moved =>
                for peer in moved
                    answer_peer(@loop, shared: @shared, sessions: @sessions, peer: peer)

    serve.close(@loop)
    return ok(shared)

# Answers every whole message `peer` has sent, in order; a connection that
# ended, or whose session closes, is let go, its block rolled back and its
# locks released.
#
# - `loop`: the stand-in's loop.
# - `shared`: the server's state.
# - `sessions`: every connection's session.
# - `peer`: the connection.
function answer_peer(@loop: serve.Loop, @shared: pg_state.Shared, @sessions: [pg_state.Session], peer: i64)
    at: i64 @= -1

    for i in range(from: 0, to: sessions.len())
        if sessions[i].peer == peer
            at @ i

    if at < 0
        sessions @ sessions.push(pg_state.new_session(peer: peer, pid: shared.next_pid))
        shared.next_pid @ shared.next_pid + 1
        at @ sessions.len() - 1
    s @= sessions[at]

    while !s.closing
        pending = serve.pending_of(loop, id: peer)

        match pg_wire.take(pending, startup: s.phase == "startup")
            .err _ => s.closing @ true
            .ok taken =>
                if !taken.whole
                    break
                serve.consume(@loop, id: peer, n: taken.used)
                out = pg_session.answer(@shared, s: @s, m: taken.message)

                if out.len() > 0 && serve.send(loop, id: peer, data: out).is_err()
                    s.closing @ true

    if s.closing || serve.is_ended(loop, id: peer)
        let_go(@shared, s: s)
        serve.drop(@loop, id: peer)
        kept: [pg_state.Session] @= []

        for one in sessions
            if one.peer != peer
                kept @ kept.push(one)

        sessions @ kept
    else
        sessions[at] @ s

# Releases what a connection that ended held: its advisory locks. Its
# block's copy is dropped with it, rolled back as a server rolls back the
# transaction of a connection lost.
#
# - `shared`: the server's state.
# - `s`: the session ended.
function let_go(@shared: pg_state.Shared, s: pg_state.Session)
    kept: [pg_state.Lock] @= []

    for l in shared.locks
        if l.holder != s.peer
            kept @ kept.push(l)

    shared.locks @ kept

test "format_setup, parse_setup: what one writes the other reads; three lines refused"
    s = Setup(control_port: 5, user: "pipeline", password: "pass word", database: "events")
    back = parse_setup(format_setup(s)).must()
    assert back.user == "pipeline" && back.password == "pass word" && back.database == "events"
    assert parse_setup("1\nu\np").is_err()

test "account: tables by name and their rows"
    v = scram_server.verifier_of("p", salt: [1], iterations: 1).must()
    t = sql_tree.Table(name: "b", columns: [], rows: [[], []], indexes: [], checks: [], next_serial: 1)
    u = sql_tree.Table(name: "a", columns: [], rows: [], indexes: [], checks: [], next_serial: 1)
    shared = pg_state.Shared(
        db: sql_tree.Database(tables: [t, u], version: 2),
        user: "u",
        database: "d",
        verifier: v,
        locks: [],
        logins: 1,
        refused_logins: 0,
        next_pid: 1
    )
    assert account(shared) == "postgres: 1 logins taken, 0 refused; rows by table: a 0, b 2"
