# The words of a statement, as PostgreSQL's lexer reads them: an unquoted
# name folded to lower case, a quoted name kept as written with `""` read
# as `"`, a string between single quotes with `''` read as `'`, a number,
# a placeholder `$n`, and the operators the engine knows; `--` and `/* */`
# comments are passed over. A text the lexer cannot read is refused
# `42601`, as PostgreSQL refuses it.

use <rebel>/sql
use <rebel>/strings

## Codes

# The code of a statement that cannot be read.
constant INVALID: str
    "invalid"

## Tokens

# One word of a statement.
record Token
    # `word`, `name`, `string`, `number`, `param`, `op` or `end`.
    kind: str
    # A word folded to lower case, a name or a string as read, a number's
    # digits, a placeholder's number, or an operator.
    text: str

# The tokens of `source`, ending with one of kind `end`.
#
# - `source`: one statement or several, as a client sends them.
#
# Fails `invalid`, its message `[42601]` and where, for a string or a
# quoted name not closed, a placeholder with no number, or a character the
# engine reads no operator in.
function tokens(source: str) -> [Token]?
    out: [Token] @= []
    i: i64 @= 0
    n = source.len()

    while i < n
        c = source[i]

        if c == ' ' || c == '\n' || c == '\t' || c == '\r'
            i @ i + 1
        else if c == '-' && i + 1 < n && source[i + 1] == '-'
            while i < n && source[i] != '\n'
                i @ i + 1
        else if c == '/' && i + 1 < n && source[i + 1] == '*'
            close = strings.index_of(s: source.slice(from: i + 2, to: n), substr: "*/")

            match close
                .err _ => return fail(
                    code: INVALID,
                    msg: sql.failure_message(database_code: "42601", message: "unterminated /* comment")
                )
                .ok at => i @ i + 2 + at + 2
        else if is_word_start(c)
            start = i

            while i < n && is_word_part(source[i])
                i @ i + 1

            out @ out.push(Token(kind: "word", text: strings.to_lower(source.slice(from: start, to: i))))
        else if c >= '0' && c <= '9'
            start = i

            while i < n && (source[i] >= '0' && source[i] <= '9' || source[i] == '.')
                i @ i + 1

            out @ out.push(Token(kind: "number", text: source.slice(from: start, to: i)))
        else if c == '$'
            start = i + 1
            i @ i + 1

            while i < n && source[i] >= '0' && source[i] <= '9'
                i @ i + 1

            if i == start
                return fail(
                    code: INVALID,
                    msg: sql.failure_message(database_code: "42601", message: "a placeholder is $ and a number")
                )
            out @ out.push(Token(kind: "param", text: source.slice(from: start, to: i)))
        else if c == '\'' || c == '"'
            quoted = read_quoted(source, from: i)?

            kind = if c == '\''
                "string"
            else
                "name"
            out @ out.push(Token(kind: kind, text: quoted.text))
            i @ quoted.next
        else
            op = operator_at(source, at: i)

            if op == "" && c >= 0x80
                return fail(
                    code: INVALID,
                    msg: sql.failure_message(database_code: "42601", message: f"syntax error at byte {i}: a character above ASCII outside a string")
                )

            if op == ""
                return fail(
                    code: INVALID,
                    msg: sql.failure_message(database_code: "42601", message: f"syntax error at or near \"{source.slice(from: i, to: i + 1)}\"")
                )

            written = if op == "!="
                "<>"
            else
                op
            out @ out.push(Token(kind: "op", text: written))
            i @ i + op.len()

    out @ out.push(Token(kind: "end", text: ""))
    return ok(out)

# What a quoted text reads to, and where the source goes on.
record Quoted
    # The text between the quotes, a doubled quote read as one.
    text: str
    # The place after the closing quote.
    next: i64

# The string or quoted name opening at `from`.
#
# - `source`: the statement.
# - `from`: the place of the opening quote.
#
# Fails `invalid` where it is not closed.
function read_quoted(source: str, from: i64) -> Quoted?
    quote = source[from]
    i: i64 @= from + 1
    start: i64 @= i
    pieces: [str] @= []

    while i < source.len()
        if source[i] == quote
            if i + 1 < source.len() && source[i + 1] == quote
                pieces @ pieces.push(source.slice(from: start, to: i + 1))
                i @ i + 2
                start @ i
            else
                pieces @ pieces.push(source.slice(from: start, to: i))
                return ok(Quoted(text: pieces.join(""), next: i + 1))
        else
            i @ i + 1

    return fail(
        code: INVALID,
        msg: sql.failure_message(database_code: "42601", message: "unterminated quoted string or name")
    )

# The operator that opens at `at`, its longest form first; "" where none
# does.
#
# - `source`: the statement.
# - `at`: the place.
function operator_at(source: str, at: i64) -> str
    if at + 1 < source.len()
        two = source.slice(from: at, to: at + 2)

        for op in ["::", "<=", ">=", "<>", "!=", "||"]
            if two == op
                return op

    one = source.slice(from: at, to: at + 1)

    for op in ["=", "<", ">", "+", "-", "*", "/", "(", ")", ",", ".", ";"]
        if one == op
            return op

    return ""

# Whether `c` may open an unquoted name.
#
# - `c`: a byte.
function is_word_start(c: u8) -> bool
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'

# Whether `c` may stand inside an unquoted name.
#
# - `c`: a byte.
function is_word_part(c: u8) -> bool
    return is_word_start(c) || c >= '0' && c <= '9'

test "tokens: words folded, names kept, strings with a doubled quote, a cast, a placeholder and a comment"
    t = tokens("SELECT \"Version\", 'it''s'::text, $12 -- note\nFROM x").must()
    kinds: [str] @= []

    for one in t
        kinds @ kinds.push(one.kind + ":" + one.text)

    assert kinds == ["word:select", "name:Version", "op:,", "string:it's", "op:::", "word:text", "op:,", "param:12", "word:from", "word:x", "end:"]

test "tokens: != is <>, a number with a point, a comment between stars"
    t = tokens("a != 1.5 /* x */ <= b").must()
    assert t[1].text == "<>" && t[2].text == "1.5" && t[3].text == "<=" && t[4].text == "b"

test "tokens: a string not closed, a lone $, and a character no operator has are refused"
    assert tokens("'abc").is_err()
    assert tokens("$ 1").is_err()
    assert tokens("a ? b").is_err()
    assert tokens("/* open").is_err()
