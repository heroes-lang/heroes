# The demo's stage: a folder made under `build/` for everything the run
# keeps, and removed at the end; the key store, the system's keyring under
# a service of this run alone where the keyring answers, its entries
# removed at the end, files in the folder otherwise; the configuration a
# person wrote, read from the standard input and edited in place
# (`toml.Document`) so that it points at the stand-ins rather than at the
# world, then written into the folder and read back as `certs` reads any
# file; and the services started on threads of their own, each telling its
# port (`core/ready`), all stopped at once at the end by the program's one
# stop (`os.ask_stop`), which cannot be taken back.

use <rebel>/bytes
use <rebel>/fs
use <rebel>/os
use <rebel>/path
use <rebel>/toml

use config/loader
use config/settings
use core/ready
use store/vault

## Names

# The keyring service of a demo run: a run's own suffix after it, so a
# run never touches what another left.
constant SERVICE_PREFIX: str
    "heroes-certs-demo-"

## The folder and the store

# Where the demo keeps what it makes.
record Place
    # The folder, under `build/`, removed at the end.
    folder: str
    # The key store.
    store: vault.Store

# The demo's folder made under `build/`, and its key store chosen.
#
# Fails as `fs.make_dir_all`, `fs.make_temp_dir` and `os.random_bytes` fail.
function place() -> Place?
    fs.make_dir_all("build")?
    folder = fs.make_temp_dir(dir: "build", pattern: "certs-demo-*")?
    run_id = bytes.format_hex(os.random_bytes(6)?)
    store = vault.choose(service: SERVICE_PREFIX + run_id, folder: path.join_all([folder, "keys"]))
    return ok(Place(folder: folder, store: store))

# Everything the demo made removed: the keyring's entries of this run, then
# the folder.
#
# - `p`: the place.
#
# Fails as `vault.remove_every` and `fs.remove_all` fail; both are tried.
function cleared(p: Place) -> ()?
    keys_gone = vault.remove_every(p.store)
    folder_gone = fs.remove_all(p.folder)
    keys_gone?
    return folder_gone

## The configuration

# Where the stand-ins are, which the configuration is pointed at.
record Pointers
    # The stand-in CA's directory URL.
    directory: str
    # The file of the root the CA's own HTTPS is signed by.
    roots: str
    # The file of the CA's issuing root.
    trust: str
    # The DNS stand-in's address and port.
    dns: str
    # The demo's folder.
    folder: str
    # The keyring service, "" for files.
    keyring_service: str

# The configuration `text` edited to point at the stand-ins, every other
# byte of it as the person wrote it.
#
# - `text`: the TOML read from the standard input.
# - `p`: where the stand-ins are.
#
# Fails as `toml.parse_document` and `toml.set_value` fail.
function pointed(text: str, p: Pointers) -> str?
    d @= toml.parse_document(text)?
    toml.set_value(@d, path: ["acme", "directory"], value: .text(v: p.directory))?
    toml.set_value(@d, path: ["acme", "roots"], value: .text(v: p.roots))?
    toml.set_value(@d, path: ["acme", "trust"], value: .text(v: p.trust))?
    toml.set_value(@d, path: ["store", "folder"], value: .text(v: p.folder))?
    toml.set_value(@d, path: ["store", "keyring_service"], value: .text(v: p.keyring_service))?
    toml.set_value(@d, path: ["http01", "webroot"], value: .text(v: path.join_all([p.folder, "webroot"])))?
    toml.set_value(@d, path: ["dns01", "server"], value: .text(v: p.dns))?
    return ok(toml.format_document(d))

# The configuration written into the demo's folder and read back as a
# person's file is read.
#
# - `folder`: the demo's folder.
# - `text`: the configuration's text.
#
# The file's path and what it says. Fails as `write_file` and `loader.parse`
# fail.
function written(folder: str, text: str) -> Loaded?
    file = path.join_all([folder, "certs.toml"])
    write_file(path: file, text: text)?
    return ok(Loaded(file: file, s: loader.parse(text)?))

# A configuration file written and read.
record Loaded
    # Its path.
    file: str
    # What it says.
    s: settings.Settings

## Services

# A service started on its thread.
record Service
    # Its name, as it told it; "" until it has.
    name: str
    # The thread, owed its wait, which answers the service's last line.
    thread: (thread str)

# `body` started on a thread with `setup`, handed whole, and what the
# service says once it listens awaited on `told`, the mailbox `setup`
# carries to it.
#
# - `body`: the service's thread.
# - `setup`: what the service is handed.
# - `told`: the readiness mailbox `setup` holds.
# - `started`: the services started so far, this one added once its thread
#   runs, so it is waited for whatever happens next.
#
# What it said. Fails `limit` where no thread can be started, and as
# `ready.await_ready` fails.
function start<S>(body: (function(S) -> str), setup: S, told: (mailbox ready.Ready), @started: [Service]) -> ready.Ready?
    thread = spawn(body, setup)?
    at = started.len()
    started @ started.push(Service(name: "", thread: thread))
    said = ready.await_ready(told)?
    started[at].name @ said.service
    return ok(said)

# Every service stopped and waited for: the program's stop asked, which
# every waiting call answers from then on, and each thread's last line.
#
# - `started`: the services, each waited for once.
function stopped(started: [Service]) -> [str]
    os.ask_stop()
    lines: [str] @= []

    for one in started
        lines @ lines.push(one.thread.wait())

    return lines

test "pointed: the stand-ins' places set, the person's comments kept"
    text = "# mine\n[acme]\ndirectory = \"https://ca.example/dir\"\n\n[store]\nfolder = \"/var/lib/certs\"\n"
    p = Pointers(
        directory: "https://127.0.0.1:1/directory",
        roots: "r.pem",
        trust: "t.pem",
        dns: "127.0.0.1:2",
        folder: "f",
        keyring_service: ""
    )
    out = pointed(text, p: p).must()
    assert out.slice(from: 0, to: 6) == "# mine"
    read = toml.parse(out).must()
    assert toml.value_at(read, path: ["acme", "directory"]).must() == .text(v: "https://127.0.0.1:1/directory")
    assert toml.value_at(read, path: ["dns01", "server"]).must() == .text(v: "127.0.0.1:2")
