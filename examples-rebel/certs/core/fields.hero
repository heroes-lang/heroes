# Named values written as text, one `NAME=value` a line: what crosses into
# a thread, which is handed one `str` and gives one back (spec § 13), and
# what a service started on a thread tells the demo's supervisor once it
# listens. A value that may hold a line end or an `=` (a PEM text, a key's
# base 64) is written in base 64, so every line holds exactly one name and
# one value.

use <rebel>/bytes
use <rebel>/numbers
use <rebel>/strings

## Codes

# The code of a text that is not named values, or of a value missing or of
# the wrong form.
constant INVALID: str
    "invalid"

# The code of a name no line gives.
constant NOT_FOUND: str
    "not_found"

## Writing

# `fields` as lines, in the map's order, each `NAME=value`.
#
# - `fields`: the values by name; a name holds no `=` and no line end, and a
#   value no line end (`encoded` writes one that may).
function format_fields(fields: {str: str}) -> str
    out: [str] @= []

    for name in keys(fields)
        out @ out.push(name + "=" + fields[name].default(""))

    return out.join("\n") + "\n"

# `text` in base 64, so that it may stand as a value whatever it holds.
#
# - `text`: any text.
function encoded(text: str) -> str
    return bytes.format_base64(bytes.from_text(text))

## Reading

# The values `text` names, by name; a later line of one name replaces an
# earlier one, and an empty line is passed over.
#
# - `text`: `NAME=value` lines.
#
# Fails `invalid` where a line holds no `=`.
function parse_fields(text: str) -> {str: str}?
    out: {str: str} @= {}

    for line in strings.lines(text)
        if line != ""
            match strings.split_once(s: line, sep: "=")
                .ok h  => out[h.before] @ h.after
                .err _ => return fail(code: INVALID, msg: f"\"{line}\" is no NAME=value line")

    return ok(out)

# The value named `name`.
#
# - `fields`: the values read.
# - `name`: the name asked.
#
# Fails `not_found` where no line gives it.
function text_of(fields: {str: str}, name: str) -> str?
    match fields[name]
        .ok v  => return ok(v)
        .err _ => return fail(code: NOT_FOUND, msg: f"no value named {name}")

# The value named `name`, written by `encoded`, as its text.
#
# - `fields`: the values read.
# - `name`: the name asked.
#
# Fails `not_found` where no line gives it, `invalid` where it is not base 64
# of UTF-8.
function decoded_of(fields: {str: str}, name: str) -> str?
    raw = text_of(fields, name: name)?

    match bytes.parse_base64(raw)
        .err _ => return fail(code: INVALID, msg: f"the value named {name} is not base 64")
        .ok data =>
            match bytes.to_text(data)
                .ok t  => return ok(t)
                .err _ => return fail(code: INVALID, msg: f"the value named {name} is not UTF-8")

# The value named `name`, as a decimal integer.
#
# - `fields`: the values read.
# - `name`: the name asked.
#
# Fails `not_found` where no line gives it, `invalid` where it is no integer.
function int_of(fields: {str: str}, name: str) -> i64?
    raw = text_of(fields, name: name)?

    match numbers.parse_int(raw)
        .ok n  => return ok(n)
        .err _ => return fail(code: INVALID, msg: f"the value named {name} is \"{raw}\", not an integer")

test "parse_fields: what format_fields writes reads back, in order"
    written = format_fields({"PORT": "5353", "NAME": "dns"})
    assert written == "PORT=5353\nNAME=dns\n"
    read = parse_fields(written).must()
    assert int_of(read, name: "PORT").must() == 5353
    assert text_of(read, name: "NAME").must() == "dns"

test "parse_fields: a value holding an equals sign keeps it, a line without one is refused"
    assert text_of(parse_fields("KEY=a=b\n").must(), name: "KEY").must() == "a=b"
    assert parse_fields("no equals here\n").is_err()

test "decoded_of: a PEM text with its line ends crosses whole"
    pem = "-----BEGIN X-----\nAAAA\n-----END X-----\n"
    read = parse_fields(format_fields({"CHAIN": encoded(pem)})).must()
    assert decoded_of(read, name: "CHAIN").must() == pem

test "int_of: absent, and not a number"
    read = parse_fields("A=x\n").must()
    assert int_of(read, name: "B").is_err()
    assert int_of(read, name: "A").is_err()
