# Reaches Rebel's `compress/brotli`, so that `heroes test` on this file runs
# the package's own tests (spec § 12). It compresses a line as Brotli, reads
# it back, and prints both sizes.

use <rebel>/compress/brotli

function main()
    line: [u8] = [0x5a, 0x69, 0x67, 0x67, 0x79, 0x20, 0x5a, 0x69, 0x67, 0x67, 0x79, 0x20, 0x5a, 0x69, 0x67, 0x67, 0x79]

    match brotli.compress(line, brotli.defaults())
        .err e => print(e.code, ": ", e.msg)
        .ok packed =>
            back = brotli.decompress(packed, limit: 1000).default([])
            print(line.len(), " bytes, ", packed.len(), " compressed, ", back.len(), " read back")
