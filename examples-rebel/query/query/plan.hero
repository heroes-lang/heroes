# A query, as a value: what to keep, what to join, how to order, what to
# count.
#
# **A query here is DATA and not a string**: a `variant` used as an
# instruction set, a value the program builds, passes around, compares and
# prints, whose every case the checker forces the engine to handle, because a
# `match` on a variant is exhaustive or it is a compile error (spec § 8).
#
# THE COLUMNS ARE A VARIANT AND NOT A `str`, for the same reason. A column
# named by a string is a typo waiting to become an empty result; a column
# named by a case is a typo the compiler catches.

use data/row

# A column of the table.
variant Column
    # The row's number.
    id
    # Its team.
    team
    # Its name.
    name
    # Whether it plays.
    active
    # Its score.
    score
    # Its rate.
    rate

# What a row must satisfy to be kept. `every_row` is the identity, so a query
# with no filter is a value like any other rather than a `Where?` every caller
# has to unwrap.
variant Where
    # Every row.
    every_row
    # The rows of one team.
    team_is
        # The team's name.
        team: str
    # The rows that play, or the ones that do not.
    active_is
        # Whether the rows kept play.
        want: bool
    # The rows scoring at least so much.
    score_at_least
        # The least score kept.
        least: i64
    # The rows whose rate is below a limit.
    rate_below
        # The first rate not kept.
        limit: f64
    # The rows every one of several filters keeps.
    both
        # The filters, every one of which must keep the row.
        left: [Where]

# How the kept rows are ordered.
variant Order
    # As they came, which `ordered` reads as by id.
    unordered
    # By id, lowest first.
    by_id
    # By score, highest first, then by id.
    by_score_high_first
    # By name, by bytes, then by id.
    by_name
    # The rows that play first, then by id.
    by_active

# What is counted over the kept rows.
variant Aggregate
    # How many rows.
    how_many
    # Their scores added.
    total_score
    # The highest score, -1 for none.
    best_score
    # The mean rate; `engine.aggregate` answers the count, the mean being
    # `mean_of`'s.
    mean_rate

# The whole query. `joined` asks for the team table to be joined in, which is
# what makes `region` available to the report.
record Query
    # What is kept.
    keep: Where
    # How it is ordered.
    order: Order
    # Whether the team table is joined in.
    joined: bool
    # The most rows answered, 0 for all.
    limit: i64

# A row with its team's region attached: what a join produces. A record and
# not a pair, because there are no tuples in this language and a name is what
# makes a column readable in the report.
record Joined
    # The row.
    r: row.Row
    # Its team's region.
    region: str

# The key a `group by` groups on: **a record used as a map key**, whose
# generated hash and equality walk its fields, so two keys equal field by
# field are one key however they were built.
record Group
    # The team.
    team: str
    # Whether its rows play.
    active: bool

# What one group holds, kept as a record rather than four maps, so a group is
# one value that can be compared and printed whole.
record Summary
    # How many rows.
    rows: i64
    # Their scores added.
    total: i64
    # The highest score, -1 for no row.
    best: i64
    # Their rates added.
    rate_sum: f64

# The empty summary a group starts from. `best` starts below every possible
# score rather than at zero, because a group whose scores are all zero and a
# group with no rows must not answer the same thing.
function nothing_yet() -> Summary
    return Summary(rows: 0, total: 0, best: -1, rate_sum: 0.0)

# One row folded into a summary.
#
# - `s`: the summary so far.
# - `r`: the row.
function with_row(s: Summary, r: row.Row) -> Summary
    highest: i64 @= s.best

    if r.score > highest
        highest @ r.score
    return Summary(rows: s.rows + 1, total: s.total + r.score, best: highest, rate_sum: s.rate_sum + r.rate)

# The mean of a summary's rates.
#
# - `s`: the summary.
#
# Fails `empty_group` on a summary of no row, because the mean of nothing is
# not a number and answering `0.0` would put a lie in a column of real
# numbers.
function mean_of(s: Summary) -> f64?
    if s.rows == 0
        return fail(code: "empty_group", msg: "the mean of no rows is not a number")
    return ok(s.rate_sum / to_f64(s.rows))

# Whether a row satisfies a filter. Recursive through `both`, which is what
# makes a filter a tree rather than a list, and the recursion is over an array
# inside the case, because a variant may contain itself only through `[T]` or
# `{K: V}` (spec § 3). The filters are the program's own, so their depth is
# the program's.
#
# - `w`: the filter.
# - `r`: the row.
function kept(w: Where, r: row.Row) -> bool
    return match w
        .every_row        => true
        .team_is t        => r.team == t.team
        .active_is a      => r.active == a.want
        .score_at_least s => r.score >= s.least
        .rate_below l     => r.rate < l.limit
        .both b =>
            for one in b.left
                if !kept(one, r)
                    return false

            true

# The column a row reads, as text: what the report prints.
#
# - `c`: the column.
# - `r`: the row.
function text_at(c: Column, r: row.Row) -> str
    return match c
        .id     => r.id.to_str()
        .team   => r.team
        .name   => r.name
        .active => r.active.to_str()
        .score  => r.score.to_str()
        .rate   => r.rate.to_str()

# The name of a column, for a report's heading. Kept beside `text_at` so that
# a column added to the variant makes both `match`es fail to compile rather
# than one of them print a wrong heading.
#
# - `c`: the column.
function heading(c: Column) -> str
    return match c
        .id     => "id"
        .team   => "team"
        .name   => "name"
        .active => "active"
        .score  => "score"
        .rate   => "rate"

test "a filter is a value, and an empty one keeps everything"
    r = row.Row(id: 1, team: "argo", name: "p1", active: true, score: 500, rate: 12.5)
    assert kept(.every_row, r)
    assert kept(.team_is(team: "argo"), r)
    assert !kept(.team_is(team: "borea"), r)
    assert kept(.active_is(want: true), r)
    assert !kept(.active_is(want: false), r)
    assert kept(.score_at_least(least: 500), r)
    assert !kept(.score_at_least(least: 501), r)
    assert kept(.rate_below(limit: 13.0), r)
    assert !kept(.rate_below(limit: 12.5), r)

test "filters compose, and every one of them must hold"
    r = row.Row(id: 1, team: "argo", name: "p1", active: true, score: 500, rate: 12.5)
    all_of: [Where] = [.team_is(team: "argo"), .score_at_least(least: 100)]
    assert kept(.both(left: all_of), r)
    one_fails: [Where] = [.team_is(team: "argo"), .score_at_least(least: 900)]
    assert !kept(.both(left: one_fails), r)

    # A `both` of nothing keeps the row: there is no condition to fail.
    none_at_all: [Where] = []
    assert kept(.both(left: none_at_all), r)

test "a summary counts, totals and remembers the highest"
    a = row.Row(id: 1, team: "argo", name: "p1", active: true, score: 10, rate: 1.0)
    b = row.Row(id: 2, team: "argo", name: "p2", active: false, score: 30, rate: 2.0)
    s = nothing_yet().with_row(a).with_row(b)
    assert s.rows == 2
    assert s.total == 40
    assert s.best == 30
    assert s.mean_of().must() == 1.5

test "the mean of an empty group is a refusal and not a zero"
    assert nothing_yet().mean_of().is_err()
    assert nothing_yet().best == -1

test "a group is a record, and two groups built apart are one key"
    m: {Group: i64} @= {}
    m[Group(team: "argo", active: true)] @ 1
    m[Group(team: "argo", active: true)] @ 2
    assert keys(m).len() == 1
    assert m[Group(team: "argo", active: true)].must() == 2
    assert m[Group(team: "argo", active: false)].is_err()

test "every column has a heading and a reading, and the two lists cannot drift"
    r = row.Row(id: 7, team: "argo", name: "p7", active: false, score: 42, rate: 1.5)
    every: [Column] = [.id, .team, .name, .active, .score, .rate]
    assert every.map(heading) == ["id", "team", "name", "active", "score", "rate"]
    assert text_at(.id, r) == "7"
    assert text_at(.active, r) == "false"
    assert text_at(.rate, r) == "1.5"
