## The edits the demo makes while it watches

# The Swedish crossing page with a sentence added at its end.
function zebra_sv_edited() -> File
    lines @= zebra_sv()
    lines @ lines.push("")
    lines @ lines.push("Fyren tänds klockan sju om kvällen.")
    return file(name: "content/posts/zebra.sv.md", lines: lines)
