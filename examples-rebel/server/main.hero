# The twin of `examples/server/`: a small HTTP server, each connection served
# on a thread of its own, written with Rebel. Run with no words it prints byte
# for byte what `examples/server/` prints, so that program's `main.expected`
# is this one's test too.
#
#     heroes run examples-rebel/server/main.hero
#     heroes run examples-rebel/server/main.hero -- serve 8080
#
# Run with no words it is the loopback shape: server and client in one
# process, the client on a thread of its own sending two requests on one
# connection and printing each answer, then asking the program's stop
# (`os.ask_stop`), the server taking that connection on a thread of its own
# until the stop ends its accepts, so it prints the same on every run. Run as
# `serve <port>` it listens on 127.0.0.1 at that port, 0 for one the system
# chooses, until Ctrl-C or a request to end (SIGINT, SIGTERM), then lets every
# connection finish what it holds, says what it served, and returns from
# `main`, so the runtime's count of what was never freed is asked at its end.
#
# What Rebel does here that `examples/server/` writes for itself:
#
# - `http.serve_conn` reads each request of a connection by RFC 9112 within
#   `http.default_limits`, answers what is no request 400 and writes each
#   response, and `http.round_trip` writes a request and reads its response,
#   in place of that program's `http.hero` (its request and response records,
#   its reader and writer of messages, `serve_conn`, `round_trip` and
#   `not_found`);
# - `net.listen`, `net.accept_number`, `net.conn_of`, `net.connect` and
#   `os.catch_stop` and `os.ask_stop`, over the platform layer, in place of
#   its `net.hero` (the sockets, the number a connection crosses to a thread
#   as, the deadline and the stop);
# - `threads.start` and `threads.wait` start and join a thread, every one
#   started owed its wait, in place of its own `extern "hero_os.h"` group;
# - `net.parse_port` reads the port, in place of its `numbers.hero` (`atoi`);
#   `strings.trim` trims an answer's body, in place of its `strings.hero`.
#
# What stays this program's own is the loop that gives each connection its own
# thread, and the handler. Rebel's `http.serve` serves one connection at a
# time; serving several at once is the program's loop, as `http.serve`'s own
# comment says, since a Heroes thread is handed one `i64` and nothing else
# (spec § 13): a connection crosses into its thread as the number
# `net.accept_number` gives it up for, and the thread takes it back with
# `net.conn_of`. The 404's body names the path asked for, this program's
# words; Rebel's `http.respond_not_found` writes Go's, which do not.

use <rebel>/http
use <rebel>/io
use <rebel>/net
use <rebel>/os
use <rebel>/strings
use <rebel>/threads

# How long a connection the server accepted may last, every read and write of
# it included, in milliseconds: a client that goes quiet holds its thread and
# its slot no longer than this.
constant CONNECTION_MS: i64
    60_000

# How long the loopback client's connection may last, in milliseconds: a
# server that never answers ends the demonstration rather than hanging it.
constant CLIENT_MS: i64
    10_000

# What the server served, once it stopped accepting: its connections, the
# requests answered on them, and the connections that failed.
record Served
    # The connections accepted and handed to a thread.
    connections: i64
    # The requests answered on them.
    requests: i64
    # The connections that could not be served.
    failed: i64

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"server: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    words = text_arguments()

    if words.len() == 0
        loopback()
    else if words.len() == 2 && words[0] == "serve"
        serve(words[1])
    else
        print("usage: server [serve <port>]")
        exit(code: 2)

# The loopback shape: a listener on a port the system chooses, the client
# started on a thread of its own, and the server taking the one connection the
# client makes.
function loopback()
    match listening(0)
        .err e => print(e.msg)
        .ok opened =>
            listener: net.Listener @= opened

            match threads.start(body: client, arg: listener.address.port)
                .err e => print(e.msg)
                .ok started =>
                    asking: threads.Thread @= started
                    done = served(listener, room: threads.max_running() - 1)
                    failed = threads.wait(@asking) + done.failed
                    print(
                        f"served {done.requests} requests on {done.connections} connection, each connection on a thread of its own, {failed} failed"
                    )

            closed(@listener)

# The server alone, at `written`'s port, until it is asked to stop.
#
# - `written`: the port, as the command line gives it.
function serve(written: str)
    match net.parse_port(written)
        .err e =>
            print("usage: server [serve <port>]: " + e.msg)
            exit(code: 2)
        .ok port =>
            match listening(port)
                .err e =>
                    print(e.msg)
                    exit(code: 1)
                .ok opened =>
                    listener: net.Listener @= opened
                    print(f"listening on 127.0.0.1:{listener.address.port}, until Ctrl-C or a request to end")
                    done = served(listener, room: threads.max_running())
                    print(
                        f"stopped: requests answered {done.requests}, connections {done.connections}, failed {done.failed}"
                    )
                    closed(@listener)

# A listener on 127.0.0.1 at `port`, after the stop is caught, so Ctrl-C and a
# request to end make every wait of `net` fail `stopped` and the server finish.
#
# - `port`: 0 to 65535, 0 for one the system chooses.
#
# Fails as `os.catch_stop` and `net.listen` fail.
function listening(port: i64) -> net.Listener?
    os.catch_stop()?
    return net.listen(host: "127.0.0.1", port: port)

# The listener closed, a failure to close it said.
#
# - `listener`: the server's listener; emptied.
function closed(@listener: net.Listener)
    match net.close_listener(@listener)
        .ok _  => _ = 0
        .err e => print(e.msg)

# The server's half: each connection `listener` accepts served on a thread of
# its own, until the stop ends the accept, a Ctrl-C's or the program's own;
# then every thread joined.
#
# A THREAD'S SLOT COMES BACK ONLY WHEN IT IS WAITED FOR, and the runtime runs
# `threads.max_running()` of them, past which a start stops the program. So no
# more than `room` connections are served at once: at `room`, the oldest
# thread is waited for before the next connection is accepted.
#
# - `listener`: the listener; its owner closes it.
# - `room`: the most connections served at once, from one.
function served(listener: net.Listener, room: i64) -> Served
    running: [threads.Thread] @= []
    done: Served @= Served(connections: 0, requests: 0, failed: 0)

    while true
        if running.len() >= room
            oldest: threads.Thread @= running[0]
            joined(@done, @oldest)
            running @ running.slice(from: 1, to: running.len())

        match net.accept_number(listener)
            .ok n =>
                match threads.start(body: connection, arg: n)
                    .ok started =>
                        running @ running.push(started)
                        done.connections @ done.connections + 1
                    .err e =>
                        print(e.msg)
                        dropped(n)
                        done.failed @ done.failed + 1
            .err e =>
                if e.code != net.STOPPED
                    print(e.msg)
                break

    for thread in running
        last: threads.Thread @= thread
        joined(@done, @last)

    return done

# `thread` waited for, and what it answered counted in `done`: its requests,
# or a failure where it answered -1.
#
# - `done`: the counts; gains the thread's.
# - `thread`: a connection's thread, spent.
function joined(@done: Served, @thread: threads.Thread)
    answered = threads.wait(@thread)

    if answered < 0
        done.failed @ done.failed + 1
    else
        done.requests @ done.requests + answered

# The connection numbered `n` taken back and closed, where no thread could be
# started to serve it, so no connection is left that nobody closes.
#
# - `n`: the number `net.accept_number` answered.
function dropped(n: i64)
    match net.conn_of(n: n, deadline_ms: 0)
        .ok taken =>
            conn: net.Conn @= taken

            match io.close(@conn.stream)
                .ok _  => _ = 0
                .err e => print(e.msg)
        .err e => print(e.msg)

# One connection, on a thread of its own: taken back from the number it was
# given up for, its requests answered until the client is done with it, then
# closed. Answers how many requests were answered, or -1 where it failed.
#
# - `number`: the number `net.accept_number` gave the connection up for.
function connection(number: i64) -> i64
    match net.conn_of(n: number, deadline_ms: CONNECTION_MS)
        .err _ => return -1
        .ok taken =>
            conn: net.Conn @= taken
            answered = http.serve_conn(http.default_server(), c: conn, handler: answer)

            match io.close(@conn.stream)
                .ok _  => return answered
                .err _ => return -1

# The answer to each request: a greeting at `/hello`, and a 404 naming the path
# everywhere else.
#
# - `request`: the request as the server read it.
function answer(request: http.Request) -> http.Response
    if request.url.path == "/hello"
        return http.respond_text(http.STATUS_OK, text: "hello, world\n")
    return http.respond_text(http.STATUS_NOT_FOUND, text: "404 page not found: " + request.url.path + "\n")

# The client's half, on a thread of its own: one connection to the server at
# `port`, two requests sent on it one after another, each answer printed as it
# comes, then the connection closed and the program's stop asked, which ends
# the server's accepts, a connection that failed included. Answers how many
# failed.
#
# - `port`: the server's port on 127.0.0.1.
function client(port: i64) -> i64
    match net.connect(host: "127.0.0.1", port: port, deadline_ms: CLIENT_MS)
        .err e =>
            print(e.msg)
            os.ask_stop()
            return 1
        .ok made =>
            conn: net.Conn @= made
            reader: io.Reader @= io.reader(conn.stream)
            failed: i64 @= 0

            for target in ["/hello", "/nowhere"]
                match asked(@reader, target: target)
                    .ok text => print(f"GET {target}: {text}")
                    .err e =>
                        print(f"GET {target}: {e.msg}")
                        failed @ failed + 1

            match io.close(@conn.stream)
                .ok _  => _ = 0
                .err _ => failed @ failed + 1

            os.ask_stop()
            return failed

# One `GET` sent on the client's connection, and its answer as the
# transcript shows it: the status, then the body trimmed.
#
# - `reader`: the reader of the client's connection; advanced past the answer.
# - `target`: the path asked for.
#
# Fails as `http.round_trip` fails, and as `http.text_of` fails where the body
# is not text.
function asked(@reader: io.Reader, target: str) -> str?
    r: http.Request @= http.request(method: http.METHOD_GET, target: target)?
    r.headers @ http.with_header(r.headers, name: "Host", value: "127.0.0.1")
    got = http.round_trip(@reader, r: r, limits: http.default_limits())?
    return ok(f"{got.status}, {strings.trim(http.text_of(got)?)}")

test "the handler greets at /hello and answers 404 everywhere else"
    hello = answer(http.request(method: http.METHOD_GET, target: "/hello").must())
    assert hello.status == 200 && http.text_of(hello).must() == "hello, world\n"
    missing = answer(http.request(method: http.METHOD_GET, target: "/hello/").must())
    assert missing.status == 404 && http.text_of(missing).must() == "404 page not found: /hello/\n"

test "the handler answers through a whole exchange, with no network"
    got = http.exchange(http.request(method: http.METHOD_GET, target: "/nowhere").must(), handler: answer).must()
    assert got.status == 404 && http.text_of(got).must() == "404 page not found: /nowhere\n"

test "a port is digits from 0 to 65535, and nothing else"
    assert net.parse_port("8080").must() == 8080
    assert net.parse_port("x").is_err()
    assert net.parse_port("65536").is_err()
