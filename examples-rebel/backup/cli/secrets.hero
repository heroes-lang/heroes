# Where a command finds the repository's password, in the order restic
# reads its own: a file named by `--password-file` (or
# `BACKUP_PASSWORD_FILE`), whose first line is the password, so a
# scheduled backup reads it from a file only its user may read; else the
# environment's `BACKUP_PASSWORD`; else the terminal, typed with nothing
# echoed (`term.read_password`), twice when a repository is made, so a
# typing mistake does not seal a repository under a password nobody
# knows.
#
# The password is never printed and never written anywhere but into the
# derivation of a key.

use <rebel>/os
use <rebel>/strings
use <rebel>/term

## Codes

# The code of a password that is empty.
constant INVALID: str
    "invalid"

## The password

# The password: from `file` where it is not "", else `BACKUP_PASSWORD`,
# else typed.
#
# - `file`: the password file's path, "" for none.
# - `confirm`: whether a typed password is asked twice.
#
# Fails `invalid` where the password is empty, and as `read_file` and
# `term.read_password` fail, `unsupported` where it must be typed and the
# program has no terminal.
function password(file: str, confirm: bool) -> str?
    found = if file != ""
        first_line(read_file(file)?)
    else
        match os.env("BACKUP_PASSWORD")
            .ok v => v
            .err _ =>
                again = if confirm
                    "Again: "
                else
                    ""

                term.read_password(prompt: "Password: ", again: again)?

    if found == ""
        return fail(code: INVALID, msg: "a repository's password is not empty")
    return ok(found)

# The first line of `text`, its line end left out.
#
# - `text`: a password file's text.
function first_line(text: str) -> str
    return match strings.split_once(s: text, sep: "\n")
        .ok h  => strings.trim_suffix(s: h.before, suffix: "\r")
        .err _ => strings.trim_suffix(s: text, suffix: "\r")

test "first_line: the line end and what follows are left out"
    assert first_line("secret\nignored") == "secret"
    assert first_line("secret\r\n") == "secret"
    assert first_line("secret") == "secret"
    assert first_line("") == ""
