# Reaches Rebel's floor over the platform layer's extended attributes,
# `hero_xattr.h`, so that `heroes test` on this file runs the floor's own tests
# (spec § 12, § 13). It prints the kind a path that is not there fails with.

use <rebel>/fs/xattr/hero_xattr

function main()
    room: [u8] @= []
    _ = hero_xattr.names("reach-hero-xattr-no-such-path", follow: 1, @room, n: 16)
    print(hero_xattr.last_error())
