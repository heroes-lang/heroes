# Reaches Rebel's `x509`, so that `heroes test` on this file runs the
# package's own tests and its examples (spec § 12). It reads the
# certificates of a PEM file named on the command line and prints each
# one's subject and the last day it is valid.

use <rebel>/x509

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"reach_x509: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    for path in text_arguments()
        match read_file(path)
            .ok text =>
                match x509.parse_certificates(text)
                    .ok certs =>
                        for cert in certs
                            print(
                                f"{x509.format_name(cert.subject)} until {cert.not_after.year}-{cert.not_after.month}-{cert.not_after.day}"
                            )
                    .err e => print(f"{e.code}: {e.msg}")
            .err e => print(f"{e.code}: {e.msg}")
