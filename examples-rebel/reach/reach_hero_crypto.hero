# Reaches Rebel's floor `crypto/hero_crypto`, so that `heroes test` on this
# file runs the floor's own tests (spec § 12). It prints whether this
# machine's own cryptography signs with ECDSA on P-256.

use <rebel>/crypto/hero_crypto

function main()
    print(hero_crypto.offers(hero_crypto.HERO_CRYPTO_SIGN_ECDSA_SHA256))
