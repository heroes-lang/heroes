# The waits between a job's attempts: exponential from the first wait to the
# longest, each spread by chance so jobs that failed together do not run
# again together. The chance is drawn from a generator seeded by the run's
# seed and the job's id, the attempt's own number of that sequence, so one
# seed gives one job the same waits on every run, on every worker, which is
# what makes a failure replayable and the demo's account fixed. The wait is
# `jobs.retry_wait_with` over that fraction, handed to the store's
# `fail_attempt_with`.

use <rebel>/jobs
use <rebel>/random
use <rebel>/retries
use <rebel>/time

use cli/settings

# The policy of a run's waits: `first_wait` doubled each attempt up to
# `longest_wait`, spread by `spread` either way.
#
# - `s`: the run's settings.
#
# Fails `invalid` where the waits or the spread are out of their bounds, as
# `retries.backoff` and `retries.with_jitter` say.
function policy_of(s: settings.Settings) -> retries.Backoff?
    plain = retries.backoff(first: s.first_wait, multiplier: 2.0, longest: s.longest_wait)?
    return retries.with_jitter(plain, jitter: .spread(factor: s.spread))

# The chance that spreads the wait after attempt `attempt` of job `job`: the
# `attempt`th number of the generator whose state is the seed and the id.
#
# - `seed`: the run's seed.
# - `job`: the job's id, from 1.
# - `attempt`: the attempt that failed, from 1.
function fraction_for(seed: i64, job: i64, attempt: i64) -> f64
    generator @= random.Generator(high: to_u64(seed).default(0), low: to_u64(job).default(0))
    drawn: f64 @= 0.0

    for _ in range(from: 0, to: attempt)
        drawn @ random.next_f64(@generator)

    return drawn

# The wait before job `job` runs again after its attempt `attempt` failed.
#
# - `policy`: the run's policy.
# - `seed`: the run's seed.
# - `job`: the job's id.
# - `attempt`: the attempt that failed, from 1.
#
# Fails as `jobs.retry_wait_with` fails, where the policy is out of its
# bounds.
function wait_for(policy: retries.Backoff, seed: i64, job: i64, attempt: i64) -> time.Duration?
    return jobs.retry_wait_with(
        policy,
        attempt: attempt,
        fraction: fraction_for(seed: seed, job: job, attempt: attempt)
    )

test "wait_for: one seed, one job, one attempt draw one wait; another seed another"
    policy = policy_of(settings.default_settings()).must()
    a = wait_for(policy, seed: 7, job: 3, attempt: 2).must()
    assert a == wait_for(policy, seed: 7, job: 3, attempt: 2).must()
    assert a != wait_for(policy, seed: 8, job: 3, attempt: 2).must()

test "wait_for: within a fifth either side of the doubled wait"
    policy = policy_of(settings.default_settings()).must()
    w = wait_for(policy, seed: 1, job: 1, attempt: 2).must()
    assert w.nanoseconds >= 24_000_000_000 && w.nanoseconds <= 36_000_000_000
