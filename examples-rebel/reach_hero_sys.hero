# Reaches Rebel's floor over the platform layer's questions about the machine
# and the process, `hero_sys.h`, so that `heroes test` on this file runs the
# floor's own tests (spec § 12, § 13). It prints the size of a page of memory,
# which every machine has.

use <rebel>/os/hero_sys

function main()
    print(hero_sys.page_size())
