# The server's commands: `serve`, which serves the registry a settings file
# describes until Ctrl-C or SIGTERM, and `token`, which an administrator runs
# on the server's machine to make a publisher's token, the publisher too
# where it is new, and print it the one time it is ever shown.

use <rebel>/flags
use <rebel>/fs
use <rebel>/net
use <rebel>/os
use <rebel>/sql/sqlite
use <rebel>/strings
use <rebel>/time

use packages/names
use server/api
use server/loop
use server/serving
use server/settings
use server/tokens
use store/database

## The server's commands

# Serves the registry `config` describes until Ctrl-C or SIGTERM.
#
# - `config`: the settings file.
#
# Fails as the settings, the listener, the state and the server fail.
function serve(config: str) -> ()?
    s = settings.parse(read_file(config)?)?
    os.catch_stop()?
    l @= net.listen(host: s.host, port: s.port)?
    base = loop.base_url_of(s, address: l.address)

    match serving.open(s, base_url: base, router: api.router()?)
        .ok opened =>
            state @= opened
            print(f"registry: serving {base} from {s.data_dir}")
            served = loop.serve(@state, l: l)
            closed = serving.close(@state)
            net.close_listener(@l)?
            served?
            closed?
            print(f"registry: stopped after {state.answered} requests")
            return ok()
        .err e =>
            _ = net.close_listener(@l).is_err()
            return fail(code: e.code, msg: e.msg)

# Makes a token for the publisher `--publisher`, made where it is new, and
# prints it: the one time it is ever shown.
#
# - `sub`: the subcommand's arguments.
#
# Fails as the database does, and `invalid` where a scope is unknown or the
# publisher's name is not shaped as a package's name is.
function make_token(sub: flags.Found) -> ()?
    s = settings.parse(read_file(flags.value_of(sub, "config")?)?)?
    name = names.parse(flags.value_of(sub, "publisher")?)?
    scopes = flags.value_of(sub, "scopes")?

    for scope in strings.split(s: scopes, sep: ",")
        if scope != tokens.SCOPE_PUBLISH && scope != tokens.SCOPE_YANK && scope != tokens.SCOPE_KEYS
            return fail(code: tokens.INVALID, msg: f"\"{scope}\" is no scope: publish, yank or keys")

    fs.make_dir_all(s.data_dir)?
    db @= database.open(settings.database_of(s))?
    made = token_in(@db, name: name, label: flags.value_of(sub, "label")?, scopes: scopes)
    store_closed = sqlite.close(@db)
    token = made?
    store_closed?
    print(token)
    return ok()

# A token made for `name`, the publisher made where it is new.
#
# - `db`: the connection.
# - `name`: the publisher.
# - `label`: what the token is called.
# - `scopes`: its scopes, joined by commas.
#
# Fails as the statements do.
function token_in(@db: sqlite.Db, name: str, label: str, scopes: str) -> str?
    _ = database.migrate_up(@db)?
    now = time.now()?

    publisher = match database.publisher_named(@db, name: name)
        .ok p  => p
        .err _ => database.add_publisher(@db, name: name, now: now)?

    token = tokens.mint()?
    database.add_token(@db, publisher: publisher, label: label, hash: tokens.stored_form(token), scopes: scopes, now: now)?
    return ok(token)
