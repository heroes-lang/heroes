# Reaches Rebel's package `http2`, so that `heroes test` on this file runs
# the tests of its face and its private modules (spec § 12). It prints the
# length RFC 7541's Huffman code gives `www.example.com`, 12 bytes, touching
# no network.

use <rebel>/bytes
use <rebel>/http2

function main()
    print(http2.huffman_length(bytes.from_text("www.example.com")))
