# The twin of `examples/logs/`: a log summariser, a file of lines in and a
# page a person can read out, written with Rebel. It prints byte for byte what
# `examples/logs/` prints from the same arguments, and ends with the same
# status, so that program's `main.expected` is this one's test too.
#
#     heroes run examples-rebel/logs/main.hero -- examples/logs/sample.log
#     heroes run examples-rebel/logs/main.hero -- examples/logs/sample.log ERROR
#
#     main.hero      the program: arguments, the file, the page, the status
#     summary.hero   counting, and the ordering a count wants
#     entry.hero     one line, taken apart, and the lines that are not one
#     mask.hero      the levels as a set of bits
#
# It ends **1** when the log holds an error, which is the whole point of
# running it from a script: the exit code answers "did anything go wrong last
# night" without anyone reading the page.
#
# What Rebel does here that `examples/logs/` writes for itself:
#
# - `strings.lines`, `trim`, `words_n`, `split_once`, `contains` and `split`
#   take a line apart, in place of that program's `strings.hero`
#   (`split_lines`, `trim_space`, `space_ending`, `space_at`, `contains`,
#   `first_at`, `holds_at`, `split_once`) and its `first_words` and `split_on`;
# - `maps.counts` tallies, `maps.pick` orders a tally by name and
#   `maps.most_common` ranks it by count, ties left in name order, in place of
#   its `tally`, `ranked` and `without`;
# - `math.count_ones` counts the levels in a mask, in place of its loop over
#   the bits.
#
# What stays this program's own is the page, the reader that **skips and
# counts** what it cannot parse rather than refusing the file, and the mask of
# levels, one bit each.

use entry
use mask
use summary

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"logs: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    given = text_arguments()

    if given.len() == 0
        print("usage: logs <file.log> [LEVEL,LEVEL…]")
        exit(code: 2)

    match read_file(given[0])
        .err e   => stop("cannot read " + given[0] + ": " + e.code)
        .ok text => report(entry.read(text), given)

# Every unhappy ending in one place, so the exit code is decided once.
#
# - `message`: what is printed before the program ends with 1.
function stop(message: str)
    print(message)
    exit(code: 1)

# The page for a log read, or the lines at the levels the command line names;
# the program ends with 1 where the log holds an error.
#
# - `r`: the log as read.
# - `given`: the command line, its second word the levels to show.
function report(r: entry.Reading, given: [str])
    if given.len() > 1
        match mask.read(given[1])
            .err e     => stop(e.code + ": " + e.msg)
            .ok wanted => show_levels(r, wanted)

        return
    print("lines: ", r.entries.len(), " read, ", r.skipped.len(), " skipped")
    print("levels:")

    for line in summary.rows(summary.tally(summary.levels_of(r.entries)))
        print(line)

    print("sources:")

    for line in summary.rows(summary.tally(summary.sources_of(r.entries)))
        print(line)

    busiest = summary.ranked(summary.tally(summary.hours_of(r.entries)))

    if busiest.len() > 0
        print("busiest hour: ", busiest[0])

    match summary.first_at(r.entries, "ERROR")
        .ok first => print("first error: ", first.source, ": ", first.message)
        .err _    => print("first error: none")

    if summary.how_many_at(r.entries, "ERROR") > 0
        exit(code: 1)

# Every line at one of the wanted levels, in the order the file had them: the
# view you want once the page has told you which levels to ask about.
#
# - `r`: the log as read.
# - `wanted`: the levels, as `mask.read` makes them.
function show_levels(r: entry.Reading, wanted: i64)
    shown: i64 @= 0

    for one in r.entries
        if mask.holds(wanted, one.level)
            shown @ shown + 1
            print(one.stamp, " ", one.source, ": ", one.message)

    print(shown, " ", join(mask.names_of(wanted), "+"), " lines")

test "the sample's page is the one the file describes"
    r = entry.read(read_file("examples/logs/sample.log").must())
    assert r.entries.len() == 12
    assert r.skipped == [8]
    assert summary.how_many_at(r.entries, "ERROR") == 2
    assert summary.first_at(r.entries, "ERROR").must().source == "emit"

test "the sample's two hours are tied, so the tie-break is what is being read"
    r = entry.read(read_file("examples/logs/sample.log").must())
    hours = summary.tally(summary.hours_of(r.entries))
    assert hours["21"].must() == hours["22"].must()
    assert summary.ranked(hours) == ["21", "22"]
    assert summary.rows(summary.tally(summary.levels_of(r.entries)))[0] == "  INFO 8"

test "a mask filters the sample the way a list of names would"
    r = entry.read(read_file("examples/logs/sample.log").must())
    problems: [entry.Entry] @= []

    for one in r.entries
        if mask.holds(mask.PROBLEMS, one.level)
            problems @ problems.push(one)

    assert problems.len() == 4
    assert summary.how_many_at(problems, "ERROR") == 2
    assert summary.how_many_at(problems, "INFO") == 0
