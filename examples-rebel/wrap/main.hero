# The twin of `examples/wrap/`: text folded to a width, written with Rebel. It
# prints byte for byte what `examples/wrap/` prints, so that program's
# `main.expected` is this one's test too.
#
#     heroes run examples-rebel/wrap/main.hero
#
# What Rebel does here that `examples/wrap/` writes for itself:
#
# - `unicode/segment.wrap` folds the text, as many words on a line as fit, a
#   word longer than the line left whole on a line of its own
#   (`break_long_words` off), the spaces at a break taken away, in place of
#   that program's loop in `wrapped`;
# - `strings.words` cuts the text into its words between runs of Unicode's
#   white space, in place of its `strings.hero` (`fields`, `space_at`);
# - `unicode/segment.width_of` and `math.max_i64` measure the widest line, in
#   place of its loop over `len()`.
#
# What stays this program's own is its four answers, which `wrapped` asks of
# Rebel: a word that fits exactly stays on the line; a word longer than the
# width overflows rather than being broken, because breaking a URL or an
# identifier is worse than a long line; every run of white space, a line break
# included, is one space, so the text's words are joined by one space before
# the fold; and no line ends in a space.
#
# Where the two fold otherwise, none of it in that program's expected output:
# `unicode/segment.wrap` breaks where UAX #14 allows, after a hyphen among
# them, and counts a line's width in the columns a terminal draws, a wide
# character two; `examples/wrap/` breaks at spaces alone and counts bytes.

use <rebel>/math
use <rebel>/strings
use <rebel>/unicode/segment

# The lines `text` folds into at `width`.
#
# - `text`: the text; its white space only separates words.
# - `width`: the most columns a line takes, from one; a word wider than it
#   stands alone on a line that overflows.
#
# No line for a text of white space alone. Fails `bad_width` where `width` is
# below one, which `unicode/segment.wrap` would read as one.
function wrapped(text: str, width: i64) -> [str]?
    if width < 1
        return fail(code: "bad_width", msg: "a width below one leaves nowhere to put a word")
    options: segment.WrapOptions @= segment.wrap_options(width)
    options.break_long_words @ false
    return ok(segment.wrap(join(strings.words(text), " "), options))

# The lines of `text` folded at `width`, joined by line feeds.
#
# - `text`: the text.
# - `width`: the most columns a line takes, from one.
#
# Fails as `wrapped` does.
function rendered(text: str, width: i64) -> str?
    return ok(join(wrapped(text, width: width)?, "\n"))

# The columns of the widest line the wrapper produced, which is the number a
# caller checks against the width it asked for, and which may EXCEED it, by
# exactly as much as the widest single word does.
#
# - `text`: the text.
# - `width`: the most columns a line takes, from one.
#
# Fails as `wrapped` does.
function longest(text: str, width: i64) -> i64?
    most: i64 @= 0

    for line in wrapped(text, width: width)?
        most @ math.max_i64(a: most, b: segment.width_of(line))

    return ok(most)

# The passage the demonstration folds.
constant PASSAGE: str
    "The quick brown fox jumps over the lazy dog and keeps going for a while"

function main()
    print(rendered(PASSAGE, width: 20).must())
    print(wrapped(PASSAGE, width: 20).must().len())
    print(longest(PASSAGE, width: 20).must())

    # A word longer than the width overflows, and the wrapper says how far.
    print(rendered("a supercalifragilistic b", width: 10).must())
    print(longest("a supercalifragilistic b", width: 10).must())

    # The exact fit, which is where `<=` and `<` disagree.
    print(rendered("ab cd", width: 5).must())
    print(rendered("ab cd", width: 4).must())

    print(wrapped("", width: 10).must().len())
    print(wrapped("x", width: 0).is_err())

test "a passage folds at the width and every line is inside it"
    said = wrapped(PASSAGE, width: 20).must()
    assert said.len() == 4

    for line in said
        assert line.len() <= 20

    assert said[0] == "The quick brown fox"

test "a word that fits exactly stays on the line"
    assert rendered("ab cd", width: 5).must() == "ab cd"
    assert rendered("ab cd", width: 4).must() == "ab\ncd"
    assert rendered("abc de", width: 6).must() == "abc de"
    assert rendered("abc de", width: 5).must() == "abc\nde"

test "a word longer than the width overflows rather than being broken"
    said = wrapped("a supercalifragilistic b", width: 10).must()
    assert said.len() == 3
    assert said[1] == "supercalifragilistic"
    assert longest("a supercalifragilistic b", width: 10).must() == 20

test "runs of whitespace collapse to one space"
    assert rendered("a    b", width: 10).must() == "a b"
    assert rendered("a\nb", width: 10).must() == "a b"
    assert rendered("a\tb", width: 10).must() == "a b"
    assert rendered("  a  b  ", width: 10).must() == "a b"

test "no line ever ends in a space"
    for line in wrapped(PASSAGE, width: 12).must()
        assert line.len() > 0
        assert !strings.has_suffix(s: line, suffix: " ")

test "an empty input wraps to nothing, not to one empty line"
    assert wrapped("", width: 10).must().len() == 0
    assert wrapped("   ", width: 10).must().len() == 0
    assert rendered("", width: 10).must() == ""

test "a width below one is refused rather than looping"
    assert wrapped("x", width: 0).is_err()
    assert wrapped("x", width: -1).is_err()
    assert !wrapped("x", width: 1).is_err()

test "a hyphen is a place the fold may break, as UAX #14 allows"
    assert rendered("well-known", width: 6).must() == "well-\nknown"

test "a width counts columns, so a word of wide characters is wider than its characters"
    assert rendered("東京 x", width: 4).must() == "東京\nx"

test "a width of one puts every word on its own line"
    assert rendered("a b c", width: 1).must() == "a\nb\nc"
    assert rendered("ab cd", width: 1).must() == "ab\ncd"

test "wrapping is idempotent at the same width"
    once = rendered(PASSAGE, width: 20).must()
    assert rendered(once, width: 20).must() == once

test "every word survives, in order, whatever the width"
    for width in [1, 5, 12, 20, 100]
        back: [str] @= []

        for line in wrapped(PASSAGE, width: width).must()
            for word in strings.words(line)
                back @ back.push(word)

        assert back == strings.words(PASSAGE)
