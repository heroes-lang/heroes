# NMEA 0183 sentences, the line protocol of weather stations, depth
# sounders and many sensors on a serial line: `$`, a talker and a sentence
# type, fields separated by commas, and `*` with a checksum, the exclusive or
# of every byte between `$` and `*` in two hexadecimal digits. A line whose
# checksum disagrees is refused, since a serial line can flip a bit and a
# wrong number is worse than none.
#
# Of the sentence types, the hub reads XDR, the transducer measurement: any
# number of groups of four fields, the transducer's type, its value, its
# unit and its name (`C,21.5,C,AIR`), each group a measurement named by the
# registry's `fields` against the transducer's name. Any other type is told
# as not read, never guessed at.

use <rebel>/bytes
use <rebel>/numbers
use <rebel>/strings
use <rebel>/uuid

use codecs/reading
use config/registry

# The code of a line that is no sentence, or whose checksum disagrees.
constant INVALID: str
    "invalid"

# The code of a sentence of a type the hub does not read.
constant UNSUPPORTED: str
    "unsupported"

# The longest sentence NMEA 0183 allows, its `$` to its line end.
constant LONGEST: i64
    82

# One sentence, its checksum checked.
record Sentence
    # The talker, two letters: `WI` for a weather instrument.
    talker: str
    # The sentence type, three letters: `XDR`.
    kind: str
    # The fields after the address, in order; an empty field is "".
    fields: [str]

# The checksum of `body`: the exclusive or of its bytes.
#
# - `body`: the bytes between `$` and `*`.
function checksum_of(body: str) -> i64
    sum @= 0

    for i in range(from: 0, to: body.len())
        sum @ sum ^ to_i64(body[i]).must()

    return sum

# `n`, 0 to 255, as NMEA writes a checksum: two upper-case hexadecimal
# digits.
#
# - `n`: the checksum.
function hex_pair(n: i64) -> str
    return strings.pad_start(s: strings.to_upper(numbers.format_int(n: n, base: 16)), width: 2, pad: "0")

# The sentence `line` holds.
#
# - `line`: one line, its line end taken off or not.
#
# Fails `invalid` where it does not begin with `$`, is longer than 82 bytes,
# has no `*` and two hexadecimal digits after it, its checksum disagrees, or
# its address is not five letters.
function parse_sentence(line: str) -> Sentence?
    text = strings.trim_end(line)

    if text.len() == 0 || text[0] != '$'
        return fail(code: INVALID, msg: "a sentence begins with $")

    if text.len() > LONGEST
        return fail(code: INVALID, msg: f"a sentence holds {LONGEST} bytes at most, and this one {text.len()}")

    star = match strings.index_of_last(s: text, substr: "*")
        .ok at => at
        .err _ => return fail(code: INVALID, msg: "the sentence has no checksum")

    if star + 3 != text.len()
        return fail(code: INVALID, msg: "the checksum is two hexadecimal digits after *")

    body = text.slice(from: 1, to: star)

    told = match numbers.parse_int_base(text.slice(from: star + 1, to: text.len()), base: 16)
        .ok n  => n
        .err _ => return fail(code: INVALID, msg: f"\"{text.slice(from: star + 1, to: text.len())}\" is no checksum")

    computed = checksum_of(body)

    if told != computed
        return fail(
            code: INVALID,
            msg: f"the sentence sums to *{hex_pair(computed)}, not its checksum *{hex_pair(told)}"
        )

    parts = strings.split(s: body, sep: ",")
    address = parts[0]

    if address.len() != 5 || !bytes.is_ascii(bytes.from_text(address))
        return fail(code: INVALID, msg: f"\"{address}\" is no talker and sentence type")

    return ok(
        Sentence(talker: address.slice(from: 0, to: 2), kind: address.slice(from: 2, to: 5), fields: parts.slice(from: 1, to: parts.len()))
    )

# The unit a transducer's type and unit letter stand for, as SenML writes
# units: a temperature in `C` is `Cel`, a humidity in `P` is `%RH`.
#
# - `kind`: the transducer's type letter.
# - `unit`: its unit letter.
function unit_of(kind: str, unit: str) -> str
    return match kind + unit
        "CC" => "Cel"
        "HP" => "%RH"
        "PB" => "bar"
        "PP" => "Pa"
        "UV" => "V"
        "IA" => "A"
        "FH" => "Hz"
        "DM" => "m"
        _    => unit

# The measurements an XDR sentence holds, each group's value named by its
# transducer's name; a group whose value is empty measures nothing.
#
# - `d`: the device, whose `fields` name its transducers.
# - `s`: the sentence, of type XDR.
#
# Fails `invalid` where its fields are not groups of four or a value is no
# number.
function transducers(d: registry.Device lent, s: Sentence) -> [reading.Measurement]?
    if s.fields.len() % 4 != 0
        return fail(
            code: INVALID,
            msg: f"an XDR sentence holds groups of four fields, and this one {s.fields.len()} fields"
        )

    values: [reading.Measurement] @= []
    at @= 0

    while at < s.fields.len()
        kind = s.fields[at]
        value = s.fields[at + 1]
        name = s.fields[at + 3]
        at @ at + 4

        if value == ""
            continue

        x = match numbers.parse_float(value)
            .ok got => got
            .err _  => return fail(code: INVALID, msg: f"the transducer {name} reads \"{value}\", which is no number")

        field = registry.field_of(d, key: name)

        unit = if field.unit != ""
            field.unit
        else
            unit_of(kind: kind, unit: s.fields[at - 2])

        values @ values.push(reading.Measurement(quantity: field.quantity, value: x, unit: unit))

    return ok(values)

# The measurements one line of `d` holds; a sentence carries no time, so the
# hub takes the moment it came.
#
# - `d`: the device on the serial line.
# - `payload`: the line's bytes.
#
# Fails `invalid` where it is no sentence or no text, and `unsupported`
# where it is a sentence of another type than XDR.
function decode(d: registry.Device lent, payload: [u8]) -> reading.Decoded?
    line = match bytes.to_text(payload)
        .ok t  => t
        .err _ => return fail(code: INVALID, msg: "the line is no text")

    s = parse_sentence(line)?

    if s.kind != "XDR"
        return fail(code: UNSUPPORTED, msg: f"the sentence {s.talker}{s.kind} is not read: the hub reads XDR")

    return ok(
        reading.Decoded(values: transducers(d, s: s)?, taken: fail(code: "not_found", msg: "a sentence carries no time"))
    )

# A weather station of the tests, its transducers named.
function station() -> registry.Device
    return registry.Device(
        id: uuid.nil_uuid(),
        name: "wx-1",
        protocol: .serial,
        address: "bench",
        encoding: .nmea,
        schema: "xdr",
        time_key: "",
        fields: [registry.FieldMap(key: "AIR", quantity: "air_temperature", unit: ""), registry.FieldMap(key: "RH", quantity: "humidity", unit: "")]
    )

test "checksum_of: as Python's reduce of xor computes it"
    assert checksum_of("WIXDR,C,21.5,C,AIR,H,48.2,P,RH,P,1.0132,B,BARO") == 0x13
    assert checksum_of("WIXDR,C,-3.25,C,AIR") == 0x3d
    assert checksum_of("") == 0

test "decode: three transducers, a negative value, and an empty one left out"
    got = decode(station(), payload: bytes.from_text("$WIXDR,C,21.5,C,AIR,H,48.2,P,RH,P,1.0132,B,BARO*13\r\n")).must()
    assert got.values == [reading.Measurement(quantity: "air_temperature", value: 21.5, unit: "Cel"), reading.Measurement(quantity: "humidity", value: 48.2, unit: "%RH"), reading.Measurement(quantity: "BARO", value: 1.0132, unit: "bar")]
    assert got.taken.is_err()
    assert decode(station(), payload: bytes.from_text("$WIXDR,C,-3.25,C,AIR*3D")).must().values[0].value == -3.25
    assert decode(station(), payload: bytes.from_text("$WIXDR,C,,C,AIR,H,50,P,RH*0D")).must().values.len() == 1

test "decode: a wrong checksum, none, another sentence type, no dollar, and bytes that are no text"
    assert decode(station(), payload: bytes.from_text("$WIXDR,C,21.5,C,AIR*00")).is_err()
    assert decode(station(), payload: bytes.from_text("$WIXDR,C,21.5,C,AIR")).is_err()
    other = decode(
        station(),
        payload: bytes.from_text("$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47")
    )
    assert other.is_err()

    match other
        .ok _  => assert false
        .err e => assert e.code == UNSUPPORTED

    assert decode(station(), payload: bytes.from_text("WIXDR*00")).is_err()
    assert decode(station(), payload: [36, 255]).is_err()
    assert decode(station(), payload: []).is_err()
