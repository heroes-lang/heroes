# A loopback stand-in for an MQTT broker, so the demo's devices, the hub
# and the panel speak MQTT 3.1.1 and 5 to something on this machine. It runs
# on a thread of its own and serves every connection on one poll loop, doing
# what the demo leans on the way a broker must: CONNECT answered with
# CONNACK (MQTT 5's Maximum QoS 1 and Retain Available 0 said, since it keeps
# nothing), a client identifier already connected taken over (the old
# connection told 0x8E, Session taken over, § 3.1.4), SUBSCRIBE granted at
# QoS 1 at most, PUBLISH routed with QoS 1 acknowledged by PUBACK after the
# routing, so a publisher's acknowledged message has reached every
# subscriber's socket, PINGREQ answered and DISCONNECT closing. A packet
# before CONNECT, a second CONNECT, QoS 2, a retained message or bytes that
# are no MQTT end the connection, as a broker ends it. Each packet is read
# and written by `mqtt`'s own `decode` and `encode`.

use <rebel>/bytes
use <rebel>/io
use <rebel>/math
use <rebel>/mqtt
use <rebel>/net
use <rebel>/numbers
use <rebel>/poll
use <rebel>/time

use standins/mqtt_state
use standins/told

# MQTT 5's reason code of a topic filter refused (§ 3.9.3, 0x8F).
constant FILTER_INVALID: i64
    143

# MQTT 3.1.1's return code of a subscription refused (§ 3.9.3, 0x80).
constant FAILURE_V4: i64
    128

# MQTT 5's reason code of a session another connection took (§ 3.14.2.1,
# 0x8E).
constant SESSION_TAKEN_OVER: i64
    142

# Ends every other open connection whose client identifier is `id`, telling
# an MQTT 5 one why, as § 3.1.4 asks of a server.
#
# - `b`: the stand-in.
# - `set`: the poll set.
# - `i`: the index of the connection that takes the identifier.
# - `id`: the identifier.
function take_over(@b: mqtt_state.Broker, set: poll.Set, i: i64, id: str)
    j @= 0

    while j < b.peers.len()
        if j != i && b.peers[j].open && b.peers[j].client_id == id
            if b.peers[j].version == 5
                _ = mqtt_state.send(b.peers[j], p: .disconnect(reason: SESSION_TAKEN_OVER, properties: []))

            mqtt_state.drop_peer(@b, set: set, i: j)
            b.taken_over @ b.taken_over + 1
        j @ j + 1

# Answers the CONNECT of peer `i`: its level and identifier kept, an older
# connection of the same identifier taken over, and CONNACK written with
# what this broker does not offer said in MQTT 5.
#
# - `b`: the stand-in.
# - `set`: the poll set.
# - `i`: the peer's index.
# - `version`: the level its CONNECT asked, 4 or 5.
# - `client_id`: the identifier it gave, "" asking for one.
function accept_connect(@b: mqtt_state.Broker, set: poll.Set, i: i64, version: i64, client_id: str)
    assigned = client_id == ""

    id = if assigned
        f"auto-{i}"
    else
        client_id

    take_over(@b, set: set, i: i, id: id)
    b.peers[i].version @ version
    b.peers[i].client_id @ id
    said: [mqtt.Property] @= []

    if version == 5
        said @ said.push(mqtt.Property(id: mqtt.MAXIMUM_QOS, value: .number(v: 1)))
        said @ said.push(mqtt.Property(id: mqtt.RETAIN_AVAILABLE, value: .number(v: 0)))

        if assigned
            said @ said.push(mqtt.Property(id: mqtt.ASSIGNED_CLIENT_IDENTIFIER, value: .text(v: id)))

    _ = mqtt_state.send(b.peers[i], p: .connack(session_present: false, reason: 0, properties: said))

# Keeps the subscriptions of a SUBSCRIBE of peer `i`, each at QoS 1 at most,
# and answers SUBACK with a code per subscription.
#
# - `b`: the stand-in.
# - `i`: the peer's index.
# - `packet_id`: the SUBSCRIBE's identifier.
# - `asked`: its subscriptions.
function subscribe(@b: mqtt_state.Broker, i: i64, packet_id: i64, asked: [mqtt.Subscription])
    kept @= b.peers[i].subscriptions
    reasons: [i64] @= []

    for s in asked
        if !mqtt.is_valid_filter(s.filter)
            if b.peers[i].version == 5
                reasons @ reasons.push(FILTER_INVALID)
            else
                reasons @ reasons.push(FAILURE_V4)
            continue

        granted @= s
        granted.qos @ math.min_i64(a: s.qos, b: 1)
        replaced @= false

        for j in range(from: 0, to: kept.len())
            if kept[j].filter == s.filter
                kept[j] @ granted
                replaced @ true

        if !replaced
            kept @ kept.push(granted)

        reasons @ reasons.push(granted.qos)

    b.peers[i].subscriptions @ kept
    _ = mqtt_state.send(b.peers[i], p: .suback(packet_id: packet_id, reasons: reasons, properties: []))

# Drops the subscriptions an UNSUBSCRIBE of peer `i` names, and answers it.
#
# - `b`: the stand-in.
# - `i`: the peer's index.
# - `packet_id`: the UNSUBSCRIBE's identifier.
# - `filters`: the filters it names.
function unsubscribe(@b: mqtt_state.Broker, i: i64, packet_id: i64, filters: [str])
    kept: [mqtt.Subscription] @= []

    for s in b.peers[i].subscriptions
        if !names(filters, wanted: s.filter)
            kept @ kept.push(s)

    b.peers[i].subscriptions @ kept
    reasons: [i64] @= []

    if b.peers[i].version == 5
        for _ in filters
            reasons @ reasons.push(0)

    _ = mqtt_state.send(b.peers[i], p: .unsuback(packet_id: packet_id, reasons: reasons, properties: []))

# Whether `filters` holds `wanted`.
#
# - `filters`: the filters an UNSUBSCRIBE names.
# - `wanted`: a subscription's filter.
function names(filters: [str], wanted: str) -> bool
    for f in filters
        if f == wanted
            return true

    return false

# Acts on one packet of peer `i`.
#
# - `b`: the stand-in.
# - `set`: the poll set.
# - `i`: the peer's index.
# - `p`: the packet.
function on_packet(@b: mqtt_state.Broker, set: poll.Set, i: i64, p: mqtt.Packet)
    connected = b.peers[i].version != 0

    match p
        .connect c =>
            # A second CONNECT on one connection is a protocol error (§ 3.1).
            if connected
                mqtt_state.drop_peer(@b, set: set, i: i)
            else
                accept_connect(@b, set: set, i: i, version: c.version, client_id: c.client_id)
        .publish m =>
            # This broker grants QoS 1 at most and keeps nothing, and said so.
            if !connected || m.message.qos > 1 || m.message.retain
                mqtt_state.drop_peer(@b, set: set, i: i)
            else
                mqtt_state.route(@b, from: i, m: m.message)

                if m.message.qos == 1
                    _ = mqtt_state.send(
                        b.peers[i],
                        p: .puback(packet_id: m.message.packet_id, reason: 0, properties: [])
                    )
        .subscribe s =>
            if connected
                subscribe(@b, i: i, packet_id: s.packet_id, asked: s.subscriptions)
            else
                mqtt_state.drop_peer(@b, set: set, i: i)
        .unsubscribe u =>
            if connected
                unsubscribe(@b, i: i, packet_id: u.packet_id, filters: u.filters)
            else
                mqtt_state.drop_peer(@b, set: set, i: i)
        .pingreq =>
            if connected
                _ = mqtt_state.send(b.peers[i], p: .pingresp)
            else
                mqtt_state.drop_peer(@b, set: set, i: i)
        # A delivery's acknowledgement: nothing is sent again, so nothing
        # waits on it.
        .puback _     => _ = 0
        .disconnect _ => mqtt_state.drop_peer(@b, set: set, i: i)
        # A packet only a server sends, or one of QoS 2's exchange, which this
        # broker never begins: a protocol error.
        .connack _ | .suback _ | .unsuback _ | .pubrec _ | .pubrel _ | .pubcomp _ | .pingresp | .auth _ => mqtt_state.drop_peer(
            @b,
            set: set,
            i: i
        )

# Reads what peer `i` sent and acts on every whole packet of it.
#
# - `b`: the stand-in.
# - `set`: the poll set.
# - `i`: the peer's index.
function on_readable(@b: mqtt_state.Broker, set: poll.Set, i: i64)
    data = match io.read(b.peers[i].stream, n: 65_536)
        .ok d => d
        .err _ =>
            mqtt_state.drop_peer(@b, set: set, i: i)
            return

    if data.len() == 0
        mqtt_state.drop_peer(@b, set: set, i: i)
        return

    bytes.push_all(to: @b.peers[i].held, from: data)

    while b.peers[i].open
        n = mqtt_state.packet_length(b.peers[i].held)

        if n == 0
            return

        if n < 0
            mqtt_state.drop_peer(@b, set: set, i: i)
            return

        held = b.peers[i].held
        b.peers[i].held @ held.slice(from: n, to: held.len())

        # A CONNECT is read at the level it says, whatever is asked here.
        version = if b.peers[i].version == 0
            5
        else
            b.peers[i].version

        match mqtt.decode(held.slice(from: 0, to: n), version: version)
            .ok p  => on_packet(@b, set: set, i: i, p: p)
            .err _ => mqtt_state.drop_peer(@b, set: set, i: i)

# The index of the open peer whose key is `key`, -1 where none is.
#
# - `b`: the stand-in.
# - `key`: a key of the poll set.
function peer_of(b: mqtt_state.Broker lent, key: i64) -> i64
    for i in range(from: 0, to: b.peers.len())
        if b.peers[i].open && b.peers[i].key == key
            return i

    return -1

# Accepts the connection `l` holds and adds it to the set; one the set has
# no room for is closed unserved.
#
# - `b`: the stand-in, which gains the peer.
# - `set`: the poll set.
# - `l`: the listener.
function accept(@b: mqtt_state.Broker, set: poll.Set, l: net.Listener lent)
    conn @= match net.accept(l, deadline_ms: net.FOREVER)
        .ok c  => c
        .err _ => return

    key = match poll.add_stream(set, s: conn.stream, interest: .read)
        .ok k => k
        .err _ =>
            _ = io.close(@conn.stream).is_err()
            return

    peers @= b.peers
    peers @ peers.push(
        mqtt_state.Peer(key: key, stream: conn.stream, held: [], version: 0, client_id: "", subscriptions: [], next_id: 1, open: true)
    )
    b.peers @ peers

# Serves every connection until the program's stop is asked, then closes
# them.
#
# - `b`: the stand-in.
# - `set`: the poll set, the listener in it.
# - `l`: the listener.
# - `listening`: the listener's key in the set.
function serve(@b: mqtt_state.Broker, set: poll.Set, l: net.Listener lent, listening: i64)
    while true
        events = match poll.wait(set, limit: time.hours(1).must())
            .ok got => got
            .err _  => break

        for e in events
            if e.key == listening
                accept(@b, set: set, l: l)
            else
                i = peer_of(b, key: e.key)

                if i >= 0
                    on_readable(@b, set: set, i: i)

    for i in range(from: 0, to: b.peers.len())
        mqtt_state.drop_peer(@b, set: set, i: i)

# Listens on the loopback, tells the starter at `told_port` where, serves
# until the program's stop, and answers what it carried.
#
# - `told_port`: the port of the starter's socket.
#
# Fails as `net.listen` and `poll.make` fail, the starter told first.
function serve_on(told_port: i64) -> str?
    l @= match net.listen(host: "127.0.0.1", port: 0)
        .ok got => got
        .err e =>
            _ = told.failed(port: told_port, why: e.msg).is_err()
            return fail(code: e.code, msg: e.msg)

    set @= match poll.make(256)
        .ok got => got
        .err e =>
            _ = net.close_listener(@l).is_err()
            _ = told.failed(port: told_port, why: e.msg).is_err()
            return fail(code: e.code, msg: e.msg)

    listening = match poll.add_listener(set, l: l)
        .ok key => key
        .err e =>
            _ = poll.close(@set).is_err()
            _ = net.close_listener(@l).is_err()
            _ = told.failed(port: told_port, why: e.msg).is_err()
            return fail(code: e.code, msg: e.msg)

    told.ready(port: told_port, listening: l.address.port)?
    b @= mqtt_state.Broker(peers: [], published: 0, delivered: 0, taken_over: 0)
    serve(@b, set: set, l: l, listening: listening)
    poll.close(@set)?
    net.close_listener(@l)?
    return ok(
        f"the MQTT stand-in: {b.peers.len()} connections, {b.published} published, {b.delivered} delivered, {b.taken_over} taken over"
    )

# The body of the stand-in's thread: serves until the program's stop.
#
# - `arg`: the port of the starter's socket, in decimal.
function run(arg: str) -> str
    told_port = match numbers.parse_int(arg)
        .ok p  => p
        .err _ => return f"the MQTT stand-in: \"{arg}\" is no port"

    return match serve_on(told_port)
        .ok said => said
        .err e   => f"the MQTT stand-in failed: {e.msg}"

test "names: a filter named, and one that is only a prefix of one"
    assert names(["a/#", "b"], wanted: "b")
    assert !names(["a/#"], wanted: "a")
    assert !names([], wanted: "a")
