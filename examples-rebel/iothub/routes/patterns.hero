# Addresses and the patterns that match them, by each protocol's own rules,
# since a rule's `from` is written in the syntax its protocol's people
# already know: MQTT's topic filters (`+` one level, a last `#` the rest),
# NATS's subjects (`*` one token, a last `>` the rest), AMQP's topic
# exchanges (`*` one word, `#` zero or more words, anywhere), and a serial
# port by its name or `*` for every port.
#
# An AMQP address is `<exchange>/<routing key>`: the exchange matched
# exactly, the key as a topic exchange matches a binding's key. The AMQP
# stand-in routes by the same function, so the hub's rules and the broker
# can never disagree about what a key matches.

use <rebel>/mqtt
use <rebel>/nats
use <rebel>/strings

use config/registry

# Whether the routing key `key` matches the binding key `pattern`, as a
# topic exchange decides: both split into words at `.`, `*` standing for
# exactly one word and `#` for zero or more.
#
# - `pattern`: the binding key, `line1.#` or `*.press-2.*`.
# - `key`: the routing key of a message, `line1.press-2.vibration`.
#
# It fills a table of which prefixes match which, so its cost is the
# product of the two counts of words, never exponential.
function topic_matches(pattern: str, key: str) -> bool
    p = strings.split(s: pattern, sep: ".")
    k = strings.split(s: key, sep: ".")
    width = k.len() + 1

    # `matched[i * width + j]`: whether the first `i` words of the pattern
    # match the first `j` words of the key.
    matched @= [true]

    for _ in range(from: 1, to: (p.len() + 1) * width)
        matched @ matched.push(false)

    for i in range(from: 1, to: p.len() + 1)
        word = p[i - 1]

        for j in range(from: 0, to: width)
            here = if word == "#"
                matched[(i - 1) * width + j] || j > 0 && matched[i * width + j - 1]
            else if j == 0
                false
            else
                matched[(i - 1) * width + j - 1] && (word == "*" || word == k[j - 1])

            matched[i * width + j] @ here

    return matched[p.len() * width + k.len()]

# The two parts of an AMQP address, `<exchange>/<routing key>`.
record AmqpAddress
    # The exchange, "" for the default one.
    exchange: str
    # The routing key, or a binding's pattern.
    key: str

# The parts of `address`, split at its first `/`.
#
# - `address`: `alerts/coldchain.fridge-07`.
#
# Fails `invalid` where it holds no `/`.
function amqp_parts(address: str) -> AmqpAddress?
    at = match strings.index_of(s: address, substr: "/")
        .ok i  => i
        .err _ => return fail(code: "invalid", msg: f"\"{address}\" is no AMQP address: it is <exchange>/<routing key>")

    return ok(
        AmqpAddress(exchange: address.slice(from: 0, to: at), key: address.slice(from: at + 1, to: address.len()))
    )

# Whether `address` matches `pattern` by `protocol`'s rules.
#
# - `protocol`: the protocol both are written in.
# - `pattern`: a topic filter, a subject with wildcards, `<exchange>/<binding
#   key>`, or a port's name or `*`.
# - `address`: where a message came: a topic, a subject, `<exchange>/<routing
#   key>`, a port's name.
function matches(protocol: registry.Protocol, pattern: str, address: str) -> bool
    return match protocol
        .mqtt => mqtt.matches(pattern: pattern, topic: address)
        .nats => nats.matches(pattern: pattern, subject: address)
        .amqp =>
            match amqp_parts(pattern)
                .err _ => false
                .ok p =>
                    match amqp_parts(address)
                        .err _ => false
                        .ok a  => p.exchange == a.exchange && topic_matches(pattern: p.key, key: a.key)
        .serial => pattern == "*" || pattern == address

# Whether `address` is one a message can be published at by `protocol`: a
# topic or a subject with no wildcard, an AMQP address whose key holds no
# wildcard word.
#
# - `protocol`: the protocol.
# - `address`: the address.
function is_publishable(protocol: registry.Protocol, address: str) -> bool
    return match protocol
        .mqtt => mqtt.is_valid_topic(address)
        .nats => nats.is_valid_subject(address)
        .amqp =>
            match amqp_parts(address)
                .err _ => false
                .ok a =>
                    words = strings.split(s: a.key, sep: ".")
                    a.key.len() <= 255 && !words.any(is_wildcard_word)
        .serial => false

# Whether `word` is one of AMQP's two wildcards.
#
# - `word`: one word of a routing key.
function is_wildcard_word(word: str) -> bool
    return word == "*" || word == "#"

test "topic_matches: one word, any number, none, and in the middle, as RabbitMQ's topic exchange routes"
    assert topic_matches(pattern: "line1.#", key: "line1.press-2.vibration")
    assert topic_matches(pattern: "line1.#", key: "line1")
    assert topic_matches(pattern: "*.press-2.*", key: "line1.press-2.vibration")
    assert !topic_matches(pattern: "*.press-2.*", key: "line1.press-2")
    assert topic_matches(pattern: "#", key: "")
    assert topic_matches(pattern: "a.#.z", key: "a.z")
    assert topic_matches(pattern: "a.#.z", key: "a.b.c.z")
    assert !topic_matches(pattern: "a.#.z", key: "a.b.c")
    assert topic_matches(pattern: "coldchain.#", key: "coldchain.fridge-07")
    assert !topic_matches(pattern: "coldchain", key: "coldchain.fridge-07")

test "matches: each protocol's wildcards, and an AMQP address on another exchange"
    assert matches(.mqtt, pattern: "devices/+/up", address: "devices/fridge-07/up")
    assert !matches(.mqtt, pattern: "devices/+/up", address: "devices/fridge-07/down")
    assert matches(.nats, pattern: "fleet.>", address: "fleet.tracker-3.position")
    assert matches(.amqp, pattern: "plant/line1.#", address: "plant/line1.press-2.vibration")
    assert !matches(.amqp, pattern: "plant/line1.#", address: "alerts/line1.press-2")
    assert matches(.serial, pattern: "*", address: "bench") && !matches(.serial, pattern: "dock", address: "bench")

test "is_publishable: wildcards refused, an AMQP address with no exchange part, and a serial port"
    assert is_publishable(.mqtt, address: "weather/wx-1")
    assert !is_publishable(.mqtt, address: "weather/+")
    assert !is_publishable(.nats, address: "plant.>")
    assert is_publishable(.amqp, address: "alerts/coldchain.fridge-07")
    assert !is_publishable(.amqp, address: "alerts/coldchain.#")
    assert !is_publishable(.amqp, address: "coldchain")
    assert !is_publishable(.serial, address: "bench")
