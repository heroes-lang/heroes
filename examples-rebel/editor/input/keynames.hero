# The names keys have in the settings, as a person writes them: `ctrl-s`,
# `alt-f`, `ctrl-right`, `shift-up`, `f3`, `page_down`, `enter`, a character
# itself, `space`. `term` names the keys it knows and hands every other one
# as its bytes, so the keys held with Alt, Shift or Ctrl beside an arrow come
# as xterm's sequences (`ESC [ 1 ; 5 C` is Ctrl and Right, `ESC f` Alt and
# f); this module names those, and a sequence it does not know is named by
# its bytes in hexadecimal, `key-1b5b32347e`, so even a key of a terminal of
# its own can be bound.
#
# Ctrl-H, Ctrl-I, Ctrl-J and Ctrl-M are refused as names: terminals send them
# as Backspace, Tab and Enter, so a binding of one would never fire.

use <rebel>/bytes
use <rebel>/numbers
use <rebel>/strings
use <rebel>/term
use <rebel>/unicode/segment

# The modifiers xterm writes as the number after `;` in a key's sequence,
# by that number.
function modifier_names() -> {str: str}
    return {
        "2": "shift"
        "3": "alt"
        "4": "shift-alt"
        "5": "ctrl"
        "6": "ctrl-shift"
        "7": "ctrl-alt"
        "8": "ctrl-shift-alt"
    }

# The keys xterm ends a sequence `ESC [ 1 ; m X` with, by the final byte.
function arrow_names() -> {str: str}
    return {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end"}

# The keys xterm writes as `ESC [ n ; m ~`, by their number.
function tilde_names() -> {str: str}
    return {"2": "insert", "3": "delete", "5": "page_up", "6": "page_down"}

# The name of `k` as the settings write it.
#
# - `k`: a key, as `term` or `tui` read it.
function name_of(k: term.Key) -> str
    return match k
        .character c    => character_name(c.text)
        .enter          => "enter"
        .tab            => "tab"
        .backspace      => "backspace"
        .escape         => "escape"
        .up             => "up"
        .down           => "down"
        .left           => "left"
        .right          => "right"
        .home           => "home"
        .end            => "end"
        .page_up        => "page_up"
        .page_down      => "page_down"
        .insert         => "insert"
        .delete         => "delete"
        .function_key f => "f" + to_str(f.n)
        .control c      => "ctrl-" + c.letter
        .other o        => sequence_name(o.bytes)

# The name of a character typed: itself, or `space`.
#
# - `text`: the character.
function character_name(text: str) -> str
    if text == " "
        return "space"

    return text

# The name of a key `term` handed as its bytes: a modifier and a key where
# xterm's sequences say so, `alt-` and a character for Escape before one,
# else `key-` and the bytes in hexadecimal.
#
# - `sent`: the bytes the terminal sent.
function sequence_name(sent: [u8]) -> str
    text = bytes.to_text(sent).default("")

    if sent.len() == 2 && sent[0] == 27 && sent[1] > 32 && sent[1] < 127
        return "alt-" + text.slice(from: 1, to: 2)

    if strings.has_prefix(s: text, prefix: "\u{1b}[") && text.len() >= 6
        body = text.slice(from: 2, to: text.len() - 1)
        last = text.slice(from: text.len() - 1, to: text.len())
        halves = strings.split(s: body, sep: ";")

        if halves.len() == 2
            modifier = modifier_names()[halves[1]].default("")

            key = if last == "~"
                tilde_names()[halves[0]].default("")
            else if halves[0] == "1"
                arrow_names()[last].default("")
            else
                ""

            if modifier != "" && key != ""
                return modifier + "-" + key

    return "key-" + bytes.format_hex(sent)

# The key `name` names, as `name_of` would name it.
#
# - `name`: a key's name, in any case for the words; a character stands for
#   itself.
#
# Fails `invalid` where the name is none, saying why; Ctrl-H, Ctrl-I, Ctrl-J
# and Ctrl-M among them, which terminals send as other keys.
function key_of(name: str) -> term.Key?
    if segment.graphemes(name).len() == 1
        return ok(.character(text: name))

    word = strings.to_lower(name)

    match plain_keys()[word]
        .ok k  => return ok(k)
        .err _ => _ = 0

    if strings.has_prefix(s: word, prefix: "f") && word.len() >= 2 && word.len() <= 3
        match numbers.parse_int(word.slice(from: 1, to: word.len()))
            .ok n =>
                if n >= 1 && n <= 12
                    return ok(.function_key(n: n))
            .err _ => _ = 0

    if strings.has_prefix(s: word, prefix: "ctrl-") && word.len() == 6
        letter = word.slice(from: 5, to: 6)

        if letter == "h" || letter == "i" || letter == "j" || letter == "m"
            return fail(
                code: "invalid",
                msg: f"\"{name}\" never comes: terminals send Ctrl-{strings.to_upper(letter)} as Backspace, Tab or Enter"
            )

        if letter[0] >= 'a' && letter[0] <= 'z'
            return ok(.control(letter: letter))

    if strings.has_prefix(s: word, prefix: "alt-") && name.len() == 5 && name[4] > 32 && name[4] < 127
        return ok(.other(bytes: [27, name[4]]))

    if strings.has_prefix(s: word, prefix: "key-")
        match bytes.parse_hex(word.slice(from: 4, to: word.len()))
            .ok sent =>
                if sent.len() > 0
                    return ok(.other(bytes: sent))
            .err _ => _ = 0

    match modified_key(word)
        .ok k => return ok(k)
        .err _ => return fail(
            code: "invalid",
            msg: f"\"{name}\" is no key: a character, \"enter\", \"f3\", \"ctrl-s\", \"alt-f\", \"ctrl-right\", \"page_down\", or \"key-\" and the bytes it sends"
        )

# The keys named by a word alone.
function plain_keys() -> {str: term.Key}
    return {
        "space": .character(text: " ")
        "enter": .enter
        "tab": .tab
        "backspace": .backspace
        "escape": .escape
        "up": .up
        "down": .down
        "left": .left
        "right": .right
        "home": .home
        "end": .end
        "page_up": .page_up
        "page_down": .page_down
        "insert": .insert
        "delete": .delete
    }

# The key a modifier's name and a key's name give, `ctrl-right`, as the bytes
# xterm sends for it.
#
# - `word`: the name, in lower case.
#
# Fails `not_found` where it is no such name.
function modified_key(word: str) -> term.Key?
    for number in keys(modifier_names())
        prefix = modifier_names()[number].must() + "-"

        if strings.has_prefix(s: word, prefix: prefix)
            key = word.slice(from: prefix.len(), to: word.len())

            for final in keys(arrow_names())
                if arrow_names()[final].must() == key
                    return ok(.other(bytes: bytes.from_text("\u{1b}[1;" + number + final)))

            for code in keys(tilde_names())
                if tilde_names()[code].must() == key
                    return ok(.other(bytes: bytes.from_text("\u{1b}[" + code + ";" + number + "~")))

    return fail(code: "not_found", msg: f"no key named \"{word}\"")

test "name_of: Ctrl and a letter, a function key, space and Escape"
    assert name_of(.control(letter: "s")) == "ctrl-s"
    assert name_of(.function_key(n: 3)) == "f3"
    assert name_of(.character(text: " ")) == "space"
    assert name_of(.escape) == "escape"

test "name_of: xterm's sequences of Ctrl, Alt and Shift beside a key"
    assert name_of(.other(bytes: bytes.from_text("\u{1b}[1;5C"))) == "ctrl-right"
    assert name_of(.other(bytes: bytes.from_text("\u{1b}[1;3A"))) == "alt-up"
    assert name_of(.other(bytes: bytes.from_text("\u{1b}[6;5~"))) == "ctrl-page_down"
    assert name_of(.other(bytes: [27, 'f'])) == "alt-f"
    assert name_of(.other(bytes: bytes.from_text("\u{1b}[99~"))) == "key-1b5b39397e"

test "key_of: every name read back to the key it names"
    for name in ["ctrl-s", "f12", "alt-f", "alt-<", "ctrl-left", "shift-end", "ctrl-alt-page_up", "space", "é", "page_down", "key-1b5b39397e"]
        assert name_of(key_of(name).must()) == name

test "key_of: the case of a word, and names refused"
    assert key_of("Ctrl-S").must() == .control(letter: "s")
    assert key_of("ctrl-m").is_err()
    assert key_of("f13").is_err()
    assert key_of("hyper-x").is_err()
    assert key_of("key-zz").is_err()
