# The maze: a rectangle of characters, and the arithmetic that turns a position
# into one number.
#
#     #   wall          S   where you start
#     .   open          E   where you are going
#
# **A position is an index, not a pair.** `row * width + column` is what lets
# the solver keep "how I got here" in a `{i64: i64}`: the language has no
# tuples, and one number is what makes the map cheap to read.
#
# Every row must be the same width. A ragged maze is refused rather than
# padded, because padding invents open squares and a solver that walks through
# one has found a path the file does not describe.

use <rebel>/strings
use <rebel>/unicode

## Error codes

# A file with no row.
constant ERR_EMPTY_MAZE: str
    "empty_maze"

# A maze with no start or no goal.
constant ERR_MISSING_MARK: str
    "missing_mark"

# A row of another width than the first.
constant ERR_RAGGED_MAZE: str
    "ragged_maze"

# A maze with two starts or two goals.
constant ERR_REPEATED_MARK: str
    "repeated_mark"

# A maze read from a file: its rows, every one `width` bytes.
record Grid
    # The rows, top first, none empty.
    rows: [str]
    # The bytes of every row.
    width: i64
    # How many rows.
    height: i64

# A square nobody walks through.
constant WALL: u8
    '#'

# The one square the way starts at.
constant START: u8
    'S'

# The one square the way ends at.
constant GOAL: u8
    'E'

# The maze `text` draws, its empty lines passed over.
#
# - `text`: the file's text, one row a line.
#
# Fails `empty_maze` where it holds no row, `ragged_maze` where a row is not as
# wide as the first, and as `locate` fails where the start or the goal is
# missing or repeated.
function read(text: str) -> Grid?
    rows: [str] @= []

    for line in strings.lines(text)
        if line != ""
            rows @ rows.push(line)

    if rows.len() == 0
        return fail(code: ERR_EMPTY_MAZE, msg: "the file has no rows")
    width = rows[0].len()

    for line in rows
        if line.len() != width
            return fail(code: ERR_RAGGED_MAZE, msg: "every row must be " + width.to_str() + " wide")

    g = Grid(rows: rows, width: width, height: rows.len())
    _ = locate(g, START)?
    _ = locate(g, GOAL)?
    return ok(g)

## Positions

# The position of the square at `row` and `column`.
#
# - `g`: the maze.
# - `row`: from 0, the top.
# - `column`: from 0, the left.
function index_of(g: Grid, row: i64, column: i64) -> i64
    return row * g.width + column

# The row of the square at `index`.
#
# - `g`: the maze.
# - `index`: a position inside it.
function row_of(g: Grid, index: i64) -> i64
    return index / g.width

# The column of the square at `index`.
#
# - `g`: the maze.
# - `index`: a position inside it.
function column_of(g: Grid, index: i64) -> i64
    return index % g.width

# The byte of the square at `index`.
#
# - `g`: the maze.
# - `index`: a position inside it; one outside aborts.
function at(g: Grid, index: i64) -> u8
    return g.rows[row_of(g, index)][column_of(g, index)]

# Whether `row` and `column` name a square of `g`.
#
# - `g`: the maze.
# - `row`: any row, those outside answering false.
# - `column`: any column, those outside answering false.
function inside(g: Grid, row: i64, column: i64) -> bool
    return row >= 0 && row < g.height && column >= 0 && column < g.width

# Whether the square at `index` can be walked through: anything but a wall.
#
# - `g`: the maze.
# - `index`: a position inside it.
function is_open(g: Grid, index: i64) -> bool
    return at(g, index) != WALL

# Where the one square marked `mark` is. Exactly one: a maze with two starts is
# a maze whose answer depends on which one the reader meant.
#
# - `g`: the maze.
# - `mark`: `START` or `GOAL`.
#
# Fails `repeated_mark` where two squares hold it and `missing_mark` where
# none does.
function locate(g: Grid, mark: u8) -> i64?
    found: i64 @= -1

    for row in range(from: 0, to: g.height)
        for column in range(from: 0, to: g.width)
            index = index_of(g, row: row, column: column)

            if at(g, index) == mark
                if found >= 0
                    return fail(code: ERR_REPEATED_MARK, msg: "the maze has more than one `" + mark_text(mark) + "`")
                found @ index

    if found < 0
        return fail(code: ERR_MISSING_MARK, msg: "the maze has no `" + mark_text(mark) + "`")
    return ok(found)

# A square's byte as the text of its character, for a drawing or a message.
#
# - `mark`: a byte of a row; the marks are ASCII, each one character.
function mark_text(mark: u8) -> str
    # A `u8` always fits an `i64`, and every byte below 0x80 is a character
    # of its own, so neither `must` can fail on a mark.
    return unicode.from_code_point(to_i64(mark).must()).must()

# The squares one step from `index`, up, down, left and right in that order:
# inside the maze, and not a wall.
#
# - `g`: the maze.
# - `index`: a position inside it.
function neighbours(g: Grid, index: i64) -> [i64]
    row = row_of(g, index)
    column = column_of(g, index)
    out: [i64] @= []
    out @ step(g, out, row: row - 1, column: column)
    out @ step(g, out, row: row + 1, column: column)
    out @ step(g, out, row: row, column: column - 1)
    out @ step(g, out, row: row, column: column + 1)
    return out

# `out` with the square at `row` and `column` added, where it is inside `g`
# and open.
#
# - `g`: the maze.
# - `out`: the squares found so far.
# - `row`: any row.
# - `column`: any column.
function step(g: Grid, out: [i64], row: i64, column: i64) -> [i64]
    if !inside(g, row: row, column: column)
        return out
    index = index_of(g, row: row, column: column)

    if !is_open(g, index)
        return out
    return out.push(index)

test "an index is a row and a column, both ways"
    g = read("S.\n.E\n").must()
    assert index_of(g, row: 1, column: 0) == 2
    assert row_of(g, 2) == 1
    assert column_of(g, 3) == 1
    assert at(g, 0) == START
    assert at(g, 3) == GOAL

test "a maze must be a rectangle with one start and one goal"
    assert read("S.\n.E\n").must().width == 2

    for pair in [["S.\n.E.\n", ERR_RAGGED_MAZE], ["", ERR_EMPTY_MAZE], ["SE\nS.\n", ERR_REPEATED_MARK], ["S.\n..\n", ERR_MISSING_MARK], ["E.\n..\n", ERR_MISSING_MARK]]
        match read(pair[0])
            .ok _  => assert false
            .err e => assert e.code == pair[1]

test "a missing mark is named by its own letter"
    match read("S.\n..\n")
        .ok _  => assert false
        .err e => assert e.msg == "the maze has no `E`"

test "the neighbours of a square stop at the walls and at the edges"
    g = read("S#\n.E\n").must()
    assert neighbours(g, 0) == [2]
    assert neighbours(g, 2) == [0, 3]
    assert neighbours(g, 3) == [2]
