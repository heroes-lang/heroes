# Reaches Rebel's `mail`, so that `heroes test` on this file runs the
# package's own tests (spec § 12). It builds a short message, writes it, reads
# it back and prints its subject and the address it is sent to.

use <rebel>/mail

function main()
    match mail.text_part(text: "Hello from Heroes.\n", subtype: "plain")
        .err e => print(e.code, ": ", e.msg)
        .ok body =>
            m = mail.with_field(body, name: "To", value: "Ana Lima <ana@example.org>")
            dated = mail.with_field(m, name: "Subject", value: "Grüße")

            match mail.encode_message(dated, mail.standard_options())
                .err e => print(e.code, ": ", e.msg)
                .ok data =>
                    back = mail.decode_message(data)
                    print(mail.decoded_value_of(back, name: "Subject").default("?"))

                    for a in mail.addresses_of(back, name: "To").default([])
                        print(mail.format_addr_spec(a))
