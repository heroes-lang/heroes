# One connection to the demo's mail server: the SMTP conversation (RFC
# 5321) the invoicing tool's client holds, from the greeting to QUIT. It
# answers EHLO with PIPELINING, SIZE, 8BITMIME and AUTH PLAIN (RFC 4954),
# logs the one user in, takes MAIL FROM and RCPT TO, reads DATA to its lone
# dot with the dots of its lines unstuffed (RFC 5321 § 4.5.2), and answers
# RSET, NOOP and QUIT; anything else is refused with 502, as a server
# refuses a command it does not know, and a command out of its order with
# 503. A message is taken only once `standins/inspect` has checked it, and
# the reply that takes it says what was found.
#
# Replies are written as each command is read, so a client that pipelines
# MAIL, RCPT and DATA reads them in order, as PIPELINING (RFC 2920) asks.

use <rebel>/bytes
use <rebel>/io
use <rebel>/strings

use standins/inspect

## Bounds

# The most bytes of a message the server takes, which EHLO announces.
constant MAX_MESSAGE: i64
    10_485_760

## What was served

# What a connection, or the whole run, served.
record Tally
    # The connections.
    connections: i64
    # The messages taken.
    taken: i64
    # The messages refused.
    refused: i64
    # The logins refused.
    logins_refused: i64

## A connection

# Where a connection stands.
record State
    # Whether the client said EHLO or HELO.
    greeted: bool
    # Whether the client logged in.
    logged_in: bool
    # The envelope's sender, "" before MAIL FROM.
    sender: str
    # Whether MAIL FROM was said.
    has_sender: bool
    # The envelope's recipients.
    recipients: [str]

# One connection: the greeting, then each command until QUIT or the
# client's end; answers what it served.
#
# - `stream`: the connection, which the caller closes.
# - `user`: the one user.
# - `password`: its password.
function session(stream: io.Stream, user: str, password: str) -> Tally
    tally @= Tally(connections: 1, taken: 0, refused: 0, logins_refused: 0)
    r @= io.reader(stream)
    state @= State(greeted: false, logged_in: false, sender: "", has_sender: false, recipients: [])

    if reply(stream, line: "220 invoice-stand-in ESMTP ready").is_err()
        return tally

    while true
        line = match read_line(@r)
            .ok l  => l
            .err _ => break

        verb = strings.to_upper_ascii(first_word(line))
        argument = strings.trim(line.slice(from: first_word(line).len(), to: line.len()))

        answer = if verb == "EHLO"
            state @ State(greeted: true, logged_in: false, sender: "", has_sender: false, recipients: [])
            ["250-invoice-stand-in greets " + argument, "250-PIPELINING", f"250-SIZE {MAX_MESSAGE}", "250-8BITMIME", "250 AUTH PLAIN"].join(
                "\r\n"
            )
        else if verb == "HELO"
            state @ State(greeted: true, logged_in: false, sender: "", has_sender: false, recipients: [])
            "250 invoice-stand-in"
        else if verb == "AUTH"
            login(@r, stream: stream, @state, argument: argument, user: user, password: password, @tally)
        else if verb == "MAIL"
            mail_from(@state, argument: argument)
        else if verb == "RCPT"
            rcpt_to(@state, argument: argument)
        else if verb == "DATA"
            data(@r, stream: stream, @state, @tally)
        else if verb == "RSET"
            state.sender @ ""
            state.has_sender @ false
            state.recipients @ []
            "250 2.0.0 reset"
        else if verb == "NOOP"
            "250 2.0.0 OK"
        else if verb == "QUIT"
            _ = reply(stream, line: "221 2.0.0 bye").is_err()
            break
        else
            "502 5.5.2 command not recognized"

        if answer != "" && reply(stream, line: answer).is_err()
            break

    return tally

# AUTH PLAIN, its response on the line or asked for with 334.
#
# - `r`: the reader over the connection.
# - `stream`: the connection.
# - `state`: where the connection stands; logged in where it holds.
# - `argument`: what follows AUTH.
# - `user`: the one user.
# - `password`: its password.
# - `tally`: counts a refused login.
function login(@r: io.Reader, stream: io.Stream, @state: State, argument: str, user: str, password: str, @tally: Tally) -> str
    words = strings.words(argument)

    if !state.greeted
        return "503 5.5.1 EHLO first"

    if words.len() == 0 || strings.to_upper_ascii(words[0]) != "PLAIN"
        return "504 5.5.4 only PLAIN is offered"

    response = if words.len() > 1
        words[1]
    else
        if reply(stream, line: "334 ").is_err()
            return ""
        read_line(@r).default("*")

    if response == "*"
        return "501 5.0.0 authentication cancelled"

    match bytes.parse_base64(response)
        .err _ => return "501 5.5.2 the response is no base 64"
        .ok decoded =>
            parts = split_zero(decoded)

            if parts.len() == 3 && parts[1] == bytes.from_text(user) && parts[2] == bytes.from_text(password)
                state.logged_in @ true
                return "235 2.7.0 authentication succeeded"
            tally.logins_refused @ tally.logins_refused + 1
            return "535 5.7.8 authentication credentials invalid"

# MAIL FROM.
#
# - `state`: where the connection stands; its sender set where it holds.
# - `argument`: what follows MAIL.
function mail_from(@state: State, argument: str) -> str
    if !state.logged_in
        return "530 5.7.0 authentication required"

    address = match path_of(argument: argument, keyword: "FROM:")
        .ok a  => a
        .err _ => return "501 5.5.4 MAIL FROM:<address> asked"

    state.sender @ address
    state.has_sender @ true
    state.recipients @ []
    return "250 2.1.0 sender OK"

# RCPT TO.
#
# - `state`: where the connection stands; a recipient added where it holds.
# - `argument`: what follows RCPT.
function rcpt_to(@state: State, argument: str) -> str
    if !state.has_sender
        return "503 5.5.1 MAIL first"

    match path_of(argument: argument, keyword: "TO:")
        .err _ => return "501 5.5.4 RCPT TO:<address> asked"
        .ok a =>
            state.recipients @ state.recipients.push(a)
            return "250 2.1.5 recipient OK"

# DATA: the message read to its lone dot, its dots unstuffed, checked, and
# taken or refused.
#
# - `r`: the reader over the connection.
# - `stream`: the connection.
# - `state`: where the connection stands; its envelope cleared after.
# - `tally`: counts the message taken or refused.
function data(@r: io.Reader, stream: io.Stream, @state: State, @tally: Tally) -> str
    if !state.has_sender || state.recipients.len() == 0
        return "503 5.5.1 MAIL and RCPT first"

    if reply(stream, line: "354 end data with <CR><LF>.<CR><LF>").is_err()
        return ""
    message: [u8] @= []
    too_big @= false

    while true
        raw = match io.read_until(@r, byte: 10)
            .ok b  => b
            .err _ => return ""

        if raw.len() == 0
            return ""

        if raw == bytes.from_text(".\r\n") || raw == bytes.from_text(".\n")
            break

        start = if raw[0] == '.'
            1
        else
            0

        if message.len() + raw.len() > MAX_MESSAGE
            too_big @ true
        else
            for i in range(from: start, to: raw.len())
                message @ message.push(raw[i])

    sender = state.sender
    recipients = state.recipients
    state.has_sender @ false
    state.sender @ ""
    state.recipients @ []

    if too_big
        tally.refused @ tally.refused + 1
        return f"552 5.3.4 the message is past {MAX_MESSAGE} bytes"

    match inspect.inspect(message, sender: sender, recipients: recipients)
        .err e =>
            tally.refused @ tally.refused + 1
            return "554 5.6.0 " + e.msg
        .ok a =>
            tally.taken @ tally.taken + 1

            pages = if a.pages == 1
                "1 page"
            else
                f"{a.pages} pages"
            return f"250 2.0.0 queued {a.filename}, {pages}, naming {a.number}"

## Lines

# Writes one reply, its line end added.
#
# - `stream`: the connection.
# - `line`: the reply, several lines joined by CR LF.
#
# Fails as `io.write_text` fails.
function reply(stream: io.Stream, line: str) -> ()?
    return io.write_text(stream, text: line + "\r\n")

# The next command line, its line end taken off.
#
# - `r`: the reader.
#
# Fails `closed` at the client's end, and as `io.read_line` fails.
function read_line(@r: io.Reader) -> str?
    if io.at_end(@r)?
        return fail(code: "closed", msg: "the client closed the connection")
    return io.read_line(@r)

# The first word of `line`.
#
# - `line`: a command line.
function first_word(line: str) -> str
    words = strings.words(line)

    if words.len() == 0
        return ""
    return words[0]

# The address of `FROM:<address>` or `TO:<address>`, its parameters after
# it ignored.
#
# - `argument`: what follows the verb.
# - `keyword`: `FROM:` or `TO:`.
#
# Fails `invalid` where it is not of that form.
function path_of(argument: str, keyword: str) -> str?
    if !strings.has_prefix(s: strings.to_upper_ascii(argument), prefix: keyword)
        return fail(code: "invalid", msg: "no " + keyword)
    rest = strings.trim(argument.slice(from: keyword.len(), to: argument.len()))

    if !strings.has_prefix(s: rest, prefix: "<")
        return fail(code: "invalid", msg: "no <address>")
    close = strings.index_of(s: rest, substr: ">")?
    return ok(rest.slice(from: 1, to: close))

# `decoded` cut at its zero bytes.
#
# - `decoded`: AUTH PLAIN's response, decoded.
function split_zero(decoded: [u8]) -> [[u8]]
    parts: [[u8]] @= []
    current: [u8] @= []

    for b in decoded
        if b == 0
            parts @ parts.push(current)
            current @ []
        else
            current @ current.push(b)

    parts @ parts.push(current)
    return parts

test "path_of: an address with parameters after it, and forms refused"
    assert path_of(argument: "FROM:<billing@co.example> SIZE=1200", keyword: "FROM:").must() == "billing@co.example"
    assert path_of(argument: "to:<ana@x.example>", keyword: "TO:").must() == "ana@x.example"
    assert path_of(argument: "FROM:billing@co.example", keyword: "FROM:").is_err()

test "split_zero: PLAIN's three parts"
    assert split_zero([0, 97, 0, 98]) == [[], [97], [98]]
