# The demo's mail server: a loopback stand-in that speaks SMTP far enough
# for the invoicing tool's client (`standins/smtp_session` holds one
# connection's conversation), so the demo mails its documents with no mail
# server installed and nothing leaving the machine. It checks each message
# before it takes it (`standins/inspect`), and the reply that takes it says
# what was found, which is how the demo hears the server's side.
#
# It runs on a thread of its own: it listens on 127.0.0.1 at a port the
# system chooses, tells the demo the port over the demo's control port (a
# thread is handed one text and answers one only when it ends, spec § 13),
# and serves one connection after another until the program is asked to
# stop; its thread then answers what it served.

use <rebel>/io
use <rebel>/net
use <rebel>/strings

use standins/smtp_session

## Bounds

# How long a notice to the demo may take, in milliseconds.
constant NOTICE_MS: i64
    10_000

## The server

# The stand-in's thread: serves until the program is asked to stop.
#
# - `arg`: three lines: the demo's control port, the one user and its
#   password.
function run(arg: str) -> str
    lines = strings.split(s: arg, sep: "\n")

    if lines.len() != 3
        return "smtp stand-in: three lines asked, the control port, the user and the password"

    match served(control: lines[0], user: lines[1], password: lines[2])
        .ok t =>
            return f"smtp stand-in: {counted(t.connections, noun: "connection")}, {counted(t.taken, noun: "message")} taken, {t.refused} refused, {counted(t.logins_refused, noun: "login")} refused"
        .err e => return "smtp stand-in: " + e.msg

# `n` and `noun`, the noun in the plural but for one: `1 connection`, `5
# messages`.
#
# - `n`: how many.
# - `noun`: the noun in the singular.
function counted(n: i64, noun: str) -> str
    if n == 1
        return f"1 {noun}"
    return f"{n} {noun}s"

# Every connection served, then what was served.
#
# - `control`: the demo's control port, in decimal.
# - `user`: the one user.
# - `password`: its password.
#
# Fails as `net.listen` fails, or where the demo cannot be told the port.
function served(control: str, user: str, password: str) -> smtp_session.Tally?
    listener @= net.listen(host: "127.0.0.1", port: 0)?

    match tell(control_port: net.parse_port(control)?, port: listener.address.port)
        .err e =>
            _ = net.close_listener(@listener).is_err()
            return fail(code: e.code, msg: e.msg)
        .ok _ => _ = 0

    total @= smtp_session.Tally(connections: 0, taken: 0, refused: 0, logins_refused: 0)

    while true
        match net.accept(listener, deadline_ms: net.FOREVER)
            .err _ => break
            .ok made =>
                conn @= made
                t = smtp_session.session(conn.stream, user: user, password: password)
                total @ smtp_session.Tally(
                    connections: total.connections + 1,
                    taken: total.taken + t.taken,
                    refused: total.refused + t.refused,
                    logins_refused: total.logins_refused + t.logins_refused
                )
                _ = io.close(@conn.stream).is_err()

    _ = net.close_listener(@listener).is_err()
    return ok(total)

# Tells the demo at `control_port` that the server listens on `port`: one
# line, `READY <port>`.
#
# - `control_port`: the demo's control port on 127.0.0.1.
# - `port`: the server's port.
#
# Fails as `net.connect` and `io.write_text` fail.
function tell(control_port: i64, port: i64) -> ()?
    made = net.connect(host: "127.0.0.1", port: control_port, deadline_ms: NOTICE_MS)?
    conn @= made
    written = io.write_text(conn.stream, text: f"READY {port}\n")
    _ = io.close(@conn.stream).is_err()
    return written

# The port a notice `READY <port>` names.
#
# - `line`: the notice.
#
# Fails `invalid` where it is none.
function parse_notice(line: str) -> i64?
    match strings.after_prefix(s: strings.trim(line), prefix: "READY ")
        .err _   => return fail(code: "invalid", msg: f"\"{line}\" is no notice")
        .ok rest => return net.parse_port(rest)

test "counted: one, none and many"
    assert counted(1, noun: "login") == "1 login" && counted(0, noun: "login") == "0 logins" && counted(5, noun: "message") == "5 messages"

test "parse_notice: a notice, and two that are not"
    assert parse_notice("READY 2525\n").must() == 2525
    assert parse_notice("READY x").is_err() && parse_notice("2525").is_err()
