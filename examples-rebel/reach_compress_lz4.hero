# Reaches Rebel's `compress/lz4`, so that `heroes test` on this file runs
# the package's own tests (spec § 12). It compresses a line as an LZ4 frame,
# reads it back, and prints both sizes.

use <rebel>/compress/lz4

function main()
    line: [u8] = [
        0x68
        0x65
        0x72
        0x6f
        0x65
        0x73
        0x20
        0x68
        0x65
        0x72
        0x6f
        0x65
        0x73
        0x20
        0x68
        0x65
        0x72
        0x6f
        0x65
        0x73
    ]

    match lz4.compress(line, lz4.default_options())
        .err e => print(e.code, ": ", e.msg)
        .ok packed =>
            back = lz4.decompress(packed, limit: 1000).default([])
            print(line.len(), " bytes, ", packed.len(), " compressed, ", back.len(), " read back")
