# The server's loop, on the thread that owns the state (`app/state`): it
# waits with `poll` on the listener, every WebSocket, a timer and one ring
# per worker, hands each connection it accepts to the workers
# (`http/workers`) with `m.send(@conn)`, and answers what they ask, each
# request handled by the pipeline against the state on this thread, so the
# database, the search index, the limiters and the hub are reached from one
# thread and nothing is locked (spec § 11; panel 254). A worker reads its
# connection's requests as their bytes come and writes the answers, so a
# client that sends half a request, or reads its answer slowly, holds its
# worker alone; a WebSocket held open never keeps a page from being
# answered.
#
# The loop ends at the stop: a signal after `os.catch_stop` (SIGTERM, Ctrl-C)
# fails the wait `stopped`, and the API's `stop_server` sets the state's
# `stopping`. Either way the same shutdown follows: no connection accepted
# after, every worker's stop bell rung so each closes the connection it
# waits on, what the workers had asked answered `stopping`, every worker
# waited for, every WebSocket told 1001.

use <rebel>/http
use <rebel>/io
use <rebel>/log
use <rebel>/net
use <rebel>/poll
use <rebel>/time
use <rebel>/websocket

use app/state
use http/pipeline
use http/workers
use ops/ops
use realtime/realtime

## Codes

# The code of a wait that failed for a reason other than the stop.
constant FAILED: str
    "failed"

## The loop

# The most entries the poll set holds: the listener, the timer, the rings
# and the WebSockets.
constant MOST_ENTRIES: i64
    4096

# How many workers read connections at once: each holds one connection
# until its client leaves or goes quiet past the settings' deadline.
constant WORKERS: i64
    8

# What a serving did, told at its end.
record Served
    # The connections accepted.
    connections: i64
    # The requests answered.
    requests: i64
    # The WebSockets told 1001 at the stop.
    sockets_told: i64
    # The idle HTTP connections closed at the stop.
    idle_closed: i64
    # What asked the stop: `signal` or `api`.
    by: str

# The loop's end of one worker's bells.
record Bell
    # The end of the worker's ring, which the loop reads.
    ring: net.Conn
    # Its key in the poll set.
    key: i64
    # The end of the worker's stop bell, which the loop writes at the stop.
    stop: net.Conn

# Serves every connection `l` accepts, until the stop.
#
# - `app`: the state.
# - `l`: the listener; its owner closes it after.
#
# Fails `failed` where the system's wait fails, and as `poll.make` fails;
# every worker started is waited for first.
function run(@app: state.App, l: net.Listener) -> Served?
    set @= poll.make(MOST_ENTRIES)?
    asks: (mailbox workers.Ask) = mailbox()
    conns: (mailbox net.Conn) = mailbox()
    bell_box: (mailbox workers.Bells) = mailbox()
    bells: [Bell] @= []
    pool: [(thread workers.Worked)] @= []
    idle_ms = time.to_units(app.settings.deadline, unit: .millisecond)
    start = workers.Start(conns: conns, asks: asks, bells: bell_box, limits: app_limits(app), idle_ms: idle_ms)

    while pool.len() < WORKERS
        match rung(set: set, to: bell_box)
            .err _ => break
            .ok bell =>
                match spawn(workers.work, start)
                    .err _ =>
                        _ = poll.remove(set, key: bell.key).is_err()
                        bells @ bells.push(bell)
                        break
                    .ok t =>
                        pool @ pool.push(t)
                        bells @ bells.push(bell)

    outcome = looped(@app, set: set, l: l, conns: conns, asks: asks, bells: bells)
    bell_box.close()
    idle @= 0

    # The workers are woken and their asks answered before they are waited
    # for, so none waits on this thread while this thread waits on it.
    for b in bells
        _ = io.write(b.stop.stream, data: [1]).is_err()

    conns.close()
    asks.close()
    drained(asks)

    for t in pool
        idle @ idle + t.wait().idle_closed

    for b in bells
        ends @= b
        _ = poll.remove(set, key: ends.key).is_err()
        _ = io.close(@ends.ring.stream).is_err()
        _ = io.close(@ends.stop.stream).is_err()

    told = realtime.going_away(@app.hub)
    ops.gauge(@app.registry, name: ops.SOCKETS, value: 0)
    poll.close(@set)?
    by = outcome?.by
    _ = log.info(
        app.logger,
        msg: "server stopped",
        fields: [log.text(key: "by", value: by), log.integer("requests", value: app.answered), log.integer("websockets_told", value: told)]
    ).is_err()
    return ok(
        Served(connections: outcome?.connections, requests: app.answered, sockets_told: told, idle_closed: idle, by: by)
    )

# One worker's two bells made, the loop's ends kept and the ring waited
# on, the worker's ends handed to `to` for the worker that takes them.
#
# - `set`: the poll set.
# - `to`: the workers' mailbox of bells.
#
# Fails as `net.pair`, `poll.add_conn` and the hand-over fail, every end
# made closed.
function rung(set: poll.Set, to: (mailbox workers.Bells)) -> Bell?
    ring @= net.pair(net.FOREVER)?

    match net.pair(net.FOREVER)
        .err e =>
            _ = io.close(@ring.first.stream).is_err()
            _ = io.close(@ring.second.stream).is_err()
            return fail(code: e.code, msg: e.msg)
        .ok made =>
            stop @= made

            match poll.add_conn(set, c: ring.first, interest: .read)
                .err e =>
                    closed_all(a: @ring, b: @stop)
                    return fail(code: e.code, msg: e.msg)
                .ok key =>
                    given @= workers.Bells(ring: ring.second, stop: stop.second)

                    match workers.hand(to, @given)
                        .err e =>
                            _ = poll.remove(set, key: key).is_err()
                            _ = io.close(@given.ring.stream).is_err()
                            _ = io.close(@given.stop.stream).is_err()
                            _ = io.close(@ring.first.stream).is_err()
                            _ = io.close(@stop.first.stream).is_err()
                            return fail(code: e.code, msg: e.msg)
                        .ok _ => return ok(Bell(ring: ring.first, key: key, stop: stop.first))

# Closes the four ends of two pairs.
#
# - `a`: one pair.
# - `b`: the other.
function closed_all(@a: net.Pair, @b: net.Pair)
    _ = io.close(@a.first.stream).is_err()
    _ = io.close(@a.second.stream).is_err()
    _ = io.close(@b.first.stream).is_err()
    _ = io.close(@b.second.stream).is_err()

# What the loop did until the stop.
record Looped
    # The connections accepted.
    connections: i64
    # What asked the stop: `signal` or `api`.
    by: str

# The loop itself, until the stop: connections accepted and handed to the
# workers, the WebSockets read, the timer's pings sent, the workers' asks
# answered as their rings wake the wait.
#
# - `app`: the state.
# - `set`: the poll set, the rings in it.
# - `l`: the listener.
# - `conns`: the workers' mailbox of connections.
# - `asks`: the workers' asks.
# - `bells`: the loop's ends of the workers' bells.
#
# Fails `failed` where the system's wait fails, and as the poll set fails.
function looped(@app: state.App, set: poll.Set, l: net.Listener, conns: (mailbox net.Conn), asks: (mailbox workers.Ask), bells: [Bell] lent) -> Looped?
    listening = poll.add_listener(set, l: l)?
    every = app.settings.ping_every
    ticker = poll.add_timer(set, first: every, every: every)?
    accepted: i64 @= 0
    by: str @= ""

    while by == ""
        if app.stopping
            by @ "api"
            break

        events = match poll.wait(set, limit: time.seconds(1)?)
            .ok got => got
            .err e =>
                if e.code == poll.STOPPED
                    by @ "signal"
                    break
                return fail(code: FAILED, msg: f"waiting on the connections: {e.msg}")

        for e in events
            if e.key == listening
                if handed(app, l: l, conns: conns)
                    accepted @ accepted + 1
            else if e.key == ticker
                drop_keys(set, keys_gone: realtime.ping_all(@app.hub))
            else if realtime.holds(app.hub, key: e.key)
                on_socket(@app, set: set, key: e.key)
            else
                quieted(bells, key: e.key)

            drop_keys(set, keys_gone: app.gone)
            app.gone @ []

        # Every ask waiting is answered after every wait, rung or not, so an
        # ask whose ring was lost is answered within the wait's second.
        while !app.stopping
            match asks.receive(within_ms: 0)
                .err _  => break
                .ok ask => answered(@app, set: set, ask: ask)

    _ = poll.remove(set, key: listening).is_err()
    _ = poll.remove(set, key: ticker).is_err()
    return ok(Looped(connections: accepted, by: by))

# Accepts the connection `l` holds and hands it to the workers; whether one
# was taken.
#
# - `app`: the state, whose settings give a connection's deadline.
# - `l`: the listener, ready.
# - `conns`: the workers' mailbox of connections.
function handed(app: state.App lent, l: net.Listener, conns: (mailbox net.Conn)) -> bool
    deadline_ms = time.to_units(app.settings.deadline, unit: .millisecond)

    conn @= match net.accept(l, deadline_ms: deadline_ms)
        .ok c  => c
        .err _ => return false

    match conns.send(@conn)
        .ok _ => return true
        .err _ =>
            # Not sent, the program stopping: the connection is still this
            # thread's.
            _ = io.close(@conn.stream).is_err()
            return false

# Reads what the ring with `key` holds, so it stops waking the wait: one
# byte per ask, the asks themselves answered after the wait.
#
# - `bells`: the loop's ends of the workers' bells.
# - `key`: the key the wait told readable.
function quieted(bells: [Bell] lent, key: i64)
    for b in bells
        if b.key == key
            _ = io.read(b.ring.stream, n: 4096).is_err()
            return

# The answer to one ask, on this thread: a request handled by the pipeline
# and answered on its mailbox, or a connection adopted as a WebSocket.
#
# - `app`: the state.
# - `set`: the poll set, which gains an adopted WebSocket.
# - `ask`: the ask.
function answered(@app: state.App, set: poll.Set, ask: workers.Ask)
    match ask
        .request q =>
            match pipeline.handle(@app, r: q.r)
                .respond rs => workers.answer(q.back, reply: .respond(response: rs.response))
                .upgrade u  => workers.answer(q.back, reply: .upgrade(user_id: u.user_id, user: u.user))
        .adopt a =>
            reader @= a.reader
            adopted(@app, set: set, @reader, r: a.r, user_id: a.user_id, user: a.user)

# What the workers had asked when the stop came, answered: each request
# `stopping`, each connection handed over closed.
#
# - `asks`: the workers' asks, closed.
function drained(asks: (mailbox workers.Ask))
    while true
        match asks.receive(within_ms: 0)
            .err _ => break
            .ok ask =>
                match ask
                    .request q => workers.answer(q.back, reply: .stopping)
                    .adopt a =>
                        reader @= a.reader
                        _ = io.close(@reader.stream).is_err()

# Takes each of `keys_gone` out of `set`; one already out is no failure.
#
# - `set`: the poll set.
# - `keys_gone`: the keys of sockets the hub let go.
function drop_keys(set: poll.Set, keys_gone: [i64])
    for key in keys_gone
        _ = poll.remove(set, key: key).is_err()

# The limits a request is read with: the usual ones, its body bounded by the
# settings.
#
# - `app`: the state.
function app_limits(app: state.App lent) -> http.Limits
    limits: http.Limits @= http.default_limits()
    limits.body_bytes @ app.settings.body_bytes
    return limits

# Turns the connection `reader` reads into the WebSocket of the account
# `user`: its 101 written, its deadline lifted so it may stay open, the
# poll set waiting on it, the hub given it under its key.
#
# - `app`: the state.
# - `set`: the poll set.
# - `reader`: its reader, handed to `websocket.upgrade`.
# - `r`: the opening request.
# - `user_id`: the account's number.
# - `user`: the account's name.
function adopted(@app: state.App, set: poll.Set, @reader: io.Reader, r: http.Request, user_id: i64, user: str)
    conn = match websocket.upgrade(@reader, r: r, server: websocket.default_server())
        .ok c => c
        .err _ =>
            _ = io.close(@reader.stream).is_err()
            return

    _ = net.set_deadline(conn.stream, deadline_ms: net.FOREVER).is_err()

    key = match poll.add_stream(set, s: conn.stream, interest: .read)
        .ok k => k
        .err _ =>
            dropped @= conn
            _ = websocket.drop(@dropped).is_err()
            return

    if realtime.admit(@app.hub, key: key, conn: conn, user_id: user_id, user: user).is_err()
        _ = poll.remove(set, key: key).is_err()
        dropped @= conn
        _ = websocket.drop(@dropped).is_err()
        return

    ops.gauge(@app.registry, name: ops.SOCKETS, value: realtime.count(app.hub))

    # What the client wrote with its request is held by the socket, and its
    # stream, drained, does not tell of it (`websocket`'s head).
    if realtime.held(app.hub, key: key) > 0
        on_socket(@app, set: set, key: key)

# Reads the socket `key`, and lets it go from `set` where it closed.
#
# - `app`: the state.
# - `set`: the poll set.
# - `key`: the socket's key.
function on_socket(@app: state.App, set: poll.Set, key: i64)
    match realtime.on_readable(@app.hub, key: key)
        .open => _ = 0
        .closed _ =>
            _ = poll.remove(set, key: key).is_err()
            ops.gauge(@app.registry, name: ops.SOCKETS, value: realtime.count(app.hub))
