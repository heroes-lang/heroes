# Passwords kept as Argon2id hashes in the PHC string form (RFC 9106), each
# with its own salt of 16 bytes from the system's generator. The PHC string
# carries the costs it was made with, so raising the costs in the settings
# leaves every hash already stored verifiable, and `needs_rehash` tells which
# to make again at the next sign-in.

use <rebel>/bytes
use <rebel>/crypto
use <rebel>/os

## Costs

# The bytes of a salt: RFC 9106 § 3.1 recommends 16.
constant SALT_BYTES: i64
    16

# The bytes of the tag a hash holds: RFC 9106 § 4 uses 32.
constant TAG_BYTES: i64
    32

# The costs of Argon2id with `memory_kib` of memory and `passes` passes over
# it, one lane.
#
# - `memory_kib`: the memory in KiB, at least 8.
# - `passes`: the passes, at least 1.
function costs(memory_kib: i64, passes: i64) -> crypto.Argon2Params
    p: crypto.Argon2Params @= crypto.argon2_low_memory()
    p.memory @ memory_kib
    p.passes @ passes
    p.lanes @ 1
    p.length @ TAG_BYTES
    return p

## Hashing

# The PHC string of `password`'s Argon2id hash with a fresh salt.
#
# - `password`: the password as typed; any text.
# - `params`: the costs, from `costs`.
#
# Fails as `os.random_bytes` and `crypto.hash_argon2` fail: `invalid` where a
# cost is outside what Argon2 takes.
function hash(password: str, params: crypto.Argon2Params) -> str?
    salt = os.random_bytes(SALT_BYTES)?
    return crypto.hash_argon2(params, password: bytes.from_text(password), salt: salt)

# Whether `password` is the one `stored` was made from, compared in a time
# that does not depend on where they differ.
#
# - `password`: the password as typed.
# - `stored`: the PHC string kept for the account.
#
# False, never a failure, where `stored` is no Argon2 PHC string: a broken
# row refuses its sign-in rather than answering 500.
function verify(password: str, stored: str) -> bool
    return crypto.verify_argon2(bytes.from_text(password), hash: stored).default(false)

# Whether `stored` was made with other costs than `params`, so the next
# sign-in should hash the password again.
#
# - `stored`: the PHC string kept for the account.
# - `params`: the costs the settings ask for.
function needs_rehash(stored: str, params: crypto.Argon2Params) -> bool
    return match crypto.parse_argon2(stored)
        .ok was => was.memory != params.memory || was.passes != params.passes || was.lanes != params.lanes
        .err _  => true

# A password hashed with the least costs Argon2 takes, so a test runs fast;
# never what a server uses.
function test_costs() -> crypto.Argon2Params
    return costs(memory_kib: 8, passes: 1)

test "hash and verify: the right password, a wrong one, and a stored text that is no hash"
    stored = hash("correct horse battery", params: test_costs()).must()
    assert verify(password: "correct horse battery", stored: stored)
    assert !verify(password: "correct horse battery!", stored: stored)
    assert !verify(password: "anything", stored: "not a hash")

test "hash: two hashes of one password differ, each salt its own"
    assert hash("same", params: test_costs()).must() != hash("same", params: test_costs()).must()

test "needs_rehash: the same costs, raised costs, and a text that is no hash"
    stored = hash("pw", params: test_costs()).must()
    assert !needs_rehash(stored, params: test_costs())
    assert needs_rehash(stored, params: costs(memory_kib: 16, passes: 1))
    assert needs_rehash("x", params: test_costs())
