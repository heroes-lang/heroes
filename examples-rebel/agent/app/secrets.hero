# The clients of the two APIs, with their keys: read from the environment as
# each API's own clients read it (`ANTHROPIC_API_KEY`, `OPENAI_API_KEY` and
# their base URLs), or, where none is set and a person is at the terminal,
# typed at a prompt with nothing echoed (`term.read_secret`). A key is never
# printed, logged or written to a store. Every client has `max_retries` 0,
# since the agent retries itself (`attempts`).

use <rebel>/io
use <rebel>/llm/anthropic
use <rebel>/llm/openai
use <rebel>/term

# The code of a key that is neither set nor typed.
constant NOT_FOUND: str
    "not_found"

# A client of Claude's API.
#
# Fails `not_found` where neither `ANTHROPIC_API_KEY` nor
# `ANTHROPIC_AUTH_TOKEN` is set and no key is typed, the message naming the
# variable.
function anthropic_client() -> anthropic.Client?
    c @= anthropic.default_client("")

    match anthropic.client_from_env()
        .ok from_env => c @ from_env
        .err _       => c @ anthropic.default_client(
            typed(variable: "ANTHROPIC_API_KEY", prompt: "Anthropic API key: ")?
        )

    c.max_retries @ 0
    return ok(c)

# A client of OpenAI's API, or of the OpenAI-compatible server at `base_url`
# where it is given, which needs no key.
#
# - `base_url`: the server's address with its version, "" for OpenAI's own.
#
# Fails `not_found` where OpenAI's own is asked, `OPENAI_API_KEY` is not set
# and no key is typed.
function openai_client(base_url: str) -> openai.Client?
    c @= openai.local_client(base_url)

    if base_url == ""
        match openai.client_from_env()
            .ok from_env => c @ from_env
            .err _       => c @ openai.default_client(typed(variable: "OPENAI_API_KEY", prompt: "OpenAI API key: ")?)

    c.max_retries @ 0
    return ok(c)

# A key typed at the terminal, where the standard input is one.
function typed(variable: str, prompt: str) -> str?
    if !io.is_terminal(io.stdin()).default(false)
        return fail(code: NOT_FOUND, msg: f"{variable} is not set, and no terminal is there to type a key at")

    key = term.read_secret(prompt)?

    if key == ""
        return fail(code: NOT_FOUND, msg: f"{variable} is not set, and no key was typed")

    return ok(key)
