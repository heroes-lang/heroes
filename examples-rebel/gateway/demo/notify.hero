# Readiness notification between the demo's supervisor and the services it
# starts, in the shape of systemd's `sd_notify`: the supervisor makes a
# mailbox (spec § 11) and hands it to the service's thread; the service,
# once it listens, sends one `Ready` on it, its name and its port, and the
# mailbox is closed as the thread ends, so a service that could not listen
# is told at once as one that ended without saying so. The supervisor
# starts nothing that needs a service before its notification has come.

## Bounds

# How long the supervisor waits for a notification, in milliseconds.
constant NOTIFY_MS: i64
    10_000

## Notifying

# What a service said once it was ready.
record Ready
    # The service's name.
    service: str
    # The port it listens on.
    port: i64

# Tells the supervisor, through `to`, that `service` listens on `port`, and
# closes `to`: a service says it once.
#
# - `to`: the mailbox handed to the service.
# - `service`: the service's name, one word.
# - `port`: the port it listens on.
#
# Fails `closed` or `stopped` where the supervisor no longer waits.
function ready(to: (mailbox Ready), service: str, port: i64) -> ()?
    sent = to.send(Ready(service: service, port: port))
    to.close()
    return sent

# The notification `from` receives, awaited `NOTIFY_MS` at most.
#
# - `from`: the mailbox handed to the service.
#
# Fails `closed` where the service ended without saying it is ready,
# `timeout` where nothing came in time, and `stopped` where the program
# was asked to stop first.
function await_ready(from: (mailbox Ready)) -> Ready?
    match from.receive(within_ms: NOTIFY_MS)
        .ok r => return ok(r)
        .err e =>
            if e.code == "closed"
                return fail(code: e.code, msg: "it ended without saying it is ready")
            return fail(code: e.code, msg: e.msg)

test "ready and await_ready: the notification crosses whole, and a closed mailbox is told at once"
    m: (mailbox Ready) = mailbox()
    ready(m, service: "dns", port: 5353).must()
    assert await_ready(m).must() == Ready(service: "dns", port: 5353)
    assert await_ready(m).is_err()
    silent: (mailbox Ready) = mailbox()
    silent.close()
    assert await_ready(silent).is_err()
