# `lab demo`: the scripted, self-contained session. It reads a notebook from
# the input, runs it and prints the report, reads every plot it wrote back
# from its file, makes the script's edits and prints what each re-ran, then
# types the script's lines at a REPL and prints what each answered.
#
# Everything printed is the same on every run and every machine: values to
# twelve significant digits, the plots by their names, sizes and CRC-32s and
# never their folder, every random draw from the notebook's seed, and a
# timing by its rounds alone.

use <rebel>/io

use demo/script
use notebook/cells
use notebook/report
use notebook/run as runs
use plot/files
use repl/session

# Prints `lines`, one to a line.
#
# - `lines`: the lines.
function print_all(lines: [str])
    for line in lines
        print(line)

# A line for each plot `r` wrote, read back from its file: its size and its
# title as the file holds them, or why it could not be read.
#
# - `r`: the run.
# - `plots`: the folder the plots were written to.
function read_back_lines(r: runs.Run, plots: str) -> [str]
    out: [str] @= ["== the plots, read back from their files"]

    for c in r.notebook.cells
        match r.outcomes[c.name]
            .ok o =>
                for p in o.plots
                    match files.read_back(dir: plots, file: p.file)
                        .ok back => out @ out.push(
                            f"{p.file}: a PNG of {back.width} by {back.height}, titled \"{back.title}\""
                        )
                        .err e   => out @ out.push(f"{p.file}: unreadable: {e.code}: {e.msg}")
            .err _ => _ = 0

    return out

# The REPL's part of the demo: each line typed shown after the prompt, then
# what it answered.
#
# - `plots`: the folder its plots go to.
# - `seed`: its seed.
function repl_lines(plots: str, seed: u64) -> [str]
    s @= session.new(plots: plots, seed: seed, times: false)
    out: [str] @= ["== the REPL"]

    for line in script.repl_lines()
        out @ out.push("lab> " + line)

        for answer in session.enter(@s, line: line)
            out @ out.push(answer)

    return out

# Runs the demo on the notebook read from the input, its plots written into
# `plots`.
#
# - `plots`: the folder the plots are written to.
#
# Fails where the input cannot be read or is no notebook, with its code.
function run(plots: str) -> ()?
    text = io.read_all_text(io.stdin())?
    nb = cells.parse(text)?
    current @= runs.run_all(nb, plots: plots, times: false)
    print_all(report.full(current))
    print("")
    print_all(read_back_lines(current, plots: plots))

    for edit in script.edits()
        edited = cells.with_source(current.notebook, name: edit.cell, source: edit.source)?
        again = runs.rerun(current, nb: edited)
        print("")
        print_all(report.after_edit(again, edited: edit.cell))
        current @ again.run

    print("")
    print_all(repl_lines(plots: plots, seed: nb.seed))
    return ok()

test "repl_lines: every scripted line after the prompt, the session's answers below"
    lines = repl_lines(plots: "", seed: 1)
    assert lines[0] == "== the REPL"
    assert lines[1] == "lab> 1/3 + 1/4"
    assert lines[2] == "7/12"
