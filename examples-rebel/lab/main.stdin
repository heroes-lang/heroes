# A tour of lab: exact numbers, complex numbers, matrices, statistics,
# random samples and plots. Each cell opens with `%%` and its name; the
# cells run in the order the names they read give, not the file's.
%seed 2026

%% exact
third = 1/3
third + 1/6
2^128 + 1
factor(2^32 + 1)
factor(2^64 + 1)
30!
binomial(60, 30)
digits(1/7, 40)
rat(pi, 1000)
exact(0.1)
sqrt(9/4)
8^(2/3)
2^(1/2)

%% complex
z = 3 + 4i
abs(z)
z^2
conj(z) / z
sqrt(-16)
exp(i * pi)
ln(-1)
asin(2)

%% summary [quiet]
m = mean(xs)
s = sd(xs)
q = quantiles(xs)
[m, s]
q

%% params
n = 400
mu = 10
sigma = 2

%% sample [quiet]
xs = rnorm(n, mu, sigma)
len(xs)
[min(xs), max(xs)]
hist(xs, 20, "a normal sample")

%% ratio
r = n / (mu - 10)

%% scaled
r * 2

%% linear [bench]
A = [4, -2, 1;
     -2, 4, -2;
     1, -2, 4]
det(A)
inv(A)
b = [11, -16, 17]
solve(A, b)
A * solve(A, b) == b
rank([1, 2; 2, 4])
rref([1, 2, 3; 2, 4, 7])
eig([2, 1; 1, 2])
eig([0, -1; 1, 0])
eig(A)
chol(A)
lu(A)[3]
cross([1, 0, 0], [0, 1, 0])
det(rot2(pi / 3))
lstsq([1, 0; 1, 1; 1, 2], [1, 3, 5])

%% fit [quiet]
x = 1:30
noise = rnorm(30, 0, 1)
y = 3 * x + 2 + noise
linreg(x, y)
corr(x, y)
scatter(x, y, "y against x")

%% curves
f(t) = sin(t) * exp(-t / 4)
integrate(f, 0, pi)
findroot(f, 2, 4)
plot(f, 0, 4 * pi, "a damped sine")

%% recursion
fib(k) = if k < 2 then k else fib(k - 1) + fib(k - 2)
map(fib, 1:15)
fib(18)
sum(map(fib, 1:15)) == fib(17) - 1
