# The server's routes, and the one function that answers a request: `web`
# finds the route by method and path, and `answer` calls the endpoint's
# function with the server's state lent by `@`, since a route cannot hold the
# state itself (`web`'s module comment says why). A path no route takes is
# answered 404 and a method no route of the path takes 405 with its `Allow`,
# both by `web.not_routed`. An endpoint that fails unexpectedly, the data file
# unwritable for one, is answered 500 with its message, never a crash.

use <rebel>/http
use <rebel>/web

use api/accounts_api
use api/factors_api
use api/oauth_api
use api/service_api
use server/answers
use server/state

# The routes, each named for the endpoint `answer` calls.
#
# Fails `exists` where two routes clash, which these never do.
function router() -> web.Router?
    rt @= web.new_router()
    web.add(@rt, method: http.METHOD_GET, pattern: "/.well-known/openid-configuration", name: "metadata")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/.well-known/oauth-authorization-server", name: "metadata_rfc8414")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/jwks", name: "jwks")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/accounts", name: "register")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/verify", name: "verify")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/login", name: "login_page")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/login", name: "login")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/logout", name: "logout")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/totp/enrol", name: "totp_enrol")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/totp/confirm", name: "totp_confirm")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/passkeys/register/options", name: "passkey_register_options")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/passkeys/register", name: "passkey_register")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/passkeys/login/options", name: "passkey_login_options")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/passkeys/login", name: "passkey_login")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/authorize", name: "authorize")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/token", name: "token")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/userinfo", name: "userinfo")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/revoke", name: "revoke")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/introspect", name: "introspect")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/service/token", name: "service_token")?
    web.add(@rt, method: http.METHOD_POST, pattern: "/admin/import", name: "import")?
    web.add(@rt, method: http.METHOD_GET, pattern: "/admin/users", name: "users")?
    return ok(rt)

# The answer to `r`, every answer closing its connection: the server serves
# one request at a time, so a client that kept a connection open would hold
# every other client waiting.
#
# - `st`: the server, lent to the endpoint.
# - `rt`: the routes.
# - `r`: the request.
function answer(@st: state.State, rt: web.Router, r: http.Request) -> http.Response
    st.answered @ st.answered + 1

    reply: http.Response? = match web.route(rt, r: r)
        .ok found => endpoint(@st, name: found.name, r: r)
        .err _    => ok(web.not_routed(rt, r: r))

    closed @= match reply
        .ok response => response
        .err e       => answers.oauth_error(500, error: "server_error", description: f"{e.code}: {e.msg}")

    closed.closing @ true
    return closed

# The answer of the endpoint `name` to `r`.
#
# - `st`: the server, lent to the endpoint.
# - `name`: the route's name.
# - `r`: the request.
function endpoint(@st: state.State, name: str, r: http.Request) -> http.Response?
    return match name
        "metadata" | "metadata_rfc8414" => ok(oauth_api.metadata(st))
        "jwks"                          => oauth_api.jwks(st)
        "register"                      => accounts_api.register(@st, r: r)
        "verify"                        => accounts_api.verify(@st, r: r)
        "login_page"                    => ok(accounts_api.login_page(r))
        "login"                         => accounts_api.login(@st, r: r)
        "logout"                        => ok(accounts_api.logout(@st, r: r))
        "totp_enrol"                    => factors_api.totp_enrol(@st, r: r)
        "totp_confirm"                  => factors_api.totp_confirm(@st, r: r)
        "passkey_register_options"      => factors_api.register_options(@st, r: r)
        "passkey_register"              => factors_api.register(@st, r: r)
        "passkey_login_options"         => factors_api.login_options(@st)
        "passkey_login"                 => factors_api.login(@st, r: r)
        "authorize"                     => ok(oauth_api.authorize(@st, r: r))
        "token"                         => ok(oauth_api.token(@st, r: r))
        "userinfo"                      => ok(oauth_api.userinfo(st, r: r))
        "revoke"                        => ok(oauth_api.revoke(@st, r: r))
        "introspect"                    => ok(oauth_api.introspect(st, r: r))
        "service_token"                 => service_api.service_token(@st, r: r)
        "import"                        => service_api.import_now(@st, r: r)
        "users"                         => ok(service_api.list_users(st, r: r))
        _                               => ok(http.respond_status(404))
