# The Heroes library — Tier 2 of design.md §1.11, written in Heroes itself.
#
# This file is compiled with every program. It is not on disk beside the
# compiler: it is `include_str!`d into the binary, so there is no discovery, no
# `$HEROES_LIBRARY`, and no decoy — clang cannot type-check Heroes source, so a
# file here would have no analogue of the runtime's `_Static_assert` guarding it
# (panel 028 R3).
#
# Rules for anything added here:
#   - it declares a name from the built-in inventory and nothing else. A helper
#     outside that table would take a name a user program is entitled to;
#   - it is ordinary Heroes, checked by the ordinary rules. That is the whole
#     claim of Tier 2, and §4.11's label rule is the first place it bites:
#     `range`'s two `int` parameters make its labels mandatory at every call
#     site (panel 028 R1);
#   - a diagnostic raised in this file is a COMPILER BUG, not a user error, and
#     the pipeline reports it as one.

# The integers from `from` up to but not including `to`, in order.
#
# `to` is excluded, matching `slice(from:, to:)` — the labels and the bound
# answer each other, which is why the spec states both on one line.
# An empty range is not an error: `range(from: 3, to: 3)` and
# `range(from: 5, to: 2)` are both `[]`, so a loop over a range that has run out
# runs zero times rather than aborting.
function range(from: int, to: int) -> [int]
    out: [int] @ []
    i: int @ from
    while i < to
        out @ push(out, i)
        i @ i + 1
    return out

# Each element, transformed. `map(xs, f)` — the signature the spec writes out at
# line 93, which is why this one needs no explaining.
function map<A, B>(xs: [A], f: (function(A) -> B)) -> [B]
    out: [B] @ []
    for x in xs
        out @ push(out, f(x))
    return out

# The elements `f` keeps.
function filter<A>(xs: [A], f: (function(A) -> bool)) -> [A]
    out: [A] @ []
    for x in xs
        if f(x)
            out @ push(out, x)
    return out

# The elements combined into one value, FROM THE LEFT, with the accumulator
# passed FIRST — `f(total, x)`, never `f(x, total)`.
#
# Both of those are decisions the spec now states (panel 029 R6) and this body is
# what makes them true. They were undecidable from the spec and the wrong guess
# was SILENT: with an accumulator and an element of the same type — `sum`,
# `concat`, `max`, every string builder — either order type-checks and the program
# prints a different answer.
function fold<A, B>(xs: [A], start: B, f: (function(B, A) -> B)) -> B
    total: B @ start
    for x in xs
        total @ f(total, x)
    return total

# The first element `f` accepts, or an error. `A?` rather than an index, so the
# caller gets the thing rather than a way to look it up again.
function find<A>(xs: [A], f: (function(A) -> bool)) -> A?
    for x in xs
        if f(x)
            return ok(x)
    return fail("not_found", "no element satisfies the test")

# Does any element pass? Empty is false, which is the same rule as `fold` with a
# `false` start.
function any<A>(xs: [A], f: (function(A) -> bool)) -> bool
    for x in xs
        if f(x)
            return true
    return false

# Do all of them? Empty is true — vacuously, and it is the answer that makes
# `all(xs, f) == !any(xs, not_f)` hold at every length.
function all<A>(xs: [A], f: (function(A) -> bool)) -> bool
    for x in xs
        if !f(x)
            return false
    return true

# The program's three edges (§1.11, panel 036). They are HERE, in Heroes, rather
# than in the compiler, and the argument is worth the four lines it takes.
#
# §1.7's test is mechanical: a `T?` is a per-translation-unit generated struct,
# so the C runtime cannot name one and `read_file -> str?` cannot be a runtime
# entry point without a second composition form in the emitter. Written here it
# needs none — `ok` and `fail` are the same constructors every other Tier-2
# function uses.
#
# And the record runs the same way. Pascal predeclared file I/O, command-line
# access and termination; Kernighan's 1981 paper itemises all three as defects;
# Oberon predefines none of them; Nim reaches the same ergonomics from an
# auto-imported module. What crosses to C is only what the language cannot say.

extern "hero_os.h"
    function hero_file_read(path: cstr, @status: int) -> str
    function hero_file_write(path: cstr, text: str) -> int
    function hero_args_count() -> int
    function hero_args_at(index: int) -> str
    function hero_exit(code: int)

# The whole file, or an error. The two codes are stable snake_case strings
# (§4.6), and they are distinguished because a caller almost always wants to:
# "there is no such file" is a different program state from "the disk failed".
function read_file(path: str) -> str?
    status: int @ 0
    text = hero_file_read(path.cstr(), @status)
    if status == 0
        return ok(text)
    if status == 1
        return fail("file_not_found", "no file at " + path)
    return fail("read_failed", "could not read " + path)

# The text, written whole, replacing whatever was there.
function write_file(path: str, text: str) -> ()?
    if hero_file_write(path.cstr(), text) == 0
        return ok()
    return fail("write_failed", "could not write " + path)

# The arguments after the program's name — the off-by-one every language's first
# CLI program gets wrong, answered in the runtime and stated in the spec.
function args() -> [str]
    out: [str] @ []
    i: int @ 0
    while i < hero_args_count()
        out @ push(out, hero_args_at(i))
        i @ i + 1
    return out

# Ends the program with this status. It never returns, and the C function it
# calls says so with `_Noreturn` — which is what keeps clang's flow analysis from
# treating the code after it as reachable.
function exit(code: int)
    hero_exit(code)
