# The generator of `html`'s table of named character references,
# `html/internal/entities.hero`: every name of the HTML Standard's
# `entities.json` and the one or two code points it stands for, written byte
# for byte, or checked against the table in the tree.
#
# Its input is `entities.json`, kept unchanged in `whatwg/` beside this file
# as html.spec.whatwg.org served it on `FETCHED`: the standard serves only its
# latest version, under the same name, so a copy kept here is what lets the
# table be made again. The HTML Standard is © WHATWG (Apple, Google, Mozilla,
# Microsoft), under the Creative Commons Attribution 4.0 International License
# (https://creativecommons.org/licenses/by/4.0/), which lets the file be
# copied with that notice.
#
# Run from the repository's root:
#
#     heroes run rebel/generators/html_entities/main.hero -- write
#     heroes run rebel/generators/html_entities/main.hero -- check
#
# `write` writes the table. `check` reads it and exits 0 where it is exactly
# what `write` would write, and 1 where it is not, naming its first line that
# differs. Either exits 2 where its words are not these, or where the file
# is not what the standard says it is.

use <rebel>/bytes
use <rebel>/json
use <rebel>/strings
use <rebel>/unicode
use <tablekit>/tablekit

# The standard's file, from the repository's root.
constant SOURCE: str
    "rebel/generators/html_entities/whatwg/entities.json"

# The day the file was read from html.spec.whatwg.org/entities.json.
constant FETCHED: str
    "2026-11-22"

# The table, from the repository's root.
constant TABLE: str
    tablekit.SOURCE + "/html/internal/entities.hero"

# One reference: its name, `&` left off, and its characters packed.
record Reference
    name: str
    points: i64

# Every reference of `text`, the whole of `entities.json`, in the order of
# their names' bytes: each name with its `&` left off, and its code points
# as `first << 21 | second`, `second` 0 where it has one.
#
# - `text`: the file's text.
#
# Fails as reading its JSON fails, and `invalid` where a name does not open
# with `&`, a reference has no code point or more than two, or its
# `characters` are not its code points.
function read_references(text: str) -> [Reference]?
    by_name: {str: i64} @= {}

    for pair in sorted_members(json.parse(text)?)?
        name = pair.name

        if !strings.has_prefix(s: name, prefix: "&")
            return fail(code: "invalid", msg: f"the name \"{name}\" does not open with &")
        points: [i64] @= []

        for item in json.items_of(json.member(pair.value, key: "codepoints")?)?
            points @ points.push(json.int_of(item)?)

        if points.len() < 1 || points.len() > 2
            return fail(code: "invalid", msg: f"{name} stands for {points.len()} code points")
        written @= ""

        for point in points
            written @ written + unicode.from_code_point(point)?

        if written != json.text_of(json.member(pair.value, key: "characters")?)?
            return fail(code: "invalid", msg: f"{name}'s characters are not its code points")

        second = if points.len() == 2
            points[1]
        else
            0
        by_name[strings.trim_prefix(s: name, prefix: "&")] @ points[0] << 21 | second

    out: [Reference] @= []

    for name in sort(keys(by_name))
        out @ out.push(Reference(name: name, points: by_name[name].must()))

    return ok(out)

# A member of an object: its key and its value.
record Member
    name: str
    value: json.Value

# The members of the object `v`.
#
# Fails `invalid` where `v` is not an object.
function sorted_members(v: json.Value) -> [Member]?
    members = json.members_of(v)?
    out: [Member] @= []

    for name in keys(members)
        out @ out.push(Member(name: name, value: members[name].must()))

    return ok(out)

# The whole text of the table for `references`.
#
# - `references`: every reference, in the order of their names' bytes.
# - `digest`: the SHA-256 of `entities.json`, in lowercase hexadecimal.
#
# Fails as writing a literal fails.
function module_text(references: [Reference] lent, digest: str) -> str?
    names: [str] @= []
    points: [i64] @= []

    for one in references
        names @ names.push(one.name)
        points @ points.push(one.points)

    head = [
        f"# The named character references of the HTML Living Standard, {thousands(references.len())} names,"
        "# each to the one or two code points it stands for. `refs.hero` reads them."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `rebel/generators/html_entities/` read the standard's `entities.json`, kept"
        f"# in its folder `whatwg/` as html.spec.whatwg.org served it on {FETCHED}"
        f"# (SHA-256 {digest}),"
        "# sorted its names by their bytes and wrote this module whole; its `check`"
        "# command says whether this module is still what it writes."
        "#"
        "# `NAMES[i]` is written as the table writes it, `&` left off: `amp;`, and the"
        "# old `amp` that the standard reads without its `;`. `POINTS[i]` holds its"
        "# characters as `first << 21 | second`, `second` 0 where there is one."
    ]
    parts = [
        head.join("\n")
        tablekit.strings_constant(comment: ["# Every name, in the order of its bytes."], name: "NAMES", items: names)?
        tablekit.numbers_constant(comment: ["# The characters of `NAMES[i]`, `first << 21 | second`."], name: "POINTS", items: points)
    ]
    return ok(parts.join("\n\n") + "\n")

# `n` in decimal with a comma between each group of three digits.
function thousands(n: i64) -> str
    digits = to_str(n)
    out: [str] @= []
    at @= 0

    while at < digits.len()
        if at > 0 && (digits.len() - at) % 3 == 0
            out @ out.push(",")
        out @ out.push(digits.slice(from: at, to: at + 1))
        at @ at + 1

    return out.join("")

# Does what `command` asks with the table, and answers the code it reached.
#
# Fails as reading the file, reading its references and writing or reading
# the table fail.
function run(command: str) -> i64?
    text = read_file(SOURCE)?
    data = bytes.from_text(text)
    return tablekit.settle(
        command: command,
        path: TABLE,
        text: module_text(read_references(text)?, digest: tablekit.sha256_hex(data))?
    )

function main()
    words = tablekit.command_words("html_entities")

    if words.len() != 1 || words[0] != "write" && words[0] != "check"
        print("usage, from the repository's root: heroes run rebel/generators/html_entities/main.hero -- write|check")
        exit(code: 2)

    match run(words[0])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "read_references: sorted by their bytes, one code point and two, and a name with no `&`"
    text = "{\"&amp;\": {\"codepoints\": [38], \"characters\": \"&\"}, \"&AMP\": {\"codepoints\": [38], \"characters\": \"&\"}, \"&NotEqualTilde;\": {\"codepoints\": [8770, 824], \"characters\": \"\\u2242\\u0338\"}}"
    references = read_references(text).must()
    assert references.len() == 3
    assert references[0] == Reference(name: "AMP", points: 38 << 21)
    assert references[1] == Reference(name: "NotEqualTilde;", points: 8770 << 21 | 824)
    assert references[2].name == "amp;"
    assert read_references("{\"amp;\": {\"codepoints\": [38], \"characters\": \"&\"}}").is_err()
    assert read_references("{\"&x;\": {\"codepoints\": [], \"characters\": \"\"}}").is_err()
    assert read_references("{\"&x;\": {\"codepoints\": [38], \"characters\": \"y\"}}").is_err()

test "thousands: below a thousand, at it, and past a million"
    assert thousands(999) == "999" && thousands(2231) == "2,231" && thousands(1234567) == "1,234,567"
