# The generator of `html`'s tables of tree construction,
# `html/internal/tables.hero`: the doctypes that set quirks and
# limited-quirks mode (13.2.6.4.1), the SVG attribute names written in mixed
# case (13.2.6.1) and the SVG element names written in mixed case
# (13.2.6.5), each written byte for byte, or checked against the table in
# the tree.
#
# Its input is the HTML Standard's source, the file `source` of its
# repository at the commit `COMMIT`, which `SOURCE_URL` serves for ever,
# fetched into any folder and held to `SOURCE_SHA256`. The standard is
# © WHATWG (Apple, Google, Mozilla, Microsoft), under the Creative Commons
# Attribution 4.0 International License. Run from the repository's root:
#
#     heroes run rebel/generators/html_tables/main.hero -- write <source>
#     heroes run rebel/generators/html_tables/main.hero -- check <source>
#
# `write` writes the table. `check` reads it and exits 0 where it is exactly
# what `write` would write, and 1 where it is not, naming its first line that
# differs. Either exits 2 where its words are not these, where the file's
# digest is not the pinned one, or where a list or a table is not in the
# shape this program reads, so a change to the standard is read by a person
# before it reaches the table.

use <rebel>/strings
use <tablekit>/tablekit

# The commit of github.com/whatwg/html the source is read at, the last of
# the day the table was first made.
constant COMMIT: str
    "efcc0bcdec596651e2cb316ab076c0bdc7c4d120"

# Where the source is served at `COMMIT`.
constant SOURCE_URL: str
    "https://raw.githubusercontent.com/whatwg/html/efcc0bcdec596651e2cb316ab076c0bdc7c4d120/source"

# The SHA-256 of the bytes `SOURCE_URL` served, in lowercase hexadecimal.
constant SOURCE_SHA256: str
    "3ce0e875a92394f6d3194373a45a291ef43ac9764eb161538227fc6689731d13"

# The table, from the repository's root.
constant TABLE: str
    tablekit.SOURCE + "/html/internal/tables.hero"

# What a code element of the source opens and closes with.
constant CODE_OPEN: str
    "<code data-x=\"\">"

constant CODE_CLOSE: str
    "</code>"

# The doctype lists of the initial insertion mode and the two tables of
# names in mixed case, as the standard gives them.
record Tables
    quirks_public: [str]
    quirks_public_prefixes: [str]
    quirks_system: [str]
    frameset_prefixes: [str]
    limited_public_prefixes: [str]
    svg_attributes_lower: [str]
    svg_attributes: [str]
    svg_elements_lower: [str]
    svg_elements: [str]

# The place of the first line at or after `from` that holds `marker`.
#
# Fails `invalid` where no line does.
function line_holding(lines: [str] lent, marker: str, from: i64) -> i64?
    at @= from

    while at < lines.len()
        if strings.contains(s: lines[at], substr: marker)
            return ok(at)
        at @ at + 1

    return fail(code: "invalid", msg: f"the source holds no line with {marker} after line {from + 1}")

# The text of the first code element of `line` after `from`, and where it
# closes.
record Code
    text: str
    end: i64

# The first `<code data-x="">` element of `line` at or after `from`.
#
# Fails `invalid` where there is none, or where its text holds a `<` or an
# `&`, which would be markup or a reference rather than the text itself.
function code_of(line: str, from: i64) -> Code?
    open = strings.index_of_from(s: line, substr: CODE_OPEN, from: from)?
    start = open + CODE_OPEN.len()
    close = strings.index_of_from(s: line, substr: CODE_CLOSE, from: start)?
    text = line.slice(from: start, to: close)

    if strings.contains_any(s: text, set: "<&")
        return fail(code: "invalid", msg: f"the code element \"{text}\" holds markup or a reference")
    return ok(Code(text: text, end: close + CODE_CLOSE.len()))

# The items of the `<ul class="brief">` list that opens at or after `from`,
# each trimmed, and the place of the line that closes it.
record Items
    texts: [str]
    end: i64

# The `<li>` items of the first brief list at or after `from`.
#
# Fails `invalid` where there is no such list, or where a line inside it is
# not one whole item.
function brief_list(lines: [str] lent, from: i64) -> Items?
    at @= line_holding(lines, marker: "<ul class=\"brief\">", from: from)? + 1
    out: [str] @= []

    while at < lines.len()
        line = strings.trim(lines[at])

        if line == "</ul>"
            return ok(Items(texts: out, end: at))

        if !strings.has_prefix(s: line, prefix: "<li> ") || !strings.has_suffix(s: line, suffix: " </li>")
            return fail(code: "invalid", msg: f"line {at + 1} of a doctype list is not one item: {line}")
        out @ out.push(strings.trim_suffix(s: strings.trim_prefix(s: line, prefix: "<li> "), suffix: " </li>"))
        at @ at + 1

    return fail(code: "invalid", msg: "a doctype list of the source is never closed")

# The identifier `item` names after its `lead`, or the empty text where it
# opens with another.
#
# Fails as `code_of` fails, and `invalid` where the item holds more after
# its identifier than the closing quotation mark.
function after_lead(item: str, lead: str) -> str?
    if !strings.has_prefix(s: item, prefix: lead + "\"" + CODE_OPEN)
        return ok("")
    code = code_of(item, from: lead.len())?

    if item.slice(from: code.end, to: item.len()) != "\""
        return fail(code: "invalid", msg: f"an item says more after its identifier: {item}")
    return ok(code.text)

# The leads of the quirks list's items that name an identifier.
constant PUBLIC_IS: str
    "The public identifier is set to: "

constant PUBLIC_STARTS: str
    "The public identifier starts with: "

constant SYSTEM_IS: str
    "The system identifier is set to: "

constant FRAMESET_QUIRKS: str
    "The system identifier is missing or the empty string, and the public identifier starts with: "

constant FRAMESET_LIMITED: str
    "The system identifier is neither missing nor the empty string, and the public identifier starts with: "

# The two items of the quirks list that name no identifier, which the parser
# reads by its own code.
constant QUIRKS_RULES: [str]
    [
        "The <i data-x=\"force-quirks flag\">force-quirks flag</i> is set to <i>on</i>."
        "The name is not \"<code data-x=\"\">html</code>\"."
    ]

# Whether `list` holds `item`.
function holds(list: [str] lent, item: str) -> bool
    for one in list
        if one == item
            return true

    return false

# The six lists of the doctypes, read from the quirks and the
# limited-quirks lists of the initial insertion mode.
#
# Fails `invalid` where an item is none of the kinds this program reads, or
# where the limited-quirks list's frameset prefixes are not the quirks
# list's.
function read_doctypes(lines: [str] lent, into: Tables) -> Tables?
    start = line_holding(lines, marker: "<p id=\"quirks-mode-doctypes\">", from: 0)?
    quirks = brief_list(lines, from: start)?
    out @= into

    for item in quirks.texts
        exactly = after_lead(item: item, lead: PUBLIC_IS)?
        starts = after_lead(item: item, lead: PUBLIC_STARTS)?
        system = after_lead(item: item, lead: SYSTEM_IS)?
        frameset = after_lead(item: item, lead: FRAMESET_QUIRKS)?

        if exactly != ""
            out.quirks_public @ out.quirks_public.push(exactly)
        else if starts != ""
            out.quirks_public_prefixes @ out.quirks_public_prefixes.push(starts)
        else if system != ""
            out.quirks_system @ out.quirks_system.push(system)
        else if frameset != ""
            out.frameset_prefixes @ out.frameset_prefixes.push(frameset)
        else if !holds(QUIRKS_RULES, item: item)
            return fail(code: "invalid", msg: f"the quirks list holds an item this program does not read: {item}")

    limited = brief_list(lines, from: quirks.end)?
    framesets: [str] @= []

    for item in limited.texts
        starts = after_lead(item: item, lead: PUBLIC_STARTS)?
        frameset = after_lead(item: item, lead: FRAMESET_LIMITED)?

        if starts != ""
            out.limited_public_prefixes @ out.limited_public_prefixes.push(starts)
        else if frameset != ""
            framesets @ framesets.push(frameset)
        else
            return fail(
                code: "invalid",
                msg: f"the limited-quirks list holds an item this program does not read: {item}"
            )

    if framesets != out.frameset_prefixes
        return fail(code: "invalid", msg: "the limited-quirks list's frameset prefixes are not the quirks list's")
    return ok(out)

# The two columns of the first table at or after `from`: each row's name on
# the token, in lower case, and its name on the element. A row inside an
# HTML comment, which the standard keeps as a note, is not read.
record Columns
    lower: [str]
    mixed: [str]

# The rows of the table that opens at or after `from`.
#
# Fails `invalid` where a line of its body is not one row of two code
# elements, or where a row's first name is not its second in lower case.
function name_table(lines: [str] lent, from: i64) -> Columns?
    at @= line_holding(lines, marker: "<tbody>", from: from)? + 1
    out @= Columns(lower: [], mixed: [])

    while at < lines.len()
        line = strings.trim(lines[at])

        if line == "</table>"
            return ok(out)

        if !strings.has_prefix(s: line, prefix: "<!--")
            if !strings.has_prefix(s: line, prefix: "<tr> <td> " + CODE_OPEN)
                return fail(code: "invalid", msg: f"line {at + 1} of a table is not one row: {line}")
            first = code_of(line, from: 0)?
            second = code_of(line, from: first.end)?

            if line.slice(from: second.end, to: line.len()) != "" || strings.to_lower(second.text) != first.text
                return fail(
                    code: "invalid",
                    msg: f"line {at + 1} is not a name in lower case beside the same in mixed case: {line}"
                )
            out.lower @ out.lower.push(first.text)
            out.mixed @ out.mixed.push(second.text)
        at @ at + 1

    return fail(code: "invalid", msg: "a table of the source is never closed")

# Every list and table of `text`, the standard's whole source.
#
# Fails as `read_doctypes` and `name_table` fail.
function read_tables(text: str) -> Tables?
    lines = strings.split(s: text, sep: "\n")
    empty = Tables(
        quirks_public: [],
        quirks_public_prefixes: [],
        quirks_system: [],
        frameset_prefixes: [],
        limited_public_prefixes: [],
        svg_attributes_lower: [],
        svg_attributes: [],
        svg_elements_lower: [],
        svg_elements: []
    )
    out @= read_doctypes(lines, into: empty)?
    attributes = name_table(lines, from: line_holding(lines, marker: "<dfn>adjust SVG attributes</dfn>", from: 0)?)?
    elements = name_table(lines, from: line_holding(lines, marker: "SVG elements that are not all lowercase.)</p>", from: 0)?)?
    out.svg_attributes_lower @ attributes.lower
    out.svg_attributes @ attributes.mixed
    out.svg_elements_lower @ elements.lower
    out.svg_elements @ elements.mixed
    return ok(out)

# The whole text of the table.
#
# - `tables`: what the source gives.
#
# Fails as writing a literal fails.
function module_text(tables: Tables lent) -> str?
    head = [
        "# Tables of the standard's tree construction, as its text gives them: the"
        "# doctypes that set quirks and limited-quirks mode (13.2.6.4.1), the SVG"
        "# attribute names written in mixed case (13.2.6.1) and the SVG element names"
        "# written in mixed case (13.2.6.5)."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `rebel/generators/html_tables/` read them from the standard's source, the file"
        "# `source` of github.com/whatwg/html at commit"
        f"# {COMMIT}"
        f"# (SHA-256 {SOURCE_SHA256}),"
        "# and wrote this module whole; its `check` command says whether this module"
        "# is still what it writes. Every public and system identifier is compared"
        "# in any ASCII case."
    ]
    parts = [
        head.join("\n")
        tablekit.strings_constant(comment: ["# The public identifiers that set quirks mode, exactly."], name: "QUIRKS_PUBLIC", items: tables.quirks_public)?
        tablekit.strings_constant(comment: ["# The beginnings of public identifiers that set quirks mode."], name: "QUIRKS_PUBLIC_PREFIXES", items: tables.quirks_public_prefixes)?
        tablekit.strings_constant(comment: ["# The system identifiers that set quirks mode, exactly."], name: "QUIRKS_SYSTEM", items: tables.quirks_system)?
        tablekit.strings_constant(comment: ["# The beginnings of public identifiers that set quirks mode with no system", "# identifier, and limited-quirks mode with one."], name: "FRAMESET_PREFIXES", items: tables.frameset_prefixes)?
        tablekit.strings_constant(comment: ["# The beginnings of public identifiers that set limited-quirks mode."], name: "LIMITED_PUBLIC_PREFIXES", items: tables.limited_public_prefixes)?
        tablekit.strings_constant(comment: ["# The SVG attribute names as the tokenizer writes them, in lower case."], name: "SVG_ATTRIBUTES_LOWER", items: tables.svg_attributes_lower)?
        tablekit.strings_constant(comment: ["# The same names, beside, as an SVG element holds them."], name: "SVG_ATTRIBUTES", items: tables.svg_attributes)?
        tablekit.strings_constant(comment: ["# The SVG element names as the tokenizer writes them, in lower case."], name: "SVG_ELEMENTS_LOWER", items: tables.svg_elements_lower)?
        tablekit.strings_constant(comment: ["# The same names, beside, as an SVG element is named."], name: "SVG_ELEMENTS", items: tables.svg_elements)?
    ]
    return ok(parts.join("\n\n") + "\n")

# Does what `command` asks with the table, and answers the code it reached.
#
# - `command`: `write` or `check`.
# - `path`: the source.
#
# Fails as reading the source, reading its tables and writing or reading the
# table fail.
function run(command: str, path: str) -> i64?
    text = tablekit.pinned_text(path: path, sha256: SOURCE_SHA256)?
    return tablekit.settle(command: command, path: TABLE, text: module_text(read_tables(text)?)?)

function main()
    words = tablekit.command_words("html_tables")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run rebel/generators/html_tables/main.hero -- write|check <source of ",
            SOURCE_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], path: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "brief_list and read_doctypes: each kind of item, the two rules read by code, and an item of no kind refused"
    lines = [
        "<p id=\"quirks-mode-doctypes\">"
        "<ul class=\"brief\">"
        " <li> The <i data-x=\"force-quirks flag\">force-quirks flag</i> is set to <i>on</i>. </li>"
        " <li> The name is not \"<code data-x=\"\">html</code>\". </li>"
        " <li> The public identifier is set to: \"<code data-x=\"\">HTML</code>\" </li>"
        " <li> The system identifier is set to: \"<code data-x=\"\">s.dtd</code>\" </li>"
        " <li> The public identifier starts with: \"<code data-x=\"\">-//A//</code>\" </li>"
        " <li> The system identifier is missing or the empty string, and the public identifier starts with: \"<code data-x=\"\">-//F//</code>\" </li>"
        "</ul>"
        "<ul class=\"brief\">"
        " <li> The public identifier starts with: \"<code data-x=\"\">-//L//</code>\" </li>"
        " <li> The system identifier is neither missing nor the empty string, and the public identifier starts with: \"<code data-x=\"\">-//F//</code>\" </li>"
        "</ul>"
    ]
    empty = Tables(
        quirks_public: [],
        quirks_public_prefixes: [],
        quirks_system: [],
        frameset_prefixes: [],
        limited_public_prefixes: [],
        svg_attributes_lower: [],
        svg_attributes: [],
        svg_elements_lower: [],
        svg_elements: []
    )
    read = read_doctypes(lines, into: empty).must()
    assert read.quirks_public == ["HTML"] && read.quirks_system == ["s.dtd"] && read.quirks_public_prefixes == ["-//A//"]
    assert read.frameset_prefixes == ["-//F//"] && read.limited_public_prefixes == ["-//L//"]
    strange: [str] @= lines
    strange[2] @ " <li> The public identifier ends with: \"<code data-x=\"\">x</code>\" </li>"
    assert read_doctypes(strange, into: empty).is_err()
    unlike: [str] @= lines
    unlike[11] @ " <li> The system identifier is neither missing nor the empty string, and the public identifier starts with: \"<code data-x=\"\">-//G//</code>\" </li>"
    assert read_doctypes(unlike, into: empty).is_err()

test "name_table: rows in order, a row in a comment left, and a row whose names differ refused"
    lines = [
        "<dfn>adjust SVG attributes</dfn>"
        "<table>"
        " <tbody>"
        "  <tr> <td> <code data-x=\"\">viewbox</code> <td> <code data-x=\"\">viewBox</code>"
        "  <!--<tr> <td> <code data-x=\"\">solidcolor</code> <td> <code data-x=\"\">solidColor</code> (SVG 1.2)-->"
        "  <tr> <td> <code data-x=\"\">textpath</code> <td> <code data-x=\"\">textPath</code>"
        " </table>"
    ]
    read = name_table(lines, from: 0).must()
    assert read.lower == ["viewbox", "textpath"] && read.mixed == ["viewBox", "textPath"]
    wrong: [str] @= lines
    wrong[3] @ "  <tr> <td> <code data-x=\"\">viewbox</code> <td> <code data-x=\"\">viewPort</code>"
    assert name_table(wrong, from: 0).is_err()

test "code_of: the text of an element, and one holding a reference refused"
    assert code_of("a \"<code data-x=\"\">-//W3C//</code>\"", from: 0).must().text == "-//W3C//"
    assert code_of("<code data-x=\"\">a&amp;b</code>", from: 0).is_err()
