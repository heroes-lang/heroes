# The generator of Rebel's conformance cases of Unicode 17.0.0: the break
# tests of UAX #29 and UAX #14 that `unicode/segment` runs (`grapheme_cases`,
# `word_cases`, `sentence_cases`, and `line_cases` with `line_cases_more`,
# which share one file between them), and the normalization test of UAX #15
# that `unicode/normalize` runs (`normalization_cases`), each written byte
# for byte, or checked against the module in the tree.
#
# Its input is five files of the Unicode Character Database 17.0.0, which
# the Unicode Consortium serves under a folder named for the version and
# never changes, fetched into one folder under the names they are served by
# and each held to its SHA-256 below. Run from the repository's root:
#
#     heroes run rebel/generators/unicode_cases/main.hero -- write <folder>
#     heroes run rebel/generators/unicode_cases/main.hero -- check <folder>
#
# `write` writes the modules. `check` reads them and exits 0 where each is
# exactly what `write` would write, and 1 where one is not, naming its first
# line that differs. Either exits 2 where its words are not these, where a
# file's digest is not the pinned one, or where a line of a file is not what
# its header says the file holds.

use <tablekit>/tablekit

use cases

# Where the break tests are served, and where the normalization test is.
constant AUXILIARY_URL: str
    "https://www.unicode.org/Public/17.0.0/ucd/auxiliary/"

constant UCD_URL: str
    "https://www.unicode.org/Public/17.0.0/ucd/"

# The day the files were read for the digests below.
constant FETCHED: str
    "2026-11-22"

# The folder of `unicode/segment`'s cases, and of `unicode/normalize`'s,
# from the repository's root.
constant SEGMENT: str
    tablekit.SOURCE + "/unicode/segment/internal/"

constant NORMALIZE: str
    tablekit.SOURCE + "/unicode/normalize/internal/"

# How many cases `LineBreakTest.txt` holds, and the last that `line_cases`
# runs: `line_cases_more` runs the rest.
constant LINE_CASES: i64
    19338

constant LINE_HALF: i64
    9669

# A file of the input: its name and the SHA-256 it is pinned to.
record Source
    name: str
    sha256: str

function grapheme_source() -> Source
    return Source(
        name: "GraphemeBreakTest.txt",
        sha256: "e2d134d2c52919bace503ebb6a551c1855fe1a1faec18478c78fff254a1793ec"
    )

function word_source() -> Source
    return Source(name: "WordBreakTest.txt", sha256: "1de23a75f37904abc7d206239ee8d34f8fdf0fb4ab32a7174dfbabbde25419b2")

function sentence_source() -> Source
    return Source(
        name: "SentenceBreakTest.txt",
        sha256: "12cb47d028ded0c1cb8a28558f95479cbcd24559c46977015c82f3b50a1cc6e4"
    )

function line_source() -> Source
    return Source(name: "LineBreakTest.txt", sha256: "e69884e0dde6a8724873f885d68c52dc14518abf9ae4ca9e2283b8773db3b752")

function normalization_source() -> Source
    return Source(
        name: "NormalizationTest.txt",
        sha256: "5019ffd530751a741900c849c0e010332f142a3612234639bd200b82138a87db"
    )

# The header's lines that say which program wrote a module.
function generated_lines() -> [str]
    return [
        "# Generated, never edited by hand: the Heroes program"
        f"# `rebel/generators/unicode_cases/` read the file, fetched {FETCHED}, and wrote"
        "# this module whole; its `check` command says whether this module is still"
        "# what it writes. Only a test build reads the cases."
    ]

# The first lines of a break test module's header, which say what it holds.
#
# - `what`: what the cases are of: `UAX #29's graphemes`.
# - `through`: the function that runs them: `graphemes`.
# - `lines`: which lines of the file it runs: `every line`.
# - `source`: the file.
function break_intro(what: str, through: str, lines: str, source: Source) -> [str]
    return [
        f"# The conformance cases of {what} for Unicode 17.0.0, run through `{through}`:"
        f"# {lines} of `{source.name}` of {AUXILIARY_URL}"
        f"# (SHA-256 {source.sha256.slice(from: 0, to: 16)}), each the code points of a text in hexadecimal between marks,"
        "# `x` where the file allows no break and `/` where it writes one; the marks"
        "# the file writes at the start and the end are left out, being the same on"
        "# every line."
    ]

# The module of break test cases named `name`, running cases `first` to
# `last` of `source`, by `kind`.
function break_spec(name: str, intro: [str], source: Source, kind: str, first: i64, last: i64) -> cases.Spec
    return cases.Spec(
        path: SEGMENT + name + ".hero",
        name: name,
        intro: intro,
        runner: "use unicode/segment/internal/conform",
        file: source.name.slice(from: 0, to: source.name.len() - 4),
        kind: f", kind: conform.{kind}",
        first: first,
        last: last
    )

# The cases of `source` in `folder`, read as a break test.
#
# Fails as `tablekit.pinned_text` and `cases.break_cases` fail.
function break_cases_of(folder: str, source: Source) -> [str]?
    return cases.break_cases(tablekit.pinned_text(path: folder + "/" + source.name, sha256: source.sha256)?)

# Writes or checks the module `spec` names from `every`, its file's cases.
#
# Fails as `cases.module_text` and `tablekit.settle` fail.
function settle(command: str, spec: cases.Spec lent, every: [str] lent) -> i64?
    return tablekit.settle(
        command: command,
        path: spec.path,
        text: cases.module_text(spec, cases: every, generated: generated_lines())?
    )

# Does what `command` asks with every module, reading the files in
# `folder`, and answers the worst code it reached.
#
# - `command`: `write` or `check`.
# - `folder`: the folder holding the five files.
#
# Fails as reading a file and writing or reading a module fail, and
# `invalid` where `LineBreakTest.txt` does not hold `LINE_CASES` cases.
function run(command: str, folder: str) -> i64?
    grapheme = grapheme_source()
    word = word_source()
    sentence = sentence_source()
    line = line_source()
    normalization = normalization_source()
    graphemes = break_cases_of(folder, source: grapheme)?
    words = break_cases_of(folder, source: word)?
    sentences = break_cases_of(folder, source: sentence)?
    lines = break_cases_of(folder, source: line)?

    if lines.len() != LINE_CASES
        return fail(
            code: "invalid",
            msg: f"{line.name} holds {lines.len()} cases, and `line_cases` and `line_cases_more` split {LINE_CASES}"
        )
    code @= settle(command, spec: break_spec(name: "grapheme_cases", intro: break_intro(what: "UAX #29's graphemes", through: "graphemes", lines: "every line", source: grapheme), source: grapheme, kind: "GRAPHEMES", first: 1, last: graphemes.len()), every: graphemes)?
    code @ tablekit.worst(
        a: code,
        b: settle(command, spec: break_spec(name: "word_cases", intro: break_intro(what: "UAX #29's words", through: "words", lines: "every line", source: word), source: word, kind: "WORDS", first: 1, last: words.len()), every: words)?
    )
    code @ tablekit.worst(
        a: code,
        b: settle(command, spec: break_spec(name: "sentence_cases", intro: break_intro(what: "UAX #29's sentences", through: "sentences", lines: "every line", source: sentence), source: sentence, kind: "SENTENCES", first: 1, last: sentences.len()), every: sentences)?
    )
    code @ tablekit.worst(
        a: code,
        b: settle(command, spec: break_spec(name: "line_cases", intro: break_intro(what: "UAX #14", through: "lines", lines: f"lines 1 to {LINE_HALF} of the {LINE_CASES}", source: line), source: line, kind: "LINES", first: 1, last: LINE_HALF), every: lines)?
    )
    code @ tablekit.worst(
        a: code,
        b: settle(command, spec: break_spec(name: "line_cases_more", intro: break_intro(what: "UAX #14", through: "lines", lines: f"lines {LINE_HALF + 1} to {LINE_CASES} of the {LINE_CASES}", source: line), source: line, kind: "LINES", first: LINE_HALF + 1, last: LINE_CASES), every: lines)?
    )
    normal = cases.normalization_cases(tablekit.pinned_text(path: folder + "/" + normalization.name, sha256: normalization.sha256)?)?
    spec = cases.Spec(
        path: NORMALIZE + "normalization_cases.hero",
        name: "normalization_cases",
        intro: ["# The conformance cases of UAX #15 for Unicode 17.0.0, run through", f"# `forms`: every line of `{normalization.name}` of", f"# {UCD_URL} (SHA-256 {normalization.sha256.slice(from: 0, to: 16)}), each", "# five columns of code points in hexadecimal as the file writes them, held", "# to the file's own five invariants: c2 is NFC of c1, c2 and c3; c3 is NFD", "# of c1, c2 and c3; c4 is NFKC of all five; c5 is NFKD of all five; and", "# each form is in its form by `forms.is_normalized`."],
        runner: "use unicode/normalize/internal/conform",
        file: "NormalizationTest",
        kind: "",
        first: 1,
        last: normal.len()
    )
    return ok(tablekit.worst(a: code, b: settle(command, spec: spec, every: normal)?))

function main()
    words = tablekit.command_words("unicode_cases")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run rebel/generators/unicode_cases/main.hero -- write|check <folder of the files of ",
            AUXILIARY_URL,
            " and ",
            UCD_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], folder: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)
