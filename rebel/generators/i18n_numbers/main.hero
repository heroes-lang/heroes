# The generator of `i18n/numbers`' table of CLDR 49's number data,
# `i18n/numbers/internal/number_tables.hero`, written byte for byte, or
# checked against the table in the tree.
#
# Its input is CLDR 49's JSON release, fetched from `cldrkit.SOURCE_URL` into
# any folder; `cldrkit` holds it to its SHA-256. Run from the repository's
# root:
#
#     heroes run rebel/generators/i18n_numbers/main.hero -- write <zip>
#     heroes run rebel/generators/i18n_numbers/main.hero -- check <zip>
#
# `write` writes the table. `check` reads it and exits 0 where it is exactly
# what `write` would write, and 1 where it is not, naming its first line
# that differs. Either exits 2 where its words are not these, where the zip's
# digest is not the pinned one, or where its data is not what the generator
# reads.

use <cldrkit>/cldrkit
use <rebel>/json
use <tablekit>/tablekit

use blocks
use numbers

# The table, from the repository's root.
constant TABLE: str
    tablekit.SOURCE + "/i18n/numbers/internal/number_tables.hero"

# Every locale of CLDR's full set, in the order of their bytes.
#
# Fails as reading `availableLocales.json` fails.
function locale_tags(release: cldrkit.Release lent) -> [str]?
    tags: [str] @= []

    for item in json.items_of(cldrkit.member_at(release, name: "cldr-core/availableLocales.json", path: ["availableLocales", "full"])?)?
        tags @ tags.push(json.text_of(item)?)

    return ok(sort(tags))

# The numbering systems of `numberingSystems.json` with ten digits, each its
# name and its digits, in the order of their names' bytes.
#
# Fails as reading the file fails.
function digit_systems(release: cldrkit.Release lent) -> [str]?
    systems = cldrkit.member_at(release, name: "cldr-core/supplemental/numberingSystems.json", path: ["supplemental", "numberingSystems"])?
    digits: {str: str} @= {}

    for one in cldrkit.entries(systems)?
        if numbers.text_or_empty(one.value, key: "_type")? == "numeric"
            digits[one.key] @ json.text_of(json.member(one.value, key: "_digits")?)?

    out: [str] @= []

    for name in sort(keys(digits))
        out @ out.push(name)
        out @ out.push(digits[name].must())

    return ok(out)

# The keys of `pairs`, a list of key, value, key, value.
function evens(pairs: [str] lent) -> [str]
    out: [str] @= []
    at @= 0

    while at < pairs.len()
        out @ out.push(pairs[at])
        at @ at + 2

    return out

# The values of `pairs`, every second element from the second.
function odds(pairs: [str] lent) -> [str]
    out: [str] @= []
    at @= 1

    while at < pairs.len()
        out @ out.push(pairs[at])
        at @ at + 2

    return out

# The currency data the table holds: the currencies whose amounts are not
# written with two digits, with their digits, and each region's currency in
# use, the first of its entries, in the order CLDR writes them, that names no
# end and is not marked not tender.
record CurrencyData
    digit_codes: [str]
    digit_counts: [i64]
    region_codes: [str]
    region_currencies: [str]

# The currency data of `currencyData.json`.
#
# Fails as reading the file fails, and `invalid` where a count of digits is
# not a number.
function currency_data(release: cldrkit.Release lent) -> CurrencyData?
    data = cldrkit.member_at(release, name: "cldr-core/supplemental/currencyData.json", path: ["supplemental", "currencyData"])?
    digits: {str: i64} @= {}

    for one in cldrkit.entries(json.member(data, key: "fractions")?)?
        count = json.text_of(json.member(one.value, key: "_digits")?)?

        if one.key != "DEFAULT" && count != "2"
            digits[one.key] @ to_i64_text(count)?

    regions: {str: str} @= {}

    for region in cldrkit.entries(json.member(data, key: "region")?)?
        for item in json.items_of(region.value)?
            for entry in cldrkit.entries(item)?
                ended = !json.member(entry.value, key: "_to").is_err()
                tender = numbers.text_or_empty(entry.value, key: "_tender")?

                if !ended && tender != "false" && regions[region.key].is_err()
                    regions[region.key] @ entry.key

    codes = sort(keys(digits))
    counts: [i64] @= []

    for code in codes
        counts @ counts.push(digits[code].must())

    region_codes = sort(keys(regions))
    currencies: [str] @= []

    for region in region_codes
        currencies @ currencies.push(regions[region].must())

    return ok(
        CurrencyData(digit_codes: codes, digit_counts: counts, region_codes: region_codes, region_currencies: currencies)
    )

# `text`, decimal digits alone, as a number.
#
# Fails `invalid` where it is empty or holds anything else.
function to_i64_text(text: str) -> i64?
    value @= 0

    if text == ""
        return fail(code: "invalid", msg: "a count of digits is empty")

    for c in text.chars()
        if c[0] < '0' || c[0] > '9'
            return fail(code: "invalid", msg: f"\"{text}\" is not a count of digits")
        value @ value * 10 + to_i64(c[0] - '0').must()

    return ok(value)

# The whole text of `number_tables`.
#
# Fails as reading the data and writing a literal fail.
function module_text(release: cldrkit.Release lent) -> str?
    tags = locale_tags(release)?
    root = numbers.currency_symbols(cldrkit.member_at(release, name: "cldr-numbers-full/main/und/currencies.json", path: ["main", "und", "numbers", "currencies"])?)?
    symbols @= blocks.empty()
    patterns @= blocks.empty()
    compacts @= blocks.empty()
    currency_blocks @= blocks.empty()
    rows: [str] @= []
    currency_rows: [i64] @= []

    for tag in tags
        one = numbers.read_locale(release, tag: tag, root: root)?
        parts: [str] @= []

        for system in one.systems
            s = blocks.number_of(@symbols, text: system.symbols)
            p = blocks.number_of(@patterns, text: system.patterns)
            short = blocks.number_of(@compacts, text: system.short)
            long = blocks.number_of(@compacts, text: system.long)
            parts @ parts.push(f"{system.name}:{s},{p},{short},{long}")

        rows @ rows.push(one.default + " " + one.native + "|" + parts.join(";"))
        currency_rows @ currency_rows.push(blocks.number_of(@currency_blocks, text: one.currencies))

    systems = digit_systems(release)?
    currency = currency_data(release)?
    head = [
        "# The number data of CLDR release 49 for every locale it holds, which"
        "# `i18n/numbers` reads: each locale's numbering systems, and for each system"
        "# its symbols, its patterns and its compact patterns, as indices into the"
        "# tables below; each locale's currency symbols; the ten digits of every"
        "# numbering system that has them; the digits of the currencies whose amounts"
        "# are not written with two; the currency each region uses today."
        "#"
        "# A block's fields are separated by U+0001 and a list's entries by U+0002."
        "#"
        "# Generated, never edited by hand: the Heroes program `rebel/generators/i18n_numbers/`"
        "# read CLDR 49's JSON, `cldr-49.0.0-json-full.zip` of"
        "# https://github.com/unicode-org/cldr-json/releases/download/49.0.0/"
        "# (SHA-256"
        f"# {cldrkit.SOURCE_SHA256},"
        "# fetched 2026-11-21), its files `cldr-numbers-full/main/*/numbers.json` and"
        "# `currencies.json`, and `cldr-core`'s `availableLocales.json`,"
        "# `supplemental/numberingSystems.json` and `currencyData.json`, and wrote this"
        "# module whole; its `check` command says whether this module is still what"
        "# it writes."
    ]
    parts = [
        head.join("\n")
        tablekit.strings_constant(comment: ["# The locales, `und` the root, in the order of their bytes."], name: "LOCALES", items: tags)?
        tablekit.strings_constant(comment: ["# Each locale's default and native numbering systems, then `|` and per", "# system `system:symbols,patterns,short,long` separated by `;`, in the order", "# of `LOCALES`."], name: "LOCALE_DATA", items: rows)?
        tablekit.strings_constant(comment: ["# The symbol blocks: decimal, group, percent, per mille, plus, minus,", "# exponential, superscripting exponent, infinity, nan, approximately, time", "# separator, currency decimal, currency group."], name: "SYMBOLS", items: symbols.items)?
        tablekit.strings_constant(comment: ["# The pattern blocks: decimal, percent, scientific, currency, currency with a", "# letter beside the number, accounting, accounting with a letter beside the", "# number, the space before a currency, the space after one, the minimum", "# grouping digits."], name: "PATTERNS", items: patterns.items)?
        tablekit.strings_constant(comment: ["# The compact pattern blocks, each entry `power count pattern` separated by", "# U+0001: `1000`, `one`, `0K`."], name: "COMPACTS", items: compacts.items)?
        tablekit.strings_constant(comment: ["# The currency symbol blocks, each entry `code symbol narrow` separated by", "# U+0001: the root's for every currency whose symbol and narrow symbol are", "# not both its code, and each other locale's where its pair differs from", "# the root's, its code twice included."], name: "CURRENCY_SYMBOLS", items: currency_blocks.items)?
        tablekit.numbers_constant(comment: ["# Each locale's currency symbol block, in the order of `LOCALES`."], name: "LOCALE_CURRENCIES", items: currency_rows)
        tablekit.strings_constant(comment: ["# The numbering systems with ten digits, in the order of their bytes."], name: "SYSTEM_NAMES", items: evens(systems))?
        tablekit.strings_constant(comment: ["# The ten digits of each, in the order of `SYSTEM_NAMES`."], name: "SYSTEM_DIGITS", items: odds(systems))?
        tablekit.strings_constant(comment: ["# The currencies whose amounts are not written with two digits after the", "# point, in the order of their bytes."], name: "DIGIT_CODES", items: currency.digit_codes)?
        tablekit.numbers_constant(comment: ["# The digits of each, in the order of `DIGIT_CODES`."], name: "DIGIT_COUNTS", items: currency.digit_counts)
        tablekit.strings_constant(comment: ["# The regions with a currency in use, in the order of their bytes."], name: "REGION_CODES", items: currency.region_codes)?
        tablekit.strings_constant(comment: ["# The currency of each, in the order of `REGION_CODES`."], name: "REGION_CURRENCIES", items: currency.region_currencies)?
    ]
    return ok(parts.join("\n\n") + "\n")

# Does what `command` asks with the table, reading the zip at `path`.
#
# Fails as opening the zip, reading its data and writing or reading the table
# fail.
function run(command: str, path: str) -> i64?
    release = cldrkit.open(path)?
    return tablekit.settle(command: command, path: TABLE, text: module_text(release)?)

function main()
    words = tablekit.command_words("i18n_numbers")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run rebel/generators/i18n_numbers/main.hero -- write|check <zip of ",
            cldrkit.SOURCE_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], path: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "evens and odds: the keys and the values of a list of pairs"
    assert evens(["a", "1", "b", "2"]) == ["a", "b"] && odds(["a", "1", "b", "2"]) == ["1", "2"]

test "to_i64_text: a count, none, and one that is not a number"
    assert to_i64_text("0").must() == 0 && to_i64_text("3").must() == 3
    assert to_i64_text("").is_err() && to_i64_text("x").is_err()
