# `pdf/internal/encodings.hero`: PDF's five single-byte encodings as code
# points, and the three functions that turn a character back into a code.

use <rebel>/strings
use <tablekit>/tablekit

use afm
use glyphs

# The five encodings, each 256 code points, 0 for a code with none.
record Encodings
    standard: [i64]
    win_ansi: [i64]
    mac_roman: [i64]
    symbol: [i64]
    dingbats: [i64]
    # The code points Symbol is also found from, beside its encoding's own:
    # `point << 8 | code`.
    symbol_extra: [i64]

# The number written in hexadecimal by `text`, `0x` before it or not.
#
# Fails `invalid` where `text` is empty or holds a character that is not a
# hexadecimal digit.
function hex_value(text: str) -> i64?
    digits = strings.trim_prefix(s: strings.trim_prefix(s: text, prefix: "0x"), prefix: "0X")

    if digits == "" || digits.len() > 8
        return fail(code: "invalid", msg: f"\"{text}\" is not a number in hexadecimal")
    value @= 0

    for c in digits.chars()
        at = match strings.index_of(s: "0123456789ABCDEF", substr: strings.to_upper(c))
            .ok found => found
            .err _    => -1

        if at < 0
            return fail(code: "invalid", msg: f"\"{text}\" is not a number in hexadecimal")
        value @ value * 16 + at

    return ok(value)

# The code points of a mapping file of unicode.org (`CP1252.TXT`,
# `ROMAN.TXT`): each line `0xXX<tab>0xXXXX<tab># name`, a code left without
# a code point undefined. A control, below 0x20 or 0x7F, is left 0, as PDF
# draws none.
#
# Fails `invalid` where a line is not a code and a code point, or a code is
# past 0xFF.
function read_mapping(text: str) -> [i64]?
    out: [i64] @= []

    while out.len() < 256
        out @ out.push(0)

    for line in strings.split_terminated(s: text, sep: "\n")
        body = match strings.split_once(s: line, sep: "#")
            .ok halves => halves.before
            .err _     => line

        words = strings.words(body)

        if words.len() == 0 || words.len() == 1 && strings.has_prefix(s: words[0], prefix: "0x")
            continue

        if words.len() != 2
            return fail(code: "invalid", msg: f"the mapping line \"{line}\" is not a code and a code point")
        code = hex_value(words[0])?

        if code > 255
            return fail(code: "invalid", msg: f"the mapping line \"{line}\" names a code past 0xFF")

        if code >= 0x20 && code != 0x7f
            out[code] @ hex_value(words[1])?

    return ok(out)

# The first code point of each glyph name of `list`.
#
# Fails as `hex_value` fails.
function points_by_name(list: [glyphs.Glyph] lent) -> {str: i64}?
    out: {str: i64} @= {}

    for one in list
        out[one.name] @ hex_value(strings.split(s: one.points, sep: " ")[0])?

    return ok(out)

# The built-in encoding of the font `font`: the code point of the glyph at
# each code, by the glyph list.
#
# Fails `invalid` where a glyph's name is not in the list.
function built_in(font: afm.Font lent, points: {str: i64} lent) -> [i64]?
    out: [i64] @= []

    while out.len() < 256
        out @ out.push(0)

    for glyph in font.glyphs
        if glyph.code >= 0
            match points[glyph.name]
                .ok point => out[glyph.code] @ point
                .err _ => return fail(
                    code: "invalid",
                    msg: f"the glyph {glyph.name} of {font.name} is not in the glyph list"
                )

    return ok(out)

# The five encodings and Symbol's other code points.
#
# - `cp1252`, `roman`: the texts of `CP1252.TXT` and `ROMAN.TXT`.
# - `helvetica`, `symbol`, `dingbats`: the three AFM files read.
# - `list`: the glyph list, merged.
#
# Fails as reading a mapping and `built_in` fail.
function read_encodings(cp1252: str, roman: str, helvetica: afm.Font lent, symbol: afm.Font lent, dingbats: afm.Font lent, list: [glyphs.Glyph] lent) -> Encodings?
    points = points_by_name(list)?
    mac @= read_mapping(roman)?

    # PDF's MacRomanEncoding holds the currency sign where Mac OS 8.5 put
    # the euro (PDF 32000-1:2008 Annex D).
    mac[0xdb] @ 0xa4
    extra: [i64] @= []

    for glyph in symbol.glyphs
        if glyph.code >= 0
            match points[glyph.name + "greek"]
                .ok point => extra @ extra.push(point << 8 | glyph.code)
                .err _    => _ = 0

    return ok(
        Encodings(standard: built_in(helvetica, points: points)?, win_ansi: read_mapping(cp1252)?, mac_roman: mac, symbol: built_in(symbol, points: points)?, dingbats: built_in(dingbats, points: points)?, symbol_extra: extra)
    )

# A function of `match` arms, each key padded to the longest, `_` last.
#
# - `head`: its comment and signature, each line a line.
# - `before`: the lines between the signature and the `match`.
# - `labels`, `values`: the arms, in order.
# - `otherwise`: the value of `_`.
function match_function(head: [str], before: [str], labels: [str], values: [str], otherwise: str) -> str
    width @= 1

    for key in labels
        if key.len() > width
            width @ key.len()

    out: [str] @= []

    for line in head
        out @ out.push(line)

    for line in before
        out @ out.push(line)

    out @ out.push("    return match point")
    at @= 0

    while at < labels.len()
        out @ out.push("        " + strings.pad_end(s: labels[at], width: width, pad: " ") + " => " + values[at])
        at @ at + 1

    out @ out.push("        " + strings.pad_end(s: "_", width: width, pad: " ") + " => " + otherwise)
    return out.join("\n")

# `n` in lowercase hexadecimal after `0x`.
function hex_of(n: i64) -> str
    digits = "0123456789abcdef"
    out @= ""
    rest @= n

    while rest > 0 || out == ""
        out @ digits.slice(from: rest % 16, to: rest % 16 + 1) + out
        rest @ rest / 16

    return "0x" + out

# The code of each code point of `encoding` and of `extra` (`point << 8 |
# code`), in the order of the code points: the first code where two hold
# one, an extra only where the encoding has none.
#
# Fails `invalid` where a code point is 0x100000 or past, which `<< 8` would
# not hold.
function inverse(encoding: [i64] lent, extra: [i64] lent) -> [i64]?
    by_point: {i64: i64} @= {}
    code @= 0

    while code < 256
        point = encoding[code]

        if point != 0 && by_point[point].is_err()
            by_point[point] @ code
        code @ code + 1

    for one in extra
        if by_point[one >> 8].is_err()
            by_point[one >> 8] @ one & 255

    out: [i64] @= []

    for point in sort(keys(by_point))
        if point >= 0x100000
            return fail(code: "invalid", msg: "a code point past 0xFFFFF")
        out @ out.push(point << 8 | by_point[point].must())

    return ok(out)

# The arms of `pairs` (`point << 8 | code`), the code in decimal or in
# hexadecimal.
record Arms
    labels: [str]
    values: [str]

function arms_of(pairs: [i64] lent, hex_codes: bool) -> Arms
    out @= Arms(labels: [], values: [])

    for one in pairs
        out.labels @ out.labels.push(hex_of(one >> 8))

        value = if hex_codes
            hex_of(one & 255)
        else
            to_str(one & 255)
        out.values @ out.values.push(value)

    return out

# The whole text of `encodings.hero`.
#
# Fails `invalid` where WinAnsiEncoding is not Latin-1 at 0x20 to 0x7E and
# 0xA0 to 0xFF, which `win_ansi_code_of` answers without a table, and as
# writing the table fails.
function module_text(encodings: Encodings lent) -> str?
    head = [
        "# The single-byte encodings of PDF as code points, 256 to a table, 0 for a"
        "# code an encoding leaves undefined: StandardEncoding from Helvetica's AFM"
        "# file, WinAnsiEncoding as Windows code page 1252 (PDF 32000-1:2008 Annex"
        "# D, with its two doubled glyphs, space at 0xA0 and hyphen at 0xAD), PDF's"
        "# MacRomanEncoding as Mac OS Roman with the currency sign at 0xDB where Mac"
        "# OS 8.5 put the euro, and the built-in encodings of Symbol and ZapfDingbats"
        "# from their AFM files. Glyph names are turned into code points by Adobe's"
        "# Glyph List 2.0 (`glyphlist.txt` and `zapfdingbats.txt`): Symbol's Omega is"
        "# the ohm sign, U+2126, as Poppler reads it too, and a glyph of Symbol whose"
        "# name the list also gives with `greek` after it (Delta, mu, Omega and"
        "# question) is found from that Greek character too, so either is shown."
        "# PDFDocEncoding, for text strings, is written by hand in `text_strings` and"
        "# checked there."
        "#"
        "# Generated, never edited by hand: the Heroes program `rebel/generators/pdf_tables/`"
        "# read code page 1252 and Mac OS Roman as unicode.org's mapping files"
        "# `CP1252.TXT` and `ROMAN.TXT` give them, the three AFM files and the glyph"
        "# lists, each held to its SHA-256, and wrote this module whole; its `check`"
        "# command says whether this module is still what it writes."
    ]
    win = encodings.win_ansi
    windows: [i64] @= []
    code @= 0

    while code < 256
        if code >= 0x20 && code <= 0x7e || code >= 0xa0
            if win[code] != code
                return fail(code: "invalid", msg: f"code page 1252 is not Latin-1 at {hex_of(code)}")
        else if win[code] != 0
            windows @ windows.push(win[code] << 8 | code)
        code @ code + 1

    win_arms = arms_of(sort(windows), hex_codes: true)
    symbol_arms = arms_of(inverse(encoding: encodings.symbol, extra: encodings.symbol_extra)?, hex_codes: false)
    dingbat_arms = arms_of(inverse(encoding: encodings.dingbats, extra: [])?, hex_codes: false)
    parts = [
        head.join("\n")
        tablekit.numbers_constant(comment: ["# StandardEncoding: the code point of each code, 0 where none."], name: "STANDARD", items: encodings.standard)
        tablekit.numbers_constant(comment: ["# WinAnsiEncoding: the code point of each code, 0 where none."], name: "WIN_ANSI", items: win)
        tablekit.numbers_constant(comment: ["# MacRomanEncoding: the code point of each code, 0 where none."], name: "MAC_ROMAN", items: encodings.mac_roman)
        tablekit.numbers_constant(comment: ["# Symbol's built-in encoding: the code point of each code, 0 where none."], name: "SYMBOL", items: encodings.symbol)
        tablekit.numbers_constant(comment: ["# ZapfDingbats' built-in encoding: the code point of each code, 0 where none."], name: "DINGBATS", items: encodings.dingbats)
        match_function(head: ["# The WinAnsiEncoding code of the character `point`, or -1 where it has", "# none: Latin-1's own code from U+0020 to U+007E and U+00A0 to U+00FF, and the", f"# {win_arms.labels.len()} characters Windows put in 0x80 to 0x9F.", "function win_ansi_code_of(point: i64) -> i64"], before: ["    if point >= 0x20 && point <= 0x7e || point >= 0xa0 && point <= 0xff", "        return point", ""], labels: win_arms.labels, values: win_arms.values, otherwise: "-1")
        match_function(head: ["# The code of the character `point` in Symbol' built-in encoding, or -1", "# where the font has no glyph for it.", "function symbol_code_of(point: i64) -> i64"], before: [], labels: symbol_arms.labels, values: symbol_arms.values, otherwise: "-1")
        match_function(head: ["# The code of the character `point` in ZapfDingbats' built-in encoding, or -1", "# where the font has no glyph for it.", "function dingbats_code_of(point: i64) -> i64"], before: [], labels: dingbat_arms.labels, values: dingbat_arms.values, otherwise: "-1")
        ["test \"the encodings: a few codes of each, read from the generator's sources\"", "    assert STANDARD[0x41] == 0x41 && STANDARD[0x27] == 0x2019 && STANDARD[0xa4] == 0x2044", "    assert WIN_ANSI[0x80] == 0x20ac && WIN_ANSI[0x81] == 0 && WIN_ANSI[0x92] == 0x2019", "    assert MAC_ROMAN[0x80] == 0xc4 && MAC_ROMAN[0xdb] == 0xa4", "    assert SYMBOL[0x61] == 0x3b1 && DINGBATS[0x21] == 0x2701", "    assert win_ansi_code_of(0x20ac) == 0x80 && win_ansi_code_of(0x100) == -1 && win_ansi_code_of(0xe9) == 0xe9", "    assert dingbats_code_of(0x20) == 0x20 && DINGBATS[0x20] == 0x20", "    assert symbol_code_of(0x3c0) == 0x70 && dingbats_code_of(0x2701) == 0x21 && symbol_code_of(0x391) == 0x41 && symbol_code_of(0x41) == -1"].join("\n")
    ]
    return ok(parts.join("\n\n") + "\n")

## Tests

test "read_mapping: a code, an undefined one, a control left 0, and a line that is not a pair refused"
    mapping = read_mapping(
        "#\tcomment\n0x01\t0x0001\t#START OF HEADING\n0x41\t0x0041\t#A\n0x81\t      \t#UNDEFINED\n0x80\t0x20AC\t#EURO SIGN\n"
    ).must()
    assert mapping.len() == 256 && mapping[0x41] == 0x41 && mapping[0x80] == 0x20ac && mapping[0x81] == 0 && mapping[1] == 0
    assert read_mapping("0x41 0x41 0x42\n").is_err() && read_mapping("0x141\t0x41\n").is_err()

test "inverse and match_function: the first code of a point, an extra only where none, keys padded"
    encoding: [i64] @= []

    while encoding.len() < 256
        encoding @ encoding.push(0)

    encoding[0x20] @ 0x20
    encoding[0x41] @ 0x2126
    encoding[0xa0] @ 0x20
    pairs = inverse(encoding: encoding, extra: [0x3a9 << 8 | 0x41, 0x20 << 8 | 0x99]).must()
    assert pairs == [0x20 << 8 | 0x20, 0x3a9 << 8 | 0x41, 0x2126 << 8 | 0x41]
    arms = arms_of(pairs, hex_codes: false)
    text = match_function(
        head: ["function f(point: i64) -> i64"],
        before: [],
        labels: arms.labels,
        values: arms.values,
        otherwise: "-1"
    )
    assert text == "function f(point: i64) -> i64\n    return match point\n        0x20   => 32\n        0x3a9  => 65\n        0x2126 => 65\n        _      => -1"

test "hex_value: with and without 0x, and a word that is not a number refused"
    assert hex_value("0x20AC").must() == 0x20ac && hex_value("F8FF").must() == 0xf8ff
    assert hex_value("").is_err() && hex_value("0xG1").is_err()
