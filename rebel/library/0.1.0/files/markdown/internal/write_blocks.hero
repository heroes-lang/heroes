# A tree written back as Markdown, block by block: a walk in document order
# that follows the links and keeps no stack, each container adding to the
# lines inside it what makes them its own (a block quote's `> `, a list
# item's marker on its first line and the marker's width of spaces on the
# others), blocks apart by a blank line but in a tight list, and each leaf
# block laid out on its lines. What the reader reads back is the same tree,
# but where the tree holds what Markdown cannot say, as the face tells.

use markdown/internal/scan
use markdown/internal/tree
use markdown/internal/write_inlines
use strings

# The prefixes of the open containers, the innermost last: what a
# container's first line begins with, what its other lines begin with, and
# whether its first line is written.
record Levels
    # A block quote's `> `, or an item's marker and its task box.
    firsts: [str]
    # A block quote's `> `, or as many spaces as the item's marker is wide.
    others: [str]
    # Whether the container's first line is written.
    used: [bool]
    # How many containers are open.
    depth: i64

# The Markdown of the tree under `root`, every line ended by a line feed;
# empty where the tree holds no block.
function markdown_of(nodes: [tree.Node] lent, root: i64) -> str
    lines: [str] @= []
    levels @= Levels(firsts: [], others: [], used: [], depth: 0)

    # Each list's marker as written, and the number of its next item.
    markers: {i64: str} @= {}
    numbers: {i64: i64} @= {}
    at @= root
    down @= true

    while true
        n = nodes[at]
        kind = n.kind

        if down
            if at != root && n.prev != tree.NONE && is_apart(nodes, node: at)
                emit(@lines, @levels, line: "")

            if kind == tree.BLOCK_QUOTE
                open_level(@levels, first: "> ", other: "> ")
            else if kind == tree.LIST
                markers[at] @ marker_of(nodes, list: at, markers: markers)
                numbers[at] @ n.number
            else if kind == tree.ITEM
                marker = item_marker(nodes, item: at, markers: markers, numbers: numbers)

                if nodes[n.parent].ordered
                    numbers[n.parent] @ numbers[n.parent].default(0) + 1

                box = if n.state == 1
                    "[ ] "
                else if n.state == 2
                    "[x] "
                else
                    ""
                open_level(@levels, first: marker + " " + box, other: repeat(" ", to_u64(marker.len() + 1).must()))
            else if kind != tree.DOCUMENT
                for line in block_lines(nodes, node: at, markers: markers)
                    emit(@lines, @levels, line: line)

            if n.first != tree.NONE && is_container(kind)
                at @ n.first
                continue

        if kind == tree.BLOCK_QUOTE || kind == tree.ITEM
            if !levels.used[levels.depth - 1]
                emit(@lines, @levels, line: "")
            levels.depth @ levels.depth - 1

        if at == root
            break

        if n.next != tree.NONE
            at @ n.next
            down @ true
        else
            at @ n.parent
            down @ false

    if lines.len() == 0
        return ""
    return join(lines, "\n") + "\n"

# Whether a node of `kind` holds blocks the walk enters.
function is_container(kind: i64) -> bool
    return kind == tree.DOCUMENT || kind == tree.BLOCK_QUOTE || kind == tree.LIST || kind == tree.ITEM

# Whether a blank line stands between `node` and the block before it: always,
# but between the items of a tight list and between the blocks of an item of
# one.
function is_apart(nodes: [tree.Node] lent, node: i64) -> bool
    parent = nodes[node].parent

    if nodes[parent].kind == tree.LIST
        return !nodes[parent].flag

    if nodes[parent].kind == tree.ITEM
        list = nodes[parent].parent
        return list == tree.NONE || !nodes[list].flag
    return true

# Opens a container whose lines begin with `first`, its first, and `other`.
function open_level(@levels: Levels, first: str, other: str)
    firsts @= levels.firsts
    others @= levels.others
    used @= levels.used
    put(items: @firsts, top: levels.depth, item: first)
    put(items: @others, top: levels.depth, item: other)
    put(items: @used, top: levels.depth, item: false)
    levels.firsts @ firsts
    levels.others @ others
    levels.used @ used
    levels.depth @ levels.depth + 1

# Writes `item` at index `top` of `items`, the list growing by one where
# `top` is its length.
function put<T>(@items: [T], top: i64, item: T)
    if top == items.len()
        items @ items.push(item)
    else
        items[top] @ item

# Adds `line` to `lines` after the prefixes of the open containers: a
# container's first prefix on its first line, its other one after. A blank
# line keeps the prefixes but the spaces at their end.
function emit(@lines: [str], @levels: Levels, line: str)
    parts: [str] @= []
    used @= levels.used

    for k in range(from: 0, to: levels.depth)
        if used[k]
            parts @ parts.push(levels.others[k])
        else
            parts @ parts.push(levels.firsts[k])
            used[k] @ true

    levels.used @ used
    parts @ parts.push(line)
    whole = join(parts, "")

    if line.len() == 0
        lines @ lines.push(strings.trim_end(whole))
    else
        lines @ lines.push(whole)

# The marker the list `list` is written with: its own, but another where the
# block before it is a list written with the same one, which would read as
# one list with it.
function marker_of(nodes: [tree.Node] lent, list: i64, markers: {i64: str} lent) -> str
    n = nodes[list]

    own = if n.ordered && (n.marker == "." || n.marker == ")")
        n.marker
    else if n.ordered
        "."
    else if n.marker == "-" || n.marker == "+" || n.marker == "*"
        n.marker
    else
        "-"
    prev = n.prev

    if prev == tree.NONE || nodes[prev].kind != tree.LIST || nodes[prev].ordered != n.ordered
        return own

    if markers[prev].default("") != own
        return own

    if n.ordered
        if own == "."
            return ")"
        return "."

    if own == "-"
        return "*"
    return "-"

# The marker of the item `item`: its list's bullet, or its number and the
# list's delimiter.
function item_marker(nodes: [tree.Node] lent, item: i64, markers: {i64: str} lent, numbers: {i64: i64} lent) -> str
    list = nodes[item].parent
    marker = markers[list].default("-")

    if nodes[list].ordered
        return to_str(numbers[list].default(1)) + marker
    return marker

# The lines of the leaf block `node`, before any container's prefix.
function block_lines(nodes: [tree.Node] lent, node: i64, markers: {i64: str} lent) -> [str]
    n = nodes[node]
    kind = n.kind

    if kind == tree.PARAGRAPH
        text = write_inlines.inlines_of(nodes, block: node, place: write_inlines.Place(cell: false, one_line: false))
        return strings.split(s: text, sep: "\n")

    if kind == tree.HEADING
        return heading_lines(nodes, node: node)

    if kind == tree.THEMATIC_BREAK
        return [break_of(nodes, node: node, markers: markers)]

    if kind == tree.CODE_BLOCK
        return code_lines(nodes, node: node)

    if kind == tree.HTML_BLOCK
        return strings.split(s: n.literal, sep: "\n")

    if kind == tree.TABLE
        return table_lines(nodes, node: node)
    return []

# A heading's lines: `#` as many as its level before its text, or its text
# underlined with `=` or `-` where it holds a break and is of level 1 or 2,
# which alone can hold one.
function heading_lines(nodes: [tree.Node] lent, node: i64) -> [str]
    level = nodes[node].number

    if level <= 2 && holds_break(nodes, node: node)
        text = write_inlines.inlines_of(nodes, block: node, place: write_inlines.Place(cell: false, one_line: false))
        lines @= strings.split(s: text, sep: "\n")

        underline = if level == 1
            "==="
        else
            "---"
        lines @ lines.push(underline)
        return lines
    text = write_inlines.inlines_of(nodes, block: node, place: write_inlines.Place(cell: false, one_line: true))
    marks = repeat("#", to_u64(level).must())

    if text.len() == 0
        return [marks]
    return [marks + " " + closing_kept(text)]

# Whether a break stands among the inlines of `node`.
function holds_break(nodes: [tree.Node] lent, node: i64) -> bool
    at @= nodes[node].first

    while at != tree.NONE
        kind = nodes[at].kind

        if kind == tree.SOFT_BREAK || kind == tree.LINE_BREAK
            return true

        if nodes[at].first != tree.NONE
            at @ nodes[at].first
        else
            at @ tree.after_node(nodes, node: at, root: node)

    return false

# A heading's text with its last run of `#` escaped where the reader would
# take it for the closing sequence: the run is the whole text, or a space or
# a tab stands before it.
function closing_kept(text: str) -> str
    if text[text.len() - 1] != '#'
        return text
    start @= text.len()

    while start > 0 && text[start - 1] == '#'
        start @ start - 1

    if start == 0 || text[start - 1] == ' ' || text[start - 1] == '\t'
        return text.slice(from: 0, to: start) + "\\" + text.slice(from: start, to: text.len())
    return text

# A thematic break: `***`, or `---` as the first block of an item whose
# bullet is `*`, where `* ***` would read as a break and no item.
function break_of(nodes: [tree.Node] lent, node: i64, markers: {i64: str} lent) -> str
    parent = nodes[node].parent

    if nodes[parent].kind == tree.ITEM && nodes[parent].first == node
        if markers[nodes[parent].parent].default("") == "*"
            return "---"
    return "***"

# A code block's lines: indented by four spaces where it was indented, its
# first and last lines are not blank and no list stands before it; else
# between fences of backticks, or of tildes where the info string holds a
# backtick, longer than any run of the fence's character that begins one of
# its lines.
function code_lines(nodes: [tree.Node] lent, node: i64) -> [str]
    n = nodes[node]
    code @= n.literal

    if code.len() > 0 && code[code.len() - 1] == '\n'
        code @ code.slice(from: 0, to: code.len() - 1)

    lines: [str] = if n.literal.len() == 0
        []
    else
        strings.split(s: code, sep: "\n")

    if is_indentable(nodes, node: node, lines: lines)
        indented: [str] @= []

        for line in lines
            if line.len() == 0
                indented @ indented.push("")
            else
                indented @ indented.push("    " + line)

        return indented
    tilde = strings.contains(s: n.title, substr: "`")

    fence_char = if tilde
        "~"
    else
        "`"
    width @= 3

    for line in lines
        run = leading_run(strings.trim_start(line), of: fence_char[0])

        if run >= width
            width @ run + 1

    fence = repeat(fence_char, to_u64(width).must())
    out: [str] @= [fence + info_text(n.title)]

    for line in lines
        out @ out.push(line)

    out @ out.push(fence)
    return out

# Whether the code block `node`, of `lines`, is written indented: it was
# indented, holds a line, its first and last lines hold more than white
# space, and the block before it is no list, which would take it in.
function is_indentable(nodes: [tree.Node] lent, node: i64, lines: [str] lent) -> bool
    n = nodes[node]

    if n.flag || n.title.len() > 0 || lines.len() == 0
        return false

    if strings.trim(lines[0]).len() == 0 || strings.trim(lines[lines.len() - 1]).len() == 0
        return false
    parent = nodes[n.parent].kind

    if parent != tree.DOCUMENT && parent != tree.BLOCK_QUOTE
        return false
    return n.prev == tree.NONE || nodes[n.prev].kind != tree.LIST

# How many bytes `b` begin `s`.
function leading_run(s: str, of: u8) -> i64
    i @= 0

    while i < s.len() && s[i] == of
        i @ i + 1

    return i

# An info string as written after a fence: its backslashes and references
# escaped, as the reader reads them.
function info_text(info: str) -> str
    parts: [str] @= []
    run @= 0
    i @= 0

    while i < info.len()
        if info[i] == '\\' || info[i] == '&' && scan.reference_at(info, i).end > 0
            parts @ parts.push(info.slice(from: run, to: i))
            parts @ parts.push("\\")
            run @ i
        i @ i + 1

    parts @ parts.push(info.slice(from: run, to: info.len()))
    return join(parts, "")

# A table's lines: its header, the row of its alignments, and each other row,
# a cell's text between `|`s.
function table_lines(nodes: [tree.Node] lent, node: i64) -> [str]
    out: [str] @= []
    cells = write_inlines.Place(cell: true, one_line: true)

    for row in tree.children(nodes, node)
        texts: [str] @= []

        for cell in tree.children(nodes, row)
            texts @ texts.push(write_inlines.inlines_of(nodes, block: cell, place: cells))

        out @ out.push("| " + join(texts, " | ") + " |")

        if nodes[row].flag
            aligns: [str] @= []

            for a in nodes[node].aligns
                one = if a == 1
                    ":--"
                else if a == 2
                    ":-:"
                else if a == 3
                    "--:"
                else
                    "---"
                aligns @ aligns.push(one)

            out @ out.push("| " + join(aligns, " | ") + " |")

    return out

## Tests

# The Markdown of a document holding one block of `kind` under its root, and
# under the block one text, `text`.
function one_text(kind: i64, text: str) -> str
    nodes: [tree.Node] @= [tree.make(tree.DOCUMENT)]
    block = tree.append(@nodes, parent: 0, node: tree.make(kind))
    _ = tree.append(@nodes, parent: block, node: tree.make_literal(tree.TEXT, literal: text))
    return markdown_of(nodes, root: 0)

test "markdown_of: a paragraph, an empty document, and an escaped start"
    assert one_text(tree.PARAGRAPH, "a") == "a\n"
    assert one_text(tree.PARAGRAPH, "- a") == "\\- a\n"
    nodes: [tree.Node] = [tree.make(tree.DOCUMENT)]
    assert markdown_of(nodes, root: 0) == ""

test "markdown_of: a block quote and a list item prefix every line, an empty item its marker alone"
    nodes: [tree.Node] @= [tree.make(tree.DOCUMENT)]
    quote = tree.append(@nodes, parent: 0, node: tree.make(tree.BLOCK_QUOTE))
    p = tree.append(@nodes, parent: quote, node: tree.make(tree.PARAGRAPH))
    _ = tree.append(@nodes, parent: p, node: tree.make_literal(tree.TEXT, literal: "a"))
    _ = tree.append(@nodes, parent: p, node: tree.make(tree.SOFT_BREAK))
    _ = tree.append(@nodes, parent: p, node: tree.make_literal(tree.TEXT, literal: "b"))
    list @= tree.make(tree.LIST)
    list.marker @ "-"
    list.flag @ true
    l = tree.append(@nodes, parent: 0, node: list)
    _ = tree.append(@nodes, parent: l, node: tree.make(tree.ITEM))
    assert markdown_of(nodes, root: 0) == "> a\n> b\n\n-\n"

test "closing_kept and code_lines' fence: a closing sequence escaped, a fence longer than a run inside"
    assert closing_kept("a #") == "a \\#"
    assert closing_kept("C#") == "C#"
    assert closing_kept("##") == "\\##"
    assert leading_run("````x", of: '`') == 4
    assert info_text("a\\b") == "a\\\\b"
