    assert written_back(source, extended: false)

test "example 197: Link reference definitions"
    source = "[foo]: /url 'title\n\nwith blank line'\n\n[foo]\n"
    assert commonmark(source) == "<p>[foo]: /url 'title</p>\n<p>with blank line'</p>\n<p>[foo]</p>\n"
    assert written_back(source, extended: false)

test "example 198: Link reference definitions"
    source = "[foo]:\n/url\n\n[foo]\n"
