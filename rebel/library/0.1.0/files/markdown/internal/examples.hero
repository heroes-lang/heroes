# The examples of the CommonMark specification, version 0.31.2, every one,
# its Markdown and the HTML it must give, as fetched from
# spec.commonmark.org/0.31.2/spec.json on 2026-11-17; and the examples of
# GFM's tables, strikethrough, extended autolinks and task list items from
# the GFM specification (github/cmark-gfm, test/spec.txt) the same day. Each
# is a test, and each is also written back as Markdown and read again; nothing
# else here is compiled into a program.

use markdown/internal/pipeline
use markdown/internal/render
use markdown/internal/write_blocks

# The version of the CommonMark specification whose examples these are.
constant VERSION: str
    "0.31.2"

# The HTML of `text` read and written as the specification's reference
# does: CommonMark alone, raw HTML and every destination kept.
function commonmark(text: str) -> str
    rules = pipeline.Rules(max_depth: 1000, tables: false, strikethrough: false, autolinks: false, tasks: false)
    return pipeline.html_of(text, rules: rules, style: render.Style(keep_html: true, keep_unsafe: true))

# The HTML of `text` read with GFM's extensions, raw HTML and every
# destination kept.
function gfm(text: str) -> str
    rules = pipeline.Rules(max_depth: 1000, tables: true, strikethrough: true, autolinks: true, tasks: true)
    return pipeline.html_of(text, rules: rules, style: render.Style(keep_html: true, keep_unsafe: true))

# Whether `text`, read as `commonmark` reads it, or as `gfm` does where
# `extended` is set, then written back as Markdown, reads again into a tree
# that gives the same HTML and writes the same Markdown.
function written_back(text: str, extended: bool) -> bool
    rules = pipeline.Rules(
        max_depth: 1000,
        tables: extended,
        strikethrough: extended,
        autolinks: extended,
        tasks: extended
    )
    style = render.Style(keep_html: true, keep_unsafe: true)
    first = pipeline.read(text, rules)
    written = write_blocks.markdown_of(first.nodes, root: 0)
    again = pipeline.read(written, rules)
    same_html = render.html_of(again.nodes, root: 0, style: style) == render.html_of(first.nodes, root: 0, style: style)
    return same_html && write_blocks.markdown_of(again.nodes, root: 0) == written

test "example 1: Tabs"
    source = "\tfoo\tbaz\t\tbim\n"
    assert commonmark(source) == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 2: Tabs"
    source = "  \tfoo\tbaz\t\tbim\n"
    assert commonmark(source) == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 3: Tabs"
    source = "    a\ta\n    ὐ\ta\n"
    assert commonmark(source) == "<pre><code>a\ta\nὐ\ta\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 4: Tabs"
    source = "  - foo\n\n\tbar\n"
    assert commonmark(source) == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 5: Tabs"
    source = "- foo\n\n\t\tbar\n"
    assert commonmark(source) == "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 6: Tabs"
    source = ">\t\tfoo\n"
    assert commonmark(source) == "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n"
    assert written_back(source, extended: false)

test "example 7: Tabs"
    source = "-\t\tfoo\n"
    assert commonmark(source) == "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 8: Tabs"
    source = "    foo\n\tbar\n"
    assert commonmark(source) == "<pre><code>foo\nbar\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 9: Tabs"
    source = " - foo\n   - bar\n\t - baz\n"
    assert commonmark(source) == "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 10: Tabs"
    source = "#\tFoo\n"
    assert commonmark(source) == "<h1>Foo</h1>\n"
    assert written_back(source, extended: false)

test "example 11: Tabs"
    source = "*\t*\t*\t\n"
    assert commonmark(source) == "<hr />\n"
    assert written_back(source, extended: false)

test "example 12: Backslash escapes"
    source = "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n"
    assert commonmark(source) == "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n"
    assert written_back(source, extended: false)

test "example 13: Backslash escapes"
    source = "\\\t\\A\\a\\ \\3\\φ\\«\n"
    assert commonmark(source) == "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>\n"
    assert written_back(source, extended: false)

test "example 14: Backslash escapes"
    source = "\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity\n"
    assert commonmark(source) == "<p>*not emphasized*\n&lt;br/&gt; not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url &quot;not a reference&quot;\n&amp;ouml; not a character entity</p>\n"
    assert written_back(source, extended: false)

test "example 15: Backslash escapes"
    source = "\\\\*emphasis*\n"
    assert commonmark(source) == "<p>\\<em>emphasis</em></p>\n"
    assert written_back(source, extended: false)

test "example 16: Backslash escapes"
    source = "foo\\\nbar\n"
    assert commonmark(source) == "<p>foo<br />\nbar</p>\n"
    assert written_back(source, extended: false)

test "example 17: Backslash escapes"
    source = "`` \\[\\` ``\n"
    assert commonmark(source) == "<p><code>\\[\\`</code></p>\n"
    assert written_back(source, extended: false)

test "example 18: Backslash escapes"
    source = "    \\[\\]\n"
    assert commonmark(source) == "<pre><code>\\[\\]\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 19: Backslash escapes"
    source = "~~~\n\\[\\]\n~~~\n"
    assert commonmark(source) == "<pre><code>\\[\\]\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 20: Backslash escapes"
    source = "<https://example.com?find=\\*>\n"
    assert commonmark(source) == "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>\n"
    assert written_back(source, extended: false)

test "example 21: Backslash escapes"
    source = "<a href=\"/bar\\/)\">\n"
    assert commonmark(source) == "<a href=\"/bar\\/)\">\n"
    assert written_back(source, extended: false)

test "example 22: Backslash escapes"
    source = "[foo](/bar\\* \"ti\\*tle\")\n"
    assert commonmark(source) == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 23: Backslash escapes"
    source = "[foo]\n\n[foo]: /bar\\* \"ti\\*tle\"\n"
    assert commonmark(source) == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 24: Backslash escapes"
    source = "``` foo\\+bar\nfoo\n```\n"
    assert commonmark(source) == "<pre><code class=\"language-foo+bar\">foo\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 25: Entity and numeric character references"
    source = "&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n"
    assert commonmark(source) == "<p>  &amp; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>\n"
    assert written_back(source, extended: false)

test "example 26: Entity and numeric character references"
    source = "&#35; &#1234; &#992; &#0;\n"
    assert commonmark(source) == "<p># Ӓ Ϡ �</p>\n"
    assert written_back(source, extended: false)

test "example 27: Entity and numeric character references"
    source = "&#X22; &#XD06; &#xcab;\n"
    assert commonmark(source) == "<p>&quot; ആ ಫ</p>\n"
    assert written_back(source, extended: false)

test "example 28: Entity and numeric character references"
    source = "&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?;\n"
    assert commonmark(source) == "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#abcdef0;\n&amp;ThisIsNotDefined; &amp;hi?;</p>\n"
    assert written_back(source, extended: false)

test "example 29: Entity and numeric character references"
    source = "&copy\n"
    assert commonmark(source) == "<p>&amp;copy</p>\n"
    assert written_back(source, extended: false)

test "example 30: Entity and numeric character references"
