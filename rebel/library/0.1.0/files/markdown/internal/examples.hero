test "example 192: Link reference definitions"
    source = "[foo]: /url \"title\"\n\n[foo]\n"
    assert commonmark(source) == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 193: Link reference definitions"
    source = "   [foo]: \n      /url  \n           'the title'  \n\n[foo]\n"
    assert commonmark(source) == "<p><a href=\"/url\" title=\"the title\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 194: Link reference definitions"
    source = "[Foo*bar\\]]:my_(url) 'title (with parens)'\n\n[Foo*bar\\]]\n"
    assert commonmark(source) == "<p><a href=\"my_(url)\" title=\"title (with parens)\">Foo*bar]</a></p>\n"
    assert written_back(source, extended: false)

test "example 195: Link reference definitions"
    source = "[Foo bar]:\n<my url>\n'title'\n\n[Foo bar]\n"
