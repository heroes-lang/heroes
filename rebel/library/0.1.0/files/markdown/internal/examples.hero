    assert written_back(source, extended: false)

test "example 611: Autolinks"
    source = "https://example.com\n"
    assert commonmark(source) == "<p>https://example.com</p>\n"
    assert written_back(source, extended: false)

test "example 612: Autolinks"
    source = "foo@bar.example.com\n"
    assert commonmark(source) == "<p>foo@bar.example.com</p>\n"
    assert written_back(source, extended: false)

test "example 613: Raw HTML"
    source = "<a><bab><c2c>\n"
    assert commonmark(source) == "<p><a><bab><c2c></p>\n"
    assert written_back(source, extended: false)

test "example 614: Raw HTML"
    source = "<a/><b2/>\n"
    assert commonmark(source) == "<p><a/><b2/></p>\n"
    assert written_back(source, extended: false)

test "example 615: Raw HTML"
    source = "<a  /><b2\ndata=\"foo\" >\n"
    assert commonmark(source) == "<p><a  /><b2\ndata=\"foo\" ></p>\n"
    assert written_back(source, extended: false)

test "example 616: Raw HTML"
    source = "<a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 />\n"
    assert commonmark(source) == "<p><a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 /></p>\n"
    assert written_back(source, extended: false)

test "example 617: Raw HTML"
    source = "Foo <responsive-image src=\"foo.jpg\" />\n"
    assert commonmark(source) == "<p>Foo <responsive-image src=\"foo.jpg\" /></p>\n"
    assert written_back(source, extended: false)

test "example 618: Raw HTML"
    source = "<33> <__>\n"
    assert commonmark(source) == "<p>&lt;33&gt; &lt;__&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 619: Raw HTML"
    source = "<a h*#ref=\"hi\">\n"
    assert commonmark(source) == "<p>&lt;a h*#ref=&quot;hi&quot;&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 620: Raw HTML"
    source = "<a href=\"hi'> <a href=hi'>\n"
    assert commonmark(source) == "<p>&lt;a href=&quot;hi'&gt; &lt;a href=hi'&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 621: Raw HTML"
    source = "< a><\nfoo><bar/ >\n<foo bar=baz\nbim!bop />\n"
    assert commonmark(source) == "<p>&lt; a&gt;&lt;\nfoo&gt;&lt;bar/ &gt;\n&lt;foo bar=baz\nbim!bop /&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 622: Raw HTML"
    source = "<a href='bar'title=title>\n"
    assert commonmark(source) == "<p>&lt;a href='bar'title=title&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 623: Raw HTML"
    source = "</a></foo >\n"
    assert commonmark(source) == "<p></a></foo ></p>\n"
    assert written_back(source, extended: false)

test "example 624: Raw HTML"
    source = "</a href=\"foo\">\n"
    assert commonmark(source) == "<p>&lt;/a href=&quot;foo&quot;&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 625: Raw HTML"
    source = "foo <!-- this is a --\ncomment - with hyphens -->\n"
    assert commonmark(source) == "<p>foo <!-- this is a --\ncomment - with hyphens --></p>\n"
    assert written_back(source, extended: false)

test "example 626: Raw HTML"
    source = "foo <!--> foo -->\n\nfoo <!---> foo -->\n"
    assert commonmark(source) == "<p>foo <!--> foo --&gt;</p>\n<p>foo <!---> foo --&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 627: Raw HTML"
    source = "foo <?php echo $a; ?>\n"
    assert commonmark(source) == "<p>foo <?php echo $a; ?></p>\n"
    assert written_back(source, extended: false)

test "example 628: Raw HTML"
    source = "foo <!ELEMENT br EMPTY>\n"
    assert commonmark(source) == "<p>foo <!ELEMENT br EMPTY></p>\n"
    assert written_back(source, extended: false)

test "example 629: Raw HTML"
    source = "foo <![CDATA[>&<]]>\n"
    assert commonmark(source) == "<p>foo <![CDATA[>&<]]></p>\n"
    assert written_back(source, extended: false)

test "example 630: Raw HTML"
    source = "foo <a href=\"&ouml;\">\n"
    assert commonmark(source) == "<p>foo <a href=\"&ouml;\"></p>\n"
    assert written_back(source, extended: false)

test "example 631: Raw HTML"
    source = "foo <a href=\"\\*\">\n"
    assert commonmark(source) == "<p>foo <a href=\"\\*\"></p>\n"
    assert written_back(source, extended: false)

test "example 632: Raw HTML"
    source = "<a href=\"\\\"\">\n"
    assert commonmark(source) == "<p>&lt;a href=&quot;&quot;&quot;&gt;</p>\n"
    assert written_back(source, extended: false)

test "example 633: Hard line breaks"
    source = "foo  \nbaz\n"
    assert commonmark(source) == "<p>foo<br />\nbaz</p>\n"
    assert written_back(source, extended: false)

test "example 634: Hard line breaks"
    source = "foo\\\nbaz\n"
    assert commonmark(source) == "<p>foo<br />\nbaz</p>\n"
    assert written_back(source, extended: false)

test "example 635: Hard line breaks"
    source = "foo       \nbaz\n"
    assert commonmark(source) == "<p>foo<br />\nbaz</p>\n"
    assert written_back(source, extended: false)

test "example 636: Hard line breaks"
    source = "foo  \n     bar\n"
    assert commonmark(source) == "<p>foo<br />\nbar</p>\n"
    assert written_back(source, extended: false)

test "example 637: Hard line breaks"
    source = "foo\\\n     bar\n"
    assert commonmark(source) == "<p>foo<br />\nbar</p>\n"
    assert written_back(source, extended: false)

test "example 638: Hard line breaks"
    source = "*foo  \nbar*\n"
    assert commonmark(source) == "<p><em>foo<br />\nbar</em></p>\n"
    assert written_back(source, extended: false)

test "example 639: Hard line breaks"
    source = "*foo\\\nbar*\n"
    assert commonmark(source) == "<p><em>foo<br />\nbar</em></p>\n"
    assert written_back(source, extended: false)

test "example 640: Hard line breaks"
    source = "`code  \nspan`\n"
    assert commonmark(source) == "<p><code>code   span</code></p>\n"
    assert written_back(source, extended: false)

test "example 641: Hard line breaks"
    source = "`code\\\nspan`\n"
    assert commonmark(source) == "<p><code>code\\ span</code></p>\n"
    assert written_back(source, extended: false)

test "example 642: Hard line breaks"
    source = "<a href=\"foo  \nbar\">\n"
    assert commonmark(source) == "<p><a href=\"foo  \nbar\"></p>\n"
    assert written_back(source, extended: false)

test "example 643: Hard line breaks"
    source = "<a href=\"foo\\\nbar\">\n"
    assert commonmark(source) == "<p><a href=\"foo\\\nbar\"></p>\n"
    assert written_back(source, extended: false)

test "example 644: Hard line breaks"
    source = "foo\\\n"
    assert commonmark(source) == "<p>foo\\</p>\n"
    assert written_back(source, extended: false)

test "example 645: Hard line breaks"
    source = "foo  \n"
    assert commonmark(source) == "<p>foo</p>\n"
    assert written_back(source, extended: false)

test "example 646: Hard line breaks"
    source = "### foo\\\n"
    assert commonmark(source) == "<h3>foo\\</h3>\n"
    assert written_back(source, extended: false)

test "example 647: Hard line breaks"
    source = "### foo  \n"
    assert commonmark(source) == "<h3>foo</h3>\n"
    assert written_back(source, extended: false)

test "example 648: Soft line breaks"
    source = "foo\nbaz\n"
    assert commonmark(source) == "<p>foo\nbaz</p>\n"
    assert written_back(source, extended: false)

test "example 649: Soft line breaks"
    source = "foo \n baz\n"
    assert commonmark(source) == "<p>foo\nbaz</p>\n"
    assert written_back(source, extended: false)

test "example 650: Textual content"
    source = "hello $.;'there\n"
    assert commonmark(source) == "<p>hello $.;'there</p>\n"
    assert written_back(source, extended: false)

test "example 651: Textual content"
    source = "Foo χρῆν\n"
    assert commonmark(source) == "<p>Foo χρῆν</p>\n"
    assert written_back(source, extended: false)

test "example 652: Textual content"
    source = "Multiple     spaces\n"
    assert commonmark(source) == "<p>Multiple     spaces</p>\n"
    assert written_back(source, extended: false)

test "GFM example 1: Tables (extension)"
    source = "| foo | bar |\n| --- | --- |\n| baz | bim |\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"
    assert written_back(source, extended: true)

test "GFM example 2: Tables (extension)"
    source = "| abc | defghi |\n:-: | -----------:\nbar | baz\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n"
    assert written_back(source, extended: true)

test "GFM example 3: Tables (extension)"
    source = "| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n"
    assert written_back(source, extended: true)

test "GFM example 4: Tables (extension)"
    source = "| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"
    assert written_back(source, extended: true)

test "GFM example 5: Tables (extension)"
    source = "| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n"
    assert written_back(source, extended: true)

test "GFM example 6: Tables (extension)"
    source = "| abc | def |\n| --- |\n| bar |\n"
    assert gfm(source) == "<p>| abc | def |\n| --- |\n| bar |</p>\n"
    assert written_back(source, extended: true)

test "GFM example 7: Tables (extension)"
    source = "| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"
    assert written_back(source, extended: true)

test "GFM example 8: Tables (extension)"
    source = "| abc | def |\n| --- | --- |\n"
    assert gfm(source) == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>\n"
    assert written_back(source, extended: true)

test "GFM example 9: Task list items (extension)"
    source = "- [ ] foo\n- [x] bar\n"
    assert gfm(source) == "<ul>\n<li><input disabled=\"\" type=\"checkbox\"> foo</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> bar</li>\n</ul>\n"
    assert written_back(source, extended: true)

test "GFM example 10: Task list items (extension)"
    source = "- [x] foo\n  - [ ] bar\n  - [x] baz\n- [ ] bim\n"
    assert gfm(source) == "<ul>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> foo\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> bar</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> baz</li>\n</ul>\n</li>\n<li><input disabled=\"\" type=\"checkbox\"> bim</li>\n</ul>\n"
    assert written_back(source, extended: true)

test "GFM example 11: Strikethrough (extension)"
    source = "~~Hi~~ Hello, world!\n"
    assert gfm(source) == "<p><del>Hi</del> Hello, world!</p>\n"
    assert written_back(source, extended: true)

test "GFM example 12: Strikethrough (extension)"
    source = "This ~~has a\n\nnew paragraph~~.\n"
    assert gfm(source) == "<p>This ~~has a</p>\n<p>new paragraph~~.</p>\n"
    assert written_back(source, extended: true)

test "GFM example 13: Autolinks (extension)"
    source = "www.commonmark.org\n"
    assert gfm(source) == "<p><a href=\"http://www.commonmark.org\">www.commonmark.org</a></p>\n"
    assert written_back(source, extended: true)

test "GFM example 14: Autolinks (extension)"
    source = "Visit www.commonmark.org/help for more information.\n"
    assert gfm(source) == "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n"
    assert written_back(source, extended: true)

test "GFM example 15: Autolinks (extension)"
    source = "Visit www.commonmark.org.\n\nVisit www.commonmark.org/a.b.\n"
    assert gfm(source) == "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>Visit <a href=\"http://www.commonmark.org/a.b\">www.commonmark.org/a.b</a>.</p>\n"
    assert written_back(source, extended: true)

test "GFM example 16: Autolinks (extension)"
    source = "www.google.com/search?q=Markup+(business)\n\nwww.google.com/search?q=Markup+(business)))\n\n(www.google.com/search?q=Markup+(business))\n\n(www.google.com/search?q=Markup+(business)\n"
    assert gfm(source) == "<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>)</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n"
    assert written_back(source, extended: true)

test "GFM example 17: Autolinks (extension)"
    source = "www.google.com/search?q=(business))+ok\n"
    assert gfm(source) == "<p><a href=\"http://www.google.com/search?q=(business))+ok\">www.google.com/search?q=(business))+ok</a></p>\n"
    assert written_back(source, extended: true)

test "GFM example 18: Autolinks (extension)"
    source = "www.google.com/search?q=commonmark&hl=en\n\nwww.google.com/search?q=commonmark&hl;\n"
    assert gfm(source) == "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en\">www.google.com/search?q=commonmark&amp;hl=en</a></p>\n<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n"
    assert written_back(source, extended: true)

test "GFM example 19: Autolinks (extension)"
    source = "www.commonmark.org/he<lp\n"
    assert gfm(source) == "<p><a href=\"http://www.commonmark.org/he\">www.commonmark.org/he</a>&lt;lp</p>\n"
    assert written_back(source, extended: true)

test "GFM example 20: Autolinks (extension)"
    source = "http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n\nAnonymous FTP is available at ftp://foo.bar.baz.\n"
    assert gfm(source) == "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n<p>Anonymous FTP is available at <a href=\"ftp://foo.bar.baz\">ftp://foo.bar.baz</a>.</p>\n"
    assert written_back(source, extended: true)

test "GFM example 21: Autolinks (extension)"
    source = "foo@bar.baz\n"
    assert gfm(source) == "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n"
    assert written_back(source, extended: true)

test "GFM example 22: Autolinks (extension)"
    source = "hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n"
    assert gfm(source) == "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n"
    assert written_back(source, extended: true)

test "GFM example 23: Autolinks (extension)"
    source = "a.b-c_d@a.b\n\na.b-c_d@a.b.\n\na.b-c_d@a.b-\n\na.b-c_d@a.b_\n"
    assert gfm(source) == "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a></p>\n<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n<p>a.b-c_d@a.b-</p>\n<p>a.b-c_d@a.b_</p>\n"
    assert written_back(source, extended: true)
