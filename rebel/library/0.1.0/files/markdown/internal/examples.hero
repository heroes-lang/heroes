test "example 80: Setext headings"
    source = "Foo *bar*\n=========\n\nFoo *bar*\n---------\n"
    assert commonmark(source) == "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n"
    assert written_back(source, extended: false)

test "example 81: Setext headings"
    source = "Foo *bar\nbaz*\n====\n"
    assert commonmark(source) == "<h1>Foo <em>bar\nbaz</em></h1>\n"
