    source = "[link](/url 'title \"and\" title')\n"
    assert commonmark(source) == "<p><a href=\"/url\" title=\"title &quot;and&quot; title\">link</a></p>\n"
    assert written_back(source, extended: false)

test "example 510: Links"
    source = "[link](   /uri\n  \"title\"  )\n"
    assert commonmark(source) == "<p><a href=\"/uri\" title=\"title\">link</a></p>\n"
    assert written_back(source, extended: false)

test "example 511: Links"
    source = "[link] (/uri)\n"
    assert commonmark(source) == "<p>[link] (/uri)</p>\n"
    assert written_back(source, extended: false)

test "example 512: Links"
    source = "[link [foo [bar]]](/uri)\n"
    assert commonmark(source) == "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n"
    assert written_back(source, extended: false)

test "example 513: Links"
    source = "[link] bar](/uri)\n"
    assert commonmark(source) == "<p>[link] bar](/uri)</p>\n"
    assert written_back(source, extended: false)

test "example 514: Links"
    source = "[link [bar](/uri)\n"
    assert commonmark(source) == "<p>[link <a href=\"/uri\">bar</a></p>\n"
    assert written_back(source, extended: false)

test "example 515: Links"
    source = "[link \\[bar](/uri)\n"
    assert commonmark(source) == "<p><a href=\"/uri\">link [bar</a></p>\n"
    assert written_back(source, extended: false)

test "example 516: Links"
    source = "[link *foo **bar** `#`*](/uri)\n"
    assert commonmark(source) == "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n"
    assert written_back(source, extended: false)

test "example 517: Links"
    source = "[![moon](moon.jpg)](/uri)\n"
    assert commonmark(source) == "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n"
    assert written_back(source, extended: false)

test "example 518: Links"
    source = "[foo [bar](/uri)](/uri)\n"
    assert commonmark(source) == "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n"
    assert written_back(source, extended: false)

test "example 519: Links"
    source = "[foo *[bar [baz](/uri)](/uri)*](/uri)\n"
    assert commonmark(source) == "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n"
    assert written_back(source, extended: false)

test "example 520: Links"
    source = "![[[foo](uri1)](uri2)](uri3)\n"
    assert commonmark(source) == "<p><img src=\"uri3\" alt=\"[foo](uri2)\" /></p>\n"
    assert written_back(source, extended: false)

test "example 521: Links"
    source = "*[foo*](/uri)\n"
    assert commonmark(source) == "<p>*<a href=\"/uri\">foo*</a></p>\n"
    assert written_back(source, extended: false)

test "example 522: Links"
    source = "[foo *bar](baz*)\n"
    assert commonmark(source) == "<p><a href=\"baz*\">foo *bar</a></p>\n"
    assert written_back(source, extended: false)

