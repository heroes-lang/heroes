test "example 59: Thematic breaks"
    source = "Foo\n---\nbar\n"
    assert commonmark(source) == "<h2>Foo</h2>\n<p>bar</p>\n"
    assert written_back(source, extended: false)

test "example 60: Thematic breaks"
    source = "* Foo\n* * *\n* Bar\n"
    assert commonmark(source) == "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n<ul>\n<li>Bar</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 61: Thematic breaks"
