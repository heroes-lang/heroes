    assert commonmark(source) == "<a href=\"&ouml;&ouml;.html\">\n"
    assert written_back(source, extended: false)

test "example 32: Entity and numeric character references"
    source = "[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\")\n"
    assert commonmark(source) == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 33: Entity and numeric character references"
    source = "[foo]\n\n[foo]: /f&ouml;&ouml; \"f&ouml;&ouml;\"\n"
    assert commonmark(source) == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 34: Entity and numeric character references"
    source = "``` f&ouml;&ouml;\nfoo\n```\n"
    assert commonmark(source) == "<pre><code class=\"language-föö\">foo\n</code></pre>\n"
    assert written_back(source, extended: false)

test "example 35: Entity and numeric character references"
