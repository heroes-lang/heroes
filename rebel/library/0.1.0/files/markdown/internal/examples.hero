    assert commonmark(source) == "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 62: ATX headings"
    source = "# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n"
    assert commonmark(source) == "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n"
    assert written_back(source, extended: false)

test "example 63: ATX headings"
    source = "####### foo\n"
    assert commonmark(source) == "<p>####### foo</p>\n"
    assert written_back(source, extended: false)

test "example 64: ATX headings"
    source = "#5 bolt\n\n#hashtag\n"
    assert commonmark(source) == "<p>#5 bolt</p>\n<p>#hashtag</p>\n"
    assert written_back(source, extended: false)

test "example 65: ATX headings"
    source = "\\## foo\n"
    assert commonmark(source) == "<p>## foo</p>\n"
    assert written_back(source, extended: false)

test "example 66: ATX headings"
