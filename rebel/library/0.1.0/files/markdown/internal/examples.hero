test "example 202: Link reference definitions"
    source = "[foo]: /url\\bar\\*baz \"foo\\\"bar\\baz\"\n\n[foo]\n"
    assert commonmark(source) == "<p><a href=\"/url%5Cbar*baz\" title=\"foo&quot;bar\\baz\">foo</a></p>\n"
    assert written_back(source, extended: false)

test "example 203: Link reference definitions"
