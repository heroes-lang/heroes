test "example 42: Precedence"
    source = "- `one\n- two`\n"
    assert commonmark(source) == "<ul>\n<li>`one</li>\n<li>two`</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 43: Thematic breaks"
