test "example 37: Entity and numeric character references"
    source = "&#42;foo&#42;\n*foo*\n"
    assert commonmark(source) == "<p>*foo*\n<em>foo</em></p>\n"
    assert written_back(source, extended: false)

test "example 38: Entity and numeric character references"
    source = "&#42; foo\n\n* foo\n"
    assert commonmark(source) == "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>\n"
    assert written_back(source, extended: false)

test "example 39: Entity and numeric character references"
    source = "foo&#10;&#10;bar\n"
    assert commonmark(source) == "<p>foo\n\nbar</p>\n"
    assert written_back(source, extended: false)

test "example 40: Entity and numeric character references"
