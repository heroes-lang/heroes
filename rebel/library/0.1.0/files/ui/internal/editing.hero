# Undo and the selection in a text field or a text area (`ui.undo`,
# `ui.select_text` and the rest). The native side asks the system, whose
# text area keeps the person's edits and whose field keeps those made while
# it has the keys; the headless side keeps a text area's texts before each
# edit an input made since the program last set its text, and each
# widget's selection, in its node, by the same rules: the program's text
# and the person's edit leave the caret at the text's end.

use time
use ui
use ui/hero_ui
use ui/internal/check
use ui/internal/desk
use ui/internal/failure
use ui/internal/fixture
use ui/internal/give
use ui/internal/keyboard
use ui/internal/loop
use ui/internal/model
use ui/internal/native

# The node of `widget`, a text field or a text area.
function text_node(app: ui.App, widget: ui.Widget) -> model.Node?
    return check.node_kind(
        app,
        widget: widget,
        kinds: [hero_ui.HERO_UI_TEXT_FIELD, hero_ui.HERO_UI_TEXT_AREA],
        what: "a text field or a text area"
    )

# Undoes, `which` `HERO_UI_UNDO`, or redoes the last edit of `widget`
# (`ui.undo`, `ui.redo`): true where one was there.
function undone(@app: ui.App, widget: ui.Widget, which: i64) -> bool?
    n @= text_node(app, widget: widget)?

    if app.native
        done = hero_ui.undo(app.handle, id: n.id, which: which)

        if done < 0
            return failure.last(f"undoing an edit of widget {n.id}")

        if done == 1
            n.text @ native.read_text(app, id: n.id)?
            model.put(@app.table, n: n)
        return ok(done == 1)

    if which == hero_ui.HERO_UI_UNDO
        if n.undone.len() == 0
            return ok(false)
        n.redone @ n.redone.push(n.text)
        n.text @ n.undone[n.undone.len() - 1]
        n.undone @ n.undone.slice(from: 0, to: n.undone.len() - 1)
    else
        if n.redone.len() == 0
            return ok(false)
        n.undone @ n.undone.push(n.text)
        n.text @ n.redone[n.redone.len() - 1]
        n.redone @ n.redone.slice(from: 0, to: n.redone.len() - 1)
    n.selection_start @ -1
    n.selection_end @ -1
    model.put(@app.table, n: n)
    return ok(true)

# Whether `undone` with `which` would undo or redo an edit of `widget` now
# (`ui.can_undo`, `ui.can_redo`).
function undoable(app: ui.App, widget: ui.Widget, which: i64) -> bool?
    n = text_node(app, widget: widget)?

    if app.native
        can = hero_ui.can_undo(app.handle, id: n.id, which: which)

        if can < 0
            return failure.last(f"asking whether an edit of widget {n.id} can be undone")
        return ok(can == 1)

    if which == hero_ui.HERO_UI_UNDO
        return ok(n.undone.len() > 0)
    return ok(n.redone.len() > 0)

# Fails `invalid` where bytes `start` to `end` of `text` are no part of it
# a selection can be: outside it, upside down, or an end inside a
# character.
function range_ok(text: str, start: i64, end: i64) -> ()?
    if start < 0 || end < start || end > text.len()
        return fail(
            code: failure.INVALID,
            msg: f"a selection from byte {start} to byte {end} of a text of {text.len()} bytes; it lies inside the text, its start at most its end"
        )

    for at in [start, end]
        if at < text.len() && text[at] >= 0x80 && text[at] < 0xc0
            return fail(
                code: failure.INVALID,
                msg: f"byte {at} of the text is inside a character, where no selection ends"
            )

    return ok()

# Selects bytes `start` to `end` of `widget`'s text (`ui.select_text`).
function select_text(@app: ui.App, widget: ui.Widget, start: i64, end: i64) -> ()?
    n @= text_node(app, widget: widget)?

    text = if app.native
        native.read_text(app, id: n.id)?
    else
        n.text

    range_ok(text: text, start: start, end: end)?

    if n.kind == hero_ui.HERO_UI_TEXT_FIELD && !give.reachable(app, id: n.id)
        return fail(code: failure.INVALID, msg: f"text field {n.id} is hidden or greyed out, and shows no selection")

    if app.native
        loop.settle(@app)?

        if hero_ui.set_text_selection(app.handle, id: n.id, start: start, end: end) < 0
            return failure.last(f"selecting the text of widget {n.id}")
    n.selection_start @ start
    n.selection_end @ end
    model.put(@app.table, n: n)

    # A field shows its selection while it has the keys, so it takes them.
    if n.kind == hero_ui.HERO_UI_TEXT_FIELD
        keyboard.focused(@app, window: n.window, id: n.id)
    return ok()

# The selection of `widget`'s text (`ui.text_selection_of`).
function selection_of(app: ui.App, widget: ui.Widget) -> ui.TextRange?
    n = text_node(app, widget: widget)?

    if app.native
        start @= 0
        end @= 0

        if hero_ui.text_selection(app.handle, id: n.id, start: @start, end: @end) < 0
            return failure.last(f"reading the selection of widget {n.id}")
        return ok(ui.TextRange(start: start, end: end))

    if n.selection_start < 0
        return ok(ui.TextRange(start: n.text.len(), end: n.text.len()))
    return ok(ui.TextRange(start: n.selection_start, end: n.selection_end))

## Tests

test "undo: on the headless side a text area's edits undone and redone in order back to the program's text, a new edit ending the redo, a text field keeping none (catalogue CT17)"
    app @= fixture.test_app()
    window = fixture.window_of(app)
    area = ui.text_area(@app, into: window, text: "one").must()
    field = ui.text_field(@app, into: window, text: "f").must()
    assert !ui.can_undo(app, widget: area).must()
    assert !ui.undo(@app, widget: area).must()
    ui.inject(@app, input: .type_text(widget: area, text: "one two")).must()
    ui.inject(@app, input: .type_text(widget: area, text: "one two three")).must()
    ui.inject(@app, input: .type_text(widget: field, text: "g")).must()

    for _ in range(from: 0, to: 3)
        _ = ui.wait(@app, within: time.nanoseconds(0)).must()

    assert ui.can_undo(app, widget: area).must() && !ui.can_redo(app, widget: area).must()
    assert ui.undo(@app, widget: area).must()
    assert ui.text_of(app, widget: area).must() == "one two"
    assert ui.undo(@app, widget: area).must()
    assert ui.text_of(app, widget: area).must() == "one"
    assert !ui.undo(@app, widget: area).must()
    assert ui.redo(@app, widget: area).must()
    assert ui.text_of(app, widget: area).must() == "one two"
    ui.inject(@app, input: .type_text(widget: area, text: "other")).must()
    _ = ui.wait(@app, within: time.nanoseconds(0)).must()
    assert !ui.can_redo(app, widget: area).must()
    assert !ui.can_undo(app, widget: field).must() && !ui.undo(@app, widget: field).must()
    ui.set_text(@app, widget: area, text: "set").must()
    assert !ui.can_undo(app, widget: area).must()
    assert fixture.code_of(ui.undo(@app, widget: window)) == ui.INVALID
    ui.close(@app).must()

test "select_text: on the headless side the caret at the end of the program's text and of an edit, a range set and read, refused outside the text, upside down, inside a character or on a field greyed out (catalogue CT18)"
    app @= fixture.test_app()
    window = fixture.window_of(app)
    area = ui.text_area(@app, into: window, text: "café au lait").must()
    field = ui.text_field(@app, into: window, text: "abc").must()
    assert ui.text_selection_of(app, widget: area).must() == ui.TextRange(start: 13, end: 13)
    ui.select_text(@app, widget: area, start: 0, end: 5).must()
    assert ui.text_selection_of(app, widget: area).must() == ui.TextRange(start: 0, end: 5)
    assert fixture.code_of(ui.select_text(@app, widget: area, start: 0, end: 4)) == ui.INVALID
    assert fixture.code_of(ui.select_text(@app, widget: area, start: 5, end: 2)) == ui.INVALID
    assert fixture.code_of(ui.select_text(@app, widget: area, start: 0, end: 14)) == ui.INVALID
    ui.select_text(@app, widget: field, start: 1, end: 1).must()
    assert ui.text_selection_of(app, widget: field).must() == ui.TextRange(start: 1, end: 1)
    assert ui.focus_of(app, widget: window).must() == field
    ui.inject(@app, input: .type_text(widget: field, text: "abcd")).must()
    _ = ui.wait(@app, within: time.nanoseconds(0)).must()
    assert ui.text_selection_of(app, widget: field).must() == ui.TextRange(start: 4, end: 4)
    ui.set_enabled(@app, widget: field, on: false).must()
    assert fixture.code_of(ui.select_text(@app, widget: field, start: 0, end: 1)) == ui.INVALID
    ui.set_text(@app, widget: area, text: "new").must()
    assert ui.text_selection_of(app, widget: area).must() == ui.TextRange(start: 3, end: 3)
    ui.close(@app).must()

test "undo: on the native side a text area's typed edits undone and redone through its own undo, apart from another area's, the program's text ending it, and nothing told (catalogue CT17)"
    if hero_ui.native_here() == 0
        skip_test(reason: desk.NO_NATIVE)
    app @= ui.open(.native).must()
    window = ui.window(@app, title: "Undo", width: 300, height: 240).must()
    area = ui.text_area(@app, into: window, text: "one").must()
    other = ui.text_area(@app, into: window, text: "x").must()
    asked = ui.can_undo(app, widget: area)
    refusal = fixture.unsupported_words(asked)

    if refusal != ""
        ui.close(@app).must()
        skip_test(reason: refusal)
    assert !asked.must()
    ui.inject(@app, input: .type_text(widget: area, text: "one two")).must()
    ui.inject(@app, input: .type_text(widget: other, text: "y")).must()
    ui.inject(@app, input: .type_text(widget: area, text: "one two three")).must()

    for _ in range(from: 0, to: 3)
        _ = ui.wait(@app, within: time.milliseconds(100).must()).must()

    assert ui.can_undo(app, widget: area).must() && !ui.can_redo(app, widget: area).must()
    assert ui.undo(@app, widget: area).must()
    after_one = ui.text_of(app, widget: area).must()
    assert ui.undo(@app, widget: area).must()
    after_two = ui.text_of(app, widget: area).must()
    still = ui.text_of(app, widget: other).must()
    nothing = ui.wait(@app, within: time.milliseconds(50).must())
    assert ui.redo(@app, widget: area).must()
    redone = ui.text_of(app, widget: area).must()
    ui.set_text(@app, widget: area, text: "set").must()
    after_set = ui.can_undo(app, widget: area).must()
    ui.close(@app).must()
    assert after_one == "one two" && after_two == "one" && redone == "one two"
    assert still == "y"
    assert fixture.code_of(nothing) == ui.TIMEOUT
    assert !after_set

test "select_text: on the native side a text area's range set and read in bytes across a two-byte character, a field's taking the keys, kept once it gives them up, and the program's text putting the caret at its end (catalogue CT18)"
    if hero_ui.native_here() == 0
        skip_test(reason: desk.NO_NATIVE)
    app @= ui.open(.native).must()
    window = ui.window(@app, title: "Select", width: 300, height: 240).must()
    area = ui.text_area(@app, into: window, text: "café au lait").must()
    field = ui.text_field(@app, into: window, text: "abc").must()
    asked = ui.text_selection_of(app, widget: area)
    refusal = fixture.unsupported_words(asked)

    if refusal != ""
        ui.close(@app).must()
        skip_test(reason: refusal)
    first = asked.must()
    ui.select_text(@app, widget: area, start: 3, end: 8).must()
    across = ui.text_selection_of(app, widget: area).must()
    inside = ui.select_text(@app, widget: area, start: 0, end: 4)
    ui.select_text(@app, widget: field, start: 1, end: 2).must()
    in_field = ui.text_selection_of(app, widget: field).must()
    holder = ui.focus_of(app, widget: window).must()
    ui.set_focus(@app, widget: area).must()
    kept = ui.text_selection_of(app, widget: field).must()
    ui.set_text(@app, widget: area, text: "new").must()
    after_set = ui.text_selection_of(app, widget: area).must()
    ui.close(@app).must()
    assert first == ui.TextRange(start: 13, end: 13)
    assert across == ui.TextRange(start: 3, end: 8)
    assert fixture.code_of(inside) == ui.INVALID
    assert in_field == ui.TextRange(start: 1, end: 2) && holder == field
    assert kept == ui.TextRange(start: 1, end: 2)
    assert after_set == ui.TextRange(start: 3, end: 3)
