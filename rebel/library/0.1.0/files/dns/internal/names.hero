# Names: read from text and written back as dig writes them, read from a
# message with its compression pointers bounded, and written to one with
# compression. A name is held as its labels, each a `[u8]`, the root's empty
# label left out.

use dns/internal/failure

# The most compression pointers one name may follow. Each must point before
# the part it continues, which already makes a loop impossible; the bound
# keeps a chain of pointers from costing more than a name can hold.
constant MOST_POINTERS: i64
    127

# The longest a name may be as a message holds it, its lengths and its last
# zero counted (RFC 1035 § 3.1).
constant MOST_BYTES: i64
    255

# The longest a label may be.
constant MOST_LABEL: i64
    63

# A name read from text.
record Parsed
    # Its labels, from the first; none for the root.
    labels: [[u8]]
    # Whether the text ended with a dot, or was the root.
    absolute: bool

# A name read from a message, and the index the reading goes on from.
record Read
    # Its labels, from the first.
    labels: [[u8]]
    # The index just past the name where it stands, its first pointer
    # counted as two bytes.
    next: i64

# The name `s` writes. Fails `invalid` where `s` is "", holds an empty
# label, a label past 63 bytes, an escape cut short or past 255, or comes to
# more than 255 bytes in a message.
function from_text(s: str) -> Parsed?
    if s.len() == 0
        return fail(code: failure.INVALID, msg: "a name is not empty: write `.` for the root")

    if s == "."
        return ok(Parsed(labels: [], absolute: true))
    labels: [[u8]] @= []
    label: [u8] @= []
    absolute: bool @= false
    total: i64 @= 1
    at: i64 @= 0

    while at < s.len()
        c = s[at]

        if c == '.'
            if label.len() == 0
                return fail(code: failure.INVALID, msg: f"\"{s}\": an empty label before byte {at}")
            total @ total + label.len() + 1
            labels @ labels.push(label)
            label @ []

            if at == s.len() - 1
                absolute @ true
            at @ at + 1
        else if c == '\\'
            got = escape_at(s, at: at)?
            label @ label.push(got.byte)
            at @ got.next
        else
            label @ label.push(c)
            at @ at + 1

        if label.len() > MOST_LABEL
            return fail(code: failure.INVALID, msg: f"\"{s}\": a label of more than {MOST_LABEL} bytes")

    if label.len() > 0
        total @ total + label.len() + 1
        labels @ labels.push(label)

    if total > MOST_BYTES
        return fail(
            code: failure.INVALID,
            msg: f"\"{s}\": {total} bytes in a message, past the {MOST_BYTES} a name may take"
        )
    return ok(Parsed(labels: labels, absolute: absolute))

# A byte an escape stands for, and the index past the escape.
record Escaped
    # The byte.
    byte: u8
    # The index just past the escape.
    next: i64

# The byte the escape at `at` of `s` stands for: `\DDD`, three decimal
# digits up to 255, or `\` and any other byte, which stands for itself.
# Fails `invalid` where `s` ends inside it or its number passes 255.
function escape_at(s: str, at: i64) -> Escaped?
    if at + 1 >= s.len()
        return fail(code: failure.INVALID, msg: f"\"{s}\": it ends inside the escape at byte {at}")
    d = s[at + 1]

    if !is_digit(d)
        return ok(Escaped(byte: d, next: at + 2))

    if at + 3 >= s.len() || !is_digit(s[at + 2]) || !is_digit(s[at + 3])
        return fail(code: failure.INVALID, msg: f"\"{s}\": the escape at byte {at} is not three digits")
    value = digit(s[at + 1]) * 100 + digit(s[at + 2]) * 10 + digit(s[at + 3])

    if value > 255
        return fail(code: failure.INVALID, msg: f"\"{s}\": the escape at byte {at} is past 255")
    return ok(Escaped(byte: to_u8(value).must(), next: at + 4))

# Whether `c` is an ASCII digit.
function is_digit(c: u8) -> bool
    return c >= '0' && c <= '9'

# The value of the ASCII digit `c`.
function digit(c: u8) -> i64
    return to_i64(c - '0').must()

# `labels` as an absolute name, its last dot written: `.` for none.
function to_text(labels: [[u8]]) -> str
    if labels.len() == 0
        return "."
    parts: [str] @= []

    for label in labels
        parts @ parts.push(label_text(label))
        parts @ parts.push(".")

    return parts.join("")

# `label` as a name writes it: `. " ( ) ; @ $ \` after a backslash, and a
# space and every byte outside printable ASCII as `\DDD`, as dig writes them.
function label_text(label: [u8]) -> str
    out: [u8] @= []

    for b in label
        if b <= ' ' || b >= 127
            out @ out.push('\\')
            out @ out.push(to_u8(to_i64(b).must() / 100).must() + '0')
            out @ out.push(to_u8(to_i64(b).must() / 10 % 10).must() + '0')
            out @ out.push(to_u8(to_i64(b).must() % 10).must() + '0')
        else
            if b == '.' || b == '"' || b == '(' || b == ')' || b == ';' || b == '@' || b == '$' || b == '\\'
                out @ out.push('\\')
            out @ out.push(b)

    # Every byte above is ASCII, so the text is UTF-8.
    return ascii_text(out)

# The text of `ascii`, bytes the caller made all ASCII.
function ascii_text(ascii: [u8]) -> str
    parts: [str] @= []

    for b in ascii
        parts @ parts.push(character(b))

    return parts.join("")

# The one-character text of the ASCII byte `b`.
function character(b: u8) -> str
    return PRINTABLE.slice(from: to_i64(b - ' ').must(), to: to_i64(b - ' ').must() + 1)

# Every printable ASCII character, from the space, so a byte finds its text by
# its place.
constant PRINTABLE: str
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# `labels` with every ASCII capital in lower case (RFC 4343).
function lowered(labels: [[u8]]) -> [[u8]]
    out: [[u8]] @= []

    for label in labels
        low: [u8] @= []

        for b in label
            if b >= 'A' && b <= 'Z'
                low @ low.push(b + 32)
            else
                low @ low.push(b)

        out @ out.push(low)

    return out

# Whether `name` ends with every label of `of`, without case.
function is_under(name: [[u8]], of: [[u8]]) -> bool
    if of.len() > name.len()
        return false
    low_name = lowered(name)
    low_of = lowered(of)
    skip = name.len() - of.len()
    k: i64 @= 0

    while k < of.len()
        if low_name[skip + k] != low_of[k]
            return false
        k @ k + 1

    return true

# The name of `data` at `at`, its pointers followed. Fails `invalid` where the
# message ends inside it, a label's kind is neither a length nor a pointer, a
# pointer points at or after the part of the name it continues, more than
# `MOST_POINTERS` are followed, or the name passes `MOST_BYTES`.
function read(data: [u8], at: i64) -> Read?
    labels: [[u8]] @= []
    pos: i64 @= at
    next: i64 @= -1
    part: i64 @= at
    pointers: i64 @= 0
    total: i64 @= 1

    while true
        if pos >= data.len()
            return failure.at_byte(at: pos, what: "the message ends inside a name")
        count = to_i64(data[pos]).must()

        if count == 0
            if next < 0
                next @ pos + 1
            return ok(Read(labels: labels, next: next))
        kind = count & 0xc0

        if kind == 0xc0
            if pos + 1 >= data.len()
                return failure.at_byte(at: pos, what: "the message ends inside a compression pointer")
            target = (count & 0x3f) << 8 | to_i64(data[pos + 1]).must()

            if target >= part
                return failure.at_byte(
                    at: pos,
                    what: f"a compression pointer to byte {target}, not before byte {part} where the name's part it continues begins"
                )
            pointers @ pointers + 1

            if pointers > MOST_POINTERS
                return failure.at_byte(at: pos, what: f"a name follows more than {MOST_POINTERS} compression pointers")

            if next < 0
                next @ pos + 2
            part @ target
            pos @ target
        else if kind != 0
            return failure.at_byte(
                at: pos,
                what: f"a label of kind {kind >> 6}, which is neither a length nor a pointer"
            )
        else
            if pos + 1 + count > data.len()
                return failure.at_byte(at: pos, what: f"the message ends inside a label of {count} bytes")
            total @ total + count + 1

            if total > MOST_BYTES
                return failure.at_byte(at: at, what: f"a name of more than {MOST_BYTES} bytes")
            labels @ labels.push(data.slice(from: pos + 1, to: pos + 1 + count))
            pos @ pos + 1 + count

    return failure.at_byte(at: at, what: "a name that never ends")

# The key by which the name made of `labels` from index `from` is found in a
# table of names written: its text, its case kept, so a name compressed reads
# back with the case it was written in, as Go's builder keeps it, where a
# match without case would hand it an earlier name's (RFC 4343 § 4.1).
function key_of(labels: [[u8]], from: i64) -> str
    return to_text(labels.slice(from: from, to: labels.len()))

# Writes `labels` to `out` as a name. With `compress`, the longest end of it
# found in `table` is written as a pointer, and every end written is put in
# `table` at the index it begins, while that index fits a pointer; without
# it, the name is written whole and `table` is left as it is.
function write(@out: [u8], labels: [[u8]], @table: {str: i64}, compress: bool)
    k: i64 @= 0

    while k < labels.len()
        if compress
            key = key_of(labels, from: k)

            match table[key]
                .ok offset =>
                    out @ out.push(to_u8(0xc0 | offset >> 8).must())
                    out @ out.push(to_u8(offset & 255).must())
                    return
                .err _ => _ = 0

            if out.len() < 0x4000
                table[key] @ out.len()
        label = labels[k]
        out @ out.push(to_u8(label.len()).must())

        for b in label
            out @ out.push(b)

        k @ k + 1

    out @ out.push(0)

test "from_text and to_text: escapes read and written as dig writes them, the root, and the last dot"
    p = from_text("a\\.b.x\\032y.q\\\".\\(.\\000.\\195\\169.example").must()
    assert !p.absolute && p.labels.len() == 7
    assert p.labels[0] == [97, 46, 98] && p.labels[1] == [120, 32, 121] && p.labels[4] == [0] && p.labels[5] == [195, 169]
    assert to_text(p.labels) == "a\\.b.x\\032y.q\\\".\\(.\\000.\\195\\169.example."
    assert from_text("example.com.").must().absolute
    root = from_text(".").must()
    assert root.absolute && root.labels.len() == 0 && to_text(root.labels) == "."
    assert to_text(from_text("~!#%^&+=,/:<>?[]{}|`'._srv.*.A-Z").must().labels) == "~!#%^&+=,/:<>?[]{}|`'._srv.*.A-Z."

test "from_text: empty, an empty label at either end or inside, a label of 63 and of 64 bytes, and 255 bytes"
    assert from_text("").is_err() && from_text(".a").is_err() && from_text("a..b").is_err() && from_text("a.b..").is_err()
    assert from_text("a\\").is_err() && from_text("a\\25").is_err() && from_text("a\\256").is_err()
    assert from_text(repeat("a", 63)).must().labels[0].len() == 63
    assert from_text(repeat("a", 64)).is_err()
    four = repeat("a", 63) + "." + repeat("b", 63) + "." + repeat("c", 63) + "." + repeat("d", 61)
    assert from_text(four).must().labels.len() == 4
    assert from_text(four + "d").is_err()

test "read: a name followed through a pointer, and the index past its first pointer"
    data: [u8] = [3, 99, 111, 109, 0, 7, 101, 120, 97, 109, 112, 108, 101, 0xc0, 0]
    got = read(data, at: 5).must()
    assert to_text(got.labels) == "example.com." && got.next == 15
    assert read(data, at: 0).must().next == 5

test "read: a pointer to itself, a pointer forward, a loop of two, a kind that is no length, and a name cut short"
    assert read([0xc0, 0], at: 0).is_err()
    assert read([0xc0, 2, 0], at: 0).is_err()
    loop: [u8] = [1, 97, 0xc0, 4, 1, 98, 0xc0, 0]

    match read(loop, at: 4)
        .ok _  => assert false
        .err e => assert e.code == failure.INVALID && strings_hold(s: e.msg, part: "compression pointer")

    assert read([0x40, 0], at: 0).is_err() && read([0x80, 0], at: 0).is_err()
    assert read([3, 97, 98], at: 0).is_err() && read([0xc0], at: 0).is_err() && read([], at: 0).is_err()

test "read: a chain of 127 pointers is followed, and of 128 refused"
    fixed: [u8] @= [0]
    j: i64 @= 0

    while j < 128
        at = fixed.len()
        target: i64 @= 0

        if j > 0
            target @ at - 2
        fixed @ fixed.push(to_u8(0xc0 | target >> 8).must())
        fixed @ fixed.push(to_u8(target & 255).must())
        j @ j + 1

    assert read(fixed, at: 1 + 2 * 126).must().labels.len() == 0
    assert read(fixed, at: 1 + 2 * 127).is_err()

test "write: a name compressed against an earlier one, an end in another case kept whole, and a name written whole without compression"
    out: [u8] @= []
    table: {str: i64} @= {}
    write(@out, labels: from_text("example.com").must().labels, @table, compress: true)
    write(@out, labels: from_text("mail.example.com").must().labels, @table, compress: true)
    assert out == [7, 101, 120, 97, 109, 112, 108, 101, 3, 99, 111, 109, 0, 4, 109, 97, 105, 108, 0xc0, 0]
    assert to_text(read(out, at: 13).must().labels) == "mail.example.com."
    write(@out, labels: from_text("MX.Example.com").must().labels, @table, compress: true)
    assert out.slice(from: 20, to: out.len()) == [2, 77, 88, 7, 69, 120, 97, 109, 112, 108, 101, 0xc0, 8]
    assert to_text(read(out, at: 20).must().labels) == "MX.Example.com."
    whole: [u8] @= []
    write(@whole, labels: from_text("example.com").must().labels, @table, compress: false)
    assert whole.len() == 13

test "is_under and lowered: a name under another without case, itself, the root, and a longer one"
    a = from_text("www.Example.COM").must().labels
    assert is_under(name: a, of: from_text("example.com").must().labels)
    assert is_under(name: a, of: a) && is_under(name: a, of: [])
    assert !is_under(name: from_text("com").must().labels, of: a)
    assert !is_under(name: from_text("wexample.com").must().labels, of: from_text("example.com").must().labels)

# Whether `s` holds `part`, for the tests' messages.
function strings_hold(s: str, part: str) -> bool
    if part.len() > s.len()
        return false
    k: i64 @= 0

    while k + part.len() <= s.len()
        if s.slice(from: k, to: k + part.len()) == part
            return true
        k @ k + 1

    return false
