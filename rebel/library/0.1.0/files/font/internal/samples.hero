# Two fonts to test with, written as base 64 text. Both are made from Noto Sans
# Regular 2.015 (Copyright 2022 The Noto Project Authors, SIL Open Font
# License 1.1; the licence is in the fonts' own `name` tables and in `font.ledger`),
# on 2026-11-23: `truetype` is the font cut to 29 glyphs by fontTools 4.68.0's
# `pyftsubset` (hinting programs kept, layout tables dropped; Latin, Latin
# Extended-A, Greek and Cyrillic letters, composites among them), and `postscript`
# is those 29 outlines drawn into a CFF font by fontTools' `FontBuilder` with
# `T2CharStringPen`. What the tests expect of them is what fontTools read from
# the same files.

use bytes
use font/internal/bin

# The TrueType sample: 9260 bytes.
function truetype() -> [u8]
    return bytes.parse_base64(TRUETYPE.join("")).must()

# The CFF sample: 3968 bytes.
function postscript() -> [u8]
    return bytes.parse_base64(POSTSCRIPT.join("")).must()

# A collection of two copies of the TrueType sample, as a `.ttc` file: its
# header, then each font with its tables' offsets moved to where the copy
# stands.
function collection() -> [u8]
    one = truetype()
    size = (one.len() + 3) / 4 * 4
    first = 20
    out: [u8] @= bytes.from_text("ttcf")
    bin.put_u32(@out, v: 65536)
    bin.put_u32(@out, v: 2)
    bin.put_u32(@out, v: first)
    bin.put_u32(@out, v: first + size)
    bytes.push_all(to: @out, from: moved(one, by: first))

    while out.len() < first + size
        out @ out.push(0)

    bytes.push_all(to: @out, from: moved(one, by: first + size))
    return out

# `font` with every table's offset in its directory increased by `by`.
function moved(font: [u8], by: i64) -> [u8]
    out: [u8] @= font
    count = bin.u16_at(font, at: 4)

    for k in range(from: 0, to: count)
        at = 12 + 16 * k + 8
        v = bin.u32_at(font, at: at) + by

        for j in range(from: 0, to: 4)
            out[at + j] @ to_u8(v >> 24 - 8 * j & 255).must()

    return out

