# The limits workers share, kept in the store: each a row of
# `rebel_jobs_limits` holding the bucket of `jobs.Bucket`, moved by one
# statement that locks the row, so takers on any number of connections take
# its tokens one after another and never more than it holds. A call reads
# the server's clock, or an instant a test names; either way time never runs
# backwards for a limit, a time earlier than the latest one read being read
# as that one.

use jobs
use jobs/internal/gcra
use jobs/internal/limits
use jobs/internal/taking
use jobs/postgres_store/internal/live
use jobs/postgres_store/internal/statements
use sql
use sql/postgres
use time

# The time a call reads.
variant Clock
    # The server's clock, read as the statement runs.
    server
    # An instant a test names.
    scripted
        # The instant.
        at: time.Instant

# The SQL of `clock`: the server's clock, or the parameter `place`.
#
# - `clock`: the clock.
# - `place`: the number of the parameter a scripted instant goes in.
function clock_sql(clock: Clock, place: i64) -> str
    match clock
        .server     => return statements.LIMIT_CLOCK
        .scripted _ => return f"${place}::bigint"

# `params`, and after them the scripted instant where `clock` is one.
#
# - `params`: the statement's other parameters.
# - `clock`: the clock.
function with_clock(params: [sql.Value], clock: Clock) -> [sql.Value]
    match clock
        .server => return params
        .scripted s =>
            out @= params
            out @ out.push(.integer(v: s.at.unix_nanoseconds))
            return out

# Checks a limit's name as a job's kind is checked.
#
# - `name`: the name.
function check_name(name: str) -> ()?
    return limits.check_name(what: "the limit's name", name: name, empty_allowed: false)

# The message of a name that names no limit.
#
# - `name`: the name.
function missing(name: str) -> str
    return f"no limit is named \"{name}\" in the store; `set_limit` makes one"

# The bucket of a row whose first columns are a limit's time to earn a
# token, its burst, the instant it is empty and the time it was read at.
#
# - `row`: the row.
function bucket_of_row(row: sql.Row) -> jobs.Bucket?
    return ok(
        jobs.Bucket(every: time.nanoseconds(sql.integer_at(row, 0)?), burst: sql.integer_at(row, 1)?, empty_at: time.Instant(unix_nanoseconds: sql.integer_at(row, 2)?), seen: time.Instant(unix_nanoseconds: sql.integer_at(row, 3)?))
    )

# Makes limit `name` full, or changes the one there keeping its tokens.
#
# - `db`: the connection.
# - `name`: the limit's name.
# - `every`: the time to earn one token.
# - `burst`: the most tokens it holds.
# - `clock`: the time read.
#
# Fails `invalid` as `jobs.bucket` does and where the name is not one a
# store keeps, and `does_not_fit` where the debt kept at the new rate
# reaches past what an `Instant` holds, the limit unchanged.
function set(@db: postgres.Db, name: str, every: time.Duration, burst: i64, clock: Clock) -> jobs.Bucket?
    check_name(name)?
    _ = jobs.bucket(every: every, burst: burst, at: time.Instant(unix_nanoseconds: 0))?
    params = with_clock([.text(v: name), .integer(v: every.nanoseconds), .integer(v: burst)], clock: clock)
    found = postgres.query(@db, statements.set_limit(clock_sql(clock, place: 4)), params)?

    if found.rows.len() == 0
        return fail(
            code: jobs.DOES_NOT_FIT,
            msg: f"the debt of the limit \"{name}\" at a token every {time.format_duration(every)} reaches past what an instant holds; the limit is unchanged"
        )
    return bucket_of_row(found.rows[0])

# Takes `n` tokens of limit `name` where they are all earned within
# `longest`, and says what it found in either case.
#
# - `db`: the connection.
# - `name`: the limit's name.
# - `n`: how many tokens, 1 or more.
# - `longest`: the longest wait for them; nothing means they must be there.
# - `clock`: the time read.
#
# Fails `invalid` where `n` is below 1 or the name is not one a store
# keeps, and `not_found` where no limit has that name.
function take(@db: postgres.Db, name: str, n: i64, longest: time.Duration, clock: Clock) -> taking.Taken?
    check_name(name)?

    if n < 1
        return fail(code: jobs.INVALID, msg: f"{n} tokens asked: at least one")
    params = with_clock([.text(v: name), .integer(v: n), .integer(v: longest.nanoseconds)], clock: clock)
    found = postgres.query(@db, statements.take(clock_sql(clock, place: 4)), params)?

    if found.rows.len() == 0
        return fail(code: jobs.NOT_FOUND, msg: missing(name))
    row = found.rows[0]
    every = time.nanoseconds(sql.integer_at(row, 0)?)
    burst = sql.integer_at(row, 1)?
    at = time.Instant(unix_nanoseconds: sql.integer_at(row, 3)?)
    finish = time.Instant(unix_nanoseconds: sql.integer_at(row, 4)?)
    granted = sql.boolean_at(row, 6)?

    if granted && sql.integer_at(row, 7)? != 1
        return fail(code: jobs.NOT_FOUND, msg: f"the limit \"{name}\" was removed while its tokens were taken")

    delay = if time.is_after(a: finish, b: at)
        time.between(from: at, to: finish)?
    else
        time.Duration(nanoseconds: 0)

    empty_at = if granted
        finish
    else
        time.Instant(unix_nanoseconds: sql.integer_at(row, 2)?)
    return ok(
        taking.Taken(granted: granted, bucket: jobs.Bucket(every: every, burst: burst, empty_at: empty_at, seen: at), tokens: n, fits: sql.boolean_at(row, 5)?, finish: finish, delay: delay)
    )

# Gives reservation `taken` of limit `name` back, as far as no later taking
# used it and not once it is ready.
#
# - `db`: the connection.
# - `name`: the limit's name.
# - `taken`: the reservation.
# - `clock`: the time read.
#
# Fails `invalid` where the reservation holds no token or the name is not one
# a store keeps, and `not_found` where no limit has that name.
function give_back(@db: postgres.Db, name: str, taken: jobs.Reservation, clock: Clock) -> jobs.Bucket?
    check_name(name)?

    if taken.tokens < 1
        return fail(code: jobs.INVALID, msg: f"a reservation of {taken.tokens} tokens: at least one")
    params = with_clock(
        [.text(v: name), .integer(v: taken.tokens), .integer(v: taken.ready.unix_nanoseconds), .integer(v: taken.finish.unix_nanoseconds)],
        clock: clock
    )
    found = postgres.query(@db, statements.give_back(clock_sql(clock, place: 5)), params)?

    if found.rows.len() == 0
        return fail(code: jobs.NOT_FOUND, msg: missing(name))
    return bucket_of_row(found.rows[0])

# Limit `name` as it stands at the time read.
#
# - `db`: the connection.
# - `name`: the limit's name.
# - `clock`: the time read.
#
# Fails `invalid` where the name is not one a store keeps and `not_found`
# where no limit has it.
function read(@db: postgres.Db, name: str, clock: Clock) -> jobs.Bucket?
    check_name(name)?
    found = postgres.query(@db, statements.limit_named(clock_sql(clock, place: 2)), with_clock([.text(v: name)], clock: clock))?

    if found.rows.len() == 0
        return fail(code: jobs.NOT_FOUND, msg: missing(name))
    return bucket_of_row(found.rows[0])

# Removes limit `name`.
#
# - `db`: the connection.
# - `name`: the limit's name.
#
# Fails `invalid` where the name is not one a store keeps and `not_found`
# where no limit has it.
function remove(@db: postgres.Db, name: str) -> ()?
    check_name(name)?
    r = postgres.exec(@db, statements.REMOVE_LIMIT, [.text(v: name)])?

    if r.rows_affected == 0
        return fail(code: jobs.NOT_FOUND, msg: missing(name))
    return ok()

# The scripted clock `ms` milliseconds after the tests' origin.
#
# - `ms`: milliseconds, negative before it.
function at_ms(ms: i64) -> Clock
    return .scripted(at: gcra.at_ms(ms))

# `n` tokens of limit `name` taken at `ms` with no wait, as `allowed` reads them.
#
# - `db`: the connection.
# - `name`: the limit.
# - `n`: how many tokens.
# - `ms`: the time.
function allow_at(@db: postgres.Db, name: str, n: i64, ms: i64) -> jobs.Allowed?
    return taking.allowed(take(@db, name: name, n: n, longest: time.Duration(nanoseconds: 0), clock: at_ms(ms))?)

# `n` tokens of limit `name` reserved at `ms` with no bound on the wait.
#
# - `db`: the connection.
# - `name`: the limit.
# - `n`: how many tokens.
# - `ms`: the time.
function reserve_at(@db: postgres.Db, name: str, n: i64, ms: i64) -> jobs.Reservation?
    return taking.reserved(
        take(@db, name: name, n: n, longest: time.max_duration(), clock: at_ms(ms))?,
        within: time.max_duration()
    )

# The tokens limit `name` holds at `ms`, read from the store.
#
# - `db`: the connection.
# - `name`: the limit.
# - `ms`: the time.
function tokens_at(@db: postgres.Db, name: str, ms: i64) -> f64
    held = read(@db, name: name, clock: at_ms(ms)).must()
    return jobs.tokens(limit: held, at: held.seen)

# A row of `gcra.change_rows` as the store answers it: a limit `name` of a
# token every `row[0]` nanoseconds and a burst of `row[1]`, set at the
# origin, `row[2]` tokens reserved there, changed `row[3]` nanoseconds later
# to a token every `row[4]` nanoseconds and a burst of `row[5]`; answers the
# row's six numbers and the instant the store leaves the limit empty at, in
# nanoseconds after the origin.
#
# - `db`: the connection.
# - `name`: the limit's name, one no other row takes.
# - `row`: the six numbers, and any after them.
function changed(@db: postgres.Db, name: str, row: [i64]) -> [i64]?
    _ = set(@db, name: name, every: time.nanoseconds(row[0]), burst: row[1], clock: at_ms(0))?
    left @= row[2]

    while left > 0
        n = if left < row[1]
            left
        else
            row[1]
        _ = reserve_at(@db, name: name, n: n, ms: 0)?
        left @ left - n

    at = time.add(t: gcra.origin(), d: time.nanoseconds(row[3]))?
    after = set(@db, name: name, every: time.nanoseconds(row[4]), burst: row[5], clock: .scripted(at: at))?
    return ok(row.slice(from: 0, to: 6).push(time.between(from: gcra.origin(), to: after.empty_at)?.nanoseconds))

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function bucket_code(r: jobs.Bucket?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function reserve_code(r: jobs.Reservation?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function taken_code(r: taking.Taken?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

test "the refusals: a name empty, with a zero byte or too long, no token, no limit of the name, a rate no bucket has, and tokens earned past what an instant holds, the limit unchanged"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            second = time.seconds(1).must()
            none = time.Duration(nanoseconds: 0)
            _ = set(@db, name: "real", every: second, burst: 2, clock: at_ms(0)).must()
            given = reserve_at(@db, name: "real", n: 1, ms: 0).must()

            zero: [u8] = [97, 0, 98]

            for bad in ["", zero.validated_bytes().must(), repeat("x", 257)]
                assert bucket_code(set(@db, name: bad, every: second, burst: 1, clock: at_ms(0))) == jobs.INVALID
                assert taken_code(take(@db, name: bad, n: 1, longest: none, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(give_back(@db, name: bad, taken: given, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(read(@db, name: bad, clock: at_ms(0))) == jobs.INVALID
                assert remove(@db, name: bad).is_err()

            for n in [0, -1]
                assert taken_code(take(@db, name: "real", n: n, longest: none, clock: at_ms(0))) == jobs.INVALID

            assert reserve_code(reserve_at(@db, name: "real", n: 3, ms: 0)) == jobs.INVALID
            assert !allow_at(@db, name: "real", n: 3, ms: 0).must().granted
            assert taken_code(take(@db, name: "absent", n: 1, longest: none, clock: at_ms(0))) == jobs.NOT_FOUND
            assert bucket_code(give_back(@db, name: "absent", taken: given, clock: at_ms(0))) == jobs.NOT_FOUND
            assert bucket_code(read(@db, name: "absent", clock: at_ms(0))) == jobs.NOT_FOUND

            match remove(@db, name: "absent")
                .ok _  => assert false
                .err e => assert e.code == jobs.NOT_FOUND

            for rate in [none, time.Duration(nanoseconds: -1)]
                assert bucket_code(set(@db, name: "real", every: rate, burst: 1, clock: at_ms(0))) == jobs.INVALID

            assert bucket_code(set(@db, name: "real", every: second, burst: 0, clock: at_ms(0))) == jobs.INVALID
            assert bucket_code(set(@db, name: "real", every: time.days(365).must(), burst: 100, clock: at_ms(0))) == jobs.INVALID
            assert read(@db, name: "real", clock: at_ms(0)).must().burst == 2
            far = time.nanoseconds(1_000_000_000_000_000_000)
            _ = set(@db, name: "far", every: far, burst: 1, clock: at_ms(0)).must()

            for _ in range(from: 0, to: 8)
                _ = reserve_at(@db, name: "far", n: 1, ms: 0).must()

            before = read(@db, name: "far", clock: at_ms(0)).must()
            assert reserve_code(reserve_at(@db, name: "far", n: 1, ms: 0)) == jobs.DOES_NOT_FIT
            assert allow_at(@db, name: "far", n: 1, ms: 0).is_err()
            assert bucket_code(set(@db, name: "far", every: time.nanoseconds(2_305_843_009_213_693_952), burst: 1, clock: at_ms(0))) == jobs.DOES_NOT_FIT
            assert read(@db, name: "far", clock: at_ms(0)).must() == before
            remove(@db, name: "far").must()
            assert bucket_code(read(@db, name: "far", clock: at_ms(0))) == jobs.NOT_FOUND
            postgres.close(@db).must()

test "take: a burst of three at one a second, as golang.org/x/time/rate v0.14.0 answers AllowN at the same times"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            _ = set(@db, name: "crawl", every: time.seconds(1).must(), burst: 3, clock: at_ms(0)).must()
            answers: [bool] @= []

            for ms in [0, 0, 0, 0, 1000, 1500, 2000]
                answers @ answers.push(allow_at(@db, name: "crawl", n: 1, ms: ms).must().granted)

            assert answers == [true, true, true, false, true, false, true]
            assert gcra.close(a: tokens_at(@db, name: "crawl", ms: 2000), b: 0.0) && gcra.close(a: tokens_at(@db, name: "crawl", ms: 2500), b: 0.5)
            assert gcra.close(a: tokens_at(@db, name: "crawl", ms: 3000), b: 1.0) && gcra.close(a: tokens_at(@db, name: "crawl", ms: 9000), b: 3.0)
            postgres.close(@db).must()

test "take: reservations queue behind one another, a later one waits its turn, as x/time/rate v0.14.0's ReserveN delays them"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            _ = set(@db, name: "api", every: time.milliseconds(500).must(), burst: 2, clock: at_ms(0)).must()
            delays: [i64] @= []

            for n in [2, 1, 1]
                delays @ delays.push(
                    time.to_units(reserve_at(@db, name: "api", n: n, ms: 0).must().delay, .millisecond)
                )

            assert delays == [0, 500, 1000]
            later = reserve_at(@db, name: "api", n: 1, ms: 1000).must()
            assert time.to_units(later.delay, .millisecond) == 500 && later.ready == gcra.at_ms(1500)
            assert gcra.close(a: tokens_at(@db, name: "api", ms: 1000), b: -1.0)
            postgres.close(@db).must()

test "give_back: a reservation given back, as far as no later one used it, and not once its time has come, as x/time/rate v0.14.0's CancelAt does"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            _ = set(@db, name: "slow", every: time.milliseconds(500).must(), burst: 2, clock: at_ms(0)).must()

            for n in [2, 1, 1]
                _ = reserve_at(@db, name: "slow", n: n, ms: 0).must()

            r5 = reserve_at(@db, name: "slow", n: 1, ms: 1000).must()
            assert gcra.close(a: tokens_at(@db, name: "slow", ms: 1000), b: -1.0)
            _ = give_back(@db, name: "slow", taken: r5, clock: at_ms(1000)).must()
            assert gcra.close(a: tokens_at(@db, name: "slow", ms: 1000), b: 0.0)
            _ = set(@db, name: "fast", every: time.milliseconds(250).must(), burst: 4, clock: at_ms(0)).must()
            whole = reserve_at(@db, name: "fast", n: 4, ms: 0).must()
            assert time.to_units(whole.delay, .millisecond) == 0 && gcra.close(a: tokens_at(@db, name: "fast", ms: 0), b: 0.0)
            _ = give_back(@db, name: "fast", taken: whole, clock: at_ms(0)).must()
            assert gcra.close(a: tokens_at(@db, name: "fast", ms: 0), b: 4.0)
            _ = reserve_at(@db, name: "fast", n: 4, ms: 0).must()
            two = reserve_at(@db, name: "fast", n: 2, ms: 0).must()
            assert time.to_units(two.delay, .millisecond) == 500 && gcra.close(a: tokens_at(@db, name: "fast", ms: 0), b: -2.0)
            _ = give_back(@db, name: "fast", taken: two, clock: at_ms(400)).must()
            assert gcra.close(a: tokens_at(@db, name: "fast", ms: 400), b: 1.6)
            one = reserve_at(@db, name: "fast", n: 1, ms: 400).must()
            assert time.to_units(one.delay, .millisecond) == 0
            _ = give_back(@db, name: "fast", taken: one, clock: at_ms(700)).must()
            assert gcra.close(a: tokens_at(@db, name: "fast", ms: 700), b: 1.8)
            postgres.close(@db).must()

test "set: the tokens held kept across a new rate and burst, and a debt kept, as x/time/rate v0.14.0's SetLimitAt and SetBurstAt do"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            _ = set(@db, name: "feed", every: time.seconds(1).must(), burst: 4, clock: at_ms(0)).must()
            assert allow_at(@db, name: "feed", n: 4, ms: 0).must().granted
            assert gcra.close(a: tokens_at(@db, name: "feed", ms: 2000), b: 2.0)
            _ = set(@db, name: "feed", every: time.milliseconds(500).must(), burst: 4, clock: at_ms(2000)).must()
            assert gcra.close(a: tokens_at(@db, name: "feed", ms: 2000), b: 2.0) && gcra.close(a: tokens_at(@db, name: "feed", ms: 3000), b: 4.0)
            _ = set(@db, name: "feed", every: time.milliseconds(500).must(), burst: 2, clock: at_ms(3000)).must()
            assert gcra.close(a: tokens_at(@db, name: "feed", ms: 3000), b: 2.0) && gcra.close(a: tokens_at(@db, name: "feed", ms: 3500), b: 2.0)
            _ = set(@db, name: "debt", every: time.seconds(1).must(), burst: 2, clock: at_ms(0)).must()
            _ = reserve_at(@db, name: "debt", n: 2, ms: 0).must()
            _ = reserve_at(@db, name: "debt", n: 2, ms: 0).must()
            assert gcra.close(a: tokens_at(@db, name: "debt", ms: 0), b: -2.0) && gcra.close(a: tokens_at(@db, name: "debt", ms: 3000), b: 1.0)
            assert gcra.close(a: tokens_at(@db, name: "debt", ms: 4000), b: 2.0)
            _ = set(@db, name: "debt", every: time.seconds(2).must(), burst: 2, clock: at_ms(1000)).must()
            assert gcra.close(a: tokens_at(@db, name: "debt", ms: 1000), b: -1.0)
            assert time.to_units(reserve_at(@db, name: "debt", n: 1, ms: 1000).must().delay, .millisecond) == 4000
            postgres.close(@db).must()

test "take: time named earlier than an earlier call is read at that call's time, and a wait past the one allowed takes nothing, as x/time/rate v0.14.0 answers"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            _ = set(@db, name: "late", every: time.seconds(1).must(), burst: 2, clock: at_ms(0)).must()
            assert allow_at(@db, name: "late", n: 2, ms: 5000).must().granted
            assert !allow_at(@db, name: "late", n: 1, ms: 0).must().granted
            assert gcra.close(a: tokens_at(@db, name: "late", ms: 0), b: 0.0)
            _ = set(@db, name: "one", every: time.seconds(1).must(), burst: 1, clock: at_ms(0)).must()
            assert allow_at(@db, name: "one", n: 1, ms: 0).must().granted
            half = time.milliseconds(500).must()
            assert reserve_code(taking.reserved(take(@db, name: "one", n: 1, longest: half, clock: at_ms(0)).must(), within: half)) == jobs.TIMEOUT
            assert gcra.close(a: tokens_at(@db, name: "one", ms: 0), b: 0.0)
            second = time.seconds(1).must()
            waited = taking.reserved(
                take(@db, name: "one", n: 1, longest: second, clock: at_ms(0)).must(),
                within: second
            ).must()
            assert time.to_units(waited.delay, .millisecond) == 1000 && gcra.close(a: tokens_at(@db, name: "one", ms: 0), b: -1.0)
            _ = give_back(@db, name: "one", taken: waited, clock: at_ms(0)).must()
            assert gcra.close(a: tokens_at(@db, name: "one", ms: 0), b: 0.0)
            postgres.close(@db).must()

test "set: every row of a change of rate jobs.with_rate is tested on, rates of 1 ns to 2^61 ns, at 2^53 and past it, a limit full, half full, empty and in debt, a tie and a near tie, each to the nanosecond as Python 3's integers answer"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            db @= first
            rows = gcra.change_rows()

            for i in range(from: 0, to: rows.len())
                assert changed(@db, name: f"shape{i}", row: rows[i]).must() == rows[i]

            postgres.close(@db).must()
