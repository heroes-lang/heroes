# The limits workers share, kept in Redis: each a hash under the key
# `key_of` names, holding the bucket of `jobs.Bucket` in nanoseconds, moved
# by a script of `limit_scripts` the server runs whole, so takers on any
# number of connections take its tokens one after another and never more
# than it holds. A call reads the server's `TIME`, or an instant a test
# names; either way time never runs backwards for a limit, a time earlier
# than the latest one read being read as that one.

use jobs
use jobs/internal/gcra
use jobs/internal/limits
use jobs/internal/taking
use jobs/redis_store
use jobs/redis_store/internal/limit_scripts
use jobs/redis_store/internal/live
use jobs/redis_store/internal/replies
use redis
use time

# The time a call reads.
variant Clock
    # The server's `TIME`, read as the script runs.
    server
    # An instant a test names.
    scripted
        # The instant.
        at: time.Instant

# The key of the limit `name`: the store's prefix, `limit:` and the name as
# it is, byte for byte, so two names are two keys, and no key the store
# keeps of a job, a queue or a schedule begins with `limit:`.
#
# - `name`: the limit's name, checked by `check_name`.
function key_of(name: str) -> str
    return redis_store.PREFIX + "limit:" + name

# The word a script reads its clock from: `server`, or the instant in
# nanoseconds.
#
# - `clock`: the clock.
function clock_word(clock: Clock) -> str
    match clock
        .server     => return "server"
        .scripted s => return to_str(s.at.unix_nanoseconds)

# Checks a limit's name as a job's kind is checked.
#
# - `name`: the name.
function check_name(name: str) -> ()?
    return limits.check_name(what: "the limit's name", name: name, empty_allowed: false)

# The message of a name that names no limit.
#
# - `name`: the name.
function missing(name: str) -> str
    return f"no limit is named \"{name}\" in the store; `set_limit` makes one"

# Runs `script` on the limit `name` with `given`, and answers the words of
# its reply where its first is `ok` or `nofit`.
#
# - `c`: the client.
# - `script`: the script, one of `limit_scripts`'s.
# - `name`: the limit's name, already checked.
# - `given`: the script's arguments after the key.
#
# Fails `not_found` where no limit has that name, `invalid` where its key
# holds something the store did not write as a limit, and as `redis.call`
# fails.
function run(@c: redis.Client, script: str, name: str, given: [str]) -> [str]?
    words: [str] @= ["EVAL", script, "1", key_of(name)]

    for a in given
        words @ words.push(a)

    items = redis.texts_of(redis.call(@c, words)?)?
    first = replies.word_at(items, 0)?

    if first == "missing"
        return fail(code: jobs.NOT_FOUND, msg: missing(name))

    if first == "bad"
        return fail(
            code: jobs.INVALID,
            msg: f"the key \"{key_of(name)}\" holds a hash the store did not write as a limit; `remove_limit` removes it"
        )
    return ok(items)

# The bucket the words `items` of a script's reply write after `ok`: its
# time to earn a token, its burst, the instant it is empty and the time read.
#
# - `items`: the reply's words.
function bucket_of(items: [str]) -> jobs.Bucket?
    return ok(
        jobs.Bucket(every: time.nanoseconds(replies.whole(replies.word_at(items, 1)?)?), burst: replies.whole(replies.word_at(items, 2)?)?, empty_at: time.Instant(unix_nanoseconds: replies.whole(replies.word_at(items, 3)?)?), seen: time.Instant(unix_nanoseconds: replies.whole(replies.word_at(items, 4)?)?))
    )

# Makes limit `name` full, or changes the one there keeping its tokens.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `every`: the time to earn one token.
# - `burst`: the most tokens it holds.
# - `clock`: the time read.
#
# Fails `invalid` as `jobs.bucket` does and where the name is not one a
# store keeps, and `does_not_fit` where the debt kept at the new rate
# reaches past what an `Instant` holds, the limit unchanged.
function set(@c: redis.Client, name: str, every: time.Duration, burst: i64, clock: Clock) -> jobs.Bucket?
    check_name(name)?
    _ = jobs.bucket(every: every, burst: burst, at: time.Instant(unix_nanoseconds: 0))?
    items = run(@c, script: limit_scripts.set(), name: name, given: [to_str(every.nanoseconds), to_str(burst), clock_word(clock)])?

    if items[0] == "nofit"
        return fail(
            code: jobs.DOES_NOT_FIT,
            msg: f"the debt of the limit \"{name}\" at a token every {time.format_duration(every)} reaches past what an instant holds; the limit is unchanged"
        )
    return bucket_of(items)

# Takes `n` tokens of limit `name` where they are all earned within
# `longest`, and says what it found in either case.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `n`: how many tokens, 1 or more.
# - `longest`: the longest wait for them; nothing means they must be there.
# - `clock`: the time read.
#
# Fails `invalid` where `n` is below 1 or the name is not one a store
# keeps, and `not_found` where no limit has that name.
function take(@c: redis.Client, name: str, n: i64, longest: time.Duration, clock: Clock) -> taking.Taken?
    check_name(name)?

    if n < 1
        return fail(code: jobs.INVALID, msg: f"{n} tokens asked: at least one")
    items = run(@c, script: limit_scripts.take(), name: name, given: [to_str(n), to_str(longest.nanoseconds), clock_word(clock)])?
    found = bucket_of(items)?
    at = found.seen
    finish = time.Instant(unix_nanoseconds: replies.whole(replies.word_at(items, 5)?)?)
    granted = replies.word_at(items, 7)? == "1"

    delay = if time.is_after(a: finish, b: at)
        time.between(from: at, to: finish)?
    else
        time.Duration(nanoseconds: 0)

    empty_at = if granted
        finish
    else
        found.empty_at
    return ok(
        taking.Taken(granted: granted, bucket: jobs.Bucket(every: found.every, burst: found.burst, empty_at: empty_at, seen: at), tokens: n, fits: replies.word_at(items, 6)? == "1", finish: finish, delay: delay)
    )

# Gives reservation `taken` of limit `name` back, as far as no later taking
# used it and not once it is ready.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `taken`: the reservation.
# - `clock`: the time read.
#
# Fails `invalid` where the reservation holds no token or the name is not one
# a store keeps, `not_found` where no limit has that name, and
# `does_not_fit` where the limit would be empty at an instant past what an
# `Instant` holds, the limit unchanged.
function give_back(@c: redis.Client, name: str, taken: jobs.Reservation, clock: Clock) -> jobs.Bucket?
    check_name(name)?

    if taken.tokens < 1
        return fail(code: jobs.INVALID, msg: f"a reservation of {taken.tokens} tokens: at least one")
    items = run(@c, script: limit_scripts.give_back(), name: name, given: [to_str(taken.tokens), to_str(taken.ready.unix_nanoseconds), to_str(taken.finish.unix_nanoseconds), clock_word(clock)])?

    if items[0] == "nofit"
        return fail(
            code: jobs.DOES_NOT_FIT,
            msg: f"a reservation of {taken.tokens} tokens given back to the limit \"{name}\" leaves it empty past what an instant holds; the limit is unchanged"
        )
    return bucket_of(items)

# Limit `name` as it stands at the time read.
#
# - `c`: the client.
# - `name`: the limit's name.
# - `clock`: the time read.
#
# Fails `invalid` where the name is not one a store keeps and `not_found`
# where no limit has it.
function read(@c: redis.Client, name: str, clock: Clock) -> jobs.Bucket?
    check_name(name)?
    return bucket_of(run(@c, script: limit_scripts.read(), name: name, given: [clock_word(clock)])?)

# Removes limit `name`.
#
# - `c`: the client.
# - `name`: the limit's name.
#
# Fails `invalid` where the name is not one a store keeps and `not_found`
# where no limit has it.
function remove(@c: redis.Client, name: str) -> ()?
    check_name(name)?

    if redis.int_of(redis.call(@c, ["DEL", key_of(name)])?)? == 0
        return fail(code: jobs.NOT_FOUND, msg: missing(name))
    return ok()

# The scripted clock `ms` milliseconds after the tests' origin.
#
# - `ms`: milliseconds, negative before it.
function at_ms(ms: i64) -> Clock
    return .scripted(at: gcra.at_ms(ms))

# `n` tokens of limit `name` taken at `ms` with no wait, as `taking.allowed` reads them.
#
# - `c`: the client.
# - `name`: the limit.
# - `n`: how many tokens.
# - `ms`: the time.
function allow_at(@c: redis.Client, name: str, n: i64, ms: i64) -> jobs.Allowed?
    return taking.allowed(take(@c, name: name, n: n, longest: time.Duration(nanoseconds: 0), clock: at_ms(ms))?)

# `n` tokens of limit `name` reserved at `ms` with no bound on the wait.
#
# - `c`: the client.
# - `name`: the limit.
# - `n`: how many tokens.
# - `ms`: the time.
function reserve_at(@c: redis.Client, name: str, n: i64, ms: i64) -> jobs.Reservation?
    return taking.reserved(
        take(@c, name: name, n: n, longest: time.max_duration(), clock: at_ms(ms))?,
        within: time.max_duration()
    )

# The tokens limit `name` holds at `ms`, read from the store.
#
# - `c`: the client.
# - `name`: the limit.
# - `ms`: the time.
function tokens_at(@c: redis.Client, name: str, ms: i64) -> f64
    held = read(@c, name: name, clock: at_ms(ms)).must()
    return jobs.tokens(limit: held, at: held.seen)

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function bucket_code(r: jobs.Bucket?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function reserve_code(r: jobs.Reservation?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function taken_code(r: taking.Taken?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function allowed_code(r: jobs.Allowed?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

# A row of `gcra.change_rows` as the store answers it: a limit `name` of a
# token every `row[0]` nanoseconds and a burst of `row[1]`, set at the
# origin, `row[2]` tokens reserved there, changed `row[3]` nanoseconds later
# to a token every `row[4]` nanoseconds and a burst of `row[5]`; answers the
# row's six numbers and the instant the store leaves the limit empty at, in
# nanoseconds after the origin. What the row reserves, when it changes and
# what it answers are `gcra`'s, one copy with `gcra.reshaped`, the bucket
# kept in memory; the calls are this store's own.
#
# - `c`: the client.
# - `name`: the limit's name, one no other row takes.
# - `row`: the six numbers, and any after them.
function changed(@c: redis.Client, name: str, row: [i64]) -> [i64]?
    _ = set(@c, name: name, every: time.nanoseconds(row[0]), burst: row[1], clock: at_ms(0))?

    for n in gcra.change_reservations(row)?
        _ = reserve_at(@c, name: name, n: n, ms: 0)?

    after = set(@c, name: name, every: time.nanoseconds(row[4]), burst: row[5], clock: .scripted(at: gcra.change_at(row)?))?
    return gcra.change_answer(row, after: after)

# The code `r` failed with, or `ok`.
#
# - `r`: the answer.
function done_code(r: ()?) -> str
    match r
        .ok _  => return "ok"
        .err e => return e.code

test "the prelude's whole numbers: sums, differences, products and quotients past 2^53 and past an i64, as Python 3's integers answer them"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            body = [
                "local out = {}"
                "for i = 1, #ARGV, 2 do"
                "  local a, b = int(ARGV[i]), int(ARGV[i + 1])"
                "  local q, r = quotient(a, b)"
                "  out[#out + 1] = text(plus(a, b)) .. ' ' .. text(minus(a, b)) .. ' ' .. text(times(a, b)) .. ' ' .. cmp(a, b) .. ' ' .. text(q) .. ' ' .. text(r) .. ' ' .. tostring(fits(plus(a, b)))"
                "end"
                "return out"
            ]
            words: [str] @= ["EVAL", limit_scripts.prelude() + body.join("\n"), "0"]

            for one in ["9223372036854775807", "1", "1795435200000000000", "3000000007", "9007199254740993", "9007199254740993", "0", "10000000", "12345678901234567890", "99999999999"]
                words @ words.push(one)

            got = redis.texts_of(redis.call(@c, words).must()).must()
            assert got == ["9223372036854775808 9223372036854775806 9223372036854775807 1 9223372036854775807 0 false", "1795435203000000007 1795435196999999993 5386305612568046400000000000 1 598478398 1810651214 true", "18014398509481986 0 81129638414606699710187514626049 0 1 0 true", "10000000 -10000000 0 -1 0 0 true", "12345679001234567889 12345678801234567891 1234567890111111110098765432110 1 123456789 1358024679 false"]
            redis.close(@c).must()

test "the refusals: a name empty, with a zero byte or too long, no token, no limit of the name, a rate no bucket has, a key holding what the store did not write, and tokens earned past what an instant holds, the limit unchanged"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            second = time.seconds(1)
            none = time.Duration(nanoseconds: 0)
            _ = set(@c, name: "real", every: second, burst: 2, clock: at_ms(0)).must()
            given = reserve_at(@c, name: "real", n: 1, ms: 0).must()

            zero: [u8] = [97, 0, 98]

            for bad in ["", zero.validated_bytes().must(), repeat("x", 257)]
                assert bucket_code(set(@c, name: bad, every: second, burst: 1, clock: at_ms(0))) == jobs.INVALID
                assert taken_code(take(@c, name: bad, n: 1, longest: none, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(give_back(@c, name: bad, taken: given, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(read(@c, name: bad, clock: at_ms(0))) == jobs.INVALID
                assert done_code(remove(@c, name: bad)) == jobs.INVALID

            for n in [0, -1]
                assert taken_code(take(@c, name: "real", n: n, longest: none, clock: at_ms(0))) == jobs.INVALID

            assert reserve_code(reserve_at(@c, name: "real", n: 3, ms: 0)) == jobs.INVALID
            assert !allow_at(@c, name: "real", n: 3, ms: 0).must().granted
            assert taken_code(take(@c, name: "absent", n: 1, longest: none, clock: at_ms(0))) == jobs.NOT_FOUND
            assert bucket_code(give_back(@c, name: "absent", taken: given, clock: at_ms(0))) == jobs.NOT_FOUND
            assert bucket_code(read(@c, name: "absent", clock: at_ms(0))) == jobs.NOT_FOUND
            assert done_code(remove(@c, name: "absent")) == jobs.NOT_FOUND

            for rate in [none, time.Duration(nanoseconds: -1)]
                assert bucket_code(set(@c, name: "real", every: rate, burst: 1, clock: at_ms(0))) == jobs.INVALID

            assert bucket_code(set(@c, name: "real", every: second, burst: 0, clock: at_ms(0))) == jobs.INVALID
            assert bucket_code(set(@c, name: "real", every: time.days(365), burst: 100, clock: at_ms(0))) == jobs.INVALID
            assert read(@c, name: "real", clock: at_ms(0)).must().burst == 2
            _ = redis.call(
                @c,
                ["HSET", key_of("odd"), "every_ns", "1", "burst", "x", "empty_at_ns", "0", "seen_ns", "0"]
            ).must()
            _ = redis.call(@c, ["SET", key_of("text"), "a string"]).must()

            for odd in ["odd", "text"]
                assert bucket_code(read(@c, name: odd, clock: at_ms(0))) == jobs.INVALID
                assert taken_code(take(@c, name: odd, n: 1, longest: none, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(set(@c, name: odd, every: second, burst: 1, clock: at_ms(0))) == jobs.INVALID
                assert bucket_code(give_back(@c, name: odd, taken: given, clock: at_ms(0))) == jobs.INVALID
                remove(@c, name: odd).must()

            far = time.nanoseconds(1_000_000_000_000_000_000)
            _ = set(@c, name: "far", every: far, burst: 1, clock: at_ms(0)).must()

            for _ in range(from: 0, to: 8)
                _ = reserve_at(@c, name: "far", n: 1, ms: 0).must()

            before = read(@c, name: "far", clock: at_ms(0)).must()
            assert reserve_code(reserve_at(@c, name: "far", n: 1, ms: 0)) == jobs.DOES_NOT_FIT
            assert allow_at(@c, name: "far", n: 1, ms: 0).is_err()
            assert bucket_code(set(@c, name: "far", every: time.nanoseconds(2_305_843_009_213_693_952), burst: 1, clock: at_ms(0))) == jobs.DOES_NOT_FIT
            assert read(@c, name: "far", clock: at_ms(0)).must() == before
            remove(@c, name: "far").must()
            assert bucket_code(read(@c, name: "far", clock: at_ms(0))) == jobs.NOT_FOUND
            redis.close(@c).must()

test "take: a burst of three at one a second, as golang.org/x/time/rate v0.14.0 answers AllowN at the same times"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set(@c, name: "crawl", every: time.seconds(1), burst: 3, clock: at_ms(0)).must()
            answers: [bool] @= []

            for ms in [0, 0, 0, 0, 1000, 1500, 2000]
                answers @ answers.push(allow_at(@c, name: "crawl", n: 1, ms: ms).must().granted)

            assert answers == [true, true, true, false, true, false, true]
            assert gcra.close(a: tokens_at(@c, name: "crawl", ms: 2000), b: 0.0) && gcra.close(a: tokens_at(@c, name: "crawl", ms: 2500), b: 0.5)
            assert gcra.close(a: tokens_at(@c, name: "crawl", ms: 3000), b: 1.0) && gcra.close(a: tokens_at(@c, name: "crawl", ms: 9000), b: 3.0)
            redis.close(@c).must()

test "take: reservations queue behind one another, a later one waits its turn, as x/time/rate v0.14.0's ReserveN delays them"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set(@c, name: "api", every: time.milliseconds(500), burst: 2, clock: at_ms(0)).must()
            delays: [i64] @= []

            for n in [2, 1, 1]
                delays @ delays.push(
                    time.to_units(reserve_at(@c, name: "api", n: n, ms: 0).must().delay, .millisecond)
                )

            assert delays == [0, 500, 1000]
            later = reserve_at(@c, name: "api", n: 1, ms: 1000).must()
            assert time.to_units(later.delay, .millisecond) == 500 && later.ready == gcra.at_ms(1500)
            assert gcra.close(a: tokens_at(@c, name: "api", ms: 1000), b: -1.0)
            redis.close(@c).must()

test "give_back: a reservation given back, as far as no later one used it, and not once its time has come, as x/time/rate v0.14.0's CancelAt does"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set(@c, name: "slow", every: time.milliseconds(500), burst: 2, clock: at_ms(0)).must()

            for n in [2, 1, 1]
                _ = reserve_at(@c, name: "slow", n: n, ms: 0).must()

            r5 = reserve_at(@c, name: "slow", n: 1, ms: 1000).must()
            assert gcra.close(a: tokens_at(@c, name: "slow", ms: 1000), b: -1.0)
            _ = give_back(@c, name: "slow", taken: r5, clock: at_ms(1000)).must()
            assert gcra.close(a: tokens_at(@c, name: "slow", ms: 1000), b: 0.0)
            _ = set(@c, name: "fast", every: time.milliseconds(250), burst: 4, clock: at_ms(0)).must()
            whole = reserve_at(@c, name: "fast", n: 4, ms: 0).must()
            assert time.to_units(whole.delay, .millisecond) == 0 && gcra.close(a: tokens_at(@c, name: "fast", ms: 0), b: 0.0)
            _ = give_back(@c, name: "fast", taken: whole, clock: at_ms(0)).must()
            assert gcra.close(a: tokens_at(@c, name: "fast", ms: 0), b: 4.0)
            _ = reserve_at(@c, name: "fast", n: 4, ms: 0).must()
            two = reserve_at(@c, name: "fast", n: 2, ms: 0).must()
            assert time.to_units(two.delay, .millisecond) == 500 && gcra.close(a: tokens_at(@c, name: "fast", ms: 0), b: -2.0)
            _ = give_back(@c, name: "fast", taken: two, clock: at_ms(400)).must()
            assert gcra.close(a: tokens_at(@c, name: "fast", ms: 400), b: 1.6)
            one = reserve_at(@c, name: "fast", n: 1, ms: 400).must()
            assert time.to_units(one.delay, .millisecond) == 0
            _ = give_back(@c, name: "fast", taken: one, clock: at_ms(700)).must()
            assert gcra.close(a: tokens_at(@c, name: "fast", ms: 700), b: 1.8)
            redis.close(@c).must()

test "set: the tokens held kept across a new rate and burst, and a debt kept, as x/time/rate v0.14.0's SetLimitAt and SetBurstAt do"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set(@c, name: "feed", every: time.seconds(1), burst: 4, clock: at_ms(0)).must()
            assert allow_at(@c, name: "feed", n: 4, ms: 0).must().granted
            assert gcra.close(a: tokens_at(@c, name: "feed", ms: 2000), b: 2.0)
            _ = set(@c, name: "feed", every: time.milliseconds(500), burst: 4, clock: at_ms(2000)).must()
            assert gcra.close(a: tokens_at(@c, name: "feed", ms: 2000), b: 2.0) && gcra.close(a: tokens_at(@c, name: "feed", ms: 3000), b: 4.0)
            _ = set(@c, name: "feed", every: time.milliseconds(500), burst: 2, clock: at_ms(3000)).must()
            assert gcra.close(a: tokens_at(@c, name: "feed", ms: 3000), b: 2.0) && gcra.close(a: tokens_at(@c, name: "feed", ms: 3500), b: 2.0)
            _ = set(@c, name: "debt", every: time.seconds(1), burst: 2, clock: at_ms(0)).must()
            _ = reserve_at(@c, name: "debt", n: 2, ms: 0).must()
            _ = reserve_at(@c, name: "debt", n: 2, ms: 0).must()
            assert gcra.close(a: tokens_at(@c, name: "debt", ms: 0), b: -2.0) && gcra.close(a: tokens_at(@c, name: "debt", ms: 3000), b: 1.0)
            assert gcra.close(a: tokens_at(@c, name: "debt", ms: 4000), b: 2.0)
            _ = set(@c, name: "debt", every: time.seconds(2), burst: 2, clock: at_ms(1000)).must()
            assert gcra.close(a: tokens_at(@c, name: "debt", ms: 1000), b: -1.0)
            assert time.to_units(reserve_at(@c, name: "debt", n: 1, ms: 1000).must().delay, .millisecond) == 4000
            redis.close(@c).must()

test "take: time named earlier than an earlier call is read at that call's time, and a wait past the one allowed takes nothing, as x/time/rate v0.14.0 answers"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            _ = set(@c, name: "late", every: time.seconds(1), burst: 2, clock: at_ms(0)).must()
            assert allow_at(@c, name: "late", n: 2, ms: 5000).must().granted
            assert !allow_at(@c, name: "late", n: 1, ms: 0).must().granted
            assert gcra.close(a: tokens_at(@c, name: "late", ms: 0), b: 0.0)
            _ = set(@c, name: "one", every: time.seconds(1), burst: 1, clock: at_ms(0)).must()
            assert allow_at(@c, name: "one", n: 1, ms: 0).must().granted
            half = time.milliseconds(500)
            assert reserve_code(taking.reserved(take(@c, name: "one", n: 1, longest: half, clock: at_ms(0)).must(), within: half)) == jobs.TIMEOUT
            assert gcra.close(a: tokens_at(@c, name: "one", ms: 0), b: 0.0)
            second = time.seconds(1)
            waited = taking.reserved(
                take(@c, name: "one", n: 1, longest: second, clock: at_ms(0)).must(),
                within: second
            ).must()
            assert time.to_units(waited.delay, .millisecond) == 1000 && gcra.close(a: tokens_at(@c, name: "one", ms: 0), b: -1.0)
            _ = give_back(@c, name: "one", taken: waited, clock: at_ms(0)).must()
            assert gcra.close(a: tokens_at(@c, name: "one", ms: 0), b: 0.0)
            redis.close(@c).must()

test "take, give_back and set: a thousand takings, reservations, give-backs and changes of rate at scripted times, rates past 2^53 nanoseconds among them, each answered as jobs's own bucket answers it, a change of rate to the nanosecond"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            mine @= set(@c, name: "twin", every: time.milliseconds(700), burst: 5, clock: at_ms(0)).must()
            assert mine == jobs.bucket(every: time.milliseconds(700), burst: 5, at: gcra.at_ms(0)).must()
            rates = [
                time.nanoseconds(1)
                time.nanoseconds(333)
                time.milliseconds(700)
                time.seconds(7)
                time.nanoseconds(9_007_199_254_740_993)
            ]
            bursts = [1_000_000, 50, 5, 2, 200]
            held: [jobs.Reservation] @= []
            ms: i64 @= 0
            seed: i64 @= 7

            for step in range(from: 0, to: 1000)
                seed @ (seed * 1_103_515_245 + 12_345) % 2_147_483_648
                ms @ ms + seed % 900 - 100
                kind = seed % 7
                n = seed % 3 + 1

                if kind < 3
                    match jobs.allow(limit: mine, at: gcra.at_ms(ms), n: n)
                        .err e => assert allowed_code(allow_at(@c, name: "twin", n: n, ms: ms)) == e.code
                        .ok want =>
                            got = allow_at(@c, name: "twin", n: n, ms: ms).must()
                            assert got.granted == want.granted && got.bucket.empty_at == want.bucket.empty_at

                            if want.granted
                                mine @ want.bucket
                else if kind < 5
                    match jobs.reserve(limit: mine, at: gcra.at_ms(ms), n: n)
                        .err e => assert reserve_code(reserve_at(@c, name: "twin", n: n, ms: ms)) == e.code
                        .ok want =>
                            got = reserve_at(@c, name: "twin", n: n, ms: ms).must()
                            assert got.delay == want.delay && got.ready == want.ready && got.finish == want.finish
                            mine @ want.bucket
                            held @ held.push(want)
                else if kind == 5 && held.len() > 0
                    taken = held[step % held.len()]
                    want = jobs.cancel(limit: mine, taken: taken, at: gcra.at_ms(ms)).must()
                    got = give_back(@c, name: "twin", taken: taken, clock: at_ms(ms)).must()
                    assert got.empty_at == want.empty_at
                    mine @ got
                else if kind == 6
                    pick = step % rates.len()

                    match jobs.with_rate(limit: mine, at: gcra.at_ms(ms), every: rates[pick], burst: bursts[pick])
                        .err e => assert bucket_code(set(@c, name: "twin", every: rates[pick], burst: bursts[pick], clock: at_ms(ms))) == e.code
                        .ok want =>
                            got = set(
                                @c,
                                name: "twin",
                                every: rates[pick],
                                burst: bursts[pick],
                                clock: at_ms(ms)
                            ).must()
                            assert got == want
                            mine @ got
                            held @ []

            redis.close(@c).must()

test "set: every row of a change of rate jobs.with_rate is tested on, rates of 1 ns to 2^61 ns, at 2^53 and past it, a limit full, half full, empty and in debt, a tie and a near tie, each to the nanosecond as Python 3's integers answer"
    match live.connect()
        .err e => skip_test(reason: e.msg)
        .ok first =>
            c @= first
            rows = gcra.change_rows()

            for i in range(from: 0, to: rows.len())
                assert changed(@c, name: f"shape{i}", row: rows[i]).must() == rows[i]

            redis.close(@c).must()
