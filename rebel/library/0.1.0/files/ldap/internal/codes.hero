# The result codes of LDAP (RFC 4511 § 4.1.9, RFC 3909, RFC 4528, RFC 4370):
# the name each RFC gives, and the code of the library's closed list a
# result other than success fails with, so a program matches on `not_found`
# or `exists` and reads the LDAP code itself from the result.

# The name an RFC gives `code`, or `code 99` for one none names.
function name_of(code: i64) -> str
    return match code
        0   => "success"
        1   => "operationsError"
        2   => "protocolError"
        3   => "timeLimitExceeded"
        4   => "sizeLimitExceeded"
        5   => "compareFalse"
        6   => "compareTrue"
        7   => "authMethodNotSupported"
        8   => "strongerAuthRequired"
        10  => "referral"
        11  => "adminLimitExceeded"
        12  => "unavailableCriticalExtension"
        13  => "confidentialityRequired"
        14  => "saslBindInProgress"
        16  => "noSuchAttribute"
        17  => "undefinedAttributeType"
        18  => "inappropriateMatching"
        19  => "constraintViolation"
        20  => "attributeOrValueExists"
        21  => "invalidAttributeSyntax"
        32  => "noSuchObject"
        33  => "aliasProblem"
        34  => "invalidDNSyntax"
        36  => "aliasDereferencingProblem"
        48  => "inappropriateAuthentication"
        49  => "invalidCredentials"
        50  => "insufficientAccessRights"
        51  => "busy"
        52  => "unavailable"
        53  => "unwillingToPerform"
        54  => "loopDetect"
        64  => "namingViolation"
        65  => "objectClassViolation"
        66  => "notAllowedOnNonLeaf"
        67  => "notAllowedOnRDN"
        68  => "entryAlreadyExists"
        69  => "objectClassModsProhibited"
        71  => "affectsMultipleDSAs"
        80  => "other"
        118 => "canceled"
        119 => "noSuchOperation"
        120 => "tooLate"
        121 => "cannotCancel"
        122 => "assertionFailed"
        123 => "authorizationDenied"
        _   => f"code {code}"

# The code of the library's list a result `code` other than success fails
# with.
function library_code(code: i64) -> str
    return match code
        2 | 17 | 18 | 19 | 21 | 34 | 64 | 65 | 67 | 69 | 122 => "invalid"
        3                                                    => "timeout"
        4 | 11 | 51 | 52                                     => "limit"
        7 | 12 | 53 | 71 | 121                               => "unsupported"
        8 | 13 | 48 | 49 | 50 | 123                          => "permission"
        10 | 16 | 32 | 33 | 119                              => "not_found"
        20 | 68                                              => "exists"
        66                                                   => "not_empty"
        118                                                  => "stopped"
        _                                                    => "failed"

# The message of a failure: what was asked, the result's name and code, the
# server's words and the name it matched.
function message_of(asked: str, code: i64, said: str, matched: str) -> str
    pieces: [str] @= [asked, ": ", name_of(code), " (", to_str(code), ")"]

    if said != ""
        pieces @ pieces.push(": ")
        pieces @ pieces.push(said)

    if matched != ""
        pieces @ pieces.push("; the server matched ")
        pieces @ pieces.push(matched)
    return pieces.join("")

## Tests

test "name_of: the codes of RFC 4511 and its extensions, and a code no RFC names"
    assert name_of(0) == "success"
    assert name_of(32) == "noSuchObject"
    assert name_of(123) == "authorizationDenied"
    assert name_of(9) == "code 9"
    assert name_of(-1) == "code -1"

test "library_code: each class of result, and a code no RFC names"
    assert library_code(32) == "not_found"
    assert library_code(68) == "exists"
    assert library_code(49) == "permission"
    assert library_code(66) == "not_empty"
    assert library_code(4) == "limit"
    assert library_code(53) == "unsupported"
    assert library_code(34) == "invalid"
    assert library_code(80) == "failed"
    assert library_code(9999) == "failed"

test "message_of: with and without the server's words and a matched name"
    assert message_of(asked: "deleting cn=x", code: 32, said: "", matched: "") == "deleting cn=x: noSuchObject (32)"
    assert message_of(asked: "deleting cn=x,dc=a", code: 32, said: "no such entry", matched: "dc=a") == "deleting cn=x,dc=a: noSuchObject (32): no such entry; the server matched dc=a"
