test "BOXES: each row of each box holds every number from 0 to 15 once"
    for box in BOXES
        row: i64 @= 0

        while row < 4
            seen: [bool] @= [
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
                false
            ]
            i: i64 @= 0

            while i < 16
                seen[box[16 * row + i]] @ true
                i @ i + 1

            for one in seen
                assert one

            row @ row + 1

test "PITABLE: every byte from 0 to 255 stands once"
    seen: [bool] @= []

    while seen.len() < 256
        seen @ seen.push(false)

    for v in PITABLE
        seen[v] @ true

    for one in seen
        assert one
