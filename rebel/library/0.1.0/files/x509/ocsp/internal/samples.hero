# The moment of 2026-`month`-`day` at `hour`:`minute`:`second` UTC.
function at(month: i64, day: i64, hour: i64, minute: i64, second: i64) -> time.Instant
    return time.from_date_time(date(month: month, day: day, hour: hour, minute: minute, second: second)).must()

# The date and time of 2026-`month`-`day` at `hour`:`minute`:`second` UTC.
function date(month: i64, day: i64, hour: i64, minute: i64, second: i64) -> time.DateTime
    return time.DateTime(year: 2026, month: month, day: day, hour: hour, minute: minute, second: second, nanosecond: 0)
