# Crossing between MessagePack and a `json.Value`. An object is first checked
# in the order its bytes hold it, so the first object JSON cannot hold is the
# one named, by its JSON pointer, then built from its last event to its first;
# a JSON value is flattened into events on a stack this module holds. Neither
# way follows the data with recursion.

use json
use msgpack/internal/decoder
use msgpack/internal/encoder
use msgpack/internal/event

# The code of an object JSON has no form for.
constant UNSUPPORTED: str
    "unsupported"

# The code of an integer past what a JSON number holds exactly.
constant DOES_NOT_FIT: str
    "does_not_fit"

# The code of a map holding one string key twice.
constant INVALID: str
    "invalid"

# 2^64 as a float, the first integer MessagePack does not hold.
constant TWO_64: f64
    18446744073709551616.0

# 2^63 as a float, the first integer no `i64` holds.
constant TWO_63: f64
    9223372036854775808.0

# A container open while the events are walked in order: its kind, how many
# objects it holds, how many have been read, and the last string key read.
record Frame
    # `event.LIST` or `event.PAIRS`.
    kind: i64
    # The objects it holds: a map's twice its entries.
    total: i64
    # The objects read so far.
    seen: i64
    # The text of the last key read, in a map.
    key: str

# The JSON pointer of the object the walk stands at, the first `top` frames
# open: a list's index, a map's key, nothing for a map's key itself.
function pointer_of(frames: [Frame] lent, top: i64) -> str
    tokens: [str] @= []

    for k in range(from: 0, to: top)
        f = frames[k]

        if f.kind == event.LIST
            tokens @ tokens.push(to_str(f.seen))
        else if f.seen % 2 == 1
            tokens @ tokens.push(f.key)

    return json.pointer_of(tokens)

# Moves the walk past the event `e`: a container with objects opens a frame,
# and an object complete counts in each frame it completes. Answers the
# frames open after it.
function advance(@frames: [Frame], top: i64, e: event.Event) -> i64
    open: i64 @= top

    if open > 0 && frames[open - 1].kind == event.PAIRS && frames[open - 1].seen % 2 == 0
        frames[open - 1].key @ e.text

    count = event.children_of(e)

    if count > 0
        made = Frame(kind: e.kind, total: count, seen: 0, key: "")

        if open == frames.len()
            frames @ frames.push(made)
        else
            frames[open] @ made
        return open + 1

    while open > 0
        frames[open - 1].seen @ frames[open - 1].seen + 1

        if frames[open - 1].seen < frames[open - 1].total
            return open
        open @ open - 1

    return open

# The JSON pointer of the event at `index`.
function pointer_at(events: [event.Event] lent, index: i64) -> str
    frames: [Frame] @= []
    top: i64 @= 0

    for k in range(from: 0, to: index)
        top @ advance(frames: @frames, top: top, e: events[k])

    return pointer_of(frames: frames, top: top)

# Fails where JSON cannot hold `e`, standing at `pointer`, a map's key where
# `is_key`.
function check(e: event.Event, pointer: str, is_key: bool) -> ()?
    if is_key && e.kind != event.TEXT
        return fail(
            code: UNSUPPORTED,
            msg: f"at \"{pointer}\": a key that is {event.kind_name(e)}, where every JSON key is text"
        )
    else if e.kind == event.BINARY || e.kind == event.EXTENSION
        return fail(code: UNSUPPORTED, msg: f"at \"{pointer}\": {event.kind_name(e)} has no JSON form")
    else if e.kind == event.FLOAT && (e.number != e.number || e.number - e.number != 0.0)
        return fail(code: UNSUPPORTED, msg: f"at \"{pointer}\": the float {to_str(e.number)} has no JSON form")
    else if e.kind == event.UNSIGNED && e.arg > 9007199254740991
        return fail(code: DOES_NOT_FIT, msg: f"at \"{pointer}\": {e.arg} is past what a JSON number holds exactly")
    else if e.kind == event.NEGATIVE && e.signed < -9007199254740991
        return fail(code: DOES_NOT_FIT, msg: f"at \"{pointer}\": {e.signed} is past what a JSON number holds exactly")
    return ok()

# The JSON value the MessagePack object `data` holds. Fails `unsupported`
# where an object has no JSON form, `does_not_fit` where an integer is past
# what a JSON number holds exactly, `invalid` where a map holds one string key
# twice; each message opens with the JSON pointer of the object.
function to_json(data: [u8]) -> json.Value?
    got = decoder.read(data: data, from: 0, reading: decoder.lenient())?
    events = got.events
    frames: [Frame] @= []
    top: i64 @= 0

    for e in events
        is_key = top > 0 && frames[top - 1].kind == event.PAIRS && frames[top - 1].seen % 2 == 0
        check(e: e, pointer: pointer_of(frames: frames, top: top), is_key: is_key)?
        top @ advance(frames: @frames, top: top, e: e)

    done: [json.Value] @= []
    held: i64 @= 0
    at: i64 @= events.len()

    while at > 0
        at @ at - 1
        e = events[at]
        count = event.children_of(e)
        made: json.Value @= .null_value

        if e.kind == event.UNSIGNED
            made @ .number(v: to_f64(e.arg))
        else if e.kind == event.NEGATIVE
            made @ .number(v: to_f64(e.signed))
        else if e.kind == event.TEXT
            made @ .text(v: e.text)
        else if e.kind == event.FLOAT
            made @ .number(v: e.number)
        else if e.kind == event.BOOLEAN
            made @ .boolean(v: e.flag)
        else if e.kind == event.LIST
            items: [json.Value] @= []

            for k in range(from: 0, to: count)
                items @ items.push(done[held - 1 - k])

            made @ .list(items: items)
        else if e.kind == event.PAIRS
            members: {str: json.Value} @= {}

            for k in range(from: 0, to: count / 2)
                key = json.text_of(done[held - 1 - 2 * k]).must()

                if !members[key].is_err()
                    return fail(
                        code: INVALID,
                        msg: f"at \"{pointer_at(events: events, index: at)}\": a map holds the key {json.quote(key)} twice"
                    )
                members[key] @ done[held - 2 - 2 * k]

            made @ .object(members: members)
        held @ held - count

        if held == done.len()
            done @ done.push(made)
        else
            done[held] @ made
        held @ held + 1

    return ok(done[0])

# A JSON value waiting to be flattened, or a key to write before one.
record Pending
    # Whether this is a key, written as a string.
    is_key: bool
    # The key's text.
    key: str
    # The value, where this is no key.
    value: json.Value

# The event of the JSON number `n`: an integer where it is a whole number from
# -2^63 to 2^64 - 1 and not `-0.0`, else a float.
function number_event(n: f64) -> event.Event
    whole = n == n && n - n == 0.0 && (n >= 9007199254740992.0 || n <= -9007199254740992.0 || n == to_f64(to_i64(n).must()))

    if !whole || n >= TWO_64 || n < -TWO_63 || n == 0.0 && 1.0 / n < 0.0
        return event.of_float(n)
    else if n >= TWO_63
        return event.of_kind(kind: event.UNSIGNED, arg: to_u64(to_i64(n - TWO_63).must()).must() + 9223372036854775808)
    else if n >= 0.0
        return event.of_kind(kind: event.UNSIGNED, arg: to_u64(to_i64(n).must()).must())
    return event.of_negative(to_i64(n).must())

# The MessagePack object of the JSON value `v`, an object's members in its
# order.
function from_json(v: json.Value) -> [u8]
    events: [event.Event] @= []
    waiting: [Pending] @= [Pending(is_key: false, key: "", value: v)]
    top: i64 @= 1

    while top > 0
        top @ top - 1
        p = waiting[top]
        children: [Pending] @= []

        if p.is_key
            events @ events.push(event.of_text(p.key))
        else
            made = match p.value
                .null_value => event.of_kind(kind: event.NIL_VALUE, arg: 0)
                .boolean b  => event.of_boolean(b.v)
                .number n   => number_event(n.v)
                .text t     => event.of_text(t.v)
                .list l =>
                    for item in l.items
                        children @ children.push(Pending(is_key: false, key: "", value: item))

                    event.of_kind(kind: event.LIST, arg: to_u64(l.items.len()).must())
                .object o =>
                    for k in keys(o.members)
                        children @ children.push(Pending(is_key: true, key: k, value: .null_value))
                        children @ children.push(Pending(is_key: false, key: "", value: o.members[k].must()))

                    event.of_kind(kind: event.PAIRS, arg: to_u64(o.members.len()).must())

            events @ events.push(made)

        for k in range(from: 0, to: children.len())
            item = children[children.len() - 1 - k]

            if top == waiting.len()
                waiting @ waiting.push(item)
            else
                waiting[top] @ item
            top @ top + 1

    return encoder.write(events: events, order: encoder.AS_WRITTEN, duplicates: true).must()

test "number_event: whole numbers, the edges of the range, fractions, minus zero"
    assert number_event(0.0) == event.of_kind(kind: event.UNSIGNED, arg: 0)
    assert number_event(-1.0) == event.of_negative(-1)
    assert number_event(1.5) == event.of_float(1.5)
    assert number_event(TWO_63) == event.of_kind(kind: event.UNSIGNED, arg: 9223372036854775808)
    assert number_event(TWO_64 - 2048.0) == event.of_kind(kind: event.UNSIGNED, arg: 18446744073709549568)
    assert number_event(TWO_64) == event.of_float(TWO_64)
    assert number_event(-TWO_63) == event.of_negative(-9223372036854775808)
    assert number_event(-TWO_63 - 2048.0) == event.of_float(-TWO_63 - 2048.0)
    assert number_event(-0.0).kind == event.FLOAT

test "from_json: scalars, an empty list and object, members in their order"
    assert from_json(json.parse("null").must()) == [0xc0]
    assert from_json(json.parse("false").must()) == [0xc2]
    assert from_json(json.parse("\"ü\"").must()) == [0xa2, 0xc3, 0xbc]
    assert from_json(json.parse("[]").must()) == [0x90]
    assert from_json(json.parse("{}").must()) == [0x80]
    assert from_json(json.parse("{\"b\": 1, \"a\": [-1, 0.5]}").must()) == [0x82, 0xa1, 0x62, 0x01, 0xa1, 0x61, 0x92, 0xff, 0xca, 0x3f, 0x00, 0x00, 0x00]

test "to_json: scalars, nested containers, the largest exact integers"
    assert to_json([0xc0]).must() == json.parse("null").must()
    assert to_json([0x92, 0x01, 0x91, 0xff]).must() == json.parse("[1, [-1]]").must()
    assert to_json([0x82, 0xa1, 0x61, 0x01, 0xa1, 0x62, 0x92, 0x02, 0x03]).must() == json.parse("{\"a\": 1, \"b\": [2, 3]}").must()
    assert to_json([0xcf, 0x00, 0x1f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]).must() == json.parse("9007199254740991").must()
    assert to_json([0xd3, 0xff, 0xe0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01]).must() == json.parse("-9007199254740991").must()

# The code and message `to_json` fails with on `data`.
function failure_of(data: [u8]) -> str
    return match to_json(data)
        .ok _  => ""
        .err e => f"{e.code}: {e.msg}"

test "to_json: what JSON cannot hold, each named by its pointer"
    assert failure_of([0xc4, 0x00]) == "unsupported: at \"\": a binary has no JSON form"
    assert failure_of([0x92, 0x01, 0xd4, 0x01, 0x00]) == "unsupported: at \"/1\": an extension has no JSON form"
    assert failure_of([0x81, 0x01, 0x02]) == "unsupported: at \"\": a key that is an unsigned integer, where every JSON key is text"
    assert failure_of([0x81, 0xa1, 0x61, 0x91, 0xca, 0x7f, 0xc0, 0x00, 0x00]) == "unsupported: at \"/a/0\": the float nan has no JSON form"
    assert failure_of([0xcf, 0x00, 0x20, 0, 0, 0, 0, 0, 0]) == "does_not_fit: at \"\": 9007199254740992 is past what a JSON number holds exactly"
    assert failure_of([0xd3, 0xff, 0xe0, 0, 0, 0, 0, 0, 0]) == "does_not_fit: at \"\": -9007199254740992 is past what a JSON number holds exactly"
    assert failure_of([0x91, 0x82, 0xa1, 0x61, 0x01, 0xa1, 0x61, 0x02]) == "invalid: at \"/0\": a map holds the key \"a\" twice"
