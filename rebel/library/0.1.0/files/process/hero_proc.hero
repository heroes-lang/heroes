# The platform layer's child processes, `hero_proc.h`, bound thin: one function
# per C function, in C's order, each answering what C answers. The floor of
# `process`: where a call fails its handle is `nullptr` or its number -1, and
# `last_error` then the kind, which `process` turns into a code.
#
# A process started here is LIVE: `start` returns at once with its handle, and
# the program writes to it, reads from it, asks whether it has ended, waits
# for it or stops it. The layer is C of the language's own beside the runtime,
# so this group names its header and no `link`, no platform type reaches it,
# and the same lines bind it on every platform. Every mark below is the
# header's own promise: a process `start` hands out is begun by the call and
# ended by `hero_proc_release`, and the end of a pipe `pipe` hands out is a
# stream of `io/hero_stream`, ended by that floor's `close`.
#
# A list crosses as bytes: each argument, or each `NAME=value`, followed by
# one zero byte. Nothing is quoted and no shell reads it.

use io/hero_stream
use os/hero_os
use process/internal/fixture

extern "hero_proc.h" layer
    # A process the layer started and the program holds. It is a handle the
    # layer issues and checks: one released already, `nullptr`, or one it
    # never issued is `HERO_PROC_NOT_OPEN`, never a read of freed memory and
    # never a signal sent to another process.
    record Proc tag hero_proc
    # The kinds of failure `last_error` answers. They are the same numbers on
    # every platform, and `hero_stream.h`'s number where it has the kind.
    constant HERO_PROC_OK: i64
    constant HERO_PROC_INVALID: i64
    constant HERO_PROC_NOT_OPEN: i64
    constant HERO_PROC_NOT_FOUND: i64
    constant HERO_PROC_DENIED: i64
    constant HERO_PROC_NOT_A_DIRECTORY: i64
    constant HERO_PROC_LIMIT: i64
    constant HERO_PROC_UNSUPPORTED: i64
    constant HERO_PROC_OTHER: i64
    constant HERO_PROC_RUNNING: i64
    constant HERO_PROC_NOT_A_PROGRAM: i64
    constant HERO_PROC_ENDED: i64
    # What each of the child's input, output and error is: the parent's own,
    # the null device, a new pipe, or a stream the program holds.
    constant HERO_PROC_STDIO_PARENT: i64
    constant HERO_PROC_STDIO_NOTHING: i64
    constant HERO_PROC_STDIO_PIPE: i64
    constant HERO_PROC_STDIO_STREAM: i64
    # What the child's environment is: this process's, or exactly a list.
    constant HERO_PROC_ENV_PARENT: i64
    constant HERO_PROC_ENV_GIVEN: i64
    # Which process group the child starts in: this process's, a group of its
    # own, or the group another child stands in.
    constant HERO_PROC_GROUP_PARENT: i64
    constant HERO_PROC_GROUP_NEW: i64
    constant HERO_PROC_GROUP_JOIN: i64
    # Which of the child's three streams, for `pipe`.
    constant HERO_PROC_INPUT: i64
    constant HERO_PROC_OUTPUT: i64
    constant HERO_PROC_ERROR: i64
    function hero_proc_start(program: cstr lent, @arguments: [u8] counted_by arguments_count lent, arguments_count: u64, environment_kind: i64, @environment: [u8] counted_by environment_count lent, environment_count: u64, folder: cstr lent, input_kind: i64, input: hero_stream.Stream, output_kind: i64, output: hero_stream.Stream, error_kind: i64, error: hero_stream.Stream, group_kind: i64, leader: Proc) -> Proc acquires hero_proc_release
    function hero_proc_pipe(p: Proc, which: i64) -> hero_stream.Stream acquires hero_stream_close
    function hero_proc_wait(p: Proc, @code: i64, @by_signal: i64) -> i64
    function hero_proc_ended(p: Proc) -> i64
    function hero_proc_state(p: Proc, waits: i64, @stop_signal: i64) -> i64
    function hero_proc_heed(p: Proc, limit_ns: i64, @stop_signal: i64) -> i64
    function hero_proc_terminate(p: Proc) -> i64
    function hero_proc_kill(p: Proc) -> i64
    function hero_proc_signal(p: Proc, sig: i64, group: i64) -> i64
    function hero_proc_give_terminal(terminal: hero_stream.Stream, p: Proc) -> i64
    function hero_proc_take_terminal(terminal: hero_stream.Stream) -> i64
    function hero_proc_holds_terminal(terminal: hero_stream.Stream) -> i64
    function hero_proc_id(p: Proc) -> i64
    function hero_proc_cpu(p: Proc, @user_ns: i64, @system_ns: i64) -> i64
    function hero_proc_release(p: Proc consumes) -> i64
    function hero_proc_last_error() -> i64
    function hero_proc_last_os_error() -> i64
    # `hero_stream.h`'s own, which this header includes: the call that ends
    # the stream `hero_proc_pipe` begins, declared here because a mark names
    # a call of its own module. A program closes one through `io/hero_stream`.
    #
    # - `s`: the stream ended and given back.
    function hero_stream_close(s: hero_stream.Stream consumes) -> i64

# The process `program` started as, or `nullptr`; no process was started
# where it is `nullptr`. `program` is a path where it holds a separator, else
# a name looked for in this process's `PATH`; `arguments` holds each argument
# followed by a zero byte, `arguments_count` bytes in all; `environment_kind`
# is `HERO_PROC_ENV_PARENT`, or `HERO_PROC_ENV_GIVEN` with each `NAME=value`
# of `environment` followed by a zero byte; `folder` is the child's working
# folder, "" for this process's own; and each kind is one of
# `HERO_PROC_STDIO_*`, its stream read only for `HERO_PROC_STDIO_STREAM`. A
# program that is not there is `HERO_PROC_NOT_FOUND`, told here. It aborts
# where `program` or `folder` holds a zero byte, which C cannot read.
#
# - `program`: a path where it holds a separator (`/`, or `\` on Windows),
#   read in this process's folder where relative; else a name looked for in
#   this process's `PATH`, and on Windows the system's own search, `.exe`
#   tried for a name with none. It aborts where it holds a zero byte.
# - `arguments`: each argument's bytes followed by one zero byte, in order,
#   any bytes but a zero, an empty argument included; no shell reads them. On
#   Windows they must be UTF-8. At most 4,096, more `HERO_PROC_LIMIT`. Left
#   as it was handed.
# - `arguments_count`: the bytes of `arguments` read; 0 is no argument, any
#   other count must end on a zero byte, else `HERO_PROC_INVALID`.
# - `environment_kind`: `HERO_PROC_ENV_PARENT`, this process's environment as
#   it stands, or `HERO_PROC_ENV_GIVEN`, exactly `environment`.
# - `environment`: each variable as `NAME=value` followed by one zero byte,
#   read only for `HERO_PROC_ENV_GIVEN`; at most 4,096, more
#   `HERO_PROC_LIMIT`. Left as it was handed.
# - `environment_count`: the bytes of `environment` read; 0 with
#   `HERO_PROC_ENV_GIVEN` is a child with no variable.
# - `folder`: the child's working folder, "" for this process's own; one the
#   child cannot start in is `HERO_PROC_NOT_A_DIRECTORY`. It aborts where it
#   holds a zero byte.
# - `in_kind`: what the child's input is: `HERO_PROC_STDIO_PARENT`,
#   `HERO_PROC_STDIO_NOTHING` (the null device), `HERO_PROC_STDIO_PIPE` (taken
#   by `pipe`) or `HERO_PROC_STDIO_STREAM`.
# - `in_stream`: the stream the child reads, for `HERO_PROC_STDIO_STREAM`
#   alone; it stays the program's, which closes it. One on no descriptor is
#   `HERO_PROC_UNSUPPORTED`.
# - `out_kind`: what the child's output is, one of the four
#   `HERO_PROC_STDIO_*`.
# - `out_stream`: the stream the child writes its output to, for
#   `HERO_PROC_STDIO_STREAM` alone; it stays the program's.
# - `err_kind`: what the child's error output is, one of the four
#   `HERO_PROC_STDIO_*`.
# - `err_stream`: the stream the child writes its errors to, for
#   `HERO_PROC_STDIO_STREAM` alone; it stays the program's.
# - `group_kind`: the process group the child starts in (POSIX):
#   `HERO_PROC_GROUP_PARENT`, this process's; `HERO_PROC_GROUP_NEW`, a group
#   of its own that it leads; or `HERO_PROC_GROUP_JOIN`, the group `leader`
#   stands in. On Windows every kind but the parent's is
#   `HERO_PROC_UNSUPPORTED`.
# - `leader`: for `HERO_PROC_GROUP_JOIN` alone, a process of this floor that
#   has not ended (else `HERO_PROC_ENDED`) and stands in a group of its own,
#   not this process's (else `HERO_PROC_INVALID`); `nullptr` for the other
#   kinds, else `HERO_PROC_INVALID`. It stays the program's.
function start(program: str, @arguments: [u8], arguments_count: u64, environment_kind: i64, @environment: [u8], environment_count: u64, folder: str, in_kind: i64, in_stream: hero_stream.Stream, out_kind: i64, out_stream: hero_stream.Stream, err_kind: i64, err_stream: hero_stream.Stream, group_kind: i64, leader: Proc) -> Proc
    return hero_proc_start(
        program: program.cstr(),
        arguments: @arguments,
        arguments_count: arguments_count,
        environment_kind: environment_kind,
        environment: @environment,
        environment_count: environment_count,
        folder: folder.cstr(),
        input_kind: in_kind,
        input: in_stream,
        output_kind: out_kind,
        output: out_stream,
        error_kind: err_kind,
        error: err_stream,
        group_kind: group_kind,
        leader: leader
    )

# The program's end of the pipe that is the child's `which`, or `nullptr`.
# `which` is `HERO_PROC_INPUT`, `HERO_PROC_OUTPUT` or `HERO_PROC_ERROR`; the
# end is taken once and is the program's from then, closed by
# `hero_stream.close`. It is `nullptr` with `HERO_PROC_INVALID` where that
# stream was not started as a pipe or its end was taken already.
#
# - `p`: the process; it stays the program's.
# - `which`: `HERO_PROC_INPUT` (written to; its close is the child's end of
#   input), `HERO_PROC_OUTPUT` or `HERO_PROC_ERROR` (read from).
function pipe(p: Proc, which: i64) -> hero_stream.Stream
    return hero_proc_pipe(p, which)

# 0 once `p` has ended, waiting for it, or -1. `code` is then its exit code
# and `by_signal` 0, or `code` -1 and `by_signal` the signal that ended it;
# on Windows `by_signal` is always 0. Asked again it answers the same.
#
# - `p`: the process waited for; it stays the program's. The answer is kept
#   with it, so a second wait answers at once.
# - `code`: set to the exit code, or -1 where a signal ended it; -1 on a
#   failure. On Windows 0 to 4,294,967,295, 1 for a process `kill` ended.
# - `by_signal`: set to 0 where the process ended itself, else the signal's
#   number (POSIX); 0 on a failure, and always 0 on Windows.
function wait(p: Proc, @code: i64, @by_signal: i64) -> i64
    return hero_proc_wait(p, code: @code, by_signal: @by_signal)

# 1 where `p` has ended, 0 where it still runs, or -1. It never waits.
#
# - `p`: the process asked about; it stays the program's.
function ended(p: Proc) -> i64
    return hero_proc_ended(p)

# Where `p` stands: 0 it runs, 1 it has ended, 2 a signal stopped it, its
# number in `stop_signal`; or -1. With `waits` 0 it never waits, and a process
# seen stopped answers 2 until it is seen to go on or to end; with `waits` 1 it
# waits until `p` ends or stops, past a stop seen before the call, and never
# answers 0. Windows answers no stop.
#
# - `p`: the process asked about; it stays the program's. Once 1 is
#   answered, `wait` answers at once.
# - `waits`: 0 never waits, 1 waits for the end or a stop; any other number is
#   `HERO_PROC_INVALID`.
# - `stop_signal`: set to the number of the signal that stopped it where 2 is
#   answered, else 0.
function state(p: Proc, waits: i64, @stop_signal: i64) -> i64
    return hero_proc_state(p, waits: waits, stop_signal: @stop_signal)

# Waits for `p` to end or stop, as `state` with `waits` 1 does, ending also
# where a signal the program counts (`os.count_signal`) came and is not taken,
# or `limit_ns` passed: 1 it has ended, 2 a signal stopped it in this call, 3
# a counted signal came, answered at once while one stays untaken, 0 the limit
# passed; or -1. A stop it was seen in before the call is waited past.
#
# - `p`: the process waited for; it stays the program's.
# - `limit_ns`: the longest to wait, -1 for as long as it takes, 0 to look
#   once; below -1 is `HERO_PROC_INVALID`.
# - `stop_signal`: with 2 the signal that stopped it; with 3 and 0 the signal
#   it was last seen stopped by, 0 where it runs.
function heed(p: Proc, limit_ns: i64, @stop_signal: i64) -> i64
    return hero_proc_heed(p, limit_ns: limit_ns, stop_signal: @stop_signal)

# 0 once `p` is asked to end, or -1. It sends SIGTERM, and nothing to a
# process that has ended already; on Windows it answers -1 with
# `HERO_PROC_UNSUPPORTED` and touches nothing, since Windows has no such
# request.
#
# - `p`: the process asked to end; it stays the program's, and is waited for
#   and released as before.
function terminate(p: Proc) -> i64
    return hero_proc_terminate(p)

# 0 once `p` is ended at once, or -1. It sends SIGKILL, or on Windows ends
# the process with the exit code 1, and nothing to one that has ended already.
#
# - `p`: the process ended; it stays the program's. It has ended once `wait`
#   returns, which may be a moment later; the processes it started are not
#   ended.
function kill(p: Proc) -> i64
    return hero_proc_kill(p)

# 0 once the system took the signal `sig` for `p` alone, or for every process
# of the group `p` stands in, or -1: a process that has ended is sent nothing,
# 0 for itself and `HERO_PROC_ENDED` for its group. `HERO_PROC_INVALID` for a
# number no signal has, a `group` that is neither 0 nor 1, and a group that is
# this process's own; on Windows `HERO_PROC_UNSUPPORTED`.
#
# - `p`: the process the signal goes to, or whose group it goes to; it stays
#   the program's.
# - `sig`: the platform's number for the signal, `os/hero_os`'s
#   `signal_number` answer; 1 and above, below the platform's count.
# - `group`: 0 for `p` alone, 1 for its group, read at the call.
function signal(p: Proc, sig: i64, group: i64) -> i64
    return hero_proc_signal(p, sig: sig, group: group)

# 0 once the group `p` stands in is in front at the terminal `terminal`, so
# Ctrl-C, Ctrl-Z and the terminal's reads reach it alone; or -1:
# `HERO_PROC_UNSUPPORTED` where `terminal` is no terminal or not this
# process's controlling one, and on Windows; `HERO_PROC_ENDED` and
# `HERO_PROC_INVALID` as `signal` answers them.
#
# - `terminal`: a stream on this process's controlling terminal, its input
#   for a shell; it stays the program's.
# - `p`: the process whose group goes in front; it stays the program's.
function give_terminal(terminal: hero_stream.Stream, p: Proc) -> i64
    return hero_proc_give_terminal(terminal, p: p)

# 0 once this process's own group is in front at `terminal` again, or -1,
# `HERO_PROC_UNSUPPORTED` as `give_terminal` answers it.
#
# - `terminal`: a stream on this process's controlling terminal; it stays
#   the program's.
function take_terminal(terminal: hero_stream.Stream) -> i64
    return hero_proc_take_terminal(terminal)

# 1 where this process's own group is in front at `terminal`, 0 where another
# group is, or -1, `HERO_PROC_UNSUPPORTED` as `give_terminal` answers it.
#
# - `terminal`: a stream on this process's controlling terminal; it stays
#   the program's.
function holds_terminal(terminal: hero_stream.Stream) -> i64
    return hero_proc_holds_terminal(terminal)

# The system's own number for `p`, or -1. It is a number to show: the handle
# names the process, never the number.
#
# - `p`: the process asked about; it stays the program's.
function id(p: Proc) -> i64
    return hero_proc_id(p)

# 0 with the CPU time `p` used in `user_ns` and `system_ns`, in nanoseconds,
# or -1 with both -1. It answers only once `p` has ended, and
# `HERO_PROC_RUNNING` before.
#
# - `p`: the process asked about, ended; it stays the program's.
# - `user_ns`: set to the nanoseconds it ran its own code; -1 on a failure.
# - `system_ns`: set to the nanoseconds the system ran on its behalf; -1 on a
#   failure. On POSIX the children it waited for count with it.
function cpu(p: Proc, @user_ns: i64, @system_ns: i64) -> i64
    return hero_proc_cpu(p, user_ns: @user_ns, system_ns: @system_ns)

# 0, or -1 where `p` named no process; `p` is given back either way. A
# process that still runs keeps running and leaves no zombie, and the ends of
# its pipes never taken are closed.
#
# - `p`: the handle given back; a process that still runs keeps running, and a
#   call another thread is still in on it answers `HERO_PROC_NOT_OPEN`.
function release(@p: Proc) -> i64
    return hero_proc_release(p)

# The kind of the last call's failure on this thread. It is `HERO_PROC_OK`
# after a call that did not fail.
function last_error() -> i64
    return hero_proc_last_error()

# The platform's own number for the last call's failure, 0 where the layer
# refused.
function last_os_error() -> i64
    return hero_proc_last_os_error()

# For the test of the handle tag alone (2026-11-16): a socket made and
# closed through `ptr`, and a stream's door bound with `ptr`, so a test can
# hand one table's handle to another's, which no typed binding lets a
# program do.
#
# - `address`: a number to bind to, or "" for every address of the machine.
# - `port`: 0 to 65535, 0 asking the system for a free one.
extern "hero_net.h" layer
    function hero_net_udp(address: cstr lent, port: i64) -> ptr
    function hero_net_close(s: ptr) -> i64

extern "hero_stream.h" layer
    constant HERO_STREAM_NOT_OPEN: i64
    function hero_stream_kind(s: ptr) -> i64
    function hero_stream_last_error() -> i64

## Tests

# The edge the language itself shuts first: a process released is a name the
# compiler refuses to read again, so what reaches C as no process is `nullptr`.
test "nullptr is no process: every door answers -1 or nullptr with HERO_PROC_NOT_OPEN, the layer's own refusal"
    none: Proc @= nullptr
    code: i64 @= 7
    by: i64 @= 7
    assert wait(none, code: @code, by_signal: @by) == -1
    assert code == -1 && by == 0
    assert last_error() == HERO_PROC_NOT_OPEN
    assert last_os_error() == 0
    assert ended(none) == -1
    assert terminate(none) == -1
    assert kill(none) == -1
    assert id(none) == -1
    assert last_error() == HERO_PROC_NOT_OPEN
    user: i64 @= 7
    system: i64 @= 7
    assert cpu(none, user_ns: @user, system_ns: @system) == -1
    assert user == -1 && system == -1
    end = pipe(none, HERO_PROC_OUTPUT)
    assert end == nullptr
    assert last_error() == HERO_PROC_NOT_OPEN
    assert release(@none) == -1
    assert last_error() == HERO_PROC_NOT_OPEN

test "what the layer refuses before any child: no program, a list with no zero at its end, a variable with no `=`, and kinds that are none"
    none: [u8] = []
    no_program = fixture.begun(
        program: "",
        arguments: none,
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: none,
        folder: "",
        kinds: fixture.quiet()
    )
    assert no_program == nullptr
    assert last_error() == HERO_PROC_INVALID
    assert last_os_error() == 0
    unended = fixture.begun(
        program: fixture.copier(),
        arguments: [97],
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: none,
        folder: "",
        kinds: fixture.quiet()
    )
    assert unended == nullptr
    assert last_error() == HERO_PROC_INVALID
    bare = fixture.begun(
        program: fixture.copier(),
        arguments: none,
        environment_kind: HERO_PROC_ENV_GIVEN,
        environment: [65, 0],
        folder: "",
        kinds: fixture.quiet()
    )
    assert bare == nullptr
    assert last_error() == HERO_PROC_INVALID
    no_such_environment = fixture.begun(
        program: fixture.copier(),
        arguments: none,
        environment_kind: 2,
        environment: none,
        folder: "",
        kinds: fixture.quiet()
    )
    assert no_such_environment == nullptr
    assert last_error() == HERO_PROC_INVALID
    no_such_kind = fixture.begun(
        program: fixture.copier(),
        arguments: none,
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: none,
        folder: "",
        kinds: [4, HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_NOTHING]
    )
    assert no_such_kind == nullptr
    assert last_error() == HERO_PROC_INVALID
    assert last_error() != HERO_PROC_OK

test "the largest list: one argument past 4,096 is HERO_PROC_LIMIT, and no child is started"
    many: [u8] @= []

    for _ in range(from: 0, to: 4097)
        many @ many.push(0)

    none: [u8] = []
    refused = fixture.begun(
        program: fixture.copier(),
        arguments: many,
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: none,
        folder: "",
        kinds: fixture.quiet()
    )
    assert refused == nullptr
    assert last_error() == HERO_PROC_LIMIT
    assert last_os_error() == 0

test "a stream that is none, handed as the child's input: nullptr with HERO_PROC_NOT_OPEN, and no child is started"
    words: [u8] @= []
    variables: [u8] @= []
    refused = start(
        program: fixture.copier(),
        arguments: @words,
        arguments_count: 0,
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_STREAM,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_NOTHING,
        out_stream: nullptr,
        err_kind: HERO_PROC_STDIO_NOTHING,
        err_stream: nullptr,
        group_kind: HERO_PROC_GROUP_PARENT,
        leader: nullptr
    )
    assert refused == nullptr
    assert last_error() == HERO_PROC_NOT_OPEN

test "a program that is not there: nullptr with HERO_PROC_NOT_FOUND at the start, by name and by path"
    no_words: [str] = []
    by_name = fixture.child(program: "rebel-no-such-program", words: no_words, folder: "", kinds: fixture.quiet())
    assert by_name == nullptr
    assert last_error() == HERO_PROC_NOT_FOUND
    assert last_os_error() != 0
    by_path = fixture.child(
        program: "build/rebel-no-such-folder/program",
        words: no_words,
        folder: "",
        kinds: fixture.quiet()
    )
    assert by_path == nullptr
    assert last_error() == HERO_PROC_NOT_FOUND
    assert last_os_error() != 0

test "a folder that is not there: nullptr with HERO_PROC_NOT_A_DIRECTORY, never a missing program's kind"
    no_words: [str] = []
    lost = fixture.child(
        program: fixture.copier(),
        words: no_words,
        folder: "build/rebel-no-such-folder",
        kinds: fixture.quiet()
    )
    assert lost == nullptr
    assert last_error() == HERO_PROC_NOT_A_DIRECTORY
    assert last_os_error() != 0

test "a child's output read through a pipe: its bytes, then the end, and its exit code 0"
    p @= fixture.shell(
        words: ["echo", "hello"],
        folder: "",
        kinds: [HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    assert last_error() == HERO_PROC_OK
    assert id(p) > 0
    out @= pipe(p, HERO_PROC_OUTPUT)
    assert out != nullptr
    assert fixture.line(fixture.drained(out)) == "hello"
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 0 && by == 0
    assert hero_stream.close(@out) == 0
    assert release(@p) == 0

test "a pipe's end is taken once: taken again, never asked for, or of no such stream, it is nullptr with HERO_PROC_INVALID"
    p @= fixture.shell(
        words: ["echo", "hello"],
        folder: "",
        kinds: [HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING]
    )
    out @= pipe(p, HERO_PROC_OUTPUT)
    assert out != nullptr
    again = pipe(p, HERO_PROC_OUTPUT)
    assert again == nullptr
    assert last_error() == HERO_PROC_INVALID
    never = pipe(p, HERO_PROC_ERROR)
    assert never == nullptr
    assert last_error() == HERO_PROC_INVALID
    no_such = pipe(p, 3)
    assert no_such == nullptr
    assert last_error() == HERO_PROC_INVALID
    assert fixture.line(fixture.drained(out)) == "hello"
    assert hero_stream.close(@out) == 0
    assert release(@p) == 0

test "text written to a child's input comes back from its output, and closing the input ends the child"
    no_words: [str] = []
    p @= fixture.child(
        program: fixture.copier(),
        words: no_words,
        folder: "",
        kinds: [HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    input @= pipe(p, HERO_PROC_INPUT)
    output @= pipe(p, HERO_PROC_OUTPUT)
    assert input != nullptr && output != nullptr
    text: [u8] @= [114, 101, 98, 101, 108, 10]
    assert hero_stream.write(input, @text, n: 6) == 6
    assert hero_stream.close(@input) == 0
    assert fixture.line(fixture.drained(output)) == "rebel"
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 0 && by == 0
    assert hero_stream.close(@output) == 0
    assert release(@p) == 0

test "an exit code that is not zero is the code, and no signal"
    p @= fixture.shell(words: ["exit", "3"], folder: "", kinds: fixture.quiet())
    assert p != nullptr
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 3 && by == 0
    assert release(@p) == 0

test "a wait asked twice answers the same, and ended answers 1 after it"
    p @= fixture.shell(words: ["exit", "5"], folder: "", kinds: fixture.quiet())
    assert p != nullptr
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 5 && by == 0
    code @ 7
    by @ 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 5 && by == 0
    assert ended(p) == 1
    assert release(@p) == 0

# The child reads a pipe nobody writes to or closes, so it runs until it is
# ended; the pipe's end is closed only after.
test "a child ended at once: its wait answers the signal, or on Windows the kill's code, and stopping it again sends nothing"
    no_words: [str] = []
    p @= fixture.child(
        program: fixture.copier(),
        words: no_words,
        folder: "",
        kinds: [HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    assert ended(p) == 0
    user: i64 @= 7
    system: i64 @= 7
    assert cpu(p, user_ns: @user, system_ns: @system) == -1
    assert last_error() == HERO_PROC_RUNNING
    assert user == -1 && system == -1
    assert kill(p) == 0
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0

    if fixture.on_windows()
        assert code == 1 && by == 0
    else
        assert code == -1 && by == 9
    assert ended(p) == 1
    assert kill(p) == 0
    assert terminate(p) == 0
    assert cpu(p, user_ns: @user, system_ns: @system) == 0
    assert user >= 0 && system >= 0
    held @= pipe(p, HERO_PROC_INPUT)
    assert hero_stream.close(@held) == 0
    assert release(@p) == 0

test "a request to end: SIGTERM ends the child, and on Windows it is HERO_PROC_UNSUPPORTED and the child runs on until it is killed"
    no_words: [str] = []
    p @= fixture.child(
        program: fixture.copier(),
        words: no_words,
        folder: "",
        kinds: [HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    asked = terminate(p)

    if fixture.on_windows()
        assert asked == -1
        assert last_error() == HERO_PROC_UNSUPPORTED
        assert ended(p) == 0
        assert kill(p) == 0
    else
        assert asked == 0
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0

    if fixture.on_windows()
        assert code == 1 && by == 0
    else
        assert code == -1 && by == 15
    assert release(@p) == 0

test "a child given a working folder prints it, and this process's folder is not moved"
    folder = fixture.scratch("folder")
    command: str @= "pwd"

    if fixture.on_windows()
        command @ "cd"
    p @= fixture.shell(
        words: [command],
        folder: folder,
        kinds: [HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    out @= pipe(p, HERO_PROC_OUTPUT)
    assert fixture.ends_with(text: fixture.line(fixture.drained(out)), tail: fixture.scratch_name("folder"))
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 0 && by == 0
    assert hero_stream.close(@out) == 0
    assert release(@p) == 0
    assert fixture.cleared(folder)

test "a given environment is the child's own: it reads the variable it was handed"
    variable: str @= "$REBEL_WORD"

    if fixture.on_windows()
        variable @ "%REBEL_WORD%"
    p @= fixture.begun(
        program: fixture.shell_program(),
        arguments: fixture.packed(fixture.shell_words(["echo", variable])),
        environment_kind: HERO_PROC_ENV_GIVEN,
        environment: fixture.packed(["REBEL_WORD=bowie"]),
        folder: "",
        kinds: [HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    out @= pipe(p, HERO_PROC_OUTPUT)
    assert fixture.line(fixture.drained(out)) == "bowie"
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 0 && by == 0
    assert hero_stream.close(@out) == 0
    assert release(@p) == 0

test "a stream the program holds is the child's output and its error: a pipe of the program's own, read once the child has ended"
    reader: hero_stream.Stream @= nullptr
    writer: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @reader, writer: @writer) == 0
    words: [u8] @= fixture.packed(fixture.shell_words(["echo", "hello"]))
    variables: [u8] @= []
    p @= start(
        program: fixture.shell_program(),
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_NOTHING,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_STREAM,
        out_stream: writer,
        err_kind: HERO_PROC_STDIO_STREAM,
        err_stream: writer,
        group_kind: HERO_PROC_GROUP_PARENT,
        leader: nullptr
    )
    assert p != nullptr
    assert hero_stream.close(@writer) == 0
    assert fixture.line(fixture.drained(reader)) == "hello"
    code: i64 @= 7
    by: i64 @= 7
    assert wait(p, code: @code, by_signal: @by) == 0
    assert code == 0 && by == 0
    assert hero_stream.close(@reader) == 0
    assert release(@p) == 0

# The release closes the pipe's end the test never took, which is the child's
# input: the child reads its end and ends by itself, and the layer waits for
# it, so nothing outlives the test.
test "a process released while it runs is given back at once, and its pipe never taken is closed"
    no_words: [str] = []
    p @= fixture.child(
        program: fixture.copier(),
        words: no_words,
        folder: "",
        kinds: [HERO_PROC_STDIO_PIPE, HERO_PROC_STDIO_NOTHING, HERO_PROC_STDIO_NOTHING]
    )
    assert p != nullptr
    assert ended(p) == 0
    assert release(@p) == 0
    assert last_error() == HERO_PROC_OK

test "a socket handed to a stream's door is one the streams never issued, not open, never a slot of theirs"
    here = "127.0.0.1"
    socket = hero_net_udp(address: here.cstr(), port: 0)
    assert socket != nullptr
    assert hero_stream_kind(socket) == -1
    assert hero_stream_last_error() == HERO_STREAM_NOT_OPEN
    assert hero_net_close(socket) == 0

test "the job-control doors on no process: state, signal and give_terminal answer -1 with HERO_PROC_NOT_OPEN"
    none: Proc = nullptr
    stop: i64 @= 7
    assert state(none, waits: 0, stop_signal: @stop) == -1 && stop == 0
    assert last_error() == HERO_PROC_NOT_OPEN
    assert signal(none, sig: 15, group: 0) == -1 && last_error() == HERO_PROC_NOT_OPEN
    assert give_terminal(hero_stream.std(0), p: none) == -1 && last_error() == HERO_PROC_NOT_OPEN

test "what the job-control doors refuse: a wait that is neither 0 nor 1, a signal no number names, a group that is neither, a group joined with no leader or a leader with none"
    words: [u8] @= fixture.packed(fixture.sleeper_arguments(30))
    variables: [u8] @= []
    p @= start(
        program: fixture.sleeper(),
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_NOTHING,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_NOTHING,
        out_stream: nullptr,
        err_kind: HERO_PROC_STDIO_NOTHING,
        err_stream: nullptr,
        group_kind: HERO_PROC_GROUP_PARENT,
        leader: nullptr
    )
    assert p != nullptr
    stop: i64 @= 7
    assert state(p, waits: 2, stop_signal: @stop) == -1 && last_error() == HERO_PROC_INVALID
    assert state(p, waits: 0, stop_signal: @stop) == 0 && stop == 0

    if fixture.on_windows()
        assert signal(p, sig: 15, group: 0) == -1 && last_error() == HERO_PROC_UNSUPPORTED
    else
        assert signal(p, sig: 0, group: 0) == -1 && last_error() == HERO_PROC_INVALID
        assert signal(p, sig: 15, group: 2) == -1 && last_error() == HERO_PROC_INVALID
        assert signal(p, sig: 15, group: 1) == -1 && last_error() == HERO_PROC_INVALID
    joined = start(
        program: fixture.sleeper(),
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_NOTHING,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_NOTHING,
        out_stream: nullptr,
        err_kind: HERO_PROC_STDIO_NOTHING,
        err_stream: nullptr,
        group_kind: HERO_PROC_GROUP_JOIN,
        leader: nullptr
    )
    assert joined == nullptr && last_error() == HERO_PROC_INVALID
    led = start(
        program: fixture.sleeper(),
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_NOTHING,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_NOTHING,
        out_stream: nullptr,
        err_kind: HERO_PROC_STDIO_NOTHING,
        err_stream: nullptr,
        group_kind: HERO_PROC_GROUP_NEW,
        leader: p
    )
    assert led == nullptr && last_error() == HERO_PROC_INVALID
    assert kill(p) == 0
    code: i64 @= 0
    by: i64 @= 0
    assert wait(p, code: @code, by_signal: @by) == 0
    assert state(p, waits: 1, stop_signal: @stop) == 1 && stop == 0
    assert signal(p, sig: 15, group: 0) == 0 || fixture.on_windows()
    assert release(@p) == 0

test "a group of its own, signalled as a group, stopped and told, a stop waited past once sent on, then the end; Windows refuses the group"
    words: [u8] @= fixture.packed(fixture.sleeper_arguments(30))
    variables: [u8] @= []
    p @= start(
        program: fixture.sleeper(),
        arguments: @words,
        arguments_count: words.len().to_u64().must(),
        environment_kind: HERO_PROC_ENV_PARENT,
        environment: @variables,
        environment_count: 0,
        folder: "",
        in_kind: HERO_PROC_STDIO_NOTHING,
        in_stream: nullptr,
        out_kind: HERO_PROC_STDIO_NOTHING,
        out_stream: nullptr,
        err_kind: HERO_PROC_STDIO_NOTHING,
        err_stream: nullptr,
        group_kind: HERO_PROC_GROUP_NEW,
        leader: nullptr
    )

    if fixture.on_windows()
        assert p == nullptr && last_error() == HERO_PROC_UNSUPPORTED
    else
        assert p != nullptr
        stopping = hero_os.signal_number(hero_os.HERO_SIGNAL_STOP).to_i64().must()
        going_on = hero_os.signal_number(hero_os.HERO_SIGNAL_CONTINUE).to_i64().must()
        stop: i64 @= 0
        assert signal(p, sig: stopping, group: 1) == 0
        assert state(p, waits: 1, stop_signal: @stop) == 2 && stop == stopping
        assert state(p, waits: 0, stop_signal: @stop) == 2 && stop == stopping
        assert ended(p) == 0
        assert signal(p, sig: going_on, group: 1) == 0
        assert signal(p, sig: 9, group: 1) == 0
        assert state(p, waits: 1, stop_signal: @stop) == 1 && stop == 0
        code: i64 @= 0
        by: i64 @= 0
        assert wait(p, code: @code, by_signal: @by) == 0 && by == 9
        assert signal(p, sig: 15, group: 1) == -1 && last_error() == HERO_PROC_ENDED
        assert release(@p) == 0
