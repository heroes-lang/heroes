# A connected socket as a stream, `hero_stream_net.h`, bound thin: its one C
# function and one Heroes function answering what it answers. Rebel's floor
# (`rebel/examples/README.md` § A2): no policy stands here, and the face
# above it turns the stream's kinds into codes.
#
# THE SOCKET'S LIFE PASSES INTO THE STREAM, AND THE MARK THAT SAYS SO IS
# `transfers`, NOT `consumes` (spec § 13). `consumes` would end the socket's
# life at the call and owe nothing after it, so the stream's close would end
# a life nobody counts, and a stream never closed would leave its socket open
# with the leak check silent. `transfers hero_net_close` hands the life into
# the handle the result begins, which `hero_stream_close` then ends, so the
# socket is owed for as long as the stream is, and given back once, by it.
# And a transfer into a result that is `nullptr` is not made: where no stream
# was made the socket stays the program's, open, which is what C answers.

use io/hero_stream
use net/hero_net
use threads/hero_os as threads_floor

extern "hero_stream_net.h"
    # The two calls the marks below name, the one that ends a socket's life
    # and the one that ends a stream's: a mark names a releaser this group
    # declares, and the header, which includes `hero_net.h` and
    # `hero_stream.h`, declares both. Their Heroes functions are the two other
    # floors' `close`, so none stands here.

    function hero_net_close(s: hero_net.Socket consumes) -> i64
    function hero_stream_close(s: hero_stream.Stream consumes) -> i64
    function hero_stream_net_of(s: hero_net.Socket transfers hero_net_close) -> hero_stream.Stream acquires hero_stream_close
    # The deadline of the socket under a stream, set through the stream.
    #
    # - `s`: a stream `hero_stream_net_of` made; it stays open.
    # - `ms`: milliseconds from now; 0 a deadline already passed,
    #   `HERO_NET_FOREVER` none, below -1 refused.
    function hero_stream_net_set_deadline(s: hero_stream.Stream, ms: i64) -> i64
    function hero_stream_net_shutdown(s: hero_stream.Stream, how: i64) -> i64
    function hero_stream_net_set_option(s: hero_stream.Stream, option: i64, value: i64) -> i64
    function hero_stream_net_option(s: hero_stream.Stream, option: i64) -> i64

# A stream over the connection `s`, or `nullptr`. Its reads are `s`'s
# receives, its writes `s`'s sends, and its close closes `s`: from this call
# the socket is given back by the stream's close and never by its own. Where
# no stream is made, `s` names a listener, a datagram socket or no open
# socket, it stays the caller's, and `hero_stream.last_error` names why.
#
# - `s`: the connection made a stream: from this call the stream's close gives
#   it back, never its own. A listener, a datagram socket or no open socket
#   makes no stream and stays the caller's.
function of(@s: hero_net.Socket) -> hero_stream.Stream
    return hero_stream_net_of(s)

# 0 once every wait of the stream `s` over a socket ends `ms` milliseconds
# from now, waits already under way among them, or -1: the socket's deadline
# moved after the socket became the stream, as `hero_net.set_deadline` moves
# it.
#
# - `s`: a stream `of` made; it stays open.
# - `ms`: milliseconds from now; 0 a deadline already passed, so every wait
#   of the stream ends at once; `hero_net.HERO_NET_FOREVER` takes the
#   deadline away; below -1 fails `HERO_STREAM_INVALID`.
#
# Fails `HERO_STREAM_INVALID` for a stream over no socket,
# `HERO_STREAM_NOT_OPEN` for no open stream.
function set_deadline(s: hero_stream.Stream, ms: i64) -> i64
    return hero_stream_net_set_deadline(s, ms: ms)

# 0 once one direction of the connection under `s` is closed, `how` one of
# `hero_net.HERO_NET_SHUT_...`, or -1, as `hero_net.shutdown` answers, the
# kind the stream's.
#
# - `s`: a stream `of` made; it stays open, and its close still gives the
#   socket back.
# - `how`: `hero_net.HERO_NET_SHUT_READ`, after which a read answers 0;
#   `hero_net.HERO_NET_SHUT_WRITE`, after which the peer's read answers 0 once
#   it has read what was sent; or `hero_net.HERO_NET_SHUT_BOTH`. Any other
#   value is `HERO_STREAM_INVALID`.
function shutdown(s: hero_stream.Stream, how: i64) -> i64
    return hero_stream_net_shutdown(s, how: how)

# 0 once the option `option` of the socket under `s` is `value`, as
# `hero_net.set_option` answers, or -1.
#
# - `s`: a stream `of` made; it stays open.
# - `option`: `hero_net.HERO_NET_OPTION_NO_DELAY` or
#   `hero_net.HERO_NET_OPTION_KEEP_ALIVE`, a connection's; another is
#   `HERO_STREAM_INVALID`.
# - `value`: 1 on, 0 off; any other value is `HERO_STREAM_INVALID`.
function set_option(s: hero_stream.Stream, option: i64, value: i64) -> i64
    return hero_stream_net_set_option(s, option: option, value: value)

# 1 or 0, the option `option` of the socket under `s`, or -1.
#
# - `s`: a stream `of` made; it stays open.
# - `option`: `hero_net.HERO_NET_OPTION_NO_DELAY` or
#   `hero_net.HERO_NET_OPTION_KEEP_ALIVE`; another is `HERO_STREAM_INVALID`.
function option_of(s: hero_stream.Stream, option: i64) -> i64
    return hero_stream_net_option(s, option: option)

# For the tests of the handle tag alone (2026-11-16): doors of the three
# tables bound with `ptr`, so a test can hand one table's handle to
# another's, which no typed binding lets a program do.
extern "hero_stream.h"
    constant HERO_STREAM_STD_OUT: i64
    function hero_stream_std(which: i64) -> ptr

extern "hero_net.h"
    function hero_net_port(s: ptr) -> i64

extern "hero_proc.h"
    constant HERO_PROC_NOT_OPEN: i64
    function hero_proc_id(p: ptr) -> i64
    function hero_proc_last_error() -> i64

## Tests

test "a connection made a stream is written through it, read back on the other end, and closed once by the stream"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    client @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    accepted @= hero_net.test_accept_from(listener, port: hero_net.port_of(client))
    assert accepted != nullptr
    assert hero_net.set_deadline(client, ms: 5000) == 0
    assert hero_net.set_deadline(accepted, ms: 5000) == 0
    stream @= of(@client)
    assert stream != nullptr
    assert hero_stream.kind(stream) == hero_stream.HERO_STREAM_KIND_SOCKET
    hello: [u8] @= [104, 105]
    assert hero_stream.write(stream, @hello, n: 2) == 2
    heard: [u8] @= []
    got = hero_net.recv(accepted, @heard, n: 8)
    assert got >= 1 && got <= 2
    assert heard[0] == 104

    # And the other way: what the peer sends, the stream reads.
    back: [u8] @= [33]
    assert hero_net.send(accepted, @back, n: 1) == 1
    into: [u8] @= []
    assert hero_stream.read(stream, @into, n: 8) == 1
    assert into[0] == 33
    assert hero_stream.close(@stream) == 0

    # The socket was closed with the stream: the peer reads the bytes it had
    # not, then its end.
    rest: [u8] @= []

    if got == 1
        assert hero_net.recv(accepted, @rest, n: 8) == 1
    assert hero_net.recv(accepted, @rest, n: 8) == 0
    assert hero_net.close(@accepted) == 0
    assert hero_net.close(@listener) == 0

# The edges: a socket with no peer and no socket at all make no stream, and a
# socket refused stays the caller's to close.
test "a listener, a datagram socket and nullptr make no stream, and what was refused stays open"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    none = hero_stream_net_of(s: listener)
    assert none == nullptr
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_INVALID
    assert hero_net.port_of(listener) > 0
    assert hero_net.close(@listener) == 0
    box @= hero_net.udp(address: "127.0.0.1", port: 0)
    also = hero_stream_net_of(s: box)
    assert also == nullptr
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_INVALID
    assert hero_net.close(@box) == 0
    nothing = hero_stream_net_of(s: nullptr)
    assert nothing == nullptr
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_NOT_OPEN

# A deadline is the socket's, set before it is a stream: a read past it is
# the stream's `HERO_STREAM_TIMED_OUT`, and the socket's own kind says the same.
test "a deadline set on the socket ends a read of the stream, told as a deadline by both"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    client @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    accepted @= hero_net.test_accept_from(listener, port: hero_net.port_of(client))
    assert hero_net.set_deadline(client, ms: 200) == 0
    stream @= of(@client)
    into: [u8] @= []
    assert hero_stream.read(stream, @into, n: 8) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_TIMED_OUT
    assert hero_net.last_error() == hero_net.HERO_NET_TIMED_OUT
    assert hero_stream.close(@stream) == 0
    assert hero_net.close(@accepted) == 0
    assert hero_net.close(@listener) == 0

# The deadline set again after the socket became a stream, which
# until then nothing could move.
test "set_deadline: a stream's deadline moved, a read ending at it, then taken away by HERO_NET_FOREVER, and what is no stream over a socket"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    client @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    accepted @= hero_net.test_accept_from(listener, port: hero_net.port_of(client))
    stream @= of(@client)
    assert stream != nullptr
    assert set_deadline(stream, ms: 150) == 0
    into: [u8] @= []
    assert hero_stream.read(stream, @into, n: 8) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_TIMED_OUT
    assert set_deadline(stream, ms: hero_net.HERO_NET_FOREVER) == 0
    one: [u8] @= [9]
    assert hero_net.send(accepted, @one, n: 1) == 1
    assert hero_stream.read(stream, @into, n: 8) == 1 && into[0] == 9
    assert set_deadline(stream, ms: -2) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_INVALID
    pipe_reader: hero_stream.Stream @= nullptr
    pipe_writer: hero_stream.Stream @= nullptr
    assert hero_stream.pipe(reader: @pipe_reader, writer: @pipe_writer) == 0
    assert set_deadline(pipe_reader, ms: 100) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_INVALID
    assert hero_stream.close(@pipe_reader) == 0
    assert hero_stream.close(@pipe_writer) == 0
    none: hero_stream.Stream = nullptr
    assert set_deadline(none, ms: 100) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_NOT_OPEN
    assert hero_stream.close(@stream) == 0
    assert hero_net.close(@accepted) == 0
    assert hero_net.close(@listener) == 0

# THE TIME 0 AND `HERO_NET_FOREVER` through the stream (2026-11-20,
# M-rebel-library step 83a): 0 ends a read with nothing come at once, well
# before the byte the far end sends 400 ms after it starts, and
# `HERO_NET_FOREVER` takes the deadline away, the next read waiting for it.
test "set_deadline: 0 ends a read of the stream at once, before a byte sent 400 ms later, and HERO_NET_FOREVER waits for that byte"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    client @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    accepted @= hero_net.test_accept_from(listener, port: hero_net.port_of(client))
    stream @= of(@accepted)
    assert stream != nullptr
    assert set_deadline(stream, ms: 0) == 0
    n = hero_net.number(@client)
    assert n > 0
    why: i64 @= 0
    far = threads_floor.start(hero_net.test_send_late, arg: n, bytes: 0, why: @why)
    assert far >= 0
    into: [u8] @= []
    assert hero_stream.read(stream, @into, n: 8) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_TIMED_OUT
    assert set_deadline(stream, ms: hero_net.HERO_NET_FOREVER) == 0
    assert hero_stream.read(stream, @into, n: 8) == 1
    assert into[0] == 42
    assert threads_floor.finish(far) == 0
    assert hero_stream.close(@stream) == 0
    assert hero_net.close(@listener) == 0

test "shutdown, set_option and option_of through a stream: the writing side closed is the peer's end, no delay set and read back"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    client @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    accepted @= hero_net.test_accept_from(listener, port: hero_net.port_of(client))
    assert hero_net.set_deadline(accepted, ms: 5000) == 0
    stream @= of(@client)
    assert set_option(stream, option: hero_net.HERO_NET_OPTION_NO_DELAY, value: 1) == 0
    assert option_of(stream, option: hero_net.HERO_NET_OPTION_NO_DELAY) == 1
    assert set_option(stream, option: hero_net.HERO_NET_OPTION_BROADCAST, value: 1) == -1
    assert hero_stream.last_error() == hero_stream.HERO_STREAM_INVALID
    assert shutdown(stream, how: hero_net.HERO_NET_SHUT_WRITE) == 0
    heard: [u8] @= []
    assert hero_net.recv(accepted, @heard, n: 8) == 0
    assert shutdown(stream, how: hero_net.HERO_NET_SHUT_READ) == 0
    assert hero_stream.read(stream, @heard, n: 8) == 0
    assert hero_stream.close(@stream) == 0
    assert hero_net.close(@accepted) == 0
    assert hero_net.close(@listener) == 0

# The coordinator's reproducer of 2026-11-16 12:47, a program that is not
# kept: until the tag, the stream of the first client and the socket of a
# later connection could be one value, which the runtime's set of ended
# handles remembered from the transfer of the later socket into its stream,
# and the first stream's read aborted the program, exit 134.
test "two connections accepted, made streams and closed, then the first client's stream reads its end and closes: no handle of one table is another's"
    listener @= hero_net.listen(address: "127.0.0.1", port: 0)
    first_socket @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    first_port = hero_net.port_of(first_socket)
    first @= of(@first_socket)
    assert first != nullptr
    one_socket @= hero_net.test_accept_from(listener, port: first_port)
    one @= of(@one_socket)
    assert hero_stream.close(@one) == 0
    second_socket @= hero_net.connect(address: "127.0.0.1", port: hero_net.port_of(listener))
    second_port = hero_net.port_of(second_socket)
    second @= of(@second_socket)
    assert second != nullptr
    two_socket @= hero_net.test_accept_from(listener, port: second_port)
    two @= of(@two_socket)
    assert hero_stream.close(@two) == 0
    into: [u8] @= []
    assert hero_stream.read(first, @into, n: 10) == 0
    assert hero_stream.close(@first) == 0
    assert hero_stream.close(@second) == 0
    assert hero_net.close(@listener) == 0

test "a stream handed to a socket's door and to a process's door is one they never issued, not open, never a slot of theirs"
    out = hero_stream_std(HERO_STREAM_STD_OUT)
    assert out != nullptr
    assert hero_net_port(out) == -1
    assert hero_net.last_error() == hero_net.HERO_NET_NOT_OPEN
    assert hero_proc_id(out) == -1
    assert hero_proc_last_error() == HERO_PROC_NOT_OPEN
