## Tests

# The three certificates of the samples' chain, read as Python's
# `cryptography` and Go read them (2026-11-17).
test "decode_certificate: the chain's three certificates, their names, serials, lengths and algorithms"
    root = parse_certificate(samples.root()).must()
    inter = parse_certificate(samples.intermediate()).must()
    leaf = parse_certificate(samples.leaf()).must()
    assert format_name(root.subject) == "CN=Heroes Root CA,O=Heroes Test,C=IT"
    assert format_name(inter.subject) == "CN=Heroes Intermediate,OU=Ground\\, Control,O=Heroes Test,C=IT"
    assert format_name(leaf.subject) == "1.2.840.113549.1.9.1=ops@example.com,CN=example.com"
    assert leaf.issuer.der == inter.subject.der
    assert root.version == 3 && leaf.version == 3
    assert big.format_base(n: leaf.serial, base: 16) == "fedcba98765432100123456789abcdef"
    assert big.format_base(n: inter.serial, base: 16) == "1234"
    assert [root.der.len(), inter.der.len(), leaf.der.len()] == [493, 1090, 851]
    assert [root.tbs.len(), inter.tbs.len(), leaf.tbs.len()] == [371, 968, 571]
    assert [root.signature.len(), inter.signature.len(), leaf.signature.len()] == [103, 103, 256]
    assert root.signature_algorithm.oid.dotted == "1.2.840.10045.4.3.3"
    assert leaf.signature_algorithm.oid.dotted == "1.2.840.113549.1.1.11"
    assert !leaf.signature_algorithm.parameters.is_err()
    assert root.signature_algorithm.parameters.is_err()
    assert leaf.not_before == time.DateTime(year: 2026, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert leaf.not_after.year == 2027
    assert leaf.issuer_unique_id.is_err() && leaf.subject_unique_id.is_err()

test "decode_certificate: the extensions of the root and the leaf, an unknown one kept"
    root = parse_certificate(samples.root()).must()
    leaf = parse_certificate(samples.leaf()).must()
    assert !root.extensions.basic_constraints.is_err() && root.extensions.basic_constraints.must().is_ca
    assert root.extensions.basic_constraints.must().path_len.must() == 1
    assert root.extensions.key_usage.must().key_cert_sign && root.extensions.key_usage.must().crl_sign
    assert !root.extensions.key_usage.must().digital_signature
    assert bytes.format_hex(root.extensions.subject_key_id.must()) == "0c0981435940ee87770f300619d3d100cf3c39ef"
    ext = leaf.extensions
    assert !ext.basic_constraints.is_err() && !ext.basic_constraints.must().is_ca && ext.basic_constraints.must().path_len.is_err()
    assert ext.key_usage.must().digital_signature && !ext.key_usage.must().key_cert_sign
    assert ext.extended_key_usage.must() == [asn1.Oid(dotted: SERVER_AUTH), asn1.Oid(dotted: CLIENT_AUTH)]
    assert bytes.format_hex(ext.authority_key_id.must().key_id.must()) == "a3228554f157035feca224e54a38ebd49579c98b"
    assert ext.alt_names.must().len() == 6
    assert ext.alt_names.must()[0] == .dns(name: "example.com")
    assert ext.alt_names.must()[1] == .dns(name: "*.app.example.com")
    assert ext.alt_names.must()[2] == .ip(address: net.parse_host("192.0.2.1").must())
    assert ext.alt_names.must()[4] == .email(address: "ops@example.com")
    assert ext.alt_names.must()[5] == .uri(uri: "https://example.com/")
    assert ext.unknown.len() == 1
    assert ext.unknown[0].oid.dotted == "1.3.6.1.4.1.55555.1" && !ext.unknown[0].critical
    assert ext.list.len() == 7

test "decode_certificate: the intermediate's points, access, policies and name constraints"
    ext = parse_certificate(samples.intermediate()).must().extensions
    assert ext.basic_constraints.must().path_len.must() == 0
    assert ext.crl_distribution_points.must()[0].full_name == [.uri(uri: "http://crl.example.com/root.crl")]
    assert ext.crl_distribution_points.must()[0].reasons.is_err()
    assert ext.authority_info_access.must().len() == 2
    assert ext.authority_info_access.must()[0].method.dotted == OCSP
    assert ext.authority_info_access.must()[1].location == .uri(uri: "http://ca.example.com/root.der")
    policy = ext.policies.must()[0]
    assert policy.oid.dotted == "2.23.140.1.2.1"
    assert policy.qualifiers[0].cps_uri == "https://cps.example.com"
    assert policy.qualifiers[1].organization == "Heroes"
    assert policy.qualifiers[1].notice_numbers == [1, 2]
    assert policy.qualifiers[1].explicit_text == "Explicit text"
    assert ext.name_constraints.must().permitted.len() == 3
    assert ext.name_constraints.must().permitted[1].base == .ip_network(network: net.parse_network("192.0.2.0/24").must())
    assert ext.name_constraints.must().excluded[0].base == .dns(name: "bad.example.com")
    assert ext.unknown.len() == 0

test "decode_certificate: every cut of the leaf fails, every byte changed reads or fails, never aborts"
    der = parse_certificate(samples.leaf()).must().der
    step = 7

    for n in range(from: 0, to: der.len() / step)
        assert decode_certificate(der.slice(from: 0, to: n * step)).is_err()

    changes: [u8] = [0x00, 0x80, 0xff]

    for at in range(from: 0, to: der.len())
        for changed in changes
            mutated @= der
            mutated[at] @ changed

            match decode_certificate(mutated)
                .ok _  => _ = 0
                .err e => assert e.code == INVALID || e.code == NOT_TEXT || e.code == DOES_NOT_FIT

test "decode_certificate: bytes after it, and nothing"
    der @= parse_certificate(samples.root()).must().der
    der @ der.push(0)
    assert decode_certificate(der).is_err()
    assert decode_certificate([]).is_err()

test "is_signed_by: ECDSA over P-384, RSA PKCS #1, RSA-PSS, a key of another kind, and Ed25519 where the platform has it"
    root = parse_certificate(samples.root()).must()
    inter = parse_certificate(samples.intermediate()).must()
    leaf = parse_certificate(samples.leaf()).must()
    assert is_signed_by(certificate: root, issuer: root).must()
    assert is_signed_by(certificate: inter, issuer: root).must()
    assert is_signed_by(certificate: leaf, issuer: inter).must()
    assert is_signed_by(certificate: parse_certificate(samples.pss()).must(), issuer: inter).must()
    assert is_signed_by(certificate: leaf, issuer: root).is_err()
    ed = parse_certificate(samples.ed25519()).must()

    if keypairs.is_available(.ed25519)
        assert is_signed_by(certificate: ed, issuer: ed).must()
    else
        match is_signed_by(certificate: ed, issuer: ed)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED

test "verify_signature: a byte of the message changed is false, never a failure"
    inter = parse_certificate(samples.intermediate()).must()
    leaf = parse_certificate(samples.leaf()).must()
    changed @= leaf.tbs
    changed[100] @ 0x00
    assert !verify_signature(key: inter.public_key, algorithm: leaf.signature_algorithm, message: changed, signature: leaf.signature).must()

test "algorithm_of: each of the nine schemes read back by scheme_of, parameters NULL for RSA PKCS #1 and none for ECDSA and Ed25519"
    schemes_all: [keypairs.Scheme] = [
        .ed25519
        .ecdsa_sha256
        .ecdsa_sha384
        .rsa_pss_sha256
        .rsa_pss_sha384
        .rsa_pss_sha512
        .rsa_pkcs1_sha256
        .rsa_pkcs1_sha384
        .rsa_pkcs1_sha512
    ]

    for scheme in schemes_all
        assert scheme_of(algorithm_of(scheme)).must() == scheme

    assert algorithm_of(.rsa_pkcs1_sha256).parameters.must() == .null_value
    assert algorithm_of(.ecdsa_sha384).parameters.is_err()
    assert algorithm_of(.ed25519).parameters.is_err()
    assert algorithm_of(.ed25519).oid.dotted == "1.3.101.112"

test "scheme_of and kind_of: each certificate's"
    assert scheme_of(parse_certificate(samples.root()).must().signature_algorithm).must() == .ecdsa_sha384
    assert scheme_of(parse_certificate(samples.pss()).must().signature_algorithm).must() == .rsa_pss_sha256
    assert kind_of(parse_certificate(samples.root()).must().public_key).must() == .p384
    assert kind_of(parse_certificate(samples.intermediate()).must().public_key).must() == .rsa(bits: 2048)
    assert kind_of(parse_certificate(samples.leaf()).must().public_key).must() == .p256
    assert kind_of(parse_certificate(samples.ed25519()).must().public_key).must() == .ed25519

test "is_valid_at: inside, at both ends, outside, and the validity that does not end"
    leaf = parse_certificate(samples.leaf()).must()
    assert is_valid_at(certificate: leaf, at: time.date(year: 2026, month: 6, day: 1).must())
    assert is_valid_at(certificate: leaf, at: time.date(year: 2026, month: 1, day: 1).must())
    assert is_valid_at(certificate: leaf, at: time.date(year: 2027, month: 1, day: 1).must())
    assert !is_valid_at(certificate: leaf, at: time.date(year: 2027, month: 1, day: 2).must())
    assert !is_valid_at(certificate: leaf, at: time.date(year: 2025, month: 12, day: 31).must())
    ed = parse_certificate(samples.ed25519()).must()
    assert ed.not_after == time.DateTime(year: 9999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0)
    assert is_valid_at(certificate: ed, at: time.max_instant())

test "is_for_host: Go's answers on the leaf's names"
    leaf = parse_certificate(samples.leaf()).must()
    yes = [
        "example.com"
        "EXAMPLE.com"
        "example.com."
        "a.app.example.com"
        "192.0.2.1"
        "2001:db8::1"
        "[2001:db8::1]"
        "2001:0db8:0:0:0:0:0:1"
        "::ffff:192.0.2.1"
    ]
    no = [
        "a.example.com"
        "a.b.example.com"
        "app.example.com"
        "x.y.app.example.com"
        ".example.com"
        "xexample.com"
        "example.org"
        "192.0.2.2"
        "*.example.com"
        ""
        "a..example.com"
        "_srv.example.com"
        "a.example.com.."
        "localhost"
    ]

    for h in yes
        assert is_for_host(certificate: leaf, host: h)

    for h in no
        assert !is_for_host(certificate: leaf, host: h)

test "is_for_address: both families, a mapped IPv4, and an address not named"
    leaf = parse_certificate(samples.leaf()).must()
    assert is_for_address(certificate: leaf, address: net.parse_host("2001:db8::1").must())
    assert is_for_address(certificate: leaf, address: net.parse_host("::ffff:192.0.2.1").must())
    assert !is_for_address(certificate: leaf, address: net.parse_host("192.0.2.2").must())

test "chain_of: the leaf to its root from a pool in another order, a self-issued leaf, and an empty pool"
    root = parse_certificate(samples.root()).must()
    inter = parse_certificate(samples.intermediate()).must()
    leaf = parse_certificate(samples.leaf()).must()
    ed = parse_certificate(samples.ed25519()).must()
    chain = chain_of(leaf: leaf, pool: [ed, root, leaf, inter])
    assert chain.len() == 3
    assert chain[1].der == inter.der && chain[2].der == root.der
    assert chain_of(leaf: ed, pool: [root, inter]).len() == 1
    assert chain_of(leaf: leaf, pool: []).len() == 1

test "verify_chain: Go's and Python's answers on the samples"
    root = parse_certificate(samples.root()).must()
    inter = parse_certificate(samples.intermediate()).must()
    leaf = parse_certificate(samples.leaf()).must()
    june = time.date(year: 2026, month: 6, day: 1).must()
    good = Verification(roots: [root], at: june, purpose: SERVER_AUTH, host: "a.app.example.com")
    assert !verify_chain(chain: [leaf, inter], options: good).is_err()
    assert !verify_chain(chain: [leaf, inter, root], options: good).is_err()
    late = Verification(roots: [root], at: time.date(year: 2027, month: 6, day: 1).must(), purpose: "", host: "")
    assert verify_chain(chain: [leaf, inter], options: late).is_err()
    assert verify_chain(chain: [leaf], options: good).is_err()
    signing = Verification(roots: [root], at: june, purpose: CODE_SIGNING, host: "")
    assert verify_chain(chain: [leaf, inter], options: signing).is_err()
    elsewhere = Verification(roots: [root], at: june, purpose: "", host: "a.example.com")
    assert verify_chain(chain: [leaf, inter], options: elsewhere).is_err()
    plain = Verification(roots: [root], at: june, purpose: "", host: "")

    for text in [samples.excluded(), samples.outside(), samples.outside_ip()]
        match verify_chain(chain: [parse_certificate(text).must(), inter], options: plain)
            .ok _  => assert false
            .err e => assert e.code == INVALID

    assert verify_chain(chain: [], options: plain).is_err()
    assert verify_chain(chain: [inter, leaf], options: plain).is_err()

test "decode_request: the request's subject, attributes, extensions and signature"
    request = parse_request(samples.request()).must()
    assert format_name(request.subject) == "O=Heroes Test,CN=request.example.com"
    assert request.version == 1
    assert request.attributes.len() == 2
    assert request.attributes[0].oid.dotted == CHALLENGE_PASSWORD
    assert request.attributes[1].oid.dotted == EXTENSION_REQUEST
    assert request.extensions.alt_names.must() == [.dns(name: "request.example.com")]
    assert is_request_signed(request).must()
    assert parse_request("no request").is_err()

test "decode_crl: the list's dates, number, entries and signature"
    crl = parse_crl(samples.crl()).must()
    inter = parse_certificate(samples.intermediate()).must()
    assert crl.version == 2
    assert crl.issuer.der == inter.subject.der
    assert crl.this_update.year == 2026 && crl.this_update.month == 1
    assert !crl.next_update.is_err() && crl.next_update.must().month == 2
    assert !crl.extensions.crl_number.is_err() && big.int_of(crl.extensions.crl_number.must()).must() == 42
    assert !crl.extensions.authority_key_id.is_err()
    assert crl.revoked.len() == 2
    first = crl.revoked[0]
    assert big.int_of(first.serial).must() == 0x1001
    assert first.date.day == 2
    assert !first.extensions.reason.is_err() && first.extensions.reason.must() == .key_compromise
    assert first.extensions.invalidity_date.must() == time.DateTime(year: 2025, month: 12, day: 31, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert crl.revoked[1].extensions.reason.is_err()
    assert is_crl_signed_by(crl: crl, issuer: inter).must()
    assert revoked_of(crl: crl, serial: big.from_int(0x1002)).must().date.day == 3

    match revoked_of(crl: crl, serial: big.from_int(0x9999))
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

test "to_extensions: an extension twice, and a known one malformed"
    twice = [
        Extension(oid: asn1.Oid(dotted: SUBJECT_KEY_ID), critical: false, value: [0x04, 0x00])
        Extension(oid: asn1.Oid(dotted: SUBJECT_KEY_ID), critical: false, value: [0x04, 0x00])
    ]
    assert to_extensions(twice).is_err()
    assert to_extensions([Extension(oid: asn1.Oid(dotted: KEY_USAGE), critical: true, value: [0x05, 0x00])]).is_err()
    assert to_extensions(
        [Extension(oid: asn1.Oid(dotted: REASON_CODE), critical: false, value: [0x0a, 0x01, 0x07])]
    ).is_err()

test "to_general_name: a mask that is not ones then zeros, an address of 5 bytes, and a tag past 8"
    assert to_general_name(
        .primitive(tag: asn1.Tag(kind: .context_specific, number: 7, constructed: false), content: [192, 0, 2, 0, 255, 0, 255, 0])
    ).is_err()
    assert to_general_name(
        .primitive(tag: asn1.Tag(kind: .context_specific, number: 7, constructed: false), content: [1, 2, 3, 4, 5])
    ).is_err()
    assert to_general_name(
        .primitive(tag: asn1.Tag(kind: .context_specific, number: 9, constructed: false), content: [])
    ).is_err()
    assert to_general_name(.null_value).is_err()

test "text_of: an attribute present, one absent, and a name with none"
    leaf = parse_certificate(samples.leaf()).must()
    assert text_of(n: leaf.subject, oid: EMAIL_ADDRESS).must() == "ops@example.com"

    match text_of(n: leaf.subject, oid: COUNTRY_NAME)
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

test "parse_certificates: a bundle with another block and text between"
    text = "Roots:\n" + samples.root() + samples.request() + "and\n" + samples.intermediate()
    certs = parse_certificates(text).must()
    assert certs.len() == 2
    assert parse_certificates("none here").must().len() == 0
    assert parse_certificate(samples.request()).is_err()

test "new_attribute: the string type of each type RFC 5280 names, bounds counted in characters, and what is refused"
    assert asn1.tag_of(new_attribute(oid: COUNTRY_NAME, text: "IT").must().value).number == asn1.PRINTABLE_STRING
    assert asn1.tag_of(new_attribute(oid: SERIAL_NUMBER, text: "42").must().value).number == asn1.PRINTABLE_STRING
    assert asn1.tag_of(new_attribute(oid: COMMON_NAME, text: "example.org").must().value).number == asn1.UTF8_STRING
    assert asn1.tag_of(new_attribute(oid: EMAIL_ADDRESS, text: "ops@example.org").must().value).number == asn1.IA5_STRING
    assert asn1.tag_of(new_attribute(oid: DOMAIN_COMPONENT, text: "example").must().value).number == asn1.IA5_STRING
    assert asn1.tag_of(new_attribute(oid: "2.5.4.9", text: "1 Main Street").must().value).number == asn1.UTF8_STRING
    assert !new_attribute(oid: COMMON_NAME, text: repeat("é", to_u64(64).must())).is_err()
    assert !new_attribute(oid: COMMON_NAME, text: repeat("a", to_u64(64).must())).is_err()
    assert new_attribute(oid: COMMON_NAME, text: repeat("a", to_u64(65).must())).is_err()
    assert new_attribute(oid: ORGANIZATION_NAME, text: repeat("é", to_u64(65).must())).is_err()
    assert new_attribute(oid: LOCALITY_NAME, text: repeat("a", to_u64(129).must())).is_err()
    assert !new_attribute(oid: LOCALITY_NAME, text: repeat("a", to_u64(128).must())).is_err()
    assert new_attribute(oid: COMMON_NAME, text: "").is_err()
    assert new_attribute(oid: COUNTRY_NAME, text: "ITA").is_err()
    assert new_attribute(oid: COUNTRY_NAME, text: "I").is_err()
    assert new_attribute(oid: COUNTRY_NAME, text: "i*").is_err()
    assert new_attribute(oid: EMAIL_ADDRESS, text: "pè@example.org").is_err()
    assert new_attribute(oid: "1.2.x", text: "a").is_err()

    match new_attribute(oid: COUNTRY_NAME, text: "ITA")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the attribute 2.5.4.6 has 3 characters, where RFC 5280 asks exactly 2"

test "new_name: OpenSSL's subject bytes, a relative name in DER's order, the empty name and a relative name of nothing"
    root = parse_certificate(openssl.root()).must()
    name = new_name(
        [[new_attribute(oid: COUNTRY_NAME, text: "IT").must()], [new_attribute(oid: ORGANIZATION_NAME, text: "Heroes Test").must()], [new_attribute(oid: COMMON_NAME, text: "Heroes Made Root").must()]]
    ).must()
    assert name.der == root.subject.der
    assert format_name(name) == "CN=Heroes Made Root,O=Heroes Test,C=IT"
    both = new_name(
        [[new_attribute(oid: COMMON_NAME, text: "zed").must(), new_attribute(oid: ORGANIZATION_NAME, text: "a").must()]]
    ).must()
    assert both.rdns[0][0].oid.dotted == ORGANIZATION_NAME
    assert both.rdns == to_name(asn1.decode_der(both.der).must()).must().rdns
    assert new_name([]).must().der == [0x30, 0x00]
    assert new_name([[]]).is_err()

test "random_serial: positive, 159 bits at most, and not the same twice"
    a = random_serial().must()
    b = random_serial().must()
    assert big.compare(a: a, b: big.from_int(0)) > 0
    assert big.bit_len(a) <= 159 && big.bit_len(b) <= 159
    assert big.compare(a: a, b: b) != 0

test "from_general_name: every kind of name written and read back, and what is refused"
    key @= keypairs.generate(.p256).must()
    house = new_name([[new_attribute(oid: COMMON_NAME, text: "Names").must()]]).must()
    names: [GeneralName] = [
        .dns(name: "a.example.org")
        .dns(name: "*.example.org")
        .email(address: "x@example.org")
        .uri(uri: "https://example.org/")
        .ip(address: net.parse_host("192.0.2.1").must())
        .ip(address: net.parse_host("2001:db8::1").must())
        .registered_id(oid: asn1.Oid(dotted: "1.2.3.4"))
        .other_name(type_id: asn1.Oid(dotted: "1.3.6.1.4.1.311.20.2.3"), value: .text(kind: .utf8, v: "user@example.org"))
        .directory(name: house)
        .x400_address(der: [0xa3, 0x00])
    ]
    profile @= default_profile()
    profile.alt_names @ names
    template = CertificateTemplate(
        serial: big.from_int(7),
        subject: house,
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    built = create_self_signed(template, signer: key, scheme: .ecdsa_sha256).must()
    assert built.extensions.alt_names.must() == names
    assert built.extensions.list[1].oid.dotted == SUBJECT_ALT_NAME && !built.extensions.list[1].critical

    refused: [[GeneralName]] = [
        [.dns(name: "")]
        [.dns(name: "127.0.0.1")]
        [.dns(name: "::1")]
        [.dns(name: "é.example.org")]
        [.email(address: "")]
        [.uri(uri: "")]
        [.ip(address: net.Host(bytes: [1, 2, 3, 4, 5], zone: ""))]
        [.ip_network(network: net.parse_network("10.0.0.0/8").must())]
        [.x400_address(der: [0xa4, 0x00])]
        [.edi_party(der: [0xa3, 0x00])]
        [.x400_address(der: [0x30])]
    ]

    for choice in refused
        wrong @= template
        bad @= default_profile()
        bad.alt_names @ choice
        wrong.profile @ bad
        assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()

    _ = keypairs.close_private(@key).is_err()

test "create_self_signed: OpenSSL's bytes for an Ed25519 root with a path length, key usage and key identifier"
    if keypairs.is_available(.ed25519)
        key @= keypairs.parse_private_pem(openssl.ed25519_key()).must()
        root = parse_certificate(openssl.root()).must()
        usage = KeyUsage(
            digital_signature: false,
            content_commitment: false,
            key_encipherment: false,
            data_encipherment: false,
            key_agreement: false,
            key_cert_sign: true,
            crl_sign: true,
            encipher_only: false,
            decipher_only: false
        )
        profile @= default_profile()
        profile.key_usage @ usage
        profile.role @ .limited_authority(path_len: 1)
        template = CertificateTemplate(
            serial: big.parse_base(s: "0102030405060708090a0b0c0d0e0f1011121314", base: 16).must(),
            subject: root.subject,
            not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            profile: profile,
            ocsp_urls: [],
            issuer_urls: [],
            crl_urls: []
        )
        built = create_self_signed(template, signer: key, scheme: .ed25519).must()
        assert built.der == root.der
        assert format_certificate(built) == openssl.root()
        assert is_self_issued(built) && is_signed_by(certificate: built, issuer: built).must()
        _ = keypairs.close_private(@key).is_err()
    else
        assert keypairs.parse_private_pem(openssl.ed25519_key()).is_err()

test "create_certificate: OpenSSL's bytes for a leaf of a P-256 key under the Ed25519 root, with every extension"
    if keypairs.is_available(.ed25519)
        issuer_key @= keypairs.parse_private_pem(openssl.ed25519_key()).must()
        subject_key @= keypairs.parse_private_pem(openssl.p256_key()).must()
        root = parse_certificate(openssl.root()).must()
        leaf = parse_certificate(openssl.leaf()).must()
        usage = KeyUsage(
            digital_signature: true,
            content_commitment: false,
            key_encipherment: false,
            data_encipherment: false,
            key_agreement: false,
            key_cert_sign: false,
            crl_sign: false,
            encipher_only: false,
            decipher_only: false
        )
        profile @= default_profile()
        profile.key_usage @ usage
        profile.role @ .end_entity
        profile.extended_key_usage @ [asn1.Oid(dotted: SERVER_AUTH), asn1.Oid(dotted: CLIENT_AUTH)]
        profile.alt_names @ [
            .dns(name: "made.example.org")
            .dns(name: "*.made.example.org")
            .ip(address: net.parse_host("192.0.2.7").must())
            .ip(address: net.parse_host("2001:db8::7").must())
            .email(address: "ops@example.org")
            .uri(uri: "https://made.example.org/")
        ]
        template = CertificateTemplate(
            serial: big.parse_base(s: "7edcba9876543210", base: 16).must(),
            subject: new_name([[new_attribute(oid: COMMON_NAME, text: "made.example.org").must()]]).must(),
            not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            not_after: time.DateTime(year: 2027, month: 2, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            profile: profile,
            ocsp_urls: ["http://ocsp.example.org/"],
            issuer_urls: ["http://ca.example.org/root.der"],
            crl_urls: ["http://ca.example.org/root.crl"]
        )
        built = create_certificate(
            template,
            subject_key: public_key_of(subject_key).must(),
            issuer: root,
            signer: issuer_key,
            scheme: .ed25519
        ).must()
        assert built.der == leaf.der
        assert is_signed_by(certificate: built, issuer: root).must()
        assert built.issuer.der == root.subject.der
        _ = keypairs.close_private(@issuer_key).is_err()
        _ = keypairs.close_private(@subject_key).is_err()
    else
        assert keypairs.parse_private_pem(openssl.ed25519_key()).is_err()

test "create_self_signed: OpenSSL's bytes for an RSA PKCS #1 v1.5 server's own certificate"
    key @= keypairs.parse_private_pem(openssl.rsa_key()).must()
    server = parse_certificate(openssl.server()).must()
    usage = KeyUsage(
        digital_signature: true,
        content_commitment: false,
        key_encipherment: true,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )
    profile @= default_profile()
    profile.key_usage @ usage
    profile.role @ .end_entity
    profile.extended_key_usage @ [asn1.Oid(dotted: SERVER_AUTH)]
    profile.alt_names @ [
        .dns(name: "localhost")
        .ip(address: net.parse_host("127.0.0.1").must())
        .ip(address: net.parse_host("::1").must())
    ]
    template = CertificateTemplate(
        serial: big.parse_base(s: "0a1b2c3d4e5f", base: 16).must(),
        subject: new_name([[new_attribute(oid: COUNTRY_NAME, text: "US").must()], [new_attribute(oid: ORGANIZATION_NAME, text: "Dev Co").must()], [new_attribute(oid: COMMON_NAME, text: "dev.example.org").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    built = create_self_signed(template, signer: key, scheme: .rsa_pkcs1_sha256).must()
    assert built.der == server.der
    assert format_certificate(built) == openssl.server()
    assert is_for_host(certificate: built, host: "localhost")
    _ = keypairs.close_private(@key).is_err()

test "create_request: OpenSSL's bytes for an Ed25519 request with an extension request"
    if keypairs.is_available(.ed25519)
        key @= keypairs.parse_private_pem(openssl.ed25519_key()).must()
        wanted = parse_request(openssl.request()).must()
        usage = KeyUsage(
            digital_signature: true,
            content_commitment: false,
            key_encipherment: false,
            data_encipherment: false,
            key_agreement: false,
            key_cert_sign: false,
            crl_sign: false,
            encipher_only: false,
            decipher_only: false
        )
        profile @= default_profile()
        profile.key_usage @ usage
        profile.role @ .end_entity
        profile.extended_key_usage @ [asn1.Oid(dotted: SERVER_AUTH)]
        profile.alt_names @ [.dns(name: "csr.example.org"), .ip(address: net.parse_host("192.0.2.9").must())]
        template = RequestTemplate(
            subject: new_name([[new_attribute(oid: ORGANIZATION_NAME, text: "Heroes Test").must()], [new_attribute(oid: COMMON_NAME, text: "csr.example.org").must()]]).must(),
            profile: profile,
            attributes: []
        )
        built = create_request(template, signer: key, scheme: .ed25519).must()
        assert built.der == wanted.der
        assert format_request(built) == openssl.request()
        assert is_request_signed(built).must()
        _ = keypairs.close_private(@key).is_err()
    else
        assert keypairs.parse_private_pem(openssl.ed25519_key()).is_err()

test "create_crl: OpenSSL's bytes for the Ed25519 root's list of three entries, a reason on two"
    if keypairs.is_available(.ed25519)
        key @= keypairs.parse_private_pem(openssl.ed25519_key()).must()
        root = parse_certificate(openssl.root()).must()
        wanted = parse_crl(openssl.crl()).must()
        template = RevocationListTemplate(
            number: big.from_int(5),
            this_update: time.DateTime(year: 2026, month: 11, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
            next_update: time.DateTime(year: 2026, month: 12, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
            revoked: [Revocation(serial: big.from_int(0x0aaa), date: time.DateTime(year: 2026, month: 11, day: 7, hour: 0, minute: 0, second: 0, nanosecond: 0), reason: .unspecified, invalidity: .unstated), Revocation(serial: big.from_int(0x1234), date: time.DateTime(year: 2026, month: 11, day: 6, hour: 0, minute: 0, second: 0, nanosecond: 0), reason: .superseded, invalidity: .unstated), Revocation(serial: big.parse_base(s: "7edcba9876543210", base: 16).must(), date: time.DateTime(year: 2026, month: 11, day: 5, hour: 12, minute: 0, second: 0, nanosecond: 0), reason: .key_compromise, invalidity: .unstated)]
        )
        built = create_crl(template, issuer: root, signer: key, scheme: .ed25519).must()
        assert built.der == wanted.der
        assert format_crl(built) == openssl.crl()
        assert is_crl_signed_by(built, issuer: root).must()
        assert revoked_of(built, serial: big.from_int(0x1234)).must().date.day == 6
        assert revoked_of(built, serial: big.from_int(0x1235)).is_err()
        _ = keypairs.close_private(@key).is_err()
    else
        assert keypairs.parse_private_pem(openssl.ed25519_key()).is_err()

test "create_self_signed: each of the nine schemes signs, and the certificate names it and verifies"
    p256 @= keypairs.generate(.p256).must()
    p384 @= keypairs.generate(.p384).must()
    rsa @= keypairs.parse_private_pem(openssl.rsa_key()).must()
    template = CertificateTemplate(
        serial: big.from_int(99),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Schemes").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: default_profile(),
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    built @= [
        create_self_signed(template, signer: p256, scheme: .ecdsa_sha256).must()
        create_self_signed(template, signer: p384, scheme: .ecdsa_sha384).must()
    ]
    rsa_schemes: [keypairs.Scheme] = [
        .rsa_pkcs1_sha256
        .rsa_pkcs1_sha384
        .rsa_pkcs1_sha512
        .rsa_pss_sha256
        .rsa_pss_sha384
        .rsa_pss_sha512
    ]

    for scheme in rsa_schemes
        built @ built.push(create_self_signed(template, signer: rsa, scheme: scheme).must())

    expected: [keypairs.Scheme] @= [.ecdsa_sha256, .ecdsa_sha384]

    for scheme in rsa_schemes
        expected @ expected.push(scheme)

    assert built.len() == expected.len()

    for i in range(from: 0, to: expected.len())
        assert scheme_of(built[i].signature_algorithm).must() == expected[i]
        assert is_signed_by(certificate: built[i], issuer: built[i]).must()

    assert create_self_signed(template, signer: p256, scheme: .rsa_pkcs1_sha256).is_err()
    assert create_self_signed(template, signer: rsa, scheme: .ecdsa_sha256).is_err()
    assert create_self_signed(template, signer: p384, scheme: .rsa_pss_sha256).is_err()
    _ = keypairs.close_private(@p256).is_err()
    _ = keypairs.close_private(@p384).is_err()
    _ = keypairs.close_private(@rsa).is_err()

test "create_self_signed: Ed25519 signs and reads back where the platform has it, and is unsupported where it has not"
    if keypairs.is_available(.ed25519)
        key @= keypairs.generate(.ed25519).must()
        template = CertificateTemplate(
            serial: big.from_int(100),
            subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Edwards").must()]]).must(),
            not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
            profile: default_profile(),
            ocsp_urls: [],
            issuer_urls: [],
            crl_urls: []
        )
        built = create_self_signed(template, signer: key, scheme: .ed25519).must()
        assert scheme_of(built.signature_algorithm).must() == .ed25519
        assert is_signed_by(certificate: built, issuer: built).must()
        _ = keypairs.close_private(@key).is_err()
    else
        match keypairs.generate(.ed25519)
            .ok _  => assert false
            .err e => assert e.code == UNSUPPORTED

test "create_self_signed: a serial that is not positive or is past 20 octets, a validity that ends first, and an empty subject are refused"
    key @= keypairs.generate(.p256).must()
    seven = new_name([[new_attribute(oid: COMMON_NAME, text: "Seven").must()]]).must()
    base = CertificateTemplate(
        serial: big.from_int(7),
        subject: seven,
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: default_profile(),
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    assert !create_self_signed(base, signer: key, scheme: .ecdsa_sha256).is_err()
    zero @= base
    zero.serial @ big.from_int(0)
    assert create_self_signed(zero, signer: key, scheme: .ecdsa_sha256).is_err()
    negative @= base
    negative.serial @ big.from_int(-5)
    assert create_self_signed(negative, signer: key, scheme: .ecdsa_sha256).is_err()
    widest @= base
    widest.serial @ big.parse_base(s: "7fffffffffffffffffffffffffffffffffffffff", base: 16).must()
    assert big.compare(a: create_self_signed(widest, signer: key, scheme: .ecdsa_sha256).must().serial, b: widest.serial) == 0
    over @= base
    over.serial @ big.parse_base(s: "ffffffffffffffffffffffffffffffffffffffff", base: 16).must()
    assert create_self_signed(over, signer: key, scheme: .ecdsa_sha256).is_err()
    longer @= base
    longer.serial @ big.parse_base(s: "010000000000000000000000000000000000000000", base: 16).must()
    assert create_self_signed(longer, signer: key, scheme: .ecdsa_sha256).is_err()
    reversed @= base
    reversed.not_after @ time.DateTime(year: 2026, month: 10, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0)
    assert create_self_signed(reversed, signer: key, scheme: .ecdsa_sha256).is_err()
    instant @= base
    instant.not_after @ base.not_before
    assert !create_self_signed(instant, signer: key, scheme: .ecdsa_sha256).is_err()
    impossible @= base
    impossible.not_after @ time.DateTime(year: 2027, month: 2, day: 30, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert create_self_signed(impossible, signer: key, scheme: .ecdsa_sha256).is_err()
    nameless @= base
    nameless.subject @ new_name([]).must()
    assert create_self_signed(nameless, signer: key, scheme: .ecdsa_sha256).is_err()
    broken @= base
    broken.subject @ Name(rdns: [], der: [0x01])
    assert create_self_signed(broken, signer: key, scheme: .ecdsa_sha256).is_err()

    match create_self_signed(zero, signer: key, scheme: .ecdsa_sha256)
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the serial number is 0, where RFC 5280 asks a positive integer"

    _ = keypairs.close_private(@key).is_err()

test "create_self_signed: moments written as UTCTime or GeneralizedTime, the fraction dropped, an empty subject named by a critical alternative name"
    key @= keypairs.generate(.p256).must()
    profile @= default_profile()
    profile.alt_names @ [.dns(name: "only.example.org")]
    template = CertificateTemplate(
        serial: big.from_int(8),
        subject: new_name([]).must(),
        not_before: time.DateTime(year: 1949, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 999999999),
        not_after: time.DateTime(year: 9999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0),
        profile: profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    built = create_self_signed(template, signer: key, scheme: .ecdsa_sha256).must()
    assert built.not_before == time.DateTime(year: 1949, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0)
    assert built.not_after.year == 9999
    assert format_name(built.subject) == "" && built.subject.der == [0x30, 0x00]
    assert built.extensions.list[1].oid.dotted == SUBJECT_ALT_NAME && built.extensions.list[1].critical
    assert is_for_host(certificate: built, host: "only.example.org")
    modern @= template
    modern.not_before @ time.DateTime(year: 2049, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0)
    modern.not_after @ time.DateTime(year: 2050, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert create_self_signed(modern, signer: key, scheme: .ecdsa_sha256).must().not_after.year == 2050
    _ = keypairs.close_private(@key).is_err()

test "create_self_signed: a role and key usage that disagree, an extension twice, one of no DER, and one unknown kept as given"
    key @= keypairs.generate(.p256).must()
    base = CertificateTemplate(
        serial: big.from_int(9),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Roles").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: default_profile(),
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    sign_only = KeyUsage(
        digital_signature: true,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )
    ca_usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )
    only_encipher = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: true,
        decipher_only: false
    )

    roles: [Role] = [.unstated, .end_entity]

    for role in roles
        profile @= default_profile()
        profile.role @ role
        profile.key_usage @ ca_usage
        wrong @= base
        wrong.profile @ profile
        assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()

    authority @= default_profile()
    authority.role @ .authority
    authority.key_usage @ sign_only
    wrong @= base
    wrong.profile @ authority
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    authority.key_usage @ ca_usage
    wrong.profile @ authority
    assert !create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    authority.role @ .limited_authority(path_len: -1)
    wrong.profile @ authority
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    agreement @= default_profile()
    agreement.key_usage @ only_encipher
    wrong.profile @ agreement
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    twice @= default_profile()
    twice.alt_names @ [.dns(name: "a.example.org")]
    twice.extra @ [Extension(oid: asn1.Oid(dotted: SUBJECT_ALT_NAME), critical: false, value: [0x30, 0x00])]
    wrong.profile @ twice
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    unknown = Extension(oid: asn1.Oid(dotted: "1.2.3.4.5"), critical: true, value: [0x05, 0x00])
    pair @= default_profile()
    pair.extra @ [unknown, unknown]
    wrong.profile @ pair
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    nothing @= default_profile()
    nothing.extra @ [Extension(oid: asn1.Oid(dotted: "1.2.3.4.5"), critical: false, value: [0x30])]
    wrong.profile @ nothing
    assert create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    given @= default_profile()
    given.extra @ [unknown]
    wrong.profile @ given
    built = create_self_signed(wrong, signer: key, scheme: .ecdsa_sha256).must()
    assert built.extensions.unknown.len() == 1
    assert built.extensions.unknown[0] == unknown
    assert built.extensions.list.len() == 2
    _ = keypairs.close_private(@key).is_err()

test "create_certificate: an issuer that is no authority, whose usage lacks keyCertSign, whose path allows none, or whose key is not the signer's"
    root_key @= keypairs.generate(.p256).must()
    other_key @= keypairs.generate(.p256).must()
    leaf_key @= keypairs.generate(.p256).must()
    ca_usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    sign_only = KeyUsage(
        digital_signature: true,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )
    base = CertificateTemplate(
        serial: big.from_int(10),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Issuer").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2027, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: default_profile(),
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    zero_path @= default_profile()
    zero_path.role @ .limited_authority(path_len: 0)
    zero_path.key_usage @ ca_usage
    root_template @= base
    root_template.profile @ zero_path
    root = create_self_signed(root_template, signer: root_key, scheme: .ecdsa_sha256).must()
    leaf_template @= base
    leaf_template.serial @ big.from_int(11)
    leaf_template.subject @ new_name([[new_attribute(oid: COMMON_NAME, text: "Leaf").must()]]).must()
    leaf_public = public_key_of(leaf_key).must()
    leaf = create_certificate(
        leaf_template,
        subject_key: leaf_public,
        issuer: root,
        signer: root_key,
        scheme: .ecdsa_sha256
    ).must()
    assert is_signed_by(certificate: leaf, issuer: root).must()
    assert leaf.issuer.der == root.subject.der
    assert leaf.extensions.authority_key_id.must().key_id.must() == root.extensions.subject_key_id.must()
    assert leaf.extensions.subject_key_id.must().len() == 20
    assert create_certificate(
        leaf_template,
        subject_key: leaf_public,
        issuer: root,
        signer: other_key,
        scheme: .ecdsa_sha256
    ).is_err()
    below @= leaf_template
    below.profile @ zero_path
    assert create_certificate(
        below,
        subject_key: leaf_public,
        issuer: root,
        signer: root_key,
        scheme: .ecdsa_sha256
    ).is_err()
    end_entity @= default_profile()
    end_entity.role @ .end_entity
    leaf_template.profile @ end_entity
    leaf_as_issuer_template @= base
    leaf_as_issuer_template.profile @ end_entity
    leaf_ca = create_self_signed(leaf_as_issuer_template, signer: leaf_key, scheme: .ecdsa_sha256).must()
    assert create_certificate(
        base,
        subject_key: leaf_public,
        issuer: leaf_ca,
        signer: leaf_key,
        scheme: .ecdsa_sha256
    ).is_err()
    signing @= default_profile()
    signing.key_usage @ sign_only
    signer_template @= base
    signer_template.profile @ signing
    signer_ca = create_self_signed(signer_template, signer: other_key, scheme: .ecdsa_sha256).must()
    assert create_certificate(
        base,
        subject_key: leaf_public,
        issuer: signer_ca,
        signer: other_key,
        scheme: .ecdsa_sha256
    ).is_err()
    bare = create_self_signed(base, signer: other_key, scheme: .ecdsa_sha256).must()
    bare_leaf = create_certificate(
        leaf_template,
        subject_key: leaf_public,
        issuer: bare,
        signer: other_key,
        scheme: .ecdsa_sha256
    ).must()
    assert is_signed_by(certificate: bare_leaf, issuer: bare).must()
    assert bare_leaf.extensions.authority_key_id.must().key_id.must() == writing.key_id(bare.public_key.key)
    _ = keypairs.close_private(@root_key).is_err()
    _ = keypairs.close_private(@other_key).is_err()
    _ = keypairs.close_private(@leaf_key).is_err()

test "create_certificate: a chain of an ECDSA P-256 root, a P-384 intermediate and an RSA leaf that verify_chain accepts for its host alone"
    root_key @= keypairs.generate(.p256).must()
    inter_key @= keypairs.generate(.p384).must()
    leaf_key @= keypairs.parse_private_pem(openssl.rsa_key()).must()
    ca_usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    root_profile @= default_profile()
    root_profile.role @ .limited_authority(path_len: 1)
    root_profile.key_usage @ ca_usage
    inter_profile @= default_profile()
    inter_profile.role @ .limited_authority(path_len: 0)
    inter_profile.key_usage @ ca_usage
    leaf_profile @= default_profile()
    leaf_profile.role @ .end_entity
    leaf_profile.extended_key_usage @ [asn1.Oid(dotted: SERVER_AUTH)]
    leaf_profile.alt_names @ [.dns(name: "chain.example.org")]
    root_template = CertificateTemplate(
        serial: big.from_int(1),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Chain Root").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: root_profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    inter_template @= root_template
    inter_template.serial @ big.from_int(2)
    inter_template.subject @ new_name([[new_attribute(oid: COMMON_NAME, text: "Chain Intermediate").must()]]).must()
    inter_template.profile @ inter_profile
    inter_template.crl_urls @ ["http://ca.example.org/root.crl"]
    leaf_template @= root_template
    leaf_template.serial @ big.from_int(3)
    leaf_template.subject @ new_name([[new_attribute(oid: COMMON_NAME, text: "chain.example.org").must()]]).must()
    leaf_template.profile @ leaf_profile
    root = create_self_signed(root_template, signer: root_key, scheme: .ecdsa_sha256).must()
    inter = create_certificate(
        inter_template,
        subject_key: public_key_of(inter_key).must(),
        issuer: root,
        signer: root_key,
        scheme: .ecdsa_sha256
    ).must()
    leaf = create_certificate(
        leaf_template,
        subject_key: public_key_of(leaf_key).must(),
        issuer: inter,
        signer: inter_key,
        scheme: .ecdsa_sha384
    ).must()
    chain = chain_of(leaf, pool: [root, inter])
    assert chain.len() == 3
    june = time.date(year: 2026, month: 12, day: 1).must()
    good = Verification(roots: [root], at: june, purpose: SERVER_AUTH, host: "chain.example.org")
    assert !verify_chain(chain, options: good).is_err()
    assert verify_chain(
        chain,
        options: Verification(roots: [root], at: june, purpose: SERVER_AUTH, host: "other.example.org")
    ).is_err()
    assert verify_chain(chain, options: Verification(roots: [root], at: june, purpose: CODE_SIGNING, host: "")).is_err()
    assert inter.extensions.crl_distribution_points.must().len() == 1
    _ = keypairs.close_private(@root_key).is_err()
    _ = keypairs.close_private(@inter_key).is_err()
    _ = keypairs.close_private(@leaf_key).is_err()

test "profile_extensions: nothing for the default, RFC 5280's bytes for each extension, their order, their criticality and the extra last"
    assert profile_extensions(default_profile(), subject_empty: false).must().len() == 0
    usage = KeyUsage(
        digital_signature: true,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: true,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: false,
        decipher_only: true
    )
    extra = Extension(oid: asn1.Oid(dotted: "1.2.3.4"), critical: true, value: [0x05, 0x00])
    profile @= default_profile()
    profile.role @ .limited_authority(path_len: 0)
    profile.key_usage @ usage
    profile.extended_key_usage @ [asn1.Oid(dotted: SERVER_AUTH)]
    profile.alt_names @ [.dns(name: "a.example.org")]
    profile.extra @ [extra]
    assert profile_extensions(profile, subject_empty: false).is_err()
    profile.role @ .end_entity
    list = profile_extensions(profile, subject_empty: false).must()
    assert list.len() == 5
    assert list[0].oid.dotted == BASIC_CONSTRAINTS && list[0].critical && list[0].value == [0x30, 0x00]
    assert list[1].oid.dotted == KEY_USAGE && list[1].critical && list[1].value == [0x03, 0x03, 0x07, 0x88, 0x80]
    assert list[2].oid.dotted == EXTENDED_KEY_USAGE && !list[2].critical
    assert list[3].oid.dotted == SUBJECT_ALT_NAME && !list[3].critical
    assert list[4] == extra
    assert profile_extensions(profile, subject_empty: true).must()[3].critical
    ca = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    authority @= default_profile()
    authority.key_usage @ ca
    authority.role @ .authority
    wide = profile_extensions(authority, subject_empty: false).must()
    assert wide[0].value == [0x30, 0x03, 0x01, 0x01, 0xff] && wide[1].value == [0x03, 0x02, 0x01, 0x06]
    authority.role @ .limited_authority(path_len: 0)
    assert profile_extensions(authority, subject_empty: false).must()[0].value == [0x30, 0x06, 0x01, 0x01, 0xff, 0x02, 0x01, 0x00]
    authority.role @ .limited_authority(path_len: 300)
    assert profile_extensions(authority, subject_empty: false).must()[0].value == [0x30, 0x07, 0x01, 0x01, 0xff, 0x02, 0x02, 0x01, 0x2c]

test "from_extension: an extension's SEQUENCE, its criticality written only where true, and a value that is no DER refused"
    quiet = from_extension(Extension(oid: asn1.Oid(dotted: "1.2.3.4"), critical: false, value: [0x05, 0x00])).must()
    assert asn1.encode_der(quiet).must() == [0x30, 0x09, 0x06, 0x03, 0x2a, 0x03, 0x04, 0x04, 0x02, 0x05, 0x00]
    loud = from_extension(Extension(oid: asn1.Oid(dotted: "1.2.3.4"), critical: true, value: [0x05, 0x00])).must()
    assert asn1.encode_der(loud).must() == [0x30, 0x0c, 0x06, 0x03, 0x2a, 0x03, 0x04, 0x01, 0x01, 0xff, 0x04, 0x02, 0x05, 0x00]
    assert to_extension(loud).must().critical
    assert from_extension(Extension(oid: asn1.Oid(dotted: "1.2.3.4"), critical: false, value: [0x30])).is_err()
    assert from_extension(Extension(oid: asn1.Oid(dotted: "1.40"), critical: false, value: [0x05, 0x00])).is_err()
    assert from_extension(Extension(oid: asn1.Oid(dotted: "x"), critical: false, value: [0x05, 0x00])).is_err()

test "create_crl: every reason and an invalidity date read back, a list of none, a number of 0, and what is refused"
    key @= keypairs.generate(.p256).must()
    other @= keypairs.generate(.p256).must()
    ca = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    signing_only = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )
    profile @= default_profile()
    profile.role @ .authority
    profile.key_usage @ ca
    base = CertificateTemplate(
        serial: big.from_int(1),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "List Root").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    root = create_self_signed(base, signer: key, scheme: .ecdsa_sha256).must()
    reasons: [Reason] = [
        .key_compromise
        .ca_compromise
        .affiliation_changed
        .superseded
        .cessation_of_operation
        .certificate_hold
        .privilege_withdrawn
        .aa_compromise
    ]
    revoked: [Revocation] @= []
    day = time.DateTime(year: 2026, month: 11, day: 5, hour: 1, minute: 2, second: 3, nanosecond: 0)

    for i in range(from: 0, to: reasons.len())
        revoked @ revoked.push(
            Revocation(serial: big.from_int(100 + i), date: day, reason: reasons[i], invalidity: .unstated)
        )

    revoked @ revoked.push(
        Revocation(serial: big.from_int(200), date: day, reason: .unspecified, invalidity: .since(at: time.DateTime(year: 2026, month: 10, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 500)))
    )
    template = RevocationListTemplate(
        number: big.from_int(0),
        this_update: time.DateTime(year: 2026, month: 11, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
        next_update: time.DateTime(year: 2026, month: 11, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
        revoked: revoked
    )
    built = create_crl(template, issuer: root, signer: key, scheme: .ecdsa_sha256).must()
    assert built.revoked.len() == 9 && built.version == 2
    assert big.compare(a: built.extensions.crl_number.must(), b: big.from_int(0)) == 0
    assert built.extensions.authority_key_id.must().key_id.must() == root.extensions.subject_key_id.must()

    for i in range(from: 0, to: reasons.len())
        assert built.revoked[i].extensions.reason.must() == reasons[i]

    assert built.revoked[8].extensions.reason.is_err()
    assert built.revoked[8].extensions.invalidity_date.must() == time.DateTime(year: 2026, month: 10, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 0)
    assert built.revoked[0].extensions.invalidity_date.is_err()
    assert parse_crl(format_crl(built)).must().der == built.der
    none @= template
    none.revoked @ []
    emptied = create_crl(none, issuer: root, signer: key, scheme: .ecdsa_sha256).must()
    assert emptied.revoked.len() == 0 && is_crl_signed_by(emptied, issuer: root).must()
    twice @= template
    twice.revoked @ [revoked[0], revoked[0]]
    assert create_crl(twice, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    delta @= template
    delta.revoked @ [Revocation(serial: big.from_int(1), date: day, reason: .remove_from_crl, invalidity: .unstated)]
    assert create_crl(delta, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    nothing @= template
    nothing.revoked @ [Revocation(serial: big.from_int(0), date: day, reason: .unspecified, invalidity: .unstated)]
    assert create_crl(nothing, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    backwards @= template
    backwards.next_update @ time.DateTime(
        year: 2026,
        month: 11,
        day: 9,
        hour: 23,
        minute: 59,
        second: 59,
        nanosecond: 0
    )
    assert create_crl(backwards, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    negative @= template
    negative.number @ big.from_int(-1)
    assert create_crl(negative, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    huge @= template
    huge.number @ big.parse_base(s: "ffffffffffffffffffffffffffffffffffffffff", base: 16).must()
    assert create_crl(huge, issuer: root, signer: key, scheme: .ecdsa_sha256).is_err()
    assert create_crl(template, issuer: root, signer: other, scheme: .ecdsa_sha256).is_err()
    weak_profile @= profile
    weak_profile.key_usage @ signing_only
    weak @= base
    weak.profile @ weak_profile
    list_less = create_self_signed(weak, signer: other, scheme: .ecdsa_sha256).must()
    assert create_crl(template, issuer: list_less, signer: other, scheme: .ecdsa_sha256).is_err()
    _ = keypairs.close_private(@key).is_err()
    _ = keypairs.close_private(@other).is_err()

test "create_request: attributes written as given, a challenge password and a request for an authority read back, and what is refused"
    key @= keypairs.generate(.p256).must()
    password = RequestAttribute(oid: asn1.Oid(dotted: CHALLENGE_PASSWORD), values: [.text(kind: .utf8, v: "s3cret")])
    template = RequestTemplate(
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Request").must()]]).must(),
        profile: default_profile(),
        attributes: [password]
    )
    built = create_request(template, signer: key, scheme: .ecdsa_sha256).must()
    assert built.attributes == [password] && built.extensions.list.len() == 0
    assert is_request_signed(built).must() && parse_request(format_request(built)).must().der == built.der
    bare = RequestTemplate(subject: new_name([]).must(), profile: default_profile(), attributes: [])
    assert create_request(bare, signer: key, scheme: .ecdsa_sha256).must().attributes.len() == 0
    ca = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    profile @= default_profile()
    profile.role @ .limited_authority(path_len: 2)
    profile.key_usage @ ca
    profile.alt_names @ [.dns(name: "ca.example.org")]
    wanted = RequestTemplate(subject: new_name([]).must(), profile: profile, attributes: [password])
    asked = create_request(wanted, signer: key, scheme: .ecdsa_sha256).must()
    assert asked.extensions.basic_constraints.must().is_ca && asked.extensions.basic_constraints.must().path_len.must() == 2
    assert asked.extensions.key_usage.must().key_cert_sign && asked.extensions.alt_names.must() == profile.alt_names
    assert asked.attributes.len() == 2 && asked.subject.der == [0x30, 0x00]
    both @= template
    both.attributes @ [password, password]
    assert create_request(both, signer: key, scheme: .ecdsa_sha256).is_err()
    empty @= template
    empty.attributes @ [RequestAttribute(oid: asn1.Oid(dotted: CHALLENGE_PASSWORD), values: [])]
    assert create_request(empty, signer: key, scheme: .ecdsa_sha256).is_err()
    extension_request @= template
    extension_request.attributes @ [
        RequestAttribute(oid: asn1.Oid(dotted: EXTENSION_REQUEST), values: [.sequence(items: [])])
    ]
    assert create_request(extension_request, signer: key, scheme: .ecdsa_sha256).is_err()
    wrong @= template
    bad @= default_profile()
    bad.key_usage @ ca
    wrong.profile @ bad
    assert create_request(wrong, signer: key, scheme: .ecdsa_sha256).is_err()
    assert create_request(template, signer: key, scheme: .ed25519).is_err()
    _ = keypairs.close_private(@key).is_err()

## Examples

# The subject of a certificate read from PEM, as RFC 4514 writes a name.
test "to_name: a subject read from its ASN.1"
    cert = parse_certificate(samples.root()).must()
    name = to_name(asn1.decode_der(cert.subject.der).must()).must()
    assert name.rdns.len() == 3

# A name written as RFC 4514 writes it, the most specific part first.
test "format_name: an issuer"
    cert = parse_certificate(samples.leaf()).must()
    assert format_name(cert.issuer) == "CN=Heroes Intermediate,OU=Ground\\, Control,O=Heroes Test,C=IT"

# The common name of a certificate's subject.
test "text_of: a common name"
    cert = parse_certificate(samples.root()).must()
    assert text_of(n: cert.subject, oid: COMMON_NAME).must() == "Heroes Root CA"

# A DNS name read from its ASN.1, the IMPLICIT `[2]`.
test "to_general_name: a dNSName"
    assert to_general_name(asn1.decode_der([0x82, 0x03, 0x61, 0x2e, 0x62]).must()).must() == .dns(name: "a.b")

# The algorithm of a signature, read from its ASN.1.
test "to_algorithm: sha256WithRSAEncryption"
    v = asn1.decode_der(
        asn1.encode_der(.sequence(items: [.oid(v: asn1.Oid(dotted: "1.2.840.113549.1.1.11")), .null_value])).must()
    ).must()
    algorithm = to_algorithm(v).must()
    assert algorithm.oid.dotted == "1.2.840.113549.1.1.11" && !algorithm.parameters.is_err()

# The scheme `crypto/keypairs` checks a certificate's signature with.
test "scheme_of: a leaf's RSA signature"
    assert scheme_of(parse_certificate(samples.leaf()).must().signature_algorithm).must() == .rsa_pkcs1_sha256

# The algorithm a signature by a scheme is named by.
test "algorithm_of: ECDSA with SHA-256"
    assert algorithm_of(.ecdsa_sha256).oid.dotted == "1.2.840.10045.4.3.2"

# A public key read from the SubjectPublicKeyInfo a certificate holds.
test "decode_public_key: the leaf's key"
    key = decode_public_key(parse_certificate(samples.leaf()).must().public_key.der).must()
    assert key.algorithm.oid.dotted == "1.2.840.10045.2.1" && key.key.len() == 65

# The kind of a certificate's key.
test "kind_of: an RSA key's bits"
    assert kind_of(parse_certificate(samples.intermediate()).must().public_key).must() == .rsa(bits: 2048)

# A certificate's signature checked against its issuer's key by hand.
test "verify_signature: a leaf and its issuer's key"
    leaf = parse_certificate(samples.leaf()).must()
    inter = parse_certificate(samples.intermediate()).must()
    assert verify_signature(
        key: inter.public_key,
        algorithm: leaf.signature_algorithm,
        message: leaf.tbs,
        signature: leaf.signature
    ).must()

# An extension read as written, before it is decoded.
test "to_extension: a critical basic constraints"
    v = asn1.decode_der(
        [0x30, 0x0f, 0x06, 0x03, 0x55, 0x1d, 0x13, 0x01, 0x01, 0xff, 0x04, 0x05, 0x30, 0x03, 0x01, 0x01, 0xff]
    ).must()
    e = to_extension(v).must()
    assert e.oid.dotted == BASIC_CONSTRAINTS && e.critical

# Extensions decoded from what was written.
test "to_extensions: a CA's basic constraints"
    e = Extension(oid: asn1.Oid(dotted: BASIC_CONSTRAINTS), critical: true, value: [0x30, 0x03, 0x01, 0x01, 0xff])
    assert to_extensions([e]).must().basic_constraints.must().is_ca

# An extension this package does not decode, found by its identifier.
test "extension_of: an extension nobody knows"
    leaf = parse_certificate(samples.leaf()).must()
    assert extension_of(extensions: leaf.extensions, oid: "1.3.6.1.4.1.55555.1").must().value == [0x04, 0x02, 0x68, 0x69]

# A certificate read from its DER.
test "decode_certificate: the root's DER"
    der = parse_certificate(samples.root()).must().der
    assert format_name(decode_certificate(der).must().subject) == "CN=Heroes Root CA,O=Heroes Test,C=IT"

# Certificates written one after another, read in order.
test "decode_certificates: a chain's DER"
    der @= parse_certificate(samples.leaf()).must().der
    bytes.push_all(to: @der, from: parse_certificate(samples.intermediate()).must().der)
    assert decode_certificates(der).must().len() == 2

# The first certificate of a PEM text.
test "parse_certificate: a PEM certificate"
    assert parse_certificate(samples.leaf()).must().version == 3

# Every certificate of a bundle.
test "parse_certificates: a bundle of two"
    assert parse_certificates(samples.root() + samples.intermediate()).must().len() == 2

# A certificate written back as PEM.
test "format_certificate: read back"
    cert = parse_certificate(samples.root()).must()
    assert parse_certificate(format_certificate(cert)).must().der == cert.der

# Whether a certificate is valid on a day.
test "is_valid_at: a day of 2026"
    assert is_valid_at(
        certificate: parse_certificate(samples.leaf()).must(),
        at: time.date(year: 2026, month: 3, day: 1).must()
    )

# A root names itself as its issuer.
test "is_self_issued: a root"
    assert is_self_issued(parse_certificate(samples.root()).must())

# A certificate's signature checked against its issuer's.
test "is_signed_by: an intermediate signed by its root"
    root = parse_certificate(samples.root()).must()
    assert is_signed_by(certificate: parse_certificate(samples.intermediate()).must(), issuer: root).must()

# A certificate request read from its DER.
test "decode_request: a request's DER"
    der = parse_request(samples.request()).must().der
    assert decode_request(der).must().subject.rdns.len() == 2

# A certificate request read from PEM.
test "parse_request: a PEM request"
    assert text_of(n: parse_request(samples.request()).must().subject, oid: COMMON_NAME).must() == "request.example.com"

# A request checked against its own key.
test "is_request_signed: a request signed by its key"
    assert is_request_signed(parse_request(samples.request()).must()).must()

# A revocation list read from its DER.
test "decode_crl: a list's DER"
    der = parse_crl(samples.crl()).must().der
    assert decode_crl(der).must().revoked.len() == 2

# A revocation list read from PEM.
test "parse_crl: a PEM list"
    assert parse_crl(samples.crl()).must().version == 2

# A list checked against its issuer's key.
test "is_crl_signed_by: a list and its issuer"
    assert is_crl_signed_by(
        crl: parse_crl(samples.crl()).must(),
        issuer: parse_certificate(samples.intermediate()).must()
    ).must()

# Whether a serial is revoked, and why.
test "revoked_of: a serial revoked for a key compromised"
    entry = revoked_of(crl: parse_crl(samples.crl()).must(), serial: big.from_int(0x1001)).must()
    assert entry.extensions.reason.must() == .key_compromise

# A leaf's chain put in order from the certificates a server sent.
test "chain_of: a leaf and its issuers"
    pool = parse_certificates(samples.root() + samples.intermediate()).must()
    assert chain_of(leaf: parse_certificate(samples.leaf()).must(), pool: pool).len() == 3

# A chain checked for a TLS server's name at a moment.
test "verify_chain: a server's chain"
    root = parse_certificate(samples.root()).must()
    chain = [parse_certificate(samples.leaf()).must(), parse_certificate(samples.intermediate()).must()]
    options = Verification(
        roots: [root],
        at: time.date(year: 2026, month: 6, day: 1).must(),
        purpose: SERVER_AUTH,
        host: "example.com"
    )
    assert !verify_chain(chain: chain, options: options).is_err()

# Whether a certificate is for a host a client connects to.
test "is_for_host: a wildcard's one label"
    assert is_for_host(certificate: parse_certificate(samples.leaf()).must(), host: "www.app.example.com")

# Whether a certificate is for an address.
test "is_for_address: an IPv4 address"
    assert is_for_address(
        certificate: parse_certificate(samples.leaf()).must(),
        address: net.parse_host("192.0.2.1").must()
    )

# One attribute of a name, made from its type and its text.
test "new_attribute: a common name, in the string type RFC 5280 gives it"
    attribute = new_attribute(oid: COMMON_NAME, text: "example.org").must()
    assert asn1.text_of(attribute.value).must() == "example.org"

# A name made of a country, an organization and a common name.
test "new_name: a subject of three relative names"
    name = new_name(
        [[new_attribute(oid: COUNTRY_NAME, text: "IT").must()], [new_attribute(oid: ORGANIZATION_NAME, text: "Heroes Test").must()], [new_attribute(oid: COMMON_NAME, text: "example.org").must()]]
    ).must()
    assert format_name(name) == "CN=example.org,O=Heroes Test,C=IT"

# The public key of a private key, in the form a certificate holds it.
test "public_key_of: a P-256 key's SubjectPublicKeyInfo"
    key @= keypairs.generate(.p256).must()
    public = public_key_of(key).must()
    _ = keypairs.close_private(@key).is_err()
    assert kind_of(public).must() == .p256

# A serial number for a certificate, drawn at random.
test "random_serial: a positive serial of 159 bits at most"
    assert big.bit_len(random_serial().must()) <= 159

# The profile that says nothing, changed where a program wants something said.
test "default_profile: a server's profile, an end entity that names a host"
    profile @= default_profile()
    profile.role @ .end_entity
    profile.alt_names @ [.dns(name: "example.org")]
    assert profile.alt_names.len() == 1

# A name written into its ASN.1 and read back.
test "from_general_name: a host name, written as its dNSName"
    written = from_general_name(.dns(name: "a.example.org")).must()
    assert to_general_name(written).must() == .dns(name: "a.example.org")

# An extension written into its ASN.1 and read back.
test "from_extension: a critical extension, read back by `to_extension`"
    written = from_extension(Extension(oid: asn1.Oid(dotted: "1.2.3.4"), critical: true, value: [0x05, 0x00])).must()
    assert to_extension(written).must().critical

# The extensions a profile writes, as a certificate would carry them.
test "profile_extensions: an end entity's basic constraints and its names"
    profile @= default_profile()
    profile.role @ .end_entity
    profile.alt_names @ [.dns(name: "example.org")]
    list = profile_extensions(profile, subject_empty: false).must()
    assert list[0].oid.dotted == BASIC_CONSTRAINTS && list[1].oid.dotted == SUBJECT_ALT_NAME

# A root authority that a P-256 key gives itself.
test "create_self_signed: a root authority, valid for ten years"
    key @= keypairs.generate(.p256).must()
    usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    profile @= default_profile()
    profile.role @ .authority
    profile.key_usage @ usage
    template = CertificateTemplate(
        serial: random_serial().must(),
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Example Root").must()]]).must(),
        not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0),
        profile: profile,
        ocsp_urls: [],
        issuer_urls: [],
        crl_urls: []
    )
    root = create_self_signed(template, signer: key, scheme: .ecdsa_sha256).must()
    _ = keypairs.close_private(@key).is_err()
    assert is_self_issued(root) && root.extensions.basic_constraints.must().is_ca

# A server's certificate that a root signs for the server's own key.
test "create_certificate: a server's certificate under a root, for its host name"
    root_key @= keypairs.generate(.p256).must()
    server_key @= keypairs.generate(.p256).must()
    usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    authority @= default_profile()
    authority.role @ .authority
    authority.key_usage @ usage
    server @= default_profile()
    server.role @ .end_entity
    server.alt_names @ [.dns(name: "example.org")]
    start = time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
    root = create_self_signed(
        CertificateTemplate(serial: big.from_int(1), subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Example Root").must()]]).must(), not_before: start, not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0), profile: authority, ocsp_urls: [], issuer_urls: [], crl_urls: []),
        signer: root_key,
        scheme: .ecdsa_sha256
    ).must()
    leaf = create_certificate(
        CertificateTemplate(serial: big.from_int(2), subject: new_name([[new_attribute(oid: COMMON_NAME, text: "example.org").must()]]).must(), not_before: start, not_after: time.DateTime(year: 2027, month: 2, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0), profile: server, ocsp_urls: [], issuer_urls: [], crl_urls: []),
        subject_key: public_key_of(server_key).must(),
        issuer: root,
        signer: root_key,
        scheme: .ecdsa_sha256
    ).must()
    _ = keypairs.close_private(@root_key).is_err()
    _ = keypairs.close_private(@server_key).is_err()
    assert is_signed_by(certificate: leaf, issuer: root).must() && is_for_host(certificate: leaf, host: "example.org")

# A request for a host name, signed by the key that will hold the certificate.
test "create_request: a request for a host name"
    key @= keypairs.generate(.p256).must()
    profile @= default_profile()
    profile.alt_names @ [.dns(name: "example.org")]
    template = RequestTemplate(
        subject: new_name([[new_attribute(oid: COMMON_NAME, text: "example.org").must()]]).must(),
        profile: profile,
        attributes: []
    )
    request = create_request(template, signer: key, scheme: .ecdsa_sha256).must()
    _ = keypairs.close_private(@key).is_err()
    assert is_request_signed(request).must() && request.extensions.alt_names.must() == [.dns(name: "example.org")]

# A request written as PEM and read back.
test "format_request: a request as a PEM block, read back by `parse_request`"
    key @= keypairs.generate(.p256).must()
    template = RequestTemplate(subject: new_name([]).must(), profile: default_profile(), attributes: [])
    request = create_request(template, signer: key, scheme: .ecdsa_sha256).must()
    _ = keypairs.close_private(@key).is_err()
    assert parse_request(format_request(request)).must().der == request.der

# A list of one revoked certificate, issued by a root.
test "create_crl: a list that revokes one serial for a stated reason"
    key @= keypairs.generate(.p256).must()
    usage = KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )
    profile @= default_profile()
    profile.role @ .authority
    profile.key_usage @ usage
    root = create_self_signed(
        CertificateTemplate(serial: big.from_int(1), subject: new_name([[new_attribute(oid: COMMON_NAME, text: "Example Root").must()]]).must(), not_before: time.DateTime(year: 2026, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0), not_after: time.DateTime(year: 2036, month: 11, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0), profile: profile, ocsp_urls: [], issuer_urls: [], crl_urls: []),
        signer: key,
        scheme: .ecdsa_sha256
    ).must()
    template = RevocationListTemplate(
        number: big.from_int(1),
        this_update: time.DateTime(year: 2026, month: 11, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
        next_update: time.DateTime(year: 2026, month: 12, day: 10, hour: 0, minute: 0, second: 0, nanosecond: 0),
        revoked: [Revocation(serial: big.from_int(42), date: time.DateTime(year: 2026, month: 11, day: 9, hour: 0, minute: 0, second: 0, nanosecond: 0), reason: .key_compromise, invalidity: .unstated)]
    )
    crl = create_crl(template, issuer: root, signer: key, scheme: .ecdsa_sha256).must()
    _ = keypairs.close_private(@key).is_err()
    assert revoked_of(crl, serial: big.from_int(42)).must().extensions.reason.must() == .key_compromise

# A list written as PEM and read back.
test "format_crl: a list as a PEM block, read back by `parse_crl`"
    crl = parse_crl(openssl.crl()).must()
    assert parse_crl(format_crl(crl)).must().der == crl.der
