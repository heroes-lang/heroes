# The pieces of a cron expression: its fields split at spaces and tabs, a
# field's items split at commas, and an item read as a range with a step into
# a set of bits. A slice is cut only beside an ASCII byte, so no expression can
# make the reader split a character.

# The code of an expression this reader refuses; the message names the field
# and its text.
constant INVALID: str
    "invalid"

# A field as the reader walks it: its name for messages and its bounds.
record Field
    # The name a message gives it: `minute`, `day of the week`.
    name: str
    # The smallest value.
    low: i64
    # The largest value written; 7 for the day of the week, read as Sunday.
    high: i64
    # Where `*` and a step from a value, `5/15`, end: `high`, but 6 for the
    # day of the week, so that a step never reaches Sunday a second time.
    last: i64
    # 1 where names of months are read, 2 for names of weekdays, 0 for none.
    names: i64

# One item of a field: a range from `from` to `to` by `step`, and whether it
# was `*` or `?` taken whole.
record Item
    # The first value.
    from: i64
    # The last value, at least `from`.
    to: i64
    # The step, at least 1.
    step: i64
    # Whether the item was `*` or `?` with no step above 1.
    open: bool

# A failure naming the field and the expression.
function refused(field: Field, text: str, why: str) -> str
    return f"the {field.name} field \"{text}\": {why}"

# Whether `c` is an ASCII letter.
function is_letter(c: u8) -> bool
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'

# `c` in lower case, where it is an ASCII capital.
function lower(c: u8) -> u8
    if c >= 'A' && c <= 'Z'
        return c - 'A' + 'a'
    return c

# The parts of `s` between runs of spaces and tabs, none empty.
function words(s: str) -> [str]
    parts: [str] @= []
    at: i64 @= 0

    while at < s.len()
        while at < s.len() && (s[at] == ' ' || s[at] == '\t')
            at @ at + 1

        start = at

        while at < s.len() && s[at] != ' ' && s[at] != '\t'
            at @ at + 1

        if at > start
            parts @ parts.push(s.slice(from: start, to: at))

    return parts

# The parts of `s` between its commas, the empty ones kept.
function items(s: str) -> [str]
    parts: [str] @= []
    start: i64 @= 0

    for at in range(from: 0, to: s.len())
        if s[at] == ','
            parts @ parts.push(s.slice(from: start, to: at))
            start @ at + 1

    parts @ parts.push(s.slice(from: start, to: s.len()))
    return parts

# Where `c` first stands in `s`, or `s.len()` where it does not.
function byte_at(s: str, c: u8) -> i64
    for at in range(from: 0, to: s.len())
        if s[at] == c
            return at

    return s.len()

# The number `s` writes in decimal digits, leading zeros allowed. Fails
# `invalid` where it is empty, holds anything else, or has more than nine
# digits.
function number(s: str, field: Field, text: str) -> i64?
    if s.len() == 0
        return fail(code: INVALID, msg: refused(field: field, text: text, why: "a number is missing"))

    if s.len() > 9
        return fail(code: INVALID, msg: refused(field: field, text: text, why: f"\"{s}\" is too long a number"))
    n: i64 @= 0

    for at in range(from: 0, to: s.len())
        if s[at] < '0' || s[at] > '9'
            return fail(code: INVALID, msg: refused(field: field, text: text, why: f"\"{s}\" is not a number"))
        n @ n * 10 + to_i64(s[at] - '0').must()

    return ok(n)

# The value `s` names in `field`: a number, or a name of three letters in any
# case where the field reads names. Fails `invalid` where it is neither or is
# outside the field's bounds.
function value(s: str, field: Field, text: str) -> i64?
    if s.len() == 3 && is_letter(s[0]) && is_letter(s[1]) && is_letter(s[2]) && field.names > 0
        name = [lower(s[0]), lower(s[1]), lower(s[2])]

        known = if field.names == 1
            ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
        else
            ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]

        for at in range(from: 0, to: known.len())
            word = known[at]

            if word[0] == name[0] && word[1] == name[1] && word[2] == name[2]
                return ok(at + field.low)

        return fail(code: INVALID, msg: refused(field: field, text: text, why: f"\"{s}\" is not a name"))
    n = number(s: s, field: field, text: text)?

    if n < field.low || n > field.high
        return fail(
            code: INVALID,
            msg: refused(field: field, text: text, why: f"{n} is outside {field.low} to {field.high}")
        )
    return ok(n)

# One item of `field`, `*`, `?`, a value, a range `a-b`, each with an
# optional step `/n`, or `a/n` from `a` to the field's end. Fails `invalid`
# where the item is none of these.
function item(s: str, field: Field, text: str) -> Item?
    slash = byte_at(s: s, c: '/')
    range_text = s.slice(from: 0, to: slash)
    step: i64 @= 1

    if slash < s.len()
        step_text = s.slice(from: slash + 1, to: s.len())

        if byte_at(s: step_text, c: '/') < step_text.len()
            return fail(code: INVALID, msg: refused(field: field, text: text, why: f"\"{s}\" has two steps"))
        step @ number(s: step_text, field: field, text: text)?

        if step < 1
            return fail(code: INVALID, msg: refused(field: field, text: text, why: f"the step of \"{s}\" is 0"))

    if range_text == "*" || range_text == "?"
        return ok(Item(from: field.low, to: field.last, step: step, open: step == 1))
    dash = byte_at(s: range_text, c: '-')

    if dash == range_text.len()
        from = value(s: range_text, field: field, text: text)?

        if slash < s.len()
            return ok(Item(from: from, to: field.last, step: step, open: false))
        return ok(Item(from: from, to: from, step: 1, open: false))
    last_text = range_text.slice(from: dash + 1, to: range_text.len())

    if byte_at(s: last_text, c: '-') < last_text.len()
        return fail(code: INVALID, msg: refused(field: field, text: text, why: f"\"{s}\" has two dashes"))
    from = value(s: range_text.slice(from: 0, to: dash), field: field, text: text)?
    to: i64 @= value(s: last_text, field: field, text: text)?

    if field.names == 2 && to == 0 && from > 0
        to @ 7

    if to < from
        return fail(
            code: INVALID,
            msg: refused(field: field, text: text, why: f"the range \"{range_text}\" ends before it begins")
        )
    return ok(Item(from: from, to: to, step: step, open: false))

# The bits `it` sets, each value modulo `wrap` (7 for the day of the week, so
# that 7 is Sunday's 0; past every value otherwise).
function bits_of(it: Item, wrap: i64) -> i64
    bits: i64 @= 0
    at: i64 @= it.from

    while at <= it.to
        bits @ bits | 1 << at % wrap
        at @ at + it.step

    return bits

# The bits of a field with no special item: every item's, OR'ed, and whether
# one of them left the field open.
record Plain
    # The values allowed.
    bits: i64
    # Whether an item was `*` or `?`.
    open: bool

# A field of seconds, minutes, hours or months read whole.
function plain(text: str, field: Field) -> Plain?
    bits: i64 @= 0
    open: bool @= false

    for part in items(text)
        if part.len() == 0
            return fail(code: INVALID, msg: refused(field: field, text: text, why: "an item is empty"))
        it = item(s: part, field: field, text: text)?
        bits @ bits | bits_of(it: it, wrap: 64)

        if it.open
            open @ true

    return ok(Plain(bits: bits, open: open))

# The second field, first of six.
function second_field() -> Field
    return Field(name: "second", low: 0, high: 59, last: 59, names: 0)

# The minute field.
function minute_field() -> Field
    return Field(name: "minute", low: 0, high: 59, last: 59, names: 0)

# The hour field.
function hour_field() -> Field
    return Field(name: "hour", low: 0, high: 23, last: 23, names: 0)

# The day-of-the-month field.
function day_field() -> Field
    return Field(name: "day of the month", low: 1, high: 31, last: 31, names: 0)

# The month field.
function month_field() -> Field
    return Field(name: "month", low: 1, high: 12, last: 12, names: 1)

# The day-of-the-week field, 7 read as Sunday.
function weekday_field() -> Field
    return Field(name: "day of the week", low: 0, high: 7, last: 6, names: 2)

test "words: empty, spaces alone, tabs and runs of spaces, and either end"
    assert words("").len() == 0
    assert words(" \t ").len() == 0
    assert words("  0\t0  1 * *  ") == ["0", "0", "1", "*", "*"]
    assert words("@every 1h") == ["@every", "1h"]

test "items: one, several, empty ones at either end and inside"
    assert items("5") == ["5"]
    assert items("1,2,3") == ["1", "2", "3"]
    assert items(",1,,2,") == ["", "1", "", "2", ""]

test "number: zero, leading zeros, nine digits, ten, empty, a sign and a letter"
    f = minute_field()
    assert number(s: "0", field: f, text: "0").must() == 0
    assert number(s: "05", field: f, text: "05").must() == 5
    assert number(s: "999999999", field: f, text: "x").must() == 999_999_999
    assert number(s: "1234567890", field: f, text: "x").is_err()
    assert number(s: "", field: f, text: "x").is_err()
    assert number(s: "-1", field: f, text: "x").is_err()

    match number(s: "a", field: f, text: "a,b")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the minute field \"a,b\": \"a\" is not a number"

test "value: the bounds of each field, past them, names in any case, and a name where none is read"
    assert value(s: "59", field: second_field(), text: "59").must() == 59
    assert value(s: "60", field: minute_field(), text: "60").is_err()
    assert value(s: "0", field: day_field(), text: "0").is_err()
    assert value(s: "jan", field: month_field(), text: "jan").must() == 1
    assert value(s: "DEC", field: month_field(), text: "DEC").must() == 12
    assert value(s: "Sun", field: weekday_field(), text: "Sun").must() == 0
    assert value(s: "sat", field: weekday_field(), text: "sat").must() == 6
    assert value(s: "7", field: weekday_field(), text: "7").must() == 7
    assert value(s: "8", field: weekday_field(), text: "8").is_err()
    assert value(s: "january", field: month_field(), text: "january").is_err()
    assert value(s: "mon", field: hour_field(), text: "mon").is_err()

    match value(s: "xyz", field: month_field(), text: "xyz")
        .ok _  => assert false
        .err e => assert e.msg == "the month field \"xyz\": \"xyz\" is not a name"

    match value(s: "24", field: hour_field(), text: "1,24")
        .ok _  => assert false
        .err e => assert e.msg == "the hour field \"1,24\": 24 is outside 0 to 23"

test "item: a star, a question mark, a value, a range, steps of each, a weekday step ending at Saturday, and the refusals"
    f = minute_field()
    assert item(s: "*", field: f, text: "*").must() == Item(from: 0, to: 59, step: 1, open: true)
    assert item(s: "?", field: f, text: "?").must() == Item(from: 0, to: 59, step: 1, open: true)
    assert item(s: "*/1", field: f, text: "*/1").must() == Item(from: 0, to: 59, step: 1, open: true)
    assert item(s: "*/15", field: f, text: "*/15").must() == Item(from: 0, to: 59, step: 15, open: false)
    assert item(s: "7", field: f, text: "7").must() == Item(from: 7, to: 7, step: 1, open: false)
    assert item(s: "5/15", field: f, text: "5/15").must() == Item(from: 5, to: 59, step: 15, open: false)
    assert item(s: "10-50/5", field: f, text: "10-50/5").must() == Item(from: 10, to: 50, step: 5, open: false)
    assert item(s: "fri-sun", field: weekday_field(), text: "fri-sun").must() == Item(from: 5, to: 7, step: 1, open: false)
    assert item(s: "6-0", field: weekday_field(), text: "6-0").must() == Item(from: 6, to: 7, step: 1, open: false)
    assert item(s: "3/2", field: weekday_field(), text: "3/2").must() == Item(from: 3, to: 6, step: 2, open: false)
    assert item(s: "*/3", field: weekday_field(), text: "*/3").must() == Item(from: 0, to: 6, step: 3, open: false)
    assert item(s: "*", field: weekday_field(), text: "*").must() == Item(from: 0, to: 6, step: 1, open: true)

    for bad in ["*/0", "1-5/0", "1/2/3", "1-2-3", "5-1", "-1", "1-", "/5", "*/", "60", "a"]
        match item(s: bad, field: f, text: bad)
            .ok _  => assert false
            .err e => assert e.code == INVALID

test "bits_of: one value, a range by a step, and Sunday as 7 wrapped to 0"
    assert bits_of(it: Item(from: 3, to: 3, step: 1, open: false), wrap: 64) == 8
    assert bits_of(it: Item(from: 0, to: 59, step: 15, open: false), wrap: 64) == 1 | 1 << 15 | 1 << 30 | 1 << 45
    assert bits_of(it: Item(from: 5, to: 7, step: 1, open: false), wrap: 7) == 1 | 1 << 5 | 1 << 6
    assert bits_of(it: Item(from: 0, to: 59, step: 1, open: true), wrap: 64) == (1 << 60) - 1

test "plain: a list, a star inside a list, and an empty item refused"
    assert plain(text: "1,2,5", field: minute_field()).must() == Plain(bits: 2 | 4 | 32, open: false)
    assert plain(text: "*,5", field: minute_field()).must().open

    match plain(text: "1,,2", field: minute_field())
        .ok _  => assert false
        .err e => assert e.msg == "the minute field \"1,,2\": an item is empty"
