# How a failure of the floor `crypto/hero_crypto` becomes a code of README
# § A4 and a message that says what was asked and what was found, for
# `crypto/keypairs`. Data that do not decrypt are `invalid`, input that is not
# what `decrypt` reads, and the message tells nothing more. The system's own
# words follow in brackets where it gave some.

use bytes
use crypto/hero_crypto

constant INVALID: str
    "invalid"

constant CLOSED: str
    "closed"

constant LIMIT: str
    "limit"

constant UNSUPPORTED: str
    "unsupported"

constant FAILED: str
    "failed"

# A kind told: its code and the words that say what was found.
record Told
    # A code of README § A4.
    code: str
    # What was found, in words a reader can act on.
    why: str

# The code and the words for `kind`, one of the floor's kinds.
function told(kind: i64) -> Told
    if kind == hero_crypto.HERO_CRYPTO_INVALID
        return Told(code: INVALID, why: "the layer refuses an argument")

    if kind == hero_crypto.HERO_CRYPTO_NOT_OPEN
        return Told(code: CLOSED, why: "the key is closed")

    if kind == hero_crypto.HERO_CRYPTO_LIMIT
        return Told(
            code: LIMIT,
            why: "the system has no memory or key left"
        )

    if kind == hero_crypto.HERO_CRYPTO_UNSUPPORTED
        return Told(code: UNSUPPORTED, why: "this platform's own cryptography does not offer it")

    if kind == hero_crypto.HERO_CRYPTO_FORGED
        return Told(
            code: INVALID,
            why: "the data do not decrypt under this key"
        )
    return Told(code: FAILED, why: "the system failed")

# The floor's words for its last failure on this thread, "" where it gave
# none.
function words() -> str
    buffer: [u8] @= []
    length = hero_crypto.last_message(@buffer, count: 512)

    if length <= 0
        return ""
    return bytes.to_text(buffer.slice(from: 0, to: length)).default("")

# The floor's last failure on this thread as a `T?` whose message begins
# with `asked`. It is called right after the call that failed.
function last<T>(asked: str) -> T?
    found = told(hero_crypto.last_error())
    said = words()

    if said == ""
        return fail(code: found.code, msg: asked + ": " + found.why)
    return fail(code: found.code, msg: asked + ": " + found.why + " (" + said + ")")

# A failure the face finds itself, before the floor is asked.
function of<T>(code: str, asked: str, why: str) -> T?
    return fail(code: code, msg: asked + ": " + why)

## Tests

test "told: every kind of the floor has a code of README § A4, data that do not decrypt invalid and saying so"
    assert told(hero_crypto.HERO_CRYPTO_INVALID).code == INVALID
    assert told(hero_crypto.HERO_CRYPTO_NOT_OPEN).code == CLOSED
    assert told(hero_crypto.HERO_CRYPTO_LIMIT).code == LIMIT
    assert told(hero_crypto.HERO_CRYPTO_UNSUPPORTED).code == UNSUPPORTED
    assert told(hero_crypto.HERO_CRYPTO_OTHER).code == FAILED
    assert told(hero_crypto.HERO_CRYPTO_FORGED).code == INVALID
    assert told(hero_crypto.HERO_CRYPTO_FORGED).why == "the data do not decrypt under this key"
    assert told(9999).code == FAILED

test "last: the floor's last failure begins with what was asked, and the system's words follow in brackets"
    made = hero_crypto.generate(kind: hero_crypto.HERO_CRYPTO_RSA, bits: 1024)
    assert made == nullptr
    answer: i64? = last(asked: "making a key")

    match answer
        .ok _ => assert false
        .err e =>
            assert e.code == INVALID
            assert e.msg == "making a key: the layer refuses an argument (an RSA key is made of 2048, 3072 or 4096 bits)"

test "of: a failure found before the floor is asked"
    answer: i64? = of(code: CLOSED, asked: "signing", why: "the key is closed")

    match answer
        .ok _ => assert false
        .err e =>
            assert e.code == CLOSED
            assert e.msg == "signing: the key is closed"
