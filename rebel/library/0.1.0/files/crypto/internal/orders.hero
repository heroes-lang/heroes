# The four words each of a round's eight mixings works on: four columns,
# then four diagonals of the working words seen as a square.
constant MIXED: [i64]
    [0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15, 0, 5, 10, 15, 1, 6, 11, 12, 2, 7, 8, 13, 3, 4, 9, 14]

