capability amqp/recover  what a channel did not acknowledge sent again
  heroes  amqp.recover
  go      Channel.Recover
  rust    Channel::basic_recover, Channel::basic_recover_async, options::BasicRecoverOptions, options::BasicRecoverAsyncOptions
  python  BlockingChannel.basic_recover
