# A JSON pointer, RFC 6901: a path of keys and indices written as text, each
# token after a `/`, a `~` in a token written `~0` and a `/` written `~1`.

use numbers
use strings

# The code of a pointer that is not one, or a token that is no index.
constant INVALID: str
    "invalid"

# The code of an index that names no element.
constant NOT_FOUND: str
    "not_found"

# The pointer whose tokens are `tokens`, each escaped.
function of(tokens: [str]) -> str
    pieces: [str] @= []

    for token in tokens
        escaped = strings.replace_all(s: token, old: "~", new: "~0")
        pieces @ pieces.push("/" + strings.replace_all(s: escaped, old: "/", new: "~1"))

    return pieces.join("")

# The tokens of `pointer`, each unescaped. Fails `invalid` where `pointer` is
# not empty and does not begin with `/`, or holds a `~` that neither `0` nor
# `1` follows.
function tokens_of(pointer: str) -> [str]?
    out: [str] @= []

    if pointer == ""
        return ok(out)

    if pointer[0] != '/'
        return fail(code: INVALID, msg: f"\"{pointer}\" is no JSON pointer: one begins with `/`, or is empty")
    pieces: [str] @= []
    run: i64 @= 1
    i: i64 @= 1

    while i <= pointer.len()
        if i == pointer.len() || pointer[i] == '/'
            pieces @ pieces.push(pointer.slice(from: run, to: i))
            out @ out.push(pieces.join(""))
            pieces @ []
            run @ i + 1
            i @ i + 1
        else if pointer[i] == '~'
            if i + 1 >= pointer.len() || pointer[i + 1] != '0' && pointer[i + 1] != '1'
                return fail(
                    code: INVALID,
                    msg: f"\"{pointer}\" is no JSON pointer: a `~` in it stands only before `0` or `1`, at byte {i}"
                )
            pieces @ pieces.push(pointer.slice(from: run, to: i))

            if pointer[i + 1] == '0'
                pieces @ pieces.push("~")
            else
                pieces @ pieces.push("/")
            run @ i + 2
            i @ i + 2
        else
            i @ i + 1

    return ok(out)

# The index of a list that `token` names: `0`, or a digit from 1 to 9 and
# digits. Fails `invalid` where it is anything else, `-` included, which names
# the place after the last element; fails `not_found` where the index is past
# what an `i64` holds, since no list holds that many.
function list_index(token: str) -> i64?
    if token == "-"
        return fail(code: NOT_FOUND, msg: "`-` names the place after a list's last element, which holds nothing")

    if token == "" || token.len() > 1 && token[0] == '0'
        return fail(
            code: INVALID,
            msg: f"\"{token}\" names no element: an index is 0, or digits that do not begin with 0"
        )

    for c in token.chars()
        if c[0] < '0' || c[0] > '9'
            return fail(
                code: INVALID,
                msg: f"\"{token}\" names no element: an index is 0, or digits that do not begin with 0"
            )

    return match numbers.parse_int(token)
        .ok index => ok(index)
        .err _    => fail(code: NOT_FOUND, msg: f"no list holds an element at {token}")

## Tests

test "of: none, plain tokens, the empty token, and both escapes"
    assert of([]) == ""
    assert of(["users", "0", "name"]) == "/users/0/name"
    assert of([""]) == "/"
    assert of(["a/b", "m~n"]) == "/a~1b/m~0n"
    assert of(["~1"]) == "/~01"

test "tokens_of: the empty pointer, the whole document, escapes, and RFC 6901's examples"
    nothing: [str] = []
    assert tokens_of("").must() == nothing
    assert tokens_of("/").must() == [""]
    assert tokens_of("/foo/0").must() == ["foo", "0"]
    assert tokens_of("/a~1b").must() == ["a/b"]
    assert tokens_of("/m~0n").must() == ["m~n"]
    assert tokens_of("/~01").must() == ["~1"]
    assert tokens_of("//").must() == ["", ""]
    assert tokens_of("/città/é").must() == ["città", "é"]

test "tokens_of: no leading slash, and a tilde with no 0 or 1 after it"
    match tokens_of("foo")
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "\"foo\" is no JSON pointer: one begins with `/`, or is empty"

    assert tokens_of("/a~2").is_err()
    assert tokens_of("/a~").is_err()

test "list_index: zero, a number, a leading zero, a sign, the dash, and past an i64"
    assert list_index("0").must() == 0
    assert list_index("12").must() == 12
    assert list_index("01").is_err()
    assert list_index("-1").is_err()
    assert list_index("+1").is_err()
    assert list_index("").is_err()
    assert list_index("1a").is_err()

    match list_index("-")
        .ok _  => assert false
        .err e => assert e.code == "not_found"

    match list_index("99999999999999999999")
        .ok _  => assert false
        .err e => assert e.code == "not_found"
