test "format-regex 2: validation of regular expressions"
    assert suite.failures(dialects: [7, 2020], asserting: true, content: false, schema: "{\"format\":\"regex\"}", externals: "{}", tests: "[{\"description\":\"a valid regular expression\",\"data\":\"([abc])+\\\\s+$\",\"valid\":true},{\"description\":\"a regular expression with unclosed parens is invalid\",\"data\":\"^(abc]\",\"valid\":false},{\"description\":\"a quantifier with nothing to repeat is invalid\",\"data\":\"*a\",\"valid\":false},{\"description\":\"a character class range in reverse order is invalid\",\"data\":\"[z-a]\",\"valid\":false},{\"description\":\"a trailing backslash is invalid\",\"data\":\"\\\\\",\"valid\":false},{\"description\":\"an unmatched closing parenthesis is invalid\",\"data\":\"a)\",\"valid\":false},{\"description\":\"an unterminated character class is invalid\",\"data\":\"[abc\",\"valid\":false},{\"description\":\"an empty regular expression is valid\",\"data\":\"\",\"valid\":true},{\"description\":\"alternation is valid\",\"data\":\"a|b\",\"valid\":true},{\"description\":\"a bounded quantifier is valid\",\"data\":\"a{2,3}\",\"valid\":true},{\"description\":\"a negated range character class is valid\",\"data\":\"[^a-z]\",\"valid\":true},{\"description\":\"a lazy quantifier is valid\",\"data\":\"a+?\",\"valid\":true}]") == ""

