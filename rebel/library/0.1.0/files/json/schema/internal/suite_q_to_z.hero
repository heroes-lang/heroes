# The JSON Schema Test Suite (github.com/json-schema-org/JSON-Schema-Test-Suite,
# commit e2a68a15 of 2026-11-16, its `validation/tests` as fetched on
# 2026-11-17): every case its `compatibility` gives to draft 7 or to 2020-12
# among `recursiveRef.json`, `ref-legacy.json`, `ref.json` and the rest of its group,
# each run under each dialect it is given to. A case tagged
# `format-assertion` is run with formats asserted. Each is a test; nothing
# else here is compiled into a program.

use json/schema/internal/suite

# How many of the suite's cases this module holds.
constant CASES: i64
    139

test "ref-legacy 0: relative pointer ref to array"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"items\":[{\"type\":\"integer\"},{\"$ref\":\"#/items/0\"}]}", externals: "{}", tests: "[{\"description\":\"match array\",\"data\":[1,2],\"valid\":true},{\"description\":\"mismatch array\",\"data\":[1,\"foo\"],\"valid\":false}]") == ""

test "ref-legacy 1: escaped pointer ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"definitions\":{\"tilde~field\":{\"type\":\"integer\"},\"slash/field\":{\"type\":\"integer\"},\"percent%field\":{\"type\":\"integer\"}},\"properties\":{\"tilde\":{\"$ref\":\"#/definitions/tilde~0field\"},\"slash\":{\"$ref\":\"#/definitions/slash~1field\"},\"percent\":{\"$ref\":\"#/definitions/percent%25field\"}}}", externals: "{}", tests: "[{\"description\":\"slash invalid\",\"data\":{\"slash\":\"aoeu\"},\"valid\":false},{\"description\":\"tilde invalid\",\"data\":{\"tilde\":\"aoeu\"},\"valid\":false},{\"description\":\"percent invalid\",\"data\":{\"percent\":\"aoeu\"},\"valid\":false},{\"description\":\"slash valid\",\"data\":{\"slash\":123},\"valid\":true},{\"description\":\"tilde valid\",\"data\":{\"tilde\":123},\"valid\":true},{\"description\":\"percent valid\",\"data\":{\"percent\":123},\"valid\":true}]") == ""

test "ref-legacy 2: nested refs"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"definitions\":{\"a\":{\"type\":\"integer\"},\"b\":{\"$ref\":\"#/definitions/a\"},\"c\":{\"$ref\":\"#/definitions/b\"}},\"properties\":{\"foo\":{\"$ref\":\"#/definitions/c\"}}}", externals: "{}", tests: "[{\"description\":\"nested ref valid\",\"data\":{\"foo\":5},\"valid\":true},{\"description\":\"nested ref invalid\",\"data\":{\"foo\":\"a\"},\"valid\":false}]") == ""

test "ref-legacy 3: ref overrides any sibling keywords"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"definitions\":{\"reffed\":{\"type\":\"array\"}},\"properties\":{\"foo\":{\"$ref\":\"#/definitions/reffed\",\"maxItems\":2}}}", externals: "{}", tests: "[{\"description\":\"ref valid\",\"data\":{\"foo\":[]},\"valid\":true},{\"description\":\"ref valid, maxItems ignored\",\"data\":{\"foo\":[1,2,3]},\"valid\":true},{\"description\":\"ref invalid\",\"data\":{\"foo\":\"string\"},\"valid\":false}]") == ""

test "ref-legacy 4: property named $ref, containing an actual $ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"properties\":{\"$ref\":{\"$ref\":\"#/definitions/is-string\"}},\"definitions\":{\"is-string\":{\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"property named $ref valid\",\"data\":{\"$ref\":\"a\"},\"valid\":true},{\"description\":\"property named $ref invalid\",\"data\":{\"$ref\":2},\"valid\":false}]") == ""

test "ref-legacy 5: naive replacement of $ref with its destination is not correct"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"definitions\":{\"a_string\":{\"type\":\"string\"}},\"enum\":[{\"$ref\":\"#/definitions/a_string\"}]}", externals: "{}", tests: "[{\"description\":\"do not evaluate the $ref inside the enum, matching any string\",\"data\":\"this is a string\",\"valid\":false},{\"description\":\"do not evaluate the $ref inside the enum, definition exact match\",\"data\":{\"type\":\"string\"},\"valid\":false},{\"description\":\"match the enum exactly\",\"data\":{\"$ref\":\"#/definitions/a_string\"},\"valid\":true}]") == ""

test "ref-legacy 6: $ref to boolean schema true"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#/definitions/bool\"}],\"definitions\":{\"bool\":true}}", externals: "{}", tests: "[{\"description\":\"any value is valid\",\"data\":\"foo\",\"valid\":true}]") == ""

test "ref-legacy 7: $ref to boolean schema false"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#/definitions/bool\"}],\"definitions\":{\"bool\":false}}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "ref-legacy 8: refs with quote"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"properties\":{\"foo\\\"bar\":{\"$ref\":\"#/definitions/foo%22bar\"}},\"definitions\":{\"foo\\\"bar\":{\"type\":\"number\"}}}", externals: "{}", tests: "[{\"description\":\"object with numbers is valid\",\"data\":{\"foo\\\"bar\":1},\"valid\":true},{\"description\":\"object with strings is invalid\",\"data\":{\"foo\\\"bar\":\"1\"},\"valid\":false}]") == ""

test "ref-legacy 9: empty tokens in $ref json-pointer"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"definitions\":{\"\":{\"definitions\":{\"\":{\"type\":\"number\"}}}},\"properties\":{\"foo\":{\"$ref\":\"#/definitions//definitions/\"}}}", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"non-number is invalid\",\"data\":{\"foo\":\"a\"},\"valid\":false}]") == ""

test "ref-legacy 10: fragment within remote ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/subSchemas.json#/definitions/integer\"}", externals: "{\"http://localhost:1234/subSchemas.json\":{\"definitions\":{\"integer\":{\"type\":\"integer\"}}}}", tests: "[{\"description\":\"remote fragment valid\",\"data\":1,\"valid\":true},{\"description\":\"remote fragment invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref-legacy 11: ref within remote ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/subSchemas.json#/definitions/refToInteger\"}", externals: "{\"http://localhost:1234/subSchemas.json\":{\"definitions\":{\"integer\":{\"type\":\"integer\"},\"refToInteger\":{\"$ref\":\"#/definitions/integer\"}}}}", tests: "[{\"description\":\"ref within ref valid\",\"data\":1,\"valid\":true},{\"description\":\"ref within ref invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref-legacy 12: root ref in remote ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"type\":\"object\",\"properties\":{\"name\":{\"$ref\":\"http://localhost:1234/name.json#/definitions/orNull\"}}}", externals: "{\"http://localhost:1234/name.json\":{\"definitions\":{\"orNull\":{\"anyOf\":[{\"type\":\"null\"},{\"$ref\":\"#\"}]}},\"type\":\"string\"}}", tests: "[{\"description\":\"string is valid\",\"data\":{\"name\":\"foo\"},\"valid\":true},{\"description\":\"null is valid\",\"data\":{\"name\":null},\"valid\":true},{\"description\":\"object is invalid\",\"data\":{\"name\":{\"name\":null}},\"valid\":false}]") == ""

test "ref-legacy 13: remote ref with ref to definitions"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"http://localhost:1234/ref-and-definitions.json\"}]}", externals: "{\"http://localhost:1234/ref-and-definitions.json\":{\"definitions\":{\"inner\":{\"properties\":{\"bar\":{\"type\":\"string\"}}}},\"allOf\":[{\"$ref\":\"#/definitions/inner\"}]}}", tests: "[{\"description\":\"invalid\",\"data\":{\"bar\":1},\"valid\":false},{\"description\":\"valid\",\"data\":{\"bar\":\"a\"},\"valid\":true}]") == ""

test "ref 0: root pointer ref"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{\"$ref\":\"#\"}},\"additionalProperties\":false}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":{\"foo\":false},\"valid\":true},{\"description\":\"recursive match\",\"data\":{\"foo\":{\"foo\":false}},\"valid\":true},{\"description\":\"mismatch\",\"data\":{\"bar\":false},\"valid\":false},{\"description\":\"recursive mismatch\",\"data\":{\"foo\":{\"bar\":false}},\"valid\":false}]") == ""

test "ref 1: relative pointer ref to object"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{\"type\":\"integer\"},\"bar\":{\"$ref\":\"#/properties/foo\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":{\"bar\":3},\"valid\":true},{\"description\":\"mismatch\",\"data\":{\"bar\":true},\"valid\":false}]") == ""

test "ref 2: relative pointer ref to array"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"prefixItems\":[{\"type\":\"integer\"},{\"$ref\":\"#/prefixItems/0\"}]}", externals: "{}", tests: "[{\"description\":\"match array\",\"data\":[1,2],\"valid\":true},{\"description\":\"mismatch array\",\"data\":[1,\"foo\"],\"valid\":false}]") == ""

test "ref 3: escaped pointer ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"tilde~field\":{\"type\":\"integer\"},\"slash/field\":{\"type\":\"integer\"},\"percent%field\":{\"type\":\"integer\"}},\"properties\":{\"tilde\":{\"$ref\":\"#/$defs/tilde~0field\"},\"slash\":{\"$ref\":\"#/$defs/slash~1field\"},\"percent\":{\"$ref\":\"#/$defs/percent%25field\"}}}", externals: "{}", tests: "[{\"description\":\"slash invalid\",\"data\":{\"slash\":\"aoeu\"},\"valid\":false},{\"description\":\"tilde invalid\",\"data\":{\"tilde\":\"aoeu\"},\"valid\":false},{\"description\":\"percent invalid\",\"data\":{\"percent\":\"aoeu\"},\"valid\":false},{\"description\":\"slash valid\",\"data\":{\"slash\":123},\"valid\":true},{\"description\":\"tilde valid\",\"data\":{\"tilde\":123},\"valid\":true},{\"description\":\"percent valid\",\"data\":{\"percent\":123},\"valid\":true}]") == ""

test "ref 4: nested refs"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"a\":{\"type\":\"integer\"},\"b\":{\"$ref\":\"#/$defs/a\"},\"c\":{\"$ref\":\"#/$defs/b\"}},\"$ref\":\"#/$defs/c\"}", externals: "{}", tests: "[{\"description\":\"nested ref valid\",\"data\":5,\"valid\":true},{\"description\":\"nested ref invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref 5: ref applies alongside sibling keywords"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"reffed\":{\"type\":\"array\"}},\"properties\":{\"foo\":{\"$ref\":\"#/$defs/reffed\",\"maxItems\":2}}}", externals: "{}", tests: "[{\"description\":\"ref valid, maxItems valid\",\"data\":{\"foo\":[]},\"valid\":true},{\"description\":\"ref valid, maxItems invalid\",\"data\":{\"foo\":[1,2,3]},\"valid\":false},{\"description\":\"ref invalid\",\"data\":{\"foo\":\"string\"},\"valid\":false}]") == ""

test "ref 6: property named $ref that is not a reference"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"$ref\":{\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"property named $ref valid\",\"data\":{\"$ref\":\"a\"},\"valid\":true},{\"description\":\"property named $ref invalid\",\"data\":{\"$ref\":2},\"valid\":false}]") == ""

test "ref 7: property named $ref, containing an actual $ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"properties\":{\"$ref\":{\"$ref\":\"#/$defs/is-string\"}},\"$defs\":{\"is-string\":{\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"property named $ref valid\",\"data\":{\"$ref\":\"a\"},\"valid\":true},{\"description\":\"property named $ref invalid\",\"data\":{\"$ref\":2},\"valid\":false}]") == ""

test "ref 8: naive replacement of $ref with its destination is not correct"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"a_string\":{\"type\":\"string\"}},\"enum\":[{\"$ref\":\"#/$defs/a_string\"}]}", externals: "{}", tests: "[{\"description\":\"do not evaluate the $ref inside the enum, matching any string\",\"data\":\"this is a string\",\"valid\":false},{\"description\":\"do not evaluate the $ref inside the enum, definition exact match\",\"data\":{\"type\":\"string\"},\"valid\":false},{\"description\":\"match the enum exactly\",\"data\":{\"$ref\":\"#/$defs/a_string\"},\"valid\":true}]") == ""

test "ref 9: $ref to boolean schema true"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"#/$defs/bool\",\"$defs\":{\"bool\":true}}", externals: "{}", tests: "[{\"description\":\"any value is valid\",\"data\":\"foo\",\"valid\":true}]") == ""

test "ref 10: $ref to boolean schema false"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"#/$defs/bool\",\"$defs\":{\"bool\":false}}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "ref 11: Recursive references between schemas"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/tree\"}", externals: "{\"http://localhost:1234/tree\":{\"description\":\"tree of nodes\",\"type\":\"object\",\"properties\":{\"meta\":{\"type\":\"string\"},\"nodes\":{\"type\":\"array\",\"items\":{\"$ref\":\"node\"}}}},\"http://localhost:1234/node\":{\"description\":\"node\",\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\"},\"subtree\":{\"$ref\":\"tree\"}}}}", tests: "[{\"description\":\"valid tree\",\"data\":{\"meta\":\"root\",\"nodes\":[{\"value\":1,\"subtree\":{\"meta\":\"child\",\"nodes\":[{\"value\":1.1},{\"value\":1.2}]}},{\"value\":2,\"subtree\":{\"meta\":\"child\",\"nodes\":[{\"value\":2.1},{\"value\":2.2}]}}]},\"valid\":true},{\"description\":\"invalid tree\",\"data\":{\"meta\":\"root\",\"nodes\":[{\"value\":1,\"subtree\":{\"meta\":\"child\",\"nodes\":[{\"value\":\"string is invalid\"},{\"value\":1.2}]}},{\"value\":2,\"subtree\":{\"meta\":\"child\",\"nodes\":[{\"value\":2.1},{\"value\":2.2}]}}]},\"valid\":false}]") == ""

test "ref 12: refs with quote"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\\\"bar\":{\"$ref\":\"#/$defs/foo%22bar\"}},\"$defs\":{\"foo\\\"bar\":{\"type\":\"number\"}}}", externals: "{}", tests: "[{\"description\":\"object with numbers is valid\",\"data\":{\"foo\\\"bar\":1},\"valid\":true},{\"description\":\"object with strings is invalid\",\"data\":{\"foo\\\"bar\":\"1\"},\"valid\":false}]") == ""

test "ref 13: ref creates new scope when adjacent to keywords"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"A\":{\"unevaluatedProperties\":false}},\"properties\":{\"prop1\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/A\"}", externals: "{}", tests: "[{\"description\":\"referenced subschema doesn't see annotations from properties\",\"data\":{\"prop1\":\"match\"},\"valid\":false}]") == ""

test "ref 14: ref to if"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#/if\"}],\"if\":{\"type\":\"integer\"}}", externals: "{}", tests: "[{\"description\":\"a non-integer is invalid due to the $ref\",\"data\":\"foo\",\"valid\":false},{\"description\":\"an integer is valid\",\"data\":12,\"valid\":true}]") == ""

test "ref 15: ref to then"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#/then\"}],\"then\":{\"type\":\"integer\"}}", externals: "{}", tests: "[{\"description\":\"a non-integer is invalid due to the $ref\",\"data\":\"foo\",\"valid\":false},{\"description\":\"an integer is valid\",\"data\":12,\"valid\":true}]") == ""

test "ref 16: ref to else"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#/else\"}],\"else\":{\"type\":\"integer\"}}", externals: "{}", tests: "[{\"description\":\"a non-integer is invalid due to the $ref\",\"data\":\"foo\",\"valid\":false},{\"description\":\"an integer is valid\",\"data\":12,\"valid\":true}]") == ""

test "ref 17: empty tokens in $ref json-pointer"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$defs\":{\"\":{\"$defs\":{\"\":{\"type\":\"number\"}}}},\"allOf\":[{\"$ref\":\"#/$defs//$defs/\"}]}", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"non-number is invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref 18: remote ref"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/integer.json\"}", externals: "{\"http://localhost:1234/integer.json\":{\"type\":\"integer\"}}", tests: "[{\"description\":\"remote ref valid\",\"data\":1,\"valid\":true},{\"description\":\"remote ref invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref 19: fragment within remote ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/subSchemas.json#/$defs/integer\"}", externals: "{\"http://localhost:1234/subSchemas.json\":{\"$defs\":{\"integer\":{\"type\":\"integer\"}}}}", tests: "[{\"description\":\"remote fragment valid\",\"data\":1,\"valid\":true},{\"description\":\"remote fragment invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref 20: ref within remote ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/subSchemas.json#/$defs/refToInteger\"}", externals: "{\"http://localhost:1234/subSchemas.json\":{\"$defs\":{\"integer\":{\"type\":\"integer\"},\"refToInteger\":{\"$ref\":\"#/$defs/integer\"}}}}", tests: "[{\"description\":\"ref within ref valid\",\"data\":1,\"valid\":true},{\"description\":\"ref within ref invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "ref 21: root ref in remote ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"type\":\"object\",\"properties\":{\"name\":{\"$ref\":\"http://localhost:1234/name-defs.json#/$defs/orNull\"}}}", externals: "{\"http://localhost:1234/name-defs.json\":{\"$defs\":{\"orNull\":{\"anyOf\":[{\"type\":\"null\"},{\"$ref\":\"#\"}]}},\"type\":\"string\"}}", tests: "[{\"description\":\"string is valid\",\"data\":{\"name\":\"foo\"},\"valid\":true},{\"description\":\"null is valid\",\"data\":{\"name\":null},\"valid\":true},{\"description\":\"object is invalid\",\"data\":{\"name\":{\"name\":null}},\"valid\":false}]") == ""

test "ref 22: remote ref with ref to defs"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/ref-and-defs.json\"}", externals: "{\"http://localhost:1234/ref-and-defs.json\":{\"$defs\":{\"inner\":{\"properties\":{\"bar\":{\"type\":\"string\"}}}},\"$ref\":\"#/$defs/inner\"}}", tests: "[{\"description\":\"invalid\",\"data\":{\"bar\":1},\"valid\":false},{\"description\":\"valid\",\"data\":{\"bar\":\"a\"},\"valid\":true}]") == ""

test "required 1: required validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{},\"bar\":{}},\"required\":[\"foo\"]}", externals: "{}", tests: "[{\"description\":\"present required property is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"non-present required property is invalid\",\"data\":{\"bar\":1},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true},{\"description\":\"ignores null\",\"data\":null,\"valid\":true},{\"description\":\"ignores boolean\",\"data\":true,\"valid\":true}]") == ""

test "required 2: required default validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{}}}", externals: "{}", tests: "[{\"description\":\"not required by default\",\"data\":{},\"valid\":true}]") == ""

test "required 4: required with empty array"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{}},\"required\":[]}", externals: "{}", tests: "[{\"description\":\"property not required\",\"data\":{},\"valid\":true}]") == ""

test "required 5: required with escaped characters"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"required\":[\"foo\\nbar\",\"foo\\\"bar\",\"foo\\\\bar\",\"foo\\rbar\",\"foo\\tbar\",\"foo\\fbar\"]}", externals: "{}", tests: "[{\"description\":\"object with all properties present is valid\",\"data\":{\"foo\\nbar\":1,\"foo\\\"bar\":1,\"foo\\\\bar\":1,\"foo\\rbar\":1,\"foo\\tbar\":1,\"foo\\fbar\":1},\"valid\":true},{\"description\":\"object with some properties missing is invalid\",\"data\":{\"foo\\nbar\":\"1\",\"foo\\\"bar\":\"1\"},\"valid\":false}]") == ""

test "required 6: required properties whose names are Javascript object property names"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"required\":[\"__proto__\",\"toString\",\"constructor\"]}", externals: "{}", tests: "[{\"description\":\"ignores arrays\",\"data\":[],\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true},{\"description\":\"none of the properties mentioned\",\"data\":{},\"valid\":false},{\"description\":\"__proto__ present\",\"data\":{\"__proto__\":\"foo\"},\"valid\":false},{\"description\":\"toString present\",\"data\":{\"toString\":{\"length\":37}},\"valid\":false},{\"description\":\"constructor present\",\"data\":{\"constructor\":{\"length\":37}},\"valid\":false},{\"description\":\"all present\",\"data\":{\"__proto__\":12,\"toString\":{\"length\":\"foo\"},\"constructor\":37},\"valid\":true}]") == ""

test "type 0: integer type matches integers"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"integer\"}", externals: "{}", tests: "[{\"description\":\"an integer is an integer\",\"data\":1,\"valid\":true},{\"description\":\"a float is not an integer\",\"data\":1.1,\"valid\":false},{\"description\":\"a string is not an integer\",\"data\":\"foo\",\"valid\":false},{\"description\":\"a string is still not an integer, even if it looks like one\",\"data\":\"1\",\"valid\":false},{\"description\":\"an object is not an integer\",\"data\":{},\"valid\":false},{\"description\":\"an array is not an integer\",\"data\":[],\"valid\":false},{\"description\":\"a boolean is not an integer\",\"data\":true,\"valid\":false},{\"description\":\"null is not an integer\",\"data\":null,\"valid\":false}]") == ""

test "type 1: integer type matches integers (6)"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"integer\"}", externals: "{}", tests: "[{\"description\":\"a float with zero fractional part is an integer\",\"data\":1.0,\"valid\":true}]") == ""

test "type 2: number type matches numbers"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"number\"}", externals: "{}", tests: "[{\"description\":\"an integer is a number\",\"data\":1,\"valid\":true},{\"description\":\"a float with zero fractional part is a number\",\"data\":1.0,\"valid\":true},{\"description\":\"a float is a number\",\"data\":1.1,\"valid\":true},{\"description\":\"a string is not a number\",\"data\":\"foo\",\"valid\":false},{\"description\":\"a string is still not a number, even if it looks like one\",\"data\":\"1\",\"valid\":false},{\"description\":\"an object is not a number\",\"data\":{},\"valid\":false},{\"description\":\"an array is not a number\",\"data\":[],\"valid\":false},{\"description\":\"a boolean is not a number\",\"data\":true,\"valid\":false},{\"description\":\"null is not a number\",\"data\":null,\"valid\":false}]") == ""

test "type 3: string type matches strings"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\"}", externals: "{}", tests: "[{\"description\":\"1 is not a string\",\"data\":1,\"valid\":false},{\"description\":\"a float is not a string\",\"data\":1.1,\"valid\":false},{\"description\":\"a string is a string\",\"data\":\"foo\",\"valid\":true},{\"description\":\"a string is still a string, even if it looks like a number\",\"data\":\"1\",\"valid\":true},{\"description\":\"an empty string is still a string\",\"data\":\"\",\"valid\":true},{\"description\":\"an object is not a string\",\"data\":{},\"valid\":false},{\"description\":\"an array is not a string\",\"data\":[],\"valid\":false},{\"description\":\"a boolean is not a string\",\"data\":true,\"valid\":false},{\"description\":\"null is not a string\",\"data\":null,\"valid\":false}]") == ""

test "type 4: object type matches objects"
