# The JSON Schema Test Suite (github.com/json-schema-org/JSON-Schema-Test-Suite,
# commit e2a68a15 of 2026-11-16, its `validation/tests` as fetched on
# 2026-11-17): every case its `compatibility` gives to draft 7 or to 2020-12
# among `maxItems.json`, `maxLength.json`, `maxProperties.json` and the rest of its group,
# each run under each dialect it is given to. A case tagged
# `format-assertion` is run with formats asserted. Each is a test; nothing
# else here is compiled into a program.

use json/schema/internal/suite

# How many of the suite's cases this module holds.
constant CASES: i64
    67

test "maxItems 0: maxItems validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxItems\":2}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":[1],\"valid\":true},{\"description\":\"exact length is valid\",\"data\":[1,2],\"valid\":true},{\"description\":\"too long is invalid\",\"data\":[1,2,3],\"valid\":false},{\"description\":\"ignores non-arrays\",\"data\":\"foobar\",\"valid\":true}]") == ""

test "maxItems 1: maxItems validation with a decimal"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxItems\":2.0}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":[1],\"valid\":true},{\"description\":\"too long is invalid\",\"data\":[1,2,3],\"valid\":false}]") == ""

test "maxLength 0: maxLength validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxLength\":2}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":\"f\",\"valid\":true},{\"description\":\"exact length is valid\",\"data\":\"fo\",\"valid\":true},{\"description\":\"too long is invalid\",\"data\":\"foo\",\"valid\":false},{\"description\":\"ignores non-strings\",\"data\":100,\"valid\":true},{\"description\":\"two graphemes is long enough\",\"data\":\"💩💩\",\"valid\":true}]") == ""

test "maxLength 1: maxLength validation with a decimal"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxLength\":2.0}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":\"f\",\"valid\":true},{\"description\":\"too long is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "maxProperties 0: maxProperties validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxProperties\":2}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"exact length is valid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"too long is invalid\",\"data\":{\"foo\":1,\"bar\":2,\"baz\":3},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[1,2,3],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"foobar\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true}]") == ""

test "maxProperties 1: maxProperties validation with a decimal"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxProperties\":2.0}", externals: "{}", tests: "[{\"description\":\"shorter is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"too long is invalid\",\"data\":{\"foo\":1,\"bar\":2,\"baz\":3},\"valid\":false}]") == ""

test "maxProperties 2: maxProperties = 0 means the object is empty"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maxProperties\":0}", externals: "{}", tests: "[{\"description\":\"no properties is valid\",\"data\":{},\"valid\":true},{\"description\":\"one property is invalid\",\"data\":{\"foo\":1},\"valid\":false}]") == ""

test "maximum 0: maximum validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maximum\":3.0}", externals: "{}", tests: "[{\"description\":\"below the maximum is valid\",\"data\":2.6,\"valid\":true},{\"description\":\"boundary point is valid\",\"data\":3.0,\"valid\":true},{\"description\":\"above the maximum is invalid\",\"data\":3.5,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"x\",\"valid\":true}]") == ""

test "maximum 1: maximum validation with unsigned integer"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"maximum\":300}", externals: "{}", tests: "[{\"description\":\"below the maximum is valid\",\"data\":299.97,\"valid\":true},{\"description\":\"boundary point integer is valid\",\"data\":300,\"valid\":true},{\"description\":\"boundary point float is valid\",\"data\":300.0,\"valid\":true},{\"description\":\"above the maximum is invalid\",\"data\":300.5,\"valid\":false}]") == ""

test "maximum 4: exclusiveMaximum validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"exclusiveMaximum\":3.0}", externals: "{}", tests: "[{\"description\":\"below the exclusiveMaximum is valid\",\"data\":2.2,\"valid\":true},{\"description\":\"boundary point is invalid\",\"data\":3.0,\"valid\":false},{\"description\":\"above the exclusiveMaximum is invalid\",\"data\":3.5,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"x\",\"valid\":true}]") == ""

