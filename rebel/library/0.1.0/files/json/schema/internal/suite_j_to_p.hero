    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minItems\":1.0}", externals: "{}", tests: "[{\"description\":\"longer is valid\",\"data\":[1,2],\"valid\":true},{\"description\":\"too short is invalid\",\"data\":[],\"valid\":false}]") == ""

test "minLength 0: minLength validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minLength\":2}", externals: "{}", tests: "[{\"description\":\"longer is valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"exact length is valid\",\"data\":\"fo\",\"valid\":true},{\"description\":\"too short is invalid\",\"data\":\"f\",\"valid\":false},{\"description\":\"ignores non-strings\",\"data\":1,\"valid\":true},{\"description\":\"one grapheme is not long enough\",\"data\":\"💩\",\"valid\":false}]") == ""

test "minLength 1: minLength validation with a decimal"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minLength\":2.0}", externals: "{}", tests: "[{\"description\":\"longer is valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"too short is invalid\",\"data\":\"f\",\"valid\":false}]") == ""

test "minProperties 0: minProperties validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minProperties\":1}", externals: "{}", tests: "[{\"description\":\"longer is valid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"exact length is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"too short is invalid\",\"data\":{},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true},{\"description\":\"ignores null\",\"data\":null,\"valid\":true},{\"description\":\"ignores booleans\",\"data\":true,\"valid\":true}]") == ""

test "minProperties 1: minProperties validation with a decimal"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minProperties\":1.0}", externals: "{}", tests: "[{\"description\":\"longer is valid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"too short is invalid\",\"data\":{},\"valid\":false}]") == ""

test "minimum 0: minimum validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minimum\":1.1}", externals: "{}", tests: "[{\"description\":\"above the minimum is valid\",\"data\":2.6,\"valid\":true},{\"description\":\"boundary point is valid\",\"data\":1.1,\"valid\":true},{\"description\":\"below the minimum is invalid\",\"data\":0.6,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"x\",\"valid\":true}]") == ""

test "minimum 3: minimum validation with signed integer"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"minimum\":-2}", externals: "{}", tests: "[{\"description\":\"negative above the minimum is valid\",\"data\":-1,\"valid\":true},{\"description\":\"positive above the minimum is valid\",\"data\":0,\"valid\":true},{\"description\":\"boundary point is valid\",\"data\":-2,\"valid\":true},{\"description\":\"boundary point with float is valid\",\"data\":-2.0,\"valid\":true},{\"description\":\"float below the minimum is invalid\",\"data\":-2.0001,\"valid\":false},{\"description\":\"int below the minimum is invalid\",\"data\":-3,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"x\",\"valid\":true}]") == ""

test "minimum 4: exclusiveMinimum validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"exclusiveMinimum\":1.1}", externals: "{}", tests: "[{\"description\":\"above the exclusiveMinimum is valid\",\"data\":1.2,\"valid\":true},{\"description\":\"boundary point is invalid\",\"data\":1.1,\"valid\":false},{\"description\":\"below the exclusiveMinimum is invalid\",\"data\":0.6,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"x\",\"valid\":true}]") == ""

test "multipleOf 0: multipleOf int"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"multipleOf\":2}", externals: "{}", tests: "[{\"description\":\"int by int\",\"data\":10,\"valid\":true},{\"description\":\"int by int fail\",\"data\":7,\"valid\":false},{\"description\":\"ignores non-numbers\",\"data\":\"foo\",\"valid\":true}]") == ""

test "multipleOf 2: multipleOf number"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"multipleOf\":1.5}", externals: "{}", tests: "[{\"description\":\"zero is multiple of anything\",\"data\":0,\"valid\":true},{\"description\":\"4.5 is multiple of 1.5\",\"data\":4.5,\"valid\":true},{\"description\":\"-4.5 is multiple of 1.5\",\"data\":-4.5,\"valid\":true},{\"description\":\"35 is not multiple of 1.5\",\"data\":35,\"valid\":false}]") == ""

test "multipleOf 4: multipleOf small number"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"multipleOf\":0.0001}", externals: "{}", tests: "[{\"description\":\"0.0075 is multiple of 0.0001\",\"data\":0.0075,\"valid\":true},{\"description\":\"0.00751 is not multiple of 0.0001\",\"data\":0.00751,\"valid\":false}]") == ""

test "multipleOf 6: multipleOf very small number"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"multipleOf\":1e-08}", externals: "{}", tests: "[{\"description\":\"4e-8 is multiple of 1e-8\",\"data\":4e-08,\"valid\":true},{\"description\":\"1.5e-8 is not multiple of 1e-8\",\"data\":1.5e-08,\"valid\":false}]") == ""

test "multipleOf 8: multipleOf when float division = inf"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"integer\",\"multipleOf\":0.123456789}", externals: "{}", tests: "[{\"description\":\"invalid, but naive implementations may raise an overflow error\",\"data\":1e+308,\"valid\":false}]") == ""

test "multipleOf 10: small multiple of large integer"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"integer\",\"multipleOf\":1e-08}", externals: "{}", tests: "[{\"description\":\"any integer is a multiple of 1e-8\",\"data\":12391239123,\"valid\":true}]") == ""

test "not 0: not"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":{\"type\":\"integer\"}}", externals: "{}", tests: "[{\"description\":\"allowed\",\"data\":\"foo\",\"valid\":true},{\"description\":\"disallowed\",\"data\":1,\"valid\":false}]") == ""

test "not 1: not multiple types"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":{\"type\":[\"integer\",\"boolean\"]}}", externals: "{}", tests: "[{\"description\":\"valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"mismatch\",\"data\":1,\"valid\":false},{\"description\":\"other mismatch\",\"data\":true,\"valid\":false}]") == ""

test "not 2: not more complex schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":{\"type\":\"object\",\"properties\":{\"foo\":{\"type\":\"string\"}}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"other match\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"mismatch\",\"data\":{\"foo\":\"bar\"},\"valid\":false}]") == ""

test "not 3: forbidden property"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{\"not\":{}}}}", externals: "{}", tests: "[{\"description\":\"property present\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":false},{\"description\":\"property absent\",\"data\":{\"bar\":1,\"baz\":2},\"valid\":true}]") == ""

test "not 4: forbid everything with empty schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":{}}", externals: "{}", tests: "[{\"description\":\"number is invalid\",\"data\":1,\"valid\":false},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false},{\"description\":\"boolean true is invalid\",\"data\":true,\"valid\":false},{\"description\":\"boolean false is invalid\",\"data\":false,\"valid\":false},{\"description\":\"null is invalid\",\"data\":null,\"valid\":false},{\"description\":\"object is invalid\",\"data\":{\"foo\":\"bar\"},\"valid\":false},{\"description\":\"empty object is invalid\",\"data\":{},\"valid\":false},{\"description\":\"array is invalid\",\"data\":[\"foo\"],\"valid\":false},{\"description\":\"empty array is invalid\",\"data\":[],\"valid\":false}]") == ""

test "not 5: forbid everything with boolean schema true"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":true}", externals: "{}", tests: "[{\"description\":\"number is invalid\",\"data\":1,\"valid\":false},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false},{\"description\":\"boolean true is invalid\",\"data\":true,\"valid\":false},{\"description\":\"boolean false is invalid\",\"data\":false,\"valid\":false},{\"description\":\"null is invalid\",\"data\":null,\"valid\":false},{\"description\":\"object is invalid\",\"data\":{\"foo\":\"bar\"},\"valid\":false},{\"description\":\"empty object is invalid\",\"data\":{},\"valid\":false},{\"description\":\"array is invalid\",\"data\":[\"foo\"],\"valid\":false},{\"description\":\"empty array is invalid\",\"data\":[],\"valid\":false}]") == ""

test "not 6: allow everything with boolean schema false"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":false}", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"boolean true is valid\",\"data\":true,\"valid\":true},{\"description\":\"boolean false is valid\",\"data\":false,\"valid\":true},{\"description\":\"null is valid\",\"data\":null,\"valid\":true},{\"description\":\"object is valid\",\"data\":{\"foo\":\"bar\"},\"valid\":true},{\"description\":\"empty object is valid\",\"data\":{},\"valid\":true},{\"description\":\"array is valid\",\"data\":[\"foo\"],\"valid\":true},{\"description\":\"empty array is valid\",\"data\":[],\"valid\":true}]") == ""

test "not 7: double negation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"not\":{\"not\":{}}}", externals: "{}", tests: "[{\"description\":\"any value is valid\",\"data\":\"foo\",\"valid\":true}]") == ""

test "not 8: collect annotations inside a 'not', even if collection is disabled"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"not\":{\"$comment\":\"this subschema must still produce annotations internally, even though the 'not' will ultimately discard them\",\"anyOf\":[true,{\"properties\":{\"foo\":true}}],\"unevaluatedProperties\":false}}", externals: "{}", tests: "[{\"description\":\"unevaluated property\",\"data\":{\"bar\":1},\"valid\":true},{\"description\":\"annotations are still collected inside a 'not'\",\"data\":{\"foo\":1},\"valid\":false}]") == ""

test "oneOf 0: oneOf"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[{\"type\":\"integer\"},{\"minimum\":2}]}", externals: "{}", tests: "[{\"description\":\"first oneOf valid\",\"data\":1,\"valid\":true},{\"description\":\"second oneOf valid\",\"data\":2.5,\"valid\":true},{\"description\":\"both oneOf valid\",\"data\":3,\"valid\":false},{\"description\":\"neither oneOf valid\",\"data\":1.5,\"valid\":false}]") == ""

test "oneOf 1: oneOf with base schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"oneOf\":[{\"minLength\":2},{\"maxLength\":4}]}", externals: "{}", tests: "[{\"description\":\"mismatch base schema\",\"data\":3,\"valid\":false},{\"description\":\"one oneOf valid\",\"data\":\"foobar\",\"valid\":true},{\"description\":\"both oneOf valid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "oneOf 2: oneOf with boolean schemas, all true"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[true,true,true]}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "oneOf 3: oneOf with boolean schemas, one true"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[true,false,false]}", externals: "{}", tests: "[{\"description\":\"any value is valid\",\"data\":\"foo\",\"valid\":true}]") == ""

test "oneOf 4: oneOf with boolean schemas, more than one true"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[true,true,false]}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "oneOf 5: oneOf with boolean schemas, all false"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[false,false,false]}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "oneOf 6: oneOf complex types"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[{\"properties\":{\"bar\":{\"type\":\"integer\"}},\"required\":[\"bar\"]},{\"properties\":{\"foo\":{\"type\":\"string\"}},\"required\":[\"foo\"]}]}", externals: "{}", tests: "[{\"description\":\"first oneOf valid (complex)\",\"data\":{\"bar\":2},\"valid\":true},{\"description\":\"second oneOf valid (complex)\",\"data\":{\"foo\":\"baz\"},\"valid\":true},{\"description\":\"both oneOf valid (complex)\",\"data\":{\"foo\":\"baz\",\"bar\":2},\"valid\":false},{\"description\":\"neither oneOf valid (complex)\",\"data\":{\"foo\":2,\"bar\":\"quux\"},\"valid\":false}]") == ""

test "oneOf 7: oneOf with empty schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[{\"type\":\"number\"},{}]}", externals: "{}", tests: "[{\"description\":\"one valid - valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"both valid - invalid\",\"data\":123,\"valid\":false}]") == ""

test "oneOf 8: oneOf with required"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"object\",\"oneOf\":[{\"required\":[\"foo\",\"bar\"]},{\"required\":[\"foo\",\"baz\"]}]}", externals: "{}", tests: "[{\"description\":\"both invalid - invalid\",\"data\":{\"bar\":2},\"valid\":false},{\"description\":\"first valid - valid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":true},{\"description\":\"second valid - valid\",\"data\":{\"foo\":1,\"baz\":3},\"valid\":true},{\"description\":\"both valid - invalid\",\"data\":{\"foo\":1,\"bar\":2,\"baz\":3},\"valid\":false}]") == ""

test "oneOf 9: oneOf with missing optional property"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[{\"properties\":{\"bar\":{},\"baz\":{}},\"required\":[\"bar\"]},{\"properties\":{\"foo\":{}},\"required\":[\"foo\"]}]}", externals: "{}", tests: "[{\"description\":\"first oneOf valid\",\"data\":{\"bar\":8},\"valid\":true},{\"description\":\"second oneOf valid\",\"data\":{\"foo\":\"foo\"},\"valid\":true},{\"description\":\"both oneOf valid\",\"data\":{\"foo\":\"foo\",\"bar\":8},\"valid\":false},{\"description\":\"neither oneOf valid\",\"data\":{\"baz\":\"quux\"},\"valid\":false}]") == ""

test "oneOf 10: nested oneOf, to check validation semantics"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"oneOf\":[{\"oneOf\":[{\"type\":\"null\"}]}]}", externals: "{}", tests: "[{\"description\":\"null is valid\",\"data\":null,\"valid\":true},{\"description\":\"anything non-null is invalid\",\"data\":123,\"valid\":false}]") == ""

test "pattern 0: pattern validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"pattern\":\"^a*$\"}", externals: "{}", tests: "[{\"description\":\"a matching pattern is valid\",\"data\":\"aaa\",\"valid\":true},{\"description\":\"a non-matching pattern is invalid\",\"data\":\"abc\",\"valid\":false},{\"description\":\"ignores booleans\",\"data\":true,\"valid\":true},{\"description\":\"ignores integers\",\"data\":123,\"valid\":true},{\"description\":\"ignores floats\",\"data\":1.0,\"valid\":true},{\"description\":\"ignores objects\",\"data\":{},\"valid\":true},{\"description\":\"ignores arrays\",\"data\":[],\"valid\":true},{\"description\":\"ignores null\",\"data\":null,\"valid\":true}]") == ""

test "pattern 1: pattern is not anchored"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"pattern\":\"a+\"}", externals: "{}", tests: "[{\"description\":\"matches a substring\",\"data\":\"xxaayy\",\"valid\":true}]") == ""

test "pattern 2: pattern with Unicode property escape requires unicode mode"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\p{Letter}+$\"}", externals: "{}", tests: "[{\"description\":\"ASCII letters match\",\"data\":\"Hello\",\"valid\":true},{\"description\":\"Non-ASCII letters match\",\"data\":\"π\",\"valid\":true},{\"description\":\"Digits do not match\",\"data\":\"123\",\"valid\":false}]") == ""

test "pattern 3: pattern with Unicode property escape"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"pattern\":\"^\\\\p{Letter}+$\"}", externals: "{}", tests: "[{\"description\":\"a valid case with a Unicode letter\",\"data\":\"π\",\"valid\":true},{\"description\":\"another valid case with multiple Unicode letters\",\"data\":\"πλ\",\"valid\":true},{\"description\":\"an invalid case where the string contains digits\",\"data\":\"123\",\"valid\":false}]") == ""

test "patternProperties 0: patternProperties validates properties matching a regex"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"patternProperties\":{\"f.*o\":{\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"a single valid match is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"multiple valid matches is valid\",\"data\":{\"foo\":1,\"foooooo\":2},\"valid\":true},{\"description\":\"a single invalid match is invalid\",\"data\":{\"foo\":\"bar\",\"fooooo\":2},\"valid\":false},{\"description\":\"multiple invalid matches is invalid\",\"data\":{\"foo\":\"bar\",\"foooooo\":\"baz\"},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[\"foo\"],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"foo\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true}]") == ""

test "patternProperties 1: multiple simultaneous patternProperties are validated"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"patternProperties\":{\"a*\":{\"type\":\"integer\"},\"aaa*\":{\"maximum\":20}}}", externals: "{}", tests: "[{\"description\":\"a single valid match is valid\",\"data\":{\"a\":21},\"valid\":true},{\"description\":\"a simultaneous match is valid\",\"data\":{\"aaaa\":18},\"valid\":true},{\"description\":\"multiple matches is valid\",\"data\":{\"a\":21,\"aaaa\":18},\"valid\":true},{\"description\":\"an invalid due to one is invalid\",\"data\":{\"a\":\"bar\"},\"valid\":false},{\"description\":\"an invalid due to the other is invalid\",\"data\":{\"aaaa\":31},\"valid\":false},{\"description\":\"an invalid due to both is invalid\",\"data\":{\"aaa\":\"foo\",\"aaaa\":31},\"valid\":false}]") == ""

test "patternProperties 2: regexes are not anchored by default and are case sensitive"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"patternProperties\":{\"[0-9]{2,}\":{\"type\":\"boolean\"},\"X_\":{\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"non recognized members are ignored\",\"data\":{\"answer 1\":\"42\"},\"valid\":true},{\"description\":\"recognized members are accounted for\",\"data\":{\"a31b\":null},\"valid\":false},{\"description\":\"regexes are case sensitive\",\"data\":{\"a_x_3\":3},\"valid\":true},{\"description\":\"regexes are case sensitive, 2\",\"data\":{\"a_X_3\":3},\"valid\":false}]") == ""

test "patternProperties 3: patternProperties with boolean schemas"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"patternProperties\":{\"f.*\":true,\"b.*\":false}}", externals: "{}", tests: "[{\"description\":\"object with property matching schema true is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"object with property matching schema false is invalid\",\"data\":{\"bar\":2},\"valid\":false},{\"description\":\"object with both properties is invalid\",\"data\":{\"foo\":1,\"bar\":2},\"valid\":false},{\"description\":\"object with a property matching both true and false is invalid\",\"data\":{\"foobar\":1},\"valid\":false},{\"description\":\"empty object is valid\",\"data\":{},\"valid\":true}]") == ""

