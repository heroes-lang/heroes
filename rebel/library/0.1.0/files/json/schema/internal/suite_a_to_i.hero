# The JSON Schema Test Suite (github.com/json-schema-org/JSON-Schema-Test-Suite,
# commit e2a68a15 of 2026-11-16, its `validation/tests` as fetched on
# 2026-11-17): every case its `compatibility` gives to draft 7 or to 2020-12
# among `additionalProperties.json`, `allOf.json`, `anchor-legacy.json` and the rest of its group,
# each run under each dialect it is given to. A case tagged
# `format-assertion` is run with formats asserted. Each is a test; nothing
# else here is compiled into a program.

use json/schema/internal/suite

# How many of the suite's cases this module holds.
constant CASES: i64
    229

test "additionalProperties 0: additionalProperties being false does not allow other properties"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{},\"bar\":{}},\"patternProperties\":{\"^v\":{}},\"additionalProperties\":false}", externals: "{}", tests: "[{\"description\":\"no additional properties is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"an additional property is invalid\",\"data\":{\"foo\":1,\"bar\":2,\"quux\":\"boom\"},\"valid\":false},{\"description\":\"ignores arrays\",\"data\":[1,2,3],\"valid\":true},{\"description\":\"ignores strings\",\"data\":\"foobarbaz\",\"valid\":true},{\"description\":\"ignores other non-objects\",\"data\":12,\"valid\":true},{\"description\":\"patternProperties are not additional properties\",\"data\":{\"foo\":1,\"vroom\":2},\"valid\":true}]") == ""

test "additionalProperties 1: non-ASCII pattern with additionalProperties"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"patternProperties\":{\"^á\":{}},\"additionalProperties\":false}", externals: "{}", tests: "[{\"description\":\"matching the pattern is valid\",\"data\":{\"ármányos\":2},\"valid\":true},{\"description\":\"not matching the pattern is invalid\",\"data\":{\"élmény\":2},\"valid\":false}]") == ""

test "additionalProperties 2: additionalProperties with schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{},\"bar\":{}},\"additionalProperties\":{\"type\":\"boolean\"}}", externals: "{}", tests: "[{\"description\":\"no additional properties is valid\",\"data\":{\"foo\":1},\"valid\":true},{\"description\":\"an additional valid property is valid\",\"data\":{\"foo\":1,\"bar\":2,\"quux\":true},\"valid\":true},{\"description\":\"an additional invalid property is invalid\",\"data\":{\"foo\":1,\"bar\":2,\"quux\":12},\"valid\":false}]") == ""

test "additionalProperties 3: additionalProperties can exist by itself"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"additionalProperties\":{\"type\":\"boolean\"}}", externals: "{}", tests: "[{\"description\":\"an additional valid property is valid\",\"data\":{\"foo\":true},\"valid\":true},{\"description\":\"an additional invalid property is invalid\",\"data\":{\"foo\":1},\"valid\":false}]") == ""

test "additionalProperties 4: additionalProperties are allowed by default"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"foo\":{},\"bar\":{}}}", externals: "{}", tests: "[{\"description\":\"additional properties are allowed\",\"data\":{\"foo\":1,\"bar\":2,\"quux\":true},\"valid\":true}]") == ""

test "additionalProperties 6: additionalProperties does not look in applicators"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"properties\":{\"foo\":{}}}],\"additionalProperties\":{\"type\":\"boolean\"}}", externals: "{}", tests: "[{\"description\":\"properties defined in allOf are not examined\",\"data\":{\"foo\":1,\"bar\":true},\"valid\":false}]") == ""

test "additionalProperties 7: additionalProperties with null valued instance properties"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"additionalProperties\":{\"type\":\"null\"}}", externals: "{}", tests: "[{\"description\":\"allows null values\",\"data\":{\"foo\":null},\"valid\":true}]") == ""

test "additionalProperties 8: additionalProperties with propertyNames"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"propertyNames\":{\"maxLength\":5},\"additionalProperties\":{\"type\":\"number\"}}", externals: "{}", tests: "[{\"description\":\"Valid against both keywords\",\"data\":{\"apple\":4},\"valid\":true},{\"description\":\"Valid against propertyNames, but not additionalProperties\",\"data\":{\"fig\":2,\"pear\":\"available\"},\"valid\":false}]") == ""

test "additionalProperties 9: dependentSchemas with additionalProperties"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"properties\":{\"foo2\":{}},\"dependentSchemas\":{\"foo\":{},\"foo2\":{\"properties\":{\"bar\":{}}}},\"additionalProperties\":false}", externals: "{}", tests: "[{\"description\":\"additionalProperties doesn't consider dependentSchemas\",\"data\":{\"foo\":\"\"},\"valid\":false},{\"description\":\"additionalProperties can't see bar\",\"data\":{\"bar\":\"\"},\"valid\":false},{\"description\":\"additionalProperties can't see bar even when foo2 is present\",\"data\":{\"foo2\":\"\",\"bar\":\"\"},\"valid\":false}]") == ""

test "allOf 0: allOf"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"properties\":{\"bar\":{\"type\":\"integer\"}},\"required\":[\"bar\"]},{\"properties\":{\"foo\":{\"type\":\"string\"}},\"required\":[\"foo\"]}]}", externals: "{}", tests: "[{\"description\":\"allOf\",\"data\":{\"foo\":\"baz\",\"bar\":2},\"valid\":true},{\"description\":\"mismatch second\",\"data\":{\"foo\":\"baz\"},\"valid\":false},{\"description\":\"mismatch first\",\"data\":{\"bar\":2},\"valid\":false},{\"description\":\"wrong type\",\"data\":{\"foo\":\"baz\",\"bar\":\"quux\"},\"valid\":false}]") == ""

test "allOf 1: allOf with base schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"properties\":{\"bar\":{\"type\":\"integer\"}},\"required\":[\"bar\"],\"allOf\":[{\"properties\":{\"foo\":{\"type\":\"string\"}},\"required\":[\"foo\"]},{\"properties\":{\"baz\":{\"type\":\"null\"}},\"required\":[\"baz\"]}]}", externals: "{}", tests: "[{\"description\":\"valid\",\"data\":{\"foo\":\"quux\",\"bar\":2,\"baz\":null},\"valid\":true},{\"description\":\"mismatch base schema\",\"data\":{\"foo\":\"quux\",\"baz\":null},\"valid\":false},{\"description\":\"mismatch first allOf\",\"data\":{\"bar\":2,\"baz\":null},\"valid\":false},{\"description\":\"mismatch second allOf\",\"data\":{\"foo\":\"quux\",\"bar\":2},\"valid\":false},{\"description\":\"mismatch both\",\"data\":{\"bar\":2},\"valid\":false}]") == ""

test "allOf 2: allOf simple types"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"maximum\":30},{\"minimum\":20}]}", externals: "{}", tests: "[{\"description\":\"valid\",\"data\":25,\"valid\":true},{\"description\":\"mismatch one\",\"data\":35,\"valid\":false}]") == ""

test "allOf 3: allOf with boolean schemas, all true"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[true,true]}", externals: "{}", tests: "[{\"description\":\"any value is valid\",\"data\":\"foo\",\"valid\":true}]") == ""

test "allOf 4: allOf with boolean schemas, some false"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[true,false]}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "allOf 5: allOf with boolean schemas, all false"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[false,false]}", externals: "{}", tests: "[{\"description\":\"any value is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "allOf 6: allOf with one empty schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{}]}", externals: "{}", tests: "[{\"description\":\"any data is valid\",\"data\":1,\"valid\":true}]") == ""

test "allOf 7: allOf with two empty schemas"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{},{}]}", externals: "{}", tests: "[{\"description\":\"any data is valid\",\"data\":1,\"valid\":true}]") == ""

test "allOf 8: allOf with the first empty schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{},{\"type\":\"number\"}]}", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "allOf 9: allOf with the last empty schema"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"type\":\"number\"},{}]}", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "allOf 10: nested allOf, to check validation semantics"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"allOf\":[{\"type\":\"null\"}]}]}", externals: "{}", tests: "[{\"description\":\"null is valid\",\"data\":null,\"valid\":true},{\"description\":\"anything non-null is invalid\",\"data\":123,\"valid\":false}]") == ""

test "allOf 11: allOf combined with anyOf, oneOf"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"multipleOf\":2}],\"anyOf\":[{\"multipleOf\":3}],\"oneOf\":[{\"multipleOf\":5}]}", externals: "{}", tests: "[{\"description\":\"allOf: false, anyOf: false, oneOf: false\",\"data\":1,\"valid\":false},{\"description\":\"allOf: false, anyOf: false, oneOf: true\",\"data\":5,\"valid\":false},{\"description\":\"allOf: false, anyOf: true, oneOf: false\",\"data\":3,\"valid\":false},{\"description\":\"allOf: false, anyOf: true, oneOf: true\",\"data\":15,\"valid\":false},{\"description\":\"allOf: true, anyOf: false, oneOf: false\",\"data\":2,\"valid\":false},{\"description\":\"allOf: true, anyOf: false, oneOf: true\",\"data\":10,\"valid\":false},{\"description\":\"allOf: true, anyOf: true, oneOf: false\",\"data\":6,\"valid\":false},{\"description\":\"allOf: true, anyOf: true, oneOf: true\",\"data\":30,\"valid\":true}]") == ""

test "anchor-legacy 0: Location-independent identifier"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"allOf\":[{\"$ref\":\"#foo\"}],\"definitions\":{\"A\":{\"$id\":\"#foo\",\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor-legacy 2: Location-independent identifier with base URI change in subschema"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/root\",\"allOf\":[{\"$ref\":\"http://localhost:1234/nested.json#foo\"}],\"definitions\":{\"A\":{\"$id\":\"nested.json\",\"definitions\":{\"B\":{\"$id\":\"#foo\",\"type\":\"integer\"}}}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor-legacy 4: Reference an anchor with a non-relative URI"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$id\":\"https://example.com/schema-with-anchor\",\"allOf\":[{\"$ref\":\"https://example.com/schema-with-anchor#foo\"}],\"definitions\":{\"A\":{\"$id\":\"#foo\",\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor-legacy 6: URN base URI with URN and anchor ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$id\":\"urn:uuid:deadbeef-1234-ff00-00ff-4321feebdaed\",\"properties\":{\"foo\":{\"$ref\":\"urn:uuid:deadbeef-1234-ff00-00ff-4321feebdaed#something\"}},\"definitions\":{\"bar\":{\"$id\":\"#something\",\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"a string is valid\",\"data\":{\"foo\":\"bar\"},\"valid\":true},{\"description\":\"a non-string is invalid\",\"data\":{\"foo\":12},\"valid\":false}]") == ""

test "anchor-legacy 8: anchor within remote ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/locationIndependentIdentifier.json#foo\"}", externals: "{\"http://localhost:1234/locationIndependentIdentifier.json\":{\"definitions\":{\"refToInteger\":{\"$ref\":\"#foo\"},\"A\":{\"$id\":\"#foo\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"remote anchor valid\",\"data\":1,\"valid\":true},{\"description\":\"remote anchor invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor-legacy 10: Location-independent identifier in remote ref"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/locationIndependentIdentifier.json#/definitions/refToInteger\"}", externals: "{\"http://localhost:1234/locationIndependentIdentifier.json\":{\"definitions\":{\"refToInteger\":{\"$ref\":\"#foo\"},\"A\":{\"$id\":\"#foo\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"integer is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "anchor-legacy 12: $ref to $ref finds detached $anchor"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/detached-ref.json#/definitions/foo\"}", externals: "{\"http://localhost:1234/detached-ref.json\":{\"definitions\":{\"foo\":{\"$ref\":\"#detached\"},\"detached\":{\"$id\":\"#detached\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"non-number is invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 0: Location-independent identifier"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"#foo\",\"$defs\":{\"A\":{\"$anchor\":\"foo\",\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 1: Location-independent identifier with absolute URI"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/bar#foo\",\"$defs\":{\"A\":{\"$id\":\"http://localhost:1234/bar\",\"$anchor\":\"foo\",\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 2: Location-independent identifier with base URI change in subschema"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/root\",\"$ref\":\"http://localhost:1234/nested.json#foo\",\"$defs\":{\"A\":{\"$id\":\"nested.json\",\"$defs\":{\"B\":{\"$anchor\":\"foo\",\"type\":\"integer\"}}}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 3: same $anchor with different base uri"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/foobar\",\"$defs\":{\"A\":{\"$id\":\"child1\",\"allOf\":[{\"$id\":\"child2\",\"$anchor\":\"my_anchor\",\"type\":\"number\"},{\"$anchor\":\"my_anchor\",\"type\":\"string\"}]}},\"$ref\":\"child1#my_anchor\"}", externals: "{}", tests: "[{\"description\":\"$ref resolves to /$defs/A/allOf/1\",\"data\":\"a\",\"valid\":true},{\"description\":\"$ref does not resolve to /$defs/A/allOf/0\",\"data\":1,\"valid\":false}]") == ""

test "anchor 4: Reference an anchor with a non-relative URI"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"https://example.com/schema-with-anchor\",\"allOf\":[{\"$ref\":\"https://example.com/schema-with-anchor#foo\"}],\"$defs\":{\"A\":{\"$anchor\":\"foo\",\"type\":\"integer\"}}}", externals: "{}", tests: "[{\"description\":\"match\",\"data\":1,\"valid\":true},{\"description\":\"mismatch\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 5: URN base URI with URN and anchor ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"urn:uuid:deadbeef-1234-ff00-00ff-4321feebdaed\",\"properties\":{\"foo\":{\"$ref\":\"urn:uuid:deadbeef-1234-ff00-00ff-4321feebdaed#something\"}},\"$defs\":{\"bar\":{\"$anchor\":\"something\",\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"a string is valid\",\"data\":{\"foo\":\"bar\"},\"valid\":true},{\"description\":\"a non-string is invalid\",\"data\":{\"foo\":12},\"valid\":false}]") == ""

test "anchor 6: anchor within remote ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/locationIndependentIdentifier.json#foo\"}", externals: "{\"http://localhost:1234/locationIndependentIdentifier.json\":{\"$defs\":{\"refToInteger\":{\"$ref\":\"#foo\"},\"A\":{\"$anchor\":\"foo\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"remote anchor valid\",\"data\":1,\"valid\":true},{\"description\":\"remote anchor invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "anchor 7: Location-independent identifier in remote ref"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/locationIndependentIdentifier.json#/$defs/refToInteger\"}", externals: "{\"http://localhost:1234/locationIndependentIdentifier.json\":{\"$defs\":{\"refToInteger\":{\"$ref\":\"#foo\"},\"A\":{\"$anchor\":\"foo\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"integer is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

test "anchor 8: $ref to $ref finds detached $anchor"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$ref\":\"http://localhost:1234/detached-ref.json#/$defs/foo\"}", externals: "{\"http://localhost:1234/detached-ref.json\":{\"$defs\":{\"foo\":{\"$ref\":\"#detached\"},\"detached\":{\"$anchor\":\"detached\",\"type\":\"integer\"}}}}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"non-number is invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "anyOf 0: anyOf"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"anyOf\":[{\"type\":\"integer\"},{\"minimum\":2}]}", externals: "{}", tests: "[{\"description\":\"first anyOf valid\",\"data\":1,\"valid\":true},{\"description\":\"second anyOf valid\",\"data\":2.5,\"valid\":true},{\"description\":\"both anyOf valid\",\"data\":3,\"valid\":true},{\"description\":\"neither anyOf valid\",\"data\":1.5,\"valid\":false}]") == ""

