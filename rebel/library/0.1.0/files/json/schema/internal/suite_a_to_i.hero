test "items 16: prefixItems with no additional items permitted"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"prefixItems\":[{},{},{}],\"items\":false}", externals: "{}", tests: "[{\"description\":\"empty array\",\"data\":[],\"valid\":true},{\"description\":\"fewer number of items present (1)\",\"data\":[1],\"valid\":true},{\"description\":\"fewer number of items present (2)\",\"data\":[1,2],\"valid\":true},{\"description\":\"equal number of items present\",\"data\":[1,2,3],\"valid\":true},{\"description\":\"additional items are not permitted\",\"data\":[1,2,3,4],\"valid\":false}]") == ""

test "items 17: array of items with no additional items permitted"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"items\":[{},{},{}],\"additionalItems\":false}", externals: "{}", tests: "[{\"description\":\"empty array\",\"data\":[],\"valid\":true},{\"description\":\"fewer number of items present (1)\",\"data\":[1],\"valid\":true},{\"description\":\"fewer number of items present (2)\",\"data\":[1,2],\"valid\":true},{\"description\":\"equal number of items present\",\"data\":[1,2,3],\"valid\":true},{\"description\":\"additional items are not permitted\",\"data\":[1,2,3,4],\"valid\":false}]") == ""

test "items 18: additionalItems as false without items"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"additionalItems\":false}", externals: "{}", tests: "[{\"description\":\"items defaults to empty schema so everything is valid\",\"data\":[1,2,3,4,5],\"valid\":true},{\"description\":\"ignores non-arrays\",\"data\":{\"foo\":\"bar\"},\"valid\":true}]") == ""

test "items 19: additional items are allowed by default"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"prefixItems\":[{\"type\":\"integer\"}]}", externals: "{}", tests: "[{\"description\":\"only the first item is validated\",\"data\":[1,\"foo\",false],\"valid\":true}]") == ""

test "items 20: additional items are allowed by default (2019)"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"items\":[{\"type\":\"integer\"}]}", externals: "{}", tests: "[{\"description\":\"only the first item is validated\",\"data\":[1,\"foo\",false],\"valid\":true}]") == ""

test "items 21: items does not look in applicators, valid case"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"allOf\":[{\"prefixItems\":[{\"minimum\":3}]}],\"items\":{\"minimum\":5}}", externals: "{}", tests: "[{\"description\":\"prefixItems in allOf does not constrain items, invalid case\",\"data\":[3,5],\"valid\":false},{\"description\":\"prefixItems in allOf does not constrain items, valid case\",\"data\":[5,5],\"valid\":true}]") == ""

test "items 22: additionalItems does not look in applicators, invalid case"
    assert suite.failures(dialects: [7], asserting: false, content: false, schema: "{\"allOf\":[{\"items\":[{\"type\":\"integer\"},{\"type\":\"string\"}]}],\"items\":[{\"type\":\"integer\"}],\"additionalItems\":{\"type\":\"boolean\"}}", externals: "{}", tests: "[{\"description\":\"items defined in allOf are not examined\",\"data\":[1,\"hello\"],\"valid\":false}]") == ""

