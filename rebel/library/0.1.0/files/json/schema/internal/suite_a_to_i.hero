    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"type\":\"string\",\"anyOf\":[{\"maxLength\":2},{\"minLength\":4}]}", externals: "{}", tests: "[{\"description\":\"mismatch base schema\",\"data\":3,\"valid\":false},{\"description\":\"one anyOf valid\",\"data\":\"foobar\",\"valid\":true},{\"description\":\"both anyOf invalid\",\"data\":\"foo\",\"valid\":false}]") == ""

