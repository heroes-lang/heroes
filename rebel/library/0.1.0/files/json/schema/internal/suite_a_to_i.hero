test "dynamicRef 7: An $anchor with the same name as a $dynamicAnchor is not used for dynamic scope resolution (2020)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"https://test.json-schema.org/dynamic-resolution-ignores-anchors/root\",\"$ref\":\"list\",\"$defs\":{\"foo\":{\"$anchor\":\"items\",\"type\":\"string\"},\"list\":{\"$id\":\"list\",\"type\":\"array\",\"items\":{\"$dynamicRef\":\"#items\"},\"$defs\":{\"items\":{\"$comment\":\"This is only needed to satisfy the bookending requirement\",\"$dynamicAnchor\":\"items\"}}}}}", externals: "{}", tests: "[{\"description\":\"Any array is valid\",\"data\":[\"foo\",42],\"valid\":true}]") == ""

test "dynamicRef 9: after leaving a dynamic scope, it is not used by a $dynamicRef (2020)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"https://test.json-schema.org/dynamic-ref-leaving-dynamic-scope/main\",\"if\":{\"$id\":\"first_scope\",\"$defs\":{\"thingy\":{\"$comment\":\"this is first_scope#thingy\",\"$dynamicAnchor\":\"thingy\",\"type\":\"number\"}}},\"then\":{\"$id\":\"second_scope\",\"$ref\":\"start\",\"$defs\":{\"thingy\":{\"$comment\":\"this is second_scope#thingy, the final destination of the $dynamicRef\",\"$dynamicAnchor\":\"thingy\",\"type\":\"null\"}}},\"$defs\":{\"start\":{\"$comment\":\"this is the landing spot from $ref\",\"$id\":\"start\",\"$dynamicRef\":\"inner_scope#thingy\"},\"thingy\":{\"$comment\":\"this is the first stop for the $dynamicRef\",\"$id\":\"inner_scope\",\"$dynamicAnchor\":\"thingy\",\"type\":\"string\"}}}", externals: "{}", tests: "[{\"description\":\"string matches /$defs/thingy, but the $dynamicRef does not stop here\",\"data\":\"a string\",\"valid\":false},{\"description\":\"first_scope is not in dynamic scope for the $dynamicRef\",\"data\":42,\"valid\":false},{\"description\":\"/then/$defs/thingy is the final stop for the $dynamicRef\",\"data\":null,\"valid\":true}]") == ""

test "dynamicRef 11: strict-tree schema, guards against misspelled properties (2020)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/strict-tree.json\",\"$dynamicAnchor\":\"node\",\"$ref\":\"tree.json\",\"unevaluatedProperties\":false}", externals: "{\"http://localhost:1234/tree.json\":{\"description\":\"tree schema, extensible\",\"$dynamicAnchor\":\"node\",\"type\":\"object\",\"properties\":{\"data\":true,\"children\":{\"type\":\"array\",\"items\":{\"$dynamicRef\":\"#node\"}}}}}", tests: "[{\"description\":\"instance with misspelled field\",\"data\":{\"children\":[{\"daat\":1}]},\"valid\":false},{\"description\":\"instance with correct field\",\"data\":{\"children\":[{\"data\":1}]},\"valid\":true}]") == ""

test "dynamicRef 13: tests for implementation dynamic anchor and reference link (2020)"
    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/strict-extendible.json\",\"$ref\":\"extendible-dynamic-ref.json\",\"$defs\":{\"elements\":{\"$dynamicAnchor\":\"elements\",\"properties\":{\"a\":true},\"required\":[\"a\"],\"additionalProperties\":false}}}", externals: "{\"http://localhost:1234/extendible-dynamic-ref.json\":{\"description\":\"extendible array\",\"type\":\"object\",\"properties\":{\"elements\":{\"type\":\"array\",\"items\":{\"$dynamicRef\":\"#elements\"}}},\"required\":[\"elements\"],\"additionalProperties\":false,\"$defs\":{\"elements\":{\"$dynamicAnchor\":\"elements\"}}}}", tests: "[{\"description\":\"incorrect parent schema\",\"data\":{\"a\":true},\"valid\":false},{\"description\":\"incorrect extended schema\",\"data\":{\"elements\":[{\"b\":1}]},\"valid\":false},{\"description\":\"correct extended schema\",\"data\":{\"elements\":[{\"a\":1}]},\"valid\":true}]") == ""

