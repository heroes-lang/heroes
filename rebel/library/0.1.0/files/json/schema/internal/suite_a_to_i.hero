test "boolean_schema 0: boolean schema 'true'"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "true", externals: "{}", tests: "[{\"description\":\"number is valid\",\"data\":1,\"valid\":true},{\"description\":\"string is valid\",\"data\":\"foo\",\"valid\":true},{\"description\":\"boolean true is valid\",\"data\":true,\"valid\":true},{\"description\":\"boolean false is valid\",\"data\":false,\"valid\":true},{\"description\":\"null is valid\",\"data\":null,\"valid\":true},{\"description\":\"object is valid\",\"data\":{\"foo\":\"bar\"},\"valid\":true},{\"description\":\"empty object is valid\",\"data\":{},\"valid\":true},{\"description\":\"array is valid\",\"data\":[\"foo\"],\"valid\":true},{\"description\":\"empty array is valid\",\"data\":[],\"valid\":true}]") == ""

test "boolean_schema 1: boolean schema 'false'"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "false", externals: "{}", tests: "[{\"description\":\"number is invalid\",\"data\":1,\"valid\":false},{\"description\":\"string is invalid\",\"data\":\"foo\",\"valid\":false},{\"description\":\"boolean true is invalid\",\"data\":true,\"valid\":false},{\"description\":\"boolean false is invalid\",\"data\":false,\"valid\":false},{\"description\":\"null is invalid\",\"data\":null,\"valid\":false},{\"description\":\"object is invalid\",\"data\":{\"foo\":\"bar\"},\"valid\":false},{\"description\":\"empty object is invalid\",\"data\":{},\"valid\":false},{\"description\":\"array is invalid\",\"data\":[\"foo\"],\"valid\":false},{\"description\":\"empty array is invalid\",\"data\":[],\"valid\":false}]") == ""

test "const 0: const validation"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":2}", externals: "{}", tests: "[{\"description\":\"same value is valid\",\"data\":2,\"valid\":true},{\"description\":\"another value is invalid\",\"data\":5,\"valid\":false},{\"description\":\"another type is invalid\",\"data\":\"a\",\"valid\":false}]") == ""

test "const 1: const with object"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":{\"foo\":\"bar\",\"baz\":\"bax\"}}", externals: "{}", tests: "[{\"description\":\"same object is valid\",\"data\":{\"foo\":\"bar\",\"baz\":\"bax\"},\"valid\":true},{\"description\":\"same object with different property order is valid\",\"data\":{\"baz\":\"bax\",\"foo\":\"bar\"},\"valid\":true},{\"description\":\"another object is invalid\",\"data\":{\"foo\":\"bar\"},\"valid\":false},{\"description\":\"another type is invalid\",\"data\":[1,2],\"valid\":false}]") == ""

test "const 2: const with array"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":[{\"foo\":\"bar\"}]}", externals: "{}", tests: "[{\"description\":\"same array is valid\",\"data\":[{\"foo\":\"bar\"}],\"valid\":true},{\"description\":\"another array item is invalid\",\"data\":[2],\"valid\":false},{\"description\":\"array with additional items is invalid\",\"data\":[1,2,3],\"valid\":false}]") == ""

test "const 3: const with null"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":null}", externals: "{}", tests: "[{\"description\":\"null is valid\",\"data\":null,\"valid\":true},{\"description\":\"not null is invalid\",\"data\":0,\"valid\":false}]") == ""

test "const 4: const with false does not match 0"
    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"const\":false}", externals: "{}", tests: "[{\"description\":\"false is valid\",\"data\":false,\"valid\":true},{\"description\":\"integer zero is invalid\",\"data\":0,\"valid\":false},{\"description\":\"float zero is invalid\",\"data\":0.0,\"valid\":false}]") == ""

test "const 5: const with true does not match 1"
