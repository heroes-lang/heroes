    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"allOf\":[{\"if\":{\"exclusiveMaximum\":0}},{\"then\":{\"minimum\":-10}},{\"else\":{\"multipleOf\":2}}]}", externals: "{}", tests: "[{\"description\":\"valid, but would have been invalid through then\",\"data\":-100,\"valid\":true},{\"description\":\"valid, but would have been invalid through else\",\"data\":3,\"valid\":true}]") == ""

