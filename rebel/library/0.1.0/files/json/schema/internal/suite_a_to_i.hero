    assert suite.failures(dialects: [7, 2020], asserting: false, content: false, schema: "{\"enum\":[6,\"foo\",[],true,{\"foo\":12}]}", externals: "{}", tests: "[{\"description\":\"one of the enum is valid\",\"data\":[],\"valid\":true},{\"description\":\"something else is invalid\",\"data\":null,\"valid\":false},{\"description\":\"objects are deep compared\",\"data\":{\"foo\":false},\"valid\":false},{\"description\":\"valid object matches\",\"data\":{\"foo\":12},\"valid\":true},{\"description\":\"extra properties in object is invalid\",\"data\":{\"foo\":12,\"boo\":42},\"valid\":false}]") == ""

