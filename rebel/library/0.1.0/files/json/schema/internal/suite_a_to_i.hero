    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"$id\":\"http://localhost:1234/strict-extendible-allof-ref-first.json\",\"allOf\":[{\"$defs\":{\"elements\":{\"$dynamicAnchor\":\"elements\",\"properties\":{\"a\":true},\"required\":[\"a\"],\"additionalProperties\":false}}},{\"$ref\":\"extendible-dynamic-ref.json\"}]}", externals: "{\"http://localhost:1234/extendible-dynamic-ref.json\":{\"description\":\"extendible array\",\"type\":\"object\",\"properties\":{\"elements\":{\"type\":\"array\",\"items\":{\"$dynamicRef\":\"#elements\"}}},\"required\":[\"elements\"],\"additionalProperties\":false,\"$defs\":{\"elements\":{\"$dynamicAnchor\":\"elements\"}}}}", tests: "[{\"description\":\"incorrect parent schema\",\"data\":{\"a\":true},\"valid\":false},{\"description\":\"incorrect extended schema\",\"data\":{\"elements\":[{\"b\":1}]},\"valid\":false},{\"description\":\"correct extended schema\",\"data\":{\"elements\":[{\"a\":1}]},\"valid\":true}]") == ""

