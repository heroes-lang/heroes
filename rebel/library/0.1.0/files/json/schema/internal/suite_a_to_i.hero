    assert suite.failures(dialects: [2020], asserting: false, content: false, schema: "{\"prefixItems\":[{\"type\":\"string\"}],\"items\":{\"type\":\"integer\"}}", externals: "{}", tests: "[{\"description\":\"valid items\",\"data\":[\"x\",2,3],\"valid\":true},{\"description\":\"wrong type of second item\",\"data\":[\"x\",\"y\"],\"valid\":false}]") == ""

