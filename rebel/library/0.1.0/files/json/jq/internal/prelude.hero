# The builtins of jq that are written in jq itself, read before every filter
# as definitions it may call or redefine. Each is written here from what jq's
# manual says it does; the builtins that need Heroes are `natives`' and the
# machine's, and these call them by their names.

# The definitions, one a line.
function lines() -> [str]
    return [
        "def select(f): if f then . else empty end;"
        "def _assign(paths; $value): [path(paths)] as $ps | if _disjoint($ps) then _apply_updates($ps; [$ps[] | [$value]]) else reduce $ps[] as $p (.; setpath($p; $value)) end;"
        "def _modify(paths; update): [path(paths)] as $ps | if _disjoint($ps) then . as $x | _apply_updates($ps; [$ps[] as $p | first(($x | getpath($p) | update | [.]), null)]) else reduce $ps[] as $p ([., []]; . as [$x, $gone] | first(($x | getpath($p) | update | [.]), null) as $u | if $u == null then [$x, $gone + [$p]] else [($x | setpath($p; $u[0])), $gone] end) | . as [$x, $gone] | $x | delpaths($gone) end;"
        "def values: select(. != null);"
        "def nulls: select(. == null);"
        "def booleans: select(type == \"boolean\");"
        "def numbers: select(type == \"number\");"
        "def strings: select(type == \"string\");"
        "def arrays: select(type == \"array\");"
        "def objects: select(type == \"object\");"
        "def iterables: select(type == \"array\" or type == \"object\");"
        "def scalars: select(type != \"array\" and type != \"object\");"
        "def normals: select(type == \"number\" and isnormal);"
        "def finites: select(type == \"number\" and (isinfinite or isnan | not));"
        "def recurse(f): def r: ., (f | r); r;"
        "def recurse(f; cond): def r: ., (f | select(cond) | r); r;"
        "def recurse: recurse(.[]?);"
        "def map(f): [.[] | f];"
        "def toarray: if type == \"array\" then . else [.] end;"
        "def add: reduce .[] as $x (null; . + $x);"
        "def add(f): reduce f as $x (null; . + $x);"
        "def any(g; c): isempty(first(g | select(c))) | not;"
        "def all(g; c): isempty(first(g | select(c | not)));"
        "def any(c): any(.[]; c);"
        "def all(c): all(.[]; c);"
        "def any: any(.);"
        "def all: all(.);"
        "def range($upto): _range(0; $upto; 1);"
        "def range($from; $upto): _range($from; $upto; 1);"
        "def range($from; $upto; $by): _range($from; $upto; $by);"
        "def limit($n; f): _limit($n; f);"
        "def first: .[0];"
        "def last: .[-1];"
        "def nth($n): .[$n];"
        "def last(f): reduce f as $x (null; $x);"
        "def nth($n; f): if $n < 0 then error(\"nth doesn't support negative indices\") else first(foreach f as $x (-1; . + 1; select(. == $n) | $x)) end;"
        "def until(cond; update): def u: if cond then . else (update | u) end; u;"
        "def while(cond; update): def w: if cond then ., (update | w) else empty end; w;"
        "def repeat(f): def r: f, r; r;"
        "def in(xs): . as $x | xs | has($x);"
        "def inside(xs): . as $x | xs | contains($x);"
        "def combinations: if length == 0 then [] else .[0][] as $x | (.[1:] | combinations) as $w | [$x] + $w end;"
        "def combinations(n): . as $dot | [range(n)] | map($dot) | combinations;"
        "def map_values(f): .[] |= f;"
        "def walk(f): def w: if type == \"object\" then map_values(w) elif type == \"array\" then map(w) else . end | f; w;"
        "def env: $ENV;"
        "def todate: strftime(\"%Y-%m-%dT%H:%M:%SZ\");"
        "def todateiso8601: strftime(\"%Y-%m-%dT%H:%M:%SZ\");"
        "def fromdateiso8601: strptime(\"%Y-%m-%dT%H:%M:%SZ\") | mktime;"
        "def fromdate: fromdateiso8601;"
        "def date: todate;"
        "def dateadd(u; n): . + n;"
        "def datesub(u; n): . - n;"
        "def paths: path(..) | select(length > 0);"
        "def paths(node_filter): . as $dot | paths | select(. as $p | $dot | getpath($p) | node_filter);"
        "def leaf_paths: paths(scalars);"
        "def del(f): delpaths([path(f)]);"
        "def with_entries(f): to_entries | map(f) | from_entries;"
        "def pick(pathexps): . as $top | reduce path(pathexps) as $p (null; setpath($p; $top | getpath($p)));"
        "def debug(msg): (msg | debug | empty), .;"
        "def halt_error: halt_error(5);"
        "def sort_by(f): _sort_by(map([f]));"
        "def group_by(f): _group_by(map([f]));"
        "def unique_by(f): _unique_by(map([f]));"
        "def min_by(f): _min_by(map([f]));"
        "def max_by(f): _max_by(map([f]));"
        "def index($i): indices($i) | .[0];"
        "def rindex($i): indices($i) | .[-1:][0];"
        "def flatten: _flatten(-1);"
        "def flatten($depth): if $depth < 0 then error(\"flatten depth must not be negative\") else _flatten($depth) end;"
        "def abs: if type == \"number\" and . < 0 then - . else . end;"
        "def have_literal_numbers: false;"
        "def have_decnum: false;"
        "def IN(s): any(s == .; .);"
        "def IN(src; s): any(src == s; .);"
        f"def INDEX(stream; idx_expr): reduce stream as $row ({{}}; .[$row | idx_expr | tostring] |= $row);"
        "def INDEX(idx_expr): INDEX(.[]; idx_expr);"
        "def JOIN($idx; idx_expr): [.[] | [., $idx[idx_expr]]];"
        "def JOIN($idx; stream; idx_expr): stream | [., $idx[idx_expr]];"
        "def JOIN($idx; stream; idx_expr; join_expr): stream | [., $idx[idx_expr]] | join_expr;"
        "def _regex_args(re; flags): if (re | type) == \"string\" then [re, flags] elif (re | type) == \"array\" and (re | length) > 1 then [re[0], re[1]] elif (re | type) == \"array\" and (re | length) > 0 then [re[0], null] else error((re | type) + \" not a string or array\") end;"
        "def match(re; flags): _regex_args(re; flags) as $a | _match($a[0]; $a[1]; false) | .[];"
        "def match(re): match(re; null);"
        "def test(re; flags): _regex_args(re; flags) as $a | _match($a[0]; $a[1]; true);"
        "def test(re): test(re; null);"
        "def capture(re; flags): match(re; flags) | _capture_object;"
        "def capture(re): capture(re; null);"
        "def scan($re; $flags): match($re; \"g\" + ($flags // \"\")) | if (.captures | length) > 0 then [.captures[].string] else .string end;"
        "def scan($re): scan($re; null);"
        "def split($re; flags): _split_regex($re; flags);"
        "def splits($re; flags): split($re; flags) | .[];"
        "def splits($re): splits($re; null);"
        "def sub($re; str; $flags): . as $in | [match($re; $flags)] as $found | if ($found | length) == 0 then $in else [$found[] | [_capture_object | str]] as $outs | ($outs | map(length) | max) as $n | range(0; $n) as $k | reduce range(0; $found | length) as $i ([0, \"\"]; $found[$i] as $m | if ($outs[$i] | length) > $k then [$m.offset + $m.length, .[1] + $in[.[0]:$m.offset] + $outs[$i][$k]] else [$m.offset + $m.length, .[1]] end) | .[1] + $in[.[0]:] end;"
        "def sub($re; str): sub($re; str; \"\");"
        "def gsub($re; str; $flags): sub($re; str; $flags + \"g\");"
        "def gsub($re; str): sub($re; str; \"g\");"
        f"def fromstream(f): {{x: null, e: false}} as $init | foreach f as $i ($init; if .e then $init else . end | if ($i | length) == 2 then setpath([\"e\"]; $i[0] | length == 0) | setpath([\"x\"] + $i[0]; $i[1]) else setpath([\"e\"]; $i[0] | length == 1) end; if .e then .x else empty end);"
        "def truncate_stream(stream): . as $n | null | stream | . as $input | if (.[0] | length) > $n then setpath([0]; .[0][$n:]) else empty end;"
        "def ascii: [.] | implode;"
    ]

# The definitions as one text.
function text() -> str
    return lines().join("\n")

## Tests

test "text: one definition a line, each opening with `def`"
    for line in lines()
        assert line.slice(from: 0, to: 4) == "def "

    assert lines().len() == 99
