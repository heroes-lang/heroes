test "cts 467: functions, count, count function"
    assert answer(selector: "$[?count(@..*)>2]", document: "[{\"a\":[1,2,3]},{\"a\":[1],\"d\":\"f\"},{\"a\":1,\"d\":\"f\"}]") == canonical("[[{\"a\":[1,2,3]},{\"a\":[1],\"d\":\"f\"}],[\"$[0]\",\"$[1]\"]]")

test "cts 468: functions, count, single-node arg"
    assert answer(selector: "$[?count(@.a)>1]", document: "[{\"a\":[1,2,3]},{\"a\":[1],\"d\":\"f\"},{\"a\":1,\"d\":\"f\"}]") == canonical("[[],[]]")

