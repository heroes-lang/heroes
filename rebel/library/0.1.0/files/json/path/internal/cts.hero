test "cts 296: name selector, double quotes, escaped double quote"
    assert answer(selector: "$[\"\\\"\"]", document: "{\"\\\"\":\"A\"}") == canonical("[[\"A\"],[\"$['\\\"']\"]]")

test "cts 297: name selector, double quotes, escaped reverse solidus"
    assert answer(selector: "$[\"\\\\\"]", document: "{\"\\\\\":\"A\"}") == canonical("[[\"A\"],[\"$['\\\\\\\\']\"]]")

test "cts 298: name selector, double quotes, escaped solidus"
    assert answer(selector: "$[\"\\/\"]", document: "{\"/\":\"A\"}") == canonical("[[\"A\"],[\"$['/']\"]]")

