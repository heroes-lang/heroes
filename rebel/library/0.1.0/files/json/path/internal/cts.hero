test "cts 494: functions, match, found match"
    assert answer(selector: "$[?match(@.a, 'a.*')]", document: "[{\"a\":\"ab\"}]") == canonical("[[{\"a\":\"ab\"}],[\"$[0]\"]]")

test "cts 495: functions, match, double quotes"
    assert answer(selector: "$[?match(@.a, \"a.*\")]", document: "[{\"a\":\"ab\"}]") == canonical("[[{\"a\":\"ab\"}],[\"$[0]\"]]")

test "cts 496: functions, match, regex from the document"
    assert answer(selector: "$.values[?match(@, $.regex)]", document: "{\"regex\":\"b.?b\",\"values\":[\"abc\",\"bcd\",\"bab\",\"bba\",\"bbab\",\"b\",true,[],{}]}") == canonical("[[\"bab\"],[\"$['values'][2]\"]]")

test "cts 497: functions, match, don't select match"
    assert answer(selector: "$[?!match(@.a, 'a.*')]", document: "[{\"a\":\"ab\"}]") == canonical("[[],[]]")

test "cts 498: functions, match, not a match"
    assert answer(selector: "$[?match(@.a, 'a.*')]", document: "[{\"a\":\"bc\"}]") == canonical("[[],[]]")

test "cts 499: functions, match, select non-match"
    assert answer(selector: "$[?!match(@.a, 'a.*')]", document: "[{\"a\":\"bc\"}]") == canonical("[[{\"a\":\"bc\"}],[\"$[0]\"]]")

test "cts 500: functions, match, non-string first arg"
    assert answer(selector: "$[?match(1, 'a.*')]", document: "[{\"a\":\"bc\"}]") == canonical("[[],[]]")

test "cts 501: functions, match, non-string second arg"
    assert answer(selector: "$[?match(@.a, 1)]", document: "[{\"a\":\"bc\"}]") == canonical("[[],[]]")

