    assert answer(selector: "$[?@.a<=\n@.b]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 645: whitespace, operators, tab after <="
    assert answer(selector: "$[?@.a<=\t@.b]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 646: whitespace, operators, return after <="
    assert answer(selector: "$[?@.a<=\r@.b]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 647: whitespace, operators, space before >="
    assert answer(selector: "$[?@.b >=@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 648: whitespace, operators, newline before >="
    assert answer(selector: "$[?@.b\n>=@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 649: whitespace, operators, tab before >="
    assert answer(selector: "$[?@.b\t>=@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 650: whitespace, operators, return before >="
    assert answer(selector: "$[?@.b\r>=@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 651: whitespace, operators, space after >="
    assert answer(selector: "$[?@.b>= @.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 652: whitespace, operators, newline after >="
    assert answer(selector: "$[?@.b>=\n@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 653: whitespace, operators, tab after >="
    assert answer(selector: "$[?@.b>=\t@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 654: whitespace, operators, return after >="
    assert answer(selector: "$[?@.b>=\r@.a]", document: "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]") == canonical("[[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}],[\"$[0]\",\"$[1]\"]]")

test "cts 655: whitespace, operators, space between logical not and test expression"
    assert answer(selector: "$[?! @.a]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"d\":\"f\"}],[\"$[1]\"]]")

test "cts 656: whitespace, operators, newline between logical not and test expression"
    assert answer(selector: "$[?!\n@.a]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"d\":\"f\"}],[\"$[1]\"]]")

test "cts 657: whitespace, operators, tab between logical not and test expression"
    assert answer(selector: "$[?!\t@.a]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"d\":\"f\"}],[\"$[1]\"]]")

test "cts 658: whitespace, operators, return between logical not and test expression"
    assert answer(selector: "$[?!\r@.a]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"d\":\"f\"}],[\"$[1]\"]]")

test "cts 659: whitespace, operators, space between logical not and parenthesized expression"
    assert answer(selector: "$[?! (@.a=='b')]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}],[\"$[0]\",\"$[2]\"]]")

test "cts 660: whitespace, operators, newline between logical not and parenthesized expression"
    assert answer(selector: "$[?!\n(@.a=='b')]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}],[\"$[0]\",\"$[2]\"]]")

test "cts 661: whitespace, operators, tab between logical not and parenthesized expression"
    assert answer(selector: "$[?!\t(@.a=='b')]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}],[\"$[0]\",\"$[2]\"]]")

test "cts 662: whitespace, operators, return between logical not and parenthesized expression"
    assert answer(selector: "$[?!\r(@.a=='b')]", document: "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}],[\"$[0]\",\"$[2]\"]]")

test "cts 663: whitespace, selectors, space between root and bracket"
    assert answer(selector: "$ ['a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 664: whitespace, selectors, newline between root and bracket"
    assert answer(selector: "$\n['a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 665: whitespace, selectors, tab between root and bracket"
    assert answer(selector: "$\t['a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 666: whitespace, selectors, return between root and bracket"
    assert answer(selector: "$\r['a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 667: whitespace, selectors, space between bracket and bracket"
    assert answer(selector: "$['a'] ['b']", document: "{\"a\":{\"b\":\"ab\"}}") == canonical("[[\"ab\"],[\"$['a']['b']\"]]")

test "cts 668: whitespace, selectors, newline between bracket and bracket"
    assert answer(selector: "$['a'] \n['b']", document: "{\"a\":{\"b\":\"ab\"}}") == canonical("[[\"ab\"],[\"$['a']['b']\"]]")

test "cts 669: whitespace, selectors, tab between bracket and bracket"
    assert answer(selector: "$['a'] \t['b']", document: "{\"a\":{\"b\":\"ab\"}}") == canonical("[[\"ab\"],[\"$['a']['b']\"]]")

test "cts 670: whitespace, selectors, return between bracket and bracket"
    assert answer(selector: "$['a'] \r['b']", document: "{\"a\":{\"b\":\"ab\"}}") == canonical("[[\"ab\"],[\"$['a']['b']\"]]")

test "cts 671: whitespace, selectors, space between root and dot"
    assert answer(selector: "$ .a", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 672: whitespace, selectors, newline between root and dot"
    assert answer(selector: "$\n.a", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 673: whitespace, selectors, tab between root and dot"
    assert answer(selector: "$\t.a", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 674: whitespace, selectors, return between root and dot"
    assert answer(selector: "$\r.a", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 675: whitespace, selectors, space between dot and name"
    assert answer(selector: "$. a", document: "null") == "invalid"

test "cts 676: whitespace, selectors, newline between dot and name"
    assert answer(selector: "$.\na", document: "null") == "invalid"

test "cts 677: whitespace, selectors, tab between dot and name"
    assert answer(selector: "$.\ta", document: "null") == "invalid"

test "cts 678: whitespace, selectors, return between dot and name"
    assert answer(selector: "$.\ra", document: "null") == "invalid"

test "cts 679: whitespace, selectors, space between recursive descent and name"
    assert answer(selector: "$.. a", document: "null") == "invalid"

test "cts 680: whitespace, selectors, newline between recursive descent and name"
    assert answer(selector: "$..\na", document: "null") == "invalid"

test "cts 681: whitespace, selectors, tab between recursive descent and name"
    assert answer(selector: "$..\ta", document: "null") == "invalid"

test "cts 682: whitespace, selectors, return between recursive descent and name"
    assert answer(selector: "$..\ra", document: "null") == "invalid"

test "cts 683: whitespace, selectors, space between bracket and selector"
    assert answer(selector: "$[ 'a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 684: whitespace, selectors, newline between bracket and selector"
    assert answer(selector: "$[\n'a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 685: whitespace, selectors, tab between bracket and selector"
    assert answer(selector: "$[\t'a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 686: whitespace, selectors, return between bracket and selector"
    assert answer(selector: "$[\r'a']", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 687: whitespace, selectors, space between selector and bracket"
    assert answer(selector: "$['a' ]", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 688: whitespace, selectors, newline between selector and bracket"
    assert answer(selector: "$['a'\n]", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 689: whitespace, selectors, tab between selector and bracket"
    assert answer(selector: "$['a'\t]", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 690: whitespace, selectors, return between selector and bracket"
    assert answer(selector: "$['a'\r]", document: "{\"a\":\"ab\"}") == canonical("[[\"ab\"],[\"$['a']\"]]")

test "cts 691: whitespace, selectors, space between selector and comma"
    assert answer(selector: "$['a' ,'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 692: whitespace, selectors, newline between selector and comma"
    assert answer(selector: "$['a'\n,'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 693: whitespace, selectors, tab between selector and comma"
    assert answer(selector: "$['a'\t,'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 694: whitespace, selectors, return between selector and comma"
    assert answer(selector: "$['a'\r,'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 695: whitespace, selectors, space between comma and selector"
    assert answer(selector: "$['a', 'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 696: whitespace, selectors, newline between comma and selector"
    assert answer(selector: "$['a',\n'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 697: whitespace, selectors, tab between comma and selector"
    assert answer(selector: "$['a',\t'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 698: whitespace, selectors, return between comma and selector"
    assert answer(selector: "$['a',\r'b']", document: "{\"a\":\"ab\",\"b\":\"bc\"}") == canonical("[[\"ab\",\"bc\"],[\"$['a']\",\"$['b']\"]]")

test "cts 699: whitespace, slice, space between start and colon"
    assert answer(selector: "$[1 :5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 700: whitespace, slice, newline between start and colon"
    assert answer(selector: "$[1\n:5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 701: whitespace, slice, tab between start and colon"
    assert answer(selector: "$[1\t:5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 702: whitespace, slice, return between start and colon"
    assert answer(selector: "$[1\r:5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 703: whitespace, slice, space between colon and end"
    assert answer(selector: "$[1: 5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 704: whitespace, slice, newline between colon and end"
    assert answer(selector: "$[1:\n5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 705: whitespace, slice, tab between colon and end"
    assert answer(selector: "$[1:\t5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 706: whitespace, slice, return between colon and end"
    assert answer(selector: "$[1:\r5:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 707: whitespace, slice, space between end and colon"
    assert answer(selector: "$[1:5 :2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 708: whitespace, slice, newline between end and colon"
    assert answer(selector: "$[1:5\n:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 709: whitespace, slice, tab between end and colon"
    assert answer(selector: "$[1:5\t:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 710: whitespace, slice, return between end and colon"
    assert answer(selector: "$[1:5\r:2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 711: whitespace, slice, space between colon and step"
    assert answer(selector: "$[1:5: 2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 712: whitespace, slice, newline between colon and step"
    assert answer(selector: "$[1:5:\n2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 713: whitespace, slice, tab between colon and step"
    assert answer(selector: "$[1:5:\t2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")

test "cts 714: whitespace, slice, return between colon and step"
    assert answer(selector: "$[1:5:\r2]", document: "[1,2,3,4,5,6]") == canonical("[[2,4],[\"$[1]\",\"$[3]\"]]")
