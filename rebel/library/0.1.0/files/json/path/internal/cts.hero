test "cts 511: functions, match, dot in character class"
    assert answer(selector: "$[?match(@, 'a[.b]c')]", document: "[\"abc\",\"a.c\",\"axc\"]") == canonical("[[\"abc\",\"a.c\"],[\"$[0]\",\"$[1]\"]]")

