test "cts 490: functions, length, arg is a function expression"
    assert answer(selector: "$.values[?length(@.a)==length(value($..c))]", document: "{\"c\":\"cd\",\"values\":[{\"a\":\"ab\"},{\"a\":\"d\"}]}") == canonical("[[{\"a\":\"ab\"}],[\"$['values'][0]\"]]")

test "cts 491: functions, length, arg is special nothing"
    assert answer(selector: "$[?length(value(@.a))>0]", document: "[{\"a\":\"ab\"},{\"c\":\"d\"},{\"a\":null}]") == canonical("[[{\"a\":\"ab\"}],[\"$[0]\"]]")

