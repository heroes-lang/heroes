    assert answer(selector: "$[? @.a]", document: "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"b\",\"d\":\"e\"}],[\"$[0]\"]]")

test "cts 548: whitespace, filter, newline between question mark and expression"
    assert answer(selector: "$[?\n@.a]", document: "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"b\",\"d\":\"e\"}],[\"$[0]\"]]")

test "cts 549: whitespace, filter, tab between question mark and expression"
    assert answer(selector: "$[?\t@.a]", document: "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"b\",\"d\":\"e\"}],[\"$[0]\"]]")

test "cts 550: whitespace, filter, return between question mark and expression"
    assert answer(selector: "$[?\r@.a]", document: "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"b\",\"d\":\"e\"}],[\"$[0]\"]]")

test "cts 551: whitespace, filter, space between question mark and parenthesized expression"
    assert answer(selector: "$[? (@.a)]", document: "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]") == canonical("[[{\"a\":\"b\",\"d\":\"e\"}],[\"$[0]\"]]")

