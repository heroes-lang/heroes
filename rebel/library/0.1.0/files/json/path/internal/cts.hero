    assert answer(selector: "$[?search(@, 'a\\\\\\\\.c')]", document: "[\"x abc y\",\"x a.c y\",\"x axc y\",\"x a\\\\\\u2028c y\"]") == canonical("[[\"x a\\\\\\u2028c y\"],[\"$[3]\"]]")

