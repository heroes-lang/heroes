# A reverse proxy in the manner of nginx's `proxy_pass` and Go's
# `httputil.ReverseProxy`: each request a client sends passed to one of its
# upstreams, `http://` or `https://`, and the answer passed back, the bodies
# both ways in pieces as they come and never held whole. The upstream of each
# request is chosen as nginx's upstream module chooses it, by its smooth
# weighted round-robin or by the fewest requests in flight; an upstream that
# fails is kept out for a while, and a request that could not reach one is
# tried on the next. Each request goes out with the hop-by-hop fields
# removed, the client told in `Forwarded` and `X-Forwarded-*` with the scheme
# its connection's stream says it came by, this proxy named in `Via` and
# `Max-Forwards` counted down; a switch of protocols, a WebSocket, is relayed
# byte for byte both ways. Every wait is bounded by a
# span the program sets. `serve` serves a listener's connections on worker
# threads; `serve_stream` serves one connection on the calling thread, for a
# program's own loop.
#
# **What it does not do.** Routes, the steps before and after a handler and
# a server's own answers are `web`'s, and so is the client a request names
# through the proxies a program trusts, read by `web.forwarded_of` from the
# networks `web.trusted_networks` makes. The connection, and the reading and
# writing of a message, are `net`'s and `http`'s. It opens no tunnel
# (`CONNECT` is answered 501), passes no trailer on, and probes no upstream
# of its own accord: an upstream's marks come from the requests alone.
#
# The codes it fails with: `invalid` (an upstream or a proxy's settings that
# are not one), `limit` (a worker that could not be started), and those of
# `poll` and of `time.mark`.

use http
use io
use net
use os
use strings
use time
use tls
use url
use web/proxy/internal/balance
use web/proxy/internal/fixture
use web/proxy/internal/gateway
use web/proxy/internal/relay

## Codes

# The code of an upstream that is not one, and of a reverse proxy's settings
# out of their range: `upstream`, `new_state` and `serve` fail with it.
constant INVALID: str
    "invalid"

## Upstreams

# An upstream a reverse proxy passes requests to: made by `upstream`.
record Upstream
    # Its URL, `http://` or `https://` with a host, whose path and query
    # every target asked is joined to.
    url: url.Url
    # Its share of the turns, 1 or more.
    weight: i64

# How a reverse proxy chooses the upstream of each request, as nginx's
# upstream module documents its methods.
variant Choosing
    # Each in turn, as often as its weight says: nginx's smooth weighted
    # round-robin, its default.
    round_robin
    # The fewest requests in flight for its weight, ties taken in turn:
    # nginx's `least_conn`.
    least_connections

# The upstream at `target`, given `weight` of the turns.
#
# - `target`: an `http://` or `https://` URL with a host; its path and query
#   are joined to every target asked.
# - `weight`: its share of the turns, 1 or more.
#
# Fails `invalid` where `target` is no such URL, holds a user or a
# fragment, or `weight` is below 1. See also `reverse_proxy`.
function upstream(target: str, weight: i64) -> Upstream?
    u = url.parse(target)?

    if u.scheme != "http" && u.scheme != "https"
        return fail(code: INVALID, msg: f"an upstream {target}: its scheme is neither http nor https")

    if u.host == "" || u.user != "" || u.fragment != ""
        return fail(code: INVALID, msg: f"an upstream {target}: it names no host, or names a user or a fragment")

    if weight < 1
        return fail(code: INVALID, msg: f"an upstream {target}: a weight of {weight}, below 1")
    return ok(Upstream(url: u, weight: weight))

## A reverse proxy

# A reverse proxy: made by `reverse_proxy`, its fields changed by the
# program, served by `serve` or `serve_stream`.
record ReverseProxy
    # The upstreams, 1 or more.
    upstreams: [Upstream]
    # How each request's upstream is chosen.
    choosing: Choosing
    # What a request's head may hold (431 past it), its body past
    # `body_bytes` refused 413, and what an upstream's head may hold (502).
    limits: http.Limits
    # How long the making of an upstream's connection may take, its TLS
    # handshake included; past it the next upstream is tried, or 504.
    connect_timeout: time.Duration
    # How long an upstream may stay silent: before its answer's head (504
    # past it), between two pieces of its body, and in a switched connection
    # where the client is silent too.
    read_timeout: time.Duration
    # How long one write to an upstream may wait.
    send_timeout: time.Duration
    # How long a client may stay silent inside its request's body (408 past
    # it), or take one write of the answer.
    client_timeout: time.Duration
    # How long a client's connection may wait for its next request, the
    # whole of its head included; the connection is then closed.
    idle_timeout: time.Duration
    # The most upstreams one request is tried on, 1 or more.
    tries: i64
    # The failures within `fail_timeout` that keep an upstream out for
    # `fail_timeout`, as nginx's `max_fails`; 0 counts none.
    max_fails: i64
    # The span failures are counted in, and how long an upstream is kept out.
    fail_timeout: time.Duration
    # Whether the client's `Host` is sent on, as Go's
    # `NewSingleHostReverseProxy` sends it; else the upstream's own, as
    # nginx's `$proxy_host` and Go's `SetURL` send it.
    keep_host: bool
    # The proxies in front of this one, as `web.trusted_networks` makes them:
    # where the client's connection comes from one, its `Forwarded` and
    # `X-Forwarded-*` are added to; from any other they are replaced.
    trusted: [net.Network]
    # The pseudonym this proxy writes in `Via`, a token, the listener's port
    # after it; "" writes none and detects no loop.
    via: str
    # The PEM of the only authorities an `https://` upstream's certificate
    # may be signed by; "" trusts the system's store.
    roots: str
    # The client connections served at once by `serve`, each on a worker
    # thread of its own, 1 or more; the next waits in the listener's queue
    # until one ends.
    workers: i64

# A reverse proxy over `upstreams` with the usual settings: the round-robin,
# `http.default_limits()`, 60 seconds to connect, to wait for an upstream and
# to write to one (nginx's `proxy_connect_timeout`, `proxy_read_timeout` and
# `proxy_send_timeout`), 60 seconds for a client's silences and its idle
# connection, 3 tries, an upstream kept out for 10 seconds after 1 failure
# (nginx's `max_fails` and `fail_timeout`), the upstream's own `Host`, no
# proxy trusted, the machine's name in `Via`, the system's authorities, and
# 32 workers.
#
# - `upstreams`: the upstreams, as `upstream` makes them.
#
# See also `serve`, `upstream`.
function reverse_proxy(upstreams: [Upstream]) -> ReverseProxy
    minute = time.seconds(60)
    named = os.host_name().default("proxy")

    name = if gateway.is_token(named)
        named
    else
        "proxy"

    return ReverseProxy(
        upstreams: upstreams,
        choosing: .round_robin,
        limits: http.default_limits(),
        connect_timeout: minute,
        read_timeout: minute,
        send_timeout: minute,
        client_timeout: minute,
        idle_timeout: minute,
        tries: 3,
        max_fails: 1,
        fail_timeout: time.seconds(10),
        keep_host: false,
        trusted: [],
        via: name,
        roots: "",
        workers: 32
    )

## Serving

# What serving a reverse proxy came to.
record Served
    # The client connections served.
    connections: i64
    # The requests read.
    requests: i64
    # The answers an upstream gave, passed back whole.
    relayed: i64
    # The requests the proxy answered itself: refused (400, 408, 413, 431,
    # 501, 505, 508) or answered for an upstream (502, 503, 504).
    refused: i64
    # The connections switched to another protocol (a WebSocket) and
    # relayed both ways.
    switched: i64

# A reverse proxy served on the calling thread, its balancer's counts kept
# from one connection to the next: made by `new_state`, used by
# `serve_stream`.
record State
    # What the relay does. Only this package reads it.
    plan: relay.Plan
    # The balancer's counts. Only this package reads it.
    chooser: relay.Chooser

# The state `serve_stream` serves `proxy` with, nothing counted yet.
#
# - `proxy`: the reverse proxy; `workers` is not read.
#
# Fails `invalid` where it has no upstream, an upstream's weight is below 1,
# `tries` is below 1, `max_fails` below 0, a span below 0, or `via` is
# neither "" nor a token; and as `time.mark` fails. See also
# `serve_stream`.
function new_state(proxy: ReverseProxy) -> State?
    if proxy.upstreams.len() == 0
        return fail(code: INVALID, msg: "a reverse proxy with no upstream")

    if proxy.tries < 1 || proxy.max_fails < 0
        return fail(
            code: INVALID,
            msg: f"a reverse proxy of {proxy.tries} tries and {proxy.max_fails} failures, where tries are 1 or more and failures 0 or more"
        )

    if proxy.via != "" && !gateway.is_token(proxy.via)
        return fail(code: INVALID, msg: f"a reverse proxy's `Via` pseudonym {proxy.via} is no token")
    spans = [
        proxy.connect_timeout
        proxy.read_timeout
        proxy.send_timeout
        proxy.client_timeout
        proxy.idle_timeout
        proxy.fail_timeout
    ]

    for d in spans
        if d.nanoseconds < 0
            return fail(code: INVALID, msg: f"a reverse proxy's span of {time.format_duration(d)}, below zero")

    ups: [relay.Upstream] @= []
    weights: [i64] @= []

    for u in proxy.upstreams
        if u.weight < 1
            return fail(code: INVALID, msg: f"an upstream of weight {u.weight}, below 1")
        secure = u.url.scheme == "https"

        port = if u.url.port == ""
            if secure
                443
            else
                80
        else
            url.port_of(u.url)?
        ups @ ups.push(relay.Upstream(base: u.url, port: port, secure: secure))
        weights @ weights.push(u.weight)

    least = match proxy.choosing
        .round_robin       => false
        .least_connections => true

    counts = balance.state_of(
        weights,
        least: least,
        max_fails: proxy.max_fails,
        fail_ms: relay.ms_of(proxy.fail_timeout)
    )
    plan = relay.Plan(
        upstreams: ups,
        limits: proxy.limits,
        connect_ms: relay.ms_of(proxy.connect_timeout),
        read_ms: relay.ms_of(proxy.read_timeout),
        send_ms: relay.ms_of(proxy.send_timeout),
        client_ms: relay.ms_of(proxy.client_timeout),
        idle_ms: relay.ms_of(proxy.idle_timeout),
        tries: proxy.tries,
        keep_host: proxy.keep_host,
        trusted: proxy.trusted,
        received_by: proxy.via,
        roots: proxy.roots,
        counts: counts
    )
    start = time.mark()?
    return ok(State(plan: plan, chooser: .here(state: counts, start: start)))

# Serves every connection `l` accepts as a reverse proxy over
# `proxy.upstreams` until the program asks to stop: each request passed to
# an upstream the balancer chooses, and its answer passed back, the bodies
# both ways as they come and never held whole.
#
# - `l`: the listener; its owner closes it.
# - `proxy`: what the proxy does.
#
# Each request goes out with the hop-by-hop fields of RFC 9110 § 7.6.1
# removed, those its `Connection` lists among them, so a client can never
# make a field the proxy adds vanish; `Forwarded`, `X-Forwarded-For`,
# `-Host` and `-Proto` telling the client, those the client wrote kept only
# from a proxy `proxy.trusted` holds and replaced from any other, the
# scheme they tell (`Forwarded`'s `proto`, `X-Forwarded-Proto`) `http`, the
# scheme of every connection a `net.Listener` accepts; `Via` naming this proxy, a request that
# names it already refused 508; `Max-Forwards` counted down, a `TRACE` or
# `OPTIONS` at 0 answered here, and `OPTIONS *` too; `Host` as
# `proxy.keep_host` says; and `Connection: close`, one upstream connection a
# request. A request that asks
# to switch protocols (`Connection: upgrade` and `Upgrade`, a WebSocket) is
# passed with its `Upgrade`, and a 101 answering it is relayed byte for byte
# both ways until either end closes or both are silent past
# `proxy.read_timeout`; a 101 switching to another protocol is answered 502.
# The answer comes back with the hop-by-hop fields removed, its body with
# its length, as chunks to an HTTP/1.1 client or to the connection's end to
# an HTTP/1.0 one.
#
# Where an upstream cannot be reached, the next is tried, up to
# `proxy.tries`; where it was reached and its answer's head did not come,
# the next is tried only for an idempotent request with no body (RFC 9110 §
# 9.2.2), nothing having been passed back yet. An upstream's failure is
# answered 504 where the time ran out (`timeout`) and 502 for every other
# code; 503, with `Retry-After`, where every upstream is kept out by its
# failures. A failure once the answer's head is passed back closes the
# client's connection, its body cut short. What it refuses, and why:
# `CONNECT` (501, a reverse proxy opens no tunnel); an `Expect` other than
# `100-continue` (417), which is written by the proxy itself before the body;
# a request with both `Content-Length` and `Transfer-Encoding`, or a coding
# other than chunked (400, 501), which RFC 9112 § 6.3 names as smuggling; a
# head past `proxy.limits` (431) and a body past it (413); a trailer, read and
# checked and not passed on.
#
# Connections are served by `proxy.workers` threads at once; the next waits
# in the listener's queue. At the stop (`os.catch_stop`, `os.ask_stop`) no
# connection is accepted, and every wait of the workers answers `stopped`,
# so requests in flight are cut. Fails `invalid` as `new_state` does or
# where `proxy.workers` is below 1, `limit` where a worker could not be
# started, and as `poll` fails. See also `serve_stream`, `reverse_proxy`.
function serve(l: net.Listener, proxy: ReverseProxy) -> Served?
    if proxy.workers < 1
        return fail(code: INVALID, msg: f"a reverse proxy of {proxy.workers} workers, below 1")

    plan @= new_state(proxy)?.plan

    if proxy.via != ""
        plan.received_by @ f"{proxy.via}:{l.address.port}"
    got = relay.serve(l, plan: plan, workers: proxy.workers)?
    t = got.tally
    return ok(
        Served(connections: got.connections, requests: t.requests, relayed: t.relayed, refused: t.refused, switched: t.switched)
    )

# Serves the client on `stream` as `serve` serves each connection, on
# the calling thread, until its connection ends: for a program's own loop,
# or a connection it accepted itself.
#
# - `state`: the proxy and its balancer's counts, as `new_state` made
#   them; the counts move.
# - `stream`: the client's connection; its owner closes it. The stream
#   itself says the scheme the upstream is told in `Forwarded`'s `proto`
#   and in `X-Forwarded-Proto`, never the program: `https` for a stream of
#   `tls` (`tls.accept`, `tls.server_over`), whose deadlines `tls` then
#   moves and whose switched connection is read without `poll`, and `http`
#   for any other.
# - `remote`: the client's address and port, as `net.format_address` writes
#   them.
#
# What it served. See also `serve`, `tls.accept`.
function serve_stream(@state: State, stream: io.Stream, remote: str) -> Served
    t = relay.serve_client(@state.chooser, plan: state.plan, stream: stream, remote: remote)
    return Served(
        connections: 1,
        requests: t.requests,
        relayed: t.relayed,
        refused: t.refused,
        switched: t.switched
    )

## Examples

# An application server on this machine as an upstream, given two turns in
# three beside an upstream of weight 1.
test "upstream: an application server and its weight"
    up = upstream("http://127.0.0.1:8080/app", weight: 2).must()
    assert up.url.host == "127.0.0.1" && up.url.path == "/app" && up.weight == 2

# A reverse proxy over two upstreams, its settings changed where the program
# needs others: here the upstream with the fewest requests in flight chosen,
# and the client's `Host` sent on.
test "reverse_proxy: two upstreams, the least busy chosen"
    p @= reverse_proxy(
        [upstream("http://10.0.0.1:8080", weight: 1).must(), upstream("http://10.0.0.2:8080", weight: 1).must()]
    )
    p.choosing @ .least_connections
    p.keep_host @ true
    assert p.upstreams.len() == 2 && p.tries == 3 && p.workers == 32

# The state a program's own loop serves a reverse proxy with, its counts kept
# from one connection to the next; a proxy with no upstream is refused.
test "new_state: a proxy's state, and one with no upstream refused"
    state @= new_state(reverse_proxy([upstream("http://127.0.0.1:8080", weight: 1).must()])).must()
    two @= net.pair(deadline_ms: 5_000).must()
    io.close(@two.first.stream).must()
    assert serve_stream(@state, stream: two.second.stream, remote: "192.0.2.1:5000").requests == 0
    io.close(@two.second.stream).must()
    assert new_state(reverse_proxy([])).is_err()

# The proxy's loop, here over a listener closed already, which ends it.
test "serve: a closed listener ends it"
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    net.close_listener(@l).must()
    assert serve(l, proxy: reverse_proxy([upstream("http://127.0.0.1:8080", weight: 1).must()])).is_err()

# A program's own loop serving one client as a reverse proxy: its request
# passed to the upstream, and the answer passed back.
test "serve_stream: one request passed to its upstream"
    ports: (mailbox i64) = mailbox()
    up = spawn(fixture.upstream_once, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    state @= new_state(reverse_proxy([upstream(f"http://127.0.0.1:{port}", weight: 1).must()])).must()
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET /hello HTTP/1.1\r\nHost: shop.example\r\nConnection: close\r\n\r\n"
    ).must()
    served = serve_stream(@state, stream: two.second.stream, remote: "192.0.2.1:5000")
    reader @= io.reader(two.first.stream)
    answer = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    assert served.relayed == 1 && http.text_of(answer).must() == "upstream"
    assert up.wait() == 1
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_stream: a client over TLS told to the upstream as https, the fields it wrote itself replaced"
    if !tls.is_available()
        skip_test(reason: "this platform offers no TLS library to tls")
    ports: (mailbox i64) = mailbox()
    up = spawn(fixture.upstream_told, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: [])
    ).must()
    asked = "GET / HTTP/1.1\r\nHost: shop.example\r\nX-Forwarded-Proto: http\r\nX-Forwarded-For: 6.6.6.6\r\nForwarded: for=6.6.6.6;proto=http\r\nConnection: close\r\n\r\n"
    client = spawn(fixture.tls_client, fixture.Asking(port: l.port, asked: asked, until: "", hold_ms: 5_000)).must()
    conn @= tls.accept(l, deadline: time.seconds(5)).must()
    state @= new_state(reverse_proxy([upstream(f"http://127.0.0.1:{port}", weight: 1).must()])).must()
    served = serve_stream(@state, stream: conn.stream, remote: "192.0.2.1:5000")
    io.close(@conn.stream).must()
    tls.close_listener(@l).must()
    told = "X-Forwarded-Proto: https\nX-Forwarded-For: 192.0.2.1\nX-Forwarded-Host: shop.example\nForwarded: for=192.0.2.1;host=shop.example;proto=https"
    assert served.relayed == 1 && up.wait() == told
    assert strings.has_suffix(s: client.wait(), suffix: told)

test "serve_stream: a plain client told to the upstream as http, the https it wrote itself replaced"
    ports: (mailbox i64) = mailbox()
    up = spawn(fixture.upstream_told, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    state @= new_state(reverse_proxy([upstream(f"http://127.0.0.1:{port}", weight: 1).must()])).must()
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET / HTTP/1.1\r\nHost: shop.example\r\nX-Forwarded-Proto: https\r\nForwarded: for=6.6.6.6;proto=https\r\nConnection: close\r\n\r\n"
    ).must()
    served = serve_stream(@state, stream: two.second.stream, remote: "192.0.2.1:5000")
    io.close(@two.second.stream).must()
    reader @= io.reader(two.first.stream)
    answer = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    told = "X-Forwarded-Proto: http\nX-Forwarded-For: 192.0.2.1\nX-Forwarded-Host: shop.example\nForwarded: for=192.0.2.1;host=shop.example;proto=http"
    assert served.relayed == 1 && up.wait() == told && http.text_of(answer).must() == told
    io.close(@reader.stream).must()

test "serve_stream: a client over TLS silent past the idle span let go within it"
    if !tls.is_available()
        skip_test(reason: "this platform offers no TLS library to tls")
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: [])
    ).must()
    client = spawn(fixture.tls_client, fixture.Asking(port: l.port, asked: "", until: "", hold_ms: 10_000)).must()
    conn @= tls.accept(l, deadline: time.seconds(5)).must()
    p @= reverse_proxy([upstream("http://127.0.0.1:8080", weight: 1).must()])
    p.idle_timeout @ time.milliseconds(200)
    state @= new_state(p).must()
    start = time.mark().must()
    served = serve_stream(@state, stream: conn.stream, remote: "192.0.2.1:5000")
    waited = time.elapsed(start).must()
    io.close(@conn.stream).must()
    tls.close_listener(@l).must()
    assert served.requests == 0 && waited.nanoseconds < 5_000_000_000
    assert !strings.has_suffix(s: client.wait(), suffix: "<timeout>")

test "serve_stream: a WebSocket switched over a client over TLS, bytes relayed both ways"
    if !tls.is_available()
        skip_test(reason: "this platform offers no TLS library to tls")
    ports: (mailbox i64) = mailbox()
    up = spawn(fixture.upstream_echo, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: [])
    ).must()
    asked = "GET /ws HTTP/1.1\r\nHost: shop.example\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\nping"
    client = spawn(
        fixture.tls_client,
        fixture.Asking(port: l.port, asked: asked, until: "\r\n\r\nping", hold_ms: 5_000)
    ).must()
    conn @= tls.accept(l, deadline: time.seconds(5)).must()
    state @= new_state(reverse_proxy([upstream(f"http://127.0.0.1:{port}", weight: 1).must()])).must()
    served = serve_stream(@state, stream: conn.stream, remote: "192.0.2.1:5000")
    io.close(@conn.stream).must()
    tls.close_listener(@l).must()
    got = client.wait()
    assert served.switched == 1 && up.wait() == 4
    assert strings.has_prefix(s: got, prefix: "HTTP/1.1 101 Switching Protocols\r\n") && strings.has_suffix(s: got, suffix: "\r\n\r\nping")

test "serve_stream: a WebSocket switched with both ends over TLS, bytes relayed both ways"
    if !tls.is_available()
        skip_test(reason: "this platform offers no TLS library to tls")
    ports: (mailbox i64) = mailbox()
    up = spawn(fixture.upstream_echo_tls, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    l @= tls.listen(
        host: "127.0.0.1",
        port: 0,
        server: tls.Server(chain: tls.TEST_LOCALHOST_CHAIN, key: tls.TEST_LOCALHOST_KEY, protocols: [])
    ).must()
    asked = "GET /ws HTTP/1.1\r\nHost: shop.example\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\nping"
    client = spawn(
        fixture.tls_client,
        fixture.Asking(port: l.port, asked: asked, until: "\r\n\r\nping", hold_ms: 5_000)
    ).must()
    conn @= tls.accept(l, deadline: time.seconds(5)).must()
    p @= reverse_proxy([upstream(f"https://localhost:{port}", weight: 1).must()])
    p.roots @ tls.TEST_ROOT
    state @= new_state(p).must()
    served = serve_stream(@state, stream: conn.stream, remote: "192.0.2.1:5000")
    io.close(@conn.stream).must()
    tls.close_listener(@l).must()
    got = client.wait()
    assert served.switched == 1 && up.wait() == 4
    assert strings.has_prefix(s: got, prefix: "HTTP/1.1 101 Switching Protocols\r\n") && strings.has_suffix(s: got, suffix: "\r\n\r\nping")
