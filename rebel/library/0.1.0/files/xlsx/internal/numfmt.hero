# Number formats: the built-in ones by their number, as ECMA-376 Part 1
# § 18.8.30 lists them with openpyxl's codes for the currencies, and whether a
# format's code shows a date. A format's code is read byte by byte; quoted
# text, escaped characters, `_` and `*` with the character after them, and
# brackets are skipped, so no letter inside them makes a date.

constant NOT_FOUND: str
    "not_found"

# The built-in formats' codes, by their number; empty where the number has no
# code of its own.
function builtin_codes() -> [str]
    return [
        "General"
        "0"
        "0.00"
        "#,##0"
        "#,##0.00"
        "\"$\"#,##0_);(\"$\"#,##0)"
        "\"$\"#,##0_);[Red](\"$\"#,##0)"
        "\"$\"#,##0.00_);(\"$\"#,##0.00)"
        "\"$\"#,##0.00_);[Red](\"$\"#,##0.00)"
        "0%"
        "0.00%"
        "0.00E+00"
        "# ?/?"
        "# ??/??"
        "mm-dd-yy"
        "d-mmm-yy"
        "d-mmm"
        "mmm-yy"
        "h:mm AM/PM"
        "h:mm:ss AM/PM"
        "h:mm"
        "h:mm:ss"
        "m/d/yy h:mm"
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        ""
        "#,##0_);(#,##0)"
        "#,##0_);[Red](#,##0)"
        "#,##0.00_);(#,##0.00)"
        "#,##0.00_);[Red](#,##0.00)"
        "_(* #,##0_);_(* \\(#,##0\\);_(* \"-\"_);_(@_)"
        "_(\"$\"* #,##0_);_(\"$\"* \\(#,##0\\);_(\"$\"* \"-\"_);_(@_)"
        "_(* #,##0.00_);_(* \\(#,##0.00\\);_(* \"-\"??_);_(@_)"
        "_(\"$\"* #,##0.00_);_(\"$\"* \\(#,##0.00\\);_(\"$\"* \"-\"??_);_(@_)"
        "mm:ss"
        "[h]:mm:ss"
        "mmss.0"
        "##0.0E+0"
        "@"
    ]

# The code of the built-in format numbered `id`.
function code_of(id: i64) -> str?
    codes = builtin_codes()

    if id >= 0 && id < codes.len() && codes[id] != ""
        return ok(codes[id])
    return fail(code: NOT_FOUND, msg: f"no built-in number format is numbered {id}: they are 0 to 22 and 37 to 49")

# The number of the built-in format whose code is `code`, or -1 where none
# is.
function id_of(code: str) -> i64
    codes = builtin_codes()
    at: i64 @= 0

    while at < codes.len()
        if codes[at] != "" && codes[at] == code
            return at
        at @ at + 1

    return -1

# Whether the built-in format `id`, which a file may name with no code, shows
# a date: 14 to 22, 45 and 47, and the East Asian dates 27 to 36 and 50 to
# 58, whose codes depend on the language.
function is_date_id(id: i64) -> bool
    return id >= 14 && id <= 22 || id >= 27 && id <= 36 || id == 45 || id == 47 || id >= 50 && id <= 58

# Whether `b` is one of the letters that make a date or a time.
function is_date_letter(b: u8) -> bool
    return b == 'y' || b == 'Y' || b == 'm' || b == 'M' || b == 'd' || b == 'D' || b == 'h' || b == 'H' || b == 's' || b == 'S'

# Whether the text of `code` from `from` to `to`, a bracket's inside, counts
# elapsed time: `h`, `m` or `s` repeated, `[h]`, `[mm]`.
function is_elapsed(code: str, from: i64, to: i64) -> bool
    if to <= from
        return false
    first = code[from]

    if !(first == 'h' || first == 'H' || first == 'm' || first == 'M' || first == 's' || first == 'S')
        return false
    at: i64 @= from

    while at < to
        if code[at] != first
            return false
        at @ at + 1

    return true

# Whether the code of a number format shows a date or a time; an elapsed time
# shows a count and is not one.
function is_date(code: str) -> bool
    found: bool @= false
    at: i64 @= 0

    while at < code.len()
        b = code[at]

        if b == '"'
            at @ at + 1

            while at < code.len() && code[at] != '"'
                at @ at + 1

            at @ at + 1
        else if b == '\\' || b == '_' || b == '*'
            at @ at + 2
        else if b == '['
            close: i64 @= at + 1

            while close < code.len() && code[close] != ']'
                close @ close + 1

            if is_elapsed(code, from: at + 1, to: close)
                return false
            at @ close + 1
        else if is_date_letter(b)
            found @ true
            at @ at + 1
        else if (b == 'A' || b == 'a') && has_am_pm(code, at: at)
            found @ true
            at @ at + 1
        else
            at @ at + 1

    return found

# Whether `code` holds `AM/PM` or `A/P`, in any case, at `at`.
function has_am_pm(code: str, at: i64) -> bool
    if at + 5 <= code.len()
        if (code[at + 1] == 'M' || code[at + 1] == 'm') && code[at + 2] == '/' && (code[at + 3] == 'P' || code[at + 3] == 'p') && (code[at + 4] == 'M' || code[at + 4] == 'm')
            return true

    if at + 3 <= code.len()
        return code[at + 1] == '/' && (code[at + 2] == 'P' || code[at + 2] == 'p')
    return false

test "code_of and id_of: the first, a date, a currency, the last, a gap and outside"
    assert code_of(0).must() == "General"
    assert code_of(14).must() == "mm-dd-yy"
    assert code_of(5).must() == "\"$\"#,##0_);(\"$\"#,##0)"
    assert code_of(49).must() == "@"
    assert code_of(23).is_err()
    assert code_of(50).is_err()
    assert code_of(-1).is_err()
    assert id_of("General") == 0
    assert id_of("[h]:mm:ss") == 46
    assert id_of("yyyy-mm-dd") == -1
    assert id_of("") == -1

test "is_date: openpyxl's answers for dates, numbers, quoted and escaped letters, brackets, sections and AM/PM"
    for yes in ["yyyy-mm-dd", "h:mm", "mm:ss", "[$-409]mmmm d, yyyy", "dd/mm/yyyy;@", "AM/PM", "General\\ d", "d", "y", "mmm", "B1yyyy", "[$€-x-sysdate]dddd", "h:mm a/p"]
        assert is_date(yes)

    for no in ["General", "", "0.00", "[Red]0.00", "\"day\" 0", "0 \\d", "#,##0 \"m\"", "@", "0.00E+00", "[>=100]0;0.0", "_(* #,##0_)", "[Blue]General", "e", "0.0_);[Red](0.0)", "[h]:mm:ss", "[mm]:ss", "[s]", "\"unclosed", "["]
        assert !is_date(no)

test "is_date_id: the dates, the times, the elapsed time and the East Asian dates"
    assert is_date_id(14) && is_date_id(22) && is_date_id(45) && is_date_id(47)
    assert is_date_id(27) && is_date_id(36) && is_date_id(50) && is_date_id(58)
    assert !is_date_id(0) && !is_date_id(13) && !is_date_id(46) && !is_date_id(49) && !is_date_id(59)
