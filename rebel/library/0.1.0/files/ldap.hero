# A search read one message at a time.
test "start_search: one at a time"
    started = fake.start(mode: "plain", name: "search")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    q @= query(base: "dc=example,dc=org", f: parse_filter("(&(objectClass=person)(cn=Ana*))").must())
    q.attributes @ ["cn", "mail"]
    start_search(@c, q).must()
    names: [str] @= []
    going @= true

    while going
        match next_item(@c).must()
            .entry e     => names @ names.push(e.v.dn)
            .reference _ => _ = 0
            .done _      => going @ false

    assert names == ["cn=Ana Rossi,dc=example,dc=org"]
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# The first message of a search: an entry.
test "next_item: an entry"
    started = fake.start(mode: "plain", name: "search")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    q @= query(base: "dc=example,dc=org", f: parse_filter("(&(objectClass=person)(cn=Ana*))").must())
    q.attributes @ ["cn", "mail"]
    start_search(@c, q).must()

    match next_item(@c).must()
        .entry e     => assert e.v.dn == "cn=Ana Rossi,dc=example,dc=org"
        .reference _ => assert false
        .done _      => assert false

    assert next_item(@c).must() == .reference(v: Reference(urls: ["ldap://other.example.org/dc=other"]))

    match next_item(@c).must()
        .done d      => assert d.v.code == SUCCESS
        .entry _     => assert false
        .reference _ => assert false

    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# A search given up after its first entry.
test "abandon_search: after one entry"
    started = fake.start(mode: "plain", name: "abandon-only")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    q @= query(base: "dc=example,dc=org", f: parse_filter("(&(objectClass=person)(cn=Ana*))").must())
    q.attributes @ ["cn", "mail"]
    start_search(@c, q).must()
    _ = next_item(@c).must()
    abandon_search(@c).must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# The first page of two entries, and the cookie for the next.
test "search_page: the first page"
