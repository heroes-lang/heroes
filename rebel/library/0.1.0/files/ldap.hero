    assert is_secured(c)
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# TLS begun on a connection opened in plain text, where the platform begins
# TLS over a connection it holds; macOS answers `unsupported`, and there
# `connect` with `.start_tls` is the way.
test "start_tls: on an open connection"
    darwin = os.system() == .darwin

    mode = if darwin
        "plain"
    else
        "starttls"

    script = if darwin
        "bind"
    else
        "starttls"

    started = fake.start(mode: mode, name: script)
    port = started.port
    server @= started.thread
    opts @= options("localhost")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()

    match start_tls(@c, roots: tls.TEST_ROOT)
        .ok _ =>
            assert is_secured(c)
            bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
            assert who_am_i(@c).must() == "dn:cn=admin,dc=example,dc=org"
        .err e =>
            assert e.code == "unsupported" && darwin
            bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()

    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# Each later operation bounded to five seconds.
test "set_deadline: five seconds"
    started = fake.start(mode: "plain", name: "bind")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    set_deadline(@c, deadline: time.seconds(5).must()).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

