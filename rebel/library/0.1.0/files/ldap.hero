    page = search_page(
        @c,
        query(base: "dc=example,dc=org", f: parse_filter("(objectClass=*)").must()),
        size: 2,
        cookie: []
    ).must()
    assert page.found.entries.len() == 1 && page.cookie == bytes.from_text("c1")
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# Every entry, asked for two at a time.
test "search_paged: two pages"
    started = fake.start(mode: "plain", name: "paged")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    found = search_paged(
        @c,
        query(base: "dc=example,dc=org", f: parse_filter("(objectClass=*)").must()),
        size: 2
    ).must()
    assert found.entries.len() == 2 && found.entries[1].dn == "cn=Bea,dc=example,dc=org"
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# An attribute of text values.
test "text_attribute: two values"
    assert text_attribute(name: "mail", values: ["a@b.c", "d@e.f"]).values.len() == 2

# The bytes of an entry's values.
test "values_of: by name"
    e = Entry(dn: "cn=Ana,dc=x", attributes: [text_attribute(name: "mail", values: ["a@b.c", "d@e.f"])], controls: [])
    assert values_of(e, name: "Mail") == [bytes.from_text("a@b.c"), bytes.from_text("d@e.f")]

# An entry's values as text.
test "texts_of: two mails"
    e = Entry(dn: "cn=Ana,dc=x", attributes: [text_attribute(name: "mail", values: ["a@b.c", "d@e.f"])], controls: [])
    assert texts_of(e, name: "mail").must() == ["a@b.c", "d@e.f"]

# An entry's first value as text.
test "text_of: the first mail"
    e = Entry(dn: "cn=Ana,dc=x", attributes: [text_attribute(name: "mail", values: ["a@b.c", "d@e.f"])], controls: [])
    assert text_of(e, name: "mail").must() == "a@b.c"

# Whether an entry has an attribute.
test "has_attribute: mail but no phone"
    e = Entry(dn: "cn=Ana,dc=x", attributes: [text_attribute(name: "mail", values: ["a@b.c", "d@e.f"])], controls: [])
    assert has_attribute(e, name: "MAIL") && !has_attribute(e, name: "telephoneNumber")

# A person added.
test "add: a person"
    started = fake.start(mode: "plain", name: "add")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    add(
        @c,
        dn: "cn=Ana,dc=example,dc=org",
        attributes: [text_attribute(name: "objectClass", values: ["person"]), text_attribute(name: "cn", values: ["Ana"]), text_attribute(name: "sn", values: ["Rossi"])]
    ).must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# A mail replaced, two descriptions added, a phone removed, a number incremented.
test "modify: four changes"
    started = fake.start(mode: "plain", name: "modify")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    changes = [
        Change(kind: .replace, attribute: text_attribute(name: "mail", values: ["ana@example.org"]))
        Change(kind: .add, attribute: text_attribute(name: "description", values: ["x", "y"]))
        Change(kind: .delete, attribute: text_attribute(name: "telephoneNumber", values: []))
        Change(kind: .increment, attribute: text_attribute(name: "uidNumber", values: ["1"]))
    ]
    modify(@c, dn: "cn=Ana,dc=example,dc=org", changes: changes).must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# An entry that does not exist.
test "delete: absent"
    started = fake.start(mode: "plain", name: "delete-nosuch")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()

    match delete(@c, dn: "cn=Ana,dc=example,dc=org")
        .ok _  => assert false
        .err e => assert e.code == "not_found"

    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# An entry renamed and moved below another.
test "rename: renamed and moved"
    started = fake.start(mode: "plain", name: "rename")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    rename(
        @c,
        dn: "cn=Ana,dc=example,dc=org",
        new_rdn: "cn=Anna",
        delete_old: true,
        new_parent: "ou=people,dc=example,dc=org"
    ).must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# Whether an entry's surname is Rossi, and then not.
test "compare: true then false"
    started = fake.start(mode: "plain", name: "compare")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    assert compare(@c, dn: "cn=Ana,dc=example,dc=org", attribute: "sn", value: bytes.from_text("Rossi")).must()
    assert !compare(@c, dn: "cn=Ana,dc=example,dc=org", attribute: "sn", value: bytes.from_text("Rossi")).must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# A password changed, and the one the server made.
test "change_password: changed"
    started = fake.start(mode: "plain", name: "passwd")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    assert change_password(@c, user: "cn=Ana,dc=example,dc=org", old: "old", new: "new").must() == "Xy12"
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# Who am I? run by its identifier.
test "extended: Who am I?"
    started = fake.start(mode: "plain", name: "whoami")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    assert extended(@c, name: WHO_AM_I, value: []).must().value == bytes.from_text("dn:cn=admin,dc=example,dc=org")
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# A name read into its relative names.
test "parse_dn: four relative names"
    d = parse_dn("cn=Rossi\\, Ana,ou=people,dc=example,dc=org").must()
    assert d.rdns.len() == 4 && d.rdns[0].parts[0].value == "Rossi, Ana"

# A name written back.
test "format_dn: escapes kept"
    assert format_dn(parse_dn("cn = Rossi\\, Ana , dc=org").must()) == "cn=Rossi\\, Ana,dc=org"

# A relative name of two parts.
test "parse_rdn: two parts"
    assert parse_rdn("cn=Ana+sn=Rossi").must().parts.len() == 2

# A relative name written.
test "format_rdn: two parts"
    assert format_rdn(Rdn(parts: [Ava(attribute: "cn", value: "Ana"), Ava(attribute: "sn", value: "Rossi")])) == "cn=Ana+sn=Rossi"

# A value with a comma, ready to stand in a name.
test "escape_dn_value: a comma"
    assert escape_dn_value("Rossi, Ana") == "Rossi\\, Ana"

# An escaped value read.
test "unescape_dn_value: a comma"
    assert unescape_dn_value("Rossi\\, Ana").must() == "Rossi, Ana"

# Two spellings of one name.
test "is_same_dn: case of the types"
    assert is_same_dn(a: parse_dn("CN=Ana,DC=org").must(), b: parse_dn("cn=Ana,dc=org").must())

# Two names whose values differ in case alone.
test "is_same_dn_ignoring_case: case of the values"
    assert is_same_dn_ignoring_case(a: parse_dn("cn=ANA,dc=org").must(), b: parse_dn("cn=ana,dc=org").must())

# A person below the directory's base.
test "is_under: below its base"
    assert is_under(dn: parse_dn("cn=Ana,ou=people,dc=org").must(), ancestor: parse_dn("dc=org").must())

# The entry above a person.
test "parent_of: its unit"
    assert format_dn(parent_of(parse_dn("cn=Ana,ou=people,dc=org").must()).must()) == "ou=people,dc=org"

# A new entry's name below a unit.
test "child_of: below a unit"
    assert format_dn(child_of(parent: parse_dn("ou=people,dc=org").must(), rdn: parse_rdn("cn=Ana").must())) == "cn=Ana,ou=people,dc=org"

# A filter read from text.
test "parse_filter: people named Ana"
    assert parse_filter("(&(objectClass=person)(cn=Ana*))").must() == .and_of(items: [.equal(attribute: "objectClass", value: bytes.from_text("person")), .substrings(attribute: "cn", initial: bytes.from_text("Ana"), middle: [], final: [])])

# A filter built as a value and written as text.
test "format_filter: a presence test"
    assert format_filter(.not_of(items: [.present(attribute: "mail")])).must() == "(!(mail=*))"

# A name with a star and parentheses, safe to stand in a filter.
test "escape_filter: a star"
    assert "(cn=" + escape_filter("A*(b)") + ")" == "(cn=A\\2a\\28b\\29)"

# A binary value written for a filter.
test "escape_filter_bytes: an identifier"
    assert escape_filter_bytes([0xa1, 0x41]) == "\\a1A"

# The bytes of an escaped value.
test "unescape_filter: a star"
    assert unescape_filter("A\\2a").must() == bytes.from_text("A*")

# A filter's BER.
test "encode_filter: an equality"
    assert bytes.format_hex(encode_filter(parse_filter("(cn=Ana)").must()).must()) == "a3090402636e0403416e61"

# A filter read from its BER.
test "decode_filter: an equality"
    assert format_filter(decode_filter(bytes.parse_hex("a3090402636e0403416e61").must()).must()).must() == "(cn=Ana)"

# A server and a search in one URL.
test "parse_url: every part"
    u = parse_url("ldap://ldap.example.org/dc=example,dc=org?cn?sub?(cn=A*)").must()
    assert u.host == "ldap.example.org" && u.port == 389 && u.attributes == ["cn"] && u.scope == .subtree

# A URL written back, its defaults left out.
test "format_url: defaults left out"
    assert format_url(parse_url("ldap://h:389/dc=x??base?(objectClass=*)").must()).must() == "ldap://h/dc=x"

# The options of the server a URL names.
test "to_options: ldaps"
    assert to_options(parse_url("ldaps://ldap.example.org").must()).security == .direct(roots: "")

# The search a URL names.
test "to_query: a base and a filter"
    assert to_query(parse_url("ldap:///dc=x??one?(cn=A*)").must()).scope == .one_level
