test "connect with StartTLS: a server that knows no StartTLS fails unsupported"
    started = fake.start(mode: "plain", name: "starttls-refused")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .start_tls(roots: tls.TEST_ROOT)

    match connect(opts)
        .ok _  => assert false
        .err e => assert e.code == "unsupported" && e.msg == f"StartTLS on 127.0.0.1:{port}: protocolError (2): unsupported extended operation"

    assert threads.wait_text(@server) == "ok"

test "start_tls: on macOS a connection already open fails unsupported, before anything is sent"
    if os.system() != .darwin
        skip_test(reason: "the case is macOS's alone, whose TLS begins only over a connection tls makes")
    started = fake.start(mode: "plain", name: "bind")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()

    match start_tls(@c, roots: tls.TEST_ROOT)
        .ok _  => assert false
        .err e => assert e.code == "unsupported"

    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

test "names: parse_dn, format_dn, parse_rdn, the comparisons, a parent and a child"
    d = parse_dn("CN=Ana+sn=Rossi, ou=people, dc=example,dc=org").must()
    assert d.rdns.len() == 4 && d.rdns[0].parts == [Ava(attribute: "CN", value: "Ana"), Ava(attribute: "sn", value: "Rossi")]
    assert format_dn(d) == "CN=Ana+sn=Rossi,ou=people,dc=example,dc=org"
    assert format_dn(parse_dn("").must()) == ""
    assert is_same_dn(a: d, b: parse_dn("sn=Rossi+cn=Ana,OU=people,DC=example,DC=org").must())
    assert !is_same_dn(a: d, b: parse_dn("cn=ana+sn=Rossi,ou=people,dc=example,dc=org").must())
    assert is_same_dn_ignoring_case(a: d, b: parse_dn("cn=ana+sn=ROSSI,ou=People,dc=Example,dc=org").must())
    base = parse_dn("dc=example,dc=org").must()
    assert is_under(dn: d, ancestor: base) && !is_under(dn: base, ancestor: d) && !is_under(dn: base, ancestor: base)
    assert is_under(dn: base, ancestor: parse_dn("").must())
    assert format_dn(parent_of(base).must()) == "dc=org"
    assert parent_of(parse_dn("").must()).is_err()
    assert format_dn(child_of(parent: base, rdn: parse_rdn("cn=Rossi\\, Ana").must())) == "cn=Rossi\\, Ana,dc=example,dc=org"
    assert parse_rdn("cn=a,dc=b").is_err()
    assert parse_rdn("").is_err()
    assert format_rdn(Rdn(parts: [Ava(attribute: "cn", value: " #lead, trail ")])) == "cn=\\ #lead\\, trail\\ "

test "filters: the variant written and read back, values as bytes, a filter refused when written"
    f: Filter = .and_of(
        items: [.equal(attribute: "objectClass", value: bytes.from_text("person")), .or_of(items: [.substrings(attribute: "cn", initial: bytes.from_text("An"), middle: [bytes.from_text("os")], final: []), .not_of(items: [.present(attribute: "mail")])]), .extensible(rule: "caseExactMatch", attribute: "sn", value: bytes.from_text("Rossi"), dn_attributes: true), .approx(attribute: "cn", value: bytes.from_text("Anna")), .greater_or_equal(attribute: "age", value: bytes.from_text("18")), .less_or_equal(attribute: "age", value: bytes.from_text("65"))]
    )
    text = format_filter(f).must()
    assert text == "(&(objectClass=person)(|(cn=An*os*)(!(mail=*)))(sn:dn:caseExactMatch:=Rossi)(cn~=Anna)(age>=18)(age<=65))"
    assert parse_filter(text).must() == f
    assert decode_filter(encode_filter(f).must()).must() == f
    assert format_filter(.not_of(items: [])).is_err()
    assert format_filter(.substrings(attribute: "cn", initial: [], middle: [[]], final: [])).is_err()
    assert format_filter(.extensible(rule: "", attribute: "", value: [], dn_attributes: false)).is_err()
    assert format_filter(.equal(attribute: "", value: [])).is_err()
    assert encode_filter(.present(attribute: "a b")).is_err()
    assert decode_filter([0x30, 0x00]).is_err()
    assert unescape_filter("caf\\c3\\a9").must() == bytes.from_text("café")
    assert unescape_filter("a)").is_err()

test "parse_url and format_url: defaults, a filter parsed, every part, and the options and query a URL names"
    u = parse_url("ldaps://ldap.example.org/dc=example,dc=org?cn,mail?sub?(cn=A*)?!e-bindname=cn=x").must()
    assert u.port == DEFAULT_TLS_PORT && u.scope == .subtree && u.attributes == ["cn", "mail"] && u.extensions == ["!e-bindname=cn=x"]
    assert format_url(u).must() == "ldaps://ldap.example.org/dc=example,dc=org?cn,mail?sub?(cn=A*)?!e-bindname=cn=x"
    plain = parse_url("ldap://h").must()
    assert plain.port == DEFAULT_PORT && plain.scope == .base_object && plain.filter == .present(attribute: "objectClass")
    assert format_url(plain).must() == "ldap://h"
    odd = parse_url("ldap://h:1389/??one").must()
    assert format_url(odd).must() == "ldap://h:1389/??one"
    assert parse_url("ldap://h/??sub?(cn=a**)").is_err()
    wrong @= plain
    wrong.scheme @ "http"
    assert format_url(wrong).is_err()
    o = to_options(parse_url("ldap:///dc=x").must())
    assert o.host == "localhost" && o.port == 389 && o.security == .start_tls(roots: "")
    assert to_options(u).security == .direct(roots: "")
    q = to_query(u)
    assert q.base == "dc=example,dc=org" && q.scope == .subtree && q.attributes == ["cn", "mail"]

test "controls: paged, sort, the response read, and the four that need no value"
    p = paged_control(size: 2, cookie: [])
    assert p.critical && bytes.format_hex(p.value) == "30050201020400"
    assert paged_of([Control(oid: PAGED_RESULTS, critical: false, value: bytes.parse_hex("3007020100040263" + "31").must())]).must() == Paged(size: 0, cookie: bytes.from_text("c1"))
    assert paged_of([]).is_err()
    s = sort_control([SortKey(attribute: "cn", ordering_rule: "", reverse: false)], critical: false).must()
    assert s.oid == SORT_REQUEST && bytes.format_hex(s.value) == "300630040402636e"
    assert sort_control([], critical: true).is_err()
    assert sort_control([SortKey(attribute: "", ordering_rule: "", reverse: true)], critical: true).is_err()
    assert sort_result_of([Control(oid: SORT_RESPONSE, critical: false, value: [0x30, 0x03, 0x0a, 0x01, 0x00])]).must() == SUCCESS
    assert sort_result_of([]).is_err()
    assert manage_dsa_it_control().oid == MANAGE_DSA_IT && tree_delete_control().critical
    assert proxied_authorization_control("dn:cn=Ana").value == bytes.from_text("dn:cn=Ana")
    assert bytes.format_hex(assertion_control(.equal(attribute: "cn", value: bytes.from_text("Ana"))).must().value) == "a3090402636e0403416e61"

test "entries: values by name with case ignored, text and binary values, an attribute absent"
    e = Entry(
        dn: "cn=Ana,dc=x",
        attributes: [text_attribute(name: "cn", values: ["Ana", "Anna"]), Attribute(name: "jpegPhoto", values: [[0xff, 0xd8]])],
        controls: []
    )
    assert texts_of(e, name: "CN").must() == ["Ana", "Anna"] && text_of(e, name: "cn").must() == "Ana"
    assert values_of(e, name: "JPEGPHOTO") == [[0xff, 0xd8]] && values_of(e, name: "mail") == []
    assert has_attribute(e, name: "jpegphoto") && !has_attribute(e, name: "mail")

    match texts_of(e, name: "jpegPhoto")
        .ok _   => assert false
        .err e2 => assert e2.code == "not_text"

    match text_of(e, name: "mail")
        .ok _   => assert false
        .err e2 => assert e2.code == "not_found"

    assert texts_of(e, name: "mail").must() == []

test "live: StartTLS, binds, searches, pages, sorting, changes and passwords against the server REBEL_LDAP_PORT names, dc=example,dc=org with cn=admin, cleaned up after"
    match os.env("REBEL_LDAP_PORT")
        .err _ => skip_test(reason: "REBEL_LDAP_PORT names no server")
        .ok port_text =>
            opts @= options(os.env("REBEL_LDAP_HOST").default("localhost"))
            opts.port @ numbers.parse_int(port_text).must()
            opts.security @ .start_tls(roots: tls.TEST_ROOT)
            password = os.env("REBEL_LDAP_PASSWORD").default("secret")
            admin = "cn=admin,dc=example,dc=org"
            c @= connect(opts).must()
            assert is_secured(c)

            match bind(@c, dn: admin, password: "not the password")
                .ok _  => assert false
                .err e => assert e.code == "permission" && result_of(c).code == INVALID_CREDENTIALS

            bind(@c, dn: admin, password: password).must()
            assert who_am_i(@c).must() == "dn:" + admin
            dse = root_dse(@c).must()
            assert texts_of(dse, name: "namingContexts").must() == ["dc=example,dc=org"]
            assert texts_of(dse, name: "supportedControl").must().len() > 3
            base = "ou=rebel-live,dc=example,dc=org"
            leftovers = search(@c, query(base: base, f: parse_filter("(objectClass=*)").must()))

            match leftovers
                .err e => assert e.code == "not_found"
                .ok found =>
                    k @= found.entries.len()

                    while k > 0
                        k @ k - 1
                        delete(@c, dn: found.entries[k].dn).must()

            add(
                @c,
                dn: base,
                attributes: [text_attribute(name: "objectClass", values: ["organizationalUnit"]), text_attribute(name: "ou", values: ["rebel-live"])]
            ).must()

            match add(@c, dn: base, attributes: [text_attribute(name: "objectClass", values: ["organizationalUnit"]), text_attribute(name: "ou", values: ["rebel-live"])])
                .ok _  => assert false
                .err e => assert e.code == "exists"

            for i in range(from: 0, to: 25)
                name = if i < 10
                    f"p0{i}"
                else
                    f"p{i}"

                photo: [u8] = [0xff, 0xd8, to_u8(i).must()]
                add(
                    @c,
                    dn: f"cn={name},{base}",
                    attributes: [text_attribute(name: "objectClass", values: ["inetOrgPerson"]), text_attribute(name: "cn", values: [name]), text_attribute(name: "sn", values: ["Rossi città"]), text_attribute(name: "mail", values: [name + "@example.org"]), Attribute(name: "jpegPhoto", values: [photo])]
                ).must()

            people @= query(base: base, f: parse_filter("(&(objectClass=inetOrgPerson)(sn=Rossi*))").must())
            people.attributes @ ["cn", "mail", "jpegPhoto"]
            everyone = search(@c, people).must()
            assert everyone.entries.len() == 25 && everyone.result.code == SUCCESS
            assert values_of(everyone.entries[0], name: "JPEGPHOTO")[0].len() == 3
            assert texts_of(everyone.entries[0], name: "jpegPhoto").is_err()
            capped @= people
            capped.size_limit @ 5
            cut = search(@c, capped).must()
            assert cut.entries.len() == 5 && cut.result.code == SIZE_LIMIT_EXCEEDED
            paged = search_paged(@c, people, size: 7).must()
            assert paged.entries.len() == 25
            sorted @= people
            sorted.controls @ [
                sort_control([SortKey(attribute: "cn", ordering_rule: "caseIgnoreOrderingMatch", reverse: true)], critical: true).must()
            ]
            in_order = search(@c, sorted).must()
            assert text_of(in_order.entries[0], name: "cn").must() == "p24" && text_of(in_order.entries[24], name: "cn").must() == "p00"
            assert sort_result_of(in_order.result.controls).must() == SUCCESS
            start_search(@c, people).must()
            streamed @= 0

            while streamed < 3
                match next_item(@c).must()
                    .entry _     => streamed @ streamed + 1
                    .reference _ => _ = 0
                    .done _      => assert false

            abandon_search(@c).must()
            one = lookup(@c, dn: f"cn=p03,{base}", attributes: ["mail", "sn"]).must()
            assert text_of(one, name: "mail").must() == "p03@example.org" && text_of(one, name: "sn").must() == "Rossi città"
            assert compare(@c, dn: f"cn=p03,{base}", attribute: "sn", value: bytes.from_text("rossi CITTÀ")).must()
            assert !compare(@c, dn: f"cn=p03,{base}", attribute: "sn", value: bytes.from_text("Bianchi")).must()
            changes = [
                Change(kind: .replace, attribute: text_attribute(name: "mail", values: ["ana@example.org"]))
                Change(kind: .add, attribute: text_attribute(name: "description", values: ["one", "two"]))
                Change(kind: .delete, attribute: text_attribute(name: "description", values: ["one"]))
            ]
            modify(@c, dn: f"cn=p03,{base}", changes: changes).must()
            changed = lookup(@c, dn: f"cn=p03,{base}", attributes: ["mail", "description"]).must()
            assert texts_of(changed, name: "mail").must() == ["ana@example.org"] && texts_of(changed, name: "description").must() == ["two"]

            match modify(@c, dn: f"cn=p03,{base}", changes: [Change(kind: .delete, attribute: text_attribute(name: "description", values: ["absent"]))])
                .ok _  => assert false
                .err e => assert e.code == "not_found" && result_of(c).code == NO_SUCH_ATTRIBUTE

            set_controls(@c, controls: [assertion_control(parse_filter("(mail=nobody@example.org)").must()).must()])

            match modify(@c, dn: f"cn=p03,{base}", changes: changes)
                .ok _  => assert false
                .err e => assert result_of(c).code == ASSERTION_FAILED && e.code == "invalid"

            set_controls(@c, controls: [manage_dsa_it_control()])
            assert lookup(@c, dn: f"cn=p04,{base}", attributes: ["cn"]).must().dn == f"cn=p04,{base}"
            set_controls(@c, controls: [])
            add(
                @c,
                dn: f"ou=moved,{base}",
                attributes: [text_attribute(name: "objectClass", values: ["organizationalUnit"]), text_attribute(name: "ou", values: ["moved"])]
            ).must()
            rename(@c, dn: f"cn=p05,{base}", new_rdn: "cn=q05", delete_old: true, new_parent: "").must()
            rename(@c, dn: f"cn=q05,{base}", new_rdn: "cn=q05", delete_old: true, new_parent: f"ou=moved,{base}").must()
            assert lookup(@c, dn: f"cn=q05,ou=moved,{base}", attributes: ["cn"]).must().dn == f"cn=q05,ou=moved,{base}"

            match delete(@c, dn: f"ou=moved,{base}")
                .ok _  => assert false
                .err e => assert e.code == "not_empty"

            match delete(@c, dn: f"cn=absent,{base}")
                .ok _  => assert false
                .err e => assert e.code == "not_found" && result_of(c).matched_dn == base

            made = change_password(@c, user: f"cn=p06,{base}", old: "", new: "").must()
            assert made.len() > 0
            assert change_password(@c, user: f"cn=p07,{base}", old: "", new: "pw7").must() == ""
            bind(@c, dn: f"cn=p07,{base}", password: "pw7").must()
            assert who_am_i(@c).must() == f"dn:cn=p07,{base}"
            bind(@c, dn: f"cn=p06,{base}", password: made).must()
            bind_plain(@c, authz_id: "", user: "ana", password: "secret").must()
            plain_who = who_am_i(@c).must()
            assert plain_who == "dn:uid=ana@example.org,ou=people,dc=example,dc=org"
            assert bind_external(@c, authz_id: "").is_err()
            bind_anonymous(@c).must()
            assert who_am_i(@c).must() == ""
            bind(@c, dn: admin, password: password).must()
            remaining = search(@c, query(base: base, f: parse_filter("(objectClass=*)").must())).must()
            k @= remaining.entries.len()
            depth_sorted: [str] @= []

            for e in remaining.entries
                if is_under(dn: parse_dn(e.dn).must(), ancestor: parse_dn(f"ou=moved,{base}").must())
                    depth_sorted @ depth_sorted.push(e.dn)

            for d in depth_sorted
                delete(@c, dn: d).must()

            while k > 0
                k @ k - 1
                name = remaining.entries[k].dn

                if !is_under(dn: parse_dn(name).must(), ancestor: parse_dn(f"ou=moved,{base}").must()) && name != f"ou=moved,{base}" && name != base
                    delete(@c, dn: name).must()

            delete(@c, dn: f"ou=moved,{base}").must()
            delete(@c, dn: base).must()
            close(@c).must()
            print(
                f"live: {plain_who}, 25 entries, 4 pages of 7, sorted, streamed, changed, renamed and moved, passwords, all removed"
            )

test "live over TLS from the first byte, against the server REBEL_LDAP_TLS_PORT names"
    match os.env("REBEL_LDAP_TLS_PORT")
        .err _ => skip_test(reason: "REBEL_LDAP_TLS_PORT names no server")
        .ok port_text =>
            opts @= options(os.env("REBEL_LDAP_HOST").default("localhost"))
            opts.port @ numbers.parse_int(port_text).must()
            opts.security @ .direct(roots: tls.TEST_ROOT)
            c @= connect(opts).must()
            bind(@c, dn: "cn=admin,dc=example,dc=org", password: os.env("REBEL_LDAP_PASSWORD").default("secret")).must()
            assert who_am_i(@c).must() == "dn:cn=admin,dc=example,dc=org"
            close(@c).must()
            print("live over TLS: bound as cn=admin over ldaps")

## Examples

# The name of a result code.
test "result_name: noSuchObject"
    assert result_name(NO_SUCH_OBJECT) == "noSuchObject"

# The whole result after a refused bind: its code and the server's words.
test "result_of: after a wrong password"
    started = fake.start(mode: "plain", name: "bind-refused")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()

    match bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret")
        .ok _  => assert false
        .err _ => assert result_of(c).code == INVALID_CREDENTIALS && result_of(c).message == "invalid credentials"

    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# The ManageDsaIT control sent with a delete.
test "set_controls: ManageDsaIT with a delete"
    started = fake.start(mode: "plain", name: "delete-managed")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    set_controls(@c, controls: [manage_dsa_it_control()])
    delete(@c, dn: "cn=Ana,dc=example,dc=org").must()
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# The control asking for the first page of 100 entries.
test "paged_control: the first page"
    assert paged_control(size: 100, cookie: []).oid == PAGED_RESULTS

# The cookie a page's result holds.
test "paged_of: a cookie"
    answer = Control(
        oid: PAGED_RESULTS,
        critical: false,
        value: paged_control(size: 5, cookie: bytes.from_text("c1")).value
    )
    assert paged_of([answer]).must().cookie == bytes.from_text("c1")

# Entries asked for sorted by surname, then by name.
test "sort_control: two keys"
    sorted = sort_control(
        [SortKey(attribute: "sn", ordering_rule: "", reverse: false), SortKey(attribute: "cn", ordering_rule: "", reverse: false)],
        critical: false
    ).must()
    assert sorted.oid == SORT_REQUEST

# The result a sort response control holds.
test "sort_result_of: sorted"
    assert sort_result_of([Control(oid: SORT_RESPONSE, critical: false, value: [0x30, 0x03, 0x0a, 0x01, 0x00])]).must() == SUCCESS

# The ManageDsaIT control, critical.
test "manage_dsa_it_control: critical"
    assert manage_dsa_it_control().critical

# The subtree delete control.
test "tree_delete_control: its identifier"
    assert tree_delete_control().oid == TREE_DELETE

# A request run as another identity.
test "proxied_authorization_control: as a name"
    assert proxied_authorization_control("dn:cn=Ana,dc=example,dc=org").oid == PROXIED_AUTHORIZATION

# A change made only where the entry's surname is still Rossi.
test "assertion_control: a surname"
    assert assertion_control(parse_filter("(sn=Rossi)").must()).must().oid == ASSERTION

# The options of a server: StartTLS on port 389.
test "options: the defaults"
    opts = options("ldap.example.org")
    assert opts.port == 389 && opts.security == .start_tls(roots: "")

# A connection in plain text to a server on this machine, bound and closed.
test "connect: in plain text"
    started = fake.start(mode: "plain", name: "bind")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    assert !is_secured(c)
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# A connection closed, its session ended with an UnbindRequest.
test "close: after a bind"
    started = fake.start(mode: "plain", name: "bind")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    close(@c).must()
    assert is_closed(c)
    assert threads.wait_text(@server) == "ok"

# A connection is open until closed.
test "is_closed: open, then closed"
    started = fake.start(mode: "plain", name: "bind")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    assert !is_closed(c)
    close(@c).must()
    assert is_closed(c)
    assert threads.wait_text(@server) == "ok"

# A connection over TLS from the first byte.
test "is_secured: ldaps"
