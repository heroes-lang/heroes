# A search of the people named Ana below a base.
test "query: a subtree"
    q = query(base: "dc=example,dc=org", f: parse_filter("(&(objectClass=person)(cn=Ana*))").must())
    assert q.scope == .subtree && q.size_limit == 0

# The people named Ana, with their names and mail.
test "search: entries and a reference"
    started = fake.start(mode: "plain", name: "search")
    port = started.port
    server @= started.thread
    opts @= options("127.0.0.1")
    opts.port @ port
    opts.security @ .plain
    c @= connect(opts).must()
    bind(@c, dn: "cn=admin,dc=example,dc=org", password: "secret").must()
    q @= query(base: "dc=example,dc=org", f: parse_filter("(&(objectClass=person)(cn=Ana*))").must())
    q.attributes @ ["cn", "mail"]
    found = search(@c, q).must()
    assert found.entries.len() == 1 && found.result.code == SUCCESS
    assert texts_of(found.entries[0], name: "mail").must() == ["ana@example.org", "a@b.c"]
    assert found.references == [Reference(urls: ["ldap://other.example.org/dc=other"])]
    close(@c).must()
    assert threads.wait_text(@server) == "ok"

# One entry by its name.
