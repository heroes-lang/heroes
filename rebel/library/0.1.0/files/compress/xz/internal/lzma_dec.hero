# The LZMA decoder: a range decoder over bits whose probabilities adapt,
# and the literals, repeats and repeated distances it reads with them, as
# the `.lzma` format and LZMA2's chunks hold them. Every probability lives in
# one list, at the offsets below. A distance that reaches before the
# dictionary, a repeat past the end the caller set, or a read past the
# input fails `invalid`; the output is held to the caller's limit.

use compress/internal/codes

# Where each group of probabilities begins: whether a symbol is a repeat,
# by state and position.
constant IS_MATCH: i64
    0

# Whether a repeat uses an earlier distance, by state.
constant IS_REP: i64
    192

# Whether that distance is the last one, by state.
constant IS_REP_G0: i64
    204

# Whether it is the second last, by state.
constant IS_REP_G1: i64
    216

# Whether it is the third last, by state.
constant IS_REP_G2: i64
    228

# Whether a repeat of the last distance is longer than one byte.
constant IS_REP0_LONG: i64
    240

# The six-bit slot of a distance, by the length's state.
constant POS_SLOT: i64
    432

# The low bits of distances whose slot is 4 to 13.
constant SPEC_POS: i64
    688

# The four lowest bits of distances whose slot is 14 or more.
constant ALIGN: i64
    802

# The lengths of new repeats.
constant LEN: i64
    818

# The lengths of repeats of an earlier distance.
constant REP_LEN: i64
    1332

# The literals, 768 for each of their 2^(lc + lp) contexts.
constant LITERAL: i64
    1846

# A probability's starting value: one half, in eleven bits.
constant HALF: i64
    1024

# The three numbers of an LZMA properties byte.
record Props
    # How many high bits of the byte before give a literal's context: 0 to 8.
    lc: i64
    # How many low bits of the position give it too: 0 to 4.
    lp: i64
    # How many low bits of the position give a symbol's: 0 to 4.
    pb: i64

# What a decoder carries from symbol to symbol, and from chunk to chunk.
record Decoder
    # Every probability, at the offsets above.
    probs: [i64]
    # The literal and position bits.
    props: Props
    # The state, 0 to 11: what the last symbols were.
    state: i64
    # The last four distances less one, the last first.
    reps: [i64]

# Where the range decoder stands.
record Range
    # The width of the range, 32 bits.
    range: i64
    # The bits of input inside it, 32 bits.
    code: i64
    # The index of the next input byte.
    pos: i64
    # The index past the last byte it may read.
    end: i64
    # How many bytes it wanted past `end`: a stream cut short.
    over: i64

# The numbers of the properties byte `byte`, read at `at`.
function props_of(byte: i64, at: i64) -> Props?
    if byte >= 225
        return codes.invalid_at(at: at, why: f"an LZMA properties byte of {byte}, past 224")
    return ok(Props(lc: byte % 9, lp: byte / 9 % 5, pb: byte / 45))

# A decoder with every probability at one half and every distance 0.
function fresh(props: Props) -> Decoder
    count = LITERAL + (768 << props.lc + props.lp)
    probs: [i64] @= []

    for _ in range(from: 0, to: count)
        probs @ probs.push(HALF)

    return Decoder(probs: probs, props: props, state: 0, reps: [0, 0, 0, 0])

# A range decoder over `input` from `at` to `end`: its first byte 0, then the
# first 32 bits of code.
function range_at(input: [u8] lent, at: i64, end: i64) -> Range?
    if end - at < 5
        return codes.invalid_at(at: at, why: "an LZMA stream shorter than its five first bytes")

    if input[at] != 0
        return codes.invalid_at(at: at, why: "an LZMA stream whose first byte is not 0")
    code: i64 @= 0

    for k in range(from: 1, to: 5)
        code @ code << 8 | to_i64(input[at + k]).must()

    return ok(Range(range: 0xffffffff, code: code, pos: at + 5, end: end, over: 0))

# Takes one more byte into the range where it has narrowed below 2^24.
function normalize(@rc: Range, input: [u8] lent)
    if rc.range < 0x1000000
        rc.range @ rc.range << 8
        next: i64 @= 0

        if rc.pos < rc.end
            next @ to_i64(input[rc.pos]).must()
        else
            rc.over @ rc.over + 1
        rc.pos @ rc.pos + 1
        rc.code @ (rc.code << 8 | next) & 0xffffffff

# The next bit, by the probability at `at` of `probs`, which it adapts.
function bit(@rc: Range, @probs: [i64], at: i64, input: [u8] lent) -> i64
    p = probs[at]
    bound = (rc.range >> 11) * p
    result: i64 @= 0

    if rc.code < bound
        rc.range @ bound
        probs[at] @ p + (2048 - p >> 5)
    else
        rc.range @ rc.range - bound
        rc.code @ rc.code - bound
        probs[at] @ p - (p >> 5)
        result @ 1
    normalize(@rc, input)
    return result

# `count` bits each of probability one half, the first highest.
function direct(@rc: Range, input: [u8] lent, count: i64) -> i64
    value: i64 @= 0

    for _ in range(from: 0, to: count)
        rc.range @ rc.range >> 1
        b: i64 @= 0

        if rc.code >= rc.range
            rc.code @ rc.code - rc.range
            b @ 1
        value @ value << 1 | b
        normalize(@rc, input)

    return value

# A number of `count` bits read through the tree of probabilities at `base`,
# the highest bit first.
function tree(@rc: Range, @probs: [i64], base: i64, count: i64, input: [u8] lent) -> i64
    m: i64 @= 1

    for _ in range(from: 0, to: count)
        m @ m << 1 | bit(@rc, @probs, at: base + m, input: input)

    return m - (1 << count)

# A number of `count` bits read through the tree at `base`, the lowest bit
# first.
function reverse_tree(@rc: Range, @probs: [i64], base: i64, count: i64, input: [u8] lent) -> i64
    m: i64 @= 1
    value: i64 @= 0

    for i in range(from: 0, to: count)
        b = bit(@rc, @probs, at: base + m, input: input)
        m @ m << 1 | b
        value @ value | b << i

    return value

# A repeat's length, 2 to 273, by the length coder at `base`.
function length(@rc: Range, @probs: [i64], base: i64, pos_state: i64, input: [u8] lent) -> i64
    if bit(@rc, @probs, at: base, input: input) == 0
        return 2 + tree(@rc, @probs, base: base + 2 + pos_state * 8, count: 3, input: input)

    if bit(@rc, @probs, at: base + 1, input: input) == 0
        return 10 + tree(@rc, @probs, base: base + 130 + pos_state * 8, count: 3, input: input)
    return 18 + tree(@rc, @probs, base: base + 258, count: 8, input: input)

# A new repeat's distance less one, for a repeat `len` bytes long; 2^32 - 1
# is the end marker.
function distance(@rc: Range, @probs: [i64], size: i64, input: [u8] lent) -> i64
    len_state: i64 @= size - 2

    if len_state > 3
        len_state @ 3
    slot = tree(@rc, @probs, base: POS_SLOT + len_state * 64, count: 6, input: input)

    if slot < 4
        return slot
    footer = (slot >> 1) - 1
    base = (2 | slot & 1) << footer

    if slot < 14
        return base + reverse_tree(@rc, @probs, base: SPEC_POS + base - slot - 1, count: footer, input: input)
    high = direct(@rc, input, count: footer - 4)
    return base + (high << 4) + reverse_tree(@rc, @probs, base: ALIGN, count: 4, input: input)

# What `run` answers: the output reached its target, or the end marker
# came.
constant REACHED: i64
    0

# What `run` answers when the end marker came.
constant MARKED: i64
    1

# Decodes symbols onto `out` until it holds `target` bytes, or, where
# `target` is below 0, until the end marker. The dictionary is `out` from
# `dict_start`; `out` may hold at most `limit` bytes.
function run(@d: Decoder, @rc: Range, input: [u8] lent, @out: [u8], dict_start: i64, target: i64, limit: i64) -> i64?
    lc = d.props.lc
    lp_mask = (1 << d.props.lp) - 1
    pb_mask = (1 << d.props.pb) - 1

    while target < 0 || out.len() < target
        if rc.over > 0
            return codes.invalid_at(at: rc.end, why: "an LZMA stream cut short")
        here = out.len() - dict_start
        pos_state = here & pb_mask
        state = d.state

        if bit(@rc, @d.probs, at: IS_MATCH + state * 16 + pos_state, input: input) == 0
            if out.len() + 1 > limit
                return codes.past_limit(limit: limit, at: rc.pos)
            previous: i64 @= 0

            if here > 0
                previous @ to_i64(out[out.len() - 1]).must()
            base = LITERAL + 768 * ((here & lp_mask) << lc | previous >> 8 - lc)
            symbol: i64 @= 1

            if state >= 7
                back = d.reps[0] + 1

                if back > here
                    return codes.invalid_at(at: rc.pos, why: "a literal matched against a byte before the dictionary")
                matched: i64 @= to_i64(out[out.len() - back]).must()

                while symbol < 0x100
                    match_bit = matched >> 7 & 1
                    matched @ matched << 1
                    b = bit(@rc, @d.probs, at: base + (1 + match_bit << 8) + symbol, input: input)
                    symbol @ symbol << 1 | b

                    if b != match_bit
                        break

            while symbol < 0x100
                symbol @ symbol << 1 | bit(@rc, @d.probs, at: base + symbol, input: input)

            out @ out.push(to_u8(symbol - 0x100).must())

            if state < 4
                d.state @ 0
            else if state < 10
                d.state @ state - 3
            else
                d.state @ state - 6
            continue
        size: i64 @= 0

        if bit(@rc, @d.probs, at: IS_REP + state, input: input) == 0
            size @ length(@rc, @d.probs, base: LEN, pos_state: pos_state, input: input)

            if state < 7
                d.state @ 7
            else
                d.state @ 10
            dist = distance(@rc, @d.probs, size: size, input: input)

            if dist == 0xffffffff
                if rc.over > 0
                    return codes.invalid_at(at: rc.end, why: "an LZMA stream cut short")
                return ok(MARKED)
            d.reps[3] @ d.reps[2]
            d.reps[2] @ d.reps[1]
            d.reps[1] @ d.reps[0]
            d.reps[0] @ dist
        else
            if bit(@rc, @d.probs, at: IS_REP_G0 + state, input: input) == 0
                if bit(@rc, @d.probs, at: IS_REP0_LONG + state * 16 + pos_state, input: input) == 0
                    size @ 1

                    if state < 7
                        d.state @ 9
                    else
                        d.state @ 11
            else
                dist: i64 @= 0

                if bit(@rc, @d.probs, at: IS_REP_G1 + state, input: input) == 0
                    dist @ d.reps[1]
                else
                    if bit(@rc, @d.probs, at: IS_REP_G2 + state, input: input) == 0
                        dist @ d.reps[2]
                    else
                        dist @ d.reps[3]
                        d.reps[3] @ d.reps[2]
                    d.reps[2] @ d.reps[1]
                d.reps[1] @ d.reps[0]
                d.reps[0] @ dist

            if size == 0
                size @ length(@rc, @d.probs, base: REP_LEN, pos_state: pos_state, input: input)

                if state < 7
                    d.state @ 8
                else
                    d.state @ 11
        back = d.reps[0] + 1

        if back > here
            return codes.invalid_at(
                at: rc.pos,
                why: f"a repeat reaching {back} bytes back, where the dictionary holds {here}"
            )

        if target >= 0 && out.len() + size > target
            return codes.invalid_at(at: rc.pos, why: "a repeat past the end of its chunk")

        if out.len() + size > limit
            return codes.past_limit(limit: limit, at: rc.pos)

        for _ in range(from: 0, to: size)
            out @ out.push(out[out.len() - back])

    if rc.over > 0
        return codes.invalid_at(at: rc.end, why: "an LZMA stream cut short")
    return ok(REACHED)
