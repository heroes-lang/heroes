# Streams to test with, made by the `brotli` tool 1.2.1 on this machine
# (2026-11-18) or by hand, written as hexadecimal text; the tool reads each
# as these tests do. Made at a shell; no program calls it. A long output is
# held to its length and its weight, the sum of each byte times its place
# counted from 1, modulo 1,000,000,007, which Python computed.

use bytes

# The text `HELLO` holds.
constant HELLO_TEXT: str
    "The time of the year when the world was young, and the people of the land were free."

# How many bytes `PROSE` and `PROSE_W10` decompress to.
constant PROSE_LENGTH: i64
    3000

# The weight of those bytes.
constant PROSE_WEIGHT: i64
    320138297

# The weight of the 2,000 bytes `SKEW` decompresses to.
constant SKEW_WEIGHT: i64
    47111589

# A stream made by hand: a window of 16 bits, a metadata block of the three
# bytes "abc", and the empty last meta-block; no byte out.
constant METADATA: str
    "2c0161626303"

# `brotli -q 11` of the 84 bytes of `HELLO_TEXT`: words of the static dictionary.
constant HELLO: str
    "a1980200e2489dfadccd8aedae415ce4e624485899631cb03f5ccbe22fb2c7d899c4b164f88915ee41860e39b3b95c84d42a1bd037fa16"

# `brotli -q 11` of the first 3,000 bytes of RFC 7932's text: block switches, context maps and dictionary words; `PROSE_LENGTH` bytes whose weight is `PROSE_WEIGHT`.
constant PROSE: str
    ""

# `brotli -q 5 -w 10` of the same 3,000 bytes: the narrowest window.
constant PROSE_W10: str
    ""

# `brotli -q 9` of 2,000 bytes of every value, most of them small; `SKEW_WEIGHT` their weight.
constant SKEW: str
    ""

# The bytes of a sample's hexadecimal text.
function of(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()

# The bytes of a text.
function text(s: str) -> [u8]
    return bytes.from_text(s)

# The weight of `data`: the sum of each byte times its place counted from 1,
# modulo 1,000,000,007.
function weight(data: [u8] lent) -> i64
    total: i64 @= 0

    for i in range(from: 0, to: data.len())
        total @ (total + (i + 1) * to_i64(data[i]).must()) % 1000000007

    return total

# `data` with byte `at` flipped by `mask`.
function flipped(data: [u8], at: i64, mask: u8) -> [u8]
    changed @= data
    changed[at] @ to_u8(to_i64(changed[at]).must() ^ to_i64(mask).must()).must()
    return changed
