# What the Brotli encoder writes: the window, then meta-blocks of at most
# 1 MiB, each with one block type of each category, one literal tree and one
# distance tree, its commands found greedily along hash chains, the last
# distance named by its code 0 or left implied, every prefix code written by
# its code lengths; a meta-block that would not shrink stored instead; and
# an empty last meta-block.

use compress/brotli/internal/decoder
use compress/brotli/internal/prefix
use compress/brotli/internal/samples
use compress/internal/bitout
use compress/internal/codes
use compress/internal/finder
use compress/internal/huffman

# The most bytes of one meta-block.
constant CHUNK: i64
    1048576

# A command found: so many literals, then a copy; a copy of 0 where the
# meta-block ends after the literals.
record Command
    # How many literals come first.
    insert: i64
    # How many bytes are copied, 4 or more, or 0 for none.
    copy: i64
    # How far back the copy begins.
    distance: i64

# What a command is written as: its insert-and-copy symbol, and its
# distance code, extra bits and their width, the code -1 for none.
record Coded
    # The insert-and-copy symbol.
    symbol: i64
    # The distance code, or -1 where none is written.
    code: i64
    # The distance's extra bits.
    extra: i64
    # How many there are.
    width: i64

# Fails `invalid` where `quality` or `window_bits` is out of its range.
function check_options(quality: i64, window_bits: i64) -> ()?
    if quality < 0 || quality > 11
        return fail(code: codes.INVALID, msg: f"a quality of {quality}, where Brotli's are 0 to 11")

    if window_bits < 10 || window_bits > 24
        return fail(code: codes.INVALID, msg: f"a window of {window_bits} bits, where Brotli's are 10 to 24")
    return ok()

# The insert length code of `n`.
function insert_code(n: i64) -> i64
    c: i64 @= 23

    while decoder.INSERT_BASE[c] > n
        c @ c - 1

    return c

# The copy length code of `n`, 2 or more.
function copy_code(n: i64) -> i64
    c: i64 @= 23

    while decoder.COPY_BASE[c] > n
        c @ c - 1

    return c

# The insert-and-copy symbol of two codes; `implied` where the distance is
# the last one, which only insert codes below 8 and copy codes below 16 say.
function command_symbol(insert: i64, copy: i64, implied: bool) -> i64
    low = (insert & 7) << 3 | copy & 7

    if implied
        if copy < 8
            return low
        return 64 + low
    cells: [i64] = [128, 192, 384, 256, 320, 512, 448, 576, 640]
    return cells[(insert >> 3) * 3 + (copy >> 3)] + low

# The index of the highest 1 of `x`, 1 or more.
function top_bit(x: i64) -> i64
    n: i64 @= 0

    while x >> n + 1 > 0
        n @ n + 1

    return n

# Writes the code length code length `v`, 0 to 5, in its fixed code.
function put_length_length(@out: [u8], @sink: bitout.Sink, v: i64)
    values: [i64] = [0, 7, 3, 2, 1, 15]
    widths: [i64] = [2, 4, 3, 2, 2, 4]
    bitout.put(@out, @sink, value: values[v], count: widths[v])

# Writes the prefix code of `lengths` over an alphabet of `size` symbols:
# simple where one symbol or none has a code, else by its code lengths.
function put_code(@out: [u8], @sink: bitout.Sink, lengths: [i64] lent, size: i64)
    used: i64 @= 0
    one: i64 @= 0
    last: i64 @= 0

    for s in range(from: 0, to: lengths.len())
        if lengths[s] > 0
            used @ used + 1
            one @ s
            last @ s

    if used <= 1
        bitout.put(@out, @sink, value: 1, count: 2)
        bitout.put(@out, @sink, value: 0, count: 2)
        bitout.put(@out, @sink, value: one, count: prefix.alphabet_bits(size))
        return
    items: [i64] @= []
    extras: [i64] @= []
    i: i64 @= 0

    while i <= last
        if lengths[i] != 0
            items @ items.push(lengths[i])
            extras @ extras.push(0)
            i @ i + 1
            continue
        run: i64 @= 0

        while i + run <= last && lengths[i + run] == 0
            run @ run + 1

        if run < 3
            for _ in range(from: 0, to: run)
                items @ items.push(0)
                extras @ extras.push(0)
        else
            digits: [i64] @= []
            u: i64 @= run - 2

            while u > 0
                d = (u - 1) % 8 + 1
                digits @ digits.push(d - 1)
                u @ (u - d) / 8

            k: i64 @= digits.len() - 1

            while k >= 0
                items @ items.push(17)
                extras @ extras.push(digits[k])
                k @ k - 1

        i @ i + run

    counts: [i64] @= prefix.zeros(18)

    for s in items
        counts[s] @ counts[s] + 1

    inner = huffman.lengths_for(counts, limit: 5)
    inner_codes = huffman.codes_for(inner)
    bitout.put(@out, @sink, value: 0, count: 2)
    space: i64 @= 32

    for k in range(from: 0, to: 18)
        v = inner[prefix.ORDER[k]]
        put_length_length(@out, @sink, v: v)

        if v != 0
            space @ space - (32 >> v)

            if space <= 0
                break

    for k in range(from: 0, to: items.len())
        s = items[k]
        bitout.put(@out, @sink, value: inner_codes[s], count: inner[s])

        if s == 17
            bitout.put(@out, @sink, value: extras[k], count: 3)

# The commands of `data` from `from` to `to`, found along the chains of `f`.
function commands_of(data: [u8] lent, from: i64, to: i64, @f: finder.Finder) -> [Command]
    found: [Command] @= []
    pos: i64 @= from
    literal_start: i64 @= from

    while pos < to
        finder.insert_upto(@f, data: data, upto: pos)
        best = finder.longest(f, data: data, at: pos, most: to - pos)

        if best.length >= 4
            found @ found.push(Command(insert: pos - literal_start, copy: best.length, distance: best.distance))
            pos @ pos + best.length
            literal_start @ pos
        else
            pos @ pos + 1

    finder.insert_upto(@f, data: data, upto: to)

    if literal_start < to
        found @ found.push(Command(insert: to - literal_start, copy: 0, distance: 0))
    return found

# Each command's symbol and distance code, the last distances moved on as
# the decoder will move them.
function coded_of(found: [Command] lent, @distances: [i64]) -> [Coded]
    made: [Coded] @= []

    for c in found
        ic = insert_code(c.insert)

        if c.copy == 0
            made @ made.push(
                Coded(symbol: command_symbol(insert: ic, copy: 0, implied: false), code: -1, extra: 0, width: 0)
            )
            continue
        cc = copy_code(c.copy)

        if c.distance == distances[0]
            if ic < 8 && cc < 16
                made @ made.push(
                    Coded(symbol: command_symbol(insert: ic, copy: cc, implied: true), code: -1, extra: 0, width: 0)
                )
            else
                made @ made.push(
                    Coded(symbol: command_symbol(insert: ic, copy: cc, implied: false), code: 0, extra: 0, width: 0)
                )
            continue
        shifted = c.distance + 3
        width = top_bit(shifted) - 1
        high = shifted >> width & 1
        code = 16 + 2 * (width - 1) + high
        made @ made.push(
            Coded(symbol: command_symbol(insert: ic, copy: cc, implied: false), code: code, extra: shifted - (2 + high << width), width: width)
        )
        distances[3] @ distances[2]
        distances[2] @ distances[1]
        distances[1] @ distances[0]
        distances[0] @ c.distance

    return made

# Writes a meta-block's header: not last, its length, stored or not.
function put_header(@out: [u8], @sink: bitout.Sink, length: i64, stored: bool)
    nibbles: i64 @= 4

    if length - 1 >= 1 << 20
        nibbles @ 6
    else if length - 1 >= 1 << 16
        nibbles @ 5
    bitout.put(@out, @sink, value: 0, count: 1)
    bitout.put(@out, @sink, value: nibbles - 4, count: 2)
    bitout.put(@out, @sink, value: length - 1, count: 4 * nibbles)

    if stored
        bitout.put(@out, @sink, value: 1, count: 1)
        bitout.align(@out, @sink)
    else
        bitout.put(@out, @sink, value: 0, count: 1)

# Writes the compressed meta-block of `data` from `from` to `to`.
function put_compressed(@out: [u8], @sink: bitout.Sink, data: [u8] lent, from: i64, found: [Command] lent, made: [Coded] lent)
    lit_counts @= prefix.zeros(256)
    cmd_counts @= prefix.zeros(704)
    dst_counts @= prefix.zeros(64)
    p: i64 @= from

    for k in range(from: 0, to: found.len())
        for i in range(from: p, to: p + found[k].insert)
            v = to_i64(data[i]).must()
            lit_counts[v] @ lit_counts[v] + 1

        p @ p + found[k].insert + found[k].copy
        s = made[k].symbol
        cmd_counts[s] @ cmd_counts[s] + 1

        if made[k].code >= 0
            d = made[k].code
            dst_counts[d] @ dst_counts[d] + 1

    lit_lengths = huffman.lengths_for(lit_counts, limit: 15)
    cmd_lengths = huffman.lengths_for(cmd_counts, limit: 15)
    dst_lengths = huffman.lengths_for(dst_counts, limit: 15)
    lit_codes = huffman.codes_for(lit_lengths)
    cmd_codes = huffman.codes_for(cmd_lengths)
    dst_codes = huffman.codes_for(dst_lengths)
    put_header(@out, @sink, length: p - from, stored: false)
    bitout.put(@out, @sink, value: 0, count: 3)
    bitout.put(@out, @sink, value: 0, count: 8)
    bitout.put(@out, @sink, value: 0, count: 2)
    put_code(@out, @sink, lengths: lit_lengths, size: 256)
    put_code(@out, @sink, lengths: cmd_lengths, size: 704)
    put_code(@out, @sink, lengths: dst_lengths, size: 64)
    p @ from

    for k in range(from: 0, to: found.len())
        c = found[k]
        m = made[k]
        bitout.put(@out, @sink, value: cmd_codes[m.symbol], count: cmd_lengths[m.symbol])
        ic = insert_code(c.insert)
        bitout.put(@out, @sink, value: c.insert - decoder.INSERT_BASE[ic], count: decoder.INSERT_EXTRA[ic])
        cc: i64 @= 0

        if c.copy > 0
            cc @ copy_code(c.copy)
            bitout.put(@out, @sink, value: c.copy - decoder.COPY_BASE[cc], count: decoder.COPY_EXTRA[cc])

        for i in range(from: p, to: p + c.insert)
            v = to_i64(data[i]).must()
            bitout.put(@out, @sink, value: lit_codes[v], count: lit_lengths[v])

        if m.code >= 0
            bitout.put(@out, @sink, value: dst_codes[m.code], count: dst_lengths[m.code])
            bitout.put(@out, @sink, value: m.extra, count: m.width)
        p @ p + c.insert + c.copy

# `data` as one Brotli stream with a window of `window_bits` bits, searched
# as hard as `quality` says; quality 0 stores every meta-block.
function stream(data: [u8] lent, quality: i64, window_bits: i64) -> [u8]
    out: [u8] @= []
    sink @= bitout.empty()

    if window_bits == 16
        bitout.put(@out, @sink, value: 0, count: 1)
    else if window_bits == 17
        bitout.put(@out, @sink, value: 1, count: 7)
    else if window_bits > 17
        bitout.put(@out, @sink, value: 1 | window_bits - 17 << 1, count: 4)
    else
        bitout.put(@out, @sink, value: 1 | window_bits - 8 << 4, count: 7)
    window = (1 << window_bits) - 16
    chains: [i64] = [0, 4, 8, 16, 24, 32, 48, 64, 96, 128, 256, 512]
    f @= finder.start(size: data.len(), window: window, shortest: 4, chain: chains[quality], nice: 258)
    distances: [i64] @= [4, 11, 15, 16]
    from: i64 @= 0

    while from < data.len()
        to: i64 @= from + CHUNK

        if to > data.len()
            to @ data.len()
        tried: [u8] @= []
        tried_sink @= sink

        if quality > 0
            found = commands_of(data, from: from, to: to, f: @f)
            moved: [i64] @= distances
            made = coded_of(found, distances: @moved)
            put_compressed(out: @tried, sink: @tried_sink, data: data, from: from, found: found, made: made)

            if tried.len() < to - from
                for b in tried
                    out @ out.push(b)

                sink @ tried_sink
                distances @ moved
                from @ to
                continue
        put_header(@out, @sink, length: to - from, stored: true)

        for i in range(from: from, to: to)
            out @ out.push(data[i])

        from @ to

    bitout.put(@out, @sink, value: 3, count: 2)
    bitout.align(@out, @sink)
    return out

test "command_symbol: an implied distance, and each cell"
    assert command_symbol(insert: 0, copy: 0, implied: true) == 0
    assert command_symbol(insert: 7, copy: 15, implied: true) == 127
    assert command_symbol(insert: 0, copy: 0, implied: false) == 128
    assert command_symbol(insert: 23, copy: 23, implied: false) == 703
    assert command_symbol(insert: 8, copy: 16, implied: false) == 512

test "insert_code and copy_code: each side of a base"
    assert insert_code(5) == 5 && insert_code(6) == 6 && insert_code(7) == 6 && insert_code(22594) == 23
    assert copy_code(2) == 0 && copy_code(9) == 7 && copy_code(10) == 8 && copy_code(2118) == 23

test "stream: round trips at every quality and the windows' edges, and bytes no repeat shrinks"
    text = samples.text(
        "ground control to major tom, ground control to major tom; été, ☃, and more text to repeat, to repeat"
    )
    runs: [u8] @= []

    for i in range(from: 0, to: 5000)
        runs @ runs.push(to_u8(i / 900 % 3 * 100).must())

    noise: [u8] @= []
    x: i64 @= 12345

    for _ in range(from: 0, to: 20000)
        x @ (x * 1103515245 + 12345) % 2147483648
        noise @ noise.push(to_u8(x >> 16 & 255).must())

    nothing: [u8] = []

    for data in [nothing, [0x61], text, runs, noise]
        for quality in [0, 1, 6, 11]
            for bits in [10, 16, 17, 22, 24]
                assert decoder.stream(stream(data, quality: quality, window_bits: bits), limit: data.len()).must().data == data

test "check_options: a quality and a window out of range"
    for bad in [-1, 12]
        match check_options(quality: bad, window_bits: 22)
            .ok _  => assert false
            .err e => assert e.code == "invalid"

    for bad in [9, 25]
        match check_options(quality: 5, window_bits: bad)
            .ok _  => assert false
            .err e => assert e.code == "invalid"
