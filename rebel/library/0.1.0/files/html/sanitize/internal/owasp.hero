test "OWASP: the cheat sheet's fenced vectors, their no-break spaces read as spaces, 68"
    vectors = [
        Vector(text: "<IMG \"\"\"><SCRIPT>alert(\"XSS\")</SCRIPT>\"\\>", ugc: "<img>\"\\&gt;")
        Vector(text: "perl -e 'print \"<IMG SRC=java\\0script:alert(\\\"XSS\\\")>\";' > out", ugc: "perl -e 'print \"<img>\";' &gt; out")
        Vector(text: "<SCRIPT/XSS SRC=\"http://xss.rocks/xss.js\"></SCRIPT>", ugc: "")
        Vector(text: "<BODY onload!#$%&()*~+-_.,:;?@[/|\\]^`=alert(\"XSS\")>", ugc: "")
        Vector(text: "<SCRIPT SRC=http://xss.rocks/xss.js?< B >", ugc: "")
        Vector(text: "<SCRIPT SRC=//xss.rocks/.j>", ugc: "")
        Vector(text: "<IMG SRC=\"`<javascript:alert>`('XSS')\"", ugc: "")
        Vector(text: "<INPUT TYPE=\"IMAGE\" SRC=\"javascript:alert('XSS');\">", ugc: "")
        Vector(text: "<BODY BACKGROUND=\"javascript:alert('XSS')\">", ugc: "")
        Vector(text: "<IMG DYNSRC=\"javascript:alert('XSS')\">", ugc: "<img>")
        Vector(text: "<IMG LOWSRC=\"javascript:alert('XSS')\">", ugc: "<img>")
        Vector(text: "<STYLE>li {list-style-image: url(\"javascript:alert('XSS')\");}</STYLE><UL><LI>XSS</br>", ugc: "<ul><li>XSS<br></li></ul>")
        Vector(text: "<IMG SRC='vbscript:msgbox(\"XSS\")'>", ugc: "<img>")
        Vector(text: "<BODY ONLOAD=alert('XSS')>", ugc: "")
        Vector(text: "<BR SIZE=\"&{alert('XSS')}\">", ugc: "<br>")
        Vector(text: "<LINK REL=\"stylesheet\" HREF=\"http://xss.rocks/xss.css\">", ugc: "")
        Vector(text: "<IMG STYLE=\"xss:expr/*XSS*/ession(alert('XSS'))\">", ugc: "<img>")
