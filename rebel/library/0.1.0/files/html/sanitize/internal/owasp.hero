# The XSS vectors of OWASP's XSS Filter Evasion Cheat Sheet, every one a
# test: the cheat sheet's Markdown (github.com/OWASP/CheatSheetSeries,
# `cheatsheets/XSS_Filter_Evasion_Cheat_Sheet.md`, fetched 2026-11-17, its
# SHA-256 beginning `7e298e2905c7c4ad`), each fenced block as it is written,
# again with its no-break spaces read as the spaces they stand for and with the
# backslashes its Markdown adds taken out, every string of its lists of
# firewall bypasses and of obfuscations of `alert`, every event handler of its
# list on a paragraph, and every one of its ways of writing `<` around a
# script: 395 vectors.
#
# Each is cleaned by the three ready policies. Under each, the answer cleaned
# again is the same bytes, and read as a browser reads it the answer holds no
# element the policy does not keep, no event handler, no `srcdoc`, no `style`,
# no comment, and no URL whose scheme a browser reads as other than `http`,
# `https` or `mailto`; that reading is this module's own, written apart from
# the package's. Under the policy for user-generated content the answer is
# pinned: each is the answer nh3 0.3.8 (Rust's ammonia 4) gives with the same
# lists of elements, attributes and schemes, once both write a quotation mark
# and a no-break space alike, but where nh3 adds a `rel` to a link that has no
# `href` and keeps four relative URLs that `url` cannot read, which this
# package takes out (the ledger's note). Every answer was also read by Go's
# `golang.org/x/net/html`, which wrote back the same tree.
#
# Beside them, 47 shapes of mutation XSS gathered for this package (namespace
# confusion, raw text, comments and instructions) are held to the same
# reading, with no answer pinned.
#
# Nothing here is compiled into a program but the functions and the record
# below; the vectors live in the tests.

use html
use html/sanitize/internal/ready
use html/sanitize/internal/rules
use html/sanitize/internal/walk
use strings

# The cheat sheet the vectors were taken from, and the beginning of its
# SHA-256.
constant SOURCE: str
    "XSS_Filter_Evasion_Cheat_Sheet.md sha256 7e298e2905c7c4ad"

# One vector and what the policy for user-generated content answers.
record Vector
    # The vector, as the cheat sheet writes it.
    text: str
    # The answer of `ready.ugc()`.
    ugc: str

# The scheme a browser reads in the URL `value`, in lower case, written apart
# from the package's own reading: tabs and line breaks taken out, everything
# up to 32 cut from both ends, then a letter and letters, digits, `+`, `-` or
# `.` before a `:`; empty where there is none.
function scheme_seen(value: str) -> str
    pieces: [str] @= []

    for c in value.chars()
        if c != "\t" && c != "\n" && c != "\r"
            pieces @ pieces.push(c)

    form = pieces.join("")
    first: i64 @= 0

    while first < form.len() && form[first] <= 32
        first @ first + 1

    at: i64 @= first

    while at < form.len()
        b = form[at]
        is_letter = b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z'

        if b == ':' && at > first
            return strings.to_lower_ascii(form.slice(from: first, to: at))

        if !(is_letter || at > first && (b >= '0' && b <= '9' || b == '+' || b == '-' || b == '.'))
            return ""
        at @ at + 1

    return ""

# Whether `text`, read as a browser reads it inside the context of `r`, holds
# only what `r` keeps: no element `r` does not allow, no attribute that is an
# event handler, `srcdoc` or `style`, no comment, and no URL of a scheme other
# than `http`, `https` and `mailto`.
function is_inert(r: rules.Rules, text: str) -> bool
    doc = html.parse_fragment(text: text, context: r.context)

    for n in html.descendants(doc, html.ROOT)
        match html.node_of(doc, n)
            .element e =>
                space = match e.space
                    .html   => rules.HTML
                    .svg    => rules.SVG
                    .mathml => rules.MATHML

                if rules.action_of(r, space, e.name) != rules.ALLOW
                    return false

                for a in e.attributes
                    lower = a.name

                    if lower.len() >= 2 && (lower[0] == 'o' || lower[0] == 'O') && (lower[1] == 'n' || lower[1] == 'N')
                        return false

                    if lower == "srcdoc" || lower == "style"
                        return false

                    if lower == "href" || lower == "src" || lower == "cite" || lower == "action" || lower == "formaction" || lower == "background" || lower == "poster" || lower == "lowsrc" || lower == "dynsrc" || lower == "data"
                        seen = scheme_seen(a.value)

                        if !(seen == "" || seen == "http" || seen == "https" || seen == "mailto")
                            return false
            .comment _                                                    => return false
            .document | .fragment | .doctype _ | .text _ | .instruction _ => _ = 0

    return true

# Whether every policy keeps `text` inert and cleans its answer to the same
# bytes, and the policy for user-generated content answers `ugc`.
function holds(v: Vector) -> bool
    for r in [ready.ugc(), rules.empty(), ready.rich_text()]
        once = walk.cleaned_text(r, v.text)

        if walk.cleaned_text(r, once) != once || !is_inert(r, once)
            return false

    return walk.cleaned_text(ready.ugc(), v.text) == v.ugc

# Whether every ready policy keeps `text` inert and cleans its answer to the
# same bytes, with no answer pinned.
function settles(text: str) -> bool
    for r in [ready.ugc(), rules.empty(), ready.rich_text()]
        once = walk.cleaned_text(r, text)

        if walk.cleaned_text(r, once) != once || !is_inert(r, once)
            return false

    return true

