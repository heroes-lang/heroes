# Mutation XSS: the shapes that change meaning once written and read again,
# namespace confusion between HTML, SVG and MathML and the elements whose text
# is read as it is, gathered for this package and not from the cheat sheet.
test "mutation XSS: 47 shapes of namespace confusion and raw text, each settled and inert"
    shapes = [
        "<svg></p><style><a id=\"</style><img src=1 onerror=alert(1)>\">"
        "<math><mtext><table><mglyph><style><img src=x onerror=alert(1)>"
        "<form><math><mtext></form><form><mglyph><style></math><img src onerror=alert(1)>"
        "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\">"
        "<svg><style><img src=x onerror=alert(1)></style></svg>"
        "<math><style><img src=x onerror=alert(1)></style></math>"
        "<template><style></template><img src=x onerror=alert(1)></style>"
        "<textarea></textarea><img src=x onerror=alert(1)>"
        "<!--><img src=x onerror=alert(1)>-->"
        "<a title=\"--><img src=x onerror=alert(1)>\">x</a>"
        "<xmp><img src=x onerror=alert(1)></xmp>"
        "<svg><![CDATA[><img src=x onerror=alert(1)>]]></svg>"
        "<table><a href=\"javascript:x\">t</a></table>"
        "<select><style><img src=x onerror=alert(1)></style></select>"
        "<math><annotation-xml encoding=\"text/html\"><style><img src=x onerror=alert(1)>"
        "<svg><foreignObject><p><style><img src=x onerror=alert(1)>"
        "<svg><desc><svg><style><img src=x onerror=alert(1)>"
        "<math><mi><svg><style>&lt;/style&gt;&lt;img src=x onerror=alert(1)&gt;</style></svg></mi></math>"
        "<svg><title><style><img src=x onerror=alert(1)>"
        "<noembed><img title=\"</noembed><img src=x onerror=alert(1)>\"></noembed>"
        "<noframes><img title=\"</noframes><img src=x onerror=alert(1)>\"></noframes>"
        "<plaintext><img src=x onerror=alert(1)>"
        "<listing>&lt;img src=x onerror=alert(1)&gt;</listing>"
        "<title><img src=x onerror=alert(1)></title>"
        "<svg><a href=\"javascript:alert(1)\"><text>x</text></a></svg>"
        "<svg><a xlink:href=\"javascript:alert(1)\"><text>x</text></a></svg>"
        "<math href=\"javascript:alert(1)\"><mi>x</mi></math>"
        "<svg><animate attributeName=\"href\" values=\"javascript:alert(1)\"/><a><text>x</text></a></svg>"
        "<svg><set attributeName=\"onmouseover\" to=\"alert(1)\"/></svg>"
        "<svg><use href=\"data:image/svg+xml,<svg id='x' xmlns='http://www.w3.org/2000/svg'><image href='1' onerror='alert(1)'/></svg>#x\"/></svg>"
        "<form><button formaction=\"javascript:alert(1)\">x</button></form>"
        "<img src=x srcset=\"javascript:alert(1) 1x\">"
        "<!--[if IE]><script>alert(1)</script><![endif]-->"
        "<!-- a --!><img src=x onerror=alert(1)>-->"
        "<?xml version=\"1.0\"?><img src=x onerror=alert(1)>"
        "<?x a><img src=x onerror=alert(1)>?>"
        "<div id=\"x\"></div><style>@import 'javascript:alert(1)';</style>"
        "<img src=\"java&#x0D;script:alert(1)\">"
        "<svg><foreignObject><math><mi><mglyph><svg><mtext><textarea><path id=\"</textarea><img onerror=alert(1) src=1>\">"
        "<math><mtext><h1><a><h6></a></h6><mglyph><svg><mtext><style><a title=\"</style><img src onerror=alert(1)>\"></style></h1>"
        "<svg><p><style><img src=x onerror=alert(1)></style></p></svg>"
        "<table><tbody><tr><td><svg><style><img src=x onerror=alert(1)>"
        "<a href=\"\u{1}javascript:alert(1)\">x</a>"
        "<a href=\"javascript&colon;alert(1)\">x</a>"
        "<a href=\"&#x6A;avascript:alert(1)\">x</a>"
        "<a href=\"JaVaScRiPt:alert(1)\">x</a>"
        "<a href=\"  javascript:alert(1)\">x</a>"
    ]

    for s in shapes
        assert settles(s)

test "scheme_seen: a scheme behind controls, tabs in it, a relative path and a digit first"
    assert scheme_seen(" \u{1}JaVa\tscript:x") == "javascript" && scheme_seen("/a:b") == "" && scheme_seen("1a:b") == "" && scheme_seen(":x") == ""
