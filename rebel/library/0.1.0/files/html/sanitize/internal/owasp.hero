test "OWASP: the cheat sheet's fenced vectors, the backslashes of its Markdown taken out, 7"
    vectors = [
        Vector(text: "<a onmouseover=\"alert(document.cookie)\">xxs link</a>", ugc: "<a>xxs link</a>")
        Vector(text: "<a onmouseover=alert(document.cookie)>xxs link</a>", ugc: "<a>xxs link</a>")
        Vector(text: "<IMG \"\"\"><SCRIPT>alert(\"XSS\")</SCRIPT>\">", ugc: "<img>\"&gt;")
        Vector(text: "<BODY onload!#$%&()*~+-_.,:;?@[/|]^`=alert(\"XSS\")>", ugc: "")
        Vector(text: "<<SCRIPT>alert(\"XSS\");//<</SCRIPT>", ugc: "&lt;")
        Vector(text: "<script> ... setTimeout(\\\\\"writetitle()\\\\\",$_GET[xss]) ... </script>", ugc: "")
        Vector(text: "<script> ... eval($_GET[xss]); ... </script>", ugc: "")
    ]

    for v in vectors
        assert holds(v)

test "OWASP: the strings that bypass a firewall, and the obfuscations of `alert`, 36"
