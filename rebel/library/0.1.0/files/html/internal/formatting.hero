# The list of active formatting elements (13.2.4.3) and the adoption agency
# algorithm (13.2.6.4.7): how `<b><p></b>` and `<a><table><a>` are mended.
# Every step works on indices into the builder's two lists, and the
# algorithm's loops are bounded as the standard bounds them, 8 and 3.

use html/internal/builder
use html/internal/dom
use html/internal/insert
use html/internal/token

# Puts a marker at the end of the list.
function push_marker(@b: builder.Builder)
    put_entry(@b, at: b.formatting_count, entry: builder.MARKER, ticket: -1, kind: "")
    b.markers @ b.markers + 1

# Puts `node` at the end of the list, after taking out the earliest of three
# alike after the last marker, the Noah's Ark clause. The entries of each
# kind are kept by number, so no push walks the list: the earliest is found
# where its number says and left `GONE` in its place, and the list is
# compacted once those are more than half of it.
function push_element(@b: builder.Builder, node: i64)
    kind = kind_of(b.tree, node: node, markers: b.markers)
    none: [i64] = []
    same: [i64] @= b.alike[kind].default(none)

    if same.len() >= 3
        at = b.slots[same[0]]
        b.formatting[at] @ builder.GONE
        b.tickets[at] @ -1
        b.kinds[at] @ ""
        b.gone @ b.gone + 1
        same @ same.slice(from: 1, to: same.len())
    ticket = fresh_ticket(@b)
    same @ same.push(ticket)
    b.alike[kind] @ same
    put_entry(@b, at: b.formatting_count, entry: node, ticket: ticket, kind: kind)

    if b.gone > 8 && b.gone * 2 > b.formatting_count
        compact(@b)

# What makes the element `node` alike to another for the Noah's Ark clause:
# its name, its namespace and its attributes whatever their order, and the
# count of markers before it, so that no entry before the last marker is
# ever alike to one after it. Every part is written with its length, so two
# kinds are one text only where they are one kind.
function kind_of(t: dom.Tree lent, node: i64, markers: i64) -> str
    pieces: [str] @= []

    for a in t.attributes[node]
        pieces @ pieces.push(f"{a.space} {a.name.len()}:{a.name}{a.value.len()}:{a.value}")

    name = t.names[node]
    return f"{markers} {t.spaces[node]} {name.len()}:{name}" + sort(pieces).join("")

# A number no entry has had, its place still to be written.
function fresh_ticket(@b: builder.Builder) -> i64
    ticket = b.slots.len()
    dom.append(items: @b.slots, item: -1)
    return ticket

# Puts `entry`, numbered `ticket` and of `kind`, into the list at `at`, the
# entries from `at` moving one later.
function put_entry(@b: builder.Builder, at: i64, entry: i64, ticket: i64, kind: str)
    if b.formatting_count == b.formatting.len()
        dom.append(items: @b.formatting, item: entry)
        dom.append(items: @b.tickets, item: ticket)
        dom.append(items: @b.kinds, item: kind)
    i: i64 @= b.formatting_count

    while i > at
        place(@b, from: i - 1, to: i)
        i @ i - 1

    b.formatting[at] @ entry
    b.tickets[at] @ ticket
    b.kinds[at] @ kind

    if ticket >= 0
        b.slots[ticket] @ at
    b.formatting_count @ b.formatting_count + 1

# Moves the entry at `from` to `to`, with its number and its kind.
function place(@b: builder.Builder, from: i64, to: i64)
    ticket = b.tickets[from]
    b.formatting[to] @ b.formatting[from]
    b.tickets[to] @ ticket
    b.kinds[to] @ b.kinds[from]

    if ticket >= 0
        b.slots[ticket] @ to

# Takes the entry at `at` out of the list, and out of its kind's.
function remove_entry(@b: builder.Builder, at: i64)
    entry = b.formatting[at]

    if entry == builder.GONE
        b.gone @ b.gone - 1
    else if entry == builder.MARKER
        b.markers @ b.markers - 1
    else
        forget(@b, kind: b.kinds[at], ticket: b.tickets[at])
    i: i64 @= at

    while i < b.formatting_count - 1
        place(@b, from: i + 1, to: i)
        i @ i + 1

    b.formatting_count @ b.formatting_count - 1

# Takes the number `ticket` out of the entries of `kind`.
function forget(@b: builder.Builder, kind: str, ticket: i64)
    none: [i64] = []
    kept: [i64] @= []

    for t in b.alike[kind].default(none)
        if t != ticket
            kept @ kept.push(t)

    b.alike[kind] @ kept

# Puts the number `ticket` among the entries of `kind`, in the list's order.
function remember(@b: builder.Builder, kind: str, ticket: i64)
    none: [i64] = []
    placed: [i64] @= []
    put: bool @= false

    for t in b.alike[kind].default(none)
        if !put && b.slots[t] > b.slots[ticket]
            placed @ placed.push(ticket)
            put @ true
        placed @ placed.push(t)

    if !put
        placed @ placed.push(ticket)
    b.alike[kind] @ placed

# Takes the `GONE` entries out of the list, the others keeping their order.
# It runs once they are more than half of it, so each walk is paid for by
# the pushes that left them.
function compact(@b: builder.Builder)
    kept: i64 @= 0
    at: i64 @= 0

    while at < b.formatting_count
        if b.formatting[at] != builder.GONE
            if kept != at
                place(@b, from: at, to: kept)
            kept @ kept + 1
        at @ at + 1

    b.formatting_count @ kept
    b.gone @ 0

# The index of `node` in the list, or -1.
function index_of_entry(b: builder.Builder lent, node: i64) -> i64
    i: i64 @= b.formatting_count - 1

    while i >= 0
        if b.formatting[i] == node
            return i
        i @ i - 1

    return -1

# The last entry after the last marker that is an HTML element named `name`,
# or -1.
function last_named(b: builder.Builder lent, name: str) -> i64
    i: i64 @= b.formatting_count - 1

    while i >= 0 && b.formatting[i] != builder.MARKER
        if b.formatting[i] != builder.GONE && dom.is_html(b.tree, b.formatting[i], name)
            return i
        i @ i - 1

    return -1

# Clears the list up to and including the last marker.
function clear_to_marker(@b: builder.Builder)
    while b.formatting_count > 0
        b.formatting_count @ b.formatting_count - 1
        at = b.formatting_count
        entry = b.formatting[at]

        if entry == builder.MARKER
            b.markers @ b.markers - 1
            return

        if entry == builder.GONE
            b.gone @ b.gone - 1
        else
            forget(@b, kind: b.kinds[at], ticket: b.tickets[at])

# A new HTML element like `node`, its name and attributes, held by nothing.
function copy_of(@b: builder.Builder, node: i64) -> i64
    return insert.create(@b, space: dom.HTML, name: b.tree.names[node], attributes: b.tree.attributes[node])

# Whether the entry `entry` stops reconstruction's rewind: a marker, or an
# element open on the stack. A `GONE` entry does not.
function stops_rewind(b: builder.Builder lent, entry: i64) -> bool
    return entry == builder.MARKER || entry != builder.GONE && builder.index_in_stack(b, entry) >= 0

# Reconstructs the active formatting elements: every entry after the last
# marker that is not open is opened again, in order, an entry `GONE` passed
# over. A copy takes its entry's place, number and kind.
function reconstruct(@b: builder.Builder)
    last: i64 @= b.formatting_count - 1

    while last >= 0 && b.formatting[last] == builder.GONE
        last @ last - 1

    if last < 0 || stops_rewind(b, b.formatting[last])
        return
    at: i64 @= last

    while at > 0 && !stops_rewind(b, b.formatting[at - 1])
        at @ at - 1

    while at < b.formatting_count
        entry = b.formatting[at]

        if entry != builder.GONE
            made = insert.element_for(
                @b,
                token.tag(kind: token.START, name: b.tree.names[entry], attributes: b.tree.attributes[entry], at: 0),
                dom.HTML
            )
            b.formatting[at] @ made
        at @ at + 1

# Puts `node` into the stack at `at`, the entries from `at` moving one up.
function insert_in_stack(@b: builder.Builder, at: i64, node: i64)
    builder.push_open(@b, node)
    i: i64 @= b.depth - 1

    while i > at
        b.open[i] @ b.open[i - 1]
        i @ i - 1

    b.open[at] @ node

# Runs the adoption agency algorithm for the end tag, or the `a` or `nobr`
# start tag, `t`. True where it asks the caller to act as "any other end
# tag" does.
function adopt(@b: builder.Builder, t: token.Token lent) -> bool
    subject = t.name
    current = builder.current(b)

    if dom.is_html(b.tree, current, subject) && index_of_entry(b, current) < 0
        builder.pop(@b)
        return false
    outer: i64 @= 0

    while outer < 8
        outer @ outer + 1
        found = last_named(b, subject)

        if found < 0
            return true
        element = b.formatting[found]
        in_stack = builder.index_in_stack(b, element)

        if in_stack < 0
            builder.error(@b, "misnested-tag", t)
            remove_entry(@b, found)
            return false

        if !builder.node_in_scope(b, target: element, kind: builder.SCOPE)
            builder.error(@b, "misnested-tag", t)
            return false

        if element != builder.current(b)
            builder.error(@b, "misnested-tag", t)
        furthest: i64 @= -1

        for k in range(from: in_stack + 1, to: b.depth)
            if builder.is_special(b.tree, b.open[k])
                furthest @ k
                break

        if furthest < 0
            builder.truncate(@b, in_stack)
            remove_entry(@b, found)
            return false
        block = b.open[furthest]
        common = b.open[in_stack - 1]
        bookmark: i64 @= found
        moved: bool @= false
        node_at: i64 @= furthest
        last: i64 @= block
        inner: i64 @= 0

        while true
            inner @ inner + 1
            node_at @ node_at - 1
            node = b.open[node_at]

            if node == element
                break
            entry: i64 @= index_of_entry(b, node)

            if inner > 3 && entry >= 0
                remove_entry(@b, entry)

                if entry < bookmark
                    bookmark @ bookmark - 1
                entry @ -1

            if entry < 0
                builder.remove_from_stack(@b, node)
                continue
            made = copy_of(@b, node)
            b.formatting[entry] @ made
            b.open[node_at] @ made

            if !moved
                bookmark @ entry + 1
                moved @ true
            dom.detach(@b.tree, last)
            dom.append_child(@b.tree, parent: made, child: last)
            last @ made

        dom.detach(@b.tree, last)
        insert.put(@b, node: last, place: insert.appropriate_place(b, common))
        made = copy_of(@b, element)
        child: i64 @= b.tree.firsts[block]

        while child != dom.NONE
            next = b.tree.nexts[child]

            if b.tree.kinds[child] != dom.FRAGMENT
                dom.detach(@b.tree, child)
                dom.append_child(@b.tree, parent: made, child: child)
            child @ next

        dom.append_child(@b.tree, parent: block, child: made)
        old = index_of_entry(b, element)
        kind = b.kinds[old]
        remove_entry(@b, old)

        if old < bookmark
            bookmark @ bookmark - 1
        ticket = fresh_ticket(@b)
        put_entry(@b, at: bookmark, entry: made, ticket: ticket, kind: kind)
        remember(@b, kind: kind, ticket: ticket)
        builder.remove_from_stack(@b, element)
        insert_in_stack(@b, at: builder.index_in_stack(b, block) + 1, node: made)

    return false

## Tests

# The entries of the list in order, those taken out left out: the list as
# the standard reads it.
function live(b: builder.Builder lent) -> [i64]
    held: [i64] @= []

    for at in range(from: 0, to: b.formatting_count)
        if b.formatting[at] != builder.GONE
            held @ held.push(b.formatting[at])

    return held

test "push_element: the fourth of three alike after the last marker drops the earliest, a cleared marker's kinds forgotten"
    b: builder.Builder @= builder.start(scripting: true, max_depth: 512)
    nodes: [i64] @= []

    for _ in range(from: 0, to: 4)
        nodes @ nodes.push(insert.create(@b, space: dom.HTML, name: "b", attributes: []))

    for n in nodes
        push_element(@b, n)

    assert live(b) == [nodes[1], nodes[2], nodes[3]]
    push_marker(@b)
    push_element(@b, nodes[0])
    assert live(b) == [nodes[1], nodes[2], nodes[3], builder.MARKER, nodes[0]]
    clear_to_marker(@b)
    assert live(b) == [nodes[1], nodes[2], nodes[3]]

    # A new marker counts none of the last one's, and the outer three stay
    # three.
    push_marker(@b)
    inner: [i64] @= []

    for _ in range(from: 0, to: 3)
        inner @ inner.push(insert.create(@b, space: dom.HTML, name: "b", attributes: []))

    for n in inner
        push_element(@b, n)

    assert live(b) == [nodes[1], nodes[2], nodes[3], builder.MARKER, inner[0], inner[1], inner[2]]
    clear_to_marker(@b)
    fifth = insert.create(@b, space: dom.HTML, name: "b", attributes: [])
    push_element(@b, fifth)
    assert live(b) == [nodes[2], nodes[3], fifth]

test "push_element: the earliest far back taken out where it stands, nothing moved, and the list compacted once half of it is gone"
    b: builder.Builder @= builder.start(scripting: true, max_depth: 512)
    first: [i64] @= []

    for _ in range(from: 0, to: 3)
        n = insert.create(@b, space: dom.HTML, name: "i", attributes: [])
        first @ first.push(n)
        push_element(@b, n)

    others: [i64] @= []

    for k in range(from: 0, to: 20)
        n = insert.create(
            @b,
            space: dom.HTML,
            name: "b",
            attributes: [dom.Attr(space: dom.NO_SPACE, name: "id", value: f"{k}")]
        )
        others @ others.push(n)
        push_element(@b, n)

    fourth = insert.create(@b, space: dom.HTML, name: "i", attributes: [])
    push_element(@b, fourth)
    assert b.formatting[0] == builder.GONE && b.formatting[1] == first[1] && b.formatting[3] == others[0]
    wanted: [i64] @= [first[1], first[2]]

    for n in others
        wanted @ wanted.push(n)

    assert live(b) == wanted.push(fourth)
    last: [i64] @= []

    for _ in range(from: 0, to: 30)
        n = insert.create(@b, space: dom.HTML, name: "i", attributes: [])
        last @ last.push(n)
        push_element(@b, n)

    after: [i64] @= others

    for n in last.slice(from: 27, to: 30)
        after @ after.push(n)

    assert live(b) == after
    assert b.formatting_count == live(b).len() + b.gone && b.formatting_count < 54

test "kind_of: attributes in another order alike; another value, name, namespace or count of markers not"
    b: builder.Builder @= builder.start(scripting: true, max_depth: 512)
    x = dom.Attr(space: dom.NO_SPACE, name: "x", value: "1")
    y = dom.Attr(space: dom.NO_SPACE, name: "y", value: "2")
    first = insert.create(@b, space: dom.HTML, name: "a", attributes: [x, y])
    second = insert.create(@b, space: dom.HTML, name: "a", attributes: [y, x])
    third = insert.create(
        @b,
        space: dom.HTML,
        name: "a",
        attributes: [x, dom.Attr(space: dom.NO_SPACE, name: "y", value: "3")]
    )
    joined = insert.create(
        @b,
        space: dom.HTML,
        name: "a",
        attributes: [dom.Attr(space: dom.NO_SPACE, name: "x1", value: "")]
    )
    one = insert.create(@b, space: dom.HTML, name: "a", attributes: [x])
    svg = insert.create(@b, space: dom.SVG, name: "a", attributes: [x])
    assert kind_of(b.tree, node: first, markers: 0) == kind_of(b.tree, node: second, markers: 0)
    assert kind_of(b.tree, node: first, markers: 0) != kind_of(b.tree, node: third, markers: 0)
    assert kind_of(b.tree, node: first, markers: 0) != kind_of(b.tree, node: first, markers: 1)
    assert kind_of(b.tree, node: joined, markers: 0) != kind_of(b.tree, node: one, markers: 0)
    assert kind_of(b.tree, node: svg, markers: 0) != kind_of(b.tree, node: one, markers: 0)
