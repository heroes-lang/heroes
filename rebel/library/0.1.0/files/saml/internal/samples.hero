# An authentication request of the service provider, unsigned, of a fixed identifier and instant.
constant REQUEST: str
    "<samlp:AuthnRequest xmlns:samlp=\"urn:oasis:names:tc:SAML:2.0:protocol\" xmlns:saml=\"urn:oasis:names:tc:SAML:2.0:assertion\" ID=\"_5e1c\" Version=\"2.0\" IssueInstant=\"2026-11-23T22:00:00Z\" Destination=\"https://idp.example.org/sso/redirect\" AssertionConsumerServiceURL=\"https://sp.example.com/saml/acs\" ProtocolBinding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST\"><saml:Issuer>https://sp.example.com/saml</saml:Issuer><samlp:NameIDPolicy AllowCreate=\"true\"/></samlp:AuthnRequest>"

# The base 64 of `openssl dgst -sha256 -sign` by `SP_KEY` over the bytes SAML Bindings § 3.4.4.1 signs of `REQUEST` sent by redirect with the RelayState `/after`: what `redirect_url` must write.
constant REQUEST_SIGNATURE: str
    ""

