# The product of two magnitudes: limb by limb below `KARATSUBA` limbs, and by
# Karatsuba's method above, which splits each number in two halves and takes
# three products of halves instead of four, so the cost grows as the 1.585th
# power of the length instead of its square. An operand much shorter than the
# other is multiplied piece by piece, each piece as long as it.

use big/internal/limbs

# The length in limbs from which both operands are split. Measured on
# 2026-11-16, the same work timed both ways: at 64 limbs 0.83 s each, at 96
# Karatsuba 0.78 s against 0.83, at 512 0.44 s against 0.78.
constant KARATSUBA: i64
    80

# `a` times `b`.
function multiply(a: [i64], b: [i64]) -> [i64]
    if a.len() == 0 || b.len() == 0
        return []

    if a.len() < b.len()
        return multiply(a: b, b: a)

    if b.len() < KARATSUBA
        return schoolbook(a: a, b: b)

    if b.len() * 2 <= a.len()
        return by_pieces(a: a, b: b)
    return karatsuba(a: a, b: b)

# `a` times `b`, limb by limb; `b` is the shorter.
function schoolbook(a: [i64], b: [i64]) -> [i64]
    out: [i64] @= limbs.zeros(a.len() + b.len())
    i: i64 @= 0

    while i < b.len()
        factor = b[i]

        if factor != 0
            carry: i64 @= 0
            j: i64 @= 0

            while j < a.len()
                t = out[i + j] + a[j] * factor + carry
                out[i + j] @ t & limbs.MASK
                carry @ t >> limbs.BITS
                j @ j + 1

            out[i + a.len()] @ carry
        i @ i + 1

    return limbs.trimmed(out)

# `a` times `b`, `a` at least twice as long: `a` cut in pieces as long as `b`,
# each multiplied by `b` and added at its place.
function by_pieces(a: [i64], b: [i64]) -> [i64]
    out: [i64] @= limbs.zeros(a.len() + b.len() + 1)
    from: i64 @= 0

    while from < a.len()
        piece = limbs.part(a: a, from: from, to: from + b.len())
        limbs.add_into(out: @out, x: multiply(a: piece, b: b), at: from)
        from @ from + b.len()

    return limbs.trimmed(out)

# `a` times `b` by Karatsuba's method; `b` is the shorter, longer than half of
# `a`.
function karatsuba(a: [i64], b: [i64]) -> [i64]
    half = (a.len() + 1) / 2
    a_low = limbs.part(a: a, from: 0, to: half)
    a_high = limbs.part(a: a, from: half, to: a.len())
    b_low = limbs.part(a: b, from: 0, to: half)
    b_high = limbs.part(a: b, from: half, to: b.len())
    low = multiply(a: a_low, b: b_low)
    high = multiply(a: a_high, b: b_high)
    both = multiply(a: limbs.add(a: a_low, b: a_high), b: limbs.add(a: b_low, b: b_high))
    middle = limbs.sub(a: limbs.sub(a: both, b: low), b: high)
    out: [i64] @= limbs.zeros(a.len() + b.len() + 1)
    limbs.add_into(out: @out, x: low, at: 0)
    limbs.add_into(out: @out, x: middle, at: half)
    limbs.add_into(out: @out, x: high, at: 2 * half)
    return limbs.trimmed(out)

# `a` raised to the power `exponent`, 0 or more, by squaring.
function power(a: [i64], exponent: i64) -> [i64]
    assert exponent >= 0
    result: [i64] @= [1]
    square: [i64] @= a
    left: i64 @= exponent

    while left > 0
        if left & 1 == 1
            result @ multiply(a: result, b: square)
        left @ left >> 1

        if left > 0
            square @ multiply(a: square, b: square)

    return result

## Tests

test "multiply: by zero, by one, a carry into a new limb, and the largest limbs"
    nothing: [i64] = []
    assert multiply(a: nothing, b: [5]) == nothing
    assert multiply(a: [5], b: [1]) == [5]
    assert multiply(a: [1073741823], b: [2]) == [1073741822, 1]
    assert multiply(a: [1073741823, 1073741823], b: [1073741823, 1073741823]) == [1, 0, 1073741822, 1073741823]

# A number of many limbs, every limb from a simple rule, so that both methods
# can be held to each other.
function sample(count: i64, seed: i64) -> [i64]
    out: [i64] @= []
    state: i64 @= seed

    while out.len() < count
        state @ (state * 1103515245 + 12345) % 2147483648
        out @ out.push(state & limbs.MASK)

    out @ out.push(1)
    return out

test "multiply: Karatsuba and piece by piece agree with limb by limb, balanced and not"
    for size in [80, 81, 117, 160, 333]
        a = sample(count: size, seed: size)
        b = sample(count: size - 3, seed: size + 1)
        assert multiply(a: a, b: b) == schoolbook(a: a, b: b)
        c = sample(count: 85, seed: 7)
        assert multiply(a: a, b: c) == schoolbook(a: a, b: c)

test "power: to zero, to one, of zero, and 2 to the 100th"
    nothing: [i64] = []
    assert power(a: [7], exponent: 0) == [1]
    assert power(a: [7], exponent: 1) == [7]
    assert power(a: nothing, exponent: 3) == nothing
    assert power(a: nothing, exponent: 0) == [1]
    assert power(a: [2], exponent: 100) == limbs.shift_left(a: [1], count: 100)
    assert power(a: [10], exponent: 9) == [1000000000]
