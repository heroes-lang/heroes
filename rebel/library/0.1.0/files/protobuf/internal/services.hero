# A service's declaration in a `.proto` file: its methods, their request and
# response types as written, whether each side streams, and their options.

use protobuf/internal/lexer
use protobuf/internal/model
use protobuf/internal/syntax

# A service, the word `service` passed.
function service_decl(tokens: [lexer.Token] lent, @at: i64, file: str, scope: str) -> model.Service?
    name = syntax.ident(tokens, @at, name: file, what: "the service's name")?
    full = syntax.joined(scope: scope, name: name)
    syntax.expect(tokens, @at, name: file, symbol: "{")?
    methods: [model.Method] @= []
    options: [model.Setting] @= []

    while !syntax.is_at(tokens, at: at, text: "}")
        t = syntax.peek(tokens, at: at)

        if t.kind == lexer.END
            return fail(
                code: "invalid",
                msg: syntax.expected(name: file, t: t, what: "\"}\", which closes the service")
            )

        if syntax.is_at(tokens, at: at, text: ";")
            at @ at + 1
        else if t.text == "option" && t.kind == lexer.IDENT
            at @ at + 1
            options @ options.push(syntax.option_statement(tokens, @at, name: file)?)
        else if t.text == "rpc" && t.kind == lexer.IDENT
            at @ at + 1
            method_name = syntax.ident(tokens, @at, name: file, what: "the method's name")?
            syntax.expect(tokens, @at, name: file, symbol: "(")?
            client = syntax.is_at(tokens, at: at, text: "stream") && !syntax.is_at(tokens, at: at + 1, text: ")") && !syntax.is_at(tokens, at: at + 1, text: ".")

            if client
                at @ at + 1
            input = syntax.dotted(tokens, @at, name: file, what: "the request's type")?
            syntax.expect(tokens, @at, name: file, symbol: ")")?

            if !syntax.is_at(tokens, at: at, text: "returns")
                return fail(
                    code: "invalid",
                    msg: syntax.expected(name: file, t: syntax.peek(tokens, at: at), what: "`returns`")
                )
            at @ at + 1
            syntax.expect(tokens, @at, name: file, symbol: "(")?
            server = syntax.is_at(tokens, at: at, text: "stream") && !syntax.is_at(tokens, at: at + 1, text: ")") && !syntax.is_at(tokens, at: at + 1, text: ".")

            if server
                at @ at + 1
            output = syntax.dotted(tokens, @at, name: file, what: "the response's type")?
            syntax.expect(tokens, @at, name: file, symbol: ")")?
            method_options: [model.Setting] @= []

            if syntax.is_at(tokens, at: at, text: "{")
                at @ at + 1

                while !syntax.is_at(tokens, at: at, text: "}")
                    o = syntax.peek(tokens, at: at)

                    if o.kind == lexer.END
                        return fail(
                            code: "invalid",
                            msg: syntax.expected(name: file, t: o, what: "\"}\", which closes the method")
                        )

                    if syntax.is_at(tokens, at: at, text: ";")
                        at @ at + 1
                    else if o.text == "option" && o.kind == lexer.IDENT
                        at @ at + 1
                        method_options @ method_options.push(syntax.option_statement(tokens, @at, name: file)?)
                    else
                        return fail(
                            code: "invalid",
                            msg: syntax.expected(name: file, t: o, what: "an option of the method")
                        )

                at @ at + 1
            else
                syntax.expect(tokens, @at, name: file, symbol: ";")?
            methods @ methods.push(
                model.Method(name: method_name, full_name: full + "." + method_name, input_type: input, output_type: output, client_streaming: client, server_streaming: server, options: method_options)
            )
        else
            return fail(code: "invalid", msg: syntax.expected(name: file, t: t, what: "`rpc` or `option`"))

    at @ at + 1
    return ok(model.Service(name: name, full_name: full, file: file, methods: methods, options: options))
