# Counts put in order, the largest first, for `maps.most_common`. The
# language's `sort` orders the counts themselves; what a ranking needs is the
# order of their positions, with equal counts left as they stood, and this
# module answers that.

use maps/internal/gather

# The positions of `counts` in the order of their values, the largest first,
# positions of equal value in rising order. Every `i64` is a count here, the
# smallest and the largest included: no count is added to or negated, so
# nothing overflows. It sorts the counts once and then places each position
# in one pass.
function largest_first(counts: [i64]) -> [i64]
    rank_of: {i64: i64} @= {}
    sorted = sort(counts)
    at: i64 @= sorted.len() - 1

    while at >= 0
        if rank_of[sorted[at]].is_err()
            rank_of[sorted[at]] @ rank_of.len()
        at @ at - 1

    ranks: [i64] @= []

    for c in counts
        ranks @ ranks.push(rank_of[c].must())

    return gather.by_group(ranks, rank_of.len())

## Tests

test "largest_first: no count, one, all equal, and equal counts in rising position"
    nothing: [i64] = []
    assert largest_first(nothing) == nothing
    assert largest_first([7]) == [0]
    assert largest_first([4, 4, 4]) == [0, 1, 2]
    assert largest_first([5, 2, 2, 1, 1]) == [0, 1, 2, 3, 4]
    assert largest_first([1, 5, 2, 5, 1]) == [1, 3, 2, 0, 4]

test "largest_first: zero, negative counts, and the two ends of an i64"
    smallest: i64 = -9223372036854775807 - 1
    largest: i64 = 9223372036854775807
    assert largest_first([0, -2, 5, 5]) == [2, 3, 0, 1]
    assert largest_first([smallest, 0, largest, smallest]) == [2, 1, 0, 3]
