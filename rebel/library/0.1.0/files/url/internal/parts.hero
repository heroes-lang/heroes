# What the package's private modules ask of a URL's parts, the face's `Url`:
# the empty reference they start from, and whether an authority is written.

use url

# The parts of the empty reference, "".
function empty() -> url.Url
    return url.Url(
        scheme: "",
        user: "",
        password: "",
        host: "",
        port: "",
        path: "",
        query: "",
        fragment: "",
        empty_authority: false,
        empty_userinfo: false,
        empty_password: false,
        empty_query: false,
        empty_fragment: false
    )

# Whether `p` writes an authority, the "//" and what follows it.
function has_authority(p: url.Url) -> bool
    return p.user != "" || p.password != "" || p.host != "" || p.port != "" || p.empty_authority || p.empty_userinfo || p.empty_password

## Tests

test "has_authority: none, a host, a port alone, and each flag"
    p @= empty()
    assert !has_authority(p)
    p.empty_query @ true
    assert !has_authority(p)
    p.host @ "h"
    assert has_authority(p)
    q @= empty()
    q.port @ "80"
    assert has_authority(q)
    r @= empty()
    r.empty_authority @ true
    assert has_authority(r)
    t @= empty()
    t.empty_password @ true
    assert has_authority(t)
