# RFC 7541 Appendix C's request and response examples, read from the RFC's
# text: each block's bytes, the header list it holds and the size of the
# dynamic table after it. The requests run against a table of 4,096 bytes,
# the responses against one of 256, three blocks each on one table.

use bytes
use http2

# The names of the three requests of C.3 and C.4, in their order.
constant REQUEST_NAMES: [[str]]
    [
        [":method", ":scheme", ":path", ":authority"]
        [":method", ":scheme", ":path", ":authority", "cache-control"]
        [":method", ":scheme", ":path", ":authority", "custom-key"]
    ]

# The values of the three requests, as `REQUEST_NAMES` orders them.
constant REQUEST_VALUES: [[str]]
    [
        ["GET", "http", "/", "www.example.com"]
        ["GET", "http", "/", "www.example.com", "no-cache"]
        ["GET", "https", "/index.html", "www.example.com", "custom-value"]
    ]

# The names of the three responses of C.5 and C.6.
constant RESPONSE_NAMES: [[str]]
    [
        [":status", "cache-control", "date", "location"]
        [":status", "cache-control", "date", "location"]
        [":status", "cache-control", "date", "location", "content-encoding", "set-cookie"]
    ]

# The values of the three responses, as `RESPONSE_NAMES` orders them.
constant RESPONSE_VALUES: [[str]]
    [
        ["302", "private", "Mon, 21 Oct 2013 20:13:21 GMT", "https://www.example.com"]
        ["307", "private", "Mon, 21 Oct 2013 20:13:21 GMT", "https://www.example.com"]
        ["200", "private", "Mon, 21 Oct 2013 20:13:22 GMT", "https://www.example.com", "gzip", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"]
    ]

# The blocks of C.3, no string Huffman-coded, in hexadecimal.
constant REQUESTS_PLAIN: [str]
    [
        "828684410f7777772e6578616d706c652e636f6d"
        "828684be58086e6f2d6361636865"
        "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565"
    ]

# The blocks of C.4, every string Huffman-coded.
constant REQUESTS_HUFFMAN: [str]
    [
        "828684418cf1e3c2e5f23a6ba0ab90f4ff"
        "828684be5886a8eb10649cbf"
        "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf"
    ]

# The blocks of C.5, no string Huffman-coded.
constant RESPONSES_PLAIN: [str]
    [
        "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d"
        "4803333037c1c0bf"
        "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31"
    ]

# The blocks of C.6, every string Huffman-coded.
constant RESPONSES_HUFFMAN: [str]
    [
        "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3"
        "4883640effc1c0bf"
        "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007"
    ]

# The dynamic table's size after each request, in bytes.
constant REQUEST_TABLE_SIZES: [i64]
    [
        57
        110
        164
    ]

# The dynamic table's size after each response, in bytes.
constant RESPONSE_TABLE_SIZES: [i64]
    [
        222
        222
        215
    ]

# The fields of one example: `names[i]` with `values[i]`, none sensitive.
function fields(names: [str], values: [str]) -> [http2.Field]
    out: [http2.Field] @= []

    for i in range(from: 0, to: names.len())
        out @ out.push(http2.Field(name: names[i], value: values[i], sensitive: false))

    return out

# The bytes of one example's block, from its hexadecimal.
function block(hex: str) -> [u8]
    return bytes.parse_hex(hex).must()
