# A text read as its bytes: whether they are all ASCII, the bytes
# themselves, and a part of the text cut at indices that may come from
# outside the program, refused rather than aborting where they cut no part.

use strings/internal/messages
use unicode

# The code `slice_checked` fails with.
constant INVALID: str
    "invalid"

# Whether every byte of `s` is below 128.
function is_ascii(s: str) -> bool
    at: i64 @= 0

    while at < s.len()
        if s[at] >= 128
            return false
        at @ at + 1

    return true

# The part of `s` from byte `from` up to `to`, failing `invalid` where the
# built-in `slice` would abort.
function slice_checked(s: str, from: i64, to: i64) -> str?
    if from < 0 || to > s.len()
        return fail(
            code: INVALID,
            msg: f"bytes {from} to {to} are outside {messages.shown(s)}, which holds {s.len()} bytes"
        )

    if from > to
        return fail(code: INVALID, msg: f"byte {from} comes after byte {to}")

    if !unicode.is_char_boundary(s, from)
        return fail(code: INVALID, msg: f"byte {from} of {messages.shown(s)} is inside a character")

    if !unicode.is_char_boundary(s, to)
        return fail(code: INVALID, msg: f"byte {to} of {messages.shown(s)} is inside a character")
    return ok(s.slice(from: from, to: to))

## Tests

test "is_ascii: the empty text, ASCII up to 127, and a character of more than one byte"
    assert is_ascii("")
    assert is_ascii("abc\u{7f}")
    assert !is_ascii("é")
    assert !is_ascii("abcé")

test "slice_checked: a part, a whole character, an empty text, inside a character, past the end, below 0, and the wrong order"
    assert slice_checked(s: "città", from: 0, to: 3).must() == "cit"
    assert slice_checked(s: "città", from: 4, to: 6).must() == "à"
    assert slice_checked(s: "", from: 0, to: 0).must() == ""
    assert slice_checked(s: "città", from: 0, to: 7).is_err()
    assert slice_checked(s: "città", from: 0 - 1, to: 2).is_err()
    assert slice_checked(s: "città", from: 3, to: 2).is_err()

    match slice_checked(s: "città", from: 5, to: 6)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "byte 5 of \"città\" is inside a character"
