# The 17 modules of `value` in cluster `cluster` (0, 1 or 2, for the
# standard's 0, 3 and 6), its highest bit the first module.
function pattern_of(cluster: i64, value: i64) -> i64
    index = cluster * 929 + value
    line = PATTERNS[index / 16]
    at = index % 16 * 5
    out: i64 @= 0

    for k in range(from: at, to: at + 5)
        b = to_i64(line[k]).must()
        digit: i64 @= b - 48

        if b >= 97
            digit @ b - 87
        out @ out << 4 | digit

    return out

## Tests

test "pattern_of: every pattern is 17 modules from a bar to a space, and no two are one"
    seen: {i64: bool} @= {}

    for cluster in range(from: 0, to: 3)
        for value in range(from: 0, to: 929)
            p = pattern_of(cluster: cluster, value: value)
            assert p >> 16 == 1 && p & 1 == 0
            assert !seen[p].default(false)
            seen[p] @ true

    assert pattern_of(cluster: 0, value: 0) == 120256
    assert pattern_of(cluster: 2, value: 928) == 116714
