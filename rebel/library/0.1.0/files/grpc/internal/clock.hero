# A call's deadline on the connection under it: the time `time.mark` counts,
# and the wait of every read and write of the stream set to what is left,
# by `tls.set_deadline`, which moves a TLS stream's and a socket's alike.

use io
use time
use tls

# A monotonic clock in milliseconds, 0 where the system answers none.
function now_ms() -> i64
    match time.mark()
        .ok m  => return m.nanoseconds / 1000000
        .err _ => return 0

# The time `ms` milliseconds stand for as `tls` takes it, 0, this clock's
# no end, being `time.max_duration()`.
#
# - `ms`: milliseconds, 0 for no end.
function tls_deadline(ms: i64) -> time.Duration?
    if ms == 0
        return ok(time.max_duration())
    return ok(time.milliseconds_checked(ms).default(time.max_duration()))

# Makes every read and write of `stream` end by `ms` milliseconds from now,
# 0 for no end, a TLS stream's or a socket's alike (`tls.set_deadline`).
# Fails `closed` where `stream` is closed and `unsupported` where it takes no
# deadline.
function set_wait(stream: io.Stream, ms: i64) -> ()?
    return tls.set_deadline(stream, deadline: tls_deadline(ms)?)

# The milliseconds left before `deadline_at`, -1 where there is none, 0
# where it has passed.
function left_of(deadline_at: i64) -> i64
    if deadline_at == 0
        return -1
    left = deadline_at - now_ms()

    if left < 0
        return 0
    return left

# Makes every read and write of `stream` end when `deadline_at` passes, or
# never where it is 0. Fails as `set_wait` fails.
function wait_until(stream: io.Stream, deadline_at: i64) -> ()?
    left = left_of(deadline_at)

    if left < 0
        return set_wait(stream, ms: 0)

    if left == 0
        return set_wait(stream, ms: 1)
    return set_wait(stream, ms: left)
