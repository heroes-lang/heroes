# The server of `mail/imap`'s tests, played without a thread: a session over
# one end of a connected pair of sockets, the server's whole answer written
# into the other end before the client speaks, and what the client wrote
# read back once it is done. The client's tags are numbered from A0001, so
# a script names them before they are sent.

use io
use mail/imap/internal/flow
use mail/imap/internal/status
use mail/imap/internal/wire
use net
use time

# A session and the server's end of its connection.
record Played
    # The session, logged in, its capabilities those the test named.
    conn: flow.Conn
    # The server's end, holding the client's words once the session ends.
    server: io.Stream

# A session over a pair whose server end holds `script` already, the
# capabilities `capabilities` known, IMAP4rev2 in force where `rev2`.
function play(script: str, capabilities: [str], rev2: bool) -> Played
    two = net.pair(deadline_ms: 5000).must()
    server = two.second.stream
    io.write_text(server, text: script).must()
    w = wire.over(two.first.stream, link: .plain, deadline: time.seconds(5), max_bytes: 1_000_000)
    c = flow.Conn(
        wire: w,
        host: "127.0.0.1",
        is_tls: false,
        capabilities: capabilities,
        rev2: rev2,
        logged_in: true,
        greeting: status.plain(condition: "OK", text: ""),
        last: status.plain(condition: "", text: ""),
        pending: [],
        lost: 0,
        idling: "",
        bye: status.plain(condition: "", text: "")
    )
    return Played(conn: c, server: server)

# A server on the loopback address for one session, played on a thread of
# its own, for the examples of `connect`: the port it listens on, and the
# thread, which answers what the client wrote.
record Started
    # The port.
    port: i64
    # The thread, which answers what the client wrote once it closed.
    thread: (thread str)

# What the thread of `start` is handed.
record Serving
    # Where it tells its port.
    ports: (mailbox i64)
    # The server's whole answer, the greeting first.
    script: str

# Starts a server that accepts one connection on the loopback address and
# writes `script` into it at once, the greeting first.
function start(script: str) -> Started
    ports: (mailbox i64) = mailbox()
    t = spawn(serve_once, Serving(ports: ports, script: script)).must()
    return Started(port: ports.receive(within_ms: 5_000).must(), thread: t)

# The thread of `start`: one connection accepted, `s.script` written, and
# what the client wrote read until it closes.
function serve_once(s: Serving) -> str
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    _ = s.ports.send(l.address.port).is_err()
    conn = net.accept(l, deadline_ms: 5_000).must()
    net.close_listener(@l).must()
    io.write_text(conn.stream, text: s.script).must()
    r @= io.reader(conn.stream)
    written = io.read_rest_text(@r).must()
    io.close(@r.stream).must()
    return written

# What the client wrote, read once its session `conn` is closed, and the
# server's end `server` closed.
function heard(@conn: flow.Conn, @server: io.Stream) -> str
    match wire.close(@conn.wire)
        .ok _  => _ = 0
        .err _ => _ = 0

    r @= io.reader(server)
    out = io.read_rest_text(@r).must()
    io.close(@server).must()
    return out
