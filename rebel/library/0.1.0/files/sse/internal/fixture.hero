# The other end of an event stream's connections, run on a thread of its own
# while the test's thread is the client: it answers the requests it reads, one
# connection each, with the texts written ahead, and gives back what it saw;
# and the pieces the face's tests and examples share. Nothing outside the
# tests calls it.

use http
use io
use net
use sse
use strings
use threads
use time

# What parts the pieces of a script and what the server saw.
constant SEPARATOR: str
    "\u{1e}"

# A server on a thread, and the port it listens on.
record Started
    # The port the server listens on, which it chose and told.
    port: i64
    # The server's thread, whose answer `threads.wait_text` gives.
    thread: threads.TextThread

# A server that answers the connection number n with `pieces[n]`, each the
# whole text of an answer, head and body: written after the request is read,
# and the connection closed after it; a piece that begins with `hold:` keeps
# the connection open for 700 ms after its text, as a server that falls
# silent does.
function start(pieces: [str]) -> Started
    control @= net.listen(host: "127.0.0.1", port: 0).must()
    t = threads.start_text(body: serve, arg: f"{control.address.port}" + SEPARATOR + pieces.join(SEPARATOR)).must()
    net.set_accept_deadline(control, deadline_ms: 10_000).must()
    told = net.accept(control, deadline_ms: 10_000).must()
    r @= io.reader(told.stream)
    said = io.read_rest_text(@r).must()
    io.close(@r.stream).must()
    net.close_listener(@control).must()
    return Started(port: net.parse_port(said).must(), thread: t)

# Listens on a port the system chooses, tells it to the control port `arg`
# names first, and answers each connection as `start` says. Gives back one
# line for each request read, `METHOD path last-event-id accept`, a field it
# lacks written as `-`, parted by `SEPARATOR`.
function serve(arg: str) -> str
    parts = strings.split(s: arg, sep: SEPARATOR)
    control = net.parse_port(parts[0]).must()
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    c @= net.connect("127.0.0.1", port: control, deadline_ms: 10_000).must()
    io.write_text(c.stream, text: f"{l.address.port}").must()
    io.close(@c.stream).must()
    net.set_accept_deadline(l, deadline_ms: 10_000).must()
    seen: [str] @= []
    at: i64 @= 1

    while at < parts.len()
        match net.accept(l, deadline_ms: 10_000)
            .err _ => break
            .ok conn =>
                r @= io.reader(conn.stream)

                match http.next_request(@r, limits: http.default_limits())
                    .ok asked =>
                        seen @ seen.push(
                            f"{asked.method} {asked.url.path} {http.value_of(asked.headers, name: "Last-Event-ID").default("-")} {http.value_of(asked.headers, name: "Accept").default("-")}"
                        )
                        piece = parts[at]
                        at @ at + 1

                        if strings.has_prefix(s: piece, prefix: "hold:")
                            put(r.stream, text: piece.slice(from: 5, to: piece.len()))
                            time.sleep(time.milliseconds(700))
                        else
                            put(r.stream, text: piece)
                    .err _ => _ = 0

                shut(@r.stream)

    net.close_listener(@l).must()
    return seen.join(SEPARATOR)

# `text` written to `s`, a failure being the client's going and no news.
function put(s: io.Stream, text: str)
    match io.write_text(s, text: text)
        .ok _  => _ = 0
        .err _ => _ = 0

# Closes `s`, a failure to close being no news either.
function shut(@s: io.Stream)
    match io.close(@s)
        .ok _  => _ = 0
        .err _ => _ = 0

# The head of an answer that opens an event stream and ends with the
# connection.
function stream_head() -> str
    return "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n"

# The settings a test reads with: a short wait, one second to connect.
function quick() -> sse.Reading
    r @= sse.default_reading()
    r.retry @ time.milliseconds(10)
    r.longest @ time.milliseconds(40)
    return r

# What the stand-in `t` saw, a line for each request.
#
# - `t`: the stand-in; its thread is waited for.
function seen_by(@t: Started) -> [str]
    return strings.split(s: threads.wait_text(@t.thread), sep: SEPARATOR)

# A client's side of the hub's connection: the connection read from, and the
# server's side the hub is handed.
record Pair
    # What the hub is handed.
    server: io.Stream
    # What the client reads.
    client: io.Reader

# A connection on the loopback. A port of the loopback is any program's to
# connect to, so a connection whose peer is not this client is closed and the
# next one taken, until the client's own comes.
function pair() -> Pair
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    c = net.connect("127.0.0.1", port: l.address.port, deadline_ms: 5_000).must()
    a @= net.accept(l, deadline_ms: 5_000).must()

    while a.remote != c.local
        shut(@a.stream)
        a @ net.accept(l, deadline_ms: 5_000).must()

    net.close_listener(@l).must()
    net.set_deadline(c.stream, deadline_ms: 5_000).must()
    return Pair(server: a.stream, client: io.reader(c.stream))

# The stream a client reads after the head of its answer, the head checked to
# open an event stream.
#
# - `p`: the connection; its reader moves past the head.
function watched(@p: Pair) -> http.EventReader
    head = http.read_response_head(@p.client, method: "GET", limits: http.default_limits()).must()
    assert head.status == 200 && http.value_of(head.headers, name: "Content-Type").must() == "text/event-stream"
    return http.event_reader(head, limits: http.default_limits()).must()
