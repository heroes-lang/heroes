# What a piece's size counts, read from the face's own `Measure`, which a
# private module may name since panel 252's R1: characters, bytes, or the
# tokens of an encoding.

use chunks
use tokenizer

# Whether `m` counts the tokens of an encoding, whose count of a text is not
# the sum of its parts' counts.
function counts_tokens(m: chunks.Measure lent) -> bool
    return match m
        .tokens _            => true
        .characters | .bytes => false

# The size of `s` from `from` to `to`, the second excluded, both a
# character's first byte.
function cost(m: chunks.Measure lent, s: str, from: i64, to: i64) -> i64
    match m
        .bytes => return to - from
        .tokens t =>
            if from == 0 && to == s.len()
                return tokenizer.count(t.encoding, text: s)
            return tokenizer.count(t.encoding, text: s.slice(from: from, to: to))
        .characters => _ = 0

    count: i64 @= 0
    at: i64 @= from

    while at < to
        b = s[at]

        if b < 0x80 || b > 0xbf
            count @ count + 1
        at @ at + 1

    return count

# Whether `size` and `overlap` can cut a text: a size of 1 at least, an
# overlap from 0 to the size less 1. Fails `invalid` where they cannot.
function check(size: i64, overlap: i64) -> ()?
    if size < 1
        return fail(code: "invalid", msg: f"a piece's size must be 1 at least, and {size} was given")

    if overlap < 0 || overlap >= size
        return fail(
            code: "invalid",
            msg: f"an overlap must be from 0 to the size less 1, {size - 1}, and {overlap} was given"
        )
    return ok()

test "check: the smallest size, an overlap of 0 and of the size less 1, and each refused"
    assert !check(size: 1, overlap: 0).is_err()
    assert !check(size: 10, overlap: 9).is_err()
    assert check(size: 0, overlap: 0).is_err()
    assert check(size: 10, overlap: 10).is_err()
    assert check(size: 10, overlap: -1).is_err()

    match check(size: 4, overlap: 4)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "an overlap must be from 0 to the size less 1, 3, and 4 was given"

test "cost and counts_tokens: characters of more than one byte, bytes, and an empty range"
    m: chunks.Measure = .characters
    assert cost(m, s: "aé世😀", from: 0, to: 10) == 4
    assert cost(m, s: "aé世😀", from: 1, to: 6) == 2
    bytes_measure: chunks.Measure = .bytes
    assert cost(bytes_measure, s: "aé世😀", from: 0, to: 10) == 10
    assert cost(m, s: "abc", from: 2, to: 2) == 0
    assert !counts_tokens(m) && !counts_tokens(bytes_measure)
