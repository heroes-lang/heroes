# Where a decimal stands against a binary float, decided exactly with whole
# numbers and no division: the comparison by which Clinger's AlgorithmR
# ("How to Read Floating Point Numbers Accurately", 1990) accepts or corrects an
# approximation, and the one that says whether a decimal reads back as a
# float, which the fewest digits ask.
#
# A float above zero is a significand times a power of two. The values that
# read back as it lie between the midpoints to its two neighbours, an end
# included where its significand is even, since a tie goes to the even one.
# Each comparison brings both sides to whole numbers by multiplying the side
# that holds the negative power, so nothing is rounded on the way: in two
# `i64`s (`wide`) where the power of ten is at most the 22nd, and in a list
# of limbs (`big`) where it is larger.

use numbers/internal/big
use numbers/internal/exact
use numbers/internal/near
use numbers/internal/wide

# A float above zero that is normal in its format: `significand` times two to
# the `exp`th, the significand at least 2 to the bits less one and under 2 to
# the bits.
record Binary
    significand: i64
    exp: i64

# The sign of `a` times ten to the `tens`th less `b` times two to the
# `twos`th: -1, 0 or 1.
function against(a: [i64], tens: i64, b: [i64], twos: i64) -> i64
    left: [i64] @= a
    right: [i64] @= b

    if tens >= 0
        left @ big.times_pow10(a: left, k: tens)
    else
        right @ big.times_pow10(a: right, k: 0 - tens)

    if twos >= 0
        right @ big.shifted(a: right, k: twos)
    else
        left @ big.shifted(a: left, k: 0 - twos)
    return big.compare(a: left, b: right)

# The sign of `a` times ten to the `tens`th less `b` times two to the
# `twos`th, both from 0 to 2 to the 61st less one: -1, 0 or 1. Where ten's
# power is at most the 22nd, each side is one of them times a power of five
# under 2 to the 53rd, times a power of two, which `wide` holds.
function against_whole(a: i64, tens: i64, b: i64, twos: i64) -> i64
    if tens > wide.FIVES_MAX || tens < 0 - wide.FIVES_MAX
        return against(a: big.of(a), tens: tens, b: big.of(b), twos: twos)

    # Ten to the `tens`th is five to it times two to it, so the two sides
    # differ by two to the `tens - twos`th once the fives are placed.
    left = if tens >= 0
        wide.product(a: a, b: wide.five_to(tens))
    else
        wide.product(a: a, b: 1)

    right = if tens >= 0
        wide.product(a: b, b: 1)
    else
        wide.product(a: b, b: wide.five_to(0 - tens))
    return wide.compare_shifted(a: left, twos: tens - twos, b: right)

# Whether `x` is finite and normal in `format`: at least its smallest normal
# value, where the gaps to both neighbours are the significand's step.
function is_normal(x: f64, format: near.Format) -> bool
    return x >= near.pow2(format.min_exp + format.bits - 1) && x < near.infinity()

# `x`, finite, normal in `format` and a value of it, as its significand and
# power of two. Fails `unsupported` where it is not.
function binary_of(x: f64, format: near.Format) -> Binary?
    if !is_normal(x: x, format: format)
        return fail(code: "unsupported", msg: "not a normal float of the format")
    parts = exact.split(x)
    unit = 1 << 53 - format.bits

    if parts.significand % unit != 0
        return fail(code: "unsupported", msg: "more bits than the format holds")
    return ok(Binary(significand: parts.significand / unit, exp: parts.exp + 53 - format.bits))

# The float `b` stands for.
function value_of(b: Binary) -> f64
    return to_f64(b.significand) * near.pow2(b.exp)

# Where `a`, from 0 to 2 to the 61st less one, times ten to the `tens`th
# stands against `b`, a float of `format`: -1 below every value that reads back as `b`, 0 among them, 1
# above them.
function place(a: i64, tens: i64, b: Binary, format: near.Format) -> i64
    s = b.significand
    odd = s % 2 == 1
    above = against_whole(a: a, tens: tens, b: 2 * s + 1, twos: b.exp - 1)

    if above > 0 || above == 0 && odd
        return 1

    # At the lowest significand of a binade the neighbour below is half a
    # step away, so its midpoint is a quarter step below, except at the
    # smallest normal power, whose neighbour below is a full step away.
    below = if s == 1 << format.bits - 1 && b.exp > format.min_exp
        against_whole(a: a, tens: tens, b: 4 * s - 1, twos: b.exp - 2)
    else
        against_whole(a: a, tens: tens, b: 2 * s - 1, twos: b.exp - 1)

    if below < 0 || below == 0 && odd
        return -1
    return 0

# The float of `format` next to `b`, above it where `way` is 1 and below it
# where `way` is -1. Fails `unsupported` past the largest finite value and
# below the smallest normal one.
function neighbour(b: Binary, way: i64, format: near.Format) -> Binary?
    lowest = 1 << format.bits - 1
    s = b.significand + way

    if s == lowest << 1
        if b.exp + 1 + format.bits - 1 > format.max_exp
            return fail(code: "unsupported", msg: "past the largest float")
        return ok(Binary(significand: lowest, exp: b.exp + 1))

    if s < lowest
        if b.exp == format.min_exp
            return fail(code: "unsupported", msg: "below the smallest normal float")
        return ok(Binary(significand: (lowest << 1) - 1, exp: b.exp - 1))
    return ok(Binary(significand: s, exp: b.exp))

## Tests

test "against: either power negative, both, and equal sides"
    assert against(a: [5], tens: -1, b: [1], twos: -1) == 0
    assert against(a: [3], tens: 0, b: [3], twos: 0) == 0
    assert against(a: [1], tens: 1, b: [5], twos: 1) == 0
    assert against(a: [1], tens: -1, b: [1], twos: -3) < 0
    assert against(a: [1], tens: -1, b: [1], twos: -4) > 0
    assert against(a: big.of(625), tens: -4, b: [1], twos: -4) == 0

test "against_whole: both routes agree, either power negative, and past the 22nd"
    assert against_whole(a: 5, tens: -1, b: 1, twos: -1) == 0
    assert against_whole(a: 1, tens: 1, b: 5, twos: 1) == 0
    assert against_whole(a: 1, tens: -1, b: 1, twos: -3) < 0
    assert against_whole(a: 1, tens: -1, b: 1, twos: -4) > 0
    assert against_whole(a: 1, tens: 23, b: 1, twos: 76) > 0
    assert against_whole(a: 1, tens: 23, b: 1, twos: 77) < 0
    assert against_whole(a: 1, tens: -23, b: 1, twos: -76) < 0

    for tens in [-30, -22, -9, 0, 7, 22, 30]
        for twos in [-200, -70, 0, 64, 150]
            for pair in [[1, 1], [999999999999999999, 9007199254740991], [(1 << 61) - 1, 3]]
                assert against_whole(a: pair[0], tens: tens, b: pair[1], twos: twos) == against(a: big.of(pair[0]), tens: tens, b: big.of(pair[1]), twos: twos)

test "binary_of: one, a fraction, the f32 shape, and what is not normal"
    f64s = near.f64_format()
    assert binary_of(x: 1.0, format: f64s).must() == Binary(significand: 4503599627370496, exp: -52)
    assert binary_of(x: 0.75, format: f64s).must() == Binary(significand: 6755399441055744, exp: -53)
    assert binary_of(x: 1.0, format: near.f32_format()).must() == Binary(significand: 8388608, exp: -23)
    assert binary_of(x: 0.1, format: near.f32_format()).is_err()
    assert binary_of(x: near.pow2(-1074), format: f64s).is_err()
    assert binary_of(x: near.infinity(), format: f64s).is_err()
    assert value_of(binary_of(x: 0.1, format: f64s).must()) == 0.1

test "place: the two midpoints of one tenth, a tie to even, and a power of two"
    f64s = near.f64_format()
    tenth = binary_of(x: 0.1, format: f64s).must()
    assert place(a: 1, tens: -1, b: tenth, format: f64s) == 0
    assert place(a: 10000000000000000, tens: -17, b: tenth, format: f64s) == 0
    assert place(a: 10000000000000002, tens: -17, b: tenth, format: f64s) == 1
    assert place(a: 9999999999999998, tens: -17, b: tenth, format: f64s) == -1
    top = binary_of(x: 9007199254740992.0, format: f64s).must()
    assert place(a: 9007199254740993, tens: 0, b: top, format: f64s) == 0
    assert place(a: 9007199254740991, tens: 0, b: top, format: f64s) == -1
    assert place(a: 90071992547409915, tens: -1, b: top, format: f64s) == 0

test "neighbour: inside a binade, across one both ways, and past either end"
    f64s = near.f64_format()
    one = binary_of(x: 1.0, format: f64s).must()
    assert value_of(neighbour(b: one, way: 1, format: f64s).must()) == 1.0000000000000002
    assert value_of(neighbour(b: one, way: -1, format: f64s).must()) == 0.9999999999999999
    largest = Binary(significand: 9007199254740991, exp: 971)
    assert neighbour(b: largest, way: 1, format: f64s).is_err()
    smallest = Binary(significand: 4503599627370496, exp: -1074)
    assert neighbour(b: smallest, way: -1, format: f64s).is_err()
