# WebP files to test with, made on 2026-11-23 by libwebp 1.6.0's `cwebp` from
# PNG files a program outside the tree wrote (a gradient, few colours, two,
# noise, alpha, a photograph-like image, a repeating one, a faint one, one
# pixel, a wide and a tall one, near-lossless, multithreaded), at the
# compression levels `-z 0` to `-z 9`, each with the pixels libwebp's `dwebp`
# reads back from the same file, which equal the PNG's where the file is
# exactly lossless; an animation laid out by `webpmux` from three of them; a
# file with an ICC profile, EXIF and XMP chunks added by `webpmux`; and two lossy
# files, which `decode` refuses as unsupported. The animation's canvas after each
# frame is made by a program outside the tree from `dwebp`'s frames, a
# frame over the canvas rounded to the nearest, which the test holds to one
# level. Made by a program outside the tree; no program calls it.

# A still image and what reading it answers.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The pixels RGBA, as hexadecimal text; empty where `crc` stands in.
    pixels: str
    # The CRC-32 of the pixels where they are not written out, else 0.
    crc: i64

# One frame of an animation as the file lays it out.
record Placed
    # The column of its left edge.
    x: i64
    # The row of its top edge.
    y: i64
    # Its columns.
    width: i64
    # Its rows.
    height: i64
    # How long it shows, in milliseconds.
    duration: i64
    # Whether it replaces what is under it instead of being laid over it.
    replaces: bool
    # Whether its rectangle is cleared before the next frame.
    clears: bool
    # Its pixels RGBA, as hexadecimal text.
    pixels: str

# The files that hold one picture each.
function readable() -> [Sample]
    return [
        Sample(name: "grad_z0", file: "", width: 37, height: 29, pixels: "", crc: 163819414)
        Sample(name: "grad_z9", file: "524946463e000000574542505650384c310000002f24000700b98ce87fec22a2ff01b20d8baefc7fb318c5242448214d672014a46dc0b406765c004df23e83dc127bde133900", width: 37, height: 29, pixels: "", crc: 163819414)
        Sample(name: "few", file: "5249464678000000574542505650384c6b0000002f288005002740a46d333c34ff028f2f474840c8fe0f9564b1603284fc51bbe63f40dd49b10183066cdbb887800bc12550c90826993faafd0d4044ff0da46d1301db7e19b6a724925b1200cb6eff2469904cd201ec73eb3f5d547a9f5bfee95079f1e5fe4f87caab2fbf0800", width: 41, height: 23, pixels: "", crc: 324839105)
        Sample(name: "two", file: "524946462a000000574542505650384c1d0000002f1fc003000f30fff33ffff31f7810082408fb5b6e914244ff73c6190100", width: 32, height: 16, pixels: "", crc: 0)
        Sample(name: "noise", file: "", width: 20, height: 17, pixels: "", crc: 0)
        Sample(name: "alpha", file: "", width: 30, height: 21, pixels: "", crc: 0)
        Sample(name: "photo", file: "", width: 64, height: 48, pixels: "", crc: 3754050889)
        Sample(name: "repeat", file: "5249464650000000574542505650384c440000002f5fc00900b98ce87f2c14a46dc0d4bff0ee288881efff0410f6cfa0a86d23a6508e3fd1fddaa74288059377e8a185150ad236603603dfc40347144e07494fd0dbffef1e", width: 96, height: 40, pixels: "", crc: 153523970)
        Sample(name: "faint", file: "524946463a000000574542505650384c2e0000002f3140070020d2b6f16fa0a23f7a201048a16c7f9999feab4ddb80999cfa08c4e64e9d7367011840027880bbba11", width: 50, height: 30, pixels: "", crc: 2967221253)
        Sample(name: "onepixel", file: "524946461a000000574542505650384c0e0000002f00000000071011fd0f4444ff03", width: 1, height: 1, pixels: "000000ff", crc: 0)
        Sample(name: "wide", file: "524946463e000000574542505650384c310000002f2b810000b98ce87f2c0082f09fae2006beff29c740266d5329f36f74efd8550a7104c410101439608768719a8f78150100", width: 300, height: 3, pixels: "", crc: 2535817915)
        Sample(name: "tall", file: "", width: 3, height: 200, pixels: "", crc: 0)
        Sample(name: "near", file: "", width: 64, height: 48, pixels: "", crc: 83938624)
        Sample(name: "mt", file: "", width: 80, height: 60, pixels: "", crc: 3402317412)
    ]

# The animation: its file.
function animation() -> str
    return ""

# The animation's frames as laid out.
function placed() -> [Placed]
    return [
        Placed(x: 0, y: 0, width: 41, height: 23, duration: 100, replaces: false, clears: false, pixels: "")
        Placed(x: 4, y: 2, width: 32, height: 16, duration: 70, replaces: true, clears: true, pixels: "")
        Placed(x: 10, y: 6, width: 30, height: 21, duration: 40, replaces: false, clears: false, pixels: "")
    ]

# The canvas after each frame is drawn, RGBA, 41 by 27.
function canvases() -> [str]
    return [
        ""
        ""
        ""
    ]

# A file with an ICC profile, EXIF and XMP: its bytes.
function with_metadata() -> str
    return ""

# Two lossy files, one with alpha.
function lossy() -> [str]
    return [
        ""
        ""
    ]
