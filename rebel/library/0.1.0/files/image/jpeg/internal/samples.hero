# JPEG files to test with, made on 2026-11-18 by Go 1.27's `image/jpeg`
# and by libjpeg-turbo 3.2.1's `cjpeg` (from netpbm files of the same
# pictures), each with the pixels Go's `jpeg.Decode` answers, laid out as
# `image` holds them, as hexadecimal text. Made by a program outside the
# tree; no program calls it.

# A file and what reading it answers.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The columns Go read.
    width: i64
    # The rows Go read.
    height: i64
    # `gray` or `rgb`.
    format: str
    # Go's pixels, as hexadecimal text.
    pixels: str

# A file reading refuses, with the code it fails with.
record Broken
    # What is wrong with it.
    name: str
    # The file, as hexadecimal text.
    file: str
    # The code `decode` fails with.
    code: str

# Every file read, with Go's pixels.
function readable() -> [Sample]
    return [
        Sample(name: "go gray at quality 90", file: "", width: 13, height: 11, format: "gray", pixels: "fef5eae8202d383f464e5b6594f9f2e9d82f33444a57636b6f82f2f1ddd138434956626d74828bf1e3d8cc41485c655664767c7815232a3b545148549e8880707e1a22384449495b688b7f8c7c971f2d3f504252616c9c817c658d242f454e4e5d6c668a7c81739d28384e44ac94a48d7c8295939e2e40524aa19194857b86959da73045565299968c89869798a6a7")
        Sample(name: "go colour 4:2:0 at quality 90", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "go gray at quality 50", file: "", width: 13, height: 11, format: "gray", pixels: "fef4e7e1252e373e50525c7187fff9ebde2a303e4a5156637586ebe5dbcf373e515f646c79868df3e8d9c9504c4e4f666a70757611152b4c2f4f646884807c7a7c2024374e45535a569f9487858d15233c4a4e5462688b7b6d708220344f50504d62729382767f97233b4c4c9c99949178818e969a2941504d9b958f8b818a979fa23047544f9b928a8587909ba4a6")
        Sample(name: "go colour 4:2:0 at quality 50", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "go colour with EXIF orientation 6, big-endian", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "go colour with EXIF orientation 3, little-endian", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg gray, progressive", file: "", width: 13, height: 11, format: "gray", pixels: "fdf8ebe3222b38454b5359668ff9f1e7e7283641484c5a687489fcead8d63245505367717a8181e5e6ddc94a46536455606f7d781e242b3f415254569c8f857e7a10293b424e4e54658c817f7e9520303a484a575e6c98867b698d2432415d465d646d877e8070a32a374a45a8999d8b7c8293969a2d3d4f4aa09393877f87979fa4314656539b938d8886909aa4a5")
        Sample(name: "cjpeg colour 4:4:4", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:2:2", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:4:0", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:2:0, optimized tables", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:2:0, progressive", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:4:4, progressive", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:2:0, a restart every MCU", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:2:0, progressive, a restart every row (Go refuses it: its pixels are those of the same file without restarts)", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour as RGB", file: "", width: 21, height: 13, format: "rgb", pixels: "")
        Sample(name: "cjpeg colour 4:1:1", file: "", width: 21, height: 13, format: "rgb", pixels: "")
    ]

# Every file refused; beside each, what Go's `jpeg.Decode` answers.
function refused() -> [Broken]
    return [
        # Go: invalid JPEG format: short Huffman data
        Broken(name: "a file cut inside its scan", file: "", code: "invalid")
        # Go: unexpected EOF
        Broken(name: "a file cut inside its header", file: "ffd8ffe000104a46494600010100000100010000ffdb00430006040506050406060506070706080a100a0a09090a140e0f0c1017141818171416161a", code: "invalid")
        # Go: invalid JPEG format: missing SOI marker
        Broken(name: "no SOI", file: "", code: "invalid")
        # Go: unsupported JPEG feature: unknown marker
        Broken(name: "arithmetic coding", file: "", code: "unsupported")
        # Go: unsupported JPEG feature: precision
        Broken(name: "12 bits a sample", file: "", code: "unsupported")
        # Go: unsupported JPEG feature: unknown marker
        Broken(name: "lossless", file: "", code: "unsupported")
        # Go: invalid JPEG format: missing 0xff00 sequence
        Broken(name: "a bomb of 60,000 by 60,000", file: "", code: "limit")
        # Go: invalid JPEG format: DHT has wrong length
        Broken(name: "a scan naming a Huffman table never defined", file: "", code: "invalid")
    ]
