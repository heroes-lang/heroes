# Icon and cursor files to test with, made on 2026-11-23 by a program outside
# the tree, one per way an entry is stored (a bitmap of 32 bits with alpha, of
# 32 bits with its alpha all zero and a mask, of 24, 8, 4 and 1 bits with a
# mask, a PNG of 256 by 256, an image of 13 by 9 whose rows are padded, a file of
# three images, a cursor with a hot spot) with the pixels construction gives, as
# RGBA in hexadecimal text, or the CRC-32 of them for a large image. The file a
# macOS `sips` wrote from a PNG holds the pixels `sips` reads back from it:
# `sips` reads the 32-bit alpha, the 8-bit mask and the PNG entries as these
# cases do, and ignores the mask of 1, 4, 24 and zero-alpha 32 bits, which
# the format's own definition (Microsoft's) gives and these cases follow.
# Made by a program outside the tree; no program calls it.

# One image of a file and its pixels.
record Pic
    # The columns.
    width: i64
    # The rows.
    height: i64
    # The pixels, as hexadecimal text; empty where `crc` stands in.
    pixels: str
    # The CRC-32 of the pixels where they are not written out, else 0.
    crc: i64

# A file and what reading it answers.
record Sample
    # What the file is.
    name: str
    # The file, as hexadecimal text.
    file: str
    # Whether it is a cursor.
    cursor: bool
    # Its images.
    pics: [Pic]

# Every file read, with its pixels.
function readable() -> [Sample]
    return [
        Sample(name: "dib32_alpha", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib32_mask", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib24_mask", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib8_mask", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib4_mask", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib1_mask", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "dib24_13x9", file: "", cursor: false, pics: [Pic(width: 13, height: 9, pixels: "", crc: 0)])
        Sample(name: "png_256", file: "", cursor: false, pics: [Pic(width: 256, height: 256, pixels: "", crc: 3169107009)])
        Sample(name: "multi", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0), Pic(width: 32, height: 32, pixels: "", crc: 0), Pic(width: 48, height: 48, pixels: "", crc: 2805269821)])
        Sample(name: "cursor", file: "", cursor: true, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
        Sample(name: "sips_written", file: "", cursor: false, pics: [Pic(width: 16, height: 16, pixels: "", crc: 0)])
    ]
