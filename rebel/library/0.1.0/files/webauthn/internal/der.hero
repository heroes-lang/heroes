# The few DER structures Web Authentication needs, read and written by hand:
# a COSE key written as SubjectPublicKeyInfo, and an attestation
# certificate's key, version, subject, basic constraints and extensions read.
# `asn1` and `x509` stand at or above this package's layer, so it walks its
# own; it reads DER strictly (definite lengths in their shortest form) and
# nothing else, and every structure it does not need it steps over.

use webauthn/internal/codes

# One element of DER: its tag and where its content lies in the bytes read.
record Tlv
    # The tag's one byte: 0x30 a sequence, 0x02 an integer, 0xa0 the first
    # context tag, and so on; a tag of more than one byte is refused.
    tag: i64
    # Where the content begins.
    start: i64
    # Where it ends, and the next element begins.
    end: i64

# The element that begins at `at` of `data`, which must end by `limit`.
function read(data: [u8] lent, at: i64, limit: i64) -> Tlv?
    if at + 2 > limit
        return fail(code: codes.INVALID, msg: f"DER: an element at byte {at} runs past its end at {limit}")
    tag = to_i64(data[at]).must()

    if tag & 0x1f == 0x1f
        return fail(code: codes.INVALID, msg: f"DER: a tag of more than one byte at byte {at}")
    first = to_i64(data[at + 1]).must()
    length: i64 @= first
    start: i64 @= at + 2

    if first == 0x80
        return fail(code: codes.INVALID, msg: f"DER: an indefinite length at byte {at + 1}")

    if first > 0x80
        count = first - 0x80

        if count > 4 || at + 2 + count > limit
            return fail(code: codes.INVALID, msg: f"DER: a length of {count} bytes at byte {at + 1}")
        length @ 0

        for i in range(from: 0, to: count)
            length @ length * 256 + to_i64(data[at + 2 + i]).must()

        if length < 0x80 || data[at + 2] == 0
            return fail(code: codes.INVALID, msg: f"DER: a length at byte {at + 1} not in its shortest form")
        start @ at + 2 + count

    if start + length > limit
        return fail(
            code: codes.INVALID,
            msg: f"DER: an element of {length} bytes at byte {at} runs past its end at {limit}"
        )
    return ok(Tlv(tag: tag, start: start, end: start + length))

# The element of `data` that begins at `at` with the tag `tag`, which must end
# by `limit`; any other tag is refused, `what` naming the element.
function expect(data: [u8] lent, at: i64, limit: i64, tag: i64, what: str) -> Tlv?
    tlv = read(data: data, at: at, limit: limit)?

    if tlv.tag != tag
        return fail(code: codes.INVALID, msg: f"DER: {what} at byte {at} has tag {tlv.tag}, not {tag}")
    return ok(tlv)

# The bytes of `data` from `from` to `to`.
function part(data: [u8] lent, from: i64, to: i64) -> [u8]
    out: [u8] @= []

    for i in range(from: from, to: to)
        out @ out.push(data[i])

    return out

## Writing

# The DER length of `count` content bytes.
function length_of(count: i64) -> [u8]
    if count < 0x80
        return [to_u8(count).must()]

    if count < 0x100
        return [0x81, to_u8(count).must()]
    return [0x82, to_u8(count >> 8).must(), to_u8(count & 0xff).must()]

# The element of `tag` holding `content`.
function wrap(tag: u8, content: [u8]) -> [u8]
    out: [u8] @= [tag]

    for b in length_of(content.len())
        out @ out.push(b)

    for b in content
        out @ out.push(b)

    return out

# The DER integer of the unsigned big-endian number `magnitude`: its leading
# zeros dropped, a zero put back where the high bit would read as a sign.
function integer(magnitude: [u8]) -> [u8]
    at: i64 @= 0

    while at < magnitude.len() - 1 && magnitude[at] == 0
        at @ at + 1

    content: [u8] @= []

    if magnitude.len() == 0 || magnitude[at] >= 0x80
        content @ content.push(0)

    for i in range(from: at, to: magnitude.len())
        content @ content.push(magnitude[i])

    return wrap(tag: 0x02, content: content)

# `parts` one after another.
function joined(parts: [[u8]]) -> [u8]
    out: [u8] @= []

    for p in parts
        for b in p
            out @ out.push(b)

    return out

# The object identifier id-ecPublicKey, 1.2.840.10045.2.1, written whole.
constant EC_PUBLIC_KEY: [u8]
    [0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01]

# The curve P-256, 1.2.840.10045.3.1.7.
constant P256: [u8]
    [0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07]

# The curve P-384, 1.3.132.0.34.
constant P384: [u8]
    [0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22]

# rsaEncryption, 1.2.840.113549.1.1.1, and its NULL parameters.
constant RSA_ENCRYPTION: [u8]
    [0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x05, 0x00]

# Ed25519, 1.3.101.112.
constant ED25519: [u8]
    [0x06, 0x03, 0x2b, 0x65, 0x70]

# The SubjectPublicKeyInfo of an elliptic curve point `point`, 0x04 then its
# two coordinates, on the curve whose identifier is `curve`.
function ec_key(curve: [u8], point: [u8]) -> [u8]
    algorithm = wrap(tag: 0x30, content: joined([EC_PUBLIC_KEY, curve]))
    return wrap(tag: 0x30, content: joined([algorithm, wrap(tag: 0x03, content: joined([[0], point]))]))

# The SubjectPublicKeyInfo of the RSA key of modulus `n` and exponent `e`.
function rsa_key(n: [u8], e: [u8]) -> [u8]
    algorithm = wrap(tag: 0x30, content: RSA_ENCRYPTION)
    inner = wrap(tag: 0x30, content: joined([integer(n), integer(e)]))
    return wrap(tag: 0x30, content: joined([algorithm, wrap(tag: 0x03, content: joined([[0], inner]))]))

# The SubjectPublicKeyInfo of the Ed25519 key `x`.
function ed25519_key(x: [u8]) -> [u8]
    algorithm = wrap(tag: 0x30, content: ED25519)
    return wrap(tag: 0x30, content: joined([algorithm, wrap(tag: 0x03, content: joined([[0], x]))]))

## Reading a certificate

# What an attestation certificate's checks read of it.
record Certificate
    # Its SubjectPublicKeyInfo, whole.
    key: [u8]
    # Its version, 1 to 3, as written plus one.
    version: i64
    # The values of its subject's organizational units, in order.
    units: [str]
    # Whether its subject names a country, an organization and a common
    # name, each at least once.
    named: bool
    # Whether its basic constraints say it is a certificate authority; false
    # where it has none.
    authority: bool
    # The content of its id-fido-gen-ce-aaguid extension, the octets the
    # extension's octet string wraps; empty where it has none.
    aaguid: [u8]
    # The content of its extension 1.2.840.113635.100.8.2, Apple's nonce;
    # empty where it has none.
    apple: [u8]

# The object identifier id-fido-gen-ce-aaguid, 1.3.6.1.4.1.45724.1.1.4, its
# content alone.
constant FIDO_AAGUID: [u8]
    [0x2b, 0x06, 0x01, 0x04, 0x01, 0x82, 0xe5, 0x1c, 0x01, 0x01, 0x04]

# basicConstraints, 2.5.29.19, its content alone.
constant BASIC_CONSTRAINTS: [u8]
    [0x55, 0x1d, 0x13]

# Apple's anonymous attestation nonce, 1.2.840.113635.100.8.2.
constant APPLE_NONCE: [u8]
    [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x63, 0x64, 0x08, 0x02]

# Whether the content of `tlv` in `data` is `oid`'s bytes.
function is_oid(data: [u8] lent, tlv: Tlv, oid: [u8]) -> bool
    if tlv.tag != 0x06 || tlv.end - tlv.start != oid.len()
        return false

    for i in range(from: 0, to: oid.len())
        if data[tlv.start + i] != oid[i]
            return false

    return true

# The certificate `der` holds, the fields its checks read.
function certificate(der: [u8]) -> Certificate?
    whole = expect(data: der, at: 0, limit: der.len(), tag: 0x30, what: "the certificate")?

    if whole.end != der.len()
        return fail(code: codes.INVALID, msg: f"DER: {der.len() - whole.end} bytes follow the certificate")
    tbs = expect(data: der, at: whole.start, limit: whole.end, tag: 0x30, what: "the certificate's body")?
    at: i64 @= tbs.start
    version: i64 @= 1
    first = read(data: der, at: at, limit: tbs.end)?

    if first.tag == 0xa0
        number = expect(data: der, at: first.start, limit: first.end, tag: 0x02, what: "the version")?

        if number.end - number.start != 1
            return fail(code: codes.INVALID, msg: "DER: a version of more than one byte")
        version @ to_i64(der[number.start]).must() + 1
        at @ first.end
    serial = expect(data: der, at: at, limit: tbs.end, tag: 0x02, what: "the serial number")?
    signature = expect(data: der, at: serial.end, limit: tbs.end, tag: 0x30, what: "the signature algorithm")?
    issuer = expect(data: der, at: signature.end, limit: tbs.end, tag: 0x30, what: "the issuer")?
    validity = expect(data: der, at: issuer.end, limit: tbs.end, tag: 0x30, what: "the validity")?
    subject = expect(data: der, at: validity.end, limit: tbs.end, tag: 0x30, what: "the subject")?
    key = expect(data: der, at: subject.end, limit: tbs.end, tag: 0x30, what: "the public key")?
    units: [str] @= []
    seen: {str: bool} @= {}
    rdn: i64 @= subject.start

    while rdn < subject.end
        set = expect(data: der, at: rdn, limit: subject.end, tag: 0x31, what: "a name's attribute set")?
        pair: i64 @= set.start

        while pair < set.end
            attribute = expect(data: der, at: pair, limit: set.end, tag: 0x30, what: "a name's attribute")?
            oid = expect(data: der, at: attribute.start, limit: attribute.end, tag: 0x06, what: "an attribute's type")?
            value = read(data: der, at: oid.end, limit: attribute.end)?

            if oid.end - oid.start == 3 && der[oid.start] == 0x55 && der[oid.start + 1] == 0x04
                kind = der[oid.start + 2]

                if kind == 0x0b
                    text = part(data: der, from: value.start, to: value.end).validated_bytes()

                    match text
                        .ok t  => units @ units.push(t)
                        .err _ => return fail(code: codes.INVALID, msg: "DER: an organizational unit that is not UTF-8")
                seen[f"{kind}"] @ true
            pair @ attribute.end

        rdn @ set.end

    named = !seen["6"].is_err() && !seen["10"].is_err() && !seen["3"].is_err()
    authority: bool @= false
    aaguid: [u8] @= []
    apple: [u8] @= []
    at @ key.end

    while at < tbs.end
        field = read(data: der, at: at, limit: tbs.end)?

        if field.tag == 0xa3
            list = expect(data: der, at: field.start, limit: field.end, tag: 0x30, what: "the extensions")?
            ext: i64 @= list.start

            while ext < list.end
                one = expect(data: der, at: ext, limit: list.end, tag: 0x30, what: "an extension")?
                oid = expect(data: der, at: one.start, limit: one.end, tag: 0x06, what: "an extension's identifier")?
                next: Tlv @= read(data: der, at: oid.end, limit: one.end)?

                if next.tag == 0x01
                    next @ read(data: der, at: next.end, limit: one.end)?

                if next.tag != 0x04
                    return fail(code: codes.INVALID, msg: "DER: an extension's value is not an octet string")

                if is_oid(data: der, tlv: oid, oid: BASIC_CONSTRAINTS)
                    constraints = expect(data: der, at: next.start, limit: next.end, tag: 0x30, what: "the basic constraints")?

                    if constraints.end > constraints.start
                        flag = read(data: der, at: constraints.start, limit: constraints.end)?

                        if flag.tag == 0x01 && flag.end - flag.start == 1 && der[flag.start] != 0
                            authority @ true
                else if is_oid(data: der, tlv: oid, oid: FIDO_AAGUID)
                    inner = expect(data: der, at: next.start, limit: next.end, tag: 0x04, what: "the AAGUID")?
                    aaguid @ part(data: der, from: inner.start, to: inner.end)
                else if is_oid(data: der, tlv: oid, oid: APPLE_NONCE)
                    apple @ part(data: der, from: next.start, to: next.end)
                ext @ one.end
        at @ field.end

    return ok(
        Certificate(key: part(data: der, from: subject.end, to: key.end), version: version, units: units, named: named, authority: authority, aaguid: aaguid, apple: apple)
    )

## Tests

test "read: a short length, a long one, and the refusals"
    assert read(data: [0x02, 0x01, 0x05], at: 0, limit: 3).must() == Tlv(tag: 2, start: 2, end: 3)
    long: [u8] @= [0x04, 0x81, 0x80]

    for _ in range(from: 0, to: 128)
        long @ long.push(0)

    assert read(data: long, at: 0, limit: long.len()).must().end == 131
    assert read(data: [0x02, 0x81, 0x05, 0, 0, 0, 0, 0], at: 0, limit: 8).is_err()
    assert read(data: [0x02, 0x80, 0x00, 0x00], at: 0, limit: 4).is_err()
    assert read(data: [0x1f, 0x01, 0x00], at: 0, limit: 3).is_err()
    assert read(data: [0x02, 0x05, 0x00], at: 0, limit: 3).is_err()
    assert read(data: [0x02], at: 0, limit: 1).is_err()

test "integer: zero, a high bit, leading zeros"
    assert integer([0]) == [0x02, 0x01, 0x00]
    assert integer([0x80]) == [0x02, 0x02, 0x00, 0x80]
    assert integer([0, 0, 0x7f]) == [0x02, 0x01, 0x7f]
    assert integer([0x01, 0x00, 0x01]) == [0x02, 0x03, 0x01, 0x00, 0x01]

test "length_of and wrap: the three forms"
    assert length_of(0) == [0]
    assert length_of(127) == [127]
    assert length_of(128) == [0x81, 0x80]
    assert length_of(300) == [0x82, 0x01, 0x2c]
    assert wrap(tag: 0x04, content: [1, 2]) == [0x04, 0x02, 0x01, 0x02]
