# The stream a client's connection travels on, made for a `ws://` or
# `wss://` URL: a TCP connection or TLS, directly or through the proxy the
# client's `Proxy` names for it (a tunnel opened at `CONNECT` or by SOCKS, TLS
# begun over it for `wss`), its opening handshake given what is left of the
# time allowed.

use http
use io
use net
use time
use tls
use url

# The code of a time allowed run out.
constant TIMEOUT: str
    "timeout"

# A stream to `u`'s host and port, TLS for `wss`, its reads and writes ending
# by `deadline_ms` from now, which the connection's making counts in.
#
# - `u`: a `ws://` or `wss://` URL.
# - `deadline_ms`: the milliseconds allowed, 0 for no limit.
# - `secure`: what a TLS client trusts and offers.
# - `proxy`: the proxies; a `ws://` URL is sent through the one for `http://`
#   and a `wss://` URL through the one for `https://`, a tunnel to the server
#   in either case, since a proxy that is handed no request of its own has
#   nothing else to pass on, and no proxy is used where `proxy` names none for
#   the URL or its bypass names its host.
#
# Fails `timeout` where the time runs out, `unsupported` where `wss://` is to
# go through a proxy on a platform whose TLS does not begin over a tunnel
# (macOS), and as `url.port_of`, `http.tunnel`, `net.connect_timeout` and
# `tls.connect` fail.
function opened(u: url.Url, deadline: time.Duration, secure: tls.Client, proxy: http.Proxy) -> io.Stream?
    port = url.port_of(u)?
    began = time.mark()?
    bounded = deadline != time.max_duration()
    asked @= u

    asked.scheme @ if u.scheme == "wss"
        "https"
    else
        "http"

    match http.proxy_for(proxy, target: asked)
        .ok via => return tunnelled(u, via: via, port: port, deadline: deadline, secure: secure, began: began)
        .err _  => _ = 0

    if u.scheme == "wss"
        stream @= tls.connect(host: u.host, port: port, deadline: deadline, client: secure)?.stream

        if bounded
            match left_of(began, deadline: deadline)
                .ok left => tls.set_deadline(stream, deadline: left).must()
                .err e =>
                    ended(@stream)
                    return fail(code: e.code, msg: e.msg)
        return ok(stream)
    whole = deadline.nanoseconds / 1_000_000

    connect_ms = if !bounded
        net.FOREVER
    else if deadline.nanoseconds % 1_000_000 != 0
        whole + 1
    else
        whole
    conn @= net.connect_timeout(host: u.host, port: port, timeout_ms: connect_ms, deadline_ms: net.FOREVER)?

    if bounded
        match left_of(began, deadline: deadline)
            .ok left => tls.set_deadline(conn.stream, deadline: left).must()
            .err e =>
                ended(@conn.stream)
                return fail(code: e.code, msg: e.msg)
    return ok(conn.stream)

# A stream to `u`'s host and port through the proxy `via`: the tunnel the
# proxy opens (`http.tunnel`), TLS begun over it for `wss` with the server's
# name checked, and what is left of `deadline` then every read's and write's.
# Fails `unsupported` where the platform's TLS begins none over a stream the
# program holds, as on macOS, and as `http.tunnel`, `tls.client_over` and
# `left_of` fail.
function tunnelled(u: url.Url, via: str, port: i64, deadline: time.Duration, secure: tls.Client, began: time.Mark) -> io.Stream?
    stream @= http.tunnel(proxy: via, host: u.host, port: port, deadline: deadline)?

    if u.scheme == "wss"
        stream @ match tls.client_over(@stream, host: u.host, client: secure)
            .ok s => s
            .err e =>
                ended(@stream)
                return fail(
                    code: e.code,
                    msg: f"connecting to wss://{u.host} through a proxy: TLS over the proxy's tunnel is begun by `tls.client_over` ({e.msg})"
                )

    if deadline != time.max_duration()
        match left_of(began, deadline: deadline)
            .ok left =>
                match tls.set_deadline(stream, deadline: left)
                    .ok _ => _ = 0
                    .err e =>
                        ended(@stream)
                        return fail(code: e.code, msg: e.msg)
            .err e =>
                ended(@stream)
                return fail(code: e.code, msg: e.msg)
    return ok(stream)

# What is left of `deadline` since `began`, above zero.
#
# Fails `timeout` where nothing is left.
function left_of(began: time.Mark, deadline: time.Duration) -> time.Duration?
    spent = time.elapsed(began)?
    left = time.difference(a: deadline, b: spent)?

    if left.nanoseconds <= 0
        return fail(
            code: TIMEOUT,
            msg: f"the connection took {time.format_duration(spent)} of the {time.format_duration(deadline)} allowed"
        )
    return ok(left)

# Closes `stream`, whatever the system answers: a stream given up.
function ended(@stream: io.Stream)
    if !io.is_closed(stream)
        match io.close(@stream)
            .ok _  => _ = 0
            .err _ => _ = 0

test "opened: a TCP connection to a ws URL, the time left of a deadline, and nothing listening"
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    stream @= opened(
        url.parse(f"ws://127.0.0.1:{l.address.port}/").must(),
        deadline: time.seconds(5).must(),
        secure: tls.Client(roots: "", protocols: []),
        proxy: http.no_proxy()
    ).must()
    accepted = net.accept(l, deadline_ms: 5_000).must()
    io.write(accepted.stream, data: [7]).must()
    assert io.read(stream, n: 1).must() == [7]
    ended(@stream)
    ended(@stream)
    other @= accepted.stream
    io.close(@other).must()
    net.close_listener(@l).must()
    assert opened(
        url.parse("ws://127.0.0.1:1/").must(),
        deadline: time.seconds(1).must(),
        secure: tls.Client(roots: "", protocols: []),
        proxy: http.no_proxy()
    ).is_err()

test "opened: a proxy for another scheme is not used, and one that is unreachable fails"
    nothing @= http.no_proxy()
    nothing.http @ "http://127.0.0.1:1"
    target = url.parse("ws://example.test:8080/chat").must()
    assert opened(
        target,
        deadline: time.seconds(1).must(),
        secure: tls.Client(roots: "", protocols: []),
        proxy: nothing
    ).is_err()
    only_https @= http.no_proxy()
    only_https.https @ "http://127.0.0.1:1"
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    direct @= opened(
        url.parse(f"ws://127.0.0.1:{l.address.port}/").must(),
        deadline: time.seconds(5).must(),
        secure: tls.Client(roots: "", protocols: []),
        proxy: only_https
    ).must()
    ended(@direct)
    net.close_listener(@l).must()

test "left_of: what is left of the time, and none"
    began = time.mark().must()
    assert left_of(began, deadline: time.minutes(1).must()).must().nanoseconds > 59_000_000_000

    match left_of(began, deadline: time.milliseconds(-1).must())
        .ok _  => assert false
        .err e => assert e.code == TIMEOUT
