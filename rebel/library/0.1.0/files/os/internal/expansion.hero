# `$NAME` and `${NAME}` in a text replaced by what a function answers for the
# name. Every position cut at is a `$`, a `{`, a `}` or the end of a run of
# ASCII name bytes, so no cut splits a character.

use os/internal/codes

# Whether `b` may stand in a name: an ASCII letter, a digit or `_`.
function is_name_byte(b: u8) -> bool
    return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_'

# Whether `name` is a name: not empty, and every byte one `is_name_byte`
# accepts.
function is_name(name: str) -> bool
    if name == ""
        return false
    at: i64 @= 0

    while at < name.len()
        if !is_name_byte(name[at])
            return false
        at @ at + 1

    return true

# `s` with each `$NAME` and `${NAME}` replaced by what `lookup` answers for
# `NAME`, `$$` written as one `$`, and a `$` before anything else kept. Fails
# with `lookup`'s error, and `invalid` where a `${` has no `}` or holds what
# is not a name.
function expanded(s: str, lookup: (function(str) -> str?)) -> str?
    pieces: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] != '$'
            at @ at + 1
            continue
        pieces @ pieces.push(s.slice(from: start, to: at))
        next = at + 1

        if next < s.len() && s[next] == '$'
            pieces @ pieces.push("$")
            at @ next + 1
        else if next < s.len() && s[next] == '{'
            close: i64 @= next + 1

            while close < s.len() && s[close] != '}'
                close @ close + 1

            if close == s.len()
                return fail(code: codes.INVALID, msg: f"the \"${{\" at byte {at} of \"{s}\" has no \"}}\"")
            name = s.slice(from: next + 1, to: close)

            if !is_name(name)
                return fail(
                    code: codes.INVALID,
                    msg: f"\"${{{name}}}\" at byte {at} of \"{s}\" names no variable: a name is ASCII letters, digits and \"_\""
                )
            pieces @ pieces.push(lookup(name)?)
            at @ close + 1
        else if next < s.len() && is_name_byte(s[next])
            end: i64 @= next

            while end < s.len() && is_name_byte(s[end])
                end @ end + 1

            pieces @ pieces.push(lookup(s.slice(from: next, to: end))?)
            at @ end
        else
            pieces @ pieces.push("$")
            at @ next
        start @ at

    pieces @ pieces.push(s.slice(from: start, to: s.len()))
    return ok(pieces.join(""))

## Tests

# A lookup for the tests: `HOME` is `/h`, `E` is set empty, `Ä` is never
# asked, and every other name is not set.
function test_lookup(name: str) -> str?
    if name == "HOME"
        return ok("/h")

    if name == "E"
        return ok("")
    return fail(code: codes.NOT_FOUND, msg: f"the variable \"{name}\" is not set")

test "expanded: the empty text, none, a name at either end, braces, and a name set empty"
    assert expanded("", lookup: test_lookup).must() == ""
    assert expanded("plain é", lookup: test_lookup).must() == "plain é"
    assert expanded("$HOME", lookup: test_lookup).must() == "/h"
    assert expanded("$HOME/x", lookup: test_lookup).must() == "/h/x"
    assert expanded("a/$HOME", lookup: test_lookup).must() == "a//h"
    assert expanded("${HOME}x", lookup: test_lookup).must() == "/hx"
    assert expanded("é$HOME.é", lookup: test_lookup).must() == "é/h.é"
    assert expanded("[$E]", lookup: test_lookup).must() == "[]"

test "expanded: $$, a lone $ at either end, and a $ before what is no name"
    assert expanded("$$HOME", lookup: test_lookup).must() == "$HOME"
    assert expanded("$", lookup: test_lookup).must() == "$"
    assert expanded("a$", lookup: test_lookup).must() == "a$"
    assert expanded("$ x", lookup: test_lookup).must() == "$ x"
    assert expanded("$é", lookup: test_lookup).must() == "$é"
    assert expanded("$-$.", lookup: test_lookup).must() == "$-$."

test "expanded: a name not set fails with the lookup's error, braces unclosed, empty or holding no name are invalid"
    match expanded("x $NOPE y", lookup: test_lookup)
        .ok _  => assert false
        .err e => assert e.code == codes.NOT_FOUND && e.msg == "the variable \"NOPE\" is not set"

    for bad in ["${HOME", "${", "${}", "${A-B}", "${é}", "a ${ b"]
        match expanded(bad, lookup: test_lookup)
            .ok _  => assert false
            .err e => assert e.code == codes.INVALID

test "is_name and is_name_byte: the empty name, digits first, underscore, and a byte of more than ASCII"
    assert !is_name("")
    assert is_name("_1") && is_name("9") && is_name("aZ_09")
    assert !is_name("a-b") && !is_name("é")
    assert is_name_byte('_') && !is_name_byte('$') && !is_name_byte(0xc3)
