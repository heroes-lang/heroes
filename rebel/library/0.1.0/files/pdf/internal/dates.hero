# PDF's dates (ISO 32000-1:2008 section 7.9.4): `D:YYYYMMDDHHmmSSOHH'mm'`,
# every part after the year optional, written in UTC and read with any
# offset.

use pdf/internal/codes

# `n` in two digits, a zero before one alone.
function two(n: i64) -> str
    if n < 10 && n >= 0
        return f"0{n}"
    return to_str(n)

# A date in UTC as PDF writes it: `D:20261118103000Z`.
function format(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> str
    y = to_str(year)
    pad = repeat("0", to_u64(4 - y.len()).default(0))
    return f"D:{pad}{y}{two(month)}{two(day)}{two(hour)}{two(minute)}{two(second)}Z"

# The parts of a date read: the calendar's, and the offset from UTC.
record Parts
    # The year, four digits.
    year: i64
    # The month, 1 to 12; 1 where the date names none.
    month: i64
    # The day, 1 to 31; 1 where none.
    day: i64
    # The hour, 0 to 23; 0 where none.
    hour: i64
    # The minute, 0 to 59.
    minute: i64
    # The second, 0 to 59.
    second: i64
    # The offset east of UTC, in minutes; 0 for `Z` or none.
    offset: i64

# The number the digits of `s` from `at` to `to` write, -1 where one is no
# digit or `s` is shorter.
function digits(s: str, at: i64, to: i64) -> i64
    if to > s.len()
        return -1
    n @= 0
    i @= at

    while i < to
        if s[i] < '0' || s[i] > '9'
            return -1
        n @ n * 10 + to_i64(s[i] - '0').must()
        i @ i + 1

    return n

# The parts `s` writes as a PDF date, its `D:` optional.
#
# Fails `invalid` where it is not one, the message saying what was found.
function parse(s: str) -> Parts?
    at @= 0

    if s.len() >= 2 && s[0] == 'D' && s[1] == ':'
        at @ 2
    year = digits(s, at: at, to: at + 4)

    if year < 0
        return codes.invalid(why: f"\"{s}\" is not a PDF date: it begins D:YYYY")
    at @ at + 4
    parts: [i64] @= [1, 1, 0, 0, 0]
    k @= 0

    while k < 5 && at + 2 <= s.len() && s[at] >= '0' && s[at] <= '9'
        n = digits(s, at: at, to: at + 2)

        if n < 0
            return codes.invalid(why: f"\"{s}\" is not a PDF date: a part has one digit")
        parts[k] @ n
        at @ at + 2
        k @ k + 1

    offset @= 0

    if at < s.len()
        sign = s[at]

        if sign == 'Z'
            at @ at + 1
        else if sign == '+' || sign == '-'
            hours = digits(s, at: at + 1, to: at + 3)

            if hours < 0
                return codes.invalid(why: f"\"{s}\" is not a PDF date: its offset is not HH'mm'")
            at @ at + 3
            minutes @= 0

            if at < s.len() && s[at] == '\''
                at @ at + 1

            if at + 2 <= s.len()
                m = digits(s, at: at, to: at + 2)

                if m >= 0
                    minutes @ m
                    at @ at + 2

            if at < s.len() && s[at] == '\''
                at @ at + 1
            offset @ hours * 60 + minutes

            if sign == '-'
                offset @ -offset
        else
            return codes.invalid(why: f"\"{s}\" is not a PDF date: what follows its time is no offset")

    if at != s.len()
        return codes.invalid(why: f"\"{s}\" is not a PDF date: something follows its offset")
    return ok(
        Parts(year: year, month: parts[0], day: parts[1], hour: parts[2], minute: parts[3], second: parts[4], offset: offset)
    )

test "two and format: one digit and two, a year of fewer than four digits"
    assert two(5) == "05" && two(12) == "12"
    assert format(year: 2026, month: 11, day: 18, hour: 9, minute: 3, second: 0) == "D:20261118090300Z"
    assert format(year: 812, month: 1, day: 1, hour: 0, minute: 0, second: 0) == "D:08120101000000Z"

test "parse: the whole form, the year alone, no D:, Z, an offset with and without apostrophes"
    full = parse("D:20240229123456+05'30'").must()
    assert full.year == 2024 && full.month == 2 && full.day == 29 && full.hour == 12 && full.minute == 34 && full.second == 56 && full.offset == 330
    alone = parse("D:1999").must()
    assert alone.month == 1 && alone.day == 1 && alone.hour == 0 && alone.offset == 0
    assert parse("20240101").must().day == 1
    assert parse("D:20240101120000Z").must().offset == 0
    assert parse("D:20240101120000-0800").must().offset == -480
    assert parse("D:20240101120000-08'").must().offset == -480

test "parse: not a date, a part of one digit, garbage after it, the empty text"
    assert parse("").is_err()
    assert parse("D:20").is_err()
    assert parse("D:2024011").is_err()
    assert parse("D:20240101X").is_err()
    assert parse("D:20240101Z1").is_err()
