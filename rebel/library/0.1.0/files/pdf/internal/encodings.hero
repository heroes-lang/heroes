test "the encodings: a few codes of each, read from the generator's sources"
    assert STANDARD[0x41] == 0x41 && STANDARD[0x27] == 0x2019 && STANDARD[0xa4] == 0x2044
    assert WIN_ANSI[0x80] == 0x20ac && WIN_ANSI[0x81] == 0 && WIN_ANSI[0x92] == 0x2019
    assert MAC_ROMAN[0x80] == 0xc4 && MAC_ROMAN[0xdb] == 0xa4
    assert SYMBOL[0x61] == 0x3b1 && DINGBATS[0x21] == 0x2701
    assert win_ansi_code_of(0x20ac) == 0x80 && win_ansi_code_of(0x100) == -1 && win_ansi_code_of(0xe9) == 0xe9
    assert dingbats_code_of(0x20) == 0x20 && DINGBATS[0x20] == 0x20
    assert symbol_code_of(0x3c0) == 0x70 && dingbats_code_of(0x2701) == 0x21 && symbol_code_of(0x391) == 0x41 && symbol_code_of(0x41) == -1
