# The code of the character `point` in ZapfDingbats' built-in encoding, or -1
# where the font has no glyph for it.
function dingbats_code_of(point: i64) -> i64
    return match point
        0x20   => 32
        0x2192 => 213
        0x2194 => 214
        0x2195 => 215
