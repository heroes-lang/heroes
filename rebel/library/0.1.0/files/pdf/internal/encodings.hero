# The WinAnsiEncoding code of the character `point`, or -1 where it has
# none: Latin-1's own code from U+0020 to U+007E and U+00A0 to U+00FF, and the
# 27 characters Windows put in 0x80 to 0x9F.
function win_ansi_code_of(point: i64) -> i64
    if point >= 0x20 && point <= 0x7e || point >= 0xa0 && point <= 0xff
        return point

    return match point
        0x152  => 0x8c
        0x153  => 0x9c
        0x160  => 0x8a
        0x161  => 0x9a
        0x178  => 0x9f
        0x17d  => 0x8e
        0x17e  => 0x9e
        0x192  => 0x83
        0x2c6  => 0x88
        0x2dc  => 0x98
        0x2013 => 0x96
        0x2014 => 0x97
        0x2018 => 0x91
        0x2019 => 0x92
        0x201a => 0x82
        0x201c => 0x93
        0x201d => 0x94
        0x201e => 0x84
        0x2020 => 0x86
        0x2021 => 0x87
        0x2022 => 0x95
        0x2026 => 0x85
        0x2030 => 0x89
        0x2039 => 0x8b
        0x203a => 0x9b
        0x20ac => 0x80
        0x2122 => 0x99
        _      => -1

# The code of the character `point` in Symbol' built-in encoding, or -1
# where the font has no glyph for it.
function symbol_code_of(point: i64) -> i64
    return match point
        0x20   => 32
        0x21   => 33
        0x23   => 35
        0x25   => 37
        0x26   => 38
