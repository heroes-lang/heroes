# The global metrics of Symbol, from `Symbol.afm`; it names no ascender, descender, cap height or x-height, so the first two are its box's bottom and top, and the others 0.
function global_symbol() -> Global
    return Global(
        ascent: 1010,
        descent: -293,
        cap_height: 0,
        x_height: 0,
        italic_angle: 0.0,
        underline_position: -100,
        underline_thickness: 50,
        box: [-180, -293, 1090, 1010],
        stem: 85
    )

