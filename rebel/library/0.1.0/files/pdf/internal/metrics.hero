# The global metrics of ZapfDingbats, from `ZapfDingbats.afm`; it names no ascender, descender, cap height or x-height, so the first two are its box's bottom and top, and the others 0.
function global_zapfdingbats() -> Global
    return Global(
        ascent: 820,
        descent: -143,
        cap_height: 0,
        x_height: 0,
        italic_angle: 0.0,
        underline_position: -100,
        underline_thickness: 50,
        box: [-1, -143, 981, 820],
        stem: 90
    )

# The widths of the font numbered `font`, 0 to 13 in the order of the face's
# `Font`, by code. Aborts on another number.
function widths_of(font: i64) -> [i64]
    return match font
        0  => WIDTHS_HELVETICA
        1  => WIDTHS_HELVETICA_BOLD
        2  => WIDTHS_HELVETICA_OBLIQUE
        3  => WIDTHS_HELVETICA_BOLDOBLIQUE
        4  => WIDTHS_TIMES_ROMAN
        5  => WIDTHS_TIMES_BOLD
        6  => WIDTHS_TIMES_ITALIC
        7  => WIDTHS_TIMES_BOLDITALIC
        8  => WIDTHS_COURIER
        9  => WIDTHS_COURIER_BOLD
        10 => WIDTHS_COURIER_OBLIQUE
        11 => WIDTHS_COURIER_BOLDOBLIQUE
        12 => WIDTHS_SYMBOL
        13 => WIDTHS_ZAPFDINGBATS
        _  => abort_font(font)

# The global metrics of the font numbered `font`, 0 to 13. Aborts on another.
function global_of(font: i64) -> Global
    return match font
        0  => global_helvetica()
        1  => global_helvetica_bold()
        2  => global_helvetica_oblique()
        3  => global_helvetica_boldoblique()
        4  => global_times_roman()
        5  => global_times_bold()
        6  => global_times_italic()
        7  => global_times_bolditalic()
        8  => global_courier()
        9  => global_courier_bold()
        10 => global_courier_oblique()
        11 => global_courier_boldoblique()
        12 => global_symbol()
        13 => global_zapfdingbats()
        _  => abort_global(font)

# The name of the font numbered `font`, 0 to 13, as PDF's `/BaseFont` writes it.
function base_font_of(font: i64) -> str
    return match font
        0  => "Helvetica"
        1  => "Helvetica-Bold"
        2  => "Helvetica-Oblique"
        3  => "Helvetica-BoldOblique"
        4  => "Times-Roman"
        5  => "Times-Bold"
        6  => "Times-Italic"
        7  => "Times-BoldItalic"
        8  => "Courier"
        9  => "Courier-Bold"
        10 => "Courier-Oblique"
        11 => "Courier-BoldOblique"
        12 => "Symbol"
        13 => "ZapfDingbats"
        _  => abort_name(font)

# Aborts: a font number outside 0 to 13 is a fault of this package.
function abort_font(font: i64) -> [i64]
    assert font >= 0 && font <= 13
    return []

# Aborts, as `abort_font`.
function abort_global(font: i64) -> Global
    assert font >= 0 && font <= 13
    return global_helvetica()

# Aborts, as `abort_font`.
function abort_name(font: i64) -> str
    assert font >= 0 && font <= 13
    return ""

test "widths_of: Helvetica's space, A and the euro, Courier's 600, Times-Italic's slant"
    assert widths_of(0)[32] == 278 && widths_of(0)[65] == 667 && widths_of(0)[0x80] == 556
    assert widths_of(8)[65] == 600 && widths_of(8)[31] == 0
    assert global_of(6).italic_angle == -15.5
    assert base_font_of(13) == "ZapfDingbats"
