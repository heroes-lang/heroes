# The global metrics of Helvetica, from `Helvetica.afm`.
function global_helvetica() -> Global
    return Global(
        ascent: 718,
        descent: -207,
        cap_height: 718,
        x_height: 523,
        italic_angle: 0.0,
        underline_position: -100,
        underline_thickness: 50,
        box: [-166, -225, 1000, 931],
        stem: 88
    )

