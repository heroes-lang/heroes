## Tests

test "UPPER_RANGES ascends"
    at: i64 @= 1

    while at < UPPER_RANGES.len()
        assert UPPER_RANGES[at - 1] < UPPER_RANGES[at]
        at @ at + 1

test "LOWER_RANGES ascends"
    at: i64 @= 1

    while at < LOWER_RANGES.len()
        assert LOWER_RANGES[at - 1] < LOWER_RANGES[at]
        at @ at + 1

test "TITLE_RANGES ascends"
    at: i64 @= 1

    while at < TITLE_RANGES.len()
        assert TITLE_RANGES[at - 1] < TITLE_RANGES[at]
        at @ at + 1

test "UPPER_SPECIAL_FROM ascends"
    at: i64 @= 1

    while at < UPPER_SPECIAL_FROM.len()
        assert UPPER_SPECIAL_FROM[at - 1] < UPPER_SPECIAL_FROM[at]
        at @ at + 1

test "TITLE_SPECIAL_FROM ascends"
    at: i64 @= 1

    while at < TITLE_SPECIAL_FROM.len()
        assert TITLE_SPECIAL_FROM[at - 1] < TITLE_SPECIAL_FROM[at]
        at @ at + 1

test "UPPER_RANGES and UPPER_DELTAS are as long"
    assert UPPER_RANGES.len() == UPPER_DELTAS.len()

test "LOWER_RANGES and LOWER_DELTAS are as long"
    assert LOWER_RANGES.len() == LOWER_DELTAS.len()

test "TITLE_RANGES and TITLE_DELTAS are as long"
    assert TITLE_RANGES.len() == TITLE_DELTAS.len()

test "UPPER_SPECIAL_FROM and UPPER_SPECIAL_TO are as long"
    assert UPPER_SPECIAL_FROM.len() == UPPER_SPECIAL_TO.len()

test "LOWER_SPECIAL_FROM and LOWER_SPECIAL_TO are as long"
    assert LOWER_SPECIAL_FROM.len() == LOWER_SPECIAL_TO.len()

test "TITLE_SPECIAL_FROM and TITLE_SPECIAL_TO are as long"
    assert TITLE_SPECIAL_FROM.len() == TITLE_SPECIAL_TO.len()
