# A digit of a base from 2 to 36, read from a code point and written as a
# character: `0` to `9`, then the letters of ASCII for ten to thirty-five, as
# a number is written in every base a program reads. Only ASCII is read here;
# the decimal digits of every script are `classes.digit_value`'s.

use unicode/internal/utf8
use unicode/internal/written

# The digits of base 36 in order, the letters in lower case.
constant DIGITS: str
    "0123456789abcdefghijklmnopqrstuvwxyz"

# The value of the code point `n` as a digit of `base`. Fails `invalid` where
# it is none. Aborts where `base` is not 2 to 36.
function digit_of(n: i64, base: i64) -> i64?
    assert base >= 2 && base <= 36

    value = if n >= '0' && n <= '9'
        n - '0'
    else if n >= 'a' && n <= 'z'
        n - 'a' + 10
    else if n >= 'A' && n <= 'Z'
        n - 'A' + 10
    else
        36

    if value >= base
        return fail(code: utf8.INVALID, msg: f"{written.code_point(n)} is no digit of base {base}")
    return ok(value)

# The character that writes `value` as a digit of `base`, a letter in lower
# case. Fails `invalid` where `value` is not 0 to `base` less one. Aborts
# where `base` is not 2 to 36.
function digit_text(value: i64, base: i64) -> str?
    assert base >= 2 && base <= 36

    if value < 0 || value >= base
        return fail(code: utf8.INVALID, msg: f"{value} is no digit of base {base}: they run from 0 to {base - 1}")
    return ok(DIGITS.slice(from: value, to: value + 1))

## Tests

# Rust 1.100's `char::to_digit`, observed 2026-11-15, answers each of these.
test "digit_of: the edges of each run, letters of either case, and what no base reads"
    assert digit_of(n: '0', base: 2).must() == 0
    assert digit_of(n: '1', base: 2).must() == 1
    assert digit_of(n: '2', base: 2).is_err()
    assert digit_of(n: '7', base: 8).must() == 7
    assert digit_of(n: '8', base: 8).is_err()
    assert digit_of(n: 'a', base: 10).is_err()
    assert digit_of(n: 'a', base: 16).must() == 10
    assert digit_of(n: 'F', base: 16).must() == 15
    assert digit_of(n: 'G', base: 16).is_err()
    assert digit_of(n: 'z', base: 36).must() == 35
    assert digit_of(n: 'Z', base: 36).must() == 35
    assert digit_of(n: ' ', base: 36).is_err()
    assert digit_of(n: 0x663, base: 10).is_err()
    assert digit_of(n: '/', base: 36).is_err()
    assert digit_of(n: ':', base: 36).is_err()
    assert digit_of(n: '@', base: 36).is_err()
    assert digit_of(n: '[', base: 36).is_err()
    assert digit_of(n: '`', base: 36).is_err()
    assert digit_of(n: '{', base: 36).is_err()

    match digit_of(n: '8', base: 8)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "U+0038 is no digit of base 8"

# Rust 1.100's `char::from_digit`, observed 2026-11-15, answers each of these.
test "digit_text: the smallest and largest digit of a base, one past it, and below 0"
    assert digit_text(value: 0, base: 2).must() == "0"
    assert digit_text(value: 1, base: 2).must() == "1"
    assert digit_text(value: 2, base: 2).is_err()
    assert digit_text(value: 4, base: 10).must() == "4"
    assert digit_text(value: 10, base: 10).is_err()
    assert digit_text(value: 10, base: 16).must() == "a"
    assert digit_text(value: 35, base: 36).must() == "z"
    assert digit_text(value: 36, base: 36).is_err()

    match digit_text(value: -1, base: 10)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "-1 is no digit of base 10: they run from 0 to 9"
