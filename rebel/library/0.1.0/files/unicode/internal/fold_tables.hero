## Tests

test "FOLD_RANGES ascends"
    at: i64 @= 1

    while at < FOLD_RANGES.len()
        assert FOLD_RANGES[at - 1] < FOLD_RANGES[at]
        at @ at + 1

test "ORBIT_UP_RANGES ascends"
    at: i64 @= 1

    while at < ORBIT_UP_RANGES.len()
        assert ORBIT_UP_RANGES[at - 1] < ORBIT_UP_RANGES[at]
        at @ at + 1

test "ORBIT_DOWN_RANGES ascends"
    at: i64 @= 1

    while at < ORBIT_DOWN_RANGES.len()
        assert ORBIT_DOWN_RANGES[at - 1] < ORBIT_DOWN_RANGES[at]
        at @ at + 1

test "FOLD_SPECIAL_FROM ascends"
    at: i64 @= 1

    while at < FOLD_SPECIAL_FROM.len()
        assert FOLD_SPECIAL_FROM[at - 1] < FOLD_SPECIAL_FROM[at]
        at @ at + 1

test "FOLD_RANGES and FOLD_DELTAS are as long"
    assert FOLD_RANGES.len() == FOLD_DELTAS.len()

test "ORBIT_UP_RANGES and ORBIT_UP_DELTAS are as long"
    assert ORBIT_UP_RANGES.len() == ORBIT_UP_DELTAS.len()

test "ORBIT_DOWN_RANGES and ORBIT_DOWN_DELTAS are as long"
    assert ORBIT_DOWN_RANGES.len() == ORBIT_DOWN_DELTAS.len()

test "FOLD_SPECIAL_FROM and FOLD_SPECIAL_TO are as long"
    assert FOLD_SPECIAL_FROM.len() == FOLD_SPECIAL_TO.len()
