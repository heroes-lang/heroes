    assert sweep.folded_numbers(question: simple_title, first: 0x10400, past: 0x10500) == 107353088
    assert sweep.folded_numbers(question: simple_title, first: 0x1d400, past: 0x1d800) == 495960294

test "next_in_fold: every code point of seven blocks, against Go's unicode"
    assert sweep.folded_numbers(question: next_in_fold, first: 0x0, past: 0x250) == 707065930
    assert sweep.folded_numbers(question: next_in_fold, first: 0x370, past: 0x530) == 670951217
    assert sweep.folded_numbers(question: next_in_fold, first: 0x2000, past: 0x2190) == 248149952
    assert sweep.folded_numbers(question: next_in_fold, first: 0x3000, past: 0x3100) == 121411654
