test "full_upper, full_title, full_fold: one character to several"
    assert unpacked(full_upper(0xdf)) == [0x53, 0x53]
    assert unpacked(full_title(0xdf)) == [0x53, 0x73]
    assert unpacked(full_fold(0xdf)) == [0x73, 0x73]
    assert unpacked(full_upper(0x390)) == [0x399, 0x308, 0x301]
    assert unpacked(full_lower(0x130)) == [0x69, 0x307]
    assert unpacked(full_upper(0x61)) == [0x41]

test "next_in_fold: round the kelvin sign, a letter alone, and numbers past the range"
    assert next_in_fold(0x4b) == 0x6b && next_in_fold(0x6b) == 0x212a && next_in_fold(0x212a) == 0x4b
    assert next_in_fold(0x31) == 0x31
    assert next_in_fold(-2) == -2 && next_in_fold(0x110000) == 0x110000

test "simple mappings: one with none, the title case of a digraph, and numbers past the range"
    assert simple_upper(0xdf) == 0xdf && simple_lower(0x41) == 0x61
    assert simple_title(0x1c6) == 0x1c5 && simple_upper(0x1c6) == 0x1c4
    assert simple_upper(-1) == -1 && simple_lower(0x110000) == 0x110000 && simple_title(9223372036854775807) == 9223372036854775807

test "unpacked: one, two and three code points"
    assert unpacked(0x41) == [0x41]
    assert unpacked(0x53 | 0x53 << 21) == [0x53, 0x53]
    assert unpacked(0x399 | 0x308 << 21 | 0x301 << 42) == [0x399, 0x308, 0x301]

test "mapped_text: a character the mapping leaves, one it changes, one it makes two"
    assert mapped_text(c: "1", n: 0x31, packed: full_upper(0x31)) == "1"
    assert mapped_text(c: "a", n: 0x61, packed: full_upper(0x61)) == "A"
    assert mapped_text(c: "ß", n: 0xdf, packed: full_upper(0xdf)) == "SS"
