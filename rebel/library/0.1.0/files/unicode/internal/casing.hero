# The case of a code point: the one-to-one mappings Unicode calls simple, the
# full ones that may write several characters, the folded form texts are
# compared by, and the walk round the code points that fold together.
#
# A full mapping is answered packed, `first | second << 21 | third << 42`, a
# second or third of 0 meaning none: no mapping writes U+0000 after its first
# character, and a mapping of one code point packs as the code point itself.

use unicode/internal/case_tables
use unicode/internal/fold_tables
use unicode/internal/search
use unicode/internal/sweep
use unicode/internal/utf8

# Whether `n` is outside 0 to U+10FFFF, where no table reaches.
function is_outside(n: i64) -> bool
    return n < 0 || n > 0x10ffff

# The simple upper case of `n`, or `n` where it has none.
function simple_upper(n: i64) -> i64
    if is_outside(n)
        return n
    return search.mapped(ranges: case_tables.UPPER_RANGES, deltas: case_tables.UPPER_DELTAS, n: n, otherwise: n)

# The simple lower case of `n`, or `n` where it has none.
function simple_lower(n: i64) -> i64
    if is_outside(n)
        return n
    return search.mapped(ranges: case_tables.LOWER_RANGES, deltas: case_tables.LOWER_DELTAS, n: n, otherwise: n)

# The simple title case of `n`, which is its upper case but where
# `TITLE_RANGES` says otherwise, or `n` where it has none.
function simple_title(n: i64) -> i64
    if is_outside(n)
        return n
    return search.mapped(
        ranges: case_tables.TITLE_RANGES,
        deltas: case_tables.TITLE_DELTAS,
        n: n,
        otherwise: simple_upper(n)
    )

# The simple folded form of `n`, which is its lower case but where
# `FOLD_RANGES` says otherwise.
function simple_fold_form(n: i64) -> i64
    return search.mapped(
        ranges: fold_tables.FOLD_RANGES,
        deltas: fold_tables.FOLD_DELTAS,
        n: n,
        otherwise: simple_lower(n)
    )

# The next code point that folds as `n` does: the smallest above it, else the
# smallest of all; `n` where none other does.
function next_in_fold(n: i64) -> i64
    if is_outside(n)
        return n
    below = search.mapped(
        ranges: fold_tables.ORBIT_DOWN_RANGES,
        deltas: fold_tables.ORBIT_DOWN_DELTAS,
        n: n,
        otherwise: n
    )
    return search.mapped(
        ranges: fold_tables.ORBIT_UP_RANGES,
        deltas: fold_tables.ORBIT_UP_DELTAS,
        n: n,
        otherwise: below
    )

# The full upper case of `n`, packed.
function full_upper(n: i64) -> i64
    return search.looked_up(
        sources: case_tables.UPPER_SPECIAL_FROM,
        targets: case_tables.UPPER_SPECIAL_TO,
        n: n,
        otherwise: simple_upper(n)
    )

# The full lower case of `n`, packed.
function full_lower(n: i64) -> i64
    return search.looked_up(
        sources: case_tables.LOWER_SPECIAL_FROM,
        targets: case_tables.LOWER_SPECIAL_TO,
        n: n,
        otherwise: simple_lower(n)
    )

# The full title case of `n`, packed.
function full_title(n: i64) -> i64
    return search.looked_up(
        sources: case_tables.TITLE_SPECIAL_FROM,
        targets: case_tables.TITLE_SPECIAL_TO,
        n: n,
        otherwise: simple_title(n)
    )

# The full folded form of `n`, packed.
function full_fold(n: i64) -> i64
    return search.looked_up(
        sources: fold_tables.FOLD_SPECIAL_FROM,
        targets: fold_tables.FOLD_SPECIAL_TO,
        n: n,
        otherwise: simple_fold_form(n)
    )

# The code points of a packed mapping, one to three.
function unpacked(packed: i64) -> [i64]
    points: [i64] @= [packed & 0x1fffff]
    second = packed >> 21 & 0x1fffff
    third = packed >> 42 & 0x1fffff

    if second != 0
        points @ points.push(second)

    if third != 0
        points @ points.push(third)
    return points

# The text a full mapping of `c`, whose code point is `n`, writes: `c` itself
# where the mapping leaves it as it is.
function mapped_text(c: str, n: i64, packed: i64) -> str
    if packed == n
        return c
    return utf8.text_of(unpacked(packed))

## Tests

# The expected numbers are the fold of `sweep` over what Python 3.15.2's
# `unicodedata` and `str` methods and Go 1.27.3's `unicode` answer for the
# same code points, observed 2026-11-15, both reading Unicode 17.0.0; the
# seven blocks are Latin to Latin Extended-B (U+0000 to U+024F), Greek and
# Cyrillic (U+0370 to U+052F), General Punctuation to Number Forms (U+2000
# to U+218F), CJK Symbols and Punctuation, Hiragana and Katakana (U+3000 to
# U+30FF), the Halfwidth and Fullwidth Forms (U+FF00 to U+FFEF), Deseret to
# Osage (U+10400 to U+104FF) and the Mathematical Alphanumeric Symbols
# (U+1D400 to U+1D7FF): 3,216 code points for each question.

test "simple_upper: every code point of seven blocks, against Go's unicode"
    assert sweep.folded_numbers(question: simple_upper, first: 0x0, past: 0x250) == 245452044
    assert sweep.folded_numbers(question: simple_upper, first: 0x370, past: 0x530) == 144244140
    assert sweep.folded_numbers(question: simple_upper, first: 0x2000, past: 0x2190) == 34641508
    assert sweep.folded_numbers(question: simple_upper, first: 0x3000, past: 0x3100) == 121411654
    assert sweep.folded_numbers(question: simple_upper, first: 0xff00, past: 0xfff0) == 526075667
    assert sweep.folded_numbers(question: simple_upper, first: 0x10400, past: 0x10500) == 107353088
    assert sweep.folded_numbers(question: simple_upper, first: 0x1d400, past: 0x1d800) == 495960294

test "simple_lower: every code point of seven blocks, against Go's unicode"
    assert sweep.folded_numbers(question: simple_lower, first: 0x0, past: 0x250) == 610671422
    assert sweep.folded_numbers(question: simple_lower, first: 0x370, past: 0x530) == 259711448
    assert sweep.folded_numbers(question: simple_lower, first: 0x2000, past: 0x2190) == 473247259
    assert sweep.folded_numbers(question: simple_lower, first: 0x3000, past: 0x3100) == 121411654
    assert sweep.folded_numbers(question: simple_lower, first: 0xff00, past: 0xfff0) == 672680283
    assert sweep.folded_numbers(question: simple_lower, first: 0x10400, past: 0x10500) == 575974035
    assert sweep.folded_numbers(question: simple_lower, first: 0x1d400, past: 0x1d800) == 495960294

