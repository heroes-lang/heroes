test "full_fold: every code point of seven blocks, against Python's str"
    assert sweep.folded_numbers(question: full_fold, first: 0x0, past: 0x250) == 293339529
    assert sweep.folded_numbers(question: full_fold, first: 0x370, past: 0x530) == 826047745
    assert sweep.folded_numbers(question: full_fold, first: 0x2000, past: 0x2190) == 473247259
