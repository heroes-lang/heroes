# The escape sequences of ECMA-48 that terminals read in a text and draw as
# nothing: a colour, a cursor's move, a window's title. `width.hero` and
# `wrap.hero` take them out of the text they measure and put them back where
# they stood.
#
# A sequence begins with ESC (U+001B) or with the C1 controls CSI (U+009B)
# and OSC (U+009D). After ESC: `[` begins a control sequence, which runs to
# its final byte, 0x40 to 0x7E, through parameter bytes 0x30 to 0x3F and
# intermediate bytes 0x20 to 0x2F; `]`, `P`, `X`, `^` and `_` begin a control
# string, which runs to BEL (U+0007) or to the string terminator (ESC `\` or
# U+009C); any other byte 0x20 to 0x2F begins intermediates and a final byte
# 0x30 to 0x7E; any byte 0x30 to 0x7E is a sequence of its own. A sequence
# the text ends inside runs to the end; a byte a sequence cannot hold ends it
# before that byte, so every byte of the text is read once and no sequence
# swallows what follows a malformed one.

# A sequence taken out of a text, and where it stood.
record Escape
    # The byte index in the text without its sequences that it stood before.
    at: i64
    # The sequence, as it was written.
    written: str

# A text without its escape sequences, and the sequences.
record Stripped
    # The text without its sequences.
    plain: str
    # The sequences, in the order they stood.
    escapes: [Escape]

# Whether the byte `b` may stand inside a control sequence before its final
# byte: a parameter byte or an intermediate one.
function is_csi_inner(b: u8) -> bool
    return b >= 0x20 && b <= 0x3f

# Where a control sequence whose first parameter byte is at `from` ends: just
# after its final byte, before a byte it cannot hold, or at the end.
function csi_end(s: str, from: i64) -> i64
    at: i64 @= from

    while at < s.len() && is_csi_inner(s[at])
        at @ at + 1

    if at < s.len() && s[at] >= 0x40 && s[at] <= 0x7e
        return at + 1
    return at

# Where a control string whose first byte is at `from` ends: just after BEL
# or the string terminator, or at the end.
function string_end(s: str, from: i64) -> i64
    at: i64 @= from

    while at < s.len()
        if s[at] == 0x07
            return at + 1

        if s[at] == 0x1b && at + 1 < s.len() && s[at + 1] == '\\'
            return at + 2

        if s[at] == 0xc2 && at + 1 < s.len() && s[at + 1] == 0x9c
            return at + 2
        at @ at + 1

    return at

# Where the escape sequence that begins at byte `at` of `s` ends; `at` where
# none begins there.
function sequence_end(s: str, at: i64) -> i64
    if at >= s.len()
        return at
    first = s[at]

    if first == 0xc2 && at + 1 < s.len() && s[at + 1] == 0x9b
        return csi_end(s, from: at + 2)

    if first == 0xc2 && at + 1 < s.len() && s[at + 1] == 0x9d
        return string_end(s, from: at + 2)

    if first != 0x1b
        return at

    if at + 1 == s.len()
        return at + 1
    second = s[at + 1]

    if second == '['
        return csi_end(s, from: at + 2)

    if second == ']' || second == 'P' || second == 'X' || second == '^' || second == '_'
        return string_end(s, from: at + 2)

    if second >= 0x20 && second <= 0x2f
        end: i64 @= at + 2

        while end < s.len() && s[end] >= 0x20 && s[end] <= 0x2f
            end @ end + 1

        if end < s.len() && s[end] >= 0x30 && s[end] <= 0x7e
            return end + 1
        return end

    if second >= 0x30 && second <= 0x7e
        return at + 2
    return at + 1

# Whether `s` may hold an escape sequence: a byte ESC, or the first byte of
# CSI and OSC.
function may_hold(s: str) -> bool
    for c in s.chars()
        if c[0] == 0x1b || c[0] == 0xc2 && c.len() == 2 && (c[1] == 0x9b || c[1] == 0x9d)
            return true

    return false

# `s` without its escape sequences, and the sequences.
function strip(s: str) -> Stripped
    escapes: [Escape] @= []

    if !may_hold(s)
        return Stripped(plain: s, escapes: escapes)
    pieces: [str] @= []
    plain_len: i64 @= 0
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        end = sequence_end(s, at: at)

        if end > at
            if at > start
                pieces @ pieces.push(s.slice(from: start, to: at))
                plain_len @ plain_len + at - start
            escapes @ escapes.push(Escape(at: plain_len, written: s.slice(from: at, to: end)))
            at @ end
            start @ end
        else
            at @ at + 1

    if s.len() > start
        pieces @ pieces.push(s.slice(from: start, to: s.len()))
    return Stripped(plain: pieces.join(""), escapes: escapes)

## Tests

test "sequence_end: a colour, a title, a character set, a lone ESC, a C1 CSI, one the text ends inside, and plain text"
    assert sequence_end(s: "\u{1b}[31mx", at: 0) == 5
    assert sequence_end(s: "\u{1b}[38;5;208mx", at: 0) == 11
    assert sequence_end(s: "\u{1b}]0;title\u{7}x", at: 0) == 10
    assert sequence_end(s: "\u{1b}]8;;https://a.b\u{1b}\\x", at: 0) == 18
    assert sequence_end(s: "\u{1b}(Bx", at: 0) == 3
    assert sequence_end(s: "\u{1b}7x", at: 0) == 2
    assert sequence_end(s: "\u{1b}", at: 0) == 1
    assert sequence_end(s: "\u{9b}1mx", at: 0) == 4
    assert sequence_end(s: "\u{1b}[12", at: 0) == 4
    assert sequence_end(s: "\u{1b}[1\u{1b}[2m", at: 0) == 3
    assert sequence_end(s: "abc", at: 1) == 1
    assert sequence_end(s: "é", at: 0) == 0

test "strip: no sequence, sequences at both ends and inside, and one in a word of more than one byte"
    plain = strip("plain")
    assert plain.plain == "plain" && plain.escapes == []
    styled = strip("\u{1b}[1mbold\u{1b}[0m and \u{1b}[31mré\u{1b}[0md")
    assert styled.plain == "bold and réd"
    assert styled.escapes == [Escape(at: 0, written: "\u{1b}[1m"), Escape(at: 4, written: "\u{1b}[0m"), Escape(at: 9, written: "\u{1b}[31m"), Escape(at: 12, written: "\u{1b}[0m")]
    assert strip("").plain == ""
