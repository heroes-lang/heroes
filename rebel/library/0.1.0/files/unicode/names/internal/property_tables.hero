## Tests

test "property_tables: the runs begin at 0, the tables ascend, and each pair is as long as the other"
    assert SCRIPT_RUNS[0] >> 8 == 0 && BIDI_RUNS[0] >> 8 == 0

    for table in [SCRIPT_RUNS, EXTENSION_RANGES, BLOCKS, NUMERIC_POINTS, BIDI_RUNS, MIRRORED, MIRROR_SOURCES]
        at: i64 @= 1

        while at < table.len()
            assert table[at - 1] < table[at]
            at @ at + 1

    assert SCRIPT_ALIASES.len() == SCRIPT_ALIAS_TARGETS.len()
    assert PROPERTY_ALIASES.len() == PROPERTY_ALIAS_TARGETS.len()
    assert PROPERTY_STARTS.len() == PROPERTY_NAMES.len() + 1
    assert NUMERATORS.len() == NUMERIC_POINTS.len() && DENOMINATORS.len() == NUMERIC_POINTS.len()
    assert MIRROR_TARGETS.len() == MIRROR_SOURCES.len()
