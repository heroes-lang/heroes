## Tests

test "tables: every table ascends, and each pair of tables is as long as the other"
    for table in [COMBINING, DECOMPOSITIONS, COMPOSE_PAIRS, NFC_QUICK, NFKC_QUICK, CASEFOLD_RANGES, SOFT_DOTTED]
        at: i64 @= 1

        while at < table.len()
            assert table[at - 1] < table[at]
            at @ at + 1

    assert COMPOSE_PAIRS.len() == COMPOSED.len()
    assert CASEFOLD_RANGES.len() == CASEFOLD_TARGETS.len()
    assert KINDS[0] == "canonical"
