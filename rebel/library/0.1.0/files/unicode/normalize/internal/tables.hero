# The tables of `unicode/normalize`, in Unicode 17.0.0: the canonical
# combining classes, the decompositions, the compositions, the quick checks of
# UAX #15, NFKC_Casefold and the soft-dotted letters.
#
# Generated, never edited by hand: the Heroes program
# `rebel/generators/unicode_normalize/` read the Unicode Character Database 17.0.0,
# each file held to its SHA-256, packed it into the tables below, and wrote
# this module whole; its `check` command says whether this module is still
# what it writes. What it read:
#
# - `UnicodeData.txt`, SHA-256 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c
# - `DerivedNormalizationProps.txt`, SHA-256 71fd6a206a2c0cdd41feb6b7f656aa31091db45e9cedc926985d718397f9e488
# - `PropList.txt`, SHA-256 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd

# The kinds of a decomposition, in the order `DECOMPOSITIONS` numbers them:
# the canonical one first, then the tags of `UnicodeData.txt`.
constant KINDS: [str]
    [
        "canonical"
        "noBreak"
        "compat"
        "super"
        "fraction"
        "sub"
        "font"
        "circle"
        "wide"
        "vertical"
        "square"
        "isolated"
        "final"
        "initial"
        "medial"
        "small"
        "narrow"
    ]

