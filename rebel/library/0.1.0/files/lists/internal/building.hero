# New lists built from others: joined, flattened, repeated, cut or grown to a
# length, interspersed, the running values of a fold, and the elements a list
# of bools marks. Each grows one local list with `push`, which grows in place.

use lists/internal/samples

# The elements of `xs` followed by those of `then`.
function concat<T>(xs: [T], then: [T]) -> [T]
    out: [T] @= xs

    for x in then
        out @ out.push(x)

    return out

# The elements of every list of `xss`, in order, as one list.
function flatten<T>(xss: [[T]]) -> [T]
    out: [T] @= []

    for xs in xss
        for x in xs
            out @ out.push(x)

    return out

# The elements of `xs`, `times` times over; aborts where `times` is below
# zero. An empty list stays empty whatever `times` is, without a loop.
function cycle<T>(xs: [T], times: i64) -> [T]
    assert times >= 0
    out: [T] @= []

    if xs.len() == 0
        return out
    done: i64 @= 0

    while done < times
        for x in xs
            out @ out.push(x)

        done @ done + 1

    return out

# `xs` cut or grown to `size`, grown with copies of `fill`; aborts where
# `size` is below zero.
function resize<T>(xs: [T], size: i64, fill: T) -> [T]
    assert size >= 0

    if size <= xs.len()
        return xs.slice(from: 0, to: size)
    out: [T] @= xs

    while out.len() < size
        out @ out.push(fill)

    return out

# The elements of `xs` with `sep` between each two.
function intersperse<T>(xs: [T], sep: T) -> [T]
    out: [T] @= []

    for x in xs
        if out.len() > 0
            out @ out.push(sep)
        out @ out.push(x)

    return out

# What `fold` holds after each element of `xs`, `start` not among them.
function accumulate<T, A>(xs: [T], start: A, combine: (function(acc: A, item: T) -> A)) -> [A]
    out: [A] @= []
    acc: A @= start

    for x in xs
        acc @ combine(acc: acc, item: x)
        out @ out.push(acc)

    return out

# The elements of `xs` whose place in `keeps` holds `true`, as far as the
# shorter of the two.
function select<T>(xs: [T], keeps: [bool]) -> [T]
    out: [T] @= []
    at: i64 @= 0

    while at < xs.len() && at < keeps.len()
        if keeps[at]
            out @ out.push(xs[at])
        at @ at + 1

    return out

## Tests

test "concat: two lists, either empty, both empty, and texts of more than one byte"
    nothing: [i64] = []
    assert concat(xs: [1, 2], then: [3]) == [1, 2, 3]
    assert concat(xs: nothing, then: [3]) == [3]
    assert concat(xs: [1], then: nothing) == [1]
    assert concat(xs: nothing, then: nothing) == nothing
    assert concat(xs: ["é"], then: ["日本"]) == ["é", "日本"]

test "flatten: lists of several lengths, an empty one inside, none, and only empty ones"
    nothing: [i64] = []
    no_lists: [[i64]] = []
    assert flatten([[1], nothing, [2, 3]]) == [1, 2, 3]
    assert flatten(no_lists) == nothing
    assert flatten([nothing, nothing]) == nothing

test "cycle: three times, once, zero times, an empty list, and an empty list the largest number of times"
    nothing: [i64] = []
    assert cycle([1, 2], 3) == [1, 2, 1, 2, 1, 2]
    assert cycle([1, 2], 1) == [1, 2]
    assert cycle([1, 2], 0) == nothing
    assert cycle(nothing, 3) == nothing
    assert cycle(nothing, 9_223_372_036_854_775_807) == nothing
    assert cycle([false], 3) == [false, false, false]

test "resize: grown, cut, the same length, to zero, and from an empty list"
    nothing: [i64] = []
    assert resize([1, 2], 4, 0) == [1, 2, 0, 0]
    assert resize([1, 2, 3], 1, 0) == [1]
    assert resize([1, 2], 2, 0) == [1, 2]
    assert resize([1, 2], 0, 0) == nothing
    assert resize(nothing, 2, 7) == [7, 7]
    assert resize(["é"], 2, "") == ["é", ""]

test "intersperse: several, two, one, and an empty list"
    nothing: [i64] = []
    assert intersperse([1, 2, 3], 0) == [1, 0, 2, 0, 3]
    assert intersperse([1, 2], 0) == [1, 0, 2]
    assert intersperse([1], 0) == [1]
    assert intersperse(nothing, 0) == nothing

test "accumulate: running sums, a start, texts, one element, and an empty list"
    nothing: [i64] = []
    no_texts: [str] = []
    assert accumulate([1, 2, 3, 4], 0, samples.add) == [1, 3, 6, 10]
    assert accumulate([1, 2, 3], 10, samples.add) == [11, 13, 16]
    assert accumulate(["a", "b", "é"], "", samples.append) == ["a", "ab", "abé"]
    assert accumulate([5], 0, samples.add) == [5]
    assert accumulate(nothing, 0, samples.add) == nothing
    assert accumulate(no_texts, "x", samples.append) == no_texts

test "select: marks, fewer marks than elements, more marks, none, and an empty list"
    nothing: [str] = []
    no_marks: [bool] = []
    assert select(["A", "B", "C", "D", "E", "F"], [true, false, true, false, true, true]) == ["A", "C", "E", "F"]
    assert select([1, 2, 3], [true]) == [1]
    assert select([1], [true, true, true]) == [1]
    assert select(["a"], no_marks) == nothing
    assert select(nothing, [true]) == nothing
