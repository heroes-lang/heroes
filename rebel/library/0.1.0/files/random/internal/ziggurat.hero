# The fraction in [0, 1) that the top 53 bits of `word` make.
function top_fraction(word: i64) -> f64
    return to_f64(wide.shift_right(x: word, n: 11)) / 9007199254740992.0

# The point a normal draw's first number makes across its layer, the low 7
# bits of `word` choosing the layer: 0 or more, its sign apart.
function normal_point(word: i64) -> f64
    return top_fraction(word) * NORMAL_X[word & 127]

# Whether the point `x` of the layer the low 7 bits of `word` choose is under
# the curve whatever its height: short of the next layer's width.
function normal_inside(word: i64, x: f64) -> bool
    return x < NORMAL_X[(word & 127) + 1]

# Whether the point `x` of layer `layer`, 1 or more, at the height a fraction
# `w` of the way up the layer, is under the curve.
function normal_wedge(layer: i64, x: f64, w: f64) -> bool
    below = math.exp(-0.5 * NORMAL_X[layer] * NORMAL_X[layer])
    above = math.exp(-0.5 * NORMAL_X[layer + 1] * NORMAL_X[layer + 1])
    return below + w * (above - below) < math.exp(-0.5 * x * x)

# `x` with the sign bit 7 of `word` gives it.
function signed(word: i64, x: f64) -> f64
    if word & 128 == 0
        return x
    return -x

# The point an exponential draw's first number makes across its layer, the
# low 8 bits of `word` choosing the layer.
function exponential_point(word: i64) -> f64
    return top_fraction(word) * EXPONENTIAL_X[word & 255]

# Whether the point `x` of the layer the low 8 bits of `word` choose is under
# the curve whatever its height.
function exponential_inside(word: i64, x: f64) -> bool
    return x < EXPONENTIAL_X[(word & 255) + 1]

# Whether the point `x` of layer `layer`, 1 or more, at the height a fraction
# `w` of the way up the layer, is under the curve.
function exponential_wedge(layer: i64, x: f64, w: f64) -> bool
    below = math.exp(-EXPONENTIAL_X[layer])
    above = math.exp(-EXPONENTIAL_X[layer + 1])
    return below + w * (above - below) < math.exp(-x)

test "the normal's widths: the base's, each the curve's inverse where the layer below ends, the top closed, and the tail's area"
    x = NORMAL_X
    assert x.len() == 129 && x[1] == NORMAL_R && x[128] == 0.0
    height = math.exp(-0.5 * NORMAL_R * NORMAL_R)
    assert math.abs(x[0] - NORMAL_AREA / height) <= 0.000000000001 * x[0]
    tail = math.sqrt(math.PI / 2.0) * math.erfc(NORMAL_R / math.SQRT_2)
    assert math.abs(NORMAL_R * height + tail - NORMAL_AREA) <= 0.000000000001 * NORMAL_AREA

    for i in range(from: 1, to: 127)
        next = math.sqrt(-2.0 * math.ln(NORMAL_AREA / x[i] + math.exp(-0.5 * x[i] * x[i])))
        assert math.abs(next - x[i + 1]) <= 0.000000000001 * x[i + 1]
        assert x[i + 1] < x[i]

    top = x[127] * (1.0 - math.exp(-0.5 * x[127] * x[127]))
    assert math.abs(top - NORMAL_AREA) <= 0.000000000001 * NORMAL_AREA

test "the exponential's widths: the base's, each the curve's inverse where the layer below ends, the top closed, and the tail's area"
    x = EXPONENTIAL_X
    assert x.len() == 257 && x[1] == EXPONENTIAL_R && x[256] == 0.0
    height = math.exp(-EXPONENTIAL_R)
    assert math.abs(x[0] - EXPONENTIAL_AREA / height) <= 0.000000000001 * x[0]
    assert math.abs(EXPONENTIAL_R * height + height - EXPONENTIAL_AREA) <= 0.000000000001 * EXPONENTIAL_AREA

    for i in range(from: 1, to: 255)
        next = -math.ln(EXPONENTIAL_AREA / x[i] + math.exp(-x[i]))
        assert math.abs(next - x[i + 1]) <= 0.000000000001 * x[i + 1]
        assert x[i + 1] < x[i]

    top = x[255] * (1.0 - math.exp(-x[255]))
    assert math.abs(top - EXPONENTIAL_AREA) <= 0.000000000001 * EXPONENTIAL_AREA

test "top_fraction, normal_point and signed: the top 53 bits, the layer's width, and bit 7 the sign"
    assert top_fraction(0) == 0.0
    assert top_fraction(-1) == 1.0 - 1.0 / 9007199254740992.0
    assert top_fraction(2047) == 0.0
    assert normal_point(-1) == (1.0 - 1.0 / 9007199254740992.0) * NORMAL_X[127]
    assert signed(word: 128, x: 1.5) == -1.5 && signed(word: 127, x: 1.5) == 1.5
    assert exponential_point(255 + 2048) == EXPONENTIAL_X[255] / 9007199254740992.0
