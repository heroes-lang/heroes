    seen = canned.requests_of(@t)
    assert strings.has_prefix(s: seen[0], prefix: "DELETE /responses/resp_1\n")

# Every event of a response stream, and the response they make.
test "response_stream: a text and a function call, to response.completed"
    t @= canned.start([canned.stream_answer(content_type: "text/event-stream", body: canned.response_events())])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    s @= response_stream(
        c,
        r: response_request(model: "gpt-test", input: [input_message(role: "user", text: "Hi")])
    ).must()
    seen: [str] @= []

    while true
        match next_response_event(@s)
            .err e =>
                assert e.code == CLOSED
                break
            .ok event =>
                match event
                    .created v         => seen @ seen.push("created " + v.response.status)
                    .item_added v      => seen @ seen.push(f"added {v.output_index}")
                    .item_done v       => seen @ seen.push(f"done {v.output_index}")
                    .text_delta v      => seen @ seen.push("text " + v.delta)
                    .text_done v       => seen @ seen.push("text whole " + v.text)
                    .arguments_delta v => seen @ seen.push("arguments " + v.delta)
                    .arguments_done v  => seen @ seen.push("arguments whole " + v.arguments)
                    .refusal_delta v   => seen @ seen.push("refusal " + v.delta)
                    .completed v       => seen @ seen.push("completed " + v.response.status)
                    .incomplete v      => seen @ seen.push("incomplete " + v.response.status)
                    .failed v          => seen @ seen.push("failed " + v.response.status)
                    .other v           => seen @ seen.push("other " + v.name)

    r = final_response(@s).must()
    close_response_stream(@s)
    sent = canned.requests_of(@t)
    assert seen == ["created in_progress", "added 0", "text Hi", "text  there", "text whole Hi there", "done 0", "added 1", "arguments {\"city\":", "arguments \"Paris\"}", "arguments whole {\"city\":\"Paris\"}", "completed completed"]
    assert output_text_of(r) == "Hi there" && function_calls_of(r)[0].arguments == "{\"city\":\"Paris\"}"
    assert strings.has_suffix(s: sent[0], suffix: ",\"stream\":true}")

# The next event of a response stream.
test "next_response_event: response.created"
    t @= canned.start([canned.stream_answer(content_type: "text/event-stream", body: canned.response_events())])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    s @= response_stream(c, r: response_request(model: "m", input: [])).must()

    match next_response_event(@s).must()
        .created v => assert v.response.id == "resp_1"
        .item_added _ | .item_done _ | .text_delta _ | .text_done _ | .arguments_delta _ | .arguments_done _ | .refusal_delta _ | .completed _ | .incomplete _ | .failed _ | .other _ =>
            assert false

    close_response_stream(@s)
    _ = canned.requests_of(@t)

# What has arrived of a response, while it arrives.
test "response_so_far: a message's text as far as it came"
    t @= canned.start([canned.stream_answer(content_type: "text/event-stream", body: canned.response_events())])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    s @= response_stream(c, r: response_request(model: "m", input: [])).must()
    _ = next_response_event(@s).must()
    _ = next_response_event(@s).must()
    _ = next_response_event(@s).must()
    r = response_so_far(s).must()
    close_response_stream(@s)
    _ = canned.requests_of(@t)
    assert output_text_of(r) == "Hi" && r.status == STATUS_IN_PROGRESS

# A response stream read to its end.
