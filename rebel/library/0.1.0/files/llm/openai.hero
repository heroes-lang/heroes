# A response the server keeps, deleted.
test "delete_response: by its id"
    t @= canned.start(
        [canned.json_answer(status: 200, body: "{\"id\":\"resp_1\",\"object\":\"response\",\"deleted\":true}", fields: [])]
    )
    c @= default_client("k")
