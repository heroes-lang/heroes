# A request of the Responses API.
test "response_request: one input message"
    r = response_request(model: "gpt-test", input: [input_message(role: "user", text: "Hello!")])
    assert r.input.len() == 1 && r.previous_response_id == ""

# An input message.
test "input_message: a user's"
    assert json.format(input_message(role: "user", text: "Hi")).must() == "{\"role\":\"user\",\"content\":\"Hi\"}"

# A function's output, an input item.
test "function_output: the call it answers"
    assert json.format(function_output(call_id: "call_1", output: "15")).must() == "{\"type\":\"function_call_output\",\"call_id\":\"call_1\",\"output\":\"15\"}"

# A parameter of the Responses API set by its name.
test "with_response_field: max_output_tokens"
    r = with_response_field(
        response_request(model: "m", input: []),
        name: "max_output_tokens",
        value: json.from_int(64).must()
    )
    assert json.format(response_request_json(r).must()).must() == "{\"model\":\"m\",\"input\":[],\"max_output_tokens\":64}"

# The body a response request sends.
test "response_request_json: instructions, a function and a previous response"
    r @= response_request(model: "gpt-test", input: [input_message(role: "user", text: "Hi")])
    r.instructions @ "Be brief."
    r.tools @ [Function(name: "f", description: "", parameters: .null_value, strict: false)]
    r.previous_response_id @ "resp_0"
    expected = "{\"model\":\"gpt-test\",\"input\":[{\"role\":\"user\",\"content\":\"Hi\"}],\"instructions\":\"Be brief.\",\"tools\":[{\"type\":\"function\",\"name\":\"f\",\"strict\":false}],\"previous_response_id\":\"resp_0\"}"
    assert json.format(response_request_json(r).must()).must() == expected

# A response read from its JSON.
test "response_of: a response's usage"
    r = response_of(json.parse(canned.response(output: "[]", status: "completed")).must()).must()
    assert r.status == STATUS_COMPLETED && r.usage.input_tokens == 36 && r.usage.reasoning_tokens == 5

# A response read from its text.
test "parse_response: a response's text"
    assert parse_response(canned.response(output: "[]", status: "completed")).must().id == "resp_1"

# The text of a response.
test "output_text_of: a message's text"
    r = parse_response(
        canned.response(output: "[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hi\",\"annotations\":[]}]}]", status: "completed")
    ).must()
    assert output_text_of(r) == "Hi"

# The calls of a response.
test "function_calls_of: one call"
    r = parse_response(
        canned.response(output: "[{\"type\":\"function_call\",\"id\":\"fc_1\",\"call_id\":\"call_1\",\"name\":\"f\",\"arguments\":\"{}\"}]", status: "completed")
    ).must()
    assert function_calls_of(r) == [ToolCall(id: "call_1", name: "f", arguments: "{}")]

# A response checked before its output is read.
test "require_complete: a completed response"
    assert require_complete(parse_response(canned.response(output: "[]", status: "completed")).must()).must().id == "resp_1"

# A tool loop of the Responses API, the state kept by the program.
test "with_function_outputs: a function call answered"
    first = canned.response(
        output: "[{\"type\":\"function_call\",\"id\":\"fc_1\",\"call_id\":\"call_1\",\"name\":\"get_weather\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"status\":\"completed\"}]",
        status: "completed"
    )
    second = canned.response(
        output: "[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Sunny.\",\"annotations\":[]}]}]",
        status: "completed"
    )
    t @= canned.start(
        [canned.json_answer(status: 200, body: first, fields: []), canned.json_answer(status: 200, body: second, fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    r @= response_request(model: "gpt-test", input: [input_message(role: "user", text: "Weather in Paris?")])
    reply = create_response(c, r: r).must()
    outputs: [json.Value] @= []

    for call in function_calls_of(reply)
        outputs @ outputs.push(function_output(call_id: call.id, output: "sunny"))

    r @ with_function_outputs(r, reply: reply, outputs: outputs)
    last = create_response(c, r: r).must()
    seen = canned.requests_of(@t)
    assert output_text_of(last) == "Sunny." && r.input.len() == 3
    assert strings.contains(
        s: seen[1],
        substr: "{\"type\":\"function_call_output\",\"call_id\":\"call_1\",\"output\":\"sunny\"}"
    )

