# The tokens a response request would cost.
test "count_input_tokens: a request counted, its max_output_tokens not sent"
    t @= canned.start(
        [canned.json_answer(status: 200, body: "{\"object\":\"response.input_tokens\",\"input_tokens\":11}", fields: [])]
    )
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    r = with_response_field(
        response_request(model: "gpt-test", input: [input_message(role: "user", text: "Hi")]),
        name: "max_output_tokens",
        value: json.from_int(64).must()
    )
    n = count_input_tokens(c, r: r).must()
    seen = canned.requests_of(@t)
    assert n == 11 && strings.has_prefix(s: seen[0], prefix: "POST /responses/input_tokens\n")
    assert strings.has_suffix(
        s: seen[0],
        suffix: "\n\n{\"model\":\"gpt-test\",\"input\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
    )

# A background response cancelled.
test "cancel_response: by its id"
