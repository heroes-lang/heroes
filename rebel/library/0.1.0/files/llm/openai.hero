        r: response_request(model: "gpt-test", input: [input_message(role: "user", text: "Hi")])
    ).must()
    seen = canned.requests_of(@t)
    assert r.id == "resp_1" && strings.has_prefix(s: seen[0], prefix: "POST /responses\n")

