# A request to embed two texts.
test "embedding_request: two texts, the model's own length"
    r = embedding_request(model: "text-embedding-3-small", inputs: ["a", "b"])
    assert r.dimensions == 0 && r.inputs.len() == 2

# Two texts embedded.
test "embed: two vectors of the length asked"
    answer = "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[0.25,-0.5]},{\"object\":\"embedding\",\"index\":1,\"embedding\":[1,0]}],\"model\":\"text-embedding-3-small\",\"usage\":{\"prompt_tokens\":4,\"total_tokens\":4}}"
    t @= canned.start([canned.json_answer(status: 200, body: answer, fields: [])])
    c @= default_client("k")
    c.base_url @ canned.base(t.port)
    r @= embedding_request(model: "text-embedding-3-small", inputs: ["Hello", "Zürich"])
    r.dimensions @ 2
    e = embed(c, r: r).must()
    seen = canned.requests_of(@t)
    assert e.vectors == [[0.25, -0.5], [1.0, 0.0]] && e.usage.total_tokens == 4
    assert strings.has_suffix(
        s: seen[0],
        suffix: "\n\n{\"model\":\"text-embedding-3-small\",\"input\":[\"Hello\",\"Zürich\"],\"encoding_format\":\"float\",\"dimensions\":2}"
    )

