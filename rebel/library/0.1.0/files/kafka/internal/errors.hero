        "INVALID_VOTER_KEY"
        "DUPLICATE_VOTER"
        "VOTER_NOT_FOUND"
        "INVALID_REGULAR_EXPRESSION"
        "REBOOTSTRAP_REQUIRED"
        "STREAMS_INVALID_TOPOLOGY"
        "STREAMS_INVALID_TOPOLOGY_EPOCH"
        "STREAMS_TOPOLOGY_FENCED"
        "SHARE_SESSION_LIMIT_REACHED"
        "GROUP_DELETION_FAILED"
        "STREAMS_TOPOLOGY_DESCRIPTION_UPDATE_FAILED"
        "CONTROLLER_ID_NOT_REGISTERED"
    ]

# The name of `code`.
#
# - `code`: the error's number.
function name_of(code: i64) -> str?
    table = names()

    if code < -1 || code + 1 >= table.len()
        return fail(code: model.NOT_FOUND, msg: f"Kafka names no error {code}")
    return ok(table[code + 1])

# The name of `code`, or its number where Kafka names none.
#
# - `code`: the error's number.
function said(code: i64) -> str
    return name_of(code).default(f"the error {code}")

# Whether a retry, after the metadata is asked again, may succeed: a leader
# moved or not ready, a coordinator loading or moved, a replica short, a
# request timed out, a quota.
#
# - `code`: the error's number.
function is_retriable(code: i64) -> bool
    for c in [5, 6, 7, 8, 9, 13, 14, 15, 16, 19, 20, 41, 51, 56, 74, 75, 78, 89]
        if c == code
            return true

    return false

# The code of Rebel's vocabulary the error `code` means.
#
# - `code`: the error's number, not 0.
function code_of(code: i64) -> str
    if code == 3 || code == 69 || code == 15 || code == 16
        return model.NOT_FOUND

    if code == 36
        return model.EXISTS

    if code == 29 || code == 30 || code == 31 || code == 53 || code == 58 || code == 44
        return model.PERMISSION

    if code == 10 || code == 12 || code == 18
        return model.LIMIT

    if code == 33 || code == 35 || code == 43 || code == 76
        return model.UNSUPPORTED

    if code == 7
        return model.TIMEOUT

    for c in [1, 2, 4, 17, 21, 24, 26, 28, 32, 37, 38, 39, 40, 42, 87]
        if c == code
            return model.INVALID

    return model.FAILED

# The failure a broker's error `code` means, `what` saying what was asked.
#
# - `code`: the error's number, not 0.
# - `what`: what was asked: `producing to t-0`.
# - `said_too`: the broker's own words, "" for none.
function failure<T>(code: i64, what: str, said_too: str) -> T?
    if said_too == ""
        return fail(code: code_of(code), msg: f"{what}: the broker answered {said(code)}")
    return fail(code: code_of(code), msg: f"{what}: the broker answered {said(code)}: {said_too}")

test "name_of, said: -1, 0, the first and the last named, none past them, as franz-go's kerr names them"
    assert name_of(-1).must() == "UNKNOWN_SERVER_ERROR" && name_of(0).must() == "NONE"
    assert name_of(3).must() == "UNKNOWN_TOPIC_OR_PARTITION" && name_of(10).must() == "MESSAGE_TOO_LARGE"
    assert name_of(79).must() == "MEMBER_ID_REQUIRED" && name_of(136).must() == "CONTROLLER_ID_NOT_REGISTERED"
    assert name_of(137).is_err() && name_of(-2).is_err() && said(500) == "the error 500"

test "is_retriable, code_of: a leader moved, a topic unknown, a topic made already, an authorization, an offset outside the log"
    assert is_retriable(6) && is_retriable(15) && !is_retriable(3) && !is_retriable(36)
    assert code_of(3) == "not_found" && code_of(36) == "exists" && code_of(29) == "permission" && code_of(1) == "invalid"
    assert code_of(10) == "limit" && code_of(35) == "unsupported" && code_of(27) == "failed"
