    failed: [i64] @= []
    at @= 0

    for c in cases
        got = complex_exponential.pow(
            base: complex.Complex(re: c[0], im: c[1]),
            exponent: complex.Complex(re: c[2], im: c[3])
        )

        if !near_in_size(got: got, want_re: c[4], want_im: c[5], ulps: c[6])
            failed @ failed.push(at)
        at @ at + 1

    assert failed == []
