# Python 3.15.2's `cmath.log` on this machine, 2026-11-17, at the 49 pairings of seven parts; where Python raises, this machine's C `<complex.h>` as C11's Annex G reads it.
test "ln (generated): every pairing of minus the infinity, -1.5, the two zeros, 1.5, the infinity and a nan"
    inf = math.INF
    nan = math.NAN
    cases: [[f64]] = [
        [-inf, -inf, inf, -2.356194490192345]
        [-inf, -1.5, inf, -3.141592653589793]
        [-inf, -0.0, inf, -3.141592653589793]
        [-inf, 0.0, inf, 3.141592653589793]
        [-inf, 1.5, inf, 3.141592653589793]
        [-inf, inf, inf, 2.356194490192345]
        [-inf, nan, inf, nan]
        [-1.5, -inf, inf, -1.5707963267948966]
        [-1.5, -1.5, 0.7520386983881371, -2.356194490192345]
        [-1.5, -0.0, 0.4054651081081644, -3.141592653589793]
        [-1.5, 0.0, 0.4054651081081644, 3.141592653589793]
        [-1.5, 1.5, 0.7520386983881371, 2.356194490192345]
        [-1.5, inf, inf, 1.5707963267948966]
        [-1.5, nan, nan, nan]
        [-0.0, -inf, inf, -1.5707963267948966]
        [-0.0, -1.5, 0.4054651081081644, -1.5707963267948966]
        [-0.0, -0.0, -inf, -3.141592653589793]
        [-0.0, 0.0, -inf, 3.141592653589793]
        [-0.0, 1.5, 0.4054651081081644, 1.5707963267948966]
        [-0.0, inf, inf, 1.5707963267948966]
        [-0.0, nan, nan, nan]
        [0.0, -inf, inf, -1.5707963267948966]
        [0.0, -1.5, 0.4054651081081644, -1.5707963267948966]
        [0.0, -0.0, -inf, -0.0]
        [0.0, 0.0, -inf, 0.0]
        [0.0, 1.5, 0.4054651081081644, 1.5707963267948966]
        [0.0, inf, inf, 1.5707963267948966]
        [0.0, nan, nan, nan]
        [1.5, -inf, inf, -1.5707963267948966]
        [1.5, -1.5, 0.7520386983881371, -0.7853981633974483]
        [1.5, -0.0, 0.4054651081081644, -0.0]
        [1.5, 0.0, 0.4054651081081644, 0.0]
        [1.5, 1.5, 0.7520386983881371, 0.7853981633974483]
        [1.5, inf, inf, 1.5707963267948966]
        [1.5, nan, nan, nan]
        [inf, -inf, inf, -0.7853981633974483]
        [inf, -1.5, inf, -0.0]
        [inf, -0.0, inf, -0.0]
        [inf, 0.0, inf, 0.0]
        [inf, 1.5, inf, 0.0]
        [inf, inf, inf, 0.7853981633974483]
        [inf, nan, inf, nan]
        [nan, -inf, inf, nan]
        [nan, -1.5, nan, nan]
        [nan, -0.0, nan, nan]
        [nan, 0.0, nan, nan]
        [nan, 1.5, nan, nan]
        [nan, inf, inf, nan]
        [nan, nan, nan, nan]
    ]
    assert complex_arithmetic.misses(f: complex_exponential.ln, cases: cases, ulps: 4.0) == []

