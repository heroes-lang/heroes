# Integer arithmetic that answers `does_not_fit` where the language's own
# operator aborts. Each function asks whether the answer fits before it
# computes it, comparing with the limits by an operation that cannot itself
# overflow, so no line here reaches an abort.

use math/internal/limits

# The sum of `a` and `b`.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function add(a: i64, b: i64) -> i64?
    if b > 0 && a > limits.MAX_I64 - b || b < 0 && a < limits.MIN_I64 - b
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} + {b} is outside i64")
    return ok(a + b)

# `a` less `b`.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function sub(a: i64, b: i64) -> i64?
    if b < 0 && a > limits.MAX_I64 + b || b > 0 && a < limits.MIN_I64 + b
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} - {b} is outside i64")
    return ok(a - b)

# The product of `a` and `b`. Each case divides a limit by one factor, which
# cannot overflow, and compares the other factor with the quotient.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function mul(a: i64, b: i64) -> i64?
    if a == 0 || b == 0
        return ok(0)
    fits: bool @= true

    if a > 0
        if b > 0
            fits @ a <= limits.MAX_I64 / b
        else
            fits @ b >= limits.MIN_I64 / a
    else if b > 0
        fits @ a >= limits.MIN_I64 / b
    else
        fits @ b >= limits.MAX_I64 / a

    if !fits
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} * {b} is outside i64")
    return ok(a * b)

# `x` with its sign changed.
#
# - `x`: any `i64`.
function neg(x: i64) -> i64?
    if x == limits.MIN_I64
        return fail(code: limits.DOES_NOT_FIT, msg: f"-({x}) is outside i64")
    return ok(-x)

# The quotient of `x` by `by`, toward zero.
#
# - `x`: the dividend.
# - `by`: the divisor.
function div(x: i64, by: i64) -> i64?
    if by == 0
        return fail(code: limits.INVALID, msg: f"{x} divided by zero")

    if x == limits.MIN_I64 && by == -1
        return fail(code: limits.DOES_NOT_FIT, msg: f"{x} / -1 is outside i64")
    return ok(x / by)

# The remainder of `x` by `by`, with the sign of `x`.
#
# - `x`: the dividend.
# - `by`: the divisor.
function rem(x: i64, by: i64) -> i64?
    if by == 0
        return fail(code: limits.INVALID, msg: f"the remainder of {x} by zero")

    if by == -1
        return ok(0)
    return ok(x % by)

# `base` raised to `exponent` by squaring. A square is made only where a bit
# of the exponent is left to multiply it in, so the power is at least its
# size, and a square that does not fit means a power that does not.
#
# - `base`: any `i64`.
# - `exponent`: 0 or more.
function pow_i64(base: i64, exponent: i64) -> i64?
    if exponent < 0
        return fail(code: limits.INVALID, msg: f"{base} raised to the negative power {exponent}")
    result: i64 @= 1
    square: i64 @= base
    left: i64 @= exponent

    while left > 0
        if left & 1 == 1
            match mul(a: result, b: square)
                .ok next => result @ next
                .err _   => return fail(code: limits.DOES_NOT_FIT, msg: f"{base} raised to {exponent} is outside i64")
        left @ left >> 1

        if left > 0
            match mul(a: square, b: square)
                .ok next => square @ next
                .err _   => return fail(code: limits.DOES_NOT_FIT, msg: f"{base} raised to {exponent} is outside i64")

    return ok(result)

# `x` without its sign.
#
# - `x`: any `i64`.
function abs_i64(x: i64) -> i64?
    if x == limits.MIN_I64
        return fail(code: limits.DOES_NOT_FIT, msg: f"the absolute value of {x} is outside i64")

    if x < 0
        return ok(-x)
    return ok(x)

# The distance between `a` and `b` as a `u64`. Two of one sign subtract
# without overflow; across zero the distance is the two sizes added in `u64`,
# the negative one's taken as one less than it so that `MIN_I64` has one.
#
# - `a`: any `i64`.
# - `b`: any `i64`.
function abs_diff(a: i64, b: i64) -> u64
    high: i64 @= a
    low: i64 @= b

    if b > a
        high @ b
        low @ a

    if high < 0 == (low < 0)
        return to_u64(high - low).must()
    return to_u64(high).must() + to_u64(-(low + 1)).must() + 1

# The sum of `a` and `b`.
#
# - `a`: any `u64`.
# - `b`: any `u64`.
function add_u64(a: u64, b: u64) -> u64?
    if a > limits.MAX_U64 - b
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} + {b} is above the largest u64")
    return ok(a + b)

# `a` less `b`.
#
# - `a`: any `u64`.
# - `b`: any `u64`.
function sub_u64(a: u64, b: u64) -> u64?
    if b > a
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} - {b} is below zero")
    return ok(a - b)

# The product of `a` and `b`.
#
# - `a`: any `u64`.
# - `b`: any `u64`.
function mul_u64(a: u64, b: u64) -> u64?
    if a != 0 && b > limits.MAX_U64 / a
        return fail(code: limits.DOES_NOT_FIT, msg: f"{a} * {b} is above the largest u64")
    return ok(a * b)

## Tests

# Rust's `checked_add`, `checked_sub` and `checked_mul` on `i64`, run on
# 2026-11-16.
test "add and sub: one past either limit, the two limits together, zero less the smallest"
    assert add(a: limits.MAX_I64, b: 1).is_err()
    assert add(a: limits.MIN_I64, b: -1).is_err()
    assert add(a: limits.MAX_I64, b: limits.MIN_I64).must() == -1
    assert add(a: -1, b: limits.MIN_I64).is_err()
    assert add(a: 0, b: 0).must() == 0
    assert sub(a: limits.MIN_I64, b: 1).is_err()
    assert sub(a: limits.MAX_I64, b: -1).is_err()
    assert sub(a: 0, b: limits.MIN_I64).is_err()
    assert sub(a: -1, b: limits.MAX_I64).must() == limits.MIN_I64

    match add(a: limits.MAX_I64, b: 1)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit" && e.msg == "9223372036854775807 + 1 is outside i64"

test "mul: the smallest by -1 and by 1, each pair of signs at the limit, the largest square that fits"
    assert mul(a: limits.MIN_I64, b: -1).is_err()
    assert mul(a: -1, b: limits.MIN_I64).is_err()
    assert mul(a: limits.MIN_I64, b: 1).must() == limits.MIN_I64
    assert mul(a: 3037000499, b: 3037000499).must() == 9223372030926249001
    assert mul(a: 3037000500, b: 3037000500).is_err()
    assert mul(a: 4611686018427387904, b: -2).must() == limits.MIN_I64
    assert mul(a: -2, b: 4611686018427387904).must() == limits.MIN_I64
    assert mul(a: 4611686018427387904, b: 2).is_err()
    assert mul(a: -4611686018427387904, b: -2).is_err()
    assert mul(a: 0, b: limits.MIN_I64).must() == 0

test "neg, div and rem: the smallest, a zero divisor, -1, each pair of signs"
    assert neg(limits.MIN_I64).is_err()
    assert neg(limits.MAX_I64).must() == -9223372036854775807
    assert div(x: limits.MIN_I64, by: -1).is_err()
    assert div(x: -7, by: 2).must() == -3
    assert rem(x: limits.MIN_I64, by: -1).must() == 0
    assert rem(x: -7, by: 2).must() == -1
    assert rem(x: 7, by: -2).must() == 1

    match div(x: 7, by: 0)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    match rem(x: 7, by: 0)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

# Rust's `checked_pow` on `i64`, run on 2026-11-16.
test "pow_i64: -2 to the 63 fits and 2 to the 63 does not, zero to zero, the largest power of 3, -1, a negative exponent"
    assert pow_i64(base: -2, exponent: 63).must() == limits.MIN_I64
    assert pow_i64(base: 2, exponent: 63).is_err()
    assert pow_i64(base: 2, exponent: 62).must() == 4611686018427387904
    assert pow_i64(base: 0, exponent: 0).must() == 1
    assert pow_i64(base: 0, exponent: 5).must() == 0
    assert pow_i64(base: 3, exponent: 39).must() == 4052555153018976267
    assert pow_i64(base: 3, exponent: 40).is_err()
    assert pow_i64(base: -1, exponent: 1000001).must() == -1
    assert pow_i64(base: limits.MIN_I64, exponent: 1).must() == limits.MIN_I64
    assert pow_i64(base: limits.MIN_I64, exponent: 2).is_err()

    match pow_i64(base: 2, exponent: -1)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

test "abs_i64 and abs_diff: the smallest, the two limits each way, across zero, of one sign"
    assert abs_i64(limits.MIN_I64).is_err()
    assert abs_i64(-5).must() == 5 && abs_i64(5).must() == 5
    assert abs_diff(a: limits.MIN_I64, b: limits.MAX_I64) == 18446744073709551615
    assert abs_diff(a: limits.MAX_I64, b: limits.MIN_I64) == 18446744073709551615
    assert abs_diff(a: -5, b: 3) == 8
    assert abs_diff(a: limits.MIN_I64, b: 0) == 9223372036854775808
    assert abs_diff(a: -3, b: -10) == 7
    assert abs_diff(a: 4, b: 4) == 0

test "add_u64, sub_u64 and mul_u64: one past the largest, below zero, two halves of the bits, the largest product"
    assert add_u64(a: limits.MAX_U64, b: 1).is_err()
    assert add_u64(a: limits.MAX_U64, b: 0).must() == limits.MAX_U64
    assert sub_u64(a: 0, b: 1).is_err()
    assert sub_u64(a: 5, b: 5).must() == 0
    assert mul_u64(a: 4294967296, b: 4294967296).is_err()
    assert mul_u64(a: 4294967295, b: 4294967297).must() == limits.MAX_U64
    assert mul_u64(a: 0, b: limits.MAX_U64).must() == 0
