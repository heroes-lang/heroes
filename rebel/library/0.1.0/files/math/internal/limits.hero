# The constants of `math`, written once: the face names each of them, and every
# private module of the package reads them here, beside the powers of two the
# face does not offer.
#
# Heroes has no exponent literal (spec § 2), so the extremes of `f64` are
# computed from powers of two, each exact, and the infinity and the nan from
# the largest one.

## The codes `math` fails with (`rebel/examples/README.md` § A4)

# A number is outside its type: the language's own code.
constant DOES_NOT_FIT: str
    "does_not_fit"

# The input is not what the function reads; the message says what.
constant INVALID: str
    "invalid"

# A search found nothing: the smallest or the largest of an empty list.
constant NOT_FOUND: str
    "not_found"

## Powers of two the extremes are built from

# 2 to the 64, exactly.
constant TWO_64: f64
    18446744073709551616.0

# 2 to the 256, exactly.
constant TWO_256: f64
    TWO_64 * TWO_64 * TWO_64 * TWO_64

# 2 to the 1023, the largest power of two a `f64` holds.
constant TWO_1023: f64
    TWO_256 * TWO_256 * TWO_256 * (TWO_256 / 2.0)

## The extremes of `f64`

# 2 to the -52: the gap between 1.0 and the next float above it.
constant EPSILON: f64
    1.0 / 4503599627370496.0

# The largest finite `f64`, 2 to the 1024 less 2 to the 971.
constant MAX_F64: f64
    (2.0 - EPSILON) * TWO_1023

# The positive infinity.
constant INF: f64
    TWO_1023 * 2.0

# A value that is not a number; its sign is not promised.
constant NAN: f64
    INF - INF

# 2 to the -1022, the smallest `f64` with its full 53 bits of precision.
constant SMALLEST_NORMAL_F64: f64
    2.0 / TWO_1023

# 2 to the -1074, the smallest positive `f64`.
constant SMALLEST_F64: f64
    SMALLEST_NORMAL_F64 * EPSILON

## The extremes of `f32`

# The largest finite `f32`.
constant MAX_F32: f32
    340282346638528859811704183484516925440.0

# 2 to the -149, the smallest positive `f32`.
constant SMALLEST_F32: f32
    0.000000000000000000000000000000000000000000001401298464324817

## The integer limits

# The largest `i64`.
constant MAX_I64: i64
    9223372036854775807

# The smallest `i64`.
constant MIN_I64: i64
    -9223372036854775808

# The largest `u64`.
constant MAX_U64: u64
    18446744073709551615

## Constants of mathematics, each the `f64` nearest to it

# Pi, the ratio of a circle's circumference to its diameter.
constant PI: f64
    3.141592653589793

# Tau, twice pi.
constant TAU: f64
    6.283185307179586

# E, the base of the natural logarithm.
constant E: f64
    2.718281828459045

# The square root of 2.
constant SQRT_2: f64
    1.4142135623730951

# The natural logarithm of 2.
constant LN_2: f64
    0.6931471805599453

# The natural logarithm of 10.
constant LN_10: f64
    2.302585092994046

# The logarithm of e in base 2.
constant LOG2_E: f64
    1.4426950408889634

# The logarithm of e in base 10.
constant LOG10_E: f64
    0.4342944819032518

# The golden ratio, one plus the square root of 5, halved.
constant PHI: f64
    1.618033988749895

# Euler's constant, the limit of the harmonic sum less the natural logarithm.
constant EULER_GAMMA: f64
    0.5772156649015329

## Tests

test "limits: the extremes of f64 against the values Python and Go print"
    assert MAX_F64 == .0
    assert EPSILON == 0.0000000000000002220446049250313
    assert SMALLEST_NORMAL_F64 == 0.
    assert SMALLEST_F64 / 2.0 == 0.0
    assert SMALLEST_F64 > 0.0
    assert INF > MAX_F64
    assert MAX_F64 * 2.0 == INF
    assert NAN != NAN

test "limits: the extremes of f32 and of the integers"
    assert to_f64(MAX_F32) == 340282346638528859811704183484516925440.0
    assert to_f64(SMALLEST_F32) * 2.0 == to_f64(SMALLEST_F32) + to_f64(SMALLEST_F32)
    assert SMALLEST_F32 / 2.0 == 0.0
    assert MAX_I64 + MIN_I64 == -1
    assert to_u64(MAX_I64).must() * 2 + 1 == MAX_U64

test "limits: the constants of mathematics are the nearest floats"
    assert TAU == PI * 2.0
    assert PHI == (1.0 + 2.23606797749979) / 2.0
    assert LN_2 * LOG2_E == 1.0
