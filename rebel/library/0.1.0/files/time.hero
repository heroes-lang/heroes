# Time as a program counts it: an instant, a duration, the calendar, the text
# of a time, sleeping, and time zones. An instant is UTC and nothing else, and
# a text read with an offset is moved to UTC; a zone's local time is the
# calendar's name for an instant on that zone's clocks, read from the system's
# zone files or from the IANA data Rebel carries. The calendar is the proleptic Gregorian one, its rules carried
# back before 1582, and it has no leap seconds: every day is 86,400 seconds.
#
# An `Instant` and a `Duration` are counts of nanoseconds in an `i64`, so an
# instant stands between 1677-09-21T00:12:43.145224192Z and
# 2262-04-11T23:47:16.854775807Z, and a duration within about 292 years either
# way. A duration made from a count the program writes, `seconds(30)`,
# aborts past that range, as the language's own arithmetic does, and its
# twin `seconds_checked` fails `does_not_fit` for a count read from outside;
# arithmetic on durations and instants fails `does_not_fit`; nothing here
# wraps, and nothing aborts on a value it computes or reads.
#
# Two clocks, never mixed. The wall clock says what time it is, and the
# machine's owner or the network may set it back or forward between two
# readings: `now`, `since` and `until` read it. The monotonic clock never goes
# back and its start is not named, so it says only how long something took:
# `mark`, `elapsed` and `between_marks` read it.
#
# It also computes the runs of a cron schedule on a zone's clocks, every time
# the caller's; nothing of a schedule sleeps or calls: the program does, with
# `sleep`. The waits of a retry loop, the wait a `Retry-After` asks and
# circuit breakers are `retries`'.
#
# What it does NOT do: write or read a date in a language's words or by a
# pattern, "Tuesday, March 5, 2024" or "dd/MM/yyyy", which `i18n/dates` does
# (`i18n/dates.format_pattern`, `i18n/dates.parse_pattern`,
# `i18n/dates.month_names`): a text here is one of the fixed `Layout`s, and
# the names of days and months are English. Nor does it wait on more than one
# thing at once, or end a wait at the program's stop (`os.catch_stop`):
# `poll` does both.
#
# It fails `invalid` where a text or a value is not what the function reads,
# `does_not_fit` where a result leaves the range above, `not_found`,
# `permission` and `unsupported` where a zone cannot be read, and `failed`
# where the system's clock cannot.
#
# Not written yet, each a `pending` block of its ledger: how fine a clock's
# readings are; the processor time the process or the thread has used; a
# duration times or over a float.

use time/hero_time
use time/internal/arith
use time/internal/carried_names
use time/internal/civil
use time/internal/cron_next
use time/internal/cron_read
use time/internal/duration_text
use time/internal/float_seconds
use time/internal/forms
use time/internal/reading
use time/internal/zone_files
use time/internal/zone_local
use time/internal/zone_table

## Codes

# The code of a value or a text that is not what the function reads; the
# message says which field or which byte, counted from 0.
constant INVALID: str
    "invalid"

# The code of a result outside what an `i64` of nanoseconds holds, the
# language's own code for it.
constant DOES_NOT_FIT: str
    "does_not_fit"

# The code of a clock the system could not read; the message carries the
# system's own number.
constant FAILED: str
    "failed"

# The code of a zone name no file and no carried data holds, and of a zone
# change that is not there.
constant NOT_FOUND: str
    "not_found"

# The code of a zone file the system refuses to the program.
constant PERMISSION: str
    "permission"

# The code of a zone file that counts leap seconds, and of a local zone a
# platform names in a way this package does not read.
constant UNSUPPORTED: str
    "unsupported"

## The types

# A moment, as the nanoseconds since 1970-01-01T00:00:00Z, negative before it.
# Every `i64` is an instant, so any value built here is one; two instants are
# the same moment exactly where they are `==`.
record Instant
    # Nanoseconds since 1970-01-01T00:00:00Z, leap seconds not counted.
    unix_nanoseconds: i64

# A length of time in nanoseconds, negative where it runs backwards. A day is
# 86,400 seconds here, always.
record Duration
    # The length in nanoseconds.
    nanoseconds: i64

# A reading of the monotonic clock. Only its difference from another reading
# of the same run of the program means anything: the start it counts from is
# not named, and it does not advance while the machine sleeps.
record Mark
    # Nanoseconds since a start nobody names.
    nanoseconds: i64

# A moment as the calendar names it, in UTC. `from_date_time` refuses parts
# outside their ranges, which each field's comment states.
record DateTime
    # The year of the proleptic Gregorian calendar, 1970 for 1970.
    year: i64
    # The month, 1 for January to 12 for December.
    month: i64
    # The day of the month, from 1 to 28, 29, 30 or 31 as the month has.
    day: i64
    # The hour, from 0 to 23.
    hour: i64
    # The minute, from 0 to 59.
    minute: i64
    # The second, from 0 to 59: there are no leap seconds.
    second: i64
    # The nanosecond within the second, from 0 to 999,999,999.
    nanosecond: i64

# A day of the week, Monday first, as ISO 8601 counts them.
variant Weekday
    # Monday, day 1 of the ISO week.
    monday
    # Tuesday, day 2 of the ISO week.
    tuesday
    # Wednesday, day 3 of the ISO week.
    wednesday
    # Thursday, day 4 of the ISO week.
    thursday
    # Friday, day 5 of the ISO week.
    friday
    # Saturday, day 6 of the ISO week.
    saturday
    # Sunday, day 7 of the ISO week.
    sunday

# The ISO 8601 week a day falls in: weeks begin on Monday, and week 1 of a year
# is the week holding its first Thursday, so the first days of January may
# fall in the last week of the year before.
record IsoWeek
    # The year the week belongs to, which differs from the day's own near
    # January 1.
    year: i64
    # The week of that year, from 1 to 52 or 53.
    week: i64

# A unit a duration is counted in.
variant Unit
    # A billionth of a second.
    nanosecond
    # 1,000 nanoseconds.
    microsecond
    # 1,000,000 nanoseconds.
    millisecond
    # 1,000,000,000 nanoseconds.
    second
    # 60 seconds.
    minute
    # 60 minutes.
    hour
    # 24 hours.
    day
    # 7 days.
    week

# The ways a time is written as text, a closed set. Each is shown below at
# 2006-01-02T15:04:05.123456789Z.
variant Layout
    # RFC 3339 with as many fraction digits as the nanoseconds need, none for
    # a whole second: `2006-01-02T15:04:05.123456789Z`.
    rfc3339
    # RFC 3339 cut to the second: `2006-01-02T15:04:05Z`.
    rfc3339_seconds
    # RFC 3339 cut to the millisecond, three digits always:
    # `2006-01-02T15:04:05.123Z`.
    rfc3339_milliseconds
    # RFC 3339 cut to the microsecond, six digits always:
    # `2006-01-02T15:04:05.123456Z`.
    rfc3339_microseconds
    # RFC 3339 with nine digits always: `2006-01-02T15:04:05.123456789Z`.
    rfc3339_nanoseconds
    # The date and the time with a space between, cut to the second:
    # `2006-01-02 15:04:05`.
    date_time
    # The date alone: `2006-01-02`.
    date_only
    # The time of day alone, cut to the second: `15:04:05`.
    time_only
    # HTTP's date, RFC 9110's IMF-fixdate, cut to the second:
    # `Mon, 02 Jan 2006 15:04:05 GMT`.
    http
    # The obsolete HTTP date of RFC 850, with a two-digit year, cut to the
    # second: `Monday, 02-Jan-06 15:04:05 GMT`.
    rfc850
    # C's `asctime`, cut to the second: `Mon Jan  2 15:04:05 2006`.
    ansic
    # E-mail's date, RFC 5322, with a numeric offset, cut to the second:
    # `Mon, 02 Jan 2006 15:04:05 +0000`.
    email

## The two clocks

# The instant the wall clock reads now.
#
# Fails `failed` where the system cannot read its clock or the clock stands
# outside what an `Instant` holds. The clock may be set back or forward between
# two calls: measure a span with `mark` and `elapsed`.
function now() -> Instant?
    taken = hero_time.wall_ns()

    if taken == -1 && hero_time.last_error() != hero_time.HERO_TIME_OK
        return fail(
            code: FAILED,
            msg: f"the wall clock could not be read: the system's error {hero_time.last_os_error()}"
        )
    return ok(Instant(unix_nanoseconds: taken))

# How long ago `t` was by the wall clock.
#
# - `t`: the instant asked about; one still to come gives a negative duration.
#
# Fails `failed` where the clock cannot be read, and `does_not_fit` where the
# length is outside a `Duration`.
function since(t: Instant) -> Duration?
    current = now()?
    return between(from: t, to: current)

# How long until `t` by the wall clock.
#
# - `t`: the instant asked about; one that has passed gives a negative duration.
#
# Fails `failed` where the clock cannot be read, and `does_not_fit` where the
# length is outside a `Duration`.
function until(t: Instant) -> Duration?
    current = now()?
    return between(from: current, to: t)

# A reading of the monotonic clock, which never goes back.
#
# Fails `failed` where the system cannot read it.
function mark() -> Mark?
    taken = hero_time.monotonic_ns()

    if taken < 0
        return fail(code: FAILED, msg: "the monotonic clock could not be read")
    return ok(Mark(nanoseconds: taken))

# How long has passed on the monotonic clock since `start` was read.
#
# - `start`: a reading `mark` gave in this run of the program.
#
# Fails `failed` where the clock cannot be read, and `does_not_fit` where
# `start` was not a reading of this clock and the difference leaves a
# `Duration`.
function elapsed(start: Mark) -> Duration?
    taken = mark()?
    return between_marks(from: start, to: taken)

# How long passed on the monotonic clock from one reading to another.
#
# - `from`: the reading counted from, as `mark` gave it.
# - `to`: the reading counted to; one read before `from` gives a negative
#   duration.
#
# Fails `does_not_fit` where the difference is outside a `Duration`, which two
# readings of one run never are.
function between_marks(from: Mark, to: Mark) -> Duration?
    return ok(Duration(nanoseconds: arith.subtract(a: to.nanoseconds, b: from.nanoseconds)?))

## Sleeping

# Waits until at least `d` has passed on the monotonic clock, then returns.
#
# - `d`: how long to wait; zero or below returns at once.
#
# It may wait longer, as long as the system takes to run the program again; a
# signal does not cut it short, and it does not count the time the machine
# itself sleeps. The program's stop (`os.catch_stop`, `os.ask_stop`) does
# not end it either, where every wait of `io`, `poll`, `serial` and `net` ends
# at a stop: a loop that must end on Ctrl-C waits in slices short enough to
# ask `os.is_stop_asked` between them, or waits on a `poll.add_timer`.
function sleep(d: Duration)
    if d.nanoseconds > 0
        _ = hero_time.sleep_ns(d.nanoseconds)

## Instants

# 1970-01-01T00:00:00Z, the instant whose `unix_nanoseconds` is 0.
function epoch() -> Instant
    return Instant(unix_nanoseconds: 0)

# The earliest instant, 1677-09-21T00:12:43.145224192Z.
function min_instant() -> Instant
    return Instant(unix_nanoseconds: arith.MIN)

# The latest instant, 2262-04-11T23:47:16.854775807Z.
function max_instant() -> Instant
    return Instant(unix_nanoseconds: arith.MAX)

# The instant so many seconds and nanoseconds after 1970-01-01T00:00:00Z.
#
# - `whole_seconds`: seconds since 1970, negative before it.
# - `extra_nanoseconds`: nanoseconds added to them, negative or past a second as
#   the sum says.
#
# Fails `does_not_fit` where the sum is outside an `Instant`.
function from_unix(whole_seconds: i64, extra_nanoseconds: i64) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.from_parts(seconds: whole_seconds, nanoseconds: extra_nanoseconds)?))

# The instant `n` milliseconds after 1970-01-01T00:00:00Z.
#
# - `n`: milliseconds since 1970, negative before it.
#
# Fails `does_not_fit` where it is outside an `Instant`.
function from_unix_milliseconds(n: i64) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.multiply(a: n, b: 1_000_000)?))

# The instant `n` microseconds after 1970-01-01T00:00:00Z.
#
# - `n`: microseconds since 1970, negative before it.
#
# Fails `does_not_fit` where it is outside an `Instant`.
function from_unix_microseconds(n: i64) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.multiply(a: n, b: 1_000)?))

# The whole seconds from 1970-01-01T00:00:00Z to `t`, rounded toward the past.
#
# - `t`: any instant; one half a second before 1970 gives -1.
#
# The nanoseconds left over are never negative.
function unix_seconds(t: Instant) -> i64
    return arith.floor_div(a: t.unix_nanoseconds, b: 1_000_000_000)

# The whole milliseconds from 1970-01-01T00:00:00Z to `t`, rounded toward the
# past.
#
# - `t`: any instant; one a nanosecond before 1970 gives -1.
function unix_milliseconds(t: Instant) -> i64
    return arith.floor_div(a: t.unix_nanoseconds, b: 1_000_000)

# The whole microseconds from 1970-01-01T00:00:00Z to `t`, rounded toward the
# past.
#
# - `t`: any instant; one a nanosecond before 1970 gives -1.
function unix_microseconds(t: Instant) -> i64
    return arith.floor_div(a: t.unix_nanoseconds, b: 1_000)

# The instant `d` after `t`.
#
# - `t`: the instant moved from.
# - `d`: how far; a negative duration moves it back, and zero leaves it.
#
# Fails `does_not_fit` where it is outside an `Instant`.
function add(t: Instant, d: Duration) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.add(a: t.unix_nanoseconds, b: d.nanoseconds)?))

# The duration from one instant to another.
#
# - `from`: the instant counted from.
# - `to`: the instant counted to; one earlier than `from` gives a negative
#   duration.
#
# Fails `does_not_fit` where it is outside a `Duration`, as it is for two
# instants more than about 292 years apart.
function between(from: Instant, to: Instant) -> Duration?
    return ok(Duration(nanoseconds: arith.subtract(a: to.unix_nanoseconds, b: from.unix_nanoseconds)?))

# Whether `a` is earlier than `b`.
#
# - `a`: the instant asked about.
# - `b`: the instant it is compared with; no instant is before itself.
#
# Its shape is the one `lists.sort_by` takes.
function is_before(a: Instant, b: Instant) -> bool
    return a.unix_nanoseconds < b.unix_nanoseconds

# Whether `a` is later than `b`.
#
# - `a`: the instant asked about.
# - `b`: the instant it is compared with; no instant is after itself.
function is_after(a: Instant, b: Instant) -> bool
    return a.unix_nanoseconds > b.unix_nanoseconds

# `t` moved toward the past to a whole multiple of `unit` counted from
# 1970-01-01T00:00:00Z.
#
# - `t`: the instant; one already a multiple is answered as it is.
# - `unit`: the length cut to, above zero.
#
# Fails `invalid` where `unit` is not above zero, and `does_not_fit` where the
# multiple is before the earliest instant. Units that divide a day cut at the
# same places as counting from any midnight; a week counts from 1970-01-01, a
# Thursday.
function truncate(t: Instant, unit: Duration) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.floor_to(n: t.unix_nanoseconds, unit: unit.nanoseconds)?))

# `t` moved to the nearest whole multiple of `unit` counted from
# 1970-01-01T00:00:00Z.
#
# - `t`: the instant; a tie goes toward the future.
# - `unit`: the length rounded to, above zero.
#
# Fails `invalid` where `unit` is not above zero, and `does_not_fit` where the
# multiple is outside an `Instant`.
function round(t: Instant, unit: Duration) -> Instant?
    return ok(Instant(unix_nanoseconds: arith.nearest_up(n: t.unix_nanoseconds, unit: unit.nanoseconds)?))

## Durations

# One `unit`, as a duration.
#
# - `unit`: nanosecond to week; a day is 24 hours and a week 7 days.
function duration_of(unit: Unit) -> Duration
    return match unit
        .nanosecond  => Duration(nanoseconds: 1)
        .microsecond => Duration(nanoseconds: 1_000)
        .millisecond => Duration(nanoseconds: 1_000_000)
        .second      => Duration(nanoseconds: 1_000_000_000)
        .minute      => Duration(nanoseconds: 60_000_000_000)
        .hour        => Duration(nanoseconds: 3_600_000_000_000)
        .day         => Duration(nanoseconds: 86_400_000_000_000)
        .week        => Duration(nanoseconds: 604_800_000_000_000)

# `n` nanoseconds, as a duration.
#
# - `n`: any count, a negative one running backwards.
function nanoseconds(n: i64) -> Duration
    return Duration(nanoseconds: n)

# `n` microseconds, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `microseconds_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `microseconds_checked`.
function microseconds(n: i64) -> Duration
    return Duration(nanoseconds: n * 1_000)

# `n` microseconds as a duration, where that fits one: the twin of
# `microseconds` for a count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `microseconds`.
function microseconds_checked(n: i64) -> Duration?
    return scale(d: duration_of(.microsecond), by: n)

# `n` milliseconds, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `milliseconds_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `milliseconds_checked`.
function milliseconds(n: i64) -> Duration
    return Duration(nanoseconds: n * 1_000_000)

# `n` milliseconds as a duration, where that fits one: the twin of
# `milliseconds` for a count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `milliseconds`.
function milliseconds_checked(n: i64) -> Duration?
    return scale(d: duration_of(.millisecond), by: n)

# `n` seconds, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `seconds_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `seconds_checked`.
function seconds(n: i64) -> Duration
    return Duration(nanoseconds: n * 1_000_000_000)

# `n` seconds as a duration, where that fits one: the twin of `seconds` for a
# count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `seconds`.
function seconds_checked(n: i64) -> Duration?
    return scale(d: duration_of(.second), by: n)

# `n` minutes, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `minutes_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `minutes_checked`.
function minutes(n: i64) -> Duration
    return Duration(nanoseconds: n * 60_000_000_000)

# `n` minutes as a duration, where that fits one: the twin of `minutes` for a
# count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `minutes`.
function minutes_checked(n: i64) -> Duration?
    return scale(d: duration_of(.minute), by: n)

# `n` hours, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `hours_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `hours_checked`.
function hours(n: i64) -> Duration
    return Duration(nanoseconds: n * 3_600_000_000_000)

# `n` hours as a duration, where that fits one: the twin of `hours` for a
# count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `hours`.
function hours_checked(n: i64) -> Duration?
    return scale(d: duration_of(.hour), by: n)

# `n` days of 24 hours, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `days_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `days_checked`.
function days(n: i64) -> Duration
    return Duration(nanoseconds: n * 86_400_000_000_000)

# `n` days of 24 hours as a duration, where that fits one: the twin of `days`
# for a count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `days`.
function days_checked(n: i64) -> Duration?
    return scale(d: duration_of(.day), by: n)

# `n` weeks of 7 days, as a duration.
#
# - `n`: the count, a negative one running backwards; one the program writes
#   or computes, since a count read from outside goes through
#   `weeks_checked`.
#
# Aborts where that is outside a `Duration`, about 292 years either way, as
# the language's own arithmetic aborts on an overflow (README § B2). See also
# `weeks_checked`.
function weeks(n: i64) -> Duration
    return Duration(nanoseconds: n * 604_800_000_000_000)

# `n` weeks of 7 days as a duration, where that fits one: the twin of `weeks`
# for a count read from outside the program.
#
# - `n`: the count, a negative one running backwards.
#
# Fails `does_not_fit` where that is outside a `Duration`, about 292 years
# either way. See also `weeks`.
function weeks_checked(n: i64) -> Duration?
    return scale(d: duration_of(.week), by: n)

# The duration nearest to `x` seconds.
#
# - `x`: seconds as a float, negative running backwards; a tie between two
#   nanoseconds goes to the even one.
#
# Fails `invalid` where `x` is not a number, and `does_not_fit` where it is
# infinite or outside a `Duration`.
function from_seconds_float(x: f64) -> Duration?
    return ok(Duration(nanoseconds: float_seconds.to_nanoseconds(x)?))

# The longest duration, 2^63 - 1 nanoseconds, about 292 years.
function max_duration() -> Duration
    return Duration(nanoseconds: arith.MAX)

# The most negative duration, -2^63 nanoseconds.
function min_duration() -> Duration
    return Duration(nanoseconds: arith.MIN)

# `a` and `b` added.
#
# - `a`: the first duration.
# - `b`: the second; either may be negative.
#
# Fails `does_not_fit` where the sum is outside a `Duration`.
function sum(a: Duration, b: Duration) -> Duration?
    return ok(Duration(nanoseconds: arith.add(a: a.nanoseconds, b: b.nanoseconds)?))

# `a` less `b`.
#
# - `a`: the duration taken from.
# - `b`: the duration taken; a negative one adds.
#
# Fails `does_not_fit` where the difference is outside a `Duration`.
function difference(a: Duration, b: Duration) -> Duration?
    return ok(Duration(nanoseconds: arith.subtract(a: a.nanoseconds, b: b.nanoseconds)?))

# `d` running the other way.
#
# - `d`: any duration but the most negative, whose opposite an `i64` does not
#   hold.
#
# Fails `does_not_fit` for the most negative duration.
function negate(d: Duration) -> Duration?
    return ok(Duration(nanoseconds: arith.subtract(a: 0, b: d.nanoseconds)?))

# `d` with its sign dropped.
#
# - `d`: any duration; zero and positive ones are answered as they are.
#
# Fails `does_not_fit` for the most negative duration.
function abs(d: Duration) -> Duration?
    if d.nanoseconds < 0
        return negate(d)
    return ok(d)

# `d` taken `by` times.
#
# - `d`: the duration.
# - `by`: how many times; zero gives zero, and a negative count turns it.
#
# Fails `does_not_fit` where the product is outside a `Duration`.
function scale(d: Duration, by: i64) -> Duration?
    return ok(Duration(nanoseconds: arith.multiply(a: d.nanoseconds, b: by)?))

# `d` cut into `by` equal parts, the quotient rounded toward zero.
#
# - `d`: the duration cut.
# - `by`: how many parts; a negative count turns it, and zero is refused.
#
# Fails `invalid` where `by` is 0, and `does_not_fit` for the most negative
# duration cut by -1.
function divide(d: Duration, by: i64) -> Duration?
    if by == 0
        return fail(code: INVALID, msg: f"{format_duration(d)} cannot be cut into 0 parts")

    if by == -1 && d.nanoseconds == arith.MIN
        return fail(code: DOES_NOT_FIT, msg: f"{format_duration(d)} cut by -1 is longer than the longest duration")
    return ok(Duration(nanoseconds: d.nanoseconds / by))

# How many whole `unit`s `d` holds, rounded toward zero.
#
# - `d`: the duration counted; a negative one gives a negative count, 1.9
#   seconds 1 second and -1.9 seconds -1.
# - `unit`: the unit it is counted in.
function to_units(d: Duration, unit: Unit) -> i64
    return d.nanoseconds / duration_of(unit).nanoseconds

# What is left of `d` once the whole `unit`s are taken out.
#
# - `d`: the duration; what is left has its sign, 900 milliseconds of 1.9
#   seconds in seconds.
# - `unit`: the unit taken out.
function remainder(d: Duration, unit: Unit) -> Duration
    return Duration(nanoseconds: d.nanoseconds % duration_of(unit).nanoseconds)

# `d` counted in `unit`s as a float.
#
# - `d`: the duration.
# - `unit`: the unit it is counted in.
#
# It is the whole units plus the rest divided by the unit, each part rounded
# once, so 90 minutes is 1.5 hours.
function to_float(d: Duration, unit: Unit) -> f64
    size = duration_of(unit).nanoseconds
    return to_f64(d.nanoseconds / size) + to_f64(d.nanoseconds % size) / to_f64(size)

# Whether `a` is shorter than `b`, a negative duration being shorter than any
# other.
#
# - `a`: the duration asked about.
# - `b`: the duration it is compared with; none is shorter than itself.
#
# Its shape is the one `lists.sort_by` takes.
function is_shorter(a: Duration, b: Duration) -> bool
    return a.nanoseconds < b.nanoseconds

# Whether `a` is longer than `b`.
#
# - `a`: the duration asked about.
# - `b`: the duration it is compared with; none is longer than itself.
function is_longer(a: Duration, b: Duration) -> bool
    return a.nanoseconds > b.nanoseconds

# `d` moved toward zero to a whole multiple of `unit`.
#
# - `d`: the duration; one already a multiple is answered as it is.
# - `unit`: the length cut to, above zero.
#
# Fails `invalid` where `unit` is not above zero.
function truncate_duration(d: Duration, unit: Duration) -> Duration?
    return ok(Duration(nanoseconds: arith.toward_zero(n: d.nanoseconds, unit: unit.nanoseconds)?))

# `d` moved to the nearest whole multiple of `unit`.
#
# - `d`: the duration; a tie goes away from zero.
# - `unit`: the length rounded to, above zero.
#
# Fails `invalid` where `unit` is not above zero, and `does_not_fit` where the
# multiple is outside a `Duration`.
function round_duration(d: Duration, unit: Duration) -> Duration?
    return ok(Duration(nanoseconds: arith.nearest_away(n: d.nanoseconds, unit: unit.nanoseconds)?))

## The calendar

# The calendar's name for `t` in UTC.
#
# - `t`: any instant; every one has a date, from 1677 to 2262.
function to_date_time(t: Instant) -> DateTime
    c = civil.from_nanoseconds(t.unix_nanoseconds)
    return DateTime(
        year: c.year,
        month: c.month,
        day: c.day,
        hour: c.hour,
        minute: c.minute,
        second: c.second,
        nanosecond: c.nanosecond
    )

# The instant the calendar names `dt` in UTC.
#
# - `dt`: the parts, each within the range its field's comment states.
#
# Fails `invalid` where a field is outside its range, the 30th of February
# included, the message naming the field; fails `does_not_fit` where the moment
# is outside an `Instant`.
function from_date_time(dt: DateTime) -> Instant?
    c = civil.Civil(
        year: dt.year,
        month: dt.month,
        day: dt.day,
        hour: dt.hour,
        minute: dt.minute,
        second: dt.second,
        nanosecond: dt.nanosecond
    )
    return ok(Instant(unix_nanoseconds: civil.to_nanoseconds(c: c, offset: 0)?))

# Midnight UTC at the start of a day.
#
# - `year`: the year of the proleptic Gregorian calendar; an instant reaches
#   1677 to 2262.
# - `month`: 1 for January to 12 for December.
# - `day`: the day of the month, from 1 to the month's last.
#
# Fails `invalid` where the month or the day does not exist, and `does_not_fit`
# where the day is outside an `Instant`.
function date(year: i64, month: i64, day: i64) -> Instant?
    return from_date_time(DateTime(year: year, month: month, day: day, hour: 0, minute: 0, second: 0, nanosecond: 0))

# The day of the week `t` falls on in UTC.
#
# - `t`: any instant.
function weekday_of(t: Instant) -> Weekday
    # `civil.weekday` answers 1 to 7, so the last arm is Sunday's.
    return match civil.weekday(arith.floor_div(a: t.unix_nanoseconds, b: civil.DAY))
        1 => .monday
        2 => .tuesday
        3 => .wednesday
        4 => .thursday
        5 => .friday
        6 => .saturday
        _ => .sunday

# The English name of `day`, "Monday" to "Sunday".
#
# - `day`: the weekday.
#
# See also `i18n/dates.weekday_names`, a language's names for every day.
function weekday_name(day: Weekday) -> str
    return forms.weekday_names()[weekday_number(day) - 1]

# The number ISO 8601 gives `day`: 1 for Monday to 7 for Sunday.
#
# - `day`: the weekday.
function weekday_number(day: Weekday) -> i64
    return match day
        .monday    => 1
        .tuesday   => 2
        .wednesday => 3
        .thursday  => 4
        .friday    => 5
        .saturday  => 6
        .sunday    => 7

# The English name of a month, "January" to "December".
#
# - `month`: the month's number, 1 to 12.
#
# Fails `invalid` where `month` is outside 1 to 12. See also
# `i18n/dates.month_names`, a language's names for every month.
function month_name(month: i64) -> str?
    if month < 1 || month > 12
        return fail(code: INVALID, msg: f"the month {month} is outside 1 to 12")
    return ok(forms.month_names()[month - 1])

# The day of its year `t` falls on in UTC, 1 for January 1.
#
# - `t`: any instant.
#
# The last day of a year is 365, or 366 in a leap year.
function day_of_year(t: Instant) -> i64
    c = civil.from_nanoseconds(t.unix_nanoseconds)
    return civil.day_of_year(year: c.year, month: c.month, day: c.day)

# The ISO 8601 week `t` falls in, in UTC.
#
# - `t`: any instant; the first days of January may fall in the last week of the
#   year before.
function iso_week(t: Instant) -> IsoWeek
    c = civil.from_nanoseconds(t.unix_nanoseconds)
    w = civil.iso_week(year: c.year, month: c.month, day: c.day)
    return IsoWeek(year: w.year, week: w.week)

# Midnight UTC of a day of an ISO 8601 week.
#
# - `year`: the year the week belongs to.
# - `week`: the week of that year, 1 to 52, or 53 in a year that has one.
# - `day`: the day of that week.
#
# Fails `invalid` where `year` has no such week, and `does_not_fit` where the
# day is outside an `Instant`.
function from_iso_week(year: i64, week: i64, day: Weekday) -> Instant?
    count = civil.days_from_iso_week(year: year, week: week, day_number: weekday_number(day))?
    return ok(Instant(unix_nanoseconds: arith.multiply(a: count, b: civil.DAY)?))

# Whether `year` is a leap year.
#
# - `year`: any year of the proleptic Gregorian calendar, 0 and negative ones
#   included.
#
# A leap year is divisible by 4, but not by 100 unless by 400, so 2000 is and
# 1900 is not.
function is_leap_year(year: i64) -> bool
    return civil.is_leap(year)

# How many leap years there are from one year up to another.
#
# - `from`: the first year counted.
# - `to`: the year the count stops before; one before `from` gives a negative
#   count.
function leap_years_between(from: i64, to: i64) -> i64
    return civil.leap_years_between(from: from, to: to)

# How many days a month has.
#
# - `year`: the year, which decides February.
# - `month`: the month, 1 to 12.
#
# Fails `invalid` where `month` is outside 1 to 12.
function days_in_month(year: i64, month: i64) -> i64?
    if month < 1 || month > 12
        return fail(code: INVALID, msg: f"the month {month} is outside 1 to 12")
    return ok(civil.days_in_month(year: year, month: month))

# How many days `year` has: 365, or 366 in a leap year.
#
# - `year`: any year of the proleptic Gregorian calendar.
function days_in_year(year: i64) -> i64
    return civil.days_in_year(year)

# `t` moved by so many calendar months, the time of day kept.
#
# - `t`: the instant moved.
# - `months`: how many; a negative count moves back, and zero leaves it.
#
# Fails `does_not_fit` where the result is outside an `Instant`. A day the
# target month does not have becomes that month's last: January 31 and one month
# is February 28, or 29 in a leap year, and never a day of March.
function add_months(t: Instant, months: i64) -> Instant?
    return ok(Instant(unix_nanoseconds: civil.add_months(nanoseconds: t.unix_nanoseconds, months: months)?))

# `t` moved by so many calendar years, the time of day kept.
#
# - `t`: the instant moved.
# - `years`: how many; a negative count moves back, and zero leaves it.
#
# Fails `does_not_fit` where the result is outside an `Instant`. February 29
# moved to a year that has none becomes February 28.
function add_years(t: Instant, years: i64) -> Instant?
    return add_months(t: t, months: arith.multiply(a: years, b: 12)?)

## Text

# `t` written in `layout`, in UTC.
#
# - `t`: any instant.
# - `layout`: the layout; one with fewer fraction digits than the nanoseconds
#   need cuts the rest off, toward the past.
function format(t: Instant, layout: Layout) -> str
    pieces = match layout
        .rfc3339              => forms.rfc3339(-1)
        .rfc3339_seconds      => forms.rfc3339(0)
        .rfc3339_milliseconds => forms.rfc3339(3)
        .rfc3339_microseconds => forms.rfc3339(6)
        .rfc3339_nanoseconds  => forms.rfc3339(9)
        .date_time            => forms.date_time()
        .date_only            => forms.date_only()
        .time_only            => forms.time_only()
        .http                 => forms.http()
        .rfc850               => forms.rfc850()
        .ansic                => forms.ansic()
        .email                => forms.email()

    return forms.format(nanoseconds: t.unix_nanoseconds, pieces: pieces)

# The instant `s` writes in `layout`.
#
# - `s`: the text, read whole: nothing may come before or after the time.
# - `layout`: the layout; every RFC 3339 layout reads every RFC 3339 text, with
#   a fraction of any length or none, the digits past the ninth dropped, `T` or
#   `t`, and `Z`, `z` or a numeric offset.
#
# Fails `invalid` where `s` is not such a text, the message naming the byte, or
# names a part outside its range or a weekday that is not the date's; fails
# `does_not_fit` where the moment is outside an `Instant`.
#
# An offset other than UTC, `+02:00` or `+0200`, is taken out, so the instant
# answered is UTC's. Names are read in the case they are written in. A
# `time_only` text is a time of 1970-01-01, and an `rfc850` year below 69 is of
# the 2000s.
function parse(s: str, layout: Layout) -> Instant?
    pieces = match layout
        .rfc3339 | .rfc3339_seconds | .rfc3339_milliseconds | .rfc3339_microseconds | .rfc3339_nanoseconds => forms.rfc3339(
            -1
        )
        .date_time => forms.date_time()
        .date_only => forms.date_only()
        .time_only => forms.time_only()
        .http      => forms.http()
        .rfc850    => forms.rfc850()
        .ansic     => forms.ansic()
        .email     => forms.email()

    return ok(Instant(unix_nanoseconds: reading.parse(s: s, pieces: pieces)?))

# `d` as a duration's text.
#
# - `d`: any duration; zero is `0s`, and a negative one has a `-` before it.
#
# From one second up it holds hours, minutes and seconds, the hours and minutes
# only where some are, the seconds with as many fraction digits as they need:
# `1h30m0s`, `1.5s`. Under a second it holds one unit with a fraction: `250ms`,
# `1.5µs`, `7ns`. The microsecond is written `µs` with U+00B5.
function format_duration(d: Duration) -> str
    return duration_text.format(d.nanoseconds)

# The duration `s` writes.
#
# - `s`: an optional sign, then one number or more, each with an optional
#   fraction and a unit: `ns`, `us`, `µs` (U+00B5 or U+03BC), `ms`, `s`, `m` or
#   `h`, so "1h30m", "250ms" and "-1.5h" are read; "0" alone needs no unit.
#
# Fails `invalid` where `s` is empty or not such a text, the message naming the
# byte, and `does_not_fit` where the duration is outside a `Duration`.
function parse_duration(s: str) -> Duration?
    return ok(Duration(nanoseconds: duration_text.parse(s)?))

## Time zones

# The version of the IANA time zone database whose names `zone_names` lists
# and whose data Rebel carries for a system that has none, as on Windows.
constant ZONE_DATA_VERSION: str
    carried_names.VERSION

# The offset from UTC a zone's clocks keep for a while, as its data names it.
record ZoneOffset
    # How far the zone's clocks stand ahead of UTC, negative west of
    # Greenwich: one hour for Central European Time. Whole seconds, and less
    # than a day either way in every zone made here.
    from_utc: Duration
    # The abbreviation the data gives, `CET` or `CEST`, or the offset itself,
    # `+0530`, where the data has no letters; `UTC` in `utc_zone`.
    abbreviation: str
    # Whether the data flags the offset as daylight saving (summer) time.
    is_daylight: bool

# A moment a zone's offset changes, and the offset from then on.
record ZoneChange
    # The instant of the change; the new offset holds from it, it included.
    at: Instant
    # The offset from `at` up to the next change.
    offset: ZoneOffset

# A time zone: the offsets a place's clocks have kept, and the ones its rule
# says they will keep, as a list of changes. `load_zone`, `local_zone`,
# `decode_tzif`, `fixed_zone` and `utc_zone` make one; a zone built directly
# is read as its fields say, and its answers mean something only where
# `changes` is in the order of `at`, each after the one before (nothing aborts
# where it is not).
record Zone
    # The zone's name: `Europe/Rome` as `load_zone` was asked, the name a
    # fixed zone was given, or what `local_zone` says it found.
    name: str
    # The offset before the first change, and at every instant where there
    # is no change.
    first: ZoneOffset
    # Every change of offset an `Instant` reaches, from 1677 to 2262, the
    # oldest first: the database's own, then those its rule for the years
    # after them computes.
    changes: [ZoneChange]

# How `from_date_time_in` reads a local time that a change of offset skipped
# (a gap: the clocks went forward over it) or repeated (an overlap: they went
# back over it). The examples are a gap from 02:00 to 03:00.
variant Disambiguation
    # In a gap, the time moved forward by the gap's length, 02:30 read as
    # 03:30; in an overlap, the earlier instant. Python's `fold=0`, and the
    # default of Java and of JavaScript's Temporal.
    compatible
    # In a gap, the time moved back by the gap's length, 02:30 read as 01:30;
    # in an overlap, the earlier instant.
    earlier
    # In a gap, the time moved forward, 02:30 read as 03:30; in an overlap,
    # the later instant.
    later
    # Neither: a time in a gap or an overlap fails `invalid`.
    reject

# A zone by its name in the IANA database, `Europe/Rome` or `America/New_York`.
#
# - `name`: the name, a relative path with no empty part, no `.` and no `..`;
#   `UTC` is one. Its case matters where the system's files are compared so.
#
# Darwin and Linux read the system's zone files (`/usr/share/zoneinfo`, then
# `/usr/lib/zoneinfo`, `/usr/share/lib/zoneinfo` and `/etc/zoneinfo`, as
# Python's `zoneinfo` does), so a zone follows the system's updates; Windows,
# which has none, and a system whose files lack the name, read the data Rebel
# carries, `ZONE_DATA_VERSION`. Each call reads the file again.
#
# Fails `invalid` where the name is no such path or its file is not TZif,
# `not_found` where no file and no carried data has the name, `permission`
# where the system refuses the file, `unsupported` where the file counts leap
# seconds, which an `Instant` does not, and `failed` where the read fails
# otherwise. See also `local_zone`, `zone_names`.
function load_zone(name: str) -> Zone?
    return decode_tzif(name: name, data: zone_files.named(name)?)

# The zone the machine's clocks keep: the environment variable `TZ` where it
# is set, then the system's own setting.
#
# `TZ` set empty is UTC; set to a name, with or without a `:` before it, it is
# `load_zone`'s; set to an absolute path, that file is read; set to a POSIX
# rule, `CET-1CEST,M3.5.0,M10.5.0/3`, the rule is the zone. Without `TZ`,
# Darwin and Linux read `/etc/localtime`, and the zone is named after the part
# of its link after `zoneinfo/`, or `Local` where it is no link. Windows
# without `TZ` fails `unsupported`: its own setting names its zones otherwise.
#
# Fails as `load_zone` does, `invalid` for a `TZ` that is none of the above,
# and `not_found` where `/etc/localtime` is missing. See also `load_zone`.
function local_zone() -> Zone?
    source = zone_files.local()?
    return decode_tzif(name: source.name, data: source.data)

# UTC, offset zero, needing no data.
#
# Its name is `UTC`, its abbreviation `UTC`, and it has no change.
function utc_zone() -> Zone
    return Zone(
        name: "UTC",
        first: ZoneOffset(from_utc: Duration(nanoseconds: 0), abbreviation: "UTC", is_daylight: false),
        changes: []
    )

# A zone that keeps one offset from UTC at every instant, as Go's `FixedZone`
# and Python's `timezone` make.
#
# - `name`: its name and its abbreviation, any text, the empty text included.
# - `offset`: how far its clocks stand ahead of UTC, in whole seconds, less
#   than a day either way: `hours(-5)` for five hours west of Greenwich.
#
# Fails `invalid` where `offset` is not whole seconds or is a day or more.
function fixed_zone(name: str, offset: Duration) -> Zone?
    if offset.nanoseconds % arith.SECOND != 0
        return fail(
            code: INVALID,
            msg: f"the offset {format_duration(offset)} of the zone \"{name}\" is not whole seconds"
        )

    if offset.nanoseconds <= -civil.DAY || offset.nanoseconds >= civil.DAY
        return fail(code: INVALID, msg: f"the offset {format_duration(offset)} of the zone \"{name}\" is a day or more")
    return ok(
        Zone(name: name, first: ZoneOffset(from_utc: offset, abbreviation: name, is_daylight: false), changes: [])
    )

# The zone that `data`, a file in the TZif format of RFC 9636 (what
# `/usr/share/zoneinfo` holds), describes.
#
# - `name`: the name the zone takes, any text.
# - `data`: the bytes of the file, of any version from 1 to 4.
#
# The changes after the file's last transition come from the rule in its
# footer, from versions 2 on; a file of version 1 keeps its last offset.
#
# Fails `invalid` where `data` is not TZif or contradicts itself, the message
# naming the byte, and `unsupported` where it counts leap seconds. See also
# `load_zone`.
function decode_tzif(name: str, data: [u8]) -> Zone?
    built = zone_table.from_tzif(data)?
    changes: [ZoneChange] @= []

    for step in built.changes
        changes @ changes.push(
            ZoneChange(at: Instant(unix_nanoseconds: step.at * arith.SECOND), offset: ZoneOffset(from_utc: Duration(nanoseconds: step.kind.offset * arith.SECOND), abbreviation: step.kind.abbreviation, is_daylight: step.kind.daylight))
        )

    first = ZoneOffset(
        from_utc: Duration(nanoseconds: built.first.offset * arith.SECOND),
        abbreviation: built.first.abbreviation,
        is_daylight: built.first.daylight
    )
    return ok(Zone(name: name, first: first, changes: changes))

# Every zone name of the IANA database Rebel carries, sorted by their bytes.
#
# Aliases are there, `US/Eastern` beside `America/New_York`, as Python's
# `available_timezones` lists them. A system may hold a name this list lacks,
# or lack one it holds; `load_zone` asks the system first. See also
# `ZONE_DATA_VERSION`.
function zone_names() -> [str]
    return carried_names.names()

# The offset `zone` keeps at `t`, and its abbreviation.
#
# - `zone`: the zone.
# - `t`: any instant.
#
# Costs a search of the zone's changes, in time logarithmic in their count.
# See also `previous_change`, `to_date_time_in`.
function offset_at(zone: Zone, t: Instant) -> ZoneOffset
    match previous_change(zone, t)
        .ok change => return change.offset
        .err _     => return zone.first

# The last change of `zone` at or before `t`: the one whose offset holds at
# `t`.
#
# - `zone`: the zone.
# - `t`: any instant.
#
# Fails `not_found` where the zone has no change at or before `t`. See also
# `next_change`.
function previous_change(zone: Zone, t: Instant) -> ZoneChange?
    low: i64 @= 0
    high: i64 @= zone.changes.len()

    while low < high
        middle = low + (high - low) / 2

        if zone.changes[middle].at.unix_nanoseconds <= t.unix_nanoseconds
            low @ middle + 1
        else
            high @ middle

    if low == 0
        return fail(
            code: NOT_FOUND,
            msg: f"{zone.name} has no change of offset at or before {format(t, layout: .rfc3339)}"
        )
    return ok(zone.changes[low - 1])

# The first change of `zone` after `t`: when the offset at `t` ends.
#
# - `zone`: the zone.
# - `t`: any instant.
#
# Fails `not_found` where the zone has no change after `t`, as a zone with no
# daylight saving time has none. See also `previous_change`.
function next_change(zone: Zone, t: Instant) -> ZoneChange?
    low: i64 @= 0
    high: i64 @= zone.changes.len()

    while low < high
        middle = low + (high - low) / 2

        if zone.changes[middle].at.unix_nanoseconds <= t.unix_nanoseconds
            low @ middle + 1
        else
            high @ middle

    if low == zone.changes.len()
        return fail(code: NOT_FOUND, msg: f"{zone.name} has no change of offset after {format(t, layout: .rfc3339)}")
    return ok(zone.changes[low])

# The calendar's name for `t` on the clocks of `zone`: its local date and time.
#
# - `t`: any instant.
# - `zone`: the zone.
#
# The year may be 1677 or 2262 where the offset carries an instant at either
# end of the range across a new year. See also `from_date_time_in`,
# `offset_at`.
function to_date_time_in(t: Instant, zone: Zone) -> DateTime
    c = zone_local.civil_at(nanoseconds: t.unix_nanoseconds, offset: offset_at(zone, t).from_utc.nanoseconds)
    return DateTime(
        year: c.year,
        month: c.month,
        day: c.day,
        hour: c.hour,
        minute: c.minute,
        second: c.second,
        nanosecond: c.nanosecond
    )

# The instant `dt` names on the clocks of `zone`.
#
# - `dt`: the local date and time, each field within its range.
# - `zone`: the zone.
# - `choice`: what a time the clocks skipped or repeated means; a time they
#   kept once means one instant whatever it is.
#
# Fails `invalid` where a field of `dt` is outside its range, or where
# `choice` is `reject` and the time falls in a gap or an overlap, the message
# saying which; fails `does_not_fit` where the instant is outside an
# `Instant`. See also `to_date_time_in`.
function from_date_time_in(dt: DateTime, zone: Zone, choice: Disambiguation) -> Instant?
    c = civil.Civil(
        year: dt.year,
        month: dt.month,
        day: dt.day,
        hour: dt.hour,
        minute: dt.minute,
        second: dt.second,
        nanosecond: dt.nanosecond
    )
    bounds = zone_local.window(c)?
    start = Instant(unix_nanoseconds: bounds.from)
    first = offset_at(zone, start).from_utc.nanoseconds
    before: i64 @= first
    reached: Instant @= start
    steps: [zone_local.Step] @= []

    while true
        match next_change(zone, reached)
            .ok change =>
                if change.at.unix_nanoseconds > bounds.to || change.at.unix_nanoseconds <= reached.unix_nanoseconds
                    break
                steps @ steps.push(
                    zone_local.Step(at: change.at.unix_nanoseconds, before: before, after: change.offset.from_utc.nanoseconds)
                )
                before @ change.offset.from_utc.nanoseconds
                reached @ change.at
            .err _ => break

    code = match choice
        .compatible => zone_local.COMPATIBLE
        .earlier    => zone_local.EARLIER
        .later      => zone_local.LATER
        .reject     => zone_local.REJECT

    return ok(
        Instant(unix_nanoseconds: zone_local.resolve(c: c, steps: steps, first: first, choice: code, zone: zone.name)?)
    )

## Cron schedules

# A schedule read from a cron expression by `parse_cron`, and only by it.
# `next_run` and `next_runs` answer when it runs on a zone's clocks.
record Cron
    # The expression as it was given.
    text: str
    # What each field allows, read only by this package's functions.
    spec: cron_read.Spec

# The schedule the cron expression `s` writes.
#
# - `s`: five fields, minute, hour, day of the month, month and day of the
#   week, or six with the seconds first, split by spaces or tabs; or a
#   descriptor, `@yearly` (or `@annually`), `@monthly`, `@weekly`, `@daily`
#   (or `@midnight`), `@hourly`, or `@every` and a duration as
#   `parse_duration` reads it, whole seconds from 1s up.
#
# A field is a list of items split by commas: `*` or `?` for every value; a
# value; a range `a-b`; each of them with a step, `*/15`, `10-50/5`, or `5/15`
# from 5 to the field's end, Saturday for the day of the week. Months and days
# of the week may be named by their first three letters in any case, `JAN`,
# `mon`. The day of the week is 0 for Sunday to 6, and 7 is Sunday too, so
# `5-7` and `FRI-SUN` are Friday to Sunday. The day of the month also reads `L`
# (its last day), `L-3` (three before it), `15W` (the weekday nearest the 15th,
# never in another month) and `LW` (its last weekday); the day of the week
# reads `5L` (the month's last Friday) and `5#3` (its third Friday). Where both
# day fields are restricted a day either allows runs; where one is `*` or `?`
# the other alone decides, as Vixie cron and robfig/cron read them.
#
# Fails `invalid` where `s` is none of these, the message naming the field
# and its text. See also `next_run`.
function parse_cron(s: str) -> Cron?
    return ok(Cron(text: s, spec: cron_read.read(s)?))

# The first instant strictly after `after` at which `schedule` runs on the
# clocks of `zone`.
#
# - `schedule`: the schedule.
# - `after`: the instant to search from, left out; its fraction of a second
#   is set aside, so the answer is a whole second.
# - `zone`: the zone whose clocks the fields are read on; `utc_zone()` for
#   UTC.
#
# A local time a change of offset skipped (a gap) never runs, and one it
# repeated (an overlap) runs at each of its two instants, as robfig/cron
# answers. `@every` runs that long after `after`'s whole second, whatever
# the zone. Fails `not_found` where no run falls before the last instant an
# `Instant` holds, in 2262: the search walks the calendar a month at a time
# where a month cannot match, so a schedule that never runs, `0 0 30 2 *`,
# is refused after about 240 years of months. See also `next_runs`.
function next_run(schedule: Cron, after: Instant, zone: Zone) -> Instant?
    ats: [i64] @= []
    offsets: [i64] @= []

    for change in zone.changes
        ats @ ats.push(change.at.unix_nanoseconds)
        offsets @ offsets.push(change.offset.from_utc.nanoseconds)

    found = cron_next.next_instant(spec: schedule.spec, after: after.unix_nanoseconds, ats: ats, offsets: offsets, first: zone.first.from_utc.nanoseconds)?
    return ok(Instant(unix_nanoseconds: found))

# The next `count` instants at which `schedule` runs on the clocks of
# `zone`, each strictly after the one before, the first strictly after
# `after`.
#
# - `schedule`: the schedule.
# - `after`: the instant to search from, left out.
# - `zone`: the zone whose clocks the fields are read on.
# - `count`: how many; none for 0 or less.
#
# The list is in order, and shorter than `count` only where the runs end
# before the last instant an `Instant` holds. See also `next_run`.
function next_runs(schedule: Cron, after: Instant, zone: Zone, count: i64) -> [Instant]
    ats: [i64] @= []
    offsets: [i64] @= []

    for change in zone.changes
        ats @ ats.push(change.at.unix_nanoseconds)
        offsets @ offsets.push(change.offset.from_utc.nanoseconds)

    runs: [Instant] @= []
    at: i64 @= after.unix_nanoseconds

    while runs.len() < count
        match cron_next.next_instant(spec: schedule.spec, after: at, ats: ats, offsets: offsets, first: zone.first.from_utc.nanoseconds)
            .ok found =>
                runs @ runs.push(Instant(unix_nanoseconds: found))
                at @ found
            .err _ => break

    return runs

## Tests

test "now, since and until: the wall clock stands after 2026 and before 2100, and a past instant was"
    current = now().must()
    assert current.unix_nanoseconds > 1_767_225_600_000_000_000
    assert current.unix_nanoseconds < 4_102_444_800_000_000_000
    assert since(epoch()).must().nanoseconds > 0
    assert until(epoch()).must().nanoseconds < 0
    assert since(min_instant()).is_err()
    assert until(min_instant()).is_err()

test "mark, elapsed, between_marks and sleep: ten milliseconds slept are ten by the monotonic clock"
    start = mark().must()
    sleep(milliseconds(10))
    assert elapsed(start).must().nanoseconds >= 10_000_000
    later = mark().must()
    assert between_marks(from: start, to: later).must().nanoseconds >= 10_000_000
    assert between_marks(from: later, to: start).must().nanoseconds <= -10_000_000
    assert between_marks(from: Mark(nanoseconds: -1), to: Mark(nanoseconds: 9_223_372_036_854_775_807)).is_err()

test "sleep: zero, a negative duration and the most negative return at once"
    start = mark().must()
    sleep(nanoseconds(0))
    sleep(nanoseconds(-1))
    sleep(min_duration())
    assert elapsed(start).must().nanoseconds < 1_000_000_000

# Expected values observed with Go's `Time.Unix`, `UnixMilli` and `UnixMicro`,
# and `time.Unix(1, -1)`, 2026-11-15.
test "epoch, min_instant, max_instant, from_unix and unix_seconds: both ends, half a second before 1970, and nanoseconds past a second"
    assert epoch().unix_nanoseconds == 0
    assert unix_seconds(min_instant()) == -9_223_372_037
    assert unix_milliseconds(min_instant()) == -9_223_372_036_855
    assert unix_microseconds(min_instant()) == -9_223_372_036_854_776
    assert unix_seconds(max_instant()) == 9_223_372_036
    assert unix_milliseconds(max_instant()) == 9_223_372_036_854
    assert unix_microseconds(max_instant()) == 9_223_372_036_854_775
    half = Instant(unix_nanoseconds: -500_000_000)
    assert unix_seconds(half) == -1
    assert unix_milliseconds(half) == -500
    assert unix_microseconds(Instant(unix_nanoseconds: -1)) == -1
    assert from_unix(whole_seconds: 1, extra_nanoseconds: -1).must().unix_nanoseconds == 999_999_999
    assert from_unix(whole_seconds: -9_223_372_037, extra_nanoseconds: 145_224_192).must() == min_instant()
    assert from_unix(whole_seconds: 9_223_372_037, extra_nanoseconds: 0).is_err()
    assert from_unix_milliseconds(-9_223_372_036_854).must().unix_nanoseconds == -9_223_372_036_854_000_000
    assert from_unix_milliseconds(9_223_372_036_855).is_err()
    assert from_unix_microseconds(9_223_372_036_854_775).must().unix_nanoseconds == 9_223_372_036_854_775_000
    assert from_unix_microseconds(-9_223_372_036_854_776).is_err()

test "add, between, is_before and is_after: across 1970, past either end, and two instants too far apart"
    assert add(t: epoch(), d: nanoseconds(-1)).must().unix_nanoseconds == -1
    assert add(t: max_instant(), d: nanoseconds(1)).is_err()
    assert add(t: min_instant(), d: nanoseconds(-1)).is_err()
    assert between(from: epoch(), to: Instant(unix_nanoseconds: -1)).must() == nanoseconds(-1)
    assert between(from: min_instant(), to: max_instant()).is_err()
    assert between(from: max_instant(), to: epoch()).must() == nanoseconds(-9_223_372_036_854_775_807)
    assert is_before(a: min_instant(), b: epoch())
    assert !is_before(a: epoch(), b: epoch())
    assert is_after(a: max_instant(), b: epoch())
    assert !is_after(a: epoch(), b: epoch())

# Expected values observed with Go's `Time.Truncate` and `Time.Round`,
# 2026-11-15.
test "truncate and round: half a second, before 1970, a unit of zero, and past either end"
    t = Instant(unix_nanoseconds: 1_136_214_245_500_000_000)
    second = duration_of(.second)
    assert truncate(t: t, unit: second).must().unix_nanoseconds == 1_136_214_245_000_000_000
    assert round(t: t, unit: second).must().unix_nanoseconds == 1_136_214_246_000_000_000
    assert truncate(t: Instant(unix_nanoseconds: -1_500_000_000), unit: second).must().unix_nanoseconds == -2_000_000_000
    assert truncate(t: t, unit: duration_of(.day)).must() == date(year: 2006, month: 1, day: 2).must()
    assert truncate(t: min_instant(), unit: second).is_err()
    assert round(t: max_instant(), unit: second).is_err()

    match truncate(t: t, unit: nanoseconds(0))
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    assert round(t: t, unit: nanoseconds(-5)).is_err()

test "duration_of and the constructors: every unit, a negative count, and one past what fits"
    assert duration_of(.nanosecond) == nanoseconds(1)
    assert duration_of(.week) == days(7)
    assert microseconds(3) == nanoseconds(3_000)
    assert milliseconds(-3) == nanoseconds(-3_000_000)
    assert seconds(1) == duration_of(.second)
    assert minutes(90) == hours(1).sum(b: minutes(30)).must()
    assert hours(2_562_047) == nanoseconds(9_223_369_200_000_000_000)
    assert hours_checked(2_562_048).is_err()
    assert seconds(-9_223_372_036) == nanoseconds(-9_223_372_036_000_000_000)
    assert seconds_checked(9_223_372_037).is_err()
    assert weeks(15_250) == nanoseconds(9_223_200_000_000_000_000)
    assert weeks_checked(15_251).is_err()
    assert minutes_checked(-153_722_868).is_err()

test "the checked constructors: each agrees with its plain one at the largest count that fits, both ways, and fails one past it"
    assert microseconds_checked(9_223_372_036_854_775).must() == microseconds(9_223_372_036_854_775)
    assert microseconds_checked(-9_223_372_036_854_775).must() == microseconds(-9_223_372_036_854_775)
    assert microseconds_checked(9_223_372_036_854_776).is_err()
    assert microseconds_checked(-9_223_372_036_854_776).is_err()
    assert milliseconds_checked(9_223_372_036_854).must() == milliseconds(9_223_372_036_854)
    assert milliseconds_checked(9_223_372_036_855).is_err()
    assert seconds_checked(-9_223_372_036).must() == seconds(-9_223_372_036)
    assert seconds_checked(-9_223_372_037).is_err()
    assert minutes_checked(153_722_867).must() == minutes(153_722_867)
    assert minutes_checked(153_722_868).is_err()
    assert hours_checked(-2_562_047).must() == hours(-2_562_047)
    assert hours_checked(-2_562_048).is_err()
    assert days_checked(106_751).must() == days(106_751)
    assert days_checked(106_752).is_err()
    assert weeks_checked(-15_250).must() == weeks(-15_250)
    assert weeks_checked(-15_251).is_err()
    assert seconds_checked(0).must() == nanoseconds(0)

    match days_checked(106_752)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

# Expected values observed with Rust's `Duration::try_from_secs_f64`,
# 2026-11-15.
test "from_seconds_float: a tie to even, a product the machine rounds across a half, and not a number"
    assert from_seconds_float(1.5).must() == nanoseconds(1_500_000_000)
    assert from_seconds_float(0.0000000015).must() == nanoseconds(1)
    assert from_seconds_float(0.0009765625).must() == nanoseconds(976_562)
    assert from_seconds_float(-0.0009765625).must() == nanoseconds(-976_562)
    zero: f64 = 0.0

    match from_seconds_float(zero / zero)
        .ok _  => assert false
        .err e => assert e.code == "invalid"

    match from_seconds_float(1.0 / zero)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

test "sum, difference, negate, abs, scale and divide: at either end of a duration, and a count of zero"
    longest = max_duration()
    shortest = min_duration()
    assert sum(a: longest, b: shortest).must() == nanoseconds(-1)
    assert sum(a: longest, b: nanoseconds(1)).is_err()
    assert difference(a: shortest, b: nanoseconds(1)).is_err()
    assert difference(a: nanoseconds(-1), b: longest).must() == shortest
    assert negate(longest).must() == nanoseconds(-9_223_372_036_854_775_807)
    assert negate(shortest).is_err()
    assert abs(nanoseconds(-5)).must() == nanoseconds(5)
    assert abs(shortest).is_err()
    assert scale(d: shortest, by: 1).must() == shortest
    assert scale(d: shortest, by: -1).is_err()
    assert scale(d: longest, by: 0).must() == nanoseconds(0)
    assert divide(d: seconds(7), by: -2).must() == nanoseconds(-3_500_000_000)
    assert divide(d: nanoseconds(-7), by: 2).must() == nanoseconds(-3)
    assert divide(d: shortest, by: -1).is_err()

    match divide(d: seconds(1), by: 0)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "1s cannot be cut into 0 parts"

# Expected values observed with Go's `Duration.Hours`, `Minutes`, `Seconds`,
# `Milliseconds`, `Truncate` and `Round`, 2026-11-15.
test "to_units, remainder, to_float, truncate_duration and round_duration: 90 minutes, -1.9 seconds, and a tie"
    ninety = minutes(90)
    assert to_float(d: ninety, unit: .hour) == 1.5
    assert to_float(d: ninety, unit: .minute) == 90.0
    assert to_float(d: ninety, unit: .second) == 5400.0
    assert to_units(d: ninety, unit: .millisecond) == 5_400_000
    back = milliseconds(-1_900)
    assert to_float(d: back, unit: .second) == -1.9
    assert to_units(d: back, unit: .second) == -1
    assert remainder(d: back, unit: .second) == milliseconds(-900)
    assert to_units(d: back, unit: .millisecond) == -1_900
    assert to_units(d: min_duration(), unit: .nanosecond) == -9_223_372_036_854_775_807 - 1
    assert truncate_duration(d: back, unit: duration_of(.second)).must() == seconds(-1)
    assert round_duration(d: back, unit: duration_of(.second)).must() == seconds(-2)
    assert round_duration(d: milliseconds(1_500), unit: duration_of(.second)).must() == seconds(2)
    assert round_duration(d: milliseconds(-1_500), unit: duration_of(.second)).must() == seconds(-2)
    assert round_duration(d: max_duration(), unit: duration_of(.second)).is_err()
    assert truncate_duration(d: back, unit: nanoseconds(0)).is_err()
    assert is_shorter(a: min_duration(), b: nanoseconds(0))
    assert !is_shorter(a: nanoseconds(0), b: nanoseconds(0))
    assert is_longer(a: max_duration(), b: nanoseconds(0))

# Expected values observed with Go's `time.Date`, `Weekday`, `YearDay` and
# `ISOWeek`, and Python's `date.isocalendar`, 2026-11-15.
test "to_date_time, weekday_of, day_of_year and iso_week: 1970, 2000-02-29, 1900-03-01, 2100-02-28, and both ends"
    assert to_date_time(epoch()) == DateTime(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
    assert weekday_of(epoch()) == .thursday
    leap = date(year: 2000, month: 2, day: 29).must()
    assert leap.unix_nanoseconds == 951_782_400_000_000_000
    assert weekday_of(leap) == .tuesday
    assert day_of_year(leap) == 60
    assert iso_week(leap) == IsoWeek(year: 2000, week: 9)
    century = date(year: 1900, month: 3, day: 1).must()
    assert century.unix_nanoseconds == -2_203_891_200_000_000_000
    assert weekday_of(century) == .thursday
    assert day_of_year(century) == 60
    later = date(year: 2100, month: 2, day: 28).must()
    assert later.unix_nanoseconds == 4_107_456_000_000_000_000
    assert weekday_of(later) == .sunday
    assert iso_week(later) == IsoWeek(year: 2100, week: 8)
    assert to_date_time(min_instant()) == DateTime(year: 1677, month: 9, day: 21, hour: 0, minute: 12, second: 43, nanosecond: 145_224_192)
    assert weekday_of(min_instant()) == .tuesday
    assert iso_week(min_instant()) == IsoWeek(year: 1677, week: 38)
    assert to_date_time(max_instant()) == DateTime(year: 2262, month: 4, day: 11, hour: 23, minute: 47, second: 16, nanosecond: 854_775_807)
    assert weekday_of(max_instant()) == .friday
    assert day_of_year(max_instant()) == 101
    before = Instant(unix_nanoseconds: -1)
    assert to_date_time(before) == DateTime(year: 1969, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 999_999_999)
    assert weekday_of(before) == .wednesday
    assert iso_week(before) == IsoWeek(year: 1970, week: 1)

test "from_date_time and date: the last nanosecond of a year, a day a month lacks, a leap second, and a year past 2262"
    last = DateTime(year: 1999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 999_999_999)
    assert from_date_time(last).must().unix_nanoseconds == 946_684_799_999_999_999
    assert to_date_time(from_date_time(last).must()) == last

    match date(year: 1900, month: 2, day: 29)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "the day 29 is outside 1 to 28 in month 2 of 1900"

    leap_second = DateTime(year: 2016, month: 12, day: 31, hour: 23, minute: 59, second: 60, nanosecond: 0)
    assert from_date_time(leap_second).is_err()

    match date(year: 2263, month: 1, day: 1)
        .ok _  => assert false
        .err e => assert e.code == "does_not_fit"

    assert date(year: 1677, month: 9, day: 21).is_err()
    assert date(year: 1677, month: 9, day: 22).must().unix_nanoseconds == -9_223_286_400_000_000_000
    assert date(year: 2006, month: 0, day: 1).is_err()
    assert date(year: -9_223_372_036_854_775_807 - 1, month: 1, day: 1).is_err()

test "weekday_name, weekday_number, month_name: every end of their ranges"
    assert weekday_name(.monday) == "Monday"
    assert weekday_name(.sunday) == "Sunday"
    assert weekday_number(.monday) == 1
    assert weekday_number(.sunday) == 7
    assert month_name(1).must() == "January"
    assert month_name(12).must() == "December"
    assert month_name(0).is_err()

    match month_name(13)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "the month 13 is outside 1 to 12"

# Expected values observed with Python's `date.fromisocalendar`,
# `calendar.isleap`, `calendar.leapdays` and `calendar.monthrange`, 2026-11-15.
test "from_iso_week, is_leap_year, leap_years_between, days_in_month and days_in_year: the centuries and a week 53"
    assert from_iso_week(year: 2009, week: 53, day: .sunday).must() == date(year: 2010, month: 1, day: 3).must()
    assert from_iso_week(year: 2009, week: 1, day: .monday).must() == date(year: 2008, month: 12, day: 29).must()
    assert from_iso_week(year: 2010, week: 53, day: .monday).is_err()
    assert from_iso_week(year: 1677, week: 1, day: .monday).is_err()
    assert is_leap_year(2000)
    assert !is_leap_year(1900)
    assert !is_leap_year(2100)
    assert leap_years_between(from: 1970, to: 2000) == 7
    assert days_in_month(year: 2000, month: 2).must() == 29
    assert days_in_month(year: 1900, month: 2).must() == 28
    assert days_in_month(year: 2100, month: 2).must() == 28
    assert days_in_month(year: 2000, month: 13).is_err()
    assert days_in_year(2000) == 366
    assert days_in_year(2100) == 365

# Go's `AddDate` would carry January 31 and a month into March 3, and February
# 29 and a year into March 1; this package keeps the month (its doc's rule).
test "add_months and add_years: the 31st into February, a leap day a year on, backwards, and out of range"
    jan31 = date(year: 2001, month: 1, day: 31).must()
    assert add_months(t: jan31, months: 1).must() == date(year: 2001, month: 2, day: 28).must()
    assert add_months(t: jan31, months: -1).must() == date(year: 2000, month: 12, day: 31).must()
    assert add_years(t: date(year: 2000, month: 2, day: 29).must(), years: 1).must() == date(year: 2001, month: 2, day: 28).must()
    assert add_years(t: date(year: 2000, month: 2, day: 29).must(), years: 4).must() == date(year: 2004, month: 2, day: 29).must()
    assert add_years(t: epoch(), years: 300).is_err()
    assert add_years(t: epoch(), years: 9_223_372_036_854_775_807).is_err()
    assert add_months(t: max_instant(), months: 0).must() == max_instant()

# Expected texts observed with Go's `Time.Format` and `time.Parse`, 2026-11-15.
test "format and parse: every layout at one moment, and an offset moved to UTC"
    t = Instant(unix_nanoseconds: 1_136_214_245_123_456_789)
    assert format(t: t, layout: .rfc3339) == "2006-01-02T15:04:05.123456789Z"
    assert format(t: t, layout: .rfc3339_seconds) == "2006-01-02T15:04:05Z"
    assert format(t: t, layout: .rfc3339_milliseconds) == "2006-01-02T15:04:05.123Z"
    assert format(t: t, layout: .rfc3339_microseconds) == "2006-01-02T15:04:05.123456Z"
    assert format(t: t, layout: .rfc3339_nanoseconds) == "2006-01-02T15:04:05.123456789Z"
    assert format(t: t, layout: .date_time) == "2006-01-02 15:04:05"
    assert format(t: t, layout: .date_only) == "2006-01-02"
    assert format(t: t, layout: .time_only) == "15:04:05"
    assert format(t: t, layout: .http) == "Mon, 02 Jan 2006 15:04:05 GMT"
    assert format(t: t, layout: .rfc850) == "Monday, 02-Jan-06 15:04:05 GMT"
    assert format(t: t, layout: .ansic) == "Mon Jan  2 15:04:05 2006"
    assert format(t: t, layout: .email) == "Mon, 02 Jan 2006 15:04:05 +0000"
    assert parse(s: "2006-01-02T15:04:05.123456789Z", layout: .rfc3339_seconds).must() == t
    assert parse(s: "2006-01-02T20:34:05.123456789+05:30", layout: .rfc3339).must() == t
    assert parse(s: "Mon, 02 Jan 2006 15:04:05 GMT", layout: .http).must() == truncate(t: t, unit: duration_of(.second)).must()
    assert parse(s: "15:04:05", layout: .time_only).must().unix_nanoseconds == 54_245_000_000_000
    assert format(t: min_instant(), layout: .rfc3339) == "1677-09-21T00:12:43.145224192Z"
    assert format(t: max_instant(), layout: .rfc3339) == "2262-04-11T23:47:16.854775807Z"

    match parse(s: "2006-01-02", layout: .rfc3339)
        .ok _  => assert false
        .err e => assert e.code == "invalid" && e.msg == "at byte 10 of \"2006-01-02\": expected \"T\" between the date and the time"

# Expected texts observed with Go's `Duration.String` and `time.ParseDuration`,
# 2026-11-15.
test "format_duration and parse_duration: zero, a microsecond's sign, hours, and both ends"
    assert format_duration(nanoseconds(0)) == "0s"
    assert format_duration(nanoseconds(1_500)) == "1.5µs"
    assert format_duration(minutes(90)) == "1h30m0s"
    assert format_duration(min_duration()) == "-2562047h47m16.854775808s"
    assert parse_duration("1h30m").must() == minutes(90)
    assert parse_duration("250ms").must() == milliseconds(250)
    assert parse_duration("-2562047h47m16.854775808s").must() == min_duration()
    assert parse_duration("2562047h47m16.854775808s").is_err()
    assert parse_duration("").is_err()

# Python's `zoneinfo`, version 2026f's data, answered every offset and
# abbreviation: Rome either side of both changes of 2026, LMT in 1850 and CEST
# in 2200 and on 2262-04-11; New York's change; Lord Howe's half hour;
# Dublin's GMT and IST, which this Mac's data writes with GMT as standard time
# (its footer `GMT0IST,M3.5.0/1,M10.5.0`, Python's `dst()` 0 in January and an
# hour in July); Apia's lost day.
test "decode_tzif, offset_at and the carried data: changes of 2026, before 1900, the rule's years, a half hour, a negative daylight time, and a day skipped"
    rome = decode_tzif(name: "Europe/Rome", data: zone_files.carried("Europe/Rome").must()).must()
    assert offset_at(rome, Instant(unix_nanoseconds: 1_774_745_999_000_000_000)) == ZoneOffset(from_utc: hours(1), abbreviation: "CET", is_daylight: false)
    assert offset_at(rome, Instant(unix_nanoseconds: 1_774_746_000_000_000_000)) == ZoneOffset(from_utc: hours(2), abbreviation: "CEST", is_daylight: true)
    assert offset_at(rome, Instant(unix_nanoseconds: 1_792_889_999_000_000_000)).abbreviation == "CEST"
    assert offset_at(rome, Instant(unix_nanoseconds: 1_792_890_000_000_000_000)).abbreviation == "CET"
    assert offset_at(rome, date(year: 1850, month: 1, day: 1).must()) == ZoneOffset(from_utc: seconds(2_996), abbreviation: "LMT", is_daylight: false)
    assert offset_at(rome, date(year: 2200, month: 7, day: 1).must()).abbreviation == "CEST"
    assert offset_at(rome, date(year: 2262, month: 4, day: 11).must()).abbreviation == "CEST"
    assert offset_at(rome, max_instant()).abbreviation == "CEST"
    assert offset_at(rome, min_instant()).abbreviation == "LMT"
    york = decode_tzif(name: "America/New_York", data: zone_files.carried("America/New_York").must()).must()
    assert offset_at(york, Instant(unix_nanoseconds: 1_772_953_199_000_000_000)).from_utc == hours(-5)
    assert offset_at(york, Instant(unix_nanoseconds: 1_772_953_200_000_000_000)).abbreviation == "EDT"
    assert offset_at(york, date(year: 1850, month: 1, day: 1).must()).from_utc == seconds(-17_762)
    howe = decode_tzif(name: "Australia/Lord_Howe", data: zone_files.carried("Australia/Lord_Howe").must()).must()
    assert offset_at(howe, date(year: 2026, month: 1, day: 1).must()).from_utc == seconds(39_600)
    assert offset_at(howe, date(year: 2026, month: 7, day: 1).must()) == ZoneOffset(from_utc: seconds(37_800), abbreviation: "+1030", is_daylight: false)
    dublin = decode_tzif(name: "Europe/Dublin", data: zone_files.carried("Europe/Dublin").must()).must()
    assert offset_at(dublin, date(year: 2026, month: 1, day: 1).must()) == ZoneOffset(from_utc: seconds(0), abbreviation: "GMT", is_daylight: false)
    assert offset_at(dublin, date(year: 2026, month: 7, day: 1).must()) == ZoneOffset(from_utc: hours(1), abbreviation: "IST", is_daylight: true)
    apia = decode_tzif(name: "Pacific/Apia", data: zone_files.carried("Pacific/Apia").must()).must()
    assert offset_at(apia, Instant(unix_nanoseconds: 1_325_160_000_000_000_000)).from_utc == hours(-10)
    assert offset_at(apia, Instant(unix_nanoseconds: 1_325_246_400_000_000_000)).from_utc == hours(14)

test "decode_tzif fails: no bytes, and the bytes of a text"
    nothing: [u8] = []

    match decode_tzif(name: "x", data: nothing)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    assert decode_tzif(name: "x", data: [0x54, 0x5a, 0x69, 0x66]).is_err()

test "load_zone: a system's zone, UTC, and the names it refuses or cannot find"
    rome = load_zone("Europe/Rome").must()
    assert rome.name == "Europe/Rome" && rome.first.abbreviation == "LMT"
    assert offset_at(load_zone("UTC").must(), now().must()).from_utc == nanoseconds(0)

    match load_zone("../etc/passwd")
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match load_zone("Nowhere/Land")
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    match load_zone("")
        .ok _  => assert false
        .err e => assert e.code == INVALID

test "local_zone: the machine's zone, or the code that says why there is none"
    match local_zone()
        .ok zone => assert zone.name != ""
        .err e   => assert e.code == NOT_FOUND || e.code == UNSUPPORTED

test "utc_zone and fixed_zone: no change, a negative offset, an offset of seconds, and the refusals"
    utc = utc_zone()
    assert utc.changes.len() == 0 && offset_at(utc, max_instant()).abbreviation == "UTC"
    west = fixed_zone(name: "EST", offset: hours(-5)).must()
    assert offset_at(west, epoch()) == ZoneOffset(from_utc: hours(-5), abbreviation: "EST", is_daylight: false)
    assert !fixed_zone(name: "", offset: seconds(86_399)).is_err()
    assert fixed_zone(name: "x", offset: hours(24)).is_err()
    assert fixed_zone(name: "x", offset: hours(-24)).is_err()

    match fixed_zone(name: "x", offset: milliseconds(1_500))
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the offset 1.5s of the zone \"x\" is not whole seconds"

test "zone_names: every name, sorted by bytes, with no duplicate"
    names = zone_names()
    assert names.len() == 598
    k: i64 @= 1

    while k < names.len()
        assert names[k] != names[k - 1]
        k @ k + 1

    assert names[0] == "Africa/Abidjan"

test "previous_change and next_change: inside a year, at a change, before the first, and after the last"
    rome = load_zone("Europe/Rome").must()
    june = date(year: 2026, month: 6, day: 1).must()
    assert previous_change(rome, june).must().at == Instant(unix_nanoseconds: 1_774_746_000_000_000_000)
    assert next_change(rome, june).must().at == Instant(unix_nanoseconds: 1_792_890_000_000_000_000)
    at_change = Instant(unix_nanoseconds: 1_792_890_000_000_000_000)
    assert previous_change(rome, at_change).must().at == at_change
    assert next_change(rome, at_change).must().at.unix_nanoseconds > at_change.unix_nanoseconds
    assert previous_change(rome, min_instant()).is_err()

    match next_change(rome, max_instant())
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    assert next_change(utc_zone(), epoch()).is_err()

# Python's `datetime` answered the two ends at +14 and -12 to the microsecond.
test "to_date_time_in: Rome in summer, the last instant at +14, the first at -12, and Apia's lost day"
    rome = load_zone("Europe/Rome").must()
    noon = to_date_time_in(Instant(unix_nanoseconds: 1_782_900_000_000_000_000), zone: rome)
    assert noon == DateTime(year: 2026, month: 7, day: 1, hour: 12, minute: 0, second: 0, nanosecond: 0)
    kiritimati = decode_tzif(name: "Pacific/Kiritimati", data: zone_files.carried("Pacific/Kiritimati").must()).must()
    assert to_date_time_in(max_instant(), zone: kiritimati) == DateTime(year: 2262, month: 4, day: 12, hour: 13, minute: 47, second: 16, nanosecond: 854_775_807)
    west = decode_tzif(name: "Etc/GMT+12", data: zone_files.carried("Etc/GMT+12").must()).must()
    assert to_date_time_in(min_instant(), zone: west) == DateTime(year: 1677, month: 9, day: 20, hour: 12, minute: 12, second: 43, nanosecond: 145_224_192)
    apia = decode_tzif(name: "Pacific/Apia", data: zone_files.carried("Pacific/Apia").must()).must()
    assert to_date_time_in(Instant(unix_nanoseconds: 1_325_246_400_000_000_000), zone: apia).day == 31

# Python's `datetime` with `fold` 0 and 1 answered each instant.
test "from_date_time_in: a time kept once, a gap and an overlap under every choice, and the failures"
    rome = load_zone("Europe/Rome").must()
    summer = DateTime(year: 2026, month: 7, day: 1, hour: 12, minute: 0, second: 0, nanosecond: 0)
    assert from_date_time_in(summer, zone: rome, choice: .reject).must() == Instant(unix_nanoseconds: 1_782_900_000_000_000_000)
    gap = DateTime(year: 2026, month: 3, day: 29, hour: 2, minute: 30, second: 0, nanosecond: 0)
    assert from_date_time_in(gap, zone: rome, choice: .compatible).must().unix_nanoseconds == 1_774_747_800_000_000_000
    assert from_date_time_in(gap, zone: rome, choice: .earlier).must().unix_nanoseconds == 1_774_744_200_000_000_000
    assert from_date_time_in(gap, zone: rome, choice: .later).must().unix_nanoseconds == 1_774_747_800_000_000_000
    assert from_date_time_in(gap, zone: rome, choice: .reject).is_err()
    twice = DateTime(year: 2026, month: 10, day: 25, hour: 2, minute: 30, second: 0, nanosecond: 0)
    assert from_date_time_in(twice, zone: rome, choice: .compatible).must().unix_nanoseconds == 1_792_888_200_000_000_000
    assert from_date_time_in(twice, zone: rome, choice: .earlier).must().unix_nanoseconds == 1_792_888_200_000_000_000
    assert from_date_time_in(twice, zone: rome, choice: .later).must().unix_nanoseconds == 1_792_891_800_000_000_000

    match from_date_time_in(twice, zone: rome, choice: .reject)
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "2026-10-25 02:30:00 happens twice in Europe/Rome: its clocks went back over it"

    match from_date_time_in(DateTime(year: 2026, month: 2, day: 30, hour: 0, minute: 0, second: 0, nanosecond: 0), zone: rome, choice: .compatible)
        .ok _  => assert false
        .err e => assert e.code == INVALID

    match from_date_time_in(DateTime(year: 2263, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0), zone: rome, choice: .compatible)
        .ok _  => assert false
        .err e => assert e.code == DOES_NOT_FIT

    first = to_date_time_in(min_instant(), zone: rome)
    assert from_date_time_in(first, zone: rome, choice: .reject).must() == min_instant()

test "parse_cron: the text kept as given, and a refusal naming its field"
    assert parse_cron(" 0 9 * * MON-FRI ").must().text == " 0 9 * * MON-FRI "

    match parse_cron("0 9 * * MON-XYZ")
        .ok _  => assert false
        .err e => assert e.code == INVALID && e.msg == "the day of the week field \"MON-XYZ\": \"XYZ\" is not a name"

test "next_runs: robfig's answers on Rome's own zone, a time skipped in March and one run twice in October"
    rome = load_zone("Europe/Rome").must()
    daily = parse_cron("30 2 * * *").must()
    march = next_runs(daily, after: parse("2026-03-27T12:00:00Z", layout: .rfc3339).must(), zone: rome, count: 2)
    assert format(march[0], layout: .rfc3339) == "2026-03-28T01:30:00Z"
    assert format(march[1], layout: .rfc3339) == "2026-03-30T00:30:00Z"
    october = next_runs(daily, after: parse("2026-10-23T12:00:00Z", layout: .rfc3339).must(), zone: rome, count: 4)
    written: [str] @= []

    for t in october
        written @ written.push(format(t, layout: .rfc3339))

    assert written == ["2026-10-24T00:30:00Z", "2026-10-25T00:30:00Z", "2026-10-25T01:30:00Z", "2026-10-26T01:30:00Z"]

test "next_runs and next_run: none for 0 and less, a fixed zone, @every, and a schedule that never runs"
    nine = parse_cron("0 9 * * *").must()
    start = date(year: 2026, month: 1, day: 1).must()
    assert next_runs(nine, after: start, zone: utc_zone(), count: 0).len() == 0
    assert next_runs(nine, after: start, zone: utc_zone(), count: -3).len() == 0
    eastern = fixed_zone(name: "EST", offset: hours(-5)).must()
    assert format(next_run(nine, after: start, zone: eastern).must(), layout: .rfc3339) == "2026-01-01T14:00:00Z"
    every = parse_cron("@every 90s").must()
    assert next_run(every, after: add(t: start, d: milliseconds(500)).must(), zone: eastern).must() == add(t: start, d: seconds(90)).must()

    match next_run(parse_cron("0 0 30 2 *").must(), after: start, zone: load_zone("Europe/Rome").must())
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

    match next_run(nine, after: max_instant(), zone: utc_zone())
        .ok _  => assert false
        .err e => assert e.code == NOT_FOUND

## Examples

# What time it is, by the wall clock.
test "now: the wall clock reads a moment after 2026 began"
    assert is_after(a: now().must(), b: date(year: 2026, month: 1, day: 1).must())

# How long ago a moment was.
test "since: 2020 began more than six years ago"
    ago = since(date(year: 2020, month: 1, day: 1).must()).must()
    assert is_longer(a: ago, b: days(6 * 365))

# How long is left before a moment.
test "until: 2100 is still ahead"
    assert until(date(year: 2100, month: 1, day: 1).must()).must().nanoseconds > 0

# A reading of the monotonic clock, to measure a span with.
test "mark: a reading taken before some work"
    start = mark().must()
    assert elapsed(start).must().nanoseconds >= 0

# How long some work took.
test "elapsed: the time a sleep of five milliseconds took"
    start = mark().must()
    sleep(milliseconds(5))
    assert !is_shorter(a: elapsed(start).must(), b: milliseconds(5))

# The span between two readings a program kept.
test "between_marks: two readings in order"
    first = mark().must()
    second = mark().must()
    assert between_marks(from: first, to: second).must().nanoseconds >= 0

# A pause of a few milliseconds.
test "sleep: a pause of two milliseconds"
    start = mark().must()
    sleep(milliseconds(2))
    assert !is_shorter(a: elapsed(start).must(), b: milliseconds(2))

# The instant the Unix clock counts from.
test "epoch: 1970 began at midnight UTC"
    assert format(epoch(), layout: .rfc3339) == "1970-01-01T00:00:00Z"

# The earliest instant an `Instant` holds.
test "min_instant: a September night of 1677"
    assert format(min_instant(), layout: .rfc3339) == "1677-09-21T00:12:43.145224192Z"

# The latest instant an `Instant` holds.
test "max_instant: an April night of 2262"
    assert format(max_instant(), layout: .rfc3339) == "2262-04-11T23:47:16.854775807Z"

# A Unix time in seconds, as a system call or a file's header writes it.
test "from_unix: the billionth second"
    t = from_unix(whole_seconds: 1_000_000_000, extra_nanoseconds: 0).must()
    assert format(t, layout: .rfc3339) == "2001-09-09T01:46:40Z"

# A Unix time in milliseconds, as JavaScript writes one.
test "from_unix_milliseconds: a moment of November 2023"
    assert format(from_unix_milliseconds(1_700_000_000_000).must(), layout: .rfc3339) == "2023-11-14T22:13:20Z"

# A Unix time in microseconds.
test "from_unix_microseconds: one second after the epoch"
    assert format(from_unix_microseconds(1_000_000).must(), layout: .rfc3339) == "1970-01-01T00:00:01Z"

# An instant as a Unix time in seconds, the nanoseconds left out.
test "unix_seconds: the billionth second and 999 nanoseconds"
    assert unix_seconds(from_unix(whole_seconds: 1_000_000_000, extra_nanoseconds: 999).must()) == 1_000_000_000

# An instant as a Unix time in milliseconds.
test "unix_milliseconds: one and a half seconds after the epoch"
    assert unix_milliseconds(from_unix(whole_seconds: 1, extra_nanoseconds: 500_000_000).must()) == 1_500

# An instant as a Unix time in microseconds.
test "unix_microseconds: one and a half seconds after the epoch"
    assert unix_microseconds(from_unix(whole_seconds: 1, extra_nanoseconds: 500_000_000).must()) == 1_500_000

# A moment a day and a half later.
test "add: 36 hours after midnight"
    later = add(t: date(year: 2026, month: 1, day: 1).must(), d: hours(36)).must()
    assert format(later, layout: .rfc3339) == "2026-01-02T12:00:00Z"

# The span from one moment to another.
test "between: a week from one Thursday to the next"
    from = date(year: 2026, month: 1, day: 1).must()
    to = date(year: 2026, month: 1, day: 8).must()
    assert between(from: from, to: to).must() == days(7)

# Which of two moments comes first.
test "is_before: New Year's Day before the day after"
    assert is_before(a: date(year: 2026, month: 1, day: 1).must(), b: date(year: 2026, month: 1, day: 2).must())

# Which of two moments comes later.
test "is_after: the day after New Year's Day"
    assert is_after(a: date(year: 2026, month: 1, day: 2).must(), b: date(year: 2026, month: 1, day: 1).must())

# A moment cut to the start of its hour.
test "truncate: 12:34:56 to the hour"
    t = parse("2026-03-05T12:34:56Z", layout: .rfc3339).must()
    assert format(truncate(t, unit: hours(1)).must(), layout: .rfc3339) == "2026-03-05T12:00:00Z"

# A moment rounded to the nearest minute.
test "round: 12:34:56 to the minute"
    t = parse("2026-03-05T12:34:56Z", layout: .rfc3339).must()
    assert format(round(t, unit: minutes(1)).must(), layout: .rfc3339) == "2026-03-05T12:35:00Z"

# One unit as a duration, for a function that takes a `Duration`.
test "duration_of: a minute is sixty seconds"
    assert duration_of(.minute) == seconds(60)

# A duration counted in nanoseconds.
test "nanoseconds: 1,500 of them"
    assert format_duration(nanoseconds(1_500)) == "1.5µs"

# A duration counted in microseconds.
test "microseconds: three of them"
    assert microseconds(3) == nanoseconds(3_000)

# A duration counted in milliseconds.
test "milliseconds: a quarter of a second"
    assert milliseconds(250) == nanoseconds(250_000_000)

# A duration counted in seconds.
test "seconds: a minute and a half"
    assert format_duration(seconds(90)) == "1m30s"

# A duration counted in minutes.
test "minutes: an hour and a half"
    assert format_duration(minutes(90)) == "1h30m0s"

# A duration counted in hours.
test "hours: two of them"
    assert hours(2) == minutes(120)

# A duration counted in days of 24 hours.
test "days: one day is 24 hours"
    assert days(1) == hours(24)

# A duration counted in weeks.
test "weeks: one week is seven days"
    assert weeks(1) == days(7)

# A count of microseconds a file gives, read where it fits, and one past what a duration holds refused.
test "microseconds_checked: a count of microseconds a file gives, read where it fits"
    assert microseconds_checked(1_500).must() == microseconds(1_500)
    assert microseconds_checked(9_223_372_036_854_775_807).is_err()

# A timeout in milliseconds a setting gives, read where it fits, and one past what a duration holds refused.
test "milliseconds_checked: a timeout in milliseconds a setting gives, read where it fits"
    assert milliseconds_checked(250).must() == milliseconds(250)
    assert milliseconds_checked(9_223_372_036_854_775_807).is_err()

# A lifetime in seconds a server sends, read where it fits, and one past what a duration holds refused.
test "seconds_checked: a lifetime in seconds a server sends, read where it fits"
    assert seconds_checked(90).must() == seconds(90)
    assert seconds_checked(9_223_372_036_854_775_807).is_err()

# An offset in minutes a date gives, read where it fits, and one past what a duration holds refused.
test "minutes_checked: an offset in minutes a date gives, read where it fits"
    assert minutes_checked(-420).must() == minutes(-420)
    assert minutes_checked(9_223_372_036_854_775_807).is_err()

# A retention in hours a flag gives, read where it fits, and one past what a duration holds refused.
test "hours_checked: a retention in hours a flag gives, read where it fits"
    assert hours_checked(36).must() == hours(36)
    assert hours_checked(9_223_372_036_854_775_807).is_err()

# A validity in days a request asks, read where it fits, and one past what a duration holds refused.
test "days_checked: a validity in days a request asks, read where it fits"
    assert days_checked(30).must() == days(30)
    assert days_checked(9_223_372_036_854_775_807).is_err()

# A period in weeks a configuration gives, read where it fits, and one past what a duration holds refused.
test "weeks_checked: a period in weeks a configuration gives, read where it fits"
    assert weeks_checked(2).must() == weeks(2)
    assert weeks_checked(9_223_372_036_854_775_807).is_err()

# The longest duration, about 292 years.
test "max_duration: the longest span written out"
    assert format_duration(max_duration()) == "2562047h47m16.854775807s"

# The most negative duration, which has no positive twin.
test "min_duration: the shortest span written out"
    assert format_duration(min_duration()) == "-2562047h47m16.854775808s"

# Two spans added.
test "sum: a second and half a second"
    assert sum(a: seconds(1), b: milliseconds(500)).must() == milliseconds(1_500)

# One span taken from another.
test "difference: a second less a quarter of one"
    assert difference(a: seconds(1), b: milliseconds(250)).must() == milliseconds(750)

# A span turned the other way.
test "negate: five seconds back"
    assert negate(seconds(5)).must() == seconds(-5)

# A span without its sign.
test "abs: five seconds back is five seconds long"
    assert abs(seconds(-5)).must() == seconds(5)

# A span taken several times.
test "scale: three waits of 100 milliseconds"
    assert scale(milliseconds(100), by: 3).must() == milliseconds(300)

# A span cut into equal parts.
test "divide: a second in four"
    assert divide(seconds(1), by: 4).must() == milliseconds(250)

# How many whole units a span holds.
test "to_units: 90 minutes hold one whole hour"
    assert to_units(minutes(90), unit: .hour) == 1

# What is left over once the whole units are out.
test "remainder: 90 minutes less the whole hour"
    assert remainder(minutes(90), unit: .hour) == minutes(30)

# A span as a fraction of a unit, for a rate or a chart.
test "to_float: 90 minutes are an hour and a half"
    assert to_float(minutes(90), unit: .hour) == 1.5

# Which of two spans is shorter.
test "is_shorter: a second is shorter than a minute"
    assert is_shorter(a: seconds(1), b: minutes(1))

# Which of two spans is longer.
test "is_longer: a minute is longer than a second"
    assert is_longer(a: minutes(1), b: seconds(1))

# A span cut to whole hours.
test "truncate_duration: 1h40m to the hour"
    assert truncate_duration(d: minutes(100), unit: hours(1)).must() == hours(1)

# A span rounded to the nearest hour.
test "round_duration: 1h40m to the nearest hour"
    assert round_duration(d: minutes(100), unit: hours(1)).must() == hours(2)

# The calendar's parts of a moment, in UTC.
test "to_date_time: half past nine on a summer day"
    t = parse("2026-07-01T09:30:00Z", layout: .rfc3339).must()
    parts = to_date_time(t)
    assert parts.year == 2026 && parts.month == 7 && parts.day == 1 && parts.hour == 9 && parts.minute == 30

# A moment from its calendar's parts, in UTC.
test "from_date_time: half past nine on a summer day"
    parts = DateTime(year: 2026, month: 7, day: 1, hour: 9, minute: 30, second: 0, nanosecond: 0)
    assert format(from_date_time(parts).must(), layout: .rfc3339) == "2026-07-01T09:30:00Z"

# Midnight of a day, the plainest way to name a date.
test "date: the fifth of March"
    assert format(date(year: 2026, month: 3, day: 5).must(), layout: .date_only) == "2026-03-05"

# The day of the week a date falls on.
test "weekday_of: 2026 began on a Thursday"
    assert weekday_of(date(year: 2026, month: 1, day: 1).must()) == .thursday

# A weekday's English name.
test "weekday_name: Monday"
    assert weekday_name(.monday) == "Monday"

# A weekday's ISO 8601 number.
test "weekday_number: Sunday is the seventh"
    assert weekday_number(.sunday) == 7

# A month's English name.
test "month_name: the third month"
    assert month_name(3).must() == "March"

# The day of its year a date falls on.
test "day_of_year: the first of February is the 32nd"
    assert day_of_year(date(year: 2026, month: 2, day: 1).must()) == 32

# The ISO 8601 week a date falls in.
test "iso_week: New Year's Day of 2026 is in week 1"
    assert iso_week(date(year: 2026, month: 1, day: 1).must()) == IsoWeek(year: 2026, week: 1)

# A day of an ISO 8601 week, which may fall in the year before.
test "from_iso_week: the Monday of 2026's first week"
    monday = from_iso_week(year: 2026, week: 1, day: .monday).must()
    assert format(monday, layout: .date_only) == "2025-12-29"

# Whether a year has a February 29.
test "is_leap_year: 2024 is, 2026 is not"
    assert is_leap_year(2024) && !is_leap_year(2026)

# How many leap years a span of years holds.
test "leap_years_between: seven from 2000 up to 2026"
    assert leap_years_between(from: 2000, to: 2026) == 7

# How many days a month has.
test "days_in_month: February of a leap year"
    assert days_in_month(year: 2024, month: 2).must() == 29

# How many days a year has.
test "days_in_year: a leap year has 366"
    assert days_in_year(2024) == 366

# A date a month on, the end of a month kept inside the next.
test "add_months: January 31 and a month is February 28"
    t = add_months(date(year: 2026, month: 1, day: 31).must(), months: 1).must()
    assert format(t, layout: .date_only) == "2026-02-28"

# A date a year on, a leap day kept inside the next year.
test "add_years: February 29 and a year is February 28"
    t = add_years(date(year: 2024, month: 2, day: 29).must(), years: 1).must()
    assert format(t, layout: .date_only) == "2025-02-28"

# A moment written in a standard's form.
test "format: a moment as RFC 3339 and as an HTTP date"
    t = parse("2026-03-05T14:30:00Z", layout: .rfc3339).must()
    assert format(t, layout: .rfc3339) == "2026-03-05T14:30:00Z"
    assert format(t, layout: .http) == "Thu, 05 Mar 2026 14:30:00 GMT"

# A moment read back from a standard's form, its offset moved to UTC.
test "parse: half past three in a zone an hour east"
    t = parse("2026-03-05T15:30:00+01:00", layout: .rfc3339).must()
    assert format(t, layout: .rfc3339) == "2026-03-05T14:30:00Z"

# A span written for a person or a log.
test "format_duration: an hour and a half"
    assert format_duration(minutes(90)) == "1h30m0s"

# A span read from a setting's text.
test "parse_duration: 1h30m"
    assert parse_duration("1h30m").must() == minutes(90)

# A zone read by its name, and the offset it keeps at an instant.
test "load_zone: Rome's offset on a summer day"
    rome = load_zone("Europe/Rome").must()
    assert offset_at(rome, date(year: 2026, month: 7, day: 1).must()).abbreviation == "CEST"

# The machine's own zone, where it has one.
test "local_zone: the zone the machine's clocks keep"
    match local_zone()
        .ok zone => assert zone.name != ""
        .err e   => assert e.code == NOT_FOUND || e.code == UNSUPPORTED

# UTC as a zone, for a function that takes one.
test "utc_zone: noon UTC is noon"
    noon = date(year: 2026, month: 1, day: 1).must()
    assert to_date_time_in(add(t: noon, d: hours(12)).must(), zone: utc_zone()).hour == 12

# A zone five hours behind UTC all year.
test "fixed_zone: five hours west of Greenwich"
    zone = fixed_zone(name: "EST", offset: hours(-5)).must()
    assert to_date_time_in(date(year: 2026, month: 1, day: 1).must(), zone: zone).hour == 19

# A zone read from the bytes of a TZif file a program already holds.
test "decode_tzif: the bytes of a zone file"
    zone = decode_tzif(name: "Europe/Rome", data: zone_files.carried("Europe/Rome").must()).must()
    assert zone.name == "Europe/Rome" && zone.changes.len() > 100

# The names a program may offer its user.
test "zone_names: Rome is among them"
    found: bool @= false

    for name in zone_names()
        if name == "Europe/Rome"
            found @ true

    assert found

# New York's offset in winter.
test "offset_at: New York in January"
    york = load_zone("America/New_York").must()
    assert offset_at(york, date(year: 2026, month: 1, day: 15).must()).from_utc == hours(-5)

# When the summer time in force began.
test "previous_change: the start of Rome's summer time of 2026"
    rome = load_zone("Europe/Rome").must()
    change = previous_change(rome, date(year: 2026, month: 7, day: 1).must()).must()
    assert format(change.at, layout: .rfc3339) == "2026-03-29T01:00:00Z"

# When the summer time in force ends.
test "next_change: the end of Rome's summer time of 2026"
    rome = load_zone("Europe/Rome").must()
    change = next_change(rome, date(year: 2026, month: 7, day: 1).must()).must()
    assert format(change.at, layout: .rfc3339) == "2026-10-25T01:00:00Z" && change.offset.abbreviation == "CET"

# Noon UTC on Rome's clocks in summer.
test "to_date_time_in: noon UTC is two in the afternoon in Rome"
    rome = load_zone("Europe/Rome").must()
    local = to_date_time_in(add(t: date(year: 2026, month: 7, day: 1).must(), d: hours(12)).must(), zone: rome)
    assert local.hour == 14

# A meeting at nine in Rome, as an instant.
test "from_date_time_in: nine in the morning in Rome"
    rome = load_zone("Europe/Rome").must()
    nine = DateTime(year: 2026, month: 7, day: 1, hour: 9, minute: 0, second: 0, nanosecond: 0)
    assert format(from_date_time_in(nine, zone: rome, choice: .compatible).must(), layout: .rfc3339) == "2026-07-01T07:00:00Z"

# Every weekday at nine in the morning.
test "parse_cron: weekdays at nine"
    schedule = parse_cron("0 9 * * MON-FRI").must()
    assert schedule.text == "0 9 * * MON-FRI"

# The next run of a daily job on Rome's clocks: nine in Rome is eight UTC in
# winter.
test "next_run: nine in the morning in Rome"
    schedule = parse_cron("0 9 * * *").must()
    after = date(year: 2026, month: 1, day: 1).must()
    next = next_run(schedule, after: after, zone: load_zone("Europe/Rome").must()).must()
    assert format(next, layout: .rfc3339) == "2026-01-01T08:00:00Z"

# The next three quarter hours.
test "next_runs: three quarter hours"
    schedule = parse_cron("*/15 * * * *").must()
    runs = next_runs(schedule, after: date(year: 2026, month: 1, day: 1).must(), zone: utc_zone(), count: 3)
    assert format(runs[2], layout: .rfc3339) == "2026-01-01T00:45:00Z"
