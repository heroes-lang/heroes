# The platform layer's proxy settings, `hero_proxy.h`, bound thin: one Heroes
# function for the one C function, answering what C answers. Rebel's floor of
# `http`'s `proxy_from_system` (`rebel/examples/README.md` § A2): no policy
# stands here, and the private module `http/internal/settings` above it turns
# the text into proxies and every kind into a code.
#
# The layer is C of the language's own beside the runtime, so this group names
# its header and no `link`: on macOS the member links SystemConfiguration
# itself, on Windows it finds WinHTTP's function in the system folder at the
# call, and everywhere else it answers `HERO_PROXY_UNSUPPORTED`, so the same
# line binds it on every platform.

extern "hero_proxy.h"
    # The kinds of result, the high 32 bits of what `settings` answers, the
    # same numbers on every platform.
    constant HERO_PROXY_OK: i64
    constant HERO_PROXY_UNSUPPORTED: i64
    constant HERO_PROXY_FAILED: i64
    constant HERO_PROXY_LIMIT: i64
    function hero_proxy_settings(@buffer: [u8] counted_by n lent, n: u64) -> i64

# The settings text and its kind, written into `buffer`, `n` long, as one
# number: its high 32 bits are the kind (`HERO_PROXY_OK` and the rest), its
# low 32 bits the count of bytes written, the settings' text for
# `HERO_PROXY_OK` and the system's own words for a failure. The text is
# lines of UTF-8 ended by a line feed, each a key, a tab and its values
# parted by tabs; `hero_proxy.h` says each system's keys. `HERO_PROXY_LIMIT`
# says the buffer was too small, the text cut at its last whole line.
#
# - `buffer`: where the text is written, from its first byte, where it fits;
#   left `n` long.
# - `n`: the bytes `buffer` holds; 0 writes nothing and answers
#   `HERO_PROXY_LIMIT` where the system has settings, and an empty text where
#   it has none.
function settings(@buffer: [u8], n: u64) -> i64
    return hero_proxy_settings(@buffer, n: n)

test "settings: no room, then room enough, answer a kind of the four and a count the buffer holds"
    none: [u8] @= []
    first = settings(@none, n: 0)
    assert first >> 32 == HERO_PROXY_OK || first >> 32 == HERO_PROXY_LIMIT || first >> 32 == HERO_PROXY_UNSUPPORTED
    assert first & 4_294_967_295 == 0
    room: [u8] @= []
    got = settings(@room, n: 65_536)
    kind = got >> 32
    assert kind == HERO_PROXY_OK || kind == HERO_PROXY_UNSUPPORTED || kind == HERO_PROXY_FAILED
    assert got & 4_294_967_295 <= 65_536

    if kind == HERO_PROXY_OK
        text = room.slice(from: 0, to: got & 4_294_967_295)
        assert text.len() == 0 || text[text.len() - 1] == 10
        lines: i64 @= 0
        tabs: i64 @= 0

        for b in text
            if b == 10
                lines @ lines + 1
            else if b == 9
                tabs @ tabs + 1

        assert tabs >= lines
