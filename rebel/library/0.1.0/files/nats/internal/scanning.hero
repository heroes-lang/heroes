# One operation the server sent, read at a time from the bytes received,
# telling where the bytes end before the operation does: `INFO`, `MSG`,
# `HMSG`, `PING`, `PONG`, `+OK` and `-ERR`. A control line is read up to
# `MOST_LINE` bytes and a message's data up to the bound its caller gives,
# so no peer makes the client hold more.

use bytes
use nats/internal/model
use strings

# The longest control line read, 1 MiB: an `INFO` naming many servers fits.
constant MOST_LINE: i64
    1048576

# One operation the server sent.
variant Op
    # `INFO` and its JSON.
    info
        # The JSON's text.
        text: str
    # `MSG` or `HMSG`: a message on a subscription.
    msg
        # The subject.
        subject: str
        # The subscription's number.
        sid: i64
        # The reply subject, "" for none.
        reply: str
        # Whether it came as `HMSG`, with a header block.
        has_headers: bool
        # The header block's bytes, [] for none.
        block: [u8]
        # The data.
        data: [u8]
    # `PING`.
    ping
    # `PONG`.
    pong
    # `+OK`.
    fine
    # `-ERR` and its words, their quotes taken away.
    err
        # The words.
        text: str

# What a scan found.
record Scanned
    # Whether an operation is whole; false where more bytes are needed.
    complete: bool
    # The operation, where it is whole.
    op: Op
    # Where the next operation begins.
    next: i64

# A scan that needs more bytes.
function incomplete() -> Scanned
    return Scanned(complete: false, op: .pong, next: 0)

# The number the bytes `word` write: digits alone, at most 18.
#
# - `word`: the bytes.
# - `what`: how a failure names it.
function count(word: [u8], what: str) -> i64?
    if word.len() == 0 || word.len() > 18
        return fail(code: model.INVALID, msg: f"the server sent no number for {what}")
    n: i64 @= 0

    for b in word
        if b < '0' || b > '9'
            return fail(code: model.INVALID, msg: f"the server sent no number for {what}")
        n @ n * 10 + to_i64(b - '0').must()

    return ok(n)

# The words of `line`, split at spaces and tabs.
#
# - `line`: the bytes.
function words(line: [u8]) -> [[u8]]
    out: [[u8]] @= []
    word: [u8] @= []

    for b in line
        if b == ' ' || b == '\t'
            if word.len() > 0
                out @ out.push(word)
                word @ []
        else
            word @ word.push(b)

    if word.len() > 0
        out @ out.push(word)
    return out

# The text of `data`, or a failure naming `what`.
#
# - `data`: the bytes.
# - `what`: how a failure names them.
function text_of(data: [u8], what: str) -> str?
    return match bytes.to_text(data)
        .ok got => ok(got)
        .err _  => fail(code: model.INVALID, msg: f"the server sent {what} that is not UTF-8")

# The next operation in `data` from `at`, or that the bytes end before it.
#
# - `data`: the bytes received.
# - `at`: where the operation begins.
# - `most`: the most bytes of a message's headers and data together.
#
# Fails `invalid` where the bytes are no operation of NATS, `limit` where a
# line passes `MOST_LINE` or a message passes `most`.
function scan(data: [u8], at: i64, most: i64) -> Scanned?
    end: i64 @= at

    while end < data.len() && data[end] != '\n'
        end @ end + 1

    if end >= data.len()
        if data.len() - at > MOST_LINE
            return fail(code: model.LIMIT, msg: f"the server sent a line past {MOST_LINE} bytes")
        return ok(incomplete())

    if end - at > MOST_LINE
        return fail(code: model.LIMIT, msg: f"the server sent a line past {MOST_LINE} bytes")

    stop = if end > at && data[end - 1] == '\r'
        end - 1
    else
        end
    line = data.slice(from: at, to: stop)
    after = end + 1
    parts = words(line)

    if parts.len() == 0
        return fail(code: model.INVALID, msg: "the server sent an empty line")
    verb = strings.to_upper_ascii(text_of(parts[0], what: "an operation")?)

    if verb == "PING" && parts.len() == 1
        return ok(Scanned(complete: true, op: .ping, next: after))

    if verb == "PONG" && parts.len() == 1
        return ok(Scanned(complete: true, op: .pong, next: after))

    if verb == "+OK" && parts.len() == 1
        return ok(Scanned(complete: true, op: .fine, next: after))

    if verb == "-ERR"
        rest = strings.trim(text_of(line.slice(from: 4, to: line.len()), what: "an error")?)
        return ok(
            Scanned(complete: true, op: .err(text: strings.trim_suffix(s: strings.trim_prefix(s: rest, prefix: "'"), suffix: "'")), next: after)
        )

    if verb == "INFO" && parts.len() >= 2
        return ok(
            Scanned(complete: true, op: .info(text: strings.trim(text_of(line.slice(from: 4, to: line.len()), what: "an INFO")?)), next: after)
        )

    if verb == "MSG" || verb == "HMSG"
        return message(data, line: parts, after: after, headed: verb == "HMSG", most: most)
    shown = text_of(line, what: "a line").default("bytes that are not UTF-8")
    return fail(code: model.INVALID, msg: f"the server sent \"{shown}\", which is no operation of NATS")

# The `MSG` or `HMSG` whose control line's words are `line`, its bytes from
# `after`.
#
# - `data`: the bytes received.
# - `line`: the control line's words.
# - `after`: where its data begins.
# - `headed`: whether it is `HMSG`.
# - `most`: the most bytes of headers and data together.
function message(data: [u8], line: [[u8]], after: i64, headed: bool, most: i64) -> Scanned?
    counts = if headed
        2
    else
        1

    if line.len() != 3 + counts && line.len() != 4 + counts
        return fail(code: model.INVALID, msg: "the server sent a message's line with too few or too many words")
    subject = text_of(line[1], what: "a subject")?
    sid = count(line[2], what: "a subscription")?

    reply = if line.len() == 4 + counts
        text_of(line[3], what: "a reply subject")?
    else
        ""
    total = count(line[line.len() - 1], what: "a message's size")?

    header_len = if headed
        count(line[line.len() - 2], what: "a message's headers' size")?
    else
        0

    if header_len > total
        return fail(code: model.INVALID, msg: f"the server sent headers of {header_len} bytes in a message of {total}")

    if total > most
        return fail(code: model.LIMIT, msg: f"the server sent a message of {total} bytes, past {most}")

    if data.len() < after + total + 2
        return ok(incomplete())

    if data[after + total] != '\r' || data[after + total + 1] != '\n'
        return fail(
            code: model.INVALID,
            msg: f"the server's message of {total} bytes on \"{subject}\" does not end where its size says"
        )
    op: Op = .msg(
        subject: subject,
        sid: sid,
        reply: reply,
        has_headers: headed,
        block: data.slice(from: after, to: after + header_len),
        data: data.slice(from: after + header_len, to: after + total)
    )
    return ok(Scanned(complete: true, op: op, next: after + total + 2))

test "scan: PING, PONG, +OK, -ERR with its quotes, INFO, in lower case, and a line cut before its end"
    data = bytes.from_text("PING\r\npong\r\n+OK\r\n-ERR 'Unknown Protocol Operation'\r\nINFO {\"a\":1}\r\nPIN")
    s1 = scan(data, at: 0, most: 100).must()
    s2 = scan(data, at: s1.next, most: 100).must()
    s3 = scan(data, at: s2.next, most: 100).must()
    s4 = scan(data, at: s3.next, most: 100).must()
    s5 = scan(data, at: s4.next, most: 100).must()
    s6 = scan(data, at: s5.next, most: 100).must()
    assert s1.op == .ping && s2.op == .pong && s3.op == .fine && s4.op == .err(text: "Unknown Protocol Operation")
    assert s5.op == .info(text: "{\"a\":1}") && !s6.complete

test "scan: MSG with and without a reply, HMSG, data holding a line's end, data cut short, and the size past the bound"
    data = bytes.from_text(
        "MSG a.b 7 5\r\nhe\r\no\r\nMSG a 1 r 0\r\n\r\nHMSG h 2 12 14\r\nNATS/1.0\r\n\r\nhi\r\nMSG x 1 9\r\nabc"
    )
    m1 = scan(data, at: 0, most: 100).must()
    assert m1.op == .msg(subject: "a.b", sid: 7, reply: "", has_headers: false, block: [], data: bytes.from_text("he\r\no"))
    m2 = scan(data, at: m1.next, most: 100).must()
    assert m2.op == .msg(subject: "a", sid: 1, reply: "r", has_headers: false, block: [], data: [])
    m3 = scan(data, at: m2.next, most: 100).must()
    assert m3.op == .msg(subject: "h", sid: 2, reply: "", has_headers: true, block: bytes.from_text("NATS/1.0\r\n\r\n"), data: bytes.from_text("hi"))
    assert !scan(data, at: m3.next, most: 100).must().complete

    match scan(bytes.from_text("MSG a 1 200\r\n"), at: 0, most: 100)
        .ok _  => assert false
        .err e => assert e.code == "limit"

test "scan: a message whose end is not where its size says, an unknown verb, a size that is no number, headers past the size, too many words"
    assert scan(bytes.from_text("MSG a 1 2\r\nabc\r\n"), at: 0, most: 100).is_err()
    assert scan(bytes.from_text("HELLO\r\n"), at: 0, most: 100).is_err()
    assert scan(bytes.from_text("MSG a 1 -2\r\n"), at: 0, most: 100).is_err()
    assert scan(bytes.from_text("HMSG a 1 5 2\r\n"), at: 0, most: 100).is_err()
    assert scan(bytes.from_text("MSG a 1 b c 2\r\n"), at: 0, most: 100).is_err()
    assert scan(bytes.from_text("\r\n"), at: 0, most: 100).is_err()

test "scan: a line with no end past the bound fails limit, and an empty buffer needs more"
    big: [u8] @= []

    for _ in range(from: 0, to: MOST_LINE + 2)
        big @ big.push('A')

    match scan(big, at: 0, most: 10)
        .ok _  => assert false
        .err e => assert e.code == "limit"

    assert !scan([], at: 0, most: 10).must().complete
