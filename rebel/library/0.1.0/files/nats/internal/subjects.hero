# NATS's subjects: which texts are subjects a message is published to,
# which a subscription takes with its wildcards, and whether one matches the
# other. A subject is tokens separated by `.`, none empty; a token holds no
# space and no control character, and any other byte, UTF-8 included.

use bytes

# Whether the byte `b` may stand in a token: no space, no control character.
#
# - `b`: the byte.
function is_token_byte(b: u8) -> bool
    return b > ' ' && b != 127

# The tokens of `s`, split at every `.`; the empty text has one empty token.
#
# - `s`: the subject.
function tokens(s: str) -> [str]
    out: [str] @= []
    start: i64 @= 0
    at: i64 @= 0

    while at < s.len()
        if s[at] == '.'
            out @ out.push(s.slice(from: start, to: at))
            start @ at + 1
        at @ at + 1

    out @ out.push(s.slice(from: start, to: s.len()))
    return out

# Whether every byte of `s` may stand in a subject or a name, `.` aside.
#
# - `s`: the text.
function is_printable(s: str) -> bool
    for b in bytes.from_text(s)
        if !is_token_byte(b)
            return false

    return true

# Whether `s` is a subject a message is published to.
#
# - `s`: the text.
function is_subject(s: str) -> bool
    if s == "" || !is_printable(s)
        return false

    for t in tokens(s)
        if t == "" || t == "*" || t == ">"
            return false

    return true

# Whether `s` is a subject a subscription takes, wildcards allowed.
#
# - `s`: the text.
function is_filter(s: str) -> bool
    if s == "" || !is_printable(s)
        return false
    parts = tokens(s)

    for at in range(from: 0, to: parts.len())
        if parts[at] == ""
            return false

        if parts[at] == ">" && at != parts.len() - 1
            return false

    return true

# Whether `s` names a queue group: not empty, no space, no control character.
#
# - `s`: the text.
function is_queue(s: str) -> bool
    return s != "" && is_printable(s)

# Whether `subject` reaches a subscription to `pattern`.
#
# - `pattern`: the subscription's subject.
# - `subject`: the published subject.
function matches(pattern: str, subject: str) -> bool
    if !is_filter(pattern) || !is_subject(subject)
        return false
    f = tokens(pattern)
    t = tokens(subject)
    at: i64 @= 0

    while at < f.len()
        if f[at] == ">"
            return at < t.len()

        if at >= t.len()
            return false

        if f[at] != "*" && f[at] != t[at]
            return false
        at @ at + 1

    return at == t.len()

test "is_subject: the empty text, one token, many, an empty token at either end and inside, a wildcard, a space and a tab"
    assert !is_subject("") && is_subject("a") && is_subject("foo.bar.baz")
    assert !is_subject(".a") && !is_subject("a.") && !is_subject("a..b")
    assert !is_subject("a.*") && !is_subject(">") && !is_subject("a b") && !is_subject("a\tb")
    assert is_subject("a*.b>") && is_subject("città.🎸")

test "is_filter: wildcards in their places, a > before the end, an empty token, control bytes"
    assert is_filter("*") && is_filter(">") && is_filter("a.*.c") && is_filter("a.>")
    assert !is_filter("a.>.c") && !is_filter("a..b") && !is_filter("") && !is_filter("a\nb")
    assert !is_filter("a.\u{7f}")

test "is_queue: a name, the empty one, a space"
    assert is_queue("workers") && !is_queue("") && !is_queue("a b")

test "matches: exact, *, > with one and with many tokens, > with none, lengths that differ, invalid sides"
    assert matches(pattern: "a.b", subject: "a.b") && !matches(pattern: "a.b", subject: "a.c")
    assert matches(pattern: "a.*", subject: "a.b") && !matches(pattern: "a.*", subject: "a.b.c")
    assert matches(pattern: "a.>", subject: "a.b") && matches(pattern: "a.>", subject: "a.b.c")
    assert !matches(pattern: "a.>", subject: "a") && matches(pattern: ">", subject: "x")
    assert !matches(pattern: "a.b", subject: "a.b.c") && !matches(pattern: "a.b.c", subject: "a.b")
    assert matches(pattern: "*.*", subject: "x.y") && !matches(pattern: "a.*", subject: "a.*")
    assert !matches(pattern: "a..b", subject: "a..b")

test "tokens: one, several, empty ones at the ends"
    assert tokens("a") == ["a"] && tokens("a.b") == ["a", "b"] && tokens(".a.") == ["", "a", ""]
    assert tokens("") == [""]
