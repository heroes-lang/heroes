# The loopback services of the demo, served together on the thread that
# owns them: the Redis stand-in, the OpenTelemetry collector and the webhook
# endpoints share one `poll.Set`, and each event goes to the service whose
# socket it is. The loop runs until a client of the Redis stand-in asks
# `SHUTDOWN`, which the demo's driver does once it has finished.

use <rebel>/poll
use <rebel>/time

use standins/collector/server as collector
use standins/redis/keyspace
use standins/redis/server as redis_standin
use standins/webhooks/receiver

# The three services and their set.
record Host
    # The set every socket of the three waits in.
    set: poll.Set
    # The Redis stand-in.
    redis: redis_standin.Standin
    # The collector.
    collector: collector.Collector
    # The webhook endpoints.
    hooks: receiver.Receiver

# The three services listening on 127.0.0.1, the Redis stand-in asking for
# `password`, its clock fixed at `start_us`.
#
# - `password`: the password clients of the Redis stand-in must give.
# - `start_us`: the stand-in's clock, microseconds since 1970.
#
# Fails as each service's `start` fails.
function start(password: str, start_us: i64) -> Host?
    s = poll.make(1_024)?
    clock: keyspace.Clock = .fixed(micros: start_us)
    return ok(
        Host(set: s, redis: redis_standin.start(s, port: 0, password: password, clock: clock)?, collector: collector.start(s)?, hooks: receiver.start(s)?)
    )

# Serves the three until the Redis stand-in is shut down, or `most` has
# passed in real time: a driver that could not reach the stand-in to shut it
# down must not leave the demo waiting for ever.
#
# - `h`: the services.
# - `most`: the longest it serves.
#
# Fails `timeout` where `most` passed first; as `poll.wait` fails,
# `stopped` where the program was asked to stop; and as a listener fails.
function serve_until_shutdown(@h: Host, most: time.Duration) -> ()?
    began = time.mark()?

    while !h.redis.stopped
        if time.is_longer(a: time.elapsed(began)?, b: most)
            return fail(code: "timeout", msg: f"the stand-ins were not shut down within {time.format_duration(most)}")

        for e in poll.wait(h.set, limit: time.seconds(1))?
            if redis_standin.owns(h.redis, key: e.key)
                redis_standin.serve(@h.redis, set: h.set, key: e.key)?
            else if collector.owns(h.collector, key: e.key)
                collector.serve(@h.collector, set: h.set, key: e.key)?
            else if receiver.owns(h.hooks, key: e.key)
                receiver.serve(@h.hooks, set: h.set, key: e.key)?

    return ok()

# Serves the Redis stand-in alone at `port` on the wall clock, until a
# client asks `SHUTDOWN` or the program is asked to stop: a Redis for trying
# the job system on a machine with none, `worker run` and the rest pointed at
# `redis://127.0.0.1:<port>/0`.
#
# - `port`: the port on 127.0.0.1.
# - `password`: the password clients must give; "" for none.
#
# Fails as the stand-in's `start` fails, `exists` where the port is taken,
# and as `poll.wait` fails, `stopped` at Ctrl-C.
function serve_redis_alone(port: i64, password: str) -> ()?
    s = poll.make(1_024)?
    alone @= redis_standin.start(s, port: port, password: password, clock: .wall)?
    print(f"a Redis stand-in listens on 127.0.0.1:{redis_standin.port_of(alone)}; SHUTDOWN ends it")
    served: ()? @= ok()

    while !alone.stopped && !served.is_err()
        match poll.wait(s, limit: time.seconds(1))
            .err e => served @ fail(code: e.code, msg: e.msg)
            .ok found =>
                for e in found
                    if redis_standin.owns(alone, key: e.key)
                        _ = redis_standin.serve(@alone, set: s, key: e.key).is_err()

    redis_standin.close(@alone, set: s)
    closing @= s
    _ = poll.close(@closing).is_err()
    return served

# Closes every service and the set.
#
# - `h`: the services, closed after.
function close(@h: Host)
    redis_standin.close(@h.redis, set: h.set)
    collector.close(@h.collector, set: h.set)
    receiver.close(@h.hooks, set: h.set)
    _ = poll.close(@h.set).is_err()
