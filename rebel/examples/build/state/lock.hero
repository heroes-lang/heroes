# The lock a build holds on its folder while it writes outputs and the log:
# two builds of one folder at once would run the same steps side by side
# and interleave their lines of the log. The lock is the system's own on
# the file `.build_lock` (`fs.try_lock`), so it ends with the process that
# held it, a build that was killed included, and the file itself is left
# where it is, since removing a lock file is a race with the next build
# that opens it.

use <rebel>/errors
use <rebel>/fs
use <rebel>/io

use load/paths
use model/buildfile

# The lock held: the stream whose lock it is.
record Held
    # The open lock file; `release` closes it.
    stream: io.Stream

# The lock of the build in `root`, taken without waiting.
#
# - `root`: the build's folder, which must be there.
#
# Fails `failed` where another build holds it, saying so, and with the
# system's code where the file cannot be opened or locked.
function take(root: str) -> Held?
    place = paths.disk(root: root, name: paths.LOCK_NAME)
    s @= fs.open_with(place, access: .append, permission: 0o644)?

    held = match fs.try_lock(s, exclusive: true)
        .ok answer => answer
        .err e =>
            errors.ignore(io.close(@s))
            return fail(code: e.code, msg: f"{paths.LOCK_NAME}: {e.msg}")

    if !held
        errors.ignore(io.close(@s))
        return fail(code: buildfile.FAILED, msg: f"another build of this folder is running: it holds {paths.LOCK_NAME}")
    return ok(Held(stream: s))

# Lets the lock go and closes its file.
#
# - `held`: the lock, whose stream is closed after.
#
# Fails where the file cannot be closed, with its code; the system lets the
# lock go with the process either way.
function release(@held: Held) -> ()?
    errors.ignore(fs.unlock(held.stream))
    return io.close(@held.stream)
