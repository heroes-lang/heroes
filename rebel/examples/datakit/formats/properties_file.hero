# Java properties files, read and written by Rebel's `java_properties`, as
# `java.util.Properties` reads and writes them: comments, separators,
# continued lines and escapes are that package's.
#
# A file is an object of its keys in the order written, a key given twice
# keeping its last value, each value typed by `model/infer` unless `--raw`.
# Written, a document is flattened: an object's members joined by `.` and a
# list's items by `[i]`, Spring Boot's spelling, so `db.hosts[0]=a`.

use <rebel>/java_properties

use model/infer
use model/model

## Reading

# The document of the properties text `text`.
#
# - `text`: the file's text, line feeds, CR LF or CR alone.
# - `raw`: whether every value stays a text.
#
# Fails as `java_properties.parse` fails: `invalid` where a `\u` escape is
# malformed or half of a surrogate pair stands alone, the message naming the
# line.
function read(text: str, raw: bool) -> model.Value?
    members: [model.Member] @= []

    for e in java_properties.parse(text)?
        members @ members.push(model.Member(name: e.key, value: infer.row([e.value], raw: raw)[0]))

    return ok(model.object_of(members))

## Writing

# `v` as a properties file: one `key=value` line for each scalar the document
# holds, its key the path to it, escaped as `java_properties.format` escapes
# it.
#
# - `v`: the document.
# - `name`: the key of a document that is a scalar, and the first part of
#   every key of one that is a list.
#
# Fails as `java_properties.format` fails, `invalid` where two paths of `v`
# are one key, which would read back as one.
function write(v: model.Value, name: str) -> str?
    entries: [java_properties.Entry] @= []

    match v
        .object o =>
            for m in o.members
                add_entries(@entries, key: m.name, v: m.value)
        .null_value | .boolean _ | .number _ | .text _ | .bytes _ | .moment _ | .list _ => add_entries(
            @entries,
            key: name,
            v: v
        )

    return java_properties.format(entries)

# Adds the entries of `v` under `key` to `entries`.
#
# - `entries`: the entries written so far, grown in place.
# - `key`: the path to `v`.
# - `v`: the value; an empty list or object writes `key=` alone.
function add_entries(@entries: [java_properties.Entry], key: str, v: model.Value)
    match v
        .object o =>
            if o.members.len() == 0
                entries @ entries.push(java_properties.Entry(key: key, value: ""))

            for m in o.members
                add_entries(@entries, key: key + "." + m.name, v: m.value)
        .list l =>
            if l.items.len() == 0
                entries @ entries.push(java_properties.Entry(key: key, value: ""))
            at: i64 @= 0

            for item in l.items
                add_entries(@entries, key: f"{key}[{at}]", v: item)
                at @ at + 1
        .null_value | .boolean _ | .number _ | .text _ | .bytes _ | .moment _ => entries @ entries.push(
            java_properties.Entry(key: key, value: model.cell_text(v))
        )

## Tests

test "read: separators, comments, continuations and escapes"
    text = "# a comment\n! another\nname = datakit\nport:8080\nbare value\ngreeting = Hello, \\\n    world\npath = C:\\\\data\nsnow = \\u2603\nkey\\ with\\ space = 1\n"
    v = read(text, raw: false).must()
    assert model.json_text(v) == "{\"name\":\"datakit\",\"port\":8080,\"bare\":\"value\",\"greeting\":\"Hello, world\",\"path\":\"C:\\\\data\",\"snow\":\"☃\",\"key with space\":1}"

test "read: an empty value, a key given twice, a lone backslash at the end"
    v = read("a=\nb=1\nb=2\nc=x\\", raw: false).must()
    assert model.json_text(v) == "{\"a\":null,\"b\":2,\"c\":\"x\"}"
    assert read("a=\\u12", raw: false).is_err()
    assert read("a=\\ud83d", raw: false).is_err()
    assert model.json_text(read("a=\\ud83d\\ude00!", raw: false).must()) == "{\"a\":\"😀!\"}"

test "write: paths joined by dots and indices, escapes written"
    inner: model.Value = .object(
        members: [model.Member(name: "hosts", value: .list(items: [.text(v: "a"), .text(v: " b")]))]
    )
    v: model.Value = .object(
        members: [model.Member(name: "db", value: inner), model.Member(name: "a key", value: .text(v: "x\ty"))]
    )
    assert write(v, name: "p").must() == "db.hosts[0]=a\ndb.hosts[1]=\\ b\na\\ key=x\\ty\n"

test "write and read: a flat object comes back as itself"
    v: model.Value = .object(
        members: [model.Member(name: "k=1", value: .text(v: " lead")), model.Member(name: "n", value: .number(text: "2"))]
    )
    assert model.json_text(read(write(v, name: "p").must(), raw: false).must()) == model.json_text(v)

test "write: two paths that are one key refused, since they would read back as one"
    v: model.Value = .object(
        members: [model.Member(name: "a.b", value: .text(v: "1")), model.Member(name: "a", value: .object(members: [model.Member(name: "b", value: .text(v: "2"))]))]
    )
    assert write(v, name: "p").is_err()
