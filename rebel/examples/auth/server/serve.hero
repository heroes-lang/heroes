# The serving loop: one connection accepted at a time, each request on it
# read by `http.next_request` within `http.default_limits`, answered by
# `routes.answer` with the state lent, and written by `http.write_answer`,
# until the program is asked to stop (Ctrl-C, SIGTERM, or `os.ask_stop`),
# which ends the waiting accept with `stopped`.
#
# Between connections the loop keeps the directory import's schedule: the
# accept waits no longer than until the next run, and a run that falls due
# is made before the next connection is taken. A served instance logs one
# line a request to its standard output; the demonstration logs nothing, so
# its transcript holds only what its own client prints.

use <rebel>/http
use <rebel>/io
use <rebel>/net
use <rebel>/time
use <rebel>/web

use api/service_api
use core/clock
use directory/directory_import
use server/routes
use server/state

# How long one connection may last, every read and write of it, in
# milliseconds: a client that goes quiet holds the server no longer.
constant CONNECTION_MS: i64
    10_000

# The longest an accept waits before the loop looks at the schedule again,
# in milliseconds.
constant TICK_MS: i64
    60_000

# How the loop runs.
record Mode
    # Whether it keeps the directory import's schedule.
    scheduled: bool
    # Whether it logs a line a request.
    logged: bool

# Serves `l` with `st` until the program is asked to stop.
#
# - `st`: the server, lent to every request.
# - `l`: the listener; the caller closes it.
# - `mode`: whether the loop keeps the schedule and logs.
#
# Fails as `net.accept` fails for any reason but the stop and a deadline,
# and where the routes cannot be made.
function serve(@st: state.State, l: net.Listener, mode: Mode) -> ()?
    rt = routes.router()?
    due: i64 @= next_import(st, mode: mode)

    while true
        if due > 0
            wait = (due - state.now(st)) * 1_000

            ms = if wait < 1
                1
            else if wait > TICK_MS
                TICK_MS
            else
                wait
            net.set_accept_deadline(l, deadline_ms: ms)?

        match net.accept(l, deadline_ms: CONNECTION_MS)
            .ok conn => connection(@st, rt: rt, conn: conn, mode: mode)
            .err e =>
                if e.code == net.STOPPED
                    return ok()

                if e.code != net.TIMEOUT
                    return fail(code: e.code, msg: e.msg)

        if due > 0 && state.now(st) >= due
            scheduled_import(@st, mode: mode)
            due @ next_import(st, mode: mode)

# Every request of `conn`, answered, then the connection closed.
#
# - `st`: the server.
# - `rt`: the routes.
# - `conn`: the connection, closed at the end.
# - `mode`: whether to log.
function connection(@st: state.State, rt: web.Router, conn: net.Conn, mode: Mode)
    reader @= io.reader(conn.stream)

    while true
        r = match http.next_request(@reader, limits: http.default_limits())
            .ok got => got
            .err _  => break

        response = routes.answer(@st, rt: rt, r: r)

        if mode.logged
            stamp = time.format(clock.now(st.clock), layout: .rfc3339_seconds)
            print(f"{stamp} {r.method} {r.url.path} {response.status}")

        match http.write_answer(reader.stream, r: r, response: response)
            .ok _  => _ = 0
            .err _ => break

        if r.closing || response.closing
            break

    match io.close(@reader.stream)
        .ok _  => _ = 0
        .err _ => _ = 0

# When the next scheduled import falls due, seconds since 1970; 0 where the
# loop keeps no schedule or no directory is configured.
#
# - `st`: the server.
# - `mode`: whether the loop keeps the schedule.
function next_import(st: state.State, mode: Mode) -> i64
    if !mode.scheduled || st.settings.ldap.host == ""
        return 0

    match directory_import.next_run(st.settings.ldap, at: clock.now(st.clock))
        .ok t  => return time.unix_seconds(t)
        .err _ => return 0

# The import the schedule asked for, its outcome logged.
#
# - `st`: the server, whose accounts the import changes.
# - `mode`: whether to log.
function scheduled_import(@st: state.State, mode: Mode)
    match service_api.run_import(@st)
        .ok s =>
            if mode.logged
                print(
                    f"nightly import: {s.read} read, {s.created.len()} created, {s.updated.len()} updated, {s.disabled.len()} disabled, {s.skipped.len()} skipped"
                )
        .err e =>
            if mode.logged
                print(f"nightly import failed: {e.code}: {e.msg}")
