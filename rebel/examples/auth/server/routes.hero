# The server's routes, each bound to the endpoint that answers it, and the
# steps around them: `web` finds the route by method and path, and
# `web/chain` runs the steps and the endpoint bound to its name with the
# server's state lent by `@`. Every route closes its connection and counts
# its answer (`close`), which also answers an endpoint that fails
# unexpectedly, the data file unwritable for one, 500 with its message,
# never a crash; a served instance logs a line a request before it (`log`);
# and the routes that need a session read it first (`signed_in`), refused
# 401 without one before their endpoint runs. A path no route takes is
# answered 404 and a method no route of the path takes 405 with its `Allow`,
# both by `web.not_routed`, through the same steps.

use <rebel>/http
use <rebel>/time
use <rebel>/web
use <rebel>/web/chain

use api/accounts_api
use api/factors_api
use api/oauth_api
use api/service_api
use core/clock
use server/answers
use server/state

# The routes whose endpoints need a session.
constant SIGNED_IN_ROUTES: [str]
    ["totp_enrol", "totp_confirm", "passkey_register_options", "passkey_register"]

# Binds the routes in `st`, each to its endpoint, with the steps every
# route runs: `log` first where `logged`, then `close`; and `signed_in`
# before the endpoints that need a session.
#
# - `st`: the server, whose router and tables are made here.
# - `logged`: whether a line is printed for each request.
#
# Fails `exists` where two routes clash, which these never do.
function bind(@st: state.State, logged: bool) -> ()?
    rt @= web.new_router()

    if logged
        chain.add_step(@rt, @st.steps, name: "log", step: log)?
    chain.add_step(@rt, @st.steps, name: "close", step: close)?
    get = http.METHOD_GET
    post = http.METHOD_POST
    chain.on(@rt, @st.answers, method: get, pattern: "/.well-known/openid-configuration", name: "metadata", answer: oauth_api.metadata)?
    chain.on(@rt, @st.answers, method: get, pattern: "/.well-known/oauth-authorization-server", name: "metadata_rfc8414", answer: oauth_api.metadata)?
    chain.on(@rt, @st.answers, method: get, pattern: "/jwks", name: "jwks", answer: oauth_api.jwks)?
    chain.on(@rt, @st.answers, method: post, pattern: "/accounts", name: "register", answer: accounts_api.register)?
    chain.on(@rt, @st.answers, method: get, pattern: "/verify", name: "verify", answer: accounts_api.verify)?
    chain.on(@rt, @st.answers, method: get, pattern: "/login", name: "login_page", answer: accounts_api.login_page)?
    chain.on(@rt, @st.answers, method: post, pattern: "/login", name: "login", answer: accounts_api.login)?
    chain.on(@rt, @st.answers, method: post, pattern: "/logout", name: "logout", answer: accounts_api.logout)?
    chain.on(@rt, @st.answers, method: post, pattern: "/totp/enrol", name: "totp_enrol", answer: factors_api.totp_enrol)?
    chain.on(@rt, @st.answers, method: post, pattern: "/totp/confirm", name: "totp_confirm", answer: factors_api.totp_confirm)?
    chain.on(@rt, @st.answers, method: post, pattern: "/passkeys/register/options", name: "passkey_register_options", answer: factors_api.register_options)?
    chain.on(@rt, @st.answers, method: post, pattern: "/passkeys/register", name: "passkey_register", answer: factors_api.register)?
    chain.on(@rt, @st.answers, method: post, pattern: "/passkeys/login/options", name: "passkey_login_options", answer: factors_api.login_options)?
    chain.on(@rt, @st.answers, method: post, pattern: "/passkeys/login", name: "passkey_login", answer: factors_api.login)?
    chain.on(@rt, @st.answers, method: get, pattern: "/authorize", name: "authorize", answer: oauth_api.authorize)?
    chain.on(@rt, @st.answers, method: post, pattern: "/token", name: "token", answer: oauth_api.token)?
    chain.on(@rt, @st.answers, method: get, pattern: "/userinfo", name: "userinfo", answer: oauth_api.userinfo)?
    chain.on(@rt, @st.answers, method: post, pattern: "/revoke", name: "revoke", answer: oauth_api.revoke)?
    chain.on(@rt, @st.answers, method: post, pattern: "/introspect", name: "introspect", answer: oauth_api.introspect)?
    chain.on(@rt, @st.answers, method: post, pattern: "/service/token", name: "service_token", answer: service_api.service_token)?
    chain.on(@rt, @st.answers, method: post, pattern: "/admin/import", name: "import", answer: service_api.import_now)?
    chain.on(@rt, @st.answers, method: get, pattern: "/admin/users", name: "users", answer: service_api.list_users)?

    for route in SIGNED_IN_ROUTES
        chain.add_route_step(@rt, @st.steps, route: route, name: "signed_in", step: signed_in)?

    st.router @ rt
    return ok()

# The answer to `r`: its route's steps and endpoint run with the server's
# state.
#
# - `st`: the server, lent to the steps and the endpoint.
# - `r`: the request.
function answer(@st: state.State, r: http.Request) -> http.Response
    return match chain.dispatch(@st, router: st.router, steps: st.steps, answers: st.answers, r: r)
        .ok response => response
        .err e       => closed(answers.oauth_error(500, error: "server_error", description: f"{e.code}: {e.msg}"))

# The rest of `n`'s chain: the server's one line that goes on.
#
# - `st`: the server.
# - `n`: where the request stands.
# - `r`: the request.
function go_on(@st: state.State, n: chain.Next, r: http.Request) -> http.Response?
    return chain.proceed(@st, steps: st.steps, answers: st.answers, n: n, r: r)

# Every route's step: the answer counted and closing its connection, since
# the server serves one request at a time and a client that kept a
# connection open would hold every other client waiting; an endpoint that
# fails answered 500 with its message.
#
# - `st`: the server, whose count of answers grows.
# - `n`: where the request stands.
# - `r`: the request.
function close(@st: state.State, n: chain.Next, r: http.Request) -> http.Response?
    st.answered @ st.answered + 1

    return match go_on(@st, n, r)
        .ok response => ok(closed(response))
        .err e       => ok(closed(answers.oauth_error(500, error: "server_error", description: f"{e.code}: {e.msg}")))

# `response`, closing its connection.
#
# - `response`: the answer.
function closed(response: http.Response) -> http.Response
    out @= response
    out.closing @ true
    return out

# A served instance's step every route runs: a line for each request, its
# time by the server's clock, its method, its path and the status answered.
#
# - `st`: the server, its clock read.
# - `n`: where the request stands.
# - `r`: the request.
function log(@st: state.State, n: chain.Next, r: http.Request) -> http.Response?
    response = go_on(@st, n, r)?
    stamp = time.format(clock.now(st.clock), layout: .rfc3339_seconds)
    print(f"{stamp} {r.method} {r.url.path} {response.status}")
    return ok(response)

# The step of the routes that need a session: the person the request's
# session names read into the state for their endpoint, or 401
# `login_required` before it runs; the state's visitor emptied after.
#
# - `st`: the server, whose `visitor` holds the person while the endpoint
#   runs.
# - `n`: where the request stands.
# - `r`: the request.
function signed_in(@st: state.State, n: chain.Next, r: http.Request) -> http.Response?
    match accounts_api.current(st, r: r)
        .err _ => return ok(accounts_api.login_required())
        .ok v =>
            st.visitor @ ok(v)
            got = go_on(@st, n, r)
            st.visitor @ fail(code: "not_found", msg: "no request is being answered")
            return got
