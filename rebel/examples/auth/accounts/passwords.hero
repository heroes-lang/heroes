# Passwords: how one is judged acceptable, hashed and checked. A password is
# prepared by SASLprep first (`scram.prepared_password`), so that `Ä` typed
# as one code point or as `A` and a combining diaeresis is the same password,
# the rule every login of Rebel follows; then hashed by Argon2id (RFC 9106)
# with a salt of 16 drawn bytes, and kept as the PHC string, which carries
# its own costs so that raising them later leaves older hashes checkable.

use <rebel>/bytes
use <rebel>/crypto
use <rebel>/random
use <rebel>/scram

use core/ids
use core/settings

# The code of a password refused as too weak, or of a check that cannot run.
constant INVALID: str
    "invalid"

# The fewest characters a password holds: NIST SP 800-63B § 3.1.1.2's
# minimum for a password a person chooses.
constant MIN_CHARACTERS: i64
    8

# The most bytes a password holds before preparation, so that a request
# cannot make one hash cost what a long text costs.
constant MAX_BYTES: i64
    256

# Why `password` may not be chosen, or nothing where it may.
#
# - `password`: the password asked for.
# - `username`: the account's name, which the password may not hold.
#
# Fails `invalid` where it is shorter than `MIN_CHARACTERS` characters,
# longer than `MAX_BYTES` bytes, or holds the user name.
function check_choice(password: str, username: str) -> ()?
    if password.len() > MAX_BYTES
        return fail(code: INVALID, msg: f"a password holds at most {MAX_BYTES} bytes")

    if password.chars().len() < MIN_CHARACTERS
        return fail(code: INVALID, msg: f"a password holds at least {MIN_CHARACTERS} characters")

    if username.len() > 0 && contains_folded(s: password, part: username)
        return fail(code: INVALID, msg: "a password may not hold the user name")

    return ok()

# The PHC string of `password`'s Argon2id hash at `cost`, its salt drawn from
# `g`.
#
# - `g`: the generator the 16 bytes of salt are drawn from.
# - `password`: the password, prepared here by SASLprep.
# - `cost`: the memory, passes and lanes the hash costs.
#
# Fails as `crypto.hash_argon2` fails, where `cost` is outside what Argon2
# takes.
function hash(@g: random.ChaCha8, password: str, cost: settings.PasswordCost) -> str?
    salt = ids.draw(@g, count: 16)
    params = crypto.Argon2Params(
        argon2: .argon2id,
        passes: cost.passes,
        memory: cost.memory_kib,
        lanes: cost.lanes,
        length: 32
    )
    return crypto.hash_argon2(params, password: scram.prepared_password(password), salt: salt)

# Whether `password` is the one `phc` was made from, compared in constant time.
# An empty `phc`, an account with no password here, matches nothing.
#
# - `password`: the password a person typed.
# - `phc`: the account's PHC string.
function matches(password: str, phc: str) -> bool
    if phc == "" || password.len() > MAX_BYTES
        return false

    return crypto.verify_argon2(scram.prepared_password(password), hash: phc).default(false)

# The SHA-256 of `secret`'s UTF-8 in lower-case hexadecimal: how a client's
# secret and a pending e-mail token are kept. Both are drawn with 256 bits, so
# a fast digest loses nothing a slow one would protect.
#
# - `secret`: the secret as text.
function digest_hex(secret: str) -> str
    return bytes.format_hex(crypto.sha256_text(secret))

# Whether `secret` is the one whose `digest_hex` is `expected`, compared in
# constant time.
#
# - `secret`: the secret presented.
# - `expected`: the hexadecimal digest kept.
function digest_matches(secret: str, expected: str) -> bool
    return crypto.equals_constant_time(a: bytes.from_text(digest_hex(secret)), b: bytes.from_text(expected))

# Whether `s`, with ASCII case ignored, holds `part`.
#
# - `s`: the text searched.
# - `part`: the text looked for; the empty one is held by every text.
function contains_folded(s: str, part: str) -> bool
    a = bytes.from_text(s)
    b = bytes.from_text(part)
    last = a.len() - b.len()
    at: i64 @= 0

    while at <= last
        if bytes.equals_ignoring_case_ascii(a: a.slice(from: at, to: at + b.len()), b: b)
            return true
        at @ at + 1

    return false

test "check_choice: length in characters, and the user name refused"
    assert !check_choice(password: "correct horse", username: "ana").is_err()
    assert check_choice(password: "short", username: "ana").is_err()
    assert check_choice(password: "xxANA-secret", username: "ana").is_err()
    assert !check_choice(password: "òòòòòòòò", username: "ana").is_err()

test "hash: the same password matches, another does not"
    g @= ids.seeded_generator("passwords")
    cost = settings.PasswordCost(memory_kib: 64, passes: 1, lanes: 1)
    phc = hash(@g, password: "correct horse", cost: cost).must()
    assert matches(password: "correct horse", phc: phc)
    assert !matches(password: "correct horsE", phc: phc)
    assert !matches(password: "anything", phc: "")

test "digest_matches: a secret against its digest"
    d = digest_hex("s3cret")
    assert d.len() == 64 && digest_matches(secret: "s3cret", expected: d) && !digest_matches(secret: "s3cre", expected: d)
