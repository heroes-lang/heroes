# The twin of `examples/wordbands/`: words counted in text each thread writes
# for itself, written with Rebel. It prints byte for byte what
# `examples/wordbands/` prints, so that program's `main.expected` is this
# one's test too.
#
#     heroes run rebel/examples/wordbands/main.hero
#
# What Rebel does here that `examples/wordbands/` writes for itself:
#
# - `threads.run_all` starts one thread a band, at most `BANDS` at once, waits
#   for every one and answers their counts in order, in place of that
#   program's own `extern "hero_os.h"` group (`hero_thread_spawn`,
#   `hero_thread_join`) and the list of handles it joins by hand;
# - `strings.words` cuts a band's text into its words, in place of its
#   `strings.hero` (`fields`, `space_at`);
# - `maps.counts` counts each word, in place of its loop over a map;
# - `math.sum_i64` adds the bands' counts, failing `does_not_fit` where the sum
#   leaves an `i64` rather than aborting.
#
# What stays this program's own is the work each thread does: it builds the
# text it reads from the one `i64` it is given, so nothing is shared, and only
# a number crosses back.

use <rebel>/maps
use <rebel>/math
use <rebel>/strings
use <rebel>/threads

# How many bands, one thread each.
constant BANDS: i64
    8

# How many words a band's text holds.
constant LINES: i64
    300

# The text a band works on, written from its index. Nothing is read from disk,
# so the answer is the same on every machine.
#
# - `index`: the band, from 0.
function text_of(index: i64) -> str
    pieces: [str] @= []

    for n in range(from: 0, to: LINES)
        word = match (index * LINES + n) % 5
            0 => "alpha"
            1 => "beta"
            2 => "gamma"
            3 => "delta"
            _ => "epsilon"

        pieces @ pieces.push(word)

    return join(pieces, " ")

# How many times the longest word appears in this band's text: a split, a
# count and a lookup, all on the thread that runs it.
#
# - `index`: the band, from 0.
function longest_word_count(index: i64) -> i64
    counts = maps.counts(strings.words(text_of(index: index)))
    best: str @= ""
    seen: i64 @= 0

    for key in sort(keys(counts))
        if key.len() > best.len()
            best @ key
            seen @ counts[key].default(0)

    return seen

# The bands' counts added, each counted on a thread of its own.
#
# Fails `limit` where the system refuses a thread, and `does_not_fit` where
# the sum leaves an `i64`.
function together() -> i64?
    return math.sum_i64(threads.run_all(body: longest_word_count, values: range(from: 0, to: BANDS), workers: BANDS)?)

# The same sum counted on this thread alone, the second opinion `together`
# is checked against.
function alone() -> i64
    total: i64 @= 0

    for i in range(from: 0, to: BANDS)
        total @ total + longest_word_count(index: i)

    return total

function main()
    match together()
        .ok total => print("epsilons across ", BANDS, " bands: ", total)
        .err e    => print("the bands could not be counted: ", e.msg)

test "the threads count what one thread counts"
    assert together().must() == alone()

test "the longest of the five words is the one being counted"
    assert longest_word_count(index: 0) == 60

test "splitting gives back what was joined"
    assert strings.words("one two three") == ["one", "two", "three"]

test "and it is not confused by the spaces at the edges"
    assert strings.words("  a  b  ") == ["a", "b"]
