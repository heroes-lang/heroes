# The demo's hands: what a person does to the window, given through `ui`'s
# `inject` on the headless side, so each click, choice, word typed, menu
# item, header clicked, row opened and folder unfolded reaches the explorer
# as the same events a person's would, through `events.handle`. An input on
# a widget greyed out gives no event, as a person's click on one does
# nothing; an input the system answers with two events, a row opened that
# was not chosen or a fold over the item chosen, has both handled before the
# next input, as a person's next click comes after both.
#
# The headless clock moves only when a step waits, so an operation runs one
# tick at a time when `run_job` waits a tick; and the watch is waited on
# with the system's own clock by `await_disk`, since another program's
# change reaches the explorer when the system tells it, not on a tick.

use <rebel>/time
use <rebel>/ui

use app/controller
use app/events
use model/explorer
use model/listing
use views/folders

# The most ticks an operation of the demo may take before the demo stops,
# far more than any of them needs.
constant MOST_TICKS: i64
    10000

# The longest the demo waits for the watch to tell of a change, in tenths
# of a second.
constant WATCH_TENTHS: i64
    150

# Gives `input` and handles every event it causes, waiting for none: the
# headless clock does not move, so no tick of the timer comes between.
#
# - `c`: the controller.
# - `input`: what the person does.
#
# Fails as `ui.inject` fails.
function give(@c: controller.Controller, input: ui.Input) -> ()?
    ui.inject(@c.app, input: input)?
    waiting @= true

    while waiting
        match ui.wait(@c.app, within: time.nanoseconds(0))
            .ok e  => events.handle(@c, e: e)
            .err _ => waiting @ false

    return ok()

# Presses the button `widget`.
#
# - `c`: the controller.
# - `widget`: the button.
#
# Fails as `give` fails.
function click(@c: controller.Controller, widget: ui.Widget) -> ()?
    return give(@c, input: .click(widget: widget))

# Chooses the rows `indices` of the list `widget`.
#
# - `c`: the controller.
# - `widget`: the list or the combo box.
# - `indices`: the rows, ascending.
#
# Fails as `give` fails.
function choose(@c: controller.Controller, widget: ui.Widget, indices: [i64]) -> ()?
    return give(@c, input: .choose(widget: widget, indices: indices))

# Types `text` into the field `widget`, in place of what it held.
#
# - `c`: the controller.
# - `widget`: the field.
# - `text`: the whole text after the typing.
#
# Fails as `give` fails.
function type_into(@c: controller.Controller, widget: ui.Widget, text: str) -> ()?
    return give(@c, input: .type_text(widget: widget, text: text))

# Chooses the menu item `item`.
#
# - `c`: the controller.
# - `item`: the menu item.
#
# Fails as `give` fails.
function menu(@c: controller.Controller, item: ui.Widget) -> ()?
    return give(@c, input: .choose_menu(item: item))

# Presses the button `answer` of the message box shown, as the person
# would once it asks.
#
# - `c`: the controller.
# - `answer`: the button.
#
# Fails as `give` fails.
function press_answer(@c: controller.Controller, answer: ui.Answer) -> ()?
    return give(@c, input: .answer(answer: answer))

# Chooses the entries named `names` in the list of the folder shown.
#
# - `c`: the controller.
# - `names`: the names.
#
# Fails `not_found` where the folder holds one of them not, and as `give`
# fails.
function choose_named(@c: controller.Controller, names: [str]) -> ()?
    rows = listing.rows_of(c.ex.listing, names: names)

    if rows.len() != names.len()
        return fail(code: "not_found", msg: f"the folder shown holds not every one of {names.join(", ")}")

    return choose(@c, widget: c.w.entries, indices: rows)

# Chooses the tree's item of `folder`.
#
# - `c`: the controller.
# - `folder`: the folder's path.
#
# Fails `not_found` where the tree shows no item of it, and as `give` fails.
function choose_folder(@c: controller.Controller, folder: str) -> ()?
    item = folders.item_of(c.folders, folder: folder)?
    return choose(@c, widget: c.w.tree, indices: [item])

# Unfolds or folds the tree's item of `folder` by its triangle.
#
# - `c`: the controller.
# - `folder`: the folder's path.
# - `open`: true to unfold it, false to fold it.
#
# Fails `not_found` where the tree shows no item of it, and as `give` fails.
function unfold_folder(@c: controller.Controller, folder: str, open: bool) -> ()?
    item = folders.item_of(c.folders, folder: folder)?
    return give(@c, input: .unfold(widget: c.w.tree, item: item, open: open))

# Clicks the header of the entries' column `column`, asking the order
# `ascending` says, as the arrow the click leaves shows it.
#
# - `c`: the controller.
# - `column`: the column's place, from 0.
# - `ascending`: whether the arrow points up.
#
# Fails as `give` fails.
function click_header(@c: controller.Controller, column: i64, ascending: bool) -> ()?
    return give(@c, input: .sort(widget: c.w.entries, column: column, ascending: ascending))

# Opens the entry named `name` in the list of the folder shown, by a double
# click on its row.
#
# - `c`: the controller.
# - `name`: the name.
#
# Fails `not_found` where the folder holds no entry `name`, and as `give`
# fails.
function open_named(@c: controller.Controller, name: str) -> ()?
    row = listing.row_of(c.ex.listing, name: name)?
    return give(@c, input: .activate(widget: c.w.entries, index: row))

# Lets the window's timer tick `n` times, each tick moving the operation
# running by a step.
#
# - `c`: the controller.
# - `n`: the ticks.
function tick(@c: controller.Controller, n: i64)
    period = time.milliseconds(controller.TICK_MS)

    for _ in range(from: 0, to: n)
        _ = events.step(@c, within: period)

# Lets the timer tick until the operation running ends, and answers how many
# ticks it took.
#
# - `c`: the controller.
#
# Fails `limit` past `MOST_TICKS`.
function run_job(@c: controller.Controller) -> i64?
    ticks @= 0
    period = time.milliseconds(controller.TICK_MS)

    while explorer.is_busy(c.ex)
        if ticks >= MOST_TICKS
            return fail(code: "limit", msg: f"the operation ran past {MOST_TICKS} ticks")

        _ = events.step(@c, within: period)
        ticks @ ticks + 1

    return ok(ticks)

# Waits on the watch until the folder shown holds `name`, or no longer
# holds it where `present` is false, as another program's change is told.
#
# - `c`: the controller; the window is drawn again once it is told.
# - `name`: the entry's name.
# - `present`: whether the entry is to come or to go.
#
# Fails `timeout` where the watch told nothing of it in
# `WATCH_TENTHS` tenths of a second.
function await_disk(@c: controller.Controller, name: str, present: bool) -> ()?
    tenth = time.milliseconds(100)

    for _ in range(from: 0, to: WATCH_TENTHS)
        _ = controller.poll_disk(@c, limit: tenth)

        if listing.has(c.ex.listing, name: name) == present
            controller.redraw(@c)
            return ok()

    return fail(code: "timeout", msg: f"the watch told nothing of \"{name}\" in {WATCH_TENTHS / 10} seconds")
