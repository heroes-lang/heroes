# The rows the window's lists and its table show. An entry is a row of the
# entries' table (`ui.table`), a cell a column: its name, a folder's ending
# in `/` and a link's in `@` as `ls -F` marks them, its size, its type and
# when it was last written, the numbers and dates in the person's locale.
# The table shows the order of the entries by the arrow of its column, and a
# click on a header asks them ordered by that column, which `order_at`
# reads; the table lays its columns out itself, in every font.

use <rebel>/fs
use <rebel>/time
use <rebel>/ui

use locale/formats
use model/entry
use model/sorting
use store/bookmarks

# The table's columns, in the order they stand.
function columns() -> [sorting.Column]
    every: [sorting.Column] = [.name, .size, .type, .modified]
    return every

# The place of column `c` in the table, from 0, as `columns` orders them.
#
# - `c`: the column.
function column_index(c: sorting.Column) -> i64
    return match c
        .name     => 0
        .size     => 1
        .type     => 2
        .modified => 3

# The headers' titles, in the order the columns stand.
function titles() -> [str]
    out: [str] @= []

    for c in columns()
        out @ out.push(title_of(c))

    return out

# A column's title.
#
# - `c`: the column.
function title_of(c: sorting.Column) -> str
    return match c
        .name     => "Name"
        .size     => "Size"
        .type     => "Type"
        .modified => "Modified"

# The cells of `e`'s row, one a column.
#
# - `f`: the formats.
# - `e`: the entry.
function entry_cells(f: formats.Formats, e: entry.Entry) -> [str]
    marked = match e.kind
        .directory     => e.name + "/"
        .link          => e.name + "@"
        .file | .other => e.name

    size = if e.opens
        "--"
    else
        formats.size_text(f, size: e.size)

    return [marked, size, e.type_name, formats.date_text(f, t: e.modified)]

# How the table shows `order`: the arrow on its column, up where it is
# ascending.
#
# - `order`: the order.
function sort_of(order: sorting.Order) -> ui.Sort
    return .by(column: column_index(order.column), ascending: !order.descending)

# The order a click on the header of column `column` asks for.
#
# - `column`: the column's place, from 0.
# - `ascending`: whether the arrow the click left points up.
#
# Fails `invalid` where `column` is none of the table's.
function order_at(column: i64, ascending: bool) -> sorting.Order?
    every = columns()

    if column < 0 || column >= every.len()
        return fail(code: "invalid", msg: f"no column {column}: the table has {every.len()}")

    return ok(sorting.Order(column: every[column], descending: !ascending))

# A bookmark's row: its name, and `(missing)` where its folder is not there.
#
# - `b`: the bookmark.
function bookmark_row(b: bookmarks.Bookmark) -> str
    if fs.is_dir(b.folder).default(false)
        return b.name

    return b.name + " (missing)"

test "columns: each at its own place, titled in order"
    every = columns()

    for i in range(from: 0, to: every.len())
        assert column_index(every[i]) == i

    assert titles() == ["Name", "Size", "Type", "Modified"]

test "sort_of and order_at: an order shown and read back from the click, a column past them refused"
    for c in columns()
        for descending in [false, true]
            order = sorting.Order(column: c, descending: descending)

            read = match sort_of(order)
                .by b     => order_at(column: b.column, ascending: b.ascending).must()
                .unsorted => sorting.by_name()

            assert read == order && sort_of(order) != .unsorted

    assert order_at(column: 4, ascending: true).is_err() && order_at(column: -1, ascending: true).is_err()

test "entry_cells: a folder marked, its size a dash, the date in German"
    f = formats.german()
    e = entry.Entry(name: "docs", kind: .directory, size: 0, modified: time.epoch(), type_name: "Folder", opens: true)
    assert entry_cells(f, e: e) == ["docs/", "--", "Folder", "01.01.1970, 01:00"]
