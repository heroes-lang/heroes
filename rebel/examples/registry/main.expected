what changed in textkit from 1.0.0 to 1.1.0:
    manifest: replace /package/version "1.1.0"
    manifest: add /package/keywords/2 "padding"
    changed: heroes.toml
        --- a/heroes.toml
        +++ b/heroes.toml
        @@ -1,6 +1,6 @@
         [package]
         name = "textkit"
        -version = "1.0.0"
        +version = "1.1.0"
         description = "Text helpers: wrapping lines to a width, padding and slugs."
         license = "Apache-2.0"
        -keywords = ["text", "wrap"]
        +keywords = ["text", "wrap", "padding"]
    added: src/pad.hero
        --- a/src/pad.hero
        +++ b/src/pad.hero
        @@ -0,0 +1,5 @@
        +# Pads a text on the left to a width.
        +function pad_left(s: str, width: i64) -> str
        +    if s.len() >= width
        +        return s
        +    return repeat(" ", to_u64(width - s.len()).must()) + s
    changed: src/wrap.hero
        --- a/src/wrap.hero
        +++ b/src/wrap.hero
        @@ -2,5 +2,5 @@

         # Wraps `s` to lines of at most `width` characters.
         function wrap(s: str, width: i64) -> [str]
        -    words = strings.split(s: s, sep: " ")
        +    words = strings.words(s)
             return filled(words, width: width)

