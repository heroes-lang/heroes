# The reviews service, the demo's GraphQL upstream: one schema, `Query {
# reviews(sku) }`, executed by `graphql` with the service resolving each
# field from the reviews it holds, served as GraphQL over HTTP (`POST
# /graphql` with a JSON body) on HTTP/1.1 in plain text. It runs on a
# thread of its own, tells its port on a mailbox its supervisor waits on,
# and serves one connection after another until the program is asked to
# stop.

use <rebel>/errors
use <rebel>/graphql
use <rebel>/http
use <rebel>/io
use <rebel>/json
use <rebel>/net

use demo/notify

## The service

# The name it notifies its supervisor with.
constant NAME: str
    "reviews"

# The service's schema, in the GraphQL SDL.
constant SCHEMA: str
    "type Query {\n" + "  reviews(sku: String!): [Review!]!\n" + "}\n" + "type Review {\n" + "  author: String!\n" + "  stars: Int!\n" + "  text: String!\n" + "}\n"

# The reviews the service holds, by item, as its resolver reads them.
function held() -> json.Value
    return .object(
        members: {"A-100": .list(items: [review(author: "ada", stars: 5, text: "Bright and steady."), review(author: "grace", stars: 4, text: "Good arm, short cable.")]), "B-200": .list(items: [review(author: "alan", stars: 3, text: "Thin pages.")])}
    )

# One review.
#
# - `author`: who wrote it.
# - `stars`: 1 to 5.
# - `text`: what it says.
function review(author: str, stars: i64, text: str) -> json.Value
    return .object(members: {"author": .text(v: author), "stars": .number(v: to_f64(stars)), "text": .text(v: text)})

# A field's value: a root `reviews` the item's list, none for an item with
# none; any other field its parent's member.
#
# - `reviews`: the reviews held, by item.
# - `field`: the field handed out.
function resolve(reviews: json.Value, field: graphql.Field) -> json.Value?
    if field.type_name == "Query"
        sku = json.text_of(field.arguments["sku"]?)?
        return ok(json.member(reviews, key: sku).default(.list(items: [])))
    return json.member(field.parent, key: field.field_name)

## Serving

# The service's thread: listens on a port the system chooses, tells the
# supervisor on the mailbox it is handed, and serves until stopped.
# Answers how many requests it answered, as a line.
#
# - `told`: where the supervisor waits to hear the service listens; closed
#   as the thread ends, so a service that ends before telling is told at
#   once.
function run(told: (mailbox notify.Ready)) -> str
    outcome = served(told)
    told.close()

    match outcome
        .ok n  => return f"reviews: requests answered {n}"
        .err e => return "reviews: " + e.msg

# Every connection accepted served until the program is asked to stop.
#
# - `told`: where the supervisor waits to hear the service listens.
#
# Fails as `graphql.parse_schema`, `net.listen` and `notify.ready` fail.
function served(told: (mailbox notify.Ready)) -> i64?
    schema = graphql.parse_schema(SCHEMA, limits: graphql.default_limits())?
    listener @= net.listen(host: "127.0.0.1", port: 0)?

    match notify.ready(told, service: NAME, port: listener.address.port)
        .err e =>
            errors.ignore(net.close_listener(@listener))
            return fail(code: e.code, msg: e.msg)
        .ok _ => _ = 0

    answered @= 0

    while true
        match net.accept(listener, deadline_ms: net.FOREVER)
            .err _ => break
            .ok made =>
                conn @= made
                answered @ answered + conversation(schema, conn: conn)
                errors.ignore(io.close(@conn.stream))

    errors.ignore(net.close_listener(@listener))
    return ok(answered)

# The requests of one connection answered until the client closes it.
#
# - `schema`: the service's schema.
# - `conn`: the connection; its owner closes it.
function conversation(schema: graphql.Schema, conn: net.Conn) -> i64
    reader @= io.reader(conn.stream)
    count @= 0

    while true
        match http.next_request(@reader, limits: http.default_limits())
            .err _ => break
            .ok r =>
                response = answer(schema, r: r)
                count @ count + 1

                if http.write_answer(conn.stream, r: r, response: response).is_err() || r.closing
                    break

    return count

# The answer to one HTTP request: GraphQL at `/graphql`, 404 elsewhere.
#
# - `schema`: the service's schema.
# - `r`: the request.
function answer(schema: graphql.Schema, r: http.Request) -> http.Response
    if r.url.path != "/graphql"
        return http.respond_not_found(r)
    return graphql.serve_http(
        r,
        schema: schema,
        root: .null_value,
        limits: graphql.default_limits(),
        state: held(),
        resolver: resolve
    )

test "answer: a query for one item's reviews"
    schema = graphql.parse_schema(SCHEMA, limits: graphql.default_limits()).must()
    r = http.with_text(
        http.request(method: "POST", target: "/graphql").must(),
        text: "{\"query\": \"{ reviews(sku: \\\"B-200\\\") { author stars } }\"}"
    )
    asked = http.with_header(r.headers, name: "Content-Type", value: "application/json")
    got = answer(
        schema,
        r: http.Request(method: r.method, url: r.url, headers: asked, body: r.body, closing: false, remote: "")
    )
    assert got.status == 200
    assert http.text_of(got).must() == "{\"data\":{\"reviews\":[{\"author\":\"alan\",\"stars\":3}]}}"

test "answer: another path is not found"
    schema = graphql.parse_schema(SCHEMA, limits: graphql.default_limits()).must()
    assert answer(schema, r: http.request(method: "GET", target: "/").must()).status == 404
