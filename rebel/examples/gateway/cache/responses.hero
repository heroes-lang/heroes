# The response cache: a route's `GET` answers kept in an LRU of the routing
# file's size (`containers/cache`), each for as long as its `Cache-Control`
# allows a shared cache to keep it (RFC 9111 § 5.2.2: `s-maxage` before
# `max-age`, nothing for `no-store`, `private` or `no-cache`) and never
# longer than the file's `longest_seconds`. An answer with no `ETag` is
# given a weak one from the CRC-32 of its body, so a client holding a copy
# is answered 304 from the cache without the upstream being asked.

use <rebel>/containers/cache
use <rebel>/hash
use <rebel>/http
use <rebel>/numbers
use <rebel>/strings

use config/settings

## Codes

# The code of a request the cache holds no fresh answer for.
constant NOT_FOUND: str
    "not_found"

## The cache

# One answer kept.
record Entry
    # Its status.
    status: i64
    # Its fields, an `ETag` among them.
    headers: [http.Header]
    # Its body.
    body: [u8]
    # When it was stored, in milliseconds of the gateway's clock.
    stored_ms: i64
    # How long it stays fresh after that, in milliseconds.
    fresh_ms: i64

# The cache: its shape and the three parts `containers/cache` keeps in the
# program's hands. Made empty by `new`.
record Store
    # The links and the time to live.
    shape: cache.Cache
    # The keys by slot.
    key_list: [str]
    # The entries by slot.
    value_list: [Entry]
    # Each key's slot.
    lookup: {str: i64}

# An empty cache of the routing file's bounds.
#
# - `bounds`: its size and its longest time to keep an answer.
function new(bounds: settings.CacheBounds) -> Store
    return Store(
        shape: cache.new_with_ttl(most: bounds.entries, ttl: bounds.longest_seconds * 1000),
        key_list: [],
        value_list: [],
        lookup: {}
    )

# The key of a request: its method, its host in lower case and its whole
# target, so a query asks for another answer.
#
# - `method`: the request's method.
# - `host`: its host, without a port.
# - `target`: its path and query.
function key_of(method: str, host: str, target: str) -> str
    return method + " " + strings.to_lower_ascii(host) + target

# How many answers the cache holds, those expired since the last call that
# read the clock included.
#
# - `store`: the cache.
function size(store: Store lent) -> i64
    return cache.size(store.shape)

## Reading and writing

# The fresh answer under `key` at `now_ms`, with an `Age` field saying how
# long it has been kept (RFC 9111 § 5.1).
#
# - `store`: the cache; the entry becomes the one used last.
# - `key`: the request's key, as `key_of` makes it.
# - `now_ms`: the gateway clock's reading, in milliseconds.
#
# Fails `not_found` where none is held, or the one held is no longer fresh,
# which is then forgotten.
function lookup(@store: Store, key: str, now_ms: i64) -> http.Response?
    entry = cache.get(@store.shape, @store.key_list, @store.value_list, @store.lookup, key: key, now: now_ms)?
    age_ms = now_ms - entry.stored_ms

    if age_ms >= entry.fresh_ms
        _ = cache.remove(@store.shape, @store.key_list, @store.value_list, @store.lookup, key: key).is_err()
        return fail(code: NOT_FOUND, msg: f"the answer kept for {key} went stale {age_ms - entry.fresh_ms} ms ago")
    headers = http.with_header(entry.headers, name: "Age", value: f"{age_ms / 1000}")
    return ok(http.Response(status: entry.status, reason: "", headers: headers, body: entry.body, closing: false))

# Keeps `response` under `key` where a shared cache may, and answers what
# the client is sent: the response with its `ETag`, made where it had none.
#
# - `store`: the cache; gains the entry where it is kept.
# - `key`: the request's key.
# - `response`: the upstream's answer.
# - `now_ms`: the gateway clock's reading, in milliseconds.
#
# Only a 200 is kept, and only for as long as `fresh_ms_of` allows.
function admit(@store: Store, key: str, response: http.Response, now_ms: i64) -> http.Response
    tagged = with_etag(response)

    if tagged.status != http.STATUS_OK
        return tagged

    match fresh_ms_of(tagged.headers)
        .err _ => return tagged
        .ok fresh_ms =>
            entry = Entry(
                status: tagged.status,
                headers: tagged.headers,
                body: tagged.body,
                stored_ms: now_ms,
                fresh_ms: fresh_ms
            )
            cache.put(
                @store.shape,
                @store.key_list,
                @store.value_list,
                @store.lookup,
                key: key,
                value: entry,
                now: now_ms
            )
            return tagged

# How long a shared cache may keep an answer with `headers`, in
# milliseconds, by RFC 9111 § 5.2.2: `s-maxage` where it stands, else
# `max-age`.
#
# - `headers`: the answer's fields.
#
# Fails `not_found` where the answer may not be kept: no `Cache-Control`,
# `no-store`, `private` or `no-cache` in it, an age of zero, or one that is
# no number.
function fresh_ms_of(headers: [http.Header]) -> i64?
    value = http.value_of(headers, name: "Cache-Control")?
    directives = http.parse_cache_control(value)?

    for refused in ["no-store", "private", "no-cache"]
        if !http.directive_of(directives, name: refused).is_err()
            return fail(code: NOT_FOUND, msg: f"Cache-Control says {refused}")

    written = match http.directive_of(directives, name: "s-maxage")
        .ok s  => s
        .err _ => http.directive_of(directives, name: "max-age")?

    match numbers.parse_int(written)
        .err _ => return fail(code: NOT_FOUND, msg: f"a max-age of \"{written}\" is no number")
        .ok seconds =>
            if seconds <= 0 || seconds > 31_536_000
                return fail(code: NOT_FOUND, msg: f"a max-age of {seconds} keeps nothing")
            return ok(seconds * 1000)

# `response` with an `ETag`: its own where it has one, else a weak tag of
# the CRC-32 of its body, which changes where the body does.
#
# - `response`: the answer.
function with_etag(response: http.Response) -> http.Response
    if http.has_header(response.headers, name: "ETag")
        return response
    headers = http.with_header(response.headers, name: "ETag", value: weak_etag(response.body))
    return http.Response(
        status: response.status,
        reason: response.reason,
        headers: headers,
        body: response.body,
        closing: response.closing
    )

# The weak entity tag of `body`: `W/"` and the CRC-32 of its bytes in eight
# hexadecimal digits, then `"`.
#
# - `body`: the bytes.
function weak_etag(body: [u8]) -> str
    digest = to_i64(hash.crc32(body)).must()
    return "W/\"" + strings.pad_zeros(numbers.format_int(n: digest, base: 16), width: 8) + "\""

test "fresh_ms_of: s-maxage before max-age, and what keeps nothing"
    assert fresh_ms_of([http.Header(name: "Cache-Control", value: "public, max-age=60")]).must() == 60_000
    assert fresh_ms_of([http.Header(name: "cache-control", value: "max-age=60, s-maxage=5")]).must() == 5000
    assert fresh_ms_of([http.Header(name: "Cache-Control", value: "private, max-age=60")]).is_err()
    assert fresh_ms_of([http.Header(name: "Cache-Control", value: "no-store")]).is_err()
    assert fresh_ms_of([http.Header(name: "Cache-Control", value: "max-age=0")]).is_err()
    assert fresh_ms_of([http.Header(name: "Cache-Control", value: "max-age=soon")]).is_err()
    assert fresh_ms_of([]).is_err()

test "admit and lookup: kept, aged, then stale and forgotten"
    store @= new(settings.CacheBounds(entries: 2, longest_seconds: 300))
    answer = http.Response(
        status: 200,
        reason: "OK",
        headers: [http.Header(name: "Cache-Control", value: "max-age=10")],
        body: [104, 105],
        closing: false
    )
    sent = admit(@store, key: "GET a/x", response: answer, now_ms: 1000)
    assert http.value_of(sent.headers, name: "ETag").must() == weak_etag([104, 105])
    hit = lookup(@store, key: "GET a/x", now_ms: 4500).must()
    assert http.value_of(hit.headers, name: "Age").must() == "3"
    assert hit.body == [104, 105]
    assert lookup(@store, key: "GET a/x", now_ms: 11_000).is_err()
    assert size(store) == 0

test "admit: a status other than 200 and an answer with no Cache-Control are not kept"
    store @= new(settings.CacheBounds(entries: 2, longest_seconds: 300))
    created = http.Response(
        status: 201,
        reason: "",
        headers: [http.Header(name: "Cache-Control", value: "max-age=10")],
        body: [],
        closing: false
    )
    _ = admit(@store, key: "k1", response: created, now_ms: 0)
    plain = http.Response(status: 200, reason: "", headers: [], body: [], closing: false)
    _ = admit(@store, key: "k2", response: plain, now_ms: 0)
    assert size(store) == 0

test "weak_etag: eight hexadecimal digits, and another body another tag"
    assert weak_etag([]) == "W/\"00000000\""
    assert weak_etag([1]) != weak_etag([2])
    assert weak_etag([0x61, 0x62, 0x63]) == "W/\"352441c2\""

test "key_of: the host's case does not matter, the query does"
    assert key_of(method: "GET", host: "API.test", target: "/a") == key_of(method: "GET", host: "api.test", target: "/a")
    assert key_of(method: "GET", host: "api.test", target: "/a?x=1") != key_of(method: "GET", host: "api.test", target: "/a")
