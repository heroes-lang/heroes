# The desk: the window, its web view and the store behind them, the one value
# every call of the page is answered with. It holds the `ui` app, a handle
# of the platform layer, so the program keeps one desk in one place and hands
# it on with `@`; `close` ends the app and the database together.

use <rebel>/sql/sqlite
use <rebel>/template
use <rebel>/ui
use <rebel>/ui/webview

use store/store

# The program's window and what stands behind it.
record Desk
    # The user interface: the system's own on the desktop, the headless side
    # in the demo.
    app: ui.App
    # The window.
    window: ui.Widget
    # The web view the page is shown in.
    view: ui.Widget
    # The boards.
    store: store.Store
    # The report's page, a template of HTML (`web/report.html`).
    report: template.Template
    # The page's calls waiting on a dialog the person has not answered yet,
    # oldest first.
    waiting: [Waiting]

# A call of the page that showed a dialog and is answered once the person
# answers it (`api/handler.chosen`).
record Waiting
    # The dialog.
    dialog: ui.Dialog
    # The call, whose promise the answer resolves; its name and arguments
    # say what the answer finishes.
    call: webview.Call

# Ends the desk: the database closed, then the app with its window.
#
# - `d`: the desk; every later call through it fails `closed`.
function close(@d: Desk) -> ()?
    closed_db = sqlite.close(@d.store.db)
    ui.close(@d.app)?
    return closed_db
