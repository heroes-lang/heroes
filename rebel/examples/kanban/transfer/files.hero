# A board saved to a file and read back from one, through the system's own
# file dialogs: the person chooses where, the program writes the board's JSON
# (`store/snapshot`) whole or not at all (`fs.write_atomic_text`), and reads
# a file back as a new board. A dialog answers later, through `ui.wait`, so
# each transfer is two halves: the dialog shown, and what the person chose
# done once they chose it. On the headless side the demo answers the dialogs
# itself with `ui.inject`, so the same code runs with no screen.

use <rebel>/fs
use <rebel>/json
use <rebel>/path
use <rebel>/ui

use api/views
use app/desk
use store/boards
use store/snapshot

# The most bytes a board's file may hold: the most cards, each at its most,
# and room for their titles.
constant FILE_MOST: i64
    1100000000

# The files the dialogs offer.
function filters() -> [ui.Filter]
    return [ui.Filter(name: "Kanban boards", extensions: ["json"])]

# Asks the person where to save board `board`: the dialog, whose answer
# `exported` then writes. Fails `not_found` for no such board, and as the
# dialog fails.
#
# - `d`: the desk, whose window the dialog stands over.
# - `board`: the board's name.
function export_asked(@d: desk.Desk, board: str) -> ui.Dialog?
    b = boards.board_named(@d.store, id: board)?
    return ui.save_file(@d.app, over: d.window, title: "Export the board", name: b.title + ".json", filters: filters())

# Writes board `board` where the person chose to save it, as it stands
# now. Answers `{"saved": true, "name": NAME}`, the file's name alone, or
# `{"saved": false}` where they cancelled. Fails `not_found` where the
# board went while the dialog stood, and as the write fails.
#
# - `d`: the desk.
# - `board`: the board's name.
# - `choice`: what the person chose in the dialog `export_asked` showed.
function exported(@d: desk.Desk, board: str, choice: ui.Choice) -> json.Value?
    match choice
        .cancelled => return ok(views.object([views.pair("saved", .boolean(v: false))]))
        .chosen c =>
            text = snapshot.text_of(@d.store, board: board)?
            target = c.paths[0]
            fs.write_atomic_text(path: target, text: text + "\n")?
            return ok(
                views.object([views.pair("saved", .boolean(v: true)), views.pair("name", views.text(path.name(target).default(target)))])
            )

# Asks the person which file to import: the dialog, whose answer
# `chosen_import` reads.
#
# - `d`: the desk, whose window the dialog stands over.
function import_asked(@d: desk.Desk) -> ui.Dialog?
    return ui.open_files(@d.app, over: d.window, title: "Import a board", filters: filters(), multiple: false)

# The file the person chose to import, "" where they cancelled.
#
# - `choice`: what they chose in the dialog `import_asked` showed.
function chosen_import(choice: ui.Choice) -> str
    return match choice
        .cancelled => ""
        .chosen c  => c.paths[0]

# The text of the board file at `file`. Fails `invalid` where it is larger
# than any board, and as the read fails.
#
# - `file`: the file's path.
function read_board_file(file: str) -> str?
    size = fs.info(file)?.size

    if size > FILE_MOST
        return fail(code: "invalid", msg: f"the file takes {size} bytes, more than any board's")
    return read_file(file)

# The board `text` holds, made as a new board with new names, inside the
# caller's change; its name.
#
# - `d`: the desk.
# - `text`: the file's text.
function restored(@d: desk.Desk, text: str) -> str?
    return snapshot.restore(@d.store, text: text, fresh: true)
