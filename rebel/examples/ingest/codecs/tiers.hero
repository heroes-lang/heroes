# The three places a batch is kept and the codec each is written with: the
# hot path in LZ4 frames, fast to write and to read back for recent
# queries; the archive in Zstandard, smaller and still quick to read; the
# cold export in bzip2, the smallest, for a day's events handed to a
# warehouse. Every copy is decompressed again and its SHA-256 compared with
# the raw batch's before it is written, so a codec's fault can never put a
# wrong object in the bucket. A window's batches are compressed on threads,
# each job crossing to its thread whole and its copy coming back whole
# (spec § 11).

use <rebel>/bytes
use <rebel>/compress/bzip2
use <rebel>/compress/lz4
use <rebel>/compress/zstd
use <rebel>/crypto

## Codes

# The code of a copy that does not decompress to its batch, or of a
# codec's name that is none of the three.
constant INVALID: str
    "invalid"

## Bounds

# The most bytes a copy may decompress to while it is checked: a batch is
# never larger than this.
constant MOST_BATCH_BYTES: i64
    268_435_456

## Tiers

# Where a copy of a batch is kept.
variant Tier
    # The hot path: LZ4.
    hot
    # The archive: Zstandard.
    archive
    # The cold export: bzip2.
    cold

# The tier's name, as keys and metrics write it.
#
# - `tier`: the tier.
function tier_name(tier: Tier) -> str
    return match tier
        .hot     => "hot"
        .archive => "archive"
        .cold    => "cold"

# The tier `name` names.
#
# - `name`: `hot`, `archive` or `cold`.
#
# Fails `invalid` for another name.
function parse_tier(name: str) -> Tier?
    return match name
        "hot"     => ok(.hot)
        "archive" => ok(.archive)
        "cold"    => ok(.cold)
        _         => fail(code: INVALID, msg: f"\"{name}\" names no tier: hot, archive or cold")

# The codec's name a tier is written with: `lz4`, `zstd`, `bzip2`.
#
# - `tier`: the tier.
function codec_of(tier: Tier) -> str
    return match tier
        .hot     => "lz4"
        .archive => "zstd"
        .cold    => "bzip2"

# The extension of a tier's objects after `.ndjson`: `.lz4`, `.zst`,
# `.bz2`.
#
# - `tier`: the tier.
function extension_of(tier: Tier) -> str
    return match tier
        .hot     => ".lz4"
        .archive => ".zst"
        .cold    => ".bz2"

## Compressing

# `raw` compressed by `codec`: an LZ4 frame with its content's checksum,
# a Zstandard frame with its checksum, or a bzip2 stream at its highest
# level.
#
# - `codec`: `lz4`, `zstd` or `bzip2`.
# - `raw`: the bytes.
#
# Fails `invalid` for another codec, and as the codec's `compress` fails.
function compress(codec: str, raw: [u8]) -> [u8]?
    if codec == "lz4"
        opts @= lz4.default_options()
        opts.content_checksum @ true
        opts.content_size @ true
        return lz4.compress(raw, options: opts)

    if codec == "zstd"
        opts @= zstd.default_options()
        opts.checksum @ true
        return zstd.compress(raw, options: opts)

    if codec == "bzip2"
        return bzip2.compress(raw, options: bzip2.default_options())
    return fail(code: INVALID, msg: f"\"{codec}\" names no codec: lz4, zstd or bzip2")

# `data` decompressed by `codec`.
#
# - `codec`: `lz4`, `zstd` or `bzip2`.
# - `data`: a copy.
#
# Fails `invalid` for another codec or a copy that is not one, `limit`
# past `MOST_BATCH_BYTES`.
function decompress(codec: str, data: [u8]) -> [u8]?
    return match codec
        "lz4"   => lz4.decompress(data, limit: MOST_BATCH_BYTES)
        "zstd"  => zstd.decompress(data, limit: MOST_BATCH_BYTES)
        "bzip2" => bzip2.decompress(data, limit: MOST_BATCH_BYTES)
        _       => fail(code: INVALID, msg: f"\"{codec}\" names no codec: lz4, zstd or bzip2")

# `raw` compressed by `codec`, then decompressed again and held to
# `sha256`.
#
# - `codec`: the codec.
# - `raw`: the bytes.
# - `sha256`: their SHA-256, in hexadecimal.
#
# Fails `invalid` where the copy does not give `raw` back, and as
# `compress` fails.
function checked_copy(codec: str, raw: [u8], sha256: str) -> [u8]?
    copy = compress(codec, raw: raw)?
    back = decompress(codec, data: copy)?

    if bytes.format_hex(crypto.sha256(back)) != sha256
        return fail(code: INVALID, msg: f"the {codec} copy does not decompress to its batch")
    return ok(copy)

## On threads

# What one thread is handed, whole: a codec, the batch's hash, and its
# bytes.
record Job
    # The codec.
    codec: str
    # The batch's SHA-256.
    sha256: str
    # The bytes.
    raw: [u8]

# A thread's body: `job` compressed and checked.
#
# - `job`: the job.
#
# Fails as `checked_copy` fails.
function compress_job(job: Job) -> [u8]?
    return checked_copy(codec: job.codec, raw: job.raw, sha256: job.sha256)

# Every job's copy, compressed on as many threads as `workers` allows at
# once, in the jobs' order. A thread is started for a job only once fewer
# than `workers` run, and every thread started is waited for before this
# answers, a failed job's included, so nothing is left running.
#
# - `jobs`: the jobs.
# - `workers`: at most how many threads run at once; below one is taken as
#   one.
#
# Fails with the first failed job's failure, in the jobs' order, and `limit`
# where the system refuses a thread, once those started have ended.
function compress_all(jobs: [Job], workers: i64) -> [[u8]]?
    width = if workers < 1
        1
    else
        workers

    running: [(thread [u8]?)] @= []
    answers: [[u8]?] @= []
    refused: ()? @= ok()
    waited @= 0

    while waited < jobs.len()
        while running.len() < jobs.len() && running.len() - waited < width && !refused.is_err()
            match spawn(compress_job, jobs[running.len()])
                .ok t  => running @ running.push(t)
                .err e => refused @ fail(code: e.code, msg: e.msg)

        if waited == running.len()
            break

        answers @ answers.push(running[waited].wait())
        waited @ waited + 1

    refused?
    out: [[u8]] @= []

    for a in answers
        out @ out.push(a?)

    return ok(out)

test "checked_copy: each codec's copy decompresses to its batch"
    raw = bytes.from_text(repeat("{\"id\":\"o-1\",\"type\":\"order.placed\"}\n", 20))
    sha = bytes.format_hex(crypto.sha256(raw))

    for codec in ["lz4", "zstd", "bzip2"]
        copy = checked_copy(codec: codec, raw: raw, sha256: sha).must()
        assert copy.len() < raw.len()
        assert decompress(codec, data: copy).must() == raw

test "checked_copy: a hash that is not the batch's, and a codec of no name, are refused"
    assert checked_copy(codec: "lz4", raw: [1, 2, 3], sha256: "00").is_err()
    assert checked_copy(codec: "gzip", raw: [1], sha256: "").is_err()

test "compress_all: copies made on threads come back in the jobs' order"
    a = bytes.from_text("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    b = bytes.from_text("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    jobs = [
        Job(codec: "zstd", sha256: bytes.format_hex(crypto.sha256(a)), raw: a)
        Job(codec: "lz4", sha256: bytes.format_hex(crypto.sha256(b)), raw: b)
    ]
    copies = compress_all(jobs, workers: 2).must()
    assert decompress("zstd", data: copies[0]).must() == a && decompress("lz4", data: copies[1]).must() == b

test "compress_all: one thread at a time, three jobs, the failed one told and every thread waited for"
    a = bytes.from_text("one batch")
    jobs = [
        Job(codec: "lz4", sha256: bytes.format_hex(crypto.sha256(a)), raw: a)
        Job(codec: "brotli", sha256: "", raw: a)
        Job(codec: "bzip2", sha256: bytes.format_hex(crypto.sha256(a)), raw: a)
    ]
    assert compress_all(jobs, workers: 1).is_err()
    assert compress_all([], workers: 4).must() == []
    assert compress_all([jobs[0], jobs[2]], workers: 0).must().len() == 2

test "tier_name, parse_tier, codec_of, extension_of: each tier's names"
    assert parse_tier(tier_name(.archive)).must() == .archive && codec_of(.cold) == "bzip2" && extension_of(.hot) == ".lz4"
    assert parse_tier("warm").is_err()
