# The workers that read the requests of the server's new connections: each
# a thread that takes the next connection the server's loop accepted from
# one mailbox, handed whole with `m.send(@conn)` (spec § 11), reads its one
# HTTP request within the request's deadline, and hands the connection back
# with the request to the loop's thread, which owns the server's state
# (`server/serving`) and answers it, opens it as a WebSocket or parks it
# for a sign-in's hash, as it did when it read the request itself. A client
# that connects and says nothing, or sends its request slowly, holds its
# worker alone, never the loop.
#
# A `poll` set waits on sockets and a mailbox waits alone, and nothing joins
# the two (`poll.ledger`'s `poll/wake` is pending), so a worker, after each
# hand-over, sends one datagram from a UDP socket of its own to the loop's
# doorbell, a UDP socket in the loop's set, as the hashing threads tell the
# loop a hash is made (`server/hashing`).

use <rebel>/bytes
use <rebel>/http
use <rebel>/io
use <rebel>/net

## Handing over

# A connection whose request was read, handed to the loop's thread whole.
record Read
    # The connection's reader, what it holds of the stream unread included.
    reader: io.Reader
    # The request.
    r: http.Request

# What a worker's thread is handed, whole.
record Start
    # The connections the loop accepted, each taken by one worker.
    conns: (mailbox net.Conn)
    # Where the requests read go, each with its connection.
    reads: (mailbox Read)
    # The port of the loop's doorbell on 127.0.0.1.
    doorbell: i64

# A worker's thread: connections taken and their requests read until the
# mailbox is closed and empty, or the program's stop finds it empty; a
# connection still queued then is read first, its read answering the stop
# at once. Answers how many requests it handed over.
#
# - `w`: the mailboxes and the doorbell's port.
function work(w: Start) -> i64
    handed @= 0

    mouth @= match net.open_udp(host: "127.0.0.1", port: 0)
        .ok u  => u
        .err _ => return 0

    bell = net.with_port(net.loopback_v4(), port: w.doorbell)

    while true
        match w.conns.receive(within_ms: -1)
            .err _ => break
            .ok conn =>
                if read_one(w, conn: conn)
                    handed @ handed + 1

                    match bell
                        .ok to => _ = net.send_to(mouth, data: bytes.from_text("read"), to: to).is_err()
                        .err _ => _ = 0

    _ = net.close_udp(@mouth).is_err()
    return handed

# Reads the one request of `conn` and hands it over with the connection;
# where the read fails, or the loop no longer takes it, closes the
# connection. Answers whether it was handed over.
#
# - `w`: what the worker was handed.
# - `conn`: the connection, its deadline the request's.
function read_one(w: Start, conn: net.Conn) -> bool
    reader @= io.reader(conn.stream)

    r = match http.next_request(@reader, limits: http.default_limits())
        .ok got => got
        .err _ =>
            # `next_request` has answered what a status answers; the
            # connection ends either way.
            _ = io.close(@reader.stream).is_err()
            return false

    read @= Read(reader: reader, r: r)

    match w.reads.send(@read)
        .ok _ => return true
        .err _ =>
            # Not sent, the program stopping: the connection is still this
            # worker's.
            _ = io.close(@read.reader.stream).is_err()
            return false

# Accepts the connection `l` holds, its deadline `deadline_ms`, and hands it
# to a reader through `conns`; where it cannot be handed, the program
# stopping, closes it.
#
# - `l`: the listener, ready.
# - `conns`: the readers' mailbox of connections.
# - `deadline_ms`: the request's deadline, in milliseconds.
function hand(l: net.Listener lent, conns: (mailbox net.Conn), deadline_ms: i64)
    tcp @= match net.accept(l, deadline_ms: deadline_ms)
        .ok c  => c
        .err _ => return

    match conns.send(@tcp)
        .ok _ => _ = 0
        .err _ =>
            # Not sent: the connection is still this thread's.
            _ = io.close(@tcp.stream).is_err()

# Takes the next connection handed over from `reads` without waiting, for
# the loop's thread; fails where none is waiting.
#
# - `reads`: the workers' mailbox of requests read.
function next_read(reads: (mailbox Read)) -> Read?
    return reads.receive(within_ms: 0)
