# How a server started on a thread of its own tells the thread that started
# it where it listens. A thread takes one text and gives back one text when it
# ends, and nothing else crosses (spec § 13), so a server that listens on a
# port the system chooses says the port in one UDP datagram on the loopback,
# to a socket its starter opened first: `ready <port>`, or `failed <why>`
# where it could not start. The starter waits a bounded time, so a server that
# dies before it tells cannot hang it.

use <rebel>/bytes
use <rebel>/net
use <rebel>/numbers
use <rebel>/poll
use <rebel>/strings

# The code of a server that said it failed, or said nothing in time.
constant FAILED: str
    "failed"

# How long a starter waits to be told, in milliseconds.
constant WAIT_MS: i64
    20_000

# A socket on the loopback that hears what a server tells. The starter owes
# it a `net.close_udp`.
#
# Fails as `net.open_udp` fails.
function open_ear() -> net.UdpSocket?
    ear = net.open_udp(host: "127.0.0.1", port: 0)?
    net.set_udp_deadline(ear, deadline_ms: WAIT_MS)?
    return ok(ear)

# Sends `text` to the starter's socket at `port`, from a socket opened and
# closed for it.
#
# - `port`: the port of the starter's socket, on the loopback.
# - `text`: what is told.
function say(port: i64, text: str) -> ()?
    mouth @= net.open_udp(host: "127.0.0.1", port: 0)?
    to = net.with_port(net.loopback_v4(), port: port)?
    sent = net.send_to(mouth, data: bytes.from_text(text), to: to)
    net.close_udp(@mouth)?
    return sent

# Tells the starter at `port` that the server listens on `listening`.
#
# - `port`: the port of the starter's socket.
# - `listening`: the port the server listens on.
function ready(port: i64, listening: i64) -> ()?
    return say(port, text: f"ready {listening}")

# Tells the starter at `port` that the server could not start, and why.
#
# - `port`: the port of the starter's socket.
# - `why`: the failure's message.
function failed(port: i64, why: str) -> ()?
    return say(port, text: f"failed {why}")

# Ends the start of a server that could not get ready: closes its poll set
# and its listener, tells its starter at `port` why, and answers the
# failure for the server to return.
#
# - `set`: the server's poll set, emptied.
# - `l`: the server's listener, emptied.
# - `port`: the port of the starter's socket.
# - `why`: what stopped the start.
#
# Fails `failed` always, with `why`.
function give_up(@set: poll.Set, @l: net.Listener, port: i64, why: str) -> str?
    # The failure told is `why`; a close or a datagram that fails after it
    # adds nothing the starter could act on.
    _ = poll.close(@set).is_err()
    _ = net.close_listener(@l).is_err()
    _ = failed(port: port, why: why).is_err()
    return fail(code: FAILED, msg: why)

# The port a server told `ear`, waiting at most `WAIT_MS`.
#
# - `ear`: the starter's socket.
#
# Fails `failed` where the server told a failure, said what is not a port, or
# said nothing in time.
function heard(ear: net.UdpSocket) -> i64?
    got = match net.receive(ear)
        .ok d  => d
        .err e => return fail(code: FAILED, msg: f"the server told nothing: {e.msg}")

    text = match bytes.to_text(got.data)
        .ok t  => t
        .err _ => return fail(code: FAILED, msg: "the server told bytes that are no text")

    return read_told(text)

# The port `text`, what a server told, names.
#
# - `text`: `ready <port>` or `failed <why>`.
#
# Fails `failed` where it is a failure or no port.
function read_told(text: str) -> i64?
    if strings.has_prefix(s: text, prefix: "failed ")
        return fail(code: FAILED, msg: text.slice(from: 7, to: text.len()))

    if !strings.has_prefix(s: text, prefix: "ready ")
        return fail(code: FAILED, msg: f"the server told \"{text}\"")

    return match numbers.parse_int(text.slice(from: 6, to: text.len()))
        .ok port => ok(port)
        .err _   => fail(code: FAILED, msg: f"the server told \"{text}\", which names no port")

test "read_told: a port, a failure, and a text that is neither"
    assert read_told("ready 4040").must() == 4040
    assert read_told("failed no room").is_err()
    assert read_told("ready four").is_err()
    assert read_told("hello").is_err()

test "heard: a port told over the loopback"
    ear @= open_ear().must()
    ready(port: ear.address.port, listening: 8123).must()
    assert heard(ear).must() == 8123
    net.close_udp(@ear).must()
