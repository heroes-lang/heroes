# The MQTT stand-in's state and routing: its connections with what their
# CONNECT and SUBSCRIBEs said, the framing of a packet by its Remaining
# Length, and the delivery of a PUBLISH to every subscription that matches.
# `mqtt_broker` reads packets and answers them; this module is what it
# answers them with.

use <rebel>/errors
use <rebel>/io
use <rebel>/math
use <rebel>/mqtt
use <rebel>/poll

# The most bytes one packet may hold here: far past a chat line, and a bound
# on what one connection makes the stand-in hold.
constant MOST_PACKET_BYTES: i64
    1_048_576

# One connection to the broker, and what its CONNECT and SUBSCRIBEs said.
record Peer
    # The connection's key in the poll set.
    key: i64
    # The connection's stream, the broker's to close.
    stream: io.Stream
    # Bytes read and not yet a whole packet.
    held: [u8]
    # The protocol level its CONNECT asked, 4 or 5; 0 before its CONNECT.
    version: i64
    # The client's identifier.
    client_id: str
    # Its subscriptions, each filter once.
    subscriptions: [mqtt.Subscription]
    # The packet identifier its next QoS 1 delivery takes, 1 to 65,535.
    next_id: i64
    # Whether it is still connected.
    open: bool

# The broker's connections and what it has carried.
record Broker
    # Every connection made, in the order accepted; a closed one stays with
    # `open` false, so an index names one peer for the broker's whole life.
    peers: [Peer]
    # PUBLISH packets received from clients.
    published: i64
    # Deliveries written to subscribers.
    delivered: i64

# The bytes a whole packet at the start of `held` takes: its fixed header's
# byte, its Remaining Length (one to four bytes, seven bits each, the least
# significant first, MQTT 5 § 1.5.5), and the rest. 0 where more bytes are
# needed; -1 where the length is malformed or past `MOST_PACKET_BYTES`.
#
# - `held`: the bytes read from a connection, not yet framed.
function packet_length(held: [u8]) -> i64
    length @= 0
    scale @= 1
    at @= 1

    while at < held.len()
        b = to_i64(held[at]).must()
        length @ length + (b & 127) * scale

        if b & 128 == 0
            total = at + 1 + length

            if total > MOST_PACKET_BYTES
                return -1

            if held.len() < total
                return 0

            return total

        if at == 4
            return -1

        scale @ scale * 128
        at @ at + 1

    return 0

# Writes `p` to `peer` at its level, and answers whether it was written.
#
# - `peer`: the connection.
# - `p`: the packet.
function send(peer: Peer lent, p: mqtt.Packet) -> bool
    data = match mqtt.encode(p, version: peer.version)
        .ok d  => d
        .err _ => return false

    return !io.write(peer.stream, data: data).is_err()

# Closes the connection of peer `i` and takes it out of the poll set; a peer
# closed already is left as it is.
#
# - `b`: the broker.
# - `set`: the poll set.
# - `i`: the peer's index.
function drop_peer(@b: Broker, set: poll.Set, i: i64)
    if !b.peers[i].open
        return

    # A connection ends here whatever its socket answers: a failure to take it
    # out or to close it leaves nothing the broker could do better.
    errors.ignore(poll.remove(set, key: b.peers[i].key))
    errors.ignore(io.close(@b.peers[i].stream))
    b.peers[i].open @ false

# The highest QoS a subscription of `peer` matching `topic` grants, -1 where
# none matches; a No Local subscription does not match where the message is
# the peer's own.
#
# - `peer`: the subscriber.
# - `topic`: the message's topic.
# - `own`: whether the message was published by this peer.
function granted_for(peer: Peer lent, topic: str, own: bool) -> i64
    best @= -1

    for s in peer.subscriptions
        if mqtt.matches(pattern: s.filter, topic: topic) && !(own && s.no_local) && s.qos > best
            best @ s.qos

    return best

# The properties of a message as it is delivered at `version`: none in
# 3.1.1; in 5 its own, but a Topic Alias and Subscription Identifiers, which
# belong to one connection's publish.
#
# - `properties`: the message's properties as published.
# - `version`: the subscriber's level.
function delivered_properties(properties: [mqtt.Property], version: i64) -> [mqtt.Property]
    kept: [mqtt.Property] @= []

    if version != 5
        return kept

    for p in properties
        if p.id != mqtt.TOPIC_ALIAS && p.id != mqtt.SUBSCRIPTION_IDENTIFIER
            kept @ kept.push(p)

    return kept

# Delivers `m`, published by peer `from`, to every connected peer one of
# whose subscriptions matches it, once each, at the lower of its QoS and the
# subscription's.
#
# - `b`: the broker.
# - `from`: the publisher's index.
# - `m`: the message as published.
function route(@b: Broker, from: i64, m: mqtt.Message)
    b.published @ b.published + 1
    j @= 0

    while j < b.peers.len()
        granted = granted_for(b.peers[j], topic: m.topic, own: j == from)

        if b.peers[j].open && b.peers[j].version != 0 && granted >= 0
            out @= m
            out.qos @ math.min_i64(a: m.qos, b: granted)
            out.retain @ false
            out.dup @ false
            out.packet_id @ 0
            out.properties @ delivered_properties(m.properties, version: b.peers[j].version)

            if out.qos > 0
                out.packet_id @ b.peers[j].next_id
                b.peers[j].next_id @ b.peers[j].next_id % 65_535 + 1

            if send(b.peers[j], p: .publish(message: out))
                b.delivered @ b.delivered + 1

        j @ j + 1

test "packet_length: a PINGREQ, a length of two bytes, one cut short, and five bytes of length"
    assert packet_length([192, 0]) == 2
    held: [u8] @= [48, 130, 1]

    for _ in range(from: 0, to: 130)
        held @ held.push(0)

    assert packet_length(held) == 133
    assert packet_length([48, 130]) == 0
    assert packet_length([48, 5, 0]) == 0
    assert packet_length([48, 128, 128, 128, 128, 1]) == -1
    assert packet_length([48]) == 0

test "granted_for: a wildcard, No Local on one's own message, and no match"
    peer = Peer(
        key: 1,
        stream: io.stdout(),
        held: [],
        version: 5,
        client_id: "x",
        subscriptions: [mqtt.subscription("chat/rooms/+", qos: 1)],
        next_id: 1,
        open: true
    )
    assert granted_for(peer, topic: "chat/rooms/iot", own: false) == 1
    quiet @= peer
    quiet.subscriptions[0].no_local @ true
    assert granted_for(quiet, topic: "chat/rooms/iot", own: true) == -1
    assert granted_for(peer, topic: "other", own: false) == -1

test "delivered_properties: none in 3.1.1, and a topic alias dropped in 5"
    props = [
        mqtt.Property(id: mqtt.TOPIC_ALIAS, value: .number(v: 3))
        mqtt.Property(id: mqtt.CONTENT_TYPE, value: .text(v: "a"))
    ]
    assert delivered_properties(props, version: 4).len() == 0
    assert delivered_properties(props, version: 5) == [mqtt.Property(id: mqtt.CONTENT_TYPE, value: .text(v: "a"))]
