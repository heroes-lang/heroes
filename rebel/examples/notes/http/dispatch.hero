# Which function answers a page's route: each page's route bound by its
# name to the program's function in one table, `pages`, which `page` reads
# with the state lent by `@` and the request's visit, after the route's
# steps (`pipeline.bind`). The API's operations are answered by `api/`, the
# live channel's upgrade by the server's loop.

use <rebel>/http
use <rebel>/metrics
use <rebel>/openapi
use <rebel>/sql/sqlite
use <rebel>/web

use app/state
use auth/visit
use http/pages_account
use http/pages_notes
use http/replies
use http/routes
use ops/ops
use realtime/realtime

# Whether the route `name` answers HTML and JSON by the request's `Accept`.
#
# - `name`: the route's name.
function is_negotiated(name: str) -> bool
    return name == routes.HOME || name == routes.NOTES || name == routes.NOTE || name == routes.TAG || name == routes.SEARCH

# The function that answers each page's route, by the route's name: readers
# and writers of the state in one table, each handed the visit and the route.
function pages() -> {str: (function(@state.App, visit.Visit, web.Found, http.Request) -> replies.Reply?)}
    return {
        routes.HOME: pages_notes.home
        routes.NOTES: pages_notes.home
        routes.NOTE: pages_notes.note
        routes.NOTE_NEW: pages_notes.note_new
        routes.NOTE_CREATE: pages_notes.note_create
        routes.NOTE_DELETE: pages_notes.note_delete
        routes.COMMENT_CREATE: pages_notes.comment_create
        routes.TAG: pages_notes.tag_page
        routes.SEARCH: pages_notes.search
        routes.FEED: pages_notes.atom
        routes.REGISTER_FORM: pages_account.register_form
        routes.REGISTER: pages_account.register
        routes.LOGIN_FORM: pages_account.login_form
        routes.LOGIN: pages_account.login
        routes.LOGOUT: pages_account.logout
        routes.USERS: pages_account.users
        routes.ROLE: pages_account.role
        routes.STATIC: static_files
        routes.HEALTH: health
        routes.READY: ready
        routes.METRICS: counters
    }

# The answer to a page's route: the function `pages` binds to its name, or
# the API document's own page, or 404.
#
# - `app`: the state.
# - `v`: the visit.
# - `found`: the route and its parameters.
# - `r`: the request.
#
# Fails where its handler fails, which the pipeline answers 500.
function page(@app: state.App, v: visit.Visit, found: web.Found, r: http.Request) -> replies.Reply?
    match pages()[found.name]
        .ok answer => return answer(@app, v, found, r)
        .err _     => _ = 0

    if openapi.is_site_route(found.name)
        return ok(replies.plain(openapi.respond_site(app.site, name: found.name)))

    return ok(replies.plain(http.respond_not_found(r)))

# `GET /static/*path`: the site's files.
#
# - `app`: the state, its folder read.
# - `found`: the route, its parameter `path`.
# - `r`: the request.
function static_files(app: state.App lent, _: visit.Visit, found: web.Found, r: http.Request) -> replies.Reply?
    return ok(replies.plain(web.serve_folder(r, folder: app.folder, rest: web.param_of(found, name: "path"))))

# `GET /healthz`: whether the process lives.
#
# - `r`: the request.
function health(_: state.App lent, _: visit.Visit, _: web.Found, r: http.Request) -> replies.Reply?
    return ok(replies.plain(web.health_response(r, checks: [], detail: false)))

# `GET /readyz`: whether it can serve, its database answering.
#
# - `app`: the state, its database asked.
# - `r`: the request.
function ready(app: state.App lent, _: visit.Visit, _: web.Found, r: http.Request) -> replies.Reply?
    checks = [web.Check(name: "database", outcome: sqlite.ping(app.db))]
    return ok(replies.plain(web.health_response(r, checks: checks, detail: false)))

# `GET /metrics`: the counters, for Prometheus, the sockets' gauge set first.
#
# - `app`: the state, whose gauge is set.
# - `r`: the request.
function counters(@app: state.App, _: visit.Visit, _: web.Found, r: http.Request) -> replies.Reply?
    ops.gauge(@app.registry, name: ops.SOCKETS, value: realtime.count(app.hub))
    return ok(replies.plain(metrics.respond(app.registry, r: r)))
