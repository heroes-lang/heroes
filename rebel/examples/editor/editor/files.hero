# The commands about files and buffers: save in the file's own encoding,
# choose the encoding the next save writes, read the file again in another
# encoding, reload it from disk, see the buffer against the file on disk,
# open, close, leave, and step between the buffers.
#
# Reading again, from disk or in another encoding, replaces the text as one
# change of the history, so a reload a person did not mean is one undo away;
# and a buffer whose save encoding changed counts as modified until it is
# saved, since its file's bytes would change though its text did not.

use <rebel>/diff
use <rebel>/fs
use <rebel>/unicode/encodings

use buffers/buffer
use buffers/editing
use buffers/list
use editor/state
use files/disk
use files/endings

# Runs a command about files or buffers by its name.
#
# - `e`: the editor.
# - `command`: `save`, `encoding`, `reopen`, `reload`, `diff`, `open`,
#   `close`, `quit`, `next_buffer`, `previous_buffer` or `help`.
#
# Fails where the system refuses a read the command needs.
function run(@e: state.Editor, command: str) -> ()?
    match command
        "open" =>
            state.ask(@e, asking: .open_file, question: "open: ", text: "")
            return ok()
        "quit" =>
            quit(@e)
            return ok()
        "help" =>
            e.mode @ .help
            e.view_top @ 0
            return ok()
        _ => _ = 0

    at = match state.slot_of_current(e)
        .ok s  => s
        .err _ => return ok()

    b = e.buffers.open[at]

    match command
        "save" => save(@e, at: at)
        "encoding" => state.ask(@e, asking: .save_encoding, question: "save in encoding: ", text: b.format.encoding)
        "reopen" => state.ask(@e, asking: .reopen_encoding, question: "read again in encoding: ", text: "")
        "reload" => reload_from_disk(@e, path: b.path)
        "diff" => show_diff(@e, at: at)
        "close" => close(@e, path: b.path)
        "next_buffer" => e.current @ list.next_path(e.buffers, path: e.current)
        "previous_buffer" => e.current @ list.previous_path(e.buffers, path: e.current)
        _ => state.warn(@e, text: f"\"{command}\" is no command")

    return ok()

# The encoding a read again should name: the buffer's where a person named
# it, else "" so the bytes say again.
#
# - `format`: the buffer's format.
function named_of(format: disk.Format) -> str
    if format.chosen == "named"
        return format.encoding

    return ""

# Saves the buffer at slot `at` in its format, atomically, and starts
# watching its file where it was new.
#
# - `e`: the editor.
# - `at`: the buffer's slot.
#
# A text its encoding cannot write is refused before anything is written,
# naming the character and where it stands; a write the system refuses is
# told the same way.
function save(@e: state.Editor, at: i64)
    b = e.buffers.open[at]

    data = match disk.encode(buffer.text_of(b), format: b.format)
        .ok d => d
        .err x =>
            state.warn(@e, text: f"not saved: {x.msg}")
            return

    match disk.save(b.path, data: data)
        .ok _ => _ = 0
        .err x =>
            state.warn(@e, text: f"not saved: {x.msg}")
            return

    buffer.mark_saved(@e.buffers.open[at], written: data)
    e.buffers.open[at].unreadable @ fail(code: "not_found", msg: "saved")

    match disk.start_watching(@e.watched, path: b.path)
        .ok _  => _ = 0
        .err x => state.warn(@e, text: f"{b.path} saved but not watched: {x.msg}")

    state.say(
        @e,
        text: f"saved {b.path}: {data.len()} bytes in {b.format.encoding}, {endings.name_of(b.format.ending)}"
    )

# Answers the prompt of `encoding`: the encoding the next save of the buffer
# shown writes, its text checked against it at once.
#
# - `e`: the editor.
# - `label`: a label of the WHATWG standard, in any case.
function answer_save_encoding(@e: state.Editor, label: str)
    state.settle(@e)

    at = match state.slot_of_current(e)
        .ok s  => s
        .err _ => return

    name = match encodings.name_of(label)
        .ok n => n
        .err _ =>
            state.warn(@e, text: f"\"{label}\" names no encoding: UTF-8, windows-1252, Shift_JIS, UTF-16LE, ...")
            return

    b = e.buffers.open[at]

    if name == b.format.encoding
        state.say(@e, text: f"{b.path} is saved in {name} already")
        return

    e.buffers.open[at].format.encoding @ name
    e.buffers.open[at].format.bom @ name == encodings.UTF_16LE || name == encodings.UTF_16BE
    e.buffers.open[at].format.chosen @ "named"
    e.buffers.open[at].format.confidence @ 1.0
    buffer.mark_differs(@e.buffers.open[at])

    match disk.encode(buffer.text_of(b), format: e.buffers.open[at].format)
        .ok _  => state.say(@e, text: f"{b.path} will be saved in {name}")
        .err x => state.warn(@e, text: f"{b.path} will be saved in {name}, but {x.msg}")

# Answers the prompt of `reopen`: the file's bytes read again in the
# encoding named, as one change undo takes back.
#
# - `e`: the editor.
# - `label`: a label of the standard; "" lets the bytes say again.
function answer_reopen(@e: state.Editor, label: str)
    state.settle(@e)
    reload(@e, path: e.current, named: label)

# Reads the file of the buffer of `path` again from disk, in the encoding a
# person named for it, or in the one its bytes say.
#
# - `e`: the editor.
# - `path`: the buffer's path.
function reload_from_disk(@e: state.Editor, path: str)
    match list.slot_of(e.buffers, path: path)
        .ok at => reload(@e, path: path, named: named_of(e.buffers.open[at].format))
        .err _ => _ = 0

# Reads the file of the buffer of `path` again, in the encoding `named`, and
# puts its text in the buffer as one change.
#
# - `e`: the editor.
# - `path`: the buffer's path.
# - `named`: the encoding to read it in, or "" to let the bytes say.
function reload(@e: state.Editor, path: str, named: str)
    at = match list.slot_of(e.buffers, path: path)
        .ok s  => s
        .err _ => return

    data = match fs.read_bytes(path)
        .ok d => d
        .err x =>
            state.warn(@e, text: f"{path} cannot be read: {x.msg}")
            return

    loaded = match disk.from_bytes(data, named: named)
        .ok l => l
        .err x =>
            state.warn(@e, text: f"{path} cannot be read in \"{named}\": {x.msg}")
            return

    e.current @ path
    editing.reread(
        @e.buffers.open[at],
        text: loaded.text,
        format: loaded.format,
        data: data,
        tab_width: state.tab_width(e)
    )
    e.buffers.open[at].unreadable @ loaded.unreadable
    told = f"{path} read again: {disk.describe(loaded.format)}; Ctrl-Z takes it back"

    match loaded.unreadable
        .ok first => state.say(@e, text: told + f"; byte {first} could not be read and is shown as U+FFFD")
        .err _    => state.say(@e, text: told)

# Keeps the buffer of `path` as it is though its file changed: the bytes on
# disk become the ones a later change is compared with, and the buffer
# counts as modified, so leaving asks to save it.
#
# - `e`: the editor.
# - `path`: the buffer's path.
function keep(@e: state.Editor, path: str)
    at = match list.slot_of(e.buffers, path: path)
        .ok s  => s
        .err _ => return

    e.buffers.open[at].known @ fs.read_bytes(path).default([])
    buffer.mark_differs(@e.buffers.open[at])
    state.say(@e, text: f"{path} kept as it is; a save will write it over the file")

# Shows the buffer at slot `at` against its file on disk, read in the
# buffer's encoding, in the unified format; or says they are the same.
#
# - `e`: the editor.
# - `at`: the buffer's slot.
function show_diff(@e: state.Editor, at: i64)
    b = e.buffers.open[at]

    on_disk = match fs.read_bytes(b.path)
        .ok d => disk.from_bytes(d, named: b.format.encoding).default(
            disk.Loaded(text: "", format: b.format, bytes: d, exists: true, unreadable: fail(code: "not_found", msg: ""))
        )
        .err _ => disk.Loaded(
            text: "",
            format: b.format,
            bytes: [],
            exists: false,
            unreadable: fail(code: "not_found", msg: "")
        )

    old = diff.lines_of(on_disk.text)
    new = diff.lines_of(buffer.text_of(b))
    options @= diff.default_options(old_name: b.path + " (on disk)", new_name: b.path + " (buffer)")
    options.context @ e.setup.options.diff_context
    written = diff.format_unified(old: old, new: new, options: options)

    if written == ""
        state.say(@e, text: f"{b.path} is the same as its file on disk")
        return

    added @= 0
    removed @= 0

    for op in diff.edits(old: old, new: new)
        match op.tag
            .equal => _ = 0
            .delete | .insert | .replace =>
                removed @ removed + op.old_to - op.old_from
                added @ added + op.new_to - op.new_from

    e.diff_lines @ diff.lines_of(written).map(without_feed)
    e.view_top @ 0
    e.mode @ .diff
    state.say(@e, text: f"{b.path}: {added} line(s) added, {removed} removed against the disk; Esc returns")

# `line` without its final line feed.
#
# - `line`: a line as `diff.lines_of` gives it.
function without_feed(line: str) -> str
    if line.len() > 0 && line[line.len() - 1] == '\n'
        return line.slice(from: 0, to: line.len() - 1)

    return line

# Closes the buffer of `path`, asking first where it is modified.
#
# - `e`: the editor.
# - `path`: the buffer's path.
function close(@e: state.Editor, path: str)
    at = match list.slot_of(e.buffers, path: path)
        .ok s  => s
        .err _ => return

    if buffer.is_modified(e.buffers.open[at])
        state.confirm(
            @e,
            asking: .close(path: path),
            question: f"{state.name_of(path)} is modified: save it first? y, n, Esc"
        )
        return

    state.close_path(@e, path: path)

# Answers the question of `close`.
#
# - `e`: the editor.
# - `path`: the buffer's path.
# - `answer`: `y` to save and close, `n` to close unsaved, anything else to
#   keep it open.
function answer_close(@e: state.Editor, path: str, answer: str)
    state.settle(@e)

    at = match list.slot_of(e.buffers, path: path)
        .ok s  => s
        .err _ => return

    match answer
        "y" =>
            save(@e, at: at)

            if !buffer.is_modified(e.buffers.open[at])
                state.close_path(@e, path: path)
        "n" => state.close_path(@e, path: path)
        _   => state.say(@e, text: f"{path} stays open")

# Leaves, asking first where a buffer is modified.
#
# - `e`: the editor.
function quit(@e: state.Editor)
    modified = list.modified_paths(e.buffers)

    if modified.len() == 0
        e.done @ true
        return

    state.confirm(@e, asking: .quit, question: f"modified: {modified.map(state.name_of).join(", ")}; leave? y, n")

# Answers the question of `quit`.
#
# - `e`: the editor.
# - `answer`: `y` to leave, anything else to stay.
function answer_quit(@e: state.Editor, answer: str)
    state.settle(@e)

    if answer == "y"
        e.done @ true
    else
        state.say(@e, text: "nothing was closed")

# Answers the prompt of `open`.
#
# - `e`: the editor.
# - `path`: the path typed.
function answer_open(@e: state.Editor, path: str)
    state.settle(@e)

    if path == ""
        return

    match state.open_path(@e, path: path, named: "")
        .ok _  => _ = 0
        .err x => state.warn(@e, text: f"{path} cannot be opened: {x.msg}")
