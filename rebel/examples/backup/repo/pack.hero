# A pack: many sealed chunks written as one object, so a repository of a
# million chunks is a few thousand objects, which is what a bucket and a
# folder both handle well. A pack is the chunks one after another, then
# its header, sealed, listing each chunk's name, place and plain length,
# then the header's length in four bytes, little-endian, as restic lays
# its packs out: a pack can be read back alone, with no index, which is
# how an index is rebuilt and how the pruner checks what it rewrites.
#
# A pack is named by the HMAC of its chunks' names, in order, so the same
# chunks packed in the same order make the same name, and every chunk in
# it is checked on its own when it is opened.

use <rebel>/bytes
use <rebel>/json

use vault/master

## Codes

# The code of a pack that is not one: cut, its header unreadable.
constant INVALID: str
    "invalid"

## Bounds

# What a pack's header is bound to.
constant HEADER: str
    "pack header"

# The most bytes a pack's header may decompress to.
constant HEADER_LIMIT: i64
    67_108_864

## Entries

# One chunk of a pack.
record Entry
    # The chunk's name.
    id: str
    # Where its sealed bytes begin in the pack.
    offset: i64
    # How many sealed bytes it has.
    length: i64
    # How many bytes it holds once opened and decompressed.
    raw: i64

# A pack being filled.
record Builder
    # The sealed chunks so far, one after another.
    data: [u8]
    # Each chunk's entry, in order.
    entries: [Entry]

# A pack written out: its name, its bytes and its entries.
record Finished
    # The pack's name, 64 hexadecimal digits.
    name: str
    # Every byte of it.
    data: [u8]
    # Its chunks, in order.
    entries: [Entry]

# An empty pack.
function builder() -> Builder
    return Builder(data: [], entries: [])

# Adds a chunk's sealed bytes to `b`.
#
# - `b`: the pack; its data and entries grow.
# - `id`: the chunk's name.
# - `stored`: its sealed bytes.
# - `raw`: its plain length.
function add(@b: Builder, id: str, stored: [u8], raw: i64)
    entry = Entry(id: id, offset: b.data.len(), length: stored.len(), raw: raw)
    bytes.push_all(to: @b.data, from: stored)
    b.entries @ b.entries.push(entry)

# Whether `b` holds nothing.
#
# - `b`: the pack.
function is_empty(b: Builder lent) -> bool
    return b.entries.len() == 0

# `b` written out: its chunks, its sealed header and the header's length.
#
# - `m`: the master key.
# - `b`: the pack, at least one chunk in it.
#
# Fails as the header's sealing fails.
function finish(m: master.Master lent, b: Builder) -> Finished?
    header = master.seal_bytes(m, data: bytes.from_text(encode_entries(b.entries)?), bound: HEADER)?
    out @= b.data
    bytes.push_all(to: @out, from: header)
    bytes.push_all(to: @out, from: bytes.encode_u32_le(to_u32(header.len())?))
    ids: [str] @= []

    for e in b.entries
        ids @ ids.push(e.id)

    return ok(Finished(name: master.name_of(m, data: bytes.from_text(ids.join(","))), data: out, entries: b.entries))

# The entries of the pack whose bytes are `data`, read from its header.
#
# - `m`: the master key.
# - `data`: the whole pack.
#
# Fails `invalid` where the pack is cut or its header does not open or is
# not a pack's.
function entries_of(m: master.Master lent, data: [u8]) -> [Entry]?
    if data.len() < 4
        return fail(code: INVALID, msg: "a pack ends with its header's length, and this one is shorter")
    told = to_i64(bytes.decode_u32_le(data, at: data.len() - 4)?)?

    if told > data.len() - 4
        return fail(code: INVALID, msg: f"a pack's header of {told} bytes is longer than the pack")
    start = data.len() - 4 - told
    header = master.open_bytes(m, sealed: data.slice(from: start, to: data.len() - 4), bound: HEADER)?

    text = match bytes.to_text(header)
        .ok t  => t
        .err _ => return fail(code: INVALID, msg: "a pack's header is UTF-8")

    entries = decode_entries(text)?

    for e in entries
        if e.offset < 0 || e.length < 0 || e.offset + e.length > start
            return fail(code: INVALID, msg: f"the pack's header places {e.id} outside the pack")

    return ok(entries)

# The sealed bytes of `e` in the pack `data`.
#
# - `data`: the whole pack.
# - `e`: one of its entries, inside it.
#
# Fails `invalid` where `e` reaches past the pack.
function stored_of(data: [u8] lent, e: Entry) -> [u8]?
    if e.offset < 0 || e.length < 0 || e.offset + e.length > data.len()
        return fail(code: INVALID, msg: f"the chunk {e.id} lies outside its pack")
    return ok(data.slice(from: e.offset, to: e.offset + e.length))

## The header's text

# `entries` as the JSON a header seals.
#
# - `entries`: the entries, in order.
#
# Fails as `json.format` fails.
function encode_entries(entries: [Entry]) -> str?
    return json.format(.list(items: entries_json(entries)?))

# `entries` as JSON values, each an object of `id`, `offset`, `length` and
# `raw`.
#
# - `entries`: the entries.
#
# Fails `does_not_fit` for a number past JSON's exact integers, which no
# pack reaches.
function entries_json(entries: [Entry]) -> [json.Value]?
    items: [json.Value] @= []

    for e in entries
        members: {str: json.Value} = {
            "id": .text(v: e.id)
            "offset": json.from_int(e.offset)?
            "length": json.from_int(e.length)?
            "raw": json.from_int(e.raw)?
        }
        items @ items.push(.object(members: members))

    return ok(items)

# The entries `text` lists.
#
# - `text`: the JSON `encode_entries` writes.
#
# Fails `invalid` where it is not such a list.
function decode_entries(text: str) -> [Entry]?
    v = match json.parse(text)
        .ok parsed => parsed
        .err e     => return fail(code: INVALID, msg: "a pack's header is JSON: " + e.msg)

    return entries_from(v)

# The entries the JSON list `v` holds.
#
# - `v`: a list of objects as `entries_json` writes them.
#
# Fails `invalid` where it is not such a list.
function entries_from(v: json.Value) -> [Entry]?
    items = match json.items_of(v)
        .ok list => list
        .err _   => return fail(code: INVALID, msg: "a pack's entries are a list")

    out: [Entry] @= []

    for item in items
        id = match json.text_of(json.member(item, "id").default(.null_value))
            .ok s  => s
            .err _ => return fail(code: INVALID, msg: "a pack's entry names its chunk")

        out @ out.push(
            Entry(id: id, offset: number_of(item, name: "offset")?, length: number_of(item, name: "length")?, raw: number_of(item, name: "raw")?)
        )

    return ok(out)

# The integer member `name` of `item`.
#
# - `item`: an entry's object.
# - `name`: the member.
#
# Fails `invalid` where it is missing or not an integer.
function number_of(item: json.Value, name: str) -> i64?
    return match json.int_of(json.member(item, name).default(.null_value))
        .ok n  => ok(n)
        .err _ => fail(code: INVALID, msg: f"a pack's entry holds its {name} as an integer")

test "entries_of: a pack shorter than its length, and a length past the pack, are refused"
    if !master.is_ready()
        skip_test(reason: "this machine's cryptography has no AES-256-GCM")
    m @= master.from_material(bytes.repeated([4], n: 64)).must()
    assert entries_of(m, data: [1, 2]).is_err()
    assert entries_of(m, data: [0, 0, 0, 0, 0xff, 0, 0, 0]).is_err()
    master.close(@m).must()

test "finish: a pack read back by its own header, each chunk where its entry says"
    if !master.is_ready()
        skip_test(reason: "this machine's cryptography has no AES-256-GCM")
    m @= master.from_material(bytes.repeated([4], n: 64)).must()
    b @= builder()
    assert is_empty(b)
    add(@b, id: "aa", stored: [1, 2, 3], raw: 10)
    add(@b, id: "bb", stored: [4, 5], raw: 2)
    done = finish(m, b: b).must()
    entries = entries_of(m, data: done.data).must()
    assert entries == done.entries
    assert entries[1] == Entry(id: "bb", offset: 3, length: 2, raw: 2)
    assert stored_of(done.data, e: entries[0]).must() == [1, 2, 3]
    assert finish(m, b: b).must().name == done.name
    master.close(@m).must()
