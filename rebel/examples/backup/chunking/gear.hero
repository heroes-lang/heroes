# The rolling hash that decides where a file is cut: a gear hash, as
# FastCDC uses (Xia et al., USENIX ATC 2016). Each byte shifts the hash one
# bit up and adds the byte's value from a table of 256 random numbers, so
# the hash's top bits depend on the last 48 bytes alone, and a cut decided
# there moves with the content: bytes inserted early in a file shift every
# later cut with them instead of moving every chunk after them.
#
# The table is drawn from the repository's own seed (`hash.xxh64` of each
# byte value under it), as restic draws a polynomial per repository, so the
# cuts of one repository say nothing a reader could match against another
# repository's to learn what a file holds.
#
# The hash is kept below 2^49 by masking it to 48 bits before each shift,
# since a Heroes integer aborts where it would overflow rather than wrap.

use <rebel>/hash

## Codes

# The code of cutting parameters no chunker can follow.
constant INVALID: str
    "invalid"

## Bounds

# The bits of the window the hash keeps.
constant WINDOW_BITS: i64
    48

# The mask of those bits.
constant WINDOW_MASK: i64
    0xffff_ffff_ffff

# The mask that keeps a table's value below 2^47, so a shifted hash plus a
# value stays below 2^49.
constant VALUE_MASK: i64
    0x7fff_ffff_ffff

## Parameters

# Where a file may be cut.
record Params
    # The least bytes of a chunk, but the last of a file.
    min: i64
    # A chunk is cut where the hash's top `bits` bits are zero, so its
    # average length past `min` is 2 to the power `bits`.
    bits: i64
    # The most bytes of a chunk.
    max: i64

# The parameters a repository is made with unless told otherwise:
# restic's sizes, 512 KiB to 8 MiB around 1 MiB.
function default_params() -> Params
    return Params(min: 524_288, bits: 20, max: 8_388_608)

# `p`, checked.
#
# - `p`: the parameters.
#
# Fails `invalid` where `bits` is outside 6 to 30, `min` below 64, or
# `max` not above both `min` and 2 to the power `bits`.
function checked(p: Params) -> Params?
    if p.bits < 6 || p.bits > 30
        return fail(code: INVALID, msg: f"a chunk's average is 2^6 to 2^30 bytes, and 2^{p.bits} was asked")

    if p.min < 64 || p.max <= p.min || p.max <= 1 << p.bits
        return fail(
            code: INVALID,
            msg: f"a chunk is cut between {p.min} and {p.max} bytes, which no average of 2^{p.bits} fits"
        )
    return ok(p)

## The table

# The 256 values a byte adds to the hash.
record Table
    # One value per byte value, each below 2^47.
    values: [i64]

# The table of the seed `seed`.
#
# - `seed`: the repository's chunker seed.
function table_of(seed: u64) -> Table
    values: [i64] @= []

    for b in range(from: 0, to: 256)
        drawn = hash.xxh64([to_u8(b).must()], seed: seed) % 0x8000_0000_0000
        values @ values.push(to_i64(drawn).must() & VALUE_MASK)

    return Table(values: values)

# The hash after `b`: the window shifted one bit and `b`'s value added.
#
# - `h`: the hash so far, 0 at a chunk's start.
# - `b`: the next byte.
# - `t`: the table.
function roll(h: i64, b: u8, t: Table lent) -> i64
    return (h << 1 & WINDOW_MASK) + t.values[to_i64(b).must()]

# Whether `h` asks for a cut: its top `bits` bits of the window are zero.
#
# - `h`: the hash.
# - `bits`: the parameters' `bits`.
function hits(h: i64, bits: i64) -> bool
    return (h & WINDOW_MASK) >> WINDOW_BITS - bits == 0

test "checked: an average past the most, a least below 64 and too few bits are refused"
    assert checked(Params(min: 1024, bits: 12, max: 4096)).is_err()
    assert checked(Params(min: 32, bits: 10, max: 4096)).is_err()
    assert checked(Params(min: 1024, bits: 5, max: 4096)).is_err()
    assert checked(Params(min: 4096, bits: 10, max: 4096)).is_err()
    assert checked(default_params()).must() == default_params()

test "table_of: one seed draws one table, another seed another, every value below 2^47"
    one = table_of(1)
    assert one.values.len() == 256
    assert table_of(1) == one
    assert table_of(2) != one

    for v in one.values
        assert v >= 0 && v <= VALUE_MASK

test "roll: the hash never leaves the window plus one value, whatever the bytes"
    t = table_of(7)
    h @= 0

    for i in range(from: 0, to: 1000)
        h @ roll(h, b: to_u8(i % 256).must(), t: t)
        assert h >= 0 && h < 0x2_0000_0000_0000

test "hits: a zero top hits, a set top bit does not"
    assert hits(h: 0, bits: 10)
    assert hits(h: 0x3f_ffff_ffff, bits: 10)
    assert !hits(h: 0x8000_0000_0000, bits: 10)
