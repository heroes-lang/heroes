# `monitor workload`: a small program the monitor's binary also is, for
# trying a monitor without real services, as the demo does. As a service
# (`monitor workload service --name cache`) it says it is ready and then
# does what each line of its input asks:
#
#     grow 256     hold 256 MiB of memory, written so it stays resident
#     release      let it go
#     exit 3       end with the code 3, as a crash does
#     stubborn     pay no heed to a `stop` from now on
#     stop         end with the code 0
#
# and once its input ends it waits to be ended. As a notifier
# (`monitor workload notify --file alerts.txt`) it reads the alert the
# monitor writes on its input and appends one line of it to the file.

use <rebel>/errors
use <rebel>/fs
use <rebel>/io
use <rebel>/json
use <rebel>/numbers
use <rebel>/strings
use <rebel>/time

# The bytes of one piece of the memory a `grow` holds: 64 KiB.
constant PIECE: i64
    65_536

# The letters a piece is written with.
constant LETTERS: str
    "abcdefghijklmnopqrstuvwxyz0123456789"

# A piece of text that a system's memory compressor cannot fold: letters
# drawn by a linear congruential generator (the constants of Knuth's MMIX),
# so the memory a `grow` holds stays in RAM as written rather than shrinking
# under pressure, and the monitor reads it as resident.
function piece() -> str
    letters: [str] @= []
    state: i64 @= 12_345

    for _ in range(from: 0, to: PIECE)
        state @ (state * 1_103_515_245 + 12_345) % 2_147_483_648
        at = (state >> 16) % 36
        letters @ letters.push(LETTERS.slice(from: at, to: at + 1))

    return letters.join("")

# Runs as a service named `name` until its input says `stop` or `exit`, or
# the system ends it.
#
# - `name`: the name it says its lines with.
function serve(name: str) -> i64
    print(f"{name}: ready")
    held: str @= ""
    stubborn: bool @= false
    reader @= io.reader(io.stdin())

    while true
        line = match io.read_line(@reader)
            .ok l  => strings.trim(l)
            .err _ => break

        words = strings.words(line)

        if words.len() == 0
            continue

        match words[0]
            "grow" =>
                mib = numbers.parse_int(second(words, absent: "0")).default(0)

                if mib > 0
                    held @ repeat(piece(), to_u64(mib * 16).default(0))
                print(f"{name}: holding {held.len() / 1_048_576} MiB")
            "release" =>
                held @ ""
                print(f"{name}: released")
            "exit" =>
                code = numbers.parse_int(second(words, absent: "1")).default(1)
                print(f"{name}: exiting with code {code}")
                return code
            "stubborn" =>
                stubborn @ true
                print(f"{name}: no longer heeds a stop")
            "stop" =>
                if !stubborn
                    print(f"{name}: stopping")
                    return 0
            _ => print(f"{name}: no command \"{words[0]}\"")

    # Its input is gone: it runs until the system ends it.
    while true
        time.sleep(time.milliseconds(100))

# The second word of `words`, `absent` where there is none.
#
# - `words`: a line's words.
# - `absent`: what an absent word reads as.
function second(words: [str], absent: str) -> str
    if words.len() > 1
        return words[1]
    return absent

# Appends the alert the monitor writes on the input to `file`, one line:
# `firing service-down[db] (critical) at 2026-11-22T09:04:30Z: a service is
# down`. Answers the exit code: 0, or 1 where the input is no alert or the
# file cannot be written, the reason on the standard error.
#
# - `file`: the file appended to.
function notify(file: str) -> i64
    text = match io.read_all_text(io.stdin())
        .ok t  => t
        .err e => return complain(f"no alert on the input: {e.msg}")

    match line_of(text)
        .err e => return complain(e.msg)
        .ok line =>
            match fs.append_text(path: file, text: line + "\n")
                .ok _  => return 0
                .err e => return complain(f"cannot write {file}: {e.msg}")

# The line a notifier writes for the alert `text` holds. Fails `invalid`
# where it is none.
#
# - `text`: the alert as JSON.
function line_of(text: str) -> str?
    v = json.parse(text)?
    state = json.text_of(json.member(v, key: "state")?)?
    alert = json.text_of(json.member(v, key: "alert")?)?
    severity = json.text_of(json.member(v, key: "severity")?)?
    at = json.text_of(json.member(v, key: "at")?)?
    summary = json.text_of(json.member(v, key: "summary")?)?
    return ok(f"{state} {alert} ({severity}) at {at}: {summary}")

# Writes `message` on the standard error and answers 1.
#
# - `message`: what went wrong.
function complain(message: str) -> i64
    errors.ignore(io.write_line(io.stderr(), line: "monitor workload: " + message))
    return 1

test "piece: 64 KiB of letters, the same on every run"
    p = piece()
    assert p.len() == PIECE
    assert p == piece()
    assert p.slice(from: 0, to: 8) != p.slice(from: 8, to: 16)

test "line_of: the alert in one line, and a text that is no alert"
    text = "{\"alert\":\"down[db]\",\"rule\":\"down\",\"state\":\"firing\",\"severity\":\"critical\",\"summary\":\"a service is down\",\"at\":\"2026-11-22T09:04:30Z\"}"
    assert line_of(text).must() == "firing down[db] (critical) at 2026-11-22T09:04:30Z: a service is down"
    assert line_of("{}").is_err()
