Kite's language server, driven by a client stand-in over two pipes.
The client opens shapes.kite, listed here with its lines numbered from 0, as the protocol numbers them:

  0 | # Shapes on a grid: the document the demo's editor opens.
  1 | 
  2 | # A point on the grid.
  3 | record Point {
  4 |     x: Int,
  5 |     y: Int,
  6 | }
  7 | 
  8 | # A box, from its lower left corner and its size.
  9 | record Box {
 10 |     corner: Point,
 11 |     width: Int,
 12 |     height: Int,
 13 | }
 14 | 
 15 | # The square of the distance between two points.
 16 | fn dist2(a: Point, b: Point) -> Int {
 17 |     let dx = a.x - b.x;
 18 |     let dy = a.y - b.y;
 19 |     dx * dx + dy * dy
 20 | }
 21 | 
 22 | # Whether `p` stands inside `b`.
 23 | fn contains(b: Box, p: Point) -> Bool {
 24 |     let right = b.corner.x + b.width;
 25 |     let top = b.corner.y + b.height;
 26 |     p.x >= b.corner.x && p.x < right && p.y >= b.corner.y && p.y < top
 27 | }
 28 | 
 29 | # A name for where `p` stands.
 30 | fn label(p: Point) -> Str {
 31 |     if p.x == 0 && p.y == 0 { "🎯 origin" } else { "🎯 " ++ show(dist(p, Point { x: 0, y: 0 })) }
 32 | }
 33 | 
 34 | # How many points `b` holds.
 35 | fn area(b: Box) -> Int {
 36 |     b.width * b.heigth
 37 | }

== 1. A request before `initialize`
   The server serves nothing yet, and says so with the protocol's own code.
--> {"jsonrpc":"2.0","id":1,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":3,"character":7}}}
<-- {"jsonrpc":"2.0","id":1,"error":{"code":-32002,"message":"`textDocument/hover` before `initialize`"}}

== 2. `initialize`
   The client offers UTF-16 alone for places; the server takes it and lists what it serves.
--> {"jsonrpc":"2.0","id":2,"method":"initialize","params":{"processId":null,"clientInfo":{"name":"demo-client","version":"1.0"},"rootUri":null,"capabilities":{"general":{"positionEncodings":["utf-16"]}}}}
<-- {"jsonrpc":"2.0","id":2,"result":{"capabilities":{"positionEncoding":"utf-16","textDocumentSync":{"openClose":true,"change":2},"hoverProvider":true,"definitionProvider":true,"referencesProvider":true,"renameProvider":{"prepareProvider":true},"completionProvider":{"triggerCharacters":["."]},"documentSymbolProvider":true,"documentFormattingProvider":true,"codeActionProvider":{"codeActionKinds":["quickfix"]}},"serverInfo":{"name":"kite-langserver","version":"0.1.0"}}}

== 3. `initialized`
   The server may now speak first: it says in the client's log that it is ready.
--> {"jsonrpc":"2.0","method":"initialized","params":{}}
<-- {"jsonrpc":"2.0","method":"window/logMessage","params":{"type":3,"message":"kite-langserver 0.1.0 serves demo-client, places counted in utf-16"}}

== 4. The client opens shapes.kite
   The text travels whole (shown above); the server answers with two errors and their places.
--> {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///demo/shapes.kite","languageId":"kite","version":1,"text":"<the 867 bytes listed above>"}}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":1,"diagnostics":[{"range":{"start":{"line":31,"character":65},"end":{"line":31,"character":69}},"severity":1,"code":"unknown_name","source":"kite","message":"no value named `dist`; did you mean `dist2`?"},{"range":{"start":{"line":36,"character":16},"end":{"line":36,"character":22}},"severity":1,"code":"unknown_name","source":"kite","message":"no field of `Box` named `heigth`; did you mean `height`?"}]}}

== 5. The quick fix for `dist`
   The client asks what fixes line 31, takes the action the server prefers, and sends its edit as a change.
--> {"jsonrpc":"2.0","id":3,"method":"textDocument/codeAction","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"range":{"start":{"line":31,"character":0},"end":{"line":32,"character":0}}}}
<-- {"jsonrpc":"2.0","id":3,"result":[{"title":"Replace with `dist2`","kind":"quickfix","diagnostics":[{"range":{"start":{"line":31,"character":65},"end":{"line":31,"character":69}},"severity":1,"code":"unknown_name","source":"kite","message":"no value named `dist`; did you mean `dist2`?"}],"isPreferred":true,"edit":{"changes":{"file:///demo/shapes.kite":[{"range":{"start":{"line":31,"character":65},"end":{"line":31,"character":69}},"newText":"dist2"}]}}}]}
--> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///demo/shapes.kite","version":2},"contentChanges":[{"range":{"start":{"line":31,"character":65},"end":{"line":31,"character":69}},"text":"dist2"}]}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":2,"diagnostics":[{"range":{"start":{"line":36,"character":16},"end":{"line":36,"character":22}},"severity":1,"code":"unknown_name","source":"kite","message":"no field of `Box` named `heigth`; did you mean `height`?"}]}}

== 6. The client fixes `heigth` by hand
   One change, its range counted on line 36; the server finds nothing wrong any more.
--> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///demo/shapes.kite","version":3},"contentChanges":[{"range":{"start":{"line":36,"character":16},"end":{"line":36,"character":22}},"text":"height"}]}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":3,"diagnostics":[]}}

== 7. Hover
   On `dist2`, after two emoji on its line: it begins at character 65 in UTF-16, 63 in code points, 69 in bytes. Then on the binding `right`.
--> {"jsonrpc":"2.0","id":4,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":31,"character":67}}}
<-- {"jsonrpc":"2.0","id":4,"result":{"contents":{"kind":"markdown","value":"```kite\nfn dist2(a: Point, b: Point) -> Int\n```\n\nThe square of the distance between two points."},"range":{"start":{"line":31,"character":65},"end":{"line":31,"character":70}}}}
--> {"jsonrpc":"2.0","id":5,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":26,"character":32}}}
<-- {"jsonrpc":"2.0","id":5,"result":{"contents":{"kind":"markdown","value":"```kite\nlet right: Int\n```\n\nA binding in `contains`."},"range":{"start":{"line":26,"character":31},"end":{"line":26,"character":36}}}}

== 8. Go to definition
   From the call of `dist2` to its declaration on line 16.
--> {"jsonrpc":"2.0","id":6,"method":"textDocument/definition","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":31,"character":65}}}
<-- {"jsonrpc":"2.0","id":6,"result":{"uri":"file:///demo/shapes.kite","range":{"start":{"line":16,"character":3},"end":{"line":16,"character":8}}}}

== 9. Find references
   Every place the field `x` of `Point` stands, its declaration included, whatever expression it is read through.
--> {"jsonrpc":"2.0","id":7,"method":"textDocument/references","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":26,"character":6},"context":{"includeDeclaration":true}}}
<-- {"jsonrpc":"2.0","id":7,"result":[{"uri":"file:///demo/shapes.kite","range":{"start":{"line":4,"character":4},"end":{"line":4,"character":5}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":17,"character":15},"end":{"line":17,"character":16}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":17,"character":21},"end":{"line":17,"character":22}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":24,"character":25},"end":{"line":24,"character":26}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":26,"character":6},"end":{"line":26,"character":7}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":26,"character":20},"end":{"line":26,"character":21}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":26,"character":27},"end":{"line":26,"character":28}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":31,"character":9},"end":{"line":31,"character":10}}},{"uri":"file:///demo/shapes.kite","range":{"start":{"line":31,"character":82},"end":{"line":31,"character":83}}}]}

== 10. Rename `dx` to `delta_x`
   The server checks the name can be taken, answers one edit per place, and the client sends them as one change, last first.
--> {"jsonrpc":"2.0","id":8,"method":"textDocument/prepareRename","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":17,"character":8}}}
<-- {"jsonrpc":"2.0","id":8,"result":{"range":{"start":{"line":17,"character":8},"end":{"line":17,"character":10}},"placeholder":"dx"}}
--> {"jsonrpc":"2.0","id":9,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":17,"character":8},"newName":"delta_x"}}
<-- {"jsonrpc":"2.0","id":9,"result":{"changes":{"file:///demo/shapes.kite":[{"range":{"start":{"line":17,"character":8},"end":{"line":17,"character":10}},"newText":"delta_x"},{"range":{"start":{"line":19,"character":4},"end":{"line":19,"character":6}},"newText":"delta_x"},{"range":{"start":{"line":19,"character":9},"end":{"line":19,"character":11}},"newText":"delta_x"}]}}}
--> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///demo/shapes.kite","version":4},"contentChanges":[{"range":{"start":{"line":19,"character":9},"end":{"line":19,"character":11}},"text":"delta_x"},{"range":{"start":{"line":19,"character":4},"end":{"line":19,"character":6}},"text":"delta_x"},{"range":{"start":{"line":17,"character":8},"end":{"line":17,"character":10}},"text":"delta_x"}]}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":4,"diagnostics":[]}}

== 11. Two renames refused
   `dy` cannot take a name its function binds already, and `area` cannot become a keyword.
--> {"jsonrpc":"2.0","id":10,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":18,"character":8},"newName":"delta_x"}}
<-- {"jsonrpc":"2.0","id":10,"error":{"code":-32803,"message":"`delta_x` is the name of the binding in `dist2` already"}}
--> {"jsonrpc":"2.0","id":11,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":35,"character":3},"newName":"let"}}
<-- {"jsonrpc":"2.0","id":11,"error":{"code":-32602,"message":"`let` is no name Kite can bind: a letter or `_`, then letters, digits and `_`, and no keyword"}}

== 12. Completion after a `.`
   The client types `+ b.corner.` at the end of `area`: one error while the name is missing, the fields of `Point` offered, and the typing undone.
--> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///demo/shapes.kite","version":5},"contentChanges":[{"range":{"start":{"line":36,"character":22},"end":{"line":36,"character":22}},"text":" + b.corner."}]}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":5,"diagnostics":[{"range":{"start":{"line":37,"character":0},"end":{"line":37,"character":0}},"severity":1,"code":"expected_name","source":"kite","message":"expected a field's name after `.`, found `}`"}]}}
--> {"jsonrpc":"2.0","id":12,"method":"textDocument/completion","params":{"textDocument":{"uri":"file:///demo/shapes.kite"},"position":{"line":36,"character":34}}}
<-- {"jsonrpc":"2.0","id":12,"result":{"isIncomplete":false,"items":[{"label":"x","kind":5,"detail":"Int"},{"label":"y","kind":5,"detail":"Int"}]}}
--> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///demo/shapes.kite","version":6},"contentChanges":[{"range":{"start":{"line":36,"character":22},"end":{"line":36,"character":34}},"text":""}]}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","version":6,"diagnostics":[]}}

== 13. The outline
   Records with their fields, functions with their parameters and bindings, each with its range.
--> {"jsonrpc":"2.0","id":13,"method":"textDocument/documentSymbol","params":{"textDocument":{"uri":"file:///demo/shapes.kite"}}}
