r":19},"end":{"line":16,"character":27}},"selectionRange":{"start":{"line":16,"character":19},"end":{"line":16,"character":20}}},{"name":"delta_x","detail":"Int","kind":13,"range":{"start":{"line":17,"character":4},"end":{"line":17,"character":28}},"selectionRange":{"start":{"line":17,"character":8},"end":{"line":17,"character":15}}},{"name":"dy","detail":"Int","kind":13,"range":{"start":{"line":18,"character":4},"end":{"line":18,"character":23}},"selectionRange":{"start":{"line":18,"character":8},"end":{"line":18,"character":10}}}]},{"name":"contains","detail":"fn contains(b: Box, p: Point) -> Bool","kind":12,"range":{"start":{"line":23,"character":0},"end":{"line":27,"character":1}},"selectionRange":{"start":{"line":23,"character":3},"end":{"line":23,"character":11}},"children":[{"name":"b","detail":"Box","kind":13,"range":{"start":{"line":23,"character":12},"end":{"line":23,"character":18}},"selectionRange":{"start":{"line":23,"character":12},"end":{"line":23,"character":13}}},{"name":"p","detail":"Point","kind":13,"range":{"start":{"line":23,"character":20},"end":{"line":23,"character":28}},"selectionRange":{"start":{"line":23,"character":20},"end":{"line":23,"character":21}}},{"name":"right","detail":"Int","kind":13,"range":{"start":{"line":24,"character":4},"end":{"line":24,"character":37}},"selectionRange":{"start":{"line":24,"character":8},"end":{"line":24,"character":13}}},{"name":"top","detail":"Int","kind":13,"range":{"start":{"line":25,"character":4},"end":{"line":25,"character":36}},"selectionRange":{"start":{"line":25,"character":8},"end":{"line":25,"character":11}}}]},{"name":"label","detail":"fn label(p: Point) -> Str","kind":12,"range":{"start":{"line":30,"character":0},"end":{"line":32,"character":1}},"selectionRange":{"start":{"line":30,"character":3},"end":{"line":30,"character":8}},"children":[{"name":"p","detail":"Point","kind":13,"range":{"start":{"line":30,"character":9},"end":{"line":30,"character":17}},"selectionRange":{"start":{"line":30,"character":9},"end":{"line":30,"character":10}}}]},{"name":"area","detail":"fn area(b: Box) -> Int","kind":12,"range":{"start":{"line":35,"character":0},"end":{"line":37,"character":1}},"selectionRange":{"start":{"line":35,"character":3},"end":{"line":35,"character":7}},"children":[{"name":"b","detail":"Box","kind":13,"range":{"start":{"line":35,"character":8},"end":{"line":35,"character":14}},"selectionRange":{"start":{"line":35,"character":8},"end":{"line":35,"character":9}}}]}]}

== 14. The client opens messy.kite
   A source written in a hurry, listed below; it holds one binding never read, a warning the editor fades.

  0 | # A sum, written in a hurry: the document the demo formats.
  1 | record Pair{left:Int,right:Int}
  2 | fn sum( p:Pair )->Int{
  3 |   let total=p.left+p.right;
  4 |       let unused = 0;
  5 |   # what it answers
  6 |   let answer = (total);
  7 |     answer}
--> {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///demo/messy.kite","languageId":"kite","version":1,"text":"# A sum, written in a hurry: the document the demo formats.\nrecord Pair{left:Int,right:Int}\nfn sum( p:Pair )->Int{\n  let total=p.left+p.right;\n      let unused = 0;\n  # what it answers\n  let answer = (total);\n    answer}\n"}}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/messy.kite","version":1,"diagnostics":[{"range":{"start":{"line":4,"character":10},"end":{"line":4,"character":16}},"severity":2,"code":"unused_binding","source":"kite","message":"`unused` is never read; name it `_unused` if that is meant","tags":[1]}]}}

== 15. Formatting messy.kite
   The fewest whole-line edits that make it Kite's one layout; the client makes them, giving this text:
--> {"jsonrpc":"2.0","id":14,"method":"textDocument/formatting","params":{"textDocument":{"uri":"file:///demo/messy.kite"},"options":{"tabSize":4,"insertSpaces":true}}}
<-- {"jsonrpc":"2.0","id":14,"result":[{"range":{"start":{"line":1,"character":0},"end":{"line":8,"character":0}},"newText":"record Pair {\n    left: Int,\n    right: Int,\n}\n\nfn sum(p: Pair) -> Int {\n    let total = p.left + p.right;\n    let unused = 0;\n    # what it answers\n    let answer = total;\n    answer\n}\n"}]}

  0 | # A sum, written in a hurry: the document the demo formats.
  1 | record Pair {
  2 |     left: Int,
  3 |     right: Int,
  4 | }
  5 | 
  6 | fn sum(p: Pair) -> Int {
  7 |     let total = p.left + p.right;
  8 |     let unused = 0;
  9 |     # what it answers
 10 |     let answer = total;
 11 |     answer
 12 | }

== 16. What the server does not serve, and a frame that is not JSON
   Each refused with the code JSON-RPC gives it; the session goes on.
--> {"jsonrpc":"2.0","id":15,"method":"textDocument/foldingRange","params":{"textDocument":{"uri":"file:///demo/shapes.kite"}}}
<-- {"jsonrpc":"2.0","id":15,"error":{"code":-32601,"message":"no method `textDocument/foldingRange`"}}
--> {"jsonrpc": "2.0", "id": 99, "method":
<-- {"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"Parse error","data":"line 1, column 39: expected a value, found the end of the text"}}

== 17. The client closes shapes.kite
   The server clears what it showed for it.
--> {"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///demo/shapes.kite"}}}
<-- {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///demo/shapes.kite","diagnostics":[]}}

== 18. `shutdown`, then `exit`
   The server answers `null`, then ends with status 0, as the protocol asks after a `shutdown`.
--> {"jsonrpc":"2.0","id":16,"method":"shutdown"}
<-- {"jsonrpc":"2.0","id":16,"result":null}
--> {"jsonrpc":"2.0","method":"exit"}

The server exited with code 0, nothing on its standard error.
