# `textDocument/definition` and `textDocument/references`: where the name
# under the cursor is declared, and every place it stands. A field read
# through any expression is its record's field, since the checker resolved
# it by the expression's type, and a binding shadowing another is only
# itself. Kite's own names are declared nowhere in the source: their
# definition is `null`.

use <rebel>/json

use lang/queries
use lang/symbols
use lang/syntax
use lsp/document
use lsp/server
use lsp/wire

# The protocol's `Location` of `span` in `doc`.
#
# - `doc`: the document.
# - `span`: bytes of its text.
# - `s`: the server, whose unit counts characters.
function location(doc: document.Document lent, span: syntax.Span, s: server.Server lent) -> json.Value
    return wire.object(
        {"uri": wire.text(doc.uri), "range": wire.range_json(document.range_of(doc, span: span, e: s.encoding))}
    )

# Answers `textDocument/definition`.
#
# - `s`: the server, only read.
# - `params`: `textDocument` and `position`.
#
# Fails `invalid` where those are missing, `failed` where the document is not
# open.
function definition(s: server.Server lent, params: json.Value) -> json.Value?
    doc = server.document_named(s, params: params)?
    at = server.offset_named(s, doc: doc, params: params)?

    match queries.symbol_at(doc.analysis, at: at)
        .ok k =>
            found = doc.analysis.symbols[k]

            if symbols.is_declared(found)
                return ok(location(doc, span: found.span, s: s))
            return ok(wire.nothing())
        .err _ => return ok(wire.nothing())

# Answers `textDocument/references`: every place, in source order.
#
# - `s`: the server, only read.
# - `params`: `textDocument`, `position`, and `context.includeDeclaration`,
#   false where it is missing.
#
# Fails `invalid` where those are missing, `failed` where the document is not
# open.
function references(s: server.Server lent, params: json.Value) -> json.Value?
    doc = server.document_named(s, params: params)?
    at = server.offset_named(s, doc: doc, params: params)?

    declaration = match json.value_at(params, pointer: "/context/includeDeclaration")
        .ok v  => json.bool_of(v).default(false)
        .err _ => false

    found: [json.Value] @= []

    match queries.symbol_at(doc.analysis, at: at)
        .ok k =>
            for place in queries.places_of(doc.analysis, symbol: k, declaration: declaration)
                found @ found.push(location(doc, span: place, s: s))
        .err _ => _ = 0

    return ok(wire.array(found))

## Tests

test "definition and references: a field read through a binding"
    s @= server.new_server()
    text = "record P { x: Int }\nfn f(p: P) -> Int { let q = p; q.x + p.x }"
    s.documents["u"] @ document.open(uri: "u", version: 1, text: text)
    at_x = json.parse("{\"textDocument\": {\"uri\": \"u\"}, \"position\": {\"line\": 1, \"character\": 33}}").must()
    there = definition(s, params: at_x).must()
    assert json.value_at(there, pointer: "/range/start/character").must() == wire.number(11)
    asked = json.parse(
        "{\"textDocument\": {\"uri\": \"u\"}, \"position\": {\"line\": 0, \"character\": 11}, \"context\": {\"includeDeclaration\": true}}"
    ).must()
    assert json.items_of(references(s, params: asked).must()).must().len() == 3

test "definition: Kite's own name, nothing at all, and a document not open"
    s @= server.new_server()
    s.documents["u"] @ document.open(uri: "u", version: 1, text: "fn f() -> Int { len(\"ab\") }")
    on_len = json.parse("{\"textDocument\": {\"uri\": \"u\"}, \"position\": {\"line\": 0, \"character\": 17}}").must()
    assert definition(s, params: on_len).must() == wire.nothing()
    on_space = json.parse("{\"textDocument\": {\"uri\": \"u\"}, \"position\": {\"line\": 0, \"character\": 2}}").must()
    assert definition(s, params: on_space).must() == wire.nothing()
    other = json.parse("{\"textDocument\": {\"uri\": \"v\"}, \"position\": {\"line\": 0, \"character\": 0}}").must()
    assert definition(s, params: other).is_err()
