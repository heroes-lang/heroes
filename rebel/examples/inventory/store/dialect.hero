# The SQL text each database reads, made from the one text `sql/build`
# writes. `sql/build` writes standard SQL's double-quoted names and SQLite's
# numbered placeholders `?1`, `?2`; MySQL and MariaDB read a double-quoted
# text as a string (unless `ANSI_QUOTES` is on, which a program cannot count
# on) and number no placeholder, and ODBC's placeholder is a bare `?`. So
# the MySQL store's statements are re-spelt with backquoted names, and both
# stores' placeholders are written bare, which is possible because
# `sql/build` numbers its placeholders in the order they stand, each once:
# this module checks that it did, rather than trusting it. `sql/build`'s
# ledger names MySQL's text as not written yet; this module is what a
# program writes meanwhile.
#
# The schema's statements are written here too (`create_tables`), since
# `sql/build` makes no table: one text for both databases, the names quoted
# by the dialect, the types those both read (`VARCHAR`, `BIGINT`), and no
# `AUTO_INCREMENT`, every key being a UUID the program makes.

use <rebel>/sql/build

## Codes

# The code of a text that cannot be re-spelt: a placeholder out of order or
# used twice, a name never closed.
constant UNSUPPORTED: str
    "unsupported"

## Dialects

# The database a statement is written for.
variant Dialect
    # MySQL and MariaDB: backquoted names, bare `?`.
    mysql
    # Any database through ODBC: standard SQL's double-quoted names, bare `?`.
    odbc

# The text of `s` as `dialect` reads it.
#
# - `s`: a statement `build.to_sql` wrote for `.sqlite`.
# - `dialect`: the database.
#
# Fails `unsupported` where a placeholder is not the next number, so a bare
# `?` would take another value than `s` means, or where the count of
# placeholders is not `s.params`'s; and where a quoted name never closes.
function text_for(s: build.Statement, dialect: Dialect) -> str?
    text = s.text
    out: [str] @= []
    at @= 0
    piece @= 0
    placeholders @= 0

    while at < text.len()
        c = text[at]

        if c == '"'
            close = closing_quote(text, from: at)?
            out @ out.push(text.slice(from: piece, to: at))
            out @ out.push(quote_name(unquote(text.slice(from: at + 1, to: close)), dialect: dialect))
            at @ close + 1
            piece @ at
        else if c == '\''
            close = closing_single(text, from: at)?
            at @ close + 1
        else if c == '?'
            digits_end @= at + 1

            while digits_end < text.len() && text[digits_end] >= '0' && text[digits_end] <= '9'
                digits_end @ digits_end + 1

            if digits_end == at + 1
                return fail(code: UNSUPPORTED, msg: f"a bare ? at byte {at} of {text}")
            number = text.slice(from: at + 1, to: digits_end)
            placeholders @ placeholders + 1

            if number != f"{placeholders}"
                return fail(code: UNSUPPORTED, msg: f"placeholder ?{number} where ?{placeholders} is next, in {text}")
            out @ out.push(text.slice(from: piece, to: at))
            out @ out.push("?")
            at @ digits_end
            piece @ at
        else
            at @ at + 1

    if placeholders != s.params.len()
        return fail(code: UNSUPPORTED, msg: f"{placeholders} placeholders for {s.params.len()} values in {text}")
    out @ out.push(text.slice(from: piece, to: text.len()))
    return ok(out.join(""))

# `name` quoted as `dialect` reads a name.
#
# - `name`: the name, as it is stored.
# - `dialect`: the database.
function quote_name(name: str, dialect: Dialect) -> str
    return match dialect
        .mysql => "`" + name.replace_backquotes() + "`"
        .odbc  => "\"" + double_quotes(name) + "\""

# `name` with each backquote doubled, as a backquoted name holds one.
#
# - `name`: the name.
function replace_backquotes(name: str) -> str
    parts: [str] @= []

    for c in name.chars()
        if c == "`"
            parts @ parts.push("``")
        else
            parts @ parts.push(c)

    return parts.join("")

# `name` with each double quote doubled.
#
# - `name`: the name.
function double_quotes(name: str) -> str
    parts: [str] @= []

    for c in name.chars()
        if c == "\""
            parts @ parts.push("\"\"")
        else
            parts @ parts.push(c)

    return parts.join("")

# The text inside a double-quoted name with each doubled quote made one.
#
# - `quoted`: what stands between the quotes.
function unquote(quoted: str) -> str
    parts: [str] @= []
    at @= 0

    while at < quoted.len()
        if quoted[at] == '"' && at + 1 < quoted.len() && quoted[at + 1] == '"'
            parts @ parts.push("\"")
            at @ at + 2
        else
            next = next_char_end(quoted, at: at)
            parts @ parts.push(quoted.slice(from: at, to: next))
            at @ next

    return parts.join("")

# The index just past the character that begins at `at` of `s`.
#
# - `s`: the text.
# - `at`: where a character begins.
function next_char_end(s: str, at: i64) -> i64
    end @= at + 1

    while end < s.len() && s[end] >= 0x80 && s[end] < 0xc0
        end @ end + 1

    return end

# The index of the quote that closes the double-quoted name opening at
# `from`, a doubled quote inside it read as one.
#
# - `text`: the statement.
# - `from`: the index of the opening quote.
#
# Fails `unsupported` where none closes it.
function closing_quote(text: str, from: i64) -> i64?
    at @= from + 1

    while at < text.len()
        if text[at] == '"'
            if at + 1 < text.len() && text[at + 1] == '"'
                at @ at + 2
            else
                return ok(at)
        else
            at @ at + 1

    return fail(code: UNSUPPORTED, msg: f"a name never closed at byte {from} of {text}")

# The index of the quote that closes the string opening at `from`.
#
# - `text`: the statement.
# - `from`: the index of the opening quote.
#
# Fails `unsupported` where none closes it.
function closing_single(text: str, from: i64) -> i64?
    at @= from + 1

    while at < text.len()
        if text[at] == '\''
            if at + 1 < text.len() && text[at + 1] == '\''
                at @ at + 2
            else
                return ok(at)
        else
            at @ at + 1

    return fail(code: UNSUPPORTED, msg: f"a string never closed at byte {from} of {text}")

## The schema

# The statements that make the inventory's tables where they are not there
# yet, in the order they must run: a table before the tables naming it.
#
# - `dialect`: the database.
#
# Each is one statement, run alone, since several in one text need a
# connection's option that MySQL's text protocol leaves off by default.
function create_tables(dialect: Dialect) -> [str]
    n = dialect
    return [
        table(n, name: "locations", body: [column(n, name: "id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "code", kind: "VARCHAR(32) NOT NULL"), column(n, name: "name", kind: "VARCHAR(200) NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["id"]), key(n, kind: "UNIQUE", columns: ["code"])])
        table(n, name: "products", body: [column(n, name: "id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "code", kind: "VARCHAR(32) NOT NULL"), column(n, name: "name", kind: "VARCHAR(200) NOT NULL"), column(n, name: "category", kind: "VARCHAR(200) NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["id"]), key(n, kind: "UNIQUE", columns: ["code"])])
        table(n, name: "variants", body: [column(n, name: "id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "product_id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "sku", kind: "VARCHAR(32) NOT NULL"), column(n, name: "label", kind: "VARCHAR(200) NOT NULL"), column(n, name: "price_cents", kind: "BIGINT NOT NULL"), column(n, name: "units", kind: "BIGINT NOT NULL"), column(n, name: "value_cents", kind: "BIGINT NOT NULL"), column(n, name: "applied_seq", kind: "BIGINT NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["id"]), key(n, kind: "UNIQUE", columns: ["sku"]), foreign(n, column_name: "product_id", table_name: "products")])
        table(n, name: "stock", body: [column(n, name: "variant_id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "location_id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "on_hand", kind: "BIGINT NOT NULL"), column(n, name: "reorder_point", kind: "BIGINT NOT NULL"), column(n, name: "reorder_quantity", kind: "BIGINT NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["variant_id", "location_id"]), foreign(n, column_name: "variant_id", table_name: "variants"), foreign(n, column_name: "location_id", table_name: "locations")])
        table(n, name: "movements", body: [column(n, name: "id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "seq", kind: "BIGINT NOT NULL"), column(n, name: "at", kind: "VARCHAR(20) NOT NULL"), column(n, name: "kind", kind: "VARCHAR(16) NOT NULL"), column(n, name: "variant_id", kind: "VARCHAR(36) NOT NULL"), column(n, name: "from_location", kind: "VARCHAR(36) NOT NULL"), column(n, name: "to_location", kind: "VARCHAR(36) NOT NULL"), column(n, name: "quantity", kind: "BIGINT NOT NULL"), column(n, name: "unit_cost_cents", kind: "BIGINT NOT NULL"), column(n, name: "unit_price_cents", kind: "BIGINT NOT NULL"), column(n, name: "revenue_cents", kind: "BIGINT NOT NULL"), column(n, name: "value_cents", kind: "BIGINT NOT NULL"), column(n, name: "reason", kind: "VARCHAR(200) NOT NULL"), column(n, name: "reference", kind: "VARCHAR(200) NOT NULL"), column(n, name: "actor", kind: "VARCHAR(200) NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["id"]), key(n, kind: "UNIQUE", columns: ["seq"]), foreign(n, column_name: "variant_id", table_name: "variants")])
        table(n, name: "audit", body: [column(n, name: "seq", kind: "BIGINT NOT NULL"), column(n, name: "at", kind: "VARCHAR(20) NOT NULL"), column(n, name: "actor", kind: "VARCHAR(200) NOT NULL"), column(n, name: "action", kind: "VARCHAR(32) NOT NULL"), column(n, name: "subject", kind: "VARCHAR(200) NOT NULL"), column(n, name: "detail", kind: "VARCHAR(500) NOT NULL"), key(n, kind: "PRIMARY KEY", columns: ["seq"])])
    ]

# A `CREATE TABLE IF NOT EXISTS` of `name` with `body`'s lines.
#
# - `dialect`: the database.
# - `name`: the table's name.
# - `body`: its columns and keys, each written.
function table(dialect: Dialect, name: str, body: [str]) -> str
    return "CREATE TABLE IF NOT EXISTS " + quote_name(name, dialect: dialect) + " (" + body.join(", ") + ")"

# A column of a table.
#
# - `dialect`: the database.
# - `name`: the column's name.
# - `kind`: its type and constraint, as both databases read them.
function column(dialect: Dialect, name: str, kind: str) -> str
    return quote_name(name, dialect: dialect) + " " + kind

# A key of a table over `columns`.
#
# - `dialect`: the database.
# - `kind`: `PRIMARY KEY` or `UNIQUE`.
# - `columns`: the columns it is made of.
function key(dialect: Dialect, kind: str, columns: [str]) -> str
    quoted: [str] @= []

    for c in columns
        quoted @ quoted.push(quote_name(c, dialect: dialect))

    return kind + " (" + quoted.join(", ") + ")"

# A foreign key from `column_name` to the `id` of `table_name`: a table-level
# constraint, the one form MySQL's InnoDB enforces (a `REFERENCES` beside a
# column it reads and ignores).
#
# - `dialect`: the database.
# - `column_name`: the column holding the key.
# - `table_name`: the table it names a row of.
function foreign(dialect: Dialect, column_name: str, table_name: str) -> str
    return "FOREIGN KEY (" + quote_name(column_name, dialect: dialect) + ") REFERENCES " + quote_name(table_name, dialect: dialect) + " (" + quote_name("id", dialect: dialect) + ")"

test "text_for: names backquoted and placeholders bare for MySQL"
    s = build.Statement(
        text: "SELECT \"sku\" FROM \"variants\" WHERE \"id\" = ?1 AND \"units\" >= ?2",
        params: [.text(v: "a"), .integer(v: 1)]
    )
    assert text_for(s, dialect: .mysql).must() == "SELECT `sku` FROM `variants` WHERE `id` = ? AND `units` >= ?"
    assert text_for(s, dialect: .odbc).must() == "SELECT \"sku\" FROM \"variants\" WHERE \"id\" = ? AND \"units\" >= ?"

test "text_for: a doubled quote and a backquote inside a name"
    s = build.Statement(text: "SELECT \"a\"\"b`c\" FROM \"t\"", params: [])
    assert text_for(s, dialect: .mysql).must() == "SELECT `a\"b``c` FROM `t`"
    assert text_for(s, dialect: .odbc).must() == "SELECT \"a\"\"b`c\" FROM \"t\""

test "text_for: a placeholder out of order, used twice, or bare is refused, and so is a count that differs"
    assert text_for(
        build.Statement(text: "SELECT ?2, ?1", params: [.integer(v: 1), .integer(v: 2)]),
        dialect: .odbc
    ).is_err()
    assert text_for(build.Statement(text: "SELECT ?1, ?1", params: [.integer(v: 1)]), dialect: .odbc).is_err()
    assert text_for(build.Statement(text: "SELECT ?", params: [.integer(v: 1)]), dialect: .odbc).is_err()
    assert text_for(build.Statement(text: "SELECT ?1", params: []), dialect: .odbc).is_err()
    assert text_for(build.Statement(text: "SELECT \"open", params: []), dialect: .mysql).is_err()

test "text_for: what sql/build writes for an update with a guard"
    u @= build.update("stock", set: [build.assign("on_hand", .integer(v: 7))])
    u.where @ [build.equal("variant_id", .text(v: "v")), build.equal("on_hand", .integer(v: 9))]
    s = build.to_sql(.update(query: u), .sqlite).must()
    assert text_for(s, dialect: .mysql).must() == "UPDATE `stock` SET `on_hand` = ? WHERE `variant_id` = ? AND `on_hand` = ?"

test "create_tables: six tables, each made only where it is not there"
    made = create_tables(.mysql)
    assert made.len() == 6
    assert made[0] == "CREATE TABLE IF NOT EXISTS `locations` (`id` VARCHAR(36) NOT NULL, `code` VARCHAR(32) NOT NULL, `name` VARCHAR(200) NOT NULL, PRIMARY KEY (`id`), UNIQUE (`code`))"
