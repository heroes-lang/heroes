# How a stand-in started on a thread tells the demo it is ready, and on
# which port: the demo makes a mailbox (spec § 11) and hands it to the
# thread with the stand-in's setup; the stand-in, once it listens on a port
# the system chose, sends one `Ready` on it, as systemd's `sd_notify` tells
# a service's state, and closes it on every path, so a stand-in that could
# not listen is told at once as one that ended without saying so. The demo
# starts no store against a stand-in before its notice has come.
#
# A stand-in also tells, on a second mailbox, each connection it begins and
# ends, and the demo asks the program's stop only once every connection a
# stand-in began has ended (`await_idle`). The stop ends every wait at
# once, a read of a connection's last request among them, so a stop asked
# while a stand-in still reads would make its account count that request
# or not by timing; asked once the stand-in is idle, it ends only the wait
# for the next connection, and the account is the same on every run.

## Bounds

# How long the demo waits for a notice, in milliseconds.
constant NOTICE_MS: i64
    10_000

## Notices

# What a stand-in said once it was ready.
record Ready
    # Its name.
    service: str
    # The port it listens on.
    port: i64

# Tells the demo, through `to`, that `service` listens on `port`, and
# closes `to`: a stand-in says it once.
#
# - `to`: the mailbox the demo waits on.
# - `service`: the stand-in's name, one word.
# - `port`: the port it listens on.
#
# Fails `closed` or `stopped` where the demo no longer waits.
function tell(to: (mailbox Ready), service: str, port: i64) -> ()?
    sent = to.send(Ready(service: service, port: port))
    to.close()
    return sent

# The notice `from` receives, awaited `NOTICE_MS` at most.
#
# - `from`: the mailbox handed to the stand-in.
#
# Fails `closed` where the stand-in ended without saying it is ready,
# `timeout` where nothing came in time, and `stopped` where the program was
# asked to stop first.
function await_ready(from: (mailbox Ready)) -> Ready?
    match from.receive(within_ms: NOTICE_MS)
        .ok r => return ok(r)
        .err e =>
            if e.code == "closed"
                return fail(code: e.code, msg: "it ended without saying it is ready")
            return fail(code: e.code, msg: e.msg)

## Sessions

# What a stand-in tells of its connections as it serves them.
variant Session
    # A connection accepted, told before anything is written on it.
    began
    # A connection's conversation over: its client left, and every request
    # it sent was read and answered.
    ended

# Waits until the stand-in that tells on `from` has ended every connection
# it began. Every connection the demo made was accepted before the demo
# could use it, and a stand-in tells `began` before it writes its greeting,
# so once the demo has closed its own connections every `began` is already
# in `from`: the stand-in is idle when as many `ended` as `began` have come
# and nothing more is waiting.
#
# - `from`: the mailbox the stand-in tells its connections on.
# - `within_ms`: how long a connection still open may take to end, in
#   milliseconds.
#
# Fails `timeout` where a connection is still open after `within_ms` with
# nothing told; a closed mailbox, the stand-in having ended, is idle.
function await_idle(from: (mailbox Session), within_ms: i64) -> ()?
    open @= 0

    while true
        wait = if open > 0
            within_ms
        else
            0

        match from.receive(within_ms: wait)
            .ok told =>
                match told
                    .began => open @ open + 1
                    .ended => open @ open - 1
            .err e =>
                if e.code == "closed" || open == 0 && e.code == "timeout"
                    return ok()
                return fail(code: e.code, msg: f"{open} connections still open: {e.msg}")

test "tell and await_ready: the notice crosses whole, and a closed mailbox is told at once"
    m: (mailbox Ready) = mailbox()
    tell(m, service: "mysql", port: 3306).must()
    assert await_ready(m).must() == Ready(service: "mysql", port: 3306)
    assert await_ready(m).is_err()
    silent: (mailbox Ready) = mailbox()
    silent.close()
    assert await_ready(silent).is_err()

test "await_idle: idle once every connection begun has ended, a connection left open told"
    m: (mailbox Session) = mailbox()
    m.send(.began).must()
    m.send(.ended).must()
    m.send(.began).must()
    m.send(.ended).must()
    await_idle(m, within_ms: 10).must()
    still: (mailbox Session) = mailbox()
    still.send(.began).must()
    assert await_idle(still, within_ms: 10).is_err()
    gone: (mailbox Session) = mailbox()
    gone.send(.began).must()
    gone.close()
    await_idle(gone, within_ms: 10).must()
