# The twin of `examples/todo/`: a todo list kept in a file, written with
# Rebel. It prints byte for byte what `examples/todo/` prints from the same
# arguments, so that program's `main.expected` is this one's test too.
#
#     heroes run rebel/examples/todo/main.hero -- examples/todo/sample.todo
#     heroes run rebel/examples/todo/main.hero -- mine.todo add buy milk
#     heroes run rebel/examples/todo/main.hero -- mine.todo done 2
#
#     main.hero   the program: arguments, the file, the one write
#     list.hero   the list, the format, and every change to it
#
# What Rebel does here that `examples/todo/` writes for itself:
#
# - `numbers.parse_int` reads the number after `done`, in place of that
#   program's `numbers.hero` (`atoi`, its two cut-off constants and
#   `quoted`);
# - `strings.lines` and `strings.trim` read the file's lines and the text of a
#   task, in place of its `strings.hero` (`split_lines`, `trim_space`,
#   `space_ending`, `space_at`);
# - `lists.skip` takes the words after the command, in place of its loop in
#   `rest_of`.
#
# What stays this program's own is the list and its file: the one write is in
# `save`, and everything that decides WHAT to write is pure, in
# `list.hero`, so its tests never touch the disk; `complete` answers a new
# list because value semantics leaves nothing else it could answer.

use <rebel>/lists
use <rebel>/numbers

use list

## Error codes

# What `done` without a number, or with a word that is no number, fails with.
constant ERR_NO_NUMBER: str
    "no_number"

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"todo: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    given = text_arguments()

    if given.len() == 0
        print("usage: todo <file> [add TEXT… | done N]")
        exit(code: 2)

    match read_file(given[0])
        .err _   => stop("cannot read " + given[0])
        .ok text => run(text, given)

# Every unhappy ending in one place, so the exit code is decided once.
#
# - `message`: what is printed before the program ends with 1.
function stop(message: str)
    print(message)
    exit(code: 1)

# The list `text` holds, acted on as the command line asks.
#
# - `text`: the file's text.
# - `given`: the command line: the file, then the command and its words.
function run(text: str, given: [str])
    match list.read(text)
        .err e    => stop(e.code + ": " + e.msg)
        .ok tasks => act(tasks, given)

# The command the line names, done to `tasks`: none shows them, `add` adds
# one, `done` completes one.
#
# - `tasks`: the list as the file holds it.
# - `given`: the command line.
function act(tasks: [list.Task], given: [str])
    if given.len() == 1
        show(tasks)
        return
    command = given[1]

    if command == "add"
        match list.add(tasks, rest_of(given, 2))
            .err e    => stop(e.code + ": " + e.msg)
            .ok grown => save(grown, given[0])
    else if command == "done"
        match number_of(rest_of(given, 2))
            .err e => stop(e.code + ": " + e.msg)
            .ok n  => finish(tasks, n, given[0])
    else
        stop("no command `" + command + "` — say `add TEXT…` or `done N`")

# Task `n` completed, and the list saved.
#
# - `tasks`: the list.
# - `n`: the task's number as the list shows it, from 1.
# - `path`: the file the list is written back to.
function finish(tasks: [list.Task], n: i64, path: str)
    match list.complete(tasks, n)
        .err e    => stop(e.code + ": " + e.msg)
        .ok after => save(after, path)

# The only function in this program that writes anything.
#
# - `tasks`: the list to write.
# - `path`: the file it replaces.
function save(tasks: [list.Task], path: str)
    match write_file(path: path, text: list.render(tasks))
        .err _ => stop("cannot write " + path)
        .ok _  => show(tasks)

# The list as a person reads it, and how many are left.
#
# - `tasks`: the list.
function show(tasks: [list.Task])
    for line in list.numbered(tasks)
        print(line)

    print(list.left_to_do(tasks), " of ", tasks.len(), " left")

# Everything from `at` on, joined by a space, so `add buy milk` is one task and
# not two arguments the shell happened to split.
#
# - `given`: the command line.
# - `at`: the first word kept, from 0.
function rest_of(given: [str], at: i64) -> str
    return join(lists.skip(given, n: at), " ")

# The number of a task, as typed after `done`.
#
# - `word`: the words after `done`, joined.
#
# Fails `no_number` where it is empty or is no integer.
function number_of(word: str) -> i64?
    if word.len() == 0
        return fail(code: ERR_NO_NUMBER, msg: "`done` needs the number of a task")

    match numbers.parse_int(word)
        .ok n  => return ok(n)
        .err e => return fail(code: ERR_NO_NUMBER, msg: e.msg)

test "the sample lists the way the file reads"
    tasks = list.read(read_file("examples/todo/sample.todo").must()).must()
    assert tasks.len() == 4
    assert list.left_to_do(tasks) == 2
    assert list.numbered(tasks)[0] == "1. [x] write the corpus harness"

test "a task added is a task on disk, read back by a second reading"
    path = "build/twin-todo.txt"
    write_file(path: path, text: "[ ] one\n").must()
    first = list.read(read_file(path).must()).must()
    grown = list.add(first, "two").must()
    write_file(path: path, text: list.render(grown)).must()
    again = list.read(read_file(path).must()).must()
    assert again.len() == 2
    assert again[1].text == "two"
    assert again[1].done == false

test "completing a task survives the round trip through the file"
    path = "build/twin-todo-done.txt"
    write_file(path: path, text: "[ ] one\n[ ] two\n").must()
    tasks = list.read(read_file(path).must()).must()
    write_file(path: path, text: list.render(list.complete(tasks, 1).must())).must()
    after = list.read(read_file(path).must()).must()
    assert after[0].done == true
    assert after[1].done == false
    assert list.left_to_do(after) == 1

test "arguments after the command become one task"
    assert rest_of(["f", "add", "buy", "milk"], 2) == "buy milk"
    assert rest_of(["f", "add"], 2) == ""
    assert number_of("12").must() == 12
    assert number_of("x").is_err()
    assert number_of("").is_err()
