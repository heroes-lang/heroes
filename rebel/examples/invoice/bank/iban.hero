# Bank account identifiers as an invoice prints them and a payment needs
# them: the IBAN (ISO 13616), read as a person writes it, checked by its
# two check digits and written in groups of four; the BIC (ISO 9362),
# checked by its shape; and the remainder by 97 of ISO 7064's MOD 97-10,
# which the IBAN and the RF creditor reference (`bank/reference`) both
# rest on.
#
# The length each country fixes for its IBAN is not checked: the program
# carries no copy of the IBAN registry, so a number of the wrong length
# with right check digits passes, and the bank refuses it at payment. The
# check digits are computed on the whole number as one integer of `big`,
# however long, rather than piece by piece in an `i64`.

use <rebel>/big
use <rebel>/bytes
use <rebel>/strings

## Codes

# The code of a text that is not an IBAN, a BIC or a reference of the form
# its standard writes.
constant INVALID: str
    "invalid"

## Bounds

# The most characters an IBAN holds, ISO 13616's and the EPC payment
# code's bound.
constant MAX_IBAN: i64
    34

## MOD 97-10

# The remainder by 97 of `text` read as ISO 7064's MOD 97-10 reads it:
# each digit as itself, each letter as two digits, `A` 10 to `Z` 35, the
# whole as one integer.
#
# - `text`: digits and upper-case ASCII letters; at least one.
#
# Fails `invalid` where `text` is empty or holds another character.
function remainder_97(text: str) -> i64?
    digits: [str] @= []

    if text == ""
        return fail(code: INVALID, msg: "no character to check")

    for i in range(from: 0, to: text.len())
        c = text[i]

        if c >= '0' && c <= '9'
            digits @ digits.push(text.slice(from: i, to: i + 1))
        else if c >= 'A' && c <= 'Z'
            digits @ digits.push(f"{to_i64(c - 'A').must() + 10}")
        else
            return fail(
                code: INVALID,
                msg: f"\"{text}\" holds \"{text.slice(from: i, to: i + 1)}\", which is no digit and no capital letter"
            )

    n = big.parse(digits.join(""))?
    d = big.divide(n: n, by: big.from_int(97), rounding: .floor)
    return big.int_of(d.remainder)

## IBAN

# `text` with its spaces taken out and its letters made capitals: the
# IBAN as it travels, from the IBAN as a person writes it.
#
# - `text`: any text.
function compact(text: str) -> str
    return strings.to_upper_ascii(strings.replace_all(s: text, old: " ", new: ""))

# The IBAN `text` writes, compact and checked.
#
# - `text`: the IBAN, spaces anywhere and letters in either case.
#
# Fails `invalid` where it is shorter than five characters or longer than
# `MAX_IBAN`, where its first two are not letters, its next two not digits,
# where it holds a character that is no digit and no letter, or where its
# check digits do not hold, the message saying which.
function parse_iban(text: str) -> str?
    s = compact(text)

    if s.len() < 5 || s.len() > MAX_IBAN
        return fail(code: INVALID, msg: f"an IBAN holds 5 to {MAX_IBAN} characters, and \"{text}\" holds {s.len()}")

    if !bytes.is_upper_ascii(s[0]) || !bytes.is_upper_ascii(s[1])
        return fail(code: INVALID, msg: f"an IBAN opens with its country's two letters, and \"{text}\" does not")

    if !bytes.is_digit_ascii(s[2]) || !bytes.is_digit_ascii(s[3])
        return fail(
            code: INVALID,
            msg: f"an IBAN's third and fourth characters are its check digits, and \"{text}\"'s are not digits"
        )
    rearranged = s.slice(from: 4, to: s.len()) + s.slice(from: 0, to: 4)

    match remainder_97(rearranged)
        .err _ => return fail(
            code: INVALID,
            msg: f"an IBAN holds digits and letters alone, and \"{text}\" holds another character"
        )
        .ok r =>
            if r != 1
                return fail(code: INVALID, msg: f"the check digits of \"{text}\" do not hold: a character is mistyped")
            return ok(s)

# The country of the IBAN `iban`, its first two letters: `IT`.
#
# - `iban`: an IBAN `parse_iban` answered.
function country_of(iban: str) -> str
    return iban.slice(from: 0, to: 2)

# `iban` written as a person reads it, in groups of four separated by a
# space: `IT60 X054 2811 1010 0000 0123 456`.
#
# - `iban`: an IBAN `parse_iban` answered, compact.
function format_iban(iban: str) -> str
    groups: [str] @= []
    at @= 0

    while at < iban.len()
        end = if at + 4 < iban.len()
            at + 4
        else
            iban.len()
        groups @ groups.push(iban.slice(from: at, to: end))
        at @ end

    return groups.join(" ")

## BIC

# The BIC `text` writes, in capitals: four letters or digits naming the
# institution, two letters for its country, two letters or digits for its
# place, and optionally three more for a branch.
#
# - `text`: the BIC, in either case; spaces are not read.
#
# Fails `invalid` where it is not 8 or 11 characters of that shape.
function parse_bic(text: str) -> str?
    s = strings.to_upper_ascii(text)

    if s.len() != 8 && s.len() != 11
        return fail(code: INVALID, msg: f"a BIC holds 8 or 11 characters, and \"{text}\" holds {s.len()}")

    for i in range(from: 0, to: s.len())
        c = s[i]
        country = i == 4 || i == 5

        if country && !bytes.is_upper_ascii(c)
            return fail(
                code: INVALID,
                msg: f"a BIC's fifth and sixth characters are its country's letters, and \"{text}\"'s are not"
            )

        if !bytes.is_upper_ascii(c) && !bytes.is_digit_ascii(c)
            return fail(
                code: INVALID,
                msg: f"a BIC holds letters and digits alone, and \"{text}\" holds another character"
            )

    return ok(s)

## Characters

# The forty-digit number's remainder is Python 3's `int(...) % 97`, run
# 2026-11-22.
test "remainder_97: digits, letters, and a number longer than an i64"
    assert remainder_97("97").must() == 0 && remainder_97("98").must() == 1
    assert remainder_97("A").must() == 10 && remainder_97("Z").must() == 35
    assert remainder_97("1234567890123456789012345678901234567890").must() == 28
    assert remainder_97("").is_err() && remainder_97("a").is_err() && remainder_97("1 2").is_err()

test "parse_iban: the EPC guideline's two accounts, spaced and in small letters"
    assert parse_iban("DE71110220330123456789").must() == "DE71110220330123456789"
    assert parse_iban("fr14 2004 1010 0505 0001 3m02 606").must() == "FR1420041010050500013M02606"

test "parse_iban: a mistyped digit, two swapped, and shapes that are no IBAN"
    assert parse_iban("DE71110220330123456788").is_err()
    assert parse_iban("DE17110220330123456789").is_err()
    assert parse_iban("DE7").is_err()
    assert parse_iban("1271110220330123456789").is_err()
    assert parse_iban("DEXX110220330123456789").is_err()
    assert parse_iban("DE71-110220330123456789").is_err()
    assert parse_iban("DE71110220330123456789012345678901234").is_err()

test "format_iban: groups of four, a short last one"
    assert format_iban("FR1420041010050500013M02606") == "FR14 2004 1010 0505 0001 3M02 606"
    assert format_iban("DE71110220330123456789") == "DE71 1102 2033 0123 4567 89"
    assert country_of("FR1420041010050500013M02606") == "FR"

test "parse_bic: eight and eleven characters, and the shapes refused"
    assert parse_bic("bhbldehhxxx").must() == "BHBLDEHHXXX"
    assert parse_bic("BHBLDEHH").must() == "BHBLDEHH"
    assert parse_bic("BHBLDEH").is_err() && parse_bic("BHBL12HH").is_err() && parse_bic("BHBL DEHH").is_err()
