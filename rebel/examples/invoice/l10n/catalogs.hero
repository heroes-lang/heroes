# The words a document and its mail are written in, in the customer's
# language. Every text is a gettext message whose identifier is its
# English, so an English document needs no catalog and a language with no
# catalog falls back to English word by word. Italian, French and German
# are carried in the program; a company changes a wording, or adds a
# language, with a `.po` file in the folder its configuration names
# (`translations`): `<folder>/it.po` is read over the carried Italian, each
# message it translates replacing the carried one, so a file needs to hold
# only the messages it changes.
#
# The mail's subject and bodies are messages too, and their translations
# are templates (`mailing/message` renders them): a translator moves a
# `{{ .number }}` where the language puts it.

use <rebel>/fs
use <rebel>/i18n
use <rebel>/path

use tax/regime

## The labels

# Each label a document's layout reads, by the key the layout names it
# with (`.labels.invoice`), and its English.
function labels() -> [[str]]
    return [
        ["invoice", "Invoice"]
        ["credit_note", "Credit note"]
        ["number", "Number"]
        ["date", "Date"]
        ["due", "Due date"]
        ["bill_to", "Bill to"]
        ["vat_id", "VAT ID"]
        ["description", "Description"]
        ["quantity", "Quantity"]
        ["unit", "Unit"]
        ["unit_price", "Unit price"]
        ["vat", "VAT"]
        ["amount", "Amount"]
        ["taxable", "Taxable amount"]
        ["rate", "Rate"]
        ["tax", "Tax"]
        ["total_net", "Total net"]
        ["total_vat", "Total VAT"]
        ["total_due", "Total due"]
        ["total_credited", "Total credited"]
        ["pay_to", "Pay by bank transfer to"]
        ["reference", "Reference"]
        ["credits", "Credits invoice"]
        ["exchange", "Exchange rate"]
        ["currency", "Currency"]
        ["scan", "Scan to pay"]
        ["nothing_due", "Nothing to pay: the amount is credited."]
    ]

## The mail's messages

# The English of the mail's subject, a template.
constant SUBJECT: str
    "{{ .kind }} {{ .number }} from {{ .company }}"

# The English of the body of the mail that sends an invoice, a template.
constant INVOICE_BODY: str
    "Dear {{ .customer }},\n\nplease find attached our invoice {{ .number }} of {{ .date }} for {{ .total }}, due on {{ .due }}.\n\nKind regards,\n{{ .company }}\n"

# The English of the body of the mail that sends a credit note, a
# template.
constant CREDIT_BODY: str
    "Dear {{ .customer }},\n\nplease find attached our credit note {{ .number }} of {{ .date }} for {{ .total }}, which credits invoice {{ .refers_to }}.\n\nKind regards,\n{{ .company }}\n"

## The carried translations

# The carried translations of `language`, each a pair of the English and
# its translation; none for a language the program does not carry.
#
# - `language`: a language subtag, lower case: `it`.
function carried(language: str) -> [[str]]
    if language == "it"
        return italian()

    if language == "fr"
        return french()

    if language == "de"
        return german()
    return []

