## Catalogs

# The catalog of `language`: the carried translations, with those of
# `<dir>/<language>.po` over them where the folder holds one.
#
# - `language`: a language subtag, lower case.
# - `dir`: the folder of the company's own `.po` files, "" for none.
#
# Fails as `fs.read_bytes` and `i18n.parse_po` fail on the company's file,
# the message naming it; a folder with no file for the language is no
# failure.
function catalog_for(language: str, dir: str) -> i18n.Catalog?
    messages: [i18n.Message] @= []

    for pair in carried(language)
        messages @ messages.push(i18n.new_message(id: pair[0], translation: pair[1]))

    catalog @= i18n.new_catalog(messages)?

    if dir == ""
        return ok(catalog)
    file = path.join_all([dir, language + ".po"])

    if !fs.exists(file).default(false)
        return ok(catalog)

    match read_file(path: file)
        .err e => return fail(code: e.code, msg: f"{file}: {e.msg}")
        .ok text =>
            match i18n.parse_po(text)
                .err e => return fail(code: e.code, msg: f"{file}: {e.msg}")
                .ok own =>
                    for m in own.messages
                        if is_usable(m)
                            i18n.add_message(@catalog, message: m)?

                    return ok(catalog)

# Whether a message of a company's file replaces a carried one: one that
# is not the header, not obsolete, not marked fuzzy, and translated.
#
# - `m`: the message.
function is_usable(m: i18n.Message) -> bool
    if m.id == "" || m.obsolete || m.translations.len() == 0 || m.translations[0] == ""
        return false

    for flag in m.flags
        if flag == "fuzzy"
            return false

    return true

# The labels of a document in `catalog`'s language, by key.
#
# - `catalog`: the language's catalog.
function labels_in(catalog: i18n.Catalog) -> {str: str}
    found: {str: str} @= {}

    for pair in labels()
        found[pair[0]] @ i18n.translate(catalog, id: pair[1])

    return found

# The language subtag of the locale `tag` names: `it` for `it-IT`.
#
# - `tag`: a BCP 47 tag.
#
# Fails as `i18n.parse_locale` fails.
function language_of(tag: str) -> str?
    return ok(i18n.parse_locale(tag)?.language)

test "carried: every language translates every label and every message"
    english: [str] @= []

    for pair in labels()
        english @ english.push(pair[1])

    for r in regime.all_regimes()
        if regime.note_of(r) != ""
            english @ english.push(regime.note_of(r))

    english @ english.push(SUBJECT)
    english @ english.push(INVOICE_BODY)
    english @ english.push(CREDIT_BODY)

    for language in ["it", "fr", "de"]
        catalog = catalog_for(language: language, dir: "").must()

        for id in english
            assert i18n.find_message(catalog, id: id).is_err() == false

        assert carried(language).len() == english.len()

test "catalog_for: English and an unknown language answer the English"
    assert i18n.translate(catalog_for(language: "en", dir: "").must(), id: "Invoice") == "Invoice"
    assert i18n.translate(catalog_for(language: "ja", dir: "").must(), id: "Due date") == "Due date"
    assert labels_in(catalog_for(language: "it", dir: "").must())["total_due"].must() == "Totale da pagare"

test "catalog_for: a company's file changes one message and keeps the others"
    dir = fs.make_temp_dir(dir: "build", pattern: "invoice-po-*").must()
    po = "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"Total due\"\nmsgstr \"Totale da saldare\"\n\n#, fuzzy\nmsgid \"Invoice\"\nmsgstr \"Fatturina\"\n"
    write_file(path: path.join_all([dir, "it.po"]), text: po).must()
    catalog = catalog_for(language: "it", dir: dir).must()
    assert i18n.translate(catalog, id: "Total due") == "Totale da saldare"
    assert i18n.translate(catalog, id: "Invoice") == "Fattura"
    assert i18n.translate(catalog_for(language: "fr", dir: dir).must(), id: "Total due") == "Net à payer"
    write_file(path: path.join_all([dir, "de.po"]), text: "msgid \"x\"\nmsgstr").must()
    assert catalog_for(language: "de", dir: dir).is_err()
    fs.remove_all(dir).must()

test "language_of: the language of a tag"
    assert language_of("fr-FR").must() == "fr" && language_of("en").must() == "en"
    assert language_of("").is_err()
