# The layout of a document's page, and the language it is written in. A
# layout is a template (`template`, text mode) rendered over the document's
# view (`render/view`); what it writes is a page description, one command a
# line, its fields separated by tabs, which this module reads into marks
# that `render/drawing` draws. A company changes how its invoices look by
# giving its own layout file (`conf/settings`'s `layout`), with no
# rebuilding; the one the program carries is `render/layout`'s.
#
#     page   a4 | letter                          the paper, the first command
#     font   <PDF name> <size>                    Helvetica-Bold 11
#     color  <red> <green> <blue>                 each 0 to 1
#     text   <x> <y> <align> <text>               one line, its baseline at y
#     para   <x> <top> <width> <align> <line height> <text>    wrapped
#     rule   <x1> <y> <x2> <width>                a horizontal line
#     box    <x> <y> <width> <height>             a rectangle filled
#     logo   <x> <y> <width>                      the company's logo
#     qr     <x> <y> <size>                       the payment code
#     table  <x> <top> <bottom> <widths> <aligns> then `row` lines, `end`
#     row    <cell> ...                           the first row a header
#     end
#
# Lengths are points, 72 to the inch, from the page's bottom left corner.
# An align is `left`, `center`, `right` or `justify`; a table's aligns are
# one letter a column, `l`, `c`, `r` or `j`, and its widths numbers joined
# by commas. A y or a top written `@-24` stands 24 points below where the
# last table ended, so what follows a table of any length follows it. In a
# text field `\n` is a line break, `\t` a tab and `\\` a backslash: the view
# writes every value of the books so (`escape`), so no name or description
# can add a field or a command. A blank line, and one whose first character
# is `#`, says nothing.
#
# Everything the drawing would abort on is refused here as `invalid` with
# its line's number: a size or a width not above zero, a mark before the
# page, a number that is not finite, so a company's own layout can be wrong
# but cannot stop the program.

use <rebel>/numbers
use <rebel>/pdf
use <rebel>/strings

## Codes

# The code of a page description that is not one.
constant INVALID: str
    "invalid"

## Bounds

# The largest length a layout may name, in points: PDF's own bound on a
# page's side.
constant MAX_LENGTH: f64
    14400.0

## Marks

# A height: from the page's bottom, or below where the last table ended.
record Height
    # Whether it is counted from where the last table ended.
    from_cursor: bool
    # The points from the bottom, or the points added to the cursor, which
    # are negative below it.
    value: f64

# One command of a page description.
variant Mark
    # The paper of the page.
    page
        # Its size.
        size: pdf.Size
    # The font text is drawn in from here on.
    font
        # The font.
        font: pdf.Font
        # Its size in points.
        size: f64
    # The colour text, lines and boxes are drawn in from here on.
    color
        # Red, 0 to 1.
        red: f64
        # Green, 0 to 1.
        green: f64
        # Blue, 0 to 1.
        blue: f64
    # One line of text.
    text
        # Where its `align` end stands from the left.
        x: f64
        # Its baseline.
        y: Height
        # Which end of it `x` is.
        align: pdf.Align
        # The text.
        text: str
    # A paragraph wrapped into a box.
    para
        # The box's left.
        x: f64
        # The box's top.
        top: Height
        # The box's width, above zero.
        width: f64
        # How each line stands in the box.
        align: pdf.Align
        # From one baseline to the next, above zero.
        line_height: f64
        # The text.
        text: str
    # A horizontal line.
    rule
        # Its left end.
        from_x: f64
        # Its height.
        y: Height
        # Its right end.
        to_x: f64
        # Its width, 0 or more.
        width: f64
    # A filled rectangle.
    box
        # Its left.
        x: f64
        # Its bottom.
        y: Height
        # Its width.
        width: f64
        # Its height.
        height: f64
    # The company's logo.
    logo
        # Its left.
        x: f64
        # Its bottom.
        y: Height
        # Its width; its height is in proportion.
        width: f64
    # The payment code.
    qr
        # Its left.
        x: f64
        # Its bottom.
        y: Height
        # Its side.
        size: f64
    # A table.
    table
        # Its left.
        x: f64
        # The top of its first row.
        top: Height
        # The lowest a row may reach before the rest goes to a new page.
        bottom: f64
        # Each column's width.
        widths: [f64]
        # How each column's lines stand.
        aligns: [pdf.Align]
        # Its rows, the first its header.
        rows: [[str]]

## Reading

# The marks a page description writes.
#
# - `text`: the description, as a layout rendered it.
#
# Fails `invalid` naming the line and what it holds where a line is no
# command, a field is missing or of the wrong form, a mark stands before
# the page, a table is not ended or holds no row.
function parse_sheet(text: str) -> [Mark]?
    marks: [Mark] @= []
    lines = strings.split(s: text, sep: "\n")
    at @= 0
    seen_page @= false

    while at < lines.len()
        line = strings.trim_end_any(s: lines[at], set: "\r")
        number = at + 1
        at @ at + 1

        if strings.trim(line) == "" || strings.has_prefix(s: strings.trim_start(line), prefix: "#")
            continue
        fields = strings.split(s: line, sep: "\t")
        verb = strings.trim(fields[0])

        if !seen_page && verb != "page"
            return fail(code: INVALID, msg: f"layout line {number}: the page comes first, and this line is \"{verb}\"")

        if verb == "table"
            head = mark_of(fields, number: number)?
            rows: [[str]] @= []
            ended @= false

            while !ended && at < lines.len()
                inner = strings.trim_end_any(s: lines[at], set: "\r")
                at @ at + 1

                if strings.trim(inner) == "" || strings.has_prefix(s: strings.trim_start(inner), prefix: "#")
                    continue
                cells = strings.split(s: inner, sep: "\t")
                word = strings.trim(cells[0])

                if word == "end"
                    ended @ true
                else if word == "row"
                    rows @ rows.push(cells.slice(from: 1, to: cells.len()).map(unescape))
                else
                    return fail(
                        code: INVALID,
                        msg: f"layout line {at}: a table holds rows and ends with \"end\", and this line is \"{word}\""
                    )

            if !ended
                return fail(code: INVALID, msg: f"layout line {number}: the table is never ended")
            marks @ marks.push(with_rows(head, rows: rows, number: number)?)
        else
            mark = mark_of(fields, number: number)?

            match mark
                .page _                                                                                => seen_page @ true
                .font _ | .color _ | .text _ | .para _ | .rule _ | .box _ | .logo _ | .qr _ | .table _ => _ = 0

            marks @ marks.push(mark)

    if !seen_page
        return fail(code: INVALID, msg: "the layout names no page")
    return ok(marks)

# The mark of one line, its fields read; a table's rows are added by
# `with_rows`.
#
# - `fields`: the line's fields, the command first.
# - `number`: the line's number, for the message.
#
# Fails `invalid` as `parse_sheet` says.
function mark_of(fields: [str], number: i64) -> Mark?
    verb = strings.trim(fields[0])
    where = f"layout line {number}"

    if verb == "page"
        wanted(fields, count: 2, number: number)?
        paper = strings.trim(fields[1])

        if paper == "a4"
            return ok(.page(size: pdf.size_of(.a4)))

        if paper == "letter"
            return ok(.page(size: pdf.size_of(.letter)))
        return fail(code: INVALID, msg: f"{where}: the paper is a4 or letter, and not \"{paper}\"")

    if verb == "font"
        wanted(fields, count: 3, number: number)?

        match pdf.parse_font(strings.trim(fields[1]))
            .err _ => return fail(
                code: INVALID,
                msg: f"{where}: \"{fields[1]}\" is none of PDF's 14 fonts, such as Helvetica-Bold"
            )
            .ok font => return ok(.font(font: font, size: positive(fields[2], number: number)?))

    if verb == "color"
        wanted(fields, count: 4, number: number)?
        return ok(
            .color(red: unit_of(fields[1], number: number)?, green: unit_of(fields[2], number: number)?, blue: unit_of(fields[3], number: number)?)
        )

    if verb == "text"
        wanted(fields, count: 5, number: number)?
        return ok(
            .text(x: length(fields[1], number: number)?, y: height_of(fields[2], number: number)?, align: align_of(fields[3], number: number)?, text: unescape(fields[4]))
        )

    if verb == "para"
        wanted(fields, count: 7, number: number)?
        return ok(
            .para(x: length(fields[1], number: number)?, top: height_of(fields[2], number: number)?, width: positive(fields[3], number: number)?, align: align_of(fields[4], number: number)?, line_height: positive(fields[5], number: number)?, text: unescape(fields[6]))
        )

    if verb == "rule"
        wanted(fields, count: 5, number: number)?
        return ok(
            .rule(from_x: length(fields[1], number: number)?, y: height_of(fields[2], number: number)?, to_x: length(fields[3], number: number)?, width: not_negative(fields[4], number: number)?)
        )

    if verb == "box"
        wanted(fields, count: 5, number: number)?
        return ok(
            .box(x: length(fields[1], number: number)?, y: height_of(fields[2], number: number)?, width: positive(fields[3], number: number)?, height: positive(fields[4], number: number)?)
        )

    if verb == "logo"
        wanted(fields, count: 4, number: number)?
        return ok(
            .logo(x: length(fields[1], number: number)?, y: height_of(fields[2], number: number)?, width: positive(fields[3], number: number)?)
        )

    if verb == "qr"
        wanted(fields, count: 4, number: number)?
        return ok(
            .qr(x: length(fields[1], number: number)?, y: height_of(fields[2], number: number)?, size: positive(fields[3], number: number)?)
        )

    if verb == "table"
        wanted(fields, count: 6, number: number)?
        widths: [f64] @= []

        for w in strings.split(s: fields[4], sep: ",")
            widths @ widths.push(positive(w, number: number)?)

        aligns: [pdf.Align] @= []

        for letter in strings.trim(fields[5]).chars()
            aligns @ aligns.push(align_of(letter, number: number)?)

        if widths.len() != aligns.len()
            return fail(code: INVALID, msg: f"{where}: the table has {widths.len()} widths and {aligns.len()} aligns")
        return ok(
            .table(x: length(fields[1], number: number)?, top: height_of(fields[2], number: number)?, bottom: length(fields[3], number: number)?, widths: widths, aligns: aligns, rows: [])
        )
    return fail(code: INVALID, msg: f"{where}: \"{verb}\" is no command of a layout")

# `head`, a table read by `mark_of`, holding `rows`.
#
# - `head`: the table.
# - `rows`: its rows, the first its header.
# - `number`: the line of the table, for the message.
#
# Fails `invalid` where there is no row or a row has not one cell a column.
function with_rows(head: Mark, rows: [[str]], number: i64) -> Mark?
    match head
        .table t =>
            if rows.len() == 0
                return fail(code: INVALID, msg: f"layout line {number}: the table holds no row")

            for r in rows
                if r.len() != t.widths.len()
                    return fail(
                        code: INVALID,
                        msg: f"layout line {number}: a row of the table holds {r.len()} cells, and the table has {t.widths.len()} columns"
                    )

            return ok(.table(x: t.x, top: t.top, bottom: t.bottom, widths: t.widths, aligns: t.aligns, rows: rows))
        .page _ | .font _ | .color _ | .text _ | .para _ | .rule _ | .box _ | .logo _ | .qr _ => return ok(head)

## Fields

# Checks that `fields` holds `count` fields.
#
# - `fields`: the line's fields.
# - `count`: how many its command takes, the command counted.
# - `number`: the line's number.
#
# Fails `invalid` where it holds another count.
function wanted(fields: [str], count: i64, number: i64) -> ()?
    if fields.len() != count
        return fail(
            code: INVALID,
            msg: f"layout line {number}: \"{strings.trim(fields[0])}\" takes {count - 1} fields separated by tabs, and the line holds {fields.len() - 1}"
        )
    return ok()

# The length `text` writes: a finite number of points within
# `MAX_LENGTH` either side of zero.
#
# - `text`: the field.
# - `number`: the line's number.
#
# Fails `invalid` where it is none.
function length(text: str, number: i64) -> f64?
    match numbers.parse_float(strings.trim(text))
        .err _ => return fail(code: INVALID, msg: f"layout line {number}: \"{text}\" is no number")
        .ok x =>
            if x != x || x > MAX_LENGTH || x < 0.0 - MAX_LENGTH
                return fail(code: INVALID, msg: f"layout line {number}: {text} is outside the page")
            return ok(x)

# A length above zero.
#
# - `text`: the field.
# - `number`: the line's number.
#
# Fails `invalid` where it is not.
function positive(text: str, number: i64) -> f64?
    x = length(text, number: number)?

    if x <= 0.0
        return fail(code: INVALID, msg: f"layout line {number}: {text} is not above zero")
    return ok(x)

# A length of zero or more.
#
# - `text`: the field.
# - `number`: the line's number.
#
# Fails `invalid` where it is below zero.
function not_negative(text: str, number: i64) -> f64?
    x = length(text, number: number)?

    if x < 0.0
        return fail(code: INVALID, msg: f"layout line {number}: {text} is below zero")
    return ok(x)

# A colour's component, from 0 to 1.
#
# - `text`: the field.
# - `number`: the line's number.
#
# Fails `invalid` outside 0 to 1.
function unit_of(text: str, number: i64) -> f64?
    x = length(text, number: number)?

    if x < 0.0 || x > 1.0
        return fail(code: INVALID, msg: f"layout line {number}: a colour's part is from 0 to 1, and not {text}")
    return ok(x)

# The height `text` writes: points from the bottom, or `@` and points
# added to where the last table ended.
#
# - `text`: the field: `780`, `@-24`.
# - `number`: the line's number.
#
# Fails `invalid` where it is neither.
function height_of(text: str, number: i64) -> Height?
    t = strings.trim(text)

    if strings.has_prefix(s: t, prefix: "@")
        return ok(Height(from_cursor: true, value: length(t.slice(from: 1, to: t.len()), number: number)?))
    return ok(Height(from_cursor: false, value: length(t, number: number)?))

# The align `text` names: a word, or its first letter in a table.
#
# - `text`: the field.
# - `number`: the line's number.
#
# Fails `invalid` where it names none.
function align_of(text: str, number: i64) -> pdf.Align?
    t = strings.trim(text)

    if t == "left" || t == "l"
        return ok(.left)

    if t == "center" || t == "c"
        return ok(.center)

    if t == "right" || t == "r"
        return ok(.right)

    if t == "justify" || t == "j"
        return ok(.justify)
    return fail(code: INVALID, msg: f"layout line {number}: \"{text}\" is no align: left, center, right or justify")

## Escapes

# `s` written so that a field of the layout holds it whole: a backslash as
# `\\`, a tab as `\t`, a line break as `\n`, a carriage return dropped.
#
# - `s`: any text.
function escape(s: str) -> str
    parts: [str] @= []

    for c in s.chars()
        if c == "\\"
            parts @ parts.push("\\\\")
        else if c == "\t"
            parts @ parts.push("\\t")
        else if c == "\n"
            parts @ parts.push("\\n")
        else if c != "\r"
            parts @ parts.push(c)

    return parts.join("")

# The text a field holds, its escapes read: `escape`'s inverse. A
# backslash before any other character, or at the end, stands for itself.
#
# - `s`: the field.
function unescape(s: str) -> str
    parts: [str] @= []
    pending @= false

    for c in s.chars()
        if pending
            pending @ false

            if c == "n"
                parts @ parts.push("\n")
            else if c == "t"
                parts @ parts.push("\t")
            else if c == "\\"
                parts @ parts.push("\\")
            else
                parts @ parts.push("\\" + c)
        else if c == "\\"
            pending @ true
        else
            parts @ parts.push(c)

    if pending
        parts @ parts.push("\\")
    return parts.join("")

test "parse_sheet: every command read, a table and the cursor"
    text = "page\ta4\n# a comment\n\nfont\tHelvetica-Bold\t12\ncolor\t0\t0.5\t1\ntext\t10\t@-4.5\tright\tA\\tB\npara\t1\t2\t3\tjustify\t4\tx\nrule\t1\t2\t3\t0\nbox\t1\t2\t3\t4\nlogo\t1\t2\t3\nqr\t1\t2\t3\ntable\t1\t2\t3\t10,20\tlr\nrow\th1\th2\nrow\ta\tb\nend\n"
    marks = parse_sheet(text).must()
    assert marks.len() == 10

    match marks[3]
        .text t                                                                                => assert t.y == Height(from_cursor: true, value: -4.5) && t.align == .right && t.text == "A\tB"
        .page _ | .font _ | .color _ | .para _ | .rule _ | .box _ | .logo _ | .qr _ | .table _ => assert false

    match marks[9]
        .table t                                                                              => assert t.rows == [["h1", "h2"], ["a", "b"]] && t.aligns == [.left, .right]
        .page _ | .font _ | .color _ | .text _ | .para _ | .rule _ | .box _ | .logo _ | .qr _ => assert false

test "parse_sheet: the refusals, each with its line"
    assert parse_sheet("").is_err()
    assert parse_sheet("text\t1\t2\tleft\tx").is_err()
    assert parse_sheet("page\ta5").is_err()
    assert parse_sheet("page\ta4\nfont\tArial\t10").is_err()
    assert parse_sheet("page\ta4\nfont\tHelvetica\t0").is_err()
    assert parse_sheet("page\ta4\ncolor\t2\t0\t0").is_err()
    assert parse_sheet("page\ta4\ntext\t1\t2\tleft").is_err()
    assert parse_sheet("page\ta4\ntext\tnan\t2\tleft\tx").is_err()
    assert parse_sheet("page\ta4\ntable\t1\t2\t3\t10\tl\nrow\ta").is_err()
    assert parse_sheet("page\ta4\ntable\t1\t2\t3\t10\tl\nend").is_err()
    assert parse_sheet("page\ta4\ntable\t1\t2\t3\t10,20\tl\nrow\ta\nend").is_err()
    assert parse_sheet("page\ta4\nrule\t1\t2\t3\t-1").is_err()

    match parse_sheet("page\ta4\n\ndraw\t1")
        .ok _  => assert false
        .err e => assert e.msg == "layout line 3: \"draw\" is no command of a layout"

test "escape and unescape: a value with every escape read back, and loose backslashes"
    s = "a\\b\tc\nd\re"
    assert escape(s) == "a\\\\b\\tc\\nde"
    assert unescape(escape(s)) == "a\\b\tc\nde"
    assert unescape("x\\") == "x\\" && unescape("\\q") == "\\q"
