# Keys whose bytes sort as their values do: what the B-tree compares, so a
# table's rows stand in the order of their rowids and an index's entries in
# the order of their columns, with one comparison of bytes for every kind.
# The form is the one FoundationDB's tuple layer and CockroachDB write: a
# tag byte for the kind, `NULL` lowest; an integer in eight bytes, big-endian,
# its sign bit turned over; a float's bits turned so their order is the
# number's; a text or a blob with each zero byte written as `00 FF` and
# ended by `00 00`, so a prefix orders before what it begins. A key of
# several values is their keys one after another, and an index's key ends
# with the row's own, which makes every entry distinct.

use <rebel>/bytes
use <rebel>/sql

## Tags

constant NULL_TAG: u8
    0x01

constant BOOLEAN_TAG: u8
    0x02

constant INTEGER_TAG: u8
    0x03

constant FLOAT_TAG: u8
    0x04

constant TEXT_TAG: u8
    0x05

constant BLOB_TAG: u8
    0x06

# The bytes of an integer's key: its tag and eight bytes.
constant INTEGER_WIDTH: i64
    9

## Encoding

# The key of `v`, appended to `out`.
#
# - `out`: the key so far, grown in place.
# - `v`: the value.
function append(@out: [u8], v: sql.Value)
    match v
        .null_value => out @ out.push(NULL_TAG)
        .boolean b =>
            out @ out.push(BOOLEAN_TAG)
            out @ out.push(byte_of(b.v))
        .integer n =>
            out @ out.push(INTEGER_TAG)
            bytes.push_all(to: @out, from: integer_bytes(n.v))
        .float x =>
            out @ out.push(FLOAT_TAG)
            bytes.push_all(to: @out, from: float_bytes(x.v))
        .text t =>
            out @ out.push(TEXT_TAG)
            escaped(out: @out, data: bytes.from_text(t.v))
        .blob b =>
            out @ out.push(BLOB_TAG)
            escaped(out: @out, data: b.v)
        .instant _ => out @ out.push(NULL_TAG)

# The key of the values `values`, one after another.
#
# - `values`: the values, in the key's order.
function of(values: [sql.Value]) -> [u8]
    out: [u8] @= []

    for v in values
        append(@out, v: v)

    return out

# The key of a row's rowid: a table's key.
#
# - `rowid`: the rowid.
function of_rowid(rowid: i64) -> [u8]
    out: [u8] @= []
    append(@out, v: .integer(v: rowid))
    return out

# The rowid a table's key, or the end of an index's, holds.
#
# - `key`: a key ending with an integer's.
#
# Fails `invalid` where it ends with none, as a damaged page's key may.
function rowid_of(key: [u8]) -> i64?
    at = key.len() - INTEGER_WIDTH

    if at < 0 || key[at] != INTEGER_TAG
        return fail(code: "invalid", msg: "a key that ends with no rowid")
    raw @= key.slice(from: at + 1, to: key.len())
    raw[0] @ turned(raw[0])
    return bytes.decode_i64_be(raw, at: 0)

# The least key greater than every key that begins with `prefix`: the end of
# a scan of the entries an index holds for one value. A key's next byte
# after a value is a tag, below `FF`.
#
# - `prefix`: the key of the values sought.
function after_prefix(prefix: [u8]) -> [u8]
    out @= prefix
    out @ out.push(0xff)
    return out

function byte_of(b: bool) -> u8
    if b
        return 1
    return 0

# An integer's eight bytes, big-endian, the sign bit turned over so that a
# negative number orders before a positive one.
function integer_bytes(n: i64) -> [u8]
    out @= bytes.encode_i64_be(n)
    out[0] @ turned(out[0])
    return out

# A float's eight bytes in an order that is the number's: a positive one with
# its sign bit set, a negative one with every bit turned. Zero has one key,
# the negative zero's being the positive's.
function float_bytes(x: f64) -> [u8]
    plain = if_zero(x)
    out @= bytes.encode_f64_be(plain)

    if out[0] >= 0x80
        for k in [0, 1, 2, 3, 4, 5, 6, 7]
            out[k] @ 0xff - out[k]
    else
        out[0] @ out[0] + 0x80
    return out

function if_zero(x: f64) -> f64
    if x == 0.0
        return 0.0
    return x

# The highest bit of `b` turned over, by arithmetic: `^` takes an `i64`
# alone (spec § 7), and a byte would cross to one and back.
function turned(b: u8) -> u8
    if b >= 0x80
        return b - 0x80
    return b + 0x80

# `data` with each zero byte written as `00 FF`, then `00 00`.
function escaped(@out: [u8], data: [u8])
    for b in data
        out @ out.push(b)

        if b == 0
            out @ out.push(0xff)

    out @ out.push(0)
    out @ out.push(0)

## Tests

test "of: integers order as numbers, the edges of i64 included"
    numbers_in_order = [-9_223_372_036_854_775_807 - 1, -1, 0, 1, 255, 256, 9_223_372_036_854_775_807]
    last @= of_rowid(numbers_in_order[0])

    for n in numbers_in_order.slice(from: 1, to: numbers_in_order.len())
        next_key = of_rowid(n)
        assert bytes.compare(a: last, b: next_key) == -1
        last @ next_key

test "rowid_of: back from a table's key and from the end of an index's"
    assert rowid_of(of_rowid(-42)).must() == -42
    assert rowid_of(of([.text(v: "x"), .integer(v: 7)])).must() == 7
    assert rowid_of([1, 2]).is_err()
    assert rowid_of(of([.text(v: "abcdefghij")])).is_err()

test "of: floats order as numbers, negative zero is zero"
    a = of([.float(v: -2.5)])
    b = of([.float(v: -0.0)])
    c = of([.float(v: 0.0)])
    d = of([.float(v: 0.25)])
    assert bytes.compare(a: a, b: b) == -1
    assert b == c
    assert bytes.compare(a: c, b: d) == -1

test "of: a text before every longer text it begins, a zero byte inside one, NULL first"
    assert bytes.compare(a: of([.text(v: "ab")]), b: of([.text(v: "abc")])) == -1
    assert bytes.compare(a: of([.text(v: "a\u{1}")]), b: of([.text(v: "ab")])) == -1
    assert bytes.compare(a: of([.blob(v: [0])]), b: of([.blob(v: [0, 0])])) == -1
    assert bytes.compare(a: of([.null_value]), b: of([.boolean(v: false)])) == -1
    assert bytes.compare(a: of([.text(v: "z")]), b: of([.text(v: "é")])) == -1

test "after_prefix: every entry of one value stands between the prefix and it"
    prefix = of([.text(v: "bob")])
    entry = of([.text(v: "bob"), .integer(v: 9_223_372_036_854_775_807)])
    assert bytes.compare(a: prefix, b: entry) == -1
    assert bytes.compare(a: entry, b: after_prefix(prefix)) == -1
    assert bytes.compare(a: after_prefix(prefix), b: of([.text(v: "boba")])) == -1
