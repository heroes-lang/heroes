# A row as the bytes a table's B-tree keeps beside its key: the count of
# values, then each value as a kind byte and its payload. An integer is a
# zig-zag varint, so a small number takes a byte or two; a float its eight
# bytes; a text or a blob its length and bytes. Reading answers `invalid` for
# any byte that does not belong, as a damaged page's would, and never aborts.

use <rebel>/bytes
use <rebel>/sql

## Kinds

constant NULL_KIND: u8
    0

constant FALSE_KIND: u8
    1

constant TRUE_KIND: u8
    2

constant INTEGER_KIND: u8
    3

constant FLOAT_KIND: u8
    4

constant TEXT_KIND: u8
    5

constant BLOB_KIND: u8
    6

## Encoding

# The bytes of `values`. Lengths are zig-zag varints like the integers:
# Rebel's unsigned varint takes a `u64`, and a length here is an `i64`
# that would cross to one and back.
#
# - `values`: the row's values, in its columns' order.
function encode(values: [sql.Value]) -> [u8]
    out @= bytes.encode_varint(values.len())

    for v in values
        match v
            .null_value | .instant _ => out @ out.push(NULL_KIND)
            .boolean b =>
                if b.v
                    out @ out.push(TRUE_KIND)
                else
                    out @ out.push(FALSE_KIND)
            .integer n =>
                out @ out.push(INTEGER_KIND)
                bytes.push_all(to: @out, from: bytes.encode_varint(n.v))
            .float x =>
                out @ out.push(FLOAT_KIND)
                bytes.push_all(to: @out, from: bytes.encode_f64_be(x.v))
            .text t =>
                out @ out.push(TEXT_KIND)
                data = bytes.from_text(t.v)
                bytes.push_all(to: @out, from: bytes.encode_varint(data.len()))
                bytes.push_all(to: @out, from: data)
            .blob b =>
                out @ out.push(BLOB_KIND)
                bytes.push_all(to: @out, from: bytes.encode_varint(b.v.len()))
                bytes.push_all(to: @out, from: b.v)

    return out

# The values `data` holds.
#
# - `data`: what `encode` wrote.
#
# Fails `invalid` where the bytes end early, hold an unknown kind, a length
# past their end, text that is not UTF-8, or bytes after the last value.
function decode(data: [u8]) -> [sql.Value]?
    head = bytes.decode_varint(data, at: 0)?
    count = head.value
    at @= head.width

    if count < 0 || count > data.len()
        return damaged("a count past the row's bytes")
    found: [sql.Value] @= []

    while found.len() < count
        if at >= data.len()
            return damaged("a row that ends early")
        kind = data[at]
        at @ at + 1

        if kind == NULL_KIND
            found @ found.push(.null_value)
        else if kind == FALSE_KIND || kind == TRUE_KIND
            found @ found.push(.boolean(v: kind == TRUE_KIND))
        else if kind == INTEGER_KIND
            n = bytes.decode_varint(data, at: at)?
            at @ at + n.width
            found @ found.push(.integer(v: n.value))
        else if kind == FLOAT_KIND
            x = bytes.decode_f64_be(data, at: at)?
            at @ at + 8
            found @ found.push(.float(v: x))
        else if kind == TEXT_KIND || kind == BLOB_KIND
            size = bytes.decode_varint(data, at: at)?
            at @ at + size.width

            if size.value < 0 || size.value > data.len() - at
                return damaged("a length past the row's bytes")
            payload = data.slice(from: at, to: at + size.value)
            at @ at + size.value

            if kind == TEXT_KIND
                found @ found.push(.text(v: bytes.to_text(payload)?))
            else
                found @ found.push(.blob(v: payload))
        else
            return damaged(f"an unknown kind {kind}")

    if at != data.len()
        return damaged("bytes after the row's last value")
    return ok(found)

function damaged<T>(what: str) -> T?
    return fail(code: sql.INVALID, msg: f"a damaged row: {what}")

## Tests

test "encode and decode: every kind, the edges of i64, an empty text, more than one byte"
    values: [sql.Value] = [
        .null_value
        .boolean(v: true)
        .boolean(v: false)
        .integer(v: -9_223_372_036_854_775_807 - 1)
        .integer(v: 9_223_372_036_854_775_807)
        .integer(v: 0)
        .float(v: -0.5)
        .text(v: "")
        .text(v: "naïve 🙂")
        .blob(v: [0, 255])
    ]
    assert decode(encode(values)).must() == values

test "decode: an empty row, and every cut of a row refused, never read past"
    assert decode(encode([])).must().len() == 0
    data = encode([.text(v: "hello"), .integer(v: 300)])

    for n in range(from: 0, to: data.len())
        assert decode(data.slice(from: 0, to: n)).is_err()

test "decode: an unknown kind, a byte after the end, a length past the end, text not UTF-8"
    assert decode([2, 9]).is_err()
    assert decode([2, 0]).must() == [.null_value]
    assert decode([2, 0, 0]).is_err()
    assert decode([1]).is_err()
    assert decode([2, 5, 0x7e, 0x61]).is_err()
    assert decode([2, 5, 2, 0xff]).is_err()
