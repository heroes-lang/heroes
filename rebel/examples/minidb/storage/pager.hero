# The pager: the database as numbered pages, read through a cache and
# written through the log. A read takes a page from the transaction's own
# changes, else from the cache, else from the newest committed frame of the
# log, else from the database file. A write stays in memory until `commit`
# appends every changed page to the log, the last frame closing the
# transaction; a transaction that changes more pages than `spill_limit`
# appends them early as frames no commit closes yet, as SQLite spills its
# cache. The cache is Rebel's `containers/cache`, which forgets the page
# used least recently.
#
# One connection writes at a time: `begin_write` takes an exclusive lock on
# `<db>-lock` and answers `timeout` at once where another holds it, as
# SQLite answers SQLITE_BUSY. Readers never wait: each reads the log as of
# its snapshot and holds a shared lock on `<db>-read`, which a checkpoint
# takes exclusively, so no page a snapshot reads is copied under it.

use <rebel>/containers/cache
use <rebel>/errors
use <rebel>/fs
use <rebel>/io
use <rebel>/sql

use storage/header
use storage/node
use storage/wal

## The pager

# A database open on its files.
record Pager
    # The database file.
    file: io.Stream
    # The log.
    log: wal.Log
    # `<db>-lock`, locked exclusively while a transaction writes.
    writer: io.Stream
    # `<db>-read`, locked shared by every snapshot, exclusively by a
    # checkpoint.
    readers: io.Stream
    # The bytes of a page.
    page_size: i64
    # The pages of the database this connection sees.
    page_count: i64
    # The cache's shape, and its pages' numbers, bytes and slots.
    shape: cache.Cache
    cached_pages: [i64]
    cached_data: [[u8]]
    cached_at: {i64: i64}
    # Whether a snapshot is held, and whether a transaction writes.
    reading: bool
    writing: bool
    # The pages this transaction changed and holds in memory.
    dirty: {i64: [u8]}
    # The pages this transaction appended to the log early, by frame.
    spilled: {i64: i64}
    # How many changed pages a transaction holds before it spills.
    spill_limit: i64
    # Pages read from a file, and pages found in memory, since opened.
    reads: i64
    hits: i64

# How a database is opened.
record Options
    # The page size of a database the open makes; one that is there keeps
    # its own.
    page_size: i64
    # The pages the cache holds.
    cache_pages: i64
    # The changed pages a transaction holds before it spills to the log.
    spill_limit: i64

# A pager opened, and what its open found.
record Opened
    # The pager.
    pager: Pager
    # What recovery found in the log.
    recovery: wal.Recovery
    # Whether the open made the database.
    created: bool

# The page of the schema's table, the catalogue every other tree is named in.
constant SCHEMA_ROOT: i64
    2

# The SQLSTATE of a lock another connection holds.
constant LOCKED: str
    "55P03"

# The database at `path`, made where it is not there: a header page and the
# schema's empty table.
#
# - `path`: the database file's path; the log is `<path>-wal`.
# - `options`: the page size of a new database, the cache's size and the
#   spill limit.
#
# Fails `invalid` where the file is not a minidb database or `options` names
# no page size minidb writes, and with `fs`'s and `io`'s codes where the
# files cannot be made or read.
function open(path: str, options: Options) -> Opened?
    created = !fs.exists(path)?

    if created
        if !header.is_page_size(options.page_size)
            return fail(
                code: sql.INVALID,
                msg: f"a page size of {options.page_size}: minidb writes powers of two from 512 to 65536"
            )
        first = header.encode(
            header.Header(page_size: options.page_size, page_count: 2, free_head: 0, free_count: 0, schema_version: 0)
        )
        data @= first
        bytes_of_root = node.to_page(node.empty_leaf(table: true), page_size: options.page_size)?

        for b in bytes_of_root
            data @ data.push(b)

        fs.write_bytes(path, data: data)?

    # Every stream opened is kept in `opened` until the pager holds it, so a
    # failure after it closes it: a handle no path gives back is a leak the
    # runtime tells when `main` returns.
    opened: [io.Stream] @= []
    made = opened_on(path, options: options, created: created, @opened)

    if made.is_err()
        for k in range(from: 0, to: opened.len())
            errors.ignore(io.close(@opened[k]))
    return made

function opened_on(path: str, options: Options, created: bool, @opened: [io.Stream]) -> Opened?
    file = fs.open_with(path, access: .read_write, permission: 0o644)?
    opened @ opened.push(file)
    found_header = header.decode(io.read(file, n: header.SIZE)?)?
    writer = lock_file(path + "-lock")?
    opened @ opened.push(writer)
    readers = lock_file(path + "-read")?
    opened @ opened.push(readers)

    # Recovery cuts a dead transaction's frames off only where no other
    # connection is writing: a live one's frames are its own.
    alone = fs.try_lock(writer, exclusive: true)?
    log = wal.open(path + "-wal", page_size: found_header.page_size, cut: alone)?
    opened @ opened.push(log.log.stream)

    if alone
        fs.unlock(writer)?
    p @= Pager(
        file: file,
        log: log.log,
        writer: writer,
        readers: readers,
        page_size: found_header.page_size,
        page_count: found_header.page_count,
        shape: cache.new(most: options.cache_pages),
        cached_pages: [],
        cached_data: [],
        cached_at: {},
        reading: false,
        writing: false,
        dirty: {},
        spilled: {},
        spill_limit: options.spill_limit,
        reads: 0,
        hits: 0
    )
    p.page_count @ read_header(@p)?.page_count
    return ok(Opened(pager: p, recovery: log.recovery, created: created))

function lock_file(path: str) -> io.Stream?
    if !fs.exists(path)?
        fs.write_bytes(path, data: [])?
    return fs.open_with(path, access: .read_write, permission: 0o644)

# Closes the pager's files, a transaction still open rolled back first.
#
# - `p`: the pager, closed.
#
# Fails where a file cannot be closed; every file is closed all the same.
function close(@p: Pager) -> ()?
    if p.writing
        rollback(@p)?
    end_read(@p)
    a = io.close(@p.file)
    b = io.close(@p.log.stream)
    c = io.close(@p.writer)
    d = io.close(@p.readers)
    a?
    b?
    c?
    return d

# What a crash left in the log of a transaction that never committed.
record Cut
    # Its frames there whole: spilled before, or written as the power failed.
    frames: i64
    # Whether its last frame was torn.
    torn: bool

# Closes the pager's files as a power cut would leave them: nothing more is
# written, and where a transaction holds changed pages, their frames reach
# the log but the last one only half, as a write the power cut stopped. No
# frame closes the transaction, so recovery cuts all of them off.
#
# - `p`: the pager, closed.
#
# Fails where a file cannot be written or closed.
function crash(@p: Pager) -> Cut?
    cut @= Cut(frames: p.log.frames - p.log.committed, torn: false)

    if p.writing && p.dirty.len() > 0
        pages = sort(keys(p.dirty))
        last = pages.len() - 1

        for k in range(from: 0, to: last)
            wal.append(@p.log, page: pages[k], data: p.dirty[pages[k]]?, commit_pages: 0)?

        torn = p.dirty[pages[last]]?
        _ = io.seek(p.log.stream, offset: wal.offset_of(p.log, frame: p.log.frames), from: .start)?
        io.write(p.log.stream, data: torn.slice(from: 0, to: torn.len() / 2))?
        cut @ Cut(frames: p.log.frames - p.log.committed, torn: true)
    a = io.close(@p.file)
    b = io.close(@p.log.stream)
    c = io.close(@p.writer)
    d = io.close(@p.readers)
    a?
    b?
    c?
    d?
    return ok(cut)

## Snapshots and transactions

# Takes a snapshot: the log's newest commit becomes what this connection
# reads, its cache forgotten where another connection changed the database.
# A snapshot already held is kept.
#
# - `p`: the pager.
#
# Fails `timeout` where a checkpoint holds the database, and where the log
# cannot be read.
function begin_read(@p: Pager) -> ()?
    if p.reading
        return ok()

    if !fs.try_lock(p.readers, exclusive: false)?
        return fail(
            code: sql.TIMEOUT,
            msg: sql.failure_message(database_code: LOCKED, message: "the database is locked: a checkpoint is running")
        )

    if wal.refresh(@p.log)?
        cache.clear(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at)
    p.page_count @ read_header(@p)?.page_count
    p.reading @ true
    return ok()

# Lets the snapshot go, where no transaction writes.
#
# - `p`: the pager.
function end_read(@p: Pager)
    if p.reading && !p.writing
        _ = fs.unlock(p.readers).is_err()
        p.reading @ false

# Begins writing: the snapshot taken where none is held, then the writer's
# lock.
#
# - `p`: the pager.
#
# Fails `timeout` where another connection writes, and `failed` where
# another connection committed after this one's snapshot was taken, which a
# write upon it would undo: the transaction must begin again.
function begin_write(@p: Pager) -> ()?
    if p.writing
        return ok()
    begin_read(@p)?

    if !fs.try_lock(p.writer, exclusive: true)?
        return fail(
            code: sql.TIMEOUT,
            msg: sql.failure_message(database_code: LOCKED, message: "the database is locked: another connection is writing")
        )

    if wal.refresh(@p.log)?
        fs.unlock(p.writer)?
        cache.clear(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at)
        p.page_count @ read_header(@p)?.page_count
        return fail(
            code: sql.FAILED,
            msg: sql.failure_message(database_code: "40001", message: "the database changed since this transaction's snapshot: roll back and begin again")
        )
    p.writing @ true
    return ok()

# What a commit wrote.
record Committed
    # The frames appended now, the spilled ones not counted.
    frames: i64

# Commits: every changed page appended to the log, the last frame closing
# the transaction, the log synced to its storage, the writer's lock let go.
#
# - `p`: the pager.
#
# Fails where the log cannot be written or synced; the transaction is then
# rolled back.
function commit(@p: Pager) -> Committed?
    if !p.writing
        return ok(Committed(frames: 0))

    if p.dirty.len() == 0 && p.spilled.len() == 0
        finish_write(@p)?
        return ok(Committed(frames: 0))

    # A transaction whose pages all spilled closes on its header page.
    if p.dirty.len() == 0
        p.dirty[1] @ read(@p, page: 1)?
    pages = sort(keys(p.dirty))
    last = pages.len() - 1

    for k in range(from: 0, to: pages.len())
        page = pages[k]
        data = p.dirty[page]?
        written = wal.append(
            @p.log,
            page: page,
            data: data,
            commit_pages: commit_count(k: k, last: last, pages: p.page_count)
        )

        if written.is_err()
            _ = rollback(@p).is_err()
            return fail(code: sql.FAILED, msg: errors_of(written))

    synced = io.sync(p.log.stream)

    if synced.is_err()
        _ = rollback(@p).is_err()
        return fail(code: sql.FAILED, msg: errors_of(synced))

    for page in keys(p.spilled)
        _ = cache.remove(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at, key: page).is_err()

    for page in pages
        cache.put(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at, key: page, value: p.dirty[page]?, now: 0)

    p.dirty @ {}
    p.spilled @ {}
    finish_write(@p)?
    return ok(Committed(frames: pages.len()))

function commit_count(k: i64, last: i64, pages: i64) -> i64
    if k == last
        return pages
    return 0

function errors_of(r: ()?) -> str
    return match r
        .ok _  => ""
        .err e => e.msg

function finish_write(@p: Pager) -> ()?
    p.writing @ false
    fs.unlock(p.writer)?
    end_read(@p)
    return ok()

# Rolls back: the changed pages forgotten, the spilled frames cut off the
# log, the writer's lock let go.
#
# - `p`: the pager.
#
# Fails where the log cannot be cut.
function rollback(@p: Pager) -> ()?
    if !p.writing
        return ok()
    p.dirty @ {}
    p.spilled @ {}
    wal.rewind(@p.log)?
    p.writing @ false
    p.page_count @ read_header(@p)?.page_count
    fs.unlock(p.writer)?
    end_read(@p)
    return ok()

## Pages

# The bytes of page `page`.
#
# - `p`: the pager; its cache and counters move.
# - `page`: the page's number, from 1.
#
# Fails `invalid` for a page past the database's last, as a damaged page's
# child may name, and where a file cannot be read.
function read(@p: Pager, page: i64) -> [u8]?
    if page < 1 || page > p.page_count
        return fail(code: sql.INVALID, msg: f"a damaged database: page {page} is past its {p.page_count} pages")

    if p.writing
        match p.dirty[page]
            .ok data =>
                p.hits @ p.hits + 1
                return ok(data)
            .err _ => _ = 0

        match p.spilled[page]
            .ok frame =>
                p.reads @ p.reads + 1
                return wal.read_frame(p.log, frame: frame, page: page)
            .err _ => _ = 0

    match cache.get(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at, key: page, now: 0)
        .ok data =>
            p.hits @ p.hits + 1
            return ok(data)
        .err _ => _ = 0

    p.reads @ p.reads + 1
    data: [u8] @= []

    match p.log.index[page]
        .ok frame => data @ wal.read_frame(p.log, frame: frame, page: page)?
        .err _ =>
            _ = io.seek(p.file, offset: (page - 1) * p.page_size, from: .start)?
            data @ io.read_exact(p.file, n: p.page_size)?

    cache.put(@p.shape, @p.cached_pages, @p.cached_data, @p.cached_at, key: page, value: data, now: 0)
    return ok(data)

# Changes page `page` to `data` in this transaction.
#
# - `p`: the pager, which must be writing.
# - `page`: the page's number.
# - `data`: its new bytes, a page's worth.
#
# Fails `invalid` where no transaction writes, and where a spill cannot be
# written.
function write(@p: Pager, page: i64, data: [u8]) -> ()?
    if !p.writing
        return fail(code: sql.INVALID, msg: "a page written outside a transaction")
    p.dirty[page] @ data

    if p.dirty.len() > p.spill_limit
        for n in sort(keys(p.dirty))
            wal.append(@p.log, page: n, data: p.dirty[n]?, commit_pages: 0)?
            p.spilled[n] @ p.log.frames - 1

        p.dirty @ {}
    return ok()

## The header and the free pages

# The header this connection sees.
#
# - `p`: the pager.
#
# Fails where page 1 cannot be read or is no header.
function read_header(@p: Pager) -> header.Header?
    return header.decode(read(@p, page: 1)?)

function write_header(@p: Pager, h: header.Header) -> ()?
    p.page_count @ h.page_count
    return write(@p, page: 1, data: header.encode(h))

# A page for a new node: the first free one, else one past the last.
#
# - `p`: the pager, which must be writing.
#
# Fails where the free list is damaged or a page cannot be written.
function allocate(@p: Pager) -> i64?
    h @= read_header(@p)?

    if h.free_head == 0
        h.page_count @ h.page_count + 1
        write_header(@p, h: h)?
        return ok(h.page_count)
    page = h.free_head
    h.free_head @ node.next_free(read(@p, page: page)?, page_count: h.page_count)?
    h.free_count @ h.free_count - 1
    write_header(@p, h: h)?
    return ok(page)

# Puts page `page` on the free list.
#
# - `p`: the pager, which must be writing.
# - `page`: a page no tree holds any more.
#
# Fails where a page cannot be written.
function release(@p: Pager, page: i64) -> ()?
    h @= read_header(@p)?
    write(@p, page: page, data: node.free_page(next: h.free_head, page_size: p.page_size))?
    h.free_head @ page
    h.free_count @ h.free_count + 1
    return write_header(@p, h: h)

# Moves the schema's version on: the catalogue changed.
#
# - `p`: the pager, which must be writing.
#
# Fails where the header cannot be read or written.
function bump_schema(@p: Pager) -> ()?
    h @= read_header(@p)?
    h.schema_version @ h.schema_version + 1
    return write_header(@p, h: h)

## Checkpoints

# Copies every committed page of the log into the database file, syncs it,
# and starts the log again; answers how many pages it copied.
#
# - `p`: the pager, which must hold no transaction.
#
# Fails `timeout` where another connection writes or holds a snapshot, and
# where a file cannot be read, written or synced.
function checkpoint(@p: Pager) -> i64?
    if p.writing || p.reading
        return fail(code: sql.INVALID, msg: "a checkpoint inside a transaction")

    if !fs.try_lock(p.writer, exclusive: true)?
        return fail(
            code: sql.TIMEOUT,
            msg: sql.failure_message(database_code: LOCKED, message: "checkpoint deferred: another connection is writing")
        )

    if !fs.try_lock(p.readers, exclusive: true)?
        fs.unlock(p.writer)?
        return fail(
            code: sql.TIMEOUT,
            msg: sql.failure_message(database_code: LOCKED, message: "checkpoint deferred: another connection holds a snapshot")
        )
    copied = copy_log(@p)
    fs.unlock(p.readers)?
    fs.unlock(p.writer)?
    return copied

function copy_log(@p: Pager) -> i64?
    _ = wal.refresh(@p.log)?
    pages = sort(keys(p.log.index))

    for page in pages
        data = wal.read_frame(p.log, frame: p.log.index[page]?, page: page)?
        _ = io.seek(p.file, offset: (page - 1) * p.page_size, from: .start)?
        io.write(p.file, data: data)?

    io.sync(p.file)?
    wal.reset(@p.log)?
    return ok(pages.len())

## Tests

function test_file(name: str) -> str
    folder = "build/minidb-tests"
    fs.make_dir_all(folder).must()
    file = folder + "/" + name

    for suffix in ["", "-wal", "-lock", "-read"]
        if fs.exists(file + suffix).must()
            fs.remove(file + suffix).must()

    return file

function small() -> Options
    return Options(page_size: 512, cache_pages: 4, spill_limit: 3)

function filled(byte: u8) -> [u8]
    out: [u8] @= []

    for _ in range(from: 0, to: 512)
        out @ out.push(byte)

    return out

test "commit: pages read back through the log, then from the file once checkpointed"
    file = test_file("pager-commit.db")
    p @= open(file, options: small()).must().pager
    begin_write(@p).must()
    page = allocate(@p).must()
    write(@p, page: page, data: filled(7)).must()
    assert commit(@p).must().frames == 2
    errors.ignore(close(@p))
    again = open(file, options: small()).must()
    assert again.recovery.committed == 2
    assert again.recovery.transactions == 1
    q @= again.pager
    begin_read(@q).must()
    assert read(@q, page: page).must() == filled(7)
    end_read(@q)
    assert checkpoint(@q).must() == 2
    assert q.log.frames == 0
    begin_read(@q).must()
    assert read(@q, page: page).must() == filled(7)
    end_read(@q)
    errors.ignore(close(@q))

test "rollback: the changed pages forgotten, the spilled frames cut off the log"
    file = test_file("pager-rollback.db")
    p @= open(file, options: small()).must().pager
    begin_write(@p).must()

    for _ in range(from: 0, to: 6)
        page = allocate(@p).must()
        write(@p, page: page, data: filled(1)).must()

    assert p.log.frames > 0
    rollback(@p).must()
    assert p.log.frames == 0
    assert p.page_count == 2
    errors.ignore(close(@p))

test "crash: a transaction's spilled frames and its torn last frame cut off at the next open"
    file = test_file("pager-crash.db")
    p @= open(file, options: small()).must().pager
    begin_write(@p).must()
    kept = allocate(@p).must()
    write(@p, page: kept, data: filled(5)).must()
    _ = commit(@p).must()
    begin_write(@p).must()

    for _ in range(from: 0, to: 6)
        page = allocate(@p).must()
        write(@p, page: page, data: filled(9)).must()

    write(@p, page: kept, data: filled(6)).must()
    cut = crash(@p).must()
    assert cut.torn
    assert cut.frames > 3
    again = open(file, options: small()).must()
    assert again.recovery.committed == 2
    assert again.recovery.discarded == cut.frames
    assert again.recovery.torn
    q @= again.pager
    begin_read(@q).must()
    assert read(@q, page: kept).must() == filled(5)
    assert q.page_count == 3
    end_read(@q)
    errors.ignore(close(@q))

test "begin_write: one writer at a time, and a reader keeps its snapshot until it ends"
    file = test_file("pager-two.db")
    a @= open(file, options: small()).must().pager
    b @= open(file, options: small()).must().pager
    begin_write(@a).must()
    page = allocate(@a).must()
    write(@a, page: page, data: filled(3)).must()
    begin_read(@b).must()
    assert begin_write(@b).is_err()
    _ = commit(@a).must()
    assert b.page_count == 2
    assert checkpoint(@a).is_err()
    end_read(@b)
    begin_read(@b).must()
    assert b.page_count == 3
    assert read(@b, page: page).must() == filled(3)
    end_read(@b)
    errors.ignore(close(@a))
    errors.ignore(close(@b))

test "open: a file that is no database refused, a page size minidb does not write refused"
    file = test_file("pager-other.db")
    write_file(path: file, text: "SQLite format 3").must()
    assert open(file, options: small()).is_err()
    other = test_file("pager-size.db")
    assert open(other, options: Options(page_size: 1000, cache_pages: 4, spill_limit: 3)).is_err()
