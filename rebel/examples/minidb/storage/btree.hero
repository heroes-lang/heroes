# The B+tree every table and index is kept in: keys of bytes in order (a
# table's are its rowids', an index's its columns' and then the rowid's, by
# `values/sortkey`), values in the leaves, separators in the interior pages.
# A page that grows past its size splits in two, its middle key going up;
# a root that splits keeps its page, its halves moving to two new ones, so
# the catalogue's root pages never change. A leaf that empties is freed and
# its separator taken out of its parent; pages that are only underfull are
# not merged, as SQLite merges them, so a tree after many deletes keeps more
# pages than it needs and stays correct. A key appended past every other
# splits its leaf at its end rather than its middle, so rowids inserted in
# order fill their pages, as SQLite's quick balance does.
#
# Every walk is bounded by `MAX_DEPTH`, so a damaged page that names an
# ancestor as its child is refused, never followed for ever.

use <rebel>/bytes
use <rebel>/lists
use <rebel>/sql

use storage/node
use storage/pager

## Trees

# The deepest a tree may be: a page of 512 bytes holds at least four cells,
# so 32 levels are past any database a 64-bit page count reaches.
constant MAX_DEPTH: i64
    32

# A key and its value.
record Entry
    # The key's bytes.
    key: [u8]
    # The value's bytes; empty for an index.
    value: [u8]

# A new, empty tree: a leaf on a page of its own, which stays its root.
#
# - `p`: the pager, which must be writing.
# - `table`: true for a table's tree, false for an index's.
#
# Fails where a page cannot be allocated or written.
function create(@p: pager.Pager, table: bool) -> i64?
    page = pager.allocate(@p)?
    store(@p, page: page, n: node.empty_leaf(table: table))?
    return ok(page)

function load(@p: pager.Pager, page: i64) -> node.Node?
    return node.decode(pager.read(@p, page: page)?, page_count: p.page_count)

function store(@p: pager.Pager, page: i64, n: node.Node) -> ()?
    return pager.write(@p, page: page, data: node.to_page(n, page_size: p.page_size)?)

function too_deep<T>() -> T?
    return fail(code: sql.INVALID, msg: f"a damaged database: a tree deeper than {MAX_DEPTH} levels")

# Where `key` goes among the children of an interior page: the count of its
# keys at or below `key`.
function child_index(n: node.Node, key: [u8]) -> i64
    low @= 0
    high @= n.keys.len()

    while low < high
        middle = (low + high) / 2

        if bytes.compare(a: key, b: n.keys[middle]) < 0
            high @ middle
        else
            low @ middle + 1

    return low

# The first place in `keys` whose key is at or above `key`.
function lower_bound(sorted_keys: [[u8]], key: [u8]) -> i64
    low @= 0
    high @= sorted_keys.len()

    while low < high
        middle = (low + high) / 2

        if bytes.compare(a: sorted_keys[middle], b: key) < 0
            low @ middle + 1
        else
            high @ middle

    return low

## Reading

# The value under `key`.
#
# - `p`: the pager.
# - `root`: the tree's root page.
# - `key`: the key.
#
# Fails `not_found` where the tree holds no such key, and `invalid` where a
# page is damaged.
function get(@p: pager.Pager, root: i64, key: [u8]) -> [u8]?
    page @= root

    for _ in range(from: 0, to: MAX_DEPTH)
        n = load(@p, page: page)?

        if node.is_leaf(n)
            k = lower_bound(n.keys, key: key)

            if k < n.keys.len() && n.keys[k] == key
                return ok(n.values[k])
            return fail(code: sql.NOT_FOUND, msg: "no such key")
        page @ n.children[child_index(n, key: key)]

    return too_deep()

# The keys a scan reads: from `low`, at or above it, to below `high`, or to
# the end where `to_end` says so.
record Span
    # The first key read, or one below it; empty for the first of the tree.
    low: [u8]
    # The first key not read.
    high: [u8]
    # Whether the scan reads to the tree's end, `high` unread.
    to_end: bool

# Every key of the tree.
function whole() -> Span
    return Span(low: [], high: [], to_end: true)

# The entries whose keys fall in `span`, in order.
#
# - `p`: the pager; every page read counts in its counters.
# - `root`: the tree's root page.
# - `span`: the keys read.
#
# Fails `invalid` where a page is damaged.
function scan(@p: pager.Pager, root: i64, span: Span) -> [Entry]?
    found: [Entry] @= []
    visit(@p, page: root, span: span, depth: 0, @found)?
    return ok(found)

function visit(@p: pager.Pager, page: i64, span: Span, depth: i64, @found: [Entry]) -> ()?
    if depth >= MAX_DEPTH
        return too_deep()
    n = load(@p, page: page)?

    if node.is_leaf(n)
        for k in range(from: lower_bound(n.keys, key: span.low), to: n.keys.len())
            if !span.to_end && bytes.compare(a: n.keys[k], b: span.high) >= 0
                return ok()
            found @ found.push(Entry(key: n.keys[k], value: n.values[k]))

        return ok()
    first = child_index(n, key: span.low)
    last @= n.children.len() - 1

    if !span.to_end
        last @ child_index(n, key: span.high)

    for c in range(from: first, to: last + 1)
        visit(@p, page: n.children[c], span: span, depth: depth + 1, @found)?

    return ok()

# The greatest key of the tree, which a table's next rowid follows.
#
# - `p`: the pager.
# - `root`: the tree's root page.
#
# Fails `not_found` for an empty tree.
function last_key(@p: pager.Pager, root: i64) -> [u8]?
    page @= root

    for _ in range(from: 0, to: MAX_DEPTH)
        n = load(@p, page: page)?

        if node.is_leaf(n)
            if n.keys.len() > 0
                return ok(n.keys[n.keys.len() - 1])

            # The rightmost leaf emptied without being freed, the one child
            # left of its parent: the greatest key stands elsewhere.
            every = scan(@p, root: root, span: whole())?

            if every.len() == 0
                return fail(code: sql.NOT_FOUND, msg: "an empty tree")
            return ok(every[every.len() - 1].key)
        page @ n.children[n.children.len() - 1]

    return too_deep()

## Writing

# What an insertion did to a page.
variant Outcome
    # The page took it.
    fitted
    # The page split: its keys from `key` on moved to the page `right`.
    split
        # The first key of the right half, the parent's new separator.
        key: [u8]
        # The right half's page.
        right: i64

# Puts `value` under `key`.
#
# - `p`: the pager, which must be writing.
# - `root`: the tree's root page, which stays its root.
# - `key`: the key.
# - `value`: the value; empty for an index.
# - `replace`: whether a key already there takes the new value; where not,
#   it is refused.
#
# Fails `exists` where the key is there and `replace` is false,
# `does_not_fit` where the key and value pass a quarter of a page, as no
# overflow page takes them, and `invalid` where a page is damaged.
function insert(@p: pager.Pager, root: i64, key: [u8], value: [u8], replace: bool) -> ()?
    size = key.len() + value.len()
    most = node.max_cell(p.page_size)

    if size > most
        return fail(
            code: sql.DOES_NOT_FIT,
            msg: sql.failure_message(database_code: "54000", message: f"a row of {size} bytes passes the {most} a page of {p.page_size} takes: minidb has no overflow pages")
        )

    match insert_at(@p, page: root, key: key, value: value, replace: replace, depth: 0)?
        .fitted => return ok()
        .split s =>
            # The root keeps its page: its left half moves to a new one.
            left = pager.allocate(@p)?
            store(@p, page: left, n: load(@p, page: root)?)?
            kind = node.interior_of(load(@p, page: left)?.kind)
            return store(@p, page: root, n: node.Node(kind: kind, keys: [s.key], values: [], children: [left, s.right]))

function insert_at(@p: pager.Pager, page: i64, key: [u8], value: [u8], replace: bool, depth: i64) -> Outcome?
    if depth >= MAX_DEPTH
        return too_deep()
    n @= load(@p, page: page)?

    if node.is_leaf(n)
        k = lower_bound(n.keys, key: key)

        if k < n.keys.len() && n.keys[k] == key
            if !replace
                return fail(code: sql.EXISTS, msg: "the key is there")
            n.values[k] @ value
            return place(@p, page: page, n: n, appended: false)
        n.keys @ lists.insert(n.keys, at: k, value: key)
        n.values @ lists.insert(n.values, at: k, value: value)
        return place(@p, page: page, n: n, appended: k == n.keys.len() - 1)
    c = child_index(n, key: key)

    match insert_at(@p, page: n.children[c], key: key, value: value, replace: replace, depth: depth + 1)?
        .fitted => return ok(.fitted)
        .split s =>
            n.keys @ lists.insert(n.keys, at: c, value: s.key)
            n.children @ lists.insert(n.children, at: c + 1, value: s.right)
            return place(@p, page: page, n: n, appended: false)

# Writes `n` at `page`, splitting it where it does not fit: a leaf at its
# middle byte, or at its end where `appended`; an interior page at its middle
# key, which goes up.
function place(@p: pager.Pager, page: i64, n: node.Node, appended: bool) -> Outcome?
    if node.size_of(n) <= p.page_size
        store(@p, page: page, n: n)?
        return ok(.fitted)
    count = n.keys.len()
    right_page = pager.allocate(@p)?

    if node.is_leaf(n)
        cut @= middle_cut(n)

        if appended
            cut @ count - 1
        left = node.Node(
            kind: n.kind,
            keys: n.keys.slice(from: 0, to: cut),
            values: n.values.slice(from: 0, to: cut),
            children: []
        )
        right = node.Node(
            kind: n.kind,
            keys: n.keys.slice(from: cut, to: count),
            values: n.values.slice(from: cut, to: count),
            children: []
        )
        store(@p, page: page, n: left)?
        store(@p, page: right_page, n: right)?
        return ok(.split(key: right.keys[0], right: right_page))
    middle = count / 2
    left = node.Node(
        kind: n.kind,
        keys: n.keys.slice(from: 0, to: middle),
        values: [],
        children: n.children.slice(from: 0, to: middle + 1)
    )
    right = node.Node(
        kind: n.kind,
        keys: n.keys.slice(from: middle + 1, to: count),
        values: [],
        children: n.children.slice(from: middle + 1, to: count + 1)
    )
    store(@p, page: page, n: left)?
    store(@p, page: right_page, n: right)?
    return ok(.split(key: n.keys[middle], right: right_page))

# The place that cuts a leaf's bytes in two halves, each keeping a key.
function middle_cut(n: node.Node) -> i64
    total @= 0

    for k in range(from: 0, to: n.keys.len())
        total @ total + n.keys[k].len() + n.values[k].len()

    taken @= 0

    for k in range(from: 0, to: n.keys.len() - 1)
        taken @ taken + n.keys[k].len() + n.values[k].len()

        if taken * 2 >= total
            return k + 1

    return n.keys.len() - 1

# Takes `key` and its value out of the tree.
#
# - `p`: the pager, which must be writing.
# - `root`: the tree's root page.
# - `key`: the key.
#
# Fails `not_found` where the tree holds no such key, and `invalid` where a
# page is damaged.
function remove(@p: pager.Pager, root: i64, key: [u8]) -> ()?
    _ = remove_at(@p, page: root, key: key, depth: 0)?

    # A root left with one child and no key takes that child's place, so
    # the tree is no deeper than it needs.
    for _ in range(from: 0, to: MAX_DEPTH)
        top = load(@p, page: root)?

        if node.is_leaf(top) || top.children.len() > 1
            return ok()
        only = top.children[0]
        store(@p, page: root, n: load(@p, page: only)?)?
        pager.release(@p, page: only)?

    return too_deep()

# Whether the page `page` was left empty.
function remove_at(@p: pager.Pager, page: i64, key: [u8], depth: i64) -> bool?
    if depth >= MAX_DEPTH
        return too_deep()
    n @= load(@p, page: page)?

    if node.is_leaf(n)
        k = lower_bound(n.keys, key: key)

        if k >= n.keys.len() || n.keys[k] != key
            return fail(code: sql.NOT_FOUND, msg: "no such key")
        n.keys @ lists.remove_at(n.keys, at: k)
        n.values @ lists.remove_at(n.values, at: k)
        store(@p, page: page, n: n)?
        return ok(n.keys.len() == 0)
    c = child_index(n, key: key)
    emptied = remove_at(@p, page: n.children[c], key: key, depth: depth + 1)?

    if emptied && n.children.len() > 1
        pager.release(@p, page: n.children[c])?
        n.children @ lists.remove_at(n.children, at: c)
        n.keys @ lists.remove_at(n.keys, at: max_of(a: c - 1, b: 0))
        store(@p, page: page, n: n)?
    return ok(false)

function max_of(a: i64, b: i64) -> i64
    if a > b
        return a
    return b

## The whole tree

# The pages a tree takes, its root first.
#
# - `p`: the pager.
# - `root`: the tree's root page.
#
# Fails `invalid` where a page is damaged or the tree is too deep.
function pages_of(@p: pager.Pager, root: i64) -> [i64]?
    found @= [root]
    level @= [root]

    for _ in range(from: 0, to: MAX_DEPTH)
        below: [i64] @= []

        for page in level
            n = load(@p, page: page)?

            for child in n.children
                below @ below.push(child)

        if below.len() == 0
            return ok(found)

        for page in below
            found @ found.push(page)

        level @ below

    return too_deep()

# Frees every page of a tree, its root's included: a table or an index
# dropped.
#
# - `p`: the pager, which must be writing.
# - `root`: the tree's root page.
#
# Fails where a page is damaged or cannot be written.
function destroy(@p: pager.Pager, root: i64) -> ()?
    for page in pages_of(@p, root: root)?
        pager.release(@p, page: page)?

    return ok()

# What a tree is made of.
record Shape
    # Its levels, 1 for a lone leaf.
    depth: i64
    # Its leaves.
    leaves: i64
    # Its interior pages.
    interiors: i64
    # Its entries.
    entries: i64

# The shape of a tree, every page of it read.
#
# - `p`: the pager.
# - `root`: the tree's root page.
#
# Fails `invalid` where a page is damaged.
function shape_of(@p: pager.Pager, root: i64) -> Shape?
    s @= Shape(depth: 0, leaves: 0, interiors: 0, entries: 0)
    level @= [root]

    for _ in range(from: 0, to: MAX_DEPTH)
        s.depth @ s.depth + 1
        below: [i64] @= []

        for page in level
            n = load(@p, page: page)?

            if node.is_leaf(n)
                s.leaves @ s.leaves + 1
                s.entries @ s.entries + n.keys.len()
            else
                s.interiors @ s.interiors + 1

                for child in n.children
                    below @ below.push(child)

        if below.len() == 0
            return ok(s)
        level @ below

    return too_deep()

# What is wrong with a tree, one line each, none for a sound one: a page of
# the wrong kind, a key outside the bounds its parent gives it, leaves at
# different depths.
#
# - `p`: the pager.
# - `root`: the tree's root page.
# - `table`: whether it is a table's tree.
# - `name`: the table's or index's name, for the lines.
#
# Fails `invalid` where a page cannot be decoded at all.
function problems_of(@p: pager.Pager, root: i64, table: bool, name: str) -> [str]?
    found: [str] @= []
    leaf_depth @= -1
    pages @= [root]
    lows: [[u8]] @= [[]]
    highs: [[u8]] @= [[]]
    open_high @= [true]

    for depth in range(from: 0, to: MAX_DEPTH)
        below: [i64] @= []
        below_lows: [[u8]] @= []
        below_highs: [[u8]] @= []
        below_open: [bool] @= []

        for k in range(from: 0, to: pages.len())
            n = load(@p, page: pages[k])?

            if node.is_table(n) != table
                found @ found.push(f"{name}: page {pages[k]} belongs to another kind of tree")

            for key in n.keys
                if bytes.compare(a: key, b: lows[k]) < 0 || !open_high[k] && bytes.compare(a: key, b: highs[k]) >= 0
                    found @ found.push(f"{name}: page {pages[k]} holds a key outside its parent's bounds")

            if node.is_leaf(n)
                if leaf_depth == -1
                    leaf_depth @ depth
                else if leaf_depth != depth
                    found @ found.push(f"{name}: leaves at depths {leaf_depth} and {depth}")
            else
                for c in range(from: 0, to: n.children.len())
                    below @ below.push(n.children[c])
                    below_lows @ below_lows.push(bound_below(n, c: c, low: lows[k]))
                    below_highs @ below_highs.push(bound_above(n, c: c, high: highs[k]))
                    below_open @ below_open.push(c == n.children.len() - 1 && open_high[k])

        if below.len() == 0
            return ok(found)
        pages @ below
        lows @ below_lows
        highs @ below_highs
        open_high @ below_open

    return too_deep()

function bound_below(n: node.Node, c: i64, low: [u8]) -> [u8]
    if c == 0
        return low
    return n.keys[c - 1]

function bound_above(n: node.Node, c: i64, high: [u8]) -> [u8]
    if c == n.keys.len()
        return high
    return n.keys[c]
