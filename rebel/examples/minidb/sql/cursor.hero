# The parser's place in a statement's tokens: what stands next, a word or a
# symbol taken where it stands, a name read, and a syntax error that says
# where it is and what was expected there, as SQLite says "near".

use <rebel>/sql
use <rebel>/strings

use sql/lexer

## The cursor

# Tokens and the place of the next one.
record Cursor
    # The tokens, the `end` token last.
    tokens: [lexer.Token]
    # The index of the next token.
    at: i64
    # The parameters `?` alone has numbered so far.
    parameters: i64

# A cursor at the first of `tokens`, which ends with the `end` token.
#
# - `tokens`: what `lexer.tokens` answered.
function new(tokens: [lexer.Token]) -> Cursor
    return Cursor(tokens: tokens, at: 0, parameters: 0)

# The next token, not taken.
#
# - `c`: the cursor.
function peek(c: Cursor lent) -> lexer.Token
    return c.tokens[c.at]

# The token `n` places after the next, the `end` token past the last.
#
# - `c`: the cursor.
# - `n`: how many places after the next, from 0.
function ahead(c: Cursor lent, n: i64) -> lexer.Token
    last = c.tokens.len() - 1
    at = c.at + n

    if at >= last
        return c.tokens[last]
    return c.tokens[at]

# Takes the next token and answers it; the `end` token is never passed.
#
# - `c`: the cursor, moved on.
function advance(@c: Cursor) -> lexer.Token
    t = c.tokens[c.at]

    if t.kind != .end
        c.at @ c.at + 1
    return t

# Takes the next token where it is the word `word`; answers whether it did.
#
# - `c`: the cursor.
# - `word`: the word, in upper case.
function accept_word(@c: Cursor, word: str) -> bool
    if lexer.is_word(peek(c), word: word)
        _ = advance(@c)
        return true
    return false

# Takes the next token where it is the symbol `symbol`; answers whether it
# did.
#
# - `c`: the cursor.
# - `symbol`: the symbol's characters.
function accept_symbol(@c: Cursor, symbol: str) -> bool
    if lexer.is_symbol(peek(c), symbol: symbol)
        _ = advance(@c)
        return true
    return false

# Takes the word `word`.
#
# - `c`: the cursor.
# - `word`: the word, in upper case.
#
# Fails `invalid` where another token stands next.
function expect_word(@c: Cursor, word: str) -> ()?
    if accept_word(@c, word: word)
        return ok()
    return refuse(peek(c), expected: word)

# Takes the symbol `symbol`.
#
# - `c`: the cursor.
# - `symbol`: the symbol's characters.
#
# Fails `invalid` where another token stands next.
function expect_symbol(@c: Cursor, symbol: str) -> ()?
    if accept_symbol(@c, symbol: symbol)
        return ok()
    return refuse(peek(c), expected: f"\"{symbol}\"")

# Takes a name, a word no keyword spells or a quoted one, and answers it: a
# word in lower case, a quoted name as written.
#
# - `c`: the cursor.
# - `what`: what the name names, for the message: "a table's name".
#
# Fails `invalid` where a keyword or another token stands next.
function name(@c: Cursor, what: str) -> str?
    t = peek(c)

    if t.kind == .quoted
        _ = advance(@c)
        return ok(t.text)

    if t.kind == .word && !is_reserved(t.text)
        _ = advance(@c)
        return ok(strings.to_lower_ascii(t.text))
    return refuse(t, expected: what)

## Errors

# The SQLSTATE of a statement that does not parse.
constant SYNTAX: str
    "42601"

# A syntax error at `t`: what stands there and what was expected.
#
# - `t`: the token where reading stopped.
# - `expected`: what could stand there, in words.
function refuse<T>(t: lexer.Token, expected: str) -> T?
    return fail(
        code: sql.INVALID,
        msg: sql.failure_message(database_code: SYNTAX, message: f"syntax error at {lexer.place_of(t)}, {near(t)}: expected {expected}")
    )

# Where a syntax error stands, in SQLite's words: `near "FORM"`, or `at the
# end`.
function near(t: lexer.Token) -> str
    if t.kind == .end
        return "at the end"

    if t.kind == .text
        return f"near '{t.text}'"
    return f"near \"{t.text}\""

# The words that are never a name unless quoted.
function is_reserved(word: str) -> bool
    upper = strings.to_upper_ascii(word)

    for w in RESERVED
        if w == upper
            return true

    return false

constant RESERVED: [str]
    [
        "ALL"
        "AND"
        "AS"
        "ASC"
        "BEGIN"
        "BETWEEN"
        "BY"
        "CASE"
        "COMMIT"
        "CREATE"
        "DELETE"
        "DESC"
        "DISTINCT"
        "DROP"
        "ELSE"
        "END"
        "EXISTS"
        "EXPLAIN"
        "FALSE"
        "FROM"
        "GROUP"
        "HAVING"
        "IF"
        "IN"
        "INDEX"
        "INNER"
        "INSERT"
        "INTO"
        "IS"
        "JOIN"
        "KEY"
        "LEFT"
        "LIKE"
        "LIMIT"
        "NOT"
        "NULL"
        "OFFSET"
        "ON"
        "OR"
        "ORDER"
        "OUTER"
        "PRAGMA"
        "PRIMARY"
        "ROLLBACK"
        "SELECT"
        "SET"
        "TABLE"
        "THEN"
        "TRUE"
        "UNIQUE"
        "UPDATE"
        "VALUES"
        "WHEN"
        "WHERE"
    ]

## Tests

test "name: a word in lower case, a quoted name as written, a keyword refused"
    c @= new(lexer.tokens("Users \"Order\" select").must())
    assert name(@c, what: "a name").must() == "users"
    assert name(@c, what: "a name").must() == "Order"

    match name(@c, what: "a table's name")
        .ok _  => assert false
        .err e => assert e.msg == "[42601] syntax error at line 1, column 15, near \"select\": expected a table's name"

test "advance: never passes the end; ahead past the end answers it"
    c @= new(lexer.tokens("a").must())
    assert advance(@c).text == "a"
    assert advance(@c).kind == .end
    assert advance(@c).kind == .end
    assert ahead(c, n: 5).kind == .end

test "expect_symbol: the end of the text named as such"
    c @= new(lexer.tokens("(").must())
    assert !expect_symbol(@c, symbol: "(").is_err()

    match expect_symbol(@c, symbol: ")")
        .ok _  => assert false
        .err e => assert e.msg == "[42601] syntax error at line 1, column 2, at the end: expected \")\""
