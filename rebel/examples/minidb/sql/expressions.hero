# The expressions of minidb's SQL, read by recursive descent in SQLite's
# order of precedence, the loosest first: `OR`, `AND`, `NOT`, the
# comparisons with `IS`, `IN`, `BETWEEN` and `LIKE`, `+ -`, `* / %`, `||`,
# a sign, and the primaries. Input from outside never aborts: a nesting
# deeper than `MAX_DEPTH`, by brackets or by a long chain of operators, is
# refused before the stack it would take is spent.

use <rebel>/numbers
use <rebel>/sql
use <rebel>/strings

use sql/ast
use sql/cursor
use sql/lexer

## Reading

# How deep an expression may nest, in brackets or in operators: SQLite's
# own limit is 1,000; this one is lower, since every level is a frame of
# the parser's and of the evaluator's.
constant MAX_DEPTH: i64
    200

# An expression read from where `c` stands.
#
# - `c`: the cursor, moved past the expression.
#
# Fails `invalid` where no expression stands there, and where it nests
# deeper than `MAX_DEPTH`.
function expression(@c: cursor.Cursor) -> ast.Expr?
    start = cursor.peek(c)
    e = disjunction(@c, depth: 0)?

    if depth_of(e) > MAX_DEPTH
        return too_deep(start)
    return ok(e)

function disjunction(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= conjunction(@c, depth: depth)?

    while cursor.accept_word(@c, word: "OR")
        right = conjunction(@c, depth: depth)?
        left @ .binary(op: .either, args: [left, right])

    return ok(left)

function conjunction(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= negated(@c, depth: depth)?

    while cursor.accept_word(@c, word: "AND")
        right = negated(@c, depth: depth)?
        left @ .binary(op: .both, args: [left, right])

    return ok(left)

function negated(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    if cursor.accept_word(@c, word: "NOT")
        deeper = enter(c, depth: depth)?
        inner = negated(@c, depth: deeper)?
        return ok(.negation(args: [inner]))
    return comparison(@c, depth: depth)

function comparison(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= additive(@c, depth: depth)?

    while true
        t = cursor.peek(c)
        op = comparison_of(t)

        if op.is_err()
            if lexer.is_word(t, word: "IS")
                _ = cursor.advance(@c)
                negated_is = cursor.accept_word(@c, word: "NOT")
                cursor.expect_word(@c, word: "NULL")?
                left @ .is_null(negated: negated_is, args: [left])
                continue
            negated_by = lexer.is_word(t, word: "NOT") && is_postfix(cursor.ahead(c, n: 1))

            if negated_by
                _ = cursor.advance(@c)

            if !is_postfix(cursor.peek(c))
                break
            left @ postfix(@c, operand: left, negated_by: negated_by, depth: depth)?
            continue
        _ = cursor.advance(@c)
        right = additive(@c, depth: depth)?
        left @ .binary(op: op.must(), args: [left, right])

    return ok(left)

# Whether `t` begins `IN`, `BETWEEN` or `LIKE`.
function is_postfix(t: lexer.Token) -> bool
    return lexer.is_word(t, word: "IN") || lexer.is_word(t, word: "BETWEEN") || lexer.is_word(t, word: "LIKE")

# `IN (...)`, `BETWEEN a AND b` or `LIKE p` after `operand`, a `NOT` before
# it already taken.
function postfix(@c: cursor.Cursor, operand: ast.Expr, negated_by: bool, depth: i64) -> ast.Expr?
    if cursor.accept_word(@c, word: "IN")
        cursor.expect_symbol(@c, symbol: "(")?
        members @= [operand]
        members @ members.push(expression_at(@c, depth: depth)?)

        while cursor.accept_symbol(@c, symbol: ",")
            members @ members.push(expression_at(@c, depth: depth)?)

        cursor.expect_symbol(@c, symbol: ")")?
        return ok(.in_list(negated: negated_by, args: members))

    if cursor.accept_word(@c, word: "BETWEEN")
        low = additive(@c, depth: depth)?
        cursor.expect_word(@c, word: "AND")?
        high = additive(@c, depth: depth)?
        return ok(.between(negated: negated_by, args: [operand, low, high]))
    cursor.expect_word(@c, word: "LIKE")?
    pattern = additive(@c, depth: depth)?
    return ok(.like(negated: negated_by, args: [operand, pattern]))

# The comparison `t` spells; fails `not_found` for any other token.
function comparison_of(t: lexer.Token) -> ast.Binary?
    if t.kind != .symbol
        return fail(code: "not_found", msg: "no comparison")

    return match t.text
        "=" | "=="  => ok(.equal)
        "!=" | "<>" => ok(.not_equal)
        "<"         => ok(.less)
        "<="        => ok(.less_equal)
        ">"         => ok(.greater)
        ">="        => ok(.greater_equal)
        _           => fail(code: "not_found", msg: "no comparison")

function additive(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= multiplicative(@c, depth: depth)?

    while true
        op: ast.Binary @= .add

        if cursor.accept_symbol(@c, symbol: "-")
            op @ .subtract
        else if !cursor.accept_symbol(@c, symbol: "+")
            break
        right = multiplicative(@c, depth: depth)?
        left @ .binary(op: op, args: [left, right])

    return ok(left)

function multiplicative(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= concatenation(@c, depth: depth)?

    while true
        op: ast.Binary @= .multiply

        if cursor.accept_symbol(@c, symbol: "/")
            op @ .divide
        else if cursor.accept_symbol(@c, symbol: "%")
            op @ .remainder
        else if !cursor.accept_symbol(@c, symbol: "*")
            break
        right = concatenation(@c, depth: depth)?
        left @ .binary(op: op, args: [left, right])

    return ok(left)

function concatenation(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    left @= signed(@c, depth: depth)?

    while cursor.accept_symbol(@c, symbol: "||")
        right = signed(@c, depth: depth)?
        left @ .binary(op: .concat, args: [left, right])

    return ok(left)

function signed(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    if cursor.accept_symbol(@c, symbol: "+")
        deeper = enter(c, depth: depth)?
        return signed(@c, depth: deeper)

    if !cursor.accept_symbol(@c, symbol: "-")
        return primary(@c, depth: depth)
    t = cursor.peek(c)

    # A minus before an integer is part of it, so the smallest `i64`, whose
    # digits alone do not fit, is read.
    if t.kind == .integer
        _ = cursor.advance(@c)
        return ok(.literal(value: .integer(v: integer_of(t, sign: "-")?)))
    deeper = enter(c, depth: depth)?
    operand = signed(@c, depth: deeper)?
    return ok(.negate(args: [operand]))

function primary(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    t = cursor.peek(c)

    match t.kind
        .integer =>
            _ = cursor.advance(@c)
            return ok(.literal(value: .integer(v: integer_of(t, sign: "")?)))
        .decimal =>
            _ = cursor.advance(@c)
            return ok(.literal(value: .float(v: decimal_of(t)?)))
        .text =>
            _ = cursor.advance(@c)
            return ok(.literal(value: .text(v: t.text)))
        .parameter =>
            _ = cursor.advance(@c)
            return parameter_of(@c, t: t)
        .symbol =>
            if !cursor.accept_symbol(@c, symbol: "(")
                return cursor.refuse(t, expected: "an expression")
            inner = expression_at(@c, depth: depth)?
            cursor.expect_symbol(@c, symbol: ")")?
            return ok(inner)
        .word | .quoted => return named(@c, depth: depth)
        .end            => return cursor.refuse(t, expected: "an expression")

# A literal word, a `CASE`, a call or a column.
function named(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    t = cursor.peek(c)

    if cursor.accept_word(@c, word: "NULL")
        return ok(ast.null_literal())

    if cursor.accept_word(@c, word: "TRUE")
        return ok(.literal(value: .boolean(v: true)))

    if cursor.accept_word(@c, word: "FALSE")
        return ok(.literal(value: .boolean(v: false)))

    if cursor.accept_word(@c, word: "CASE")
        return choice(@c, depth: enter(c, depth: depth)?)

    if t.kind == .word && lexer.is_symbol(cursor.ahead(c, n: 1), symbol: "(")
        _ = cursor.advance(@c)
        _ = cursor.advance(@c)
        return call(@c, function_name: strings.to_upper_ascii(t.text), depth: enter(c, depth: depth)?)
    first = cursor.name(@c, what: "an expression")?

    if !cursor.accept_symbol(@c, symbol: ".")
        return ok(.column(table: "", name: first))
    second = cursor.name(@c, what: "a column's name")?
    return ok(.column(table: first, name: second))

# The arguments of a call after its `(`.
function call(@c: cursor.Cursor, function_name: str, depth: i64) -> ast.Expr?
    if cursor.accept_symbol(@c, symbol: "*")
        cursor.expect_symbol(@c, symbol: ")")?
        return ok(.call(name: function_name, star: true, distinct: false, args: []))
    distinct = cursor.accept_word(@c, word: "DISTINCT")
    given: [ast.Expr] @= []

    if !cursor.accept_symbol(@c, symbol: ")")
        given @ given.push(expression_at(@c, depth: depth)?)

        while cursor.accept_symbol(@c, symbol: ",")
            given @ given.push(expression_at(@c, depth: depth)?)

        cursor.expect_symbol(@c, symbol: ")")?
    return ok(.call(name: function_name, star: false, distinct: distinct, args: given))

# A `CASE` after its word: searched, `CASE WHEN c THEN v`, or simple,
# `CASE x WHEN v THEN r`, whose conditions become `x = v`.
function choice(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    subject: [ast.Expr] @= []

    if !lexer.is_word(cursor.peek(c), word: "WHEN")
        subject @ [expression_at(@c, depth: depth)?]
    parts: [ast.Expr] @= []

    while cursor.accept_word(@c, word: "WHEN")
        condition = expression_at(@c, depth: depth)?
        cursor.expect_word(@c, word: "THEN")?
        parts @ parts.push(compared(subject, condition))
        parts @ parts.push(expression_at(@c, depth: depth)?)

    if parts.len() == 0
        return cursor.refuse(cursor.peek(c), expected: "WHEN")
    otherwise @= ast.null_literal()

    if cursor.accept_word(@c, word: "ELSE")
        otherwise @ expression_at(@c, depth: depth)?
    cursor.expect_word(@c, word: "END")?
    parts @ parts.push(otherwise)
    return ok(.choice(args: parts))

function compared(subject: [ast.Expr], condition: ast.Expr) -> ast.Expr
    if subject.len() == 0
        return condition
    return .binary(op: .equal, args: [subject[0], condition])

## Literals

function integer_of(t: lexer.Token, sign: str) -> i64?
    match numbers.parse_int(sign + t.text)
        .ok n => return ok(n)
        .err _ => return fail(
            code: sql.DOES_NOT_FIT,
            msg: sql.failure_message(database_code: "22003", message: f"at {lexer.place_of(t)}: the integer {sign}{t.text} does not fit in 64 bits")
        )

function decimal_of(t: lexer.Token) -> f64?
    match numbers.parse_float(t.text)
        .ok x  => return ok(x)
        .err _ => return cursor.refuse(t, expected: "a number")

# `?N`, or `?` alone numbered after the last one numbered so.
function parameter_of(@c: cursor.Cursor, t: lexer.Token) -> ast.Expr?
    if t.text == ""
        c.parameters @ c.parameters + 1
        return ok(.parameter(number: c.parameters))

    match numbers.parse_int(t.text)
        .ok n =>
            if n < 1 || n > 999
                return cursor.refuse(t, expected: "a parameter from ?1 to ?999")
            return ok(.parameter(number: n))
        .err _ => return cursor.refuse(t, expected: "a parameter from ?1 to ?999")

## Depth

# An expression inside brackets, a list or a call: one level deeper.
function expression_at(@c: cursor.Cursor, depth: i64) -> ast.Expr?
    return disjunction(@c, depth: enter(c, depth: depth)?)

# The depth one level below `depth`; fails where that passes `MAX_DEPTH`.
function enter(c: cursor.Cursor lent, depth: i64) -> i64?
    if depth >= MAX_DEPTH
        return too_deep(cursor.peek(c))
    return ok(depth + 1)

function too_deep<T>(t: lexer.Token) -> T?
    return fail(
        code: sql.LIMIT,
        msg: sql.failure_message(database_code: "54001", message: f"at {lexer.place_of(t)}: the expression nests deeper than {MAX_DEPTH} levels")
    )

# How deep `e` nests, counted with a stack of its own rather than the
# program's, so a chain of a million operators is measured without
# recursion. A `[T]` has no pop that shrinks it in place, so the stack is a
# list and the count of its live entries; a push past them grows it.
#
# - `e`: the expression.
function depth_of(e: ast.Expr) -> i64
    pending @= [e]
    depths @= [1]
    live @= 1
    deepest @= 0

    while live > 0
        live @ live - 1
        next_expr = pending[live]
        at = depths[live]

        if at > deepest
            deepest @ at

        for child in children_of(next_expr)
            if live < pending.len()
                pending[live] @ child
                depths[live] @ at + 1
            else
                pending @ pending.push(child)
                depths @ depths.push(at + 1)
            live @ live + 1

    return deepest

# The expressions directly under `e`.
#
# - `e`: the expression.
function children_of(e: ast.Expr) -> [ast.Expr]
    return match e
        .literal _ | .column _ | .parameter _ => []
        .negate n                             => n.args
        .negation n                           => n.args
        .binary b                             => b.args
        .is_null n                            => n.args
        .in_list l                            => l.args
        .between b                            => b.args
        .like l                               => l.args
        .choice c                             => c.args
        .call c                               => c.args
