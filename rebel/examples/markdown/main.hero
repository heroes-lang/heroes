# The twin of `examples/markdown/`: Markdown to plain text, written with
# Rebel. It prints byte for byte what `examples/markdown/` prints from the
# same arguments, so that program's `main.expected` is this one's test too.
#
#     heroes run rebel/examples/markdown/main.hero -- examples/markdown/sample.md
#     heroes run rebel/examples/markdown/main.hero -- examples/markdown/sample.md outline
#
#     main.hero     the program: arguments, the file, the two views
#     render.hero   blocks out, lines in
#     inline.hero   one block's inlines, with their markup removed
#
# What Rebel does here that `examples/markdown/` writes for itself:
#
# - `markdown.parse_with` reads the text as CommonMark 0.31.2 into a tree of
#   nodes, in place of that program's own block grammar in its `blocks.hero`
#   (its `Block` variant, the line tests, the numbered marker, the paragraph
#   and fence readers) and its inline scanner in `inline.hero`;
# - `strings.lines` cuts a code block into its lines, in place of its
#   `strings.hero` (`split_lines`, `trim_space`, `has_prefix`).
#
# What stays this program's own is the plain-text page: a heading underlined,
# the list markers rewritten, a quote after `|`, code indented, the blank line
# between blocks that are not one run, and the outline view.
#
# Where the two read a text otherwise, none of it in that program's sample:
# this one reads CommonMark, so lines of one quote are one paragraph (`> a`
# then `> b` is `| a b`, where that program writes two quoted lines), a list
# numbers its items from its first (`1.` then `1.` is 1 and 2), a list and a
# quote nest, an autolink `<http://x>` is a link, and a link's destination is
# percent-encoded; that program reads each line by its first characters alone.

use <rebel>/markdown

use inline
use render

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"markdown: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    given = text_arguments()

    if given.len() == 0
        print("usage: markdown <file.md> [outline]")
        exit(code: 2)

    match read_file(given[0])
        .err e     => stop("cannot read " + given[0] + ": " + e.code)
        .ok source => show(source, given)

# Every unhappy ending in one place, so the exit code is decided once.
#
# - `message`: what is printed before the program ends with 1.
function stop(message: str)
    print(message)
    exit(code: 1)

# The document printed as the command line asks: the page, or its outline.
#
# - `source`: the file's Markdown.
# - `given`: the command line, its second word `outline` for the outline.
function show(source: str, given: [str])
    doc = markdown.parse_with(source, render.options())

    if given.len() > 1 && given[1] == "outline"
        for line in headings(doc)
            print(line)
    else
        write(render.render(doc))

# The headings alone, indented by their level: the view that answers "what is
# in this document" without reading it. A heading inside a list or a quote is
# part of that block's text, not of the outline.
#
# - `doc`: the document.
function headings(doc: markdown.Document) -> [str]
    out: [str] @= []

    for node in markdown.children(doc, markdown.ROOT)
        match markdown.node_of(doc, node)
            .heading h => out @ out.push(repeat("  ", (h.level - 1).to_u64().must()) + inline.plain(doc, node))
            .document | .block_quote | .list _ | .item _ | .paragraph | .thematic_break | .code_block _ | .html_block _ | .table _ | .table_row _ | .table_cell _ | .text _ | .soft_break | .line_break | .code _ | .emphasis | .strong | .strikethrough | .link _ | .image _ | .html_inline _ => continue

    return out

# The rendered text, printed exactly once.
#
# `render` ends its text in a newline and `print` adds exactly one of its own
# (spec § 11), so the last one is dropped here rather than left to double.
# The empty document is its own case: there is no last character to drop.
#
# - `text`: the page, as `render.render` writes it.
function write(text: str)
    if text == ""
        print("(nothing but markup)")
    else
        print(text.slice(from: 0, to: text.len() - 1))

test "the sample renders through both views"
    source = read_file("examples/markdown/sample.md").must()
    doc = markdown.parse_with(source, render.options())
    assert headings(doc) == ["Heroes", "  Why it exists", "  What it refuses"]
    assert render.render(doc).len() > source.len() - 40

test "an argument that is not `outline` is a file that is not there"
    assert read_file("examples/markdown/no-such-file.md").is_err()
