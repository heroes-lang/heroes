# The table read back from its file: text in, typed rows out, and a named
# refusal for every way the text can be wrong.
#
# This module is the other half of `data/row.hero`: the program writes five
# thousand rows and reads them back, so every conversion is exercised in both
# directions on data the program made. It reads a shape it generated, so it
# can afford to be **strict**: a field that is not a number is a refusal
# naming the line and the column, not a zero. A reader that answers `0` for a
# field it could not parse turns a broken file into a wrong answer, so every
# conversion here is a `T?` propagated with `?`, and the first bad field in a
# five-thousand-line file stops the read and says where.
#
# The CSV itself is read by `csv.parse_with`, which takes a quoted field as
# RFC 4180 writes one; each field is then held to the shape the writer gives
# it.

use <rebel>/csv
use <rebel>/numbers
use <rebel>/strings

use data/row

## Error codes

# A first line that is not the header this program writes.
constant ERR_HEADER: str
    "bad_header"

# A row of another number of fields than the header's.
constant ERR_FIELDS: str
    "bad_field_count"

# A number field that is no number of its column's shape.
constant ERR_NUMBER: str
    "bad_number"

# A boolean field that is neither `true` nor `false`.
constant ERR_BOOL: str
    "bad_bool"

# A text with no line at all.
constant ERR_EMPTY: str
    "empty_table"

# A text that is not CSV.
constant ERR_CSV: str
    "bad_csv"

# `true` or `false`, and nothing else. A third spelling is a refusal rather
# than a guess, because guessing here is how a column silently becomes all
# false.
#
# - `text`: the field.
# - `line`: its line, from 1, for the message.
#
# Fails `bad_bool` on any other text.
function bool_of(text: str, line: i64) -> bool?
    if text == "true"
        return ok(true)

    if text == "false"
        return ok(false)
    return fail(code: ERR_BOOL, msg: "line " + line.to_str() + ": `" + text + "` is neither `true` nor `false`")

# An `i64`, saying which line it was on where the field is no integer.
#
# - `text`: the field.
# - `line`: its line, from 1, for the message.
#
# Fails `bad_number` where it is empty, holds anything but an optional sign
# and digits, or lies past an `i64`.
function int_of(text: str, line: i64) -> i64?
    if text.len() == 0
        return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": a number field is empty")

    match numbers.parse_int(text)
        .ok n  => return ok(n)
        .err e => return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": " + e.msg)

# An `f64`, read back from the text `to_str` wrote for it and rounded ONCE, to
# the nearest `f64`, by `numbers.parse_float`. `to_str` writes the digits that
# make a float read back as the same value (spec § 11), up to seventeen
# significant ones or an exponent, and one rounding from those digits lands
# on the value written, for every `f64`.
#
# - `text`: the field.
# - `line`: its line, from 1, for the message.
#
# Fails `bad_number` where the field is not written as `to_str` writes an
# `f64` (`float_shape`), and where it lies past the largest `f64`:
# `numbers.parse_float` reads such a text as an infinity, as Python's `float`
# does, and this table never writes one but as `inf`.
function float_of(text: str, line: i64) -> f64?
    float_shape(text, line)?

    match numbers.parse_float(text)
        .ok value =>
            # An infinity is the one number, `nan` aside, that taken from
            # itself is not 0; written as digits, it was past the largest.
            if value - value != 0.0 && text != "inf" && text != "-inf" && text != "nan"
                return fail(
                    code: ERR_NUMBER,
                    msg: "line " + line.to_str() + ": \"" + text + "\" lies past the largest f64"
                )
            return ok(value)
        .err e => return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": " + e.msg)

# Nothing, where `text` is written as `to_str` writes an `f64`, and else a
# refusal naming the line and what was found. **The shape is the table's**,
# so `numbers.parse_float`'s wider reading does not leak into it: an optional
# `-`, digits, then optionally a point and digits, then optionally `e`, a sign
# and digits; or `inf`, `-inf` or `nan`. `1_000`, `0x1p3`, `.5`, `5.`, `+2`
# and `Infinity` are refused, because the writer never makes them and a
# reader that guesses is how a broken file becomes a wrong answer.
#
# - `text`: the field.
# - `line`: its line, from 1, for the message.
function float_shape(text: str, line: i64) -> ()?
    if text == "inf" || text == "-inf" || text == "nan"
        return ok()

    if text.len() == 0
        return fail(code: ERR_NUMBER, msg: "line " + line.to_str() + ": a number field is empty")
    said = "line " + line.to_str() + ": `" + text + "` "
    at: i64 @= 0

    if text[0] == '-'
        at @ 1
    whole_end = digits_end(text, from: at)

    if whole_end == at
        return fail(code: ERR_NUMBER, msg: said + "is not a number: no digit opens it")
    at @ whole_end

    if at < text.len() && text[at] == '.'
        fraction_end = digits_end(text, from: at + 1)

        if fraction_end == at + 1
            return fail(code: ERR_NUMBER, msg: said + "ends its point with no digit after it")
        at @ fraction_end

    if at < text.len() && text[at] == 'e'
        if at + 1 == text.len() || text[at + 1] != '+' && text[at + 1] != '-'
            return fail(code: ERR_NUMBER, msg: said + "has no sign after its `e`")
        exponent_end = digits_end(text, from: at + 2)

        if exponent_end == at + 2
            return fail(code: ERR_NUMBER, msg: said + "has no digit in its exponent")
        at @ exponent_end

    # Every byte before `at` is ASCII, a sign, a digit, the point or the
    # exponent's, so both slices below cut between two characters.
    if at < text.len()
        return fail(
            code: ERR_NUMBER,
            msg: said + "is not a number: `" + text.slice(from: at, to: text.len()) + "` follows `" + text.slice(from: 0, to: at) + "`"
        )
    return ok()

# The first index at or after `from` that holds no decimal digit, or the
# text's length where digits run to its end.
#
# - `text`: the field.
# - `from`: where to begin, a byte index within it or its length.
function digits_end(text: str, from: i64) -> i64
    at: i64 @= from

    while at < text.len() && text[at] >= '0' && text[at] <= '9'
        at @ at + 1

    return at

# How the table is read: RFC 4180's CSV, rows of any length, so that a row of
# the wrong length is this module's refusal, naming both counts.
function read_options() -> csv.ReadOptions
    o: csv.ReadOptions @= csv.strict_read_options()
    o.ragged @ true
    return o

# The whole table. The header is checked against the one this program
# writes, because a file whose columns moved is a file this reader would
# otherwise read in the wrong order and answer confidently about.
#
# - `text`: the file's text.
#
# Fails `bad_csv` where it is not CSV, `empty_table` where it holds no line,
# `bad_header` where its first line is not the header, and as the field
# readers fail on the first field that is wrong.
function read(text: str) -> [row.Row]?
    lines = match csv.parse_with(text, read_options())
        .ok rows => rows
        .err e   => return fail(code: ERR_CSV, msg: e.msg)

    if lines.len() == 0
        return fail(code: ERR_EMPTY, msg: "the table is empty: not even a header")

    if lines[0] != row.HEADER
        return fail(
            code: ERR_HEADER,
            msg: "the header reads `" + join(lines[0], ",") + "` and this program writes `" + join(row.HEADER, ",") + "`"
        )
    out: [row.Row] @= []
    wanted = row.HEADER.len()

    for at in range(from: 1, to: lines.len())
        number = at + 1
        fields = lines[at]

        if fields.len() != wanted
            return fail(
                code: ERR_FIELDS,
                msg: "line " + number.to_str() + ": " + fields.len().to_str() + " fields where the header has " + wanted.to_str()
            )
        out @ out.push(
            row.Row(id: int_of(fields[0], number)?, team: fields[1], name: fields[2], active: bool_of(fields[3], number)?, score: int_of(fields[4], number)?, rate: float_of(fields[5], number)?)
        )

    return ok(out)

test "the round trip is exact for every field, including the float"
    made = row.generated(50)
    assert read(row.written(made)).must() == made

test "a number that is not one stops the read and names its line"
    match read("id,team,name,active,score,rate\n1,argo,p1,true,x,1.5\n")
        .ok _ => assert false
        .err e =>
            assert e.code == ERR_NUMBER
            assert strings.contains(s: e.msg, substr: "line 2")

test "a third spelling of a boolean is refused rather than guessed"
    assert code_of("id,team,name,active,score,rate\n1,argo,p1,yes,10,1.5\n") == ERR_BOOL

test "a header that moved is refused before a single row is read"
    assert code_of("id,name,team,active,score,rate\n1,argo,p1,true,10,1.5\n") == ERR_HEADER

test "a short row is refused with both counts in the message"
    match read("id,team,name,active,score,rate\n1,argo,p1,true,10\n")
        .ok _ => assert false
        .err e =>
            assert e.code == ERR_FIELDS
            assert strings.contains(s: e.msg, substr: "5 fields where the header has 6")

test "a text that is not CSV, and one with no line, are refused by name"
    assert code_of("id,\"team\n") == ERR_CSV
    assert code_of("") == ERR_EMPTY

test "the pieces answer what they are asked, and refuse what they are not"
    assert int_of("0", 1).must() == 0
    assert int_of("-42", 1).must() == -42

    for text in ["", "-", "1 "]
        assert int_of(text, 1).is_err()

    assert float_of("2", 1).must() == 2.0
    assert float_of("2.5", 1).must() == 2.5
    assert float_of("-0.25", 1).must() == -0.25
    assert float_of("2.", 1).is_err()
    assert float_of("2.5.5", 1).is_err()

test "a decimal past 53 bits of digits is rounded once, to the nearest f64"
    assert float_of("1835852425.7146973", 1).must().to_str() == "1835852425.7146974"
    assert float_of("-1835852425.7146973", 1).must().to_str() == "-1835852425.7146974"
    assert float_of("123456789012345678", 1).must() == 123456789012345678.0

test "every text `to_str` writes reads back as the value it was written from"
    written = [
        "1835852425.7146974"
        "0.30000000000000004"
        "1.64"
        "0.012345678901234567"
        "0.00012345678901234567"
        "1e-05"
        "1e+21"
        "1.2345678901234568e+17"
        "5e-324"
        "2.2250738585072014e-308"
        "1.7976931348623157e+308"
        "-0.0"
        "inf"
        "-inf"
        "nan"
    ]

    for text in written
        assert float_of(text, 1).must().to_str() == text

    # And the values the other way, written by `to_str` and read through the
    # table, which is the route `main` takes. `nan` stays out of the table: it
    # equals nothing, so a table holding one never equals itself.
    values = [1835852425.7146974, 0.1 + 0.2, to_f64(164) / 100.0, 1.0 / 0.0, 0.0, -0.0]
    rows: [row.Row] @= []

    for v in values
        assert float_of(v.to_str(), 1).must().to_str() == v.to_str()
        rows @ rows.push(row.Row(id: rows.len() + 1, team: "argo", name: "p1", active: true, score: 0, rate: v))

    assert read(row.written(rows)).must() == rows

test "a text `to_str` never writes is refused, naming its line"
    never = [
        "1_000"
        "0x1p3"
        ".5"
        "5."
        "+2"
        "Infinity"
        "INF"
        "1e5"
        "1E+05"
        "1e+"
        "1e+05x"
        " 1"
        "1 "
        "2.5.5"
        "-"
        "--1"
        ""
    ]

    for text in never
        match float_of(text, 7)
            .ok _  => assert false
            .err e => assert e.code == ERR_NUMBER && strings.contains(s: e.msg, substr: "line 7: ")

    match float_of("2.5.5", 7)
        .ok _  => assert false
        .err e => assert e.msg == "line 7: `2.5.5` is not a number: `.5` follows `2.5`"

test "a number past the largest f64 is refused, naming its line"
    match float_of("1e+309", 3)
        .ok _  => assert false
        .err e => assert e.code == ERR_NUMBER && e.msg == "line 3: \"1e+309\" lies past the largest f64"

# The code `read` fails with on `text`, or `no_error`.
#
# - `text`: a table's text.
function code_of(text: str) -> str
    return match read(text)
        .ok _  => "no_error"
        .err e => e.code
