# Reaches Rebel's package `websocket`, so that `heroes test` on this file runs
# the tests of its face and its private modules (spec § 12). It prints the
# `Sec-WebSocket-Accept` of RFC 6455's own example key on every run, touching
# no network.

use <rebel>/websocket

function main()
    print(websocket.accept_key("dGhlIHNhbXBsZSBub25jZQ=="))
