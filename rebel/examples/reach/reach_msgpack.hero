# Reaches Rebel's `msgpack`, so that `heroes test` on this file runs the
# package's own tests (spec § 12). It prints the map `{"a": 1, "b": [2, 3]}`
# decoded from its MessagePack bytes and written as JSON text.

use <rebel>/json
use <rebel>/msgpack

function main()
    data: [u8] = [0x82, 0xa1, 0x61, 0x01, 0xa1, 0x62, 0x92, 0x02, 0x03]

    match msgpack.decode(data)
        .ok v =>
            match msgpack.to_json(v)
                .ok j  => print(json.format(j).default(""))
                .err e => print(f"{e.code}: {e.msg}")
        .err e => print(f"{e.code}: {e.msg}")
