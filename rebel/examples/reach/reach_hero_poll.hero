# Reaches Rebel's floor over the platform layer's readiness sets,
# `hero_poll.h`, so that `heroes test` on this file runs the floor's own tests
# (spec § 12, § 13). It makes a set of one entry, closes it, and prints the 0
# the close answers.

use <rebel>/poll/hero_poll

function main()
    set @= hero_poll.make(1)
    print(hero_poll.close(@set))
