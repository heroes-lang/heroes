# Reaches Rebel's `audio`, so that `heroes test` on this file runs the
# package's tests (spec § 12). It prints the bytes of the WAV file of a
# hundredth of a second of 16-bit silence at 8000 frames a second, or the code
# it fails with.

use <rebel>/audio
use <rebel>/time

function main()
    f = audio.Format(encoding: .pcm16, rate: 8000, channels: 1, speakers: 0)
    ten = time.milliseconds(10)

    match audio.silence(f, length: ten)
        .ok s =>
            match audio.encode_wav(s)
                .ok file => print(file.len())
                .err e   => print(e.code)
        .err e => print(e.code)
