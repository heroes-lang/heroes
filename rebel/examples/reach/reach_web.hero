# Reaches Rebel's package `web`, so that `heroes test` on this file runs the
# tests of its face and its private modules (spec § 12). It prints the media
# type `web.sniff` reads in the first bytes of a page,
# `text/html; charset=utf-8`, on every run, touching no network and no file.
#
# It also holds the two shapes of a program that serves, as a program writes
# them: `app`, the one function of a program with no state, which `web.serve`
# calls with the router; and `serve_conn`, the loop of a program with state,
# which hands each request to `web/chain.dispatch` with its `App` by `@`: a
# step every route runs counts the requests, and each route was bound at its
# `add` to the function that answers it, a writer or a reader, in the
# program's own table. Their tests run them on
# the loopback, and so does the test of a reverse proxy of `web/proxy`,
# which passes a request to `app` served on a thread of its own and its
# answer back; so `heroes test` on this file runs `web/proxy`'s tests too,
# which `reach_web_proxy.hero` runs alone.

use <rebel>/http
use <rebel>/io
use <rebel>/net
use <rebel>/web
use <rebel>/web/chain
use <rebel>/web/proxy

# A program's state: its routes, its two tables, and the counts it keeps
# between requests.
record App
    # The routes, each bound in `answers`, made once by `new_app`.
    router: web.Router
    # The program's steps, by their names.
    steps: {str: (function(@App, chain.Next, http.Request) -> http.Response?)}
    # The function that answers each route, by the route's name.
    answers: {str: (function(@App, web.Found, http.Request) -> http.Response?)}
    # How many requests the step `count` has seen.
    requests: i64
    # How many visits `POST /visits` has counted.
    visits: i64

# The program's routes.
function routes() -> web.Router
    rt @= web.new_router()
    web.add(@rt, method: http.METHOD_GET, pattern: "/", name: "home").must()
    web.add(@rt, method: http.METHOD_GET, pattern: "/users/:id", name: "user").must()
    web.add(@rt, method: http.METHOD_POST, pattern: "/visits", name: "visit").must()
    return rt

# The handler of a program with no state: the request routed, the route's
# name dispatched on, a request no route takes answered by `not_routed`.
function app(router: web.Router, r: http.Request) -> http.Response
    match web.route(router, r)
        .err _ => return web.not_routed(router, r)
        .ok found =>
            match found.name
                "home" => return http.respond_text(http.STATUS_OK, text: "home")
                "user" => return http.respond_text(
                    http.STATUS_OK,
                    text: "user " + web.param_of(found, name: "id")
                )
                _ => return web.error_response(
                    router.errors,
                    status: http.STATUS_NOT_IMPLEMENTED,
                    message: "not written yet"
                )

# The state of a program with state: the routes of `routes`, each bound to
# what answers it, and the step `count` every route runs.
function new_app() -> App
    made @= App(router: web.new_router(), steps: {}, answers: {}, requests: 0, visits: 0)
    router @= made.router
    chain.add_step(@router, @made.steps, name: "count", step: count).must()
    chain.on(@router, @made.answers, method: http.METHOD_GET, pattern: "/", name: "home", answer: as_app).must()
    chain.on(
        @router,
        @made.answers,
        method: http.METHOD_GET,
        pattern: "/users/:id",
        name: "user",
        answer: as_app
    ).must()
    chain.on(@router, @made.answers, method: http.METHOD_POST, pattern: "/visits", name: "visit", answer: visit).must()
    made.router @ router
    return made

# Every route's step: the request counted, then the rest of its chain.
function count(@state: App, n: chain.Next, r: http.Request) -> http.Response?
    state.requests @ state.requests + 1
    return chain.proceed(@state, steps: state.steps, answers: state.answers, n: n, r: r)

# A visit counted, with the program's own state lent by `@`.
function visit(@state: App, found: web.Found, r: http.Request) -> http.Response?
    _ = found
    _ = r
    state.visits @ state.visits + 1
    return ok(http.respond_text(http.STATUS_OK, text: to_str(state.visits)))

# Every other route, answered as `app` answers it, the state only read.
function as_app(state: App lent, found: web.Found, r: http.Request) -> http.Response?
    _ = found
    return ok(app(state.router, r))

# The loop of a program with state over one connection's stream: each request
# read, answered through its route's chain with `state`, until the connection
# ends; answers how many were answered. A function that fails is answered 500.
function serve_conn(@state: App, stream: io.Stream) -> i64
    reader @= io.reader(stream)
    answered: i64 @= 0

    while true
        r = match http.next_request(@reader, limits: http.default_limits())
            .ok got => got
            .err _  => return answered

        response = match chain.dispatch(@state, router: state.router, steps: state.steps, answers: state.answers, r: r)
            .ok got => got
            .err _ => web.error_response(
                state.router.errors,
                status: http.STATUS_INTERNAL_SERVER_ERROR,
                message: "Internal Server Error"
            )

        match http.write_answer(reader.stream, r: r, response: response)
            .ok _  => answered @ answered + 1
            .err _ => return answered

        if r.closing || response.closing
            return answered

# An upstream for the proxy's test: one connection accepted on the loopback,
# its port told on `ports`, served by `app`; answers how many it answered.
function upstream_once(ports: (mailbox i64)) -> i64
    l @= net.listen(host: "127.0.0.1", port: 0).must()
    _ = ports.send(l.address.port).is_err()
    conn @= net.accept(l, deadline_ms: 5_000).must()
    net.close_listener(@l).must()
    answered = web.serve_stream(http.default_server(), stream: conn.stream, remote: "", router: routes(), handler: app)
    io.close(@conn.stream).must()
    return answered

function main()
    print(web.sniff([60, 104, 116, 109, 108, 62]))

test "app: a program with no state served on the loopback"
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET /users/7 HTTP/1.1\r\nHost: h\r\n\r\nPUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    ).must()
    assert web.serve_stream(http.default_server(), stream: two.second.stream, remote: "", router: routes(), handler: app) == 2
    reader @= io.reader(two.first.stream)
    first = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    second = http.read_response(@reader, method: "PUT", limits: http.default_limits()).must()
    assert http.text_of(first).must() == "user 7" && second.status == 405 && http.value_of(second.headers, name: "Allow").must() == "GET, HEAD, OPTIONS"
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_conn: a program's state counted across its requests"
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "POST /visits HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\n\r\nPOST /visits HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    ).must()
    state @= new_app()
    assert serve_conn(@state, stream: two.second.stream) == 2 && state.visits == 2 && state.requests == 2
    reader @= io.reader(two.first.stream)
    _ = http.read_response(@reader, method: "POST", limits: http.default_limits()).must()
    assert http.text_of(http.read_response(@reader, method: "POST", limits: http.default_limits()).must()).must() == "2"
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_conn: a program's loop answers 100 Continue, and 431 for a head past the limits"
    two @= net.pair(deadline_ms: 5_000).must()
    long = "x".repeat(to_u64(70_000).must())
    io.write_text(
        two.first.stream,
        text: "POST /visits HTTP/1.1\r\nHost: h\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nhiGET / HTTP/1.1\r\nHost: h\r\nX-Long: " + long + "\r\n\r\n"
    ).must()
    state @= new_app()
    assert serve_conn(@state, stream: two.second.stream) == 1 && state.visits == 1
    reader @= io.reader(two.first.stream)
    assert io.read_line(@reader).must() == "HTTP/1.1 100 Continue"
    _ = io.read_line(@reader).must()
    assert http.text_of(http.read_response(@reader, method: "POST", limits: http.default_limits()).must()).must() == "1"
    assert http.read_response(@reader, method: "GET", limits: http.default_limits()).must().status == 431
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()

test "serve_stream: a program's own reverse proxy passes a request to its upstream and the answer back"
    ports: (mailbox i64) = mailbox()
    up = spawn(upstream_once, ports).must()
    port = ports.receive(within_ms: 5_000).must()
    state @= proxy.new_state(proxy.reverse_proxy([proxy.upstream(f"http://127.0.0.1:{port}", weight: 1).must()])).must()
    two @= net.pair(deadline_ms: 5_000).must()
    io.write_text(
        two.first.stream,
        text: "GET /users/7 HTTP/1.1\r\nHost: shop.example\r\nConnection: close\r\n\r\n"
    ).must()
    served = proxy.serve_stream(@state, stream: two.second.stream, remote: "192.0.2.1:5000")
    assert served.requests == 1 && served.relayed == 1 && served.refused == 0
    reader @= io.reader(two.first.stream)
    answer = http.read_response(@reader, method: "GET", limits: http.default_limits()).must()
    assert http.text_of(answer).must() == "user 7" && answer.closing
    assert up.wait() == 1
    io.close(@two.second.stream).must()
    io.close(@reader.stream).must()
