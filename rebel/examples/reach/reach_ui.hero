# Reaches Rebel's `ui`, so that `heroes test` on this file runs the
# package's own tests (spec § 12), and shows it at work: one window holding
# every kind of widget, a person's session given by the program itself
# (`ui.inject`), each event printed as `wait` answers it, the state the
# person left read back, a question answered, and the app closed.
#
# With no argument it runs on the headless side and prints the same lines on
# every machine, the window drawn as text first. With `--native` it opens
# the system's own widgets (AppKit on macOS, Win32's controls on Windows, GTK
# 4 elsewhere), drives the same session through the system's own paths, a
# button pressed by `performClick`, `BM_CLICK` or its `clicked` signal and
# the like, and prints the same events and state; the window shows for the
# moment the session takes.

use <rebel>/image
use <rebel>/threads
use <rebel>/time
use <rebel>/ui

# The widgets of the window, as the program keeps them.
record Widgets
    # The window.
    window: ui.Widget
    # The button that counts.
    button: ui.Widget
    # The name typed.
    name: ui.Widget
    # The note typed.
    note: ui.Widget
    # The checkbox.
    wrap: ui.Widget
    # The sizes.
    size: ui.Widget
    # The fruits, several of which may be chosen.
    fruits: ui.Widget
    # The days.
    day: ui.Widget
    # The progress made.
    done: ui.Widget
    # The volume.
    volume: ui.Widget
    # The File menu's item Open.
    open_item: ui.Widget

# Makes the window and every widget in it.
function made(@app: ui.App) -> Widgets?
    w = ui.window(@app, title: "Rebel ui", width: 420, height: 300)?
    file = ui.menu(@app, into: w, title: "File")?
    open_item = ui.menu_item(@app, into: file, text: "Open")?
    ui.set_shortcut(@app, item: open_item, shortcut: ui.Shortcut(key: "o", primary: true, shift: false, alt: false))?
    _ = ui.menu_separator(@app, into: file)?
    form = ui.grid(@app, into: w, columns: 2)?
    _ = ui.label(@app, into: form, text: "Name")?
    name = ui.text_field(@app, into: form, text: "")?
    _ = ui.label(@app, into: form, text: "Day")?
    day = ui.combo(@app, into: form, items: ["Monday", "Tuesday", "Wednesday"])?
    choices = ui.row(@app, into: w)?
    size = ui.radio_group(@app, into: choices, items: ["Small", "Large"])?
    fruits = ui.list(@app, into: choices, items: ["apple", "pear", "plum"], multiple: true)?
    note = ui.text_area(@app, into: choices, text: "")?
    wrap = ui.checkbox(@app, into: w, text: "Wrap lines", checked: false)?
    volume = ui.slider(@app, into: w, least: 0, most: 100, value: 50)?
    done = ui.progress(@app, into: w, most: 3)?
    _ = ui.picture(@app, into: w, img: image.blank(width: 16, height: 16, format: .rgba)?)?
    actions = ui.row(@app, into: w)?
    button = ui.button(@app, into: actions, text: "Count")?
    stretch @= ui.default_fit()
    stretch.stretch @ 1
    ui.set_fit(@app, widget: note, fit: stretch)?
    return ok(
        Widgets(window: w, button: button, name: name, note: note, wrap: wrap, size: size, fruits: fruits, day: day, done: done, volume: volume, open_item: open_item)
    )

# The session a person gives, in order: what the program injects.
function session(ws: Widgets) -> [ui.Input]
    return [
        .click(widget: ws.button)
        .type_text(widget: ws.name, text: "Ada")
        .type_text(widget: ws.note, text: "first\nsecond")
        .toggle(widget: ws.wrap)
        .choose(widget: ws.size, indices: [1])
        .choose(widget: ws.fruits, indices: [0, 2])
        .choose(widget: ws.day, indices: [2])
        .slide(widget: ws.volume, value: 80)
        .choose_menu(item: ws.open_item)
        .click(widget: ws.button)
        .ask_close(window: ws.window)
    ]

# What an event says, as a line, the widget named by `ws`.
function told(ws: Widgets, event: ui.Event) -> str
    return match event
        .clicked c            => "clicked " + named(ws, widget: c.widget)
        .text_changed t       => "text_changed " + named(ws, widget: t.widget) + " " + t.text.len().to_str() + " bytes"
        .selection_changed s  => "selection_changed " + named(ws, widget: s.widget) + " " + numbers(s.indices)
        .toggled t            => "toggled " + named(ws, widget: t.widget) + " " + t.checked.to_str()
        .value_changed v      => "value_changed " + named(ws, widget: v.widget) + " " + v.value.to_str()
        .menu_chosen m        => "menu_chosen " + named(ws, widget: m.item)
        .close_asked c        => "close_asked " + named(ws, widget: c.window)
        .timer_fired _        => "timer_fired"
        .resized r            => "resized " + named(ws, widget: r.window)
        .message m            => "message " + named(ws, widget: m.widget)
        .moved m              => "moved " + named(ws, widget: m.window)
        .state_changed c      => "state_changed " + named(ws, widget: c.window)
        .screen_changed c     => "screen_changed " + named(ws, widget: c.window)
        .activated a          => "activated " + named(ws, widget: a.widget) + " " + a.index.to_str()
        .sort_asked s         => "sort asked " + named(ws, widget: s.widget) + " " + s.column.to_str()
        .unfolded u           => "unfolded " + named(ws, widget: u.widget) + " " + u.item.to_str()
        .submitted s          => "submitted " + named(ws, widget: s.widget)
        .dialog_answered d    => "dialog_answered " + d.dialog.id.to_str() + " " + answer_word(d.answer)
        .files_chosen f       => "files_chosen " + f.dialog.id.to_str()
        .print_chosen p       => "print_chosen " + p.dialog.id.to_str()
        .ready r              => "ready " + r.key.to_str()
        .appearance_changed a => "appearance_changed " + appearance_word(a.appearance)
        .quit_asked q         => "quit_asked " + q.session_end.to_str()
        .files_dropped f      => "files_dropped " + named(ws, widget: f.window) + " " + f.paths.len().to_str()
        .handed h             => "handed " + h.items.len().to_str()
        .pointer p            => "pointer " + named(ws, widget: p.widget) + " " + p.clicks.to_str()
        .key k                => "key " + named(ws, widget: k.widget) + " " + k.shortcut.key
        .part_acted p         => "part_acted " + named(ws, widget: p.widget) + " " + p.part.to_str()

# The word of `appearance`.
function appearance_word(appearance: ui.Appearance) -> str
    return match appearance
        .light => "light"
        .dark  => "dark"

# The word of the button `answer` names.
function answer_word(answer: ui.Answer) -> str
    return match answer
        .ok       => "ok"
        .cancel   => "cancel"
        .yes      => "yes"
        .no       => "no"
        .button b => "button " + b.index.to_str()

# The name the program gives `widget`.
function named(ws: Widgets, widget: ui.Widget) -> str
    if widget == ws.window
        return "window"

    if widget == ws.button
        return "button"

    if widget == ws.name
        return "name"

    if widget == ws.note
        return "note"

    if widget == ws.wrap
        return "wrap"

    if widget == ws.size
        return "size"

    if widget == ws.fruits
        return "fruits"

    if widget == ws.day
        return "day"

    if widget == ws.volume
        return "volume"

    if widget == ws.open_item
        return "open"
    return "widget " + widget.id.to_str()

# `values` in brackets, joined by `, `.
function numbers(values: [i64]) -> str
    parts: [str] @= []

    for v in values
        parts @ parts.push(v.to_str())

    return "[" + parts.join(", ") + "]"

# Runs the session on `app`, printing each event and the state left.
function run(@app: ui.App) -> ()?
    ws = made(@app)?

    if !ui.is_native(app)
        for line in ui.render(@app)?
            print(line)

    for input in session(ws)
        ui.inject(@app, input: input)?

    counted @= 0
    closing @= false

    while !closing
        event = ui.wait(@app, within: time.seconds(5)?)?
        print(told(ws, event: event))

        match event
            .clicked _ =>
                counted @ counted + 1
                ui.set_value(@app, widget: ws.done, value: counted)?
            .close_asked _ => closing @ true
            .text_changed _ | .selection_changed _ | .toggled _ | .value_changed _ | .menu_chosen _ | .timer_fired _ | .resized _ | .message _ | .moved _ | .state_changed _ | .screen_changed _ | .activated _ | .sort_asked _ | .unfolded _ | .submitted _ | .dialog_answered _ | .files_chosen _ | .print_chosen _ | .ready _ | .appearance_changed _ | .quit_asked _ | .files_dropped _ | .handed _ | .pointer _ | .part_acted _ | .key _ =>
                _ = 0

    print("name: " + ui.text_of(app, widget: ws.name)?)
    print("note: " + ui.text_of(app, widget: ws.note)?.len().to_str() + " bytes")
    print("wrap: " + ui.is_checked(app, widget: ws.wrap)?.to_str())
    print("size: " + numbers(ui.selection_of(app, widget: ws.size)?))
    print("fruits: " + numbers(ui.selection_of(app, widget: ws.fruits)?))
    print("day: " + numbers(ui.selection_of(app, widget: ws.day)?))
    print("volume: " + ui.value_of(app, widget: ws.volume)?.to_str())
    print("done: " + ui.value_of(app, widget: ws.done)?.to_str())
    ui.inject(@app, input: .answer(answer: .yes))?
    asked = ui.message(@app, over: ws.window, title: "Quit?", text: "Close the window?", tone: .info, buttons: .yes_no)?
    answered = ui.wait(@app, within: time.seconds(5)?)?
    print(told(ws, event: answered))
    print("answered: " + (answered == .dialog_answered(dialog: asked, answer: .yes)).to_str())
    ui.destroy(@app, widget: ws.window)?
    return ok()

# The program's arguments, each as text. An argument that is not UTF-8 is a
# usage error, told by its place counted from 1, and the program ends as its
# other usage errors do, where `args()` would abort.
function text_arguments() -> [str]
    given: [str] @= []

    for one in args_checked()
        match one
            .ok text => given @ given.push(text)
            .err _ =>
                print(f"reach_ui: argument {given.len() + 1} is not UTF-8")
                exit(code: 2)

    return given

function main()
    given = text_arguments()

    backend: ui.Backend = if given.len() > 0 && given[0] == "--native"
        .native
    else
        .headless

    app @= ui.open(backend).must()
    ran = run(@app)
    closed = ui.close(@app)

    match ran
        .ok _ => _ = 0
        .err e =>
            print("ui: " + e.code + ": " + e.msg)
            exit(code: 1)

    if closed.is_err()
        print("ui: the app did not close")
        exit(code: 1)

test "the driver: the session on the headless side, every event and the state left"
    app @= ui.open(.headless).must()
    ws = made(@app).must()

    for input in session(ws)
        ui.inject(@app, input: input).must()

    lines: [str] @= []

    while true
        match ui.wait(@app, within: time.seconds(1).must())
            .ok event => lines @ lines.push(told(ws, event: event))
            .err e =>
                assert e.code == ui.CLOSED
                break

    assert lines == ["clicked button", "text_changed name 3 bytes", "text_changed note 12 bytes", "toggled wrap true", "selection_changed size [1]", "selection_changed fruits [0, 2]", "selection_changed day [2]", "value_changed volume 80", "menu_chosen open", "clicked button", "close_asked window"]
    ui.close(@app).must()

# The same session on the system's own widgets, where this machine offers
# them to the session: each act given through the system's own path, the
# same events in the same order as the headless side's, and the state the
# person left read back from the system.
test "the driver: the session on the system's own widgets, the same events and the state left"
    app @= ui.open(.automatic).must()

    if !ui.is_native(app)
        ui.close(@app).must()
        skip_test(
            reason: "no native user interface here: no window server, no window station that shows, or no display named, for this session"
        )
    ws = made(@app).must()

    for input in session(ws)
        ui.inject(@app, input: input).must()

    lines: [str] @= []
    closing @= false

    while !closing
        event = ui.wait(@app, within: time.seconds(5).must()).must()
        lines @ lines.push(told(ws, event: event))

        match event
            .close_asked _ => closing @ true
            .clicked _ | .text_changed _ | .selection_changed _ | .toggled _ | .value_changed _ | .menu_chosen _ | .timer_fired _ | .resized _ | .message _ | .moved _ | .state_changed _ | .screen_changed _ | .activated _ | .sort_asked _ | .unfolded _ | .submitted _ | .dialog_answered _ | .files_chosen _ | .print_chosen _ | .ready _ | .appearance_changed _ | .quit_asked _ | .files_dropped _ | .handed _ | .pointer _ | .part_acted _ | .key _ =>
                _ = 0

    assert lines == ["clicked button", "text_changed name 3 bytes", "text_changed note 12 bytes", "toggled wrap true", "selection_changed size [1]", "selection_changed fruits [0, 2]", "selection_changed day [2]", "value_changed volume 80", "menu_chosen open", "clicked button", "close_asked window"]
    assert ui.text_of(app, widget: ws.name).must() == "Ada"
    assert ui.text_of(app, widget: ws.note).must() == "first\nsecond"
    assert ui.is_checked(app, widget: ws.wrap).must()
    assert ui.selection_of(app, widget: ws.size).must() == [1]
    assert ui.selection_of(app, widget: ws.fruits).must() == [0, 2]
    assert ui.selection_of(app, widget: ws.day).must() == [2]
    assert ui.value_of(app, widget: ws.volume).must() == 80
    ui.destroy(@app, widget: ws.window).must()
    ui.close(@app).must()

# What a thread other than `main`'s gets when it opens an app: 1 where it is
# refused `unsupported`, as a value, 0 where it opened one, 2 for another
# code. `_` is the thread's argument, unused.
function opened_elsewhere(_: i64) -> i64
    match ui.open(.headless)
        .ok app =>
            opened @= app
            _ = ui.close(@opened).is_err()
            return 0
        .err e =>
            if e.code == ui.UNSUPPORTED
                return 1
            return 2

test "the driver: an app opened on another thread is refused as a value, and main's thread opens one after it"
    worker @= threads.start(body: opened_elsewhere, arg: 0).must()
    assert threads.wait(@worker) == 1
    app @= ui.open(.headless).must()
    ui.close(@app).must()
