# The certificate request an order is finalized with: PKCS #10 (RFC 2986),
# its subject the first domain that is a name, its domains in a
# subjectAltName asked for by an `extensionRequest` attribute, and the whole
# signed by the certificate's own key, never the account's (RFC 8555
# § 7.4). `acme` sends a request and does not make one: `x509` makes it, and
# it is read back and checked again here before it leaves.

use <rebel>/crypto/keypairs
use <rebel>/errors
use <rebel>/net
use <rebel>/x509

## Codes

# The code of a request that cannot be made or does not read back.
constant INVALID: str
    "invalid"

## Making

# The DER of a request for `domains`, signed by `key`.
#
# - `domains`: the names and addresses, in the order the order lists them;
#   the first name that is no address is the subject's common name where it
#   fits RFC 5280's 64 characters, and the subject is empty otherwise.
# - `key`: the certificate's private key, P-256, which stays open.
#
# Fails `invalid` where `domains` is empty or the request does not read back
# as one `x509` takes and whose signature holds; and as `x509.create_request`
# fails.
function make(domains: [str], key: keypairs.PrivateKey) -> [u8]?
    if domains.len() == 0
        return fail(code: INVALID, msg: "a request names one domain or address at least")
    common = subject_name(domains)
    attributes: [[x509.Attribute]] @= []

    if common != ""
        attributes @ attributes.push([x509.new_attribute(oid: x509.COMMON_NAME, text: common)?])
    profile @= x509.default_profile()
    profile.alt_names @ general_names(domains)
    template = x509.RequestTemplate(subject: x509.new_name(attributes)?, profile: profile, attributes: [])
    request = x509.create_request(template, signer: key, scheme: .ecdsa_sha256)?
    checked(der: request.der, domains: domains)?
    return ok(request.der)

# The general names of `domains`: an address as an `iPAddress`, any other as a
# `dNSName`, in their order.
#
# - `domains`: host names, ASCII, a wildcard's `*.` kept, and addresses.
function general_names(domains: [str]) -> [x509.GeneralName]
    names: [x509.GeneralName] @= []

    for d in domains
        match net.parse_host(d)
            .ok address => names @ names.push(.ip(address: address))
            .err _      => names @ names.push(.dns(name: d))

    return names

# The common name a request for `domains` gives its subject: the first that
# is a name and fits 64 characters, or "" for none.
#
# - `domains`: the names and addresses.
function subject_name(domains: [str]) -> str
    for d in domains
        if net.parse_host(d).is_err() && d.len() <= 64
            return d

    return ""

## Checking

# Refuses a request `x509` does not read, whose signature does not hold, or
# whose alternative names are not `domains`.
#
# - `der`: the request's DER.
# - `domains`: the names and addresses it must ask for.
#
# Fails `invalid`, saying which.
function checked(der: [u8], domains: [str]) -> ()?
    request = x509.decode_request(der)?

    if !x509.is_request_signed(request)?
        return fail(code: INVALID, msg: "the request's own signature does not hold")
    asked = names_asked(request)

    if asked != domains
        return fail(code: INVALID, msg: f"the request asks {asked.join(", ")}, where {domains.join(", ")} was meant")
    return ok()

# The names and addresses `request`'s subjectAltName asks, in its order, as
# text.
#
# - `request`: a request read.
function names_asked(request: x509.Request) -> [str]
    out: [str] @= []

    match request.extensions.alt_names
        .err _ => _ = 0
        .ok list =>
            for general in list
                match general
                    .dns d => out @ out.push(d.name)
                    .ip a  => out @ out.push(net.format_host(a.address))
                    .other_name _ | .email _ | .x400_address _ | .directory _ | .edi_party _ | .uri _ | .ip_network _ | .registered_id _ =>
                        _ = 0

    return out

test "make: a request x509 reads back, signed, its names in order, its subject the first name"
    key @= keypairs.generate(.p256).must()
    der = make(["www.example.org", "127.0.0.1", "example.org"], key: key).must()
    request = x509.decode_request(der).must()
    errors.ignore(keypairs.close_private(@key))
    assert x509.is_request_signed(request).must()
    assert names_asked(request) == ["www.example.org", "127.0.0.1", "example.org"]
    assert x509.text_of(request.subject, oid: x509.COMMON_NAME).must() == "www.example.org"

test "make: no domain is refused"
    key @= keypairs.generate(.p256).must()
    refused = make([], key: key).is_err()
    errors.ignore(keypairs.close_private(@key))
    assert refused

test "subject_name: an address passed over, a name too long for a common name, none"
    assert subject_name(["127.0.0.1", "a.example.org"]) == "a.example.org"
    assert subject_name(["127.0.0.1"]) == ""
    long_name = "a" + repeat("b", to_u64(70).must()) + ".example.org"
    assert subject_name([long_name]) == ""
