# The stand-in CA's authorities, as a public CA arranges its own: a root,
# self-signed, whose certificate a client trusts, and an intermediate the
# root signed, which signs every certificate issued, so the root's key is
# used twice and then only kept. Both keys are P-256, made at start by
# `crypto/keypairs` and never written anywhere; both certificates are made by
# `x509.create_self_signed` and `x509.create_certificate`, which read them back
# before they are used.
#
# A certificate issued carries what a TLS server's certificate of the web
# carries: the names of the order in its subjectAltName, the first name as
# its common name, `digitalSignature`, `serverAuth` and `clientAuth`, its
# key's identifier and its issuer's, and where the issuer's certificate is
# served (`caIssuers`).

use <rebel>/asn1
use <rebel>/big
use <rebel>/crypto/keypairs
use <rebel>/pem
use <rebel>/time
use <rebel>/x509

use pki/request
use pki/signing

## Names

# The organization every authority of the stand-in names.
constant ORGANIZATION: str
    "Certs Stand-in CA"

# The root's common name.
constant ROOT_NAME: str
    "Certs Stand-in Root X1"

# The intermediate's common name.
constant ISSUER_NAME: str
    "Certs Stand-in Issuer R1"

## The authorities

# The two authorities, their keys held open until `close`.
record Authority
    # The root's key, which signed the intermediate.
    root_key: keypairs.PrivateKey
    # The intermediate's key, which signs every certificate issued.
    issuer_key: keypairs.PrivateKey
    # The root's certificate, PEM: what a client trusts.
    root_pem: str
    # The intermediate's certificate, PEM: what follows a certificate issued
    # in its chain.
    issuer_pem: str
    # The intermediate's DER, served at its `caIssuers` URL.
    issuer_der: [u8]
    # The intermediate's certificate, every certificate's issuer.
    issuer: x509.Certificate
    # The intermediate's key identifier.
    issuer_key_id: [u8]

# The two authorities made: a root valid twenty years from a day before
# `at`, and an intermediate valid five, both serials of `serials`.
#
# - `at`: the stand-in's first moment.
# - `serials`: two serial numbers' bytes, the root's then the
#   intermediate's, `signing.positive_serial`'s.
#
# Fails as `keypairs.generate` and `x509` fail; both keys are closed on every
# failure.
function make(at: time.Instant, serials: [[u8]]) -> Authority?
    root_key @= keypairs.generate(.p256)?

    match keypairs.generate(.p256)
        .err e =>
            _ = keypairs.close_private(@root_key).is_err()
            return fail(code: e.code, msg: e.msg)
        .ok made =>
            issuer_key @= made

            match certified(root_key: root_key, issuer_key: issuer_key, at: at, serials: serials)
                .ok a => return ok(a)
                .err e =>
                    _ = keypairs.close_private(@root_key).is_err()
                    _ = keypairs.close_private(@issuer_key).is_err()
                    return fail(code: e.code, msg: e.msg)

# `make`'s work once both keys are made.
#
# - `root_key`: the root's key.
# - `issuer_key`: the intermediate's key.
# - `at`: the stand-in's first moment.
# - `serials`: the two serials.
#
# Fails as `make` fails.
function certified(root_key: keypairs.PrivateKey, issuer_key: keypairs.PrivateKey, at: time.Instant, serials: [[u8]]) -> Authority?
    start = time.add(at, d: time.days(-1))?
    root_profile @= x509.default_profile()
    root_profile.role @ .authority
    root_profile.key_usage @ authority_usage()
    root = x509.create_self_signed(x509.CertificateTemplate(serial: serial_of(serials[0]), subject: named(common: ROOT_NAME, organization: ORGANIZATION)?, not_before: time.to_date_time(start), not_after: time.to_date_time(time.add(start, d: time.days(7305))?), profile: root_profile, ocsp_urls: [], issuer_urls: [], crl_urls: []), signer: root_key, scheme: .ecdsa_sha256)?
    issuer_profile @= x509.default_profile()
    issuer_profile.role @ .limited_authority(path_len: 0)
    issuer_profile.key_usage @ authority_usage()
    issuer_profile.extended_key_usage @ server_purposes()
    issuer = x509.create_certificate(x509.CertificateTemplate(serial: serial_of(serials[1]), subject: named(common: ISSUER_NAME, organization: ORGANIZATION)?, not_before: time.to_date_time(start), not_after: time.to_date_time(time.add(start, d: time.days(1826))?), profile: issuer_profile, ocsp_urls: [], issuer_urls: [], crl_urls: []), subject_key: x509.public_key_of(issuer_key)?, issuer: root, signer: root_key, scheme: .ecdsa_sha256)?
    return ok(
        Authority(root_key: root_key, issuer_key: issuer_key, root_pem: x509.format_certificate(root), issuer_pem: x509.format_certificate(issuer), issuer_der: issuer.der, issuer: issuer, issuer_key_id: signing.key_id(issuer.public_key.der)?)
    )

# The name of an authority or a server: its organization, then its common name,
# either left out where it is "".
#
# - `common`: the common name.
# - `organization`: the organization.
#
# Fails as `x509.new_name` and `x509.new_attribute` fail.
function named(common: str, organization: str) -> x509.Name?
    rdns: [[x509.Attribute]] @= []

    if organization != ""
        rdns @ rdns.push([x509.new_attribute(oid: x509.ORGANIZATION_NAME, text: organization)?])

    if common != ""
        rdns @ rdns.push([x509.new_attribute(oid: x509.COMMON_NAME, text: common)?])
    return x509.new_name(rdns)

# A serial number made of drawn bytes.
#
# - `drawn`: the bytes, `signing.positive_serial`'s.
function serial_of(drawn: [u8]) -> big.Integer
    return big.from_bytes(drawn, order: .big_endian)

# What an authority's key is for: certificates and lists signed.
function authority_usage() -> x509.KeyUsage
    return x509.KeyUsage(
        digital_signature: false,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: true,
        crl_sign: true,
        encipher_only: false,
        decipher_only: false
    )

# What a TLS server's key is for: signatures.
function server_usage() -> x509.KeyUsage
    return x509.KeyUsage(
        digital_signature: true,
        content_commitment: false,
        key_encipherment: false,
        data_encipherment: false,
        key_agreement: false,
        key_cert_sign: false,
        crl_sign: false,
        encipher_only: false,
        decipher_only: false
    )

# The purposes of a TLS server's certificate: serverAuth and clientAuth, as the
# CAs of the web write them.
function server_purposes() -> [asn1.Oid]
    return [asn1.Oid(dotted: x509.SERVER_AUTH), asn1.Oid(dotted: x509.CLIENT_AUTH)]

# Closes both keys of `a`.
#
# - `a`: the authorities, their keys closed and their places emptied.
function close(@a: Authority)
    _ = keypairs.close_private(@a.root_key).is_err()
    _ = keypairs.close_private(@a.issuer_key).is_err()

## Issuing

# What a certificate is issued for.
record Asked
    # The request, read and checked.
    request: x509.Request
    # The order's identifiers' values, in its order, a wildcard's `*.` kept.
    domains: [str]
    # The serial's bytes.
    serial: [u8]
    # The first valid moment.
    not_before: time.Instant
    # The last valid moment.
    not_after: time.Instant
    # Where the intermediate's certificate is served.
    issuer_url: str

# The certificate `asked` describes, signed by the intermediate: its DER.
#
# - `a`: the authorities.
# - `asked`: the request, the names, the serial, the dates and the issuer's
#   URL.
#
# Fails as `x509.create_certificate` fails.
function issue(a: Authority, asked: Asked) -> [u8]?
    profile @= x509.default_profile()
    profile.role @ .end_entity
    profile.key_usage @ server_usage()
    profile.extended_key_usage @ server_purposes()
    profile.alt_names @ request.general_names(asked.domains)
    made = x509.create_certificate(x509.CertificateTemplate(serial: serial_of(asked.serial), subject: named(common: request.subject_name(asked.domains), organization: "")?, not_before: time.to_date_time(asked.not_before), not_after: time.to_date_time(asked.not_after), profile: profile, ocsp_urls: [], issuer_urls: [asked.issuer_url], crl_urls: []), subject_key: asked.request.public_key, issuer: a.issuer, signer: a.issuer_key, scheme: .ecdsa_sha256)?
    return ok(made.der)

# The chain served for a certificate: it, then the intermediate, PEM.
#
# - `a`: the authorities.
# - `der`: the certificate's DER.
#
# Fails as `pem.format` fails.
function chain_of(a: Authority, der: [u8]) -> str?
    return ok(pem.format(pem.Block(label: "CERTIFICATE", headers: [], data: der))? + a.issuer_pem)

## The CA's own HTTPS

# What the stand-in's own HTTPS presents: a certificate for 127.0.0.1 and
# `localhost` under a root of its own, apart from the issuing one, as a test
# CA ships one for its API; the client trusts that root for the API alone.
record Https
    # The server's certificate then its root, PEM, as `tls.Server.chain`
    # takes them.
    chain: str
    # The server's key, PKCS #8 PEM.
    key: str
    # The root, PEM, which a client of the API trusts.
    root: str

# A root and a server certificate for 127.0.0.1 and `localhost`, both valid
# from a day before `at` for two years, so a client checking them by the
# system's clock finds them valid whatever moment the stand-in's own clock
# says.
#
# - `at`: the stand-in's first moment.
# - `serials`: two serials' bytes, the root's then the server's.
#
# Both keys are made, used and closed here; only PEM leaves. Fails as
# `keypairs.generate` and `signing.certificate` fail.
function https_identity(at: time.Instant, serials: [[u8]]) -> Https?
    root_key @= keypairs.generate(.p256)?
    made = https_signed(root_key, at: at, serials: serials)
    _ = keypairs.close_private(@root_key).is_err()
    return made

# `https_identity`'s work once the root's key is made.
#
# - `root_key`: the root's key, which stays open.
# - `at`: the stand-in's first moment.
# - `serials`: the two serials.
#
# Fails as `https_identity` fails.
function https_signed(root_key: keypairs.PrivateKey, at: time.Instant, serials: [[u8]]) -> Https?
    start = time.add(at, d: time.days(-1))?
    not_before = time.to_date_time(start)
    not_after = time.to_date_time(time.add(start, d: time.days(730))?)
    root_profile @= x509.default_profile()
    root_profile.role @ .limited_authority(path_len: 0)
    root_profile.key_usage @ authority_usage()
    root = x509.create_self_signed(x509.CertificateTemplate(serial: serial_of(serials[0]), subject: named(common: "Certs Stand-in HTTPS Root", organization: ORGANIZATION)?, not_before: not_before, not_after: not_after, profile: root_profile, ocsp_urls: [], issuer_urls: [], crl_urls: []), signer: root_key, scheme: .ecdsa_sha256)?
    server_key @= keypairs.generate(.p256)?
    server_public = x509.public_key_of(server_key)
    key_pem = keypairs.format_private_pem(server_key)
    _ = keypairs.close_private(@server_key).is_err()
    server_profile @= x509.default_profile()
    server_profile.role @ .end_entity
    server_profile.key_usage @ server_usage()
    server_profile.extended_key_usage @ server_purposes()
    server_profile.alt_names @ request.general_names(["localhost", "127.0.0.1"])
    server = x509.create_certificate(x509.CertificateTemplate(serial: serial_of(serials[1]), subject: named(common: "localhost", organization: ORGANIZATION)?, not_before: not_before, not_after: not_after, profile: server_profile, ocsp_urls: [], issuer_urls: [], crl_urls: []), subject_key: server_public?, issuer: root, signer: root_key, scheme: .ecdsa_sha256)?
    root_pem = x509.format_certificate(root)
    return ok(Https(chain: x509.format_certificate(server) + root_pem, key: key_pem?, root: root_pem))

test "make: an intermediate the root signed, both read back as authorities"
    at = time.now().must()
    made @= make(at, serials: [[1], [2]]).must()
    root = x509.parse_certificate(made.root_pem).must()
    issuer = x509.parse_certificate(made.issuer_pem).must()
    assert x509.is_self_issued(root) && x509.is_signed_by(certificate: issuer, issuer: root).must()
    assert issuer.extensions.basic_constraints.must().is_ca
    close(@made)

test "issue: a certificate for a request, verified up to the root for its names"
    at = time.now().must()
    made @= make(at, serials: [[1], [2]]).must()
    key @= keypairs.generate(.p256).must()
    der = request.make(["www.certs.test", "127.0.0.1"], key: key).must()
    _ = keypairs.close_private(@key).is_err()
    asked = Asked(
        request: x509.decode_request(der).must(),
        domains: ["www.certs.test", "127.0.0.1"],
        serial: [0x11, 0x22],
        not_before: time.add(at, d: time.hours(-1)).must(),
        not_after: time.add(at, d: time.days(90)).must(),
        issuer_url: "https://ca.test/issuer"
    )
    leaf = x509.decode_certificate(issue(made, asked: asked).must()).must()
    chain = [leaf, x509.parse_certificate(made.issuer_pem).must()]
    roots = [x509.parse_certificate(made.root_pem).must()]
    x509.verify_chain(
        chain,
        options: x509.Verification(roots: roots, at: at, purpose: x509.SERVER_AUTH, host: "www.certs.test")
    ).must()
    x509.verify_chain(
        chain,
        options: x509.Verification(roots: roots, at: at, purpose: x509.SERVER_AUTH, host: "127.0.0.1")
    ).must()
    assert x509.verify_chain(
        chain,
        options: x509.Verification(roots: roots, at: at, purpose: x509.SERVER_AUTH, host: "other.test")
    ).is_err()
    close(@made)
