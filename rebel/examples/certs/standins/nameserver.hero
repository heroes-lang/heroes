# The DNS stand-in: the authority of the demo's zone (`standins/zone`) on a
# UDP socket of 127.0.0.1, on a thread of its own. The stand-in CA asks it
# the addresses an HTTP-01 answer is fetched from, the TXT records of
# DNS-01 and the CAA records that say which CA may issue; the program's
# DNS-01 hook writes the TXT records into it by signed RFC 2136 updates.
# Every answer here fits one datagram, so the stand-in answers over UDP
# alone, which every question of the demo is asked over; a real authority
# answers over TCP too (RFC 7766). It serves until the program is asked to
# stop.

use <rebel>/dns
use <rebel>/errors
use <rebel>/net
use <rebel>/time

use challenges/tsig
use core/ready
use standins/zone

## Serving

# How many receives in a row may fail before the stand-in stops: a single
# failure (a refusal a datagram sent earlier brought back) is passed over,
# and a socket that only fails ends the loop rather than spinning.
constant MOST_FAILURES: i64
    100

# What the stand-in's thread is handed, whole.
record Setup
    # The zone.
    origin: str
    # The CA's CAA identity the zone names.
    identity: str
    # The update key's name, ending in a dot.
    tsig_name: str
    # The update key's secret.
    tsig_secret: [u8]
    # Where the starter waits to hear the stand-in listens.
    told: (mailbox ready.Ready)

# The stand-in's thread. Answers its last line: what it answered, or why it
# could not serve. The readiness mailbox is closed on every path, so a
# stand-in that could not listen is told to its starter at once.
#
# - `setup`: the zone, its update key and the readiness mailbox.
function run(setup: Setup) -> str
    outcome = match configured(setup)
        .err e => "dns: " + e.msg
        .ok z =>
            match served(z, told: setup.told)
                .ok done => f"dns: queries answered {done.queries}, updates applied {done.applied}, updates refused {done.refused}"
                .err e => "dns: " + e.msg

    setup.told.close()
    return outcome

# The zone `setup` describes.
#
# - `setup`: the zone and its update key.
#
# Fails as `zone.new` fails.
function configured(setup: Setup) -> zone.Zone?
    key = tsig.Key(name: setup.tsig_name, secret: setup.tsig_secret)
    return zone.new(
        setup.origin,
        records: zone.demo_records(origin: setup.origin, address: net.loopback_v4(), identity: setup.identity),
        known: [key]
    )

# `z` served on a UDP socket of 127.0.0.1 until the stop, the starter told
# its port first.
#
# - `z`: the zone.
# - `told`: where the starter waits to hear the stand-in listens.
#
# The zone as the updates left it, with its counts. Fails as `net.open_udp`
# and `ready.tell` fail.
function served(z: zone.Zone, told: (mailbox ready.Ready)) -> zone.Zone?
    socket @= net.open_udp(host: "127.0.0.1", port: 0)?

    match ready.tell(told, said: ready.Ready(service: "dns", port: socket.address.port, https_root: ""))
        .err e =>
            errors.ignore(net.close_udp(@socket))
            return fail(code: e.code, msg: e.msg)
        .ok _ => _ = 0

    held @= z
    failures @= 0

    while failures < MOST_FAILURES
        match net.receive(socket)
            .err e =>
                if e.code == "stopped" || e.code == "closed"
                    break
                failures @ failures + 1
            .ok d =>
                failures @ 0
                datagram(@held, socket: socket, d: d)

    errors.ignore(net.close_udp(@socket))
    return ok(held)

# One datagram answered; one that is no message, or no query, is dropped as
# an authority drops one.
#
# - `z`: the zone.
# - `socket`: the socket it came on.
# - `d`: the datagram.
function datagram(@z: zone.Zone, socket: net.UdpSocket, d: net.Datagram)
    match dns.decode(d.data)
        .err _ => return
        .ok m =>
            if m.response
                return
            reply = zone.answer(@z, m: m, at: time.now().default(time.epoch()))

            match dns.encode(reply)
                .ok data => _ = net.send_to(socket, data: data, to: d.sender).is_err()
                .err _   => return

test "configured: a zone from its setup, its records the demo's"
    setup = Setup(
        origin: "certs.test",
        identity: "standin.certs.test",
        tsig_name: "k.",
        tsig_secret: [0, 0, 0],
        told: mailbox()
    )
    z = configured(setup).must()
    assert z.origin == "certs.test." && z.records.len() == 6
