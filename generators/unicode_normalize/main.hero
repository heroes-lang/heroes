# The generator of `unicode/normalize`'s tables,
# `unicode/normalize/internal/tables.hero`: the canonical combining classes,
# the decompositions, the compositions, the quick checks of UAX #15,
# NFKC_Casefold and the soft-dotted letters, written byte for byte, or
# checked against the module in the tree.
#
# Its inputs are three files of the Unicode Character Database 17.0.0,
# which never changes, fetched from `UCD_URL` into one folder under the
# names they are served by and each held to its SHA-256 in `INPUTS`. Run
# from the repository's root:
#
#     heroes run generators/unicode_normalize/main.hero -- write <folder>
#     heroes run generators/unicode_normalize/main.hero -- check <folder>
#
# `write` writes the module. `check` reads it and exits 0 where it is
# exactly what `write` would write, and 1 where it is not, naming its first
# line that differs. Either exits 2 where its words are not these, where a
# file's digest is not the pinned one, or where a line of a file is not what
# the database writes.

use <rebel>/numbers
use <rebel>/strings
use <tablekit>/tablekit
use <ucdkit>/ucdkit

# Where the database's files are served.
constant UCD_URL: str
    "https://www.unicode.org/Public/17.0.0/ucd/"

# Each input's name in the folder and its SHA-256, in lowercase hexadecimal.
constant INPUTS: [str]
    [
        "UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"
        "DerivedNormalizationProps.txt 71fd6a206a2c0cdd41feb6b7f656aa31091db45e9cedc926985d718397f9e488"
        "PropList.txt 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd"
    ]

# The module, from the repository's root.
constant TABLE: str
    "packages/rebel/0.1.0/files/unicode/normalize/internal/tables.hero"

# The text of the input `name` of the folder, held to its digest.
#
# Fails `invalid` where no input is so named, and as `tablekit.pinned_text`
# fails.
function input(folder: str, name: str) -> str?
    for one in INPUTS
        if one.slice(from: 0, to: name.len() + 1) == name + " "
            return tablekit.pinned_text(
                path: folder + "/" + name,
                sha256: one.slice(from: name.len() + 1, to: one.len())
            )

    return fail(code: "invalid", msg: f"no input is named {name}")

# A run of code points that hold one value: the first, the last, the value.
record Run
    first: i64
    last: i64
    value: i64

# The runs of `values`, one value for each code point from 0, 0 for none:
# every code point with a value, consecutive ones holding the same value
# joined, ascending.
function runs_of(values: [i64]) -> [Run]
    out: [Run] @= []
    at @= 0

    while at < values.len()
        value = values[at]

        if value != 0
            if out.len() > 0 && out[out.len() - 1].last == at - 1 && out[out.len() - 1].value == value
                out[out.len() - 1].last @ at
            else
                out @ out.push(Run(first: at, last: at, value: value))
        at @ at + 1

    return out

# One value for each code point, from 0, every one 0.
function blank() -> [i64]
    out: [i64] @= []

    while out.len() < ucdkit.POINTS
        out @ out.push(0)

    return out

# What `UnicodeData.txt` gives the tables.
record Data
    # The canonical combining class of each code point.
    classes: [i64]
    # The kinds of a decomposition, the canonical one first, then the tags in
    # the order the file first writes them.
    kinds: [str]
    # Each code point with a decomposition, ascending, its kind's index and
    # its mapping beside it.
    points: [i64]
    kind_of: [i64]
    mappings: [[i64]]

# What the lines of `UnicodeData.txt`, `text`, give.
#
# Fails `invalid` where a line does not read, or names a kind of
# decomposition `<` and `>` do not close.
function data_of(text: str) -> Data?
    data @= Data(classes: blank(), kinds: ["canonical"], points: [], kind_of: [], mappings: [])

    for line in ucdkit.data_lines(text)?
        if line.fields.len() < 5
            return fail(code: "invalid", msg: f"the line of {line.first} has {line.fields.len()} fields")

        combining = match numbers.parse_int(line.fields[2])
            .ok n  => n
            .err _ => return fail(code: "invalid", msg: f"the class of {line.first} is \"{line.fields[2]}\"")

        point @= line.first

        while point <= line.last
            data.classes[point] @ combining
            point @ point + 1

        if line.fields[4] != ""
            words @= strings.words(line.fields[4])
            kind @= "canonical"

            if strings.has_prefix(s: words[0], prefix: "<")
                if !strings.has_suffix(s: words[0], suffix: ">")
                    return fail(
                        code: "invalid",
                        msg: f"the decomposition of {line.first} opens a tag it does not close"
                    )
                kind @ words[0].slice(from: 1, to: words[0].len() - 1)
                words @ words.slice(from: 1, to: words.len())
            index @= 0

            while index < data.kinds.len() && data.kinds[index] != kind
                index @ index + 1

            if index == data.kinds.len()
                data.kinds @ data.kinds.push(kind)
            mapping: [i64] @= []

            for word in words
                mapping @ mapping.push(ucdkit.hex_of(word)?)

            data.points @ data.points.push(line.first)
            data.kind_of @ data.kind_of.push(index)
            data.mappings @ data.mappings.push(mapping)

    return ok(data)

# What `DerivedNormalizationProps.txt` gives the tables.
record Derived
    # Whether each code point is excluded from composition, fully.
    excluded: [bool]
    # Each code point's NFC_Quick_Check and NFKC_Quick_Check: 1 maybe, 2 no,
    # 0 yes.
    nfc: [i64]
    nfkc: [i64]
    # The lines of NFKC_Casefold, ascending: each range and what every code
    # point of it maps to.
    fold_ranges: [i64]
    fold_maps: [[i64]]

# The answer a quick check's field writes: 1 for `M`, 2 for `N`.
#
# Fails `invalid` for any other.
function quick(field: str, first: i64) -> i64?
    if field == "M"
        return ok(1)

    if field == "N"
        return ok(2)
    return fail(code: "invalid", msg: f"the quick check of {first} is \"{field}\"")

# What the lines of `DerivedNormalizationProps.txt`, `text`, give.
#
# Fails `invalid` where a line does not read.
function derived_of(text: str) -> Derived?
    excluded: [bool] @= []

    while excluded.len() < ucdkit.POINTS
        excluded @ excluded.push(false)

    out @= Derived(excluded: excluded, nfc: blank(), nfkc: blank(), fold_ranges: [], fold_maps: [])
    folds: {i64: [i64]} @= {}
    lasts: {i64: i64} @= {}

    for line in ucdkit.data_lines(text)?
        name = line.fields[0]

        if name == "NFKC_CF"
            if line.fields.len() < 2
                return fail(code: "invalid", msg: f"the NFKC_Casefold line of {line.first} has no mapping")
            folds[line.first] @ ucdkit.points_of(line.fields[1])?
            lasts[line.first] @ line.last
        else if name == "Full_Composition_Exclusion" || name == "NFC_QC" || name == "NFKC_QC"
            answer = if name == "Full_Composition_Exclusion"
                0
            else
                quick(line.fields[1], first: line.first)?
            point @= line.first

            while point <= line.last
                if name == "Full_Composition_Exclusion"
                    out.excluded[point] @ true
                else if name == "NFC_QC"
                    out.nfc[point] @ answer
                else
                    out.nfkc[point] @ answer
                point @ point + 1

    for first in sort(keys(folds))
        out.fold_ranges @ out.fold_ranges.push(first << 21 | lasts[first].must())
        out.fold_maps @ out.fold_maps.push(folds[first].must())

    return ok(out)

# The module's whole text, from the files of `folder`.
#
# Fails as reading a file or a line of it fails.
function module_text(folder: str) -> str?
    head: [str] @= [
        "# The tables of `unicode/normalize`, in Unicode 17.0.0: the canonical"
        "# combining classes, the decompositions, the compositions, the quick checks of"
        "# UAX #15, NFKC_Casefold and the soft-dotted letters."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `generators/unicode_normalize/` read the Unicode Character Database 17.0.0,"
        "# each file held to its SHA-256, packed it into the tables below, and wrote"
        "# this module whole; its `check` command says whether this module is still"
        "# what it writes. What it read:"
        "#"
    ]

    for one in INPUTS
        halves = strings.split_once(s: one, sep: " ")?
        head @ head.push(f"# - `{halves.before}`, SHA-256 {halves.after}")

    data = data_of(input(folder: folder, name: "UnicodeData.txt")?)?
    derived = derived_of(input(folder: folder, name: "DerivedNormalizationProps.txt")?)?
    soft = ucdkit.property_set(text: input(folder: folder, name: "PropList.txt")?, name: "Soft_Dotted")?
    combining: [i64] @= []

    for one in runs_of(data.classes)
        combining @ combining.push(one.first << 29 | one.last << 8 | one.value)

    decompositions: [i64] @= []
    decomposed: [i64] @= []
    composites: {i64: i64} @= {}
    at @= 0

    while at < data.points.len()
        mapping = data.mappings[at]
        decompositions @ decompositions.push(
            data.points[at] << 32 | data.kind_of[at] << 27 | mapping.len() << 22 | decomposed.len()
        )

        for point in mapping
            decomposed @ decomposed.push(point)

        if data.kind_of[at] == 0 && mapping.len() == 2 && !derived.excluded[data.points[at]]
            composites[mapping[0] << 21 | mapping[1]] @ data.points[at]
        at @ at + 1

    pairs = sort(keys(composites))
    composed: [i64] @= []

    for pair in pairs
        composed @ composed.push(composites[pair].must())

    quick_nfc: [i64] @= []
    quick_nfkc: [i64] @= []

    for one in runs_of(derived.nfc)
        quick_nfc @ quick_nfc.push(one.first << 23 | one.last << 2 | one.value)

    for one in runs_of(derived.nfkc)
        quick_nfkc @ quick_nfkc.push(one.first << 23 | one.last << 2 | one.value)

    targets: [i64] @= []
    fold_points: [i64] @= []

    for mapping in derived.fold_maps
        targets @ targets.push(fold_points.len() << 5 | mapping.len())

        for point in mapping
            fold_points @ fold_points.push(point)

    soft_values @= blank()
    point @= 0

    while point < ucdkit.POINTS
        if soft[point]
            soft_values[point] @ 1
        point @ point + 1

    soft_dotted: [i64] @= []

    for one in runs_of(soft_values)
        soft_dotted @ soft_dotted.push(one.first << 21 | one.last)

    blocks = [
        head.join("\n")
        tablekit.strings_constant(comment: ["# The kinds of a decomposition, in the order `DECOMPOSITIONS` numbers them:", "# the canonical one first, then the tags of `UnicodeData.txt`."], name: "KINDS", items: data.kinds)?
        tablekit.numbers_constant(comment: ["# The code points whose canonical combining class is not 0, as runs", "# `first << 29 | last << 8 | class`, ascending."], name: "COMBINING", items: combining)
        tablekit.numbers_constant(comment: ["# The one-step decomposition of every code point that has one but the Hangul", "# syllables, `code point << 32 | kind << 27 | length << 22 | offset`,", "# ascending: the kind indexes `KINDS`, and the mapping is `length` code points", "# of `DECOMPOSED` from `offset`."], name: "DECOMPOSITIONS", items: decompositions)
        tablekit.numbers_constant(comment: ["# The code points the decompositions map to, one after another."], name: "DECOMPOSED", items: decomposed)
        tablekit.numbers_constant(comment: ["# The pairs that compose canonically, `first << 21 | second`, ascending: the", "# canonical decompositions of two code points whose source is not excluded", "# from composition."], name: "COMPOSE_PAIRS", items: pairs)
        tablekit.numbers_constant(comment: ["# The primary composite of each pair of `COMPOSE_PAIRS`, beside it."], name: "COMPOSED", items: composed)
        tablekit.numbers_constant(comment: ["# The code points NFC_Quick_Check does not answer yes for, as runs", "# `first << 23 | last << 2 | answer`, ascending: 1 maybe, 2 no."], name: "NFC_QUICK", items: quick_nfc)
        tablekit.numbers_constant(comment: ["# The same for NFKC_Quick_Check."], name: "NFKC_QUICK", items: quick_nfkc)
        tablekit.numbers_constant(comment: ["# The code points NFKC_Casefold maps to something else, as ranges", "# `first << 21 | last`, ascending; every code point of a range maps alike."], name: "CASEFOLD_RANGES", items: derived.fold_ranges)
        tablekit.numbers_constant(comment: ["# What each range of `CASEFOLD_RANGES` maps to, beside it: `offset << 5 |", "# length`, the code points of `CASEFOLD_POINTS`; a length of 0 takes the", "# code point away."], name: "CASEFOLD_TARGETS", items: targets)
        tablekit.numbers_constant(comment: ["# The code points NFKC_Casefold maps to, one after another."], name: "CASEFOLD_POINTS", items: fold_points)
        tablekit.numbers_constant(comment: ["# The code points whose dot goes when an accent stands above them, Unicode's", "# Soft_Dotted, as ranges `first << 21 | last`, ascending."], name: "SOFT_DOTTED", items: soft_dotted)
        ["## Tests", "", "test \"tables: every table ascends, and each pair of tables is as long as the other\"", "    for table in [COMBINING, DECOMPOSITIONS, COMPOSE_PAIRS, NFC_QUICK, NFKC_QUICK, CASEFOLD_RANGES, SOFT_DOTTED]", "        at: i64 @= 1", "", "        while at < table.len()", "            assert table[at - 1] < table[at]", "            at @ at + 1", "", "    assert COMPOSE_PAIRS.len() == COMPOSED.len()", "    assert CASEFOLD_RANGES.len() == CASEFOLD_TARGETS.len()", "    assert KINDS[0] == \"canonical\""].join("\n")
    ]
    return ok(blocks.join("\n\n") + "\n")

# Does what `command` asks with the module, and answers the code it reached.
#
# Fails as `module_text` fails and as writing or reading the module fails.
function run(command: str, folder: str) -> i64?
    return tablekit.settle(command: command, path: TABLE, text: module_text(folder)?)

function main()
    words = tablekit.command_words("unicode_normalize")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run generators/unicode_normalize/main.hero -- write|check <folder of the files of ",
            UCD_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], folder: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "runs_of: consecutive code points of one value joined, a gap or another value apart, none for 0"
    values @= blank()
    values[1] @ 5
    values[2] @ 5
    values[3] @ 6
    values[5] @ 6
    got = runs_of(values)
    assert got.len() == 3
    assert got[0] == Run(first: 1, last: 2, value: 5) && got[1] == Run(first: 3, last: 3, value: 6)
    assert got[2] == Run(first: 5, last: 5, value: 6)

test "data_of: the classes, a canonical decomposition and a tagged one, the tags in the order first met"
    text = "00A0;NO-BREAK SPACE;Zs;0;CS;<noBreak> 0020;;;;N;NON-BREAKING SPACE;;;;\n00C0;LATIN CAPITAL LETTER A WITH GRAVE;Lu;0;L;0041 0300;;;;N;;;;00E0;\n0300;COMBINING GRAVE ACCENT;Mn;230;NSM;;;;;N;;;;;\n"
    data = data_of(text).must()
    assert data.kinds == ["canonical", "noBreak"]
    assert data.points == [0xa0, 0xc0] && data.kind_of == [1, 0]
    assert data.mappings[1] == [0x41, 0x300]
    assert data.classes[0x300] == 230 && data.classes[0x41] == 0

test "data_of: a tag left open refused"
    assert data_of("00A0;NO-BREAK SPACE;Zs;0;CS;<noBreak 0020;;;;N;;;;;\n").is_err()

test "derived_of: an exclusion, both quick checks, and each line of NFKC_Casefold its own range"
    text = "0340..0341    ; Full_Composition_Exclusion\n0300 ; NFC_QC; M\n00A0 ; NFKC_QC; N\n180B..180D    ; NFKC_CF;\n180E          ; NFKC_CF;\n0041 ; NFKC_CF; 0061\n"
    d = derived_of(text).must()
    assert d.excluded[0x340] && d.excluded[0x341] && !d.excluded[0x342]
    assert d.nfc[0x300] == 1 && d.nfkc[0xa0] == 2 && d.nfc[0xa0] == 0
    assert d.fold_ranges == [0x41 << 21 | 0x41, 0x180b << 21 | 0x180d, 0x180e << 21 | 0x180e]
    assert d.fold_maps == [[0x61], [], []]
