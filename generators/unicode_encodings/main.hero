# The generator of `unicode/encodings`' tables of the WHATWG Encoding
# Standard: the names and labels of every encoding (`names_table`), the 28
# single-byte encodings (`single_byte_table`), and the indexes Big5, EUC-KR,
# gb18030, jis0208 and jis0212 (`big5_table`, `euc_kr_table`,
# `gb18030_table`, `jis0208_table`, `jis0212_table`), each written byte for
# byte, or checked against the table in the tree.
#
# Its input is the standard's resources, `encodings.json` and the
# `index-*.txt` files, kept unchanged in `whatwg/` beside this file as
# encoding.spec.whatwg.org served them on `layout.FETCHED`: the standard
# serves only its latest version, under the same names, so a copy kept here
# is what lets the tables be made again. Each index names its own version on
# its lines `# Identifier: ` and `# Date: `, which the tables' headers repeat.
# The Encoding Standard is © WHATWG (Apple, Google, Mozilla, Microsoft), under
# the Creative Commons Attribution 4.0 International License
# (https://creativecommons.org/licenses/by/4.0/), which lets these files be
# copied with that notice.
#
# Run from the repository's root:
#
#     heroes run generators/unicode_encodings/main.hero -- write
#     heroes run generators/unicode_encodings/main.hero -- check
#
# `write` writes the tables. `check` reads them and exits 0 where each is
# exactly what `write` would write, and 1 where one is not, naming its first
# line that differs. Either exits 2 where its words are not these, or where a
# file of `whatwg/` cannot be read or is not what the standard says it is.

use <rebel>/bytes
use <tablekit>/tablekit

use cjk
use indexes
use names
use single

# The folder of the standard's files, from the repository's root.
constant SOURCES: str
    "generators/unicode_encodings/whatwg/"

# The folder of the tables, from the repository's root.
constant TABLES: str
    "packages/rebel/0.1.0/files/unicode/encodings/internal/"

# The index `file` of `SOURCES`, read.
#
# Fails as reading the file and `indexes.read_index` fail.
function index_of(file: str) -> indexes.Index?
    return indexes.read_index(file: file, text: read_file(SOURCES + file)?)

# Does what `command` asks with every table, and answers the worst code it
# reached.
#
# - `command`: `write` or `check`.
#
# Fails as reading the standard's files, packing them and writing or reading
# a table fail.
function run(command: str) -> i64?
    listed = read_file(SOURCES + "encodings.json")?
    encodings = names.read_encodings(listed)?
    singles: [single.Single] @= []

    for name in names.single_byte_names(encodings)
        singles @ singles.push(single.Single(name: name, index: index_of(single.file_of(name))?))

    big5 = cjk.big5_text(index_of("index-big5.txt")?)?
    euc_kr = cjk.euc_kr_text(index_of("index-euc-kr.txt")?)?
    gb18030 = cjk.gb18030_text(index: index_of("index-gb18030.txt")?, ranges: index_of("index-gb18030-ranges.txt")?)?
    jis0208 = cjk.jis0208_text(index: index_of("index-jis0208.txt")?, katakana: index_of("index-iso-2022-jp-katakana.txt")?)?
    jis0212 = cjk.jis0212_text(index_of("index-jis0212.txt")?)?
    digest = tablekit.sha256_hex(bytes.from_text(listed))
    code @= tablekit.settle(command: command, path: TABLES + "names_table.hero", text: names.module_text(encodings, digest: digest)?)?
    code @ tablekit.worst(
        a: code,
        b: tablekit.settle(command: command, path: TABLES + "single_byte_table.hero", text: single.module_text(singles)?)?
    )
    code @ tablekit.worst(a: code, b: tablekit.settle(command: command, path: TABLES + "big5_table.hero", text: big5)?)
    code @ tablekit.worst(
        a: code,
        b: tablekit.settle(command: command, path: TABLES + "euc_kr_table.hero", text: euc_kr)?
    )
    code @ tablekit.worst(
        a: code,
        b: tablekit.settle(command: command, path: TABLES + "gb18030_table.hero", text: gb18030)?
    )
    code @ tablekit.worst(
        a: code,
        b: tablekit.settle(command: command, path: TABLES + "jis0208_table.hero", text: jis0208)?
    )
    code @ tablekit.worst(
        a: code,
        b: tablekit.settle(command: command, path: TABLES + "jis0212_table.hero", text: jis0212)?
    )
    return ok(code)

function main()
    words = tablekit.command_words("unicode_encodings")

    if words.len() != 1 || words[0] != "write" && words[0] != "check"
        print("usage, from the repository's root: heroes run generators/unicode_encodings/main.hero -- write|check")
        exit(code: 2)

    match run(words[0])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)
