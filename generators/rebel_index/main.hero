# The generator of the indexes of Rebel's programs and of its packages, from
# the tree alone, written byte for byte or checked against the files in the
# tree:
#
# - each program's own page, `examples-rebel/<name>/README.md`: its
#   `main.hero`'s opening comment, the one source of what it is and how it
#   runs for real, with its demo's command, the faces its catalogue lists and
#   what its folders hold (`program_text.hero`);
# - `examples-rebel/INDEX.md`, one line per program linking its page, the
#   applications first, then the twins;
# - `examples-rebel/PACKAGES.md`, every face of Rebel by layer, then every
#   public declaration of each on one line, read from what `heroes doc`
#   prints of the face, so the index says what the reference says
#   (`packages_text.hero`).
#
# **Why `PACKAGES.md` stands beside `INDEX.md` and not in Rebel's own tree**,
# measured on 2026-11-22 with `heroes add` in a scratch project reading a
# copy of Rebel 0.1.0 from a static index, a Markdown file added under its
# `files/`: an entry with a `packages` line, which `heroes add rebel/<face>`
# writes and every program of `examples-rebel/` has, placed 80 of the
# version's 1,714 files for `csv`, its modules alone and no Markdown file
# (`selfhost/fetch/closure.hero`: a placed part carries `.hero` files only);
# only an entry with no `packages` line placed the whole version and the
# file with it. So a file in Rebel's tree would travel with few programs.
#
# Run from the repository's root, naming the compiler whose `heroes doc`
# reads the faces:
#
#     heroes run generators/rebel_index/main.hero -- write ./heroes
#     heroes run generators/rebel_index/main.hero -- check ./heroes
#
# `write` writes every page. `check` reads each and exits 0 where every one is
# exactly what `write` would write, and 1 where one is not or is missing,
# naming it and its first line that differs. Either exits 2 where its words
# are not these, where a folder of `examples-rebel/` is no program, where
# README § A1 and Rebel's tree disagree, or where `heroes doc` refuses a
# face: each refusal is printed with what the compiler told, since the index
# would otherwise leave out a face a program can name.

use <rebel>/fs
use <tablekit>/tablekit

use faces
use packages_text
use program_text
use programs
use reference

# The short list of Rebel's programs, from the repository's root.
constant INDEX: str
    "examples-rebel/INDEX.md"

# The index of Rebel's packages, from the repository's root.
constant PACKAGES: str
    "examples-rebel/PACKAGES.md"

# Does what `command` asks with every page, `heroes doc` run by `compiler`,
# and answers the code it reached.
#
# - `command`: `write` or `check`.
# - `compiler`: the compiler, as the words name it.
#
# Fails where a program, the rules page, Rebel's tree or a page cannot be
# read or written, and as reading a program or README § A1 fails.
function run(command: str, compiler: str) -> i64?
    found: [programs.Program] @= []

    for name in programs.program_names()?
        found @ found.push(programs.read_program(name)?)

    version = faces.newest_version()?
    paths = faces.faces_of(faces.TREE + "/" + version + "/files")?
    guide = read_file(faces.GUIDE)?
    rows = faces.rows_of(guide: guide, faces: paths)?
    vocabulary = faces.vocabulary(guide)?
    references: {str: reference.Reference} @= {}
    refused @= 0

    for a in faces.answers(compiler: fs.to_abs(compiler)?, version: version, faces: paths)?
        match a.reference
            .ok r => references[a.face] @ r
            .err e =>
                print("refused: ", e.msg)
                refused @ refused + 1

    if refused > 0
        print(
            f"{refused} of {paths.len()} faces have no reference, so the index of Rebel's packages cannot be written: each is a finding of the face's comments, never left out of the index"
        )
        return ok(tablekit.REFUSED)
    code @= tablekit.DONE

    for p in found
        code @ tablekit.worst(
            a: code,
            b: settled(command: command, path: p.folder + "/" + programs.README, text: program_text.readme(p))?
        )

    code @ tablekit.worst(a: code, b: settled(command: command, path: INDEX, text: program_text.index_page(found))?)
    page = packages_text.packages_page(version: version, rows: rows, references: references, vocabulary: vocabulary)?
    code @ tablekit.worst(a: code, b: settled(command: command, path: PACKAGES, text: page)?)
    return ok(code)

# Does what `command` asks with one page, as `tablekit.settle` does, a page
# `check` finds missing told as one that differs.
#
# - `command`: `write` or `check`.
# - `path`: the page, from the repository's root.
# - `text`: the page's whole text, as the generator writes it.
#
# Fails where the page cannot be read or written.
function settled(command: str, path: str, text: str) -> i64?
    if command == "check" && !fs.is_file(path)?
        print(path, " is missing: its generator writes it")
        return ok(tablekit.DIFFERS)
    return tablekit.settle(command: command, path: path, text: text)

function main()
    words = tablekit.command_words("rebel_index")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run generators/rebel_index/main.hero -- write|check <compiler>"
        )
        exit(code: 2)

    match run(command: words[0], compiler: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)
