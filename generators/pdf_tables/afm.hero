# What `pdf_tables` reads of an Adobe Font Metrics file (AFM 4.1): each
# glyph's code, width and name, and the global keys of its header.

use <rebel>/strings

# One glyph of the font: its code in the font's built-in encoding, -1 where
# it has none, its width in thousandths of the size, and its name.
record Glyph
    code: i64
    width: i64
    name: str

# A font: its name as its file is named, its glyphs in the file's order, and
# each global key of its header with the rest of its line.
record Font
    name: str
    glyphs: [Glyph]
    globals: {str: str}

# `text` as a whole number, its sign `-` or none.
#
# Fails `invalid` where it is not one.
function whole(text: str) -> i64?
    digits = strings.trim_prefix(s: text, prefix: "-")

    if digits == "" || strings.trim_any(s: digits, set: "0123456789") != "" || digits.len() > 9
        return fail(code: "invalid", msg: f"\"{text}\" is not a whole number")
    value @= 0

    for c in digits.chars()
        value @ value * 10 + strings.index_of(s: "0123456789", substr: c)?

    if text.len() > digits.len()
        return ok(-value)
    return ok(value)

# The glyph a metrics line `C code ; WX width ; N name ; B ... ;` describes.
#
# Fails `invalid` where it names no code, width or name.
function glyph_of(line: str) -> Glyph?
    code @= ""
    width @= ""
    name @= ""

    for field in strings.split(s: line, sep: ";")
        words = strings.words(field)

        if words.len() == 2 && words[0] == "C"
            code @ words[1]
        else if words.len() == 2 && words[0] == "WX"
            width @ words[1]
        else if words.len() == 2 && words[0] == "N"
            name @ words[1]

    if code == "" || width == "" || name == ""
        return fail(code: "invalid", msg: f"the metrics line \"{line}\" names no code, width or name")
    return ok(Glyph(code: whole(code)?, width: whole(width)?, name: name))

# The font `text`, the whole of the AFM file named `name`.
#
# Fails `invalid` where it does not open with `StartFontMetrics`, its glyphs
# are not between `StartCharMetrics` and `EndCharMetrics`, or a code is past
# 255; and as `glyph_of` fails.
function read_afm(name: str, text: str) -> Font?
    lines = strings.split_terminated(s: text, sep: "\n")

    if lines.len() == 0 || !strings.has_prefix(s: lines[0], prefix: "StartFontMetrics ")
        return fail(code: "invalid", msg: f"{name}.afm does not open with StartFontMetrics")
    out @= Font(name: name, glyphs: [], globals: {})
    inside @= false
    ended @= false

    for line in lines
        if line == "EndCharMetrics"
            inside @ false
            ended @ true
        else if inside
            glyph = glyph_of(line)?

            if glyph.code > 255
                return fail(code: "invalid", msg: f"{name}.afm gives {glyph.name} the code {glyph.code}")
            out.glyphs @ out.glyphs.push(glyph)
        else if strings.has_prefix(s: line, prefix: "StartCharMetrics ")
            inside @ true
        else if !ended
            match strings.split_once(s: line, sep: " ")
                .ok halves => out.globals[halves.before] @ strings.trim(halves.after)
                .err _     => _ = 0

    if !ended || out.glyphs.len() == 0
        return fail(code: "invalid", msg: f"{name}.afm holds no glyphs between StartCharMetrics and EndCharMetrics")
    return ok(out)

## Tests

test "read_afm: the globals, a glyph with a code and one without, and a file of no glyphs refused"
    text = "StartFontMetrics 4.1\nFontName Helvetica\nItalicAngle -12\nStartCharMetrics 2\nC 32 ; WX 278 ; N space ; B 0 0 0 0 ;\nC -1 ; WX 556 ; N Euro ; B 0 0 0 0 ;\nEndCharMetrics\nStartKernData\nEndFontMetrics\n"
    font = read_afm(name: "Helvetica", text: text).must()
    assert font.glyphs == [Glyph(code: 32, width: 278, name: "space"), Glyph(code: -1, width: 556, name: "Euro")]
    assert font.globals["ItalicAngle"].must() == "-12" && font.globals["StartKernData"].is_err()
    assert read_afm(name: "x", text: "StartFontMetrics 4.1\nStartCharMetrics 0\nEndCharMetrics\n").is_err()
    assert read_afm(name: "x", text: "Comment\n").is_err()

test "whole: a sign, none, and words that are not numbers refused"
    assert whole("-207").must() == -207 && whole("1010").must() == 1010
    assert whole("").is_err() && whole("1.5").is_err() && whole("-").is_err()
