# The generator of `i18n/collate`'s table of CLDR 49's root collation and
# tailorings, `i18n/collate/internal/collate_tables.hero`, written byte for
# byte, or checked against the table in the tree.
#
# Its input is CLDR 49's core data, fetched from `cldrkit.COMMON_URL` into any
# folder; `cldrkit` holds it to its SHA-256. Run from the repository's root:
#
#     heroes run generators/i18n_collate/main.hero -- write <zip>
#     heroes run generators/i18n_collate/main.hero -- check <zip>
#
# `write` writes the table. `check` reads it and exits 0 where it is exactly
# what `write` would write, and 1 where it is not, naming its first line
# that differs. Either exits 2 where its words are not these, where the zip's
# digest is not the pinned one, or where its data is not what the generator
# reads.

use <cldrkit>/cldrkit
use <tablekit>/tablekit

use allkeys
use groups
use tailorings

# The table, from the repository's root.
constant TABLE: str
    "packages/rebel/0.1.0/files/i18n/collate/internal/collate_tables.hero"

# How many entries, and how many elements, a chunk holds.
constant CHUNK: i64
    512

# The table's comment, above its constants.
function head() -> [str]
    return [
        "# The root collation of CLDR release 49 (UCA 18.0.0, its allkeys_CLDR.txt)"
        "# and the tailoring rules CLDR gives every language but Chinese, Japanese and"
        "# Korean, which `i18n/collate` reads."
        "#"
        "# A collation element is 31 bits, variable << 30 | primary << 14 |"
        "# secondary << 5 | tertiary, written in six characters of `ALPHABET`, its"
        "# number in base 64. A character's entry is 42 bits, its code point << 21 |"
        "# its first element's position << 5 | its count of elements, in seven."
        "# Code points with no entry take UCA's implicit weights."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `generators/i18n_collate/` read CLDR 49's core data, `cldr-common-49.zip`"
        "# of https://unicode.org/Public/cldr/49/ (SHA-256"
        f"# {cldrkit.COMMON_SHA256},"
        "# fetched 2026-11-22), its files `common/uca/allkeys_CLDR.txt` and"
        "# `FractionalUCA.txt` (for the bounds of the reordering groups),"
        "# `common/collation/*.xml` and `common/bcp47/collation.xml`, and wrote this"
        "# module whole; its `check` command says whether this module is still what"
        "# it writes."
    ]

# `codes` joined, `size` of them to a chunk.
function chunks(codes: [str] lent, size: i64) -> [str]
    out: [str] @= []
    at @= 0

    while at < codes.len()
        end @= at + size

        if end > codes.len()
            end @ codes.len()
        out @ out.push(codes.slice(from: at, to: end).join(""))
        at @ end

    return out

# The whole text of `collate_tables`.
#
# Fails as reading the data and writing a literal fail.
function module_text(release: cldrkit.Release lent) -> str?
    root = allkeys.read_root(cldrkit.text_member(release, name: "common/uca/allkeys_CLDR.txt")?)?
    bounds = groups.read_bounds(cldrkit.text_member(release, name: "common/uca/FractionalUCA.txt")?, primaries: root.primaries)?
    rules = tailorings.read_tailorings(release)?
    points = sort(keys(root.entries))
    singles: [str] @= []

    for point in points
        singles @ singles.push(allkeys.code_of(n: root.entries[point].must(), width: 7)?)

    elements: [str] @= []

    for element in root.elements
        elements @ elements.push(allkeys.code_of(n: element, width: 6)?)

    contraction_keys = sort(keys(root.contractions))
    contraction_elements: [str] @= []

    for key in contraction_keys
        contraction_elements @ contraction_elements.push(root.contractions[key].must())

    parts = [
        head().join("\n")
        tablekit.string_constant(comment: ["# The characters a number is written with."], name: "ALPHABET", value: allkeys.ALPHABET)?
        tablekit.number_constant(comment: ["# The last primary weight of the spaces and of the punctuation, the first", "# of the currency signs, and the last of the letters before the implicit", "# weights: the bounds of the groups a collator may treat as variable."], name: "LAST_SPACE", value: bounds.last_space)
        tablekit.number_constant(comment: [], name: "LAST_PUNCT", value: bounds.last_punct)
        tablekit.number_constant(comment: [], name: "FIRST_CURRENCY", value: bounds.first_currency)
        tablekit.number_constant(comment: [], name: "LAST_REGULAR", value: root.last_regular)
        tablekit.number_constant(comment: ["# How many characters have an entry."], name: "SINGLE_COUNT", value: points.len())
        tablekit.strings_constant(comment: ["# The characters' entries, in the order of their code points, 512 to a", "# chunk."], name: "SINGLES", items: chunks(singles, size: CHUNK))?
        tablekit.strings_constant(comment: ["# The collation elements, 512 to a chunk."], name: "ELEMENTS", items: chunks(elements, size: CHUNK))?
        tablekit.strings_constant(comment: ["# The contractions, texts of more than one character, in the order of their", "# bytes."], name: "CONTRACTION_KEYS", items: contraction_keys)?
        tablekit.strings_constant(comment: ["# The elements of each contraction, in the order of `CONTRACTION_KEYS`."], name: "CONTRACTION_ELEMENTS", items: contraction_elements)?
        tablekit.strings_constant(comment: ["# The tailorings, a locale and a collation type separated by a space, `de", "# phonebk`, in the order of their bytes."], name: "RULE_KEYS", items: rules.keys_of)?
        tablekit.strings_constant(comment: ["# The rules of each, CLDR's, its imports written first, in the order of", "# `RULE_KEYS`."], name: "RULE_TEXTS", items: rules.texts)?
    ]
    return ok(parts.join("\n\n") + "\n")

# Does what `command` asks with the table, reading the zip at `path`.
#
# Fails as opening the zip, reading its data and writing or reading the table
# fail.
function run(command: str, path: str) -> i64?
    release = cldrkit.open_common(path)?
    return tablekit.settle(command: command, path: TABLE, text: module_text(release)?)

function main()
    words = tablekit.command_words("i18n_collate")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run generators/i18n_collate/main.hero -- write|check <zip of ",
            cldrkit.COMMON_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], path: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "chunks: full chunks joined, then the rest"
    assert chunks(["ab", "cd", "ef"], size: 2) == ["abcd", "ef"]
    assert chunks([], size: 2) == []
