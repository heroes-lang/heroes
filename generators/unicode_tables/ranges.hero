# The three packings of `unicode`'s tables, each made from every code
# point's value and read back to it:
#
# - a set as ranges `first << 21 | last`, both ends in it, ascending;
# - a map from code points to a number added to them as ranges `first << 22
#   | last << 1 | step - 1` beside their deltas: a range opens at the least
#   code point not yet in one, and its step is 1 or 2 where the next code
#   point of the map is that far above and has the same delta, else 1; it
#   goes on while the code point a step above is in the map with that delta;
# - a list of values as runs `first << shift | value`, a run opening at 0
#   and wherever the value changes.

# A map packed as ranges and their deltas.
record Ranges
    ranges: [i64]
    deltas: [i64]

# The ranges of the code points `set` holds.
#
# - `set`: whether each code point is in the set.
function set_ranges(set: [bool] lent) -> [i64]
    out: [i64] @= []
    at @= 0

    while at < set.len()
        if set[at]
            last @= at

            while last + 1 < set.len() && set[last + 1]
                last @ last + 1

            out @ out.push(at << 21 | last)
            at @ last + 1
        else
            at @ at + 1

    return out

# A map from code points to deltas, packed as ranges.
#
# - `points`: the code points of the map, ascending.
# - `deltas`: the delta of each, at the same index.
function delta_ranges(points: [i64] lent, deltas: [i64] lent) -> Ranges
    ranges: [i64] @= []
    out_deltas: [i64] @= []
    at @= 0

    while at < points.len()
        first = points[at]
        delta = deltas[at]
        end @= at
        step @= 1

        if at + 1 < points.len() && deltas[at + 1] == delta && (points[at + 1] - first == 1 || points[at + 1] - first == 2)
            step @ points[at + 1] - first

            while end + 1 < points.len() && points[end + 1] == points[end] + step && deltas[end + 1] == delta
                end @ end + 1
        ranges @ ranges.push(first << 22 | points[end] << 1 | step - 1)
        out_deltas @ out_deltas.push(delta)
        at @ end + 1

    return Ranges(ranges: ranges, deltas: out_deltas)

# The runs of `values`, each `first << shift | value`.
#
# - `values`: each code point's value.
# - `shift`: where a run's first code point stands.
function runs_of(values: [i64] lent, shift: i64) -> [i64]
    out: [i64] @= []
    at @= 0

    while at < values.len()
        if at == 0 || values[at] != values[at - 1]
            out @ out.push(at << shift | values[at])
        at @ at + 1

    return out

# Nothing where `set_ranges`' ranges read back as `set`.
#
# Fails `invalid`, naming the first code point they read otherwise.
function held_set(ranges: [i64] lent, set: [bool] lent) -> ()?
    read: [bool] @= []

    for _ in set
        read @ read.push(false)

    for one in ranges
        at @= one >> 21

        while at <= one & 0x1fffff
            read[at] @ true
            at @ at + 1

    at @= 0

    while at < set.len()
        if read[at] != set[at]
            return fail(code: "invalid", msg: f"the ranges read {at} otherwise than the data")
        at @ at + 1

    return ok()

# Nothing where `packed` reads back as each code point of `points` to its
# delta and no other code point.
#
# Fails `invalid`, naming the first code point it reads otherwise.
function held_deltas(packed: Ranges lent, points: [i64] lent, deltas: [i64] lent) -> ()?
    read: {i64: i64} @= {}
    at @= 0

    while at < packed.ranges.len()
        one = packed.ranges[at]
        point @= one >> 22
        step = (one & 1) + 1

        while point <= one >> 1 & 0x1fffff
            read[point] @ packed.deltas[at]
            point @ point + step

        at @ at + 1

    if read.len() != points.len()
        return fail(code: "invalid", msg: f"the ranges hold {read.len()} code points and the data {points.len()}")
    at @ 0

    while at < points.len()
        if read[points[at]].default(deltas[at] + 1) != deltas[at]
            return fail(code: "invalid", msg: f"the ranges read {points[at]} otherwise than the data")
        at @ at + 1

    return ok()

# Nothing where the run that a binary search finds for each code point holds
# that code point's value.
#
# Fails `invalid`, naming the first code point whose lookup does not.
function held_runs(runs: [i64] lent, values: [i64] lent, shift: i64) -> ()?
    mask = (1 << shift) - 1
    point @= 0

    while point < values.len()
        low @= 0
        high @= runs.len() - 1

        while low < high
            middle = (low + high + 1) / 2

            if runs[middle] >> shift <= point
                low @ middle
            else
                high @ middle - 1

        if runs[low] & mask != values[point]
            return fail(code: "invalid", msg: f"the runs read {point} otherwise than the data")
        point @ point + 1

    return ok()

## Tests

test "delta_ranges: a step of 1, a step of 2, a lone code point, and a change of delta closing a range"
    packed = delta_ranges(points: [65, 66, 67, 256, 258, 260, 300, 301], deltas: [32, 32, 32, 1, 1, 1, 5, 6])
    assert packed.ranges == [65 << 22 | 67 << 1, 256 << 22 | 260 << 1 | 1, 300 << 22 | 300 << 1, 301 << 22 | 301 << 1]
    assert packed.deltas == [32, 1, 5, 6]
    assert !held_deltas(packed, points: [65, 66, 67, 256, 258, 260, 300, 301], deltas: [32, 32, 32, 1, 1, 1, 5, 6]).is_err()
    assert held_deltas(packed, points: [65, 66, 67], deltas: [32, 32, 32]).is_err()

test "set_ranges and held_set: two ranges, one a single code point"
    set = [false, true, true, false, true, false]
    ranges = set_ranges(set)
    assert ranges == [1 << 21 | 2, 4 << 21 | 4]
    assert !held_set(ranges, set: set).is_err()
    assert held_set([1 << 21 | 1], set: set).is_err()

test "runs_of and held_runs: a run at 0 and where the value changes"
    values = [3, 3, 4, 3]
    runs = runs_of(values, shift: 5)
    assert runs == [3, 2 << 5 | 4, 3 << 5 | 3]
    assert !held_runs(runs: runs, values: values, shift: 5).is_err()
