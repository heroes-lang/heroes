# The generator of `unicode/segment`'s table,
# `unicode/segment/internal/tables.hero`: for every code point, the classes
# UAX #29 and UAX #14 cut a text by, its East Asian width, and the few other
# properties the rules and the width of a text read, packed into runs,
# written byte for byte, or checked against the table in the tree.
#
# Its inputs are eight files of the Unicode Character Database 17.0.0,
# which never changes, fetched from `UCD_URL` into one folder under the
# names they are served by and each held to its SHA-256 in `INPUTS`. Run
# from the repository's root:
#
#     heroes run generators/unicode_segment/main.hero -- write <folder>
#     heroes run generators/unicode_segment/main.hero -- check <folder>
#
# `write` writes the table. `check` reads it and exits 0 where it is exactly
# what `write` would write, and 1 where it is not, naming its first line that
# differs. Either exits 2 where its words are not these, where a file's
# digest is not the pinned one, or where a line of a file is not what the
# database writes or a code point is left with no value.

use <rebel>/strings
use <tablekit>/tablekit
use <ucdkit>/ucdkit

# Where the database's files are served, each under its folder there.
constant UCD_URL: str
    "https://www.unicode.org/Public/17.0.0/ucd/"

# Each input's name in the folder and its SHA-256, in lowercase hexadecimal.
constant INPUTS: [str]
    [
        "LineBreak.txt e6a18fa91f8f6a6f8e534b1d3f128c21ada45bfe152eb6b1bcc5e15fd8ac92e6"
        "WordBreakProperty.txt 72274cac1e6b919507db35655c3e175aa27274668a1ece95c28d2069f2ad9852"
        "SentenceBreakProperty.txt 871c0c985ad95125e25b302414065a10839d068970bceb383ecec138f22a0a18"
        "GraphemeBreakProperty.txt d6b51d1d2ae5c33b451b7ed994b48f1f4dc62b2272a5831e7fd418514a6bae89"
        "EastAsianWidth.txt ea7ce50f3444a050333448dffef1cadd9325af55cbb764b4a2280faf52170a33"
        "DerivedCoreProperties.txt 24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"
        "emoji-data.txt 2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b"
        "UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"
    ]

# The table, from the repository's root.
constant TABLE: str
    "packages/rebel/0.1.0/files/unicode/segment/internal/tables.hero"

# An enumerated property the runs hold: its name, the file that gives it,
# the property's own name in that file's lines where they name several
# (`InCB`), the prefix of its index constants, its list's name and its
# first bit. Line_Break's names stand in the order of their bytes; every
# other property's default value, the one its `# @missing:` line gives all
# of the code points, stands first, then the rest in the order of their
# bytes.
record Property
    name: str
    file: str
    tag: str
    prefix: str
    list: str
    shift: i64

# The six, in the order the table lists them.
function properties() -> [Property]
    return [
        Property(name: "Line_Break", file: "LineBreak.txt", tag: "", prefix: "LB", list: "LINE_NAMES", shift: 0)
        Property(name: "Word_Break", file: "WordBreakProperty.txt", tag: "", prefix: "WB", list: "WORD_NAMES", shift: 6)
        Property(name: "Sentence_Break", file: "SentenceBreakProperty.txt", tag: "", prefix: "SB", list: "SENTENCE_NAMES", shift: 11)
        Property(name: "Grapheme_Cluster_Break", file: "GraphemeBreakProperty.txt", tag: "", prefix: "GB", list: "GRAPHEME_NAMES", shift: 15)
        Property(name: "Indic_Conjunct_Break", file: "DerivedCoreProperties.txt", tag: "InCB", prefix: "INCB", list: "CONJUNCT_NAMES", shift: 19)
        Property(name: "East_Asian_Width", file: "EastAsianWidth.txt", tag: "", prefix: "EA", list: "WIDTH_NAMES", shift: 21)
    ]

# The text of the input `name` in `folder`, held to its pinned SHA-256.
#
# Fails as reading it fails, and `invalid` where `INPUTS` names no such
# input or its digest is another.
function input(folder: str, name: str) -> str?
    for one in INPUTS
        if one.slice(from: 0, to: name.len() + 1) == name + " "
            return tablekit.pinned_text(
                path: folder + "/" + name,
                sha256: one.slice(from: name.len() + 1, to: one.len())
            )

    return fail(code: "invalid", msg: f"no input is named {name}")

# The value a line gives `property`, or the empty text where the line gives
# another property.
function value_of(line: ucdkit.Line lent, property: Property lent) -> str
    if property.tag == ""
        if line.fields.len() == 1
            return line.fields[0]
        return ""

    if line.fields.len() == 2 && line.fields[0] == property.tag
        return line.fields[1]
    return ""

# One property's names, in the order the runs number them, and each code
# point's index into them.
record Values
    names: [str]
    indices: [i64]

# The values of `property` that `text`, its file, gives every code point:
# its `# @missing:` lines first, each over the ones before it, then its data
# lines.
#
# Fails as reading the lines fails, and `invalid` where a code point is
# left with no value.
function read_values(text: str, property: Property lent) -> Values?
    missing = ucdkit.missing_lines(text)?
    data = ucdkit.data_lines(text)?
    seen: {str: i64} @= {}
    fallback @= ""

    for line in missing
        value = value_of(line, property: property)

        if value != ""
            seen[value] @ 0

            if line.first == 0 && line.last == ucdkit.LAST_POINT
                fallback @ value

    for line in data
        value = value_of(line, property: property)

        if value != ""
            seen[value] @ 0

    names: [str] @= []

    if property.prefix != "LB"
        names @ names.push(fallback)

    for name in sort(keys(seen))
        if property.prefix == "LB" || name != fallback
            names @ names.push(name)

    index: {str: i64} @= {}

    for name in names
        index[name] @ index.len()

    indices: [i64] @= []

    while indices.len() < ucdkit.POINTS
        indices @ indices.push(-1)

    for lines in [missing, data]
        for line in lines
            value = value_of(line, property: property)

            if value != ""
                at @= line.first
                number = index[value].must()

                while at <= line.last
                    indices[at] @ number
                    at @ at + 1

    for one in indices
        if one < 0
            return fail(code: "invalid", msg: f"{property.file} leaves a code point with no {property.name}")

    return ok(Values(names: names, indices: indices))

# The group of each code point's general category that the runs hold: 1 Cn,
# 2 Pi, 3 Pf, 4 Mn, 5 Mc, 6 Me, 7 Cc or Cf, 0 any other; read from
# `UnicodeData.txt`, a range given by its `First>` and `Last>` lines, a code
# point it does not list `Cn`.
#
# Fails `invalid` where a line has no category or a range is not closed.
function category_groups(text: str) -> [i64]?
    out: [i64] @= []

    while out.len() < ucdkit.POINTS
        out @ out.push(1)

    opened @= -1

    for line in strings.split_terminated(s: text, sep: "\n")
        fields = strings.split(s: line, sep: ";")

        if fields.len() < 3
            return fail(code: "invalid", msg: f"the line \"{line}\" of UnicodeData.txt has no category")
        code = ucdkit.hex_of(fields[0])?

        group = match fields[2]
            "Cn"        => 1
            "Pi"        => 2
            "Pf"        => 3
            "Mn"        => 4
            "Mc"        => 5
            "Me"        => 6
            "Cc" | "Cf" => 7
            _           => 0

        if strings.has_suffix(s: fields[1], suffix: ", First>")
            opened @ code
        else if strings.has_suffix(s: fields[1], suffix: ", Last>")
            if opened < 0
                return fail(
                    code: "invalid",
                    msg: f"the range closed at {fields[0]} of UnicodeData.txt was never opened"
                )
            at @= opened

            while at <= code
                out[at] @ group
                at @ at + 1

            opened @ -1
        else
            out[code] @ group

    return ok(out)

# The whole text of the table.
#
# - `folder`: the folder of the inputs.
#
# Fails as reading an input and its values fail, and as writing a literal
# fails.
function module_text(folder: str) -> str?
    head: [str] @= [
        "# The table of `unicode/segment`, in Unicode 17.0.0: for every code point,"
        "# the classes UAX #29 and UAX #14 cut a text by, its East Asian width, and"
        "# the few other properties the rules and the width of a text read."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `generators/unicode_segment/` read the Unicode Character Database 17.0.0,"
        "# each file held to its SHA-256, packed every code point's values into"
        "# runs, and wrote this module whole; its `check` command says whether this"
        "# module is still what it writes. What it read:"
        "#"
    ]

    for one in INPUTS
        halves = strings.split_once(s: one, sep: " ")?
        head @ head.push(f"# - `{halves.before}`, SHA-256 {halves.after}")

    packed: [i64] @= []

    while packed.len() < ucdkit.POINTS
        packed @ packed.push(0)

    lists: [str] @= []
    indices: [str] @= []

    for property in properties()
        values = read_values(input(folder: folder, name: property.file)?, property: property)?
        at @= 0

        while at < ucdkit.POINTS
            packed[at] @ packed[at] | values.indices[at] << property.shift
            at @ at + 1

        lists @ lists.push(
            tablekit.strings_constant(comment: [f"# The {property.name} values, in the order the runs number them."], name: property.list, items: values.names)?
        )
        section: [str] @= [f"## Indices of the {property.name} values"]
        number @= 0

        for name in values.names
            section @ section.push(
                tablekit.number_constant(comment: [f"# The index of {name}."], name: property.prefix + "_" + strings.to_upper(name), value: number)
            )
            number @ number + 1

        indices @ indices.push(section.join("\n\n"))

    core = input(folder: folder, name: "DerivedCoreProperties.txt")?
    emoji = input(folder: folder, name: "emoji-data.txt")?
    flags = [
        ucdkit.property_set(text: emoji, name: "Extended_Pictographic")?
        ucdkit.property_set(text: emoji, name: "Emoji")?
        ucdkit.property_set(text: emoji, name: "Emoji_Presentation")?
        ucdkit.property_set(text: core, name: "Default_Ignorable_Code_Point")?
    ]
    groups = category_groups(input(folder: folder, name: "UnicodeData.txt")?)?
    runs: [i64] @= []
    at @= 0

    while at < ucdkit.POINTS
        value @= packed[at] | groups[at] << 28
        bit @= 24

        for flag in flags
            if flag[at]
                value @ value | 1 << bit
            bit @ bit + 1

        if runs.len() == 0 || runs[runs.len() - 1] & 0xffffffff != value
            runs @ runs.push(at << 32 | value)
        at @ at + 1

    runs_comment = [
        "# Every code point's values, as runs `first << 32 | value`, ascending, each"
        "# run reaching to the next: the Line_Break value is bits 0 to 5 of `value`,"
        "# Word_Break 6 to 10, Sentence_Break 11 to 14, Grapheme_Cluster_Break 15 to"
        "# 18, Indic_Conjunct_Break 19 and 20, East_Asian_Width 21 to 23, each an"
        "# index into its list of names; bit 24 is Extended_Pictographic, 25 Emoji, 26"
        "# Emoji_Presentation, 27 Default_Ignorable_Code_Point; bits 28 to 30 group"
        "# the general category: 1 Cn, 2 Pi, 3 Pf, 4 Mn, 5 Mc, 6 Me, 7 Cc or Cf, 0"
        "# any other."
    ]
    closing = [
        "## Tests"
        ""
        "test \"tables: the runs ascend from 0, and every value names a name\""
        "    assert RUNS[0] >> 32 == 0"
        "    at: i64 @= 1"
        ""
        "    while at < RUNS.len()"
        "        assert RUNS[at - 1] < RUNS[at]"
        "        assert RUNS[at] & 63 < LINE_NAMES.len()"
        "        assert RUNS[at] >> 6 & 31 < WORD_NAMES.len()"
        "        at @ at + 1"
        ""
        "    assert WORD_NAMES[0] == \"Other\" && SENTENCE_NAMES[0] == \"Other\" && GRAPHEME_NAMES[0] == \"Other\""
    ]
    parts = [
        head.join("\n")
        lists.join("\n\n")
        indices.join("\n\n")
        "## The runs\n\n" + tablekit.numbers_constant(comment: runs_comment, name: "RUNS", items: runs)
        closing.join("\n")
    ]
    return ok(parts.join("\n\n") + "\n")

# Does what `command` asks with the table, and answers the code it reached.
#
# Fails as `module_text` fails and as writing or reading the table fails.
function run(command: str, folder: str) -> i64?
    return tablekit.settle(command: command, path: TABLE, text: module_text(folder)?)

function main()
    words = tablekit.command_words("unicode_segment")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run generators/unicode_segment/main.hero -- write|check <folder of the files of ",
            UCD_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], folder: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)

## Tests

test "read_values: the default first, the rest by their bytes, a later line over an earlier one"
    text = "# @missing: 0000..10FFFF; Other\n0041..005A ; ALetter\n0030 ; Numeric\n0031 ; ALetter\n"
    values = read_values(text, property: properties()[1]).must()
    assert values.names == ["Other", "ALetter", "Numeric"]
    assert values.indices[0x41] == 1 && values.indices[0x30] == 2 && values.indices[0x31] == 1 && values.indices[0x20] == 0

test "read_values: Line_Break's names all by their bytes, and a property of one line among others"
    lines = read_values("# @missing: 0000..10FFFF; XX\n0041 ; AL\n", property: properties()[0]).must()
    assert lines.names == ["AL", "XX"]
    incb = read_values(
        "# @missing: 0000..10FFFF; InCB; None\n0915 ; InCB; Consonant\n0041 ; Alphabetic\n",
        property: properties()[4]
    ).must()
    assert incb.names == ["None", "Consonant"] && incb.indices[0x915] == 1 && incb.indices[0x41] == 0

test "read_values: a code point left with no value refused"
    assert read_values("0041 ; ALetter\n", property: properties()[1]).is_err()

test "category_groups: a listed point, a range, and a point not listed"
    text = "0000;<control>;Cc;0;BN;;;;;N;NULL;;;;\n0300;COMBINING GRAVE ACCENT;Mn;230;NSM;;;;;N;;;;;\n4E00;<CJK Ideograph, First>;Lo;0;L;;;;;N;;;;;\n9FFF;<CJK Ideograph, Last>;Lo;0;L;;;;;N;;;;;\n"
    groups = category_groups(text).must()
    assert groups[0] == 7 && groups[0x300] == 4 && groups[0x5000] == 0 && groups[0x378] == 1
