# The generator of `unicode/names`' two tables, each written byte for byte
# or checked against the module in the tree: its properties,
# `unicode/names/internal/property_tables.hero` (scripts and script
# extensions, blocks, the binary properties of `PropList.txt`,
# `DerivedCoreProperties.txt` and `emoji-data.txt`, numeric values, the
# Bidi_Class, Bidi_Mirrored and the mirroring glyphs), and its names,
# `unicode/names/internal/name_table.hero` (every name as words, the ranges
# a rule names, the aliases, the named sequences, and the index of them all
# by the hash of their loose form).
#
# Its inputs are sixteen files of the Unicode Character Database 17.0.0,
# which never changes, fetched from `UCD_URL` (`emoji-data.txt` from its
# folder `emoji/`, the three `Derived` files of numbers and classes from
# `extracted/`) into one folder under the names they are served by, and each
# held to its SHA-256 in `INPUTS`. Run from the repository's root:
#
#     heroes run generators/unicode_names/main.hero -- write <folder>
#     heroes run generators/unicode_names/main.hero -- check <folder>
#
# `write` writes the modules. `check` reads them and exits 0 where each is
# exactly what `write` would write, and 1 where one is not, naming its first
# line that differs. Either exits 2 where its words are not these, where a
# file's digest is not the pinned one, or where a line of a file is not what
# the database writes.

use <rebel>/strings
use <tablekit>/tablekit

use lookup
use naming
use properties
use scripts
use values

# Where the database's files are served, each under its folder there.
constant UCD_URL: str
    "https://www.unicode.org/Public/17.0.0/ucd/"

# Each input of the properties' module, its name in the folder and its
# SHA-256, in lowercase hexadecimal.
constant INPUTS: [str]
    [
        "Scripts.txt 9f5e50d3abaee7d6ce09480f325c706f485ae3240912527e651954d2d6b035bf"
        "ScriptExtensions.txt ec2107e58825a1586acee8e0911ce18260394ac8b87e535ca325f1ccbeb06bc6"
        "PropertyValueAliases.txt 64e9a5f76f7a1e8b5a47d6a1f9a26522a251208f5276bdfa1559dac7cf2e827a"
        "PropertyAliases.txt 4441f573caf952ffece1d7c892e7715bd7136dfc26f96eb6f268bf1e474715fb"
        "Blocks.txt c0edefaf1a19771e830a82735472716af6bf3c3975f6c2a23ffbe2580fbbcb15"
        "PropList.txt 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd"
        "DerivedCoreProperties.txt 24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"
        "emoji-data.txt 2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b"
        "DerivedNumericType.txt 7c83684d3336b698381745b78a971c3e1242cb3fcac58604469086c19b6edcee"
        "DerivedNumericValues.txt 139b976bdc288be01c80f018523da769cf2845109b5a7f0f8a432db64bfedcfa"
        "DerivedBidiClass.txt 4867b4b7f0731ed1bfcd34cc6251211ff1542541fce0734b6fbda139ee80b3a4"
        "UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"
        "BidiMirroring.txt a2f16fb873ab4fcdf3221cb1a8a85a134ddd6ed03603181823ff5206af3741ce"
    ]

# Each input of the names' module, as `INPUTS` names its own.
constant NAME_INPUTS: [str]
    [
        "UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"
        "NameAliases.txt 793f6f1e4d15fd90f05ae66460191dc4d75d1fea90136a25f30dd6a4cb950eac"
        "NamedSequences.txt 0cd1c928edac72ea1369187599727c4f0d92367316b4c5ee5140475ab9298be0"
        "Jamo.txt 17bb07f5e37f995351ddcef393c04464a9e3891ed0c0bd56a03a5c5e400a6326"
    ]

# The two modules, from the repository's root.
constant TABLE: str
    "packages/rebel/0.1.0/files/unicode/names/internal/property_tables.hero"

constant NAME_TABLE: str
    "packages/rebel/0.1.0/files/unicode/names/internal/name_table.hero"

# The lists of `lists`, one after another.
function joined(lists: [[str]]) -> [str]
    out: [str] @= []

    for list in lists
        for one in list
            out @ out.push(one)

    return out

# The text of the input `name` of the folder, held to its digest.
#
# Fails `invalid` where no input is so named, and as `tablekit.pinned_text`
# fails.
function input(folder: str, name: str) -> str?
    for one in joined([INPUTS, NAME_INPUTS])
        if one.slice(from: 0, to: name.len() + 1) == name + " "
            return tablekit.pinned_text(
                path: folder + "/" + name,
                sha256: one.slice(from: name.len() + 1, to: one.len())
            )

    return fail(code: "invalid", msg: f"no input is named {name}")

# The module's whole text, from the files of `folder`.
#
# Fails as reading a file or a line of it fails.
function module_text(folder: str) -> str?
    head: [str] @= [
        "# The properties of `unicode/names`, in Unicode 17.0.0: scripts and script"
        "# extensions, blocks, the binary properties of `PropList.txt`,"
        "# `DerivedCoreProperties.txt` and `emoji-data.txt`, numeric values, the"
        "# Bidi_Class, Bidi_Mirrored and the mirroring glyphs."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `generators/unicode_names/` read the Unicode Character Database 17.0.0,"
        "# each file held to its SHA-256, packed it into the tables below, and wrote"
        "# this module whole; its `check` command says whether this module is still"
        "# what it writes. What it read:"
        "#"
    ]

    for one in INPUTS
        halves = strings.split_once(s: one, sep: " ")?
        head @ head.push(f"# - `{halves.before}`, SHA-256 {halves.after}")

    aliases = input(folder: folder, name: "PropertyValueAliases.txt")?
    unicode_data = input(folder: folder, name: "UnicodeData.txt")?
    s = scripts.scripts_of(scripts: input(folder: folder, name: "Scripts.txt")?, extensions: input(folder: folder, name: "ScriptExtensions.txt")?, aliases: aliases)?
    blocks = properties.blocks_of(input(folder: folder, name: "Blocks.txt")?)?
    binary = properties.binary_of([input(folder: folder, name: "PropList.txt")?, input(folder: folder, name: "DerivedCoreProperties.txt")?, input(folder: folder, name: "emoji-data.txt")?], aliases: input(folder: folder, name: "PropertyAliases.txt")?)?
    numeric = values.numbers_of(types: input(folder: folder, name: "DerivedNumericType.txt")?, values: input(folder: folder, name: "DerivedNumericValues.txt")?)?
    bidi = values.bidi_of(classes: input(folder: folder, name: "DerivedBidiClass.txt")?, aliases: aliases)?
    mirrors = values.mirrors_of(input(folder: folder, name: "BidiMirroring.txt")?)?
    blocks_text: [str] = [
        head.join("\n")
        tablekit.strings_constant(comment: ["# The long name of every script, in the order of their bytes."], name: "SCRIPT_NAMES", items: s.names)?
        tablekit.numbers_constant(comment: ["# Every code point's script, as runs `first << 8 | script`, ascending, each", "# reaching to the next; `script` indexes `SCRIPT_NAMES`."], name: "SCRIPT_RUNS", items: s.runs)
        tablekit.numbers_constant(comment: ["# The code points `ScriptExtensions.txt` lists, as ranges `first << 29 |", "# last << 8 | set`, ascending; `set` indexes `EXTENSION_SETS`."], name: "EXTENSION_RANGES", items: s.extension_ranges)
        tablekit.numbers_constant(comment: ["# Each set of scripts, `offset << 8 | length` into `EXTENSION_MEMBERS`."], name: "EXTENSION_SETS", items: s.extension_sets)
        tablekit.numbers_constant(comment: ["# The scripts of the sets, indices into `SCRIPT_NAMES`, in the order the", "# file writes them."], name: "EXTENSION_MEMBERS", items: s.extension_members)
        tablekit.strings_constant(comment: ["# Every name of a script in `PropertyValueAliases.txt`: long names, codes", "# of ISO 15924 and other aliases, in the order of their bytes."], name: "SCRIPT_ALIASES", items: s.aliases)?
        tablekit.numbers_constant(comment: ["# The script each alias names, an index into `SCRIPT_NAMES`, beside it."], name: "SCRIPT_ALIAS_TARGETS", items: s.alias_targets)
        tablekit.strings_constant(comment: ["# The name of every block, by the order of their code points."], name: "BLOCK_NAMES", items: blocks.names)?
        tablekit.numbers_constant(comment: ["# Every block, `first << 21 | last`, beside its name."], name: "BLOCKS", items: blocks.ranges)
        tablekit.strings_constant(comment: ["# The long name of every binary property, in the order of their bytes."], name: "PROPERTY_NAMES", items: binary.names)?
        tablekit.numbers_constant(comment: ["# Where each property's ranges begin in `PROPERTY_RANGES`, beside its name,", "# and one more entry for the end."], name: "PROPERTY_STARTS", items: binary.starts)
        tablekit.numbers_constant(comment: ["# The ranges of each property, `first << 21 | last`, each property's", "# ascending."], name: "PROPERTY_RANGES", items: binary.ranges)
        tablekit.strings_constant(comment: ["# Every name of a binary property here in `PropertyAliases.txt`, long and", "# short, in the order of their bytes."], name: "PROPERTY_ALIASES", items: binary.aliases)?
        tablekit.numbers_constant(comment: ["# The property each alias names, an index into `PROPERTY_NAMES`, beside it."], name: "PROPERTY_ALIAS_TARGETS", items: binary.alias_targets)
        tablekit.number_constant(comment: ["# The index of XID_Start in `PROPERTY_NAMES`."], name: "PROPERTY_XID_START", value: scripts.index_in(binary.names, name: "XID_Start"))
        tablekit.number_constant(comment: ["# The index of XID_Continue in `PROPERTY_NAMES`."], name: "PROPERTY_XID_CONTINUE", value: scripts.index_in(binary.names, name: "XID_Continue"))
        tablekit.number_constant(comment: ["# The index of Default_Ignorable_Code_Point in `PROPERTY_NAMES`."], name: "PROPERTY_DEFAULT_IGNORABLE_CODE_POINT", value: scripts.index_in(binary.names, name: "Default_Ignorable_Code_Point"))
        tablekit.strings_constant(comment: ["# The Numeric_Type values, by their number in `NUMERIC_POINTS`."], name: "NUMERIC_KINDS", items: values.NUMERIC_KINDS)?
        tablekit.numbers_constant(comment: ["# Every code point that writes a number, `code point << 2 | kind`, ascending."], name: "NUMERIC_POINTS", items: numeric.points)
        tablekit.numbers_constant(comment: ["# The numerator of each number, beside it."], name: "NUMERATORS", items: numeric.numerators)
        tablekit.numbers_constant(comment: ["# The denominator of each number, beside it, in lowest terms."], name: "DENOMINATORS", items: numeric.denominators)
        tablekit.strings_constant(comment: ["# The Bidi_Class values, in the order of their bytes."], name: "BIDI_NAMES", items: bidi.names)?
        tablekit.numbers_constant(comment: ["# Every code point's Bidi_Class, as runs `first << 8 | class`, ascending."], name: "BIDI_RUNS", items: bidi.runs)
        tablekit.numbers_constant(comment: ["# The Bidi_Mirrored characters, as ranges `first << 21 | last`, ascending."], name: "MIRRORED", items: values.mirrored_of(unicode_data)?)
        tablekit.numbers_constant(comment: ["# The characters `BidiMirroring.txt` gives a mirror, ascending."], name: "MIRROR_SOURCES", items: mirrors.sources)
        tablekit.numbers_constant(comment: ["# The mirror of each, beside it."], name: "MIRROR_TARGETS", items: mirrors.targets)
        ["## Tests", "", "test \"property_tables: the runs begin at 0, the tables ascend, and each pair is as long as the other\"", "    assert SCRIPT_RUNS[0] >> 8 == 0 && BIDI_RUNS[0] >> 8 == 0", "", "    for table in [SCRIPT_RUNS, EXTENSION_RANGES, BLOCKS, NUMERIC_POINTS, BIDI_RUNS, MIRRORED, MIRROR_SOURCES]", "        at: i64 @= 1", "", "        while at < table.len()", "            assert table[at - 1] < table[at]", "            at @ at + 1", "", "    assert SCRIPT_ALIASES.len() == SCRIPT_ALIAS_TARGETS.len()", "    assert PROPERTY_ALIASES.len() == PROPERTY_ALIAS_TARGETS.len()", "    assert PROPERTY_STARTS.len() == PROPERTY_NAMES.len() + 1", "    assert NUMERATORS.len() == NUMERIC_POINTS.len() && DENOMINATORS.len() == NUMERIC_POINTS.len()", "    assert MIRROR_TARGETS.len() == MIRROR_SOURCES.len()"].join("\n")
    ]
    return ok(blocks_text.join("\n\n") + "\n")

# The comment lines `text` writes, one per line of it.
function comment(text: str) -> [str]
    return strings.split(s: text, sep: "\n")

# The names' module's whole text, from the files of `folder`.
#
# Fails as reading a file or a line of it fails.
function names_text(folder: str) -> str?
    head: [str] @= [
        "# The names of Unicode 17.0.0: every name the database lists, written as"
        "# words of `WORD_TEXT`; the ranges whose names a rule makes; the aliases; the"
        "# named sequences; and an index of every name, alias and named sequence by"
        "# the hash of its loose form, UAX #44's rule LM2, in buckets."
        "#"
        "# Generated, never edited by hand: the Heroes program"
        "# `generators/unicode_names/` read the Unicode Character Database 17.0.0,"
        "# each file held to its SHA-256, packed it into the tables below, and wrote"
        "# this module whole; its `check` command says whether this module is still"
        "# what it writes. What it read:"
        "#"
    ]

    for one in NAME_INPUTS
        halves = strings.split_once(s: one, sep: " ")?
        head @ head.push(f"# - `{halves.before}`, SHA-256 {halves.after}")

    named = naming.named_of(input(folder: folder, name: "UnicodeData.txt")?)?
    words = naming.words_of(named.names)
    text = naming.text_of(words)
    tokens = lookup.tokens_of(names: named.names, words: words)?
    jamo = input(folder: folder, name: "Jamo.txt")?
    trailing: [str] @= [""]

    for one in lookup.jamo(jamo, first: 0x11a8, last: 0x11c2)?
        trailing @ trailing.push(one)

    aliases = lookup.aliases_of(input(folder: folder, name: "NameAliases.txt")?)?
    sequences = lookup.sequences_of(input(folder: folder, name: "NamedSequences.txt")?)?
    index = lookup.index_of(joined([named.names, aliases.names, sequences.names]))
    parts: [str] = [
        head.join("\n")
        tablekit.strings_constant(comment: comment("# The words of the names, the most used first, written one after another\n# in texts of `CHUNK` bytes, each filled out with full stops so no word\n# crosses from one text to the next."), name: "WORD_TEXT", items: text.texts)?
        tablekit.number_constant(comment: ["# How many bytes each text of `WORD_TEXT` holds, the last one aside."], name: "CHUNK", value: naming.CHUNK)
        tablekit.numbers_constant(comment: comment("# Where each word stands, two to an entry, the first in the high 32 bits:\n# `offset << 5 | length`, the offset counted across the texts of\n# `WORD_TEXT` as if they were one."), name: "WORD_SPANS", items: lookup.packed_high(text.spans, per: 2, bits: 32, fill: 0))
        tablekit.numbers_constant(comment: comment("# The words of every name, in the order of the names, four to an entry,\n# each 15 bits, the first in the highest bits: token `t` is bits\n# `15 * (3 - t % 4)` up of entry `t / 4`, a word's index."), name: "TOKENS", items: tokens.tokens)
        tablekit.number_constant(comment: ["# How many code points the database names, the rules aside."], name: "NAMED_COUNT", value: named.names.len())
        tablekit.numbers_constant(comment: comment("# The code points the database names, as runs of consecutive code points:\n# `first << 21 | index`, where `index` numbers the run's first name among\n# all the names, which go in the order of their code points."), name: "NAME_RUNS", items: lookup.name_runs(named.points))
        tablekit.numbers_constant(comment: ["# The first token of names 0, 16, 32 and on."], name: "TOKEN_STARTS", items: tokens.starts)
        tablekit.numbers_constant(comment: comment("# How many words each name holds, fifteen names to an entry, each 4 bits,\n# the first in the lowest bits."), name: "TOKEN_COUNTS", items: tokens.counts)
        tablekit.strings_constant(comment: ["# What a name made by a rule begins with, by the rule's number."], name: "RULE_PREFIXES", items: naming.RULE_PREFIXES)?
        tablekit.numbers_constant(comment: comment("# The ranges whose names a rule makes, `first << 24 | last << 3 | rule`,\n# ascending: rule 1 is the Hangul syllables', which spells the jamo; every\n# other writes its prefix and the code point in hexadecimal."), name: "RULES", items: named.rules)
        tablekit.strings_constant(comment: ["# The short names of the leading consonants, by their order."], name: "JAMO_LEADING", items: lookup.jamo(jamo, first: 0x1100, last: 0x1112)?)?
        tablekit.strings_constant(comment: ["# The short names of the vowels, by their order."], name: "JAMO_VOWELS", items: lookup.jamo(jamo, first: 0x1161, last: 0x1175)?)?
        tablekit.strings_constant(comment: comment("# The short names of the trailing consonants, by their order, the absent\n# one first."), name: "JAMO_TRAILING", items: trailing)?
        tablekit.strings_constant(comment: ["# The kinds of an alias, by their number in `ALIASES`."], name: "ALIAS_KINDS", items: lookup.ALIAS_KINDS)?
        tablekit.numbers_constant(comment: ["# The aliases, `code point << 3 | kind`, in the order of `NameAliases.txt`."], name: "ALIASES", items: aliases.entries)
        tablekit.strings_constant(comment: ["# The alias each entry of `ALIASES` names, beside it."], name: "ALIAS_NAMES", items: aliases.names)?
        tablekit.strings_constant(comment: ["# The names of the named sequences, in the order of `NamedSequences.txt`."], name: "SEQUENCE_NAMES", items: sequences.names)?
        tablekit.numbers_constant(comment: comment("# Each named sequence's code points, `offset << 5 | length` into\n# `SEQUENCE_POINTS`, beside its name."), name: "SEQUENCES", items: sequences.spans)
        tablekit.numbers_constant(comment: ["# The code points of the named sequences, one after another."], name: "SEQUENCE_POINTS", items: sequences.points)
        tablekit.number_constant(comment: ["# The prime the hash of a loose name is taken modulo, below 2 to the 40th."], name: "HASH_PRIME", value: lookup.HASH_PRIME)
        tablekit.number_constant(comment: ["# What the hash is multiplied by before each byte is added."], name: "HASH_FACTOR", value: lookup.HASH_FACTOR)
        tablekit.number_constant(comment: comment("# What the hash is multiplied by at the end, modulo `HASH_PRIME`, so that\n# short names spread over the buckets; below 2 to the 22nd, so the product\n# stays below 2 to the 62nd."), name: "HASH_SPREAD", value: lookup.HASH_SPREAD)
        tablekit.number_constant(comment: ["# How far a hash is shifted right to give its bucket, of 4,096."], name: "BUCKET_SHIFT", value: lookup.BUCKET_SHIFT)
        tablekit.numbers_constant(comment: comment("# Where each bucket's entries end in `ENTRY_TARGETS`, three buckets to an\n# entry, each 16 bits, the first in the highest bits; a bucket begins where\n# the one before it ends."), name: "BUCKET_ENDS", items: index.ends)
        tablekit.numbers_constant(comment: comment("# What each entry of a bucket names, three to an entry, each 16 bits, the\n# first in the highest bits: below `NAMED_COUNT` a name's index, then an\n# alias's index past it, then a named sequence's past the aliases."), name: "ENTRY_TARGETS", items: index.targets)
        ["## Tests", "", "test \"name_table: the tables ascend, and each pair is as long as the other\"", "    for table in [NAME_RUNS, RULES, TOKEN_STARTS]", "        at: i64 @= 1", "", "        while at < table.len()", "            assert table[at - 1] < table[at]", "            at @ at + 1", "", "    assert ALIASES.len() == ALIAS_NAMES.len()", "    assert SEQUENCES.len() == SEQUENCE_NAMES.len()", "    assert JAMO_LEADING.len() == 19 && JAMO_VOWELS.len() == 21 && JAMO_TRAILING.len() == 28"].join("\n")
    ]
    return ok(parts.join("\n\n") + "\n")

# Does what `command` asks with both modules, and answers the worse of the
# two codes it reached.
#
# Fails as `module_text` and `names_text` fail and as writing or reading a
# module fails.
function run(command: str, folder: str) -> i64?
    first = tablekit.settle(command: command, path: TABLE, text: module_text(folder)?)?
    second = tablekit.settle(command: command, path: NAME_TABLE, text: names_text(folder)?)?
    return ok(tablekit.worst(a: first, b: second))

function main()
    words = tablekit.command_words("unicode_names")

    if words.len() != 2 || words[0] != "write" && words[0] != "check"
        print(
            "usage, from the repository's root: heroes run generators/unicode_names/main.hero -- write|check <folder of the files of ",
            UCD_URL,
            ">"
        )
        exit(code: 2)

    match run(command: words[0], folder: words[1])
        .ok code => exit(code: code)
        .err e =>
            print("error: ", e.code, ": ", e.msg)
            exit(code: 2)
